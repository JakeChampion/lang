function arm64_aes_opcode(mnem: string): Option[i32] {
  if (mnem == "aese") {
    return Some(4);
  }
  if (mnem == "aesmc") {
    return Some(6);
  }
  return None;
}

function arm64_vecsha(buf: i32[], rd: i32, rn: i32, rm: i32, opcode: i32): i32[] {
  let word = 0x5e000000 | (rm & 31) as i64 << 16;
  if (opcode >= 8) {
    word = 0x5e280800;
  }
  word = word | (opcode & 7) as i64 << 12 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  return arm64_le32(buf, word);
}

function arm64_sha_opcode(mnem: string): i32 {
  if (mnem.len() < 5 || mnem[0] != b's' || mnem[1] != b'h' || mnem[2] != b'a') {
    return -1;
  }
  if (mnem[3] == b'1') {
    return arm64_sha1_opcode(mnem);
  }
  return match (mnem) {
    "sha256h" => 4,
    "sha256h2" => 5,
    "sha256su1" => 6,
    "sha256su0" => 10,
    _ => -1,
  };
}

function arm64_sha1_opcode(mnem: string): i32 {
  return match (mnem) {
    "sha1c" => 0,
    "sha1p" => 1,
    "sha1m" => 2,
    "sha1su0" => 3,
    "sha1h" => 8,
    "sha1su1" => 9,
    _ => -1,
  };
}

function arm64_gas_sha_reg(opcode: i32, i: i32, tok: string): i32 {
  if (opcode <= 2 && i == 1 || opcode == 8) {
    if (!arm64_gas_is_sreg(tok)) {
      return -1;
    }
    return arm64_gas_reg(tok);
  }
  if ((opcode <= 2 || opcode == 4 || opcode == 5) && i < 2) {
    return arm64_gas_qreg(tok);
  }
  if (arm64_gas_vreg_arrof(tok) != 5) {
    return -1;
  }
  return arm64_gas_vreg_any(tok);
}

function arm64_vectbl(buf: i32[], rd: i32, list: i32, rm: i32, q: boolean, tbx: boolean): i32[] {
  let word: i64 = 0x0e000000 | (rm & 31) as i64 << 16 | (list >> 5 & 3) as i64 << 13
    | (list & 31) as i64 << 5 | (rd & 31) as i64;
  if (tbx) {
    word = word | 0x1000;
  }
  if (q) {
    word = word | 0x40000000;
  }
  return arm64_le32(buf, word);
}

function arm64_vecacross(buf: i32[], rd: i32, rn: i32, opcode: i32, size: i32, q: boolean, u: boolean): i32[] {
  let word: i64 = 0x0e300800 | (size & 3) as i64 << 22
    | (opcode & 31) as i64 << 12 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  if (q) {
    word = word | 0x40000000;
  }
  if (u) {
    word = word | 0x20000000;
  }
  return arm64_le32(buf, word);
}

// BEGIN GENERATED ARM64 ACROSS_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
function arm64_across_entry(mnem: string): i32 {
  match (mnem) {
    "addv" => {
      return arm64_vec_entry(false, 27, 0);
    },
    "smaxv" => {
      return arm64_vec_entry(false, 10, 0);
    },
    "sminv" => {
      return arm64_vec_entry(false, 26, 0);
    },
    "umaxv" => {
      return arm64_vec_entry(true, 10, 0);
    },
    "uminv" => {
      return arm64_vec_entry(true, 26, 0);
    },
    "saddlv" => {
      return arm64_vec_entry(false, 3, 1);
    },
    "uaddlv" => {
      return arm64_vec_entry(true, 3, 1);
    },
    _ => {
      return -1;
    }
  }
}

// END GENERATED ARM64 ACROSS_ENTRY TABLE

// BEGIN GENERATED ARM64 PAIRLONG_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
function arm64_pairlong_entry(mnem: string): i32 {
  match (mnem) {
    "saddlp" => {
      return arm64_vec_entry(false, 2, 7);
    },
    "uaddlp" => {
      return arm64_vec_entry(true, 2, 7);
    },
    "sadalp" => {
      return arm64_vec_entry(false, 6, 7);
    },
    "uadalp" => {
      return arm64_vec_entry(true, 6, 7);
    },
    _ => {
      return -1;
    }
  }
}

// END GENERATED ARM64 PAIRLONG_ENTRY TABLE

// BEGIN GENERATED ARM64 VPOLYLONG_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
function arm64_vpolylong_entry(mnem: string): i32 {
  match (mnem) {
    "pmull" => {
      return arm64_vec_entry(false, 14, 0);
    },
    "pmull2" => {
      return arm64_vec_entry(false, 14, 1);
    },
    _ => {
      return -1;
    }
  }
}

// END GENERATED ARM64 VPOLYLONG_ENTRY TABLE

function arm64_gas_scalar_class(tok: string): i32 {
  let t = arm64_gas_trim(tok);
  if (t.len() < 2) {
    return -1;
  }
  let c = t[0] as i32;
  let cls: i32 = -1;
  if (c == 98) {
    cls = 0;
  }
  if (c == 104) {
    cls = 1;
  }
  if (c == 115) {
    cls = 2;
  }
  if (c == 100) {
    cls = 3;
  }
  if (cls < 0) {
    return -1;
  }
  if (arm64_gas_scalar_reg(tok) < 0) {
    return -1;
  }
  return cls;
}

function arm64_gas_scalar_reg(tok: string): i32 {
  let t = arm64_gas_trim(tok);
  if (t.len() < 2) {
    return -1;
  }
  let n = 0;
  let i = 1;
  while (i < t.len()) {
    let c = t[i] as i32;
    if (c < 48 || c > 57) {
      return -1;
    }
    n = n * 10 + (c - 48);
    i += 1;
  }
  if (n > 31) {
    return -1;
  }
  return n;
}

function arm64_gas_vlist_one(tok: string): i32 {
  let t = arm64_gas_trim(tok);
  if (t.len() < 3 || t[0] != b'{' || t[t.len() - 1] != b'}') {
    return -1;
  }
  return arm64_gas_vreg_any(slice_unchecked(t, 1, t.len() - 1).to_owned());
}

function arm64_gas_vlist_table(tok: string): i32 {
  let t = arm64_gas_trim(tok);
  if (t.len() < 3 || t[0] != b'{' || t[t.len() - 1] != b'}') {
    return -1;
  }
  let inner = slice_unchecked(t, 1, t.len() - 1).to_owned();
  let dash: i32 = -1;
  let i = 0;
  while (i < inner.len()) {
    if (inner[i] == b'-') {
      dash = i;
    }
    i += 1;
  }
  let first = inner;
  let last = inner;
  if (dash >= 0) {
    first = slice_unchecked(inner, 0, dash).to_owned();
    last = slice_unchecked(inner, dash + 1, inner.len()).to_owned();
  }
  let n = arm64_gas_vreg_any(first);
  let m = arm64_gas_vreg_any(last);
  if (n < 0 || m < 0 || arm64_gas_vreg_arrof(first) != 1 || arm64_gas_vreg_arrof(last) != 1) {
    return -1;
  }
  let span: i32 = (m - n + 32) % 32;
  if (span > 3 || dash >= 0 && span == 0) {
    return -1;
  }
  return span * 32 + n;
}

function arm64_gas_vlist_one_arr(tok: string): i32 {
  let t = arm64_gas_trim(tok);
  if (t.len() < 3 || t[0] != b'{' || t[t.len() - 1] != b'}') {
    return -1;
  }
  return arm64_gas_vreg_arrof(slice_unchecked(t, 1, t.len() - 1).to_owned());
}

function arm64_gas_narrow_wide_ok(narrow: i32, wide: i32, hi: boolean): boolean {
  if (narrow < 0 || wide < 0) {
    return false;
  }
  if (arm64_gas_arr_size(narrow) > 2) {
    return false;
  }
  if (arm64_gas_arr_q(narrow) != hi) {
    return false;
  }
  if (arm64_gas_arr_size(wide) != arm64_gas_arr_size(narrow) + 1) {
    return false;
  }
  return arm64_gas_arr_q(wide);
}

function arm64_gas_vecgen_handles(mnem: string): boolean {
  return arm64_v3int_entry(mnem) >= 0 || arm64_vlogical_entry(mnem) >= 0
    || arm64_vcmpzero_entry(mnem) >= 0 || arm64_v2misc_entry(mnem) >= 0
    || arm64_vfp3_entry(mnem) >= 0 || arm64_vfp2_entry(mnem) >= 0
    || arm64_vfpcmpzero_entry(mnem) >= 0 || arm64_vshift_entry(mnem) >= 0
    || arm64_vpermute_opc(mnem) >= 0 || arm64_vpolylong_entry(mnem) >= 0
    || arm64_pairlong_entry(mnem) >= 0
    || arm64_gas_family(mnem) == arm64_fam_shll() || arm64_gas_family(mnem) == arm64_fam_narrow()
    || arm64_gas_family(mnem) == arm64_fam_vecext();
}

function arm64_gas_emit_narrowwide(own a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
  if (arm64_gas_fcvt_nl(mnem) >= 0) {
    return arm64_gas_emit_fcvt_nl(a, mnem, ops);
  }
  if (mnem == "xtn" || mnem == "xtn2") {
    if (ops.len() != 2) {
      return a;
    }
    let xc = arm64_gas_vreg_arrof(ops[0]);
    util.push_bytes(a.code, arm64_vec2misc(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      18, arm64_gas_arr_size(xc), arm64_gas_arr_q(xc), false,
    ));
    return a;
  }
  let kind = arm64_gas_shll_kind(mnem);
  if (kind < 0) {
    if (ops.len() != 3) {
      return a;
    }
    let nc = arm64_gas_vreg_arrof(ops[0]);
    let nes = arm64_gas_esize(nc);
    util.push_bytes(a.code, arm64_vecshift(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      16, 2 * nes - arm64_gas_imm(ops[2]), arm64_gas_arr_q(nc), false,
    ));
    return a;
  }
  let alias = kind >= 4;
  if (ops.len() != 3 && !alias) {
    return a;
  }
  if (ops.len() != 2 && alias) {
    return a;
  }
  let sc = arm64_gas_vreg_arrof(ops[1]);
  let amt = 0;
  if (!alias) {
    amt = arm64_gas_imm(ops[2]);
  }
  util.push_bytes(a.code, arm64_vecshift(
    [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
    20, arm64_gas_esize(sc) + amt, kind % 4 >= 2, kind % 2 == 1,
  ));
  return a;
}

function arm64_gas_emit_fcvt_nl(own a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
  if (ops.len() != 2) {
    return a;
  }
  util.push_bytes(a.code, arm64_vec2misc(
    [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
    arm64_gas_fcvt_nl(mnem), 1, util.index_of_sub(mnem, "2") == mnem.len() - 1, false,
  ));
  return a;
}

function arm64_gas_bad_fcvt_nl(mnem: string, ops: string[]): string {
  if (ops.len() != 2) {
    return mnem + ":arity";
  }
  if (arm64_gas_vreg_any(ops[0]) < 0 || arm64_gas_vreg_any(ops[1]) < 0) {
    return mnem + ":reg";
  }
  let narrow = arm64_gas_vreg_arrof(ops[0]);
  let wide = arm64_gas_vreg_arrof(ops[1]);
  if (arm64_gas_fcvt_nl(mnem) == 23) {
    narrow = arm64_gas_vreg_arrof(ops[1]);
    wide = arm64_gas_vreg_arrof(ops[0]);
  }
  if (arm64_gas_arr_size(narrow) != 2 || !arm64_gas_narrow_wide_ok(narrow, wide, util.index_of_sub(mnem, "2") == mnem.len() - 1)) {
    return mnem + ":arr";
  }
  return "";
}

function arm64_gas_fcvt_nl(mnem: string): i32 {
  if (mnem == "fcvtn" || mnem == "fcvtn2") {
    return 22;
  }
  if (mnem == "fcvtl" || mnem == "fcvtl2") {
    return 23;
  }
  return -1;
}

function arm64_gas_emit_vecgen(own a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
  let czero = arm64_vcmpzero_entry(mnem);
  let three = arm64_v3int_entry(mnem);
  if (czero >= 0 && (three < 0 || ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#')) {
    if (ops.len() != 3) {
      return a;
    }
    let cc = arm64_gas_vreg_arrof(ops[0]);
    util.push_bytes(a.code, arm64_vec2misc(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_vec_entry_op(czero), arm64_gas_arr_size(cc), arm64_gas_arr_q(cc), arm64_vec_entry_u(czero),
    ));
    return a;
  }
  if (three >= 0) {
    if (ops.len() != 3) {
      return a;
    }
    let tc = arm64_gas_vreg_arrof(ops[0]);
    util.push_bytes(a.code, arm64_vec3same(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_gas_vreg_any(ops[2]), arm64_vec_entry_op(three), arm64_gas_arr_size(tc), arm64_gas_arr_q(tc), arm64_vec_entry_u(three),
    ));
    return a;
  }
  let logic = arm64_vlogical_entry(mnem);
  if (logic >= 0) {
    if (ops.len() != 3) {
      return a;
    }
    let lc = arm64_gas_vreg_arrof(ops[0]);
    util.push_bytes(a.code, arm64_vec3same(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_gas_vreg_any(ops[2]), 3, arm64_vec_entry_op(logic), arm64_gas_arr_q(lc), arm64_vec_entry_u(logic),
    ));
    return a;
  }
  let pl = arm64_pairlong_entry(mnem);
  if (pl >= 0) {
    if (ops.len() != 2) {
      return a;
    }
    let pc = arm64_gas_vreg_arrof(ops[1]);
    util.push_bytes(a.code, arm64_vec2misc(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_vec_entry_op(pl), arm64_gas_arr_size(pc), arm64_gas_arr_q(pc), arm64_vec_entry_u(pl),
    ));
    return a;
  }
  let misc = arm64_v2misc_entry(mnem);
  if (misc >= 0) {
    if (ops.len() != 2) {
      return a;
    }
    let mc = arm64_gas_vreg_arrof(ops[0]);
    util.push_bytes(a.code, arm64_vec2misc(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_vec_entry_op(misc), arm64_gas_arr_size(mc), arm64_gas_arr_q(mc), arm64_vec_entry_u(misc),
    ));
    return a;
  }
  let fz = arm64_vfpcmpzero_entry(mnem);
  let f3 = arm64_vfp3_entry(mnem);
  if (fz >= 0 && (f3 < 0 || ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#')) {
    if (ops.len() != 3) {
      return a;
    }
    let zc = arm64_gas_vreg_arrof(ops[0]);
    util.push_bytes(a.code, arm64_vec2misc(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_vec_entry_op(fz), arm64_gas_fp_size(zc, true), arm64_gas_arr_q(zc), arm64_vec_entry_u(fz),
    ));
    return a;
  }
  if (f3 >= 0) {
    if (ops.len() != 3) {
      return a;
    }
    let fc = arm64_gas_vreg_arrof(ops[0]);
    util.push_bytes(a.code, arm64_vec3same(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_gas_vreg_any(ops[2]), arm64_vec_entry_op(f3),
      arm64_gas_fp_size(fc, arm64_vec_entry_sizes(f3) == 1), arm64_gas_arr_q(fc), arm64_vec_entry_u(f3),
    ));
    return a;
  }
  let f2 = arm64_vfp2_entry(mnem);
  if (f2 >= 0) {
    if (ops.len() != 2) {
      return a;
    }
    let f2c = arm64_gas_vreg_arrof(ops[0]);
    util.push_bytes(a.code, arm64_vec2misc(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_vec_entry_op(f2), arm64_gas_fp_size(f2c, arm64_vec_entry_sizes(f2) == 1),
      arm64_gas_arr_q(f2c), arm64_vec_entry_u(f2),
    ));
    return a;
  }
  let sh = arm64_vshift_entry(mnem);
  if (sh >= 0) {
    if (ops.len() != 3) {
      return a;
    }
    let sc = arm64_gas_vreg_arrof(ops[0]);
    let es = arm64_gas_esize(sc);
    let amt = arm64_gas_imm(ops[2]);
    let immhb = 2 * es - amt;
    if (arm64_vec_entry_sizes(sh) == 1) {
      immhb = es + amt;
    }
    util.push_bytes(a.code, arm64_vecshift(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_vec_entry_op(sh), immhb, arm64_gas_arr_q(sc), arm64_vec_entry_u(sh),
    ));
    return a;
  }
  if (arm64_gas_shll_kind(mnem) >= 0 || arm64_gas_family(mnem) == arm64_fam_narrow()) {
    return arm64_gas_emit_narrowwide(a, mnem, ops);
  }
  if (mnem == "ext") {
    if (ops.len() != 4) {
      return a;
    }
    let ec = arm64_gas_vreg_arrof(ops[0]);
    util.push_bytes(a.code, arm64_vecext(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_gas_vreg_any(ops[2]), arm64_gas_imm(ops[3]), arm64_gas_arr_q(ec),
    ));
    return a;
  }
  if let Some(aes) = arm64_aes_opcode(mnem) {
    if (ops.len() != 2) {
      return a;
    }
    util.push_bytes(a.code, arm64_vecaes([], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]), aes));
    return a;
  }
  let sha = arm64_sha_opcode(mnem);
  if (sha >= 0) {
    let rm = 0;
    if (ops.len() == 3) {
      rm = arm64_gas_sha_reg(sha, 2, ops[2]);
    }
    util.push_bytes(a.code, arm64_vecsha([], arm64_gas_sha_reg(sha, 0, ops[0]), arm64_gas_sha_reg(sha, 1, ops[1]), rm, sha));
    return a;
  }
  if (mnem == "tbl" || mnem == "tbx") {
    if (ops.len() != 3) {
      return a;
    }
    let tc = arm64_gas_vreg_arrof(ops[0]);
    util.push_bytes(a.code, arm64_vectbl(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vlist_table(ops[1]),
      arm64_gas_vreg_any(ops[2]), arm64_gas_arr_q(tc), mnem == "tbx",
    ));
    return a;
  }
  let poly = arm64_vpolylong_entry(mnem);
  if (poly >= 0) {
    if (ops.len() != 3) {
      return a;
    }
    let yc = arm64_gas_vreg_arrof(ops[1]);
    util.push_bytes(a.code, arm64_vec3diff(
      [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
      arm64_gas_vreg_any(ops[2]), arm64_vec_entry_op(poly), arm64_gas_arr_size(yc), arm64_gas_arr_q(yc), arm64_vec_entry_u(poly),
    ));
    return a;
  }
  let pm = arm64_vpermute_opc(mnem);
  if (pm < 0 || ops.len() != 3) {
    return a;
  }
  let pc = arm64_gas_vreg_arrof(ops[0]);
  util.push_bytes(a.code, arm64_vecpermute(
    [], arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
    arm64_gas_vreg_any(ops[2]), pm, arm64_gas_arr_size(pc), arm64_gas_arr_q(pc),
  ));
  return a;
}

function arm64_ldrb(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x39400000 | (off & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_strb(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x39000000 | (off & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldrb_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x38400400 | (off & 0x1ff) as i64 << 12 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_strb_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x38000400 | (off & 0x1ff) as i64 << 12 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldrh(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x79400000 | (off / 2 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_strh(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0x79000000 | (off / 2 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldrsw(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
  return arm64_le32(buf, 0xb9800000 | (off / 4 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldrsb(buf: i32[], rt: i32, rn: i32, off: i32, w: boolean): i32[] {
  let base: i64 = 0x39800000;
  if (w) {
    base = 0x39c00000;
  }
  return arm64_le32(buf, base | (off & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

function arm64_ldrsh(buf: i32[], rt: i32, rn: i32, off: i32, w: boolean): i32[] {
  let base: i64 = 0x79800000;
  if (w) {
    base = 0x79c00000;
  }
  return arm64_le32(buf, base | (off / 2 & 0xfff) as i64 << 10 | (rn & 31) as i64 << 5 | (rt & 31) as i64);
}

// A cache or TLB maintenance op of the SYS space. `reg` says whether it takes
// an address register. An op without one has 31 in the Rt field.
struct Arm64SysOp { name: string, word: i64, reg: boolean }

function arm64_sys_ops(): Arm64SysOp[] {
  return [
    Arm64SysOp { name: "dc cvac", word: 0xd50b7a20, reg: true },
    Arm64SysOp { name: "dc cvau", word: 0xd50b7b20, reg: true },
    Arm64SysOp { name: "dc civac", word: 0xd50b7e20, reg: true },
    Arm64SysOp { name: "ic ivau", word: 0xd50b7520, reg: true },
    Arm64SysOp { name: "ic iallu", word: 0xd508751f, reg: false },
    Arm64SysOp { name: "tlbi vmalle1", word: 0xd508871f, reg: false },
    Arm64SysOp { name: "tlbi vmalle1is", word: 0xd508831f, reg: false },
    Arm64SysOp { name: "tlbi vaae1", word: 0xd5088760, reg: true },
    Arm64SysOp { name: "tlbi vaae1is", word: 0xd5088360, reg: true },
  ];
}

function arm64_is_sys_mnem(mnem: string): boolean {
  return mnem == "tlbi" || mnem == "dc" || mnem == "ic";
}

// The word of `mnem op` or `mnem op, xN`, or -1.
function arm64_sys_word(mnem: string, ops: string[]): i64 {
  if (ops.len() == 0 || ops.len() > 2) {
    return -1;
  }
  let name = mnem + " " + arm64_gas_trim(ops[0]);
  for o in arm64_sys_ops() {
    if (o.name == name && o.reg == (ops.len() == 2)) {
      if (!o.reg) {
        return o.word;
      }
      let rt = arm64_gas_reg(ops[1]);
      if (rt < 0 || arm64_gas_is_w(ops[1])) {
        return -1;
      }
      return o.word | rt as i64;
    }
  }
  return -1;
}

function arm64_mrs_base(name: string): i64 {
  let enc = sysreg.arm64_encoding(name, sysreg.READ);
  if (enc < 0) {
    return -1;
  }
  return 0xd5300000 | enc as i64 << 5;
}

function arm64_mrs(buf: i32[], rt: i32, name: string): i32[] {
  return arm64_le32(buf, arm64_mrs_base(name) | (rt & 31) as i64);
}

function arm64_msr_base(name: string): i64 {
  let enc = sysreg.arm64_encoding(name, sysreg.WRITE);
  if (enc < 0) {
    return -1;
  }
  return 0xd5100000 | enc as i64 << 5;
}

function arm64_msr(buf: i32[], rt: i32, name: string): i32[] {
  return arm64_le32(buf, arm64_msr_base(name) | (rt & 31) as i64);
}

// MSR (immediate) for a PSTATE field, without its CRm immediate: daifset and
// daifclr set and clear the DAIF bits that the immediate names. -1 for any
// other name.
function arm64_msr_pstate(name: string): i64 {
  if (name == "daifset") {
    return 0xd50340df;
  }
  if (name == "daifclr") {
    return 0xd50340ff;
  }
  return -1;
}

function arm64_fp_single(word: i64, single: boolean): i64 {
  if (single) {
    return word & 0xffbfffff;
  }
  return word;
}

function arm64_fp3(buf: i32[], base: i64, rd: i32, rn: i32, rm: i32, single: boolean): i32[] {
  let word = base | (rm & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  return arm64_le32(buf, arm64_fp_single(word, single));
}

function arm64_fp4(buf: i32[], base: i64, rd: i32, rn: i32, rm: i32, ra: i32, single: boolean): i32[] {
  let word = base | (rm & 31) as i64 << 16 | (ra & 31) as i64 << 10 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  return arm64_le32(buf, arm64_fp_single(word, single));
}

function arm64_fcsel(buf: i32[], rd: i32, rn: i32, rm: i32, cond: i32, single: boolean): i32[] {
  let word = 0x1e600c00 | (rm & 31) as i64 << 16 | (cond & 15) as i64 << 12 | (rn & 31) as i64 << 5 | (rd & 31) as i64;
  return arm64_le32(buf, arm64_fp_single(word, single));
}

function arm64_fccmp(buf: i32[], rn: i32, rm: i32, nzcv: i32, cond: i32, single: boolean): i32[] {
  let word = 0x1e600400 | (rm & 31) as i64 << 16 | (cond & 15) as i64 << 12 | (rn & 31) as i64 << 5 | (nzcv & 15) as i64;
  return arm64_le32(buf, arm64_fp_single(word, single));
}

function arm64_funary_d(buf: i32[], base: i64, rd: i32, rn: i32, single: boolean): i32[] {
  return arm64_le32(buf, arm64_fp_single(base | (rn & 31) as i64 << 5 | (rd & 31) as i64, single));
}

function arm64_fcmp(buf: i32[], rn: i32, rm: i32, opc: i32, single: boolean): i32[] {
  let word = 0x1e602000 | (rm & 31) as i64 << 16 | (rn & 31) as i64 << 5 | (opc & 0x18) as i64;
  return arm64_le32(buf, arm64_fp_single(word, single));
}

function arm64_fmov_dd(buf: i32[], rd: i32, rn: i32): i32[] {
  return arm64_le32(buf, 0x1e604000 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

function arm64_fmov_from_gpr(buf: i32[], rd_fp: i32, rn_gpr: i32): i32[] {
  return arm64_le32(buf, 0x9e670000 | (rn_gpr & 31) as i64 << 5 | (rd_fp & 31) as i64);
}

function arm64_fmov_to_gpr(buf: i32[], rd_gpr: i32, rn_fp: i32): i32[] {
  return arm64_le32(buf, 0x9e660000 | (rn_fp & 31) as i64 << 5 | (rd_gpr & 31) as i64);
}

function arm64_fmov_s_from_gpr(buf: i32[], rd_fp: i32, rn_gpr: i32): i32[] {
  return arm64_le32(buf, 0x1e270000 | (rn_gpr & 31) as i64 << 5 | (rd_fp & 31) as i64);
}

function arm64_fmov_s_to_gpr(buf: i32[], rd_gpr: i32, rn_fp: i32): i32[] {
  return arm64_le32(buf, 0x1e260000 | (rn_fp & 31) as i64 << 5 | (rd_gpr & 31) as i64);
}

function arm64_fcvt_s_d(buf: i32[], rd: i32, rn: i32): i32[] {
  return arm64_le32(buf, 0x1e624000 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

function arm64_fcvt_d_s(buf: i32[], rd: i32, rn: i32): i32[] {
  return arm64_le32(buf, 0x1e22c000 | (rn & 31) as i64 << 5 | (rd & 31) as i64);
}

function arm64_fcvtz_int(buf: i32[], rd_gpr: i32, rn_fp: i32, w: boolean, unsigned: boolean): i32[] {
  let base: i64 = 0x9e780000;
  if (unsigned) {
    base = 0x9e790000;
  }
  if (w) {
    base = 0x1e780000;
    if (unsigned) {
      base = 0x1e790000;
    }
  }
  return arm64_le32(buf, base | (rn_fp & 31) as i64 << 5 | (rd_gpr & 31) as i64);
}

function arm64_cvtf(buf: i32[], rd_fp: i32, rn_gpr: i32, w: boolean, unsigned: boolean): i32[] {
  let base: i64 = 0x9e620000;
  if (unsigned) {
    base = 0x9e630000;
  }
  if (w) {
    base = 0x1e620000;
    if (unsigned) {
      base = 0x1e630000;
    }
  }
  return arm64_le32(buf, base | (rn_gpr & 31) as i64 << 5 | (rd_fp & 31) as i64);
}

function arm64_gas_trim_lo(s: string, from: i32, to: i32): i32 {
  let i = from;
  while (i < to && (s[i] == b' ' || s[i] == b'\t')) {
    i += 1;
  }
  return i;
}

function arm64_gas_trim_hi(s: string, from: i32, to: i32): i32 {
  let j = to;
  while (j > from && (s[j - 1] == b' ' || s[j - 1] == b'\t')) {
    j -= 1;
  }
  return j;
}

function arm64_gas_trim_span(s: string, from: i32, to: i32): string {
  let i = arm64_gas_trim_lo(s, from, to);
  return slice_unchecked(s, i, arm64_gas_trim_hi(s, i, to)).to_owned();
}

function arm64_gas_trim(s: string): string {
  return arm64_gas_trim_span(s, 0, s.len());
}

function arm64_gas_atoi(tok: string): i32 {
  let s = tok;
  let neg = false;
  let i = 0;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  }
  let v = 0;
  if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
    i += 2;
    while (i < s.len()) {
      let c = s[i] as i32;
      let d: i32 = -1;
      if (c >= 48 && c <= 57) {
        d = c - 48;
      } else {
        if (c >= 97 && c <= 102) {
          d = c - 97 + 10;
        } else {
          if (c >= 65 && c <= 70) {
            d = c - 65 + 10;
          }
        }
      }
      if (d >= 0) {
        v = v * 16 + d;
      }
      i += 1;
    }
  } else {
    while (i < s.len()) {
      let c2 = s[i] as i32;
      if (c2 >= 48 && c2 <= 57) {
        v = v * 10 + (c2 - 48);
      }
      i += 1;
    }
  }
  if (neg) {
    return -v;
  }
  return v;
}

function arm64_gas_imm(tok: string): i32 {
  let i = arm64_gas_trim_lo(tok, 0, tok.len());
  let j = arm64_gas_trim_hi(tok, i, tok.len());
  if (j > i && tok[i] == b'#') {
    i += 1;
  }
  return arm64_gas_atoi(slice_unchecked(tok, i, j));
}

function arm64_gas_imm64(tok: string): i64 {
  let i = arm64_gas_trim_lo(tok, 0, tok.len());
  let j = arm64_gas_trim_hi(tok, i, tok.len());
  if (j > i && tok[i] == b'#') {
    i += 1;
  }
  return arm64_gas_atoi64(slice_unchecked(tok, i, j));
}

function arm64_gas_reg(tok: string): i32 {
  let i = arm64_gas_trim_lo(tok, 0, tok.len());
  let j = arm64_gas_trim_hi(tok, i, tok.len());
  if let Some(alias) = arm64_gas_reg_alias(tok, i, j) {
    return alias;
  }
  if (j - i < 2 || !(tok[i] == b'x' || tok[i] == b'w' || tok[i] == b'd' || tok[i] == b's')) {
    return -1;
  }
  let n = 0;
  let k = i + 1;
  while (k < j) {
    let c = tok[k] as i32;
    if (c < 48 || c > 57) {
      return -1;
    }
    n = n * 10 + (c - 48);
    k += 1;
  }
  let lim = 30;
  if (tok[i] == b'd' || tok[i] == b's') {
    lim = 31;
  }
  if (n > lim) {
    return -1;
  }
  return n;
}

function arm64_gas_reg_alias(tok: string, i: i32, j: i32): Option[i32] {
  let len = j - i;
  if (len == 2) {
    if (tok[i] == b's' && tok[i + 1] == b'p') {
      return Some(31);
    }
    if (tok[i] == b'l' && tok[i + 1] == b'r') {
      return Some(30);
    }
    if (tok[i] == b'f' && tok[i + 1] == b'p') {
      return Some(29);
    }
  }
  if (len == 3 && (tok[i] == b'x' || tok[i] == b'w') && tok[i + 1] == b'z' && tok[i + 2] == b'r') {
    return Some(31);
  }
  return None;
}

function arm64_gas_bad_reg_token(ops: string[]): string {
  let i = 0;
  while (i < ops.len()) {
    let t = ops[i];
    if (t.len() > 0 && t[0] == b'[') {
      let rb = util.index_of_sub(t, "]");
      if (rb > 1) {
        let bad = arm64_gas_bad_reg_piece(t, 1, rb);
        if (bad.len() > 0) {
          return bad;
        }
      }
    } else if (arm64_gas_reg_shaped_bad(t)) {
      return t;
    }
    i += 1;
  }
  return "";
}

function arm64_gas_bad_reg_piece(s: string, lo: i32, hi: i32): string {
  let depth = 0;
  let start = lo;
  let i = lo;
  while (i <= hi) {
    if (i == hi || s[i] == b',' && depth == 0) {
      let a = arm64_gas_trim_lo(s, start, i);
      let tok = slice_unchecked(s, a, arm64_gas_trim_hi(s, a, i));
      if (arm64_gas_reg_shaped_bad(tok)) {
        return tok + "";
      }
      start = i + 1;
    } else if (s[i] == b'[') {
      depth += 1;
    } else if (s[i] == b']') {
      depth -= 1;
    }
    i += 1;
  }
  return "";
}

function arm64_gas_ldst_data_regs(mnem: string): i32 {
  if (mnem == "ldp" || mnem == "stp" || mnem == "ldpsw") {
    return 2;
  } else if (mnem == "ldr" || mnem == "str" || mnem == "ldur" || mnem == "stur"
    || mnem == "ldrb" || mnem == "strb" || mnem == "ldrh" || mnem == "strh"
    || mnem == "ldrsb" || mnem == "ldrsh" || mnem == "ldrsw") {
    return 1;
  }
  return 0;
}

function arm64_gas_bad_ldst_reg(mnem: string, ops: string[], lm: Arm64Mem): string {
  if (arm64_sha_opcode(mnem) >= 0) {
    return "";
  }
  let n = arm64_gas_ldst_data_regs(mnem);
  if (n > 0 && lm.at >= 0 && lm.base < 0) {
    return "address";
  }
  let qok = mnem == "ldr" || mnem == "str" || mnem == "ldur" || mnem == "stur" || mnem == "ldp" || mnem == "stp";
  let i = 0;
  while (i < ops.len()) {
    let q = arm64_gas_is_qreg(ops[i]);
    if (q && (i >= n || !qok || arm64_gas_qreg(ops[i]) < 0)) {
      return arm64_gas_trim(ops[i]);
    }
    if (i < n && !q && arm64_gas_reg(ops[i]) < 0) {
      return arm64_gas_trim(ops[i]);
    }
    i += 1;
  }
  return "";
}

function arm64_gas_is_qreg(tok: string): boolean {
  let n = tok.len();
  let i = arm64_gas_trim_lo(tok, 0, n);
  return i + 1 < n && tok[i] == b'q' && tok[i + 1] >= b'0' && tok[i + 1] <= b'9';
}

function arm64_gas_qreg(tok: string): i32 {
  if (!arm64_gas_is_qreg(tok)) {
    return -1;
  }
  let i = arm64_gas_trim_lo(tok, 0, tok.len());
  let j = arm64_gas_trim_hi(tok, i, tok.len());
  let n = 0;
  let k = i + 1;
  while (k < j) {
    let c = tok[k] as i32;
    if (c < 48 || c > 57) {
      return -1;
    }
    n = n * 10 + (c - 48);
    k += 1;
  }
  if (n > 31) {
    return -1;
  }
  return n;
}

function arm64_gas_fp_ldst_size(tok: string): i32 {
  if (arm64_gas_is_qreg(tok)) {
    return 4;
  }
  if (arm64_gas_is_d(tok)) {
    return 3;
  }
  if (arm64_gas_is_sreg(tok)) {
    return 2;
  }
  return 0;
}

function arm64_gas_fp_regnum(tok: string): i32 {
  if (arm64_gas_is_qreg(tok)) {
    return arm64_gas_qreg(tok);
  }
  return arm64_gas_reg(tok);
}

// A system register such as s3_0_c12_c0_0 starts as an s register does, but is
// not one.
function arm64_gas_reg_shaped_bad(t: string): boolean {
  return t.len() >= 2 && (t[0] == b'x' || t[0] == b'w' || t[0] == b'd' || t[0] == b's')
    && t[1] >= b'0' && t[1] <= b'9' && arm64_gas_reg(t) < 0 && sysreg.arm64_encoding(t, sysreg.READ | sysreg.WRITE) < 0;
}

function arm64_gas_cond(s: string): i32 {
  if (s == "eq") {
    return 0;
  }
  if (s == "ne") {
    return 1;
  }
  if (s == "cs" || s == "hs") {
    return 2;
  }
  if (s == "cc" || s == "lo") {
    return 3;
  }
  if (s == "mi") {
    return 4;
  }
  if (s == "pl") {
    return 5;
  }
  if (s == "vs") {
    return 6;
  }
  if (s == "vc") {
    return 7;
  }
  if (s == "hi") {
    return 8;
  }
  if (s == "ls") {
    return 9;
  }
  if (s == "ge") {
    return 10;
  }
  if (s == "lt") {
    return 11;
  }
  if (s == "gt") {
    return 12;
  }
  if (s == "le") {
    return 13;
  }
  if (s == "al") {
    return 14;
  }
  if (s == "nv") {
    return 15;
  }
  return -1;
}

function arm64_gas_is_cond(s: string): boolean {
  return s == "eq" || s == "ne" || s == "cs" || s == "hs" || s == "cc" || s == "lo"
    || s == "mi" || s == "pl" || s == "vs" || s == "vc" || s == "hi" || s == "ls"
    || s == "ge" || s == "lt" || s == "gt" || s == "le" || s == "al" || s == "nv";
}

function arm64_gas_is_w(tok: string): boolean {
  let n = tok.len();
  let i = arm64_gas_trim_lo(tok, 0, n);
  return i < n && tok[i] == b'w';
}

function arm64_gas_is_d(tok: string): boolean {
  let n = tok.len();
  let i = arm64_gas_trim_lo(tok, 0, n);
  return i < n && tok[i] == b'd';
}

function arm64_gas_is_s(tok: string): boolean {
  let n = tok.len();
  let i = arm64_gas_trim_lo(tok, 0, n);
  return i < n && tok[i] == b's';
}

function arm64_gas_is_sreg(tok: string): boolean {
  let n = tok.len();
  let i = arm64_gas_trim_lo(tok, 0, n);
  return i + 1 < n && tok[i] == b's' && tok[i + 1] >= b'0' && tok[i + 1] <= b'9';
}

function arm64_gas_arr_code(arr: string): i32 {
  return match (arr) {
    "8b" => 0,
    "16b" => 1,
    "4h" => 2,
    "8h" => 3,
    "2s" => 4,
    "4s" => 5,
    "1d" => 6,
    "2d" => 7,
    "1q" => 9,
    _ => -1,
  };
}

function arm64_gas_arr_size(code: i32): i32 {
  return code / 2;
}

function arm64_gas_arr_q(code: i32): boolean {
  return code % 2 == 1;
}

function arm64_gas_vreg_any(tok: string): i32 {
  let s = arm64_gas_trim(tok);
  let dot = util.index_of_sub(s, ".");
  if (s.len() < 4 || s[0] != b'v' || dot < 2) {
    return -1;
  }
  let n = 0;
  let i = 1;
  while (i < dot) {
    let c = s[i] as i32;
    if (c < 48 || c > 57) {
      return -1;
    }
    n = n * 10 + (c - 48);
    i += 1;
  }
  if (n > 31) {
    return -1;
  }
  if (arm64_gas_arr_code(slice_unchecked(s, dot + 1, s.len()).to_owned()) < 0) {
    return -1;
  }
  return n;
}

function arm64_gas_vreg_arrof(tok: string): i32 {
  let s = arm64_gas_trim(tok);
  let dot = util.index_of_sub(s, ".");
  if (dot < 0 || dot + 1 >= s.len()) {
    return -1;
  }
  return arm64_gas_arr_code(slice_unchecked(s, dot + 1, s.len()).to_owned());
}

function arm64_gas_is_vecarr(tok: string): boolean {
  let n = tok.len();
  let i = arm64_gas_trim_lo(tok, 0, n);
  return i + 1 < n && tok[i] == b'v' && tok[i + 1] >= b'0' && tok[i + 1] <= b'9'
    && util.index_of_sub(tok, ".") > 0;
}

function arm64_gas_routes_vec(mnem: string, ops: string[]): boolean {
  return ops.len() > 0 && (arm64_gas_is_vecarr(ops[0]) || arm64_sha_opcode(mnem) >= 0);
}

function arm64_gas_arr_allowed(sizes: i32, code: i32): boolean {
  let size = arm64_gas_arr_size(code);
  if (size == 3 && !arm64_gas_arr_q(code)) {
    return false;
  }
  return sizes / arm64_gas_pow2(size) % 2 == 1;
}

function arm64_gas_pow2(n: i32): i32 {
  let v = 1;
  let i = 0;
  while (i < n) {
    v *= 2;
    i += 1;
  }
  return v;
}

function arm64_gas_cond_operand(mnem: string): Option[i32] {
  if (mnem == "cset" || mnem == "csetm") {
    return Some(1);
  }
  if (mnem == "cinc" || mnem == "cinv" || mnem == "cneg") {
    return Some(2);
  }
  if (mnem == "csel" || mnem == "csinc" || mnem == "csinv" || mnem == "csneg"
    || mnem == "ccmp" || mnem == "ccmn"
    || mnem == "fcsel" || mnem == "fccmp") {
    return Some(3);
  }
  return None;
}

function arm64_gas_cond_inverts(mnem: string): boolean {
  return mnem == "cset" || mnem == "csetm"
    || mnem == "cinc" || mnem == "cinv" || mnem == "cneg";
}

function arm64_gas_bad_cond_token(mnem: string, ops: string[]): string {
  let Some(idx) = arm64_gas_cond_operand(mnem) else {
    return "";
  };
  if (ops.len() <= idx) {
    return mnem + ":arity";
  }
  let c = ops[idx];
  if (arm64_gas_cond(c) < 0) {
    return c;
  }
  if (arm64_gas_cond_inverts(mnem) && (c == "al" || c == "nv")) {
    return c;
  }
  return "";
}

function arm64_gas_bad_lane(mnem: string, ops: string[], lm: Arm64Mem): string {
  if (arm64_structures(mnem) > 0) {
    return arm64_gas_bad_multi(mnem, ops, lm);
  }
  if (mnem == "ld1r") {
    if (ops.len() != 2) {
      return mnem + ":arity";
    }
    if (arm64_gas_vlist_one(ops[0]) < 0) {
      return arm64_gas_trim(ops[0]);
    }
    let lc = arm64_gas_vlist_one_arr(ops[0]);
    if (lc < 0) {
      return arm64_gas_trim(ops[0]);
    }
    if (arm64_gas_arr_size(lc) > 3) {
      return arm64_gas_trim(ops[0]);
    }
    let m = arm64_gas_mem_at(ops, 1, lm);
    if (m.base < 0 || m.off != 0 || m.off_reg >= 0) {
      return arm64_gas_trim(ops[1]);
    }
    return "";
  }
  if (mnem == "umov" || mnem == "smov") {
    if (ops.len() != 2) {
      return mnem + ":arity";
    }
    let usz = arm64_gas_lane_size(ops[1]);
    if (usz < 0 || arm64_gas_lane_index(ops[1]) < 0) {
      return arm64_gas_trim(ops[1]);
    }
    if (arm64_gas_reg(ops[0]) < 0) {
      return arm64_gas_trim(ops[0]);
    }
    let uw = arm64_gas_is_w(ops[0]);
    if (mnem == "umov") {
      if (uw == (usz == 3)) {
        return mnem + ":dst";
      }
      return "";
    }
    if (usz == 3) {
      return mnem + ":arr";
    }
    if (uw && usz > 1) {
      return mnem + ":dst";
    }
    return "";
  }
  if (mnem == "ins") {
    if (ops.len() != 2) {
      return mnem + ":arity";
    }
    let isz = arm64_gas_lane_size(ops[0]);
    if (isz < 0 || arm64_gas_lane_index(ops[0]) < 0) {
      return arm64_gas_trim(ops[0]);
    }
    let ssz = arm64_gas_lane_size(ops[1]);
    if (ssz >= 0) {
      if (ssz != isz) {
        return mnem + ":arr";
      }
      if (arm64_gas_lane_index(ops[1]) < 0) {
        return arm64_gas_trim(ops[1]);
      }
      return "";
    }
    if (arm64_gas_reg(ops[1]) < 0) {
      return arm64_gas_trim(ops[1]);
    }
    if (arm64_gas_is_w(ops[1]) == (isz == 3)) {
      return mnem + ":src";
    }
    return "";
  }
  if (mnem == "dup") {
    if (ops.len() != 2) {
      return mnem + ":arity";
    }
    let dc = arm64_gas_vreg_arrof(ops[0]);
    if (arm64_gas_vreg_any(ops[0]) < 0) {
      return arm64_gas_trim(ops[0]);
    }
    if (!arm64_gas_arr_allowed(15, dc)) {
      return mnem + ":arr";
    }
    let dsz = arm64_gas_arr_size(dc);
    let lsz = arm64_gas_lane_size(ops[1]);
    if (lsz >= 0) {
      if (lsz != dsz) {
        return mnem + ":arr";
      }
      if (arm64_gas_lane_index(ops[1]) < 0) {
        return arm64_gas_trim(ops[1]);
      }
      return "";
    }
    if (arm64_gas_reg(ops[1]) < 0) {
      return arm64_gas_trim(ops[1]);
    }
    if (arm64_gas_is_w(ops[1]) == (dsz == 3)) {
      return mnem + ":src";
    }
    return "";
  }
  if (ops.len() < 2 || ops.len() > 3) {
    return mnem + ":arity";
  }
  let vc = arm64_gas_vreg_arrof(ops[0]);
  if (arm64_gas_vreg_any(ops[0]) < 0) {
    return arm64_gas_trim(ops[0]);
  }
  if (!arm64_gas_arr_allowed(15, vc)) {
    return mnem + ":arr";
  }
  let vimm = arm64_gas_imm(ops[1]);
  if (vimm < 0 || vimm > 255) {
    return mnem + ":imm";
  }
  let vsz = arm64_gas_arr_size(vc);
  let vshift = 0;
  if (ops.len() == 3) {
    vshift = arm64_gas_lsl_amount(ops[2]);
  }
  if (vsz == 3 && ops.len() != 2) {
    return mnem + ":imm";
  }
  if (vsz == 0 && vshift != 0) {
    return mnem + ":imm";
  }
  if (vsz == 1 && vshift != 0 && vshift != 8) {
    return mnem + ":imm";
  }
  if (vsz == 2 && (vshift % 8 != 0 || vshift > 24)) {
    return mnem + ":imm";
  }
  return "";
}

function arm64_gas_bad_vec_token(mnem: string, ops: string[], lm: Arm64Mem): string {
  let fam = arm64_gas_family(mnem);
  if (fam == arm64_fam_vecldst() || fam == arm64_fam_vecmov() || fam == arm64_fam_movi()) {
    return arm64_gas_bad_lane(mnem, ops, lm);
  }
  if (arm64_across_entry(mnem) >= 0) {
    return arm64_gas_bad_across(mnem, ops);
  }
  if (arm64_gas_routes_vec(mnem, ops)) {
    return arm64_gas_bad_vecgen(mnem, ops);
  }
  return "";
}

function arm64_gas_bad_across(mnem: string, ops: string[]): string {
  let e = arm64_across_entry(mnem);
  if (ops.len() != 2) {
    return mnem + ":arity";
  }
  if (arm64_gas_vreg_any(ops[1]) < 0) {
    return arm64_gas_trim(ops[1]);
  }
  let code = arm64_gas_vreg_arrof(ops[1]);
  let size = arm64_gas_arr_size(code);
  if (size == 3 || size == 2 && !arm64_gas_arr_q(code)) {
    return mnem + ":arr";
  }
  let cls = arm64_gas_scalar_class(ops[0]);
  if (cls < 0) {
    return arm64_gas_trim(ops[0]);
  }
  let want = size;
  if (arm64_vec_entry_sizes(e) == 1) {
    want += 1;
  }
  if (cls != want) {
    return mnem + ":dst";
  }
  return "";
}

function arm64_gas_bad_pairlong(mnem: string, ops: string[]): string {
  if (ops.len() != 2) {
    return mnem + ":arity";
  }
  let dst = arm64_gas_vreg_arrof(ops[0]);
  let src = arm64_gas_vreg_arrof(ops[1]);
  if (dst < 0) {
    return arm64_gas_trim(ops[0]);
  }
  if (src < 0) {
    return arm64_gas_trim(ops[1]);
  }
  if (arm64_gas_arr_size(src) > 2) {
    return mnem + ":arr";
  }
  if (arm64_gas_arr_size(dst) != arm64_gas_arr_size(src) + 1 || arm64_gas_arr_q(dst) != arm64_gas_arr_q(src)) {
    return mnem + ":dst";
  }
  return "";
}

function arm64_gas_bad_vecgen(mnem: string, ops: string[]): string {
  let pmbad = arm64_gas_bad_pmull(mnem, ops);
  if (pmbad != "-") {
    return pmbad;
  }
  let aesbad = arm64_gas_bad_aes(mnem, ops);
  if (aesbad != "-") {
    return aesbad;
  }
  let shabad = arm64_gas_bad_sha(mnem, ops);
  if (shabad != "-") {
    return shabad;
  }
  let nwbad = arm64_gas_bad_narrowwide(mnem, ops);
  if (nwbad != "-") {
    return nwbad;
  }
  if (arm64_pairlong_entry(mnem) >= 0) {
    return arm64_gas_bad_pairlong(mnem, ops);
  }
  let fpbad = arm64_gas_bad_vecfp(mnem, ops);
  if (fpbad != "-") {
    return fpbad;
  }
  let three = arm64_v3int_entry(mnem);
  let logic = arm64_vlogical_entry(mnem);
  let czero = arm64_vcmpzero_entry(mnem);
  let misc = arm64_v2misc_entry(mnem);
  let is_czero: boolean = czero >= 0 && (three < 0
    || ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#');
  let want = 3;
  let entry = three;
  if (is_czero) {
    want = 3;
    entry = czero;
  } else {
    if (three >= 0) {
      want = 3;
      entry = three;
    } else {
      if (logic >= 0) {
        want = 3;
        entry = logic;
      } else {
        if (misc >= 0) {
          want = 2;
          entry = misc;
        } else {
          return "";
        }
      }
    }
  }
  if (ops.len() != want) {
    return mnem + ":arity";
  }
  let nvec = want;
  if (is_czero) {
    nvec = 2;
  }
  let code = arm64_gas_vreg_arrof(ops[0]);
  let i = 0;
  while (i < nvec) {
    if (arm64_gas_vreg_any(ops[i]) < 0) {
      return arm64_gas_trim(ops[i]);
    }
    if (arm64_gas_vreg_arrof(ops[i]) != code) {
      return mnem + ":arr";
    }
    i += 1;
  }
  if (is_czero && arm64_gas_imm(ops[2]) != 0) {
    return mnem + ":imm";
  }
  if (!arm64_gas_arr_allowed(arm64_vec_entry_sizes(entry), code)) {
    return mnem + ":arr";
  }
  return "";
}

function arm64_gas_bad_pmull(mnem: string, ops: string[]): string {
  let e = arm64_vpolylong_entry(mnem);
  if (e < 0) {
    return "-";
  }
  if (ops.len() != 3) {
    return mnem + ":arity";
  }
  let i = 0;
  while (i < 3) {
    if (arm64_gas_vreg_any(ops[i]) < 0) {
      return arm64_gas_trim(ops[i]);
    }
    i += 1;
  }
  let sc = arm64_gas_vreg_arrof(ops[1]);
  if (arm64_gas_vreg_arrof(ops[2]) != sc) {
    return mnem + ":arr";
  }
  let size = arm64_gas_arr_size(sc);
  if (size != 0 && size != 3) {
    return mnem + ":arr";
  }
  if (arm64_gas_arr_q(sc) != (arm64_vec_entry_sizes(e) == 1)) {
    return mnem + ":arr";
  }
  if (arm64_gas_vreg_arrof(ops[0]) != (size + 1) * 2 + 1) {
    return mnem + ":arr";
  }
  return "";
}

function arm64_gas_bad_aes(mnem: string, ops: string[]): string {
  if (arm64_aes_opcode(mnem).is_none()) {
    return "-";
  }
  if (ops.len() != 2) {
    return mnem + ":arity";
  }
  let i = 0;
  while (i < 2) {
    if (arm64_gas_vreg_any(ops[i]) < 0) {
      return arm64_gas_trim(ops[i]);
    }
    if (arm64_gas_vreg_arrof(ops[i]) != 1) {
      return mnem + ":arr";
    }
    i += 1;
  }
  return "";
}

function arm64_gas_bad_sha(mnem: string, ops: string[]): string {
  let opcode = arm64_sha_opcode(mnem);
  if (opcode < 0) {
    return "-";
  }
  let want = 3;
  if (opcode >= 8) {
    want = 2;
  }
  if (ops.len() != want) {
    return mnem + ":arity";
  }
  let i = 0;
  while (i < want) {
    if (arm64_gas_sha_reg(opcode, i, ops[i]) < 0) {
      return mnem + ":reg";
    }
    i += 1;
  }
  return "";
}

function arm64_gas_bad_narrowwide(mnem: string, ops: string[]): string {
  if (arm64_gas_fcvt_nl(mnem) >= 0) {
    return arm64_gas_bad_fcvt_nl(mnem, ops);
  }
  let kind = arm64_gas_shll_kind(mnem);
  let is_xtn = mnem == "xtn" || mnem == "xtn2";
  let is_shrn = mnem == "shrn" || mnem == "shrn2";
  if (kind < 0 && !is_xtn && !is_shrn && mnem != "ext" && mnem != "tbl" && mnem != "tbx") {
    return "-";
  }
  if (mnem == "ext") {
    if (ops.len() != 4) {
      return mnem + ":arity";
    }
    let ec = arm64_gas_vreg_arrof(ops[0]);
    let ei = 0;
    while (ei < 3) {
      if (arm64_gas_vreg_any(ops[ei]) < 0) {
        return arm64_gas_trim(ops[ei]);
      }
      if (arm64_gas_vreg_arrof(ops[ei]) != ec) {
        return mnem + ":arr";
      }
      ei += 1;
    }
    if (!arm64_gas_arr_allowed(1, ec)) {
      return mnem + ":arr";
    }
    let emax = 7;
    if (arm64_gas_arr_q(ec)) {
      emax = 15;
    }
    let eidx = arm64_gas_imm(ops[3]);
    if (eidx < 0 || eidx > emax) {
      return mnem + ":imm";
    }
    return "";
  }
  if (mnem == "tbl" || mnem == "tbx") {
    if (ops.len() != 3) {
      return mnem + ":arity";
    }
    let tc = arm64_gas_vreg_arrof(ops[0]);
    if (arm64_gas_vreg_any(ops[0]) < 0) {
      return arm64_gas_trim(ops[0]);
    }
    if (arm64_gas_vlist_table(ops[1]) < 0) {
      return arm64_gas_trim(ops[1]);
    }
    if (arm64_gas_vreg_any(ops[2]) < 0) {
      return arm64_gas_trim(ops[2]);
    }
    if (arm64_gas_vreg_arrof(ops[2]) != tc) {
      return mnem + ":arr";
    }
    if (!arm64_gas_arr_allowed(1, tc)) {
      return mnem + ":arr";
    }
    return "";
  }
  let want = 3;
  if (is_xtn || kind >= 4) {
    want = 2;
  }
  if (ops.len() != want) {
    return mnem + ":arity";
  }
  if (arm64_gas_vreg_any(ops[0]) < 0) {
    return arm64_gas_trim(ops[0]);
  }
  if (arm64_gas_vreg_any(ops[1]) < 0) {
    return arm64_gas_trim(ops[1]);
  }
  let d = arm64_gas_vreg_arrof(ops[0]);
  let n = arm64_gas_vreg_arrof(ops[1]);
  let hi = util.index_of_sub(mnem, "2") == mnem.len() - 1;
  if (is_xtn || is_shrn) {
    if (!arm64_gas_narrow_wide_ok(d, n, hi)) {
      return mnem + ":arr";
    }
    if (is_shrn) {
      let nes = arm64_gas_esize(d);
      let sh = arm64_gas_imm(ops[2]);
      if (sh < 1 || sh > nes) {
        return mnem + ":imm";
      }
    }
    return "";
  }
  if (!arm64_gas_narrow_wide_ok(n, d, hi)) {
    return mnem + ":arr";
  }
  if (kind < 4) {
    let ses = arm64_gas_esize(n);
    let amt = arm64_gas_imm(ops[2]);
    if (amt < 0 || amt >= ses) {
      return mnem + ":imm";
    }
  }
  return "";
}

function arm64_gas_bad_vecfp(mnem: string, ops: string[]): string {
  let fz = arm64_vfpcmpzero_entry(mnem);
  let f3 = arm64_vfp3_entry(mnem);
  let f2 = arm64_vfp2_entry(mnem);
  let sh = arm64_vshift_entry(mnem);
  let pm = arm64_vpermute_opc(mnem);
  if (fz < 0 && f3 < 0 && f2 < 0 && sh < 0 && pm < 0) {
    return "-";
  }
  let is_fz: boolean = fz >= 0 && (f3 < 0
    || ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#');
  let want = 3;
  let nvec = 3;
  if (is_fz || sh >= 0) {
    nvec = 2;
  } else {
    if (f3 < 0 && pm < 0 && f2 >= 0) {
      want = 2;
      nvec = 2;
    }
  }
  if (ops.len() != want) {
    return mnem + ":arity";
  }
  let code = arm64_gas_vreg_arrof(ops[0]);
  let i = 0;
  while (i < nvec) {
    if (arm64_gas_vreg_any(ops[i]) < 0) {
      return arm64_gas_trim(ops[i]);
    }
    if (arm64_gas_vreg_arrof(ops[i]) != code) {
      return mnem + ":arr";
    }
    i += 1;
  }
  if (sh >= 0) {
    if (!arm64_gas_arr_allowed(15, code)) {
      return mnem + ":arr";
    }
    let es = arm64_gas_esize(code);
    let amt = arm64_gas_imm(ops[2]);
    if (arm64_vec_entry_sizes(sh) == 1) {
      if (amt < 0 || amt >= es) {
        return mnem + ":imm";
      }
    } else {
      if (amt < 1 || amt > es) {
        return mnem + ":imm";
      }
    }
    return "";
  }
  if (pm >= 0) {
    if (!arm64_gas_arr_allowed(15, code)) {
      return mnem + ":arr";
    }
    return "";
  }
  if (!arm64_gas_arr_allowed(12, code)) {
    return mnem + ":arr";
  }
  if (is_fz) {
    let z = arm64_gas_trim(ops[2]);
    if (z != "#0.0" && z != "#0") {
      return mnem + ":imm";
    }
  }
  return "";
}

function arm64_gas_operands(rest: string): string[] {
  let out: string[] = [];
  let depth = 0;
  let start = 0;
  let i = 0;
  while (i < rest.len()) {
    let c = rest[i];
    if (c == b'[') {
      depth += 1;
    } else if (c == b']') {
      depth -= 1;
    } else if (c == b',' && depth == 0) {
      out = out.append(arm64_gas_trim_span(rest, start, i));
      start = i + 1;
    }
    i += 1;
  }
  let last = arm64_gas_trim_span(rest, start, rest.len());
  if (last.len() > 0) {
    out = out.append(last);
  }
  return out;
}

struct Arm64Mem {
  base: i32,
  off: i32,
  off_reg: i32,
  idx_w: boolean,
  ext_opt: i32,
  ext_amt: i32,
  ext_has_amt: boolean,
  at: i32,
}

function arm64_gas_mem(op: string): Arm64Mem {
  let lb = util.index_of_sub(op, "[");
  let rb = util.index_of_sub(op, "]");
  let parts: string[] = [];
  if (lb >= 0 && rb > lb) {
    parts = arm64_gas_operands(slice_unchecked(op, lb + 1, rb));
  } else {
    parts = arm64_gas_operands(op);
  }
  let base: i32 = -1;
  if (parts.len() > 0) {
    base = arm64_gas_reg(parts[0]);
  }
  let off = 0;
  let off_reg: i32 = -1;
  let idx_w = false;
  let ext_opt = 3;
  let ext_amt = 0;
  let ext_has_amt = false;
  if (parts.len() > 1) {
    let r = arm64_gas_reg(parts[1]);
    if (util.index_of_sub(parts[1], "#") < 0 && r >= 0) {
      off_reg = r;
      idx_w = arm64_gas_is_w(parts[1]);
      if (parts.len() > 2) {
        ext_opt = arm64_gas_mem_opt(parts[2]);
        if (util.index_of_sub(parts[2], "#") >= 0) {
          ext_amt = arm64_gas_lsl_amount(parts[2]);
          ext_has_amt = true;
        }
      }
    } else if (!arm64_gas_is_page_offset(parts[1])) {
      off = arm64_gas_imm(parts[1]);
    }
  }
  return Arm64Mem {
    base: base, off: off, off_reg: off_reg,
    idx_w: idx_w, ext_opt: ext_opt, ext_amt: ext_amt, ext_has_amt: ext_has_amt,
    at: -1,
  };
}

// A :lo12: or @PAGEOFF operand is a relocation, and the fixup supplies its
// value.
function arm64_gas_is_page_offset(p: string): boolean {
  return util.index_of_sub(p, ":lo12:") >= 0 || util.index_of_sub(p, "@PAGEOFF") >= 0;
}

function arm64_gas_line_mem(ops: string[]): Arm64Mem {
  let i = 0;
  while (i < ops.len()) {
    if (util.index_of_sub(ops[i], "[") >= 0) {
      let m = arm64_gas_mem(ops[i]);
      return Arm64Mem { ...m, at: i };
    }
    i += 1;
  }
  return Arm64Mem {
    base: -1, off: 0, off_reg: -1, idx_w: false,
    ext_opt: 3, ext_amt: 0, ext_has_amt: false, at: -1,
  };
}

function arm64_gas_mem_at(ops: string[], k: i32, lm: Arm64Mem): Arm64Mem {
  if (lm.at == k) {
    return lm;
  }
  return arm64_gas_mem(ops[k]);
}

function arm64_gas_mem_opt(p: string): i32 {
  if (util.index_of_sub(p, "lsl") == 0) {
    if (util.index_of_sub(p, "#") < 0) {
      return -1;
    }
    return 3;
  }
  if (util.index_of_sub(p, "uxtw") == 0) {
    return 2;
  }
  if (util.index_of_sub(p, "sxtw") == 0) {
    return 6;
  }
  if (util.index_of_sub(p, "sxtx") == 0) {
    return 7;
  }
  return -1;
}

function arm64_movwide_hw(v: i64): i32 {
  if (v == 0) {
    return 0;
  }
  let sh: i32 = 0;
  let found: i32 = -1;
  while (sh < 64) {
    let chunk = v >> sh & 0xffff;
    if (chunk != 0) {
      if (found >= 0) {
        return -1;
      }
      found = sh;
    }
    sh += 16;
  }
  return found;
}

function arm64_gas_movwide_out_of_range(mnem: string, ops: string[]): boolean {
  if (mnem != "mov" && mnem != "movz" && mnem != "movn") {
    return false;
  }
  if (ops.len() < 2) {
    return false;
  }
  if (ops[1].len() == 0 || ops[1][0] != b'#') {
    return false;
  }
  if (ops.len() > 2 && arm64_gas_lsl_amount(ops[2]) != 0) {
    return false;
  }
  let v = arm64_gas_imm64(ops[1]);
  if (v < 0) {
    v = -v - 1;
  }
  return arm64_movwide_hw(v) < 0;
}

function arm64_gas_regoff_unsupported(mnem: string, ops: string[], lm: Arm64Mem): boolean {
  if (mnem != "ldrsw" && mnem != "ldrsb" && mnem != "ldrsh" && mnem != "ldur" && mnem != "stur") {
    return false;
  }
  return lm.at >= 0 && lm.off_reg >= 0;
}

function arm64_gas_has_bang(op: string): boolean {
  return util.index_of_sub(op, "!") >= 0;
}

function arm64_gas_writeback_unsupported(mnem: string, ops: string[]): boolean {
  if (mnem != "ldrb" && mnem != "strb" && mnem != "ldrh" && mnem != "strh" && mnem != "ldrsw"
    && mnem != "ldrsb" && mnem != "ldrsh" && mnem != "ldur" && mnem != "stur") {
    return false;
  }
  let i = 0;
  while (i < ops.len()) {
    if (util.index_of_sub(ops[i], "[") >= 0 && arm64_gas_has_bang(ops[i])) {
      return true;
    }
    i += 1;
  }
  return false;
}

function arm64_gas_lsl_amount(tok: string): i32 {
  let s = arm64_gas_trim(tok);
  let h = util.index_of_sub(s, "#");
  if (h < 0) {
    return 0;
  }
  return arm64_gas_atoi(arm64_gas_trim(slice_unchecked(s, h + 1, s.len())));
}

function arm64_gas_shift_type(tok: string): i32 {
  let s = arm64_gas_trim(tok);
  if (util.index_of_sub(s, "lsl") == 0) {
    return 0;
  }
  if (util.index_of_sub(s, "lsr") == 0) {
    return 1;
  }
  if (util.index_of_sub(s, "asr") == 0) {
    return 2;
  }
  if (util.index_of_sub(s, "ror") == 0) {
    return 3;
  }
  return -1;
}

function arm64_gas_extend_option(tok: string): Option[i32] {
  let s = arm64_gas_trim(tok);
  if (util.index_of_sub(s, "uxtb") == 0) {
    return Some(0);
  }
  if (util.index_of_sub(s, "uxth") == 0) {
    return Some(1);
  }
