import "./ssacapacityisa" as isa;

struct Half { kind: i32, identity: i64, high: boolean }

struct Word { low: Half, high: Half }

struct State { regs: Word[], memory: Half[], writes: i32[], calls: i32, successor: i32, zero: i32, carry: i32, ok: boolean }

function half(kind: i32, identity: i64, high: boolean): Half {
  return Half { kind: kind, identity: identity, high: high };
}

function token(kind: i32, identity: i64): Word {
  return Word { low: half(kind, identity, false), high: half(kind, identity, true) };
}

function number(n: i64): Word {
  let low = n % 4294967296;
  return Word { low: half(0, if (low < 0) { low + 4294967296 } else { low }, false), high: half(0, if (n < 0) { 4294967295 } else { n / 4294967296 }, false) };
}

function same(a: Half, b: Half): boolean {
  return a.kind == b.kind && a.identity == b.identity && a.high == b.high;
}

function equal(a: Word, b: Word): boolean {
  return same(a.low, b.low) && same(a.high, b.high);
}

function narrowed(w: Word, width: i32): Word {
  return if (width == 32) { Word { ...w, high: number(0).high } } else { w };
}

function initial_word(capacity: i32, hit: boolean, i: i32): Word {
  let slot = 8 + (capacity + 3) * 2;
  if (i == 4 || i == 5) {
    return token(4, 0);
  }
  if (i < 8) {
    return token(5, (i / 2) as i64);
  }
  if (i < slot) {
    return token(6, ((i - 8) / 2) as i64);
  }
  if (i < slot + 2) {
    return if (hit) { token(10, 0) } else { number(0) };
  }
  return if (i < slot + 4) { token(11, 0) } else { token(12, ((i - slot - 2) / 2) as i64) };
}

function initial(capacity: i32, hit: boolean): State {
  let regs: Word[] = [];
  let memory: Half[] = [];
  let writes: i32[] = [];
  let i = 0;
  while (i < 16) {
    regs = regs.append(if (i == 4) { token(2, 0) } else { if (i == 7) { number(capacity as i64) } else { token(1, i as i64) } });
    i = i + 1;
  }
  i = 0;
  while (i < 10 + (capacity + 3) * 4) {
    let w = initial_word(capacity, hit, i);
    memory = memory.append(if (i % 2 == 0) { w.low } else { w.high });
    writes = writes.append(0);
    i = i + 1;
  }
  return State { regs: regs, memory: memory, writes: writes, calls: 0, successor: -1, zero: -1, carry: -1, ok: true };
}

function words(s: State): i32 {
  return (s.memory.len() - 10) / 4;
}

function write(s: State, reg: i32, w: Word): State {
  return State { ...s, regs: s.regs.with(reg, w) };
}

function unknown(s: State): State {
  return State { ...s, zero: -1, carry: -1 };
}

function pointer(w: Word): boolean {
  return (w.low.kind == 2 || w.low.kind == 3 || w.low.kind == 9 || w.low.kind == 10) && equal(w, token(w.low.kind, w.low.identity));
}

function unsigned(w: Word): boolean {
  return w.low.kind == 0 && same(w.high, number(0).high);
}

function displaced(w: Word, offset: i64): Word {
  return token(w.low.kind, w.low.identity + offset);
}

function add(s: State, op: isa.Op): State {
  let w = s.regs[op.destination];
  let delta = if (op.kind == 9) { -(op.immediate as i64) } else { op.immediate as i64 };
  if (op.source >= 0) {
    return register_add(unknown(s), op);
  }
  if (pointer(w) && op.width == 64 && delta >= -64 && delta <= 64) {
    let next = w.low.identity + delta;
    return if (next >= -64 && next <= 64) { write(unknown(s), op.destination, displaced(w, delta)) } else { State { ...s, ok: false } };
  }
  return numeric_add(unknown(s), op.destination, w, delta);
}

function register_add(s: State, op: isa.Op): State {
  let a = s.regs[op.destination];
  let b = s.regs[op.source];
  if (op.width != 64) {
    return State { ...s, ok: false };
  }
  if (op.kind == 10 && unsigned(a) && equal(b, token(9, 0))) {
    return write(s, op.destination, token(9, a.low.identity));
  }
  if (op.kind == 9 && a.low.kind == 9 && pointer(a) && equal(b, token(9, 0))) {
    return write(s, op.destination, number(a.low.identity));
  }
  return State { ...s, ok: false };
}

function numeric_add(s: State, reg: i32, w: Word, delta: i64): State {
  if (unsigned(w)) {
    let n = w.low.identity + delta;
    if (n >= 0 && n <= 4294967295) {
      return write(s, reg, number(n));
    }
  }
  return State { ...s, ok: false };
}

function shift(s: State, op: isa.Op): State {
  let w = s.regs[op.destination];
  let count = op.immediate % op.width;
  if (count == 0) {
    return write(s, op.destination, narrowed(w, op.width));
  }
  if (!unsigned(w)) {
    return State { ...s, ok: false };
  }
  let n = w.low.identity;
  while (count > 0) {
    if (op.kind == 20 && n > 2147483647) {
      return State { ...s, ok: false };
    }
    n = if (op.kind == 20) { n * 2 } else { n / 2 };
    count = count - 1;
  }
  return write(unknown(s), op.destination, number(n));
}

function cell(s: State, base: Word, offset: i32, width: i32): i32 {
  if (!pointer(base) || offset < -64 || offset > 64) {
    return -1;
  }
  let at = base.low.identity + offset as i64;
  let bytes = width / 8;
  if (at % 4 != 0) {
    return -1;
  }
  return cell_extent(s, base.low.kind, at, bytes);
}

function cell_extent(s: State, kind: i32, at: i64, bytes: i32): i32 {
  let extent = (words(s) * 8) as i64;
  if (kind == 2 && at >= -16 && at + bytes <= 16) {
    return ((at + 16) / 4) as i32;
  }
  if (kind == 3 && s.calls == 1 && at >= 0 && at + bytes <= extent) {
    return 8 + (at / 4) as i32;
  }
  if (kind == 9 && at == extent && bytes == 8) {
    return 8 + words(s) * 2;
  }
  if (kind == 10 && at >= 0 && at + bytes <= extent) {
    return 10 + words(s) * 2 + (at / 4) as i32;
  }
  return -1;
}

function writable(s: State, at: i32): boolean {
  let slot = 8 + words(s) * 2;
  return at >= 0 && at < 4 || at >= 8 && at < 14 || at >= slot && at < slot + 8;
}

function store_at(s: State, at: i32, width: i32, w: Word): State {
  if (!writable(s, at)) {
    return State { ...s, ok: false };
  }
  let count = width / 32;
  let i = 0;
  let memory = s.memory;
  let writes = s.writes;
  while (i < count) {
    let pos = at + i;
    if (!writable(s, pos) || pos >= 8 && writes[pos] != 0) {
      return State { ...s, ok: false };
    }
    memory = memory.with(pos, if (i == 0) { w.low } else { w.high });
    writes = writes.with(pos, writes[pos] + 1);
    i = i + 1;
  }
  return State { ...s, memory: memory, writes: writes };
}

function loaded(s: State, at: i32, width: i32): Word {
  return Word { low: s.memory[at], high: if (width == 64) { s.memory[at + 1] } else { number(0).high } };
}

function load_at(s: State, at: i32, width: i32, reg: i32): State {
  if (at < 0) {
    return State { ...s, ok: false };
  }
  return write(s, reg, loaded(s, at, width));
}

function memory_step(s: State, op: isa.Op): State {
  if (op.index >= 0) {
    return State { ...s, ok: false };
  }
  let at = cell(s, s.regs[op.base], op.offset, op.width);
  if (op.kind == 3) {
    return load_at(s, at, op.width, op.destination);
  }
  let w = if (op.kind == 22) { number(op.immediate as i64) } else { s.regs[op.source] };
  return store_at(s, at, op.width, w);
}

function push(s: State, w: Word): State {
  let next = displaced(s.regs[4], -8);
  let stored = store_at(s, cell(s, next, 0, 64), 64, w);
  return write(stored, 4, next);
}

function stack_step(s: State, op: isa.Op): State {
  let sp = s.regs[4];
  if (!pointer(sp) || sp.low.kind != 2 || op.index >= 0) {
    return State { ...s, ok: false };
  }
  if (op.kind == 6) {
    return push(s, s.regs[op.source]);
  }
  if (op.kind == 32) {
    let at = cell(s, s.regs[op.base], op.offset, 64);
    return if (at < 0) { State { ...s, ok: false } } else { push(s, loaded(s, at, 64)) };
  }
  let at = cell(s, sp, 0, 64);
  if (at < 0) {
    return State { ...s, ok: false };
  }
  let advanced = write(s, 4, displaced(sp, 8));
  return if (op.kind == 7) { write(advanced, op.destination, loaded(s, at, 64)) } else { store_at(advanced, cell(advanced, advanced.regs[op.base], op.offset, 64), 64, loaded(s, at, 64)) };
}

function allocation(s: State, capacity: i32, pc: i32, op: isa.Op): State {
  if (op.symbol != "__fern_alloc" || s.calls != 0 || !equal(s.regs[4], token(2, -8))) {
    return State { ...s, ok: false };
  }
  if (!equal(s.regs[7], number((capacity as i64 + 3) * 8))) {
    return State { ...s, ok: false };
  }
  let called = store_at(s, 0, 64, token(8, (pc + 1) as i64));
  called = write(write(called, 0, token(3, 0)), 7, token(7, 0));
  return State { ...unknown(called), calls: 1, successor: pc + 1 };
}

function lea(s: State, op: isa.Op): State {
  if (op.base < 0 && op.index >= 0) {
    let index = s.regs[op.index];
    return if (unsigned(index)) { numeric_add(s, op.destination, number(index.low.identity * (op.scale as i64)), op.offset as i64) } else { State { ...s, ok: false } };
  }
  let w = s.regs[op.base];
  if (op.index >= 0 || !pointer(w) || op.offset < -64 || op.offset > 64) {
    return State { ...s, ok: false };
  }
  let next = w.low.identity + op.offset as i64;
  return if (next >= -64 && next <= 64) { write(s, op.destination, displaced(w, op.offset as i64)) } else { State { ...s, ok: false } };
}

function compare(s: State, op: isa.Op): State {
  let w = narrowed(s.regs[op.source], op.width);
  let against = if (op.kind == 27) { 0 as i64 } else { op.immediate as i64 };
  if (against == 0 && equal(w, token(10, 0))) {
    return State { ...s, zero: 0, carry: 0 };
  }
  if (!unsigned(w) || against < 0) {
    return unknown(s);
  }
  return State { ...s, zero: if (w.low.identity == against) { 1 } else { 0 }, carry: if (w.low.identity < against) { 1 } else { 0 } };
}

function simple(s: State, op: isa.Op): State {
  if (op.kind == 1) {
    return s;
  }
  if (op.kind == 2) {
    return write(s, op.destination, narrowed(s.regs[op.source], op.width));
  }
  if (op.kind == 5) {
    return write(s, op.destination, narrowed(number(op.immediate as i64), op.width));
  }
  if (op.kind == 6 || op.kind == 7 || op.kind == 32 || op.kind == 33) {
    return stack_step(s, op);
  }
  if (op.kind == 19 && op.symbol == "__fern_freelist") {
    return write(s, op.destination, token(9, 0));
  }
  return State { ...s, ok: false };
}

function step(s: State, capacity: i32, pc: i32, op: isa.Op): State {
  if (op.kind == 3 || op.kind == 4 || op.kind == 22) {
    return memory_step(s, op);
  }
  if (op.kind == 9 || op.kind == 10) {
    return add(s, op);
  }
  if (op.kind == 20 || op.kind == 21) {
    return shift(s, op);
  }
  if (op.kind == 15) {
    return lea(s, op);
  }
  if (op.kind == 16 || op.kind == 27) {
    return compare(s, op);
  }
  return if (op.kind == 25) { allocation(s, capacity, pc, op) } else { simple(s, op) };
}

function inverse(value: i32): i32 {
  return if (value < 0) { -1 } else { 1 - value };
}

function branch(s: State, condition: string): i32 {
  if (condition == "jmp") {
    return 1;
  }
  if (condition == "je" || condition == "jz") {
    return s.zero;
  }
  if (condition == "jne" || condition == "jnz") {
    return inverse(s.zero);
  }
  if (condition == "jb") {
    return s.carry;
  }
  if (condition == "jae") {
    return inverse(s.carry);
  }
  let below = if (s.zero < 0 || s.carry < 0) { -1 } else { if (s.zero == 1 || s.carry == 1) { 1 } else { 0 } };
  return if (condition == "jbe") { below } else { if (condition == "ja") { inverse(below) } else { -1 } };
}

function header(capacity: i32, base: i32, i: i32): Half {
  let w = if (i - base == 2 || i - base == 3) { number(1) } else { number(capacity as i64) };
  return if (i % 2 == 0) { w.low } else { w.high };
}

function expected_memory(s: State, original: State, capacity: i32, hit: boolean, i: i32): Half {
  let slot = 8 + words(s) * 2;
  if (i < 2) {
    let w = if (hit) { token(11, 0) } else { token(8, s.successor as i64) };
    return if (i % 2 == 0) { w.low } else { w.high };
  }
  if (i < 4) {
    return if (i % 2 == 0) { number(capacity as i64).low } else { number(capacity as i64).high };
  }
  if (!hit && i >= 8 && i < 14) {
    return header(capacity, 8, i);
  }
  if (hit && i >= slot && i < slot + 2) {
    return if (i % 2 == 0) { token(11, 0).low } else { token(11, 0).high };
  }
  return if (hit && i >= slot + 2 && i < slot + 8) { header(capacity, slot + 2, i) } else { original.memory[i] };
}

function expected_writes(s: State, hit: boolean, i: i32): i32 {
  let slot = 8 + words(s) * 2;
  if (!hit && i >= 8 && i < 14 || hit && i >= slot && i < slot + 8) {
    return 1;
  }
  return 0;
}

function finished(s: State, capacity: i32, hit: boolean): boolean {
  if (s.calls != (if (hit) { 0 } else { 1 }) || !s.ok) {
    return false;
  }
  let original = initial(capacity, hit);
  let i = 0;
  while (i < 16) {
    let expected = if (i == 0) { token(if (hit) { 10 } else { 3 }, 16) } else { original.regs[i] };
    if (!equal(s.regs[i], expected)) {
      return false;
    }
    i = i + 1;
  }
  return finished_memory(s, original, capacity, hit);
}

function finished_memory(s: State, original: State, capacity: i32, hit: boolean): boolean {
  let i = 0;
  while (i < s.memory.len()) {
    if (!same(s.memory[i], expected_memory(s, original, capacity, hit, i))) {
      return false;
    }
    if (i >= 8 && s.writes[i] != expected_writes(s, hit, i)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function path(p: isa.Program, capacity: i32, hit: boolean): boolean {
  let s = initial(capacity, hit);
  let visited: boolean[] = [];
  for op in p.ops {
    visited = visited.append(false);
  }
  let pc = 0;
  while (pc >= 0 && pc < p.ops.len()) {
    if (visited[pc]) {
      return false;
    }
    visited = visited.with(pc, true);
    let op = p.ops[pc];
    if (op.kind == 18) {
      return finished(s, capacity, hit);
    }
    if (op.kind == 17) {
      let taken = branch(s, op.condition);
      if (taken < 0) {
        return false;
      }
      pc = if (taken == 1) { op.target } else { pc + 1 };
    } else {
      s = step(s, capacity, pc, op);
      if (!s.ok) {
        return false;
      }
      pc = pc + 1;
    }
  }
  return false;
}

pub function check(output: string): boolean {
  let p = isa.array_box_program(output);
  return p.error == "" && path(p, 2, false) && path(p, 2, true) && path(p, 3, false) && path(p, 3, true);
}
