import "./ast";
import "./astwalk";
import "./checker";
import "./flatten";
import "./lexical";
import "./lspassist";
import "./lspquery";
import "./parser";
import "./util";

const T_FUNCTION: i32 = 0;

const T_METHOD: i32 = 1;

const T_STRUCT: i32 = 2;

const T_ENUM: i32 = 3;

const T_ENUM_MEMBER: i32 = 4;

const T_PARAMETER: i32 = 5;

const T_VARIABLE: i32 = 6;

const T_PROPERTY: i32 = 7;

const T_TYPE: i32 = 8;

const T_NAMESPACE: i32 = 10;

pub struct SemTok { line: i32, col: i32, len: i32, kind: i32 }

pub function semantic_tokens(p: lspquery.Program, m: i32): SemTok[] {
  let v: lspquery.View = lspquery.view_of(p);
  let x: Ctx = Ctx { toks: lspquery.module_toks(p, m), aliases: lspquery.quals_of(v, m).aliases };
  let kinds: i32[] = [];
  for t in x.toks {
    kinds = kinds.append(0 - 1);
  }
  let body: Mark[] = body_classes(v.types, m, x);
  kinds = applied(kinds, decl_classes(p, m, x, body));
  let types: Mark[] = type_classes(v, type_params(lspquery.parsed_module(p, m)), m, x, kinds);
  kinds = applied(kinds, types);
  let out: SemTok[] = [];
  let i: i32 = 0;
  while (i < x.toks.len()) {
    if (kinds[i] >= 0) {
      out = out.append(SemTok { line: x.toks[i].line, col: x.toks[i].col, len: x.toks[i].text.len(), kind: kinds[i] });
    }
    i = i + 1;
  }
  return out;
}

struct Ctx { toks: lspquery.Tok[], aliases: string[] }

struct Mark { i: i32, kind: i32 }

function applied(own kinds: i32[], marks: Mark[]): i32[] {
  for mk in marks {
    if (kinds[mk.i] < 0) {
      kinds = kinds.with(mk.i, mk.kind);
    }
  }
  return kinds;
}

function marked(x: Ctx, i: i32, kind: i32, own acc: Mark[]): Mark[] {
  if (i < 0 || i >= x.toks.len() || kind < 0 || !x.toks[i].ident && !util.has_str(x.aliases, x.toks[i].text)) {
    return acc;
  }
  return acc.append(Mark { i: i, kind: kind });
}

function node_at(x: Ctx, line: i32, col: i32, kind: i32, own acc: Mark[]): Mark[] {
  let i: i32 = lspquery.tok_at(x.toks, line, col);
  if (i < 0) {
    return acc;
  }
  if (!x.toks[i].ident && x.toks[i].text == ".") {
    return marked(x, i + 1, kind, acc);
  }
  if (qualifies(x, i)) {
    return marked(x, i + 2, kind, marked(x, i, T_NAMESPACE, acc));
  }
  return marked(x, i, kind, acc);
}

function qualifies(x: Ctx, i: i32): boolean {
  return util.has_str(x.aliases, x.toks[i].text) && i + 2 < x.toks.len() && lspquery.punct_before(x.toks, i + 2, ".") && !lspquery.punct_before(x.toks, i, ".");
}

function body_classes(v: checker.QueryView, m: i32, x: Ctx): Mark[] {
  let s: checker.Scope = checker.module_scope(v);
  let out: Mark[] = [];
  for fd in v.mod.funcs {
    if (lspquery.declared_in(fd.line, m)) {
      let r: lexical.ResolvedFunction = lexical.resolve_func(fd);
      let params: string[] = [];
      for b in r.bindings {
        if (lspquery.is_param(b, fd)) {
          params = params.append(b.symbol);
        }
      }
      out = func_classes(s, x, r.func.body, params, out);
      for b in r.bindings {
        let a: lspquery.Answer = lspquery.binding_decl(x.toks, b, util.has_str(params, b.symbol), b.name);
        let i: i32 = lspquery.tok_at(x.toks, a.line, a.col);
        if (a.found && i >= 0 && x.toks[i].text == b.name) {
          out = marked(x, i, local_kind(b.symbol, params), out);
        }
      }
    }
  }
  return out;
}

struct Classify { s: checker.Scope, x: Ctx, params: string[], marks: Mark[] }

function func_classes(s: checker.Scope, x: Ctx, body: ast.Stmt[], params: string[], own out: Mark[]): Mark[] {
  let c: Classify = Classify { s: s, x: x, params: params, marks: out };
  for st in body {
    c = astwalk.fold_stmt_nodes(st, c, classify_stmt, classify_expr, astwalk.descend_all);
  }
  return c.marks;
}

function classify_stmt(st: ast.Stmt, own c: Classify): Classify {
  return Classify { ...c, marks: stmt_class(c.x, st, c.params, c.marks) };
}

function classify_expr(e: ast.Expr, own c: Classify): Classify {
  return Classify { ...c, marks: expr_class(c.s, c.x, e, c.params, c.marks) };
}

function stmt_class(x: Ctx, st: ast.Stmt, params: string[], own acc: Mark[]): Mark[] {
  match (st) {
    ast.StmtAssign(a) => {
      if (local(a.target)) {
        return node_at(x, a.target_line, a.target_col, local_kind(a.target, params), acc);
      }
    },
    ast.StmtMatch(m) => {
      for arm in m.arms {
        if let ast.PatVariant(pv) = arm.pattern {
          acc = pattern_variants(x, lspquery.tok_at(x.toks, arm.line, arm.col), pv.type_name, acc);
        }
      }
    },
    _ => {}
  }
  return acc;
}

function pattern_variants(x: Ctx, i: i32, name: string, own acc: Mark[]): Mark[] {
  if (i < 0) {
    return acc;
  }
  let end: i32 = lspquery.pattern_end(x.toks, i);
  let j: i32 = i;
  while (j < end) {
    if (spells_variant(x.toks[j], name) && lspquery.text_at(x.toks, j + 1) != ":") {
      acc = pattern_class(x, qualifier_of(x, j), acc);
    }
    j = j + 1;
  }
  return acc;
}

function spells_variant(t: lspquery.Tok, name: string): boolean {
  return t.ident && (name == t.text || util.str_has_suffix(name, "__" + t.text) || util.str_has_suffix(name, "." + t.text));
}

function qualifier_of(x: Ctx, j: i32): i32 {
  if (j >= 2 && lspquery.punct_before(x.toks, j, ".")) {
    return j - 2;
  }
  return j;
}

function pattern_class(x: Ctx, i: i32, own acc: Mark[]): Mark[] {
  if (i < 0) {
    return acc;
  }
  if (qualifies(x, i)) {
    return marked(x, i + 2, T_ENUM_MEMBER, marked(x, i, T_NAMESPACE, acc));
  }
  if (i + 2 < x.toks.len() && lspquery.punct_before(x.toks, i + 2, ".")) {
    return marked(x, i + 2, T_ENUM_MEMBER, marked(x, i, T_ENUM, acc));
  }
  return marked(x, i, T_ENUM_MEMBER, acc);
}

function expr_class(s: checker.Scope, x: Ctx, e: ast.Expr, params: string[], own acc: Mark[]): Mark[] {
  match (e) {
    ast.ExprIdent(id) => {
      return node_at(x, id.line, id.col, ident_kind(s, id.name, params), acc);
    },
    ast.ExprCall(call) => {
      if let ast.ExprFieldAccess(fa) = call.callee {
        return node_at(x, fa.line, fa.col, member_kind(s, fa, T_METHOD), acc);
      }
    },
    ast.ExprFieldAccess(fa) => {
      return node_at(x, fa.line, fa.col, member_kind(s, fa, T_PROPERTY), acc);
    },
    ast.ExprStructLit(sl) => {
      acc = node_at(x, sl.line, sl.col, T_STRUCT, acc);
      let i: i32 = 0;
      while (i < sl.field_lines.len()) {
        acc = node_at(x, sl.field_lines[i], sl.field_cols[i], T_PROPERTY, acc);
        i = i + 1;
      }
    },
    _ => {}
  }
  return acc;
}

function member_kind(s: checker.Scope, fa: ast.ExprFieldAccess, kind: i32): i32 {
  if (lspquery.enum_qualifier(s, fa).len() > 0) {
    return T_ENUM_MEMBER;
  }
  return kind;
}

function local(name: string): boolean {
  return util.str_has_prefix(name, "$binding$");
}

function local_kind(symbol: string, params: string[]): i32 {
  if (util.has_str(params, symbol)) {
    return T_PARAMETER;
  }
  return T_VARIABLE;
}

function ident_kind(s: checker.Scope, name: string, params: string[]): i32 {
  if (local(name)) {
    return local_kind(name, params);
  }
  return global_kind(s, name);
}

function global_kind(s: checker.Scope, name: string): i32 {
  if (checker.variant_enum(s, name).len() > 0) {
    return T_ENUM_MEMBER;
  }
  let sig: checker.FuncSig = checker.func_sig(s, name);
  if (sig.name.len() > 0 && sig.is_const) {
    return T_VARIABLE;
  }
  if (sig.name.len() > 0 || parser.is_builtin_function(name)) {
    return T_FUNCTION;
  }
  return type_kind(s, name);
}

function type_kind(s: checker.Scope, name: string): i32 {
  let u: checker.UnionSig = checker.enum_sig(s, name);
  if (u.name.len() > 0 && u.is_enum) {
    return T_ENUM;
  }
  if (u.name.len() > 0) {
    return T_TYPE;
  }
  if (checker.struct_sig(s, name).name.len() > 0) {
    return T_STRUCT;
  }
  return 0 - 1;
}

function decl_classes(p: lspquery.Program, m: i32, x: Ctx, own acc: Mark[]): Mark[] {
  for sym in lspassist.symbols(p, m) {
    acc = symbol_class(x, sym, acc);
  }
  return acc;
}

function symbol_class(x: Ctx, sym: lspassist.Symbol, own acc: Mark[]): Mark[] {
  acc = marked(x, lspquery.tok_at(x.toks, sym.name_line, sym.name_col), symbol_kind(sym.kind), acc);
  for child in sym.children {
    acc = symbol_class(x, child, acc);
  }
  return acc;
}

function symbol_kind(kind: i32): i32 {
  if (kind == lspassist.SK_FUNCTION) {
    return T_FUNCTION;
  }
  if (kind == lspassist.SK_METHOD) {
    return T_METHOD;
  }
  if (kind == lspassist.SK_STRUCT) {
    return T_STRUCT;
  }
  if (kind == lspassist.SK_FIELD) {
    return T_PROPERTY;
  }
  if (kind == lspassist.SK_ENUM) {
    return T_ENUM;
  }
  if (kind == lspassist.SK_ENUM_MEMBER) {
    return T_ENUM_MEMBER;
  }
  return T_VARIABLE;
}

function type_classes(v: lspquery.View, tparams: string[], m: i32, x: Ctx, kinds: i32[]): Mark[] {
  let s: checker.Scope = checker.module_scope(v.types);
  let q: flatten.Qualifiers = lspquery.quals_of(v, m);
  let out: Mark[] = [];
  let i: i32 = 0;
  while (i < x.toks.len()) {
    if (kinds[i] < 0 && !lspquery.punct_before(x.toks, i, ".")) {
      out = type_class(s, q, tparams, x, i, out);
    }
    i = i + 1;
  }
  return out;
}

function type_class(s: checker.Scope, q: flatten.Qualifiers, tparams: string[], x: Ctx, i: i32, own acc: Mark[]): Mark[] {
  let t: lspquery.Tok = x.toks[i];
  if (qualifies(x, i)) {
    let name: string = flatten.qualified_name(q, t.text, x.toks[i + 2].text);
    return marked(x, i + 2, global_kind(s, name), marked(x, i, T_NAMESPACE, acc));
  }
  if (!t.ident) {
    return acc;
  }
  let kind: i32 = 0 - 1;
  if (q.own.len() > 0) {
    kind = type_kind(s, q.own + "__" + t.text);
  }
  if (kind < 0) {
    kind = type_kind(s, t.text);
  }
  if (kind < 0 && util.has_str(tparams, "0_" + t.text)) {
    kind = T_TYPE;
  }
  return marked(x, i, kind, acc);
}

function type_params(mod: parser.Module): string[] {
  let out: string[] = [];
  for fd in mod.funcs {
    out = util.append_all(out, fd.type_params);
  }
  for sd in mod.structs {
    out = util.append_all(out, sd.type_params);
  }
  for ed in mod.enums {
    out = util.append_all(out, ed.type_params);
  }
  return out;
}
