import "./ssacapacityword" as capacityword;
import "./ssaarraystate" as machine;
import "./ssacondition" as condition;
import "./ssacapacityisa" as isa;
import "./ssacapacityvalue" as value;

struct State { regs: machine.Word[], cells: machine.Half[], flags: condition.Comparison, ok: boolean }

function initial(r: value.Interval): State {
  let regs: machine.Word[] = [];
  let cells: machine.Half[] = [];
  let i = 0;
  while (i < 16) {
    regs = regs.append(if (i == 4) { machine.identity(3, 0) } else { machine.identity(2, i) });
    i += 1;
  }
  for i in 0..6 {
    cells = cells.append(machine.token(5, i, 0));
  }
  let argument = capacityword.numeric(r, value.original(r));
  cells = cells.append(machine.token(4, 0, 0)).append(machine.token(4, 0, 1)).append(argument.low).append(argument.high);
  return State { regs: regs, cells: cells, flags: condition.unknown_order(), ok: true };
}

function write(s: State, reg: i32, w: machine.Word): State {
  return State { ...s, regs: s.regs.with(reg, w), ok: s.ok && w.low.kind != 0 && w.high.kind != 0 };
}

function narrowed(r: value.Interval, w: machine.Word, width: i32): machine.Word {
  return if (width == 32) { machine.Word { low: w.low, high: capacityword.zero(r) } } else { w };
}

function stack(w: machine.Word): boolean {
  return w.low.kind == 3 && machine.same_word(w, machine.identity(3, w.low.identity));
}

function address(s: State, base: i32, offset: i32, width: i32): i32 {
  let w = s.regs[base];
  if (!stack(w) || width != 32 && width != 64) {
    return -1;
  }
  let at = w.low.identity as i64 + offset as i64;
  if (at < -(24 as i64) || at + (width / 8) as i64 > 16 as i64 || at % (4 as i64) != 0) {
    return -1;
  }
  return (at as i32 + 24) / 4;
}

function read(s: State, r: value.Interval, at: i32, width: i32): machine.Word {
  if (at < 0) {
    return machine.identity(0, 0);
  }
  return machine.Word { low: s.cells[at], high: if (width == 64) { s.cells[at + 1] } else { capacityword.zero(r) } };
}

function store(s: State, at: i32, width: i32, w: machine.Word): State {
  if (at < 0 || at <= 7 && at + width / 32 > 6) {
    return State { ...s, ok: false };
  }
  let cells = s.cells.with(at, w.low);
  if (width == 64) {
    cells = cells.with(at + 1, w.high);
  }
  return State { ...s, cells: cells };
}

function stack_step(s: State, r: value.Interval, op: isa.Op): State {
  if (!stack(s.regs[4])) {
    return State { ...s, ok: false };
  }
  let sp = s.regs[4].low.identity;
  if (op.kind == 6) {
    let saved = s.regs[op.source];
    let at = address(s, 4, -8, 64);
    let pushed = store(s, at, 64, saved);
    return write(pushed, 4, machine.identity(3, sp - 8));
  }
  if (op.destination == 4) {
    return State { ...s, ok: false };
  }
  let loaded = read(s, r, address(s, 4, 0, 64), 64);
  return write(write(s, 4, machine.identity(3, sp + 8)), op.destination, loaded);
}

function movement(s: State, r: value.Interval, op: isa.Op): State {
  if (op.kind == 2) {
    return write(s, op.destination, narrowed(r, s.regs[op.source], op.width));
  }
  if (op.kind == 3) {
    return write(s, op.destination, read(s, r, address(s, op.base, op.offset, op.width), op.width));
  }
  if (op.kind == 4) {
    return store(s, address(s, op.base, op.offset, op.width), op.width, s.regs[op.source]);
  }
  if (op.kind == 5) {
    let w = capacityword.numeric(r, value.number(r, op.immediate as i64));
    return write(s, op.destination, narrowed(r, w, op.width));
  }
  return stack_step(s, r, op);
}

function arithmetic_source(s: State, r: value.Interval, op: isa.Op): value.Value {
  return if (op.source < 0) { value.number(r, op.immediate as i64) } else { capacityword.number(r, s.regs[op.source], op.width) };
}

function add_sub(r: value.Interval, a: value.Value, b: value.Value, subtract: boolean, width: i32): value.Value {
  if (!value.valid(r, b) || b.factor != 0) {
    return value.unknown();
  }
  let v = value.add(r, a, if (subtract) { -b.offset } else { b.offset });
  return if (width == 64 || capacityword.nonnegative(r, v)) { v } else { value.unknown() };
}

function shift(r: value.Interval, v: value.Value, count: value.Value, left: boolean): value.Value {
  if (!capacityword.nonnegative(r, v) || v.factor != 0 || !value.valid(r, count) || count.factor != 0) {
    return value.unknown();
  }
  let n = v.offset;
  let i = 0 as i64;
  while (i < count.offset) {
    n = if (left) { n * (2 as i64) } else { n / (2 as i64) };
    if (n > 4294967295 as i64) {
      return value.unknown();
    }
    i = i + 1 as i64;
  }
  return value.number(r, n);
}

function shifted(s: State, r: value.Interval, op: isa.Op): State {
  let count = capacityword.number(r, s.regs[1], 32);
  if (!value.valid(r, count) || count.factor != 0) {
    return State { ...s, ok: false };
  }
  let masked = value.number(r, count.offset % (op.width as i64));
  let flags = if (masked.offset == 0) { s.flags } else { condition.unknown_order() };
  let v = capacityword.number(r, s.regs[op.destination], op.width);
  let result = if (masked.offset == 0) { narrowed(r, s.regs[op.destination], op.width) } else { capacityword.numeric(r, shift(r, v, masked, op.kind == 13)) };
  return write(State { ...s, flags: flags }, op.destination, result);
}

function calculated(s: State, r: value.Interval, op: isa.Op): value.Value {
  let a = capacityword.number(r, s.regs[op.destination], op.width);
  if (op.kind == 12) {
    return value.negate(r, a);
  }
  let b = arithmetic_source(s, r, op);
  if (op.kind == 11) {
    return if (op.width == 64) { value.mask(r, a, b) } else { value.unknown() };
  }
  return add_sub(r, a, b, op.kind == 9, op.width);
}

function arithmetic(s: State, r: value.Interval, op: isa.Op): State {
  if (op.kind == 13 || op.kind == 14) {
    return shifted(s, r, op);
  }
  let v = value.unknown();
  if (op.kind == 8) {
    let bit = value.bit_scan(r, capacityword.number(r, s.regs[op.source], op.width));
    if (bit >= 0) {
      v = value.number(r, bit as i64);
    }
  } else {
    v = calculated(s, r, op);
  }
  let w = narrowed(r, capacityword.numeric(r, v), op.width);
  return write(State { ...s, flags: condition.unknown_order() }, op.destination, w);
}

function lea(s: State, r: value.Interval, op: isa.Op): State {
  let base = capacityword.number(r, s.regs[op.base], 64);
  let index = if (op.index < 0) { value.number(r, 0 as i64) } else { capacityword.number(r, s.regs[op.index], 64) };
  if (!value.valid(r, index) || index.factor != 0) {
    return State { ...s, ok: false };
  }
  let result = value.add(r, base, index.offset * (op.scale as i64) + op.offset as i64);
  return write(s, op.destination, capacityword.numeric(r, result));
}

function comparison(s: State, r: value.Interval, op: isa.Op): State {
  let v = capacityword.number(r, s.regs[op.source], op.width);
  if (!capacityword.nonnegative(r, v) || op.immediate < 0) {
    return State { ...s, flags: condition.unknown_order() };
  }
  return State { ...s, flags: value.compare(r, v, op.immediate as i64) };
}

function step(s: State, r: value.Interval, op: isa.Op): State {
  if (op.kind == 1) {
    return s;
  }
  if (op.kind >= 2 && op.kind <= 7) {
    return movement(s, r, op);
  }
  if (op.kind >= 8 && op.kind <= 14) {
    return arithmetic(s, r, op);
  }
  if (op.kind == 15) {
    return lea(s, r, op);
  }
  if (op.kind == 16) {
    return comparison(s, r, op);
  }
  return State { ...s, ok: false };
}

function finished(s: State, r: value.Interval): boolean {
  for i in 0..16 {
    let expected = if (i == 4) { machine.identity(3, 0) } else { machine.identity(2, i) };
    if (!machine.same_word(s.regs[i], expected)) {
      return false;
    }
  }
  for reg in [2, 1, 0] {
    let at = (2 - reg) * 2;
    if (!machine.same_word(read(s, r, at, 64), machine.identity(2, reg))) {
      return false;
    }
  }
  return machine.same_word(read(s, r, 6, 64), machine.identity(4, 0)) && machine.same_word(read(s, r, 8, 64), capacityword.numeric(r, value.expected(r)));
}

function path(p: isa.Program, r: value.Interval): boolean {
  let s = initial(r);
  let visited: boolean[] = [];
  for op in p.ops {
    visited = visited.append(false);
  }
  let pc = 0;
  while (pc >= 0 && pc < p.ops.len()) {
    if (visited[pc]) {
      return false;
    }
    visited = visited.with(pc, true);
    let op = p.ops[pc];
    if (op.kind == 18) {
      return finished(s, r);
    }
    if (op.kind == 17) {
      let taken = condition.unsigned_branch(s.flags, op.condition);
      if (taken < 0) {
        return false;
      }
      pc = if (taken == 1) { op.target } else { pc + 1 };
    } else {
      s = step(s, r, op);
      if (!s.ok) {
        return false;
      }
      pc += 1;
    }
  }
  return false;
}

pub function check(output: string): boolean {
  let p = isa.program(output);
  if (p.error != "") {
    return false;
  }
  for r in value.intervals() {
    if (!path(p, r)) {
      return false;
    }
  }
  return true;
}
