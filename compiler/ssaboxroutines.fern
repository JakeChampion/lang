import "./ssadecrementtext" as text;
import "./ssaarrayboxmachine" as box;
import "./ssasmallarraymachine" as arrays;

// The two routines of a box with a header of one word are short and have no
// loop. Each check below takes the routine only when its lines are exactly
// the lines that this file names, and when the machine of the array routine
// that it calls takes that routine.

// __fern_rec_box, with the number of words n of the box in %rdi. For n of
// two or more it asks __fern_arr_box for a capacity of n - 2. That gives a
// block of n + 1 words and the address of its third word. The routine
// returns the address of the second word, and writes a count of 1 and n in
// the two halves of the first word. So the box has n words. %rdi holds n
// again at the return.
pub function allocation(output: string): boolean {
  let lines = ["cmpq $2, %rdi", "jb .Lrecbox_unit", "pushq %rdi", "subq $2, %rdi", "call __fern_arr_box", "popq %rdi", "subq $8, %rax", "movl $1, -8(%rax)", "movl %edi, -4(%rax)", "ret", ".Lrecbox_unit:", "subq $1, %rdi", "call __fern_arr_box", "ret"];
  return exact(output, "__fern_rec_box", lines) && box.check(output);
}

// __fn___fern_box_dec, with the box in %rax at its .r and .u entries. A
// block with zero in the high half of its header is an array, and a box with
// a count other than 1 only changes its count: the array release takes both.
// For a unique box of n words the routine writes the capacity n - 2 in the
// header word and a count of 1 in the first word of the box. Those two words
// are then the header of an array whose block is the block of the box. The
// array release takes that array.
pub function release(output: string): boolean {
  let unique = ["cmpl $0, -4(%rax)", "je __fn___fern_arr_dec.u", "cmpl $1, -8(%rax)", "jne __fn___fern_arr_dec.u", "movl -4(%rax), %ecx", "subq $2, %rcx", "movq %rcx, -8(%rax)", "movq $1, (%rax)", "addq $8, %rax", "jmp __fn___fern_arr_dec.u", ".Lboxdec_ret:", "ret"];
  if (!exact(output, "__fn___fern_box_dec", ["movq 8(%rsp), %rax"]) || !exact(output, "__fn___fern_box_dec.r", ["cmpq $0x10000, %rax", "jb .Lboxdec_ret"])) {
    return false;
  }
  return exact(output, "__fn___fern_box_dec.u", unique) && arrays.check_native_record(output);
}

function exact(output: string, entry: string, lines: string[]): boolean {
  let body = text.box_routine(output, entry);
  if (body.error != "" || body.lines.len() != lines.len()) {
    return false;
  }
  for i in 0..lines.len() {
    if (body.lines[i] != lines[i]) {
      return false;
    }
  }
  return true;
}
