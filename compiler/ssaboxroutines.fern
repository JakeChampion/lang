import "./ssadecrementtext" as text;
import "./ssaarrayboxmachine" as box;
import "./ssasmallarraymachine" as arrays;

// The two routines of a box with a header of one word are short and have no
// loop. Each check below takes the routine only when its lines are exactly
// the lines that this file names, and when the machine of the array routine
// that it calls takes that routine.

// __fern_rec_box, with the number of words n of the box in %rdi. A box of
// 1 to 255 words has a block of n + 1 words. The routine takes the head of
// the free list of that block size, at __fern_freelist + 8 * (n + 1), or
// moves the bump pointer by the block when the list is empty. A bump that
// crosses a 64 KiB line or the end of the heap, and a heap that is not
// mapped, ask __fern_alloc for 8 * (n + 1) bytes. The routine writes a count
// of 1 and n in the two halves of the first word of the block, and returns
// the address of the second word. %rcx and %rdi go back to their values.
//
// Each other box asks __fern_arr_box for a capacity of n - 2. That gives a
// block of n + 1 words and the address of its third word. The routine
// returns the address of the second word, and writes the same header. A box
// of more than 65,535 words does not fit the 16 bits of a tag, so it keeps
// the block and the header of an array. The caller then stores the tag of a
// shape over n. The low 16 bits of that tag are n.
pub function allocation(output: string): boolean {
  let lines = ["leaq -1(%rdi), %rax", "cmpq $254, %rax", "ja .Lrecbox_far", "pushq %rcx", "leaq __fern_freelist+8(%rip), %rcx", "leaq (%rcx,%rdi,8), %rcx", "movq (%rcx), %rax", "testq %rax, %rax", "jz .Lrecbox_bump", "pushq (%rax)", "popq (%rcx)", ".Lrecbox_hdr:", "popq %rcx", "movl $1, (%rax)", "movl %edi, 4(%rax)", "addq $8, %rax", "ret", ".Lrecbox_bump:", "movq __fern_heap_ptr(%rip), %rax", "leaq 8(%rax,%rdi,8), %rcx", "cmpq __fern_heap_end(%rip), %rcx", "ja .Lrecbox_slow", "cmpw %ax, %cx", "jb .Lrecbox_slow", "movq %rcx, __fern_heap_ptr(%rip)", "jmp .Lrecbox_hdr", ".Lrecbox_slow:", "popq %rcx", "pushq %rdi", "leaq 8(,%rdi,8), %rdi", "call __fern_alloc", "popq %rdi", "movl $1, (%rax)", "movl %edi, 4(%rax)", "addq $8, %rax", "ret", ".Lrecbox_far:", "cmpq $65535, %rdi", "ja .Lrecbox_wide", "pushq %rdi", "subq $2, %rdi", "jae .Lrecbox_sized", "xorl %edi, %edi", ".Lrecbox_sized:", "call __fern_arr_box", "popq %rdi", "subq $8, %rax", "movl $1, -8(%rax)", "movl %edi, -4(%rax)", "ret", ".Lrecbox_wide:", "subq $1, %rdi", "jmp __fern_arr_box"];
  return exact(output, "__fern_rec_box", lines) && box.check(output);
}

// __fn___fern_box_dec, with the box in %rax at its .r and .u entries. The
// low 16 bits of the high half of the header are the number of words n of a
// box, and zero for an array. An array, and a box with a count other than 1,
// go to the array release unchanged. A unique box of 1 to 255 words goes on
// the free list of a block of n + 1 words: the routine writes the old head
// of that list in the header word, and the address of the header word in
// the head. For each other unique box the routine writes the capacity of its
// block in the header word: n - 2, or 0 for a box of one word. It writes a
// count of 1 in the first word of the box. Those two words are then the
// header of an array whose block is the block of the box. The array release
// takes that array.
pub function release(output: string): boolean {
  let unique = ["movzwl -4(%rax), %ecx", "testl %ecx, %ecx", "jz __fn___fern_arr_dec.u", "cmpl $1, -8(%rax)", "jne __fn___fern_arr_dec.u", "leaq -1(%rcx), %rdx", "cmpq $254, %rdx", "ja .Lboxdec_far", "leaq -8(%rax), %rdx", "leaq __fern_freelist+8(%rip), %r8", "movq (%r8,%rcx,8), %rdi", "movq %rdi, (%rdx)", "movq %rdx, (%r8,%rcx,8)", "ret", ".Lboxdec_far:", "subq $2, %rcx", "jae .Lboxdec_cap", "xorl %ecx, %ecx", ".Lboxdec_cap:", "movq %rcx, -8(%rax)", "movq $1, (%rax)", "addq $8, %rax", "jmp __fn___fern_arr_dec.u", ".Lboxdec_ret:", "ret"];
  if (!exact(output, "__fn___fern_box_dec", ["movq 8(%rsp), %rax"]) || !exact(output, "__fn___fern_box_dec.r", ["cmpq $0x10000, %rax", "jb .Lboxdec_ret"])) {
    return false;
  }
  return exact(output, "__fn___fern_box_dec.u", unique) && arrays.check_native_record(output);
}

function exact(output: string, entry: string, lines: string[]): boolean {
  let body = text.box_routine(output, entry);
  if (body.error != "" || body.lines.len() != lines.len()) {
    return false;
  }
  for i in 0..lines.len() {
    if (body.lines[i] != lines[i]) {
      return false;
    }
  }
  return true;
}
