// compiler/lexer.fern — a port of internal/syntax/lexer/lexer.go
// into Fern itself, exercising the language features that landed
// in the bug-hunt + feature-gap session:
//
//   - union types (Token = … | … | …)
//   - generic struct methods (collected here as i32 helpers; the
//     full Go lexer threads positions through a `*lexer` struct)
//   - mutual recursion isn't needed; everything's a forward loop
//   - pattern matching with literal patterns drives the dispatch
//     between Number / Ident / Keyword / Punct / String / Error
//
// Parity with internal/syntax/lexer/lexer.go now covers: hex integer
// literals (`0x2A`, `0x10u8`), scientific-notation floats
// (`1e3`, `1.5e-2`), the afterDot guard for chained tuple
// access (`t.1.0`), closed-list numeric-suffix validation, and a
// first-class TokError variant for the failure paths (bad
// suffix, unterminated / bad-escape / newline-in string, bare
// `0x`, unexpected character) instead of the old EOF-as-error
// sentinel.
//
// f-strings (`f"..."`) now lex here too: a single TokFString
// whose `parts` hold the alternating literal / interpolant
// pieces (`{{` / `}}` escape literal braces; standard escapes
// apply in the literal portions; `{...}` interpolants pass
// through verbatim, with inner string literals skipped during
// the brace-matching scan). The PARSER side now sub-parses each
// interpolant Expr text and desugars the f-string to a `+`-chain
// of literal parts and `(<expr>).to_string()` calls (see the
// `lexer.TokFString` arm in parser.fern's parse_primary), so an
// f-string lowers end-to-end through both self-host backends.
//
// Goal: validate that the language can express the lexer's logic
// end-to-end without resorting to Go-side workarounds. The Go
// build still owns the production code path; this file is run
// from a Go test that compiles + executes it.

pub struct TokEof { line: i32, col: i32 }

// `raw` is the source spelling of a quoted literal — `'x'` / `b'x'`,
// which reach the parser AS number tokens: the decoded value is stored in
// `text` as a decimal numeral and the type is stored in `suffix` ("char" /
// "u8"), so every consumer of a suffixed integer literal handles them
// unchanged. Empty for an ordinary number, where `text` already is the
// spelling. The printer re-emits `raw` so an author's escape survives
// `-fmt`, matching native's ast.CharLit.Raw.
pub struct TokNumber { text: string, suffix: string, raw: string, is_float: boolean, line: i32, col: i32 }

pub struct TokIdent { name: string, line: i32, col: i32 }

pub struct TokKeyword { name: string, line: i32, col: i32 }

pub struct TokPunct { text: string, line: i32, col: i32 }

pub struct TokString { value: string, line: i32, col: i32 }

// TokError surfaces a lex failure (bad numeric suffix, unterminated
// string, bare `0x`, unexpected character, …) as a first-class
// token rather than being reported as EOF. The Go lexer returns a
// `*lexer.Error` through a side channel; here the error is carried in
// the token stream, `tokenize` stops at the first one, and the parser
// turns a stream ending in one into that error alone. `code` is the
// diagnostic code: P002 for a numeric literal, P001 for the rest.
pub struct TokError { msg: string, code: string, line: i32, col: i32 }

// FStringPart is one piece of an f-string. Exactly one of the two
// payload fields is meaningful, selected by `is_expr`: a literal
// segment (escapes already processed) when false, or the raw
// interpolant expression text (the parser sub-parses it) when
// true. `line` / `col` locate `expr`'s first byte in the enclosing
// source so the parser can rebase the sub-parse onto it; they are 0
// on a literal part. Mirrors `lexer.FStringPart` in the Go lexer.
pub struct FStringPart { lit: string, expr: string, is_expr: boolean, line: i32, col: i32 }

pub struct TokFString { parts: FStringPart[], line: i32, col: i32 }

pub type Token = TokEof | TokNumber | TokIdent | TokKeyword | TokPunct | TokString | TokError | TokFString;

// is_digit / is_alpha / is_alnum — byte-level classifiers,
// matching the Go lexer's `unicode.IsDigit` / `IsLetter` on the
// ASCII subset (multibyte UTF-8 source isn't supported here).
function is_digit(b: i32): boolean {
  return b >= 48 && b <= 57;
}

function is_alpha(b: i32): boolean {
  return b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 95;
}

pub function is_alnum(b: i32): boolean {
  return is_digit(b) || is_alpha(b);
}

function is_hex_digit(b: i32): boolean {
  return b >= 48 && b <= 57 || b >= 97 && b <= 102 || b >= 65 && b <= 70;
}

// hex_val returns the numeric value of a hex-digit byte (0 otherwise).
function hex_val(b: i32): i32 {
  if (b >= 48 && b <= 57) {
    return b - 48;
  }
  if (b >= 97 && b <= 102) {
    return b - 97 + 10;
  }
  if (b >= 65 && b <= 70) {
    return b - 65 + 10;
  }
  return 0;
}

// Whitespace bytes skipped between tokens. Native uses unicode.IsSpace
// (internal/syntax/lexer/lexer.go); at the byte level that includes the ASCII
// set space/tab/LF/CR plus vertical-tab (0x0B) and form-feed (0x0C).
// Without \v/\f a form feed lexed to TokError and tokenize STOPPED,
// silently truncating the program (bogus E052 "missing return") (#4339).
function is_space(b: i32): boolean {
  return b == 32 || b >= 9 && b <= 13;
}

function is_suffix_start(b: i32): boolean {  // 'i' 'u' 'f'
  return b == 105 || b == 117 || b == 102;
}

// Keyword set — mirrors `internal/syntax/lexer/lexer.go`'s `keywords` map.
// Inlined as a string-comparison chain instead of a Map[string, bool]
// so the lexer stays a single file with no init-order dependency.
// Every identifier is asked, so the keywords are split by their first byte
// and a name is compared only with the ones it could be.
// fern-lint: allow cyclomatic-complexity
// The keyword table itself: one guard per first byte, and a comparison per keyword.
function is_keyword(name: string): boolean {
  if (name.len() < 2 || name.len() > 8) {
    return false;
  }
  let c: u8 = name[0];
  if (c == b'f') {
    return name == "function" || name == "for" || name == "false" || name == "f32" || name == "f64";
  }
  if (c == b'i') {
    return name == "if" || name == "i32" || name == "i64" || name == "import" || name == "impl";
  }
  if (c == b'u') {
    return name == "use" || name == "u8" || name == "u32" || name == "u64" || name == "usize";
  }
  if (c == b'e') {
    return name == "else" || name == "enum" || name == "errdefer";
  }
  if (c == b'd') {
    return name == "defer" || name == "dyn";
  }
  if (c == b't') {
    return name == "true" || name == "type" || name == "trait";
  }
  if (c == b'b') {
    return name == "break" || name == "boolean";
  }
  if (c == b'c') {
    return name == "continue" || name == "const";
  }
  if (c == b'l') {
    return name == "let" || name == "loop";
  }
  if (c == b's') {
    return name == "string" || name == "struct";
  }
  if (c == b'w') {
    return name == "while" || name == "when";
  }
  if (c == b'r') {
    return name == "return";
  }
  if (c == b'v') {
    return name == "void";
  }
  if (c == b'a') {
    return name == "as";
  }
  if (c == b'p') {
    return name == "pub";
  }
  if (c == b'm') {
    return name == "match";
  }
  return false;
}

// keywords is every name is_keyword accepts, in byte order.
pub function keywords(): string[] {
  return ["as", "boolean", "break", "const", "continue", "defer", "dyn", "else", "enum", "errdefer", "f32", "f64", "false", "for", "function", "i32", "i64", "if", "impl", "import", "let", "loop", "match", "pub", "return", "string", "struct", "trait", "true", "type", "u32", "u64", "u8", "use", "usize", "void", "when", "while"];
}

function is_valid_numeric_suffix(s: string): boolean {
  return s == "i32" || s == "i64"
    || s == "u8" || s == "u32" || s == "u64"
    || s == "f32" || s == "f64";
}

// Multi-char punctuator longest-prefix match. The Go lexer
// iterates a sorted-by-length string list; here we hand-code the
// length-3 cases first, then length-2, then fall through. Returns
// the matched literal text, or "" if none matched.
//
// `..` (the half-open range operator, `for i in LO..HI`) is in the
// length-2 set; the length-3 `...` spread and `..=` (inclusive range,
// `for i in LO..=HI`) are checked first so `...` / `..=` never mis-lex
// as `..` + `.` / `..` + `=`. A float needs a digit right after
// `.` (scan_number's guard), and `.field` / `.0` stay single-dot, so
// `..` never clashes with field access or fractions.
function match_multipunct(src: string, i: i32, n: i32): string {
  if (i >= n) {
    return "";
  }
  let b0: i32 = src[i] as i32;
  let b1: i32 = 0 - 1;
  if (i + 1 < n) {
    b1 = src[i + 1] as i32;
  }
  let b2: i32 = 0 - 1;
  if (i + 2 < n) {
    b2 = src[i + 2] as i32;
  }
  let three: string = punct3(b0, b1, b2);
  if (three.len() > 0) {
    return three;
  }
  if (b1 == 61) {
    return punct_assign(b0);
  }
  if (b1 == 124) {
    return punct_bar(b0);
  }
  if (b1 == 63) {
    return punct_try(b0);
  }
  if (b1 == 62) {
    return punct_arrow(b0);
  }
  return punct_double(b0, b1);
}

// Each punctuator is a literal, so a token carries no copy of the source.
function punct3(b0: i32, b1: i32, b2: i32): string {
  if (b0 == 60 && b1 == 60) {
    if (b2 == 61) {
      return "<<=";
    }
    if (b2 == 124) {
      return "<<|";
    }
    if (b2 == 63) {
      return "<<?";
    }
  } else if (b0 == 62 && b1 == 62) {
    if (b2 == 61) {
      return ">>=";
    }
    if (b2 == 63) {
      return ">>?";
    }
  } else if (b0 == 46 && b1 == 46) {
    if (b2 == 46) {
      return "...";
    }
    if (b2 == 61) {
      return "..=";
    }
  }
  return "";
}

function punct_assign(b0: i32): string {
  if (b0 == 61) {
    return "==";
  }
  if (b0 == 33) {
    return "!=";
  }
  if (b0 == 60) {
    return "<=";
  }
  if (b0 == 62) {
    return ">=";
  }
  if (b0 == 43) {
    return "+=";
  }
  if (b0 == 45) {
    return "-=";
  }
  if (b0 == 42) {
    return "*=";
  }
  if (b0 == 47) {
    return "/=";
  }
  if (b0 == 37) {
    return "%=";
  }
  if (b0 == 38) {
    return "&=";
  }
  if (b0 == 124) {
    return "|=";
  }
  if (b0 == 94) {
    return "^=";
  }
  return "";
}

function punct_bar(b0: i32): string {
  if (b0 == 43) {
    return "+|";
  }
  if (b0 == 45) {
    return "-|";
  }
  if (b0 == 42) {
    return "*|";
  }
  if (b0 == 124) {
    return "||";
  }
  return "";
}

function punct_try(b0: i32): string {
  if (b0 == 43) {
    return "+?";
  }
  if (b0 == 45) {
    return "-?";
  }
  if (b0 == 42) {
    return "*?";
  }
  if (b0 == 47) {
    return "/?";
  }
  if (b0 == 37) {
    return "%?";
  }
  return "";
}

function punct_arrow(b0: i32): string {
  if (b0 == 61) {
    return "=>";
  }
  if (b0 == 124) {
    return "|>";
  }
  if (b0 == 62) {
    return ">>";
  }
  return "";
}

function punct_double(b0: i32, b1: i32): string {
  if (b0 != b1) {
    return "";
  }
  if (b0 == 60) {
    return "<<";
  }
  if (b0 == 46) {
    return "..";
  }
  if (b0 == 58) {
    return "::";
  }
  if (b0 == 38) {
    return "&&";
  }
  return "";
}

// single_punct is the Go lexer's bare-punctuation set, each a literal:
// `+`, `-`, `*`, `/`, `%`, parens / braces / brackets, `,`, `;`,
// `:`, `=`, `<`, `>`, `!`, `&`, `|`, `^`, `?`, `.`, `@`; "" for any
// other byte.
function single_punct(b: i32): string {
  let op: string = single_punct_op(b);
  if (op.len() > 0) {
    return op;
  }
  if (b == 40) {
    return "(";
  }
  if (b == 41) {
    return ")";
  }
  if (b == 123) {
    return "{";
  }
  if (b == 125) {
    return "}";
  }
  if (b == 91) {
    return "[";
  }
  if (b == 93) {
    return "]";
  }
  if (b == 44) {
    return ",";
  }
  if (b == 59) {
    return ";";
  }
  if (b == 58) {
    return ":";
  }
  if (b == 46) {
    return ".";
  }
  if (b == 64) {
    return "@";
  }
  return "";
}

function single_punct_op(b: i32): string {
  if (b == 43) {
    return "+";
  }
  if (b == 45) {
    return "-";
  }
  if (b == 42) {
    return "*";
  }
  if (b == 47) {
    return "/";
  }
  if (b == 37) {
    return "%";
  }
  if (b == 61) {
    return "=";
  }
  if (b == 60) {
    return "<";
  }
  if (b == 62) {
    return ">";
  }
  if (b == 33) {
    return "!";
  }
  if (b == 38) {
    return "&";
  }
  if (b == 124) {
    return "|";
  }
  if (b == 94) {
    return "^";
  }
  if (b == 63) {
    return "?";
  }
  return "";
}

// Lexer state, passed as a struct through the helpers below.
// `i` is the byte cursor; `line` / `col` track position for
// diagnostics. The Go lexer carries the same trio on a *lexer
// receiver — porting it as a struct lets the same shape work
// without generic methods on the lexer state.
// `trailing` is set when code precedes the comment on its line.
pub struct Comment { line: i32, col: i32, text: string, trailing: boolean }

// Takes the body as a `string` parameter so the slice is copied at the call —
// a `str` coerces into a string param but not into a struct field, and the
// Comment outlives the scan.
// code_before: does anything but whitespace precede src[i] on its line?
function code_before(src: string, i: i32): boolean {
  let j: i32 = i - 1;
  while (j >= 0 && src[j] != b'\n') {
    if (src[j] != b' ' && src[j] != b'\t' && src[j] != b'\r' && src[j] != 11u8 && src[j] != 12u8) {
      return true;
    }
    j = j - 1;
  }
  return false;
}

function comment_tok(line: i32, col: i32, text: string, trailing: boolean): Comment {
  return Comment { line: line, col: col, text: text, trailing: trailing };
}

// Comments are returned alongside the tokens rather than becoming a token kind, so the
// parser stays grammar-only — same split as the Go lexer's Tokenize.
pub struct LexResult { tokens: Token[], comments: Comment[] }

// The cursor, and the `//` comments seen so far when the caller keeps them.
// It is threaded through the scan as an owned value, so each step writes its
// one box in place rather than boxing a fresh cursor per token.
struct Lex { src: string, i: i32, n: i32, line: i32, col: i32, comments: Comment[] }

function (l: Lex) at_end(): boolean {
  return l.i >= l.n;
}

function (l: Lex) peek_byte(): i32 {
  if (l.i >= l.n) {
    return 0;
  }
  return l.src[l.i] as i32;
}

// advance consumes one byte, updates line/col. Returns the new
// Lex value — the language is value-semantics-by-default so the
// caller threads the updated state back through.
function (own l: Lex) advance(): Lex {
  if (l.i >= l.n) {
    return l;
  }
  if (l.src[l.i] == b'\n') {
    return Lex { ...l, i: l.i + 1, line: l.line + 1, col: 1 };
  }
  return Lex { ...l, i: l.i + 1, col: l.col + 1 };
}

// advance_in_line consumes a run [l.i, end) that holds no newline, in one Lex:
// the column moves by the run's length.
function (own l: Lex) advance_in_line(end: i32): Lex {
  if (end <= l.i) {
    return l;
  }
  return Lex { ...l, i: end, col: l.col + (end - l.i) };
}

// skip consumes k bytes of a run that holds no newline.
function (own l: Lex) skip(k: i32): Lex {
  return Lex { ...l, i: l.i + k, col: l.col + k };
}

// skip_trivia drops whitespace and, when `keep` is set, collects `//` line
// comments onto the cursor. Mirrors the Go lexer's `skipTrivia`, except that
// the Go lexer always accumulates: there, comments cost an append into a GC'd
// slice, whereas here each one copies its text into an owned string, and the
// compile path has no consumer for them.
function skip_trivia(own l: Lex, keep: boolean): Lex {
  let i: i32 = l.i;
  let line: i32 = l.line;
  let col: i32 = l.col;
  while (i < l.n) {
    let b: i32 = l.src[i] as i32;
    // Ahead of is_space, which covers the newline too.
    if (b == 10) {
      line = line + 1;
      col = 1;
      i = i + 1;
    } else if (is_space(b)) {
      col = col + 1;
      i = i + 1;
    } else if (b == 47 && i + 1 < l.n && l.src[i + 1] == b'/') {
      // `//` line comment — consume to the newline, which the newline arm
      // takes next.
      let ce: i32 = __memchr(l.src, 10, i + 2);
      if (ce < 0) {
        ce = l.n;
      }
      if (keep) {
        l = Lex { ...l, comments: l.comments.append(comment_tok(line, col, slice_unchecked(l.src, i + 2, ce), code_before(l.src, i))) };
      }
      col = col + (ce - i);
      i = ce;
    } else {
      break;
    }
  }
  if (i == l.i) {
    return l;
  }
  return Lex { ...l, i: i, line: line, col: col };
}

// scan_number reads the digit run + optional fractional digits +
// optional typed suffix. The Go lexer returns Token{Kind: Number
// or Float, Text: ..., Suffix: ...}; we mirror with TokNumber
// carrying `is_float`. Returns (Lex post-scan, Token).
struct NumResult { lex: Lex, tok: Token }

// Helper wrap functions — the implicit struct → union wrap
// fires reliably in return position, so each tok-* helper
// upgrades a concrete struct into a Token. Callers just write
// `eof_tok(line, col)` instead of declaring an intermediate
// `let t: Token = TokEof { … };`. Mirrors the Rust `From` impls
// you'd write on top of a sum type.
pub function eof_tok(line: i32, col: i32): Token {
  return TokEof { line: line, col: col };
}

pub function string_tok(value: string, line: i32, col: i32): Token {
  return TokString { value: value, line: line, col: col };
}

pub function ident_tok(name: string, line: i32, col: i32): Token {
  // `ByteStream` is the builtin byte stream's new name; it reads as `Stream`
  // until the stage0 pin knows it and the stdlib moves over (#12708).
  if (name == "ByteStream") {
    return TokIdent { name: "Stream", line: line, col: col };
  }
  return TokIdent { name: name, line: line, col: col };
}

pub function keyword_tok(name: string, line: i32, col: i32): Token {
  return TokKeyword { name: name, line: line, col: col };
}

pub function punct_tok(text: string, line: i32, col: i32): Token {
  return TokPunct { text: text, line: line, col: col };
}

pub function number_tok(text: string, suffix: string, is_float: boolean, line: i32, col: i32): Token {
  return TokNumber { text: text, suffix: suffix, raw: "", is_float: is_float, line: line, col: col };
}

pub function quoted_tok(text: string, suffix: string, raw: string, line: i32, col: i32): Token {
  return TokNumber { text: text, suffix: suffix, raw: raw, is_float: false, line: line, col: col };
}

pub function error_tok(msg: string, line: i32, col: i32): Token {
  return TokError { msg: msg, code: "P001", line: line, col: col };
}

function num_error_tok(msg: string, line: i32, col: i32): Token {
  return TokError { msg: msg, code: "P002", line: line, col: col };
}

pub function fstring_tok(parts: FStringPart[], line: i32, col: i32): Token {
  return TokFString { parts: parts, line: line, col: col };
}

// offset_line / offset_col map a position inside a re-lexed fragment
// onto the enclosing source, given where the fragment starts. Only the
// fragment's first line shares a line with the base, so only there does
// the column shift. Mirrors the Go parser's offsetPos.
function offset_line(base_line: i32, line: i32): i32 {
  if (line <= 1) {
    return base_line;
  }
  return base_line + line - 1;
}

function offset_col(base_col: i32, line: i32, col: i32): i32 {
  if (line <= 1) {
    return base_col + col - 1;
  }
  return col;
}

// rebase_parts renumbers an f-string's interpolant positions, which
// are relative to the fragment the parts were lexed from.
function rebase_parts(parts: FStringPart[], base_line: i32, base_col: i32): FStringPart[] {
  let out: FStringPart[] = [];
  let i: i32 = 0;
  while (i < parts.len()) {
    let p: FStringPart = parts[i];
    if (p.is_expr) {
      out = out.append(FStringPart {
        lit: p.lit, expr: p.expr, is_expr: true,
        line: offset_line(base_line, p.line), col: offset_col(base_col, p.line, p.col),
      });
    } else {
      out = out.append(p);
    }
    i = i + 1;
  }
  return out;
}

// rebase_tokens renumbers a token stream lexed from a fragment of a
// larger source so its positions name the enclosing file. The parser
// needs it for f-string interpolants: they are re-lexed from raw text,
// so tokenize numbers them from 1:1 and every diagnostic against the
// resulting AST would otherwise land at the start of the file.
pub function rebase_tokens(toks: Token[], base_line: i32, base_col: i32): Token[] {
  let out: Token[] = [];
  let i: i32 = 0;
  while (i < toks.len()) {
    let t: Token = toks[i];
    match (t) {
      TokEof(x) => {
        out = out.append(eof_tok(offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokNumber(x) => {
        out = out.append(number_tok(x.text, x.suffix, x.is_float, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokIdent(x) => {
        out = out.append(ident_tok(x.name, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokKeyword(x) => {
        out = out.append(keyword_tok(x.name, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokPunct(x) => {
        out = out.append(punct_tok(x.text, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokString(x) => {
        out = out.append(string_tok(x.value, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokError(x) => {
        out = out.append(TokError { msg: x.msg, code: x.code, line: offset_line(base_line, x.line), col: offset_col(base_col, x.line, x.col) });
      },
      TokFString(x) => {
        out = out.append(fstring_tok(rebase_parts(x.parts, base_line, base_col), offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      }
    }
    i = i + 1;
  }
  return out;
}

// is_blank_range — true if every byte of s is ASCII whitespace
// (or s is empty). Stands in for `strings.TrimSpace(x) == ""` in
// the f-string empty-interpolant check; written by hand so the
// lexer keeps to built-ins and imports nothing (the
// parser imports this module that way).
function is_blank_range(s: string): boolean {
  let i: i32 = 0;
  while (i < s.len()) {
    if (!is_space(s[i] as i32)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// is_error_tok / has_error — predicates over the Token union used
// by `tokenize` to halt at the first lex error and by the test
// harness to assert that malformed inputs surface one.
pub function is_error_tok(t: Token): boolean {
  match (t) {
    TokError(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function has_error(toks: Token[]): boolean {
  let i: i32 = 0;
  while (i < toks.len()) {
    if (is_error_tok(toks[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// `after_dot` is true when the previously-emitted token was a `.`
// punctuator. In that context a trailing `.<digit>` (or `e<digit>`)
// is the NEXT field access of a chained tuple selector like
// `t.1.0`, not a fractional / exponent continuation — so the float
// upgrades below are suppressed. Mirrors the Go lexer's
// `l.afterDot` guard.
function scan_number(own l: Lex, after_dot: boolean, start_line: i32, start_col: i32): NumResult {
  let begin: i32 = l.i;
  let is_hex: boolean = false;
  // `0x` / `0X` hex integer literal: consume hex digits, skip the
  // float (fractional / exponent) upgrades. A bare `0x` with no
  // following hex digit is an error, not a silent `0` + `x` ident.
  if (l.peek_byte() == 48 && l.i + 1 < l.n
    && (l.src[l.i + 1] == b'x' || l.src[l.i + 1] == b'X')) {
    is_hex = true;
    l = l.skip(2);  // '0' then 'x' / 'X'
    let hex_start: i32 = l.i;
    let he: i32 = l.i;
    while (he < l.n && is_hex_digit(l.src[he] as i32)) {
      he = he + 1;
    }
    l = l.advance_in_line(he);
    if (l.i == hex_start) {
      return NumResult { lex: l, tok: num_error_tok("hex literal needs at least one digit after 0x", start_line, start_col) };
    }
  } else if (radix_prefix(l.src, l.i, l.n) != 0) {
    // `0o` octal / `0b` binary integer literal: no float upgrades either.
    let base: i32 = radix_prefix(l.src, l.i, l.n);
    return scan_radix_number(l, base, start_line, start_col);
  } else {
    let de: i32 = l.i;
    while (de < l.n && is_digit(l.src[de] as i32)) {
      de = de + 1;
    }
    l = l.advance_in_line(de);
  }
  let is_float: boolean = false;
  // Fractional part: `.<digit>+`. Suppressed for hex and right
  // after a `.` (chained tuple index).
  if (!is_hex && !after_dot && l.i + 1 < l.n && l.src[l.i] == b'.' && is_digit(l.src[l.i + 1] as i32)) {
    is_float = true;
    l = l.skip(1);  // consume `.`
    let fe: i32 = l.i;
    while (fe < l.n && is_digit(l.src[fe] as i32)) {
      fe = fe + 1;
    }
    l = l.advance_in_line(fe);
  }
  // Scientific-notation exponent: `[eE][+-]?[0-9]+`, valid on an
  // integer base (`1e3`) or a fractional one (`1.5e-2`). Only
  // consumed when at least one exponent digit follows the optional
  // sign — a bare `1e` / `1efoo` leaves the `e` for the next token.
  if (!is_hex && !after_dot && !l.at_end()
    && (l.peek_byte() == 101 || l.peek_byte() == 69)) {  // 'e' / 'E'
    let j: i32 = l.i + 1;
    if (j < l.n && (l.src[j] == b'+' || l.src[j] == b'-')) {
      j = j + 1;
    }
    if (j < l.n && is_digit(l.src[j] as i32)) {
      is_float = true;
      l = l.skip(1);  // 'e' / 'E'
      if (!l.at_end() && (l.peek_byte() == 43 || l.peek_byte() == 45)) {
        l = l.skip(1);  // sign
      }
      let ee: i32 = l.i;
      while (ee < l.n && is_digit(l.src[ee] as i32)) {
        ee = ee + 1;
      }
      l = l.advance_in_line(ee);
    }
  }
  let text: str = slice_unchecked(l.src, begin, l.i);
  // Optional typed suffix: i32/i64/u8/u32/u64/f32/f64.
  // The suffix character set is a closed list, so misspellings
  // like `42i33` / a truncated `42i` fail here rather than
  // partially consuming. An integer suffix on a float literal
  // (`1.5i32`) is likewise an error.
  let suffix: string = "";
  if (!l.at_end() && is_suffix_start(l.peek_byte())) {
    let s_begin: i32 = l.i;
    l = l.skip(1);
    let se: i32 = l.i;
    while (se < l.n && is_digit(l.src[se] as i32)) {
      se = se + 1;
    }
    l = l.advance_in_line(se);
    suffix = slice_unchecked(l.src, s_begin, l.i) + "";
    if (!is_valid_numeric_suffix(suffix)) {
      return NumResult { lex: l, tok: num_error_tok("unknown numeric suffix " + quoted(suffix) + " on " + quoted(text + ""), start_line, start_col) };
    }
    if (is_float && suffix[0] != b'f') {
      return NumResult { lex: l, tok: num_error_tok("integer suffix " + quoted(suffix) + " on float literal " + quoted(text + ""), start_line, start_col) };
    }
  }
  // `42f32` / `42f64` — integer text with float suffix promotes
  // the token to Float so a downstream parser routes via the
  // float-literal construction path.
  if (!is_float && suffix.len() > 0 && suffix[0] == b'f') {
    is_float = true;
  }
  let tok: Token = number_tok(text, suffix, is_float, start_line, start_col);
  return NumResult { lex: l, tok: tok };
}

// radix_prefix is 8 for a `0o` / `0O` literal at src[i], 2 for a `0b` / `0B`
// one, and 0 for anything else.
function radix_prefix(src: string, i: i32, n: i32): i32 {
  if (src[i] != b'0' || i + 1 >= n) {
    return 0;
  }
  let c: u8 = src[i + 1];
  if (c == b'o' || c == b'O') {
    return 8;
  }
  if (c == b'b' || c == b'B') {
    return 2;
  }
  return 0;
}

// scan_radix_number lexes a `0o` / `0b` literal. Every consumer of a number's
// text already reads hex, so the token's text is the value in hex and its
// `raw` the spelling as written, suffix included, for the printer. A value
// past 64 bits keeps growing the hex digits, so the range checks still see it.
function scan_radix_number(own l0: Lex, base: i32, start_line: i32, start_col: i32): NumResult {
  let l: Lex = l0;
  let begin: i32 = l.i;
  let prefix: string = slice_unchecked(l.src, l.i, l.i + 2) + "";
  l = l.skip(2);
  let digits: i32[] = [];
  let e: i32 = l.i;
  while (e < l.n && is_digit(l.src[e] as i32) && l.src[e] as i32 - 48 < base) {
    digits = digits.append(l.src[e] as i32 - 48);
    e = e + 1;
  }
  l = l.advance_in_line(e);
  if (digits.len() == 0) {
    return NumResult { lex: l, tok: num_error_tok("integer literal needs at least one digit after " + prefix, start_line, start_col) };
  }
  if (!l.at_end() && is_digit(l.peek_byte())) {
    return NumResult { lex: l, tok: num_error_tok("invalid digit " + quote_char(l.src, l.i, l.n) + " in a " + prefix + " literal", start_line, start_col) };
  }
  let suffix: string = "";
  if (!l.at_end() && is_suffix_start(l.peek_byte())) {
    let s_begin: i32 = l.i;
    l = l.skip(1);
    let se: i32 = l.i;
    while (se < l.n && is_digit(l.src[se] as i32)) {
      se = se + 1;
    }
    l = l.advance_in_line(se);
    suffix = slice_unchecked(l.src, s_begin, l.i) + "";
    if (!is_valid_numeric_suffix(suffix) || suffix[0] == b'f') {
      return NumResult { lex: l, tok: num_error_tok("unknown numeric suffix " + quoted(suffix) + " on " + quoted(slice_unchecked(l.src, begin, s_begin) + ""), start_line, start_col) };
    }
  }
  let raw: string = slice_unchecked(l.src, begin, l.i) + "";
  return NumResult { lex: l, tok: TokNumber { text: radix_digits_hex(digits, base), suffix: suffix, raw: raw, is_float: false, line: start_line, col: start_col } };
}

// radix_digits_hex renders base-`base` digits (most significant first) as a
// `0x` literal, by repeated division of the digit string by 16.
function radix_digits_hex(digits: i32[], base: i32): string {
  let cur: i32[] = digits;
  let hex: string = "";
  let hexch: string = "0123456789abcdef";
  while (cur.len() > 0) {
    let next: i32[] = [];
    let rem: i32 = 0;
    for d in cur {
      let acc: i32 = rem * base + d;
      let q: i32 = acc / 16;
      rem = acc % 16;
      if (next.len() > 0 || q != 0) {
        next = next.append(q);
      }
    }
    hex = slice_unchecked(hexch, rem, rem + 1) + hex;
    cur = next;
  }
  return "0x" + hex;
}

// NOT_IDENT marks, by byte value, every byte an identifier cannot hold: all
// but `A`-`Z`, `a`-`z`, `0`-`9` and `_`.
pub const NOT_IDENT: u8[] = [
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 1u8, 1u8, 0u8,
  1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
];

// ident_end returns the offset just past the identifier run starting at l.i.
function ident_end(l: Lex): i32 {
  return __scan_set(l.src, l.i, NOT_IDENT);
}

// ident_or_keyword classifies a scanned identifier run. Split from the scan so
// the pair yields a Token directly: the scan_ident this replaces returned a
// NumResult, and boxing that struct cost a heap allocation per identifier token.
function ident_or_keyword(name: string, start_line: i32, start_col: i32): Token {
  if (is_keyword(name)) {
    return keyword_tok(name, start_line, start_col);
  }
  return ident_tok(name, start_line, start_col);
}

// dec_str renders a non-negative i32 in base 10. util.i32_to_string is
// the shared home for this, but reaching it means importing util here,
// and this module deliberately imports nothing — see the header. Only
// scan_quoted needs it, over the scalar range 0..0x10FFFF.
function dec_str(v: i32): string {
  if (v == 0) {
    return "0";
  }
  let rev: u8[] = [];
  while (v > 0) {
    rev = rev.append((48 + v % 10) as u8);
    v = v / 10;
  }
  let out: string = "";
  let i: i32 = rev.len() - 1;
  while (i >= 0) {
    out = out + string_from_bytes_unchecked([rev[i]]);
    i = i - 1;
  }
  return out;
}

// Utf8 is one decoded UTF-8 sequence: `val` is the scalar, `len` its
// byte length, and len 0 marks a malformed sequence. Only character
// literals need it — every other scanner here works byte-at-a-time.
struct Utf8 { val: i32, len: i32 }

function decode_utf8(src: string, i: i32, n: i32): Utf8 {
  let b0: i32 = src[i] as i32;
  if (b0 < 128) {
    return Utf8 { val: b0, len: 1 };
  }
  let need: i32 = 0;
  let val: i32 = 0;
  if (b0 >= 240 && b0 < 248) {
    need = 3;
    val = b0 & 7;
  } else if (b0 >= 224) {
    need = 2;
    val = b0 & 15;
  } else if (b0 >= 192) {
    need = 1;
    val = b0 & 31;
  } else {
    return Utf8 { val: 0, len: 0 };
  }
  if (i + need >= n) {
    return Utf8 { val: 0, len: 0 };
  }
  let k: i32 = 1;
  while (k <= need) {
    let c: i32 = src[i + k] as i32;
    if (c < 128 || c >= 192) {
      return Utf8 { val: 0, len: 0 };
    }
    val = val << 6 | c & 63;
    k = k + 1;
  }
  return Utf8 { val: val, len: need + 1 };
}

// rune_of_byte is byte `b` read as the code point of the same value, the
// character Go's `%c` prints for a byte.
function rune_of_byte(b: i32): string {
  if (b < 128) {
    return string_from_bytes_unchecked([b as u8]);
  }
  return string_from_bytes_unchecked([(192 | b >> 6) as u8, (128 | b & 63) as u8]);
}

// quoted is `s` double-quoted, as Go's `%q` prints a numeric literal's text
// or suffix, neither of which can hold a character it would escape.
function quoted(s: string): string {
  return "\"" + s + "\"";
}

// quote_char is the character starting a valid UTF-8 sequence at src[i] as
// Go's `%q` prints a rune: single-quoted, `'` and `\` escaped, an ASCII
// control escaped, and anything else as written.
function quote_char(src: string, i: i32, n: i32): string {
  let b: i32 = src[i] as i32;
  if (b == 39 || b == 92) {
    return "'\\" + string_from_bytes_unchecked([b as u8]) + "'";
  }
  if (b >= 32 && b < 127) {
    return "'" + string_from_bytes_unchecked([b as u8]) + "'";
  }
  if (b < 128) {
    return "'" + control_escape(b) + "'";
  }
  return "'" + slice_unchecked(src, i, i + decode_utf8(src, i, n).len) + "'";
}

// control_escape spells an ASCII control byte the way Go's quoting does. The
// whitespace controls never reach it: they are trivia, not tokens.
function control_escape(b: i32): string {
  if (b == 7) {
    return "\\a";
  }
  if (b == 8) {
    return "\\b";
  }
  return "\\x" + hex_digit(b >> 4, "0123456789abcdef") + hex_digit(b & 15, "0123456789abcdef");
}

function hex_digit(d: i32, digits: string): string {
  return slice_unchecked(digits, d, d + 1) + "";
}

// bad_char_message words the byte at src[i] that starts no token, as the Go
// lexer's badCharError does. A byte that starts no valid UTF-8 sequence is
// named the way the Go lexer's whole-source UTF-8 check names it.
function bad_char_message(src: string, i: i32, n: i32): string {
  let b: i32 = src[i] as i32;
  if (b >= 128 && decode_utf8(src, i, n).len == 0) {
    return "invalid UTF-8 byte 0x" + hex_digit(b >> 4, "0123456789ABCDEF") + hex_digit(b & 15, "0123456789ABCDEF");
  }
  return "unexpected character " + quote_char(src, i, n);
}

// EscVal is one decoded escape inside a quoted literal: the advanced
// lexer, the scalar it produced, and a non-empty `err` when the escape
// was rejected.
struct EscVal { lex: Lex, val: i32, err: string }

// quoted_escape decodes the escape at the current `\`, which it
// consumes along with the escape body. Character, string and f-string
// literals share it, so their escapes are one set. `\u{...}` is a
// Unicode scalar, so a byte literal refuses it, and `\xNN` reaches the
// full byte range in a byte literal but stops at 0x7F everywhere else,
// where anything above ASCII has two readings and `\u{...}` says which.
// Mirrors the Go lexer's scanQuotedEscape, message for message.
function quoted_escape(own l: Lex, is_byte: boolean, kind_name: string): EscVal {
  l = l.advance();  // backslash
  if (l.at_end()) {
    return EscVal { lex: l, val: 0, err: "unterminated " + kind_name + " literal" };
  }
  let esc: i32 = l.peek_byte();
  l = l.advance();
  if (esc == 110) {
    return EscVal { lex: l, val: 10, err: "" };
  }
  if (esc == 116) {
    return EscVal { lex: l, val: 9, err: "" };
  }
  if (esc == 114) {
    return EscVal { lex: l, val: 13, err: "" };
  }
  if (esc == 48) {
    return EscVal { lex: l, val: 0, err: "" };
  }
  if (esc == 92) {
    return EscVal { lex: l, val: 92, err: "" };
  }
  if (esc == 39) {
    return EscVal { lex: l, val: 39, err: "" };
  }
  if (esc == 34) {
    return EscVal { lex: l, val: 34, err: "" };
  }
  if (esc == 120) {
    return hex_escape(l, is_byte, kind_name);
  }
  if (esc == 117) {
    if (is_byte) {
      return EscVal { lex: l, val: 0, err: "\\u{...} is a Unicode scalar; a byte literal takes \\xNN" };
    }
    return unicode_escape(l);
  }
  return EscVal { lex: l, val: 0, err: "unknown escape \\" + rune_of_byte(esc) + " in " + kind_name + " literal" };
}

// hex_escape decodes the two digits of `\xNN`, `l` positioned after the `x`.
function hex_escape(own l: Lex, is_byte: boolean, kind_name: string): EscVal {
  if (l.i + 1 >= l.n || !is_hex_digit(l.src[l.i] as i32) || !is_hex_digit(l.src[l.i + 1] as i32)) {
    return EscVal { lex: l, val: 0, err: "\\x escape needs two hex digits" };
  }
  let v: i32 = hex_val(l.src[l.i] as i32) * 16 + hex_val(l.src[l.i + 1] as i32);
  l = l.advance();
  l = l.advance();
  if (!is_byte && v > 127) {
    let hx: string = upper_hex(v);
    return EscVal { lex: l, val: 0, err: "\\x" + hx + " is above ASCII in " + literal_name(kind_name) + "; write \\u{" + hx + "} for the scalar" };
  }
  return EscVal { lex: l, val: v, err: "" };
}

// literal_name is the kind of literal with its article, for a message.
function literal_name(kind_name: string): string {
  if (kind_name == "f-string") {
    return "an f-string literal";
  }
  return "a " + kind_name + " literal";
}

// unicode_escape decodes the `{...}` of `\u{...}`, `l` positioned after the
// `u`, refusing a surrogate and anything past U+10FFFF.
function unicode_escape(own l: Lex): EscVal {
  if (l.at_end() || l.peek_byte() != 123) {
    return EscVal { lex: l, val: 0, err: "\\u escape needs braces: \\u{1F600}" };
  }
  l = l.advance();  // {
  let digits: i32 = 0;
  let uv: i32 = 0;
  while (!l.at_end() && is_hex_digit(l.peek_byte())) {
    if (digits == 6) {
      return EscVal { lex: l, val: 0, err: "\\u{...} takes at most 6 hex digits" };
    }
    uv = uv * 16 + hex_val(l.peek_byte());
    digits = digits + 1;
    l = l.advance();
  }
  if (digits == 0) {
    return EscVal { lex: l, val: 0, err: "\\u{...} needs at least one hex digit" };
  }
  if (l.at_end() || l.peek_byte() != 125) {
    return EscVal { lex: l, val: 0, err: "unterminated \\u{...} escape" };
  }
  l = l.advance();  // }
  if (uv > 1114111) {
    return EscVal { lex: l, val: 0, err: "\\u{" + upper_hex(uv) + "} is above the maximum Unicode scalar 10FFFF" };
  }
  if (uv >= 55296 && uv <= 57343) {
    return EscVal { lex: l, val: 0, err: "\\u{" + upper_hex(uv) + "} is a surrogate, not a Unicode scalar value" };
  }
  return EscVal { lex: l, val: uv, err: "" };
}

// upper_hex spells a non-negative value in upper-case hex with at least two
// digits, as Go's `%02X` does.
function upper_hex(v: i32): string {
  let out: string = hex_digit(v & 15, "0123456789ABCDEF");
  v = v >> 4;
  while (v > 0 || out.len() < 2) {
    out = hex_digit(v & 15, "0123456789ABCDEF") + out;
    v = v >> 4;
  }
  return out;
}

// utf8_encode is scalar `v` as UTF-8. The lexer has refused every value
// that is not a Unicode scalar before it gets here.
function utf8_encode(v: i32): string {
  if (v < 128) {
    return string_from_bytes_unchecked([v as u8]);
  }
  if (v < 2048) {
    return string_from_bytes_unchecked([(192 | v >> 6) as u8, (128 | v & 63) as u8]);
  }
  if (v < 65536) {
    return string_from_bytes_unchecked([(224 | v >> 12) as u8, (128 | v >> 6 & 63) as u8, (128 | v & 63) as u8]);
  }
  return string_from_bytes_unchecked([(240 | v >> 18) as u8, (128 | v >> 12 & 63) as u8, (128 | v >> 6 & 63) as u8, (128 | v & 63) as u8]);
}

// closing_quote_ahead separates a too-long literal (`'ab'`) from an
// unterminated one (`'ab`) so each error names its own problem.
function closing_quote_ahead(l: Lex): boolean {
  let j: i32 = l.i;
  while (j < l.n && l.src[j] != b'\n') {
    if (l.src[j] == b'\'') {
      return true;
    }
    j = j + 1;
  }
  return false;
}

// scan_quoted reads a character literal `'x'` or, when `is_byte`, a
// byte literal `b'x'`; `l` is positioned at the leading `b` / `'`.
// Everything a literal cannot mean is rejected here rather than left
// for the parser: an empty `''`, more than one scalar / byte, a
// non-ASCII `b'é'`, and an unterminated one. Mirrors scanQuoted in
// internal/syntax/lexer/lexer.go.
function scan_quoted(own l: Lex, is_byte: boolean, start_line: i32, start_col: i32): NumResult {
  let begin: i32 = l.i;
  let kind_name: string = "character";
  let suffix: string = "char";
  if (is_byte) {
    kind_name = "byte";
    suffix = "u8";
    l = l.advance();  // `b`
  }
  l = l.advance();  // opening '
  if (l.at_end()) {
    return NumResult { lex: l, tok: error_tok("unterminated " + kind_name + " literal", start_line, start_col) };
  }
  let c: i32 = l.peek_byte();
  if (c == 39) {
    l = l.advance();
    return NumResult { lex: l, tok: error_tok("empty " + kind_name + " literal", start_line, start_col) };
  }
  if (c == 10) {
    return NumResult { lex: l, tok: error_tok("newline inside " + kind_name + " literal", start_line, start_col) };
  }
  let val: i32 = 0;
  if (c == 92) {
    let ev: EscVal = quoted_escape(l, is_byte, kind_name);
    l = ev.lex;
    if (ev.err.len() > 0) {
      return NumResult { lex: l, tok: error_tok(ev.err, start_line, start_col) };
    }
    val = ev.val;
  } else if (is_byte) {
    if (c >= 128) {
      return NumResult { lex: l, tok: error_tok("byte literal must be ASCII; write a character literal for a Unicode scalar", start_line, start_col) };
    }
    val = c;
    l = l.advance();
  } else {
    let u: Utf8 = decode_utf8(l.src, l.i, l.n);
    if (u.len == 0) {
      return NumResult { lex: l, tok: error_tok("invalid UTF-8 byte in character literal", start_line, start_col) };
    }
    val = u.val;
    l = l.skip(u.len);
  }
  if (l.at_end() || l.peek_byte() != 39) {
    if (closing_quote_ahead(l)) {
      return NumResult { lex: l, tok: error_tok(kind_name + " literal must hold exactly one " + kind_name, start_line, start_col) };
    }
    return NumResult { lex: l, tok: error_tok("unterminated " + kind_name + " literal", start_line, start_col) };
  }
  l = l.advance();  // closing '
  let raw: string = slice_unchecked(l.src, begin, l.i) + "";
  return NumResult { lex: l, tok: quoted_tok(dec_str(val), suffix, raw, start_line, start_col) };
}

// scan_string reads `"…"` with the escapes quoted_escape decodes, each
// appended as UTF-8, so the value is always valid UTF-8. Errors (newline
// inside string, a refused escape, unterminated) surface as a TokError
// carrying the Go lexer's message.
function scan_string(own l: Lex, start_line: i32, start_col: i32): NumResult {
  l = l.advance();  // opening "
  let out: string = "";
  while (!l.at_end() && l.peek_byte() != 34) {
    let c: i32 = l.peek_byte();
    if (c == 10) {
      return NumResult { lex: l, tok: error_tok("newline inside string literal", start_line, start_col) };
    }
    if (c == 92) {  // backslash
      let ev: EscVal = quoted_escape(l, false, "string");
      l = ev.lex;
      if (ev.err.len() > 0) {
        return NumResult { lex: l, tok: error_tok(ev.err, start_line, start_col) };
      }
      out = out + utf8_encode(ev.val);
      continue;
    }
    // Copy the run of plain bytes up to the next `"` / `\` / newline
    // whole — a per-byte slice would split multibyte characters.
    let re: i32 = l.i;
    while (re < l.n && l.src[re] != b'"' && l.src[re] != 92 && l.src[re] != b'\n') {
      re = re + 1;
    }
    out = out + slice_unchecked(l.src, l.i, re);
    l = l.advance_in_line(re);
  }
  if (l.at_end()) {
    return NumResult { lex: l, tok: error_tok("unterminated string literal", start_line, start_col) };
  }
  l = l.advance();  // closing "
  return NumResult { lex: l, tok: string_tok(out, start_line, start_col) };
}

// scan_fstring consumes the body of an f-string. `l` is positioned
// at the opening `"` (the leading `f` is already consumed). It
// returns a TokFString whose parts alternate literal segments with
// raw interpolant-expression text, mirroring the Go lexer's
// scanFString:
//
//   f"hi {x + 1}!"  → [Lit "hi ", Expr "x + 1", Lit "!"]
//   f"{count}"      → [Expr "count"]
//   f"plain"        → [Lit "plain"]
//   f""             → []
//
// `{{` / `}}` escape literal braces; standard escapes apply in the
// literal portions; inside `{...}` the bytes pass through verbatim
// (with nested braces tracked and inner string literals skipped so
// their quotes / braces don't break the boundary scan). All the
// failure shapes surface a TokError.
function scan_fstring(own l: Lex, start_line: i32, start_col: i32): NumResult {
  l = l.advance();  // opening "
  let lit: string = "";
  let have_lit: boolean = false;
  let parts: FStringPart[] = [];
  while (!l.at_end()) {
    let c: i32 = l.peek_byte();
    if (c == 34) {  // closing "
      l = l.advance();
      if (have_lit) {
        parts = parts.append(FStringPart { lit: lit, expr: "", is_expr: false, line: 0, col: 0 });
      }
      return NumResult { lex: l, tok: fstring_tok(parts, start_line, start_col) };
    }
    if (c == 10) {
      return NumResult { lex: l, tok: error_tok("newline inside f-string literal", start_line, start_col) };
    }
    if (c == 92) {  // backslash escape (literal portion only)
      let ev: EscVal = quoted_escape(l, false, "f-string");
      l = ev.lex;
      if (ev.err.len() > 0) {
        return NumResult { lex: l, tok: error_tok(ev.err, start_line, start_col) };
      }
      lit = lit + utf8_encode(ev.val);
      have_lit = true;
      continue;
    }
    if (c == 123) {  // {
      if (l.i + 1 < l.n && l.src[l.i + 1] == b'{') {  // {{ → literal {
        lit = lit + "{";
        have_lit = true;
        l = l.advance();
        l = l.advance();
        continue;
      }
      l = l.advance();  // opening {
      if (have_lit) {  // flush the literal accumulated so far
        parts = parts.append(FStringPart { lit: lit, expr: "", is_expr: false, line: 0, col: 0 });
        lit = "";
        have_lit = false;
      }
      // Find the matching `}` at brace-depth 0. Nested braces
      // bump the depth; a string literal inside the interpolant
      // is skipped wholesale so its quotes / braces don't move
      // the boundary.
      let expr_start: i32 = l.i;
      let expr_line: i32 = l.line;
      let expr_col: i32 = l.col;
      let depth: i32 = 1;
      while (!l.at_end() && depth > 0) {
        let d: i32 = l.peek_byte();
        if (d == 123) {
          depth = depth + 1;
        } else if (d == 125) {
          depth = depth - 1;
          if (depth == 0) {
            break;
          }
        } else if (d == 10) {
          return NumResult { lex: l, tok: error_tok("newline inside f-string interpolation", start_line, start_col) };
        } else if (d == 34) {
          l = l.advance();  // opening "
          while (!l.at_end() && l.peek_byte() != 34) {
            if (l.peek_byte() == 92 && l.i + 1 < l.n) {
              l = l.advance();  // skip escaped char
            }
            l = l.advance();
          }
          if (l.at_end()) {
            return NumResult { lex: l, tok: error_tok("unterminated string inside f-string interpolation", start_line, start_col) };
          }
          // l now at the closing `"`; the advance below consumes it.
        }
        if (depth > 0) {
          l = l.advance();
        }
      }
      if (depth != 0) {
        return NumResult { lex: l, tok: error_tok("unterminated `{` in f-string", start_line, start_col) };
      }
      let expr_text: str = slice_unchecked(l.src, expr_start, l.i);
      l = l.advance();  // closing }
      if (is_blank_range(expr_text)) {
        return NumResult { lex: l, tok: error_tok("empty `{}` in f-string", start_line, start_col) };
      }
      parts = parts.append(FStringPart { lit: "", expr: expr_text + "", is_expr: true, line: expr_line, col: expr_col });
      continue;
    }
    if (c == 125) {  // }
      if (l.i + 1 < l.n && l.src[l.i + 1] == b'}') {  // }} → literal }
        lit = lit + "}";
        have_lit = true;
        l = l.advance();
        l = l.advance();
        continue;
      }
      return NumResult { lex: l, tok: error_tok("unmatched `}` in f-string (use `}}` for a literal `}`)", start_line, start_col) };
    }
    // Copy the run of plain bytes up to the next `"` / `\` / newline /
    // brace whole — a per-byte slice would split multibyte characters.
    let le: i32 = l.i;
    while (le < l.n && l.src[le] != b'"' && l.src[le] != 92 && l.src[le] != b'\n'
      && l.src[le] != b'{' && l.src[le] != b'}') {
      le = le + 1;
    }
    lit = lit + slice_unchecked(l.src, l.i, le);
    have_lit = true;
    l = l.advance_in_line(le);
  }
  return NumResult { lex: l, tok: error_tok("unterminated f-string literal", start_line, start_col) };
}

// tokenize returns just the tokens, for the compile path, which has no use
// for comments. Callers that want them (doc extraction, formatting) call
// tokenize_full.
pub function tokenize(src: string): Token[] {
  return tokenize_impl(src, false, 1).tokens;
}

// tokenize_from numbers the first line `first_line`: a bundle's imported
// module starts at its util.line_base.
pub function tokenize_from(src: string, first_line: i32): Token[] {
  return tokenize_impl(src, false, first_line).tokens;
}

// tokenize_full is the top-level entrypoint. Mirrors the Go lexer's
// `Tokenize` — a Token[] terminated by TokEof, plus the `//` comments
// seen along the way, in source order.
pub function tokenize_full(src: string): LexResult {
  return tokenize_impl(src, true, 1);
}

function tokenize_impl(src: string, keep: boolean, first_line: i32): LexResult {
  let l: Lex = Lex { src: src, i: 0, n: src.len(), line: first_line, col: 1, comments: [] };
  let out: Token[] = [];
  // Tracks whether the previously-emitted token was a `.` punct,
  // so the number scanner can suppress the chained-tuple float
  // upgrade (`t.1.0`). Mirrors the Go lexer's `l.afterDot`.
  let after_dot: boolean = false;
  while (true) {
    l = skip_trivia(l, keep);
    if (l.at_end()) {
      out = out.append(TokEof { line: l.line, col: l.col });
      return LexResult { tokens: out, comments: l.comments };
    }
    let start_line: i32 = l.line;
    let start_col: i32 = l.col;
    let b: i32 = l.peek_byte();
    // f-string `f"..."` — checked before the identifier path so
    // the leading `f` isn't consumed as an ident. Mirrors the
    // Go lexer's first-branch f-string detection.
    if (b == 102 && l.i + 1 < l.n && l.src[l.i + 1] == b'"') {
      l = l.advance();  // consume `f`
      let rf = scan_fstring(l, start_line, start_col);
      l = rf.lex;
      out = out.append(rf.tok);
      if (is_error_tok(rf.tok)) {
        return LexResult { tokens: out, comments: l.comments };
      }
      after_dot = false;
      continue;
    }
    // Byte literal `b'x'` — checked before the identifier path for
    // the same reason the f-string prefix is: `b` starts an
    // identifier, and no valid program has one immediately followed
    // by a `'`.
    if (b == 98 && l.i + 1 < l.n && l.src[l.i + 1] == b'\'') {
      let rb = scan_quoted(l, true, start_line, start_col);
      l = rb.lex;
      out = out.append(rb.tok);
      if (is_error_tok(rb.tok)) {
        return LexResult { tokens: out, comments: l.comments };
      }
      after_dot = false;
      continue;
    }
    if (b == 39) {  // '
      let rc = scan_quoted(l, false, start_line, start_col);
      l = rc.lex;
      out = out.append(rc.tok);
      if (is_error_tok(rc.tok)) {
        return LexResult { tokens: out, comments: l.comments };
      }
      after_dot = false;
      continue;
    }
    if (is_digit(b)) {
      let rn = scan_number(l, after_dot, start_line, start_col);
      l = rn.lex;
      out = out.append(rn.tok);
      if (is_error_tok(rn.tok)) {
        return LexResult { tokens: out, comments: l.comments };
      }
      after_dot = false;
      continue;
    }
    if (is_alpha(b)) {
      let e: i32 = ident_end(l);
      let tok: Token = ident_or_keyword(slice_unchecked(l.src, l.i, e), start_line, start_col);
      l = l.advance_in_line(e);
      out = out.append(tok);
      after_dot = false;
      continue;
    }
    if (b == 34) {  // "
      let rs = scan_string(l, start_line, start_col);
      l = rs.lex;
      out = out.append(rs.tok);
      if (is_error_tok(rs.tok)) {
        return LexResult { tokens: out, comments: l.comments };
      }
      after_dot = false;
      continue;
    }
    let mp: string = match_multipunct(l.src, l.i, l.n);
    if (mp.len() > 0) {
      let i: i32 = 0;
      while (i < mp.len()) {
        l = l.advance();
        i = i + 1;
      }
      // `::` is kept as its own token. In EXPRESSION position it is a
      // path separator equivalent to `.` (`Type::f` / `mod::g` /
      // `Type::CONST`), and every `.`-handling parser site accepts both
      // via `at_path_sep`. In TYPE position the two are NOT
      // interchangeable: `mod.Type` is a module-qualified name and
      // `Base::Name` an associated-type projection (`Self::Item`), so
      // normalising `::` away here left the type parser unable to tell
      // them apart. See docs/ASSOCIATED-TYPES.md, #2700.
      out = out.append(TokPunct { text: mp, line: start_line, col: start_col });
      after_dot = false;
      continue;
    }
    let text: string = single_punct(b);
    if (text.len() > 0) {
      l = l.advance();
      out = out.append(TokPunct { text: text, line: start_line, col: start_col });
      after_dot = b == 46;
      continue;
    }
    out = out.append(error_tok(bad_char_message(src, l.i, l.n), start_line, start_col));
    return LexResult { tokens: out, comments: l.comments };
  }
  return LexResult { tokens: out, comments: l.comments };
}

// test_mixed feeds a mixed-token input through tokenize, walks the
// resulting Token[] with literal-pattern match arms, and returns 0
// if every assertion holds. Non-zero return codes pinpoint which
// arm fired so the Go test can surface the right diagnostic.
function test_mixed(): i32 {
  let src: string = "let x: i32 = 42i64; // a comment\nreturn x + 1.5f64;\n";
  let toks: Token[] = tokenize(src);

  // Expected sequence:
  //   Keyword "let"
  //   Ident "x"
  //   Punct ":"
  //   Keyword "i32"
  //   Punct "="
  //   Number "42" suffix="i64"
  //   Punct ";"
  //   Keyword "return"
  //   Ident "x"
  //   Punct "+"
  //   Number "1.5" suffix="f64" is_float=true
  //   Punct ";"
  //   Eof
  if (toks.len() != 13) {
    return 1;
  }

  match (toks[0]) {
    TokKeyword(t) => {
      if (t.name != "let") {
        return 100;
      }
    },
    _ => {
      return 101;
    }
  }
  match (toks[1]) {
    TokIdent(t) => {
      if (t.name != "x") {
        return 200;
      }
    },
    _ => {
      return 201;
    }
  }
  match (toks[2]) {
    TokPunct(t) => {
      if (t.text != ":") {
        return 300;
      }
    },
    _ => {
      return 301;
    }
  }
  match (toks[3]) {
    TokKeyword(t) => {
      if (t.name != "i32") {
        return 400;
      }
    },
    _ => {
      return 401;
    }
  }
  match (toks[4]) {
    TokPunct(t) => {
      if (t.text != "=") {
        return 500;
      }
    },
    _ => {
      return 501;
    }
  }
  match (toks[5]) {
    TokNumber(t) => {
      if (t.text != "42") {
        return 600;
      }
      if (t.suffix != "i64") {
        return 601;
      }
      if (t.is_float) {
        return 602;
      }
    },
    _ => {
      return 603;
    }
  }
  match (toks[6]) {
    TokPunct(t) => {
      if (t.text != ";") {
        return 700;
      }
    },
    _ => {
      return 701;
    }
  }
  match (toks[7]) {
    TokKeyword(t) => {
      if (t.name != "return") {
        return 800;
      }
      if (t.line != 2) {
        return 801;
      }
    },
    _ => {
      return 802;
    }
  }
  match (toks[8]) {
    TokIdent(t) => {
      if (t.name != "x") {
        return 900;
      }
    },
    _ => {
      return 901;
    }
  }
  match (toks[9]) {
    TokPunct(t) => {
      if (t.text != "+") {
        return 1000;
      }
    },
    _ => {
      return 1001;
    }
  }
  match (toks[10]) {
    TokNumber(t) => {
      if (t.text != "1.5") {
        return 1100;
      }
      if (t.suffix != "f64") {
        return 1101;
      }
      if (!t.is_float) {
        return 1102;
      }
    },
    _ => {
      return 1103;
    }
  }
  match (toks[11]) {
    TokPunct(t) => {
      if (t.text != ";") {
        return 1200;
      }
    },
    _ => {
      return 1201;
    }
  }
  match (toks[12]) {
    TokEof(_) => {
      return 0;
    },
    _ => {
      return 1300;
    }
  }
  return -1;
}

// test_hex — `0x` / `0X` integer literals, mixed-case digits, and a
// trailing typed suffix (`0x10u8`). All come back as non-float
// Number tokens whose text includes the prefix.
function test_hex(): i32 {
  let toks: Token[] = tokenize("0x2A 0xff 0X0 0xDEADBEEF 0x10u8");
  if (toks.len() != 6) {
    return 1400;
  }
  match (toks[0]) {
    TokNumber(t) => {
      if (t.text != "0x2A") {
        return 1401;
      }
      if (t.is_float) {
        return 1402;
      }
    },
    _ => {
      return 1403;
    }
  }
  match (toks[1]) {
    TokNumber(t) => {
      if (t.text != "0xff") {
        return 1404;
      }
    },
    _ => {
      return 1405;
    }
  }
  match (toks[2]) {
    TokNumber(t) => {
      if (t.text != "0X0") {
        return 1406;
      }
    },
    _ => {
      return 1407;
    }
  }
  match (toks[3]) {
    TokNumber(t) => {
      if (t.text != "0xDEADBEEF") {
        return 1408;
      }
    },
    _ => {
      return 1409;
    }
  }
  match (toks[4]) {
    TokNumber(t) => {
      if (t.text != "0x10") {
        return 1410;
      }
      if (t.suffix != "u8") {
        return 1411;
      }
    },
    _ => {
      return 1412;
    }
  }
  match (toks[5]) {
    TokEof(_) => {
      return 0;
    },
    _ => {
      return 1413;
    }
  }
  return 1414;
}

// test_scientific — `[eE][+-]?[0-9]+` exponents on both integer and
// fractional bases. Every input is a single Float whose text is
// ParseFloat-ready.
function test_scientific(): i32 {
  let toks: Token[] = tokenize("1e3 1.5e10 1.5E3 2.0e-2 6.022e+23");
  if (toks.len() != 6) {
    return 1500;
  }
  match (toks[0]) {
    TokNumber(t) => {
      if (t.text != "1e3") {
        return 1501;
      }
      if (!t.is_float) {
        return 1502;
      }
    },
    _ => {
      return 1503;
    }
  }
  match (toks[1]) {
    TokNumber(t) => {
      if (t.text != "1.5e10") {
        return 1504;
      }
    },
    _ => {
      return 1505;
    }
  }
  match (toks[2]) {
    TokNumber(t) => {
      if (t.text != "1.5E3") {
        return 1506;
      }
    },
    _ => {
      return 1507;
    }
  }
  match (toks[3]) {
    TokNumber(t) => {
      if (t.text != "2.0e-2") {
        return 1508;
      }
    },
    _ => {
      return 1509;
    }
  }
  match (toks[4]) {
    TokNumber(t) => {
      if (t.text != "6.022e+23") {
        return 1510;
      }
    },
    _ => {
      return 1511;
    }
  }
  return 0;
}

// test_bare_e — a dangling `e` with no exponent digits is NOT an
// exponent: the number stops before it and the `e...` lexes as a
// separate identifier. `1e foo` → Number "1", Ident "e", Ident
// "foo", EOF.
function test_bare_e(): i32 {
  let toks: Token[] = tokenize("1e foo");
  if (toks.len() != 4) {
    return 1550;
  }
  match (toks[0]) {
    TokNumber(t) => {
      if (t.text != "1") {
        return 1551;
      }
    },
    _ => {
      return 1552;
    }
  }
  match (toks[1]) {
    TokIdent(t) => {
      if (t.name != "e") {
        return 1553;
      }
    },
    _ => {
      return 1554;
    }
  }
  match (toks[2]) {
    TokIdent(t) => {
      if (t.name != "foo") {
        return 1555;
      }
    },
    _ => {
      return 1556;
    }
  }
  return 0;
}

// test_chained_tuple — `t.1.0` must lex as three values joined by
// two dots, NOT `t . 1.0` with `1.0` eaten as a float. The afterDot
// guard suppresses the `.<digit>` float upgrade after a `.`.
function test_chained_tuple(): i32 {
  let toks: Token[] = tokenize("t.1.0");
  if (toks.len() != 6) {
    return 1600;
  }
  match (toks[0]) {
    TokIdent(t) => {
      if (t.name != "t") {
        return 1601;
      }
    },
    _ => {
      return 1602;
    }
  }
  match (toks[1]) {
    TokPunct(t) => {
      if (t.text != ".") {
        return 1603;
      }
    },
    _ => {
      return 1604;
    }
  }
  match (toks[2]) {
    TokNumber(t) => {
      if (t.text != "1") {
        return 1605;
      }
      if (t.is_float) {
        return 1606;
      }
    },
    _ => {
      return 1607;
    }
  }
  match (toks[3]) {
    TokPunct(t) => {
      if (t.text != ".") {
        return 1608;
      }
    },
    _ => {
      return 1609;
    }
  }
  match (toks[4]) {
    TokNumber(t) => {
      if (t.text != "0") {
        return 1610;
      }
      if (t.is_float) {
        return 1611;
      }
    },
    _ => {
      return 1612;
    }
  }
  return 0;
}

// test_float_after_nondot — pin that the afterDot suppression
// doesn't over-fire: a `.<digit>` after a non-dot context still
// upgrades to a float. `let f = 1.5;` yields exactly one Float.
function test_float_after_nondot(): i32 {
  let toks: Token[] = tokenize("let f = 1.5;");
  let floats: i32 = 0;
  let i: i32 = 0;
  while (i < toks.len()) {
    match (toks[i]) {
      TokNumber(t) => {
        if (t.is_float) {
          floats = floats + 1;
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  if (floats != 1) {
    return 1650;
  }
  return 0;
}

// test_suffix_errors — the closed-list suffix validation: bad
// (`42i33`), truncated (`42i`), and integer-on-float (`1.5i32`)
// suffixes all surface a TokError, while the valid forms don't.
function test_suffix_errors(): i32 {
  if (!has_error(tokenize("42i33"))) {
    return 1700;
  }
  if (!has_error(tokenize("42i"))) {
    return 1701;
  }
  if (!has_error(tokenize("1.5i32"))) {
    return 1702;
  }
  if (has_error(tokenize("42i64"))) {
    return 1703;
  }
  if (has_error(tokenize("7u8"))) {
    return 1704;
  }
  if (has_error(tokenize("42f32"))) {
    return 1705;
  }
  if (has_error(tokenize("1.5f64"))) {
    return 1706;
  }
  return 0;
}

// test_hex_needs_digits — a bare `0x` with no hex digit is an error.
function test_hex_needs_digits(): i32 {
  if (!has_error(tokenize("0x"))) {
    return 1800;
  }
  if (has_error(tokenize("0x1"))) {
    return 1801;
  }
  return 0;
}

// test_string_errors — unterminated, unknown-escape, and
// newline-inside string literals each surface a TokError; a
// well-formed literal does not.
function test_string_errors(): i32 {
  if (!has_error(tokenize("\"oops"))) {
    return 1850;
  }
  if (!has_error(tokenize("\"a\\zb\""))) {
    return 1851;
  }
  if (!has_error(tokenize("\"with\nnewline\""))) {
    return 1852;
  }
  if (has_error(tokenize("\"ok\""))) {
    return 1853;
  }
  return 0;
}

// lex_error_is reports whether lexing `src` ends in the error `msg` with
// diagnostic code `code`.
function lex_error_is(src: string, msg: string, code: string): boolean {
  let toks: Token[] = tokenize(src);
  if let TokError(e) = toks[toks.len() - 1] {
    return e.msg == msg && e.code == code;
  }
  return false;
}

// test_unknown_char — an unexpected character surfaces a TokError worded as
// the Go lexer words it. `@` is a punctuator (it introduces an attribute).
function test_unknown_char(): i32 {
  if (!lex_error_is("$", "unexpected character '$'", "P001")) {
    return 1900;
  }
  if (has_error(tokenize("@"))) {
    return 1901;
  }
  if (!lex_error_is("a # b", "unexpected character '#'", "P001")) {
    return 1902;
  }
  if (!lex_error_is("`", "unexpected character '`'", "P001")) {
    return 1903;
  }
  if (!lex_error_is("~~", "unexpected character '~'", "P001")) {
    return 1904;
  }
  if (!lex_error_is("\\", "unexpected character '\\\\'", "P001")) {
    return 1905;
  }
  if (!lex_error_is("x §", "unexpected character '§'", "P001")) {
    return 1906;
  }
  if (!lex_error_is("\x01", "unexpected character '\\x01'", "P001")) {
    return 1907;
  }
  if (!lex_error_is(string_from_bytes_unchecked([97 as u8, 32 as u8, 255 as u8]), "invalid UTF-8 byte 0xFF", "P001")) {
    return 1908;
  }
  // The rest of the lexer's errors carry their codes too: a numeric literal's
  // is P002.
  if (!lex_error_is("42i33", "unknown numeric suffix \"i33\" on \"42\"", "P002")) {
    return 1909;
  }
  if (!lex_error_is("1.5i32", "integer suffix \"i32\" on float literal \"1.5\"", "P002")) {
    return 1910;
  }
  if (!lex_error_is("0o19", "invalid digit '9' in a 0o literal", "P002")) {
    return 1911;
  }
  if (!lex_error_is("\"a\\qb\"", "unknown escape \\q in string literal", "P001")) {
    return 1912;
  }
  if (!lex_error_is("f\"a\\qb\"", "unknown escape \\q in f-string literal", "P001")) {
    return 1913;
  }
  if (!lex_error_is("'\\xFF'", "\\xFF is above ASCII in a character literal; write \\u{FF} for the scalar", "P001")) {
    return 1914;
  }
  if (!lex_error_is("\"\\xff\"", "\\xFF is above ASCII in a string literal; write \\u{FF} for the scalar", "P001")) {
    return 1915;
  }
  if (!lex_error_is("f\"\\x80{x}\"", "\\x80 is above ASCII in an f-string literal; write \\u{80} for the scalar", "P001")) {
    return 1916;
  }
  if (!lex_error_is("\"\\u{D800}\"", "\\u{D800} is a surrogate, not a Unicode scalar value", "P001")) {
    return 1917;
  }
  if (!lex_error_is("\"\\u{110000}\"", "\\u{110000} is above the maximum Unicode scalar 10FFFF", "P001")) {
    return 1918;
  }
  if (!lex_error_is("f\"\\u{1F600\"", "unterminated \\u{...} escape", "P001")) {
    return 1919;
  }
  if (!lex_error_is("'\\q'", "unknown escape \\q in character literal", "P001")) {
    return 1920;
  }
  return 0;
}

// string_is reports whether `src` lexes to one string token whose value is
// `want`.
function string_is(src: string, want: string): boolean {
  let t: Token[] = tokenize(src);
  if (t.len() != 2) {
    return false;
  }
  if let TokString(x) = t[0] {
    return x.value == want;
  }
  return false;
}

// test_string_escapes — a string and an f-string decode the escapes a
// character literal takes, each appended as UTF-8: `\xNN` stops at 0x7F and
// `\u{...}` reaches every Unicode scalar value. Mirrors the Go lexer's
// TestStringEscapes.
function test_string_escapes(): i32 {
  if (!string_is("\"a\\x41\\x7f\"", "aA\x7f")) {
    return 1930;
  }
  if (!string_is("\"\\0\\'\\\"\\\\\"", "\x00'\"\\")) {
    return 1931;
  }
  let top: string = string_from_bytes_unchecked([244 as u8, 143 as u8, 191 as u8, 191 as u8]);
  if (!string_is("\"\\u{41}\\u{e9}\\u{20AC}\\u{1F600}\\u{10FFFF}\"", "Aé€😀" + top)) {
    return 1932;
  }
  let edges: string = string_from_bytes_unchecked([237 as u8, 159 as u8, 191 as u8, 238 as u8, 128 as u8, 128 as u8]);
  if (!string_is("\"\\u{D7FF}\\u{E000}\"", edges)) {
    return 1933;
  }
  let ft: Token[] = tokenize("f\"\\u{1F600}{x}\\u{7B}\"");
  if let TokFString(f) = ft[0] {
    if (f.parts.len() != 3 || f.parts[0].lit != "😀" || f.parts[1].expr != "x" || f.parts[2].lit != "{") {
      return 1934;
    }
  } else {
    return 1935;
  }
  return 0;
}

// check_quoted — assert toks[0] is the number token a quoted literal
// lexes to, with the decoded scalar in `text`, the type in `suffix`
// and the spelling in `raw`.
function check_quoted(src: string, want_text: string, want_suffix: string): boolean {
  let t: Token[] = tokenize(src);
  if (t.len() != 2) {
    return false;
  }
  match (t[0]) {
    TokNumber(n) => {
      return n.text == want_text && n.suffix == want_suffix
        && n.raw == src && !n.is_float;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// test_quoted_literals — `'x'` (a `char`) and `b'x'` (a `u8`), the
// escape set each accepts, and every spelling rejected at lex time.
// Mirrors the Go lexer's TestCharAndByteLiterals /
// TestCharAndByteLiteralErrors.
function test_quoted_literals(): i32 {
  if (!check_quoted("'x'", "120", "char")) {
    return 1950;
  }
  if (!check_quoted("'['", "91", "char")) {
    return 1951;
  }
  if (!check_quoted("'\\n'", "10", "char")) {
    return 1952;
  }
  if (!check_quoted("'\\0'", "0", "char")) {
    return 1953;
  }
  if (!check_quoted("'\\''", "39", "char")) {
    return 1954;
  }
  if (!check_quoted("'\\\\'", "92", "char")) {
    return 1955;
  }
  if (!check_quoted("'\\x7F'", "127", "char")) {
    return 1956;
  }
  if (!check_quoted("'\\u{41}'", "65", "char")) {
    return 1957;
  }
  if (!check_quoted("'\\u{1F600}'", "128512", "char")) {
    return 1958;
  }
  if (!check_quoted("'\\u{10FFFF}'", "1114111", "char")) {
    return 1959;
  }
  if (!check_quoted("'😀'", "128512", "char")) {
    return 1960;
  }
  if (!check_quoted("'é'", "233", "char")) {
    return 1961;
  }
  if (!check_quoted("b'x'", "120", "u8")) {
    return 1962;
  }
  if (!check_quoted("b'['", "91", "u8")) {
    return 1963;
  }
  if (!check_quoted("b'\\n'", "10", "u8")) {
    return 1964;
  }
  if (!check_quoted("b'\\xFF'", "255", "u8")) {
    return 1965;
  }

  // Rejected at lex time, not left for the parser.
  if (!has_error(tokenize("''"))) {
    return 1970;
  }
  if (!has_error(tokenize("b''"))) {
    return 1971;
  }
  if (!has_error(tokenize("'ab'"))) {
    return 1972;
  }
  if (!has_error(tokenize("b'ab'"))) {
    return 1973;
  }
  if (!has_error(tokenize("'a"))) {
    return 1974;
  }
  if (!has_error(tokenize("b'é'"))) {
    return 1975;
  }
  if (!has_error(tokenize("b'\\u{41}'"))) {
    return 1976;
  }
  if (!has_error(tokenize("'\\u{D800}'"))) {
    return 1977;
  }
  if (!has_error(tokenize("'\\u{110000}'"))) {
    return 1978;
  }
  if (!has_error(tokenize("'\\xFF'"))) {
    return 1979;
  }
  if (!has_error(tokenize("'\\q'"))) {
    return 1980;
  }
  if (!has_error(tokenize("'\n'"))) {
    return 1981;
  }

  // A `b` not followed by `'` is an ordinary identifier.
  let idt: Token[] = tokenize("b bytes");
  match (idt[0]) {
    TokIdent(x) => {
      if (x.name != "b") {
        return 1990;
      }
    },
    _ => {
      return 1991;
    }
  }
  match (idt[1]) {
    TokIdent(x) => {
      if (x.name != "bytes") {
        return 1992;
      }
    },
    _ => {
      return 1993;
    }
  }
  return 0;
}

// check_part — assert one FStringPart matches the expected kind +
// text + position. `want_expr` selects which payload field to compare;
// a literal part carries no position, so both coordinates are 0 there.
function check_part(p: FStringPart, want_expr: boolean, want_text: string, want_line: i32, want_col: i32): boolean {
  if (p.is_expr != want_expr) {
    return false;
  }
  if (p.line != want_line || p.col != want_col) {
    return false;
  }
  if (want_expr) {
    return p.expr == want_text;
  }
  return p.lit == want_text;
}

// test_fstring — the f-string parts split + brace-escape + escape-
// sequence + nested-string handling, plus the four error shapes.
// Mirrors the Go lexer's TestFStringParts / TestFStringErrors.
function test_fstring(): i32 {
  // f"" → no parts.
  let t0: Token[] = tokenize("f\"\"");
  if (t0.len() != 2) {
    return 2000;
  }
  match (t0[0]) {
    TokFString(f) => {
      if (f.parts.len() != 0) {
        return 2001;
      }
    },
    _ => {
      return 2002;
    }
  }
  // f"plain" → [Lit "plain"].
  let t1: Token[] = tokenize("f\"plain\"");
  match (t1[0]) {
    TokFString(f) => {
      if (f.parts.len() != 1) {
        return 2010;
      }
      if (!check_part(f.parts[0], false, "plain", 0, 0)) {
        return 2011;
      }
    },
    _ => {
      return 2012;
    }
  }
  // f"a{x}b" → [Lit "a", Expr "x", Lit "b"].
  let t2: Token[] = tokenize("f\"a{x}b\"");
  match (t2[0]) {
    TokFString(f) => {
      if (f.parts.len() != 3) {
        return 2020;
      }
      if (!check_part(f.parts[0], false, "a", 0, 0)) {
        return 2021;
      }
      if (!check_part(f.parts[1], true, "x", 1, 5)) {
        return 2022;
      }
      if (!check_part(f.parts[2], false, "b", 0, 0)) {
        return 2023;
      }
    },
    _ => {
      return 2024;
    }
  }
  // f"{{lit}}" → [Lit "{lit}"] (brace escapes).
  let t3: Token[] = tokenize("f\"{{lit}}\"");
  match (t3[0]) {
    TokFString(f) => {
      if (f.parts.len() != 1) {
        return 2030;
      }
      if (!check_part(f.parts[0], false, "{lit}", 0, 0)) {
        return 2031;
      }
    },
    _ => {
      return 2032;
    }
  }
  // f"k={"x"}" → [Lit "k=", Expr "\"x\""] (inner string skipped
  // during the brace-matching scan).
  let t4: Token[] = tokenize("f\"k={\"x\"}\"");
  match (t4[0]) {
    TokFString(f) => {
      if (f.parts.len() != 2) {
        return 2040;
      }
      if (!check_part(f.parts[0], false, "k=", 0, 0)) {
        return 2041;
      }
      if (!check_part(f.parts[1], true, "\"x\"", 1, 6)) {
        return 2042;
      }
    },
    _ => {
      return 2043;
    }
  }
  // f"sum {a + b}" → [Lit "sum ", Expr "a + b"].
  let t5: Token[] = tokenize("f\"sum {a + b}\"");
  match (t5[0]) {
    TokFString(f) => {
      if (f.parts.len() != 2) {
        return 2050;
      }
      if (!check_part(f.parts[0], false, "sum ", 0, 0)) {
        return 2051;
      }
      if (!check_part(f.parts[1], true, "a + b", 1, 8)) {
        return 2052;
      }
    },
    _ => {
      return 2053;
    }
  }
  // f"hi\nthere" → [Lit "hi\nthere"] (escape in literal segment).
  let t6: Token[] = tokenize("f\"hi\\nthere\"");
  match (t6[0]) {
    TokFString(f) => {
      if (f.parts.len() != 1) {
        return 2060;
      }
      if (!check_part(f.parts[0], false, "hi\nthere", 0, 0)) {
        return 2061;
      }
    },
    _ => {
      return 2062;
    }
  }
  // Error shapes: unterminated, newline inside, bare `}`, empty `{}`.
  if (!has_error(tokenize("f\"unterminated"))) {
    return 2070;
  }
  if (!has_error(tokenize("f\"with\nnewline\""))) {
    return 2071;
  }
  if (!has_error(tokenize("f\"bare}brace\""))) {
    return 2072;
  }
  if (!has_error(tokenize("f\"empty{}\""))) {
    return 2073;
  }
  return 0;
}

// test_fstring_positions — each interpolant's own offset, and the
// rebase the parser applies to the sub-lex. Two interpolants are the
// discriminating case: rebasing onto the f-string's own start places
// the first plausibly and every later one short (#6989).
function test_fstring_positions(): i32 {
  let t: Token[] = tokenize("let s = f\"a{aaa} b{bbb}\";");
  match (t[3]) {
    TokFString(f) => {
      if (f.parts.len() != 4) {
        return 2080;
      }
      if (!check_part(f.parts[1], true, "aaa", 1, 13)) {
        return 2081;
      }
      if (!check_part(f.parts[3], true, "bbb", 1, 20)) {
        return 2082;
      }
    },
    _ => {
      return 2083;
    }
  }
  // An f-string on a later line keeps its own line number.
  match (tokenize("let a = 1;\nlet s = f\"x{yy}\";")[8]) {
    TokFString(f) => {
      if (!check_part(f.parts[1], true, "yy", 2, 13)) {
        return 2090;
      }
    },
    _ => {
      return 2091;
    }
  }
  // rebase_tokens shifts the column only on the fragment's first
  // line; a later line takes the fragment's own column.
  let sub: Token[] = rebase_tokens(tokenize("a\nb"), 4, 10);
  match (sub[0]) {
    TokIdent(x) => {
      if (x.line != 4 || x.col != 10) {
        return 2092;
      }
    },
    _ => {
      return 2093;
    }
  }
  match (sub[1]) {
    TokIdent(x) => {
      if (x.line != 5 || x.col != 1) {
        return 2094;
      }
    },
    _ => {
      return 2095;
    }
  }
  return 0;
}

// main runs every feature test in sequence and returns the first
// non-zero code. Exit code 0 means the Fern lexer port matches the
// Go lexer across mixed tokens, hex / scientific literals, the
// afterDot chained-tuple guard, suffix validation, and the error
// paths.
// test_comments — the `//` comment list. The fixture pins the three
// properties a doc/format consumer depends on: the text excludes the
// leading `//` and the trailing newline, the position points at the
// `//` itself (so a consumer can tell leading from trailing), and a
// `//` INSIDE a string literal is not a comment. That last one is why
// comments are collected in the lexer rather than by a separate scan.
function check_comment(c: Comment, line: i32, col: i32, text: string): boolean {
  return c.line == line && c.col == col && c.text == text;
}

function test_comments(): i32 {
  let src: string = "// leading\nlet u: string = \"http://x//y\"; // trailing\nlet n: i32 = 1;\n//: last\n";
  let r: LexResult = tokenize_full(src);
  if (r.comments.len() != 3) {
    return 2100;
  }
  if (!check_comment(r.comments[0], 1, 1, " leading")) {
    return 2101;
  }
  if (!check_comment(r.comments[1], 2, 32, " trailing")) {
    return 2102;
  }
  if (!check_comment(r.comments[2], 4, 1, ": last")) {
    return 2103;
  }
  // The token stream is unaffected by collecting comments.
  if (r.tokens.len() != tokenize(src).len()) {
    return 2104;
  }
  // A source with no comments yields an empty list, not a stray entry.
  if (tokenize_full("let x: i32 = 1;\n").comments.len() != 0) {
    return 2105;
  }
  // An unterminated string bails out of the loop early; the comments
  // seen before the failure still come back with the tokens.
  if (tokenize_full("// kept\nlet s: string = \"oops\n").comments.len() != 1) {
    return 2106;
  }
  // A comment that ends the source, with no newline after it, runs to the
  // end of the text.
  let tail: LexResult = tokenize_full("let x: i32 = 1; // tail");
  if (tail.comments.len() != 1 || !check_comment(tail.comments[0], 1, 17, " tail")) {
    return 2107;
  }
  return 0;
}

// test_multibyte — multibyte UTF-8 in string literals, f-string literal
// parts, and comments adjacent to the operator probes, plus a probe whose
// lookahead byte is a multibyte lead. The probes must match by byte, and
// the accumulated values must carry the multibyte content byte-exact.
function test_multibyte(): i32 {
  let src: string = "let s: string = \"héllo wörld\"; s <<= 1; // cömment é\nlet f = f\"pré {s} pöst\";\n";
  let r: LexResult = tokenize_full(src);
  let toks: Token[] = r.tokens;
  if (toks.len() != 17) {
    return 2200;
  }
  match (toks[5]) {
    TokString(t) => {
      if (t.value != "héllo wörld") {
        return 2201;
      }
    },
    _ => {
      return 2202;
    }
  }
  match (toks[8]) {
    TokPunct(t) => {
      if (t.text != "<<=") {
        return 2203;
      }
    },
    _ => {
      return 2204;
    }
  }
  match (toks[14]) {
    TokFString(t) => {
      if (t.parts.len() != 3) {
        return 2205;
      }
      if (t.parts[0].lit != "pré ") {
        return 2206;
      }
      if (t.parts[1].expr != "s") {
        return 2207;
      }
      if (t.parts[2].lit != " pöst") {
        return 2208;
      }
    },
    _ => {
      return 2209;
    }
  }
  if (r.comments.len() != 1) {
    return 2210;
  }
  if (r.comments[0].text != " cömment é") {
    return 2211;
  }
  // A 2-byte operator probe whose lookahead byte is a multibyte lead
  // falls back to the single `<`; the é itself is not a token.
  let t2: Token[] = tokenize("a<é");
  if (t2.len() != 3) {
    return 2212;
  }
  match (t2[1]) {
    TokPunct(t) => {
      if (t.text != "<") {
        return 2213;
      }
    },
    _ => {
      return 2214;
    }
  }
  match (t2[2]) {
    TokError(t) => {
      if (t.msg != "unexpected character 'é'") {
        return 2215;
      }
    },
    _ => {
      return 2216;
    }
  }
  return 0;
}

function main(): i32 {
  let c: i32 = 0;
  c = test_mixed();
  if (c != 0) {
    return c;
  }
  c = test_hex();
