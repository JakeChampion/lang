import "std/unicode";
import "std/utf8";
import "./util";

pub struct TokEof { line: i32, col: i32 }

// The low four bits hold the suffix tag. Bit four marks a float.
pub struct TokNumber { text: string, raw: string, flags: u8, line: i32, col: i32 }

pub struct TokIdent { name: string, line: i32, col: i32 }

pub struct TokKeyword { name: string, line: i32, col: i32 }

pub struct TokPunct { text: string, line: i32, col: i32 }

pub struct TokString { value: string, line: i32, col: i32 }

pub struct TokError { msg: string, code: string, line: i32, col: i32 }

pub struct FStringPart { lit: string, expr: string, is_expr: boolean, line: i32, col: i32 }

pub struct TokFString { parts: FStringPart[], line: i32, col: i32 }

pub type Token = TokEof | TokNumber | TokIdent | TokKeyword | TokPunct | TokString | TokError | TokFString;

pub function is_saturating_op(op: string): boolean {
  return op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

function is_digit(b: i32): boolean {
  return b >= 48 && b <= 57;
}

function is_alpha(b: i32): boolean {
  return b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 95;
}

pub function is_alphanumeric(b: i32): boolean {
  return is_digit(b) || is_alpha(b);
}

pub function is_hex_digit(b: i32): boolean {
  return b >= 48 && b <= 57 || b >= 97 && b <= 102 || b >= 65 && b <= 70;
}

function hex_val(b: i32): i32 {
  if (b >= 48 && b <= 57) {
    return b - 48;
  }
  if (b >= 97 && b <= 102) {
    return b - 97 + 10;
  }
  if (b >= 65 && b <= 70) {
    return b - 65 + 10;
  }
  return 0;
}

function is_space(b: i32): boolean {
  return b == 32 || b >= 9 && b <= 13;
}

function is_suffix_start(b: i32): boolean {
  return b == 105 || b == 117 || b == 102;
}

// fern-lint: allow cyclomatic-complexity
function is_keyword(name: string): boolean {
  if (name.len() < 2 || name.len() > 8) {
    return false;
  }
  let c = name[0];
  if (c == b'f') {
    return name == "function" || name == "for" || name == "false" || name == "f32" || name == "f64" || name == "f32x4" || name == "f64x2";
  }
  if (c == b'i') {
    return name == "if" || name == "i32" || name == "i64" || name == "import" || name == "impl";
  }
  if (c == b'u') {
    return name == "use" || name == "u8" || name == "u32" || name == "u64" || name == "usize";
  }
  if (c == b'e') {
    return name == "else" || name == "enum" || name == "errdefer";
  }
  if (c == b'd') {
    return name == "defer" || name == "dyn";
  }
  if (c == b't') {
    return name == "true" || name == "type" || name == "trait";
  }
  if (c == b'b') {
    return name == "break" || name == "boolean";
  }
  if (c == b'c') {
    return name == "continue" || name == "const";
  }
  if (c == b'l') {
    return name == "let" || name == "loop";
  }
  if (c == b's') {
    return name == "string" || name == "struct";
  }
  if (c == b'w') {
    return name == "while" || name == "when";
  }
  if (c == b'r') {
    return name == "return";
  }
  if (c == b'v') {
    return name == "void";
  }
  if (c == b'a') {
    return name == "as";
  }
  if (c == b'p') {
    return name == "pub";
  }
  if (c == b'm') {
    return name == "match";
  }
  return false;
}

pub function keywords(): string[] {
  return ["as", "boolean", "break", "const", "continue", "defer", "dyn", "else", "enum", "errdefer", "f32", "f32x4", "f64", "f64x2", "false", "for", "function", "i32", "i64", "if", "impl", "import", "let", "loop", "match", "pub", "return", "string", "struct", "trait", "true", "type", "u32", "u64", "u8", "use", "usize", "void", "when", "while"];
}

const NUMERIC_SUFFIXES: string[] = ["", "i32", "i64", "u8", "u32", "u64", "usize", "f32", "f64", "char"];

function numeric_suffix_tag(s: string): u8 {
  if (s == "i32") {
    return 1u8;
  }
  if (s == "i64") {
    return 2u8;
  }
  if (s == "u8") {
    return 3u8;
  }
  if (s == "u32") {
    return 4u8;
  }
  if (s == "u64") {
    return 5u8;
  }
  if (s == "usize") {
    return 6u8;
  }
  if (s == "f32") {
    return 7u8;
  }
  if (s == "f64") {
    return 8u8;
  }
  if (s == "char") {
    return 9u8;
  }
  return 0u8;
}

function numeric_flags(suffix: u8, is_float: boolean): u8 {
  if (is_float) {
    return suffix | 16u8;
  }
  return suffix;
}

pub function (t: TokNumber) suffix(): string {
  let tag = (t.flags & 15u8) as i32;
  if (tag < NUMERIC_SUFFIXES.len()) {
    return NUMERIC_SUFFIXES[tag];
  }
  return "";
}

pub function (t: TokNumber) is_float(): boolean {
  return (t.flags & 16u8) != 0u8;
}

function suffix_end(src: string, i: i32, n: i32): i32 {
  if (i + 5 <= n && slice_unchecked(src, i, i + 5) == "usize") {
    return i + 5;
  }
  let e = i + 1;
  while (e < n && is_digit(src[e] as i32)) {
    e += 1;
  }
  return e;
}

function digit_run_end(src: string, i: i32, n: i32, base: i32, separators: boolean): i32 {
  let e = i;
  while (e < n) {
    let c = src[e] as i32;
    if (is_base_digit(c, base)) {
      e += 1;
    } else if (separators && c == 95 && e > i && e + 1 < n
      && (is_base_digit(src[e + 1] as i32, base) || base < 10 && is_digit(src[e + 1] as i32))) {
      e += 1;
    } else {
      return e;
    }
  }
  return e;
}

function is_base_digit(c: i32, base: i32): boolean {
  if (base == 16) {
    return is_hex_digit(c);
  }
  return is_digit(c) && c - 48 < base;
}

function misplaced_separator(src: string, begin: i32, end: i32, n: i32): boolean {
  return end > begin && end < n && src[end] == b'_';
}

function without_separators(text: string): string {
  if (__memchr(text, 95, 0) < 0) {
    return text;
  }
  let out = "";
  let from = 0;
  for at in 0..text.len() {
    if (text[at] == b'_') {
      out += slice_unchecked(text, from, at);
      from = at + 1;
    }
  }
  return out + slice_unchecked(text, from, text.len());
}

function separator_message(): string {
  return "a digit separator '_' must sit between two digits";
}

function match_multipunct(src: string, i: i32, n: i32): string {
  if (i >= n) {
    return "";
  }
  let b0 = src[i] as i32;
  let b1: i32 = -1;
  if (i + 1 < n) {
    b1 = src[i + 1] as i32;
  }
  let b2: i32 = -1;
  if (i + 2 < n) {
    b2 = src[i + 2] as i32;
  }
  let three = punct3(b0, b1, b2);
  if (three.len() > 0) {
    return three;
  }
  if (b1 == 61) {
    return punct_assign(b0);
  }
  if (b1 == 124) {
    return punct_bar(b0);
  }
  if (b1 == 63) {
    return punct_try(b0);
  }
  if (b1 == 62) {
    return punct_arrow(b0);
  }
  return punct_double(b0, b1);
}

function punct3(b0: i32, b1: i32, b2: i32): string {
  if (b0 == 60 && b1 == 60) {
    if (b2 == 61) {
      return "<<=";
    }
    if (b2 == 124) {
      return "<<|";
    }
    if (b2 == 63) {
      return "<<?";
    }
  } else if (b0 == 62 && b1 == 62) {
    if (b2 == 61) {
      return ">>=";
    }
    if (b2 == 63) {
      return ">>?";
    }
  } else if (b0 == 46 && b1 == 46) {
    if (b2 == 46) {
      return "...";
    }
    if (b2 == 61) {
      return "..=";
    }
  }
  return "";
}

function punct_assign(b0: i32): string {
  if (b0 == 61) {
    return "==";
  }
  if (b0 == 33) {
    return "!=";
  }
  if (b0 == 60) {
    return "<=";
  }
  if (b0 == 62) {
    return ">=";
  }
  if (b0 == 43) {
    return "+=";
  }
  if (b0 == 45) {
    return "-=";
  }
  if (b0 == 42) {
    return "*=";
  }
  if (b0 == 47) {
    return "/=";
  }
  if (b0 == 37) {
    return "%=";
  }
  if (b0 == 38) {
    return "&=";
  }
  if (b0 == 124) {
    return "|=";
  }
  if (b0 == 94) {
    return "^=";
  }
  return "";
}

function punct_bar(b0: i32): string {
  if (b0 == 43) {
    return "+|";
  }
  if (b0 == 45) {
    return "-|";
  }
  if (b0 == 42) {
    return "*|";
  }
  if (b0 == 124) {
    return "||";
  }
  return "";
}

function punct_try(b0: i32): string {
  if (b0 == 43) {
    return "+?";
  }
  if (b0 == 45) {
    return "-?";
  }
  if (b0 == 42) {
    return "*?";
  }
  if (b0 == 47) {
    return "/?";
  }
  if (b0 == 37) {
    return "%?";
  }
  return "";
}

function punct_arrow(b0: i32): string {
  if (b0 == 61) {
    return "=>";
  }
  if (b0 == 124) {
    return "|>";
  }
  if (b0 == 62) {
    return ">>";
  }
  return "";
}

function punct_double(b0: i32, b1: i32): string {
  if (b0 != b1) {
    return "";
  }
  if (b0 == 60) {
    return "<<";
  }
  if (b0 == 46) {
    return "..";
  }
  if (b0 == 58) {
    return "::";
  }
  if (b0 == 38) {
    return "&&";
  }
  return "";
}

// PUNCT_TEXTS holds the text of each one-byte punctuation token.
// PUNCT_SLOT[b] is one more than the index of the byte b in PUNCT_TEXTS, or 0.
const PUNCT_SLOT: u8[] = [
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 9u8, 0u8, 0u8, 0u8, 5u8, 11u8, 0u8, 15u8, 16u8, 3u8, 1u8, 21u8, 2u8, 24u8, 4u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 23u8, 22u8, 7u8, 6u8, 8u8, 14u8,
  25u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 19u8, 0u8, 20u8, 13u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 17u8, 12u8, 18u8, 10u8, 0u8,
];

const PUNCT_TEXTS: string[] = ["+", "-", "*", "/", "%", "=", "<", ">", "!", "~", "&", "|", "^", "?", "(", ")", "{", "}", "[", "]", ",", ";", ":", ".", "@"];

function single_punct(b: i32): string {
  if (b < 0 || b >= PUNCT_SLOT.len()) {
    return "";
  }
  let k = PUNCT_SLOT[b] as i32;
  if (k == 0) {
    return "";
  }
  return PUNCT_TEXTS[k - 1];
}

pub struct Comment { line: i32, col: i32, text: string, trailing: boolean }

function code_before(src: string, i: i32): boolean {
  let j = i - 1;
  while (j >= 0 && src[j] != b'\n') {
    if (src[j] != b' ' && src[j] != b'\t' && src[j] != b'\r' && src[j] != 11u8 && src[j] != 12u8) {
      return true;
    }
    j -= 1;
  }
  return false;
}

function comment_tok(line: i32, col: i32, text: string, trailing: boolean): Comment {
  return Comment { line: line, col: col, text: text, trailing: trailing };
}

pub struct LexResult { tokens: Token[], comments: Comment[] }

struct Lex { src: string, i: i32, n: i32, line: i32, col: i32, comments: Comment[] }

function (l: Lex) at_end(): boolean {
  return l.i >= l.n;
}

function (l: Lex) peek_byte(): i32 {
  if (l.i >= l.n) {
    return 0;
  }
  return l.src[l.i] as i32;
}

function (own l: Lex) advance(): Lex {
  if (l.i >= l.n) {
    return l;
  }
  if (l.src[l.i] == b'\n') {
    return Lex { ...l, i: l.i + 1, line: l.line + 1, col: 1 };
  }
  return Lex { ...l, i: l.i + 1, col: l.col + 1 };
}

function (own l: Lex) advance_in_line(end: i32): Lex {
  if (end <= l.i) {
    return l;
  }
  return Lex { ...l, i: end, col: l.col + (end - l.i) };
}

function (own l: Lex) skip(k: i32): Lex {
  return Lex { ...l, i: l.i + k, col: l.col + k };
}

function skip_trivia(own l: Lex, keep: boolean): Lex {
  let i = l.i;
  let line = l.line;
  let col = l.col;
  while (i < l.n) {
    let b = l.src[i] as i32;
    if (b == 10) {
      line += 1;
      col = 1;
      i += 1;
    } else if (is_space(b)) {
      col += 1;
      i += 1;
    } else if (b == 47 && i + 1 < l.n && l.src[i + 1] == b'/') {
      let ce = __memchr(l.src, 10, i + 2);
      if (ce < 0) {
        ce = l.n;
      }
      if (keep) {
        l = Lex { ...l, comments: l.comments.append(comment_tok(line, col, slice_unchecked(l.src, i + 2, ce), code_before(l.src, i))) };
      }
      col += ce - i;
      i = ce;
    } else {
      break;
    }
  }
  if (i == l.i) {
    return l;
  }
  return Lex { ...l, i: i, line: line, col: col };
}

struct NumResult { lex: Lex, tok: Token }

pub function eof_tok(line: i32, col: i32): Token {
  return TokEof { line: line, col: col };
}

pub function string_tok(value: string, line: i32, col: i32): Token {
  return TokString { value: value, line: line, col: col };
}

pub function ident_tok(name: string, line: i32, col: i32): Token {
  return TokIdent { name: name, line: line, col: col };
}

pub function keyword_tok(name: string, line: i32, col: i32): Token {
  return TokKeyword { name: name, line: line, col: col };
}

pub function punct_tok(text: string, line: i32, col: i32): Token {
  return TokPunct { text: text, line: line, col: col };
}

pub function number_tok(text: string, suffix: string, is_float: boolean, line: i32, col: i32): Token {
  return TokNumber { text: text, raw: "", flags: numeric_flags(numeric_suffix_tag(suffix), is_float), line: line, col: col };
}

pub function quoted_tok(text: string, suffix: string, raw: string, line: i32, col: i32): Token {
  return TokNumber { text: text, raw: raw, flags: numeric_suffix_tag(suffix), line: line, col: col };
}

pub function error_tok(msg: string, line: i32, col: i32): Token {
  return TokError { msg: msg, code: "P001", line: line, col: col };
}

function num_error_tok(msg: string, line: i32, col: i32): Token {
  return TokError { msg: msg, code: "P002", line: line, col: col };
}

pub function fstring_tok(parts: FStringPart[], line: i32, col: i32): Token {
  return TokFString { parts: parts, line: line, col: col };
}

function offset_line(base_line: i32, line: i32): i32 {
  if (line <= 1) {
    return base_line;
  }
  return base_line + line - 1;
}

function offset_col(base_col: i32, line: i32, col: i32): i32 {
  if (line <= 1) {
    return base_col + col - 1;
  }
  return col;
}

function rebase_parts(parts: FStringPart[], base_line: i32, base_col: i32): FStringPart[] {
  let out: FStringPart[] = [];
  let i = 0;
  while (i < parts.len()) {
    let p = parts[i];
    if (p.is_expr) {
      out = out.append(FStringPart {
        lit: p.lit, expr: p.expr, is_expr: true,
        line: offset_line(base_line, p.line), col: offset_col(base_col, p.line, p.col),
      });
    } else {
      out = out.append(p);
    }
    i += 1;
  }
  return out;
}

pub function rebase_tokens(toks: Token[], base_line: i32, base_col: i32): Token[] {
  let out: Token[] = [];
  let i = 0;
  while (i < toks.len()) {
    let t = toks[i];
    match (t) {
      TokEof(x) => {
        out = out.append(eof_tok(offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokNumber(x) => {
        out = out.append(TokNumber { ...x, line: offset_line(base_line, x.line), col: offset_col(base_col, x.line, x.col) });
      },
      TokIdent(x) => {
        out = out.append(ident_tok(x.name, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokKeyword(x) => {
        out = out.append(keyword_tok(x.name, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokPunct(x) => {
        out = out.append(punct_tok(x.text, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokString(x) => {
        out = out.append(string_tok(x.value, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      },
      TokError(x) => {
        out = out.append(TokError { msg: x.msg, code: x.code, line: offset_line(base_line, x.line), col: offset_col(base_col, x.line, x.col) });
      },
      TokFString(x) => {
        out = out.append(fstring_tok(rebase_parts(x.parts, base_line, base_col), offset_line(base_line, x.line), offset_col(base_col, x.line, x.col)));
      }
    }
    i += 1;
  }
  return out;
}

function is_blank_range(s: string): boolean {
  let i = 0;
  while (i < s.len()) {
    if (!is_space(s[i] as i32)) {
      return false;
    }
    i += 1;
  }
  return true;
}

pub function is_error_tok(t: Token): boolean {
  match (t) {
    TokError(_) => {
      return true;
    },
    _ => {
      return false;
    }
  }
}

pub function has_error(toks: Token[]): boolean {
  let i = 0;
  while (i < toks.len()) {
    if (is_error_tok(toks[i])) {
      return true;
    }
    i += 1;
  }
  return false;
}

function scan_number(own l: Lex, after_dot: boolean, start_line: i32, start_col: i32): NumResult {
  let begin = l.i;
  let is_hex = false;
  if (l.peek_byte() == 48 && l.i + 1 < l.n
    && (l.src[l.i + 1] == b'x' || l.src[l.i + 1] == b'X')) {
    is_hex = true;
    l = l.skip(2);
    let hex_start = l.i;
    let run_end = digit_run_end(l.src, l.i, l.n, 16, true);
    l = l.advance_in_line(run_end);
    if (misplaced_separator(l.src, hex_start, l.i, l.n)) {
      return NumResult { lex: l, tok: num_error_tok(separator_message(), start_line, start_col) };
    }
    if (l.i == hex_start) {
      return NumResult { lex: l, tok: num_error_tok("hex literal needs at least one digit after 0x", start_line, start_col) };
    }
  } else if (radix_prefix(l.src, l.i, l.n) != 0) {
    let base = radix_prefix(l.src, l.i, l.n);
    return scan_radix_number(l, base, start_line, start_col);
  } else {
    let int_start = l.i;
    let run_end = digit_run_end(l.src, l.i, l.n, 10, !after_dot);
    l = l.advance_in_line(run_end);
    if (!after_dot && misplaced_separator(l.src, int_start, l.i, l.n)) {
      return NumResult { lex: l, tok: num_error_tok(separator_message(), start_line, start_col) };
    }
  }
  let is_float = false;
  if (!is_hex && !after_dot && l.i + 1 < l.n && l.src[l.i] == b'.' && is_digit(l.src[l.i + 1] as i32)) {
    is_float = true;
    l = l.skip(1);
    let frac_start = l.i;
    let run_end = digit_run_end(l.src, l.i, l.n, 10, true);
    l = l.advance_in_line(run_end);
    if (misplaced_separator(l.src, frac_start, l.i, l.n)) {
      return NumResult { lex: l, tok: num_error_tok(separator_message(), start_line, start_col) };
    }
  }
  if (!is_hex && !after_dot && !l.at_end()
    && (l.peek_byte() == 101 || l.peek_byte() == 69)) {
    let j = l.i + 1;
    if (j < l.n && (l.src[j] == b'+' || l.src[j] == b'-')) {
      j += 1;
    }
    if (j < l.n && is_digit(l.src[j] as i32)) {
      is_float = true;
      l = l.skip(1);
      if (!l.at_end() && (l.peek_byte() == 43 || l.peek_byte() == 45)) {
        l = l.skip(1);
      }
      let exp_start = l.i;
      let run_end = digit_run_end(l.src, l.i, l.n, 10, true);
      l = l.advance_in_line(run_end);
      if (misplaced_separator(l.src, exp_start, l.i, l.n)) {
        return NumResult { lex: l, tok: num_error_tok(separator_message(), start_line, start_col) };
      }
    }
  }
  let text = slice_unchecked(l.src, begin, l.i);
  let suffix = "";
  let suffix_tag = 0u8;
  if (!l.at_end() && is_suffix_start(l.peek_byte())) {
    let s_begin = l.i;
    let run_end = suffix_end(l.src, l.i, l.n);
    l = l.advance_in_line(run_end);
    suffix = slice_unchecked(l.src, s_begin, l.i) + "";
    suffix_tag = numeric_suffix_tag(suffix);
    if (suffix_tag == 0u8) {
      return NumResult { lex: l, tok: num_error_tok("unknown numeric suffix " + util.quoted(suffix) + " on " + util.quoted(text + ""), start_line, start_col) };
    }
    if (is_float && suffix[0] != b'f') {
      return NumResult { lex: l, tok: num_error_tok("integer suffix " + util.quoted(suffix) + " on float literal " + util.quoted(text + ""), start_line, start_col) };
    }
  }
  if (!is_float && suffix.len() > 0 && suffix[0] == b'f') {
    is_float = true;
  }
  let spelled = text + "";
  let digits = without_separators(spelled);
  if (digits.len() != spelled.len()) {
    let raw = slice_unchecked(l.src, begin, l.i) + "";
    return NumResult { lex: l, tok: TokNumber { text: digits, raw: raw, flags: numeric_flags(suffix_tag, is_float), line: start_line, col: start_col } };
  }
  let tok: Token = TokNumber { text: digits, raw: "", flags: numeric_flags(suffix_tag, is_float), line: start_line, col: start_col };
  return NumResult { lex: l, tok: tok };
}

function radix_prefix(src: string, i: i32, n: i32): i32 {
  if (src[i] != b'0' || i + 1 >= n) {
    return 0;
  }
  let c = src[i + 1];
  if (c == b'o' || c == b'O') {
    return 8;
  }
  if (c == b'b' || c == b'B') {
    return 2;
  }
  return 0;
}

function scan_radix_number(own l0: Lex, base: i32, start_line: i32, start_col: i32): NumResult {
  let l = l0;
  let begin = l.i;
  let prefix = slice_unchecked(l.src, l.i, l.i + 2) + "";
  l = l.skip(2);
  let digits: i32[] = [];
  let e = digit_run_end(l.src, l.i, l.n, base, true);
  for at in l.i..e {
    if (l.src[at] != b'_') {
      digits = digits.append(l.src[at] as i32 - 48);
    }
  }
  let run_start = l.i;
  l = l.advance_in_line(e);
  if (misplaced_separator(l.src, run_start, l.i, l.n)) {
    return NumResult { lex: l, tok: num_error_tok(separator_message(), start_line, start_col) };
  }
  if (digits.len() == 0) {
    return NumResult { lex: l, tok: num_error_tok("integer literal needs at least one digit after " + prefix, start_line, start_col) };
  }
  if (!l.at_end() && is_digit(l.peek_byte())) {
    return NumResult { lex: l, tok: num_error_tok("invalid digit " + quote_char(l.src, l.i, l.n) + " in a " + prefix + " literal", start_line, start_col) };
  }
  let suffix = "";
  let suffix_tag = 0u8;
  if (!l.at_end() && is_suffix_start(l.peek_byte())) {
    let s_begin = l.i;
    let run_end = suffix_end(l.src, l.i, l.n);
    l = l.advance_in_line(run_end);
    suffix = slice_unchecked(l.src, s_begin, l.i) + "";
    suffix_tag = numeric_suffix_tag(suffix);
    if (suffix_tag == 0u8 || suffix[0] == b'f') {
      return NumResult { lex: l, tok: num_error_tok("unknown numeric suffix " + util.quoted(suffix) + " on " + util.quoted(slice_unchecked(l.src, begin, s_begin) + ""), start_line, start_col) };
    }
  }
  let raw = slice_unchecked(l.src, begin, l.i) + "";
  return NumResult { lex: l, tok: TokNumber { text: radix_digits_hex(digits, base), raw: raw, flags: suffix_tag, line: start_line, col: start_col } };
}

function radix_digits_hex(digits: i32[], base: i32): string {
  let cur = digits;
  let hex = "";
  let hexch = "0123456789abcdef";
  while (cur.len() > 0) {
    let next: i32[] = [];
    let rem = 0;
    for d in cur {
      let acc = rem * base + d;
      let q = acc / 16;
      rem = acc % 16;
      if (next.len() > 0 || q != 0) {
        next = next.append(q);
      }
    }
    hex = slice_unchecked(hexch, rem, rem + 1) + hex;
    cur = next;
  }
  return "0x" + hex;
}

pub const NOT_IDENT: u8[] = [
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 1u8, 1u8, 0u8,
  1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
  1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
];

function ident_end(l: Lex): i32 {
  return __scan_set(l.src, l.i, NOT_IDENT);
}

function ident_or_keyword(name: string, start_line: i32, start_col: i32): Token {
  if (is_keyword(name)) {
    return keyword_tok(name, start_line, start_col);
  }
  return ident_tok(name, start_line, start_col);
}

function dec_str(v: i32): string {
  if (v == 0) {
    return "0";
  }
  let rev: u8[] = [];
  while (v > 0) {
    rev = rev.append((48 + v % 10) as u8);
    v /= 10;
  }
  let out = "";
  let i = rev.len() - 1;
  while (i >= 0) {
    unsafe {
      out += string_from_bytes_unchecked([rev[i]]);
    }
    i -= 1;
  }
  return out;
}

struct Utf8 { val: i32, len: i32 }

function decode_utf8(src: string, i: i32, n: i32): Utf8 {
  let b0 = src[i] as i32;
  if (b0 < 128) {
    return Utf8 { val: b0, len: 1 };
  }
  let need = 0;
  let val = 0;
  if (b0 >= 240 && b0 <= 244) {
    need = 3;
    val = b0 & 7;
  } else if (b0 >= 224 && b0 < 240) {
    need = 2;
    val = b0 & 15;
  } else if (b0 >= 194 && b0 < 224) {
    need = 1;
    val = b0 & 31;
  } else {
    return Utf8 { val: 0, len: 0 };
  }
  if (i + need >= n) {
    return Utf8 { val: 0, len: 0 };
  }
  let k = 1;
  while (k <= need) {
    let c = src[i + k] as i32;
    if (c < 128 || c >= 192) {
      return Utf8 { val: 0, len: 0 };
    }
    val = val << 6 | c & 63;
    k += 1;
  }
  if (val > 1114111 || val >= 55296 && val <= 57343
    || need == 1 && val < 128 || need == 2 && val < 2048
    || need == 3 && val < 65536) {
    return Utf8 { val: 0, len: 0 };
  }
  return Utf8 { val: val, len: need + 1 };
}

function rune_of_byte(b: i32): string {
  if (b < 128) {
    unsafe {
      return string_from_bytes_unchecked([b as u8]);
    }
  }
  unsafe {
    return string_from_bytes_unchecked([(192 | b >> 6) as u8, (128 | b & 63) as u8]);
  }
}

function quote_char(src: string, i: i32, n: i32): string {
  let b = src[i] as i32;
  if (b == 39 || b == 92) {
    unsafe {
      return "'\\" + string_from_bytes_unchecked([b as u8]) + "'";
    }
  }
  if (b >= 32 && b < 127) {
    unsafe {
      return "'" + string_from_bytes_unchecked([b as u8]) + "'";
    }
  }
  if (b < 128) {
    return "'" + control_escape(b) + "'";
  }
  return "'" + slice_unchecked(src, i, i + decode_utf8(src, i, n).len) + "'";
}

function control_escape(b: i32): string {
  if (b == 7) {
    return "\\a";
  }
  if (b == 8) {
    return "\\b";
  }
  return "\\x" + hex_digit(b >> 4, "0123456789abcdef") + hex_digit(b & 15, "0123456789abcdef");
}

function hex_digit(d: i32, digits: string): string {
  return slice_unchecked(digits, d, d + 1) + "";
}

function bad_char_message(src: string, i: i32, n: i32): string {
  let b = src[i] as i32;
  if (b >= 128 && decode_utf8(src, i, n).len == 0) {
    return "invalid UTF-8 byte 0x" + hex_digit(b >> 4, "0123456789ABCDEF") + hex_digit(b & 15, "0123456789ABCDEF");
  }
  let ch = decode_utf8(src, i, n).val as char;
  if (ch.is_letter() || ch.is_digit()) {
    return "identifiers must be ASCII; found " + quote_char(src, i, n);
  }
  return "unexpected character " + quote_char(src, i, n);
}

pub function decode_source(bytes: u8[]): Result[string, TokError] {
  let src = "";
  unsafe {
    src = string_from_bytes_unchecked(bytes);
  }
  if (utf8.is_valid(src)) {
    return Ok(src);
  }
  let i = 0;
  let line = 1;
  let col = 1;
  while (i < src.len()) {
    let rune = decode_utf8(src, i, src.len());
    if (rune.len == 0) {
      return Err(TokError { msg: bad_char_message(src, i, src.len()), code: "P001", line: line, col: col });
    }
    if (rune.val == 10) {
      line += 1;
      col = 1;
    } else {
      col += rune.len;
    }
    i += rune.len;
  }
  return Err(TokError { msg: "invalid UTF-8 source", code: "P001", line: 1, col: 1 });
}

struct EscVal { lex: Lex, val: i32, err: string }

function quoted_escape(own l: Lex, is_byte: boolean, kind_name: string): EscVal {
  l = l.advance();
  if (l.at_end()) {
    return EscVal { lex: l, val: 0, err: "unterminated " + kind_name + " literal" };
  }
  let esc = l.peek_byte();
  l = l.advance();
  if (esc == 110) {
    return EscVal { lex: l, val: 10, err: "" };
  }
  if (esc == 116) {
    return EscVal { lex: l, val: 9, err: "" };
  }
  if (esc == 114) {
    return EscVal { lex: l, val: 13, err: "" };
  }
  if (esc == 48) {
    return EscVal { lex: l, val: 0, err: "" };
  }
  if (esc == 92) {
    return EscVal { lex: l, val: 92, err: "" };
  }
  if (esc == 39) {
    return EscVal { lex: l, val: 39, err: "" };
  }
  if (esc == 34) {
    return EscVal { lex: l, val: 34, err: "" };
  }
  if (esc == 120) {
    return hex_escape(l, is_byte, kind_name);
  }
  if (esc == 117) {
    if (is_byte) {
      return EscVal { lex: l, val: 0, err: "\\u{...} is a Unicode scalar; a byte literal takes \\xNN" };
    }
    return unicode_escape(l);
  }
  return EscVal { lex: l, val: 0, err: "unknown escape \\" + rune_of_byte(esc) + " in " + kind_name + " literal" };
}

function hex_escape(own l: Lex, is_byte: boolean, kind_name: string): EscVal {
  if (l.i + 1 >= l.n || !is_hex_digit(l.src[l.i] as i32) || !is_hex_digit(l.src[l.i + 1] as i32)) {
    return EscVal { lex: l, val: 0, err: "\\x escape needs two hex digits" };
  }
  let v = hex_val(l.src[l.i] as i32) * 16 + hex_val(l.src[l.i + 1] as i32);
  l = l.advance();
  l = l.advance();
  if (!is_byte && v > 127) {
    let hx = upper_hex(v);
    return EscVal { lex: l, val: 0, err: "\\x" + hx + " is above ASCII in " + literal_name(kind_name) + "; write \\u{" + hx + "} for the scalar" };
  }
  return EscVal { lex: l, val: v, err: "" };
}

function literal_name(kind_name: string): string {
  if (kind_name == "f-string") {
    return "an f-string literal";
  }
  return "a " + kind_name + " literal";
}

function unicode_escape(own l: Lex): EscVal {
  if (l.at_end() || l.peek_byte() != 123) {
    return EscVal { lex: l, val: 0, err: "\\u escape needs braces: \\u{1F600}" };
  }
  l = l.advance();
  let digits = 0;
  let uv = 0;
  while (!l.at_end() && is_hex_digit(l.peek_byte())) {
    if (digits == 6) {
      return EscVal { lex: l, val: 0, err: "\\u{...} takes at most 6 hex digits" };
    }
    uv = uv * 16 + hex_val(l.peek_byte());
    digits += 1;
    l = l.advance();
  }
  if (digits == 0) {
    return EscVal { lex: l, val: 0, err: "\\u{...} needs at least one hex digit" };
  }
  if (l.at_end() || l.peek_byte() != 125) {
    return EscVal { lex: l, val: 0, err: "unterminated \\u{...} escape" };
  }
  l = l.advance();
  if (uv > 1114111) {
    return EscVal { lex: l, val: 0, err: "\\u{" + upper_hex(uv) + "} is above the maximum Unicode scalar 10FFFF" };
  }
  if (uv >= 55296 && uv <= 57343) {
    return EscVal { lex: l, val: 0, err: "\\u{" + upper_hex(uv) + "} is a surrogate, not a Unicode scalar value" };
  }
  return EscVal { lex: l, val: uv, err: "" };
}

function upper_hex(v: i32): string {
  let out = hex_digit(v & 15, "0123456789ABCDEF");
  v = v >> 4;
  while (v > 0 || out.len() < 2) {
    out = hex_digit(v & 15, "0123456789ABCDEF") + out;
    v = v >> 4;
  }
  return out;
}

function utf8_encode(v: i32): string {
  if (v < 128) {
    unsafe {
      return string_from_bytes_unchecked([v as u8]);
    }
  }
  if (v < 2048) {
    unsafe {
      return string_from_bytes_unchecked([(192 | v >> 6) as u8, (128 | v & 63) as u8]);
    }
  }
  if (v < 65536) {
    unsafe {
      return string_from_bytes_unchecked([(224 | v >> 12) as u8, (128 | v >> 6 & 63) as u8, (128 | v & 63) as u8]);
    }
  }
  unsafe {
    return string_from_bytes_unchecked([(240 | v >> 18) as u8, (128 | v >> 12 & 63) as u8, (128 | v >> 6 & 63) as u8, (128 | v & 63) as u8]);
  }
}

function closing_quote_ahead(l: Lex): boolean {
  let j = l.i;
  while (j < l.n && l.src[j] != b'\n') {
    if (l.src[j] == b'\'') {
      return true;
    }
    j += 1;
  }
  return false;
}

function scan_quoted(own l: Lex, is_byte: boolean, start_line: i32, start_col: i32): NumResult {
  let begin = l.i;
  let kind_name = "character";
  let suffix = "char";
  if (is_byte) {
    kind_name = "byte";
    suffix = "u8";
    l = l.advance();
  }
  l = l.advance();
  if (l.at_end()) {
    return NumResult { lex: l, tok: error_tok("unterminated " + kind_name + " literal", start_line, start_col) };
  }
  let c = l.peek_byte();
  if (c == 39) {
    l = l.advance();
    return NumResult { lex: l, tok: error_tok("empty " + kind_name + " literal", start_line, start_col) };
  }
  if (c == 10) {
    return NumResult { lex: l, tok: error_tok("newline inside " + kind_name + " literal", start_line, start_col) };
  }
  let val = 0;
  if (c == 92) {
    let ev = quoted_escape(l, is_byte, kind_name);
    l = ev.lex;
    if (ev.err.len() > 0) {
      return NumResult { lex: l, tok: error_tok(ev.err, start_line, start_col) };
    }
    val = ev.val;
  } else if (is_byte) {
    if (c >= 128) {
      return NumResult { lex: l, tok: error_tok("byte literal must be ASCII; write a character literal for a Unicode scalar", start_line, start_col) };
    }
    val = c;
    l = l.advance();
  } else {
    let u = decode_utf8(l.src, l.i, l.n);
    if (u.len == 0) {
      return NumResult { lex: l, tok: error_tok("invalid UTF-8 byte in character literal", start_line, start_col) };
    }
    val = u.val;
    l = l.skip(u.len);
  }
  if (l.at_end() || l.peek_byte() != 39) {
    if (closing_quote_ahead(l)) {
      return NumResult { lex: l, tok: error_tok(kind_name + " literal must hold exactly one " + kind_name, start_line, start_col) };
    }
    return NumResult { lex: l, tok: error_tok("unterminated " + kind_name + " literal", start_line, start_col) };
  }
  l = l.advance();
  let raw = slice_unchecked(l.src, begin, l.i) + "";
  return NumResult { lex: l, tok: quoted_tok(dec_str(val), suffix, raw, start_line, start_col) };
}

const STRING_STOP: u8[] = [
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
  0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
];

function scan_string(own l: Lex, start_line: i32, start_col: i32): NumResult {
  l = l.advance();
  let out = "";
  while (!l.at_end() && l.peek_byte() != 34) {
    let c = l.peek_byte();
    if (c == 10) {
      return NumResult { lex: l, tok: error_tok("newline inside string literal", start_line, start_col) };
    }
    if (c == 92) {
      let ev = quoted_escape(l, false, "string");
      l = ev.lex;
      if (ev.err.len() > 0) {
        return NumResult { lex: l, tok: error_tok(ev.err, start_line, start_col) };
      }
      out += utf8_encode(ev.val);
      continue;
    }
    let re = __scan_set(l.src, l.i, STRING_STOP);
    out += slice_unchecked(l.src, l.i, re);
    l = l.advance_in_line(re);
  }
  if (l.at_end()) {
    return NumResult { lex: l, tok: error_tok("unterminated string literal", start_line, start_col) };
  }
  l = l.advance();
  return NumResult { lex: l, tok: string_tok(out, start_line, start_col) };
}

function scan_fstring(own l: Lex, start_line: i32, start_col: i32): NumResult {
  l = l.advance();
  let lit = "";
  let have_lit = false;
  let parts: FStringPart[] = [];
  while (!l.at_end()) {
    let c = l.peek_byte();
    if (c == 34) {
      l = l.advance();
      if (have_lit) {
        parts = parts.append(FStringPart { lit: lit, expr: "", is_expr: false, line: 0, col: 0 });
      }
      return NumResult { lex: l, tok: fstring_tok(parts, start_line, start_col) };
    }
    if (c == 10) {
      return NumResult { lex: l, tok: error_tok("newline inside f-string literal", start_line, start_col) };
    }
    if (c == 92) {
      let ev = quoted_escape(l, false, "f-string");
      l = ev.lex;
      if (ev.err.len() > 0) {
        return NumResult { lex: l, tok: error_tok(ev.err, start_line, start_col) };
      }
      lit += utf8_encode(ev.val);
      have_lit = true;
      continue;
    }
    if (c == 123) {
      if (l.i + 1 < l.n && l.src[l.i + 1] == b'{') {
        lit += "{";
        have_lit = true;
        l = l.advance();
        l = l.advance();
        continue;
      }
      l = l.advance();
      if (have_lit) {
        parts = parts.append(FStringPart { lit: lit, expr: "", is_expr: false, line: 0, col: 0 });
        lit = "";
        have_lit = false;
      }
      let expr_start = l.i;
      let expr_line = l.line;
      let expr_col = l.col;
      let depth = 1;
      while (!l.at_end() && depth > 0) {
        let d = l.peek_byte();
        if (d == 123) {
          depth += 1;
        } else if (d == 125) {
          depth -= 1;
          if (depth == 0) {
            break;
          }
        } else if (d == 10) {
          return NumResult { lex: l, tok: error_tok("newline inside f-string interpolation", start_line, start_col) };
        } else if (d == 92) {
          return NumResult { lex: l, tok: error_tok("a backslash is not allowed inside an f-string interpolation: a string there takes plain quotes, as in f\"{s == \"e\"}\"", start_line, start_col) };
        } else if (d == 34 || d == 39) {
          l = l.advance();
          while (!l.at_end() && l.peek_byte() != d) {
            if (l.peek_byte() == 92 && l.i + 1 < l.n) {
              l = l.advance();
            }
            l = l.advance();
          }
          if (l.at_end()) {
            return NumResult { lex: l, tok: error_tok("unterminated string inside f-string interpolation", start_line, start_col) };
          }
        }
        if (depth > 0) {
          l = l.advance();
        }
      }
      if (depth != 0) {
        return NumResult { lex: l, tok: error_tok("unterminated `{` in f-string", start_line, start_col) };
      }
      let expr_text = slice_unchecked(l.src, expr_start, l.i);
      l = l.advance();
      if (is_blank_range(expr_text)) {
        return NumResult { lex: l, tok: error_tok("empty `{}` in f-string", start_line, start_col) };
      }
      parts = parts.append(FStringPart { lit: "", expr: expr_text + "", is_expr: true, line: expr_line, col: expr_col });
      continue;
    }
    if (c == 125) {
      if (l.i + 1 < l.n && l.src[l.i + 1] == b'}') {
        lit += "}";
        have_lit = true;
        l = l.advance();
        l = l.advance();
        continue;
      }
      return NumResult { lex: l, tok: error_tok("unmatched `}` in f-string (use `}}` for a literal `}`)", start_line, start_col) };
    }
    let le = l.i;
    while (le < l.n && l.src[le] != b'"' && l.src[le] != 92 && l.src[le] != b'\n'
      && l.src[le] != b'{' && l.src[le] != b'}') {
      le += 1;
    }
    lit += slice_unchecked(l.src, l.i, le);
    have_lit = true;
    l = l.advance_in_line(le);
  }
  return NumResult { lex: l, tok: error_tok("unterminated f-string literal", start_line, start_col) };
}

pub function tokenize(src: string): Token[] {
  return tokenize_impl(src, false, 1).tokens;
}

pub function tokenize_from(src: string, first_line: i32): Token[] {
  return tokenize_impl(src, false, first_line).tokens;
}

pub function tokenize_full(src: string): LexResult {
  return tokenize_impl(src, true, 1);
}

function tokenize_impl(src: string, keep: boolean, first_line: i32): LexResult {
  let l = Lex { src: src, i: 0, n: src.len(), line: first_line, col: 1, comments: [] };
  let out: Token[] = [];
  let after_dot = false;
  while (true) {
    l = skip_trivia(l, keep);
    if (l.at_end()) {
      out = out.append(TokEof { line: l.line, col: l.col });
      return LexResult { tokens: out, comments: l.comments };
    }
    let start_line = l.line;
    let start_col = l.col;
    let b = l.peek_byte();
    if (b == 102 && l.i + 1 < l.n && l.src[l.i + 1] == b'"') {
      l = l.advance();
      let rf = scan_fstring(l, start_line, start_col);
      l = rf.lex;
      out = out.append(rf.tok);
      if (is_error_tok(rf.tok)) {
        return LexResult { tokens: out, comments: l.comments };
      }
      after_dot = false;
      continue;
    }
    if (b == 98 && l.i + 1 < l.n && l.src[l.i + 1] == b'\'') {
      let rb = scan_quoted(l, true, start_line, start_col);
      l = rb.lex;
      out = out.append(rb.tok);
      if (is_error_tok(rb.tok)) {
        return LexResult { tokens: out, comments: l.comments };
      }
      after_dot = false;
      continue;
    }
    if (b == 39) {
      let rc = scan_quoted(l, false, start_line, start_col);
      l = rc.lex;
      out = out.append(rc.tok);
      if (is_error_tok(rc.tok)) {
        return LexResult { tokens: out, comments: l.comments };
      }
      after_dot = false;
      continue;
    }
    if (is_digit(b)) {
      let rn = scan_number(l, after_dot, start_line, start_col);
      l = rn.lex;
      out = out.append(rn.tok);
      if (is_error_tok(rn.tok)) {
        return LexResult { tokens: out, comments: l.comments };
      }
      after_dot = false;
      continue;
    }
    if (is_alpha(b)) {
      let e = ident_end(l);
      let tok = ident_or_keyword(slice_unchecked(l.src, l.i, e), start_line, start_col);
      l = l.advance_in_line(e);
      out = out.append(tok);
      after_dot = false;
      continue;
    }
    if (b == 34) {
      let rs = scan_string(l, start_line, start_col);
      l = rs.lex;
      out = out.append(rs.tok);
      if (is_error_tok(rs.tok)) {
        return LexResult { tokens: out, comments: l.comments };
      }
      after_dot = false;
      continue;
    }
    let mp = match_multipunct(l.src, l.i, l.n);
    if (mp.len() > 0) {
      l = l.skip(mp.len());
      out = out.append(TokPunct { text: mp, line: start_line, col: start_col });
      after_dot = false;
      continue;
    }
    let text = single_punct(b);
    if (text.len() > 0) {
      l = l.skip(1);
      out = out.append(TokPunct { text: text, line: start_line, col: start_col });
      after_dot = b == 46;
      continue;
    }
    out = out.append(error_tok(bad_char_message(src, l.i, l.n), start_line, start_col));
    return LexResult { tokens: out, comments: l.comments };
  }
}
