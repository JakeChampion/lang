    return 1965;
  }

  if (!has_error(tokenize("''"))) {
    return 1970;
  }
  if (!has_error(tokenize("b''"))) {
    return 1971;
  }
  if (!has_error(tokenize("'ab'"))) {
    return 1972;
  }
  if (!has_error(tokenize("b'ab'"))) {
    return 1973;
  }
  if (!has_error(tokenize("'a"))) {
