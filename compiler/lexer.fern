  if (!has_error(tokenize("'\\u{D800}'"))) {
    return 1977;
  }
  if (!has_error(tokenize("'\\u{110000}'"))) {
    return 1978;
  }
  if (!has_error(tokenize("'\\xFF'"))) {
    return 1979;
  }
  if (!has_error(tokenize("'\\q'"))) {
    return 1980;
  }
  if (!has_error(tokenize("'\n'"))) {
    return 1981;
  }

  let idt: Token[] = tokenize("b bytes");
  match (idt[0]) {
    TokIdent(x) => {
      if (x.name != "b") {
        return 1990;
      }
    },
    _ => {
      return 1991;
    }
  }
  match (idt[1]) {
    TokIdent(x) => {
      if (x.name != "bytes") {
        return 1992;
      }
    },
    _ => {
      return 1993;
    }
  }
  return 0;
}

function check_part(p: FStringPart, want_expr: boolean, want_text: string, want_line: i32, want_col: i32): boolean {
  if (p.is_expr != want_expr) {
    return false;
  }
  if (p.line != want_line || p.col != want_col) {
    return false;
  }
  if (want_expr) {
    return p.expr == want_text;
  }
  return p.lit == want_text;
}

function test_fstring(): i32 {
  let t0: Token[] = tokenize("f\"\"");
  if (t0.len() != 2) {
    return 2000;
  }
  match (t0[0]) {
    TokFString(f) => {
      if (f.parts.len() != 0) {
        return 2001;
      }
    },
    _ => {
      return 2002;
    }
  }
  let t1: Token[] = tokenize("f\"plain\"");
  match (t1[0]) {
    TokFString(f) => {
      if (f.parts.len() != 1) {
        return 2010;
      }
      if (!check_part(f.parts[0], false, "plain", 0, 0)) {
        return 2011;
      }
    },
    _ => {
      return 2012;
    }
  }
  let t2: Token[] = tokenize("f\"a{x}b\"");
  match (t2[0]) {
    TokFString(f) => {
      if (f.parts.len() != 3) {
        return 2020;
      }
      if (!check_part(f.parts[0], false, "a", 0, 0)) {
        return 2021;
      }
      if (!check_part(f.parts[1], true, "x", 1, 5)) {
        return 2022;
      }
      if (!check_part(f.parts[2], false, "b", 0, 0)) {
        return 2023;
      }
    },
    _ => {
      return 2024;
    }
  }
  let t3: Token[] = tokenize("f\"{{lit}}\"");
  match (t3[0]) {
    TokFString(f) => {
      if (f.parts.len() != 1) {
        return 2030;
      }
      if (!check_part(f.parts[0], false, "{lit}", 0, 0)) {
        return 2031;
      }
    },
    _ => {
      return 2032;
    }
  }
  let t4: Token[] = tokenize("f\"k={\"x\"}\"");
  match (t4[0]) {
    TokFString(f) => {
      if (f.parts.len() != 2) {
        return 2040;
      }
      if (!check_part(f.parts[0], false, "k=", 0, 0)) {
        return 2041;
      }
      if (!check_part(f.parts[1], true, "\"x\"", 1, 6)) {
        return 2042;
      }
    },
    _ => {
      return 2043;
    }
  }
  let t5: Token[] = tokenize("f\"sum {a + b}\"");
  match (t5[0]) {
    TokFString(f) => {
      if (f.parts.len() != 2) {
        return 2050;
      }
      if (!check_part(f.parts[0], false, "sum ", 0, 0)) {
        return 2051;
      }
      if (!check_part(f.parts[1], true, "a + b", 1, 8)) {
        return 2052;
      }
    },
    _ => {
      return 2053;
    }
  }
  let t6: Token[] = tokenize("f\"hi\\nthere\"");
  match (t6[0]) {
    TokFString(f) => {
      if (f.parts.len() != 1) {
        return 2060;
      }
      if (!check_part(f.parts[0], false, "hi\nthere", 0, 0)) {
        return 2061;
      }
    },
    _ => {
      return 2062;
    }
  }
  if (!has_error(tokenize("f\"unterminated"))) {
    return 2070;
  }
  if (!has_error(tokenize("f\"with\nnewline\""))) {
    return 2071;
  }
  if (!has_error(tokenize("f\"bare}brace\""))) {
    return 2072;
  }
  if (!has_error(tokenize("f\"empty{}\""))) {
    return 2073;
  }
  return 0;
}

function test_fstring_positions(): i32 {
  let t: Token[] = tokenize("let s = f\"a{aaa} b{bbb}\";");
  match (t[3]) {
    TokFString(f) => {
      if (f.parts.len() != 4) {
        return 2080;
      }
      if (!check_part(f.parts[1], true, "aaa", 1, 13)) {
        return 2081;
      }
      if (!check_part(f.parts[3], true, "bbb", 1, 20)) {
        return 2082;
      }
    },
    _ => {
      return 2083;
    }
  }
  match (tokenize("let a = 1;\nlet s = f\"x{yy}\";")[8]) {
    TokFString(f) => {
      if (!check_part(f.parts[1], true, "yy", 2, 13)) {
        return 2090;
      }
    },
    _ => {
      return 2091;
    }
  }
  let sub: Token[] = rebase_tokens(tokenize("a\nb"), 4, 10);
  match (sub[0]) {
    TokIdent(x) => {
      if (x.line != 4 || x.col != 10) {
        return 2092;
      }
    },
    _ => {
      return 2093;
    }
  }
  match (sub[1]) {
    TokIdent(x) => {
      if (x.line != 5 || x.col != 1) {
        return 2094;
      }
    },
    _ => {
      return 2095;
    }
  }
  return 0;
}

function check_comment(c: Comment, line: i32, col: i32, text: string): boolean {
  return c.line == line && c.col == col && c.text == text;
}

function test_comments(): i32 {
  let src: string = "// leading\nlet u: string = \"http://x//y\"; // trailing\nlet n: i32 = 1;\n//: last\n";
  let r: LexResult = tokenize_full(src);
  if (r.comments.len() != 3) {
    return 2100;
  }
  if (!check_comment(r.comments[0], 1, 1, " leading")) {
    return 2101;
  }
  if (!check_comment(r.comments[1], 2, 32, " trailing")) {
    return 2102;
  }
  if (!check_comment(r.comments[2], 4, 1, ": last")) {
    return 2103;
  }
  if (r.tokens.len() != tokenize(src).len()) {
    return 2104;
  }
  if (tokenize_full("let x: i32 = 1;\n").comments.len() != 0) {
    return 2105;
  }
  if (tokenize_full("// kept\nlet s: string = \"oops\n").comments.len() != 1) {
    return 2106;
  }
  let tail: LexResult = tokenize_full("let x: i32 = 1; // tail");
  if (tail.comments.len() != 1 || !check_comment(tail.comments[0], 1, 17, " tail")) {
    return 2107;
  }
  return 0;
}

function test_multibyte(): i32 {
  let src: string = "let s: string = \"héllo wörld\"; s <<= 1; // cömment é\nlet f = f\"pré {s} pöst\";\n";
  let r: LexResult = tokenize_full(src);
  let toks: Token[] = r.tokens;
  if (toks.len() != 17) {
    return 2200;
  }
  match (toks[5]) {
    TokString(t) => {
      if (t.value != "héllo wörld") {
        return 2201;
      }
    },
    _ => {
      return 2202;
    }
  }
  match (toks[8]) {
    TokPunct(t) => {
      if (t.text != "<<=") {
        return 2203;
      }
    },
    _ => {
      return 2204;
    }
  }
  match (toks[14]) {
    TokFString(t) => {
      if (t.parts.len() != 3) {
        return 2205;
      }
      if (t.parts[0].lit != "pré ") {
        return 2206;
      }
      if (t.parts[1].expr != "s") {
        return 2207;
      }
      if (t.parts[2].lit != " pöst") {
        return 2208;
      }
    },
    _ => {
      return 2209;
    }
  }
  if (r.comments.len() != 1) {
    return 2210;
  }
  if (r.comments[0].text != " cömment é") {
    return 2211;
  }
  let t2: Token[] = tokenize("a<é");
  if (t2.len() != 3) {
    return 2212;
  }
  match (t2[1]) {
    TokPunct(t) => {
      if (t.text != "<") {
        return 2213;
      }
    },
    _ => {
      return 2214;
    }
  }
  match (t2[2]) {
    TokError(t) => {
      if (t.msg != "identifiers must be ASCII; found 'é'") {
        return 2215;
      }
    },
    _ => {
      return 2216;
    }
  }
  return 0;
}

function test_source_decoding(): i32 {
  match (decode_source([47 as u8, 47 as u8, 10 as u8, 32 as u8, 255 as u8])) {
    Ok(_) => {
      return 2232;
    },
    Err(e) => {
      if (e.line != 2 || e.col != 2 || e.code != "P001" || e.msg != "invalid UTF-8 byte 0xFF") {
        return 2233;
      }
    }
  }
  match (decode_source([195 as u8, 169 as u8])) {
    Ok(text) => {
      if (text != "é") {
        return 2234;
      }
    },
    Err(_) => {
      return 2235;
    }
  }
  return 0;
}

function main(): i32 {
  let c: i32 = 0;
  c = test_mixed();
  if (c != 0) {
    return c;
  }
  c = test_hex();
  if (c != 0) {
    return c;
  }
  c = test_scientific();
  if (c != 0) {
    return c;
  }
  c = test_bare_e();
  if (c != 0) {
    return c;
  }
  c = test_chained_tuple();
  if (c != 0) {
    return c;
  }
  c = test_float_after_nondot();
  if (c != 0) {
    return c;
  }
  c = test_suffix_errors();
  if (c != 0) {
    return c;
  }
  c = test_hex_needs_digits();
  if (c != 0) {
    return c;
  }
  c = test_string_errors();
  if (c != 0) {
    return c;
  }
  c = test_unknown_char();
  if (c != 0) {
    return c;
  }
  c = test_quoted_literals();
  if (c != 0) {
    return c;
  }
  c = test_string_escapes();
  if (c != 0) {
    return c;
  }
  c = test_fstring();
  if (c != 0) {
    return c;
  }
  c = test_fstring_positions();
  if (c != 0) {
    return c;
  }
  c = test_comments();
  if (c != 0) {
    return c;
  }
  c = test_multibyte();
  if (c != 0) {
    return c;
  }
  return test_source_decoding();
}
