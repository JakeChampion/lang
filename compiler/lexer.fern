function test_float_after_nondot(): i32 {
  let toks: Token[] = tokenize("let f = 1.5;");
  let floats: i32 = 0;
  let i: i32 = 0;
  while (i < toks.len()) {
    match (toks[i]) {
      TokNumber(t) => {
        if (t.is_float) {
          floats = floats + 1;
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  if (floats != 1) {
    return 1650;
  }
  return 0;
}

