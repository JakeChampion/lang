// Retain the checked adapter through source tree shaking, then remove it
// and its unused ndarray callees when no typed site selected it.
import "./parser";
import "./irtables";
import "./util";

pub struct Result { bodies: irtables.LowerResult[], extra: irtables.LowerResult[] }

function exported(mod: parser.Module, name: string): boolean {
  for x in mod.exports {
    if (x.func_name == name) {
      return true;
    }
  }
  return false;
}

function mentions(r: irtables.LowerResult, name: string): boolean {
  for op in r.ops {
    // Function addresses can be embedded in constant-record payloads, not
    // just direct calls. Substring matching deliberately over-keeps here.
    if (util.contains(op.str, name)) {
      return true;
    }
  }
  return false;
}

function referenced(all: irtables.LowerResult[], at: i32): boolean {
  let i: i32 = 0;
  while (i < all.len()) {
    if (i != at && all[i].ok && !all[i].superseded && mentions(all[i], all[at].name)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function ordinary_candidate(mod: parser.Module, r: irtables.LowerResult): boolean {
  // Never broaden this to runtime or receiver-method symbols. Those can
  // have implicit callers outside the direct-call/constant-address census.
  return r.ok && !r.superseded && util.str_has_prefix(r.name, "ndarray__")
    && !util.contains(r.name, ".") && !exported(mod, r.name);
}

function adapter_index(mod: parser.Module, bodies: irtables.LowerResult[]): i32 {
  let i: i32 = 0;
  while (i < bodies.len() && i < mod.funcs.len()) {
    if (mod.funcs[i].name == "ndarray__inner_kernel") {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function unused_adapter(mod: parser.Module, bodies: irtables.LowerResult[], extra: irtables.LowerResult[]): Result {
  let adapter: i32 = adapter_index(mod, bodies);
  if (adapter < 0) {
    return Result { bodies: bodies, extra: extra };
  }
  let all: irtables.LowerResult[] = util.append_all(bodies, extra);
  let declared: i32 = 0;
  while (declared < bodies.len() && declared < mod.funcs.len()) {
    all = all.with(declared, irtables.LowerResult { ...all[declared], name: mod.funcs[declared].name });
    declared = declared + 1;
  }
  if (!ordinary_candidate(mod, all[adapter]) || referenced(all, adapter)) {
    return Result { bodies: bodies, extra: extra };
  }
  let candidates: boolean[] = [];
  for r in all {
    candidates = candidates.append(r.name == "ndarray__inner_kernel");
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let i: i32 = 0;
    while (i < all.len()) {
      let r: irtables.LowerResult = all[i];
      if (candidates[i] && ordinary_candidate(mod, r) && !referenced(all, i)) {
        let j: i32 = 0;
        while (j < all.len()) {
          if (ordinary_candidate(mod, all[j]) && mentions(r, all[j].name)) {
            candidates = candidates.with(j, true);
          }
          j = j + 1;
        }
        all = all.with(i, irtables.LowerResult { ...r, superseded: true });
        changed = true;
      }
      i = i + 1;
    }
  }
  let kept: irtables.LowerResult[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    if (i < bodies.len()) {
      bodies = bodies.with(i, irtables.LowerResult { ...all[i], name: bodies[i].name });
    } else if (!all[i].superseded) {
      kept = kept.append(all[i]);
    }
    i = i + 1;
  }
  return Result { bodies: bodies, extra: kept };
}
