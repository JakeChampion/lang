import "./parser";
import "./irtables";
import "./util";
import "std/string";

pub struct Result { bodies: irtables.LowerResult[], extra: irtables.LowerResult[] }

pub struct MappedResult { result: Result, extra_indices: i32[] }

function unchanged(bodies: irtables.LowerResult[], extra: irtables.LowerResult[], mapped: boolean): MappedResult {
  let indices: i32[] = [];
  if (mapped) {
    for i in 0..extra.len() {
      indices = indices.append(i);
    }
  }
  return MappedResult { result: Result { bodies: bodies, extra: extra }, extra_indices: indices };
}

function mentions(r: irtables.LowerResult, name: string): boolean {
  for op in r.ops {
    if (util.contains(op.str, name)) {
      return true;
    }
  }
  return false;
}

function referenced(all: irtables.LowerResult[], at: i32): boolean {
  for i in 0..all.len() {
    if (i != at && all[i].ok && !all[i].superseded && mentions(all[i], all[at].name)) {
      return true;
    }
  }
  return false;
}

function ordinary_candidate(mod: parser.Module, r: irtables.LowerResult): boolean {
  return r.ok && !r.superseded && r.name.starts_with("ndarray__")
    && !util.contains(r.name, ".") && !parser.named_outside(mod, r.name);
}

function adapter_index(mod: parser.Module, declared: i32): Option[i32] {
  for i in 0..declared {
    if (mod.funcs[i].name == "ndarray__inner_kernel") {
      return Some(i);
    }
  }
  return None;
}

pub function unused_adapter(mod: parser.Module, bodies: irtables.LowerResult[], extra: irtables.LowerResult[]): Result {
  return pruned_adapter(mod, bodies, extra, false).result;
}

pub function unused_adapter_mapped(mod: parser.Module, bodies: irtables.LowerResult[], extra: irtables.LowerResult[]): MappedResult {
  return pruned_adapter(mod, bodies, extra, true);
}

function pruned_adapter(mod: parser.Module, bodies: irtables.LowerResult[], extra: irtables.LowerResult[], mapped: boolean): MappedResult {
  let declared = if (bodies.len() < mod.funcs.len()) { bodies.len() } else { mod.funcs.len() };
  let Some(adapter) = adapter_index(mod, declared) else {
    return unchanged(bodies, extra, mapped);
  };
  let all = util.append_all(bodies, extra);
  for i in 0..declared {
    all = all.with(i, irtables.LowerResult { ...all[i], name: mod.funcs[i].name });
  }
  if (!ordinary_candidate(mod, all[adapter]) || referenced(all, adapter)) {
    return unchanged(bodies, extra, mapped);
  }
  let candidates: boolean[] = [];
  for r in all {
    candidates = candidates.append(r.name == "ndarray__inner_kernel");
  }
  let changed = true;
  while (changed) {
    changed = false;
    for i in 0..all.len() {
      let r = all[i];
      if (candidates[i] && ordinary_candidate(mod, r) && !referenced(all, i)) {
        for j in 0..all.len() {
          if (ordinary_candidate(mod, all[j]) && mentions(r, all[j].name)) {
            candidates = candidates.with(j, true);
          }
        }
        all = all.with(i, irtables.LowerResult { ...r, superseded: true });
        changed = true;
      }
    }
  }
  let kept: irtables.LowerResult[] = [];
  let indices: i32[] = [];
  for i in 0..all.len() {
    if (i < bodies.len()) {
      bodies = bodies.with(i, irtables.LowerResult { ...all[i], name: bodies[i].name });
    } else if (!all[i].superseded) {
      kept = kept.append(all[i]);
      if (mapped) {
        indices = indices.append(i - bodies.len());
      }
    }
  }
  return MappedResult { result: Result { bodies: bodies, extra: kept }, extra_indices: indices };
}
