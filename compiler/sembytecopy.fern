import "./ssa";
import "./ssasem";
import "./typeinfo";
import "./util";
import "./rtbytecopy";
import "./semtypes";
import "./sourcepos";

pub struct Rewritten { func: ssasem.Func, changed: boolean }

struct Index { defs: ssa.SInst[], homes: i32[], blocks: i32[] }

// A back loop appends a[a.len() - from] to a itself, or a[from + i] when it
// is rebased, with -1 for a zero from. A for-each loop increments its index
// in a step block between the body and the header; step is -1 when the body
// branches to the header itself. A concat loop appends a range of another
// array or view, and becomes a range concat instead of a byte helper call. A
// fill writes `value`, and a move reads the array itself. A slide takes
// `value` from each element. `shift` is the log2 of the bytes of an element,
// or -1. `lifted` holds the constants of the body that the call needs.
// `extra` holds the other blocks of a body that branches.
struct Loop { ok: boolean, head: i32, body: i32, step: i32, extra: i32[], exit: i32, outer: i32, array: ssa.SInst, counter: ssa.SInst, update: ssa.SInst, count: i32, chain: i32[], src: i32, from: i32, at: i32, back: boolean, rebased: boolean, concat: boolean, kind: i32, value: i32, shift: i32, lifted: i32[] }

const COPY: i32 = 0;

const FILL: i32 = 1;

const MOVE: i32 = 2;

const SLIDE: i32 = 3;

function no_loop(): Loop {
  return Loop { ok: false, head: 0, body: 0, step: -1, extra: [], exit: 0, outer: 0, array: ssa.no_inst(), counter: ssa.no_inst(), update: ssa.no_inst(), count: 0, chain: [], src: 0, from: 0, at: 0, back: false, rebased: false, concat: false, kind: COPY, value: -1, shift: -1, lifted: [] };
}

function bytes(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    if let typeinfo.TypeI32(e) = a.elem {
      return !a.view && e.width == 8 && e.unsigned && !e.is_char;
    }
  }
  return false;
}

// An owned array that a range concat can extend: any element but a string view.
function concat_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return !a.view && !ssasem.is_view(a.elem);
  }
  return false;
}

// An append can become a range concat, and a with a fill, a move or a byte copy.
function any_copy_update(f: ssasem.Func): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.append() && concat_array(f.values[ins.result]) || ins.kind_tag == ssasem.with() && ssasem.elem_shift(f.values[ins.result]) >= 0) {
        return true;
      }
    }
  }
  return false;
}

function index(f: ssasem.Func): Index {
  let homes = util.minus_ones(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result >= 0) {
        homes = homes.with(ins.result, b.id);
      }
    }
  }
  return Index { defs: ssa.inst_defs(f.graph), homes: homes, blocks: ssa.block_positions(f.graph) };
}

function literal(ix: Index, v: i32, n: i32): boolean {
  let d = ix.defs[v];
  return d.kind_tag == ssa.CONST_INT && d.imm == n;
}

// A value defined outside the loop. A parameter has no home.
function invariant(ix: Index, v: i32, l: Loop): boolean {
  return v >= 0 && !inside(ix, v, l);
}

function inside(ix: Index, v: i32, l: Loop): boolean {
  let home = ix.homes[v];
  return home == l.head || home == l.body || l.step >= 0 && home == l.step || util.has_i32(l.extra, home);
}

// A constant of the body or the step block, which the call can compute
// before the loop.
function body_const(ix: Index, v: i32, l: Loop): boolean {
  let k = ix.defs[v].kind_tag;
  return v >= 0 && in_loop_body(ix, v, l) && (k == ssa.CONST_INT || k == ssa.CONST_I64);
}

function fixed(ix: Index, v: i32, l: Loop): boolean {
  return invariant(ix, v, l) || body_const(ix, v, l);
}

// The body constants among `values`, each once.
function lifted_consts(ix: Index, l: Loop, values: i32[]): i32[] {
  let out: i32[] = [];
  for v in values {
    if (v >= 0 && body_const(ix, v, l) && util.index_of_i32(out, v) < 0) {
      out = out.append(v);
    }
  }
  return out;
}

function offset(ix: Index, v: i32, counter: i32, l: Loop): i32 {
  if (v == counter) {
    return -1;
  }
  let d = ix.defs[v];
  if (!addition(d)) {
    return -2;
  }
  if (d.args[0] == counter && fixed(ix, d.args[1], l)) {
    return d.args[1];
  }
  if (d.args[1] == counter && fixed(ix, d.args[0], l)) {
    return d.args[0];
  }
  return -2;
}

function addition(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssa.BINARY && ins.str == "+" && ins.args.len() == 2;
}

function loop_edges(h: ssa.SBlock, body: ssa.SBlock, exit: ssa.SBlock): boolean {
  return body.term.kind_tag == ssa.TERM_BR && body.preds.len() == 1 && body.preds[0] == h.id
    && exit.preds.len() == 1 && exit.preds[0] == h.id;
}

// The block that branches back to the header: the body, or a step block
// that only the body enters, as a for-each loop lowers.
function latch(f: ssasem.Func, ix: Index, h: ssa.SBlock, body: ssa.SBlock): i32 {
  if (body.term.target == h.id) {
    return body.id;
  }
  let step = f.graph.blocks[ix.blocks[body.term.target]];
  if (step.term.kind_tag == ssa.TERM_BR && step.term.target == h.id && step.preds.len() == 1 && step.preds[0] == body.id) {
    return step.id;
  }
  return -1;
}

function header_phis(f: ssasem.Func, h: ssa.SBlock, chain: i32[]): Loop {
  let array = ssa.no_inst();
  let counter = ssa.no_inst();
  for ins in h.insts {
    if (ins.kind_tag == ssa.PHI && ins.args.len() == 2) {
      if ((concat_array(f.values[ins.result]) || ssasem.elem_shift(f.values[ins.result]) >= 0) && array.result < 0) {
        array = ins;
      } else if (ssasem.is_i32(f.values[ins.result]) && counter.result < 0) {
        counter = ins;
      } else {
        return no_loop();
      }
    } else if (ins.result != h.term.cond && util.index_of_i32(chain, ins.result) < 0 && ins.kind_tag != ssa.LINE) {
      return no_loop();
    }
  }
  return Loop { ...no_loop(), ok: array.result >= 0 && counter.result >= 0, array: array, counter: counter, shift: if (array.result >= 0) { ssasem.elem_shift(f.values[array.result]) } else { -1 } };
}

function loop_compare(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssa.BINARY && ins.str == "<" && ins.args.len() == 2;
}

struct Chain { ok: boolean, values: i32[] }

// The header values a count is computed from, when they read only invariant
// values without other effects. The header runs at least once, so computing
// them once before the copy aborts in the same cases.
function count_chain(ix: Index, v: i32, l: Loop, own c: Chain, steps: i32): Chain {
  if (!c.ok || invariant(ix, v, l) || util.index_of_i32(c.values, v) >= 0) {
    return c;
  }
  let d = ix.defs[v];
  if (ix.homes[v] != l.head || steps == 0 || !chain_op(d)) {
    return Chain { ok: false, values: [] };
  }
  for a in d.args {
    c = count_chain(ix, a, l, c, steps - 1);
  }
  if (!c.ok) {
    return c;
  }
  return Chain { ok: true, values: c.values.append(v) };
}

function chain_op(d: ssa.SInst): boolean {
  if (d.kind_tag == ssa.CONST_INT || d.kind_tag == ssasem.length() || d.kind_tag == ssasem.record_get()) {
    return true;
  }
  if (d.kind_tag == ssasem.array_get()) {
    return d.imm != ssasem.check_only();
  }
  return d.kind_tag == ssa.BINARY && chain_binary(d.str);
}

function chain_binary(op: string): boolean {
  return op == "+" || op == "-" || op == "*" || op == "&" || op == "|" || op == "^";
}

function header(f: ssasem.Func, ix: Index, h: ssa.SBlock): Loop {
  let no = no_loop();
  if (h.term.kind_tag != ssa.TERM_BRIF || h.preds.len() != 2) {
    return no;
  }
  let body = f.graph.blocks[ix.blocks[h.term.t]];
  let exit = f.graph.blocks[ix.blocks[h.term.f]];
  if (!loop_edges(h, body, exit)) {
    return no;
  }
  let back = util.index_of_i32(h.preds, latch(f, ix, h, body));
  if (back < 0) {
    return no;
  }
  let step = -1;
  if (h.preds[back] != body.id) {
    step = h.preds[back];
  }
  let outer = 1 - back;
  let cmp = ix.defs[h.term.cond];
  if (!loop_compare(cmp)) {
    return no;
  }
  let shape = Loop { ...no, head: h.id, body: body.id, step: step, exit: exit.id, outer: outer };
  let chain = count_chain(ix, cmp.args[1], shape, Chain { ok: true, values: [] }, 8);
  if (!chain.ok) {
    return no;
  }
  let phis = header_phis(f, h, chain.values);
  if (!phis.ok || !invariant(ix, phis.counter.args[outer], shape)) {
    return no;
  }
  let array = phis.array;
  let counter = phis.counter;
  if (cmp.args[0] != counter.result) {
    return no;
  }
  return Loop { ...shape, ok: true, array: array, counter: counter, count: cmp.args[1], chain: chain.values, shift: phis.shift };
}

function copy_update(ins: ssa.SInst, receiver: i32): boolean {
  return (ins.kind_tag == ssasem.append() && ins.args.len() == 2 || ins.kind_tag == ssasem.with() && ins.args.len() == 3) && ins.args[0] == receiver;
}

// A read of an invariant array or view with the receiver's elements.
function source_read(f: ssasem.Func, ix: Index, update: ssa.SInst, l: Loop): ssa.SInst {
  let read = ix.defs[update.args[update.args.len() - 1]];
  if (read.kind_tag != ssasem.array_get() || read.imm == ssasem.check_only() || read.args.len() != 2) {
    return ssa.no_inst();
  }
  if (!invariant(ix, read.args[0], l) || !ssasem.same_elements(f.values[read.args[0]], f.values[l.array.result])) {
    return ssa.no_inst();
  }
  return read;
}

// The byte helpers are kind 0. The append helper takes an owned u8[] source,
// and the write helper takes a u8[] or a [u8] view. Any other append of a
// range is a range concat, kind 1, which reads a view in place. Its source
// must not be the receiver that the loop starts from. Kind -1 keeps the loop,
// as it does when there is no such read.
function copy_kind(f: ssasem.Func, l: Loop, read: ssa.SInst, write: boolean): i32 {
  if (read.result < 0) {
    return -1;
  }
  let src = read.args[0];
  if (bytes(f.values[l.array.result]) && (bytes(f.values[src]) || write && ssasem.is_byte_view(f.values[src]))) {
    return 0;
  }
  if (write || src == l.array.args[l.outer]) {
    return -1;
  }
  return 1;
}

// The body and the step block compute only the allowed values.
function pure_body(f: ssasem.Func, ix: Index, l: Loop, allowed: i32[]): boolean {
  if (l.step >= 0 && !pure_block(f.graph.blocks[ix.blocks[l.step]], allowed)) {
    return false;
  }
  return pure_block(f.graph.blocks[ix.blocks[l.body]], allowed);
}

function pure_block(b: ssa.SBlock, allowed: i32[]): boolean {
  for ins in b.insts {
    if (ins.kind_tag != ssa.LINE && util.index_of_i32(allowed, ins.result) < 0) {
      return false;
    }
  }
  return true;
}

// A read of the array the loop builds.
function write_offset(ix: Index, update: ssa.SInst, write: boolean, l: Loop): i32 {
  if (!write) {
    return -1;
  }
  return offset(ix, update.args[1], l.counter.result, l);
}

function copy_values(update: ssa.SInst, read: ssa.SInst, inc: ssa.SInst, write: boolean): i32[] {
  let allowed = [update.result, read.result, read.args[1], inc.result, inc.args[1]];
  if (write) {
    return allowed.append(update.args[1]);
  }
  return allowed;
}

function own_read(read: ssa.SInst, l: Loop): boolean {
  return read.kind_tag == ssasem.array_get() && read.imm != ssasem.check_only() && read.args.len() == 2 && read.args[0] == l.array.result;
}

struct Tail { len: i32, distance: i32 }

// An index `a.len() - distance` with an invariant distance: the length's
// value and the distance, or a negative `len` when the index is not one.
function tail_distance(ix: Index, l: Loop, index: i32): Tail {
  let no = Tail { len: -1, distance: -1 };
  let at = ix.defs[index];
  if (at.kind_tag != ssa.BINARY || at.str != "-" || at.args.len() != 2 || !invariant(ix, at.args[1], l)) {
    return no;
  }
  let len = ix.defs[at.args[0]];
  if (len.kind_tag != ssasem.length() || len.args.len() != 1 || len.args[0] != l.array.result) {
    return no;
  }
  return Tail { len: len.result, distance: at.args[1] };
}

function body_loop(f: ssasem.Func, ix: Index, l: Loop): Loop {
  let no = no_loop();
  let back = 1 - l.outer;
  let update = ix.defs[l.array.args[back]];
  let write = update.kind_tag == ssasem.with();
  if (!copy_update(update, l.array.result)) {
    return no;
  }
  if (write && l.shift >= 0) {
    let filled = fill_loop(f, ix, l, update);
    if (filled.ok) {
      return filled;
    }
    let moved = move_loop(f, ix, l, update);
    if (moved.ok) {
      return moved;
    }
  }
  if (!write) {
    let back = back_loop(f, ix, l, update);
    if (back.ok) {
      return back;
    }
  }
  let read = source_read(f, ix, update, l);
  let kind = copy_kind(f, l, read, write);
  if (kind < 0) {
    return no;
  }
  let from = offset(ix, read.args[1], l.counter.result, l);
  let at = write_offset(ix, update, write, l);
  if (from < -1 || at < -1) {
    return no;
  }
  let inc = ix.defs[l.counter.args[back]];
  if (!increment(ix, inc, l.counter.result)) {
    return no;
  }
  let lifted = lifted_consts(ix, l, [from, at]);
  if (!pure_body(f, ix, l, util.append_all(copy_values(update, read, inc, write), lifted))) {
    return no;
  }
  let out = Loop { ...l, update: update, src: read.args[0], from: from, at: at, concat: kind == 1, lifted: lifted };
  if (!closed_body(f, ix, out)) {
    return no;
  }
  return out;
}

// a = a.with(at + i, v) with a value that the loop does not change.
function fill_loop(f: ssasem.Func, ix: Index, l: Loop, update: ssa.SInst): Loop {
  let no = no_loop();
  let v = update.args[2];
  if (!fill_elem(f.values[l.array.result]) || !fixed(ix, v, l)) {
    return no;
  }
  let at = offset(ix, update.args[1], l.counter.result, l);
  let inc = ix.defs[l.counter.args[1 - l.outer]];
  if (at < -1 || !increment(ix, inc, l.counter.result)) {
    return no;
  }
  let lifted = lifted_consts(ix, l, [at, v]);
  if (!pure_body(f, ix, l, util.append_all([update.result, update.args[1], inc.result, inc.args[1]], lifted))) {
    return no;
  }
  let out = Loop { ...l, update: update, src: -1, from: -1, at: at, kind: FILL, value: v, lifted: lifted };
  if (!closed_body(f, ix, out)) {
    return no;
  }
  return out;
}

// An integer or a char: the kernel takes the bits of the value.
function fill_elem(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return ssasem.is_integer(a.elem) || ssasem.is_char(a.elem);
  }
  return false;
}

// a = a.with(at + i, a[from + i]): each read sees the writes before it.
function move_loop(f: ssasem.Func, ix: Index, l: Loop, update: ssa.SInst): Loop {
  let no = no_loop();
  let read = ix.defs[update.args[2]];
  if (!own_read(read, l)) {
    return no;
  }
  let from = offset(ix, read.args[1], l.counter.result, l);
  let at = offset(ix, update.args[1], l.counter.result, l);
  let inc = ix.defs[l.counter.args[1 - l.outer]];
  if (from < -1 || at < -1 || !increment(ix, inc, l.counter.result)) {
    return no;
  }
  let lifted = lifted_consts(ix, l, [from, at]);
  let allowed = [update.result, read.result, read.args[1], update.args[1], inc.result, inc.args[1]];
  if (!pure_body(f, ix, l, util.append_all(allowed, lifted))) {
    return no;
  }
  let out = Loop { ...l, update: update, src: -1, from: from, at: at, kind: MOVE, lifted: lifted };
  if (!closed_body(f, ix, out)) {
    return no;
  }
  return out;
}

function back_loop(f: ssasem.Func, ix: Index, l: Loop, update: ssa.SInst): Loop {
  let no = no_loop();
  let read = ix.defs[update.args[1]];
  if (!bytes(f.values[l.array.result]) || !literal(ix, l.counter.args[l.outer], 0)) {
    return no;
  }
  if (!own_read(read, l)) {
    return no;
  }
  let inc = ix.defs[l.counter.args[1 - l.outer]];
  if (!increment(ix, inc, l.counter.result)) {
    return no;
  }
  let allowed = [update.result, read.result, read.args[1], inc.result, inc.args[1]];
  let from = offset(ix, read.args[1], l.counter.result, l);
  let rebased = from >= -1;
  if (!rebased) {
    let tail = tail_distance(ix, l, read.args[1]);
    if (tail.len < 0) {
      return no;
    }
    from = tail.distance;
    allowed = allowed.append(tail.len);
  }
  let lifted = lifted_consts(ix, l, [from]);
  if (!pure_body(f, ix, l, util.append_all(allowed, lifted))) {
    return no;
  }
  let out = Loop { ...l, update: update, src: -1, from: from, at: -1, back: true, rebased: rebased, lifted: lifted };
  if (!closed_body(f, ix, out)) {
    return no;
  }
  return out;
}

function block_of(f: ssasem.Func, ix: Index, id: i32): ssa.SBlock {
  return f.graph.blocks[ix.blocks[id]];
}

function only_pred(b: ssa.SBlock, id: i32): boolean {
  return b.preds.len() == 1 && b.preds[0] == id;
}

// The loop of a slide: the header, a body that compares an element with k,
// the arm that subtracts k, the arm that gives 0, and the block that joins
// the arms and writes the element.
function slide_header(f: ssasem.Func, ix: Index, h: ssa.SBlock): Loop {
  let no = no_loop();
  if (h.term.kind_tag != ssa.TERM_BRIF || h.preds.len() != 2) {
    return no;
  }
  let body = block_of(f, ix, h.term.t);
  let exit = block_of(f, ix, h.term.f);
  if (body.term.kind_tag != ssa.TERM_BRIF || !only_pred(body, h.id) || !only_pred(exit, h.id)) {
    return no;
  }
  let yes = block_of(f, ix, body.term.t);
  let zero = block_of(f, ix, body.term.f);
  if (yes.term.kind_tag != ssa.TERM_BR || zero.term.kind_tag != ssa.TERM_BR || yes.term.target != zero.term.target || !only_pred(yes, body.id) || !only_pred(zero, body.id)) {
    return no;
  }
  let join = block_of(f, ix, yes.term.target);
  let back = util.index_of_i32(h.preds, join.id);
  if (join.term.kind_tag != ssa.TERM_BR || join.term.target != h.id || join.preds.len() != 2 || back < 0) {
    return no;
  }
  let cmp = ix.defs[h.term.cond];
  if (!loop_compare(cmp)) {
    return no;
  }
  let shape = Loop { ...no, head: h.id, body: body.id, step: join.id, extra: [yes.id, zero.id], exit: exit.id, outer: 1 - back };
  let chain = count_chain(ix, cmp.args[1], shape, Chain { ok: true, values: [] }, 8);
  if (!chain.ok) {
    return no;
  }
  let phis = header_phis(f, h, chain.values);
  if (!phis.ok || !invariant(ix, phis.counter.args[shape.outer], shape) || cmp.args[0] != phis.counter.result) {
    return no;
  }
  return Loop { ...shape, ok: true, array: phis.array, counter: phis.counter, count: cmp.args[1], chain: chain.values, shift: phis.shift };
}

function u16_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return !a.view && ssasem.is_u16(a.elem);
  }
  return false;
}

// The value that a cast to i32 or i64 reads, or `v` itself.
function widened(f: ssasem.Func, ix: Index, v: i32): i32 {
  let d = ix.defs[v];
  if (d.kind_tag == ssasem.cast() && d.args.len() == 1 && (ssasem.is_i32(f.values[v]) || ssasem.is_i64(f.values[v]))) {
    return d.args[0];
  }
  return v;
}

function same_value(ix: Index, a: i32, b: i32): boolean {
  let da = ix.defs[a];
  return a == b || da.kind_tag == ssa.CONST_INT && literal(ix, b, da.imm);
}

// for i in lo..hi { a = a.with(i, if (a[i] >= k) { (a[i] - k) as u16 } else { 0 }) }
// on a u16[], the slide of the hash chains of an LZ77 encoder.
function slide_loop(f: ssasem.Func, ix: Index, h: ssa.SBlock): Loop {
  let no = no_loop();
  let l = slide_header(f, ix, h);
  if (!l.ok || !u16_array(f.values[l.array.result])) {
    return no;
  }
  let body = block_of(f, ix, l.body);
  let join = block_of(f, ix, l.step);
  let ge = ix.defs[body.term.cond];
  if (ge.kind_tag != ssa.BINARY || ge.str != ">=" || ge.args.len() != 2) {
    return no;
  }
  let read = ix.defs[widened(f, ix, ge.args[0])];
  let k = ge.args[1];
  if (!own_read(read, l) || read.args[1] != l.counter.result || !fixed(ix, k, l) || !ssasem.is_i32(f.values[k]) && !ssasem.is_u16(f.values[k])) {
    return no;
  }
  let back = 1 - l.outer;
  let update = ix.defs[l.array.args[back]];
  if (update.kind_tag != ssasem.with() || update.args.len() != 3 || update.args[0] != l.array.result || update.args[1] != l.counter.result) {
    return no;
  }
  let phi = ix.defs[update.args[2]];
  let arm = util.index_of_i32(join.preds, body.term.t);
  if (phi.kind_tag != ssa.PHI || ix.homes[phi.result] != join.id || phi.args.len() != 2 || arm < 0 || !literal(ix, phi.args[1 - arm], 0)) {
    return no;
  }
  let cast = ix.defs[phi.args[arm]];
  if (cast.kind_tag != ssasem.cast() || cast.args.len() != 1) {
    return no;
  }
  let diff = ix.defs[cast.args[0]];
  if (diff.kind_tag != ssa.BINARY || diff.str != "-" || diff.args.len() != 2 || widened(f, ix, diff.args[0]) != read.result || !same_value(ix, diff.args[1], k)) {
    return no;
  }
  let inc = ix.defs[l.counter.args[back]];
  if (!increment(ix, inc, l.counter.result)) {
    return no;
  }
  let lifted = lifted_consts(ix, l, [k]);
  let allowed = [read.result, ge.args[0], k, ge.result, diff.args[0], diff.args[1], diff.result, cast.result, phi.args[1 - arm], phi.result, update.result, inc.result, inc.args[1]];
  for id in l.extra {
    if (!pure_block(block_of(f, ix, id), allowed)) {
      return no;
    }
  }
  if (!pure_body(f, ix, l, allowed)) {
    return no;
  }
  let out = Loop { ...l, update: update, src: -1, from: -1, at: -1, kind: SLIDE, value: k, lifted: lifted };
  if (!closed_body(f, ix, out)) {
    return no;
  }
  return out;
}

function increment(ix: Index, ins: ssa.SInst, counter: i32): boolean {
  return ins.kind_tag == ssa.BINARY && ins.str == "+" && ins.args.len() == 2 && ins.args[0] == counter && literal(ix, ins.args[1], 1);
}

// No block outside the loop reads a value the body or the step block defines.
function closed_body(f: ssasem.Func, ix: Index, l: Loop): boolean {
  for b in f.graph.blocks {
    if (b.id != l.head && b.id != l.body && b.id != l.step && !util.has_i32(l.extra, b.id) && body_escapes(b, ix, l)) {
      return false;
    }
  }
  return true;
}

function body_escapes(b: ssa.SBlock, ix: Index, l: Loop): boolean {
  for ins in b.insts {
    for v in ins.args {
      if (in_loop_body(ix, v, l)) {
        return true;
      }
    }
  }
  let v = b.term.value;
  if (b.term.kind_tag == ssa.TERM_BRIF) {
    v = b.term.cond;
  }
  return (b.term.kind_tag == ssa.TERM_RET || b.term.kind_tag == ssa.TERM_BRIF) && in_loop_body(ix, v, l);
}

function in_loop_body(ix: Index, v: i32, l: Loop): boolean {
  if (v < 0) {
    return false;
  }
  return ix.homes[v] == l.body || l.step >= 0 && ix.homes[v] == l.step || util.has_i32(l.extra, ix.homes[v]);
}

// A function in a module that defines a helper's name keeps its loops, since
// the call would reach that function.
function shadows_helper(f: ssasem.Func): boolean {
  for name in f.shadows {
    if (rtbytecopy.is_helper(name)) {
      return true;
    }
  }
  return false;
}

pub function rewrite(f: ssasem.Func, contracts: ssasem.Contract[]): Rewritten {
  if (!may_have_copy_loop(f.graph) || !any_copy_update(f) || shadows_helper(f)) {
    return Rewritten { func: f, changed: false };
  }
  let out = f;
  let changed = false;
  let ix = index(out);
  let h = 0;
  while (h < out.graph.blocks.len()) {
    let l = header(out, ix, out.graph.blocks[h]);
    if (l.ok) {
      l = body_loop(out, ix, l);
    } else {
      l = slide_loop(out, ix, out.graph.blocks[h]);
    }
    if (l.ok && l.kind != COPY && !contract_fits(out.calls, kernel_contract(out, l))) {
      l = no_loop();
    }
    if (l.ok) {
      out = replace(out, ix, l, contracts);
      changed = true;
      ix = index(out);
    }
    h += 1;
  }
  return Rewritten { func: out, changed: changed };
}

function may_have_copy_loop(g: ssa.SFunc): boolean {
  if (g.blocks.len() < 4) {
    return false;
  }
  for b in g.blocks {
    if (b.term.kind_tag == ssa.TERM_BRIF && b.preds.len() == 2) {
      return true;
    }
  }
  return false;
}

function copy(result: i32, v: i32): ssa.SInst {
  return ssa.SInst { kind_tag: ssa.COPY, result: result, args: [v], imm: 0, str: "" };
}

function replacement(v: i32, l: Loop, fresh: i32): i32 {
  if (v == l.counter.result) {
    return fresh;
  }
  return v;
}

function outside(blk: ssa.SBlock, l: Loop, fresh: i32): ssa.SBlock {
  let insts: ssa.SInst[] = [];
  for old in blk.insts {
    let ins = old;
    if (blk.id == l.exit && ins.kind_tag == ssa.PHI) {
      ins = copy(ins.result, ins.args[0]);
    }
    let args: i32[] = [];
    for v in ins.args {
      args = args.append(replacement(v, l, fresh));
    }
    insts = insts.append(ssa.SInst { ...ins, args: args });
  }
  return ssa.SBlock { ...blk, insts: insts, term: ssa.STerm { ...blk.term, cond: replacement(blk.term.cond, l, fresh), value: replacement(blk.term.value, l, fresh) } };
}

// A negative offset is the counter's start.
function or_start(v: i32, zero: i32): i32 {
  if (v < 0) {
    return zero;
  }
  return v;
}

// A start other than 0 copies max(end - start, 0) bytes from start + offset.
// The difference is computed in 64 bits. A count past the largest i32 is
// longer than any array, so it becomes that i32 and the helper aborts as the
// loop does.
struct Span { insts: ssa.SInst[], types: typeinfo.Type[], count: i32, from: i32, at: i32 }

function wide(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 64, unsigned: false, polymorphic: false };
}

function emit(sp: Span, kind: i32, args: i32[], text: string, t: typeinfo.Type, next: i32): Span {
  let ins = ssa.SInst { kind_tag: kind, result: next + sp.insts.len(), args: args, imm: 0, str: text };
  return Span { ...sp, insts: sp.insts.append(ins), types: sp.types.append(t) };
}

function last(sp: Span): i32 {
  return sp.insts[sp.insts.len() - 1].result;
}

function span(ix: Index, l: Loop, narrow: typeinfo.Type, next: i32): Span {
  let start = l.counter.args[l.outer];
  let sp = Span { insts: [], types: [], count: l.count, from: or_start(l.from, start), at: or_start(l.at, start) };
  if (literal(ix, start, 0)) {
    return sp;
  }
  let w = wide();
  sp = emit(sp, ssasem.cast(), [start], "", w, next);
  sp = emit(sp, ssasem.cast(), [l.count], "", w, next);
  sp = emit(sp, ssa.BINARY, [next + 1, next], "-", w, next);
  sp = emit(sp, ssa.CONST_INT, [], "63", w, next);
  sp = emit(sp, ssa.BINARY, [next + 2, next + 3], ">>", w, next);
  sp = emit(sp, ssa.BINARY, [next + 2, next + 4], "&", w, next);
  sp = emit(sp, ssa.BINARY, [next + 2, next + 5], "-", w, next);
  sp = emit(sp, ssa.CONST_INT, [], "2147483647", w, next);
  sp = emit(sp, ssa.BINARY, [next + 6, next + 7], "-", w, next);
  sp = emit(sp, ssa.BINARY, [next + 8, next + 3], ">>", w, next);
  sp = emit(sp, ssa.BINARY, [next + 8, next + 9], "&", w, next);
  sp = emit(sp, ssa.BINARY, [next + 7, next + 10], "+", w, next);
  sp = emit(sp, ssasem.cast(), [next + 11], "", narrow, next);
  sp = Span { ...sp, count: last(sp) };
  if (l.from >= 0) {
    sp = emit(sp, ssa.BINARY, [start, l.from], "+", narrow, next);
    sp = Span { ...sp, from: last(sp) };
  }
  if (l.at >= 0) {
    sp = emit(sp, ssa.BINARY, [start, l.at], "+", narrow, next);
    sp = Span { ...sp, at: last(sp) };
  }
  return sp;
}

function replace(f: ssasem.Func, ix: Index, l: Loop, contracts: ssasem.Contract[]): ssasem.Func {
  let fresh = f.values.len();
  let values = f.values.append(f.values[l.counter.result]);
  let distance: ssa.SInst[] = [];
  let zero = l.counter.args[l.outer];
  let receiver = l.array.args[l.outer];
  let sp = span(ix, l, f.values[l.counter.result], values.len());
  values = util.append_all(values, sp.types);
  distance = sp.insts;
  let from = sp.from;
  let at = sp.at;
  let args = [receiver, l.src, from, sp.count];
  let ci = 0;
  if (l.back) {
    distance = rebased_distance(l, receiver, values.len());
    while (values.len() < fresh + 1 + distance.len()) {
      values = values.append(f.values[l.counter.result]);
    }
    let dist = l.from;
    if (distance.len() > 0) {
      dist = distance[distance.len() - 1].result;
    }
    args = [receiver, dist, l.count];
    ci = 2;
  } else if (l.kind == FILL || l.kind == SLIDE) {
    args = [receiver, at, sp.count, l.value];
  } else if (l.kind == MOVE) {
    args = [receiver, at, from, sp.count];
  } else if (l.update.kind_tag == ssasem.with()) {
    let src = l.src;
    if (!ssasem.is_byte_view(values[src])) {
      src = values.len();
      values = values.append(contracts[1].params[2]);
      distance = distance.append(ssa.SInst { kind_tag: ssasem.array_lend(), result: src, args: [l.src], imm: 0, str: "" });
    }
    args = [receiver, at, src, from, sp.count];
    ci = 1;
  }
  let contract = contracts[ci];
  if (l.kind != COPY) {
    contract = kernel_contract(f, l);
  }
  let copied = values.len();
  values = values.append(f.values[l.array.result]);
  let call = copy_call(l, copied, args, contract.name);
  let blocks: ssa.SBlock[] = [];
  for old in f.graph.blocks {
    let b = old;
    if (b.id == l.step || util.has_i32(l.extra, b.id)) {
      continue;
    }
    if (b.id == l.head) {
      b = replaced_header(b, l, zero);
    } else if (b.id == l.body) {
      b = ssa.SBlock { ...b, insts: util.append_all(util.append_all(lifted_defs(ix, l), distance), [call]), term: ssa.STerm { ...b.term, kind_tag: ssa.TERM_BR, target: l.exit } };
    } else {
      b = outside(b, l, fresh);
      if (b.id == l.exit) {
        let phis = [
          ssa.SInst { kind_tag: ssa.PHI, result: l.array.result, args: [receiver, copied], imm: 0, str: "" },
          ssa.SInst { kind_tag: ssa.PHI, result: fresh, args: [zero, l.count], imm: 0, str: "" },
        ];
        b = ssa.SBlock { ...b, preds: [l.head, l.body], insts: util.append_all(phis, b.insts) };
      }
    }
    blocks = blocks.append(b);
  }
  let calls = called(f.calls, l, contract);
  return ssasem.Func { ...f, source_positions: replaced_source(f.source_positions, l, copied), calls: calls, values: values, graph: ssa.SFunc { ...f.graph, nvals: values.len(), blocks: blocks } };
}

// A byte helper call, or a range concat with the same operands.
function copy_call(l: Loop, result: i32, args: i32[], helper: string): ssa.SInst {
  if (l.concat) {
    return ssa.SInst { ...l.update, result: result, kind_tag: ssasem.arr_concat(), args: args, str: "", imm: 0 };
  }
  return ssa.SInst { ...l.update, result: result, kind_tag: ssasem.call(), args: args, str: helper, imm: 0 };
}

function called(calls: ssasem.Contract[], l: Loop, helper: ssasem.Contract): ssasem.Contract[] {
  if (l.concat || ssasem.find_contract_in(calls, helper.name) >= 0) {
    return calls;
  }
  return calls.append(helper);
}

function lifted_defs(ix: Index, l: Loop): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  for v in l.lifted {
    out = out.append(ix.defs[v]);
  }
  return out;
}

// fill(a, at, n, v), slide(a, at, n, k) and move(a, at, from, n) consume
// the array, which they write in place when it is unique.
function kernel_contract(f: ssasem.Func, l: Loop): ssasem.Contract {
  let t = f.values[l.array.result];
  let i = typeinfo.t_i32();
  let v = ssasem.value_mode();
  let modes = [ssasem.counted_mode(), v, v, v];
  if (l.kind == FILL) {
    return ssasem.Contract { name: rtbytecopy.fill_name(l.shift), params: [t, i, i, f.values[l.value]], modes: modes, result: t };
  }
  if (l.kind == SLIDE) {
    return ssasem.Contract { name: rtbytecopy.slide_name(), params: [t, i, i, f.values[l.value]], modes: modes, result: t };
  }
  return ssasem.Contract { name: rtbytecopy.move_name(l.shift), params: [t, i, i, i], modes: modes, result: t };
}

// Two arrays of one element width share a kernel, so a function that has
// both keeps the loops of the second element type.
function contract_fits(calls: ssasem.Contract[], c: ssasem.Contract): boolean {
  let at = ssasem.find_contract_in(calls, c.name);
  return at < 0 || semtypes.equal(calls[at].params[0], c.params[0]) && semtypes.equal(calls[at].params[3], c.params[3]);
}

// The distance of a rebased back loop is the receiver's entry length minus from.
function rebased_distance(l: Loop, receiver: i32, next: i32): ssa.SInst[] {
  if (!l.rebased) {
    return [];
  }
  let len = ssa.SInst { kind_tag: ssasem.length(), result: next, args: [receiver], imm: 0, str: "" };
  if (l.from < 0) {
    return [len];
  }
  return [len, ssa.SInst { kind_tag: ssa.BINARY, result: next + 1, args: [next, l.from], imm: 0, str: "-" }];
}

// The header keeps its test, so an empty range makes no call. The
// copy runs in the body, and a phi in the exit joins its result.
function replaced_header(b: ssa.SBlock, l: Loop, zero: i32): ssa.SBlock {
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (util.index_of_i32(l.chain, ins.result) >= 0) {
      insts = insts.append(ins);
    }
  }
  for old in b.insts {
    let ins = old;
    if (util.index_of_i32(l.chain, ins.result) < 0 && ins.result != l.array.result) {
      if (ins.result == l.counter.result) {
        ins = copy(ins.result, zero);
      }
      insts = insts.append(ins);
    }
  }
  return ssa.SBlock { ...b, insts: insts, preds: [b.preds[l.outer]] };
}

function replaced_source(source: sourcepos.SourceInfo, l: Loop, copied: i32): sourcepos.SourceInfo {
  if (source.entry.line == 0) {
    return source;
  }
  let values = source.values;
  while (values.len() <= copied) {
    values = values.append(sourcepos.SourcePos { line: 0, col: "0" });
  }
  return sourcepos.SourceInfo { ...source, values: values.with(copied, sourcepos.at(source.values, l.update.result)) };
}
