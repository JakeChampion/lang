import "./parser";
import "./util";

// Component paths retain callback environment loans through aggregate values.

pub function path(base: string, part: string): string {
  if (base.len() == 0) {
    return part;
  }
  if (part.len() == 0) {
    return base;
  }
  return base + "/" + part;
}

pub function path_head(projection: string): string {
  let at = util.index_of_sub(projection, "/");
  return if (at < 0) { projection } else { slice_unchecked(projection, 0, at) + "" };
}

pub function path_tail(projection: string): string {
  let at = util.index_of_sub(projection, "/");
  return if (at < 0) { "" } else { slice_unchecked(projection, at + 1, projection.len()) + "" };
}

pub function selectors_match(a: string, b: string): boolean {
  return a == b || a.starts_with("a:") && b.starts_with("a:") && (a == "a:*" || b == "a:*" || a.starts_with("a:$") || b.starts_with("a:$"));
}

pub function field(name: string): string {
  if (name.len() > 0 && name[0] >= b'0' && name[0] <= b'9') {
    return "t:" + name;
  }
  return "f:" + name;
}

function type_name(ty: string): string {
  let at = util.index_of_sub(ty, "[");
  if (at > 0) {
    return slice_unchecked(ty, 0, at) + "";
  }
  return ty;
}

function type_args(ty: string): string[] {
  let at = util.index_of_sub(ty, "[");
  if (at > 0 && ty[ty.len() - 1] == b']') {
    return parser.split_top_commas(slice_unchecked(ty, at + 1, ty.len() - 1) + "");
  }
  return [];
}

function declaration(structs: parser.StructDecl[], name: string): Option[parser.StructDecl] {
  for decl in structs {
    if (decl.name == name || decl.enum_owner.len() > 0 && decl.enum_owner + "." + decl.name == name) {
      return Some(decl);
    }
  }
  return None;
}

function projection_type_in(structs: parser.StructDecl[], ty: string, part: string): string {
  let arrow = parser.top_arrow_at(ty);
  if (part == "r:*" && arrow >= 0) {
    return (slice_unchecked(ty, arrow + 2, ty.len()) + "").trim();
  }
  if (part.starts_with("a:")) {
    if (ty.len() > 2 && ty[ty.len() - 1] == b']' && ty[ty.len() - 2] == b'[') {
      return slice_unchecked(ty, 0, ty.len() - 2) + "";
    }
    if (ty.len() > 2 && ty[0] == b'[') {
      return slice_unchecked(ty, 1, ty.len() - 1) + "";
    }
  }
  if (part.starts_with("t:") && ty.len() > 2 && ty[0] == b'(') {
    let parts = parser.split_top_commas(slice_unchecked(ty, 1, ty.len() - 1) + "");
    let index = util.lit_to_i32(slice_unchecked(part, 2, part.len()) + "");
    if (index >= 0 && index < parts.len()) {
      return parts[index];
    }
  }
  let args = type_args(ty);
  if let Some(decl) = declaration(structs, type_name(ty)) {
    for member in decl.fields {
      if (part == "f:" + member.name) {
        if (args.len() == decl.type_params.len()) {
          return parser.subst_ty(parser.fn_tag_spelling(member.type_name, member.fn_ret, member.fn_param_types), decl.type_params, args);
        }
        return parser.fn_tag_spelling(member.type_name, member.fn_ret, member.fn_param_types);
      }
    }
  }
  if (part.starts_with("v:")) {
    return projection_variant_type(structs, ty, args, part);
  }
  return "";
}

function projection_variant_type(structs: parser.StructDecl[], ty: string, args: string[], part: string): string {
  let parts = util.split_char(part, b':');
  if (parts.len() == 3) {
    let slot = util.lit_to_i32(parts[2]);
    if ((type_name(ty) == "Option" || type_name(ty) == "Result") && args.len() > 0) {
      let index = if (parts[1] == "Err") { 1 } else { 0 };
      if (index < args.len()) {
        return args[index];
      }
    }
    if let Some(decl) = declaration(structs, parts[1]) {
      if (slot >= 0 && slot < decl.fields.len()) {
        if (args.len() == decl.type_params.len()) {
          return parser.subst_ty(decl.fields[slot].type_name, decl.type_params, args);
        }
        return decl.fields[slot].type_name;
      }
    }
  }
  return "";
}

// Fold recursive descendants at the first repeated nominal type.

pub function bound_callback_path(structs: parser.StructDecl[], ty: string, projection: string): (string, boolean) {
  let current = ty;
  let seen: string[] = [];
  let out = "";
  if (projection.len() == 0) {
    return (out, false);
  }
  for part in util.split_char(projection, b'/') {
    if (current.len() == 0) {
      return (out, true);
    }
    let nominal = current[0] != b'(' && current[0] != b'[' && !(current.len() > 2 && slice_unchecked(current, current.len() - 2, current.len()) == "[]");
    if (nominal) {
      let name = type_name(current);
      if (util.has_str(seen, name)) {
        return (out, true);
      }
      seen = seen.append(name);
    }
    current = projection_type_in(structs, current, part);
    out = path(out, part);
  }
  return (out, false);
}
