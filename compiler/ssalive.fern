import "./ssa";

pub struct Flow {
  ok: boolean,
  why: string,
  words: i32,
  live_in: i64[],
  live_out: i64[],
  slot: i32[],
  slot_value: i32[],
  at: i32[],
  none: boolean[],
}

function failed(why: string): Flow {
  return Flow { ok: false, why: why, words: 0, live_in: [], live_out: [], slot: [], slot_value: [], at: [], none: [] };
}

pub function position(fl: Flow, id: i32): i32 {
  return block_index(fl.at, id);
}

pub function live_in_has(fl: Flow, bi: i32, v: i32): boolean {
  return bit_has(fl.live_in, bi * fl.words, slot_of(fl, v));
}

pub function live_out_has(fl: Flow, bi: i32, v: i32): boolean {
  return bit_has(fl.live_out, bi * fl.words, slot_of(fl, v));
}

function slot_of(fl: Flow, v: i32): i32 {
  if (v < 0 || v >= fl.slot.len()) {
    return -1;
  }
  return fl.slot[v];
}

pub function live_in_ids(fl: Flow, bi: i32): i32[] {
  return set_ids(fl.live_in, bi * fl.words, [], 0, fl.words, fl.slot_value);
}

pub function live_out_ids(fl: Flow, bi: i32): i32[] {
  return set_ids(fl.live_out, bi * fl.words, [], 0, fl.words, fl.slot_value);
}

pub function out_not_in(fl: Flow, bi: i32, si: i32): i32[] {
  return set_ids(fl.live_out, bi * fl.words, fl.live_in, si * fl.words, fl.words, fl.slot_value);
}

function set_ids(rows: i64[], base: i32, minus: i64[], mbase: i32, words: i32, values: i32[]): i32[] {
  if (rows.len() == 0) {
    return [];
  }
  let n = 0;
  let w = 0;
  while (w < words) {
    n += __popcount64(set_word(rows, base, minus, mbase, w) as u64);
    w += 1;
  }
  let out = __alloc_i32(n);
  let k = 0;
  w = 0;
  while (w < words) {
    let x = set_word(rows, base, minus, mbase, w);
    while (x != 0i64) {
      out = out.with(k, values[w * 64 + __ctz64(x as u64)]);
      k += 1;
      x = x & x - 1i64;
    }
    w += 1;
  }
  return out;
}

function set_word(rows: i64[], base: i32, minus: i64[], mbase: i32, w: i32): i64 {
  let x = rows[base + w];
  if (minus.len() != 0) {
    x = x & (minus[mbase + w] ^ 0i64 - 1i64);
  }
  return x;
}

pub function live_in_bits(fl: Flow, nblocks: i32, nvals: i32): boolean[] {
  return spelled(fl, fl.live_in, nblocks, nvals);
}

pub function live_out_bits(fl: Flow, nblocks: i32, nvals: i32): boolean[] {
  return spelled(fl, fl.live_out, nblocks, nvals);
}

function spelled(fl: Flow, rows: i64[], nblocks: i32, nvals: i32): boolean[] {
  let out: boolean[] = [];
  let bi = 0;
  while (bi < nblocks) {
    let v = 0;
    while (v < nvals) {
      out = out.append(bit_has(rows, bi * fl.words, slot_of(fl, v)));
      v += 1;
    }
    bi += 1;
  }
  return out;
}

function bit_has(rows: i64[], base: i32, v: i32): boolean {
  if (v < 0 || rows.len() == 0) {
    return false;
  }
  return (rows[base + v / 64] >> (v % 64) as i64 & 1i64) != 0i64;
}

function bit_set(own rows: i64[], base: i32, v: i32): i64[] {
  if (v < 0) {
    return rows;
  }
  let w = base + v / 64;
  return rows.with(w, rows[w] | 1i64 << (v % 64) as i64);
}

function block_index(at: i32[], id: i32): i32 {
  if (id < 0 || id >= at.len()) {
    return -1;
  }
  return at[id];
}

function pred_index(b: ssa.SBlock, id: i32): i32 {
  let i = 0;
  while (i < b.preds.len()) {
    if (b.preds[i] == id) {
      return i;
    }
    i += 1;
  }
  return -1;
}

function successor(t: ssa.STerm, which: i32): i32 {
  if (t.kind_tag == ssa.TERM_BR && which == 0) {
    return t.target;
  }
  if (t.kind_tag == ssa.TERM_BRIF) {
    if (which == 0) {
      return t.t;
    }
    return t.f;
  }
  return -1;
}

pub function input_error(f: ssa.SFunc, dependencies: i32[][]): string {
  let why = dependency_error(f, dependencies);
  if (why != "") {
    return why;
  }
  return graph_error(f);
}

pub function dependency_error(f: ssa.SFunc, dependencies: i32[][]): string {
  if (f.nvals < 0 || dependencies.len() != f.nvals) {
    return "dependency dimensions";
  }
  for deps in dependencies {
    for value in deps {
      if (value < 0 || value >= f.nvals) {
        return "dependency value out of range";
      }
    }
  }
  return "";
}

pub function graph_error(f: ssa.SFunc): string {
  if (f.nvals < 0) {
    return "dependency dimensions";
  }
  let at = ssa.block_positions(f);
  if (block_index(at, f.entry) < 0) {
    return "missing entry block";
  }
  if (f.nvals > 0 && f.blocks.len() > 2147483647 / f.nvals) {
    return "live matrix overflow";
  }
  let bi = 0;
  while (bi < f.blocks.len()) {
    let b = f.blocks[bi];
    if (b.id < 0 || block_index(at, b.id) != bi) {
      return "duplicate or negative block id";
    }
    if (b.term.kind_tag < ssa.TERM_RET || b.term.kind_tag > ssa.TERM_UNREACHABLE) {
      return "invalid terminator";
    }
    if (b.term.kind_tag == ssa.TERM_RET && (b.term.value < -1 || b.term.value >= f.nvals)) {
      return "return value out of range";
    }
    if (b.term.kind_tag == ssa.TERM_BRIF && (b.term.cond < 0 || b.term.cond >= f.nvals)) {
      return "condition value out of range";
    }
    let pi = 0;
    while (pi < b.preds.len()) {
      let pb = block_index(at, b.preds[pi]);
      if (pb < 0 || pred_index(b, b.preds[pi]) != pi) {
        return "invalid predecessor";
      }
      let pt = f.blocks[pb].term;
      if (successor(pt, 0) != b.id && successor(pt, 1) != b.id) {
        return "predecessor is not an edge";
      }
      pi += 1;
    }
    for ins in b.insts {
      if (ins.result < -1 || ins.result >= f.nvals) {
        return "result value out of range";
      }
      if (ins.kind_tag == ssa.PHI && ins.args.len() != b.preds.len()) {
        return "phi predecessor arity";
      }
      for arg in ins.args {
        if (arg < 0 || arg >= f.nvals) {
          return "operand value out of range";
        }
      }
    }
    let si = 0;
    while (si < 2) {
      let target = successor(b.term, si);
      if (target >= 0) {
        let sb = block_index(at, target);
        if (sb < 0) {
          return "missing successor";
        }
        if (pred_index(f.blocks[sb], b.id) < 0) {
          return "missing predecessor edge";
        }
      } else if (b.term.kind_tag == ssa.TERM_BRIF || b.term.kind_tag == ssa.TERM_BR && si == 0) {
        return "negative successor";
      }
      si += 1;
    }
    bi += 1;
  }
  return "";
}

function add_use(own bits: i64[], slot: i32[], value: i32, dependencies: i32[][]): i64[] {
  if (value < 0) {
    return bits;
  }
  bits = bit_set(bits, 0, slot[value]);
  for dep in dependencies[value] {
    bits = bit_set(bits, 0, slot[dep]);
  }
  return bits;
}

function named_with(own named: boolean[], value: i32, dependencies: i32[][]): boolean[] {
  if (value < 0) {
    return named;
  }
  named = named.with(value, true);
  for dep in dependencies[value] {
    named = named.with(dep, true);
  }
  return named;
}

function exposed(own up: i32[], def_b: i32[], def_k: i32[], bi: i32, k: i32, value: i32, dependencies: i32[][]): i32[] {
  if (value < 0) {
    return up;
  }
  if (def_b[value] != bi || def_k[value] >= k) {
    up = up.append(value);
  }
  for dep in dependencies[value] {
    if (def_b[dep] != bi || def_k[dep] >= k) {
      up = up.append(dep);
    }
  }
  return up;
}

// For each value, whether it is live just after a call that `hard` marks, by
// position. A value is not live after the call that defines it. Empty when
// the liveness cannot be computed.
pub function call_crossers(f: ssa.SFunc, hard: boolean[]): boolean[] {
  let none: i32[][] = [];
  for v in 0..f.nvals {
    none = none.append([]);
  }
  let fl = compute(f, none);
  if (!fl.ok) {
    return [];
  }
  let w = Cross { live: __alloc_bool(f.nvals), out: __alloc_bool(f.nvals) };
  let start = 0;
  for bi in 0..f.blocks.len() {
    let b = f.blocks[bi];
    if (any_hard(hard, start, b.insts.len())) {
      w = crossers_in(w, live_out_ids(fl, bi), b, start, hard);
    }
    start = start + b.insts.len() + 1;
  }
  return w.out;
}

// `live` is all false between blocks. The walk of one block lists each value
// it marks live, and clears them at its end.
struct Cross { live: boolean[], out: boolean[] }

function crossers_in(own w: Cross, live_out: i32[], b: ssa.SBlock, start: i32, hard: boolean[]): Cross {
  let live = w.live;
  let out = w.out;
  let seen = live_out.append(term_use(b.term));
  for v in seen {
    live = mark_live(live, v);
  }
  let k = b.insts.len();
  while (k > 0) {
    k -= 1;
    let ins = b.insts[k];
    live = mark_dead(live, ins.result);
    if (start + k < hard.len() && hard[start + k]) {
      out = marked_live(out, live, seen);
    }
    if (ins.kind_tag != ssa.PHI) {
      for arg in ins.args {
        if (arg >= 0 && !live[arg]) {
          live = live.with(arg, true);
          seen = seen.append(arg);
        }
      }
    }
  }
  for v in seen {
    live = mark_dead(live, v);
  }
  return Cross { live: live, out: out };
}

function marked_live(own out: boolean[], live: boolean[], seen: i32[]): boolean[] {
  for v in seen {
    if (v >= 0 && live[v]) {
      out = out.with(v, true);
    }
  }
  return out;
}

// The value a terminator reads, or -1.
function term_use(t: ssa.STerm): i32 {
  if (t.kind_tag == ssa.TERM_RET) {
    return t.value;
  }
  if (t.kind_tag == ssa.TERM_BRIF) {
    return t.cond;
  }
  return -1;
}

function mark_live(own live: boolean[], v: i32): boolean[] {
  if (v < 0) {
    return live;
  }
  return live.with(v, true);
}

function mark_dead(own live: boolean[], v: i32): boolean[] {
  if (v < 0) {
    return live;
  }
  return live.with(v, false);
}

function any_hard(hard: boolean[], start: i32, n: i32): boolean {
  for k in start..start + n {
    if (k < hard.len() && hard[k]) {
      return true;
    }
  }
  return false;
}

pub function compute(f: ssa.SFunc, dependencies: i32[][]): Flow {
  return compute_kept(f, dependencies, []);
}

pub function compute_kept(f: ssa.SFunc, dependencies: i32[][], keep: boolean[]): Flow {
  let why = input_error(f, dependencies);
  if (why != "") {
    return failed(why);
  }
  return compute_checked_kept(f, dependencies, keep);
}

pub function compute_checked(f: ssa.SFunc, dependencies: i32[][]): Flow {
  return compute_checked_kept(f, dependencies, []);
}

pub function compute_checked_kept(f: ssa.SFunc, dependencies: i32[][], keep: boolean[]): Flow {
  let nb = f.blocks.len();
  let at = ssa.block_positions(f);
  let def_b = __alloc_i32(f.nvals);
  let def_k = __alloc_i32(f.nvals);
  let v = 0;
  while (v < f.nvals) {
    def_b = def_b.with(v, -1);
    v += 1;
  }
  let bi = 0;
  while (bi < nb) {
    let k = 0;
    for ins in f.blocks[bi].insts {
      if (ins.result >= 0) {
        def_b = def_b.with(ins.result, bi);
        def_k = def_k.with(ins.result, k);
      }
      k += 1;
    }
    bi += 1;
  }
  let up: i32[] = [];
  let up_from: i32[] = [];
  let named = __alloc_bool(f.nvals);
  let phi_at: i32[] = [];
  let phi_from: i32[] = [];
  bi = 0;
  while (bi < nb) {
    let b = f.blocks[bi];
    up_from = up_from.append(up.len());
    phi_from = phi_from.append(phi_at.len());
    let k = 0;
    for ins in b.insts {
      if (ins.kind_tag != ssa.PHI) {
        for arg in ins.args {
          up = exposed(up, def_b, def_k, bi, k, arg, dependencies);
        }
      } else {
        phi_at = phi_at.append(k);
        for arg in ins.args {
          named = named_with(named, arg, dependencies);
        }
      }
      k += 1;
    }
    if (b.term.kind_tag == ssa.TERM_RET) {
      up = exposed(up, def_b, def_k, bi, b.insts.len(), b.term.value, dependencies);
    }
    if (b.term.kind_tag == ssa.TERM_BRIF) {
      up = exposed(up, def_b, def_k, bi, b.insts.len(), b.term.cond, dependencies);
    }
    bi += 1;
  }
  up_from = up_from.append(up.len());
  phi_from = phi_from.append(phi_at.len());
  for u in up {
    named = named.with(u, true);
  }
  let slot = __alloc_i32(f.nvals);
  let slot_value: i32[] = [];
  v = 0;
  while (v < f.nvals) {
    if (named[v] && (keep.len() == 0 || keep[v])) {
      slot = slot.with(v, slot_value.len());
      slot_value = slot_value.append(v);
    } else {
      slot = slot.with(v, -1);
    }
    v += 1;
  }
  let words: i32 = (slot_value.len() + 63) / 64;
  let uses = __alloc_i64(nb * words);
  let defs = __alloc_i64(nb * words);
  bi = 0;
  while (bi < nb) {
    let j = up_from[bi];
    while (j < up_from[bi + 1]) {
      uses = bit_set(uses, bi * words, slot[up[j]]);
      j += 1;
    }
    bi += 1;
  }
  for sv in slot_value {
    if (def_b[sv] >= 0) {
      defs = bit_set(defs, def_b[sv] * words, slot[sv]);
    }
  }
  let live_in = __alloc_i64(nb * words);
  let live_out = __alloc_i64(nb * words);
  let row = __alloc_i64(words);
  let dirty: boolean[] = [];
  bi = 0;
  while (bi < nb) {
    dirty = dirty.append(true);
    bi += 1;
  }
  let pending = nb;
  while (pending > 0) {
    bi = nb - 1;
    while (bi >= 0) {
      if (!dirty[bi]) {
        bi -= 1;
        continue;
      }
      dirty = dirty.with(bi, false);
      pending -= 1;
      let b = f.blocks[bi];
      let base = bi * words;
      let w = 0;
      let seeded = false;
      let si = 0;
      while (si < 2) {
        let target = successor(b.term, si);
        if (target >= 0) {
          let sb = at[target];
          w = 0;
          if (seeded) {
            while (w < words) {
              row = row.with(w, row[w] | live_in[sb * words + w]);
              w += 1;
            }
          } else {
            while (w < words) {
              row = row.with(w, live_in[sb * words + w]);
              w += 1;
            }
          }
          seeded = true;
          let pj = phi_from[sb];
          if (pj < phi_from[sb + 1]) {
            let pi = pred_index(f.blocks[sb], b.id);
            while (pj < phi_from[sb + 1]) {
              row = add_use(row, slot, f.blocks[sb].insts[phi_at[pj]].args[pi], dependencies);
              pj += 1;
            }
          }
        }
        si += 1;
      }
      if (!seeded) {
        w = 0;
        while (w < words) {
          row = row.with(w, 0i64);
          w += 1;
        }
      }
      let grew = false;
      w = 0;
      while (w < words) {
        if (row[w] != live_out[base + w]) {
          live_out = live_out.with(base + w, row[w]);
        }
        let inw = uses[base + w] | row[w] & (defs[base + w] ^ 0i64 - 1i64);
        if (inw != live_in[base + w]) {
          live_in = live_in.with(base + w, inw);
          grew = true;
        }
        w += 1;
      }
      if (grew) {
        for pid in b.preds {
          let p = at[pid];
          if (!dirty[p]) {
            dirty = dirty.with(p, true);
            pending += 1;
          }
        }
      }
      bi -= 1;
    }
  }
  return Flow { ok: true, why: "", words: words, live_in: live_in, live_out: live_out, slot: slot, slot_value: slot_value, at: at, none: __alloc_bool(f.nvals) };
}
