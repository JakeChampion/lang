import "./typeinfo";
import "./semtypes";
import "./util";

pub struct Field { name: string, ty: typeinfo.Type }

pub struct Record { ty: typeinfo.Type, fields: Field[], views: boolean, nests_func: boolean }

pub struct Records { list: Record[], names: util.NameIndex }

pub function records_of(list: Record[]): Records {
  let names: string[] = [];
  for r in list {
    names = names.append(record_name(r));
  }
  return Records { list: list, names: util.name_index(names) };
}

pub function no_records(): Records {
  let none: Record[] = [];
  return records_of(none);
}

pub struct Variant { name: string, fields: Field[] }

pub struct Enum { ty: typeinfo.Type, variants: Variant[], layout: i32, views: boolean, nests_func: boolean }

pub function layout_variant(): i32 {
  return 1;
}

pub function layout_member(): i32 {
  return 2;
}

pub function layout_option(): i32 {
  return 3;
}

pub function find(records: Records, ty: typeinfo.Type): i32 {
  if let typeinfo.TypeStruct(s) = ty {
    return find_struct(records, s.name, ty);
  }
  return 0 - 1;
}

pub function find_named(list: Record[], names: util.NameIndex, name: string, ty: typeinfo.Type): i32 {
  let i: i32 = names.chain(name);
  while (i >= 0) {
    if (names.names[i] == name && semtypes.equal(list[i].ty, ty)) {
      return i;
    }
    i = names.next[i];
  }
  return 0 - 1;
}

pub function find_named_enum(list: Enum[], names: util.NameIndex, name: string, ty: typeinfo.Type): i32 {
  let i: i32 = names.chain(name);
  while (i >= 0) {
    if (names.names[i] == name && semtypes.equal(list[i].ty, ty)) {
      return i;
    }
    i = names.next[i];
  }
  return 0 - 1;
}

pub function union_name_of(t: typeinfo.Type): string {
  if let typeinfo.TypeUnion(u) = t {
    return u.name;
  }
  return "";
}

pub function name_of(t: typeinfo.Type): string {
  if let typeinfo.TypeStruct(s) = t {
    return s.name;
  }
  return "";
}

pub function find_enum(enums: Enum[], ty: typeinfo.Type): i32 {
  if let typeinfo.TypeUnion(u) = ty {
    return find_union(enums, u.name, ty);
  }
  return 0 - 1;
}

function find_struct(records: Records, name: string, ty: typeinfo.Type): i32 {
  let i: i32 = records.names.chain(name);
  while (i >= 0) {
    if (records.names.names[i] == name && semtypes.equal(records.list[i].ty, ty)) {
      return i;
    }
    i = records.names.next[i];
  }
  return 0 - 1;
}

function find_union(enums: Enum[], name: string, ty: typeinfo.Type): i32 {
  let i: i32 = 0;
  while (i < enums.len()) {
    if let typeinfo.TypeUnion(e) = enums[i].ty {
      if (e.name == name && semtypes.equal(enums[i].ty, ty)) {
        return i;
      }
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function find_variant(e: Enum, name: string): i32 {
  let i: i32 = 0;
  while (i < e.variants.len()) {
    if (e.variants[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function resolved_all(types: typeinfo.Type[], records: Records, enums: Enum[]): boolean {
  for ty in types {
    if (!resolved(ty, records, enums)) {
      return false;
    }
  }
  return true;
}

function resolved(ty: typeinfo.Type, records: Records, enums: Enum[]): boolean {
  if (semtypes.is_cell(ty)) {
    return resolved(semtypes.cell_elem(ty), records, enums);
  }
  if (semtypes.is_handle(ty)) {
    return true;
  }
  if let typeinfo.TypeStruct(s) = ty {
    return find(records, ty) >= 0 && resolved_all(s.args, records, enums);
  }
  if let typeinfo.TypeUnion(u) = ty {
    return find_enum(enums, ty) >= 0 && resolved_all(u.args, records, enums);
  }
  return resolved_structural(ty, records, enums);
}

function resolved_structural(ty: typeinfo.Type, records: Records, enums: Enum[]): boolean {
  if let typeinfo.TypeArray(a) = ty {
    return resolved(a.elem, records, enums);
  }
  if let typeinfo.TypeTuple(t) = ty {
    return resolved_all(t.elements, records, enums);
  }
  if let typeinfo.TypeMap(m) = ty {
    return resolved(m.key, records, enums) && resolved(m.value, records, enums);
  }
  if let typeinfo.TypeFunc(f) = ty {
    return resolved_all(f.param_types, records, enums) && resolved(f.ret_type, records, enums);
  }
  return true;
}

function fields_error(fields: Field[], records: Records, enums: Enum[], variant: boolean): string {
  let i: i32 = 0;
  while (i < fields.len()) {
    let field: Field = fields[i];
    if (field.name == "") {
      return "empty record field name";
    }
    if (!semtypes.concrete(field.ty, false) && !(variant && semtypes.is_never(field.ty))) {
      return "unresolved record field type";
    }
    if (!resolved(field.ty, records, enums)) {
      return "missing nested record schema";
    }
    let j: i32 = 0;
    while (j < i) {
      if (fields[j].name == field.name) {
        return "duplicate record field name";
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return "";
}

function instance_error(a: Record, b: Record): string {
  if (semtypes.equal(a.ty, b.ty)) {
    return "duplicate record schema";
  }
  if let typeinfo.TypeStruct(x) = a.ty {
    if let typeinfo.TypeStruct(y) = b.ty {
      if (x.name != y.name) {
        return "";
      }
      if (x.args.len() != y.args.len() || a.fields.len() != b.fields.len()) {
        return "inconsistent record instance schema";
      }
      let i: i32 = 0;
      while (i < a.fields.len()) {
        if (a.fields[i].name != b.fields[i].name) {
          return "inconsistent record instance schema";
        }
        i = i + 1;
      }
    }
  }
  return "";
}

pub function record_name(r: Record): string {
  if let typeinfo.TypeStruct(s) = r.ty {
    return s.name;
  }
  return "";
}

function records_error(records: Records, enums: Enum[]): string {
  let i: i32 = 0;
  while (i < records.list.len()) {
    let record: Record = records.list[i];
    if (!semtypes.concrete(record.ty, false)) {
      return "unresolved record identity";
    }
    if let typeinfo.TypeStruct(_) = record.ty {} else {
      return "non-nominal record identity";
    }
    let name: string = record_name(record);
    let j: i32 = records.names.chain(name);
    while (j >= 0 && j < i) {
      if (records.names.names[j] == name) {
        let clash: string = instance_error(record, records.list[j]);
        if (clash != "") {
          return clash;
        }
      }
      j = records.names.next[j];
    }
    let why: string = fields_error(record.fields, records, enums, false);
    if (why != "") {
      return why;
    }
    i = i + 1;
  }
  return "";
}

pub function inhabited(v: Variant): boolean {
  for field in v.fields {
    if (semtypes.is_never(field.ty)) {
      return false;
    }
  }
  return true;
}

function variants_error(variants: Variant[], records: Records, enums: Enum[]): string {
  let i: i32 = 0;
  while (i < variants.len()) {
    if (variants[i].name == "") {
      return "empty variant name";
    }
    let j: i32 = 0;
    while (j < i) {
      if (variants[j].name == variants[i].name) {
        return "duplicate variant name";
      }
      j = j + 1;
    }
    let why: string = fields_error(variants[i].fields, records, enums, true);
    if (why != "") {
      return why;
    }
    i = i + 1;
  }
  return "";
}

function layout_error(e: Enum, records: Records): string {
  if (e.layout == layout_option()) {
    return option_layout_error(e);
  }
  if (e.layout != layout_variant() && e.layout != layout_member()) {
    return "unknown enum layout";
  }
  if (e.layout != layout_member()) {
    return "";
  }
  for v in e.variants {
    let at: i32 = records.names.find(v.name);
    if (at < 0) {
      return "missing union member record";
    }
    if (!same_fields(records.list[at].fields, v.fields)) {
      return "inconsistent union member record";
    }
  }
  return "";
}

function option_layout_error(e: Enum): string {
  if (e.variants.len() != 2) {
    return "builtin union arity";
  }
  let first: string = e.variants[0].name;
  let second: string = e.variants[1].name;
  if (first != "Some" && first != "Ok") {
    return "builtin union variant order";
  }
  if (second != "None" && second != "Err") {
    return "builtin union variant order";
  }
  for v in e.variants {
    if (v.fields.len() > 1) {
      return "builtin union payload arity";
    }
  }
  return "";
}

function same_fields(a: Field[], b: Field[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i].name != b[i].name || !semtypes.equal(a[i].ty, b[i].ty)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function enums_error(records: Records, enums: Enum[]): string {
  let i: i32 = 0;
  while (i < enums.len()) {
    let e: Enum = enums[i];
    if (!semtypes.concrete(e.ty, false)) {
      return "unresolved enum identity";
    }
    if let typeinfo.TypeUnion(_) = e.ty {} else {
      return "non-union enum identity";
    }
    let j: i32 = 0;
    while (j < i) {
      if (semtypes.equal(e.ty, enums[j].ty)) {
        return "duplicate enum schema";
      }
      j = j + 1;
    }
    let why: string = variants_error(e.variants, records, enums);
    if (why != "") {
      return why;
    }
    why = layout_error(e, records);
    if (why != "") {
      return why;
    }
    i = i + 1;
  }
  return "";
}

pub function verify(records: Records, enums: Enum[]): string {
  let why: string = records_error(records, enums);
  if (why != "") {
    return why;
  }
  return enums_error(records, enums);
}
