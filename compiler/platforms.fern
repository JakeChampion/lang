pub function core_builtins(): string[] {
  return [
    "__outer_mul_f64",
    "__inner_mul_add_f64",
    "exit", "isatty", "target_os", "target_arch",
    "__account_entry",
    "__ct_secret", "__ct_public",
    "__bytes_owned", "__bytes_range", "__bytes_into",
    "__aes_expand_key", "__aes_ctr32", "__ghash", "__aes_gcm_seal_into", "__aes_gcm_open_into", "__sha256_hw", "__sha256_hw_blocks", "__sha1_hw", "__sha1_hw_blocks",
    "map_new", "cell_new", "__send_copy", "__send_adopt", "__send_root", "__send_release", "string_from_bytes_unchecked", "string_from_bytes_range_unchecked",
    "slice_unchecked",
    "buf_new", "buf_push", "buf_push_range", "buf_push_bytes_range", "buf_push_mapped", "buf_push_filtered", "buf_push_expanded", "buf_push_bytes_mapped", "buf_push_bytes_filtered", "buf_push_bytes_expanded", "buf_push_byte", "buf_push_u64", "buf_push_decimal", "buf_push_base64", "buf_push_base32", "buf_decode_base32",
    "buf_len", "buf_take", "buf_take_bytes", "buf_clear", "buf_free",
    "f32_bits", "f32_from_bits", "f64_bits", "f64_from_bits",
  ];
}

pub function core_builtin(name: string): boolean {
  return util.has_str(core_builtins(), name);
}

pub function gated_capability(name: string): string {
  let gates = gated_builtins();
  let i = 0;
  while (i < gates.len()) {
    if (gates[i].builtin == name) {
      return gates[i].capability;
    }
    i += 1;
  }
  return "";
}

// The capabilities that a module can provide with @provide, and the signature
// of each provider. A `log` provider is a byte sink that does not allocate.
pub function providable(): string[] {
  return ["log", "exit"];
}

pub function provider_signature(capability: string): string {
  if (capability == "log") {
    return "(data: usize, len: i32): void";
  }
  if (capability == "exit") {
    return "(code: i32): void";
  }
  return "";
}

// Whether the program's provider of `capability` is the implementation on
// `target`. The target's own implementation wins: a `log` provider serves a
// target that does not grant `log`, and an `exit` provider serves a target
// whose entry is not a process, because only a process can exit through its
// kernel.
pub function provider_used(target: string, capability: string): boolean {
  if (capability == "exit") {
    return entry_shape(target) != "process";
  }
  return !has_capability(target, capability);
}

// The capabilities that a provider in the program adds to the target's set.
pub function provided(mod: parser.Module): string[] {
  let out: string[] = [];
  for pv in parser.marked(mod, "provide") {
    if (util.has_str(providable(), pv.arg) && !util.has_str(out, pv.arg)) {
      out = out.append(pv.arg);
    }
  }
  return out;
}

pub function forbidden_gates(target: string, provided_caps: string[]): Gate[] {
  let out: Gate[] = [];
  let d = for_target(target);
  if (!d.known) {
    return out;
  }
  let gates = gated_builtins();
  let i = 0;
  while (i < gates.len()) {
    if (!util.has_str(d.capabilities, gates[i].capability) && !util.has_str(provided_caps, gates[i].capability)) {
      out = out.append(gates[i]);
    }
    i += 1;
  }
  return out;
}

pub struct Violation {
  builtin: string,
  capability: string,
  target: string,
  line: i32,
  col: i32,
  fn_name: string,
  fn_module: string,
}

pub function enforce(mod: parser.Module, target: string): Violation[] {
  let out: Violation[] = [];
  let forbidden = forbidden_gates(target, provided(mod));
  if (forbidden.len() == 0) {
    return out;
  }
  let wanted: string[] = [];
  let wi = 0;
  while (wi < forbidden.len()) {
    wanted = wanted.append(forbidden[wi].builtin);
    wi += 1;
  }
  let want = util.name_index(wanted);

  let fi = 0;
  while (fi < mod.funcs.len()) {
    let fd = mod.funcs[fi];
    let calls: astwalk.CallSite[] = [];
    let bi = 0;
    while (bi < fd.body.len()) {
      calls = astwalk.collect_calls_stmt(fd.body[bi], want, calls);
      bi += 1;
    }
    let seen: string[] = [];
    let ci = 0;
    while (ci < calls.len()) {
      let gi = 0;
      while (gi < forbidden.len()) {
        if (!calls[ci].method && calls[ci].name == forbidden[gi].builtin && !util.has_str(seen, calls[ci].name)) {
          seen = seen.append(calls[ci].name);
          out = out.append(Violation {
            builtin: forbidden[gi].builtin,
            capability: forbidden[gi].capability,
            target: target,
            line: calls[ci].line,
            col: calls[ci].col,
            fn_name: util.mangled_name(fd.name),
            fn_module: util.mangled_module(fd.name),
          });
        }
        gi += 1;
      }
      ci += 1;
    }
    fi += 1;
  }
  return out;
}

pub function reach(mod: parser.Module): string[] {
  let gates = gated_builtins();
  let wanted: string[] = [];
  let wi = 0;
  while (wi < gates.len()) {
    wanted = wanted.append(gates[wi].builtin);
    wi += 1;
  }
  let want = util.name_index(wanted);

  let found: string[] = [];
  let fi = 0;
  while (fi < mod.funcs.len()) {
    let calls: astwalk.CallSite[] = [];
    let bi = 0;
    while (bi < mod.funcs[fi].body.len()) {
      calls = astwalk.collect_calls_stmt(mod.funcs[fi].body[bi], want, calls);
      bi += 1;
    }
    let ci = 0;
    while (ci < calls.len()) {
      if (!calls[ci].method) {
        let cap = gated_capability(calls[ci].name);
        if (cap.len() > 0 && !util.has_str(found, cap)) {
          found = found.append(cap);
        }
      }
      ci += 1;
    }
    fi += 1;
  }
  return sorted(found);
}

function sorted(xs: string[]): string[] {
  let out: string[] = [];
  let i = 0;
  while (i < xs.len()) {
    let pos = 0;
    while (pos < out.len() && util.str_less(out[pos], xs[i])) {
      pos += 1;
    }
    let next: string[] = [];
    let j = 0;
    while (j < pos) {
      next = next.append(out[j]);
      j += 1;
    }
    next = next.append(xs[i]);
    while (j < out.len()) {
      next = next.append(out[j]);
      j += 1;
    }
    out = next;
    i += 1;
  }
  return out;
}

// The E101 diagnostics of the program's marks: a capability that takes no
// provider, a provider with the wrong signature, or two providers of one
// capability.
pub function provider_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  let seen_fn: string[] = [];
  for pv in parser.marked(mod, "provide") {
    let msg = provider_problem(mod, pv);
    let at = util.index_of_str(seen, pv.arg);
    if (msg.len() == 0 && at >= 0) {
      msg = "capability `" + pv.arg + "` has two providers, \"" + util.mangled_name(seen_fn[at]) + "\" and \"" + util.mangled_name(pv.func_name) + "\"";
    }
    if (msg.len() > 0) {
      out = out.append(util.violation_diag("E101", msg, util.mangled_module(pv.func_name), pv.line, pv.col));
    } else {
      seen = seen.append(pv.arg);
      seen_fn = seen_fn.append(pv.func_name);
    }
  }
  return out;
}

function provider_problem(mod: parser.Module, pv: parser.FuncMark): string {
  let sig = provider_signature(pv.arg);
  if (sig.len() == 0) {
    return "`@provide(\"" + pv.arg + "\")`: no capability `" + pv.arg + "` takes a provider; a provider can implement `log` or `exit`";
  }
  for fd in mod.funcs {
    if (fd.name == pv.func_name && fd.receiver_name.len() == 0 && fd.type_params.len() == 0 && fd.ret_type == "void" && provider_params(pv.arg, fd.params)) {
      return "";
    }
  }
  return "the `" + pv.arg + "` provider \"" + util.mangled_name(pv.func_name) + "\" must be a function with the signature " + sig;
}

function provider_params(capability: string, params: ast.ParamDecl[]): boolean {
  if (capability == "exit") {
    return params.len() == 1 && params[0].type_name == "i32";
  }
  return params.len() == 2 && params[0].type_name == "usize" && params[1].type_name == "i32";
}

pub function violation_diag(v: Violation): util.Diag {
  return util.violation_diag("E066", violation_message(v), v.fn_module, v.line, v.col);
}

pub function violation_message(v: Violation): string {
  let where = "";
  if (v.fn_module.len() > 0) {
    where = " (reached via \"" + v.fn_name + "\" from module \"" + v.fn_module + "\")";
  }
  let providers = targets_providing(v.capability);
  let list = "";
  let i = 0;
  while (i < providers.len()) {
    if (i > 0) {
      list += " ";
    }
    list += providers[i];
    i += 1;
  }
  let msg: string = "target \"" + v.target + "\" does not provide `" + v.capability + "`, required by `"
    + v.builtin + "`" + where + "; targets providing it: [" + list + "]";
  if (util.has_str(providable(), v.capability)) {
    msg = msg + "; or import a module with a `@provide(\"" + v.capability + "\")` function";
  }
  let alt = equivalent(v.builtin);
  if (alt.len() > 0 && has_capability(v.target, gated_capability(alt))) {
    msg = msg + "; use `" + alt + "`, which this target provides";
  }
  return msg;
}

function equivalent(builtin: string): string {
  if (builtin == "timer_fd") {
    return "wasm_timer_pollable";
  }
  if (builtin == "wasm_timer_pollable") {
    return "timer_fd";
  }
  return "";
}
