import "./parser";
import "./astwalk";
import "./util";

pub struct Descriptor {
  name: string,
  isa: string,
  environment: string,
  capabilities: string[],
  known: boolean,
}

function capability_profile(profile: string): string[] {
  if (profile == "hosted-linux") {
    return ["log", "now", "env", "config", "args", "random", "stdin", "stdout", "fs", "fsmode", "tcp", "proc", "arena", "pollfd", "cabi", "userid", "host", "sysinfo", "cwd", "signal", "rlimit", "sched", "fsinfo", "fsnode", "fsowner", "tty", "fssync", "fsrename", "fsdir", "xattr", "syscall", "rawmem", "subprocess", "unix", "reactor", "uring", "ktls"];
  }
  if (profile == "hosted-darwin") {
    return ["log", "now", "env", "config", "args", "random", "stdin", "stdout", "fs", "fsmode", "tcp", "proc", "arena", "pollfd", "cabi", "userid", "host", "sysinfo", "cwd", "signal", "rlimit", "sched", "fsinfo", "fsnode", "fsowner", "tty", "fssync", "fsrename", "fsdir", "xattr", "syscall", "rawmem", "subprocess", "unix", "reactor", "sysctl"];
  }
  if (profile == "wasi-cli") {
    return ["log", "now", "env", "config", "args", "random", "stdin", "stdout", "fs", "tcp", "host", "signal", "reactor", "pollable"];
  }
  if (profile == "wasi-proxy") {
    return ["log", "now", "config", "random", "fetch", "pollable"];
  }
  let empty: string[] = [];
  return empty;
}

function environment_profile(environment: string): string {
  if (environment == "linux" || environment == "android") {
    return "hosted-linux";
  }
  if (environment == "darwin") {
    return "hosted-darwin";
  }
  if (environment == "wasi") {
    return "wasi-cli";
  }
  if (environment == "wasi-http") {
    return "wasi-proxy";
  }
  if (environment == "freestanding") {
    return "none";
  }
  return "";
}

function target_environment(name: string): string {
  if (name == "x86-64-linux" || name == "arm64-linux") {
    return "linux";
  }
  if (name == "arm64-android") {
    return "android";
  }
  if (name == "arm64-darwin") {
    return "darwin";
  }
  if (name == "wasm32-wasi") {
    return "wasi";
  }
  if (name == "wasm32-wasi-http") {
    return "wasi-http";
  }
  if (name == "arm64-freestanding" || name == "x86-64-freestanding") {
    return "freestanding";
  }
  return "";
}

function target_isa(name: string): string {
  if (name == "x86-64-linux" || name == "x86-64-freestanding") {
    return "x86-64";
  }
  if (name == "wasm32-wasi" || name == "wasm32-wasi-http") {
    return "wasm32";
  }
  return "arm64";
}

pub function targets(): string[] {
  return [
    "arm64-android", "arm64-darwin", "arm64-freestanding", "arm64-linux",
    "wasm32-wasi", "wasm32-wasi-http", "x86-64-freestanding", "x86-64-linux",
  ];
}

pub function description(name: string): string {
  if (name == "arm64-linux") {
    return "ARM64 Linux ELF (AWS Graviton, Apple Silicon via container; ARMv8.2-A with the crypto extensions).";
  }
  if (name == "arm64-darwin") {
    return "ARM64 macOS Mach-O (native Apple Silicon Macs; no Linux container needed).";
  }
  if (name == "arm64-android") {
    return "ARM64 Android — Linux ELF as a static position-independent executable (ET_DYN, W^X), so it loads at an arbitrary base under Android's loader. Same syscalls / AAPCS64 as arm64-linux.";
  }
  if (name == "arm64-freestanding") {
    return "ARM64 with no host — no kernel, no syscalls, no process. Type-checkable today; no backend emits for it yet (#6510).";
  }
  if (name == "x86-64-linux") {
    return "x86-64 Linux ELF (native exec on x86_64 hosts, qemu-x86_64 elsewhere).";
  }
  if (name == "x86-64-freestanding") {
    return "x86-64 with no host — no kernel, no syscalls, no process. Type-checkable today; no backend emits for it yet (#6510).";
  }
  if (name == "wasm32-wasi") {
    return "WebAssembly Component Model — CLI world (wasi:cli/run + wasi:filesystem + wasi:clocks).";
  }
  if (name == "wasm32-wasi-http") {
    return "WebAssembly Component Model — proxy world (wasi:http/incoming-handler).";
  }
  return "";
}

pub function handler_kinds(name: string): string[] {
  let env_name: string = target_environment(name);
  if (env_name == "linux" || env_name == "darwin" || env_name == "android") {
    return ["handle", "main"];
  }
  if (env_name == "wasi") {
    return ["main", "handle"];
  }
  if (env_name == "wasi-http") {
    return ["handle"];
  }
  let empty: string[] = [];
  return empty;
}

pub function emits_code(name: string): boolean {
  return name != "arm64-freestanding" && name != "x86-64-freestanding";
}

pub function for_target(name: string): Descriptor {
  let env_name: string = target_environment(name);
  let empty: string[] = [];
  if (env_name.len() == 0) {
    return Descriptor { name: name, isa: "", environment: "", capabilities: empty, known: false };
  }
  return Descriptor {
    name: name,
    isa: target_isa(name),
    environment: env_name,
    capabilities: capability_profile(environment_profile(env_name)),
    known: true,
  };
}

pub function has_capability(target: string, capability: string): boolean {
  let d: Descriptor = for_target(target);
  if (!d.known) {
    return false;
  }
  return util.has_str(d.capabilities, capability);
}

pub function targets_providing(capability: string): string[] {
  let out: string[] = [];
  let all: string[] = targets();
  let i: i32 = 0;
  while (i < all.len()) {
    if (has_capability(all[i], capability)) {
      out = out.append(all[i]);
    }
    i = i + 1;
  }
  return out;
}

