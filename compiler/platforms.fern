import "./ast";
import "./parser";
import "./astwalk";
import "./util";

pub struct Descriptor {
  name: string,
  isa: string,
  environment: string,
  capabilities: string[],
  known: boolean,
}

function capability_profile(profile: string): string[] {
  if (profile == "hosted-android") {
    return ["log", "now", "env", "config", "args", "random", "stdin", "stdout", "fs", "fsmode", "tcp", "proc", "arena", "pollfd", "cabi", "userid", "host", "sysinfo", "cwd", "signal", "rlimit", "sched", "fsinfo", "fsnode", "fsowner", "tty", "fssync", "fsrename", "fsdir", "xattr", "syscall", "rawmem", "subprocess", "unix", "reactor", "ktls"];
  }
  if (profile == "hosted-linux") {
    return ["log", "now", "env", "config", "args", "random", "stdin", "stdout", "fs", "fsmode", "tcp", "proc", "arena", "pollfd", "cabi", "userid", "host", "sysinfo", "cwd", "signal", "rlimit", "sched", "fsinfo", "fsnode", "fsowner", "tty", "fssync", "fsrename", "fsdir", "xattr", "syscall", "rawmem", "subprocess", "unix", "reactor", "uring", "ktls"];
  }
  if (profile == "hosted-darwin") {
    return ["log", "now", "env", "config", "args", "random", "stdin", "stdout", "fs", "fsmode", "tcp", "proc", "arena", "pollfd", "cabi", "userid", "host", "sysinfo", "cwd", "signal", "rlimit", "sched", "fsinfo", "fsnode", "fsowner", "tty", "fssync", "fsrename", "fsdir", "xattr", "syscall", "rawmem", "subprocess", "unix", "reactor", "sysctl"];
  }
  if (profile == "wasi-cli") {
    return ["log", "now", "env", "config", "args", "random", "stdin", "stdout", "fs", "tcp", "host", "signal", "reactor", "pollable"];
  }
  if (profile == "wasi-proxy") {
    return ["log", "now", "config", "random", "fetch", "pollable"];
  }
  if (profile == "kernel") {
    return ["privileged", "arena"];
  }
  let empty: string[] = [];
  return empty;
}

function environment_profile(environment: string): string {
  if (environment == "android") {
    return "hosted-android";
  }
  if (environment == "linux") {
    return "hosted-linux";
  }
  if (environment == "darwin") {
    return "hosted-darwin";
  }
  if (environment == "wasi") {
    return "wasi-cli";
  }
  if (environment == "wasi-http") {
    return "wasi-proxy";
  }
  if (environment == "freestanding") {
    return "none";
  }
  if (environment == "kernel") {
    return "kernel";
  }
  return "";
}

// One branch for each environment's targets.
// fern-lint: allow cyclomatic-complexity
function target_environment(name: string): string {
  if (name == "x86-64-linux" || name == "arm64-linux") {
    return "linux";
  }
  if (name == "arm64-android" || name == "x86-64-android") {
    return "android";
  }
  if (name == "arm64-darwin") {
    return "darwin";
  }
  if (name == "wasm32-wasi") {
    return "wasi";
  }
  if (name == "wasm32-wasi-http") {
    return "wasi-http";
  }
  if (name == "arm64-freestanding" || name == "x86-64-freestanding") {
    return "freestanding";
  }
  if (name == "arm64-kernel" || name == "x86-64-kernel") {
    return "kernel";
  }
  return "";
}

// The ISA half of a target name.
pub function target_isa(name: string): string {
  if (util.str_has_prefix(name, "x86-64-")) {
    return "x86-64";
  }
  if (util.str_has_prefix(name, "wasm32-")) {
    return "wasm32";
  }
  return "arm64";
}

pub function targets(): string[] {
  return [
    "arm64-android", "arm64-darwin", "arm64-freestanding", "arm64-kernel", "arm64-linux",
    "wasm32-wasi", "wasm32-wasi-http", "x86-64-android", "x86-64-freestanding", "x86-64-kernel", "x86-64-linux",
  ];
}

// One branch for each target, in the shape that the parity test reads.
// fern-lint: allow cyclomatic-complexity
pub function description(name: string): string {
  if (name == "arm64-linux") {
    return "ARM64 Linux ELF (AWS Graviton, Apple Silicon via container; ARMv8.2-A with the crypto extensions).";
  }
  if (name == "arm64-darwin") {
    return "ARM64 macOS Mach-O (native Apple Silicon Macs; no Linux container needed).";
  }
  if (name == "arm64-android") {
    return "ARM64 Android — Linux ELF as a static position-independent executable (ET_DYN, W^X), so it loads at an arbitrary base under Android's loader. Same syscalls / AAPCS64 as arm64-linux.";
  }
  if (name == "arm64-freestanding") {
    return "ARM64 with no host — no kernel, no syscalls, no process. Writes assembly for an embedder to link, entered through the -export functions.";
  }
  if (name == "arm64-kernel") {
    return "ARM64 kernel image — an ELF that the boot loader or the VMM loads at -ram BASE. The reset entry sets the stack, clears .bss and calls main. No host and no syscalls.";
  }
  if (name == "x86-64-kernel") {
    return "x86-64 kernel image — an ELF with a PVH entry that the VMM loads at -ram BASE. The entry switches to long mode, sets the stack, clears .bss and calls main. No host and no syscalls.";
  }
  if (name == "x86-64-linux") {
    return "x86-64 Linux ELF (native exec on x86_64 hosts, qemu-x86_64 elsewhere).";
  }
  if (name == "x86-64-android") {
    return "x86-64 Android (emulators and x86-64 devices) — Linux ELF as a static position-independent executable, like arm64-android. Same syscalls / System V ABI as x86-64-linux.";
  }
  if (name == "x86-64-freestanding") {
    return "x86-64 with no host — no kernel, no syscalls, no process. Writes assembly for an embedder to link, entered through the -export functions.";
  }
  if (name == "wasm32-wasi") {
    return "WebAssembly Component Model — CLI world (wasi:cli/run + wasi:filesystem + wasi:clocks).";
  }
  if (name == "wasm32-wasi-http") {
    return "WebAssembly Component Model — proxy world (wasi:http/incoming-handler).";
  }
  return "";
}

pub function handler_kinds(name: string): string[] {
  let env_name = target_environment(name);
  if (env_name == "linux" || env_name == "darwin" || env_name == "android") {
    return ["handle", "main"];
  }
  if (env_name == "wasi") {
    return ["main", "handle"];
  }
  if (env_name == "wasi-http") {
    return ["handle"];
  }
  let empty: string[] = [];
  return empty;
}

// How control reaches the artifact: "process" is a kernel or a loader with a
// process stack, "exports" is an embedder that calls exported symbols, and
// "reset" is a reset vector. An unknown target is "process".
pub function entry_shape(name: string): string {
  let env_name = target_environment(name);
  if (env_name == "wasi-http" || env_name == "freestanding") {
    return "exports";
  }
  if (env_name == "kernel") {
    return "reset";
  }
  return "process";
}

pub function for_target(name: string): Descriptor {
  let env_name = target_environment(name);
  let empty: string[] = [];
  if (env_name.len() == 0) {
    return Descriptor { name: name, isa: "", environment: "", capabilities: empty, known: false };
  }
  return Descriptor {
    name: name,
    isa: target_isa(name),
    environment: env_name,
    capabilities: capability_profile(environment_profile(env_name)),
    known: true,
  };
}

pub function has_capability(target: string, capability: string): boolean {
  let d = for_target(target);
  if (!d.known) {
    return false;
  }
  return util.has_str(d.capabilities, capability);
}

pub function targets_providing(capability: string): string[] {
  let out: string[] = [];
  let all = targets();
  let i = 0;
  while (i < all.len()) {
    if (has_capability(all[i], capability)) {
      out = out.append(all[i]);
    }
    i += 1;
  }
  return out;
}

