pub function core_builtins(): string[] {
  return [
    "__outer_mul_f64",
    "__inner_mul_add_f64",
    "exit", "isatty", "target_os", "target_arch",
    "__account_entry",
    "__ct_secret", "__ct_public",
    "__bytes_owned", "__bytes_range", "__bytes_into",
    "__aes_expand_key", "__aes_ctr32", "__ghash", "__aes_gcm_seal_into", "__aes_gcm_open_into", "__sha256_hw", "__sha256_hw_blocks", "__sha1_hw", "__sha1_hw_blocks",
    "map_new", "cell_new", "string_from_bytes_unchecked", "string_from_bytes_range_unchecked",
    "slice_unchecked",
    "buf_new", "buf_push", "buf_push_range", "buf_push_bytes_range", "buf_push_mapped", "buf_push_filtered", "buf_push_expanded", "buf_push_bytes_mapped", "buf_push_bytes_filtered", "buf_push_bytes_expanded", "buf_push_byte", "buf_push_u64",
    "buf_len", "buf_take", "buf_take_bytes", "buf_clear", "buf_free",
    "f32_bits", "f32_from_bits", "f64_bits", "f64_from_bits",
  ];
}

pub function core_builtin(name: string): boolean {
  return util.has_str(core_builtins(), name);
}

pub function gated_capability(name: string): string {
  let gates: Gate[] = gated_builtins();
  let i: i32 = 0;
  while (i < gates.len()) {
    if (gates[i].builtin == name) {
      return gates[i].capability;
    }
    i = i + 1;
  }
  return "";
}

pub function forbidden_gates(target: string): Gate[] {
  let out: Gate[] = [];
  let d: Descriptor = for_target(target);
  if (!d.known) {
    return out;
  }
  let gates: Gate[] = gated_builtins();
  let i: i32 = 0;
  while (i < gates.len()) {
    if (!util.has_str(d.capabilities, gates[i].capability)) {
      out = out.append(gates[i]);
    }
    i = i + 1;
  }
  return out;
}

pub struct Violation {
  builtin: string,
  capability: string,
  target: string,
  line: i32,
  col: i32,
  fn_name: string,
  fn_module: string,
}

pub function enforce(mod: parser.Module, target: string): Violation[] {
  let out: Violation[] = [];
  let forbidden: Gate[] = forbidden_gates(target);
  if (forbidden.len() == 0) {
    return out;
  }
  let wanted: string[] = [];
  let wi: i32 = 0;
  while (wi < forbidden.len()) {
    wanted = wanted.append(forbidden[wi].builtin);
    wi = wi + 1;
  }
  let want: util.NameIndex = util.name_index(wanted);

  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let fd: parser.FuncDecl = mod.funcs[fi];
    let calls: astwalk.CallSite[] = [];
    let bi: i32 = 0;
    while (bi < fd.body.len()) {
      calls = astwalk.collect_calls_stmt(fd.body[bi], want, calls);
      bi = bi + 1;
    }
    let seen: string[] = [];
    let ci: i32 = 0;
    while (ci < calls.len()) {
      let gi: i32 = 0;
      while (gi < forbidden.len()) {
        if (!calls[ci].method && calls[ci].name == forbidden[gi].builtin && !util.has_str(seen, calls[ci].name)) {
          seen = seen.append(calls[ci].name);
          out = out.append(Violation {
            builtin: forbidden[gi].builtin,
            capability: forbidden[gi].capability,
            target: target,
            line: calls[ci].line,
            col: calls[ci].col,
            fn_name: util.mangled_name(fd.name),
            fn_module: util.mangled_module(fd.name),
          });
        }
        gi = gi + 1;
      }
      ci = ci + 1;
    }
    fi = fi + 1;
  }
  return out;
}

pub function reach(mod: parser.Module): string[] {
  let gates: Gate[] = gated_builtins();
  let wanted: string[] = [];
  let wi: i32 = 0;
  while (wi < gates.len()) {
    wanted = wanted.append(gates[wi].builtin);
    wi = wi + 1;
  }
  let want: util.NameIndex = util.name_index(wanted);

  let found: string[] = [];
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let calls: astwalk.CallSite[] = [];
    let bi: i32 = 0;
    while (bi < mod.funcs[fi].body.len()) {
      calls = astwalk.collect_calls_stmt(mod.funcs[fi].body[bi], want, calls);
      bi = bi + 1;
    }
    let ci: i32 = 0;
    while (ci < calls.len()) {
      if (!calls[ci].method) {
        let cap: string = gated_capability(calls[ci].name);
        if (cap.len() > 0 && !util.has_str(found, cap)) {
          found = found.append(cap);
        }
      }
      ci = ci + 1;
    }
    fi = fi + 1;
  }
  return sorted(found);
}

function sorted(xs: string[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < xs.len()) {
    let pos: i32 = 0;
    while (pos < out.len() && util.str_less(out[pos], xs[i])) {
      pos = pos + 1;
    }
    let next: string[] = [];
    let j: i32 = 0;
    while (j < pos) {
      next = next.append(out[j]);
      j = j + 1;
    }
    next = next.append(xs[i]);
    while (j < out.len()) {
      next = next.append(out[j]);
      j = j + 1;
    }
    out = next;
    i = i + 1;
  }
  return out;
}

pub function violation_diag(v: Violation): util.Diag {
  return util.violation_diag("E066", violation_message(v), v.fn_module, v.line, v.col);
}

pub function violation_message(v: Violation): string {
  let where: string = "";
  if (v.fn_module.len() > 0) {
    where = " (reached via \"" + v.fn_name + "\" from module \"" + v.fn_module + "\")";
  }
  let providers: string[] = targets_providing(v.capability);
  let list: string = "";
  let i: i32 = 0;
  while (i < providers.len()) {
    if (i > 0) {
      list = list + " ";
    }
    list = list + providers[i];
    i = i + 1;
  }
  let msg: string = "target \"" + v.target + "\" does not provide `" + v.capability + "`, required by `"
    + v.builtin + "`" + where + "; targets providing it: [" + list + "]";
  let alt: string = equivalent(v.builtin);
  if (alt.len() > 0 && has_capability(v.target, gated_capability(alt))) {
    msg = msg + "; use `" + alt + "`, which this target provides";
  }
  return msg;
}

function equivalent(builtin: string): string {
  if (builtin == "timer_fd") {
    return "wasm_timer_pollable";
  }
  if (builtin == "wasm_timer_pollable") {
    return "timer_fd";
  }
  return "";
}
