// Insert implicit drops for owned resource handles and declare their host imports.

import "./ast";
import "./astwalk";
import "./parser";
import "./util";
import "std/string";

function resource_drop_fn_name(res: string): string {
  return "__resource_drop_" + res;
}

function handle_resource_of(type_name: string, resources: parser.ResourceDecl[]): string {
  if (type_name.len() >= 4 && type_name.starts_with("own ")) {
    return slice_unchecked(type_name, 4, type_name.len()).to_owned();
  }
  for rd in resources {
    if (rd.name == type_name) {
      return type_name;
    }
  }
  return "";
}

function resource_binding_iface(resources: parser.ResourceDecl[], name: string): string {
  for i in 0..resources.len() {
    if (resources[i].name == name) {
      return resources[i].iface;
    }
  }
  return "";
}

function resource_binding_wit(resources: parser.ResourceDecl[], name: string): string {
  for i in 0..resources.len() {
    if (resources[i].name == name) {
      return resources[i].wit;
    }
  }
  return "";
}

function callee_param_is_borrow(funcs: parser.FuncDecl[], fname: string, pos: i32): boolean {
  for i in 0..funcs.len() {
    if (funcs[i].name == fname) {
      if (pos < funcs[i].params.len()) {
        let tn = funcs[i].params[pos].type_name;
        return tn.len() >= 7 && tn.starts_with("borrow ");
      }
      return false;
    }
  }
  return false;
}

function moves_net_of(e: ast.Expr, funcs: parser.FuncDecl[], name: string, acc: i32): i32 {
  match (e) {
    ast.ExprIdent(id) => {
      if (id.name == name) {
        return acc + 1;
      }
      return acc;
    },
    ast.ExprCall(c) => {
      let cname = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          cname = cid.name;
        },
        _ => {}
      }
      if (cname.len() == 0) {
        return acc;
      }
      for i in 0..c.args.len() {
        match (c.args[i]) {
          ast.ExprIdent(aid) => {
            if (aid.name == name && callee_param_is_borrow(funcs, cname, i)) {
              acc -= 1;
            }
          },
          _ => {}
        }
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
}

function moves_target_of(st: ast.Stmt, name: string, acc: i32): i32 {
  match (st) {
    ast.StmtAssign(a) => {
      if (a.target == name) {
        return acc + 1;
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
}

function stmts_move_handle(stmts: ast.Stmt[], funcs: parser.FuncDecl[], name: string): boolean {
  function ve(e: ast.Expr, own acc: i32): i32 {
    return moves_net_of(e, funcs, name, acc);
  }
  function vs(st: ast.Stmt, own acc: i32): i32 {
    return moves_target_of(st, name, acc);
  }
  let net = 0;
  for st in stmts {
    net = astwalk.fold_stmt_nodes(st, net, vs, ve, astwalk.descend_all);
  }
  return net > 0;
}

function kept_handle_res(v: ast.StmtVar, body: ast.Stmt[], resources: parser.ResourceDecl[], funcs: parser.FuncDecl[]): string {
  let res = handle_resource_of(v.type_name, resources);
  if (res.len() == 0) {
    return "";
  }
  if (resource_binding_iface(resources, res).len() == 0) {
    return "";
  }
  if (stmts_move_handle(body, funcs, v.name)) {
    return "";
  }
  return res;
}

function insert_drop_defers(stmts: ast.Stmt[], body: ast.Stmt[], resources: parser.ResourceDecl[], funcs: parser.FuncDecl[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for i in 0..stmts.len() {
    let s = stmts[i];
    let ns = s;
    match (s) {
      ast.StmtIf(f) => {
        ns = ast.StmtIf { ...f, then_body: insert_drop_defers(f.then_body, body, resources, funcs), else_body: insert_drop_defers(f.else_body, body, resources, funcs) };
      },
      ast.StmtWhile(w) => {
        ns = ast.StmtWhile { ...w, body: insert_drop_defers(w.body, body, resources, funcs) };
      },
      ast.StmtFor(fr) => {
        ns = ast.StmtFor { ...fr, body: insert_drop_defers(fr.body, body, resources, funcs) };
      },
      ast.StmtMatch(m) => {
        let arms: ast.MatchArm[] = [];
        for k in 0..m.arms.len() {
          arms = arms.append(ast.MatchArm { ...m.arms[k], body: insert_drop_defers(m.arms[k].body, body, resources, funcs) });
        }
        ns = ast.StmtMatch { ...m, arms: arms };
      },
      _ => {}
    }
    out = out.append(ns);
    match (s) {
      ast.StmtVar(v) => {
        let res = kept_handle_res(v, body, resources, funcs);
        if (res.len() > 0) {
          out = out.append(parser.s_defer(parser.s_expr(parser.e_call(parser.e_ident(resource_drop_fn_name(res)), [parser.e_ident(v.name)]))));
        }
      },
      _ => {}
    }
  }
  return out;
}

function collect_dropped_resources(stmts: ast.Stmt[], body: ast.Stmt[], resources: parser.ResourceDecl[], funcs: parser.FuncDecl[], res_acc: string[]): string[] {
  let res_out = res_acc;
  for i in 0..stmts.len() {
    match (stmts[i]) {
      ast.StmtVar(v) => {
        let res = kept_handle_res(v, body, resources, funcs);
        if (res.len() > 0 && !util.has_str(res_out, res)) {
          res_out = res_out.append(res);
        }
      },
      ast.StmtIf(f) => {
        res_out = collect_dropped_resources(f.then_body, body, resources, funcs, res_out);
        res_out = collect_dropped_resources(f.else_body, body, resources, funcs, res_out);
      },
      ast.StmtWhile(w) => {
        res_out = collect_dropped_resources(w.body, body, resources, funcs, res_out);
      },
      ast.StmtFor(fr) => {
        res_out = collect_dropped_resources(fr.body, body, resources, funcs, res_out);
      },
      ast.StmtMatch(m) => {
        for k in 0..m.arms.len() {
          res_out = collect_dropped_resources(m.arms[k].body, body, resources, funcs, res_out);
        }
      },
      _ => {}
    }
  }
  return res_out;
}

pub function lower_defers_prepass_module(mod: parser.Module, funcs: parser.FuncDecl[]): parser.Module {
  let resources = parser.registered_resources(mod);
  let has_res = resources.len() > 0;
  let out_funcs: parser.FuncDecl[] = [];
  let needed: string[] = [];
  let i = 0;
  while (i < funcs.len()) {
    let f = funcs[i];
    if (!has_res || f.import_iface.len() > 0) {
      out_funcs = out_funcs.append(f);
      i += 1;
      continue;
    }
    needed = collect_dropped_resources(f.body, f.body, resources, funcs, needed);
    let nbody = insert_drop_defers(f.body, f.body, resources, funcs);
    out_funcs = out_funcs.append(parser.FuncDecl { ...f, body: nbody });
    i += 1;
  }
  let no_tp: string[] = [];
  let no_body: ast.Stmt[] = [];
  for k in 0..needed.len() {
    let rn = needed[k];
    let iface2 = resource_binding_iface(resources, rn);
    let wit2 = resource_binding_wit(resources, rn);
    let hp: ast.ParamDecl[] = [ast.ParamDecl { name: "h", type_name: "own " + rn, own: true, send: false, has_default: false, default_value: parser.e_unknown(""), fn_ret: "", fn_param_types: [], line: 0, col: 0 }];
    out_funcs = out_funcs.append(parser.FuncDecl {
      bound_modules: [], is_unsafe: false,
      stdlib: "", no_inline: false, always_inline: false,
      name: resource_drop_fn_name(rn), receiver_name: "", receiver_type: "", receiver_own: false,
      type_params: no_tp, params: hp, ret_own: false, ret_type: "void", body: no_body,
      line: 0, col: 0, import_iface: iface2, import_wit: "[resource-drop]" + wit2, import_weak: false, all_type_params: [], bound_traits: [], fip: false, fbip: false, fip_allowance: 0, async: false,
      is_pub: true,
      is_const: false, ret_fn_ret: "", ret_fn_param_types: [], is_package: false, module: "", impl_trait: "", dyn_traits: [], streams: [],
    });
  }
  return parser.Module { ...mod, funcs: out_funcs };
}
