import "./util";
import "./pkgversion";
import "./fern_toml";
import "./docsummary";
import "core/map";

pub struct Source {
  path: string,
  url: string,
  hash: string,
}

pub struct Entry {
  pkg: string,
  ver: string,
  src: Source,
}

pub struct Index {
  dir: string,
  entries: Entry[],
}

pub struct Req {
  pkg: string,
  min: string,
}

pub struct Ban {
  pkg: string,
  ver: string,
}

pub struct Sel {
  name: string,
  ver: string,
  src: Source,
}

pub struct State {
  ix: Index,
  bans: Ban[],
  names: string[],
  vers: string[],
  qpkg: string[],
  qver: string[],
  qhead: i32,
  need_pkg: string,
  need_ver: string,
  err: string,
}

pub function parse_version(text: string): Result[pkgversion.Version, string] {
  return pkgversion.parse(text);
}

pub function version_string(value: pkgversion.Version): string {
  return pkgversion.format(value);
}

pub function version_cmp(a: pkgversion.Version, b: pkgversion.Version): i32 {
  return pkgversion.compare(a, b);
}

function ver_cmp_s(a: string, b: string): Result[i32, string] {
  let av = match (parse_version(a)) { Ok(value) => value, Err(message) => { return Err(message); } };
  let bv = match (parse_version(b)) { Ok(value) => value, Err(message) => { return Err(message); } };
  return Ok(version_cmp(av, bv));
}

pub function parse_index(src: string): Result[Index, string] {
  let entries: Entry[] = [];
  let pkg: string = "";
  let lines: string[] = split_char(src, b'\n');
  let positions: Map[string, i32] = map_new(lines.len());
  let ln: i32 = 0;
  while (ln < lines.len()) {
    let line: string = fern_toml.line_content(lines[ln]);
    ln = ln + 1;
    if (line.len() == 0) {
      continue;
    }
    if (line[0] == b'[') {
      if (line[line.len() - 1] != b']') {
        return Err("line " + util.i32_to_string(ln) + ": malformed section header " + docsummary.quote(line));
      }
      pkg = util.trim(slice_unchecked(line, 1, line.len() - 1) + "");
      if (pkg.len() == 0) {
        return Err("line " + util.i32_to_string(ln) + ": empty package name");
      }
      continue;
    }
    if (pkg.len() == 0) {
      return Err("line " + util.i32_to_string(ln) + ": version entry outside a [package] section");
    }
    let eq: i32 = index_of_char(line, b'=', 0);
    if (eq < 0) {
      return Err("line " + util.i32_to_string(ln) + ": expected `\"VERSION\" = { … }`");
    }
    let key: string = util.trim(slice_unchecked(line, 0, eq) + "");
    let ver: string = match (fern_toml.parse_quoted(key)) { Ok(value) => value, Err(message) => { return Err("line " + util.i32_to_string(ln) + ": version key: " + message); } };
    match (parse_version(ver)) {
      Ok(_) => {},
      Err(message) => {
        return Err("line " + util.i32_to_string(ln) + ": " + message);
      }
    }
    let val: string = util.trim(slice_unchecked(line, eq + 1, line.len()) + "");
    match (parse_source(val)) {
      Ok(src) => {
        let entry: Entry = Entry { pkg: pkg, ver: ver, src: src };
        let key: string = pkg + "\n" + ver;
        match (positions.get(key)) {
          Some(at) => {
            entries = entries.with(at, entry);
          },
          None => {
            positions = positions.insert(key, entries.len());
            entries = entries.append(entry);
          }
        }
      },
      Err(err) => {
        return Err("line " + util.i32_to_string(ln) + ": " + ver + ": " + err);
      }
    }
  }
  return Ok(Index { dir: "", entries: entries });
}

function parse_source(val: string): Result[Source, string] {
  if (val.len() < 2 || val[0] != b'{' || val[val.len() - 1] != b'}') {
    return Err("expected an inline table { path = … } or { url = …, hash = … }");
  }
  let path: string = "";
  let url: string = "";
  let hash: string = "";
  let parts: string[] = split_char(util.trim(slice_unchecked(val, 1, val.len() - 1) + ""), b',');
  let i: i32 = 0;
  while (i < parts.len()) {
    let part: string = util.trim(parts[i]);
    i = i + 1;
    if (part.len() == 0) {
      continue;
    }
    let eq: i32 = index_of_char(part, b'=', 0);
    if (eq < 0) {
      return Err("expected `key = value`, got " + docsummary.quote(part));
    }
    let k: string = util.trim(slice_unchecked(part, 0, eq) + "");
    let raw: string = util.trim(slice_unchecked(part, eq + 1, part.len()) + "");
    let v: string = match (fern_toml.parse_quoted(raw)) { Ok(value) => value, Err(message) => { return Err(k + ": " + message); } };
    if (k == "path") {
      path = v;
    } else if (k == "url") {
      url = v;
    } else if (k == "hash") {
      if let Err(message) = fern_toml.validate_hash(v) {
        return Err(k + " " + message);
      }
      hash = v;
    } else {
      return Err("unknown key " + docsummary.quote(k) + " (supported: path, url, hash)");
    }
  }
  if (path.len() > 0 && (url.len() > 0 || hash.len() > 0)) {
    return Err("a version is either `path` or `url`+`hash`");
  }
  if (path.len() > 0) {
    return Ok(Source { path: path, url: "", hash: "" });
  }
  if (url.len() > 0 && hash.len() > 0) {
    return Ok(Source { path: "", url: url, hash: hash });
  }
  return Err("a version needs `path` or `url`+`hash`");
}

pub function with_dir(ix: Index, dir: string): Index {
  return Index { dir: dir, entries: ix.entries };
}

pub function index_versions(ix: Index, pkg: string): string[] {
  let versions: pkgversion.Version[] = [];
  for entry in ix.entries {
    if (entry.pkg == pkg) {
      match (parse_version(entry.ver)) {
        Ok(value) => {
          versions = versions.append(value);
        },
        Err(_) => {}
      }
    }
  }
  let taken: i32[] = [];
  for i in 0..versions.len() {
    taken = taken.append(0);
  }
  let sorted: string[] = [];
  for k in 0..versions.len() {
    let best = -1;
    for j in 0..versions.len() {
      if (taken[j] == 0 && (best < 0 || version_cmp(versions[j], versions[best]) < 0)) {
        best = j;
      }
    }
    taken = taken.with(best, 1);
    sorted = sorted.append(version_string(versions[best]));
  }
  return sorted;
}

pub function index_has(ix: Index, pkg: string, ver: string): boolean {
  let i: i32 = 0;
  while (i < ix.entries.len()) {
    if (ix.entries[i].pkg == pkg && ix.entries[i].ver == ver) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function index_source(ix: Index, pkg: string, ver: string): Option[Source] {
  let i: i32 = 0;
  while (i < ix.entries.len()) {
    if (ix.entries[i].pkg == pkg && ix.entries[i].ver == ver) {
      let s: Source = ix.entries[i].src;
      if (s.path.len() > 0 && !is_abs(s.path)) {
        return Some(Source { path: join_path(ix.dir, s.path), url: s.url, hash: s.hash });
      }
      return Some(Source { path: s.path + "", url: s.url + "", hash: s.hash + "" });
    }
    i = i + 1;
  }
  return None;
}

function vers_list(vs: string[]): string {
  if (vs.len() == 0) {
    return "none";
  }
  let s: string = "";
  let i: i32 = 0;
  while (i < vs.len()) {
    if (i > 0) {
      s = s + ", ";
    }
    s = s + vs[i];
    i = i + 1;
  }
  return s;
}

pub function begin(roots: Req[], bans: Ban[], ix: Index): State {
  let st: State = State {
    ix: ix, bans: bans,
    names: [], vers: [], qpkg: [], qver: [], qhead: 0,
    need_pkg: "", need_ver: "", err: "",
  };
  let sorted: Req[] = sort_reqs(roots);
  let i: i32 = 0;
  while (i < sorted.len()) {
    st = raise(st, sorted[i].pkg, sorted[i].min, "");
    if (st.err.len() > 0) {
      return st;
    }
    i = i + 1;
  }
  return advance(st);
}

pub function supply(st: State, deps: Req[]): State {
  if (st.err.len() > 0 || st.need_pkg.len() == 0) {
    return st;
  }
  let pkg: string = st.need_pkg;
  let ver: string = st.need_ver;
  let via: string = "via " + pkg + "@" + ver + ": ";
  let sorted: Req[] = sort_reqs(deps);
  let i: i32 = 0;
  while (i < sorted.len()) {
    if (selected_version(st, pkg) != ver) {
      i = sorted.len();
      continue;
    }
    st = raise(st, sorted[i].pkg, sorted[i].min, via);
    if (st.err.len() > 0) {
      return st;
    }
    i = i + 1;
  }
  return advance(st);
}

pub function fail(st: State, why: string): State {
  return with_err(st, "reading deps of " + st.need_pkg + "@" + st.need_ver + ": " + why);
}

pub function done(st: State): boolean {
  return st.err.len() == 0 && st.need_pkg.len() == 0;
}

pub function selected(st: State): Result[Sel[], string] {
  if (st.err.len() > 0) {
    return Err(st.err);
  }
  if (st.names.len() != st.vers.len()) {
    return Err("resolution has unequal package and version counts");
  }
  if (!done(st)) {
    return Err("resolution needs dependencies of " + st.need_pkg + "@" + st.need_ver);
  }
  let taken: i32[] = [];
  let t: i32 = 0;
  while (t < st.names.len()) {
    taken = taken.append(0);
    t = t + 1;
  }
  let names: string[] = [];
  let n: i32 = 0;
  while (n < st.names.len()) {
    let best: i32 = 0 - 1;
    let j: i32 = 0;
    while (j < st.names.len()) {
      if (taken[j] == 0) {
        if (best < 0 || util.str_less(st.names[j], st.names[best])) {
          best = j;
        }
      }
      j = j + 1;
    }
    taken = taken.with(best, 1);
    names = names.append(st.names[best] + "");
    n = n + 1;
  }
  let out: Sel[] = [];
  let k: i32 = 0;
  while (k < names.len()) {
    let v: string = selected_version(st, names[k]);
    match (index_source(st.ix, names[k], v)) {
      Some(src) => {
        out = out.append(Sel { name: names[k], ver: v, src: src });
      },
      None => {
        return Err("registry has no source for " + names[k] + "@" + v);
      }
    }
    k = k + 1;
  }
  return Ok(out);
}

function raise(st: State, pkg: string, min: string, via: string): State {
  let v = match (parse_version(min)) { Ok(value) => value, Err(message) => { return with_err(st, via + "dependency " + quoted(pkg) + ": " + message); } };
  let ver: string = version_string(v);
  if (banned(st, pkg, ver)) {
    let avail: string[] = index_versions(st.ix, pkg);
    let up: string = "";
    let i: i32 = 0;
    while (i < avail.len()) {
      let order = match (ver_cmp_s(avail[i], ver)) { Ok(value) => value, Err(message) => { return with_err(st, message); } };
      if (order > 0 && !banned(st, pkg, avail[i])) {
        up = avail[i];
        i = avail.len();
      } else {
        i = i + 1;
      }
    }
    if (up.len() == 0) {
      return with_err(st, via + "dependency " + quoted(pkg) + ": version " + ver
        + " is excluded by the top-level manifest and the index has no higher non-excluded version (available: "
        + vers_list(avail) + ")");
    }
    ver = up;
  }
  if (!index_has(st.ix, pkg, ver)) {
    return with_err(st, via + "dependency " + quoted(pkg) + " has no version " + ver
      + " in the index (available: " + vers_list(index_versions(st.ix, pkg)) + ")");
  }
  let cur: string = selected_version(st, pkg);
  if (cur.len() > 0) {
    let order = match (ver_cmp_s(ver, cur)) { Ok(value) => value, Err(message) => { return with_err(st, message); } };
    if (order <= 0) {
      return st;
    }
  }
  let names: string[] = st.names;
  let vers: string[] = st.vers;
  if (cur.len() == 0) {
    names = names.append(pkg + "");
    vers = vers.append(ver + "");
  } else {
    vers = vers.with(util.index_of_str(names, pkg), ver + "");
  }
  return State {
    ix: st.ix, bans: st.bans,
    names: names, vers: vers,
    qpkg: st.qpkg.append(pkg + ""), qver: st.qver.append(ver + ""),
    qhead: st.qhead,
    need_pkg: st.need_pkg, need_ver: st.need_ver, err: st.err,
  };
}

function advance(st: State): State {
  let head: i32 = st.qhead;
  while (head < st.qpkg.len()) {
    let pkg: string = st.qpkg[head];
    let ver: string = st.qver[head];
    head = head + 1;
    if (selected_version(st, pkg) == ver) {
      return State {
        ix: st.ix, bans: st.bans, names: st.names, vers: st.vers,
        qpkg: st.qpkg, qver: st.qver, qhead: head,
        need_pkg: pkg + "", need_ver: ver + "", err: st.err,
      };
    }
  }
  return State {
    ix: st.ix, bans: st.bans, names: st.names, vers: st.vers,
    qpkg: st.qpkg, qver: st.qver, qhead: head,
    need_pkg: "", need_ver: "", err: st.err,
  };
}

function with_err(st: State, msg: string): State {
  return State {
    ix: st.ix, bans: st.bans, names: st.names, vers: st.vers,
    qpkg: st.qpkg, qver: st.qver, qhead: st.qhead,
    need_pkg: "", need_ver: "", err: msg,
  };
}

function selected_version(st: State, pkg: string): string {
  let i: i32 = util.index_of_str(st.names, pkg);
  if (i < 0) {
    return "";
  }
  return st.vers[i] + "";
}

function banned(st: State, pkg: string, ver: string): boolean {
  let i: i32 = 0;
  while (i < st.bans.len()) {
    if (st.bans[i].pkg == pkg) {
      match (parse_version(st.bans[i].ver)) {
        Ok(value) => {
          if (version_string(value) == ver) {
            return true;
          }
        },
        Err(_) => {}
      }
    }
    i = i + 1;
  }
  return false;
}

function sort_reqs(rs: Req[]): Req[] {
  let taken: i32[] = [];
  let t: i32 = 0;
  while (t < rs.len()) {
    taken = taken.append(0);
    t = t + 1;
  }
  let out: Req[] = [];
  let k: i32 = 0;
  while (k < rs.len()) {
    let best: i32 = 0 - 1;
    let j: i32 = 0;
    while (j < rs.len()) {
      if (taken[j] == 0) {
        if (best < 0 || util.str_less(rs[j].pkg, rs[best].pkg)) {
          best = j;
        }
      }
      j = j + 1;
    }
    taken = taken.with(best, 1);
    out = out.append(rs[best]);
    k = k + 1;
  }
  return out;
}

pub function lock_text(sel: Sel[]): string {
  let out: string = "# generated by `fern -resolve`; do not edit by hand\n";
  let i: i32 = 0;
  while (i < sel.len()) {
    out = out + "\n[[package]]\n";
    out = out + "name = " + quoted(sel[i].name) + "\n";
    out = out + "version = " + quoted(sel[i].ver) + "\n";
    if (sel[i].src.path.len() > 0) {
      out = out + "path = " + quoted(sel[i].src.path) + "\n";
    } else {
      out = out + "url = " + quoted(sel[i].src.url) + "\n";
      out = out + "hash = " + quoted(sel[i].src.hash) + "\n";
    }
    i = i + 1;
  }
  return out;
}

pub function split_char(s: string, c: u8): string[] {
  return util.split_char(s, c);
}

function index_of_char(s: string, c: u8, from: i32): i32 {
  let i: i32 = from;
  while (i < s.len()) {
    if (s[i] == c) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function quoted(s: string): string {
  return "\"" + s + "\"";
}

pub function is_abs(p: string): boolean {
  return p.len() > 0 && p[0] == b'/';
}

pub function join_path(dir: string, rel: string): string {
  let abs: boolean = is_abs(dir);
  let segs: string[] = [];
  let parts: string[] = split_char(dir + "/" + rel, b'/');
  let i: i32 = 0;
  while (i < parts.len()) {
    let p: string = parts[i];
    i = i + 1;
    if (p.len() == 0 || p == ".") {
      continue;
    }
    if (p == "..") {
      if (segs.len() > 0 && segs[segs.len() - 1] != "..") {
        segs = drop_last(segs);
        continue;
      }
      if (abs) {
        continue;
      }
    }
    segs = segs.append(p + "");
  }
  let out: string = "";
  let k: i32 = 0;
  while (k < segs.len()) {
    if (k > 0) {
      out = out + "/";
    }
    out = out + segs[k];
    k = k + 1;
  }
  if (abs) {
    return "/" + out;
  }
  if (out.len() == 0) {
    return ".";
  }
  return out;
}

function drop_last(xs: string[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i + 1 < xs.len()) {
    out = out.append(xs[i] + "");
    i = i + 1;
  }
  return out;
}
