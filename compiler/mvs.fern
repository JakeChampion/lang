import "./util";
import "./fern_toml";

pub struct Version {
  major: i32,
  minor: i32,
  patch: i32,
  ok: boolean,
}

pub struct Source {
  path: string,
  url: string,
  hash: string,
}

pub struct Entry {
  pkg: string,
  ver: string,
  src: Source,
}

pub struct Index {
  dir: string,
  entries: Entry[],
  err: string,
}

pub struct Req {
  pkg: string,
  min: string,
}

pub struct Ban {
  pkg: string,
  ver: string,
}

pub struct Sel {
  name: string,
  ver: string,
  src: Source,
}

pub struct State {
  ix: Index,
  bans: Ban[],
  names: string[],
  vers: string[],
  qpkg: string[],
  qver: string[],
  qhead: i32,
  need_pkg: string,
  need_ver: string,
  err: string,
}

pub function parse_version(s: string): Version {
  let parts: string[] = split_char(s, b'.');
  if (parts.len() != 3) {
    return Version { major: 0, minor: 0, patch: 0, ok: false };
  }
  let i: i32 = 0;
  while (i < 3) {
    if (!util.is_all_digits(parts[i])) {
      return Version { major: 0, minor: 0, patch: 0, ok: false };
    }
    i = i + 1;
  }
  return Version {
    major: util.digits_to_i32(parts[0]),
    minor: util.digits_to_i32(parts[1]),
    patch: util.digits_to_i32(parts[2]),
    ok: true,
  };
}

pub function version_error(s: string): string {
  if (split_char(s, b'.').len() != 3) {
    return "invalid version " + quoted(s) + " (want MAJOR.MINOR.PATCH)";
  }
  return "invalid version " + quoted(s);
}

pub function version_string(v: Version): string {
  return util.i32_to_string(v.major) + "." + util.i32_to_string(v.minor) + "." + util.i32_to_string(v.patch);
}

pub function version_cmp(a: Version, b: Version): i32 {
  if (a.major != b.major) {
    if (a.major < b.major) {
      return 0 - 1;
    }
    return 1;
  }
  if (a.minor != b.minor) {
    if (a.minor < b.minor) {
      return 0 - 1;
    }
    return 1;
  }
  if (a.patch != b.patch) {
    if (a.patch < b.patch) {
      return 0 - 1;
    }
    return 1;
  }
  return 0;
}

function ver_cmp_s(a: string, b: string): i32 {
  return version_cmp(parse_version(a), parse_version(b));
}

pub function parse_index(src: string): Index {
  let entries: Entry[] = [];
  let pkg: string = "";
  let lines: string[] = split_char(src, b'\n');
  let ln: i32 = 0;
  while (ln < lines.len()) {
    let line: string = fern_toml.line_content(lines[ln]);
    ln = ln + 1;
    if (line.len() == 0) {
      continue;
    }
    if (line[0] == b'[') {
      if (line[line.len() - 1] != b']') {
        return index_err(entries, "line " + util.i32_to_string(ln) + ": malformed section header " + quoted(line));
      }
      pkg = util.trim(slice_unchecked(line, 1, line.len() - 1) + "");
      if (pkg.len() == 0) {
        return index_err(entries, "line " + util.i32_to_string(ln) + ": empty package name");
      }
      continue;
    }
    if (pkg.len() == 0) {
      return index_err(entries, "line " + util.i32_to_string(ln) + ": version entry outside a [package] section");
    }
    let eq: i32 = index_of_char(line, b'=', 0);
    if (eq < 0) {
      return index_err(entries, "line " + util.i32_to_string(ln) + ": expected `\"VERSION\" = { … }`");
    }
    let key: string = util.trim(slice_unchecked(line, 0, eq) + "");
    if (!is_quoted(key)) {
      return index_err(entries, "line " + util.i32_to_string(ln) + ": version key: " + unquote_error(key));
    }
    let ver: string = slice_unchecked(key, 1, key.len() - 1) + "";
    if (!parse_version(ver).ok) {
      return index_err(entries, "line " + util.i32_to_string(ln) + ": " + version_error(ver));
    }
    let val: string = util.trim(slice_unchecked(line, eq + 1, line.len()) + "");
    let src_res: SourceResult = parse_source(val);
    if (src_res.err.len() > 0) {
      return index_err(entries, "line " + util.i32_to_string(ln) + ": " + ver + ": " + src_res.err);
    }
    entries = entries.append(Entry { pkg: pkg, ver: ver, src: src_res.src });
  }
  return Index { dir: "", entries: entries, err: "" };
}

struct SourceResult {
  src: Source,
  err: string,
}

function parse_source(val: string): SourceResult {
  let none: Source = Source { path: "", url: "", hash: "" };
  if (val.len() < 2 || val[0] != b'{' || val[val.len() - 1] != b'}') {
    return SourceResult { src: none, err: "expected an inline table { path = … } or { url = …, hash = … }" };
  }
  let path: string = "";
  let url: string = "";
  let hash: string = "";
  let parts: string[] = split_char(util.trim(slice_unchecked(val, 1, val.len() - 1) + ""), b',');
  let i: i32 = 0;
  while (i < parts.len()) {
    let part: string = util.trim(parts[i]);
    i = i + 1;
    if (part.len() == 0) {
      continue;
    }
    let eq: i32 = index_of_char(part, b'=', 0);
    if (eq < 0) {
      return SourceResult { src: none, err: "expected `key = value`, got " + quoted(part) };
    }
    let k: string = util.trim(slice_unchecked(part, 0, eq) + "");
    let raw: string = util.trim(slice_unchecked(part, eq + 1, part.len()) + "");
    if (!is_quoted(raw)) {
      return SourceResult { src: none, err: k + ": " + unquote_error(raw) };
    }
    let v: string = slice_unchecked(raw, 1, raw.len() - 1) + "";
    if (k == "path") {
      path = v;
    } else if (k == "url") {
      url = v;
    } else if (k == "hash") {
      let hr: fern_toml.HashResult = fern_toml.validate_hash(v);
      if (hr.err.len() > 0) {
        return SourceResult { src: none, err: k + " " + hr.err };
      }
      hash = v;
    } else {
      return SourceResult { src: none, err: "unknown key " + quoted(k) + " (supported: path, url, hash)" };
    }
  }
  if (path.len() > 0 && (url.len() > 0 || hash.len() > 0)) {
    return SourceResult { src: none, err: "a version is either `path` or `url`+`hash`" };
  }
  if (path.len() > 0) {
    return SourceResult { src: Source { path: path, url: "", hash: "" }, err: "" };
  }
  if (url.len() > 0 && hash.len() > 0) {
    return SourceResult { src: Source { path: "", url: url, hash: hash }, err: "" };
  }
  return SourceResult { src: none, err: "a version needs `path` or `url`+`hash`" };
}

function index_err(entries: Entry[], msg: string): Index {
  return Index { dir: "", entries: entries, err: msg };
}

pub function with_dir(ix: Index, dir: string): Index {
  return Index { dir: dir, entries: ix.entries, err: ix.err };
}

pub function index_versions(ix: Index, pkg: string): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < ix.entries.len()) {
    if (ix.entries[i].pkg == pkg) {
      out = out.append(ix.entries[i].ver + "");
    }
    i = i + 1;
  }
  let taken: i32[] = [];
  let t: i32 = 0;
  while (t < out.len()) {
    taken = taken.append(0);
    t = t + 1;
  }
  let sorted: string[] = [];
  let k: i32 = 0;
  while (k < out.len()) {
    let best: i32 = 0 - 1;
    let j: i32 = 0;
    while (j < out.len()) {
      if (taken[j] == 0) {
        if (best < 0 || ver_cmp_s(out[j], out[best]) < 0) {
          best = j;
        }
      }
      j = j + 1;
    }
    taken = taken.with(best, 1);
    sorted = sorted.append(out[best] + "");
    k = k + 1;
  }
  return sorted;
}

pub function index_has(ix: Index, pkg: string, ver: string): boolean {
  let i: i32 = 0;
  while (i < ix.entries.len()) {
    if (ix.entries[i].pkg == pkg && ix.entries[i].ver == ver) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function index_source(ix: Index, pkg: string, ver: string): Source {
  let i: i32 = 0;
  while (i < ix.entries.len()) {
    if (ix.entries[i].pkg == pkg && ix.entries[i].ver == ver) {
      let s: Source = ix.entries[i].src;
      if (s.path.len() > 0 && !is_abs(s.path)) {
        return Source { path: join_path(ix.dir, s.path), url: s.url, hash: s.hash };
      }
      return Source { path: s.path + "", url: s.url + "", hash: s.hash + "" };
    }
    i = i + 1;
  }
  return Source { path: "", url: "", hash: "" };
}

function vers_list(vs: string[]): string {
  if (vs.len() == 0) {
    return "none";
  }
  let s: string = "";
  let i: i32 = 0;
  while (i < vs.len()) {
    if (i > 0) {
      s = s + ", ";
    }
    s = s + vs[i];
    i = i + 1;
  }
  return s;
}

pub function begin(roots: Req[], bans: Ban[], ix: Index): State {
  let st: State = State {
    ix: ix, bans: bans,
    names: [], vers: [], qpkg: [], qver: [], qhead: 0,
    need_pkg: "", need_ver: "", err: "",
  };
  let sorted: Req[] = sort_reqs(roots);
  let i: i32 = 0;
  while (i < sorted.len()) {
    st = raise(st, sorted[i].pkg, sorted[i].min, "");
    if (st.err.len() > 0) {
      return st;
    }
    i = i + 1;
  }
  return advance(st);
}

pub function supply(st: State, deps: Req[]): State {
  if (st.err.len() > 0 || st.need_pkg.len() == 0) {
    return st;
  }
  let pkg: string = st.need_pkg;
  let ver: string = st.need_ver;
  let via: string = "via " + pkg + "@" + ver + ": ";
  let sorted: Req[] = sort_reqs(deps);
  let i: i32 = 0;
  while (i < sorted.len()) {
    if (selected_version(st, pkg) != ver) {
      i = sorted.len();
      continue;
    }
    st = raise(st, sorted[i].pkg, sorted[i].min, via);
    if (st.err.len() > 0) {
      return st;
    }
    i = i + 1;
  }
  return advance(st);
}

pub function fail(st: State, why: string): State {
  return with_err(st, "reading deps of " + st.need_pkg + "@" + st.need_ver + ": " + why);
}

pub function done(st: State): boolean {
  return st.err.len() == 0 && st.need_pkg.len() == 0;
}

pub function selected(st: State): Sel[] {
  let taken: i32[] = [];
  let t: i32 = 0;
  while (t < st.names.len()) {
    taken = taken.append(0);
    t = t + 1;
  }
  let names: string[] = [];
  let n: i32 = 0;
  while (n < st.names.len()) {
    let best: i32 = 0 - 1;
    let j: i32 = 0;
    while (j < st.names.len()) {
      if (taken[j] == 0) {
        if (best < 0 || util.str_less(st.names[j], st.names[best])) {
          best = j;
        }
      }
      j = j + 1;
    }
    taken = taken.with(best, 1);
    names = names.append(st.names[best] + "");
    n = n + 1;
  }
  let out: Sel[] = [];
  let k: i32 = 0;
  while (k < names.len()) {
    let v: string = selected_version(st, names[k]);
    out = out.append(Sel { name: names[k], ver: v, src: index_source(st.ix, names[k], v) });
    k = k + 1;
  }
  return out;
}

function raise(st: State, pkg: string, min: string, via: string): State {
  let v: Version = parse_version(min);
  if (!v.ok) {
    return with_err(st, via + "dependency " + quoted(pkg) + ": " + version_error(min));
  }
  let ver: string = version_string(v);
  if (banned(st, pkg, ver)) {
    let avail: string[] = index_versions(st.ix, pkg);
    let up: string = "";
    let i: i32 = 0;
    while (i < avail.len()) {
      if (ver_cmp_s(avail[i], ver) > 0 && !banned(st, pkg, avail[i])) {
        up = avail[i];
        i = avail.len();
      } else {
        i = i + 1;
      }
    }
    if (up.len() == 0) {
      return with_err(st, via + "dependency " + quoted(pkg) + ": version " + ver
        + " is excluded by the top-level manifest and the index has no higher non-excluded version (available: "
        + vers_list(avail) + ")");
    }
    ver = up;
  }
  if (!index_has(st.ix, pkg, ver)) {
    return with_err(st, via + "dependency " + quoted(pkg) + " has no version " + ver
      + " in the index (available: " + vers_list(index_versions(st.ix, pkg)) + ")");
  }
  let cur: string = selected_version(st, pkg);
  if (cur.len() > 0 && ver_cmp_s(ver, cur) <= 0) {
    return st;
  }
  let names: string[] = st.names;
  let vers: string[] = st.vers;
  if (cur.len() == 0) {
    names = names.append(pkg + "");
    vers = vers.append(ver + "");
  } else {
    vers = vers.with(util.index_of_str(names, pkg), ver + "");
  }
  return State {
    ix: st.ix, bans: st.bans,
    names: names, vers: vers,
    qpkg: st.qpkg.append(pkg + ""), qver: st.qver.append(ver + ""),
    qhead: st.qhead,
    need_pkg: st.need_pkg, need_ver: st.need_ver, err: st.err,
  };
}

function advance(st: State): State {
  let head: i32 = st.qhead;
  while (head < st.qpkg.len()) {
    let pkg: string = st.qpkg[head];
    let ver: string = st.qver[head];
    head = head + 1;
    if (selected_version(st, pkg) == ver) {
      return State {
        ix: st.ix, bans: st.bans, names: st.names, vers: st.vers,
        qpkg: st.qpkg, qver: st.qver, qhead: head,
        need_pkg: pkg + "", need_ver: ver + "", err: st.err,
      };
    }
  }
  return State {
    ix: st.ix, bans: st.bans, names: st.names, vers: st.vers,
    qpkg: st.qpkg, qver: st.qver, qhead: head,
    need_pkg: "", need_ver: "", err: st.err,
  };
}

function with_err(st: State, msg: string): State {
  return State {
    ix: st.ix, bans: st.bans, names: st.names, vers: st.vers,
    qpkg: st.qpkg, qver: st.qver, qhead: st.qhead,
    need_pkg: "", need_ver: "", err: msg,
  };
}

function selected_version(st: State, pkg: string): string {
  let i: i32 = util.index_of_str(st.names, pkg);
  if (i < 0) {
    return "";
  }
  return st.vers[i] + "";
}

function banned(st: State, pkg: string, ver: string): boolean {
  let i: i32 = 0;
  while (i < st.bans.len()) {
    if (st.bans[i].pkg == pkg) {
      let b: Version = parse_version(st.bans[i].ver);
      if (b.ok && version_string(b) == ver) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

function sort_reqs(rs: Req[]): Req[] {
  let taken: i32[] = [];
  let t: i32 = 0;
  while (t < rs.len()) {
    taken = taken.append(0);
    t = t + 1;
  }
  let out: Req[] = [];
  let k: i32 = 0;
  while (k < rs.len()) {
    let best: i32 = 0 - 1;
    let j: i32 = 0;
    while (j < rs.len()) {
      if (taken[j] == 0) {
        if (best < 0 || util.str_less(rs[j].pkg, rs[best].pkg)) {
          best = j;
        }
      }
      j = j + 1;
    }
    taken = taken.with(best, 1);
    out = out.append(rs[best]);
    k = k + 1;
  }
  return out;
}

pub function lock_text(sel: Sel[]): string {
  let out: string = "# generated by `fern -resolve`; do not edit by hand\n";
  let i: i32 = 0;
  while (i < sel.len()) {
    out = out + "\n[[package]]\n";
    out = out + "name = " + quoted(sel[i].name) + "\n";
    out = out + "version = " + quoted(sel[i].ver) + "\n";
    if (sel[i].src.path.len() > 0) {
      out = out + "path = " + quoted(sel[i].src.path) + "\n";
    } else {
      out = out + "url = " + quoted(sel[i].src.url) + "\n";
      out = out + "hash = " + quoted(sel[i].src.hash) + "\n";
    }
    i = i + 1;
  }
  return out;
}

pub function split_char(s: string, c: u8): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] == c) {
      out = out.append(slice_unchecked(s, start, i) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  out = out.append(slice_unchecked(s, start, s.len()) + "");
  return out;
}

function index_of_char(s: string, c: u8, from: i32): i32 {
  let i: i32 = from;
  while (i < s.len()) {
    if (s[i] == c) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function quoted(s: string): string {
  return "\"" + s + "\"";
}

function is_quoted(s: string): boolean {
  if (s.len() < 2 || s[0] != b'"' || s[s.len() - 1] != b'"') {
    return false;
  }
  let inner: string = slice_unchecked(s, 1, s.len() - 1) + "";
  let i: i32 = 0;
  while (i < inner.len()) {
    if (inner[i] == b'"' || inner[i] == b'\\') {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function unquote_error(s: string): string {
  if (s.len() < 2 || s[0] != b'"' || s[s.len() - 1] != b'"') {
    return "expected a quoted string, got " + quoted(s);
  }
  return "escapes unsupported in " + quoted(s);
}

pub function is_abs(p: string): boolean {
  return p.len() > 0 && p[0] == b'/';
}

pub function join_path(dir: string, rel: string): string {
  let abs: boolean = is_abs(dir);
  let segs: string[] = [];
  let parts: string[] = split_char(dir + "/" + rel, b'/');
  let i: i32 = 0;
  while (i < parts.len()) {
    let p: string = parts[i];
    i = i + 1;
    if (p.len() == 0 || p == ".") {
      continue;
    }
    if (p == "..") {
      if (segs.len() > 0 && segs[segs.len() - 1] != "..") {
        segs = drop_last(segs);
        continue;
      }
      if (abs) {
        continue;
      }
    }
    segs = segs.append(p + "");
  }
  let out: string = "";
  let k: i32 = 0;
  while (k < segs.len()) {
    if (k > 0) {
      out = out + "/";
    }
    out = out + segs[k];
    k = k + 1;
  }
  if (abs) {
    return "/" + out;
  }
  if (out.len() == 0) {
    return ".";
  }
  return out;
}

function drop_last(xs: string[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i + 1 < xs.len()) {
    out = out.append(xs[i] + "");
    i = i + 1;
  }
  return out;
}
