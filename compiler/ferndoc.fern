import "./ast";
import "./lexer";
import "./parser";
import "./util";
import "./docsummary";
import "std/string";

pub struct DocDecl {
  kind: string,
  name: string,
  line: i32,
  col: i32,
  index: i32,
  doc: string,
}

pub struct TakeResult { doc: string, cursor: i32 }

function own(v: string): string {
  return v;
}

function run_end(cs: lexer.Comment[], start: i32): i32 {
  let e = start;
  while (e + 1 < cs.len() && cs[e + 1].line == cs[e].line + 1) {
    e += 1;
  }
  return e;
}

function join_run(cs: lexer.Comment[], start: i32, end: i32): string {
  let out = "";
  for i in start..=end {
    if (i > start) {
      out += "\n";
    }
    out += cs[i].text.trim();
  }
  return out;
}

pub function take_doc(cs: lexer.Comment[], cursor: i32, decl_line: i32): TakeResult {
  let cur = cursor;
  while (cur < cs.len() && cs[cur].line < decl_line - 1) {
    let e0 = run_end(cs, cur);
    if (cs[e0].line == decl_line - 1) {
      return TakeResult { doc: join_run(cs, cur, e0), cursor: e0 + 1 };
    }
    cur = e0 + 1;
  }
  if (cur >= cs.len()) {
    return TakeResult { doc: "", cursor: cur };
  }
  let e = run_end(cs, cur);
  if (cs[e].line != decl_line - 1) {
    return TakeResult { doc: "", cursor: cur };
  }
  return TakeResult { doc: join_run(cs, cur, e), cursor: e + 1 };
}

pub function module_intro(cs: lexer.Comment[], first_decl_line: i32): string {
  if (cs.len() == 0) {
    return "";
  }
  if (cs[0].line != 1) {
    return "";
  }
  let end = 0;
  for i in 0..cs.len() {
    if (cs[i].line != i + 1) {
      break;
    }
    end = i + 1;
  }
  if (end == 0) {
    return "";
  }
  if (first_decl_line > 0 && first_decl_line == end + 1) {
    return "";
  }
  let out = "";
  for j in 0..end {
    if (j > 0) {
      out += "\n";
    }
    out += cs[j].text.trim();
  }
  return out;
}

pub function module_summary(intro: string): string {
  return docsummary.summary(intro);
}

function quote(s: string): string {
  return docsummary.quote(s);
}

// The structs and enums of a module that are not public. A function on
// one of them, written or derived, is not part of the public API either.
function private_types(mod: parser.Module): string[] {
  let out: string[] = [];
  for sd in mod.structs {
    if (!sd.is_pub && sd.enum_owner.len() == 0) {
      out = out.append(sd.name);
    }
  }
  for ed in mod.enums {
    if (!ed.is_pub) {
      out = out.append(ed.name);
    }
  }
  return out;
}

function on_private_type(fd: parser.FuncDecl, private: string[]): boolean {
  if (fd.receiver_type.len() == 0) {
    return false;
  }
  let name = fd.receiver_type.split("[")[0];
  return util.has_str(private, name);
}

pub function public_decls(mod: parser.Module): DocDecl[] {
  let out: DocDecl[] = [];
  let private = private_types(mod);
  for i in 0..mod.funcs.len() {
    let fd = mod.funcs[i];
    if (fd.is_const) {
      if (fd.is_pub) {
        out = insert_sorted(out, DocDecl { kind: "const", name: fd.name, line: fd.line, col: fd.col, index: i, doc: "" });
      }
    } else if (fd.is_pub && !starts_with_dunder(fd.name) && !on_private_type(fd, private)) {
      out = insert_sorted(out, DocDecl { kind: "function", name: fd.name, line: fd.line, col: fd.col, index: i, doc: "" });
    }
  }
  for si in 0..mod.structs.len() {
    let sd = mod.structs[si];
    if (sd.is_pub && sd.enum_owner.len() == 0) {
      out = insert_sorted(out, DocDecl { kind: "struct", name: sd.name, line: sd.line, col: sd.col, index: si, doc: "" });
    }
  }
  for ei in 0..mod.enums.len() {
    let ed = mod.enums[ei];
    if (ed.is_pub) {
      out = insert_sorted(out, DocDecl { kind: "enum", name: ed.name, line: ed.line, col: ed.col, index: ei, doc: "" });
    }
  }
  for di in 0..mod.trait_decls.len() {
    let td = mod.trait_decls[di];
    if (td.is_pub) {
      out = insert_sorted(out, DocDecl { kind: "trait", name: td.name, line: td.line, col: td.col, index: di, doc: "" });
    }
  }
  return out;
}

function starts_with_dunder(name: string): boolean {
  return name.len() >= 2 && name[0] as i32 == 95 && name[1] as i32 == 95;
}

function insert_sorted(own xs: DocDecl[], d: DocDecl): DocDecl[] {
  if (xs.len() == 0 || !before(d, xs[xs.len() - 1])) {
    return xs.append(d);
  }
  let out: DocDecl[] = [];
  let placed = false;
  for i in 0..xs.len() {
    if (!placed && before(d, xs[i])) {
      out = out.append(d);
      placed = true;
    }
    out = out.append(xs[i]);
  }
  if (!placed) {
    out = out.append(d);
  }
  return out;
}

function before(a: DocDecl, b: DocDecl): boolean {
  if (a.line != b.line) {
    return a.line < b.line;
  }
  return a.col < b.col;
}

pub function first_decl_line(mod: parser.Module): i32 {
  let min = 0;
  for i in 0..mod.funcs.len() {
    min = min_line(min, mod.funcs[i].line);
  }
  for si in 0..mod.structs.len() {
    min = min_line(min, mod.structs[si].line);
  }
  for ei in 0..mod.enums.len() {
    min = min_line(min, mod.enums[ei].line);
  }
  for ti in 0..mod.aliases.len() {
    min = min_line(min, mod.aliases[ti].line);
  }
  for tdi in 0..mod.trait_decls.len() {
    min = min_line(min, mod.trait_decls[tdi].line);
  }
  return min;
}

function min_line(min: i32, line: i32): i32 {
  if (line == 0) {
    return min;
  }
  if (min == 0 || line < min) {
    return line;
  }
  return min;
}

// The first line of a declaration, counting the attribute lines, such as
// `@derive(...)`, directly above it. Its doc comment goes above them.
function head_line(lines: string[], line: i32): i32 {
  let h = line;
  while (h > 1 && h - 2 < lines.len() && lines[h - 2].trim().starts_with("@")) {
    h -= 1;
  }
  return h;
}

pub function associate(cs: lexer.Comment[], decls: DocDecl[], src: string): DocDecl[] {
  let lines = src.split("\n");
  let out: DocDecl[] = [];
  let cursor = 0;
  for i in 0..decls.len() {
    let t = take_doc(cs, cursor, head_line(lines, decls[i].line));
    cursor = t.cursor;
    out = out.append(DocDecl { ...decls[i], doc: t.doc });
  }
  return out;
}

pub struct DocModule { intro: string, decls: DocDecl[] }

pub function docs_of(src: string): DocModule {
  let lr = lexer.tokenize_full(src);
  let mod = parser.parse_module_verbatim(lr.tokens).pmod;
  let decls = public_decls(mod);
  return DocModule {
    intro: module_intro(lr.comments, first_decl_line(mod)),
    decls: associate(lr.comments, decls, src),
  };
}

function type_str(t: string): string {
  if (t.len() == 0) {
    return "?";
  }
  return t;
}

function param_type_str(p: ast.ParamDecl): string {
  if (p.type_name != "fn") {
    return type_str(p.type_name);
  }
  let out = "(";
  if (p.fn_param_types.len() > 0) {
    let parts = split_commas(p.fn_param_types);
    for i in 0..parts.len() {
      if (i > 0) {
        out += ", ";
      }
      out += parts[i];
    }
  }
  if (p.fn_ret.len() == 0) {
    return out + ") => void";
  }
  return out + ") => " + p.fn_ret;
}

function split_commas(s: string): string[] {
  let out: string[] = [];
  let start = 0;
  for i in 0..s.len() {
    if (s[i] as i32 == 44) {
      out = out.append(own(slice_unchecked(s, start, i)));
      start = i + 1;
    }
  }
  return out.append(own(slice_unchecked(s, start, s.len())));
}

function join_plus(names: string[]): string {
  let out = "";
  for n in names {
    if (out.len() > 0) {
      out += " + ";
    }
    out += n;
  }
  return out;
}

pub function join_type_params(tps: string[]): string {
  if (tps.len() == 0) {
    return "";
  }
  let out = "[";
  for i in 0..tps.len() {
    if (i > 0) {
      out += ", ";
    }
    out += tps[i];
  }
  return out + "]";
}

function doc_block(doc: string): string {
  if (doc.len() == 0) {
    return "";
  }
  return doc + "\n\n";
}

function render_func(fd: parser.FuncDecl, doc: string): string {
  // A function of a type with no receiver, such as one a derive makes, is
  // called as `Type.name()`, so its heading names it that way.
  let heading = fd.name;
  if (fd.receiver_type.len() > 0 && fd.receiver_name.len() == 0) {
    heading = fd.receiver_type + "." + fd.name;
  }
  let out = "## `" + heading + "`\n\n```fern\npub function ";
  let tps = fd.type_params;
  if (fd.receiver_type.len() > 0 && fd.receiver_name.len() > 0) {
    let rp = parser.receiver_with_bounds(fd);
    tps = rp.names;
    out = out + "(" + fd.receiver_name + ": " + rp.recv + ") ";
  }
  out = out + fd.name + join_type_params(tps) + "(";
  for i in 0..fd.params.len() {
    if (i > 0) {
      out += ", ";
    }
    out = out + fd.params[i].name + ": " + param_type_str(fd.params[i]);
  }
  out = out + "): " + type_str(fd.ret_type) + "\n```\n\n";
  return out + doc_block(doc);
}

function render_const(fd: parser.FuncDecl, doc: string): string {
  let out = "## `const " + fd.name + "`\n\n```fern\npub const " + fd.name;
  if (fd.ret_type.len() > 0) {
    out = out + ": " + fd.ret_type;
  }
  return out + "\n```\n\n" + doc_block(doc);
}

function render_struct(sd: parser.StructDecl, doc: string): string {
  let out: string = "## `struct " + sd.name + "`\n\n```fern\npub struct "
    + sd.name + join_type_params(sd.type_params) + " { ";
  for i in 0..sd.fields.len() {
    if (i > 0) {
      out += ", ";
    }
    out = out + sd.fields[i].name + ": " + type_str(sd.fields[i].type_name);
  }
  return out + " }\n```\n\n" + doc_block(doc);
}

function variant_payloads(enum_name: string, variant: string, structs: parser.StructDecl[]): string {
  for i in 0..structs.len() {
    let sd = structs[i];
    if (sd.enum_owner == enum_name && sd.name == variant) {
      if (sd.fields.len() == 0) {
        return "";
      }
      let out = "(";
      for f in 0..sd.fields.len() {
        if (f > 0) {
          out += ", ";
        }
        out += type_str(sd.fields[f].type_name);
      }
      return out + ")";
    }
  }
  return "";
}

function render_enum(ed: parser.EnumDecl, structs: parser.StructDecl[], doc: string): string {
  let out: string = "## `enum " + ed.name + "`\n\n```fern\npub enum "
    + ed.name + join_type_params(ed.type_params) + " {\n";
  for v in 0..ed.variant_names.len() {
    out = out + "    " + ed.variant_names[v]
      + variant_payloads(ed.name, ed.variant_names[v], structs) + ",\n";
  }
  return out + "}\n```\n\n" + doc_block(doc);
}

function render_trait(td: parser.TraitDecl, doc: string): string {
  let out = "## `trait " + td.name + "`\n\n```fern\npub trait " + td.name + join_type_params(td.type_params);
  if (td.supertraits.len() > 0) {
    out = out + ": " + join_plus(td.supertraits);
  }
  out += " {\n";
  for m in 0..td.methods.len() {
    let md = td.methods[m];
    out = out + "    function " + md.name + "(";
    for pi in 0..md.params.len() {
      if (pi > 0) {
        out += ", ";
      }
      out = out + md.params[pi].name + ": " + param_type_str(md.params[pi]);
    }
    out = out + "): " + type_str(md.ret_type) + ";\n";
  }
  return out + "}\n```\n\n" + doc_block(doc);
}

function trait_label(im: parser.ImplInfo): string {
  if (im.trait_spelling.len() > 0) {
    return im.trait_spelling;
  }
  return im.trait_name;
}

function render_impls(impls: parser.ImplInfo[]): string {
  let order: string[] = [];
  let cells: string[] = [];
  for i in 0..impls.len() {
    let tn = trait_label(impls[i]);
    let at = util.index_of_str(order, tn);
    if (at < 0) {
      order = order.append(tn);
      cells = cells.append(impls[i].impl_type);
    } else {
      cells = cells.with(at, cells[at] + "`, `" + impls[i].impl_type);
    }
  }
  if (order.len() == 0) {
    return "";
  }
  let out = "## Implementations\n\n| Trait | Implementing types |\n| ----- | ------------------ |\n";
  for t in 0..order.len() {
    out = out + "| `" + order[t] + "` | `" + cells[t] + "` |\n";
  }
  return out + "\n";
}

// Where -doc-source links each declaration: the template, in which {path}
// and {line} name the source file and the line, the file, and the map from
// a tangled line to a line of that file.
pub struct SourceLinks { template: string, path: string, map: util.LineMap }

pub function no_source_links(): SourceLinks {
  return SourceLinks { template: "", path: "", map: util.no_line_map() };
}

function source_link(links: SourceLinks, line: i32): string {
  if (links.template.len() == 0) {
    return "";
  }
  // A derived method has no line in the source.
  let (doc_line, _) = util.doc_pos([links.map], line, 1);
  if (doc_line <= 0) {
    return "";
  }
  let url = links.template.replace("{path}", links.path).replace("{line}", doc_line.to_string());
  return "[Source](" + url + ")\n\n";
}

pub function render_page(src: string, mod_path: string, links: SourceLinks): string {
  let lr = lexer.tokenize_full(src);
  let mod = parser.parse_module_verbatim(lr.tokens).pmod;
  let decls = associate(lr.comments, public_decls(mod), src);
  if (decls.len() == 0 && mod.impls.len() == 0) {
    return "";
  }

  let intro = module_intro(lr.comments, first_decl_line(mod));
  let description = module_summary(intro);
  if (description.len() == 0) {
    description = "Standard library reference for " + mod_path + ".";
  }
  let out: string = "---\ntitle: " + mod_path + "\ndescription: " + quote(description)
    + "\n---\n\n# `" + mod_path + "`\n\n";
  if (intro.len() > 0) {
    out = out + intro + "\n\n";
  }

  for i in 0..decls.len() {
    let d = decls[i];
    if (d.kind == "function") {
      out += render_func(mod.funcs[d.index], d.doc);
    } else if (d.kind == "const") {
      out += render_const(mod.funcs[d.index], d.doc);
    } else if (d.kind == "struct") {
      out += render_struct(mod.structs[d.index], d.doc);
    } else if (d.kind == "enum") {
      out += render_enum(mod.enums[d.index], mod.structs, d.doc);
    } else if (d.kind == "trait") {
      out += render_trait(mod.trait_decls[d.index], d.doc);
    }
    out += source_link(links, d.line);
  }
  return out + render_impls(mod.impls);
}
