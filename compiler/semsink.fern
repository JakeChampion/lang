import "./ssa";
import "./ssadeps";
import "./ssalive";
import "./semcse";
import "./ssasem";
import "./typeinfo";
import "./util";

pub struct Sunk { f: ssasem.Func, reread: i32 }

struct Reads { dom: ssadeps.Dom, par: i32[], at: i32[], flow: ssalive.Flow, pos: i32[], spent: i32[][], strict: i32[][], kids: i32[][], grown: i32[][], first: i32[] }

struct PhiEdit { block: i32, phi: i32, slot: i32, value: i32 }

pub function sink(f: ssasem.Func): Sunk {
  let ru: Reused = reuse(f);
  let sk: Sunk = sink_rereads(ru.s.f, ru.reads, false);
  return Sunk { f: sk.f, reread: ru.s.reread + sk.reread };
}

// sink_past_lent re-reads a projection below a call that only borrows its
// parent. It runs once ownership inference has settled the callees' modes,
// which `sink` runs before: a record or variant parameter declared
// borrowed that a callee consumes is counted by then.
pub function sink_past_lent(f: ssasem.Func): Sunk {
  return sink_rereads(f, None, true);
}

struct Reused { s: Sunk, reads: Option[Reads] }

function reuse(f: ssasem.Func): Reused {
  let g: ssa.SFunc = f.graph;
  let at: i32[] = projection_blocks(g, f.values);
  if (at.len() == 0 || !repeated_across(g, f.values, at)) {
    return Reused { s: Sunk { f: f, reread: 0 }, reads: None };
  }
  let rd: Reads = reads_of(f, at, false);
  if (!rd.flow.ok) {
    return Reused { s: Sunk { f: f, reread: 0 }, reads: Some(rd) };
  }
  let reads: ssa.SInst[] = counted_reads(g, f.values);
  let slots: Slots = read_slots(reads);
  let same: i32[] = identity(f.values.len());
  let n: i32 = 0;
  for r in reads {
    let bi: i32 = rd.at[r.result];
    let first: i32 = earlier_read(rd, reads, slots, r, bi, same, f.values);
    if (first >= 0) {
      same = same.with(r.result, first);
      n = n + 1;
    }
  }
  if (n == 0) {
    return Reused { s: Sunk { f: f, reread: 0 }, reads: Some(rd) };
  }
  return Reused { s: Sunk { f: semcse.replaced(f, same), reread: n }, reads: None };
}

function counted_reads(g: ssa.SFunc, values: typeinfo.Type[]): ssa.SInst[] {
  let reads: ssa.SInst[] = [];
  for b in g.blocks {
    for ins in b.insts {
      if (counted_projection(ins, values)) {
        reads = reads.append(ins);
      }
    }
  }
  return reads;
}

function identity(n: i32): i32[] {
  let out: i32[] = __alloc_i32(n);
  let k: i32 = 0;
  while (k < n) {
    out = out.with(k, k);
    k = k + 1;
  }
  return out;
}

struct Slots { head: i32[], next: i32[] }

function slot_hash(u: ssa.SInst): i32 {
  return ((u.kind_tag & 1023) * 31 + (u.imm & 65535)) * 31 + (__str_hash(u.str, 0) & 65535);
}

function read_slots(reads: ssa.SInst[]): Slots {
  let nb: i32 = 2;
  while (nb <= reads.len() * 2) {
    nb = nb * 2;
  }
  let head: i32[] = util.minus_ones(nb);
  let next: i32[] = util.minus_ones(reads.len());
  let k: i32 = reads.len() - 1;
  while (k >= 0) {
    let b: i32 = slot_hash(reads[k]) & nb - 1;
    next = next.with(k, head[b]);
    head = head.with(b, k);
    k = k - 1;
  }
  return Slots { head: head, next: next };
}

function earlier_read(rd: Reads, reads: ssa.SInst[], slots: Slots, r: ssa.SInst, bi: i32, same: i32[], values: typeinfo.Type[]): i32 {
  let i: i32 = slots.head[slot_hash(r) & slots.head.len() - 1];
  while (i >= 0) {
    let u: ssa.SInst = reads[i];
    let ub: i32 = rd.at[u.result];
    if (u.result != r.result && ub != bi && ssadeps.dom_holds(rd.dom, bi, ub) && semcse.same_slot(u, r, same, values)
      && (child_used_above(rd, rd.spent, bi, u.result, 0) || child_live_out(rd, bi, u.result, 0) && !field_kept_apart(rd, r, bi))) {
      return semcse.stand_in(same, u.result);
    }
    i = slots.next[i];
  }
  return 0 - 1;
}

function field_kept_apart(rd: Reads, r: ssa.SInst, bi: i32): boolean {
  return r.kind_tag == ssasem.record_get() && !ssalive.live_out_has(rd.flow, bi, r.result);
}

function sink_rereads(f: ssasem.Func, known: Option[Reads], lent: boolean): Sunk {
  let g: ssa.SFunc = f.graph;
  let at: i32[] = crossing_projections(g, f.values);
  if (at.len() == 0) {
    return Sunk { f: f, reread: 0 };
  }
  let rd: Reads = reads_at(f, at, known, lent);
  if (!rd.flow.ok) {
    return Sunk { f: f, reread: 0 };
  }
  let values: typeinfo.Type[] = f.values;
  let blocks: ssa.SBlock[] = g.blocks;
  let edits: PhiEdit[] = [];
  let reread: i32 = 0;
  let bi: i32 = 0;
  for b in g.blocks {
    if (rd.dom.pre[bi] >= 0 && rereads_any(rd, g, bi, b)) {
      let s: Sinking = sink_block(rd, g, bi, b, values);
      values = s.values;
      reread = reread + s.added;
      blocks = blocks.with(bi, s.b);
      for e in s.edits {
        edits = edits.append(e);
      }
    }
    bi = bi + 1;
  }
  if (reread == 0) {
    return Sunk { f: f, reread: 0 };
  }
  for e in edits {
    let b: ssa.SBlock = blocks[e.block];
    let ins: ssa.SInst = b.insts[e.phi];
    blocks = blocks.with(e.block, ssa.SBlock { ...b, insts: b.insts.with(e.phi, ssa.SInst { ...ins, args: ins.args.with(e.slot, e.value) }) });
  }
  let graph: ssa.SFunc = ssa.SFunc { ...g, nvals: values.len(), blocks: blocks };
  return Sunk { f: ssasem.Func { ...f, graph: graph, values: values }, reread: reread };
}

function successors(t: ssa.STerm): i32[] {
  let out: i32[] = [];
  let k: i32 = 0;
  let id: i32 = ssa.successor_id(t, k);
  while (id >= 0) {
    if (util.index_of_i32(out, id) < 0) {
      out = out.append(id);
    }
    k = k + 1;
    id = ssa.successor_id(t, k);
  }
  return out;
}

function projection(kind: i32): boolean {
  return kind == ssasem.variant_get() || kind == ssasem.record_get() || kind == ssasem.tuple_get() || kind == ssasem.array_get();
}

struct Tree { par: i32[], parent: boolean[], kids: i32[][], first: i32[] }

function reads_at(f: ssasem.Func, at: i32[], known: Option[Reads], lent: boolean): Reads {
  match (known) {
    Some(k) => {
      return Reads { ...k, at: at };
    },
    None => {
      return reads_of(f, at, lent);
    }
  }
  return reads_of(f, at, lent);
}

// reads_of with lent leaves a call's record or variant argument unspent
// when its callee's contract borrows it, and keeps the spends of every
// argument in strict.
function reads_of(f: ssasem.Func, at: i32[], lent: boolean): Reads {
  let g: ssa.SFunc = f.graph;
  let deps: i32[][] = [];
  while (deps.len() < f.values.len()) {
    deps = deps.append([]);
  }
  let t: Tree = projection_tree(g, f.values, deps);
  let pos: i32[] = ssa.block_positions(g);
  let strict: i32[][] = [];
  if (lent) {
    strict = spent_by(f, false, t.parent, deps, pos);
  }
  return Reads { dom: ssadeps.dominates(g), par: t.par, at: at, flow: ssalive.compute(g, deps), pos: pos, spent: spent_by(f, lent, t.parent, deps, pos), strict: strict, kids: t.kids, grown: grown_by(g, deps), first: t.first };
}

function projection_tree(g: ssa.SFunc, values: typeinfo.Type[], deps: i32[][]): Tree {
  let par: i32[] = __alloc_i32(values.len());
  let parent: boolean[] = __alloc_bool(values.len());
  let kids: i32[][] = deps;
  let first: i32[] = identity(values.len());
  for b in g.blocks {
    let seen: ssa.SInst[] = [];
    for ins in b.insts {
      if (counted_projection(ins, values)) {
        first = first.with(ins.result, twin_of(seen, ins, first, values));
        seen = seen.append(ins);
        let p: i32 = first[ins.args[0]];
        par = par.with(ins.result, ins.args[0]);
        parent = parent.with(ins.args[0], true).with(ins.result, true);
        kids = kids.with(p, kids[p].append(ins.result));
      }
    }
  }
  return Tree { par: par, parent: parent, kids: kids, first: first };
}

function twin_of(seen: ssa.SInst[], ins: ssa.SInst, first: i32[], values: typeinfo.Type[]): i32 {
  for s in seen {
    if (semcse.same_slot(s, ins, first, values)) {
      return first[s.result];
    }
  }
  return ins.result;
}

function grown_by(g: ssa.SFunc, deps: i32[][]): i32[][] {
  let grown: i32[][] = deps;
  let bi: i32 = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (grows(ins.kind_tag) && ins.args.len() > 0 && ins.args[0] >= 0 && ins.args[0] < grown.len()) {
        grown = grown.with(ins.args[0], grown[ins.args[0]].append(bi));
      }
    }
    bi = bi + 1;
  }
  return grown;
}

function spent_by(f: ssasem.Func, lent: boolean, parent: boolean[], deps: i32[][], pos: i32[]): i32[][] {
  let g: ssa.SFunc = f.graph;
  let spent: i32[][] = deps;
  let bi: i32 = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (spends(ins.kind_tag)) {
        let modes: i32[] = [];
        if (lent && ins.kind_tag == ssasem.call()) {
          modes = callee_modes(f, ins);
        }
        for k in 0..ins.args.len() {
          if (!lent_to(f, modes, ins.args, k)) {
            spent = spend(spent, parent, ins.args[k], bi);
          }
        }
      }
      spent = spend(spent, parent, ssasem.update_base(ins), bi);
    }
    if (b.term.kind_tag == 1) {
      spent = spend(spent, parent, b.term.value, bi);
    }
    spent = spend_phi_inputs(g, pos, b, spent, parent, bi);
    bi = bi + 1;
  }
  return spent;
}

// lent_to says argument k is a record or variant the callee borrows.
// Inference counts no other parameter, so a borrowed string or array may
// still be one the callee keeps.
function lent_to(f: ssasem.Func, modes: i32[], args: i32[], k: i32): boolean {
  return k < modes.len() && modes[k] == ssasem.borrow_mode() && args[k] >= 0 && ssasem.owned_shape(f.values[args[k]]);
}

function callee_modes(f: ssasem.Func, ins: ssa.SInst): i32[] {
  let at: i32 = ssasem.find_contract_in(f.calls, ins.str);
  if (at < 0) {
    return [];
  }
  return f.calls[at].modes;
}

function spends(k: i32): boolean {
  return !projection(k) && k != ssasem.variant_is() && k != ssasem.length() && k != 8;
}

function spend_phi_inputs(g: ssa.SFunc, pos: i32[], b: ssa.SBlock, spent0: i32[][], parent: boolean[], bi: i32): i32[][] {
  let spent: i32[][] = spent0;
  for sid in successors(b.term) {
    let s: ssa.SBlock = g.blocks[pos[sid]];
    let slot: i32 = util.index_of_i32(s.preds, b.id);
    for phi in s.insts {
      if (phi.kind_tag == 8 && slot >= 0 && slot < phi.args.len()) {
        spent = spend(spent, parent, phi.args[slot], bi);
      }
    }
  }
  return spent;
}

function grows(kind: i32): boolean {
  return kind == ssasem.append() || kind == ssasem.with() || kind == ssasem.arr_concat();
}

function spend(own spent: i32[][], parent: boolean[], v: i32, bi: i32): i32[][] {
  if (v < 0 || v >= spent.len() || !parent[v] || util.index_of_i32(spent[v], bi) >= 0) {
    return spent;
  }
  return spent.with(v, spent[v].append(bi));
}

function counted_projection(ins: ssa.SInst, values: typeinfo.Type[]): boolean {
  return projection(ins.kind_tag) && ins.args.len() == read_arity(ins.kind_tag) && ins.result >= 0 && ins.result < values.len()
    && ssasem.reference(values[ins.result]);
}

function read_arity(kind: i32): i32 {
  if (kind == ssasem.array_get()) {
    return 2;
  }
  return 1;
}

function crossing_projections(g: ssa.SFunc, values: typeinfo.Type[]): i32[] {
  let at: i32[] = projection_blocks(g, values);
  if (at.len() == 0) {
    return at;
  }
  let bi: i32 = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (reads_across(g, b, ins, at)) {
        return at;
      }
    }
    if (returns_across(b, at, bi)) {
      return at;
    }
    bi = bi + 1;
  }
  return [];
}

function reads_across(g: ssa.SFunc, b: ssa.SBlock, ins: ssa.SInst, at: i32[]): boolean {
  let slot: i32 = 0;
  for a in ins.args {
    if (a >= 0 && a < at.len() && at[a] >= 0) {
      let from: i32 = b.id;
      if (ins.kind_tag == 8 && slot < b.preds.len()) {
        from = b.preds[slot];
      }
      if (g.blocks[at[a]].id != from) {
        return true;
      }
    }
    slot = slot + 1;
  }
  return false;
}

function returns_across(b: ssa.SBlock, at: i32[], bi: i32): boolean {
  let v: i32 = b.term.value;
  return b.term.kind_tag == 1 && v >= 0 && v < at.len() && at[v] >= 0 && at[v] != bi;
}

function projection_blocks(g: ssa.SFunc, values: typeinfo.Type[]): i32[] {
  let at: i32[] = [];
  let bi: i32 = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (counted_projection(ins, values)) {
        if (at.len() == 0) {
          at = __alloc_i32(values.len());
          let k: i32 = 0;
          while (k < at.len()) {
            at = at.with(k, 0 - 1);
            k = k + 1;
          }
        }
        at = at.with(ins.result, bi);
      }
    }
    bi = bi + 1;
  }
  return at;
}

function repeated_across(g: ssa.SFunc, values: typeinfo.Type[], at: i32[]): boolean {
  let by: i32[][] = [];
  while (by.len() < values.len()) {
    by = by.append([]);
  }
  let reads: ssa.SInst[] = counted_reads(g, values);
  let k: i32 = 0;
  for ins in reads {
    let p: i32 = ins.args[0];
    if (p >= 0 && p < by.len()) {
      if (repeats_one(reads, by[p], ins, at)) {
        return true;
      }
      by = by.with(p, by[p].append(k));
    }
    k = k + 1;
  }
  return false;
}

function repeats_one(reads: ssa.SInst[], seen: i32[], ins: ssa.SInst, at: i32[]): boolean {
  for k in seen {
    let r: ssa.SInst = reads[k];
    if (r.kind_tag == ins.kind_tag && r.imm == ins.imm && r.str == ins.str && at[r.result] != at[ins.result]) {
      return true;
    }
  }
  return false;
}

function rereads_any(rd: Reads, g: ssa.SFunc, bi: i32, b: ssa.SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag != 6 && ins.kind_tag != 8) {
      for a in ins.args {
        if (read_above(rd, bi, a)) {
          return true;
        }
      }
    }
  }
  if (b.term.kind_tag == 1 && read_above(rd, bi, b.term.value)) {
    return true;
  }
  for sid in successors(b.term) {
    let s: ssa.SBlock = g.blocks[rd.pos[sid]];
    let slot: i32 = util.index_of_i32(s.preds, b.id);
    for phi in s.insts {
      if (phi.kind_tag == 8 && slot >= 0 && slot < phi.args.len() && read_above(rd, bi, phi.args[slot])) {
        return true;
      }
    }
  }
  return false;
}

struct Sinking { b: ssa.SBlock, values: typeinfo.Type[], added: i32, edits: PhiEdit[] }

struct Rereads { old: i32[], fresh: i32[], insts: ssa.SInst[], values: typeinfo.Type[] }

function sink_block(rd: Reads, g: ssa.SFunc, bi: i32, b: ssa.SBlock, values: typeinfo.Type[]): Sinking {
  let r: Rereads = Rereads { old: [], fresh: [], insts: [], values: values };
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag == 6 || ins.kind_tag == 8) {
      insts = insts.append(ins);
    } else {
      let args: i32[] = [];
      for a in ins.args {
        r = reread(rd, g, bi, r, a);
        args = args.append(standing(r, a));
      }
      insts = insts.append(ssa.SInst { ...ins, args: args });
    }
  }
  let term: ssa.STerm = b.term;
  if (b.term.kind_tag == 1) {
    r = reread(rd, g, bi, r, b.term.value);
    term = ssa.STerm { ...term, value: standing(r, b.term.value) };
  }
  let edits: PhiEdit[] = [];
  for sid in successors(b.term) {
    let si: i32 = rd.pos[sid];
    let s: ssa.SBlock = g.blocks[si];
    let k: i32 = 0;
    while (k < s.insts.len()) {
      let phi: ssa.SInst = s.insts[k];
      if (phi.kind_tag == 8) {
        let slot: i32 = 0;
        while (slot < s.preds.len() && slot < phi.args.len()) {
          if (s.preds[slot] == b.id) {
            r = reread(rd, g, bi, r, phi.args[slot]);
            let v: i32 = standing(r, phi.args[slot]);
            if (v != phi.args[slot]) {
              edits = edits.append(PhiEdit { block: si, phi: k, slot: slot, value: v });
            }
          }
          slot = slot + 1;
        }
      }
      k = k + 1;
    }
  }
  if (r.insts.len() == 0) {
    return Sinking { b: b, values: values, added: 0, edits: [] };
  }
  let lead: i32 = 0;
  while (lead < insts.len() && (insts[lead].kind_tag == 6 || insts[lead].kind_tag == 8)) {
    lead = lead + 1;
  }
  let out: ssa.SInst[] = [];
  let k: i32 = 0;
  while (k < lead) {
    out = out.append(insts[k]);
    k = k + 1;
  }
  for ins in r.insts {
    out = out.append(ins);
  }
  while (k < insts.len()) {
    out = out.append(insts[k]);
    k = k + 1;
  }
  return Sinking { b: ssa.SBlock { ...b, insts: out, term: term }, values: r.values, added: r.insts.len(), edits: edits };
}

// read_above says v can be read again in bi. With strict spends it says so
// only where a lent argument is what allows it.
function read_above(rd: Reads, bi: i32, v: i32): boolean {
  if (!read_above_for(rd, rd.spent, bi, v, v) || child_used_above(rd, rd.grown, bi, v, 0) || child_live_out(rd, bi, v, 0)) {
    return false;
  }
  return rd.strict.len() == 0 || !read_above_for(rd, rd.strict, bi, v, v);
}

function child_used_above(rd: Reads, by: i32[][], bi: i32, v: i32, depth: i32): boolean {
  if (depth > 8) {
    return true;
  }
  for c in rd.kids[rd.first[v]] {
    for s in by[c] {
      if (s != bi && ssadeps.dom_holds(rd.dom, bi, s)) {
        return true;
      }
    }
    if (child_used_above(rd, by, bi, c, depth + 1)) {
      return true;
    }
  }
  return false;
}

function child_live_out(rd: Reads, bi: i32, v: i32, depth: i32): boolean {
  if (depth > 8) {
    return false;
  }
  for c in rd.kids[rd.first[v]] {
    if (ssalive.live_out_has(rd.flow, bi, c) || child_live_out(rd, bi, c, depth + 1)) {
      return true;
    }
  }
  return false;
}

function read_above_for(rd: Reads, spent: i32[][], bi: i32, v: i32, leaf: i32): boolean {
  if (v < 0 || v >= rd.at.len() || rd.at[v] < 0 || rd.at[v] == bi) {
    return false;
  }
  let p: i32 = rd.par[v];
  if (!ssadeps.dom_holds(rd.dom, bi, rd.at[v]) || ssalive.live_out_has(rd.flow, bi, p)) {
    return false;
  }
  if (!ssalive.live_out_has(rd.flow, rd.at[v], p) && !read_above_for(rd, spent, bi, p, leaf)) {
    return false;
  }
  for s in spent[p] {
    if (s == rd.at[v] || ssalive.live_out_has(rd.flow, s, v) || ssalive.live_out_has(rd.flow, s, leaf)) {
      return false;
    }
  }
  return true;
}

function reread(rd: Reads, g: ssa.SFunc, bi: i32, own r: Rereads, v: i32): Rereads {
  if (!read_above(rd, bi, v) || util.index_of_i32(r.old, v) >= 0) {
    return r;
  }
  let def: ssa.SInst = read_of(g, rd, v);
  r = reread(rd, g, bi, r, def.args[0]);
  let id: i32 = r.values.len();
  let get: ssa.SInst = ssa.SInst { ...def, result: id, args: def.args.with(0, standing(r, def.args[0])) };
  return Rereads { old: r.old.append(v), fresh: r.fresh.append(id), insts: r.insts.append(get), values: r.values.append(r.values[v]) };
}

function read_of(g: ssa.SFunc, rd: Reads, v: i32): ssa.SInst {
  for ins in g.blocks[rd.at[v]].insts {
    if (ins.result == v) {
      return ins;
    }
  }
  return ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
}

function standing(r: Rereads, v: i32): i32 {
  let i: i32 = util.index_of_i32(r.old, v);
  if (i >= 0) {
    return r.fresh[i];
  }
  return v;
}
