import "./ssa";
import "./ssadeps";
import "./ssalive";
import "./semcse";
import "./semlatehold";
import "./ssasem";
import "./typeinfo";
import "./util";

pub struct Sunk { f: ssasem.Func, reread: i32 }

struct Reads { dom: ssadeps.Dom, par: i32[], at: i32[], flow: ssalive.Flow, pos: i32[], spent: i32[][], strict: i32[][], kids: i32[][], grown: i32[][], updated: i32[][], first: i32[], field: i32[], types: typeinfo.Type[] }

struct PhiEdit { block: i32, phi: i32, slot: i32, value: i32 }

pub function sink(f: ssasem.Func): Sunk {
  let ru = reuse(f);
  let sk = sink_rereads(ru.s.f, ru.reads, false, ssadeps.unchecked());
  return Sunk { f: sk.f, reread: ru.s.reread + sk.reread };
}

// sink_to_uses moves a counted record or tuple field read down to the
// block that dominates all of its uses. Each block on the way must have one
// predecessor, and nothing on the way can spend the parent. Thus the read
// enters no loop and crosses no merge. The plan can then take the field on
// the one path that uses it. It runs after the merge of equal reads, so
// that a read does not move away from its twin.
pub function sink_to_uses(f: ssasem.Func): Sunk {
  let n = 0;
  for round in 0..4 {
    let s = sink_to_uses_once(f);
    if (s.reread == 0) {
      return Sunk { f: f, reread: n };
    }
    f = s.f;
    n += s.reread;
  }
  return Sunk { f: f, reread: n };
}

function sink_to_uses_once(f: ssasem.Func): Sunk {
  let g = f.graph;
  let pos = ssa.block_positions(g);
  let dom = ssadeps.dominates_at(g, pos);
  let uses = use_blocks(g, pos, f.values.len());
  let def = util.minus_ones(f.values.len());
  for bi in 0..g.blocks.len() {
    for ins in g.blocks[bi].insts {
      if (ins.result >= 0 && ins.result < def.len()) {
        def = def.with(ins.result, bi);
      }
    }
  }
  let blocks = g.blocks;
  let moved: ssa.SInst[][] = [];
  while (moved.len() < g.blocks.len()) {
    moved = moved.append([]);
  }
  for bi in 0..g.blocks.len() {
    if (dom.pre[bi] >= 0) {
      let insts = g.blocks[bi].insts;
      let kept: boolean[] = [];
      for k in 0..insts.len() {
        kept = kept.append(true);
      }
      let dropped = false;
      for j in 0..insts.len() {
        let i = insts.len() - 1 - j;
        let ins = insts[i];
        if ((ins.kind_tag == ssasem.record_get() || ins.kind_tag == ssasem.tuple_get()) && counted_projection(ins, f.values)) {
          let t = common_dominator(dom, uses[ins.result]);
          if (t >= 0 && t != bi && single_chain(g, pos, dom, bi, t) && !spent_on_way(g, pos, dom, insts, kept, i, bi, t, ancestors(g, def, ins.args[0]))) {
            kept = kept.with(i, false);
            dropped = true;
            moved = moved.with(t, [ins].concat(moved[t]));
            let p = ins.args[0];
            let at = util.index_of_i32(uses[p], bi);
            if (at >= 0) {
              uses = uses.with(p, uses[p].with(at, t));
            }
            def = def.with(ins.result, t);
          }
        }
      }
      if (dropped) {
        let out: ssa.SInst[] = [];
        for k in 0..insts.len() {
          if (kept[k]) {
            out = out.append(insts[k]);
          }
        }
        blocks = blocks.with(bi, ssa.SBlock { ...blocks[bi], insts: out });
      }
    }
  }
  let n = 0;
  for t in 0..moved.len() {
    if (moved[t].len() > 0) {
      n += moved[t].len();
      let b = blocks[t];
      let lead = leading(b.insts);
      let out: ssa.SInst[] = [];
      for k in 0..b.insts.len() {
        if (k == lead) {
          out = out.concat(moved[t]);
        }
        out = out.append(b.insts[k]);
      }
      if (lead == b.insts.len()) {
        out = out.concat(moved[t]);
      }
      blocks = blocks.with(t, ssa.SBlock { ...b, insts: out });
    }
  }
  if (n == 0) {
    return Sunk { f: f, reread: 0 };
  }
  return Sunk { f: ssasem.Func { ...f, graph: ssa.SFunc { ...g, blocks: blocks } }, reread: n };
}

// leading is the number of params and phis at the start of insts.
function leading(insts: ssa.SInst[]): i32 {
  for k in 0..insts.len() {
    if (insts[k].kind_tag != ssa.PARAM && insts[k].kind_tag != ssa.PHI) {
      return k;
    }
  }
  return insts.len();
}

// use_blocks is, per value, the block of each of its uses. A phi uses its
// operand at the end of the predecessor that its slot names.
function use_blocks(g: ssa.SFunc, pos: i32[], n: i32): i32[][] {
  let uses: i32[][] = [];
  while (uses.len() < n) {
    uses = uses.append([]);
  }
  for bi in 0..g.blocks.len() {
    let b = g.blocks[bi];
    for ins in b.insts {
      for slot in 0..ins.args.len() {
        let a = ins.args[slot];
        let at = bi;
        if (ins.kind_tag == ssa.PHI && slot < b.preds.len()) {
          at = pos[b.preds[slot]];
        }
        if (a >= 0 && a < n) {
          uses = uses.with(a, uses[a].append(at));
        }
      }
    }
    let t = b.term;
    if (t.kind_tag == ssa.TERM_BRIF && t.cond >= 0 && t.cond < n) {
      uses = uses.with(t.cond, uses[t.cond].append(bi));
    }
    if (t.kind_tag == ssa.TERM_RET && t.value >= 0 && t.value < n) {
      uses = uses.with(t.value, uses[t.value].append(bi));
    }
  }
  return uses;
}

// common_dominator is the nearest block that dominates each block in at,
// or -1 when at is empty or names an unreachable block.
function common_dominator(dom: ssadeps.Dom, at: i32[]): i32 {
  if (at.len() == 0) {
    return -1;
  }
  let c = at[0];
  for b in at {
    if (dom.pre[b] < 0) {
      return -1;
    }
    while (c >= 0 && !ssadeps.dom_holds(dom, b, c)) {
      c = dom.idom[c];
    }
  }
  return c;
}

// single_chain says each block on the dominator path below from, down to
// to, has one predecessor.
function single_chain(g: ssa.SFunc, pos: i32[], dom: ssadeps.Dom, from: i32, to: i32): boolean {
  let c = to;
  while (c != from) {
    if (c < 0 || g.blocks[c].preds.len() != 1 || pos[g.blocks[c].preds[0]] != dom.idom[c]) {
      return false;
    }
    c = dom.idom[c];
  }
  return true;
}

// ancestors is v and the values it is a field read of, in turn.
function ancestors(g: ssa.SFunc, def: i32[], v: i32): i32[] {
  let up = [v];
  while (up.len() <= 8) {
    let x = up[up.len() - 1];
    if (x < 0 || x >= def.len() || def[x] < 0) {
      return up;
    }
    let ins = read_def(g.blocks[def[x]], x);
    if (!projection(ins.kind_tag) || ins.args.len() == 0) {
      return up;
    }
    up = up.append(ins.args[0]);
  }
  return up;
}

function read_def(b: ssa.SBlock, v: i32): ssa.SInst {
  for ins in b.insts {
    if (ins.result == v) {
      return ins;
    }
  }
  return ssa.no_inst();
}

// spent_on_way says an instruction after i in from, or in a block of the
// chain above to, spends a value in up.
function spent_on_way(g: ssa.SFunc, pos: i32[], dom: ssadeps.Dom, insts: ssa.SInst[], kept: boolean[], i: i32, from: i32, to: i32, up: i32[]): boolean {
  for k in i + 1..insts.len() {
    if (kept[k] && spends_any(insts[k], up)) {
      return true;
    }
  }
  let c = dom.idom[to];
  while (c != from) {
    for ins in g.blocks[c].insts {
      if (spends_any(ins, up)) {
        return true;
      }
    }
    c = dom.idom[c];
  }
  return false;
}

function spends_any(ins: ssa.SInst, up: i32[]): boolean {
  return spends(ins.kind_tag) && touches(ins.args, up) || util.index_of_i32(up, ssasem.update_base(ins)) >= 0;
}

// sink_past_lent re-reads a projection below a call that only borrows its
// parent. It runs once ownership inference has settled the callees' modes,
// which `sink` runs before: a record or variant parameter declared
// borrowed that a callee consumes is counted by then. facts describe the
// graph of f when they are checked.
pub function sink_past_lent(f: ssasem.Func, facts: ssadeps.Facts): Sunk {
  let moved = moves_past_lent(f);
  if (moved.reread > 0) {
    facts = ssadeps.unchecked();
  }
  let sk = sink_rereads(moved.f, None, true, facts);
  if (sk.reread > 0) {
    facts = ssadeps.unchecked();
  }
  let late = semlatehold.reread_before_spends(sk.f, facts);
  return Sunk { f: late.f, reread: moved.reread + sk.reread + late.reread };
}

// moves_past_lent moves a record or tuple field read down to its first use
// in its block, when a call between them lends the parent and no other
// instruction there spends it. The plan can then take the field where it
// is used, instead of holding a count of it across the call. The walk goes
// up the block, so a parent's read follows its field's read down.
function moves_past_lent(f: ssasem.Func): Sunk {
  let g = f.graph;
  let blocks = g.blocks;
  let n = 0;
  for bi in 0..g.blocks.len() {
    let b = g.blocks[bi];
    let insts = b.insts;
    let moved: i32[] = [];
    for k in 0..insts.len() {
      let i = insts.len() - 1 - k;
      let to = lent_target(f, insts, i);
      if (to > i) {
        insts = moved_down(insts, i, to);
        moved = moved.append(i);
      }
    }
    n += moved.len();
    if (moved.len() > 0) {
      blocks = blocks.with(bi, ssa.SBlock { ...b, insts: insts });
    }
  }
  if (n == 0) {
    return Sunk { f: f, reread: 0 };
  }
  return Sunk { f: ssasem.Func { ...f, graph: ssa.SFunc { ...g, blocks: blocks } }, reread: n };
}

// lent_target is the index of the first use of the field read at i, when
// the read may move down to it, or -1.
function lent_target(f: ssasem.Func, insts: ssa.SInst[], i: i32): i32 {
  let ins = insts[i];
  if (ins.kind_tag != ssasem.record_get() && ins.kind_tag != ssasem.tuple_get() || !counted_projection(ins, f.values)) {
    return -1;
  }
  let up = parents_of(insts, i);
  let lent = false;
  for j in i + 1..insts.len() {
    let at = insts[j];
    if (util.index_of_i32(at.args, ins.result) >= 0) {
      if (lent) {
        return j;
      }
      return -1;
    }
    if (at.kind_tag == ssasem.call() && lends_only(f, at, up)) {
      lent = lent || touches(at.args, up);
    } else if (touches(at.args, up) && spends(at.kind_tag)) {
      return -1;
    }
  }
  return -1;
}

// parents_of is the parent of the field read at i, and the parents of that
// parent that are field reads in the same block.
function parents_of(insts: ssa.SInst[], i: i32): i32[] {
  let up = [insts[i].args[0]];
  let k = i - 1;
  while (k >= 0 && up.len() <= 8) {
    let ins = insts[k];
    if (ins.result == up[up.len() - 1] && projection(ins.kind_tag) && ins.args.len() > 0) {
      up = up.append(ins.args[0]);
    }
    k -= 1;
  }
  return up;
}

function touches(args: i32[], up: i32[]): boolean {
  for a in args {
    if (util.index_of_i32(up, a) >= 0) {
      return true;
    }
  }
  return false;
}

// lends_only says the call borrows each of its arguments that is in up.
function lends_only(f: ssasem.Func, call: ssa.SInst, up: i32[]): boolean {
  let modes = ssasem.callee_modes(f, call);
  for k in 0..call.args.len() {
    if (util.index_of_i32(up, call.args[k]) >= 0 && !lent_to(f, modes, call.args, k)) {
      return false;
    }
  }
  return true;
}

function moved_down(insts: ssa.SInst[], i: i32, to: i32): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  for k in 0..insts.len() {
    if (k == to) {
      out = out.append(insts[i]);
    }
    if (k != i) {
      out = out.append(insts[k]);
    }
  }
  return out;
}

struct Reused { s: Sunk, reads: Option[Reads] }

function reuse(f: ssasem.Func): Reused {
  let g = f.graph;
  let at = projection_blocks(g, f.values);
  if (at.len() == 0 || !repeated_across(g, f.values, at)) {
    return Reused { s: Sunk { f: f, reread: 0 }, reads: None };
  }
  let rd = reads_of(f, at, false, ssadeps.unchecked());
  if (!rd.flow.ok) {
    return Reused { s: Sunk { f: f, reread: 0 }, reads: Some(rd) };
  }
  let reads = counted_reads(g, f.values);
  let slots = semcse.read_slots(reads);
  let same = semcse.identity(f.values.len());
  let n = 0;
  for r in reads {
    let bi = rd.at[r.result];
    let first = earlier_read(rd, reads, slots, r, bi, same, f.values);
    if (first >= 0) {
      same = same.with(r.result, first);
      n += 1;
    }
  }
  if (n == 0) {
    return Reused { s: Sunk { f: f, reread: 0 }, reads: Some(rd) };
  }
  return Reused { s: Sunk { f: semcse.replaced(f, same), reread: n }, reads: None };
}

function counted_reads(g: ssa.SFunc, values: typeinfo.Type[]): ssa.SInst[] {
  let reads: ssa.SInst[] = [];
  for b in g.blocks {
    for ins in b.insts {
      if (counted_projection(ins, values)) {
        reads = reads.append(ins);
      }
    }
  }
  return reads;
}

function earlier_read(rd: Reads, reads: ssa.SInst[], slots: semcse.Slots, r: ssa.SInst, bi: i32, same: i32[], values: typeinfo.Type[]): i32 {
  let i = slots.head[semcse.slot_hash(r) & slots.head.len() - 1];
  while (i >= 0) {
    let u = reads[i];
    let ub = rd.at[u.result];
    if (u.result != r.result && ub != bi && ssadeps.dom_holds(rd.dom, bi, ub) && semcse.same_slot(u, r, same, values)
      && (child_used_above(rd, rd.spent, bi, u.result, 0) || child_live_out(rd, bi, u.result, 0) && !field_kept_apart(rd, r, bi))) {
      return semcse.stand_in(same, u.result);
    }
    i = slots.next[i];
  }
  return -1;
}

function field_kept_apart(rd: Reads, r: ssa.SInst, bi: i32): boolean {
  return r.kind_tag == ssasem.record_get() && !ssalive.live_out_has(rd.flow, bi, r.result);
}

function sink_rereads(f: ssasem.Func, known: Option[Reads], lent: boolean, facts: ssadeps.Facts): Sunk {
  let g = f.graph;
  let at = crossing_projections(g, f.values);
  if (at.len() == 0) {
    return Sunk { f: f, reread: 0 };
  }
  let rd = reads_at(f, at, known, lent, facts);
  if (!rd.flow.ok) {
    return Sunk { f: f, reread: 0 };
  }
  let values = f.values;
  let blocks = g.blocks;
  let edits: PhiEdit[] = [];
  let reread = 0;
  let bi = 0;
  for b in g.blocks {
    if (rd.dom.pre[bi] >= 0 && rereads_any(rd, g, bi, b)) {
      let s = sink_block(rd, g, bi, b, values);
      values = s.values;
      reread += s.added;
      blocks = blocks.with(bi, s.b);
      for e in s.edits {
        edits = edits.append(e);
      }
    }
    bi += 1;
  }
  if (reread == 0) {
    return Sunk { f: f, reread: 0 };
  }
  for e in edits {
    let b = blocks[e.block];
    let ins = b.insts[e.phi];
    blocks = blocks.with(e.block, ssa.SBlock { ...b, insts: b.insts.with(e.phi, ssa.SInst { ...ins, args: ins.args.with(e.slot, e.value) }) });
  }
  let graph = ssa.SFunc { ...g, nvals: values.len(), blocks: blocks };
  return Sunk { f: ssasem.Func { ...f, graph: graph, values: values }, reread: reread };
}

function projection(kind: i32): boolean {
  return kind == ssasem.variant_get() || kind == ssasem.record_get() || kind == ssasem.tuple_get() || kind == ssasem.array_get();
}

struct Tree { par: i32[], parent: boolean[], kids: i32[][], first: i32[], field: i32[] }

function reads_at(f: ssasem.Func, at: i32[], known: Option[Reads], lent: boolean, facts: ssadeps.Facts): Reads {
  match (known) {
    Some(k) => {
      return Reads { ...k, at: at };
    },
    None => {
      return reads_of(f, at, lent, facts);
    }
  }
}

// reads_of with lent leaves a call's record or variant argument unspent
// when its callee's contract borrows it, and keeps the spends of every
// argument in strict.
function reads_of(f: ssasem.Func, at: i32[], lent: boolean, facts: ssadeps.Facts): Reads {
  let g = f.graph;
  let deps: i32[][] = [];
  while (deps.len() < f.values.len()) {
    deps = deps.append([]);
  }
  let t = projection_tree(g, f.values, deps);
  let pos = facts.at;
  let dom = facts.dom;
  if (!facts.checked) {
    pos = ssa.block_positions(g);
    dom = ssadeps.dominates_at(g, pos);
  }
  let strict: i32[][] = [];
  if (lent) {
    strict = spent_by(f, false, t.parent, deps, pos);
  }
  return Reads { dom: dom, par: t.par, at: at, flow: ssalive.compute_kept(g, deps, t.parent), pos: pos, spent: spent_by(f, lent, t.parent, deps, pos), strict: strict, kids: t.kids, grown: grown_by(g, deps), updated: updated_by(g, deps, t.first), first: t.first, field: t.field, types: f.values };
}

function projection_tree(g: ssa.SFunc, values: typeinfo.Type[], deps: i32[][]): Tree {
  let par = __alloc_i32(values.len());
  let parent = __alloc_bool(values.len());
  let kids = deps;
  let first = semcse.identity(values.len());
  let field = util.minus_ones(values.len());
  for b in g.blocks {
    let seen: ssa.SInst[] = [];
    for ins in b.insts {
      if (counted_projection(ins, values)) {
        first = first.with(ins.result, twin_of(seen, ins, first, values));
        seen = seen.append(ins);
        let p = first[ins.args[0]];
        par = par.with(ins.result, ins.args[0]);
        parent = parent.with(ins.args[0], true).with(ins.result, true);
        kids = kids.with(p, kids[p].append(ins.result));
        field = field.with(ins.result, ins.imm);
      }
    }
  }
  return Tree { par: par, parent: parent, kids: kids, first: first, field: field };
}

function twin_of(seen: ssa.SInst[], ins: ssa.SInst, first: i32[], values: typeinfo.Type[]): i32 {
  for s in seen {
    if (semcse.same_slot(s, ins, first, values)) {
      return first[s.result];
    }
  }
  return ins.result;
}

function grown_by(g: ssa.SFunc, deps: i32[][]): i32[][] {
  let grown = deps;
  let bi = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (grows(ins.kind_tag) && ins.args.len() > 0 && ins.args[0] >= 0 && ins.args[0] < grown.len()) {
        grown = grown.with(ins.args[0], grown[ins.args[0]].append(bi));
      }
    }
    bi += 1;
  }
  return grown;
}

// An update of any read of a slot counts for that slot's first read.
function updated_by(g: ssa.SFunc, deps: i32[][], first: i32[]): i32[][] {
  let updated = deps;
  let bi = 0;
  for b in g.blocks {
    for ins in b.insts {
      let base = ssasem.update_base(ins);
      if (ins.kind_tag == ssasem.with() && ins.args.len() == 3) {
        base = ins.args[0];
      }
      if (base >= 0 && base < updated.len()) {
        let x = first[base];
        updated = updated.with(x, updated[x].append(bi));
      }
    }
    bi += 1;
  }
  return updated;
}

function spent_by(f: ssasem.Func, lent: boolean, parent: boolean[], deps: i32[][], pos: i32[]): i32[][] {
  let g = f.graph;
  let spent = deps;
  let bi = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (spends(ins.kind_tag)) {
        let modes: i32[] = [];
        if (lent && ins.kind_tag == ssasem.call()) {
          modes = ssasem.callee_modes(f, ins);
        }
        for k in 0..ins.args.len() {
          if (!lent_to(f, modes, ins.args, k)) {
            spent = spend(spent, parent, ins.args[k], bi);
          }
        }
      }
      spent = spend(spent, parent, ssasem.update_base(ins), bi);
    }
    if (b.term.kind_tag == ssa.TERM_RET) {
      spent = spend(spent, parent, b.term.value, bi);
    }
    spent = spend_phi_inputs(g, pos, b, spent, parent, bi);
    bi += 1;
  }
  return spent;
}

// lent_to says argument k is a record, a variant, an array or a map the
// callee borrows. Inference counts a string only where the callee grows it, so
// a borrowed string may still be one the callee keeps.
function lent_to(f: ssasem.Func, modes: i32[], args: i32[], k: i32): boolean {
  return k < modes.len() && modes[k] == ssasem.borrow_mode() && args[k] >= 0 && ssasem.owned_shape(f.values[args[k]]) && !ssasem.is_string(f.values[args[k]]);
}

function spends(k: i32): boolean {
  return !projection(k) && k != ssasem.variant_is() && k != ssasem.length() && k != ssa.PHI;
}

function spend_phi_inputs(g: ssa.SFunc, pos: i32[], b: ssa.SBlock, spent0: i32[][], parent: boolean[], bi: i32): i32[][] {
  let spent = spent0;
  for sid in ssa.successors(b.term) {
    let s = g.blocks[pos[sid]];
    let slot = util.index_of_i32(s.preds, b.id);
    for phi in s.insts {
      if (phi.kind_tag == ssa.PHI && slot >= 0 && slot < phi.args.len()) {
        spent = spend(spent, parent, phi.args[slot], bi);
      }
    }
  }
  return spent;
}

function grows(kind: i32): boolean {
  return kind == ssasem.append() || kind == ssasem.with() || kind == ssasem.arr_concat() || kind == ssasem.truncate();
}

function spend(own spent: i32[][], parent: boolean[], v: i32, bi: i32): i32[][] {
  if (v < 0 || v >= spent.len() || !parent[v] || util.index_of_i32(spent[v], bi) >= 0) {
    return spent;
  }
  return spent.with(v, spent[v].append(bi));
}

function counted_projection(ins: ssa.SInst, values: typeinfo.Type[]): boolean {
  return projection(ins.kind_tag) && ins.args.len() == read_arity(ins.kind_tag) && ins.result >= 0 && ins.result < values.len()
    && ssasem.reference(values[ins.result]);
}

function read_arity(kind: i32): i32 {
  if (kind == ssasem.array_get()) {
    return 2;
  }
  return 1;
}

function crossing_projections(g: ssa.SFunc, values: typeinfo.Type[]): i32[] {
  let at = projection_blocks(g, values);
  if (at.len() == 0) {
    return at;
  }
  let bi = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (reads_across(g, b, ins, at)) {
        return at;
      }
    }
    if (returns_across(b, at, bi)) {
      return at;
    }
    bi += 1;
  }
  return [];
}

function reads_across(g: ssa.SFunc, b: ssa.SBlock, ins: ssa.SInst, at: i32[]): boolean {
  let slot = 0;
  for a in ins.args {
    if (a >= 0 && a < at.len() && at[a] >= 0) {
      let from = b.id;
      if (ins.kind_tag == ssa.PHI && slot < b.preds.len()) {
        from = b.preds[slot];
      }
      if (g.blocks[at[a]].id != from) {
        return true;
      }
    }
    slot += 1;
  }
  return false;
}

function returns_across(b: ssa.SBlock, at: i32[], bi: i32): boolean {
  let v = b.term.value;
  return b.term.kind_tag == ssa.TERM_RET && v >= 0 && v < at.len() && at[v] >= 0 && at[v] != bi;
}

function projection_blocks(g: ssa.SFunc, values: typeinfo.Type[]): i32[] {
  let at: i32[] = [];
  let bi = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (counted_projection(ins, values)) {
        if (at.len() == 0) {
          at = __alloc_i32(values.len());
          let k = 0;
          while (k < at.len()) {
            at = at.with(k, -1);
            k += 1;
          }
        }
        at = at.with(ins.result, bi);
      }
    }
    bi += 1;
  }
  return at;
}

function repeated_across(g: ssa.SFunc, values: typeinfo.Type[], at: i32[]): boolean {
  let by: i32[][] = [];
  while (by.len() < values.len()) {
    by = by.append([]);
  }
  let reads = counted_reads(g, values);
  let k = 0;
  for ins in reads {
    let p = ins.args[0];
    if (p >= 0 && p < by.len()) {
      if (repeats_one(reads, by[p], ins, at)) {
        return true;
      }
      by = by.with(p, by[p].append(k));
    }
    k += 1;
  }
  return false;
}

function repeats_one(reads: ssa.SInst[], seen: i32[], ins: ssa.SInst, at: i32[]): boolean {
  for k in seen {
    let r = reads[k];
    if (r.kind_tag == ins.kind_tag && r.imm == ins.imm && r.str == ins.str && at[r.result] != at[ins.result]) {
      return true;
    }
  }
  return false;
}

function rereads_any(rd: Reads, g: ssa.SFunc, bi: i32, b: ssa.SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag != ssa.PARAM && ins.kind_tag != ssa.PHI) {
      for a in ins.args {
        if (read_above(rd, bi, a)) {
          return true;
        }
      }
    }
  }
  if (b.term.kind_tag == ssa.TERM_RET && read_above(rd, bi, b.term.value)) {
    return true;
  }
  for sid in ssa.successors(b.term) {
    let s = g.blocks[rd.pos[sid]];
    let slot = util.index_of_i32(s.preds, b.id);
    for phi in s.insts {
      if (phi.kind_tag == ssa.PHI && slot >= 0 && slot < phi.args.len() && read_above(rd, bi, phi.args[slot])) {
        return true;
      }
    }
  }
  return false;
}

struct Sinking { b: ssa.SBlock, values: typeinfo.Type[], added: i32, edits: PhiEdit[] }

struct Rereads { old: i32[], fresh: i32[], insts: ssa.SInst[], values: typeinfo.Type[] }

function sink_block(rd: Reads, g: ssa.SFunc, bi: i32, b: ssa.SBlock, values: typeinfo.Type[]): Sinking {
  let r = Rereads { old: [], fresh: [], insts: [], values: values };
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag == ssa.PARAM || ins.kind_tag == ssa.PHI) {
      insts = insts.append(ins);
    } else {
      let args: i32[] = [];
      for a in ins.args {
        r = reread(rd, g, bi, r, a);
        args = args.append(standing(r, a));
      }
      insts = insts.append(ssa.SInst { ...ins, args: args });
    }
  }
  let term = b.term;
  if (b.term.kind_tag == ssa.TERM_RET) {
    r = reread(rd, g, bi, r, b.term.value);
    term = ssa.STerm { ...term, value: standing(r, b.term.value) };
  }
  let edits: PhiEdit[] = [];
  for sid in ssa.successors(b.term) {
    let si = rd.pos[sid];
    let s = g.blocks[si];
    let k = 0;
    while (k < s.insts.len()) {
      let phi = s.insts[k];
      if (phi.kind_tag == ssa.PHI) {
        let slot = 0;
        while (slot < s.preds.len() && slot < phi.args.len()) {
          if (s.preds[slot] == b.id) {
            r = reread(rd, g, bi, r, phi.args[slot]);
            let v = standing(r, phi.args[slot]);
            if (v != phi.args[slot]) {
              edits = edits.append(PhiEdit { block: si, phi: k, slot: slot, value: v });
            }
          }
          slot += 1;
        }
      }
      k += 1;
    }
  }
  if (r.insts.len() == 0) {
    return Sinking { b: b, values: values, added: 0, edits: [] };
  }
  let lead = leading(insts);
  let out: ssa.SInst[] = [];
  let k = 0;
  while (k < lead) {
    out = out.append(insts[k]);
    k += 1;
  }
  for ins in r.insts {
    out = out.append(ins);
  }
  while (k < insts.len()) {
    out = out.append(insts[k]);
    k += 1;
  }
  return Sinking { b: ssa.SBlock { ...b, insts: out, term: term }, values: r.values, added: r.insts.len(), edits: edits };
}

// read_above says v can be read again in bi. With strict spends it says so
// only where a lent argument is what allows it.
function read_above(rd: Reads, bi: i32, v: i32): boolean {
  if (!read_above_for(rd, rd.spent, bi, v, v) || child_used_above(rd, rd.grown, bi, v, 0) || child_live_out(rd, bi, v, 0)) {
    return false;
  }
  if (child_grown_in(rd, bi, v, 0) && child_spent_between(rd, bi, v, 0)) {
    return false;
  }
  if (child_kept_across(rd, bi, v)) {
    return false;
  }
  return rd.strict.len() == 0 || !read_above_for(rd, rd.strict, bi, v, v);
}

// child_kept_across says a read off the first read of v is live into bi and
// is not read again there. A new read of v in bi is then a second read of
// the slot that child came from, and the plan holds the child across it.
function child_kept_across(rd: Reads, bi: i32, v: i32): boolean {
  for c in rd.kids[rd.first[v]] {
    if (rd.at[c] != bi && ssalive.live_in_has(rd.flow, bi, c) && !read_above(rd, bi, c)) {
      return true;
    }
  }
  return false;
}

// An element read off the first read in a dominator, spent there, and
// stored back by a `with` on that array in the re-read's block: the plan
// takes the element out of its slot only when the array it stores back into
// is the array it read, so the first read stays. An array read again in the
// re-read's block gets its element there, and the re-read serves it. It
// costs nothing to keep the first read when no block between it and the
// re-read spends its parent. A spend in a block the first read does not
// dominate is on no path between them.
function child_grown_in(rd: Reads, bi: i32, v: i32, depth: i32): boolean {
  if (depth > 8) {
    return false;
  }
  let x = rd.first[v];
  if (util.index_of_i32(rd.updated[x], bi) >= 0) {
    // Keep the first read for consumed record and variant donors.
    // Array snapshots follow the same block-local rule as array updates.
    if let typeinfo.TypeStruct(_) = rd.types[x] {
      return !read_in(rd, bi, x) || child_spent_between_for(rd, bi, x, 0, true);
    }
    return !read_in(rd, bi, x);
  }
  for c in rd.kids[x] {
    if (child_grown_in(rd, bi, c, depth + 1)) {
      return true;
    }
  }
  return false;
}

// The update block reads the field of x that c reads.
function field_read_in(rd: Reads, bi: i32, x: i32, c: i32): boolean {
  for k in rd.kids[rd.first[x]] {
    if (rd.at[k] == bi && rd.field[k] == rd.field[c]) {
      return true;
    }
  }
  return false;
}

function read_in(rd: Reads, bi: i32, x: i32): boolean {
  for c in rd.kids[x] {
    if (rd.at[c] == bi) {
      return true;
    }
  }
  return false;
}

// A descendant of the first read is spent in a block the first read
// dominates, and is not live into bi.
function child_spent_between(rd: Reads, bi: i32, v: i32, depth: i32): boolean {
  return child_spent_between_for(rd, bi, v, depth, false);
}

// With donors, only a direct field of the record counts, and not one the
// update block reads again: a field lent to a call before the update is
// taken afresh there, not kept. A deeper descendant, such as an element of
// a field that a call borrows, says nothing about the record's box.
function child_spent_between_for(rd: Reads, bi: i32, v: i32, depth: i32, donors: boolean): boolean {
  if (depth > 8) {
    return false;
  }
  for c in rd.kids[rd.first[v]] {
    if ((!donors || ssasem.box_shape(rd.types[c]) && !field_read_in(rd, bi, v, c)) && !ssalive.live_in_has(rd.flow, bi, c)) {
      for s in rd.spent[c] {
        if (s != bi && ssadeps.dom_holds(rd.dom, s, rd.at[v])) {
          return true;
        }
      }
    }
    if (!donors && child_spent_between_for(rd, bi, c, depth + 1, donors)) {
      return true;
    }
  }
  return false;
}

function child_used_above(rd: Reads, by: i32[][], bi: i32, v: i32, depth: i32): boolean {
  if (depth > 8) {
    return true;
  }
  for c in rd.kids[rd.first[v]] {
    for s in by[c] {
      if (s != bi && ssadeps.dom_holds(rd.dom, bi, s)) {
        return true;
      }
    }
    if (child_used_above(rd, by, bi, c, depth + 1)) {
      return true;
    }
  }
  return false;
}

function child_live_out(rd: Reads, bi: i32, v: i32, depth: i32): boolean {
  if (depth > 8) {
    return false;
  }
  for c in rd.kids[rd.first[v]] {
    if (ssalive.live_out_has(rd.flow, bi, c) || child_live_out(rd, bi, c, depth + 1)) {
      return true;
    }
  }
  return false;
}

function read_above_for(rd: Reads, spent: i32[][], bi: i32, v: i32, leaf: i32): boolean {
  if (v < 0 || v >= rd.at.len() || rd.at[v] < 0 || rd.at[v] == bi) {
    return false;
  }
  let p = rd.par[v];
  if (!ssadeps.dom_holds(rd.dom, bi, rd.at[v]) || ssalive.live_out_has(rd.flow, bi, p)) {
    return false;
  }
  if (ssalive.live_out_has(rd.flow, rd.at[v], p)) {
    if (ancestor_spent_past(rd, spent, p, leaf)) {
      return false;
    }
  } else if (!read_above_for(rd, spent, bi, p, leaf)) {
    return false;
  }
  for s in spent[p] {
    if (s == rd.at[v] || ssalive.live_out_has(rd.flow, s, v) || ssalive.live_out_has(rd.flow, s, leaf)) {
      return false;
    }
  }
  return true;
}

// An ancestor of p is spent while leaf is live and p is not. A re-read of
// leaf from p keeps p past that spend, and the plan must then hold p.
function ancestor_spent_past(rd: Reads, spent: i32[][], p: i32, leaf: i32): boolean {
  let a = p;
  let depth = 0;
  while (depth <= 8 && rd.at[a] >= 0) {
    a = rd.par[a];
    for s in spent[a] {
      if (ssalive.live_out_has(rd.flow, s, leaf) && !ssalive.live_out_has(rd.flow, s, p)) {
        return true;
      }
    }
    depth += 1;
  }
  return false;
}

function reread(rd: Reads, g: ssa.SFunc, bi: i32, own r: Rereads, v: i32): Rereads {
  if (!read_above(rd, bi, v) || util.index_of_i32(r.old, v) >= 0) {
    return r;
  }
  let def = read_of(g, rd, v);
  r = reread(rd, g, bi, r, def.args[0]);
  let id = r.values.len();
  let get = ssa.SInst { ...def, result: id, args: def.args.with(0, standing(r, def.args[0])) };
  return Rereads { old: r.old.append(v), fresh: r.fresh.append(id), insts: r.insts.append(get), values: r.values.append(r.values[v]) };
}

function read_of(g: ssa.SFunc, rd: Reads, v: i32): ssa.SInst {
  for ins in g.blocks[rd.at[v]].insts {
    if (ins.result == v) {
      return ins;
    }
  }
  return ssa.no_inst();
}

function standing(r: Rereads, v: i32): i32 {
  let i = util.index_of_i32(r.old, v);
  if (i >= 0) {
    return r.fresh[i];
  }
  return v;
}
