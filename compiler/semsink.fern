// A block re-reads, at its start, the counted projections it uses that a
// block dominating it read, when the projection's parent dies in it: each
// from the same parent, so the re-read is the same value. Read where the
// parent dies, a projection is one the plan takes out of the box rather than
// borrows: a child handed on arrives with its one unit rather than two, and
// a child taken that way can be the box a construction in the block builds
// in. A nested pattern is the shape: it reads the payloads before the inner
// test, where a failed test still needs the scrutinee for the arms after it,
// and the arm that rebuilds the node lies below the test. A block's uses
// include the phi operands its edges hand on, which is how a recursive
// update that became a loop passes the child it descends into. A projection
// whose parent is itself one read above is re-read from the parent's re-read.
// First, a read that repeats one a dominating block made is that read when
// the plan must take the first (`reuse`).
import "./ssa";
import "./ssadeps";
import "./ssalive";
import "./semcse";
import "./ssasem";
import "./typeinfo";
import "./util";

pub struct Sunk { f: ssasem.Func, reread: i32 }

// Each counted projection's parent and the position of its block, by value,
// -1 for every other value's block; the dominator tree; which values are live
// out of each block, counting only the uses that name them; and, by value,
// the positions of the blocks that use it other than to read a projection of
// it or test its variant.
struct Reads { dom: ssadeps.Dom, par: i32[], at: i32[], flow: ssalive.Flow, pos: i32[], spent: i32[][], kids: i32[][], grown: i32[][], first: i32[] }

// A phi operand a block's edge hands on, rewritten to the block's re-read.
struct PhiEdit { block: i32, phi: i32, slot: i32, value: i32 }

pub function sink(f: ssasem.Func): Sunk {
  let ru: Sunk = reuse(f);
  let sk: Sunk = sink_rereads(ru.f);
  return Sunk { f: sk.f, reread: ru.reread + sk.reread };
}

// A counted projection read off the same parent and slot as one a dominating
// block read is that read when the first is one the plan must take out of
// the box (child_used_above): a second read of the slot would find it
// emptied. So is a read still live out of its block, which sink_rereads then
// reads again where it is used. `reread` counts the reads replaced.
function reuse(f: ssasem.Func): Sunk {
  let g: ssa.SFunc = f.graph;
  let at: i32[] = projection_blocks(g, f.values);
  if (at.len() == 0 || !repeated_across(g, f.values, at)) {
    return Sunk { f: f, reread: 0 };
  }
  let rd: Reads = reads_of(g, f.values, at);
  if (!rd.flow.ok) {
    return Sunk { f: f, reread: 0 };
  }
  let reads: ssa.SInst[] = counted_reads(g, f.values);
  let same: i32[] = identity(f.values.len());
  let n: i32 = 0;
  for r in reads {
    let bi: i32 = rd.at[r.result];
    let first: i32 = earlier_read(rd, reads, r, bi, same, f.values);
    if (first >= 0) {
      same = same.with(r.result, first);
      n = n + 1;
    }
  }
  if (n == 0) {
    return Sunk { f: f, reread: 0 };
  }
  return Sunk { f: semcse.replaced(f, same), reread: n };
}

// The counted projections of `g`, in block order.
function counted_reads(g: ssa.SFunc, values: typeinfo.Type[]): ssa.SInst[] {
  let reads: ssa.SInst[] = [];
  for b in g.blocks {
    for ins in b.insts {
      if (counted_projection(ins, values)) {
        reads = reads.append(ins);
      }
    }
  }
  return reads;
}

// Each of `n` values standing for itself.
function identity(n: i32): i32[] {
  let out: i32[] = __alloc_i32(n);
  let k: i32 = 0;
  while (k < n) {
    out = out.with(k, k);
    k = k + 1;
  }
  return out;
}

// The read in a block strictly dominating the one at `bi` that `r` repeats,
// when that read must be taken or `r` is live out of `bi`. -1 for none.
function earlier_read(rd: Reads, reads: ssa.SInst[], r: ssa.SInst, bi: i32, same: i32[], values: typeinfo.Type[]): i32 {
  for u in reads {
    let ub: i32 = rd.at[u.result];
    if (u.result != r.result && ub != bi && ssadeps.dom_holds(rd.dom, bi, ub) && semcse.same_slot(u, r, same, values)
      && (child_used_above(rd, rd.spent, bi, u.result, 0) || ssalive.live_out_has(rd.flow, bi, r.result))) {
      return semcse.stand_in(same, u.result);
    }
  }
  return 0 - 1;
}

function sink_rereads(f: ssasem.Func): Sunk {
  let g: ssa.SFunc = f.graph;
  let at: i32[] = crossing_projections(g, f.values);
  if (at.len() == 0) {
    return Sunk { f: f, reread: 0 };
  }
  let rd: Reads = reads_of(g, f.values, at);
  if (!rd.flow.ok) {
    return Sunk { f: f, reread: 0 };
  }
  let values: typeinfo.Type[] = f.values;
  let blocks: ssa.SBlock[] = g.blocks;
  let edits: PhiEdit[] = [];
  let reread: i32 = 0;
  let bi: i32 = 0;
  for b in g.blocks {
    if (rd.dom.pre[bi] >= 0 && rereads_any(rd, g, bi, b)) {
      let s: Sinking = sink_block(rd, g, bi, b, values);
      values = s.values;
      reread = reread + s.added;
      blocks = blocks.with(bi, s.b);
      for e in s.edits {
        edits = edits.append(e);
      }
    }
    bi = bi + 1;
  }
  if (reread == 0) {
    return Sunk { f: f, reread: 0 };
  }
  for e in edits {
    let b: ssa.SBlock = blocks[e.block];
    let ins: ssa.SInst = b.insts[e.phi];
    blocks = blocks.with(e.block, ssa.SBlock { ...b, insts: b.insts.with(e.phi, ssa.SInst { ...ins, args: ins.args.with(e.slot, e.value) }) });
  }
  let graph: ssa.SFunc = ssa.SFunc { ...g, nvals: values.len(), blocks: blocks };
  return Sunk { f: ssasem.Func { ...f, graph: graph, values: values }, reread: reread };
}

function successors(t: ssa.STerm): i32[] {
  let out: i32[] = [];
  let k: i32 = 0;
  let id: i32 = ssa.successor_id(t, k);
  while (id >= 0) {
    if (util.index_of_i32(out, id) < 0) {
      out = out.append(id);
    }
    k = k + 1;
    id = ssa.successor_id(t, k);
  }
  return out;
}

function projection(kind: i32): boolean {
  return kind == ssasem.variant_get() || kind == ssasem.record_get() || kind == ssasem.tuple_get() || kind == ssasem.array_get();
}

// `at` is crossing_projections'.
struct Tree { par: i32[], parent: boolean[], kids: i32[][], first: i32[] }

function reads_of(g: ssa.SFunc, values: typeinfo.Type[], at: i32[]): Reads {
  let deps: i32[][] = [];
  while (deps.len() < values.len()) {
    deps = deps.append([]);
  }
  let t: Tree = projection_tree(g, values, deps);
  let pos: i32[] = ssa.block_positions(g);
  return Reads { dom: ssadeps.dominates(g), par: t.par, at: at, flow: ssalive.compute(g, deps), pos: pos, spent: spent_by(g, t.parent, deps, pos), kids: t.kids, grown: grown_by(g, deps), first: t.first };
}

// The children of each read are kept under the block's first read of the same
// slot (`first`), since semcse merges the two only after this pass.
function projection_tree(g: ssa.SFunc, values: typeinfo.Type[], deps: i32[][]): Tree {
  let par: i32[] = __alloc_i32(values.len());
  let parent: boolean[] = __alloc_bool(values.len());
  let kids: i32[][] = deps;
  let first: i32[] = identity(values.len());
  for b in g.blocks {
    let seen: ssa.SInst[] = [];
    for ins in b.insts {
      if (counted_projection(ins, values)) {
        first = first.with(ins.result, twin_of(seen, ins, first, values));
        seen = seen.append(ins);
        let p: i32 = first[ins.args[0]];
        par = par.with(ins.result, ins.args[0]);
        parent = parent.with(ins.args[0], true).with(ins.result, true);
        kids = kids.with(p, kids[p].append(ins.result));
      }
    }
  }
  return Tree { par: par, parent: parent, kids: kids, first: first };
}

// The first of `seen` that reads the slot `ins` reads, else `ins` itself.
function twin_of(seen: ssa.SInst[], ins: ssa.SInst, first: i32[], values: typeinfo.Type[]): i32 {
  for s in seen {
    if (semcse.same_slot(s, ins, first, values)) {
      return first[s.result];
    }
  }
  return ins.result;
}

function grown_by(g: ssa.SFunc, deps: i32[][]): i32[][] {
  let grown: i32[][] = deps;
  let bi: i32 = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (grows(ins.kind_tag) && ins.args.len() > 0 && ins.args[0] >= 0 && ins.args[0] < grown.len()) {
        grown = grown.with(ins.args[0], grown[ins.args[0]].append(bi));
      }
    }
    bi = bi + 1;
  }
  return grown;
}

function spent_by(g: ssa.SFunc, parent: boolean[], deps: i32[][], pos: i32[]): i32[][] {
  let spent: i32[][] = deps;
  let bi: i32 = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (spends(ins.kind_tag)) {
        for a in ins.args {
          spent = spend(spent, parent, a, bi);
        }
      }
      // A record update spends its donor too, which `imm` names.
      spent = spend(spent, parent, ssasem.update_base(ins), bi);
    }
    if (b.term.kind_tag == 1) {
      spent = spend(spent, parent, b.term.value, bi);
    }
    spent = spend_phi_inputs(g, pos, b, spent, parent, bi);
    bi = bi + 1;
  }
  return spent;
}

// Whether an instruction of kind `k` spends its operands: anything but a
// read of a part, a variant test, a length or a phi.
function spends(k: i32): boolean {
  return !projection(k) && k != ssasem.variant_is() && k != ssasem.length() && k != 8;
}

// A phi input is spent at the end of the predecessor that passes it.
function spend_phi_inputs(g: ssa.SFunc, pos: i32[], b: ssa.SBlock, spent0: i32[][], parent: boolean[], bi: i32): i32[][] {
  let spent: i32[][] = spent0;
  for sid in successors(b.term) {
    let s: ssa.SBlock = g.blocks[pos[sid]];
    let slot: i32 = util.index_of_i32(s.preds, b.id);
    for phi in s.insts {
      if (phi.kind_tag == 8 && slot >= 0 && slot < phi.args.len()) {
        spent = spend(spent, parent, phi.args[slot], bi);
      }
    }
  }
  return spent;
}

// An update of its first operand, in place when that operand is the box's
// only holder.
function grows(kind: i32): boolean {
  return kind == ssasem.append() || kind == ssasem.with() || kind == ssasem.arr_concat();
}

function spend(own spent: i32[][], parent: boolean[], v: i32, bi: i32): i32[][] {
  if (v < 0 || v >= spent.len() || !parent[v] || util.index_of_i32(spent[v], bi) >= 0) {
    return spent;
  }
  return spent.with(v, spent[v].append(bi));
}

function counted_projection(ins: ssa.SInst, values: typeinfo.Type[]): boolean {
  return projection(ins.kind_tag) && ins.args.len() == read_arity(ins.kind_tag) && ins.result >= 0 && ins.result < values.len()
    && ssasem.reference(values[ins.result]);
}

// An array read names its index after the array; the index is defined
// above the read it repeats, so it is in hand wherever the re-read goes.
function read_arity(kind: i32): i32 {
  if (kind == ssasem.array_get()) {
    return 2;
  }
  return 1;
}

// The position of each counted projection's block, by value, -1 for every
// other value; empty when no block uses one another block read, since only
// then is there anything to re-read, and the liveness and dominators are
// worth computing. A phi operand is a use in the predecessor its edge
// leaves.
function crossing_projections(g: ssa.SFunc, values: typeinfo.Type[]): i32[] {
  let at: i32[] = projection_blocks(g, values);
  if (at.len() == 0) {
    return at;
  }
  let bi: i32 = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (reads_across(g, b, ins, at)) {
        return at;
      }
    }
    if (returns_across(b, at, bi)) {
      return at;
    }
    bi = bi + 1;
  }
  return [];
}

// An operand reads a projection made in another block. A phi's operand is
// read at the end of its predecessor.
function reads_across(g: ssa.SFunc, b: ssa.SBlock, ins: ssa.SInst, at: i32[]): boolean {
  let slot: i32 = 0;
  for a in ins.args {
    if (a >= 0 && a < at.len() && at[a] >= 0) {
      let from: i32 = b.id;
      if (ins.kind_tag == 8 && slot < b.preds.len()) {
        from = b.preds[slot];
      }
      if (g.blocks[at[a]].id != from) {
        return true;
      }
    }
    slot = slot + 1;
  }
  return false;
}

function returns_across(b: ssa.SBlock, at: i32[], bi: i32): boolean {
  let v: i32 = b.term.value;
  return b.term.kind_tag == 1 && v >= 0 && v < at.len() && at[v] >= 0 && at[v] != bi;
}

// The position of each counted projection's block, by value, -1 for every
// other value; empty when there is no counted projection.
function projection_blocks(g: ssa.SFunc, values: typeinfo.Type[]): i32[] {
  let at: i32[] = [];
  let bi: i32 = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (counted_projection(ins, values)) {
        if (at.len() == 0) {
          at = __alloc_i32(values.len());
          let k: i32 = 0;
          while (k < at.len()) {
            at = at.with(k, 0 - 1);
            k = k + 1;
          }
        }
        at = at.with(ins.result, bi);
      }
    }
    bi = bi + 1;
  }
  return at;
}

// Whether a value has two counted reads of the same slot in different
// blocks, the only case reuse can act on, so the dominators and liveness
// it needs are computed for nothing else.
function repeated_across(g: ssa.SFunc, values: typeinfo.Type[], at: i32[]): boolean {
  let by: i32[][] = [];
  while (by.len() < values.len()) {
    by = by.append([]);
  }
  let reads: ssa.SInst[] = counted_reads(g, values);
  let k: i32 = 0;
  for ins in reads {
    let p: i32 = ins.args[0];
    if (p >= 0 && p < by.len()) {
      if (repeats_one(reads, by[p], ins, at)) {
        return true;
      }
      by = by.with(p, by[p].append(k));
    }
    k = k + 1;
  }
  return false;
}

// Whether `ins` reads the slot one of the reads `seen` names reads, in
// another block.
function repeats_one(reads: ssa.SInst[], seen: i32[], ins: ssa.SInst, at: i32[]): boolean {
  for k in seen {
    let r: ssa.SInst = reads[k];
    if (r.kind_tag == ins.kind_tag && r.imm == ins.imm && r.str == ins.str && at[r.result] != at[ins.result]) {
      return true;
    }
  }
  return false;
}

// Whether the block at `bi` re-reads anything: sink_block rebuilds a block,
// so it is run only on one that does.
function rereads_any(rd: Reads, g: ssa.SFunc, bi: i32, b: ssa.SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag != 6 && ins.kind_tag != 8) {
      for a in ins.args {
        if (read_above(rd, bi, a)) {
          return true;
        }
      }
    }
  }
  if (b.term.kind_tag == 1 && read_above(rd, bi, b.term.value)) {
    return true;
  }
  for sid in successors(b.term) {
    let s: ssa.SBlock = g.blocks[rd.pos[sid]];
    let slot: i32 = util.index_of_i32(s.preds, b.id);
    for phi in s.insts {
      if (phi.kind_tag == 8 && slot >= 0 && slot < phi.args.len() && read_above(rd, bi, phi.args[slot])) {
        return true;
      }
    }
  }
  return false;
}

struct Sinking { b: ssa.SBlock, values: typeinfo.Type[], added: i32, edits: PhiEdit[] }

// The re-reads made in one block: `old[i]` stands as `fresh[i]` there.
struct Rereads { old: i32[], fresh: i32[], insts: ssa.SInst[], values: typeinfo.Type[] }

function sink_block(rd: Reads, g: ssa.SFunc, bi: i32, b: ssa.SBlock, values: typeinfo.Type[]): Sinking {
  let r: Rereads = Rereads { old: [], fresh: [], insts: [], values: values };
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag == 6 || ins.kind_tag == 8) {
      insts = insts.append(ins);
    } else {
      let args: i32[] = [];
      for a in ins.args {
        r = reread(rd, g, bi, r, a);
        args = args.append(standing(r, a));
      }
      insts = insts.append(ssa.SInst { ...ins, args: args });
    }
  }
  let term: ssa.STerm = b.term;
  if (b.term.kind_tag == 1) {
    r = reread(rd, g, bi, r, b.term.value);
    term = ssa.STerm { ...term, value: standing(r, b.term.value) };
  }
  let edits: PhiEdit[] = [];
  for sid in successors(b.term) {
    let si: i32 = rd.pos[sid];
    let s: ssa.SBlock = g.blocks[si];
    let k: i32 = 0;
    while (k < s.insts.len()) {
      let phi: ssa.SInst = s.insts[k];
      if (phi.kind_tag == 8) {
        let slot: i32 = 0;
        while (slot < s.preds.len() && slot < phi.args.len()) {
          if (s.preds[slot] == b.id) {
            r = reread(rd, g, bi, r, phi.args[slot]);
            let v: i32 = standing(r, phi.args[slot]);
            if (v != phi.args[slot]) {
              edits = edits.append(PhiEdit { block: si, phi: k, slot: slot, value: v });
            }
          }
          slot = slot + 1;
        }
      }
      k = k + 1;
    }
  }
  if (r.insts.len() == 0) {
    return Sinking { b: b, values: values, added: 0, edits: [] };
  }
  // The re-reads go ahead of everything but the block's parameters and phis.
  let lead: i32 = 0;
  while (lead < insts.len() && (insts[lead].kind_tag == 6 || insts[lead].kind_tag == 8)) {
    lead = lead + 1;
  }
  let out: ssa.SInst[] = [];
  let k: i32 = 0;
  while (k < lead) {
    out = out.append(insts[k]);
    k = k + 1;
  }
  for ins in r.insts {
    out = out.append(ins);
  }
  while (k < insts.len()) {
    out = out.append(insts[k]);
    k = k + 1;
  }
  return Sinking { b: ssa.SBlock { ...b, insts: out, term: term }, values: r.values, added: r.insts.len(), edits: edits };
}

// Whether `v` is a counted projection read in a block strictly dominating
// the block at `bi`, of a parent that is not live out of it, where the
// re-read keeps the parent no longer than the plan already must. The first
// read borrowed: its parent lived on past its block, or can be re-read here
// too. A read whose parent died with it took the child already, and a
// re-read would hold the parent to here. Nor may anything spend the parent
// while the child lives: a parent handed on, a record moved into a loop say,
// would have to be kept for the re-read and copied by whoever it went to.
// Nor may a child of the first read be live out of the block. The plan takes
// such a re-read only if it holds that child, at the cost of a count.
function read_above(rd: Reads, bi: i32, v: i32): boolean {
  return read_above_for(rd, bi, v, v) && !child_used_above(rd, rd.grown, bi, v, 0) && !child_live_out(rd, bi, v, 0);
}

// Whether a projection read off `v`, at any depth, has a use `by` names in a
// block other than the one at `bi` that dominates it. `by` is `rd.spent`,
// any use but a further read, or `rd.grown`, an update in place. Such a read
// is one the plan must take out of its box, and every read on the way to it
// with it, so the slot `v` came from must not be read again: a read at `bi`
// is a second read of it.
function child_used_above(rd: Reads, by: i32[][], bi: i32, v: i32, depth: i32): boolean {
  if (depth > 8) {
    return true;
  }
  for c in rd.kids[rd.first[v]] {
    for s in by[c] {
      if (s != bi && ssadeps.dom_holds(rd.dom, bi, s)) {
        return true;
      }
    }
    if (child_used_above(rd, by, bi, c, depth + 1)) {
      return true;
    }
  }
  return false;
}

// Whether a projection read off `v`, at any depth, is still live out of the
// block at `bi`. Such a projection reaches the parent through `v`, so the plan
// must hold it to take a second read of `v`'s slot at `bi` (`twin_holds`).
function child_live_out(rd: Reads, bi: i32, v: i32, depth: i32): boolean {
  if (depth > 8) {
    return false;
  }
  for c in rd.kids[rd.first[v]] {
    if (ssalive.live_out_has(rd.flow, bi, c) || child_live_out(rd, bi, c, depth + 1)) {
      return true;
    }
  }
  return false;
}

// read_above for `v`, a parent on the way to `leaf`, the value the block
// uses: a parent spent while the leaf is still to be used is gone by the
// time the block would re-read it.
function read_above_for(rd: Reads, bi: i32, v: i32, leaf: i32): boolean {
  if (v < 0 || v >= rd.at.len() || rd.at[v] < 0 || rd.at[v] == bi) {
    return false;
  }
  let p: i32 = rd.par[v];
  if (!ssadeps.dom_holds(rd.dom, bi, rd.at[v]) || ssalive.live_out_has(rd.flow, bi, p)) {
    return false;
  }
  if (!ssalive.live_out_has(rd.flow, rd.at[v], p) && !read_above_for(rd, bi, p, leaf)) {
    return false;
  }
  for s in rd.spent[p] {
    if (s == rd.at[v] || ssalive.live_out_has(rd.flow, s, v) || ssalive.live_out_has(rd.flow, s, leaf)) {
      return false;
    }
  }
  return !spent_under(rd, p, leaf, 0);
}

// Whether a parent above the read `v` is spent where `leaf` is still live. A
// re-read of `v` reads through that parent, and finds the slot gone.
function spent_under(rd: Reads, v: i32, leaf: i32, depth: i32): boolean {
  if (depth > 8) {
    return true;
  }
  if (v < 0 || v >= rd.at.len() || rd.at[v] < 0) {
    return false;
  }
  let p: i32 = rd.par[v];
  for s in rd.spent[p] {
    if (ssalive.live_out_has(rd.flow, s, leaf)) {
      return true;
    }
  }
  return spent_under(rd, p, leaf, depth + 1);
}

// `r` with `v` re-read in the block when it is read above, its parent first
// when that is too.
function reread(rd: Reads, g: ssa.SFunc, bi: i32, own r: Rereads, v: i32): Rereads {
  if (!read_above(rd, bi, v) || util.index_of_i32(r.old, v) >= 0) {
    return r;
  }
  let def: ssa.SInst = read_of(g, rd, v);
  r = reread(rd, g, bi, r, def.args[0]);
  let id: i32 = r.values.len();
  let get: ssa.SInst = ssa.SInst { ...def, result: id, args: def.args.with(0, standing(r, def.args[0])) };
  return Rereads { old: r.old.append(v), fresh: r.fresh.append(id), insts: r.insts.append(get), values: r.values.append(r.values[v]) };
}

// The instruction reading counted projection `v`.
function read_of(g: ssa.SFunc, rd: Reads, v: i32): ssa.SInst {
  for ins in g.blocks[rd.at[v]].insts {
    if (ins.result == v) {
      return ins;
    }
  }
  return ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
}

// The value standing for `v` in the block: its re-read, else itself.
function standing(r: Rereads, v: i32): i32 {
  let i: i32 = util.index_of_i32(r.old, v);
  if (i >= 0) {
    return r.fresh[i];
  }
  return v;
}
