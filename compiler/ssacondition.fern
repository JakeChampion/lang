// Comparison outcomes are 1 for true, 0 for false and -1 when the proof cannot decide.
pub struct Comparison { less: i32, equal: i32, less_equal: i32 }

pub struct Flags { order: Comparison, signed: Comparison, sign: i32 }

pub function truth(always: boolean, never: boolean): i32 {
  return if (always) { 1 } else { if (never) { 0 } else { -1 } };
}

pub function compare_interval(low: i64, high: i64, n: i64): Comparison {
  return Comparison {
    less: truth(high < n, low >= n),
    equal: truth(low == n && high == n, n < low || n > high),
    less_equal: truth(high <= n, low > n),
  };
}

pub function unknown_order(): Comparison {
  return Comparison { less: -1, equal: -1, less_equal: -1 };
}

pub function unknown_flags(): Flags {
  return Flags { order: unknown_order(), signed: unknown_order(), sign: -1 };
}

function invert(v: i32): i32 {
  return if (v < 0) { -1 } else { 1 - v };
}

function ordered(f: Comparison, name: string): i32 {
  if (name == "jb" || name == "jc" || name == "jnae") {
    return f.less;
  }
  if (name == "jae" || name == "jnb" || name == "jnc") {
    return invert(f.less);
  }
  return inclusive(f, name);
}

function inclusive(f: Comparison, name: string): i32 {
  if (name == "jbe" || name == "jna") {
    return f.less_equal;
  }
  if (name == "ja" || name == "jnbe") {
    return invert(f.less_equal);
  }
  return -1;
}

pub function unsigned_branch(f: Comparison, name: string): i32 {
  if (name == "jmp") {
    return 1;
  }
  if (name == "je" || name == "jz") {
    return f.equal;
  }
  if (name == "jne" || name == "jnz") {
    return invert(f.equal);
  }
  return ordered(f, name);
}

pub function branch(f: Flags, name: string): i32 {
  if (name == "js") {
    return f.sign;
  }
  if (name == "jns") {
    return invert(f.sign);
  }
  return signed_branch(f, name);
}

function signed_branch(f: Flags, name: string): i32 {
  if (name == "jl" || name == "jnge") {
    return f.signed.less;
  }
  if (name == "jge" || name == "jnl") {
    return invert(f.signed.less);
  }
  if (name == "jle" || name == "jng") {
    return f.signed.less_equal;
  }
  if (name == "jg" || name == "jnle") {
    return invert(f.signed.less_equal);
  }
  return unsigned_branch(f.order, name);
}
