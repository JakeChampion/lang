    "function __fern_process_alive(pid: i32): i32 {\n  if (pid <= 0) {\n    return 0;\n  }\n  let rc: i32 = __syscall3(129, pid as i64, 0, 0) as i32;\n  if (rc == 0) {\n    return 1;\n  }\n  if (rc == 0 - 1) {\n    return 1;\n  }\n  return 0;\n}\n",
    "function __fern_profile_finish(base: usize): void {\n  let mask: usize = 4096;\n  if (__FERN_PROFILE_MODE == 1 || __FERN_PROFILE_MODE == 3) {\n    __syscall3(103, 2, (base + 96) as i64, 0);\n    mask = 67112960;\n  }\n  __raw_store_ptr(base + 48, 0, mask);\n  __syscall4(135, 0, (base + 48) as i64, 0, 8);\n  __raw_store_ptr(base + 24, 0, 0);\n  let path: string = \"/proc/self/exe\";\n  let j: i32 = 0;\n  while (j < path.len()) {\n    __raw_store8(base + 48, j, __load_u8(__raw_data(path) + j));\n    j = j + 1;\n  }\n  __raw_store8(base + 48, j, 0);\n  let fd: i64 = __syscall4(56, 0 - 100, (base + 48) as i64, 0, 0);\n  let size: usize = 0;\n  let im: usize = 0;\n  if (fd >= 0 as i64) {\n    let len: i64 = __syscall3(62, fd, 0, 2);\n    if (len > 0 as i64) {\n      let mapped: i64 = __syscall6(222, 0, len, 1, 2, fd, 0);\n      if (mapped > 0 as i64) {\n        im = mapped as usize;\n        size = len as usize;\n      }\n    }\n    __syscall3(57, fd, 0, 0);\n  }\n  if (__FERN_PROFILE_MODE > 2) {\n    __fern_profile_pprof(base, im, size);\n  } else {\n    let header: string = \"# fern CPU profile samples=\";\n    if (__FERN_PROFILE_MODE == 2) {\n      header = \"# fern allocation profile samples=\";\n    }\n    __fern_profile_write(__raw_data(header), header.len() as usize);\n    let count: usize = __load_i64(base) as usize;\n    __fern_profile_number(base + 64, count);\n    let lost: string = \" dropped=\";\n    __fern_profile_write(__raw_data(lost), lost.len() as usize);\n    __fern_profile_number(base + 64, __load_i64(base + 8) as usize);\n    if (__FERN_PROFILE_MODE == 2) {\n      let units: string = \" interval=64 weight=rounded-bytes\";\n      __fern_profile_write(__raw_data(units), units.len() as usize);\n    }\n    let nl: string = \"\\n\";\n    __fern_profile_write(__raw_data(nl), 1);\n    let i: usize = 0;\n    while (i < count) {\n      let row: usize = base + 160 + i * 528;\n      let depth: usize = __load_i64(row) as usize;\n      let k: usize = depth;\