    "function __fern_profile_start(base: usize, hi: usize, act: usize, timer: usize): void {\n  __raw_store_ptr(base + 128, 0, __syscall3(20, 0, 0, 0) as usize);\n  __raw_store_ptr(base + 16, 0, hi);\n  __raw_store_ptr(base + 24, 0, 1);\n  __raw_store_ptr(base + 136, 0, __FERN_PROFILE_MODE);\n  if (__FERN_PROFILE_MODE != 1 && __FERN_PROFILE_MODE != 3) {\n    return;\n  }\n  let a: i64 = __syscall4(46, 27, act as i64, 0, 8);\n  let b: i64 = 0 - 1;\n  if (a >= 0 as i64) {\n    __raw_store_ptr(base + 48, 0, 67108864);\n    let unblocked: i64 = __syscall4(48, 2, (base + 48) as i64, 0, 8);\n    if (unblocked < 0 as i64) {\n      b = unblocked;\n    } else {\n      b = __syscall3(83, 2, timer as i64, 0);\n    }\n  }\n  if (a < 0 as i64 || b < 0 as i64) {\n    __raw_store_ptr(base + 24, 0, 0);\n    __raw_store_ptr(base + 32, 0, 2);\n    let msg: string = \"fern profile: cannot install CPU sampler\\n\";\n    __fern_profile_write(__raw_data(msg), msg.len() as usize);\n    __syscall3(1, 2, 0, 0);\n  }\n}\n",
    "function __fern_profile_write_fd(fd: i64, p: usize, n: usize): void {\n  while (n > 0) {\n    let w: i64 = __syscall3(4, fd, p as i64, n as i64);\n    if (w == (0 - 4) as i64) {\n      continue;\n    }\n    if (w <= 0 as i64) {\n      return;\n    }\n    p = p + w as usize;\n    n = n - w as usize;\n  }\n}\n",
    "function __fern_putchar(c: i32): i32 {\n  let p: usize = __raw_scratch(1);\n  __raw_store8(p, 0, c & 255);\n  return __syscall3(4, 1, p as i64, 1) as i32;\n}\n",
    "function __fern_random_bytes(n: i32): i32[] {\n  if (n <= 0) {\n    let none: usize = __raw_arr_box(0);\n    return __raw_array(none);\n  }\n  let p: usize = __raw_alloc(n);\n  let off: i32 = 0;\n  while (off < n) {\n    let want: i32 = n - off;\n    if (want > 256) {\n      want = 256;\n    }\n    let r: i32 = __syscall3(500, (p + off) as i64, want as i64, 0) as i32;\n    if (r == 0 - 4) {\n      continue;\n    }\n    if (r != 0) {\n      __fern_rc_dec(p);\n      let msg: string = \"fern: entropy unavailable\\n\";\n      __syscall3(4, 2, __raw_data(msg) as i64, msg.len() as i64);\n      exit(134);\n    }\n    off = off + want;\n  }\n  let b: usize = __raw_arr_box(n);\n  let i: i32 = 0;\n  while (i < n) {\n    __raw_store_ptr(b, i + 1, __raw_load8(p, i) as usize);\n    i = i + 1;\n  }\n  let p_own: string = __raw_string(p, n);\n  return __raw_array(b);\n}\n",
    "function __fern_random_bytes_u8(n: i32): i32[] {\n  if (n < 0) {\n    n = 0;\n  }\n  let b: usize = __raw_arr_box(((n as i64 + 7) / 8) as i32);\n  __store_i64(b, n as i64);\n  let off: i32 = 0;\n  while (off < n) {\n    let want: i32 = n - off;\n    if (want > 256) {\n      want = 256;\n    }\n    let r: i32 = __syscall3(500, (b + 8 + off) as i64, want as i64, 0) as i32;\n    if (r == 0 - 4) {\n      continue;\n    }\n    if (r != 0) {\n      __fern_rc_dec(b);\n      let msg: string = \"fern: entropy unavailable\\n\";\n      __syscall3(4, 2, __raw_data(msg) as i64, msg.len() as i64);\n      exit(134);\n    }\n    off = off + want;\n  }\n  return __raw_array(b);\n}\n",
    "function __fern_random_i32(): i32 {\n  let p: usize = __raw_scratch(4);\n  let off: i32 = 0;\n  while (off < 4) {\n    let want: i32 = 4 - off;\n    if (want > 256) {\n      want = 256;\n    }\n    let r: i32 = __syscall3(500, (p + off) as i64, want as i64, 0) as i32;\n    if (r == 0 - 4) {\n      continue;\n    }\n    if (r != 0) {\n      let msg: string = \"fern: entropy unavailable\\n\";\n      __syscall3(4, 2, __raw_data(msg) as i64, msg.len() as i64);\n      exit(134);\n    }\n    off = off + want;\n  }\n  return __load_i32(p);\n}\n",
    "function __fern_reactor_ctl(r_fd: i32, op: i32, fd: i32, arg: i32): i32 {\n  if (op == 3) {\n    return __syscall3(6, r_fd as i64, 0, 0) as i32;\n  }\n  if (op == 4) {\n    let act: usize = __raw_scratch(32);\n    let z: i32 = 0;\n    while (z < 32) {\n      __raw_store8(act, z, 0);\n      z = z + 1;\n    }\n    __raw_store8(act, 0, 1);\n    __syscall4(46, fd as i64, act as i64, 0, 8);\n    let ch: usize = __raw_scratch(32);\n    let sig_fd: i32 = fd;\n    let sig_filter: i32 = 0 - 6;\n    let sig_flags: i32 = 5;\n    __raw_store_ptr(ch, 0, sig_fd as usize);\n    __raw_store8(ch, 8, sig_filter & 255);\n    __raw_store8(ch, 9, sig_filter >> 8 & 255);\n    __raw_store8(ch, 10, sig_flags);\n    __raw_store8(ch, 11, 0);\n    __raw_store_ptr(ch, 2, 0);\n    __raw_store_ptr(ch, 3, 0);\n    __raw_store8(ch, 12, 0);\n    __raw_store8(ch, 13, 0);\n    __raw_store8(ch, 14, 0);\n    __raw_store8(ch, 15, 0);\n    return __syscall6(363, r_fd as i64, ch as i64, 1, 0, 0, 0) as i32;\n  }\n  if (op == 5) {\n    let ch2: usize = __raw_scratch(32);\n    let del_fd: i32 = fd;\n    let del_filter: i32 = 0 - 6;\n    let del_flags: i32 = 2;\n    __raw_store_ptr(ch2, 0, del_fd as usize);\n    __raw_store8(ch2, 8, del_filter & 255);\n    __raw_store8(ch2, 9, del_filter >> 8 & 255);\n    __raw_store8(ch2, 10, del_flags);\n    __raw_store8(ch2, 11, 0);\n    __raw_store_ptr(ch2, 2, 0);\n    __raw_store_ptr(ch2, 3, 0);\n    __raw_store8(ch2, 12, 0);\n    __raw_store8(ch2, 13, 0);\n    __raw_store8(ch2, 14, 0);\n    __raw_store8(ch2, 15, 0);\n    __syscall6(363, r_fd as i64, ch2 as i64, 1, 0, 0, 0);\n    let act2: usize = __raw_scratch(32);\n    let z2: i32 = 0;\n    while (z2 < 32) {\n      __raw_store8(act2, z2, 0);\n      z2 = z2 + 1;\n    }\n    return __syscall4(46, fd as i64, act2 as i64, 0, 8) as i32;\n  }\n  if (op == 6) {\n    let ppid: i32 = __syscall3(39, 0, 0, 0) as i32;\n    if (ppid == 1) {\n      return 0 - 3;\n    }\n    let pch: usize = __raw_scratch(32);\n    let proc_filt