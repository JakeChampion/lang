    "function __fern_arr_str_join(xs: string[], sep: string): string {\n  let n: i32 = xs.len();\n  if (n == 0) {\n    return \"\";\n  }\n  let ls: i32 = sep.len();\n  let total: i32 = ls * (n - 1);\n  let i: i32 = 0;\n  while (i < n) {\n    total = total + xs[i].len();\n    i = i + 1;\n  }\n  let p: usize = __raw_alloc(total);\n  let off: i32 = 0;\n  let j: i32 = 0;\n  while (j < n) {\n    if (j > 0) {\n      __memcpy(p + off, __raw_data(sep), ls);\n      off = off + ls;\n    }\n    let e: string = xs[j];\n    let le: i32 = e.len();\n    __memcpy(p + off, __raw_data(e), le);\n    off = off + le;\n    j = j + 1;\n  }\n  return __raw_string(p, total);\n}\n",
    "function __fern_buf_take_text(h: usize): string {\n  let wide: i64 = __load_i64(h + 8);\n  if (wide < 0 as i64 || wide > 2147483647 as i64) {\n    let failed: usize = __raw_alloc(0 - 1);\n    return __raw_string(failed, 0);\n  }\n  let n: i32 = wide as i32;\n  if (n == 0) {\n    return \"\";\n  }\n  let data: usize = __raw_load_ptr(h, 0);\n  let total: i64 = wide;\n  let i: i32 = 0;\n  let changed: boolean = false;\n  let mask: u64 = 9259542123273814144 as u64;\n  while (i < n) {\n    if (n - i >= 8) {\n      if ((__load_i64(data + i) as u64 & mask) == 0 as u64) {\n        i = i + 8;\n        continue;\n      }\n    }\n    let part: i32 = __fern_buf_text_part(data, i, n);\n    if (part < 0) {\n      total = total + (3 + part) as i64;\n      changed = true;\n      i = i - part;\n    } else {\n      i = i + part;\n    }\n  }\n  if (total > 2147483647 as i64) {\n    let failed: usize = __raw_alloc(0 - 1);\n    return __raw_string(failed, 0);\n  }\n  let length: i32 = total as i32;\n  let out: usize = __raw_alloc(length);\n  if (!changed) {\n    __memcpy(out, data, n);\n  } else {\n    i = 0;\n    let start: i32 = 0;\n    let written: i32 = 0;\n    while (i < n) {\n      if (n - i >= 8) {\n        if ((__load_i64(data + i) as u64 & mask) == 0 as u64) {\n          i = i + 8;\n          continue;\n        }\n      }\n      let part: i32 = __fern_buf_text_part(data, i, n);\n      if (part < 0) {\n        __memcpy(out + written, data + start, i - start);\n        written = written + (i - start);\n        __raw_store8(out, written, 239);\n        __raw_store8(out, written + 1, 191);\n        __raw_store8(out, written + 2, 189);\n        written = written + 3;\n        i = i - part;\n        start = i;\n      } else {\n        i = i + part;\n      }\n    }\n    __memcpy(out + written, data + start, n - start);\n  }\n  __store_i64(h + 8, 0 as i64);\n  return __raw_string(out, length);\n}\n",
