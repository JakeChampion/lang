    "function __fern_chdir(path: string): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let rc: i32 = __syscall3(12, pathz as i64, 0, 0) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(());\n}\n",
    "function __fern_chmod(path: string, mode: i32): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let rc: i32 = __syscall4(467, -2, pathz as i64, (mode & 4095) as i64, 0) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(());\n}\n",
    "function __fern_chmod_at(path: string, mode: i32, follow: boolean): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let fl: i32 = 32;\n  if (follow) {\n    fl = 0;\n  }\n  let cr: i64 = __syscall4(467, -(2 as i64), pathz as i64, (mode & 4095) as i64, fl as i64);\n  let rc: i32 = cr as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(());\n}\n",
    "function __fern_chown_at(path: string, uid: i32, gid: i32, follow: boolean): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let fl: i32 = 32;\n  if (follow) {\n    fl = 0;\n  }\n  let rc: i32 = __syscall5(468, -(2 as i64), pathz as i64, uid as i64, gid as i64, fl as i64) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(());\n}\n",
    "function __fern_chroot(path: string): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let rc: i32 = __syscall3(61, pathz as i64, 0, 0) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(());\n}\n",
