    "function __fern_clone_file(src: string, dest: string): Result[void, IoError] {\n  let slen: i32 = src.len();\n  let srcz: usize = __raw_alloc(slen + 1);\n  let j: i32 = 0;\n  while (j < slen) {\n    __raw_store8(srcz, j, src[j] as i32);\n    j = j + 1;\n  }\n  __raw_store8(srcz, slen, 0);\n  let dlen: i32 = dest.len();\n  let destz: usize = __raw_alloc(dlen + 1);\n  let i: i32 = 0;\n  while (i < dlen) {\n    __raw_store8(destz, i, dest[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(destz, dlen, 0);\n  let srcz_own: string = __raw_string(srcz, slen + 1);\n  let destz_own: string = __raw_string(destz, dlen + 1);\n  let sfd: i32 = __syscall4(463, -2, srcz as i64, 0, 0) as i32;\n  if (sfd < 0) {\n    return Err(__fern_io_error(0 - sfd, __fern_path_copy(srcz_own, slen)));\n  }\n  let rc: i32 = __syscall4(517, sfd as i64, -2, destz as i64, 3) as i32;\n  __syscall3(6, sfd as i64, 0, 0);\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, __fern_path_copy(destz_own, dlen)));\n  }\n  return Ok(());\n}\n",
