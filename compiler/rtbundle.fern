    "function __fern_tcp_socket_ctl(fd: i32, op: i32, arg: i32): i32 {\n  if (op == 7) {\n    let ty: usize = __raw_scratch(8);\n    __raw_store8(ty, 0, 0);\n    __raw_store8(ty, 1, 0);\n    __raw_store8(ty, 2, 0);\n    __raw_store8(ty, 3, 0);\n    __raw_store8(ty, 4, 4);\n    __raw_store8(ty, 5, 0);\n    __raw_store8(ty, 6, 0);\n    __raw_store8(ty, 7, 0);\n    if (__syscall5(118, fd as i64, 65535, 4104, ty as i64, (ty + 4) as i64) >= 0 && __raw_load8(ty, 0) == 2) {\n      return 0;\n    }\n    let sa: usize = __raw_scratch(32);\n    let z: i32 = 0;\n    while (z < 32) {\n      __raw_store8(sa, z, 0);\n      z = z + 1;\n    }\n    __raw_store8(sa, 28, 28);\n    if (__syscall3(31, fd as i64, sa as i64, (sa + 28) as i64) < 0) {\n      return 0;\n    }\n    let fam: i32 = __raw_load8(sa, 1);\n    if (fam == 2) {\n      return __raw_load8(sa, 4) | __raw_load8(sa, 4 + 1) << 8 | __raw_load8(sa, 4 + 2) << 16 | __raw_load8(sa, 4 + 3) << 24;\n    }\n    if (fam != 30) {\n      return 0;\n    }\n    if ((__raw_load8(sa, 8) | __raw_load8(sa, 8 + 1) << 8 | __raw_load8(sa, 8 + 2) << 16 | __raw_load8(sa, 8 + 3) << 24) == 0 && (__raw_load8(sa, 12) | __raw_load8(sa, 12 + 1) << 8 | __raw_load8(sa, 12 + 2) << 16 | __raw_load8(sa, 12 + 3) << 24) == 0 && __raw_load8(sa, 16) == 0 && __raw_load8(sa, 17) == 0 && __raw_load8(sa, 18) == 255 && __raw_load8(sa, 19) == 255) {\n      return __raw_load8(sa, 20) | __raw_load8(sa, 20 + 1) << 8 | __raw_load8(sa, 20 + 2) << 16 | __raw_load8(sa, 20 + 3) << 24;\n    }\n    let key: i32 = (__raw_load8(sa, 8) | __raw_load8(sa, 8 + 1) << 8 | __raw_load8(sa, 8 + 2) << 16 | __raw_load8(sa, 8 + 3) << 24) ^ (__raw_load8(sa, 12) | __raw_load8(sa, 12 + 1) << 8 | __raw_load8(sa, 12 + 2) << 16 | __raw_load8(sa, 12 + 3) << 24);\n    if (key == 0) {\n      return 1;\n    }\n    return key;\n  }\n  if (op == 8) {\n    return 0 - 45;\n  }\n  if (op == 9) {\n    if (arg < 0 || arg > 9) {\n      return 0 - 22;\n    }\n    let sa: usize = __raw_scratch(32);\n    let z