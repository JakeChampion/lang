    "function __fern_profile_sample(pc: usize, fp: usize, sp: usize, base: usize, weight: usize): i32 {\n  if (__load_i64(base + 24) == 0 as i64) {\n    return 0;\n  }\n  let n: usize = __load_i64(base) as usize;\n  let seen: usize = __load_i64(base + 152) as usize + 1;\n  __raw_store_ptr(base + 152, 0, seen);\n  let slot: usize = n;\n  let replaced: i32 = 0;\n  if (n >= 8192) {\n    // Algorithm R reservoir selection. SplitMix64 mixes the event ordinal;\n    // storage remains bounded while late execution can replace earlier stacks.\n    let x: usize = seen + 11400714819323198485u64 as usize;\n    x = (x ^ x >> 30) * (13787848793156543929u64 as usize);\n    x = (x ^ x >> 27) * (10723151780598845931u64 as usize);\n    x = x ^ x >> 31;\n    slot = x % seen;\n    if (slot >= 8192) {\n      return 1;\n    }\n    replaced = 1;\n  }\n  let row: usize = base + 160 + slot * 528;\n  __raw_store_ptr(row + 8, 0, weight);\n  __raw_store_ptr(row + 16, 0, pc & 281474976710655u64 as usize);\n  let depth: usize = 1;\n  let hi: usize = __load_i64(base + 16) as usize;\n  while (depth < 64 && fp >= sp && fp <= hi && (fp & 7) == 0) {\n    // The static native image lies below 2^48; PAC/top-byte tags are not code-address bits.\n    let ret: usize = __load_i64(fp + 8) as usize & 281474976710655u64 as usize;\n    if (ret < 65536) {\n      break;\n    }\n    __raw_store_ptr(row + 16 + depth * 8, 0, ret - 1);\n    depth = depth + 1;\n    let next: usize = __load_i64(fp) as usize;\n    if (next <= fp) {\n      break;\n    }\n    fp = next;\n  }\n  __raw_store_ptr(row, 0, depth);\n  if (replaced == 0) {\n    __raw_store_ptr(base, 0, n + 1);\n  }\n  return replaced;\n}\n",
    "function __fern_profile_symbol(pc: usize, im: usize, size: usize): usize {\n  let name: usize = __fern_profile_name(pc, im, size);\n  if (name == 0) {\n    return 0;\n  }\n  let q: usize = name;\n  while (__load_u8(q) != 0) {\n    q = q + 1;\n  }\n  __fern_profile_write(name, q - name);\n  return 1;\n}\n",
