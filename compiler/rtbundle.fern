    "function __fern_arr_concat(pa: usize, src: usize, nb: i32, width: i32): i32[] {\n  let na: i32 = __load_i32(pa);\n  let m: i32 = na + nb;\n  let want: i32 = m;\n  if (__fern_rc_is_unique(pa) != 0) {\n    if (nb == 0) {\n      return __raw_array(pa);\n    }\n    let capw: i32 = __load_i32(pa - 16);\n    let need: i32 = m;\n    if (width == 8) {\n      need = (m + 7) / 8;\n    }\n    if (need <= capw) {\n      if (width == 8) {\n        __memcpy(pa + 8 + na, src, nb);\n      } else {\n        let dst: usize = pa + 8 + na * 8;\n        let from: usize = src;\n        let left: i32 = nb;\n        while (left > 0) {\n          let cc: i32 = left;\n          if (cc > 134217728) {\n            cc = 134217728;\n          }\n          __memcpy(dst, from, cc * 8);\n          dst = dst + cc * 8;\n          from = from + cc * 8;\n          left = left - cc;\n        }\n      }\n      __store_i64(pa, m as i64);\n      return __raw_array(pa);\n    }\n    if (na <= 536870912 && na * 2 > want) {\n      want = na * 2;\n    }\n  }\n  if (width == 8) {\n    let p: usize = __raw_arr_box((want + 7) / 8);\n    __store_i64(p, m as i64);\n    __memcpy(p + 8, pa + 8, na);\n    __memcpy(p + 8 + na, src, nb);\n    return __raw_array(p);\n  }\n  let q: usize = __raw_arr_box(want);\n  __store_i64(q, m as i64);\n  let dst2: usize = q + 8;\n  let src2: usize = pa + 8;\n  let left2: i32 = na;\n  let part: i32 = 0;\n  while (part < 2) {\n    while (left2 > 0) {\n      let cc2: i32 = left2;\n      if (cc2 > 134217728) {\n        cc2 = 134217728;\n      }\n      __memcpy(dst2, src2, cc2 * 8);\n      dst2 = dst2 + cc2 * 8;\n      src2 = src2 + cc2 * 8;\n      left2 = left2 - cc2;\n    }\n    src2 = src;\n    left2 = nb;\n    part = part + 1;\n  }\n  return __raw_array(q);\n}\n",
    "function __fern_arr_slice(a: i32[], start: i32, end: i32): i32[] {\n  let n: i32 = a.len();\n  let bad: i32 = 0;\n  if (end < 0) {\n    bad = 1;\n  }\n  if (end > n) {\n    bad = 1;\n  }\n  if (start < 0) {\n    bad = 1;\n  }\n  if (start > end) {\n    bad = 1;\n  }\n  if (bad == 1) {\n    __fern_slice_abort();\n  }\n  let m: i32 = end - start;\n  let p: usize = __raw_arr_box(m);\n  let dst: usize = p + 8;\n  let src: usize = __raw_arr_ptr(a) + 8;\n  let skip: i32 = start;\n  while (skip > 0) {\n    let cs: i32 = skip;\n    if (cs > 134217728) {\n      cs = 134217728;\n    }\n    src = src + cs * 8;\n    skip = skip - cs;\n  }\n  let left: i32 = m;\n  while (left > 0) {\n    let cc: i32 = left;\n    if (cc > 134217728) {\n      cc = 134217728;\n    }\n    __memcpy(dst, src, cc * 8);\n    dst = dst + cc * 8;\n    src = src + cc * 8;\n    left = left - cc;\n  }\n  return __raw_array(p);\n}\n",
