    "function __fern_ring_wait(ring: i64, events: i32[], timeout_ms: i32): i32 {\n  let cap: i32 = events.len() / 2;\n  if (cap <= 0 || ring < 0 as i64) {\n    return 0 - 22;\n  }\n  let blk: usize = ring as usize;\n  let nfds: i32 = __load_i32(blk + 68);\n  let pend: usize = blk + 4096;\n  let np: i32 = __load_i32(blk + 72);\n  __store_i32(blk + 72, 0);\n  let k: i32 = 0;\n  while (k < np) {\n    let pfd: i32 = __load_i32(pend + k as usize * 4);\n    let pent: usize = __fern_ring_entry(blk, pfd);\n    if (__raw_load8(pent, 0) != 0 && __raw_load8(pent, 1) == 0) {\n      let armed: i32 = __fern_ring_arm(blk, pent, pfd);\n      if (armed < 0) {\n        return armed;\n      }\n    }\n    if (__raw_load8(pent, 0) != 0 && (__raw_load8(pent, 4) == 2 || __raw_load8(pent, 4) == 5)) {\n      let resumed: i32 = __fern_ring_resume(blk, pent, pfd);\n      if (resumed < 0) {\n        return resumed;\n      }\n      if (__raw_load8(pent, 4) != 1 && __raw_load8(pent, 6) == 0) {\n        __fern_ring_pend(blk, pfd);\n      }\n    }\n    k = k + 1;\n  }\n  let min: i64 = 1 as i64;\n  // Consumed receive buffers can leave stale descriptors in the ready list.\n  if (timeout_ms == 0 || __fern_ring_has_ready(blk)) {\n    min = 0 as i64;\n  }\n  let ts: usize = blk + 120;\n  let arg: usize = blk + 136;\n  __store_i64(arg, 0);\n  __store_i64(arg + 8, 0);\n  __store_i64(arg + 16, 0);\n  if (timeout_ms > 0 && min != 0 as i64) {\n    __store_i64(ts, (timeout_ms / 1000) as i64);\n    __store_i64(ts + 8, (timeout_ms % 1000) as i64 * (1000000 as i64));\n    __store_i64(arg + 16, ts as i64);\n  }\n  let queued: i32 = __fern_ring_queued(blk);\n  let r: i32 = __syscall6(426, __load_i32(blk) as i64, queued as i64, min, 9, arg as i64, 24) as i32;\n  __fern_ring_reap(blk, nfds);\n  let n: i32 = __fern_ring_emit(blk, __raw_arr_ptr(events), cap);\n  if (n == 0 && r < 0 && r != 0 - 62) {\n    return r;\n  }\n  return n;\n}\n",
    "function __fern_ring_watch(blk: usize, fd: i32, interest: i32, sig: i32): i32 {\n  if (fd < 0 || fd >= __load_i32(blk + 68)) {\n    return 0 - 9;\n  }\n  let ent: usize = __fern_ring_entry(blk, fd);\n  let old: i32 = __raw_load8(ent, 0);\n  if ((old & 4) != 0 && (interest & 4) == 0) {\n    let del: i32 = __fern_ring_set_ctl(blk, 2, fd, 0);\n    __raw_store8(ent, 0, 0);\n    if (interest == 0) {\n      return del;\n    }\n  }\n  if ((interest & 4) != 0) {\n    if ((old & 4) == 0) {\n      let un3: i32 = __fern_ring_unarm(blk, ent, fd);\n      if (un3 < 0) {\n        return un3;\n      }\n    }\n    let r: i32 = __fern_ring_set_ctl(blk, 1, fd, interest);\n    if (r < 0) {\n      return r;\n    }\n    __raw_store8(ent, 0, interest);\n    __raw_store8(ent, 3, 0);\n    return 0;\n  }\n  if (interest == 0) {\n    let un: i32 = __fern_ring_unarm(blk, ent, fd);\n    let st: i32 = __fern_ring_recv_stop(blk, ent, fd);\n    __fern_ring_drop(blk, ent);\n    __raw_store8(ent, 0, 0);\n    __raw_store8(ent, 3, 0);\n    __raw_store8(ent, 13, 0);\n    if (un < 0) {\n      return un;\n    }\n    return st;\n  }\n  let rmode: i32 = 0;\n  if ((interest & 8) != 0 && (interest & 1) != 0 && sig == 0 && __load_i64(blk + 160) != 0 as i64 && __raw_load8(ent, 6) != 3) {\n    rmode = 1;\n  }\n  if (rmode == 0 && __raw_load8(ent, 4) != 0) {\n    let stopped: i32 = __fern_ring_recv_stop(blk, ent, fd);\n    if (stopped < 0) {\n      return stopped;\n    }\n  }\n  let pm: i32 = 0;\n  if ((interest & 1) != 0 && (rmode == 0 || __raw_load8(ent, 4) == 5)) {\n    pm = pm | 1;\n  }\n  if ((interest & 2) != 0) {\n    pm = pm | 4;\n  }\n  if (__raw_load8(ent, 13) != pm || pm != 0 && __raw_load8(ent, 1) == 0) {\n    let un2: i32 = __fern_ring_unarm(blk, ent, fd);\n    if (un2 < 0) {\n      return un2;\n    }\n    __raw_store8(ent, 13, pm);\n    let armed: i32 = __fern_ring_arm(blk, ent, fd);\n    if (armed < 0) {\n      return armed;\n    }\n  }\n  __raw_store8(ent, 0, interest);\n  __raw_store8(ent, 