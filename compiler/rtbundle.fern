    "function __fern_env(name: string): Option[string] {\n  let nlen: i32 = name.len();\n  let first: i32 = 61;\n  let k0: i32 = 0;\n  if (nlen > 0) {\n    first = name[0] as i32;\n    k0 = 1;\n  }\n  let envp: usize = __raw_environ();\n  let idx: i32 = 0;\n  let entry: usize = __raw_load_ptr(envp, 0);\n  while (entry != 0) {\n    if (__raw_load8(entry, 0) == first) {\n      let k: i32 = k0;\n      while (k < nlen && __raw_load8(entry, k) == name[k] as i32) {\n        k = k + 1;\n      }\n      if (k == nlen && __raw_load8(entry, nlen) == 61) {\n        let vs: i32 = nlen + 1;\n        let vlen: i32 = 0;\n        while (__raw_load8(entry, vs + vlen) != 0) {\n          vlen = vlen + 1;\n        }\n        if (vlen == 0) {\n          return Some(\"\");\n        }\n        let vbuf: usize = __raw_alloc(vlen);\n        let c: i32 = 0;\n        while (c < vlen) {\n          __raw_store8(vbuf, c, __raw_load8(entry, vs + c));\n          c = c + 1;\n        }\n        return Some(__raw_string(vbuf, vlen));\n      }\n    }\n    idx = idx + 1;\n    entry = __raw_load_ptr(envp, idx);\n  }\n  return None;\n}\n",
    "function __fern_environ(): string[] {\n  let out: string[] = [];\n  let envp: usize = __raw_environ();\n  let idx: i32 = 0;\n  let done: i32 = 0;\n  while (done == 0) {\n    let entry: usize = __raw_load_ptr(envp, idx);\n    if (entry == 0) {\n      done = 1;\n    } else {\n      let n: i32 = 0;\n      while (__raw_load8(entry, n) != 0) {\n        n = n + 1;\n      }\n      let e: string = \"\";\n      if (n > 0) {\n        let b: usize = __raw_alloc(n);\n        __memcpy(b, entry, n);\n        e = __raw_string(b, n);\n      }\n      out = out.append(e);\n      idx = idx + 1;\n    }\n  }\n  return out;\n}\n",
    "function __fern_i32_to_string(n: i32): string {\n  let neg: i32 = 0;\n  let m: i32 = n;\n  if (n < 0) {\n    neg = 1;\n    m = 0 - n;\n  }\n  let v: u32 = m as u32;\n  if (v == 0 as u32) {\n    let z: usize = __raw_alloc(1);\n    __raw_store8(z, 0, 48);\n    return __raw_string(z, 1);\n  }\n  let nd: i32 = 0;\n  let t: u32 = v;\n  while (t != 0 as u32) {\n    nd = nd + 1;\n    t = t / (10 as u32);\n  }\n  let total: i32 = nd + neg;\n  let p: usize = __raw_alloc(total);\n  if (neg == 1) {\n    __raw_store8(p, 0, 45);\n  }\n  let i: i32 = total - 1;\n  while (v != 0 as u32) {\n    __raw_store8(p, i, 48 + (v % (10 as u32)) as i32);\n    v = v / (10 as u32);\n    i = i - 1;\n  }\n  return __raw_string(p, total);\n}\n",
    "function __fern_i64_to_string(n: i64): string {\n  let neg: i32 = 0;\n  let m: i64 = n;\n  if (n < 0 as i64) {\n    neg = 1;\n    m = 0 as i64 - n;\n  }\n  let v: u64 = m as u64;\n  if (v == 0 as u64) {\n    let z: usize = __raw_alloc(1);\n    __raw_store8(z, 0, 48);\n    return __raw_string(z, 1);\n  }\n  let nd: i32 = 0;\n  let t: u64 = v;\n  while (t != 0 as u64) {\n    nd = nd + 1;\n    t = t / (10 as u64);\n  }\n  let total: i32 = nd + neg;\n  let p: usize = __raw_alloc(total);\n  if (neg == 1) {\n    __raw_store8(p, 0, 45);\n  }\n  let i: i32 = total - 1;\n  while (v != 0 as u64) {\n    __raw_store8(p, i, 48 + (v % (10 as u64)) as i32);\n    v = v / (10 as u64);\n    i = i - 1;\n  }\n  return __raw_string(p, total);\n}\n",
    "function __fern_path_copy(z: string, n: i32): string {\n  if (n == 0) {\n    return \"\";\n  }\n  let b: usize = __raw_alloc(n);\n  let i: i32 = 0;\n  while (i < n) {\n    __raw_store8(b, i, z[i] as i32);\n    i = i + 1;\n  }\n  return __raw_string(b, n);\n}\n",
    "function __fern_pp_byte(out: usize, b: i32): void {\n  let n: usize = __load_i64(out) as usize;\n  __raw_store8(out + 16, n as i32, b);\n  __raw_store_ptr(out, 0, n + 1);\n  if (n + 1 == 4096) {\n    __fern_pp_flush(out);\n  }\n}\n",
    "function __fern_pp_copy(buf: usize, at: usize, src: usize, n: usize): usize {\n  let i: usize = 0;\n  while (i < n) {\n    __raw_store8(buf + at + i, 0, __load_u8(src + i));\n    i = i + 1;\n  }\n  return at + n;\n}\n",
    "function __fern_pp_decimal(buf: usize, at: usize, n: usize): usize {\n  let k: usize = at + 31;\n  let end: usize = k + 1;\n  while (true) {\n    __raw_store8(buf + k, 0, (n % 10 + 48) as i32);\n    n = n / 10;\n    if (n == 0) {\n      break;\n    }\n    k = k - 1;\n  }\n  return __fern_pp_copy(buf, at, buf + k, end - k);\n}\n",
    "function __fern_pp_field(buf: usize, at: usize, tag: usize, n: usize): usize {\n  at = __fern_pp_uint_at(buf, at, tag);\n  return __fern_pp_uint_at(buf, at, n);\n}\n",
    "function __fern_pp_flush(out: usize): void {\n  let n: usize = __load_i64(out) as usize;\n  if (n > 0) {\n    __fern_profile_write_fd(__load_i64(out + 8), out + 16, n);\n    __raw_store_ptr(out, 0, 0);\n  }\n}\n",
