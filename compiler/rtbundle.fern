    "function __fern_ring_zc_at(blk: usize): usize {\n  return __fern_ring_ready_at(blk) + __load_i32(blk + 68) as usize * 4;\n}\n",
    "function __fern_ring_zc_done(blk: usize, s: i32, res: i32, flags: i32, nfds: i32): i32 {\n  let z: usize = __fern_ring_zc_at(blk) + s as usize * 16;\n  if (__load_i32(z + 8) == 0) {\n    return 0;\n  }\n  if ((flags & 8) != 0) {\n    __store_i32(z + 8, 3);\n    return 0;\n  }\n  __store_i32(z + 4, res);\n  if (res == 0 - 95 || res == 0 - 22) {\n    __store_i32(blk + 200, 1);\n  }\n  if ((flags & 2) != 0) {\n    __store_i32(z + 8, 2);\n  } else {\n    __store_i32(z + 8, 3);\n  }\n  let fd: i32 = __load_i32(z);\n  if (fd >= 0 && fd < nfds) {\n    let ent: usize = __fern_ring_entry(blk, fd);\n    if (__raw_load8(ent, 0) != 0) {\n      __raw_store8(ent, 14, __raw_load8(ent, 14) | 10);\n      __fern_ring_list(blk, ent, fd);\n    }\n  }\n  return 0;\n}\n",
