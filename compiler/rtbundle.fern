    "function __fern_pp_location(out: usize, buf: usize, id: usize, pc: usize): void {\n  let line: usize = buf + 512;\n  let len: usize = __fern_pp_field(line, 0, 8, id);\n  let n: usize = __fern_pp_field(buf, 0, 8, id);\n  n = __fern_pp_field(buf, n, 24, pc);\n  n = __fern_pp_field(buf, n, 34, len);\n  n = __fern_pp_copy(buf, n, line, len);\n  __fern_pp_message(out, 34, buf, n);\n}\n",
    "function __fern_pp_message(out: usize, tag: usize, buf: usize, n: usize): void {\n  __fern_pp_uint(out, tag);\n  __fern_pp_uint(out, n);\n  let i: usize = 0;\n  while (i < n) {\n    __fern_pp_byte(out, __load_u8(buf + i));\n    i = i + 1;\n  }\n}\n",
    "function __fern_pp_names(base: usize, out: usize, buf: usize, im: usize, size: usize): void {\n  let count: usize = __load_i64(base) as usize;\n  let i: usize = 0;\n  while (i < count) {\n    let row: usize = base + 160 + i * 528;\n    let depth: usize = __load_i64(row) as usize;\n    let k: usize = 0;\n    while (k < depth) {\n      let pc: usize = __load_i64(row + 16 + k * 8) as usize;\n      let name: usize = __fern_profile_name(pc, im, size);\n      if (name == 0) {\n        __fern_profile_hex_buf(buf, pc);\n        __fern_pp_message(out, 50, buf, 18);\n      } else {\n        let q: usize = name;\n        while (__load_u8(q) != 0) {\n          q = q + 1;\n        }\n        __fern_pp_message(out, 50, name, q - name);\n      }\n      k = k + 1;\n    }\n    i = i + 1;\n  }\n}\n",
    "function __fern_pp_sample(base: usize, out: usize, buf: usize, i: usize): void {\n  let row: usize = base + 160 + i * 528;\n  let depth: usize = __load_i64(row) as usize;\n  let locs: usize = buf + 512;\n  let loclen: usize = 0;\n  let k: usize = 0;\n  while (k < depth) {\n    loclen = __fern_pp_uint_at(locs, loclen, i * 64 + k + 1);\n    k = k + 1;\n  }\n  let count: usize = __load_i64(base) as usize;\n  let seen: usize = __load_i64(base + 152) as usize;\n  let units: usize = seen;\n  let weight: usize = 10000000 * seen / count;\n  if (__FERN_PROFILE_MODE == 4) {\n    units = 64 * seen;\n    weight = __load_i64(row + 8) as usize * seen / count;\n  }\n  // Preserve the represented event total when integer sample values round.\n  let objects: usize = units / count;\n  if (i < units % count) {\n    objects = objects + 1;\n  }\n  let vals: usize = buf + 768;\n  let vallen: usize = __fern_pp_uint_at(vals, 0, objects);\n  vallen = __fern_pp_uint_at(vals, vallen, weight);\n  let n: usize = __fern_pp_field(buf, 0, 10, loclen);\n  n = __fern_pp_copy(buf, n, locs, loclen);\n  n = __fern_pp_field(buf, n, 18, vallen);\n  n = __fern_pp_copy(buf, n, vals, vallen);\n  __fern_pp_message(out, 18, buf, n);\n}\n",
