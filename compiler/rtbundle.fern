    "function __fern_temp_dir(prefix: string): Result[string, IoError] {\n  let plen: i32 = prefix.len();\n  let si: i32 = 0;\n  while (si < plen) {\n    if (prefix[si] == 47) {\n      return Err(__fern_io_error(22, __fern_path_copy(prefix, plen)));\n    }\n    si = si + 1;\n  }\n  let total: i32 = 5 + plen + 1 + 16;\n  let tries: i32 = 0;\n  while (tries < 64) {\n    let rnd: u8[] = random_bytes(8);\n    let buf: usize = __raw_alloc(total + 1);\n    __raw_store8(buf, 0, 47);\n    __raw_store8(buf, 1, 116);\n    __raw_store8(buf, 2, 109);\n    __raw_store8(buf, 3, 112);\n    __raw_store8(buf, 4, 47);\n    let i: i32 = 0;\n    while (i < plen) {\n      __raw_store8(buf, 5 + i, prefix[i] as i32);\n      i = i + 1;\n    }\n    __raw_store8(buf, 5 + plen, 45);\n    let k: i32 = 0;\n    while (k < 8) {\n      let v: i32 = rnd[k] as i32;\n      __raw_store8(buf, 6 + plen + 2 * k, __fern_hex_digit(v >> 4));\n      __raw_store8(buf, 7 + plen + 2 * k, __fern_hex_digit(v & 15));\n      k = k + 1;\n    }\n    __raw_store8(buf, total, 0);\n    let rc: i32 = __syscall3(475, -2, buf as i64, 448) as i32;\n    let buf_own: string = __raw_string(buf, total + 1);\n    if (rc >= 0) {\n      return Ok(__fern_path_copy(buf_own, total));\n    }\n    if (rc != 0 - 17) {\n      return Err(__fern_io_error(0 - rc, __fern_path_copy(prefix, plen)));\n    }\n    tries = tries + 1;\n  }\n  return Err(__fern_io_error(17, __fern_path_copy(prefix, plen)));\n}\n\nfunction __fern_hex_digit(d: i32): i32 {\n  if (d < 10) {\n    return 48 + d;\n  }\n  return 87 + d;\n}\n",
    "function __fern_termios_get(fd: i32): Result[i64[], IoError] {\n  let buf: usize = __raw_alloc(72);\n  let rc: i32 = __syscall3(54, fd as i64, 1078490131, buf as i64) as i32;\n  if (rc < 0) {\n    let buf_own0: string = __raw_string(buf, 72);\n    return Err(__fern_io_error(0 - rc, \"\"));\n  }\n  let out: i64[] = [];\n  let i: i32 = 0;\n  while (i < 26) {\n    if (i < 4 || i >= 24) {\n      let off: i32 = i * 8;\n      if (i >= 24) {\n        off = 56 + (i - 24) * 8;\n      }\n      let v: i64 = 0 as i64;\n      let k: i32 = 7;\n      while (k >= 0) {\n        v = v << 8 | __raw_load8(buf, off + k) as i64;\n        k = k - 1;\n      }\n      out = out.append(v);\n    } else {\n      out = out.append(__raw_load8(buf, 28 + i) as i64);\n    }\n    i = i + 1;\n  }\n  let buf_own: string = __raw_string(buf, 72);\n  return Ok(out);\n}\n",
    "function __fern_termios_set(fd: i32, act: i32, words: i64[]): Result[void, IoError] {\n  if (words.len() != 26 || act < 0 || act > 2) {\n    return Err(__fern_io_error(22, \"\"));\n  }\n  let buf: usize = __raw_alloc(72);\n  let z: i32 = 0;\n  while (z < 72) {\n    __raw_store8(buf, z, 0);\n    z = z + 1;\n  }\n  let i: i32 = 0;\n  while (i < 26) {\n    let v: i64 = words[i];\n    if (i < 4 || i >= 24) {\n      let off: i32 = i * 8;\n      if (i >= 24) {\n        off = 56 + (i - 24) * 8;\n      }\n      let k: i32 = 0;\n      while (k < 8) {\n        __raw_store8(buf, off + k, (v >> (k * 8) as i64 & 255 as i64) as i32);\n        k = k + 1;\n      }\n    } else {\n      __raw_store8(buf, 28 + i, (v & 255 as i64) as i32);\n    }\n    i = i + 1;\n  }\n  let rc: i32 = __syscall3(54, fd as i64, 2152231956 as i64 + act as i64, buf as i64) as i32;\n  let buf_own: string = __raw_string(buf, 72);\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, \"\"));\n  }\n  return Ok(());\n}\n",
