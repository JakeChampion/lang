    "function __fern_uname_field(idx: i32): string {\n  let buf: usize = __raw_alloc(390);\n  let n: i32 = 0;\n  let off: i32 = 0;\n  if (idx >= 0 && idx < 5) {\n    off = idx * 65;\n    if (__syscall3(160, buf as i64, 0, 0) == 0) {\n      while (n < 65 && __raw_load8(buf, off + n) != 0) {\n        n = n + 1;\n      }\n    }\n  }\n  if (__fern_utf8_valid(buf + off, n) == 0) {\n    n = 0;\n  }\n  let p: usize = __raw_alloc(n);\n  __memcpy(p, buf + off, n);\n  let buf_own: string = __raw_string(buf, 390);\n  return __raw_string(p, n);\n}\n",
    "function __fern_unix_connect(path: string): i32 {\n  if (path.len() > 107) {\n    return 0 - 36;\n  }\n  let fd: i32 = __syscall3(198, 1, 1, 0) as i32;\n  if (fd < 0) {\n    return fd;\n  }\n  let n: i32 = path.len();\n  let sa: usize = __raw_scratch(112);\n  __raw_store8(sa, 0, 1);\n  __raw_store8(sa, 1, 0);\n  let p: usize = __raw_data(path);\n  let i: i32 = 0;\n  while (i < n) {\n    __raw_store8(sa, 2 + i, __raw_load8(p, i));\n    i = i + 1;\n  }\n  __raw_store8(sa, 2 + n, 0);\n  let r: i32 = __syscall3(203, fd as i64, sa as i64, (n + 3) as i64) as i32;\n  if (r < 0) {\n    __syscall3(57, fd as i64, 0, 0);\n    return r;\n  }\n  return fd;\n}\n",
    "function __fern_unix_listen(path: string, backlog: i32): i32 {\n  if (path.len() > 107) {\n    return 0 - 36;\n  }\n  let fd: i32 = __syscall3(198, 1, 1, 0) as i32;\n  if (fd < 0) {\n    return fd;\n  }\n  let n: i32 = path.len();\n  let sa: usize = __raw_scratch(112);\n  __raw_store8(sa, 0, 1);\n  __raw_store8(sa, 1, 0);\n  let p: usize = __raw_data(path);\n  let i: i32 = 0;\n  while (i < n) {\n    __raw_store8(sa, 2 + i, __raw_load8(p, i));\n    i = i + 1;\n  }\n  __raw_store8(sa, 2 + n, 0);\n  let r: i32 = __syscall3(200, fd as i64, sa as i64, (n + 3) as i64) as i32;\n  if (r >= 0) {\n    r = __syscall3(201, fd as i64, backlog as i64, 0) as i32;\n  }\n  if (r < 0) {\n    __syscall3(57, fd as i64, 0, 0);\n    return r;\n  }\n  return fd;\n}\n",
    "function __fern_vdso_find(image: usize): usize {\n  if (image == 0 as usize) {\n    return 1 as usize;\n  }\n  if (__raw_load8(image, 0) != 127 || __raw_load8(image, 1) != 69 || __raw_load8(image, 2) != 76 || __raw_load8(image, 3) != 70 || __raw_load8(image, 4) != 2) {\n    return 1 as usize;\n  }\n  let base: i64 = image as i64;\n  let phoff: i64 = __load_i64(image + 32);\n  let phsize: i32 = __raw_load8(image, 54) + __raw_load8(image, 55) * 256;\n  let phnum: i32 = __raw_load8(image, 56) + __raw_load8(image, 57) * 256;\n  let bias: i64 = 0 as i64;\n  let loaded: boolean = false;\n  let dynv: i64 = 0 as i64;\n  let i: i32 = 0;\n  while (i < phnum) {\n    let ph: i64 = base + phoff + (i * phsize) as i64;\n    let kind: i32 = __load_i32(ph as usize);\n    if (kind == 1 && !loaded) {\n      bias = base + __load_i64((ph + 8 as i64) as usize) - __load_i64((ph + 16 as i64) as usize);\n      loaded = true;\n    }\n    if (kind == 2) {\n      dynv = __load_i64((ph + 16 as i64) as usize);\n    }\n    i = i + 1;\n  }\n  if (!loaded || dynv == 0 as i64) {\n    return 1 as usize;\n  }\n  let d: i64 = bias + dynv;\n  let strtab: i64 = 0 as i64;\n  let symtab: i64 = 0 as i64;\n  let hash: i64 = 0 as i64;\n  let tag: i64 = __load_i64(d as usize);\n  while (tag != 0 as i64) {\n    let val: i64 = __load_i64((d + 8 as i64) as usize);\n    if (tag == 4 as i64) {\n      hash = bias + val;\n    }\n    if (tag == 5 as i64) {\n      strtab = bias + val;\n    }\n    if (tag == 6 as i64) {\n      symtab = bias + val;\n    }\n    d = d + 16 as i64;\n    tag = __load_i64(d as usize);\n  }\n  if (hash == 0 as i64 || strtab == 0 as i64 || symtab == 0 as i64) {\n    return 1 as usize;\n  }\n  let nsyms: i32 = __load_i32((hash + 4 as i64) as usize);\n  let k: i32 = 0;\n  while (k < nsyms) {\n    let sym: usize = (symtab + k as i64 * (24 as i64)) as usize;\n    if (__raw_load8(sym, 6) != 0 || __raw_load8(sym, 7) != 0) {\n      let at: usize = (strtab + __load_i32(sym) as i64) as usize;\n    