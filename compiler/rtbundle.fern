    "function __fern_udp_recvfrom(fd: i32, buf: i32[], from: i32[]): i32 {\n  let max: i32 = buf.len();\n  let p: usize = __raw_alloc(max + 1);\n  let sa: usize = __raw_scratch(32);\n  __raw_store8(sa, 28, 28);\n  __raw_store8(sa, 29, 0);\n  __raw_store8(sa, 30, 0);\n  __raw_store8(sa, 31, 0);\n  let n: i32 = __syscall6(45, fd as i64, p as i64, max as i64, 0, sa as i64, (sa + 28) as i64) as i32;\n  let b: usize = __raw_arr_ptr(buf);\n  let i: i32 = 0;\n  while (i < n) {\n    __raw_store_ptr(b, i + 1, __raw_load8(p, i) as usize);\n    i = i + 1;\n  }\n  if (n >= 0 && from.len() >= 19) {\n    let f: usize = __raw_arr_ptr(from);\n    let z: i32 = 1;\n    while (z <= 19) {\n      __raw_store_ptr(f, z - 1 + 1, 0 as usize);\n      z = z + 1;\n    }\n    let fam: i32 = __raw_load8(sa, 0) | __raw_load8(sa, 1) << 8;\n    let n_addr: i32 = 0;\n    let at: i32 = 4;\n    if (fam == 2) {\n      __raw_store_ptr(f, 0 + 1, 4 as usize);\n      n_addr = 4;\n    } else if (fam == 10) {\n      __raw_store_ptr(f, 0 + 1, 6 as usize);\n      n_addr = 16;\n      at = 8;\n    }\n    let k: i32 = 0;\n    while (k < n_addr) {\n      __raw_store_ptr(f, 1 + k + 1, __raw_load8(sa, at + k) as usize);\n      k = k + 1;\n    }\n    __raw_store_ptr(f, 17 + 1, __raw_load8(sa, 2) as usize);\n    __raw_store_ptr(f, 18 + 1, __raw_load8(sa, 3) as usize);\n  }\n  let p_own: string = __raw_string(p, max + 1);\n  return n;\n}\n",
    "function __fern_udp_recvfrom_u8(fd: i32, buf: i32[], from: i32[]): i32 {\n  let max: i32 = buf.len();\n  let p: usize = __raw_arr_ptr(buf) + 8;\n  let sa: usize = __raw_scratch(32);\n  __raw_store8(sa, 28, 28);\n  __raw_store8(sa, 29, 0);\n  __raw_store8(sa, 30, 0);\n  __raw_store8(sa, 31, 0);\n  let n: i32 = __syscall6(45, fd as i64, p as i64, max as i64, 0, sa as i64, (sa + 28) as i64) as i32;\n  if (n >= 0 && from.len() >= 19) {\n    let f: usize = __raw_arr_ptr(from);\n    let z: i32 = 1;\n    while (z <= 19) {\n      __raw_store8(f, 8 + (z - 1), 0);\n      z = z + 1;\n    }\n    let fam: i32 = __raw_load8(sa, 0) | __raw_load8(sa, 1) << 8;\n    let n_addr: i32 = 0;\n    let at: i32 = 4;\n    if (fam == 2) {\n      __raw_store8(f, 8 + 0, 4);\n      n_addr = 4;\n    } else if (fam == 10) {\n      __raw_store8(f, 8 + 0, 6);\n      n_addr = 16;\n      at = 8;\n    }\n    let k: i32 = 0;\n    while (k < n_addr) {\n      __raw_store8(f, 8 + (1 + k), __raw_load8(sa, at + k));\n      k = k + 1;\n    }\n    __raw_store8(f, 8 + 17, __raw_load8(sa, 2));\n    __raw_store8(f, 8 + 18, __raw_load8(sa, 3));\n  }\n  return n;\n}\n",
    "function __fern_udp_sendto(fd: i32, addr: i32[], port: i32, data: string): i32 {\n  if (addr.len() == 0) {\n    return __syscall6(44, fd as i64, __raw_data(data) as i64, data.len() as i64, 16384, 0, 0) as i32;\n  }\n  let af: i32 = 2;\n  if (addr.len() == 16) {\n    af = 10;\n  } else if (addr.len() != 4) {\n    return 0 - 97;\n  }\n  let sa: usize = __raw_scratch(28);\n  let salen: i32 = 16;\n  let at: i32 = 4;\n  if (addr.len() == 16) {\n    salen = 28;\n    at = 8;\n  }\n  let z: i32 = 0;\n  while (z < 28) {\n    __raw_store8(sa, z, 0);\n    z = z + 1;\n  }\n  __raw_store8(sa, 0, af);\n  __raw_store8(sa, 1, 0);\n  __raw_store8(sa, 2, port >> 8 & 255);\n  __raw_store8(sa, 3, port & 255);\n  let ap: usize = __raw_arr_ptr(addr);\n  let k: i32 = 0;\n  while (k < addr.len()) {\n    __raw_store8(sa, at + k, __raw_load_ptr(ap, k + 1) as i32);\n    k = k + 1;\n  }\n  return __syscall6(44, fd as i64, __raw_data(data) as i64, data.len() as i64, 16384, sa as i64, salen as i64) as i32;\n}\n",
    "function __fern_udp_sendto_bytes(fd: i32, addr: i32[], port: i32, data: i32[]): i32 {\n  let byte_n: i32 = data.len();\n  let byte_raw: usize = __raw_arr_box(byte_n / 8 + 1);\n  let byte_scratch: i32[] = __raw_array(byte_raw);\n  let byte_data: usize = __raw_arr_ptr(byte_scratch) + 8;\n  let byte_j: i32 = 0;\n  while (byte_j < byte_n) {\n    __raw_store8(byte_data, byte_j, data[byte_j]);\n    byte_j = byte_j + 1;\n  }\n  if (addr.len() == 0) {\n    return __syscall6(44, fd as i64, byte_data as i64, data.len() as i64, 16384, 0, 0) as i32;\n  }\n  let af: i32 = 2;\n  if (addr.len() == 16) {\n    af = 10;\n  } else if (addr.len() != 4) {\n    return 0 - 97;\n  }\n  let sa: usize = __raw_scratch(28);\n  let salen: i32 = 16;\n  let at: i32 = 4;\n  if (addr.len() == 16) {\n    salen = 28;\n    at = 8;\n  }\n  let z: i32 = 0;\n  while (z < 28) {\n    __raw_store8(sa, z, 0);\n    z = z + 1;\n  }\n  __raw_store8(sa, 0, af);\n  __raw_store8(sa, 1, 0);\n  __raw_store8(sa, 2, port >> 8 & 255);\n  __raw_store8(sa, 3, port & 255);\n  let ap: usize = __raw_arr_ptr(addr);\n  let k: i32 = 0;\n  while (k < addr.len()) {\n    __raw_store8(sa, at + k, __raw_load_ptr(ap, k + 1) as i32);\n    k = k + 1;\n  }\n  return __syscall6(44, fd as i64, byte_data as i64, data.len() as i64, 16384, sa as i64, salen as i64) as i32;\n}\n",
    "function __fern_udp_sendto_bytes_u8(fd: i32, addr: i32[], port: i32, data: i32[]): i32 {\n  let byte_data: usize = __raw_arr_ptr(data) + 8;\n  if (addr.len() == 0) {\n    return __syscall6(44, fd as i64, byte_data as i64, data.len() as i64, 16384, 0, 0) as i32;\n  }\n  let af: i32 = 2;\n  if (addr.len() == 16) {\n    af = 10;\n  } else if (addr.len() != 4) {\n    return 0 - 97;\n  }\n  let sa: usize = __raw_scratch(28);\n  let salen: i32 = 16;\n  let at: i32 = 4;\n  if (addr.len() == 16) {\n    salen = 28;\n    at = 8;\n  }\n  let z: i32 = 0;\n  while (z < 28) {\n    __raw_store8(sa, z, 0);\n    z = z + 1;\n  }\n  __raw_store8(sa, 0, af);\n  __raw_store8(sa, 1, 0);\n  __raw_store8(sa, 2, port >> 8 & 255);\n  __raw_store8(sa, 3, port & 255);\n  let ap: usize = __raw_arr_ptr(addr);\n  let k: i32 = 0;\n  while (k < addr.len()) {\n    __raw_store8(sa, at + k, __raw_load8(ap, 8 + k));\n    k = k + 1;\n  }\n  return __syscall6(44, fd as i64, byte_data as i64, data.len() as i64, 16384, sa as i64, salen as i64) as i32;\n}\n",
    "function __fern_udp_sendto_u8(fd: i32, addr: i32[], port: i32, data: string): i32 {\n  if (addr.len() == 0) {\n    return __syscall6(44, fd as i64, __raw_data(data) as i64, data.len() as i64, 16384, 0, 0) as i32;\n  }\n  let af: i32 = 2;\n  if (addr.len() == 16) {\n    af = 10;\n  } else if (addr.len() != 4) {\n    return 0 - 97;\n  }\n  let sa: usize = __raw_scratch(28);\n  let salen: i32 = 16;\n  let at: i32 = 4;\n  if (addr.len() == 16) {\n    salen = 28;\n    at = 8;\n  }\n  let z: i32 = 0;\n  while (z < 28) {\n    __raw_store8(sa, z, 0);\n    z = z + 1;\n  }\n  __raw_store8(sa, 0, af);\n  __raw_store8(sa, 1, 0);\n  __raw_store8(sa, 2, port >> 8 & 255);\n  __raw_store8(sa, 3, port & 255);\n  let ap: usize = __raw_arr_ptr(addr);\n  let k: i32 = 0;\n  while (k < addr.len()) {\n    __raw_store8(sa, at + k, __raw_load8(ap, 8 + k));\n    k = k + 1;\n  }\n  return __syscall6(44, fd as i64, __raw_data(data) as i64, data.len() as i64, 16384, sa as i64, salen as i64) as i32;\n}\n",
