    "function __fern_profile_macho_command(im: usize, size: usize, kind: usize, name: string): usize {\n  if (im == 0 || size < 32) {\n    return 0;\n  }\n  if (__fern_profile_macho_u32(im) != 4277009103u64 as usize) {\n    return 0;\n  }\n  let bytes: usize = __fern_profile_macho_u32(im + 20);\n  let count: usize = __fern_profile_macho_u32(im + 16);\n  if (bytes > size - 32 || count > bytes / 8) {\n    return 0;\n  }\n  let at: usize = 32;\n  let end: usize = 32 + bytes;\n  let i: usize = 0;\n  while (i < count) {\n    if (at > end || end - at < 8) {\n      return 0;\n    }\n    let command: usize = im + at;\n    let len: usize = __fern_profile_macho_u32(command + 4);\n    if (len < 8 || len > end - at) {\n      return 0;\n    }\n    if (__fern_profile_macho_u32(command) == kind) {\n      if (name.len() == 0) {\n        return command;\n      }\n      if (len >= 24 && __fern_profile_macho_tag(command + 8, name)) {\n        return command;\n      }\n    }\n    at = at + len;\n    i = i + 1;\n  }\n  return 0;\n}\n",
    "function __fern_profile_macho_image_size(im: usize): usize {\n  // The native writer maps at least one 16 KiB __TEXT page containing its\n  // load commands. This bootstrap read is only for our running executable.\n  let text: usize = __fern_profile_macho_command(im, 16384, 25, \"__TEXT\");\n  if (text == 0 || __fern_profile_macho_u32(text + 4) < 72) {\n    return 0;\n  }\n  let base: usize = __load_i64(text + 24) as usize;\n  let extent: usize = base;\n  let count: usize = __fern_profile_macho_u32(im + 16);\n  let end: usize = 32 + __fern_profile_macho_u32(im + 20);\n  let at: usize = 32;\n  let i: usize = 0;\n  while (i < count) {\n    if (at > end || end - at < 8) {\n      return 0;\n    }\n    let command: usize = im + at;\n    let len: usize = __fern_profile_macho_u32(command + 4);\n    if (len < 8 || len > end - at) {\n      return 0;\n    }\n    if (__fern_profile_macho_u32(command) == 25 && len >= 72) {\n      let addr: usize = __load_i64(command + 24) as usize;\n      let bytes: usize = __load_i64(command + 32) as usize;\n      if (addr >= base && bytes > 0) {\n        let limit: usize = addr + bytes;\n        if (limit < addr) {\n          return 0;\n        }\n        if (limit > extent) {\n          extent = limit;\n        }\n      }\n    }\n    at = at + len;\n    i = i + 1;\n  }\n  return extent - base;\n}\n",
    "function __fern_profile_macho_tag(p: usize, text: string): boolean {\n  if (text.len() > 16) {\n    return false;\n  }\n  let i: i32 = 0;\n  while (i < text.len()) {\n    if (__load_u8(p + i as usize) != __load_u8(__raw_data(text) + i as usize)) {\n      return false;\n    }\n    i = i + 1;\n  }\n  if (text.len() == 16) {\n    return true;\n  }\n  return __load_u8(p + text.len() as usize) == 0;\n}\n",
    "function __fern_profile_macho_u32(p: usize): usize {\n  return (__load_i32(p) as u32) as usize;\n}\n",
    "function __fern_profile_name(pc: usize, im: usize, size: usize): usize {\n  let text: usize = __fern_profile_macho_command(im, size, 25, \"__TEXT\");\n  let link: usize = __fern_profile_macho_command(im, size, 25, \"__LINKEDIT\");\n  let symbols: usize = __fern_profile_macho_command(im, size, 2, \"\");\n  if (text == 0 || link == 0 || symbols == 0) {\n    return 0;\n  }\n  if (__fern_profile_macho_u32(text + 4) < 152 || __fern_profile_macho_u32(link + 4) < 72 || __fern_profile_macho_u32(symbols + 4) < 24) {\n    return 0;\n  }\n  if (__fern_profile_macho_u32(text + 64) < 1 || !__fern_profile_macho_tag(text + 72, \"__text\")) {\n    return 0;\n  }\n  let base: usize = __load_i64(text + 24) as usize;\n  let start: usize = __load_i64(text + 104) as usize;\n  let length: usize = __load_i64(text + 112) as usize;\n  let address: usize = pc - (im - base);\n  if (address < start || address - start >= length) {\n    return 0;\n  }\n  let link_addr: usize = __load_i64(link + 24) as usize;\n  let link_vm: usize = __load_i64(link + 32) as usize;\n  let link_off: usize = __load_i64(link + 40) as usize;\n  let link_size: usize = __load_i64(link + 48) as usize;\n  if (link_addr < base || link_size > link_vm) {\n    return 0;\n  }\n  let link_at: usize = link_addr - base;\n  if (link_at > size || link_size > size - link_at) {\n    return 0;\n  }\n  let sym_off: usize = __fern_profile_macho_u32(symbols + 8);\n  let count: usize = __fern_profile_macho_u32(symbols + 12);\n  let str_off: usize = __fern_profile_macho_u32(symbols + 16);\n  let str_size: usize = __fern_profile_macho_u32(symbols + 20);\n  if (sym_off < link_off || str_off < link_off) {\n    return 0;\n  }\n  let sym_at: usize = sym_off - link_off;\n  let str_at: usize = str_off - link_off;\n  if (sym_at > link_size || count > (link_size - sym_at) / 16) {\n    return 0;\n  }\n  if (str_at > link_size || str_size > link_size - str_at) {\n    return 0;\n  }\n  let table: usize = im + link_at + sym_at;\n  // macho_sym_order sorts native text symbols by address, then by name.\n  let lo: usize = 0;\n  let hi: usize = count;\n  while (lo < hi) {\n    let mid: usize = lo + (hi - lo) / 2;\n    let value: usize = __load_i64(table + mid * 16 + 8) as usize;\n    if (value <= address) {\n      lo = mid + 1;\n    } else {\n      hi = mid;\n    }\n  }\n  if (lo == 0) {\n    return 0;\n  }\n  let symbol: usize = table + (lo - 1) * 16;\n  if ((__load_u8(symbol + 4) & 238) != 14 || __load_u8(symbol + 5) != 1) {\n    return 0;\n  }\n  let name: usize = __fern_profile_macho_u32(symbol);\n  if (name == 0 || name >= str_size) {\n    return 0;\n  }\n  let strings: usize = im + link_at + str_at;\n  let p: usize = strings + name;\n  let q: usize = p;\n  while (q < strings + str_size && __load_u8(q) != 0) {\n    q = q + 1;\n  }\n  if (q == strings + str_size || q == p) {\n    return 0;\n  }\n  return p;\n}\n",
    "function __fern_profile_pprof(base: usize, im: usize, size: usize): void {\n  let out: usize = base + 4325536;\n  let buf: usize = out + 4112;\n  let path: string = __FERN_PROFILE_PATH;\n  let j: i32 = 0;\n  while (j < path.len()) {\n    __raw_store8(buf, j, __load_u8(__raw_data(path) + j));\n    j = j + 1;\n  }\n  __raw_store8(buf, j, 0);\n  let fd: i64 = __syscall4(463, 0 - 2, buf as i64, 16778753, 420);\n  if (fd < 0 as i64) {\n    let msg: string = \"fern profile: cannot create pprof output file\\n\";\n    __fern_profile_write(__raw_data(msg), msg.len() as usize);\n    return;\n  }\n  __raw_store_ptr(out, 0, 0);\n  __raw_store_ptr(out + 8, 0, fd as usize);\n  if (__FERN_PROFILE_MODE == 3) {\n    __fern_pp_type(out, buf, 10, 1, 2);\n    __fern_pp_type(out, buf, 10, 3, 4);\n    __fern_pp_type(out, buf, 90, 3, 4);\n    __fern_pp_uint(out, 96);\n    __fern_pp_uint(out, 10000000);\n    __fern_pp_uint(out, 112);\n    __fern_pp_uint(out, 3);\n  } else {\n    __fern_pp_type(out, buf, 10, 5, 2);\n    __fern_pp_type(out, buf, 10, 6, 7);\n    __fern_pp_type(out, buf, 90, 5, 2);\n    __fern_pp_uint(out, 96);\n    __fern_pp_uint(out, 64);\n    __fern_pp_uint(out, 112);\n    __fern_pp_uint(out, 6);\n  }\n  let count: usize = __load_i64(base) as usize;\n  let i: usize = 0;\n  while (i < count) {\n    __fern_pp_sample(base, out, buf, i);\n    i = i + 1;\n  }\n  __fern_pp_tables(base, out, buf);\n  __fern_pp_string(out, \"\");\n  __fern_pp_string(out, \"samples\");\n  __fern_pp_string(out, \"count\");\n  __fern_pp_string(out, \"cpu\");\n  __fern_pp_string(out, \"nanoseconds\");\n  __fern_pp_string(out, \"alloc_objects\");\n  __fern_pp_string(out, \"alloc_space\");\n  __fern_pp_string(out, \"bytes\");\n  let n: usize = __fern_pp_text(buf, 0, \"Fern bounded reservoir: retained=\");\n  n = __fern_pp_decimal(buf, n, count);\n  n = __fern_pp_text(buf, n, \" dropped=\");\n  n = __fern_pp_decimal(buf, n, __load_i64(base + 8) as usize);\n  __fern_pp_message(out, 50, buf, n);\n  __f