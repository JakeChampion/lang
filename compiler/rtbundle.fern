    "function __fern_profile_start(base: usize, hi: usize, act: usize, timer: usize): void {\n  __raw_store_ptr(base + 128, 0, __syscall3(172, 0, 0, 0) as usize);\n  __raw_store_ptr(base + 16, 0, hi);\n  __raw_store_ptr(base + 24, 0, 1);\n  __raw_store_ptr(base + 136, 0, __FERN_PROFILE_MODE);\n  if (__FERN_PROFILE_MODE != 1 && __FERN_PROFILE_MODE != 3) {\n    return;\n  }\n  let a: i64 = __syscall4(134, 27, act as i64, 0, 8);\n  let b: i64 = 0 - 1;\n  if (a >= 0 as i64) {\n    __raw_store_ptr(base + 48, 0, 67108864);\n    let unblocked: i64 = __syscall4(135, 1, (base + 48) as i64, 0, 8);\n    if (unblocked < 0 as i64) {\n      b = unblocked;\n    } else {\n      b = __syscall3(103, 2, timer as i64, 0);\n    }\n  }\n  if (a < 0 as i64 || b < 0 as i64) {\n    __raw_store_ptr(base + 24, 0, 0);\n    __raw_store_ptr(base + 32, 0, 2);\n    let msg: string = \"fern profile: cannot install CPU sampler\\n\";\n    __fern_profile_write(__raw_data(msg), msg.len() as usize);\n    __syscall3(94, 2, 0, 0);\n  }\n}\n",
