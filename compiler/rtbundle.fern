    "function __fern_poll(fds: i32[], timeout_ms: i32): i32 {\n  let n: i32 = fds.len();\n  if (n <= 0 || n > 33554431) {\n    return 0 - 1;\n  }\n  let count: i32 = 0;\n  for fd in fds {\n    if (fd >= 0) {\n      count = count + 1;\n    }\n  }\n  if (count == 0) {\n    return 0 - 1;\n  }\n  let kq: i32 = __syscall3(362, 0, 0, 0) as i32;\n  if (kq < 0) {\n    return 0 - 1;\n  }\n  let buf: usize = __raw_alloc(count * 64);\n  let events: usize = buf + count * 32;\n  let i: i32 = n - 1;\n  let c: i32 = 0;\n  while (i >= 0) {\n    if (fds[i] >= 0) {\n      __raw_store_ptr(buf, c * 4, fds[i] as usize);\n      __raw_store_ptr(buf, c * 4 + 1, 4325375);\n      __raw_store_ptr(buf, c * 4 + 2, 0);\n      __raw_store_ptr(buf, c * 4 + 3, i as usize);\n      c = c + 1;\n    }\n    i = i - 1;\n  }\n  let ts: usize = __raw_scratch(16);\n  __raw_store_ptr(ts, 0, 0);\n  __raw_store_ptr(ts, 1, 0);\n  let receipts: i32 = __syscall6(363, kq as i64, buf as i64, count as i64, events as i64, count as i64, ts as i64) as i32;\n  let valid: i32 = 0;\n  let bad: i32 = 0 - 1;\n  let r: i32 = 0;\n  let wait_ms: i32 = timeout_ms;\n  while (r < receipts) {\n    if (__raw_load_ptr(events, r * 4 + 2) == 0) {\n      valid = valid + 1;\n    } else {\n      wait_ms = 0;\n      let at: i32 = __raw_load_ptr(events, r * 4 + 3) as i32;\n      if (bad < 0 || at < bad) {\n        bad = at;\n      }\n    }\n    r = r + 1;\n  }\n  let got: i32 = 0;\n  if (valid > 0) {\n    let tmo: usize = 0 as usize;\n    if (wait_ms >= 0) {\n      __raw_store_ptr(ts, 0, (wait_ms / 1000) as usize);\n      __raw_store_ptr(ts, 1, (wait_ms % 1000 * 1000000) as usize);\n      tmo = ts;\n    }\n    got = __syscall6(363, kq as i64, 0, 0, events as i64, count as i64, tmo as i64) as i32;\n  }\n  __syscall3(6, kq as i64, 0, 0);\n  let hit: i32 = bad;\n  let j: i32 = 0;\n  while (j < got) {\n    if ((__raw_load8(events, j * 32 + 11) & 64) == 0) {\n      let idx: i32 = __raw_load_ptr(events, j * 4 + 3) as i32;\n      if (hit < 0 || i