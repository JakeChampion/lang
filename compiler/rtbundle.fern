    "function __fern_read_dir(path: string): Result[string[], IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let fd: i32 = __syscall3(56, -100, pathz as i64, 16384) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (fd < 0) {\n    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));\n  }\n  let basep: usize = __raw_alloc(8);\n  let names: string[] = [];\n  let bad: i32 = 0;\n  let done: i32 = 0;\n  while (done == 0) {\n    let buf: usize = __raw_alloc(65536);\n    let n: i32 = __syscall4(61, fd as i64, buf as i64, 65536, basep as i64) as i32;\n    if (n <= 0) {\n      done = 1;\n      bad = n;\n    } else {\n      let pos: i32 = 0;\n      while (pos < n) {\n        let reclen: i32 = __raw_load8(buf, pos + 16) + __raw_load8(buf, pos + 17) * 256;\n        let nlen: i32 = 0;\n        let room: i32 = reclen - 19;\n        let scan: i32 = 1;\n        while (scan == 1 && nlen + 8 <= room) {\n          let w: i64 = __load_i64(buf + pos + 19 + nlen);\n          let z: i64 = w - 72340172838076673 as i64 & (w ^ (0 - 1) as i64) & (0 - 9187201950435737472) as i64;\n          if (z != 0 as i64) {\n            nlen = nlen + (__ctz64(z as u64) >> 3);\n            scan = 0;\n          } else {\n            nlen = nlen + 8;\n          }\n        }\n        if (scan == 1) {\n          while (__raw_load8(buf, pos + 19 + nlen) != 0) {\n            nlen = nlen + 1;\n          }\n        }\n        if (__fern_utf8_valid(buf + pos + 19, nlen) == 0) {\n          bad = 0 - 84;\n          done = 1;\n          pos = n;\n        } else {\n          let skip: i32 = 0;\n          if (nlen == 1) {\n            if (__raw_load8(buf, pos + 19) == 46) {\n              skip = 1;\n            }\n          }\n          if (nlen == 2) {\n            if (__raw_load8(buf, pos + 19) == 4