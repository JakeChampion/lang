    "function __fern_window_size(fd: i32): Result[WinSize, IoError] {\n  let buf: usize = __raw_scratch(16);\n  let rc: i32 = __syscall3(29, fd as i64, 21523, buf as i64) as i32;\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, \"\"));\n  }\n  let r: i32 = __raw_load8(buf, 0) + __raw_load8(buf, 1) * 256;\n  let c: i32 = __raw_load8(buf, 2) + __raw_load8(buf, 3) * 256;\n  return Ok(WinSize { rows: r as i64, cols: c as i64 });\n}\n",
    "function __fern_write_file(path: string, contents: string): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  let fd: i32 = __syscall4(56, -100, pathz as i64, 577, 420) as i32;\n  if (fd < 0) {\n    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));\n  }\n  let clen: i32 = contents.len();\n  let cbuf: usize = __str_bytes(contents, 0 as usize);\n  let put: i32 = 0;\n  while (put < clen) {\n    let w: i32 = __syscall3(64, fd as i64, (cbuf + put) as i64, (clen - put) as i64) as i32;\n    if (w == 0 - 4 && put > 0) {\n      continue;\n    }\n    if (w < 0) {\n      __syscall3(57, fd as i64, 0, 0);\n      return Err(__fern_io_error(0 - w, __fern_path_copy(pathz_own, plen)));\n    }\n    if (w == 0) {\n      __syscall3(57, fd as i64, 0, 0);\n      return Err(__fern_io_error(5, __fern_path_copy(pathz_own, plen)));\n    }\n    put = put + w;\n  }\n  __syscall3(57, fd as i64, 0, 0);\n  return Ok(());\n}\n",
    "function __fern_write_file_bytes(path: string, bytes: i32[]): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let invalid: boolean = false;\n  let i: i32 = 0;\n  while (i < plen) {\n    let c: i32 = path[i] as i32;\n    if (c == 0) {\n      invalid = true;\n    }\n    __raw_store8(pathz, i, c);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (invalid) {\n    return Err(__fern_io_error(22, __fern_path_copy(pathz_own, plen)));\n  }\n  let fd: i32 = __syscall4(56, -100, pathz as i64, 577, 420) as i32;\n  if (fd < 0) {\n    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));\n  }\n  let n: i32 = bytes.len();\n  let raw: usize = __raw_arr_box(n / 8 + 1);\n  let scratch: i32[] = __raw_array(raw);\n  let p: usize = __raw_arr_ptr(scratch) + 8;\n  let j: i32 = 0;\n  while (j < n) {\n    __raw_store8(p, j, bytes[j]);\n    j = j + 1;\n  }\n  let at: i32 = 0;\n  let bad: i32 = 0;\n  while (at < n && bad == 0) {\n    let w: i32 = __syscall3(64, fd as i64, (p + at) as i64, (n - at) as i64) as i32;\n    if (w == 0) {\n      bad = 5;\n    } else {\n      if (w < 0) {\n        if (w != -4 || at == 0) {\n          bad = 0 - w;\n        }\n      } else {\n        at = at + w;\n      }\n    }\n  }\n  let closed: i32 = __syscall3(57, fd as i64, 0, 0) as i32;\n  if (bad != 0) {\n    return Err(__fern_io_error(bad, __fern_path_copy(pathz_own, plen)));\n  }\n  if (closed < 0) {\n    return Err(__fern_io_error(0 - closed, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(());\n}\n",
    "function __fern_write_file_bytes_u8(path: string, bytes: i32[]): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let invalid: boolean = false;\n  let i: i32 = 0;\n  while (i < plen) {\n    let c: i32 = path[i] as i32;\n    if (c == 0) {\n      invalid = true;\n    }\n    __raw_store8(pathz, i, c);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (invalid) {\n    return Err(__fern_io_error(22, __fern_path_copy(pathz_own, plen)));\n  }\n  let fd: i32 = __syscall4(56, -100, pathz as i64, 577, 420) as i32;\n  if (fd < 0) {\n    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));\n  }\n  let n: i32 = bytes.len();\n  let p: usize = __raw_arr_ptr(bytes) + 8;\n  let at: i32 = 0;\n  let bad: i32 = 0;\n  while (at < n && bad == 0) {\n    let w: i32 = __syscall3(64, fd as i64, (p + at) as i64, (n - at) as i64) as i32;\n    if (w == 0) {\n      bad = 5;\n    } else {\n      if (w < 0) {\n        if (w != -4 || at == 0) {\n          bad = 0 - w;\n        }\n      } else {\n        at = at + w;\n      }\n    }\n  }\n  let closed: i32 = __syscall3(57, fd as i64, 0, 0) as i32;\n  if (bad != 0) {\n    return Err(__fern_io_error(bad, __fern_path_copy(pathz_own, plen)));\n  }\n  if (closed < 0) {\n    return Err(__fern_io_error(0 - closed, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(());\n}\n",
    "function __fern_write_file_exec(path: string, contents: string): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  let fd: i32 = __syscall4(56, -100, pathz as i64, 577, 493) as i32;\n  if (fd < 0) {\n    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));\n  }\n  let clen: i32 = contents.len();\n  let cbuf: usize = __str_bytes(contents, 0 as usize);\n  let put: i32 = 0;\n  while (put < clen) {\n    let w: i32 = __syscall3(64, fd as i64, (cbuf + put) as i64, (clen - put) as i64) as i32;\n    if (w == 0 - 4 && put > 0) {\n      continue;\n    }\n    if (w < 0) {\n      __syscall3(57, fd as i64, 0, 0);\n      return Err(__fern_io_error(0 - w, __fern_path_copy(pathz_own, plen)));\n    }\n    if (w == 0) {\n      __syscall3(57, fd as i64, 0, 0);\n      return Err(__fern_io_error(5, __fern_path_copy(pathz_own, plen)));\n    }\n    put = put + w;\n  }\n  __syscall3(52, fd as i64, 493, 0);\n  __syscall3(57, fd as i64, 0, 0);\n  return Ok(());\n}\n",
    "function __fern_writer_splice_forever(fd: i32, s: string): Result[void, IoError] {\n  let n: i32 = s.len();\n  if (n == 0) {\n    return Err(Unsupported);\n  }\n  let copies: i32 = 131072 / n;\n  if (copies < 1) {\n    copies = 1;\n  }\n  let len: i32 = copies * n;\n  let pages: i32 = (len + 4095) / 4096 * 4096;\n  let span: i32 = pages + 4096;\n  let m: i64 = __syscall6(222, 0, span as i64, 3, 34, (0 - 1) as i64, 0);\n  if (m < 0 as i64) {\n    return Err(Unsupported);\n  }\n  let buf: usize = m as usize;\n  let c: i32 = 0;\n  while (c < copies) {\n    __memcpy(buf + c * n, __raw_data(s), n);\n    c = c + 1;\n  }\n  let iov: usize = buf + pages;\n  let out: i32 = fd;\n  let pr: i32 = 0 - 1;\n  __syscall3(25, fd as i64, 1031, 524288);\n  let off: i32 = 0;\n  let moved: i64 = 0 as i64;\n  let err: i32 = 0;\n  while (err == 0) {\n    __store_i64(iov, (buf + off) as i64);\n    __store_i64(iov + 8, (len - off) as i64);\n    let gift: i32 = 0;\n    if (off % 4096 == 0 && (len - off) % 4096 == 0) {\n      gift = 8;\n    }\n    let w: i32 = __syscall4(75, out as i64, iov as i64, 1, gift as i64) as i32;\n    if ((w == 0 - 9 || w == 0 - 22) && pr < 0 && moved == 0 as i64) {\n      let fds: usize = iov + 16;\n      if (__syscall3(59, fds as i64, 524288, 0) != 0) {\n        err = 0 - 1;\n      } else {\n        pr = __load_i32(fds);\n        out = __load_i32(fds + 4);\n        __syscall3(25, pr as i64, 1031, 524288);\n      }\n    } else if (w < 0) {\n      if (w != 0 - 4) {\n        err = 0 - w;\n      }\n    } else {\n      let left: i32 = w;\n      while (pr >= 0 && left > 0 && err == 0) {\n        let d: i32 = __syscall6(76, pr as i64, 0, fd as i64, 0, left as i64, 1) as i32;\n        if (d > 0) {\n          left = left - d;\n          moved = moved + d as i64;\n        } else if (d == 0 - 22 && moved == 0 as i64) {\n          err = 0 - 1;\n        } else if (d != 0 - 4) {\n          err = 0 - d;\n          if (d == 0) {\n            err = 5;\n          }\n        }\n