    "function __fern_ring_send_zc_u8(ring: i64, fd: i32, data: i32[], from: i32): i32 {\n  if (ring < 0 as i64) {\n    return 0 - 9;\n  }\n  let blk: usize = ring as usize;\n  if (__load_i32(blk + 200) != 0) {\n    return 0 - 95;\n  }\n  let n: i32 = data.len();\n  if (fd < 0 || fd >= __load_i32(blk + 68) || from < 0 || from >= n) {\n    return 0 - 22;\n  }\n  let zt: usize = __fern_ring_zc_at(blk);\n  let s: i32 = 0;\n  while (s < 512 && __load_i32(zt + s as usize * 16 + 8) != 0) {\n    s = s + 1;\n  }\n  if (s >= 512) {\n    return 0 - 11;\n  }\n  let r: i32 = __fern_ring_push(blk, 47, fd, 16384, 1152921504606846976 as i64 | s as i64, (__raw_arr_ptr(data) + 8 + from as usize) as i64);\n  if (r < 0) {\n    return r;\n  }\n  __store_i32(__load_i64(blk + 192) as usize + 24, n - from);\n  let z: usize = zt + s as usize * 16;\n  __store_i32(z, fd);\n  __store_i32(z + 4, 0 - 115);\n  __store_i32(z + 8, 1);\n  return s;\n}\n",
