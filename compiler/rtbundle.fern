    "function __fern_proc_exec(path: string, args: string[]): i32 {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let n: i32 = args.len();\n  let argv: usize = __raw_alloc((n + 2) * 8);\n  __raw_store_ptr(argv, 0, pathz);\n  let total: i32 = 1;\n  let m: i32 = 0;\n  while (m < n) {\n    total = total + args[m].len() + 1;\n    m = m + 1;\n  }\n  let ab: usize = __raw_alloc(total);\n  let off: i32 = 0;\n  let k: i32 = 0;\n  while (k < n) {\n    let a: string = args[k];\n    let al: i32 = a.len();\n    __raw_store_ptr(argv, k + 1, ab + off);\n    let j: i32 = 0;\n    while (j < al) {\n      __raw_store8(ab, off + j, a[j] as i32);\n      j = j + 1;\n    }\n    __raw_store8(ab, off + al, 0);\n    off = off + al + 1;\n    k = k + 1;\n  }\n  __raw_store_ptr(argv, n + 1, 0);\n  let rc: i32 = __syscall3(59, pathz as i64, argv as i64, __raw_environ() as i64) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  let argv_own: string = __raw_string(argv, (n + 2) * 8);\n  let args_own: string = __raw_string(ab, total);\n  return rc;\n}\n",
    "function __fern_proc_exec_as(path: string, argv: string[], envp: string[]): i32 {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let an: i32 = argv.len();\n  let av: usize = __raw_alloc((an + 1) * 8);\n  let atotal: i32 = 1;\n  let am: i32 = 0;\n  while (am < an) {\n    atotal = atotal + argv[am].len() + 1;\n    am = am + 1;\n  }\n  let ab: usize = __raw_alloc(atotal);\n  let aoff: i32 = 0;\n  let ak: i32 = 0;\n  while (ak < an) {\n    let aa: string = argv[ak];\n    let aal: i32 = aa.len();\n    __raw_store_ptr(av, ak, ab + aoff);\n    let aj: i32 = 0;\n    while (aj < aal) {\n      __raw_store8(ab, aoff + aj, aa[aj] as i32);\n      aj = aj + 1;\n    }\n    __raw_store8(ab, aoff + aal, 0);\n    aoff = aoff + aal + 1;\n    ak = ak + 1;\n  }\n  __raw_store_ptr(av, an, 0);\n  let en: i32 = envp.len();\n  let ev: usize = __raw_alloc((en + 1) * 8);\n  let etotal: i32 = 1;\n  let em: i32 = 0;\n  while (em < en) {\n    etotal = etotal + envp[em].len() + 1;\n    em = em + 1;\n  }\n  let eb: usize = __raw_alloc(etotal);\n  let eoff: i32 = 0;\n  let ek: i32 = 0;\n  while (ek < en) {\n    let ea: string = envp[ek];\n    let eal: i32 = ea.len();\n    __raw_store_ptr(ev, ek, eb + eoff);\n    let ej: i32 = 0;\n    while (ej < eal) {\n      __raw_store8(eb, eoff + ej, ea[ej] as i32);\n      ej = ej + 1;\n    }\n    __raw_store8(eb, eoff + eal, 0);\n    eoff = eoff + eal + 1;\n    ek = ek + 1;\n  }\n  __raw_store_ptr(ev, en, 0);\n  let rc: i32 = __syscall3(59, pathz as i64, av as i64, ev as i64) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  let av_own: string = __raw_string(av, (an + 1) * 8);\n  let ev_own: string = __raw_string(ev, (en + 1) * 8);\n  let argv_own: string = __raw_string(ab, atotal);\n  let envp_own: string = __raw_string(eb, etotal);\n  return rc;\n}\n",
    "function __fern_proc_waitpid(pid: i32): i32 {\n  let st: usize = __raw_scratch(16);\n  let rc: i32 = __syscall4(7, pid as i64, st as i64, 0, 0) as i32;\n  if (rc < 0) {\n    return rc;\n  }\n  let w: i32 = __load_i32(st);\n  let sig: i32 = w & 127;\n  if (sig != 0) {\n    return sig + 128;\n  }\n  return w >> 8 & 255;\n}\n",
