    "function __fern_pp_tables(base: usize, out: usize, buf: usize): void {\n  let count: usize = __load_i64(base) as usize;\n  let name: usize = 9;\n  let i: usize = 0;\n  while (i < count) {\n    let row: usize = base + 160 + i * 528;\n    let depth: usize = __load_i64(row) as usize;\n    let k: usize = 0;\n    while (k < depth) {\n      let id: usize = i * 64 + k + 1;\n      __fern_pp_location(out, buf, id, __load_i64(row + 16 + k * 8) as usize);\n      __fern_pp_function(out, buf, id, name);\n      k = k + 1;\n      name = name + 1;\n    }\n    i = i + 1;\n  }\n}\n",
    "function __fern_pp_text(buf: usize, at: usize, s: string): usize {\n  return __fern_pp_copy(buf, at, __raw_data(s), s.len() as usize);\n}\n",
    "function __fern_pp_type(out: usize, buf: usize, tag: usize, kind: usize, unit: usize): void {\n  let n: usize = __fern_pp_field(buf, 0, 8, kind);\n  n = __fern_pp_field(buf, n, 16, unit);\n  __fern_pp_message(out, tag, buf, n);\n}\n",
    "function __fern_pp_uint(out: usize, n: usize): void {\n  while (n >= 128) {\n    __fern_pp_byte(out, (n & 127 | 128) as i32);\n    n = n >> 7;\n  }\n  __fern_pp_byte(out, n as i32);\n}\n",
    "function __fern_pp_uint_at(buf: usize, at: usize, n: usize): usize {\n  while (n >= 128) {\n    __raw_store8(buf + at, 0, (n & 127 | 128) as i32);\n    at = at + 1;\n    n = n >> 7;\n  }\n  __raw_store8(buf + at, 0, n as i32);\n  return at + 1;\n}\n",
