    "function __fern_open_with(path: string, flags: i32, write: i32): Result[i32, IoError] {\n  if ((flags & 136) != 0) {\n    return Err(Unsupported);\n  }\n  let f: i32 = 0;\n  if (write != 0) {\n    f = 1;\n  }\n  if ((flags & 1) != 0) {\n    f = f | 512;\n  }\n  if ((flags & 2) != 0) {\n    f = f | 4;\n  }\n  if ((flags & 4) != 0) {\n    f = f | 2048;\n  }\n  if ((flags & 16) != 0) {\n    f = f | 1048576;\n  }\n  if ((flags & 32) != 0) {\n    f = f | 4194304;\n  }\n  if ((flags & 64) != 0) {\n    f = f | 128;\n  }\n  if ((flags & 256) != 0) {\n    f = f | 131072;\n  }\n  if ((flags & 512) != 0) {\n    f = f | 256;\n  }\n  return __fern_open_res(path, f, 438);\n}\n",
