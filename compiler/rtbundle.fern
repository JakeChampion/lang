    "function __fern_vdso_clock(): usize {\n  let slot: usize = __raw_vdso();\n  let f: usize = __raw_load_ptr(slot, 1);\n  if (f == 0 as usize) {\n    f = __fern_vdso_find(__raw_load_ptr(slot, 0));\n    __raw_store_ptr(slot, 1, f);\n  }\n  return f;\n}\n",
    "function __fern_access(path: string, mode: i32): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let rc: i32 = __syscall4(439, -(100 as i64), pathz as i64, mode as i64, 512) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(());\n}\n",
    "function __fern_dir_access(dirfd: i32, path: string, mode: i32): Result[void, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let rc: i32 = __syscall4(439, dirfd as i64, pathz as i64, mode as i64, 512) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(());\n}\n",
    "function __fern_io_error(e: i32, path: string): IoError {\n  if (e == 2) {\n    return NotFound(path);\n  }\n  if (e == 13) {\n    return PermissionDenied(path);\n  }\n  if (e == 17) {\n    return AlreadyExists(path);\n  }\n  if (e == 4) {\n    return Interrupted;\n  }\n  if (e == 84) {\n    return InvalidUtf8(path);\n  }\n  if (e == 1) {\n    return Other(path, \"Operation not permitted\", 1);\n  }\n  if (e == 3) {\n    return Other(path, \"No such process\", 3);\n  }\n  if (e == 5) {\n    return Other(path, \"Input/output error\", 5);\n  }\n  if (e == 6) {\n    return Other(path, \"No such device or address\", 6);\n  }\n  if (e == 7) {\n    return Other(path, \"Argument list too long\", 7);\n  }\n  if (e == 8) {\n    return Other(path, \"Exec format error\", 8);\n  }\n  if (e == 9) {\n    return Other(path, \"Bad file descriptor\", 9);\n  }\n  if (e == 10) {\n    return Other(path, \"No child processes\", 10);\n  }\n  if (e == 11) {\n    return Other(path, \"Resource temporarily unavailable\", 11);\n  }\n  if (e == 12) {\n    return Other(path, \"Cannot allocate memory\", 12);\n  }\n  if (e == 14) {\n    return Other(path, \"Bad address\", 14);\n  }\n  if (e == 16) {\n    return Other(path, \"Device or resource busy\", 16);\n  }\n  if (e == 18) {\n    return Other(path, \"Invalid cross-device link\", 18);\n  }\n  if (e == 19) {\n    return Other(path, \"No such device\", 19);\n  }\n  if (e == 20) {\n    return Other(path, \"Not a directory\", 20);\n  }\n  if (e == 21) {\n    return Other(path, \"Is a directory\", 21);\n  }\n  if (e == 22) {\n    return Other(path, \"Invalid argument\", 22);\n  }\n  if (e == 23) {\n    return Other(path, \"Too many open files in system\", 23);\n  }\n  if (e == 24) {\n    return Other(path, \"Too many open files\", 24);\n  }\n  if (e == 25) {\n    return Other(path, \"Inappropriate ioctl for device\", 25);\n  }\n  if (e == 26) {\n    return Other(path, \"Text file busy\", 26);\n  }\n  if (e == 27) {\n    return Other(path, \"Fi