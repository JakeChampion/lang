rn Other(path, \"Network is unreachable\", 101);\n  }\n  if (e == 102) {\n    return Other(path, \"Network dropped connection on reset\", 102);\n  }\n  if (e == 103) {\n    return Other(path, \"Software caused connection abort\", 103);\n  }\n  if (e == 104) {\n    return Other(path, \"Connection reset by peer\", 104);\n  }\n  if (e == 105) {\n    return Other(path, \"No buffer space available\", 105);\n  }\n  if (e == 106) {\n    return Other(path, \"Transport endpoint is already connected\", 106);\n  }\n  if (e == 107) {\n    return Other(path, \"Transport endpoint is not connected\", 107);\n  }\n  if (e == 110) {\n    return Other(path, \"Connection timed out\", 110);\n  }\n  if (e == 111) {\n    return Other(path, \"Connection refused\", 111);\n  }\n  if (e == 113) {\n    return Other(path, \"No route to host\", 113);\n  }\n  if (e == 114) {\n    return Other(path, \"Operation already in progress\", 114);\n  }\n  if (e == 115) {\n    return Other(path, \"Operation now in progress\", 115);\n  }\n  if (e == 116) {\n    return Other(path, \"Stale file handle\", 116);\n  }\n  if (e == 122) {\n    return Other(path, \"Disk quota exceeded\", 122);\n  }\n  if (e == 125) {\n    return Other(path, \"Operation canceled\", 125);\n  }\n  if (e == 130) {\n    return Other(path, \"Owner died\", 130);\n  }\n  if (e == 131) {\n    return Other(path, \"State not recoverable\", 131);\n  }\n  let ndig: i32 = 1;\n  let tt: i32 = e;\n  while (tt >= 10) {\n    ndig = ndig + 1;\n    tt = tt / 10;\n  }\n  let total: i32 = 14 + ndig;\n  let buf: usize = __raw_alloc(total);\n  __raw_store8(buf, 0, 85);\n  __raw_store8(buf, 1, 110);\n  __raw_store8(buf, 2, 107);\n  __raw_store8(buf, 3, 110);\n  __raw_store8(buf, 4, 111);\n  __raw_store8(buf, 5, 119);\n  __raw_store8(buf, 6, 110);\n  __raw_store8(buf, 7, 32);\n  __raw_store8(buf, 8, 101);\n  __raw_store8(buf, 9, 114);\n  __raw_store8(buf, 10, 114);\n  __raw_store8(buf, 11, 111);\n  __raw_store8(buf, 12, 114);\n  __raw_store8(buf, 13, 32);\n  let pos: i32 = total - 1;\n  let v: i32 = e;\n  while (pos >= 14) {\n    __raw_store8(buf, pos, 48 + v % 10);\n    v = v / 10;\n    pos = pos - 1;\n  }\n  let unknown: string = __raw_string(buf, total);\n  return Other(path, unknown, 0);\n}\n",
    "function __fern_mount_devno(buf: usize, a: i32, b: i32): i64 {\n  let major: i64 = 0 as i64;\n  let minor: i64 = 0 as i64;\n  let i: i32 = a;\n  while (i < b && __raw_load8(buf, i) != 58) {\n    major = major * (10 as i64) + (__raw_load8(buf, i) - 48) as i64;\n    i = i + 1;\n  }\n  i = i + 1;\n  while (i < b) {\n    minor = minor * (10 as i64) + (__raw_load8(buf, i) - 48) as i64;\n    i = i + 1;\n  }\n  return minor & 255 as i64 | major << 8 as i64 | (minor & (0 - 256) as i64) << 12 as i64;\n}\n",
    "function __fern_mount_field(buf: usize, a: i32, b: i32): string {\n  let n: i32 = 0;\n  let i: i32 = a;\n  while (i < b) {\n    if (__fern_mount_octal(buf, i, b)) {\n      i = i + 4;\n    } else {\n      i = i + 1;\n    }\n    n = n + 1;\n  }\n  let p: usize = __raw_alloc(n);\n  let o: i32 = 0;\n  i = a;\n  while (i < b) {\n    if (__fern_mount_octal(buf, i, b)) {\n      __raw_store8(p, o, (__raw_load8(buf, i + 1) - 48) * 64 + (__raw_load8(buf, i + 2) - 48) * 8 + (__raw_load8(buf, i + 3) - 48));\n      i = i + 4;\n    } else {\n      __raw_store8(p, o, __raw_load8(buf, i));\n      i = i + 1;\n    }\n    o = o + 1;\n  }\n  return __raw_string(p, n);\n}\n",
    "function __fern_mount_octal(buf: usize, i: i32, b: i32): boolean {\n  if (i + 3 >= b || __raw_load8(buf, i) != 92) {\n    return false;\n  }\n  let k: i32 = 1;\n  while (k < 4) {\n    let c: i32 = __raw_load8(buf, i + k);\n    if (c < 48 || c > 55) {\n      return false;\n    }\n    k = k + 1;\n  }\n  return true;\n}\n",
    "function __fern_pipe_from(rc: i32, r: i32, w: i32): Result[Pipe, IoError] {\n  if (rc < 0) {\n    return Err(__fern_io_error(0 - rc, \"\"));\n  }\n  return Ok(Pipe { r: r, w: w });\n}\n",
    "function __fern_profile_name(pc: usize, im: usize, size: usize): usize {\n  if (im == 0 || size < 64) {\n    return 0;\n  }\n  let tab: usize = __load_i64(im + 40) as usize;\n  let ents: usize = __load_u8(im + 58) as usize;\n  ents = ents + (__load_u8(im + 59) as usize << 8);\n  let n: usize = __load_u8(im + 60) as usize;\n  n = n + (__load_u8(im + 61) as usize << 8);\n  if (ents < 64 || tab > size || n > (size - tab) / ents) {\n    return 0;\n  }\n  let k: usize = 0;\n  while (k < n) {\n    let sh: usize = im + tab + k * ents;\n    if (__load_i32(sh + 4) == 2) {\n      let off: usize = __load_i64(sh + 24) as usize;\n      let bytes: usize = __load_i64(sh + 32) as usize;\n      let link: usize = (__load_i32(sh + 40) as u32) as usize;\n      let step: usize = __load_i64(sh + 56) as usize;\n      if (off <= size && bytes <= size - off && step >= 24 && link < n) {\n        let st: usize = im + tab + link * ents;\n        let names: usize = __load_i64(st + 24) as usize;\n        let names_size: usize = __load_i64(st + 32) as usize;\n        let i: usize = 0;\n        while (i + step <= bytes && names <= size && names_size <= size - names) {\n          let sym: usize = im + off + i;\n          let addr: usize = __load_i64(sym + 8) as usize;\n          let len: usize = __load_i64(sym + 16) as usize;\n          let name: usize = (__load_i32(sym) as u32) as usize;\n          if ((__load_u8(sym + 4) & 15) == 2 && pc >= addr && pc - addr < len && name < names_size) {\n            let p: usize = im + names + name;\n            let end: usize = im + names + names_size;\n            let q: usize = p;\n            while (q < end && __load_u8(q) != 0) {\n              q = q + 1;\n            }\n            if (q < end) {\n              return p;\n            }\n          }\n          i = i + step;\n        }\n      }\n    }\n    k = k + 1;\n  }\n  return 0;\n}\n",
    "function __fern_ring_arm(blk: usize, ent: usize, fd: i32): i32 {\n  let m: i32 = __raw_load8(ent, 13);\n  if (m == 0) {\n    return 0;\n  }\n  let r: i32 = __fern_ring_push(blk, 6, fd, m, __fern_ring_ud(fd, __raw_load8(ent, 2)), 0);\n  if (r < 0) {\n    return r;\n  }\n  __raw_store8(ent, 1, 1);\n  return 0;\n}\n",
    "function __fern_ring_drop(blk: usize, ent: usize): i32 {\n  let pb: usize = __load_i64(blk + 160) as usize;\n  let h: i32 = __fern_ring_u16(ent, 8);\n  while (h != 0) {\n    let nxt: i32 = __fern_ring_u16(pb + 4096 + (h - 1) as usize * 8, 0);\n    __fern_ring_give(blk, h - 1);\n    h = nxt;\n  }\n  __fern_ring_set16(ent, 8, 0);\n  __fern_ring_set16(ent, 10, 0);\n  __raw_store8(ent, 15, 0);\n  __raw_store8(ent, 5, __raw_load8(ent, 5) + 1 & 255);\n  __raw_store8(ent, 6, 0);\n  __raw_store8(ent, 14, 0);\n  return 0;\n}\n",
    "function __fern_ring_emit(blk: usize, b: usize, cap: i32): i32 {\n  let rl: usize = __fern_ring_ready_at(blk);\n  let rc: i32 = __load_i32(blk + 184);\n  let n: i32 = 0;\n  let kept: i32 = 0;\n  let j: i32 = 0;\n  while (j < rc) {\n    let fd: i32 = __load_i32(rl + j as usize * 4);\n    let ent: usize = __fern_ring_entry(blk, fd);\n    j = j + 1;\n    if (n >= cap) {\n      __store_i32(rl + kept as usize * 4, fd);\n      kept = kept + 1;\n    } else {\n      kept = __fern_ring_emit_one(blk, ent, fd, b, cap, n, rl, kept);\n      n = __load_i32(blk + 188);\n    }\n  }\n  __store_i32(blk + 184, kept);\n  return n;\n}\n",
    "function __fern_ring_enqueue(blk: usize, ent: usize, bid: i32, len: i32): i32 {\n  let pb: usize = __load_i64(blk + 160) as usize;\n  let meta: usize = pb + 4096 + bid as usize * 8;\n  __fern_ring_set16(meta, 0, 0);\n  __fern_ring_set16(meta, 2, len);\n  __fern_ring_set16(meta, 4, 0);\n  let t: i32 = __fern_ring_u16(ent, 10);\n  if (t == 0) {\n    __fern_ring_set16(ent, 8, bid + 1);\n  } else {\n    __fern_ring_set16(pb + 4096 + (t - 1) as usize * 8, 0, bid + 1);\n  }\n  __fern_ring_set16(ent, 10, bid + 1);\n  __raw_store8(ent, 15, __raw_load8(ent, 15) + 1);\n  __store_i32(blk + 180, __load_i32(blk + 180) - 1);\n  return 0;\n}\n",
    "function __fern_ring_entry(blk: usize, fd: i32): usize {\n  return blk + 4096 + __load_i32(blk + 112) as usize * 8 + fd as usize * 16;\n}\n",
    "function __fern_ring_fall_back(blk: usize, ent: usize, fd: i32): i32 {\n  let s: i32 = __fern_ring_recv_stop(blk, ent, fd);\n  if (s < 0) {\n    return s;\n  }\n  __raw_store8(ent, 4, 5);\n  if ((__raw_load8(ent, 13) & 1) == 0) {\n    let un: i32 = __fern_ring_unarm(blk, ent, fd);\n    if (un < 0) {\n      return un;\n    }\n    __raw_store8(ent, 13, __raw_load8(ent, 13) | 1);\n    return __fern_ring_arm(blk, ent, fd);\n  }\n  return 0;\n}\n",
    "function __fern_ring_flush(blk: usize): i32 {\n  let queued: i32 = __fern_ring_queued(blk);\n  if (queued == 0) {\n    return 0;\n  }\n  return __syscall6(426, __load_i32(blk) as i64, queued as i64, 0, 0, 0, 0) as i32;\n}\n",
    "function __fern_ring_give(blk: usize, bid: i32): i32 {\n  let pb: usize = __load_i64(blk + 160) as usize;\n  let tail: i32 = __load_i32(blk + 176);\n  let e: usize = pb + (tail & 255) as usize * 16;\n  __store_i64(e, (pb + 8192 + bid as usize * 4096) as i64);\n  __store_i32(e + 8, 4096);\n  __fern_ring_set16(e, 12, bid);\n  tail = tail + 1 & 65535;\n  __store_i32(blk + 176, tail);\n  __fern_ring_set16(pb, 14, tail);\n  __store_i32(blk + 180, __load_i32(blk + 180) + 1);\n  return 0;\n}\n",
    "function __fern_ring_has_ready(blk: usize): boolean {\n  let ready: usize = __fern_ring_ready_at(blk);\n  let count: i32 = __load_i32(blk + 184);\n  let i: i32 = 0;\n  while (i < count) {\n    let fd: i32 = __load_i32(ready + i as usize * 4);\n    let ent: usize = __fern_ring_entry(blk, fd);\n    let interest: i32 = __raw_load8(ent, 0);\n    if (interest != 0) {\n      if (__raw_load8(ent, 14) != 0) {\n        return true;\n      }\n      let ended: i32 = __raw_load8(ent, 6);\n      if ((interest & 1) != 0 && (__fern_ring_u16(ent, 8) != 0 || ended == 1 || ended == 2)) {\n        return true;\n      }\n    }\n    i = i + 1;\n  }\n  return false;\n}\n",
    "function __fern_ring_list(blk: usize, ent: usize, fd: i32): i32 {\n  if (__raw_load8(ent, 12) != 0) {\n    return 0;\n  }\n  let rc: i32 = __load_i32(blk + 184);\n  __store_i32(__fern_ring_ready_at(blk) + rc as usize * 4, fd);\n  __store_i32(blk + 184, rc + 1);\n  __raw_store8(ent, 12, 1);\n  return 0;\n}\n",
    "function __fern_ring_pend(blk: usize, fd: i32): i32 {\n  let np: i32 = __load_i32(blk + 72);\n  if (np >= __load_i32(blk + 112) * 2) {\n    return 0 - 16;\n  }\n  __store_i32(blk + 4096 + np as usize * 4, fd);\n  __store_i32(blk + 72, np + 1);\n  return 0;\n}\n",
