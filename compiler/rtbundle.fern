    "function __fern_bytes_append_back(own a: i32[], dist: i32, n: i32): i32[] {\n  let len = a.len();\n  if (n > 0 && dist >= 8 && dist <= len && __FERN_RUNTIME_REUSE && __load_i32(__raw_arr_ptr(a) - 8) == 1) {\n    let total: i64 = len as i64 + n as i64;\n    if (total <= 2147483647i64 && total + 8i64 <= __load_i64(__raw_arr_ptr(a) - 16) * 8i64) {\n      let base: usize = __raw_arr_ptr(a) + 8;\n      let p: usize = base + len;\n      let end: usize = base + total as i32;\n      let q: usize = p - dist;\n      while (p < end) {\n        __store_i64(p, __load_i64(q));\n        p = p + 8;\n        q = q + 8;\n      }\n      __store_i64(__raw_arr_ptr(a), total);\n      return a;\n    }\n  }\n  return __fern_bytes_append_back_slow(a, dist, n);\n}\n",
    "@noinline\nfunction __fern_bytes_append_back_slow(own a: i32[], dist: i32, n: i32): i32[] {\n  if (n <= 0) {\n    return a;\n  }\n  let len = a.len();\n  if (dist < 1 || dist > len) {\n    __fern_oob_abort();\n  }\n  let total64: i64 = len as i64 + n as i64;\n  if (total64 > 2147483647i64) {\n    return __raw_array(__raw_arr_box(0 - 1));\n  }\n  let cap: i64 = __load_i64(__raw_arr_ptr(a) - 16);\n  let reuse = __FERN_RUNTIME_REUSE && __load_i32(__raw_arr_ptr(a) - 8) == 1 && total64 + 8i64 <= cap * 8i64;\n  let out = a;\n  if (!reuse) {\n    let words: i64 = cap;\n    if (words < 4i64) {\n      words = 4i64;\n    }\n    while (words * 8i64 < total64 + 8i64) {\n      words = words * 2i64;\n    }\n    out = __fern_bytes_clone(out, words as i32);\n  }\n  let base: usize = __raw_arr_ptr(out) + 8;\n  let at = len;\n  let total = total64 as i32;\n  let step = dist;\n  if (dist < 8) {\n    while (step < 8) {\n      step = step + dist;\n    }\n    let stop = len + step;\n    if (stop > total) {\n      stop = total;\n    }\n    while (at < stop) {\n      __store_u8(base + at, __load_u8(base + at - dist));\n      at = at + 1;\n    }\n  }\n  while (at < total) {\n    __store_i64(base + at, __load_i64(base + at - step));\n    at = at + 8;\n  }\n  __store_i64(__raw_arr_ptr(out), total64);\n  return out;\n}\n",
    "function __fern_bytes_append_range(own a: i32[], src: i32[], from: i32, n: i32): i32[] {\n  if (n <= 0) {\n    return a;\n  }\n  if (from as u32 > src.len() as u32 || n > src.len() - from) {\n    __fern_oob_abort();\n  }\n  let len = a.len();\n  let total64: i64 = len as i64 + n as i64;\n  if (total64 > 2147483647i64) {\n    return __raw_array(__raw_arr_box(0 - 1));\n  }\n  let cap: i64 = __load_i64(__raw_arr_ptr(a) - 16);\n  let reuse = __FERN_RUNTIME_REUSE && __load_i32(__raw_arr_ptr(a) - 8) == 1 && total64 <= cap * 8i64;\n  let out = a;\n  if (!reuse) {\n    let words: i64 = cap;\n    if (words < 4i64) {\n      words = 4i64;\n    }\n    while (words * 8i64 < total64) {\n      words = words * 2i64;\n    }\n    out = __fern_bytes_clone(out, words as i32);\n  }\n  __memcpy(__raw_arr_ptr(out) + 8 + len, __raw_arr_ptr(src) + 8 + from, n);\n  __store_i64(__raw_arr_ptr(out), total64);\n  return out;\n}\n",
    "@noinline\nfunction __fern_bytes_clone(a: i32[], words: i32): i32[] {\n  let p: usize = __raw_arr_box(words);\n  __memcpy(p + 8, __raw_arr_ptr(a) + 8, a.len());\n  __store_i64(p, a.len() as i64);\n  return __raw_array(p);\n}\n",
    "function __fern_bytes_into(n: i32, from: i32, src: usize, at: i32, dst: usize): i32[] {\n  let sn: i32 = 0;\n  let sp: usize = 0;\n  if ((src as i32 & 2) != 0) {\n    let base: usize = src - 2;\n    sn = __load_i32(base + 8);\n    sp = __raw_load_ptr(base, 0);\n  } else {\n    sn = __load_i32(src);\n    sp = src + 8;\n  }\n  let dn: i32 = __load_i32(dst);\n  if (n < 0 || at < 0 || from < 0 || at > dn - n || from > sn - n) {\n    __fern_slice_abort();\n  }\n  if (n == 0) {\n    return __raw_array(dst);\n  }\n  let d: usize = dst;\n  if (__fern_rc_is_unique(d) == 0) {\n    let b: usize = __raw_arr_box((dn + 7) / 8);\n    __store_i64(b, dn as i64);\n    __memcpy(b + 8, d + 8, dn);\n    __fern_rc_dec(d);\n    d = b;\n  }\n  __memcpy(d + 8 + at, sp + from, n);\n  return __raw_array(d);\n}\n",
    "function __fern_bytes_owned(bytes: usize): i32[] {\n  let n: i32 = 0;\n  let p: usize = 0;\n  if ((bytes as i32 & 2) != 0) {\n    let base: usize = bytes - 2;\n    n = __load_i32(base + 8);\n    p = __raw_load_ptr(base, 0);\n  } else {\n    n = __load_i32(bytes);\n    p = bytes + 8;\n  }\n  if (n == 0) {\n    return [];\n  }\n  let b: usize = __raw_arr_box((n + 7) / 8);\n  __store_i64(b, n as i64);\n  __memcpy(b + 8, p, n);\n  return __raw_array(b);\n}\n",
    "function __fern_bytes_range(to: i32, from: i32, bytes: usize): i32[] {\n  let n: i32 = 0;\n  let p: usize = 0;\n  if ((bytes as i32 & 2) != 0) {\n    let base: usize = bytes - 2;\n    n = __load_i32(base + 8);\n    p = __raw_load_ptr(base, 0);\n  } else {\n    n = __load_i32(bytes);\n    p = bytes + 8;\n  }\n  if (from < 0 || to < from || to > n) {\n    __fern_slice_abort();\n  }\n  let m: i32 = to - from;\n  if (m == 0) {\n    return [];\n  }\n  let b: usize = __raw_arr_box((m + 7) / 8);\n  __store_i64(b, m as i64);\n  __memcpy(b + 8, p + from, m);\n  return __raw_array(b);\n}\n",
    "function __fern_bytes_write_range(own a: i32[], at: i32, src: i32[], from: i32, n: i32): i32[] {\n  if (n <= 0) {\n    return a;\n  }\n  if (from as u32 > src.len() as u32 || n > src.len() - from) {\n    __fern_oob_abort();\n  }\n  if (at as u32 > a.len() as u32 || n > a.len() - at) {\n    __fern_oob_abort();\n  }\n  let reuse = __FERN_RUNTIME_REUSE && __load_i32(__raw_arr_ptr(a) - 8) == 1;\n  let out = a;\n  if (!reuse) {\n    out = __fern_bytes_clone(out, __load_i64(__raw_arr_ptr(out) - 16) as i32);\n  }\n  __memcpy(__raw_arr_ptr(out) + 8 + at, __raw_arr_ptr(src) + 8 + from, n);\n  return out;\n}\n",
    "function __fern_ct_mark(bytes: usize, req: i64): i32 {\n  let n: i32 = 0;\n  let p: usize = 0;\n  if ((bytes as i32 & 2) != 0) {\n    let base: usize = bytes - 2;\n    n = __load_i32(base + 8);\n    p = __raw_load_ptr(base, 0);\n  } else {\n    n = __load_i32(bytes);\n    p = bytes + 8;\n  }\n  let a: usize = __raw_scratch(48);\n  __store_i64(a, req);\n  __store_i64(a + 8, p as i64);\n  __store_i64(a + 16, n as i64);\n  __store_i64(a + 24, 0 as i64);\n  __store_i64(a + 32, 0 as i64);\n  __store_i64(a + 40, 0 as i64);\n  return __raw_vg_request(a) as i32;\n}\n",
    "function __fern_ct_public(bytes: usize): i32 {\n  return __fern_ct_mark(bytes, 1296236546 as i64);\n}\n",
