    "function __fern_reader_short_bytes(scratch: i32[], got: i32): i32[] {\n  let short: usize = __raw_arr_box(got / 8 + 1);\n  __memcpy(short + 8, __raw_arr_ptr(scratch) + 8, got);\n  __store_i64(short, got as i64);\n  return __raw_array(short);\n}\n",
    "function __fern_str_arr_free(p: usize): void {\n  if (p >= 65536 as usize && __load_i32(p - 8) == 1) {\n    let n: i32 = __load_i32(p);\n    let i: i32 = 0;\n    while (i < n) {\n      __fern_str_free(__raw_load_ptr(p, i + 1));\n      i = i + 1;\n    }\n  }\n  __fern_rc_dec(p);\n}\n",
    "function __fern_str_bytes(s: string): i32[] {\n  let n: i32 = s.len();\n  let b: usize = __raw_arr_box(n);\n  let i: i32 = 0;\n  while (i < n) {\n    __raw_store_ptr(b, i + 1, s[i] as usize);\n    i = i + 1;\n  }\n  return __raw_array(b);\n}\n",
    "function __fern_str_bytes_u8(s: string): i32[] {\n  let n: i32 = s.len();\n  let b: usize = __raw_arr_box(((n as i64 + 7) / 8) as i32);\n  __store_i64(b, n as i64);\n  __memcpy(b + 8, __raw_data(s), n);\n  return __raw_array(b);\n}\n",
    "function __fern_str_cmp(a: string, b: string): i32 {\n  let la: i32 = a.len();\n  let lb: i32 = b.len();\n  let n: i32 = la;\n  if (lb < n) {\n    n = lb;\n  }\n  let dl: i32 = la - lb;\n  let p: usize = __raw_data(a);\n  let q: usize = __raw_data(b);\n  let end: usize = p + n;\n  while (p + 8 <= end) {\n    let x: i64 = __load_i64(p) ^ __load_i64(q);\n    if (x != 0 as i64) {\n      let k: i32 = __ctz64(x as u64) >> 3;\n      return __load_u8(p + k) - __load_u8(q + k);\n    }\n    p = p + 8;\n    q = q + 8;\n  }\n  while (p < end) {\n    let ca: i32 = __load_u8(p);\n    let cb: i32 = __load_u8(q);\n    if (ca != cb) {\n      return ca - cb;\n    }\n    p = p + 1;\n    q = q + 1;\n  }\n  return dl;\n}\n",
    "function __fern_str_concat(a: string, b: string): string {\n  let la: i32 = a.len();\n  let lb: i32 = b.len();\n  let p: usize = __raw_alloc(la + lb);\n  __memcpy(p, __raw_data(a), la);\n  __memcpy(p + la, __raw_data(b), lb);\n  return __raw_string(p, la + lb);\n}\n",
    "function __fern_str_dup(h: string): string {\n  let n: i32 = h.len();\n  if (n == 0) {\n    return \"\";\n  }\n  let p: usize = __raw_alloc(n);\n  __memcpy(p, __raw_data(h), n);\n  return __raw_string(p, n);\n}\n",
    "function __fern_str_lines(s: string): string[] {\n  let out: string[] = [];\n  let sl: i32 = s.len();\n  let start: i32 = 0;\n  let i: i32 = 0;\n  while (i < sl) {\n    if (s[i] == 10) {\n      let end: i32 = i;\n      if (end > start) {\n        if (s[end - 1] == 13) {\n          end = end - 1;\n        }\n      }\n      out = out.append(slice_unchecked(s, start, end) + \"\");\n      start = i + 1;\n    }\n    i = i + 1;\n  }\n  if (start < sl) {\n    let tail: i32 = sl;\n    if (s[tail - 1] == 13) {\n      tail = tail - 1;\n    }\n    out = out.append(slice_unchecked(s, start, tail) + \"\");\n  }\n  return out;\n}\n",
    "function __fern_str_repeat(s: string, n: i32): string {\n  let slen: i32 = s.len();\n  let count: i32 = n;\n  if (count < 0) {\n    count = 0;\n  }\n  let total64: i64 = slen as i64 * (count as i64);\n  let total: i32 = total64 as i32;\n  if (total64 > 2147483647) {\n    total = 0 - 1;\n  }\n  if (total == 0) {\n    return \"\";\n  }\n  let p: usize = __raw_alloc(total);\n  let w: i32 = 0;\n  let k: i32 = 0;\n  while (k < count) {\n    let j: i32 = 0;\n    while (j < slen) {\n      __raw_store8(p, w, s[j] as i32);\n      w = w + 1;\n      j = j + 1;\n    }\n    k = k + 1;\n  }\n  return __raw_string(p, total);\n}\n",
    "function __fern_str_replace(h: string, o: string, nw: string): string {\n  let lenH: i32 = h.len();\n  let lenO: i32 = o.len();\n  if (lenO == 0) {\n    return __fern_str_dup(h);\n  }\n  let lenN: i32 = nw.len();\n  let count: i32 = 0;\n  let i: i32 = 0;\n  while (i + lenO <= lenH) {\n    let j: i32 = 0;\n    let m: i32 = 1;\n    while (j < lenO) {\n      if (h[i + j] != o[j]) {\n        m = 0;\n        j = lenO;\n      } else {\n        j = j + 1;\n      }\n    }\n    if (m == 1) {\n      count = count + 1;\n      i = i + lenO;\n    } else {\n      i = i + 1;\n    }\n  }\n  if (count == 0) {\n    return __fern_str_dup(h);\n  }\n  let total64: i64 = lenH as i64 + count as i64 * (lenN as i64 - lenO as i64);\n  let total: i32 = total64 as i32;\n  if (total64 > 2147483647) {\n    total = 0 - 1;\n  }\n  if (total == 0) {\n    return \"\";\n  }\n  let p: usize = __raw_alloc(total);\n  let w: i32 = 0;\n  let k: i32 = 0;\n  while (k < lenH) {\n    let m2: i32 = 0;\n    if (k + lenO <= lenH) {\n      let jj: i32 = 0;\n      m2 = 1;\n      while (jj < lenO) {\n        if (h[k + jj] != o[jj]) {\n          m2 = 0;\n          jj = lenO;\n        } else {\n          jj = jj + 1;\n        }\n      }\n    }\n    if (m2 == 1) {\n      let t: i32 = 0;\n      while (t < lenN) {\n        __raw_store8(p, w, nw[t] as i32);\n        w = w + 1;\n        t = t + 1;\n      }\n      k = k + lenO;\n    } else {\n      __raw_store8(p, w, h[k] as i32);\n      w = w + 1;\n      k = k + 1;\n    }\n  }\n  return __raw_string(p, total);\n}\n",
    "function __fern_str_split(s: string, sep: string): string[] {\n  let lenS: i32 = s.len();\n  let lenSep: i32 = sep.len();\n  let out: string[] = [];\n  if (lenSep == 0) {\n    let k: i32 = 0;\n    while (k < lenS) {\n      let w: i32 = __fern_utf8_step(s, k, lenS);\n      out = out.append(slice_unchecked(s, k, k + w) + \"\");\n      k = k + w;\n    }\n    return out;\n  }\n  let start: i32 = 0;\n  let i: i32 = 0;\n  while (i + lenSep <= lenS) {\n    let j: i32 = 0;\n    let m: i32 = 1;\n    while (j < lenSep) {\n      if (s[i + j] != sep[j]) {\n        m = 0;\n        j = lenSep;\n      } else {\n        j = j + 1;\n      }\n    }\n    if (m == 1) {\n      out = out.append(slice_unchecked(s, start, i) + \"\");\n      i = i + lenSep;\n      start = i;\n    } else {\n      i = i + 1;\n    }\n  }\n  out = out.append(slice_unchecked(s, start, lenS) + \"\");\n  return out;\n}\n",
    "function __fern_str_to_lower(s: string): string {\n  let n: i32 = s.len();\n  let p: usize = __raw_alloc(n);\n  let i: i32 = 0;\n  while (i < n) {\n    let c: i32 = s[i] as i32;\n    if (c >= 65) {\n      if (c <= 90) {\n        c = c + 32;\n      }\n    }\n    __raw_store8(p, i, c);\n    i = i + 1;\n  }\n  return __raw_string(p, n);\n}\n",
    "function __fern_str_to_upper(s: string): string {\n  let n: i32 = s.len();\n  let p: usize = __raw_alloc(n);\n  let i: i32 = 0;\n  while (i < n) {\n    let c: i32 = s[i] as i32;\n    if (c >= 97) {\n      if (c <= 122) {\n        c = c - 32;\n      }\n    }\n    __raw_store8(p, i, c);\n    i = i + 1;\n  }\n  return __raw_string(p, n);\n}\n",
    "function __fern_str_trim(s: string): string {\n  let n: i32 = s.len();\n  let start: i32 = 0;\n  let go: i32 = 1;\n  while (go == 1) {\n    if (start >= n) {\n      go = 0;\n    } else {\n      let c: i32 = s[start] as i32;\n      if (c == 32 || c >= 9 && c <= 13) {\n        start = start + 1;\n      } else {\n        go = 0;\n      }\n    }\n  }\n  let end: i32 = n;\n  let go2: i32 = 1;\n  while (go2 == 1) {\n    if (end <= start) {\n      go2 = 0;\n    } else {\n      let c2: i32 = s[end - 1] as i32;\n      if (c2 == 32 || c2 >= 9 && c2 <= 13) {\n        end = end - 1;\n      } else {\n        go2 = 0;\n      }\n    }\n  }\n  return slice_unchecked(s, start, end) + \"\";\n}\n",
    "function __fern_string_from_bytes(a: i32[]): string {\n  let n: i32 = a.len();\n  let p: usize = __raw_alloc(n);\n  let i: i32 = 0;\n  while (i < n) {\n    __raw_store8(p, i, a[i]);\n    i = i + 1;\n  }\n  return __raw_string(p, n);\n}\n",
    "function __fern_string_from_bytes_range_u8(a: i32[], from: i32, end: i32): string {\n  let n: i32 = a.len();\n  let bad: i32 = 0;\n  if (end < 0) {\n    bad = 1;\n  }\n  if (end > n) {\n    bad = 1;\n  }\n  if (from < 0) {\n    bad = 1;\n  }\n  if (from > end) {\n    bad = 1;\n  }\n  if (bad == 1) {\n    __fern_slice_abort();\n  }\n  let m: i32 = end - from;\n  let p: usize = __raw_alloc(m);\n  __memcpy(p, __raw_arr_ptr(a) + 8 + from, m);\n  return __raw_string(p, m);\n}\n",
    "function __fern_string_from_bytes_u8(a: i32[]): string {\n  let n: i32 = a.len();\n  let p: usize = __raw_alloc(n);\n  __memcpy(p, __raw_arr_ptr(a) + 8, n);\n  return __raw_string(p, n);\n}\n",
    "function __fern_task_blank(): usize {\n  let rec: usize = __alloc(96);\n  let w: i32 = 0;\n  while (w < 12) {\n    __raw_store_ptr(rec, w, 0 as usize);\n    w = w + 1;\n  }\n  return rec;\n}\n",
    "function __fern_task_cancelled(): i32 {\n  let st: usize = __raw_task_state();\n  let id: i32 = __raw_load_ptr(st, 0) as i32;\n  if (id == 0) {\n    return 0;\n  }\n  let rec: usize = __raw_load_ptr(st, 3);\n  return __raw_load_ptr(rec, 3) as i32;\n}\n",
    "function __fern_task_cur(): i32 {\n  let st: usize = __raw_task_state();\n  return __raw_load_ptr(st, 0) as i32;\n}\n",
    "function __fern_task_enter(id: i32, mode: i32): i32 {\n  let st: usize = __raw_task_state();\n  let prev: usize = __raw_load_ptr(st, 0);\n  __raw_store_ptr(st, 0, id as usize);\n  let rec: usize = __fern_task_rec(id);\n  __raw_store_ptr(rec, 0, mode as usize);\n  __raw_store_ptr(rec, 11, prev);\n  __raw_store_ptr(st, 3, rec);\n  return 0;\n}\n",
    "function __fern_task_free(id: i32): i32 {\n  let rec: usize = __fern_task_rec(id);\n  if (rec != 0 as usize && __raw_load_ptr(rec, 7) == 0 as usize) {\n    let st: usize = __raw_task_state();\n    __raw_store_ptr(rec, 7, __raw_load_ptr(st, 4) + 1 as usize);\n    __raw_store_ptr(st, 4, id as usize);\n  }\n  return 0;\n}\n",
    "function __fern_task_leave(): i32 {\n  let st: usize = __raw_task_state();\n  let id: i32 = __raw_load_ptr(st, 0) as i32;\n  if (id == 0) {\n    return 0;\n  }\n  let rec: usize = __raw_load_ptr(st, 3);\n  let prev: i32 = __raw_load_ptr(rec, 11) as i32;\n  __raw_store_ptr(st, 0, prev as usize);\n  let outer: usize = 0 as usize;\n  if (prev != 0) {\n    outer = __fern_task_rec(prev);\n  }\n  __raw_store_ptr(st, 3, outer);\n  return __raw_load_ptr(rec, 0) as i32;\n}\n",
    "function __fern_task_mode(): i32 {\n  let st: usize = __raw_task_state();\n  let id: i32 = __raw_load_ptr(st, 0) as i32;\n  if (id == 0) {\n    return 0;\n  }\n  let rec: usize = __raw_load_ptr(st, 3);\n  return __raw_load_ptr(rec, 0) as i32;\n}\n",
    "function __fern_task_new(): i32 {\n  let st: usize = __raw_task_state();\n  let tab: usize = __fern_task_tab();\n  let id: i32 = __raw_load_ptr(st, 4) as i32;\n  if (id != 0) {\n    let rec: usize = __raw_load_ptr(tab, id);\n    __raw_store_ptr(st, 4, __raw_load_ptr(rec, 7) - 1 as usize);\n    __raw_store_ptr(rec, 7, 0 as usize);\n    __raw_store_ptr(rec, 0, 0 as usize);\n    __raw_store_ptr(rec, 1, 0 as usize);\n    __raw_store_ptr(rec, 2, 0 as usize);\n    __raw_store_ptr(rec, 3, 0 as usize);\n    __raw_store_ptr(rec, 5, 0 as usize);\n    __raw_store_ptr(rec, 9, 0 as usize);\n    return id;\n  }\n  let cap: i32 = __raw_load_ptr(st, 2) as i32;\n  id = __raw_load_ptr(st, 5) as i32;\n  if (id == 0) {\n    id = 1;\n  }\n  __raw_store_ptr(st, 5, (id + 1) as usize);\n  if (id < cap) {\n    __raw_store_ptr(tab, id, __fern_task_blank());\n    return id;\n  }\n  let ntab: usize = __alloc(cap * 16);\n  let j: i32 = 0;\n  while (j < cap * 2) {\n    let v: usize = 0 as usize;\n    if (j < cap) {\n      v = __raw_load_ptr(tab, j);\n    }\n    __raw_store_ptr(ntab, j, v);\n    j = j + 1;\n  }\n  __free(tab, cap * 8);\n  __raw_store_ptr(st, 1, ntab);\n  __raw_store_ptr(st, 2, (cap * 2) as usize);\n  __raw_store_ptr(ntab, cap, __fern_task_blank());\n  return cap;\n}\n",
    "function __fern_task_park(set: i32[], timeout_ms: i32): i32 {\n  let st: usize = __raw_task_state();\n  let id: i32 = __raw_load_ptr(st, 0) as i32;\n  if (id == 0) {\n    return 0 - 1;\n  }\n  let rec: usize = __raw_load_ptr(st, 3);\n  let mode: i32 = __raw_load_ptr(rec, 0) as i32;\n  if (mode == 2) {\n    __raw_store_ptr(rec, 0, 0 as usize);\n    if (__raw_load_ptr(rec, 3) != 0 as usize) {\n      return 0 - 2;\n    }\n    return __raw_load_ptr(rec, 2) as i32;\n  }\n  if (__raw_load_ptr(rec, 3) != 0 as usize) {\n    return 0 - 2;\n  }\n  __raw_store_ptr(rec, 0, 1 as usize);\n  __raw_store_ptr(rec, 1, timeout_ms as usize);\n  let n: i32 = set.len();\n  let buf: usize = __raw_load_ptr(rec, 8);\n  if (n > __raw_load_ptr(rec, 10) as i32) {\n    if (buf != 0 as usize) {\n      __free(buf, __raw_load_ptr(rec, 10) as i32 * 8);\n    }\n    buf = __alloc(n * 8);\n    __raw_store_ptr(rec, 8, buf);\n    __raw_store_ptr(rec, 10, n as usize);\n  }\n  let i: i32 = 0;\n  while (i < n) {\n    __raw_store_ptr(buf, i, set[i] as usize);\n    i = i + 1;\n  }\n  __raw_store_ptr(rec, 9, n as usize);\n  return 0;\n}\n",
    "function __fern_task_pop_w(): usize {\n  let st: usize = __raw_task_state();\n  let rec: usize = __raw_load_ptr(st, 3);\n  let len: i32 = __raw_load_ptr(rec, 5) as i32 - 1;\n  __raw_store_ptr(rec, 5, len as usize);\n  let buf: usize = __raw_load_ptr(rec, 4);\n  return __raw_load_ptr(buf, len);\n}\n",
    "function __fern_task_rec(id: i32): usize {\n  let tab: usize = __fern_task_tab();\n  return __raw_load_ptr(tab, id);\n}\n",
    "function __fern_task_reserve(n: i32): usize {\n  let st: usize = __raw_task_state();\n  let rec: usize = __raw_load_ptr(st, 3);\n  let len: i32 = __raw_load_ptr(rec, 5) as i32;\n  let cap: i32 = __raw_load_ptr(rec, 6) as i32;\n  let buf: usize = __raw_load_ptr(rec, 4);\n  if (len + n > cap) {\n    let ncap: i32 = 64;\n    if (cap > 0) {\n      ncap = cap * 2;\n    }\n    while (ncap < len + n) {\n      ncap = ncap * 2;\n    }\n    let nbuf: usize = __alloc(ncap * 8);\n    if (buf != 0 as usize) {\n      __memcpy(nbuf, buf, len * 8);\n      __free(buf, cap * 8);\n    }\n    buf = nbuf;\n    __raw_store_ptr(rec, 4, buf);\n    __raw_store_ptr(rec, 6, ncap as usize);\n  }\n  __raw_store_ptr(rec, 5, (len + n) as usize);\n  return buf + (len * 8) as usize;\n}\n",
    "function __fern_task_set_cancelled(id: i32): i32 {\n  let rec: usize = __fern_task_rec(id);\n  __raw_store_ptr(rec, 3, 1 as usize);\n  return 0;\n}\n",
    "function __fern_task_set_ready(id: i32, w: i32): i32 {\n  let rec: usize = __fern_task_rec(id);\n  __raw_store_ptr(rec, 2, w as usize);\n  return 0;\n}\n",
    "function __fern_task_tab(): usize {\n  let st: usize = __raw_task_state();\n  let tab: usize = __raw_load_ptr(st, 1);\n  if (tab == 0 as usize) {\n    tab = __alloc(512);\n    let i: i32 = 0;\n    while (i < 64) {\n      __raw_store_ptr(tab, i, 0 as usize);\n      i = i + 1;\n    }\n    __raw_store_ptr(st, 1, tab);\n    __raw_store_ptr(st, 2, 64 as usize);\n  }\n  return tab;\n}\n",
    "function __fern_task_take(n: i32): usize {\n  let st: usize = __raw_task_state();\n  let rec: usize = __raw_load_ptr(st, 3);\n  let len: i32 = __raw_load_ptr(rec, 5) as i32 - n;\n  __raw_store_ptr(rec, 5, len as usize);\n  return __raw_load_ptr(rec, 4) + (len * 8) as usize;\n}\n",
    "function __fern_task_timeout(id: i32): i32 {\n  let rec: usize = __fern_task_rec(id);\n  return __raw_load_ptr(rec, 1) as i32;\n}\n",
    "function __fern_task_wait(id: i32): i32[] {\n  let rec: usize = __fern_task_rec(id);\n  let n: i32 = __raw_load_ptr(rec, 9) as i32;\n  let buf: usize = __raw_load_ptr(rec, 8);\n  let out: i32[] = [];\n  let i: i32 = 0;\n  while (i < n) {\n    out = out.append(__raw_load_ptr(buf, i) as i32);\n    i = i + 1;\n  }\n  return out;\n}\n",
    "function __fern_u32_to_string(n: i32): string {\n  let v: i64 = n as i64 & 4294967295 as i64;\n  if (v == 0 as i64) {\n    let z: usize = __raw_alloc(1);\n    __raw_store8(z, 0, 48);\n    return __raw_string(z, 1);\n  }\n  let nd: i32 = 0;\n  let t: i64 = v;\n  while (t > 0 as i64) {\n    nd = nd + 1;\n    t = t / (10 as i64);\n  }\n  let p: usize = __raw_alloc(nd);\n  let i: i32 = nd - 1;\n  while (v > 0 as i64) {\n    __raw_store8(p, i, 48 + (v % (10 as i64)) as i32);\n    v = v / (10 as i64);\n    i = i - 1;\n  }\n  return __raw_string(p, nd);\n}\n",
    "function __fern_u64_to_string(n: u64): string {\n  let v: u64 = n;\n  if (v == 0 as u64) {\n    let z: usize = __raw_alloc(1);\n    __raw_store8(z, 0, 48);\n    return __raw_string(z, 1);\n  }\n  let nd: i32 = 0;\n  let t: u64 = v;\n  while (t != 0 as u64) {\n    nd = nd + 1;\n    t = t / (10 as u64);\n  }\n  let p: usize = __raw_alloc(nd);\n  let i: i32 = nd - 1;\n  while (v != 0 as u64) {\n    __raw_store8(p, i, 48 + (v % (10 as u64)) as i32);\n    v = v / (10 as u64);\n    i = i - 1;\n  }\n  return __raw_string(p, nd);\n}\n",
    "function __fern_utf8_step(s: string, i: i32, n: i32): i32 {\n  let b0: i32 = s[i] as i32;\n  let want: i32 = 0;\n  if (b0 < 128) {\n    want = 1;\n  }\n  if (b0 >= 194 && b0 < 224) {\n    want = 2;\n  }\n  if (b0 >= 224 && b0 < 240) {\n    want = 3;\n  }\n  if (b0 >= 240 && b0 < 245) {\n    want = 4;\n  }\n  if (want <= 1) {\n    return 1;\n  }\n  if (i + 1 >= n) {\n    return 1;\n  }\n  let lo: i32 = 128;\n  if (b0 == 224) {\n    lo = 160;\n  }\n  if (b0 == 240) {\n    lo = 144;\n  }\n  let hi: i32 = 191;\n  if (b0 == 237) {\n    hi = 159;\n  }\n  if (b0 == 244) {\n    hi = 143;\n  }\n  let c1: i32 = s[i + 1] as i32;\n  if (c1 < lo) {\n    return 1;\n  }\n  if (c1 > hi) {\n    return 1;\n  }\n  let k2: i32 = 2;\n  while (k2 < want) {\n    if (i + k2 >= n) {\n      return k2;\n    }\n    let ck: i32 = s[i + k2] as i32;\n    if (ck < 128) {\n      return k2;\n    }\n    if (ck > 191) {\n      return k2;\n    }\n    k2 = k2 + 1;\n  }\n  return want;\n}\n",
    "function __fern_utf8_valid(buf: usize, n: i32): i32 {\n  let high: i64 = (0 - 9187201950435737472) as i64;\n  let retry: i32 = 0;\n  let vector: i32 = 1;\n  let i: i32 = 0;\n  while (i < n) {\n    if (vector == 1 && i >= 3) {\n      vector = 0;\n      i = __raw_utf8_blocks(buf, i, n);\n      if (i < 0) {\n        return 0;\n      }\n    }\n    if (i >= retry) {\n      let more: i32 = 1;\n      while (more == 1 && i + 32 <= n) {\n        let w: i64 = __load_i64(buf + i) | __load_i64(buf + i + 8) | __load_i64(buf + i + 16) | __load_i64(buf + i + 24);\n        if ((w & high) == 0 as i64) {\n          i = i + 32;\n        } else {\n          more = 0;\n        }\n      }\n      retry = i + 32;\n    }\n    let b0: i32 = 0;\n    if (i < n) {\n      b0 = __raw_load8(buf, i);\n    }\n    if (i >= n) {\n      i = n;\n    } else {\n      if (b0 < 128) {\n        i = i + 1;\n      } else {\n        if (b0 < 194) {\n          return 0;\n        }\n        if (b0 < 224) {\n          if (i + 2 > n) {\n            return 0;\n          }\n          let c1: i32 = __raw_load8(buf, i + 1);\n          if (c1 < 128) {\n            return 0;\n          }\n          if (c1 > 191) {\n            return 0;\n          }\n          i = i + 2;\n        } else {\n          if (b0 < 240) {\n            if (i + 3 > n) {\n              return 0;\n            }\n            let d1: i32 = __raw_load8(buf, i + 1);\n            let d2: i32 = __raw_load8(buf, i + 2);\n            if (d1 < 128) {\n              return 0;\n            }\n            if (d1 > 191) {\n              return 0;\n            }\n            if (d2 < 128) {\n              return 0;\n            }\n            if (d2 > 191) {\n              return 0;\n            }\n            if (b0 == 224) {\n              if (d1 < 160) {\n                return 0;\n              }\n            }\n            if (b0 == 237) {\n              if (d1 > 159) {\n                return 0;\n              }\n            }\n            i = i + 3;\