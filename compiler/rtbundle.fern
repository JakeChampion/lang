    "function __fern_profile_hex_buf(buf: usize, pc: usize): void {\n  let digits: string = \"0123456789abcdef\";\n  let i: i32 = 17;\n  while (i >= 2) {\n    __raw_store8(buf, i, __load_u8(__raw_data(digits) + (pc & 15)));\n    pc = pc >> 4;\n    i = i - 1;\n  }\n  __raw_store8(buf, 0, 48);\n  __raw_store8(buf, 1, 120);\n}\n",
