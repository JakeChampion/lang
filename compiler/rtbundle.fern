    "function __fern_open_dir(path: string): Result[i32, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let fd: i32 = __syscall3(257, -(100 as i64), pathz as i64, (65536 | 524288) as i64) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (fd < 0) {\n    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(fd);\n}\n",
    "function __fern_open_res(path: string, flags: i32, mode: i32): Result[i32, IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let f: i32 = flags | 524288;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  let fd: i32 = __syscall4(257, -100, pathz as i64, f as i64, mode as i64) as i32;\n  if (fd >= 0 && fd < 3) {\n    let moved: i32 = __syscall3(72, fd as i64, 0, 3) as i32;\n    __syscall3(3, fd as i64, 0, 0);\n    fd = moved;\n  }\n  if (fd < 0) {\n    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));\n  }\n  return Ok(fd);\n}\n",
    "function __fern_open_with(path: string, flags: i32, write: i32): Result[i32, IoError] {\n  let f: i32 = 0;\n  if (write != 0) {\n    f = 1;\n  }\n  if ((flags & 1) != 0) {\n    f = f | 64;\n  }\n  if ((flags & 2) != 0) {\n    f = f | 2048;\n  }\n  if ((flags & 4) != 0) {\n    f = f | 128;\n  }\n  if ((flags & 8) != 0) {\n    f = f | 16384;\n  }\n  if ((flags & 16) != 0) {\n    f = f | 65536;\n  }\n  if ((flags & 32) != 0) {\n    f = f | 4096;\n  }\n  if ((flags & 64) != 0) {\n    f = f | 1052672;\n  }\n  if ((flags & 128) != 0) {\n    f = f | 262144;\n  }\n  if ((flags & 256) != 0) {\n    f = f | 256;\n  }\n  if ((flags & 512) != 0) {\n    f = f | 131072;\n  }\n  return __fern_open_res(path, f, 438);\n}\n",
