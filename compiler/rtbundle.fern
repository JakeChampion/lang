    "function __fern_random_bytes(n: i32): i32[] {\n  if (n <= 0) {\n    let none: usize = __raw_arr_box(0);\n    return __raw_array(none);\n  }\n  let p: usize = __raw_alloc(n);\n  let off: i32 = 0;\n  while (off < n) {\n    let want: i32 = n - off;\n    if (want > 256) {\n      want = 256;\n    }\n    let r: i32 = __syscall3(278, (p + off) as i64, want as i64, 0) as i32;\n    if (r == 0 - 4) {\n      continue;\n    }\n    if (r <= 0 || r > want) {\n      __fern_rc_dec(p);\n      let msg: string = \"fern: entropy unavailable\\n\";\n      __syscall3(64, 2, __raw_data(msg) as i64, msg.len() as i64);\n      exit(134);\n    }\n    off = off + r;\n  }\n  let b: usize = __raw_arr_box(n);\n  let i: i32 = 0;\n  while (i < n) {\n    __raw_store_ptr(b, i + 1, __raw_load8(p, i) as usize);\n    i = i + 1;\n  }\n  let p_own: string = __raw_string(p, n);\n  return __raw_array(b);\n}\n",
    "function __fern_random_bytes_u8(n: i32): i32[] {\n  if (n < 0) {\n    n = 0;\n  }\n  let b: usize = __raw_arr_box(((n as i64 + 7) / 8) as i32);\n  __store_i64(b, n as i64);\n  let off: i32 = 0;\n  while (off < n) {\n    let want: i32 = n - off;\n    if (want > 256) {\n      want = 256;\n    }\n    let r: i32 = __syscall3(278, (b + 8 + off) as i64, want as i64, 0) as i32;\n    if (r == 0 - 4) {\n      continue;\n    }\n    if (r <= 0 || r > want) {\n      __fern_rc_dec(b);\n      let msg: string = \"fern: entropy unavailable\\n\";\n      __syscall3(64, 2, __raw_data(msg) as i64, msg.len() as i64);\n      exit(134);\n    }\n    off = off + r;\n  }\n  return __raw_array(b);\n}\n",
