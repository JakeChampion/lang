    "function __fern_reactor_new(): i32 {\n  return __syscall3(362, 0, 0, 0) as i32;\n}\n",
    "function __fern_reactor_wait(r_fd: i32, events: i32[], timeout_ms: i32): i32 {\n  let cap: i32 = events.len() / 2;\n  if (cap <= 0) {\n    return 0 - 22;\n  }\n  let b: usize = __raw_arr_ptr(events);\n  let buf: usize = b + 8;\n  let kcap: i32 = cap / 2;\n  let ts: usize = __raw_scratch(48);\n  let tmo: usize = 0 as usize;\n  if (kcap < 1) {\n    kcap = 1;\n    buf = ts + 16;\n  }\n  if (timeout_ms >= 0) {\n    __raw_store_ptr(ts, 0, (timeout_ms / 1000) as usize);\n    __raw_store_ptr(ts, 1, (timeout_ms % 1000 * 1000000) as usize);\n    tmo = ts;\n  }\n  let n: i32 = __syscall6(363, r_fd as i64, 0, 0, buf as i64, kcap as i64, tmo as i64) as i32;\n  let i: i32 = 0;\n  while (i < n) {\n    let e: i32 = i * 32;\n    let ready: i32 = 2;\n    if (__raw_load8(buf, e + 8) == 255) {\n      ready = 1;\n    }\n    if ((__raw_load8(buf, e + 11) & 192) != 0) {\n      ready = ready | 4;\n    }\n    let fd: i32 = __raw_load8(buf, e) | __raw_load8(buf, e + 1) << 8 | __raw_load8(buf, e + 2) << 16 | __raw_load8(buf, e + 3) << 24;\n    if (__raw_load8(buf, e + 8) == 250) {\n      ready = 1;\n      fd = 0 - fd;\n    }\n    if (__raw_load8(buf, e + 8) == 251) {\n      ready = 1;\n      fd = 0 - 15;\n    }\n    __raw_store_ptr(b, i * 2 + 1, fd as usize);\n    __raw_store_ptr(b, i * 2 + 2, ready as usize);\n    i = i + 1;\n  }\n  return n;\n}\n",
    "function __fern_read_dir(path: string): Result[string[], IoError] {\n  let plen: i32 = path.len();\n  let pathz: usize = __raw_alloc(plen + 1);\n  let i: i32 = 0;\n  while (i < plen) {\n    __raw_store8(pathz, i, path[i] as i32);\n    i = i + 1;\n  }\n  __raw_store8(pathz, plen, 0);\n  let fd: i32 = __syscall3(463, -2, pathz as i64, 1048576) as i32;\n  let pathz_own: string = __raw_string(pathz, plen + 1);\n  if (fd < 0) {\n    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));\n  }\n  let basep: usize = __raw_alloc(8);\n  let names: string[] = [];\n  let bad: i32 = 0;\n  let done: i32 = 0;\n  while (done == 0) {\n    let buf: usize = __raw_alloc(65536);\n    let n: i32 = __syscall4(344, fd as i64, buf as i64, 65536, basep as i64) as i32;\n    if (n <= 0) {\n      done = 1;\n      bad = n;\n    } else {\n      let pos: i32 = 0;\n      while (pos < n) {\n        let reclen: i32 = __raw_load8(buf, pos + 16) + __raw_load8(buf, pos + 17) * 256;\n        let nlen: i32 = __raw_load8(buf, pos + 18) + __raw_load8(buf, pos + 19) * 256;\n        if (__fern_utf8_valid(buf + pos + 21, nlen) == 0) {\n          bad = 0 - 92;\n          done = 1;\n          pos = n;\n        } else {\n          let skip: i32 = 0;\n          if (nlen == 1) {\n            if (__raw_load8(buf, pos + 21) == 46) {\n              skip = 1;\n            }\n          }\n          if (nlen == 2) {\n            if (__raw_load8(buf, pos + 21) == 46) {\n              if (__raw_load8(buf, pos + 21 + 1) == 46) {\n                skip = 1;\n              }\n            }\n          }\n          if (skip == 0) {\n            let nbuf: usize = __raw_alloc(nlen);\n            __memcpy(nbuf, buf + pos + 21, nlen);\n            names = names.append(__raw_string(nbuf, nlen));\n          }\n          pos = pos + reclen;\n        }\n      }\n    }\n    let buf_own: string = __raw_string(buf, 65536);\n  }\n  let basep_own: string = __raw_string(basep, 8);\n  __syscall3(6, fd as i64, 0, 0);\n  if