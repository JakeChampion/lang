    "function __fern_ring_reap(blk: usize, nfds: i32): i32 {\n  let cq: usize = __load_i64(blk + 16) as usize;\n  let headp: usize = cq + __load_i32(blk + 48) as usize;\n  let tailp: usize = cq + __load_i32(blk + 52) as usize;\n  let cmask: i64 = __load_i32(blk + 56) as i64;\n  let cqes: usize = cq + __load_i32(blk + 60) as usize;\n  let head: i64 = __load_i32(headp) as i64 & 4294967295 as i64;\n  let tail: i64 = __load_i32(tailp) as i64 & 4294967295 as i64;\n  while (head != tail) {\n    let c: usize = cqes + (head & cmask) as usize * 16;\n    let ud: i64 = __load_i64(c);\n    let res: i32 = __load_i32(c + 8);\n    let flags: i32 = __load_i32(c + 12);\n    head = head + 1 & 4294967295 as i64;\n    let fd: i32 = (ud & 4294967295 as i64) as i32;\n    let gen: i32 = (ud >> 32 & 255 as i64) as i32;\n    if (ud >= 2305843009213693952 as i64 && ud < 4611686018427387904 as i64) {\n      __fern_ring_recv_done(blk, fd, gen, res, flags, nfds);\n    } else if (ud >= 1152921504606846976 as i64 && ud < 2305843009213693952 as i64) {\n      __fern_ring_zc_done(blk, (ud & 511 as i64) as i32, res, flags, nfds);\n    } else if (ud >= 0 as i64 && ud < 1152921504606846976 as i64 && fd >= 0 && fd < nfds) {\n      let ent: usize = __fern_ring_entry(blk, fd);\n      if (__raw_load8(ent, 2) == gen && __raw_load8(ent, 1) != 0) {\n        __raw_store8(ent, 1, 0);\n        if (__raw_load8(ent, 0) != 0) {\n          __fern_ring_pend(blk, fd);\n          let ready: i32 = 4;\n          if (res >= 0) {\n            ready = 0;\n            if ((res & 1) != 0) {\n              ready = ready | 1;\n            }\n            if ((res & 4) != 0) {\n              ready = ready | 2;\n            }\n            if ((res & 24) != 0) {\n              ready = ready | 4;\n            }\n          }\n          __raw_store8(ent, 14, __raw_load8(ent, 14) | ready | 8);\n          __fern_ring_list(blk, ent, fd);\n        }\n      }\n    }\n  }\n  __store_i32(headp, head as i32);\n  return 0;\n}\n",
    "function __fern_ring_recv_arm(blk: usize, ent: usize, fd: i32): i32 {\n  let r: i32 = __fern_ring_push(blk, 27, fd, 0, __fern_ring_rud(fd, __raw_load8(ent, 5)), 0);\n  if (r < 0) {\n    return r;\n  }\n  let e: usize = __load_i64(blk + 192) as usize;\n  __raw_store8(e, 1, 32);\n  __raw_store8(e, 2, 2);\n  __raw_store8(ent, 4, 1);\n  return 0;\n}\n",
    "function __fern_ring_recv_done(blk: usize, fd: i32, gen: i32, res: i32, flags: i32, nfds: i32): i32 {\n  let bid: i32 = flags >> 16 & 65535;\n  if (fd < 0 || fd >= nfds) {\n    if ((flags & 1) != 0) {\n      __fern_ring_give(blk, bid);\n    }\n    return 0;\n  }\n  let ent: usize = __fern_ring_entry(blk, fd);\n  if (__raw_load8(ent, 5) != gen || __raw_load8(ent, 0) == 0) {\n    if ((flags & 1) != 0) {\n      __fern_ring_give(blk, bid);\n    }\n    return 0;\n  }\n  if ((flags & 1) != 0 && res > 0) {\n    __fern_ring_enqueue(blk, ent, bid, res);\n  } else if ((flags & 1) != 0) {\n    __fern_ring_give(blk, bid);\n  }\n  let st: i32 = __raw_load8(ent, 4);\n  if (res == 0) {\n    __raw_store8(ent, 6, 1);\n    __raw_store8(ent, 4, 0);\n  } else if (res == 0 - 105) {\n    if (st == 1) {\n      __fern_ring_fall_back(blk, ent, fd);\n    }\n  } else if (res == 0 - 88 || res == 0 - 95) {\n    __raw_store8(ent, 6, 3);\n    __fern_ring_fall_back(blk, ent, fd);\n  } else if (res < 0 && res != 0 - 125) {\n    __raw_store8(ent, 6, 2);\n    __raw_store8(ent, 7, 0 - res & 255);\n    __raw_store8(ent, 4, 0);\n  } else if (res > 0 && st == 1 && __raw_load8(ent, 15) >= 16) {\n    __fern_ring_fall_back(blk, ent, fd);\n    __fern_ring_pend(blk, fd);\n  } else if (res > 0 && st == 1 && (flags & 2) == 0) {\n    __raw_store8(ent, 4, 2);\n    __fern_ring_pend(blk, fd);\n  }\n  if ((__raw_load8(ent, 0) & 1) != 0 && (__fern_ring_u16(ent, 8) != 0 || __raw_load8(ent, 6) == 1 || __raw_load8(ent, 6) == 2)) {\n    __fern_ring_list(blk, ent, fd);\n  }\n  return 0;\n}\n",
    "function __fern_ring_recv_stop(blk: usize, ent: usize, fd: i32): i32 {\n  if (__raw_load8(ent, 4) == 1) {\n    let r: i32 = __fern_ring_push(blk, 14, 0 - 1, 0, 4611686018427387904 as i64, __fern_ring_rud(fd, __raw_load8(ent, 5)));\n    if (r < 0) {\n      return r;\n    }\n  }\n  __raw_store8(ent, 4, 0);\n  return 0;\n}\n",
    "function __fern_ring_resume(blk: usize, ent: usize, fd: i32): i32 {\n  if ((__raw_load8(ent, 0) & 8) == 0 || __raw_load8(ent, 6) != 0 || __fern_ring_u16(ent, 8) != 0) {\n    return 0;\n  }\n  let st: i32 = __raw_load8(ent, 4);\n  if (st == 2 && __load_i32(blk + 180) > 0) {\n    return __fern_ring_recv_arm(blk, ent, fd);\n  }\n  if (st == 2) {\n    return __fern_ring_fall_back(blk, ent, fd);\n  }\n  if (st == 5 && __load_i32(blk + 180) >= 64) {\n    let un: i32 = __fern_ring_unarm(blk, ent, fd);\n    if (un < 0) {\n      return un;\n    }\n    __raw_store8(ent, 13, __raw_load8(ent, 13) & 4);\n    let a: i32 = __fern_ring_arm(blk, ent, fd);\n    if (a < 0) {\n      return a;\n    }\n    return __fern_ring_recv_arm(blk, ent, fd);\n  }\n  return 0;\n}\n",
