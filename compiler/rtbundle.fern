    "function __fern_poll(fds: i32[], timeout_ms: i32): i32 {\n  let n: i32 = fds.len();\n  if (n <= 0) {\n    return 0 - 1;\n  }\n  let buf: usize = __raw_alloc(n * 8);\n  let i: i32 = 0;\n  while (i < n) {\n    __raw_store_ptr(buf, i, fds[i] as usize);\n    __raw_store8(buf, i * 8 + 4, 1);\n    __raw_store8(buf, i * 8 + 5, 0);\n    __raw_store8(buf, i * 8 + 6, 0);\n    __raw_store8(buf, i * 8 + 7, 0);\n    i = i + 1;\n  }\n  let tmo: usize = 0 as usize;\n  if (timeout_ms >= 0) {\n    let ts: usize = __raw_scratch(16);\n    __raw_store_ptr(ts, 0, (timeout_ms / 1000) as usize);\n    __raw_store_ptr(ts, 1, (timeout_ms % 1000 * 1000000) as usize);\n    tmo = ts;\n  }\n  __syscall5(73, buf as i64, n as i64, tmo as i64, 0, 0);\n  let hit: i32 = 0 - 1;\n  let j: i32 = 0;\n  while (j < n) {\n    if (hit < 0) {\n      if ((__raw_load8(buf, j * 8 + 6) & 57) != 0) {\n        hit = j;\n      }\n    }\n    j = j + 1;\n  }\n  let buf_own: string = __raw_string(buf, n * 8);\n  return hit;\n}\n",
