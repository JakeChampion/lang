import "./ssa";
import "./ssadeps";
import "./ssasem";
import "./semrecords";
import "./typeinfo";
import "./util";

pub struct Threaded { f: ssasem.Func, changed: i32 }

pub function thread(f: ssasem.Func, stack_phi_joins: boolean): Threaded {
  let g = f.graph;
  let changed = 0;
  if (decidable(g)) {
    let round = 0;
    while (round < 8) {
      let r = thread_round(f, g);
      if (r.changed == 0) {
        break;
      }
      g = r.g;
      changed += r.changed;
      round += 1;
    }
  }
  let cur = f;
  if (changed > 0) {
    cur = ssasem.Func { ...f, graph: g };
  }
  let j = split_constant_joins(cur, stack_phi_joins);
  if (j.changed > 0) {
    cur = j.f;
    changed += j.changed;
  }
  let rp = returns_in_predecessors(cur);
  if (rp.changed > 0) {
    cur = ssasem.Func { ...cur, graph: rp.g };
    changed += rp.changed;
  }
  let es = merge_branch_chains(cur.graph);
  if (es.changed > 0) {
    cur = ssasem.Func { ...cur, graph: es.g };
    changed += es.changed;
  }
  if (changed == 0) {
    return Threaded { f: f, changed: 0 };
  }
  return Threaded { f: cur, changed: changed };
}

struct Round { g: ssa.SFunc, changed: i32 }

function decidable(g: ssa.SFunc): boolean {
  let up = util.minus_ones(g.nvals);
  let constant = __alloc_bool(g.nvals);
  let tested: i32[] = [];
  for b in g.blocks {
    for ins in b.insts {
      if (ins.result < 0 || ins.result >= g.nvals) {
        continue;
      }
      let k = ins.kind_tag;
      if (k == 2) {
        constant = constant.with(ins.result, true);
      } else if (ins.args.len() == 1 && (k == 7 || k == ssasem.variant_get() || k == ssasem.record_get() || k == ssasem.tuple_get())) {
        up = up.with(ins.result, ins.args[0]);
      } else if (k == ssasem.variant_is() && ins.args.len() == 1) {
        tested = tested.append(ins.args[0]);
      }
    }
  }
  for b in g.blocks {
    if (b.term.kind_tag == ssa.TERM_BRIF && b.term.cond >= 0 && b.term.cond < g.nvals && constant[b.term.cond]) {
      return true;
    }
  }
  let roots: i32[] = [];
  for v in tested {
    let r = v;
    let hops = 0;
    while (r >= 0 && r < g.nvals && up[r] >= 0 && hops < 32) {
      r = up[r];
      hops += 1;
    }
    if (util.index_of_i32(roots, r) >= 0) {
      return true;
    }
    roots = roots.append(r);
  }
  return false;
}

struct Seen { at: i32[], defs: ssa.SInst[], uses: i32[], facts: Facts, head: i32[], on_t: i32[], on_f: i32[] }

function thread_round(f: ssasem.Func, g: ssa.SFunc): Round {
  let n = g.blocks.len();
  let none = util.minus_ones(n);
  let s = Seen { at: ssa.block_positions(g), defs: ssa.inst_defs(g), uses: ssa.use_counts(g), facts: no_facts(), head: none, on_t: none, on_f: none };
  s = block_facts(f, g, s);
  let blocks = g.blocks;
  let changed = 0;
  let bi = 0;
  while (bi < n) {
    let b = g.blocks[bi];
    let t = moved_term(f, g, s, bi, decided_term(f, s, bi, b.term));
    if (!same_term(t, b.term)) {
      changed += 1;
      blocks = blocks.with(bi, ssa.SBlock { ...b, term: t });
    }
    bi += 1;
  }
  if (changed == 0) {
    return Round { g: g, changed: 0 };
  }
  let moved = ssa.SFunc { ...g, blocks: blocks };
  let kept = ssa.SFunc { ...moved, blocks: reachable_only(moved) };
  let fresh = ssa.SFunc { ...kept, blocks: ssa.refreshed_preds(kept) };
  return Round { g: ssa.SFunc { ...fresh, blocks: untested(fresh) }, changed: changed };
}

function decided_term(f: ssasem.Func, s: Seen, bi: i32, t: ssa.STerm): ssa.STerm {
  if (t.kind_tag != 3 || t.t == t.f) {
    return t;
  }
  let d = outcome(f, s, s.head[bi], no_facts(), t.cond);
  if (d == 1) {
    return jump(t.t);
  }
  if (d == 0) {
    return jump(t.f);
  }
  return t;
}

function outcome(f: ssasem.Func, s: Seen, h: i32, path: Facts, cond: i32): i32 {
  let c = through_copies(s.defs, cond);
  if (c.kind_tag == 2) {
    if (c.imm != 0) {
      return 1;
    }
    return 0;
  }
  let q = test_of(f, s.defs, cond);
  if (!q.ok) {
    return -1;
  }
  let d = decide(f, s.facts, h, path, q);
  if (d < 0 || q.yes) {
    return d;
  }
  return 1 - d;
}

function moved_term(f: ssasem.Func, g: ssa.SFunc, s: Seen, bi: i32, t: ssa.STerm): ssa.STerm {
  if (t.kind_tag == 2) {
    return jump(reached(f, g, s, s.head[bi], t.target));
  }
  if (t.kind_tag != 3) {
    return t;
  }
  if (t.t == t.f) {
    return jump(reached(f, g, s, s.head[bi], t.t));
  }
  let ht = s.on_t[bi];
  let hf = s.on_f[bi];
  if (ht < 0) {
    ht = s.head[bi];
    hf = s.head[bi];
  }
  let nt = reached(f, g, s, ht, t.t);
  let nf = reached(f, g, s, hf, t.f);
  if (nt == nf) {
    return jump(nt);
  }
  return ssa.STerm { ...t, t: nt, f: nf };
}

function reached(f: ssasem.Func, g: ssa.SFunc, s: Seen, h: i32, id: i32): i32 {
  let cur = id;
  let landed = id;
  let path = no_facts();
  let hops = 0;
  while (hops < 16) {
    let b = g.blocks[s.at[cur]];
    let next: i32 = -1;
    if (b.insts.len() == 0 && b.term.kind_tag == ssa.TERM_BR) {
      next = b.term.target;
    } else if (only_tests(s, b)) {
      let d = outcome(f, s, h, path, b.term.cond);
      if (d >= 0) {
        path = with_fact(path, test_of(f, s.defs, b.term.cond), d == 1, -1);
        next = b.term.f;
        if (d == 1) {
          next = b.term.t;
        }
      }
    }
    if (next < 0 || next == cur || next == g.entry || has_phi(g.blocks[s.at[next]])) {
      return landed;
    }
    if (b.insts.len() > 0) {
      landed = next;
    }
    cur = next;
    hops += 1;
  }
  return landed;
}

function only_tests(s: Seen, b: ssa.SBlock): boolean {
  if (b.insts.len() != 1 || b.term.kind_tag != ssa.TERM_BRIF || b.term.t == b.term.f) {
    return false;
  }
  let ins = b.insts[0];
  return ins.kind_tag == ssasem.variant_is() && ins.result == b.term.cond && s.uses[ins.result] == 1;
}

struct Facts { root: i32[], path: string[], variant: string[], is: boolean[], up: i32[] }

function no_facts(): Facts {
  return Facts { root: [], path: [], variant: [], is: [], up: [] };
}

function with_fact(own facts: Facts, q: Test, taken: boolean, up: i32): Facts {
  return Facts { root: facts.root.append(q.root), path: facts.path.append(q.path), variant: facts.variant.append(q.variant), is: facts.is.append(taken == q.yes), up: facts.up.append(up) };
}

struct Test { ok: boolean, root: i32, path: string, variant: string, ty: typeinfo.Type, yes: boolean }

function test_of(f: ssasem.Func, defs: ssa.SInst[], cond: i32): Test {
  let yes = true;
  let d = through_copies(defs, cond);
  let hops = 0;
  while (d.kind_tag == 10 && d.str == "!" && d.args.len() == 1 && hops < 8) {
    yes = !yes;
    d = through_copies(defs, d.args[0]);
    hops += 1;
  }
  if (d.kind_tag != ssasem.variant_is() || d.args.len() != 1 || d.args[0] < 0) {
    return Test { ok: false, root: -1, path: "", variant: "", ty: f.values[0], yes: false };
  }
  let k = key_of(defs, d.args[0]);
  return Test { ok: true, root: k.root, path: k.path, variant: d.str, ty: f.values[d.args[0]], yes: yes };
}

struct Key { root: i32, path: string }

function key_of(defs: ssa.SInst[], v: i32): Key {
  let d = through_copies(defs, v);
  let k = d.kind_tag;
  let reads = k == ssasem.variant_get() || k == ssasem.record_get() || k == ssasem.tuple_get();
  if (!reads || d.args.len() != 1 || d.args[0] < 0) {
    return Key { root: d.result, path: "" };
  }
  let from = key_of(defs, d.args[0]);
  return Key { root: from.root, path: from.path + "." + util.i32_to_string(k) + ":" + util.i32_to_string(d.imm) + ":" + d.str };
}

function decide(f: ssasem.Func, facts: Facts, h: i32, path: Facts, q: Test): i32 {
  let ruled: string[] = [];
  let i = path.root.len() - 1;
  while (i >= 0) {
    let d = fact_says(path, i, q);
    if (d >= 0) {
      return d;
    }
    if (d == -2) {
      ruled = ruled.append(path.variant[i]);
    }
    i -= 1;
  }
  let at = h;
  let hops = 0;
  while (at >= 0 && hops < 64) {
    let d = fact_says(facts, at, q);
    if (d >= 0) {
      return d;
    }
    if (d == -2) {
      ruled = ruled.append(facts.variant[at]);
    }
    at = facts.up[at];
    hops += 1;
  }
  if (ruled.len() == 0) {
    return -1;
  }
  let e = semrecords.find_enum(f.enums, q.ty);
  if (e < 0) {
    return -1;
  }
  for v in f.enums[e].variants {
    if (v.name != q.variant && util.index_of_str(ruled, v.name) < 0) {
      return -1;
    }
  }
  return 1;
}

function fact_says(facts: Facts, i: i32, q: Test): i32 {
  if (facts.root[i] != q.root || facts.path[i] != q.path) {
    return -1;
  }
  if (facts.is[i]) {
    if (facts.variant[i] == q.variant) {
      return 1;
    }
    return 0;
  }
  if (facts.variant[i] == q.variant) {
    return 0;
  }
  return -2;
}

function block_facts(f: ssasem.Func, g: ssa.SFunc, s: Seen): Seen {
  let dom = ssadeps.dominates(g);
  let facts = no_facts();
  let head = s.head;
  let on_t = s.on_t;
  let on_f = s.on_f;
  for bi in dom.by_clock {
    if (bi < 0) {
      continue;
    }
    let id = dom.idom[bi];
    if (id < 0) {
      continue;
    }
    let b = g.blocks[bi];
    if (id != bi) {
      let h = head[id];
      if (b.preds.len() == 1 && s.at[b.preds[0]] == id && on_t[id] >= 0) {
        h = on_f[id];
        if (g.blocks[id].term.t == b.id) {
          h = on_t[id];
        }
      }
      head = head.with(bi, h);
    }
    if (b.term.kind_tag == ssa.TERM_BRIF && b.term.t != b.term.f) {
      let q = test_of(f, s.defs, b.term.cond);
      if (q.ok) {
        on_t = on_t.with(bi, facts.root.len());
        facts = with_fact(facts, q, true, head[bi]);
        on_f = on_f.with(bi, facts.root.len());
        facts = with_fact(facts, q, false, head[bi]);
      }
    }
  }
  return Seen { ...s, facts: facts, head: head, on_t: on_t, on_f: on_f };
}

function jump(target: i32): ssa.STerm {
  return ssa.STerm { kind_tag: ssa.TERM_BR, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function same_term(a: ssa.STerm, b: ssa.STerm): boolean {
  return a.kind_tag == b.kind_tag && a.cond == b.cond && a.target == b.target && a.t == b.t && a.f == b.f && a.value == b.value;
}

// Both the forwarding and the split change only a join that holds a phi.
function graph_has_phi(g: ssa.SFunc): boolean {
  for b in g.blocks {
    if (has_phi(b)) {
      return true;
    }
  }
  return false;
}

function has_phi(b: ssa.SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag == ssa.PHI) {
      return true;
    }
  }
  return false;
}

pub function reachable_only(g: ssa.SFunc): ssa.SBlock[] {
  let live = ssadeps.reachable_blocks(g);
  let out: ssa.SBlock[] = [];
  let i = 0;
  while (i < g.blocks.len()) {
    if (live[i]) {
      out = out.append(g.blocks[i]);
    }
    i += 1;
  }
  return out;
}

function untested(g: ssa.SFunc): ssa.SBlock[] {
  let uses = ssa.use_counts(g);
  let out: ssa.SBlock[] = [];
  for b in g.blocks {
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      if (ins.kind_tag != ssasem.variant_is() || ins.result < 0 || uses[ins.result] > 0) {
        insts = insts.append(ins);
      }
    }
    out = out.append(ssa.SBlock { ...b, insts: insts });
  }
  return out;
}

function through_copies(defs: ssa.SInst[], v: i32): ssa.SInst {
  if (v < 0 || v >= defs.len()) {
    return ssa.SInst { kind_tag: 0, result: v, args: [], imm: 0, str: "" };
  }
  let d = defs[v];
  let hops = 0;
  while (d.kind_tag == 7 && d.args.len() == 1 && d.args[0] >= 0 && hops < 16) {
    d = defs[d.args[0]];
    hops += 1;
  }
  if (d.result < 0) {
    return ssa.SInst { ...d, result: v };
  }
  return d;
}

// A call that returns its variant in two words meets the match on its result
// as a join: a phi per payload word, and a boolean phi that is true on the Ok
// edge and false on the Err edge, which the match branches on. Each
// predecessor of such a join has decided that branch. It goes to the arm its
// constant picks, the join goes, and a payload phi an arm reads becomes the
// operand of the one predecessor that reaches the arm, or a phi of the
// predecessors that do.

struct Joined { f: ssasem.Func, changed: i32 }

function split_constant_joins(f0: ssasem.Func, stack_phi_joins: boolean): Joined {
  if (!graph_has_phi(f0.graph)) {
    return Joined { f: f0, changed: 0 };
  }
  let f = f0;
  let changed = 0;
  for _ in 0..16 {
    let fw = forward_empty_joins(f.graph, stack_phi_joins);
    if (fw.changed > 0) {
      f = ssasem.Func { ...f, graph: fw.g };
      changed += fw.changed;
    }
    let r = split_round(f);
    if (r.changed == 0) {
      break;
    }
    f = r.f;
    changed += r.changed;
  }
  if (changed == 0) {
    return Joined { f: f0, changed: 0 };
  }
  return Joined { f: f, changed: changed };
}

struct Forwarded { g: ssa.SFunc, changed: i32 }

// An empty block that jumps to a join is left out: each of its predecessors
// jumps to the join, and each phi reads on the new edge what it read on the
// old one. A predecessor that branches keeps the block, so that no edge
// carries both a condition and a phi. A block that holds only phis goes the
// same way when only the join's phis read them. Native targets forward into
// at most two phi destinations, or into a join that returns or branches on a
// phi. Wider joins keep their chains so the allocator can coalesce them.
// Wasm forwards them without that register constraint. Each read becomes
// the phi's operand on that edge.
function forward_empty_joins(g0: ssa.SFunc, stack_phi_joins: boolean): Forwarded {
  let g = g0;
  let changed = 0;
  for round in 0..64 {
    let at = ssa.block_positions(g);
    let yi = first_forwardable(g, at, ssa.use_counts(g), stack_phi_joins);
    if (yi < 0) {
      break;
    }
    g = forward_block(g, at, yi);
    changed = round + 1;
  }
  if (changed == 0) {
    return Forwarded { g: g0, changed: 0 };
  }
  let kept = ssa.SFunc { ...g, blocks: reachable_only(g) };
  return Forwarded { g: ssa.SFunc { ...kept, blocks: ssa.refreshed_preds(kept) }, changed: changed };
}

// A block with phis is not forwarded into a loop header it is the latch of.
function first_forwardable(g: ssa.SFunc, at: i32[], uses: i32[], stack_phi_joins: boolean): i32 {
  let dom = ssadeps.Dom { pre: [], post: [], idom: [], by_clock: [] };
  for yi in 0..g.blocks.len() {
    if (forwardable(g, at, uses, yi, stack_phi_joins)) {
      let y = g.blocks[yi];
      if (y.insts.len() == 0) {
        return yi;
      }
      if (dom.pre.len() == 0) {
        dom = ssadeps.dominates(g);
      }
      if (!ssadeps.dom_holds(dom, yi, at[y.term.target])) {
        return yi;
      }
    }
  }
  return -1;
}

function forwardable(g: ssa.SFunc, at: i32[], uses: i32[], yi: i32, stack_phi_joins: boolean): boolean {
  let y = g.blocks[yi];
  if (y.term.kind_tag != ssa.TERM_BR || y.preds.len() == 0 || y.id == g.entry) {
    return false;
  }
  let x = y.term.target;
  if (x == y.id || x < 0 || x >= at.len() || at[x] < 0) {
    return false;
  }
  let xb = g.blocks[at[x]];
  if (!has_phi(xb) || util.index_of_i32(xb.preds, y.id) < 0 || !phis_read_on_edge(y, xb, uses)) {
    return false;
  }
  if (!join_cost_allows(g, at, yi, at[x], stack_phi_joins)) {
    return false;
  }
  for q in y.preds {
    if (q == y.id || q < 0 || q >= at.len() || at[q] < 0) {
      return false;
    }
    let qb = g.blocks[at[q]];
    if (qb.term.kind_tag != ssa.TERM_BR || qb.term.target != y.id || util.index_of_i32(xb.preds, q) >= 0) {
      return false;
    }
  }
  return true;
}

// A pair of phis has at most two destinations. Wider native joins retain
// their merge chain. Wasm instead pays for intermediate local transfers.
function join_cost_allows(g: ssa.SFunc, at: i32[], yi: i32, xi: i32, stack_phi_joins: boolean): boolean {
  return stack_phi_joins || g.blocks[yi].insts.len() == 0 || ends_on_phi(g, at, xi) || at_most_two_phis(g.blocks[xi]);
}

function at_most_two_phis(b: ssa.SBlock): boolean {
  let count = 0;
  for ins in b.insts {
    if (ins.kind_tag == ssa.PHI) {
      count += 1;
    }
  }
  return count <= 2;
}

// x returns one of its phis, or branches on one, itself or through a chain of
// empty blocks.
function ends_on_phi(g: ssa.SFunc, at: i32[], xi: i32): boolean {
  let xb = g.blocks[xi];
  if (xb.term.kind_tag == ssa.TERM_RET) {
    return phi_of(xb, xb.term.value).kind_tag == 8;
  }
  if (xb.term.kind_tag == ssa.TERM_BRIF) {
    return xb.term.t != xb.term.f && phi_of(xb, xb.term.cond).kind_tag == 8;
  }
  return chained_branch(g, at, xi) >= 0;
}

// Every instruction of y is a phi that only the phis of x read, on the edge
// from y. No phi of y reads another.
function phis_read_on_edge(y: ssa.SBlock, xb: ssa.SBlock, uses: i32[]): boolean {
  let slot = util.index_of_i32(xb.preds, y.id);
  for p in y.insts {
    if (p.kind_tag != 8 || p.args.len() != y.preds.len() || p.result < 0 || p.result >= uses.len() || reads_own_phi(y, p)) {
      return false;
    }
    if (edge_reads(xb, slot, p.result) != uses[p.result]) {
      return false;
    }
  }
  return true;
}

function reads_own_phi(b: ssa.SBlock, ins: ssa.SInst): boolean {
  for a in ins.args {
    if (phi_of(b, a).kind_tag == 8) {
      return true;
    }
  }
  return false;
}

function edge_reads(xb: ssa.SBlock, slot: i32, v: i32): i32 {
  let reads = 0;
  for ins in xb.insts {
    if (ins.kind_tag == ssa.PHI && slot < ins.args.len() && ins.args[slot] == v) {
      reads += 1;
    }
  }
  return reads;
}

function forward_block(g: ssa.SFunc, at: i32[], yi: i32): ssa.SFunc {
  let y = g.blocks[yi];
  let xi = at[y.term.target];
  let xb = g.blocks[xi];
  let slot = util.index_of_i32(xb.preds, y.id);
  let preds: i32[] = [];
  for i in 0..xb.preds.len() {
    if (i == slot) {
      for q in y.preds {
        preds = preds.append(q);
      }
    } else {
      preds = preds.append(xb.preds[i]);
    }
  }
  let insts: ssa.SInst[] = [];
  for ins in xb.insts {
    if (ins.kind_tag == ssa.PHI) {
      let args: i32[] = [];
      for k in 0..ins.args.len() {
        if (k == slot) {
          for qk in 0..y.preds.len() {
            args = args.append(operand_on_edge(y, ins.args[k], qk));
          }
        } else {
          args = args.append(ins.args[k]);
        }
      }
      insts = insts.append(ssa.SInst { ...ins, args: args });
    } else {
      insts = insts.append(ins);
    }
  }
  let blocks = g.blocks.with(xi, ssa.SBlock { ...xb, insts: insts, preds: preds });
  for q in y.preds {
    let qi = at[q];
    blocks = blocks.with(qi, ssa.SBlock { ...blocks[qi], term: jump(xb.id) });
  }
  blocks = blocks.with(yi, ssa.SBlock { ...y, insts: [], preds: [] });
  return ssa.SFunc { ...g, blocks: blocks };
}

// What v is on the edge from the qk-th predecessor of y.
function operand_on_edge(y: ssa.SBlock, v: i32, qk: i32): i32 {
  let p = phi_of(y, v);
  if (p.kind_tag == 8) {
    return p.args[qk];
  }
  return v;
}

// A join that reaches the branch on its phi through empty blocks, each
// entered from the one before, takes that branch: the join and the branch
// become one block.
function merge_branch_chains(g0: ssa.SFunc): Forwarded {
  let g = g0;
  let changed = 0;
  let at = ssa.block_positions(g);
  for ji in 0..g.blocks.len() {
    let bi = chained_branch(g, at, ji);
    if (bi >= 0) {
      g = branch_from(g, at, ji, bi);
      changed += 1;
    }
  }
  if (changed == 0) {
    return Forwarded { g: g0, changed: 0 };
  }
  let kept = ssa.SFunc { ...g, blocks: reachable_only(g) };
  return Forwarded { g: ssa.SFunc { ...kept, blocks: ssa.refreshed_preds(kept) }, changed: changed };
}

function chained_branch(g: ssa.SFunc, at: i32[], ji: i32): i32 {
  let jb = g.blocks[ji];
  if (jb.term.kind_tag != ssa.TERM_BR || !has_phi(jb)) {
    return -1;
  }
  let from = jb.id;
  let target = jb.term.target;
  for _ in 0..16 {
    let ni = chain_step(g, at, jb, from, target);
    if (ni < 0) {
      return -1;
    }
    let nb = g.blocks[ni];
    if (nb.term.kind_tag == ssa.TERM_BRIF) {
      return if (phi_of(jb, nb.term.cond).kind_tag == 8 && nb.term.t != nb.term.f) { ni } else { -1 };
    }
    if (nb.term.kind_tag != ssa.TERM_BR) {
      return -1;
    }
    from = nb.id;
    target = nb.term.target;
  }
  return -1;
}

// The position of target when it is an empty block entered only from from.
function chain_step(g: ssa.SFunc, at: i32[], jb: ssa.SBlock, from: i32, target: i32): i32 {
  if (target == jb.id || target == g.entry || target < 0 || target >= at.len() || at[target] < 0) {
    return -1;
  }
  let nb = g.blocks[at[target]];
  if (nb.insts.len() != 0 || nb.preds.len() != 1 || nb.preds[0] != from) {
    return -1;
  }
  return at[target];
}

function branch_from(g: ssa.SFunc, at: i32[], ji: i32, bi: i32): ssa.SFunc {
  let jb = g.blocks[ji];
  let bb = g.blocks[bi];
  let blocks = g.blocks.with(ji, ssa.SBlock { ...jb, term: bb.term });
  for s in [bb.term.t, bb.term.f] {
    if (s >= 0 && s < at.len() && at[s] >= 0) {
      let sb = blocks[at[s]];
      let preds: i32[] = [];
      for q in sb.preds {
        preds = preds.append(if (q == bb.id) { jb.id } else { q });
      }
      blocks = blocks.with(at[s], ssa.SBlock { ...sb, preds: preds });
    }
  }
  return ssa.SFunc { ...g, blocks: blocks };
}

// A block that holds only phis and returns a phi of constants is left out:
// each predecessor returns the constant it brings, as a return in each arm of
// a value match does. A block with one predecessor can return any value.
function returns_in_predecessors(f: ssasem.Func): Forwarded {
  let g = f.graph;
  let changed = 0;
  for round in 0..64 {
    let at = ssa.block_positions(g);
    let ri = first_returning_join(f, g, at);
    if (ri < 0) {
      break;
    }
    g = return_in_predecessors(g, at, ri);
    changed = round + 1;
  }
  if (changed == 0) {
    return Forwarded { g: f.graph, changed: 0 };
  }
  let kept = ssa.SFunc { ...g, blocks: reachable_only(g) };
  return Forwarded { g: ssa.SFunc { ...kept, blocks: ssa.refreshed_preds(kept) }, changed: changed };
}

function first_returning_join(f: ssasem.Func, g: ssa.SFunc, at: i32[]): i32 {
  let defs = ssa.inst_defs(g);
  for ri in 0..g.blocks.len() {
    if (returning_join(f, g, at, defs, ri)) {
      return ri;
    }
  }
  return -1;
}

function returning_join(f: ssasem.Func, g: ssa.SFunc, at: i32[], defs: ssa.SInst[], ri: i32): boolean {
  let r = g.blocks[ri];
  return r.term.kind_tag == ssa.TERM_RET && r.preds.len() > 0 && r.id != g.entry && returns_arm_values(f, defs, r) && only_phis(r) && entered_by_jumps(g, at, r);
}

// A returned view keeps the shape that the return lowering gives it
// (kept_view).
function returns_arm_values(f: ssasem.Func, defs: ssa.SInst[], r: ssa.SBlock): boolean {
  let v = r.term.value;
  if (v < 0 || v >= f.values.len() || ssasem.is_view(f.values[v])) {
    return false;
  }
  let phi = phi_of(r, v);
  if (phi.kind_tag == 8) {
    return phi_of_constants(defs, phi, r.preds.len());
  }
  return r.preds.len() == 1;
}

function only_phis(r: ssa.SBlock): boolean {
  for ins in r.insts {
    if (ins.kind_tag != ssa.PHI || reads_own_phi(r, ins)) {
      return false;
    }
  }
  return true;
}

function entered_by_jumps(g: ssa.SFunc, at: i32[], r: ssa.SBlock): boolean {
  for q in r.preds {
    if (q < 0 || q >= at.len() || at[q] < 0) {
      return false;
    }
    let qb = g.blocks[at[q]];
    if (qb.term.kind_tag != ssa.TERM_BR || qb.term.target != r.id) {
      return false;
    }
  }
  return true;
}

function phi_of_constants(defs: ssa.SInst[], phi: ssa.SInst, preds: i32): boolean {
  if (phi.args.len() != preds) {
    return false;
  }
  for a in phi.args {
    if (!movable_constant(through_copies(defs, a))) {
      return false;
    }
  }
  return true;
}

function return_in_predecessors(g: ssa.SFunc, at: i32[], ri: i32): ssa.SFunc {
  let r = g.blocks[ri];
  let phi = phi_of(r, r.term.value);
  let blocks = g.blocks;
  for k in 0..r.preds.len() {
    let value = r.term.value;
    if (phi.kind_tag == 8) {
      value = phi.args[k];
    }
    let qi = at[r.preds[k]];
    blocks = blocks.with(qi, ssa.SBlock { ...blocks[qi], term: ssa.STerm { ...r.term, value: value } });
  }
  blocks = blocks.with(ri, ssa.SBlock { ...r, insts: [], preds: [] });
  return ssa.SFunc { ...g, blocks: blocks };
}

// j and b are positions: the join, and the block that branches on its phi,
// which is j itself or the last of chain. picks has one entry per
// predecessor of the join: 1 for the true arm, 0 for the false arm. t and f
// are the arms' positions.
struct Join { ok: boolean, j: i32, chain: i32[], b: i32, picks: i32[], t: i32, f: i32 }

function no_join(ji: i32): Join {
  return Join { ok: false, j: ji, chain: [], b: ji, picks: [], t: -1, f: -1 };
}

function split_round(f: ssasem.Func): Joined {
  let g = f.graph;
  let at = ssa.block_positions(g);
  let uses = ssa.use_counts(g);
  let defs = ssa.inst_defs(g);
  let dom = ssadeps.dominates(g);
  for ji in 0..g.blocks.len() {
    if (!has_phi(g.blocks[ji])) {
      continue;
    }
    let c = constant_join(g, at, uses, defs, dom, ji);
    if (c.ok) {
      return Joined { f: split_join(f, at, dom, c), changed: 1 };
    }
  }
  return Joined { f: f, changed: 0 };
}

function dead_copy(uses: i32[], ins: ssa.SInst): boolean {
  return ins.kind_tag == ssa.COPY && ins.result >= 0 && ins.result < uses.len() && uses[ins.result] == 0;
}

function movable_constant(ins: ssa.SInst): boolean {
  let k = ins.kind_tag;
  return ins.args.len() == 0 && ins.result >= 0 && (k == 1 || k == 2 || k == 3 || k == 5 || k == ssasem.zero());
}

function constant_join(g: ssa.SFunc, at: i32[], uses: i32[], defs: ssa.SInst[], dom: ssadeps.Dom, ji: i32): Join {
  let jb = g.blocks[ji];
  if (jb.id == g.entry || jb.preds.len() == 0) {
    return no_join(ji);
  }
  let any_phi = false;
  for ins in jb.insts {
    if (ins.kind_tag == ssa.PHI) {
      any_phi = true;
    } else if (!dead_copy(uses, ins) && !movable_constant(ins)) {
      return no_join(ji);
    }
  }
  if (!any_phi) {
    return no_join(ji);
  }
  let chain: i32[] = [];
  let bi = ji;
  for _ in 0..16 {
    if (g.blocks[bi].term.kind_tag != ssa.TERM_BR) {
      break;
    }
    let target = g.blocks[bi].term.target;
    if (target < 0 || target >= at.len() || at[target] < 0) {
      return no_join(ji);
    }
    let next = at[target];
    let nb = g.blocks[next];
    if (next == ji || nb.preds.len() != 1 || nb.preds[0] != g.blocks[bi].id) {
      return no_join(ji);
    }
    for ins in nb.insts {
      if (!dead_copy(uses, ins)) {
        return no_join(ji);
      }
    }
    chain = chain.append(next);
    bi = next;
  }
  let bb = g.blocks[bi];
  if (bb.term.kind_tag != ssa.TERM_BRIF || bb.term.t == bb.term.f) {
    return no_join(ji);
  }
  let cond = phi_of(jb, bb.term.cond);
  if (cond.kind_tag != 8 || cond.args.len() != jb.preds.len()) {
    return no_join(ji);
  }
  // The later SSA pass handles joins that carry only the branch value.
  // Preserve its register layout when no payload needs this earlier split.
  let payload = false;
  for ins in jb.insts {
    if (ins.kind_tag == ssa.PHI && ins.result != cond.result && ins.result >= 0 && ins.result < uses.len() && uses[ins.result] > 0) {
      payload = true;
    }
  }
  if (!payload) {
    return no_join(ji);
  }
  let picks: i32[] = [];
  for a in cond.args {
    let d = through_copies(defs, a);
    if (d.kind_tag != 1 && d.kind_tag != 2 || d.args.len() != 0) {
      return no_join(ji);
    }
    if (d.imm != 0) {
      picks = picks.append(1);
    } else {
      picks = picks.append(0);
    }
  }
  for q in jb.preds {
    if (q < 0 || q >= at.len() || at[q] < 0) {
      return no_join(ji);
    }
    let qi = at[q];
    let qb = g.blocks[qi];
    if (qi == ji || qb.term.kind_tag != ssa.TERM_BR || qb.term.target != jb.id || ssadeps.dom_holds(dom, qi, ji)) {
      return no_join(ji);
    }
  }
  if (bb.term.t < 0 || bb.term.t >= at.len() || bb.term.f < 0 || bb.term.f >= at.len()) {
    return no_join(ji);
  }
  let ti = at[bb.term.t];
  let fi = at[bb.term.f];
  if (!plain_arm(g, ti, bb.id, ji, chain) || !plain_arm(g, fi, bb.id, ji, chain)) {
    return no_join(ji);
  }
  let c = Join { ok: true, j: ji, chain: chain, b: bi, picks: picks, t: ti, f: fi };
  if (!reads_under_arms(g, at, dom, c)) {
    return no_join(ji);
  }
  return c;
}

function phi_of(b: ssa.SBlock, v: i32): ssa.SInst {
  for ins in b.insts {
    if (ins.kind_tag == ssa.PHI && ins.result == v) {
      return ins;
    }
  }
  return ssa.SInst { kind_tag: 0, result: -1, args: [], imm: 0, str: "" };
}

// An arm is entered from the branch alone, holds no phi, and is neither the
// join nor one of the blocks between it and the branch.
function plain_arm(g: ssa.SFunc, ti: i32, from: i32, ji: i32, chain: i32[]): boolean {
  if (ti < 0 || ti == ji || util.index_of_i32(chain, ti) >= 0) {
    return false;
  }
  let tb = g.blocks[ti];
  return tb.preds.len() == 1 && tb.preds[0] == from && !has_phi(tb);
}

function join_phis(g: ssa.SFunc, c: Join): boolean[] {
  let out = __alloc_bool(g.nvals);
  for ins in g.blocks[c.j].insts {
    if (ins.kind_tag == ssa.PHI && ins.result >= 0 && ins.result < out.len()) {
      out = out.with(ins.result, true);
    }
  }
  return out;
}

// The arm whose region holds the block at xi: t, f, or -1 for neither.
function arm_of(dom: ssadeps.Dom, c: Join, xi: i32): i32 {
  if (ssadeps.dom_holds(dom, xi, c.t)) {
    return c.t;
  }
  if (ssadeps.dom_holds(dom, xi, c.f)) {
    return c.f;
  }
  return -1;
}

function skipped_block(c: Join, xi: i32): boolean {
  return xi == c.j || util.index_of_i32(c.chain, xi) >= 0;
}

// Every read of a join phi, outside the join and its chain, lies in one arm:
// an instruction in a block the arm dominates, or a phi operand on an edge
// from such a block. A read elsewhere would need a phi at a merge of the arms.
function reads_under_arms(g: ssa.SFunc, at: i32[], dom: ssadeps.Dom, c: Join): boolean {
  let is_phi = join_phis(g, c);
  for xi in 0..g.blocks.len() {
    let b = g.blocks[xi];
    if (xi == c.j) {
      for ins in b.insts {
        if (ins.kind_tag == ssa.PHI) {
          for a in ins.args {
            if (a >= 0 && a < is_phi.len() && is_phi[a]) {
              return false;
            }
          }
        }
      }
    } else if (!skipped_block(c, xi)) {
      let here = arm_of(dom, c, xi);
      for ins in b.insts {
        for k in 0..ins.args.len() {
          let a = ins.args[k];
          if (a >= 0 && a < is_phi.len() && is_phi[a]) {
            let where = here;
            if (ins.kind_tag == ssa.PHI) {
              where = -1;
              if (k < b.preds.len() && b.preds[k] >= 0 && b.preds[k] < at.len() && at[b.preds[k]] >= 0) {
                where = arm_of(dom, c, at[b.preds[k]]);
              }
            }
            if (where < 0) {
              return false;
            }
          }
        }
      }
      let tv = term_read(b.term);
      if (tv >= 0 && tv < is_phi.len() && is_phi[tv] && here < 0) {
        return false;
      }
    }
  }
  return true;
}

function term_read(t: ssa.STerm): i32 {
  if (t.kind_tag == 1) {
    return t.value;
  }
  if (t.kind_tag == 3) {
    return t.cond;
  }
  return -1;
}

function same_pick(defs: ssa.SInst[], a: i32, b: i32): boolean {
  if (a == b) {
    return true;
  }
  let da = through_copies(defs, a);
  let db = through_copies(defs, b);
  let k = da.kind_tag;
  if (k != db.kind_tag || k != 1 && k != 2 && k != 3 && k != 5) {
    return false;
  }
  return da.args.len() == 0 && db.args.len() == 0 && da.imm == db.imm && da.str == db.str;
}

struct Split { f: ssasem.Func, blocks: ssa.SBlock[], val: i32[] }

// The value a join phi has in one arm: the operand of the one predecessor the
// arm takes, or a new phi at the arm's head over the predecessors it takes.
function arm_values(s0: Split, g: ssa.SFunc, defs: ssa.SInst[], c: Join, ti: i32, pick: i32, needed: boolean[]): Split {
  let s = s0;
  let jb = g.blocks[c.j];
  let tb = g.blocks[ti];
  let preds: i32[] = [];
  for i in 0..jb.preds.len() {
    if (c.picks[i] == pick) {
      preds = preds.append(jb.preds[i]);
    }
  }
  let phis: ssa.SInst[] = [];
  let consts: ssa.SInst[] = [];
  for ins in jb.insts {
    if (ins.kind_tag != ssa.PHI || ins.result < 0 || ins.result >= needed.len() || !needed[ins.result] || preds.len() == 0) {
      continue;
    }
    let args: i32[] = [];
    let one = true;
    let same = true;
    for i in 0..jb.preds.len() {
      if (c.picks[i] == pick) {
        if (args.len() > 0 && args[0] != ins.args[i]) {
          one = false;
          if (!same_pick(defs, args[0], ins.args[i])) {
            same = false;
          }
        }
        args = args.append(ins.args[i]);
      }
    }
    if (one) {
      s = Split { ...s, val: s.val.with(ins.result, args[0]) };
      continue;
    }
    let id = s.f.values.len();
    s = Split { ...s, f: ssasem.Func { ...s.f, values: s.f.values.append(s.f.values[ins.result]) }, val: s.val.with(ins.result, id) };
    if (same) {
      // The same constant under a different id in each arm: a value defined
      // in one arm reaches the join, and not the other arms, so the arm gets
      // a constant of its own.
      consts = consts.append(ssa.SInst { ...through_copies(defs, args[0]), result: id, args: [] });
    } else {
      phis = phis.append(ssa.SInst { kind_tag: ssa.PHI, result: id, args: args, imm: 0, str: "" });
    }
  }
  let insts = phis;
  for k in consts {
    insts = insts.append(k);
  }
  for ins in tb.insts {
    insts = insts.append(ins);
  }
  return Split { ...s, blocks: s.blocks.with(ti, ssa.SBlock { ...tb, insts: insts, preds: preds }) };
}

// Which join phis each arm reads.
function arm_needs(g: ssa.SFunc, at: i32[], dom: ssadeps.Dom, c: Join, ti: i32): boolean[] {
  let is_phi = join_phis(g, c);
  let out = __alloc_bool(g.nvals);
  for xi in 0..g.blocks.len() {
    let b = g.blocks[xi];
    if (!skipped_block(c, xi)) {
      let here = arm_of(dom, c, xi) == ti;
      for ins in b.insts {
        for k in 0..ins.args.len() {
          let a = ins.args[k];
          if (a >= 0 && a < is_phi.len() && is_phi[a]) {
            let where = here;
            if (ins.kind_tag == ssa.PHI) {
              where = arm_of(dom, c, at[b.preds[k]]) == ti;
            }
            if (where) {
              out = out.with(a, true);
            }
          }
        }
      }
      let tv = term_read(b.term);
      if (tv >= 0 && tv < is_phi.len() && is_phi[tv] && here) {
        out = out.with(tv, true);
      }
    }
  }
  return out;
}

function split_join(f: ssasem.Func, at: i32[], dom: ssadeps.Dom, c: Join): ssasem.Func {
  let g = f.graph;
  let defs = ssa.inst_defs(g);
  let jb = g.blocks[c.j];
  let is_phi = join_phis(g, c);
  let s = Split { f: f, blocks: g.blocks, val: util.minus_ones(g.nvals) };
  let val_t: i32[] = [];
  let val_f: i32[] = [];
  s = arm_values(s, g, defs, c, c.t, 1, arm_needs(g, at, dom, c, c.t));
  val_t = s.val;
  s = Split { ...s, val: util.minus_ones(g.nvals) };
  s = arm_values(s, g, defs, c, c.f, 0, arm_needs(g, at, dom, c, c.f));
  val_f = s.val;
  let blocks = s.blocks;
  for i in 0..jb.preds.len() {
    let qi = at[jb.preds[i]];
    let target = g.blocks[c.f].id;
    if (c.picks[i] == 1) {
      target = g.blocks[c.t].id;
    }
    blocks = blocks.with(qi, ssa.SBlock { ...blocks[qi], term: jump(target) });
  }
  let ei = at[g.entry];
  let moved = blocks[ei].insts;
  for ins in jb.insts {
    if (movable_constant(ins)) {
      moved = moved.append(ins);
    }
  }
  blocks = blocks.with(ei, ssa.SBlock { ...blocks[ei], insts: moved });
  blocks = blocks.with(c.j, ssa.SBlock { ...jb, insts: [], preds: [] });
  for ch in c.chain {
    blocks = blocks.with(ch, ssa.SBlock { ...blocks[ch], insts: [], preds: [] });
  }
  for xi in 0..blocks.len() {
    if (!skipped_block(c, xi)) {
      let b = blocks[xi];
      let here = arm_of(dom, c, xi);
      let insts: ssa.SInst[] = [];
      let changed = false;
      for ins in b.insts {
        let args = ins.args;
        for k in 0..args.len() {
          let a = args[k];
          if (a >= 0 && a < is_phi.len() && is_phi[a]) {
            let where = here;
            if (ins.kind_tag == ssa.PHI) {
              where = arm_of(dom, c, at[b.preds[k]]);
            }
            args = args.with(k, arm_value(val_t, val_f, c, where, a));
            changed = true;
          }
        }
        insts = insts.append(ssa.SInst { ...ins, args: args });
      }
      let term = b.term;
      let tv = term_read(term);
      if (tv >= 0 && tv < is_phi.len() && is_phi[tv]) {
        let nv = arm_value(val_t, val_f, c, here, tv);
        if (term.kind_tag == ssa.TERM_RET) {
          term = ssa.STerm { ...term, value: nv };
        } else {
          term = ssa.STerm { ...term, cond: nv };
        }
        changed = true;
      }
      if (changed) {
        blocks = blocks.with(xi, ssa.SBlock { ...b, insts: insts, term: term });
      }
    }
  }
  let g2 = ssa.SFunc { ...g, blocks: blocks, nvals: s.f.values.len() };
  let kept = ssa.SFunc { ...g2, blocks: reachable_only(g2) };
  return ssasem.Func { ...s.f, graph: ssa.SFunc { ...kept, blocks: ssa.refreshed_preds(kept) } };
}

function arm_value(val_t: i32[], val_f: i32[], c: Join, where: i32, a: i32): i32 {
  if (where == c.t) {
    return val_t[a];
  }
  return val_f[a];
}
