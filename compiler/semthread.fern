import "./ssa";
import "./ssadeps";
import "./ssasem";
import "./semrecords";
import "./typeinfo";
import "./util";

pub struct Threaded { f: ssasem.Func, changed: i32 }

pub function thread(f: ssasem.Func): Threaded {
  let g: ssa.SFunc = f.graph;
  let changed: i32 = 0;
  if (decidable(g)) {
    let round: i32 = 0;
    while (round < 8) {
      let r: Round = thread_round(f, g);
      if (r.changed == 0) {
        break;
      }
      g = r.g;
      changed = changed + r.changed;
      round = round + 1;
    }
  }
  let cur: ssasem.Func = f;
  if (changed > 0) {
    cur = ssasem.Func { ...f, graph: g };
  }
  let j: Joined = split_constant_joins(cur);
  if (j.changed > 0) {
    cur = j.f;
    changed = changed + j.changed;
  }
  if (changed == 0) {
    return Threaded { f: f, changed: 0 };
  }
  return Threaded { f: cur, changed: changed };
}

struct Round { g: ssa.SFunc, changed: i32 }

function decidable(g: ssa.SFunc): boolean {
  let up: i32[] = util.minus_ones(g.nvals);
  let constant: boolean[] = __alloc_bool(g.nvals);
  let tested: i32[] = [];
  for b in g.blocks {
    for ins in b.insts {
      if (ins.result < 0 || ins.result >= g.nvals) {
        continue;
      }
      let k: i32 = ins.kind_tag;
      if (k == 2) {
        constant = constant.with(ins.result, true);
      } else if (ins.args.len() == 1 && (k == 7 || k == ssasem.variant_get() || k == ssasem.record_get() || k == ssasem.tuple_get())) {
        up = up.with(ins.result, ins.args[0]);
      } else if (k == ssasem.variant_is() && ins.args.len() == 1) {
        tested = tested.append(ins.args[0]);
      }
    }
  }
  for b in g.blocks {
    if (b.term.kind_tag == 3 && b.term.cond >= 0 && b.term.cond < g.nvals && constant[b.term.cond]) {
      return true;
    }
  }
  let roots: i32[] = [];
  for v in tested {
    let r: i32 = v;
    let hops: i32 = 0;
    while (r >= 0 && r < g.nvals && up[r] >= 0 && hops < 32) {
      r = up[r];
      hops = hops + 1;
    }
    if (util.index_of_i32(roots, r) >= 0) {
      return true;
    }
    roots = roots.append(r);
  }
  return false;
}

struct Seen { at: i32[], defs: ssa.SInst[], uses: i32[], facts: Facts, head: i32[], on_t: i32[], on_f: i32[] }

function thread_round(f: ssasem.Func, g: ssa.SFunc): Round {
  let n: i32 = g.blocks.len();
  let none: i32[] = util.minus_ones(n);
  let s: Seen = Seen { at: ssadeps.position_of(g), defs: definitions(g), uses: ssa.use_counts(g), facts: no_facts(), head: none, on_t: none, on_f: none };
  s = block_facts(f, g, s);
  let blocks: ssa.SBlock[] = g.blocks;
  let changed: i32 = 0;
  let bi: i32 = 0;
  while (bi < n) {
    let b: ssa.SBlock = g.blocks[bi];
    let t: ssa.STerm = moved_term(f, g, s, bi, decided_term(f, s, bi, b.term));
    if (!same_term(t, b.term)) {
      changed = changed + 1;
      blocks = blocks.with(bi, ssa.SBlock { ...b, term: t });
    }
    bi = bi + 1;
  }
  if (changed == 0) {
    return Round { g: g, changed: 0 };
  }
  let moved: ssa.SFunc = ssa.SFunc { ...g, blocks: blocks };
  let kept: ssa.SFunc = ssa.SFunc { ...moved, blocks: reachable_only(moved) };
  let fresh: ssa.SFunc = ssa.SFunc { ...kept, blocks: ssa.refreshed_preds(kept) };
  return Round { g: ssa.SFunc { ...fresh, blocks: untested(fresh) }, changed: changed };
}

function decided_term(f: ssasem.Func, s: Seen, bi: i32, t: ssa.STerm): ssa.STerm {
  if (t.kind_tag != 3 || t.t == t.f) {
    return t;
  }
  let d: i32 = outcome(f, s, s.head[bi], no_facts(), t.cond);
  if (d == 1) {
    return jump(t.t);
  }
  if (d == 0) {
    return jump(t.f);
  }
  return t;
}

function outcome(f: ssasem.Func, s: Seen, h: i32, path: Facts, cond: i32): i32 {
  let c: ssa.SInst = through_copies(s.defs, cond);
  if (c.kind_tag == 2) {
    if (c.imm != 0) {
      return 1;
    }
    return 0;
  }
  let q: Test = test_of(f, s.defs, cond);
  if (!q.ok) {
    return 0 - 1;
  }
  let d: i32 = decide(f, s.facts, h, path, q);
  if (d < 0 || q.yes) {
    return d;
  }
  return 1 - d;
}

function moved_term(f: ssasem.Func, g: ssa.SFunc, s: Seen, bi: i32, t: ssa.STerm): ssa.STerm {
  if (t.kind_tag == 2) {
    return jump(reached(f, g, s, s.head[bi], t.target));
  }
  if (t.kind_tag != 3) {
    return t;
  }
  if (t.t == t.f) {
    return jump(reached(f, g, s, s.head[bi], t.t));
  }
  let ht: i32 = s.on_t[bi];
  let hf: i32 = s.on_f[bi];
  if (ht < 0) {
    ht = s.head[bi];
    hf = s.head[bi];
  }
  let nt: i32 = reached(f, g, s, ht, t.t);
  let nf: i32 = reached(f, g, s, hf, t.f);
  if (nt == nf) {
    return jump(nt);
  }
  return ssa.STerm { ...t, t: nt, f: nf };
}

function reached(f: ssasem.Func, g: ssa.SFunc, s: Seen, h: i32, id: i32): i32 {
  let cur: i32 = id;
  let landed: i32 = id;
  let path: Facts = no_facts();
  let hops: i32 = 0;
  while (hops < 16) {
    let b: ssa.SBlock = g.blocks[s.at[cur]];
    let next: i32 = 0 - 1;
    if (b.insts.len() == 0 && b.term.kind_tag == 2) {
      next = b.term.target;
    } else if (only_tests(s, b)) {
      let d: i32 = outcome(f, s, h, path, b.term.cond);
      if (d >= 0) {
        path = with_fact(path, test_of(f, s.defs, b.term.cond), d == 1, 0 - 1);
        next = b.term.f;
        if (d == 1) {
          next = b.term.t;
        }
      }
    }
    if (next < 0 || next == cur || next == g.entry || has_phi(g.blocks[s.at[next]])) {
      return landed;
    }
    if (b.insts.len() > 0) {
      landed = next;
    }
    cur = next;
    hops = hops + 1;
  }
  return landed;
}

function only_tests(s: Seen, b: ssa.SBlock): boolean {
  if (b.insts.len() != 1 || b.term.kind_tag != 3 || b.term.t == b.term.f) {
    return false;
  }
  let ins: ssa.SInst = b.insts[0];
  return ins.kind_tag == ssasem.variant_is() && ins.result == b.term.cond && s.uses[ins.result] == 1;
}

struct Facts { root: i32[], path: string[], variant: string[], is: boolean[], up: i32[] }

function no_facts(): Facts {
  return Facts { root: [], path: [], variant: [], is: [], up: [] };
}

function with_fact(own facts: Facts, q: Test, taken: boolean, up: i32): Facts {
  return Facts { root: facts.root.append(q.root), path: facts.path.append(q.path), variant: facts.variant.append(q.variant), is: facts.is.append(taken == q.yes), up: facts.up.append(up) };
}

struct Test { ok: boolean, root: i32, path: string, variant: string, ty: typeinfo.Type, yes: boolean }

function test_of(f: ssasem.Func, defs: ssa.SInst[], cond: i32): Test {
  let yes: boolean = true;
  let d: ssa.SInst = through_copies(defs, cond);
  let hops: i32 = 0;
  while (d.kind_tag == 10 && d.str == "!" && d.args.len() == 1 && hops < 8) {
    yes = !yes;
    d = through_copies(defs, d.args[0]);
    hops = hops + 1;
  }
  if (d.kind_tag != ssasem.variant_is() || d.args.len() != 1 || d.args[0] < 0) {
    return Test { ok: false, root: 0 - 1, path: "", variant: "", ty: f.values[0], yes: false };
  }
  let k: Key = key_of(defs, d.args[0]);
  return Test { ok: true, root: k.root, path: k.path, variant: d.str, ty: f.values[d.args[0]], yes: yes };
}

struct Key { root: i32, path: string }

function key_of(defs: ssa.SInst[], v: i32): Key {
  let d: ssa.SInst = through_copies(defs, v);
  let k: i32 = d.kind_tag;
  let reads: boolean = k == ssasem.variant_get() || k == ssasem.record_get() || k == ssasem.tuple_get();
  if (!reads || d.args.len() != 1 || d.args[0] < 0) {
    return Key { root: d.result, path: "" };
  }
  let from: Key = key_of(defs, d.args[0]);
  return Key { root: from.root, path: from.path + "." + util.i32_to_string(k) + ":" + util.i32_to_string(d.imm) + ":" + d.str };
}

function decide(f: ssasem.Func, facts: Facts, h: i32, path: Facts, q: Test): i32 {
  let ruled: string[] = [];
  let i: i32 = path.root.len() - 1;
  while (i >= 0) {
    let d: i32 = fact_says(path, i, q);
    if (d >= 0) {
      return d;
    }
    if (d == 0 - 2) {
      ruled = ruled.append(path.variant[i]);
    }
    i = i - 1;
  }
  let at: i32 = h;
  let hops: i32 = 0;
  while (at >= 0 && hops < 64) {
    let d: i32 = fact_says(facts, at, q);
    if (d >= 0) {
      return d;
    }
    if (d == 0 - 2) {
      ruled = ruled.append(facts.variant[at]);
    }
    at = facts.up[at];
    hops = hops + 1;
  }
  if (ruled.len() == 0) {
    return 0 - 1;
  }
  let e: i32 = semrecords.find_enum(f.enums, q.ty);
  if (e < 0) {
    return 0 - 1;
  }
  for v in f.enums[e].variants {
    if (v.name != q.variant && util.index_of_str(ruled, v.name) < 0) {
      return 0 - 1;
    }
  }
  return 1;
}

function fact_says(facts: Facts, i: i32, q: Test): i32 {
  if (facts.root[i] != q.root || facts.path[i] != q.path) {
    return 0 - 1;
  }
  if (facts.is[i]) {
    if (facts.variant[i] == q.variant) {
      return 1;
    }
    return 0;
  }
  if (facts.variant[i] == q.variant) {
    return 0;
  }
  return 0 - 2;
}

function block_facts(f: ssasem.Func, g: ssa.SFunc, s: Seen): Seen {
  let dom: ssadeps.Dom = ssadeps.dominates(g);
  let facts: Facts = no_facts();
  let head: i32[] = s.head;
  let on_t: i32[] = s.on_t;
  let on_f: i32[] = s.on_f;
  for bi in dom.by_clock {
    if (bi < 0) {
      continue;
    }
    let id: i32 = dom.idom[bi];
    if (id < 0) {
      continue;
    }
    let b: ssa.SBlock = g.blocks[bi];
    if (id != bi) {
      let h: i32 = head[id];
      if (b.preds.len() == 1 && s.at[b.preds[0]] == id && on_t[id] >= 0) {
        h = on_f[id];
        if (g.blocks[id].term.t == b.id) {
          h = on_t[id];
        }
      }
      head = head.with(bi, h);
    }
    if (b.term.kind_tag == 3 && b.term.t != b.term.f) {
      let q: Test = test_of(f, s.defs, b.term.cond);
      if (q.ok) {
        on_t = on_t.with(bi, facts.root.len());
        facts = with_fact(facts, q, true, head[bi]);
        on_f = on_f.with(bi, facts.root.len());
        facts = with_fact(facts, q, false, head[bi]);
      }
    }
  }
  return Seen { ...s, facts: facts, head: head, on_t: on_t, on_f: on_f };
}

function jump(target: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function same_term(a: ssa.STerm, b: ssa.STerm): boolean {
  return a.kind_tag == b.kind_tag && a.cond == b.cond && a.target == b.target && a.t == b.t && a.f == b.f && a.value == b.value;
}

function has_phi(b: ssa.SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag == 8) {
      return true;
    }
  }
  return false;
}

pub function reachable_only(g: ssa.SFunc): ssa.SBlock[] {
  let live: boolean[] = ssadeps.reachable_blocks(g);
  let out: ssa.SBlock[] = [];
  let i: i32 = 0;
  while (i < g.blocks.len()) {
    if (live[i]) {
      out = out.append(g.blocks[i]);
    }
    i = i + 1;
  }
  return out;
}

function untested(g: ssa.SFunc): ssa.SBlock[] {
  let uses: i32[] = ssa.use_counts(g);
  let out: ssa.SBlock[] = [];
  for b in g.blocks {
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      if (ins.kind_tag != ssasem.variant_is() || ins.result < 0 || uses[ins.result] > 0) {
        insts = insts.append(ins);
      }
    }
    out = out.append(ssa.SBlock { ...b, insts: insts });
  }
  return out;
}

function definitions(g: ssa.SFunc): ssa.SInst[] {
  let none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let out: ssa.SInst[] = [];
  while (out.len() < g.nvals) {
    out = out.append(none);
  }
  for b in g.blocks {
    for ins in b.insts {
      if (ins.result >= 0 && ins.result < out.len()) {
        out = out.with(ins.result, ins);
      }
    }
  }
  return out;
}

function through_copies(defs: ssa.SInst[], v: i32): ssa.SInst {
  if (v < 0 || v >= defs.len()) {
    return ssa.SInst { kind_tag: 0, result: v, args: [], imm: 0, str: "" };
  }
  let d: ssa.SInst = defs[v];
  let hops: i32 = 0;
  while (d.kind_tag == 7 && d.args.len() == 1 && d.args[0] >= 0 && hops < 16) {
    d = defs[d.args[0]];
    hops = hops + 1;
  }
  if (d.result < 0) {
    return ssa.SInst { ...d, result: v };
  }
  return d;
}

// A call that returns its variant in two words meets the match on its result
// as a join: a phi per payload word, and a boolean phi that is true on the Ok
// edge and false on the Err edge, which the match branches on. Each
// predecessor of such a join has decided that branch. It goes to the arm its
// constant picks, the join goes, and a payload phi an arm reads becomes the
// operand of the one predecessor that reaches the arm, or a phi of the
// predecessors that do.

struct Joined { f: ssasem.Func, changed: i32 }

function split_constant_joins(f0: ssasem.Func): Joined {
  let f: ssasem.Func = f0;
  let changed: i32 = 0;
  for _ in 0..16 {
    let fw: Forwarded = forward_empty_joins(f.graph);
    if (fw.changed > 0) {
      f = ssasem.Func { ...f, graph: fw.g };
      changed = changed + fw.changed;
    }
    let r: Joined = split_round(f);
    if (r.changed == 0) {
      break;
    }
    f = r.f;
    changed = changed + r.changed;
  }
  if (changed == 0) {
    return Joined { f: f0, changed: 0 };
  }
  return Joined { f: f, changed: changed };
}

struct Forwarded { g: ssa.SFunc, changed: i32 }

// An empty block that jumps to a join is left out: each of its predecessors
// jumps to the join, and each phi reads on the new edge what it read on the
// old one. A predecessor that branches keeps the block, so that no edge
// carries both a condition and a phi.
function forward_empty_joins(g0: ssa.SFunc): Forwarded {
  let g: ssa.SFunc = g0;
  let changed: i32 = 0;
  for round in 0..64 {
    let at: i32[] = ssadeps.position_of(g);
    let yi: i32 = first_forwardable(g, at);
    if (yi < 0) {
      break;
    }
    g = forward_block(g, at, yi);
    changed = round + 1;
  }
  if (changed == 0) {
    return Forwarded { g: g0, changed: 0 };
  }
  let kept: ssa.SFunc = ssa.SFunc { ...g, blocks: reachable_only(g) };
  return Forwarded { g: ssa.SFunc { ...kept, blocks: ssa.refreshed_preds(kept) }, changed: changed };
}

function first_forwardable(g: ssa.SFunc, at: i32[]): i32 {
  for yi in 0..g.blocks.len() {
    if (forwardable(g, at, yi)) {
      return yi;
    }
  }
  return 0 - 1;
}

function forwardable(g: ssa.SFunc, at: i32[], yi: i32): boolean {
  let y: ssa.SBlock = g.blocks[yi];
  if (y.insts.len() != 0 || y.term.kind_tag != 2 || y.preds.len() == 0 || y.id == g.entry) {
    return false;
  }
  let x: i32 = y.term.target;
  if (x == y.id || x < 0 || x >= at.len() || at[x] < 0) {
    return false;
  }
  let xb: ssa.SBlock = g.blocks[at[x]];
  if (!has_phi(xb) || util.index_of_i32(xb.preds, y.id) < 0) {
    return false;
  }
  for q in y.preds {
    if (q == y.id || q < 0 || q >= at.len() || at[q] < 0) {
      return false;
    }
    let qb: ssa.SBlock = g.blocks[at[q]];
    if (qb.term.kind_tag != 2 || qb.term.target != y.id || util.index_of_i32(xb.preds, q) >= 0) {
      return false;
    }
  }
  return true;
}

function forward_block(g: ssa.SFunc, at: i32[], yi: i32): ssa.SFunc {
  let y: ssa.SBlock = g.blocks[yi];
  let xi: i32 = at[y.term.target];
  let xb: ssa.SBlock = g.blocks[xi];
  let slot: i32 = util.index_of_i32(xb.preds, y.id);
  let preds: i32[] = [];
  for i in 0..xb.preds.len() {
    if (i == slot) {
      for q in y.preds {
        preds = preds.append(q);
      }
    } else {
      preds = preds.append(xb.preds[i]);
    }
  }
  let insts: ssa.SInst[] = [];
  for ins in xb.insts {
    if (ins.kind_tag == 8) {
      let args: i32[] = [];
      for k in 0..ins.args.len() {
        if (k == slot) {
          for q in y.preds {
            args = args.append(ins.args[k]);
          }
        } else {
          args = args.append(ins.args[k]);
        }
      }
      insts = insts.append(ssa.SInst { ...ins, args: args });
    } else {
      insts = insts.append(ins);
    }
  }
  let blocks: ssa.SBlock[] = g.blocks.with(xi, ssa.SBlock { ...xb, insts: insts, preds: preds });
  for q in y.preds {
    let qi: i32 = at[q];
    blocks = blocks.with(qi, ssa.SBlock { ...blocks[qi], term: jump(xb.id) });
  }
  blocks = blocks.with(yi, ssa.SBlock { ...y, preds: [] });
  return ssa.SFunc { ...g, blocks: blocks };
}

// j and b are positions: the join, and the block that branches on its phi,
// which is j itself or the last of chain. picks has one entry per
// predecessor of the join: 1 for the true arm, 0 for the false arm. t and f
// are the arms' positions.
struct Join { ok: boolean, j: i32, chain: i32[], b: i32, picks: i32[], t: i32, f: i32 }

function no_join(ji: i32): Join {
  return Join { ok: false, j: ji, chain: [], b: ji, picks: [], t: 0 - 1, f: 0 - 1 };
}

function split_round(f: ssasem.Func): Joined {
  let g: ssa.SFunc = f.graph;
  let at: i32[] = ssadeps.position_of(g);
  let uses: i32[] = ssa.use_counts(g);
  let defs: ssa.SInst[] = definitions(g);
  let dom: ssadeps.Dom = ssadeps.dominates(g);
  for ji in 0..g.blocks.len() {
    let c: Join = constant_join(g, at, uses, defs, dom, ji);
    if (c.ok) {
      return Joined { f: split_join(f, at, dom, c), changed: 1 };
    }
  }
  return Joined { f: f, changed: 0 };
}

function dead_copy(uses: i32[], ins: ssa.SInst): boolean {
  return ins.kind_tag == 7 && ins.result >= 0 && ins.result < uses.len() && uses[ins.result] == 0;
}

function movable_constant(ins: ssa.SInst): boolean {
  let k: i32 = ins.kind_tag;
  return ins.args.len() == 0 && ins.result >= 0 && (k == 1 || k == 2 || k == 3 || k == 5 || k == ssasem.zero());
}

function constant_join(g: ssa.SFunc, at: i32[], uses: i32[], defs: ssa.SInst[], dom: ssadeps.Dom, ji: i32): Join {
  let none: Join = no_join(ji);
  let jb: ssa.SBlock = g.blocks[ji];
  if (jb.id == g.entry || jb.preds.len() == 0) {
    return none;
  }
  let any_phi: boolean = false;
  for ins in jb.insts {
    if (ins.kind_tag == 8) {
      any_phi = true;
    } else if (!dead_copy(uses, ins) && !movable_constant(ins)) {
      return none;
    }
  }
  if (!any_phi) {
    return none;
  }
  let chain: i32[] = [];
  let bi: i32 = ji;
  for _ in 0..16 {
    if (g.blocks[bi].term.kind_tag != 2) {
      break;
    }
    let target: i32 = g.blocks[bi].term.target;
    if (target < 0 || target >= at.len() || at[target] < 0) {
      return none;
    }
    let next: i32 = at[target];
    let nb: ssa.SBlock = g.blocks[next];
    if (next == ji || nb.preds.len() != 1 || nb.preds[0] != g.blocks[bi].id) {
      return none;
    }
    for ins in nb.insts {
      if (!dead_copy(uses, ins)) {
        return none;
      }
    }
    chain = chain.append(next);
    bi = next;
  }
  let bb: ssa.SBlock = g.blocks[bi];
  if (bb.term.kind_tag != 3 || bb.term.t == bb.term.f) {
    return none;
  }
  let cond: ssa.SInst = phi_of(jb, bb.term.cond);
  if (cond.kind_tag != 8 || cond.args.len() != jb.preds.len()) {
    return none;
  }
  let picks: i32[] = [];
  for a in cond.args {
    let d: ssa.SInst = through_copies(defs, a);
    if (d.kind_tag != 1 && d.kind_tag != 2 || d.args.len() != 0) {
      return none;
    }
    if (d.imm != 0) {
      picks = picks.append(1);
    } else {
      picks = picks.append(0);
    }
  }
  for q in jb.preds {
    if (q < 0 || q >= at.len() || at[q] < 0) {
      return none;
    }
    let qi: i32 = at[q];
    let qb: ssa.SBlock = g.blocks[qi];
    if (qi == ji || qb.term.kind_tag != 2 || qb.term.target != jb.id || ssadeps.dom_holds(dom, qi, ji)) {
      return none;
    }
  }
  if (bb.term.t < 0 || bb.term.t >= at.len() || bb.term.f < 0 || bb.term.f >= at.len()) {
    return none;
  }
  let ti: i32 = at[bb.term.t];
  let fi: i32 = at[bb.term.f];
  if (!plain_arm(g, ti, bb.id, ji, chain) || !plain_arm(g, fi, bb.id, ji, chain)) {
    return none;
  }
  let c: Join = Join { ok: true, j: ji, chain: chain, b: bi, picks: picks, t: ti, f: fi };
  if (!reads_under_arms(g, at, dom, c)) {
    return none;
  }
  return c;
}

function phi_of(b: ssa.SBlock, v: i32): ssa.SInst {
  for ins in b.insts {
    if (ins.kind_tag == 8 && ins.result == v) {
      return ins;
    }
  }
  return ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
}

// An arm is entered from the branch alone, holds no phi, and is neither the
// join nor one of the blocks between it and the branch.
function plain_arm(g: ssa.SFunc, ti: i32, from: i32, ji: i32, chain: i32[]): boolean {
  if (ti < 0 || ti == ji || util.index_of_i32(chain, ti) >= 0) {
    return false;
  }
  let tb: ssa.SBlock = g.blocks[ti];
  return tb.preds.len() == 1 && tb.preds[0] == from && !has_phi(tb);
}

function join_phis(g: ssa.SFunc, c: Join): boolean[] {
  let out: boolean[] = __alloc_bool(g.nvals);
  for ins in g.blocks[c.j].insts {
    if (ins.kind_tag == 8 && ins.result >= 0 && ins.result < out.len()) {
      out = out.with(ins.result, true);
    }
  }
  return out;
}

// The arm whose region holds the block at xi: t, f, or -1 for neither.
function arm_of(dom: ssadeps.Dom, c: Join, xi: i32): i32 {
  if (ssadeps.dom_holds(dom, xi, c.t)) {
    return c.t;
  }
  if (ssadeps.dom_holds(dom, xi, c.f)) {
    return c.f;
  }
  return 0 - 1;
}

function skipped_block(c: Join, xi: i32): boolean {
  return xi == c.j || util.index_of_i32(c.chain, xi) >= 0;
}

// Every read of a join phi, outside the join and its chain, lies in one arm:
// an instruction in a block the arm dominates, or a phi operand on an edge
// from such a block. A read elsewhere would need a phi at a merge of the arms.
function reads_under_arms(g: ssa.SFunc, at: i32[], dom: ssadeps.Dom, c: Join): boolean {
  let is_phi: boolean[] = join_phis(g, c);
  for xi in 0..g.blocks.len() {
    let b: ssa.SBlock = g.blocks[xi];
    if (xi == c.j) {
      for ins in b.insts {
        if (ins.kind_tag == 8) {
          for a in ins.args {
            if (a >= 0 && a < is_phi.len() && is_phi[a]) {
              return false;
            }
          }
        }
      }
    } else if (!skipped_block(c, xi)) {
      let here: i32 = arm_of(dom, c, xi);
      for ins in b.insts {
        for k in 0..ins.args.len() {
          let a: i32 = ins.args[k];
          if (a >= 0 && a < is_phi.len() && is_phi[a]) {
            let where: i32 = here;
            if (ins.kind_tag == 8) {
              where = 0 - 1;
              if (k < b.preds.len() && b.preds[k] >= 0 && b.preds[k] < at.len() && at[b.preds[k]] >= 0) {
                where = arm_of(dom, c, at[b.preds[k]]);
              }
            }
            if (where < 0) {
              return false;
            }
          }
        }
      }
      let tv: i32 = term_read(b.term);
      if (tv >= 0 && tv < is_phi.len() && is_phi[tv] && here < 0) {
        return false;
      }
    }
  }
  return true;
}

function term_read(t: ssa.STerm): i32 {
  if (t.kind_tag == 1) {
    return t.value;
  }
  if (t.kind_tag == 3) {
    return t.cond;
  }
  return 0 - 1;
}

function same_pick(defs: ssa.SInst[], a: i32, b: i32): boolean {
  if (a == b) {
    return true;
  }
  let da: ssa.SInst = through_copies(defs, a);
  let db: ssa.SInst = through_copies(defs, b);
  let k: i32 = da.kind_tag;
  if (k != db.kind_tag || k != 1 && k != 2 && k != 3 && k != 5) {
    return false;
  }
  return da.args.len() == 0 && db.args.len() == 0 && da.imm == db.imm && da.str == db.str;
}

struct Split { f: ssasem.Func, blocks: ssa.SBlock[], val: i32[] }

// The value a join phi has in one arm: the operand of the one predecessor the
// arm takes, or a new phi at the arm's head over the predecessors it takes.
function arm_values(s0: Split, g: ssa.SFunc, defs: ssa.SInst[], c: Join, ti: i32, pick: i32, needed: boolean[]): Split {
  let s: Split = s0;
  let jb: ssa.SBlock = g.blocks[c.j];
  let tb: ssa.SBlock = g.blocks[ti];
  let preds: i32[] = [];
  for i in 0..jb.preds.len() {
    if (c.picks[i] == pick) {
      preds = preds.append(jb.preds[i]);
    }
  }
  let phis: ssa.SInst[] = [];
  let consts: ssa.SInst[] = [];
  for ins in jb.insts {
    if (ins.kind_tag != 8 || ins.result < 0 || ins.result >= needed.len() || !needed[ins.result] || preds.len() == 0) {
      continue;
    }
    let args: i32[] = [];
    let one: boolean = true;
    let same: boolean = true;
    for i in 0..jb.preds.len() {
      if (c.picks[i] == pick) {
        if (args.len() > 0 && args[0] != ins.args[i]) {
          one = false;
          if (!same_pick(defs, args[0], ins.args[i])) {
            same = false;
          }
        }
        args = args.append(ins.args[i]);
      }
    }
    if (one) {
      s = Split { ...s, val: s.val.with(ins.result, args[0]) };
      continue;
    }
    let id: i32 = s.f.values.len();
    s = Split { ...s, f: ssasem.Func { ...s.f, values: s.f.values.append(s.f.values[ins.result]) }, val: s.val.with(ins.result, id) };
    if (same) {
      // The same constant under a different id in each arm: a value defined
      // in one arm reaches the join, and not the other arms, so the arm gets
      // a constant of its own.
      consts = consts.append(ssa.SInst { ...through_copies(defs, args[0]), result: id, args: [] });
    } else {
      phis = phis.append(ssa.SInst { kind_tag: 8, result: id, args: args, imm: 0, str: "" });
    }
  }
  let insts: ssa.SInst[] = phis;
  for k in consts {
    insts = insts.append(k);
  }
  for ins in tb.insts {
    insts = insts.append(ins);
  }
  return Split { ...s, blocks: s.blocks.with(ti, ssa.SBlock { ...tb, insts: insts, preds: preds }) };
}

// Which join phis each arm reads.
function arm_needs(g: ssa.SFunc, at: i32[], dom: ssadeps.Dom, c: Join, ti: i32): boolean[] {
  let is_phi: boolean[] = join_phis(g, c);
  let out: boolean[] = __alloc_bool(g.nvals);
  for xi in 0..g.blocks.len() {
    let b: ssa.SBlock = g.blocks[xi];
    if (!skipped_block(c, xi)) {
      let here: boolean = arm_of(dom, c, xi) == ti;
      for ins in b.insts {
        for k in 0..ins.args.len() {
          let a: i32 = ins.args[k];
          if (a >= 0 && a < is_phi.len() && is_phi[a]) {
            let where: boolean = here;
            if (ins.kind_tag == 8) {
              where = arm_of(dom, c, at[b.preds[k]]) == ti;
            }
            if (where) {
              out = out.with(a, true);
            }
          }
        }
      }
      let tv: i32 = term_read(b.term);
      if (tv >= 0 && tv < is_phi.len() && is_phi[tv] && here) {
        out = out.with(tv, true);
      }
    }
  }
  return out;
}

function split_join(f: ssasem.Func, at: i32[], dom: ssadeps.Dom, c: Join): ssasem.Func {
  let g: ssa.SFunc = f.graph;
  let defs: ssa.SInst[] = definitions(g);
  let jb: ssa.SBlock = g.blocks[c.j];
  let is_phi: boolean[] = join_phis(g, c);
  let s: Split = Split { f: f, blocks: g.blocks, val: util.minus_ones(g.nvals) };
  let val_t: i32[] = [];
  let val_f: i32[] = [];
  s = arm_values(s, g, defs, c, c.t, 1, arm_needs(g, at, dom, c, c.t));
  val_t = s.val;
  s = Split { ...s, val: util.minus_ones(g.nvals) };
  s = arm_values(s, g, defs, c, c.f, 0, arm_needs(g, at, dom, c, c.f));
  val_f = s.val;
  let blocks: ssa.SBlock[] = s.blocks;
  for i in 0..jb.preds.len() {
    let qi: i32 = at[jb.preds[i]];
    let target: i32 = g.blocks[c.f].id;
    if (c.picks[i] == 1) {
      target = g.blocks[c.t].id;
    }
    blocks = blocks.with(qi, ssa.SBlock { ...blocks[qi], term: jump(target) });
  }
  let ei: i32 = at[g.entry];
  let moved: ssa.SInst[] = blocks[ei].insts;
  for ins in jb.insts {
    if (movable_constant(ins)) {
      moved = moved.append(ins);
    }
  }
  blocks = blocks.with(ei, ssa.SBlock { ...blocks[ei], insts: moved });
  blocks = blocks.with(c.j, ssa.SBlock { ...jb, insts: [], preds: [] });
  for ch in c.chain {
    blocks = blocks.with(ch, ssa.SBlock { ...blocks[ch], insts: [], preds: [] });
  }
  for xi in 0..blocks.len() {
    if (!skipped_block(c, xi)) {
      let b: ssa.SBlock = blocks[xi];
      let here: i32 = arm_of(dom, c, xi);
      let insts: ssa.SInst[] = [];
      let changed: boolean = false;
      for ins in b.insts {
        let args: i32[] = ins.args;
        for k in 0..args.len() {
          let a: i32 = args[k];
          if (a >= 0 && a < is_phi.len() && is_phi[a]) {
            let where: i32 = here;
            if (ins.kind_tag == 8) {
              where = arm_of(dom, c, at[b.preds[k]]);
            }
            args = args.with(k, arm_value(val_t, val_f, c, where, a));
            changed = true;
          }
        }
        insts = insts.append(ssa.SInst { ...ins, args: args });
      }
      let term: ssa.STerm = b.term;
      let tv: i32 = term_read(term);
      if (tv >= 0 && tv < is_phi.len() && is_phi[tv]) {
        let nv: i32 = arm_value(val_t, val_f, c, here, tv);
        if (term.kind_tag == 1) {
          term = ssa.STerm { ...term, value: nv };
        } else {
          term = ssa.STerm { ...term, cond: nv };
        }
        changed = true;
      }
      if (changed) {
        blocks = blocks.with(xi, ssa.SBlock { ...b, insts: insts, term: term });
      }
    }
  }
  let g2: ssa.SFunc = ssa.SFunc { ...g, blocks: blocks, nvals: s.f.values.len() };
  let kept: ssa.SFunc = ssa.SFunc { ...g2, blocks: reachable_only(g2) };
  return ssasem.Func { ...s.f, graph: ssa.SFunc { ...kept, blocks: ssa.refreshed_preds(kept) } };
}

function arm_value(val_t: i32[], val_f: i32[], c: Join, where: i32, a: i32): i32 {
  if (where == c.t) {
    return val_t[a];
  }
  return val_f[a];
}
