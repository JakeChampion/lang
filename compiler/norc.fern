import "./ast";
import "./parser";
import "./util";
import "./sysreg";

// A `@norc` function allocates nothing and does no RC operation, so it can run
// before the heap exists, in the top half of an interrupt handler, or on DMA
// memory. Every value in it is a scalar, and it calls only `@norc` functions
// and the raw memory intrinsics. The checker reports each breach as E102.
// `@interrupt` implies `@norc`, and E103 reports a handler of the wrong shape.

struct Ctx { attr: string, fname: string, module: string, callable: string[] }

// The marks that the `@norc` rule checks: each `@norc` and `@interrupt`.
pub function marks(mod: parser.Module): parser.FuncMark[] {
  let out: parser.FuncMark[] = [];
  for m in mod.marks {
    if (m.attr == "norc" || m.attr == "interrupt") {
      out = out.append(m);
    }
  }
  return out;
}

// The exception slots of the arm64 vector table that a handler can take, for
// the current exception level with SP_ELx.
pub function arm64_slots(): string[] {
  return ["sync", "irq", "fiq", "serror"];
}

// The x86-64 exceptions by their mnemonic, at vectors 0 to 21.
function x86_exceptions(): string[] {
  return ["de", "db", "nmi", "bp", "of", "br", "ud", "nm", "df", "", "ts", "np", "ss", "gp", "pf", "", "mf", "ac", "mc", "xm", "ve", "cp"];
}

// The IDT vector of an x86-64 slot: an exception mnemonic such as "bp", or a
// number from 32 to 255 for an external interrupt. -1 for any other slot.
pub function x86_vector(slot: string): i32 {
  let v = util.index_of_str(x86_exceptions(), slot);
  if (slot.len() > 0 && v >= 0) {
    return v;
  }
  if (slot.len() == 0 || slot.len() > 3 || slot[0] == b'0') {
    return -1;
  }
  for i in 0..slot.len() {
    if (slot[i] < b'0' || slot[i] > b'9') {
      return -1;
    }
  }
  let n = util.digits_to_i32(slot);
  if (n < 32 || n > 255) {
    return -1;
  }
  return n;
}

// The CPU pushes an error code for these x86-64 exceptions, and the trampoline
// drops it before iretq.
pub function x86_error_code(vector: i32): boolean {
  return vector == 8 || vector >= 10 && vector <= 14 || vector == 17 || vector == 21;
}

function slot_of(target: string, slot: string): boolean {
  if (target == "arm64-kernel") {
    return util.has_str(arm64_slots(), slot);
  }
  return x86_vector(slot) >= 0;
}

function handler_text(m: parser.FuncMark): string {
  return "`@interrupt` function \"" + util.mangled_name(m.func_name) + "\" ";
}

// E103: a handler takes no parameters and returns void, and each slot has at
// most one handler.
pub function interrupt_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let seen: string[] = [];
  for m in parser.marked(mod, "interrupt") {
    let module = util.mangled_module(m.func_name);
    let what = handler_text(m);
    if (!util.has_str(arm64_slots(), m.arg) && x86_vector(m.arg) < 0) {
      out = out.append(util.violation_diag("E103", what + "names the slot \"" + m.arg + "\", which is no slot of an arm64 vector table or an x86-64 IDT", module, m.line, m.col));
    } else if (util.has_str(seen, m.arg)) {
      out = out.append(util.violation_diag("E103", what + "takes the slot \"" + m.arg + "\", which another handler already takes", module, m.line, m.col));
    }
    seen = seen.append(m.arg);
    out = util.append_diags(out, interrupt_shape(mod, m, what, module));
  }
  return out;
}

// E103: only a kernel target has a vector table, and the slot must be one of
// its ISA.
pub function interrupt_target_diags(mod: parser.Module, target: string): util.Diag[] {
  let out: util.Diag[] = [];
  let kernel = target == "arm64-kernel" || target == "x86-64-kernel";
  for m in parser.marked(mod, "interrupt") {
    let module = util.mangled_module(m.func_name);
    if (!kernel) {
      out = out.append(util.violation_diag("E103", handler_text(m) + "needs a vector table, and only -target arm64-kernel and -target x86-64-kernel have one", module, m.line, m.col));
    } else if (!slot_of(target, m.arg)) {
      out = out.append(util.violation_diag("E103", handler_text(m) + "takes the slot \"" + m.arg + "\", which -target " + target + " does not have", module, m.line, m.col));
    }
  }
  return out;
}

// Whether the mark is this function's: a method may share a name with a
// marked free function, so the mark's position decides.
function marks_function(fd: parser.FuncDecl, m: parser.FuncMark): boolean {
  return fd.name == m.func_name && fd.line == m.line && fd.col == m.col;
}

function interrupt_shape(mod: parser.Module, m: parser.FuncMark, what: string, module: string): util.Diag[] {
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    if (marks_function(fd, m) && (fd.params.len() > 0 || fd.ret_type != "void")) {
      out = out.append(util.violation_diag("E103", what + "must take no parameters and return void", module, m.line, m.col));
    }
  }
  return out;
}

pub function scalar(ty: string): boolean {
  return util.has_str(["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "usize", "f32", "f64", "boolean", "char"], ty);
}

// The intrinsics that a `@norc` function may call. Each takes and returns
// scalars and touches no heap box.
pub function intrinsics(): string[] {
  return [
    "__load_u8", "__load_i32", "__load_i64", "__load_ptr", "__store_u8", "__store_i32", "__store_i64", "__store_ptr",
    "__mmio_load8", "__mmio_load16", "__mmio_load32", "__mmio_load64", "__mmio_store8", "__mmio_store16", "__mmio_store32", "__mmio_store64",
    "__fence", "__wfi", "__hvc", "__smc", "__boot_info", "__sysreg_read", "__sysreg_write", "__cache_clean", "__cache_flush", "__tlb_flush", "__tlb_flush_all", "__breakpoint", "__irq_mask", "__irq_unmask", "__irq_wait", "__irq_pending", "__port_in8", "__port_in16", "__port_in32", "__port_out8", "__port_out16", "__port_out32", "__clz32", "__clz64", "__ctz32", "__ctz64", "__popcount32", "__popcount64",
  ];
}

// `mod` is annotated, so each identifier and call carries its type.
pub function diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  let rule = marks(mod);
  if (rule.len() == 0) {
    return out;
  }
  let callable = intrinsics();
  for m in rule {
    callable = callable.append(m.func_name);
  }
  for m in rule {
    for fd in mod.funcs {
      if (marks_function(fd, m)) {
        out = check_function(fd, Ctx { attr: m.attr, fname: util.mangled_name(fd.name), module: util.mangled_module(fd.name), callable: callable }, m, out);
      }
    }
  }
  return out;
}

function bad(cx: Ctx, what: string, line: i32, col: i32, own out: util.Diag[]): util.Diag[] {
  return out.append(util.violation_diag("E102", "`@" + cx.attr + "` function \"" + cx.fname + "\" " + what, cx.module, line, col));
}

function check_function(fd: parser.FuncDecl, cx: Ctx, m: parser.FuncMark, own out: util.Diag[]): util.Diag[] {
  if (fd.receiver_name.len() > 0 || fd.type_params.len() > 0) {
    return bad(cx, "must be a plain function, not a method or a generic function", m.line, m.col, out);
  }
  for p in fd.params {
    if (!scalar(p.type_name)) {
      out = bad(cx, "takes \"" + p.name + "\" of type " + p.type_name + ", which is not a scalar", p.line, p.col, out);
    }
  }
  if (fd.ret_type != "void" && !scalar(fd.ret_type)) {
    out = bad(cx, "returns " + fd.ret_type + ", which is not a scalar", m.line, m.col, out);
  }
  return check_block(fd.body, cx, out);
}

function check_block(body: ast.Stmt[], cx: Ctx, own out: util.Diag[]): util.Diag[] {
  for s in body {
    out = check_stmt(s, cx, out);
  }
  return out;
}

function check_stmt(s: ast.Stmt, cx: Ctx, own out: util.Diag[]): util.Diag[] {
  match (s) {
    ast.StmtVar(v) => {
      if (v.type_name.len() > 0 && !scalar(v.type_name)) {
        out = bad(cx, "declares \"" + v.name + "\" of type " + v.type_name + ", which is not a scalar", v.line, v.col, out);
      }
      return check_expr(v.init, cx, out);
    },
    ast.StmtAssign(a) => {
      if (a.target.contains(".") || a.target.contains("[")) {
        return bad(cx, "may not write to a field or an element", a.line, a.col, out);
      }
      return check_expr(a.value, cx, out);
    },
    ast.StmtExpr(e) => {
      return check_expr(e.value, cx, out);
    },
    ast.StmtReturn(r) => {
      return check_expr(r.value, cx, out);
    },
    ast.StmtIf(i) => {
      out = check_expr(i.cond, cx, out);
      out = check_block(i.then_body, cx, out);
      return check_block(i.else_body, cx, out);
    },
    ast.StmtWhile(w) => {
      out = check_expr(w.cond, cx, out);
      return check_block(w.body, cx, out);
    },
    ast.StmtBreak(_) => {
      return out;
    },
    ast.StmtContinue(_) => {
      return out;
    },
    ast.StmtFor(f) => {
      return bad(cx, "may not use a `for` loop, which iterates a value; use `while`", f.line, f.col, out);
    },
    ast.StmtMatch(m) => {
      return bad(cx, "may not use `match`", m.line, m.col, out);
    },
    _ => {
      return bad(cx, "may not use this statement", stmt_line(s), 0, out);
    }
  }
}

function stmt_line(s: ast.Stmt): i32 {
  match (s) {
    ast.StmtDefer(d) => {
      return d.line;
    },
    _ => {
      return 0;
    }
  }
}

function check_expr(e: ast.Expr, cx: Ctx, own out: util.Diag[]): util.Diag[] {
  match (e) {
    ast.ExprNumber(_) => {
      return out;
    },
    ast.ExprBool(_) => {
      return out;
    },
    ast.ExprUnknown(_) => {
      return out;
    },
    ast.ExprIdent(id) => {
      if (!scalar(id.ty)) {
        return bad(cx, "uses \"" + id.name + "\" of type " + util.demangle(id.ty) + ", which is not a scalar", id.line, id.col, out);
      }
      return out;
    },
    ast.ExprBinary(b) => {
      out = check_expr(b.left, cx, out);
      return check_expr(b.right, cx, out);
    },
    ast.ExprUnary(u) => {
      if (util.str_has_prefix(u.op, "as") && !scalar(u.ty)) {
        out = bad(cx, "casts to " + util.demangle(u.ty) + ", which is not a scalar", u.line, u.col, out);
      }
      return check_expr(u.operand, cx, out);
    },
    ast.ExprCall(c) => {
      return check_call(c, cx, out);
    },
    _ => {
      return bad(cx, "may not use " + form(e), ast.expr_line(e), ast.expr_col(e), out);
    }
  }
}

function check_call(c: ast.ExprCall, cx: Ctx, own out: util.Diag[]): util.Diag[] {
  match (c.callee) {
    ast.ExprIdent(id) => {
      if (!util.has_str(cx.callable, id.name)) {
        return bad(cx, "may call only `@norc` functions and the raw memory intrinsics, not \"" + util.mangled_name(id.name) + "\"", c.line, c.col, out);
      }
    },
    _ => {
      return bad(cx, "may not call a method or a function value", c.line, c.col, out);
    }
  }
  for i in register_args(c)..c.args.len() {
    out = check_expr(c.args[i], cx, out);
  }
  return out;
}

// The register of a system-register intrinsic is a literal that the
// instruction encodes, so it is no heap value.
function register_args(c: ast.ExprCall): i32 {
  if let ast.ExprIdent(id) = c.callee {
    if (sysreg.intrinsic(id.name)) {
      return 1;
    }
  }
  return 0;
}

function form(e: ast.Expr): string {
  match (e) {
    ast.ExprString(_) => {
      return "a string";
    },
    ast.ExprFString(_) => {
      return "a string";
    },
    ast.ExprBytes(_) => {
      return "a byte string";
    },
    ast.ExprArray(_) => {
      return "an array literal";
    },
    ast.ExprMapLit(_) => {
      return "a map literal";
    },
    ast.ExprStructLit(_) => {
      return "a struct literal";
    },
    ast.ExprTuple(_) => {
      return "a tuple";
    },
    ast.ExprLambda(_) => {
      return "a closure";
    },
    ast.ExprFieldAccess(_) => {
      return "a field access";
    },
    ast.ExprIndex(_) => {
      return "an index";
    },
    ast.ExprSlice(_) => {
      return "a slice";
    },
    _ => {
      return "this expression";
    }
  }
}
