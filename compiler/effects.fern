import "./ast";
import "./astwalk";
import "./caps";
import "./parser";
import "./platforms";
import "./treeshake";
import "./util";

const INDIRECT: string = "(function value)";

struct Graph {
  funcs: parser.FuncDecl[],
  edge_at: i32[],
  edges: i32[],
  builtin_at: i32[],
  builtins: string[],
  indirect: boolean[],
  escaping: boolean[],
  esc_builtins: string[],
}

struct Scan {
  locals: string[],
  lambda_locals: string[],
  callee_pos: i32[],
  applied_pos: i32[],
  edges: i32[],
  builtins: string[],
  indirect: boolean,
  escaping: i32[],
  esc_builtins: string[],
}

struct Ctx { names: util.NameIndex, fn_fields: util.NameIndex, tagged: util.NameIndex }

struct Walk { ctx: Ctx, s: Scan, funcs: parser.FuncDecl[] }

function pos_key(line: i32, col: i32): i32 {
  return line * 4096 + col;
}

function bind_stmt(st: ast.Stmt, own w: Walk): Walk {
  match (st) {
    ast.StmtVar(v) => {
      let s = w.s;
      match (v.init) {
        ast.ExprLambda(_) => {
          s = Scan { ...s, lambda_locals: s.lambda_locals.append(v.name) };
        },
        _ => {}
      }
      return Walk { ...w, s: Scan { ...s, locals: bound(s.locals, v.name) } };
    },
    ast.StmtFor(f) => {
      return Walk { ...w, s: Scan { ...w.s, locals: bound(w.s.locals, f.var_name) } };
    },
    ast.StmtMatch(m) => {
      let locals = w.s.locals;
      for arm in m.arms {
        locals = astwalk.pattern_binders(arm.pattern, locals);
      }
      return Walk { ...w, s: Scan { ...w.s, locals: locals } };
    },
    _ => {}
  }
  return w;
}

function bound(locals: string[], binder: string): string[] {
  let out = locals;
  for n in astwalk.append_bound_name([], binder) {
    out = out.append(n);
  }
  return out;
}

function bind_expr(e: ast.Expr, own w: Walk): Walk {
  match (e) {
    ast.ExprLambda(lm) => {
      let locals = w.s.locals;
      for p in lm.params {
        locals = locals.append(p.name);
      }
      return Walk { ...w, s: Scan { ...w.s, locals: locals } };
    },
    _ => {}
  }
  return w;
}

function no_stmt(st: ast.Stmt, own w: Walk): Walk {
  return w;
}

function add_edge(s: Scan, callee: i32): Scan {
  if (has_i32(s.edges, callee)) {
    return s;
  }
  return Scan { ...s, edges: s.edges.append(callee) };
}

function call_expr(e: ast.Expr, own w: Walk): Walk {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          let s = Scan { ...w.s, callee_pos: w.s.callee_pos.append(pos_key(id.line, id.col)) };
          if (util.has_str(s.locals, id.name)) {
            if (!util.has_str(s.lambda_locals, id.name)) {
              s = Scan { ...s, indirect: true };
            }
          } else if (w.ctx.names.has(id.name)) {
            s = add_edge(s, func_at(w.funcs, id.name));
          } else if (w.ctx.tagged.has(id.name) && !util.has_str(s.builtins, id.name)) {
            s = Scan { ...s, builtins: s.builtins.append(id.name) };
          }
          return Walk { ...w, s: s };
        },
        ast.ExprFieldAccess(fa) => {
          if (w.ctx.fn_fields.has(fa.field)) {
            return Walk { ...w, s: Scan { ...w.s, indirect: true } };
          }
          return w;
        },
        ast.ExprLambda(lm) => {
          return Walk { ...w, s: Scan { ...w.s, applied_pos: w.s.applied_pos.append(pos_key(lm.line, lm.col)) } };
        },
        _ => {
          return Walk { ...w, s: Scan { ...w.s, indirect: true } };
        }
      }
    },
    _ => {}
  }
  return w;
}

function ident_expr(e: ast.Expr, own w: Walk): Walk {
  match (e) {
    ast.ExprIdent(id) => {
      if (!has_i32(w.s.callee_pos, pos_key(id.line, id.col)) && !util.has_str(w.s.locals, id.name) && w.ctx.names.has(id.name)) {
        let k = func_at(w.funcs, id.name);
        return Walk { ...w, s: Scan { ...add_edge(w.s, k), escaping: w.s.escaping.append(k) } };
      }
    },
    _ => {}
  }
  return w;
}

function lambda_expr(e: ast.Expr, own w: Walk): Walk {
  match (e) {
    ast.ExprLambda(lm) => {
      if (!has_i32(w.s.applied_pos, pos_key(lm.line, lm.col))) {
        let inner = Walk { ...w, s: Scan { ...fresh_scan(), locals: w.s.locals, lambda_locals: w.s.lambda_locals } };
        for st in lm.body {
          inner = astwalk.fold_stmt_nodes(st, inner, no_stmt, call_expr, astwalk.descend_all);
        }
        for st in lm.body {
          inner = astwalk.fold_stmt_nodes(st, inner, no_stmt, ident_expr, astwalk.descend_all);
        }
        let s = w.s;
        for k in inner.s.edges {
          s = Scan { ...s, escaping: s.escaping.append(k) };
        }
        for b in inner.s.builtins {
          s = Scan { ...s, esc_builtins: s.esc_builtins.append(b) };
        }
        return Walk { ...w, s: s };
      }
    },
    _ => {}
  }
  return w;
}

function fresh_scan(): Scan {
  return Scan { locals: [], lambda_locals: [], callee_pos: [], applied_pos: [], edges: [], builtins: [], indirect: false, escaping: [], esc_builtins: [] };
}

function scan(ctx: Ctx, funcs: parser.FuncDecl[], fd: parser.FuncDecl): Scan {
  let w = Walk { ctx: ctx, s: fresh_scan(), funcs: funcs };
  for p in fd.params {
    w = Walk { ...w, s: Scan { ...w.s, locals: w.s.locals.append(p.name) } };
  }
  for st in fd.body {
    w = astwalk.fold_stmt_nodes(st, w, bind_stmt, bind_expr, astwalk.descend_all);
  }
  for st in fd.body {
    w = astwalk.fold_stmt_nodes(st, w, no_stmt, call_expr, astwalk.descend_all);
  }
  for st in fd.body {
    w = astwalk.fold_stmt_nodes(st, w, no_stmt, ident_expr, astwalk.descend_all);
  }
  for st in fd.body {
    w = astwalk.fold_stmt_nodes(st, w, no_stmt, lambda_expr, astwalk.descend_all);
  }
  let refs = treeshake.body_refs(fd);
  let s = w.s;
  let k = 0;
  while (k < funcs.len()) {
    if (funcs[k].receiver_type.len() > 0 && treeshake.refs_name(refs, funcs[k])) {
      s = add_edge(s, k);
    }
    k += 1;
  }
  return s;
}

function func_at(funcs: parser.FuncDecl[], name: string): i32 {
  let k = 0;
  while (k < funcs.len()) {
    if (funcs[k].name == name) {
      return k;
    }
    k += 1;
  }
  return -1;
}

function has_i32(xs: i32[], v: i32): boolean {
  for x in xs {
    if (x == v) {
      return true;
    }
  }
  return false;
}

function context(mod: parser.Module, tagged: string[]): Ctx {
  let names: string[] = [];
  for fd in mod.funcs {
    if (fd.receiver_type.len() > 0) {
      names = names.append("");
    } else {
      names = names.append(fd.name);
    }
  }
  let fn_fields: string[] = [];
  for sd in mod.structs {
    for f in sd.fields {
      if (f.fn_ret.len() > 0 || util.index_of_sub(f.type_name, "=>") >= 0) {
        fn_fields = fn_fields.append(f.name);
      }
    }
  }
  return Ctx { names: util.name_index(names), fn_fields: util.name_index(fn_fields), tagged: util.name_index(tagged) };
}

function add_scan(g: Graph, k: i32, s: Scan): Graph {
  let edges = g.edges;
  for e in s.edges {
    if (e != k) {
      edges = edges.append(e);
    }
  }
  let builtins = g.builtins;
  for b in s.builtins {
    builtins = builtins.append(b);
  }
  let esc_b = g.esc_builtins;
  for b in s.esc_builtins {
    if (!util.has_str(esc_b, b)) {
      esc_b = esc_b.append(b);
    }
  }
  return Graph { ...g, edge_at: g.edge_at.append(g.edges.len()), edges: edges, builtin_at: g.builtin_at.append(g.builtins.len()), builtins: builtins, indirect: g.indirect.append(s.indirect), esc_builtins: esc_b };
}

function build(mod: parser.Module, tagged: string[]): Graph {
  let ctx = context(mod, tagged);
  let g = Graph { funcs: mod.funcs, edge_at: [], edges: [], builtin_at: [], builtins: [], indirect: [], escaping: [], esc_builtins: [] };
  let esc: boolean[] = [];
  let escaping: i32[] = [];
  let k = 0;
  while (k < mod.funcs.len()) {
    let s = scan(ctx, mod.funcs, mod.funcs[k]);
    g = add_scan(g, k, s);
    for e in s.escaping {
      escaping = escaping.append(e);
    }
    esc = esc.append(false);
    k += 1;
  }
  for e in escaping {
    esc = esc.with(e, true);
  }
  return Graph { ...g, edge_at: g.edge_at.append(g.edges.len()), builtin_at: g.builtin_at.append(g.builtins.len()), escaping: esc, esc_builtins: sorted(g.esc_builtins) };
}

function sorted(xs: string[]): string[] {
  let out: string[] = [];
  for x in xs {
    let placed = false;
    let next: string[] = [];
    for y in out {
      if (!placed && util.str_less(x, y)) {
        next = next.append(x);
        placed = true;
      }
      next = next.append(y);
    }
    if (!placed) {
      next = next.append(x);
    }
    out = next;
  }
  return out;
}

struct Vocab { labels: string[], builtins: string[], of: string[] }

function bit_of(v: Vocab, builtin: string): i64 {
  let k = util.index_of_str(v.builtins, builtin);
  if (k < 0) {
    return 0i64;
  }
  let l = util.index_of_str(v.labels, v.of[k]);
  return 1i64 << l as i64;
}

function label_names(v: Vocab, row: i64): string[] {
  let out: string[] = [];
  let i = 0;
  while (i < v.labels.len()) {
    if ((row & 1i64 << i as i64) != 0i64) {
      out = out.append(v.labels[i]);
    }
    i += 1;
  }
  return out;
}

function solve(g: Graph, v: Vocab, use_indirect: boolean): (i64[], i64) {
  let n = g.funcs.len();
  let direct: i64[] = [];
  let k = 0;
  while (k < n) {
    let row: i64 = 0i64;
    let b = g.builtin_at[k];
    while (b < g.builtin_at[k + 1]) {
      row = row | bit_of(v, g.builtins[b]);
      b += 1;
    }
    direct = direct.append(row);
    k += 1;
  }
  let seed: i64 = 0i64;
  for b in g.esc_builtins {
    seed = seed | bit_of(v, b);
  }
  let rows = direct;
  let indirect: i64 = 0i64;
  let changed = true;
  while (changed) {
    changed = false;
    let ind = seed;
    let e = 0;
    while (e < n) {
      if (g.escaping[e]) {
        ind = ind | rows[e];
      }
      e += 1;
    }
    if (ind != indirect) {
      indirect = ind;
      changed = true;
    }
    let f = 0;
    while (f < n) {
      let row = direct[f];
      if (use_indirect && g.indirect[f]) {
        row = row | indirect;
      }
      let c = g.edge_at[f];
      while (c < g.edge_at[f + 1]) {
        row = row | rows[g.edges[c]];
        c += 1;
      }
      if (row != rows[f]) {
        rows = rows.with(f, row);
        changed = true;
      }
      f += 1;
    }
  }
  return (rows, indirect);
}

function witness(g: Graph, v: Vocab, fn: i32, want: i64): string[] {
  let seen = __alloc_i32(g.funcs.len() + 1);
  seen = seen.with(fn, 1);
  let order: i32[] = [fn];
  let parent: i32[] = [-1];
  let qi = 0;
  while (qi < order.len()) {
    let at = order[qi];
    for b in builtins_of(g, at) {
      if ((bit_of(v, b) & want) != 0i64 && first_label(v, bit_of(v, b)) == first_label(v, want)) {
        return chain(g, order, parent, qi).append(b);
      }
    }
    for callee in edges_of(g, at) {
      if (seen[callee] == 0) {
        seen = seen.with(callee, 1);
        order = order.append(callee);
        parent = parent.append(qi);
      }
    }
    qi += 1;
  }
  return [];
}

function first_label(v: Vocab, row: i64): string {
  let names = label_names(v, row);
  if (names.len() == 0) {
    return "";
  }
  return names[0];
}

function builtins_of(g: Graph, at: i32): string[] {
  if (at == g.funcs.len()) {
    return g.esc_builtins;
  }
  let out: string[] = [];
  let b = g.builtin_at[at];
  while (b < g.builtin_at[at + 1]) {
    out = out.append(g.builtins[b]);
    b += 1;
  }
  return out;
}

function edges_of(g: Graph, at: i32): i32[] {
  let out: i32[] = [];
  if (at == g.funcs.len()) {
    let k = 0;
    while (k < g.funcs.len()) {
      if (g.escaping[k]) {
        out = out.append(k);
      }
      k += 1;
    }
    return out;
  }
  let c = g.edge_at[at];
  while (c < g.edge_at[at + 1]) {
    out = out.append(g.edges[c]);
    c += 1;
  }
  if (g.indirect[at]) {
    out = out.append(g.funcs.len());
  }
  return out;
}

function chain(g: Graph, order: i32[], parent: i32[], at: i32): string[] {
  let rev: string[] = [];
  let p = at;
  while (p >= 0) {
    if (order[p] == g.funcs.len()) {
      rev = rev.append(INDIRECT);
    } else {
      rev = rev.append(display(g.funcs[order[p]]));
    }
    p = parent[p];
  }
  let out: string[] = [];
  let i = rev.len() - 1;
  while (i >= 0) {
    out = out.append(rev[i]);
    i -= 1;
  }
  return out;
}

function vocab(builtins: string[], labels: string[]): Vocab {
  let ls: string[] = [];
  for l in labels {
    if (l.len() > 0 && !util.has_str(ls, l)) {
      ls = ls.append(l);
    }
  }
  return Vocab { labels: sorted(ls), builtins: builtins, of: labels };
}

function authority(): Vocab {
  let bs: string[] = [];
  let ls: string[] = [];
  for c in caps.builtin_caps() {
    bs = bs.append(c.builtin);
    ls = ls.append(c.capability);
  }
  return vocab(bs, ls);
}

function host(): Vocab {
  let bs: string[] = [];
  let ls: string[] = [];
  for gt in platforms.gated_builtins() {
    bs = bs.append(gt.builtin);
    ls = ls.append(gt.capability);
  }
  return vocab(bs, ls);
}

function joined(xs: string[], sep: string): string {
  let out = "";
  for x in xs {
    if (out.len() > 0) {
      out += sep;
    }
    out += x;
  }
  return out;
}

function section(g: Graph, title: string, v: Vocab): string {
  let (rows, _) = solve(g, v, true);
  let (direct, _) = solve(g, v, false);
  let out = "== " + title + " ==\n";
  let sizes: i32[] = [];
  let counts: i32[] = [];
  let effectful = 0;
  let origins = 0;
  let pubs = 0;
  let pub_effectful = 0;
  let through_value = 0;
  let k = 0;
  while (k < g.funcs.len()) {
    let reached = label_names(v, rows[k]);
    let via = label_names(v, (rows[k] | direct[k]) ^ direct[k]);
    let at = util.index_of_i32(sizes, reached.len());
    if (at < 0) {
      sizes = sizes.append(reached.len());
      counts = counts.append(1);
    } else {
      counts = counts.with(at, counts[at] + 1);
    }
    if (via.len() > 0) {
      through_value += 1;
    }
    if (direct_origin(g, v, k)) {
      origins += 1;
    }
    if (g.funcs[k].is_pub) {
      pubs += 1;
    }
    if (reached.len() > 0) {
      effectful += 1;
      if (g.funcs[k].is_pub) {
        pub_effectful += 1;
      }
      out = out + display(g.funcs[k]) + "  " + joined(reached, ",");
      if (via.len() > 0) {
        out = out + "  (via a function value: " + joined(via, ",") + ")";
      }
      let w = witness(g, v, k, rows[k]);
      if (w.len() > 0) {
        out = out + "  (example: " + joined(w, " → ") + ")";
      }
      out += "\n";
    }
    k += 1;
  }
  out = out + "\n" + util.i32_to_string(g.funcs.len()) + " functions; " + util.i32_to_string(effectful) + " reach an effect, of which "
    + util.i32_to_string(origins) + " call a tagged builtin themselves and " + util.i32_to_string(effectful - origins) + " only inherit\n";
  out = out + util.i32_to_string(pubs) + " are `pub`, of which " + util.i32_to_string(pub_effectful)
    + " reach an effect — the size of a \"require a row on public signatures\" rule\n";
  out = out + util.i32_to_string(through_value) + " reach an effect only through a function value\n";
  let size = 0;
  let shown = 0;
  while (shown < sizes.len()) {
    let at = util.index_of_i32(sizes, size);
    if (at >= 0) {
      out = out + "  row size " + util.i32_to_string(size) + ": " + util.i32_to_string(counts[at]) + " functions\n";
      shown += 1;
    }
    size += 1;
  }
  return out;
}

function display(fd: parser.FuncDecl): string {
  if (fd.receiver_type.len() > 0) {
    return fd.receiver_type + "." + fd.name;
  }
  return fd.name;
}

function direct_origin(g: Graph, v: Vocab, k: i32): boolean {
  let b = g.builtin_at[k];
  while (b < g.builtin_at[k + 1]) {
    if (bit_of(v, g.builtins[b]) != 0i64) {
      return true;
    }
    b += 1;
  }
  return false;
}

pub function report(mod: parser.Module): string {
  let a = authority();
  let h = host();
  let tagged = a.builtins;
  for b in h.builtins {
    if (!util.has_str(tagged, b)) {
      tagged = tagged.append(b);
    }
  }
  let g = build(mod, tagged);
  return section(g, "authority (caps) — what a dependency can reach", a) + "\n"
    + section(g, "host (platforms) — what the target must provide", h) + "\n";
}
