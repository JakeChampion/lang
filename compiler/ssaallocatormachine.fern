import "./ssaallocatorstate" as machine;
import "./ssamachineword" as machineword;
import "./ssacapacityisa" as isa;
import "./ssadecrementtext" as text;

function initial_word(i: i32, bump: boolean): machineword.Word {
  if (i < 16) {
    return machineword.token(7, (i / 2) as i64);
  }
  if (i < 18) {
    return machineword.token(6, 0);
  }
  if (i < 20) {
    return machineword.token(7, 8);
  }
  return initial_heap_word(i, bump);
}

function initial_heap_word(i: i32, bump: boolean): machineword.Word {
  if (i < 22) {
    return if (bump) { machineword.number(0) } else { machineword.token(3, 0) };
  }
  if (i < 24) {
    return if (bump) { machineword.token(3, 0) } else { machineword.token(10, 0) };
  }
  if (i < 26) {
    return machineword.token(10, 1);
  }
  if (i < 28) {
    return if (bump) { machineword.token(5, 0) } else { machineword.token(10, 2) };
  }
  return if (i < 30 && !bump) { machineword.token(8, 0) } else { machineword.token(9, ((i - 28) / 2) as i64) };
}

function initial(request: i32, bump: boolean): machine.State {
  let regs: machineword.Word[] = [];
  let memory: machineword.Half[] = [];
  let writes: i32[] = [];
  let i = 0;
  while (i < 16) {
    regs = regs.append(if (i == 4) { machineword.token(2, 0) } else { if (i == 7) { machineword.number(request as i64) } else { machineword.token(1, i as i64) } });
    i += 1;
  }
  for i in 0..28 + request / 4 {
    let w = initial_word(i, bump);
    memory = memory.append(if (i % 2 == 0) { w.low } else { w.high });
    writes = writes.append(0);
  }
  return machine.State { regs: regs, memory: memory, mappings: 0, advised: false, writes: writes, zero: -1, carry: -1, sign: -1, overflow: -1, bounded: false, choice: 0, ok: true };
}

function cell(base: machineword.Word, offset: i64, width: i32, request: i32): i32 {
  if (!machine.pointer(base) || offset < -64 || offset > 64) {
    return -1;
  }
  let at = base.low.identity + offset;
  let bytes = width / 8;
  if (at % 4 != 0) {
    return -1;
  }
  return cell_extent(base.low.kind, at, bytes, request);
}

function cell_extent(kind: i32, at: i64, bytes: i32, request: i32): i32 {
  if (kind == 2 && at >= -64 && at + bytes <= 16) {
    return ((at + 64) / 4) as i32;
  }
  if (kind == 3 && at >= 0 && at + bytes <= request as i64) {
    return 28 + (at / 4) as i32;
  }
  if (kind == 4 && at >= request as i64 && at + bytes <= request as i64 + 8) {
    return 20 + ((at - request as i64) / 4) as i32;
  }
  return -1;
}

function address(s: machine.State, op: isa.Op, request: i32): i32 {
  let offset = op.offset as i64;
  if (op.index >= 0) {
    let index = s.regs[op.index];
    if (!machineword.unsigned(index) || index.low.identity > 64) {
      return -1;
    }
    offset = offset + index.low.identity * (op.scale as i64);
  }
  return cell(s.regs[op.base], offset, op.width, request);
}

function writable(at: i32, bump: boolean): boolean {
  return at >= 0 && at < 16 || at >= (if (bump) { 22 } else { 20 }) && at < (if (bump) { 24 } else { 22 }) || link_word(at, bump);
}

// The first word of a block that a free list gives. It held the link of the
// block, and the allocator can clear it. It can hold zero alone.
function link_word(at: i32, bump: boolean): boolean {
  return !bump && (at == 28 || at == 29);
}

function store(s: machine.State, at: i32, width: i32, w: machineword.Word, bump: boolean): machine.State {
  let memory = s.memory;
  let writes = s.writes;
  for i in 0..width / 32 {
    let pos = at + i;
    if (!writable(pos, bump) || pos >= 20 && writes[pos] != 0 || link_word(pos, bump) && !machineword.same(if (i == 0) { w.low } else { w.high }, machineword.number(0).low)) {
      return machine.State { ...s, ok: false };
    }
    memory = memory.with(pos, if (i == 0) { w.low } else { w.high });
    writes = writes.with(pos, writes[pos] + 1);
  }
  return machine.State { ...s, memory: memory, writes: writes };
}

function stack(s: machine.State, op: isa.Op, request: i32, bump: boolean): machine.State {
  let sp = s.regs[4];
  if (!machine.pointer(sp) || sp.low.kind != 2) {
    return machine.State { ...s, ok: false };
  }
  if (op.kind == 6 || op.kind == 32) {
    let at = if (op.kind == 32) { address(s, op, request) } else { 0 };
    if (at < 0) {
      return machine.State { ...s, ok: false };
    }
    let w = if (op.kind == 32) { machine.load(s, at, 64) } else { s.regs[op.source] };
    let next = machineword.token(2, sp.low.identity - 8);
    return machine.write(store(s, cell(next, 0, 64, request), 64, w, bump), 4, next);
  }
  return pop(s, op, request, bump);
}

function pop(s: machine.State, op: isa.Op, request: i32, bump: boolean): machine.State {
  let sp = s.regs[4];
  let at = cell(sp, 0, 64, request);
  if (at < 0) {
    return machine.State { ...s, ok: false };
  }
  let w = machine.load(s, at, 64);
  let advanced = machine.write(s, 4, machineword.token(2, sp.low.identity + 8));
  return if (op.kind == 33) { store(advanced, address(advanced, op, request), 64, w, bump) } else { machine.write(advanced, op.destination, w) };
}

function shifted(s: machine.State, reg: i32, w: machineword.Word, delta: i64, request: i32): machine.State {
  let at = w.low.identity + delta;
  let low = if (w.low.kind == 2) { -(64 as i64) } else { 0 as i64 };
  let high = if (w.low.kind == 3) { request as i64 } else { if (w.low.kind == 2) { 16 as i64 } else { 64 as i64 } };
  return if (at >= low && at <= high) { machine.write(s, reg, machineword.token(w.low.kind, at)) } else { machine.State { ...s, ok: false } };
}

function immediate_add(s: machine.State, op: isa.Op, request: i32): machine.State {
  let w = s.regs[op.destination];
  let delta = if (op.kind == 9) { -(op.immediate as i64) } else { op.immediate as i64 };
  if (machine.pointer(w) && op.width == 64) {
    return shifted(s, op.destination, w, delta, request);
  }
  if (!machineword.unsigned(w)) {
    return machine.State { ...s, ok: false };
  }
  let n = w.low.identity + delta;
  return if (n >= 0 && n <= 4294967295) { machine.write(s, op.destination, machineword.number(n)) } else { machine.State { ...s, ok: false } };
}

function arithmetic(s: machine.State, op: isa.Op, request: i32): machine.State {
  let cleared = machine.unknown(s);
  if (op.source < 0) {
    return immediate_add(cleared, op, request);
  }
  if (op.width != 64) {
    return machine.State { ...s, ok: false };
  }
  let a = s.regs[op.destination];
  let b = s.regs[op.source];
  return register_arithmetic(cleared, op, a, b, request);
}

function register_arithmetic(s: machine.State, op: isa.Op, a: machineword.Word, b: machineword.Word, request: i32): machine.State {
  if (op.kind == 10 && machineword.equal(a, machineword.token(13, 960)) && machineword.equal(b, machineword.token(3, request as i64))) {
    return machine.write(s, op.destination, machineword.token(14, request as i64));
  }
  if (op.kind == 10 && machine.pointer(b) && machineword.unsigned(a)) {
    return shifted(s, op.destination, b, a.low.identity, request);
  }
  if (machine.pointer(a) && machineword.unsigned(b)) {
    return shifted(s, op.destination, a, if (op.kind == 9) { -b.low.identity } else { b.low.identity }, request);
  }
  return machine.pointer_difference(s, op, a, b);
}

function flags(s: machine.State, a: i64, b: i64, width: i32): machine.State {
  let difference = a - b;
  let bits = if (width == 32) { if (difference < 0) { difference + 4294967296 } else { difference } } else { difference };
  let sign = if (width == 32) { bits >= 2147483648 } else { difference < 0 };
  let overflow = width == 32 && a >= 2147483648 != b >= 2147483648 && sign != a >= 2147483648;
  return machine.State { ...s, zero: if (difference == 0) { 1 } else { 0 }, carry: if (a < b) { 1 } else { 0 }, sign: if (sign) { 1 } else { 0 }, overflow: if (overflow) { 1 } else { 0 }, bounded: false, choice: 0 };
}

function comparison(s: machine.State, a: machineword.Word, b: machineword.Word, width: i32, request: i32): machine.State {
  let left = machineword.narrowed(a, width);
  let right = machineword.narrowed(b, width);
  if (machineword.unsigned(left) && machineword.unsigned(right)) {
    return flags(s, left.low.identity, right.low.identity, width);
  }
  if (machineword.equal(left, right)) {
    return flags(s, 0, 0, width);
  }
  if (width == 64 && machineword.equal(left, machineword.token(3, request as i64)) && machineword.equal(right, machineword.token(5, 0))) {
    return machine.State { ...machine.unknown(s), bounded: true };
  }
  if (width == 64 && machineword.equal(left, machineword.token(14, request as i64)) && machineword.equal(right, machineword.token(5, 0))) {
    return machine.State { ...machine.unknown(s), choice: 2 };
  }
  return machine.unknown(s);
}

function global_cell(symbol: string): i32 {
  if (symbol == "__fern_heap_ptr") {
    return 22;
  }
  if (symbol == "__fern_heap_base") {
    return 24;
  }
  return if (symbol == "__fern_heap_end") { 26 } else { -1 };
}

function global_step(s: machine.State, op: isa.Op, request: i32, bump: boolean): machine.State {
  let at = global_cell(op.symbol);
  if (at < 0) {
    return machine.State { ...s, ok: false };
  }
  if (op.kind == 29) {
    return machine.read(s, at, op.width, op.destination);
  }
  if (op.kind == 34 && at == 22 && bump && op.width == 64 && machineword.equal(s.regs[op.source], machineword.token(14, request as i64))) {
    return coloured_store(s, s.regs[op.source]);
  }
  if (op.kind == 34) {
    return store(s, at, op.width, s.regs[op.source], bump);
  }
  return comparison(s, s.regs[op.source], machine.load(s, at, op.width), op.width, request);
}

// The second store to the bump pointer, which the colour step makes after
// the test that the coloured pointer is not past the end of the heap.
function coloured_store(s: machine.State, w: machineword.Word): machine.State {
  if (!s.bounded || s.writes[22] != 1 || s.writes[23] != 1) {
    return machine.State { ...s, ok: false };
  }
  return machine.State { ...s, memory: s.memory.with(22, w.low).with(23, w.high), writes: s.writes.with(22, 2).with(23, 2) };
}

// The values of the colour step. Kind 12 is the number of a 64 KiB line.
// Kind 13 is a number from 0 to its identity: a number of a line for 15, a
// multiple of 64 for 960. Kind 14 is the end of the block plus such a
// multiple of 64.
function colour_step(s: machine.State, op: isa.Op, request: i32, bump: boolean): machine.State {
  if (op.kind == 48) {
    return line_test(s, request, bump);
  }
  let w = s.regs[op.destination];
  if (shift_by(op, 21, 16) && machineword.equal(w, machineword.token(3, request as i64))) {
    return machine.write(machine.unknown(s), op.destination, machineword.token(12, 0));
  }
  if (shift_by(op, 20, 6) && machineword.equal(w, machineword.token(13, 15))) {
    return machine.write(machine.unknown(s), op.destination, machineword.token(13, 960));
  }
  return machine.State { ...s, ok: false };
}

function colour_op(op: isa.Op): boolean {
  return op.kind == 48 || op.kind == 20 || op.kind == 21;
}

function shift_by(op: isa.Op, kind: i32, count: i32): boolean {
  return op.width == 64 && op.kind == kind && op.immediate == count;
}

// The test of the low 16 bits of the end of the block against those of its
// start. %rax holds the start and %rdi the end.
function line_test(s: machine.State, request: i32, bump: boolean): machine.State {
  let ends = bump && machineword.equal(s.regs[0], machineword.token(3, 0)) && machineword.equal(s.regs[7], machineword.token(3, request as i64));
  return machine.State { ...machine.unknown(s), choice: 1, ok: s.ok && ends };
}

function test(s: machine.State, op: isa.Op): machine.State {
  let w = machineword.narrowed(s.regs[op.source], op.width);
  if (machineword.unsigned(w)) {
    let result = flags(s, w.low.identity, 0, op.width);
    return machine.State { ...result, carry: 0, overflow: 0 };
  }
  return machine.State { ...machine.unknown(s), zero: if (machineword.equal(w, machineword.token(3, 0))) { 0 } else { -1 }, carry: 0, overflow: 0 };
}

function mask(s: machine.State, op: isa.Op): machine.State {
  let w = s.regs[op.destination];
  if (op.source < 0 && op.immediate == 15 && op.width == 64 && machineword.equal(w, machineword.token(12, 0))) {
    return machine.write(machine.unknown(s), op.destination, machineword.token(13, 15));
  }
  if (op.source >= 0 || op.immediate != -8 || !machineword.unsigned(w)) {
    return machine.State { ...s, ok: false };
  }
  let n = w.low.identity - w.low.identity % 8;
  return machine.write(flags(s, n, 0, op.width), op.destination, machineword.number(n));
}

function memory_step(s: machine.State, op: isa.Op, request: i32, bump: boolean): machine.State {
  let at = address(s, op, request);
  if (op.kind == 3) {
    return machine.read(s, at, op.width, op.destination);
  }
  let w = if (op.kind == 22) { machineword.number(op.immediate as i64) } else { s.regs[op.source] };
  return store(s, at, op.width, w, bump);
}

function simple(s: machine.State, op: isa.Op, request: i32): machine.State {
  if (op.kind == 1) {
    return s;
  }
  if (op.kind == 2) {
    return machine.write(s, op.destination, machineword.narrowed(s.regs[op.source], op.width));
  }
  if (op.kind == 5) {
    return machine.write(s, op.destination, machineword.narrowed(machineword.number(op.immediate as i64), op.width));
  }
  if (op.kind == 19 && op.symbol == "__fern_freelist") {
    return machine.write(s, op.destination, machineword.token(4, 0));
  }
  if (op.kind == 15 && op.index < 0 && machine.pointer(s.regs[op.base])) {
    return shifted(s, op.destination, s.regs[op.base], op.offset as i64, request);
  }
  return machine.State { ...s, ok: false };
}

function step(s: machine.State, op: isa.Op, request: i32, bump: boolean): machine.State {
  if (op.kind == 3 || op.kind == 4 || op.kind == 22) {
    return memory_step(s, op, request, bump);
  }
  if (op.kind == 6 || op.kind == 7 || op.kind == 32 || op.kind == 33) {
    return stack(s, op, request, bump);
  }
  return other_step(s, op, request, bump);
}

function other_step(s: machine.State, op: isa.Op, request: i32, bump: boolean): machine.State {
  if (colour_op(op)) {
    return colour_step(s, op, request, bump);
  }
  if (op.kind == 9 || op.kind == 10) {
    return arithmetic(s, op, request);
  }
  if (op.kind == 11) {
    return mask(s, op);
  }
  if (op.kind == 23 || op.kind == 27) {
    return test(s, op);
  }
  if (op.kind >= 29 && op.kind <= 30 || op.kind == 34) {
    return global_step(s, op, request, bump);
  }
  return compare_or_simple(s, op, request);
}

function compare_or_simple(s: machine.State, op: isa.Op, request: i32): machine.State {
  if (op.kind == 16) {
    return comparison(s, s.regs[op.source], machineword.number(op.immediate as i64), op.width, request);
  }
  if (op.kind == 28) {
    return comparison(s, s.regs[op.destination], s.regs[op.source], op.width, request);
  }
  return simple(s, op, request);
}

function finished_memory(s: machine.State, original: machine.State, request: i32, bump: boolean): boolean {
  let start = if (bump) { 22 } else { 20 };
  let changed = if (bump) { machineword.token(3, request as i64) } else { machineword.token(8, 0) };
  for i in 16..s.memory.len() {
    let selected = i == start || i == start + 1;
    let kept = machineword.same(s.memory[i], original.memory[i]) && s.writes[i] == 0;
    let cleared = link_word(i, bump) && machineword.same(s.memory[i], machineword.number(0).low) && s.writes[i] == 1;
    let good = if (selected) { moved(s, i, changed, request, bump) } else { kept || cleared };
    if (!good) {
      return false;
    }
  }
  return true;
}

// Whether the cell at i of the pointer that the path moves holds its new
// value: the value changed after one store, or the coloured end of the block
// after two stores on a path that takes memory from the end of the heap.
function moved(s: machine.State, i: i32, changed: machineword.Word, request: i32, bump: boolean): boolean {
  return written(s, i, changed, 1) || bump && written(s, i, machineword.token(14, request as i64), 2);
}

// Whether the cell at i holds its half of w after that many stores.
function written(s: machine.State, i: i32, w: machineword.Word, stores: i32): boolean {
  return machineword.same(s.memory[i], if (i % 2 == 0) { w.low } else { w.high }) && s.writes[i] == stores;
}

function finished(s: machine.State, request: i32, bump: boolean): boolean {
  let original = initial(request, bump);
  for i in 0..16 {
    let expected = original.regs[i];
    if (i == 0) {
      expected = machineword.token(3, 0);
    }
    if (i == 7) {
      expected = machineword.token(if (bump) { 3 } else { 4 }, request as i64);
    }
    if (!machineword.equal(s.regs[i], expected)) {
      return false;
    }
  }
  return s.ok && finished_memory(s, original, request, bump);
}

// miss is the position of the label that takes the address of an empty
// list. A path that takes memory from the end of the heap goes through it.
function path(p: isa.Program, miss: i32, request: i32, bump: boolean): boolean {
  let visited: boolean[] = [];
  for op in p.ops {
    visited = visited.append(false);
  }
  return miss >= 0 && run(p, miss, 0, initial(request, bump), visited, request, bump);
}

function run(p: isa.Program, miss: i32, from: i32, state: machine.State, seen: boolean[], request: i32, bump: boolean): boolean {
  let s = state;
  let visited = seen;
  let pc = from;
  while (pc >= 0 && pc < p.ops.len()) {
    if (visited[pc] || !listed(s, pc, miss, request)) {
      return false;
    }
    visited = visited.with(pc, true);
    let op = p.ops[pc];
    if (op.kind == 18) {
      return (!bump || visited[miss]) && finished(s, request, bump);
    }
    if (open_choice(s, op)) {
      let taken = machine.State { ...s, choice: 0 };
      let through = machine.State { ...taken, bounded: s.choice == 2 };
      return run(p, miss, op.target, taken, visited, request, bump) && run(p, miss, pc + 1, through, visited, request, bump);
    }
    let next = advanced(s, op, pc, request, bump);
    s = next.s;
    pc = next.pc;
  }
  return false;
}

// Whether %rdi holds the address of the list when pc is the label that takes
// it.
function listed(s: machine.State, pc: i32, miss: i32, request: i32): boolean {
  return pc != miss || machineword.equal(s.regs[7], machineword.token(4, request as i64));
}

struct Position { s: machine.State, pc: i32 }

// The state and the position after the instruction at pc. The position is
// -1 when the machine refuses the instruction.
function advanced(s: machine.State, op: isa.Op, pc: i32, request: i32, bump: boolean): Position {
  if (op.kind == 17 || op.kind == 35) {
    return Position { s: s, pc: machine.next_pc(s, op, pc, false) };
  }
  let next = step(s, op, request, bump);
  return Position { s: next, pc: if (next.ok) { pc + 1 } else { -1 } };
}

function open_choice(s: machine.State, op: isa.Op): boolean {
  return op.kind == 17 && (s.choice == 1 && op.condition == "jb" || s.choice == 2 && op.condition == "ja");
}

pub function check(output: string): boolean {
  let p = isa.allocator_program(output);
  let miss = isa.allocator_miss_entry(output);
  return p.error == "" && text.allocator_storage(output) && path(p, miss, 32, false) && path(p, miss, 32, true) && path(p, miss, 40, false) && path(p, miss, 40, true);
}
