import "./util";
import "./sourcepos";
// The native allocator and emitter consume this same prepared body. This is
// not a certificate: target-specific release entry paths also have effects.
import "./irtables";
import "./physicalbody";
import "./ssa";
import "./ssa_lift";

pub struct Body {
  lowered: irtables.LowerResult,
  selected: physicalbody.Selected,
  formed: ssa.Formed,
  seen_vals: i32[],
  seen_slots: i32[],
  source: SourceLines,
}

// The pre-emission context needed to interpret target-specific entry paths.
// These records describe emitted bodies; they do not certify their effects.
pub struct Context {
  architecture: string,
  reg_entries: irtables.SigReg,
  leaves: ssa.Leaf[],
  records: boolean,
  rc_free_debug: boolean,
  sanitize: boolean,
  leak_check: boolean,
  rt_owned_allocs: boolean,
  needed: string[],
}

// Selection of the native entry template, not a proof of its effects.
// Counted entries return for low/static pointers and shared decrements;
// zero counts reach the body. Only x86 can shortcut count-one through Drop.
pub struct ReleaseEntry {
  counted: boolean,
  unique_drop: string,
}

// Actual backend choices consumed during emission, not independently checked
// facts. Fusions correspond positionally to the formed body's blocks.
pub struct Fusion {
  n: i32,
  tag: i32,
  inverted: boolean,
  a: i32,
  b: i32,
  unique: boolean,
  aligned: boolean,
}

pub struct Allocation {
  alloc: ssa.Alloc,
  imm: ssa.Imms,
  saved: i32[],
  save_bytes: i32,
  frame_bytes: i32,
  framed: boolean,
  views: i32[],
  block_positions: i32[],
  block_label_base: i32,
  fusions: Fusion[],
}

// Observed text-mode occurrence, not an instruction or alignment proof.
// A rotated loop test has its own join label and pre-emission cache state.
pub struct UniqueSite {
  input: i32,
  result: i32,
  input_home: i32,
  result_home: i32,
  cached: i32,
  flags: boolean,
  aligned: boolean,
  inverted: boolean,
  join: string,
  text: string,
}

pub struct Emitted {
  label_name: string,
  body: Body,
  context: Context,
  release_entry: ReleaseEntry,
  allocation: Allocation,
  // Empty for binary-record emission, whose instructions are not text.
  assembly: string,
  sites: UniqueSite[],
}

pub struct Output {
  text: string,
  bodies: Emitted[],
}

// Called after the backend's lift checks, with that actual lift and its
// current unit leaves. Never relower or look up an old body by symbol here.
pub function finish(lowered: irtables.LowerResult, selected: physicalbody.Selected, lifted: ssa_lift.LResult, leaves: ssa.Leaf[]): Body {
  return finish_formed(lowered, selected, lifted, ssa.register_form(ssa.inline_leaves(lifted.func, leaves)));
}

// finish_formed is finish for a lift whose register form is already made:
// one that calls no leaf, so inlining the leaves would not change it.
pub function finish_formed(lowered: irtables.LowerResult, selected: physicalbody.Selected, lifted: ssa_lift.LResult, formed: ssa.Formed): Body {
  return Body { lowered: lowered, selected: selected, formed: formed, seen_vals: lifted.seen_vals, seen_slots: lifted.seen_slots, source: source_lines(lowered, lifted, formed) };
}

// with_selects is the certified body with its small branches turned into
// selects (ssa.select_branches) and its branch-free carries fused
// (ssa.fuse_carries), the form the emitter allocates. Neither moves a
// reference count operation.
pub function with_selects(b: Body): Body {
  return Body { ...b, formed: ssa.Formed { ...b.formed, f: ssa.fuse_carries(ssa.select_branches(b.formed.f)) } };
}

pub struct SourceLines { values: sourcepos.SourcePos[], terms: sourcepos.SourcePos[] }

function blank_positions(n: i32): sourcepos.SourcePos[] {
  let out: sourcepos.SourcePos[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(sourcepos.SourcePos { line: 0, col: "0" });
    i = i + 1;
  }
  return out;
}

function source_lines(r: irtables.LowerResult, lifted: ssa_lift.LResult, formed: ssa.Formed): SourceLines {
  if (r.source_positions.entry.line == 0) {
    return SourceLines { values: [], terms: [] };
  }
  let top: i32 = 0;
  for b in formed.f.blocks {
    if (b.id >= top) {
      top = b.id + 1;
    }
  }
  let out = SourceLines { values: blank_positions(formed.f.nvals), terms: blank_positions(top) };
  out = source_values(out, lifted.source_values, formed.repl);
  for row in lifted.source_returns {
    if (row.block < out.terms.len()) {
      out = SourceLines { ...out, terms: out.terms.with(row.block, sourcepos.SourcePos { line: row.line, col: row.col }) };
    }
  }
  if (!has_source_instruction(formed.f, out.values)) {
    out = first_source(out, formed.f, r.source_positions.entry);
  }
  return out;
}

function has_source_instruction(f: ssa.SFunc, values: sourcepos.SourcePos[]): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (ins.result >= 0 && ins.result < values.len() && values[ins.result].line > 0) {
        return true;
      }
    }
  }
  return false;
}

function source_value(own out: SourceLines, value: i32, repl: i32[], pos: sourcepos.SourcePos): SourceLines {
  let original = value;
  if (value < repl.len()) {
    value = repl[value];
  }
  if (value < 0 || value >= out.values.len()) {
    return out;
  }
  // An eliminated alias must not move its surviving definition to a later
  // statement: a breakpoint there would precede the definition itself.
  if (value != original && out.values[value].line > 0) {
    return out;
  }
  return SourceLines { ...out, values: out.values.with(value, pos) };
}

function first_source(own out: SourceLines, f: ssa.SFunc, pos: sourcepos.SourcePos): SourceLines {
  for b in f.blocks {
    for ins in b.insts {
      if (ins.result >= 0 && ins.kind_tag != 6 && ins.kind_tag != 8) {
        return SourceLines { ...out, values: out.values.with(ins.result, pos) };
      }
    }
  }
  if (out.terms[f.entry].line == 0) {
    return SourceLines { ...out, terms: out.terms.with(f.entry, pos) };
  }
  return out;
}

function source_values(own out: SourceLines, positions: i64[], repl: i32[]): SourceLines {
  let i: i32 = 0;
  while (i < positions.len()) {
    let packed = positions[i];
    if (packed > 0) {
      out = source_value(out, i, repl, sourcepos.SourcePos { line: (packed >> 32) as i32, col: util.i64_to_string(packed & 4294967295i64) });
    }
    i = i + 1;
  }
  return out;
}
