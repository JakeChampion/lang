// compiler/lsprefs.fern — what `fern -lsp` answers a references or a rename
// request from: every place the program a document's check loaded writes the
// name at a position, read from the same program, view and tokens a hover
// reads (lspquery.fern).
//
// The name at the position is resolved to what it names: a local binding of
// one function, a module-level function or constant, a struct or an enum, a
// variant of an enum, a field of a struct, or a method. A name a declaration
// declares resolves as a use of it does. Then each kind is found where the
// syntax tree has it — an identifier, a member after a `.`, a struct literal's
// field, a match arm's variant — and placed on the token that spells it, so a
// node the front end synthesised at a borrowed position is never a place. A
// type is found among the tokens instead, since the tree keeps no positions
// for the types a program writes.

import "./ast";
import "./astwalk";
import "./checker";
import "./flatten";
import "./lexical";
import "./lspquery";
import "./parser";
import "./typeinfo";
import "./util";

// Ref is one place the name is written: the `len` bytes at bundle position
// `line`, `col`, and whether that is its declaration.
pub struct Ref { line: i32, col: i32, len: i32, decl: boolean }

// references is every place the program writes what the name at `line`, `col`
// names, its declaration included, in bundle order; none when it names
// nothing the program declares or uses.
pub function references(p: lspquery.Program, line: i32, col: i32): Ref[] {
  let t: Target = target_at(p, line, col);
  if (t.kind == R_NONE) {
    return [];
  }
  return placed(p, t, uses(p, t));
}

// ---- What the name names ----

const R_NONE: i32 = 0;

const R_LOCAL: i32 = 1;

const R_GLOBAL: i32 = 2;

const R_TYPE: i32 = 3;

const R_VARIANT: i32 = 4;

const R_FIELD: i32 = 5;

const R_METHOD: i32 = 6;

// Target is what a name names: a local (`name` its symbol) of function `fd`;
// a module-level function or constant, or a struct or enum (`name` bundled);
// variant `name` of enum `owner`; field `name` of struct `owner`; or method
// `name` declared at `at_line`, `at_col`. `spelled` is how the program writes
// it, and `decl` its declared name, as a definition request answers.
struct Target { kind: i32, name: string, owner: string, fd: i32, at_line: i32, at_col: i32, spelled: string, decl: lspquery.Answer }

function no_target(): Target {
  return Target { kind: R_NONE, name: "", owner: "", fd: 0 - 1, at_line: 0, at_col: 0, spelled: "", decl: lspquery.no_answer() };
}

function target_at(p: lspquery.Program, line: i32, col: i32): Target {
  let (q, ok) = lspquery.query(p, line, col);
  if (!ok) {
    return no_target();
  }
  let t: Target = no_target();
  if (q.f.kind != lspquery.K_NONE) {
    let fd: parser.FuncDecl = q.v.mod.funcs[q.f.fd];
    t = node_target(p, q, lspquery.scope_at(q.v, fd, q.site), fd);
  } else {
    t = type_target(p, q.v, lspquery.type_candidates(q));
    if (t.kind == R_NONE) {
      t = declared_target(p, q);
    }
  }
  return Target { ...t, spelled: q.site.name };
}

function node_target(p: lspquery.Program, q: lspquery.Query, s: checker.Scope, fd: parser.FuncDecl): Target {
  match (q.f.expr) {
    ast.ExprIdent(id) => {
      if (q.f.kind == lspquery.K_IDENT) {
        let (b, local) = lspquery.binding_of(fd, q.site);
        if (local) {
          return Target { ...no_target(), kind: R_LOCAL, name: b.symbol, fd: q.f.fd, decl: lspquery.local_def(p, b, lspquery.is_param(b, fd), q.site.name) };
        }
      }
      return global_target(p, q.v, s, id.name);
    },
    ast.ExprFieldAccess(fa) => {
      return member_target(p, q.v, s, fa, false);
    },
    ast.ExprCall(c) => {
      if let ast.ExprFieldAccess(fa) = c.callee {
        return member_target(p, q.v, s, fa, true);
      }
    },
    ast.ExprStructLit(sl) => {
      return global_target(p, q.v, s, sl.type_name);
    },
    _ => {}
  }
  return no_target();
}

// global_target is what the module-level name `name` (bundled) names: a
// variant, a function or constant, a struct or an enum.
function global_target(p: lspquery.Program, v: checker.QueryView, s: checker.Scope, name: string): Target {
  let owner: string = checker.variant_enum(s, name);
  if (owner.len() > 0) {
    return variant_target(p, v, s, owner, name);
  }
  for fd in v.mod.funcs {
    if (fd.name == name && fd.receiver_type.len() == 0) {
      return Target { ...no_target(), kind: R_GLOBAL, name: name, decl: lspquery.decl_def(p, fd.line, fd.col, name) };
    }
  }
  return type_named(p, v, name);
}

function type_named(p: lspquery.Program, v: checker.QueryView, name: string): Target {
  let decl: lspquery.Answer = lspquery.type_decl_def(p, v, name);
  if (!decl.found) {
    return no_target();
  }
  return Target { ...no_target(), kind: R_TYPE, name: name, decl: decl };
}

// variant_target is variant `name` of enum `owner`, named as the enum's own
// module writes it.
function variant_target(p: lspquery.Program, v: checker.QueryView, s: checker.Scope, owner: string, name: string): Target {
  let u: checker.UnionSig = checker.enum_sig(s, owner);
  return Target { ...no_target(), kind: R_VARIANT, name: lspquery.unprefixed(name, u.module), owner: owner, decl: lspquery.variant_def(p, v, owner, name) };
}

// member_target is what `fa` names after its `.`: an enum's variant, a method
// when it is called, else a field.
function member_target(p: lspquery.Program, v: checker.QueryView, s: checker.Scope, fa: ast.ExprFieldAccess, called: boolean): Target {
  let owner: string = lspquery.enum_qualifier(s, fa);
  if (owner.len() > 0) {
    return variant_target(p, v, s, owner, fa.field);
  }
  if (called) {
    let ms: checker.MethodSig = method_of(s, fa);
    if (ms.name.len() == 0 || ms.line == 0) {
      return no_target();
    }
    return Target { ...no_target(), kind: R_METHOD, name: fa.field, at_line: ms.line, at_col: ms.col, decl: lspquery.decl_def(p, ms.line, ms.col, fa.field) };
  }
  let decl: lspquery.Answer = lspquery.field_def(p, v, s, fa);
  if let typeinfo.TypeStruct(st) = checker.expr_type(fa.obj, s) {
    if (decl.found) {
      return Target { ...no_target(), kind: R_FIELD, name: fa.field, owner: st.name, decl: decl };
    }
  }
  return no_target();
}

// method_of is the method a call of `fa` calls: one declared on its
// receiver's type or on an array receiver. A std/array function an array
// receiver calls is not a method, and its signature is the empty one.
function method_of(s: checker.Scope, fa: ast.ExprFieldAccess): checker.MethodSig {
  let t: typeinfo.Type = checker.expr_type(fa.obj, s);
  if let typeinfo.TypeArray(a) = t {
    if (lspquery.array_func(s, a, fa.field).name.len() > 0) {
      return checker.method_sig(s, "", "");
    }
    return checker.array_method_sig(s, fa.field, a.view);
  }
  return checker.method_sig(s, fa.field, checker.receiver_key(t));
}

// type_target is the first of the bundled `candidates` that names a struct or
// an enum, or a variant, which a pattern names.
function type_target(p: lspquery.Program, v: checker.QueryView, candidates: string[]): Target {
  let s: checker.Scope = checker.module_scope(v);
  for c in candidates {
    let owner: string = checker.variant_enum(s, c);
    let t: Target = no_target();
    if (owner.len() > 0) {
      t = variant_target(p, v, s, owner, c);
    } else {
      t = type_named(p, v, c);
    }
    if (t.kind != R_NONE) {
      return t;
    }
  }
  return no_target();
}

// ---- A declaration's own name ----

// declared_target is what the declaration whose name the query's site is
// declares: a function, method or constant, a struct, enum, variant or field,
// or a local of the function the site is in.
function declared_target(p: lspquery.Program, q: lspquery.Query): Target {
  if (q.site.dot_col > 0) {
    return no_target();
  }
  let m: i32 = util.pos_file_index(q.site.line);
  let toks: lspquery.Tok[] = lspquery.module_toks(p, m);
  let t: Target = func_declared(q, toks, m);
  if (t.kind == R_NONE) {
    t = type_declared(p, q, toks, m);
  }
  if (t.kind == R_NONE) {
    t = local_declared(q, toks, m);
  }
  return t;
}

function func_declared(q: lspquery.Query, toks: lspquery.Tok[], m: i32): Target {
  for fd in q.v.mod.funcs {
    if (lspquery.declared_in(fd.line, m) && lspquery.unprefixed(fd.name, q.quals.own) == q.site.name) {
      let a: lspquery.Answer = named_after(toks, fd.line, fd.col, q.site.name);
      if (at_site(a, q.site) && fd.receiver_type.len() > 0) {
        return Target { ...no_target(), kind: R_METHOD, name: q.site.name, at_line: fd.line, at_col: fd.col, decl: a };
      }
      if (at_site(a, q.site)) {
        return Target { ...no_target(), kind: R_GLOBAL, name: fd.name, decl: a };
      }
    }
  }
  return no_target();
}

// type_declared is the struct, enum, field or variant declared at the site.
function type_declared(p: lspquery.Program, q: lspquery.Query, toks: lspquery.Tok[], m: i32): Target {
  for sd in q.v.mod.structs {
    if (lspquery.declared_in(sd.line, m) && sd.enum_owner.len() == 0) {
      let t: Target = struct_declared(q, toks, sd);
      if (t.kind != R_NONE) {
        return t;
      }
    }
  }
  for ed in q.v.mod.enums {
    if (lspquery.declared_in(ed.line, m)) {
      let t: Target = enum_declared(p, q, toks, ed);
      if (t.kind != R_NONE) {
        return t;
      }
    }
  }
  return no_target();
}

function struct_declared(q: lspquery.Query, toks: lspquery.Tok[], sd: parser.StructDecl): Target {
  let name: string = lspquery.unprefixed(sd.name, q.quals.own);
  let a: lspquery.Answer = named_after(toks, sd.line, sd.col, name);
  if (name == q.site.name && at_site(a, q.site)) {
    return Target { ...no_target(), kind: R_TYPE, name: sd.name, decl: a };
  }
  if (!a.found) {
    return no_target();
  }
  let f: lspquery.Answer = tok_answer(toks, lspquery.field_tok(toks, lspquery.after(toks, a.line, a.col + a.len), q.site.name));
  if (at_site(f, q.site)) {
    return Target { ...no_target(), kind: R_FIELD, name: q.site.name, owner: sd.name, decl: f };
  }
  return no_target();
}

function enum_declared(p: lspquery.Program, q: lspquery.Query, toks: lspquery.Tok[], ed: parser.EnumDecl): Target {
  let a: lspquery.Answer = named_after(toks, ed.line, ed.col, lspquery.unprefixed(ed.name, q.quals.own));
  if (at_site(a, q.site)) {
    return Target { ...no_target(), kind: R_TYPE, name: ed.name, decl: a };
  }
  for vn in ed.variant_names {
    if (lspquery.unprefixed(vn, q.quals.own) == q.site.name) {
      let va: lspquery.Answer = lspquery.variant_def(p, q.v, ed.name, vn);
      if (at_site(va, q.site)) {
        return Target { ...no_target(), kind: R_VARIANT, name: q.site.name, owner: ed.name, decl: va };
      }
    }
  }
  return no_target();
}

// local_declared is the binding of the function the site is in that the site
// declares.
function local_declared(q: lspquery.Query, toks: lspquery.Tok[], m: i32): Target {
  let fi: i32 = lspquery.enclosing(q.v.mod, toks, m, q.site.line, q.site.col);
  if (fi < 0) {
    return no_target();
  }
  let fd: parser.FuncDecl = q.v.mod.funcs[fi];
  for b in lexical.resolve_func(fd).bindings {
    if (b.name == q.site.name) {
      let a: lspquery.Answer = lspquery.binding_decl(toks, b, lspquery.is_param(b, fd), b.name);
      if (at_site(a, q.site)) {
        return Target { ...no_target(), kind: R_LOCAL, name: b.symbol, fd: fi, decl: a };
      }
    }
  }
  return no_target();
}

// named_after is the first identifier spelled `name` from `line`, `col` on,
// where a declaration there writes its name.
function named_after(toks: lspquery.Tok[], line: i32, col: i32, name: string): lspquery.Answer {
  return tok_answer(toks, lspquery.first_ident(toks, lspquery.after(toks, line, col), name));
}

function tok_answer(toks: lspquery.Tok[], i: i32): lspquery.Answer {
  if (i < 0) {
    return lspquery.no_answer();
  }
  return lspquery.Answer { found: true, text: "", line: toks[i].line, col: toks[i].col, len: toks[i].text.len() };
}

function at_site(a: lspquery.Answer, site: lspquery.Site): boolean {
  return a.found && a.line == site.line && a.col == site.name_col;
}

// ---- Where it is used ----

// Anchor is where a node naming the target stands: at the name, at the
// qualifier of a qualified one, or at the `.` before a member.
struct Anchor { line: i32, col: i32 }

function uses(p: lspquery.Program, t: Target): Anchor[] {
  let v: checker.QueryView = lspquery.view_of(p).types;
  if (t.kind == R_LOCAL) {
    return local_uses(v.mod.funcs[t.fd], t.name);
  }
  if (t.kind == R_GLOBAL) {
    return global_uses(v.mod.funcs, t.name);
  }
  if (t.kind == R_VARIANT) {
    return variant_uses(v, t);
  }
  if (t.kind == R_FIELD || t.kind == R_METHOD) {
    return member_uses(v, t);
  }
  return [];
}

// Named is a search for the identifier `name`, and where it was found: each
// read, and each assignment to it.
struct Named { name: string, out: Anchor[] }

function named_stmt(st: ast.Stmt, own n: Named): Named {
  if let ast.StmtAssign(a) = st {
    if (a.target == n.name) {
      return Named { ...n, out: n.out.append(Anchor { line: a.target_line, col: a.target_col }) };
    }
  }
  return n;
}

function named_expr(e: ast.Expr, own n: Named): Named {
  if let ast.ExprIdent(id) = e {
    if (id.name == n.name) {
      return Named { ...n, out: n.out.append(Anchor { line: id.line, col: id.col }) };
    }
  }
  return n;
}

function named_in(body: ast.Stmt[], own n: Named): Named {
  for st in body {
    n = astwalk.fold_stmt_nodes(st, n, named_stmt, named_expr, astwalk.descend_all);
  }
  return n;
}

// local_uses is every read of and assignment to the local `symbol` of `fd`.
function local_uses(fd: parser.FuncDecl, symbol: string): Anchor[] {
  return named_in(lexical.resolve_func(fd).func.body, Named { name: symbol, out: [] }).out;
}

// global_uses is every read of the module-level `name` in `funcs`: an
// identifier no local of its function shadows. A function is resolved only
// when it reads the name at all.
function global_uses(funcs: parser.FuncDecl[], name: string): Anchor[] {
  let out: Anchor[] = [];
  for fd in funcs {
    if (fd.line > 0 && named_in(fd.body, Named { name: name, out: [] }).out.len() > 0) {
      out = util.append_all(out, named_in(lexical.resolve_func(fd).func.body, Named { name: name, out: [] }).out);
    }
  }
  return out;
}

// VariantFind is a search for variant `name` of enum `owner`, whose module
// prefixes it with `prefix`, typed by the module scope `s`.
struct VariantFind { s: checker.Scope, owner: string, name: string, prefix: string, out: Anchor[] }

// variant_uses is every use of the target variant: a bare or module-qualified
// identifier, an enum-qualified member, and a match arm's pattern.
function variant_uses(v: checker.QueryView, t: Target): Anchor[] {
  let s: checker.Scope = checker.module_scope(v);
  let f: VariantFind = VariantFind { s: s, owner: t.owner, name: t.name, prefix: checker.enum_sig(s, t.owner).module, out: [] };
  for fd in v.mod.funcs {
    if (fd.line > 0) {
      for st in lexical.resolve_func(fd).func.body {
        f = astwalk.fold_stmt_nodes(st, f, variant_stmt, variant_expr, astwalk.descend_all);
      }
    }
  }
  return f.out;
}

// names_variant reports whether the bundled `name` names the variant `f`
// looks for.
function names_variant(f: VariantFind, name: string): boolean {
  return util.str_has_suffix(name, f.name) && lspquery.unprefixed(name, f.prefix) == f.name && checker.variant_enum(f.s, name) == f.owner;
}

function variant_stmt(st: ast.Stmt, own f: VariantFind): VariantFind {
  if let ast.StmtMatch(m) = st {
    for arm in m.arms {
      if let ast.PatVariant(pv) = arm.pattern {
        if (names_variant(f, pv.type_name)) {
          let (line, col) = lexical.arm_at(m, arm);
          f = VariantFind { ...f, out: f.out.append(Anchor { line: line, col: col }) };
        }
      }
    }
  }
  return f;
}

function variant_expr(e: ast.Expr, own f: VariantFind): VariantFind {
  match (e) {
    ast.ExprIdent(id) => {
      if (names_variant(f, id.name)) {
        return VariantFind { ...f, out: f.out.append(Anchor { line: id.line, col: id.col }) };
      }
    },
    ast.ExprFieldAccess(fa) => {
      if (lspquery.unprefixed(fa.field, f.prefix) == f.name && lspquery.enum_qualifier(f.s, fa) == f.owner) {
        return VariantFind { ...f, out: f.out.append(Anchor { line: fa.line, col: fa.col }) };
      }
    },
    _ => {}
  }
  return f;
}

// member_uses is every access to the target field, or call of the target
// method, typed by the scope its statement is checked in, and for a field,
// every struct literal of its struct setting it.
function member_uses(v: checker.QueryView, t: Target): Anchor[] {
  let out: Anchor[] = [];
  for fd in v.mod.funcs {
    if (fd.line > 0) {
      for site in member_sites(fd.body, t.name) {
        if (member_is(v, fd, site, t)) {
          out = out.append(Anchor { line: site.line, col: site.col });
        }
      }
    }
  }
  return out;
}

// MemberSite is a place a member `name` is written: an access `fa`, at its
// `.` at `line`, `col`, `called` when it is a call's callee; or the field of
// a literal of struct `literal`, at the field's name.
struct MemberSite { line: i32, col: i32, called: boolean, fa: ast.ExprFieldAccess, literal: string }

// Sites is a search for the places member `name` is written.
struct Sites { name: string, out: MemberSite[] }

function member_sites(body: ast.Stmt[], name: string): MemberSite[] {
  let f: Sites = Sites { name: name, out: [] };
  for st in body {
    f = astwalk.fold_stmt_nodes(st, f, sites_stmt, sites_expr, astwalk.descend_all);
  }
  return f.out;
}

function sites_stmt(st: ast.Stmt, own f: Sites): Sites {
  return f;
}

function sites_expr(e: ast.Expr, own f: Sites): Sites {
  match (e) {
    ast.ExprCall(c) => {
      if let ast.ExprFieldAccess(fa) = c.callee {
        if (fa.field == f.name) {
          return Sites { ...f, out: f.out.append(MemberSite { line: fa.line, col: fa.col, called: true, fa: fa, literal: "" }) };
        }
      }
    },
    ast.ExprFieldAccess(fa) => {
      if (fa.field == f.name && !called_at(f.out, fa)) {
        return Sites { ...f, out: f.out.append(MemberSite { line: fa.line, col: fa.col, called: false, fa: fa, literal: "" }) };
      }
    },
    ast.ExprStructLit(sl) => {
      let i: i32 = util.index_of_str(sl.field_names, f.name);
      if (i >= 0 && i < sl.field_lines.len()) {
        return Sites { ...f, out: f.out.append(MemberSite { line: sl.field_lines[i], col: sl.field_cols[i], called: false, fa: no_access(), literal: sl.type_name }) };
      }
    },
    _ => {}
  }
  return f;
}

function no_access(): ast.ExprFieldAccess {
  return ast.ExprFieldAccess { obj: ast.ExprUnknown { kind: "", line: 0, col: 0 }, field: "", line: 0, col: 0, ty: "" };
}

// called_at reports whether the last site recorded is the call `fa` is the
// callee of: a call is visited just before its callee.
function called_at(acc: MemberSite[], fa: ast.ExprFieldAccess): boolean {
  return acc.len() > 0 && acc[acc.len() - 1].called && acc[acc.len() - 1].line == fa.line && acc[acc.len() - 1].col == fa.col;
}

// member_is reports whether `site` in `fd` names the target: the field of its
// struct, or the method declared where the target is.
function member_is(v: checker.QueryView, fd: parser.FuncDecl, site: MemberSite, t: Target): boolean {
  if (site.literal.len() > 0) {
    return t.kind == R_FIELD && site.literal == t.owner;
  }
  if (site.called != (t.kind == R_METHOD)) {
    return false;
  }
  let at: lspquery.Site = lspquery.access_site(site.fa);
  let s: checker.Scope = lspquery.scope_at(v, fd, at);
  if (site.called) {
    let ms: checker.MethodSig = method_of(s, site.fa);
    return ms.line == t.at_line && ms.col == t.at_col;
  }
  if let typeinfo.TypeStruct(st) = checker.expr_type(site.fa.obj, s) {
    return st.name == t.owner;
  }
  return false;
}

// ---- Placing them ----

// placed is the token spelling the target at each anchor, and its
// declaration, and for a struct or an enum, each token naming it as a type:
// each once, in bundle order.
function placed(p: lspquery.Program, t: Target, anchors: Anchor[]): Ref[] {
  let out: Ref[] = [];
  let m: i32 = 0;
  while (m < p.srcs.len()) {
    let mine: Anchor[] = [];
    for a in anchors {
      if (util.pos_file_index(a.line) == m) {
        mine = mine.append(a);
      }
    }
    let quals: string[] = type_quals(p, t, m);
    let declared: boolean = t.decl.found && util.pos_file_index(t.decl.line) == m;
    if (mine.len() > 0 || quals.len() > 0 || declared) {
      out = module_refs(p, t, m, mine, quals, out);
    }
    m = m + 1;
  }
  return out;
}

// module_refs adds module `m`'s places to `out`, marked on its tokens so each
// is added once and in order: 1 for a use, 2 for the declaration.
function module_refs(p: lspquery.Program, t: Target, m: i32, anchors: Anchor[], quals: string[], own out: Ref[]): Ref[] {
  let toks: lspquery.Tok[] = lspquery.module_toks(p, m);
  let marks: i32[] = [];
  for tok in toks {
    marks = marks.append(0);
  }
  for a in anchors {
    marks = marked(marks, spelling_at(toks, a, t.spelled), 1);
  }
  if (quals.len() > 0) {
    marks = type_marks(p, t, m, toks, quals, marks);
  }
  if (t.decl.found && util.pos_file_index(t.decl.line) == m) {
    marks = marked(marks, decl_tok(toks, t.decl), 2);
  }
  let i: i32 = 0;
  while (i < toks.len()) {
    if (marks[i] > 0) {
      out = out.append(Ref { line: toks[i].line, col: toks[i].col, len: toks[i].text.len(), decl: marks[i] == 2 });
    }
    i = i + 1;
  }
  return out;
}

function marked(own marks: i32[], i: i32, mark: i32): i32[] {
  if (i < 0 || marks[i] >= mark) {
    return marks;
  }
  return marks.with(i, mark);
}

// decl_tok is the index of the token a declaration's name answer is at, or -1.
function decl_tok(toks: lspquery.Tok[], a: lspquery.Answer): i32 {
  let i: i32 = lspquery.tok_at(toks, a.line, a.col);
  if (i >= 0 && toks[i].ident) {
    return i;
  }
  return 0 - 1;
}

// spelling_at is the index of the token spelling `name` that the node at `a`
// stands for — the token there, the member after a `.` there, or the name
// after a qualifier there — or -1.
function spelling_at(toks: lspquery.Tok[], a: Anchor, name: string): i32 {
  let i: i32 = lspquery.tok_at(toks, a.line, a.col);
  if (i < 0) {
    return i;
  }
  i = named_from(toks, i, name);
  if (i < toks.len() && toks[i].ident && toks[i].text == name) {
    return i;
  }
  return 0 - 1;
}

// named_from is the index of the token a node at token `i` names: past a `.`
// or past a qualifier and its `.`, else `i` itself.
function named_from(toks: lspquery.Tok[], i: i32, name: string): i32 {
  if (!toks[i].ident && toks[i].text == ".") {
    return i + 1;
  }
  if (toks[i].text != name && i + 2 < toks.len() && lspquery.punct_before(toks, i + 2, ".")) {
    return i + 2;
  }
  return i;
}

// type_quals is how module `m` writes the target type, when it is one: ""
// for its own module, which writes it bare, and each alias that qualifies it.
function type_quals(p: lspquery.Program, t: Target, m: i32): string[] {
  let out: string[] = [];
  if (t.kind != R_TYPE) {
    return out;
  }
  if (util.pos_file_index(t.decl.line) == m) {
    out = out.append("");
  }
  let q: flatten.Qualifiers = lspquery.quals_of(lspquery.view_of(p), m);
  for alias in q.aliases {
    if (flatten.qualified_name(q, alias, t.spelled) == t.name) {
      out = out.append(alias);
    }
  }
  return out;
}

// type_marks marks each token of module `m` that names the target type as
// one of `quals` writes it. A name after a `.` is a member, one before a `(` a
// call, and one the tree has as an identifier a value, unless it qualifies a
// member, as an enum does its variant.
function type_marks(p: lspquery.Program, t: Target, m: i32, toks: lspquery.Tok[], quals: string[], own marks: i32[]): i32[] {
  let values: Read[] = [];
  let scanned: boolean = false;
  let i: i32 = 0;
  while (i < toks.len()) {
    let at: i32 = type_ref_at(toks, i, t.spelled, quals);
    if (at >= 0 && !(i + 1 < toks.len() && !toks[i + 1].ident && toks[i + 1].text == "(")) {
      if (!scanned) {
        values = value_idents(lspquery.view_of(p).types.mod.funcs, m, t.spelled);
        scanned = true;
      }
      if (!is_value(values, toks[at].line, toks[at].col)) {
        marks = marked(marks, i, 1);
      }
    }
    i = i + 1;
  }
  return marks;
}

// type_ref_at is, when token `i` names the type as one of `quals` writes it,
// the index of the token the tree would position a node naming it at — the
// name, or its qualifier — else -1.
function type_ref_at(toks: lspquery.Tok[], i: i32, name: string, quals: string[]): i32 {
  if (!toks[i].ident || toks[i].text != name) {
    return 0 - 1;
  }
  if (!lspquery.punct_before(toks, i, ".")) {
    if (util.has_str(quals, "")) {
      return i;
    }
    return 0 - 1;
  }
  if (i >= 2 && toks[i - 2].text.len() > 0 && util.has_str(quals, toks[i - 2].text) && !lspquery.punct_before(toks, i - 2, ".")) {
    return i - 2;
  }
  return 0 - 1;
}

// Read is an identifier a function reads at `line`, `col`: a value, or the
// qualifier of a member.
struct Read { line: i32, col: i32, value: boolean }

// Reads is a search for the identifiers spelled `name` that functions read.
struct Reads { name: string, out: Read[] }

// value_idents is every identifier spelled `name` module `m`'s functions
// read.
function value_idents(funcs: parser.FuncDecl[], m: i32, name: string): Read[] {
  let f: Reads = Reads { name: name, out: [] };
  for fd in funcs {
    if (lspquery.declared_in(fd.line, m)) {
      for st in fd.body {
        f = astwalk.fold_stmt_nodes(st, f, reads_stmt, reads_expr, astwalk.descend_all);
      }
    }
  }
  return f.out;
}

function reads_stmt(st: ast.Stmt, own f: Reads): Reads {
  return f;
}

// reads_expr records an identifier read. A field access is visited just
// before its object, so a qualifier is known as one when its identifier is.
function reads_expr(e: ast.Expr, own f: Reads): Reads {
  match (e) {
    ast.ExprIdent(id) => {
      let n: i32 = f.out.len();
      let qualifies: boolean = n > 0 && !f.out[n - 1].value && f.out[n - 1].line == id.line && f.out[n - 1].col == id.col;
      if (!qualifies && util.str_has_suffix(id.name, f.name)) {
        return Reads { ...f, out: f.out.append(Read { line: id.line, col: id.col, value: true }) };
      }
    },
    ast.ExprFieldAccess(fa) => {
      if let ast.ExprIdent(q) = fa.obj {
        if (util.str_has_suffix(q.name, f.name)) {
          return Reads { ...f, out: f.out.append(Read { line: q.line, col: q.col, value: false }) };
        }
      }
    },
    _ => {}
  }
  return f;
}

function is_value(xs: Read[], line: i32, col: i32): boolean {
  for r in xs {
    if (r.line == line && r.col == col) {
      return r.value;
    }
  }
  return false;
}
