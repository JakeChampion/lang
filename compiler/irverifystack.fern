import "./ir";
import "./irverify";
import "./util";

pub struct StackResult {
  problems: irverify.Problem[],
  bail: string,
}

pub struct Coverage {
  funcs: i32,
  modelled: i32,
  skipped_fns: string[],
  skipped_why: string[],
}

pub function coverage_new(): Coverage {
  let none: string[] = [];
  return Coverage { funcs: 0, modelled: 0, skipped_fns: none, skipped_why: none };
}

pub function coverage_add(c: Coverage, fn_name: string, bail: string): Coverage {
  if (bail.len() == 0) {
    return Coverage { ...c, funcs: c.funcs + 1, modelled: c.modelled + 1 };
  }
  return Coverage {
    ...c,
    funcs: c.funcs + 1,
    skipped_fns: c.skipped_fns.append(fn_name),
    skipped_why: c.skipped_why.append(bail),
  };
}

pub function coverage_str(c: Coverage): string {
  let out = "modelled " + util.i32_to_string(c.modelled) + "/" + util.i32_to_string(c.funcs);
  let seen: string[] = [];
  let count: i32[] = [];
  for i in 0..c.skipped_why.len() {
    let at = util.index_of_str(seen, c.skipped_why[i]);
    if (at < 0) {
      seen = seen.append(c.skipped_why[i]);
      count = count.append(1);
    } else {
      count = count.with(at, count[at] + 1);
    }
  }
  for j in 0..seen.len() {
    out = out + "\n    skipped " + util.i32_to_string(count[j]) + ": " + seen[j];
  }
  return out;
}

function fn_result_slots(): i32 {
  return 1;
}

// The class of an operand slot: 0 when the pass does not know it.
const C_INT: i32 = 1;

const C_FLOAT: i32 = 2;

const C_LANE: i32 = 3;

function class_name(c: i32): string {
  return if (c == C_INT) { "an integer" } else if (c == C_FLOAT) { "a float" } else { "a lane value" };
}

function int_binary_kind(t: i32): boolean {
  return t >= ir.K_ADD && t <= ir.K_GE_U && t != ir.K_NOT || t == ir.K_MULHI_U || t == ir.K_MULHI_S;
}

function float_unary_kind(t: i32): boolean {
  return t == ir.K_FNEG || t >= ir.K_FABS && t <= ir.K_FROUND || t == ir.K_F32_ROUND;
}

function lane_unary_kind(t: i32): boolean {
  return t >= ir.K_VSQRT && t <= ir.K_VROUND || t == ir.K_VINEG || t == ir.K_VIABS
    || t >= ir.K_VIWIDENLOS && t <= ir.K_VIWIDENHIU;
}

function lane_binary_kind(t: i32): boolean {
  return t >= ir.K_VADD && t <= ir.K_VMAX || t >= ir.K_VEQ && t <= ir.K_VANDNOT || t == ir.K_VPACK
    || t >= ir.K_VIADD && t <= ir.K_VILTU || t == ir.K_VIMUL
    || t >= ir.K_VINARROWS && t <= ir.K_VISWIZZLE;
}

// The classes that an op reads, from the deepest operand to the top. A 0
// accepts each class.
function operand_classes(t: i32): i32[] {
  if (int_binary_kind(t)) {
    return [C_INT, C_INT];
  }
  if (t == ir.K_NOT || t == ir.K_I32_TO_F64 || t == ir.K_F64_FROM_BITS || t == ir.K_VISPLAT
    || t == ir.K_VLOAD || t == ir.K_VLOAD_F32) {
    return [C_INT];
  }
  if (t >= ir.K_FADD && t <= ir.K_FGE) {
    return [C_FLOAT, C_FLOAT];
  }
  if (float_unary_kind(t) || t == ir.K_F64_TO_I32 || t == ir.K_F64_TO_I64 || t == ir.K_F64_BITS || t == ir.K_VSPLAT) {
    return [C_FLOAT];
  }
  if (t == ir.K_FFMA) {
    return [C_FLOAT, C_FLOAT, C_FLOAT];
  }
  if (lane_unary_kind(t) || t == ir.K_VEXTRACT || t == ir.K_VBITMASK || t == ir.K_VEXTRACT_BITS
    || t == ir.K_VIEXTRACTS || t == ir.K_VIEXTRACTU || t == ir.K_VIBITMASK) {
    return [C_LANE];
  }
  if (lane_binary_kind(t)) {
    return [C_LANE, C_LANE];
  }
  if (t == ir.K_VFMA || t == ir.K_VSELECT) {
    return [C_LANE, C_LANE, C_LANE];
  }
  if (t == ir.K_VREPLACE) {
    return [C_LANE, C_FLOAT];
  }
  if (t == ir.K_VIREPLACE || t >= ir.K_VISHL && t <= ir.K_VISHRU) {
    return [C_LANE, C_INT];
  }
  if (t == ir.K_VPERMUTE) {
    return [C_LANE, 0];
  }
  if (t == ir.K_VSTORE) {
    return [C_INT, C_LANE];
  }
  if (t == ir.K_VGET) {
    return [C_INT, C_INT];
  }
  if (t == ir.K_VSET) {
    return [C_INT, C_INT, C_LANE];
  }
  return [];
}

// The class of the value that an op pushes, or 0.
function result_class(t: i32): i32 {
  if (t == ir.K_CONST_I32 || t == ir.K_CONST_I32_TEXT || t == ir.K_CONST_I64 || int_binary_kind(t) || t == ir.K_NOT
    || t >= ir.K_FEQ && t <= ir.K_FGE || t == ir.K_F64_TO_I32 || t == ir.K_F64_TO_I64 || t == ir.K_F64_BITS
    || t == ir.K_VBITMASK || t == ir.K_VEXTRACT_BITS || t == ir.K_VIEXTRACTS || t == ir.K_VIEXTRACTU || t == ir.K_VIBITMASK) {
    return C_INT;
  }
  if (t == ir.K_CONST_F64 || t >= ir.K_FADD && t <= ir.K_FDIV || float_unary_kind(t) || t == ir.K_FFMA
    || t == ir.K_I32_TO_F64 || t == ir.K_F64_FROM_BITS || t == ir.K_VEXTRACT) {
    return C_FLOAT;
  }
  if (ir.is_lane_kind(t) && t != ir.K_VSTORE && t != ir.K_VSET) {
    return C_LANE;
  }
  return 0;
}

function set_class(cls: i32[], at: i32, c: i32): i32[] {
  let out = cls;
  while (out.len() <= at) {
    out = out.append(0);
  }
  return out.with(at, c);
}

// A problem for each operand whose known class is not the class that the op reads.
function class_problems(out: irverify.Problem[], fn_name: string, at: i32, kind: string, want: i32[], cls: i32[], top: i32): irverify.Problem[] {
  let res = out;
  let first = top - want.len();
  for k in 0..want.len() {
    let have = if (first + k < cls.len()) { cls[first + k] } else { 0 };
    if (want[k] != 0 && have != 0 && have != want[k]) {
      res = res.append(irverify.Problem {
        fn_name: fn_name, op: at, kind: kind,
        msg: "operand " + util.i32_to_string(k + 1) + " of " + util.i32_to_string(want.len())
          + " is " + class_name(have) + ", but the op reads " + class_name(want[k]),
      });
    }
  }
  return res;
}

pub function verify_stack_fn(fn_name: string, ops: ir.Op[], pops: i32[]): StackResult {
  let out: irverify.Problem[] = [];
  let none: irverify.Problem[] = [];

  let fr_kind: i32[] = [0];
  let fr_at: i32[] = [-1];
  let fr_height: i32[] = [0];
  let fr_unreach: i32[] = [0];
  let fr_else: i32[] = [0];
  let depth = 1;

  let height = 0;
  let cls: i32[] = [];

  for i in 0..ops.len() {
    let o = ops[i];
    let t = o.kind_tag;
    let base = fr_height[depth - 1];
    let unreach = fr_unreach[depth - 1] != 0;

    if (t == ir.K_BLOCK || t == ir.K_LOOP || t == ir.K_IF) {
      if (t == ir.K_IF) {
        if (height > base) {
          out = class_problems(out, fn_name, i, "if", [C_INT], cls, height);
          height -= 1;
        } else if (!unreach) {
          out = out.append(irverify.Problem {
            fn_name: fn_name, op: i, kind: "if",
            msg: "operand stack underflow - the if needs a condition, but the enclosing scope holds none",
          });
        }
      }
      if (o.i32_imm != 0) {
        return StackResult { problems: none, bail: "non-void block type " + util.i32_to_string(o.i32_imm) };
      }
      if (depth < fr_kind.len()) {
        fr_kind = fr_kind.with(depth, t);
        fr_at = fr_at.with(depth, i);
        fr_height = fr_height.with(depth, height);
        fr_unreach = fr_unreach.with(depth, 0);
        fr_else = fr_else.with(depth, 0);
      } else {
        fr_kind = fr_kind.append(t);
        fr_at = fr_at.append(i);
        fr_height = fr_height.append(height);
        fr_unreach = fr_unreach.append(0);
        fr_else = fr_else.append(0);
      }
      depth += 1;
    } else if (t == ir.K_ELSE) {
      if (depth == 1 || fr_kind[depth - 1] != 154 || fr_else[depth - 1] != 0) {
        return StackResult { problems: none, bail: "malformed else" };
      }
      if (!unreach && height != base) {
        out = out.append(irverify.Problem {
          fn_name: fn_name, op: i, kind: "else",
          msg: "the then-arm leaves " + util.i32_to_string(height - base)
            + " operand slot(s), but the if opened at op "
            + util.i32_to_string(fr_at[depth - 1]) + " is void",
        });
      }
      fr_else = fr_else.with(depth - 1, 1);
      fr_unreach = fr_unreach.with(depth - 1, 0);
      height = base;
    } else if (t == ir.K_END) {
      if (depth == 1) {
        return StackResult { problems: none, bail: "end with no open scope" };
      }
      if (!unreach && height != base) {
        out = out.append(irverify.Problem {
          fn_name: fn_name, op: i, kind: "end",
          msg: "the " + ir.kind_name(fr_kind[depth - 1]) + " opened at op "
            + util.i32_to_string(fr_at[depth - 1]) + " leaves "
            + util.i32_to_string(height - base) + " operand slot(s), but it is void",
        });
      }
      height = base;
      depth -= 1;
    } else if (t == ir.K_BR || t == ir.K_BRIF) {
      if (t == ir.K_BRIF) {
        if (height > base) {
          out = class_problems(out, fn_name, i, "brif", [C_INT], cls, height);
          height -= 1;
        } else if (!unreach) {
          out = out.append(irverify.Problem {
            fn_name: fn_name, op: i, kind: "brif",
            msg: "operand stack underflow - the brif needs a condition, but the enclosing scope holds none",
          });
        }
      }
      let d = o.i32_imm;
      if (d < 0 || d >= depth) {
        return StackResult { problems: none, bail: "branch depth has no target" };
      }
      if (!unreach && depth - 1 - d == 0 && height - base < fn_result_slots()) {
        out = out.append(irverify.Problem {
          fn_name: fn_name, op: i, kind: ir.kind_name(t),
          msg: "branch to the function body needs " + util.i32_to_string(fn_result_slots())
            + " operand slot(s) for the result, but "
            + util.i32_to_string(height - base) + " are available",
        });
      }
      if (t == ir.K_BR) {
        fr_unreach = fr_unreach.with(depth - 1, 1);
        height = base;
      }
    } else {
      let np = ir.op_pops_by(pops, o);
      if (np < 0) {
        return StackResult { problems: none, bail: "unmodelled op " + ir.kind_name(t) };
      }
      if (np > height - base) {
        if (!unreach) {
          out = out.append(irverify.Problem {
            fn_name: fn_name, op: i, kind: ir.kind_name(t),
            msg: "operand stack underflow - needs " + util.i32_to_string(np)
              + " operand slot(s), but the enclosing scope holds "
              + util.i32_to_string(height - base),
          });
        }
        height = base;
      } else {
        let want = operand_classes(t);
        if (!unreach && want.len() == np) {
          out = class_problems(out, fn_name, i, ir.kind_name(t), want, cls, height);
        }
        height -= np;
      }
      let rc = if (t == ir.K_TEE_LOCAL && np == 1 && height < cls.len()) { cls[height] } else { result_class(t) };
      if (ir.op_pushes(o) == 1) {
        cls = set_class(cls, height, rc);
      }
      height += ir.op_pushes(o);
      if (t == ir.K_RETURN) {
        fr_unreach = fr_unreach.with(depth - 1, 1);
        height = fr_height[depth - 1];
      }
    }
  }

  if (depth != 1) {
    return StackResult { problems: out, bail: "" };
  }
  if (fr_unreach[0] == 0 && height != 0) {
    out = out.append(irverify.Problem {
      fn_name: fn_name, op: ops.len() - 1, kind: ir.kind_name(ops[ops.len() - 1].kind_tag),
      msg: "the function falls off its end holding " + util.i32_to_string(height)
        + " operand slot(s), which the backend's fallthrough result is then pushed on top of",
    });
  }
  return StackResult { problems: out, bail: "" };
}
