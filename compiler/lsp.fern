// compiler/lsp.fern — the wire half of `fern -lsp`, the self-host
// language server (#6641): JSON-RPC 2.0 messages framed by `Content-Length`
// headers on stdin and stdout, and the LSP shapes the server answers with.
// What a message asks for — checking a document, formatting one, describing a
// name in it — is fern.fern's business; this module only reads and writes the
// protocol, so it needs nothing of the compiler but util.
//
// Positions are where the two sides disagree. Fern counts 1-based lines and
// 1-based UTF-8 byte columns; LSP counts 0-based lines and 0-based UTF-16
// code units, its default positionEncoding. The two agree only on an ASCII
// line, so every position crosses through utf16_col, as native's do (#8468).

import "std/json";
import "./util";

// Input is stdin and whatever has been read from it past the last frame.
pub struct Input { r: Reader, pending: string }

pub function stdin_input(): Input {
  return Input { r: stdin(), pending: "" };
}

// Frame is one read: a message body, or the end of the session — `done`, with
// `err` saying why when the stream could not be framed rather than closed.
pub struct Frame { inp: Input, body: string, done: boolean, err: string }

// fill reads one more chunk of input; false at end of input or on a read
// error, either of which ends the session.
function fill(inp: Input): (Input, boolean) {
  match (inp.r.read_chunk_bytes(65536)) {
    Ok(chunk) => {
      if (chunk.len() == 0) {
        return (inp, false);
      }
      return (Input { r: inp.r, pending: inp.pending + string_from_bytes_unchecked(chunk) }, true);
    },
    Err(_) => {
      return (inp, false);
    }
  }
  return (inp, false);
}

// read_frame reads one message. Input that ends between messages, or inside a
// header block, is a client hanging up; input that ends inside a body it
// announced is a broken stream.
pub function read_frame(inp: Input): Frame {
  let at: i32 = util.index_of_sub(inp.pending, "\r\n\r\n");
  while (at < 0) {
    let (more, ok) = fill(inp);
    inp = more;
    if (!ok) {
      return Frame { inp: inp, body: "", done: true, err: "" };
    }
    at = util.index_of_sub(inp.pending, "\r\n\r\n");
  }
  let n: i32 = content_length(slice_unchecked(inp.pending, 0, at) + "");
  if (n < 0) {
    return Frame { inp: inp, body: "", done: true, err: "missing Content-Length header" };
  }
  let start: i32 = at + 4;
  while (inp.pending.len() - start < n) {
    let (more, ok) = fill(inp);
    inp = more;
    if (!ok) {
      return Frame { inp: inp, body: "", done: true, err: "input ended inside a message" };
    }
  }
  let body: string = slice_unchecked(inp.pending, start, start + n) + "";
  let rest: string = slice_unchecked(inp.pending, start + n, inp.pending.len()) + "";
  return Frame { inp: Input { r: inp.r, pending: rest }, body: body, done: false, err: "" };
}

// content_length is the value of a header block's Content-Length, or -1 when
// it has none. Header names are case-insensitive; every other header (the
// spec's Content-Type is the only one) is ignored.
function content_length(headers: string): i32 {
  let n: i32 = 0 - 1;
  let rest: string = headers;
  while (rest.len() > 0) {
    let end: i32 = util.index_of_sub(rest, "\r\n");
    if (end < 0) {
      end = rest.len();
    }
    let line: string = slice_unchecked(rest, 0, end) + "";
    let colon: i32 = util.index_of_sub(line, ":");
    if (colon > 0 && lower_ascii(util.trim(slice_unchecked(line, 0, colon) + "")) == "content-length") {
      let v: string = util.trim(slice_unchecked(line, colon + 1, line.len()) + "");
      if (util.is_all_digits(v)) {
        n = util.digits_to_i32(v);
      }
    }
    if (end + 2 >= rest.len()) {
      return n;
    }
    rest = slice_unchecked(rest, end + 2, rest.len()) + "";
  }
  return n;
}

function lower_ascii(s: string): string {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    let b: i32 = s[i] as i32;
    if (b >= 65 && b <= 90) {
      b = b + 32;
    }
    out = out.append(b as u8);
    i = i + 1;
  }
  return string_from_bytes_unchecked(out);
}

// Message is one decoded JSON-RPC message. `id` is a request's id as JSON
// text, echoed back verbatim in the response, and empty on a notification.
pub struct Message { method: string, id: string, params: json.JsonValue }

// parse_message decodes a frame body, or None when it is not JSON or has no
// method: a message without one is a response, and this server sends no
// requests to be answered.
pub function parse_message(body: string): Option[Message] {
  match (json.json_parse(body)) {
    Some(v) => {
      let method: string = get_string(v, "method");
      if (method.len() == 0) {
        return None;
      }
      let id: string = "";
      match (json.json_get(v, "id")) {
        Some(iv) => {
          id = json.json_encode(iv);
        },
        None => {}
      }
      return Some(Message { method: method, id: id, params: get_value(v, "params") });
    },
    None => {
      return None;
    }
  }
  return None;
}

// get_value is v's member `key`, or null when v has none.
pub function get_value(v: json.JsonValue, key: string): json.JsonValue {
  match (json.json_get(v, key)) {
    Some(m) => {
      return m;
    },
    None => {
      return JNull;
    }
  }
  return JNull;
}

// get_string is v's string member `key`, or "" when v has none.
pub function get_string(v: json.JsonValue, key: string): string {
  match (json.json_get_string(v, key)) {
    Some(s) => {
      return s;
    },
    None => {
      return "";
    }
  }
  return "";
}

// document_uri is the `textDocument.uri` every document request and
// notification names.
pub function document_uri(params: json.JsonValue): string {
  return get_string(get_value(params, "textDocument"), "uri");
}

// position is a position request's 0-based line and UTF-16 character, or
// (-1, -1) when it carries none.
pub function position(params: json.JsonValue): (i32, i32) {
  return position_in(get_value(params, "position"));
}

// position_in is the 0-based line and UTF-16 character of the Position `p`,
// or (-1, -1) when it is not one.
function position_in(p: json.JsonValue): (i32, i32) {
  match (json.json_get_i32(p, "line")) {
    Some(line) => {
      match (json.json_get_i32(p, "character")) {
        Some(ch) => {
          return (line, ch);
        },
        None => {}
      }
    },
    None => {}
  }
  return (0 - 1, 0 - 1);
}

// request_range is a range request's start and end, each a 0-based line and
// UTF-16 character, or all -1 when it carries none.
pub function request_range(params: json.JsonValue): (i32, i32, i32, i32) {
  let r: json.JsonValue = get_value(params, "range");
  let (l0, c0) = position_in(get_value(r, "start"));
  let (l1, c1) = position_in(get_value(r, "end"));
  if (l0 < 0 || l1 < 0) {
    return (0 - 1, 0 - 1, 0 - 1, 0 - 1);
  }
  return (l0, c0, l1, c1);
}

// changed_text is a didChange's new document text: the last content change,
// which under full sync is the whole document. None when there is none.
pub function changed_text(params: json.JsonValue): Option[string] {
  match (json.json_get_array(params, "contentChanges")) {
    Some(cs) => {
      if (cs.len() == 0) {
        return None;
      }
      return json.json_get_string(cs[cs.len() - 1], "text");
    },
    None => {
      return None;
    }
  }
  return None;
}

// send writes one message, framed. Content-Length counts bytes, which is what
// a Fern string's len() is.
pub function send(body: string): void {
  write("Content-Length: " + util.i32_to_string(body.len()) + "\r\n\r\n" + body);
}

// response answers request `id` with `result`, a JSON value.
pub function response(id: string, result: string): string {
  return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}";
}

// method_not_found answers a request for a method this server does not
// implement (JSON-RPC's -32601).
pub function method_not_found(id: string, method: string): string {
  return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":-32601,\"message\":" + quote("unknown method: " + method) + "}}";
}

pub function notification(method: string, params: string): string {
  return "{\"jsonrpc\":\"2.0\",\"method\":" + quote(method) + ",\"params\":" + params + "}";
}

function quote(s: string): string {
  return "\"" + json.json_escape(s) + "\"";
}

// initialize_result advertises what this server does: full-document sync
// (every didChange carries the whole text), diagnostics, formatting, hover,
// go-to-definition, completion (asked again after a `.`), signature help (after
// a `(` or `,`), the document's outline, inlay hints, quick fixes, references,
// renaming, and semantic tokens of the types semantic_token_types() lists.
pub function initialize_result(): string {
  let types: string[] = [];
  for t in semantic_token_types() {
    types = types.append(quote(t));
  }
  let caps: string = "\"textDocumentSync\":1,\"documentFormattingProvider\":true,\"hoverProvider\":true,\"definitionProvider\":true,"
    + "\"completionProvider\":{\"triggerCharacters\":[\".\"]},"
    + "\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"],\"retriggerCharacters\":[\",\"]},"
    + "\"documentSymbolProvider\":true,\"inlayHintProvider\":true,\"codeActionProvider\":true,\"referencesProvider\":true,\"renameProvider\":true,"
    + "\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":" + json_array(types) + ",\"tokenModifiers\":[]},\"full\":true}";
  return "{\"capabilities\":{" + caps + "},\"serverInfo\":{\"name\":\"fern\"}}";
}

// semantic_token_types is the legend of semantic token types: a token's type
// is its index here.
pub function semantic_token_types(): string[] {
  return ["function", "method", "struct", "enum", "enumMember", "parameter", "variable", "property", "type", "keyword", "namespace"];
}

// SemanticToken is a token to send: its 0-based line, its start and length in
// UTF-16 units, and its type's index in semantic_token_types().
pub struct SemanticToken { line: i32, start: i32, len: i32, kind: i32 }

// semantic_tokens is SemanticTokens holding `toks` in position order, each
// token's line and start relative to the token before it, as LSP encodes them.
pub function semantic_tokens(toks: SemanticToken[]): string {
  let out: string[] = [];
  let line: i32 = 0;
  let start: i32 = 0;
  for t in sorted_tokens(toks) {
    if (t.line != line) {
      start = 0;
    }
    out = out.append(util.i32_to_string(t.line - line) + "," + util.i32_to_string(t.start - start) + "," + util.i32_to_string(t.len) + "," + util.i32_to_string(t.kind) + ",0");
    line = t.line;
    start = t.start;
  }
  return "{\"data\":" + json_array(out) + "}";
}

// sorted_tokens is `toks` in position order, by merging sorted halves.
function sorted_tokens(toks: SemanticToken[]): SemanticToken[] {
  if (toks.len() <= 1) {
    return toks;
  }
  let half: i32 = toks.len() / 2;
  let a: SemanticToken[] = sorted_tokens(token_range(toks, 0, half));
  let b: SemanticToken[] = sorted_tokens(token_range(toks, half, toks.len()));
  let out: SemanticToken[] = [];
  let i: i32 = 0;
  let j: i32 = 0;
  while (i < a.len() || j < b.len()) {
    if (j >= b.len() || i < a.len() && (a[i].line < b[j].line || a[i].line == b[j].line && a[i].start <= b[j].start)) {
      out = out.append(a[i]);
      i = i + 1;
    } else {
      out = out.append(b[j]);
      j = j + 1;
    }
  }
  return out;
}

function token_range(toks: SemanticToken[], from: i32, to: i32): SemanticToken[] {
  let out: SemanticToken[] = [];
  let i: i32 = from;
  while (i < to) {
    out = out.append(toks[i]);
    i = i + 1;
  }
  return out;
}

// completion_list is a CompletionList holding every item there is.
pub function completion_list(items: string[]): string {
  return "{\"isIncomplete\":false,\"items\":" + json_array(items) + "}";
}

// completion_item is a CompletionItem of CompletionItemKind `kind`; an empty
// `detail` is left out.
pub function completion_item(label: string, kind: i32, detail: string): string {
  let out: string = "{\"label\":" + quote(label) + ",\"kind\":" + util.i32_to_string(kind);
  if (detail.len() > 0) {
    out = out + ",\"detail\":" + quote(detail);
  }
  return out + "}";
}

// signature_help is a SignatureHelp offering one signature, `label`, whose
// parameters are its bytes `starts[i]` to `ends[i]`, with `active` the one the
// cursor is on. A parameter is named by its offsets in UTF-16 units rather
// than its text, which another parameter of the same type would share.
pub function signature_help(label: string, starts: i32[], ends: i32[], active: i32): string {
  let params: string[] = [];
  let i: i32 = 0;
  while (i < starts.len()) {
    params = params.append("{\"label\":[" + util.i32_to_string(utf16_units(label, starts[i])) + "," + util.i32_to_string(utf16_units(label, ends[i])) + "]}");
    i = i + 1;
  }
  let sig: string = "{\"label\":" + quote(label);
  if (params.len() > 0) {
    sig = sig + ",\"parameters\":" + json_array(params);
  }
  return "{\"signatures\":[" + sig + "}],\"activeSignature\":0,\"activeParameter\":" + util.i32_to_string(active) + "}";
}

// document_symbol is a DocumentSymbol of SymbolKind `kind`; an empty `detail`
// and no `children` are left out.
pub function document_symbol(name: string, detail: string, kind: i32, range: string, selection: string, children: string[]): string {
  let out: string = "{\"name\":" + quote(name);
  if (detail.len() > 0) {
    out = out + ",\"detail\":" + quote(detail);
  }
  out = out + ",\"kind\":" + util.i32_to_string(kind) + ",\"range\":" + range + ",\"selectionRange\":" + selection;
  if (children.len() > 0) {
    out = out + ",\"children\":" + json_array(children);
  }
  return out + "}";
}

// inlay_hint is a type InlayHint showing `label` at the 0-based `line` and
// UTF-16 `character`.
pub function inlay_hint(line: i32, character: i32, label: string): string {
  return "{\"position\":" + position_json(line, character) + ",\"label\":" + quote(label) + ",\"kind\":1}";
}

// hover_result is a Hover showing `code` as a Fern code block over `range`.
pub function hover_result(code: string, range: string): string {
  return "{\"contents\":{\"kind\":\"markdown\",\"value\":" + quote("```fern\n" + code + "\n```") + "},\"range\":" + range + "}";
}

// location is a Location: `range` in the document `uri` names.
pub function location(uri: string, range: string): string {
  return "{\"uri\":" + quote(uri) + ",\"range\":" + range + "}";
}

// publish_diagnostics replaces the diagnostics the client shows for `uri`
// with `diagnostics`, a JSON array.
pub function publish_diagnostics(uri: string, diagnostics: string): string {
  return notification("textDocument/publishDiagnostics", "{\"uri\":" + quote(uri) + ",\"diagnostics\":" + diagnostics + "}");
}

// json_array joins already-encoded JSON values into an array.
pub function json_array(items: string[]): string {
  let out: string = "[";
  let i: i32 = 0;
  while (i < items.len()) {
    if (i > 0) {
      out = out + ",";
    }
    out = out + items[i];
    i = i + 1;
  }
  return out + "]";
}

// diagnostic is one LSP Diagnostic in document `src`, at Fern's 1-based
// `line` and byte `col`. With no line it covers nothing at the start of the
// document; otherwise it covers the one character the position names, as
// native's does when an error carries no width. `code` is sent only when it
// is a real diagnostic code — the code a client deep-links, so the checker's
// "type" marker is not one. `data`, when not empty, is a fix (fix_data) for a
// code action to apply.
pub function diagnostic(src: Text, line: i32, col: i32, code: string, message: string, warning: boolean, data: string): string {
  let r: string = range_json(0, 0, 0, 0);
  if (line > 0) {
    let c: i32 = utf16_col(line_text(src, line), col);
    r = range_json(line - 1, c, line - 1, c + 1);
  }
  let severity: string = "1";
  if (warning) {
    severity = "2";
  }
  let out: string = "{\"range\":" + r + ",\"severity\":" + severity + ",\"source\":\"fern\"";
  if (util.is_diagnostic_code(code)) {
    out = out + ",\"code\":" + quote(code);
  }
  out = out + ",\"message\":" + quote(message);
  if (data.len() > 0) {
    out = out + ",\"data\":" + data;
  }
  return out + "}";
}

// fix_data is a diagnostic's `data` for a fix replacing `range` with
// `new_text`, which a client echoes back in a codeAction request: the request
// alone then says what to apply.
pub function fix_data(range: string, new_text: string, title: string): string {
  return "{\"range\":" + range + ",\"newText\":" + quote(new_text) + ",\"title\":" + quote(title) + "}";
}

// code_actions answers a codeAction request: a quick fix for each diagnostic
// in its context whose `data` is a fix_data, editing the request's document.
// The diagnostic is named in the action as the client sent it.
pub function code_actions(params: json.JsonValue): string {
  let uri: string = document_uri(params);
  let out: string[] = [];
  match (json.json_get_array(get_value(params, "context"), "diagnostics")) {
    Some(ds) => {
      for d in ds {
        let data: json.JsonValue = get_value(d, "data");
        let title: string = get_string(data, "title");
        let text: string = get_string(data, "newText");
        let range: json.JsonValue = get_value(data, "range");
        if (title.len() > 0 && text.len() > 0 && !json.json_is_null(range)) {
          let edit: string = text_edit(json.json_encode(range), text);
          out = out.append("{\"title\":" + quote(title) + ",\"kind\":\"quickfix\",\"diagnostics\":[" + json.json_encode(d) + "],\"edit\":" + workspace_edit([uri], [[edit]]) + "}");
        }
      }
    },
    None => {}
  }
  return json_array(out);
}

// text_edit is a TextEdit replacing `range` with `text`.
pub function text_edit(range: string, text: string): string {
  return "{\"range\":" + range + ",\"newText\":" + quote(text) + "}";
}

// include_declaration is a references request's
// `context.includeDeclaration`, true when it is not given.
pub function include_declaration(params: json.JsonValue): boolean {
  match (json.json_get_bool(get_value(params, "context"), "includeDeclaration")) {
    Some(b) => {
      return b;
    },
    None => {}
  }
  return true;
}

// workspace_edit is a WorkspaceEdit making `edits[i]`, TextEdits, in the
// document `uris[i]` names.
pub function workspace_edit(uris: string[], edits: string[][]): string {
  let out: string = "{\"changes\":{";
  let i: i32 = 0;
  while (i < uris.len()) {
    if (i > 0) {
      out = out + ",";
    }
    out = out + quote(uris[i]) + ":" + json_array(edits[i]);
    i = i + 1;
  }
  return out + "}}";
}

// span_range is the range of the `len` bytes at Fern's 1-based `line` and
// byte `col` of `src`, which lie on one line.
pub function span_range(src: Text, line: i32, col: i32, len: i32): string {
  let text: string = line_text(src, line);
  return range_json(line - 1, utf16_col(text, col), line - 1, utf16_col(text, col + len));
}

// lsp_position is the 0-based line and UTF-16 character of Fern's 1-based
// `line` and byte `col` of `src`.
pub function lsp_position(src: Text, line: i32, col: i32): (i32, i32) {
  return (line - 1, utf16_col(line_text(src, line), col));
}

// span_between is the range from Fern's `l0`, `c0` to `l1`, `c1` of `src`.
pub function span_between(src: Text, l0: i32, c0: i32, l1: i32, c1: i32): string {
  return range_json(l0 - 1, utf16_col(line_text(src, l0), c0), l1 - 1, utf16_col(line_text(src, l1), c1));
}

function range_json(l0: i32, c0: i32, l1: i32, c1: i32): string {
  return "{\"start\":" + position_json(l0, c0) + ",\"end\":" + position_json(l1, c1) + "}";
}

function position_json(line: i32, character: i32): string {
  return "{\"line\":" + util.i32_to_string(line) + ",\"character\":" + util.i32_to_string(character) + "}";
}

// whole_document_edit is a TextEdit replacing all of `src` with `text`. The
// end position is the last line's length in UTF-16 units, since the client
// replaces exactly that range and the last line may hold non-ASCII.
pub function whole_document_edit(src: string, text: string): string {
  let t: Text = text_of(src);
  let last: i32 = t.starts.len() - 1;
  let tail: string = slice_unchecked(src, t.starts[last], src.len()) + "";
  return text_edit(range_json(0, 0, last, utf16_units(tail, tail.len())), text);
}

// Text is a document's text and the offset each of its lines starts at, so a
// position on any line converts without scanning the lines before it.
pub struct Text { src: string, starts: i32[] }

pub function text_of(src: string): Text {
  let starts: i32[] = [0];
  let i: i32 = 0;
  while (i < src.len()) {
    if (src[i] == b'\n') {
      starts = starts.append(i + 1);
    }
    i = i + 1;
  }
  return Text { src: src, starts: starts };
}

// line_text is the text's 1-based line n without its line ending, or "" when
// it has no such line — which makes a stale position convert as ASCII rather
// than fail.
pub function line_text(t: Text, n: i32): string {
  if (n < 1 || n > t.starts.len()) {
    return "";
  }
  let start: i32 = t.starts[n - 1];
  let end: i32 = t.src.len();
  if (n < t.starts.len()) {
    end = t.starts[n] - 1;
  }
  if (end > start && t.src[end - 1] == b'\r') {
    end = end - 1;
  }
  return slice_unchecked(t.src, start, end) + "";
}

// utf16_col converts a 1-based byte column within `line` to the 0-based UTF-16
// offset LSP counts. A column past the end of the line clamps to the end.
pub function utf16_col(line: string, col: i32): i32 {
  if (col <= 1) {
    return 0;
  }
  let b: i32 = col - 1;
  if (b > line.len()) {
    b = line.len();
  }
  return utf16_units(line, b);
}

// byte_col converts a 0-based UTF-16 offset within `line` to the 1-based byte
// column Fern counts, the inverse of utf16_col. An offset past the end of the
// line clamps to just past it, and one inside a surrogate pair to the start
// of its scalar.
pub function byte_col(line: string, units: i32): i32 {
  let u: i32 = 0;
  let i: i32 = 0;
  while (i < line.len()) {
    let b: i32 = line[i] as i32;
    let w: i32 = 1;
    let n: i32 = 1;
    if (b >= 240) {
      w = 2;
      n = 4;
    } else if (b >= 224) {
      n = 3;
    } else if (b >= 192) {
      n = 2;
    }
    if (u + w > units) {
      return i + 1;
    }
    u = u + w;
    i = i + n;
  }
  return line.len() + 1;
}

// utf16_units counts the UTF-16 code units in the first `n` bytes of `s`: one
// per scalar, and a second for one outside the BMP, which is a 4-byte UTF-8
// sequence. A continuation byte (10xxxxxx) starts no scalar.
function utf16_units(s: string, n: i32): i32 {
  let units: i32 = 0;
  let i: i32 = 0;
  while (i < n) {
    let b: i32 = s[i] as i32;
    if (b < 128 || b >= 192) {
      units = units + 1;
    }
    if (b >= 240) {
      units = units + 1;
    }
    i = i + 1;
  }
  return units;
}

// uri_path is the filesystem path a file:// URI names, percent-decoded, or ""
// for any other URI (an untitled buffer, the playground's opaque ones) and
// for one whose escapes do not decode. The authority, if any, is ignored, as
// it is by native's url.Parse reading.
pub function uri_path(uri: string): string {
  let scheme: string = "file://";
  if (uri.len() <= scheme.len() || slice_unchecked(uri, 0, scheme.len()) != scheme) {
    return "";
  }
  let rest: string = slice_unchecked(uri, scheme.len(), uri.len()) + "";
  let slash: i32 = util.index_of_sub(rest, "/");
  if (slash < 0) {
    return "";
  }
  return percent_decode(slice_unchecked(rest, slash, rest.len()) + "");
}

// file_uri is the file:// URI naming the absolute `path`, every byte outside
// RFC 3986's unreserved set and `/` percent-encoded.
pub function file_uri(path: string): string {
  let hex: string = "0123456789ABCDEF";
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < path.len()) {
    let b: i32 = path[i] as i32;
    if (uri_unreserved(b)) {
      out = out.append(path[i]);
    } else {
      out = out.append(b'%').append(hex[b / 16]).append(hex[b % 16]);
    }
    i = i + 1;
  }
  return "file://" + string_from_bytes_unchecked(out);
}

function uri_unreserved(b: i32): boolean {
  return b >= 97 && b <= 122 || b >= 65 && b <= 90 || b >= 48 && b <= 57 || b == 45 || b == 46 || b == 95 || b == 126 || b == 47;
}

// percent_decode undoes a URI's %XX escapes, or returns "" when one is
// malformed.
function percent_decode(s: string): string {
  let out: u8[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    if (s[i] != b'%') {
      out = out.append(s[i]);
      i = i + 1;
      continue;
    }
    if (i + 2 >= s.len()) {
      return "";
    }
    let hi: i32 = hex_digit(s[i + 1] as i32);
    let lo: i32 = hex_digit(s[i + 2] as i32);
    if (hi < 0 || lo < 0) {
      return "";
    }
    out = out.append((hi * 16 + lo) as u8);
    i = i + 3;
  }
  return string_from_bytes_unchecked(out);
}

function hex_digit(b: i32): i32 {
  if (b >= 48 && b <= 57) {
    return b - 48;
  }
  if (b >= 97 && b <= 102) {
    return b - 87;
  }
  if (b >= 65 && b <= 70) {
    return b - 55;
  }
  return 0 - 1;
}
