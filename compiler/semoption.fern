import "./ssa";
import "./ssasem";
import "./semrecords";
import "./typeinfo";

function option_schema(f: ssasem.Func, t: typeinfo.Type): i32 {
  let at = semrecords.find_enum(f.enums, t);
  if (at < 0 || ssasem.has_finalizer(f, t)) {
    return -1;
  }
  let e = f.enums[at];
  if (e.layout != semrecords.layout_option() || e.variants.len() != 2) {
    return -1;
  }
  let some = e.variants[0];
  let none = e.variants[1];
  if (some.name != "Some" || none.name != "None" || some.fields.len() != 1 || none.fields.len() != 0) {
    return -1;
  }
  if (!ssasem.is_scalar(some.fields[0].ty)) {
    return -1;
  }
  return at;
}

function member(active: boolean[], v: i32): boolean {
  return v >= 0 && v < active.len() && active[v];
}

function local_origin(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssasem.variant_new() || ins.kind_tag == ssa.COPY || ins.kind_tag == ssa.PHI
    || ins.kind_tag == ssa.BINARY && ssasem.checked_arith(ins.str);
}

function local_read(ins: ssa.SInst, active: boolean[]): boolean {
  if (ins.kind_tag == ssa.COPY || ins.kind_tag == ssa.PHI) {
    return member(active, ins.result);
  }
  if (ins.args.len() != 1) {
    return false;
  }
  if (ins.kind_tag == ssasem.variant_is()) {
    return ins.str == "Some" || ins.str == "None";
  }
  return ins.kind_tag == ssasem.variant_get() && ins.str == "Some" && ins.imm == 0;
}

function candidates(f: ssasem.Func): boolean[] {
  let active: boolean[] = [];
  let peers: i32[][] = [];
  let bad = __alloc_bool(f.values.len());
  for t in f.values {
    active = active.append(option_schema(f, t) >= 0);
    peers = peers.append([]);
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      let r = ins.result;
      if (member(active, r) && !local_origin(ins)) {
        bad = bad.with(r, true);
      }
      for a in ins.args {
        if (member(active, a)) {
          if (!local_read(ins, active)) {
            bad = bad.with(a, true);
          }
          if ((ins.kind_tag == ssa.COPY || ins.kind_tag == ssa.PHI) && member(active, r)) {
            peers = peers.with(a, peers[a].append(r));
            peers = peers.with(r, peers[r].append(a));
          }
        } else if (member(active, r) && (ins.kind_tag == ssa.COPY || ins.kind_tag == ssa.PHI)) {
          bad = bad.with(r, true);
        }
      }
    }
    if (b.term.kind_tag == ssa.TERM_RET && member(active, b.term.value)) {
      bad = bad.with(b.term.value, true);
    }
    if (b.term.kind_tag == ssa.TERM_BRIF && member(active, b.term.cond)) {
      bad = bad.with(b.term.cond, true);
    }
  }
  let queue: i32[] = [];
  let v = 0;
  while (v < active.len()) {
    if (active[v] && bad[v]) {
      queue = queue.append(v);
      active = active.with(v, false);
    }
    v += 1;
  }
  let i = 0;
  while (i < queue.len()) {
    for p in peers[queue[i]] {
      if (active[p]) {
        active = active.with(p, false);
        queue = queue.append(p);
      }
    }
    i += 1;
  }
  return active;
}

function pair(ins: ssa.SInst, payloads: i32[]): ssa.SInst[] {
  let tag = ins;
  let payload = ssa.SInst { ...ins, result: payloads[ins.result] };
  if (ins.kind_tag == ssa.BINARY && ssasem.checked_arith(ins.str)) {
    tag = ssa.SInst { ...tag, kind_tag: ssasem.checked_present() };
    payload = ssa.SInst { ...payload, kind_tag: ssasem.checked_value(), args: ins.args.append(ins.result) };
  } else if (ins.kind_tag == ssasem.variant_new()) {
    let present = 0;
    if (ins.str == "Some") {
      present = 1;
    }
    tag = ssa.SInst { ...tag, kind_tag: 2, args: [], imm: present, str: "" };
    let kind = ssasem.zero();
    if (present == 1) {
      kind = 7;
    }
    payload = ssa.SInst { ...payload, kind_tag: kind, imm: 0, str: "" };
  } else {
    let args: i32[] = [];
    for a in ins.args {
      args = args.append(payloads[a]);
    }
    payload = ssa.SInst { ...payload, args: args };
  }
  return [tag, payload];
}

function projection(ins: ssa.SInst, payloads: i32[]): ssa.SInst {
  let kind = 7;
  let name = "";
  let arg = ins.args[0];
  if (ins.kind_tag == ssasem.variant_get()) {
    arg = payloads[arg];
  } else if (ins.str == "None") {
    kind = 10;
    name = "!";
  }
  return ssa.SInst { ...ins, kind_tag: kind, args: [arg], imm: 0, str: name };
}

pub function split(f: ssasem.Func): ssasem.Func {
  let active = candidates(f);
  let values = f.values;
  let payloads: i32[] = [];
  for v in 0..f.values.len() {
    let p: i32 = -1;
    if (active[v]) {
      p = values.len();
      let at = option_schema(f, f.values[v]);
      values = values.append(f.enums[at].variants[0].fields[0].ty);
      values = values.with(v, typeinfo.TypeBool { tag: 0 });
    }
    payloads = payloads.append(p);
  }
  if (values.len() == f.values.len()) {
    return f;
  }
  let blocks: ssa.SBlock[] = [];
  for b in f.graph.blocks {
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      if (member(active, ins.result)) {
        for part in pair(ins, payloads) {
          insts = insts.append(part);
        }
      } else if (ins.args.len() == 1 && member(active, ins.args[0])) {
        insts = insts.append(projection(ins, payloads));
      } else {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts });
  }
  return unsplit_debug_bindings(ssasem.Func { ...f, values: values, graph: ssa.SFunc { ...f.graph, nvals: values.len(), blocks: blocks } }, active);
}

function unsplit_debug_bindings(f: ssasem.Func, split: boolean[]): ssasem.Func {
  let vals: i32[] = [];
  let names: string[] = [];
  for i in 0..f.dbg_vals.len() {
    let v = f.dbg_vals[i];
    if (!member(split, v)) {
      vals = vals.append(v);
      names = names.append(f.dbg_names[i]);
    }
  }
  return ssasem.Func { ...f, dbg_vals: vals, dbg_names: names };
}
