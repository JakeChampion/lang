// compiler/modloader.fern — the self-host compiler's file-based
// module loader, shared by the import-driven drivers (asm_modload_run,
// checker_modload_run, …). Extracted so each driver differs only in what
// it does with the merged module (emit asm / run the checker / probe IR),
// not in how it resolves and bundles modules from disk.
//
// Given an entry file path, load_graph follows the entry's `import` graph
// (transitively), parses each module, and returns them as
// flatten.LoadedModule[] for flatten.bundle. Resolution:
//
//   * `std/` and `core/` imports resolve under the stdlib root and nowhere
//     else (`import "std/io"` → `<root>/std/io.fern`); every other import
//     resolves beside the file that wrote it, keeping its sub-path, and a
//     bare one that is not there resolves through the governing fern.toml's
//     declared dependencies (try_manifest);
//   * a module's IDENTITY is the file it resolves to, so two modules sharing
//     a basename both load and flatten gives each its own prefix;
//   * a `.fern` that is not there is read from its literate `.fern.md`
//     sibling, tangled (read_module);
//   * a `std/` or `core/` import is skipped when no stdlib was given (see
//     stdlib_not_given); any other import that resolves to no readable file
//     is returned as a diagnostic for the driver to report.
//
// Uses only features the self-hosted emitter supports (read_file → Result,
// match), so it builds with either compiler.

import "./lexer";
import "./parser";
import "./flatten";
import "./fern_toml";
import "./literate";
import "./util";
import "core/map";
import "std/error";

// dirname returns everything up to and including the last '/', or "" when
// the path has no directory part ("a/b/c.fern" → "a/b/", "main.fern" → "").
pub function dirname(path: string): string {
  let cut: i32 = 0;
  let i: i32 = 0;
  while (i < path.len()) {
    if (path[i] == b'/') {
      cut = i + 1;
    }
    i = i + 1;
  }
  return slice_unchecked(path, 0, cut) + "";
}

// base_name strips the directory and the import-relative `./` prefix from
// an import path: "./lexer" → "lexer", "std/io" → "io".
pub function base_name(path: string): string {
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < path.len()) {
    if (path[i] == b'/') {
      start = i + 1;
    }
    i = i + 1;
  }
  return slice_unchecked(path, start, path.len()) + "";
}

// rel_path strips a leading import-relative `./` and a `.fern` so the path
// joins cleanly onto the entry directory: "./lexer.fern" → "lexer", "std/io" →
// "std/io".
function rel_path(path: string): string {
  if (path.len() >= 2 && slice_unchecked(path, 0, 2) == "./") {
    return util.without_fern_ext(slice_unchecked(path, 2, path.len()) + "");
  }
  return util.without_fern_ext(path);
}

// unreadable reports whether a failed read found the file there but could not
// read it; not finding it is the one error a search goes on past.
function unreadable(e: IoError): boolean {
  if let NotFound(_) = e {
    return false;
  }
  return true;
}

// Resolved is a module's source. `err` is set when a candidate was present but
// unreadable, and `err_path` names it; it ends the search rather than letting a
// later candidate shadow the file (#10142). `shown` names the module: the file
// it was read from, or `stdlib://<path>` for an overlay hit. A module's own
// imports resolve beside the file `shown` names. `map` leads a module tangled
// from a literate document back to it.
pub struct Resolved { src: string, ok: boolean, err: string, err_path: string, shown: string, map: util.LineMap }

function res_none(): Resolved {
  return Resolved { src: "", ok: false, err: "", err_path: "", shown: "", map: util.no_line_map() };
}

// res_read reads `<dir><rel>.fern`, from its buffer when `ov` holds one.
function res_read(ov: Overlay, dir: string, rel: string): Resolved {
  return read_module(ov.files, dir + rel + ".fern");
}

// Buffers is the text of the files an editor holds open, keyed by file path,
// read in place of what is on disk (the language server's unsaved buffers).
pub struct Buffers { paths: string[], srcs: string[] }

pub function no_buffers(): Buffers {
  return Buffers { paths: [], srcs: [] };
}

// read_text is file `path`'s text: its buffer when one is open, else the disk's.
function read_text(bufs: Buffers, path: string): Result[string, IoError] {
  let i: i32 = util.index_of_str(bufs.paths, util.clean_path(path));
  if (i >= 0) {
    return Ok(bufs.srcs[i]);
  }
  return read_file(path);
}

// read_module reads the module file `path`, a `.fern`, or — when there is no
// such file — the literate document `path.md`, tangled to one module, each
// from its buffer in `bufs` when one is open. A plain `.fern` wins over a
// `.fern.md` of the same name.
pub function read_module(bufs: Buffers, path: string): Resolved {
  match (read_text(bufs, path)) {
    Ok(s) => {
      return Resolved { ...res_none(), src: s, ok: true, shown: path };
    },
    Err(e) => {
      if (unreadable(e)) {
        return Resolved { ...res_none(), err: e.message(), err_path: path };
      }
    }
  }
  let doc: string = path + ".md";
  match (read_text(bufs, doc)) {
    Ok(s) => {
      return tangle_module(path, doc, s);
    },
    Err(e) => {
      if (unreadable(e)) {
        return Resolved { ...res_none(), err: e.message(), err_path: doc };
      }
    }
  }
  return Resolved { ...res_none(), err_path: path };
}

// tangle_module is the module `path` read from the literate document `doc`
// holding `src`. A `file=` document is several modules, so it is refused.
function tangle_module(path: string, doc: string, src: string): Resolved {
  if (literate.parse_file_pieces(src).len() > 0) {
    return Resolved { ...res_none(), err: "a multi-file literate document tangles to several modules, not one importable module", err_path: doc };
  }
  match (literate.tangle(src)) {
    literate.TangleOk(o) => {
      return Resolved { ...res_none(), src: o.code, ok: true, shown: path, map: util.LineMap { doc: doc, lits: o.lits, shifts: o.shifts } };
    },
    literate.TangleErr(e) => {
      return Resolved { ...res_none(), err: e.msg, err_path: doc + ":" + util.i32_to_string(e.line) + ":" + util.i32_to_string(e.col) };
    }
  }
  return res_none();
}

// Overlay is an in-memory source table consulted BEFORE disk, keyed by the
// import path as written — `std/io`, `core/map` — with no extension and no
// basename flattening. It is how a compiler with no filesystem under it
// resolves imports: a wasm-hosted driver carries its stdlib as `-embed`
// assets and hands them over as one of these (#6643).
//
// Native has had the same thing since the prelude was retired, in two pieces:
// `stdlib.Resolve` for the embedded std/ + core/ tree and `LoadWith`'s
// override map for the LSP's unsaved buffers, both consulted before the
// filesystem resolver (`internal/pkg/modload/modload.go`).
//
// `srcs` is parallel to `paths` — the tree's idiom for a small keyed table
// (embed.Assets, fern.fern's VendorSet), and a linear scan over a few dozen
// modules is not worth a map.
//
// `sealed` says the overlay IS the filesystem: a miss is a miss, with no disk
// read and no manifest probe behind it. Without it an unresolved import in a
// stdin-fed program falls through to `res_read("", …)`, which reads a
// CWD-RELATIVE path, and then to try_manifest, which opens `fern.toml` and can
// reach the user's package cache. For a playground that is not a fallback, it
// is an escape.
//
// `files` is the other half of native's override map: the editor's unsaved
// buffers, keyed by FILE path and read in place of those files wherever the
// disk resolution below reaches.
pub struct Overlay { paths: string[], srcs: string[], sealed: boolean, files: Buffers }

// no_overlay is the "resolve from disk exactly as before" value. Every caller
// that has a real filesystem passes it, and it costs one `len()` per import:
// util.index_of_str returns -1 on an empty array without entering its loop,
// and `sealed` is false, so control reaches res_read with the same arguments
// it had before this existed.
pub function no_overlay(): Overlay {
  return Overlay { paths: [], srcs: [], sealed: false, files: no_buffers() };
}

// resolve_module finds the source for import `path`, written against `dir`
// (the stdlib root for a `std/` or `core/` import). The overlay comes first,
// then `<dir><path>.fern`, then the manifest's declared dependencies.
//
// The overlay is keyed by the path as WRITTEN, which is why it is consulted
// here rather than inside res_read: by then the path has already been split
// two ways, and load_lib calls res_read with a stem of its own. Native draws
// the line in the same place — `stdlib.ModuleKey(importPath)` runs before any
// path join.
//
// An overlay module has no directory of its own. Stdlib modules import each
// other package-root-relative (`import "std/string"`, never `./string`), so
// those re-enter the overlay wherever they are written.
pub function resolve_module(ov: Overlay, dir: string, path: string): Resolved {
  let oi: i32 = util.index_of_str(ov.paths, rel_path(path));
  if (oi >= 0) {
    return Resolved { ...res_none(), src: ov.srcs[oi], ok: true, shown: "stdlib://" + rel_path(path) + ".fern" };
  }
  if (ov.sealed) {
    return Resolved { ...res_none(), err_path: "stdlib://" + rel_path(path) + ".fern" };
  }
  let direct: Resolved = res_read(ov, dir, rel_path(path));
  if (direct.ok || direct.err.len() > 0) {
    return direct;
  }
  let man: Resolved = try_manifest(ov, dir, path);
  if (man.ok || man.err.len() > 0) {
    return man;
  }
  // Not found anywhere: `err_path` names the first candidate.
  return direct;
}

// try_manifest resolves a bare import of a DECLARED dependency from the
// manifest governing `from` (manifest_dir): the import's first segment names
// the dependency, and the rest is a module inside it — `helper` is the
// package's lib module, `helper/extra` its `extra.fern`. The forms are path,
// workspace member, lock, vendor tree and the content-addressed store. Not-ok
// for a stdlib or relative import, which never names a dependency, and when
// there is no manifest, the segment is not a declared dep, or its form is not
// disk-resolvable.
pub function try_manifest(ov: Overlay, from: string, path: string): Resolved {
  if (util.is_stdlib_path(path) || util.is_local(path)) {
    return res_none();
  }
  let dir: string = manifest_dir(from);
  match (read_file(dir + "fern.toml")) {
    Ok(src) => {
      match (dep_dir(fern_toml.parse(src), dir, util.dep_name(path))) {
        Some(dd) => {
          // A url dependency's directory is in the store, which only
          // `fern -fetch` fills: say so rather than fall through to a
          // relative path that was never meant.
          if (!util.is_dir(dd) && util.str_has_prefix(dd, store_root() + "/")) {
            return Resolved { ...res_none(), err: "dependency \"" + util.dep_name(path) + "\" is not in the package store — run `fern -fetch " + dir + "fern.toml` to download and verify it", err_path: dd };
          }
          let rest: string = util.dep_subpath(path);
          if (rest.len() == 0) {
            return load_lib(ov, dd);
          }
          return res_read(ov, dd, rest);
        },
        None => {}
      }
    },
    Err(e) => {}
  }
  return res_none();
}

// dep_dir is the package directory of the dependency `name` that manifest `m`
// (read from `dir`) declares, slash-terminated, or None when it declares no
// such dependency or its form is not disk-resolvable.
function dep_dir(m: fern_toml.Manifest, dir: string, name: string): Option[string] {
  let kind: string = fern_toml.dep_kind(m, name);
  if (kind.len() == 0) {
    return None;
  }
  // Vendored mode: a declared dep resolves from <vendor-root>/vendor/<name>/
  // when that tree exists — offline, form-agnostic, taking precedence (mirrors
  // the native vendored-mode rule).
  match (vendor_dir(dir, name)) {
    Some(vd) => {
      return Some(vd);
    },
    None => {}
  }
  if (kind == "path") {
    match (fern_toml.dep_path(m, name)) {
      Some(dp) => {
        return Some(dir + dp + "/");
      },
      None => {}
    }
  } else if (kind == "workspace") {
    return workspace_member_dir(dir, name);
  } else if (kind == "version") {
    return locked_dir(dir, name);
  } else if (kind == "url") {
    // url+hash dep (#4949): the content-addressed store, by the manifest's
    // declared hash. Read-only — `fern -fetch` populates and sha256-verifies
    // it; the loader trusts it as the native loader does at build time.
    match (fern_toml.dep_hash(m, name)) {
      Some(h) => {
        return store_dir(h);
      },
      None => {}
    }
  }
  return None;
}

// dependency_dir is the loader's declared-dependency identity, shared with
// package grant attenuation so path, workspace, lock, store and vendor
// resolution cannot disagree about the package a grant governs.
pub function dependency_dir(m: fern_toml.Manifest, dir: string, name: string): Option[string] {
  return dep_dir(m, dir, name);
}

// manifest_dir is the nearest directory at or above `dir` holding a fern.toml,
// as native's manifest.FindForDir walks, or `dir` itself when none does.
pub function manifest_dir(dir: string): string {
  match (find_manifest(dir)) {
    Some(d) => {
      return d;
    },
    None => {
      return dir;
    }
  }
  return dir;
}

// find_manifest is the nearest directory at or above `dir` holding a fern.toml,
// or None when none does.
pub function find_manifest(dir: string): Option[string] {
  let d: string = dir;
  let steps: i32 = 0;
  while (steps < 64) {
    match (read_file(d + "fern.toml")) {
      Ok(src) => {
        return Some(d);
      },
      Err(e) => {}
    }
    match (up_dir(d)) {
      Some(u) => {
        d = u;
      },
      None => {
        return None;
      }
    }
    steps = steps + 1;
  }
  return None;
}

// load_lib reads a dependency directory's own fern.toml for its `lib`
// module (default lib.fern) and loads that file.
function load_lib(ov: Overlay, depdir: string): Resolved {
  let deplib: string = "lib.fern";
  match (read_file(depdir + "fern.toml")) {
    Ok(src) => {
      deplib = fern_toml.parse(src).lib;
    },
    Err(e) => {}
  }
  return res_read(ov, depdir, util.without_fern_ext(deplib));
}

// up_dir is the directory above `dir` (both end in '/', "" naming the working
// directory), or None at the filesystem root. Past a relative path's own
// segments it climbs on through `../`, so a walk from a relative path reaches
// the ancestors the same walk from its absolute path does.
pub function up_dir(dir: string): Option[string] {
  if (dir == "/") {
    return None;
  }
  let up: string = util.clean_path(dir + "..");
  if (up == "/") {
    return Some(up);
  }
  if (up == ".") {
    return Some("");
  }
  up = up + "/";
  if (util.str_has_prefix(up, "../") && same_dir(dir, up)) {
    return None;
  }
  return Some(up);
}

// same_dir is true when directories `a` and `b` are one directory, or either
// cannot be read: above the root, `../` names the root again.
function same_dir(a: string, b: string): boolean {
  match (stat(a + ".")) {
    Ok(sa) => {
      match (stat(b + ".")) {
        Ok(sb) => {
          return sa.dev == sb.dev && sa.ino == sb.ino;
        },
        Err(e) => {}
      }
    },
    Err(e) => {}
  }
  return true;
}

// vendor_dir is `<vendor-root>/vendor/<name>/` when such a tree governs `dir`
// — either dir's own vendor/ or an ancestor's (a workspace member sharing the
// root vendor/). Walks up reading each level.
function vendor_dir(dir: string, name: string): Option[string] {
  let d: string = dir;
  let steps: i32 = 0;
  while (steps < 64) {
    if (util.is_dir(d + "vendor/" + name)) {
      return Some(d + "vendor/" + name + "/");
    }
    match (up_dir(d)) {
      Some(u) => {
        d = u;
      },
      None => {
        return None;
      }
    }
    steps = steps + 1;
  }
  return None;
}

// workspace_member_dir finds the enclosing [workspace] root (the nearest
// ancestor fern.toml with a members list) and returns the directory of the
// member whose package name == `name`.
function workspace_member_dir(dir: string, name: string): Option[string] {
  let d: string = dir;
  let steps: i32 = 0;
  while (steps < 64) {
    match (read_file(d + "fern.toml")) {
      Ok(src) => {
        let wm: fern_toml.Manifest = fern_toml.parse(src);
        if (wm.members.len() > 0) {
          let mi: i32 = 0;
          while (mi < wm.members.len()) {
            let memdir: string = d + wm.members[mi] + "/";
            if (member_name(memdir) == name) {
              return Some(memdir);
            }
            mi = mi + 1;
          }
          return None;  // workspace found, no such member
        }
      },
      Err(e) => {}
    }
    match (up_dir(d)) {
      Some(u) => {
        d = u;
      },
      None => {
        return None;
      }
    }
    steps = steps + 1;
  }
  return None;
}

// member_name returns a package directory's declared [package] name, or ""
// when it has no readable manifest.
function member_name(memdir: string): string {
  match (read_file(memdir + "fern.toml")) {
    Ok(src) => {
      return fern_toml.parse(src).name;
    },
    Err(e) => {
      return "";
    }
  }
  return "";
}

// locked_dir resolves a versioned dep `name` through `<dir>fern.lock` to the
// pinned version's directory when its source is a local `path`. A url-sourced
// lock entry resolves through the store.
function locked_dir(dir: string, name: string): Option[string] {
  match (read_file(dir + "fern.lock")) {
    Ok(src) => {
      let lr: fern_toml.LockResult = fern_toml.parse_lock(src);
      if (lr.err.len() > 0) {
        return None;
      }
      let entries: fern_toml.LockEntry[] = lr.entries;
      match (fern_toml.lock_path_of(entries, name)) {
        Some(p) => {
          return Some(p + "/");
        },
        None => {}
      }
      // url-sourced lock entry (#4949): the pinned source lives in
      // the content-addressed store, keyed by the lock's hash.
      match (fern_toml.lock_hash_of(entries, name)) {
        Some(h) => {
          return store_dir(h);
        },
        None => {}
      }
    },
    Err(e) => {}
  }
  return None;
}

// store_root is the per-machine content-addressed store of url dependencies,
// one directory per archive named by its sha256, or "" when there is no
// cache directory. `fern -fetch` populates it, sha256-verified; a build only
// reads it (#4949 — no build-time network).
pub function store_root(): string {
  let base: string = util.cache_base();
  if (base.len() == 0) {
    return "";
  }
  return base + "/pkgs";
}

// store_dir is a url/hash dependency's directory in the store, with a
// trailing `/`, present or not. The hash is re-validated here even though
// every parse boundary already does: the hex is joined onto the store root,
// so a later route reaching this unchecked would be a directory traversal
// (#8464).
pub function store_dir(hash: string): Option[string] {
  let hr: fern_toml.HashResult = fern_toml.validate_hash(hash);
  let root: string = store_root();
  if (hr.err.len() > 0 || root.len() == 0) {
    return None;
  }
  return Some(root + "/" + hr.hex + "/");
}

// unresolved_import is the diagnostic for an import that resolves to no
// module file: the import as written, the file that wrote it, and the first
// candidate looked for with why it failed ("" means it is not there).
pub function unresolved_import(path: string, importer: string, tried: string, reason: string): string {
  if (reason.len() == 0) {
    reason = "not found";
  }
  return "cannot resolve import \"" + path + "\" in " + importer + ": " + tried + ": " + reason;
}

// unknown_stdlib_module is the message for a `std/` or `core/` import that
// names no module of the stdlib that was given.
pub function unknown_stdlib_module(path: string): string {
  return "unknown stdlib module \"" + path + "\"";
}

// report_unresolved prints each of `missing` (unresolved_import lines) under
// `driver`'s name and reports whether there were any.
pub function report_unresolved(missing: string[], driver: string): boolean {
  for m in missing {
    eprint(driver + ": " + m);
  }
  return missing.len() > 0;
}

// stdlib_not_given is true for a `std/` or `core/` import made where no stdlib
// was given: the overlay carries no modules, and the import's tree (`std/` or
// `core/`) is not a directory under `dir`. Such an import is expected to
// resolve to nothing — a driver run without a vendored stdlib, on a program
// that imports `core/map` and uses the builtin Map — so it is skipped, not
// reported. A call into it still dangles, and the call gate reports that.
function stdlib_not_given(ov: Overlay, dir: string, path: string): boolean {
  if (overlay_gives_stdlib(ov) || !util.is_stdlib_path(path)) {
    return false;
  }
  let tree: string = "core";
  if (util.str_has_prefix(path, "std/")) {
    tree = "std";
  }
  return !util.is_dir(dir + tree);
}

// Graph is a program's import closure as load_graph reads it. `entry` is the
// entry module with each import's resolved identity recorded, as every loaded
// module's are, so flatten prefixes a reference the same wherever it is
// written. `files` is each loaded module's display path in load order — the
// table util.pos_str reads a diagnostic's file from, since each module is
// tokenized from its own util.line_base. `missing` holds a line for each
// import that resolved to no file — unknown_stdlib_module at the import for a
// stdlib one, unresolved_import for any other — except those stdlib_not_given
// expects to be absent; the driver reports them with report_unresolved and
// fails.
pub struct Graph { entry: parser.Module, loaded: flatten.LoadedModule[], files: string[], missing: string[] }

// import_base is the directory an import written in a file under `dir`
// resolves against: the stdlib root for `std/` and `core/`, else `dir`.
// Both end in '/' or are empty.
function import_base(path: string, dir: string, root: string): string {
  if (util.is_stdlib_path(path)) {
    return root;
  }
  return dir;
}

// import_key names the module an import written in a file under `dir` refers
// to, before it is read: the overlay key for an overlay hit, else the cleaned
// path it resolves to, without `.fern`. Two spellings of one file share a key.
function import_key(ov: Overlay, path: string, dir: string, root: string): string {
  if (util.index_of_str(ov.paths, rel_path(path)) >= 0) {
    return "stdlib://" + rel_path(path);
  }
  return util.clean_path(import_base(path, dir, root) + rel_path(path));
}

// resolved_ident is the identity of the module `r` read: the file, cleaned and
// without `.fern`, or the overlay key.
function resolved_ident(r: Resolved): string {
  if (util.str_has_prefix(r.shown, "stdlib://")) {
    return flatten.module_ident(r.shown);
  }
  return flatten.module_ident(util.clean_path(r.shown));
}

// stamp_imports records on each of `mod`'s imports the identity load_graph
// resolved it to, "" for one that resolved to nothing.
function stamp_imports(ov: Overlay, mod: parser.Module, dir: string, root: string, keys: string[], idents: string[]): parser.Module {
  let out: parser.Import[] = [];
  for imp in mod.imports {
    let k: i32 = util.index_of_str(keys, import_key(ov, imp.path, dir, root));
    let r: string = "";
    if (k >= 0) {
      r = idents[k];
    }
    out = out.append(parser.Import { ...imp, resolved: r });
  }
  return parser.Module { ...mod, imports: out };
}

// overlay_gives_stdlib is true when `std/` and `core/` come from the overlay,
// so the stdlib is never looked for on disk. A sealed overlay is the whole
// filesystem: in the browser playground a disk probe is a trap, not a miss.
function overlay_gives_stdlib(ov: Overlay): boolean {
  return ov.sealed || ov.paths.len() > 0;
}

// vendored_stdlib_dir is the nearest directory at or above `dir` holding a
// `std/` or `core/` tree, or `dir` itself when none does or the overlay gives
// the stdlib: a driver's project vendors the stdlib at its root, and the driver
// may sit in a sub-directory.
function vendored_stdlib_dir(ov: Overlay, dir: string): string {
  if (overlay_gives_stdlib(ov)) {
    return dir;
  }
  let d: string = dir;
  let steps: i32 = 0;
  while (steps < 64) {
    if (util.is_dir(d + "std") || util.is_dir(d + "core")) {
      return d;
    }
    match (up_dir(d)) {
      Some(u) => {
        d = u;
      },
      None => {
        return dir;
      }
    }
    steps = steps + 1;
  }
  return dir;
}

// missing_line is load_graph's report of import `imp`, written in `importer`
// and resolved against `base`, that read as `r` rather than as a module, or ""
// when stdlib_not_given expects it to be absent. A stdlib module that is not
// there is reported at the import, as util.pos_str places it among `files`.
function missing_line(ov: Overlay, imp: parser.Import, base: string, importer: string, r: Resolved, entry_path: string, files: string[]): string {
  if (r.err.len() > 0 || !util.is_stdlib_path(imp.path)) {
    return unresolved_import(imp.path, importer, r.err_path, r.err);
  }
  if (stdlib_not_given(ov, base, imp.path)) {
    return "";
  }
  return util.pos_str(entry_path, files, imp.line, imp.col) + ": error: " + unknown_stdlib_module(imp.path);
}

// load_graph walks the entry module's import graph breadth-first, reading and
// parsing each module once. `root` is the stdlib root `std/` and `core/`
// resolve under; empty means the driver's vendored stdlib
// (vendored_stdlib_dir). A module found through a manifest is read from its
// package, and its own imports still resolve beside it.
pub function load_graph(ov: Overlay, entry_path: string, entry: parser.Module, root: string): Graph {
  let edir: string = dirname(entry_path);
  let sroot: string = root;
  if (sroot.len() == 0) {
    sroot = vendored_stdlib_dir(ov, edir);
  } else if (sroot[sroot.len() - 1] != b'/') {
    sroot = sroot + "/";
  }
  let loaded: flatten.LoadedModule[] = [];
  let loaded_ids: string[] = [];
  let mod_dirs: string[] = [];
  let files: string[] = [];
  let missing: string[] = [];
  // keys[i] is an import key already looked up, idents[i] what it resolved to.
  let keys: string[] = [];
  let idents: string[] = [];
  let imps: parser.Import[] = [];
  let dirs: string[] = [];
  let importers: string[] = [];
  for imp in entry.imports {
    imps = imps.append(imp);
    dirs = dirs.append(edir);
    importers = importers.append(entry_path);
  }
  let qi: i32 = 0;
  while (qi < imps.len()) {
    let imp: parser.Import = imps[qi];
    let path: string = imp.path;
    let dir: string = dirs[qi];
    let importer: string = importers[qi];
    qi = qi + 1;
    let key: string = import_key(ov, path, dir, sroot);
    if (util.has_str(keys, key)) {
      continue;
    }
    keys = keys.append(key);
    let base: string = import_base(path, dir, sroot);
    let r: Resolved = resolve_module(ov, base, path);
    if (!r.ok) {
      idents = idents.append("");
      let line: string = missing_line(ov, imp, base, importer, r, entry_path, files);
      if (line.len() > 0) {
        missing = missing.append(line);
      }
      continue;
    }
    let ident: string = resolved_ident(r);
    idents = idents.append(ident);
    // A fallback can reach a file another spelling already loaded.
    if (util.has_str(loaded_ids, ident)) {
      continue;
    }
    // A module found through the manifest is not the standard library.
    let origin: string = "";
    if (r.shown == "stdlib://" + rel_path(path) + ".fern" || r.shown == base + rel_path(path) + ".fern") {
      origin = path;
    }
    let m: parser.Module = parser.with_stdlib_origin(parser.parse_module(lexer.tokenize_from(r.src, util.line_base(files.len()) + 1)), origin);
    // An overlay module has no directory of its own; its imports are all
    // stdlib paths, which resolve under the root wherever they are written.
    let mdir: string = dir;
    if (!util.str_has_prefix(r.shown, "stdlib://")) {
      mdir = dirname(util.clean_path(r.shown));
    }
    files = files.append(r.shown);
    loaded = loaded.append(flatten.LoadedModule { name: base_name(path), ident: ident, mod: m });
    loaded_ids = loaded_ids.append(ident);
    mod_dirs = mod_dirs.append(mdir);
    for mi in m.imports {
      imps = imps.append(mi);
      dirs = dirs.append(mdir);
      importers = importers.append(r.shown);
    }
  }
  let stamped: flatten.LoadedModule[] = [];
  let i: i32 = 0;
  while (i < loaded.len()) {
    stamped = stamped.append(flatten.LoadedModule { ...loaded[i], mod: stamp_imports(ov, loaded[i].mod, mod_dirs[i], sroot, keys, idents) });
    i = i + 1;
  }
  return Graph { entry: stamp_imports(ov, entry, edir, sroot, keys, idents), loaded: stamped, files: files, missing: missing };
}

// merge_builtins reads `<dir>builtins.fern` (the real built-in-type
// module) and appends its struct + enum decls to `merged`, unmangled, so
// the program's references to IoError / FileStat / … resolve.
// When the file is absent the program is returned unchanged and
// module_with_builtins' idempotent synthetic injection fills the types in.
// fern.fern never calls this: the compiler's IoError layout is the injection's.
//
// Deliberately NOT overlay-aware, unlike its neighbours: builtins.fern lives
// beside the compiler sources, not under a package root, so it is not a module
// any import names and there is no import path to key it by. A caller with no
// filesystem — a wasm-hosted driver — skips this and lets module_with_builtins
// inject, which is what checker_modload_run already does.
pub function merge_builtins(dir: string, merged: parser.Module): parser.Module {
  match (read_file(dir + "builtins.fern")) {
    Ok(bsrc) => {
      let bmod: parser.Module = parser.parse_module(lexer.tokenize(bsrc));
      return parser.Module {
        funcs: merged.funcs,
        structs: util.append_all(merged.structs, bmod.structs),
        aliases: merged.aliases,
        imports: merged.imports,
        top_stmts: merged.top_stmts,
        enums: util.append_all(merged.enums, bmod.enums),
        resources: merged.resources,
        exports: merged.exports,
        impls: merged.impls,
        trait_reqs: merged.trait_reqs, trait_decls: merged.trait_decls, inferred_consts: merged.inferred_consts, todo_sites: merged.todo_sites, sights: merged.sights,
      };
    },
    Err(e) => {
      return merged;
    }
  }
  return merged;
}

// ---- incremental-codegen cache keys (#3451 step 6 / #3458, #5331) -----------
// Shared by every per-module driver (asm_modload_run, wasm_modload_run): the
// fingerprints an out-of-process build orchestrator uses to decide which modules
// must be re-emitted and which can be served from an object cache.
//
// These live here rather than in one driver because the RULE they encode is
// subtle and must not drift between backends: a module's key is its own source
// hash folded with the SIGNATURE hash of every module it depends on. src_hash
// makes a body-only edit re-emit that module (its own codegen changed); sig_hash
// makes a signature edit re-emit that module AND its dependents (their call-site
// tagging changed) — while a body-only edit to a dependency leaves dependents
// untouched, since their sig_hash input is unchanged. That asymmetry is the whole
// basis of correct invalidation; keying on source alone would ship stale codegen
// when a depended-on return type changes.
//
// "Depends on" is the TRANSITIVE import closure, not the direct edges. A unit is
// lowered under the whole-program function and struct view, so a module reaches
// declarations it never imported: `main` importing only `mid` can read a field of
// a struct `leaf` declares (field OFFSETS come from leaf) and can call a receiver
// method leaf declares on it (call-site tagging comes from leaf's signature).
// Neither shows up in mid's own signature — `get(): Thing` is unchanged when
// Thing's field list moves — so a direct-edge key leaves main stale.
//
// The closure is a sound over-approximation, not a precise dependency set: a
// signature change low in the graph invalidates everything above it, whether or
// not those units name anything that moved. Narrowing it means computing the
// declarations each unit actually references; correctness comes first.

pub function module_sig_string(mod: parser.Module): string {
  let out: string = "";
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let f: parser.FuncDecl = mod.funcs[fi];
    out = out + "fn " + f.receiver_type + "." + f.name + "(";
    let pi: i32 = 0;
    while (pi < f.params.len()) {
      out = out + f.params[pi].type_name + ",";
      pi = pi + 1;
    }
    out = out + ")" + f.ret_type + ";";
    fi = fi + 1;
  }
  let si: i32 = 0;
  while (si < mod.structs.len()) {
    let sd: parser.StructDecl = mod.structs[si];
    out = out + "st " + sd.name + "{";
    let di: i32 = 0;
    while (di < sd.fields.len()) {
      out = out + sd.fields[di].name + ":" + sd.fields[di].type_name + ",";
      di = di + 1;
    }
    out = out + "}";
    si = si + 1;
  }
  return out;
}

// module_dep_ns joins (comma-separated, in parts order) the namespaces module
// `idx` depends on — the dependency list the incremental cache keys it against.
// A key folds in the SIGNATURE hash of each name here, so a signature change in
// anything it depends on invalidates it.
//
// This is the TRANSITIVE closure, and it is what the manifest reports for a
// reason: the manifest exists so an out-of-process orchestrator can compute the
// keys the driver computes. Reporting direct edges instead would hand it a
// weaker rule than the driver's, so it would reuse a unit the driver would have
// re-emitted — the same stale codegen, one layer out. Only loaded modules are
// listed; an import that resolved to no part contributes no signature.
pub function module_dep_ns(parts: flatten.PerModule[], infmods: parser.Module[], idx: i32): string {
  let deps: string[] = import_closure_ns(parts, infmods, idx);
  let out: string = "";
  let j: i32 = 0;
  while (j < parts.len()) {
    if (util.has_str(deps, parts[j].ns)) {
      if (out.len() > 0) {
        out = out + ",";
      }
      out = out + parts[j].ns;
    }
    j = j + 1;
  }
  return out;
}

// module_src reads module `idx`'s own source: the entry from entry_path, an
// overlay module from the overlay, any other from the file its identity names.
pub function module_src(ov: Overlay, entry_path: string, parts: flatten.PerModule[], idx: i32): Option[string] {
  let path: string = entry_path;
  if (!parts[idx].is_entry) {
    let id: string = parts[idx].ident;
    if (util.str_has_prefix(id, "stdlib://")) {
      let k: i32 = util.index_of_str(ov.paths, slice_unchecked(id, 9, id.len()) + "");
      if (k < 0) {
        return None;
      }
      return Some(ov.srcs[k]);
    }
    path = id + ".fern";
  }
  match (read_file(path)) {
    Ok(src) => {
      return Some(src);
    },
    Err(e) => {
      return None;
    }
  }
  return None;
}

// module_src_hash fingerprints a module's own source, or is "?" when it cannot
// be read, which callers MUST treat as always-rebuild: sound (never reuses
// stale codegen), just not incremental for that module.
pub function module_src_hash(ov: Overlay, entry_path: string, parts: flatten.PerModule[], idx: i32): string {
  match (module_src(ov, entry_path, parts, idx)) {
    Some(src) => {
      return util.hash_key(src);
    },
    None => {
      return "?";
    }
  }
  return "?";
}

// import_part_ns is the ns of the part `imp` resolved to, or "" when it names
// no loaded part. An import with no recorded identity is matched by the prefix
// its basename would get.
function import_part_ns(parts: flatten.PerModule[], imp: parser.Import): string {
  let k: i32 = 0;
  while (k < parts.len()) {
    if (imp.resolved.len() > 0) {
      if (parts[k].ident == imp.resolved) {
        return parts[k].ns;
      }
    } else if (!parts[k].is_entry && parts[k].ns == util.mangle_prefix(base_name(imp.path))) {
      return parts[k].ns;
    }
    k = k + 1;
  }
  return "";
}

// import_closure_ns returns the namespaces module `idx` depends on transitively
// — the dependency set the cache key folds signatures over (see the section
// header for why direct edges are not enough). An import that resolved to no
// loaded part contributes nothing.
//
// A fixed point over `parts` rather than a worklist: the module count is small
// (tens), and re-scanning is what makes an import CYCLE terminate instead of
// revisiting forever.
pub function import_closure_ns(parts: flatten.PerModule[], infmods: parser.Module[], idx: i32): string[] {
  let seen: string[] = [];
  let grew: boolean = true;
  while (grew) {
    grew = false;
    let j: i32 = 0;
    while (j < parts.len()) {
      if (j == idx || util.has_str(seen, parts[j].ns)) {
        for imp in infmods[j].imports {
          let nm: string = import_part_ns(parts, imp);
          if (nm.len() > 0 && !util.has_str(seen, nm)) {
            seen = seen.append(nm);
            grew = true;
          }
        }
      }
      j = j + 1;
    }
  }
  return seen;
}

// FactHashes splits the typed lowering's contract rows (ircore.unit_keys) by
// module. per_mod[j] hashes every row that names one of module j's functions;
// global hashes the rows that name none. A row naming functions of several
// modules lands in each, and a function name that also appears in an unrelated
// row only over-attributes it, so an edit can re-emit too much but never too
// little.
pub struct FactHashes { per_mod: string[], global: string }

function ident_tokens(s: string): string[] {
  let out: string[] = [];
  let start: i32 = 0 - 1;
  let i: i32 = 0;
  while (i <= s.len()) {
    let word: boolean = false;
    if (i < s.len()) {
      let c: i32 = s[i] as i32;
      word = c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 95;
    }
    if (word && start < 0) {
      start = i;
    }
    if (!word && start >= 0) {
      out = out.append(slice_unchecked(s, start, i) + "");
      start = 0 - 1;
    }
    i = i + 1;
  }
  return out;
}

// roll131 is hash_key's second polynomial roll, kept numeric so it can be summed.
function roll131(s: string): i32 {
  let b: i32 = 5381;
  let i: i32 = 0;
  while (i < s.len()) {
    b = b * 131 + s[i] as i32 + 7 & 1073741823;
    i = i + 1;
  }
  return b * 131 + s.len() & 1073741823;
}

pub function module_fact_hashes(infmods: parser.Module[], rows: string[]): FactHashes {
  let names: string[][] = [];
  for m in infmods {
    let ns: string[] = [];
    for f in m.funcs {
      ns = ns.append(f.name);
    }
    names = names.append(ns);
  }
  // Bucket infmods.len() is the global one. A registry can list a row more than
  // once, and in an order that depends on its bucket layout, so each bucket
  // folds its DISTINCT rows with an order-independent sum.
  let nb: i32 = infmods.len() + 1;
  let sa: i32[] = [];
  let sb: i32[] = [];
  let bi: i32 = 0;
  while (bi < nb) {
    sa = sa.append(0);
    sb = sb.append(0);
    bi = bi + 1;
  }
  let seen: Map[string, i32] = map_new(rows.len() + 1);
  for row in rows {
    let toks: string[] = ident_tokens(row);
    let owners: i32[] = [];
    let j: i32 = 0;
    while (j < names.len()) {
      let owned: boolean = false;
      for t in toks {
        if (util.has_str(names[j], t)) {
          owned = true;
        }
      }
      if (owned) {
        owners = owners.append(j);
      }
      j = j + 1;
    }
    if (owners.len() == 0) {
      owners = [infmods.len()];
    }
    for o in owners {
      let k: string = util.i32_to_string(o) + "|" + row;
      if (seen.get_or(k, 0) == 0) {
        seen = seen.insert(k, 1);
        sa = sa.with(o, sa[o] + util.hash_bucket(row, 1073741823) & 1073741823);
        sb = sb.with(o, sb[o] + roll131(row) & 1073741823);
      }
    }
  }
  let per: string[] = [];
  let pj: i32 = 0;
  while (pj < infmods.len()) {
    per = per.append(util.i32_to_string(sa[pj]) + "_" + util.i32_to_string(sb[pj]));
    pj = pj + 1;
  }
  return FactHashes { per_mod: per, global: util.i32_to_string(sa[infmods.len()]) + "_" + util.i32_to_string(sb[infmods.len()]) };
}

// fact_sig_hashes is each module's signature hash with its facts folded in, so a
// dependent's key moves when a fact about a function it can call moves, the way
// it does for that function's signature.
pub function fact_sig_hashes(infmods: parser.Module[], fh: FactHashes): string[] {
  let out: string[] = [];
  let j: i32 = 0;
  while (j < infmods.len()) {
    out = out.append(util.hash_key(module_sig_string(infmods[j]) + "|f" + fh.per_mod[j]));
    j = j + 1;
  }
  return out;
}

// module_cache_key builds the content-addressed key for module `idx`: its own
// src_hash, folded with the SIGNATURE hash of every module it depends on
// transitively (walked in parts order, so the key is deterministic without a
// sort). The entry also folds in the runtime-need set it was asked to emit
// (pm_extra), since that set is part of the entry unit's codegen inputs. `ns` is
// included so two modules with byte-identical source but different namespaces
// (hence different mangled output) never share a key. Returns "" when src_hash is
// "?" — the signal to skip the cache and always emit.
pub function module_cache_key(parts: flatten.PerModule[], infmods: parser.Module[], sighashes: string[], idx: i32, src_hash: string, extra: string[]): string {
  if (src_hash == "?") {
    return "";
  }
  let key: string = parts[idx].ns + "|" + src_hash;
  let deps: string[] = import_closure_ns(parts, infmods, idx);
  let j: i32 = 0;
  while (j < parts.len()) {
    if (util.has_str(deps, parts[j].ns)) {
      key = key + "#" + sighashes[j];
    }
    j = j + 1;
  }
  if (parts[idx].is_entry) {
    let ex: string = "";
    let ei: i32 = 0;
    while (ei < extra.len()) {
      ex = ex + extra[ei] + ",";
      ei = ei + 1;
    }
    key = key + "@" + util.hash_key(ex);
  }
  return key;
}

// module_unit_cache_key is module_cache_key for ONE emitted unit: the same key
// with the function window [lo,hi) folded in, so two shards of a module never
// share an entry. `hi < 0` means "to the end", which is how a whole-module emit
// spells its window; a caller that knows the module's function count must
// normalise a full window to -1 or the same bytes get two keys.
//
// Every driver goes through this rather than appending the window itself: the
// window is part of what the cached bytes ARE, so a driver that forgot it would
// serve one shard's asm for another. `sighashes` must come from fact_sig_hashes
// and `fh` from module_fact_hashes: lowering reads facts derived from function
// bodies, the module's own and the global ones included, which neither its
// source nor its dependencies' signatures cover.
pub function module_unit_cache_key(parts: flatten.PerModule[], infmods: parser.Module[], sighashes: string[], idx: i32, src_hash: string, extra: string[], lo: i32, hi: i32, fh: FactHashes): string {
  let key: string = module_cache_key(parts, infmods, sighashes, idx, src_hash, extra);
  if (key.len() == 0) {
    return "";
  }
  return key + "|r" + util.i32_to_string(lo) + ":" + util.i32_to_string(hi) + "|f" + fh.global + ":" + fh.per_mod[idx];
}
