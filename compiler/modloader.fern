import "./lexer";
import "./parser";
import "./flatten";
import "./fern_toml";
import "./literate";
import "./util";
import "core/map";
import "std/error";

pub function dirname(path: string): string {
  let cut: i32 = 0;
  let i: i32 = 0;
  while (i < path.len()) {
    if (path[i] == b'/') {
      cut = i + 1;
    }
    i = i + 1;
  }
  return slice_unchecked(path, 0, cut) + "";
}

pub function base_name(path: string): string {
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < path.len()) {
    if (path[i] == b'/') {
      start = i + 1;
    }
    i = i + 1;
  }
  return slice_unchecked(path, start, path.len()) + "";
}

function rel_path(path: string): string {
  if (path.len() >= 2 && slice_unchecked(path, 0, 2) == "./") {
    return util.without_fern_ext(slice_unchecked(path, 2, path.len()) + "");
  }
  return util.without_fern_ext(path);
}

function unreadable(e: IoError): boolean {
  if let NotFound(_) = e {
    return false;
  }
  return true;
}

pub struct Resolved { src: string, ok: boolean, err: string, err_path: string, shown: string, map: util.LineMap }

function res_none(): Resolved {
  return Resolved { src: "", ok: false, err: "", err_path: "", shown: "", map: util.no_line_map() };
}

function res_read(ov: Overlay, dir: string, rel: string): Resolved {
  return read_module(ov.files, dir + util.without_fern_ext(rel) + ".fern");
}

pub struct Buffers { paths: string[], srcs: string[] }

pub function no_buffers(): Buffers {
  return Buffers { paths: [], srcs: [] };
}

function read_text(bufs: Buffers, path: string): Result[string, IoError] {
  let i: i32 = util.index_of_str(bufs.paths, util.clean_path(path));
  if (i >= 0) {
    return Ok(bufs.srcs[i]);
  }
  return read_file(path);
}

pub function read_module(bufs: Buffers, path: string): Resolved {
  let plain: i32 = util.index_of_str(bufs.paths, util.clean_path(path));
  if (plain >= 0) {
    return Resolved { ...res_none(), src: bufs.srcs[plain], ok: true, shown: path };
  }
  let document: i32 = util.index_of_str(bufs.paths, util.clean_path(path + ".md"));
  if (document >= 0) {
    return tangle_module(path, path + ".md", bufs.srcs[document]);
  }
  match (read_text(bufs, path)) {
    Ok(s) => {
      return Resolved { ...res_none(), src: s, ok: true, shown: path };
    },
    Err(e) => {
      if (unreadable(e)) {
        return Resolved { ...res_none(), err: e.message(), err_path: path };
      }
    }
  }
  let doc: string = path + ".md";
  match (read_text(bufs, doc)) {
    Ok(s) => {
      return tangle_module(path, doc, s);
    },
    Err(e) => {
      if (unreadable(e)) {
        return Resolved { ...res_none(), err: e.message(), err_path: doc };
      }
    }
  }
  return Resolved { ...res_none(), err_path: path };
}

function tangle_module(path: string, doc: string, src: string): Resolved {
  if (literate.parse_file_pieces(src).len() > 0) {
    return Resolved { ...res_none(), err: "a multi-file literate document tangles to several modules, not one importable module", err_path: doc };
  }
  match (literate.tangle(src)) {
    literate.TangleOk(o) => {
      return Resolved { ...res_none(), src: o.code, ok: true, shown: path, map: util.LineMap { doc: doc, lits: o.lits, shifts: o.shifts } };
    },
    literate.TangleErr(e) => {
      return Resolved { ...res_none(), err: e.msg, err_path: doc + ":" + util.i32_to_string(e.line) + ":" + util.i32_to_string(e.col) };
    }
  }
  return res_none();
}

pub struct Overlay { paths: string[], srcs: string[], sealed: boolean, files: Buffers }

pub function no_overlay(): Overlay {
  return Overlay { paths: [], srcs: [], sealed: false, files: no_buffers() };
}

pub function embedded_sources(assets: (string, string)[], sealed: boolean): Overlay {
  let paths: string[] = [];
  let srcs: string[] = [];
  let files: Buffers = no_buffers();
  for asset in assets {
    let name: string = asset.0;
    if (!util.is_stdlib_path(name) || !util.str_has_suffix(name, ".fern") && !util.str_has_suffix(name, ".fern.md")) {
      continue;
    }
    let module: string = util.without_fern_ext(name);
    if (!util.has_str(paths, module)) {
      paths = paths.append(module);
      srcs = srcs.append(asset.1);
    }
    files = Buffers { paths: files.paths.append(util.clean_path("stdlib://" + name)), srcs: files.srcs.append(asset.1) };
  }
  return Overlay { paths: paths, srcs: srcs, sealed: sealed, files: files };
}

pub function resolve_module(ov: Overlay, dir: string, path: string): Resolved {
  let oi: i32 = util.index_of_str(ov.paths, rel_path(path));
  if (oi >= 0) {
    let source: string = "stdlib://" + rel_path(path) + ".fern";
    if (util.has_str(ov.files.paths, util.clean_path(source)) || util.has_str(ov.files.paths, util.clean_path(source + ".md"))) {
      return read_module(ov.files, source);
    }
    return Resolved { ...res_none(), src: ov.srcs[oi], ok: true, shown: "stdlib://" + rel_path(path) + ".fern" };
  }
  if (ov.sealed) {
    return Resolved { ...res_none(), err_path: "stdlib://" + rel_path(path) + ".fern" };
  }
  let direct: Resolved = res_read(ov, dir, rel_path(path));
  if (direct.ok || direct.err.len() > 0) {
    return direct;
  }
  let man: Resolved = try_manifest(ov, dir, path);
  if (man.ok || man.err.len() > 0) {
    return man;
  }
  return direct;
}

pub function try_manifest(ov: Overlay, from: string, path: string): Resolved {
  if (util.is_stdlib_path(path) || util.is_local(path)) {
    return res_none();
  }
  let dir: string = manifest_dir(from);
  match (read_file(dir + "fern.toml")) {
    Ok(src) => {
      let m: fern_toml.Manifest = fern_toml.parse(src);
      if (!util.has_str(fern_toml.dep_names(m), util.dep_name(path))) {
        return Resolved { ...res_none(), err: undeclared_dependency(util.dep_name(path), dir + "fern.toml") };
      }
      match (dep_dir(m, dir, util.dep_name(path))) {
        Some(dd) => {
          if (!util.is_dir(dd) && util.str_has_prefix(dd, store_root() + "/")) {
            return Resolved { ...res_none(), err: "dependency \"" + util.dep_name(path) + "\" is not in the package store — run `fern -fetch " + dir + "fern.toml` to download and verify it", err_path: dd };
          }
          let rest: string = util.dep_subpath(path);
          if (rest.len() == 0) {
            return load_lib(ov, dd);
          }
          return res_read(ov, dd, rest);
        },
        None => {}
      }
    },
    Err(e) => {}
  }
  return res_none();
}

function dep_dir(m: fern_toml.Manifest, dir: string, name: string): Option[string] {
  let kind: string = fern_toml.dep_kind(m, name);
  if (kind.len() == 0) {
    return None;
  }
  match (vendor_dir(dir, name)) {
    Some(vd) => {
      return Some(vd);
    },
    None => {}
  }
  if (kind == "path") {
    match (fern_toml.dep_path(m, name)) {
      Some(dp) => {
        return Some(dir + dp + "/");
      },
      None => {}
    }
  } else if (kind == "workspace") {
    return workspace_member_dir(dir, name);
  } else if (kind == "version") {
    return locked_dir(dir, name);
  } else if (kind == "url") {
    match (fern_toml.dep_hash(m, name)) {
      Some(h) => {
        return store_dir(h);
      },
      None => {}
    }
  }
  return None;
}

pub function dependency_dir(m: fern_toml.Manifest, dir: string, name: string): Option[string] {
  return dep_dir(m, dir, name);
}

pub function manifest_dir(dir: string): string {
  match (find_manifest(dir)) {
    Some(d) => {
      return d;
    },
    None => {
      return dir;
    }
  }
  return dir;
}

pub function find_manifest(dir: string): Option[string] {
  let d: string = dir;
  let steps: i32 = 0;
  while (steps < 64) {
    match (read_file(d + "fern.toml")) {
      Ok(src) => {
        return Some(d);
      },
      Err(e) => {}
    }
    match (up_dir(d)) {
      Some(u) => {
        d = u;
      },
      None => {
        return None;
      }
    }
    steps = steps + 1;
  }
  return None;
}

function load_lib(ov: Overlay, depdir: string): Resolved {
  let deplib: string = "lib.fern";
  match (read_file(depdir + "fern.toml")) {
    Ok(src) => {
      deplib = fern_toml.parse(src).lib;
    },
    Err(e) => {}
  }
  return res_read(ov, depdir, util.without_fern_ext(deplib));
}

pub function up_dir(dir: string): Option[string] {
  if (dir == "/") {
    return None;
  }
  let up: string = util.clean_path(dir + "..");
  if (up == "/") {
    return Some(up);
  }
  if (up == ".") {
    return Some("");
  }
  up = up + "/";
  if (util.str_has_prefix(up, "../") && same_dir(dir, up)) {
    return None;
  }
  return Some(up);
}

function same_dir(a: string, b: string): boolean {
  match (stat(a + ".")) {
    Ok(sa) => {
      match (stat(b + ".")) {
        Ok(sb) => {
          return sa.dev == sb.dev && sa.ino == sb.ino;
        },
        Err(e) => {}
      }
    },
    Err(e) => {}
  }
  return true;
}

function vendor_dir(dir: string, name: string): Option[string] {
  let d: string = dir;
  let steps: i32 = 0;
  while (steps < 64) {
    if (util.is_dir(d + "vendor/" + name)) {
      return Some(d + "vendor/" + name + "/");
    }
    match (up_dir(d)) {
      Some(u) => {
        d = u;
      },
      None => {
        return None;
      }
    }
    steps = steps + 1;
  }
  return None;
}

function workspace_member_dir(dir: string, name: string): Option[string] {
  let d: string = dir;
  let steps: i32 = 0;
  while (steps < 64) {
    match (read_file(d + "fern.toml")) {
      Ok(src) => {
        let wm: fern_toml.Manifest = fern_toml.parse(src);
        if (wm.members.len() > 0) {
          let mi: i32 = 0;
          while (mi < wm.members.len()) {
            let memdir: string = d + wm.members[mi] + "/";
            if (member_name(memdir) == name) {
              return Some(memdir);
            }
            mi = mi + 1;
          }
          return None;
        }
      },
      Err(e) => {}
    }
    match (up_dir(d)) {
      Some(u) => {
        d = u;
      },
      None => {
        return None;
      }
    }
    steps = steps + 1;
  }
  return None;
}

function member_name(memdir: string): string {
  match (read_file(memdir + "fern.toml")) {
    Ok(src) => {
      return fern_toml.parse(src).name;
    },
    Err(e) => {
      return "";
    }
  }
  return "";
}

function locked_dir(dir: string, name: string): Option[string] {
  match (read_file(dir + "fern.lock")) {
    Ok(src) => {
      let lr: fern_toml.LockResult = fern_toml.parse_lock(src);
      if (lr.err.len() > 0) {
        return None;
      }
      let entries: fern_toml.LockEntry[] = lr.entries;
      match (fern_toml.lock_path_of(entries, name)) {
        Some(p) => {
          return Some(p + "/");
        },
        None => {}
      }
      match (fern_toml.lock_hash_of(entries, name)) {
        Some(h) => {
          return store_dir(h);
        },
        None => {}
      }
    },
    Err(e) => {}
  }
  return None;
}

pub function store_root(): string {
  let base: string = util.cache_base();
  if (base.len() == 0) {
    return "";
  }
  return base + "/pkgs";
}

pub function store_dir(hash: string): Option[string] {
  let hr: fern_toml.HashResult = fern_toml.validate_hash(hash);
  let root: string = store_root();
  if (hr.err.len() > 0 || root.len() == 0) {
    return None;
  }
  return Some(root + "/" + hr.hex + "/");
}

pub function unresolved_import(path: string, tried: string, reason: string): string {
  if (reason.len() == 0) {
    return "cannot resolve import \"" + path + "\": not found";
  }
  if (tried.len() == 0) {
    return "cannot resolve import \"" + path + "\": " + reason;
  }
  return "cannot resolve import \"" + path + "\": " + tried + ": " + reason;
}

function undeclared_dependency(seg: string, toml: string): string {
  return "not found, and \"" + seg + "\" is not a declared dependency in " + toml + " (add it under [dependencies], e.g. " + seg + " = { path = \"../" + seg + "\" })";
}

pub function import_cycle_message(path: string): string {
  return "import \"" + path + "\" closes an import cycle";
}

pub function unknown_stdlib_module(path: string): string {
  return "unknown stdlib module \"" + path + "\"";
}

pub function report_unresolved(missing: string[], driver: string): boolean {
  for m in missing {
    eprint(driver + ": " + m);
  }
  return missing.len() > 0;
}

function stdlib_not_given(ov: Overlay, dir: string, path: string): boolean {
  if (overlay_gives_stdlib(ov) || !util.is_stdlib_path(path)) {
    return false;
  }
  let tree: string = "core";
  if (util.str_has_prefix(path, "std/")) {
    tree = "std";
  }
  return !util.is_dir(dir + tree);
}

pub struct Graph { entry: parser.Module, loaded: flatten.LoadedModule[], files: string[], missing: string[] }

function import_base(path: string, dir: string, root: string): string {
  if (util.is_stdlib_path(path)) {
    return root;
  }
  return dir;
}

function import_key(ov: Overlay, path: string, dir: string, root: string): string {
  if (util.index_of_str(ov.paths, rel_path(path)) >= 0) {
    return "stdlib://" + rel_path(path);
  }
  return util.clean_path(import_base(path, dir, root) + rel_path(path));
}

function resolved_ident(r: Resolved): string {
  if (util.str_has_prefix(r.shown, "stdlib://")) {
    return flatten.module_ident(r.shown);
  }
  return flatten.module_ident(util.clean_path(r.shown));
}

function stamp_imports(ov: Overlay, mod: parser.Module, dir: string, root: string, keys: string[], idents: string[]): parser.Module {
  let out: parser.Import[] = [];
  for imp in mod.imports {
    let k: i32 = util.index_of_str(keys, import_key(ov, imp.path, dir, root));
    let r: string = "";
    if (k >= 0) {
      r = idents[k];
    }
    out = out.append(parser.Import { ...imp, resolved: r });
  }
  return parser.Module { ...mod, imports: out };
}

function overlay_gives_stdlib(ov: Overlay): boolean {
  return ov.sealed || ov.paths.len() > 0;
}

function vendored_stdlib_dir(ov: Overlay, dir: string): string {
  if (overlay_gives_stdlib(ov)) {
    return dir;
  }
  let d: string = dir;
  let steps: i32 = 0;
  while (steps < 64) {
    if (util.is_dir(d + "std") || util.is_dir(d + "core")) {
      return d;
    }
    match (up_dir(d)) {
      Some(u) => {
        d = u;
      },
      None => {
        return dir;
      }
    }
    steps = steps + 1;
  }
  return dir;
}

function missing_line(ov: Overlay, imp: parser.Import, base: string, r: Resolved, entry_path: string, files: string[]): string {
  let msg: string = unresolved_import(imp.path, r.err_path, r.err);
  if (r.err.len() == 0 && util.is_stdlib_path(imp.path)) {
    if (stdlib_not_given(ov, base, imp.path)) {
      return "";
    }
    msg = unknown_stdlib_module(imp.path);
  }
  return util.pos_str(entry_path, files, imp.line, imp.col) + ": error[E086]: " + msg;
}

pub function load_graph(ov: Overlay, entry_path: string, entry: parser.Module, root: string): Graph {
  let edir: string = dirname(entry_path);
  let sroot: string = root;
  if (sroot.len() == 0) {
    sroot = vendored_stdlib_dir(ov, edir);
  } else if (sroot[sroot.len() - 1] != b'/') {
    sroot = sroot + "/";
  }
  let loaded: flatten.LoadedModule[] = [];
  let loaded_ids: string[] = [];
  let mod_dirs: string[] = [];
  let files: string[] = [];
  let missing: string[] = [];
  let keys: string[] = [];
  let idents: string[] = [];
  let imps: parser.Import[] = [];
  let dirs: string[] = [];
  for imp in entry.imports {
    imps = imps.append(imp);
    dirs = dirs.append(edir);
  }
  let qi: i32 = 0;
  while (qi < imps.len()) {
    let imp: parser.Import = imps[qi];
    let path: string = imp.path;
    let dir: string = dirs[qi];
    qi = qi + 1;
    let key: string = import_key(ov, path, dir, sroot);
    if (util.has_str(keys, key)) {
      continue;
    }
    keys = keys.append(key);
    let base: string = import_base(path, dir, sroot);
    let r: Resolved = resolve_module(ov, base, path);
    if (!r.ok) {
      idents = idents.append("");
      let line: string = missing_line(ov, imp, base, r, entry_path, files);
      if (line.len() > 0) {
        missing = missing.append(line);
      }
      continue;
    }
    let ident: string = resolved_ident(r);
    idents = idents.append(ident);
    if (util.has_str(loaded_ids, ident)) {
      continue;
    }
    let origin: string = "";
    if (r.shown == "stdlib://" + rel_path(path) + ".fern" || r.shown == base + rel_path(path) + ".fern") {
      origin = path;
    }
    let m: parser.Module = parser.with_stdlib_origin(parser.parse_module(lexer.tokenize_from(r.src, util.line_base(files.len()) + 1)), origin);
    let mdir: string = dir;
    if (!util.str_has_prefix(r.shown, "stdlib://")) {
      mdir = dirname(util.clean_path(r.shown));
    }
    files = files.append(r.shown);
    loaded = loaded.append(flatten.LoadedModule { name: base_name(path), ident: ident, mod: m });
    loaded_ids = loaded_ids.append(ident);
    mod_dirs = mod_dirs.append(mdir);
    for mi in m.imports {
      imps = imps.append(mi);
      dirs = dirs.append(mdir);
    }
  }
  let stamped: flatten.LoadedModule[] = [];
  let i: i32 = 0;
  while (i < loaded.len()) {
    stamped = stamped.append(flatten.LoadedModule { ...loaded[i], mod: stamp_imports(ov, loaded[i].mod, mod_dirs[i], sroot, keys, idents) });
    i = i + 1;
  }
  return Graph { entry: stamp_imports(ov, entry, edir, sroot, keys, idents), loaded: stamped, files: files, missing: missing };
}

pub function merge_builtins(dir: string, merged: parser.Module): parser.Module {
  match (read_file(dir + "builtins.fern")) {
    Ok(bsrc) => {
      let bmod: parser.Module = parser.parse_module(lexer.tokenize(bsrc));
      return parser.Module {
        funcs: merged.funcs,
        structs: util.append_all(merged.structs, bmod.structs),
        aliases: merged.aliases,
        imports: merged.imports,
        top_stmts: merged.top_stmts,
        enums: util.append_all(merged.enums, bmod.enums),
        resources: merged.resources,
        exports: merged.exports,
        impls: merged.impls,
        trait_reqs: merged.trait_reqs, trait_decls: merged.trait_decls, inferred_consts: merged.inferred_consts, todo_sites: merged.todo_sites, sights: merged.sights,
      };
    },
    Err(e) => {
      return merged;
    }
  }
  return merged;
}

pub function module_sig_string(mod: parser.Module): string {
  let out: string = "";
  let fi: i32 = 0;
  while (fi < mod.funcs.len()) {
    let f: parser.FuncDecl = mod.funcs[fi];
    out = out + "fn " + f.receiver_type + "." + f.name + "(";
    let pi: i32 = 0;
    while (pi < f.params.len()) {
      out = out + f.params[pi].type_name + ",";
      pi = pi + 1;
    }
    out = out + ")" + f.ret_type + ";";
    fi = fi + 1;
  }
  let si: i32 = 0;
  while (si < mod.structs.len()) {
    let sd: parser.StructDecl = mod.structs[si];
    out = out + "st " + sd.name + "{";
    let di: i32 = 0;
    while (di < sd.fields.len()) {
      out = out + sd.fields[di].name + ":" + sd.fields[di].type_name + ",";
      di = di + 1;
    }
    out = out + "}";
    si = si + 1;
  }
  return out;
}

pub function module_dep_ns(parts: flatten.PerModule[], infmods: parser.Module[], idx: i32): string {
  let deps: string[] = import_closure_ns(parts, infmods, idx);
  let out: string = "";
  let j: i32 = 0;
  while (j < parts.len()) {
    if (util.has_str(deps, parts[j].ns)) {
      if (out.len() > 0) {
        out = out + ",";
      }
      out = out + parts[j].ns;
    }
    j = j + 1;
  }
  return out;
}

pub function module_src(ov: Overlay, entry_path: string, parts: flatten.PerModule[], idx: i32): Option[string] {
  let path: string = entry_path;
  if (!parts[idx].is_entry) {
    let id: string = parts[idx].ident;
    if (util.str_has_prefix(id, "stdlib://")) {
      let source: Resolved = resolve_module(ov, "", slice_unchecked(id, 9, id.len()) + "");
      if (!source.ok) {
        return None;
      }
      return Some(source.src);
    }
    path = id + ".fern";
  }
  match (read_file(path)) {
    Ok(src) => {
      return Some(src);
    },
    Err(e) => {
      return None;
    }
  }
  return None;
}

pub function module_src_hash(ov: Overlay, entry_path: string, parts: flatten.PerModule[], idx: i32): string {
  match (module_src(ov, entry_path, parts, idx)) {
    Some(src) => {
      return util.hash_key(src);
    },
    None => {
      return "?";
    }
  }
  return "?";
}

function import_part_ns(parts: flatten.PerModule[], imp: parser.Import): string {
  let k: i32 = 0;
  while (k < parts.len()) {
    if (imp.resolved.len() > 0) {
      if (parts[k].ident == imp.resolved) {
        return parts[k].ns;
      }
    } else if (!parts[k].is_entry && parts[k].ns == util.mangle_prefix(base_name(imp.path))) {
      return parts[k].ns;
    }
    k = k + 1;
  }
  return "";
}

pub function import_closure_ns(parts: flatten.PerModule[], infmods: parser.Module[], idx: i32): string[] {
  let seen: string[] = [];
  let grew: boolean = true;
  while (grew) {
    grew = false;
    let j: i32 = 0;
    while (j < parts.len()) {
      if (j == idx || util.has_str(seen, parts[j].ns)) {
        for imp in infmods[j].imports {
          let nm: string = import_part_ns(parts, imp);
          if (nm.len() > 0 && !util.has_str(seen, nm)) {
            seen = seen.append(nm);
            grew = true;
          }
        }
      }
      j = j + 1;
    }
  }
  return seen;
}

pub struct FactHashes { per_mod: string[], global: string }

function ident_tokens(s: string): string[] {
  let out: string[] = [];
  let start: i32 = 0 - 1;
  let i: i32 = 0;
  while (i <= s.len()) {
    let word: boolean = false;
    if (i < s.len()) {
      let c: i32 = s[i] as i32;
      word = c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 95;
    }
    if (word && start < 0) {
      start = i;
    }
    if (!word && start >= 0) {
      out = out.append(slice_unchecked(s, start, i) + "");
      start = 0 - 1;
    }
    i = i + 1;
  }
  return out;
}

function roll131(s: string): i32 {
  let b: i32 = 5381;
  let i: i32 = 0;
  while (i < s.len()) {
    b = b * 131 + s[i] as i32 + 7 & 1073741823;
    i = i + 1;
  }
  return b * 131 + s.len() & 1073741823;
}

pub function module_fact_hashes(infmods: parser.Module[], rows: string[]): FactHashes {
  let names: string[][] = [];
  for m in infmods {
    let ns: string[] = [];
    for f in m.funcs {
      ns = ns.append(f.name);
    }
    names = names.append(ns);
  }
  let nb: i32 = infmods.len() + 1;
  let sa: i32[] = [];
  let sb: i32[] = [];
  let bi: i32 = 0;
  while (bi < nb) {
    sa = sa.append(0);
    sb = sb.append(0);
    bi = bi + 1;
  }
  let seen: Map[string, i32] = map_new(rows.len() + 1);
  for row in rows {
    let toks: string[] = ident_tokens(row);
    let owners: i32[] = [];
    let j: i32 = 0;
    while (j < names.len()) {
      let owned: boolean = false;
      for t in toks {
        if (util.has_str(names[j], t)) {
          owned = true;
        }
      }
      if (owned) {
        owners = owners.append(j);
      }
      j = j + 1;
    }
    if (owners.len() == 0) {
      owners = [infmods.len()];
    }
    for o in owners {
      let k: string = util.i32_to_string(o) + "|" + row;
      if (seen.get_or(k, 0) == 0) {
        seen = seen.insert(k, 1);
        sa = sa.with(o, sa[o] + util.hash_bucket(row, 1073741823) & 1073741823);
        sb = sb.with(o, sb[o] + roll131(row) & 1073741823);
      }
    }
  }
  let per: string[] = [];
  let pj: i32 = 0;
  while (pj < infmods.len()) {
    per = per.append(util.i32_to_string(sa[pj]) + "_" + util.i32_to_string(sb[pj]));
    pj = pj + 1;
  }
  return FactHashes { per_mod: per, global: util.i32_to_string(sa[infmods.len()]) + "_" + util.i32_to_string(sb[infmods.len()]) };
}

pub function fact_sig_hashes(infmods: parser.Module[], fh: FactHashes): string[] {
  let out: string[] = [];
  let j: i32 = 0;
  while (j < infmods.len()) {
    out = out.append(util.hash_key(module_sig_string(infmods[j]) + "|f" + fh.per_mod[j]));
    j = j + 1;
  }
  return out;
}

pub function module_cache_key(parts: flatten.PerModule[], infmods: parser.Module[], sighashes: string[], idx: i32, src_hash: string, extra: string[]): string {
  if (src_hash == "?") {
    return "";
  }
  let key: string = parts[idx].ns + "|" + src_hash;
  let deps: string[] = import_closure_ns(parts, infmods, idx);
  let j: i32 = 0;
  while (j < parts.len()) {
    if (util.has_str(deps, parts[j].ns)) {
      key = key + "#" + sighashes[j];
    }
    j = j + 1;
  }
  if (parts[idx].is_entry) {
    let ex: string = "";
    let ei: i32 = 0;
    while (ei < extra.len()) {
      ex = ex + extra[ei] + ",";
      ei = ei + 1;
    }
    key = key + "@" + util.hash_key(ex);
  }
  return key;
}

pub function module_unit_cache_key(parts: flatten.PerModule[], infmods: parser.Module[], sighashes: string[], idx: i32, src_hash: string, extra: string[], lo: i32, hi: i32, fh: FactHashes): string {
  let key: string = module_cache_key(parts, infmods, sighashes, idx, src_hash, extra);
  if (key.len() == 0) {
    return "";
  }
  return key + "|r" + util.i32_to_string(lo) + ":" + util.i32_to_string(hi) + "|f" + fh.global + ":" + fh.per_mod[idx];
}
