pub struct Table { first: i32, before: i32[][], inside: boolean }

pub function none(): Table {
  return Table { first: 0, before: [], inside: false };
}

pub function table(first: i32, count: i32, masks: i32[]): Table {
  if (first < 0 || count < 1 || count > 31) {
    eprint("SSA fixed-register table: invalid register range");
    exit(3);
  }
  let rows: i32[][] = [];
  let reg = 0;
  while (reg < count) {
    let row: i32[] = [0];
    let n = 0;
    for mask in masks {
      if (mask < 0 || mask >> count != 0) {
        eprint("SSA fixed-register table: mask outside register range");
        exit(3);
      }
      if ((mask & 1 << reg) != 0) {
        n = n + 1;
      }
      row = row.append(n);
    }
    rows = rows.append(row);
    reg = reg + 1;
  }
  return Table { first: first, before: rows, inside: false };
}

pub function table_inside(first: i32, count: i32, masks: i32[]): Table {
  return Table { ...table(first, count, masks), inside: true };
}

pub function validate(t: Table, nregs: i32, positions: i32): void {
  if (t.first < 0 || t.before.len() > nregs || t.first > nregs - t.before.len()) {
    eprint("SSA fixed-register table: range outside caller registers");
    exit(3);
  }
  for row in t.before {
    if (row.len() != positions + 1) {
      eprint("SSA fixed-register table: incorrect position count");
      exit(3);
    }
  }
}

pub function allows(t: Table, reg: i32, lo: i32, hi: i32): boolean {
  if (reg < t.first || reg - t.first >= t.before.len()) {
    return true;
  }
  let row = t.before[reg - t.first];
  if (t.inside) {
    return hi <= lo + 1 || row[hi] == row[lo + 1];
  }
  return row[hi + 1] == row[lo];
}
