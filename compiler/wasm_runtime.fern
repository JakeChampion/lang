pub function strcmp_source(): string {
  return "function __fern_strcmp(a: usize, b: usize): i32 {\n"
    + "  let la: u32 = __load_i32(a) as u32; let lb: u32 = __load_i32(b) as u32;\n"
    + "  let n: u32 = la; if (lb < n) { n = lb; }\n"
    + "  let i: u32 = 0;\n"
    + "  while (i < n) {\n"
    + "    let ca: i32 = __load_u8(a + 4 + i); let cb: i32 = __load_u8(b + 4 + i);\n"
    + "    if (ca < cb) { return -1; } if (ca > cb) { return 1; }\n"
    + "    i = i + 1;\n"
    + "  }\n"
    + "  if (la < lb) { return -1; } if (la > lb) { return 1; }\n"
    + "  return 0;\n"
    + "}\n";
}

pub function streq_source(): string {
  return "function __fern_streq(a: usize, b: usize): boolean {\n"
    + "  let n: u32 = __load_i32(a) as u32;\n"
    + "  if (n != __load_i32(b) as u32) { return false; }\n"
    + "  let i: u32 = 0;\n"
    + "  while (i < n) {\n"
    + "    if (__load_u8(a + 4 + i) != __load_u8(b + 4 + i)) { return false; }\n"
    + "    i = i + 1;\n"
    + "  }\n"
    + "  return true;\n"
    + "}\n";
}

pub function utf8_step_source(): string {
  return "function __fern_utf8_step(s: usize, i: i32, n: i32): i32 {\n"
    + "  let b0: i32 = __load_u8(s + 4 + i);\n"
    + "  if (b0 < 194 || b0 > 244 || i + 1 >= n) { return 1; }\n"
    + "  let c: i32 = __load_u8(s + 4 + i + 1);\n"
    + "  if (c < 128 || c > 191) { return 1; }\n"
    + "  if (b0 < 224) { return 2; }\n"
    + "  if (b0 == 224 && c < 160 || b0 == 237 && c > 159) { return 1; }\n"
    + "  let want: i32 = 3;\n"
    + "  if (b0 >= 240) {\n"
    + "    if (b0 == 240 && c < 144 || b0 == 244 && c > 143) { return 1; }\n"
    + "    want = 4;\n"
    + "  }\n"
    + "  let k: i32 = 2;\n"
    + "  while (k < want) {\n"
    + "    if (i + k >= n) { return k; }\n"
    + "    c = __load_u8(s + 4 + i + k);\n"
    + "    if (c < 128 || c > 191) { return k; }\n"
    + "    k = k + 1;\n"
    + "  }\n"
    + "  return want;\n"
    + "}\n";
}

pub function byte_find_source(reverse: boolean): string {
  let name: string = "__fern_memchr_bytes";
  let clamp: string = "if (i < 0) { i = 0; }";
  let condition: string = "i < n";
  let step: string = "i = i + 1;";
  if (reverse) {
    name = "__fern_rmemchr_bytes";
    clamp = "if (i >= n) { i = n - 1; }";
    condition = "i >= 0";
    step = "i = i - 1;";
  }
  return "function " + name + "(a: usize, byte: i32, from: i32): i32 {\n"
    + "  if ((byte as u32) > (255 as u32)) { return -1; }\n"
    + "  let n: i32 = __load_i32(a); let i: i32 = from; " + clamp + "\n"
    + "  while (" + condition + ") {\n"
    + "    if (__load_u8(a + 8 + i) == byte) { return i; }\n"
    + "    " + step + "\n"
    + "  }\n"
    + "  return -1;\n"
    + "}\n";
}

pub function mulhi_source(): string {
  return "function __fern_mulhi_u64(a: u64, b: u64): u64 {\n"
    + "  let mask: u64 = 4294967295 as u64;\n"
    + "  let al: u64 = a & mask; let ah: u64 = a >> 32;\n"
    + "  let bl: u64 = b & mask; let bh: u64 = b >> 32;\n"
    + "  let mid: u64 = ah * bl + ((al * bl) >> 32);\n"
    + "  return ah * bh + (mid >> 32) + (((mid & mask) + al * bh) >> 32);\n"
    + "}\n";
}

pub function set_scan_source(array: boolean, runs: boolean): string {
  let name: string = "__fern_scan_set";
  let offset: string = "4";
  let init: string = "let i: i32 = state; if (i < 0) { i = 0; }";
  if (runs) {
    name = "__fern_count_runs";
    init = "let i: i32 = 0; let prev: i32 = if (state != 0) { 1 } else { 0 }; let count: i32 = 0;";
  }
  if (array) {
    name = name + "_bytes";
    offset = "8";
  }
  let prefix: string = "function " + name + "(s: usize, state: i32, set: usize): i32 {\n"
    + "  let len: i32 = __load_i32(s); let n: u32 = __load_i32(set) as u32;\n"
    + "  " + init + "\n";
  let load: string = "let b: u32 = __load_u8(s + " + offset + " + i) as u32;";
  if (runs) {
    // For a byte v, (v + 255) >> 8 is zero for zero and one otherwise.
    return prefix + "  while (i < len) {\n"
      + "    " + load + " let cur: i32 = 0;\n"
      + "    if (b < n) { cur = (__load_u8(set + 8 + b) + 255) >> 8; }\n"
      + "    count = count + (cur & (prev ^ 1)); prev = cur; i = i + 1;\n"
      + "  }\n  return count;\n}\n";
  }
  return prefix + "  while (i < len) {\n"
    + "    " + load + "\n"
    + "    if (b < n) {\n"
    + "      if (__load_u8(set + 8 + b) == 0) { i = i + 1; continue; }\n"
    + "      return i;\n"
    + "    }\n"
    + "    i = i + 1;\n"
    + "  }\n  return len;\n}\n";
}
