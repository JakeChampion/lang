pub function arr_oob(): string {
  return "fern: array index out of range";
}

pub function str_oob(): string {
  return "fern: string index out of range";
}

pub function slice_range(): string {
  return "fern: slice range out of bounds";
}

pub function stack_overflow(): string {
  return "fern: stack overflow";
}

pub function stack_guard(): string {
  return "fern: could not protect the stack guard";
}

pub function signal_stack_map(): string {
  return "fern: could not map the signal stack";
}

pub function signal_stack(): string {
  return "fern: could not install the signal stack";
}

pub function fault_handler(): string {
  return "fern: could not install the fault handler";
}

pub function canary_read(): string {
  return "fern: could not read the stack canary";
}

pub function canary(): string {
  return "fern: stack canary mismatch";
}

pub function busy(): string {
  return "fern: two threads entered this shared object at once";
}

pub function alloc_size(): string {
  return "fern: allocation size out of range";
}

pub function oom(): string {
  return "fern: out of memory (heap arena exhausted)";
}

pub function map_fail(): string {
  return "fern: could not map the heap arena (errno ";
}
