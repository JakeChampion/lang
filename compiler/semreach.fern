import "./ssa";
import "./ssadeps";
import "./ssasem";
import "./semrecords";
import "./sempair";
import "./semthread";
import "./typeinfo";
import "./util";

pub struct Reached { funcs: ssasem.Func[], live: boolean[], rewritten: boolean[], ok: boolean }

pub function reach(funcs: ssasem.Func[], names: string[], usable: boolean[], blocked: boolean[], roots: boolean[]): Reached {
  let ix: util.NameIndex = util.name_index(names);
  let u: Universe = universe(funcs, usable);
  let op: util.NameIndex = opaque_types(funcs, ix, usable, roots, u);
  let ctx: Ctx = Ctx { funcs: funcs, ix: ix, usable: usable, u: u, callers: callers_of(funcs, ix, usable), freaders: readers_of(funcs, usable, u), vtesters: testers_of(funcs, usable, u), keys: keys_of(funcs, usable, u), counters: counters_of(funcs, usable, u) };
  let w: World = start(ctx, roots, op, zeroed(funcs, usable));
  let walks: Walk[] = [];
  while (walks.len() < funcs.len()) {
    walks = walks.append(Walk { vals: [], exec: [], edges: [], stale: [], keys: [], changed: false });
  }
  while (w.next < w.queue.len()) {
    let i: i32 = w.queue[w.next];
    w = World { ...w, next: w.next + 1, queued: w.queued.with(i, false) };
    if (usable[i]) {
      let wk: Walk = walk(ctx, w, i);
      walks = walks.with(i, wk);
      w = absorb(ctx, w, i, wk);
    }
  }
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (w.reach[i] && blocked[i]) {
      return Reached { funcs: funcs, live: w.reach, rewritten: [], ok: false };
    }
    i = i + 1;
  }
  let out: ssasem.Func[] = [];
  let changed: boolean[] = [];
  i = 0;
  while (i < funcs.len()) {
    let r: Rewritten = Rewritten { f: funcs[i], changed: 0 };
    if (w.reach[i] && usable[i]) {
      r = rewritten(funcs[i], walks[i]);
    }
    out = out.append(r.f);
    changed = changed.append(r.changed > 0);
    i = i + 1;
  }
  return Reached { funcs: out, live: w.reach, rewritten: changed, ok: true };
}

function top(): i64 {
  return 4294967296i64;
}

function bottom(): i64 {
  return 8589934592i64;
}

function konst(v: i32): i64 {
  return v as i64;
}

function known(l: i64): boolean {
  return l != top() && l != bottom();
}

function join(a: i64, b: i64): i64 {
  if (a == top()) {
    return b;
  }
  if (b == top() || a == b) {
    return a;
  }
  return bottom();
}

function any(): i64 {
  return bottom();
}

function none(): i64 {
  return top();
}

function tracked(t: typeinfo.Type): boolean {
  return ssasem.is_bool(t) || ssasem.is_i32(t);
}

struct Universe { fields: util.NameIndex, field_owner: string[], variants: util.NameIndex, variant_owner: string[], rec_ix: util.NameIndex, recs: semrecords.Record[], rec_fields: i32[][], enum_ix: util.NameIndex, enums: semrecords.Enum[] }

function field_key(t: typeinfo.Type, k: i32): string {
  return ssasem.type_key(t) + "#" + util.i32_to_string(k);
}

function variant_key(t: typeinfo.Type, name: string): string {
  return ssasem.type_key(t) + "|" + name;
}

function universe(funcs: ssasem.Func[], usable: boolean[]): Universe {
  let u: Universe = Universe { fields: util.name_index([]), field_owner: [], variants: util.name_index([]), variant_owner: [], rec_ix: util.name_index([]), recs: [], rec_fields: [], enum_ix: util.name_index([]), enums: [] };
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (usable[i]) {
      for r in funcs[i].records.list {
        u = with_record(u, r);
      }
      for e in funcs[i].enums {
        u = with_enum(u, e);
      }
    }
    i = i + 1;
  }
  return u;
}

function with_record(u: Universe, r: semrecords.Record): Universe {
  let owner: string = ssasem.type_key(r.ty);
  if (u.rec_ix.has(owner)) {
    return u;
  }
  u = Universe { ...u, rec_ix: u.rec_ix.added(owner), recs: u.recs.append(r) };
  let at: i32[] = [];
  let k: i32 = 0;
  while (k < r.fields.len()) {
    if (tracked(r.fields[k].ty)) {
      at = at.append(u.field_owner.len());
      u = Universe { ...u, fields: u.fields.added(field_key(r.ty, k)), field_owner: u.field_owner.append(owner) };
    } else {
      at = at.append(0 - 1);
    }
    k = k + 1;
  }
  return Universe { ...u, rec_fields: u.rec_fields.append(at) };
}

function with_enum(u: Universe, e: semrecords.Enum): Universe {
  let owner: string = ssasem.type_key(e.ty);
  if (u.enum_ix.has(owner)) {
    return u;
  }
  u = Universe { ...u, enum_ix: u.enum_ix.added(owner), enums: u.enums.append(e) };
  if (e.layout != semrecords.layout_variant()) {
    return u;
  }
  for v in e.variants {
    u = Universe { ...u, variants: u.variants.added(variant_key(e.ty, v.name)), variant_owner: u.variant_owner.append(owner) };
  }
  return u;
}

function opaque_types(funcs: ssasem.Func[], ix: util.NameIndex, usable: boolean[], roots: boolean[], u: Universe): util.NameIndex {
  let op: util.NameIndex = util.name_index([]);
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (usable[i]) {
      let f: ssasem.Func = funcs[i];
      for b in f.graph.blocks {
        for ins in b.insts {
          if (ins.result >= 0 && ins.result < f.values.len() && arrives(ins, f.values[ins.result], ix, usable, u)) {
            op = opaque_add(f.values[ins.result], op, u);
          }
        }
      }
      if (roots[i]) {
        for t in f.params {
          op = opaque_add(t, op, u);
        }
      }
    }
    i = i + 1;
  }
  return op;
}

function arrives(ins: ssa.SInst, result: typeinfo.Type, ix: util.NameIndex, usable: boolean[], u: Universe): boolean {
  let k: i32 = ins.kind_tag;
  if (k == ssasem.call() || k == ssasem.closure_new() || k == 13) {
    return call_arrives(ins, ix, usable);
  }
  if (k < 0) {
    return semantic_arrives(k, result, u);
  }
  return !(k >= 1 && k <= 10 || k == 35 || k == 36);
}

function call_arrives(ins: ssa.SInst, ix: util.NameIndex, usable: boolean[]): boolean {
  if (ssasem.is_dyn_call(ins.str) || util.str_has_prefix(ins.str, sempair.word_as_prefix())) {
    return false;
  }
  let g: i32 = ix.find(ins.str);
  return g < 0 || !usable[g];
}

function semantic_arrives(k: i32, result: typeinfo.Type, u: Universe): boolean {
  if (k == ssasem.zero()) {
    return !is_record(result) && !is_variant_enum(result, u);
  }
  return k == ssasem.dyn_as() || k == ssasem.variant_up();
}

function is_record(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  return false;
}

function is_variant_enum(t: typeinfo.Type, u: Universe): boolean {
  if let typeinfo.TypeUnion(_) = t {
    let e: i32 = u.enum_ix.find(ssasem.type_key(t));
    return e >= 0 && u.enums[e].layout == semrecords.layout_variant();
  }
  return false;
}

function opaque_add(t: typeinfo.Type, op: util.NameIndex, u: Universe): util.NameIndex {
  match (t) {
    typeinfo.TypeStruct(s) => {
      return opaque_nominal(ssasem.type_key(t), s.args, op, u);
    },
    typeinfo.TypeUnion(un) => {
      return opaque_nominal(ssasem.type_key(t), un.args, op, u);
    },
    typeinfo.TypeArray(a) => {
      return opaque_add(a.elem, op, u);
    },
    typeinfo.TypeTuple(tup) => {
      return opaque_all(tup.elements, op, u);
    },
    typeinfo.TypeMap(m) => {
      return opaque_add(m.value, opaque_add(m.key, op, u), u);
    },
    typeinfo.TypeFunc(fn) => {
      return opaque_add(fn.ret_type, op, u);
    },
    _ => {}
  }
  return op;
}

function opaque_nominal(key: string, args: typeinfo.Type[], op: util.NameIndex, u: Universe): util.NameIndex {
  if (op.has(key)) {
    return op;
  }
  return opaque_all(held_types(u, key), opaque_all(args, op.added(key), u), u);
}

function opaque_all(ts: typeinfo.Type[], op: util.NameIndex, u: Universe): util.NameIndex {
  for t in ts {
    op = opaque_add(t, op, u);
  }
  return op;
}

function held_types(u: Universe, key: string): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let r: i32 = u.rec_ix.find(key);
  if (r >= 0) {
    for fl in u.recs[r].fields {
      out = out.append(fl.ty);
    }
  }
  let e: i32 = u.enum_ix.find(key);
  if (e >= 0) {
    for v in u.enums[e].variants {
      for fl in v.fields {
        out = out.append(fl.ty);
      }
    }
  }
  return out;
}

function zeroed(funcs: ssasem.Func[], usable: boolean[]): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (usable[i]) {
      let f: ssasem.Func = funcs[i];
      for b in f.graph.blocks {
        for ins in b.insts {
          if (ins.kind_tag == ssasem.zero() && ins.result >= 0 && ins.result < f.values.len()) {
            out = out.append(f.values[ins.result]);
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

struct Ctx { funcs: ssasem.Func[], ix: util.NameIndex, usable: boolean[], u: Universe, callers: i32[][], freaders: i32[][], vtesters: i32[][], keys: i32[][], counters: i32[][] }

function lists(n: i32): i32[][] {
  let out: i32[][] = [];
  while (out.len() < n) {
    out = out.append([]);
  }
  return out;
}

function noted(own xs: i32[][], at: i32, i: i32): i32[][] {
  let l: i32[] = xs[at];
  if (l.len() > 0 && l[l.len() - 1] == i) {
    return xs;
  }
  return xs.with(at, l.append(i));
}

function callers_of(funcs: ssasem.Func[], ix: util.NameIndex, usable: boolean[]): i32[][] {
  let out: i32[][] = lists(funcs.len());
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (usable[i]) {
      for b in funcs[i].graph.blocks {
        for ins in b.insts {
          if (ins.kind_tag == ssasem.call()) {
            let g: i32 = ix.find(ins.str);
            if (g >= 0) {
              out = noted(out, g, i);
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function readers_of(funcs: ssasem.Func[], usable: boolean[], u: Universe): i32[][] {
  let out: i32[][] = lists(u.field_owner.len());
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (usable[i]) {
      let f: ssasem.Func = funcs[i];
      for b in f.graph.blocks {
        for ins in b.insts {
          if (ins.kind_tag == ssasem.record_get() && ins.args.len() == 1) {
            let k: i32 = u.fields.find(field_key(f.values[ins.args[0]], ins.imm));
            if (k >= 0) {
              out = noted(out, k, i);
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function testers_of(funcs: ssasem.Func[], usable: boolean[], u: Universe): i32[][] {
  let out: i32[][] = lists(u.variant_owner.len());
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (usable[i]) {
      let f: ssasem.Func = funcs[i];
      for b in f.graph.blocks {
        for ins in b.insts {
          if (ins.kind_tag == ssasem.variant_is() && ins.args.len() == 1) {
            let v: i32 = u.variants.find(variant_key(f.values[ins.args[0]], ins.str));
            if (v >= 0) {
              out = noted(out, v, i);
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function counters_of(funcs: ssasem.Func[], usable: boolean[], u: Universe): i32[][] {
  let out: i32[][] = lists(u.recs.len());
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (usable[i]) {
      let f: ssasem.Func = funcs[i];
      for b in f.graph.blocks {
        for ins in b.insts {
          if (ins.kind_tag == ssasem.length()) {
            let r: i32 = element_record(u, f.values[ins.args[0]]);
            if (r >= 0) {
              out = noted(out, r, i);
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function element_record(u: Universe, t: typeinfo.Type): i32 {
  if let typeinfo.TypeArray(a) = t {
    if let typeinfo.TypeStruct(_) = a.elem {
      return u.rec_ix.find(ssasem.type_key(a.elem));
    }
  }
  return 0 - 1;
}

function keys_of(funcs: ssasem.Func[], usable: boolean[], u: Universe): i32[][] {
  let out: i32[][] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let f: ssasem.Func = funcs[i];
    let keys: i32[] = [];
    if (usable[i]) {
      keys = util.minus_ones(f.graph.nvals);
      for b in f.graph.blocks {
        for ins in b.insts {
          if (ins.result >= 0 && ins.result < keys.len()) {
            keys = keys.with(ins.result, key_of(u, f, ins));
          }
        }
      }
    }
    out = out.append(keys);
    i = i + 1;
  }
  return out;
}

function key_of(u: Universe, f: ssasem.Func, ins: ssa.SInst): i32 {
  let k: i32 = ins.kind_tag;
  if (k == ssasem.record_get()) {
    return u.fields.find(field_key(f.values[ins.args[0]], ins.imm));
  }
  if (k == ssasem.variant_is()) {
    return u.variants.find(variant_key(f.values[ins.args[0]], ins.str));
  }
  if (k == ssasem.variant_new()) {
    return u.variants.find(variant_key(f.values[ins.result], ins.str));
  }
  if (k == ssasem.record_new()) {
    return u.rec_ix.find(ssasem.type_key(f.values[ins.result]));
  }
  if (k == ssasem.length()) {
    return element_record(u, f.values[ins.args[0]]);
  }
  if (k == ssasem.closure_new()) {
    let at: i32 = ssasem.find_contract_in(f.calls, ins.str);
    if (at >= 0 && f.calls[at].params.len() > 0) {
      return u.rec_ix.find(ssasem.type_key(f.calls[at].params[0]));
    }
  }
  return 0 - 1;
}

struct World { reach: boolean[], fields: i64[], built: boolean[], rets: i64[], inhabited: boolean[], queue: i32[], next: i32, queued: boolean[] }

function start(ctx: Ctx, roots: boolean[], op: util.NameIndex, zeros: typeinfo.Type[]): World {
  let built: boolean[] = [];
  for owner in ctx.u.variant_owner {
    built = built.append(op.has(owner));
  }
  let rets: i64[] = [];
  while (rets.len() < ctx.funcs.len()) {
    rets = rets.append(none());
  }
  let w: World = World { reach: __alloc_bool(ctx.funcs.len()), fields: zero_fields(ctx.u, opaque_fields(ctx.u, op), zeros), built: built, rets: rets, inhabited: inhabited_at_start(ctx.u, op, zeros), queue: [], next: 0, queued: __alloc_bool(ctx.funcs.len()) };
  let i: i32 = 0;
  while (i < roots.len()) {
    if (roots[i]) {
      w = reached(w, i);
    }
    i = i + 1;
  }
  return w;
}

function inhabited_at_start(u: Universe, op: util.NameIndex, zeros: typeinfo.Type[]): boolean[] {
  let out: boolean[] = [];
  for r in u.recs {
    out = out.append(op.has(ssasem.type_key(r.ty)));
  }
  for t in zeros {
    let r: i32 = u.rec_ix.find(ssasem.type_key(t));
    if (r >= 0) {
      out = out.with(r, true);
    }
  }
  return out;
}

function opaque_fields(u: Universe, op: util.NameIndex): i64[] {
  let fields: i64[] = [];
  for owner in u.field_owner {
    if (op.has(owner)) {
      fields = fields.append(any());
    } else {
      fields = fields.append(none());
    }
  }
  return fields;
}

function zero_fields(u: Universe, own fields: i64[], zeros: typeinfo.Type[]): i64[] {
  for t in zeros {
    let r: i32 = u.rec_ix.find(ssasem.type_key(t));
    let k: i32 = 0;
    while (r >= 0 && k < u.recs[r].fields.len()) {
      let at: i32 = u.fields.find(field_key(t, k));
      if (at >= 0) {
        fields = fields.with(at, join(fields[at], konst(0)));
      }
      k = k + 1;
    }
  }
  return fields;
}

function queued(w: World, i: i32): World {
  if (w.queued[i]) {
    return w;
  }
  return World { ...w, queue: w.queue.append(i), queued: w.queued.with(i, true) };
}

function queued_all(w: World, xs: i32[]): World {
  for i in xs {
    if (w.reach[i]) {
      w = queued(w, i);
    }
  }
  return w;
}

function reached(w: World, i: i32): World {
  if (w.reach[i]) {
    return w;
  }
  return queued(World { ...w, reach: w.reach.with(i, true) }, i);
}

function reached_name(ctx: Ctx, w: World, name: string): World {
  let g: i32 = ctx.ix.find(name);
  if (g < 0) {
    return w;
  }
  return reached(w, g);
}

struct Walk { vals: i64[], exec: boolean[], edges: boolean[][], stale: boolean[], keys: i32[], changed: boolean }

function walk(ctx: Ctx, w: World, i: i32): Walk {
  let f: ssasem.Func = ctx.funcs[i];
  let g: ssa.SFunc = f.graph;
  let at: i32[] = ssadeps.position_of(g);
  let wk: Walk = Walk { vals: entry_values(g), exec: __alloc_bool(g.blocks.len()).with(at[g.entry], true), edges: no_edges(g), stale: __alloc_bool(g.blocks.len()), keys: ctx.keys[i], changed: true };
  while (wk.changed) {
    wk = Walk { ...wk, changed: false };
    let pos: i32 = 0;
    while (pos < g.blocks.len()) {
      if (wk.exec[pos]) {
        wk = walked_block(ctx, w, f, at, wk, pos);
      }
      pos = pos + 1;
    }
  }
  return wk;
}

function entry_values(g: ssa.SFunc): i64[] {
  let vals: i64[] = [];
  while (vals.len() < g.nvals) {
    if (vals.len() < g.nparams) {
      vals = vals.append(any());
    } else {
      vals = vals.append(none());
    }
  }
  return vals;
}

function no_edges(g: ssa.SFunc): boolean[][] {
  let edges: boolean[][] = [];
  for b in g.blocks {
    edges = edges.append(__alloc_bool(b.preds.len()));
  }
  return edges;
}

function walked_block(ctx: Ctx, w: World, f: ssasem.Func, at: i32[], wk: Walk, pos: i32): Walk {
  let g: ssa.SFunc = f.graph;
  let b: ssa.SBlock = g.blocks[pos];
  for ins in b.insts {
    if (ins.result >= 0 && ins.result < g.nvals) {
      let next: i64 = join(wk.vals[ins.result], eval(ctx, w, f, wk, pos, ins));
      if (next != wk.vals[ins.result]) {
        wk = Walk { ...wk, vals: wk.vals.with(ins.result, next), changed: true };
      }
    }
  }
  return followed(g, at, wk, pos, b);
}

function followed(g: ssa.SFunc, at: i32[], wk: Walk, pos: i32, b: ssa.SBlock): Walk {
  let t: ssa.STerm = b.term;
  if (t.kind_tag == 2) {
    return entered(g, at, wk, b.id, t.target);
  }
  if (t.kind_tag != 3) {
    return wk;
  }
  let c: i64 = wk.vals[t.cond];
  if (c == top()) {
    return wk;
  }
  if (known(c)) {
    if (c as i32 != 0) {
      return entered(g, at, wk, b.id, t.t);
    }
    return entered(g, at, wk, b.id, t.f);
  }
  return entered(g, at, entered(g, at, wk, b.id, t.t), b.id, t.f);
}

function entered(g: ssa.SFunc, at: i32[], wk: Walk, from: i32, to: i32): Walk {
  let tp: i32 = at[to];
  if (!wk.exec[tp]) {
    wk = Walk { ...wk, exec: wk.exec.with(tp, true), changed: true };
  }
  let preds: i32[] = g.blocks[tp].preds;
  let j: i32 = 0;
  while (j < preds.len() && preds[j] != from) {
    j = j + 1;
  }
  if (j == preds.len()) {
    if (!wk.stale[tp]) {
      return Walk { ...wk, stale: wk.stale.with(tp, true), changed: true };
    }
    return wk;
  }
  if (!wk.edges[tp][j]) {
    let row: boolean[] = wk.edges[tp].with(j, true);
    return Walk { ...wk, edges: wk.edges.with(tp, row), changed: true };
  }
  return wk;
}

function eval(ctx: Ctx, w: World, f: ssasem.Func, wk: Walk, pos: i32, ins: ssa.SInst): i64 {
  if (ins.kind_tag < 0) {
    return semantic_value(ctx, w, wk, ins);
  }
  return scalar_value(f, wk, pos, ins);
}

function scalar_value(f: ssasem.Func, wk: Walk, pos: i32, ins: ssa.SInst): i64 {
  let k: i32 = ins.kind_tag;
  if (k == 1 || k == 2) {
    return konst(ins.imm);
  }
  if (k == 7) {
    return wk.vals[ins.args[0]];
  }
  if (k == 8) {
    return phi_value(wk, pos, ins);
  }
  if (k == 36) {
    return select_value(wk, ins);
  }
  if (k == 9) {
    return binary(f, wk, ins);
  }
  if (k == 10) {
    return unary(f, wk, ins);
  }
  return any();
}

function unary(f: ssasem.Func, wk: Walk, ins: ssa.SInst): i64 {
  let a: i64 = wk.vals[ins.args[0]];
  if (ins.str != "!" || !ssasem.is_bool(f.values[ins.args[0]]) || a == bottom()) {
    return any();
  }
  if (a == top()) {
    return a;
  }
  return konst(1 - a as i32);
}

function phi_value(wk: Walk, pos: i32, ins: ssa.SInst): i64 {
  if (wk.stale[pos]) {
    return any();
  }
  let out: i64 = none();
  let j: i32 = 0;
  while (j < ins.args.len() && j < wk.edges[pos].len()) {
    if (wk.edges[pos][j]) {
      out = join(out, wk.vals[ins.args[j]]);
    }
    j = j + 1;
  }
  return out;
}

function select_value(wk: Walk, ins: ssa.SInst): i64 {
  let c: i64 = wk.vals[ins.args[0]];
  if (c == top()) {
    return none();
  }
  if (c == bottom()) {
    return join(wk.vals[ins.args[1]], wk.vals[ins.args[2]]);
  }
  if (c as i32 != 0) {
    return wk.vals[ins.args[1]];
  }
  return wk.vals[ins.args[2]];
}

function semantic_value(ctx: Ctx, w: World, wk: Walk, ins: ssa.SInst): i64 {
  let k: i32 = ins.kind_tag;
  if (k == ssasem.record_get()) {
    let fk: i32 = wk.keys[ins.result];
    if (fk < 0) {
      return any();
    }
    return w.fields[fk];
  }
  if (k == ssasem.variant_is()) {
    let vk: i32 = wk.keys[ins.result];
    if (vk >= 0 && !w.built[vk]) {
      return konst(0);
    }
    return any();
  }
  if (k == ssasem.call()) {
    return call_value(ctx, w, ins);
  }
  if (k == ssasem.length()) {
    let r: i32 = wk.keys[ins.result];
    if (r >= 0 && !w.inhabited[r]) {
      return konst(0);
    }
  }
  return any();
}

function call_value(ctx: Ctx, w: World, ins: ssa.SInst): i64 {
  if (ssasem.is_dyn_call(ins.str) || ins.imm != 0) {
    return any();
  }
  let g: i32 = ctx.ix.find(ins.str);
  if (g < 0 || !ctx.usable[g]) {
    return any();
  }
  return w.rets[g];
}

function binary(f: ssasem.Func, wk: Walk, ins: ssa.SInst): i64 {
  let a: i64 = wk.vals[ins.args[0]];
  let b: i64 = wk.vals[ins.args[1]];
  if (a == bottom() || b == bottom()) {
    return any();
  }
  if (a == top() || b == top()) {
    return none();
  }
  let t: typeinfo.Type = f.values[ins.args[0]];
  if (!comparable(t, f.values[ins.args[1]])) {
    return any();
  }
  if (ssasem.is_i32(t) && (ins.str == "+" || ins.str == "-")) {
    return summed(ins.str, a, b);
  }
  return compared(ins.str, a as i32, b as i32, ssasem.is_i32(t));
}

function summed(op: string, x: i64, y: i64): i64 {
  let r: i64 = x + y;
  if (op == "-") {
    r = x - y;
  }
  if (r < (0 - 2147483647 - 1) as i64 || r > 2147483647 as i64) {
    return any();
  }
  return konst(r as i32);
}

function compared(op: string, x: i32, y: i32, ordered: boolean): i64 {
  if (op == "==") {
    return truth(x == y);
  }
  if (op == "!=") {
    return truth(x != y);
  }
  if (!ordered) {
    return any();
  }
  if (op == "<") {
    return truth(x < y);
  }
  if (op == "<=") {
    return truth(x <= y);
  }
  if (op == ">") {
    return truth(x > y);
  }
  if (op == ">=") {
    return truth(x >= y);
  }
  return any();
}

function comparable(a: typeinfo.Type, b: typeinfo.Type): boolean {
  return ssasem.is_bool(a) && ssasem.is_bool(b) || ssasem.is_i32(a) && ssasem.is_i32(b);
}

function truth(b: boolean): i64 {
  if (b) {
    return konst(1);
  }
  return konst(0);
}

function absorb(ctx: Ctx, w: World, i: i32, wk: Walk): World {
  let f: ssasem.Func = ctx.funcs[i];
  let pos: i32 = 0;
  while (pos < f.graph.blocks.len()) {
    if (wk.exec[pos]) {
      let b: ssa.SBlock = f.graph.blocks[pos];
      for ins in b.insts {
        w = absorb_inst(ctx, w, f, wk, ins);
      }
      if (b.term.kind_tag == 1) {
        w = returned(ctx, w, i, wk, b.term.value);
      }
    }
    pos = pos + 1;
  }
  for t in f.values {
    if let typeinfo.TypeMap(m) = t {
      w = reached_name(ctx, reached_name(ctx, w, ssasem.keyed_map_key_fn(m.key, "hash")), ssasem.keyed_map_key_fn(m.key, "eq"));
    }
  }
  return w;
}

function returned(ctx: Ctx, w: World, i: i32, wk: Walk, value: i32): World {
  let r: i64 = any();
  if (tracked(ctx.funcs[i].result) && value >= 0) {
    r = wk.vals[value];
  }
  let next: i64 = join(w.rets[i], r);
  if (next == w.rets[i]) {
    return w;
  }
  return queued_all(World { ...w, rets: w.rets.with(i, next) }, ctx.callers[i]);
}

function absorb_inst(ctx: Ctx, w: World, f: ssasem.Func, wk: Walk, ins: ssa.SInst): World {
  if (ins.str.len() > 0) {
    w = named(ctx, w, ins.str);
  }
  if (ins.kind_tag == ssasem.record_new()) {
    return built_record(ctx, w, wk.keys[ins.result], wk, ins.args, 0);
  }
  if (ins.kind_tag == ssasem.closure_new()) {
    return built_record(ctx, w, wk.keys[ins.result], wk, ins.args, 1);
  }
  if (ins.kind_tag == ssasem.variant_new()) {
    let vk: i32 = wk.keys[ins.result];
    if (vk >= 0 && !w.built[vk]) {
      return queued_all(World { ...w, built: w.built.with(vk, true) }, ctx.vtesters[vk]);
    }
  }
  return w;
}

function named(ctx: Ctx, w: World, name: string): World {
  if (!ssasem.is_dyn_call(name)) {
    return reached_name(ctx, w, name);
  }
  for arm in ssasem.dyn_call_arms(name) {
    w = reached_name(ctx, w, arm);
  }
  return w;
}

function built_record(ctx: Ctx, w: World, r: i32, wk: Walk, args: i32[], first: i32): World {
  if (r < 0) {
    return w;
  }
  if (!w.inhabited[r]) {
    w = queued_all(World { ...w, inhabited: w.inhabited.with(r, true) }, ctx.counters[r]);
  }
  let at: i32[] = ctx.u.rec_fields[r];
  let k: i32 = 0;
  while (k < args.len() && first + k < at.len()) {
    let fk: i32 = at[first + k];
    if (fk >= 0) {
      let next: i64 = join(w.fields[fk], wk.vals[args[k]]);
      if (next != w.fields[fk]) {
        w = queued_all(World { ...w, fields: w.fields.with(fk, next) }, ctx.freaders[fk]);
      }
    }
    k = k + 1;
  }
  return w;
}

struct Rewritten { f: ssasem.Func, changed: i32 }

function rewritten(f: ssasem.Func, wk: Walk): Rewritten {
  let g: ssa.SFunc = f.graph;
  let dead: i32 = 0;
  for b in g.blocks {
    if (b.id >= dead) {
      dead = b.id + 1;
    }
  }
  let blocks: ssa.SBlock[] = g.blocks;
  let changed: i32 = 0;
  let pos: i32 = 0;
  while (pos < g.blocks.len()) {
    let b: ssa.SBlock = g.blocks[pos];
    if (wk.exec[pos] && b.term.kind_tag == 3) {
      let t: ssa.STerm = decided(b.term, wk.vals[b.term.cond], dead);
      if (t.kind_tag != 3 || t.t != b.term.t || t.f != b.term.f) {
        blocks = blocks.with(pos, ssa.SBlock { ...b, term: t });
        changed = changed + 1;
      }
    }
    pos = pos + 1;
  }
  if (changed == 0) {
    return Rewritten { f: f, changed: 0 };
  }
  blocks = blocks.append(ssa.SBlock { id: dead, insts: [], term: unreachable(), preds: [] });
  let moved: ssa.SFunc = ssa.SFunc { ...g, blocks: blocks };
  let kept: ssa.SFunc = ssa.SFunc { ...moved, blocks: semthread.reachable_only(moved) };
  return Rewritten { f: ssasem.Func { ...f, graph: ssa.SFunc { ...kept, blocks: ssa.refreshed_preds(kept) } }, changed: changed };
}

function decided(t: ssa.STerm, c: i64, dead: i32): ssa.STerm {
  if (c == top()) {
    return unreachable();
  }
  if (c == bottom() || t.t == t.f) {
    return t;
  }
  if (c as i32 == 0) {
    return ssa.STerm { ...t, t: dead };
  }
  return ssa.STerm { ...t, f: dead };
}

function unreachable(): ssa.STerm {
  return ssa.STerm { kind_tag: 4, cond: 0, target: 0, t: 0, f: 0, value: 0 };
}
