function gf_mul(a: i32, b: i32): i32 {
  let p = 0;
  let x = a;
  let y = b;
  while (y != 0) {
    if ((y & 1) != 0) {
      p = p ^ x;
    }
    x = x << 1;
    if ((x & 256) != 0) {
      x = x ^ 283;
    }
    y = y >> 1;
  }
  return p;
}

function rotl8(x: i32, k: i32): i32 {
  return (x << k | x >> 8 - k) & 255;
}

function sbox_byte(x: i32): i32 {
  let inv = 0;
  if (x != 0) {
    inv = 1;
    let k = 0;
    while (k < 254) {
      inv = gf_mul(inv, x);
      k += 1;
    }
  }
  return inv ^ rotl8(inv, 1) ^ rotl8(inv, 2) ^ rotl8(inv, 3) ^ rotl8(inv, 4) ^ 99;
}

function sbox_table(): i32[] {
  let t: i32[] = [];
  let x = 0;
  while (x < 256) {
    t = t.append(sbox_byte(x));
    x += 1;
  }
  return t;
}

function sub_rot_word(w: u8[], at: i32, sb: i32[], rot: boolean, rcon: i32): u8[] {
  let out = __alloc_u8(4);
  let k = 0;
  while (k < 4) {
    let src = k;
    if (rot) {
      src = k + 1 & 3;
    }
    out = out.with(k, sb[w[at + src] as i32] as u8);
    k += 1;
  }
  if (rot) {
    out = out.with(0, out[0] ^ rcon as u8);
  }
  return out;
}

pub function expand_key(key: u8[]): u8[] {
  let nk = key.len() / 4;
  if (key.len() != 16 && key.len() != 32) {
    return __alloc_u8(0);
  }
  let total: i32 = 16 * (nk + 7);
  let sb = sbox_table();
  let w = __alloc_u8(total);
  let i = 0;
  while (i < key.len()) {
    w = w.with(i, key[i]);
    i += 1;
  }
  let rcon = 1;
  let word = nk;
  while (word * 4 < total) {
    let t = sub_rot_word(w, 4 * word - 4, sb, word % nk == 0, rcon);
    if (word % nk == 0) {
      rcon = gf_mul(rcon, 2);
    } else {
      if (nk != 8 || word % nk != 4) {
        t = word_at(w, 4 * word - 4);
      }
    }
    let k = 0;
    while (k < 4) {
      w = w.with(4 * word + k, w[4 * (word - nk) + k] ^ t[k]);
      k += 1;
    }
    word += 1;
  }
  return w;
}

function word_at(w: u8[], at: i32): u8[] {
  let out = __alloc_u8(4);
  let k = 0;
  while (k < 4) {
    out = out.with(k, w[at + k]);
    k += 1;
  }
  return out;
}

function cipher_round(st: u8[], rk: u8[], at: i32, sb: i32[], last: boolean): u8[] {
  let out = __alloc_u8(16);
  let c = 0;
  while (c < 4) {
    let a0 = sb[st[4 * c] as i32];
    let a1 = sb[st[4 * (c + 1 & 3) + 1] as i32];
    let a2 = sb[st[4 * (c + 2 & 3) + 2] as i32];
    let a3 = sb[st[4 * (c + 3 & 3) + 3] as i32];
    let m: i32[] = [a0, a1, a2, a3];
    if (!last) {
      m = mix_column(a0, a1, a2, a3);
    }
    let r = 0;
    while (r < 4) {
      out = out.with(4 * c + r, m[r] as u8 ^ rk[at + 4 * c + r]);
      r += 1;
    }
    c += 1;
  }
  return out;
}

function mix_column(a0: i32, a1: i32, a2: i32, a3: i32): i32[] {
  return [
    gf_mul(a0, 2) ^ gf_mul(a1, 3) ^ a2 ^ a3,
    a0 ^ gf_mul(a1, 2) ^ gf_mul(a2, 3) ^ a3,
    a0 ^ a1 ^ gf_mul(a2, 2) ^ gf_mul(a3, 3),
    gf_mul(a0, 3) ^ a1 ^ a2 ^ gf_mul(a3, 2),
  ];
}

function encrypt_block(rk: u8[], rounds: i32, block: u8[], sb: i32[]): u8[] {
  let st = __alloc_u8(16);
  let i = 0;
  while (i < 16) {
    st = st.with(i, block[i] ^ rk[i]);
    i += 1;
  }
  let r = 1;
  while (r <= rounds) {
    st = cipher_round(st, rk, 16 * r, sb, r == rounds);
    r += 1;
  }
  return st;
}

function inc32(cb: u8[]): u8[] {
  let k = 15;
  let carry = true;
  while (k >= 12 && carry) {
    let v = cb[k] as i32 + 1;
    cb = cb.with(k, (v & 255) as u8);
    carry = v > 255;
    k -= 1;
  }
  return cb;
}

pub function ctr32(rk: u8[], counter: u8[], data: u8[]): u8[] {
  let rounds = 0;
  if (rk.len() >= 240) {
    rounds = 14;
  } else {
    if (rk.len() >= 176) {
      rounds = 10;
    }
  }
  if (rounds == 0 || counter.len() < 16) {
    return __alloc_u8(0);
  }
  let sb = sbox_table();
  let cb = block_at(counter, 0, 16);
  let out = __alloc_u8(data.len());
  let at = 0;
  while (at < data.len()) {
    let ks = encrypt_block(rk, rounds, cb, sb);
    let k = 0;
    while (k < 16 && at + k < data.len()) {
      out = out.with(at + k, data[at + k] ^ ks[k]);
      k += 1;
    }
    cb = inc32(cb);
    at += 16;
  }
  return out;
}

function block_at(src: u8[], at: i32, n: i32): u8[] {
  let out = __alloc_u8(16);
  let k = 0;
  while (k < n && at + k < src.len()) {
    out = out.with(k, src[at + k]);
    k += 1;
  }
  return out;
}

function gf128_mul(x: u8[], y: u8[]): u8[] {
  let z = __alloc_u8(16);
  let v = block_at(y, 0, 16);
  let i = 0;
  while (i < 128) {
    if ((x[i / 8] as i32 >> 7 - i % 8 & 1) != 0) {
      let k = 0;
      while (k < 16) {
        z = z.with(k, z[k] ^ v[k]);
        k += 1;
      }
    }
    v = shift_right1(v);
    i += 1;
  }
  return z;
}

function shift_right1(v: u8[]): u8[] {
  let lsb = v[15] as i32 & 1;
  let k = 15;
  while (k > 0) {
    v = v.with(k, ((v[k] as i32 >> 1 | v[k - 1] as i32 << 7) & 255) as u8);
    k -= 1;
  }
  v = v.with(0, v[0] >> 1);
  if (lsb != 0) {
    v = v.with(0, v[0] ^ 225 as u8);
  }
  return v;
}

pub function ghash(h: u8[], y: u8[], data: u8[]): u8[] {
  if (h.len() < 16 || y.len() < 16) {
    return __alloc_u8(0);
  }
  let acc = block_at(y, 0, 16);
  let at = 0;
  while (at < data.len()) {
    let blk = block_at(data, at, 16);
    let k = 0;
    while (k < 16) {
      acc = acc.with(k, acc[k] ^ blk[k]);
      k += 1;
    }
    acc = gf128_mul(acc, h);
    at += 16;
  }
  return acc;
}

pub function gcm(rk: u8[], h: u8[], nonce: u8[], aad: u8[], data: u8[], seal: boolean): u8[] {
  if (rk.len() < 176 || h.len() < 16 || nonce.len() != 12) {
    return __alloc_u8(0);
  }
  let j0 = block_at(nonce, 0, 12).with(15, 1 as u8);
  let out = ctr32(rk, inc32(j0), data);
  let ct: u8[] = if (seal) { out } else { data };
  let y = ghash(h, ghash(h, __alloc_u8(16), aad), ct);
  let lens = __alloc_u8(16);
  let abits = aad.len() as i64 * 8;
  let cbits = ct.len() as i64 * 8;
  let k = 0;
  while (k < 8) {
    lens = lens.with(7 - k, (abits >> (8 * k) as i64 & 255) as u8);
    lens = lens.with(15 - k, (cbits >> (8 * k) as i64 & 255) as u8);
    k += 1;
  }
  let tag = ctr32(rk, j0, ghash(h, y, lens));
  let all = __alloc_u8(out.len() + 16);
  k = 0;
  while (k < out.len()) {
    all = all.with(k, out[k]);
    k += 1;
  }
  k = 0;
  while (k < 16) {
    all = all.with(out.len() + k, tag[k]);
    k += 1;
  }
  return all;
}
