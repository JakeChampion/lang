// aesref — the interpreter's AES-GCM kernels, `__aes_expand_key`,
// `__aes_ctr32` and `__ghash`, spelled from their definitions: FIPS-197's key
// schedule and cipher over an S-box computed from the field inverse, and SP
// 800-38D's bit-at-a-time GHASH. The compiled backends answer to these.
// Nothing here is constant time; the interpreter is not under the gate.

// gf_mul multiplies in GF(2^8) modulo x^8 + x^4 + x^3 + x + 1.
function gf_mul(a: i32, b: i32): i32 {
  let p: i32 = 0;
  let x: i32 = a;
  let y: i32 = b;
  while (y != 0) {
    if ((y & 1) != 0) {
      p = p ^ x;
    }
    x = x << 1;
    if ((x & 256) != 0) {
      x = x ^ 283;
    }
    y = y >> 1;
  }
  return p;
}

function rotl8(x: i32, k: i32): i32 {
  return (x << k | x >> 8 - k) & 255;
}

// sbox_byte is FIPS-197 §5.1.1: the inverse (0 for 0), then the affine map.
function sbox_byte(x: i32): i32 {
  let inv: i32 = 0;
  if (x != 0) {
    inv = 1;
    let k: i32 = 0;
    while (k < 254) {
      inv = gf_mul(inv, x);
      k = k + 1;
    }
  }
  return inv ^ rotl8(inv, 1) ^ rotl8(inv, 2) ^ rotl8(inv, 3) ^ rotl8(inv, 4) ^ 99;
}

function sbox_table(): i32[] {
  let t: i32[] = [];
  let x: i32 = 0;
  while (x < 256) {
    t = t.append(sbox_byte(x));
    x = x + 1;
  }
  return t;
}

// sub_rot_word is the schedule's temp for word i: SubWord, after RotWord
// with the round constant when `rot`.
function sub_rot_word(w: u8[], at: i32, sb: i32[], rot: boolean, rcon: i32): u8[] {
  let out: u8[] = __alloc_u8(4);
  let k: i32 = 0;
  while (k < 4) {
    let src: i32 = k;
    if (rot) {
      src = k + 1 & 3;
    }
    out = out.with(k, sb[w[at + src] as i32] as u8);
    k = k + 1;
  }
  if (rot) {
    out = out.with(0, out[0] ^ rcon as u8);
  }
  return out;
}

// expand_key is FIPS-197 §5.2 for a 16- or 32-byte key, empty for any other.
pub function expand_key(key: u8[]): u8[] {
  let nk: i32 = key.len() / 4;
  if (key.len() != 16 && key.len() != 32) {
    return __alloc_u8(0);
  }
  let total: i32 = 16 * (nk + 7);
  let sb: i32[] = sbox_table();
  let w: u8[] = __alloc_u8(total);
  let i: i32 = 0;
  while (i < key.len()) {
    w = w.with(i, key[i]);
    i = i + 1;
  }
  let rcon: i32 = 1;
  let word: i32 = nk;
  while (word * 4 < total) {
    let t: u8[] = sub_rot_word(w, 4 * word - 4, sb, word % nk == 0, rcon);
    if (word % nk == 0) {
      rcon = gf_mul(rcon, 2);
    } else {
      if (nk != 8 || word % nk != 4) {
        t = word_at(w, 4 * word - 4);
      }
    }
    let k: i32 = 0;
    while (k < 4) {
      w = w.with(4 * word + k, w[4 * (word - nk) + k] ^ t[k]);
      k = k + 1;
    }
    word = word + 1;
  }
  return w;
}

function word_at(w: u8[], at: i32): u8[] {
  let out: u8[] = __alloc_u8(4);
  let k: i32 = 0;
  while (k < 4) {
    out = out.with(k, w[at + k]);
    k = k + 1;
  }
  return out;
}

// cipher_round is one round on the column-major state: SubBytes,
// ShiftRows, MixColumns unless `last`, then AddRoundKey.
function cipher_round(st: u8[], rk: u8[], at: i32, sb: i32[], last: boolean): u8[] {
  let out: u8[] = __alloc_u8(16);
  let c: i32 = 0;
  while (c < 4) {
    let a0: i32 = sb[st[4 * c] as i32];
    let a1: i32 = sb[st[4 * (c + 1 & 3) + 1] as i32];
    let a2: i32 = sb[st[4 * (c + 2 & 3) + 2] as i32];
    let a3: i32 = sb[st[4 * (c + 3 & 3) + 3] as i32];
    let m: i32[] = [a0, a1, a2, a3];
    if (!last) {
      m = mix_column(a0, a1, a2, a3);
    }
    let r: i32 = 0;
    while (r < 4) {
      out = out.with(4 * c + r, m[r] as u8 ^ rk[at + 4 * c + r]);
      r = r + 1;
    }
    c = c + 1;
  }
  return out;
}

function mix_column(a0: i32, a1: i32, a2: i32, a3: i32): i32[] {
  return [
    gf_mul(a0, 2) ^ gf_mul(a1, 3) ^ a2 ^ a3,
    a0 ^ gf_mul(a1, 2) ^ gf_mul(a2, 3) ^ a3,
    a0 ^ a1 ^ gf_mul(a2, 2) ^ gf_mul(a3, 3),
    gf_mul(a0, 3) ^ a1 ^ a2 ^ gf_mul(a3, 2),
  ];
}

function encrypt_block(rk: u8[], rounds: i32, block: u8[], sb: i32[]): u8[] {
  let st: u8[] = __alloc_u8(16);
  let i: i32 = 0;
  while (i < 16) {
    st = st.with(i, block[i] ^ rk[i]);
    i = i + 1;
  }
  let r: i32 = 1;
  while (r <= rounds) {
    st = cipher_round(st, rk, 16 * r, sb, r == rounds);
    r = r + 1;
  }
  return st;
}

// inc32 steps the counter block's last four bytes as a big-endian u32.
function inc32(cb: u8[]): u8[] {
  let k: i32 = 15;
  let carry: boolean = true;
  while (k >= 12 && carry) {
    let v: i32 = cb[k] as i32 + 1;
    cb = cb.with(k, (v & 255) as u8);
    carry = v > 255;
    k = k - 1;
  }
  return cb;
}

// ctr32 is data exclusive-ored with E(K, counter), E(K, counter + 1), ...;
// 240 round-key bytes select AES-256, 176 AES-128, and fewer, or a counter
// under 16 bytes, answer empty.
pub function ctr32(rk: u8[], counter: u8[], data: u8[]): u8[] {
  let rounds: i32 = 0;
  if (rk.len() >= 240) {
    rounds = 14;
  } else {
    if (rk.len() >= 176) {
      rounds = 10;
    }
  }
  if (rounds == 0 || counter.len() < 16) {
    return __alloc_u8(0);
  }
  let sb: i32[] = sbox_table();
  let cb: u8[] = block_at(counter, 0, 16);
  let out: u8[] = __alloc_u8(data.len());
  let at: i32 = 0;
  while (at < data.len()) {
    let ks: u8[] = encrypt_block(rk, rounds, cb, sb);
    let k: i32 = 0;
    while (k < 16 && at + k < data.len()) {
      out = out.with(at + k, data[at + k] ^ ks[k]);
      k = k + 1;
    }
    cb = inc32(cb);
    at = at + 16;
  }
  return out;
}

// block_at copies up to 16 bytes of src from `at`, zero-padded to 16.
function block_at(src: u8[], at: i32, n: i32): u8[] {
  let out: u8[] = __alloc_u8(16);
  let k: i32 = 0;
  while (k < n && at + k < src.len()) {
    out = out.with(k, src[at + k]);
    k = k + 1;
  }
  return out;
}

// gf128_mul is SP 800-38D Algorithm 1: x * y, bit 0 the most significant bit
// of byte 0.
function gf128_mul(x: u8[], y: u8[]): u8[] {
  let z: u8[] = __alloc_u8(16);
  let v: u8[] = block_at(y, 0, 16);
  let i: i32 = 0;
  while (i < 128) {
    if ((x[i / 8] as i32 >> 7 - i % 8 & 1) != 0) {
      let k: i32 = 0;
      while (k < 16) {
        z = z.with(k, z[k] ^ v[k]);
        k = k + 1;
      }
    }
    v = shift_right1(v);
    i = i + 1;
  }
  return z;
}

// shift_right1 is V >> 1 with the reduction by R = 0xe1 || 0^120.
function shift_right1(v: u8[]): u8[] {
  let lsb: i32 = v[15] as i32 & 1;
  let k: i32 = 15;
  while (k > 0) {
    v = v.with(k, ((v[k] as i32 >> 1 | v[k - 1] as i32 << 7) & 255) as u8);
    k = k - 1;
  }
  v = v.with(0, v[0] >> 1);
  if (lsb != 0) {
    v = v.with(0, v[0] ^ 225 as u8);
  }
  return v;
}

// ghash is y with each 16-byte block of data folded in under h, a short last
// block zero-padded; an h or y under 16 bytes answers empty.
pub function ghash(h: u8[], y: u8[], data: u8[]): u8[] {
  if (h.len() < 16 || y.len() < 16) {
    return __alloc_u8(0);
  }
  let acc: u8[] = block_at(y, 0, 16);
  let at: i32 = 0;
  while (at < data.len()) {
    let blk: u8[] = block_at(data, at, 16);
    let k: i32 = 0;
    while (k < 16) {
      acc = acc.with(k, acc[k] ^ blk[k]);
      k = k + 1;
    }
    acc = gf128_mul(acc, h);
    at = at + 16;
  }
  return acc;
}
