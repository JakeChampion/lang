  if (ins.str == "buf_clear") {
    return Lowered { found: true, r: emit(r, ir.op_buf_clear()) };
  }
  return Lowered { found: false, r: r };
}

// The runtime intrinsics: each is the stack IR op the AST lowering emits for
// the same call, so a contract here is only half the work — without the op the
// name reaches the backends as a direct call to a symbol no runtime defines.
function intrinsic_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  let kind: string = irtables.f64_math_builtin_kind(ins.str);
  if (kind != "") {
    return Lowered { found: true, r: emit(r, ir.op_funary(kind)) };
  }
  if (ins.str == "__pow_f64") {
    return Lowered { found: true, r: emit(r, ir.op_fbin("fpow")) };
  }
  let bits: Lowered = bit_count_site(r, ins);
  if (bits.found) {
    return bits;
  }
  r = bits.r;
  let mem: Lowered = raw_memory_site(r, ins);
  if (mem.found) {
    return mem;
  }
  r = mem.r;
  return byte_scan_site(r, ins);
}

// One op per operand width, the width carried by the op rather than the name.
function bit_count_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == "__clz32") {
    return Lowered { found: true, r: emit(r, ir.op_clz(32)) };
  }
  if (ins.str == "__ctz32") {
    return Lowered { found: true, r: emit(r, ir.op_ctz(32)) };
  }
  if (ins.str == "__popcount32") {
    return Lowered { found: true, r: emit(r, ir.op_popcount(32)) };
  }
  if (ins.str == "__clz64") {
    return Lowered { found: true, r: emit(r, ir.op_clz(64)) };
  }
  if (ins.str == "__ctz64") {
    return Lowered { found: true, r: emit(r, ir.op_ctz(64)) };
  }
  if (ins.str == "__popcount64") {
    return Lowered { found: true, r: emit(r, ir.op_popcount(64)) };
  }
  return Lowered { found: false, r: r };
}

// __fern_str_dec(s): core/map releases one unit of a string it holds, which
// is what __fern_str_free does to the box. Its dummy result is the store's.
function str_release(own r: irtables.LowerResult): irtables.LowerResult {
  return emit(r, ir.op_call_direct("__fern_str_free", 1));
}

function no_op_release(own r: irtables.LowerResult, operands: i32): irtables.LowerResult {
  let i: i32 = 0;
  while (i < operands) {
    r = emit(r, ir.op_drop());
    i = i + 1;
  }
  return emit(r, ir.op_const_i32(0));
}

// __fern_box_free(data, size): the raw free of the rc'd block that starts 8
// bytes before `data` and is `size + 8` long.
function box_free(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  r = emit(r, ir.op_drop());
  r = emit(r, ir.op_drop());
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_const_i32(8));
  r = emit(r, ir.op_bin("sub", 0, false));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.op_const_i32(8));
  r = emit(r, ir.op_bin("add", 0, false));
  return emit(r, ir.op_free());
}

// __store_u8(addr, v): the raw byte store at a constant zero offset. Its
// offset sits between the two operands, so they are re-read round it.
function store_u8(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  r = emit(r, ir.op_drop());
  r = emit(r, ir.op_drop());
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_load_local(ins.args[1]));
  return emit(r, ir.op_raw_store8());
}

// __str_bytes(s, scratch): the address of the string's bytes, as __raw_data
// reads it. A self-host string is never inline, so the scratch operand is
// dropped unread.
function str_bytes(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  r = emit(r, ir.op_drop());
  r = emit(r, ir.op_drop());
  r = emit(r, ir.op_load_local(ins.args[0]));
  return emit(r, ir.op_str_data());
}

// __arr_set_len(a, n): the length is slot 0 of the box.
function arr_set_len(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  r = emit(r, ir.op_drop());
  r = emit(r, ir.op_drop());
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_load_local(ins.args[1]));
  return emit(r, ir.op_raw_store_ptr());
}

function word_bytes(name: string): i32 {
  if (name == ssabytes.word_name(8)) {
    return 8;
  }
  return 4;
}

// The raw-memory escape hatches. The byte load has no op of its own: it is the
// two-operand raw load at a constant zero offset, which is also what keeps the
// address at full pointer width.
function raw_memory_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == ssabytes.word_name(4) || ins.str == ssabytes.word_name(8)) {
    return Lowered { found: true, r: emit(r, ssabytes.read_word(ins.args[0], word_bytes(ins.str))) };
  }
  if (ins.str == ssabytes.swap_name(4)) {
    return Lowered { found: true, r: emit(r, ir.op_bswap(32)) };
  }
  if (ins.str == ssabytes.swap_name(8)) {
    return Lowered { found: true, r: emit(r, ir.op_bswap(64)) };
  }
  if (ins.str == "__alloc") {
    return Lowered { found: true, r: emit(r, ir.op_alloc()) };
  }
  if (ins.str == "__alloc_u8") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_alloc_u8())) };
  }
  if (ins.str == "__alloc_i32") {
    return Lowered { found: true, r: emit(r, ir.op_alloc_slots(32)) };
  }
  if (ins.str == "__alloc_i64") {
    return Lowered { found: true, r: emit(r, ir.op_alloc_slots(64)) };
  }
  if (ins.str == "__alloc_bool") {
    return Lowered { found: true, r: emit(r, ir.op_alloc_slots(1)) };
  }
  if (ins.str == "__free") {
    return Lowered { found: true, r: emit(r, ir.op_free()) };
  }
  // The task primitives (docs/NET-P3-SUSPENSION-PLAN.md §3.4) are runtime
  // functions written in Fern, called with the user ABI under `__fern_`.
  if (util.str_has_prefix(ins.str, "__task_")) {
    return Lowered { found: true, r: emit(r, ir.op_call_direct("__fern_" + slice_unchecked(ins.str, 2, ins.str.len()), ins.args.len())) };
  }
  if (ins.str == "__fern_box_free") {
    return Lowered { found: true, r: box_free(r, ins) };
  }
  if (ins.str == "__ptr_width") {
    return Lowered { found: true, r: emit(r, ir.op_ptr_width()) };
  }
  if (ins.str == "__map_hash_seed") {
    return Lowered { found: true, r: emit(r, ir.op_map_hash_seed()) };
  }
  // core/map's array-value releases stay no-ops: the
  // lent operands are dropped, nothing is released, and the dummy 0 a void
  // call leaves is pushed. No routed map has an array column.
  if (ins.str == "__fern_str_dec") {
    return Lowered { found: true, r: str_release(r) };
  }
  if (ins.str == "__fern_drop_arr_ptr" || ins.str == "__fern_arr_dec") {
    return Lowered { found: true, r: no_op_release(r, 2) };
  }
  if (ins.str == "__heap_bump_bytes") {
    return Lowered { found: true, r: emit(r, ir.op_heap_bump_bytes()) };
  }
  if (ins.str == "__heap_alloc_count") {
    return Lowered { found: true, r: emit(r, ir.op_heap_alloc_count()) };
  }
  if (ins.str == "__heap_mark") {
    return Lowered { found: true, r: emit(r, ir.op_heap_mark()) };
  }
  if (ins.str == "__heap_release_to") {
    return Lowered { found: true, r: emit(r, ir.op_heap_release_to()) };
  }
  if (ins.str == "__memcpy") {
    return Lowered { found: true, r: emit(r, ir.op_memcpy()) };
  }
  if (ins.str == "__memset") {
    return Lowered { found: true, r: emit(r, ir.op_memset()) };
  }
  if (ins.str == "__load_u8") {
    r = emit(r, ir.op_const_i32(0));
    return Lowered { found: true, r: emit(r, ir.op_raw_load8()) };
  }
  if (ins.str == "__load_i32") {
    return Lowered { found: true, r: emit(r, ir.op_load_i32()) };
  }
  if (ins.str == "__load_i64") {
    return Lowered { found: true, r: emit(r, ir.op_load_i64()) };
  }
  if (ins.str == "__load_ptr") {
    return Lowered { found: true, r: emit(r, ir.op_load_ptr()) };
  }
  if (ins.str == "__store_u8") {
    return Lowered { found: true, r: store_u8(r, ins) };
  }
  if (ins.str == "__str_bytes") {
    return Lowered { found: true, r: str_bytes(r, ins) };
  }
  if (ins.str == "__arr_set_len") {
    return Lowered { found: true, r: arr_set_len(r, ins) };
  }
  if (ins.str == "__store_i32") {
    return Lowered { found: true, r: emit(r, ir.op_store_i32()) };
  }
  if (ins.str == "__store_i64") {
    return Lowered { found: true, r: emit(r, ir.op_store_i64()) };
  }
  if (ins.str == "__store_ptr") {
    return Lowered { found: true, r: emit(r, ir.op_store_ptr()) };
  }
  return raw_floor_site(r, ins);
}

// The floor the runtime helpers are written on, and the two rc test hooks:
// the ops the lowering emits for each. `__raw_array` and `__raw_arr_ptr` emit
// nothing: the address already is the array.
struct RawOps { name: string, ops: ir.Op[] }

function raw_floor_ops(): RawOps[] {
  return [
    RawOps { name: "__raw_alloc", ops: [ir.op_raw_alloc()] },
    RawOps { name: "__raw_store8", ops: [ir.op_raw_store8()] },
    RawOps { name: "__raw_load8", ops: [ir.op_raw_load8()] },
    RawOps { name: "__raw_store_ptr", ops: [ir.op_raw_store_ptr()] },
    RawOps { name: "__raw_load_ptr", ops: [ir.op_raw_load_ptr()] },
    RawOps { name: "__raw_string", ops: [ir.op_raw_string()] },
    RawOps { name: "__raw_array", ops: [] },
    RawOps { name: "__raw_arr_ptr", ops: [] },
    RawOps { name: "__raw_data", ops: [ir.op_str_data()] },
    RawOps { name: "__raw_addr", ops: [ir.op_raw_addr()] },
    RawOps { name: "__raw_arr_box", ops: [ir.op_raw_arr_box()] },
    RawOps { name: "__raw_scratch", ops: [ir.op_raw_scratch()] },
    RawOps { name: "__raw_environ", ops: [ir.op_raw_environ()] },
    RawOps { name: "__raw_splice_pipe", ops: [ir.op_raw_splice_pipe()] },
    RawOps { name: "__raw_cover", ops: [ir.op_raw_cover()] },
    RawOps { name: "__raw_task_state", ops: [ir.op_raw_task_state()] },
    RawOps { name: "__raw_call1", ops: [ir.op_call_indirect(1)] },
    RawOps { name: "__raw_call2", ops: [ir.op_call_indirect(2)] },
    RawOps { name: "__syscall3", ops: [ir.op_syscall3()] },
    RawOps { name: "__syscall4", ops: [ir.op_syscall4()] },
    RawOps { name: "__syscall5", ops: [ir.op_syscall5()] },
    RawOps { name: "__syscall6", ops: [ir.op_syscall6()] },
    RawOps { name: "__raw_vg_request", ops: [ir.op_vg_request()] },
    RawOps { name: "__rc_dec", ops: [ir.op_call_direct("__fern_rc_dec", 1)] },
    RawOps { name: "__rc_inc", ops: [ir.op_call_direct("__fern_rc_inc", 1)] },
  ];
}

function raw_floor_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (!util.str_has_prefix(ins.str, "__raw_") && !util.str_has_prefix(ins.str, "__syscall") && !util.str_has_prefix(ins.str, "__rc_")) {
    return Lowered { found: false, r: r };
  }
  for row in raw_floor_ops() {
    if (row.name == ins.str) {
      for op in row.ops {
        r = emit(r, op);
      }
      return Lowered { found: true, r: r };
    }
  }
  return Lowered { found: false, r: r };
}

// The byte scans over a lent string.
function byte_scan_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == "__inner_mul_add_f64") {
    return Lowered { found: true, r: emit(r, ir.op_inner_mul_add_f64()) };
  }
  if (ins.str == "__outer_mul_f64") {
    return Lowered { found: true, r: emit(r, ir.op_outer_mul_f64()) };
  }
  if (ins.str == "__aes_expand_key") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_aes_expand_key())) };
  }
  if (ins.str == "__aes_ctr32") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_aes_ctr32())) };
  }
  if (ins.str == "__ghash") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_ghash())) };
  }
  if (ins.str == "__sha256_hw") {
    return Lowered { found: true, r: emit(r, ir.op_sha256_hw()) };
  }
  if (ins.str == "__sha256_hw_blocks") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_sha256_hw_blocks())) };
  }
  if (ins.str == "__sum_bytes") {
    return Lowered { found: true, r: emit(r, ir.op_sum_bytes()) };
  }
  if (ins.str == "__scale_f64") {
    return Lowered { found: true, r: emit(r, ir.op_scale_f64()) };
  }
  if (ins.str == "__crc32_cksum") {
    return Lowered { found: true, r: emit(r, ir.op_crc32_cksum()) };
  }
  if (ins.str == "__crc32_cksum_array") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_crc32_cksum_array())) };
  }
  if (ins.str == "__ascii_run") {
    return Lowered { found: true, r: emit(r, ir.op_ascii_run()) };
  }
  if (ins.str == "__scan_set") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_scan_set())) };
  }
  if (ins.str == "__scan_set_bytes") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_scan_set_bytes())) };
  }
  if (ins.str == "__count_runs") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_count_runs())) };
  }
  if (ins.str == "__count_runs_bytes") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_count_runs_bytes())) };
  }
  if (ins.str == "__bsd_sum") {
    return Lowered { found: true, r: emit(r, ir.op_bsd_sum()) };
  }
  if (ins.str == "__str_hash") {
    return Lowered { found: true, r: emit(r, ir.op_str_hash()) };
  }
  if (ins.str == "__count_byte") {
    return Lowered { found: true, r: emit(r, ir.op_count_byte()) };
  }
  if (ins.str == "__rmemchr") {
    return Lowered { found: true, r: emit(r, ir.op_rmemchr()) };
  }
  if (ins.str == "__mismatch") {
    return Lowered { found: true, r: emit(r, ir.op_mismatch()) };
  }
  if (ins.str == "__mismatch_bytes") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_mismatch_bytes())) };
  }
  return Lowered { found: false, r: r };
}

// The string methods the AST lowering emits an op for, keyed by receiver the
// way their contracts are.
function string_method_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == "string.to_ascii_upper") {
    return Lowered { found: true, r: emit(r, ir.op_str_to_upper()) };
  }
  if (ins.str == "string.to_ascii_lower") {
    return Lowered { found: true, r: emit(r, ir.op_str_to_lower()) };
  }
  if (ins.str == "string.trim") {
    return Lowered { found: true, r: emit(r, ir.op_str_trim()) };
  }
  if (ins.str == "string.lines") {
    return Lowered { found: true, r: emit(r, ir.op_str_lines()) };
  }
  if (ins.str == "string.split") {
    return Lowered { found: true, r: emit(r, ir.op_str_split()) };
  }
  if (ins.str == "string.repeat") {
    return Lowered { found: true, r: emit(r, ir.op_str_repeat()) };
  }
  if (ins.str == "string.replace") {
    return Lowered { found: true, r: emit(r, ir.op_str_replace()) };
  }
  return Lowered { found: false, r: r };
}

// A call of the string-equality runtime helper by name is the op that
// helper backs.
function runtime_helper_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == "__fern_str_eq") {
    return Lowered { found: true, r: emit(r, ir.op_str_eq()) };
  }
  return Lowered { found: false, r: r };
}

// A name no half owns is a runtime helper with a symbol of its own, which a
// direct call reaches.
function builtin_site(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  let done: Lowered = handle_site(r, ins);
  if (!done.found) {
    r = done.r;
    done = union_builtin_site(r, ins);
  }
  if (!done.found) {
    r = done.r;
    done = value_builtin_site(r, ins);
  }
  if (!done.found) {
    r = done.r;
    done = intrinsic_site(r, ins);
  }
  if (!done.found) {
    r = done.r;
    done = string_method_site(r, ins);
  }
  if (!done.found) {
    r = done.r;
    done = runtime_helper_site(r, ins);
  }
  if (done.found) {
    return done.r;
  }
  r = done.r;
  return emit(r, ir.op_call_direct(ins.str, ins.args.len()));
}

function block_body(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, idx: i32[][], links: i32[], b: ssa.SBlock, structs: irtables.StructTab, grows: ssaunits.GrowTable, no_reuse: boolean, uses: i32[], maps: boolean[], carry: Carry): irtables.LowerResult {
  r = drops(r, at(p, idx, b.id, ssaunits.entry_point(), 0 - 1), f, links);
  let pos: i32 = 0;
  let pairs: ReusePairs = reuse_pairs(f, p, idx, b, no_reuse, carry);
  let keeps: Keeps = block_keeps(f, p, idx, b, pairs, uses);
  let kept: i32[] = kept_values(keeps);
  let late: i32[] = late_values(keeps);
  for ins in b.insts {
    if (ins.kind_tag != 6 && ins.kind_tag != 8) {
      let step: ssaunits.Step = at(p, idx, b.id, pos, 0 - 1);
      let held: Held = bracketed(f, step, ins, grows);
      // One answer for both: the retain `supplies` holds back is the one
      // `instruction` then takes, and two calls could drift apart with
      // nothing to catch it.
      let defer0: boolean = deferred_retain(f, p, step, ins);
      let k: i32 = util.index_of_i32(keeps.start, pos);
      if (k >= 0) {
        r = keep_token(r, f, keeps.donors[k]);
      }
      r = supplies(r, f, p, step, defer0, kept, late);
      r = bracket_take(r, f, held);
      // A box superseded by the construction at this same instruction is
      // taken BEFORE it, where an earlier drop's token was taken at the
      // drop and is already in the slot. Either way `reuse_construct`
      // reads one token slot and the runtime decides. A kept donor's token
      // was taken at its first kept read, and its drop is the
      // construction's.
      let kb: i32 = util.index_of_i32(keeps.built, pos);
      if (pairs.selfs[pos] >= 0 && kb < 0) {
        r = reuse_token(r, f, pairs.selfs[pos]);
      }
      if (pairs.builds[pos] >= 0 || pairs.selfs[pos] >= 0) {
        r = reuse_construct(r, f, ins, keeps, kb);
      } else if (ins.result >= 0 && maps[ins.result]) {
        r = map_in_place(r, f, ins);
        step = ssaunits.Step { ...step, drops: without(step.drops, ins.args[0]) };
      } else if (util.index_of_i32(late, ins.result) < 0) {
        r = instruction(r, f, p, ins, structs, defer0, link_at(f, links, ins), util.index_of_i32(kept, ins.result) >= 0);
        r = settle_call_link(r, f, links, ins);
      }
      r = bracket_give(r, f, held);
      if (pairs.tokens[pos] >= 0 && !token_kept(keeps, pos)) {
        r = reuse_token(r, f, pairs.tokens[pos]);
      }
      r = drops_less(r, step, f, links, pairs.tokens[pos], pairs.selfs[pos], carry_held(carry, b.id, pos), ssaunits.shell_root(f, p, ins));
    }
    pos = pos + 1;
  }
  return r;
}

// Open stack-IR labels, innermost last: the first `depth` entries of
// `labels`, the rest left from scopes already closed. A label is the layout
// index control reaches by branching to it: a `block` ends before that
// index, a `loop` starts at it. An `if` arm is a label of its own that no
// branch targets.
// `steps` is the plan's step index (ssaunits.step_index).
// no_reuse is the #4350 §6.5 differential switch, which the AST path's reuse
// layer answers too: with it set every construction allocates, so a program's
// observable behaviour can be compared against its own reusing build.
// `at` is each block's position in the block list and `ranks` its position in
// the layout order, both by id.
struct Emit { r: irtables.LowerResult, labels: i32[], depth: i32, why: string, steps: i32[][], links: i32[], no_reuse: boolean, uses: i32[], maps: boolean[], carry: Carry, at: i32[], ranks: i32[] }

function label_if(): i32 {
  return 0 - 1;
}

function push(own e: Emit, op: ir.Op, label: i32): Emit {
  if (e.depth < e.labels.len()) {
    return Emit { ...e, r: emit(e.r, op), labels: e.labels.with(e.depth, label), depth: e.depth + 1 };
  }
  return Emit { ...e, r: emit(e.r, op), labels: e.labels.append(label), depth: e.depth + 1 };
}

function pop(own e: Emit): Emit {
  return Emit { ...e, r: emit(e.r, ir.op_end()), depth: e.depth - 1 };
}

// A branch target without an open label is a layout defect; refuse the
// function rather than emit a depth the backends would fault on.
function depth(e: Emit, target: i32): i32 {
  let i: i32 = e.depth - 1;
  while (i >= 0 && e.labels[i] != target) {
    i = i - 1;
  }
  if (i < 0) {
    return 0 - 1;
  }
  return e.depth - 1 - i;
}

// Each block's first position in `order`, by id, or -1 for one not in it.
function order_ranks(f: ssa.SFunc, order: i32[], ids: i32): i32[] {
  let out: i32[] = [];
  while (out.len() < ids) {
    out = out.append(0 - 1);
  }
  let i: i32 = order.len() - 1;
  while (i >= 0) {
    out = out.with(f.blocks[order[i]].id, i);
    i = i - 1;
  }
  return out;
}

function jump(own e: Emit, f: ssasem.Func, p: ssaunits.Plan, order: i32[], position: i32, target: i32): Emit {
  let from: i32 = f.graph.blocks[order[position]].id;
  // A donor dropped here may be the target's phi, which the edge overwrites.
  for left in carry_exits(e.carry, from, target) {
    e = Emit { ...e, r: drop_linked(e.r, left, e.links, f) };
  }
  e = Emit { ...e, r: edge(e.r, f, p, e.steps, e.links, from, target, e.at[target]) };
  let dest: i32 = e.ranks[target];
  if (dest == position + 1) {
    return e;
  }
  let d: i32 = depth(e, dest);
  if (d < 0) {
    return Emit { ...e, why: "branch target has no open label" };
  }
  return Emit { ...e, r: emit(e.r, ir.op_br(d)) };
}

function terminator(own e: Emit, f: ssasem.Func, p: ssaunits.Plan, order: i32[], position: i32): Emit {
  let b: ssa.SBlock = f.graph.blocks[order[position]];
  if (b.term.kind_tag == 1 || b.term.kind_tag == 4) {
    let ret: ssaunits.Step = at(p, e.steps, b.id, ssaunits.return_point(), 0 - 1);
    e = Emit { ...e, r: supplies(e.r, f, p, ret, false, [], []) };
    if (b.term.kind_tag == 1 && b.term.value >= 0 && e.links[b.term.value] >= 0) {
      e = Emit { ...e, r: take_owed(e.r, b.term.value, e.links[b.term.value]) };
    }
    e = Emit { ...e, r: drops(e.r, ret, f, e.links) };
    // The unreachable end aborts as a failed bounds check does, then
    // returns a zero the abort never lets the stack shape reach.
    if (b.term.kind_tag == 4) {
      e = Emit { ...e, r: emit(e.r, ir.op_const_i32(134)) };
      e = Emit { ...e, r: emit(e.r, ir.op_exit()) };
    }
    let payload: i32 = pair_payload(b);
    if (payload == 0 - 2) {
      return Emit { ...e, why: "a paired return sets its word twice" };
    }
    if (b.term.kind_tag == 1 && payload >= 0) {
      e = Emit { ...e, r: emit(e.r, ir.op_load_local(payload)) };
      e = Emit { ...e, r: emit(e.r, ir.op_ret_word()) };
      e = Emit { ...e, r: emit(e.r, ir.op_drop()) };
    }
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      e = Emit { ...e, r: emit(e.r, ir.op_load_local(b.term.value)) };
    } else {
      e = Emit { ...e, r: emit(e.r, zero(f.result)) };
    }
    return Emit { ...e, r: emit(e.r, ir.op_return()) };
  }
  if (b.term.kind_tag == 2) {
    return jump(e, f, p, order, position, b.term.target);
  }
  if (b.term.t == b.term.f) {
    return jump(e, f, p, order, position, b.term.t);
  }
  e = Emit { ...e, r: emit(e.r, ir.op_load_local(b.term.cond)) };
  e = push(e, ir.op_if(0), label_if());
  e = jump(e, f, p, order, position, b.term.t);
  e = Emit { ...e, r: emit(e.r, ir.op_else()) };
  e = jump(e, f, p, order, position, b.term.f);
  return pop(e);
}

// Blocks inside an inner loop get their labels when that loop is entered,
// so a label never crosses the loop's own scope.
function inner(l: ssalayout.Layout, first: i32, last: i32, looping: boolean, at: i32): boolean {
  let i: i32 = first + 1;
  if (!looping) {
    i = first;
  }
  while (i <= last) {
    if (l.loop_end[i] >= 0 && at > i && at <= l.loop_end[i]) {
      return true;
    }
    if (l.loop_end[i] >= 0) {
      i = l.loop_end[i] + 1;
    } else {
      i = i + 1;
    }
  }
  return false;
}

// Emit layout indices first..last. A looping region is one natural loop:
// its `loop` label opens first, then a `block` per position inside that no
// nested loop owns, each closed just before its position is reached.
function region(own e: Emit, f: ssasem.Func, p: ssaunits.Plan, l: ssalayout.Layout, first: i32, last: i32, looping: boolean, structs: irtables.StructTab, grows: ssaunits.GrowTable): Emit {
  if (looping) {
    e = push(e, ir.op_loop(0), first);
  }
  let target: i32 = last;
  while (target > first) {
    if (!inner(l, first, last, looping, target)) {
      e = push(e, ir.op_block(0), target);
    }
    target = target - 1;
  }
  let position: i32 = first;
  while (position <= last) {
    if (position > first) {
      e = pop(e);
    }
    if (l.loop_end[position] >= 0 && (position > first || !looping)) {
      e = region(e, f, p, l, position, l.loop_end[position], true, structs, grows);
      position = l.loop_end[position] + 1;
    } else {
      e = Emit { ...e, r: block_body(e.r, f, p, e.steps, e.links, f.graph.blocks[l.order[position]], structs, grows, e.no_reuse, e.uses, e.maps, e.carry) };
      e = terminator(e, f, p, l.order, position);
      position = position + 1;
    }
  }
  if (looping) {
    e = pop(e);
  }
  return e;
}

function derives(a: ssasem.Analysis, v: i32, root: i32): boolean {
  if (v == root) {
    return true;
  }
  for dep in a.dependencies[v] {
    if (dep == root) {
      return true;
    }
  }
  return false;
}

function built_record(f: ssasem.Func, plan: ssaunits.Plan): boolean {
  if let typeinfo.TypeStruct(_) = f.result {
    return built_result(f, plan);
  }
  return false;
}

// Every return hands back a record this body constructed, and nothing but a
// field read touches it on the way, so no other reference to the box exists.
function built_result(f: ssasem.Func, plan: ssaunits.Plan): boolean {
  if (!plan.ok) {
    return false;
  }
  let boxes: i32[] = returned_records(f);
  if (boxes.len() == 0) {
    return false;
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if (!box_use_ok(ins, boxes)) {
        return false;
      }
    }
  }
  for step in plan.steps {
    for item in step.supplies {
      if (item.mode == ssaunits.retain_unit() && util.index_of_i32(boxes, item.value) >= 0) {
        return false;
      }
    }
  }
  return true;
}

// The returned values and every copy or phi operand they merge, or nothing
// when one of them is defined by anything but a record construction.
function returned_records(f: ssasem.Func): i32[] {
  let out: i32[] = [];
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1 && b.term.value >= 0 && util.index_of_i32(out, b.term.value) < 0) {
      out = out.append(b.term.value);
    }
  }
  let at: i32 = 0;
  while (at < out.len()) {
    let def: ssa.SInst = defining(f, out[at]);
    if (def.kind_tag == 7 || def.kind_tag == 8) {
      for arg in def.args {
        if (util.index_of_i32(out, arg) < 0) {
          out = out.append(arg);
        }
      }
    } else if (def.kind_tag != ssasem.record_new()) {
      return [];
    }
    at = at + 1;
  }
  return out;
}

function defining(f: ssasem.Func, v: i32): ssa.SInst {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result == v) {
        return ins;
      }
    }
  }
  return ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
}

// A field read, or a copy or phi that stays inside the returned set.
function box_use_ok(ins: ssa.SInst, boxes: i32[]): boolean {
  if (ins.kind_tag == ssasem.record_get()) {
    return true;
  }
  if ((ins.kind_tag == 7 || ins.kind_tag == 8) && util.index_of_i32(boxes, ins.result) >= 0) {
    return true;
  }
  for arg in ins.args {
    if (util.index_of_i32(boxes, arg) >= 0) {
      return false;
    }
  }
  return true;
}

// A frame view's three words sit above every other slot, which is only known
// once the body is lowered, so `instruction` marks the op and this gives each
// its own words.
function place_views(own r: irtables.LowerResult): irtables.LowerResult {
  let ops: ir.Op[] = r.ops;
  let next: i32 = r.n_locals;
  let k_str_slice: i32 = ir.kind_id("str_slice");
  let i: i32 = 0;
  while (i < ops.len()) {
    if (ops[i].kind_tag == k_str_slice && ops[i].i32_imm > 0) {
      ops = ops.with(i, ir.op_str_slice_frame(next));
      next = next + 3;
    }
    i = i + 1;
  }
  return irtables.LowerResult { ...r, ops: ops, n_locals: next };
}

// `structs` is the declaration table the backends read a construction's field
// store widths from; the physical lowering names a declaration by index, as
// the AST lowering does.
//
// `grows` is the module's table of callee positions whose buffers a produced
// callee may grow in place (ssaunits.grow_rows over every produced plan), read
// by the caller-side bracket.
// `pure` names the module's functions that reach no observable effect
// (semlower.pure_rows), the element functions the in-place map may run.
// `susp` names the module's suspendable rows (suspend.classify); one of them
// is rewritten to its resumable form before the peepholes.
pub function lower(f: ssasem.Func, modes: i32[], p: ssaunits.Plan, structs: irtables.StructTab, grows: ssaunits.GrowTable, pure: util.NameIndex, view: ssaunits.SchemaView, susp: suspend.Set): irtables.LowerResult {
  let why: string = validate(f, modes, p, structs, view);
  if (why != "") {
    return empty(why);
  }
  let layout: ssalayout.Layout = ssalayout.compute(f.graph);
  if (!layout.ok) {
    return empty("physical RC needs reducible graph");
  }
  let steps: i32[][] = ssaunits.step_index(p);
  let links: i32[] = links_of(f, p, steps);
  let no_reuse: boolean = irtables.reuse_layer_disabled();
  let maps: boolean[] = in_place_maps(f, modes, p, steps, links, pure, no_reuse);
  let at: i32[] = ssa.block_positions(f.graph);
  let ranks: i32[] = order_ranks(f.graph, layout.order, at.len());
  let e: Emit = region(Emit { r: frame(f), labels: [], depth: 0, why: "", steps: steps, links: links, no_reuse: no_reuse, uses: use_counts(f), maps: maps, carry: carried_pairs(f, p, steps, links, no_reuse), at: at, ranks: ranks }, f, p, layout, 0, layout.order.len() - 1, false, structs, grows);
  if (e.why != "") {
    return empty(e.why);
  }
  e = Emit { ...e, r: aligned_rc(e.r, f) };
  e = Emit { ...e, r: ssabytes.lower_reads(e.r) };
  e = Emit { ...e, r: place_views(e.r) };
  if (susp.on && susp.rows.has(f.graph.name)) {
    suspend.dump_if_asked(e.r, "before");
    e = Emit { ...e, r: suspend.transform(e.r, susp) };
    suspend.dump_if_asked(e.r, "after");
    if (!e.r.ok) {
      return e.r;
    }
  }
  let optimized: ir.OptimizedOps = ir.optimize_ops(e.r.ops, e.r.n_params, e.r.n_locals);
  return irtables.LowerResult { ...e.r, ops: optimized.ops, n_locals: optimized.n_locals };
}

// A typed reference other than [u8] cannot carry its descriptor tag. Keep
// that proof on direct value loads so native RC need not mask every ordinary
// string, array and record. Raw pointers and scratch slots remain generic.
// i64_imm == 4 on these two calls is an optional alignment proof; consumers
// that do not use it retain the fully general runtime behavior.
function aligned_rc(own r: irtables.LowerResult, f: ssasem.Func): irtables.LowerResult {
  let call_direct: i32 = ir.kind_id("call_direct");
  let load_local: i32 = ir.kind_id("load_local");
  let ops: ir.Op[] = r.ops;
  let i: i32 = 1;
  while (i < ops.len()) {
    let op: ir.Op = ops[i];
    let before: ir.Op = ops[i - 1];
    if (op.kind_tag == call_direct && op.i32_imm == 1
      && (op.str == "__fern_rc_inc" || op.str == "__fern_rc_is_unique")
      && before.kind_tag == load_local && before.i32_imm < f.values.len()) {
      let t: typeinfo.Type = f.values[before.i32_imm];
      if (ssasem.reference(t) && !byte_view(t)) {
        ops = ops.with(i, ir.Op { ...op, i64_imm: 4 });
      }
    }
    i = i + 1;
  }
  return irtables.LowerResult { ...r, ops: ops };
}
