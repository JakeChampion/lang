// Verified semantic ownership to the production stack IR. No AST ownership
// facts or alternate backend ABI enter this boundary.
import "./ir";
import "./irtables";
import "./ssa";
import "./ssadeps";
import "./ssasem";
import "./ssalayout";
import "./ssaunits";
import "./ssabytes";
import "./suspend";
import "./semrecords";
import "./semtypes";
import "./typeinfo";
import "./util";
import "./semarrayreport";
import "./sempair";

function empty(why: string): irtables.LowerResult {
  return irtables.LowerResult {
    ok: false, why: why, ops: [], n_locals: 0,
    n_params: 0, erased_wide: false, superseded: false, arr_slots: [], i64_slots: [],
    f64_slots: [], str_slots: [], name: "", result_kind: irtables.result_i32(),
    dbg_slots: [], dbg_names: [], dbg_types: [],
  };
}

// This physical boundary refuses types whose stack representation is not
// implemented here, even when the unit planner knows their abstract
// ownership: the 32-bit float, and a record with no schema or with type
// arguments (its box is named by the bare declaration). The byte occupies the
// same i32-shaped slot as an i32, narrowed by the wrap below; the 64-bit
// integer and the f64 each get a slot of their own, which is a VALUE here, a
// declared field and an array element, but never a tuple element
// (narrow_slot). A string view is a value here, and an element or field of a
// container, whose drop releases it through the view's own release
// (release_name).
function supported_integer(i: typeinfo.TypeI32): boolean {
  return i.width == 32 || i.width == 8 && i.unsigned || i.width == 64 || i.width == typeinfo.width_ptr() && i.unsigned;
}

// A value that fits the ONE i32-shaped word an undeclared construction writes
// per operand. An array's element ops each carry their own width, a record or
// variant field stores at the width its declaration names, and a tuple
// construction names its element kinds (`op_tuple_make_k`), so none of the
// three has to narrow — a closure box still does.
function narrow_slot(t: typeinfo.Type): boolean {
  return !ssasem.is_wide(t) && !ssasem.is_float(t);
}

// The slot width an array's element ops carry: eight bytes for a 64-bit
// scalar, one byte for a u8, one i32-shaped word for everything else. Every
// backend packs a u8 array a byte an element (ir.packed); the register
// backends give every other element eight bytes.
// The `_i64` forms name the SLOT, not the sign, so an i64 and a u64 take the
// same ones; a float shares the width and differs in the load and store wasm
// selects, the f32 occupying the f64's slot.
function elem_width(t: typeinfo.Type): i32 {
  if (ssasem.is_wide(t) || ssasem.is_float(t)) {
    return 64;
  }
  if (ssasem.is_u8(t)) {
    return 8;
  }
  return 32;
}

function elem_type(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeArray(a) = t {
    return a.elem;
  }
  return typeinfo.unchecked();
}

function byte_view(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return a.view && ssasem.is_u8(a.elem);
  }
  return false;
}

function contains_byte_view(t: typeinfo.Type): boolean {
  if (byte_view(t)) {
    return true;
  }
  if let typeinfo.TypeArray(a) = t {
    return contains_byte_view(a.elem);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for elem in tup.elements {
      if (contains_byte_view(elem)) {
        return true;
      }
    }
  }
  if let typeinfo.TypeMap(m) = t {
    return contains_byte_view(m.key) || contains_byte_view(m.value);
  }
  if let typeinfo.TypeStruct(st) = t {
    for arg in st.args {
      if (contains_byte_view(arg)) {
        return true;
      }
    }
  }
  if let typeinfo.TypeUnion(u) = t {
    for arg in u.args {
      if (contains_byte_view(arg)) {
        return true;
      }
    }
  }
  return false;
}

function arr_make_op(elem: typeinfo.Type, n: i32): ir.Op {
  if (ssasem.is_wide(elem)) {
    return ir.op_arr_make_i64(n);
  }
  return ir.op_arr_make(n, elem_width(elem));
}

function arr_get_op(elem: typeinfo.Type, unchecked: boolean): ir.Op {
  if (ssasem.is_wide(elem) && unchecked) {
    return ir.op_arr_get_i64_nc();
  }
  if (ssasem.is_wide(elem)) {
    return ir.op_arr_get_i64();
  }
  if (unchecked) {
    return ir.op_arr_get_nc(elem_width(elem));
  }
  return ir.op_arr_get(elem_width(elem));
}

function arr_set_op(elem: typeinfo.Type): ir.Op {
  if (ssasem.is_wide(elem)) {
    return ir.op_arr_set_i64();
  }
  return ir.op_arr_set(elem_width(elem));
}

// The sole-owner push, which reclaims the superseded buffer when it grows.
function arr_push_op(elem: typeinfo.Type): ir.Op {
  if (ssasem.is_wide(elem)) {
    return ir.op_arr_push_owned_i64();
  }
  if (ssasem.is_float(elem)) {
    return ir.op_arr_push_owned_f64();
  }
  if (ssasem.is_u8(elem)) {
    return ir.packed(ir.op_arr_push_owned());
  }
  return ir.op_arr_push_owned();
}

// The push that does NOT consume its receiver, for the one case where the
// frame has not taken a unit yet: `deferred_retain` holds the receiver's
// retain back so the buffer can grow in place, and a consuming push would then
// free a buffer the caller still points at on a realloc.
function arr_push_borrowed_op(elem: typeinfo.Type): ir.Op {
  if (ssasem.is_wide(elem)) {
    return ir.op_arr_push_i64();
  }
  if (ssasem.is_float(elem)) {
    return ir.op_arr_push_f64();
  }
  if (ssasem.is_u8(elem)) {
    return ir.packed(ir.op_arr_push());
  }
  return ir.op_arr_push();
}

// The types whose stack representation needs no declaration looked up: a
// boolean and a void occupy one word, a string is its own box, a function
// value is the env box its captures are stored in, and a handle is the
// descriptor word. The handle is read here rather than under the nominal
// ladder below, which would look for a schema no handle has.
function supported_leaf(t: typeinfo.Type): boolean {
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  if let typeinfo.TypeVoid(_) = t {
    return true;
  }
  if let typeinfo.TypeString(_) = t {
    return true;
  }
  if let typeinfo.TypeFunc(_) = t {
    return true;
  }
  if let typeinfo.TypeDyn(_) = t {
    return true;
  }
  return semtypes.is_handle(t);
}

// A nominal box is named by a declaration this function's schema table carries,
// except a cell's: no declaration names it, and what it holds is one slot of
// its element.
function nominal_shape(t: typeinfo.Type, f: ssasem.Func, lookup: boolean): boolean {
  if (semtypes.is_cell(t)) {
    return walk_shape(semtypes.cell_elem(t), f, lookup);
  }
  // A map cursor has no record layout to find: its block is the map's address
  // and an index, and what it answers is the map's columns, so the two
  // element types are what has to be emittable.
  if (semtypes.is_map_iter(t)) {
    return walk_shape(semtypes.map_iter_key(t), f, lookup) && walk_shape(semtypes.map_iter_value(t), f, lookup);
  }
  if let typeinfo.TypeStruct(_) = t {
    return ssaunits.nominal(t, f, lookup);
  }
  if let typeinfo.TypeUnion(_) = t {
    return ssaunits.nominal(t, f, lookup);
  }
  return false;
}

function supported(t: typeinfo.Type, f: ssasem.Func): boolean {
  return rc_shape(t, f, true);
}

// rc_shape: whether `t` is a value of this physical vocabulary, its struct and
// union types looked up in f's table with `lookup` (ssaunits.nominal).
function rc_shape(t: typeinfo.Type, f: ssasem.Func, lookup: boolean): boolean {
  if (supported_leaf(t)) {
    return true;
  }
  if let typeinfo.TypeI32(i) = t {
    return supported_integer(i);
  }
  if let typeinfo.TypeFloat(_) = t {
    return ssasem.is_float(t);
  }
  if let typeinfo.TypeArray(a) = t {
    return rc_shape(a.elem, f, lookup);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      if (!rc_shape(e, f, lookup)) {
        return false;
      }
    }
    return true;
  }
  if (ssasem.is_map(t)) {
    return ssasem.is_supported_map(t);
  }
  return nominal_shape(t, f, lookup);
}

// A record cloned at a type variable is one declaration per binding, named
// by its arguments (semlower.instance_records).
function record_name(t: typeinfo.Type): string {
  if let typeinfo.TypeStruct(r) = t {
    if (semtypes.is_env(t)) {
      return r.name;
    }
    return ssasem.type_key(t);
  }
  return "";
}

function record_fields(t: typeinfo.Type, f: ssasem.Func): semrecords.Field[] {
  return f.records.list[semrecords.find(f.records, t)].fields;
}

function variants_of(t: typeinfo.Type, f: ssasem.Func): semrecords.Variant[] {
  return f.enums[semrecords.find_enum(f.enums, t)].variants;
}

function fields_have_children(fields: semrecords.Field[]): boolean {
  for field in fields {
    if (walked(field.ty)) {
      return true;
    }
  }
  return false;
}

// The field types a record's release walks — every reference, a function value
// included. That works from a frame that never built the box because
// `semsource.env_rows` pairs every environment a value of that type could
// carry with the type itself, and drop_captures matches on the body address at
// run time. A closure box's own captures are no exception since #9637: it
// takes a unit of each (ssaunits.taken), so walking them is what balances it.
// A routed map whose columns own what their slots name, released with the
// map: a string or view column's strings, and a wide column's cells.
function owned_columns(t: typeinfo.Type): boolean {
  let k: typeinfo.Type = ssasem.map_key(t);
  let v: typeinfo.Type = ssasem.map_value(t);
  return ssasem.is_text(k) || ssasem.is_text(v) || cell_column(k) || cell_column(v);
}

function walked(t: typeinfo.Type): boolean {
  return ssasem.reference(t);
}

// A string box is released by its own helper: its block starts before the
// value, where an array's starts before the data words.
// A view's box is this function's, but its bytes belong to the source.
// __fern_str_view_free frees the box alone when the rc is the immortal view
// sentinel and takes the ordinary path otherwise, which is what makes one
// release symbol correct on both the register backends and wasm (whose slices
// copy, so the result is an ordinary counted box).
// A map's helper releases one unit of a counted box: a decrement while the
// box is shared, and the columns and the block for the last unit.
function release_name(t: typeinfo.Type, f: ssasem.Func): string {
  if (byte_view(t)) {
    return ssabytes.release_name();
  }
  if (ssasem.is_view(t)) {
    return "__fern_str_view_free";
  }
  if (ssasem.is_string(t)) {
    return "__fern_str_free";
  }
  if (unlinked_map(t, f)) {
    return "__fern_rc_dec";
  }
  if (ssasem.is_map(t) && ssasem.keyed_map_key(ssasem.map_key(t))) {
    return "__map_drop_keyed_impl";
  }
  if (ssasem.is_map(t) && routed_box(ssasem.map_value(t))) {
    return "__map_drop_boxes_impl";
  }
  if (ssasem.is_map(t) && owned_columns(t)) {
    return "__map_drop_strcols_impl";
  }
  if (ssasem.is_map(t)) {
    return "__map_drop_impl";
  }
  if (semtypes.is_map_iter(t)) {
    return "__mapiter_drop_impl";
  }
  return "__fern_rc_dec";
}

// A map or cursor type in a program without core/map, which a field or a
// variant payload can name with no map operation anywhere (#10851). No such
// value can be built, so its release has only to link.
function unlinked_map(t: typeinfo.Type, f: ssasem.Func): boolean {
  return (ssasem.is_map(t) || semtypes.is_map_iter(t)) && !f.map_module;
}

// The one release of a unit in `slot`. A map with a keyed column hands its
// release the function that releases one key, and a map of boxes the one
// that releases one value — the key's first, the value's on top — so the
// runtime can walk a column whose shape it does not know.
function release(own r: irtables.LowerResult, slot: i32, t: typeinfo.Type, f: ssasem.Func): irtables.LowerResult {
  if (unlinked_map(t, f)) {
    return helper(r, slot, release_name(t, f));
  }
  if (ssasem.is_map(t) && ssasem.keyed_map_key(ssasem.map_key(t))) {
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_const_closure(env_release_name(ssasem.map_key(t))));
    r = emit(r, ir.op_const_closure(value_env_release(ssasem.map_value(t))));
    r = emit(r, ir.op_call_direct(release_name(t, f), 3));
    return emit(r, ir.op_drop());
  }
  if (ssasem.is_map(t) && routed_box(ssasem.map_value(t))) {
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_const_closure(env_release_name(ssasem.map_value(t))));
    r = emit(r, ir.op_call_direct(release_name(t, f), 2));
    return emit(r, ir.op_drop());
  }
  return helper(r, slot, release_name(t, f));
}

function emit(own r: irtables.LowerResult, op: ir.Op): irtables.LowerResult {
  return irtables.LowerResult { ...r, ops: r.ops.append(op) };
}

function helper(own r: irtables.LowerResult, slot: i32, name: string): irtables.LowerResult {
  r = emit(r, ir.op_load_local(slot));
  r = emit(r, ir.op_call_direct(name, 1));
  return emit(r, ir.op_drop());
}

// `defer0` holds an append's or a with's receiver's retain back, so the
// operation's own rc gate reads the box rather than this supply — see `deferred_retain` for why the
// order is the whole of it.
function supplies(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, step: ssaunits.Step, defer0: boolean, kept: i32[], late: i32[]): irtables.LowerResult {
  let j: i32 = 0;
  for supply in step.supplies {
    // A string literal's retain is the immortal guard's no-op; a late kept
    // read is retained where the construction copies it.
    if (supply.mode == ssaunits.retain_unit() && !(defer0 && supply.slot == 0) && !p.literal[supply.value]
      && util.index_of_i32(late, supply.value) < 0) {
      if (util.index_of_i32(kept, supply.value) >= 0) {
        r = unless_unique(r, token_slot(f), supply.value, "__fern_rc_inc");
      } else {
        r = helper(r, supply.value, "__fern_rc_inc");
      }
    }
    if (supply.mode == ssaunits.steal_unit()) {
      r = steal(r, f, supply.value, scratch_base(f) + j);
      j = j + 1;
    }
  }
  // A move transfers the existing unit. Value locals are never implicitly
  // swept, so neither a runtime decrement nor a clear is needed for a move.
  return r;
}

// The instruction that defines `v`.
function definition(f: ssasem.Func, v: i32): ssa.SInst {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result == v) {
        return ins;
      }
    }
  }
  return f.graph.blocks[0].insts[0];
}

// A stolen unit: when the box the value projects has no other holder, the
// slot is nulled and the value's unit is the taker's; otherwise the value is
// retained, as `append_field` does around its push. A record's field and an
// enum's payload are the same slot to this, since both read through
// `op_struct_get`; a tuple's element has no shape word before it, so it is
// written with `op_tuple_set`; an array's element is written at its index.
// The scratch slot holds the box's answer; nothing reads it past this point.
function steal(own r: irtables.LowerResult, f: ssasem.Func, v: i32, unique: i32): irtables.LowerResult {
  let get: ssa.SInst = definition(f, v);
  r = reserve(r, unique + 1);
  r = emit(r, ir.op_load_local(get.args[0]));
  r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
  r = emit(r, ir.op_store_local(unique));
  r = emit(r, ir.op_load_local(unique));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(get.args[0]));
  if (get.kind_tag == ssasem.array_get()) {
    // The read checked the index; the slot is nulled where it was read.
    r = emit(r, ir.op_load_local(get.args[1]));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.in_bounds(arr_set_op(f.values[v])));
  } else if (get.kind_tag == ssasem.tuple_get()) {
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_tuple_set(get.imm));
  } else {
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_struct_set(get.imm, 0));
  }
  r = emit(r, ir.op_end());
  return unless_unique(r, unique, v, "__fern_rc_inc");
}

// An in-place update whose receiver this frame does not own: its unit arrives
// as a RETAIN because the frame has to hold one while the operation runs, and
// emitting that retain BEFORE `__fern_rc_is_unique` makes the test answer for
// its own supply rather than for the box. It then says "shared" about a box
// nobody else holds, every push takes the un-share copy, and a loop appending
// through a borrowed parameter copies the whole buffer per element — 23 s and
// 8.9 GB for 40,000 pushes where the AST lowering takes 2 ms (#9365).
//
// A receiver the frame DOES own keeps its retain up front: there it is the
// same-frame bracket, held because the binding outlives the update and the
// copy is what keeps the old value whole.
//
// The cross-frame bracket is `bracketed`, and it is what makes deferring safe
// — so the deferral reaches exactly as far as that bracket does: a PARAMETER
// this frame borrows, which its caller either bracketed or is done reading,
// and a record FIELD the plan admitted (ssaunits.field_grow_root), where the
// bracket is on the field and the record's own count answers for any holder
// no caller names. The frame itself must be done reading the parameter too
// (`kept`): growing its box in place would change the value it reads next.
// Declining is enough because a borrowed parameter's unit is never moved:
// its retain stands through the push, which the rc test then reads as shared.
// An array reached any other way the frame does not own —
// an element of a borrowed array of arrays, say — has no bracket standing
// behind it, and growing it in place would rewrite what the container still
// holds. A with has no non-consuming helper to fall back on, so it defers
// only where the plan admitted the field.
//
// A map mutation never defers. Its receiver's retain is what makes a map
// the frame still reads count as shared, and core/map's copy-on-write then
// copies: `let n = m.insert(k, v)` leaves `m` as it was, which is the value
// the checker's E055 promises for every collection operation.
//
// A string append defers every retain of its left operand: a string the
// frame still reads cannot grow in place, so it is lent to a plain
// concatenation, which takes nothing (`grow_or_concat`).
function deferred_retain(f: ssasem.Func, p: ssaunits.Plan, step: ssaunits.Step, ins: ssa.SInst): boolean {
  if (ssaunits.string_append(f, ins)) {
    return receiver_retained(step);
  }
  if (ins.kind_tag != ssasem.append() && ins.kind_tag != ssasem.with()) {
    return false;
  }
  if (p.grows[ins.result] < 0 && (ins.kind_tag == ssasem.with() || ins.args[0] >= f.graph.nparams)) {
    return false;
  }
  if (ins.args[0] < p.owned.len() && p.owned[ins.args[0]]) {
    return false;
  }
  if (p.grows[ins.result] < 0 && p.kept[ins.result]) {
    return false;
  }
  return receiver_retained(step);
}

function receiver_retained(step: ssaunits.Step): boolean {
  for supply in step.supplies {
    if (supply.slot == 0 && supply.mode == ssaunits.retain_unit()) {
      return true;
    }
  }
  return false;
}

// The arguments of a direct call this frame has to hold a second count on
// across it. A callee handed a BORROWED array may grow or overwrite it in
// place when it is the box's only reader, and it cannot see the caller's
// binding to know whether it is — so the caller says so, by holding a count
// while the call runs. A value this step DROPS is not one the caller reads
// again, so it needs no bracket and the callee is free to work in place,
// unless it is lent twice: the callee would grow one parameter under the
// other's reads. Nor is a buffer the plan HANDS on (ssaunits.hands) — a
// borrowed parameter, or a field of a record, this frame reads no further.
//
// An array is bracketed only at a position the callee's grow row says it may
// grow (ssaunits.grows_buffer). The table answers for every callee a kept body
// names: `semlower.prune` drops a body that calls anything the AST lowering
// defines, and a builtin never grows what it is lent. Unconditional, the
// bracket cost a retain and a release per call, per loop turn.
//
// ARRAYS only. A text box is never updated in place — a concatenation builds
// its own — so a bracket buys nothing there, and a `string` that is really a
// view at run time carries the immortal count, where the retain is a no-op and
// the paired reclaim would free a box the frame still reads (#9328).
//
// A RECORD argument is bracketed field by field, and only at the fields the
// callee's own plan says it may grow (`grows`, from ssaunits.grow_rows):
// retaining the record's box would answer for the wrong box, since the buffer
// the callee's push tests is the field's, at its own count. Each held buffer
// is captured in a scratch local, so the release after the call decrements
// the buffer that was retained rather than re-reading a field the callee may
// have replaced.
//
// A field HANDED on (ssaunits.hands) is gated rather than bracketed: the
// record's own count says whether a holder this frame cannot see still names
// it, and a shared record holds a second count on the field across the call,
// as `append_field` does around its push. A whole record handed on is gated
// the same way at every field the callee may grow (`gated_records` /
// `gated_fields`); bracketing those fields would make the callee's first
// append copy a buffer nobody else reads, once per call up the chain of
// wrappers that lend a record on.
struct Held { arrays: i32[], records: i32[], fields: i32[], gated: i32[], gated_roots: i32[], gated_records: i32[], gated_fields: i32[] }

function bracketed(f: ssasem.Func, step: ssaunits.Step, ins: ssa.SInst, grows: ssaunits.GrowTable): Held {
  let out: Held = Held { arrays: [], records: [], fields: [], gated: [], gated_roots: [], gated_records: [], gated_fields: [] };
  if (ins.kind_tag != ssasem.call()) {
    return out;
  }
  let modes: i32[] = ssaunits.callee_modes(f, ins);
  let i: i32 = 0;
  while (i < ins.args.len() && i < modes.len()) {
    let v: i32 = ins.args[i];
    let last: boolean = util.index_of_i32(step.drops, v) >= 0 && ssaunits.occurrences(ins.args, v) == 1;
    if (modes[i] == ssaunits.borrow_mode() && !last) {
      let handed: boolean = i < step.hand_roots.len() && step.hand_roots[i] >= 0;
      if (bracketable(f.values[v]) && !handed && ssaunits.grows_buffer(grows, ins.str, i) && util.index_of_i32(out.arrays, v) < 0) {
        out = Held { ...out, arrays: out.arrays.append(v) };
      }
      if (handed && step.hand_fields[i] >= 0) {
        out = Held { ...out, gated: out.gated.append(v), gated_roots: out.gated_roots.append(step.hand_roots[i]) };
      }
      if (record_bracketable(f.values[v])) {
        for field in ssaunits.grow_fields_of(grows, ins.str, i) {
          if (handed) {
            out = Held { ...out, gated_records: out.gated_records.append(v), gated_fields: out.gated_fields.append(field) };
          } else if (!holds_field(out, v, field)) {
            out = Held { ...out, records: out.records.append(v), fields: out.fields.append(field) };
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function holds_field(h: Held, rec: i32, field: i32): boolean {
  let k: i32 = 0;
  while (k < h.records.len()) {
    if (h.records[k] == rec && h.fields[k] == field) {
      return true;
    }
    k = k + 1;
  }
  return false;
}

function bracketable(t: typeinfo.Type): boolean {
  if (ssasem.is_text(t)) {
    return false;
  }
  if let typeinfo.TypeArray(_) = t {
    return ssasem.reference(t);
  }
  return false;
}

function record_bracketable(t: typeinfo.Type): boolean {
  if (semtypes.is_env(t)) {
    return false;
  }
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  return false;
}

// The scratch locals sit above the value ids; a call's own lowering reserves
// none, so the held buffers keep theirs from the take to the give.
function bracket_take(own r: irtables.LowerResult, f: ssasem.Func, held: Held): irtables.LowerResult {
  for v in held.arrays {
    r = helper(r, v, "__fern_rc_inc");
  }
  let k: i32 = 0;
  while (k < held.records.len()) {
    let slot: i32 = scratch_base(f) + k;
    r = reserve(r, slot + 1);
    r = emit(r, ir.op_load_local(held.records[k]));
    r = emit(r, ir.op_struct_get(held.fields[k], 0));
    r = emit(r, ir.op_store_local(slot));
    r = helper(r, slot, "__fern_arr_share_inc");
    k = k + 1;
  }
  let j: i32 = 0;
  while (j < held.gated.len()) {
    let unique: i32 = scratch_base(f) + held.records.len() + j;
    r = reserve(r, unique + 1);
    r = emit(r, ir.op_load_local(held.gated_roots[j]));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_store_local(unique));
    r = unless_unique(r, unique, held.gated[j], "__fern_arr_share_inc");
    j = j + 1;
  }
  // A gated field takes two scratch slots: the buffer, captured before the
  // call for the reason a bracketed field's is, and the record's answer.
  let g: i32 = 0;
  while (g < held.gated_records.len()) {
    let slot: i32 = gated_field_slot(f, held, g);
    r = reserve(r, slot + 2);
    r = emit(r, ir.op_load_local(held.gated_records[g]));
    r = emit(r, ir.op_struct_get(held.gated_fields[g], 0));
    r = emit(r, ir.op_store_local(slot));
    r = emit(r, ir.op_load_local(held.gated_records[g]));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_store_local(slot + 1));
    r = unless_unique(r, slot + 1, slot, "__fern_arr_share_inc");
    g = g + 1;
  }
  return r;
}

function gated_field_slot(f: ssasem.Func, held: Held, g: i32): i32 {
  return scratch_base(f) + held.records.len() + held.gated.len() + 2 * g;
}

function bracket_give(own r: irtables.LowerResult, f: ssasem.Func, held: Held): irtables.LowerResult {
  for v in held.arrays {
    r = release(r, v, f.values[v], f);
  }
  let k: i32 = 0;
  while (k < held.records.len()) {
    r = helper(r, scratch_base(f) + k, "__fern_arr_share_dec");
    k = k + 1;
  }
  let j: i32 = 0;
  while (j < held.gated.len()) {
    r = unless_unique(r, scratch_base(f) + held.records.len() + j, held.gated[j], "__fern_arr_share_dec");
    j = j + 1;
  }
  let g: i32 = 0;
  while (g < held.gated_records.len()) {
    let slot: i32 = gated_field_slot(f, held, g);
    r = unless_unique(r, slot + 1, slot, "__fern_arr_share_dec");
    g = g + 1;
  }
  return r;
}

// Scratch storage is shared by successive drops and distinct within recursion.
function reserve(own r: irtables.LowerResult, end: i32): irtables.LowerResult {
  if (end > r.n_locals) {
    return irtables.LowerResult { ...r, n_locals: end };
  }
  return r;
}

// A value's SSA id is its local slot, so the slots above `nvals` are the
// frame's scratch. The lowest belongs to the reuse pairing and is the only one
// that lives ACROSS instructions: a token is taken where a value dies and
// spent at a construction further down the block. Everything else is scratch
// within one instruction, so it starts above it.
function token_slot(f: ssasem.Func): i32 {
  return f.graph.nvals;
}

function scratch_base(f: ssasem.Func): i32 {
  return f.graph.nvals + 1;
}

// A parent owns one unit per reference field. Shared parents release only
// their own unit; the final parent release walks children before its box.
// Array/tuple/struct opcodes preserve the production native/Wasm layouts.
// The answer for a type must not depend on which body of a module asks:
// with_drop_helpers settles each record and enum type at the first body
// whose table holds it (Helpers.seen).
function has_children(t: typeinfo.Type, f: ssasem.Func): boolean {
  // A handle has no box, so there is nothing under it to walk — and
  // no schema either, which is what the record arm below would go looking
  // for.
  if (semtypes.is_handle(t)) {
    return false;
  }
  // A cursor holds a unit of its map.
  if (semtypes.is_map_iter(t)) {
    return true;
  }
  if let typeinfo.TypeFunc(_) = t {
    return env_records(f, t).len() > 0;
  }
  if (ssasem.is_dyn(t)) {
    for c in dyn_concretes(f, t) {
      if (ssasem.is_string(c) || has_children(c, f)) {
        return true;
      }
    }
    return false;
  }
  if let typeinfo.TypeArray(a) = t {
    return ssasem.reference(a.elem);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for elem in tup.elements {
      if (ssasem.reference(elem)) {
        return true;
      }
    }
  }
  if (semtypes.is_cell(t)) {
    return ssasem.reference(semtypes.cell_elem(t));
  }
  // A map's own release reads the count and walks its columns, so no guard
  // is emitted around it here.
  if (ssasem.is_map(t)) {
    return false;
  }
  // A finalizer is a child the box owes whatever its fields hold.
  if (ssasem.has_finalizer(f, t)) {
    return true;
  }
  if let typeinfo.TypeStruct(_) = t {
    return fields_have_children(record_fields(t, f));
  }
  if let typeinfo.TypeUnion(_) = t {
    for v in variants_of(t, f) {
      if (fields_have_children(v.fields)) {
        return true;
      }
    }
  }
  return false;
}

// The environments a function value of type `fn_ty` may be carrying, whose
// captures own a unit: the boxes releasing one has to be able to walk.
//
// Keyed on `fn_ty` and ordered by body name, and both halves are the same
// requirement. A drop helper is emitted by EVERY function that mentions its
// type and `merge_helpers` refuses two copies that disagree, so the chain
// `drop_captures` emits must not vary with the frame emitting it. `f.envs`
// supplies the pairing, read off the module's whole contract table; a schema
// table on its own is the producing function's own values in the producing
// function's own order, which varies with both.
//
// `semsource.env_rows_closed` closes the rows over the schema table, so a
// frame that holds the type only indirectly — as a field of a record it never
// names — lists the same environments as the frame that built the closure.
function env_records(f: ssasem.Func, fn_ty: typeinfo.Type): semrecords.Record[] {
  let out: semrecords.Record[] = [];
  for rec in f.records.list {
    if (!semtypes.is_env(rec.ty) || !fields_have_children(rec.fields)) {
      continue;
    }
    if (!serves(f.envs, fn_ty, rec.ty)) {
      continue;
    }
    let at: i32 = 0;
    while (at < out.len() && semtypes.env_body(out[at].ty) < semtypes.env_body(rec.ty)) {
      at = at + 1;
    }
    out = inserted_record(out, at, rec);
  }
  return out;
}

function serves(rows: ssasem.EnvRow[], fn_ty: typeinfo.Type, env_ty: typeinfo.Type): boolean {
  for row in rows {
    if (semtypes.equal(row.fn_ty, fn_ty) && semtypes.equal(row.env_ty, env_ty)) {
      return true;
    }
  }
  return false;
}

function inserted_record(recs: semrecords.Record[], at: i32, rec: semrecords.Record): semrecords.Record[] {
  let out: semrecords.Record[] = [];
  let i: i32 = 0;
  while (i < recs.len()) {
    if (i == at) {
      out = out.append(rec);
    }
    out = out.append(recs[i]);
    i = i + 1;
  }
  if (at >= recs.len()) {
    out = out.append(rec);
  }
  return out;
}

// A function value's static type names no captures, so its box is matched at
// run time: slot 0 holds the body's address, and each environment a value of
// that type could be carrying is tried against it. A box whose captures own
// nothing matches none and is released alone. The box need not have been built
// in this frame — that is the point of matching on the body address rather
// than on what the frame knows it made.
function drop_captures(own r: irtables.LowerResult, slot: i32, fn_ty: typeinfo.Type, f: ssasem.Func): irtables.LowerResult {
  for rec in env_records(f, fn_ty) {
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_arr_get(32));
    r = emit(r, ir.op_const_func(0, semtypes.env_body(rec.ty)));
    r = emit(r, ir.op_bin("eq", 0, false));
    r = emit(r, ir.op_if(0));
    r = helper(r, slot, drop_helper_name(rec.ty));
    r = emit(r, ir.op_end());
  }
  return r;
}

// A dyn value's box is one of the concretes its type can hold, matched at run
// time by the shape the box carries at offset 0: a record's is its own, a
// boxed string's is `string`, and an enum's helper tests its variants itself,
// so it is called unguarded. The value need not have been widened in this
// frame, which is why the set is the type's (`ssasem.Func.dyns`) rather than
// what the frame saw built.
function drop_dyn(own r: irtables.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irtables.LowerResult {
  for c in dyn_concretes(f, t) {
    if (ssasem.is_string(c)) {
      r = reserve(r, scratch + 1);
      r = emit(r, ir.op_load_local(slot));
      r = emit(r, ir.op_variant_is("string"));
      r = emit(r, ir.op_if(0));
      r = emit(r, ir.op_load_local(slot));
      r = emit(r, ir.op_struct_get(0, 0));
      r = emit(r, ir.op_store_local(scratch));
      r = drop_value(r, scratch, c, scratch + 1, f);
      r = emit(r, ir.op_end());
      continue;
    }
    if (!has_children(c, f)) {
      continue;
    }
    if let typeinfo.TypeStruct(rs) = c {
      r = emit(r, ir.op_load_local(slot));
      r = emit(r, ir.op_variant_is(rs.name));
      r = emit(r, ir.op_if(0));
      r = helper(r, slot, drop_helper_name(c));
      r = emit(r, ir.op_end());
    } else {
      r = helper(r, slot, drop_helper_name(c));
    }
  }
  return r;
}

function dyn_concretes(f: ssasem.Func, t: typeinfo.Type): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for row in f.dyns {
    if (semtypes.equal(row.fn_ty, t)) {
      out = out.append(row.env_ty);
    }
  }
  return out;
}

// The units a box owns, released without releasing the box. The caller has
// already emitted the uniqueness test this belongs under: `drop_value` before
// it releases the box, `reuse_token` before it hands the box on.
function drop_children(own r: irtables.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irtables.LowerResult {
  if (unlinked_map(t, f)) {
    return r;
  }
  if (semtypes.is_map_iter(t)) {
    return drop_cursor_map(r, slot, t, scratch, f);
  }
  if let typeinfo.TypeFunc(_) = t {
    r = drop_captures(r, slot, t, f);
  }
  if (ssasem.is_dyn(t)) {
    r = drop_dyn(r, slot, t, scratch, f);
  }
  if let typeinfo.TypeArray(a) = t {
    r = drop_elements(r, slot, a.elem, scratch, f);
  }
  if (semtypes.is_cell(t)) {
    r = drop_elements(r, slot, semtypes.cell_elem(t), scratch, f);
  }
  if let typeinfo.TypeTuple(tup) = t {
    r = drop_tuple_fields(r, slot, tup, scratch, f);
  }
  if (named(t) != "") {
    r = helper(r, slot, drop_helper_name(t));
  }
  return r;
}

// A cursor's one child is the map it holds a unit of, read through core/map.
function drop_cursor_map(own r: irtables.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irtables.LowerResult {
  let m: typeinfo.Type = semtypes.map_iter_map(t);
  r = reserve(r, scratch + 1);
  r = emit(r, ir.op_load_local(slot));
  r = emit(r, ir.op_call_direct("__mapiter_map_impl", 1));
  r = emit(r, ir.op_store_local(scratch));
  return drop_value(r, scratch, m, scratch + 1, f);
}

// A nominal type with children is released by its own helper: the inline
// test-walk-release is ~20 emitted lines a site, and the self-host assembles
// every line it emits.
function drop_value(own r: irtables.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irtables.LowerResult {
  if (outlined_release(t, f)) {
    return helper(r, slot, release_helper_name(t));
  }
  return drop_value_inline(r, slot, t, scratch, f);
}

function outlined_release(t: typeinfo.Type, f: ssasem.Func): boolean {
  return named(t) != "" && !semtypes.is_map_iter(t) && has_children(t, f);
}

function drop_value_inline(own r: irtables.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irtables.LowerResult {
  if (has_children(t, f)) {
    r = emit(r, ir.op_load_local(slot));
    // A box with children cannot be a tagged byte view. Preserve this fact
    // inside generated release helpers too, where slots are not SSA values.
    r = emit(r, aligned_unique());
    r = emit(r, ir.op_if(0));
    r = drop_children(r, slot, t, scratch, f);
    r = emit(r, ir.op_end());
  }
  return release(r, slot, t, f);
}

function aligned_unique(): ir.Op {
  let op: ir.Op = ir.op_call_direct("__fern_rc_is_unique", 1);
  return ir.Op { ...op, i64_imm: 4 };
}

// A builtin union's box carries no shape pointer, so the walk selects its one
// payload by the tag the box stores rather than by a variant shape.
function drop_payload(own r: irtables.LowerResult, slot: i32, e: semrecords.Enum, scratch: i32, f: ssasem.Func): irtables.LowerResult {
  let child: i32 = scratch;
  r = reserve(r, child + 1);
  let tag: i32 = 0;
  while (tag < e.variants.len()) {
    let fields: semrecords.Field[] = e.variants[tag].fields;
    if (fields.len() == 1 && ssasem.reference(fields[0].ty)) {
      r = emit(r, ir.op_load_local(slot));
      r = emit(r, ir.op_opt_tag());
      r = emit(r, ir.op_const_i32(tag));
      r = emit(r, ir.op_bin("eq", 0, false));
      r = emit(r, ir.op_if(0));
      r = emit(r, ir.op_load_local(slot));
      r = emit(r, ir.op_opt_payload());
      r = emit(r, ir.op_store_local(child));
      r = drop_value(r, child, fields[0].ty, child + 1, f);
      r = emit(r, ir.op_end());
    }
    tag = tag + 1;
  }
  return r;
}

// A variant box carries only its own variant's fields, so the walk selects
// them by the box's runtime variant.
function drop_variant_fields(own r: irtables.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irtables.LowerResult {
  let e: semrecords.Enum = f.enums[semrecords.find_enum(f.enums, t)];
  if (e.layout == semrecords.layout_option()) {
    return drop_payload(r, slot, e, scratch, f);
  }
  for v in e.variants {
    if (semrecords.inhabited(v) && fields_have_children(v.fields)) {
      r = emit(r, ir.op_load_local(slot));
      r = emit(r, ir.op_variant_is(ssasem.variant_key(t, v.name)));
      r = emit(r, ir.op_if(0));
      r = drop_record_fields(r, slot, v.fields, scratch, f, false);
      r = emit(r, ir.op_end());
    }
  }
  return r;
}

// self_tail_field: the index of the variant's last field of the enum's own
// type, or -1.
function self_tail_field(v: semrecords.Variant, t: typeinfo.Type): i32 {
  let at: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < v.fields.len()) {
    if (semtypes.equal(v.fields[i].ty, t)) {
      at = i;
    }
    i = i + 1;
  }
  return at;
}

function self_tail_enum(t: typeinfo.Type, f: ssasem.Func): boolean {
  let e: semrecords.Enum = f.enums[semrecords.find_enum(f.enums, t)];
  if (e.layout == semrecords.layout_option()) {
    return false;
  }
  for v in e.variants {
    if (self_tail_field(v, t) >= 0) {
      return true;
    }
  }
  return false;
}

// drop_variant_chain is drop_variant_fields for an enum whose variants reach
// the enum itself (a list's tail): that one field is not a recursive drop but
// the next node of a loop, so the helper's stack stays constant however long
// the chain is (#9046). Each node after the first is released here once its
// children are, exactly as drop_value would release it; a shared next node is
// released without its children, and the walk stops. Slots: 1 the node, 2
// whether it is the caller's box, 3 the next node, 4 up scratch.
function drop_variant_chain(own r: irtables.LowerResult, t: typeinfo.Type, f: ssasem.Func): irtables.LowerResult {
  let e: semrecords.Enum = f.enums[semrecords.find_enum(f.enums, t)];
  let node: i32 = 1;
  let first: i32 = 2;
  let next: i32 = 3;
  r = reserve(r, 5);
  r = emit(r, ir.op_load_local(0));
  r = emit(r, ir.op_store_local(node));
  r = emit(r, ir.op_const_i32(1));
  r = emit(r, ir.op_store_local(first));
  r = emit(r, ir.op_block(0));
  r = emit(r, ir.op_loop(0));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_store_local(next));
  for v in e.variants {
    if (!semrecords.inhabited(v) || !fields_have_children(v.fields)) {
      continue;
    }
    let tail: i32 = self_tail_field(v, t);
    r = emit(r, ir.op_load_local(node));
    r = emit(r, ir.op_variant_is(ssasem.variant_key(t, v.name)));
    r = emit(r, ir.op_if(0));
    let i: i32 = 0;
    while (i < v.fields.len()) {
      if (walked(v.fields[i].ty)) {
        r = emit(r, ir.op_load_local(node));
        r = emit(r, ir.op_struct_get(i, 0));
        if (i == tail) {
          r = emit(r, ir.op_store_local(next));
        } else {
          r = emit(r, ir.op_store_local(4));
          r = drop_value(r, 4, v.fields[i].ty, 5, f);
        }
      }
      i = i + 1;
    }
    r = emit(r, ir.op_end());
  }
  r = emit(r, ir.op_load_local(first));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_bin("eq", 0, false));
  r = emit(r, ir.op_if(0));
  r = release(r, node, t, f);
  r = emit(r, ir.op_end());
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_store_local(first));
  // No next node: done. A shared one: release it and stop.
  r = emit(r, ir.op_load_local(next));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_bin("eq", ir.width_ptr(), false));
  r = emit(r, ir.op_brif(1));
  r = emit(r, ir.op_load_local(next));
  // The next link has the same nominal union type as the current node.
  r = emit(r, aligned_unique());
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_else());
  r = release(r, next, t, f);
  r = emit(r, ir.op_br(2));
  r = emit(r, ir.op_end());
  r = emit(r, ir.op_load_local(next));
  r = emit(r, ir.op_store_local(node));
  r = emit(r, ir.op_br(0));
  r = emit(r, ir.op_end());
  return emit(r, ir.op_end());
}

function drop_elements(own r: irtables.LowerResult, slot: i32, elem: typeinfo.Type, scratch: i32, f: ssasem.Func): irtables.LowerResult {
  let index: i32 = scratch;
  let child: i32 = index + 1;
  r = reserve(r, child + 1);
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_store_local(index));
  r = emit(r, ir.op_block(0));
  r = emit(r, ir.op_loop(0));
  r = emit(r, ir.op_load_local(index));
  r = emit(r, ir.op_load_local(slot));
  r = emit(r, ir.op_arr_len());
  r = emit(r, ir.op_bin("ge_s", 0, false));
  r = emit(r, ir.op_brif(1));
  r = emit(r, ir.op_load_local(slot));
  r = emit(r, ir.op_load_local(index));
  r = emit(r, ir.op_arr_get_nc(32));
  r = emit(r, ir.op_store_local(child));
  r = drop_value(r, child, elem, child + 1, f);
  r = emit(r, ir.op_load_local(index));
  r = emit(r, ir.op_const_i32(1));
  r = emit(r, ir.op_bin("add", 0, false));
  r = emit(r, ir.op_store_local(index));
  r = emit(r, ir.op_br(0));
  r = emit(r, ir.op_end());
  return emit(r, ir.op_end());
}

function drop_tuple_fields(own r: irtables.LowerResult, slot: i32, tup: typeinfo.TypeTuple, scratch: i32, f: ssasem.Func): irtables.LowerResult {
  let child: i32 = scratch;
  r = reserve(r, child + 1);
  let i: i32 = 0;
  while (i < tup.elements.len()) {
    if (ssasem.reference(tup.elements[i])) {
      r = emit(r, ir.op_load_local(slot));
      r = emit(r, ir.op_tuple_get(i));
      r = emit(r, ir.op_store_local(child));
      r = drop_value(r, child, tup.elements[i], child + 1, f);
    }
    i = i + 1;
  }
  return r;
}

// `env` selects the box LAYOUT, not what is walked: an environment addresses
// its captures as array slots and a record its fields as struct ones.
function drop_record_fields(own r: irtables.LowerResult, slot: i32, fields: semrecords.Field[], scratch: i32, f: ssasem.Func, env: boolean): irtables.LowerResult {
  let child: i32 = scratch;
  r = reserve(r, child + 1);
  let i: i32 = 0;
  while (i < fields.len()) {
    if (walked(fields[i].ty)) {
      r = emit(r, ir.op_load_local(slot));
      if (env) {
        r = emit(r, ir.op_const_i32(i));
        r = emit(r, ir.op_arr_get(32));
      } else {
        r = emit(r, ir.op_struct_get(i, 0));
      }
      r = emit(r, ir.op_store_local(child));
      r = drop_value(r, child, fields[i].ty, child + 1, f);
    }
    i = i + 1;
  }
  return r;
}

function drops(own r: irtables.LowerResult, step: ssaunits.Step, f: ssasem.Func, links: i32[]): irtables.LowerResult {
  for value in step.drops {
    r = drop_linked(r, value, links, f);
  }
  return r;
}

// The drops of a step less the one a construction took as its box: that value's
// storage became the result's, so releasing it here would free a live box.
// `shell` is a box whose payload this step took without emptying its slot
// (`ssaunits.shell_root`), so its drop releases the box alone.
function drops_less(own r: irtables.LowerResult, step: ssaunits.Step, f: ssasem.Func, links: i32[], taken: i32, took: i32, held: i32, shell: i32): irtables.LowerResult {
  for value in step.drops {
    if (value == shell) {
      r = release(r, value, f.values[value], f);
    } else if (value != taken && value != took && value != held) {
      r = drop_linked(r, value, links, f);
    }
  }
  return r;
}

// Where a block's constructions can build in a box already dying in it.
//
// Perceus places a drop at a value's last use, so the record a `with`-style
// update supersedes dies BEFORE the record replacing it is built. Reuse is the
// pairing of that drop with that later construction: instead of returning the
// box to the allocator and taking another of the same shape, the drop keeps it
// as a token and the construction builds in it. This is Koka's ParcReuse
// applied to the plan's dying set rather than to syntax.
//
// `tokens[i]` is the value whose drop at instruction i becomes a token, and
// `builds[i]` the token an instruction i construction builds in; -1 for
// neither. One pairing is live at a time, so one token slot serves the block —
// a second candidate while one is pending is simply left to drop normally.
//
// The donor and the recipient need not share a TYPE, and the pairing does not
// ask: a box is storage, and what separates two of them is the number of
// SLOTS. `reuse_slots` is that number, matched against what the construction
// claims. Measured over the compiler's own sources, pairing on shape alone —
// any dying record, union or tuple to any construction — admits 839 sites of
// which only 229 have counts the runtime can honour; pairing on the count
// admits 390, all of them spendable, once the donor is held for whichever
// construction claims it (`block_claims`, below) rather than taken first-come.
// `selfs[i]` is a value dying AT instruction i whose box that same
// instruction's construction builds in — the update chain's shape, where the
// box a `T { ...a, f: v }` supersedes dies as the update consumes it rather
// than at some earlier instruction. Its token is taken before the construction
// instead of after, which is the only thing that separates it from the pairing
// above; it is the same donor, the same runtime test and the same box.
//
// Measured over the compiler's own sources, 795 constructions have a
// matching-slot value dying at their own instruction, against 390 pairings
// from earlier drops. Most of them are the two native assemblers, which are
// nothing but update chains.
struct ReusePairs { tokens: i32[], builds: i32[], selfs: i32[] }

// The slots a value's box has, or -1 where this frame cannot say. This is the
// number `__fern_alloc_reuse` compares, and comparing it HERE is what makes a
// pairing worth emitting: the runtime's own test is sound either way, but the
// arm it takes when the counts disagree returns the donor block to its
// freelist and allocates anyway, so the pairing has bought a uniqueness test
// and a branch and changed nothing, at 25 lines of emitted text apiece.
// Measured over the compiler's own sources, 610 of 839 pairings admitted on
// shape alone were of that kind.
//
// A record's box is its shape word and one word per field, a tuple's one word
// per element and no shape word. An environment is excluded: its fields are
// addressed as array slots rather than struct ones, and its box is the
// closure's. So is an array: its cap is a CAPACITY rather than its length, so
// the slots the block has are not the slots its type names.
function reuse_slots(t: typeinfo.Type, f: ssasem.Func): i32 {
  if (semtypes.is_env(t) || semtypes.is_cell(t)) {
    return 0 - 1;
  }
  // A box handed on is not freed, and a finalizer is owed at the free.
  if (ssasem.has_finalizer(f, t)) {
    return 0 - 1;
  }
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements.len();
  }
  if let typeinfo.TypeStruct(_) = t {
    if (semrecords.find(f.records, t) < 0) {
      return 0 - 1;
    }
    return record_fields(t, f).len() + 1;
  }
  if let typeinfo.TypeUnion(_) = t {
    return union_slots(t, f);
  }
  return 0 - 1;
}

// A declared enum's box is the LIVE variant's, so its count is this frame's to
// know only where every variant agrees — native's own enum reuse asks the same
// question (`enum_all_variants_same_field_count`).
//
// A BUILTIN union's box has no count this boundary can state, and that is a
// target fact rather than a conservatism. One lowering feeds all three
// backends: the register ones build every Option/Result as `__fern_arr_box(2)`,
// while wasm sizes the box by the payload AT THE SITE — eight bytes for a
// narrow one and sixteen for an i64 or an f64 — so a `Result[i64, string]`
// box is two slots built as Ok and one built as Err. There is no single answer
// to give, and a wrong one is the pairing that emits its machinery and then
// declines.
function union_slots(t: typeinfo.Type, f: ssasem.Func): i32 {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0) {
    return 0 - 1;
  }
  if (f.enums[at].layout == semrecords.layout_option()) {
    return 0 - 1;
  }
  let n: i32 = 0 - 1;
  for v in f.enums[at].variants {
    if (n < 0) {
      n = v.fields.len();
    } else if (n != v.fields.len()) {
      return 0 - 1;
    }
  }
  if (n < 0) {
    return 0 - 1;
  }
  return n + 1;
}

// The slots one variant of a declared enum builds: its shape word and one per
// field, as `struct_make` allocates them. -1 for any other layout.
function variant_slots(t: typeinfo.Type, name: string, f: ssasem.Func): i32 {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0 || f.enums[at].layout != semrecords.layout_variant()) {
    return 0 - 1;
  }
  let v: i32 = semrecords.find_variant(f.enums[at], name);
  if (v < 0) {
    return 0 - 1;
  }
  return f.enums[at].variants[v].fields.len() + 1;
}

// The slots a dying value's box has in block `b`. A declared enum whose
// variants disagree has no count of its own, but a payload read executes only
// where the tag test chose its variant, so a block reading one holds a box of
// that variant's count. That is the consuming match's shape: the arm takes the
// payloads, the scrutinee dies, and the arm's construction builds in its box.
function donor_slots(f: ssasem.Func, b: ssa.SBlock, d: i32): i32 {
  let t: typeinfo.Type = f.values[d];
  let n: i32 = reuse_slots(t, f);
  if (n >= 0 || ssasem.has_finalizer(f, t)) {
    return n;
  }
  for ins in b.insts {
    if (ins.kind_tag == ssasem.variant_get() && ins.args[0] == d) {
      return variant_slots(t, ins.str, f);
    }
  }
  return 0 - 1;
}

// The slots a construction claims, or -1 where it is not one a token can be
// spent at. An array construction is excluded for the reason a dying array is:
// what it asks the allocator for is a capacity.
function recipient_slots(f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): i32 {
  if (p.constants[ins.result] != "") {
    return 0 - 1;
  }
  if (ins.kind_tag == ssasem.tuple_new()) {
    return tuple_elements(f.values[ins.result]).len();
  }
  if (ins.kind_tag == ssasem.record_new()) {
    return reuse_slots(f.values[ins.result], f);
  }
  if (ins.kind_tag == ssasem.variant_new()) {
    let n: i32 = union_slots(f.values[ins.result], f);
    if (n < 0) {
      n = variant_slots(f.values[ins.result], ins.str, f);
    }
    return n;
  }
  return 0 - 1;
}

// The last position in the block at which a construction claims each slot
// count. A donor is worth holding while some construction still ahead of it
// claims the count its box has, which this answers in one lookup where a scan
// forward would cost a pass per candidate.
//
// Holding it for the NEXT construction alone is the version that looks right
// and is not: a donor the next one cannot take is dropped, and the one two
// instructions further down that could have taken it allocates. Measured over
// the compiler's own sources, that reading pairs 287 where this one pairs 390.
struct Claims { counts: i32[], last: i32[] }

function block_claims(f: ssasem.Func, p: ssaunits.Plan, b: ssa.SBlock): Claims {
  let counts: i32[] = [];
  let last: i32[] = [];
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let c: i32 = recipient_slots(f, p, b.insts[pos]);
    if (c >= 0) {
      let at: i32 = util.index_of_i32(counts, c);
      if (at < 0) {
        counts = counts.append(c);
        last = last.append(pos);
      } else {
        last = last.with(at, pos);
      }
    }
    pos = pos + 1;
  }
  return Claims { counts: counts, last: last };
}

function claimed_after(c: Claims, slots: i32, pos: i32): boolean {
  let at: i32 = util.index_of_i32(c.counts, slots);
  return at >= 0 && c.last[at] > pos;
}

// Donors handed to constructions in later blocks. A value dying in a block
// after the block's last construction may be held there instead of dropped,
// and become the token of the first construction claiming its slot count in a
// later block, as a value dying at a construction does. A carry is a donor
// value, the blocks holding it (`from`, at `drop_at`), the constructions it is
// handed to (`to`, at `build_at`), and the edges where it goes back instead
// (`exit_from` to `exit_to`, dropping `dropped`).
//
// The blocks between the holding blocks and a construction, its way, claim
// that count nowhere and are entered only from a holding block or a way, so
// a path entering a way carries the box a holding block kept. A path leaves
// the ways at a construction, which spends the box, or at an edge to any
// other block, which drops it, and can enter them again only through a
// holding block. So one donor serves a construction in each arm of a branch,
// and a donor dying in each arm of a match serves one construction past
// their join. The held box stays in the donor's own local
// until `build_at` writes the token slot, so a pairing on the way, whose token
// is written and spent within its block, is unaffected.
struct Carry { from: i32[], drop_at: i32[], held: i32[], to: i32[], build_at: i32[], donor: i32[], exit_from: i32[], exit_to: i32[], dropped: i32[] }

function no_carry(): Carry {
  return Carry { from: [], drop_at: [], held: [], to: [], build_at: [], donor: [], exit_from: [], exit_to: [], dropped: [] };
}

// The first construction in `b` claiming `slots`, or -1.
function first_claim_of(f: ssasem.Func, p: ssaunits.Plan, b: ssa.SBlock, slots: i32): i32 {
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let ins: ssa.SInst = b.insts[pos];
    if (ins.kind_tag != 6 && ins.kind_tag != 8 && recipient_slots(f, p, ins) == slots) {
      return pos;
    }
    pos = pos + 1;
  }
  return 0 - 1;
}

function last_claim(f: ssasem.Func, p: ssaunits.Plan, b: ssa.SBlock): i32 {
  let pos: i32 = b.insts.len() - 1;
  while (pos >= 0) {
    let ins: ssa.SInst = b.insts[pos];
    if (ins.kind_tag != 6 && ins.kind_tag != 8 && recipient_slots(f, p, ins) >= 0) {
      return pos;
    }
    pos = pos - 1;
  }
  return 0 - 1;
}

// The constructions a box can be carried to from a set of holding blocks, by
// block id, and the way to each.
struct Routes { targets: i32[], ways: i32[][] }

// The per-function facts every route search reads: each block's position by
// id and the slot counts its constructions claim.
struct RouteGraph { at: i32[], claims: i32[][] }

function route_graph(f: ssasem.Func, p: ssaunits.Plan): RouteGraph {
  let claims: i32[][] = [];
  for b in f.graph.blocks {
    claims = claims.append(block_claims(f, p, b).counts);
  }
  return RouteGraph { at: ssa.block_positions(f.graph), claims: claims };
}

// Whether the block at position `k` builds something claiming `slots`.
function claims_slots(g: RouteGraph, k: i32, slots: i32): boolean {
  return util.index_of_i32(g.claims[k], slots) >= 0;
}

// What the route searches of one function mark, by block position: `seen` the
// blocks ahead of a search's start, `way` the blocks between it and a target.
// A mark holds the stamp of the search that made it, and each search takes a
// fresh stamp, so none is cleared between searches.
struct RouteMarks { seen: i32[], way: i32[], stamp: i32 }

struct Searched { routes: Routes, marks: RouteMarks }

struct Way { ok: boolean, blocks: i32[], marks: RouteMarks }

function route_marks(n: i32): RouteMarks {
  let seen: i32[] = [];
  let way: i32[] = [];
  while (seen.len() < n) {
    seen = seen.append(0);
    way = way.append(0);
  }
  return RouteMarks { seen: seen, way: way, stamp: 0 };
}

// Where a box of `slots` held in `sources` can be carried: each block claiming
// that count first on some path out of the sources whose way is entered from
// nowhere else.
function carry_routes(f: ssasem.Func, g: RouteGraph, sources: i32[], own m: RouteMarks, slots: i32): Searched {
  let ahead: i32 = m.stamp + 1;
  let seen: i32[] = m.seen;
  let way: i32[] = m.way;
  let builds: i32[] = [];
  let work: i32[] = [];
  for id in sources {
    for s in successors(f.graph.blocks[g.at[id]].term) {
      work = work.append(s);
    }
  }
  let next: i32 = 0;
  while (next < work.len()) {
    let id: i32 = work[next];
    next = next + 1;
    let k: i32 = g.at[id];
    if (util.index_of_i32(sources, id) >= 0 || seen[k] == ahead) {
      continue;
    }
    seen = seen.with(k, ahead);
    if (claims_slots(g, k, slots)) {
      builds = builds.append(id);
    } else {
      for s in successors(f.graph.blocks[k].term) {
        work = work.append(s);
      }
    }
  }
  m = RouteMarks { seen: seen, way: way, stamp: ahead };
  let found: Routes = Routes { targets: [], ways: [] };
  for target in builds {
    let w: Way = way_to(f, g, sources, m, ahead, target, slots);
    m = w.marks;
    if (w.ok) {
      found = Routes { targets: found.targets.append(target), ways: found.ways.append(w.blocks) };
    }
  }
  return Searched { routes: found, marks: m };
}

// The way to `target`, `ahead` being the stamp of the `seen` marks of the
// search from `sources`. The walk takes the predecessors of the target and of
// each block on the way, marked `way` at a fresh stamp. Each must be a source,
// on the way, or a block ahead claiming nothing of the count, which joins the
// way; any other enters the way from elsewhere.
function way_to(f: ssasem.Func, g: RouteGraph, sources: i32[], own m: RouteMarks, ahead: i32, target: i32, slots: i32): Way {
  let stamp: i32 = m.stamp + 1;
  let seen: i32[] = m.seen;
  let way: i32[] = m.way;
  let between: i32[] = [];
  let work: i32[] = f.graph.blocks[g.at[target]].preds;
  let next: i32 = 0;
  while (next < work.len()) {
    let id: i32 = work[next];
    next = next + 1;
    let k: i32 = g.at[id];
    if (util.index_of_i32(sources, id) >= 0 || way[k] == stamp) {
      continue;
    }
    if (seen[k] != ahead || claims_slots(g, k, slots)) {
      return Way { ok: false, blocks: [], marks: RouteMarks { seen: seen, way: way, stamp: stamp } };
    }
    between = between.append(id);
    way = way.with(k, stamp);
    for pr in f.graph.blocks[k].preds {
      work = work.append(pr);
    }
  }
  return Way { ok: true, blocks: between, marks: RouteMarks { seen: seen, way: way, stamp: stamp } };
}

// The values that die after position `claim` of `b`, and where each dies, in
// order, leaving out the value the instruction there defines and one a link
// keeps: the donors a later block's construction could take.
struct Dying { at: i32[], values: i32[] }

function dying_after_claims(p: ssaunits.Plan, idx: i32[][], links: i32[], b: ssa.SBlock, claim: i32): Dying {
  let out: Dying = Dying { at: [], values: [] };
  let pos: i32 = claim + 1;
  while (pos < b.insts.len()) {
    if (b.insts[pos].kind_tag != 6 && b.insts[pos].kind_tag != 8) {
      for d in at(p, idx, b.id, pos, 0 - 1).drops {
        if (d != b.insts[pos].result && (d >= links.len() || links[d] < 0)) {
          out = Dying { at: out.at.append(pos), values: out.values.append(d) };
        }
      }
    }
    pos = pos + 1;
  }
  return out;
}

// The holding blocks of one carry: block `first` and every later block not yet
// holding a donor in which `d` dies after the last construction, as a box of
// the same count. A block that returns holds nothing: it has no edge to drop
// the box on.
struct Holds { blocks: i32[], at: i32[], slots: i32 }

function holds_of(f: ssasem.Func, dying: Dying[], holding: boolean[], first: i32, d: i32, at0: i32, slots: i32): Holds {
  let h: Holds = Holds { blocks: [f.graph.blocks[first].id], at: [at0], slots: slots };
  let bj: i32 = first + 1;
  while (bj < dying.len()) {
    let j: i32 = util.index_of_i32(dying[bj].values, d);
    if (!holding[bj] && j >= 0 && can_hold(f.graph.blocks[bj]) && donor_slots(f, f.graph.blocks[bj], d) == slots) {
      h = Holds { ...h, blocks: h.blocks.append(f.graph.blocks[bj].id), at: h.at.append(dying[bj].at[j]) };
    }
    bj = bj + 1;
  }
  return h;
}

function can_hold(b: ssa.SBlock): boolean {
  return successors(b.term).len() > 0;
}

function carried_pairs(f: ssasem.Func, p: ssaunits.Plan, idx: i32[][], links: i32[], off: boolean): Carry {
  let c: Carry = no_carry();
  if (off) {
    return c;
  }
  let g: RouteGraph = route_graph(f, p);
  let marks: RouteMarks = route_marks(f.graph.blocks.len());
  let dying: Dying[] = [];
  let holding: boolean[] = [];
  for b in f.graph.blocks {
    dying = dying.append(dying_after_claims(p, idx, links, b, last_claim(f, p, b)));
    holding = holding.append(false);
  }
  let bi: i32 = 0;
  while (bi < dying.len()) {
    // One donor leaves a block. The first dying value whose count some
    // construction ahead claims goes; a count held in this block alone and
    // without a route is tried once.
    let b: ssa.SBlock = f.graph.blocks[bi];
    let tried: i32[] = [];
    let i: i32 = 0;
    while (!holding[bi] && can_hold(b) && i < dying[bi].values.len()) {
      let d: i32 = dying[bi].values[i];
      let slots: i32 = donor_slots(f, b, d);
      if (slots >= 0) {
        let h: Holds = holds_of(f, dying, holding, bi, d, dying[bi].at[i], slots);
        if (h.blocks.len() > 1 || util.index_of_i32(tried, slots) < 0) {
          tried = tried.append(slots);
          let found: Searched = carry_routes(f, g, h.blocks, marks, slots);
          marks = found.marks;
          let before: i32 = c.to.len();
          c = served_by(f, p, g, c, h, found.routes, d);
          if (c.to.len() > before) {
            for id in h.blocks {
              holding = holding.with(g.at[id], true);
            }
          }
        }
      }
      i = i + 1;
    }
    bi = bi + 1;
  }
  return c;
}

// `c` with donor `d` held in `h` and handed to each construction of `r` that
// does not read it and that no earlier carry serves; the rest are left, and
// any edge into one drops the donor. Nothing is added when no construction is.
function served_by(f: ssasem.Func, p: ssaunits.Plan, g: RouteGraph, own c: Carry, h: Holds, r: Routes, d: i32): Carry {
  let targets: i32[] = [];
  let builds: i32[] = [];
  let inside: i32[] = [];
  let k: i32 = 0;
  while (k < r.targets.len()) {
    let to: ssa.SBlock = f.graph.blocks[g.at[r.targets[k]]];
    let at_build: i32 = first_claim_of(f, p, to, h.slots);
    if (util.index_of_i32(c.to, to.id) < 0 && util.index_of_i32(to.insts[at_build].args, d) < 0) {
      targets = targets.append(to.id);
      builds = builds.append(at_build);
      for id in r.ways[k] {
        inside = inside.append(id);
      }
    }
    k = k + 1;
  }
  if (targets.len() == 0) {
    return c;
  }
  k = 0;
  while (k < targets.len()) {
    c = Carry { ...c, to: c.to.append(targets[k]), build_at: c.build_at.append(builds[k]), donor: c.donor.append(d) };
    k = k + 1;
  }
  k = 0;
  while (k < h.blocks.len()) {
    c = Carry { ...c, from: c.from.append(h.blocks[k]), drop_at: c.drop_at.append(h.at[k]), held: c.held.append(d) };
    k = k + 1;
  }
  let leaving: i32[] = h.blocks;
  for id in inside {
    if (util.index_of_i32(leaving, id) < 0) {
      leaving = leaving.append(id);
    }
  }
  for id in leaving {
    for s in successors(f.graph.blocks[g.at[id]].term) {
      if (util.index_of_i32(targets, s) < 0 && util.index_of_i32(inside, s) < 0) {
        c = Carry { ...c, exit_from: c.exit_from.append(id), exit_to: c.exit_to.append(s), dropped: c.dropped.append(d) };
      }
    }
  }
  return c;
}

// The donors whose ways the edge from `from` to `to` leaves, dropped there.
function carry_exits(c: Carry, from: i32, to: i32): i32[] {
  let out: i32[] = [];
  let e: i32 = 0;
  while (e < c.exit_from.len()) {
    if (c.exit_from[e] == from && c.exit_to[e] == to) {
      out = out.append(c.dropped[e]);
    }
    e = e + 1;
  }
  return out;
}

// The donor held rather than dropped at position `pos` of block `b`, or -1.
function carry_held(c: Carry, b: i32, pos: i32): i32 {
  let i: i32 = 0;
  while (i < c.from.len()) {
    if (c.from[i] == b && c.drop_at[i] == pos) {
      return c.held[i];
    }
    i = i + 1;
  }
  return 0 - 1;
}

function reuse_pairs(f: ssasem.Func, p: ssaunits.Plan, idx: i32[][], b: ssa.SBlock, off: boolean, carry: Carry): ReusePairs {
  let into: i32 = util.index_of_i32(carry.to, b.id);
  let tokens: i32[] = [];
  let builds: i32[] = [];
  let selfs: i32[] = [];
  let claims_tab: Claims = block_claims(f, p, b);
  let pending: i32 = 0 - 1;
  let pending_at: i32 = 0 - 1;
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    tokens = tokens.append(0 - 1);
    builds = builds.append(0 - 1);
    selfs = selfs.append(0 - 1);
    let ins: ssa.SInst = b.insts[pos];
    if (into >= 0 && carry.build_at[into] == pos) {
      selfs = selfs.with(pos, carry.donor[into]);
    } else if (ins.kind_tag != 6 && ins.kind_tag != 8) {
      let step: ssaunits.Step = at(p, idx, b.id, pos, 0 - 1);
      let claims: i32 = recipient_slots(f, p, ins);
      if (off || into >= 0 && pos < carry.build_at[into]) {
        pending = 0 - 1;
      } else {
        if (claims >= 0 && pending >= 0
          && claims == donor_slots(f, b, pending)
          && util.index_of_i32(ins.args, pending) < 0) {
          builds = builds.with(pos, pending);
          tokens = tokens.with(pending_at, pending);
          pending = 0 - 1;
          pending_at = 0 - 1;
        } else if (pending < 0 && claims >= 0) {
          // Nothing earlier serves this construction, so the box it
          // supersedes may: a value dying HERE, of the count this
          // construction claims, that the construction does not read.
          // Not reading it is what makes it safe to hand on — the
          // projections that carried its fields over are earlier
          // instructions, and the plan has already proved it dead.
          //
          // `d != ins.result` excludes the degenerate donor: a
          // construction whose value is never read has its drop at its
          // own step, so the value dying here IS the result. Pairing it
          // with itself reads a token slot for a value that does not
          // exist yet, which always declines — and it costs the
          // module its last allocating op, so the heap runtime block
          // stopped being emitted and the link broke on an undefined
          // `__fn___fern_arr_dec`.
          //
          // `pending < 0` is a soundness condition, not a preference:
          // the frame has ONE token slot, so a self pairing emitted
          // while a donor is held for a later construction overwrites
          // that donor's box with its own — which this construction
          // has already built into and is returning live.
          for d in step.drops {
            if (selfs[pos] < 0 && d != ins.result
              && donor_slots(f, b, d) == claims
              && util.index_of_i32(ins.args, d) < 0) {
              selfs = selfs.with(pos, d);
            }
          }
        }
        // A construction this pending cannot serve leaves it HELD
        // rather than dropped, the one it is waiting for being further
        // down the block. A value dying AT a construction was offered
        // to that construction above and is not taken as a pending
        // here: the shape that reading was worth — a dying box refilling
        // the slot the construction just emptied — is the same-instruction
        // pairing, which spends it on the spot rather than saving it.
        if (pending < 0 && claims < 0) {
          for d in step.drops {
            let sl: i32 = donor_slots(f, b, d);
            if (pending < 0 && sl >= 0 && claimed_after(claims_tab, sl, pos)) {
              pending = d;
              pending_at = pos;
            }
          }
        }
      }
    }
    pos = pos + 1;
  }
  return ReusePairs { tokens: tokens, builds: builds, selfs: selfs };
}

// The donor's box when this frame holds its only count, and null otherwise —
// the token recipe of docs/SELFHOST-PERCEUS-REUSE.md §6.2, emitted in place of
// the drop. The runtime helper is pure: it hands a token back when the size
// class matches and allocates when the token is null, so the shared arm
// releases the donor's count here and passes null. The static plan already
// proved the donor dead; the count test makes a hole in that proof degrade to a
// fresh box rather than corrupt one another holder still reads (#4350).
//
// A donor owning references gives up its children here, through the same
// helper `drop_value` calls under the same uniqueness gate — the box arrives
// at the construction as storage and nothing else. The helper releases the
// CHILDREN ONLY, which is what makes it the one to call: the box itself is not
// freed but handed on, and the runtime's mismatch path frees a donor block
// shallowly, so its children are owed here either way.
function reuse_token(own r: irtables.LowerResult, f: ssasem.Func, donor: i32): irtables.LowerResult {
  let token: i32 = token_slot(f);
  r = reserve(r, scratch_base(f));
  r = emit(r, ir.op_load_local(donor));
  r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
  r = emit(r, ir.op_if(0));
  if (has_children(f.values[donor], f)) {
    r = drop_children(r, donor, f.values[donor], scratch_base(f), f);
  }
  r = emit(r, ir.op_load_local(donor));
  r = emit(r, ir.op_store_local(token));
  r = emit(r, ir.op_else());
  r = release(r, donor, f.values[donor], f);
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_store_local(token));
  r = emit(r, ir.op_end());
  // Dead from here: the box is the construction's, and nothing may reach it
  // through the name it arrived under.
  r = emit(r, ir.op_const_i32(0));
  return emit(r, ir.op_store_local(donor));
}

// A construction that rebuilds its own donor keeps in place every field it
// reads from the donor's slot of the same index and takes a unit of, whether
// by a take at the read (took_payload) or a retain at the construction: when
// the donor is unique the field is already where the construction stores it,
// so the unit the donor holds is the construction's, and neither the take's
// null nor the retain nor the donor's release of that field is emitted. The
// donor's uniqueness is read ONCE, at the first such read, into the token slot,
// and the reads, the retains, the donor's release and the construction all
// follow that one answer: a donor read as shared there has its kept fields
// retained and is released whole, whatever its count says by the time it dies.
// A scalar field read from the same slot is kept too: it holds no unit, so
// only its store is skipped, and the uniqueness read waits for the donor's drop.
//
// The token slot is held from that first read to the construction, so a donor
// is kept only where no other pairing's token is live in between. `start` is
// the position of the first counted kept read, else the donor's drop, and
// `taken` the donor's drop.
//
// A kept field the construction alone reads is not read at all while the
// donor is unique: its slot is already the construction's. `late` holds those
// values; the construction copies them from the donor, a counted one retained,
// under the token's null arm, where its box is fresh (reuse_construct).
struct Keeps { donors: i32[], slots: boolean[][], values: i32[][], late: i32[][], start: i32[], taken: i32[], built: i32[] }

function keep_slots(f: ssasem.Func, p: ssaunits.Plan, idx: i32[][], b: ssa.SBlock, ins: ssa.SInst, built: i32, donor: i32, taken: i32, uses: i32[]): Keeps {
  let none: Keeps = Keeps { donors: [], slots: [], values: [], late: [], start: [], taken: [], built: [] };
  if (ins.kind_tag != ssasem.record_new() || !semtypes.equal(f.values[ins.result], f.values[donor])) {
    return none;
  }
  let slots: boolean[] = [];
  while (slots.len() < ins.args.len()) {
    slots = slots.append(false);
  }
  let values: i32[] = [];
  let late: i32[] = [];
  let start: i32 = 0 - 1;
  let retained: i32[] = [];
  for supply in at(p, idx, b.id, built, 0 - 1).supplies {
    if (supply.mode == ssaunits.retain_unit()) {
      retained = retained.append(supply.value);
    }
  }
  let scalars: boolean = false;
  let pos: i32 = 0;
  while (pos <= taken) {
    let get: ssa.SInst = b.insts[pos];
    // A counted read keeps exactly one unit: one taken AND retained at the
    // construction holds two, and keeping in place stands in for one. A
    // scalar read has no unit and is kept as it stands.
    let counted: boolean = get.kind_tag == ssasem.record_get() && walked(f.values[get.result]);
    if (get.kind_tag == ssasem.record_get() && get.args[0] == donor
      && (!counted || payload_taken(f, p, get) != util.index_of_i32(retained, get.result) >= 0)) {
      let i: i32 = util.index_of_i32(ins.args, get.result);
      // Once: the donor's slot holds one unit, which a second operand
      // naming the same value would need a retain of its own for.
      if (i == get.imm && !slots[i] && ssaunits.occurrences(ins.args, get.result) == 1) {
        values = values.append(get.result);
        slots = slots.with(i, true);
        if (uses[get.result] == 1 && !held_read(p, get)) {
          late = late.append(get.result);
        }
        // Only a counted read needs the donor's uniqueness at the read.
        if (!counted) {
          scalars = true;
        } else if (start < 0) {
          start = pos;
        }
      }
    }
    pos = pos + 1;
  }
  if (start < 0 && scalars) {
    start = taken;
  }
  if (start < 0) {
    return none;
  }
  return Keeps { donors: [donor], slots: [slots], values: [values], late: [late], start: [start], taken: [taken], built: [] };
}

// A read the plan gives an effect of its own at its position: a take that
// nulls a tuple slot, or a hold that retains the element.
function held_read(p: ssaunits.Plan, ins: ssa.SInst): boolean {
  return ins.result < p.takes.len() && p.takes[ins.result] >= 0
    || ins.result < p.held.len() && p.held[ins.result];
}

// How many operands name each value, over every instruction and terminator
// of the function.
function use_counts(f: ssasem.Func): i32[] {
  let out: i32[] = __alloc_i32(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      for a in ins.args {
        out = out.with(a, out[a] + 1);
      }
    }
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      out = out.with(b.term.value, out[b.term.value] + 1);
    }
    if (b.term.kind_tag == 3) {
      out = out.with(b.term.cond, out[b.term.cond] + 1);
    }
  }
  return out;
}

// Every pairing's token interval in the block: `from` where the token is taken,
// `to` where it is spent.
function token_busy(pairs: ReusePairs, from: i32, to: i32, own_build: i32): boolean {
  let pos: i32 = 0;
  while (pos < pairs.builds.len()) {
    if (pos != own_build) {
      if (pairs.selfs[pos] >= 0 && pos >= from && pos <= to) {
        return true;
      }
      if (pairs.builds[pos] >= 0 && pos >= from) {
        let t: i32 = util.index_of_i32(pairs.tokens, pairs.builds[pos]);
        if (t <= to) {
          return true;
        }
      }
    }
    pos = pos + 1;
  }
  return false;
}

function block_keeps(f: ssasem.Func, p: ssaunits.Plan, idx: i32[][], b: ssa.SBlock, pairs: ReusePairs, uses: i32[]): Keeps {
  let out: Keeps = Keeps { donors: [], slots: [], values: [], late: [], start: [], taken: [], built: [] };
  let pos: i32 = 0;
  while (pos < b.insts.len()) {
    let donor: i32 = pairs.selfs[pos];
    let taken: i32 = pos;
    if (donor < 0 && pairs.builds[pos] >= 0) {
      donor = pairs.builds[pos];
      taken = util.index_of_i32(pairs.tokens, donor);
    }
    if (donor >= 0 && taken >= 0) {
      let k: Keeps = keep_slots(f, p, idx, b, b.insts[pos], pos, donor, taken, uses);
      if (k.donors.len() > 0 && !token_busy(pairs, k.start[0], pos, pos)) {
        out = Keeps {
          donors: out.donors.append(donor), slots: out.slots.append(k.slots[0]),
          values: out.values.append(k.values[0]), late: out.late.append(k.late[0]),
          start: out.start.append(k.start[0]), taken: out.taken.append(taken), built: out.built.append(pos),
        };
      }
    }
    pos = pos + 1;
  }
  return out;
}

function kept_values(k: Keeps): i32[] {
  let out: i32[] = [];
  for vs in k.values {
    for v in vs {
      out = out.append(v);
    }
  }
  return out;
}

// Whether a keep's donor dies at `pos` for a construction later in the block:
// its box is released at that construction, not here.
function token_kept(k: Keeps, pos: i32): boolean {
  let i: i32 = 0;
  while (i < k.taken.len()) {
    if (k.taken[i] == pos && k.built[i] != pos) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function late_values(k: Keeps): i32[] {
  let out: i32[] = [];
  for vs in k.late {
    for v in vs {
      out = out.append(v);
    }
  }
  return out;
}

// The token as the kept steals read it: the donor's box when it is unique,
// null when it is shared.
function keep_token(own r: irtables.LowerResult, f: ssasem.Func, donor: i32): irtables.LowerResult {
  let token: i32 = token_slot(f);
  r = reserve(r, scratch_base(f));
  r = emit(r, ir.op_load_local(donor));
  r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(donor));
  r = emit(r, ir.op_store_local(token));
  r = emit(r, ir.op_else());
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_store_local(token));
  return emit(r, ir.op_end());
}

// The kept donor's drop: a unique donor gives up the children it does not keep
// and its box is the token; a shared one is released as any dying value.
function keep_release(own r: irtables.LowerResult, f: ssasem.Func, donor: i32, slots: boolean[]): irtables.LowerResult {
  r = emit(r, ir.op_load_local(token_slot(f)));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_bin("ne", 0, false));
  r = emit(r, ir.op_if(0));
  r = drop_fields_except(r, donor, record_fields(f.values[donor], f), slots, scratch_base(f), f);
  r = emit(r, ir.op_else());
  r = drop_value(r, donor, f.values[donor], scratch_base(f), f);
  r = emit(r, ir.op_end());
  r = emit(r, ir.op_const_i32(0));
  return emit(r, ir.op_store_local(donor));
}

// drop_record_fields over the fields `skip` does not mark.
function drop_fields_except(own r: irtables.LowerResult, slot: i32, fields: semrecords.Field[], skip: boolean[], scratch: i32, f: ssasem.Func): irtables.LowerResult {
  let child: i32 = scratch;
  r = reserve(r, child + 1);
  let i: i32 = 0;
  while (i < fields.len()) {
    if (walked(fields[i].ty) && !(i < skip.len() && skip[i])) {
      r = emit(r, ir.op_load_local(slot));
      r = emit(r, ir.op_struct_get(i, 0));
      r = emit(r, ir.op_store_local(child));
      r = drop_value(r, child, fields[i].ty, child + 1, f);
    }
    i = i + 1;
  }
  return r;
}

// A construction with a keep (block_keeps, `at` its row) stores the kept
// slots only under the token's null arm, where its box is fresh: a late read
// is copied from the donor there, retained, and any other kept operand is
// stored from its local. The donor's drop follows, inside the same
// construction: a unique donor gives up the children the construction
// replaces before their slots are overwritten, and a shared one is released
// once its kept fields are copied. The replaced slots are stored last.
function reuse_construct(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst, k: Keeps, at: i32): irtables.LowerResult {
  if (ins.kind_tag == ssasem.tuple_new()) {
    return reuse_tuple(r, f, ins);
  }
  // A declared variant's box is laid out as a record's: the shape word
  // `struct_make` writes, naming the variant, then the variant's fields.
  let fields: semrecords.Field[] = [];
  let shape: string = ins.str;
  if (ins.kind_tag == ssasem.variant_new()) {
    let owner: semrecords.Enum = f.enums[semrecords.find_enum(f.enums, f.values[ins.result])];
    fields = owner.variants[variant_tag(f, f.values[ins.result], ins.str)].fields;
  } else {
    fields = record_fields(f.values[ins.result], f);
    shape = record_name(f.values[ins.result]);
  }
  // A kept donor has the construction's own type, so a token is a box of the
  // right size whose first word already names the type: it is the result as
  // it stands, and only the fresh box of the null arm is allocated and shaped.
  if (at >= 0) {
    r = emit(r, ir.op_load_local(token_slot(f)));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_bin("eq", 0, false));
    r = emit(r, ir.op_if(0));
  }
  r = emit(r, ir.op_load_local(token_slot(f)));
  r = emit(r, ir.op_const_i32(fields.len() + 1));
  r = emit(r, ir.op_call_direct("__fern_alloc_reuse", 2));
  r = emit(r, ir.op_store_local(ins.result));
  // The box's first word identifies its type, and `struct_make` is what
  // normally writes it. A construction building through a token never runs
  // that op, and neither box that reaches it carries the right word: the
  // donor's is the DONOR's, and the fresh one holds the length `__fern_arr_box`
  // wrote. So the recipient writes its own, which is also what lets a donor of
  // another type serve it.
  r = emit(r, ir.op_load_local(ins.result));
  r = emit(r, ir.op_struct_set_shape(shape));
  r = emit(r, ir.op_drop());
  let kept: boolean[] = [];
  if (at >= 0) {
    kept = k.slots[at];
    let ki: i32 = 0;
    while (ki < ins.args.len() && ki < fields.len()) {
      if (ki < kept.len() && kept[ki]) {
        r = emit(r, ir.op_load_local(ins.result));
        if (util.index_of_i32(k.late[at], ins.args[ki]) >= 0) {
          r = emit(r, ir.op_load_local(k.donors[at]));
          r = field_get(r, f, ssa.SInst { kind_tag: ssasem.record_get(), result: ins.args[ki], args: [k.donors[at]], imm: ki, str: "" });
          if (walked(fields[ki].ty)) {
            r = emit(r, ir.op_call_direct("__fern_rc_inc", 1));
          }
        } else {
          r = emit(r, ir.op_load_local(ins.args[ki]));
        }
        r = field_store(r, fields, ki);
      }
      ki = ki + 1;
    }
    r = emit(r, ir.op_else());
    r = emit(r, ir.op_load_local(token_slot(f)));
    r = emit(r, ir.op_store_local(ins.result));
    r = emit(r, ir.op_end());
    r = keep_release(r, f, k.donors[at], kept);
  }
  let i: i32 = 0;
  while (i < ins.args.len() && i < fields.len()) {
    if (!(i < kept.len() && kept[i])) {
      r = emit(r, ir.op_load_local(ins.result));
      r = emit(r, ir.op_load_local(ins.args[i]));
      r = field_store(r, fields, i);
    }
    i = i + 1;
  }
  return r;
}

// The store of field `i` from the box and the value on the stack.
function field_store(own r: irtables.LowerResult, fields: semrecords.Field[], i: i32): irtables.LowerResult {
  if (ssasem.is_wide(fields[i].ty)) {
    return emit(r, ir.op_struct_set_i64(i));
  }
  return emit(r, ir.op_struct_set(i, load_width(fields[i].ty)));
}

// A tuple box has no shape word: element i is slot i, so the box is one word
// per element and there is nothing at slot 0 to identify. The element stores
// carry their own width, as `op_tuple_make_k` does on the fresh path, or wasm
// writes the low half of an eight-byte slot and the read back is garbage.
function reuse_tuple(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let elems: typeinfo.Type[] = tuple_elements(f.values[ins.result]);
  r = emit(r, ir.op_load_local(token_slot(f)));
  r = emit(r, ir.op_const_i32(elems.len()));
  r = emit(r, ir.op_call_direct("__fern_alloc_reuse", 2));
  r = emit(r, ir.op_store_local(ins.result));
  let i: i32 = 0;
  while (i < ins.args.len() && i < elems.len()) {
    r = emit(r, ir.op_load_local(ins.result));
    r = emit(r, ir.op_load_local(ins.args[i]));
    let kind: string = tuple_kind(elems[i]);
    if (kind == "i64") {
      r = emit(r, ir.op_tuple_set_w(i, 64, true));
    } else if (kind == "f64") {
      r = emit(r, ir.op_tuple_set_w(i, 64, false));
    } else {
      r = emit(r, ir.op_tuple_set(i));
    }
    i = i + 1;
  }
  return r;
}

function tuple_elements(t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements;
  }
  return [];
}

function at(p: ssaunits.Plan, idx: i32[][], block: i32, point: i32, target: i32): ssaunits.Step {
  let i: i32 = ssaunits.step_at(p, idx, block, point, target);
  if (i >= 0) {
    return p.steps[i];
  }
  // Unreachable after verification of the complete plan.
  return ssaunits.Step { block: 0 - 1, point: point, target: 0 - 1, supplies: [], drops: [], hand_roots: [], hand_fields: [] };
}

function successors(t: ssa.STerm): i32[] {
  if (t.kind_tag == 2) {
    return [t.target];
  }
  if (t.kind_tag == 3) {
    if (t.t == t.f) {
      return [t.t];
    }
    return [t.t, t.f];
  }
  return [];
}

// `dest_at` is the target's position in the block list.
function edge(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, idx: i32[][], links: i32[], from: i32, target: i32, dest_at: i32): irtables.LowerResult {
  let step: ssaunits.Step = at(p, idx, from, ssaunits.edge_point(), target);
  let dest: ssa.SBlock = f.graph.blocks[dest_at];
  r = supplies(r, f, p, owed_on_entry(step, dest, links), false, [], []);
  let pi: i32 = 0;
  while (dest.preds[pi] != from) {
    pi = pi + 1;
  }
  // All phi sources remain on the operand stack while old edge units are
  // released. Assign in reverse stack order, after every source was read.
  // Drop helpers and their nested scopes preserve the existing stack prefix.
  for ins in dest.insts {
    if (ins.kind_tag == 8) {
      r = emit(r, ir.op_load_local(ins.args[pi]));
    }
  }
  r = drops(r, step, f, links);
  let i: i32 = dest.insts.len() - 1;
  while (i >= 0) {
    let ins: ssa.SInst = dest.insts[i];
    if (ins.kind_tag == 8) {
      r = emit(r, ir.op_store_local(ins.result));
    }
    i = i - 1;
  }
  return r;
}

// What a schema field has to satisfy is weaker than what a value has to: the
// walk visits only the REFERENCE fields, so a scalar one needs no vocabulary
// here at all, and an array or tuple of scalars needs only its own box
// released. Asking `supported` of every field instead refuses a function for
// a field it never reads.
// An array's element store carries its own width, so a 64-bit element has a
// form there. A tuple construction and a closure box write one i32-shaped word
// per operand and have none. A record or variant stores each field at the
// width its declaration names, which is what `op_struct_make` carries as the
// declaration index; a wide field of a construction whose declaration is not
// in the table has no store width to carry.
function construction_error(f: ssasem.Func, ins: ssa.SInst, structs: irtables.StructTab): string {
  let declared: boolean = ins.kind_tag == ssasem.record_new() || ins.kind_tag == ssasem.variant_new();
  // A builtin union names no declaration and needs none: its box carries the
  // payload's width in the op (`op_opt_make_w`) rather than reading it from a
  // field table.
  if (ins.kind_tag == ssasem.variant_new() && enum_layout(f, f.values[ins.result]) == semrecords.layout_option()) {
    return "";
  }
  for arg in ins.args {
    if (narrow_slot(f.values[arg])) {
      continue;
    }
    if (!declared) {
      if (!wide_element_site(ins.kind_tag)) {
        return "unsupported physical RC construction element";
      }
    } else if (decl_of(f, ins, structs) < 0) {
      return "unsupported physical RC construction without declaration";
    }
  }
  return "";
}

// The undeclared constructions that carry their own element width: the array
// ops, of which a cell's slot is one, and the tuple construction through the
// kinds `tuple_kinds` names.
// A dyn box stores its primitive at the width the primitive's name gives.
function wide_element_site(k: i32): boolean {
  return kind_in(
    [
      ssasem.array_new(), ssasem.tuple_new(), ssasem.append(), ssasem.with(),
      ssasem.cell_new(), ssasem.cell_set(), ssasem.dyn_box(),
    ],
    k,
  );
}

// The declaration a record or variant construction stores its fields
// through: a record's by its name, a variant's by its name within its enum,
// since two enums may declare one variant name with differently sized
// payloads. -1 when the table holds no such declaration.
function decl_of(f: ssasem.Func, ins: ssa.SInst, structs: irtables.StructTab): i32 {
  if (ins.kind_tag == ssasem.record_new()) {
    return irtables.decl_index_of(structs, record_name(f.values[ins.result]));
  }
  let whole: typeinfo.Type = f.values[ins.result];
  return irtables.variant_decl_index(structs, ssasem.variant_key(whole, ins.str), ssasem.type_key(whole));
}

function enum_name(t: typeinfo.Type): string {
  if let typeinfo.TypeUnion(u) = t {
    return u.name;
  }
  return "";
}

function walk_shape(t: typeinfo.Type, f: ssasem.Func, lookup: boolean): boolean {
  if let typeinfo.TypeArray(a) = t {
    return walk_shape(a.elem, f, lookup);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      if (!walk_shape(e, f, lookup)) {
        return false;
      }
    }
    return true;
  }
  if (ssasem.reference(t)) {
    return rc_shape(t, f, lookup);
  }
  // A handle stores as the descriptor word and its release walks
  // nothing, so a field or payload of one is walkable without a schema.
  if (semtypes.is_handle(t)) {
    return true;
  }
  if let typeinfo.TypeI32(_) = t {
    return true;
  }
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  if let typeinfo.TypeFloat(fl) = t {
    if (fl.width == 32 || fl.width == 64) {
      return true;
    }
  }
  return false;
}

function record_walk(r: semrecords.Record, f: ssasem.Func): boolean {
  for field in r.fields {
    if (!walk_shape(field.ty, f, false)) {
      return false;
    }
  }
  return true;
}

function enum_walk(e: semrecords.Enum, f: ssasem.Func): boolean {
  for vr in e.variants {
    // No physical payload exists for a variant with an uninhabited field.
    if (!semrecords.inhabited(vr)) {
      continue;
    }
    for field in vr.fields {
      if (!walk_shape(field.ty, f, false)) {
        return false;
      }
    }
  }
  return true;
}

function schema_types_error(f: ssasem.Func, view: ssaunits.SchemaView): string {
  let fits: boolean = ssaunits.view_fits(view, f);
  let i: i32 = 0;
  while (i < f.records.list.len()) {
    let ok: boolean = false;
    if (fits) {
      ok = view.rec_walk[i];
    } else {
      ok = record_walk(f.records.list[i], f);
    }
    if (!ok) {
      return "unsupported physical RC record field type";
    }
    i = i + 1;
  }
  i = 0;
  while (i < f.enums.len()) {
    let ok: boolean = false;
    if (fits) {
      ok = view.enum_walk[i];
    } else {
      ok = enum_walk(f.enums[i], f);
    }
    if (!ok) {
      return "unsupported physical RC variant field type";
    }
    i = i + 1;
  }
  return "";
}

// SchemaSeen is every distinct record and enum schema_views has met, with the
// verdicts it formed for each, indexed by name like a function's own table.
struct SchemaSeen {
  recs: semrecords.Record[],
  rec_names: util.NameIndex,
  rec_unit: boolean[],
  rec_walk: boolean[],
  enums: semrecords.Enum[],
  enum_names: util.NameIndex,
  enum_unit: boolean[],
  enum_walk: boolean[],
}

struct ViewStep { seen: SchemaSeen, view: ssaunits.SchemaView }

// schema_views forms every function's schema checks once per module: a record
// or enum several functions' tables hold is checked once, and each function's
// view carries the verdicts for its own table.
pub function schema_views(funcs: ssasem.Func[]): ssaunits.SchemaView[] {
  let none: string[] = [];
  let seen: SchemaSeen = SchemaSeen { recs: [], rec_names: util.name_index(none), rec_unit: [], rec_walk: [], enums: [], enum_names: util.name_index(none), enum_unit: [], enum_walk: [] };
  let out: ssaunits.SchemaView[] = [];
  for f in funcs {
    let step: ViewStep = view_of(f, seen);
    seen = step.seen;
    out = out.append(step.view);
  }
  return out;
}

function view_of(f: ssasem.Func, own seen: SchemaSeen): ViewStep {
  let view: ssaunits.SchemaView = ssaunits.no_view();
  for r in f.records.list {
    let name: string = semrecords.record_name(r);
    let k: i32 = semrecords.find_named(seen.recs, seen.rec_names, name, r.ty);
    if (k < 0) {
      k = seen.recs.len();
      seen = SchemaSeen { ...seen, recs: seen.recs.append(r), rec_names: seen.rec_names.added(name), rec_unit: seen.rec_unit.append(ssaunits.record_unit(r, f)), rec_walk: seen.rec_walk.append(record_walk(r, f)) };
    }
    view = ssaunits.SchemaView { ...view, rec_unit: view.rec_unit.append(seen.rec_unit[k]), rec_walk: view.rec_walk.append(seen.rec_walk[k]) };
  }
  for e in f.enums {
    let name: string = enum_name(e.ty);
    let k: i32 = enum_seen(seen, name, e.ty);
    if (k < 0) {
      k = seen.enums.len();
      seen = SchemaSeen { ...seen, enums: seen.enums.append(e), enum_names: seen.enum_names.added(name), enum_unit: seen.enum_unit.append(ssaunits.enum_unit(e, f)), enum_walk: seen.enum_walk.append(enum_walk(e, f)) };
    }
    view = ssaunits.SchemaView { ...view, enum_unit: view.enum_unit.append(seen.enum_unit[k]), enum_walk: view.enum_walk.append(seen.enum_walk[k]) };
  }
  return ViewStep { seen: seen, view: view };
}

function enum_seen(seen: SchemaSeen, name: string, ty: typeinfo.Type): i32 {
  let i: i32 = seen.enum_names.chain(name);
  while (i >= 0) {
    if (seen.enum_names.names[i] == name && semtypes.equal(seen.enums[i].ty, ty)) {
      return i;
    }
    i = seen.enum_names.next[i];
  }
  return 0 - 1;
}

function named(t: typeinfo.Type): string {
  if (semtypes.is_cell(t)) {
    return "";
  }
  if let typeinfo.TypeStruct(r) = t {
    return r.name;
  }
  if let typeinfo.TypeUnion(u) = t {
    return u.name;
  }
  return "";
}

// A nominal type's children are released by its own helper rather than by an
// inline expansion. The descent that would close a cycle is a call, so a type
// that reaches itself still has a finite lowering. The helper releases the
// box's CHILDREN ONLY: its caller has already proved __fern_rc_is_unique(box)
// and releases the box itself once the helper returns.
pub function drop_helper_name(t: typeinfo.Type): string {
  return "__sem_drop_" + ssasem.type_key(t);
}

// The release of ONE value of a map's column of boxes, called by the runtime
// on the entry an insert supersedes and on every entry the map's release
// walks: the same drop a frame gives a unit of the type it holds.
pub function release_helper_name(t: typeinfo.Type): string {
  return "__sem_release_" + ssasem.type_key(t);
}

function release_helper(t: typeinfo.Type, f: ssasem.Func): irtables.LowerResult {
  let r: irtables.LowerResult = irtables.LowerResult {
    ...empty(""), ok: true,
    n_params: 1, n_locals: 1, name: release_helper_name(t),
  };
  r = drop_value_inline(r, 0, t, 1, f);
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_return());
  return r;
}

// The element types of the columns of boxes the schema's `maps` name — a
// keyed key column's and a boxed value column's — each once.
function boxed_columns(maps: typeinfo.Type[]): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let names: string[] = [];
  for t in maps {
    let cols: typeinfo.Type[] = [];
    if (ssasem.keyed_map_key(ssasem.map_key(t))) {
      cols = cols.append(ssasem.map_key(t));
    }
    if (ssasem.boxed_map_value(ssasem.map_value(t))) {
      cols = cols.append(ssasem.map_value(t));
    }
    for v in cols {
      let name: string = release_helper_name(v);
      if (util.index_of_str(names, name) >= 0) {
        continue;
      }
      names = names.append(name);
      out = out.append(v);
    }
  }
  return out;
}

// The box value columns of the schema's `maps` that run on core/map, each
// once.
function routed_box_columns(maps: typeinfo.Type[], f: ssasem.Func): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let names: string[] = [];
  for t in maps {
    if (!ssasem.is_map(t) || !routed_box(ssasem.map_value(t))) {
      continue;
    }
    let name: string = env_release_name(ssasem.map_value(t));
    if (util.index_of_str(names, name) >= 0) {
      continue;
    }
    names = names.append(name);
    out = out.append(ssasem.map_value(t));
  }
  return out;
}

// The map types among this function's values and schema fields, in that
// order, and whether any of those values and fields, map or not, contains a
// byte view.
struct SchemaScan { maps: typeinfo.Type[], bytes: boolean }

function schema_scan(f: ssasem.Func): SchemaScan {
  let sc: SchemaScan = SchemaScan { maps: [], bytes: false };
  for t in f.values {
    sc = scan_schema_type(sc, t);
  }
  for rec in f.records.list {
    for field in rec.fields {
      sc = scan_schema_type(sc, field.ty);
    }
  }
  for e in f.enums {
    for v in e.variants {
      for field in v.fields {
        sc = scan_schema_type(sc, field.ty);
      }
    }
  }
  return sc;
}

function scan_schema_type(own sc: SchemaScan, t: typeinfo.Type): SchemaScan {
  if (!sc.bytes && contains_byte_view(t)) {
    sc = SchemaScan { ...sc, bytes: true };
  }
  if (ssasem.is_map(t)) {
    sc = SchemaScan { ...sc, maps: sc.maps.append(t) };
  }
  return sc;
}

function env_release_name(t: typeinfo.Type): string {
  return release_helper_name(t) + "$env";
}

// The routed maps among the schema's `maps` whose key column is keyed, each
// once.
function routed_keyed_maps(maps: typeinfo.Type[], f: ssasem.Func): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let names: string[] = [];
  for t in maps {
    if (!ssasem.is_map(t) || !ssasem.keyed_map_key(ssasem.map_key(t))) {
      continue;
    }
    let name: string = ssasem.type_key(t);
    if (util.index_of_str(names, name) < 0) {
      names = names.append(name);
      out = out.append(t);
    }
  }
  return out;
}

// What a keyed routed map hands core/map as function values: the key's hash
// and equality, the key's release, and the value's release, each a closure
// body taking its environment first. `done` grows as each is added, so two
// maps sharing a key or value type add its closure once.
function append_keyed_closures(own out: irtables.LowerResult[], t: typeinfo.Type, done: util.NameIndex): irtables.LowerResult[] {
  let k: typeinfo.Type = ssasem.map_key(t);
  let v: typeinfo.Type = ssasem.map_value(t);
  let fresh: irtables.LowerResult[] = [key_closure(k, "hash", 2), key_closure(k, "eq", 3), env_release_helper(k), value_env_helper(v)];
  for h in fresh {
    if (!done.has(h.name) && util.index_of_str(result_names(out), h.name) < 0) {
      out = out.append(h);
    }
  }
  return out;
}

function result_names(rows: irtables.LowerResult[]): string[] {
  let out: string[] = [];
  for r in rows {
    out = out.append(r.name);
  }
  return out;
}

// The closure body a keyed probe calls for `which`, "hash" or "eq": its
// environment, then the key or the two keys, handed to the key type's own
// function (ssasem.keyed_map_key_fn).
function key_closure(k: typeinfo.Type, which: string, nparams: i32): irtables.LowerResult {
  let r: irtables.LowerResult = irtables.LowerResult {
    ...empty(""), ok: true,
    n_params: nparams, n_locals: nparams, name: key_closure_name(k, which),
  };
  let p: i32 = 1;
  while (p < nparams) {
    r = emit(r, ir.op_load_local(p));
    p = p + 1;
  }
  r = emit(r, ir.op_call_direct(ssasem.keyed_map_key_fn(k, which), nparams - 1));
  return emit(r, ir.op_return());
}

function key_closure_name(k: typeinfo.Type, which: string): string {
  return "__sem_key" + which + "_" + ssasem.type_key(k) + "$env";
}

// The release of one value of a keyed routed map's column, as a closure: a
// string's or a view's, a box's through its type's helper, a wide value's
// cell, or nothing for a scalar.
function value_env_release(v: typeinfo.Type): string {
  if (ssasem.is_text(v)) {
    return "__sem_str_release$env";
  }
  if (routed_box(v)) {
    return env_release_name(v);
  }
  if (cell_column(v)) {
    return "__sem_cell_release$env";
  }
  return "__sem_scalar_release$env";
}

function value_env_helper(v: typeinfo.Type): irtables.LowerResult {
  if (routed_box(v)) {
    return env_release_helper(v);
  }
  let r: irtables.LowerResult = irtables.LowerResult {
    ...empty(""), ok: true,
    n_params: 2, n_locals: 2, name: value_env_release(v),
  };
  if (ssasem.is_text(v)) {
    r = emit(r, ir.op_load_local(1));
    r = emit(r, ir.op_call_direct("__fern_str_free", 1));
    return emit(r, ir.op_return());
  }
  if (cell_column(v)) {
    r = emit(r, ir.op_load_local(1));
    r = emit(r, ir.op_call_direct("__map_cell_free", 1));
    return emit(r, ir.op_return());
  }
  r = emit(r, ir.op_const_i32(0));
  return emit(r, ir.op_return());
}

// A box column's release in the shape a function value's body takes, its
// environment first: core/map's drop of a routed map calls it through a
// closure.
function env_release_helper(t: typeinfo.Type): irtables.LowerResult {
  let r: irtables.LowerResult = irtables.LowerResult {
    ...empty(""), ok: true,
    n_params: 2, n_locals: 2, name: env_release_name(t),
  };
  r = emit(r, ir.op_load_local(1));
  r = emit(r, ir.op_call_direct(release_helper_name(t), 1));
  r = emit(r, ir.op_return());
  return r;
}

// n_locals starts at n_params: `reserve` only grows it, and a body whose frame
// is smaller than its parameters puts the prologue's parameter copy below the
// allocated frame. The body is the raw op sequence: every function that
// mentions the type produces one, and `merge_helpers` runs the peephole once
// per symbol it keeps rather than once per producer.
function one_helper(t: typeinfo.Type, f: ssasem.Func): irtables.LowerResult {
  let r: irtables.LowerResult = irtables.LowerResult {
    ...empty(""), ok: true,
    n_params: 1, n_locals: 1, name: drop_helper_name(t),
  };
  // The finalizer runs first, while every field is still live.
  let finalizer: string = ssasem.finalizer_of(f, t);
  if (finalizer != "") {
    r = helper(r, 0, finalizer);
  }
  if let typeinfo.TypeStruct(_) = t {
    r = drop_record_fields(r, 0, record_fields(t, f), 1, f, semtypes.is_env(t));
  }
  if let typeinfo.TypeUnion(_) = t {
    if (self_tail_enum(t, f)) {
      r = drop_variant_chain(r, t, f);
    } else {
      r = drop_variant_fields(r, 0, t, 1, f);
    }
  }
  // The one value the caller's `drop` after the call discards.
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_return());
  return r;
}

function optimized_helper(h: irtables.LowerResult): irtables.LowerResult {
  let optimized: ir.OptimizedOps = ir.optimize_ops(h.ops, h.n_params, h.n_locals);
  return irtables.LowerResult { ...h, ops: optimized.ops, n_locals: optimized.n_locals };
}

// One helper per nominal schema the walk can call, gated on has_children —
// the same predicate that decides whether drop_value emits the call, so every
// call this function's lowering makes has a body here. A schema the function
// mentions but never drops yields a body nothing reaches, which the weak
// linkage discards; the reverse, a call with no body, is what the shared gate
// rules out. A function's schema set is closed under field reachability, so
// iterating it also reaches the types the bodies themselves call.
pub function drop_helpers(f: ssasem.Func): irtables.LowerResult[] {
  let none: string[] = [];
  return helpers_not_in(f, util.name_index(none), util.name_index(none)).rows;
}

// Helpers is the drop helpers collected over a module's bodies, with an index
// over their symbols: a helper is generated once per module, by the first
// function whose schema names its type. Every function's table is built from
// the module's one declaration set, so a later function's body would be the
// same one. `seen` holds the record and enum types (ssasem.type_key) an
// earlier function's schema held: their helpers are in `rows`, or they have
// none.
pub struct Helpers { rows: irtables.LowerResult[], done: util.NameIndex, seen: util.NameIndex }

pub function no_helpers(): Helpers {
  let none: string[] = [];
  return Helpers { rows: [], done: util.name_index(none), seen: util.name_index(none) };
}

// with_drop_helpers adds the helpers of f whose symbols h does not carry yet,
// skipping the record and enum types h has seen.
pub function with_drop_helpers(h: Helpers, f: ssasem.Func): Helpers {
  let fresh: Fresh = helpers_not_in(f, h.done, h.seen);
  let out: Helpers = Helpers { ...h, seen: fresh.seen };
  for row in fresh.rows {
    out = Helpers { ...out, rows: out.rows.append(row), done: out.done.added(row.name) };
  }
  return out;
}

// Fresh is helpers_not_in's answer: the helpers, and `seen` with the record
// and enum types of the schema added.
struct Fresh { rows: irtables.LowerResult[], seen: util.NameIndex }

// helpers_not_in is drop_helpers less the symbols `done` carries, and less the
// record and enum types `seen` holds.
function helpers_not_in(f: ssasem.Func, done: util.NameIndex, seen: util.NameIndex): Fresh {
  let out: irtables.LowerResult[] = [];
  let grown: util.NameIndex = seen;
  let sc: SchemaScan = schema_scan(f);
  if (sc.bytes) {
    for h in ssabytes.helpers() {
      if (!done.has(h.name)) {
        out = out.append(h);
      }
    }
  }
  for rec in f.records.list {
    let k: string = ssasem.type_key(rec.ty);
    if (!seen.has(k)) {
      out = append_helpers(out, rec.ty, f, done);
      grown = grown.added(k);
    }
  }
  for e in f.enums {
    let k: string = ssasem.type_key(e.ty);
    if (!seen.has(k)) {
      out = append_helpers(out, e.ty, f, done);
      grown = grown.added(k);
    }
  }
  for v in boxed_columns(sc.maps) {
    if (!outlined_release(v, f) && !done.has(release_helper_name(v))) {
      out = out.append(release_helper(v, f));
    }
  }
  for v in routed_box_columns(sc.maps, f) {
    if (ssasem.is_string_array(v) && !done.has(release_helper_name(v))) {
      out = out.append(release_helper(v, f));
    }
    if (!done.has(env_release_name(v))) {
      out = out.append(env_release_helper(v));
    }
  }
  for t in routed_keyed_maps(sc.maps, f) {
    out = append_keyed_closures(out, t, done);
  }
  return Fresh { rows: out, seen: grown };
}

// append_helpers adds t's drop and release helpers when t has children, each
// unless done has it. Most of a module's bodies find both done, so that is
// asked first.
function append_helpers(own out: irtables.LowerResult[], t: typeinfo.Type, f: ssasem.Func, done: util.NameIndex): irtables.LowerResult[] {
  let need_drop: boolean = !done.has(drop_helper_name(t));
  let need_release: boolean = !done.has(release_helper_name(t));
  if (!need_drop && !need_release || !has_children(t, f)) {
    return out;
  }
  if (need_drop) {
    out = out.append(one_helper(t, f));
  }
  if (need_release) {
    out = out.append(release_helper(t, f));
  }
  return out;
}

function row_names(rows: irtables.LowerResult[]): string[] {
  let out: string[] = [];
  for r in rows {
    out = out.append(r.name);
  }
  return out;
}

// merge_helpers appends to the cache the bodies whose symbol it lacks, the
// first of each symbol in order. A body lowered from a declaration carries no
// name, so a declaration-less body cannot collide with one. The helpers a
// module collects are one per symbol already (Helpers); the merge keeps the
// first of a symbol handed to it twice rather than co-linking both under the
// .weak linkage, which would pick one silently.
pub function merge_helpers(cache: irtables.LowerResult[], helpers: irtables.LowerResult[]): irtables.LowerResult[] {
  return merged_helpers(cache, helpers, false).bodies;
}

// The unchanged cache prefix is followed by one body per helper_indices entry.
// Each index names the selected input helper, before its ops are optimized.
pub struct MergedHelpers { bodies: irtables.LowerResult[], cache_len: i32, helper_indices: i32[] }

pub function merge_helpers_mapped(cache: irtables.LowerResult[], helpers: irtables.LowerResult[]): MergedHelpers {
  return merged_helpers(cache, helpers, true);
}

function merged_helpers(cache: irtables.LowerResult[], helpers: irtables.LowerResult[], mapped: boolean): MergedHelpers {
  let out: irtables.LowerResult[] = cache;
  let selected: i32[] = [];
  let cached: util.NameIndex = util.name_index(row_names(cache));
  let names: util.NameIndex = util.name_index(row_names(helpers));
  let k: i32 = 0;
  while (k < helpers.len()) {
    let h: irtables.LowerResult = helpers[k];
    if (names.find(h.name) == k && !cached.has(h.name)) {
      if (h.ok) {
        out = out.append(optimized_helper(h));
      } else {
        out = out.append(h);
      }
      if (mapped) {
        selected = selected.append(k);
      }
    }
    k = k + 1;
  }
  return MergedHelpers { bodies: out, cache_len: cache.len(), helper_indices: selected };
}

function types_error(f: ssasem.Func, view: ssaunits.SchemaView): string {
  let why: string = schema_types_error(f, view);
  if (why != "") {
    return why;
  }
  for t in f.values {
    if (!supported(t, f)) {
      return "unsupported physical RC value type";
    }
  }
  if (!supported(f.result, f)) {
    return "unsupported physical RC result type";
  }
  for c in f.calls {
    for t in c.params {
      if (!supported(t, f)) {
        return "unsupported physical RC call parameter type";
      }
    }
    if (!supported(c.result, f)) {
      return "unsupported physical RC call result type";
    }
  }
  return "";
}

function validate(f: ssasem.Func, modes: i32[], p: ssaunits.Plan, structs: irtables.StructTab, view: ssaunits.SchemaView): string {
  let why: string = "";
  if (util.verify_on()) {
    why = ssaunits.verify_planned(f, modes, p);
    if (why != "") {
      return why;
    }
  }
  why = types_error(f, view);
  if (why != "") {
    return why;
  }
  // Keep this physical vocabulary closed when semantic analysis grows new
  // operations. Verification of a new operation does not implement its ABI.
  for b in f.graph.blocks {
    for ins in b.insts {
      if (!supported_op(ins.kind_tag)) {
        return "unsupported physical RC operation";
      }
      if (dyn_call(ins) && !consecutive(ins.args)) {
        return "dyn call operands are not consecutive slots";
      }
      if (builds(ins.kind_tag)) {
        why = construction_error(f, ins, structs);
        if (why != "") {
          return why;
        }
      }
    }
  }
  return "";
}

// The operations that write a value into a container's slot. A closure box is
// one: its captures occupy the same i32-shaped words an array element does.
function builds(k: i32): boolean {
  return kind_in(
    [
      ssasem.array_new(), ssasem.tuple_new(), ssasem.record_new(), ssasem.variant_new(),
      ssasem.append(), ssasem.with(), ssasem.closure_new(), ssasem.cell_new(), ssasem.cell_set(), ssasem.dyn_box(),
    ],
    k,
  );
}

function kind_in(kinds: i32[], k: i32): boolean {
  for kind in kinds {
    if (kind == k) {
      return true;
    }
  }
  return false;
}

// Everything that is not a container operation: the constants and a type's
// zero, a parameter, a copy, a phi, the scalar operators, a call, a closure
// value and the call through one.
// unchecked_str_index is a byte read whose index the lowering proved in range.
function unchecked_str_index(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssasem.str_index() && ins.imm == 1;
}

function value_op(k: i32): boolean {
  return kind_in([1, 2, 5, 6, 7, 8, 35, ssasem.zero(), ssasem.call(), ssasem.append_range()], k) || ssasem.scalar_op(k) || ssasem.is_function_op(k);
}

function container_op(k: i32): boolean {
  return kind_in(
    [
      ssasem.array_new(), ssasem.array_reserve(), ssasem.tuple_new(), ssasem.record_new(), ssasem.dyn_box(),
      ssasem.array_get(), ssasem.tuple_get(), ssasem.record_get(),
      ssasem.length(), ssasem.append(), ssasem.with(), ssasem.slice(), ssasem.str_index(),
      ssasem.str_bytes(), ssasem.str_byte_view(), ssasem.arr_join(), ssasem.arr_slice(),
    ],
    k,
  ) || variant_op(k) || ssasem.is_cell_op(k) || ssasem.is_hole_op(k);
}

function variant_op(k: i32): boolean {
  return kind_in([ssasem.variant_new(), ssasem.variant_is(), ssasem.variant_get(), ssasem.dyn_is()], k) || identity_op(k);
}

// A struct-union's member is its own box, a view and the string it borrows
// are one box, and a dyn value is the box it was widened from, so widening,
// narrowing and a string retag move no bytes: the operand is already on the
// stack and the store below takes it.
function identity_op(k: i32): boolean {
  return kind_in([ssasem.variant_up(), ssasem.variant_as(), ssasem.str_as(), ssasem.array_lend(), ssasem.dyn_up(), ssasem.dyn_as()], k);
}

function supported_op(k: i32): boolean {
  return value_op(k) || container_op(k) || ssasem.is_map_op(k) || ssasem.is_map_iter_op(k);
}

// A value's SSA id is its local slot, so the slot lists are a walk of the
// value types. Only wasm reads them: it spells each local and the result in
// the function's type, where the register backends give every value the same
// 64-bit slot and ignore the distinction.
function result_kind(t: typeinfo.Type): i32 {
  if (ssasem.is_wide(t)) {
    return irtables.result_i64();
  }
  if (ssasem.is_float(t)) {
    return irtables.result_f64();
  }
  return irtables.result_i32();
}

function frame(f: ssasem.Func): irtables.LowerResult {
  let r: irtables.LowerResult = empty("");
  r = irtables.LowerResult {
    ...r, ok: true, n_params: f.params.len(), n_locals: f.graph.nvals,
    name: f.graph.name, result_kind: result_kind(f.result),
  };
  let di: i32 = 0;
  while (di < f.dbg_vals.len()) {
    let v: i32 = f.dbg_vals[di];
    let t: string = dbg_type(f, f.values[v], []);
    if (t != "") {
      r = irtables.LowerResult { ...r, dbg_slots: r.dbg_slots.append(v), dbg_names: r.dbg_names.append(f.dbg_names[di]), dbg_types: r.dbg_types.append(t) };
    }
    di = di + 1;
  }
  let vi: i32 = 0;
  while (vi < f.values.len()) {
    if let typeinfo.TypeArray(_) = f.values[vi] {
      r = irtables.LowerResult { ...r, arr_slots: r.arr_slots.append(vi) };
    }
    if let typeinfo.TypeString(_) = f.values[vi] {
      r = irtables.LowerResult { ...r, str_slots: r.str_slots.append(vi) };
    }
    if (ssasem.is_wide(f.values[vi])) {
      r = irtables.LowerResult { ...r, i64_slots: r.i64_slots.append(vi) };
    }
    if (ssasem.is_float(f.values[vi])) {
      r = irtables.LowerResult { ...r, f64_slots: r.f64_slots.append(vi) };
    }
    vi = vi + 1;
  }
  return r;
}

// dbg_type is how a `-g` variable's type is described to the ELF writer, ""
// for one it cannot describe. A scalar is its spelling, a payloadless enum
// dbg_enum's spelling. A struct is a pointer
// to its box, `*Name@size{field:type:offset,...}`, each field in its 8-byte
// slot after the shape word; fields that cannot be described are left out,
// and a struct already being described (`open`) is named without its fields.
function dbg_type(f: ssasem.Func, t: typeinfo.Type, open: string[]): string {
  let s: string = typeinfo.spelling(t);
  for scalar in ["i32", "i64", "u8", "u32", "u64", "usize", "isize", "f64", "f32", "boolean"] {
    if (s == scalar) {
      return s;
    }
  }
  if let typeinfo.TypeStruct(_) = t {
    let at: i32 = semrecords.find(f.records, t);
    if (at < 0) {
      return "";
    }
    let name: string = dbg_type_name(s);
    if (util.index_of_str(open, name) >= 0) {
      return "*" + name;
    }
    return "*" + name + "@" + util.i32_to_string((f.records.list[at].fields.len() + 1) * 8) + "{" + dbg_members(f, f.records.list[at].fields, open.append(name)) + "}";
  }
  if let typeinfo.TypeUnion(_) = t {
    return dbg_enum(f, t, s);
  }
  return "";
}

// dbg_enum describes a declared enum whose variants carry nothing,
// `%Name{North,East,...}`: its value points at a box whose word 0 is the
// variant's shape, which the emitter names and the link resolves.
function dbg_enum(f: ssasem.Func, t: typeinfo.Type, s: string): string {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0 || f.enums[at].layout != semrecords.layout_variant()) {
    return "";
  }
  let out: string = "";
  for v in f.enums[at].variants {
    if (v.fields.len() > 0) {
      return "";
    }
    if (out != "") {
      out = out + ",";
    }
    out = out + v.name;
  }
  return "%" + dbg_type_name(s) + "{" + out + "}";
}

// dbg_members is a struct's describable fields as `field:type:offset`.
function dbg_members(f: ssasem.Func, fields: semrecords.Field[], open: string[]): string {
  let out: string = "";
  let k: i32 = 0;
  while (k < fields.len()) {
    let ft: string = dbg_type(f, fields[k].ty, open);
    if (ft != "") {
      if (out != "") {
        out = out + ",";
      }
      out = out + fields[k].name + ":" + ft + ":" + util.i32_to_string((k + 1) * 8);
    }
    k = k + 1;
  }
  return out;
}

// dbg_type_name is a type's spelling with the description's separators
// replaced, so a generic's arguments cannot be read as structure.
function dbg_type_name(s: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < s.len()) {
    let c: u8 = s[i];
    if (c == b'@' || c == b'{' || c == b'}' || c == b',' || c == b':' || c == b'|' || c == b'*' || c == b'%' || c == b'=') {
      out = out + "_";
    } else {
      out = out + slice_unchecked(s, i, i + 1);
    }
    i = i + 1;
  }
  return out;
}

// The stack IR's name for each integer operator, the signed form where the
// IR distinguishes one.
function binary_kind(op: string): string {
  let ops: string[] = ["+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>", "<", "<=", ">", ">=", "=="];
  let kinds: string[] = ["add", "sub", "mul", "div_s", "rem_s", "and", "or", "xor", "shl", "shr_s", "lt_s", "le_s", "gt_s", "ge_s", "eq"];
  let i: i32 = 0;
  while (i < ops.len()) {
    if (ops[i] == op) {
      return kinds[i];
    }
    i = i + 1;
  }
  return "ne";
}

// `+`, `-`, `*` and `<<` are the operators whose result can leave the range its
// type names; every other one lands inside a range its operands are already in,
// and a comparison lands in a boolean.
function wraps(op: string): boolean {
  return op == "+" || op == "-" || op == "*" || op == "<<";
}

// The stack IR runs the integer operators in a register wider than any of these
// types, so a result that can exceed the type's width is masked back to it
// explicitly — the same step the AST lowering emits, and what the interpreter's
// per-width arithmetic does (`2147483647 + 1` is INT_MIN, `255u8 + 1` is 0).
function wrap_kind(t: typeinfo.Type): string {
  if (ssasem.is_u8(t)) {
    return "u8";
  }
  if (ssasem.is_u32(t)) {
    return "u32";
  }
  return "i32";
}

// The stack IR's name for an integer operator at its operands' own
// signedness. The orderings, the right shift and div/rem read the slot's sign
// bit, which an unsigned operand does not have; the verifier gives both
// operands the same type, so one of them names the form.
function integer_kind(op: string, operand: typeinfo.Type): string {
  if (ssasem.is_unsigned_int(operand)) {
    return irtables.to_unsigned_kind(binary_kind(op));
  }
  return binary_kind(op);
}

// The width the operator RUNS at, which a comparison's boolean result does not
// name — its operands do.
function operand_width(f: ssasem.Func, ins: ssa.SInst): i32 {
  if (ssasem.is_wide(f.values[ins.args[0]])) {
    return 64;
  }
  if (ssasem.is_usize(f.values[ins.args[0]])) {
    return ir.width_ptr();
  }
  return 0;
}

// A string append handed the left operand's unit: the runtime grows that
// buffer in place when the block has room, and the result IS the operand;
// otherwise the concatenation builds a fresh box and the operand's unit is
// released.
function grow_or_concat(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let res: i32 = scratch_base(f);
  r = reserve(r, res + 1);
  r = grow_call(r, ins);
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_store_local(res));
  r = emit(r, ir.op_else());
  r = concatenation(r, ins, res + 1);
  r = emit(r, ir.op_store_local(res));
  r = release(r, ins.args[0], f.values[ins.args[0]], f);
  r = emit(r, ir.op_end());
  return emit(r, ir.op_load_local(res));
}

// A string append onto a FIELD of a record this frame owns and reads no
// further through that field (ssaunits.field_grow_root). A sole-owned record
// lets the runtime grow the field's buffer in place, and the field is then
// nulled so the record's release skips the buffer the result now owns; a
// shared record, or a buffer that cannot grow, takes a plain concatenation and
// leaves the field for the record's release.
function grow_field_or_concat(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): irtables.LowerResult {
  let root: i32 = p.grows[ins.result];
  let grown: i32 = scratch_base(f);
  let res: i32 = grown + 1;
  r = reserve(r, res + 1);
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_store_local(grown));
  r = emit(r, ir.op_load_local(root));
  r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
  r = emit(r, ir.op_if(0));
  r = grow_call(r, ins);
  r = emit(r, ir.op_store_local(grown));
  r = emit(r, ir.op_end());
  r = emit(r, ir.op_load_local(grown));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_store_local(res));
  r = emit(r, ir.op_load_local(root));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_struct_set(p.grow_fields[ins.result], 0));
  r = emit(r, ir.op_else());
  r = concatenation(r, ins, res + 1);
  r = emit(r, ir.op_store_local(res));
  r = emit(r, ir.op_end());
  return emit(r, ir.op_load_local(res));
}

// grow_call answers whether the runtime appended the right operand onto the
// left one's block in place. A range append hands over the source and its
// bounds, so the bytes go straight from the source into the block.
function grow_call(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  for arg in ins.args {
    r = emit(r, ir.op_load_local(arg));
  }
  if (ins.kind_tag == ssasem.append_range()) {
    return emit(r, ir.op_call_direct("__fern_str_grow_range", 4));
  }
  return emit(r, ir.op_call_direct("__fern_str_grow", 2));
}

// concatenation leaves a fresh box of both operands on the stack and takes
// nothing. A range append's window is built in the frame, in `view`, only on
// this path, and released once the bytes are copied out of it.
function concatenation(own r: irtables.LowerResult, ins: ssa.SInst, view: i32): irtables.LowerResult {
  if (ins.kind_tag != ssasem.append_range()) {
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_load_local(ins.args[1]));
    return emit(r, ir.op_str_concat());
  }
  r = reserve(r, view + 1);
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.op_load_local(ins.args[2]));
  r = emit(r, ir.op_load_local(ins.args[3]));
  r = emit(r, ir.op_str_slice_frame(0));
  r = emit(r, ir.op_store_local(view));
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_load_local(view));
  r = emit(r, ir.op_str_concat());
  return helper(r, view, "__fern_str_view_free");
}

// A string `+` is the runtime's concatenation, a fresh box; equality reads
// both operands, and an ordering is `str_cmp` — which hands back a signed i32
// under, at or over zero — against a zero constant. The verifier admits no
// other string operator (ssasem.string_result).
function string_binary(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  if (ins.str == "+") {
    return emit(r, ir.op_str_concat());
  }
  if (ins.str != "==" && ins.str != "!=") {
    r = emit(r, ir.op_str_cmp());
    r = emit(r, ir.op_const_i32(0));
    return emit(r, ir.op_bin(binary_kind(ins.str), 0, false));
  }
  r = emit(r, ir.op_str_eq());
  if (ins.str == "!=") {
    return emit(r, ir.op_bin("not", 0, false));
  }
  return r;
}

// The operand of a string `==` or `!=` that is a literal, whose length then
// decides most comparisons without the runtime's call; -1 for any other
// instruction.
function literal_text_eq(f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): i32 {
  if (ins.kind_tag != 9 || ins.str != "==" && ins.str != "!=" || ins.args.len() != 2) {
    return 0 - 1;
  }
  if (!ssasem.is_text(f.values[ins.args[0]])) {
    return 0 - 1;
  }
  if (p.text_lens[ins.args[1]] >= 0) {
    return 1;
  }
  if (p.text_lens[ins.args[0]] >= 0) {
    return 0;
  }
  return 0 - 1;
}

// A comparison against a literal of length K reads the other operand's length
// first and calls `str_eq` only when it is K.
function text_eq_by_length(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): irtables.LowerResult {
  let lit: i32 = literal_text_eq(f, p, ins);
  let other: i32 = ins.args[1 - lit];
  let res: i32 = scratch_base(f);
  r = reserve(r, res + 1);
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_store_local(res));
  r = emit(r, ir.op_load_local(other));
  r = emit(r, ir.op_str_len());
  r = emit(r, ir.op_const_i32(p.text_lens[ins.args[lit]]));
  r = emit(r, ir.op_bin("eq", 0, false));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.op_str_eq());
  r = emit(r, ir.op_store_local(res));
  r = emit(r, ir.op_end());
  r = emit(r, ir.op_load_local(res));
  if (ins.str == "!=") {
    return emit(r, ir.op_bin("not", 0, false));
  }
  return r;
}

// The float operators are the stack IR's own f64 opcodes: arithmetic hands
// back an f64, rounded to single precision where the result is an f32, a
// comparison the i32 the boolean occupies, and negation flips the sign bit.
// Nothing wraps.
function float_scalar(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  if (ins.kind_tag == 10) {
    return emit(r, ir.op_funary("fneg"));
  }
  r = emit(r, ir.op_fbin(irtables.map_fbinop(ins.str)));
  if (ssasem.is_f32(f.values[ins.result])) {
    return round_f32(r);
  }
  return r;
}

// An f32 is the f64 on the stack rounded to single precision, which the
// demote-and-promote pair applies.
function round_f32(own r: irtables.LowerResult): irtables.LowerResult {
  r = emit(r, ir.op_f32_bits());
  return emit(r, ir.op_f32_from_bits());
}

// Into a float: an integer converts at its width and signedness, the other
// float width is already the f64, and an f32 destination rounds.
function into_float(own r: irtables.LowerResult, from: typeinfo.Type, to: typeinfo.Type): irtables.LowerResult {
  if (!ssasem.is_float(from)) {
    let bits: i32 = 32;
    if (ssasem.is_wide(from)) {
      bits = 64;
    }
    r = emit(r, ir.op_int_to_f64(bits, ssasem.is_unsigned_int(from)));
  }
  if (ssasem.is_f32(to)) {
    return round_f32(r);
  }
  return r;
}

// A saturating or checked operator is the AST lowering's own shape
// (irtables.sat_binary_ops / chk_binary_ops) over this function's slots: the
// operands are values, so they are already in slots, the result's slot holds
// the shape's outcome, and an intermediate the shape reads twice is
// recomputed from the operands rather than spilled, so it takes no scratch.
function overflow_binary(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let t: typeinfo.Type = f.values[ins.args[0]];
  let wide: boolean = ssasem.is_wide(t);
  let ops: ir.Op[] = [];
  if (ssasem.saturating(ins.str)) {
    ops = irtables.sat_binary_ops(ins.str, overflow_kind(t), wide, ins.args[0], ins.args[1], ins.result, 0 - 1, 0 - 1);
  } else {
    ops = irtables.chk_binary_ops(ins.str, overflow_kind(t), wide, ins.args[0], ins.args[1], 0 - 1, ins.result);
  }
  for op in ops {
    r = emit(r, op);
  }
  return r;
}

// The width-and-signedness name the shape is written against.
function overflow_kind(t: typeinfo.Type): string {
  if (ssasem.is_u8(t)) {
    return "u8";
  }
  if (ssasem.is_u32(t)) {
    return "u32";
  }
  if (ssasem.is_i64(t)) {
    return "i64";
  }
  if (ssasem.is_u64(t)) {
    return "u64";
  }
  return "i32";
}

function scalar(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  if (ins.kind_tag == ssasem.cast()) {
    return cast(r, f, ins);
  }
  if (ins.kind_tag == 9 && ssasem.is_text(f.values[ins.args[0]])) {
    return string_binary(r, ins);
  }
  if (ins.kind_tag == 10 && ins.str == "!") {
    return emit(r, ir.op_bin("not", 0, false));
  }
  if (ssasem.is_float(f.values[ins.args[0]])) {
    return float_scalar(r, f, ins);
  }
  let w: i32 = operand_width(f, ins);
  if (ins.kind_tag == 9) {
    r = emit(r, ir.op_bin(integer_kind(ins.str, f.values[ins.args[0]]), w, false));
  } else {
    r = emit(r, ir.op_bin("sub", w, false));
  }
  // The 64-bit operators are already full-width, so only a narrower result
  // can leave the range its type names. An address is the register's own
  // width too: wrapping one sign-extended `base + n` from 32 bits, which
  // faulted on any mapping above 2 GiB (#10454).
  if (!wraps(ins.str) || register_width(f.values[ins.result])) {
    return r;
  }
  return emit(r, ir.op_int_cast(wrap_kind(f.values[ins.result])));
}

function register_width(t: typeinfo.Type): boolean {
  return ssasem.is_wide(t) || ssasem.is_usize(t);
}

// The mask a NARROW destination applies to a narrow operand: the byte's 255,
// the u32's zero-extension of the low word, the i32's sign-extension of it.
// "" where the operand's own type already keeps its value inside the
// destination's range — a byte is inside every wider narrow type, and a
// conversion to the type the value already has moves no bits.
function narrow_mask(from: typeinfo.Type, to: typeinfo.Type): string {
  if (semtypes.equal(from, to)) {
    return "";
  }
  if (ssasem.is_u8(to)) {
    return "u8";
  }
  if (ssasem.is_u8(from)) {
    return "";
  }
  if (ssasem.is_u32(to)) {
    return "u32";
  }
  return "i32";
}

// Out of a float: the truncation, and then the u8 mask. The conversions below
// answer at 32 or 64 bits, so a u8 destination needs the narrowing the integer
// wrap applies for the same destination — without it `300.7 as u8` keeps 300
// where the AST lowering and native both answer 44.
function out_of_float(own r: irtables.LowerResult, to: typeinfo.Type): irtables.LowerResult {
  r = emit(r, from_f64(to));
  if (!ssasem.is_u8(to)) {
    return r;
  }
  return emit(r, ir.op_int_cast("u8"));
}

// Out of the f64: a truncation toward zero at the destination's width and
// signedness. The signed forms clamp at the signed maximum, and at the signed
// MINIMUM out of a negative, which is the wrong answer for a destination that
// has no sign bit: out_of_float's u8 mask then reads that clamp's low byte,
// so `-1.0 as u8` answered 255 rather than native's 0 (#9912).
//
// Signedness comes from the destination, not from its width — the narrow
// unsigned types share the u32's conversion, exactly as native picks
// `Unsigned: !dstInt.IsSigned()` and then canonicalises to the destination's
// representation.
function from_f64(to: typeinfo.Type): ir.Op {
  if (ssasem.is_u64(to)) {
    return ir.op_f64_to_u64();
  }
  if (ssasem.is_wide(to)) {
    return ir.op_f64_to_i64();
  }
  if (ssasem.is_unsigned_int(to)) {
    return ir.op_f64_to_u32();
  }
  return ir.op_f64_to_i32();
}

// A conversion between the integer types, in the two domains the stack IR
// separates. Crossing the 64-bit boundary is an explicit extend or wrap, and
// the SOURCE's signedness is what an extension extends by: only the signed
// 32-bit width fills the high half from a sign bit. Inside the narrow domain
// the conversion is the destination's own mask. Into and out of a float is a
// real conversion: the convert at the operand's width and signedness, and the
// truncation toward zero at the result's; into the f32 the value is rounded
// to single precision, and out of it to the f64 it is already the f64.
function cast(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let from: typeinfo.Type = f.values[ins.args[0]];
  let to: typeinfo.Type = f.values[ins.result];
  // An address and the box it names share a slot, so neither direction of the
  // reinterpretation moves anything. Both have to answer before the width
  // arms below, which would read the reference as a narrow integer and emit a
  // wrap for it.
  if (ssasem.is_usize(from) && ssasem.reference(to)) {
    return r;
  }
  if (ssasem.reference(from) && ssasem.is_usize(to)) {
    return r;
  }
  // A handle is its descriptor, so reading it as the i32 moves nothing.
  if (semtypes.is_handle(from)) {
    return r;
  }
  // An address converts at the pointer width: the u64 forms on a register
  // backend, the u32 forms on wasm, where `f64 as usize` saturates at
  // u32::MAX as native's does.
  if (ssasem.is_float(to) && ssasem.is_usize(from)) {
    r = emit(r, ir.op_ptr_to_f64());
    if (ssasem.is_f32(to)) {
      return round_f32(r);
    }
    return r;
  }
  if (ssasem.is_float(from) && ssasem.is_usize(to)) {
    return emit(r, ir.op_f64_to_ptr());
  }
  if (ssasem.is_float(to)) {
    return into_float(r, from, to);
  }
  if (ssasem.is_float(from)) {
    return out_of_float(r, to);
  }
  if (ssasem.is_usize(from)) {
    return from_address(r, to);
  }
  if (ssasem.is_usize(to)) {
    return into_address(r, from);
  }
  if (ssasem.is_wide(to)) {
    if (ssasem.is_wide(from)) {
      return r;
    }
    return emit(r, ir.op_int_extend(ssasem.is_unsigned_int(from)));
  }
  if (ssasem.is_wide(from)) {
    r = emit(r, ir.op_int_wrap(ssasem.is_unsigned_int(to)));
    if (!ssasem.is_u8(to)) {
      return r;
    }
    return emit(r, ir.op_int_cast("u8"));
  }
  let mask: string = narrow_mask(from, to);
  if (mask == "") {
    return r;
  }
  return emit(r, ir.op_int_cast(mask));
}

// The pointer width is the whole slot on a register backend and the i32 on
// wasm, so neither direction of an address conversion is one opcode. Each is
// written as the pair that is a no-op on whichever of the two the address
// already matches: the address is taken to the 64-bit domain and wrapped back
// down to the destination, and a narrow source is extended to 64 bits before
// being wrapped to the address. On a register backend the pointer-width half
// moves nothing and the 64-bit half does the extension; on wasm the two halves
// cancel for a 32-bit destination and the 64-bit half is the real conversion.
function from_address(own r: irtables.LowerResult, to: typeinfo.Type): irtables.LowerResult {
  if (ssasem.is_usize(to)) {
    return r;
  }
  r = emit(r, ir.op_int_extend_ptr());
  if (ssasem.is_wide(to)) {
    return r;
  }
  r = emit(r, ir.op_int_wrap(ssasem.is_unsigned_int(to)));
  if (!ssasem.is_u8(to)) {
    return r;
  }
  return emit(r, ir.op_int_cast("u8"));
}

function into_address(own r: irtables.LowerResult, from: typeinfo.Type): irtables.LowerResult {
  if (ssasem.is_usize(from)) {
    return r;
  }
  if (!ssasem.is_wide(from)) {
    r = emit(r, ir.op_int_extend(ssasem.is_unsigned_int(from)));
  }
  return emit(r, ir.op_int_wrap_ptr());
}

// A tuple's slots are a uniform eight bytes on every backend; only wasm picks
// the store instruction per element, and it reads the choice out of the kinds
// string `op_tuple_make_k` carries. The READ side has named its width all
// along (`op_tuple_get_w`), which is why this was the only half missing. An
// f32 occupies the f64's slot, as it does in an array.
function tuple_kind(t: typeinfo.Type): string {
  if (ssasem.is_float(t)) {
    return "f64";
  }
  if (ssasem.is_wide(t)) {
    return "i64";
  }
  return "i32";
}

function tuple_kinds(t: typeinfo.Type): string {
  let out: string = "";
  if let typeinfo.TypeTuple(tup) = t {
    let i: i32 = 0;
    while (i < tup.elements.len()) {
      if (i > 0) {
        out = out + ",";
      }
      out = out + tuple_kind(tup.elements[i]);
      i = i + 1;
    }
  }
  return out;
}

// The window copy the runtime hands back aliases every element pointer it
// copied, so the copy takes its own unit on each — the same `own_copied`
// `sole_owned_base` makes over the same copy.
function arr_slice(own r: irtables.LowerResult, f: ssasem.Func, elem: typeinfo.Type): irtables.LowerResult {
  r = emit(r, ir.op_arr_slice(elem_width(elem)));
  if (!ssasem.reference(elem)) {
    return r;
  }
  return owned_copy(r, f, elem);
}

// The array on the stack aliases every element pointer it holds, and takes
// its own unit on each.
function owned_copy(own r: irtables.LowerResult, f: ssasem.Func, elem: typeinfo.Type): irtables.LowerResult {
  let copy: i32 = scratch_base(f);
  r = reserve(r, copy + 1);
  r = emit(r, ir.op_store_local(copy));
  r = own_copied(r, elem, copy, copy);
  return emit(r, ir.op_load_local(copy));
}

// `copy`'s first len(`source`) elements alias `source`'s, and each needs a
// unit of its own: a count on a counted element, and on a string view a fresh
// box, since a view box carries the immortal rc and cannot be counted.
function own_copied(own r: irtables.LowerResult, elem: typeinfo.Type, copy: i32, source: i32): irtables.LowerResult {
  if (!ssasem.is_view(elem)) {
    return helper(r, source, "__fern_arr_inc_elems");
  }
  r = emit(r, ir.op_load_local(copy));
  r = emit(r, ir.op_load_local(source));
  r = emit(r, ir.op_call_direct("__fern_arr_own_elems", 2));
  return emit(r, ir.op_drop());
}

// A record box is named by its declaration, a variant box by its variant. The
// declaration index is where wasm reads each field's store width; the register
// backends store every field as 8 bytes, and every read takes its offset from
// the field index alone.
function container(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst, structs: irtables.StructTab): irtables.LowerResult {
  if (ins.kind_tag == ssasem.array_reserve()) {
    return emit(r, ir.op_arr_reserve(elem_width(elem_type(f.values[ins.result]))));
  }
  if (variant_op(ins.kind_tag)) {
    return variant(r, f, ins, structs);
  }
  if (ins.kind_tag == ssasem.array_new()) {
    return emit(r, arr_make_op(elem_type(f.values[ins.result]), ins.args.len()));
  }
  if (ins.kind_tag == ssasem.tuple_new()) {
    return emit(r, ir.op_tuple_make_k(ins.args.len(), tuple_kinds(f.values[ins.result])));
  }
  if (ins.kind_tag == ssasem.record_new()) {
    return emit(r, ir.op_struct_make(record_name(f.values[ins.result]), ins.args.len(), decl_of(f, ins, structs)));
  }
  if (ins.kind_tag == ssasem.dyn_box()) {
    return emit(r, ir.op_dyn_box(ins.str));
  }
  if (ins.kind_tag == ssasem.length()) {
    if (ssasem.is_text(f.values[ins.args[0]])) {
      return emit(r, ir.op_str_len());
    }
    if (byte_view(f.values[ins.args[0]])) {
      return emit(r, ssabytes.read(ins.args[0], false, false));
    }
    return emit(r, ir.op_arr_len());
  }
  if (ins.kind_tag == ssasem.slice()) {
    return emit(r, ir.op_str_slice());
  }
  if (ins.kind_tag == ssasem.arr_slice()) {
    if (byte_view(f.values[ins.args[0]])) {
      return emit(r, ir.op_call_direct(ssabytes.slice_name(), 3));
    }
    return arr_slice(r, f, elem_type(f.values[ins.result]));
  }
  if (ins.kind_tag == ssasem.str_byte_view()) {
    r = emit(r, ir.op_call_direct("__fern_rc_inc", 1));
    r = emit(r, ir.op_const_i32(2));
    return emit(r, ir.op_raw_addr());
  }
  if (ins.kind_tag == ssasem.str_bytes()) {
    return emit(r, ir.packed(ir.op_str_bytes()));
  }
  if (unchecked_str_index(ins)) {
    return emit(r, ir.op_raw_load8());
  }
  if (ins.kind_tag == ssasem.str_index()) {
    return emit(r, ir.op_str_index());
  }
  if (ins.kind_tag == ssasem.array_get()) {
    if (byte_view(f.values[ins.args[0]])) {
      return emit(r, ssabytes.read(ins.args[0], true, ins.imm == 1));
    }
    return emit(r, arr_get_op(f.values[ins.result], ins.imm == 1));
  }
  if (ins.kind_tag == ssasem.tuple_get()) {
    return emit(r, ir.op_tuple_get_w(ins.imm, load_width(f.values[ins.result]), ssasem.is_wide(f.values[ins.result])));
  }
  return field_get(r, f, ins);
}

// The boxes a routed value column can hold: any counted value but a string or
// a view, released through the type's own release helper.
function routed_box(t: typeinfo.Type): boolean {
  return ssasem.boxed_map_value(t) && !ssasem.is_view(t) || ssasem.is_string_array(t);
}

// A key or value wider than four bytes, an i64 or u64 or a float, crosses
// the slot as a cell holding its eight bytes (core/map's __map_cell).
function cell_column(t: typeinfo.Type): boolean {
  return ssasem.wide_map_key(t) || ssasem.float_map_value(t);
}

// A routed map op as a call to the core/map function native's
// ir.CodegenAliases names for it. Every key and value crosses as core/map's
// `usize` slot, converted the way `as usize` converts it, so equal keys are
// equal slots.
function routed_map_site(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let k: i32 = ins.kind_tag;
  if (k == ssasem.map_new() || k == ssasem.map_cleared()) {
    if (k == ssasem.map_new()) {
      r = emit(r, ir.op_load_local(ins.args[0]));
    } else {
      r = emit(r, ir.op_const_i32(8));
    }
    r = emit(r, ir.op_const_i32(routed_key_tag(ssasem.map_key(f.values[ins.result]))));
    r = emit(r, ir.op_const_i32(routed_val_tag(ssasem.map_value(f.values[ins.result]))));
    return emit(r, ir.op_call_direct("map_new_impl", 3));
  }
  if (k == ssasem.map_insert()) {
    return routed_insert(r, f, ins);
  }
  if (ssasem.is_map_iter_op(k)) {
    r = emit(r, ir.op_load_local(ins.args[0]));
    return routed_cursor(r, f, ins);
  }
  let t: typeinfo.Type = f.values[ins.args[0]];
  if (k == ssasem.map_len()) {
    r = emit(r, ir.op_load_local(ins.args[0]));
    return emit(r, ir.op_call_direct("__map_len_impl", 1));
  }
  if (k == ssasem.map_keys()) {
    r = emit(r, ir.op_load_local(ins.args[0]));
    return routed_column_read(r, ssasem.map_key(t), ir.op_const_i32(0));
  }
  if (k == ssasem.map_values()) {
    r = emit(r, ir.op_load_local(ins.args[0]));
    return routed_column_read(r, ssasem.map_value(t), ir.op_ptr_width());
  }
  r = box_key(r, f, ins);
  if (k == ssasem.map_delete()) {
    r = routed_delete(r, f, ins);
  } else {
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = routed_lookup(r, f, ins);
  }
  if (!cell_column(ssasem.map_key(t))) {
    return r;
  }
  return helper(r, key_cell(f), "__map_cell_free");
}

// has, get and get_or, with the receiver on the stack.
function routed_lookup(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let t: typeinfo.Type = f.values[ins.args[0]];
  let v: typeinfo.Type = ssasem.map_value(t);
  r = key_operand(r, f, ins);
  if (ins.kind_tag == ssasem.map_has()) {
    return map_entry(r, f, ins, "__map_has_impl", "__map_has_keyed_impl", 2);
  }
  let counted: boolean = ssasem.is_text(v);
  if (ins.kind_tag == ssasem.map_get()) {
    if (cell_column(v) && ssasem.is_float(v)) {
      return map_entry(r, f, ins, "__map_get_cell_f64_impl", "__map_get_cell_f64_keyed_impl", 2);
    }
    if (cell_column(v)) {
      return map_entry(r, f, ins, "__map_get_cell_impl", "__map_get_cell_keyed_impl", 2);
    }
    r = map_entry(r, f, ins, "__map_get_impl", "__map_get_keyed_impl", 2);
    if (!counted) {
      return r;
    }
    return retain_hit_payload(r, ins);
  }
  if (cell_column(v)) {
    return cell_get_or(r, f, ins);
  }
  r = routed_slot(r, ins.args[2], v);
  r = map_entry(r, f, ins, "__map_get_or_impl", "__map_get_or_keyed_impl", 3);
  if (counted) {
    r = emit(r, ir.op_call_direct("__fern_rc_inc", 1));
  }
  return routed_from_slot(r, v);
}

// get_or on a cell column: the fallback crosses as a cell of its own, the
// answer is read out of whichever cell comes back, and the fallback's cell
// is returned after.
function cell_get_or(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let v: typeinfo.Type = ssasem.map_value(f.values[ins.args[0]]);
  let fallback: i32 = key_cell(f) + 1;
  r = reserve(r, fallback + 1);
  r = routed_slot(r, ins.args[2], v);
  r = emit(r, ir.op_store_local(fallback));
  r = emit(r, ir.op_load_local(fallback));
  r = map_entry(r, f, ins, "__map_get_or_impl", "__map_get_or_keyed_impl", 3);
  r = routed_from_slot(r, v);
  return helper(r, fallback, "__map_cell_free");
}

// The scratch slot a wide key's cell is held in across one map op, above
// every slot the insert and delete sequences take.
function key_cell(f: ssasem.Func): i32 {
  return scratch_base(f) + 4;
}

// A wide key crosses as a cell, made once per op and returned after it,
// unless an insert's new entry keeps it.
function box_key(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let kt: typeinfo.Type = ssasem.map_key(f.values[ins.args[0]]);
  if (!cell_column(kt)) {
    return r;
  }
  r = reserve(r, key_cell(f) + 1);
  r = routed_slot(r, ins.args[1], kt);
  return emit(r, ir.op_store_local(key_cell(f)));
}

function key_operand(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let kt: typeinfo.Type = ssasem.map_key(f.values[ins.args[0]]);
  if (cell_column(kt)) {
    return emit(r, ir.op_load_local(key_cell(f)));
  }
  return routed_slot(r, ins.args[1], kt);
}

// core/map's valTag: 5 a string or a view, 4 a counted box, 0 a scalar held
// in the slot itself, or in an eight-byte cell, whose size is the tag's high
// bytes.
function routed_val_tag(t: typeinfo.Type): i32 {
  if (ssasem.is_text(t)) {
    return 5;
  }
  if (routed_box(t)) {
    return 4;
  }
  if (cell_column(t)) {
    return 8 * 256;
  }
  return 0;
}

// core/map's keyTag: 1 a string, 0 a scalar held in the slot itself, 2 one
// held in an eight-byte cell, whose size is the tag's high bytes, 4 a
// counted keyed key.
function routed_key_tag(t: typeinfo.Type): i32 {
  if (ssasem.is_text(t)) {
    return 1;
  }
  if (ssasem.keyed_map_key(t)) {
    return 4;
  }
  if (cell_column(t)) {
    return 2 + 8 * 256;
  }
  return 0;
}

// A string key crosses as its box's address, which is its slot already; a
// wide scalar as a fresh cell (`cell_column`).
function routed_slot(own r: irtables.LowerResult, slot: i32, t: typeinfo.Type): irtables.LowerResult {
  r = emit(r, ir.op_load_local(slot));
  if (ssasem.reference(t)) {
    return r;
  }
  if (ssasem.is_float(t)) {
    r = emit(r, ir.op_f64_bits());
  }
  if (cell_column(t)) {
    return emit(r, ir.op_call_direct("__map_cell", 1));
  }
  return into_address(r, t);
}

function routed_from_slot(own r: irtables.LowerResult, t: typeinfo.Type): irtables.LowerResult {
  if (ssasem.reference(t)) {
    return r;
  }
  if (!cell_column(t)) {
    return from_address(r, t);
  }
  r = emit(r, ir.op_call_direct("__map_cell_load", 1));
  if (ssasem.is_float(t)) {
    return emit(r, ir.op_f64_from_bits());
  }
  return r;
}

// A column snapshot is a fresh array in this compiler's own layout, built by
// core/map as a typed Fern array.
function routed_column_read(own r: irtables.LowerResult, elem: typeinfo.Type, offset: ir.Op): irtables.LowerResult {
  r = emit(r, offset);
  if (ssasem.is_bool(elem)) {
    return emit(r, ir.op_call_direct("__map_bool_column", 2));
  }
  if (ssasem.is_u8(elem)) {
    return emit(r, ir.op_call_direct("__map_u8_column", 2));
  }
  if (cell_column(elem) && ssasem.is_float(elem)) {
    return emit(r, ir.op_call_direct("__map_cell_f64_column", 2));
  }
  if (cell_column(elem)) {
    return emit(r, ir.op_call_direct("__map_cell_column", 2));
  }
  if (ssasem.is_text(elem)) {
    return emit(r, ir.op_call_direct("__map_string_column", 2));
  }
  if (routed_box(elem)) {
    r = emit(r, ir.op_const_i32(1));
    return emit(r, ir.op_call_direct("__map_box_column", 3));
  }
  if (ssasem.is_usize(elem)) {
    r = emit(r, ir.op_const_i32(0));
    return emit(r, ir.op_call_direct("__map_box_column", 3));
  }
  return emit(r, ir.op_call_direct("__map_i32_column", 2));
}

// The cursor holds the map's buffer and, beside it, the unit of the map that
// keeps the buffer live; it is released through __mapiter_drop_impl.
function routed_cursor(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let k: i32 = ins.kind_tag;
  if (k == ssasem.map_iter()) {
    return emit(r, ir.op_call_direct("__map_iter_impl", 1));
  }
  if (k == ssasem.mapiter_has_next()) {
    return emit(r, ir.op_call_direct("__mapiter_has_next_impl", 1));
  }
  if (k == ssasem.mapiter_advance()) {
    return emit(r, ir.op_call_direct("__mapiter_advance_impl", 1));
  }
  let t: typeinfo.Type = f.values[ins.args[0]];
  if (k == ssasem.mapiter_key()) {
    r = emit(r, ir.op_call_direct("__mapiter_key_impl", 1));
    return routed_from_slot(r, semtypes.map_iter_key(t));
  }
  r = emit(r, ir.op_call_direct("__mapiter_value_lent", 1));
  return routed_from_slot(r, semtypes.map_iter_value(t));
}

// An insert consumes the receiver's unit. The receiver is made the frame's
// alone first, by core/map's own copy-on-write, and when that copied it the
// receiver's unit is released here; it cannot be the last.
//
// A string key arrives with a unit of its own. A new entry keeps it; an
// overwrite keeps the equal key already in the column, so the entry count not
// growing is what says the arriving unit is released. An overwrite of a box
// likewise releases the box it supersedes, which core/map leaves to its
// caller and which is read out before the set.
function routed_insert(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let t: typeinfo.Type = f.values[ins.args[0]];
  let res: i32 = scratch_base(f);
  let before: i32 = res + 1;
  let old_val: i32 = res + 2;
  let counted_key: boolean = counted_key_column(ssasem.map_key(t));
  let cell_key: boolean = cell_column(ssasem.map_key(t));
  let boxed_val: boolean = routed_box(ssasem.map_value(t));
  r = reserve(r, old_val + 1);
  r = box_key(r, f, ins);
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_call_direct("__map_cow_inplace", 1));
  r = emit(r, ir.op_store_local(res));
  r = release_if_copied(r, ins.args[0], res);
  if (counted_key || cell_key || boxed_val) {
    r = emit(r, ir.op_load_local(res));
    r = emit(r, ir.op_call_direct("__map_len_impl", 1));
    r = emit(r, ir.op_store_local(before));
  }
  if (boxed_val) {
    r = read_at_key(r, f, ins, res, "__map_lookup_val", old_val);
  }
  r = emit(r, ir.op_load_local(res));
  r = key_operand(r, f, ins);
  r = routed_slot(r, ins.args[2], ssasem.map_value(t));
  r = map_entry(r, f, ins, "__map_set_impl", "__map_set_keyed_impl", 3);
  r = emit(r, ir.op_store_local(res));
  if (counted_key || cell_key || boxed_val) {
    r = emit(r, ir.op_load_local(res));
    r = emit(r, ir.op_call_direct("__map_len_impl", 1));
    r = emit(r, ir.op_load_local(before));
    r = emit(r, ir.op_bin("eq", 0, false));
    r = emit(r, ir.op_if(0));
    if (counted_key && ssasem.keyed_map_key(ssasem.map_key(t))) {
      r = helper(r, ins.args[1], value_release(ssasem.map_key(t)));
    } else if (counted_key) {
      r = release(r, ins.args[1], ssasem.map_key(t), f);
    }
    if (cell_key) {
      r = helper(r, key_cell(f), "__map_cell_free");
    }
    if (boxed_val) {
      r = helper(r, old_val, value_release(ssasem.map_value(t)));
    }
    r = emit(r, ir.op_end());
  }
  return emit(r, ir.op_load_local(res));
}

// `without` answers the map and whether the key was there. The receiver is
// made the frame's alone first, by core/map's own copy-on-write, and the
// delete then runs on it in place. A string or box column's removed entry is
// the map's unit, which core/map's delete drops from the column without
// releasing, so it is read out first and released after.
function routed_delete(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let t: typeinfo.Type = f.values[ins.args[0]];
  let box: i32 = scratch_base(f);
  let found: i32 = box + 1;
  let old_key: i32 = box + 2;
  let old_val: i32 = box + 3;
  let counted_key: boolean = counted_key_column(ssasem.map_key(t));
  let counted_val: boolean = ssasem.is_text(ssasem.map_value(t)) || routed_box(ssasem.map_value(t));
  r = reserve(r, old_val + 1);
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_call_direct("__map_cow_inplace", 1));
  r = emit(r, ir.op_store_local(box));
  r = release_if_copied(r, ins.args[0], box);
  if (counted_key) {
    r = read_at_key(r, f, ins, box, "__map_key_of", old_key);
  }
  if (counted_val) {
    r = read_at_key(r, f, ins, box, "__map_lookup_val", old_val);
  }
  r = emit(r, ir.op_load_local(box));
  r = key_operand(r, f, ins);
  r = map_entry(r, f, ins, "__map_delete_impl", "__map_delete_keyed_impl", 2);
  r = emit(r, ir.op_store_local(found));
  if (counted_key || counted_val) {
    r = emit(r, ir.op_load_local(found));
    r = emit(r, ir.op_if(0));
    if (counted_key) {
      r = helper(r, old_key, value_release(ssasem.map_key(t)));
    }
    if (counted_val) {
      r = helper(r, old_val, value_release(ssasem.map_value(t)));
    }
    r = emit(r, ir.op_end());
  }
  r = emit(r, ir.op_load_local(box));
  r = emit(r, ir.op_load_local(found));
  return emit(r, ir.op_tuple_make_k(2, tuple_kinds(f.values[ins.result])));
}

// A key column holding one unit of each key: a string or a keyed column.
function counted_key_column(k: typeinfo.Type): boolean {
  return ssasem.is_text(k) || ssasem.keyed_map_key(k);
}

// The release of one value a routed column holds: a string's, or a box's
// through its type's own release helper.
function value_release(v: typeinfo.Type): string {
  if (ssasem.is_text(v)) {
    return "__fern_str_free";
  }
  return release_helper_name(v);
}

// The slot `reader` finds in `box` for the instruction's key, kept in `into`.
function read_at_key(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst, box: i32, reader: string, into: i32): irtables.LowerResult {
  r = emit(r, ir.op_load_local(box));
  r = key_operand(r, f, ins);
  r = map_entry(r, f, ins, reader, keyed_twin(reader), 2);
  return emit(r, ir.op_store_local(into));
}

function keyed_twin(reader: string): string {
  if (reader == "__map_key_of") {
    return "__map_key_of_keyed";
  }
  return "__map_lookup_val_keyed";
}

// A call to core/map's `plain` entry for the instruction's map, or for a
// keyed key column to its `keyed` twin, with the key type's hash and
// equality closures after the other `argc` arguments.
function map_entry(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst, plain: string, keyed: string, argc: i32): irtables.LowerResult {
  let k: typeinfo.Type = ssasem.map_key(f.values[ins.args[0]]);
  if (!ssasem.keyed_map_key(k)) {
    return emit(r, ir.op_call_direct(plain, argc));
  }
  r = emit(r, ir.op_const_closure(key_closure_name(k, "hash")));
  r = emit(r, ir.op_const_closure(key_closure_name(k, "eq")));
  return emit(r, ir.op_call_direct(keyed, argc + 2));
}

function release_if_copied(own r: irtables.LowerResult, receiver: i32, handle: i32): irtables.LowerResult {
  r = emit(r, ir.op_load_local(handle));
  r = emit(r, ir.op_load_local(receiver));
  r = emit(r, ir.op_bin("ne", ir.width_ptr(), false));
  r = emit(r, ir.op_if(0));
  r = helper(r, receiver, "__fern_rc_dec");
  return emit(r, ir.op_end());
}

// A get answers an Option box of the frame's own whose payload the runtime
// copies out of the column without a retain, so a hit on a counted column
// retains the payload here: the box then owns one unit of it, as any Option
// this frame drops is expected to.
function retain_hit_payload(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  r = emit(r, ir.op_store_local(ins.result));
  r = emit(r, ir.op_load_local(ins.result));
  r = emit(r, ir.op_opt_tag());
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_bin("eq", 0, false));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(ins.result));
  r = emit(r, ir.op_opt_payload());
  r = emit(r, ir.op_call_direct("__fern_rc_inc", 1));
  r = emit(r, ir.op_drop());
  r = emit(r, ir.op_end());
  return emit(r, ir.op_load_local(ins.result));
}

// A field read at the width its type names. Every slot is 8 bytes on every
// backend, so the offset is the index alone; only wasm's typed load needs to
// know that the slot holds an i64 or an f64 rather than a pointer in its low
// half, and the schema this boundary verified the projection against is what
// says so.
function load_width(t: typeinfo.Type): i32 {
  if (ssasem.is_wide(t) || ssasem.is_float(t)) {
    return 64;
  }
  return 0;
}

// An environment record is the closure box, physically the word array the
// lift builds: its field k is the box's slot k, read with the array op, since
// only the register backends give a record's fields and an array's elements
// the same stride.
function field_get(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let t: typeinfo.Type = f.values[ins.result];
  if (semtypes.is_env(f.values[ins.args[0]])) {
    r = emit(r, ir.op_const_i32(ins.imm));
    return emit(r, ir.op_arr_get(32));
  }
  if (ssasem.is_wide(t)) {
    return emit(r, ir.op_struct_get_i64(ins.imm));
  }
  return emit(r, ir.op_struct_get(ins.imm, load_width(t)));
}

function variant(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst, structs: irtables.StructTab): irtables.LowerResult {
  if (identity_op(ins.kind_tag)) {
    return r;
  }
  if (ins.kind_tag == ssasem.dyn_is()) {
    return dyn_test(r, f, ins);
  }
  let whole: typeinfo.Type = variant_union(f, ins);
  if (enum_layout(f, whole) == semrecords.layout_option()) {
    return option_site(r, f, ins, whole);
  }
  if (ins.kind_tag == ssasem.variant_new()) {
    return emit(r, ir.op_struct_make(ssasem.variant_key(whole, ins.str), ins.args.len(), decl_of(f, ins, structs)));
  }
  if (ins.kind_tag == ssasem.variant_is()) {
    return emit(r, ir.op_variant_is(ssasem.variant_key(whole, ins.str)));
  }
  return field_get(r, f, ins);
}

// A dyn box carries its concrete's shape where a member box carries its
// variant's, so the downcast's test is the member test. An enum's box carries
// the shape of the variant it holds, so an enum target is any of them, each
// test reading the operand afresh.
function dyn_test(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let at: i32 = semrecords.find_enum(f.enums, typeinfo.TypeUnion { name: ins.str, args: [] });
  if (at < 0) {
    return emit(r, ir.op_variant_is(ins.str));
  }
  let first: boolean = true;
  for v in f.enums[at].variants {
    if (!first) {
      r = emit(r, ir.op_load_local(ins.args[0]));
    }
    r = emit(r, ir.op_variant_is(v.name));
    if (!first) {
      r = emit(r, ir.op_bin("or", 0, false));
    }
    first = false;
  }
  return r;
}

// The union a variant instruction works on: a construction produces one, and
// a test or a projection reads one.
function variant_union(f: ssasem.Func, ins: ssa.SInst): typeinfo.Type {
  if (ins.kind_tag == ssasem.variant_new()) {
    return f.values[ins.result];
  }
  return f.values[ins.args[0]];
}

function enum_layout(f: ssasem.Func, t: typeinfo.Type): i32 {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0) {
    return 0;
  }
  return f.enums[at].layout;
}

function variant_tag(f: ssasem.Func, t: typeinfo.Type, name: string): i32 {
  return semrecords.find_variant(f.enums[semrecords.find_enum(f.enums, t)], name);
}

// A payload wider than the narrow slot rides the box's wide form, chosen from
// the payload AT THIS SITE rather than from the union: a mixed
// `Result[i64, string]` writes its Ok through the wide form and its Err — a
// pointer — through the narrow one, which is what each arm reads back. Making
// the whole union wide instead pushes the pointer into an i64 slot, and wasm
// refuses the module for it.
//
// An f32 takes the same 8-byte slot as an f64 rather than a narrow one of its
// own (#7756); `is_float` covers both, and the flag says integer or float
// rather than which width.
function wide_payload(t: typeinfo.Type): boolean {
  return ssasem.is_wide(t) || ssasem.is_float(t);
}

// A builtin union's box is a tag word and one payload word: the tag IS the
// variant's position in the schema, so a test compares it and a projection
// reads the single payload without a field index. A variant with no payload
// (None, or an Ok/Err carrying `void`) is the static box for its tag.
function option_site(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst, whole: typeinfo.Type): irtables.LowerResult {
  let tag: i32 = variant_tag(f, whole, ins.str);
  if (ins.kind_tag == ssasem.variant_new()) {
    if (ins.args.len() == 0) {
      return emit(r, ir.op_const_option(tag));
    }
    let pay: typeinfo.Type = f.values[ins.args[0]];
    if (wide_payload(pay)) {
      return emit(r, ir.op_opt_make_w(tag, 64, !ssasem.is_float(pay)));
    }
    return emit(r, ir.op_opt_make(tag));
  }
  if (ins.kind_tag == ssasem.variant_is()) {
    r = emit(r, ir.op_opt_tag());
    r = emit(r, ir.op_const_i32(tag));
    return emit(r, ir.op_bin("eq", 0, false));
  }
  let got: typeinfo.Type = f.values[ins.result];
  if (wide_payload(got)) {
    return emit(r, ir.op_opt_payload_w(64, !ssasem.is_float(got)));
  }
  return emit(r, ir.op_opt_payload());
}

// Zero at a given width: a 64-bit literal reaches the backends as source text,
// which they splice into a 64-bit immediate, and nothing narrower needs one. A
// float slot takes a float zero — the negation caller guards floats out, so it
// is the zero VALUE that needs this arm.
function zero(t: typeinfo.Type): ir.Op {
  if (ssasem.is_float(t)) {
    return ir.op_const_f64_text("0");
  }
  if (ssasem.is_wide(t)) {
    return ir.op_const_i64_text("0");
  }
  return ir.op_const_i32(0);
}

// A constant the verifier gave literal text to reaches the backends as that
// text, spliced into an immediate of its own width (ssasem.text_constant);
// every other integer constant is carried in the instruction's i32 immediate.
function constant(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  if (ins.kind_tag == 1 && ssasem.is_wide(f.values[ins.result])) {
    return emit(r, ir.op_const_i64_text(ins.str));
  }
  if (ins.kind_tag == 1 && ssasem.is_u32(f.values[ins.result])) {
    return emit(r, ir.op_const_i32_text(ins.str));
  }
  if (ins.kind_tag == 1 && ssasem.is_f64(f.values[ins.result])) {
    return emit(r, ir.op_const_f64_text(ins.str));
  }
  if (ins.kind_tag == 1 && ssasem.is_f32(f.values[ins.result])) {
    r = emit(r, ir.op_const_f64_text(ins.str));
    return round_f32(r);
  }
  if (ins.kind_tag == 5) {
    return emit(r, ir.op_const_str(ins.str));
  }
  if (ins.kind_tag == ssasem.zero()) {
    let t: typeinfo.Type = f.values[ins.result];
    r = emit(r, zero(t));
    if (ssasem.is_f32(t)) {
      return round_f32(r);
    }
    return r;
  }
  return emit(r, ir.op_const_i32(ins.imm));
}

// Integer negation is a zero-minus, so the zero is pushed under the operand at
// the operand's own width or the two sides of the subtraction disagree; a
// float has its own sign-flip opcode and pushes nothing.
function negation_zero(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  if (ins.kind_tag == 10 && ins.str == "-" && !ssasem.is_float(f.values[ins.args[0]])) {
    return emit(r, zero(f.values[ins.args[0]]));
  }
  return r;
}

// A construction the plan found constant is a static box: its operands were
// loaded for the ordinary construction and are dropped unread.
function static_box(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): irtables.LowerResult {
  for a in ins.args {
    r = emit(r, ir.op_drop());
  }
  let nfields: i32 = ins.args.len();
  if (ins.kind_tag == ssasem.array_new()) {
    nfields = 0;
  }
  return emit(r, ir.op_const_struct(static_name(f, ins), nfields, static_values(f, p, p.constants[ins.result])));
}

function static_name(f: ssasem.Func, ins: ssa.SInst): string {
  if (ins.kind_tag == ssasem.array_new() && ssasem.is_u8(elem_type(f.values[ins.result]))) {
    return "&bytes";
  }
  if (ins.kind_tag == ssasem.array_new()) {
    return "&arr";
  }
  if (ins.kind_tag == ssasem.record_new()) {
    return record_name(f.values[ins.result]);
  }
  return ins.str;
}

// A static box's field words with each `@<value>` replaced by the packing of
// the box that value is, in braces (ir.const_struct_ref), and each `$<value>`
// by its string literal's (ir.const_str_word).
function static_values(f: ssasem.Func, p: ssaunits.Plan, words: string): string {
  let out: string = "";
  for w in ir.const_struct_values(words) {
    if (out.len() > 0) {
      out = out + ",";
    }
    if (w.len() > 0 && w[0] == b'@') {
      let v: i32 = util.lit_to_i32(slice_unchecked(w, 1, w.len()) + "");
      out = out + "{" + static_name(f, p.defs[v]) + "|" + static_values(f, p, p.constants[v]) + "}";
    } else if (w.len() > 0 && w[0] == b'$') {
      out = out + ir.const_str_word(p.defs[util.lit_to_i32(slice_unchecked(w, 1, w.len()) + "")].str);
    } else {
      out = out + w;
    }
  }
  return out;
}

function constant_op(k: i32): boolean {
  return k == 1 || k == 2 || k == 5 || k == ssasem.zero();
}

function instruction(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst, structs: irtables.StructTab, defer0: boolean, link: Link, kept: boolean): irtables.LowerResult {
  r = negation_zero(r, f, ins);
  if (ins.kind_tag == 35) {
    // The source-position marker: no operands and a value nothing reads, so
    // neither a load nor the store below.
    return emit(r, ir.op_line(ins.imm, util.digits_to_i32(ins.str)));
  }
  if (ins.kind_tag == ssasem.with()) {
    r = with_update(r, f, p, ins, defer0);
    return emit(r, ir.op_store_local(ins.result));
  }
  if (ssasem.is_cell_op(ins.kind_tag)) {
    return cell_site(r, f, ins);
  }
  if (ssasem.is_hole_op(ins.kind_tag)) {
    return hole_site(r, ins);
  }
  if (ssasem.is_map_op(ins.kind_tag) || ssasem.is_map_iter_op(ins.kind_tag)) {
    r = routed_map_site(r, f, ins);
    return emit(r, ir.op_store_local(ins.result));
  }
  if (ssasem.is_function_op(ins.kind_tag)) {
    r = function_site(r, f, ins);
    return emit(r, ir.op_store_local(ins.result));
  }
  if (ins.kind_tag == ssasem.arr_join()) {
    r = join_call(r, ins);
    return emit(r, ir.op_store_local(ins.result));
  }
  if (ins.kind_tag == ssasem.append()) {
    r = append_push(r, f, p, ins, defer0, link);
    return emit(r, ir.op_store_local(ins.result));
  }
  if (ssaunits.string_append(f, ins) && !defer0 && !p.literal[ins.args[0]]) {
    r = grow_or_concat(r, f, ins);
    return emit(r, ir.op_store_local(ins.result));
  }
  if (ssaunits.string_append(f, ins) && defer0 && p.grows[ins.result] >= 0) {
    r = grow_field_or_concat(r, f, p, ins);
    return emit(r, ir.op_store_local(ins.result));
  }
  if (literal_text_eq(f, p, ins) >= 0) {
    r = text_eq_by_length(r, f, p, ins);
    return emit(r, ir.op_store_local(ins.result));
  }
  if (ins.kind_tag == 9 && (ssasem.saturating(ins.str) || ssasem.checked_arith(ins.str))) {
    r = overflow_binary(r, f, ins);
    return emit(r, ir.op_store_local(ins.result));
  }
  if (dyn_call(ins)) {
    r = dyn_site(r, ins);
    return emit(r, ir.op_store_local(ins.result));
  }
  if (ins.kind_tag == ssasem.append_range()) {
    r = concatenation(r, ins, scratch_base(f));
  } else if (unchecked_str_index(ins)) {
    // The string's data address, then the index: hoist_loop_invariants can
    // lift the address out of a loop that only reads the string.
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_str_data());
    r = emit(r, ir.op_load_local(ins.args[1]));
  } else {
    for arg in ins.args {
      r = emit(r, ir.op_load_local(arg));
    }
  }
  if (constant_op(ins.kind_tag)) {
    r = constant(r, f, ins);
  }
  if (ssasem.scalar_op(ins.kind_tag)) {
    r = scalar(r, f, ins);
  }
  if (ins.kind_tag == ssasem.slice() && p.frame_views[ins.result]) {
    r = emit(r, ir.op_str_slice_frame(0));
  } else if (p.constants[ins.result] != "") {
    r = static_box(r, f, p, ins);
  } else if (container_op(ins.kind_tag)) {
    r = container(r, f, ins, structs);
  }
  // A call's counted parameters were supplied before its operands were
  // loaded; its result is the unit the callee returns. A runtime builtin
  // is its own op, pushing the value its contract names or the dummy a
  // statement op pushes, so the store below takes either.
  if (ins.kind_tag == ssasem.call()) {
    r = call_site(r, f, ins);
  }
  // A verified copy already has its single operand on the stack.
  r = emit(r, ir.op_store_local(ins.result));
  if (ins.kind_tag == ssasem.call() && ins.imm > 0) {
    // A paired call (sempair): its word is read before anything can call again.
    r = emit(r, ir.op_call_word());
    r = emit(r, ir.op_store_local(ins.imm - 1));
  }
  r = took(r, p, ins);
  if (kept && payload_taken(f, p, ins)) {
    r = unless_unique(r, token_slot(f), ins.result, "__fern_rc_inc");
  } else {
    r = took_payload(r, f, p, ins);
  }
  return held(r, p, ins);
}

// An element read the plan HOLDS retains what it read: the unit is the frame's
// own from here (ssaunits.held_elements).
function held(own r: irtables.LowerResult, p: ssaunits.Plan, ins: ssa.SInst): irtables.LowerResult {
  if (ins.result >= p.held.len() || !p.held[ins.result]) {
    return r;
  }
  return helper(r, ins.result, "__fern_rc_inc");
}

// A tuple read the plan admitted as a TAKE nulls the slot it read. The source
// dies at this instruction, so its drop runs in this same step, after this —
// and the release helpers are null-guarded, so the walk goes past the slot the
// frame now owns rather than freeing it twice (ssaunits.tuple_take_field).
// __fern_arr_str_join reads the array as parameter 0, and a direct call takes
// its last parameter from the top of the stack, so the separator is pushed
// first. The instruction spells the receiver first, as every other operation
// here does, which is why this loads the two in reverse rather than leaving
// them to the generic push.
function join_call(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.op_load_local(ins.args[0]));
  return emit(r, ir.op_call_direct("__fern_arr_str_join", 2));
}

function took(own r: irtables.LowerResult, p: ssaunits.Plan, ins: ssa.SInst): irtables.LowerResult {
  if (ins.result >= p.takes.len() || p.takes[ins.result] < 0) {
    return r;
  }
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_const_i32(0));
  return emit(r, ir.op_tuple_set(p.takes[ins.result]));
}

// A variant read the plan admitted as a payload TAKE moves the payload out of
// the box when nobody else holds the box, and retains it as a borrow did when
// somebody does: `steal`'s shape at the READ rather than at a call's supply,
// so every consuming use downstream sees a unit of the frame's own. The box
// dies at this read, so its own drop runs in this same step — walking past
// the slot the take emptied, then releasing the box itself
// (ssaunits.payload_root).
function took_payload(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): irtables.LowerResult {
  if (!payload_taken(f, p, ins)) {
    return r;
  }
  return steal(r, f, ins.result, scratch_base(f));
}

function payload_taken(f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): boolean {
  return ins.result < p.payloads.len() && p.payloads[ins.result] && ssaunits.shell_root(f, p, ins) < 0;
}

// The received unit's box when it is the only one and a fresh sole-owned copy
// otherwise, left in `scratch`. The unit is one the frame has already taken —
// moved in, or retained up front — so the unique arm keeps it and the shared
// arm releases it, the copy having replaced it. The copy duplicated every
// element pointer, so a counted element type retains them all. Either way
// exactly one unit goes in and `scratch` holds one nobody else shares.
//
// A receiver whose retain was DEFERRED never arrives here: `append_push` sends
// it to `append_borrowed` or `append_field` instead, and `with_update` sends
// one whose field the plan admitted to `with_field`.
function sole_owned_base(own r: irtables.LowerResult, f: ssasem.Func, base: i32, scratch: i32): irtables.LowerResult {
  let elem: typeinfo.Type = elem_type(f.values[base]);
  r = emit(r, ir.op_load_local(base));
  r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(base));
  r = emit(r, ir.op_store_local(scratch));
  r = emit(r, ir.op_else());
  r = release(r, base, f.values[base], f);
  r = emit(r, ir.op_load_local(base));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_load_local(base));
  r = emit(r, ir.op_arr_len());
  r = emit(r, ir.op_arr_slice(elem_width(elem)));
  r = emit(r, ir.op_store_local(scratch));
  if (ssasem.reference(elem)) {
    r = own_copied(r, elem, scratch, scratch);
  }
  return emit(r, ir.op_end());
}

// One element pushed onto the sole-owned box above, so the push grows a buffer
// no one else can read and the reclaim-on-grow form may reuse it. The runtime's
// push consumes the receiver's unit only when it is the box's only one — it
// leaves a shared receiver's count alone and hands back an un-share copy — so
// the release that makes the operation take exactly one unit at every count
// belongs here rather than in the shared helper the AST lowering also calls.
function append_push(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst, defer0: boolean, link: Link): irtables.LowerResult {
  if (link.root >= 0) {
    return append_linked(r, f, ins, link);
  }
  if (defer0 && p.grows[ins.result] >= 0) {
    return append_field(r, f, p, ins);
  }
  if (defer0) {
    return append_borrowed(r, f, ins, link.out);
  }
  let elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
  if (p.unique_receivers[ins.result]) {
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_load_local(ins.args[1]));
    return emit(r, ir.Op { ...arr_push_op(elem), i32_imm: 1 });
  }
  let res: i32 = scratch_base(f);
  r = reserve(r, res + 1);
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
  r = emit(r, ir.op_if(0));
  // The box's only unit is the one this frame holds, so the consuming push
  // grows it in place and reclaims it on a realloc.
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.Op { ...arr_push_op(elem), i32_imm: 1 });
  r = emit(r, ir.op_store_local(res));
  r = emit(r, ir.op_else());
  // Shared: the NON-consuming push un-shares, which is the same copy
  // `sole_owned_base` would make here and a memcpy rather than a per-element
  // loop through `__fern_arr_slice` (#9526). It frees nothing, so this
  // frame's unit on the receiver is released after, and the counted elements
  // the fresh box now aliases are retained over the receiver exactly as
  // `append_borrowed` retains them.
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, arr_push_borrowed_op(elem));
  r = emit(r, ir.op_store_local(res));
  if (ssasem.reference(elem)) {
    r = own_copied(r, elem, res, ins.args[0]);
  }
  r = release(r, ins.args[0], f.values[ins.args[0]], f);
  r = emit(r, ir.op_end());
  return emit(r, ir.op_load_local(res));
}

// The push onto a receiver the frame holds no unit of. The non-consuming push
// decides for itself: it grows the buffer in place when it is the box's only
// reader — which `bracketed` makes true only when the caller keeps no
// binding — and un-shares otherwise, never freeing what it was handed. So
// the unit this operation owes is a retain of the result exactly when the
// result IS the receiver's box.
//
// The other case is where this gets its second half. `__fern_arr_push` FREES
// NOTHING on any path: it allocates a fresh box, memcpy's the element pointers
// into it WITHOUT retaining them, and abandons the old buffer. The two then
// share one count per element, which the AST lowering settles by never
// releasing the old buffer — the LOAD-BEARING LEAK comment in asm_ir.fern, and
// why the AST build leaks 524 KB on #9365's reproducer. This frame's caller
// does release it, because the plan balances every unit, so the aliased
// elements have to be counted for: `own_copied` over the RECEIVER's length
// names exactly the boxes the fresh one aliases, since the receiver is
// untouched and the element just pushed is not among them. O(n) per grow, so
// amortised O(1) against the doubling, and the same shape `sole_owned_base`
// already uses on its copy arm.
//
// A result that is a chain LINK (`out`, see `append_linked`) skips the retain:
// it is owed where the chain ends.
function append_borrowed(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst, out: boolean): irtables.LowerResult {
  let scratch: i32 = scratch_base(f);
  r = reserve(r, scratch + 1);
  r = borrowed_push(r, f, ins, scratch, out);
  return emit(r, ir.op_load_local(scratch));
}

// The non-consuming push onto a box the frame holds no unit of, into
// `scratch`, and the units that settles: a retain of the result when it is
// the receiver's box, unless `out` defers it, and a count on every element
// the receiver shares with a fresh result.
function borrowed_push(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst, scratch: i32, out: boolean): irtables.LowerResult {
  let elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, arr_push_borrowed_op(elem));
  r = emit(r, ir.op_store_local(scratch));
  let aliased: boolean = ssasem.reference(elem);
  if (out && !aliased) {
    return r;
  }
  r = emit(r, ir.op_load_local(scratch));
  r = emit(r, ir.op_load_local(ins.args[0]));
  if (out) {
    r = emit(r, ir.op_bin("ne", 0, false));
    r = emit(r, ir.op_if(0));
    r = own_copied(r, elem, scratch, ins.args[0]);
    return emit(r, ir.op_end());
  }
  r = emit(r, ir.op_bin("eq", 0, false));
  r = emit(r, ir.op_if(0));
  r = helper(r, scratch, "__fern_rc_inc");
  if (aliased) {
    r = emit(r, ir.op_else());
    r = own_copied(r, elem, scratch, ins.args[0]);
  }
  return emit(r, ir.op_end());
}

// Appends threaded through a borrowed parameter, `b = b.append(x); return
// b.append(y)` or the same in a loop. Retaining each result as
// `append_borrowed` does would leave the caller's box at two counts, and the
// next push would copy it whole. So such a value is a LINK (`links_of`): it
// still carries the unit the plan gives it, but encoded at run time. A link
// that is still the parameter's box (`root`) has not taken its unit, and the
// push onto it is the non-consuming one again. Any other link is a fresh box
// of the frame's own at one count, which the consuming push grows in place.
// The unit that is owed is taken where the value stops being a link: by an
// append whose result is not one, or at the return (`take_owed`).
struct Link { root: i32, out: boolean }

function append_linked(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst, link: Link): irtables.LowerResult {
  let elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
  let scratch: i32 = scratch_base(f);
  r = reserve(r, scratch + 1);
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_load_local(link.root));
  r = emit(r, ir.op_bin("eq", 0, false));
  r = emit(r, ir.op_if(0));
  r = borrowed_push(r, f, ins, scratch, link.out);
  r = emit(r, ir.op_else());
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, arr_push_op(elem));
  r = emit(r, ir.op_store_local(scratch));
  r = emit(r, ir.op_end());
  return emit(r, ir.op_load_local(scratch));
}

// The links of a function, by value: the parameter each link's unit is owed
// on, -1 for a value that is not one. A link is an append onto the parameter
// whose retain was deferred, an append onto a link, a phi whose every input is
// the parameter or a link of it, which is how a loop carries one, or the
// result of a direct call lent the parameter or a link as the last reader of
// its box (`call_root`), `b = f(b, v)`.
//
// Every use of a link has to understand the encoding, so a candidate stays
// only while each supply naming it MOVES it into one of three places: the
// receiver of an append, a link phi, or the return, which takes the unit that
// is owed. A read that takes no unit is fine, since the box is live either
// way, and so is a drop, which releases only a box of the frame's own
// (`drop_linked`). A loop's link reaches its phi by move only because
// `ssalive` counts a phi's inputs on the incoming edge rather than as uses in
// its block. A retain or a steal is not, and neither is a parameter the frame
// reads anywhere else: it is removed, and whatever depended on it goes with it
// on the next round.
function links_of(f: ssasem.Func, p: ssaunits.Plan, idx: i32[][]): i32[] {
  let top: i32 = 0 - 2;
  let state: i32[] = [];
  let v: i32 = 0;
  while (v < f.graph.nvals) {
    state = state.append(0 - 1);
    v = v + 1;
  }
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    for ins in f.graph.blocks[bi].insts {
      if (link_kind(f, p, ins)) {
        state = state.with(ins.result, top);
      }
    }
    bi = bi + 1;
  }
  let roots: boolean[] = link_roots(f, p);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let next: i32[] = propagate(f, p, idx, state, roots);
    next = prune(f, p, next);
    v = 0;
    while (v < next.len()) {
      if (next[v] != state[v]) {
        changed = true;
      }
      v = v + 1;
    }
    state = next;
  }
  v = 0;
  while (v < state.len()) {
    if (state[v] == top) {
      state = state.with(v, 0 - 1);
    }
    v = v + 1;
  }
  return state;
}

function link_kind(f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): boolean {
  if (ins.kind_tag == ssasem.append()) {
    return p.grows[ins.result] < 0;
  }
  if (ins.kind_tag == ssasem.call()) {
    return is_array_type(f.values[ins.result]) && !dyn_call(ins);
  }
  return ins.kind_tag == 8 && is_array_type(f.values[ins.result]);
}

function is_array_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  return false;
}

// The parameters a link may be owed on: borrowed arrays the frame is done
// with wherever a link of theirs may grow the box. A deferred append already
// requires the parameter dead after it (`deferred_retain`), and a phi edge
// requires it dead in the loop it enters (`Plan.entry_kept`), so any read of
// it, a return of it included, happens before the box can grow.
function link_roots(f: ssasem.Func, p: ssaunits.Plan): boolean[] {
  let ok: boolean[] = [];
  let v: i32 = 0;
  while (v < f.graph.nparams) {
    ok = ok.append(is_array_type(f.values[v]) && !(v < p.owned.len() && p.owned[v]) && !p.entry_kept[v]);
    v = v + 1;
  }
  return ok;
}

// One round of the candidates' roots, read off their inputs. A root only
// descends: unknown, then a parameter, then none.
function propagate(f: ssasem.Func, p: ssaunits.Plan, idx: i32[][], state: i32[], roots: boolean[]): i32[] {
  let top: i32 = 0 - 2;
  let out: i32[] = state;
  for b in f.graph.blocks {
    let pos: i32 = 0 - 1;
    for ins in b.insts {
      pos = pos + 1;
      if (state[ins.result] == 0 - 1) {
        continue;
      }
      let root: i32 = top;
      if (ins.kind_tag == ssasem.append()) {
        root = input_root(f, state, roots, ins.args[0]);
        // Straight onto the parameter, the push must be the deferred one.
        if (ins.args[0] < f.graph.nparams && !deferred_retain(f, p, at(p, idx, b.id, pos, 0 - 1), ins)) {
          root = 0 - 1;
        }
      } else if (ins.kind_tag == ssasem.call()) {
        root = call_root(f, at(p, idx, b.id, pos, 0 - 1), state, roots, ins);
      } else {
        for a in ins.args {
          let r0: i32 = input_root(f, state, roots, a);
          if (r0 == 0 - 1 || root >= 0 && r0 >= 0 && r0 != root) {
            root = 0 - 1;
          } else if (r0 >= 0 && root == top) {
            root = r0;
          }
        }
      }
      if (root != top || state[ins.result] == top) {
        out = out.with(ins.result, root);
      }
    }
  }
  return out;
}

// A call's result is a link of the one root among its operands, lent as the
// last reader of the box: the parameter handed on (ssaunits.hands) or a link
// dying at the call. The callee may grow that box in place, since nothing in
// this frame reads it again, and what comes back is either the same box, at
// the callee's retain, or one the frame holds a unit of.
function call_root(f: ssasem.Func, step: ssaunits.Step, state: i32[], roots: boolean[], ins: ssa.SInst): i32 {
  let modes: i32[] = ssaunits.callee_modes(f, ins);
  let root: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let r0: i32 = input_root(f, state, roots, ins.args[i]);
    if (r0 != 0 - 1) {
      if (root != 0 - 1 || !lent_last(f, step, modes, ins, i)) {
        return 0 - 1;
      }
      root = r0;
    }
    i = i + 1;
  }
  return root;
}

function lent_last(f: ssasem.Func, step: ssaunits.Step, modes: i32[], ins: ssa.SInst, i: i32): boolean {
  let a: i32 = ins.args[i];
  if (i >= modes.len() || modes[i] != ssaunits.borrow_mode() || ssaunits.occurrences(ins.args, a) != 1) {
    return false;
  }
  if (a < f.graph.nparams) {
    return i < step.hand_roots.len() && step.hand_roots[i] == a;
  }
  return util.index_of_i32(step.drops, a) >= 0;
}

function input_root(f: ssasem.Func, state: i32[], roots: boolean[], a: i32): i32 {
  if (a < 0) {
    return 0 - 1;
  }
  if (a < f.graph.nparams) {
    if (roots[a]) {
      return a;
    }
    return 0 - 1;
  }
  return state[a];
}

// Candidates with a use the encoding cannot reach, removed.
function prune(f: ssasem.Func, p: ssaunits.Plan, state: i32[]): i32[] {
  let out: i32[] = state;
  let at: i32[] = ssa.block_positions(f.graph);
  for step in p.steps {
    for h in step.hand_roots {
      out = unlink(out, h);
    }
    for supply in step.supplies {
      if (supply.value >= 0 && supply.value < state.len() && state[supply.value] != 0 - 1 && !linked_supply(f, p, at, state, step, supply)) {
        out = unlink(out, supply.value);
      }
    }
  }
  return out;
}

function unlink(own state: i32[], v: i32): i32[] {
  if (v < 0 || v >= state.len()) {
    return state;
  }
  return state.with(v, 0 - 1);
}

function linked_supply(f: ssasem.Func, p: ssaunits.Plan, at: i32[], state: i32[], step: ssaunits.Step, supply: ssaunits.Supply): boolean {
  if (supply.mode != ssaunits.move_unit()) {
    return false;
  }
  let b: ssa.SBlock = f.graph.blocks[at[step.block]];
  if (step.point == ssaunits.return_point()) {
    return b.term.kind_tag == 1 && b.term.value == supply.value;
  }
  if (step.point == ssaunits.edge_point()) {
    let dest: ssa.SBlock = f.graph.blocks[at[step.target]];
    if (supply.slot < 0 || supply.slot >= dest.insts.len()) {
      return false;
    }
    let phi: ssa.SInst = dest.insts[supply.slot];
    return phi.kind_tag == 8 && same_root(state[phi.result], state[supply.value]);
  }
  if (step.point < 0) {
    return false;
  }
  let ins: ssa.SInst = b.insts[step.point];
  return ins.kind_tag == ssasem.append() && supply.slot == 0 && ins.args[0] == supply.value && p.grows[ins.result] < 0;
}

function same_root(a: i32, b: i32): boolean {
  if (a == 0 - 1 || b == 0 - 1) {
    return false;
  }
  return a == b || a == 0 - 2 || b == 0 - 2;
}

// The append's view of the links: the root its receiver is a link of, and
// whether its own result is one.
function link_at(f: ssasem.Func, links: i32[], ins: ssa.SInst): Link {
  if (ins.kind_tag != ssasem.append()) {
    return Link { root: 0 - 1, out: false };
  }
  let root: i32 = 0 - 1;
  if (ins.args[0] >= f.graph.nparams) {
    root = links[ins.args[0]];
  }
  return Link { root: root, out: links[ins.result] >= 0 };
}

// An edge's supplies less the retain of a parameter into a link phi of it:
// the phi still holds the parameter's box, whose unit stays owed.
function owed_on_entry(step: ssaunits.Step, dest: ssa.SBlock, links: i32[]): ssaunits.Step {
  let kept: ssaunits.Supply[] = [];
  for supply in step.supplies {
    let owed: boolean = supply.mode == ssaunits.retain_unit() && supply.slot >= 0 && supply.slot < dest.insts.len()
      && dest.insts[supply.slot].kind_tag == 8 && links[dest.insts[supply.slot].result] == supply.value;
    if (!owed) {
      kept = kept.append(supply);
    }
  }
  return ssaunits.Step { ...step, supplies: kept };
}

// A call result that is a link and still the parameter's box gives the
// callee's retain back: the caller's count keeps the box live, and the link
// holds no unit while it is the parameter's.
function settle_call_link(own r: irtables.LowerResult, f: ssasem.Func, links: i32[], ins: ssa.SInst): irtables.LowerResult {
  if (ins.kind_tag != ssasem.call() || links[ins.result] < 0) {
    return r;
  }
  r = emit(r, ir.op_load_local(ins.result));
  r = emit(r, ir.op_load_local(links[ins.result]));
  r = emit(r, ir.op_bin("eq", 0, false));
  r = emit(r, ir.op_if(0));
  r = release(r, ins.result, f.values[ins.result], f);
  return emit(r, ir.op_end());
}

// The drop of `value`, which a link owes only when it is a box of the frame's
// own.
function drop_linked(own r: irtables.LowerResult, value: i32, links: i32[], f: ssasem.Func): irtables.LowerResult {
  if (value >= links.len() || links[value] < 0) {
    return drop_value(r, value, f.values[value], scratch_base(f), f);
  }
  r = emit(r, ir.op_load_local(value));
  r = emit(r, ir.op_load_local(links[value]));
  r = emit(r, ir.op_bin("ne", 0, false));
  r = emit(r, ir.op_if(0));
  r = drop_value(r, value, f.values[value], scratch_base(f), f);
  return emit(r, ir.op_end());
}

// The unit a link owes, taken where it leaves the frame: a retain when it is
// still the parameter's box, nothing when it is a box of the frame's own.
function take_owed(own r: irtables.LowerResult, v: i32, root: i32): irtables.LowerResult {
  r = emit(r, ir.op_load_local(v));
  r = emit(r, ir.op_load_local(root));
  r = emit(r, ir.op_bin("eq", 0, false));
  r = emit(r, ir.op_if(0));
  r = helper(r, v, "__fern_rc_inc");
  return emit(r, ir.op_end());
}

// The push onto a FIELD buffer of a record this frame reads no further
// through that field (ssaunits.field_grow_root). The record's own count says whether
// another holder can still reach the buffer. A shared record holds a second
// count on the field across the push, so the push copies and the field stays
// in place; a sole-owned record lets it grow in place, and the identity arm
// then MOVES the buffer out of the field — nulled, so the record's release
// finds nothing there — the result being its only remaining name. A grow
// that reallocated, or a copy, leaves the old buffer in the field for the
// record's release, its elements now aliased by the result and counted for
// exactly as `append_borrowed` counts them.
function append_field(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): irtables.LowerResult {
  let elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
  let root: i32 = p.grows[ins.result];
  let unique: i32 = scratch_base(f);
  let res: i32 = unique + 1;
  r = reserve(r, res + 1);
  r = emit(r, ir.op_load_local(root));
  r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
  r = emit(r, ir.op_store_local(unique));
  r = unless_unique(r, unique, ins.args[0], "__fern_arr_share_inc");
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, arr_push_borrowed_op(elem));
  r = emit(r, ir.op_store_local(res));
  r = unless_unique(r, unique, ins.args[0], "__fern_arr_share_dec");
  r = emit(r, ir.op_load_local(res));
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_bin("eq", 0, false));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(root));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_struct_set(p.grow_fields[ins.result], 0));
  if (ssasem.reference(elem)) {
    r = emit(r, ir.op_else());
    r = own_copied(r, elem, res, ins.args[0]);
  }
  r = emit(r, ir.op_end());
  return emit(r, ir.op_load_local(res));
}

// `if (!unique) { fn(value) }`: one half of the share bracket a shared record
// holds on its field across the push.
function unless_unique(own r: irtables.LowerResult, unique: i32, value: i32, fn: string): irtables.LowerResult {
  r = emit(r, ir.op_load_local(unique));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_bin("eq", 0, false));
  r = emit(r, ir.op_if(0));
  r = helper(r, value, fn);
  return emit(r, ir.op_end());
}

// The element the store replaces gives back the one count it held.
function drop_replaced(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst, scratch: i32, elem: typeinfo.Type): irtables.LowerResult {
  let old: i32 = scratch + 1;
  r = reserve(r, old + 1);
  r = emit(r, ir.op_load_local(scratch));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, arr_get_op(elem, false));
  r = emit(r, ir.op_store_local(old));
  return drop_value(r, old, elem, old + 1, f);
}

// One element replaced in the sole-owned box above: in place when the received
// unit was the box's only one and in a fresh copy otherwise, the AST lowering's
// two forms chosen here by the count at run time rather than by the receiver's
// syntax.
function with_update(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst, defer0: boolean): irtables.LowerResult {
  if (defer0 && p.grows[ins.result] >= 0) {
    return with_field(r, f, p, ins);
  }
  let elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
  let scratch: i32 = scratch_base(f);
  r = reserve(r, scratch + 1);
  if (p.unique_receivers[ins.result]) {
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_store_local(scratch));
  } else {
    r = sole_owned_base(r, f, ins.args[0], scratch);
  }
  if (ssasem.reference(elem)) {
    r = drop_replaced(r, f, ins, scratch, elem);
  }
  r = emit(r, ir.op_load_local(scratch));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.op_load_local(ins.args[2]));
  r = emit(r, with_set_op(p, ins, elem));
  return emit(r, ir.op_load_local(scratch));
}

// One element replaced in a record FIELD the plan admitted (grows): written
// in place when the record and its buffer are each sole-held, with the field
// nulled so the record's release skips the buffer the result now owns, and
// in a fresh copy otherwise, which leaves the record whole for its other
// holders. The receiver's retain was held back (deferred_retain), so the two
// count tests read the boxes rather than this frame's supply, as the field
// append's do.
function with_field(own r: irtables.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): irtables.LowerResult {
  let elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
  let root: i32 = p.grows[ins.result];
  let unique: i32 = scratch_base(f);
  let res: i32 = unique + 1;
  r = reserve(r, res + 1);
  r = emit(r, ir.op_load_local(root));
  r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
  r = emit(r, ir.op_store_local(unique));
  r = emit(r, ir.op_else());
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_store_local(unique));
  r = emit(r, ir.op_end());
  r = emit(r, ir.op_load_local(unique));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_store_local(res));
  r = emit(r, ir.op_load_local(root));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_struct_set(p.grow_fields[ins.result], 0));
  r = emit(r, ir.op_else());
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_arr_len());
  r = emit(r, ir.op_arr_slice(elem_width(elem)));
  r = emit(r, ir.op_store_local(res));
  if (ssasem.reference(elem)) {
    r = own_copied(r, elem, res, res);
  }
  r = emit(r, ir.op_end());
  if (ssasem.reference(elem)) {
    r = drop_replaced(r, f, ins, res, elem);
  }
  r = emit(r, ir.op_load_local(res));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.op_load_local(ins.args[2]));
  r = emit(r, with_set_op(p, ins, elem));
  return emit(r, ir.op_load_local(res));
}

// A with writes a box of its receiver's length, so an index the plan saw
// checked against the receiver needs no second check.
function with_set_op(p: ssaunits.Plan, ins: ssa.SInst, elem: typeinfo.Type): ir.Op {
  if (p.checked_writes[ins.result]) {
    return ir.in_bounds(arr_set_op(elem));
  }
  return arr_set_op(elem);
}

// R7 of docs/REUSE-CONTRACT.md: a same-shape `map` over an `own` array writes
// each result through the donor's buffer instead of appending to a fresh one.
// `maps` marks, by result value, the calls every static condition admits:
//
// - the receiver is a parameter this function consumes, and its unit dies at
//   the call with nothing else supplied from it, so it is the frame's to give;
// - the element function is a lambda that captures nothing and reaches no
//   observable effect (`pure`), so it cannot read the buffer it is writing;
// - the element type is unchanged and is a 64-bit integer, the slice native
//   implements, and the result is not linked to a borrowed parameter.
//
// The uniqueness test at run time (`sole_owned_base`) is what keeps a shared
// donor immutable: its buffer is copied before the first write.
// The reuse layer's off switch (`no_reuse`) turns it off with the pairings.
// The same table also marks scale kernels admitted by scale_reason below.
function in_place_maps(f: ssasem.Func, modes: i32[], p: ssaunits.Plan, idx: i32[][], links: i32[], pure: util.NameIndex, no_reuse: boolean): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  if (no_reuse) {
    return out;
  }
  for b in f.graph.blocks {
    let pos: i32 = 0;
    while (pos < b.insts.len()) {
      let ins: ssa.SInst = b.insts[pos];
      if (array_reuse_candidate(ins)) {
        let step: ssaunits.Step = at(p, idx, b.id, pos, 0 - 1);
        if (in_place_array(f, modes, p, step, links, pure, ins)) {
          out = out.with(ins.result, true);
        }
      }
      pos = pos + 1;
    }
  }
  return out;
}

function array_reuse_candidate(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssasem.call() && (ins.str == "__scale_f64" || util.str_has_prefix(ins.str, "__arrm_map__"));
}

function in_place_array(f: ssasem.Func, modes: i32[], p: ssaunits.Plan, step: ssaunits.Step, links: i32[], pure: util.NameIndex, ins: ssa.SInst): boolean {
  if (ins.str == "__scale_f64") {
    return scale_reason(f, p, step, links, ins) == semarrayreport.scale_storage_guarded_reuse();
  }
  return map_reason(f, modes, step, links, pure, ins) == semarrayreport.storage_guarded_reuse();
}

// The scale builtin lends its argument, but a unit already owned by this
// frame and dropped immediately after the call may instead become the result.
// This includes a guarded record-field take admitted by the typed planner.
// Borrowed fields and still-live values cannot donate. The dynamic buffer
// uniqueness test remains necessary even when the record itself was unique.
function scale_reason(f: ssasem.Func, p: ssaunits.Plan, step: ssaunits.Step, links: i32[], ins: ssa.SInst): i32 {
  if (util.has_str(f.shadows, ins.str)) {
    return semarrayreport.scale_storage_builtin_shadowed();
  }
  if (ins.args.len() != 2 || !semtypes.equal(f.values[ins.args[0]], f.values[ins.result])) {
    return semarrayreport.scale_storage_shape_unsupported();
  }
  if (links[ins.result] >= 0) {
    return semarrayreport.scale_storage_borrow_linked_result();
  }
  let recv: i32 = ins.args[0];
  if (!p.owned[recv]) {
    return semarrayreport.scale_storage_receiver_borrowed();
  }
  if (util.index_of_i32(step.drops, recv) < 0) {
    return semarrayreport.scale_storage_receiver_still_live();
  }
  if (supplied(step, recv)) {
    return semarrayreport.scale_storage_receiver_supplied();
  }
  return semarrayreport.scale_storage_guarded_reuse();
}

function map_reason(f: ssasem.Func, modes: i32[], step: ssaunits.Step, links: i32[], pure: util.NameIndex, ins: ssa.SInst): i32 {
  if (ins.args.len() != 2) {
    return semarrayreport.storage_shape_unsupported();
  }
  if (ins.args[0] == ins.args[1]) {
    return semarrayreport.storage_aliased_arguments();
  }
  if (links[ins.result] >= 0) {
    return semarrayreport.storage_borrow_linked_result();
  }
  let recv: i32 = ins.args[0];
  if (!same_wide_array(f.values[recv], f.values[ins.result])) {
    return semarrayreport.storage_shape_unsupported();
  }
  if (!consumed_param(f, modes, recv)) {
    return semarrayreport.storage_receiver_not_consumed_param();
  }
  if (util.index_of_i32(step.drops, recv) < 0) {
    return semarrayreport.storage_receiver_still_live();
  }
  if (supplied(step, recv)) {
    return semarrayreport.storage_receiver_supplied();
  }
  return map_element_reason(f, ins.args[1], pure);
}

function map_element_reason(f: ssasem.Func, value: i32, pure: util.NameIndex): i32 {
  let fn: ssa.SInst = definition(f, value);
  if (fn.result != value || fn.kind_tag != ssasem.closure_new()) {
    return semarrayreport.storage_element_fn_unresolved();
  }
  if (fn.args.len() != 0) {
    return semarrayreport.storage_element_fn_captures();
  }
  if (!pure.has(fn.str)) {
    return semarrayreport.storage_element_fn_effectful();
  }
  return semarrayreport.storage_guarded_reuse();
}

// Called only for the final selected ownership plans. It shares the exact
// static decision used above; it does not guess whether the runtime donor
// will be unique. Both branches of the guard are stated in the report.
pub function map_report(f: ssasem.Func, modes: i32[], p: ssaunits.Plan, pure: util.NameIndex): semarrayreport.Site[] {
  let out: semarrayreport.Site[] = [];
  let idx: i32[][] = ssaunits.step_index(p);
  let links: i32[] = links_of(f, p, idx);
  let disabled: boolean = irtables.reuse_layer_disabled();
  for b in f.graph.blocks {
    let pos: i32 = 0;
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call() && util.str_has_prefix(ins.str, "__arrm_map__")) {
        let why: i32 = map_reason(f, modes, at(p, idx, b.id, pos, 0 - 1), links, pure, ins);
        if (disabled && why == semarrayreport.storage_guarded_reuse()) {
          why = semarrayreport.storage_reuse_disabled();
        }
        let storage: string = "combinator-buffer";
        if (why == semarrayreport.storage_guarded_reuse()) {
          storage = "unique-reuse/shared-copy";
        }
        out = out.append(semarrayreport.Site { owner: f.graph.name, stage: ins.str + "@v" + util.i32_to_string(ins.result), plan: "map; ownership lowering", reason: why, storage: storage });
      }
      pos = pos + 1;
    }
  }
  return out;
}

pub function scale_report(f: ssasem.Func, p: ssaunits.Plan): semarrayreport.Site[] {
  let out: semarrayreport.Site[] = [];
  let idx: i32[][] = ssaunits.step_index(p);
  let links: i32[] = links_of(f, p, idx);
  let disabled: boolean = irtables.reuse_layer_disabled();
  for b in f.graph.blocks {
    let pos: i32 = 0;
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call() && ins.str == "__scale_f64") {
        let why: i32 = scale_reason(f, p, at(p, idx, b.id, pos, 0 - 1), links, ins);
        if (disabled && why == semarrayreport.scale_storage_guarded_reuse()) {
          why = semarrayreport.scale_storage_reuse_disabled();
        }
        let storage: string = "fresh-kernel-buffer";
        if (why == semarrayreport.scale_storage_guarded_reuse()) {
          storage = "unique-reuse/shared-copy";
        } else if (why == semarrayreport.scale_storage_builtin_shadowed()) {
          storage = "user-call";
        }
        out = out.append(semarrayreport.Site { owner: f.graph.name, stage: ins.str + "@v" + util.i32_to_string(ins.result), plan: "scale; ownership lowering", reason: why, storage: storage });
      }
      pos = pos + 1;
    }
  }
  return out;
}

function same_wide_array(a: typeinfo.Type, b: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(arr) = a {
    return !arr.view && ssasem.is_wide(arr.elem) && semtypes.equal(a, b);
  }
  return false;
}

function consumed_param(f: ssasem.Func, modes: i32[], v: i32): boolean {
  let d: ssa.SInst = definition(f, v);
  return d.result == v && d.kind_tag == 6 && d.imm >= 0 && d.imm < modes.len() && modes[d.imm] == ssaunits.counted_mode();
}

function supplied(step: ssaunits.Step, v: i32): boolean {
  for s in step.supplies {
    if (s.value == v) {
      return true;
    }
  }
  return false;
}

function without(xs: i32[], v: i32): i32[] {
  let out: i32[] = [];
  for x in xs {
    if (x != v) {
      out = out.append(x);
    }
  }
  return out;
}

// The loop R7 lowers a marked map to: `buf[i] = f(buf[i])` over the buffer
// the receiver's unit becomes, which is the result. The receiver's drop is
// the result's unit, so the caller takes it out of the step's drops.
//
// The element read and the call stay on the operand stack beneath the store's
// box and index: the frame's scratch slots are typed once per function, and a
// 64-bit element in one would collide with a narrow use of the same slot.
function map_in_place(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  if (ins.str == "__scale_f64") {
    return scale_in_place(r, f, ins);
  }
  let elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
  let fn: i32 = ins.args[1];
  let buf: i32 = scratch_base(f);
  let index: i32 = buf + 1;
  r = reserve(r, index + 1);
  r = sole_owned_base(r, f, ins.args[0], buf);
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_store_local(index));
  r = emit(r, ir.op_block(0));
  r = emit(r, ir.op_loop(0));
  r = emit(r, ir.op_load_local(index));
  r = emit(r, ir.op_load_local(buf));
  r = emit(r, ir.op_arr_len());
  r = emit(r, ir.op_bin("ge_s", 0, false));
  r = emit(r, ir.op_brif(1));
  r = emit(r, ir.op_load_local(buf));
  r = emit(r, ir.op_load_local(index));
  r = emit(r, ir.op_load_local(fn));
  r = emit(r, ir.op_load_local(buf));
  r = emit(r, ir.op_load_local(index));
  r = emit(r, arr_get_op(elem, true));
  r = emit(r, ir.op_load_local(fn));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_arr_get(32));
  r = emit(r, ir.op_call_indirect_sig(2, signature_tag(f.values[fn])));
  r = emit(r, arr_set_op(elem));
  r = emit(r, ir.op_load_local(index));
  r = emit(r, ir.op_const_i32(1));
  r = emit(r, ir.op_bin("add", 0, false));
  r = emit(r, ir.op_store_local(index));
  r = emit(r, ir.op_br(0));
  r = emit(r, ir.op_end());
  r = emit(r, ir.op_end());
  r = emit(r, ir.op_load_local(buf));
  return emit(r, ir.op_store_local(ins.result));
}

// Each branch completes allocation before its vector loop. Unlike a general
// map, scale has a fresh-buffer kernel: the shared arm writes the transformed
// result directly, avoiding a full memcpy followed by a second pass.
function scale_in_place(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let base: i32 = ins.args[0];
  r = emit(r, ir.op_load_local(base));
  r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(base));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.op_scale_f64_in_place());
  r = emit(r, ir.op_store_local(ins.result));
  r = emit(r, ir.op_else());
  r = emit(r, ir.op_load_local(base));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.op_scale_f64());
  r = emit(r, ir.op_store_local(ins.result));
  r = release(r, base, f.values[base], f);
  return emit(r, ir.op_end());
}

// A cell is a one-element array box shared by every holder, built over the
// one element it takes.
function cell_site(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  if (ins.kind_tag == ssasem.cell_get()) {
    return cell_read(r, f, ins);
  }
  if (ins.kind_tag == ssasem.cell_set()) {
    return cell_write(r, f, ins);
  }
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, arr_make_op(semtypes.cell_elem(f.values[ins.result]), 1));
  return emit(r, ir.op_store_local(ins.result));
}

// A node's address is the box's own word. A fill writes the node at the hole
// over its zero placeholder, so nothing is released, and answers the chain;
// the first fill has no node to write and answers the value itself.
function hole_site(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  if (ins.kind_tag == ssasem.hole_at()) {
    r = emit(r, ir.op_load_local(ins.args[0]));
    return emit(r, ir.op_store_local(ins.result));
  }
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_bin("eq", ir.width_ptr(), true));
  r = emit(r, ir.op_if(0));
  r = emit(r, ir.op_load_local(ins.args[2]));
  r = emit(r, ir.op_store_local(ins.result));
  r = emit(r, ir.op_else());
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, ir.op_load_local(ins.args[2]));
  r = emit(r, ir.op_struct_set(ins.imm, 0));
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_store_local(ins.result));
  return emit(r, ir.op_end());
}

// A read hands out a unit of the element: the slot is loaded and, for a
// reference, retained, since a later write may release what the slot held
// while the value read is still in hand.
function cell_read(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let elem: typeinfo.Type = f.values[ins.result];
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, arr_get_op(elem, true));
  r = emit(r, ir.op_store_local(ins.result));
  if (ssasem.reference(elem)) {
    r = helper(r, ins.result, "__fern_rc_inc");
  }
  return r;
}

// A write releases what the slot held, stores the unit it was supplied and
// leaves the dummy a statement op leaves for the store of its void result.
function cell_write(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  let elem: typeinfo.Type = f.values[ins.args[1]];
  if (ssasem.reference(elem)) {
    let old: i32 = scratch_base(f);
    r = reserve(r, old + 1);
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, arr_get_op(elem, true));
    r = emit(r, ir.op_store_local(old));
    r = drop_value(r, old, elem, old + 1, f);
  }
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_load_local(ins.args[1]));
  r = emit(r, arr_set_op(elem));
  r = emit(r, ir.op_const_i32(0));
  return emit(r, ir.op_store_local(ins.result));
}

// A closure value and the call through one. The value is the env box the
// lambda lift builds: the body's address in slot 0, then the captures, which
// is the layout the `__mkclo$` marker names.
// The call is environment-first — the box, the written arguments, then the
// address out of slot 0, which is the order call_indirect pops them in — so a
// body reaches its captures through the parameter it was hoisted with. The
// call carries the signature tag the value's type spells, so wasm dispatches
// a wide or float slot through the funcref type the body was declared with.
function function_site(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  if (ins.kind_tag == ssasem.closure_new()) {
    // Capturing nothing, every word of the box is known at compile time, so
    // it is one static block rather than a fresh box per evaluation (#9839).
    if (ins.args.len() == 0) {
      return emit(r, ir.op_const_closure(ins.str));
    }
    r = emit(r, ir.op_const_func(0, ins.str));
    for capture in ins.args {
      r = emit(r, ir.op_load_local(capture));
    }
    return emit(r, ir.op_arr_make(ins.args.len() + 1, 32));
  }
  for operand in ins.args {
    r = emit(r, ir.op_load_local(operand));
  }
  // A locally constructed closure already names its exact body. Keep the
  // same borrowed environment and arguments, but omit the slot lookup and
  // indirect dispatch. In particular, fused array callbacks retain this
  // identity after their source combinator calls have been removed.
  let callee: ssa.SInst = definition(f, ins.args[0]);
  if (callee.result == ins.args[0] && callee.kind_tag == ssasem.closure_new()) {
    return emit(r, ir.op_call_direct(callee.str, ins.args.len()));
  }
  r = emit(r, ir.op_load_local(ins.args[0]));
  r = emit(r, ir.op_const_i32(0));
  r = emit(r, ir.op_arr_get(32));
  return emit(r, ir.op_call_indirect_sig(ins.args.len(), signature_tag(f.values[ins.args[0]])));
}

// The funcref signature tag a call through a value dispatches by: one width
// char per slot, the environment word first, then `_` and the result — the
// spelling wasm_ir.fn_type_name turns into `$fn<tag>`.
// An all-narrow signature carries no tag.
function signature_tag(sig: typeinfo.Type): string {
  let tag: string = "w";
  for p in ssasem.func_params(sig) {
    tag = tag + width_char(p);
  }
  tag = tag + "_" + width_char(ssasem.func_result(sig));
  let i: i32 = 0;
  while (i < tag.len()) {
    if (tag[i] != b'w' && tag[i] != b'_') {
      return tag;
    }
    i = i + 1;
  }
  return "";
}

function width_char(t: typeinfo.Type): string {
  if (ssasem.is_wide(t)) {
    return "l";
  }
  if (ssasem.is_float(t)) {
    return "d";
  }
  return "w";
}

// A dyn method call dispatches on the receiver's shape, and every arm reloads
// the operands, so the dispatch reads them from a run of consecutive slots
// rather than the stack. semsource defines the operands as a run of copies,
// which makes their value ids, and so their slots, that run. Every operand is
// lent, so there is nothing to supply and nothing taken.
function dyn_call(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssasem.call() && ssasem.is_dyn_call(ins.str);
}

function consecutive(args: i32[]): boolean {
  let i: i32 = 1;
  while (i < args.len()) {
    if (args[i] != args[0] + i) {
      return false;
    }
    i = i + 1;
  }
  return args.len() > 0;
}

function dyn_site(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  return emit(r, ir.op_dyn_dispatch(ssasem.dyn_call_arms(ins.str), ins.args[0], ins.args.len()));
}

function call_site(own r: irtables.LowerResult, f: ssasem.Func, ins: ssa.SInst): irtables.LowerResult {
  if (paired_op(ins.str)) {
    return pair_site(r, ins);
  }
  if (util.index_of_str(f.shadows, ins.str) >= 0) {
    return emit(r, ir.op_call_direct(ins.str, ins.args.len()));
  }
  if (ins.str == "print") {
    // The payload, then the newline, as the AST lowering writes it.
    r = emit(r, ir.op_print_str());
    r = emit(r, ir.op_drop());
    r = emit(r, ir.op_const_str("\n"));
    return emit(r, ir.op_print_str());
  }
  if (ins.str == "eprint") {
    return emit(r, ir.op_eprint_str());
  }
  if (ins.str == "strbuf_append") {
    return emit(r, ir.op_strbuf_append());
  }
  if (ins.str == "strbuf_reset") {
    return emit(r, ir.op_strbuf_reset());
  }
  if (ins.str == "strbuf_take") {
    return emit(r, ir.op_strbuf_take());
  }
  if (ins.str == "__memchr") {
    return emit(r, ir.op_memchr());
  }
  if (ins.str == "__count_byte_bytes") {
    return emit(r, ir.packed(ir.op_count_byte_bytes()));
  }
  if (ins.str == "__sum_bytes_array") {
    return emit(r, ir.packed(ir.op_sum_bytes_array()));
  }
  if (ins.str == "__bsd_sum_bytes") {
    return emit(r, ir.packed(ir.op_bsd_sum_bytes()));
  }
  if (ins.str == "__memchr_bytes") {
    return emit(r, ir.packed(ir.op_memchr_bytes()));
  }
  if (ins.str == "__rmemchr_bytes") {
    return emit(r, ir.packed(ir.op_rmemchr_bytes()));
  }
  if (ins.str == "write") {
    return emit(r, ir.op_print_str());
  }
  if (ins.str == "exit") {
    return emit(r, ir.op_exit());
  }
  if (ins.str == "string_from_bytes_unchecked") {
    return emit(r, ir.packed(ir.op_str_from_bytes()));
  }
  if (ins.str == "string_from_bytes_range_unchecked") {
    return emit(r, ir.packed(ir.op_str_from_bytes_range()));
  }
  if (ins.str == "f64_bits") {
    return emit(r, ir.op_f64_bits());
  }
  if (ins.str == "f64_from_bits") {
    return emit(r, ir.op_f64_from_bits());
  }
  return builtin_site(r, ins);
}

// The calls sempair writes around a paired return. The word a paired call
// returned was stored as the call returned, so `__pair_word` reloads it; a
// payload read off the word is the word; and a payload handed to
// `__pair_set` waits in its own slot until the return sets it (terminator).
function paired_op(name: string): boolean {
  return name == sempair.pair_word_name() || util.str_has_prefix(name, sempair.word_as_prefix()) || util.str_has_prefix(name, sempair.pair_set_prefix());
}

function pair_site(own r: irtables.LowerResult, ins: ssa.SInst): irtables.LowerResult {
  if (ins.str == sempair.pair_word_name()) {
    r = emit(r, ir.op_drop());
    return emit(r, ir.op_load_local(ins.result));
  }
  if (util.str_has_prefix(ins.str, sempair.word_as_prefix())) {
    return r;
  }
  r = emit(r, ir.op_drop());
  return emit(r, ir.op_const_i32(0));
}

// The payload a paired return sets beside its result: the operand of the
// block's one `__pair_set`, -1 for none, or -2 where there are several, which
// the terminator refuses rather than hand the caller either.
function pair_payload(b: ssa.SBlock): i32 {
  let found: i32 = 0 - 1;
  for ins in b.insts {
    if (ins.kind_tag == ssasem.call() && util.str_has_prefix(ins.str, sempair.pair_set_prefix())) {
      if (found >= 0) {
        return 0 - 2;
      }
      found = ins.args[0];
    }
  }
  return found;
}

// One half of the builtin dispatch below: the result with that builtin's op
// emitted, or the result untouched when the name is not one of this half's.
struct Lowered { found: boolean, r: irtables.LowerResult }

// The directory handle: a Dir is its descriptor too, so `open_dir` and every
// method is one Dir-family op with the receiver as its first operand. Close
// is close(2) on that descriptor, the op a Reader closes with.
function dir_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  let m: string = ins.str;
  if (m == "open_dir") {
    return Lowered { found: true, r: emit(r, ir.op_open_dir()) };
  }
  if (m == "Dir.open_dir") {
    return Lowered { found: true, r: emit(r, ir.op_dir_open()) };
  }
  if (m == "Dir.entries") {
    return Lowered { found: true, r: emit(r, ir.op_dir_entries()) };
  }
  if (m == "Dir.stat" || m == "Dir.lstat") {
    let follow: i32 = 0;
    if (m == "Dir.stat") {
      follow = 1;
    }
    return Lowered { found: true, r: emit(r, ir.op_dir_stat(follow)) };
  }
  if (m == "Dir.access") {
    return Lowered { found: true, r: emit(r, ir.op_dir_access()) };
  }
  if (m == "Dir.remove_file" || m == "Dir.remove_dir") {
    let dir: i32 = 0;
    if (m == "Dir.remove_dir") {
      dir = 1;
    }
    return Lowered { found: true, r: emit(r, ir.op_dir_unlink(dir)) };
  }
  if (m == "Dir.chmod") {
    return Lowered { found: true, r: emit(r, ir.op_dir_chmod()) };
  }
  if (m == "Dir.chown") {
    return Lowered { found: true, r: emit(r, ir.op_dir_chown()) };
  }
  if (m == "Dir.close") {
    return Lowered { found: true, r: emit(r, ir.op_reader_close()) };
  }
  return Lowered { found: false, r: r };
}

// The builtins whose result is an instantiated builtin union: each is the
// stack IR op the AST lowering emits for the same call. `read_line` reads a FD
// operand and the bare builtin names none, so its lowering pushes the zero the
// AST path pushes.
// The stream handles: a handle IS its descriptor, so the three standard ones
// are constants and every method is the free op with the receiver as its
// first operand. Writer.close shares Reader.close's op.
function handle_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == "open_dir" || util.str_has_prefix(ins.str, "Dir.")) {
    return dir_site(r, ins);
  }
  if (ins.str == "stdin") {
    return Lowered { found: true, r: emit(r, ir.op_const_i32(0)) };
  }
  if (ins.str == "stdout") {
    return Lowered { found: true, r: emit(r, ir.op_const_i32(1)) };
  }
  if (ins.str == "stderr") {
    return Lowered { found: true, r: emit(r, ir.op_const_i32(2)) };
  }
  if (ins.str == "open_reader") {
    return Lowered { found: true, r: emit(r, ir.op_open_file(0)) };
  }
  if (ins.str == "open_writer") {
    return Lowered { found: true, r: emit(r, ir.op_open_file(577)) };
  }
  if (ins.str == "open_appender") {
    return Lowered { found: true, r: emit(r, ir.op_open_file(1089)) };
  }
  if (ins.str == "open_exclusive") {
    return Lowered { found: true, r: emit(r, ir.op_open_file(193)) };
  }
  if (ins.str == "open_reader_with") {
    return Lowered { found: true, r: emit(r, ir.op_open_reader_with()) };
  }
  if (ins.str == "open_writer_with") {
    return Lowered { found: true, r: emit(r, ir.op_open_writer_with()) };
  }
  if (ins.str == "Reader.read_line") {
    return Lowered { found: true, r: emit(r, ir.op_read_line()) };
  }
  if (ins.str == "Reader.read_chunk") {
    return Lowered { found: true, r: emit(r, ir.op_read_chunk()) };
  }
  if (ins.str == "Reader.read_chunk_bytes") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_read_chunk_bytes())) };
  }
  if (ins.str == "Reader.close" || ins.str == "Writer.close") {
    return Lowered { found: true, r: emit(r, ir.op_reader_close()) };
  }
  if (ins.str == "Writer.write_bytes") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_write_bytes())) };
  }
  if (ins.str == "Writer.write_some_bytes") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_write_some_bytes())) };
  }
  if (ins.str == "Writer.write") {
    return Lowered { found: true, r: emit(r, ir.op_writer_write()) };
  }
  if (ins.str == "Writer.write_some") {
    return Lowered { found: true, r: emit(r, ir.op_write_some()) };
  }
  if (ins.str == "Reader.splice_to") {
    return Lowered { found: true, r: emit(r, ir.op_reader_splice()) };
  }
  if (ins.str == "Reader.copy_range_to") {
    return Lowered { found: true, r: emit(r, ir.op_reader_copy_range()) };
  }
  if (ins.str == "Writer.truncate") {
    return Lowered { found: true, r: emit(r, ir.op_writer_truncate()) };
  }
  return handle_metadata_site(r, ins);
}

// The handle metadata ops, each asked of the bare descriptor like close and
// shared by the two handle types.
function handle_metadata_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  let op: string = handle_method(ins.str);
  if (op == "stat") {
    return Lowered { found: true, r: emit(r, ir.op_fd_stat()) };
  }
  if (op == "flags") {
    return Lowered { found: true, r: emit(r, ir.op_fd_flags()) };
  }
  if (op == "seek") {
    return Lowered { found: true, r: emit(r, ir.op_reader_seek()) };
  }
  if (op == "fsync") {
    return Lowered { found: true, r: emit(r, ir.op_fd_fsync()) };
  }
  if (op == "fdatasync") {
    return Lowered { found: true, r: emit(r, ir.op_fd_fdatasync()) };
  }
  if (op == "syncfs") {
    return Lowered { found: true, r: emit(r, ir.op_fd_syncfs()) };
  }
  if (op == "drop_cache") {
    return Lowered { found: true, r: emit(r, ir.op_fd_drop_cache()) };
  }
  // A handle is its descriptor, so these are the free ops with the receiver
  // as the first operand, as the AST lowering emits them.
  if (op == "isatty") {
    return Lowered { found: true, r: emit(r, ir.op_isatty()) };
  }
  if (op == "dup_onto") {
    return Lowered { found: true, r: emit(r, ir.op_fd_dup_onto()) };
  }
  if (op == "window_size") {
    return Lowered { found: true, r: emit(r, ir.op_window_size()) };
  }
  if (op == "set_window_size") {
    return Lowered { found: true, r: emit(r, ir.op_set_window_size()) };
  }
  if (op == "termios_get") {
    return Lowered { found: true, r: emit(r, ir.op_termios_get()) };
  }
  if (op == "termios_set") {
    return Lowered { found: true, r: emit(r, ir.op_termios_set()) };
  }
  if (op == "set_extproc") {
    return Lowered { found: true, r: emit(r, ir.op_set_extproc()) };
  }
  return Lowered { found: false, r: r };
}

// handle_method is the method half of a `Reader.` or `Writer.` metadata
// contract name, "" for any other name.
function handle_method(name: string): string {
  if (!util.str_has_prefix(name, "Reader.") && !util.str_has_prefix(name, "Writer.")) {
    return "";
  }
  let method: str = slice_unchecked(name, 7, name.len());
  let methods: string[] = [
    "stat", "flags", "seek", "fsync", "fdatasync", "syncfs", "drop_cache", "isatty", "dup_onto", "window_size",
    "set_window_size", "termios_get", "termios_set", "set_extproc",
  ];
  for m in methods {
    if (method == m) {
      return m;
    }
  }
  return "";
}

function union_builtin_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == "env" || ins.str == "config_get") {
    return Lowered { found: true, r: emit(r, ir.op_env()) };
  }
  if (ins.str == "read_file") {
    return Lowered { found: true, r: emit(r, ir.op_read_file()) };
  }
  if (ins.str == "read_file_bytes") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_read_file_bytes())) };
  }
  if (ins.str == "read_dir") {
    return Lowered { found: true, r: emit(r, ir.op_read_dir()) };
  }
  if (ins.str == "read_dir_all") {
    return Lowered { found: true, r: emit(r, ir.op_read_dir_all()) };
  }
  if (ins.str == "read_dir_ino") {
    return Lowered { found: true, r: emit(r, ir.op_read_dir_ino()) };
  }
  if (ins.str == "stat") {
    return Lowered { found: true, r: emit(r, ir.op_stat()) };
  }
  if (ins.str == "lstat") {
    return Lowered { found: true, r: emit(r, ir.op_lstat()) };
  }
  if (ins.str == "read_line") {
    r = emit(r, ir.op_const_i32(0));
    return Lowered { found: true, r: emit(r, ir.op_read_line()) };
  }
  return outcome_builtin_site(r, ins);
}

// The builtins whose result is the outcome of a write: `Result[void, IoError]`.
function outcome_builtin_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == "write_file") {
    return Lowered { found: true, r: emit(r, ir.op_write_file()) };
  }
  if (ins.str == "write_file_bytes") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_write_file_bytes())) };
  }
  if (ins.str == "write_file_exec") {
    return Lowered { found: true, r: emit(r, ir.op_write_file_exec()) };
  }
  if (ins.str == "create_dir_all") {
    return Lowered { found: true, r: emit(r, ir.op_create_dir_all()) };
  }
  if (ins.str == "remove_dir_all") {
    return Lowered { found: true, r: emit(r, ir.op_remove_dir_all()) };
  }
  if (ins.str == "remove_file") {
    return Lowered { found: true, r: emit(r, ir.op_remove_file()) };
  }
  return Lowered { found: false, r: r };
}

// The builtins whose result owns nothing. The over-release counter and the two
// shared-append totals read a runtime word; the first of them is a runtime
// call rather than an op.
function value_builtin_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == "args") {
    return Lowered { found: true, r: emit(r, ir.op_args()) };
  }
  if (ins.str == "set_args") {
    return Lowered { found: true, r: emit(r, ir.op_call_direct("__fern_set_args", 1)) };
  }
  if (ins.str == "putchar") {
    return Lowered { found: true, r: emit(r, ir.op_putchar()) };
  }
  if (ins.str == "f32_bits") {
    return Lowered { found: true, r: emit(r, ir.op_f32_bits()) };
  }
  if (ins.str == "f32_from_bits") {
    return Lowered { found: true, r: emit(r, ir.op_f32_from_bits()) };
  }
  if (ins.str == "__account_entry") {
    return Lowered { found: true, r: emit(r, ir.op_call_direct("__fern_account_entry", 2)) };
  }
  if (ins.str == "__ct_secret") {
    return Lowered { found: true, r: emit(r, ir.op_ct_mark(0)) };
  }
  if (ins.str == "__ct_public") {
    return Lowered { found: true, r: emit(r, ir.op_ct_mark(1)) };
  }
  if (ins.str == "__rc_underflow_count") {
    return Lowered { found: true, r: emit(r, ir.op_call_direct("__fern_rc_underflow_get", 0)) };
  }
  if (ins.str == "__arr_push_shared_count") {
    return Lowered { found: true, r: emit(r, ir.op_arr_push_shared_count()) };
  }
  if (ins.str == "__arr_push_shared_bytes") {
    return Lowered { found: true, r: emit(r, ir.op_arr_push_shared_bytes()) };
  }
  return host_builtin_site(r, ins);
}

// The host itself: three clocks, the kernel's randomness, and the two sleeps.
// Each is an op of its own rather than a call, the way the AST lowering emits
// it — a contract alone would reach the backends as a call to a symbol no
// runtime defines.
function host_builtin_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == "random_bytes") {
    return Lowered { found: true, r: emit(r, ir.packed(ir.op_random_bytes())) };
  }
  if (ins.str == "random_i32") {
    return Lowered { found: true, r: emit(r, ir.op_random_i32()) };
  }
  if (ins.str == "monotonic_ns") {
    return Lowered { found: true, r: emit(r, ir.op_monotonic_ns()) };
  }
  if (ins.str == "now_unix_ms") {
    return Lowered { found: true, r: emit(r, ir.op_now_unix_ms()) };
  }
  if (ins.str == "now_ns") {
    return Lowered { found: true, r: emit(r, ir.op_now_ns()) };
  }
  if (ins.str == "clock_resolution") {
    return Lowered { found: true, r: emit(r, ir.op_clock_resolution()) };
  }
  if (ins.str == "sleep_ms") {
    return Lowered { found: true, r: emit(r, ir.op_sleep_ms()) };
  }
  if (ins.str == "sleep_ns") {
    return Lowered { found: true, r: emit(r, ir.op_sleep_ns()) };
  }
  return os_query_site(r, ins);
}

// The process and host queries: each is the op the AST lowering emits, with
// no operand but the ones the call names.
function os_query_site(own r: irtables.LowerResult, ins: ssa.SInst): Lowered {
  if (ins.str == "getcwd") {
    return Lowered { found: true, r: emit(r, ir.op_getcwd()) };
  }
  if (ins.str == "hostname") {
    return Lowered { found: true, r: emit(r, ir.op_hostname()) };
  }
  if (ins.str == "cpu_count") {
    return Lowered { found: true, r: emit(r, ir.op_cpu_count()) };
  }
  if (ins.str == "geteuid") {
    return Lowered { found: true, r: emit(r, ir.op_geteuid()) };
  }
  if (ins.str == "getegid") {
    return Lowered { found: true, r: emit(r, ir.op_getegid()) };
  }
  if (ins.str == "getuid") {
    return Lowered { found: true, r: emit(r, ir.op_getuid()) };
  }
  if (ins.str == "getgid") {
    return Lowered { found: true, r: emit(r, ir.op_getgid()) };
  }
  if (ins.str == "environ") {
    return Lowered { found: true, r: emit(r, ir.op_environ()) };
  }
  if (ins.str == "proc_fork") {
    return Lowered { found: true, r: emit(r, ir.op_proc_fork()) };
  }
  if (ins.str == "isatty") {
    return Lowered { found: true, r: emit(r, ir.op_isatty()) };
  }
  if (ins.str == "process_alive") {
    return Lowered { found: true, r: emit(r, ir.op_process_alive()) };
  }
  if (ins.str == "rlimit_nofile") {
    return Lowered { found: true, r: emit(r, ir.op_rlimit_nofile()) };
  }
  if (ins.str == "disable_core_dumps") {
    return Lowered { found: true, r: emit(r, ir.op_disable_core_dumps()) };
  }
  if (ins.str == "uname_field") {
    return Lowered { found: true, r: emit(r, ir.op_uname_field()) };
  }
  if (ins.str == "umask") {
    return Lowered { found: true, r: emit(r, ir.op_umask()) };
