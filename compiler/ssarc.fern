  }
  if (ins.str == "chroot") {
    return Lowered { found: true, r: emit(r, ir.op_chroot()) };
  }
  if (ins.str == "set_process_group") {
    return Lowered { found: true, r: emit(r, ir.op_set_process_group()) };
  }
  if (ins.str == "setgroups") {
    return Lowered { found: true, r: emit(r, ir.op_setgroups()) };
  }
  if (ins.str == "getgroups") {
    return Lowered { found: true, r: emit(r, ir.op_getgroups()) };
  }
  if (ins.str == "priority") {
    return Lowered { found: true, r: emit(r, ir.op_priority()) };
