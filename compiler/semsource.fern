    ssasem.Contract { name: "__task_new", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__task_free", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_void() },
    ssasem.Contract { name: "__task_cur", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__task_enter", params: [typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v], result: typeinfo.t_void() },
    ssasem.Contract { name: "__task_leave", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__task_park", params: [fds, typeinfo.t_i32()], modes: [b, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__task_park_until", params: [fds, typeinfo.t_i64()], modes: [b, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__task_wait", params: [typeinfo.t_i32()], modes: [v], result: fds },
    ssasem.Contract { name: "__task_timeout", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__task_until", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i64() },
    ssasem.Contract { name: "__task_set_ready", params: [typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v], result: typeinfo.t_void() },
    ssasem.Contract { name: "__task_set_cancelled", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_void() },
