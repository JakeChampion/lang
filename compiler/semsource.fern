pub struct Produced { ok: boolean, why: string, func: ssasem.Func, modes: i32[], template: boolean, key: string, requests: Request[], bodyless: boolean, analysis: Option[ssasem.Analysis], view_escape: i32, dropped: boolean }

pub struct Request { key: string, name: string, binding: ssasem.Binding }

// `laid` holds the records whose fields of scalar records and Options are laid
// out as their parts, as `records` now has them.
pub struct Built { decls: Produced[], instances: Produced[], contracts: ssasem.Contracts, names: string[], dyn_arms: string[], records: semrecords.Records, enums: semrecords.Enum[], finalizers: ssasem.Finalizer[], laid: semrecords.Record[] }

struct Exit { block: i32, env: i32[] }

// `next` is the block a `continue` enters: the header of a `while`, the step of a counted loop.
struct Loop { label: string, header: i32, next: i32, exit: i32, entry_count: i32, breaks: Exit[], continues: Exit[] }

struct State {
  ok: boolean,
  why: string,
  blocks: ssa.SBlock[],
  cur: ssa.SBlock,
  live: boolean,
  next_block: i32,
  values: typeinfo.Type[],
  names: string[],
  vals: i32[],
  scope: checker.Scope,
  result: typeinfo.Type,
  loops: Loop[],
  contracts: ssasem.Contracts,
  calls: ssasem.Contract[],
  template: boolean,
  binding: ssasem.Binding,
  requests: Request[],
  foreign: i32[],
  handers: Handers,
  shadows: string[],
  views: string[],
  name: string,
  modes: i32[],
  funcs: parser.FuncDecl[],
  impls: parser.ImplInfo[],
  try_cleanup: ast.Stmt[],
  replaying: boolean,
  armed: i32,
  escaping: string[],
  learned: string[],
  learned_types: typeinfo.Type[],
  debug_lines: boolean,
  narrowings: Narrowing[],
  dbg_vals: i32[],
  dbg_names: string[],
}

struct Value { s: State, id: i32 }

struct Narrowing { id: i32, scrut: i32, member: string }

function is_i32(t: typeinfo.Type): boolean {
  return semtypes.equal(t, typeinfo.t_i32());
}

function is_bool(t: typeinfo.Type): boolean {
  return semtypes.equal(t, typeinfo.t_bool());
}

function fail(s: State, why: string): State {
  if (!s.ok) {
    return s;
  }
  return State { ...s, ok: false, why: why };
}

function retried(s: State): State {
  return State { ...s, ok: true, why: "" };
}

function refused(s: State, why: string): Value {
  return Value { s: fail(s, why), id: -1 };
}

function prefix(xs: i32[], n: i32): i32[] {
  let out: i32[] = [];
  for i in 0..n {
    out = out.append(xs[i]);
  }
  return out;
}

function prefix_names(xs: string[], n: i32): string[] {
  let out: string[] = [];
  for i in 0..n {
    out = out.append(xs[i]);
  }
  return out;
}

function inst(kind: i32, result: i32, args: i32[], imm: i32, str: string): ssa.SInst {
  return ssa.SInst { kind_tag: kind, result: result, args: args, imm: imm, str: str };
}

function t_none(): ssa.STerm {
  return ssa.STerm { kind_tag: ssa.TERM_NONE, cond: 0, target: 0, t: 0, f: 0, value: 0 };
}

function emit(s: State, ins: ssa.SInst): State {
  return State { ...s, cur: ssa.SBlock { ...s.cur, insts: s.cur.insts.append(ins) } };
}

function define(s: State, kind: i32, args: i32[], imm: i32, str: string, ty: typeinfo.Type): Value {
  let id = s.values.len();
  let next = State { ...s, values: s.values.append(ty) };
  return Value { s: emit(next, inst(kind, id, args, imm, str)), id: id };
}

function open(s: State, id: i32, preds: i32[]): State {
  return State { ...s, cur: ssa.SBlock { id: id, insts: [], term: t_none(), preds: preds }, live: true };
}

function terminate(s: State, term: ssa.STerm): State {
  if (!s.live) {
    return s;
  }
  let closed = ssa.SBlock { ...s.cur, term: term };
  return State { ...s, blocks: s.blocks.append(closed), live: false };
}

function lookup(s: State, name: string): i32 {
  let i = s.names.len() - 1;
  while (i >= 0) {
    if (s.names[i] == name) {
      return s.vals[i];
    }
    i -= 1;
  }
  return -1;
}

function bind(s: State, name: string, value: i32): State {
  return note_binding(State { ...s, names: s.names.append(name), vals: s.vals.append(value) }, name, value);
}

function replace(s: State, name: string, value: i32): State {
  let i = s.names.len() - 1;
  while (i >= 0) {
    if (s.names[i] == name) {
      return note_binding(State { ...s, vals: s.vals.with(i, value) }, name, value);
    }
    i -= 1;
  }
  return fail(s, "replacement of an unbound name");
}

function note_binding(s: State, name: string, value: i32): State {
  if (!s.debug_lines) {
    return s;
  }
  let src = lexical.source_name(name);
  if (!util.is_ident(src)) {
    return s;
  }
  return State { ...s, dbg_vals: s.dbg_vals.append(value), dbg_names: s.dbg_names.append(src) };
}

function leave(s: State, count: i32, scope: checker.Scope): State {
  return State { ...s, names: prefix_names(s.names, count), vals: prefix(s.vals, count), scope: scope };
}

function merge_binding(s: State, envs: i32[][], at: i32): Value {
  let first = envs[0][at];
  let same = true;
  let args: i32[] = [];
  for env in envs {
    if (env[at] != first) {
      same = false;
    }
    args = args.append(env[at]);
  }
  if (same) {
    return Value { s: s, id: first };
  }
  return define(s, ssa.PHI, args, 0, "", s.values[first]);
}

function merge_env(s: State, envs: i32[][], count: i32): State {
  let vals: i32[] = [];
  for at in 0..count {
    let merged = merge_binding(s, envs, at);
    s = merged.s;
    if (merged.id != envs[0][at]) {
      s = note_binding(s, s.names[at], merged.id);
    }
    vals = vals.append(merged.id);
  }
  return State { ...s, vals: vals };
}

function generic_decl(fd: parser.FuncDecl): boolean {
  if (fd.type_params.len() > 0 || fd.all_type_params.len() > 0) {
    return true;
  }
  if (spelled_typevar(fd.ret_type) || spelled_typevar(fd.ret_fn_ret) || spelled_typevar(fd.ret_fn_param_types)) {
    return true;
  }
  for p in fd.params {
    if (spelled_typevar(p.type_name) || spelled_typevar(p.fn_ret) || spelled_typevar(p.fn_param_types)) {
      return true;
    }
  }
  return spelled_typevar(fd.receiver_type);
}

function spelled_typevar(spelling: string): boolean {
  let i = 0;
  while (i < spelling.len()) {
    let start = i;
    i = ident_end(spelling, i);
    if (i > start && util.str_range_eq(spelling, start, i, "dyn")) {
      i = dyn_set_end(spelling, i);
    } else if (i > start && parser.looks_type_var(slice_unchecked(spelling, start, i).to_owned())) {
      return true;
    }
    if (i == start) {
      i += 1;
    }
  }
  return false;
}

function ident_end(spelling: string, i: i32): i32 {
  return __scan_set(spelling, i, lexer.NOT_IDENT);
}

function dyn_set_end(spelling: string, i: i32): i32 {
  while (true) {
    while (i < spelling.len() && spelling[i] == b' ') {
      i += 1;
    }
    i = ident_end(spelling, i);
    let j = i;
    while (j < spelling.len() && spelling[j] == b' ') {
      j += 1;
    }
    if (j >= spelling.len() || spelling[j] != b'+') {
      return i;
    }
    i = j + 1;
  }
}

function resolved(t: typeinfo.Type, template: boolean, b: ssasem.Binding, scope: checker.Scope): typeinfo.Type {
  return argued(resolved_checked(t, template, b, scope), scope);
}

function resolved_checked(t: typeinfo.Type, template: boolean, b: ssasem.Binding, scope: checker.Scope): typeinfo.Type {
  if (!template) {
    return runtime_callable_type(t);
  }
  if let typeinfo.TypeUnknown(u) = t {
    let name = checker.typevar_reason_name(u.reason);
    if (parser.looks_type_var(name)) {
      return ssasem.substitute(typeinfo.TypeErased { name: name }, b);
    }
    return t;
  }
  if let typeinfo.TypeErased(_) = t {
    return ssasem.substitute(t, b);
  }
  return resolved_within(t, b, scope);
}

function runtime_callable_type(t: typeinfo.Type): typeinfo.Type {
  if (!runtime_callable_changes(t)) {
    return t;
  }
  if let typeinfo.TypeFunc(f) = t {
    let params = runtime_callable_types(f.param_types);
    return typeinfo.TypeFunc { ...f, param_types: params, param_own: typeinfo.own_flags(f.param_own, params), ret_own: false, ret_type: runtime_callable_type(f.ret_type) };
  }
  if let typeinfo.TypeArray(a) = t {
    return typeinfo.TypeArray { ...a, elem: runtime_callable_type(a.elem) };
  }
  if let typeinfo.TypeTuple(a) = t {
    return typeinfo.TypeTuple { ...a, elements: runtime_callable_types(a.elements) };
  }
  if let typeinfo.TypeStruct(a) = t {
    return typeinfo.TypeStruct { ...a, args: runtime_callable_types(a.args) };
  }
  if let typeinfo.TypeUnion(a) = t {
    return typeinfo.TypeUnion { ...a, args: runtime_callable_types(a.args) };
  }
  if let typeinfo.TypeMap(a) = t {
    return typeinfo.TypeMap { ...a, key: runtime_callable_type(a.key), value: runtime_callable_type(a.value) };
  }
  return t;
}

function runtime_callable_changes(t: typeinfo.Type): boolean {
  match (t) {
    typeinfo.TypeFunc(f) => {
      return f.ret_own || runtime_callable_flags_change(f) || runtime_callable_list_changes(f.param_types) || runtime_callable_changes(f.ret_type);
    },
    typeinfo.TypeArray(a) => {
      return runtime_callable_changes(a.elem);
    },
    typeinfo.TypeTuple(a) => {
      return runtime_callable_list_changes(a.elements);
    },
    typeinfo.TypeStruct(a) => {
      return runtime_callable_list_changes(a.args);
    },
    typeinfo.TypeUnion(a) => {
      return runtime_callable_list_changes(a.args);
    },
    typeinfo.TypeMap(a) => {
      return runtime_callable_changes(a.key) || runtime_callable_changes(a.value);
    },
    _ => {
      return false;
    }
  }
}

function runtime_callable_flags_change(f: typeinfo.TypeFunc): boolean {
  for i in 0..f.param_types.len() {
    if (typeinfo.fn_own_at(f, i) && !typeinfo.ownable(f.param_types[i])) {
      return true;
    }
  }
  return false;
}

function runtime_callable_list_changes(ts: typeinfo.Type[]): boolean {
  for t in ts {
    if (runtime_callable_changes(t)) {
      return true;
    }
  }
  return false;
}

function runtime_callable_types(ts: typeinfo.Type[]): typeinfo.Type[] {
  if (!runtime_callable_list_changes(ts)) {
    return ts;
  }
  let out: typeinfo.Type[] = [];
  for t in ts {
    out = out.append(runtime_callable_type(t));
  }
  return out;
}

function resolved_within(t: typeinfo.Type, b: ssasem.Binding, scope: checker.Scope): typeinfo.Type {
  if let typeinfo.TypeArray(a) = t {
    return typeinfo.TypeArray { elem: resolved_checked(a.elem, true, b, scope), view: a.view };
  }
  if let typeinfo.TypeTuple(tup) = t {
    return typeinfo.TypeTuple { elements: resolved_list(tup.elements, b, scope) };
  }
  if let typeinfo.TypeFunc(fn) = t {
    let params = resolved_list(fn.param_types, b, scope);
    return typeinfo.TypeFunc { ...fn, param_types: params, param_own: typeinfo.own_flags(fn.param_own, params), ret_own: false, ret_type: resolved_checked(fn.ret_type, true, b, scope) };
  }
  if let typeinfo.TypeMap(m) = t {
    return typeinfo.TypeMap { key: resolved_checked(m.key, true, b, scope), value: resolved_checked(m.value, true, b, scope) };
  }
  if let typeinfo.TypeStruct(r) = t {
    if (r.args.len() == 0) {
      let args: typeinfo.Type[] = [];
      for v in record_variables(r.name, scope, []) {
        args = args.append(ssasem.substitute(typeinfo.TypeErased { name: v }, b));
      }
      return typeinfo.TypeStruct { ...r, args: args };
    }
    return typeinfo.TypeStruct { ...r, args: resolved_list(r.args, b, scope) };
  }
  if let typeinfo.TypeUnion(u) = t {
    return typeinfo.TypeUnion { ...u, args: resolved_list(u.args, b, scope) };
  }
  return t;
}

function resolved_list(ts: typeinfo.Type[], b: ssasem.Binding, scope: checker.Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for t in ts {
    out = out.append(resolved_checked(t, true, b, scope));
  }
  return out;
}

function resolved_types(ts: typeinfo.Type[], scope: checker.Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for t in ts {
    out = out.append(resolved(t, false, ssasem.unbound(), scope));
  }
  return out;
}

function argued(t: typeinfo.Type, scope: checker.Scope): typeinfo.Type {
  if (!names_argless_enum(t, scope)) {
    return t;
  }
  match (t) {
    typeinfo.TypeUnion(u) => {
      return typeinfo.TypeUnion { ...u, args: union_arguments(u, scope) };
    },
    typeinfo.TypeArray(a) => {
      return typeinfo.TypeArray { ...a, elem: argued(a.elem, scope) };
    },
    typeinfo.TypeTuple(tup) => {
      return typeinfo.TypeTuple { elements: argued_list(tup.elements, scope) };
    },
    typeinfo.TypeMap(m) => {
      return typeinfo.TypeMap { key: argued(m.key, scope), value: argued(m.value, scope) };
    },
    typeinfo.TypeStruct(r) => {
      return typeinfo.TypeStruct { ...r, args: argued_list(r.args, scope) };
    },
    typeinfo.TypeFunc(f) => {
      return typeinfo.TypeFunc { ...f, param_types: argued_list(f.param_types, scope), ret_type: argued(f.ret_type, scope) };
    },
    _ => {
      return t;
    }
  }
}

function union_arguments(u: typeinfo.TypeUnion, scope: checker.Scope): typeinfo.Type[] {
  if (u.args.len() > 0) {
    return argued_list(u.args, scope);
  }
  let args: typeinfo.Type[] = [];
  for _ in checker.union_type_params(scope, u.name) {
    args = args.append(typeinfo.TypeNever { tag: 0 });
  }
  return args;
}

function argued_list(ts: typeinfo.Type[], scope: checker.Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for t in ts {
    out = out.append(argued(t, scope));
  }
  return out;
}

function names_argless_enum(t: typeinfo.Type, scope: checker.Scope): boolean {
  match (t) {
    typeinfo.TypeUnion(u) => {
      if (u.args.len() == 0) {
        return checker.union_type_params(scope, u.name).len() > 0;
      }
      return any_names_argless_enum(u.args, scope);
    },
    typeinfo.TypeArray(a) => {
      return names_argless_enum(a.elem, scope);
    },
    typeinfo.TypeTuple(tup) => {
      return any_names_argless_enum(tup.elements, scope);
    },
    typeinfo.TypeMap(m) => {
      return names_argless_enum(m.key, scope) || names_argless_enum(m.value, scope);
    },
    typeinfo.TypeStruct(r) => {
      return any_names_argless_enum(r.args, scope);
    },
    typeinfo.TypeFunc(f) => {
      return names_argless_enum(f.ret_type, scope) || any_names_argless_enum(f.param_types, scope);
    },
    _ => {
      return false;
    }
  }
}

function any_names_argless_enum(ts: typeinfo.Type[], scope: checker.Scope): boolean {
  for t in ts {
    if (names_argless_enum(t, scope)) {
      return true;
    }
  }
  return false;
}

function record_variables(name: string, scope: checker.Scope, seen: string[]): string[] {
  if (!util.contains(name, "__")) {
    return [];
  }
  let Some(sig) = checker.struct_sig(scope, name) else {
    return [];
  };
  if (sig.type_params.len() > 0 || sig.enum_owner.len() > 0 || util.index_of_str(seen, name) >= 0) {
    return [];
  }
  let out: string[] = [];
  for ft in sig.field_types {
    out = spelled_variables(ft, scope, seen.append(name), out);
  }
  return out;
}

function spelled_variables(t: typeinfo.Type, scope: checker.Scope, seen: string[], out: string[]): string[] {
  let name = "";
  if let typeinfo.TypeUnknown(u) = t {
    name = checker.typevar_reason_name(u.reason);
  }
  if let typeinfo.TypeErased(e) = t {
    name = e.name;
  }
  if (parser.looks_type_var(name)) {
    if (util.index_of_str(out, name) < 0) {
      return out.append(name);
    }
    return out;
  }
  let parts: typeinfo.Type[] = [];
  if let typeinfo.TypeArray(a) = t {
    parts = [a.elem];
  }
  if let typeinfo.TypeTuple(tup) = t {
    parts = tup.elements;
  }
  if let typeinfo.TypeFunc(fn) = t {
    parts = fn.param_types.append(fn.ret_type);
  }
  if let typeinfo.TypeMap(m) = t {
    parts = [m.key, m.value];
  }
  if let typeinfo.TypeUnion(u) = t {
    parts = u.args;
  }
  if let typeinfo.TypeStruct(r) = t {
    if (r.args.len() > 0) {
      parts = r.args;
    } else {
      for v in record_variables(r.name, scope, seen) {
        if (util.index_of_str(out, v) < 0) {
          out = out.append(v);
        }
      }
    }
  }
  for p in parts {
    out = spelled_variables(p, scope, seen, out);
  }
  return out;
}

function bound_type(s: State, name: string, scope: checker.Scope): typeinfo.Type {
  return settled(resolved(checker.scope_type(scope, name), s.template, s.binding, scope));
}

function settled(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeI32(i) = t {
    if (i.polymorphic) {
      return typeinfo.TypeI32 { ...i, polymorphic: false };
    }
  }
  if let typeinfo.TypeFloat(f) = t {
    if (f.polymorphic) {
      return typeinfo.TypeFloat { width: f.width, polymorphic: false };
    }
  }
  if let typeinfo.TypeArray(a) = t {
    return typeinfo.TypeArray { ...a, elem: settled(a.elem) };
  }
  if let typeinfo.TypeTuple(tup) = t {
    let els: typeinfo.Type[] = [];
    for el in tup.elements {
      els = els.append(settled(el));
    }
    return typeinfo.TypeTuple { elements: els };
  }
  if let typeinfo.TypeMap(m) = t {
    return typeinfo.TypeMap { key: settled(m.key), value: settled(m.value) };
  }
  if let typeinfo.TypeStruct(r) = t {
    let args: typeinfo.Type[] = [];
    for arg in r.args {
      args = args.append(settled(arg));
    }
    return typeinfo.TypeStruct { ...r, args: args };
  }
  if let typeinfo.TypeFunc(f) = t {
    let params: typeinfo.Type[] = [];
    for p in f.param_types {
      params = params.append(settled(p));
    }
    return typeinfo.TypeFunc { ...f, param_types: params, ret_type: settled(f.ret_type) };
  }
  if let typeinfo.TypeUnion(u) = t {
    let args: typeinfo.Type[] = [];
    for a in u.args {
      if (checker.unbound_enum_argument(a)) {
        args = args.append(typeinfo.TypeNever { tag: 0 });
      } else {
        args = args.append(settled_payload(a));
      }
    }
    return typeinfo.TypeUnion { ...u, args: args };
  }
  return t;
}

function settled_payload(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(u) = t {
    if (u.name == "Option" && u.args.len() == 0) {
      return typeinfo.TypeUnion { ...u, args: [typeinfo.TypeNever { tag: 0 }] };
    }
  }
  return settled(t);
}

function checked(e: ast.Expr, s: State): typeinfo.Type {
  return settled_in(checker.expr_type(e, s.scope), s);
}

function settled_in(t: typeinfo.Type, s: State): typeinfo.Type {
  return settled(resolved(t, s.template, s.binding, s.scope));
}

function decimal(text: string): boolean {
  if (text.len() == 0) {
    return false;
  }
  for i in 0..text.len() {
    if (text[i] < b'0' || text[i] > b'9') {
      return false;
    }
  }
  return true;
}

function integer_literal(text: string): boolean {
  if (text.len() > 2 && text[0] == b'0' && (text[1] == b'x' || text[1] == b'X')) {
    return util.hex_digits(text, 2);
  }
  return decimal(text);
}

function literal_type(suffix: string): typeinfo.Type {
  if (suffix == "u8") {
    return typeinfo.t_u8();
  }
  if (suffix == "char") {
    return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: true, polymorphic: false };
  }
  if (suffix == "u32") {
    return typeinfo.t_u32();
  }
  if (suffix == "i64") {
    return typeinfo.t_i64();
  }
  if (suffix == "u64") {
    return typeinfo.t_u64();
  }
  if (suffix == "usize") {
    return typeinfo.t_usize();
  }
  if (suffix == "" || suffix == "i32") {
    return typeinfo.t_i32();
  }
  return typeinfo.unchecked();
}

function float_number(n: ast.ExprNumber, s: State, expected: typeinfo.Type): Value {
  let narrow = n.suffix == "f32";
  if let typeinfo.TypeFloat(fl) = expected {
    if (fl.width == 32) {
      narrow = true;
    }
  }
  if (narrow) {
    return define(s, ssa.CONST_INT, [], 0, n.text, typeinfo.t_f32());
  }
  return define(s, ssa.CONST_INT, [], 0, n.text, typeinfo.t_f64());
}

// The value of type void, as `()` writes it.
function unit_value(s: State): Value {
  return define(s, ssa.CONST_INT, [], 0, "", typeinfo.t_void());
}

function number(n: ast.ExprNumber, s: State, expected: typeinfo.Type): Value {
  if (ast.is_unit_literal(n)) {
    return unit_value(s);
  }
  if (n.is_float || n.suffix == "" && ssasem.is_float(expected)) {
    return float_number(n, s, expected);
  }
  if (!integer_literal(n.text)) {
    return refused(s, "unsupported literal");
  }
  let ty = literal_type(n.suffix);
  if (n.suffix == "" && ssasem.is_integer(expected)) {
    ty = expected;
  } else if (n.suffix == "" && ast.literal_is_i64(n.text)) {
    ty = typeinfo.t_i64();
  }
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "unsupported literal width");
  }
  if (ssasem.text_constant(ty) || ssasem.is_usize(ty) && ast.literal_is_i64(n.text)) {
    return define(s, ssa.CONST_INT, [], 0, decimal_text(n.text), ty);
  }
  return define(s, ssa.CONST_INT, [], util.lit_to_i32(n.text), "", ty);
}

function decimal_text(t: string): string {
  if (t.len() < 2 || t[0] != b'0' || t[1] < b'0' || t[1] > b'9') {
    return t;
  }
  let i = 0;
  while (i + 1 < t.len() && t[i] == b'0') {
    i += 1;
  }
  return slice_unchecked(t, i, t.len()).to_owned();
}

function ident(e: ast.Expr, id: ast.ExprIdent, s: State, expected: typeinfo.Type): Value {
  let value = lookup(s, id.name);
  if (value >= 0) {
    return Value { s: s, id: value };
  }
  let ty = checked(e, s);
  if (ssasem.is_func(ty)) {
    return refused(s, "function address is not a closure value: " + id.name);
  }
  let whole = literal_union(e, s, expected);
  if (names_variant(s, whole, id.name)) {
    return variant(id.name, whole, [], s);
  }
  let at = ssasem.find_contract(s.contracts, id.name);
  if (at < 0 || s.contracts.list[at].params.len() != 0 || !semtypes.equal(s.contracts.list[at].result, ty)) {
    return refused(s, "unbound name is not a semantic value: " + id.name);
  }
  let contract = s.contracts.list[at];
  if (ssasem.find_contract_in(s.calls, id.name) < 0) {
    s = State { ...s, calls: s.calls.append(contract) };
  }
  return define(s, ssasem.call(), [], 0, id.name, contract.result);
}

function union_variants(s: State, name: string): string[] {
  if let Some(sig) = checker.union_sig(s.scope, name) {
    if (sig.variants.len() > 0) {
      return sig.variants;
    }
  }
  return checker.owned_variant_names(s.scope, name);
}

function union_layout(s: State, name: string): i32 {
  let variants = union_variants(s, name);
  if (variants.len() == 0) {
    return builtin_union_layout(name);
  }
  let owned = 0;
  let plain = 0;
  for v in variants {
    let Some(vs) = checker.variant_shape_sig(s.scope, v, name) else {
      return 0;
    };
    if (vs.enum_owner == name) {
      owned += 1;
    } else {
      plain += 1;
    }
  }
  if (plain == 0) {
    return semrecords.layout_variant();
  }
  if (owned == 0) {
    return semrecords.layout_member();
  }
  return 0;
}

function builtin_union_layout(name: string): i32 {
  if (name == "Option" || name == "Result") {
    return semrecords.layout_option();
  }
  return 0;
}

function builtin_variants(t: typeinfo.Type): semrecords.Variant[] {
  if let typeinfo.TypeUnion(u) = t {
    if (u.name == "Option" && u.args.len() == 1) {
      return [payload_variant("Some", u.args[0]), semrecords.Variant { name: "None", fields: [] }];
    }
    if (u.name == "Result" && u.args.len() == 2) {
      return [payload_variant("Ok", u.args[0]), payload_variant("Err", u.args[1])];
    }
  }
  return [];
}

function payload_variant(name: string, ty: typeinfo.Type): semrecords.Variant {
  if (typeinfo.is_void(ty)) {
    return semrecords.Variant { name: name, fields: [] };
  }
  return semrecords.Variant { name: name, fields: [semrecords.Field { name: "__ev", ty: ty }] };
}

struct Payloads { types: typeinfo.Type[], unit: boolean }

function builtin_payloads(whole: typeinfo.Type, name: string): Option[Payloads] {
  for v in builtin_variants(whole) {
    if (v.name == name) {
      let types: typeinfo.Type[] = [];
      for field in v.fields {
        types = types.append(field.ty);
      }
      return Some(Payloads { types: types, unit: v.fields.len() == 0 && name != "None" });
    }
  }
  return None;
}

function arm_payloads(s: State, whole: typeinfo.Type, name: string, layout: i32): Option[Payloads] {
  if (layout == semrecords.layout_option()) {
    return builtin_payloads(whole, name);
  }
  let Some(shape) = checker.variant_shape_sig(s.scope, name, typeinfo.union_name(whole)) else {
    return None;
  };
  let sig = checker.instantiated_variant(shape, s.scope, whole);
  return Some(Payloads { types: resolved_types(sig.field_types, s.scope), unit: false });
}

function literal_payloads(s: State, whole: typeinfo.Type, name: string, layout: i32): Option[Payloads] {
  if (layout == semrecords.layout_option()) {
    return builtin_payloads(whole, name);
  }
  let Some(shape) = checker.variant_sig(s.scope, literal_variant_name(s, whole, name), typeinfo.union_name(whole)) else {
    return None;
  };
  let sig = checker.instantiated_variant(shape, s.scope, whole);
  return Some(Payloads { types: resolved_types(sig.field_types, s.scope), unit: false });
}

function literal_variant_name(s: State, whole: typeinfo.Type, name: string): string {
  let sig: checker.UnionSig = match (checker.union_sig(s.scope, typeinfo.union_name(whole))) { Some(u) => u, None => { return name; } };
  if (sig.instance == "" || util.index_of_str(sig.variants, name) >= 0) {
    return name;
  }
  // Enum instances preserve the declaration order of their variants.
  let origin: checker.UnionSig = match (checker.union_sig(s.scope, typeinfo.union_name(enum_origin(whole, s)))) { Some(u) => u, None => { return name; } };
  let at = util.index_of_str(origin.variants, name);
  if (at >= 0 && origin.variants.len() == sig.variants.len()) {
    return sig.variants[at];
  }
  return name;
}

function literal_union(e: ast.Expr, s: State, expected: typeinfo.Type): typeinfo.Type {
  let ty = checked(e, s);
  if (typeinfo.union_name(expected) != typeinfo.union_name(ty)) {
    if (completes_enum(enum_origin(ty, s), enum_origin(expected, s))) {
      return expected;
    }
    return ty;
  }
  if (builtin_union_layout(typeinfo.union_name(ty)) != 0 || union_unsettled(ty) || semtypes.concrete(expected, false)) {
    return expected;
  }
  return ty;
}

function union_unsettled(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(u) = t {
    if (u.args.len() == 0) {
      return true;
    }
    for a in u.args {
      if let typeinfo.TypeNever(_) = a {
        return true;
      }
    }
  }
  return false;
}

function names_variant(s: State, whole: typeinfo.Type, name: string): boolean {
  let owner = typeinfo.union_name(whole);
  if (owner == "") {
    return false;
  }
  return match (literal_payloads(s, whole, name, union_layout(s, owner))) { Some(_) => true, None => false };
}

function struct_name(t: typeinfo.Type): string {
  if let typeinfo.TypeStruct(r) = t {
    if (r.args.len() == 0) {
      return r.name;
    }
  }
  return "";
}

function tuple_element_type(t: typeinfo.Type, at: i32): typeinfo.Type {
  if let typeinfo.TypeTuple(tup) = t {
    if (at < tup.elements.len()) {
      return tup.elements[at];
    }
  }
  return typeinfo.unchecked();
}

function destination_type(e: ast.Expr, s: State, expected: typeinfo.Type): typeinfo.Type {
  if (semtypes.concrete(expected, false)) {
    return expected;
  }
  return checked(e, s);
}

function array(e: ast.Expr, a: ast.ExprArray, s: State, expected: typeinfo.Type): Value {
  let ty = destination_type(e, s, expected);
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "unresolved array literal type");
  }
  let elem = typeinfo.array_elem(ty);
  if (ssasem.is_u8(elem)) {
    let (bytes, constant) = constant_byte_elements(a.elements);
    if (constant) {
      return packed_bytes(e, bytes, s, ty);
    }
  }
  let ids: i32[] = [];
  for e in a.elements {
    let v = expr(e, s, elem);
    s = v.s;
    if (!s.ok) {
      return Value { s: s, id: -1 };
    }
    if (!semtypes.equal(s.values[v.id], elem)) {
      return refused(s, "array element type: " + typeinfo.spelling(s.values[v.id]) + " in " + typeinfo.spelling(ty));
    }
    v = kept_view(unaliased_view(v));
    s = v.s;
    ids = ids.append(v.id);
  }
  let owned: typeinfo.Type = typeinfo.TypeArray { elem: elem, view: false };
  return widen(define(s, ssasem.array_new(), ids, 0, "", owned), ty);
}

function constant_byte_element(e: ast.Expr): i32 {
  if let ast.ExprUnary(u) = e {
    if (u.op == "as_u8") {
      return constant_byte_element(u.operand);
    }
    return -1;
  }
  if let ast.ExprNumber(n) = e {
    if (!n.is_float && (n.suffix == "" || n.suffix == "u8")) {
      let value = util.lit_to_i64(n.text);
      if (value >= 0i64 && value <= 255i64) {
        return value as i32;
      }
    }
  }
  return -1;
}

function constant_byte_elements(elements: ast.Expr[]): (u8[], boolean) {
  let bytes: u8[] = [];
  for e in elements {
    let value = constant_byte_element(e);
    if (value < 0) {
      return (bytes, false);
    }
    bytes = bytes.append(value as u8);
  }
  return (bytes, true);
}

function packed_bytes(e: ast.Expr, bytes: u8[], s: State, expected: typeinfo.Type): Value {
  let ty = destination_type(e, s, expected);
  if (!ssasem.is_u8(typeinfo.array_elem(ty))) {
    return refused(s, "constant byte array destination type");
  }
  let words = byteconst.words(bytes);
  if (!byteconst.valid(words, bytes.len())) {
    return refused(s, "constant byte array payload size");
  }
  let owned: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.array_elem(ty), view: false };
  return widen(define(s, ssasem.bytes_new(), [], bytes.len(), words, owned), ty);
}

function tuple(e: ast.Expr, t: ast.ExprTuple, s: State, expected: typeinfo.Type): Value {
  let ty = destination_type(e, s, expected);
  if (tuple_arity(ty) != t.elements.len()) {
    ty = checked(e, s);
  }
  let ids: i32[] = [];
  let types: typeinfo.Type[] = [];
  for at in 0..t.elements.len() {
    let v = expr(t.elements[at], s, tuple_element_type(ty, at));
    if (!v.s.ok) {
      return Value { s: v.s, id: -1 };
    }
    v = kept_view(unaliased_view(v));
    s = v.s;
    ids = ids.append(v.id);
    types = types.append(s.values[v.id]);
  }
  let built: typeinfo.Type = typeinfo.TypeTuple { elements: types };
  if (semtypes.concrete(ty, false) && !semtypes.equal(built, ty)) {
    return refused(s, "tuple element type");
  }
  return define(s, ssasem.tuple_new(), ids, 0, "", built);
}

function environment_read(ix: ast.ExprIndex, container: i32, s: State): Value {
  let caps = semtypes.env_captures(s.values[container]);
  let slot = 0;
  if let ast.ExprNumber(n) = ix.index {
    if (decimal(n.text)) {
      slot = util.digits_to_i32(n.text);
    }
  }
  if (slot < 1 || slot > caps.len()) {
    return refused(s, "environment projection");
  }
  let v = define(s, ssasem.record_get(), [container], slot, "c" + util.i32_to_string(slot), caps[slot - 1]);
  return Value { s: State { ...v.s, foreign: v.s.foreign.append(v.id) }, id: v.id };
}

function index(ix: ast.ExprIndex, s: State): Value {
  let container = expr(ix.array, s, typeinfo.unchecked());
  if (container.s.ok && semtypes.is_env(container.s.values[container.id])) {
    return environment_read(ix, container.id, container.s);
  }
  let at = expr(ix.index, container.s, typeinfo.t_i32());
  if (!at.s.ok) {
    return at;
  }
  at = index_operand(at);
  s = at.s;
  if (!s.ok) {
    return at;
  }
  let unchecked = 0;
  if (ix.unchecked) {
    unchecked = 1;
  }
  if (ssasem.is_text(s.values[container.id])) {
    return define(s, ssasem.str_index(), [container.id, at.id], unchecked, "", typeinfo.t_u8());
  }
  let elem = typeinfo.array_elem(s.values[container.id]);
  if (!semtypes.concrete(elem, false)) {
    return refused(s, "array projection contract");
  }
  return define(s, ssasem.array_get(), [container.id, at.id], unchecked, "", elem);
}

function index_operand(v: Value): Value {
  let s = v.s;
  let source = s.values[v.id];
  if (is_i32(source)) {
    return v;
  }
  if (!ssasem.is_integer(source)) {
    return refused(s, "array projection contract");
  }
  let narrowed = define(s, ssasem.cast(), [v.id], 0, "", typeinfo.t_i32());
  if (ssasem.is_u8(source)) {
    return narrowed;
  }
  let back = define(narrowed.s, ssasem.cast(), [narrowed.id], 0, "", source);
  let fits = define(back.s, ssa.BINARY, [back.id, v.id], 0, "==", typeinfo.t_bool());
  s = fits.s;
  let pred = s.cur.id;
  let hit = s.next_block;
  let miss = hit + 1;
  let join = hit + 2;
  s = State { ...s, next_block: join + 1 };
  s = terminate(s, ssa.t_brif(fits.id, hit, miss));
  s = terminate(open(s, hit, [pred]), ssa.t_br(join));
  let outside = define(open(s, miss, [pred]), 1, [], -1, "", typeinfo.t_i32());
  s = terminate(outside.s, ssa.t_br(join));
  return define(open(s, join, [hit, miss]), 8, [narrowed.id, outside.id], 0, "", typeinfo.t_i32());
}

struct SliceTree { s: State, preds: i32[] }

function slice_probe(t: SliceTree, src: i32, at: i32, len: i32, sink: i32): SliceTree {
  let s = t.s;
  let preds = t.preds;
  let interior = s.cur.id;
  let below = s.next_block;
  let byte = below + 1;
  let lead = byte + 1;
  let ok = lead + 1;
  s = State { ...s, next_block: ok + 1 };

  let zero = define(s, ssa.CONST_INT, [], 0, "", typeinfo.t_i32());
  let after_start = define(zero.s, ssa.BINARY, [at, zero.id], 0, ">", typeinfo.t_bool());
  s = terminate(after_start.s, ssa.t_brif(after_start.id, below, ok));

  let inside = define(open(s, below, [interior]), 9, [at, len], 0, "<", typeinfo.t_bool());
  s = terminate(inside.s, ssa.t_brif(inside.id, byte, ok));

  let b = define(open(s, byte, [below]), ssasem.str_index(), [src, at], 0, "", typeinfo.t_u8());
  let low = define(b.s, ssa.CONST_INT, [], 128, "", typeinfo.t_u8());
  let ascii = define(low.s, ssa.BINARY, [b.id, low.id], 0, "<", typeinfo.t_bool());
  s = terminate(ascii.s, ssa.t_brif(ascii.id, ok, lead));

  let first = define(open(s, lead, [byte]), 1, [], 192, "", typeinfo.t_u8());
  let starts = define(first.s, ssa.BINARY, [b.id, first.id], 0, ">=", typeinfo.t_bool());
  s = terminate(starts.s, ssa.t_brif(starts.id, ok, sink));

  return SliceTree { s: open(s, ok, [interior, below, byte, lead]), preds: preds.append(lead) };
}

function slice_bound(t: SliceTree, left: i32, op: string, right: i32, sink: i32): SliceTree {
  let s = t.s;
  let preds = t.preds;
  let from = s.cur.id;
  let next = s.next_block;
  s = State { ...s, next_block: next + 1 };
  let held = define(s, ssa.BINARY, [left, right], 0, op, typeinfo.t_bool());
  s = terminate(held.s, ssa.t_brif(held.id, next, sink));
  return SliceTree { s: open(s, next, [from]), preds: preds.append(from) };
}

function array_slice(sl: ast.ExprSlice, src: i32, elem: typeinfo.Type, s: State): Value {
  let lo = expr(sl.start, s, typeinfo.t_i32());
  s = lo.s;
  if (!s.ok) {
    return lo;
  }
  let hi = define(s, ssasem.length(), [src], 0, "", typeinfo.t_i32());
  if (!sl.open_end) {
    hi = expr(sl.end, s, typeinfo.t_i32());
  }
  s = hi.s;
  if (!s.ok) {
    return hi;
  }
  if (!is_i32(s.values[lo.id]) || !is_i32(s.values[hi.id])) {
    return refused(s, "slice bound type");
  }
  return define(s, ssasem.arr_slice(), [src, lo.id, hi.id], 0, "", typeinfo.TypeArray { elem: elem, view: true });
}

function slice_expr(e: ast.Expr, sl: ast.ExprSlice, s: State): Value {
  let src = expr(sl.array, s, typeinfo.unchecked());
  s = src.s;
  if (!s.ok) {
    return src;
  }
  if let typeinfo.TypeArray(a) = s.values[src.id] {
    return array_slice(sl, src.id, a.elem, s);
  }
  if (!ssasem.is_text(s.values[src.id])) {
    return refused(s, "unsupported slice source: " + typeinfo.spelling(s.values[src.id]));
  }
  let whole = checked(e, s);
  let layout = union_layout(s, typeinfo.union_name(whole));
  if (layout != semrecords.layout_option()) {
    return refused(s, "unsupported slice result");
  }
  let Some(shape) = literal_payloads(s, whole, "Some", layout) else {
    return refused(s, "unsupported slice result");
  };
  if (shape.types.len() != 1 || !semtypes.equal(shape.types[0], typeinfo.t_str())) {
    return refused(s, "unsupported slice result");
  }
  let len = define(s, ssasem.length(), [src.id], 0, "", typeinfo.t_i32());
  s = len.s;
  let lo = expr(sl.start, s, typeinfo.t_i32());
  s = lo.s;
  if (!s.ok) {
    return lo;
  }
  let hi = len.id;
  if (!sl.open_end) {
    let end = expr(sl.end, s, typeinfo.t_i32());
    s = end.s;
    if (!s.ok) {
      return end;
    }
    hi = end.id;
  }
  if (!is_i32(s.values[lo.id]) || !is_i32(s.values[hi])) {
    return refused(s, "slice bound type");
  }

  let sink = s.next_block;
  let join = sink + 1;
  s = State { ...s, next_block: join + 1 };
  let floor = define(s, ssa.CONST_INT, [], 0, "", typeinfo.t_i32());
  s = floor.s;

  let t = SliceTree { s: s, preds: [] };
  t = slice_bound(t, floor.id, "<=", lo.id, sink);
  t = slice_bound(t, lo.id, "<=", hi, sink);
  t = slice_bound(t, hi, "<=", len.id, sink);
  t = slice_probe(t, src.id, lo.id, len.id, sink);
  t = slice_probe(t, src.id, hi, len.id, sink);
  s = t.s;
  let sink_preds = t.preds;

  let view = define(s, ssasem.slice(), [src.id, lo.id, hi], 0, "", typeinfo.t_str());
  let some = define(view.s, ssasem.variant_new(), [view.id], 0, "Some", whole);
  let from_some = some.s.cur.id;
  s = terminate(some.s, ssa.t_br(join));

  let none = define(open(s, sink, sink_preds), ssasem.variant_new(), [], 0, "None", whole);
  s = terminate(none.s, ssa.t_br(join));

  return define(open(s, join, [from_some, sink]), 8, [some.id, none.id], 0, "", whole);
}

function field(e: ast.Expr, fa: ast.ExprFieldAccess, s: State, expected: typeinfo.Type): Value {
  let head = type_head(fa.obj, s);
  if (head.len() > 0) {
    return qualified_variant(e, head, fa.field, [], s, expected);
  }
  if (!decimal(fa.field)) {
    return record_field(fa, s);
  }
  let container = expr(fa.obj, s, typeinfo.unchecked());
  s = container.s;
  if (!s.ok) {
    return container;
  }
  let at = util.lit_to_i32(fa.field);
  let elem = tuple_element_type(s.values[container.id], at);
  if (!semtypes.concrete(elem, true)) {
    return refused(s, "tuple projection contract");
  }
  return define(s, ssasem.tuple_get(), [container.id], at, "", elem);
}

function record_schema(name: string, s: State): Option[checker.StructSig] {
  let Some(sig) = checker.struct_sig(s.scope, name) else {
    return None;
  };
  if (sig.type_params.len() > 0 || sig.enum_owner.len() > 0) {
    return None;
  }
  return Some(checker.StructSig { ...sig, field_types: resolved_types(sig.field_types, s.scope) });
}

function has_record_schema(name: string, s: State): boolean {
  return match (record_schema(name, s)) { Some(_) => true, None => false };
}

function record_sig(t: typeinfo.Type, s: State): Option[checker.StructSig] {
  if let typeinfo.TypeStruct(r) = t {
    let Some(sig) = record_schema(r.name, s) else {
      return None;
    };
    if (r.args.len() == 0) {
      return Some(sig);
    }
    let vars = record_variables(r.name, s.scope, []);
    if (vars.len() != r.args.len()) {
      return None;
    }
    let b = ssasem.Binding { ok: true, why: "", names: vars, types: r.args };
    let fts: typeinfo.Type[] = [];
    for ft in sig.field_types {
      fts = fts.append(resolved(ft, true, b, s.scope));
    }
    return Some(checker.StructSig { ...sig, field_types: fts });
  }
  return None;
}

function record_field(fa: ast.ExprFieldAccess, s: State): Value {
  let container = expr(fa.obj, s, typeinfo.unchecked());
  s = container.s;
  if (!s.ok) {
    return container;
  }
  if (fa.field == "fd" && semtypes.is_socket(s.values[container.id])) {
    return socket_number(container);
  }
  if (fa.field == "fd" && semtypes.is_fd_handle(s.values[container.id])) {
    return define(s, ssasem.cast(), [container.id], 0, "", typeinfo.t_i32());
  }
  let Some(sig) = record_sig(s.values[container.id], s) else {
    return refused(s, "unsupported projection");
  };
  let at = util.index_of_str(sig.field_names, fa.field);
  if (at < 0 || !semtypes.concrete(sig.field_types[at], false)) {
    return refused(s, "record projection contract");
  }
  return field_read(s, container.id, at, fa.field, sig.field_types[at]);
}

struct Written { s: State, ids: i32[], at: i32[] }

function written_fields(sl: ast.ExprStructLit, sig: checker.StructSig, s: State): Written {
  let ids: i32[] = [];
  let at: i32[] = [];
  for i in 0..sl.field_values.len() {
    let slot = util.index_of_str(sig.field_names, sl.field_names[i]);
    if (slot < 0 || util.index_of_i32(at, slot) >= 0) {
      return Written { s: fail(s, "unsupported record literal"), ids: [], at: [] };
    }
    let v = expr(sl.field_values[i], s, sig.field_types[slot]);
    s = v.s;
    if (!s.ok) {
      return Written { s: s, ids: [], at: [] };
    }
    if (!semtypes.equal(s.values[v.id], sig.field_types[slot])) {
      return Written { s: fail(s, "record field type"), ids: [], at: [] };
    }
    v = kept_view(unaliased_view(v));
    s = v.s;
    ids = ids.append(v.id);
    at = at.append(slot);
  }
  return Written { s: s, ids: ids, at: at };
}

function place_fields(w: Written, sig: checker.StructSig, base: i32): Written {
  if (!w.s.ok) {
    return w;
  }
  let s = w.s;
  let ids: i32[] = [];
  for d in 0..sig.field_names.len() {
    let found = util.index_of_i32(w.at, d);
    if (found >= 0) {
      ids = ids.append(w.ids[found]);
    } else {
      let got = field_read(s, base, d, sig.field_names[d], sig.field_types[d]);
      s = got.s;
      if (!s.ok) {
        return Written { s: s, ids: [], at: [] };
      }
      ids = ids.append(got.id);
    }
  }
  return Written { s: s, ids: ids, at: w.at };
}

function built_record(w: Written, ty: typeinfo.Type, base: i32): Value {
  if (!w.s.ok) {
    return Value { s: w.s, id: -1 };
  }
  return define(w.s, ssasem.record_new(), w.ids, base, "", ty);
}

function record_update(e: ast.Expr, sl: ast.ExprStructLit, s: State): Value {
  let Some(ty) = record_type(sl.type_name, s) else {
    return refused(s, "unsupported record literal");
  };
  let Some(sig) = record_sig(ty, s) else {
    return refused(s, "unsupported record literal");
  };
  let base = expr(sl.base, s, ty);
  s = base.s;
  if (!s.ok) {
    return base;
  }
  if (!semtypes.equal(s.values[base.id], ty)) {
    return refused(s, "record base type");
  }
  return built_record(place_fields(written_fields(sl, sig, s), sig, base.id), ty, base.id + 1);
}

function record(e: ast.Expr, sl: ast.ExprStructLit, s: State): Value {
  if (sl.has_base) {
    return record_update(e, sl, s);
  }
  let Some(ty) = record_type(sl.type_name, s) else {
    return refused(s, "unsupported record literal");
  };
  let Some(sig) = record_sig(ty, s) else {
    return refused(s, "unsupported record literal");
  };
  if (sl.field_values.len() != sig.field_types.len()) {
    return refused(s, "unsupported record literal");
  }
  return built_record(place_fields(written_fields(sl, sig, s), sig, -1), ty, 0);
}

function record_type(name: string, s: State): Option[typeinfo.Type] {
  let Some(sig) = record_schema(name, s) else {
    return None;
  };
  return Some(resolved(typeinfo.TypeStruct { name: sig.name, args: [] }, s.template, s.binding, s.scope));
}

function variant(name: string, whole: typeinfo.Type, written: ast.Expr[], s: State): Value {
  name = literal_variant_name(s, whole, name);
  let layout = union_layout(s, typeinfo.union_name(whole));
  if (layout != semrecords.layout_variant() && layout != semrecords.layout_option()) {
    return refused(s, "unsupported variant literal");
  }
  let Some(shape) = literal_payloads(s, whole, name, layout) else {
    return refused(s, "unsupported variant literal");
  };
  let args = written;
  if (shape.unit && written.len() == 1 && typeinfo.is_void(checked(written[0], s))) {
    let unit = expr(written[0], s, typeinfo.t_void());
    s = unit.s;
    if (!s.ok) {
      return unit;
    }
    args = [];
  }
  if (!semtypes.concrete(whole, false) || args.len() != shape.types.len()) {
    return refused(s, "unsupported variant literal");
  }
  let ids: i32[] = [];
  for i in 0..args.len() {
    let v = expr(args[i], s, shape.types[i]);
    s = v.s;
    if (!s.ok) {
      return v;
    }
    // Convert the payload before the constructor stores it.
    if (typeinfo.lossless_widen(s.values[v.id], shape.types[i])) {
      v = define(s, ssasem.cast(), [v.id], 0, "", shape.types[i]);
      s = v.s;
    }
    if (!semtypes.equal(s.values[v.id], shape.types[i])) {
      return refused(s, "variant field type");
    }
    v = kept_view(unaliased_view(v));
    s = v.s;
    ids = ids.append(v.id);
  }
  return define(s, ssasem.variant_new(), ids, 0, name, whole);
}

function width_bearing(e: ast.Expr): boolean {
  if let ast.ExprNumber(n) = e {
    return n.suffix != "";
  }
  return !ast.int_literal_tree(e);
}

function operand_type(t: typeinfo.Type): boolean {
  return ssasem.is_integer(t) || ssasem.is_float(t);
}

function operand_width(e: ast.Expr, b: ast.ExprBinary, s: State, expected: typeinfo.Type, types: checker.OperatorTypes): typeinfo.Type {
  if (ssasem.checked_arith(b.op)) {
    expected = option_payload(expected);
  }
  if (ast.int_literal_tree(e) && ssasem.is_integer(expected)) {
    return expected;
  }
  if ((ast.float_literal_tree(e) || ast.is_unsettled_int_literal(e)) && ssasem.is_float(expected)) {
    return expected;
  }
  let l = settled_in(types.operands[0].whole, s);
  let r = settled_in(types.operands[1].whole, s);
  if (width_bearing(b.left) && ssasem.is_usize(l)) {
    return l;
  }
  if (width_bearing(b.right) && ssasem.is_usize(r)) {
    return r;
  }
  let whole = settled_in(types.whole, s);
  if (operand_type(whole)) {
    return whole;
  }
  if (width_bearing(b.left) && operand_type(l)) {
    return l;
  }
  if (width_bearing(b.right) && operand_type(r)) {
    return r;
  }
  return typeinfo.unchecked();
}

function option_payload(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(u) = t {
    if (u.name == "Option" && u.args.len() == 1) {
      return u.args[0];
    }
  }
  return typeinfo.unchecked();
}

function address_widen(v: Value, want: typeinfo.Type): Value {
  if (!v.s.ok || !ssasem.is_usize(want)) {
    return v;
  }
  let t = v.s.values[v.id];
  if (ssasem.is_usize(t) || !ssasem.is_integer(t)) {
    return v;
  }
  return define(v.s, ssasem.cast(), [v.id], 0, "", want);
}

function binary(e: ast.Expr, b: ast.ExprBinary, s: State, expected: typeinfo.Type): Value {
  if (b.op == "&&" || b.op == "||") {
    return logical(b, s, untyped());
  }
  return typed_binary(e, b, s, expected, checker.operator_types(e, s.scope));
}

function untyped(): checker.OperatorTypes {
  return checker.OperatorTypes { whole: typeinfo.unchecked(), operands: [] };
}

// An operand of a binary operator. `types` holds the checked types of the
// operand, so a nested operator does not check its operands again.
function operand(e: ast.Expr, s: State, expected: typeinfo.Type, types: checker.OperatorTypes): Value {
  if let ast.ExprBinary(b) = e {
    if (types.operands.len() == 2) {
      return typed_binary(e, b, s, expected, types);
    }
  }
  return expr(e, s, expected);
}

function operand_types(types: checker.OperatorTypes, at: i32): checker.OperatorTypes {
  if (types.operands.len() == 2) {
    return types.operands[at];
  }
  return untyped();
}

function typed_binary(e: ast.Expr, b: ast.ExprBinary, s: State, expected: typeinfo.Type, types: checker.OperatorTypes): Value {
  if (b.op == "&&" || b.op == "||") {
    return logical(b, s, types);
  }
  let want = operand_width(e, b, s, expected, types);
  if (!operand_type(want) && ast.int_literal_tree(b.left) && !ast.int_literal_tree(b.right)) {
    let first = operand(b.right, s, want, types.operands[1]);
    if (!first.s.ok) {
      return first;
    }
    let wide = first.s.values[first.id];
    if (ssasem.is_integer(wide) || ssasem.is_float(wide) && ast.is_unsettled_int_literal(b.left)) {
      let right_id = first.id;
      let lit = operand(b.left, first.s, wide, types.operands[0]);
      if (!lit.s.ok) {
        return lit;
      }
      return arithmetic(b, lit.id, right_id, lit.s);
    }
  }
  let produced = address_widen(operand(b.left, s, want, types.operands[0]), want);
  s = produced.s;
  if (!s.ok) {
    return produced;
  }
  let left = produced.id;
  if (!operand_type(want) && ast.int_literal_tree(b.right) && ssasem.is_integer(s.values[left]) && !wide_literal(b.right)) {
    want = s.values[left];
  }
  if (!operand_type(want) && ast.float_literal_tree(b.right) && ssasem.is_float(s.values[left])) {
    want = s.values[left];
  }
  let key = composite_key(b.op, s.values[left], s);
  if (key != "") {
    return composite_compare(b, left, key, s);
  }
  let arith = nominal_method_key(ast.operator_method(b.op), s.values[left], s);
  if (arith != "") {
    return operator_method(left, [b.right], arith, s);
  }
  if (b.op == "+" && ssasem.is_string(s.values[left])) {
    return append_text(b, left, b.right, s, want);
  }
  let right = address_widen(operand(b.right, s, want, types.operands[1]), want);
  s = right.s;
  if (!s.ok) {
    return right;
  }
  return arithmetic(b, left, right.id, s);
}

// Concatenation is associative and `l + (x + y)` evaluates l, x, y in that
// order, so it appends x and then y to l: the left operand's buffer grows in
// place as it does for `(l + x) + y`.
function append_text(b: ast.ExprBinary, left: i32, part: ast.Expr, s: State, want: typeinfo.Type): Value {
  if let ast.ExprBinary(inner) = part {
    if (inner.op == "+" && ssasem.is_string(checked(inner.left, s)) && ssasem.is_string(checked(part, s))) {
      let head = append_text(b, left, inner.left, s, want);
      if (!head.s.ok) {
        return head;
      }
      return append_text(b, head.id, inner.right, head.s, want);
    }
  }
  if let Some(c) = builtin_slice(part, s) {
    return range_append(left, c, s);
  }
  let right = address_widen(expr(part, s, want), want);
  if (!right.s.ok) {
    return right;
  }
  return arithmetic(b, left, right.id, right.s);
}

function arithmetic(b: ast.ExprBinary, left: i32, right: i32, s: State): Value {
  let counted = shift_count(b.op, right, s, s.values[left]);
  s = counted.s;
  right = counted.id;
  let common = typeinfo.mixed_integer_join(s.values[left], s.values[right]);
  if (semtypes.concrete(common, false)) {
    let l = widen(Value { s: s, id: left }, common);
    let r = widen(Value { s: l.s, id: right }, common);
    s = r.s;
    left = l.id;
    right = r.id;
  }
  if (typeinfo.lossless_widen(s.values[left], s.values[right])) {
    let wide = define(s, ssasem.cast(), [left], 0, "", s.values[right]);
    s = wide.s;
    left = wide.id;
  } else if (typeinfo.lossless_widen(s.values[right], s.values[left])) {
    let wide = define(s, ssasem.cast(), [right], 0, "", s.values[left]);
    s = wide.s;
    right = wide.id;
  }
  let ty = ssasem.binary_result(b.op, s.values[left], s.values[right]);
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "operator contract: " + typeinfo.spelling(s.values[left]) + " " + b.op + " " + typeinfo.spelling(s.values[right]));
  }
  if let Some(v) = folded_value(s, b.op, left, right, ty, ast.literal_operand(b.left) && ast.literal_operand(b.right)) {
    return v;
  }
  return define(s, ssa.BINARY, [left, right], 0, b.op, ty);
}

// An i32 or i64 operation on constants that the block just defined, folded.
function folded_value(s: State, op: string, left: i32, right: i32, ty: typeinfo.Type, literal: boolean): Option[Value] {
  if let Some(v) = folded_constants(s, op, left, right, ty) {
    return Some(folded(s, v, ty, [left, right], literal));
  }
  if (!ssasem.is_i64(ty)) {
    return None;
  }
  if let Some(a) = recent_wide(s, left) {
    if let Some(b) = recent_wide(s, right) {
      if let Some(v) = folded_i64(op, a.value, b.value) {
        return Some(folded_text(s, v, ty, a.temps.concat(b.temps), literal));
      }
    }
  }
  return None;
}

// An i64 constant that the block's last instructions define: a text constant,
// or a widening cast of the i32 constant just before it. temps are the
// instructions that define it.
struct Wide { value: i64, temps: i32[] }

function recent_wide(s: State, v: i32): Option[Wide] {
  if (!ssasem.is_i64(s.values[v])) {
    return None;
  }
  let n = s.cur.insts.len();
  for i in 0..3 {
    if (i < n && s.cur.insts[n - 1 - i].result == v) {
      return wide_at(s, n - 1 - i);
    }
  }
  return None;
}

function wide_at(s: State, at: i32): Option[Wide] {
  let ins = s.cur.insts[at];
  if (ins.kind_tag == ssa.CONST_INT && ins.args.len() == 0 && util.is_decimal_i64(ins.str)) {
    return Some(Wide { value: util.lit_to_i64(ins.str), temps: [ins.result] });
  }
  if (ins.kind_tag != ssasem.cast() || ins.args.len() != 1 || at == 0) {
    return None;
  }
  return widened_constant(s, s.cur.insts[at - 1], ins);
}

function widened_constant(s: State, src: ssa.SInst, cast: ssa.SInst): Option[Wide] {
  if (src.result != cast.args[0] || src.kind_tag != ssa.CONST_INT || src.args.len() != 0) {
    return None;
  }
  if (src.str == "" && ssasem.is_i32(s.values[src.result])) {
    return Some(Wide { value: src.imm as i64, temps: [src.result, cast.result] });
  }
  if (util.is_decimal_i32(src.str) && src.str[0] != b'-') {
    return Some(Wide { value: util.lit_to_i64(src.str), temps: [src.result, cast.result] });
  }
  return None;
}

// The i64 sum or difference of two constants, when it fits and is not the
// least i64, whose text the lowering does not read back.
function folded_i64(op: string, a: i64, b: i64): Option[i64] {
  if (!wide_fits(op, a, b)) {
    return None;
  }
  if (op == "+") {
    return Some(a + b);
  }
  if (op == "-") {
    return Some(a - b);
  }
  return None;
}

function wide_fits(op: string, a: i64, b: i64): boolean {
  let most = 9223372036854775807i64;
  if (op == "+") {
    return !(b > 0 && a > most - b || b < 0 && a <= -most - b);
  }
  return !(b < 0 && a > most + b || b > 0 && a <= -most + b);
}

function folded_text(s: State, v: i64, ty: typeinfo.Type, temps: i32[], literal: boolean): Value {
  if (literal) {
    return define(without_temporaries(s, temps), 1, [], 0, util.i64_to_string(v), ty);
  }
  return define(s, ssa.CONST_INT, [], 0, util.i64_to_string(v), ty);
}

// The constant v in place of an operation on constants. The constants of a
// literal operand are only that operation's, so they leave with it and the
// constant takes the first of their ids: `-1` and `0 - 1` give one graph.
function folded(s: State, v: i32, ty: typeinfo.Type, operands: i32[], literal: boolean): Value {
  if (literal) {
    return define(without_temporaries(s, operands), 1, [], v, "", ty);
  }
  return define(s, ssa.CONST_INT, [], v, "", ty);
}

// s without its last instructions and values when they define exactly ids.
function without_temporaries(s: State, ids: i32[]): State {
  let n = s.cur.insts.len();
  let k = ids.len();
  let first = s.values.len() - k;
  if (n < k) {
    return s;
  }
  for i in 0..k {
    if (ids[i] != first + i || s.cur.insts[n - k + i].result != ids[i]) {
      return s;
    }
  }
  return State { ...s, cur: ssa.SBlock { ...s.cur, insts: s.cur.insts.truncate(n - k) }, values: s.values.truncate(first) };
}

// An i32 operation on two constants that the block just defined, folded.
function folded_constants(s: State, op: string, left: i32, right: i32, ty: typeinfo.Type): Option[i32] {
  if (!ssasem.is_i32(ty)) {
    return None;
  }
  if let Some(a) = recent_constant(s, left) {
    if let Some(b) = recent_constant(s, right) {
      return semunroll.folded_i32(op, a, b);
    }
  }
  return None;
}

// The value of v when one of the block's last two instructions defines it
// as an i32 constant.
function recent_constant(s: State, v: i32): Option[i32] {
  let insts = s.cur.insts;
  let n = insts.len();
  for i in 0..2 {
    if (i < n) {
      let ins = insts[n - 1 - i];
      if (ins.result == v) {
        if (ins.kind_tag == ssa.CONST_INT && ins.str == "" && ins.args.len() == 0 && ssasem.is_i32(s.values[v])) {
          return Some(ins.imm);
        }
        return None;
      }
    }
  }
  return None;
}

function wide_literal(e: ast.Expr): boolean {
  if let ast.ExprNumber(n) = e {
    return !n.is_float && n.suffix == "" && ast.literal_is_i64(n.text);
  }
  return false;
}

function composite_key(op: string, left: typeinfo.Type, s: State): string {
  let verb = comparison_verb(op);
  if (verb != "" && array_method_prefix(left) != "") {
    let at = array_method_contract(left, verb, s.contracts);
    if (at < 0) {
      return "";
    }
    return s.contracts.list[at].name;
  }
  return nominal_method_key(verb, left, s);
}

// method_owner names the namespace of a struct, an enum or a tuple receiver.
function method_owner(t: typeinfo.Type): string {
  if let typeinfo.TypeTuple(tup) = t {
    return parser.tuple_arity_namespace(tup.elements.len());
  }
  let owner = struct_name(t);
  if (owner == "") {
    return typeinfo.union_name(t);
  }
  return owner;
}

function nominal_method_key(verb: string, t: typeinfo.Type, s: State): string {
  if (verb == "") {
    return "";
  }
  let owner = method_owner(t);
  if (owner == "") {
    return "";
  }
  let key = owner + "." + verb;
  if (ssasem.find_contract(s.contracts, key) < 0) {
    return "";
  }
  return key;
}

function operator_method(recv: i32, args: ast.Expr[], key: string, s: State): Value {
  let contract = s.contracts.list[ssasem.find_contract(s.contracts, key)];
  if (args.len() + 1 != contract.params.len()) {
    return refused(s, "call arity");
  }
  return invoke_method(recv, args, contract, s, ssasem.unbound(), ssasem.unbound());
}

function comparison_verb(op: string): string {
  if (op == "==" || op == "!=") {
    return "eq";
  }
  if (op == "<" || op == "<=" || op == ">" || op == ">=") {
    return "cmp";
  }
  return "";
}

function composite_compare(b: ast.ExprBinary, left: i32, key: string, s: State): Value {
  let contract = s.contracts.list[ssasem.find_contract(s.contracts, key)];
  if (contract.params.len() != 2) {
    return refused(s, "call arity");
  }
  let call = invoke_method(left, [b.right], contract, s, ssasem.unbound(), ssasem.unbound());
  s = call.s;
  if (!s.ok) {
    return call;
  }
  if (comparison_verb(b.op) == "eq") {
    if (!semtypes.equal(s.values[call.id], typeinfo.t_bool())) {
      return refused(s, "operator contract: " + key + " answers " + typeinfo.spelling(s.values[call.id]));
    }
    if (b.op == "==") {
      return call;
    }
    return define(s, ssa.UNARY, [call.id], 0, "!", typeinfo.t_bool());
  }
  if (!ssasem.is_integer(s.values[call.id])) {
    return refused(s, "operator contract: " + key + " answers " + typeinfo.spelling(s.values[call.id]));
  }
  let zero = define(s, ssa.CONST_INT, [], 0, "", s.values[call.id]);
  return define(zero.s, ssa.BINARY, [call.id, zero.id], 0, b.op, typeinfo.t_bool());
}

function shift_count(op: string, count: i32, s: State, value: typeinfo.Type): Value {
  if (op != "<<" && op != ">>") {
    return Value { s: s, id: count };
  }
  let t = s.values[count];
  if (!ssasem.is_integer(t) || !ssasem.is_integer(value) || semtypes.equal(t, value)) {
    return Value { s: s, id: count };
  }
  return define(s, ssasem.cast(), [count], 0, "", value);
}

function unary(e: ast.Expr, u: ast.ExprUnary, s: State, expected: typeinfo.Type): Value {
  if (u.op == "try_") {
    return try_expr(u, s, expected);
  }
  if (u.op.len() > 4 && u.op.starts_with("as?_")) {
    return downcast(e, u, s);
  }
  if (parser.is_cast_op(u.op)) {
    return cast(e, u, s);
  }
  let want = typeinfo.unchecked();
  if (u.op == "-" && operand_type(expected)) {
    want = expected;
  }
  let operand = expr(u.operand, s, want);
  s = operand.s;
  if (!s.ok) {
    return operand;
  }
  if (u.op == "~") {
    return bitwise_not(s, operand.id);
  }
  if (u.op == "-") {
    let neg = nominal_method_key("neg", s.values[operand.id], s);
    if (neg != "") {
      return operator_method(operand.id, [], neg, s);
    }
    let ot = s.values[operand.id];
    if (ssasem.is_unsigned_int(ot)) {
      let text = "";
      if (ssasem.text_constant(ot)) {
        text = "0";
      }
      let zero = define(s, ssa.CONST_INT, [], 0, text, ot);
      return define(zero.s, ssa.BINARY, [zero.id, operand.id], 0, "-", ot);
    }
  }
  let ty = ssasem.unary_result(u.op, s.values[operand.id]);
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "operator contract: " + u.op + " " + typeinfo.spelling(s.values[operand.id]));
  }
  return unary_op(s, u.op, operand.id, ty, ast.literal_operand(u.operand));
}

// `~x` is `x ^ (-1)` in the type of x: the subtraction wraps to all ones
// in each integer type, so no backend needs an operator of its own.
function bitwise_not(s: State, operand: i32): Value {
  let ot = s.values[operand];
  if (!ssasem.is_integer(ot)) {
    return refused(s, "operator contract: ~ " + typeinfo.spelling(ot));
  }
  let zero_text = "";
  let one_text = "";
  let one_imm = 1;
  if (ssasem.text_constant(ot)) {
    zero_text = "0";
    one_text = "1";
    one_imm = 0;
  }
  let zero = define(s, ssa.CONST_INT, [], 0, zero_text, ot);
  let one = define(zero.s, ssa.CONST_INT, [], one_imm, one_text, ot);
  let ones = define(one.s, ssa.BINARY, [zero.id, one.id], 0, "-", ot);
  return define(ones.s, ssa.BINARY, [operand, ones.id], 0, "^", ot);
}

// A negation of an i32 constant that the block just defined is that constant.
function unary_op(s: State, op: string, operand: i32, ty: typeinfo.Type, literal: boolean): Value {
  if (op == "-" && ssasem.is_i32(ty)) {
    if let Some(a) = recent_constant(s, operand) {
      if let Some(v) = semunroll.folded_i32("-", 0, a) {
        return folded(s, v, ty, [operand], literal);
      }
    }
  }
  if (op == "-") {
    if let Some(v) = negated_wide(s, operand, ty, literal) {
      return v;
    }
  }
  return define(s, ssa.UNARY, [operand], 0, op, ty);
}

function negated_wide(s: State, operand: i32, ty: typeinfo.Type, literal: boolean): Option[Value] {
  if (!ssasem.is_i64(ty)) {
    return None;
  }
  if let Some(a) = recent_wide(s, operand) {
    if let Some(v) = folded_i64("-", 0, a.value) {
      return Some(folded_text(s, v, ty, a.temps, literal));
    }
  }
  return None;
}

function try_expr(u: ast.ExprUnary, s: State, expected: typeinfo.Type): Value {
  if (s.replaying) {
    return refused(s, "`?` inside a defer action (E079)");
  }
  let want = typeinfo.unchecked();
  if let ast.ExprCall(c) = u.operand {
    if let ast.ExprIdent(cn) = c.callee {
      if (cn.name == "Some" && semtypes.concrete(expected, false)) {
        want = typeinfo.TypeUnion { name: "Option", args: [expected] };
      }
    }
  }
  let v = expr(u.operand, s, want);
  s = v.s;
  if (!s.ok) {
    return v;
  }
  let from = s.values[v.id];
  let flayout = union_layout(s, typeinfo.union_name(from));
  let rlayout = union_layout(s, typeinfo.union_name(s.result));
  if (!try_layout(flayout)) {
    return refused(s, "try of a value that is not a union");
  }
  if (!try_layout(rlayout)) {
    return refused(s, "try in a body whose result is not a union");
  }
  let fnames = variant_names(s, from, flayout);
  let rnames = variant_names(s, s.result, rlayout);
  if (fnames.len() == 1 && rnames.len() == 2 && fnames[0] == rnames[0]) {
    if let Some(only) = arm_payloads(s, from, fnames[0], flayout) {
      if (only.types.len() == 1) {
        return define(s, ssasem.variant_get(), [v.id], 0, fnames[0], only.types[0]);
      }
    }
  }
  if (fnames.len() != 2 || rnames.len() != 2) {
    return refused(s, "try of a union that is not two variants");
  }
  let good_match = arm_payloads(s, from, fnames[0], flayout);
  let gone_match = arm_payloads(s, from, fnames[1], flayout);
  let out_match = literal_payloads(s, s.result, rnames[1], rlayout);
  let Some(good_shape) = good_match else {
    return refused(s, "try of a success variant that is not one payload");
  };
  let unit_good = good_shape.unit && good_shape.types.len() == 0;
  if (good_shape.types.len() != 1 && !unit_good) {
    return refused(s, "try of a success variant that is not one payload");
  }
  let Some(gone_shape) = gone_match else {
    return refused(s, "try failure is not a variant");
  };
  let Some(out_shape) = out_match else {
    return refused(s, "try failure is not a variant");
  };
  if (gone_shape.types.len() > 1 || gone_shape.types.len() != out_shape.types.len()) {
    return refused(s, "try failure does not match the body's result");
  }
  let convert = "";
  if (gone_shape.types.len() == 1 && !semtypes.equal(gone_shape.types[0], out_shape.types[0])) {
    convert = try_conversion(gone_shape.types[0], out_shape.types[0], s);
    if (convert == "") {
      return refused(s, "try failure does not match the body's result");
    }
  }

  let pred = s.cur.id;
  let good = s.next_block;
  let leave = good + 1;
  s = State { ...s, next_block: leave + 1 };
  let test = define(s, ssasem.variant_is(), [v.id], 0, fnames[0], typeinfo.t_bool());
  s = terminate(test.s, ssa.t_brif(test.id, good, leave));

  let entry = s;
  let gone = stmts(armed_cleanup(s), open(State { ...s, replaying: true }, leave, [pred]));
  if (!gone.ok) {
    return Value { s: gone, id: 0 };
  }
  let args: i32[] = [];
  if (gone_shape.types.len() == 1) {
    let carried = define(gone, ssasem.variant_get(), [v.id], 0, fnames[1], gone_shape.types[0]);
    if (convert == "dyn") {
      carried = widen(carried, out_shape.types[0]);
    }
    if (convert != "" && convert != "dyn") {
      carried = operator_method(carried.id, [], convert, carried.s);
    }
    gone = carried.s;
    if (!gone.ok) {
      return carried;
    }
    if (!semtypes.equal(gone.values[carried.id], out_shape.types[0])) {
      return refused(gone, "try failure does not match the body's result");
    }
    args = [carried.id];
  }
  let out = define(gone, ssasem.variant_new(), args, 0, rnames[1], s.result);
  s = terminate(out.s, ssa.t_ret(out.id));
  s = State { ...s, names: entry.names, vals: entry.vals, scope: entry.scope, replaying: entry.replaying };

  if (unit_good) {
    return define(open(s, good, [pred]), 1, [], 0, "", typeinfo.t_void());
  }
  return define(open(s, good, [pred]), ssasem.variant_get(), [v.id], 0, fnames[0], good_shape.types[0]);
}

function armed_cleanup(s: State): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for st in s.try_cleanup {
    if let ast.StmtIf(f) = st {
      if let ast.ExprIdent(id) = f.cond {
        if (parser.defer_flag(id.name) >= s.armed) {
          continue;
        }
      }
    }
    out = out.append(st);
  }
  return out;
}

function try_conversion(from: typeinfo.Type, to: typeinfo.Type, s: State): string {
  if (typeinfo.is_dyn(to)) {
    return "dyn";
  }
  let key = nominal_method_key("from", to, s);
  if (key == "") {
    return "";
  }
  let c = s.contracts.list[ssasem.find_contract(s.contracts, key)];
  if (c.params.len() != 1 || !semtypes.equal(c.params[0], from)) {
    return "";
  }
  return key;
}

function downcast(e: ast.Expr, u: ast.ExprUnary, s: State): Value {
  let v = expr(u.operand, s, typeinfo.unchecked());
  s = v.s;
  if (!s.ok) {
    return v;
  }
  if (ssasem.is_integer(s.values[v.id])) {
    return checked_int_cast(u, v, s);
  }
  if (!typeinfo.is_dyn(s.values[v.id])) {
    return refused(s, "downcast of a value that is not dyn");
  }
  let target = slice_unchecked(u.op, 4, u.op.len()).to_owned();
  let concrete = resolved(s.scope.resolve_type(target), s.template, s.binding, s.scope);
  if (struct_name(concrete) != target && typeinfo.union_name(concrete) != target) {
    return refused(s, "downcast target: " + target);
  }
  if (typeinfo.union_name(concrete) == target && union_layout(s, target) != semrecords.layout_variant() && union_layout(s, target) != semrecords.layout_member()) {
    return refused(s, "downcast to an enum whose box carries no shape: " + target);
  }
  let whole = ssasem.option_of(concrete);
  let layout = semrecords.layout_option();
  let names = variant_names(s, whole, layout);
  let Some(some) = literal_payloads(s, whole, names[0], layout) else {
    return refused(s, "downcast target: " + target);
  };

  let pred = s.cur.id;
  let hit = s.next_block;
  let miss = hit + 1;
  let join = hit + 2;
  s = State { ...s, next_block: join + 1 };
  let test = define(s, ssasem.dyn_is(), [v.id], 0, target, typeinfo.t_bool());
  s = terminate(test.s, ssa.t_brif(test.id, hit, miss));

  let narrowed = define(open(s, hit, [pred]), ssasem.dyn_as(), [v.id], 0, target, some.types[0]);
  let yes = define(narrowed.s, ssasem.variant_new(), [narrowed.id], 0, names[0], whole);
  let hit_end = yes.s.cur.id;
  s = terminate(yes.s, ssa.t_br(join));

  let no = define(open(s, miss, [pred]), ssasem.variant_new(), [], 0, names[1], whole);
  let miss_end = no.s.cur.id;
  s = terminate(no.s, ssa.t_br(join));
  return define(open(s, join, [hit_end, miss_end]), 8, [yes.id, no.id], 0, "", whole);
}

function checked_int_cast(u: ast.ExprUnary, v: Value, s: State): Value {
  let source = s.values[v.id];
  let target = resolved(s.scope.resolve_type(slice_unchecked(u.op, 4, u.op.len()).to_owned()), s.template, s.binding, s.scope);
  if (!ssasem.is_integer(target)) {
    return refused(s, "checked conversion to " + typeinfo.spelling(target));
  }
  let whole = ssasem.option_of(target);
  let names = variant_names(s, whole, semrecords.layout_option());
  let t = define(s, ssasem.cast(), [v.id], 0, "", target);
  let back = define(t.s, ssasem.cast(), [t.id], 0, "", source);
  let fits = define(back.s, ssa.BINARY, [back.id, v.id], 0, "==", typeinfo.t_bool());
  s = fits.s;
  let signed: i32 = -1;
  if (!ssasem.is_unsigned_int(source) && ssasem.is_unsigned_int(target)) {
    signed = v.id;
  }
  if (ssasem.is_unsigned_int(source) && !ssasem.is_unsigned_int(target)) {
    signed = t.id;
  }
  let pred = s.cur.id;
  let sign = s.next_block;
  let hit = sign;
  if (signed >= 0) {
    hit = sign + 1;
  }
  let miss = hit + 1;
  let join = hit + 2;
  s = State { ...s, next_block: join + 1 };
  let hit_pred = pred;
  let miss_preds: i32[] = [pred];
  if (signed < 0) {
    s = terminate(s, ssa.t_brif(fits.id, hit, miss));
  } else {
    s = terminate(s, ssa.t_brif(fits.id, sign, miss));
    let st = s.values[signed];
    let text = "";
    if (ssasem.text_constant(st)) {
      text = "0";
    }
    let zero = define(open(s, sign, [pred]), 1, [], 0, text, st);
    let nonneg = define(zero.s, ssa.BINARY, [signed, zero.id], 0, ">=", typeinfo.t_bool());
    hit_pred = nonneg.s.cur.id;
    miss_preds = miss_preds.append(hit_pred);
    s = terminate(nonneg.s, ssa.t_brif(nonneg.id, hit, miss));
  }
  let yes = define(open(s, hit, [hit_pred]), ssasem.variant_new(), [t.id], 0, names[0], whole);
  let hit_end = yes.s.cur.id;
  s = terminate(yes.s, ssa.t_br(join));
  let no = define(open(s, miss, miss_preds), ssasem.variant_new(), [], 0, names[1], whole);
  let miss_end = no.s.cur.id;
  s = terminate(no.s, ssa.t_br(join));
  return define(open(s, join, [hit_end, miss_end]), 8, [yes.id, no.id], 0, "", whole);
}

function try_layout(layout: i32): boolean {
  return layout == semrecords.layout_option() || layout == semrecords.layout_variant();
}

function type_detail(t: typeinfo.Type): string {
  if let typeinfo.TypeUnknown(u) = t {
    return u.reason;
  }
  return typeinfo.spelling(t);
}

function cast(e: ast.Expr, u: ast.ExprUnary, s: State): Value {
  let ty = checked(e, s);
  let ascribes = cast_ascribes(u, ty);
  let want = typeinfo.unchecked();
  if (ascribes) {
    want = ty;
  }
  let operand = expr(u.operand, s, want);
  s = operand.s;
  if (!s.ok) {
    return operand;
  }
  if (ascribes && semtypes.equal(s.values[operand.id], ty)) {
    return operand;
  }
  if (!ssasem.cast_admits(s.values[operand.id], ty)) {
    return refused(s, "cast contract: " + typeinfo.spelling(s.values[operand.id]) + " as " + typeinfo.spelling(ty));
  }
  return define(s, ssasem.cast(), [operand.id], 0, "", ty);
}

function cast_ascribes(u: ast.ExprUnary, ty: typeinfo.Type): boolean {
  if (!semtypes.concrete(ty, false)) {
    return false;
  }
  if (ssasem.cast_ascribes(ty)) {
    return true;
  }
  if let ast.ExprNumber(n) = u.operand {
    return !n.is_float && n.suffix == "" && ssasem.is_integer(ty) && !ssasem.is_usize(ty);
  }
  return false;
}

struct Cond { s: State, yes: i32[], no: i32[] }

function cond(e: ast.Expr, s: State, yes: i32, no: i32): Cond {
  if let ast.ExprBinary(b) = e {
    if (b.op == "&&" || b.op == "||") {
      let mid = s.next_block;
      s = State { ...s, next_block: mid + 1 };
      if (b.op == "&&") {
        let l = cond(b.left, s, mid, no);
        if (!l.s.ok) {
          return l;
        }
        let r = cond(b.right, open(l.s, mid, l.yes), yes, no);
        return Cond { s: r.s, yes: r.yes, no: concat_ids(l.no, r.no) };
      }
      let el = cond(b.left, s, yes, mid);
      if (!el.s.ok) {
        return el;
      }
      let er = cond(b.right, open(el.s, mid, el.no), yes, no);
      return Cond { s: er.s, yes: concat_ids(el.yes, er.yes), no: er.no };
    }
  }
  if let ast.ExprUnary(u) = e {
    if (u.op == "!") {
      let n = cond(u.operand, s, no, yes);
      return Cond { s: n.s, yes: n.no, no: n.yes };
    }
  }
  let v = expr(e, s, typeinfo.t_bool());
  s = v.s;
  if (!s.ok) {
    return Cond { s: s, yes: [], no: [] };
  }
  if (!is_bool(s.values[v.id])) {
    return Cond { s: fail(s, "condition type"), yes: [], no: [] };
  }
  let at = s.cur.id;
  return Cond { s: terminate(s, ssa.t_brif(v.id, yes, no)), yes: [at], no: [at] };
}

function concat_ids(a: i32[], b: i32[]): i32[] {
  let out = a;
  for x in b {
    out = out.append(x);
  }
  return out;
}

function logical(b: ast.ExprBinary, s: State, types: checker.OperatorTypes): Value {
  let left = operand(b.left, s, typeinfo.t_bool(), operand_types(types, 0));
  s = left.s;
  if (!s.ok) {
    return left;
  }
  if (!is_bool(s.values[left.id])) {
    return refused(s, "operator contract");
  }
  let pred = s.cur.id;
  let rhs = s.next_block;
  let skip = rhs + 1;
  let join = rhs + 2;
  s = State { ...s, next_block: join + 1 };
  if (b.op == "&&") {
    s = terminate(s, ssa.t_brif(left.id, rhs, skip));
  } else {
    s = terminate(s, ssa.t_brif(left.id, skip, rhs));
  }
  let right = operand(b.right, open(s, rhs, [pred]), typeinfo.t_bool(), operand_types(types, 1));
  s = right.s;
  if (!s.ok) {
    return right;
  }
  if (!is_bool(s.values[right.id])) {
    return refused(s, "operator contract");
  }
  let rhs_end = s.cur.id;
  s = terminate(s, ssa.t_br(join));
  let short = define(open(s, skip, [pred]), 2, [], util.bool_i32(b.op == "||"), "", typeinfo.t_bool());
  s = terminate(short.s, ssa.t_br(join));
  return define(open(s, join, [rhs_end, skip]), 8, [right.id, short.id], 0, "", typeinfo.t_bool());
}

function builtin_length(recv: i32, s: State): Value {
  let t = s.values[recv];
  let sized = ssasem.is_text(t);
  if let typeinfo.TypeArray(_) = t {
    sized = true;
  }
  if (!sized) {
    return refused(s, "unsupported call target");
  }
  return define(s, ssasem.length(), [recv], 0, "", typeinfo.t_i32());
}

function builtin_append(c: ast.ExprCall, recv: i32, s: State): Value {
  let t = s.values[recv];
  let elem = typeinfo.array_elem(t);
  if (!semtypes.concrete(elem, false)) {
    return refused(s, "unsupported call target");
  }
  let v = expr(c.args[0], s, elem);
  s = v.s;
  if (!s.ok) {
    return v;
  }
  if (!semtypes.equal(s.values[v.id], elem)) {
    return refused(s, "append element type");
  }
  v = kept_view(unaliased_view(v));
  return define(v.s, ssasem.append(), [recv, v.id], 0, "", t);
}

function builtin_with(c: ast.ExprCall, recv: i32, s: State): Value {
  let t = s.values[recv];
  let elem = typeinfo.array_elem(t);
  if (!semtypes.concrete(elem, false)) {
    return refused(s, "unsupported call target");
  }
  let at = expr(c.args[0], s, typeinfo.t_i32());
  s = at.s;
  if (!s.ok) {
    return at;
  }
  if (!semtypes.equal(s.values[at.id], typeinfo.t_i32())) {
    return refused(s, "with index type");
  }
  let v = expr(c.args[1], s, elem);
  s = v.s;
  if (!s.ok) {
    return v;
  }
  if (!semtypes.equal(s.values[v.id], elem)) {
    return refused(s, "with element type");
  }
  v = kept_view(unaliased_view(v));
  return define(v.s, ssasem.with(), [recv, at.id, v.id], 0, "", t);
}

function builtin_truncate(c: ast.ExprCall, recv: i32, s: State): Value {
  let t = s.values[recv];
  if (!semtypes.concrete(typeinfo.array_elem(t), false)) {
    return refused(s, "unsupported call target");
  }
  let n = expr(c.args[0], s, typeinfo.t_i32());
  if (!n.s.ok) {
    return n;
  }
  if (!semtypes.equal(n.s.values[n.id], typeinfo.t_i32())) {
    return refused(n.s, "truncate length type");
  }
  return define(n.s, ssasem.truncate(), [recv, n.id], 0, "", t);
}

function is_string_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return ssasem.is_string(a.elem);
  }
  return false;
}

function concat_kernel(name: string, c: ast.ExprCall, s: State): boolean {
  if (c.args.len() != 2 || !name.starts_with("__arrm_concat__")) {
    return false;
  }
  let t = checked(c.args[0], s);
  if let typeinfo.TypeArray(a) = t {
    return !a.view && !ssasem.reference(a.elem) && semtypes.concrete(a.elem, false) && ssasem.same_elements(checked(c.args[1], s), t);
  }
  return false;
}

// The second operand is an array or a view of one; a view is read in place.
function builtin_concat(c: ast.ExprCall, s: State): Value {
  let t = checked(c.args[0], s);
  let a = expr(c.args[0], s, t);
  if (!a.s.ok) {
    return a;
  }
  let tb = checked(c.args[1], s);
  let b = expr(c.args[1], a.s, tb);
  s = b.s;
  if (!s.ok) {
    return b;
  }
  if (!semtypes.equal(s.values[a.id], t) || !ssasem.same_elements(s.values[b.id], t)) {
    return refused(s, "concat operand type");
  }
  return define(s, ssasem.arr_concat(), [a.id, b.id], 0, "", t);
}

function join_kernel(name: string, c: ast.ExprCall, s: State): boolean {
  if (c.args.len() != 2 || name != parser.concrete_array_method_name("string[]", "join") || !is_string_array(checked(c.args[0], s))) {
    return false;
  }
  return match (s.scope.lookup_sig(name)) { Some(sig) => sig.module == util.mangle_prefix("array"), None => false };
}

function folded_join(c: ast.ExprCall, s: State): Value {
  let xs = expr(c.args[0], s, checked(c.args[0], s));
  if (!xs.s.ok) {
    return xs;
  }
  return builtin_join(ast.ExprCall { ...c, args: [c.args[1]] }, xs.id, xs.s);
}

function builtin_join(c: ast.ExprCall, recv: i32, s: State): Value {
  let sep = expr(c.args[0], s, typeinfo.t_string());
  s = sep.s;
  if (!s.ok) {
    return sep;
  }
  if (!ssasem.is_text(s.values[sep.id])) {
    return refused(s, "join separator type");
  }
  return define(s, ssasem.arr_join(), [recv, sep.id], 0, "", typeinfo.t_string());
}

function cell_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: i32, s: State, statement: boolean): Value {
  let elem = semtypes.cell_elem(s.values[recv]);
  if (fa.field == "get" && c.args.len() == 0) {
    return define(s, ssasem.cell_get(), [recv], 0, "", elem);
  }
  if (fa.field != "set" || c.args.len() != 1) {
    return refused(s, "unsupported call target");
  }
  if (!statement) {
    return refused(s, "unsupported void call");
  }
  let v = expr(c.args[0], s, elem);
  s = v.s;
  if (!s.ok) {
    return v;
  }
  if (ssasem.is_view(s.values[v.id])) {
    return refused(s, "view element escapes its source");
  }
  if (!semtypes.equal(s.values[v.id], elem)) {
    return refused(s, "cell element type");
  }
  return define(s, ssasem.cell_set(), [recv, v.id], 0, "", typeinfo.t_void());
}

function map_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: i32, s: State): Value {
  let t = s.values[recv];
  if (!ssasem.is_supported_map(t)) {
    return refused(s, "unsupported map shape: " + typeinfo.spelling(t));
  }
  if (fa.field == "len" && c.args.len() == 0) {
    return define(s, ssasem.map_len(), [recv], 0, "", typeinfo.t_i32());
  }
  if ((fa.field == "insert" || fa.field == "set") && c.args.len() == 2) {
    return map_write(c, recv, s, t);
  }
  if (fa.field == "contains" && c.args.len() == 1) {
    return map_read(c, recv, s, t, ssasem.map_has(), typeinfo.t_bool());
  }
  if (fa.field == "get_or" && c.args.len() == 2) {
    return map_read(c, recv, s, t, ssasem.map_get_or(), ssasem.map_value(t));
  }
  if (fa.field == "get" && c.args.len() == 1) {
    return map_read(c, recv, s, t, ssasem.map_get(), ssasem.option_of(ssasem.map_value(t)));
  }
  if (fa.field == "keys" && c.args.len() == 0) {
    return map_column(s, recv, ssasem.map_keys(), ssasem.map_key(t));
  }
  if (fa.field == "values" && c.args.len() == 0) {
    return map_column(s, recv, ssasem.map_values(), ssasem.map_value(t));
  }
  if (fa.field == "remove" && c.args.len() == 1) {
    return map_delete(c, recv, s, t);
  }
  if (fa.field == "cleared" && c.args.len() == 0) {
    return define(s, ssasem.map_cleared(), [], 0, "", t);
  }
  return refused(s, "unsupported call target: " + typeinfo.spelling(t) + "." + fa.field);
}

function map_delete(c: ast.ExprCall, recv: i32, s: State, t: typeinfo.Type): Value {
  let k = map_key_value(c.args[0], s, t, false);
  s = k.s;
  if (!s.ok) {
    return k;
  }
  return define(s, ssasem.map_delete(), [recv, k.id], 0, "", t);
}

function map_column(s: State, recv: i32, kind: i32, elem: typeinfo.Type): Value {
  if (!ssasem.retained_column(elem)) {
    return refused(s, "aliased column element: " + typeinfo.spelling(elem));
  }
  return define(s, kind, [recv], 0, "", typeinfo.TypeArray { elem: elem, view: false });
}

function map_key_value(e: ast.Expr, s: State, t: typeinfo.Type, stored: boolean): Value {
  let column = ssasem.map_key(t);
  let k = expr(e, s, column);
  if (!k.s.ok) {
    return k;
  }
  if (!stored) {
    k = lend(k, column, ssaunits.borrow_mode(), false);
  }
  if (ssasem.is_view(k.s.values[k.id])) {
    if (!ssasem.is_view(column)) {
      return refused(k.s, "view element escapes its source");
    }
    if (stored) {
      k = lend(k, typeinfo.t_string(), ssaunits.borrow_mode(), true);
    }
    return k;
  }
  if (ssasem.is_view(column) && ssasem.is_string(k.s.values[k.id])) {
    return k;
  }
  if (!semtypes.equal(k.s.values[k.id], column)) {
    return refused(k.s, "map key type");
  }
  return k;
}

function map_write(c: ast.ExprCall, recv: i32, s: State, t: typeinfo.Type): Value {
  let k = map_key_value(c.args[0], s, t, true);
  s = k.s;
  if (!s.ok) {
    return k;
  }
  let v = expr(c.args[1], s, ssasem.map_value(t));
  s = v.s;
  if (!s.ok) {
    return v;
  }
  if (!semtypes.equal(s.values[v.id], ssasem.map_value(t))) {
    return refused(s, "map value type");
  }
  v = kept_view(unaliased_view(v));
  return define(v.s, ssasem.map_insert(), [recv, k.id, v.id], 0, "", t);
}

function map_read(c: ast.ExprCall, recv: i32, s: State, t: typeinfo.Type, kind: i32, result: typeinfo.Type): Value {
  let k = map_key_value(c.args[0], s, t, false);
  s = k.s;
  if (!s.ok) {
    return k;
  }
  let ids: i32[] = [recv, k.id];
  if (c.args.len() == 2) {
    let d = expr(c.args[1], s, ssasem.map_value(t));
    s = d.s;
    if (!s.ok) {
      return d;
    }
    if (!semtypes.equal(s.values[d.id], ssasem.map_value(t))) {
      return refused(s, "map value type");
    }
    ids = ids.append(d.id);
  }
  return define(s, kind, ids, 0, "", result);
}

function array_method_prefix(t: typeinfo.Type): string {
  if let typeinfo.TypeArray(a) = t {
    if (a.view) {
      return "__viewm_";
    }
    return "__arrm_";
  }
  return "";
}

// array_method_contract finds the contract of an array or a slice method:
// the instance for the element type first, then the generic fold.
function array_method_contract(receiver: typeinfo.Type, field: string, contracts: ssasem.Contracts): i32 {
  let at = ssasem.find_contract(contracts, parser.concrete_array_method_name(typeinfo.spelling(receiver), field));
  if (at < 0) {
    at = ssasem.find_contract(contracts, array_method_prefix(receiver) + field);
  }
  return at;
}

function folded_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: i32, s: State, statement: boolean): Value {
  if (c.type_args.len() > 0) {
    return refused(s, "unsupported call target");
  }
  let receiver_type = checked(fa.obj, s);
  let prefix = array_method_prefix(receiver_type);
  if (ssasem.is_map(s.values[recv])) {
    prefix = "__mapm_";
  }
  if (prefix == "") {
    return primitive_method(c, fa, recv, s, statement);
  }
  let at = array_method_contract(receiver_type, fa.field, s.contracts);
  if (prefix == "__mapm_") {
    at = ssasem.find_contract(s.contracts, prefix + fa.field);
  }
  if (at < 0) {
    return primitive_method(c, fa, recv, s, statement);
  }
  let contract = s.contracts.list[at];
  if (c.args.len() + 1 != contract.params.len()) {
    return refused(s, "call arity");
  }
  if (typeinfo.is_void(contract.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  return invoke_method(recv, c.args, contract, s, written_binding(c, contract, s), ssasem.unbound());
}

function primitive_contract(c: ast.ExprCall, fa: ast.ExprFieldAccess, owner: string, contracts: ssasem.Contracts, scope: checker.Scope): i32 {
  let at = ssasem.find_contract(contracts, owner + "." + fa.field);
  if (at >= 0) {
    if let None = scope.visible_method(fa.field, owner) {
      at = -1;
    }
  }
  if (at < 0 && fa.field == "to_string" && c.args.len() == 0) {
    at = ssasem.find_contract(contracts, "__primitive_" + owner + "_to_string");
  }
  return at;
}

function missing_string_display(at: i32, owner: string, c: ast.ExprCall, fa: ast.ExprFieldAccess): boolean {
  return at < 0 && owner == "string" && fa.field == "to_string" && c.args.len() == 0;
}

function primitive_text_fallback(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: i32, s: State): Value {
  if (ssasem.is_string(s.values[recv]) && fa.field == "to_string" && c.args.len() == 0) {
    return Value { s: s, id: recv };
  }
  if (ssasem.is_bool(s.values[recv]) && fa.field == "to_string" && c.args.len() == 0) {
    return boolean_text(recv, s);
  }
  return refused(s, "unsupported call target");
}

function primitive_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: i32, s: State, statement: boolean): Value {
  let owner = parser.receiver_base(typeinfo.spelling(s.values[recv]));
  if (owner == "str") {
    owner = "string";
  }
  if (owner.len() == 0) {
    return refused(s, "unsupported call target");
  }
  let at = primitive_contract(c, fa, owner, s.contracts, s.scope);
  if (at < 0) {
    return primitive_text_fallback(c, fa, recv, s);
  }
  let contract = s.contracts.list[at];
  if (c.args.len() + 1 != contract.params.len()) {
    return refused(s, "call arity");
  }
  if (typeinfo.is_void(contract.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  return invoke_method(recv, c.args, contract, s, written_binding(c, contract, s), ssasem.unbound());
}

function boolean_text(recv: i32, s: State): Value {
  let pred = s.cur.id;
  let yes = s.next_block;
  let no = yes + 1;
  let join = yes + 2;
  s = State { ...s, next_block: join + 1 };
  s = terminate(s, ssa.t_brif(recv, yes, no));
  let t = define(open(s, yes, [pred]), 5, [], 0, "true", typeinfo.t_string());
  s = terminate(t.s, ssa.t_br(join));
  let f = define(open(s, no, [pred]), 5, [], 0, "false", typeinfo.t_string());
  s = terminate(f.s, ssa.t_br(join));
  return define(open(s, join, [yes, no]), 8, [t.id, f.id], 0, "", typeinfo.t_string());
}

function builtin_call(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: i32, s: State, statement: boolean): Value {
  if (c.type_args.len() > 0) {
    return refused(s, "unsupported call target");
  }
  if (typeinfo.is_cell(s.values[recv])) {
    return cell_method(c, fa, recv, s, statement);
  }
  if (ssasem.is_map(s.values[recv])) {
    return map_method(c, fa, recv, s);
  }
  if (fa.field == "len" && c.args.len() == 0) {
    return builtin_length(recv, s);
  }
  if ((fa.field == "bytes" || fa.field == "as_bytes") && c.args.len() == 0 && ssasem.is_text(s.values[recv])) {
    if (fa.field == "as_bytes") {
      return define(s, ssasem.str_byte_view(), [recv], 0, "", typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true });
    }
    return define(s, ssasem.str_bytes(), [recv], 0, "", typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false });
  }
  if (fa.field == "append" && c.args.len() == 1) {
    return builtin_append(c, recv, s);
  }
  if (fa.field == "with" && c.args.len() == 2) {
    return builtin_with(c, recv, s);
  }
  if (fa.field == "truncate" && c.args.len() == 1) {
    return builtin_truncate(c, recv, s);
  }
  if (fa.field == "join" && c.args.len() == 1 && is_string_array(s.values[recv])) {
    return builtin_join(c, recv, s);
  }
  return refused(s, "unsupported call target: " + typeinfo.spelling(s.values[recv]) + "." + fa.field);
}

function tuple_index(field: string, n: i32): i32 {
  if (field.len() == 0 || field.len() > 4) {
    return -1;
  }
  let at = 0;
  for i in 0..field.len() {
    let d = field[i] as i32 - 48;
    if (d < 0 || d > 9) {
      return -1;
    }
    at = at * 10 + d;
  }
  if (at >= n) {
    return -1;
  }
  return at;
}

function method_call(c: ast.ExprCall, fa: ast.ExprFieldAccess, s: State, statement: boolean, expected: typeinfo.Type): Value {
  let want = typeinfo.unchecked();
  if (fa.field == "insert" || fa.field == "set") {
    if (ssasem.is_map(expected)) {
      want = expected;
    } else if (ssasem.is_map(checked(c, s))) {
      want = checked(c, s);
    }
  }
  let produced = expr(fa.obj, s, want);
  s = produced.s;
  if (!s.ok) {
    return produced;
  }
  let recv = produced.id;
  if (typeinfo.is_dyn(s.values[recv])) {
    return dyn_method(c, fa, recv, s, statement);
  }
  let owner = method_owner(s.values[recv]);
  if let Some(fsig) = record_sig(s.values[recv], s) {
    let fat = util.index_of_str(fsig.field_names, fa.field);
    if (fat >= 0 && ssasem.is_func(fsig.field_types[fat])) {
      let fv = field_read(s, recv, fat, fa.field, fsig.field_types[fat]);
      if (!fv.s.ok) {
        return fv;
      }
      return indirect_call(c, fv.id, fv.s, statement);
    }
  }
  if let typeinfo.TypeTuple(tup) = s.values[recv] {
    let tat = tuple_index(fa.field, tup.elements.len());
    if (tat >= 0 && ssasem.is_func(tup.elements[tat])) {
      let tv = define(s, ssasem.tuple_get(), [recv], tat, "", tup.elements[tat]);
      if (!tv.s.ok) {
        return tv;
      }
      return indirect_call(c, tv.id, tv.s, statement);
    }
  }
  if (owner == "" && (fa.field == "len" || fa.field == "append" || fa.field == "bytes" || fa.field == "as_bytes" || !ssasem.is_text(s.values[recv]))) {
    let before = s.values.len();
    let b = builtin_call(c, fa, recv, s, statement);
    if (b.s.ok || b.s.values.len() != before) {
      return b;
    }
    let why = b.s.why;
    let folded = folded_method(c, fa, recv, retried(b.s), statement);
    if (folded.s.ok) {
      return folded;
    }
    return Value { s: State { ...folded.s, why: why }, id: -1 };
  }
  if (owner == "") {
    owner = "string";
  }
  let key = owner + "." + fa.field;
  let at = ssasem.find_contract(s.contracts, key);
  if (missing_string_display(at, owner, c, fa)) {
    return primitive_method(c, fa, recv, s, statement);
  }
  if (at < 0) {
    return refused(s, "call target has no semantic contract: " + key);
  }
  let contract = s.contracts.list[at];
  if (c.args.len() + 1 != contract.params.len()) {
    return refused(s, "call arity");
  }
  if (typeinfo.is_void(contract.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  if (ssasem.contract_variables(contract).len() > 0) {
    return invoke_method(recv, c.args, contract, s, written_binding(c, contract, s), destination_binding(contract, expected));
  }
  let lent = lend(widen(Value { s: s, id: recv }, contract.params[0]), contract.params[0], contract.modes[0], keeps(s, contract, 0));
  s = lent.s;
  recv = lent.id;
  if (!semtypes.equal(s.values[recv], contract.params[0])) {
    return refused(s, "call receiver type");
  }
  let ids: i32[] = [recv];
  for i in 0..c.args.len() {
    let v = lend(expr(c.args[i], s, contract.params[i + 1]), contract.params[i + 1], contract.modes[i + 1], keeps(s, contract, i + 1));
    s = v.s;
    if (!s.ok) {
      return v;
    }
    if (!semtypes.equal(s.values[v.id], contract.params[i + 1])) {
      return refused(s, "call argument type");
    }
    ids = ids.append(v.id);
  }
  if (ssasem.find_contract_in(s.calls, key) < 0) {
    s = State { ...s, calls: s.calls.append(contract) };
  }
  return define(s, ssasem.call(), ids, 0, key, contract.result);
}

function dyn_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: i32, s: State, statement: boolean): Value {
  let receiver = s.values[recv];
  let traits = parser.dyn_trait_set(typeinfo.spelling(receiver));
  let arms = dyn_arms(s.funcs, s.impls, fa.field, traits);
  if (arms.len() == 0 && !any_implementer(s.impls, traits)) {
    let ty = checked(c, s);
    if (statement) {
      ty = typeinfo.t_void();
    }
    return unreachable_value(terminate(s, ssa.t_unreachable()), ty);
  }
  if (arms.len() == 0) {
    return refused(s, "dyn method has no implementation: " + fa.field);
  }
  let shape = ssasem.Contract { name: "", params: [], modes: [], result: typeinfo.t_void() };
  for arm in arms {
    let at = ssasem.find_contract(s.contracts, arm);
    if (at < 0) {
      return refused(s, "dyn method implementation has no semantic contract: " + arm);
    }
    let why = dyn_arm_error(s.contracts.list[at], shape);
    if (why != "") {
      return refused(s, why + ": " + arm);
    }
    if (shape.name == "") {
      shape = s.contracts.list[at];
    }
  }
  if (c.args.len() + 1 != shape.params.len()) {
    return refused(s, "call arity");
  }
  if (typeinfo.is_void(shape.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  let params: typeinfo.Type[] = [receiver];
  let modes: i32[] = [ssaunits.borrow_mode()];
  let i = 1;
  while (i < shape.params.len()) {
    params = params.append(shape.params[i]);
    modes = modes.append(shape.modes[i]);
    i += 1;
  }
  let contract = ssasem.Contract { name: ssasem.dyn_call_name(fa.field, traits, arms), params: params, modes: modes, result: shape.result };
  let ids: i32[] = [recv];
  for i in 0..c.args.len() {
    let v = lend(expr(c.args[i], s, params[i + 1]), params[i + 1], modes[i + 1], true);
    s = v.s;
    if (!s.ok) {
      return v;
    }
    if (!semtypes.equal(s.values[v.id], params[i + 1])) {
      return refused(s, "call argument type");
    }
    ids = ids.append(v.id);
  }
  let run: i32[] = [];
  for id in ids {
    let cp = define(s, ssa.COPY, [id], 0, "", s.values[id]);
    s = cp.s;
    run = run.append(cp.id);
  }
  if (ssasem.find_contract_in(s.calls, contract.name) < 0) {
    s = State { ...s, calls: s.calls.append(contract) };
  }
  return define(s, ssasem.call(), run, 0, contract.name, contract.result);
}

function dyn_arm_error(c: ssasem.Contract, first: ssasem.Contract): string {
  if (ssasem.contract_variables(c).len() > 0) {
    return "dyn method implementation is generic";
  }
  if (c.params.len() == 0) {
    return "dyn method implementation takes no receiver";
  }
  for m in c.modes {
    if (m == ssaunits.counted_mode()) {
      return "dyn method implementation consumes an operand";
    }
  }
  if (first.name == "") {
    return "";
  }
  if (c.params.len() != first.params.len() || !semtypes.equal(c.result, first.result)) {
    return "dyn method implementations disagree";
  }
  for i in 1..c.params.len() {
    if (!semtypes.equal(c.params[i], first.params[i]) || c.modes[i] != first.modes[i]) {
      return "dyn method implementations disagree";
    }
  }
  return "";
}

function cell_construction(c: ast.ExprCall, s: State, expected: typeinfo.Type): Value {
  let v = expr(c.args[0], s, semtypes.cell_elem(expected));
  s = v.s;
  if (!s.ok) {
    return v;
  }
  let elem = s.values[v.id];
  if (!semtypes.concrete(elem, false)) {
    return refused(s, "unresolved cell element type");
  }
  if (ssasem.is_view(elem)) {
    return refused(s, "view element escapes its source");
  }
  return define(s, ssasem.cell_new(), [v.id], 0, "", typeinfo.TypeStruct { name: "Cell", args: [elem] });
}

function map_construction(e: ast.Expr, c: ast.ExprCall, s: State, expected: typeinfo.Type): Value {
  if (!ssasem.is_map(expected)) {
    expected = checked(e, s);
  }
  if (!ssasem.is_supported_map(expected)) {
    if (!ssasem.is_map(expected)) {
      return refused(s, "unsupported map shape: no destination names one");
    }
    if (typeinfo.spelling(expected).len() == 0) {
      return refused(s, "unsupported map shape: columns unresolved");
    }
    return refused(s, "unsupported map shape: " + typeinfo.spelling(expected));
  }
  let cap = expr(c.args[0], s, typeinfo.t_i32());
  s = cap.s;
  if (!s.ok) {
    return cap;
  }
  if (!is_i32(s.values[cap.id])) {
    return refused(s, "map capacity type");
  }
  return define(s, ssasem.map_new(), [cap.id], 0, "", expected);
}

function string_slice(c: ast.ExprCall, s: State): Value {
  let p = slice_parts(c, s);
  if (!p.hi.s.ok) {
    return p.hi;
  }
  return define(p.hi.s, ssasem.slice(), [p.src, p.lo, p.hi.id], 0, "", typeinfo.t_str());
}

struct SliceParts { src: i32, lo: i32, hi: Value }

function slice_parts(c: ast.ExprCall, s: State): SliceParts {
  let src = expr(c.args[0], s, typeinfo.unchecked());
  s = src.s;
  if (!s.ok) {
    return SliceParts { src: -1, lo: -1, hi: src };
  }
  if (!ssasem.is_text(s.values[src.id])) {
    return SliceParts { src: -1, lo: -1, hi: refused(s, "unsupported call target") };
  }
  let lo = expr(c.args[1], s, typeinfo.t_i32());
  s = lo.s;
  if (!s.ok) {
    return SliceParts { src: -1, lo: -1, hi: lo };
  }
  let hi = expr(c.args[2], s, typeinfo.t_i32());
  s = hi.s;
  if (!s.ok) {
    return SliceParts { src: -1, lo: -1, hi: hi };
  }
  if (!is_i32(s.values[lo.id]) || !is_i32(s.values[hi.id])) {
    return SliceParts { src: -1, lo: -1, hi: refused(s, "slice bound type") };
  }
  return SliceParts { src: src.id, lo: lo.id, hi: hi };
}

function range_append(left: i32, c: ast.ExprCall, s: State): Value {
  let p = slice_parts(c, s);
  if (!p.hi.s.ok) {
    return p.hi;
  }
  return define(p.hi.s, ssasem.append_range(), [left, p.src, p.lo, p.hi.id], 0, "", typeinfo.t_string());
}

function builtin_slice(e: ast.Expr, s: State): Option[ast.ExprCall] {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (lookup(s, id.name) < 0 && is_slice_call(id.name, c)) {
        return Some(c);
      }
    }
  }
  return None;
}

function lend(v: Value, param: typeinfo.Type, m: i32, kept: boolean): Value {
  let s = v.s;
  if (!s.ok || m != ssaunits.borrow_mode()) {
    return v;
  }
  if (!ssasem.is_view(s.values[v.id]) || !ssasem.is_string(param)) {
    return v;
  }
  if (!kept) {
    return define(s, ssasem.str_as(), [v.id], 0, "", param);
  }
  let empty = define(s, ssa.CONST_STR, [], 0, "", param);
  return define(empty.s, ssa.BINARY, [v.id, empty.id], 0, "+", param);
}

// True if the callee can hand back its parameter `at` in its result.
function keeps(s: State, contract: ssasem.Contract, at: i32): boolean {
  // A scalar result cannot contain a borrowed string. Method names alone
  // can mark an unrelated scalar reader as a function that returns a borrow.
  let t = contract.result;
  if (ssasem.is_integer(t) || ssasem.is_bool(t) || ssasem.is_float(t)) {
    return false;
  }
  return (s.handers.mask(contract.name) & param_bit(at)) != 0;
}

function indirect_call(c: ast.ExprCall, callee: i32, s: State, statement: boolean): Value {
  let params = ssasem.func_params(s.values[callee]);
  let result = ssasem.func_result(s.values[callee]);
  if (c.args.len() != params.len()) {
    return refused(s, "call arity");
  }
  if (typeinfo.is_void(result) && !statement) {
    return refused(s, "unsupported void call");
  }
  let ids: i32[] = [callee];
  for i in 0..c.args.len() {
    let v = lend(expr(c.args[i], s, params[i]), params[i], ssaunits.borrow_mode(), true);
    s = v.s;
    if (!s.ok) {
      return v;
    }
    if (!semtypes.equal(s.values[v.id], params[i])) {
      return refused(s, "call argument type");
    }
    ids = ids.append(v.id);
  }
  return define(s, ssasem.call_value(), ids, 0, "", result);
}

function bound_call(c: ast.ExprCall, bound: i32, s: State, statement: boolean): Value {
  if (ssasem.is_func(s.values[bound])) {
    return indirect_call(c, bound, s, statement);
  }
  return refused(s, "unsupported call target");
}

function value_block(e: ast.Expr, c: ast.ExprCall, s: State, expected: typeinfo.Type): Value {
  let ty = block_type(e, c, s, expected);
  let body = parser.vb_body(c);
  if (body.len() == 0) {
    return refused(s, "unsupported value block: no statements");
  }
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "unsupported value block: type " + typeinfo.spelling(ty));
  }
  let count = s.names.len();
  let scope = s.scope;
  for i in 0..body.len() - 1 {
    s = stmt(body[i], s);
  }
  if (!s.ok) {
    return Value { s: s, id: -1 };
  }
  if (!s.live) {
    let z = unreachable_value(s, ty);
    return Value { s: leave(z.s, count, scope), id: z.id };
  }
  let last = body[body.len() - 1];
  let v = refused(s, "unsupported value block: " + block_stmt_kind(last));
  if let ast.StmtIf(_) = last {
    v = arm_value(last, s, ty);
  }
  if let ast.StmtMatch(m) = last {
    v = value_match(m, s, ty);
  }
  if let ast.StmtReturn(_) = last {
    v = arm_value(last, s, ty);
  }
  if (!v.s.ok) {
    return v;
  }
  return Value { s: leave(v.s, count, scope), id: v.id };
}

function unreachable_value(s: State, ty: typeinfo.Type): Value {
  let dead = s.next_block;
  s = open(State { ...s, next_block: dead + 1 }, dead, []);
  return define(s, ssasem.zero(), [], 0, "", ty);
}

function block_type(e: ast.Expr, c: ast.ExprCall, s: State, expected: typeinfo.Type): typeinfo.Type {
  if (semtypes.concrete(expected, false)) {
    return expected;
  }
  let ty = checked(e, s);
  if (semtypes.concrete(ty, false)) {
    return ty;
  }
  if let ast.ExprLambda(lam) = c.callee {
    if (lam.ret_type.len() > 0) {
      return resolved(s.scope.resolve_type(lam.ret_type), s.template, s.binding, s.scope);
    }
  }
  return ty;
}

function block_stmt_kind(st: ast.Stmt): string {
  match (st) {
    ast.StmtReturn(_) => {
      return "return";
    },
    ast.StmtMatch(_) => {
      return "match";
    },
    ast.StmtVar(_) => {
      return "let";
    },
    ast.StmtExpr(_) => {
      return "expression";
    },
    ast.StmtWhile(_) => {
      return "while";
    },
    ast.StmtFor(_) => {
      return "for";
    },
    _ => {
      return "other";
    }
  }
}

struct VArm { s: State, live: boolean, end: i32, env: i32[], value: i32 }

function arm_value(st: ast.Stmt, s: State, ty: typeinfo.Type): Value {
  if let ast.StmtIf(f) = st {
    if (f.origin == "block" || f.origin == "unsafe") {
      return block_arm_value(f.then_body, s, ty);
    }
    return value_if(f, s, ty);
  }
  if let ast.StmtReturn(r) = st {
    if (parser.bare_return(r.value)) {
      return refused(s, "value block arm has no value");
    }
    let v = widen(expr(r.value, s, ty), ty);
    if (!v.s.ok) {
      return v;
    }
    if (!semtypes.equal(v.s.values[v.id], ty)) {
      return refused(v.s, "value block arm type");
    }
    return unaliased_view(v);
  }
  return refused(s, "value block arm has no value");
}

// A block that ends a value arm is a scope around the arm's value, not a branch.
function block_arm_value(body: ast.Stmt[], s: State, ty: typeinfo.Type): Value {
  if (body.len() == 0) {
    return refused(s, "value block arm has no value");
  }
  let count = s.names.len();
  let scope = s.scope;
  let last_at = body.len() - 1;
  for i in 0..last_at {
    s = stmt(body[i], s);
  }
  if (!s.ok) {
    return Value { s: s, id: -1 };
  }
  if (!s.live) {
    let z = unreachable_value(s, ty);
    return Value { s: leave(z.s, count, scope), id: z.id };
  }
  let v = arm_value(body[last_at], s, ty);
  if (!v.s.ok) {
    return v;
  }
  return Value { s: leave(v.s, count, scope), id: v.id };
}

function value_arm(body: ast.Stmt[], s: State, entry: i32[], id: i32, preds: i32[], join: i32, count: i32, scope: checker.Scope, ty: typeinfo.Type): VArm {
  s = open(State { ...s, vals: entry }, id, preds);
  let none = VArm { s: s, live: false, end: 0, env: [], value: -1 };
  if (body.len() == 0) {
    return VArm { ...none, s: fail(s, "value block arm has no value") };
  }
  for i in 0..body.len() - 1 {
    s = stmt(body[i], s);
  }
  if (!s.ok) {
    return VArm { ...none, s: s };
  }
  if (!s.live) {
    return VArm { ...none, s: leave(s, count, scope) };
  }
  let v = arm_value(body[body.len() - 1], s, ty);
  s = v.s;
  if (!s.ok) {
    return VArm { ...none, s: s };
  }
  let end = s.cur.id;
  let env = prefix(s.vals, count);
  s = terminate(s, ssa.t_br(join));
  return VArm { s: leave(s, count, scope), live: true, end: end, env: env, value: v.id };
}

function value_if(f: ast.StmtIf, s: State, ty: typeinfo.Type): Value {
  let then_id = s.next_block;
  let else_id = then_id + 1;
  let join = then_id + 2;
  s = State { ...s, next_block: join + 1 };
  let count = s.names.len();
  let entry = s.vals;
  let scope = s.scope;
  let c = cond(f.cond, s, then_id, else_id);
  s = c.s;
  if (!s.ok) {
    return Value { s: s, id: -1 };
  }
  let t = value_arm(f.then_body, s, entry, then_id, c.yes, join, count, scope, ty);
  if (!t.s.ok) {
    return Value { s: t.s, id: -1 };
  }
  let el = value_arm(f.else_body, t.s, entry, else_id, c.no, join, count, scope, ty);
  if (!el.s.ok) {
    return Value { s: el.s, id: -1 };
  }
  let preds: i32[] = [];
  let envs: i32[][] = [];
  let values: i32[] = [];
  if (t.live) {
    preds = preds.append(t.end);
    envs = envs.append(t.env);
    values = values.append(t.value);
  }
  if (el.live) {
    preds = preds.append(el.end);
    envs = envs.append(el.env);
    values = values.append(el.value);
  }
  if (preds.len() == 0) {
    return unreachable_value(el.s, ty);
  }
  s = merge_env(open(el.s, join, preds), envs, count);
  return merge_arms(s, values, ty);
}

function is_slice_call(name: string, c: ast.ExprCall): boolean {
  return name == "slice_unchecked" && c.args.len() == 3 && c.type_args.len() == 0;
}

function closure(body: string, c: ast.ExprCall, s: State): Value {
  let at = ssasem.find_contract(s.contracts, body);
  if (at < 0) {
    return refused(s, "call target has no semantic contract: " + body);
  }
  let contract = s.contracts.list[at];
  if (!ssasem.closure_env(contract)) {
    return refused(s, "closure environment parameter");
  }
  if (contract.modes.len() > 0 && contract.modes[0] == ssaunits.counted_mode()) {
    return refused(s, "function value consumes its environment");
  }
  let vars = ssasem.contract_variables(contract);
  if (vars.len() > 0) {
    if (!ssasem.binds_all(s.binding, vars)) {
      return refused(s, "unbound type variable");
    }
    contract = ssasem.instantiate_contract(contract, s.binding, vars);
    s = request(s, body, contract.name, s.binding);
  }
  let caps = captures(c, s, ssasem.closure_captures(contract));
  s = caps.s;
  if (!s.ok) {
    return Value { s: s, id: -1 };
  }
  if (ssasem.find_contract_in(s.calls, contract.name) < 0) {
    s = State { ...s, calls: s.calls.append(contract) };
  }
  return define(s, ssasem.closure_new(), caps.ids, 0, contract.name, ssasem.closure_type(contract));
}

struct Captured { s: State, ids: i32[] }

function captures(c: ast.ExprCall, s: State, types: typeinfo.Type[]): Captured {
  if (c.args.len() != types.len()) {
    return Captured { s: fail(s, "closure capture count"), ids: [] };
  }
  let ids: i32[] = [];
  for i in 0..c.args.len() {
    let v = expr(c.args[i], s, types[i]);
    s = v.s;
    if (!s.ok) {
      return Captured { s: s, ids: [] };
    }
    if (!semtypes.equal(s.values[v.id], types[i])) {
      return Captured { s: fail(s, "closure capture type"), ids: [] };
    }
    ids = ids.append(v.id);
  }
  return Captured { s: s, ids: ids };
}

function variant_call(e: ast.Expr, name: string, c: ast.ExprCall, s: State, expected: typeinfo.Type): Value {
  let whole = settled_union(settled(literal_union(e, s, expected)), name, c.args, s);
  if (names_variant(s, whole, name)) {
    return variant(name, whole, c.args, s);
  }
  if (c.args.len() == 1 && names_member(s, whole, name)) {
    return member_literal(name, whole, c.args[0], s);
  }
  return refused(s, "call target has no semantic contract: " + name);
}

function names_member(s: State, whole: typeinfo.Type, name: string): boolean {
  let owner = typeinfo.union_name(whole);
  if (owner == "" || union_layout(s, owner) != semrecords.layout_member()) {
    return false;
  }
  return match (checker.variant_shape_sig(s.scope, name, owner)) { Some(_) => true, None => false };
}

function member_literal(name: string, whole: typeinfo.Type, written: ast.Expr, s: State): Value {
  let v = expr(written, s, checked(written, s));
  if (!v.s.ok) {
    return v;
  }
  if (struct_name(v.s.values[v.id]) != name) {
    return refused(v.s, "union member literal: " + name + " takes " + name + ", not " + typeinfo.spelling(v.s.values[v.id]));
  }
  return define(v.s, ssasem.variant_up(), [v.id], 0, name, whole);
}

function settled_union(whole: typeinfo.Type, name: string, args: ast.Expr[], s: State): typeinfo.Type {
  if (names_variant(s, whole, name) && semtypes.concrete(whole, false)) {
    return whole;
  }
  let pattern = whole;
  if (name == "Some" && !names_variant(s, whole, name)) {
    pattern = typeinfo.TypeUnion { name: "Option", args: [typeinfo.TypeErased { name: "$payload" }] };
  }
  let Some(shape) = builtin_payloads(pattern, name) else {
    return whole;
  };
  if (shape.types.len() != args.len()) {
    return whole;
  }
  let b = ssasem.unbound();
  for i in 0..args.len() {
    let t = checked(args[i], s);
    if (semtypes.concrete(t, false)) {
      b = ssasem.bind_type(b, shape.types[i], t);
    }
  }
  if (!b.ok) {
    return whole;
  }
  return ssasem.substitute(pattern, b);
}

function direct_call(c: ast.ExprCall, contract: ssasem.Contract, s: State, statement: boolean, expected: typeinfo.Type): Value {
  if (c.args.len() != contract.params.len()) {
    return refused(s, "call arity");
  }
  if (typeinfo.is_void(contract.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  return invoke(c.args, contract, s, written_binding(c, contract, s), destination_binding(contract, expected));
}

function written_binding(c: ast.ExprCall, contract: ssasem.Contract, s: State): ssasem.Binding {
  let b = ssasem.unbound();
  let tps = checker.func_type_params(s.scope, contract.name);
  let skip = tps.len() - c.type_args.len();
  if (c.type_args.len() == 0 || skip < 0) {
    return b;
  }
  for i in 0..c.type_args.len() {
    if (c.type_args[i].len() > 0) {
      let t = settled(resolved(checker.spelled_type(s.scope, c.type_args[i]), s.template, s.binding, s.scope));
      if (semtypes.concrete(t, false)) {
        b = ssasem.bind_type(b, typeinfo.TypeErased { name: tps[skip + i] }, t);
      }
    }
  }
  return b;
}

function destination_binding(contract: ssasem.Contract, expected: typeinfo.Type): ssasem.Binding {
  if (!semtypes.concrete(expected, false)) {
    return ssasem.unbound();
  }
  let b = ssasem.bind_type(ssasem.unbound(), contract.result, expected);
  if (!b.ok) {
    return ssasem.unbound();
  }
  return b;
}

function call(e: ast.Expr, c: ast.ExprCall, s: State, statement: boolean, expected: typeinfo.Type): Value {
  if (!statement && typeinfo.is_void(checked(e, s))) {
    let done = discard(e, s);
    if (!done.ok) {
      return Value { s: done, id: -1 };
    }
    return unit_value(done);
  }
  if (parser.is_value_block(c)) {
    return value_block(e, c, s, expected);
  }
  if let ast.ExprFieldAccess(mfa) = c.callee {
    let head = type_head(mfa.obj, s);
    if (head.len() > 0) {
      return qualified_call(e, head, mfa.field, c, s, statement, expected);
    }
    return method_call(c, mfa, s, statement, expected);
  }
  let name = "";
  if let ast.ExprIdent(id) = c.callee {
    name = id.name;
  }
  let bound = lookup(s, name);
  if (bound >= 0) {
    return bound_call(c, bound, s, statement);
  }
  if (name == "") {
    let cty = checked(c.callee, s);
    if (ssasem.is_func(cty)) {
      let cv = expr(c.callee, s, typeinfo.unchecked());
      if (!cv.s.ok) {
        return cv;
      }
      return indirect_call(c, cv.id, cv.s, statement);
    }
    return refused(s, "unsupported call target: callee is neither a name nor a field");
  }
  return free_call(e, name, c, s, statement, expected);
}

function type_head(obj: ast.Expr, s: State): string {
  if let ast.ExprIdent(id) = obj {
    if (lookup(s, id.name) >= 0) {
      return "";
    }
    if (util.has_str(s.binding.names, id.name)) {
      let actual = ssasem.substitute(typeinfo.TypeErased { name: id.name }, s.binding);
      if (semtypes.concrete(actual, false)) {
        return parser.receiver_base(typeinfo.spelling(actual));
      }
    }
    return declared_type_head(id.name, s);
  }
  return "";
}

function declared_type_head(name: string, s: State): string {
  let base = util.base_type_name(name);
  if (base != name && (s.scope.has_struct(base) || union_variants(s, base).len() > 0 || builtin_union_layout(base) != 0)) {
    return base;
  }
  if (s.scope.has_union(name) || builtin_union_layout(name) != 0) {
    return name;
  }
  if (checker.variant_owner_of(s.scope, name).len() > 0) {
    return "";
  }
  if let Some(sig) = checker.struct_sig(s.scope, name) {
    if (sig.enum_owner.len() > 0) {
      return "";
    }
    return name;
  }
  if (union_variants(s, name).len() > 0 || builtin_union_layout(name) != 0 || typeinfo.is_primitive_type_name(name)) {
    return name;
  }
  return "";
}

function literal_owner(s: State, whole: typeinfo.Type, head: string): boolean {
  return typeinfo.union_name(whole) == head || typeinfo.union_name(enum_origin(whole, s)) == head;
}

function qualified_variant(e: ast.Expr, head: string, name: string, args: ast.Expr[], s: State, expected: typeinfo.Type): Value {
  let whole = settled_union(settled(literal_union(e, s, expected)), name, args, s);
  if (!literal_owner(s, whole, head) || !names_variant(s, whole, name)) {
    return refused(s, "unsupported qualified path: " + head + "." + name);
  }
  return variant(name, whole, args, s);
}

function qualified_call(e: ast.Expr, head: string, name: string, c: ast.ExprCall, s: State, statement: boolean, expected: typeinfo.Type): Value {
  let whole = settled_union(settled(literal_union(e, s, expected)), name, c.args, s);
  if (literal_owner(s, whole, head) && names_variant(s, whole, name)) {
    return variant(name, whole, c.args, s);
  }
  let at = ssasem.find_contract(s.contracts, head + "." + name);
  if (at < 0) {
    return refused(s, "call target has no semantic contract: " + head + "." + name);
  }
  let contract = s.contracts.list[at];
  let binding = qualified_binding(c, contract, head, name, s);
  if (c.args.len() != contract.params.len()) {
    return refused(s, "call arity");
  }
  if (typeinfo.is_void(contract.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  return invoke(c.args, contract, s, binding, destination_binding(contract, expected));
}

function qualified_binding(c: ast.ExprCall, contract: ssasem.Contract, head: string, name: string, s: State): ssasem.Binding {
  let binding = written_binding(c, contract, s);
  let Some(sig) = s.scope.lookup_assoc_sig(head, name) else {
    return binding;
  };
  if (sig.receiver.len() > 0) {
    if let ast.ExprFieldAccess(field) = c.callee {
      if let ast.ExprIdent(receiver) = field.obj {
        let pattern = resolved(checker.signature_receiver(s.scope, sig), true, ssasem.unbound(), s.scope);
        let actual = settled(resolved(checker.spelled_type(s.scope, receiver.name), s.template, s.binding, s.scope));
        if (semtypes.concrete(actual, false)) {
          binding = ssasem.bind_type(binding, pattern, actual);
        }
      }
    }
  }
  return binding;
}

function free_call(e: ast.Expr, name: string, c: ast.ExprCall, s: State, statement: boolean, expected: typeinfo.Type): Value {
  if (is_slice_call(name, c)) {
    return string_slice(c, s);
  }
  if (concat_kernel(name, c, s)) {
    return builtin_concat(c, s);
  }
  if (join_kernel(name, c, s)) {
    return folded_join(c, s);
  }
  if (name == "cell_new" && c.args.len() == 1) {
    return cell_construction(c, s, expected);
  }
  if (name == "__socket_from_fd") {
    return socket_from_fd(c, s);
  }
  if (name == "share_unchecked" && c.args.len() == 1) {
    return expr(c.args[0], s, expected);
  }
  if (parser.is_send_builtin(name) && c.args.len() == 1) {
    return send_builtin(name, c, s, expected);
  }
  if ((name == "map_new" || name == "__map_new_i32") && c.args.len() == 1) {
    return map_construction(e, c, s, expected);
  }
  let body = parser.mkclo_body(name);
  if (body.len() > 0) {
    return closure(body, c, s);
  }
  if (lane_memory_call(name, c)) {
    return lane_memory(name, c, s);
  }
  let at = ssasem.find_contract(s.contracts, name);
  if (at < 0) {
    return variant_call(e, name, c, s, expected);
  }
  return exiting(name, direct_call(c, s.contracts.list[at], s, statement, expected));
}

function socket_from_fd(c: ast.ExprCall, s: State): Value {
  if (c.args.len() != 1) {
    return refused(s, "call arity");
  }
  let fd = expr(c.args[0], s, typeinfo.t_i32());
  if (!fd.s.ok) {
    return fd;
  }
  return socket_of(fd);
}

function close_count(fd: Value): Value {
  let s = fd.s;
  let contract = s.contracts.list[ssasem.find_contract(s.contracts, "__task_fd_gen")];
  if (ssasem.find_contract_in(s.calls, contract.name) < 0) {
    s = State { ...s, calls: s.calls.append(contract) };
  }
  let count = define(s, ssasem.call(), [fd.id], 0, contract.name, typeinfo.t_i32());
  let bits = define(count.s, ssasem.cast(), [count.id], 0, "", typeinfo.t_u32());
  return define(bits.s, ssasem.cast(), [bits.id], 0, "", typeinfo.t_u64());
}

// socket_of makes the handle of a descriptor number: the number in the low
// half, and the close count of that number in the high half. A negative
// number is an error code. Its count is zero, so it stays in the low half.
function socket_of(fd: Value): Value {
  let count = close_count(fd);
  let half = define(count.s, ssa.CONST_INT, [], 0, "32", typeinfo.t_u64());
  let high = define(half.s, ssa.BINARY, [count.id, half.id], 0, "<<", typeinfo.t_u64());
  let bits = define(high.s, ssasem.cast(), [fd.id], 0, "", typeinfo.t_u32());
  let low = define(bits.s, ssasem.cast(), [bits.id], 0, "", typeinfo.t_u64());
  let word = define(low.s, ssa.BINARY, [high.id, low.id], 0, "|", typeinfo.t_u64());
  return define(word.s, ssasem.cast(), [word.id], 0, "", t_handle("Socket"));
}

// socket_number gives the descriptor number of a handle. When the number was
// closed after the handle was made, the result is -1, which no kernel accepts.
function socket_number(sock: Value): Value {
  let word = define(sock.s, ssasem.cast(), [sock.id], 0, "", typeinfo.t_u64());
  let fd = define(word.s, ssasem.cast(), [word.id], 0, "", typeinfo.t_i32());
  let count = close_count(fd);
  let half = define(count.s, ssa.CONST_INT, [], 0, "32", typeinfo.t_u64());
  let made = define(half.s, ssa.BINARY, [word.id, half.id], 0, ">>", typeinfo.t_u64());
  let differ = define(made.s, ssa.BINARY, [made.id, count.id], 0, "^", typeinfo.t_u64());
  let ones = define(differ.s, ssa.CONST_INT, [], 0, "4294967295", typeinfo.t_u64());
  let carried = define(ones.s, ssa.BINARY, [differ.id, ones.id], 0, "+", typeinfo.t_u64());
  let stale = define(carried.s, ssa.BINARY, [carried.id, half.id], 0, ">>", typeinfo.t_u64());
  let mask = define(stale.s, ssa.BINARY, [stale.id, ones.id], 0, "*", typeinfo.t_u64());
  let low = define(mask.s, ssa.BINARY, [word.id, mask.id], 0, "|", typeinfo.t_u64());
  return define(low.s, ssasem.cast(), [low.id], 0, "", typeinfo.t_i32());
}

// Only a kernel has a number parameter that the checker gives a Socket.
function kernel_argument(v: Value, want: typeinfo.Type): Value {
  if (v.s.ok && semtypes.is_socket(v.s.values[v.id]) && ssasem.is_i32(want)) {
    return socket_number(v);
  }
  return v;
}

// The kernels in the list return the descriptor number of a new socket.
function kernel_result(result: Value, name: string): Value {
  if (util.has_str(["tcp_listen", "tcp_listen_with", "tcp_accept", "tcp_accept_with", "tcp_connect_with", "udp_bind", "udp_bind_with", "unix_listen", "unix_connect"], name)) {
    return socket_of(result);
  }
  return result;
}

function send_builtin(name: string, c: ast.ExprCall, s: State, expected: typeinfo.Type): Value {
  return match (name) {
    "__send_copy" => send_copy(c, s),
    "__send_adopt" => send_adopt(c, s, expected),
    "__send_root" => send_root(c, s),
    "__send_release" => send_release(c, s),
    _ => refused(s, "no lowering for " + name),
  };
}

// `__send_release(v)` consumes a value and releases it where it is written.
// The planner releases a value at its last use, and a join needs the
// release of an adopted value after the heap mark it restores to.
function send_release(c: ast.ExprCall, s: State): Value {
  let want = checked(c.args[0], s);
  let v = expr(c.args[0], s, want);
  if (!v.s.ok) {
    return v;
  }
  let t = v.s.values[v.id];
  if (!ssasem.reference(t)) {
    return refused(s, "__send_release takes a counted value");
  }
  return per_type_call(v, ssasem.Contract { name: ssasem.release_helper_name(t), params: [t], modes: [ssaunits.counted_mode()], result: typeinfo.t_void() });
}

// `__send_copy(v)` is a call to the per-type copy helper. The helper borrows
// its argument and returns a fresh tree, so the planner treats the call as
// any borrowing call with an owned result.
function send_copy(c: ast.ExprCall, s: State): Value {
  let want = checked(c.args[0], s);
  let v = expr(c.args[0], s, want);
  if (!v.s.ok) {
    return v;
  }
  let t = v.s.values[v.id];
  return per_type_call(v, ssasem.Contract { name: ssasem.send_helper_name(t), params: [t], modes: [ssaunits.borrow_mode()], result: t });
}

// A call to a helper the lowering generates per type. The contract is
// registered once per function, and the result is owned as any call result.
function per_type_call(v: Value, contract: ssasem.Contract): Value {
  let next = v.s;
  if (ssasem.find_contract_in(next.calls, contract.name) < 0) {
    next = State { ...next, calls: next.calls.append(contract) };
  }
  return define(next, ssasem.call(), [v.id], 0, contract.name, contract.result);
}

// `__send_adopt(addr)` takes the box at `addr` as a value of the expected
// type. It is a call under a per-type name, so the planner owns the result
// as it owns any call result, and the lowering emits the send_adopt mark.
function send_adopt(c: ast.ExprCall, s: State, expected: typeinfo.Type): Value {
  if (!semtypes.concrete(expected, false)) {
    return refused(s, "__send_adopt needs the declared type of its binding");
  }
  let v = expr(c.args[0], s, typeinfo.t_usize());
  if (!v.s.ok) {
    return v;
  }
  return per_type_call(v, ssasem.Contract { name: ssasem.adopt_helper_name(expected), params: [typeinfo.t_usize()], modes: [ssaunits.value_mode()], result: expected });
}

// `__send_root(v)` consumes a value and returns its word. The helper keeps
// the value alive, so the caller cannot touch it again. The caller must
// transfer the region or reclaim it after a copy into another heap.
function send_root(c: ast.ExprCall, s: State): Value {
  let want = checked(c.args[0], s);
  let v = expr(c.args[0], s, want);
  if (!v.s.ok) {
    return v;
  }
  let t = v.s.values[v.id];
  if (!ssasem.reference(t)) {
    return refused(s, "__send_root takes a counted value");
  }
  return per_type_call(v, ssasem.Contract { name: ssasem.root_helper_name(t), params: [t], modes: [ssaunits.counted_mode()], result: typeinfo.t_usize() });
}

// The builtin exit never returns, so the block it ends has no successor.
function exiting(name: string, v: Value): Value {
  if (name != "exit" || !v.s.ok || util.has_str(v.s.shadows, name)) {
    return v;
  }
  return Value { s: terminate(v.s, ssa.t_unreachable()), id: v.id };
}

function lane_memory_call(name: string, c: ast.ExprCall): boolean {
  let verb = typeinfo.lane_builtin_verb(name);
  return (verb == "load" || verb == "load_bytes") && c.args.len() == 2 || (verb == "with" || verb == "with_bytes") && c.args.len() == 3;
}

function lane_memory(name: string, c: ast.ExprCall, s: State): Value {
  let arr = typeinfo.lane_builtin_params(name)[0];
  let xs = expr(c.args[0], s, arr);
  if (!xs.s.ok) {
    return xs;
  }
  if (!semtypes.equal(xs.s.values[xs.id], arr)) {
    return refused(xs.s, "lane array type");
  }
  let at = expr(c.args[1], xs.s, typeinfo.t_i32());
  if (!at.s.ok || !is_i32(at.s.values[at.id])) {
    return refused(at.s, "lane index type");
  }
  let verb = typeinfo.lane_builtin_verb(name);
  // Lanes of 8 bits are the bytes of the array, so their group is a
  // group of bytes.
  let marker = if (verb == "load_bytes" || verb == "with_bytes" || typeinfo.lane_builtin_width(name) == 8) { "lane_bytes" } else { "" };
  if (verb == "load" || verb == "load_bytes") {
    return define(at.s, ssasem.array_get(), [xs.id, at.id], 0, marker, typeinfo.lane_builtin_result(name));
  }
  let lt = typeinfo.lane_builtin_params(name)[2];
  let v = expr(c.args[2], at.s, lt);
  if (!v.s.ok || !semtypes.equal(v.s.values[v.id], lt)) {
    return refused(v.s, "lane value type");
  }
  return define(v.s, ssasem.with(), [xs.id, at.id, v.id], 0, marker, arr);
}

function invoke(args: ast.Expr[], contract: ssasem.Contract, s: State, written: ssasem.Binding, seed: ssasem.Binding): Value {
  if (!written.ok) {
    return refused(s, written.why);
  }
  return invoke_rest([], written, args, 0, contract, s, seed);
}

function invoke_method(recv: i32, args: ast.Expr[], contract: ssasem.Contract, s: State, written: ssasem.Binding, seed: ssasem.Binding): Value {
  if (!written.ok) {
    return refused(s, written.why);
  }
  let v = lend(Value { s: s, id: recv }, contract.params[0], contract.modes[0], keeps(s, contract, 0));
  s = v.s;
  if (!s.ok) {
    return v;
  }
  let bound = ssasem.bind_type(written, contract.params[0], s.values[v.id]);
  if (!bound.ok) {
    return refused(s, bound.why);
  }
  v = widen(v, ssasem.substitute(contract.params[0], bound));
  s = v.s;
  if (!semtypes.equal(ssasem.substitute(contract.params[0], bound), s.values[v.id])) {
    return refused(s, "call receiver type");
  }
  return invoke_rest([v.id], bound, args, 1, contract, s, seed);
}

function invoke_rest(ids: i32[], bound: ssasem.Binding, args: ast.Expr[], base: i32, contract: ssasem.Contract, s: State, seed: ssasem.Binding): Value {
  for i in 0..args.len() {
    let at = base + i;
    let want = ssasem.substitute(contract.params[at], bound);
    if (!semtypes.concrete(want, false)) {
      want = ssasem.substitute(want, seed);
    }
    if (!semtypes.concrete(want, false)) {
      want = ssasem.substitute(want, later_binding(bound, args, i + 1, base, contract, s));
    }
    let v = kernel_argument(lend(expr(args[i], s, want), want, contract.modes[at], keeps(s, contract, at)), want);
    s = v.s;
    if (!s.ok) {
      return v;
    }
    bound = ssasem.bind_type(bound, contract.params[at], s.values[v.id]);
    if (!bound.ok) {
      return refused(s, bound.why + ": " + contract.name + " parameter " + at.to_string() + " expects " + typeinfo.spelling(contract.params[at]) + ", received " + typeinfo.spelling(s.values[v.id]));
    }
    v = widen(v, ssasem.substitute(contract.params[at], bound));
    s = v.s;
    if (!semtypes.equal(ssasem.substitute(contract.params[at], bound), s.values[v.id])) {
      return refused(s, "call argument type: " + contract.name + " expects " + typeinfo.spelling(ssasem.substitute(contract.params[at], bound)) + ", received " + typeinfo.spelling(s.values[v.id]));
    }
    ids = ids.append(v.id);
  }
  let callee = contract;
  let vars = ssasem.contract_variables(contract);
  bound = ssasem.filled(bound, seed);
  if (vars.len() > 0) {
    if (!ssasem.binds_all(bound, vars)) {
      return refused(s, "unbound type variable");
    }
    callee = ssasem.instantiate_contract(contract, bound, vars);
    s = request(s, contract.name, callee.name, bound);
  }
  if (ssasem.find_contract_in(s.calls, callee.name) < 0) {
    s = State { ...s, calls: s.calls.append(callee) };
  }
  return kernel_result(define(s, ssasem.call(), ids, 0, callee.name, callee.result), callee.name);
}

function later_binding(b: ssasem.Binding, args: ast.Expr[], from: i32, base: i32, contract: ssasem.Contract, s: State): ssasem.Binding {
  for i in from..args.len() {
    let t = checked(args[i], s);
    if (semtypes.concrete(t, false)) {
      let next = ssasem.bind_type(b, contract.params[base + i], t);
      if (next.ok) {
        b = next;
      }
    }
  }
  return b;
}

function request(s: State, key: string, name: string, b: ssasem.Binding): State {
  for r in s.requests {
    if (r.name == name) {
      return s;
    }
  }
  return State { ...s, requests: s.requests.append(Request { key: key, name: name, binding: b }) };
}

function enum_origin(t: typeinfo.Type, s: State): typeinfo.Type {
  if let Some(sig) = checker.union_sig(s.scope, typeinfo.union_name(t)) {
    if (sig.instance != "") {
      return settled(resolved(checker.spelled_type(s.scope, sig.instance), s.template, s.binding, s.scope));
    }
  }
  return t;
}

function completes_enum(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(a) = from {
    if let typeinfo.TypeUnion(b) = to {
      if (a.name != b.name || a.args.len() != b.args.len() || !semtypes.concrete(to, false)) {
        return false;
      }
      for i in 0..a.args.len() {
        if (!semtypes.is_never(a.args[i]) && !semtypes.equal(a.args[i], b.args[i]) && !typeinfo.lossless_widen(a.args[i], b.args[i])) {
          return false;
        }
      }
      return true;
    }
  }
  return false;
}

function completing_variant(from: typeinfo.Type, to: typeinfo.Type, s: State): i32 {
  if (!semtypes.concrete(to, false) || !completes_enum(enum_origin(from, s), enum_origin(to, s))) {
    return -1;
  }
  let source = typed_variants(s, from);
  let dest = typed_variants(s, to);
  if (source.len() != dest.len()) {
    return -1;
  }
  let chosen: i32 = -1;
  for i in 0..source.len() {
    if (semrecords.inhabited(source[i])) {
      if (chosen >= 0 || !completable_payloads(source[i].fields, dest[i].fields)) {
        return -1;
      }
      chosen = i;
    }
  }
  return chosen;
}

function completable_payloads(a: semrecords.Field[], b: semrecords.Field[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (!semtypes.equal(a[i].ty, b[i].ty) && !typeinfo.lossless_widen(a[i].ty, b[i].ty)) {
      return false;
    }
  }
  return true;
}

function complete_variant(v: Value, expected: typeinfo.Type, index: i32): Value {
  let ids: i32[] = [];
  let s = v.s;
  let shape = typed_variants(s, s.values[v.id])[index];
  let dest = typed_variants(s, expected)[index];
  for i in 0..shape.fields.len() {
    let part = define(s, ssasem.variant_get(), [v.id], i, shape.name, shape.fields[i].ty);
    part = kept_view(unaliased_view(part));
    if (typeinfo.lossless_widen(shape.fields[i].ty, dest.fields[i].ty)) {
      part = define(part.s, ssasem.cast(), [part.id], 0, "", dest.fields[i].ty);
    }
    s = part.s;
    ids = ids.append(part.id);
  }
  return define(s, ssasem.variant_new(), ids, 0, dest.name, expected);
}

function widen(v: Value, expected: typeinfo.Type): Value {
  let s = v.s;
  if (!s.ok) {
    return v;
  }
  if (semtypes.equal(s.values[v.id], expected)) {
    return v;
  }
  if (typeinfo.lossless_widen(s.values[v.id], expected)) {
    return define(s, ssasem.cast(), [v.id], 0, "", expected);
  }
  let completed = completing_variant(s.values[v.id], expected, s);
  if (completed >= 0) {
    return complete_variant(v, expected, completed);
  }
  if (semtypes.lends_array(s.values[v.id], expected)) {
    return define(s, ssasem.array_lend(), [v.id], 0, "", expected);
  }
  if (ssasem.is_view(expected) && ssasem.is_string(s.values[v.id])) {
    return define(s, ssasem.str_as(), [v.id], 0, "", expected);
  }
  if (ssasem.lends_handle(s.values[v.id], expected)) {
    return define(s, ssasem.cast(), [v.id], 0, "", expected);
  }
  if (ssasem.is_view(typeinfo.array_elem(expected)) && ssasem.is_string_array(s.values[v.id])) {
    return define(s, ssasem.str_as(), [v.id], 0, "", expected);
  }
  if (typeinfo.is_dyn(expected) && (struct_name(s.values[v.id]) != "" || typeinfo.union_name(s.values[v.id]) != "")) {
    return define(s, ssasem.dyn_up(), [v.id], 0, "", expected);
  }
  if (typeinfo.is_dyn(expected) && ssasem.boxes_into_dyn(s.values[v.id])) {
    return define(s, ssasem.dyn_box(), [v.id], 0, typeinfo.spelling(s.values[v.id]), expected);
  }
  let owner = typeinfo.union_name(expected);
  let member = struct_name(s.values[v.id]);
  if (owner == "" || member == "") {
    return v;
  }
  let layout = union_layout(s, owner);
  if (layout == semrecords.layout_member()) {
    if let None = checker.variant_shape_sig(s.scope, member, owner) {
      return v;
    }
    return define(s, ssasem.variant_up(), [v.id], 0, member, expected);
  }
  if (layout == semrecords.layout_variant()) {
    for vn in union_variants(s, owner) {
      if (clone_base(vn) != clone_base(member)) {
        continue;
      }
      if let Some(shape) = literal_payloads(s, expected, vn, layout) {
        if (shape.types.len() == 1 && semtypes.equal(shape.types[0], s.values[v.id])) {
          let payload = kept_view(unaliased_view(v));
          return define(payload.s, ssasem.variant_new(), [payload.id], 0, vn, expected);
        }
      }
    }
  }
  return v;
}

function clone_base(name: string): string {
  let i = 1;
  while (i + 1 < name.len()) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return slice_unchecked(name, 0, i).to_owned();
    }
    i += 1;
  }
  return name;
}

function expr(e: ast.Expr, s: State, expected: typeinfo.Type): Value {
  if (!s.ok) {
    return Value { s: s, id: -1 };
  }
  let v = produce(e, s, expected);
  if (!v.s.ok) {
    return v;
  }
  return widen(v, expected);
}

function zero_value(e: ast.Expr, s: State, expected: typeinfo.Type): Value {
  let ty = expected;
  if (!semtypes.concrete(ty, false)) {
    ty = checked(e, s);
  }
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "zero of an unresolved type");
  }
  return define(s, ssasem.zero(), [], 0, "", ty);
}

function string_literal(st: ast.ExprString, s: State, expected: typeinfo.Type): Value {
  if (ssasem.is_view(expected)) {
    return define(s, ssa.CONST_STR, [], 0, st.value, expected);
  }
  return define(s, ssa.CONST_STR, [], 0, st.value, typeinfo.t_string());
}

function produce(e: ast.Expr, s: State, expected: typeinfo.Type): Value {
  match (e) {
    ast.ExprNumber(n) => {
      return number(n, s, expected);
    },
    ast.ExprBool(b) => {
      return define(s, ssa.CONST_BOOL, [], util.bool_i32(b.value), "", typeinfo.t_bool());
    },
    ast.ExprString(st) => {
      return string_literal(st, s, expected);
    },
    ast.ExprIdent(id) => {
      return ident(e, id, s, expected);
    },
    ast.ExprStructLit(sl) => {
      return record(e, sl, s);
    },
    ast.ExprArray(a) => {
      return array(e, a, s, expected);
    },
    ast.ExprBytes(bs) => {
      return packed_bytes(e, bs.value, s, expected);
    },
    ast.ExprTuple(t) => {
      return tuple(e, t, s, expected);
    },
    ast.ExprIndex(ix) => {
      return index(ix, s);
    },
    ast.ExprSlice(sl) => {
      return slice_expr(e, sl, s);
    },
    ast.ExprFieldAccess(fa) => {
      return field(e, fa, s, expected);
    },
    ast.ExprBinary(b) => {
      return binary(e, b, s, expected);
    },
    ast.ExprUnary(u) => {
      return unary(e, u, s, expected);
    },
    ast.ExprCall(c) => {
      return call(e, c, s, false, expected);
    },
    ast.ExprZero(_) => {
      return zero_value(e, s, expected);
    },
    _ => {
      return refused(s, "unsupported expression");
    }
  }
}

function destructures(v: ast.StmtVar): boolean {
  for i in 0..v.name.len() {
    if (v.name[i] == b',') {
      return true;
    }
  }
  return parser.is_destr_marker(v.type_name);
}

function declare_tuple(st: ast.Stmt, v: ast.StmtVar, s: State): State {
  let marker = parser.destr_marker_split(v.type_name);
  let ty = checked(v.init, s);
  let after = checker.bind_stmt(st, s.scope);
  let whole = expr(v.init, s, ty);
  s = whole.s;
  if (!s.ok) {
    return s;
  }
  if (!semtypes.equal(s.values[whole.id], ty)) {
    return fail(s, mismatch(v.name, ty, s.values[whole.id]));
  }
  if (marker.at.len() > 0) {
    s = bind_projection(s, marker.at, whole.id, after);
  }
  if (marker.tag.len() > 0) {
    s = destructure_record(v.name, marker.tag, whole.id, s, after);
  } else {
    s = destructure_tuple(v.name, whole.id, s, after);
  }
  if (!s.ok) {
    return s;
  }
  return State { ...s, scope: after };
}

function bind_projection(s: State, name: string, id: i32, after: checker.Scope): State {
  let want = bound_type(s, name, after);
  if (!semtypes.concrete(want, true)) {
    return fail(s, "unresolved type of binding " + name + ": " + type_detail(want));
  }
  if (!semtypes.equal(want, s.values[id])) {
    return fail(s, mismatch(name, want, s.values[id]));
  }
  return bind_var(s, name, id);
}

function destructure_tuple(encoded: string, whole: i32, s: State, after: checker.Scope): State {
  let names = pattern_names(encoded);
  let ty = s.values[whole];
  if (names.len() == 0 || tuple_arity(ty) != names.len()) {
    return fail(s, "unsupported destructuring declaration");
  }
  for i in 0..names.len() {
    let elem = tuple_element_type(ty, i);
    if (!semtypes.concrete(elem, true)) {
      return fail(s, "tuple projection contract");
    }
    let part = define(s, ssasem.tuple_get(), [whole], i, "", elem);
    s = part.s;
    if (names[i].len() > 0 && names[i][0] == b'(') {
      s = destructure_tuple(slice_unchecked(names[i], 1, names[i].len() - 1).to_owned(), part.id, s, after);
    } else {
      s = bind_projection(s, names[i], part.id, after);
    }
    if (!s.ok) {
      return s;
    }
  }
  return s;
}

function destructure_record(encoded: string, tag: string, whole: i32, s: State, after: checker.Scope): State {
  let rest = slice_unchecked(tag, 4, tag.len()).to_owned();
  let colon = util.index_of_sub(rest, ":");
  if (colon < 0) {
    return fail(s, "unsupported destructuring declaration");
  }
  let names = pattern_names(encoded);
  let fields = pattern_names(slice_unchecked(rest, colon + 1, rest.len()).to_owned());
  let Some(sig) = record_sig(s.values[whole], s) else {
    return fail(s, "unsupported destructuring declaration");
  };
  if (!util.str_range_eq(rest, 0, colon, sig.name) || fields.len() != names.len()) {
    return fail(s, "unsupported destructuring declaration");
  }
  for i in 0..names.len() {
    let at = util.index_of_str(sig.field_names, fields[i]);
    if (at < 0 || !semtypes.concrete(sig.field_types[at], false)) {
      return fail(s, "record projection contract");
    }
    let part = field_read(s, whole, at, fields[i], sig.field_types[at]);
    s = bind_projection(part.s, names[i], part.id, after);
    if (!s.ok) {
      return s;
    }
  }
  return s;
}

function tuple_arity(t: typeinfo.Type): i32 {
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements.len();
  }
  return -1;
}

function pattern_names(encoded: string): string[] {
  let out: string[] = [];
  let depth = 0;
  let start = 0;
  for i in 0..encoded.len() {
    if (encoded[i] == b'(') {
      depth += 1;
    }
    if (encoded[i] == b')') {
      depth -= 1;
    }
    if (encoded[i] == b',' && depth == 0) {
      out = out.append(slice_unchecked(encoded, start, i).to_owned());
      start = i + 1;
    }
  }
  return out.append(slice_unchecked(encoded, start, encoded.len()).to_owned());
}

function mismatch(name: string, declared: typeinfo.Type, value: typeinfo.Type): string {
  return "binding " + name + " declared " + typeinfo.spelling(declared) + " holds a semantic value of " + typeinfo.spelling(value);
}

function declare(st: ast.Stmt, v: ast.StmtVar, s: State): State {
  if (destructures(v)) {
    return declare_tuple(st, v, s);
  }
  let after = checker.bind_stmt(st, s.scope);
  let ty = bound_type(s, v.name, after);
  if (!semtypes.concrete(ty, true)) {
    let cty = closure_slot_type(v.init, s.contracts.list);
    if (semtypes.concrete(cty, true)) {
      ty = cty;
    }
  }
  if (!semtypes.concrete(ty, false) && ast.is_call(v.init)) {
    return declare_from_call(v, s, after);
  }
  if (!semtypes.concrete(ty, true)) {
    ty = settled_payload(ty);
  }
  if (!semtypes.concrete(ty, true)) {
    return fail(s, "unresolved type of binding " + v.name + ": " + type_detail(ty));
  }
  if (value_local_placeholder(v) && !ssasem.is_integer(ty)) {
    let z = define(s, ssasem.zero(), [], 0, "", ty);
    return State { ...bind_var(z.s, v.name, z.id), scope: after };
  }
  let init = expr(v.init, s, ty);
  s = init.s;
  if (!s.ok) {
    return s;
  }
  if (!semtypes.equal(s.values[init.id], ty)) {
    return fail(s, mismatch(v.name, ty, s.values[init.id]));
  }
  init = unaliased_view(init);
  return State { ...bind_var(init.s, v.name, init.id), scope: after };
}

function bind_var(s: State, name: string, id: i32): State {
  if (util.index_of_str(s.escaping, name) < 0) {
    return bind(s, name, id);
  }
  if (util.index_of_str(s.names, name) >= 0) {
    return replace(s, name, id);
  }
  if (util.index_of_str(s.learned, name) >= 0 || !semtypes.concrete(s.values[id], false)) {
    return bind(s, name, id);
  }
  return bind(State { ...s, learned: s.learned.append(name), learned_types: s.learned_types.append(s.values[id]) }, name, id);
}

function unaliased_view(v: Value): Value {
  let s = v.s;
  if (!ssasem.is_view(s.values[v.id]) || util.index_of_i32(s.vals, v.id) < 0) {
    return v;
  }
  let kind = defining_kind(s, v.id);
  if (kind == 5 || kind == ssasem.str_as()) {
    return v;
  }
  return fresh_view(v);
}

function kept_view(v: Value): Value {
  if (!v.s.ok || !ssasem.is_view(v.s.values[v.id]) || defining_kind(v.s, v.id) != ssasem.param()) {
    return v;
  }
  return fresh_view(v);
}

function fresh_view(v: Value): Value {
  let zero = define(v.s, ssa.CONST_INT, [], 0, "", typeinfo.t_i32());
  let n = define(zero.s, ssasem.length(), [v.id], 0, "", typeinfo.t_i32());
  return define(n.s, ssasem.slice(), [v.id, zero.id, n.id], 0, "", typeinfo.t_str());
}

// A phi of views lent from arm-local storage cannot keep that storage alive
// past the join, so the owners merge first and one lend follows the phi.
function merge_arms(s: State, values: i32[], ty: typeinfo.Type): Value {
  let owners: i32[] = [];
  for v in values {
    let owner = lent_owner(s, v);
    if (owner < 0 || owners.len() > 0 && !semtypes.equal(s.values[owner], s.values[owners[0]])) {
      return define(s, ssa.PHI, values, 0, "", ty);
    }
    owners = owners.append(owner);
  }
  let owned = define(s, ssa.PHI, owners, 0, "", s.values[owners[0]]);
  return define(owned.s, ssasem.array_lend(), [owned.id], 0, "", ty);
}

function lent_owner(s: State, id: i32): i32 {
  for b in s.blocks {
    for ins in b.insts {
      if (ins.result == id) {
        return if (ins.kind_tag == ssasem.array_lend()) { ins.args[0] } else { -1 };
      }
    }
  }
  for ins in s.cur.insts {
    if (ins.result == id) {
      return if (ins.kind_tag == ssasem.array_lend()) { ins.args[0] } else { -1 };
    }
  }
  return -1;
}

function defining_kind(s: State, id: i32): i32 {
  for b in s.blocks {
    for ins in b.insts {
      if (ins.result == id) {
        return ins.kind_tag;
      }
    }
  }
  for ins in s.cur.insts {
    if (ins.result == id) {
      return ins.kind_tag;
    }
  }
  return 0;
}

function value_local_placeholder(v: ast.StmtVar): boolean {
  if (!parser.is_value_local_name(lexical.source_name(v.name))) {
    return false;
  }
  if let ast.ExprNumber(n) = v.init {
    return n.text == "0" && n.suffix.len() == 0 && !n.is_float;
  }
  return false;
}

function declare_from_call(v: ast.StmtVar, s: State, after: checker.Scope): State {
  let init = expr(v.init, s, typeinfo.unchecked());
  s = init.s;
  if (!s.ok) {
    return s;
  }
  if (!semtypes.concrete(s.values[init.id], true)) {
    return fail(s, "unresolved type of binding " + v.name + ": " + type_detail(s.values[init.id]));
  }
  return State { ...bind_var(s, v.name, init.id), scope: after };
}

function assign(a: ast.StmtAssign, s: State): State {
  let ax = parser.defer_armed(a);
  if (ax >= s.armed) {
    s = State { ...s, armed: ax + 1 };
  }
  let old = lookup(s, a.target);
  if (old < 0) {
    return fail(s, "replacement of an unbound name");
  }
  if (util.index_of_i32(s.foreign, old) >= 0) {
    return fail(s, "replacement of a capture");
  }
  let value = expr(a.value, s, s.values[old]);
  s = value.s;
  if (!s.ok) {
    return s;
  }
  if (!semtypes.equal(s.values[value.id], s.values[old])) {
    return fail(s, "replacement type does not match its binding");
  }
  value = unaliased_view(value);
  return replace(value.s, a.target, value.id);
}

function ret(r: ast.StmtReturn, s: State): State {
  if (parser.bare_return(r.value)) {
    if (!typeinfo.is_void(s.result)) {
      return fail(s, "missing return value");
    }
    return terminate(s, ssa.t_ret(-1));
  }
  if (typeinfo.is_void(s.result)) {
    s = discard(r.value, s);
    if (!s.ok) {
      return s;
    }
    return terminate(s, ssa.t_ret(-1));
  }
  let value = expr(r.value, s, s.result);
  s = value.s;
  if (!s.ok) {
    return s;
  }
  if (!semtypes.equal(s.values[value.id], s.result)) {
    return fail(s, "return type: declared " + typeinfo.spelling(s.result) + ", returns " + typeinfo.spelling(s.values[value.id]));
  }
  value = kept_view(unaliased_view(value));
  return terminate(value.s, ssa.t_ret(value.id));
}

struct Arm { s: State, live: boolean, end: i32, env: i32[], value: i32 }

function arm(body: ast.Stmt[], s: State, entry: i32[], id: i32, preds: i32[], join: i32, count: i32, scope: checker.Scope): Arm {
  return finish_arm(body, open(State { ...s, vals: entry }, id, preds), join, count, scope);
}

function finish_arm(body: ast.Stmt[], s: State, join: i32, count: i32, scope: checker.Scope): Arm {
  s = stmts(body, s);
  let live = s.live && s.ok;
  let end = s.cur.id;
  let env = prefix(s.vals, count);
  s = terminate(s, ssa.t_br(join));
  return Arm { s: leave(s, count, scope), live: live, end: end, env: env, value: -1 };
}

function arm_body(body: ast.Stmt[], s: State, join: i32, count: i32, scope: checker.Scope, ty: typeinfo.Type): Arm {
  if (!semtypes.concrete(ty, false)) {
    return finish_arm(body, s, join, count, scope);
  }
  let dead = Arm { s: s, live: false, end: 0, env: [], value: -1 };
  if (body.len() == 0) {
    return Arm { ...dead, s: fail(s, "value block arm has no value") };
  }
  for i in 0..body.len() - 1 {
    s = stmt(body[i], s);
  }
  if (!s.ok) {
    return Arm { ...dead, s: s };
  }
  if (!s.live) {
    return Arm { ...dead, s: leave(s, count, scope) };
  }
  let v = arm_value(body[body.len() - 1], s, ty);
  s = v.s;
  if (!s.ok) {
    return Arm { ...dead, s: s };
  }
  let end = s.cur.id;
  let env = prefix(s.vals, count);
  s = terminate(s, ssa.t_br(join));
  return Arm { s: leave(s, count, scope), live: true, end: end, env: env, value: v.id };
}

function branch(f: ast.StmtIf, s: State): State {
  let then_id = s.next_block;
  let else_id = then_id + 1;
  let join = then_id + 2;
  s = State { ...s, next_block: join + 1 };
  let count = s.names.len();
  let entry = s.vals;
  let scope = s.scope;
  let c = cond(f.cond, s, then_id, else_id);
  s = c.s;
  if (!s.ok) {
    return s;
  }
  let t = arm(f.then_body, s, entry, then_id, c.yes, join, count, scope);
  let e = arm(f.else_body, t.s, entry, else_id, c.no, join, count, scope);
  s = e.s;
  if (!s.ok) {
    return s;
  }
  let preds: i32[] = [];
  let envs: i32[][] = [];
  if (t.live) {
    preds = preds.append(t.end);
    envs = envs.append(t.env);
  }
  if (e.live) {
    preds = preds.append(e.end);
    envs = envs.append(e.env);
  }
  if (preds.len() == 0) {
    return s;
  }
  return merge_env(open(s, join, preds), envs, count);
}

struct Arms { s: State, preds: i32[], envs: i32[][], values: i32[] }

struct Gathered { preds: i32[], envs: i32[][], values: i32[] }

function parts(arms: Arms): Gathered {
  return Gathered { preds: arms.preds, envs: arms.envs, values: arms.values };
}

function gathered(s: State, g: Gathered): Arms {
  return Arms { s: s, preds: g.preds, envs: g.envs, values: g.values };
}

function collect(g: Gathered, done: Arm): Arms {
  if (!done.live) {
    return gathered(done.s, g);
  }
  return Arms { s: done.s, preds: g.preds.append(done.end), envs: g.envs.append(done.env), values: g.values.append(done.value) };
}

function qualified(name: string): boolean {
  for i in 0..name.len() {
    if (name[i] == b'.') {
      return true;
    }
  }
  return false;
}

function pattern_shape_error(pv: ast.PatVariant): string {
  if (pv.nested.len() > 0 || pv.has_lit_cond) {
    return "unsupported pattern";
  }
  if (pv.tup_kinds.len() > 0 || parser.is_record_pattern(pv)) {
    return "unsupported pattern";
  }
  if (qualified(pv.type_name)) {
    return "unsupported qualified pattern";
  }
  return "";
}

function pattern_payloads(a: ast.MatchArm, pv: ast.PatVariant, candidate: Option[Payloads], layout: i32): Result[Payloads, string] {
  if (a.alt_cont) {
    return Err("unsupported match guard");
  }
  let why = pattern_shape_error(pv);
  if (why != "") {
    return Err(why);
  }
  let Some(shape) = candidate else {
    return Err("unknown variant");
  };
  if (layout == semrecords.layout_member() || shape.unit) {
    if (pv.extra_bindings.len() > 0) {
      return Err("pattern arity");
    }
    return Ok(shape);
  }
  if (pv.binding != "" && 1 + pv.extra_bindings.len() != shape.types.len()) {
    return Err("pattern arity");
  }
  return Ok(shape);
}

function narrowed(pv: ast.PatVariant, scrut: i32, s: State): State {
  if (pv.binding == "" || pv.binding == "_") {
    return s;
  }
  let bound = util.index_of_str(s.names, pv.binding) >= 0;
  let v = define(s, ssasem.variant_as(), [scrut], 0, pv.type_name, member_type(pv));
  s = State { ...v.s, narrowings: v.s.narrowings.append(Narrowing { id: v.id, scrut: scrut, member: pv.type_name }) };
  if (bound) {
    return replace(s, pv.binding, v.id);
  }
  return bind(s, pv.binding, v.id);
}

function field_read(s: State, base: i32, at: i32, field: string, ty: typeinfo.Type): Value {
  for n in s.narrowings {
    if (n.id == base) {
      return define(s, ssasem.variant_get(), [n.scrut], at, n.member, ty);
    }
  }
  return define(s, ssasem.record_get(), [base], at, field, ty);
}

function member_type(pv: ast.PatVariant): typeinfo.Type {
  return typeinfo.TypeStruct { name: pv.type_name, args: [] };
}

function at_bound(pv: ast.PatVariant, scrut: i32, s: State): State {
  if (pv.at_binding == "" || pv.at_binding == "_") {
    return s;
  }
  return bind(s, pv.at_binding, scrut);
}

function payloads(pv: ast.PatVariant, scrut: i32, fields: typeinfo.Type[], s: State, layout: i32): State {
  s = at_bound(pv, scrut, s);
  if (layout == semrecords.layout_member()) {
    return narrowed(pv, scrut, s);
  }
  if (pv.binding == "" || pv.binding == "_" && fields.len() == 0) {
    return s;
  }
  if (fields.len() == 0) {
    let unit = unit_value(s);
    if (util.index_of_str(unit.s.names, pv.binding) >= 0) {
      return replace(unit.s, pv.binding, unit.id);
    }
    return bind(unit.s, pv.binding, unit.id);
  }
  let names: string[] = [pv.binding];
  for n in pv.extra_bindings {
    names = names.append(n);
  }
  for k in 0..names.len() {
    if (names[k] != "_") {
      let v = define(s, ssasem.variant_get(), [scrut], k, pv.type_name, fields[k]);
      if (util.index_of_str(v.s.names, names[k]) >= 0) {
        s = replace(v.s, names[k], v.id);
      } else {
        s = bind(v.s, names[k], v.id);
      }
    }
  }
  return s;
}

struct Gate { s: State, from: i32 }

function guard_gate(a: ast.MatchArm, s: State, next: i32): Gate {
  if (!a.has_guard) {
    return Gate { s: s, from: -1 };
  }
  let g = expr(a.guard, s, typeinfo.t_bool());
  s = g.s;
  if (!s.ok) {
    return Gate { s: s, from: -1 };
  }
  if (!is_bool(s.values[g.id])) {
    return Gate { s: fail(s, "match guard type"), from: -1 };
  }
  let pred = s.cur.id;
  let body = s.next_block;
  s = terminate(State { ...s, next_block: body + 1 }, ssa.t_brif(g.id, body, next));
  return Gate { s: open(s, body, [pred]), from: pred };
}

function next_preds(pred: i32, from: i32): i32[] {
  if (from >= 0) {
    return [pred, from];
  }
  return [pred];
}

function unqualified(pv: ast.PatVariant, owner: string): ast.PatVariant {
  if (!qualified(pv.type_name)) {
    return pv;
  }
  let dot = util.index_of_sub(pv.type_name, ".");
  if (!util.str_range_eq(pv.type_name, 0, dot, owner)) {
    return pv;
  }
  return ast.PatVariant { ...pv, type_name: slice_unchecked(pv.type_name, dot + 1, pv.type_name.len()).to_owned() };
}

function variant_arm(a: ast.MatchArm, pv: ast.PatVariant, scrut: i32, owner: string, layout: i32, arms: Arms, entry: i32[], join: i32, count: i32, scope: checker.Scope, closing: boolean, ty: typeinfo.Type): Arms {
  let g = parts(arms);
  let s = arms.s;
  pv = unqualified(pv, owner);
  // The checker admits a bare variant name against a generic enum's instance
  // when the scrutinee's type reaches it in generic form, as the type of a
  // name a struct pattern binds does. The scrutinee is the instance here, so
  // the arm takes the instance's variant, by declaration order as a literal
  // pattern does.
  pv = ast.PatVariant { ...pv, type_name: literal_variant_name(s, s.values[scrut], pv.type_name) };
  let shape: Payloads = match (pattern_payloads(a, pv, arm_payloads(s, s.values[scrut], pv.type_name, layout), layout)) { Ok(value) => value, Err(why) => { return gathered(fail(s, why), g); } };
  if (closing) {
    return closing_arm(a, pv, scrut, shape, s, g, entry, join, count, scope, layout, ty);
  }
  let pred = s.cur.id;
  let id = s.next_block;
  let next = id + 1;
  s = State { ...s, next_block: next + 1 };
  let test = define(s, ssasem.variant_is(), [scrut], 0, pv.type_name, typeinfo.t_bool());
  s = terminate(test.s, ssa.t_brif(test.id, id, next));
  let opened = payloads(pv, scrut, shape.types, open(State { ...s, vals: entry }, id, [pred]), layout);
  opened = State { ...opened, scope: checker.arm_scope(a, scope, opened.values[scrut]) };
  let gate = guard_gate(a, opened, next);
  if (!gate.s.ok) {
    return gathered(gate.s, g);
  }
  let from = gate.from;
  let done = arm_body(a.body, gate.s, join, count, scope, ty);
  done = Arm { ...done, s: open(State { ...done.s, vals: entry }, next, next_preds(pred, from)) };
  return collect(g, done);
}

function closing_arm(a: ast.MatchArm, pv: ast.PatVariant, scrut: i32, shape: Payloads, s: State, g: Gathered, entry: i32[], join: i32, count: i32, scope: checker.Scope, layout: i32, ty: typeinfo.Type): Arms {
  let pred = s.cur.id;
  let id = s.next_block;
  s = terminate(State { ...s, next_block: id + 1 }, ssa.t_br(id));
  let opened = payloads(pv, scrut, shape.types, open(State { ...s, vals: entry }, id, [pred]), layout);
  opened = State { ...opened, scope: checker.arm_scope(a, scope, opened.values[scrut]) };
  return collect(g, arm_body(a.body, opened, join, count, scope, ty));
}

function wildcard_arm(a: ast.MatchArm, arms: Arms, entry: i32[], join: i32, count: i32, scope: checker.Scope, ty: typeinfo.Type): Arms {
  let g = parts(arms);
  let s = arms.s;
  let pred = s.cur.id;
  let id = s.next_block;
  if (!a.has_guard) {
    s = terminate(State { ...s, next_block: id + 1 }, ssa.t_br(id));
    return collect(g, arm_body(a.body, open(State { ...s, vals: entry }, id, [pred]), join, count, scope, ty));
  }
  let next = id + 1;
  s = terminate(State { ...s, next_block: next + 1 }, ssa.t_br(id));
  let gate = guard_gate(a, open(State { ...s, vals: entry }, id, [pred]), next);
  if (!gate.s.ok) {
    return gathered(gate.s, g);
  }
  let from = gate.from;
  let done = arm_body(a.body, gate.s, join, count, scope, ty);
  done = Arm { ...done, s: open(State { ...done.s, vals: entry }, next, [from]) };
  return collect(g, done);
}

function match_arm(a: ast.MatchArm, scrut: i32, owner: string, layout: i32, arms: Arms, entry: i32[], join: i32, count: i32, scope: checker.Scope, closing: boolean, ty: typeinfo.Type): Arms {
  match (a.pattern) {
    ast.PatLiteral(literal) => {
      return scalar_arm(a, scrut, arms, entry, join, count, scope, closing, ty);
    },
    ast.PatWildcard(_) => {
      return wildcard_arm(a, arms, entry, join, count, scope, ty);
    },
    ast.PatVariant(pv) => {
      if (pv.scalar_binding) {
        return scalar_arm(a, scrut, arms, entry, join, count, scope, true, ty);
      }
      return variant_arm(a, pv, scrut, owner, layout, arms, entry, join, count, scope, closing, ty);
    }
  }
}

struct ScalarGate { s: State, hit: i32[], miss: i32[] }

function scalar_literal_gate(literal: ast.PatLiteral, scrut: i32, s: State, hit: i32, miss: i32): ScalarGate {
  let low = expr(literal.lit, s, s.values[scrut]);
  if (!low.s.ok) {
    return ScalarGate { s: low.s, hit: [], miss: [] };
  }
  let op: string = if (literal.has_range) { ">=" } else { "==" };
  let test = define(low.s, ssa.BINARY, [scrut, low.id], 0, op, typeinfo.t_bool());
  let pred = test.s.cur.id;
  if (!literal.has_range) {
    return ScalarGate { s: terminate(test.s, ssa.t_brif(test.id, hit, miss)), hit: [pred], miss: [pred] };
  }
  let upper = test.s.next_block;
  s = terminate(State { ...test.s, next_block: upper + 1 }, ssa.t_brif(test.id, upper, miss));
  let high = expr(literal.range_hi, open(s, upper, [pred]), s.values[scrut]);
  if (!high.s.ok) {
    return ScalarGate { s: high.s, hit: [], miss: [] };
  }
  let upper_op: string = if (literal.range_inclusive) { "<=" } else { "<" };
  let test_high = define(high.s, ssa.BINARY, [scrut, high.id], 0, upper_op, typeinfo.t_bool());
  let upper_pred = test_high.s.cur.id;
  return ScalarGate { s: terminate(test_high.s, ssa.t_brif(test_high.id, hit, miss)), hit: [upper_pred], miss: [pred, upper_pred] };
}

function bind_scalar_pattern(a: ast.MatchArm, scrut: i32, s: State): State {
  let cells: string[] = [];
  match (a.pattern) {
    ast.PatVariant(pv) => {
      cells = pv.scalar_cells;
      s = bind_var(s, pv.type_name, scrut);
      if (pv.at_binding.len() > 0) {
        s = bind_var(s, pv.at_binding, scrut);
      }
    },
    ast.PatLiteral(literal) => {
      cells = literal.scalar_cells;
      if (literal.at_binding.len() > 0) {
        s = bind_var(s, literal.at_binding, scrut);
      }
    },
    ast.PatWildcard(_) => {}
  }
  let whole = s.values[scrut];
  s = State { ...s, scope: checker.arm_scope(a, s.scope, whole) };
  for name in cells {
    let init: ast.Expr = ast.ExprIdent { name: name, line: a.line, col: a.col, ty: "", builtin: false };
    s = stmt(capturebox.cell_decl(name, typeinfo.spelling(whole), init, a.line, a.col), s);
  }
  return s;
}

function scalar_arm(a: ast.MatchArm, scrut: i32, arms: Arms, entry: i32[], join: i32, count: i32, scope: checker.Scope, closing: boolean, ty: typeinfo.Type): Arms {
  let g = parts(arms);
  let s = arms.s;
  let pred = s.cur.id;
  let id = s.next_block;
  let next = id + 1;
  s = State { ...s, next_block: next + 1 };
  let branch = ScalarGate { s: terminate(s, ssa.t_br(id)), hit: [pred], miss: [] };
  if (!closing) {
    if let ast.PatLiteral(literal) = a.pattern {
      branch = scalar_literal_gate(literal, scrut, s, id, next);
    }
  }
  if (!branch.s.ok) {
    return gathered(branch.s, g);
  }
  let opened = bind_scalar_pattern(a, scrut, open(State { ...branch.s, vals: entry }, id, branch.hit));
  let gate = guard_gate(a, opened, next);
  if (!gate.s.ok) {
    return gathered(gate.s, g);
  }
  let missed = branch.miss;
  let missed_envs: i32[][] = [];
  for _ in branch.miss {
    missed_envs = missed_envs.append(prefix(entry, count));
  }
  if (gate.from >= 0) {
    missed = missed.append(gate.from);
    missed_envs = missed_envs.append(prefix(gate.s.vals, count));
  }
  let done = arm_body(a.body, gate.s, join, count, scope, ty);
  if (missed.len() > 0) {
    let next_state = open(State { ...done.s, vals: entry }, next, missed);
    done = Arm { ...done, s: merge_env(next_state, missed_envs, count) };
  }
  return collect(g, done);
}

function variant_names(s: State, whole: typeinfo.Type, layout: i32): string[] {
  return inhabited_names(typed_variants(s, whole));
}

function inhabited_names(variants: semrecords.Variant[]): string[] {
  let out: string[] = [];
  for v in variants {
    if (semrecords.inhabited(v)) {
      out = out.append(v.name);
    }
  }
  return out;
}

function arm_variant_name(a: ast.MatchArm, owner: string): string {
  if (a.has_guard || a.alt_cont) {
    return "";
  }
  if let ast.PatVariant(pv) = a.pattern {
    return unqualified(pv, owner).type_name;
  }
  return "";
}

function total_match(m: ast.StmtMatch, whole: typeinfo.Type, variants: semrecords.Variant[]): boolean {
  let declared = inhabited_names(variants);
  if (declared.len() == 0 || m.arms.len() == 0 || m.arms[m.arms.len() - 1].has_guard) {
    return false;
  }
  let named: string[] = [];
  for a in m.arms {
    if (a.has_guard) {
      continue;
    }
    let name = arm_variant_name(a, typeinfo.union_name(whole));
    if (util.index_of_str(declared, name) < 0) {
      return false;
    }
    if (util.index_of_str(named, name) >= 0) {
      return false;
    }
    named = named.append(name);
  }
  return named.len() == declared.len();
}

function match_stmt(m: ast.StmtMatch, s: State): State {
  let c = match_chain(m, s, typeinfo.unchecked());
  let arms = c.arms;
  s = arms.s;
  if (!s.ok) {
    return s;
  }
  if (s.live) {
    arms = Arms { ...arms, preds: arms.preds.append(s.cur.id), envs: arms.envs.append(prefix(s.vals, c.count)) };
    s = terminate(s, ssa.t_br(c.join));
  }
  if (arms.preds.len() == 0) {
    return s;
  }
  return merge_env(open(s, c.join, arms.preds), arms.envs, c.count);
}

struct Chain { arms: Arms, join: i32, count: i32 }

function learn_escaping(m: ast.StmtMatch, s: State, whole: typeinfo.Type, owner: string, layout: i32): State {
  if (s.escaping.len() == s.learned.len()) {
    return s;
  }
  for a in m.arms {
    if let ast.PatVariant(raw) = a.pattern {
      let pv = unqualified(raw, owner);
      let types: typeinfo.Type[] = if (layout == semrecords.layout_member()) { [member_type(pv)] } else { match (arm_payloads(s, whole, pv.type_name, layout)) { Some(shape) => shape.types, None => [] } };
      let names: string[] = [pv.binding];
      for n in pv.extra_bindings {
        names = names.append(n);
      }
      let k = 0;
      while (k < names.len() && k < types.len()) {
        if (util.index_of_str(s.escaping, names[k]) >= 0 && util.index_of_str(s.learned, names[k]) < 0 && semtypes.concrete(types[k], false)) {
          s = State { ...s, learned: s.learned.append(names[k]), learned_types: s.learned_types.append(types[k]) };
        }
        k += 1;
      }
    }
  }
  return s;
}

function only_wildcards(m: ast.StmtMatch): boolean {
  for a in m.arms {
    if let ast.PatWildcard(_) = a.pattern {} else {
      return false;
    }
  }
  return m.arms.len() > 0;
}

function no_chain(s: State): Chain {
  return Chain { arms: Arms { s: s, preds: [], envs: [], values: [] }, join: 0, count: 0 };
}

function scalar_match_type(t: typeinfo.Type): boolean {
  return ssasem.is_integer(t) || ssasem.is_float(t) || ssasem.is_bool(t) || ssasem.is_char(t) || ssasem.is_string(t);
}

function supported_match_scrutinee(m: ast.StmtMatch, owner: string, layout: i32, scalar: boolean): boolean {
  return owner != "" && layout != 0 || scalar || only_wildcards(m);
}

function match_chain(m: ast.StmtMatch, s: State, ty: typeinfo.Type): Chain {
  let produced = expr(m.scrutinee, s, typeinfo.unchecked());
  let scrut = produced.id;
  s = produced.s;
  if (!s.ok) {
    return no_chain(s);
  }
  let whole = s.values[scrut];
  let owner = typeinfo.union_name(whole);
  let layout = union_layout(s, owner);
  let variants = laid_variants(s, whole, layout);
  m = inhabited_arms(m, whole, variants);
  let scalar = scalar_match_type(whole);
  if (!supported_match_scrutinee(m, owner, layout, scalar)) {
    return no_chain(fail(s, "unsupported match scrutinee"));
  }
  let closes: i32 = -1;
  if (total_match(m, whole, variants)) {
    closes = m.arms.len() - 1;
  }
  if (ssasem.is_bool(whole) && scalar_boolean_total(m)) {
    closes = m.arms.len() - 1;
  }
  s = learn_escaping(m, s, whole, owner, layout);
  let join = s.next_block;
  s = State { ...s, next_block: join + 1 };
  let count = s.names.len();
  let entry = s.vals;
  let scope = s.scope;
  let arms = Arms { s: s, preds: [], envs: [], values: [] };
  let i = 0;
  while (i < m.arms.len() && arms.s.ok && arms.s.live) {
    let current: i32[] = if (scalar) { arms.s.vals } else { entry };
    arms = match_arm(m.arms[i], scrut, owner, layout, arms, current, join, count, scope, i == closes, ty);
    i += 1;
  }
  return Chain { arms: arms, join: join, count: count };
}

function scalar_boolean_total(m: ast.StmtMatch): boolean {
  let yes = false;
  let no = false;
  for a in m.arms {
    if (!a.has_guard) {
      if let ast.PatLiteral(literal) = a.pattern {
        if let ast.ExprBool(value) = literal.lit {
          yes = yes || value.value;
          no = no || !value.value;
        }
      }
    }
  }
  return yes && no;
}

function inhabited_arms(m: ast.StmtMatch, whole: typeinfo.Type, variants: semrecords.Variant[]): ast.StmtMatch {
  let absent: string[] = [];
  for v in variants {
    if (!semrecords.inhabited(v)) {
      absent = absent.append(v.name);
    }
  }
  if (absent.len() == 0) {
    return m;
  }
  let arms: ast.MatchArm[] = [];
  for a in m.arms {
    let name = "";
    if let ast.PatVariant(pv) = a.pattern {
      name = unqualified(pv, typeinfo.union_name(whole)).type_name;
    }
    if (util.index_of_str(absent, name) < 0) {
      arms = arms.append(a);
    }
  }
  return ast.StmtMatch { ...m, arms: arms };
}

function value_match(m: ast.StmtMatch, s: State, ty: typeinfo.Type): Value {
  let c = match_chain(m, s, ty);
  s = c.arms.s;
  if (!s.ok) {
    return Value { s: s, id: -1 };
  }
  if (s.live) {
    return refused(s, "value block match falls through");
  }
  if (c.arms.preds.len() == 0) {
    return unreachable_value(s, ty);
  }
  s = merge_env(open(s, c.join, c.arms.preds), c.arms.envs, c.count);
  return merge_arms(s, c.arms.values, ty);
}

function current_loop(s: State): Loop {
  return s.loops[s.loops.len() - 1];
}

function leave_loop(s: State, label: string, is_break: boolean): State {
  if (s.loops.len() == 0) {
    return fail(s, "loop exit outside a loop");
  }
  let at = s.loops.len() - 1;
  if (label != "") {
    at = -1;
    for i in 0..s.loops.len() {
      if (s.loops[i].label == label) {
        at = i;
      }
    }
    if (at < 0) {
      return fail(s, "loop exit names no enclosing loop");
    }
  }
  let l = s.loops[at];
  let e = Exit { block: s.cur.id, env: prefix(s.vals, l.entry_count) };
  if (is_break) {
    s = with_loop_at(s, at, Loop { ...l, breaks: l.breaks.append(e) });
    return terminate(s, ssa.t_br(l.exit));
  }
  s = with_loop_at(s, at, Loop { ...l, continues: l.continues.append(e) });
  return terminate(s, ssa.t_br(l.next));
}

function with_loop_at(s: State, at: i32, l: Loop): State {
  return State { ...s, loops: s.loops.with(at, l) };
}

function header_phis(s: State, count: i32): State {
  for at in 0..count {
    let entry = s.vals[at];
    let name = s.names[at];
    let phi = define(s, ssa.PHI, [entry], 0, "", s.values[entry]);
    s = note_binding(State { ...phi.s, vals: phi.s.vals.with(at, phi.id) }, name, phi.id);
  }
  return s;
}

function complete_header(s: State, header: i32, exits: Exit[]): State {
  let i = 0;
  while (i < s.blocks.len() && s.blocks[i].id != header) {
    i += 1;
  }
  if (i == s.blocks.len()) {
    return fail(s, "loop header is still open");
  }
  let b = s.blocks[i];
  let preds = b.preds;
  let insts = b.insts;
  for e in exits {
    preds = preds.append(e.block);
    for at in 0..e.env.len() {
      let phi = insts[at];
      insts = insts.with(at, ssa.SInst { ...phi, args: phi.args.append(e.env[at]) });
    }
  }
  return State { ...s, blocks: s.blocks.with(i, ssa.SBlock { ...b, preds: preds, insts: insts }) };
}

function iterate(w: ast.StmtWhile, s: State): State {
  let pred = s.cur.id;
  let header = s.next_block;
  let body = header + 1;
  let exit_id = header + 2;
  s = State { ...s, next_block: exit_id + 1 };
  let count = s.names.len();
  let scope = s.scope;
  s = terminate(s, ssa.t_br(header));
  s = header_phis(open(s, header, [pred]), count);
  let entry_env = s.vals;
  s = State { ...s, loops: s.loops.append(Loop { label: w.label, header: header, next: header, exit: exit_id, entry_count: count, breaks: [], continues: [] }) };
  let c = cond(w.cond, s, body, exit_id);
  s = c.s;
  if (!s.ok) {
    return s;
  }
  let latch = arm(w.body, s, entry_env, body, c.yes, header, count, scope);
  s = latch.s;
  if (!s.ok) {
    return s;
  }
  let l = current_loop(s);
  s = State { ...s, loops: prefix_loops(s.loops, s.loops.len() - 1) };
  let back = l.continues;
  if (latch.live) {
    back = back.append(Exit { block: latch.end, env: latch.env });
  }
  s = complete_header(s, header, back);
  let preds = c.no;
  let envs: i32[][] = [];
  for _ in c.no {
    envs = envs.append(entry_env);
  }
  for e in l.breaks {
    preds = preds.append(e.block);
    envs = envs.append(e.env);
  }
  return merge_env(open(s, exit_id, preds), envs, count);
}

function index_name(): string {
  return "for index";
}

function iterate_array(fo: ast.StmtFor, s: State): State {
  if (fo.var_name == "") {
    return fail(s, "unsupported loop binding");
  }
  let produced = expr(fo.iter, s, typeinfo.unchecked());
  s = produced.s;
  if (!s.ok) {
    return s;
  }
  let it = produced.id;
  let text = ssasem.is_text(s.values[it]);
  let elem = typeinfo.array_elem(s.values[it]);
  if (text) {
    elem = typeinfo.t_u8();
  }
  let vals: i32 = -1;
  let vtype = typeinfo.unchecked();
  if (ssasem.is_map(s.values[it])) {
    let m = s.values[it];
    if (!ssasem.is_supported_map(m)) {
      return fail(s, "unsupported iterable: " + typeinfo.spelling(m));
    }
    let keys = map_column(s, it, ssasem.map_keys(), ssasem.map_key(m));
    if (!keys.s.ok) {
      return keys.s;
    }
    let values = map_column(keys.s, it, ssasem.map_values(), ssasem.map_value(m));
    if (!values.s.ok) {
      return values.s;
    }
    s = values.s;
    it = keys.id;
    vals = values.id;
    vtype = ssasem.map_value(m);
    elem = ssasem.map_key(m);
  }
  if (!semtypes.concrete(elem, false)) {
    return fail(s, "unsupported iterable: " + typeinfo.spelling(s.values[it]));
  }
  let before = s.names.len();
  let outer = s.scope;
  let start = define(s, ssa.CONST_INT, [], 0, "", typeinfo.t_i32());
  s = bind(start.s, index_name(), start.id);

  let pred = s.cur.id;
  let header = s.next_block;
  let body_id = header + 1;
  let step_id = header + 2;
  let exit_id = header + 3;
  s = State { ...s, next_block: exit_id + 1 };
  let count = s.names.len();
  let scope = s.scope;
  s = terminate(s, ssa.t_br(header));
  s = header_phis(open(s, header, [pred]), count);
  s = State { ...s, loops: s.loops.append(Loop { label: fo.label, header: header, next: step_id, exit: exit_id, entry_count: count, breaks: [], continues: [] }) };

  let at = lookup(s, index_name());
  let n = define(s, ssasem.length(), [it], 0, "", typeinfo.t_i32());
  let test = define(n.s, ssa.BINARY, [at, n.id], 0, "<", typeinfo.t_bool());
  s = test.s;
  if (!s.ok) {
    return s;
  }
  let cond_end = s.cur.id;
  let held = s.vals;
  s = terminate(s, ssa.t_brif(test.id, body_id, exit_id));

  let opened = open(State { ...s, vals: held }, body_id, [cond_end]);
  let read = ssasem.array_get();
  if (text) {
    read = ssasem.str_index();
  }
  let item = define(opened, read, [it, at], 1, "", elem);
  let inner = checker.for_body_scope(fo, scope);
  let body_state = bind_var(item.s, fo.var_name, item.id);
  if (vals >= 0) {
    let names = checker.split_pattern_names(fo.var_name);
    if (names.len() != 2) {
      return fail(body_state, "unsupported loop binding");
    }
    let vitem = define(item.s, ssasem.array_get(), [vals, at], 1, "", vtype);
    body_state = bind_position(bind_position(vitem.s, names[0], item.id, inner), names[1], vitem.id, inner);
  } else if (util.contains(fo.var_name, ",")) {
    body_state = destructure_tuple(fo.var_name, item.id, item.s, inner);
  }
  if (!body_state.ok) {
    return body_state;
  }
  s = stmts(fo.body, State { ...body_state, scope: inner });
  if (!s.ok) {
    return s;
  }
  let l = current_loop(s);
  s = State { ...s, loops: prefix_loops(s.loops, s.loops.len() - 1) };
  s = step_index(leave(s, count, scope), step_id, header, l.continues, count);
  let preds: i32[] = [cond_end];
  let envs: i32[][] = [held];
  for e in l.breaks {
    preds = preds.append(e.block);
    envs = envs.append(e.env);
  }
  s = merge_env(open(s, exit_id, preds), envs, count);
  return leave(s, before, outer);
}

// The body's last block steps the index, as a while loop's latch does. Only a
// `continue` that targets the loop needs the step block.
function step_index(s: State, step_id: i32, header: i32, continues: Exit[], count: i32): State {
  if (continues.len() > 0) {
    let preds: i32[] = [];
    let envs: i32[][] = [];
    for e in continues {
      preds = preds.append(e.block);
      envs = envs.append(e.env);
    }
    if (s.live) {
      preds = preds.append(s.cur.id);
      envs = envs.append(prefix(s.vals, count));
      s = terminate(s, ssa.t_br(step_id));
    }
    s = merge_env(open(s, step_id, preds), envs, count);
  }
  if (!s.live) {
    return s;
  }
  let one = define(s, ssa.CONST_INT, [], 1, "", typeinfo.t_i32());
  let step = define(one.s, ssa.BINARY, [lookup(one.s, index_name()), one.id], 0, "+", typeinfo.t_i32());
  s = replace(step.s, index_name(), step.id);
  let back = Exit { block: s.cur.id, env: prefix(s.vals, count) };
  s = terminate(s, ssa.t_br(header));
  return complete_header(s, header, [back]);
}

function bind_position(s: State, name: string, id: i32, after: checker.Scope): State {
  if (name.len() > 0 && name[0] == b'(') {
    return destructure_tuple(slice_unchecked(name, 1, name.len() - 1).to_owned(), id, s, after);
  }
  return bind_var(s, name, id);
}

function prefix_loops(xs: Loop[], n: i32): Loop[] {
  let out: Loop[] = [];
  for i in 0..n {
    out = out.append(xs[i]);
  }
  return out;
}

function discard(e: ast.Expr, s: State): State {
  if let ast.ExprCall(c) = e {
    if (parser.is_value_block(c) && typeinfo.is_void(block_type(e, c, s, typeinfo.t_void()))) {
      return stmts(discarded_tail(parser.vb_body(c)), s);
    }
    return call(e, c, s, true, typeinfo.t_void()).s;
  }
  return expr(e, s, typeinfo.unchecked()).s;
}

// The tail of a value block yields its value, as in value_block: a tail
// return of a value, or the tails of the arms of a tail if or match. A
// discarded block evaluates each of those values as a statement, and does
// not return. A bare return yields nothing, so it stays a return.
function discarded_tail(body: ast.Stmt[]): ast.Stmt[] {
  if (body.len() == 0) {
    return body;
  }
  let out: ast.Stmt[] = [];
  for i in 0..body.len() - 1 {
    out = out.append(body[i]);
  }
  let tail = body[body.len() - 1];
  if let ast.StmtReturn(r) = tail {
    if (parser.bare_return(r.value)) {
      return body;
    }
    return out.append(ast.StmtExpr { value: r.value, line: r.line, op: "" });
  }
  if let ast.StmtIf(f) = tail {
    return out.append(ast.StmtIf { ...f, then_body: discarded_tail(f.then_body), else_body: discarded_tail(f.else_body) });
  }
  if let ast.StmtMatch(m) = tail {
    let arms: ast.MatchArm[] = [];
    for arm in m.arms {
      arms = arms.append(ast.MatchArm { ...arm, body: discarded_tail(arm.body) });
    }
    return out.append(ast.StmtMatch { ...m, arms: arms });
  }
  return body;
}

function stmt(st: ast.Stmt, s: State): State {
  if (!s.ok || !s.live) {
    return s;
  }
  if (s.debug_lines) {
    s = line_mark(st, s);
  }
  match (st) {
    ast.StmtVar(v) => {
      return declare(st, v, s);
    },
    ast.StmtExpr(e) => {
      return discard(e.value, s);
    },
    ast.StmtAssign(a) => {
      return assign(a, s);
    },
    ast.StmtReturn(r) => {
      return ret(r, s);
    },
    ast.StmtIf(f) => {
      if (f.origin == "block" || f.origin == "unsafe") {
        return stmts(f.then_body, s);
      }
      return branch(f, s);
    },
    ast.StmtWhile(w) => {
      return iterate(w, s);
    },
    ast.StmtMatch(m) => {
      return match_stmt(m, s);
    },
    ast.StmtBreak(b) => {
      return leave_loop(s, b.label, true);
    },
    ast.StmtContinue(c) => {
      return leave_loop(s, c.label, false);
    },
    ast.StmtFor(fo) => {
      return iterate_array(fo, s);
    },
    _ => {
      return fail(s, "unsupported statement");
    }
  }
}

function line_mark(st: ast.Stmt, s: State): State {
  let v = define(s, ssa.LINE, [], ast.stmt_line(st), util.i32_to_string(ast.stmt_col(st)), typeinfo.t_void());
  return v.s;
}

function stmts(body: ast.Stmt[], s: State): State {
  let count = s.names.len();
  let scope = s.scope;
  for st in body {
    s = stmt(st, s);
  }
  return leave(s, count, scope);
}

function resolve(map: i32[], v: i32): i32 {
  while (map[v] != v) {
    v = map[v];
  }
  return v;
}

function trivial_source(ins: ssa.SInst, map: i32[]): i32 {
  let source: i32 = -1;
  for arg in ins.args {
    let v = resolve(map, arg);
    if (v == ins.result) {
      continue;
    }
    if (source >= 0 && v != source) {
      return -1;
    }
    source = v;
  }
  return source;
}

function trivial_phis(blocks: ssa.SBlock[], nvals: i32): i32[] {
  let map: i32[] = [];
  for i in 0..nvals {
    map = map.append(i);
  }
  let changed = true;
  while (changed) {
    changed = false;
    for b in blocks {
      for ins in b.insts {
        if (ins.kind_tag != ssa.PHI || map[ins.result] != ins.result) {
          continue;
        }
        let source = trivial_source(ins, map);
        if (source >= 0) {
          map = map.with(ins.result, source);
          changed = true;
        }
      }
    }
  }
  return map;
}

function mapped_args(args: i32[], map: i32[]): i32[] {
  let out: i32[] = [];
  for a in args {
    out = out.append(resolve(map, a));
  }
  return out;
}

function mapped_term(t: ssa.STerm, map: i32[]): ssa.STerm {
  if (t.kind_tag == ssa.TERM_RET && t.value >= 0) {
    return ssa.STerm { ...t, value: resolve(map, t.value) };
  }
  if (t.kind_tag == ssa.TERM_BRIF) {
    return ssa.STerm { ...t, cond: resolve(map, t.cond) };
  }
  return t;
}

function reached(blocks: ssa.SBlock[], at: i32[]): boolean[] {
  let seen = __alloc_bool(at.len());
  seen = seen.with(blocks[0].id, true);
  let work: i32[] = [blocks[0].id];
  let head = 0;
  while (head < work.len()) {
    for next in ssa.successors(blocks[at[work[head]]].term) {
      if (next < at.len() && at[next] >= 0 && !seen[next]) {
        seen = seen.with(next, true);
        work = work.append(next);
      }
    }
    head += 1;
  }
  return seen;
}

function live_edges(b: ssa.SBlock, seen: boolean[]): ssa.SBlock {
  let keep: i32[] = [];
  for k in 0..b.preds.len() {
    if (seen[b.preds[k]]) {
      keep = keep.append(k);
    }
  }
  if (keep.len() == b.preds.len()) {
    return b;
  }
  let preds: i32[] = [];
  for j in keep {
    preds = preds.append(b.preds[j]);
  }
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag != ssa.PHI) {
      insts = insts.append(ins);
      continue;
    }
    let args: i32[] = [];
    for j in keep {
      args = args.append(ins.args[j]);
    }
    insts = insts.append(ssa.SInst { ...ins, args: args });
  }
  return ssa.SBlock { ...b, insts: insts, preds: preds };
}

function reachable(blocks: ssa.SBlock[]): ssa.SBlock[] {
  let seen = reached(blocks, ssa.positions_of(blocks));
  let out: ssa.SBlock[] = [];
  for b in blocks {
    if (seen[b.id]) {
      out = out.append(live_edges(b, seen));
    }
  }
  return out;
}

function renumber(blocks: ssa.SBlock[], map: i32[], values: typeinfo.Type[], dbg_vals: i32[], dbg_names: string[]): ssasem.Func {
  let has_lines = false;
  let ids = util.minus_ones(map.len());
  let kept: typeinfo.Type[] = [];
  for b in blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssa.LINE) {
        has_lines = true;
        continue;
      }
      if (map[ins.result] != ins.result) {
        continue;
      }
      ids = ids.with(ins.result, kept.len());
      kept = kept.append(values[ins.result]);
    }
  }
  let out: ssa.SBlock[] = [];
  for b in blocks {
    out = out.append(renumber_block(b, map, ids));
  }
  let graph = ssa.SFunc { name: "", nparams: 0, nvals: kept.len(), blocks: out, entry: 0, takes_env: false };
  let f = ssasem.Func { source_positions: sourcepos.no_source(), graph: graph, values: kept, params: [], result: typeinfo.t_void(), records: semrecords.no_records(), enums: [], calls: [], envs: [], anchors: [], dyns: [], shadows: [], finalizers: [], map_module: false, dbg_vals: [], dbg_names: [], schema_checked: false };
  if (has_lines) {
    f = ssasem.Func { ...f, source_positions: renumber_source(blocks, map, ids, kept.len()) };
  }
  return renumber_bindings(f, map, ids, dbg_vals, dbg_names);
}

function renumber_bindings(f: ssasem.Func, map: i32[], ids: i32[], dbg_vals: i32[], dbg_names: string[]): ssasem.Func {
  for d in 0..dbg_vals.len() {
    let id = ids[resolve(map, dbg_vals[d])];
    if (id >= 0) {
      f = ssasem.Func { ...f, dbg_vals: f.dbg_vals.append(id), dbg_names: f.dbg_names.append(dbg_names[d]) };
    }
  }
  return f;
}

function external_entry(): Produced {
  return Produced { ...refuse("external declaration"), bodyless: true };
}

function reference(t: typeinfo.Type): boolean {
  return semtypes.needs_anchor(t);
}

function mode(p: ast.ParamDecl, t: typeinfo.Type): i32 {
  if (!reference(t)) {
    return ssaunits.value_mode();
  }
  if (p.own) {
    return ssaunits.counted_mode();
  }
  return ssaunits.borrow_mode();
}

pub function has_receiver(fd: parser.FuncDecl): boolean {
  return fd.receiver_name.len() > 0;
}

function decl_param_names(fd: parser.FuncDecl): string[] {
  let out: string[] = [];
  if (has_receiver(fd)) {
    out = out.append(fd.receiver_name);
  }
  for p in fd.params {
    out = out.append(p.name);
  }
  return out;
}

function decl_param_mode(fd: parser.FuncDecl, at: i32, t: typeinfo.Type): i32 {
  if (!has_receiver(fd)) {
    return mode(fd.params[at], t);
  }
  if (at > 0) {
    return mode(fd.params[at - 1], t);
  }
  if (!reference(t)) {
    return ssaunits.value_mode();
  }
  if (fd.receiver_own) {
    return ssaunits.counted_mode();
  }
  return ssaunits.borrow_mode();
}

function coarse_fn_tag_without_contract(fd: parser.FuncDecl): boolean {
  return fd.ret_fn_ret.len() == 0 && parser.is_coarse_fn_tag(fd.ret_type);
}

function inferred_result(fd: parser.FuncDecl, scope: checker.Scope, b: ssasem.Binding, contracts: ssasem.Contract[]): typeinfo.Type {
  let (returned, at) = checker.first_returned(fd.body, scope);
  if (parser.bare_return(returned)) {
    return typeinfo.t_void();
  }
  if (calls_synthesised(returned)) {
    return called_synthesised_result(returned, contracts, b);
  }
  let constructed = closure_slot_type(returned, contracts);
  if (semtypes.concrete(constructed, false)) {
    return constructed;
  }
  if let ast.ExprIdent(id) = returned {
    let slot = closure_slot_type(slot_init(fd.body, id.name), contracts);
    if (semtypes.concrete(slot, false)) {
      return slot;
    }
  }
  let first = resolved(checker.expr_type(returned, at), generic_decl(fd), b, at);
  if (semtypes.concrete(first, true)) {
    return first;
  }
  let exits = settled(resolved(checker.exit_result(fd.body, scope), generic_decl(fd), b, scope));
  if (semtypes.concrete(exits, true)) {
    return exits;
  }
  return settled(first);
}

function closure_slot_type(init: ast.Expr, contracts: ssasem.Contract[]): typeinfo.Type {
  if let ast.ExprCall(c) = init {
    if let ast.ExprIdent(id) = c.callee {
      let body = parser.mkclo_body(id.name);
      if (body.len() == 0) {
        return typeinfo.unchecked();
      }
      let at = ssasem.find_contract_in(contracts, body);
      if (at < 0) {
        return typeinfo.unchecked();
      }
      let contract = contracts[at];
      if (!ssasem.closure_env(contract) || ssasem.contract_variables(contract).len() > 0) {
        return typeinfo.unchecked();
      }
      return ssasem.closure_type(contract);
    }
  }
  return typeinfo.unchecked();
}

function slot_init(body: ast.Stmt[], name: string): ast.Expr {
  for st in body {
    if let ast.StmtVar(v) = st {
      if (v.name == name) {
        return v.init;
      }
    }
    if let ast.StmtIf(f) = st {
      let then_init = slot_init(f.then_body, name);
      if (!ast.is_unknown(then_init)) {
        return then_init;
      }
      let else_init = slot_init(f.else_body, name);
      if (!ast.is_unknown(else_init)) {
        return else_init;
      }
    }
    if let ast.StmtMatch(m) = st {
      for arm in m.arms {
        let arm_init = slot_init(arm.body, name);
        if (!ast.is_unknown(arm_init)) {
          return arm_init;
        }
      }
    }
  }
  return parser.e_unknown("no such slot");
}

function calls_synthesised(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      return synthesised_name(id.name) && parser.mkclo_body(id.name).len() == 0;
    }
  }
  return false;
}

function called_synthesised_result(e: ast.Expr, contracts: ssasem.Contract[], b: ssasem.Binding): typeinfo.Type {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      let at = ssasem.find_contract_in(contracts, id.name);
      if (at >= 0) {
        return ssasem.substitute(contracts[at].result, b);
      }
    }
  }
  return typeinfo.unchecked();
}

function literal_adapts(returned: ast.Expr, declared: typeinfo.Type): boolean {
  if let ast.ExprNumber(_) = returned {
    return ssasem.is_integer(declared) || ssasem.is_float(declared);
  }
  return false;
}

function synthesised(fd: parser.FuncDecl): boolean {
  return synthesised_name(fd.name);
}

function synthesised_name(name: string): boolean {
  return name.starts_with("__lam_") || util.contains(name, "$iife");
}

function result_type(fd: parser.FuncDecl, scope: checker.Scope, b: ssasem.Binding, contracts: ssasem.Contract[]): typeinfo.Type {
  if (fd.ret_type.len() == 0) {
    return inferred_result(fd, scope, b, contracts);
  }
  let declared = resolved(scope.ret_type, generic_decl(fd), b, scope);
  if (synthesised(fd)) {
    let (returned, _) = checker.first_returned(fd.body, scope);
    if (!literal_adapts(returned, declared)) {
      let body = inferred_result(fd, scope, b, contracts);
      // `Ok(x)` infers `never` for the error, which the declaration completes.
      if (semtypes.concrete(body, true) && !typeinfo.is_void(body) && !completes_enum(body, declared)) {
        return body;
      }
      if (calls_synthesised(returned)) {
        return body;
      }
    }
  }
  if (!semtypes.concrete(declared, true) && coarse_fn_tag_without_contract(fd)) {
    return inferred_result(fd, scope, b, contracts);
  }
  return declared;
}

function is_closure_body(fd: parser.FuncDecl): boolean {
  return !has_receiver(fd) && fd.params.len() > 0 && fd.params[0].name == "__env";
}

function reads_env_slot(e: ast.Expr, slot: i32): boolean {
  if let ast.ExprIndex(ix) = e {
    if let ast.ExprIdent(id) = ix.array {
      if let ast.ExprNumber(n) = ix.index {
        return id.name == "__env" && n.text == util.i32_to_string(slot);
      }
    }
  }
  return false;
}

function env_captures(fd: parser.FuncDecl, scope: checker.Scope, template: boolean, b: ssasem.Binding): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let at = scope;
  for st in fd.body {
    let read = false;
    if let ast.StmtVar(v) = st {
      if (reads_env_slot(v.init, out.len() + 1)) {
        read = true;
        at = checker.bind_stmt(st, at);
        out = out.append(settled(resolved(checker.scope_type(at, v.name), template, b, at)));
      }
    }
    if (!read) {
      return out;
    }
  }
  return out;
}

function env_type(fd: parser.FuncDecl, scope: checker.Scope, template: boolean, b: ssasem.Binding, name: string): typeinfo.Type {
  let caps = env_captures(fd, scope, template, b);
  if (caps.len() == 0) {
    return typeinfo.TypeArray { elem: typeinfo.t_i32(), view: false };
  }
  return ssasem.env_type(name, caps);
}

function parameters(fd: parser.FuncDecl, s: State): State {
  let names = decl_param_names(fd);
  for at in 0..names.len() {
    let ty = bound_type(s, names[at], s.scope);
    if (at == 0 && is_closure_body(fd)) {
      ty = env_type(fd, s.scope, s.template, s.binding, s.name);
    }
    if (!semtypes.concrete(ty, true)) {
      return fail(s, "unresolved parameter type");
    }
    let m = decl_param_mode(fd, at, ty);
    let spelled = "";
    if (m == ssaunits.counted_mode()) {
      spelled = "own";
    }
    let p = define(s, ssa.PARAM, [], at, spelled, ty);
    let id = p.id;
    s = p.s;
    s = bind(State { ...s, modes: s.modes.append(m) }, names[at], id);
  }
  return s;
}

function refuse(why: string): Produced {
  let graph = ssa.SFunc { name: "", nparams: 0, nvals: 0, blocks: [], entry: 0, takes_env: false };
  return Produced { ok: false, why: why, func: ssasem.Func { source_positions: sourcepos.no_source(), graph: graph, values: [], params: [], result: typeinfo.t_void(), records: semrecords.no_records(), enums: [], calls: [], envs: [], anchors: [], dyns: [], shadows: [], finalizers: [], map_module: false, dbg_vals: [], dbg_names: [], schema_checked: false }, modes: [], template: false, key: "", requests: [], bodyless: false, analysis: None, view_escape: 0, dropped: false };
}

function initial(fd: parser.FuncDecl, scope: checker.Scope, contracts: ssasem.Contracts, binding: ssasem.Binding, name: string, handers: Handers, shadows: string[], views: string[], funcs: parser.FuncDecl[], impls: parser.ImplInfo[], debug_lines: boolean): State {
  let entry = ssa.SBlock { id: 0, insts: [], term: t_none(), preds: [] };
  return State {
    ok: true, why: "", blocks: [], cur: entry, live: true, next_block: 1, values: [],
    names: [], vals: [], scope: scope, result: result_type(fd, scope, binding, contracts.list), loops: [], contracts: contracts, calls: [],
    template: generic_decl(fd), binding: binding, requests: [], foreign: [], handers: handers, shadows: shadows, views: views,
    name: name, modes: [], funcs: funcs, impls: impls, try_cleanup: try_cleanup(fd.body), replaying: false, armed: 0, escaping: escaping_bindings(fd.body), learned: [], learned_types: [],
    narrowings: [], debug_lines: debug_lines, dbg_vals: [], dbg_names: [],
  };
}

function ident_uses(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprIdent(id) = e {
    return acc.append(id.name);
  }
  return acc;
}

function uses_in(stmts: ast.Stmt[], own acc: string[]): string[] {
  for st in stmts {
    acc = astwalk.fold_stmt_nodes(st, acc, astwalk.assign_target_of, ident_uses, astwalk.descend_all);
  }
  return acc;
}

function arm_local_uses(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtMatch(m) = st {
    for a in m.arms {
      if let ast.PatVariant(pv) = a.pattern {
        let local = uses_in(a.body, []);
        if (a.has_guard) {
          local = astwalk.fold_expr_nodes(a.guard, local, astwalk.assign_target_of, ident_uses, astwalk.descend_all);
        }
        let names: string[] = [pv.binding];
        for n in pv.extra_bindings {
          names = names.append(n);
        }
        for n in names {
          if (n == "" || n == "_") {
            continue;
          }
          acc = acc.append("=" + n);
          for u in local {
            if (u == n) {
              acc = acc.append(n);
            }
          }
        }
      }
    }
  }
  return acc;
}

function for_local_uses(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtFor(fr) = st {
    let local = uses_in(fr.body, []);
    for n in header_names(fr.var_name) {
      if (n == "" || n == "_") {
        continue;
      }
      acc = acc.append("=" + n);
      for u in local {
        if (u == n) {
          acc = acc.append(n);
        }
      }
    }
  }
  return acc;
}

function header_names(encoded: string): string[] {
  let out: string[] = [];
  for n in checker.split_pattern_names(encoded) {
    if (n.len() > 1 && n[0] == b'(') {
      for m in header_names(slice_unchecked(n, 1, n.len() - 1).to_owned()) {
        out = out.append(m);
      }
    } else {
      out = out.append(n);
    }
  }
  return out;
}

function var_local_uses(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtIf(f) = st {
    acc = list_var_uses(f.then_body, acc);
    acc = list_var_uses(f.else_body, acc);
  }
  if let ast.StmtWhile(w) = st {
    acc = list_var_uses(w.body, acc);
  }
  if let ast.StmtFor(fr) = st {
    acc = list_var_uses(fr.body, acc);
  }
  if let ast.StmtMatch(m) = st {
    for a in m.arms {
      acc = list_var_uses(a.body, acc);
    }
  }
  return acc;
}

function lambda_var_uses(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprLambda(l) = e {
    return list_var_uses(l.body, acc);
  }
  return acc;
}

function list_var_uses(stmts: ast.Stmt[], own acc: string[]): string[] {
  let names: string[] = [];
  for st in stmts {
    if let ast.StmtVar(v) = st {
      if (!destructures(v)) {
        names = names.append(v.name);
      }
    }
  }
  if (names.len() == 0) {
    return acc;
  }
  for n in names {
    acc = acc.append("=" + n);
  }
  let ix = util.name_index(names);
  for u in uses_in(stmts, []) {
    if (ix.has(u)) {
      acc = acc.append(u);
    }
  }
  return acc;
}

function escaping_bindings(body: ast.Stmt[]): string[] {
  if (!defer_lowered(body)) {
    return [];
  }
  let local = list_var_uses(body, []);
  for st in body {
    local = astwalk.fold_stmt_nodes(st, local, arm_local_uses, astwalk.keep_names, astwalk.descend_all);
    local = astwalk.fold_stmt_nodes(st, local, for_local_uses, astwalk.keep_names, astwalk.descend_all);
    local = astwalk.fold_stmt_nodes(st, local, var_local_uses, lambda_var_uses, astwalk.descend_all);
  }
  if (local.len() == 0) {
    return [];
  }
  let all = uses_in(body, []);
  let out: string[] = [];
  for d in local {
    if (d.len() < 2 || d[0] != b'=') {
      continue;
    }
    let n = slice_unchecked(d, 1, d.len()).to_owned();
    if (util.index_of_str(out, n) < 0 && util.count_str(all, n) > util.count_str(local, n)) {
      out = out.append(n);
    }
  }
  return out;
}

function defer_lowered(body: ast.Stmt[]): boolean {
  let found = false;
  for st in body {
    found = astwalk.fold_stmt_nodes(st, found, tryall_decl, astwalk.keep_flag, astwalk.descend_all);
  }
  return found;
}

function tryall_decl(st: ast.Stmt, own acc: boolean): boolean {
  if let ast.StmtVar(v) = st {
    return acc || v.name == parser.DFA_TRYALL;
  }
  return acc;
}

function try_cleanup(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for st in body {
    if let ast.StmtIf(f) = st {
      if let ast.ExprIdent(id) = f.cond {
        if (id.name == parser.DFA_TRYALL || id.name == parser.DFA_TRYERR) {
          for c in f.then_body {
            out = out.append(c);
          }
        }
      }
    }
  }
  return out;
}

function view_types(scope: checker.Scope, impls: parser.ImplInfo[], contracts: ssasem.Contracts): string[] {
  let names: string[] = [];
  let fn_keys: string[] = [];
  let fn_captures: typeinfo.Type[][] = [];
  for c in contracts.list {
    if (c.params.len() == 0 || !semtypes.is_env(c.params[0])) {
      continue;
    }
    fn_keys = fn_keys.append(func_view_key(ssasem.closure_type(c)));
    fn_captures = fn_captures.append(semtypes.env_captures(c.params[0]));
  }
  let changed = true;
  while (changed) {
    changed = false;
    for sig in scope.structs.structs {
      if (sig.type_params.len() > 0 || util.index_of_str(names, sig.name) >= 0) {
        continue;
      }
      if (types_hold_view(sig.field_types, names, impls)) {
        names = names.append(sig.name);
        changed = true;
      }
    }
    for sig in scope.structs.structs {
      if (sig.enum_owner.len() > 0 && util.index_of_str(names, sig.name) >= 0 && util.index_of_str(names, sig.enum_owner) < 0) {
        names = names.append(sig.enum_owner);
        changed = true;
      }
    }
    for k in 0..fn_keys.len() {
      if (util.index_of_str(names, fn_keys[k]) < 0 && types_hold_view(fn_captures[k], names, impls)) {
        names = names.append(fn_keys[k]);
        changed = true;
      }
    }
    for u in scope.unions.unions {
      if (util.index_of_str(names, u.name) >= 0) {
        continue;
      }
      for v in u.variants {
        if (util.index_of_str(names, v) >= 0 && util.index_of_str(names, u.name) < 0) {
          names = names.append(u.name);
          changed = true;
        }
      }
    }
  }
  return names;
}

function func_view_key(t: typeinfo.Type): string {
  return "fn " + ssasem.type_key(t);
}

function fields_nest_func(fields: semrecords.Field[]): boolean {
  for fl in fields {
    if (ssasem.nests_func(fl.ty)) {
      return true;
    }
  }
  return false;
}

function variants_nest_func(variants: semrecords.Variant[]): boolean {
  for v in variants {
    if (fields_nest_func(v.fields)) {
      return true;
    }
  }
  return false;
}

function fields_hold_view(fields: semrecords.Field[], views: string[], impls: parser.ImplInfo[]): boolean {
  for fl in fields {
    if (type_holds_view(fl.ty, views, impls)) {
      return true;
    }
  }
  return false;
}

function types_hold_view(ts: typeinfo.Type[], views: string[], impls: parser.ImplInfo[]): boolean {
  for t in ts {
    if (type_holds_view(t, views, impls)) {
      return true;
    }
  }
  return false;
}

function type_holds_view(t: typeinfo.Type, views: string[], impls: parser.ImplInfo[]): boolean {
  if let typeinfo.TypeString(st) = t {
    return st.tag == 1;
  }
  if let typeinfo.TypeArray(a) = t {
    return a.view || type_holds_view(a.elem, views, impls);
  }
  if let typeinfo.TypeTuple(tup) = t {
    return types_hold_view(tup.elements, views, impls);
  }
  if (typeinfo.is_cell(t)) {
    return type_holds_view(semtypes.cell_elem(t), views, impls);
  }
  if let typeinfo.TypeMap(m) = t {
    return type_holds_view(m.key, views, impls) || type_holds_view(m.value, views, impls);
  }
  if let typeinfo.TypeStruct(r) = t {
    return util.index_of_str(views, r.name) >= 0 || types_hold_view(r.args, views, impls);
  }
  if let typeinfo.TypeUnion(u) = t {
    return util.index_of_str(views, u.name) >= 0 || types_hold_view(u.args, views, impls);
  }
  if (ssasem.is_func(t)) {
    return util.index_of_str(views, func_view_key(t)) >= 0;
  }
  if (typeinfo.is_dyn(t)) {
    for n in dyn_impl_names(t, impls) {
      for v in views {
        if (v == n || v.starts_with(n + "__")) {
          return true;
        }
      }
    }
  }
  return false;
}

struct SchemaMemo { records: semrecords.Record[], record_names: util.NameIndex, enums: semrecords.Enum[], enum_names: util.NameIndex }

function no_memo(): SchemaMemo {
  let none: string[] = [];
  return SchemaMemo { records: [], record_names: util.name_index(none), enums: [], enum_names: util.name_index(none) };
}

struct Schemas { ok: boolean, why: string, records: semrecords.Record[], enums: semrecords.Enum[], memo: SchemaMemo, seen_r: boolean[], seen_e: boolean[] }

function schemas(types: typeinfo.Type[], s: State, memo: SchemaMemo): Schemas {
  let out = Schemas { ok: true, why: "", records: [], enums: [], memo: memo, seen_r: __alloc_bool(memo.records.len()), seen_e: __alloc_bool(memo.enums.len()) };
  let pending = types;
  let i = 0;
  while (i < pending.len()) {
    let nr = out.records.len();
    let ne = out.enums.len();
    out = schema_of(pending[i], s, out);
    if (!out.ok) {
      return out;
    }
    if (out.records.len() > nr || out.enums.len() > ne) {
      pending = named_by_schemas(out, nr, ne, pending);
    }
    i += 1;
  }
  return out;
}

function named_by_schemas(out: Schemas, nr: i32, ne: i32, pending: typeinfo.Type[]): typeinfo.Type[] {
  while (nr < out.records.len()) {
    for field in out.records[nr].fields {
      if (names_schema(field.ty)) {
        pending = pending.append(field.ty);
      }
    }
    nr += 1;
  }
  while (ne < out.enums.len()) {
    for v in out.enums[ne].variants {
      for field in v.fields {
        if (names_schema(field.ty)) {
          pending = pending.append(field.ty);
        }
      }
    }
    ne += 1;
  }
  return pending;
}

struct Roots { types: typeinfo.Type[], at: i32[], ix: util.NameIndex }

function with_distinct_root(r: Roots, t: typeinfo.Type): Roots {
  if (!names_schema(t) && !typeinfo.is_dyn(t)) {
    return r;
  }
  let sp = typeinfo.spelling(t);
  if (sp.len() == 0) {
    return Roots { ...r, types: r.types.append(t) };
  }
  let j = r.ix.find(sp);
  if (j >= 0 && semtypes.equal(r.types[r.at[j]], t)) {
    return r;
  }
  return Roots { types: r.types.append(t), at: r.at.append(r.types.len()), ix: r.ix.added(sp) };
}

function names_schema(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  if let typeinfo.TypeMap(_) = t {
    return true;
  }
  if let typeinfo.TypeFunc(_) = t {
    return true;
  }
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  if let typeinfo.TypeUnion(_) = t {
    return true;
  }
  return false;
}

function schema_of(t: typeinfo.Type, s: State, out: Schemas): Schemas {
  if let typeinfo.TypeArray(a) = t {
    return schema_of(a.elem, s, out);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for elem in tup.elements {
      out = schema_of(elem, s, out);
      if (!out.ok) {
        return out;
      }
    }
    return out;
  }
  if (typeinfo.is_cell(t)) {
    return schema_of(semtypes.cell_elem(t), s, out);
  }

  if let typeinfo.TypeMap(m) = t {
    out = schema_of(m.key, s, out);
    if (!out.ok) {
      return out;
    }
    return schema_of(m.value, s, out);
  }
  if let typeinfo.TypeFunc(fn) = t {
    for p in fn.param_types {
      out = schema_of(p, s, out);
      if (!out.ok) {
        return out;
      }
    }
    return schema_of(fn.ret_type, s, out);
  }
  if let typeinfo.TypeStruct(r) = t {
    if (semtypes.is_handle(t)) {
      return out;
    }
    let mr = semrecords.find_named(out.memo.records, out.memo.record_names, r.name, t);
    if (mr >= 0) {
      if (out.seen_r[mr]) {
        return out;
      }
      return with_known_record(out, mr);
    }
    if (semtypes.is_env(t)) {
      return env_entry(t, s.views, s.impls, out);
    }
    return record_entry(t, r, s, out);
  }
  if let typeinfo.TypeUnion(u) = t {
    let me = semrecords.find_named_enum(out.memo.enums, out.memo.enum_names, u.name, t);
    if (me >= 0) {
      if (out.seen_e[me]) {
        return out;
      }
      return enum_members(out.memo.enums[me], s, with_known_enum(out, me));
    }
    return enum_entry(t, u, s, out);
  }
  return out;
}

function with_known_record(out: Schemas, at: i32): Schemas {
  return Schemas { ...out, records: out.records.append(out.memo.records[at]), seen_r: out.seen_r.with(at, true) };
}

function with_new_record(out: Schemas, rec: semrecords.Record): Schemas {
  let name = semrecords.name_of(rec.ty);
  return Schemas { ...out, records: out.records.append(rec), seen_r: out.seen_r.append(true), memo: SchemaMemo { ...out.memo, records: out.memo.records.append(rec), record_names: out.memo.record_names.added(name) } };
}

function with_known_enum(out: Schemas, at: i32): Schemas {
  return Schemas { ...out, enums: out.enums.append(out.memo.enums[at]), seen_e: out.seen_e.with(at, true) };
}

function with_new_enum(out: Schemas, e: semrecords.Enum): Schemas {
  return Schemas { ...out, enums: out.enums.append(e), seen_e: out.seen_e.append(true), memo: SchemaMemo { ...out.memo, enums: out.memo.enums.append(e), enum_names: out.memo.enum_names.added(typeinfo.union_name(e.ty)) } };
}

function enum_members(e: semrecords.Enum, s: State, out: Schemas): Schemas {
  if (e.layout != semrecords.layout_member()) {
    return out;
  }
  for v in e.variants {
    out = schema_of(typeinfo.TypeStruct { name: v.name, args: [] }, s, out);
    if (!out.ok) {
      return out;
    }
  }
  return out;
}

function fields_resolved(sig: checker.StructSig): boolean {
  for t in sig.field_types {
    if (!semtypes.concrete(t, false)) {
      return false;
    }
  }
  return true;
}

function fields_of(sig: checker.StructSig, scope: checker.Scope): semrecords.Field[] {
  let fields: semrecords.Field[] = [];
  for i in 0..sig.field_names.len() {
    fields = fields.append(semrecords.Field { name: sig.field_names[i], ty: resolved(sig.field_types[i], false, ssasem.unbound(), scope) });
  }
  return fields;
}

function env_entry(t: typeinfo.Type, views: string[], impls: parser.ImplInfo[], out: Schemas): Schemas {
  let fields: semrecords.Field[] = [semrecords.Field { name: "code", ty: typeinfo.t_i32() }];
  let i = 0;
  for cap in semtypes.env_captures(t) {
    i += 1;
    fields = fields.append(semrecords.Field { name: "c" + util.i32_to_string(i), ty: cap });
  }
  return with_new_record(out, semrecords.Record { ty: t, fields: fields, views: fields_hold_view(fields, views, impls), nests_func: fields_nest_func(fields), declared: [] });
}

function record_entry(t: typeinfo.Type, r: typeinfo.TypeStruct, s: State, out: Schemas): Schemas {
  let Some(sig) = record_sig(t, s) else {
    return Schemas { ...out, ok: false, why: "unsupported record type " + typeinfo.spelling(t) };
  };
  if (!fields_resolved(sig)) {
    return Schemas { ...out, ok: false, why: "unresolved record field type" };
  }
  let fields = fields_of(sig, s.scope);
  return with_new_record(out, semrecords.Record { ty: t, fields: fields, views: type_holds_view(t, s.views, s.impls), nests_func: fields_nest_func(fields), declared: [] });
}

function enum_entry(t: typeinfo.Type, u: typeinfo.TypeUnion, s: State, out: Schemas): Schemas {
  let layout = union_layout(s, u.name);
  if (layout == semrecords.layout_option()) {
    return builtin_enum_entry(t, s, out);
  }
  let names = union_variants(s, u.name);
  if (names.len() == 0 || u.args.len() != checker.union_type_params(s.scope, u.name).len() || layout == 0) {
    return Schemas { ...out, ok: false, why: "unsupported enum type" };
  }
  let variants = typed_variants(s, t);
  for v in variants {
    for field in v.fields {
      if (!semtypes.is_never(field.ty) && !semtypes.concrete(field.ty, false)) {
        return Schemas { ...out, ok: false, why: "unresolved variant field type" };
      }
    }
  }
  let e = semrecords.Enum { ty: t, variants: variants, layout: layout, views: util.index_of_str(s.views, u.name) >= 0, nests_func: variants_nest_func(variants) };
  return enum_members(e, s, with_new_enum(out, e));
}

function typed_variants(s: State, whole: typeinfo.Type): semrecords.Variant[] {
  return laid_variants(s, whole, union_layout(s, typeinfo.union_name(whole)));
}

function laid_variants(s: State, whole: typeinfo.Type, layout: i32): semrecords.Variant[] {
  if (layout == semrecords.layout_option()) {
    return builtin_variants(whole);
  }
  let variants: semrecords.Variant[] = [];
  for name in union_variants(s, typeinfo.union_name(whole)) {
    let fields: semrecords.Field[] = [];
    if let Some(shape) = checker.variant_shape_sig(s.scope, name, typeinfo.union_name(whole)) {
      fields = fields_of(checker.instantiated_variant(shape, s.scope, whole), s.scope);
    }
    variants = variants.append(semrecords.Variant { name: name, fields: fields });
  }
  return variants;
}

function builtin_enum_entry(t: typeinfo.Type, s: State, out: Schemas): Schemas {
  let variants = builtin_variants(t);
  if (variants.len() == 0) {
    return Schemas { ...out, ok: false, why: "unsupported enum type" };
  }
  for v in variants {
    for field in v.fields {
      if (!semtypes.is_never(field.ty) && !semtypes.concrete(field.ty, false)) {
        return Schemas { ...out, ok: false, why: "unresolved variant field type" };
      }
    }
  }
  let views = false;
  for v in variants {
    if (fields_hold_view(v.fields, s.views, s.impls)) {
      views = true;
    }
  }
  return with_new_enum(out, semrecords.Enum { ty: t, variants: variants, layout: semrecords.layout_option(), views: views, nests_func: variants_nest_func(variants) });
}

struct EnvCandidate { row: ssasem.EnvRow, request: Option[Request] }

function env_rows(named: typeinfo.Type[], envs: ssasem.Contract[]): EnvCandidate[] {
  let out: EnvCandidate[] = [];
  for t in named {
    if (!ssasem.is_func(t)) {
      continue;
    }
    for c in envs {
      if let Some(candidate) = env_serving(c, t) {
        out = out.append(candidate);
      }
    }
  }
  return out;
}

function env_serving(c: ssasem.Contract, t: typeinfo.Type): Option[EnvCandidate] {
  if (semtypes.equal(ssasem.closure_type(c), t)) {
    return Some(EnvCandidate { row: ssasem.EnvRow { fn_ty: t, env_ty: c.params[0] }, request: None });
  }
  let vars = ssasem.contract_variables(c);
  if (vars.len() == 0) {
    return None;
  }
  let b = ssasem.bind_type(ssasem.unbound(), ssasem.closure_type(c), t);
  if (!b.ok || !ssasem.binds_all(b, vars)) {
    return None;
  }
  let inst = ssasem.instantiate_contract(c, b, vars);
  if (!semtypes.equal(ssasem.closure_type(inst), t)) {
    return None;
  }
  return Some(EnvCandidate { row: ssasem.EnvRow { fn_ty: t, env_ty: inst.params[0] }, request: Some(Request { key: c.name, name: inst.name, binding: b }) });
}

struct Closed { rows: ssasem.EnvRow[], dyns: ssasem.EnvRow[], table: Schemas, requests: Request[] }

function env_rows_closed(named: typeinfo.Type[], s: State, memo: SchemaMemo): Closed {
  let rows: ssasem.EnvRow[] = [];
  let drows: ssasem.EnvRow[] = [];
  let requests: Request[] = [];
  let table = schemas(named, s, memo);
  while (table.ok) {
    let r = table_reach(table, named);
    let reach = r.fns;
    let dreach = r.dyns;
    let grown = false;
    for candidate in env_rows(reach, s.contracts.envs) {
      let row = candidate.row;
      if (!semtypes.is_env(row.env_ty) || ssasem.has_env_row(rows, row.fn_ty, row.env_ty)) {
        continue;
      }
      rows = rows.append(row);
      if let Some(r) = candidate.request {
        requests = requests.append(r);
      }
      named = named.append(row.env_ty);
      grown = true;
    }
    for t in dreach {
      for c in dyn_concretes(t, s) {
        if (ssasem.has_env_row(drows, t, c)) {
          continue;
        }
        drows = drows.append(ssasem.EnvRow { fn_ty: t, env_ty: c });
        named = named.append(c);
        grown = true;
      }
    }
    if (!grown) {
      break;
    }
    table = schemas(named, s, table.memo);
  }
  return Closed { rows: rows, dyns: drows, table: table, requests: requests };
}

struct Reach { fns: typeinfo.Type[], dyns: typeinfo.Type[] }

function table_reach(table: Schemas, named: typeinfo.Type[]): Reach {
  let r = Reach { fns: [], dyns: [] };
  for t in named {
    r = reach_in(t, r, true);
  }
  for rec in table.records {
    for field in rec.fields {
      if (names_schema(field.ty)) {
        r = reach_in(field.ty, r, true);
      }
    }
  }
  for e in table.enums {
    for v in e.variants {
      for field in v.fields {
        if (names_schema(field.ty)) {
          r = reach_in(field.ty, r, true);
        }
      }
    }
  }
  return r;
}

function reach_in(t: typeinfo.Type, own r: Reach, fns: boolean): Reach {
  if (fns && ssasem.is_func(t)) {
    return Reach { ...r, fns: r.fns.append(t) };
  }
  if (typeinfo.is_dyn(t)) {
    return Reach { ...r, dyns: r.dyns.append(t) };
  }
  if let typeinfo.TypeArray(a) = t {
    return reach_in(a.elem, r, fns);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      r = reach_in(e, r, fns);
    }
    return r;
  }
  if (typeinfo.is_cell(t)) {
    return reach_in(semtypes.cell_elem(t), r, fns);
  }
  if let typeinfo.TypeMap(m) = t {
    return reach_in(m.value, reach_in(m.key, r, fns), fns);
  }
  if let typeinfo.TypeUnion(u) = t {
    for a in u.args {
      r = reach_in(a, r, false);
    }
  }
  return r;
}

function dyn_concretes(t: typeinfo.Type, s: State): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for n in dyn_impl_names(t, s.impls) {
    if (n == "string") {
      out = out.append(typeinfo.t_string());
    } else if (checker.union_type_params(s.scope, n).len() > 0 || checker.struct_type_params(s.scope, n).len() > 0) {
      for c in generic_clones(n, s) {
        out = out.append(c);
      }
    } else if (has_record_schema(n, s)) {
      out = out.append(typeinfo.TypeStruct { name: n, args: [] });
    } else if (union_layout(s, n) == semrecords.layout_variant()) {
      out = out.append(typeinfo.TypeUnion { name: n, args: [] });
    } else if (erased_generic(n, s)) {
      for c in generic_clones(n, s) {
        out = out.append(c);
      }
    }
  }
  return out;
}

function dyn_impl_names(t: typeinfo.Type, impls: parser.ImplInfo[]): string[] {
  let out: string[] = [];
  let traits = parser.dyn_trait_set(typeinfo.spelling(t));
  if (traits.len() == 0) {
    return out;
  }
  for imp in impls {
    let n = parser.receiver_base(imp.impl_type);
    if (parser.impl_trait_key(imp) != util.base_type_name(traits[0]) || util.index_of_str(out, n) >= 0) {
      continue;
    }
    if (implements_traits(impls, n, traits)) {
      out = out.append(n);
    }
  }
  return out;
}

function erased_generic(n: string, s: State): boolean {
  return !s.scope.has_struct(n) && union_layout(s, n) == 0 && union_variants(s, n).len() == 0;
}

function generic_clones(base: string, s: State): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let prefix = base + "__";
  for sig in s.scope.structs.structs {
    let t: typeinfo.Type = typeinfo.TypeStruct { name: sig.name, args: [] };
    if (sig.name.starts_with(prefix) && has_record_schema(sig.name, s) && !has_type(out, t)) {
      out = out.append(t);
    }
  }
  for u in s.scope.unions.unions {
    let t: typeinfo.Type = typeinfo.TypeUnion { name: u.name, args: [] };
    if (u.name.starts_with(prefix) && union_layout(s, u.name) == semrecords.layout_variant() && !has_type(out, t)) {
      out = out.append(t);
    }
  }
  return out;
}

function cell_writing_finalizers(all: Produced[], names: string[], rows: ssasem.Finalizer[]): ssasem.Finalizer[] {
  if (rows.len() == 0) {
    return rows;
  }
  let funcs: ssasem.Func[] = [];
  let ok: boolean[] = [];
  for p in all {
    funcs = funcs.append(p.func);
    ok = ok.append(p.ok && !p.template);
  }
  return ssasem.mark_cell_writers(rows, funcs, ok, names);
}

function with_finalizers(all: Produced[], rows: ssasem.Finalizer[]): Produced[] {
  if (rows.len() == 0) {
    return all;
  }
  for i in 0..all.len() {
    if (all[i].func.finalizers.len() > 0) {
      all = all.with(i, Produced { ...all[i], func: ssasem.Func { ...all[i].func, finalizers: rows } });
    }
  }
  return all;
}

function finalized_types(funcs: parser.FuncDecl[]): ssasem.Finalizer[] {
  let out: ssasem.Finalizer[] = [];
  for fd in funcs {
    let provider = fd.impl_trait == "Drop" || fd.impl_trait == "" && util.index_of_str(fd.dyn_traits, "Drop") >= 0;
    if (provider && parser.derive_simple_name(fd.name) == "drop" && fd.receiver_type != "" && !generic_decl(fd)) {
      out = out.append(ssasem.Finalizer { receiver: fd.receiver_type, symbol: parser.decl_key(fd), writes: true });
    }
  }
  return out;
}

function shadowed_builtins(mod: parser.Module): string[] {
  let out: string[] = [];
  let keys: string[] = [];
  let std_string = false;
  for im in mod.imports {
    if (im.path == "std/string") {
      std_string = true;
    }
  }
  for fd in mod.funcs {
    if (fd.receiver_type.len() == 0) {
      keys = keys.append(fd.name);
    } else if (!std_string && parser.receiver_base(fd.receiver_type) == "string") {
      keys = keys.append(parser.decl_key(fd));
    }
  }
  for b in builtin_contracts() {
    if (util.index_of_str(keys, b.name) >= 0 && util.index_of_str(out, b.name) < 0) {
      out = out.append(b.name);
    }
  }
  return out;
}

function any_implementer(impls: parser.ImplInfo[], traits: string[]): boolean {
  for imp in impls {
    if (implements_traits(impls, parser.receiver_base(imp.impl_type), traits)) {
      return true;
    }
  }
  return false;
}

function implements_traits(impls: parser.ImplInfo[], n: string, traits: string[]): boolean {
  for tr in traits {
    let found = false;
    for imp in impls {
      if (implements_trait(imp, tr) && parser.receiver_base(imp.impl_type) == n) {
        found = true;
      }
    }
    if (!found) {
      return false;
    }
  }
  return true;
}

function implements_trait(imp: parser.ImplInfo, tr: string): boolean {
  if (parser.impl_trait_key(imp) != util.base_type_name(tr)) {
    return false;
  }
  let positional: string[] = [];
  for entry in bracket_entries(tr) {
    let eq = util.index_of_sub(entry, "=");
    if (eq < 0) {
      positional = positional.append(entry);
    } else if (!pins_assoc(imp, slice_unchecked(entry, 0, eq).to_owned().trim(), slice_unchecked(entry, eq + 1, entry.len()).to_owned())) {
      return false;
    }
  }
  if (positional.len() == 0) {
    return true;
  }
  let args = bracket_entries(imp.trait_ref);
  if (args.len() != positional.len()) {
    return false;
  }
  for i in 0..args.len() {
    if (!same_modulo_spaces(args[i], positional[i])) {
      return false;
    }
  }
  return true;
}

function pins_assoc(imp: parser.ImplInfo, name: string, value: string): boolean {
  let i = util.index_of_str(imp.assoc_names, name);
  return i >= 0 && same_modulo_spaces(imp.assoc_values[i], value);
}

function bracket_entries(t: string): string[] {
  let none: string[] = [];
  let lb = util.index_of_sub(t, "[");
  if (lb < 0 || t[t.len() - 1] != b']') {
    return none;
  }
  return parser.split_top_commas(slice_unchecked(t, lb + 1, t.len() - 1).to_owned());
}

function same_modulo_spaces(a: string, b: string): boolean {
  let i = 0;
  let j = 0;
  while (true) {
    while (i < a.len() && a[i] == b' ') {
      i += 1;
    }
    while (j < b.len() && b[j] == b' ') {
      j += 1;
    }
    if (i == a.len() || j == b.len()) {
      return i == a.len() && j == b.len();
    }
    if (a[i] != b[j]) {
      return false;
    }
    i += 1;
    j += 1;
  }
}

function has_type(ts: typeinfo.Type[], t: typeinfo.Type): boolean {
  for u in ts {
    if (semtypes.equal(u, t)) {
      return true;
    }
  }
  return false;
}

function contract_types(calls: ssasem.Contract[]): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for c in calls {
    for t in c.params {
      out = out.append(t);
    }
    out = out.append(c.result);
  }
  return out;
}

struct Made { p: Produced, memo: SchemaMemo }

function complete(fd: parser.FuncDecl, s: State, name: string, memo: SchemaMemo, finalizers: ssasem.Finalizer[]): Made {
  if (!s.ok) {
    return Made { p: refuse(s.why), memo: memo };
  }
  if (s.live && !typeinfo.is_void(s.result)) {
    s = terminate(s, ssa.t_unreachable());
  }
  s = terminate(s, ssa.t_ret(-1));
  let blocks = reachable(s.blocks);
  let map = trivial_phis(blocks, s.values.len());
  let f = renumber(blocks, map, s.values, s.dbg_vals, s.dbg_names);
  let params: typeinfo.Type[] = [];
  let modes = s.modes;
  let at = 0;
  let nparams = decl_param_names(fd).len();
  while (at < nparams) {
    params = params.append(f.values[at]);
    at += 1;
  }
  let roots = Roots { types: [], at: [], ix: util.name_index([]) };
  for t in f.values {
    roots = with_distinct_root(roots, t);
  }
  roots = with_distinct_root(roots, s.result);
  for t in contract_types(s.calls) {
    roots = with_distinct_root(roots, t);
  }
  let closed = env_rows_closed(roots.types, s, memo);
  let table = closed.table;
  if (!table.ok) {
    return Made { p: refuse(table.why), memo: table.memo };
  }
  let graph = ssa.SFunc { ...f.graph, name: name, nparams: params.len() };
  f = ssasem.Func { ...f, graph: graph, params: params, result: s.result, records: semrecords.records_of(table.records), enums: table.enums, schema_checked: false, calls: s.calls, envs: closed.rows, dyns: closed.dyns, shadows: s.shadows, finalizers: finalizers, map_module: s.scope.module_imported("core/map") };
  f = ssasem.tail_recursion(f, name);
  f = ssabounds.word_loads(ssabounds.grouped_reads(ssabounds.proven_indices(f)), word_load_contracts(), [ssabytes.word_name(4), ssabytes.word_name(8)], [ssabytes.swap_name(4), ssabytes.swap_name(8)]);
  f = ssaquotient.shared_quotients(ssabounds.nonneg_quotients(f));
  return Made { p: Produced { ok: true, why: "", func: f, modes: modes, template: false, key: "", requests: util.append_all(s.requests, closed.requests), bodyless: false, analysis: None, view_escape: 0, dropped: false }, memo: table.memo };
}

function unresolved_result_spelling(fd: parser.FuncDecl, s: State): string {
  let resolved = typeinfo.spelling(s.result);
  if (resolved.len() > 0) {
    return resolved;
  }
  if (fd.ret_type.len() > 0) {
    return "declared `" + fd.ret_type + "`";
  }
  return "inferred from the first returned value";
}

function build(fd: parser.FuncDecl, scope: checker.Scope, contracts: ssasem.Contracts, binding: ssasem.Binding, name: string, handers: Handers, shadows: string[], views: string[], funcs: parser.FuncDecl[], impls: parser.ImplInfo[], finalizers: ssasem.Finalizer[], memo: SchemaMemo, debug_lines: boolean): Made {
  if (fd.import_iface.len() > 0) {
    return Made { p: external_entry(), memo: memo };
  }
  let s = initial(fd, scope, contracts, binding, name, handers, shadows, views, funcs, impls, debug_lines);
  if (!semtypes.concrete(s.result, true)) {
    return Made { p: refuse("unresolved result type: " + unresolved_result_spelling(fd, s)), memo: memo };
  }
  let body = lenelide.elide_len_bounded_body(fd.body);
  s = learn_body(fd, body, s);
  s = stmts(body, prebind(parameters(fd, s)));
  return complete(fd, s, name, memo, finalizers);
}

function learn_body(fd: parser.FuncDecl, body: ast.Stmt[], s: State): State {
  let known: i32 = -1;
  while (s.learned.len() < s.escaping.len() && s.learned.len() > known) {
    known = s.learned.len();
    let probe = stmts(body, prebind(parameters(fd, s)));
    s = State { ...s, learned: probe.learned, learned_types: probe.learned_types };
  }
  return s;
}

function prebind(s: State): State {
  let i = 0;
  while (i < s.learned.len()) {
    let z = define(s, ssasem.zero(), [], 0, "", s.learned_types[i]);
    s = bind(z.s, s.learned[i], z.id);
    i += 1;
  }
  return s;
}

function contract(fd: parser.FuncDecl, scope: checker.Scope, contracts: ssasem.Contract[]): ssasem.Contract {
  let none = ssasem.Contract { name: "", params: [], modes: [], result: typeinfo.t_void() };
  let result = result_type(fd, scope, ssasem.unbound(), contracts);
  if (!semtypes.shaped(result, true)) {
    return none;
  }
  let params: typeinfo.Type[] = [];
  let modes: i32[] = [];
  let names = decl_param_names(fd);
  let generic = generic_decl(fd);
  for at in 0..names.len() {
    let ty = settled(resolved(checker.scope_type(scope, names[at]), generic, ssasem.unbound(), scope));
    if (at == 0 && is_closure_body(fd)) {
      ty = env_type(fd, scope, generic, ssasem.unbound(), parser.decl_key(fd));
    }
    if (!semtypes.shaped(ty, true)) {
      return none;
    }
    params = params.append(ty);
    modes = modes.append(decl_param_mode(fd, at, ty));
  }
  return ssasem.Contract { name: parser.decl_key(fd), params: params, modes: modes, result: result };
}

function method_name_of(key: string): string {
  let at = key.len() - 1;
  while (at >= 0 && key[at] != b'.') {
    at -= 1;
  }
  if (at < 0) {
    return "";
  }
  return slice_unchecked(key, at + 1, key.len()).to_owned();
}

// The parameters that each declaration can hand back in its result. Bit `p`
// of `masks[i]` is parameter `p` of the declaration `keys.names[i]`, and the
// receiver is parameter 0. `method_masks` joins the declarations that have
// one method name.
pub struct Handers { keys: util.NameIndex, masks: i64[], methods: util.NameIndex, method_masks: i64[] }

// Each parameter after the 62nd has the bit of the 62nd.
function param_bit(at: i32): i64 {
  let one: i64 = 1;
  if (at > 62) {
    return one << 62;
  }
  return one << at as i64;
}

function every_param(): i64 {
  return -1;
}

function (h: Handers) mask(key: string): i64 {
  let at = h.keys.find(key);
  if (at < 0) {
    return 0;
  }
  return h.masks[at];
}

function handers_with(h: Handers, key: string, mask: i64): Handers {
  let keys = h.keys;
  let masks = h.masks;
  let at = keys.find(key);
  if (at < 0) {
    keys = keys.added(key);
    masks = masks.append(mask);
  } else {
    masks = masks.with(at, masks[at] | mask);
  }
  let m = method_name_of(key);
  if (m.len() == 0) {
    return Handers { ...h, keys: keys, masks: masks };
  }
  let mat = h.methods.find(m);
  if (mat < 0) {
    return Handers { keys: keys, masks: masks, methods: h.methods.added(m), method_masks: h.method_masks.append(mask) };
  }
  return Handers { keys: keys, masks: masks, methods: h.methods, method_masks: h.method_masks.with(mat, h.method_masks[mat] | mask) };
}

function return_exprs(st: ast.Stmt, own acc: ast.Expr[]): ast.Expr[] {
  if let ast.StmtReturn(r) = st {
    return acc.append(r.value);
  }
  return acc;
}

// The names of a body that can hold a parameter, and the parameters that
// each name can hold.
struct Carried { names: string[], sets: i64[] }

function reach_all(es: ast.Expr[], c: Carried, known: Handers): i64 {
  let out: i64 = 0;
  for e in es {
    out = out | reach(e, c, known);
  }
  return out;
}

// The parameters that the value of `e` can hold.
function reach(e: ast.Expr, c: Carried, known: Handers): i64 {
  if let ast.ExprIdent(id) = e {
    let at = util.index_of_str(c.names, id.name);
    if (at < 0) {
      return 0;
    }
    return c.sets[at];
  }
  if let ast.ExprStructLit(sl) = e {
    let out = reach_all(sl.field_values, c, known);
    if (sl.has_base) {
      out = out | reach(sl.base, c, known);
    }
    return out;
  }
  if let ast.ExprArray(a) = e {
    return reach_all(a.elements, c, known);
  }
  if let ast.ExprTuple(t) = e {
    return reach_all(t.elements, c, known);
  }
  if let ast.ExprMapLit(m) = e {
    return reach_all(m.keys, c, known) | reach_all(m.vals, c, known);
  }
  if let ast.ExprCall(call) = e {
    return reach_call(call, c, known);
  }
  // A part of a value can hold what the value holds.
  if let ast.ExprFieldAccess(fa) = e {
    return reach(fa.obj, c, known);
  }
  if let ast.ExprIndex(ix) = e {
    return reach(ix.array, c, known);
  }
  return 0;
}

// A call hands back the arguments in the positions that its callee hands
// back. A call through a field can be a method, whose first argument is
// parameter 1, or a function of a module, whose first argument is parameter 0.
function reach_call(call: ast.ExprCall, c: Carried, known: Handers): i64 {
  let kept = kept_params(call, known);
  if (kept == 0) {
    return 0;
  }
  let out: i64 = 0;
  if let ast.ExprFieldAccess(fa) = call.callee {
    if ((kept & param_bit(0)) != 0) {
      out = reach(fa.obj, c, known);
    }
    for i in 0..call.args.len() {
      if ((kept & (param_bit(i) | param_bit(i + 1))) != 0) {
        out = out | reach(call.args[i], c, known);
      }
    }
    return out;
  }
  for i in 0..call.args.len() {
    if ((kept & param_bit(i)) != 0) {
      out = out | reach(call.args[i], c, known);
    }
  }
  return out;
}

function stores_argument(name: string): boolean {
  if (name.len() == 0) {
    return false;
  }
  if (name[0] >= b'A' && name[0] <= b'Z') {
    return true;
  }
  return name == "append" || name == "with" || name == "insert" || name == "cell_new";
}

function kept_params(c: ast.ExprCall, known: Handers): i64 {
  if let ast.ExprIdent(id) = c.callee {
    if (stores_argument(id.name)) {
      return every_param();
    }
    return known.mask(id.name);
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    if (stores_argument(fa.field)) {
      return every_param();
    }
    let at = known.methods.find(fa.field);
    if (at >= 0) {
      return known.method_masks[at];
    }
  }
  return 0;
}

struct Bound { name: string, value: ast.Expr }

function bound_exprs(st: ast.Stmt, own acc: Bound[]): Bound[] {
  if let ast.StmtVar(v) = st {
    return acc.append(Bound { name: v.name, value: v.init });
  }
  if let ast.StmtAssign(a) = st {
    return acc.append(Bound { name: a.target, value: a.value });
  }
  return acc;
}

// The parameters of `fd` that its result can hold.
function hands_back(fd: parser.FuncDecl, known: Handers): i64 {
  let names = decl_param_names(fd);
  let sets: i64[] = [];
  for i in 0..names.len() {
    sets = sets.append(param_bit(i));
  }
  let c = Carried { names: names, sets: sets };
  let binds: Bound[] = [];
  let outs: ast.Expr[] = [];
  for st in fd.body {
    binds = astwalk.fold_stmt_spine(st, binds, bound_exprs);
    outs = astwalk.fold_stmt_spine(st, outs, return_exprs);
  }
  let grew = true;
  while (grew) {
    grew = false;
    for b in binds {
      let held = reach(b.value, c, known);
      let at = util.index_of_str(c.names, b.name);
      if (at < 0 && held != 0) {
        c = Carried { names: c.names.append(b.name), sets: c.sets.append(held) };
        grew = true;
      } else if (at >= 0 && (c.sets[at] | held) != c.sets[at]) {
        c = Carried { names: c.names, sets: c.sets.with(at, c.sets[at] | held) };
        grew = true;
      }
    }
  }
  return reach_all(outs, c, known);
}

function handers(mod: parser.Module): Handers {
  let none: string[] = [];
  let found = Handers { keys: util.name_index(none), masks: [], methods: util.name_index(none), method_masks: [] };
  let changed = true;
  while (changed) {
    changed = false;
    for fd in mod.funcs {
      let key = parser.decl_key(fd);
      let have = found.mask(key);
      let held = hands_back(fd, found);
      if ((have | held) != have) {
        found = handers_with(found, key, held);
        changed = true;
      }
    }
  }
  return found;
}

function contracts(mod: parser.Module, scopes: checker.Scope[]): ssasem.Contracts {
  let out: ssasem.Contract[] = [];
  let keys: string[] = [];
  for fd in mod.funcs {
    keys = keys.append(parser.decl_key(fd));
  }
  let shared = shared_keys(keys);
  let grown = true;
  while (grown) {
    grown = false;
    let have = util.name_index(contract_names(out));
    let added: string[] = [];
    for i in 0..mod.funcs.len() {
      let present = have.has(keys[i]);
      if (!present && shared[i]) {
        present = util.has_str(added, keys[i]);
      }
      if (!present) {
        let c = contract(mod.funcs[i], scopes[i], out);
        if (c.name != "") {
          out = out.append(c);
          if (shared[i]) {
            added = added.append(c.name);
          }
          grown = true;
        }
      }
    }
  }
  let declared = util.name_index(contract_names(out));
  let builtins = builtin_contracts();
  let bnames: string[] = [];
  for b in builtins {
    bnames = bnames.append(b.name);
  }
  let bix = util.name_index(bnames);
  for j in 0..builtins.len() {
    if (!declared.has(bnames[j]) && bix.find(bnames[j]) == j) {
      out = out.append(builtins[j]);
    }
  }
  return ssasem.contracts_of(out);
}

function contract_names(cs: ssasem.Contract[]): string[] {
  let out: string[] = [];
  for c in cs {
    out = out.append(c.name);
  }
  return out;
}

function shared_keys(keys: string[]): boolean[] {
  let ix = util.name_index(keys);
  let out = __alloc_bool(keys.len());
  for i in 0..keys.len() {
    let first = ix.find(keys[i]);
    if (first != i) {
      out = out.with(first, true);
      out = out.with(i, true);
    }
  }
  return out;
}

function handle_contracts(): ssasem.Contract[] {
  let value: i32[] = [ssaunits.value_mode()];
  let path: i32[] = [ssaunits.borrow_mode()];
  let path_flags: i32[] = [ssaunits.borrow_mode(), ssaunits.value_mode()];
  let reader = t_handle("Reader");
  let writer = t_handle("Writer");
  let done = t_io_result(typeinfo.t_void());
  let out = handle_metadata_contracts(reader, writer);
  let opens: ssasem.Contract[] = [
    ssasem.Contract { name: "stdin", params: [], modes: [], result: reader },
    ssasem.Contract { name: "stdout", params: [], modes: [], result: writer },
    ssasem.Contract { name: "stderr", params: [], modes: [], result: writer },
    ssasem.Contract { name: "open_reader", params: [typeinfo.t_string()], modes: path, result: t_io_result(reader) },
    ssasem.Contract { name: "open_writer", params: [typeinfo.t_string()], modes: path, result: t_io_result(writer) },
    ssasem.Contract { name: "open_appender", params: [typeinfo.t_string()], modes: path, result: t_io_result(writer) },
    ssasem.Contract { name: "open_exclusive", params: [typeinfo.t_string()], modes: path, result: t_io_result(writer) },
    ssasem.Contract { name: "open_reader_with", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: path_flags, result: t_io_result(reader) },
    ssasem.Contract { name: "open_writer_with", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: path_flags, result: t_io_result(writer) },
    ssasem.Contract { name: "Reader.read_chunk", params: [reader, typeinfo.t_i32()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: t_io_result(typeinfo.t_string()) },
    ssasem.Contract { name: "Reader.read_chunk_bytes", params: [reader, typeinfo.t_i32()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: t_io_result(typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }) },
    ssasem.Contract { name: "Reader.close", params: [reader], modes: value, result: done },
    ssasem.Contract { name: "Writer.close", params: [writer], modes: value, result: done },
    ssasem.Contract { name: "Writer.write_bytes", params: [writer, typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode()], result: done },
    ssasem.Contract { name: "Writer.write_some_bytes", params: [writer, typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode()], result: t_io_result(typeinfo.t_i64()) },
    ssasem.Contract { name: "Writer.write", params: [writer, typeinfo.t_string()], modes: [ssaunits.value_mode(), ssaunits.borrow_mode()], result: done },
    ssasem.Contract { name: "Writer.splice_forever", params: [writer, typeinfo.t_string()], modes: [ssaunits.value_mode(), ssaunits.borrow_mode()], result: done },
  ];
  for c in opens {
    out = out.append(c);
  }
  return out;
}

function handle_metadata_contracts(reader: typeinfo.Type, writer: typeinfo.Type): ssasem.Contract[] {
  let v = ssaunits.value_mode();
  let done = t_io_result(typeinfo.t_void());
  let seek: typeinfo.Type[] = [typeinfo.t_i64(), typeinfo.t_i32()];
  let out: ssasem.Contract[] = [];
  let handles: typeinfo.Type[] = [reader, writer];
  let owners: string[] = ["Reader", "Writer"];
  for i in 0..2 {
    let h = handles[i];
    let o = owners[i];
    out = out.append(ssasem.Contract { name: o + ".stat", params: [h], modes: [v], result: t_io_result(t_file_stat()) });
    out = out.append(ssasem.Contract { name: o + ".flags", params: [h], modes: [v], result: t_io_result(typeinfo.t_i64()) });
    out = out.append(ssasem.Contract { name: o + ".seek", params: [h, seek[0], seek[1]], modes: [v, v, v], result: t_io_result(typeinfo.t_i64()) });
    out = out.append(ssasem.Contract { name: o + ".fsync", params: [h], modes: [v], result: done });
    out = out.append(ssasem.Contract { name: o + ".fdatasync", params: [h], modes: [v], result: done });
    out = out.append(ssasem.Contract { name: o + ".syncfs", params: [h], modes: [v], result: done });
    out = out.append(ssasem.Contract { name: o + ".drop_cache", params: [h, typeinfo.t_i64(), typeinfo.t_i64()], modes: [v, v, v], result: done });
    out = out.append(ssasem.Contract { name: o + ".isatty", params: [h], modes: [v], result: typeinfo.t_bool() });
    out = out.append(ssasem.Contract { name: o + ".dup_onto", params: [h, typeinfo.t_i32()], modes: [v, v], result: done });
  }
  out = out.append(ssasem.Contract { name: "Reader.splice_to", params: [reader, writer, typeinfo.t_i32()], modes: [v, v, v], result: t_io_result(typeinfo.t_i64()) });
  out = out.append(ssasem.Contract { name: "Reader.copy_range_to", params: [reader, writer, typeinfo.t_i32()], modes: [v, v, v], result: t_io_result(typeinfo.t_i64()) });
  out = out.append(ssasem.Contract { name: "Reader.window_size", params: [reader], modes: [v], result: t_io_result(typeinfo.TypeStruct { name: "WinSize", args: [] }) });
  let termios: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.t_i64(), view: false };
  out = out.append(ssasem.Contract { name: "Reader.set_window_size", params: [reader, typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v, v], result: done });
  out = out.append(ssasem.Contract { name: "Reader.termios_get", params: [reader], modes: [v], result: t_io_result(termios) });
  out = out.append(ssasem.Contract { name: "Reader.set_extproc", params: [reader, typeinfo.t_bool()], modes: [v, v], result: done });
  out = out.append(ssasem.Contract { name: "Reader.termios_set", params: [reader, typeinfo.t_i32(), termios], modes: [v, v, ssaunits.borrow_mode()], result: done });
  out = out.append(ssasem.Contract { name: "Writer.write_some", params: [writer, typeinfo.t_string()], modes: [v, ssaunits.borrow_mode()], result: t_io_result(typeinfo.t_i64()) });
  out = out.append(ssasem.Contract { name: "Writer.set_nonblocking", params: [writer, typeinfo.t_bool()], modes: [v, v], result: done });
  out = out.append(ssasem.Contract { name: "Writer.set_times", params: [writer, typeinfo.t_i64(), typeinfo.t_i64(), typeinfo.t_i64(), typeinfo.t_i64(), typeinfo.t_i32()], modes: [v, v, v, v, v, v], result: done });
  return out.append(ssasem.Contract { name: "Writer.truncate", params: [writer, typeinfo.t_i64()], modes: [v, v], result: done });
}

function os_contracts(): ssasem.Contract[] {
  let v = ssaunits.value_mode();
  let b = ssaunits.borrow_mode();
  let done = t_io_result(typeinfo.t_void());
  let strs: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.t_string(), view: false };
  let out: ssasem.Contract[] = [
    ssasem.Contract { name: "getcwd", params: [], modes: [], result: t_io_result(typeinfo.t_string()) },
    ssasem.Contract { name: "hostname", params: [], modes: [], result: typeinfo.t_string() },
    ssasem.Contract { name: "cpu_count", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "geteuid", params: [], modes: [], result: typeinfo.t_u32() },
    ssasem.Contract { name: "getegid", params: [], modes: [], result: typeinfo.t_u32() },
    ssasem.Contract { name: "getuid", params: [], modes: [], result: typeinfo.t_u32() },
    ssasem.Contract { name: "getgid", params: [], modes: [], result: typeinfo.t_u32() },
    ssasem.Contract { name: "environ", params: [], modes: [], result: strs },
    ssasem.Contract { name: "proc_fork", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "isatty", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_bool() },
    ssasem.Contract { name: "process_alive", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_bool() },
    ssasem.Contract { name: "rlimit_nofile", params: [], modes: [], result: typeinfo.t_i64() },
    ssasem.Contract { name: "disable_core_dumps", params: [], modes: [], result: typeinfo.t_bool() },
    ssasem.Contract { name: "prctl_query", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i64() },
    ssasem.Contract { name: "uname_field", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_string() },
    ssasem.Contract { name: "umask", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "proc_waitpid", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "proc_waitpid_nohang", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "proc_waitpid_status", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "temp_dir", params: [typeinfo.t_string()], modes: [b], result: t_io_result(typeinfo.t_string()) },
    ssasem.Contract { name: "read_link", params: [typeinfo.t_string()], modes: [b], result: t_io_result(typeinfo.t_string()) },
    ssasem.Contract { name: "read_link_bytes", params: [typeinfo.t_string()], modes: [b], result: t_io_result(typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }) },
    ssasem.Contract { name: "remove_dir", params: [typeinfo.t_string()], modes: [b], result: done },
    ssasem.Contract { name: "statfs", params: [typeinfo.t_string()], modes: [b], result: t_io_result(typeinfo.TypeStruct { name: "FsStat", args: [] }) },
    ssasem.Contract { name: "mounts", params: [], modes: [], result: t_io_result(typeinfo.TypeArray { elem: typeinfo.TypeStruct { name: "MountEntry", args: [] }, view: false }) },
    ssasem.Contract { name: "sysctl", params: [typeinfo.TypeArray { elem: typeinfo.t_i32(), view: false }], modes: [b], result: t_io_result(typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }) },
  ];
  for c in fs_op_contracts(done, strs) {
    out = out.append(c);
  }
  for c in os_floor_contracts(done, strs) {
    out = out.append(c);
  }
  return out;
}

function os_floor_contracts(done: typeinfo.Type, strs: typeinfo.Type): ssasem.Contract[] {
  let v = ssaunits.value_mode();
  let b = ssaunits.borrow_mode();
  let gids: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.t_i64(), view: false };
  let bytes: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false };
  let fds: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.t_i32(), view: false };
  let win = t_io_result(typeinfo.TypeStruct { name: "WinSize", args: [] });
  return [
    ssasem.Contract { name: "set_file_times", params: [typeinfo.t_string(), typeinfo.t_i64(), typeinfo.t_i64(), typeinfo.t_i64(), typeinfo.t_i64(), typeinfo.t_i32()], modes: [b, v, v, v, v, v], result: done },
    ssasem.Contract { name: "mknod", params: [typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [b, v, v, v], result: done },
    ssasem.Contract { name: "chmod_at", params: [typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_bool()], modes: [b, v, v], result: done },
    ssasem.Contract { name: "chdir", params: [typeinfo.t_string()], modes: [b], result: done },
    ssasem.Contract { name: "chroot", params: [typeinfo.t_string()], modes: [b], result: done },
    ssasem.Contract { name: "set_process_group", params: [typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v], result: done },
    ssasem.Contract { name: "setgroups", params: [gids], modes: [b], result: done },
    ssasem.Contract { name: "getgroups", params: [], modes: [], result: gids },
    ssasem.Contract { name: "priority", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "sync", params: [], modes: [], result: typeinfo.t_void() },
    ssasem.Contract { name: "poll", params: [fds, typeinfo.t_i32()], modes: [b, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "timer_fd", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_send_bytes", params: [typeinfo.t_i32(), bytes], modes: [v, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_pollable", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_listen_with", params: [bytes, typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_bool()], modes: [b, v, v, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_socket_ctl", params: [typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_sendfile", params: [typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_send_buf", params: [typeinfo.t_i32(), typeinfo.t_usize(), typeinfo.t_i32()], modes: [v, v, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "udp_bind", params: [bytes, typeinfo.t_i32()], modes: [b, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "udp_bind_with", params: [bytes, typeinfo.t_i32(), typeinfo.t_bool()], modes: [b, v, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "udp_connect", params: [typeinfo.t_i32(), bytes, typeinfo.t_i32()], modes: [v, b, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "udp_sendto", params: [typeinfo.t_i32(), bytes, typeinfo.t_i32(), typeinfo.t_string()], modes: [v, b, v, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "udp_sendto_bytes", params: [typeinfo.t_i32(), bytes, typeinfo.t_i32(), bytes], modes: [v, b, v, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "udp_sendmmsg", params: [typeinfo.t_i32(), bytes, bytes, fds], modes: [v, b, b, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "udp_recvmmsg", params: [typeinfo.t_i32(), bytes, bytes, fds], modes: [v, b, b, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "udp_recvfrom", params: [typeinfo.t_i32(), bytes, bytes], modes: [v, b, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_connect_with", params: [bytes, typeinfo.t_i32(), typeinfo.t_bool()], modes: [b, v, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "unix_listen", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: [b, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "unix_connect", params: [typeinfo.t_string()], modes: [b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "reactor_new", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "reactor_ctl", params: [typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v, v, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "reactor_wait", params: [typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_i32(), view: false }, typeinfo.t_i32()], modes: [v, b, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "ring_new", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i64() },
    ssasem.Contract { name: "ring_ctl", params: [typeinfo.t_i64(), typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v, v, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "ring_wait", params: [typeinfo.t_i64(), typeinfo.TypeArray { elem: typeinfo.t_i32(), view: false }, typeinfo.t_i32()], modes: [v, b, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "ring_recv", params: [typeinfo.t_i64(), typeinfo.t_i32(), bytes], modes: [v, v, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "ring_send_zc", params: [typeinfo.t_i64(), typeinfo.t_i32(), bytes, typeinfo.t_i32()], modes: [v, v, b, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_recv_into", params: [typeinfo.t_i32(), bytes], modes: [v, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_addr_into", params: [typeinfo.t_i32(), typeinfo.t_bool(), bytes], modes: [v, v, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_ktls", params: [typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32(), bytes], modes: [v, v, v, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "signal_ignore", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "signal_default", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "signal_catch", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "signal_catch_interrupting", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "signal_raise", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "signal_taken", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_bool() },
    ssasem.Contract { name: "signal_disposition", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "signal_mask", params: [typeinfo.t_i32(), typeinfo.t_i64()], modes: [v, v], result: typeinfo.t_i64() },
    ssasem.Contract { name: "proc_exec", params: [typeinfo.t_string(), strs], modes: [b, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "proc_exec_as", params: [typeinfo.t_string(), strs, strs], modes: [b, b, b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "pipe", params: [], modes: [], result: t_io_result(typeinfo.TypeStruct { name: "Pipe", args: [] }) },
    ssasem.Contract { name: "wasm_timer_pollable", params: [typeinfo.t_i64()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "wasm_pollable_drop", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "wasm_block", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "wasm_poll", params: [fds], modes: [b], result: typeinfo.t_i32() },
    ssasem.Contract { name: "window_size", params: [typeinfo.t_i32()], modes: [v], result: win },
    ssasem.Contract { name: "set_window_size", params: [typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v, v], result: done },
    ssasem.Contract { name: "termios_get", params: [typeinfo.t_i32()], modes: [v], result: t_io_result(gids) },
    ssasem.Contract { name: "termios_set", params: [typeinfo.t_i32(), typeinfo.t_i32(), gids], modes: [v, v, b], result: done },
    ssasem.Contract { name: "set_extproc", params: [typeinfo.t_i32(), typeinfo.t_bool()], modes: [v, v], result: done },
    ssasem.Contract { name: "tcp_close", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__tcp_close_unchecked", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__fd_close", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "setuid", params: [typeinfo.t_i64()], modes: [v], result: done },
    ssasem.Contract { name: "setgid", params: [typeinfo.t_i64()], modes: [v], result: done },
    ssasem.Contract { name: "set_priority", params: [typeinfo.t_i32()], modes: [v], result: done },
    ssasem.Contract { name: "clock_set", params: [typeinfo.t_i64(), typeinfo.t_i64()], modes: [v, v], result: done },
  ];
}

function fs_op_contracts(done: typeinfo.Type, strs: typeinfo.Type): ssasem.Contract[] {
  let v = ssaunits.value_mode();
  let b = ssaunits.borrow_mode();
  return [
    ssasem.Contract { name: "create_dir", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: [b, v], result: done },
    ssasem.Contract { name: "chmod", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: [b, v], result: done },
    ssasem.Contract { name: "access", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: [b, v], result: done },
    ssasem.Contract { name: "rename", params: [typeinfo.t_string(), typeinfo.t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "rename_noreplace", params: [typeinfo.t_string(), typeinfo.t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "getxattr", params: [typeinfo.t_string(), typeinfo.t_string()], modes: [b, b], result: t_io_result(typeinfo.t_string()) },
    ssasem.Contract { name: "getxattr_bytes", params: [typeinfo.t_string(), typeinfo.t_string()], modes: [b, b], result: t_io_result(typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }) },
    ssasem.Contract { name: "lgetxattr", params: [typeinfo.t_string(), typeinfo.t_string()], modes: [b, b], result: t_io_result(typeinfo.t_string()) },
    ssasem.Contract { name: "lgetxattr_bytes", params: [typeinfo.t_string(), typeinfo.t_string()], modes: [b, b], result: t_io_result(typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }) },
    ssasem.Contract { name: "setxattr", params: [typeinfo.t_string(), typeinfo.t_string(), typeinfo.t_string()], modes: [b, b, b], result: done },
    ssasem.Contract { name: "setxattr_bytes", params: [typeinfo.t_string(), typeinfo.t_string(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [b, b, b], result: done },
    ssasem.Contract { name: "lsetxattr", params: [typeinfo.t_string(), typeinfo.t_string(), typeinfo.t_string()], modes: [b, b, b], result: done },
    ssasem.Contract { name: "lsetxattr_bytes", params: [typeinfo.t_string(), typeinfo.t_string(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [b, b, b], result: done },
    ssasem.Contract { name: "rename_exchange", params: [typeinfo.t_string(), typeinfo.t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "create_link", params: [typeinfo.t_string(), typeinfo.t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "clone_file", params: [typeinfo.t_string(), typeinfo.t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "create_symlink", params: [typeinfo.t_string(), typeinfo.t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "tcp_listen", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_accept", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_accept_with", params: [typeinfo.t_i32(), typeinfo.t_bool()], modes: [v, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "tcp_local_port", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "signal_send", params: [typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v], result: done },
    ssasem.Contract { name: "chown_at", params: [typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_bool()], modes: [b, v, v, v], result: done },
    ssasem.Contract { name: "truncate", params: [typeinfo.t_string(), typeinfo.t_i64()], modes: [b, v], result: done },
    ssasem.Contract { name: "subprocess", params: [typeinfo.t_string(), strs, typeinfo.t_string()], modes: [b, b, b], result: typeinfo.TypeStruct { name: "ProcessResult", args: [] } },
  ];
}

function t_handle(name: string): typeinfo.Type {
  return typeinfo.TypeStruct { name: name, args: [] };
}

function t_option(payload: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeUnion { name: "Option", args: [payload] };
}

function t_io_result(ok: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeUnion { name: "Result", args: [ok, typeinfo.TypeUnion { name: "IoError", args: [] }] };
}

function t_file_stat(): typeinfo.Type {
  return typeinfo.TypeStruct { name: "FileStat", args: [] };
}

function dir_contracts(): ssasem.Contract[] {
  let v = ssaunits.value_mode();
  let b = ssaunits.borrow_mode();
  let dir = t_handle("Dir");
  let done = t_io_result(typeinfo.t_void());
  let stat = t_io_result(t_file_stat());
  return [
    ssasem.Contract { name: "open_dir", params: [typeinfo.t_string()], modes: [b], result: t_io_result(dir) },
    ssasem.Contract { name: "Dir.open_dir", params: [dir, typeinfo.t_string()], modes: [v, b], result: t_io_result(dir) },
    ssasem.Contract { name: "Dir.open_reader", params: [dir, typeinfo.t_string()], modes: [v, b], result: t_io_result(t_handle("Reader")) },
    ssasem.Contract { name: "Dir.open_writer", params: [dir, typeinfo.t_string()], modes: [v, b], result: t_io_result(t_handle("Writer")) },
    ssasem.Contract { name: "Dir.open_reader_with", params: [dir, typeinfo.t_string(), typeinfo.t_i32()], modes: [v, b, v], result: t_io_result(t_handle("Reader")) },
    ssasem.Contract { name: "Dir.open_writer_with", params: [dir, typeinfo.t_string(), typeinfo.t_i32()], modes: [v, b, v], result: t_io_result(t_handle("Writer")) },
    ssasem.Contract { name: "Dir.entries", params: [dir], modes: [v], result: t_io_result(typeinfo.TypeArray { elem: typeinfo.t_string(), view: false }) },
    ssasem.Contract { name: "Dir.entries_bytes", params: [dir], modes: [v], result: t_io_result(typeinfo.TypeArray { elem: typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, view: false }) },
    ssasem.Contract { name: "Dir.stat", params: [dir, typeinfo.t_string()], modes: [v, b], result: stat },
    ssasem.Contract { name: "Dir.lstat", params: [dir, typeinfo.t_string()], modes: [v, b], result: stat },
    ssasem.Contract { name: "Dir.access", params: [dir, typeinfo.t_string(), typeinfo.t_i32()], modes: [v, b, v], result: done },
    ssasem.Contract { name: "Dir.remove_file", params: [dir, typeinfo.t_string()], modes: [v, b], result: done },
    ssasem.Contract { name: "Dir.remove_dir", params: [dir, typeinfo.t_string()], modes: [v, b], result: done },
    ssasem.Contract { name: "Dir.chmod", params: [dir, typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_bool()], modes: [v, b, v, v], result: done },
    ssasem.Contract { name: "Dir.chown", params: [dir, typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_bool()], modes: [v, b, v, v, v], result: done },
    ssasem.Contract { name: "Dir.close", params: [dir], modes: [v], result: done },
  ];
}

function byte_copy_contracts(): ssasem.Contract[] {
  let bytes = typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false };
  let counted = ssaunits.counted_mode();
  let borrow = ssaunits.borrow_mode();
  let value = ssaunits.value_mode();
  return [
    ssasem.Contract { name: "__fern_bytes_append_range", params: [bytes, bytes, typeinfo.t_i32(), typeinfo.t_i32()], modes: [counted, borrow, value, value], result: bytes },
    ssasem.Contract { name: "__fern_bytes_write_range", params: [bytes, typeinfo.t_i32(), bytes, typeinfo.t_i32(), typeinfo.t_i32()], modes: [counted, value, borrow, value, value], result: bytes },
    ssasem.Contract { name: "__fern_bytes_append_back", params: [bytes, typeinfo.t_i32(), typeinfo.t_i32()], modes: [counted, value, value], result: bytes },
  ];
}

function builtin_contracts(): ssasem.Contract[] {
  let out = union_result_contracts();
  for c in handle_contracts() {
    out = out.append(c);
  }
  for c in dir_contracts() {
    out = out.append(c);
  }
  for c in os_contracts() {
    out = out.append(c);
  }
  for c in value_contracts() {
    out = out.append(c);
  }
  for c in string_contracts() {
    out = out.append(c);
  }
  for c in builder_contracts() {
    out = out.append(c);
  }
  for c in intrinsic_contracts() {
    out = out.append(c);
  }
  for c in string_method_contracts() {
    out = out.append(c);
  }
  for c in byte_copy_contracts() {
    out = out.append(c);
  }
  return out;
}

function string_method_contracts(): ssasem.Contract[] {
  let lent: i32[] = [ssaunits.borrow_mode()];
  let two: i32[] = [ssaunits.borrow_mode(), ssaunits.borrow_mode()];
  let fresh: string[] = ["to_ascii_upper", "to_ascii_lower", "trim"];
  let out: ssasem.Contract[] = [];
  for n in fresh {
    out = out.append(ssasem.Contract { name: "string." + n, params: [typeinfo.t_string()], modes: lent, result: typeinfo.t_string() });
  }
  out = out.append(ssasem.Contract { name: "string.lines", params: [typeinfo.t_string()], modes: lent, result: typeinfo.TypeArray { elem: typeinfo.t_string(), view: false } });
  out = out.append(ssasem.Contract { name: "string.split", params: [typeinfo.t_string(), typeinfo.t_string()], modes: two, result: typeinfo.TypeArray { elem: typeinfo.t_string(), view: false } });
  out = out.append(ssasem.Contract { name: "string.repeat", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: [ssaunits.borrow_mode(), ssaunits.value_mode()], result: typeinfo.t_string() });
  return out.append(ssasem.Contract {
    name: "string.replace", params: [typeinfo.t_string(), typeinfo.t_string(), typeinfo.t_string()],
    modes: [ssaunits.borrow_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: typeinfo.t_string(),
  });
}

function intrinsic_contracts(): ssasem.Contract[] {
  let out = float_primitive_contracts();
  for c in c_call_contracts() {
    out = out.append(c);
  }
  for c in bit_count_contracts() {
    out = out.append(c);
  }
  for c in memory_contracts() {
    out = out.append(c);
  }
  for c in byte_scan_contracts() {
    out = out.append(c);
  }
  for c in rc_contracts() {
    out = out.append(c);
  }
  for c in raw_floor_contracts() {
    out = out.append(c);
  }
  for c in lane_contracts() {
    out = out.append(c);
  }
  return out;
}

function lane_contracts(): ssasem.Contract[] {
  let names: string[] = [
    "__f64x2_swap_halves", "__f64x2_reverse", "__f64x2_zip_lo", "__f64x2_zip_hi", "__f64x2_splat", "__f64x2_of", "__f64x2_lane_bits", "__f64x2_lane", "__f64x2_bitmask", "__f64x2_mul_add", "__f64x2_sqrt",
    "__f64x2_abs", "__f64x2_floor", "__f64x2_round", "__f64x2_min", "__f64x2_max",
    "__f64x2_lt", "__f64x2_ne", "__f64x2_select", "__f64x2_load", "__f64x2_with", "__f64x2_load_bytes", "__f64x2_with_bytes", "__f64x2_store", "__f64x2_load_ptr", "__f64x2_load_f32_ptr",
    "__f32x4_swap_halves", "__f32x4_reverse", "__f32x4_zip_lo", "__f32x4_zip_hi", "__f32x4_splat", "__f32x4_of", "__f32x4_lane_bits", "__f32x4_lane", "__f32x4_bitmask", "__f32x4_mul_add", "__f32x4_sqrt",
    "__f32x4_abs", "__f32x4_floor", "__f32x4_round", "__f32x4_min", "__f32x4_max",
    "__f32x4_lt", "__f32x4_ne", "__f32x4_select", "__f32x4_load", "__f32x4_with", "__f32x4_load_bytes", "__f32x4_with_bytes", "__f32x4_store", "__f32x4_load_ptr", "__f32x4_pack",
    "__u8x16_splat", "__u8x16_of", "__u8x16_lane", "__u8x16_bitmask", "__u8x16_min", "__u8x16_max", "__u8x16_eq", "__u8x16_ne", "__u8x16_lt", "__u8x16_add_sat", "__u8x16_sub_sat", "__u8x16_avg", "__u8x16_and", "__u8x16_or", "__u8x16_xor", "__u8x16_select", "__u8x16_load", "__u8x16_with",
  ];
  let out: ssasem.Contract[] = [];
  for n in names {
    let params = typeinfo.lane_builtin_params(n);
    let modes: i32[] = [];
    for p in params {
      modes = modes.append(lane_param_mode(n, modes.len()));
    }
    out = out.append(ssasem.Contract { name: n, params: params, modes: modes, result: typeinfo.lane_builtin_result(n) });
  }
  return out;
}

function lane_param_mode(name: string, at: i32): i32 {
  if (at == 0 && (typeinfo.lane_builtin_verb(name) == "with" || typeinfo.lane_builtin_verb(name) == "with_bytes")) {
    return ssaunits.counted_mode();
  }
  if (at == 0 && (typeinfo.lane_builtin_verb(name) == "load" || typeinfo.lane_builtin_verb(name) == "load_bytes")) {
    return ssaunits.borrow_mode();
  }
  return ssaunits.value_mode();
}

function c_call_contracts(): ssasem.Contract[] {
  let names: string[] = [
    "__c_call0", "__c_call0_f32", "__c_call0_f64", "__c_call1", "__c_call1_f32", "__c_call1_f64",
    "__c_call2", "__c_call2_f32", "__c_call2_f64", "__c_call3", "__c_call3_f32", "__c_call3_f64",
    "__c_call4", "__c_call4_f32", "__c_call4_f64", "__c_call5", "__c_call5_f32", "__c_call5_f64",
    "__c_call6", "__c_call6_f32", "__c_call6_f64", "__c_callv",
  ];
  let out: ssasem.Contract[] = [];
  for name in names {
    if let typeinfo.TypeFunc(sig) = checker.builtin_sig(name) {
      let modes: i32[] = [];
      for _ in sig.param_types {
        modes = modes.append(ssaunits.value_mode());
      }
      out = out.append(ssasem.Contract { name: name, params: sig.param_types, modes: modes, result: sig.ret_type });
    }
  }
  return out;
}

function word_load_contracts(): ssasem.Contract[] {
  let v = ssaunits.value_mode();
  let b = ssaunits.borrow_mode();
  let view: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true };
  return [
    ssasem.Contract { name: "__raw_arr_ptr", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [b], result: typeinfo.t_usize() },
    ssasem.Contract { name: "__raw_data", params: [typeinfo.t_string()], modes: [b], result: typeinfo.t_usize() },
    ssasem.Contract { name: "__load_i32", params: [typeinfo.t_usize()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__load_i64", params: [typeinfo.t_usize()], modes: [v], result: typeinfo.t_i64() },
    ssasem.Contract { name: ssabytes.word_name(4), params: [view, typeinfo.t_i32()], modes: [b, v], result: typeinfo.t_i32() },
    ssasem.Contract { name: ssabytes.word_name(8), params: [view, typeinfo.t_i32()], modes: [b, v], result: typeinfo.t_i64() },
    ssasem.Contract { name: ssabytes.swap_name(4), params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: ssabytes.swap_name(8), params: [typeinfo.t_i64()], modes: [v], result: typeinfo.t_i64() },
  ];
}

function raw_floor_contracts(): ssasem.Contract[] {
  let out: ssasem.Contract[] = [];
  for sig in checker.raw_floor_sigs() {
    let mode = ssaunits.value_mode();
    if (sig.name == "__raw_data" || sig.name == "__raw_arr_ptr") {
      mode = ssaunits.borrow_mode();
    }
    let modes: i32[] = [];
    for _ in sig.params {
      modes = modes.append(mode);
    }
    out = out.append(ssasem.Contract { name: sig.name, params: sig.params, modes: modes, result: sig.result });
  }
  return out;
}

function rc_contracts(): ssasem.Contract[] {
  let v = ssaunits.value_mode();
  return [
    ssasem.Contract { name: "__fern_rc_inc", params: [typeinfo.t_usize()], modes: [v], result: typeinfo.t_usize() },
    ssasem.Contract { name: "__fern_str_dec", params: [typeinfo.t_string()], modes: [ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "__map_hash_seed", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__fern_drop_arr_ptr", params: [typeinfo.t_usize(), typeinfo.t_i32()], modes: [v, v], result: typeinfo.t_void() },
    ssasem.Contract { name: "__fern_arr_dec", params: [typeinfo.t_usize(), typeinfo.t_i32()], modes: [v, v], result: typeinfo.t_void() },
    ssasem.Contract { name: "__fern_rc_is_unique", params: [typeinfo.t_usize()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__fern_rc_dec", params: [typeinfo.t_usize()], modes: [v], result: typeinfo.t_void() },
    ssasem.Contract { name: "__fern_box_free", params: [typeinfo.t_usize(), typeinfo.t_i32()], modes: [v, v], result: typeinfo.t_usize() },
    ssasem.Contract { name: "__rc_dec", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "__rc_inc", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.borrow_mode()], result: typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false } },
    ssasem.Contract { name: "__rc_underflow_count", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__arr_push_shared_count", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__arr_push_shared_bytes", params: [], modes: [], result: typeinfo.t_i64() },
  ];
}

function float_primitive_contracts(): ssasem.Contract[] {
  let names: string[] = [
    "__sqrt_f64", "__floor_f64", "__ceil_f64", "__round_f64", "__trunc_f64",
    "__abs_f64",
  ];
  let value: i32[] = [ssaunits.value_mode()];
  let out: ssasem.Contract[] = [];
  for n in names {
    out = out.append(ssasem.Contract { name: n, params: [typeinfo.t_f64()], modes: value, result: typeinfo.t_f64() });
  }
  return out;
}

function bit_count_contracts(): ssasem.Contract[] {
  let narrow: string[] = ["__clz32", "__ctz32", "__popcount32"];
  let wide: string[] = ["__clz64", "__ctz64", "__popcount64"];
  let value: i32[] = [ssaunits.value_mode()];
  let out: ssasem.Contract[] = [];
  for n in narrow {
    out = out.append(ssasem.Contract { name: n, params: [typeinfo.t_u32()], modes: value, result: typeinfo.t_i32() });
  }
  for n in wide {
    out = out.append(ssasem.Contract { name: n, params: [typeinfo.t_u64()], modes: value, result: typeinfo.t_i32() });
  }
  return out.append(ssasem.Contract { name: "__mulhi_u64", params: [typeinfo.t_u64(), typeinfo.t_u64()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: typeinfo.t_u64() });
}

