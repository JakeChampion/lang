    ssasem.Contract { name: "proc_exec_as", params: [t_string(), strs, strs], modes: [b, b, b], result: t_i32() },
    ssasem.Contract { name: "pipe", params: [], modes: [], result: t_io_result(typeinfo.TypeStruct { name: "Pipe", args: [] }) },
    ssasem.Contract { name: "wasm_timer_pollable", params: [t_i64()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "wasm_pollable_drop", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "wasm_block", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "wasm_poll", params: [fds], modes: [b], result: t_i32() },
    ssasem.Contract { name: "window_size", params: [t_i32()], modes: [v], result: win },
    ssasem.Contract { name: "set_window_size", params: [t_i32(), t_i32(), t_i32()], modes: [v, v, v], result: done },
    ssasem.Contract { name: "termios_get", params: [t_i32()], modes: [v], result: t_io_result(gids) },
    ssasem.Contract { name: "termios_set", params: [t_i32(), t_i32(), gids], modes: [v, v, b], result: done },
    ssasem.Contract { name: "set_extproc", params: [t_i32(), t_bool()], modes: [v, v], result: done },
    ssasem.Contract { name: "tcp_close", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "setuid", params: [t_i64()], modes: [v], result: done },
    ssasem.Contract { name: "setgid", params: [t_i64()], modes: [v], result: done },
    ssasem.Contract { name: "set_priority", params: [t_i32()], modes: [v], result: done },
    ssasem.Contract { name: "clock_set", params: [t_i64(), t_i64()], modes: [v, v], result: done },
  ];
}

function fs_op_contracts(done: typeinfo.Type, strs: typeinfo.Type): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let b: i32 = ssaunits.borrow_mode();
  return [
    ssasem.Contract { name: "create_dir", params: [t_string(), t_i32()], modes: [b, v], result: done },
    ssasem.Contract { name: "chmod", params: [t_string(), t_i32()], modes: [b, v], result: done },
    ssasem.Contract { name: "access", params: [t_string(), t_i32()], modes: [b, v], result: done },
    ssasem.Contract { name: "rename", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "rename_noreplace", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "getxattr", params: [t_string(), t_string()], modes: [b, b], result: t_io_result(t_string()) },
    ssasem.Contract { name: "getxattr_bytes", params: [t_string(), t_string()], modes: [b, b], result: t_io_result(typeinfo.TypeArray { elem: t_u8(), view: false }) },
    ssasem.Contract { name: "lgetxattr", params: [t_string(), t_string()], modes: [b, b], result: t_io_result(t_string()) },
    ssasem.Contract { name: "lgetxattr_bytes", params: [t_string(), t_string()], modes: [b, b], result: t_io_result(typeinfo.TypeArray { elem: t_u8(), view: false }) },
    ssasem.Contract { name: "setxattr", params: [t_string(), t_string(), t_string()], modes: [b, b, b], result: done },
    ssasem.Contract { name: "setxattr_bytes", params: [t_string(), t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [b, b, b], result: done },
    ssasem.Contract { name: "lsetxattr", params: [t_string(), t_string(), t_string()], modes: [b, b, b], result: done },
    ssasem.Contract { name: "lsetxattr_bytes", params: [t_string(), t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [b, b, b], result: done },
    ssasem.Contract { name: "rename_exchange", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "create_link", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "clone_file", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "create_symlink", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "tcp_listen", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "tcp_accept", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "tcp_local_port", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "signal_send", params: [t_i32(), t_i32()], modes: [v, v], result: done },
    ssasem.Contract { name: "chown_at", params: [t_string(), t_i32(), t_i32(), t_bool()], modes: [b, v, v, v], result: done },
    ssasem.Contract { name: "truncate", params: [t_string(), t_i64()], modes: [b, v], result: done },
    ssasem.Contract { name: "subprocess", params: [t_string(), strs, t_string()], modes: [b, b, b], result: typeinfo.TypeStruct { name: "ProcessResult", args: [] } },
  ];
}

function t_handle(name: string): typeinfo.Type {
  return typeinfo.TypeStruct { name: name, args: [] };
}

function t_option(payload: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeUnion { name: "Option", args: [payload] };
}

function t_io_result(ok: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeUnion { name: "Result", args: [ok, typeinfo.TypeUnion { name: "IoError", args: [] }] };
}

function t_file_stat(): typeinfo.Type {
  return typeinfo.TypeStruct { name: "FileStat", args: [] };
}

function dir_contracts(): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let b: i32 = ssaunits.borrow_mode();
  let dir: typeinfo.Type = t_handle("Dir");
  let done: typeinfo.Type = t_io_result(t_void());
  let stat: typeinfo.Type = t_io_result(t_file_stat());
  return [
    ssasem.Contract { name: "open_dir", params: [t_string()], modes: [b], result: t_io_result(dir) },
    ssasem.Contract { name: "Dir.open_dir", params: [dir, t_string()], modes: [v, b], result: t_io_result(dir) },
    ssasem.Contract { name: "Dir.entries", params: [dir], modes: [v], result: t_io_result(typeinfo.TypeArray { elem: t_string(), view: false }) },
    ssasem.Contract { name: "Dir.entries_bytes", params: [dir], modes: [v], result: t_io_result(typeinfo.TypeArray { elem: typeinfo.TypeArray { elem: t_u8(), view: false }, view: false }) },
    ssasem.Contract { name: "Dir.stat", params: [dir, t_string()], modes: [v, b], result: stat },
    ssasem.Contract { name: "Dir.lstat", params: [dir, t_string()], modes: [v, b], result: stat },
    ssasem.Contract { name: "Dir.access", params: [dir, t_string(), t_i32()], modes: [v, b, v], result: done },
    ssasem.Contract { name: "Dir.remove_file", params: [dir, t_string()], modes: [v, b], result: done },
    ssasem.Contract { name: "Dir.remove_dir", params: [dir, t_string()], modes: [v, b], result: done },
    ssasem.Contract { name: "Dir.chmod", params: [dir, t_string(), t_i32(), t_bool()], modes: [v, b, v, v], result: done },
    ssasem.Contract { name: "Dir.chown", params: [dir, t_string(), t_i32(), t_i32(), t_bool()], modes: [v, b, v, v, v], result: done },
    ssasem.Contract { name: "Dir.close", params: [dir], modes: [v], result: done },
  ];
}

function byte_copy_contracts(): ssasem.Contract[] {
  let bytes = typeinfo.TypeArray { elem: t_u8(), view: false };
  let counted = ssaunits.counted_mode();
  let borrow = ssaunits.borrow_mode();
  let value = ssaunits.value_mode();
  return [
    ssasem.Contract { name: "__fern_bytes_append_range", params: [bytes, bytes, t_i32(), t_i32()], modes: [counted, borrow, value, value], result: bytes },
    ssasem.Contract { name: "__fern_bytes_write_range", params: [bytes, t_i32(), bytes, t_i32(), t_i32()], modes: [counted, value, borrow, value, value], result: bytes },
    ssasem.Contract { name: "__fern_bytes_append_back", params: [bytes, t_i32(), t_i32()], modes: [counted, value, value], result: bytes },
  ];
}

function builtin_contracts(): ssasem.Contract[] {
  let out: ssasem.Contract[] = union_result_contracts();
  for c in handle_contracts() {
    out = out.append(c);
  }
  for c in dir_contracts() {
    out = out.append(c);
  }
  for c in os_contracts() {
    out = out.append(c);
  }
  for c in value_contracts() {
    out = out.append(c);
  }
  for c in string_contracts() {
    out = out.append(c);
  }
  for c in builder_contracts() {
    out = out.append(c);
  }
  for c in intrinsic_contracts() {
    out = out.append(c);
  }
  for c in string_method_contracts() {
    out = out.append(c);
  }
  for c in byte_copy_contracts() {
    out = out.append(c);
  }
  return out;
}

function string_method_contracts(): ssasem.Contract[] {
  let lent: i32[] = [ssaunits.borrow_mode()];
  let two: i32[] = [ssaunits.borrow_mode(), ssaunits.borrow_mode()];
  let fresh: string[] = ["to_ascii_upper", "to_ascii_lower", "trim"];
  let out: ssasem.Contract[] = [];
  for n in fresh {
    out = out.append(ssasem.Contract { name: "string." + n, params: [t_string()], modes: lent, result: t_string() });
  }
  out = out.append(ssasem.Contract { name: "string.lines", params: [t_string()], modes: lent, result: typeinfo.TypeArray { elem: t_string(), view: false } });
  out = out.append(ssasem.Contract { name: "string.split", params: [t_string(), t_string()], modes: two, result: typeinfo.TypeArray { elem: t_string(), view: false } });
  out = out.append(ssasem.Contract { name: "string.repeat", params: [t_string(), t_i32()], modes: [ssaunits.borrow_mode(), ssaunits.value_mode()], result: t_string() });
  return out.append(ssasem.Contract {
    name: "string.replace", params: [t_string(), t_string(), t_string()],
    modes: [ssaunits.borrow_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_string(),
  });
}

function intrinsic_contracts(): ssasem.Contract[] {
  let out: ssasem.Contract[] = float_primitive_contracts();
  for c in c_call_contracts() {
    out = out.append(c);
  }
  for c in bit_count_contracts() {
    out = out.append(c);
  }
  for c in memory_contracts() {
    out = out.append(c);
  }
  for c in byte_scan_contracts() {
    out = out.append(c);
  }
  for c in rc_contracts() {
    out = out.append(c);
  }
  for c in raw_floor_contracts() {
    out = out.append(c);
  }
  for c in lane_contracts() {
    out = out.append(c);
  }
  return out;
}

function lane_contracts(): ssasem.Contract[] {
  let names: string[] = [
    "__f64x2_splat", "__f64x2_of", "__f64x2_lane", "__f64x2_bitmask", "__f64x2_mul_add", "__f64x2_sqrt",
    "__f64x2_abs", "__f64x2_floor", "__f64x2_round", "__f64x2_min", "__f64x2_max",
    "__f64x2_lt", "__f64x2_ne", "__f64x2_select", "__f64x2_load", "__f64x2_with",
    "__f32x4_splat", "__f32x4_of", "__f32x4_lane", "__f32x4_bitmask", "__f32x4_mul_add", "__f32x4_sqrt",
    "__f32x4_abs", "__f32x4_floor", "__f32x4_round", "__f32x4_min", "__f32x4_max",
    "__f32x4_lt", "__f32x4_ne", "__f32x4_select", "__f32x4_load", "__f32x4_with",
  ];
  let out: ssasem.Contract[] = [];
  for n in names {
    let params: typeinfo.Type[] = typeinfo.lane_builtin_params(n);
    let modes: i32[] = [];
    for p in params {
      modes = modes.append(lane_param_mode(n, modes.len()));
    }
    out = out.append(ssasem.Contract { name: n, params: params, modes: modes, result: typeinfo.lane_builtin_result(n) });
  }
  return out;
}

function lane_param_mode(name: string, at: i32): i32 {
  if (at == 0 && typeinfo.lane_builtin_verb(name) == "with") {
    return ssaunits.counted_mode();
  }
  if (at == 0 && typeinfo.lane_builtin_verb(name) == "load") {
    return ssaunits.borrow_mode();
  }
  return ssaunits.value_mode();
}

function c_call_contracts(): ssasem.Contract[] {
  let names: string[] = [
    "__c_call0", "__c_call0_f32", "__c_call0_f64", "__c_call1", "__c_call1_f32", "__c_call1_f64",
    "__c_call2", "__c_call2_f32", "__c_call2_f64", "__c_call3", "__c_call3_f32", "__c_call3_f64",
    "__c_call4", "__c_call4_f32", "__c_call4_f64",
  ];
  let out: ssasem.Contract[] = [];
  for name in names {
    if let typeinfo.TypeFunc(sig) = checker.builtin_sig(name) {
      let modes: i32[] = [];
      for _ in sig.param_types {
        modes = modes.append(ssaunits.value_mode());
      }
      out = out.append(ssasem.Contract { name: name, params: sig.param_types, modes: modes, result: sig.ret_type });
    }
  }
  return out;
}

function word_load_contracts(): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let b: i32 = ssaunits.borrow_mode();
  let view: typeinfo.Type = typeinfo.TypeArray { elem: t_u8(), view: true };
  return [
    ssasem.Contract { name: "__raw_arr_ptr", params: [typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [b], result: t_usize() },
    ssasem.Contract { name: "__raw_data", params: [t_string()], modes: [b], result: t_usize() },
    ssasem.Contract { name: "__load_i32", params: [t_usize()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "__load_i64", params: [t_usize()], modes: [v], result: t_i64() },
    ssasem.Contract { name: ssabytes.word_name(4), params: [view, t_i32()], modes: [b, v], result: t_i32() },
    ssasem.Contract { name: ssabytes.word_name(8), params: [view, t_i32()], modes: [b, v], result: t_i64() },
    ssasem.Contract { name: ssabytes.swap_name(4), params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: ssabytes.swap_name(8), params: [t_i64()], modes: [v], result: t_i64() },
  ];
}

function raw_floor_contracts(): ssasem.Contract[] {
  let out: ssasem.Contract[] = [];
  for sig in checker.raw_floor_sigs() {
    let mode: i32 = ssaunits.value_mode();
    if (sig.name == "__raw_data" || sig.name == "__raw_arr_ptr") {
      mode = ssaunits.borrow_mode();
    }
    let modes: i32[] = [];
    for _ in sig.params {
      modes = modes.append(mode);
    }
    out = out.append(ssasem.Contract { name: sig.name, params: sig.params, modes: modes, result: sig.result });
  }
  return out;
}

function rc_contracts(): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  return [
    ssasem.Contract { name: "__fern_rc_inc", params: [t_usize()], modes: [v], result: t_usize() },
    ssasem.Contract { name: "__fern_str_dec", params: [t_string()], modes: [ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "__map_hash_seed", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__fern_drop_arr_ptr", params: [t_usize(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__fern_arr_dec", params: [t_usize(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__fern_rc_is_unique", params: [t_usize()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "__fern_rc_dec", params: [t_usize()], modes: [v], result: t_void() },
    ssasem.Contract { name: "__fern_box_free", params: [t_usize(), t_i32()], modes: [v, v], result: t_usize() },
    ssasem.Contract { name: "__rc_dec", params: [typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "__rc_inc", params: [typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.borrow_mode()], result: typeinfo.TypeArray { elem: t_u8(), view: false } },
    ssasem.Contract { name: "__rc_underflow_count", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__arr_push_shared_count", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__arr_push_shared_bytes", params: [], modes: [], result: t_i64() },
  ];
}

function float_primitive_contracts(): ssasem.Contract[] {
  let names: string[] = [
    "__sqrt_f64", "__floor_f64", "__ceil_f64", "__round_f64", "__trunc_f64",
    "__abs_f64",
  ];
  let value: i32[] = [ssaunits.value_mode()];
  let out: ssasem.Contract[] = [];
  for n in names {
    out = out.append(ssasem.Contract { name: n, params: [t_f64()], modes: value, result: t_f64() });
  }
  return out;
}

function bit_count_contracts(): ssasem.Contract[] {
  let narrow: string[] = ["__clz32", "__ctz32", "__popcount32"];
  let wide: string[] = ["__clz64", "__ctz64", "__popcount64"];
  let value: i32[] = [ssaunits.value_mode()];
  let out: ssasem.Contract[] = [];
  for n in narrow {
    out = out.append(ssasem.Contract { name: n, params: [t_u32()], modes: value, result: t_i32() });
  }
  for n in wide {
    out = out.append(ssasem.Contract { name: n, params: [t_u64()], modes: value, result: t_i32() });
  }
  return out.append(ssasem.Contract { name: "__mulhi_u64", params: [t_u64(), t_u64()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: t_u64() });
}

function memory_contracts(): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let b: i32 = ssaunits.borrow_mode();
  let fds: typeinfo.Type = typeinfo.TypeArray { elem: t_i32(), view: false };
  let out: ssasem.Contract[] = [
    ssasem.Contract { name: "__alloc", params: [t_i32()], modes: [v], result: t_usize() },
    ssasem.Contract { name: "__alloc_u8", params: [t_i32()], modes: [v], result: typeinfo.TypeArray { elem: t_u8(), view: false } },
    ssasem.Contract { name: "__alloc_i32", params: [t_i32()], modes: [v], result: typeinfo.TypeArray { elem: t_i32(), view: false } },
    ssasem.Contract { name: "__alloc_i64", params: [t_i32()], modes: [v], result: typeinfo.TypeArray { elem: t_i64(), view: false } },
    ssasem.Contract { name: "__alloc_bool", params: [t_i32()], modes: [v], result: typeinfo.TypeArray { elem: t_bool(), view: false } },
    ssasem.Contract { name: "__free", params: [t_usize(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__ptr_width", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__heap_bump_bytes", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "__heap_alloc_count", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "__heap_mark", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "__heap_release_to", params: [t_i64()], modes: [v], result: t_void() },
    ssasem.Contract { name: "__task_new", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__task_free", params: [t_i32()], modes: [v], result: t_void() },
    ssasem.Contract { name: "__task_cur", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__task_enter", params: [t_i32(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__task_leave", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__task_park", params: [fds, t_i32()], modes: [b, v], result: t_i32() },
    ssasem.Contract { name: "__task_wait", params: [t_i32()], modes: [v], result: fds },
    ssasem.Contract { name: "__task_timeout", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "__task_set_ready", params: [t_i32(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__task_set_cancelled", params: [t_i32()], modes: [v], result: t_void() },
    ssasem.Contract { name: "__task_cancelled", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__memcpy", params: [t_usize(), t_usize(), t_i32()], modes: [v, v, v], result: t_void() },
    ssasem.Contract { name: "__memset", params: [t_usize(), t_i32(), t_i32()], modes: [v, v, v], result: t_void() },
  ];
  for c in load_store_contracts() {
    out = out.append(c);
  }
  for c in aes_gcm_contracts() {
    out = out.append(c);
  }
  return out;
}

function load_store_contracts(): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let b: i32 = ssaunits.borrow_mode();
  return [
    ssasem.Contract { name: "__load_u8", params: [t_usize()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "__account_entry", params: [t_i32(), t_usize()], modes: [v, v], result: t_usize() },
    ssasem.Contract { name: "__load_i32", params: [t_usize()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "__load_i64", params: [t_usize()], modes: [v], result: t_i64() },
    ssasem.Contract { name: "__load_ptr", params: [t_usize()], modes: [v], result: t_usize() },
    ssasem.Contract { name: "__store_u8", params: [t_usize(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__str_bytes", params: [t_string(), t_usize()], modes: [b, v], result: t_usize() },
    ssasem.Contract { name: "__arr_set_len", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32()], modes: [b, v], result: t_void() },
    ssasem.Contract { name: "__store_i32", params: [t_usize(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__store_i64", params: [t_usize(), t_i64()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__store_ptr", params: [t_usize(), t_usize()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__ct_secret", params: [typeinfo.TypeArray { elem: t_u8(), view: true }], modes: [b], result: t_void() },
    ssasem.Contract { name: "__ct_public", params: [typeinfo.TypeArray { elem: t_u8(), view: true }], modes: [b], result: t_void() },
  ];
}

function aes_gcm_contracts(): ssasem.Contract[] {
  let b: i32 = ssaunits.borrow_mode();
  let view: typeinfo.Type = typeinfo.TypeArray { elem: t_u8(), view: true };
  let bytes: typeinfo.Type = typeinfo.TypeArray { elem: t_u8(), view: false };
  return [
    ssasem.Contract { name: "__bytes_owned", params: [view], modes: [b], result: bytes },
    ssasem.Contract { name: "__bytes_range", params: [view, t_i32(), t_i32()], modes: [b, ssaunits.value_mode(), ssaunits.value_mode()], result: bytes },
    ssasem.Contract { name: "__bytes_into", params: [bytes, t_i32(), view, t_i32(), t_i32()], modes: [ssaunits.counted_mode(), ssaunits.value_mode(), b, ssaunits.value_mode(), ssaunits.value_mode()], result: bytes },
    ssasem.Contract { name: "__aes_expand_key", params: [view], modes: [b], result: bytes },
    ssasem.Contract { name: "__aes_ctr32", params: [view, view, view], modes: [b, b, b], result: bytes },
    ssasem.Contract { name: "__ghash", params: [view, view, view], modes: [b, b, b], result: bytes },
    ssasem.Contract { name: "__aes_gcm_seal", params: [view, view, view, view, view], modes: [b, b, b, b, b], result: bytes },
    ssasem.Contract { name: "__aes_gcm_open", params: [view, view, view, view, view], modes: [b, b, b, b, b], result: bytes },
    ssasem.Contract { name: "__sha256_hw", params: [], modes: [], result: t_bool() },
    ssasem.Contract { name: "__sha256_hw_blocks", params: [view, view], modes: [b, b], result: bytes },
    ssasem.Contract { name: "__sha1_hw", params: [], modes: [], result: t_bool() },
    ssasem.Contract { name: "__sha1_hw_blocks", params: [view, view], modes: [b, b], result: bytes },
  ];
}

function byte_scan_contracts(): ssasem.Contract[] {
  let lent: i32 = ssaunits.borrow_mode();
  let value: i32 = ssaunits.value_mode();
  return [
    ssasem.Contract { name: "__sum_bytes", params: [t_string()], modes: [lent], result: t_i32() },
    ssasem.Contract { name: "__scale_f64", params: [typeinfo.TypeArray { elem: t_f64(), view: false }, t_f64()], modes: [lent, value], result: typeinfo.TypeArray { elem: t_f64(), view: false } },
    ssasem.Contract { name: "__outer_mul_f64", params: [typeinfo.TypeArray { elem: t_f64(), view: false }, typeinfo.TypeArray { elem: t_f64(), view: false }], modes: [lent, lent], result: typeinfo.TypeArray { elem: t_f64(), view: false } },
    ssasem.Contract { name: "__inner_mul_add_f64", params: [typeinfo.TypeArray { elem: t_f64(), view: false }, typeinfo.TypeArray { elem: t_f64(), view: false }, t_i32(), t_i32(), t_i32(), t_f64()], modes: [lent, lent, value, value, value, value], result: typeinfo.TypeArray { elem: t_f64(), view: false } },
    ssasem.Contract { name: "__crc32_cksum", params: [t_i32(), t_string()], modes: [value, lent], result: t_i32() },
    ssasem.Contract { name: "__crc32_cksum_array", params: [t_i32(), typeinfo.TypeArray { elem: t_u8(), view: true }], modes: [value, lent], result: t_i32() },
    ssasem.Contract { name: "__ascii_run", params: [t_string(), t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__scan_set", params: [t_string(), t_i32(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [lent, value, lent], result: t_i32() },
    ssasem.Contract { name: "__scan_set_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [lent, value, lent], result: t_i32() },
    ssasem.Contract { name: "__bsd_sum", params: [t_string(), t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__str_hash", params: [t_string(), t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__count_runs", params: [t_string(), t_i32(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [lent, value, lent], result: t_i32() },
    ssasem.Contract { name: "__count_runs_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [lent, value, lent], result: t_i32() },
    ssasem.Contract { name: "__count_byte", params: [t_string(), t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__memchr", params: [t_string(), t_i32(), t_i32()], modes: [lent, value, value], result: t_i32() },
    ssasem.Contract { name: "__count_byte_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__sum_bytes_array", params: [typeinfo.TypeArray { elem: t_u8(), view: true }], modes: [lent], result: t_i32() },
    ssasem.Contract { name: "__bsd_sum_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: true }, t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__memchr_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), t_i32()], modes: [lent, value, value], result: t_i32() },
    ssasem.Contract { name: "__rmemchr_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), t_i32()], modes: [lent, value, value], result: t_i32() },
    ssasem.Contract { name: "__mismatch_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: true }, t_i32(), typeinfo.TypeArray { elem: t_u8(), view: true }, t_i32(), t_i32()], modes: [lent, value, lent, value, value], result: t_i32() },
    ssasem.Contract { name: "__mismatch_bytes_str", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), t_string(), t_i32(), t_i32()], modes: [lent, value, lent, value, value], result: t_i32() },
    ssasem.Contract { name: "__rmemchr", params: [t_string(), t_i32(), t_i32()], modes: [lent, value, value], result: t_i32() },
    ssasem.Contract {
      name: "__mismatch", params: [t_string(), t_i32(), t_string(), t_i32(), t_i32()],
      modes: [lent, value, lent, value, value], result: t_i32(),
    },
  ];
}

function builder_contracts(): ssasem.Contract[] {
  let handle: i32[] = [ssaunits.value_mode()];
  let push: i32[] = [ssaunits.value_mode(), ssaunits.borrow_mode()];
  return [
    ssasem.Contract { name: "buf_new", params: [t_i32()], modes: handle, result: t_usize() },
    ssasem.Contract { name: "buf_push", params: [t_usize(), t_string()], modes: push, result: t_void() },
    ssasem.Contract { name: "buf_push_range", params: [t_usize(), t_string(), t_i32(), t_i32()], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_bytes_range", params: [t_usize(), typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), t_i32()], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_mapped", params: [t_usize(), t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_bytes_mapped", params: [t_usize(), typeinfo.TypeArray { elem: t_u8(), view: false }, typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_filtered", params: [t_usize(), t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_bytes_filtered", params: [t_usize(), typeinfo.TypeArray { elem: t_u8(), view: false }, typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_expanded", params: [t_usize(), t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_bytes_expanded", params: [t_usize(), typeinfo.TypeArray { elem: t_u8(), view: false }, typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_byte", params: [t_usize(), t_i32()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_u64", params: [t_usize(), t_u64()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: t_void() },
    ssasem.Contract { name: "buf_len", params: [t_usize()], modes: handle, result: t_i32() },
    ssasem.Contract { name: "buf_take", params: [t_usize()], modes: handle, result: t_string() },
    ssasem.Contract { name: "buf_take_bytes", params: [t_usize()], modes: handle, result: typeinfo.TypeArray { elem: t_u8(), view: false } },
    ssasem.Contract { name: "buf_clear", params: [t_usize()], modes: handle, result: t_void() },
    ssasem.Contract { name: "buf_free", params: [t_usize()], modes: handle, result: t_void() },
  ];
}

function union_result_contracts(): ssasem.Contract[] {
  let path: i32[] = [ssaunits.borrow_mode()];
  let out: ssasem.Contract[] = [
    ssasem.Contract { name: "env", params: [t_string()], modes: path, result: t_option(t_string()) },
    ssasem.Contract { name: "config_get", params: [t_string()], modes: path, result: t_option(t_string()) },
    ssasem.Contract { name: "read_file", params: [t_string()], modes: path, result: t_io_result(t_string()) },
    ssasem.Contract { name: "read_file_bytes", params: [t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: t_u8(), view: false }) },
    ssasem.Contract { name: "read_dir", params: [t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: t_string(), view: false }) },
    ssasem.Contract { name: "read_dir_bytes", params: [t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: typeinfo.TypeArray { elem: t_u8(), view: false }, view: false }) },
    ssasem.Contract { name: "read_dir_all", params: [t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: t_string(), view: false }) },
    ssasem.Contract { name: "read_dir_ino", params: [t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: typeinfo.TypeStruct { name: "DirEntry", args: [] }, view: false }) },
    ssasem.Contract { name: "read_dir_ino_all", params: [t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: typeinfo.TypeStruct { name: "DirEntry", args: [] }, view: false }) },
    ssasem.Contract { name: "stat", params: [t_string()], modes: path, result: t_io_result(t_file_stat()) },
    ssasem.Contract { name: "lstat", params: [t_string()], modes: path, result: t_io_result(t_file_stat()) },
  ];
  for c in outcome_contracts() {
    out = out.append(c);
  }
  return out;
}

function outcome_contracts(): ssasem.Contract[] {
  let path: i32[] = [ssaunits.borrow_mode()];
  let written: i32[] = [ssaunits.borrow_mode(), ssaunits.borrow_mode()];
  let done: typeinfo.Type = t_io_result(t_void());
  return [
    ssasem.Contract { name: "write_file", params: [t_string(), t_string()], modes: written, result: done },
    ssasem.Contract { name: "write_file_bytes", params: [t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: written, result: done },
    ssasem.Contract { name: "write_file_exec", params: [t_string(), t_string()], modes: written, result: done },
    ssasem.Contract { name: "create_dir_all", params: [t_string()], modes: path, result: done },
    ssasem.Contract { name: "remove_dir_all", params: [t_string()], modes: path, result: done },
    ssasem.Contract { name: "remove_file", params: [t_string()], modes: path, result: done },
  ];
}

function value_contracts(): ssasem.Contract[] {
  let value: i32[] = [ssaunits.value_mode()];
  let strs: typeinfo.Type = typeinfo.TypeArray { elem: t_string(), view: false };
  return [
    ssasem.Contract { name: "args", params: [], modes: [], result: strs },
    ssasem.Contract { name: "set_args", params: [strs], modes: [ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "random_bytes", params: [t_i32()], modes: value, result: typeinfo.TypeArray { elem: t_u8(), view: false } },
    ssasem.Contract { name: "random_i32", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "now_unix_ms", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "now_ns", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "monotonic_ns", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "clock_resolution", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "sleep_ms", params: [t_i64()], modes: value, result: t_void() },
    ssasem.Contract { name: "sleep_ns", params: [t_i64()], modes: value, result: t_void() },
    ssasem.Contract { name: "putchar", params: [t_i32()], modes: value, result: t_void() },
    ssasem.Contract { name: "f32_bits", params: [t_f32()], modes: value, result: t_i32() },
    ssasem.Contract { name: "f32_from_bits", params: [t_i32()], modes: value, result: t_f32() },
  ];
}

function string_contracts(): ssasem.Contract[] {
  let writer: i32[] = [ssaunits.borrow_mode()];
  return [
    ssasem.Contract { name: "print", params: [t_string()], modes: writer, result: t_void() },
    ssasem.Contract { name: "eprint", params: [t_string()], modes: writer, result: t_void() },
    ssasem.Contract { name: "__memchr", params: [t_string(), t_i32(), t_i32()], modes: [ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: t_i32() },
    ssasem.Contract { name: "write", params: [t_string()], modes: writer, result: t_void() },
    ssasem.Contract { name: "exit", params: [t_i32()], modes: [ssaunits.value_mode()], result: t_void() },
    ssasem.Contract { name: "string_from_bytes_unchecked", params: [typeinfo.TypeArray { elem: t_u8(), view: false }], modes: writer, result: t_string() },
    ssasem.Contract { name: "string_from_bytes_range_unchecked", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), t_i32()], modes: [ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: t_string() },
    ssasem.Contract { name: "f64_bits", params: [t_f64()], modes: [ssaunits.value_mode()], result: t_i64() },
    ssasem.Contract { name: "f64_from_bits", params: [t_i64()], modes: [ssaunits.value_mode()], result: t_f64() },
  ];
}

function close_module(all: Produced[], names: util.NameIndex): Produced[] {
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let i: i32 = 0;
    while (i < all.len()) {
      if (all[i].ok) {
        for c in all[i].func.calls {
          let at: i32 = names.find(c.name);
          if (at >= 0 && !all[at].ok && !all[at].bodyless && all[i].ok) {
            all = all.with(i, Produced { ...refuse("call target was refused: " + all[at].why), key: all[i].key });
            changed = true;
          }
        }
      }
      i = i + 1;
    }
  }
  return all;
}

struct Anchored { all: Produced[], names: string[] }

function anchor_module(all: Produced[], names: string[], verify: boolean): Anchored {
  let anchors: ssasem.Anchor[] = [];
  let copied: boolean = true;
  while (copied) {
    let changed: boolean = true;
    while (changed) {
      changed = false;
      let i: i32 = 0;
      while (i < all.len()) {
        if (all[i].ok && ssasem.holds_view(all[i].func, all[i].func.result) && !ssasem.anchored(anchors, names[i])) {
          let k: ssasem.ResultAnchor = ssasem.result_anchor(all[i].func, anchors, names);
          if (!k.escapes && !k.pending) {
            anchors = anchors.append(ssasem.Anchor { name: names[i], params: k.params });
            changed = true;
          }
        }
        i = i + 1;
      }
    }
    copied = false;
    let j: i32 = 0;
    while (j < all.len()) {
      let p: Produced = all[j];
      if (p.ok && ssasem.is_view(p.func.result) && !ssasem.anchored(anchors, names[j])
        && ssasem.result_anchor(p.func, anchors, names).escapes) {
        all = all.with(j, Produced { ...p, func: copy_returned_views(p.func) });
        anchors = anchors.append(ssasem.Anchor { name: names[j], params: [] });
        copied = true;
      }
      j = j + 1;
    }
  }
  let out: Produced[] = [];
  let helpers: CopyHelpers = CopyHelpers { types: [], from: [] };
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    if (p.ok && ssasem.holds_view(p.func, p.func.result) && !ssasem.anchored(anchors, names[i])) {
      let source: ssasem.ResultAnchor = ssasem.result_anchor(p.func, anchors, names);
      p = Produced { ...refuse("view result escapes its source"), key: p.key, view_escape: source.escape_kind };
    }
    if (verify && p.ok && !p.template) {
      p = Produced { ...p, func: ssasem.Func { ...p.func, anchors: anchors } };
      let plan: ssasem.MergePlan = ssasem.merge_copies(p.func);
      if (plan.why != "") {
        p = Produced { ...refuse(plan.why), key: p.key };
      } else {
        if (plan.copies.len() > 0) {
          p = Produced { ...p, func: ssasem.with_merge_copies(p.func, plan.copies) };
          helpers = with_copy_helpers(helpers, p.func);
          anchors = helper_anchors(anchors, helpers);
          p = Produced { ...p, func: ssasem.Func { ...p.func, anchors: anchors } };
        }
        let analysis: ssasem.Analysis = ssasem.analyze(p.func);
        if (!analysis.ok) {
          p = Produced { ...refuse("produced graph fails semantic verification: " + analysis.why), key: p.key };
        } else {
          p = Produced { ...p, analysis: Some(analysis) };
        }
      }
    }
    out = out.append(p);
    i = i + 1;
  }
  return helper_rows(out, names, helpers, anchors);
}

function helper_rows(out: Produced[], names: string[], helpers: CopyHelpers, anchors: ssasem.Anchor[]): Anchored {
  let h: i32 = 0;
  while (h < helpers.types.len()) {
    let f: ssasem.Func = ssasem.copy_helper_func(helpers.from[h], helpers.types[h]);
    helpers = with_copy_helpers(helpers, f);
    anchors = helper_anchors(anchors, helpers);
    f = ssasem.Func { ...f, anchors: anchors };
    let p: Produced = Produced { ...refuse(""), ok: true, func: f, modes: [ssaunits.borrow_mode()] };
    let analysis: ssasem.Analysis = ssasem.analyze(f);
    if (!analysis.ok) {
      p = refuse("copy helper fails semantic verification: " + analysis.why);
    } else {
      p = Produced { ...p, analysis: Some(analysis) };
    }
    out = out.append(p);
    names = names.append(ssasem.copy_helper(helpers.types[h]));
    h = h + 1;
  }
  return Anchored { all: close_module(out, util.name_index(names)), names: names };
}

struct CopyHelpers { types: typeinfo.Type[], from: ssasem.Func[] }

function with_copy_helpers(h: CopyHelpers, f: ssasem.Func): CopyHelpers {
  for t in ssasem.copy_helpers_called(f) {
    let known: boolean = false;
    for x in h.types {
      if (semtypes.equal(x, t)) {
        known = true;
      }
    }
    if (!known) {
      h = CopyHelpers { types: h.types.append(t), from: h.from.append(f) };
    }
  }
  return h;
}

function helper_anchors(anchors: ssasem.Anchor[], h: CopyHelpers): ssasem.Anchor[] {
  for t in h.types {
    if (!ssasem.anchored(anchors, ssasem.copy_helper(t))) {
      anchors = anchors.append(ssasem.Anchor { name: ssasem.copy_helper(t), params: [] });
    }
  }
  return anchors;
}

function copy_returned_views(f: ssasem.Func): ssasem.Func {
  let values: typeinfo.Type[] = f.values;
  let blocks: ssa.SBlock[] = [];
  for b in f.graph.blocks {
    let v: i32 = b.term.value;
    if (b.term.kind_tag == 1 && v >= 0 && ssasem.is_view(values[v])) {
      let first: i32 = values.len();
      for t in ssasem.view_copy_types() {
        values = values.append(t);
      }
      let insts: ssa.SInst[] = b.insts;
      for ci in ssasem.view_copy(first, v) {
        insts = insts.append(ci);
      }
      b = ssa.SBlock { ...b, insts: insts, term: t_ret(first + 2) };
    }
    blocks = blocks.append(b);
  }
  return ssasem.Func { ...f, values: values, graph: ssa.SFunc { ...f.graph, blocks: blocks, nvals: values.len() } };
}

function template_entry(key: string, ok: boolean, why: string, bodyless: boolean): Produced {
  return Produced { ...refuse(why), ok: ok, template: true, key: key, bodyless: bodyless };
}

function template_verdict(key: string, instances: Produced[]): Produced {
  let seen: boolean = false;
  for p in instances {
    if (p.key == key) {
      seen = true;
      if (!p.ok && !p.dropped) {
        return template_entry(key, false, p.why, false);
      }
    }
  }
  if (!seen) {
    return template_entry(key, false, "uninstantiated generic", true);
  }
  return template_entry(key, true, "", false);
}

function queue(pending: Request[], requests: Request[]): Request[] {
  for r in requests {
    let known: boolean = false;
    for p in pending {
      if (p.name == r.name) {
        known = true;
      }
    }
    if (!known) {
      pending = pending.append(r);
    }
  }
  return pending;
}

function instance_limit(): i32 {
  return 16384;
}

struct Inferred { all: Produced[], table: ssasem.Contracts }

function seed_bits(n: i32): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(true);
    i = i + 1;
  }
  return out;
}

function same_bits(a: boolean[], b: boolean[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function owned_shape(t: typeinfo.Type): boolean {
  if (semtypes.is_cell(t) || semtypes.is_handle(t) || semtypes.is_env(t)) {
    return false;
  }
  if (ssasem.is_map(t) || ssasem.is_view(t)) {
    return false;
  }
  if let typeinfo.TypeUnion(_) = t {
    return true;
  }
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  return false;
}

function inferred_mode(old: i32, t: typeinfo.Type, consumed: boolean): i32 {
  if (!reference(t)) {
    return old;
  }
  if (old == ssaunits.counted_mode()) {
    return old;
  }
  if (consumed && owned_shape(t)) {
    return ssaunits.counted_mode();
  }
  return old;
}

function inferred_contract(c: ssasem.Contract, rows: ownership.Escapes[], ix: ownership.Index): ssasem.Contract {
  let row: i32 = ownership.find(rows, ix, c.name);
  if (row < 0) {
    return c;
  }
  let modes: i32[] = c.modes;
  let i: i32 = 0;
  while (i < modes.len() && i < c.params.len()) {
    modes = modes.with(i, inferred_mode(modes[i], c.params[i], ownership.consumed_at(rows, row, i)));
    i = i + 1;
  }
  return ssasem.Contract { ...c, modes: modes };
}

function inferred_table(table: ssasem.Contracts, rows: ownership.Escapes[], ix: ownership.Index): ssasem.Contracts {
  let out: ssasem.Contract[] = [];
  for c in table.list {
    out = out.append(inferred_contract(c, rows, ix));
  }
  return ssasem.contracts_of(out);
}

function inferred_produced(p: Produced, name: string, rows: ownership.Escapes[], ix: ownership.Index): Produced {
  let calls0: ssasem.Contract[] = [];
  for c in p.func.calls {
    calls0 = calls0.append(inferred_contract(c, rows, ix));
  }
  let row: i32 = ownership.find(rows, ix, name);
  if (row < 0) {
    return Produced { ...p, func: ssasem.Func { ...p.func, calls: calls0 } };
  }
  let modes: i32[] = p.modes;
  let i: i32 = 0;
  while (i < modes.len() && i < p.func.params.len()) {
    modes = modes.with(i, inferred_mode(modes[i], p.func.params[i], ownership.consumed_at(rows, row, i)));
    i = i + 1;
  }
  return Produced { ...p, modes: modes, func: ssasem.Func { ...p.func, calls: calls0 } };
}

function closure_body_produced(p: Produced): boolean {
  if (p.func.params.len() == 0) {
    return false;
  }
  return semtypes.is_env(p.func.params[0]);
}

function builtin_row(c: ssasem.Contract): ownership.Escapes {
  let bits: boolean[] = [];
  for m in c.modes {
    bits = bits.append(m == ssaunits.counted_mode());
  }
  return ownership.Escapes { name: c.name, bits: bits, lends: reference(c.result) && !ssasem.fresh_result_builtin(c.name) && !rtbytecopy.is_helper(c.name), cycle: 0 - 1, quiet: [] };
}

pub function with_analyses(b: Built): Built {
  return Built { ...b, decls: analysed_rows(b.decls), instances: analysed_rows(b.instances) };
}

function analysed_rows(rows: Produced[]): Produced[] {
  let i: i32 = 0;
  while (i < rows.len()) {
    if (rows[i].ok && !rows[i].template) {
      match (rows[i].analysis) {
        None => {
          rows = rows.with(i, Produced { ...rows[i], analysis: Some(ssasem.analyze(rows[i].func)) });
        },
        _ => {}
      }
    }
    i = i + 1;
  }
  return rows;
}

function row_analysis(p: Produced): ssasem.Analysis {
  match (p.analysis) {
    Some(a) => {
      return a;
    },
    None => {
      return ssasem.analyze(p.func);
    }
  }
}

function quiet_cycles(rows: ownership.Escapes[], ix: ownership.Index, all: Produced[], names: string[]): ownership.Escapes[] {
  let quiet: boolean[] = __alloc_bool(rows.len());
  let slots: boolean[][] = [];
  let succ: i32[][] = [];
  let i: i32 = 0;
  while (i < rows.len()) {
    succ = succ.append([]);
    slots = slots.append([]);
    i = i + 1;
  }
  i = 0;
  while (i < all.len() && i < names.len()) {
    let at: i32 = ownership.find(rows, ix, names[i]);
    if (at >= 0) {
      let qs: boolean[] = quiet_slots(all[i].func);
      slots = slots.with(at, qs);
      quiet = quiet.with(at, !reference(all[i].func.result) || any_true(qs));
    }
    i = i + 1;
  }
  i = 0;
  while (i < all.len() && i < names.len()) {
    let at: i32 = ownership.find(rows, ix, names[i]);
    if (at >= 0 && quiet[at]) {
      let out: i32[] = [];
      for b in all[i].func.graph.blocks {
        for ins in b.insts {
          if (ins.kind_tag == ssasem.call() || ins.kind_tag == 8 && ins.str != "") {
            let to: i32 = ownership.find(rows, ix, ins.str);
            if (to >= 0 && quiet[to]) {
              out = out.append(to);
            }
          }
        }
      }
      succ = succ.with(at, out);
    }
    i = i + 1;
  }
  let comp: i32[] = ownership.cycles(succ);
  let out_rows: ownership.Escapes[] = [];
  let k: i32 = 0;
  while (k < rows.len()) {
    out_rows = out_rows.append(ownership.Escapes { ...rows[k], cycle: comp[k], quiet: slots[k] });
    k = k + 1;
  }
  return out_rows;
}

function quiet_slots(f: ssasem.Func): boolean[] {
  let out: boolean[] = [];
  let holds: boolean = reference(f.result);
  for t in f.params {
    out = out.append(reference(t) && (!holds || !ssasem.can_hold(f, f.result, t)));
  }
  return out;
}

function any_true(xs: boolean[]): boolean {
  for x in xs {
    if (x) {
      return true;
    }
  }
  return false;
}

function infer_rows(all: Produced[], names: string[], pinned: string[]): ownership.Escapes[] {
  let taken: string[] = pinned;
  let k: i32 = 0;
  while (k < all.len()) {
    if (all[k].ok) {
      taken = ownership.address_taken(all[k].func, taken);
    }
    k = k + 1;
  }
  let taken_ix: util.NameIndex = util.name_index(taken);
  let rows: ownership.Escapes[] = [];
  let analyses: ssasem.Analysis[] = [];
  let i: i32 = 0;
  while (i < all.len() && i < names.len()) {
    if (all[i].ok && !all[i].template && !closure_body_produced(all[i]) && !taken_ix.has(names[i])) {
      rows = rows.append(ownership.Escapes { name: names[i], bits: seed_bits(all[i].func.params.len()), lends: false, cycle: 0 - 1, quiet: [] });
      analyses = analyses.append(row_analysis(all[i]));
    } else {
      analyses = analyses.append(ssasem.refused_analysis("not produced"));
    }
    i = i + 1;
  }
  let produced: ownership.Index = ownership.index(rows);
  rows = quiet_cycles(rows, produced, all, names);
  let builtins: util.NameIndex = util.name_index([]);
  for c in builtin_contracts() {
    if (ownership.find(rows, produced, c.name) < 0 && !builtins.has(c.name)) {
      rows = rows.append(builtin_row(c));
      builtins = builtins.added(c.name);
    }
  }
  let ix: ownership.Index = ownership.index(rows);
  let own_row: i32[] = [];
  i = 0;
  while (i < all.len() && i < names.len()) {
    own_row = own_row.append(ownership.find(rows, ix, names[i]));
    i = i + 1;
  }
  let readers: i32[][] = row_readers(all, own_row, rows, ix);
  let work: i32[] = [];
  let queued: boolean[] = __alloc_bool(own_row.len());
  i = 0;
  while (i < own_row.len()) {
    work = work.append(i);
    queued = queued.with(i, true);
    i = i + 1;
  }
  let cap: i32 = (all.len() + 2) * own_row.len();
  let wi: i32 = 0;
  while (wi < work.len() && wi <= cap) {
    i = work[wi];
    wi = wi + 1;
    queued = queued.with(i, false);
    let at: i32 = own_row[i];
    if (all[i].ok && !all[i].template && at >= 0 && !closure_body_produced(all[i])) {
      let next: boolean[] = ownership.escaping(all[i].func, analyses[i], rows, ix);
      let lends: boolean = rows[at].lends || ownership.lends(all[i].func, analyses[i], rows, ix);
      if (!same_bits(rows[at].bits, next) || lends != rows[at].lends) {
        rows = rows.with(at, ownership.Escapes { ...rows[at], bits: next, lends: lends });
        for j in readers[at] {
          if (!queued[j]) {
            work = work.append(j);
            queued = queued.with(j, true);
          }
        }
      }
    }
  }
  return rows;
}

function row_readers(all: Produced[], own_row: i32[], rows: ownership.Escapes[], ix: ownership.Index): i32[][] {
  let out: i32[][] = [];
  let last: i32[] = util.minus_ones(rows.len());
  while (out.len() < rows.len()) {
    out = out.append([]);
  }
  let i: i32 = 0;
  while (i < own_row.len()) {
    if (own_row[i] >= 0) {
      for b in all[i].func.graph.blocks {
        for ins in b.insts {
          if (ins.str != "") {
            let at: i32 = ownership.find(rows, ix, ins.str);
            if (at >= 0 && last[at] != i) {
              out = out.with(at, out[at].append(i));
              last = last.with(at, i);
            }
          }
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function infer_ownership(all: Produced[], names: string[], table: ssasem.Contracts, pinned: string[]): Inferred {
  let rows: ownership.Escapes[] = infer_rows(all, names, pinned);
  let ix: ownership.Index = ownership.index(rows);
  let out: Produced[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let name: string = "";
    if (i < names.len()) {
      name = names[i];
    }
    out = out.append(inferred_produced(all[i], name, rows, ix));
    i = i + 1;
  }
  return Inferred { all: out, table: inferred_table(table, rows, ix) };
}

pub struct BuildOpts { debug_lines: boolean, size: boolean, whole: boolean, array_report: i32 }

pub function plain_build(): BuildOpts {
  return BuildOpts { debug_lines: false, size: false, whole: false, array_report: semarrayreport.off() };
}

pub function build_module(mod: parser.Module): Built {
  return produce_module(mod, true, plain_build());
}

pub function build_module_with(mod: parser.Module, opts: BuildOpts): Built {
  return produce_module(mod, true, opts);
}

pub function check_views(mod: parser.Module): util.Diag[] {
  return view_escape_diags(mod, produce_module(mod, false, plain_build()));
}

function produce_module(mod: parser.Module, verify: boolean, opts: BuildOpts): Built {
  let finalizers: ssasem.Finalizer[] = finalized_types(mod.funcs);
  let scopes: checker.Scope[] = checker.module_scopes(mod);
  let table: ssasem.Contracts = contracts(mod, scopes);
  let handed_back: util.NameIndex = handers(mod);
  let shadows: string[] = shadowed_builtins(mod);
  let views: string[] = [];
  if (scopes.len() > 0) {
    views = view_types(scopes[0], mod.impls, table);
  }
  let decls: Produced[] = [];
  let names: string[] = [];
  let pending: Request[] = [];
  let memo: SchemaMemo = no_memo();
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: parser.FuncDecl = mod.funcs[i];
    let p: Produced = template_entry(parser.decl_key(fd), false, "uninstantiated generic", true);
    if (!generic_decl(fd)) {
      let made: Made = build(fd, scopes[i], table, ssasem.unbound(), fd.name, handed_back, shadows, views, mod.funcs, mod.impls, finalizers, memo, opts.debug_lines);
      p = made.p;
      memo = made.memo;
    }
    pending = queue(pending, p.requests);
    decls = decls.append(p);
    names = names.append(parser.decl_key(fd));
    i = i + 1;
  }
  let instances: Produced[] = [];
  let at: i32 = 0;
  while (at < pending.len()) {
    let r: Request = pending[at];
    let di: i32 = util.index_of_str(names, r.key);
    let p: Produced = refuse("unbounded instantiation");
    if (at < instance_limit()) {
      let made: Made = build(mod.funcs[di], scopes[di], table, r.binding, r.name, handed_back, shadows, views, mod.funcs, mod.impls, finalizers, memo, opts.debug_lines);
      p = made.p;
      memo = made.memo;
    }
    pending = queue(pending, p.requests);
    instances = instances.append(Produced { ...p, key: r.key });
    names = names.append(r.name);
    at = at + 1;
  }
  let anchored: Anchored = anchor_module(close_module(util.append_all(decls, instances), util.name_index(names)), names, verify);
  let all: Produced[] = anchored.all;
  names = anchored.names;
  if (verify) {
    let inlined: Spliced = inline_leaves(fuse_pipelines(all, names, mod.funcs, opts.array_report), names, mod, opts.size);
    all = prune_dead_constructions(reached_only(scale_ndarray_maps(unique_loops(byte_copy_loops(without_unnamed(inlined.all, names, inlined.spliced, mod))), names, mod, opts.array_report), names, mod, opts.whole));
  }
  decls = [];
  instances = [];
  i = 0;
  while (i < all.len()) {
    if (i < mod.funcs.len()) {
      decls = decls.append(all[i]);
    } else {
      instances = instances.append(all[i]);
    }
    i = i + 1;
  }
  i = 0;
  while (i < decls.len()) {
    if (decls[i].template) {
      decls = decls.with(i, template_verdict(names[i], instances));
    }
    i = i + 1;
  }
  return Built { decls: decls, instances: instances, contracts: table, names: names, dyn_arms: dispatched_arms(util.append_all(decls, instances)), records: semrecords.Records { list: memo.records, names: memo.record_names }, enums: memo.enums, finalizers: finalizers };
}

pub function view_escape_diags(mod: parser.Module, built: Built): util.Diag[] {
  let kinds: i32[] = [];
  let names: string[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    kinds = kinds.append(built.decls[i].view_escape);
    names = names.append(parser.decl_key(mod.funcs[i]));
    i = i + 1;
  }
  for p in built.instances {
    let at: i32 = util.index_of_str(names, p.key);
    if (p.view_escape > 0 && at >= 0 && kinds[at] == 0) {
      kinds = kinds.with(at, p.view_escape);
    }
  }
  let out: util.Diag[] = [];
  i = 0;
  while (i < kinds.len()) {
    if (kinds[i] > 0) {
      let code: string = "E063";
      if (kinds[i] == 2) {
        code = "E065";
      }
      let fd: parser.FuncDecl = mod.funcs[i];
      let reported: boolean = false;
      for d in out {
        if (fd.line > 0 && d.code == code && d.line == fd.line && d.col == fd.col) {
          reported = true;
        }
      }
      if (!reported) {
        out = out.append(util.Diag {
          length: 0,
          related: [],
          code: code,
          message: "the returned view's source cannot be kept alive beyond this function: return owned storage or a view of a parameter instead",
          line: fd.line, col: fd.col,
          fix: None,
        });
      }
    }
    i = i + 1;
  }
  return out;
}

struct Spliced { all: Produced[], spliced: boolean[] }

function unique_loops(all: Produced[]): Produced[] {
  let bytes = typeinfo.TypeArray { elem: t_u8(), view: false };
  let contract = ssasem.Contract { name: semunique.name(), params: [bytes], modes: [ssaunits.counted_mode()], result: bytes };
  let sw: optbisect.Switches = optbisect.switches();
  let out: Produced[] = [];
  for old in all {
    let p = old;
    if (p.ok && !p.template) {
      let h = semunique.hoisted(p.func, contract, p.modes);
      if (h.changed && optbisect.allowed_by(sw, "unique-loops", p.func.graph.name)) {
        p = Produced { ...p, func: h.func, analysis: None };
      }
    }
    out = out.append(p);
  }
  return out;
}

function byte_copy_loops(all: Produced[]): Produced[] {
  let out: Produced[] = [];
  let contracts = byte_copy_contracts();
  let sw: optbisect.Switches = optbisect.switches();
  for old in all {
    let p = old;
    if (p.ok && !p.template) {
      let r = sembytecopy.rewrite(p.func, contracts);
      if (r.changed && optbisect.allowed_by(sw, "byte-copy", p.func.graph.name)) {
        p = Produced { ...p, func: r.func, analysis: None };
      }
    }
    out = out.append(p);
  }
  return out;
}

function inline_leaves(all: Produced[], names: string[], mod: parser.Module, size: boolean): Spliced {
  if (!inline_on()) {
    return Spliced { all: all, spliced: [] };
  }
  let funcs: ssasem.Func[] = [];
  let modes: i32[][] = [];
  let inlinable: boolean[] = [];
  let rewrite: boolean[] = [];
  let unnamed: boolean[] = [];
  let uncalled: boolean[] = [];
  let always: boolean[] = [];
  let arms: util.NameIndex = util.name_index(dispatched_arms(all));
  let sw: optbisect.Switches = optbisect.switches();
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    let usable: boolean = p.ok && !p.template && !p.bodyless;
    funcs = funcs.append(p.func);
    modes = modes.append(p.modes);
    rewrite = rewrite.append(usable);
    inlinable = inlinable.append(usable && i < mod.funcs.len() && !mod.funcs[i].no_inline && !mod.funcs[i].fip && !mod.funcs[i].fbip && optbisect.allowed_by(sw, "inline", names[i]));
    unnamed = unnamed.append(outside_unnamed(p, names[i], i, mod));
    uncalled = uncalled.append(outside_uncalled(p, names[i], i, mod, arms));
    always = always.append(i < mod.funcs.len() && mod.funcs[i].always_inline);
    i = i + 1;
  }
  let out: seminline.Inlined = seminline.inline_leaves(funcs, names, modes, inlinable, rewrite, unnamed, uncalled, always, size);
  let result: Produced[] = [];
  i = 0;
  while (i < all.len()) {
    let p: Produced = Produced { ...all[i], func: out.funcs[i] };
    if (out.rewritten[i]) {
      p = Produced { ...p, func: ssabounds.proven_indices(p.func), analysis: None };
    }
    result = result.append(p);
    i = i + 1;
  }
  return Spliced { all: result, spliced: out.spliced };
}

function without_unnamed(all: Produced[], names: string[], spliced: boolean[], mod: parser.Module): Produced[] {
  let gone: boolean[] = unnamed(all, names, spliced, mod);
  let out: Produced[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    if (gone[i]) {
      out = out.append(Produced { ...all[i], ok: false, why: "spliced into every caller", func: refuse("").func, analysis: None, dropped: true });
    } else {
      out = out.append(all[i]);
    }
    i = i + 1;
  }
  return out;
}

function reached_only(all: Produced[], names: string[], mod: parser.Module, whole: boolean): Produced[] {
  if (!whole || !kernel_switch_on("FERN_NO_SEM_REACH")) {
    return all;
  }
  let funcs: ssasem.Func[] = [];
  let usable: boolean[] = [];
  let blocked: boolean[] = [];
  let entries: boolean[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    funcs = funcs.append(p.func);
    usable = usable.append(p.ok && !p.template && !p.bodyless);
    blocked = blocked.append(!p.ok && !p.template && !p.bodyless && !p.dropped);
    entries = entries.append(i < mod.funcs.len() && entry_decl(mod.funcs[i], mod));
    i = i + 1;
  }
  let r: semreach.Reached = semreach.reach(funcs, names, usable, blocked, reach_roots(all, names, entries, mod));
  if (!r.ok) {
    return all;
  }
  return with_reached(all, usable, r);
}

function with_reached(all: Produced[], usable: boolean[], r: semreach.Reached): Produced[] {
  let gone: util.NameIndex = util.name_index(dropped_envs(all, usable, r.live));
  let out: Produced[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    if (usable[i] && !r.live[i]) {
      p = Produced { ...p, ok: false, why: "reached by nothing", func: refuse("").func, analysis: None, dropped: true };
    } else if (r.rewritten[i]) {
      p = Produced { ...p, func: r.funcs[i], analysis: None };
    }
    if (p.ok && gone.names.len() > 0) {
      p = Produced { ...p, func: ssasem.Func { ...p.func, envs: envs_left(p.func.envs, gone) } };
    }
    out = out.append(p);
    i = i + 1;
  }
  return out;
}

function reach_roots(all: Produced[], names: string[], entries: boolean[], mod: parser.Module): boolean[] {
  let named: util.NameIndex = util.name_index(outside_names(all, mod));
  let roots: boolean[] = [];
  let templates: string[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let root: boolean = entries[i] || named.has(names[i]) || flatten.is_runtime_helper_name(names[i]);
    if (i < mod.funcs.len() && (root || rooted_method(mod.funcs[i], mod))) {
      root = true;
      templates = templates.append(all[i].key);
    }
    roots = roots.append(root);
    i = i + 1;
  }
  let rooted: util.NameIndex = util.name_index(templates);
  i = mod.funcs.len();
  while (i < all.len()) {
    if (rooted.has(all[i].key)) {
      roots = roots.with(i, true);
    }
    i = i + 1;
  }
  return roots;
}

function dropped_envs(all: Produced[], usable: boolean[], live: boolean[]): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    if (usable[i] && !live[i]) {
      for t in all[i].func.params {
        if (semtypes.is_env(t)) {
          out = out.append(ssasem.type_key(t));
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function envs_left(rows: ssasem.EnvRow[], gone: util.NameIndex): ssasem.EnvRow[] {
  let out: ssasem.EnvRow[] = [];
  for row in rows {
    if (!gone.has(ssasem.type_key(row.env_ty))) {
      out = out.append(row);
    }
  }
  return out;
}

function outside_names(all: Produced[], mod: parser.Module): string[] {
  let out: string[] = treeshake.top_level_names(mod, ["main"]);
  for x in mod.exports {
    out = out.append(x.func_name);
  }
  for p in all {
    if (p.ok) {
      for fin in p.func.finalizers {
        out = out.append(fin.symbol);
      }
      return out;
    }
  }
  return out;
}

function entry_decl(fd: parser.FuncDecl, mod: parser.Module): boolean {
  for x in mod.exports {
    if (x.func_name == fd.name) {
      return true;
    }
  }
  return fd.import_iface != "" || fd.async;
}

function rooted_method(fd: parser.FuncDecl, mod: parser.Module): boolean {
  if (fd.receiver_type == "") {
    return false;
  }
  for im in mod.impls {
    if (im.trait_name == "Drop" && util.index_of_str(im.method_names, fd.name) >= 0) {
      return true;
    }
  }
  for sd in mod.structs {
    if (sd.derives.len() > 0) {
      let owner: string = sd.name;
      if (sd.enum_owner.len() > 0) {
        owner = sd.enum_owner;
      }
      if (fd.receiver_type == owner) {
        return true;
      }
    }
  }
  return false;
}

function unnamed(all: Produced[], names: string[], spliced: boolean[], mod: parser.Module): boolean[] {
  let candidates: string[] = [];
  let at: i32[] = [];
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let candidate: boolean = i < spliced.len() && spliced[i] && outside_unnamed(all[i], names[i], i, mod);
    if (candidate) {
      candidates = candidates.append(names[i]);
      at = at.append(i);
    }
    out = out.append(candidate);
    i = i + 1;
  }
  if (candidates.len() == 0) {
    return out;
  }
  let ix: util.NameIndex = util.name_index(candidates);
  for p in all {
    for b in p.func.graph.blocks {
      for ins in b.insts {
        let k: i32 = ix.find(ins.str);
        if (k >= 0) {
          out = out.with(at[k], false);
        }
      }
    }
  }
  return out;
}

function outside_unnamed(p: Produced, name: string, i: i32, mod: parser.Module): boolean {
  if (p.template || p.bodyless || !p.ok || name == "main" || util.str_has_prefix(name, "__") || util.contains(name, ".")) {
    return false;
  }
  return i >= mod.funcs.len() || decl_unnamed(mod.funcs[i], mod);
}

function outside_uncalled(p: Produced, name: string, i: i32, mod: parser.Module, arms: util.NameIndex): boolean {
  if (outside_unnamed(p, name, i, mod)) {
    return true;
  }
  if (p.template || p.bodyless || !p.ok || i >= mod.funcs.len() || arms.has(name)) {
    return false;
  }
  let fd: parser.FuncDecl = mod.funcs[i];
  return fd.receiver_type.len() > 0 && fd.import_iface == "" && !exported(fd, mod) && !rooted_method(fd, mod);
}

function exported(fd: parser.FuncDecl, mod: parser.Module): boolean {
  for x in mod.exports {
    if (x.func_name == fd.name) {
      return true;
    }
  }
  return false;
}

function decl_unnamed(fd: parser.FuncDecl, mod: parser.Module): boolean {
  return fd.receiver_type.len() == 0 && fd.import_iface == "" && !exported(fd, mod);
}

function inline_on(): boolean {
  match (env("FERN_SEM_INLINE")) {
    Some(v) => {
      return envflag.value_on(v);
    },
    None => {
      return true;
    }
  }
}

function fuse_pipelines(all: Produced[], names: string[], decls: parser.FuncDecl[], sink: i32): Produced[] {
  let enabled: boolean = fusion_on();
  let report: boolean = sink != semarrayreport.off();
  if (!enabled && !report) {
    return all;
  }
  let funcs: ssasem.Func[] = [];
  let usable: boolean[] = [];
  for p in all {
    funcs = funcs.append(p.func);
    usable = usable.append(p.ok && !p.template && !p.bodyless);
  }
  let out: semfuse.Fused = semfuse.fuse_pipelines(funcs, names, usable, stdlib_names(all, names, decls, "std/array"), stdlib_names(all, names, decls, "core/iter"), enabled, report);
  let sw: optbisect.Switches = optbisect.switches();
  if (inline_on()) {
    let inlinable: boolean[] = [];
    let modes: i32[][] = [];
    let at: i32 = 0;
    while (at < all.len()) {
      inlinable = inlinable.append(usable[at] && at < decls.len() && !decls[at].no_inline && !decls[at].fip && !decls[at].fbip && optbisect.allowed_by(sw, "inline", names[at]));
      modes = modes.append(all[at].modes);
      at = at + 1;
    }
    out = semfuse.Fused { ...out, funcs: seminline.inline_closures(out.funcs, names, modes, inlinable, out.rewritten) };
  }
  if (report) {
    semarrayreport.write(sink, semarrayreport.render(out.sites));
  }
  let result: Produced[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    if (out.rewritten[i] && optbisect.allowed_by(sw, "fuse", names[i])) {
      p = Produced { ...p, func: semoption.split(out.funcs[i]), analysis: None };
    }
    result = result.append(p);
    i = i + 1;
  }
  return result;
}

function prune_dead_constructions(all: Produced[]): Produced[] {
  let out: Produced[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    if (p.ok && !p.template && !p.bodyless) {
      let th: semthread.Threaded = semthread.thread(p.func);
      if (th.changed > 0) {
        p = Produced { ...p, func: th.f, analysis: None };
      }
      let ho: semhoist.Hoisted = semhoist.hoist(p.func);
      if (ho.moved > 0) {
        p = Produced { ...p, func: ho.f, analysis: None };
      }
      let sk: semsink.Sunk = semsink.sink(p.func);
      if (sk.reread > 0) {
        p = Produced { ...p, func: sk.f, analysis: None };
      }
      let cs: semcse.Merged = semcse.merge(p.func);
      if (cs.merged > 0) {
        p = Produced { ...p, func: cs.f, analysis: None };
      }
      let pr: semdead.Pruned = semdead.prune(p.func);
      if (pr.removed > 0) {
        p = Produced { ...p, func: pr.f, analysis: None };
      }
    }
    out = out.append(p);
    i = i + 1;
  }
  return out;
}

function ndarray_kernels_needed(names: string[], enabled: boolean, products: boolean, report: boolean): boolean {
  if (!enabled && !products && !report) {
    return false;
  }
  return semndarray.has_kernel(names) || report && semndarray.any_operation(names);
}

function scale_ndarray_maps(all: Produced[], names: string[], mod: parser.Module, sink: i32): Produced[] {
  let report: boolean = sink != semarrayreport.off();
  let enabled: boolean = kernel_switch_on("FERN_NO_SCALE_KERNEL");
  let products: boolean = kernel_switch_on("FERN_NO_PRODUCT_KERNEL");
  if (!ndarray_kernels_needed(names, enabled, products, report)) {
    return all;
  }
  let funcs: ssasem.Func[] = [];
  let usable: boolean[] = [];
  let sw: optbisect.Switches = optbisect.switches();
  let at: i32 = 0;
  while (at < all.len()) {
    let p: Produced = all[at];
    funcs = funcs.append(p.func);
    usable = usable.append(p.ok && !p.template && !p.bodyless && optbisect.allowed_by(sw, "ndarray", names[at]));
    at = at + 1;
  }
  let open: boolean[] = ndarray_open(all, names, mod, funcs);
  let out: semndarray.Scaled = semndarray.scale_maps(funcs, names, usable, open, stdlib_names(all, names, mod.funcs, "std/ndarray"), enabled, products, report);
  if (report) {
    semarrayreport.write(sink, semarrayreport.render_kind("ndarray kernels", semarrayreport.kernel_reasons(), out.sites));
  }
  let result: Produced[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    if (out.rewritten[i]) {
      p = Produced { ...p, func: out.funcs[i], analysis: None };
    }
    result = result.append(p);
    i = i + 1;
  }
  return result;
}

function stdlib_names(all: Produced[], names: string[], decls: parser.FuncDecl[], library: string): string[] {
  let keys: string[] = [];
  for fd in decls {
    keys = keys.append(parser.decl_key(fd));
  }
  let index: util.NameIndex = util.name_index(keys);
  let trusted: string[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let di: i32 = i;
    if (i >= decls.len()) {
      di = index.find(all[i].key);
    }
    if (di >= 0 && di < decls.len() && decls[di].stdlib == library) {
      trusted = trusted.append(names[i]);
    }
    i = i + 1;
  }
  return trusted;
}

function kernel_switch_on(name: string): boolean {
  return !envflag.on(name);
}

function ndarray_open(all: Produced[], names: string[], mod: parser.Module, funcs: ssasem.Func[]): boolean[] {
  let roots: string[] = ["main"];
  for fd in mod.funcs {
    if (fd.receiver_type != "") {
      roots = roots.append(parser.decl_key(fd));
    }
  }
  for ex in mod.exports {
    roots = roots.append(ex.func_name);
  }
  for f in funcs {
    roots = ownership.address_taken(f, roots);
  }
  let root_index: util.NameIndex = util.name_index(roots);
  let open: boolean[] = [];
  let j: i32 = 0;
  while (j < all.len()) {
    open = open.append(root_index.find(names[j]) >= 0 || root_index.find(all[j].key) >= 0 || closure_body_produced(all[j]));
    j = j + 1;
  }
  return open;
}

function fusion_on(): boolean {
  return !envflag.on("FERN_NO_ARRAY_FUSION");
}

pub function dyn_arms(funcs: parser.FuncDecl[], impls: parser.ImplInfo[], method: string, traits: string[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    let n: i32 = fd.receiver_type.len();
    if (generic_decl(fd) || n == 0 || n >= 2 && slice_unchecked(fd.receiver_type, n - 2, n) == "[]") {
      continue;
    }
    if (!arm_receiver_implements(impls, parser.receiver_base(fd.receiver_type), traits)) {
      continue;
    }
    if (parser.dyn_arm_matches(fd, traits, method)) {
      out = out.append(parser.decl_key(fd));
    }
  }
  return out;
}

function arm_receiver_implements(impls: parser.ImplInfo[], n: string, traits: string[]): boolean {
  if (implements_traits(impls, n, traits)) {
    return true;
  }
  let at: i32 = 1;
  while (at + 1 < n.len() && !(n[at] == b'_' && n[at + 1] == b'_')) {
    at = at + 1;
  }
  return at + 1 < n.len() && implements_traits(impls, slice_unchecked(n, 0, at) + "", traits);
}

function dispatched_arms(all: Produced[]): string[] {
  let out: string[] = [];
  for p in all {
    if (!p.ok) {
      continue;
    }
    for b in p.func.graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag != ssasem.call() || !ssasem.is_dyn_call(ins.str)) {
          continue;
        }
        for arm in ssasem.dyn_call_arms(ins.str) {
          if (util.index_of_str(out, arm) < 0) {
            out = out.append(arm);
          }
        }
      }
    }
  }
  return out;
}

pub function with_inferred_modes(b: Built): Built {
  let all: Produced[] = util.append_all(b.decls, b.instances);
  let inferred: Inferred = infer_ownership(all, b.names, b.contracts, b.dyn_arms);
  let decls: Produced[] = [];
  let instances: Produced[] = [];
  let i: i32 = 0;
  while (i < inferred.all.len()) {
    if (i < b.decls.len()) {
      decls = decls.append(inferred.all[i]);
    } else {
      instances = instances.append(inferred.all[i]);
    }
    i = i + 1;
  }
  return Built { ...b, decls: decls, instances: instances, contracts: inferred.table };
}

pub function changed_rows(a: Built, b: Built): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < a.decls.len() && i < b.decls.len()) {
    out = out.append(produced_moved(a.decls[i], b.decls[i]));
    i = i + 1;
  }
  i = 0;
  while (i < a.instances.len() && i < b.instances.len()) {
    out = out.append(produced_moved(a.instances[i], b.instances[i]));
    i = i + 1;
  }
  return out;
}

pub function any_row_changed(changed: boolean[]): boolean {
  for c in changed {
    if (c) {
      return true;
    }
  }
  return false;
}

function produced_moved(a: Produced, b: Produced): boolean {
  if (!same_bits_i32(a.modes, b.modes)) {
    return true;
  }
  return !same_call_modes(a.func.calls, b.func.calls);
}

function same_call_modes(a: ssasem.Contract[], b: ssasem.Contract[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i].name != b[i].name) {
      return false;
    }
    if (!same_bits_i32(a[i].modes, b[i].modes)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function same_bits_i32(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function renumber_source(blocks: ssa.SBlock[], map: i32[], ids: i32[], n: i32): sourcepos.SourceInfo {
  let top: i32 = 0;
  for b in blocks {
    if (b.id >= top) {
      top = b.id + 1;
    }
  }
  let out = sourcepos.SourceInfo { ...sourcepos.no_source(), values: sourcepos.blanks(n), terms: sourcepos.blanks(top) };
  for b in blocks {
    out = renumber_source_block(out, b, map, ids);
  }
  return out;
}

function renumber_source_block(own out: sourcepos.SourceInfo, b: ssa.SBlock, map: i32[], ids: i32[]): sourcepos.SourceInfo {
  let pos = sourcepos.SourcePos { line: 0, col: "0" };
  for ins in b.insts {
    if (ins.kind_tag == 35) {
      pos = sourcepos.SourcePos { line: ins.imm as i32, col: ins.str };
      if (out.entry.line == 0) {
        out = sourcepos.SourceInfo { ...out, entry: pos };
      }
    } else if (pos.line > 0) {
      let v = ids[resolve(map, ins.result)];
      if (v >= 0) {
        out = sourcepos.SourceInfo { ...out, values: out.values.with(v, pos) };
      }
    }
  }
  if (b.term.kind_tag == 1) {
    out = sourcepos.SourceInfo { ...out, terms: out.terms.with(b.id, pos) };
  }
  return out;
}

function renumber_block(b: ssa.SBlock, map: i32[], ids: i32[]): ssa.SBlock {
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag == 35) {
      continue;
    }
    if (map[ins.result] != ins.result) {
      continue;
    }
    let args: i32[] = [];
    for a in mapped_args(ins.args, map) {
      args = args.append(ids[a]);
    }
    let immediate: i32 = ins.imm;
    let donor: i32 = ssasem.update_base(ins);
    if (donor >= 0) {
      immediate = ids[resolve(map, donor)] + 1;
    }
    insts = insts.append(ssa.SInst { ...ins, result: ids[ins.result], args: args, imm: immediate });
  }
  let term = renumber_term(b.term, map, ids);
  return ssa.SBlock { ...b, insts: insts, term: term };
}

function renumber_term(input: ssa.STerm, map: i32[], ids: i32[]): ssa.STerm {
  let term: ssa.STerm = mapped_term(input, map);
  if (term.kind_tag == 1 && term.value >= 0) {
    term = ssa.STerm { ...term, value: ids[term.value] };
  }
  if (term.kind_tag == 3) {
    term = ssa.STerm { ...term, cond: ids[term.cond] };
  }
  return term;
}
