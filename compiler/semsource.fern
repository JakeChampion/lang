    ssasem.Contract { name: "__hvc", params: [typeinfo.t_i64(), typeinfo.t_i64(), typeinfo.t_i64(), typeinfo.t_i64()], modes: [v, v, v, v], result: typeinfo.t_i64() },
    ssasem.Contract { name: "__smc", params: [typeinfo.t_i64(), typeinfo.t_i64(), typeinfo.t_i64(), typeinfo.t_i64()], modes: [v, v, v, v], result: typeinfo.t_i64() },
    ssasem.Contract { name: "__port_in8", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__port_in16", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__port_in32", params: [typeinfo.t_i32()], modes: [v], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__port_out8", params: [typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v], result: typeinfo.t_void() },
    ssasem.Contract { name: "__port_out16", params: [typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v], result: typeinfo.t_void() },
    ssasem.Contract { name: "__port_out32", params: [typeinfo.t_i32(), typeinfo.t_i32()], modes: [v, v], result: typeinfo.t_void() },
    ssasem.Contract { name: "__ct_secret", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true }], modes: [b], result: typeinfo.t_void() },
    ssasem.Contract { name: "__ct_public", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true }], modes: [b], result: typeinfo.t_void() },
  ];
}

function aes_gcm_contracts(): ssasem.Contract[] {
  let b = ssaunits.borrow_mode();
  let view: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true };
  let bytes: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false };
  return [
    ssasem.Contract { name: "__bytes_owned", params: [view], modes: [b], result: bytes },
    ssasem.Contract { name: "__bytes_range", params: [view, typeinfo.t_i32(), typeinfo.t_i32()], modes: [b, ssaunits.value_mode(), ssaunits.value_mode()], result: bytes },
    ssasem.Contract { name: "__bytes_into", params: [bytes, typeinfo.t_i32(), view, typeinfo.t_i32(), typeinfo.t_i32()], modes: [ssaunits.counted_mode(), ssaunits.value_mode(), b, ssaunits.value_mode(), ssaunits.value_mode()], result: bytes },
    ssasem.Contract { name: "__aes_expand_key", params: [view], modes: [b], result: bytes },
    ssasem.Contract { name: "__aes_ctr32", params: [view, view, view], modes: [b, b, b], result: bytes },
    ssasem.Contract { name: "__ghash", params: [view, view, view], modes: [b, b, b], result: bytes },
    ssasem.Contract { name: "__aes_gcm_seal_into", params: aes_gcm_into_params(), modes: aes_gcm_into_modes(), result: bytes },
    ssasem.Contract { name: "__aes_gcm_open_into", params: aes_gcm_into_params(), modes: aes_gcm_into_modes(), result: bytes },
    ssasem.Contract { name: "__sha256_hw", params: [], modes: [], result: typeinfo.t_bool() },
    ssasem.Contract { name: "__sha256_hw_blocks", params: [view, view], modes: [b, b], result: bytes },
    ssasem.Contract { name: "__sha1_hw", params: [], modes: [], result: typeinfo.t_bool() },
    ssasem.Contract { name: "__sha1_hw_blocks", params: [view, view], modes: [b, b], result: bytes },
    ssasem.Contract { name: "__sha1x8_hw", params: [], modes: [], result: typeinfo.t_bool() },
    ssasem.Contract { name: "__sha1x8_hw_blocks", params: [view, view], modes: [b, b], result: bytes },
    ssasem.Contract {
      name: "__chacha20_xor_into", params: [view, view, bytes, typeinfo.t_i32(), typeinfo.t_i32()],
      modes: [b, b, ssaunits.counted_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: bytes,
    },
  ];
}

function aes_gcm_into_params(): typeinfo.Type[] {
  let view: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true };
  return [view, view, view, typeinfo.t_u64(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32()];
}

function aes_gcm_into_modes(): i32[] {
  let b = ssaunits.borrow_mode();
  let v = ssaunits.value_mode();
  return [b, b, b, v, ssaunits.counted_mode(), v, v, v, v];
}

function byte_scan_contracts(): ssasem.Contract[] {
  let lent = ssaunits.borrow_mode();
  let value = ssaunits.value_mode();
  return [
    ssasem.Contract { name: "__sum_bytes", params: [typeinfo.t_string()], modes: [lent], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__scale_f64", params: [typeinfo.TypeArray { elem: typeinfo.t_f64(), view: false }, typeinfo.t_f64()], modes: [lent, value], result: typeinfo.TypeArray { elem: typeinfo.t_f64(), view: false } },
    ssasem.Contract { name: "__outer_mul_f64", params: [typeinfo.TypeArray { elem: typeinfo.t_f64(), view: false }, typeinfo.TypeArray { elem: typeinfo.t_f64(), view: false }], modes: [lent, lent], result: typeinfo.TypeArray { elem: typeinfo.t_f64(), view: false } },
    ssasem.Contract { name: "__inner_mul_add_f64", params: [typeinfo.TypeArray { elem: typeinfo.t_f64(), view: false }, typeinfo.TypeArray { elem: typeinfo.t_f64(), view: false }, typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.t_f64()], modes: [lent, lent, value, value, value, value], result: typeinfo.TypeArray { elem: typeinfo.t_f64(), view: false } },
    ssasem.Contract { name: "__crc32_cksum", params: [typeinfo.t_i32(), typeinfo.t_string()], modes: [value, lent], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__crc32_cksum_array", params: [typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true }], modes: [value, lent], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__crc32_ieee_array", params: [typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true }], modes: [value, lent], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__ascii_run", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: [lent, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__scan_set", params: [typeinfo.t_string(), typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [lent, value, lent], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__scan_set_bytes", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [lent, value, lent], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__bsd_sum", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: [lent, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__str_hash", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: [lent, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__count_runs", params: [typeinfo.t_string(), typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [lent, value, lent], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__count_runs_bytes", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [lent, value, lent], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__count_byte", params: [typeinfo.t_string(), typeinfo.t_i32()], modes: [lent, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__memchr", params: [typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [lent, value, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__count_byte_bytes", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32()], modes: [lent, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__count_below_u64", params: [typeinfo.TypeArray { elem: typeinfo.t_u64(), view: false }, typeinfo.t_u64()], modes: [lent, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__sum_bytes_array", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true }], modes: [lent], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__bsd_sum_bytes", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true }, typeinfo.t_i32()], modes: [lent, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__memchr_bytes", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.t_i32()], modes: [lent, value, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__rmemchr_bytes", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.t_i32()], modes: [lent, value, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__mismatch_bytes", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true }, typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: true }, typeinfo.t_i32(), typeinfo.t_i32()], modes: [lent, value, lent, value, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__mismatch_bytes_str", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [lent, value, lent, value, value], result: typeinfo.t_i32() },
    ssasem.Contract { name: "__rmemchr", params: [typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [lent, value, value], result: typeinfo.t_i32() },
    ssasem.Contract {
      name: "__mismatch", params: [typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_i32()],
      modes: [lent, value, lent, value, value], result: typeinfo.t_i32(),
    },
  ];
}

function builder_contracts(): ssasem.Contract[] {
  let handle: i32[] = [ssaunits.value_mode()];
  let push: i32[] = [ssaunits.value_mode(), ssaunits.borrow_mode()];
  return [
    ssasem.Contract { name: "buf_new", params: [typeinfo.t_i32()], modes: handle, result: typeinfo.t_usize() },
    ssasem.Contract { name: "buf_push", params: [typeinfo.t_usize(), typeinfo.t_string()], modes: push, result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_range", params: [typeinfo.t_usize(), typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_bytes_range", params: [typeinfo.t_usize(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.t_i32()], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_mapped", params: [typeinfo.t_usize(), typeinfo.t_string(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_bytes_mapped", params: [typeinfo.t_usize(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_filtered", params: [typeinfo.t_usize(), typeinfo.t_string(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_bytes_filtered", params: [typeinfo.t_usize(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_expanded", params: [typeinfo.t_usize(), typeinfo.t_string(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_bytes_expanded", params: [typeinfo.t_usize(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_byte", params: [typeinfo.t_usize(), typeinfo.t_i32()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_u64", params: [typeinfo.t_usize(), typeinfo.t_u64()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_decimal", params: [typeinfo.t_usize(), typeinfo.t_u64()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_base64", params: [typeinfo.t_usize(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode(), ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_push_base32", params: [typeinfo.t_usize(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode(), ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_decode_base32", params: [typeinfo.t_usize(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.t_i32(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode(), ssaunits.borrow_mode()], result: typeinfo.t_i32() },
    ssasem.Contract { name: "buf_len", params: [typeinfo.t_usize()], modes: handle, result: typeinfo.t_i32() },
    ssasem.Contract { name: "buf_take", params: [typeinfo.t_usize()], modes: handle, result: typeinfo.t_string() },
    ssasem.Contract { name: "buf_take_bytes", params: [typeinfo.t_usize()], modes: handle, result: typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false } },
    ssasem.Contract { name: "buf_clear", params: [typeinfo.t_usize()], modes: handle, result: typeinfo.t_void() },
    ssasem.Contract { name: "buf_free", params: [typeinfo.t_usize()], modes: handle, result: typeinfo.t_void() },
  ];
}

function union_result_contracts(): ssasem.Contract[] {
  let path: i32[] = [ssaunits.borrow_mode()];
  let out: ssasem.Contract[] = [
    ssasem.Contract { name: "env", params: [typeinfo.t_string()], modes: path, result: t_option(typeinfo.t_string()) },
    ssasem.Contract { name: "config_get", params: [typeinfo.t_string()], modes: path, result: t_option(typeinfo.t_string()) },
    ssasem.Contract { name: "read_file", params: [typeinfo.t_string()], modes: path, result: t_io_result(typeinfo.t_string()) },
    ssasem.Contract { name: "read_file_bytes", params: [typeinfo.t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }) },
    ssasem.Contract { name: "read_dir", params: [typeinfo.t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: typeinfo.t_string(), view: false }) },
    ssasem.Contract { name: "read_dir_bytes", params: [typeinfo.t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, view: false }) },
    ssasem.Contract { name: "read_dir_all", params: [typeinfo.t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: typeinfo.t_string(), view: false }) },
    ssasem.Contract { name: "read_dir_ino", params: [typeinfo.t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: typeinfo.TypeStruct { name: "DirEntry", args: [] }, view: false }) },
    ssasem.Contract { name: "read_dir_ino_all", params: [typeinfo.t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: typeinfo.TypeStruct { name: "DirEntry", args: [] }, view: false }) },
    ssasem.Contract { name: "stat", params: [typeinfo.t_string()], modes: path, result: t_io_result(t_file_stat()) },
    ssasem.Contract { name: "lstat", params: [typeinfo.t_string()], modes: path, result: t_io_result(t_file_stat()) },
  ];
  for c in outcome_contracts() {
    out = out.append(c);
  }
  return out;
}

function outcome_contracts(): ssasem.Contract[] {
  let path: i32[] = [ssaunits.borrow_mode()];
  let written: i32[] = [ssaunits.borrow_mode(), ssaunits.borrow_mode()];
  let done = t_io_result(typeinfo.t_void());
  return [
    ssasem.Contract { name: "write_file", params: [typeinfo.t_string(), typeinfo.t_string()], modes: written, result: done },
    ssasem.Contract { name: "write_file_bytes", params: [typeinfo.t_string(), typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: written, result: done },
    ssasem.Contract { name: "write_file_exec", params: [typeinfo.t_string(), typeinfo.t_string()], modes: written, result: done },
    ssasem.Contract { name: "create_dir_all", params: [typeinfo.t_string()], modes: path, result: done },
    ssasem.Contract { name: "remove_dir_all", params: [typeinfo.t_string()], modes: path, result: done },
    ssasem.Contract { name: "remove_file", params: [typeinfo.t_string()], modes: path, result: done },
  ];
}

function value_contracts(): ssasem.Contract[] {
  let value: i32[] = [ssaunits.value_mode()];
  let strs: typeinfo.Type = typeinfo.TypeArray { elem: typeinfo.t_string(), view: false };
  return [
    ssasem.Contract { name: "args", params: [], modes: [], result: strs },
    ssasem.Contract { name: "set_args", params: [strs], modes: [ssaunits.borrow_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "random_bytes", params: [typeinfo.t_i32()], modes: value, result: typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false } },
    ssasem.Contract { name: "random_i32", params: [], modes: [], result: typeinfo.t_i32() },
    ssasem.Contract { name: "now_unix_ms", params: [], modes: [], result: typeinfo.t_i64() },
    ssasem.Contract { name: "now_ns", params: [], modes: [], result: typeinfo.t_i64() },
    ssasem.Contract { name: "monotonic_ns", params: [], modes: [], result: typeinfo.t_i64() },
    ssasem.Contract { name: "clock_resolution", params: [], modes: [], result: typeinfo.t_i64() },
    ssasem.Contract { name: "sleep_ms", params: [typeinfo.t_i64()], modes: value, result: typeinfo.t_void() },
    ssasem.Contract { name: "sleep_ns", params: [typeinfo.t_i64()], modes: value, result: typeinfo.t_void() },
    ssasem.Contract { name: "putchar", params: [typeinfo.t_i32()], modes: value, result: typeinfo.t_void() },
    ssasem.Contract { name: "f32_bits", params: [typeinfo.t_f32()], modes: value, result: typeinfo.t_i32() },
    ssasem.Contract { name: "f32_from_bits", params: [typeinfo.t_i32()], modes: value, result: typeinfo.t_f32() },
  ];
}

function string_contracts(): ssasem.Contract[] {
  let writer: i32[] = [ssaunits.borrow_mode()];
  return [
    ssasem.Contract { name: "print", params: [typeinfo.t_string()], modes: writer, result: typeinfo.t_void() },
    ssasem.Contract { name: "eprint", params: [typeinfo.t_string()], modes: writer, result: typeinfo.t_void() },
    ssasem.Contract { name: "__memchr", params: [typeinfo.t_string(), typeinfo.t_i32(), typeinfo.t_i32()], modes: [ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: typeinfo.t_i32() },
    ssasem.Contract { name: "write", params: [typeinfo.t_string()], modes: writer, result: typeinfo.t_void() },
    ssasem.Contract { name: "exit", params: [typeinfo.t_i32()], modes: [ssaunits.value_mode()], result: typeinfo.t_void() },
    ssasem.Contract { name: "string_from_bytes_unchecked", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }], modes: [ssaunits.counted_mode()], result: typeinfo.t_string() },
    ssasem.Contract { name: "string_from_bytes_range_unchecked", params: [typeinfo.TypeArray { elem: typeinfo.t_u8(), view: false }, typeinfo.t_i32(), typeinfo.t_i32()], modes: [ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: typeinfo.t_string() },
    ssasem.Contract { name: "f64_bits", params: [typeinfo.t_f64()], modes: [ssaunits.value_mode()], result: typeinfo.t_i64() },
    ssasem.Contract { name: "f64_from_bits", params: [typeinfo.t_i64()], modes: [ssaunits.value_mode()], result: typeinfo.t_f64() },
  ];
}

function close_module(all: Produced[], names: util.NameIndex): Produced[] {
  let changed = true;
  while (changed) {
    changed = false;
    let i = 0;
    while (i < all.len()) {
      if (all[i].ok) {
        for c in all[i].func.calls {
          let at = names.find(c.name);
          if (at >= 0 && !all[at].ok && !all[at].bodyless && all[i].ok) {
            all = all.with(i, Produced { ...refuse("call target was refused: " + all[at].why), key: all[i].key });
            changed = true;
          }
        }
      }
      i += 1;
    }
  }
  return all;
}

struct Anchored { all: Produced[], names: string[] }

function anchor_module(all: Produced[], names: string[], verify: boolean): Anchored {
  let anchors: ssasem.Anchor[] = [];
  let copied = true;
  while (copied) {
    let changed = true;
    while (changed) {
      changed = false;
      let i = 0;
      while (i < all.len()) {
        if (all[i].ok && ssasem.holds_view(all[i].func, all[i].func.result) && !ssasem.anchored(anchors, names[i])) {
          let k = ssasem.result_anchor(all[i].func, anchors, names);
          if (!k.escapes && !k.pending) {
            anchors = anchors.append(ssasem.Anchor { name: names[i], params: k.params });
            changed = true;
          }
        }
        i += 1;
      }
    }
    copied = false;
    let j = 0;
    while (j < all.len()) {
      let p = all[j];
      if (p.ok && ssasem.is_view(p.func.result) && !ssasem.anchored(anchors, names[j])
        && ssasem.result_anchor(p.func, anchors, names).escapes) {
        all = all.with(j, Produced { ...p, func: copy_returned_views(p.func) });
        anchors = anchors.append(ssasem.Anchor { name: names[j], params: [] });
        copied = true;
      }
      j += 1;
    }
  }
  let out: Produced[] = [];
  let helpers = CopyHelpers { types: [], from: [] };
  for i in 0..all.len() {
    let p = all[i];
    if (p.ok && ssasem.holds_view(p.func, p.func.result) && !ssasem.anchored(anchors, names[i])) {
      let source = ssasem.result_anchor(p.func, anchors, names);
      p = Produced { ...refuse("view result escapes its source"), key: p.key, view_escape: source.escape_kind };
    }
    if (verify && p.ok && !p.template) {
      p = Produced { ...p, func: ssasem.Func { ...p.func, anchors: anchors } };
      let plan = ssasem.merge_copies(p.func);
      if (plan.why != "") {
        p = Produced { ...refuse(plan.why), key: p.key };
      } else {
        if (plan.copies.len() > 0) {
          p = Produced { ...p, func: ssasem.with_merge_copies(p.func, plan.copies) };
          helpers = with_copy_helpers(helpers, p.func);
          anchors = helper_anchors(anchors, helpers);
          p = Produced { ...p, func: ssasem.Func { ...p.func, anchors: anchors } };
        }
        let analysis = ssasem.analyze(p.func);
        if (!analysis.ok) {
          p = Produced { ...refuse("produced graph fails semantic verification: " + analysis.why), key: p.key };
        } else {
          p = Produced { ...p, func: ssasem.checked_schema(p.func, analysis), analysis: Some(analysis) };
        }
      }
    }
    out = out.append(p);
  }
  return helper_rows(out, names, helpers, anchors);
}

function helper_rows(out: Produced[], names: string[], helpers: CopyHelpers, anchors: ssasem.Anchor[]): Anchored {
  let h = 0;
  while (h < helpers.types.len()) {
    let f = ssasem.copy_helper_func(helpers.from[h], helpers.types[h]);
    helpers = with_copy_helpers(helpers, f);
    anchors = helper_anchors(anchors, helpers);
    f = ssasem.Func { ...f, anchors: anchors };
    let p = Produced { ...refuse(""), ok: true, func: f, modes: [ssaunits.borrow_mode()] };
    let analysis = ssasem.analyze(f);
    if (!analysis.ok) {
      p = refuse("copy helper fails semantic verification: " + analysis.why);
    } else {
      p = Produced { ...p, func: ssasem.checked_schema(f, analysis), analysis: Some(analysis) };
    }
    out = out.append(p);
    names = names.append(ssasem.copy_helper(helpers.types[h]));
    h += 1;
  }
  return Anchored { all: close_module(out, util.name_index(names)), names: names };
}

struct CopyHelpers { types: typeinfo.Type[], from: ssasem.Func[] }

function with_copy_helpers(h: CopyHelpers, f: ssasem.Func): CopyHelpers {
  for t in ssasem.copy_helpers_called(f) {
    let known = false;
    for x in h.types {
      if (semtypes.equal(x, t)) {
        known = true;
      }
    }
    if (!known) {
      h = CopyHelpers { types: h.types.append(t), from: h.from.append(f) };
    }
  }
  return h;
}

function helper_anchors(anchors: ssasem.Anchor[], h: CopyHelpers): ssasem.Anchor[] {
  for t in h.types {
    if (!ssasem.anchored(anchors, ssasem.copy_helper(t))) {
      anchors = anchors.append(ssasem.Anchor { name: ssasem.copy_helper(t), params: [] });
    }
  }
  return anchors;
}

function copy_returned_views(f: ssasem.Func): ssasem.Func {
  let values = f.values;
  let blocks: ssa.SBlock[] = [];
  for b in f.graph.blocks {
    let v = b.term.value;
    if (b.term.kind_tag == ssa.TERM_RET && v >= 0 && ssasem.is_view(values[v])) {
      let first = values.len();
      for t in ssasem.view_copy_types() {
        values = values.append(t);
      }
      let insts = b.insts;
      for ci in ssasem.view_copy(first, v) {
        insts = insts.append(ci);
      }
      b = ssa.SBlock { ...b, insts: insts, term: ssa.t_ret(first + 2) };
    }
    blocks = blocks.append(b);
  }
  return ssasem.Func { ...f, values: values, graph: ssa.SFunc { ...f.graph, blocks: blocks, nvals: values.len() } };
}

function template_entry(key: string, ok: boolean, why: string, bodyless: boolean): Produced {
  return Produced { ...refuse(why), ok: ok, template: true, key: key, bodyless: bodyless };
}

function template_verdict(key: string, instances: Produced[]): Produced {
  let seen = false;
  for p in instances {
    if (p.key == key) {
      seen = true;
      if (!p.ok && !p.dropped) {
        return template_entry(key, false, p.why, false);
      }
    }
  }
  if (!seen) {
    return template_entry(key, false, "uninstantiated generic", true);
  }
  return template_entry(key, true, "", false);
}

struct Queue { pending: Request[], names: util.NameIndex }

function queue(q: Queue, requests: Request[]): Queue {
  for r in requests {
    if (!q.names.has(r.name)) {
      q = Queue { pending: q.pending.append(r), names: q.names.added(r.name) };
    }
  }
  return q;
}

function instance_limit(): i32 {
  return 16384;
}

struct Inferred { all: Produced[], table: ssasem.Contracts }

// A row's bit is the parameter's final mode, so a caller counts an argument only where the callee will.
function mode_bits(p: Produced, escapes: boolean[]): boolean[] {
  let out: boolean[] = [];
  for i in 0..p.func.params.len() {
    let consumed = i >= escapes.len() || escapes[i];
    if (i < p.modes.len()) {
      out = out.append(inferred_mode(p.modes[i], p.func.params[i], consumed) == ssaunits.counted_mode());
    } else {
      out = out.append(consumed);
    }
  }
  return out;
}

function same_bits(a: boolean[], b: boolean[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

function inferred_mode(old: i32, t: typeinfo.Type, consumed: boolean): i32 {
  if (!reference(t)) {
    return old;
  }
  if (old == ssaunits.counted_mode()) {
    return old;
  }
  if (consumed && ssasem.owned_shape(t)) {
    return ssaunits.counted_mode();
  }
  return old;
}

function inferred_contract(c: ssasem.Contract, rows: ownership.Escapes[], ix: ownership.Index): ssasem.Contract {
  let row = ownership.find(rows, ix, c.name);
  if (row < 0) {
    return c;
  }
  let modes = c.modes;
  let i = 0;
  while (i < modes.len() && i < c.params.len()) {
    modes = modes.with(i, inferred_mode(modes[i], c.params[i], ownership.consumed_at(rows, row, i)));
    i += 1;
  }
  return ssasem.Contract { ...c, modes: modes };
}

function inferred_table(table: ssasem.Contracts, rows: ownership.Escapes[], ix: ownership.Index): ssasem.Contracts {
  let out: ssasem.Contract[] = [];
  for c in table.list {
    out = out.append(inferred_contract(c, rows, ix));
  }
  return ssasem.contracts_of(out);
}

function inferred_produced(p: Produced, name: string, rows: ownership.Escapes[], ix: ownership.Index): Produced {
  let calls0: ssasem.Contract[] = [];
  for c in p.func.calls {
    calls0 = calls0.append(inferred_contract(c, rows, ix));
  }
  let row = ownership.find(rows, ix, name);
  if (row < 0) {
    return Produced { ...p, func: ssasem.Func { ...p.func, calls: calls0 } };
  }
  let modes = p.modes;
  let i = 0;
  while (i < modes.len() && i < p.func.params.len()) {
    modes = modes.with(i, inferred_mode(modes[i], p.func.params[i], ownership.consumed_at(rows, row, i)));
    i += 1;
  }
  return Produced { ...p, modes: modes, func: ssasem.Func { ...p.func, calls: calls0 } };
}

function closure_body_produced(p: Produced): boolean {
  if (p.func.params.len() == 0) {
    return false;
  }
  return semtypes.is_env(p.func.params[0]);
}

function builtin_row(c: ssasem.Contract): ownership.Escapes {
  let bits: boolean[] = [];
  for m in c.modes {
    bits = bits.append(m == ssaunits.counted_mode());
  }
  return ownership.Escapes { name: c.name, bits: bits, lends: reference(c.result) && !ssasem.fresh_result_builtin(c.name) && !rtbytecopy.is_helper(c.name), cycle: -1, quiet: [] };
}

pub function with_analyses(b: Built): Built {
  return Built { ...b, decls: analysed_rows(b.decls), instances: analysed_rows(b.instances) };
}

function analysed_rows(rows: Produced[]): Produced[] {
  let i = 0;
  while (i < rows.len()) {
    if (rows[i].ok && !rows[i].template) {
      match (rows[i].analysis) {
        None => {
          let analysis = ssasem.analyze(rows[i].func);
          rows = rows.with(i, Produced { ...rows[i], func: ssasem.checked_schema(rows[i].func, analysis), analysis: Some(analysis) });
        },
        _ => {}
      }
    }
    i += 1;
  }
  return rows;
}

function row_analysis(p: Produced): ssasem.Analysis {
  match (p.analysis) {
    Some(a) => {
      return a;
    },
    None => {
      return ssasem.analyze(p.func);
    }
  }
}

function quiet_cycles(rows: ownership.Escapes[], ix: ownership.Index, all: Produced[], names: string[]): ownership.Escapes[] {
  let quiet = __alloc_bool(rows.len());
  let slots: boolean[][] = [];
  let succ: i32[][] = [];
  let i = 0;
  while (i < rows.len()) {
    succ = succ.append([]);
    slots = slots.append([]);
    i += 1;
  }
  i = 0;
  while (i < all.len() && i < names.len()) {
    let at = ownership.find(rows, ix, names[i]);
    if (at >= 0) {
      let qs = quiet_slots(all[i].func);
      slots = slots.with(at, qs);
      quiet = quiet.with(at, !reference(all[i].func.result) || util.any_true(qs));
    }
    i += 1;
  }
  i = 0;
  while (i < all.len() && i < names.len()) {
    let at = ownership.find(rows, ix, names[i]);
    if (at >= 0 && quiet[at]) {
      let out: i32[] = [];
      for b in all[i].func.graph.blocks {
        for ins in b.insts {
          if (ins.kind_tag == ssasem.call() || ins.kind_tag == ssa.PHI && ins.str != "") {
            let to = ownership.find(rows, ix, ins.str);
            if (to >= 0 && quiet[to]) {
              out = out.append(to);
            }
          }
        }
      }
      succ = succ.with(at, out);
    }
    i += 1;
  }
  let comp = ownership.cycles(succ);
  let out_rows: ownership.Escapes[] = [];
  for k in 0..rows.len() {
    out_rows = out_rows.append(ownership.Escapes { ...rows[k], cycle: comp[k], quiet: slots[k] });
  }
  return out_rows;
}

function quiet_slots(f: ssasem.Func): boolean[] {
  let out: boolean[] = [];
  let holds = reference(f.result);
  for t in f.params {
    out = out.append(reference(t) && (!holds || !ssasem.can_hold(f, f.result, t)));
  }
  return out;
}

function inferred_modes_change(p: Produced): boolean {
  for i in 0..p.func.params.len() {
    if (i >= p.modes.len() || inferred_mode(p.modes[i], p.func.params[i], true) != inferred_mode(p.modes[i], p.func.params[i], false)) {
      return true;
    }
  }
  return false;
}

function infer_rows(all: Produced[], names: string[], pinned: string[]): ownership.Escapes[] {
  let taken = pinned;
  for k in 0..all.len() {
    if (all[k].ok) {
      taken = ownership.address_taken(all[k].func, taken);
    }
  }
  let taken_ix = util.name_index(taken);
  let rows: ownership.Escapes[] = [];
  let analyses: ssasem.Analysis[] = [];
  let modes_change: boolean[] = [];
  let i = 0;
  while (i < all.len() && i < names.len()) {
    modes_change = modes_change.append(inferred_modes_change(all[i]));
    if (all[i].ok && !all[i].template && !closure_body_produced(all[i]) && !taken_ix.has(names[i])) {
      rows = rows.append(ownership.Escapes { name: names[i], bits: mode_bits(all[i], []), lends: false, cycle: -1, quiet: [] });
      analyses = analyses.append(row_analysis(all[i]));
    } else {
      analyses = analyses.append(ssasem.refused_analysis("not produced"));
    }
    i += 1;
  }
  let produced = ownership.index(rows);
  rows = quiet_cycles(rows, produced, all, names);
  let builtins = util.name_index([]);
  for c in builtin_contracts() {
    if (ownership.find(rows, produced, c.name) < 0 && !builtins.has(c.name)) {
      rows = rows.append(builtin_row(c));
      builtins = builtins.added(c.name);
    }
  }
  let ix = ownership.index(rows);
  let own_row: i32[] = [];
  i = 0;
  while (i < all.len() && i < names.len()) {
    own_row = own_row.append(ownership.find(rows, ix, names[i]));
    i += 1;
  }
  let readers = row_readers(all, own_row, rows, ix);
  let work: i32[] = [];
  let queued = __alloc_bool(own_row.len());
  i = 0;
  while (i < own_row.len()) {
    work = work.append(i);
    queued = queued.with(i, true);
    i += 1;
  }
  let cap = (all.len() + 2) * own_row.len();
  let wi = 0;
  while (wi < work.len() && wi <= cap) {
    i = work[wi];
    wi += 1;
    queued = queued.with(i, false);
    let at = own_row[i];
    if (all[i].ok && !all[i].template && at >= 0 && !closure_body_produced(all[i])) {
      let transfers = ownership.transfers(all[i].func, analyses[i], rows, ix, modes_change[i]);
      let next = mode_bits(all[i], transfers.escapes);
      let lends = rows[at].lends || transfers.lends;
      if (!same_bits(rows[at].bits, next) || lends != rows[at].lends) {
        rows = rows.with(at, ownership.Escapes { ...rows[at], bits: next, lends: lends });
        for j in readers[at] {
          if (!queued[j]) {
            work = work.append(j);
            queued = queued.with(j, true);
          }
        }
      }
    }
  }
  return rows;
}

function row_readers(all: Produced[], own_row: i32[], rows: ownership.Escapes[], ix: ownership.Index): i32[][] {
  let out: i32[][] = [];
  let last = util.minus_ones(rows.len());
  while (out.len() < rows.len()) {
    out = out.append([]);
  }
  for i in 0..own_row.len() {
    if (own_row[i] >= 0) {
      for b in all[i].func.graph.blocks {
        for ins in b.insts {
          if (ins.str != "") {
            let at = ownership.find(rows, ix, ins.str);
            if (at >= 0 && last[at] != i) {
              out = out.with(at, out[at].append(i));
              last = last.with(at, i);
            }
          }
        }
      }
    }
  }
  return out;
}

function infer_ownership(all: Produced[], names: string[], table: ssasem.Contracts, pinned: string[]): Inferred {
  let rows = infer_rows(all, names, pinned);
  let ix = ownership.index(rows);
  let out: Produced[] = [];
  for i in 0..all.len() {
    let name = "";
    if (i < names.len()) {
      name = names[i];
    }
    out = out.append(inferred_produced(all[i], name, rows, ix));
  }
  return Inferred { all: out, table: inferred_table(table, rows, ix) };
}

// Diagnostic switches that turn semantic passes off. env_passes reads them
// once, where the build options are made.
pub struct PassSwitches { reach: boolean, inline: boolean, scale_kernel: boolean, product_kernel: boolean, fusion: boolean }

pub function env_passes(): PassSwitches {
  let inline = true;
  match (env("FERN_SEM_INLINE")) {
    Some(v) => {
      inline = envflag.value_on(v);
    },
    None => {}
  }
  return PassSwitches { reach: !envflag.on("FERN_NO_SEM_REACH"), inline: inline, scale_kernel: !envflag.on("FERN_NO_SCALE_KERNEL"), product_kernel: !envflag.on("FERN_NO_PRODUCT_KERNEL"), fusion: !envflag.on("FERN_NO_ARRAY_FUSION") };
}

pub struct BuildOpts { debug_lines: boolean, size: boolean, whole: boolean, array_report: i32, stack_phi_joins: boolean, passes: PassSwitches }

pub function plain_build(): BuildOpts {
  return BuildOpts { debug_lines: false, size: false, whole: false, array_report: semarrayreport.off(), stack_phi_joins: false, passes: env_passes() };
}

pub function build_module(mod: parser.Module): Built {
  return produce_module(mod, true, plain_build());
}

pub function build_module_with(mod: parser.Module, opts: BuildOpts): Built {
  return produce_module(mod, true, opts);
}

pub function check_views(mod: parser.Module): util.Diag[] {
  return view_escape_diags(mod, produce_module(mod, false, plain_build()));
}

function produce_module(mod: parser.Module, verify: boolean, opts: BuildOpts): Built {
  let finalizers = finalized_types(mod.funcs);
  let scopes = checker.module_scopes(mod);
  let table = contracts(mod, scopes);
  let handed_back = handers(mod);
  let shadows = shadowed_builtins(mod);
  let views: string[] = [];
  if (scopes.len() > 0) {
    views = view_types(scopes[0], mod.impls, table);
  }
  let decls: Produced[] = [];
  let names: string[] = [];
  let pending = Queue { pending: [], names: util.name_index([]) };
  let memo = no_memo();
  let i = 0;
  while (i < mod.funcs.len()) {
    let fd = mod.funcs[i];
    let p = template_entry(parser.decl_key(fd), false, "uninstantiated generic", true);
    if (!generic_decl(fd)) {
      let made = build(fd, scopes[i], table, ssasem.unbound(), fd.name, handed_back, shadows, views, mod.funcs, mod.impls, finalizers, memo, opts.debug_lines);
      p = made.p;
      memo = made.memo;
    }
    pending = queue(pending, p.requests);
    decls = decls.append(p);
    names = names.append(parser.decl_key(fd));
    i += 1;
  }
  let decl_index = util.name_index(names);
  let instances: Produced[] = [];
  let at = 0;
  while (at < pending.pending.len()) {
    let r = pending.pending[at];
    let di = decl_index.find(r.key);
    let p = refuse("unbounded instantiation");
    if (at < instance_limit()) {
      let made = build(mod.funcs[di], scopes[di], table, r.binding, r.name, handed_back, shadows, views, mod.funcs, mod.impls, finalizers, memo, opts.debug_lines);
      p = made.p;
      memo = made.memo;
    }
    pending = queue(pending, p.requests);
    instances = instances.append(Produced { ...p, key: r.key });
    names = names.append(r.name);
    at += 1;
  }
  let closed = close_module(util.append_all(decls, instances), util.name_index(names));
  finalizers = cell_writing_finalizers(closed, names, finalizers);
  let anchored = anchor_module(with_finalizers(closed, finalizers), names, verify);
  let all = anchored.all;
  names = anchored.names;
  let laid: semrecords.Record[] = [];
  if (verify) {
    let sp = specialize_calls(fuse_pipelines(unroll_loops(reach_module(all, names, mod, opts, false), names), names, mod.funcs, opts.array_report, opts.passes), names, table, mod, opts.passes);
    names = sp.names;
    table = sp.table;
    let inlined = inline_leaves(sp.all, names, mod, opts, sp.roots);
    table = split_contracts(table, inlined.all, names);
    laid = inlined.laid;
    all = prune_dead_constructions(reach_module(scale_ndarray_maps(unique_loops(byte_copy_loops(without_unnamed(inlined.all, names, inlined.spliced, mod))), names, mod, opts.array_report, opts.passes), names, mod, opts, true), opts.stack_phi_joins);
  }
  decls = [];
  instances = [];
  i = 0;
  while (i < all.len()) {
    if (i < mod.funcs.len()) {
      decls = decls.append(all[i]);
    } else {
      instances = instances.append(all[i]);
    }
    i += 1;
  }
  i = 0;
  while (i < decls.len()) {
    if (decls[i].template) {
      decls = decls.with(i, template_verdict(names[i], instances));
    }
    i += 1;
  }
  let records = laid_records(semrecords.Records { list: memo.records, names: memo.record_names }, laid);
  return Built { decls: decls, instances: instances, contracts: table, names: names, dyn_arms: dispatched_arms(util.append_all(decls, instances)), records: records, enums: memo.enums, finalizers: finalizers, laid: laid };
}

function laid_records(records: semrecords.Records, laid: semrecords.Record[]): semrecords.Records {
  let list = records.list;
  for r in laid {
    let at = semrecords.find(records, r.ty);
    if (at >= 0) {
      list = list.with(at, r);
    }
  }
  return semrecords.Records { ...records, list: list };
}

pub function view_escape_diags(mod: parser.Module, built: Built): util.Diag[] {
  let kinds: i32[] = [];
  let names: string[] = [];
  let i = 0;
  while (i < mod.funcs.len()) {
    kinds = kinds.append(built.decls[i].view_escape);
    names = names.append(parser.decl_key(mod.funcs[i]));
    i += 1;
  }
  let decl_index = util.name_index(names);
  for p in built.instances {
    let at = decl_index.find(p.key);
    if (p.view_escape > 0 && at >= 0 && kinds[at] == 0) {
      kinds = kinds.with(at, p.view_escape);
    }
  }
  let out: util.Diag[] = [];
  for i in 0..kinds.len() {
    if (kinds[i] > 0) {
      let code = "E063";
      if (kinds[i] == 2) {
        code = "E065";
      }
      let fd = mod.funcs[i];
      let reported = false;
      for d in out {
        if (fd.line > 0 && d.code == code && d.line == fd.line && d.col == fd.col) {
          reported = true;
        }
      }
      if (!reported) {
        out = out.append(util.Diag {
          length: 0,
          related: [],
          code: code,
          message: "the returned view's source cannot be kept alive beyond this function: return owned storage or a view of a parameter instead",
          line: fd.line, col: fd.col,
          fix: None,
        });
      }
    }
  }
  return out;
}

struct Spliced { all: Produced[], spliced: boolean[], laid: semrecords.Record[] }

// A callee that takes a record parameter as its fields declares the fields.
function split_contracts(table: ssasem.Contracts, all: Produced[], names: string[]): ssasem.Contracts {
  let list = table.list;
  for i in 0..names.len() {
    let p = all[i];
    let at = table.names.find(names[i]);
    if (p.ok && !p.template && !p.bodyless && at >= 0 && !same_types(list[at].params, p.func.params)) {
      list = list.with(at, ssasem.Contract { ...list[at], params: p.func.params, modes: p.modes });
    }
  }
  return ssasem.Contracts { ...table, list: list };
}

function same_types(a: typeinfo.Type[], b: typeinfo.Type[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (!semtypes.equal(a[i], b[i])) {
      return false;
    }
  }
  return true;
}

function unique_loops(all: Produced[]): Produced[] {
  let sw = optbisect.switches();
  let out: Produced[] = [];
  for old in all {
    let p = old;
    if (p.ok && !p.template) {
      let h = semunique.hoisted(p.func, p.modes);
      if (h.changed && optbisect.allowed_by(sw, "unique-loops", p.func.graph.name)) {
        p = Produced { ...p, func: h.func, analysis: None };
      }
    }
    out = out.append(p);
  }
  return out;
}

function byte_copy_loops(all: Produced[]): Produced[] {
  let out: Produced[] = [];
  let contracts = byte_copy_contracts();
  let sw = optbisect.switches();
  for old in all {
    let p = old;
    if (p.ok && !p.template) {
      let r = sembytecopy.rewrite(p.func, contracts);
      if (r.changed && optbisect.allowed_by(sw, "byte-copy", p.func.graph.name)) {
        p = Produced { ...p, func: r.func, analysis: None };
      }
    }
    out = out.append(p);
  }
  return out;
}

function inline_leaves(all: Produced[], names: string[], mod: parser.Module, opts: BuildOpts, roots: i32[]): Spliced {
  if (!opts.passes.inline) {
    return Spliced { all: all, spliced: [], laid: [] };
  }
  let funcs: ssasem.Func[] = [];
  let modes: i32[][] = [];
  let inlinable: boolean[] = [];
  let rewrite: boolean[] = [];
  let unnamed: boolean[] = [];
  let uncalled: boolean[] = [];
  let always: boolean[] = [];
  let late = util.name_index(late_named(all));
  let keys = decl_keys(mod.funcs);
  let lowered = lowered_names();
  let sw = optbisect.switches();
  let i = 0;
  while (i < all.len()) {
    let p = all[i];
    let usable = p.ok && !p.template && !p.bodyless;
    let d = decl_of(p, i, mod.funcs.len(), keys);
    funcs = funcs.append(p.func);
    modes = modes.append(p.modes);
    rewrite = rewrite.append(usable);
    inlinable = inlinable.append(usable && d >= 0 && inlinable_decl(mod.funcs[d]) && !lowered.has(names[i]) && optbisect.allowed_by(sw, "inline", names[i]));
    uncalled = uncalled.append(outside_uncalled(p, names[i], i, mod, late));
    unnamed = unnamed.append(uncalled[i] && spliceable_body(p, names[i], i, mod));
    always = always.append(d >= 0 && mod.funcs[d].always_inline);
    i += 1;
  }
  let out = seminline.inline_leaves(funcs, names, modes, inlinable, rewrite, unnamed, uncalled, always, opts.size, roots);
  let result: Produced[] = [];
  for i in 0..all.len() {
    let p = Produced { ...all[i], func: out.funcs[i], modes: out.modes[i] };
    if (out.rewritten[i]) {
      p = Produced { ...p, func: ssabounds.proven_indices(p.func), analysis: None };
    }
    result = result.append(p);
  }
  return Spliced { all: result, spliced: out.spliced, laid: out.laid };
}

function without_unnamed(all: Produced[], names: string[], spliced: boolean[], mod: parser.Module): Produced[] {
  let gone = unnamed(all, names, spliced, mod);
  let out: Produced[] = [];
  for i in 0..all.len() {
    if (gone[i]) {
      out = out.append(Produced { ...all[i], ok: false, why: "spliced into every caller", func: refuse("").func, analysis: None, dropped: true });
    } else {
      out = out.append(all[i]);
    }
  }
  return out;
}

function reach_module(all: Produced[], names: string[], mod: parser.Module, opts: BuildOpts, prune: boolean): Produced[] {
  if (!opts.whole || !opts.passes.reach) {
    return all;
  }
  let funcs: ssasem.Func[] = [];
  let usable: boolean[] = [];
  let blocked: boolean[] = [];
  let entries: boolean[] = [];
  for i in 0..all.len() {
    let p = all[i];
    funcs = funcs.append(p.func);
    usable = usable.append(p.ok && !p.template && !p.bodyless);
    blocked = blocked.append(!p.ok && !p.template && !p.bodyless && !p.dropped);
    entries = entries.append(i < mod.funcs.len() && entry_decl(mod.funcs[i], mod));
  }
  let r = semreach.reach(funcs, names, usable, blocked, reach_roots(all, names, entries, mod));
  if (!r.ok) {
    return all;
  }
  // Kernel selection can introduce calls to definitions not yet referenced.
  if (!prune) {
    return with_reach_facts(all, r);
  }
  return with_reached(all, usable, r);
}

function with_reach_facts(all: Produced[], r: semreach.Reached): Produced[] {
  let out: Produced[] = [];
  for i in 0..all.len() {
    let p = all[i];
    if (r.rewritten[i]) {
      p = Produced { ...p, func: r.funcs[i], analysis: None };
    }
    out = out.append(p);
  }
  return out;
}

function with_reached(all: Produced[], usable: boolean[], r: semreach.Reached): Produced[] {
  let gone = util.name_index(dropped_envs(all, usable, r.live));
  let out: Produced[] = [];
  for i in 0..all.len() {
    let p = all[i];
    // A refused body can be an unused specialization of a bounded method.
    // reach() has already rejected every reachable refused body.
    if (!r.live[i] && !p.template && !p.bodyless && !p.dropped) {
      p = Produced { ...p, ok: false, why: "reached by nothing", func: refuse("").func, analysis: None, dropped: true };
    } else if (r.rewritten[i]) {
      p = Produced { ...p, func: r.funcs[i], analysis: None };
    }
    if (p.ok && gone.names.len() > 0) {
      p = Produced { ...p, func: ssasem.Func { ...p.func, envs: envs_left(p.func.envs, gone) } };
    }
    out = out.append(p);
  }
  return out;
}

function reach_roots(all: Produced[], names: string[], entries: boolean[], mod: parser.Module): boolean[] {
  let named = util.name_index(outside_names(all, mod));
  let roots: boolean[] = [];
  let templates: string[] = [];
  let i = 0;
  while (i < all.len()) {
    let root = entries[i] || named.has(names[i]) || flatten.is_runtime_helper_name(names[i]);
    if (i < mod.funcs.len() && (root || rooted_method(mod.funcs[i], mod))) {
      root = true;
      templates = templates.append(all[i].key);
    }
    roots = roots.append(root);
    i += 1;
  }
  let rooted = util.name_index(templates);
  for i in mod.funcs.len()..all.len() {
    if (rooted.has(all[i].key)) {
      roots = roots.with(i, true);
    }
  }
  return roots;
}

function dropped_envs(all: Produced[], usable: boolean[], live: boolean[]): string[] {
  let out: string[] = [];
  for i in 0..all.len() {
    if (usable[i] && !live[i]) {
      for t in all[i].func.params {
        if (semtypes.is_env(t)) {
          out = out.append(ssasem.type_key(t));
        }
      }
    }
  }
  return out;
}

function envs_left(rows: ssasem.EnvRow[], gone: util.NameIndex): ssasem.EnvRow[] {
  let out: ssasem.EnvRow[] = [];
  for row in rows {
    if (!gone.has(ssasem.type_key(row.env_ty))) {
      out = out.append(row);
    }
  }
  return out;
}

function outside_names(all: Produced[], mod: parser.Module): string[] {
  let roots = treeshake.entry_roots(mod);
  let out = treeshake.top_level_names(mod, roots);
  for x in mod.exports {
    out = out.append(x.func_name);
  }
  for p in all {
    if (p.ok) {
      for fin in p.func.finalizers {
        out = out.append(fin.symbol);
      }
      return out;
    }
  }
  return out;
}

function entry_decl(fd: parser.FuncDecl, mod: parser.Module): boolean {
  return parser.decl_named_outside(mod, fd) || fd.import_iface != "";
}

function rooted_method(fd: parser.FuncDecl, mod: parser.Module): boolean {
  if (fd.receiver_type == "") {
    return false;
  }
  for im in mod.impls {
    if (im.trait_name == "Drop" && util.index_of_str(im.method_names, fd.name) >= 0) {
      return true;
    }
  }
  for sd in mod.structs {
    if (sd.derives.len() > 0) {
      let owner = sd.name;
      if (sd.enum_owner.len() > 0) {
        owner = sd.enum_owner;
      }
      if (fd.receiver_type == owner) {
        return true;
      }
    }
  }
  return false;
}

function unnamed(all: Produced[], names: string[], spliced: boolean[], mod: parser.Module): boolean[] {
  let candidates: string[] = [];
  let at: i32[] = [];
  let out: boolean[] = [];
  let late = util.name_index(late_named(all));
  for i in 0..all.len() {
    let candidate = i < spliced.len() && spliced[i] && outside_uncalled(all[i], names[i], i, mod, late) && spliceable_body(all[i], names[i], i, mod);
    if (candidate) {
      candidates = candidates.append(names[i]);
      at = at.append(i);
    }
    out = out.append(candidate);
  }
  if (candidates.len() == 0) {
    return out;
  }
  let ix = util.name_index(candidates);
  for p in all {
    for b in p.func.graph.blocks {
      for ins in b.insts {
        let k = ix.find(ins.str);
        if (k >= 0) {
          out = out.with(at[k], false);
        }
      }
    }
  }
  return out;
}

// The declaration a function was built from: its own, or the generic one
// an instance names by key.
function decl_of(p: Produced, i: i32, ndecls: i32, keys: util.NameIndex): i32 {
  if (i < ndecls) {
    return i;
  }
  return keys.find(p.key);
}

function decl_keys(decls: parser.FuncDecl[]): util.NameIndex {
  let out: string[] = [];
  for fd in decls {
    out = out.append(parser.decl_key(fd));
  }
  return util.name_index(out);
}

function inlinable_decl(fd: parser.FuncDecl): boolean {
  return !fd.no_inline && !fd.fip && !fd.fbip;
}

// The lowering replaces a call to a contract's name with the contract's op,
// such as string.to_ascii_upper with the runtime kernel. Splicing the
// function's own body would replace that call before the lowering sees it.
function lowered_names(): util.NameIndex {
  return util.name_index(contract_names(builtin_contracts()));
}

function outside_unnamed(p: Produced, name: string, i: i32, mod: parser.Module): boolean {
  if (p.template || p.bodyless || !p.ok || name == "main" || name.starts_with("__") || util.contains(name, ".")) {
    return false;
  }
  return i >= mod.funcs.len() || decl_unnamed(mod.funcs[i], mod);
}

// A body that only direct calls reach: a private free function, or a method
// that no export, interface, dyn arm, map key closure, derive or Drop names.
// Such a body may be spliced into its one caller and dropped.
function outside_uncalled(p: Produced, name: string, i: i32, mod: parser.Module, late: util.NameIndex): boolean {
  if (outside_unnamed(p, name, i, mod)) {
    return true;
  }
  if (p.template || p.bodyless || !p.ok || i >= mod.funcs.len() || late.has(name)) {
    return false;
  }
  let fd = mod.funcs[i];
  return fd.receiver_type.len() > 0 && fd.import_iface == "" && !parser.decl_named_outside(mod, fd) && !rooted_method(fd, mod);
}

// A method's body joins the once set only when it is one block. A branch in
// the spliced body puts the caller's store-back after a join, and the plan
// takes an element out of its slot only within the block that reads it
// (#13990).
function spliceable_body(p: Produced, name: string, i: i32, mod: parser.Module): boolean {
  if (i >= mod.funcs.len() || mod.funcs[i].receiver_type.len() == 0) {
    return true;
  }
  return p.func.graph.blocks.len() == 1;
}

function decl_unnamed(fd: parser.FuncDecl, mod: parser.Module): boolean {
  return fd.receiver_type.len() == 0 && fd.import_iface == "" && !parser.decl_named_outside(mod, fd);
}

// roots[i] is the entry that all[i] is a clone of, or i.
struct Specialised { all: Produced[], names: string[], table: ssasem.Contracts, roots: i32[] }

function specialize_calls(all: Produced[], names: string[], table: ssasem.Contracts, mod: parser.Module, passes: PassSwitches): Specialised {
  if (!passes.inline) {
    return Specialised { all: all, names: names, table: table, roots: seminline.own_roots(all.len()) };
  }
  let funcs: ssasem.Func[] = [];
  let modes: i32[][] = [];
  let usable: boolean[] = [];
  let sw = optbisect.switches();
  for i in 0..all.len() {
    let p = all[i];
    funcs = funcs.append(p.func);
    modes = modes.append(p.modes);
    usable = usable.append(p.ok && !p.template && !p.bodyless && optbisect.allowed_by(sw, "specialize", names[i]));
  }
  let sp = semspecial.specialize(funcs, names, modes, usable, util.name_index(kernel_calls(all, names, mod)));
  if (sp.funcs.len() == all.len()) {
    return Specialised { all: all, names: names, table: table, roots: seminline.own_roots(all.len()) };
  }
  let keys = decl_keys(mod.funcs);
  let lowered = lowered_names();
  let inlinable: boolean[] = [];
  let clone: boolean[] = [];
  for i in 0..sp.funcs.len() {
    let root = sp.from[i];
    let d = decl_of(all[root], root, mod.funcs.len(), keys);
    inlinable = inlinable.append(usable[root] && d >= 0 && inlinable_decl(mod.funcs[d]) && !lowered.has(sp.names[i]) && optbisect.allowed_by(sw, "inline", sp.names[i]));
    clone = clone.append(i >= all.len());
  }
  let made = seminline.inline_made_closures(sp.funcs, sp.names, sp.modes, inlinable, clone);
  let out: Produced[] = [];
  for i in 0..sp.funcs.len() {
    if (i < all.len()) {
      let p = all[i];
      if (sp.changed[i]) {
        p = Produced { ...p, func: sp.funcs[i], analysis: None };
      }
      out = out.append(p);
    } else {
      let root = sp.from[i];
      let key = all[root].key;
      if (root < mod.funcs.len()) {
        key = parser.decl_key(mod.funcs[root]);
      }
      out = out.append(Produced { ...all[root], func: made[i], modes: sp.modes[i], key: key, requests: [], analysis: None });
    }
  }
  return Specialised { all: out, names: sp.names, table: ssasem.contracts_of(util.append_all(table.list, sp.contracts)), roots: sp.from };
}

// The calls a later pass reads by name with their closure arguments: the
// ndarray kernels, and the std/array map that the rc lowering writes in place.
function kernel_calls(all: Produced[], names: string[], mod: parser.Module): string[] {
  let out = stdlib_names(all, names, mod.funcs, "std/ndarray");
  for name in stdlib_names(all, names, mod.funcs, "std/array") {
    if (name.starts_with("__arrm_map__")) {
      out = out.append(name);
    }
  }
  return out;
}

function fuse_pipelines(all: Produced[], names: string[], decls: parser.FuncDecl[], sink: i32, passes: PassSwitches): Produced[] {
  let enabled = passes.fusion;
  let report = sink != semarrayreport.off();
  if (!enabled && !report) {
    return all;
  }
  let funcs: ssasem.Func[] = [];
  let usable: boolean[] = [];
  for p in all {
    funcs = funcs.append(p.func);
    usable = usable.append(p.ok && !p.template && !p.bodyless);
  }
  let out = semfuse.fuse_pipelines(funcs, names, usable, stdlib_names(all, names, decls, "std/array"), stdlib_names(all, names, decls, "core/iter"), enabled, report);
  let sw = optbisect.switches();
  if (passes.inline) {
    let inlinable: boolean[] = [];
    let modes: i32[][] = [];
    let keys = decl_keys(decls);
    for at in 0..all.len() {
      let d = decl_of(all[at], at, decls.len(), keys);
      inlinable = inlinable.append(usable[at] && d >= 0 && inlinable_decl(decls[d]) && optbisect.allowed_by(sw, "inline", names[at]));
      modes = modes.append(all[at].modes);
    }
    // Capacity reservations introduce no callbacks.
    // Only pipeline fusion needs another closure-inline pass.
    out = semfuse.Fused { ...out, funcs: seminline.inline_closures(out.funcs, names, modes, inlinable, out.pipelines) };
  }
  if (report) {
    semarrayreport.write(sink, semarrayreport.render(out.sites));
    semarrayreport.write(sink, semreserve.render(out.reserves));
  }
  let result: Produced[] = [];
  for i in 0..all.len() {
    let p = all[i];
    if (out.rewritten[i] && optbisect.allowed_by(sw, "fuse", names[i])) {
      p = Produced { ...p, func: semoption.split(out.funcs[i]), analysis: None };
    }
    result = result.append(p);
  }
  return result;
}

function unroll_loops(all: Produced[], names: string[]): Produced[] {
  let sw = optbisect.switches();
  let out: Produced[] = [];
  for i in 0..all.len() {
    let p = all[i];
    if (p.ok && !p.template && !p.bodyless && optbisect.allowed_by(sw, "unroll", names[i])) {
      let u = semunroll.unroll(p.func);
      if (u.loops > 0) {
        p = Produced { ...p, func: u.f, analysis: None };
      }
    }
    out = out.append(p);
  }
  return out;
}

function prune_dead_constructions(all: Produced[], stack_phi_joins: boolean): Produced[] {
  let sw = optbisect.switches();
  let out: Produced[] = [];
  for old in all {
    let p = old;
    if (p.ok && !p.template && !p.bodyless) {
      let name = p.func.graph.name;
      if (optbisect.allowed_by(sw, "option-split", name)) {
        let split = semoption.split(p.func);
        if (split.graph.nvals != p.func.graph.nvals) {
          p = Produced { ...p, func: split, analysis: None };
        }
      }
      let fc = semunroll.fold_constants(p.func);
      if (fc.folded > 0 && optbisect.allowed_by(sw, "fold-constants", name)) {
        p = Produced { ...p, func: fc.f, analysis: None };
      }
      let th = semthread.thread(p.func, stack_phi_joins);
      if (th.changed > 0 && optbisect.allowed_by(sw, "thread", name)) {
        p = Produced { ...p, func: th.f, analysis: None };
      }
      let ho = semhoist.hoist(p.func);
      if (ho.moved > 0 && optbisect.allowed_by(sw, "hoist", name)) {
        p = Produced { ...p, func: ho.f, analysis: None };
      }
      let sk = semsink.sink(p.func);
      if (sk.reread > 0 && optbisect.allowed_by(sw, "sink", name)) {
        p = Produced { ...p, func: sk.f, analysis: None };
      }
      let cs = semcse.merge(p.func);
      if (cs.merged > 0 && optbisect.allowed_by(sw, "cse", name)) {
        p = Produced { ...p, func: cs.f, analysis: None };
      }
      let pr = semdead.prune(p.func);
      if (pr.removed > 0 && optbisect.allowed_by(sw, "prune", name)) {
        p = Produced { ...p, func: pr.f, analysis: None };
      }
    }
    out = out.append(p);
  }
  return out;
}

function ndarray_kernels_needed(names: string[], enabled: boolean, products: boolean, report: boolean): boolean {
  if (!enabled && !products && !report) {
    return false;
  }
  return semndarray.has_kernel(names) || report && semndarray.any_operation(names);
}

function scale_ndarray_maps(all: Produced[], names: string[], mod: parser.Module, sink: i32, passes: PassSwitches): Produced[] {
  let report = sink != semarrayreport.off();
  let enabled = passes.scale_kernel;
  let products = passes.product_kernel;
  if (!ndarray_kernels_needed(names, enabled, products, report)) {
    return all;
  }
  let funcs: ssasem.Func[] = [];
  let usable: boolean[] = [];
  let sw = optbisect.switches();
  for at in 0..all.len() {
    let p = all[at];
    funcs = funcs.append(p.func);
    usable = usable.append(p.ok && !p.template && !p.bodyless && optbisect.allowed_by(sw, "ndarray", names[at]));
  }
  let open = ndarray_open(all, names, mod, funcs);
  let out = semndarray.scale_maps(funcs, names, usable, open, stdlib_names(all, names, mod.funcs, "std/ndarray"), enabled, products, report);
  if (report) {
    semarrayreport.write(sink, semarrayreport.render_kind("ndarray kernels", semarrayreport.kernel_reasons(), out.sites));
  }
  let result: Produced[] = [];
  for i in 0..all.len() {
    let p = all[i];
    if (out.rewritten[i]) {
      p = Produced { ...p, func: out.funcs[i], analysis: None };
    }
    result = result.append(p);
  }
  return result;
}

function stdlib_names(all: Produced[], names: string[], decls: parser.FuncDecl[], library: string): string[] {
  let keys: string[] = [];
  for fd in decls {
    keys = keys.append(parser.decl_key(fd));
  }
  let index = util.name_index(keys);
  let trusted: string[] = [];
  for i in 0..all.len() {
    let di = i;
    if (i >= decls.len()) {
      di = index.find(all[i].key);
    }
    if (di >= 0 && di < decls.len() && decls[di].stdlib == library) {
      trusted = trusted.append(names[i]);
    }
  }
  return trusted;
}

function ndarray_open(all: Produced[], names: string[], mod: parser.Module, funcs: ssasem.Func[]): boolean[] {
  let roots: string[] = ["main"];
  for fd in mod.funcs {
    if (fd.receiver_type != "") {
      roots = roots.append(parser.decl_key(fd));
    }
  }
  for ex in mod.exports {
    roots = roots.append(ex.func_name);
  }
  for f in funcs {
    roots = ownership.address_taken(f, roots);
  }
  let root_index = util.name_index(roots);
  let open: boolean[] = [];
  for j in 0..all.len() {
    open = open.append(root_index.find(names[j]) >= 0 || root_index.find(all[j].key) >= 0 || closure_body_produced(all[j]));
  }
  return open;
}

pub function dyn_arms(funcs: parser.FuncDecl[], impls: parser.ImplInfo[], method: string, traits: string[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    let n = fd.receiver_type.len();
    if (generic_decl(fd) || n == 0 || n >= 2 && fd.receiver_type.ends_with("[]")) {
      continue;
    }
    if (!arm_receiver_implements(impls, parser.receiver_base(fd.receiver_type), traits)) {
      continue;
    }
    if (parser.dyn_arm_matches(fd, traits, method)) {
      out = out.append(parser.decl_key(fd));
    }
  }
  return out;
}

function arm_receiver_implements(impls: parser.ImplInfo[], n: string, traits: string[]): boolean {
  if (implements_traits(impls, n, traits)) {
    return true;
  }
  let at = 1;
  while (at + 1 < n.len() && !(n[at] == b'_' && n[at + 1] == b'_')) {
    at += 1;
  }
  return at + 1 < n.len() && implements_traits(impls, slice_unchecked(n, 0, at).to_owned(), traits);
}

// The names that the lowering calls after the splice plan is decided: the
// arms of each dyn call, and the eq and hash methods of each keyed map key,
// which the key closures of ssarc call by name.
function late_named(all: Produced[]): string[] {
  let out = dispatched_arms(all);
  for p in all {
    if (!p.ok) {
      continue;
    }
    for t in p.func.values {
      if (!ssasem.is_map(t) || !ssasem.keyed_map_key(ssasem.map_key(t))) {
        continue;
      }
      for which in ["eq", "hash"] {
        let callee = ssasem.keyed_map_key_fn(ssasem.map_key(t), which);
        if (util.index_of_str(out, callee) < 0) {
          out = out.append(callee);
        }
      }
    }
  }
  return out;
}

function dispatched_arms(all: Produced[]): string[] {
  let out: string[] = [];
  for p in all {
    if (!p.ok) {
      continue;
    }
    for b in p.func.graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag != ssasem.call() || !ssasem.is_dyn_call(ins.str)) {
          continue;
        }
        for arm in ssasem.dyn_call_arms(ins.str) {
          if (util.index_of_str(out, arm) < 0) {
            out = out.append(arm);
          }
        }
      }
    }
  }
  return out;
}

pub function with_inferred_modes(b: Built): Built {
  let all = util.append_all(b.decls, b.instances);
  let pinned = b.dyn_arms;
  for finalizer in b.finalizers {
    pinned = pinned.append(finalizer.symbol);
  }
  let inferred = infer_ownership(all, b.names, b.contracts, pinned);
  let decls: Produced[] = [];
  let instances: Produced[] = [];
  for i in 0..inferred.all.len() {
    if (i < b.decls.len()) {
      decls = decls.append(inferred.all[i]);
    } else {
      instances = instances.append(inferred.all[i]);
    }
  }
  return Built { ...b, decls: decls, instances: instances, contracts: inferred.table };
}

pub struct Resunk { built: Built, moved: boolean[] }

// with_lent_rereads re-reads projections below the calls that, with the
// inferred modes, only borrow them (semsink.sink_past_lent). moved marks
// each row whose graph changed, decls then instances.
pub function with_lent_rereads(b: Built): Resunk {
  let moved: boolean[] = [];
  let decls = b.decls;
  for i in 0..decls.len() {
    let sk = lent_rereads(decls[i]);
    moved = moved.append(sk.reread > 0);
    if (sk.reread > 0) {
      decls = decls.with(i, Produced { ...decls[i], func: sk.f, analysis: None });
    }
  }
  let instances = b.instances;
  for i in 0..instances.len() {
    let sk = lent_rereads(instances[i]);
    moved = moved.append(sk.reread > 0);
    if (sk.reread > 0) {
      instances = instances.with(i, Produced { ...instances[i], func: sk.f, analysis: None });
    }
  }
  return Resunk { built: with_analyses(Built { ...b, decls: decls, instances: instances }), moved: moved };
}

function lent_rereads(p: Produced): semsink.Sunk {
  if (!p.ok || p.template || p.bodyless) {
    return semsink.Sunk { f: p.func, reread: 0 };
  }
  match (p.analysis) {
    Some(a) => {
      return semsink.sink_past_lent(p.func, a.facts);
    },
    None => {
      return semsink.sink_past_lent(p.func, ssadeps.unchecked());
    }
  }
}

pub function changed_rows(a: Built, b: Built): boolean[] {
  let out: boolean[] = [];
  let i = 0;
  while (i < a.decls.len() && i < b.decls.len()) {
    out = out.append(produced_moved(a.decls[i], b.decls[i]));
    i += 1;
  }
  i = 0;
  while (i < a.instances.len() && i < b.instances.len()) {
    out = out.append(produced_moved(a.instances[i], b.instances[i]));
    i += 1;
  }
  return out;
}

pub function any_row_changed(changed: boolean[]): boolean {
  for c in changed {
    if (c) {
      return true;
    }
  }
  return false;
}

function produced_moved(a: Produced, b: Produced): boolean {
  if (!util.same_i32s(a.modes, b.modes)) {
    return true;
  }
  return !same_call_modes(a.func.calls, b.func.calls);
}

function same_call_modes(a: ssasem.Contract[], b: ssasem.Contract[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  for i in 0..a.len() {
    if (a[i].name != b[i].name) {
      return false;
    }
    if (!util.same_i32s(a[i].modes, b[i].modes)) {
      return false;
    }
  }
  return true;
}

function renumber_source(blocks: ssa.SBlock[], map: i32[], ids: i32[], n: i32): sourcepos.SourceInfo {
  let top = 0;
  for b in blocks {
    if (b.id >= top) {
      top = b.id + 1;
    }
  }
  let out = sourcepos.SourceInfo { ...sourcepos.no_source(), values: sourcepos.blanks(n), terms: sourcepos.blanks(top) };
  for b in blocks {
    out = renumber_source_block(out, b, map, ids);
  }
  return out;
}

function renumber_source_block(own out: sourcepos.SourceInfo, b: ssa.SBlock, map: i32[], ids: i32[]): sourcepos.SourceInfo {
  let pos = sourcepos.SourcePos { line: 0, col: "0" };
  for ins in b.insts {
    if (ins.kind_tag == ssa.LINE) {
      pos = sourcepos.SourcePos { line: ins.imm as i32, col: ins.str };
      if (out.entry.line == 0) {
        out = sourcepos.SourceInfo { ...out, entry: pos };
      }
    } else if (pos.line > 0) {
      let v = ids[resolve(map, ins.result)];
      if (v >= 0) {
        out = sourcepos.SourceInfo { ...out, values: out.values.with(v, pos) };
      }
    }
  }
  if (b.term.kind_tag == ssa.TERM_RET) {
    out = sourcepos.SourceInfo { ...out, terms: out.terms.with(b.id, pos) };
  }
  return out;
}

function renumber_block(b: ssa.SBlock, map: i32[], ids: i32[]): ssa.SBlock {
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag == ssa.LINE) {
      continue;
    }
    if (map[ins.result] != ins.result) {
      continue;
    }
    let args: i32[] = [];
    for a in mapped_args(ins.args, map) {
      args = args.append(ids[a]);
    }
    let immediate = ins.imm;
    let donor = ssasem.update_base(ins);
    if (donor >= 0) {
      immediate = ids[resolve(map, donor)] + 1;
    }
    insts = insts.append(ssa.SInst { ...ins, result: ids[ins.result], args: args, imm: immediate });
  }
  let term = renumber_term(b.term, map, ids);
  return ssa.SBlock { ...b, insts: insts, term: term };
}

function renumber_term(input: ssa.STerm, map: i32[], ids: i32[]): ssa.STerm {
  let term = mapped_term(input, map);
  if (term.kind_tag == ssa.TERM_RET && term.value >= 0) {
    term = ssa.STerm { ...term, value: ids[term.value] };
  }
  if (term.kind_tag == ssa.TERM_BRIF) {
    term = ssa.STerm { ...term, cond: ids[term.cond] };
  }
  return term;
}
