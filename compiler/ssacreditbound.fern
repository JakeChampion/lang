// Resolve retained native rows without relowering or substituting old bodies.
// A successful binding is not an ownership proof or a whole-module certificate.
import "./asmcore";
import "./ircore";
import "./ssaprepare";
import "./ssacreditselected" as selection;
import "./ssacredithelper" as helper;
import "./typeinfo";
import "./semtypes";

pub struct Binding { rows: ssaprepare.Emitted[], error: string }

pub function resolve(rows: ssaprepare.Emitted[], name: string, architecture: string): Binding {
  let result = binding(rows, name, architecture);
  if (result.error != "") {
    return result;
  }
  if (result.rows[0].release_entry.counted) {
    return Binding { rows: [], error: "unproved native release entry effects" };
  }
  return result;
}

function binding(rows: ssaprepare.Emitted[], name: string, architecture: string): Binding {
  let found: ssaprepare.Emitted[] = [];
  let label = asmcore.sanitize_label(name);
  for row in rows {
    if (asmcore.sanitize_label(row.label_name) == label) {
      found = found.append(row);
    }
  }
  if (name == "" || found.len() != 1) {
    return Binding { rows: [], error: "missing or ambiguous emitted body" };
  }
  let error = boundary_error(found[0]);
  if (error != "") {
    return Binding { rows: [], error: error };
  }
  return target_binding(found, name, architecture);
}

function target_binding(found: ssaprepare.Emitted[], name: string, architecture: string): Binding {
  let row = found[0];
  if (row.label_name != name || row.body.formed.f.name != name) {
    return Binding { rows: [], error: "mismatched emitted label" };
  }
  if (architecture != "arm64" && architecture != "x86-64" || row.context.architecture != architecture) {
    return Binding { rows: [], error: "mismatched native architecture" };
  }
  // Even a disabled entry must agree with the actual selection inputs.
  // This consistency check is necessary, but does not prove entry effects.
  let c = row.context;
  let expected = ircore.release_entry(row.body.lowered, c.architecture, c.rc_free_debug, c.reg_entries);
  if (row.release_entry.counted != expected.counted || row.release_entry.unique_drop != expected.unique_drop) {
    return Binding { rows: [], error: "mismatched native release entry selection" };
  }
  return Binding { rows: found, error: "" };
}

// Scoped composition under the ordinary, untagged record-pointer ABI. This
// proves the supplied release/Drop pair, not a runtime implementation or an
// arbitrary function with a counted suffix. No caller-supplied proof flag.
pub function release(rows: ssaprepare.Emitted[], name: string, drop: string, architecture: string, parent: typeinfo.Type): Binding {
  let r = binding(rows, name, architecture);
  let d = resolve(rows, drop, architecture);
  return release_pair(r, d, parent);
}

// Derive the ordinary record ABI from the SAME selected helper descriptors.
// Descriptors identify construction inputs, not effects: the complete formed
// bodies, each producer's schema and native entry must still pass below.
// Like other selected APIs, this requires integrity of the supplied carrier.
pub function release_selected(rows: ssaprepare.Emitted[], name: string, drop: string, architecture: string): Binding {
  let r = binding(rows, name, architecture);
  let d = resolve(rows, drop, architecture);
  if (r.error != "") {
    return r;
  }
  if (d.error != "") {
    return d;
  }
  if let Some(release_type) = r.rows[0].body.selected.origin.helper {
    if let Some(drop_type) = d.rows[0].body.selected.origin.helper {
      if (!release_type.children_only && drop_type.children_only && semtypes.equal(release_type.ty, drop_type.ty)) {
        return release_pair(r, d, release_type.ty);
      }
    }
  }
  return Binding { rows: [], error: "missing or mismatched selected helper type" };
}

function release_pair(r: Binding, d: Binding, parent: typeinfo.Type): Binding {
  if (r.error != "") {
    return r;
  }
  if (d.error != "") {
    return d;
  }
  let row = r.rows[0];
  let dependency = d.rows[0];
  let m = selection.metadata(row);
  if (!selection.compatible(m, selection.metadata(dependency), parent, 1)) {
    return Binding { rows: [], error: "incompatible retained release layout" };
  }
  let layout = helper.FlatChildren { offsets: selection.child_offsets(m, parent) };
  let proof = helper.release_body_many(row.body.formed.f, dependency.body.formed.f, layout);
  if (!proof.ok) {
    return Binding { rows: [], error: proof.function_name + ": " + proof.message };
  }
  return release_entry(row, dependency);
}

function release_entry(row: ssaprepare.Emitted, drop: ssaprepare.Emitted): Binding {
  // Both fields already agree with the actual LowerResult and PRE context.
  // For untagged records, low pointers and negative RC skip both operations;
  // RC>1 skips Drop and decrements once. These are exactly the proved body's
  // shared paths. RC==0 enters that SAME body and retains runtime underflow.
  // ARM RC==1 also enters it. The x86 shortcut must invoke the SAME proved
  // Drop, then __fern_rc_dec (mapped to __fn___fern_arr_dec.r), on the saved
  // parent pointer and return zero, matching the body's unique path.
  let entry = row.release_entry;
  if (entry.unique_drop != "" && entry.unique_drop != drop.label_name) {
    return Binding { rows: [], error: "mismatched proved release entry Drop" };
  }
  return Binding { rows: [row, drop], error: "" };
}

function boundary_error(row: ssaprepare.Emitted): string {
  let selected = row.body.selected;
  if (selected.origin.producer < 0 || selected.origin.producer >= selected.producers.len() || selected.origin.symbol == "") {
    return "missing selected producer metadata";
  }
  if (!row.body.lowered.ok || row.body.lowered.n_params != row.body.formed.f.nparams || row.body.formed.f.takes_env) {
    return "mismatched emitted body boundary";
  }
  return "";
}
