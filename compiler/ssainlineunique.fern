// If x30 holds data, the caller must save its return address outside this fragment.
import "./util";
import "./ssaproofnames" as names;
import "./ssacredithelper" as helper;
import "./ssainlineuniqueisa" as isa;
import "./ssainlineuniqueflow" as flow;
import "std/string";

struct Program { ops: isa.Op[], targets: i32[], ok: boolean }

function label_char(c: u8): boolean {
  return c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9' || c == b'_' || c == b'.' || c == b'$';
}

function label(line: string): boolean {
  if (!line.starts_with(".L") || !line.ends_with(":")) {
    return false;
  }
  let i = 2;
  while (i < line.len() - 1) {
    let c = line[i];
    if (!label_char(c)) {
      return false;
    }
    i = i + 1;
  }
  return line.len() > 3;
}

function location(name: string, arm: boolean): boolean {
  let r = isa.reg(name, arm, 64);
  // Frame bases must stay fixed. A caller with a frame can use x30 for data.
  if (r >= 0) {
    return if (arm) { r != 29 } else { r != 4 && r != 5 };
  }
  return isa.frame_slot(name, arm);
}

function program(text: string, arm: boolean): Program {
  let ops: isa.Op[] = [];
  let labels: string[] = [];
  for raw in text.split("\n") {
    let line = util.trim(raw);
    if (line != "") {
      let name = "";
      let decoded = isa.Op { kind: 30, a: "", b: "", target: "" };
      if (label(line)) {
        name = slice_unchecked(line, 0, line.len() - 1) + "";
      } else {
        decoded = isa.decode(line, arm);
        if (decoded.kind == 0) {
          return Program { ops: [], targets: [], ok: false };
        }
      }
      ops = ops.append(decoded);
      labels = labels.append(name);
    }
  }
  return resolve(ops, labels);
}

function resolve(ops: isa.Op[], labels: string[]): Program {
  let ix = names.index(labels);
  if (ix.duplicate >= 0) {
    return Program { ops: [], targets: [], ok: false };
  }
  let targets: i32[] = [];
  for op in ops {
    let dest = -1;
    if (op.kind >= 20 && op.kind < 30) {
      dest = names.position(ix, op.target);
      if (!label(op.target + ":") || dest < 0) {
        return Program { ops: [], targets: [], ok: false };
      }
    }
    targets = targets.append(dest);
  }
  return Program { ops: ops, targets: targets, ok: ops.len() > 0 };
}

function path(p: Program, b: flow.Boundary, c: flow.Case): boolean {
  let seen: boolean[] = [];
  for op in p.ops {
    seen = seen.append(false);
  }
  let pc = 0;
  let s = flow.initial(b);
  while (pc < p.ops.len()) {
    if (pc < 0 || seen[pc]) {
      return false;
    }
    seen = seen.with(pc, true);
    let op = p.ops[pc];
    if (op.kind >= 20 && op.kind < 30) {
      let take = flow.branch(s, op, b, c);
      if (take < 0) {
        return false;
      }
      pc = if (take == 1) { p.targets[pc] } else { pc + 1 };
    } else {
      s = flow.step(s, op, b, c);
      if (!s.ok) {
        return false;
      }
      pc = pc + 1;
    }
  }
  return flow.result(s, b, c);
}

function paths(p: Program, b: flow.Boundary): boolean {
  for tagged in [false, true] {
    for view in [false, true] {
      for low in [false, true] {
        for one in [false, true] {
          if (!path(p, b, flow.Case { tagged: tagged, view: view, low: low, one: one })) {
            return false;
          }
        }
      }
    }
  }
  return true;
}

pub function check_fragment(text: string, architecture: string, input: string, result: string, flags: boolean): helper.Proof {
  let arm = architecture == "arm64";
  let b = flow.Boundary { arm: arm, input: input, result: result, flags: flags };
  let supported = architecture == "arm64" || architecture == "x86-64";
  let valid = supported && location(input, arm) && (if (flags) { result == "" } else { location(result, arm) });
  if (!valid) {
    return helper.Proof { ok: false, function_name: "inline __fern_rc_is_unique", message: "unsupported uniqueness machine boundary" };
  }
  let p = program(text, arm);
  let ok = p.ok && paths(p, b);
  return helper.Proof { ok: ok, function_name: "inline __fern_rc_is_unique", message: if (ok) { "" } else { "unproved uniqueness instruction effects" } };
}
