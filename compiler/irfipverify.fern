import "./ir";
import "./irverify";
import "./util";

pub struct FipClaim {
  fn_name: string,
  is_fip: boolean,
  is_fbip: boolean,
  allowance: i32,
}

pub struct FipResult {
  problems: irverify.Problem[],
  fresh: i32,
  paired: i32,
  elided: i32,
}

pub function fresh_alloc_what(o: ir.Op): string {
  let t: i32 = o.kind_tag;
  if (t == 138) {
    if (o.str.len() > 0) {
      return "struct/enum construction \"" + o.str + "\"";
    }
    return "struct/enum construction";
  }
  if (t == 142) {
    return "tuple literal";
  }
  if (t == 87 || ir.is_array_literal_copy(o)) {
    return "array literal";
  }
  if (t == 120) {
    return "Option construction";
  }
  if (t == 146) {
    return "dyn box";
  }
  if (t == 98) {
    return "string concatenation";
  }
  if (t == 76) {
    return "heap allocation";
  }
  if (t == 77) {
    return "byte-buffer allocation";
  }
  if (t == ir.K_CALL_DIRECT && util.str_has_prefix(o.str, "__arrm_map__")) {
    return "`map` materialized by the combinator: R7 writes a map in place only over an `own` parameter that dies at the call, with an i64 element it does not change and an element function that captures nothing and reaches no effect";
  }
  return "";
}

pub function is_paired_alloc(o: ir.Op): boolean {
  return o.kind_tag == ir.K_CALL_DIRECT && o.str == "__fern_alloc_reuse";
}

pub function elided_carried_at(ops: ir.Op[], at: i32): i32 {
  let k_if: i32 = ir.K_IF;
  let k_else: i32 = ir.K_ELSE;
  let k_end: i32 = ir.K_END;
  let k_block: i32 = ir.K_BLOCK;
  let k_loop: i32 = ir.K_LOOP;
  let k_store: i32 = ir.K_STRUCT_SET;
  let k_shape_copy: i32 = ir.K_RAW_STORE_PTR;
  let i: i32 = at + 1;
  while (i < ops.len() && ops[i].kind_tag != k_if) {
    if (ops[i].kind_tag == k_end || ops[i].kind_tag == k_else) {
      return 0;
    }
    i = i + 1;
  }
  let depth: i32 = 0;
  i = i + 1;
  while (i < ops.len()) {
    let t: i32 = ops[i].kind_tag;
    if (t == k_if || t == k_block || t == k_loop) {
      depth = depth + 1;
    } else if (t == k_end) {
      if (depth == 0) {
        return 0;
      }
      depth = depth - 1;
    } else if (t == k_else && depth == 0) {
      break;
    }
    i = i + 1;
  }
  let stores: i32 = 0;
  let shape_copied: boolean = false;
  i = i + 1;
  while (i < ops.len()) {
    let t2: i32 = ops[i].kind_tag;
    if (t2 == k_if || t2 == k_block || t2 == k_loop) {
      depth = depth + 1;
    } else if (t2 == k_end) {
      if (depth == 0) {
        break;
      }
      depth = depth - 1;
    } else if (t2 == k_shape_copy) {
      shape_copied = true;
    } else if (t2 == k_store && depth == 0) {
      stores = stores + 1;
    }
    i = i + 1;
  }
  if (!shape_copied) {
    return 0;
  }
  return stores;
}

pub function verify_fip_fn(claim: FipClaim, ops: ir.Op[]): FipResult {
  let out: irverify.Problem[] = [];
  let fresh: i32 = 0;
  let paired: i32 = 0;
  let elided: i32 = 0;
  let sites: string = "";
  let i: i32 = 0;
  while (i < ops.len()) {
    if (is_paired_alloc(ops[i])) {
      paired = paired + 1;
      elided = elided + elided_carried_at(ops, i);
    } else {
      let what: string = fresh_alloc_what(ops[i]);
      if (what.len() > 0) {
        if (fresh > 0) {
          sites = sites + "; ";
        }
        sites = sites + what + " at op " + util.i32_to_string(i);
        fresh = fresh + 1;
      }
    }
    i = i + 1;
  }
  if (!claim.is_fip && !claim.is_fbip) {
    return FipResult { problems: out, fresh: fresh, paired: paired, elided: elided };
  }
  if (fresh <= claim.allowance) {
    return FipResult { problems: out, fresh: fresh, paired: paired, elided: elided };
  }
  let kw: string = "fip";
  if (claim.is_fbip) {
    kw = "fbip";
  }
  let remedy: string = "pair each construction with a dead uniquely-owned donor of the same shape, or grade the claim (`" + kw + "(n)`)";
  out = out.append(irverify.Problem {
    fn_name: claim.fn_name, op: 0 - 1, kind: "E068",
    msg: "`" + kw + "` function \"" + claim.fn_name + "\" allocates: "
      + util.i32_to_string(fresh) + " un-reused allocation site(s) exceed the allowance of "
      + util.i32_to_string(claim.allowance) + ": " + sites + " — " + remedy,
  });
  return FipResult { problems: out, fresh: fresh, paired: paired, elided: elided };
}
