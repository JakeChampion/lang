// Select decrement entries and dependencies from ONE normal x86 output. This is
// namespace and section validation only, not an instruction/effect proof.
import "./ssaproofnames" as names;
import "./util";
import "std/string";

pub struct Body { lines: string[], register_entry: i32, error: string }

// Section identities: text=1, data=2, BSS=3, read-only data=4.
struct Scan { lines: string[], sections: i32[], error: string }

function failure(message: string): Body {
  return Body { lines: [], register_entry: -1, error: message };
}

function symbol_byte(c: u8): boolean {
  return c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9' || c == b'_' || c == b'.' || c == b'$';
}

function symbol(s: string): boolean {
  if (s.len() == 0 || s[0] >= b'0' && s[0] <= b'9') {
    return false;
  }
  for c in s {
    if (!symbol_byte(c)) {
      return false;
    }
  }
  return true;
}

function definition(line: string): string {
  let at = 0;
  while (at < line.len() && symbol_byte(line[at])) {
    at = at + 1;
  }
  let name = slice_unchecked(line, 0, at) + "";
  return if (at < line.len() && line[at] == b':' && symbol(name)) { name } else { "" };
}

function word(line: string): string {
  let at = 0;
  while (at < line.len() && line[at] != b' ' && line[at] != b'\t') {
    at = at + 1;
  }
  return slice_unchecked(line, 0, at) + "";
}

function decimal(s: string): boolean {
  if (s == "") {
    return false;
  }
  for c in s {
    if (c < b'0' || c > b'9') {
      return false;
    }
  }
  return true;
}

function one_of(s: string, choices: string[]): boolean {
  for choice in choices {
    if (s == choice) {
      return true;
    }
  }
  return false;
}

function data_values(arg: string): boolean {
  for value in arg.split(",") {
    if (!decimal(util.trim(value))) {
      return false;
    }
  }
  return arg != "";
}

function metadata(line: string, op: string, arg: string, section: i32): boolean {
  if (op == ".globl" && symbol(arg) || op == ".align" && decimal(arg)) {
    return true;
  }
  if (section != 1) {
    return false;
  }
  if (one_of(line, [".cfi_startproc", ".cfi_endproc", ".cfi_remember_state", ".cfi_restore_state"])) {
    return true;
  }
  // These directives change unwind metadata only. Unwinding is outside
  // this boundary; no CFI directive is allowed inside the selected body.
  return arg != "" && one_of(op, [".cfi_def_cfa_offset", ".cfi_def_cfa_register", ".cfi_def_cfa", ".cfi_offset"]);
}

function quoted_data(arg: string): boolean {
  if (arg.len() < 2 || arg[0] != b'"') {
    return false;
  }
  let at = 1;
  while (at < arg.len()) {
    let c = arg[at];
    if (c == b'"') {
      return at == arg.len() - 1;
    }
    if (c < 32) {
      return false;
    }
    if (c == b'\\') {
      at = at + 1;
      if (at >= arg.len() || arg[at] < 32) {
        return false;
      }
    }
    at = at + 1;
  }
  return false;
}

function literal_data(line: string, section: i32): boolean {
  let op = word(line);
  if (section < 2 || !one_of(op, [".ascii", ".asciz"])) {
    return false;
  }
  return quoted_data(util.trim(slice_unchecked(line, op.len(), line.len()) + ""));
}

// Closed policy, including directives outside the selected body. Section
// stacks, aliases, macros, includes, conditional assembly and dialect changes
// must not alter the interpretation of a later definition or instruction.
function directive(line: string, section: i32): i32 {
  if (one_of(line, [".text", ".section .text"])) {
    return 1;
  }
  if (one_of(line, [".data", ".section .data"])) {
    return 2;
  }
  if (one_of(line, [".bss", ".section .bss"])) {
    return 3;
  }
  if (line == ".section .rodata") {
    return 4;
  }
  let op = word(line);
  let arg = util.trim(slice_unchecked(line, op.len(), line.len()) + "");
  if (metadata(line, op, arg, section)) {
    return section;
  }
  if (literal_data(line, section)) {
    return section;
  }
  if (section >= 2 && data_values(arg) && one_of(op, [".quad", ".long", ".byte", ".skip", ".zero"])) {
    return section;
  }
  return -1;
}

function ambiguous_syntax(tail: string): boolean {
  // Quoted/multiline symbols and escaped newlines require their own lexer.
  // Refusing them also prevents data strings from swallowing later labels.
  for forbidden in [":", ";", "=", "/*", "*/", "\\", "\"", "'"] {
    if (util.contains(tail, forbidden)) {
      return true;
    }
  }
  return false;
}

function raw_line(raw: string): boolean {
  let at = 0;
  while (at < raw.len()) {
    let c = raw[at];
    if (c < 32 && c != b'\t') {
      // Accept CRLF only. An interior or leading CR must not be trimmed
      // into a different assembler statement or definition.
      if (c != b'\r' || at != raw.len() - 1) {
        return false;
      }
    }
    if (c == 127) {
      return false;
    }
    at = at + 1;
  }
  return true;
}

// Retained native functions may refer to the ordinary static shape pool.
// These tokens identify declarations only: they grant no writable extent,
// relocation, linked-address or shape-content permission.
function native_data(line: string, section: i32): boolean {
  if (section < 2 || word(line) != ".quad") {
    return false;
  }
  let arg = util.trim(slice_unchecked(line, 5, line.len()) + "");
  if (symbol(arg)) {
    return true;
  }
  if (arg.len() > 1 && arg[0] == b'-') {
    return decimal(slice_unchecked(arg, 1, arg.len()) + "");
  }
  return false;
}

function scan(text: string): Scan {
  return scan_mode(text, false);
}

function scan_directive(tail: string, section: i32, native: boolean): i32 {
  return if (native && native_data(tail, section)) { section } else { directive(tail, section) };
}

function scan_mode(text: string, native: boolean): Scan {
  let lines: string[] = [];
  let sections: i32[] = [];
  let section = 0;
  for raw in text.split("\n") {
    if (!raw_line(raw)) {
      return Scan { lines: [], sections: [], error: "unsupported decrement control byte" };
    }
    let line = util.trim(raw);
    if (line != "" && !util.str_has_prefix(line, "#")) {
      let name = definition(line);
      let tail = if (name == "") { line } else { util.trim(slice_unchecked(line, name.len() + 1, line.len()) + "") };
      // No secondary definitions or statement separators hidden on a line.
      if (!literal_data(tail, section) && ambiguous_syntax(tail)) {
        return Scan { lines: [], sections: [], error: "unsupported decrement assembly syntax" };
      }
      let here = section;
      if (util.str_has_prefix(tail, ".")) {
        section = scan_directive(tail, section, native);
        if (section < 0) {
          return Scan { lines: [], sections: [], error: "unsupported decrement assembly directive: " + tail };
        }
      }
      lines = lines.append(line);
      sections = sections.append(here);
    }
  }
  return Scan { lines: lines, sections: sections, error: "" };
}

function ends_body(line: string, name: string, entry: string): boolean {
  if (name != "") {
    return (entry == "" || name != entry + ".r") && !util.str_has_prefix(name, ".L");
  }
  return one_of(line, [".text", ".data", ".bss"]) || util.str_has_prefix(line, ".section");
}

function body_error(s: Scan, ix: names.Names, at: i32, name: string): string {
  let line = s.lines[at];
  if (s.sections[at] != 1 || name == "" && util.str_has_prefix(line, ".")) {
    return "unsupported decrement body directive";
  }
  if (name != "" && (line != name + ":" || names.unique_position(ix, name) != at)) {
    return "ambiguous decrement body definition";
  }
  return "";
}

function body(s: Scan, ix: names.Names, start: i32, register: i32, entry: string): Body {
  let code: string[] = [];
  let at = start + 1;
  let reg = -1;
  while (at < s.lines.len()) {
    let line = s.lines[at];
    let name = definition(line);
    // A section transition ends the contiguous executable body. It cannot
    // move .r into data or splice later text into this body.
    if (ends_body(line, name, entry)) {
      break;
    }
    let error = body_error(s, ix, at, name);
    if (error != "") {
      return failure(error);
    }
    if (at == register) {
      reg = code.len();
    }
    code = code.append(line);
    at = at + 1;
  }
  if (register >= 0 && reg < 0) {
    return failure("decrement register entry outside body");
  }
  return Body { lines: code, register_entry: reg, error: "" };
}

function exact_entry(s: Scan, at: i32, name: string): boolean {
  return s.sections[at] == 1 && s.lines[at] == name + ":";
}

function definition_index(lines: string[]): names.Names {
  let definitions: string[] = [];
  for line in lines {
    definitions = definitions.append(definition(line));
  }
  return names.index(definitions);
}

function positive_space(arg: string): boolean {
  // A bounded decimal count avoids assembler integer overflow/truncation.
  let count = util.trim(arg.split(",")[0]);
  if (!decimal(count) || count.len() > 9) {
    return false;
  }
  for c in count {
    if (c != b'0') {
      return true;
    }
  }
  return false;
}

function allocation(tail: string): boolean {
  let op = word(tail);
  let arg = util.trim(slice_unchecked(tail, op.len(), tail.len()) + "");
  if (!data_values(arg)) {
    return false;
  }
  return one_of(op, [".quad", ".long", ".byte"]) || one_of(op, [".skip", ".zero"]) && positive_space(arg);
}

function writable_declarations(s: Scan): boolean {
  let at = 0;
  for line in s.lines {
    if (s.sections[at] == 2 || s.sections[at] == 3) {
      let name = definition(line);
      if (name != "") {
        // Every writable label must consume storage immediately. Refuse
        // bare/zero-size labels even in another fragment of the section.
        let tail = util.trim(slice_unchecked(line, name.len() + 1, line.len()) + "");
        if (!allocation(tail)) {
          return false;
        }
      } else if (!util.str_has_prefix(line, ".")) {
        return false;
      }
    }
    at = at + 1;
  }
  return true;
}

// A declaration proof only: not an instruction, relocation, linked-address,
// caller-disjointness or ownership certificate. Always rescan supplied text.
// Scope excludes writable bare labels, including the compiler's static
// aggregate blocks and box-field labels, even with allocation on the next
// line. Supporting those modules requires a separate declaration/alias proof;
// this predicate is not yet suitable for general production admission.
// The shared scanner also refuses signed data literals such as the immortal
// aggregate RC header `.quad -1`; a bare-label extension alone is insufficient.
pub function counter_storage(text: string): boolean {
  let s = scan(text);
  if (s.error != "" || !writable_declarations(s)) {
    return false;
  }
  let at = names.unique_position(definition_index(s.lines), "__fern_rc_underflow");
  if (at < 1 || s.sections[at] != 2 && s.sections[at] != 3) {
    return false;
  }
  return s.lines[at] == "__fern_rc_underflow: .quad 0" && s.lines[at - 1] == ".align 8" && s.sections[at - 1] == s.sections[at];
}

function storage_alignment(s: Scan, at: i32, name: string): boolean {
  let section = s.sections[at];
  let before = at - 1;
  // Only the target's non-allocating visibility declaration can intervene.
  while (before >= 0 && s.sections[before] == section && s.lines[before] == ".globl " + name) {
    before = before - 1;
  }
  if (before < 0 || s.sections[before] != section) {
    return false;
  }
  let line = s.lines[before];
  if (word(line) != ".align") {
    return false;
  }
  let arg = util.trim(slice_unchecked(line, 6, line.len()) + "");
  if (!decimal(arg) || arg.len() > 9) {
    return false;
  }
  let n = util.digits_to_i32(arg);
  return n >= 8 && (n & n - 1) == 0;
}

function space_extent(arg: string, minimum: i32): boolean {
  let parts = arg.split(",");
  if (parts.len() > 2 || parts.len() == 2 && util.trim(parts[1]) != "0") {
    return false;
  }
  let count = util.trim(parts[0]);
  if (!decimal(count) || count.len() > 9) {
    return false;
  }
  return util.digits_to_i32(count) >= minimum;
}

function storage_extent(tail: string, minimum: i32): boolean {
  if (tail == ".quad 0") {
    return minimum <= 8;
  }
  let op = word(tail);
  if (op != ".skip" && op != ".zero") {
    return false;
  }
  return space_extent(util.trim(slice_unchecked(tail, op.len(), tail.len()) + ""), minimum);
}

function storage_at(s: Scan, ix: names.Names, name: string, minimum: i32): boolean {
  let at = names.unique_position(ix, name);
  if (at < 1 || s.sections[at] != 2 && s.sections[at] != 3 || !storage_alignment(s, at, name)) {
    return false;
  }
  let tail = util.trim(slice_unchecked(s.lines[at], name.len() + 1, s.lines[at].len()) + "");
  return storage_extent(tail, minimum);
}

function unique_writable(s: Scan, ix: names.Names): boolean {
  let at = 0;
  for line in s.lines {
    if (s.sections[at] == 2 || s.sections[at] == 3) {
      let name = definition(line);
      if (name != "" && names.unique_position(ix, name) != at) {
        return false;
      }
    }
    at = at + 1;
  }
  return true;
}

// Declaration facts only, in the scanner's normal ELF/AT&T section dialect.
// Establishes aligned writable extents for two heap-bound words, all65536 small
// slots and the45 large slots used by the currently proved release domain.
// Does not prove the complete allocator's larger reserved table, successful
// assembly/linking, linked addresses/disjointness, initialized ordered bounds,
// metadata validity, freelist integrity or any instruction/ownership effect.
// Retains counter_storage's bare writable label and signed literal limitations.
pub function release_storage(text: string): boolean {
  let s = scan(text);
  if (s.error != "" || !writable_declarations(s)) {
    return false;
  }
  let ix = definition_index(s.lines);
  return unique_writable(s, ix) && storage_at(s, ix, "__fern_heap_base", 8) && storage_at(s, ix, "__fern_heap_end", 8) && storage_at(s, ix, "__fern_freelist", 65536 * 8) && storage_at(s, ix, "__fern_large_freelist", 45 * 8);
}

// Returned lines remain unproved. A semantic checker must call this itself,
// decode these exact lines, and derive all machine states internally.
pub function select(text: string, entry: string): Body {
  if (entry != "__fn___fern_arr_dec" && entry != "__fn___fern_str_free") {
    return failure("unsupported decrement helper");
  }
  let s = scan(text);
  if (s.error != "") {
    return failure(s.error);
  }
  let ix = definition_index(s.lines);
  let start = names.unique_position(ix, entry);
  let register = names.unique_position(ix, entry + ".r");
  if (start < 0 || register < 0) {
    return failure("missing or ambiguous decrement entry");
  }
  if (!exact_entry(s, start, entry) || !exact_entry(s, register, entry + ".r")) {
    return failure("decrement entry is not an exact executable definition");
  }
  return body(s, ix, start, register, entry);
}

// Single-entry dependencies share the complete-output namespace policy.
// Their lines are unproved; register_entry is always -1.
pub function dependency(text: string, entry: string): Body {
  if (entry != "__fern_capw" && entry != "__fern_large_push") {
    return failure("unsupported decrement dependency");
  }
  let s = scan(text);
  if (s.error != "") {
    return failure(s.error);
  }
  let ix = definition_index(s.lines);
  let start = names.unique_position(ix, entry);
  if (start < 0 || !exact_entry(s, start, entry)) {
    return failure("missing or ambiguous executable decrement dependency");
  }
  // No second nonlocal entry is part of a dependency body.
  return body(s, ix, start, -1, "");
}

// Fixed normal array-box boundary. Native static pools are declaration data;
// this does not grant allocator linkage, effects or permissions. Keep the
// older decrement dependency selector's syntax and entry set unchanged.
pub function array_box(text: string): Body {
  let s = scan_mode(text, true);
  if (s.error != "") {
    return failure(s.error);
  }
  let ix = definition_index(s.lines);
  let start = names.unique_position(ix, "__fern_arr_box");
  if (ix.duplicate >= 0 || start < 0 || !exact_entry(s, start, "__fern_arr_box")) {
    return failure("missing or ambiguous array-box definition");
  }
  return body(s, ix, start, -1, "");
}

function retained_line_error(line: string, name: string, section: i32, position: i32, ended: boolean): string {
  if (ended || section != 1 || name != "" && line != name + ":") {
    return "invalid retained function extent";
  }
  if (name == "" && util.str_has_prefix(line, ".")) {
    return retained_directive_error(line, position);
  }
  return "";
}

function retained_directive_error(line: string, position: i32): string {
  let op = word(line);
  let arg = util.trim(slice_unchecked(line, op.len(), line.len()) + "");
  if (!metadata(line, op, arg, 1) || !util.str_has_prefix(line, ".cfi_")) {
    return "unsupported retained function directive";
  }
  if (line == ".cfi_startproc" && position != 1) {
    return "nested retained function frame";
  }
  return "";
}

function retained_lines(s: Scan, start: i32, entry: string): Body {
  let code: string[] = [s.lines[start]];
  let reg = -1;
  let ended = false;
  let at = start + 1;
  while (at < s.lines.len()) {
    let line = s.lines[at];
    let name = definition(line);
    if (ends_body(line, name, entry) || util.str_has_prefix(line, ".globl ")) {
      break;
    }
    let error = retained_line_error(line, name, s.sections[at], code.len(), ended);
    if (error != "") {
      return failure(error);
    }
    if (name == entry + ".r") {
      reg = code.len();
    }
    ended = line == ".cfi_endproc";
    code = code.append(line);
    at = at + 1;
  }
  if (!ended || code.len() < 3 || code[1] != ".cfi_startproc") {
    return failure("missing retained function frame");
  }
  return Body { lines: code, register_entry: reg, error: "" };
}

// Extract an ordinary x86 text-mode retained function from the complete unit.
// Unlike the decrement APIs, this declaration-only path admits signed/symbolic
// quad data and bare static-pool labels. It never invokes writable_declarations
// or establishes storage, runtime, instruction, unwind or ownership effects.
// CFI bounds are checked in addition to the complete unique symbol namespace.
pub function native_body(text: string, entry: string): Body {
  if (!util.str_has_prefix(entry, "__fn_") || entry.len() <= 5 || !symbol(entry)) {
    return failure("unsupported retained function name");
  }
  let s = scan_mode(text, true);
  if (s.error != "") {
    return failure(s.error);
  }
  let ix = definition_index(s.lines);
  let start = names.unique_position(ix, entry);
  if (ix.duplicate >= 0 || start < 0 || !exact_entry(s, start, entry)) {
    return failure("missing or ambiguous retained function definition");
  }
  return retained_lines(s, start, entry);
}
