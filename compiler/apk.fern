// The APK writer of fern -apk. An APK for a NativeActivity app has a binary
// AndroidManifest.xml, the library of each ABI, and no Java code. An app
// with an icon also has the PNG and a resources.arsc that names it. The zip
// archive has aligned entries and an APK Signature Scheme v2 block with a
// self-signed P-256 certificate.
//
// The libraries are stored by default, and the manifest sets
// extractNativeLibs to false: Android maps each library from the APK, so the
// installed app is the APK alone. With `compress`, the libraries are
// deflated, and Android extracts them at install. Then the APK is smaller,
// but the installed app is the APK and the libraries.
import "std/base64";
import "std/crypto";
import "std/deflate";
import "std/crypto/ecdsa";
import "std/crypto/sha2";
import "std/hash/crc32";
import "std/rand";
import "./androidxml";
import "./util";

// `activity` is the Java class of the activity, and `dex` holds the classes
// of the app, or is empty.
// `permissions` are the full names of the permissions the app uses, and
// `min_sdk` is the lowest API level it runs on. `icon` is the PNG of the
// launcher icon, or is empty. `compress` deflates the libraries. `home`
// makes the activity a home screen, and `assets` go under assets/.
// `providers` are the Java classes of the content providers.
pub struct App { package: string, label: string, lib: string, version_code: i32, version_name: string, activity: string, dex: u8[], more_dex: u8[][], permissions: string[], min_sdk: i32, services: Service[], providers: string[], icon: u8[], banner: u8[], compress: boolean, cleartext: boolean, backup: boolean, debuggable: boolean, home: boolean, tv: boolean, pip: boolean, assets: Asset[], widget: Widget }

// The app widget of the home screen: the Java class of its provider, which
// extends android.appwidget.AppWidgetProvider, and the items of its row. An
// app with no widget has no provider.
pub struct Widget { provider: string, items: Item[] }

// An item of the row of a widget: a text that takes the room that is left,
// or a button. `name` is the name of its ID, and `label` is the text that
// it shows first.
pub struct Item { button: boolean, name: string, label: string }

pub function no_widget(): Widget {
  return Widget { provider: "", items: [] };
}

// The ID of the layout of the widget, of its provider file, and of its
// first item. The items have IDs one after the other.
pub const WIDGET_LAYOUT_ID: i32 = 2130837504;

const WIDGET_INFO_ID: i32 = 2130903040;

pub const WIDGET_ITEM_ID: i32 = 2130968576;

// A service of the app: its Java class, and its foreground service types as
// the flags of android:foregroundServiceType, or 0. A service that only the
// system binds names the permission that the binder needs and the action of
// its intent filter, or has "" for both. Other apps can bind an exported
// service, such as a media browser that Android Auto binds.
pub struct Service { name: string, types: i32, permission: string, action: string, exported: boolean }

// The action of a media browser service, which Android Auto binds.
pub const BROWSE_ACTION: string = "android.media.browse.MediaBrowserService";

// The meta-data of the application that marks it as an app of Android
// Auto, and the file that says that it is a media app.
const CAR_META: string = "com.google.android.gms.car.application";

pub const CAR_PATH: string = "res/xml/automotive_app_desc.xml";

// True when the app has a media browser service, so Android Auto shows it.
pub function for_car(app: App): boolean {
  return app.services.any((sv: Service): boolean => sv.action == BROWSE_ACTION);
}

// The file of Android Auto: the app uses the media templates.
pub function car_desc(): androidxml.Element {
  let name = androidxml.Attr { name: "name", id: 0, kind: androidxml.STRING, data: 0, text: "media" };
  return androidxml.element("automotiveApp", [], [androidxml.element("uses", [name], [])]);
}

// An XML file of the resources of the app, and its place in the archive.
pub struct XmlFile { path: string, root: androidxml.Element }

// The XML files of the resources: the layout and the provider file of the
// widget, and the file of Android Auto.
pub function xml_files(app: App): XmlFile[] {
  let out: XmlFile[] = [];
  if (app.widget.provider.len() > 0) {
    out = out.append(XmlFile { path: WIDGET_LAYOUT_PATH, root: widget_layout(app.widget) }).append(XmlFile { path: WIDGET_INFO_PATH, root: widget_info() });
  }
  if (for_car(app)) {
    out = out.append(XmlFile { path: CAR_PATH, root: car_desc() });
  }
  return out;
}

// A file of the APK under assets/, which AAssetManager reads.
pub struct Asset { name: string, data: u8[] }

// The DEX files of the app: the @jni classes, then each -apk-dex file. ART
// reads classes.dex first, then classes2.dex, and so on.
pub function dex_files(app: App): Asset[] {
  let all: u8[][] = [];
  if (app.dex.len() > 0) {
    all = all.append(app.dex);
  }
  for d in app.more_dex {
    all = all.append(d);
  }
  let out: Asset[] = [];
  for k in 0..all.len() {
    let name = "classes.dex";
    if (k > 0) {
      name = "classes" + (k + 1).to_string() + ".dex";
    }
    out = out.append(Asset { name: name, data: all[k] });
  }
  return out;
}

// The permission and the action of a notification listener service.
pub const LISTENER_PERMISSION: string = "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE";

pub const LISTENER_ACTION: string = "android.service.notification.NotificationListenerService";

// The theme of a home screen, Theme.DeviceDefault.Wallpaper.NoTitleBar: the
// status bar shows, and the wallpaper is behind the window, so Android uses
// the transitions of a home screen.
const HOME_THEME: i32 = 16974141;

// The theme of other apps, Theme.NoTitleBar.Fullscreen.
const APP_THEME: i32 = 16973834;

// The flags of android:foregroundServiceType that `permissions` allow: each
// FOREGROUND_SERVICE_<TYPE> permission gives the flag of its type.
pub function foreground_types(permissions: string[]): i32 {
  let names: string[] = ["DATA_SYNC", "MEDIA_PLAYBACK", "PHONE_CALL", "LOCATION", "CONNECTED_DEVICE", "MEDIA_PROJECTION", "CAMERA", "MICROPHONE", "HEALTH", "REMOTE_MESSAGING", "SYSTEM_EXEMPTED"];
  let types = 0;
  for p in permissions {
    let k = util.index_of_str(names, p.replace("android.permission.FOREGROUND_SERVICE_", ""));
    if (p.starts_with("android.permission.FOREGROUND_SERVICE_") && k >= 0) {
      types = types | 1 << k;
    }
  }
  if (util.has_str(permissions, "android.permission.FOREGROUND_SERVICE_SPECIAL_USE")) {
    types = types | 1073741824;
  }
  return types;
}

pub struct Lib { abi: string, image: u8[] }

// The default lowest API level: APK Signature Scheme v2 needs Android 7.0.
pub const MIN_SDK: i32 = 24;

// The largest android:versionCode that Google Play takes.
pub const MAX_VERSION_CODE: i64 = 2100000000i64;

pub const TARGET_SDK: i32 = 36;

// Byte encodings, little-endian.

function put64(out: u8[], v: i64): u8[] {
  return androidxml.put32(androidxml.put32(out, (v & 4294967295i64) as i32), (v >> 32) as i32);
}

function text(s: string): u8[] {
  let out: u8[] = [];
  for i in 0..s.len() {
    out = out.append(s[i]);
  }
  return out;
}

// A field with a 32-bit length in front of it.
function prefixed(b: [u8]): u8[] {
  return util.append_bytes(androidxml.put32([], b.len()), b);
}

// The framework attributes of the files of an app, and their resource IDs.
const ATTR_NAMES: string[] = ["theme", "label", "icon", "name", "permission", "hasCode", "debuggable", "exported", "taskAffinity", "clearTaskOnLaunch", "stateNotNeeded", "excludeFromRecents", "authorities", "grantUriPermissions", "launchMode", "configChanges", "value", "resource", "textSize", "textColor", "gravity", "orientation", "id", "background", "padding", "layout_width", "layout_height", "minWidth", "minHeight", "text", "maxLines", "layout_weight", "minSdkVersion", "versionCode", "versionName", "windowSoftInputMode", "updatePeriodMillis", "initialLayout", "targetSdkVersion", "allowBackup", "required", "resizeMode", "banner", "resumeWhilePausing", "extractNativeLibs", "usesCleartextTraffic", "resizeableActivity", "supportsPictureInPicture", "foregroundServiceType", "enableOnBackInvokedCallback"];

const ATTR_IDS: i32[] = [16842752, 16842753, 16842754, 16842755, 16842758, 16842764, 16842767, 16842768, 16842770, 16842773, 16842774, 16842775, 16842776, 16842779, 16842781, 16842783, 16842788, 16842789, 16842901, 16842904, 16842927, 16842948, 16842960, 16842964, 16842965, 16842996, 16842997, 16843071, 16843072, 16843087, 16843091, 16843137, 16843276, 16843291, 16843292, 16843307, 16843344, 16843345, 16843376, 16843392, 16843406, 16843619, 16843762, 16843954, 16844010, 16844012, 16844022, 16844023, 16844185, 16844396];

// An attribute of the android namespace.
function attr(name: string, kind: i32, data: i32): androidxml.Attr {
  return androidxml.int_attr(name, ATTR_IDS[util.index_of_str(ATTR_NAMES, name)], kind, data);
}

function text_attr(name: string, text: string): androidxml.Attr {
  return androidxml.text_attr(name, ATTR_IDS[util.index_of_str(ATTR_NAMES, name)], text);
}

function flag(name: string, on: boolean): androidxml.Attr {
  return attr(name, androidxml.BOOLEAN, if (on) { -1 } else { 0 });
}

function named(tag: string, name: string): androidxml.Element {
  return androidxml.element(tag, [text_attr("name", name)], []);
}

// The features and the launcher category of an app for Android TV.
const LEANBACK: string = "android.software.leanback";

const TOUCHSCREEN: string = "android.hardware.touchscreen";

const LEANBACK_LAUNCHER: string = "android.intent.category.LEANBACK_LAUNCHER";

// A content provider that no other app finds. Its authority is the name
// of its class, and the app gives access to one URI at a time.
function provider_element(name: string): androidxml.Element {
  return androidxml.element("provider", [text_attr("name", name), flag("exported", false), text_attr("authorities", name), flag("grantUriPermissions", true)], []);
}

function service_element(sv: Service): androidxml.Element {
  let attrs: androidxml.Attr[] = [text_attr("name", sv.name)];
  if (sv.permission.len() > 0) {
    attrs = attrs.append(text_attr("permission", sv.permission));
  }
  attrs = attrs.append(flag("exported", sv.exported));
  if (sv.types != 0) {
    attrs = attrs.append(attr("foregroundServiceType", androidxml.INT_HEX, sv.types));
  }
  let kids: androidxml.Element[] = [];
  if (sv.action.len() > 0) {
    kids = [androidxml.element("intent-filter", [], [named("action", sv.action)])];
  }
  return androidxml.element("service", attrs, kids);
}

const WIDGET_UPDATE: string = "android.appwidget.action.APPWIDGET_UPDATE";

const WIDGET_META: string = "android.appwidget.provider";

// The receiver of the widget: Android sends it the update action, and
// finds the provider file of the widget in its meta-data.
function receiver_element(w: Widget): androidxml.Element {
  let filter = androidxml.element("intent-filter", [], [named("action", WIDGET_UPDATE)]);
  let meta = androidxml.element("meta-data", [text_attr("name", WIDGET_META), attr("resource", androidxml.REFERENCE, WIDGET_INFO_ID)], []);
  return androidxml.element("receiver", [text_attr("name", w.provider), flag("exported", true)], [filter, meta]);
}

// The AndroidManifest.xml of `app`: one NativeActivity that loads
// lib<app.lib>.so, with the launcher intent filter. A home screen also has
// the home categories, so Android offers it as the home app. An app for a
// TV also has the launcher category of Android TV, and needs no touch
// screen.
pub function manifest_tree(app: App): androidxml.Element {
  let top: androidxml.Element[] = [androidxml.element("uses-sdk", [attr("minSdkVersion", androidxml.INT_DEC, app.min_sdk), attr("targetSdkVersion", androidxml.INT_DEC, TARGET_SDK)], [])];
  for p in app.permissions {
    top = top.append(named("uses-permission", p));
  }
  if (app.tv) {
    // An app for a TV runs on a phone too, so neither feature is required.
    for f in [LEANBACK, TOUCHSCREEN] {
      top = top.append(androidxml.element("uses-feature", [text_attr("name", f), flag("required", false)], []));
    }
  }
  let theme = APP_THEME;
  if (app.home) {
    theme = HOME_THEME;
  }
  let app_attrs: androidxml.Attr[] = [attr("theme", androidxml.REFERENCE, theme), text_attr("label", app.label)];
  let activity_attrs: androidxml.Attr[] = [text_attr("label", app.label)];
  if (app.icon.len() > 0) {
    app_attrs = app_attrs.append(attr("icon", androidxml.REFERENCE, ICON_ID));
    activity_attrs = activity_attrs.append(attr("icon", androidxml.REFERENCE, ICON_ID));
  }
  app_attrs = app_attrs.append(flag("hasCode", app.dex.len() > 0));
  if (app.debuggable) {
    app_attrs = app_attrs.append(flag("debuggable", true));
  }
  app_attrs = app_attrs.append(flag("allowBackup", app.backup));
  if (app.banner.len() > 0) {
    app_attrs = app_attrs.append(attr("banner", androidxml.REFERENCE, banner_id(app)));
  }
  app_attrs = app_attrs.append(flag("extractNativeLibs", app.compress));
  if (app.cleartext) {
    app_attrs = app_attrs.append(flag("usesCleartextTraffic", true));
  }
  // The back key goes to the OnBackInvokedCallback of std/android from
  // Android 13, as it must for an app that targets Android 16.
  app_attrs = app_attrs.append(flag("enableOnBackInvokedCallback", true));
  activity_attrs = activity_attrs.append(text_attr("name", app.activity)).append(flag("exported", true));
  if (app.home) {
    // One task, which Android does not keep in the recents and starts again
    // with no saved state.
    activity_attrs = activity_attrs.append(text_attr("taskAffinity", "")).append(flag("clearTaskOnLaunch", true)).append(flag("stateNotNeeded", true)).append(flag("excludeFromRecents", true));
  }
  // singleTask, so a start of the app that runs gives its intent to the
  // activity, and the process has one activity and one loop.
  // SOFT_INPUT_ADJUST_RESIZE, so the content rectangle leaves out the
  // keyboard before Android 15. From Android 15 the window goes under the
  // bars and the keyboard, and std/android reads their insets.
  // An app with picture-in-picture also keeps its activity when the window
  // changes size or layout (CONFIG_SCREEN_LAYOUT and
  // CONFIG_SMALLEST_SCREEN_SIZE), as it does in the small window.
  let changes = 1184;
  if (app.pip) {
    changes = changes | 2304;
  }
  activity_attrs = activity_attrs.append(attr("launchMode", androidxml.INT_DEC, 2)).append(attr("configChanges", androidxml.INT_HEX, changes)).append(attr("windowSoftInputMode", androidxml.INT_HEX, 16));
  if (app.home) {
    // resumeWhilePausing, so home shows at once.
    activity_attrs = activity_attrs.append(flag("resumeWhilePausing", true));
  }
  if (app.pip) {
    activity_attrs = activity_attrs.append(flag("resizeableActivity", true)).append(flag("supportsPictureInPicture", true));
  }
  let filter: androidxml.Element[] = [named("action", "android.intent.action.MAIN"), named("category", "android.intent.category.LAUNCHER")];
  if (app.tv) {
    filter = filter.append(named("category", LEANBACK_LAUNCHER));
  }
  if (app.home) {
    filter = filter.append(named("category", "android.intent.category.HOME")).append(named("category", "android.intent.category.DEFAULT"));
  }
  let meta = androidxml.element("meta-data", [text_attr("name", "android.app.lib_name"), text_attr("value", app.lib)], []);
  let parts: androidxml.Element[] = [androidxml.element("activity", activity_attrs, [meta, androidxml.element("intent-filter", [], filter)])];
  for sv in app.services {
    parts = parts.append(service_element(sv));
  }
  for name in app.providers {
    parts = parts.append(provider_element(name));
  }
  if (app.widget.provider.len() > 0) {
    parts = parts.append(receiver_element(app.widget));
  }
  if (for_car(app)) {
    parts = parts.append(androidxml.element("meta-data", [text_attr("name", CAR_META), attr("resource", androidxml.REFERENCE, resource_id(app, "xml", "automotive_app_desc"))], []));
  }
  top = top.append(androidxml.element("application", app_attrs, parts));
  let package = androidxml.Attr { name: "package", id: 0, kind: androidxml.STRING, data: 0, text: app.package };
  return androidxml.element("manifest", [attr("versionCode", androidxml.INT_DEC, app.version_code), text_attr("versionName", app.version_name), package], top);
}

// The binary AndroidManifest.xml of `app`.
pub function manifest(app: App): u8[] {
  return androidxml.binary(manifest_tree(app));
}

// The ID of the icon is 0x7f010000, and the banner, the image of the app on
// the launcher of Android TV, comes after it.
const ICON_ID: i32 = 2130771968;

function banner_id(app: App): i32 {
  if (app.icon.len() > 0) {
    return ICON_ID + 1;
  }
  return ICON_ID;
}

// A chunk: its type, the size of its header, and the header and body.
function chunk(kind: i32, header: [u8], body: [u8]): u8[] {
  let out = androidxml.put32(androidxml.put16(androidxml.put16([], kind), 8 + header.len()), 8 + header.len() + body.len());
  return util.append_bytes(util.append_bytes(out, header), body);
}

// The 128 UTF-16 units of a package name, padded with zeros.
function package_name(name: string): u8[] {
  let out: u8[] = [];
  let units = androidxml.utf16(name);
  for k in 0..128 {
    if (k < units.len()) {
      out = androidxml.put16(out, units[k]);
    } else {
      out = androidxml.put16(out, 0);
    }
  }
  return out;
}

// An entry of the resource table: its name, and the path of its file in
// the archive, or "" for an ID.
pub struct Res { key: string, path: string }

// A type of the resource table: its ID in the package, its name, and its
// entries in the default configuration.
pub struct ResType { id: i32, name: string, entries: Res[] }

pub const ICON_PATH: string = "res/drawable/icon.png";

pub const BANNER_PATH: string = "res/drawable/banner.png";

pub const WIDGET_LAYOUT_PATH: string = "res/layout/widget.xml";

pub const WIDGET_INFO_PATH: string = "res/xml/widget.xml";

// The types of the resource table, of package 0x7f. The type 1, drawable,
// has the icon and the banner, each when the app has it. With a widget, the
// type 2 has its layout, the type 3 has its provider file, and the type 4
// has the IDs of its items.
pub function res_types(app: App): ResType[] {
  let images: Res[] = [];
  if (app.icon.len() > 0) {
    images = images.append(Res { key: "icon", path: ICON_PATH });
  }
  if (app.banner.len() > 0) {
    images = images.append(Res { key: "banner", path: BANNER_PATH });
  }
  let names = ["drawable"];
  let all = [images];
  let xml: Res[] = [];
  let ids: Res[] = [];
  if (app.widget.provider.len() > 0) {
    names = names.append("layout");
    all = all.append([Res { key: "widget", path: WIDGET_LAYOUT_PATH }]);
    xml = xml.append(Res { key: "widget_info", path: WIDGET_INFO_PATH });
    for item in app.widget.items {
      ids = ids.append(Res { key: item.name, path: "" });
    }
  }
  if (for_car(app)) {
    xml = xml.append(Res { key: "automotive_app_desc", path: CAR_PATH });
  }
  if (xml.len() > 0) {
    names = names.append("xml");
    all = all.append(xml);
  }
  if (ids.len() > 0) {
    names = names.append("id");
    all = all.append(ids);
  }
  let out: ResType[] = [];
  for k in 0..names.len() {
    out = out.append(ResType { id: k + 1, name: names[k], entries: all[k] });
  }
  return out;
}

// The ID of the resource `key` of the type `kind`: 0x7f in the high byte,
// then the type, then the place of the entry. It is 0 for no such resource.
pub function resource_id(app: App, kind: string, key: string): i32 {
  for t in res_types(app) {
    for k in 0..t.entries.len() {
      if (t.name == kind && t.entries[k].key == key) {
        return 2130706432 | t.id << 16 | k;
      }
    }
  }
  return 0;
}

// True when the app has a resource.
pub function has_resources(app: App): boolean {
  return app.icon.len() > 0 || app.banner.len() > 0 || app.widget.provider.len() > 0 || for_car(app);
}

// The spec chunk and the type chunk of `t` in the default configuration.
// `first` is the index of the key of its first entry. The value of a file
// is the index of its path in `paths`, and an ID is the boolean false.
function type_chunks(t: ResType, first: i32, paths: string[]): u8[] {
  let n = t.entries.len();
  let flags: u8[] = [];
  for k in 0..n {
    flags = androidxml.put32(flags, 0);
  }
  let spec = chunk(514, androidxml.put32(androidxml.put16(util.put_u8(util.put_u8([], t.id), 0), 0), n), flags);
  let config: u8[] = androidxml.put32([], 64);
  while (config.len() < 64) {
    config = config.append(0 as u8);
  }
  let header = util.append_bytes(androidxml.put32(androidxml.put32(androidxml.put16(util.put_u8(util.put_u8([], t.id), 0), 0), n), 8 + 12 + config.len() + 4 * n), config);
  let offsets: u8[] = [];
  let body: u8[] = [];
  for k in 0..n {
    let r = t.entries[k];
    let kind = androidxml.STRING;
    let data = util.index_of_str(paths, r.path);
    if (r.path.len() == 0) {
      kind = androidxml.BOOLEAN;
      data = 0;
    }
    offsets = androidxml.put32(offsets, body.len());
    body = androidxml.put32(androidxml.put16(androidxml.put16(body, 8), 0), first + k);
    body = androidxml.put32(util.put_u8(util.put_u8(androidxml.put16(body, 8), 0), kind), data);
  }
  return util.append_bytes(spec, chunk(513, header, util.append_bytes(offsets, body)));
}

// The resources.arsc of the app. A type with no entry has no chunk.
function resource_table(app: App): u8[] {
  let types = res_types(app);
  let kinds: string[] = [];
  let keys: string[] = [];
  let paths: string[] = [];
  for t in types {
    kinds = kinds.append(t.name);
    for r in t.entries {
      if (r.path.len() > 0) {
        paths = paths.append(r.path);
      }
    }
  }
  let body: u8[] = [];
  for t in types {
    if (t.entries.len() > 0) {
      body = util.append_bytes(body, type_chunks(t, keys.len(), paths));
      for r in t.entries {
        keys = keys.append(r.key);
      }
    }
  }
  let type_pool = androidxml.string_pool(kinds);
  let pkg_header = util.append_bytes(androidxml.put32([], 127), package_name(app.package));
  pkg_header = androidxml.put32(androidxml.put32(androidxml.put32(androidxml.put32(androidxml.put32(pkg_header, 288), kinds.len()), 288 + type_pool.len()), keys.len()), 0);
  let pkg = chunk(512, pkg_header, util.append_bytes(util.append_bytes(type_pool, androidxml.string_pool(keys)), body));
  return chunk(2, androidxml.put32([], 1), util.append_bytes(androidxml.string_pool(paths), pkg));
}

// A size in dp or in sp as the data of a dimension value.
function dp(n: i32): i32 {
  return n << 8 | 1;
}

function sp(n: i32): i32 {
  return n << 8 | 2;
}

// The layout of the widget: a row on a dark ground. A text takes the room
// that is left, on one line, and a button has the size of its label.
pub function widget_layout(w: Widget): androidxml.Element {
  let kids: androidxml.Element[] = [];
  for k in 0..w.items.len() {
    let item = w.items[k];
    let attrs: androidxml.Attr[] = [attr("textSize", androidxml.DIMENSION, sp(14)), attr("textColor", androidxml.COLOR_ARGB8, -1), attr("id", androidxml.REFERENCE, WIDGET_ITEM_ID + k), attr("layout_width", androidxml.DIMENSION, dp(0)), attr("layout_height", androidxml.INT_DEC, -2), text_attr("text", item.label), attr("maxLines", androidxml.INT_DEC, 1), attr("layout_weight", androidxml.FLOAT, 1065353216)];
    if (item.button) {
      attrs = [attr("textSize", androidxml.DIMENSION, sp(16)), attr("textColor", androidxml.COLOR_ARGB8, -1), attr("gravity", androidxml.INT_HEX, 17), attr("id", androidxml.REFERENCE, WIDGET_ITEM_ID + k), attr("padding", androidxml.DIMENSION, dp(12)), attr("layout_width", androidxml.INT_DEC, -2), attr("layout_height", androidxml.INT_DEC, -2), text_attr("text", item.label)];
    }
    kids = kids.append(androidxml.element("TextView", attrs, []));
  }
  return androidxml.element("LinearLayout", [attr("gravity", androidxml.INT_HEX, 16), attr("orientation", androidxml.INT_DEC, 0), attr("background", androidxml.COLOR_ARGB8, -434101980), attr("padding", androidxml.DIMENSION, dp(8)), attr("layout_width", androidxml.INT_DEC, -1), attr("layout_height", androidxml.INT_DEC, -1)], kids);
}

// The provider file of the widget: its smallest size, its layout, and no
// update by the clock.
pub function widget_info(): androidxml.Element {
  return androidxml.element("appwidget-provider", [attr("minWidth", androidxml.DIMENSION, dp(250)), attr("minHeight", androidxml.DIMENSION, dp(40)), attr("updatePeriodMillis", androidxml.INT_DEC, 0), attr("initialLayout", androidxml.REFERENCE, WIDGET_LAYOUT_ID), attr("resizeMode", androidxml.INT_HEX, 1)], []);
}

// The zip archive. The data of each entry starts at a multiple of its
// alignment: 16384 bytes for a stored library, so that a device with 16 KB
// pages can map it, and 4 bytes for the rest. The 0xd935 extra field holds
// the padding, as zipalign writes it. A deflated entry has method 8.

pub struct Entry { name: string, data: u8[], deflated: boolean }

pub struct Zip { body: u8[], central: u8[], count: i32 }

function align_of(e: Entry): i32 {
  if (e.name.ends_with(".so") && !e.deflated) {
    return 16384;
  }
  return 4;
}

function add_entry(z: Zip, e: Entry): Zip {
  let off = z.body.len();
  let crc = crc32.of(e.data) as i32;
  let align = align_of(e);
  let method = 0;
  let data = e.data;
  if (e.deflated) {
    method = 8;
    data = deflate.deflate(e.data);
  }
  let pad = (align - (off + 36 + e.name.len()) % align) % align;
  let head = androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put32([], 67324752), 10), 0), method), 0), 33);
  head = androidxml.put16(androidxml.put16(androidxml.put32(androidxml.put32(androidxml.put32(head, crc), data.len()), e.data.len()), e.name.len()), 6 + pad);
  head = androidxml.put16(androidxml.put16(androidxml.put16(util.append_bytes(head, text(e.name)), 55605), 2 + pad), align);
  for k in 0..pad {
    head = head.append(0 as u8);
  }
  let cd = androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put32(z.central, 33639248), 20), 10), 0), method), 0), 33);
  cd = androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put32(androidxml.put32(androidxml.put32(cd, crc), data.len()), e.data.len()), e.name.len()), 0), 0), 0);
  cd = util.append_bytes(androidxml.put32(androidxml.put32(androidxml.put16(cd, 0), 0), off), text(e.name));
  return Zip { body: util.append_bytes(util.append_bytes(z.body, head), data), central: cd, count: z.count + 1 };
}

function slice_bytes(b: [u8], from: i32, to: i32): u8[] {
  let out: u8[] = [];
  for i in from..to {
    out = out.append(b[i]);
  }
  return out;
}

pub function zip(entries: Entry[]): Zip {
  let z = Zip { body: [], central: [], count: 0 };
  for e in entries {
    z = add_entry(z, e);
  }
  return z;
}

// The end of central directory record, for a central directory of `size`
// bytes at `offset`.
pub function eocd(count: i32, size: i32, offset: i32): u8[] {
  return androidxml.put16(androidxml.put32(androidxml.put32(androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put16(androidxml.put32([], 101010256), 0), 0), count), count), size), offset), 0);
}

// The DER encoding of the certificate, the key, and the signatures.

pub function der(tag: i32, content: [u8]): u8[] {
  let out = util.put_u8([], tag);
  let n = content.len();
  if (n < 128) {
    out = util.put_u8(out, n);
  } else if (n < 256) {
    out = util.put_u8(util.put_u8(out, 129), n);
  } else {
    out = util.put_u8(util.put_u8(util.put_u8(out, 130), n >> 8), n);
  }
  return util.append_bytes(out, content);
}

pub function seq(parts: u8[][]): u8[] {
  let out: u8[] = [];
  for p in parts {
    out = util.append_bytes(out, p);
  }
  return der(48, out);
}

pub function oid(bytes: u8[]): u8[] {
  return der(6, bytes);
}

function oid_ec_public_key(): u8[] {
  return oid([42 as u8, 134 as u8, 72 as u8, 206 as u8, 61 as u8, 2 as u8, 1 as u8]);
}

function oid_p256(): u8[] {
  return oid([42 as u8, 134 as u8, 72 as u8, 206 as u8, 61 as u8, 3 as u8, 1 as u8, 7 as u8]);
}

pub function ecdsa_sha256(): u8[] {
  return seq([oid([42 as u8, 134 as u8, 72 as u8, 206 as u8, 61 as u8, 4 as u8, 3 as u8, 2 as u8])]);
}

function bit_string(b: [u8]): u8[] {
  return der(3, util.append_bytes([0 as u8], b));
}

// The SubjectPublicKeyInfo of the P-256 point `point`.
pub function public_key_info(point: [u8]): u8[] {
  return seq([seq([oid_ec_public_key(), oid_p256()]), bit_string(point)]);
}

pub function name(cn: string): u8[] {
  return seq([der(49, seq([oid([85 as u8, 4 as u8, 3 as u8]), der(12, text(cn))]))]);
}

// The common name of the issuer and of the subject of the certificate.
pub const SUBJECT: string = "Fern";

// The serial number of the certificate of `key`: from its public point, so
// the same key gives the same number.
pub function serial(key: ecdsa.PrivateKey): u8[] {
  let out: u8[] = [1 as u8];
  for b in crypto.sha256(key.public_point())[0:8] {
    out = out.append(b);
  }
  return out;
}

// A version 1 certificate for `key`, signed by itself. The dates are fixed,
// so the same key gives the same certificate.
pub function certificate(key: ecdsa.PrivateKey): u8[] {
  let point = key.public_point();
  let validity = seq([der(23, text("260101000000Z")), der(24, text("20991231235959Z"))]);
  let tbs = seq([der(2, serial(key)), ecdsa_sha256(), name(SUBJECT), validity, name(SUBJECT), public_key_info(point)]);
  return seq([tbs, ecdsa_sha256(), bit_string(sign(key, tbs))]);
}

pub function sign(key: ecdsa.PrivateKey, msg: [u8]): u8[] {
  match (key.sign(sha2.Sha256, msg)) {
    Ok(sig) => {
      return sig;
    },
    Err(_) => {
      return [];
    }
  }
}

// The PKCS #8 encoding of the P-256 scalar `d`, as a PEM file.
pub function key_pem(d: [u8]): string {
  let point: u8[] = [];
  match (ecdsa.private_key(ecdsa.P256, d)) {
    Ok(key) => {
      point = key.public_point();
    },
    Err(_) => {
      return "";
    }
  }
  let ec = seq([der(2, [1 as u8]), der(4, d), der(161, bit_string(point))]);
  let pk = seq([der(2, [0 as u8]), seq([oid_ec_public_key(), oid_p256()]), der(4, ec)]);
  let b64 = base64.encode(pk);
  let out = "-----BEGIN PRIVATE KEY-----\n";
  let i = 0;
  while (i < b64.len()) {
    let j = i + 64;
    if (j > b64.len()) {
      j = b64.len();
    }
    out = out + slice_unchecked(b64, i, j) + "\n";
    i = j;
  }
  return out + "-----END PRIVATE KEY-----\n";
}

struct Tlv { tag: i32, start: i32, end: i32 }

// The DER element at `at`: its tag and the span of its content.
function tlv(b: [u8], at: i32): Tlv {
  if (at + 2 > b.len()) {
    return Tlv { tag: -1, start: at, end: at };
  }
  let n = b[at + 1] as i32;
  let start = at + 2;
  if (n > 128 && n <= 130) {
    let len = 0;
    for k in 0..n - 128 {
      if (start + k < b.len()) {
        len = len << 8 | b[start + k] as i32;
      }
    }
    start = start + n - 128;
    n = len;
  }
  if (start + n > b.len()) {
    return Tlv { tag: -1, start: at, end: at };
  }
  return Tlv { tag: b[at] as i32, start: start, end: start + n };
}

// The private scalar of a PEM key file: PKCS #8 ("PRIVATE KEY") or SEC 1
// ("EC PRIVATE KEY") for P-256. The result is empty when the file is not
// one of these.
pub function key_scalar(pem: string): u8[] {
  let body = "";
  for line in pem.split("\n") {
    if (line.len() > 0 && !line.starts_with("-----")) {
      body += line;
    }
  }
  match (base64.decode(body)) {
    Ok(raw) => {
      return scalar_of(raw);
    },
    Err(_) => {
      return [];
    }
  }
}

function scalar_of(raw: [u8]): u8[] {
  let top = tlv(raw, 0);
  let version = tlv(raw, top.start);
  let next = tlv(raw, version.end);
  if (top.tag != 48 || version.tag != 2) {
    return [];
  }
  if (next.tag == 4 && next.end - next.start == 32) {
    return slice_bytes(raw, next.start, next.end);
  }
  let wrapped = tlv(raw, next.end);
  if (next.tag != 48 || wrapped.tag != 4) {
    return [];
  }
  return scalar_of(slice_bytes(raw, wrapped.start, wrapped.end));
}

// A new random P-256 scalar.
pub function new_scalar(): u8[] {
  while (true) {
    let d = rand.bytes(32);
    match (ecdsa.private_key(ecdsa.P256, d)) {
      Ok(_) => {
        return d;
      },
      Err(_) => {}
    }
  }
}

// APK Signature Scheme v2. The digest covers the entries, the central
// directory and the end record, in chunks of 1 MiB.

const CHUNK: i32 = 1048576;

function chunk_digests(out: u8[], b: [u8]): (u8[], i32) {
  let n = (b.len() + CHUNK - 1) / CHUNK;
  for k in 0..n {
    let at = k * CHUNK;
    let to = at + CHUNK;
    if (to > b.len()) {
      to = b.len();
    }
    out = util.append_bytes(out, crypto.sha256(util.append_bytes(androidxml.put32([165 as u8], to - at), b[at:to])));
  }
  return (out, n);
}

// The v2 content digest of the three sections of an unsigned APK.
pub function content_digest(entries: [u8], central: [u8], end_record: [u8]): u8[] {
  let (d1, n1) = chunk_digests([], entries);
  let (d2, n2) = chunk_digests(d1, central);
  let (d3, n3) = chunk_digests(d2, end_record);
  return crypto.sha256(util.append_bytes(androidxml.put32([90 as u8], n1 + n2 + n3), d3));
}

const ECDSA_SHA256: i32 = 513;

const V2_BLOCK_ID: i32 = 1896449818;

// The APK Signing Block with one v2 signer.
pub function signing_block(key: ecdsa.PrivateKey, cert: [u8], digest: [u8]): u8[] {
  let digests = prefixed(prefixed(util.append_bytes(androidxml.put32([], ECDSA_SHA256), prefixed(digest))));
  let signed = util.append_bytes(util.append_bytes(digests, prefixed(prefixed(cert))), androidxml.put32([], 0));
  let sigs = prefixed(prefixed(util.append_bytes(androidxml.put32([], ECDSA_SHA256), prefixed(sign(key, signed)))));
  let signer = util.append_bytes(util.append_bytes(prefixed(signed), sigs), prefixed(public_key_info(key.public_point())));
  let value = prefixed(prefixed(signer));
  let pair = util.append_bytes(androidxml.put32(put64([], (4 + value.len()) as i64), V2_BLOCK_ID), value);
  let size = (pair.len() + 24) as i64;
  return util.append_bytes(put64(util.append_bytes(put64([], size), pair), size), text("APK Sig Block 42"));
}

// The signed APK of `app`, with the manifest, then one library for each
// ABI, signed with the P-256 scalar `d`.
pub function write(app: App, libs: Lib[], d: [u8]): u8[] {
  match (ecdsa.private_key(ecdsa.P256, d)) {
    Ok(key) => {
      return signed(app, libs, key);
    },
    Err(_) => {
      return [];
    }
  }
}

function signed(app: App, libs: Lib[], key: ecdsa.PrivateKey): u8[] {
  let entries: Entry[] = [Entry { name: "AndroidManifest.xml", data: manifest(app), deflated: false }];
  for d in dex_files(app) {
    entries = entries.append(Entry { name: d.name, data: d.data, deflated: false });
  }
  if (has_resources(app)) {
    entries = entries.append(Entry { name: "resources.arsc", data: resource_table(app), deflated: false });
  }
  if (app.icon.len() > 0) {
    entries = entries.append(Entry { name: ICON_PATH, data: app.icon, deflated: false });
  }
  if (app.banner.len() > 0) {
    entries = entries.append(Entry { name: BANNER_PATH, data: app.banner, deflated: false });
  }
  for x in xml_files(app) {
    entries = entries.append(Entry { name: x.path, data: androidxml.binary(x.root), deflated: false });
  }
  for a in app.assets {
    entries = entries.append(Entry { name: "assets/" + a.name, data: a.data, deflated: false });
  }
  for l in libs {
    entries = entries.append(Entry { name: "lib/" + l.abi + "/lib" + app.lib + ".so", data: l.image, deflated: app.compress });
  }
  let z = zip(entries);
  let at = z.body.len();
  let digest = content_digest(z.body, z.central, eocd(z.count, z.central.len(), at));
  let block = signing_block(key, certificate(key), digest);
  return util.append_bytes(util.append_bytes(util.append_bytes(z.body, block), z.central), eocd(z.count, z.central.len(), at + block.len()));
}
