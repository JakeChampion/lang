// The APK writer of fern -apk. An APK for a NativeActivity app has a binary
// AndroidManifest.xml, the library of each ABI, and no Java code. An app
// with an icon also has the PNG and a resources.arsc that names it. The zip
// archive has aligned entries and an APK Signature Scheme v2 block with a
// self-signed P-256 certificate.
//
// The libraries are stored by default, and the manifest sets
// extractNativeLibs to false: Android maps each library from the APK, so the
// installed app is the APK alone. With `compress`, the libraries are
// deflated, and Android extracts them at install. Then the APK is smaller,
// but the installed app is the APK and the libraries.
import "std/base64";
import "std/crypto";
import "std/deflate";
import "std/crypto/ecdsa";
import "std/crypto/sha2";
import "std/hash/crc32";
import "std/rand";
import "./util";

// `activity` is the Java class of the activity, and `dex` holds the classes
// of the app, or is empty.
// `permissions` are the full names of the permissions the app uses, and
// `min_sdk` is the lowest API level it runs on. `icon` is the PNG of the
// launcher icon, or is empty. `compress` deflates the libraries. `home`
// makes the activity a home screen, and `assets` go under assets/.
pub struct App { package: string, label: string, lib: string, version_code: i32, version_name: string, activity: string, dex: u8[], permissions: string[], min_sdk: i32, services: Service[], icon: u8[], compress: boolean, cleartext: boolean, debuggable: boolean, home: boolean, assets: Asset[] }

// A service of the app: its Java class, and its foreground service types as
// the flags of android:foregroundServiceType, or 0. A service that only the
// system binds names the permission that the binder needs and the action of
// its intent filter, or has "" for both.
pub struct Service { name: string, types: i32, permission: string, action: string }

// A file of the APK under assets/, which AAssetManager reads.
pub struct Asset { name: string, data: u8[] }

// The permission and the action of a notification listener service.
pub const LISTENER_PERMISSION: string = "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE";

pub const LISTENER_ACTION: string = "android.service.notification.NotificationListenerService";

// The theme of a home screen, Theme.DeviceDefault.Wallpaper.NoTitleBar: the
// status bar shows, and the wallpaper is behind the window, so Android uses
// the transitions of a home screen.
const HOME_THEME: i32 = 16974141;

// The theme of other apps, Theme.NoTitleBar.Fullscreen.
const APP_THEME: i32 = 16973834;

// The flags of android:foregroundServiceType that `permissions` allow: each
// FOREGROUND_SERVICE_<TYPE> permission gives the flag of its type.
pub function foreground_types(permissions: string[]): i32 {
  let names: string[] = ["DATA_SYNC", "MEDIA_PLAYBACK", "PHONE_CALL", "LOCATION", "CONNECTED_DEVICE", "MEDIA_PROJECTION", "CAMERA", "MICROPHONE", "HEALTH", "REMOTE_MESSAGING", "SYSTEM_EXEMPTED"];
  let types = 0;
  for p in permissions {
    let k = util.index_of_str(names, p.replace("android.permission.FOREGROUND_SERVICE_", ""));
    if (p.starts_with("android.permission.FOREGROUND_SERVICE_") && k >= 0) {
      types = types | 1 << k;
    }
  }
  if (util.has_str(permissions, "android.permission.FOREGROUND_SERVICE_SPECIAL_USE")) {
    types = types | 1073741824;
  }
  return types;
}

pub struct Lib { abi: string, image: u8[] }

// The default lowest API level: APK Signature Scheme v2 needs Android 7.0.
pub const MIN_SDK: i32 = 24;

pub const TARGET_SDK: i32 = 34;

// Byte encodings, little-endian.

function put16(out: u8[], v: i32): u8[] {
  return out.append((v & 255) as u8).append((v >> 8 & 255) as u8);
}

function put32(out: u8[], v: i32): u8[] {
  return out.append((v & 255) as u8).append((v >> 8 & 255) as u8).append((v >> 16 & 255) as u8).append((v >> 24 & 255) as u8);
}

function put64(out: u8[], v: i64): u8[] {
  return put32(put32(out, (v & 4294967295i64) as i32), (v >> 32) as i32);
}

function text(s: string): u8[] {
  let out: u8[] = [];
  for i in 0..s.len() {
    out = out.append(s[i]);
  }
  return out;
}

// A field with a 32-bit length in front of it.
function prefixed(b: [u8]): u8[] {
  return util.append_bytes(put32([], b.len()), b);
}

// The binary manifest. The pool starts with the names of the framework
// attributes, in the order of their resource IDs, and the resource map
// gives those IDs. The rest of the pool follows `pool_strings`.

// android:theme, label, icon, name, permission, hasCode, debuggable,
// exported, taskAffinity, clearTaskOnLaunch, stateNotNeeded,
// excludeFromRecents, launchMode,
// configChanges, value, minSdkVersion, versionCode, versionName,
// windowSoftInputMode, targetSdkVersion, resumeWhilePausing,
// extractNativeLibs, usesCleartextTraffic and foregroundServiceType. Android
// finds the attributes of an element by a search in the order of their IDs,
// so each element lists its attributes in that order too.
function attr_ids(): i32[] {
  return [16842752, 16842753, 16842754, 16842755, 16842758, 16842764, 16842767, 16842768, 16842770, 16842773, 16842774, 16842775, 16842781, 16842783, 16842788, 16843276, 16843291, 16843292, 16843307, 16843376, 16843954, 16844010, 16844012, 16844185];
}

const S_THEME: i32 = 0;

const S_LABEL: i32 = 1;

const S_ICON: i32 = 2;

const S_NAME: i32 = 3;

const S_PERMISSION: i32 = 4;

const S_HAS_CODE: i32 = 5;

const S_DEBUGGABLE: i32 = 6;

const S_EXPORTED: i32 = 7;

const S_TASK_AFFINITY: i32 = 8;

const S_CLEAR_TASK: i32 = 9;

const S_STATE_NOT_NEEDED: i32 = 10;

const S_EXCLUDE_RECENTS: i32 = 11;

const S_LAUNCH_MODE: i32 = 12;

const S_CONFIG_CHANGES: i32 = 13;

const S_VALUE: i32 = 14;

const S_MIN_SDK: i32 = 15;

const S_VERSION_CODE: i32 = 16;

const S_VERSION_NAME: i32 = 17;

const S_SOFT_INPUT: i32 = 18;

const S_TARGET_SDK: i32 = 19;

const S_RESUME_WHILE_PAUSING: i32 = 20;

const S_EXTRACT_NATIVE_LIBS: i32 = 21;

const S_CLEARTEXT: i32 = 22;

const S_FOREGROUND_TYPE: i32 = 23;

const S_PREFIX: i32 = 24;

const S_URI: i32 = 25;

const S_PACKAGE: i32 = 26;

function pool_strings(app: App): string[] {
  let out: string[] = [
    "theme", "label", "icon", "name", "permission", "hasCode", "debuggable", "exported", "taskAffinity", "clearTaskOnLaunch", "stateNotNeeded", "excludeFromRecents", "launchMode", "configChanges", "value", "minSdkVersion", "versionCode", "versionName", "windowSoftInputMode", "targetSdkVersion", "resumeWhilePausing", "extractNativeLibs", "usesCleartextTraffic", "foregroundServiceType",
    "android", "http://schemas.android.com/apk/res/android", "package",
    "manifest", "uses-sdk", "application", "activity", "meta-data", "intent-filter", "action", "category", "service",
    app.package, app.label, app.version_name, app.activity, "android.app.lib_name", app.lib,
    "android.intent.action.MAIN", "android.intent.category.LAUNCHER", "uses-permission",
  ];
  for p in app.permissions {
    out = out.append(p);
  }
  for sv in app.services {
    out = out.append(sv.name);
    if (sv.permission.len() > 0) {
      out = out.append(sv.permission).append(sv.action);
    }
  }
  if (app.home) {
    out = out.append("android.intent.category.HOME").append("android.intent.category.DEFAULT").append("");
  }
  return out;
}

// The pool index of `v`. Two equal strings share their first index.
function at(pool: string[], v: string): i32 {
  return util.index_of_str(pool, v);
}

function service_element(out: u8[], line: i32, pool: string[], sv: Service): u8[] {
  let attrs: Attr[] = [attr_str(S_NAME, at(pool, sv.name))];
  if (sv.permission.len() > 0) {
    attrs = attrs.append(attr_str(S_PERMISSION, at(pool, sv.permission)));
  }
  attrs = attrs.append(attr_int(S_EXPORTED, 18, 0));
  if (sv.types != 0) {
    attrs = attrs.append(attr_int(S_FOREGROUND_TYPE, 17, sv.types));
  }
  let tag = at(pool, "service");
  out = start(out, line, tag, attrs);
  if (sv.action.len() > 0) {
    let filter = at(pool, "intent-filter");
    out = start(out, line, filter, []);
    out = end(start(out, line, at(pool, "action"), [attr_str(S_NAME, at(pool, sv.action))]), line, at(pool, "action"));
    out = end(out, line, filter);
  }
  return end(out, line, tag);
}

// The attributes of the activity of a home screen, after its name and before
// its configChanges: one task, which Android does not keep in the recents
// and starts again with no saved state.
function home_activity_attrs(pool: string[]): Attr[] {
  return [attr_str(S_TASK_AFFINITY, at(pool, "")), attr_int(S_CLEAR_TASK, 18, -1), attr_int(S_STATE_NOT_NEEDED, 18, -1), attr_int(S_EXCLUDE_RECENTS, 18, -1), attr_int(S_LAUNCH_MODE, 16, 2)];
}

function category(out: u8[], line: i32, pool: string[], name: string): u8[] {
  return end(start(out, line, at(pool, "category"), [attr_str(S_NAME, at(pool, name))]), line, at(pool, "category"));
}

// The UTF-16 code units of `s`.
function utf16(s: string): i32[] {
  let out: i32[] = [];
  let i = 0;
  while (i < s.len()) {
    let c = s[i] as i32;
    let n = 1;
    if (c >= 240) {
      c = c & 7;
      n = 4;
    } else if (c >= 224) {
      c = c & 15;
      n = 3;
    } else if (c >= 192) {
      c = c & 31;
      n = 2;
    }
    for k in 1..n {
      if (i + k < s.len()) {
        c = c << 6 | s[i + k] as i32 & 63;
      }
    }
    if (c >= 65536) {
      out = out.append(55296 + (c - 65536 >> 10)).append(56320 + (c - 65536 & 1023));
    } else {
      out = out.append(c);
    }
    i += n;
  }
  return out;
}

function string_pool(strings: string[]): u8[] {
  let offs: u8[] = [];
  let data: u8[] = [];
  for s in strings {
    offs = put32(offs, data.len());
    let units = utf16(s);
    data = put16(data, units.len());
    for u in units {
      data = put16(data, u);
    }
    data = put16(data, 0);
  }
  while (data.len() % 4 != 0) {
    data = data.append(0 as u8);
  }
  let head = put16(put16([], 1), 28);
  head = put32(head, 28 + offs.len() + data.len());
  head = put32(put32(put32(put32(put32(head, strings.len()), 0), 0), 28 + offs.len()), 0);
  return util.append_bytes(util.append_bytes(head, offs), data);
}

function resource_map(): u8[] {
  let ids = attr_ids();
  let out = put32(put16(put16([], 384), 8), 8 + 4 * ids.len());
  for id in ids {
    out = put32(out, id);
  }
  return out;
}

struct Attr { android: boolean, name: i32, kind: i32, data: i32 }

function attr_str(name: i32, s: i32): Attr {
  return Attr { android: true, name: name, kind: 3, data: s };
}

function attr_int(name: i32, kind: i32, v: i32): Attr {
  return Attr { android: true, name: name, kind: kind, data: v };
}

function node(out: u8[], kind: i32, size: i32, line: i32): u8[] {
  return put32(put32(put32(put16(put16(out, kind), 16), size), line), -1);
}

function start(out: u8[], line: i32, name: i32, attrs: Attr[]): u8[] {
  out = node(out, 258, 36 + 20 * attrs.len(), line);
  out = put32(put32(out, -1), name);
  out = put16(put16(put16(put16(put16(put16(out, 20), 20), attrs.len()), 0), 0), 0);
  for a in attrs {
    let ns: i32 = -1;
    if (a.android) {
      ns = S_URI;
    }
    let raw: i32 = -1;
    if (a.kind == 3) {
      raw = a.data;
    }
    out = put32(put32(put32(out, ns), a.name), raw);
    out = put32(util.put_u8(util.put_u8(put16(out, 8), 0), a.kind), a.data);
  }
  return out;
}

function end(out: u8[], line: i32, name: i32): u8[] {
  return put32(put32(node(out, 259, 24, line), -1), name);
}

// The binary AndroidManifest.xml of `app`: one NativeActivity that loads
// lib<app.lib>.so, with the launcher intent filter. A home screen also has
// the home categories, so Android offers it as the home app.
pub function manifest(app: App): u8[] {
  let s = pool_strings(app);
  let body = put32(put32(node([], 256, 24, 1), S_PREFIX), S_URI);
  let manifest_tag = at(s, "manifest");
  body = start(body, 1, manifest_tag, [attr_int(S_VERSION_CODE, 16, app.version_code), attr_str(S_VERSION_NAME, at(s, app.version_name)), Attr { android: false, name: S_PACKAGE, kind: 3, data: at(s, app.package) }]);
  let sdk_tag = at(s, "uses-sdk");
  body = end(start(body, 2, sdk_tag, [attr_int(S_MIN_SDK, 16, app.min_sdk), attr_int(S_TARGET_SDK, 16, TARGET_SDK)]), 2, sdk_tag);
  let uses = at(s, "uses-permission");
  for p in app.permissions {
    body = end(start(body, 2, uses, [attr_str(S_NAME, at(s, p))]), 2, uses);
  }
  let has_code = 0;
  if (app.dex.len() > 0) {
    has_code = -1;
  }
  let application = at(s, "application");
  let activity = at(s, "activity");
  let theme = APP_THEME;
  if (app.home) {
    theme = HOME_THEME;
  }
  let app_attrs: Attr[] = [attr_int(S_THEME, 1, theme), attr_str(S_LABEL, at(s, app.label))];
  let activity_attrs: Attr[] = [attr_str(S_LABEL, at(s, app.label))];
  if (app.icon.len() > 0) {
    app_attrs = app_attrs.append(attr_int(S_ICON, 1, ICON_ID));
    activity_attrs = activity_attrs.append(attr_int(S_ICON, 1, ICON_ID));
  }
  let extract = 0;
  if (app.compress) {
    extract = -1;
  }
  app_attrs = app_attrs.append(attr_int(S_HAS_CODE, 18, has_code));
  if (app.debuggable) {
    app_attrs = app_attrs.append(attr_int(S_DEBUGGABLE, 18, -1));
  }
  app_attrs = app_attrs.append(attr_int(S_EXTRACT_NATIVE_LIBS, 18, extract));
  if (app.cleartext) {
    app_attrs = app_attrs.append(attr_int(S_CLEARTEXT, 18, -1));
  }
  body = start(body, 3, application, app_attrs);
  activity_attrs = activity_attrs.append(attr_str(S_NAME, at(s, app.activity))).append(attr_int(S_EXPORTED, 18, -1));
  if (app.home) {
    for a in home_activity_attrs(s) {
      activity_attrs = activity_attrs.append(a);
    }
  }
  // SOFT_INPUT_ADJUST_RESIZE, so the content rectangle leaves out the
  // keyboard.
  activity_attrs = activity_attrs.append(attr_int(S_CONFIG_CHANGES, 17, 1184)).append(attr_int(S_SOFT_INPUT, 17, 16));
  if (app.home) {
    // resumeWhilePausing, so home shows at once.
    activity_attrs = activity_attrs.append(attr_int(S_RESUME_WHILE_PAUSING, 18, -1));
  }
  body = start(body, 4, activity, activity_attrs);
  body = end(start(body, 5, at(s, "meta-data"), [attr_str(S_NAME, at(s, "android.app.lib_name")), attr_str(S_VALUE, at(s, app.lib))]), 5, at(s, "meta-data"));
  body = start(body, 6, at(s, "intent-filter"), []);
  body = end(start(body, 7, at(s, "action"), [attr_str(S_NAME, at(s, "android.intent.action.MAIN"))]), 7, at(s, "action"));
  body = category(body, 8, s, "android.intent.category.LAUNCHER");
  if (app.home) {
    body = category(category(body, 8, s, "android.intent.category.HOME"), 8, s, "android.intent.category.DEFAULT");
  }
  body = end(end(body, 9, at(s, "intent-filter")), 10, activity);
  for sv in app.services {
    body = service_element(body, 11, s, sv);
  }
  body = end(end(body, 11, application), 12, manifest_tag);
  body = put32(put32(node(body, 257, 24, 12), S_PREFIX), S_URI);
  let rest = util.append_bytes(util.append_bytes(string_pool(s), resource_map()), body);
  return util.append_bytes(put32(put16(put16([], 3), 8), 8 + rest.len()), rest);
}

// The resource table of the icon: one package 0x7f with one type,
// "drawable", and one entry, "icon", in the default configuration. Its value
// is the path of the PNG in the archive, so the ID of the icon is
// 0x7f010000.

const ICON_PATH: string = "res/drawable/icon.png";

const ICON_ID: i32 = 2130771968;

// A chunk: its type, the size of its header, and the header and body.
function chunk(kind: i32, header: [u8], body: [u8]): u8[] {
  let out = put32(put16(put16([], kind), 8 + header.len()), 8 + header.len() + body.len());
  return util.append_bytes(util.append_bytes(out, header), body);
}

// The 128 UTF-16 units of a package name, padded with zeros.
function package_name(name: string): u8[] {
  let out: u8[] = [];
  let units = utf16(name);
  for k in 0..128 {
    if (k < units.len()) {
      out = put16(out, units[k]);
    } else {
      out = put16(out, 0);
    }
  }
  return out;
}

function resource_table(package: string): u8[] {
  let types = string_pool(["drawable"]);
  let keys = string_pool(["icon"]);
  let spec = chunk(514, put32(put16(util.put_u8(util.put_u8([], 1), 0), 0), 1), put32([], 0));
  let config: u8[] = put32([], 64);
  while (config.len() < 64) {
    config = config.append(0 as u8);
  }
  let type_header = util.append_bytes(put32(put32(put16(util.put_u8(util.put_u8([], 1), 0), 0), 1), 8 + 12 + config.len() + 4), config);
  let entry = put32(put16(put16([], 8), 0), 0);
  entry = put32(util.put_u8(util.put_u8(put16(entry, 8), 0), 3), 0);
  let type_chunk = chunk(513, type_header, util.append_bytes(put32([], 0), entry));
  let pkg_header = util.append_bytes(put32([], 127), package_name(package));
  pkg_header = put32(put32(put32(put32(put32(pkg_header, 288), 1), 288 + types.len()), 1), 0);
  let pkg = chunk(512, pkg_header, util.append_bytes(util.append_bytes(util.append_bytes(types, keys), spec), type_chunk));
  return chunk(2, put32([], 1), util.append_bytes(string_pool([ICON_PATH]), pkg));
}

// The zip archive. The data of each entry starts at a multiple of its
// alignment: 16384 bytes for a stored library, so that a device with 16 KB
// pages can map it, and 4 bytes for the rest. The 0xd935 extra field holds
// the padding, as zipalign writes it. A deflated entry has method 8.

pub struct Entry { name: string, data: u8[], deflated: boolean }

pub struct Zip { body: u8[], central: u8[], count: i32 }

function align_of(e: Entry): i32 {
  if (e.name.ends_with(".so") && !e.deflated) {
    return 16384;
  }
  return 4;
}

function add_entry(z: Zip, e: Entry): Zip {
  let off = z.body.len();
  let crc = crc32.of(e.data) as i32;
  let align = align_of(e);
  let method = 0;
  let data = e.data;
  if (e.deflated) {
    method = 8;
    data = deflate.deflate(e.data);
  }
  let pad = (align - (off + 36 + e.name.len()) % align) % align;
  let head = put16(put16(put16(put16(put16(put32([], 67324752), 10), 0), method), 0), 33);
  head = put16(put16(put32(put32(put32(head, crc), data.len()), e.data.len()), e.name.len()), 6 + pad);
  head = put16(put16(put16(util.append_bytes(head, text(e.name)), 55605), 2 + pad), align);
  for k in 0..pad {
    head = head.append(0 as u8);
  }
  let cd = put16(put16(put16(put16(put16(put16(put32(z.central, 33639248), 20), 10), 0), method), 0), 33);
  cd = put16(put16(put16(put16(put32(put32(put32(cd, crc), data.len()), e.data.len()), e.name.len()), 0), 0), 0);
  cd = util.append_bytes(put32(put32(put16(cd, 0), 0), off), text(e.name));
  return Zip { body: util.append_bytes(util.append_bytes(z.body, head), data), central: cd, count: z.count + 1 };
}

function slice_bytes(b: [u8], from: i32, to: i32): u8[] {
  let out: u8[] = [];
  for i in from..to {
    out = out.append(b[i]);
  }
  return out;
}

pub function zip(entries: Entry[]): Zip {
  let z = Zip { body: [], central: [], count: 0 };
  for e in entries {
    z = add_entry(z, e);
  }
  return z;
}

// The end of central directory record, for a central directory of `size`
// bytes at `offset`.
pub function eocd(count: i32, size: i32, offset: i32): u8[] {
  return put16(put32(put32(put16(put16(put16(put16(put32([], 101010256), 0), 0), count), count), size), offset), 0);
}

// The DER encoding of the certificate, the key, and the signatures.

function der(tag: i32, content: [u8]): u8[] {
  let out = util.put_u8([], tag);
  let n = content.len();
  if (n < 128) {
    out = util.put_u8(out, n);
  } else if (n < 256) {
    out = util.put_u8(util.put_u8(out, 129), n);
  } else {
    out = util.put_u8(util.put_u8(util.put_u8(out, 130), n >> 8), n);
  }
  return util.append_bytes(out, content);
}

function seq(parts: u8[][]): u8[] {
  let out: u8[] = [];
  for p in parts {
    out = util.append_bytes(out, p);
  }
  return der(48, out);
}

function oid(bytes: u8[]): u8[] {
  return der(6, bytes);
}

function oid_ec_public_key(): u8[] {
  return oid([42 as u8, 134 as u8, 72 as u8, 206 as u8, 61 as u8, 2 as u8, 1 as u8]);
}

function oid_p256(): u8[] {
  return oid([42 as u8, 134 as u8, 72 as u8, 206 as u8, 61 as u8, 3 as u8, 1 as u8, 7 as u8]);
}

function ecdsa_sha256(): u8[] {
  return seq([oid([42 as u8, 134 as u8, 72 as u8, 206 as u8, 61 as u8, 4 as u8, 3 as u8, 2 as u8])]);
}

function bit_string(b: [u8]): u8[] {
  return der(3, util.append_bytes([0 as u8], b));
}

// The SubjectPublicKeyInfo of the P-256 point `point`.
pub function public_key_info(point: [u8]): u8[] {
  return seq([seq([oid_ec_public_key(), oid_p256()]), bit_string(point)]);
}

function name(cn: string): u8[] {
  return seq([der(49, seq([oid([85 as u8, 4 as u8, 3 as u8]), der(12, text(cn))]))]);
}

// A version 1 certificate for `key`, signed by itself. The dates are fixed,
// so the same key gives the same certificate.
pub function certificate(key: ecdsa.PrivateKey): u8[] {
  let point = key.public_point();
  let serial: u8[] = [1 as u8];
  for b in crypto.sha256(point)[0:8] {
    serial = serial.append(b);
  }
  let validity = seq([der(23, text("260101000000Z")), der(24, text("20991231235959Z"))]);
  let tbs = seq([der(2, serial), ecdsa_sha256(), name("Fern"), validity, name("Fern"), public_key_info(point)]);
  return seq([tbs, ecdsa_sha256(), bit_string(sign(key, tbs))]);
}

function sign(key: ecdsa.PrivateKey, msg: [u8]): u8[] {
  match (key.sign(sha2.Sha256, msg)) {
    Ok(sig) => {
      return sig;
    },
    Err(_) => {
      return [];
    }
  }
}

// The PKCS #8 encoding of the P-256 scalar `d`, as a PEM file.
pub function key_pem(d: [u8]): string {
  let point: u8[] = [];
  match (ecdsa.private_key(ecdsa.P256, d)) {
    Ok(key) => {
      point = key.public_point();
    },
    Err(_) => {
      return "";
    }
  }
  let ec = seq([der(2, [1 as u8]), der(4, d), der(161, bit_string(point))]);
  let pk = seq([der(2, [0 as u8]), seq([oid_ec_public_key(), oid_p256()]), der(4, ec)]);
  let b64 = base64.encode(pk);
  let out = "-----BEGIN PRIVATE KEY-----\n";
  let i = 0;
  while (i < b64.len()) {
    let j = i + 64;
    if (j > b64.len()) {
      j = b64.len();
    }
    out = out + slice_unchecked(b64, i, j) + "\n";
    i = j;
  }
  return out + "-----END PRIVATE KEY-----\n";
}

struct Tlv { tag: i32, start: i32, end: i32 }

// The DER element at `at`: its tag and the span of its content.
function tlv(b: [u8], at: i32): Tlv {
  if (at + 2 > b.len()) {
    return Tlv { tag: -1, start: at, end: at };
  }
  let n = b[at + 1] as i32;
  let start = at + 2;
  if (n > 128 && n <= 130) {
    let len = 0;
    for k in 0..n - 128 {
      if (start + k < b.len()) {
        len = len << 8 | b[start + k] as i32;
      }
    }
    start = start + n - 128;
    n = len;
  }
  if (start + n > b.len()) {
    return Tlv { tag: -1, start: at, end: at };
  }
  return Tlv { tag: b[at] as i32, start: start, end: start + n };
}

// The private scalar of a PEM key file: PKCS #8 ("PRIVATE KEY") or SEC 1
// ("EC PRIVATE KEY") for P-256. The result is empty when the file is not
// one of these.
pub function key_scalar(pem: string): u8[] {
  let body = "";
  for line in pem.split("\n") {
    if (line.len() > 0 && !line.starts_with("-----")) {
      body += line;
    }
  }
  match (base64.decode(body)) {
    Ok(raw) => {
      return scalar_of(raw);
    },
    Err(_) => {
      return [];
    }
  }
}

function scalar_of(raw: [u8]): u8[] {
  let top = tlv(raw, 0);
  let version = tlv(raw, top.start);
  let next = tlv(raw, version.end);
  if (top.tag != 48 || version.tag != 2) {
    return [];
  }
  if (next.tag == 4 && next.end - next.start == 32) {
    return slice_bytes(raw, next.start, next.end);
  }
  let wrapped = tlv(raw, next.end);
  if (next.tag != 48 || wrapped.tag != 4) {
    return [];
  }
  return scalar_of(slice_bytes(raw, wrapped.start, wrapped.end));
}

// A new random P-256 scalar.
pub function new_scalar(): u8[] {
  while (true) {
    let d = rand.bytes(32);
    match (ecdsa.private_key(ecdsa.P256, d)) {
      Ok(_) => {
        return d;
      },
      Err(_) => {}
    }
  }
}

// APK Signature Scheme v2. The digest covers the entries, the central
// directory and the end record, in chunks of 1 MiB.

const CHUNK: i32 = 1048576;

function chunk_digests(out: u8[], b: [u8]): (u8[], i32) {
  let n = (b.len() + CHUNK - 1) / CHUNK;
  for k in 0..n {
    let at = k * CHUNK;
    let to = at + CHUNK;
    if (to > b.len()) {
      to = b.len();
    }
    out = util.append_bytes(out, crypto.sha256(util.append_bytes(put32([165 as u8], to - at), b[at:to])));
  }
  return (out, n);
}

// The v2 content digest of the three sections of an unsigned APK.
pub function content_digest(entries: [u8], central: [u8], end_record: [u8]): u8[] {
  let (d1, n1) = chunk_digests([], entries);
  let (d2, n2) = chunk_digests(d1, central);
  let (d3, n3) = chunk_digests(d2, end_record);
  return crypto.sha256(util.append_bytes(put32([90 as u8], n1 + n2 + n3), d3));
}

const ECDSA_SHA256: i32 = 513;

const V2_BLOCK_ID: i32 = 1896449818;

// The APK Signing Block with one v2 signer.
pub function signing_block(key: ecdsa.PrivateKey, cert: [u8], digest: [u8]): u8[] {
  let digests = prefixed(prefixed(util.append_bytes(put32([], ECDSA_SHA256), prefixed(digest))));
  let signed = util.append_bytes(util.append_bytes(digests, prefixed(prefixed(cert))), put32([], 0));
  let sigs = prefixed(prefixed(util.append_bytes(put32([], ECDSA_SHA256), prefixed(sign(key, signed)))));
  let signer = util.append_bytes(util.append_bytes(prefixed(signed), sigs), prefixed(public_key_info(key.public_point())));
  let value = prefixed(prefixed(signer));
  let pair = util.append_bytes(put32(put64([], (4 + value.len()) as i64), V2_BLOCK_ID), value);
  let size = (pair.len() + 24) as i64;
  return util.append_bytes(put64(util.append_bytes(put64([], size), pair), size), text("APK Sig Block 42"));
}

// The signed APK of `app`, with the manifest, then one library for each
// ABI, signed with the P-256 scalar `d`.
pub function write(app: App, libs: Lib[], d: [u8]): u8[] {
  match (ecdsa.private_key(ecdsa.P256, d)) {
    Ok(key) => {
      return signed(app, libs, key);
    },
    Err(_) => {
      return [];
    }
  }
}

function signed(app: App, libs: Lib[], key: ecdsa.PrivateKey): u8[] {
  let entries: Entry[] = [Entry { name: "AndroidManifest.xml", data: manifest(app), deflated: false }];
  if (app.dex.len() > 0) {
    entries = entries.append(Entry { name: "classes.dex", data: app.dex, deflated: false });
  }
  if (app.icon.len() > 0) {
    entries = entries.append(Entry { name: "resources.arsc", data: resource_table(app.package), deflated: false }).append(Entry { name: ICON_PATH, data: app.icon, deflated: false });
  }
  for a in app.assets {
    entries = entries.append(Entry { name: "assets/" + a.name, data: a.data, deflated: false });
  }
  for l in libs {
    entries = entries.append(Entry { name: "lib/" + l.abi + "/lib" + app.lib + ".so", data: l.image, deflated: app.compress });
  }
  let z = zip(entries);
  let at = z.body.len();
  let digest = content_digest(z.body, z.central, eocd(z.count, z.central.len(), at));
  let block = signing_block(key, certificate(key), digest);
  return util.append_bytes(util.append_bytes(util.append_bytes(z.body, block), z.central), eocd(z.count, z.central.len(), at + block.len()));
}
