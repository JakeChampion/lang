import "./ssa";
import "./ssasem";
import "./sourcepos";
import "./semrecords";
import "./typeinfo";
import "./util";

pub function eligible(f: ssasem.Func, ty: typeinfo.Type): boolean {
  let parts: Parts = parts_of(f, ty);
  if (parts.types.len() == 0 || parts.types.len() > 4 || ssasem.has_finalizer(f, ty)) {
    return false;
  }
  for t in parts.types {
    if (!scalar(t)) {
      return false;
    }
  }
  return true;
}

// The fields of a record, or the elements of a tuple the two-word pair
// return cannot carry.
struct Parts { types: typeinfo.Type[], names: string[], tuple: boolean }

function parts_of(f: ssasem.Func, ty: typeinfo.Type): Parts {
  if let typeinfo.TypeTuple(tup) = ty {
    let e: typeinfo.Type[] = tup.elements;
    if (e.len() > 2 || e.len() == 2 && (ssasem.is_wide(e[1]) || ssasem.is_float(e[1]))) {
      return Parts { types: e, names: [], tuple: true };
    }
    return Parts { types: [], names: [], tuple: true };
  }
  let at: i32 = semrecords.find(f.records, ty);
  if (at < 0) {
    return Parts { types: [], names: [], tuple: false };
  }
  let types: typeinfo.Type[] = [];
  let names: string[] = [];
  for field in f.records.list[at].fields {
    types = types.append(field.ty);
    names = names.append(field.name);
  }
  return Parts { types: types, names: names, tuple: false };
}

function part_get(parts: Parts, v: i32, whole: i32, i: i32): ssa.SInst {
  if (parts.tuple) {
    return ssa.SInst { kind_tag: ssasem.tuple_get(), result: v, args: [whole], imm: i, str: "" };
  }
  return ssa.SInst { kind_tag: ssasem.record_get(), result: v, args: [whole], imm: i, str: parts.names[i] };
}

function built(parts: Parts): i32 {
  if (parts.tuple) {
    return ssasem.tuple_new();
  }
  return ssasem.record_new();
}

function scalar(t: typeinfo.Type): boolean {
  return ssasem.is_integer(t) || ssasem.is_bool(t) || ssasem.is_char(t) || ssasem.is_float(t);
}

pub function bits_name(): string {
  return "__scalar_bits";
}

pub function as_name(): string {
  return "__scalar_as";
}

pub function set_prefix(): string {
  return "__scalar_set:";
}

pub function word_prefix(): string {
  return "__scalar_word:";
}

pub function word_type(): typeinfo.Type {
  return typeinfo.TypeI32 { width: 64, unsigned: true, is_char: false, polymorphic: false };
}

function dummy_type(): typeinfo.Type {
  return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: false };
}

function value(f: ssasem.Func, t: typeinfo.Type): ssasem.Func {
  return ssasem.Func { ...f, values: f.values.append(t), graph: ssa.SFunc { ...f.graph, nvals: f.values.len() + 1 } };
}

function contract(f: ssasem.Func, name: string, from: typeinfo.Type, to: typeinfo.Type): ssasem.Func {
  let row: ssasem.Contract = ssasem.Contract { name: name, params: [from], modes: [ssasem.value_mode()], result: to };
  let at: i32 = ssasem.find_contract_in(f.calls, name);
  if (at >= 0) {
    return f;
  }
  return ssasem.Func { ...f, calls: f.calls.append(row) };
}

function conversion(prefix: string, t: typeinfo.Type): string {
  return prefix + ":" + typeinfo.spelling(t);
}

struct Build { f: ssasem.Func, insts: ssa.SInst[], result: i32 }

function call(b: Build, name: string, arg: i32, from: typeinfo.Type, to: typeinfo.Type): Build {
  let v: i32 = b.f.values.len();
  let f: ssasem.Func = contract(value(b.f, to), name, from, to);
  return Build { f: f, result: v, insts: b.insts.append(ssa.SInst { kind_tag: ssasem.call(), result: v, args: [arg], imm: 0, str: name }) };
}

function lower_return(f: ssasem.Func, b: ssa.SBlock, parts: Parts): Build {
  let out: Build = Build { f: f, insts: b.insts, result: 0 - 1 };
  let primary: i32 = 0 - 1;
  for i in 0..parts.types.len() {
    let t: typeinfo.Type = parts.types[i];
    let v: i32 = out.f.values.len();
    out = Build { ...out, f: value(out.f, t), insts: out.insts.append(part_get(parts, v, b.term.value, i)) };
    out = call(out, conversion(bits_name(), t), v, t, word_type());
    if (i == 0) {
      primary = out.result;
    } else {
      out = call(out, set_prefix() + util.i32_to_string(i - 1), out.result, word_type(), dummy_type());
    }
  }
  return Build { ...out, result: primary };
}

pub function callee(f0: ssasem.Func): ssasem.Func {
  let parts: Parts = parts_of(f0, f0.result);
  let f: ssasem.Func = f0;
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      let out: Build = lower_return(f, b, parts);
      let block: ssa.SBlock = ssa.SBlock { ...b, insts: out.insts, term: ssa.STerm { ...b.term, value: out.result } };
      f = ssasem.Func { ...out.f, graph: ssa.SFunc { ...out.f.graph, blocks: out.f.graph.blocks.with(bi, block) } };
    }
    bi = bi + 1;
  }
  return ssasem.Func { ...f, result: word_type() };
}

pub function capture_base(imm: i32): i32 {
  return ssasem.scalar_capture_base(imm);
}

pub function capture_count(imm: i32): i32 {
  return ssasem.scalar_capture_count(imm);
}

function rebuilt(f: ssasem.Func, call_ins: ssa.SInst, parts: Parts): Build {
  let first: i32 = f.values.len();
  let out: Build = Build { f: f, insts: [], result: first };
  for t in parts.types {
    out = Build { ...out, f: value(out.f, word_type()) };
  }
  let count: i32 = parts.types.len() - 1;
  out = Build { ...out, insts: [ssa.SInst { ...call_ins, result: first, imm: 0 - ((first + 1) * 4 + count) }] };
  let args: i32[] = [];
  for i in 0..parts.types.len() {
    let lane: i32 = first + i;
    if (i > 0) {
      let name: string = word_prefix() + util.i32_to_string(i - 1);
      out = Build { ...out, f: contract(out.f, name, word_type(), word_type()), insts: out.insts.append(ssa.SInst { kind_tag: ssasem.call(), result: lane, args: [first], imm: 0, str: name }) };
    }
    out = call(out, conversion(as_name(), parts.types[i]), lane, word_type(), parts.types[i]);
    args = args.append(out.result);
  }
  return Build { ...out, insts: out.insts.append(ssa.SInst { kind_tag: built(parts), result: call_ins.result, args: args, imm: 0, str: "" }) };
}

pub function caller(f: ssasem.Func, bi: i32, k: i32, callee: ssasem.Func): ssasem.Func {
  let b: ssa.SBlock = f.graph.blocks[bi];
  let ins: ssa.SInst = b.insts[k];
  let out: Build = rebuilt(f, ins, parts_of(callee, callee.result));
  let insts: ssa.SInst[] = [];
  let p: i32 = 0;
  while (p < b.insts.len()) {
    if (p == k) {
      insts = util.append_all(insts, out.insts);
    } else {
      insts = insts.append(b.insts[p]);
    }
    p = p + 1;
  }
  let at: i32 = ssasem.find_contract_in(out.f.calls, ins.str);
  let calls: ssasem.Contract[] = out.f.calls.with(at, ssasem.Contract { ...out.f.calls[at], result: word_type() });
  let graph: ssa.SFunc = ssa.SFunc { ...out.f.graph, blocks: out.f.graph.blocks.with(bi, ssa.SBlock { ...b, insts: insts }) };
  return ssasem.Func { ...out.f, calls: calls, graph: graph };
}

pub function donors(f: ssasem.Func, defs: ssa.SInst[], whole0: boolean[]): boolean[] {
  let pending: i32[] = kept_fields(f.graph, whole0);
  if (pending.len() == 0) {
    return whole0;
  }
  let whole: boolean[] = whole0;
  let seen: boolean[] = __alloc_bool(f.values.len());
  let at: i32 = 0;
  while (at < pending.len()) {
    let v: i32 = pending[at];
    at = at + 1;
    if (v < 0 || v >= seen.len() || seen[v]) {
      continue;
    }
    seen = seen.with(v, true);
    if (!ssasem.reference(f.values[v])) {
      continue;
    }
    whole = whole.with(v, true);
    let d: ssa.SInst = defs[v];
    if (donation_edges(d.kind_tag)) {
      for a in d.args {
        pending = pending.append(a);
      }
    }
  }
  return whole;
}

function kept_fields(g: ssa.SFunc, whole: boolean[]): i32[] {
  let out: i32[] = [];
  for b in g.blocks {
    for ins in b.insts {
      if ((ins.kind_tag == ssasem.record_new() || ins.kind_tag == ssasem.tuple_new()) && whole[ins.result]) {
        for a in ins.args {
          out = out.append(a);
        }
      }
    }
  }
  return out;
}

function donation_edges(kind: i32): boolean {
  return kind == 7 || kind == 8 || kind == ssasem.record_new() || kind == ssasem.tuple_new();
}

pub function lanes_of(t: typeinfo.Type): typeinfo.Type[] {
  let parts: typeinfo.Type[] = payload_parts(t);
  if (parts.len() > 3) {
    return [];
  }
  for p in parts {
    if (!scalar(p)) {
      return [];
    }
  }
  return parts;
}

function payload_parts(t: typeinfo.Type): typeinfo.Type[] {
  if (scalar(t)) {
    return [t];
  }
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements;
  }
  return [];
}

pub function variant_in_lanes(e: semrecords.Enum): boolean {
  let boxed: boolean = false;
  for v in e.variants {
    if (v.fields.len() > 1) {
      return false;
    }
    if (v.fields.len() == 1) {
      let t: typeinfo.Type = v.fields[0].ty;
      if (lanes_of(t).len() == 0) {
        return false;
      }
      boxed = boxed || !ssasem.is_integer(t) && !ssasem.is_bool(t) && !ssasem.is_char(t) || ssasem.is_wide(t);
    }
  }
  return boxed;
}

pub struct Lanes { f: ssasem.Func, insts: ssa.SInst[], value: i32 }

pub function set_lanes(f: ssasem.Func, insts: ssa.SInst[], payload: i32, t: typeinfo.Type): Lanes {
  let parts: typeinfo.Type[] = lanes_of(t);
  let out: Build = Build { f: f, insts: insts, result: payload };
  let i: i32 = 0;
  while (i < parts.len()) {
    let part: i32 = payload;
    if (parts.len() > 1 || !scalar(t)) {
      part = out.f.values.len();
      out = Build { ...out, f: value(out.f, parts[i]), insts: out.insts.append(ssa.SInst { kind_tag: ssasem.tuple_get(), result: part, args: [payload], imm: i, str: "" }) };
    }
    out = call(out, conversion(bits_name(), parts[i]), part, parts[i], word_type());
    out = call(out, set_prefix() + util.i32_to_string(i), out.result, word_type(), dummy_type());
    i = i + 1;
  }
  return Lanes { f: out.f, insts: out.insts, value: 0 - 1 };
}

pub function tag_word(f: ssasem.Func, insts: ssa.SInst[], at: i32): Lanes {
  let tag: i32 = f.values.len();
  let out: Build = Build { f: value(f, dummy_type()), insts: insts.append(ssa.SInst { kind_tag: 1, result: tag, args: [], imm: at, str: "" }), result: tag };
  out = call(out, conversion(bits_name(), dummy_type()), tag, dummy_type(), word_type());
  return Lanes { f: out.f, insts: out.insts, value: out.result };
}

pub function word_tag(f: ssasem.Func, insts: ssa.SInst[], w: i32): Lanes {
  let out: Build = call(Build { f: f, insts: insts, result: w }, conversion(as_name(), dummy_type()), w, word_type(), dummy_type());
  return Lanes { f: out.f, insts: out.insts, value: out.result };
}

pub function from_lanes(f: ssasem.Func, insts: ssa.SInst[], words: i32[], t: typeinfo.Type): Lanes {
  let parts: typeinfo.Type[] = lanes_of(t);
  let out: Build = Build { f: f, insts: insts, result: 0 - 1 };
  let args: i32[] = [];
  let i: i32 = 0;
  while (i < parts.len()) {
    out = call(out, conversion(as_name(), parts[i]), words[i], word_type(), parts[i]);
    args = args.append(out.result);
    i = i + 1;
  }
  if (parts.len() == 1 && scalar(t)) {
    return Lanes { f: out.f, insts: out.insts, value: args[0] };
  }
  let v: i32 = out.f.values.len();
  return Lanes { f: value(out.f, t), insts: out.insts.append(ssa.SInst { kind_tag: ssasem.tuple_new(), result: v, args: args, imm: 0, str: "" }), value: v };
}

// lane_set and lane_as move one 64-bit part of a split payload through lane
// k, beside the pair words that carry its other parts.
pub function lane_set(f: ssasem.Func, insts: ssa.SInst[], v: i32, t: typeinfo.Type, k: i32): Lanes {
  let out: Build = call(Build { f: f, insts: insts, result: v }, conversion(bits_name(), t), v, t, word_type());
  out = call(out, set_prefix() + util.i32_to_string(k), out.result, word_type(), dummy_type());
  return Lanes { f: out.f, insts: out.insts, value: 0 - 1 };
}

pub function lane_as(f: ssasem.Func, insts: ssa.SInst[], w: i32, t: typeinfo.Type): Lanes {
  let out: Build = call(Build { f: f, insts: insts, result: w }, conversion(as_name(), t), w, word_type(), t);
  return Lanes { f: out.f, insts: out.insts, value: out.result };
}

pub function lane_word(f: ssasem.Func, insts: ssa.SInst[], w: i32, lane: i32, k: i32): Lanes {
  let name: string = word_prefix() + util.i32_to_string(k);
  let g: ssasem.Func = contract(f, name, word_type(), word_type());
  return Lanes { f: g, insts: insts.append(ssa.SInst { kind_tag: ssasem.call(), result: lane, args: [w], imm: 0, str: name }), value: lane };
}

pub function capture_imm(base: i32, count: i32): i32 {
  return 0 - (base * 4 + count);
}

// The parts a parameter can travel as: the fields of a record of one to four
// scalar fields that no finalizer owns, or for an Option of such a record or
// of a scalar, whether it is Some followed by the payload's parts. Empty when
// the parameter stays whole.
pub function param_parts(f: ssasem.Func, ty: typeinfo.Type): typeinfo.Type[] {
  let payload: typeinfo.Type[] = option_payload(f, ty);
  if (payload.len() == 1) {
    let parts: typeinfo.Type[] = record_parts(f, payload[0]);
    if (scalar(payload[0])) {
      parts = payload;
    }
    if (parts.len() == 0 || parts.len() > 4) {
      return [];
    }
    let out: typeinfo.Type[] = [typeinfo.TypeBool { tag: 0 }];
    return util.append_all(out, parts);
  }
  return record_parts(f, ty);
}

// The Some payload's type of an Option that no finalizer owns, or nothing.
pub function option_payload(f: ssasem.Func, ty: typeinfo.Type): typeinfo.Type[] {
  let at: i32 = semrecords.find_enum(f.enums, ty);
  if (at < 0 || ssasem.has_finalizer(f, ty)) {
    return [];
  }
  let e: semrecords.Enum = f.enums[at];
  if (e.layout != semrecords.layout_option() || e.views) {
    return [];
  }
  for v in e.variants {
    if (v.name == "Some" && v.fields.len() == 1) {
      return [v.fields[0].ty];
    }
  }
  return [];
}

function record_parts(f: ssasem.Func, ty: typeinfo.Type): typeinfo.Type[] {
  let parts: Parts = parts_of(f, ty);
  if (parts.tuple || parts.types.len() == 0 || parts.types.len() > 4 || ssasem.has_finalizer(f, ty)) {
    return [];
  }
  for t in parts.types {
    if (!scalar(t)) {
      return [];
    }
  }
  return parts.types;
}

// The callee taking parameter `p` as its fields: each field read of `p` is a
// copy of that field's parameter, and the values after `p` move up to make
// room for the new parameters.
pub function split_param(f: ssasem.Func, p: i32, types: typeinfo.Type[]): ssasem.Func {
  let payload: typeinfo.Type[] = option_payload(f, f.params[p]);
  let extra: i32 = types.len() - 1;
  let map: i32[] = [];
  for v in 0..f.graph.nvals {
    if (v <= p) {
      map = map.append(v);
    } else {
      map = map.append(v + extra);
    }
  }
  let blocks: ssa.SBlock[] = [];
  for b in f.graph.blocks {
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      if (ins.args.len() == 1 && ins.args[0] == p && ins.kind_tag != 7 && ins.kind_tag != 8 && ins.kind_tag != ssasem.call()) {
        insts = insts.append(read_of_parts(ins, moved(map, ins.result), consecutive(p, types.len()), payload));
        continue;
      }
      insts = insts.append(moved_inst(ins, map, p, extra));
      if (ins.kind_tag == 6 && ins.result == p) {
        for k in 1..types.len() {
          insts = insts.append(ssa.SInst { kind_tag: 6, result: p + k, args: [], imm: ins.imm + k, str: "" });
        }
      }
    }
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts, term: moved_term(b.term, map) });
  }
  let dbg_vals: i32[] = [];
  let dbg_names: string[] = [];
  let dbg_pieces = ssasem.renamed_debug_pieces(f.dbg_pieces, map);
  for i in 0..f.dbg_vals.len() {
    if (f.dbg_vals[i] != p) {
      dbg_vals = dbg_vals.append(moved(map, f.dbg_vals[i]));
      dbg_names = dbg_names.append(f.dbg_names[i]);
    } else {
      dbg_pieces = dbg_pieces.append(ssasem.DebugPieces { name: f.dbg_names[i], ty: f.params[p], values: consecutive(p, types.len()), param: true });
    }
  }
  let graph: ssa.SFunc = ssa.SFunc { ...f.graph, blocks: blocks, nparams: f.graph.nparams + extra, nvals: f.graph.nvals + extra };
  return ssasem.Func {
    ...f,
    graph: graph,
    values: spliced_types(f.values, p, types),
    params: spliced_types(f.params, p, types),
    dbg_vals: dbg_vals,
    dbg_names: dbg_names,
    dbg_pieces: dbg_pieces,
    source_positions: sourcepos.renamed(f.source_positions, map),
  };
}

function consecutive(first: i32, n: i32): i32[] {
  let out: i32[] = [];
  for k in 0..n {
    out = out.append(first + k);
  }
  return out;
}

// One read of a value that travels as `parts`: a field is its part; an
// Option's test is its Some flag; its payload is the part after the flag, or
// a record built of the parts after it.
pub function read_of_parts(ins: ssa.SInst, result: i32, parts: i32[], payload: typeinfo.Type[]): ssa.SInst {
  if (ins.kind_tag == ssasem.variant_is() && ins.str == "None") {
    return ssa.SInst { kind_tag: 10, result: result, args: [parts[0]], imm: 0, str: "!" };
  }
  if (ins.kind_tag == ssasem.variant_is()) {
    return ssa.SInst { kind_tag: 7, result: result, args: [parts[0]], imm: 0, str: "" };
  }
  if (ins.kind_tag == ssasem.variant_get() && payload.len() == 1 && scalar(payload[0])) {
    return ssa.SInst { kind_tag: 7, result: result, args: [parts[1]], imm: 0, str: "" };
  }
  if (ins.kind_tag == ssasem.variant_get()) {
    let fields: i32[] = [];
    for k in 1..parts.len() {
      fields = fields.append(parts[k]);
    }
    return ssa.SInst { kind_tag: ssasem.record_new(), result: result, args: fields, imm: 0, str: "" };
  }
  return ssa.SInst { kind_tag: 7, result: result, args: [parts[ins.imm]], imm: 0, str: "" };
}

function spliced_types(ts: typeinfo.Type[], at: i32, parts: typeinfo.Type[]): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for i in 0..ts.len() {
    if (i == at) {
      out = util.append_all(out, parts);
    } else {
      out = out.append(ts[i]);
    }
  }
  return out;
}

function moved(map: i32[], v: i32): i32 {
  if (v >= 0 && v < map.len()) {
    return map[v];
  }
  return v;
}

function moved_inst(ins: ssa.SInst, map: i32[], p: i32, extra: i32): ssa.SInst {
  let args: i32[] = [];
  for a in ins.args {
    args = args.append(moved(map, a));
  }
  let imm: i32 = ins.imm;
  if (ins.kind_tag == 6 && ins.imm > p) {
    imm = ins.imm + extra;
  }
  let donor: i32 = ssasem.update_base(ins);
  if (donor == p) {
    // A split parameter has no box to update in place; every field is already an argument.
    imm = 0;
  } else if (donor >= 0) {
    imm = moved(map, donor) + 1;
  }
  return ssa.SInst { ...ins, result: moved(map, ins.result), args: args, imm: imm };
}

function moved_term(t: ssa.STerm, map: i32[]): ssa.STerm {
  if (t.kind_tag == 1 && t.value >= 0) {
    return ssa.STerm { ...t, value: moved(map, t.value) };
  }
  if (t.kind_tag == 3) {
    return ssa.STerm { ...t, cond: moved(map, t.cond) };
  }
  return t;
}

// The arguments of a call whose callee, declared with `c`'s parameters,
// takes the parameters marked in `split` as their parts. A record built for
// the call hands on its fields; any other record is read apart ahead of the
// call, in `insts`.
pub struct SplitCall { f: ssasem.Func, insts: ssa.SInst[], call: ssa.SInst }

// Operands already taken apart on a branch: the positions and their parts.
pub struct Given { at: i32[], parts: i32[][] }

pub function no_given(): Given {
  return Given { at: [], parts: [] };
}

pub function split_args(f0: ssasem.Func, ins: ssa.SInst, c: ssasem.Contract, split: boolean[], defs: ssa.SInst[], given: Given): SplitCall {
  let ops: Operands = split_operands(f0, ins, c, split, defs, given);
  let at: i32 = ssasem.find_contract_in(ops.f.calls, ins.str);
  let calls: ssasem.Contract[] = ops.f.calls.with(at, ssasem.Contract { ...ops.f.calls[at], params: ops.params, modes: ops.modes });
  return SplitCall { f: ssasem.Func { ...ops.f, calls: calls }, insts: ops.insts, call: ssa.SInst { ...ins, args: ops.args } };
}

// The operands of `ins`, declared as `c`'s parameters, with those marked in
// `split` as their parts, and the parameters and modes that declares.
pub struct Operands { f: ssasem.Func, insts: ssa.SInst[], args: i32[], params: typeinfo.Type[], modes: i32[] }

pub function split_operands(f0: ssasem.Func, ins: ssa.SInst, c: ssasem.Contract, split: boolean[], defs: ssa.SInst[], given: Given): Operands {
  let f: ssasem.Func = f0;
  let insts: ssa.SInst[] = [];
  let args: i32[] = [];
  let params: typeinfo.Type[] = [];
  let modes: i32[] = [];
  for pos in 0..ins.args.len() {
    let a: i32 = ins.args[pos];
    let mode: i32 = ssasem.value_mode();
    if (pos < c.modes.len()) {
      mode = c.modes[pos];
    }
    if (pos >= split.len() || !split[pos] || pos >= c.params.len()) {
      args = args.append(a);
      if (pos < c.params.len()) {
        params = params.append(c.params[pos]);
      }
      modes = modes.append(mode);
      continue;
    }
    let types: typeinfo.Type[] = param_parts(f, c.params[pos]);
    let payload: typeinfo.Type[] = option_payload(f, c.params[pos]);
    let words: Words = Words { b: Build { f: f, insts: insts, result: 0 - 1 }, args: args };
    let gi: i32 = util.index_of_i32(given.at, pos);
    if (gi >= 0) {
      words = Words { ...words, args: util.append_all(args, given.parts[gi]) };
    } else if (payload.len() == 1) {
      words = option_words(words, a, payload[0], defs);
    } else {
      words = record_words(words, a, c.params[pos], defs);
    }
    f = words.b.f;
    insts = words.b.insts;
    args = words.args;
    for t in types {
      params = params.append(t);
      modes = modes.append(ssasem.value_mode());
    }
  }
  return Operands { f: f, insts: insts, args: args, params: params, modes: modes };
}

struct Words { b: Build, args: i32[] }

function emitted(w: Words, t: typeinfo.Type, ins: ssa.SInst): Words {
  let v: i32 = w.b.f.values.len();
  let b: Build = Build { f: value(w.b.f, t), insts: w.b.insts.append(ssa.SInst { ...ins, result: v }), result: v };
  return Words { b: b, args: w.args.append(v) };
}

// A record's fields: the arguments of a record built for the site, or reads
// of any other record.
function record_words(w0: Words, a: i32, ty: typeinfo.Type, defs: ssa.SInst[]): Words {
  let parts: Parts = parts_of(w0.b.f, ty);
  let d: ssa.SInst = through_copies(defs, a);
  if (d.kind_tag == ssasem.record_new() && d.args.len() == parts.types.len() && ssasem.update_base(d) < 0) {
    return Words { ...w0, args: util.append_all(w0.args, d.args) };
  }
  let w: Words = w0;
  for i in 0..parts.types.len() {
    w = emitted(w, parts.types[i], ssa.SInst { kind_tag: ssasem.record_get(), result: 0, args: [a], imm: i, str: parts.names[i] });
  }
  return w;
}

// An Option's Some flag and payload parts. A Some or a None built for the
// site hands on its parts; any other Option reaching here already travels as
// parts (a split parameter, or a read of a field laid out in place), and the
// rewrite of those turns these reads into its parts.
function option_words(w0: Words, a: i32, payload: typeinfo.Type, defs: ssa.SInst[]): Words {
  let d: ssa.SInst = through_copies(defs, a);
  let w: Words = w0;
  if (d.kind_tag == ssasem.variant_new() && d.str == "None") {
    w = emitted(w, typeinfo.TypeBool { tag: 0 }, ssa.SInst { kind_tag: 2, result: 0, args: [], imm: 0, str: "" });
    let parts: typeinfo.Type[] = [payload];
    if (!scalar(payload)) {
      parts = record_parts(w.b.f, payload);
    }
    for t in parts {
      w = emitted(w, t, ssa.SInst { kind_tag: ssasem.zero(), result: 0, args: [], imm: 0, str: "" });
    }
    return w;
  }
  let inner: i32 = 0 - 1;
  if (d.kind_tag == ssasem.variant_new() && d.args.len() == 1) {
    w = emitted(w, typeinfo.TypeBool { tag: 0 }, ssa.SInst { kind_tag: 2, result: 0, args: [], imm: 1, str: "" });
    inner = d.args[0];
  } else {
    w = emitted(w, typeinfo.TypeBool { tag: 0 }, ssa.SInst { kind_tag: ssasem.variant_is(), result: 0, args: [a], imm: 0, str: "Some" });
    let read: Words = emitted(w, payload, ssa.SInst { kind_tag: ssasem.variant_get(), result: 0, args: [a], imm: 0, str: "Some" });
    inner = read.b.result;
    w = Words { b: read.b, args: w.args };
  }
  if (scalar(payload)) {
    return Words { ...w, args: w.args.append(inner) };
  }
  return record_words(w, inner, payload, defs);
}

// Whether an Option operand needs a branch to be taken apart: it is neither
// built for the site nor among `own`, the values already travelling as parts.
pub function needs_branch(f: ssasem.Func, defs: ssa.SInst[], ty: typeinfo.Type, a: i32, own: boolean[]): boolean {
  if (option_payload(f, ty).len() == 0) {
    return false;
  }
  if (through_copies(defs, a).kind_tag == ssasem.variant_new()) {
    return false;
  }
  return !(a >= 0 && a < own.len() && own[a]);
}

// The parts of an Option `a` read on a branch on whether it is Some: `head`
// ends the block the site was in, `some` reads the payload, `none` makes
// zeros, and `joins` brings the fields together where the site now is.
pub struct Branch { f: ssasem.Func, head: ssa.SInst[], flag: i32, some: ssa.SInst[], none: ssa.SInst[], joins: ssa.SInst[], parts: i32[] }

pub function branch_parts(f0: ssasem.Func, a: i32, ty: typeinfo.Type): Branch {
  let payload: typeinfo.Type = option_payload(f0, ty)[0];
  let w: Words = emitted(Words { b: Build { f: f0, insts: [], result: 0 - 1 }, args: [] }, typeinfo.TypeBool { tag: 0 }, ssa.SInst { kind_tag: ssasem.variant_is(), result: 0, args: [a], imm: 0, str: "Some" });
  let flag: i32 = w.b.result;
  let head: ssa.SInst[] = w.b.insts;
  let read: Words = emitted(Words { b: Build { f: w.b.f, insts: [], result: 0 - 1 }, args: [] }, payload, ssa.SInst { kind_tag: ssasem.variant_get(), result: 0, args: [a], imm: 0, str: "Some" });
  let some: Words = Words { b: read.b, args: [read.b.result] };
  if (!scalar(payload)) {
    some = record_words(Words { b: read.b, args: [] }, read.b.result, payload, []);
  }
  let none: Words = Words { b: Build { f: some.b.f, insts: [], result: 0 - 1 }, args: [] };
  for v in some.args {
    none = emitted(none, none.b.f.values[v], ssa.SInst { kind_tag: ssasem.zero(), result: 0, args: [], imm: 0, str: "" });
  }
  let f: ssasem.Func = none.b.f;
  let joins: ssa.SInst[] = [];
  let parts: i32[] = [flag];
  for i in 0..some.args.len() {
    let v: i32 = f.values.len();
    f = value(f, f.values[some.args[i]]);
    joins = joins.append(ssa.SInst { kind_tag: 8, result: v, args: [some.args[i], none.args[i]], imm: 0, str: "" });
    parts = parts.append(v);
  }
  return Branch { f: f, head: head, flag: flag, some: some.b.insts, none: none.b.insts, joins: joins, parts: parts };
}

// The instruction defining `v`, seen through copies.
pub function through_copies(defs: ssa.SInst[], v: i32): ssa.SInst {
  let x: i32 = v;
  let steps: i32 = 0;
  while (x >= 0 && x < defs.len() && steps < 64) {
    let d: ssa.SInst = defs[x];
    if (d.kind_tag != 7 || d.args.len() != 1) {
      return d;
    }
    x = d.args[0];
    steps = steps + 1;
  }
  return ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
}
