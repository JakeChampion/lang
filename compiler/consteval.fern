import "./ast";
import "./parser";
import "./util";

// Values stay separate from the source AST so diagnostics retain literal positions.
pub struct IntValue { value: i64 }

pub struct FloatValue { value: f64 }

pub struct BoolValue { value: boolean }

pub struct StringValue { value: string }

pub struct Aggregate {  }

pub type Scalar = IntValue | FloatValue | BoolValue | StringValue | Aggregate;

// A definite error is reported at once. Any other error waits for the type
// check, because an ill-typed initializer is a type error.
// size is the number of scalars in the value: 1 for a scalar, and the sum of
// the elements for an aggregate. code is the code of a definite error that is
// not E093.
pub struct Value { data: Scalar, error: string, definite: boolean, size: i32, code: string }

function empty(): Value {
  return Value { data: Aggregate {  }, error: "", definite: false, size: 1, code: "" };
}

function fail(message: string): Value {
  return Value { ...empty(), error: message };
}

function refuse(message: string): Value {
  return Value { ...empty(), error: message, definite: true };
}

// E047: a step of a constant expression leaves the declared type.
function leaves(step: string, ty: string): Value {
  return Value { ...refuse(step + " does not fit in " + ty), code: "E047" };
}

// The code of the definite error of v.
pub function error_code(v: Value): string {
  if (v.code.len() > 0) {
    return v.code;
  }
  return "E093";
}

const DEFERRED: string = "reads a const that did not fold";

// The value later initializers read for a const: an error defers them as well.
pub function held(v: Value): Value {
  if (v.error.len() > 0) {
    return fail(DEFERRED);
  }
  return v;
}

pub function reads_deferred(v: Value): boolean {
  return v.error == DEFERRED;
}

function first_error(a: Value, b: Value): Value {
  if (a.error.len() > 0 && (a.definite || !b.definite)) {
    return a;
  }
  return b;
}

function number(v: i64, ty: string): Value {
  let n = v;
  if (ty == "i32") {
    n = (v as i32) as i64;
  }
  if (ty == "u32") {
    n = (v as u32) as i64;
  }
  if (ty == "u8") {
    n = (v as u8) as i64;
  }
  return Value { ...empty(), data: IntValue { value: n } };
}

function floating(v: f64): Value {
  return Value { ...empty(), data: FloatValue { value: v } };
}

function logical(v: boolean): Value {
  return Value { ...empty(), data: BoolValue { value: v } };
}

function unsigned(ty: string): boolean {
  return ty == "u8" || ty == "u32" || ty == "u64";
}

const I64_MIN: i64 = -9223372036854775808;

const I64_MAX: i64 = 9223372036854775807;

// The bits of a declared integer type of a known width, or 0.
function width_bits(ty: string): i64 {
  if (ty == "u8") {
    return 8;
  }
  if (ty == "i32" || ty == "u32") {
    return 32;
  }
  if (ty == "i64" || ty == "u64") {
    return 64;
  }
  return 0;
}

// True when the type holds v. A value of 64 bits is its bit pattern.
function holds(v: i64, ty: string): boolean {
  if (ty == "u8") {
    return v >= 0 && v <= 255;
  }
  if (ty == "i32") {
    return v >= -2147483648i64 && v <= 2147483647i64;
  }
  if (ty == "u32") {
    return v >= 0 && v <= 4294967295i64;
  }
  return true;
}

// An operand of the type, as the diagnostic shows it.
function shown(v: i64, ty: string): string {
  if (ty == "u64") {
    return (v as u64).to_string();
  }
  return util.i64_to_string(v);
}

// True when the exact sum, difference, product, quotient or left shift of two
// values of the type is outside the type. The operands of a narrow type are
// in the type, so their result does not wrap in 64 bits.
function step_leaves(op: string, a: i64, b: i64, ty: string): boolean {
  if (ty == "u64") {
    return u64_step_leaves(op, a, b);
  }
  if (ty == "i64") {
    return i64_step_leaves(op, a, b);
  }
  if (ty == "u32" && op == "*") {
    return a as u64 * (b as u64) > 4294967295u64;
  }
  return narrow_step_leaves(op, a, b, ty);
}

function u64_step_leaves(op: string, a: i64, b: i64): boolean {
  return match (op) {
    "+" => (a + b) as u64 < a as u64,
    "-" => a as u64 < b as u64,
    "*" => a != 0 && (a * b) as u64 / (a as u64) != b as u64,
    "<<" => (a << b) as u64 >> b as u64 != a as u64,
    _ => false,
  };
}

function i64_step_leaves(op: string, a: i64, b: i64): boolean {
  return match (op) {
    "+" => i64_sum_leaves(a, b),
    "-" => i64_difference_leaves(a, b),
    "*" => i64_product_leaves(a, b),
    "/" => a == I64_MIN && b == -1i64,
    "<<" => a << b >> b != a,
    _ => false,
  };
}

function i64_sum_leaves(a: i64, b: i64): boolean {
  return b > 0 && a > I64_MAX - b || b < 0 && a < I64_MIN - b;
}

function i64_difference_leaves(a: i64, b: i64): boolean {
  return b < 0 && a > I64_MAX + b || b > 0 && a < I64_MIN + b;
}

function i64_product_leaves(a: i64, b: i64): boolean {
  if (a == 0 || b == 0) {
    return false;
  }
  return a == -1i64 && b == I64_MIN || b == -1i64 && a == I64_MIN || a * b / b != a;
}

function narrow_step_leaves(op: string, a: i64, b: i64, ty: string): boolean {
  return match (op) {
    "+" => !holds(a + b, ty),
    "-" => !holds(a - b, ty),
    "*" => !holds(a * b, ty),
    "/" => !holds(a / b, ty),
    "<<" => !holds(a << b, ty),
    _ => false,
  };
}

// The E047 of a step that leaves the declared type, or None. An operand
// outside the type is a literal that the literal range rule reports.
// E047 for a shift by a count that is not less than the bits of `ty`.
function shift_refusal(op: string, b: i64, bits: i64, ty: string): Option[Value] {
  if ((op == "<<" || op == ">>") && (b < 0 || b >= bits)) {
    return Some(Value { ...refuse("shift count " + util.i64_to_string(b) + " is not less than the " + util.i64_to_string(bits) + " bits of " + ty), code: "E047" });
  }
  return None;
}

function checked_step(op: string, a: i64, b: i64, ty: string): Option[Value] {
  let bits = width_bits(ty);
  if (bits == 0 || !holds(a, ty) || !holds(b, ty)) {
    return None;
  }
  if let Some(refused) = shift_refusal(op, b, bits, ty) {
    return Some(refused);
  }
  if (op == "/" && b == 0 || !step_leaves(op, a, b, ty)) {
    return None;
  }
  return Some(leaves(shown(a, ty) + " " + op + " " + shown(b, ty), ty));
}

function integer_binary(op: string, a: i64, b: i64, ty: string): Value {
  if let Some(refused) = checked_step(op, a, b, ty) {
    return refused;
  }
  if (op == "+") {
    return number(a + b, ty);
  }
  if (op == "-") {
    return number(a - b, ty);
  }
  if (op == "*") {
    return number(a * b, ty);
  }
  if (op == "/" || op == "%") {
    return divide(op, a, b, ty);
  }
  return bitwise(op, a, b, ty);
}

function divide(op: string, a: i64, b: i64, ty: string): Value {
  if (b == 0) {
    if (op == "/") {
      return refuse("division by zero in constant expression");
    }
    return refuse("modulo by zero in constant expression");
  }
  if (unsigned(ty)) {
    if (op == "/") {
      return number((a as u64 / (b as u64)) as i64, ty);
    }
    return number((a as u64 % (b as u64)) as i64, ty);
  }
  // Hardware signed division traps on MIN / -1; Fern constant arithmetic wraps.
  if (a == 0 - 9223372036854775807i64 - 1i64 && b == -1i64) {
    if (op == "/") {
      return number(a, ty);
    }
    return number(0, ty);
  }
  if (op == "/") {
    return number(a / b, ty);
  }
  return number(a % b, ty);
}

function bitwise(op: string, a: i64, b: i64, ty: string): Value {
  if (op == "&") {
    return number(a & b, ty);
  }
  if (op == "|") {
    return number(a | b, ty);
  }
  if (op == "^") {
    return number(a ^ b, ty);
  }
  let mask: i64 = 63;
  if (ty == "i32" || ty == "u32" || ty == "u8") {
    mask = 31;
  }
  let shift = b & mask;
  if (op == "<<") {
    return number(a << shift, ty);
  }
  if (op == ">>") {
    if (unsigned(ty)) {
      return number((a as u64 >> shift as u64) as i64, ty);
    }
    return number(a >> shift, ty);
  }
  return integer_compare(op, a, b, ty);
}

function integer_compare(op: string, a: i64, b: i64, ty: string): Value {
  if (op == "==") {
    return logical(a == b);
  }
  if (op == "!=") {
    return logical(a != b);
  }
  if (unsigned(ty)) {
    return unsigned_compare(op, a as u64, b as u64);
  }
  return match (op) {
    "<" => logical(a < b),
    "<=" => logical(a <= b),
    ">" => logical(a > b),
    ">=" => logical(a >= b),
    _ => fail("operator `" + op + "` not allowed in integer constant expressions"),
  };
}

function unsigned_compare(op: string, a: u64, b: u64): Value {
  return match (op) {
    "<" => logical(a < b),
    "<=" => logical(a <= b),
    ">" => logical(a > b),
    ">=" => logical(a >= b),
    _ => fail("operator `" + op + "` not allowed in integer constant expressions"),
  };
}

function float_binary(op: string, a: f64, b: f64): Value {
  return match (op) {
    "+" => floating(a + b),
    "-" => floating(a - b),
    "*" => floating(a * b),
    "/" => floating(a / b),
    _ => float_compare(op, a, b),
  };
}

function float_compare(op: string, a: f64, b: f64): Value {
  return match (op) {
    "==" => logical(a == b),
    "!=" => logical(a != b),
    "<" => logical(a < b),
    "<=" => logical(a <= b),
    ">" => logical(a > b),
    ">=" => logical(a >= b),
    _ => fail("operator `" + op + "` not allowed in float constant expressions"),
  };
}

function bool_binary(op: string, a: boolean, b: boolean): Value {
  return match (op) {
    "&&" => logical(a && b),
    "||" => logical(a || b),
    "==" => logical(a == b),
    "!=" => logical(a != b),
    _ => fail("operator `" + op + "` not allowed on bools in constant expressions"),
  };
}

// The limit of a string that a constant expression makes. A chain of consts
// that each join the one before with itself doubles the string at each step.
pub const MAX_CONST_STRING: i32 = 1048576;

// The limit of the scalars in an aggregate that a constant expression makes.
// A chain of consts that each hold the one before two times doubles the
// aggregate at each step.
pub const MAX_CONST_ELEMENTS: i32 = 1048576;

function joined(a: string, b: string): Value {
  if (a.len() + b.len() > MAX_CONST_STRING) {
    return refuse("string of more than " + util.i32_to_string(MAX_CONST_STRING) + " bytes in constant expression");
  }
  return Value { ...empty(), data: StringValue { value: a + b } };
}

function string_binary(op: string, a: string, b: string): Value {
  return match (op) {
    "+" => joined(a, b),
    "==" => logical(a == b),
    "!=" => logical(a != b),
    "<" => logical(a < b),
    "<=" => logical(a <= b),
    ">" => logical(a > b),
    ">=" => logical(a >= b),
    _ => fail("operator `" + op + "` not allowed on strings in constant expressions"),
  };
}

function binary(op: string, a: Value, b: Value, ty: string): Value {
  if (a.error.len() > 0 || b.error.len() > 0) {
    return first_error(a, b);
  }
  return binary_values(op, a.data, b.data, ty);
}

function binary_values(op: string, left: Scalar, right: Scalar, ty: string): Value {
  match (left) {
    StringValue(s) => {
      if let StringValue(t) = right {
        return string_binary(op, s.value, t.value);
      }
      return fail("binary `" + op + "` between string and non-string is not a constant expression");
    },
    BoolValue(s) => {
      if let BoolValue(t) = right {
        return bool_binary(op, s.value, t.value);
      }
      return fail("binary `" + op + "` between bool and non-bool is not a constant expression");
    },
    FloatValue(s) => {
      if let FloatValue(t) = right {
        return float_binary(op, s.value, t.value);
      }
      return fail("binary `" + op + "` mixes float with non-float; conversions must be explicit even in constants");
    },
    IntValue(s) => {
      if let IntValue(t) = right {
        return integer_binary(op, s.value, t.value, ty);
      }
      return fail("binary `" + op + "` operands aren't both numbers");
    },
    Aggregate(_) => {
      return fail("binary `" + op + "` operands aren't both numbers");
    }
  }
}

// The E047 of a negation that leaves the declared type, or None.
function checked_negate(v: Value, ty: string): Option[Value] {
  if (v.error.len() > 0 || width_bits(ty) == 0) {
    return None;
  }
  let IntValue(n) = v.data else {
    return None;
  };
  let out = !holds(n.value, ty) || !holds(0 - n.value, ty);
  if (ty == "u64") {
    out = n.value != 0;
  }
  if (ty == "i64") {
    out = n.value == I64_MIN;
  }
  if (!out || !holds(n.value, ty)) {
    return None;
  }
  return Some(leaves("-(" + shown(n.value, ty) + ")", ty));
}

function unary(op: string, v: Value, ty: string): Value {
  if (v.error.len() > 0) {
    return v;
  }
  if (op == "-") {
    if let IntValue(n) = v.data {
      return number(0 - n.value, ty);
    }
    if let FloatValue(n) = v.data {
      return floating(-n.value);
    }
    return fail("unary `-` requires a number or float operand");
  }
  if (op == "!") {
    if let BoolValue(b) = v.data {
      return logical(!b.value);
    }
    return fail("unary `!` requires a boolean operand");
  }
  if (op == "~") {
    if let IntValue(n) = v.data {
      return number(n.value ^ -1i64, ty);
    }
    return fail("unary `~` requires an integer operand");
  }
  return fail("unary operator \"" + op + "\" is not allowed in constant expressions");
}

function element_type(ty: parser.TypeRef, tuple: boolean, i: i32): parser.TypeRef {
  let elem = parser.parse_type_ref("");
  if (tuple && ty.is_tuple && i < ty.args.len()) {
    elem = ty.args[i];
  }
  if (!tuple && ty.array_depth > 0) {
    elem = parser.TypeRef { ...ty, array_depth: ty.array_depth - 1 };
  }
  return elem;
}

function elements(elems: ast.Expr[], ty: parser.TypeRef, names: string[], values: Value[], tuple: boolean): Value {
  let out = empty();
  let total = 0;
  for i in 0..elems.len() {
    let elem = element_type(ty, tuple, i);
    let v = evaluate(elems[i], elem, names, values);
    if (v.error.len() == 0 && elem.array_depth == 0 && !elem.is_tuple) {
      v = settle(v, elem.base);
    }
    if (v.error.len() > 0) {
      out = first_error(out, v);
    }
    total += v.size;
    if (total > MAX_CONST_ELEMENTS) {
      return refuse("aggregate of more than " + util.i32_to_string(MAX_CONST_ELEMENTS) + " elements in constant expression");
    }
  }
  return Value { ...out, size: total };
}

pub function evaluate(e: ast.Expr, ty: parser.TypeRef, names: string[], values: Value[]): Value {
  let width = scalar_width(ty);
  match (e) {
    ast.ExprNumber(n) => {
      return literal_number(n);
    },
    ast.ExprBool(b) => {
      return logical(b.value);
    },
    ast.ExprString(s) => {
      return Value { ...empty(), data: StringValue { value: s.value } };
    },
    ast.ExprIdent(id) => {
      return earlier_value(id.name, names, values);
    },
    ast.ExprUnary(u) => {
      return evaluate_unary(u, ty, names, values, width);
    },
    ast.ExprBinary(b) => {
      return evaluate_binary(b, ty, names, values);
    },
    ast.ExprArray(a) => {
      return elements(a.elements, ty, names, values, false);
    },
    ast.ExprTuple(t) => {
      return elements(t.elements, ty, names, values, true);
    },
    ast.ExprStructLit(s) => {
      return elements(s.field_values, parser.parse_type_ref(""), names, values, false);
    },
    _ => {
      return empty();
    }
  }
}

function evaluate_unary(u: ast.ExprUnary, ty: parser.TypeRef, names: string[], values: Value[], width: string): Value {
  let operand = evaluate(u.operand, ty, names, values);
  // The literal range rule judges a negated literal.
  if (u.op == "-" && !is_number(u.operand)) {
    if let Some(refused) = checked_negate(operand, width) {
      return refused;
    }
  }
  return unary(u.op, operand, width);
}

function is_number(e: ast.Expr): boolean {
  if let ast.ExprNumber(_) = e {
    return true;
  }
  return false;
}

pub function settle(v: Value, ty: string): Value {
  if (v.error.len() > 0) {
    return v;
  }
  if let IntValue(n) = v.data {
    if (ty == "f32" || ty == "f64") {
      return fail("declared type " + ty + " does not match initialiser type i32");
    }
    return number(n.value, ty);
  }
  if let FloatValue(n) = v.data {
    if (integer_type(ty)) {
      return fail("declared type " + ty + " does not match initialiser type f64");
    }
  }
  return v;
}

function integer_type(ty: string): boolean {
  return ty == "i32" || ty == "i64" || ty == "u8" || ty == "u32" || ty == "u64" || ty == "usize";
}

function scalar_width(ty: parser.TypeRef): string {
  let width = "";
  if (ty.array_depth == 0 && !ty.is_tuple) {
    width = ty.base;
  }
  return width;
}

function literal_number(n: ast.ExprNumber): Value {
  if (parser.float_settled_int(n)) {
    return floating((util.lit_to_i64(n.text) as u64) as f64);
  }
  if (n.is_float) {
    // The oracle retains f64 precision while it evaluates constant expressions.
    return floating(f64_from_bits(n.bits));
  }
  // Literal truncation occurs at operators, matching the Go constant folder.
  return number(util.lit_to_i64(n.text), "");
}

function earlier_value(name: string, names: string[], values: Value[]): Value {
  let i = util.index_of_str(names, name);
  if (i >= 0) {
    return values[i];
  }
  return refuse("\"" + name + "\" is not a constant (must reference an earlier `const` declaration)");
}

function evaluate_binary(b: ast.ExprBinary, ty: parser.TypeRef, names: string[], values: Value[]): Value {
  let left = evaluate(b.left, ty, names, values);
  let right = evaluate(b.right, ty, names, values);
  if let FloatValue(_) = left.data {
    right = beside_float(b.right, right, names, values);
  } else if let FloatValue(_) = right.data {
    left = beside_float(b.left, left, names, values);
  }
  return binary(b.op, left, right, scalar_width(ty));
}

// An integer-literal operand of a float is a float, as the checker settles it.
function beside_float(e: ast.Expr, v: Value, names: string[], values: Value[]): Value {
  if (ast.is_unsettled_int_literal(e)) {
    return evaluate(parser.settle_to_name(e, "f64"), parser.parse_type_ref("f64"), names, values);
  }
  return v;
}
