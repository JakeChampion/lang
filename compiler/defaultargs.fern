import "./ast";
import "./astwalk";
import "./parser";
import "./util";
import "std/option";

function module_has_default_params(mod: parser.Module): boolean {
  for fi in 0..mod.funcs.len() {
    let ps = mod.funcs[fi].params;
    for pi in 0..ps.len() {
      if (ps[pi].has_default) {
        return true;
      }
    }
  }
  return false;
}

// The functions with no receiver, by name. The first function of a name is
// the one that a call of the name means.
pub struct FreeFuncs { funcs: parser.FuncDecl[], names: util.NameIndex, at: i32[] }

pub function free_funcs(funcs: parser.FuncDecl[]): FreeFuncs {
  let names: string[] = [];
  let at: i32[] = [];
  for i in 0..funcs.len() {
    if (funcs[i].receiver_type.len() == 0) {
      names = names.append(funcs[i].name);
      at = at.append(i);
    }
  }
  return FreeFuncs { funcs: funcs, names: util.name_index(names), at: at };
}

function (ff: FreeFuncs) params_of(name: string): ast.ParamDecl[] {
  let k = ff.names.find(name);
  if (k < 0) {
    let none: ast.ParamDecl[] = [];
    return none;
  }
  return ff.funcs[ff.at[k]].params;
}

function fda_args_have_named(args: ast.Expr[]): boolean {
  for i in 0..args.len() {
    if (parser.is_named_marker(args[i])) {
      return true;
    }
  }
  return false;
}

function fda_named_lookup(names: string[], vals: ast.Expr[], want: string): i32 {
  for i in 0..names.len() {
    if (names[i] == want) {
      return i;
    }
  }
  return -1;
}

function fda_resolve_named(params: ast.ParamDecl[], args: ast.Expr[]): ast.Expr[] {
  let posvals: ast.Expr[] = [];
  let nnames: string[] = [];
  let nvals: ast.Expr[] = [];
  for i in 0..args.len() {
    if (parser.is_named_marker(args[i])) {
      nnames = nnames.append(parser.named_marker_name(args[i]));
      nvals = nvals.append(parser.named_marker_value(args[i]));
    } else {
      posvals = posvals.append(args[i]);
    }
  }
  let out: ast.Expr[] = [];
  for pi in 0..params.len() {
    if (pi < posvals.len()) {
      out = out.append(posvals[pi]);
    } else {
      let ni = fda_named_lookup(nnames, nvals, params[pi].name);
      if (ni >= 0) {
        out = out.append(nvals[ni]);
      } else {
        out = out.append(params[pi].default_value);
      }
    }
  }
  for j in params.len()..posvals.len() {
    out = out.append(posvals[j]);
  }
  return out;
}

function fda_named_count_of(e: ast.Expr, own acc: i32): i32 {
  if (parser.is_named_marker(e)) {
    return acc + 1;
  }
  return acc;
}

function stmts_have_named(stmts: ast.Stmt[]): boolean {
  let n = 0;
  for st in stmts {
    n = astwalk.fold_stmt(st, n, fda_named_count_of);
  }
  return n > 0;
}

function module_has_named_args(mod: parser.Module): boolean {
  for fi in 0..mod.funcs.len() {
    if (stmts_have_named(mod.funcs[fi].body)) {
      return true;
    }
  }
  return stmts_have_named(mod.top_stmts);
}

pub function needed(mod: parser.Module): boolean {
  return module_has_default_params(mod) || module_has_named_args(mod);
}

function fda_call_of(c: ast.ExprCall, funcs: FreeFuncs): ast.Expr {
  let new_args = c.args;
  match (c.callee) {
    ast.ExprIdent(id) => {
      let params = funcs.params_of(id.name);
      if (fda_args_have_named(new_args)) {
        new_args = fda_resolve_named(params, new_args);
      } else if (params.len() > new_args.len()) {
        let ok = true;
        for k in new_args.len()..params.len() {
          if (!params[k].has_default) {
            ok = false;
          }
        }
        if (ok) {
          for j in new_args.len()..params.len() {
            new_args = new_args.append(params[j].default_value);
          }
        }
      }
    },
    _ => {}
  }
  return ast.ExprCall { ...c, args: new_args };
}

struct FdaWalk { funcs: FreeFuncs, local: string[], diags: util.Diag[] }

function fda_bind(w: FdaWalk, packed: string): FdaWalk {
  let local = w.local;
  for name in astwalk.append_bound_name([], packed) {
    local = local.append(name);
  }
  return FdaWalk { ...w, local: local };
}

function fda_bind_params(w: FdaWalk, ps: ast.ParamDecl[]): FdaWalk {
  for p in ps {
    w = fda_bind(w, p.name);
  }
  return w;
}

function fda_leave(inner: FdaWalk, outer: FdaWalk): FdaWalk {
  return FdaWalk { ...inner, local: outer.local };
}

function fda_expr(e: ast.Expr, w: FdaWalk): (ast.Expr, FdaWalk) {
  let (out, tail, handled) = astwalk.map_expr_where(e, w, fda_stmt_at, fda_expr_at, astwalk.descend_all);
  return (out, tail);
}

function fda_body(stmts: ast.Stmt[], w: FdaWalk): (ast.Stmt[], FdaWalk) {
  return astwalk.map_stmts_where(stmts, w, fda_stmt_at, fda_expr_at, astwalk.descend_all);
}

function fda_call(c: ast.ExprCall, w: FdaWalk): (ast.Expr, FdaWalk) {
  if (fda_args_have_named(c.args)) {
    let (code, msg) = fda_call_error(c, w.funcs, w.local);
    if (code.len() > 0) {
      return (c, FdaWalk { ...w, diags: w.diags.append(util.Diag { related: [], length: 0, code: code, message: msg, line: c.line, col: c.col, fix: None }) });
    }
  }
  if let ast.ExprIdent(id) = c.callee {
    if (util.has_str(w.local, id.name)) {
      return (c, w);
    }
  }
  return (fda_call_of(c, w.funcs), w);
}

function fda_expr_at(e: ast.Expr, w: FdaWalk): (ast.Expr, FdaWalk, boolean) {
  match (e) {
    ast.ExprCall(c) => {
      let args: ast.Expr[] = [];
      for arg in c.args {
        let (na, aw) = fda_expr(arg, w);
        args = args.append(na);
        w = aw;
      }
      let (callee, cw) = fda_expr(c.callee, w);
      let (out, tail) = fda_call(ast.ExprCall { ...c, callee: callee, args: args }, cw);
      return (out, tail, true);
    },
    ast.ExprLambda(lm) => {
      let (bs, tail) = fda_body(lm.body, fda_bind_params(w, lm.params));
      return (ast.ExprLambda { ...lm, body: bs }, fda_leave(tail, w), true);
    },
    _ => {
      return (e, w, false);
    }
  }
}

function fda_stmt_at(st: ast.Stmt, w: FdaWalk): (ast.Stmt, FdaWalk, boolean) {
  match (st) {
    ast.StmtVar(v) => {
      let recursive = ast.var_binds_itself(v);
      let before = w;
      if (recursive) {
        before = fda_bind(w, v.name);
      }
      let (init, tail) = fda_expr(v.init, before);
      if (!recursive) {
        tail = fda_bind(tail, v.name);
      }
      return (ast.StmtVar { ...v, init: init }, tail, true);
    },
    ast.StmtIf(f) => {
      let (cond, cw) = fda_expr(f.cond, w);
      let (tb, tw) = fda_body(f.then_body, cw);
      let (eb, ew) = fda_body(f.else_body, fda_leave(tw, cw));
      return (ast.StmtIf { ...f, cond: cond, then_body: tb, else_body: eb }, fda_leave(ew, w), true);
    },
    ast.StmtWhile(wh) => {
      let (cond, cw) = fda_expr(wh.cond, w);
      let (bs, tail) = fda_body(wh.body, cw);
      return (ast.StmtWhile { ...wh, cond: cond, body: bs }, fda_leave(tail, w), true);
    },
    ast.StmtFor(f) => {
      let (iter, iw) = fda_expr(f.iter, w);
      let (bs, tail) = fda_body(f.body, fda_bind(iw, f.var_name));
      return (ast.StmtFor { ...f, iter: iter, body: bs }, fda_leave(tail, w), true);
    },
    ast.StmtMatch(m) => {
      let (scrutinee, cur) = fda_expr(m.scrutinee, w);
      let arms: ast.MatchArm[] = [];
      for arm in m.arms {
        let inner = cur;
        for n in astwalk.pattern_binders(arm.pattern, []) {
          inner = fda_bind(inner, n);
        }
        let guard = arm.guard;
        if (arm.has_guard) {
          let (g, gw) = fda_expr(guard, inner);
          guard = g;
          inner = gw;
        }
        let (bs, tail) = fda_body(arm.body, inner);
        arms = arms.append(ast.MatchArm { ...arm, guard: guard, body: bs });
        cur = fda_leave(tail, cur);
      }
      return (ast.StmtMatch { ...m, scrutinee: scrutinee, arms: arms }, cur, true);
    },
    ast.StmtDefer(d) => {
      let (action, tail, handled) = astwalk.map_stmt_where(d.action, w, fda_stmt_at, fda_expr_at, astwalk.descend_all);
      return (ast.StmtDefer { ...d, action: action }, fda_leave(tail, w), true);
    },
    _ => {
      return (st, w, false);
    }
  }
}

pub function fill_stmts(stmts: ast.Stmt[], params: ast.ParamDecl[], funcs: FreeFuncs): (ast.Stmt[], util.Diag[]) {
  let none: util.Diag[] = [];
  let scope: string[] = [];
  let w = fda_bind_params(FdaWalk { funcs: funcs, local: scope, diags: none }, params);
  let (out, tail) = fda_body(stmts, w);
  return (out, tail.diags);
}

function fda_const_value(name: string, funcs: parser.FuncDecl[]): (ast.Expr, boolean) {
  for fd in funcs {
    if (fd.is_const && fd.receiver_type.len() == 0 && fd.name == name && fd.body.len() == 1) {
      match (fd.body[0]) {
        ast.StmtReturn(r) => {
          return (r.value, true);
        },
        _ => {}
      }
    }
  }
  return (ast.ExprBool { value: false, line: 0, col: 0 }, false);
}

function fda_fold_consts(e: ast.Expr, funcs: parser.FuncDecl[], depth: i32): ast.Expr {
  if (depth > 16) {
    return e;
  }
  match (e) {
    ast.ExprIdent(id) => {
      let (v, ok) = fda_const_value(id.name, funcs);
      if (ok) {
        return fda_fold_consts(v, funcs, depth + 1);
      }
      return e;
    },
    ast.ExprUnary(u) => {
      return ast.rebuild_unary(u, fda_fold_consts(u.operand, funcs, depth), u.line, u.col, u.ty);
    },
    ast.ExprBinary(b) => {
      return ast.binary(b.op, fda_fold_consts(b.left, funcs, depth), fda_fold_consts(b.right, funcs, depth), b.line, b.col, b.ty);
    },
    _ => {
      return e;
    }
  }
}

function fda_fold_default_consts(mod: parser.Module): parser.Module {
  let funcs: parser.FuncDecl[] = [];
  for fd in mod.funcs {
    let params: ast.ParamDecl[] = [];
    for param in fd.params {
      if (param.has_default) {
        params = params.append(ast.ParamDecl { ...param, default_value: fda_fold_consts(param.default_value, mod.funcs, 0) });
      } else {
        params = params.append(param);
      }
    }
    funcs = funcs.append(parser.FuncDecl { ...fd, params: params });
  }
  return parser.Module { ...mod, funcs: funcs };
}

function fda_decl_diags(mod: parser.Module): util.Diag[] {
  let out: util.Diag[] = [];
  for fd in mod.funcs {
    for param in fd.params {
      if (param.has_default) {
        let (why, bad) = parser.default_nonconst_reason(param.default_value);
        if (bad) {
          out = out.append(util.Diag { related: [], length: 0, code: "E076", message: "default value for parameter \"" + param.name + "\" " + why + ": a default must be a constant expression, because it is evaluated at each call site rather than inside " + fd.name, line: ast.expr_line(param.default_value), col: ast.expr_col(param.default_value), fix: None });
        }
      }
    }
  }
  return out;
}

function fda_param_index(params: ast.ParamDecl[], name: string): Option[i32] {
  for i in 0..params.len() {
    if (params[i].name == name) {
      return Some(i);
    }
  }
  return None;
}

function fda_call_error(c: ast.ExprCall, funcs: FreeFuncs, local: string[]): (string, string) {
  let callee = "";
  match (c.callee) {
    ast.ExprIdent(id) => {
      callee = id.name;
    },
    _ => {
      return ("E077", "named arguments are only supported on direct calls to named functions");
    }
  }
  if (util.has_str(local, callee) || !funcs.names.has(callee)) {
    return ("E077", "named arguments are not supported for call to \"" + callee + "\"");
  }
  let params = funcs.params_of(callee);
  let filled: boolean[] = [];
  for k in 0..params.len() {
    filled = filled.append(false);
  }
  let pos = 0;
  let seen_named = false;
  for i in 0..c.args.len() {
    if (parser.is_named_marker(c.args[i])) {
      seen_named = true;
      let name = parser.named_marker_name(c.args[i]);
      let Some(idx) = fda_param_index(params, name) else {
        return ("E077", "\"" + callee + "\" has no parameter named \"" + name + "\"");
      };
      if (filled[idx]) {
        return ("E077", "duplicate argument for parameter \"" + name + "\"");
      }
      filled = filled.with(idx, true);
    } else {
      if (seen_named) {
        return ("E077", "positional argument after named argument");
      }
      if (pos >= params.len()) {
        return ("E004", "function \"" + callee + "\" takes at most " + util.i32_to_string(params.len()) + " arguments but was given more");
      }
      filled = filled.with(pos, true);
      pos += 1;
    }
  }
  for pi in 0..params.len() {
    if (!filled[pi] && !params[pi].has_default) {
      return ("E004", "missing argument for parameter \"" + params[pi].name + "\" of \"" + callee + "\"");
    }
  }
  return ("", "");
}

pub function fill_with_diags(raw: parser.Module): (parser.Module, util.Diag[]) {
  let none: util.Diag[] = [];
  raw = parser.retag_type_arg_indexes(raw);
  if (!module_has_default_params(raw)) {
    if (!module_has_named_args(raw)) {
      return (raw, none);
    }
    return fda_fill(raw);
  }
  let mod = fda_fold_default_consts(raw);
  let decl_diags = fda_decl_diags(mod);
  if (decl_diags.len() > 0) {
    return (raw, decl_diags);
  }
  return fda_fill(mod);
}

function fda_fill(mod: parser.Module): (parser.Module, util.Diag[]) {
  let free = free_funcs(mod.funcs);
  let funcs: parser.FuncDecl[] = [];
  let diags: util.Diag[] = [];
  for fd in mod.funcs {
    let (body, fdiags) = fill_stmts(fd.body, fd.params, free);
    funcs = funcs.append(parser.FuncDecl { ...fd, body: body });
    diags = util.append_diags(diags, fdiags);
  }
  let no_params: ast.ParamDecl[] = [];
  let (tops, tdiags) = fill_stmts(mod.top_stmts, no_params, free);
  return (parser.Module { ...mod, funcs: funcs, top_stmts: tops }, util.append_diags(diags, tdiags));
}

pub function fill_module(mod: parser.Module): parser.Module {
  let (filled, diags) = fill_with_diags(mod);
  return filled;
}
