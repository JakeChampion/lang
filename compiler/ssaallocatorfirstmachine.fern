// Conditional Linux x86-64 first allocation, under an explicit successful mmap
// premise. Output has no OS identity: this is not a production target binding,
// global allocator invariant, linked-permission proof or default certificate.
import "./ssacapacityisa" as isa;
import "./ssaallocatorinitisa" as init;
import "./ssadecrementtext" as text;

// Private paired halves: numeric, original register, stack, mapping offset,
// small-list base, return (6), original stack (7), syscall clobber (11).
struct Half { kind: i32, identity: i64, high: boolean }

struct Word { low: Half, high: Half }

struct State { regs: Word[], memory: Half[], writes: i32[], zero: i32, carry: i32, sign: i32, overflow: i32, bounded: boolean, mappings: i32, ok: boolean }

function half(kind: i32, identity: i64, high: boolean): Half {
  return Half { kind: kind, identity: identity, high: high };
}

function token(kind: i32, identity: i64): Word {
  return Word { low: half(kind, identity, false), high: half(kind, identity, true) };
}

function number(n: i64): Word {
  let low = n % 4294967296;
  return Word { low: half(0, if (low < 0) { low + 4294967296 } else { low }, false), high: half(0, if (n < 0) { 4294967295 } else { n / 4294967296 }, false) };
}

function same(a: Half, b: Half): boolean {
  return a.kind == b.kind && a.identity == b.identity && a.high == b.high;
}

function equal(a: Word, b: Word): boolean {
  return same(a.low, b.low) && same(a.high, b.high);
}

function unsigned(w: Word): boolean {
  return w.low.kind == 0 && same(w.high, number(0).high);
}

function narrowed(w: Word, width: i32): Word {
  return if (width == 32) { Word { ...w, high: number(0).high } } else { w };
}

function pointer(w: Word): boolean {
  return w.low.kind >= 2 && w.low.kind <= 4 && equal(w, token(w.low.kind, w.low.identity));
}

function unknown(s: State): State {
  return State { ...s, zero: -1, carry: -1, sign: -1, overflow: -1, bounded: false };
}

function write(s: State, reg: i32, value: Word): State {
  return State { ...s, regs: s.regs.with(reg, value) };
}

function initial_word(i: i32): Word {
  if (i < 20) {
    return token(7, (i / 2) as i64);
  }
  if (i < 22) {
    return token(6, 0);
  }
  return if (i < 24) { token(7, 10) } else { number(0) };
}

function initial(request: i32): State {
  let regs: Word[] = [];
  let memory: Half[] = [];
  let writes: i32[] = [];
  let i = 0;
  while (i < 16) {
    regs = regs.append(if (i == 4) { token(2, 0) } else { if (i == 7) { number(request as i64) } else { token(1, i as i64) } });
    i = i + 1;
  }
  i = 0;
  while (i < 32) {
    let w = initial_word(i);
    memory = memory.append(if (i % 2 == 0) { w.low } else { w.high });
    writes = writes.append(0);
    i = i + 1;
  }
  return State { regs: regs, memory: memory, writes: writes, zero: -1, carry: -1, sign: -1, overflow: -1, bounded: false, mappings: 0, ok: true };
}

function cell(base: Word, offset: i64, width: i32, request: i32): i32 {
  if (!pointer(base) || offset < -80 || offset > 80) {
    return -1;
  }
  let at = base.low.identity + offset;
  let bytes = width / 8;
  if (at % 4 != 0) {
    return -1;
  }
  return cell_extent(base.low.kind, at, bytes, request);
}

function cell_extent(kind: i32, at: i64, bytes: i32, request: i32): i32 {
  if (kind == 2 && at >= -80 && at + bytes <= 16) {
    return ((at + 80) / 4) as i32;
  }
  // No mapping read/write is needed or granted by this instruction proof.
  if (kind == 4 && at >= request as i64 && at + bytes <= request as i64 + 8) {
    return 24 + ((at - request as i64) / 4) as i32;
  }
  return -1;
}

function address(s: State, op: isa.Op, request: i32): i32 {
  let offset = op.offset as i64;
  if (op.index >= 0) {
    let index = s.regs[op.index];
    if (!unsigned(index) || index.low.identity > 64) {
      return -1;
    }
    offset = offset + index.low.identity * (op.scale as i64);
  }
  return cell(s.regs[op.base], offset, op.width, request);
}

function load(s: State, at: i32, width: i32): Word {
  return Word { low: s.memory[at], high: if (width == 64) { s.memory[at + 1] } else { number(0).high } };
}

function read(s: State, at: i32, width: i32, reg: i32): State {
  return if (at < 0) { State { ...s, ok: false } } else { write(s, reg, load(s, at, width)) };
}

function writable(at: i32): boolean {
  return at >= 0 && at < 20 || at >= 26 && at < 32;
}

function store(s: State, at: i32, width: i32, w: Word): State {
  let memory = s.memory;
  let writes = s.writes;
  let i = 0;
  while (i < width / 32) {
    let pos = at + i;
    if (!writable(pos) || pos >= 26 && writes[pos] >= (if (pos < 28) { 2 } else { 1 })) {
      return State { ...s, ok: false };
    }
    memory = memory.with(pos, if (i == 0) { w.low } else { w.high });
    writes = writes.with(pos, writes[pos] + 1);
    i = i + 1;
  }
  return State { ...s, memory: memory, writes: writes };
}

function stack(s: State, op: isa.Op, request: i32): State {
  let sp = s.regs[4];
  if (!pointer(sp) || sp.low.kind != 2) {
    return State { ...s, ok: false };
  }
  if (op.kind == 6 || op.kind == 32) {
    let at = if (op.kind == 32) { address(s, op, request) } else { 0 };
    if (at < 0) {
      return State { ...s, ok: false };
    }
    // Read the source before changing SP, including a source based on SP.
    let w = if (op.kind == 32) { load(s, at, 64) } else { s.regs[op.source] };
    let next = token(2, sp.low.identity - 8);
    return write(store(s, cell(next, 0, 64, request), 64, w), 4, next);
  }
  return pop(s, op, request);
}

function pop(s: State, op: isa.Op, request: i32): State {
  let sp = s.regs[4];
  let at = cell(sp, 0, 64, request);
  if (at < 0) {
    return State { ...s, ok: false };
  }
  let w = load(s, at, 64);
  let advanced = write(s, 4, token(2, sp.low.identity + 8));
  // Intel POP memory computes the destination using the incremented SP.
  return if (op.kind == 33) { store(advanced, address(advanced, op, request), 64, w) } else { write(advanced, op.destination, w) };
}

function shifted(s: State, reg: i32, w: Word, delta: i64, request: i32): State {
  let at = w.low.identity + delta;
  let low = if (w.low.kind == 2) { -(80 as i64) } else { 0 as i64 };
  let high = if (w.low.kind == 3) { 17179869184 as i64 } else { if (w.low.kind == 2) { 16 as i64 } else { 64 as i64 } };
  return if (at >= low && at <= high) { write(s, reg, token(w.low.kind, at)) } else { State { ...s, ok: false } };
}

function immediate_add(s: State, op: isa.Op, request: i32): State {
  let w = s.regs[op.destination];
  let delta = if (op.kind == 9) { -(op.immediate as i64) } else { op.immediate as i64 };
  if (pointer(w) && op.width == 64) {
    return shifted(s, op.destination, w, delta, request);
  }
  if (!unsigned(w)) {
    return State { ...s, ok: false };
  }
  let n = w.low.identity + delta;
  return if (n >= 0 && n <= 4294967295) { write(s, op.destination, number(n)) } else { State { ...s, ok: false } };
}

function arithmetic(s: State, op: isa.Op, request: i32): State {
  let cleared = unknown(s);
  if (op.source < 0) {
    return immediate_add(cleared, op, request);
  }
  if (op.width != 64) {
    return State { ...s, ok: false };
  }
  let a = s.regs[op.destination];
  let b = s.regs[op.source];
  return register_arithmetic(cleared, op, a, b, request);
}

function register_arithmetic(s: State, op: isa.Op, a: Word, b: Word, request: i32): State {
  let av = scalar(a);
  let bv = scalar(b);
  if (op.kind == 10 && pointer(b) && av >= 0) {
    return shifted(s, op.destination, b, av, request);
  }
  if (pointer(a) && bv >= 0) {
    return shifted(s, op.destination, a, if (op.kind == 9) { -bv } else { bv }, request);
  }
  return pointer_difference(s, op, a, b);
}

function scalar(w: Word): i64 {
  if (w.low.kind != 0 || w.high.kind != 0 || w.high.identity > 4) {
    return -1;
  }
  let n = w.low.identity + 4294967296 * w.high.identity;
  return if (n <= 17179869184) { n } else { -1 };
}

function pointer_difference(s: State, op: isa.Op, a: Word, b: Word): State {
  if (op.kind == 9 && pointer(a) && pointer(b) && a.low.kind == b.low.kind && a.low.identity >= b.low.identity) {
    return write(s, op.destination, number(a.low.identity - b.low.identity));
  }
  return State { ...s, ok: false };
}

function flags(s: State, a: i64, b: i64, width: i32): State {
  let difference = a - b;
  let bits = if (width == 32) { if (difference < 0) { difference + 4294967296 } else { difference } } else { difference };
  let sign = if (width == 32) { bits >= 2147483648 } else { difference < 0 };
  let overflow = width == 32 && a >= 2147483648 != b >= 2147483648 && sign != a >= 2147483648;
  return State { ...s, zero: if (difference == 0) { 1 } else { 0 }, carry: if (a < b) { 1 } else { 0 }, sign: if (sign) { 1 } else { 0 }, overflow: if (overflow) { 1 } else { 0 }, bounded: false };
}

function comparison(s: State, a: Word, b: Word, width: i32, request: i32): State {
  let left = narrowed(a, width);
  let right = narrowed(b, width);
  if (unsigned(left) && unsigned(right)) {
    return flags(s, left.low.identity, right.low.identity, width);
  }
  if (equal(left, right)) {
    return flags(s, 0, 0, width);
  }
  return pointer_comparison(s, left, right, width);
}

function pointer_comparison(s: State, a: Word, b: Word, width: i32): State {
  if (width != 64 || !pointer(a) || a.low.kind != 3) {
    return unknown(s);
  }
  // Successful mmap premise: 0<B<=B+extent<2^63, no wrap.
  if (equal(b, number(0))) {
    return State { ...unknown(s), zero: 0, carry: 0, sign: 0, overflow: 0 };
  }
  if (pointer(b) && b.low.kind == 3) {
    return flags(s, a.low.identity, b.low.identity, 64);
  }
  return unknown(s);
}

function global_cell(symbol: string): i32 {
  if (symbol == "__fern_heap_ptr") {
    return 26;
  }
  if (symbol == "__fern_heap_base") {
    return 28;
  }
  return if (symbol == "__fern_heap_end") { 30 } else { -1 };
}

function global_step(s: State, op: isa.Op, request: i32): State {
  let at = global_cell(op.symbol);
  if (at < 0) {
    return State { ...s, ok: false };
  }
  if (op.kind == 29) {
    return read(s, at, op.width, op.destination);
  }
  if (op.kind == 34) {
    return global_store(s, at, op.width, s.regs[op.source], request);
  }
  return comparison(s, s.regs[op.source], load(s, at, op.width), op.width, request);
}

function global_store(s: State, at: i32, width: i32, w: Word, request: i32): State {
  let offset = if (at == 30) { 17179869184 as i64 } else { if (at == 26 && s.writes[at] == 1) { request as i64 } else { 0 as i64 } };
  // Each half must carry the derived current mapping, not just a write count.
  let expected = token(3, offset);
  if (s.mappings != 1 || !same(w.low, expected.low) || width == 64 && !same(w.high, expected.high)) {
    return State { ...s, ok: false };
  }
  return store(s, at, width, w);
}

function test(s: State, op: isa.Op): State {
  let w = narrowed(s.regs[op.source], op.width);
  if (unsigned(w)) {
    let result = flags(s, w.low.identity, 0, op.width);
    return State { ...result, carry: 0, overflow: 0 };
  }
  // A full mapped pointer is positive under the explicit OS premise.
  return State { ...unknown(s), zero: if (pointer(w) && w.low.kind == 3) { 0 } else { -1 }, sign: if (pointer(w) && w.low.kind == 3) { 0 } else { -1 }, carry: 0, overflow: 0 };
}

function mask(s: State, op: isa.Op): State {
  let w = s.regs[op.destination];
  if (op.source >= 0 || op.immediate != -8 || !unsigned(w)) {
    return State { ...s, ok: false };
  }
  let n = w.low.identity - w.low.identity % 8;
  return write(flags(s, n, 0, op.width), op.destination, number(n));
}

function memory_step(s: State, op: isa.Op, request: i32): State {
  let at = address(s, op, request);
  if (op.kind == 3) {
    return read(s, at, op.width, op.destination);
  }
  let w = if (op.kind == 22) { number(op.immediate as i64) } else { s.regs[op.source] };
  return store(s, at, op.width, w);
}

function simple(s: State, op: isa.Op, request: i32): State {
  if (op.kind == 1) {
    return s;
  }
  if (op.kind == 2) {
    return write(s, op.destination, narrowed(s.regs[op.source], op.width));
  }
  if (op.kind == 5) {
    return write(s, op.destination, narrowed(number(op.immediate as i64), op.width));
  }
  if (op.kind == 19 && op.symbol == "__fern_freelist") {
    return write(s, op.destination, token(4, 0));
  }
  if (op.kind == 15) {
    return lea(s, op, request);
  }
  return State { ...s, ok: false };
}

function lea(s: State, op: isa.Op, request: i32): State {
  if (op.index < 0 && op.base >= 0 && pointer(s.regs[op.base])) {
    return shifted(s, op.destination, s.regs[op.base], op.offset as i64, request);
  }
  if (op.base < 0 && op.index >= 0 && unsigned(s.regs[op.index])) {
    let n = s.regs[op.index].low.identity * (op.scale as i64) + op.offset as i64;
    if (n >= 0 && n <= 4294967295) {
      return write(s, op.destination, number(n));
    }
  }
  return State { ...s, ok: false };
}

function shift(s: State, op: isa.Op): State {
  let w = s.regs[op.destination];
  if (!unsigned(w)) {
    return State { ...s, ok: false };
  }
  let n = w.low.identity;
  let count = op.immediate % (if (op.width == 64) { 64 } else { 32 });
  while (count > 0) {
    n = if (op.kind == 21) { n / 2 } else { n * 2 };
    if (n > 4294967295) {
      return State { ...s, ok: false };
    }
    count = count - 1;
  }
  return write(unknown(s), op.destination, number(n));
}

function mapping_arguments(s: State): boolean {
  return equal(s.regs[0], number(9)) && equal(s.regs[7], number(268435456)) && equal(s.regs[6], number(17179869184)) && equal(s.regs[2], number(3)) && equal(s.regs[10], number(16418)) && equal(s.regs[8], number(-1)) && equal(s.regs[9], number(0));
}

function syscall(s: State): State {
  let sp = s.regs[4];
  if (s.mappings != 0 || !mapping_arguments(s) || !pointer(sp) || sp.low.kind != 2 || sp.low.identity > 0) {
    return State { ...s, ok: false };
  }
  // Explicit OS axiom, not established by parsing syscall: successful Linux
  // mmap grants fresh B of extent16GiB, positive canonical and disjoint, with
  // no wrap. RCX/R11 may change arbitrarily; other GPRs and memory survive.
  let after = write(write(write(unknown(s), 0, token(3, 0)), 1, token(11, 1)), 11, token(11, 11));
  return State { ...after, mappings: 1 };
}

function initialization(s: State, op: isa.Op): State {
  if (op.kind == 37) {
    return syscall(s);
  }
  if (op.kind == 38) {
    return write(flags(s, 0, 0, 32), op.destination, number(0));
  }
  // Deliberately bounded admission, with no signed-minimum conversion.
  if (op.kind == 36 && op.symbol == "17179869184") {
    return write(s, op.destination, number(17179869184));
  }
  return State { ...s, ok: false };
}

function step(s: State, op: isa.Op, request: i32): State {
  if (op.kind == 3 || op.kind == 4 || op.kind == 22) {
    return memory_step(s, op, request);
  }
  if (op.kind == 6 || op.kind == 7 || op.kind == 32 || op.kind == 33) {
    return stack(s, op, request);
  }
  return other_step(s, op, request);
}

function other_step(s: State, op: isa.Op, request: i32): State {
  if (op.kind >= 36 && op.kind <= 38) {
    return initialization(s, op);
  }
  if (op.kind == 20 || op.kind == 21) {
    return shift(s, op);
  }
  return arithmetic_step(s, op, request);
}

function arithmetic_step(s: State, op: isa.Op, request: i32): State {
  if (op.kind == 9 || op.kind == 10) {
    return arithmetic(s, op, request);
  }
  if (op.kind == 11) {
    return mask(s, op);
  }
  if (op.kind == 23 || op.kind == 27) {
    return test(s, op);
  }
  if (op.kind >= 29 && op.kind <= 30 || op.kind == 34) {
    return global_step(s, op, request);
  }
  return compare_or_simple(s, op, request);
}

function compare_or_simple(s: State, op: isa.Op, request: i32): State {
  if (op.kind == 16) {
    return comparison(s, s.regs[op.source], number(op.immediate as i64), op.width, request);
  }
  if (op.kind == 28) {
    return comparison(s, s.regs[op.destination], s.regs[op.source], op.width, request);
  }
  return simple(s, op, request);
}

function inverse(value: i32): i32 {
  return if (value < 0) { -1 } else { 1 - value };
}

function disjunction(a: i32, b: i32): i32 {
  return if (a == 1 || b == 1) { 1 } else { if (a == 0 && b == 0) { 0 } else { -1 } };
}

function branch(s: State, condition: string): i32 {
  if (condition == "jmp") {
    return 1;
  }
  if (condition == "je" || condition == "jz") {
    return s.zero;
  }
  if (condition == "jne" || condition == "jnz") {
    return inverse(s.zero);
  }
  if (condition == "jb") {
    return s.carry;
  }
  if (condition == "jae") {
    return inverse(s.carry);
  }
  return ordered_branch(s, condition);
}

function ordered_branch(s: State, condition: string): i32 {
  if (condition == "ja" || condition == "jbe") {
    let below = if (s.bounded) { 1 } else { disjunction(s.zero, s.carry) };
    return if (condition == "jbe") { below } else { inverse(below) };
  }
  return signed_branch(s, condition);
}

function signed_branch(s: State, condition: string): i32 {
  if (condition == "js") {
    return s.sign;
  }
  if (condition == "jns") {
    return inverse(s.sign);
  }
  if (condition == "jo") {
    return s.overflow;
  }
  if (condition == "jno") {
    return inverse(s.overflow);
  }
  let less = if (s.sign < 0 || s.overflow < 0) { -1 } else { if (s.sign != s.overflow) { 1 } else { 0 } };
  if (condition == "jl") {
    return less;
  }
  if (condition == "jge") {
    return inverse(less);
  }
  return signed_order(s, condition, less);
}

function signed_order(s: State, condition: string, less: i32): i32 {
  let below = disjunction(less, s.zero);
  if (condition == "jle") {
    return below;
  }
  return if (condition == "jg") { inverse(below) } else { -1 };
}

function finished_memory(s: State, original: State, request: i32): boolean {
  let i = 20;
  while (i < s.memory.len()) {
    let offset = if (i >= 30) { 17179869184 as i64 } else { if (i < 28) { request as i64 } else { 0 as i64 } };
    let changed = token(3, offset);
    let expected = if (i >= 26) { if (i % 2 == 0) { changed.low } else { changed.high } } else { original.memory[i] };
    let count = if (i < 26) { 0 } else { if (i < 28) { 2 } else { 1 } };
    if (!same(s.memory[i], expected) || s.writes[i] != count) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function finished(s: State, request: i32): boolean {
  let original = initial(request);
  let i = 0;
  while (i < 16) {
    let expected = original.regs[i];
    if (i == 0) {
      expected = token(3, 0);
    }
    if (i == 7) {
      expected = token(3, request as i64);
    }
    if (!equal(s.regs[i], expected)) {
      return false;
    }
    i = i + 1;
  }
  return s.ok && s.mappings == 1 && finished_memory(s, original, request);
}

function path(p: isa.Program, request: i32): boolean {
  let s = initial(request);
  let visited: boolean[] = [];
  for op in p.ops {
    visited = visited.append(false);
  }
  let pc = 0;
  while (pc >= 0 && pc < p.ops.len()) {
    if (visited[pc]) {
      return false;
    }
    visited = visited.with(pc, true);
    let op = p.ops[pc];
    if (op.kind == 18) {
      return finished(s, request);
    }
    if (op.kind == 17 || op.kind == 35) {
      pc = next_pc(s, op, pc);
    } else {
      s = step(s, op, request);
      if (!s.ok) {
        return false;
      }
      pc = pc + 1;
    }
  }
  return false;
}

function next_pc(s: State, op: isa.Op, pc: i32): i32 {
  let taken = branch(s, op.condition);
  if (taken < 0 || taken == 1 && op.kind == 35) {
    return -1;
  }
  return if (taken == 1) { op.target } else { pc + 1 };
}

// Explicit conditional domain: DI40/48, zero selected slot and all three
// heap globals, canonical aligned disjoint linked globals/slot/stackS-80..S+15.
// Lower stack and globals are writable. Linux syscall ABI and successful fresh
// writable16GiB mmap (positive B, B+extent<2^63) are UNPROVED OS premises.
// Derives AX=B, DI=B+request, base=B/end=B+extent/ptr=B+request, exact global
// writes, unchanged slot/other GPRs/return/argument and RETSP+8. Scratch is
// unconstrained at return. Failure/terminal/general allocation remains refused.
// Output lacks OS metadata; callers cannot use this as a target certificate.
pub function check(output: string): boolean {
  let p = init.program(output);
  return p.error == "" && text.allocator_storage(output) && path(p, 40) && path(p, 48);
}
