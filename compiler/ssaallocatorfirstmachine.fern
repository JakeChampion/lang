import "./ssaallocatorstate" as machine;
import "./ssamachineword" as machineword;
import "./ssacapacityisa" as isa;
import "./ssaallocatorinitisa" as init;
import "./ssadecrementtext" as text;

function initial_word(i: i32): machineword.Word {
  if (i < 20) {
    return machineword.token(7, (i / 2) as i64);
  }
  if (i < 22) {
    return machineword.token(6, 0);
  }
  return if (i < 24) { machineword.token(7, 10) } else { machineword.number(0) };
}

function initial(request: i32): machine.State {
  let regs: machineword.Word[] = [];
  let memory: machineword.Half[] = [];
  let writes: i32[] = [];
  let i = 0;
  while (i < 16) {
    regs = regs.append(if (i == 4) { machineword.token(2, 0) } else { if (i == 7) { machineword.number(request as i64) } else { machineword.token(1, i as i64) } });
    i += 1;
  }
  for i in 0..32 {
    let w = initial_word(i);
    memory = memory.append(if (i % 2 == 0) { w.low } else { w.high });
    writes = writes.append(0);
  }
  return machine.initial_state(regs, memory, writes);
}

function cell(base: machineword.Word, offset: i64, width: i32, request: i32): i32 {
  if (!machine.pointer(base) || offset < -80 || offset > 80) {
    return -1;
  }
  let at = base.low.identity + offset;
  let bytes = width / 8;
  if (at % 4 != 0) {
    return -1;
  }
  return cell_extent(base.low.kind, at, bytes, request);
}

function cell_extent(kind: i32, at: i64, bytes: i32, request: i32): i32 {
  if (kind == 2 && at >= -80 && at + bytes <= 16) {
    return ((at + 80) / 4) as i32;
  }
  if (kind == 4 && at >= request as i64 && at + bytes <= request as i64 + 8) {
    return 24 + ((at - request as i64) / 4) as i32;
  }
  return -1;
}

function writable(at: i32): boolean {
  return at >= 0 && at < 20 || at >= 26 && at < 32;
}

function store(s: machine.State, at: i32, width: i32, w: machineword.Word): machine.State {
  let memory = s.memory;
  let writes = s.writes;
  for i in 0..width / 32 {
    let pos = at + i;
    if (!writable(pos) || pos >= 26 && writes[pos] >= (if (pos < 28) { 2 } else { 1 })) {
      return machine.State { ...s, ok: false };
    }
    memory = memory.with(pos, if (i == 0) { w.low } else { w.high });
    writes = writes.with(pos, writes[pos] + 1);
  }
  return machine.State { ...s, memory: memory, writes: writes };
}

function stack(s: machine.State, op: isa.Op, request: i32): machine.State {
  let sp = s.regs[4];
  if (!machine.pointer(sp) || sp.low.kind != 2) {
    return machine.State { ...s, ok: false };
  }
  if (op.kind == 6 || op.kind == 32) {
    let at = if (op.kind == 32) { machine.address(s, op, request, cell) } else { 0 };
    if (at < 0) {
      return machine.State { ...s, ok: false };
    }
    let w = if (op.kind == 32) { machine.load(s, at, 64) } else { s.regs[op.source] };
    let next = machineword.token(2, sp.low.identity - 8);
    return machine.write(store(s, cell(next, 0, 64, request), 64, w), 4, next);
  }
  return pop(s, op, request);
}

function pop(s: machine.State, op: isa.Op, request: i32): machine.State {
  let sp = s.regs[4];
  let at = cell(sp, 0, 64, request);
  if (at < 0) {
    return machine.State { ...s, ok: false };
  }
  let w = machine.load(s, at, 64);
  let advanced = machine.write(s, 4, machineword.token(2, sp.low.identity + 8));
  return if (op.kind == 33) { store(advanced, machine.address(advanced, op, request, cell), 64, w) } else { machine.write(advanced, op.destination, w) };
}

function shifted(s: machine.State, reg: i32, w: machineword.Word, delta: i64, request: i32): machine.State {
  let at = w.low.identity + delta;
  let low = if (w.low.kind == 2) { -(80 as i64) } else { 0 as i64 };
  let high = if (w.low.kind == 3) { 17179869184 as i64 } else { if (w.low.kind == 2) { 16 as i64 } else { 64 as i64 } };
  return if (at >= low && at <= high) { machine.write(s, reg, machineword.token(w.low.kind, at)) } else { machine.State { ...s, ok: false } };
}

function register_arithmetic(s: machine.State, op: isa.Op, a: machineword.Word, b: machineword.Word, request: i32): machine.State {
  let av = scalar(a);
  let bv = scalar(b);
  if (op.kind == 10 && machine.pointer(b) && av >= 0) {
    return region_sum(s, op.destination, b, av, request);
  }
  if (machine.pointer(a) && bv >= 0) {
    return if (op.kind == 10) { region_sum(s, op.destination, a, bv, request) } else { shifted(s, op.destination, a, -bv, request) };
  }
  return machine.pointer_difference(s, op, a, b);
}

// A mapped kind-three region contains every coordinate that shifted accepts.
function region_sum(s: machine.State, reg: i32, base: machineword.Word, delta: i64, request: i32): machine.State {
  let result = shifted(s, reg, base, delta, request);
  return if (result.ok && base.low.kind == 3 && delta >= 0) { machine.State { ...result, carry: 0 } } else { result };
}

function scalar(w: machineword.Word): i64 {
  if (w.low.kind != 0 || w.high.kind != 0 || w.high.identity > 4) {
    return -1;
  }
  let n = w.low.identity + 4294967296 * w.high.identity;
  return if (n <= 17179869184) { n } else { -1 };
}

function flags(s: machine.State, a: i64, b: i64, width: i32): machine.State {
  let difference = a - b;
  let bits = if (width == 32) { if (difference < 0) { difference + 4294967296 } else { difference } } else { difference };
  let sign = if (width == 32) { bits >= 2147483648 } else { difference < 0 };
  let overflow = width == 32 && a >= 2147483648 != b >= 2147483648 && sign != a >= 2147483648;
  return machine.State { ...s, zero: if (difference == 0) { 1 } else { 0 }, carry: if (a < b) { 1 } else { 0 }, sign: if (sign) { 1 } else { 0 }, overflow: if (overflow) { 1 } else { 0 }, bounded: false };
}

function comparison(s: machine.State, a: machineword.Word, b: machineword.Word, width: i32, request: i32): machine.State {
  let left = machineword.narrowed(a, width);
  let right = machineword.narrowed(b, width);
  if (machineword.unsigned(left) && machineword.unsigned(right)) {
    return flags(s, left.low.identity, right.low.identity, width);
  }
  if (machineword.equal(left, right)) {
    return flags(s, 0, 0, width);
  }
  return pointer_comparison(s, left, right, width);
}

function pointer_comparison(s: machine.State, a: machineword.Word, b: machineword.Word, width: i32): machine.State {
  if (width != 64 || !machine.pointer(a) || a.low.kind != 3) {
    return machine.unknown(s);
  }
  if (machineword.equal(b, machineword.number(0))) {
    return machine.State { ...machine.unknown(s), zero: 0, carry: 0, sign: 0, overflow: 0 };
  }
  if (machine.pointer(b) && b.low.kind == 3) {
    return flags(s, a.low.identity, b.low.identity, 64);
  }
  return machine.unknown(s);
}

function global_cell(symbol: string): i32 {
  if (symbol == "__fern_heap_ptr") {
    return 26;
  }
  if (symbol == "__fern_heap_base") {
    return 28;
  }
  return if (symbol == "__fern_heap_end") { 30 } else { -1 };
}

function global_step(s: machine.State, op: isa.Op, request: i32): machine.State {
  let at = global_cell(op.symbol);
  if (at < 0) {
    return machine.State { ...s, ok: false };
  }
  if (op.kind == 29) {
    return machine.read(s, at, op.width, op.destination);
  }
  if (op.kind == 34) {
    return global_store(s, at, op.width, s.regs[op.source], request);
  }
  return comparison(s, s.regs[op.source], machine.load(s, at, op.width), op.width, request);
}

function global_store(s: machine.State, at: i32, width: i32, w: machineword.Word, request: i32): machine.State {
  let offset = if (at == 30) { 17179869184 as i64 } else { if (at == 26 && s.writes[at] == 1) { request as i64 } else { 0 as i64 } };
  let expected = machineword.token(3, offset);
  if (s.mappings != 1 || !machineword.same(w.low, expected.low) || width == 64 && !machineword.same(w.high, expected.high)) {
    return machine.State { ...s, ok: false };
  }
  return store(s, at, width, w);
}

function test(s: machine.State, op: isa.Op): machine.State {
  let w = machineword.narrowed(s.regs[op.source], op.width);
  if (machineword.unsigned(w)) {
    let result = flags(s, w.low.identity, 0, op.width);
    return machine.State { ...result, carry: 0, overflow: 0 };
  }
  return machine.State { ...machine.unknown(s), zero: if (machine.pointer(w) && w.low.kind == 3) { 0 } else { -1 }, sign: if (machine.pointer(w) && w.low.kind == 3) { 0 } else { -1 }, carry: 0, overflow: 0 };
}

function mask(s: machine.State, op: isa.Op): machine.State {
  let w = s.regs[op.destination];
  if (op.source >= 0 || op.immediate != -8 || !machineword.unsigned(w)) {
    return machine.State { ...s, ok: false };
  }
  let n = w.low.identity - w.low.identity % 8;
  return machine.write(flags(s, n, 0, op.width), op.destination, machineword.number(n));
}

function memory_step(s: machine.State, op: isa.Op, request: i32): machine.State {
  let at = machine.address(s, op, request, cell);
  if (op.kind == 3) {
    return machine.read(s, at, op.width, op.destination);
  }
  let w = if (op.kind == 22) { machineword.number(op.immediate as i64) } else { s.regs[op.source] };
  return store(s, at, op.width, w);
}

function simple(s: machine.State, op: isa.Op, request: i32): machine.State {
  if (op.kind == 1) {
    return s;
  }
  if (op.kind == 2) {
    return machine.write(s, op.destination, machineword.narrowed(s.regs[op.source], op.width));
  }
  if (op.kind == 5) {
    return machine.write(s, op.destination, machineword.narrowed(machineword.number(op.immediate as i64), op.width));
  }
  if (op.kind == 19 && op.symbol == "__fern_freelist") {
    return machine.write(s, op.destination, machineword.token(4, 0));
  }
  if (op.kind == 15) {
    return lea(s, op, request);
  }
  return machine.State { ...s, ok: false };
}

// Whether op takes the address 4 MiB past the base of the mapped arena.
function small_part(s: machine.State, op: isa.Op): boolean {
  return op.index < 0 && op.base >= 0 && op.offset == 4194304 && s.mappings == 1 && machineword.equal(s.regs[op.base], machineword.token(3, 0));
}

function lea(s: machine.State, op: isa.Op, request: i32): machine.State {
  if (small_part(s, op)) {
    return machine.write(s, op.destination, machineword.token(15, 0));
  }
  if (op.index < 0 && op.base >= 0 && machine.pointer(s.regs[op.base])) {
    return shifted(s, op.destination, s.regs[op.base], op.offset as i64, request);
  }
  if (op.base < 0 && op.index >= 0 && machineword.unsigned(s.regs[op.index])) {
    let n = s.regs[op.index].low.identity * (op.scale as i64) + op.offset as i64;
    if (n >= 0 && n <= 4294967295) {
      return machine.write(s, op.destination, machineword.number(n));
    }
  }
  return machine.State { ...s, ok: false };
}

function shift(s: machine.State, op: isa.Op): machine.State {
  let w = s.regs[op.destination];
  if (!machineword.unsigned(w)) {
    return machine.State { ...s, ok: false };
  }
  let n = w.low.identity;
  let count = op.immediate % (if (op.width == 64) { 64 } else { 32 });
  while (count > 0) {
    n = if (op.kind == 21) { n / 2 } else { n * 2 };
    if (n > 4294967295) {
      return machine.State { ...s, ok: false };
    }
    count -= 1;
  }
  return machine.write(machine.unknown(s), op.destination, machineword.number(n));
}

function mapping_arguments(s: machine.State): boolean {
  return machineword.equal(s.regs[0], machineword.number(9)) && machineword.equal(s.regs[7], machineword.number(268435456)) && machineword.equal(s.regs[6], machineword.number(17179869184)) && machineword.equal(s.regs[2], machineword.number(3)) && machineword.equal(s.regs[10], machineword.number(16418)) && machineword.equal(s.regs[8], machineword.number(-1)) && machineword.equal(s.regs[9], machineword.number(0));
}

// The request for transparent huge pages: madvise with MADV_HUGEPAGE on the
// arena from 4 MiB past its base to its end. Token 15 is that address.
function advice_arguments(s: machine.State): boolean {
  return machineword.equal(s.regs[0], machineword.number(28)) && machineword.equal(s.regs[7], machineword.token(15, 0)) && machineword.equal(s.regs[6], machineword.number(17175674880)) && machineword.equal(s.regs[2], machineword.number(14));
}

// mappings is 1 after the call that maps the arena. advised is true after the
// one request for huge pages, which can only follow that call.
function syscall(s: machine.State): machine.State {
  let sp = s.regs[4];
  if (!machine.pointer(sp) || sp.low.kind != 2 || sp.low.identity > 0) {
    return machine.State { ...s, ok: false };
  }
  let after = machine.write(machine.write(machine.unknown(s), 1, machineword.token(11, 1)), 11, machineword.token(11, 11));
  if (s.mappings == 0 && mapping_arguments(s)) {
    return machine.State { ...machine.write(after, 0, machineword.token(3, 0)), mappings: 1 };
  }
  if (s.mappings == 1 && !s.advised && advice_arguments(s)) {
    return machine.State { ...machine.write(after, 0, machineword.token(11, 0)), advised: true };
  }
  return machine.State { ...s, ok: false };
}

function initialization(s: machine.State, op: isa.Op): machine.State {
  if (op.kind == 37) {
    return syscall(s);
  }
  if (op.kind == 38) {
    return machine.write(flags(s, 0, 0, 32), op.destination, machineword.number(0));
  }
  if (op.kind == 36 && op.symbol == "17179869184") {
    return machine.write(s, op.destination, machineword.number(17179869184));
  }
  if (op.kind == 36 && op.symbol == "17175674880") {
    return machine.write(s, op.destination, machineword.number(17175674880));
  }
  return machine.State { ...s, ok: false };
}

function step(s: machine.State, op: isa.Op, request: i32): machine.State {
  if (op.kind == 3 || op.kind == 4 || op.kind == 22) {
    return memory_step(s, op, request);
  }
  if (op.kind == 6 || op.kind == 7 || op.kind == 32 || op.kind == 33) {
    return stack(s, op, request);
  }
  return other_step(s, op, request);
}

function other_step(s: machine.State, op: isa.Op, request: i32): machine.State {
  if (op.kind >= 36 && op.kind <= 38) {
    return initialization(s, op);
  }
  if (op.kind == 20 || op.kind == 21) {
    return shift(s, op);
  }
  return arithmetic_step(s, op, request);
}

function arithmetic_step(s: machine.State, op: isa.Op, request: i32): machine.State {
  if (op.kind == 9 || op.kind == 10) {
    return machine.arithmetic(s, op, request, shifted, register_arithmetic);
  }
  if (op.kind == 11) {
    return mask(s, op);
  }
  if (op.kind == 23 || op.kind == 27) {
    return test(s, op);
  }
  if (op.kind >= 29 && op.kind <= 30 || op.kind == 34) {
    return global_step(s, op, request);
  }
  return machine.compare_or_simple(s, op, request, comparison, simple);
}

function finished_memory(s: machine.State, original: machine.State, request: i32): boolean {
  for i in 20..s.memory.len() {
    let offset = if (i >= 30) { 17179869184 as i64 } else { if (i < 28) { request as i64 } else { 0 as i64 } };
    let changed = machineword.token(3, offset);
    let expected = if (i >= 26) { if (i % 2 == 0) { changed.low } else { changed.high } } else { original.memory[i] };
    let count = if (i < 26) { 0 } else { if (i < 28) { 2 } else { 1 } };
    if (!machineword.same(s.memory[i], expected) || s.writes[i] != count) {
      return false;
    }
  }
  return true;
}

function finished(s: machine.State, request: i32): boolean {
  let original = initial(request);
  for i in 0..16 {
    let expected = original.regs[i];
    if (i == 0) {
      expected = machineword.token(3, 0);
    }
    if (i == 7) {
      expected = machineword.token(3, request as i64);
    }
    if (!machineword.equal(s.regs[i], expected)) {
      return false;
    }
  }
  return s.ok && s.mappings == 1 && finished_memory(s, original, request);
}

function path(p: isa.Program, request: i32): boolean {
  let s = initial(request);
  let visited: boolean[] = [];
  for op in p.ops {
    visited = visited.append(false);
  }
  let pc = 0;
  while (pc >= 0 && pc < p.ops.len()) {
    if (visited[pc]) {
      return false;
    }
    visited = visited.with(pc, true);
    let op = p.ops[pc];
    if (op.kind == 18) {
      return finished(s, request);
    }
    if (op.kind == 17 || op.kind == 35) {
      pc = machine.next_pc(s, op, pc, true);
    } else {
      s = step(s, op, request);
      if (!s.ok) {
        return false;
      }
      pc += 1;
    }
  }
  return false;
}

pub function check(output: string): boolean {
  let p = init.program(output);
  return p.error == "" && text.allocator_storage(output) && path(p, 32) && path(p, 40);
}
