function __fern_mlock_bytes(bytes: usize): i64 {
  let n = 0;
  let p: usize = 0;
  if ((bytes as i32 & 2) != 0) {
    let base = bytes - 2;
    n = __load_i32(base + 8);
    p = __raw_load_ptr(base, 0);
  } else {
    n = __load_i32(bytes);
    p = bytes + 8;
  }
  if (n <= 0) {
    return 0 as i64;
  }
  // The kernel locks each page that holds a part of the range.
  return __syscall3(228, p as i64, n as i64, 0);
}
