function __fern_lsetxattr_bytes_u8(path: string, name: string, value: i32[]): Result[void, IoError] {
  let vlen = value.len();
  let vp = __raw_arr_ptr(value) + 8;
  let nlen = name.len();
  let namez = __raw_alloc(nlen + 1);
  let j = 0;
  while (j < nlen) {
    __raw_store8(namez, j, name[j] as i32);
    j += 1;
  }
  __raw_store8(namez, nlen, 0);
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let rc = __syscall5(6, pathz as i64, namez as i64, vp as i64, vlen as i64, 0) as i32;
  let namez_own = __raw_string(namez, nlen + 1);
  let pathz_own = __raw_string(pathz, plen + 1);
  if (rc < 0) {
    return Err(__fern_io_error(-rc, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(());
}
