function __fern_getcwd(): Result[string, IoError] {
  let buf = __raw_alloc(4096);
  let rc = __syscall3(17, buf as i64, 4096, 0) as i32;
  let buf_own = __raw_string(buf, 4096);
  if (rc < 0) {
    return Err(__fern_io_error(-rc, ""));
  }
  if (buf_own[0] != 47) {
    return Err(__fern_io_error(2, ""));
  }
  if (__fern_utf8_valid(buf, rc - 1) == 0) {
    return Err(InvalidUtf8(""));
  }
  return Ok(__fern_path_copy(buf_own, rc - 1));
}
