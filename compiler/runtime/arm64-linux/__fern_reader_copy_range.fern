function __fern_reader_copy_range(fd: i32, out: i32, max: i32): Result[i64, IoError] {
  let n: i32 = __syscall6(285, fd as i64, 0, out as i64, 0, max as i64, 0) as i32;
  if (n >= 0) {
    return Ok(n as i64);
  }
  let e: i32 = 0 - n;
  if (e == 1 || e == 9 || e == 26 || e == 18 || e == 22 || e == 38 || e == 95) {
    return Err(Unsupported);
  }
  return Err(__fern_io_error(e, ""));
}
