function __fern_udp_connect_u8(fd: i32, addr: i32[], port: i32): i32 {
  let af = 2;
  if (addr.len() == 16) {
    af = 10;
  } else if (addr.len() != 4) {
    return -97;
  }
  let sa = __raw_scratch(28);
  let salen = 16;
  let at = 4;
  if (addr.len() == 16) {
    salen = 28;
    at = 8;
  }
  let z = 0;
  while (z < 28) {
    __raw_store8(sa, z, 0);
    z += 1;
  }
  __raw_store8(sa, 0, af);
  __raw_store8(sa, 1, 0);
  __raw_store8(sa, 2, port >> 8 & 255);
  __raw_store8(sa, 3, port & 255);
  let ap = __raw_arr_ptr(addr);
  let k = 0;
  while (k < addr.len()) {
    __raw_store8(sa, at + k, __raw_load8(ap, 8 + k));
    k += 1;
  }
  return __syscall3(203, fd as i64, sa as i64, salen as i64) as i32;
}
