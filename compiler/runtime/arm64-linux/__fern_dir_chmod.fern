function __fern_dir_chmod(dirfd: i32, path: string, mode: i32, follow: boolean): Result[void, IoError] {
  let plen: i32 = path.len();
  let pathz: usize = __raw_alloc(plen + 1);
  let i: i32 = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i = i + 1;
  }
  __raw_store8(pathz, plen, 0);
  let cr: i64 = 0 as i64;
  if (follow) {
    cr = __syscall4(53, dirfd as i64, pathz as i64, (mode & 4095) as i64, 0);
  } else {
    cr = __syscall4(452, dirfd as i64, pathz as i64, (mode & 4095) as i64, 256);
  }
  let rc: i32 = cr as i32;
  let pathz_own: string = __raw_string(pathz, plen + 1);
  if (rc < 0) {
    return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(());
}
