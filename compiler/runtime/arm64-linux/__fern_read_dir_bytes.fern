function __fern_read_dir_bytes(path: string): Result[i32[][], IoError] {
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let fd = __syscall3(56, -100, pathz as i64, 16384) as i32;
  let pathz_own = __raw_string(pathz, plen + 1);
  if (fd < 0) {
    return Err(__fern_io_error(-fd, __fern_path_copy(pathz_own, plen)));
  }
  let basep = __raw_alloc(8);
  let names: i32[][] = [];
  let bad = 0;
  let done = 0;
  while (done == 0) {
    let buf = __raw_alloc(65536);
    let n = __syscall4(61, fd as i64, buf as i64, 65536, basep as i64) as i32;
    if (n <= 0) {
      done = 1;
      bad = n;
    } else {
      let pos = 0;
      while (pos < n) {
        let reclen = __raw_load8(buf, pos + 16) + __raw_load8(buf, pos + 17) * 256;
        let nlen = 0;
        let room = reclen - 19;
        let scan = 1;
        while (scan == 1 && nlen + 8 <= room) {
          let w = __load_i64(buf + pos + 19 + nlen);
          let z = w - 72340172838076673 as i64 & (w ^ (-1) as i64) & (-9187201950435737472) as i64;
          if (z != 0 as i64) {
            nlen += __ctz64(z as u64) >> 3;
            scan = 0;
          } else {
            nlen += 8;
          }
        }
        if (scan == 1) {
          while (__raw_load8(buf, pos + 19 + nlen) != 0) {
            nlen += 1;
          }
        }
        {
          let skip = 0;
          if (nlen == 1) {
            if (__raw_load8(buf, pos + 19) == 46) {
              skip = 1;
            }
          }
          if (nlen == 2) {
            if (__raw_load8(buf, pos + 19) == 46) {
              if (__raw_load8(buf, pos + 19 + 1) == 46) {
                skip = 1;
              }
            }
          }
          if (skip == 0) {
            let nbuf = __raw_arr_box((nlen + 7) / 8);
            __store_i64(nbuf, nlen as i64);
            __memcpy(nbuf + 8, buf + pos + 19, nlen);
            let name_bytes = __raw_array(nbuf);
            names = names.append(name_bytes);
          }
          pos += reclen;
        }
      }
    }
    let buf_own = __raw_string(buf, 65536);
  }
  let basep_own = __raw_string(basep, 8);
  __syscall3(57, fd as i64, 0, 0);
  if (bad < 0) {
    return Err(__fern_io_error(-bad, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(names);
}
