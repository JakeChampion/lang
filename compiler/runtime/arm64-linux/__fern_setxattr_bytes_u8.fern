function __fern_setxattr_bytes_u8(path: string, name: string, value: i32[]): Result[void, IoError] {
  let vlen: i32 = value.len();
  let vp: usize = __raw_arr_ptr(value) + 8;
  let nlen: i32 = name.len();
  let namez: usize = __raw_alloc(nlen + 1);
  let j: i32 = 0;
  while (j < nlen) {
    __raw_store8(namez, j, name[j] as i32);
    j = j + 1;
  }
  __raw_store8(namez, nlen, 0);
  let plen: i32 = path.len();
  let pathz: usize = __raw_alloc(plen + 1);
  let i: i32 = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i = i + 1;
  }
  __raw_store8(pathz, plen, 0);
  let rc: i32 = __syscall5(5, pathz as i64, namez as i64, vp as i64, vlen as i64, 0) as i32;
  let namez_own: string = __raw_string(namez, nlen + 1);
  let pathz_own: string = __raw_string(pathz, plen + 1);
  if (rc < 0) {
    return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(());
}
