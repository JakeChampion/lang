function __fern_dir_openat(dirfd: i32, path: string, flags: i32, mode: i32): Result[i32, IoError] {
  if (__count_byte(path, 0) > 0) {
    return Err(__fern_io_error(22, __fern_path_copy(path, path.len())));
  }
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let pathz_own = __raw_string(pathz, plen + 1);
  let fd = __syscall4(56, dirfd as i64, pathz as i64, flags as i64, mode as i64) as i32;
  if (fd >= 0 && fd < 3) {
    let moved = __syscall3(25, fd as i64, 0, 3) as i32;
    __syscall3(57, fd as i64, 0, 0);
    fd = moved;
  }
  if (fd < 0) {
    return Err(__fern_io_error(-fd, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(fd);
}
