function __fern_read_file(path: string): Result[string, IoError] {
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let fd = __syscall3(56, -100, pathz as i64, 0) as i32;
  let pathz_own = __raw_string(pathz, plen + 1);
  if (fd < 0) {
    return Err(__fern_io_error(-fd, __fern_path_copy(pathz_own, plen)));
  }
  let st = __raw_scratch(160);
  let src = __syscall3(80, fd as i64, st as i64, 0) as i32;
  if (src < 0) {
    __syscall3(57, fd as i64, 0, 0);
    return Err(__fern_io_error(-src, __fern_path_copy(pathz_own, plen)));
  }
  let size = __load_i64(st + 48) as i32;
  let cap = size;
  if (cap < 1) {
    cap = 1;
  }
  let buf = __raw_alloc(cap);
  let got = 0;
  let bad = 0;
  let done = 0;
  while (done == 0) {
    if (got >= cap) {
      let pn = __syscall3(63, fd as i64, st as i64, 1) as i32;
      if (pn < 0 && pn != -4) {
        bad = pn;
        done = 1;
      } else {
        if (pn == 0) {
          done = 1;
        } else if (pn > 0) {
          let nc = cap * 2;
          if (nc < 4096) {
            nc = 4096;
          }
          let nb = __raw_alloc(nc);
          let k = 0;
          while (k < got) {
            __raw_store8(nb, k, __raw_load8(buf, k));
            k += 1;
          }
          let old_own = __raw_string(buf, cap);
          buf = nb;
          cap = nc;
          __raw_store8(buf, got, __raw_load8(st, 0));
          got += 1;
        }
      }
    } else {
      let n = __syscall3(63, fd as i64, (buf + got as usize) as i64, (cap - got) as i64) as i32;
      if (n < 0 && (n != -4 || got == 0)) {
        bad = n;
        done = 1;
      } else {
        if (n == 0) {
          done = 1;
        } else {
          if (n > 0) {
            got += n;
          }
        }
      }
    }
  }
  __syscall3(57, fd as i64, 0, 0);
  if (bad < 0) {
    let buf_own = __raw_string(buf, cap);
    return Err(__fern_io_error(-bad, __fern_path_copy(pathz_own, plen)));
  }
  if (__fern_utf8_valid(buf, got) == 0) {
    let buf_own = __raw_string(buf, cap);
    return Err(InvalidUtf8(__fern_path_copy(pathz_own, plen)));
  }
  if (got == cap) {
    return Ok(__raw_string(buf, got));
  }
  let buf_own = __raw_string(buf, cap);
  return Ok(__fern_path_copy(buf_own, got));
}
