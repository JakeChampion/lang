function __fern_udp_recvmmsg_u8(fd: i32, buf: i32[], froms: i32[], lens: i32[]): i32 {
  let n = lens.len() / 3;
  if (n == 0) {
    return 0;
  }
  let stride = buf.len() / n;
  if (stride == 0) {
    return -22;
  }
  // The table: one 64-byte mmsghdr per message, then per message a 16-byte
  // iovec, a 32-byte sockaddr and a 48-byte control block. The box becomes
  // an array only after the call, because an array is released at its last
  // use, and the kernel writes the table during the call.
  let slots = 20 * n;
  let p = __raw_arr_box(slots + 1);
  __store_i64(p, slots as i64);
  let base = p + 8;
  let z = 0;
  while (z < slots) {
    __raw_store_ptr(base, z, 0 as usize);
    z += 1;
  }
  let bytes = __raw_arr_ptr(buf) + 8;
  let extra = base + (64 * n) as usize;
  let i = 0;
  while (i < n) {
    let hdr = base + (64 * i) as usize;
    let iov = extra + (96 * i) as usize;
    __raw_store_ptr(iov, 0, bytes + (stride * i) as usize);
    __raw_store_ptr(iov, 1, stride as usize);
    __raw_store_ptr(hdr, 0, iov + 16);
    __raw_store_ptr(hdr, 1, 28 as usize);
    __raw_store_ptr(hdr, 2, iov);
    __raw_store_ptr(hdr, 3, 1 as usize);
    __raw_store_ptr(hdr, 4, iov + 48);
    __raw_store_ptr(hdr, 5, 48 as usize);
    i += 1;
  }
  let rc = __syscall5(243, fd as i64, base as i64, n as i64, 65536, 0) as i32;
  let fp = __raw_arr_ptr(froms) + 8;
  let named = froms.len();
  let lp = __raw_arr_ptr(lens);
  i = 0;
  while (i < rc) {
    let hdr = base + (64 * i) as usize;
    let sa = extra + (96 * i) as usize + 16;
    let cm = sa + 32;
    let seg = 0;
    let tos = 0;
    let clen = __raw_load_ptr(hdr, 5) as i32;
    let off = 0;
    while (off + 16 <= clen) {
      let len = __raw_load_ptr(cm, off / 8) as i32;
      if (len < 16) {
        break;
      }
      let level = __raw_load8(cm, off + 8) | __raw_load8(cm, off + 9) << 8;
      let kind = __raw_load8(cm, off + 12) | __raw_load8(cm, off + 13) << 8;
      if (level == 17 && kind == 104) {
        seg = __raw_load8(cm, off + 16) | __raw_load8(cm, off + 17) << 8;
      }
      if (level == 0 && kind == 1 || level == 41 && kind == 67) {
        tos = __raw_load8(cm, off + 16);
      }
      off += (len + 7) / 8 * 8;
    }
    if (named >= 19 * (i + 1)) {
      let f = fp + (19 * i) as usize;
      z = 0;
      while (z < 19) {
        __raw_store8(f, z, 0);
        z += 1;
      }
      let fam = __raw_load8(sa, 0) | __raw_load8(sa, 1) << 8;
      let n_addr = 0;
      let at = 4;
      if (fam == 2) {
        __raw_store8(f, 0, 4);
        n_addr = 4;
      } else if (fam == 10) {
        __raw_store8(f, 0, 6);
        n_addr = 16;
        at = 8;
      }
      let k = 0;
      while (k < n_addr) {
        __raw_store8(f, 1 + k, __raw_load8(sa, at + k));
        k += 1;
      }
      __raw_store8(f, 17, __raw_load8(sa, 2));
      __raw_store8(f, 18, __raw_load8(sa, 3));
    }
    __raw_store_ptr(lp, 3 * i + 1, (__raw_load_ptr(hdr, 7) as i64 & 4294967295) as usize);
    __raw_store_ptr(lp, 3 * i + 2, seg as usize);
    __raw_store_ptr(lp, 3 * i + 3, tos as usize);
    i += 1;
  }
  let table: i32[] = __raw_array(p);
  return rc;
}
