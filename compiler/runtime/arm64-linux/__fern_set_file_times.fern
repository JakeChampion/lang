function __fern_set_file_times(path: string, asec: i64, ansec: i64, msec: i64, mnsec: i64, flags: i32): Result[void, IoError] {
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let a0 = asec;
  let a1 = ansec;
  let m0 = msec;
  let m1 = mnsec;
  if ((flags & 8) != 0) {
    a0 = 0 as i64;
    a1 = 1073741823 as i64;
  }
  if ((flags & 16) != 0) {
    m0 = 0 as i64;
    m1 = 1073741823 as i64;
  }
  if ((flags & 2) != 0) {
    a0 = 0 as i64;
    a1 = 1073741822 as i64;
  }
  if ((flags & 4) != 0) {
    m0 = 0 as i64;
    m1 = 1073741822 as i64;
  }
  let ts = __raw_scratch(32);
  __store_i64(ts, a0);
  __store_i64(ts + 8, a1);
  __store_i64(ts + 16, m0);
  __store_i64(ts + 24, m1);
  let kf = 0;
  if ((flags & 1) != 0) {
    kf = 256;
  }
  let rc = __syscall4(88, -100, pathz as i64, ts as i64, kf as i64) as i32;
  let pathz_own = __raw_string(pathz, plen + 1);
  if (rc < 0) {
    return Err(__fern_io_error(-rc, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(());
}
