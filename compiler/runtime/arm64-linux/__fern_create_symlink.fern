function __fern_create_symlink(target: string, path: string): Result[void, IoError] {
  let tlen: i32 = target.len();
  let targetz: usize = __raw_alloc(tlen + 1);
  let j: i32 = 0;
  while (j < tlen) {
    __raw_store8(targetz, j, target[j] as i32);
    j = j + 1;
  }
  __raw_store8(targetz, tlen, 0);
  let plen: i32 = path.len();
  let pathz: usize = __raw_alloc(plen + 1);
  let i: i32 = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i = i + 1;
  }
  __raw_store8(pathz, plen, 0);
  let rc: i32 = __syscall3(36, targetz as i64, -100, pathz as i64) as i32;
  let targetz_own: string = __raw_string(targetz, tlen + 1);
  let pathz_own: string = __raw_string(pathz, plen + 1);
  if (rc < 0) {
    return Err(__fern_io_error(0 - rc, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(());
}
