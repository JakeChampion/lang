function __fern_read_file_bytes(path: string): Result[i32[], IoError] {
  let plen: i32 = path.len();
  let pathz: usize = __raw_alloc(plen + 1);
  let i: i32 = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i = i + 1;
  }
  __raw_store8(pathz, plen, 0);
  let fd: i32 = __syscall3(56, -100, pathz as i64, 0) as i32;
  let pathz_own: string = __raw_string(pathz, plen + 1);
  if (fd < 0) {
    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));
  }
  let st: usize = __raw_scratch(160);
  let src: i32 = __syscall3(80, fd as i64, st as i64, 0) as i32;
  if (src < 0) {
    __syscall3(57, fd as i64, 0, 0);
    return Err(__fern_io_error(0 - src, __fern_path_copy(pathz_own, plen)));
  }
  let size: i32 = __load_i64(st + 48) as i32;
  let cap: i32 = size;
  if (cap < 1) {
    cap = 1;
  }
  let buf: usize = __raw_alloc(cap);
  let got: i32 = 0;
  let bad: i32 = 0;
  let done: i32 = 0;
  while (done == 0) {
    if (got >= cap) {
      let pn: i32 = __syscall3(63, fd as i64, st as i64, 1) as i32;
      if (pn < 0) {
        bad = pn;
        done = 1;
      } else {
        if (pn == 0) {
          done = 1;
        } else {
          let nc: i32 = cap * 2;
          if (nc < 4096) {
            nc = 4096;
          }
          let nb: usize = __raw_alloc(nc);
          let k: i32 = 0;
          while (k < got) {
            __raw_store8(nb, k, __raw_load8(buf, k));
            k = k + 1;
          }
          let old_own: string = __raw_string(buf, cap);
          buf = nb;
          cap = nc;
          __raw_store8(buf, got, __raw_load8(st, 0));
          got = got + 1;
        }
      }
    } else {
      let n: i32 = __syscall3(63, fd as i64, (buf + got) as i64, (cap - got) as i64) as i32;
      if (n < 0) {
        bad = n;
        done = 1;
      } else {
        if (n == 0) {
          done = 1;
        } else {
          got = got + n;
        }
      }
    }
  }
  __syscall3(57, fd as i64, 0, 0);
  if (bad < 0) {
    let buf_own0: string = __raw_string(buf, cap);
    return Err(__fern_io_error(0 - bad, __fern_path_copy(pathz_own, plen)));
  }
  let b: usize = __raw_arr_box(got);
  let j: i32 = 0;
  while (j < got) {
    __raw_store_ptr(b, j + 1, __raw_load8(buf, j) as usize);
    j = j + 1;
  }
  let buf_own: string = __raw_string(buf, cap);
  return Ok(__raw_array(b));
}
