function __fern_mounts(): Result[MountEntry[], IoError] {
  let path: string = "/proc/self/mountinfo";
  let plen: i32 = path.len();
  let pathz: usize = __raw_alloc(plen + 1);
  let i: i32 = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i = i + 1;
  }
  __raw_store8(pathz, plen, 0);
  let fd: i32 = __syscall3(56, -100, pathz as i64, 0) as i32;
  let pathz_own: string = __raw_string(pathz, plen + 1);
  if (fd < 0) {
    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));
  }
  let cap: i32 = 4096;
  let buf: usize = __raw_alloc(cap);
  let got: i32 = 0;
  let bad: i32 = 0;
  let done: i32 = 0;
  while (done == 0) {
    if (got == cap) {
      let nb: usize = __raw_alloc(cap * 2);
      __memcpy(nb, buf + 0, got);
      let old_own: string = __raw_string(buf, cap);
      buf = nb;
      cap = cap * 2;
    }
    let n: i32 = __syscall3(63, fd as i64, (buf + got) as i64, (cap - got) as i64) as i32;
    if (n < 0) {
      bad = n;
      done = 1;
    } else {
      if (n == 0) {
        done = 1;
      } else {
        got = got + n;
      }
    }
  }
  __syscall3(57, fd as i64, 0, 0);
  if (bad < 0) {
    let buf_own0: string = __raw_string(buf, cap);
    return Err(__fern_io_error(0 - bad, __fern_path_copy(pathz_own, plen)));
  }
  let out: MountEntry[] = [];
  let ls: i32 = 0;
  while (ls < got) {
    let le: i32 = ls;
    while (le < got && __raw_load8(buf, le) != 10) {
      le = le + 1;
    }
    let fa: i32[] = [];
    let fb: i32[] = [];
    let j: i32 = ls;
    while (j < le) {
      while (j < le && (__raw_load8(buf, j) == 32 || __raw_load8(buf, j) == 9)) {
        j = j + 1;
      }
      if (j < le) {
        let st: i32 = j;
        while (j < le && !(__raw_load8(buf, j) == 32 || __raw_load8(buf, j) == 9)) {
          j = j + 1;
        }
        fa = fa.append(st);
        fb = fb.append(j);
      }
    }
    if (fa.len() >= 10) {
      let sep: i32 = 6;
      while (sep < fa.len() && !(fb[sep] - fa[sep] == 1 && __raw_load8(buf, fa[sep]) == 45)) {
        sep = sep + 1;
      }
      if (sep + 2 < fa.len()) {
        out = out.append(MountEntry { source: __fern_mount_field(buf, fa[sep + 2], fb[sep + 2]), target: __fern_mount_field(buf, fa[4], fb[4]), fstype: __fern_mount_field(buf, fa[sep + 1], fb[sep + 1]), dev: __fern_mount_devno(buf, fa[2], fb[2]) });
      }
    }
    ls = le + 1;
  }
  let buf_own: string = __raw_string(buf, cap);
  let vi: i32 = 0;
  while (vi < out.len()) {
    let m: MountEntry = out[vi];
    if (__fern_utf8_valid(__raw_data(m.source), m.source.len()) == 0 || __fern_utf8_valid(__raw_data(m.target), m.target.len()) == 0 || __fern_utf8_valid(__raw_data(m.fstype), m.fstype.len()) == 0) {
      return Err(InvalidUtf8(""));
    }
    vi = vi + 1;
  }
  return Ok(out);
}
