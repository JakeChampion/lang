  if (fam == 10) {
    tag = 6;
    n = 16;
    at = 8;
  } else if (fam != 2) {
    return -97;
  }
  let o = __raw_arr_ptr(out);
  z = 0;
  while (z < 19) {
    __raw_store8(o, 8 + z, 0);
