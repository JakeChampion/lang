  while (z < 32) {
    __raw_store8(sa, z, 0);
    z += 1;
  }
  __raw_store8(sa, 28, 28);
  let r = 0;
  if (peer) {
    r = __syscall3(205, fd as i64, sa as i64, (sa + 28) as i64) as i32;
  } else {
    r = __syscall3(204, fd as i64, sa as i64, (sa + 28) as i64) as i32;
  }
  if (r < 0) {
    return r;
  }
  let fam = __raw_load8(sa, 0) | __raw_load8(sa, 1) << 8;
  let tag = 4;
  let n = 4;
