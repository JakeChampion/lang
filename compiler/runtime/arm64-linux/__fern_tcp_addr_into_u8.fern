  let k = 0;
  while (k < n) {
    __raw_store8(o, 8 + (1 + k), __raw_load8(sa, at + k));
    k += 1;
  }
  __raw_store8(o, 8 + 17, __raw_load8(sa, 2));
  __raw_store8(o, 8 + 18, __raw_load8(sa, 3));
