function __fern_tcp_connect_with_u8(addr: i32[], port: i32, nonblocking: boolean): i32 {
  let af: i32 = 2;
  if (addr.len() == 16) {
    af = 10;
  } else if (addr.len() != 4) {
    return 0 - 97;
  }
  let fd: i32 = __syscall3(198, af as i64, 1, 0) as i32;
  if (fd < 0) {
    return fd;
  }
  let rc: i32 = 0;
  if (nonblocking) {
    let flags: i32 = __syscall3(25, fd as i64, 3, 0) as i32;
    rc = flags;
    if (flags >= 0) {
      rc = __syscall3(25, fd as i64, 4, (flags | 2048) as i64) as i32;
    }
  }
  if (rc >= 0) {
    let sa: usize = __raw_scratch(28);
    let salen: i32 = 16;
    let at: i32 = 4;
    if (addr.len() == 16) {
      salen = 28;
      at = 8;
    }
    let z: i32 = 0;
    while (z < 28) {
      __raw_store8(sa, z, 0);
      z = z + 1;
    }
    __raw_store8(sa, 0, af);
    __raw_store8(sa, 1, 0);
    __raw_store8(sa, 2, port >> 8 & 255);
    __raw_store8(sa, 3, port & 255);
    let ap: usize = __raw_arr_ptr(addr);
    let k: i32 = 0;
    while (k < addr.len()) {
      __raw_store8(sa, at + k, __raw_load8(ap, 8 + k));
      k = k + 1;
    }
    rc = __syscall3(203, fd as i64, sa as i64, salen as i64) as i32;
    if (nonblocking && rc == 0 - 115) {
      rc = 0;
    }
  }
  if (rc < 0) {
    __syscall3(57, fd as i64, 0, 0);
    return rc;
  }
  return fd;
}
