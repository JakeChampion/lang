function __fern_create_dir_all(path: string): Result[void, IoError] {
  if (__count_byte(path, 0) > 0) {
    return Err(__fern_io_error(22, __fern_path_copy(path, path.len())));
  }
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  // The full path first: its parent usually exists, and then one call does it.
  let rc = __syscall3(34, -100, pathz as i64, 511) as i32;
  if (rc == -2) {
    let j = 1;
    while (j < plen) {
      if (path[j] == 47) {
        if (path[j - 1] != 47) {
          __raw_store8(pathz, j, 0);
          rc = __syscall3(34, -100, pathz as i64, 511) as i32;
          __raw_store8(pathz, j, 47);
        }
      }
      j += 1;
    }
    rc = __syscall3(34, -100, pathz as i64, 511) as i32;
  }
  let pathz_own = __raw_string(pathz, plen + 1);
  if (rc < 0) {
    if (rc != -17) {
      return Err(__fern_io_error(-rc, __fern_path_copy(pathz_own, plen)));
    }
  }
  return Ok(());
}
