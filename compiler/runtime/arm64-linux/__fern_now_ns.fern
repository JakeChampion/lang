function __fern_now_ns(): i64 {
  let ts = __raw_scratch(16);
  let vf = __fern_vdso_clock();
  if (vf != 1 as usize) {
    let r = __c_call2(vf, 0 as usize, ts);
  } else {
    __syscall3(113, 0, ts as i64, 0);
  }
  let sec = __load_i64(ts);
  let sub = __load_i64(ts + 8);
  return sec * (1000000000 as i64) + sub * (1 as i64);
}
