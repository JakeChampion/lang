function __fern_udp_recvfrom(fd: i32, buf: i32[], from: i32[]): i32 {
  let max: i32 = buf.len();
  let p: usize = __raw_alloc(max + 1);
  let sa: usize = __raw_scratch(32);
  __raw_store8(sa, 28, 28);
  __raw_store8(sa, 29, 0);
  __raw_store8(sa, 30, 0);
  __raw_store8(sa, 31, 0);
  let n: i32 = __syscall6(207, fd as i64, p as i64, max as i64, 0, sa as i64, (sa + 28) as i64) as i32;
  let b: usize = __raw_arr_ptr(buf);
  let i: i32 = 0;
  while (i < n) {
    __raw_store_ptr(b, i + 1, __raw_load8(p, i) as usize);
    i = i + 1;
  }
  if (n >= 0 && from.len() >= 19) {
    let f: usize = __raw_arr_ptr(from);
    let z: i32 = 1;
    while (z <= 19) {
      __raw_store_ptr(f, z - 1 + 1, 0 as usize);
      z = z + 1;
    }
    let fam: i32 = __raw_load8(sa, 0) | __raw_load8(sa, 1) << 8;
    let n_addr: i32 = 0;
    let at: i32 = 4;
    if (fam == 2) {
      __raw_store_ptr(f, 0 + 1, 4 as usize);
      n_addr = 4;
    } else if (fam == 10) {
      __raw_store_ptr(f, 0 + 1, 6 as usize);
      n_addr = 16;
      at = 8;
    }
    let k: i32 = 0;
    while (k < n_addr) {
      __raw_store_ptr(f, 1 + k + 1, __raw_load8(sa, at + k) as usize);
      k = k + 1;
    }
    __raw_store_ptr(f, 17 + 1, __raw_load8(sa, 2) as usize);
    __raw_store_ptr(f, 18 + 1, __raw_load8(sa, 3) as usize);
  }
  let p_own: string = __raw_string(p, max + 1);
  return n;
}
