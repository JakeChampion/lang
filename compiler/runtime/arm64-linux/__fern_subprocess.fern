function __fern_subprocess(cmd: string, args: string[], input: string): ProcessResult {
  let clen: i32 = cmd.len();
  let cmdz: usize = __raw_alloc(clen + 1);
  let i: i32 = 0;
  while (i < clen) {
    __raw_store8(cmdz, i, cmd[i] as i32);
    i = i + 1;
  }
  __raw_store8(cmdz, clen, 0);
  let n: i32 = args.len();
  let argv: usize = __raw_alloc((n + 2) * 8);
  __raw_store_ptr(argv, 0, cmdz);
  let total: i32 = 1;
  let m: i32 = 0;
  while (m < n) {
    total = total + args[m].len() + 1;
    m = m + 1;
  }
  let ab: usize = __raw_alloc(total);
  let off: i32 = 0;
  let k: i32 = 0;
  while (k < n) {
    let a: string = args[k];
    let al: i32 = a.len();
    __raw_store_ptr(argv, k + 1, ab + off);
    let j: i32 = 0;
    while (j < al) {
      __raw_store8(ab, off + j, a[j] as i32);
      j = j + 1;
    }
    __raw_store8(ab, off + al, 0);
    off = off + al + 1;
    k = k + 1;
  }
  __raw_store_ptr(argv, n + 1, 0);
  let fds: usize = __raw_alloc(32);
  __syscall3(59, fds as i64, 0, 0);
  __syscall3(59, (fds + 8) as i64, 0, 0);
  __syscall3(59, (fds + 16) as i64, 0, 0);
  let in_r: i32 = __load_i32(fds);
  let in_w: i32 = __load_i32(fds + 4);
  let out_r: i32 = __load_i32(fds + 8);
  let out_w: i32 = __load_i32(fds + 12);
  let err_r: i32 = __load_i32(fds + 16);
  let err_w: i32 = __load_i32(fds + 20);
  let pid: i32 = __syscall5(220, 17, 0, 0, 0, 0) as i32;
  if (pid == 0) {
    __syscall3(24, in_r as i64, 0, 0);
    __syscall3(24, out_w as i64, 1, 0);
    __syscall3(24, err_w as i64, 2, 0);
    __syscall3(57, in_r as i64, 0, 0);
    __syscall3(57, in_w as i64, 0, 0);
    __syscall3(57, out_r as i64, 0, 0);
    __syscall3(57, out_w as i64, 0, 0);
    __syscall3(57, err_r as i64, 0, 0);
    __syscall3(57, err_w as i64, 0, 0);
    let envp: usize = __raw_environ();
    let rc0: i32 = __syscall3(221, cmdz as i64, argv as i64, envp as i64) as i32;
    let pre: usize = __raw_alloc(9);
    __raw_store8(pre, 0, 47);
    __raw_store8(pre, 1, 98);
    __raw_store8(pre, 2, 105);
    __raw_store8(pre, 3, 110);
    __raw_store8(pre, 4, 47);
    __fern_sp_exec_at(pre, 5, cmdz, clen, argv, envp);
    __raw_store8(pre, 1, 117);
    __raw_store8(pre, 2, 115);
    __raw_store8(pre, 3, 114);
    __raw_store8(pre, 4, 47);
    __raw_store8(pre, 5, 98);
    __raw_store8(pre, 6, 105);
    __raw_store8(pre, 7, 110);
    __raw_store8(pre, 8, 47);
    __fern_sp_exec_at(pre, 9, cmdz, clen, argv, envp);
    __fern_sp_exec_failed(cmdz, clen, rc0);
  }
  __syscall3(57, in_r as i64, 0, 0);
  __syscall3(57, out_w as i64, 0, 0);
  __syscall3(57, err_w as i64, 0, 0);
  if (input.len() > 0) {
    __syscall3(64, in_w as i64, __raw_data(input) as i64, input.len() as i64);
  }
  __syscall3(57, in_w as i64, 0, 0);
  let obuf: usize = __raw_alloc(65536);
  let olen: i32 = __fern_sp_drain(out_r, obuf);
  let ebuf: usize = __raw_alloc(65536);
  let elen: i32 = __fern_sp_drain(err_r, ebuf);
  __syscall4(260, pid as i64, (fds + 24) as i64, 0, 0);
  let w: i32 = __load_i32(fds + 24);
  let code: i32 = w >> 8 & 255;
  if ((w & 127) != 0) {
    code = (w & 127) + 128;
  }
  let fds_own: string = __raw_string(fds, 32);
  let cmdz_own: string = __raw_string(cmdz, clen + 1);
  let ab_own: string = __raw_string(ab, total);
  let argv_own: string = __raw_string(argv, (n + 2) * 8);
  let sout: string = "";
  if (olen > 0) {
    let so: usize = __raw_alloc(olen);
    __memcpy(so, obuf, olen);
    sout = __raw_string(so, olen);
  }
  let serr: string = "";
  if (elen > 0) {
    let se: usize = __raw_alloc(elen);
    __memcpy(se, ebuf, elen);
    serr = __raw_string(se, elen);
  }
  let obuf_own: string = __raw_string(obuf, 65536);
  let ebuf_own: string = __raw_string(ebuf, 65536);
  return ProcessResult { stdout: sout, stderr: serr, exit_code: code };
}
