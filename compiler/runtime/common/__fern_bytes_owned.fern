function __fern_bytes_owned(bytes: usize): i32[] {
  let n: i32 = 0;
  let p: usize = 0;
  if ((bytes as i32 & 2) != 0) {
    let base: usize = bytes - 2;
    n = __load_i32(base + 8);
    p = __raw_load_ptr(base, 0);
  } else {
    n = __load_i32(bytes);
    p = bytes + 8;
  }
  if (n == 0) {
    return [];
  }
  let b: usize = __raw_arr_box((n + 7) / 8);
  __store_i64(b, n as i64);
  __memcpy(b + 8, p, n);
  return __raw_array(b);
}
