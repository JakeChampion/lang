function __fern_task_tab(): usize {
  let st: usize = __raw_task_state();
  let tab: usize = __raw_load_ptr(st, 1);
  if (tab == 0 as usize) {
    tab = __alloc(512);
    let i: i32 = 0;
    while (i < 64) {
      __raw_store_ptr(tab, i, 0 as usize);
      i = i + 1;
    }
    __raw_store_ptr(st, 1, tab);
    __raw_store_ptr(st, 2, 64 as usize);
  }
  return tab;
}
