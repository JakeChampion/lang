function __fern_str_trim(s: string): string {
  let n = s.len();
  let start = 0;
  let go = 1;
  while (go == 1) {
    if (start >= n) {
      go = 0;
    } else {
      let c = s[start] as i32;
      if (c == 32 || c >= 9 && c <= 13) {
        start += 1;
      } else {
        go = 0;
      }
    }
  }
  let end = n;
  let go2 = 1;
  while (go2 == 1) {
    if (end <= start) {
      go2 = 0;
    } else {
      let c2 = s[end - 1] as i32;
      if (c2 == 32 || c2 >= 9 && c2 <= 13) {
        end -= 1;
      } else {
        go2 = 0;
      }
    }
  }
  return slice_unchecked(s, start, end) + "";
}
