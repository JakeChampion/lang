function __fern_arr_slice_u8(a: i32[], start: i32, end: i32): i32[] {
  let n: i32 = a.len();
  let bad: i32 = 0;
  if (end < 0) {
    bad = 1;
  }
  if (end > n) {
    bad = 1;
  }
  if (start < 0) {
    bad = 1;
  }
  if (start > end) {
    bad = 1;
  }
  if (bad == 1) {
    __fern_slice_abort();
  }
  let m: i32 = end - start;
  let p: usize = __raw_arr_box((m + 7) / 8);
  __store_i64(p, m as i64);
  __memcpy(p + 8, __raw_arr_ptr(a) + 8 + start, m);
  return __raw_array(p);
}
