function __fern_str_to_upper(s: string): string {
  let n = s.len();
  let p = __raw_alloc(n);
  let src = __raw_data(s);
  let i = 0;
  // Eight bytes in each pass. Bit 7 of a byte of `m` marks a letter from
  // a to z: the low seven bits are at least 'a' and at most 'z', and the
  // byte is ASCII.
  while (i + 8 <= n) {
    let w = __load_i64(src + i as usize) as u64;
    let low = w & 0x7f7f7f7f7f7f7f7f as u64;
    let m = low + 0x1f1f1f1f1f1f1f1f as u64 & ~(low + 0x0505050505050505 as u64) & ~w & 0x8080808080808080 as u64;
    __store_i64(p + i as usize, (w ^ m >> 2u64) as i64);
    i += 8;
  }
  while (i < n) {
    let c = s[i] as i32;
    if (c >= 97) {
      if (c <= 122) {
        c -= 32;
      }
    }
    __raw_store8(p, i, c);
    i += 1;
  }
  return __raw_string(p, n);
}
