function __fern_task_park(set: i32[], timeout_ms: i32): i32 {
  let st: usize = __raw_task_state();
  let id: i32 = __raw_load_ptr(st, 0) as i32;
  if (id == 0) {
    return 0 - 1;
  }
  let rec: usize = __raw_load_ptr(st, 3);
  let mode: i32 = __raw_load_ptr(rec, 0) as i32;
  if (mode == 2) {
    __raw_store_ptr(rec, 0, 0 as usize);
    if (__raw_load_ptr(rec, 3) != 0 as usize) {
      return 0 - 2;
    }
    return __raw_load_ptr(rec, 2) as i32;
  }
  if (__raw_load_ptr(rec, 3) != 0 as usize) {
    return 0 - 2;
  }
  __raw_store_ptr(rec, 0, 1 as usize);
  __raw_store_ptr(rec, 1, timeout_ms as usize);
  let n: i32 = set.len();
  let buf: usize = __raw_load_ptr(rec, 8);
  if (n > __raw_load_ptr(rec, 10) as i32) {
    if (buf != 0 as usize) {
      __free(buf, __raw_load_ptr(rec, 10) as i32 * 8);
    }
    buf = __alloc(n * 8);
    __raw_store_ptr(rec, 8, buf);
    __raw_store_ptr(rec, 10, n as usize);
  }
  let i: i32 = 0;
  while (i < n) {
    __raw_store_ptr(buf, i, set[i] as usize);
    i = i + 1;
  }
  __raw_store_ptr(rec, 9, n as usize);
  return 0;
}
