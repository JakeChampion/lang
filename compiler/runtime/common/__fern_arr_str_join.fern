function __fern_arr_str_join(xs: string[], sep: string): string {
  let n = xs.len();
  if (n == 0) {
    return "";
  }
  let ls = sep.len();
  let total = ls as i64 * ((n - 1) as i64);
  let i: i32 = 0;
  while (i < n) {
    total += xs[i].len() as i64;
    i += 1;
  }
  let size = __alloc_len(total);
  let p = __raw_alloc(size);
  let off: i32 = 0;
  let j: i32 = 0;
  while (j < n) {
    if (j > 0) {
      __memcpy(p + off as usize, __raw_data(sep), ls);
      off += ls;
    }
    let e = xs[j];
    let le = e.len();
    __memcpy(p + off as usize, __raw_data(e), le);
    off += le;
    j += 1;
  }
  return __raw_string(p, size);
}
