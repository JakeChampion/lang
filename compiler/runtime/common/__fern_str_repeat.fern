function __fern_str_repeat(s: string, n: i32): string {
  let slen = s.len();
  let count = n;
  if (count < 0) {
    count = 0;
  }
  let total64 = slen as i64 * (count as i64);
  let total = total64 as i32;
  if (total64 > 2147483647) {
    total = -1;
  }
  if (total == 0) {
    return "";
  }
  let p = __raw_alloc(total);
  let w = 0;
  let k = 0;
  while (k < count) {
    let j = 0;
    while (j < slen) {
      __raw_store8(p, w, s[j] as i32);
      w += 1;
      j += 1;
    }
    k += 1;
  }
  return __raw_string(p, total);
}
