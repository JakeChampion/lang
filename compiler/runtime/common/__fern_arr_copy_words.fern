function __fern_arr_copy_words(dst: usize, src: usize, count: i32): i32 {
  // A copy of count eight-byte slots, in parts that keep each byte count in an i32.
  let to = dst;
  let from = src;
  let left = count;
  while (left > 0) {
    let part = left;
    if (part > 134217728) {
      part = 134217728;
    }
    __memcpy(to, from, part * 8);
    to = to + (part * 8) as usize;
    from = from + (part * 8) as usize;
    left -= part;
  }
  return 0;
}
