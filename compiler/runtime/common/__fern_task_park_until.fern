function __fern_task_park_until(set: i32[], until_ns: i64): i32 {
  let st = __raw_task_state();
  let id = __raw_load_ptr(st, 0) as i32;
  if (id == 0) {
    return -1;
  }
  let rec = __raw_load_ptr(st, 3);
  let mode = __raw_load_ptr(rec, 0) as i32;
  if (mode == 2) {
    __raw_store_ptr(rec, 0, 0 as usize);
    __raw_store_ptr(st, 6, 0 as usize);
    if (__raw_load_ptr(rec, 3) != 0 as usize) {
      return -2;
    }
    return __raw_load_ptr(rec, 2) as i32;
  }
  if (__raw_load_ptr(rec, 3) != 0 as usize) {
    return -2;
  }
  __raw_store_ptr(rec, 0, 1 as usize);
  __raw_store_ptr(st, 6, 1 as usize);
  __raw_store_ptr(rec, 1, until_ns as usize);
  let n = set.len();
  let buf = __raw_load_ptr(rec, 8);
  if (n > __raw_load_ptr(rec, 10) as i32) {
    if (buf != 0 as usize) {
      __free(buf, __raw_load_ptr(rec, 10) as i32 * 8);
    }
    buf = __alloc(n * 8);
    __raw_store_ptr(rec, 8, buf);
    __raw_store_ptr(rec, 10, n as usize);
  }
  let i = 0;
  while (i < n) {
    __raw_store_ptr(buf, i, set[i] as usize);
    i += 1;
  }
  __raw_store_ptr(rec, 9, n as usize);
  return 0;
}
