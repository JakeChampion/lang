function __fern_task_new(): i32 {
  let st: usize = __raw_task_state();
  let tab: usize = __fern_task_tab();
  let cap: i32 = __raw_load_ptr(st, 2) as i32;
  let id: i32 = 1;
  while (id < cap) {
    let rec: usize = __raw_load_ptr(tab, id);
    if (rec == 0 as usize) {
      __raw_store_ptr(tab, id, __fern_task_blank());
      return id;
    }
    if (__raw_load_ptr(rec, 7) != 0 as usize) {
      __raw_store_ptr(rec, 7, 0 as usize);
      __raw_store_ptr(rec, 0, 0 as usize);
      __raw_store_ptr(rec, 1, 0 as usize);
      __raw_store_ptr(rec, 2, 0 as usize);
      __raw_store_ptr(rec, 3, 0 as usize);
      __raw_store_ptr(rec, 5, 0 as usize);
      __raw_store_ptr(rec, 9, 0 as usize);
      return id;
    }
    id = id + 1;
  }
  let ntab: usize = __alloc(cap * 16);
  let j: i32 = 0;
  while (j < cap * 2) {
    let v: usize = 0 as usize;
    if (j < cap) {
      v = __raw_load_ptr(tab, j);
    }
    __raw_store_ptr(ntab, j, v);
    j = j + 1;
  }
  __free(tab, cap * 8);
  __raw_store_ptr(st, 1, ntab);
  __raw_store_ptr(st, 2, (cap * 2) as usize);
  __raw_store_ptr(ntab, cap, __fern_task_blank());
  return cap;
}
