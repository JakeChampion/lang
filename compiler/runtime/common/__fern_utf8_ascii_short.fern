// 1 when the n bytes at buf, fewer than 32, are all ASCII. Short text, such
// as a file name, needs one pass of word loads.
function __fern_utf8_ascii_short(buf: usize, n: i32): i32 {
  let w = 0 as i64;
  let j = 0;
  if (n >= 8) {
    w = __load_i64(buf + (n - 8) as usize);
    while (j + 8 < n) {
      w = w | __load_i64(buf + j as usize);
      j += 8;
    }
  } else {
    while (j < n) {
      w = w | __raw_load8(buf, j) as i64;
      j += 1;
    }
  }
  if ((w & (-9187201950435737472) as i64) == 0 as i64) {
    return 1;
  }
  return 0;
}
