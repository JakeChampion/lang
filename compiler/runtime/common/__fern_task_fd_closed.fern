function __fern_task_fd_closed(fd: i32): i32 {
  if (fd < 0) {
    return 0;
  }
  let tab = __raw_load_ptr(__raw_task_state(), 7);
  if (tab == 0 as usize) {
    return 0;
  }
  if (fd >= __raw_load_ptr(tab, 0) as i32) {
    return 0;
  }
  __raw_store_ptr(tab, fd + 1, __raw_load_ptr(tab, fd + 1) + 1 as usize);
  return 0;
}
