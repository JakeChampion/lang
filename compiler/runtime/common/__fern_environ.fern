function __fern_environ(): string[] {
  let out: string[] = [];
  let envp = __raw_environ();
  if (envp == 0 as usize) {
    return out;
  }
  let idx = 0;
  let done = 0;
  while (done == 0) {
    let entry = __raw_load_ptr(envp, idx);
    if (entry == 0) {
      done = 1;
    } else {
      let n = 0;
      while (__raw_load8(entry, n) != 0) {
        n += 1;
      }
      let e = "";
      if (n > 0) {
        let b = __raw_alloc(n);
        __memcpy(b, entry, n);
        e = __raw_string(b, n);
      }
      out = out.append(e);
      idx += 1;
    }
  }
  return out;
}
