function __fern_env(name: string): Option[string] {
  let nlen: i32 = name.len();
  let first: i32 = 61;
  let k0: i32 = 0;
  if (nlen > 0) {
    first = name[0] as i32;
    k0 = 1;
  }
  let envp: usize = __raw_environ();
  let idx: i32 = 0;
  let entry: usize = __raw_load_ptr(envp, 0);
  while (entry != 0) {
    if (__raw_load8(entry, 0) == first) {
      let k: i32 = k0;
      while (k < nlen && __raw_load8(entry, k) == name[k] as i32) {
        k = k + 1;
      }
      if (k == nlen && __raw_load8(entry, nlen) == 61) {
        let vs: i32 = nlen + 1;
        let vlen: i32 = 0;
        while (__raw_load8(entry, vs + vlen) != 0) {
          vlen = vlen + 1;
        }
        if (vlen == 0) {
          return Some("");
        }
        let vbuf: usize = __raw_alloc(vlen);
        let c: i32 = 0;
        while (c < vlen) {
          __raw_store8(vbuf, c, __raw_load8(entry, vs + c));
          c = c + 1;
        }
        return Some(__raw_string(vbuf, vlen));
      }
    }
    idx = idx + 1;
    entry = __raw_load_ptr(envp, idx);
  }
  return None;
}
