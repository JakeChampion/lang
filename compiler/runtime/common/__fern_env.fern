function __fern_env(name: string): Option[string] {
  let nlen = name.len();
  let first = 61;
  let k0 = 0;
  if (nlen > 0) {
    first = name[0] as i32;
    k0 = 1;
  }
  let envp = __raw_environ();
  if (envp == 0 as usize) {
    return None;
  }
  let idx = 0;
  let entry = __raw_load_ptr(envp, 0);
  while (entry != 0) {
    if (__raw_load8(entry, 0) == first) {
      let k = k0;
      while (k < nlen && __raw_load8(entry, k) == name[k] as i32) {
        k += 1;
      }
      if (k == nlen && __raw_load8(entry, nlen) == 61) {
        let vs = nlen + 1;
        let vlen = 0;
        while (__raw_load8(entry, vs + vlen) != 0) {
          vlen += 1;
        }
        if (vlen == 0) {
          return Some("");
        }
        let vbuf = __raw_alloc(vlen);
        let c = 0;
        while (c < vlen) {
          __raw_store8(vbuf, c, __raw_load8(entry, vs + c));
          c += 1;
        }
        return Some(__raw_string(vbuf, vlen));
      }
    }
    idx += 1;
    entry = __raw_load_ptr(envp, idx);
  }
  return None;
}
