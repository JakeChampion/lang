@noinline
function __fern_bytes_append_back_slow(own a: i32[], dist: i32, n: i32): i32[] {
  if (n <= 0) {
    return a;
  }
  let len = a.len();
  if (dist < 1 || dist > len) {
    __fern_oob_abort();
  }
  let total64: i64 = len as i64 + n as i64;
  if (total64 > 2147483647i64) {
    return __raw_array(__raw_arr_box(0 - 1));
  }
  let cap: i64 = __load_i64(__raw_arr_ptr(a) - 16);
  let reuse = __FERN_RUNTIME_REUSE && __load_i32(__raw_arr_ptr(a) - 8) == 1 && total64 + 8i64 <= cap * 8i64;
  let out = a;
  if (!reuse) {
    let words: i64 = cap;
    if (words < 4i64) {
      words = 4i64;
    }
    while (words * 8i64 < total64 + 8i64) {
      words = words * 2i64;
    }
    out = __fern_bytes_clone(out, words as i32);
  }
  let base: usize = __raw_arr_ptr(out) + 8;
  let at = len;
  let total = total64 as i32;
  let step = dist;
  if (dist < 8) {
    while (step < 8) {
      step = step + dist;
    }
    let stop = len + step;
    if (stop > total) {
      stop = total;
    }
    while (at < stop) {
      __store_u8(base + at, __load_u8(base + at - dist));
      at = at + 1;
    }
  }
  while (at < total) {
    __store_i64(base + at, __load_i64(base + at - step));
    at = at + 8;
  }
  __store_i64(__raw_arr_ptr(out), total64);
  return out;
}
