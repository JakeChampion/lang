function __fern_str_split(s: string, sep: string): string[] {
  let lenS = s.len();
  let lenSep = sep.len();
  let out: string[] = [];
  if (lenSep == 0) {
    let k = 0;
    while (k < lenS) {
      let w = __fern_utf8_step(s, k, lenS);
      out = out.append(slice_unchecked(s, k, k + w) + "");
      k += w;
    }
    return out;
  }
  let start = 0;
  let i = 0;
  while (i + lenSep <= lenS) {
    let j = 0;
    let m = 1;
    while (j < lenSep) {
      if (s[i + j] != sep[j]) {
        m = 0;
        j = lenSep;
      } else {
        j += 1;
      }
    }
    if (m == 1) {
      out = out.append(slice_unchecked(s, start, i) + "");
      i += lenSep;
      start = i;
    } else {
      i += 1;
    }
  }
  out = out.append(slice_unchecked(s, start, lenS) + "");
  return out;
}
