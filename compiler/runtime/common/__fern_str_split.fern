function __fern_str_split(s: string, sep: string): string[] {
  let lenS = s.len();
  let lenSep = sep.len();
  let out: string[] = [];
  if (lenSep == 0) {
    let k = 0;
    while (k < lenS) {
      let w = __fern_utf8_step(s, k, lenS);
      out = out.append(slice_unchecked(s, k, k + w) + "");
      k += w;
    }
    return out;
  }
  let first = sep[0] as i32;
  let rest = lenSep - 1;
  let start = 0;
  let i = 0;
  while (i + lenSep <= lenS) {
    let at = __memchr(s, first, i);
    if (at < 0 || at + lenSep > lenS) {
      i = lenS;
    } else if (rest == 0 || __mismatch(s, at + 1, sep, 1, rest) == rest) {
      out = out.append(slice_unchecked(s, start, at) + "");
      i = at + lenSep;
      start = i;
    } else {
      i = at + 1;
    }
  }
  out = out.append(slice_unchecked(s, start, lenS) + "");
  return out;
}
