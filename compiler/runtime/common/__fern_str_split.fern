function __fern_str_split(s: string, sep: string): string[] {
  let lenS: i32 = s.len();
  let lenSep: i32 = sep.len();
  let out: string[] = [];
  if (lenSep == 0) {
    let k: i32 = 0;
    while (k < lenS) {
      let w: i32 = __fern_utf8_step(s, k, lenS);
      out = out.append(slice_unchecked(s, k, k + w) + "");
      k = k + w;
    }
    return out;
  }
  let start: i32 = 0;
  let i: i32 = 0;
  while (i + lenSep <= lenS) {
    let j: i32 = 0;
    let m: i32 = 1;
    while (j < lenSep) {
      if (s[i + j] != sep[j]) {
        m = 0;
        j = lenSep;
      } else {
        j = j + 1;
      }
    }
    if (m == 1) {
      out = out.append(slice_unchecked(s, start, i) + "");
      i = i + lenSep;
      start = i;
    } else {
      i = i + 1;
    }
  }
  out = out.append(slice_unchecked(s, start, lenS) + "");
  return out;
}
