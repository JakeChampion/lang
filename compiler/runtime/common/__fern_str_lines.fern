function __fern_str_lines(s: string): string[] {
  let out: string[] = [];
  let sl: i32 = s.len();
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < sl) {
    if (s[i] == 10) {
      let end: i32 = i;
      if (end > start) {
        if (s[end - 1] == 13) {
          end = end - 1;
        }
      }
      out = out.append(slice_unchecked(s, start, end) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  if (start < sl) {
    let tail: i32 = sl;
    if (s[tail - 1] == 13) {
      tail = tail - 1;
    }
    out = out.append(slice_unchecked(s, start, tail) + "");
  }
  return out;
}
