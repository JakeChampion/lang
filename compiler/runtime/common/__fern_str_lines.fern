function __fern_str_lines(s: string): string[] {
  let out: string[] = [];
  let sl = s.len();
  let start = 0;
  while (start < sl) {
    let i = __memchr(s, 10, start);
    if (i < 0) {
      let tail = sl;
      if (s[tail - 1] == 13) {
        tail -= 1;
      }
      out = out.append(slice_unchecked(s, start, tail) + "");
      start = sl;
    } else {
      let end = i;
      if (end > start) {
        if (s[end - 1] == 13) {
          end -= 1;
        }
      }
      out = out.append(slice_unchecked(s, start, end) + "");
      start = i + 1;
    }
  }
  return out;
}
