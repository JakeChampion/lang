function __fern_task_reserve(n: i32): usize {
  let st: usize = __raw_task_state();
  let rec: usize = __raw_load_ptr(st, 3);
  let len: i32 = __raw_load_ptr(rec, 5) as i32;
  let cap: i32 = __raw_load_ptr(rec, 6) as i32;
  let buf: usize = __raw_load_ptr(rec, 4);
  if (len + n > cap) {
    let ncap: i32 = 64;
    if (cap > 0) {
      ncap = cap * 2;
    }
    while (ncap < len + n) {
      ncap = ncap * 2;
    }
    let nbuf: usize = __alloc(ncap * 8);
    if (buf != 0 as usize) {
      __memcpy(nbuf, buf, len * 8);
      __free(buf, cap * 8);
    }
    buf = nbuf;
    __raw_store_ptr(rec, 4, buf);
    __raw_store_ptr(rec, 6, ncap as usize);
  }
  __raw_store_ptr(rec, 5, (len + n) as usize);
  return buf + (len * 8) as usize;
}
