function __fern_arr_concat(pa: usize, src: usize, count: i32, width: i32): i32[] {
  // A unique receiver with room takes the copy in place. An element is
  // width / 8 bytes, and an odd width marks counted elements: each element
  // copied from src takes a count. The caller accounts for the elements a
  // copy of pa shares with pa.
  if (count > 0 && __fern_rc_is_unique(pa) != 0) {
    let na = __load_i32(pa);
    let capw = __load_i64(pa - 16);
    let size = width >> 3;
    if ((na as i64 + count as i64) * (size as i64) <= capw * 8i64) {
      let dst = pa + 8 + na as usize * (size as usize);
      if (count <= 134217728) {
        __memcpy(dst, src, count * size);
      } else {
        __fern_arr_copy_elems(dst, src, count, size);
      }
      __store_i64(pa, (na + count) as i64);
      if ((width & 1) != 0) {
        __fern_arr_inc_words(dst, count);
      }
      return __raw_array(pa);
    }
  }
  return __fern_arr_concat_slow(pa, src, count, width);
}
