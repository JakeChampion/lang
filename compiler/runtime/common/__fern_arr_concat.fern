function __fern_arr_concat(pa: usize, src: usize, nb: i32, width: i32): i32[] {
  let size = 8;
  if (width == 8) {
    size = 1;
  } else if (width == 32) {
    size = 4;
  }
  let per = 8 / size;
  let na = __load_i32(pa);
  let m = na + nb;
  let want = m;
  if (__fern_rc_is_unique(pa) != 0) {
    if (nb == 0) {
      return __raw_array(pa);
    }
    let capw = __load_i32(pa - 16);
    if ((m + per - 1) / per <= capw) {
      let dst = pa + 8;
      let skip = na;
      while (skip > 0) {
        let cs = skip;
        if (cs > 134217728) {
          cs = 134217728;
        }
        dst = dst + (cs * size) as usize;
        skip -= cs;
      }
      let from = src;
      let left = nb;
      while (left > 0) {
        let cc = left;
        if (cc > 134217728) {
          cc = 134217728;
        }
        __memcpy(dst, from, cc * size);
        dst = dst + (cc * size) as usize;
        from = from + (cc * size) as usize;
        left -= cc;
      }
      __store_i64(pa, m as i64);
      return __raw_array(pa);
    }
    if (na <= 536870912 && na * 2 > want) {
      want = na * 2;
    }
  }
  let q = __raw_arr_box((want + per - 1) / per);
  __store_i64(q, m as i64);
  let dst2 = q + 8;
  let src2 = pa + 8;
  let left2 = na;
  let part = 0;
  while (part < 2) {
    while (left2 > 0) {
      let cc2 = left2;
      if (cc2 > 134217728) {
        cc2 = 134217728;
      }
      __memcpy(dst2, src2, cc2 * size);
      dst2 = dst2 + (cc2 * size) as usize;
      src2 = src2 + (cc2 * size) as usize;
      left2 -= cc2;
    }
    src2 = src;
    left2 = nb;
    part += 1;
  }
  return __raw_array(q);
}
