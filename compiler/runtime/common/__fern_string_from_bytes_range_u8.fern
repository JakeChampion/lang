function __fern_string_from_bytes_range_u8(a: i32[], from: i32, end: i32): string {
  let n: i32 = a.len();
  let bad: i32 = 0;
  if (end < 0) {
    bad = 1;
  }
  if (end > n) {
    bad = 1;
  }
  if (from < 0) {
    bad = 1;
  }
  if (from > end) {
    bad = 1;
  }
  if (bad == 1) {
    __fern_slice_abort();
  }
  let m: i32 = end - from;
  let p: usize = __raw_alloc(m);
  __memcpy(p, __raw_arr_ptr(a) + 8 + from, m);
  return __raw_string(p, m);
}
