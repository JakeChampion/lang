function __fern_task_free(id: i32): i32 {
  let rec: usize = __fern_task_rec(id);
  if (rec != 0 as usize && __raw_load_ptr(rec, 7) == 0 as usize) {
    let st: usize = __raw_task_state();
    __raw_store_ptr(rec, 7, __raw_load_ptr(st, 4) + 1 as usize);
    __raw_store_ptr(st, 4, id as usize);
  }
  return 0;
}
