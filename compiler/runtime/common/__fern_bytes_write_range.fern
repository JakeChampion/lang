function __fern_bytes_write_range(own a: i32[], at: i32, src: usize, from: i32, n: i32): i32[] {
  if (n <= 0) {
    return a;
  }
  let sn = 0;
  let sp: usize = 0;
  if ((src as i32 & 2) != 0) {
    let base = src - 2;
    sn = __load_i32(base + 8);
    sp = __raw_load_ptr(base, 0);
  } else {
    sn = __load_i32(src);
    sp = src + 8;
  }
  if (from as u32 > sn as u32 || n > sn - from) {
    __fern_oob_abort();
  }
  if (at as u32 > a.len() as u32 || n > a.len() - at) {
    __fern_oob_abort();
  }
  let reuse = __FERN_RUNTIME_REUSE && __load_i32(__raw_arr_ptr(a) - 8) == 1;
  let out = a;
  if (!reuse) {
    out = __fern_bytes_clone(out, __load_i64(__raw_arr_ptr(out) - 16) as i32);
  }
  __memcpy(__raw_arr_ptr(out) + 8 + at as usize, sp + from as usize, n);
  return out;
}
