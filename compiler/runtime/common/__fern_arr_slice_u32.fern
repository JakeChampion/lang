    bad = 1;
  }
  if (bad == 1) {
    __fern_slice_abort();
  }
  let m = end - start;
  let p = __raw_arr_box((m + 1) / 2);
  __store_i64(p, m as i64);
  let dst = p + 8;
  let src = __raw_arr_ptr(a) + 8;
  let skip = start;
  while (skip > 0) {
    let cs = skip;
    if (cs > 134217728) {
      cs = 134217728;
    }
    src = src + (cs * 4) as usize;
    skip -= cs;
  }
