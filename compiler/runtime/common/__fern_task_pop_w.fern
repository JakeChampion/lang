function __fern_task_pop_w(): usize {
  let st = __raw_task_state();
  let rec = __raw_load_ptr(st, 3);
  let len = __raw_load_ptr(rec, 5) as i32 - 1;
  if (len < 0) {
    __fern_oob_abort();
  }
  __raw_store_ptr(rec, 5, len as usize);
  let buf = __raw_load_ptr(rec, 4);
  return __raw_load_ptr(buf, len);
}
