function __fern_str_replace(h: string, o: string, nw: string): string {
  let lenH = h.len();
  let lenO = o.len();
  if (lenO == 0) {
    return __fern_str_dup(h);
  }
  let lenN = nw.len();
  let first = o[0] as i32;
  let rest = lenO - 1;
  let count = 0;
  let i = 0;
  while (i + lenO <= lenH) {
    let at = __memchr(h, first, i);
    if (at < 0 || at + lenO > lenH) {
      i = lenH;
    } else if (rest == 0 || __mismatch(h, at + 1, o, 1, rest) == rest) {
      count += 1;
      i = at + lenO;
    } else {
      i = at + 1;
    }
  }
  if (count == 0) {
    return __fern_str_dup(h);
  }
  let total64 = lenH as i64 + count as i64 * (lenN as i64 - lenO as i64);
  let total = total64 as i32;
  if (total64 > 2147483647) {
    total = -1;
  }
  if (total == 0) {
    return "";
  }
  let p = __raw_alloc(total);
  let src = __raw_data(h);
  let w = 0;
  // `k` is the first byte that is not copied, and `i` is where the search
  // goes on.
  let k = 0;
  i = 0;
  while (count > 0) {
    let at = __memchr(h, first, i);
    if (rest == 0 || __mismatch(h, at + 1, o, 1, rest) == rest) {
      __memcpy(p + w as usize, src + k as usize, at - k);
      w += at - k;
      __memcpy(p + w as usize, __raw_data(nw), lenN);
      w += lenN;
      k = at + lenO;
      i = k;
      count -= 1;
    } else {
      i = at + 1;
    }
  }
  __memcpy(p + w as usize, src + k as usize, lenH - k);
  return __raw_string(p, total);
}
