function __fern_str_replace(h: string, o: string, nw: string): string {
  let lenH = h.len();
  let lenO = o.len();
  if (lenO == 0) {
    return __fern_str_dup(h);
  }
  let lenN = nw.len();
  let count = 0;
  let i = 0;
  while (i + lenO <= lenH) {
    let j = 0;
    let m = 1;
    while (j < lenO) {
      if (h[i + j] != o[j]) {
        m = 0;
        j = lenO;
      } else {
        j += 1;
      }
    }
    if (m == 1) {
      count += 1;
      i += lenO;
    } else {
      i += 1;
    }
  }
  if (count == 0) {
    return __fern_str_dup(h);
  }
  let total64 = lenH as i64 + count as i64 * (lenN as i64 - lenO as i64);
  let total = total64 as i32;
  if (total64 > 2147483647) {
    total = -1;
  }
  if (total == 0) {
    return "";
  }
  let p = __raw_alloc(total);
  let w = 0;
  let k = 0;
  while (k < lenH) {
    let m2 = 0;
    if (k + lenO <= lenH) {
      let jj = 0;
      m2 = 1;
      while (jj < lenO) {
        if (h[k + jj] != o[jj]) {
          m2 = 0;
          jj = lenO;
        } else {
          jj += 1;
        }
      }
    }
    if (m2 == 1) {
      let t = 0;
      while (t < lenN) {
        __raw_store8(p, w, nw[t] as i32);
        w += 1;
        t += 1;
      }
      k += lenO;
    } else {
      __raw_store8(p, w, h[k] as i32);
      w += 1;
      k += 1;
    }
  }
  return __raw_string(p, total);
}
