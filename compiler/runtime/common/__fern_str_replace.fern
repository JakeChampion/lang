function __fern_str_replace(h: string, o: string, nw: string): string {
  let lenH: i32 = h.len();
  let lenO: i32 = o.len();
  if (lenO == 0) {
    return __fern_str_dup(h);
  }
  let lenN: i32 = nw.len();
  let count: i32 = 0;
  let i: i32 = 0;
  while (i + lenO <= lenH) {
    let j: i32 = 0;
    let m: i32 = 1;
    while (j < lenO) {
      if (h[i + j] != o[j]) {
        m = 0;
        j = lenO;
      } else {
        j = j + 1;
      }
    }
    if (m == 1) {
      count = count + 1;
      i = i + lenO;
    } else {
      i = i + 1;
    }
  }
  if (count == 0) {
    return __fern_str_dup(h);
  }
  let total64: i64 = lenH as i64 + count as i64 * (lenN as i64 - lenO as i64);
  let total: i32 = total64 as i32;
  if (total64 > 2147483647) {
    total = 0 - 1;
  }
  if (total == 0) {
    return "";
  }
  let p: usize = __raw_alloc(total);
  let w: i32 = 0;
  let k: i32 = 0;
  while (k < lenH) {
    let m2: i32 = 0;
    if (k + lenO <= lenH) {
      let jj: i32 = 0;
      m2 = 1;
      while (jj < lenO) {
        if (h[k + jj] != o[jj]) {
          m2 = 0;
          jj = lenO;
        } else {
          jj = jj + 1;
        }
      }
    }
    if (m2 == 1) {
      let t: i32 = 0;
      while (t < lenN) {
        __raw_store8(p, w, nw[t] as i32);
        w = w + 1;
        t = t + 1;
      }
      k = k + lenO;
    } else {
      __raw_store8(p, w, h[k] as i32);
      w = w + 1;
      k = k + 1;
    }
  }
  return __raw_string(p, total);
}
