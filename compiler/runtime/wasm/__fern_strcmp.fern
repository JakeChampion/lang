function __fern_strcmp(a: usize, b: usize): i32 {
  let la = __load_i32(a) as u32;
  let lb = __load_i32(b) as u32;
  let n = la;
  if (lb < n) {
    n = lb;
  }
  let i: u32 = 0;
  while (i < n) {
    let ca = __load_u8(a + 4 + i);
    let cb = __load_u8(b + 4 + i);
    if (ca < cb) {
      return -1;
    }
    if (ca > cb) {
      return 1;
    }
    i += 1;
  }
  if (la < lb) {
    return -1;
  }
  if (la > lb) {
    return 1;
  }
  return 0;
}
