function __fern_scan_set_bytes(s: usize, state: i32, set: usize): i32 {
  let len: i32 = __load_i32(s);
  let n: u32 = __load_i32(set) as u32;
  let i: i32 = state;
  if (i < 0) {
    i = 0;
  }
  while (i < len) {
    let b: u32 = __load_u8(s + 8 + i) as u32;
    if (b < n) {
      if (__load_u8(set + 8 + b) == 0) {
        i = i + 1;
        continue;
      }
      return i;
    }
    i = i + 1;
  }
  return len;
}
