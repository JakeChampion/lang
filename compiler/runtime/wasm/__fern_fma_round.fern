// __fern_fma_round gives m times 2^e, rounded one time, with the sign neg. Bit
// 62 of m is set, and bit 0 is sticky. Below the normal range, m first keeps
// only the bits that the subnormal result can hold, so that the scale does not
// round a second time.
function __fern_fma_round(m: u64, e: i32, neg: boolean): f64 {
  let r = __fern_fma_signed(m, neg);
  if (e >= -1084) {
    return __fern_fma_scale(r, e);
  }
  if (e < -1085) {
    let j = (m >> 10 as u64 | __fern_fma_bit(m << 54 as u64 != 0 as u64)) << 10 as u64;
    return __fern_fma_scale(__fern_fma_signed(j, neg), e);
  }
  if (m << 53 as u64 == 0 as u64) {
    return __fern_fma_scale(r, e);
  }
  // At 2^-1085 the subnormal holds bits 62 to 11 of m. A top bit at 2^63
  // moves the rounding of the conversion to bit 11, and the subtraction
  // removes that bit again.
  let c = if (neg) { 0.0 - 9223372036854775808.0 } else { 9223372036854775808.0 };
  let j = m >> 1 as u64 | m & 1 as u64 | 4611686018427387904 as u64;
  return __fern_fma_scale(2.0 * __fern_fma_signed(j, neg) - c, e);
}
