// `s` is a string, a borrowed descriptor, or a frame window at its address
// less 1, as a byte view's string arm can be. Each is a box [data, len].
function __fern_scan_set(s: usize, state: i32, set: usize): i32 {
  let base = s - (s & 1);
  let len = __fern_str_len(base);
  let p = __fern_str_data(base);
  let n = __load_i32(set) as u32;
  let i = state;
  if (i < 0) {
    i = 0;
  }
  while (i < len) {
    let b = __load_u8(p + i as usize) as u32;
    if (b < n) {
      if (__load_u8(set + 8 + b) == 0) {
        i += 1;
        continue;
      }
      return i;
    }
    i += 1;
  }
  return len;
}
