// `s` is a string, a frame window at its address less 1, or a borrowed
// descriptor, as a byte view's string arm can be.
function __fern_scan_set(s: usize, state: i32, set: usize): i32 {
  let tag = s & 1;
  let len = __load_i32(s + tag * 3);
  let p: usize = if (tag == 0) { s + 4 } else { (__load_i32(s - 1) as u32) as usize };
  if (len < 0) {
    p = (__load_i32(s + 4) as u32) as usize;
    len = len & 2147483647;
  }
  let n = __load_i32(set) as u32;
  let i = state;
  if (i < 0) {
    i = 0;
  }
  while (i < len) {
    let b = __load_u8(p + i as usize) as u32;
    if (b < n) {
      if (__load_u8(set + 8 + b) == 0) {
        i += 1;
        continue;
      }
      return i;
    }
    i += 1;
  }
  return len;
}
