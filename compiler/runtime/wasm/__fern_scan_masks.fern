// The checks of the masks, and the loop of the kernel.
// fern-lint: allow cyclomatic-complexity
function __fern_scan_masks(s: usize, from: i32, m: usize): i32 {
  let len = __load_i32(s);
  let n = __load_i32(m);
  if (n < 4) {
    return -1;
  }
  let probes = __load_u8(m + 8) as i32;
  if (probes < 1 || probes > 3 || n < 4 + 32 * probes) {
    return -1;
  }
  let reach = 0;
  let j = 0;
  while (j < probes) {
    let o = __load_u8(m + 9 + j as usize) as i32;
    if (o > reach) {
      reach = o;
    }
    j += 1;
  }
  let at = from;
  if (at < 0) {
    at = 0;
  }
  while (at + reach < len) {
    let acc = 255;
    j = 0;
    while (j < probes) {
      let c = __load_u8(s + 4 + (at + __load_u8(m + 9 + j as usize) as i32) as usize) as i32;
      let t = m + 12 + (32 * j) as usize;
      acc = acc & __load_u8(t + (c & 15) as usize) as i32 & __load_u8(t + 16 + (c >> 4) as usize) as i32;
      j += 1;
    }
    if (acc != 0) {
      return at;
    }
    at += 1;
  }
  return -1;
}
