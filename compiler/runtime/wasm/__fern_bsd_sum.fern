// `s` is a string, a borrowed descriptor, or a frame window at its address
// less 1. Each is a box [data, len].
function __fern_bsd_sum(s: usize, seed: i32): i32 {
  let base = s - (s & 1);
  let n = __fern_str_len(base);
  let p = __fern_str_data(base);
  let sum = seed as u32 & 65535;
  let i = 0;
  while (i < n) {
    sum = sum >> 1 | sum << 15;
    sum = sum + __load_u8(p + i as usize) as u32;
    sum = sum & 65535;
    i += 1;
  }
  return sum as i32;
}
