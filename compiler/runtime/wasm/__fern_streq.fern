function __fern_streq(a: usize, b: usize): boolean {
  let n = __fern_str_len(a) as u32;
  if (n != __fern_str_len(b) as u32) {
    return false;
  }
  let pa = __fern_str_data(a);
  let pb = __fern_str_data(b);
  let i: u32 = 0;
  while (i < n) {
    if (__load_u8(pa + i) != __load_u8(pb + i)) {
      return false;
    }
    i += 1;
  }
  return true;
}
