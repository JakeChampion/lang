function __fern_ring_push(blk: usize, op: i32, fd: i32, events: i32, ud: i64, target: i64): i32 {
  let sq: usize = __load_i64(blk + 8) as usize;
  let headp: usize = sq + __load_i32(blk + 32) as usize;
  let tailp: usize = sq + __load_i32(blk + 36) as usize;
  let mask: i64 = __load_i32(blk + 40) as i64;
  let n: i64 = __load_i32(blk + 64) as i64;
  let tail: i64 = __load_i32(tailp) as i64 & 4294967295 as i64;
  if ((tail - (__load_i32(headp) as i64 & 4294967295 as i64) & 4294967295 as i64) >= n) {
    let flushed: i32 = __fern_ring_flush(blk);
    if (flushed < 0) {
      return flushed;
    }
    if ((tail - (__load_i32(headp) as i64 & 4294967295 as i64) & 4294967295 as i64) >= n) {
      return 0 - 16;
    }
  }
  let idx: i64 = tail & mask;
  let e: usize = __load_i64(blk + 24) as usize + idx as usize * 64;
  let z: i32 = 0;
  while (z < 8) {
    __store_i64(e + z as usize * 8, 0);
    z = z + 1;
  }
  __raw_store8(e, 0, op);
  __store_i32(e + 4, fd);
  __store_i64(e + 16, target);
  __store_i32(e + 28, events);
  __store_i64(e + 32, ud);
  __store_i64(blk + 192, e as i64);
  __store_i32(sq + __load_i32(blk + 44) as usize + idx as usize * 4, idx as i32);
  __store_i32(tailp, (tail + 1) as i32);
  return 0;
}
