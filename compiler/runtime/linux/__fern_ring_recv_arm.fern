function __fern_ring_recv_arm(blk: usize, ent: usize, fd: i32): i32 {
  let r: i32 = __fern_ring_push(blk, 27, fd, 0, __fern_ring_rud(fd, __raw_load8(ent, 5)), 0);
  if (r < 0) {
    return r;
  }
  let e: usize = __load_i64(blk + 192) as usize;
  __raw_store8(e, 1, 32);
  __raw_store8(e, 2, 2);
  __raw_store8(ent, 4, 1);
  return 0;
}
