function __fern_ring_enqueue(blk: usize, ent: usize, bid: i32, len: i32): i32 {
  let pb: usize = __load_i64(blk + 160) as usize;
  let meta: usize = pb + 4096 + bid as usize * 8;
  __fern_ring_set16(meta, 0, 0);
  __fern_ring_set16(meta, 2, len);
  __fern_ring_set16(meta, 4, 0);
  let t: i32 = __fern_ring_u16(ent, 10);
  if (t == 0) {
    __fern_ring_set16(ent, 8, bid + 1);
  } else {
    __fern_ring_set16(pb + 4096 + (t - 1) as usize * 8, 0, bid + 1);
  }
  __fern_ring_set16(ent, 10, bid + 1);
  __raw_store8(ent, 15, __raw_load8(ent, 15) + 1);
  __store_i32(blk + 180, __load_i32(blk + 180) - 1);
  return 0;
}
