function __fern_io_error(e: i32, path: string): IoError {
  if (e == 2) {
    return NotFound(path);
  }
  if (e == 13) {
    return PermissionDenied(path);
  }
  if (e == 17) {
    return AlreadyExists(path);
  }
  if (e == 4) {
    return Interrupted;
  }
  if (e == 84) {
    return InvalidUtf8(path);
  }
  if (e == 1) {
    return Other(path, "Operation not permitted", 1);
  }
  if (e == 3) {
    return Other(path, "No such process", 3);
  }
  if (e == 5) {
    return Other(path, "Input/output error", 5);
  }
  if (e == 6) {
    return Other(path, "No such device or address", 6);
  }
  if (e == 7) {
    return Other(path, "Argument list too long", 7);
  }
  if (e == 8) {
    return Other(path, "Exec format error", 8);
  }
  if (e == 9) {
    return Other(path, "Bad file descriptor", 9);
  }
  if (e == 10) {
    return Other(path, "No child processes", 10);
  }
  if (e == 11) {
    return Other(path, "Resource temporarily unavailable", 11);
  }
  if (e == 12) {
    return Other(path, "Cannot allocate memory", 12);
  }
  if (e == 14) {
    return Other(path, "Bad address", 14);
  }
  if (e == 16) {
    return Other(path, "Device or resource busy", 16);
  }
  if (e == 18) {
    return Other(path, "Invalid cross-device link", 18);
  }
  if (e == 19) {
    return Other(path, "No such device", 19);
  }
  if (e == 20) {
    return Other(path, "Not a directory", 20);
  }
  if (e == 21) {
    return Other(path, "Is a directory", 21);
  }
  if (e == 22) {
    return Other(path, "Invalid argument", 22);
  }
  if (e == 23) {
    return Other(path, "Too many open files in system", 23);
  }
  if (e == 24) {
    return Other(path, "Too many open files", 24);
  }
  if (e == 25) {
    return Other(path, "Inappropriate ioctl for device", 25);
  }
  if (e == 26) {
    return Other(path, "Text file busy", 26);
  }
  if (e == 27) {
    return Other(path, "File too large", 27);
  }
  if (e == 28) {
    return Other(path, "No space left on device", 28);
  }
  if (e == 29) {
    return Other(path, "Illegal seek", 29);
  }
  if (e == 30) {
    return Other(path, "Read-only file system", 30);
  }
  if (e == 31) {
    return Other(path, "Too many links", 31);
  }
  if (e == 32) {
    return Other(path, "Broken pipe", 32);
  }
  if (e == 34) {
    return Other(path, "Numerical result out of range", 34);
  }
  if (e == 35) {
    return Other(path, "Resource deadlock avoided", 35);
  }
  if (e == 36) {
    return Other(path, "File name too long", 36);
  }
  if (e == 37) {
    return Other(path, "No locks available", 37);
  }
  if (e == 38) {
    return Other(path, "Function not implemented", 38);
  }
  if (e == 39) {
    return Other(path, "Directory not empty", 39);
  }
  if (e == 40) {
    return Other(path, "Too many levels of symbolic links", 40);
  }
  if (e == 61) {
    return Other(path, "No data available", 61);
  }
  if (e == 75) {
    return Other(path, "Value too large for defined data type", 75);
  }
  if (e == 88) {
    return Other(path, "Socket operation on non-socket", 88);
  }
  if (e == 90) {
    return Other(path, "Message too long", 90);
  }
  if (e == 91) {
    return Other(path, "Protocol wrong type for socket", 91);
  }
  if (e == 92) {
    return Other(path, "Protocol not available", 92);
  }
  if (e == 93) {
    return Other(path, "Protocol not supported", 93);
  }
  if (e == 95) {
    return Other(path, "Operation not supported", 95);
  }
  if (e == 97) {
    return Other(path, "Address family not supported by protocol", 97);
  }
  if (e == 98) {
    return Other(path, "Address already in use", 98);
  }
  if (e == 99) {
    return Other(path, "Cannot assign requested address", 99);
  }
  if (e == 100) {
    return Other(path, "Network is down", 100);
  }
  if (e == 101) {
    return Other(path, "Network is unreachable", 101);
  }
  if (e == 102) {
    return Other(path, "Network dropped connection on reset", 102);
  }
  if (e == 103) {
    return Other(path, "Software caused connection abort", 103);
  }
  if (e == 104) {
    return Other(path, "Connection reset by peer", 104);
  }
  if (e == 105) {
    return Other(path, "No buffer space available", 105);
  }
  if (e == 106) {
    return Other(path, "Transport endpoint is already connected", 106);
  }
  if (e == 107) {
    return Other(path, "Transport endpoint is not connected", 107);
  }
  if (e == 110) {
    return Other(path, "Connection timed out", 110);
  }
  if (e == 111) {
    return Other(path, "Connection refused", 111);
  }
  if (e == 113) {
    return Other(path, "No route to host", 113);
  }
  if (e == 114) {
    return Other(path, "Operation already in progress", 114);
  }
  if (e == 115) {
    return Other(path, "Operation now in progress", 115);
  }
  if (e == 116) {
    return Other(path, "Stale file handle", 116);
  }
  if (e == 122) {
    return Other(path, "Disk quota exceeded", 122);
  }
  if (e == 125) {
    return Other(path, "Operation canceled", 125);
  }
  if (e == 130) {
    return Other(path, "Owner died", 130);
  }
  if (e == 131) {
    return Other(path, "State not recoverable", 131);
  }
  let ndig: i32 = 1;
  let tt: i32 = e;
  while (tt >= 10) {
    ndig = ndig + 1;
    tt = tt / 10;
  }
  let total: i32 = 14 + ndig;
  let buf: usize = __raw_alloc(total);
  __raw_store8(buf, 0, 85);
  __raw_store8(buf, 1, 110);
  __raw_store8(buf, 2, 107);
  __raw_store8(buf, 3, 110);
  __raw_store8(buf, 4, 111);
  __raw_store8(buf, 5, 119);
  __raw_store8(buf, 6, 110);
  __raw_store8(buf, 7, 32);
  __raw_store8(buf, 8, 101);
  __raw_store8(buf, 9, 114);
  __raw_store8(buf, 10, 114);
  __raw_store8(buf, 11, 111);
  __raw_store8(buf, 12, 114);
  __raw_store8(buf, 13, 32);
  let pos: i32 = total - 1;
  let v: i32 = e;
  while (pos >= 14) {
    __raw_store8(buf, pos, 48 + v % 10);
    v = v / 10;
    pos = pos - 1;
  }
  let unknown: string = __raw_string(buf, total);
  return Other(path, unknown, 0);
}
