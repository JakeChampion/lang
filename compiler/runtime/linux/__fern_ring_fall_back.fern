function __fern_ring_fall_back(blk: usize, ent: usize, fd: i32): i32 {
  let s: i32 = __fern_ring_recv_stop(blk, ent, fd);
  if (s < 0) {
    return s;
  }
  __raw_store8(ent, 4, 5);
  if ((__raw_load8(ent, 13) & 1) == 0) {
    let un: i32 = __fern_ring_unarm(blk, ent, fd);
    if (un < 0) {
      return un;
    }
    __raw_store8(ent, 13, __raw_load8(ent, 13) | 1);
    return __fern_ring_arm(blk, ent, fd);
  }
  return 0;
}
