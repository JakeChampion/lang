function __fern_mount_devno(buf: usize, a: i32, b: i32): i64 {
  let major: i64 = 0 as i64;
  let minor: i64 = 0 as i64;
  let i: i32 = a;
  while (i < b && __raw_load8(buf, i) != 58) {
    major = major * (10 as i64) + (__raw_load8(buf, i) - 48) as i64;
    i = i + 1;
  }
  i = i + 1;
  while (i < b) {
    minor = minor * (10 as i64) + (__raw_load8(buf, i) - 48) as i64;
    i = i + 1;
  }
  return minor & 255 as i64 | major << 8 as i64 | (minor & (0 - 256) as i64) << 12 as i64;
}
