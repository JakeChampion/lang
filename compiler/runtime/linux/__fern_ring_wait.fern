function __fern_ring_wait(ring: i64, events: i32[], timeout_ms: i32): i32 {
  let cap = events.len() / 2;
  if (cap <= 0 || ring < 0 as i64) {
    return -22;
  }
  let blk = ring as usize;
  let nfds = __load_i32(blk + 68);
  let pend = blk + 4096;
  let np = __load_i32(blk + 72);
  __store_i32(blk + 72, 0);
  let k = 0;
  while (k < np) {
    let pfd = __load_i32(pend + k as usize * 4);
    let pent = __fern_ring_entry(blk, pfd);
    if (__raw_load8(pent, 0) != 0 && __raw_load8(pent, 1) == 0) {
      let armed = __fern_ring_arm(blk, pent, pfd);
      if (armed < 0) {
        return armed;
      }
    }
    if (__raw_load8(pent, 0) != 0 && (__raw_load8(pent, 4) == 2 || __raw_load8(pent, 4) == 5)) {
      let resumed = __fern_ring_resume(blk, pent, pfd);
      if (resumed < 0) {
        return resumed;
      }
      if (__raw_load8(pent, 4) != 1 && __raw_load8(pent, 6) == 0) {
        __fern_ring_pend(blk, pfd);
      }
    }
    k += 1;
  }
  let min = 1 as i64;
  // Consumed receive buffers can leave stale descriptors in the ready list.
  if (timeout_ms == 0 || __fern_ring_has_ready(blk)) {
    min = 0 as i64;
  }
  let ts = blk + 120;
  let arg = blk + 136;
  __store_i64(arg, 0);
  __store_i64(arg + 8, 0);
  __store_i64(arg + 16, 0);
  if (timeout_ms > 0 && min != 0 as i64) {
    __store_i64(ts, (timeout_ms / 1000) as i64);
    __store_i64(ts + 8, (timeout_ms % 1000) as i64 * (1000000 as i64));
    __store_i64(arg + 16, ts as i64);
  }
  let queued = __fern_ring_queued(blk);
  let r = __syscall6(426, __load_i32(blk) as i64, queued as i64, min, 9, arg as i64, 24) as i32;
  __fern_ring_reap(blk, nfds);
  let n = __fern_ring_emit(blk, __raw_arr_ptr(events), cap);
  if (n == 0 && r < 0 && r != -62) {
    return r;
  }
  return n;
}
