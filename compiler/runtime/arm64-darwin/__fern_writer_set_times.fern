function __fern_writer_set_times(fd: i32, asec: i64, ansec: i64, msec: i64, mnsec: i64, flags: i32): Result[void, IoError] {
  let a0 = asec;
  let a1 = ansec;
  let m0 = msec;
  let m1 = mnsec;
  if ((flags & 24) != 0) {
    let ts = __raw_scratch(16);
    __syscall3(116, ts as i64, 0, 0);
    let sec = __load_i64(ts);
    let sub = __load_i32(ts + 8) as i64;
    if ((flags & 8) != 0) {
      a0 = sec;
      a1 = sub * (1000 as i64);
    }
    if ((flags & 16) != 0) {
      m0 = sec;
      m1 = sub * (1000 as i64);
    }
  }
  let al = __raw_scratch(64);
  let z: i32 = 0;
  while (z < 24) {
    __raw_store8(al, z, 0);
    z += 1;
  }
  __raw_store8(al, 0, 5);
  let buf = al + 32;
  let n: i32 = 0;
  let hi: i32 = 0;
  if ((flags & 4) == 0) {
    hi += 4;
    __store_i64(buf + n, m0);
    __store_i64(buf + n + 8, m1);
    n += 16;
  }
  if ((flags & 2) == 0) {
    hi += 16;
    __store_i64(buf + n, a0);
    __store_i64(buf + n + 8, a1);
    n += 16;
  }
  __raw_store8(al, 5, hi);
  let rc = __syscall5(229, fd as i64, al as i64, buf as i64, n as i64, 0) as i32;
  if (rc < 0) {
    return Err(__fern_io_error(-rc, ""));
  }
  return Ok(());
}
