function __fern_random_bytes_u8(n: i32): i32[] {
  if (n < 0) {
    n = 0;
  }
  let b = __raw_arr_box(((n as i64 + 7) / 8) as i32);
  __store_i64(b, n as i64);
  let off = 0;
  while (off < n) {
    let want = n - off;
    if (want > 256) {
      want = 256;
    }
    let r = __syscall3(500, (b + 8 + off) as i64, want as i64, 0) as i32;
    if (r == -4) {
      continue;
    }
    if (r != 0) {
      __fern_rc_dec(b);
      let msg = "fern: entropy unavailable\n";
      __syscall3(4, 2, __raw_data(msg) as i64, msg.len() as i64);
      exit(134);
    }
    off += want;
  }
  return __raw_array(b);
}
