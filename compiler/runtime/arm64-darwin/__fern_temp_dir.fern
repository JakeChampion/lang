function __fern_temp_dir(prefix: string): Result[string, IoError] {
  if (__count_byte(prefix, 0) > 0) {
    return Err(__fern_io_error(22, __fern_path_copy(prefix, prefix.len())));
  }
  let plen = prefix.len();
  let si = 0;
  while (si < plen) {
    if (prefix[si] == 47) {
      return Err(__fern_io_error(22, __fern_path_copy(prefix, plen)));
    }
    si += 1;
  }
  let root = __fern_temp_root();
  let rlen = root.len();
  let total = rlen + 1 + plen + 1 + 16;
  let tries = 0;
  while (tries < 64) {
    let rnd = random_bytes(8);
    let buf = __raw_alloc(total + 1);
    let i = 0;
    while (i < rlen + 1 + plen) {
      let c = 47;
      if (i < rlen) {
        c = root[i] as i32;
      } else if (i > rlen) {
        c = prefix[i - rlen - 1] as i32;
      }
      __raw_store8(buf, i, c);
      i += 1;
    }
    __raw_store8(buf, rlen + 1 + plen, 45);
    let k = 0;
    while (k < 8) {
      let v = rnd[k] as i32;
      __raw_store8(buf, rlen + 2 + plen + 2 * k, __fern_hex_digit(v >> 4));
      __raw_store8(buf, rlen + 3 + plen + 2 * k, __fern_hex_digit(v & 15));
      k += 1;
    }
    __raw_store8(buf, total, 0);
    let rc = __syscall3(475, -2, buf as i64, 448) as i32;
    let buf_own = __raw_string(buf, total + 1);
    if (rc >= 0) {
      return Ok(__fern_path_copy(buf_own, total));
    }
    if (rc != -17) {
      return Err(__fern_io_error(-rc, __fern_path_copy(prefix, plen)));
    }
    tries += 1;
  }
  return Err(__fern_io_error(17, __fern_path_copy(prefix, plen)));
}

function __fern_hex_digit(d: i32): i32 {
  if (d < 10) {
    return 48 + d;
  }
  return 87 + d;
}

// TMPDIR names the root when it is an absolute path with more than the
// leading separator. One trailing separator is dropped. Anything else is /tmp.
function __fern_temp_root(): string {
  match (__fern_env("TMPDIR")) {
    Some(v) => {
      let n = v.len();
      if (n > 1 && v[n - 1] == 47) {
        n -= 1;
      }
      if (n > 1 && v[0] == 47) {
        return __fern_path_copy(v, n);
      }
      return "/tmp";
    },
    None => {
      return "/tmp";
    }
  }
}
