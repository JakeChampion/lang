    let b0: i64 = __raw_load8(buf, i * 4) as i64;
    let b1: i64 = __raw_load8(buf, i * 4 + 1) as i64;
    let b2: i64 = __raw_load8(buf, i * 4 + 2) as i64;
    let b3: i64 = __raw_load8(buf, i * 4 + 3) as i64;
