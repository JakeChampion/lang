function __fern_getgroups(): i64[] {
  let out: i64[] = [];
  let n = __syscall3(79, 0, 0, 0) as i32;
  if (n <= 0) {
    return out;
  }
  let buf = __raw_alloc(n * 4);
  let m = __syscall3(79, n as i64, buf as i64, 0) as i32;
  if (m <= 0) {
    let buf_own0 = __raw_string(buf, n * 4);
    return out;
  }
  let i = 0;
  while (i < m) {
    let b0 = __raw_load8(buf, i * 4) as i64;
    let b1 = __raw_load8(buf, i * 4 + 1) as i64;
    let b2 = __raw_load8(buf, i * 4 + 2) as i64;
    let b3 = __raw_load8(buf, i * 4 + 3) as i64;
    out = out.append(b0 + b1 * 256 + b2 * 65536 + b3 * 16777216);
    i += 1;
  }
  let buf_own = __raw_string(buf, n * 4);
  return out;
}
