function __fern_writer_write(fd: i32, s: string): Result[void, IoError] {
  let n = s.len();
  let data = __raw_data(s);
  let off = 0;
  while (off < n) {
    let w = __syscall3(4, fd as i64, (data + off as usize) as i64, (n - off) as i64) as i32;
    if (w == -4 && off > 0) {
      continue;
    }
    if (w < 0) {
      return Err(__fern_io_error(-w, ""));
    }
    if (w == 0) {
      return Err(__fern_io_error(5, ""));
    }
    off += w;
  }
  return Ok(());
}
