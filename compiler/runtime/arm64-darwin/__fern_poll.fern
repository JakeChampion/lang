    let tmo = 0 as usize;
    if (wait_ms >= 0) {
      __raw_store_ptr(ts, 0, (wait_ms / 1000) as usize);
      __raw_store_ptr(ts, 1, (wait_ms % 1000 * 1000000) as usize);
      tmo = ts;
