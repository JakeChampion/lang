function __fern_poll(fds: i32[], timeout_ms: i32): i32 {
  let n = fds.len();
  if (n <= 0 || n > 33554431) {
    return -1;
  }
  let count: i32 = 0;
  for fd in fds {
    if (fd >= 0) {
      count += 1;
    }
  }
  if (count == 0) {
    return -1;
  }
  let kq = __syscall3(362, 0, 0, 0) as i32;
  if (kq < 0) {
    return -1;
  }
  let buf = __raw_alloc(count * 64);
  let events = buf + (count * 32) as usize;
  let i = n - 1;
