  __raw_store_ptr(ts, 0, 0);
  __raw_store_ptr(ts, 1, 0);
  let receipts = __syscall6(363, kq as i64, buf as i64, count as i64, events as i64, count as i64, ts as i64) as i32;
  let valid: i32 = 0;
  let bad: i32 = -1;
  let r: i32 = 0;
  let wait_ms = timeout_ms;
  while (r < receipts) {
    if (__raw_load_ptr(events, r * 4 + 2) == 0) {
      valid += 1;
    } else {
      wait_ms = 0;
      let at = __raw_load_ptr(events, r * 4 + 3) as i32;
      if (bad < 0 || at < bad) {
        bad = at;
      }
    }
    r += 1;
  }
  let got: i32 = 0;
