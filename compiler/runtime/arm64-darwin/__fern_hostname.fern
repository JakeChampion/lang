function __fern_hostname(): string {
  let buf = __raw_scratch(400);
  let domain = 1;
  let field = 10;
  let valid = true;
  let n = 0;
  if (valid) {
    __store_i32(buf, domain);
    __store_i32(buf + 4, field);
    __store_i64(buf + 8, 384i64);
    if (__syscall6(202, buf as i64, 2, (buf + 16) as i64, (buf + 8) as i64, 0, 0) >= 0i64) {
      while (n < 384 && __raw_load8(buf, 16 + n) != 0) {
        n += 1;
      }
    }
  }
  if (__fern_utf8_valid(buf + 16, n) == 0) {
    n = 0;
  }
  let p = __raw_alloc(n);
  __memcpy(p, buf + 16, n);
  return __raw_string(p, n);
}
