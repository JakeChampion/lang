function __fern_mounts(): Result[MountEntry[], IoError] {
  let n = __syscall3(347, 0, 0, 2) as i32;
  if (n < 0) {
    return Err(__fern_io_error(-n, ""));
  }
  let size: i32 = (n + 8) * 2168;
  let buf = __raw_alloc(size);
  let m = __syscall3(347, buf as i64, size as i64, 2) as i32;
  let st = __raw_alloc(160);
  let out: MountEntry[] = [];
  let k = 0;
  while (k < m) {
    let base = k * 2168;
    let dev = (-1) as i64;
    let sr = __syscall4(470, -2, (buf + base + 88) as i64, st as i64, 0) as i32;
    if (sr >= 0) {
      dev = __load_i32(st + 0) as i64;
    }
    out = out.append(MountEntry { source: __fern_mount_cstr(buf, base + 1112, 1024), target: __fern_mount_cstr(buf, base + 88, 1024), fstype: __fern_mount_cstr(buf, base + 72, 16), dev: dev });
    k += 1;
  }
  let st_own = __raw_string(st, 160);
  let buf_own = __raw_string(buf, size);
  if (m < 0) {
    return Err(__fern_io_error(-m, ""));
  }
  let vi = 0;
  while (vi < out.len()) {
    let m = out[vi];
    if (__fern_utf8_valid(__raw_data(m.source), m.source.len()) == 0 || __fern_utf8_valid(__raw_data(m.target), m.target.len()) == 0 || __fern_utf8_valid(__raw_data(m.fstype), m.fstype.len()) == 0) {
      return Err(InvalidUtf8(""));
    }
    vi += 1;
  }
  return Ok(out);
}
