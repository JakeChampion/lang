function __fern_proc_waitpid_nohang(pid: i32): i32 {
  let st = __raw_scratch(16);
  let rc = __syscall4(7, pid as i64, st as i64, 1, 0) as i32;
  if (rc < 0) {
    return rc;
  }
  if (rc == 0) {
    return -1;
  }
  let w = __load_i32(st);
  let sig = w & 127;
  if (sig != 0) {
    return sig + 128;
  }
  return w >> 8 & 255;
}
