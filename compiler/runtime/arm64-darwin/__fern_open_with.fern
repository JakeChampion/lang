function __fern_open_with(path: string, flags: i32, write: i32): Result[i32, IoError] {
  let f = __fern_open_flags(flags, write);
  if (f < 0) {
    return Err(Unsupported);
  }
  // Bit 1024 of the flag word makes a file that the open creates private to its owner.
  let mode = 438;
  if ((flags & 1024) != 0) {
    mode = 384;
  }
  return __fern_open_res(path, f, mode);
}
