function __fern_set_file_times(path: string, asec: i64, ansec: i64, msec: i64, mnsec: i64, flags: i32): Result[void, IoError] {
  if (__count_byte(path, 0) > 0) {
    return Err(__fern_io_error(22, __fern_path_copy(path, path.len())));
  }
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i: i32 = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  if (plen > 0 && path[plen - 1] == 47) {
    let st = __raw_scratch(160);
    let src = __syscall4(470, -2, pathz as i64, st as i64, 0) as i32;
    if (src >= 0 && (__raw_load8(st, 4 + 1) & 240) != 64) {
      src = -20;
    }
    if (src < 0) {
      let spath = __raw_string(pathz, plen + 1);
      return Err(__fern_io_error(-src, __fern_path_copy(spath, plen)));
    }
  }
  let a0 = asec;
  let a1 = ansec;
  let m0 = msec;
  let m1 = mnsec;
  if ((flags & 24) != 0) {
    let ts = __raw_scratch(16);
    __syscall3(116, ts as i64, 0, 0);
    let sec = __load_i64(ts);
    let sub = __load_i32(ts + 8) as i64;
    if ((flags & 8) != 0) {
      a0 = sec;
      a1 = sub * (1000 as i64);
    }
    if ((flags & 16) != 0) {
      m0 = sec;
      m1 = sub * (1000 as i64);
    }
  }
  let al = __raw_scratch(64);
  let z: i32 = 0;
  while (z < 24) {
    __raw_store8(al, z, 0);
    z += 1;
  }
  __raw_store8(al, 0, 5);
  let buf = al + 32;
  let n: i32 = 0;
  let hi: i32 = 0;
  if ((flags & 4) == 0) {
    hi += 4;
    __store_i64(buf + n as usize, m0);
    __store_i64(buf + n as usize + 8, m1);
    n += 16;
  }
  if ((flags & 2) == 0) {
    hi += 16;
    __store_i64(buf + n as usize, a0);
    __store_i64(buf + n as usize + 8, a1);
    n += 16;
  }
  __raw_store8(al, 5, hi);
  let opt: i32 = 0;
  if ((flags & 1) != 0) {
    opt = 1;
  }
  if ((flags & 30) == 24) {
    opt = opt | 1024;
  }
  let rc = __syscall5(221, pathz as i64, al as i64, buf as i64, n as i64, opt as i64) as i32;
  let pathz_own = __raw_string(pathz, plen + 1);
  if (rc < 0) {
    return Err(__fern_io_error(-rc, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(());
}
