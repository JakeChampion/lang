function __fern_reader_seek(fd: i32, off: i64, whence: i32): Result[i64, IoError] {
  if (whence < 0 || whence > 4) {
    return Err(__fern_io_error(22, ""));
  }
  let w: i32 = whence;
  if (w == 3) {
    w = 4;
  } else if (w == 4) {
    w = 3;
  }
  let r: i64 = __syscall3(199, fd as i64, off as i64, w as i64);
  if (r < 0 as i64) {
    return Err(__fern_io_error((0 as i64 - r) as i32, ""));
  }
  return Ok(r);
}
