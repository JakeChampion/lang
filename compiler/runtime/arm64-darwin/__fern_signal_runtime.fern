// The runtime convention number of a Darwin signal, or 0 for none.
function __fern_signal_runtime(host: i32): i32 {
  if (host < 1 || host > 31 || host == 7 || host == 29) {
    return 0;
  }
  if (host == 10) {
    return 7;
  }
  if (host == 30) {
    return 10;
  }
  if (host == 31) {
    return 12;
  }
  if (host == 20) {
    return 17;
  }
  if (host == 19) {
    return 18;
  }
  if (host == 17) {
    return 19;
  }
  if (host == 18) {
    return 20;
  }
  if (host == 16) {
    return 23;
  }
  if (host == 23) {
    return 29;
  }
  if (host == 12) {
    return 31;
  }
  return host;
}
