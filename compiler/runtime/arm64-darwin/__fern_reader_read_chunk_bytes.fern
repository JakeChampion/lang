function __fern_reader_read_chunk_bytes(fd: i32, n: i32): Result[i32[], IoError] {
  if (n < 0) {
    return Err(__fern_io_error(22, ""));
  }
  let raw: usize = __raw_arr_box(n / 8 + 1);
  let scratch: i32[] = __raw_array(raw);
  let p: usize = raw + 8;
  let got: i32 = __syscall3(3, fd as i64, p as i64, n as i64) as i32;
  if (got < 0) {
    return Err(__fern_io_error(0 - got, ""));
  }
  let b: usize = __raw_arr_box(got);
  let j: i32 = 0;
  while (j < got) {
    __raw_store_ptr(b, j + 1, __raw_load8(p, j) as usize);
    j = j + 1;
  }
  return Ok(__raw_array(b));
}
