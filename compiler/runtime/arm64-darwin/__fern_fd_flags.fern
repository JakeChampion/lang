function __fern_fd_flags(fd: i32): Result[i64, IoError] {
  let r: i32 = __syscall3(92, fd as i64, 3, 0) as i32;
  if (r < 0) {
    return Err(__fern_io_error(0 - r, ""));
  }
  let acc: i32 = r & 3;
  let bits: i32 = 0;
  if (acc != 1) {
    bits = bits | 1;
  }
  if (acc != 0) {
    bits = bits | 2;
  }
  if ((r & 8) != 0) {
    bits = bits | 4;
  }
  return Ok(bits as i64);
}
