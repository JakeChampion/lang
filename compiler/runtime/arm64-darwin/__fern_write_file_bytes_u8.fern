function __fern_write_file_bytes_u8(path: string, bytes: i32[]): Result[void, IoError] {
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let invalid = false;
  let i = 0;
  while (i < plen) {
    let c = path[i] as i32;
    if (c == 0) {
      invalid = true;
    }
    __raw_store8(pathz, i, c);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let pathz_own = __raw_string(pathz, plen + 1);
  if (invalid) {
    return Err(__fern_io_error(22, __fern_path_copy(pathz_own, plen)));
  }
  if (plen > 0 && path[plen - 1] == 47) {
    return Err(__fern_io_error(21, __fern_path_copy(pathz_own, plen)));
  }
  let fd = __syscall4(463, -2, pathz as i64, 1537, 420) as i32;
  if (fd < 0) {
    return Err(__fern_io_error(-fd, __fern_path_copy(pathz_own, plen)));
  }
  let n = bytes.len();
  let p = __raw_arr_ptr(bytes) + 8;
  let at = 0;
  let bad = 0;
  while (at < n && bad == 0) {
    let w = __syscall3(4, fd as i64, (p + at) as i64, (n - at) as i64) as i32;
    if (w == 0) {
      bad = 5;
    } else {
      if (w < 0) {
        if (w != -4 || at == 0) {
          bad = -w;
        }
      } else {
        at += w;
      }
    }
  }
  let closed = __syscall3(6, fd as i64, 0, 0) as i32;
  if (bad != 0) {
    return Err(__fern_io_error(bad, __fern_path_copy(pathz_own, plen)));
  }
  if (closed < 0) {
    return Err(__fern_io_error(-closed, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(());
}
