function __fern_sysctl(mib: i32[]): Result[i32[], IoError] {
  let n = mib.len();
  let m = __raw_alloc(n * 4 + 4);
  let i = 0;
  while (i < n) {
    let v = mib[i];
    __raw_store8(m, i * 4, v & 255);
    __raw_store8(m, i * 4 + 1, v >> 8 & 255);
    __raw_store8(m, i * 4 + 2, v >> 16 & 255);
    __raw_store8(m, i * 4 + 3, v >> 24 & 255);
    i += 1;
  }
  let lenp = __raw_alloc(8);
  __store_i64(lenp, 0 as i64);
  let r = __syscall6(202, m as i64, n as i64, 0, lenp as i64, 0, 0) as i32;
  let size = __load_i64(lenp) as i32;
  let buf = __raw_alloc(size + 1);
  if (r >= 0) {
    r = __syscall6(202, m as i64, n as i64, buf as i64, lenp as i64, 0, 0) as i32;
  }
  let got = __load_i64(lenp) as i32;
  let m_own = __raw_string(m, n * 4 + 4);
  let lenp_own = __raw_string(lenp, 8);
  if (r < 0) {
    let buf_own0 = __raw_string(buf, size + 1);
    return Err(__fern_io_error(-r, ""));
  }
  let b = __raw_arr_box((got + 7) / 8);
  __store_i64(b, got as i64);
  __memcpy(b + 8, buf, got);
  let buf_own = __raw_string(buf, size + 1);
  return Ok(__raw_array(b));
}
