// The kernel writes its 32-byte events into the array, and each one becomes
// the (fd, ready) pair at its index. A pair is 8 bytes, so a pair never
// overwrites an event that is not yet read.
function __fern_reactor_wait(r_fd: i32, events: i32[], timeout_ms: i32): i32 {
  if (events.len() / 2 <= 0) {
    return -22;
  }
  let b = __raw_arr_ptr(events);
  let buf = b + 8;
  let kcap = events.len() / 8;
  let ts = __raw_scratch(48);
  let tmo = 0 as usize;
  if (kcap < 1) {
    kcap = 1;
    buf = ts + 16;
  }
  if (timeout_ms >= 0) {
    __raw_store_ptr(ts, 0, (timeout_ms / 1000) as usize);
    __raw_store_ptr(ts, 1, (timeout_ms % 1000 * 1000000) as usize);
    tmo = ts;
  }
  let n = __syscall6(363, r_fd as i64, 0, 0, buf as i64, kcap as i64, tmo as i64) as i32;
  let i = 0;
  while (i < n) {
    let e = i * 32;
    let ready = 2;
    if (__raw_load8(buf, e + 8) == 255) {
      ready = 1;
    }
    if ((__raw_load8(buf, e + 11) & 192) != 0) {
      ready = ready | 4;
    }
    let fd = __raw_load8(buf, e) | __raw_load8(buf, e + 1) << 8 | __raw_load8(buf, e + 2) << 16 | __raw_load8(buf, e + 3) << 24;
    if (__raw_load8(buf, e + 8) == 250) {
      ready = 1;
      fd = -fd;
    }
    if (__raw_load8(buf, e + 8) == 251) {
      ready = 1;
      fd = -15;
    }
    __store_i32(b + (8 + i * 8) as usize, fd);
    __store_i32(b + (12 + i * 8) as usize, ready);
    i += 1;
  }
  return n;
}
