function __fern_tcp_send_bytes(fd: i32, bytes: i32[]): i32 {
  let n: i32 = bytes.len();
  let raw: usize = __raw_arr_box(n / 8 + 1);
  let scratch: i32[] = __raw_array(raw);
  let p: usize = __raw_arr_ptr(scratch) + 8;
  let j: i32 = 0;
  while (j < n) {
    __raw_store8(p, j, bytes[j]);
    j = j + 1;
  }
  return __syscall6(133, fd as i64, p as i64, n as i64, 524288, 0, 0) as i32;
}
