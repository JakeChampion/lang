function __fern_getcwd(): Result[string, IoError] {
  let dot: usize = __raw_alloc(2);
  __raw_store8(dot, 0, 46);
  __raw_store8(dot, 1, 0);
  let here: usize = __raw_alloc(144);
  let hr: i32 = __syscall4(470, -2, dot as i64, here as i64, 0) as i32;
  let hdev: i32 = __load_i32(here);
  let hino: i64 = __load_i64(here + 8);
  let here_own: string = __raw_string(here, 144);
  let fd: i32 = __syscall4(463, -2, dot as i64, 0, 0) as i32;
  let dot_own: string = __raw_string(dot, 2);
  if (fd < 0) {
    return Err(__fern_io_error(0 - fd, ""));
  }
  let buf: usize = __raw_alloc(4096);
  __raw_store8(buf, 0, 0);
  let rc: i32 = __syscall3(92, fd as i64, 50, buf as i64) as i32;
  __syscall3(6, fd as i64, 0, 0);
  let seen: usize = __raw_alloc(144);
  let sr: i32 = 0 - 2;
  if (rc >= 0) {
    sr = __syscall4(470, -2, buf as i64, seen as i64, 0) as i32;
  }
  let sdev: i32 = __load_i32(seen);
  let sino: i64 = __load_i64(seen + 8);
  let seen_own: string = __raw_string(seen, 144);
  let buf_own: string = __raw_string(buf, 4096);
  if (hr < 0) {
    return Err(__fern_io_error(0 - hr, ""));
  }
  if (rc < 0) {
    return Err(__fern_io_error(0 - rc, ""));
  }
  if (sr < 0) {
    return Err(__fern_io_error(0 - sr, ""));
  }
  if (sdev != hdev || sino != hino) {
    return Err(__fern_io_error(2, ""));
  }
  let n: i32 = 0;
  while (n < 4096 && buf_own[n] != 0) {
    n = n + 1;
  }
  if (__fern_utf8_valid(buf, n) == 0) {
    return Err(InvalidUtf8(""));
  }
  return Ok(__fern_path_copy(buf_own, n));
}
