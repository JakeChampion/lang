function __fern_reactor_ctl(r_fd: i32, op: i32, fd: i32, arg: i32): i32 {
  if (op == 3) {
    return __syscall3(6, r_fd as i64, 0, 0) as i32;
  }
  if (op == 4) {
    let act = __raw_scratch(32);
    let z = 0;
    while (z < 32) {
      __raw_store8(act, z, 0);
      z += 1;
    }
    // An ignored SIGCHLD (20) makes the kernel reap each child.
    if (fd != 20) {
      __raw_store8(act, 0, 1);
      let ignored = __syscall4(46, fd as i64, act as i64, 0, 8) as i32;
      if (ignored < 0) {
        return ignored;
      }
    }
    let ch = __raw_scratch(32);
    let sig_fd = fd;
    let sig_filter: i32 = -6;
    let sig_flags = 5;
    __raw_store_ptr(ch, 0, sig_fd as usize);
    __raw_store8(ch, 8, sig_filter & 255);
    __raw_store8(ch, 9, sig_filter >> 8 & 255);
    __raw_store8(ch, 10, sig_flags);
    __raw_store8(ch, 11, 0);
    __raw_store_ptr(ch, 2, 0);
    __raw_store_ptr(ch, 3, 0);
    __raw_store8(ch, 12, 0);
    __raw_store8(ch, 13, 0);
    __raw_store8(ch, 14, 0);
    __raw_store8(ch, 15, 0);
    return __syscall6(363, r_fd as i64, ch as i64, 1, 0, 0, 0) as i32;
  }
  if (op == 5) {
    let ch2 = __raw_scratch(32);
    let del_fd = fd;
    let del_filter: i32 = -6;
    let del_flags = 2;
    __raw_store_ptr(ch2, 0, del_fd as usize);
    __raw_store8(ch2, 8, del_filter & 255);
    __raw_store8(ch2, 9, del_filter >> 8 & 255);
    __raw_store8(ch2, 10, del_flags);
    __raw_store8(ch2, 11, 0);
    __raw_store_ptr(ch2, 2, 0);
    __raw_store_ptr(ch2, 3, 0);
    __raw_store8(ch2, 12, 0);
    __raw_store8(ch2, 13, 0);
    __raw_store8(ch2, 14, 0);
    __raw_store8(ch2, 15, 0);
    __syscall6(363, r_fd as i64, ch2 as i64, 1, 0, 0, 0);
    let act2 = __raw_scratch(32);
    let z2 = 0;
    while (z2 < 32) {
      __raw_store8(act2, z2, 0);
      z2 += 1;
    }
    return __syscall4(46, fd as i64, act2 as i64, 0, 8) as i32;
  }
  if (op == 6) {
    let ppid = __syscall3(39, 0, 0, 0) as i32;
    if (ppid == 1) {
      return -3;
    }
    let pch = __raw_scratch(32);
    let proc_filter: i32 = -5;
    let proc_flags = 17;
    __raw_store_ptr(pch, 0, ppid as usize);
    __raw_store8(pch, 8, proc_filter & 255);
    __raw_store8(pch, 9, proc_filter >> 8 & 255);
    __raw_store8(pch, 10, proc_flags);
    __raw_store8(pch, 11, 0);
    __raw_store_ptr(pch, 2, 0);
    __raw_store_ptr(pch, 3, 0);
    __raw_store8(pch, 12, 0);
    __raw_store8(pch, 13, 0);
    __raw_store8(pch, 14, 0);
    __raw_store8(pch, 15, 0);
    __raw_store8(pch, 15, 128);
    return __syscall6(363, r_fd as i64, pch as i64, 1, 0, 0, 0) as i32;
  }
  if (op != 1 && op != 2) {
    return -22;
  }
  let interest = arg & 23;
  if (op == 2) {
    interest = 0;
  }
  let ch = __raw_scratch(32);
  let r = 0;
  let filter: i32 = -1;
  let bit = 1;
  while (bit <= 2 && r >= 0) {
    let flags = 2;
    if ((interest & bit) != 0) {
      flags = 5;
      if ((interest & 16) != 0) {
        flags = 21;
      }
    }
    if ((interest & bit) != 0 || (interest & 16) == 0) {
      __raw_store_ptr(ch, 0, fd as usize);
      __raw_store8(ch, 8, filter & 255);
      __raw_store8(ch, 9, filter >> 8 & 255);
      __raw_store8(ch, 10, flags);
      __raw_store8(ch, 11, 0);
      __raw_store_ptr(ch, 2, 0);
      __raw_store_ptr(ch, 3, 0);
      __raw_store8(ch, 12, 0);
      __raw_store8(ch, 13, 0);
      __raw_store8(ch, 14, 0);
      __raw_store8(ch, 15, 0);
      let e = __syscall6(363, r_fd as i64, ch as i64, 1, 0, 0, 0) as i32;
      if (e < 0 && !(flags == 2 && e == -2)) {
        r = e;
      }
    }
    filter -= 1;
    bit += bit;
  }
  return r;
}
