// Android discards the stderr of an app, so each line also goes to logcat at
// priority W, as ART logs System.err.
function __fern_eprint_str(s: string): i32 {
  let iov: usize = __raw_scratch(33);
  __raw_store8(iov, 32, 10);
  __raw_store_ptr(iov, 0, __raw_data(s));
  __raw_store_ptr(iov, 1, s.len() as usize);
  __raw_store_ptr(iov, 2, iov + 32);
  __raw_store_ptr(iov, 3, 1 as usize);
  let rc: i32 = __syscall3(20, 2, iov as i64, 2) as i32;
  __fern_logcat(5, __raw_data(s), s.len());
  return rc;
}
