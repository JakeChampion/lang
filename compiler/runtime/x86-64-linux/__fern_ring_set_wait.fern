function __fern_ring_set_wait(blk: usize, ep: i32, b: usize, from: i32, cap: i32): i32 {
  let room = cap - from;
  if (room > 64) {
    room = 64;
  }
  if (room <= 0) {
    return from;
  }
  let evs = blk + 2048;
  let m = __syscall6(281, ep as i64, evs as i64, room as i64, 0, 0, 8) as i32;
  let n = from;
  let j = 0;
  while (j < m) {
    let e = evs + j as usize * 12;
    let bits = __raw_load8(e, 0);
    let ready = 0;
    if ((bits & 1) != 0) {
      ready = ready | 1;
    }
    if ((bits & 4) != 0) {
      ready = ready | 2;
    }
    if ((bits & 24) != 0) {
      ready = ready | 4;
    }
    __store_i32(b + (8 + n * 8) as usize, __load_i32(e + 4));
    __store_i32(b + (12 + n * 8) as usize, ready);
    n += 1;
    j += 1;
  }
  return n;
}
