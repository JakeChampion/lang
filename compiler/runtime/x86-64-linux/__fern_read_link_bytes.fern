function __fern_read_link_bytes(path: string): Result[i32[], IoError] {
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let buf = __raw_alloc(4096);
  let n = __syscall4(267, -100, pathz as i64, buf as i64, 4096) as i32;
  let pathz_own = __raw_string(pathz, plen + 1);
  if (n < 0) {
    let buf_own = __raw_string(buf, 4096);
    return Err(__fern_io_error(-n, __fern_path_copy(pathz_own, plen)));
  }
  if (n >= 4096) {
    let buf_own = __raw_string(buf, 4096);
    return Err(__fern_io_error(36, __fern_path_copy(pathz_own, plen)));
  }
  let out = __raw_arr_box((n + 7) / 8);
  __store_i64(out, n as i64);
  __memcpy(out + 8, buf, n);
  let buf_own = __raw_string(buf, 4096);
  return Ok(__raw_array(out));
}
