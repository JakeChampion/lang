function __fern_proc_waitpid(pid: i32): i32 {
  let st: usize = __raw_scratch(16);
  let rc: i32 = __syscall4(61, pid as i64, st as i64, 0, 0) as i32;
  if (rc < 0) {
    return rc;
  }
  let w: i32 = __load_i32(st);
  let sig: i32 = w & 127;
  if (sig != 0) {
    return sig + 128;
  }
  return w >> 8 & 255;
}
