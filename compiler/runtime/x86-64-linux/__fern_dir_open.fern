function __fern_dir_open(dirfd: i32, path: string): Result[i32, IoError] {
  let plen: i32 = path.len();
  let pathz: usize = __raw_alloc(plen + 1);
  let i: i32 = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i = i + 1;
  }
  __raw_store8(pathz, plen, 0);
  let fd: i32 = __syscall3(257, dirfd as i64, pathz as i64, (65536 | 524288 | 131072) as i64) as i32;
  let pathz_own: string = __raw_string(pathz, plen + 1);
  if (fd < 0) {
    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(fd);
}
