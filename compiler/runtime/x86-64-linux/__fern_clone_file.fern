function __fern_clone_file(src: string, dest: string): Result[void, IoError] {
  let slen = src.len();
  let srcz = __raw_alloc(slen + 1);
  let j = 0;
  while (j < slen) {
    __raw_store8(srcz, j, src[j] as i32);
    j += 1;
  }
  __raw_store8(srcz, slen, 0);
  let dlen = dest.len();
  let destz = __raw_alloc(dlen + 1);
  let i = 0;
  while (i < dlen) {
    __raw_store8(destz, i, dest[i] as i32);
    i += 1;
  }
  __raw_store8(destz, dlen, 0);
  let srcz_own = __raw_string(srcz, slen + 1);
  let destz_own = __raw_string(destz, dlen + 1);
  let sfd = __syscall4(257, -100, srcz as i64, 0, 0) as i32;
  if (sfd < 0) {
    return Err(__fern_io_error(-sfd, __fern_path_copy(srcz_own, slen)));
  }
  let made = 1;
  let dfd = __syscall4(257, -100, destz as i64, 193, 438) as i32;
  if (dfd == -17) {
    made = 0;
    dfd = __syscall4(257, -100, destz as i64, 1, 0) as i32;
  }
  if (dfd < 0) {
    __syscall3(3, sfd as i64, 0, 0);
    return Err(__fern_io_error(-dfd, __fern_path_copy(destz_own, dlen)));
  }
  let rc = __syscall3(16, dfd as i64, 1074041865, sfd as i64) as i32;
  __syscall3(3, dfd as i64, 0, 0);
  __syscall3(3, sfd as i64, 0, 0);
  if (rc < 0 && made == 1) {
    __syscall3(263, -100, destz as i64, 0);
  }
  if (rc < 0) {
    return Err(__fern_io_error(-rc, __fern_path_copy(destz_own, dlen)));
  }
  return Ok(());
}
