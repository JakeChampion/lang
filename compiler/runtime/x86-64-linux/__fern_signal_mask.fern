function __fern_signal_mask(how: i32, mask: i64): i64 {
  let buf: usize = __raw_scratch(16);
  __store_i64(buf, mask);
  __store_i64(buf + 8, 0 as i64);
  let rc: i32 = __syscall4(14, how as i64, buf as i64, (buf + 8) as i64, 8) as i32;
  if (rc < 0) {
    return rc as i64;
  }
  return __load_i64(buf + 8);
}
