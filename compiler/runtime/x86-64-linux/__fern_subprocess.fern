function __fern_subprocess(cmd: string, args: string[], input: string): ProcessResult {
  let has_nul = __count_byte(cmd, 0) > 0;
  let clen = cmd.len();
  let cmdz = __raw_alloc(clen + 1);
  let i: i32 = 0;
  while (i < clen) {
    __raw_store8(cmdz, i, cmd[i] as i32);
    i += 1;
  }
  __raw_store8(cmdz, clen, 0);
  let n = args.len();
  let argv = __raw_alloc((n + 2) * 8);
  __raw_store_ptr(argv, 0, cmdz);
  let total: i32 = 1;
  let m: i32 = 0;
  while (m < n) {
    total = total + args[m].len() + 1;
    m += 1;
  }
  let ab = __raw_alloc(total);
  let off: i32 = 0;
  let k: i32 = 0;
  while (k < n) {
    let a = args[k];
    if (__count_byte(a, 0) > 0) {
      has_nul = true;
    }
    let al = a.len();
    __raw_store_ptr(argv, k + 1, ab + off as usize);
    let j: i32 = 0;
    while (j < al) {
      __raw_store8(ab, off + j, a[j] as i32);
      j += 1;
    }
    __raw_store8(ab, off + al, 0);
    off = off + al + 1;
    k += 1;
  }
  __raw_store_ptr(argv, n + 1, 0);
  let fds = __raw_alloc(32);
  __syscall3(293, fds as i64, 0, 0);
  __syscall3(293, (fds + 8) as i64, 0, 0);
  __syscall3(293, (fds + 16) as i64, 0, 0);
  let in_r = __load_i32(fds);
  let in_w = __load_i32(fds + 4);
  let out_r = __load_i32(fds + 8);
  let out_w = __load_i32(fds + 12);
  let err_r = __load_i32(fds + 16);
  let err_w = __load_i32(fds + 20);
  let pid = __syscall5(56, 17, 0, 0, 0, 0) as i32;
  if (pid == 0) {
    __syscall3(292, in_r as i64, 0, 0);
    __syscall3(292, out_w as i64, 1, 0);
    __syscall3(292, err_w as i64, 2, 0);
    __syscall3(3, in_r as i64, 0, 0);
    __syscall3(3, in_w as i64, 0, 0);
    __syscall3(3, out_r as i64, 0, 0);
    __syscall3(3, out_w as i64, 0, 0);
    __syscall3(3, err_r as i64, 0, 0);
    __syscall3(3, err_w as i64, 0, 0);
    let envp = __raw_environ();
    if (has_nul) {
      __fern_sp_exec_failed(cmdz, clen, -22);
    }
    let rc0 = __fern_sp_exec_path(cmdz, clen, argv, envp);
    __fern_sp_exec_failed(cmdz, clen, rc0);
  }
  __syscall3(3, in_r as i64, 0, 0);
  __syscall3(3, out_w as i64, 0, 0);
  __syscall3(3, err_w as i64, 0, 0);
  if (input.len() > 0) {
    __syscall3(1, in_w as i64, __raw_data(input) as i64, input.len() as i64);
  }
  __syscall3(3, in_w as i64, 0, 0);
  let obuf = __raw_alloc(65536);
  let olen = __fern_sp_drain(out_r, obuf);
  let ebuf = __raw_alloc(65536);
  let elen = __fern_sp_drain(err_r, ebuf);
  __syscall4(61, pid as i64, (fds + 24) as i64, 0, 0);
  let w = __load_i32(fds + 24);
  let code = w >> 8 & 255;
  if ((w & 127) != 0) {
    code = (w & 127) + 128;
  }
  let fds_own = __raw_string(fds, 32);
  let cmdz_own = __raw_string(cmdz, clen + 1);
  let ab_own = __raw_string(ab, total);
  let argv_own = __raw_string(argv, (n + 2) * 8);
  let sout = "";
  if (olen > 0) {
    let so = __raw_alloc(olen);
    __memcpy(so, obuf, olen);
    sout = __raw_string(so, olen);
  }
  let serr = "";
  if (elen > 0) {
    let se = __raw_alloc(elen);
    __memcpy(se, ebuf, elen);
    serr = __raw_string(se, elen);
  }
  let obuf_own = __raw_string(obuf, 65536);
  let ebuf_own = __raw_string(ebuf, 65536);
  return ProcessResult { stdout: sout, stderr: serr, exit_code: code };
}
