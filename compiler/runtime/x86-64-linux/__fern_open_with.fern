function __fern_open_with(path: string, flags: i32, write: i32): Result[i32, IoError] {
  let f: i32 = 0;
  if (write != 0) {
    f = 1;
  }
  if ((flags & 1) != 0) {
    f = f | 64;
  }
  if ((flags & 2) != 0) {
    f = f | 2048;
  }
  if ((flags & 4) != 0) {
    f = f | 128;
  }
  if ((flags & 8) != 0) {
    f = f | 16384;
  }
  if ((flags & 16) != 0) {
    f = f | 65536;
  }
  if ((flags & 32) != 0) {
    f = f | 4096;
  }
  if ((flags & 64) != 0) {
    f = f | 1052672;
  }
  if ((flags & 128) != 0) {
    f = f | 262144;
  }
  if ((flags & 256) != 0) {
    f = f | 256;
  }
  if ((flags & 512) != 0) {
    f = f | 131072;
  }
  return __fern_open_res(path, f, 438);
}
