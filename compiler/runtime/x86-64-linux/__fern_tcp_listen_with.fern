function __fern_tcp_listen_with(addr: i32[], port: i32, backlog: i32, reuse_port: boolean): i32 {
  let af: i32 = 2;
  if (addr.len() == 16) {
    af = 10;
  } else if (addr.len() != 4) {
    return 0 - 97;
  }
  let fd: i32 = __syscall3(41, af as i64, 1, 0) as i32;
  if (fd < 0) {
    return fd;
  }
  let sa: usize = __raw_scratch(32);
  let r: i32 = 0;
  if (af == 10) {
    __raw_store8(sa, 28, 0);
    __raw_store8(sa, 29, 0);
    __raw_store8(sa, 30, 0);
    __raw_store8(sa, 31, 0);
    r = __syscall5(54, fd as i64, 41, 26, (sa + 28) as i64, 4) as i32;
  }
  if (r >= 0) {
    __raw_store8(sa, 28, 1);
    __raw_store8(sa, 29, 0);
    __raw_store8(sa, 30, 0);
    __raw_store8(sa, 31, 0);
    r = __syscall5(54, fd as i64, 1, 2, (sa + 28) as i64, 4) as i32;
  }
  if (r >= 0 && reuse_port) {
    r = __syscall5(54, fd as i64, 1, 15, (sa + 28) as i64, 4) as i32;
  }
  let salen: i32 = 16;
  let at: i32 = 4;
  if (addr.len() == 16) {
    salen = 28;
    at = 8;
  }
  let z: i32 = 0;
  while (z < 28) {
    __raw_store8(sa, z, 0);
    z = z + 1;
  }
  __raw_store8(sa, 0, af);
  __raw_store8(sa, 1, 0);
  __raw_store8(sa, 2, port >> 8 & 255);
  __raw_store8(sa, 3, port & 255);
  let ap: usize = __raw_arr_ptr(addr);
  let k: i32 = 0;
  while (k < addr.len()) {
    __raw_store8(sa, at + k, __raw_load_ptr(ap, k + 1) as i32);
    k = k + 1;
  }
  if (r >= 0) {
    r = __syscall3(49, fd as i64, sa as i64, salen as i64) as i32;
  }
  if (r >= 0) {
    r = __syscall3(50, fd as i64, backlog as i64, 0) as i32;
  }
  if (r < 0) {
    __syscall3(3, fd as i64, 0, 0);
    return r;
  }
  return fd;
}
