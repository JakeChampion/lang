function __fern_write_file(path: string, contents: string): Result[void, IoError] {
  let plen: i32 = path.len();
  let pathz: usize = __raw_alloc(plen + 1);
  let i: i32 = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i = i + 1;
  }
  __raw_store8(pathz, plen, 0);
  let pathz_own: string = __raw_string(pathz, plen + 1);
  let fd: i32 = __syscall4(257, -100, pathz as i64, 577, 420) as i32;
  if (fd < 0) {
    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));
  }
  let clen: i32 = contents.len();
  let cbuf: usize = __str_bytes(contents, 0 as usize);
  let put: i32 = 0;
  while (put < clen) {
    let w: i32 = __syscall3(1, fd as i64, (cbuf + put) as i64, (clen - put) as i64) as i32;
    if (w == 0 - 4 && put > 0) {
      continue;
    }
    if (w < 0) {
      __syscall3(3, fd as i64, 0, 0);
      return Err(__fern_io_error(0 - w, __fern_path_copy(pathz_own, plen)));
    }
    if (w == 0) {
      __syscall3(3, fd as i64, 0, 0);
      return Err(__fern_io_error(5, __fern_path_copy(pathz_own, plen)));
    }
    put = put + w;
  }
  __syscall3(3, fd as i64, 0, 0);
  return Ok(());
}
