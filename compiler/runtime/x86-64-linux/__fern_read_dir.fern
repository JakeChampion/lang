function __fern_read_dir(path: string): Result[string[], IoError] {
  if (__count_byte(path, 0) > 0) {
    return Err(__fern_io_error(22, __fern_path_copy(path, path.len())));
  }
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let fd = __syscall3(257, -100, pathz as i64, 65536) as i32;
  let pathz_own = __raw_string(pathz, plen + 1);
  if (fd < 0) {
    return Err(__fern_io_error(-fd, __fern_path_copy(pathz_own, plen)));
  }
  let basep = __raw_alloc(8);
  let names: string[] = [];
  let bad = 0;
  let done = 0;
  while (done == 0) {
    let buf = __raw_alloc(65536);
    let n = __syscall4(217, fd as i64, buf as i64, 65536, basep as i64) as i32;
    if (n <= 0) {
      done = 1;
      bad = n;
    } else {
      let pos = 0;
      while (pos < n) {
        let reclen = __raw_load8(buf, pos + 16) + __raw_load8(buf, pos + 17) * 256;
        let nlen = 0;
        let room = reclen - 19;
        let scan = 1;
        while (scan == 1 && nlen + 8 <= room) {
          let w = __load_i64(buf + pos as usize + 19 + nlen as usize);
          let z = w - 72340172838076673 as i64 & (w ^ (-1) as i64) & (-9187201950435737472) as i64;
          if (z != 0 as i64) {
            nlen += __ctz64(z as u64) >> 3;
            scan = 0;
          } else {
            nlen += 8;
          }
        }
        if (scan == 1) {
          while (__raw_load8(buf, pos + 19 + nlen) != 0) {
            nlen += 1;
          }
        }
        if (__fern_utf8_valid(buf + pos as usize + 19, nlen) == 0) {
          bad = -84;
          done = 1;
          pos = n;
        } else {
          let skip = 0;
          if (nlen == 1) {
            if (__raw_load8(buf, pos + 19) == 46) {
              skip = 1;
            }
          }
          if (nlen == 2) {
            if (__raw_load8(buf, pos + 19) == 46) {
              if (__raw_load8(buf, pos + 19 + 1) == 46) {
                skip = 1;
              }
            }
          }
          if (skip == 0) {
            let nbuf = __raw_alloc(nlen);
            __memcpy(nbuf, buf + pos as usize + 19, nlen);
            names = names.append(__raw_string(nbuf, nlen));
          }
          pos += reclen;
        }
      }
    }
    let buf_own = __raw_string(buf, 65536);
  }
  let basep_own = __raw_string(basep, 8);
  __syscall3(3, fd as i64, 0, 0);
  if (bad < 0) {
    return Err(__fern_io_error(-bad, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(names);
}
