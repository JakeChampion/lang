function __fern_writer_splice_forever(fd: i32, s: string): Result[void, IoError] {
  let n = s.len();
  if (n == 0) {
    return Err(Unsupported);
  }
  let copies = 131072 / n;
  if (copies < 1) {
    copies = 1;
  }
  let len = copies * n;
  let pages: i32 = (len + 4095) / 4096 * 4096;
  let span = pages + 4096;
  let m = __syscall6(9, 0, span as i64, 3, 34, (-1) as i64, 0);
  if (m < 0 as i64) {
    return Err(Unsupported);
  }
  let buf = m as usize;
  let c: i32 = 0;
  while (c < copies) {
    __memcpy(buf + (c * n) as usize, __raw_data(s), n);
    c += 1;
  }
  let iov = buf + pages as usize;
  let out = fd;
  let pr: i32 = -1;
  __syscall3(72, fd as i64, 1031, 524288);
  let off: i32 = 0;
  let moved = 0 as i64;
  let err: i32 = 0;
  while (err == 0) {
    __store_i64(iov, (buf + off as usize) as i64);
    __store_i64(iov + 8, (len - off) as i64);
    let gift: i32 = 0;
    if (off % 4096 == 0 && (len - off) % 4096 == 0) {
      gift = 8;
    }
    let w = __syscall4(278, out as i64, iov as i64, 1, gift as i64) as i32;
    if ((w == -9 || w == -22) && pr < 0 && moved == 0 as i64) {
      let fds = iov + 16;
      if (__syscall3(293, fds as i64, 524288, 0) != 0) {
        err = -1;
      } else {
        pr = __load_i32(fds);
        out = __load_i32(fds + 4);
        __syscall3(72, pr as i64, 1031, 524288);
      }
    } else if (w < 0) {
      if (w != -4) {
        err = -w;
      }
    } else {
      let left = w;
      while (pr >= 0 && left > 0 && err == 0) {
        let d = __syscall6(275, pr as i64, 0, fd as i64, 0, left as i64, 1) as i32;
        if (d > 0) {
          left -= d;
          moved = moved + d as i64;
        } else if (d == -22 && moved == 0 as i64) {
          err = -1;
        } else if (d != -4) {
          err = -d;
          if (d == 0) {
            err = 5;
          }
        }
      }
      if (pr < 0) {
        moved = moved + w as i64;
      }
      off += w;
      if (off >= len) {
        off = 0;
      }
    }
  }
  if (pr >= 0) {
    __syscall3(3, pr as i64, 0, 0);
    __syscall3(3, out as i64, 0, 0);
  }
  __syscall3(11, m, span as i64, 0);
  if (err < 0) {
    return Err(Unsupported);
  }
  return Err(__fern_io_error(err, ""));
}
