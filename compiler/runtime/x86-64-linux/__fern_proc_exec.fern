function __fern_proc_exec(path: string, args: string[]): i32 {
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i: i32 = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let n = args.len();
  let argv = __raw_alloc((n + 2) * 8);
  __raw_store_ptr(argv, 0, pathz);
  let total: i32 = 1;
  let m: i32 = 0;
  while (m < n) {
    total = total + args[m].len() + 1;
    m += 1;
  }
  let ab = __raw_alloc(total);
  let off: i32 = 0;
  let k: i32 = 0;
  while (k < n) {
    let a = args[k];
    let al = a.len();
    __raw_store_ptr(argv, k + 1, ab + off);
    let j: i32 = 0;
    while (j < al) {
      __raw_store8(ab, off + j, a[j] as i32);
      j += 1;
    }
    __raw_store8(ab, off + al, 0);
    off = off + al + 1;
    k += 1;
  }
  __raw_store_ptr(argv, n + 1, 0);
  let rc = __syscall3(59, pathz as i64, argv as i64, __raw_environ() as i64) as i32;
  let pathz_own = __raw_string(pathz, plen + 1);
  let argv_own = __raw_string(argv, (n + 2) * 8);
  let args_own = __raw_string(ab, total);
  return rc;
}
