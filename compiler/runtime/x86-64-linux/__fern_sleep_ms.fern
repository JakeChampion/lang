function __fern_sleep_ms(ms: i64): i32 {
  if (ms <= 0 as i64) {
    return 0;
  }
  let ts: usize = __raw_scratch(16);
  let sec: i64 = ms / (1000 as i64);
  __store_i64(ts, sec);
  __store_i64(ts + 8, (ms - sec * (1000 as i64)) * (1000000 as i64));
  return __syscall3(35, ts as i64, 0, 0) as i32;
}
