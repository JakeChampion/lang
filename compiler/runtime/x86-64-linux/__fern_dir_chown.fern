function __fern_dir_chown(dirfd: i32, path: string, uid: i32, gid: i32, follow: boolean): Result[void, IoError] {
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let fl = 256;
  if (follow) {
    fl = 0;
  }
  let rc = __syscall5(260, dirfd as i64, pathz as i64, uid as i64, gid as i64, fl as i64) as i32;
  let pathz_own = __raw_string(pathz, plen + 1);
  if (rc < 0) {
    return Err(__fern_io_error(-rc, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(());
}
