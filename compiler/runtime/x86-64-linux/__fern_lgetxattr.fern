function __fern_lgetxattr(path: string, name: string): Result[string, IoError] {
  if (__count_byte(name, 0) > 0) {
    return Err(__fern_io_error(22, __fern_path_copy(name, name.len())));
  }
  if (__count_byte(path, 0) > 0) {
    return Err(__fern_io_error(22, __fern_path_copy(path, path.len())));
  }
  let nlen = name.len();
  let namez = __raw_alloc(nlen + 1);
  let j = 0;
  while (j < nlen) {
    __raw_store8(namez, j, name[j] as i32);
    j += 1;
  }
  __raw_store8(namez, nlen, 0);
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let buf = __raw_alloc(65536);
  let n = __syscall4(192, pathz as i64, namez as i64, buf as i64, 65536) as i32;
  let namez_own = __raw_string(namez, nlen + 1);
  let pathz_own = __raw_string(pathz, plen + 1);
  let buf_own = __raw_string(buf, 65536);
  if (n < 0) {
    return Err(__fern_io_error(-n, __fern_path_copy(pathz_own, plen)));
  }
  if (__fern_utf8_valid(buf, n) == 0) {
    return Err(InvalidUtf8(__fern_path_copy(pathz_own, plen)));
  }
  return Ok(__fern_path_copy(buf_own, n));
}
