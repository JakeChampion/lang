function __fern_ring_ctl(ring: i64, op: i32, fd: i32, arg: i32): i32 {
  if (ring < 0 as i64) {
    return 0 - 9;
  }
  let blk: usize = ring as usize;
  if (op == 1) {
    return __fern_ring_watch(blk, fd, arg & 15, 0);
  }
  if (op == 2) {
    return __fern_ring_watch(blk, fd, 0, 0);
  }
  if (op == 3) {
    let rfd: i64 = __load_i32(blk) as i64;
    __syscall3(11, __load_i64(blk + 24), __load_i64(blk + 96), 0);
    __syscall3(11, __load_i64(blk + 16), __load_i64(blk + 88), 0);
    __syscall3(11, __load_i64(blk + 8), __load_i64(blk + 80), 0);
    __syscall3(3, rfd, 0, 0);
    let ep: i32 = __load_i32(blk + 116);
    if (ep > 0) {
      __syscall3(3, ep as i64, 0, 0);
    }
    let pb: i64 = __load_i64(blk + 160);
    if (pb != 0 as i64) {
      __syscall3(11, pb, 1056768, 0);
    }
    return __syscall3(11, ring, __load_i64(blk + 104), 0) as i32;
  }
  if (op == 4 || op == 5) {
    if (fd <= 0 || fd > 64) {
      return 0 - 22;
    }
    let set: usize = __raw_scratch(8);
    __store_i64(set, 0);
    let bit: i32 = fd - 1;
    let bit_off: i32 = 0;
    if (fd > 32) {
      bit = fd - 33;
      bit_off = 4;
    }
    __raw_store8(set, bit_off + bit / 8, 1 << bit % 8);
    if (op == 4) {
      let blocked: i32 = __syscall4(14, 0, set as i64, 0, 8) as i32;
      if (blocked < 0) {
        return blocked;
      }
      let sfd: i32 = __syscall4(289, 0 - 1, set as i64, 8, 526336) as i32;
      if (sfd < 0) {
        return sfd;
      }
      let watched: i32 = __fern_ring_watch(blk, sfd, 1, fd);
      if (watched < 0) {
        __syscall3(3, sfd as i64, 0, 0);
        return watched;
      }
      return sfd;
    }
    __fern_ring_watch(blk, arg, 0, 0);
    __syscall3(3, arg as i64, 0, 0);
    return __syscall4(14, 1, set as i64, 0, 8) as i32;
  }
  if (op == 6) {
    let pdeath: i32 = __syscall3(157, 1, 15, 0) as i32;
    if (pdeath < 0) {
      return pdeath;
    }
    if (__syscall3(110, 0, 0, 0) as i32 == 1) {
      return 0 - 3;
    }
    return 0;
  }
  if (op == 7) {
    return __load_i32(blk);
  }
  if (op >= 8 && op <= 10) {
    if (fd < 0 || fd >= 512) {
      return 0 - 22;
    }
    let z: usize = __fern_ring_zc_at(blk) + fd as usize * 16;
    let st: i32 = __load_i32(z + 8);
    if (st == 0) {
      return 0 - 2;
    }
    if (op == 8) {
      return __load_i32(z + 4);
    }
    if (op == 9) {
      if (st == 3) {
        return 1;
      }
      return 0;
    }
    if (st != 3) {
      return 0 - 16;
    }
    __store_i32(z + 8, 0);
    return 0;
  }
  return 0 - 22;
}
