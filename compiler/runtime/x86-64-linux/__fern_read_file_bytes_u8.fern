function __fern_read_file_bytes_u8(path: string): Result[i32[], IoError] {
  if (__count_byte(path, 0) > 0) {
    return Err(__fern_io_error(22, __fern_path_copy(path, path.len())));
  }
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let fd = __syscall3(257, -100, pathz as i64, 0) as i32;
  let pathz_own = __raw_string(pathz, plen + 1);
  if (fd < 0) {
    return Err(__fern_io_error(-fd, __fern_path_copy(pathz_own, plen)));
  }
  let st = __raw_scratch(160);
  let src = __syscall3(5, fd as i64, st as i64, 0) as i32;
  if (src < 0) {
    __syscall3(3, fd as i64, 0, 0);
    return Err(__fern_io_error(-src, __fern_path_copy(pathz_own, plen)));
  }
  let size = __load_i64(st + 48) as i32;
  let cap = size;
  if (cap < 1) {
    cap = 1;
  }
  let b = __raw_arr_box((cap + 7) / 8);
  let buf = b + 8;
  let got = 0;
  let bad = 0;
  let done = 0;
  while (done == 0) {
    if (got >= cap) {
      let pn = __syscall3(0, fd as i64, st as i64, 1) as i32;
      if (pn < 0 && pn != -4) {
        bad = pn;
        done = 1;
      } else {
        if (pn == 0) {
          done = 1;
        } else if (pn > 0) {
          let nc = cap * 2;
          if (nc < 4096) {
            nc = 4096;
          }
          let nb = __raw_arr_box((nc + 7) / 8);
          __memcpy(nb + 8, buf, got);
          __store_i64(b, 0);
          let old_own = __raw_array(b);
          b = nb;
          buf = nb + 8;
          cap = nc;
          __raw_store8(buf, got, __raw_load8(st, 0));
          got += 1;
        }
      }
    } else {
      let n = __syscall3(0, fd as i64, (buf + got as usize) as i64, (cap - got) as i64) as i32;
      if (n < 0 && (n != -4 || got == 0)) {
        bad = n;
        done = 1;
      } else {
        if (n == 0) {
          done = 1;
        } else {
          if (n > 0) {
            got += n;
          }
        }
      }
    }
  }
  __syscall3(3, fd as i64, 0, 0);
  if (bad < 0) {
    __store_i64(b, 0);
    let b_own = __raw_array(b);
    return Err(__fern_io_error(-bad, __fern_path_copy(pathz_own, plen)));
  }
  __store_i64(b, got as i64);
  return Ok(__raw_array(b));
}
