function __fern_open_res(path: string, flags: i32, mode: i32): Result[i32, IoError] {
  let plen: i32 = path.len();
  let pathz: usize = __raw_alloc(plen + 1);
  let i: i32 = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i = i + 1;
  }
  __raw_store8(pathz, plen, 0);
  let f: i32 = flags | 524288;
  let pathz_own: string = __raw_string(pathz, plen + 1);
  let fd: i32 = __syscall4(257, -100, pathz as i64, f as i64, mode as i64) as i32;
  if (fd >= 0 && fd < 3) {
    let moved: i32 = __syscall3(72, fd as i64, 0, 3) as i32;
    __syscall3(3, fd as i64, 0, 0);
    fd = moved;
  }
  if (fd < 0) {
    return Err(__fern_io_error(0 - fd, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(fd);
}
