function __fern_create_link(target: string, path: string): Result[void, IoError] {
  if (__count_byte(target, 0) > 0) {
    return Err(__fern_io_error(22, __fern_path_copy(target, target.len())));
  }
  if (__count_byte(path, 0) > 0) {
    return Err(__fern_io_error(22, __fern_path_copy(path, path.len())));
  }
  let tlen = target.len();
  let targetz = __raw_alloc(tlen + 1);
  let j = 0;
  while (j < tlen) {
    __raw_store8(targetz, j, target[j] as i32);
    j += 1;
  }
  __raw_store8(targetz, tlen, 0);
  let plen = path.len();
  let pathz = __raw_alloc(plen + 1);
  let i = 0;
  while (i < plen) {
    __raw_store8(pathz, i, path[i] as i32);
    i += 1;
  }
  __raw_store8(pathz, plen, 0);
  let rc = __syscall5(265, -100, targetz as i64, -100, pathz as i64, 0) as i32;
  let targetz_own = __raw_string(targetz, tlen + 1);
  let pathz_own = __raw_string(pathz, plen + 1);
  if (rc < 0) {
    return Err(__fern_io_error(-rc, __fern_path_copy(pathz_own, plen)));
  }
  return Ok(());
}
