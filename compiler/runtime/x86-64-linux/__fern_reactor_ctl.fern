      __raw_store8(ev, 4 + 6, sfd >> 16 & 255);
      __raw_store8(ev, 4 + 7, sfd >> 24 & 255);
      let added: i32 = __syscall4(233, r_fd as i64, 1, sfd as i64, ev as i64) as i32;
      if (added < 0) {
        __syscall3(3, sfd as i64, 0, 0);
        return added;
      }
      return sfd;
    }
    let ev2: usize = __raw_scratch(16);
    __syscall4(233, r_fd as i64, 2, arg as i64, ev2 as i64);
    __syscall3(3, arg as i64, 0, 0);
    return __syscall4(14, 1, set as i64, 0, 8) as i32;
  }
  if (op == 6) {
    let pdeath: i32 = __syscall3(157, 1, 15, 0) as i32;
    if (pdeath < 0) {
      return pdeath;
    }
    if (__syscall3(110, 0, 0, 0) as i32 == 1) {
      return 0 - 3;
    }
    return 0;
  }
  if (op != 1 && op != 2) {
    return 0 - 22;
  }
  let interest: i32 = arg & 23;
  if (op == 2) {
    interest = 0;
  }
  let ev: usize = __raw_scratch(16);
  let bits: i32 = 0;
  if ((interest & 1) != 0) {
    bits = bits | 1;
  }
  if ((interest & 2) != 0) {
    bits = bits | 4;
  }
  if ((interest & 4) != 0) {
    bits = bits | 268435456;
  }
  if ((interest & 16) != 0) {
    bits = bits | 1073741824;
  }
  __raw_store8(ev, 0, bits & 255);
  __raw_store8(ev, 1, bits >> 8 & 255);
  __raw_store8(ev, 2, bits >> 16 & 255);
  __raw_store8(ev, 3, bits >> 24 & 255);
  __raw_store8(ev, 4, fd & 255);
  __raw_store8(ev, 4 + 1, fd >> 8 & 255);
  __raw_store8(ev, 4 + 2, fd >> 16 & 255);
  __raw_store8(ev, 4 + 3, fd >> 24 & 255);
  __raw_store8(ev, 4 + 4, 0);
  __raw_store8(ev, 4 + 5, 0);
  __raw_store8(ev, 4 + 6, 0);
  __raw_store8(ev, 4 + 7, 0);
  let r: i32 = 0;
