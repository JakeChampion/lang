    r = __syscall4(233, r_fd as i64, 2, fd as i64, ev as i64) as i32;
  } else if ((interest & 16) != 0) {
    r = __syscall4(233, r_fd as i64, 3, fd as i64, ev as i64) as i32;
    if (r == 0 - 2) {
