// Packed ndarray maps and outer products reach kernels from typed values,
// before ownership planning. A strided receiver must keep its scalar walk:
// scaling storage order and retaining its shape would transpose the answer.
import "./ssa";
import "./ssasem";
import "./semtypes";
import "./typeinfo";
import "./util";
import "./semndlayout";
import "./semarrayreport";

pub struct Scaled { funcs: ssasem.Func[], rewritten: boolean[], sites: semarrayreport.Site[] }

struct Def { found: boolean, ins: ssa.SInst }

struct Factor { ok: boolean, literal: string, reason: i32 }

function no_factor(reason: i32): Factor {
  return Factor { ok: false, literal: "", reason: reason };
}

function definition(f: ssasem.Func, v: i32): Def {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result == v) {
        return Def { found: true, ins: ins };
      }
    }
  }
  return Def { found: false, ins: ssa.SInst { kind_tag: 0, result: 0, args: [], imm: 0, str: "" } };
}

function contains(xs: i32[], x: i32): boolean {
  for v in xs {
    if (v == x) {
      return true;
    }
  }
  return false;
}

function f64_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFloat(x) = t {
    return x.width == 64;
  }
  return false;
}

function uncopy(f: ssasem.Func, v: i32, seen: i32[]): i32 {
  if (contains(seen, v)) {
    return 0 - 1;
  }
  let d: Def = definition(f, v);
  if (d.found && d.ins.kind_tag == 7 && d.ins.args.len() == 1) {
    return uncopy(f, d.ins.args[0], seen.append(v));
  }
  return v;
}

// One multiply of the element and a literal. No calls, captures, branches,
// conversions or additional arithmetic can be discarded by this proof.
function factor(f: ssasem.Func): Factor {
  let no: Factor = no_factor(semarrayreport.kernel_element_not_literal_scale());
  // A closure wrapper has its environment first and its element second.
  // The caller has proved that the closure captures nothing, and below no
  // instruction is allowed to read fields out of that environment.
  if (!factor_signature(f)) {
    return no;
  }
  let b: ssa.SBlock = f.graph.blocks[0];
  if (b.term.kind_tag != 1) {
    return no;
  }
  let result: i32 = uncopy(f, b.term.value, []);
  let mul: Def = definition(f, result);
  if (!is_multiply(mul) || !factor_body(b, result)) {
    return no;
  }
  return literal_factor(f, mul.ins);
}

function factor_signature(f: ssasem.Func): boolean {
  let element: i32 = f.params.len() - 1;
  return element >= 0 && element <= 1 && f64_type(f.params[element]) && f64_type(f.result) && f.graph.blocks.len() == 1;
}

function is_multiply(d: Def): boolean {
  return d.found && d.ins.kind_tag == 9 && d.ins.str == "*" && d.ins.args.len() == 2;
}

function factor_body(b: ssa.SBlock, result: i32): boolean {
  for ins in b.insts {
    if (ins.kind_tag != 1 && ins.kind_tag != 6 && ins.kind_tag != 7 && ins.result != result) {
      return false;
    }
  }
  return true;
}

function literal_factor(f: ssasem.Func, mul: ssa.SInst): Factor {
  let no: Factor = no_factor(semarrayreport.kernel_element_not_literal_scale());
  let left: Def = definition(f, uncopy(f, mul.args[0], []));
  let right: Def = definition(f, uncopy(f, mul.args[1], []));
  if (!left.found || !right.found) {
    return no;
  }
  if (left.ins.kind_tag == 6 && left.ins.imm == f.params.len() - 1 && right.ins.kind_tag == 1 && f64_type(f.values[right.ins.result])) {
    return Factor { ok: true, literal: right.ins.str, reason: semarrayreport.kernel_scale_kernel() };
  }
  // Preserve the source's operand order, including NaN payload selection.
  return no;
}

// Exactly the two element parameters, in source order. In particular, y*x
// cannot substitute for x*y when the two operands have different NaN payloads.
function binary_element(f: ssasem.Func, add: boolean): Factor {
  let refusal: i32 = semarrayreport.kernel_element_not_binary_multiply();
  let op: string = "*";
  if (add) {
    refusal = semarrayreport.kernel_element_not_binary_add();
    op = "+";
  }
  let no: Factor = no_factor(refusal);
  if (!binary_signature(f)) {
    return no;
  }
  let b: ssa.SBlock = f.graph.blocks[0];
  if (b.term.kind_tag != 1) {
    return no;
  }
  let result: i32 = uncopy(f, b.term.value, []);
  let mul: Def = definition(f, result);
  if (!mul.found || mul.ins.kind_tag != 9 || mul.ins.str != op || mul.ins.args.len() != 2 || !factor_body(b, result)) {
    return no;
  }
  let left: Def = definition(f, uncopy(f, mul.ins.args[0], []));
  let right: Def = definition(f, uncopy(f, mul.ins.args[1], []));
  if (!element_param(left, f.params.len() - 2) || !element_param(right, f.params.len() - 1)) {
    return no;
  }
  return Factor { ok: true, literal: "", reason: semarrayreport.kernel_outer_mul_kernel() };
}

function binary_signature(f: ssasem.Func): boolean {
  let first: i32 = f.params.len() - 2;
  return first >= 0 && first <= 1 && f64_type(f.params[first]) && f64_type(f.params[first + 1])
    && f64_type(f.result) && f.graph.blocks.len() == 1;
}

function element_param(d: Def, index: i32): boolean {
  return d.found && d.ins.kind_tag == ssasem.param() && d.ins.imm == index;
}

function closure_factor(f: ssasem.Func, v: i32, funcs: ssasem.Func[], index: util.NameIndex, usable: boolean[], binary: boolean, add: boolean): Factor {
  let d: Def = definition(f, uncopy(f, v, []));
  if (d.found && d.ins.kind_tag == ssasem.closure_new()) {
    if (d.ins.args.len() != 0) {
      return no_factor(semarrayreport.kernel_element_fn_captures());
    }
    let at: i32 = index.find(d.ins.str);
    if (at >= 0 && usable[at]) {
      if (binary) {
        return binary_element(funcs[at], add);
      }
      return factor(funcs[at]);
    }
  }
  return no_factor(semarrayreport.kernel_element_fn_unresolved());
}

function kernel_contract(): ssasem.Contract {
  let t: typeinfo.Type = typeinfo.TypeFloat { width: 64, polymorphic: false };
  let a: typeinfo.Type = typeinfo.TypeArray { elem: t, view: false };
  return ssasem.Contract { name: "__scale_f64", params: [a, t], modes: [ssasem.borrow_mode(), ssasem.value_mode()], result: a };
}

function from_flat_contract(funcs: ssasem.Func[], index: util.NameIndex, trusted: util.NameIndex, usable: boolean[], t: typeinfo.Type): i32 {
  let at: i32 = index.find("ndarray__from_flat__f64");
  if (at < 0 || !trusted.has("ndarray__from_flat__f64") || !usable[at] || !semtypes.equal(funcs[at].result, t)) {
    return 0 - 1;
  }
  return at;
}

pub function has_kernel(names: string[]): boolean {
  for name in names {
    if (kernel_name(name)) {
      return true;
    }
  }
  return false;
}

function kernel_name(name: string): boolean {
  return name == "__smm_ndarray__NdArray_map__f64__f64"
    || name == "__smm_ndarray__NdArray_outer__f64__f64__f64"
    || name == "__smm_ndarray__NdArray_inner__f64__f64";
}

pub function scale_maps(funcs: ssasem.Func[], names: string[], usable: boolean[], open: boolean[], stdlib: string[], enabled: boolean, products: boolean, report: boolean): Scaled {
  let index: util.NameIndex = util.name_index(names);
  let rewritten: boolean[] = [];
  for f in funcs {
    rewritten = rewritten.append(false);
  }
  if (!report && !has_kernel(names)) {
    return Scaled { funcs: funcs, rewritten: rewritten, sites: [] };
  }
  let trusted: util.NameIndex = util.name_index(stdlib);
  let layouts: semndlayout.Facts = semndlayout.analyze(funcs, names, usable, open, trusted);
  let out: ssasem.Func[] = [];
  let sites: semarrayreport.Site[] = [];
  rewritten = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let f: ssasem.Func = funcs[i];
    if (!usable[i] || !has_operation(f, report)) {
      out = out.append(f);
      rewritten = rewritten.append(false);
      i = i + 1;
      continue;
    }
    let result: Rewritten = scale_function(f, funcs, names, index, trusted, usable, layouts.values[i], enabled, products, report);
    out = out.append(result.func);
    rewritten = rewritten.append(result.changed);
    sites = util.append_all(sites, result.sites);
    i = i + 1;
  }
  return Scaled { funcs: out, rewritten: rewritten, sites: sites };
}

struct Rewritten { func: ssasem.Func, changed: boolean, sites: semarrayreport.Site[] }

struct Plan { factor: Factor, ctor: i32, join: i32, check: i32, adapter: i32, reason: i32 }

function no_plan(reason: i32): Plan {
  return Plan { factor: no_factor(reason), ctor: 0 - 1, join: 0 - 1, check: 0 - 1, adapter: 0 - 1, reason: reason };
}

function site_refusal(f: ssasem.Func, ins: ssa.SInst, layouts: i32[]): i32 {
  if (ins.kind_tag != ssasem.call() || semndlayout.operation(ins.str) != "map") {
    return semarrayreport.kernel_unsupported_operation();
  }
  if (ins.args.len() != 2 || ins.str != "__smm_ndarray__NdArray_map__f64__f64") {
    return semarrayreport.kernel_unsupported_element_type();
  }
  if (util.has_str(f.shadows, "__scale_f64")) {
    return semarrayreport.kernel_builtin_shadowed();
  }
  let layout: i32 = layouts[ins.args[0]];
  if (layout != semndlayout.packed()) {
    return layout_refusal(layout);
  }
  return semarrayreport.kernel_scale_kernel();
}

function layout_refusal(layout: i32): i32 {
  if (layout == semndlayout.unknown()) {
    return semarrayreport.kernel_layout_unknown();
  }
  if (layout == semndlayout.strided()) {
    return semarrayreport.kernel_layout_strided();
  }
  return semarrayreport.kernel_layout_row_major();
}

function scale_plan(f: ssasem.Func, ins: ssa.SInst, funcs: ssasem.Func[], index: util.NameIndex, trusted: util.NameIndex, usable: boolean[], layouts: i32[], enabled: boolean): Plan {
  let why: i32 = site_refusal(f, ins, layouts);
  if (why != semarrayreport.kernel_scale_kernel()) {
    return no_plan(why);
  }
  let k: Factor = closure_factor(f, ins.args[1], funcs, index, usable, false, false);
  if (!k.ok) {
    return no_plan(k.reason);
  }
  let ctor: i32 = from_flat_contract(funcs, index, trusted, usable, f.values[ins.result]);
  if (ctor < 0) {
    return no_plan(semarrayreport.kernel_constructor_unavailable());
  }
  if (!enabled) {
    return no_plan(semarrayreport.kernel_disabled());
  }
  return Plan { factor: k, ctor: ctor, join: 0 - 1, check: 0 - 1, adapter: 0 - 1, reason: semarrayreport.kernel_scale_kernel() };
}

function outer_refusal(f: ssasem.Func, ins: ssa.SInst, layouts: i32[]): i32 {
  if (ins.args.len() != 3 || ins.str != "__smm_ndarray__NdArray_outer__f64__f64__f64") {
    return semarrayreport.kernel_unsupported_element_type();
  }
  if (util.has_str(f.shadows, "__outer_mul_f64")) {
    return semarrayreport.kernel_builtin_shadowed();
  }
  for value in [ins.args[0], ins.args[1]] {
    if (layouts[value] != semndlayout.packed()) {
      return layout_refusal(layouts[value]);
    }
  }
  return semarrayreport.kernel_outer_mul_kernel();
}

function metadata_helper(funcs: ssasem.Func[], index: util.NameIndex, trusted: util.NameIndex, usable: boolean[], name: string, params: typeinfo.Type[], result: typeinfo.Type): i32 {
  let at: i32 = index.find(name);
  if (at < 0 || !trusted.has(name) || !usable[at]) {
    return 0 - 1;
  }
  let f: ssasem.Func = funcs[at];
  if (f.params.len() != params.len() || !semtypes.equal(f.result, result)) {
    return 0 - 1;
  }
  let i: i32 = 0;
  while (i < params.len()) {
    if (!semtypes.equal(f.params[i], params[i])) {
      return 0 - 1;
    }
    i = i + 1;
  }
  return at;
}

function outer_plan(f: ssasem.Func, ins: ssa.SInst, funcs: ssasem.Func[], index: util.NameIndex, trusted: util.NameIndex, usable: boolean[], layouts: i32[], enabled: boolean): Plan {
  let why: i32 = outer_refusal(f, ins, layouts);
  if (why != semarrayreport.kernel_outer_mul_kernel()) {
    return no_plan(why);
  }
  let k: Factor = closure_factor(f, ins.args[2], funcs, index, usable, true, false);
  if (!k.ok) {
    return no_plan(k.reason);
  }
  let ctor: i32 = from_flat_contract(funcs, index, trusted, usable, f.values[ins.result]);
  let dims: typeinfo.Type = shape_type();
  let join: i32 = metadata_helper(funcs, index, trusted, usable, "ndarray__join", [dims, dims], dims);
  let check: i32 = metadata_helper(funcs, index, trusted, usable, "ndarray__check_shape", [dims], typeinfo.TypeVoid { tag: 0 });
  if (ctor < 0 || join < 0 || check < 0) {
    return no_plan(semarrayreport.kernel_constructor_unavailable());
  }
  if (!enabled) {
    return no_plan(semarrayreport.kernel_disabled());
  }
  return Plan { factor: k, ctor: ctor, join: join, check: check, adapter: 0 - 1, reason: semarrayreport.kernel_outer_mul_kernel() };
}

function inner_refusal(f: ssasem.Func, ins: ssa.SInst, layouts: i32[]): i32 {
  if (ins.args.len() != 5 || ins.str != "__smm_ndarray__NdArray_inner__f64__f64") {
    return semarrayreport.kernel_unsupported_element_type();
  }
  if (util.has_str(f.shadows, "__inner_mul_add_f64")) {
    return semarrayreport.kernel_builtin_shadowed();
  }
  for value in [ins.args[0], ins.args[1]] {
    if (layouts[value] != semndlayout.packed()) {
      return layout_refusal(layouts[value]);
    }
  }
  return semarrayreport.kernel_inner_mul_add_kernel();
}

function inner_plan(f: ssasem.Func, ins: ssa.SInst, funcs: ssasem.Func[], index: util.NameIndex, trusted: util.NameIndex, usable: boolean[], layouts: i32[], enabled: boolean): Plan {
  let why: i32 = inner_refusal(f, ins, layouts);
  if (why != semarrayreport.kernel_inner_mul_add_kernel()) {
    return no_plan(why);
  }
  for at in [3, 4] {
    let k: Factor = closure_factor(f, ins.args[at], funcs, index, usable, true, at == 4);
    if (!k.ok) {
      return no_plan(k.reason);
    }
  }
  let adapter: i32 = metadata_helper(funcs, index, trusted, usable, "ndarray__inner_kernel", [f.values[ins.args[0]], f.values[ins.args[1]], f.values[ins.args[2]]], f.values[ins.result]);
  if (adapter < 0) {
    return no_plan(semarrayreport.kernel_constructor_unavailable());
  }
  if (!enabled) {
    return no_plan(semarrayreport.kernel_disabled());
  }
  return Plan { ...no_plan(semarrayreport.kernel_inner_mul_add_kernel()), adapter: adapter };
}

function site_plan(f: ssasem.Func, ins: ssa.SInst, funcs: ssasem.Func[], index: util.NameIndex, trusted: util.NameIndex, usable: boolean[], layouts: i32[], enabled: boolean, products: boolean): Plan {
  if (ins.kind_tag != ssasem.call() || !trusted.has(ins.str)) {
    return no_plan(semarrayreport.kernel_unsupported_operation());
  }
  if (semndlayout.operation(ins.str) == "outer") {
    return outer_plan(f, ins, funcs, index, trusted, usable, layouts, products);
  }
  if (semndlayout.operation(ins.str) == "inner") {
    return inner_plan(f, ins, funcs, index, trusted, usable, layouts, products);
  }
  return scale_plan(f, ins, funcs, index, trusted, usable, layouts, enabled);
}

function shape_type(): typeinfo.Type {
  return typeinfo.TypeArray { elem: typeinfo.TypeI32 { is_char: false, width: 32, unsigned: false, polymorphic: false }, view: false };
}

struct Emitted { values: typeinfo.Type[], insts: ssa.SInst[], calls: ssasem.Contract[] }

function helper_contract(f: ssasem.Func): ssasem.Contract {
  let modes: i32[] = [];
  for p in f.params {
    if (ssasem.reference(p)) {
      modes = modes.append(ssasem.borrow_mode());
    } else {
      modes = modes.append(ssasem.value_mode());
    }
  }
  return ssasem.Contract { name: f.graph.name, params: f.params, modes: modes, result: f.result };
}

function outer_instructions(ins: ssa.SInst, plan: Plan, funcs: ssasem.Func[], values: typeinfo.Type[], insts: ssa.SInst[], calls: ssasem.Contract[]): Emitted {
  let n: i32 = values.len();
  let data: typeinfo.Type = kernel_contract().result;
  let dims: typeinfo.Type = shape_type();
  let contract: ssasem.Contract = ssasem.Contract { name: "__outer_mul_f64", params: [data, data], modes: [ssasem.borrow_mode(), ssasem.borrow_mode()], result: data };
  values = values.append(data).append(data).append(dims).append(dims).append(dims).append(typeinfo.TypeVoid { tag: 0 }).append(data);
  insts = insts.append(ssa.SInst { kind_tag: ssasem.record_get(), result: n, args: [ins.args[0]], imm: 0, str: "data" });
  insts = insts.append(ssa.SInst { kind_tag: ssasem.record_get(), result: n + 1, args: [ins.args[1]], imm: 0, str: "data" });
  insts = insts.append(ssa.SInst { kind_tag: ssasem.record_get(), result: n + 2, args: [ins.args[0]], imm: 1, str: "shape" });
  insts = insts.append(ssa.SInst { kind_tag: ssasem.record_get(), result: n + 3, args: [ins.args[1]], imm: 1, str: "shape" });
  insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: n + 4, args: [n + 2, n + 3], imm: 0, str: funcs[plan.join].graph.name });
  // Keep prefix-overflow checks before allocation even when a later axis is
  // zero. Multiplying the flat lengths alone would incorrectly admit it.
  insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: n + 5, args: [n + 4], imm: 0, str: funcs[plan.check].graph.name });
  insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: n + 6, args: [n, n + 1], imm: 0, str: contract.name });
  insts = insts.append(ssa.SInst { ...ins, str: funcs[plan.ctor].graph.name, args: [n + 6, n + 4] });
  for c in [contract, helper_contract(funcs[plan.join]), helper_contract(funcs[plan.check]), helper_contract(funcs[plan.ctor])] {
    if (ssasem.find_contract_in(calls, c.name) < 0) {
      calls = calls.append(c);
    }
  }
  return Emitted { values: values, insts: insts, calls: calls };
}

function scale_instructions(ins: ssa.SInst, plan: Plan, funcs: ssasem.Func[], values: typeinfo.Type[], insts: ssa.SInst[], calls: ssasem.Contract[]): Emitted {
  let contract: ssasem.Contract = kernel_contract();
  let ctor: ssasem.Contract = helper_contract(funcs[plan.ctor]);
  let n: i32 = values.len();
  values = values.append(contract.params[0]).append(shape_type()).append(contract.params[1]).append(contract.result);
  insts = insts.append(ssa.SInst { kind_tag: ssasem.record_get(), result: n, args: [ins.args[0]], imm: 0, str: "data" });
  insts = insts.append(ssa.SInst { kind_tag: ssasem.record_get(), result: n + 1, args: [ins.args[0]], imm: 1, str: "shape" });
  insts = insts.append(ssa.SInst { kind_tag: 1, result: n + 2, args: [], imm: 0, str: plan.factor.literal });
  insts = insts.append(ssa.SInst { kind_tag: ssasem.call(), result: n + 3, args: [n, n + 2], imm: 0, str: contract.name });
  insts = insts.append(ssa.SInst { ...ins, str: ctor.name, args: [n + 3, n + 1] });
  for c in [contract, ctor] {
    if (ssasem.find_contract_in(calls, c.name) < 0) {
      calls = calls.append(c);
    }
  }
  return Emitted { values: values, insts: insts, calls: calls };
}

function scale_function(f: ssasem.Func, funcs: ssasem.Func[], names: string[], index: util.NameIndex, trusted: util.NameIndex, usable: boolean[], layouts: i32[], enabled: boolean, products: boolean, report: boolean): Rewritten {
  let values: typeinfo.Type[] = f.values;
  let blocks: ssa.SBlock[] = [];
  let changed: boolean = false;
  let calls: ssasem.Contract[] = f.calls;
  let sites: semarrayreport.Site[] = [];
  for b in f.graph.blocks {
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      let plan: Plan = site_plan(f, ins, funcs, index, trusted, usable, layouts, enabled, products);
      if (report && ins.kind_tag == ssasem.call() && trusted.has(ins.str) && algebra(ins.str)) {
        sites = sites.append(kernel_site(f, ins, layouts, plan));
      }
      if (plan.reason == semarrayreport.kernel_inner_mul_add_kernel()) {
        let contract: ssasem.Contract = helper_contract(funcs[plan.adapter]);
        insts = insts.append(ssa.SInst { ...ins, str: contract.name, args: [ins.args[0], ins.args[1], ins.args[2]] });
        if (ssasem.find_contract_in(calls, contract.name) < 0) {
          calls = calls.append(contract);
        }
        changed = true;
      } else if (plan.reason == semarrayreport.kernel_outer_mul_kernel()) {
        let emitted: Emitted = outer_instructions(ins, plan, funcs, values, insts, calls);
        values = emitted.values;
        insts = emitted.insts;
        calls = emitted.calls;
        changed = true;
      } else if (plan.reason == semarrayreport.kernel_scale_kernel()) {
        let emitted: Emitted = scale_instructions(ins, plan, funcs, values, insts, calls);
        values = emitted.values;
        insts = emitted.insts;
        calls = emitted.calls;
        changed = true;
      } else {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts });
  }
  return Rewritten { func: ssasem.Func { ...f, values: values, calls: calls, graph: ssa.SFunc { ...f.graph, nvals: values.len(), blocks: blocks } }, changed: changed, sites: sites };
}

function has_operation(f: ssasem.Func, report: boolean): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call() && (kernel_name(ins.str) || report && algebra(ins.str))) {
        return true;
      }
    }
  }
  return false;
}

function algebra(name: string): boolean {
  return util.has_str(["map", "zip_with", "outer", "inner", "fold_all", "reduce_axis", "scan_axis", "map_rank"], semndlayout.operation(name));
}

pub function any_operation(names: string[]): boolean {
  for name in names {
    if (algebra(name)) {
      return true;
    }
  }
  return false;
}

function layout_name(layout: i32): string {
  if (layout == semndlayout.packed()) {
    return "packed";
  }
  if (layout == semndlayout.row_major()) {
    return "row-major";
  }
  if (layout == semndlayout.strided()) {
    return "strided";
  }
  return "unknown";
}

function element_name(f: ssasem.Func, value: i32): string {
  let d: Def = definition(f, uncopy(f, value, []));
  if (d.found && d.ins.kind_tag == ssasem.closure_new()) {
    return d.ins.str;
  }
  return "unresolved@v" + util.i32_to_string(value);
}

function axis_text(f: ssasem.Func, value: i32): string {
  let d: Def = definition(f, uncopy(f, value, []));
  if (d.found && d.ins.kind_tag == 1) {
    return util.i32_to_string(d.ins.imm);
  }
  return "?";
}

function operation_text(f: ssasem.Func, ins: ssa.SInst, layouts: i32[]): string {
  let op: string = semndlayout.operation(ins.str);
  let out: string = op + "; layout=" + layout_name(layouts[ins.args[0]]);
  if (op == "zip_with" || op == "outer" || op == "inner") {
    out = out + "; rhs-layout=" + layout_name(layouts[ins.args[1]]);
  }
  if (op == "reduce_axis" || op == "scan_axis") {
    out = out + "; axis=" + axis_text(f, ins.args[1]);
  }
  if (op == "map_rank") {
    out = out + "; rank=" + axis_text(f, ins.args[1]);
  }
  if (op == "inner") {
    out = out + "; multiply=" + element_name(f, ins.args[ins.args.len() - 2]);
  }
  return out + "; element=" + element_name(f, ins.args[ins.args.len() - 1]);
}

function kernel_site(f: ssasem.Func, ins: ssa.SInst, layouts: i32[], plan: Plan): semarrayreport.Site {
  let storage: string = "scalar-combinator";
  if (plan.reason == semarrayreport.kernel_scale_kernel()) {
    storage = "deferred-to-ownership";
  } else if (plan.reason == semarrayreport.kernel_outer_mul_kernel() || plan.reason == semarrayreport.kernel_inner_mul_add_kernel()) {
    storage = "fresh-kernel-buffer";
  }
  return semarrayreport.Site { owner: f.graph.name, stage: ins.str + "@v" + util.i32_to_string(ins.result), plan: operation_text(f, ins, layouts), reason: plan.reason, storage: storage };
}
