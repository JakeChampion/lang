// Machine state and control flow for the small and large array release proofs.
import "./ssacondition" as condition;
import "./ssacapacityisa" as isa;
import "./ssaaffinevalue" as affine;
import "./ssaaffinehalf" as half;
pub use "./ssaaffinehalf".{Half, token, same_half};

pub struct Word { low: half.Half, high: half.Half }

pub struct State { regs: Word[], cells: half.Half[], flags: condition.Flags, ok: boolean, zeros: i32, links: i32, slots: i32, call_return: i32 }

pub function identity(kind: i32, id: i32): Word {
  return Word { low: half.token(kind, id, 0), high: half.token(kind, id, 1) };
}

pub function numeric_half(v: affine.Value): half.Half {
  return half.Half { kind: 1, identity: 0, part: 0, number: v };
}

pub function same_word(a: Word, b: Word): boolean {
  return half.same_half(a.low, b.low) && half.same_half(a.high, b.high);
}

pub function write(s: State, reg: i32, w: Word): State {
  return State { ...s, regs: s.regs.with(reg, w), ok: s.ok && w.low.kind != 0 && w.high.kind != 0 };
}

pub function pointer(w: Word, kind: i32): boolean {
  return w.low.kind == kind && same_word(w, identity(kind, w.low.identity));
}

pub function extent(at: i64, low: i32, high: i32, width: i32): boolean {
  return (width == 32 || width == 64) && at >= low as i64 && at + (width / 8) as i64 <= high as i64 && at % (4 as i64) == 0;
}

pub function put(s: State, at: i32, width: i32, w: Word): State {
  let cells = s.cells.with(at, w.low);
  if (width == 64) {
    cells = cells.with(at + 1, w.high);
  }
  return State { ...s, cells: cells };
}

function in_program(p: isa.ArrayProgram, pc: i32): boolean {
  return pc >= 0 && pc < p.ops.len();
}

pub struct Instructions {
  movement: (State, affine.Interval, isa.Op) => State,
  arithmetic: (State, affine.Interval, isa.Op) => State,
  lea: (State, affine.Interval, isa.Op) => State,
  number: (affine.Interval, Word, i32) => affine.Value,
  nonnegative: (affine.Interval, affine.Value) => boolean,
  compare: (affine.Interval, affine.Value, i64) => condition.Comparison,
  extended: (State, affine.Interval, i32, isa.Op) => State,
}

function comparison(s: State, r: affine.Interval, op: isa.Op, ops: Instructions): State {
  let w = s.regs[op.source];
  if (op.width == 64 && same_word(w, identity(6, 0)) && op.immediate == 65536) {
    let f = condition.Comparison { less: 0, equal: -1, less_equal: -1 };
    return State { ...s, flags: condition.Flags { order: f, signed: condition.unknown_order(), sign: 0 } };
  }
  let v = ops.number(r, w, op.width);
  if (!ops.nonnegative(r, v) || op.immediate < 0) {
    return State { ...s, flags: condition.unknown_flags() };
  }
  let order = ops.compare(r, v, op.immediate as i64);
  let high = v.factor as i64 * (r.high as i64) + v.offset;
  let signed = if (high <= 2147483647 as i64) { order } else { condition.unknown_order() };
  return State { ...s, flags: condition.Flags { order: order, signed: signed, sign: signed.less } };
}

function test(s: State, r: affine.Interval, op: isa.Op, ops: Instructions): State {
  let v = ops.number(r, s.regs[op.source], 32);
  if (!ops.nonnegative(r, v) || v.factor as i64 * (r.high as i64) + v.offset > 2147483647 as i64) {
    return State { ...s, flags: condition.unknown_flags() };
  }
  let cmp = ops.compare(r, v, 0 as i64);
  return State { ...s, flags: condition.Flags { order: condition.Comparison { less: 0, equal: cmp.equal, less_equal: cmp.equal }, signed: cmp, sign: 0 } };
}

pub function final_registers(s: State, r: affine.Interval, expected_register: (affine.Interval, i32) => Word): boolean {
  for i in 0..16 {
    if (!same_word(s.regs[i], expected_register(r, i))) {
      return false;
    }
  }
  return true;
}

function unguarded(s: State, original: State, r: affine.Interval, expected_register: (affine.Interval, i32) => Word): State {
  let regs = s.regs;
  let i = 0;
  while (i < regs.len()) {
    if (!same_word(regs[i], original.regs[i])) {
      if (i == 0 || same_word(expected_register(r, i), identity(2, i))) {
        return State { ...s, ok: false };
      }
      regs = regs.with(i, original.regs[i]);
    }
    i += 1;
  }
  for i in 0..s.cells.len() {
    if (!half.same_half(s.cells[i], original.cells[i])) {
      return State { ...s, ok: false };
    }
  }
  return State { ...s, regs: regs, flags: condition.unknown_flags(), ok: s.ok && s.zeros == 0 && s.links == 0 && s.slots == 0 && s.call_return == -1 };
}

function step(s: State, r: affine.Interval, pc: i32, op: isa.Op, ops: Instructions): State {
  if (op.kind == 1) {
    return s;
  }
  if (op.kind >= 2 && op.kind <= 7) {
    return ops.movement(s, r, op);
  }
  if (op.kind == 9 || op.kind == 10) {
    return ops.arithmetic(s, r, op);
  }
  if (op.kind == 15) {
    return ops.lea(s, r, op);
  }
  if (op.kind == 16) {
    return comparison(s, r, op, ops);
  }
  if (op.kind == 23) {
    return test(s, r, op, ops);
  }
  return ops.extended(s, r, pc, op);
}

pub function path(p: isa.ArrayProgram, r: affine.Interval, register_entry: boolean, s: State, ops: Instructions, expected_register: (affine.Interval, i32) => Word, finished: (State, affine.Interval, boolean) => boolean): boolean {
  let original = s;
  let visited: boolean[] = [];
  for op in p.ops {
    visited = visited.append(false);
  }
  let pc = if (register_entry) { p.register_entry } else { 0 };
  while (in_program(p, pc)) {
    if (visited[pc]) {
      return false;
    }
    visited = visited.with(pc, true);
    if (register_entry && pc == p.unguarded_entry) {
      s = unguarded(s, original, r, expected_register);
    }
    let op = p.ops[pc];
    if (op.kind == 18) {
      return s.ok && (!register_entry || visited[p.unguarded_entry]) && finished(s, r, register_entry);
    }
    if (op.kind == 17) {
      let taken = condition.branch(s.flags, op.condition);
      if (taken < 0) {
        return false;
      }
      pc = if (taken == 1) { op.target } else { pc + 1 };
    } else {
      s = step(s, r, pc, op, ops);
      if (!s.ok) {
        return false;
      }
      pc += 1;
    }
  }
  return false;
}
