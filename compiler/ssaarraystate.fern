// Instruction dispatch and control flow for the small and large array release proofs.
import "./ssareleasestate" as shared;
pub use "./ssareleasestate".{Word, State, initial, identity, numeric_half, same_word, write, pointer, extent, put};
import "./ssacondition" as condition;
import "./ssacapacityisa" as isa;
import "./ssaaffinevalue" as affine;
import "./ssaaffinehalf" as half;
pub use "./ssaaffinehalf".{Half, token, same_half};

function in_program(p: isa.ArrayProgram, pc: i32): boolean {
  return pc >= 0 && pc < p.ops.len();
}

pub struct Instructions {
  movement: (shared.State, affine.Interval, isa.Op) => shared.State,
  arithmetic: (shared.State, affine.Interval, isa.Op) => shared.State,
  lea: (shared.State, affine.Interval, isa.Op) => shared.State,
  number: (affine.Interval, shared.Word, i32) => affine.Value,
  nonnegative: (affine.Interval, affine.Value) => boolean,
  compare: (affine.Interval, affine.Value, i64) => condition.Comparison,
  extended: (shared.State, affine.Interval, i32, isa.Op) => shared.State,
}

function comparison(s: shared.State, r: affine.Interval, op: isa.Op, ops: Instructions): shared.State {
  let w = s.regs[op.source];
  if (op.width == 64 && shared.same_word(w, shared.identity(6, 0)) && op.immediate == 65536) {
    let f = condition.Comparison { less: 0, equal: -1, less_equal: -1 };
    return shared.State { ...s, flags: condition.Flags { order: f, signed: condition.unknown_order(), sign: 0 } };
  }
  let v = ops.number(r, w, op.width);
  if (!ops.nonnegative(r, v) || op.immediate < 0) {
    return shared.State { ...s, flags: condition.unknown_flags() };
  }
  let order = ops.compare(r, v, op.immediate as i64);
  let high = v.factor as i64 * (r.high as i64) + v.offset;
  let signed = if (high <= 2147483647 as i64) { order } else { condition.unknown_order() };
  return shared.State { ...s, flags: condition.Flags { order: order, signed: signed, sign: signed.less } };
}

function test(s: shared.State, r: affine.Interval, op: isa.Op, ops: Instructions): shared.State {
  let v = ops.number(r, s.regs[op.source], 32);
  if (!ops.nonnegative(r, v) || v.factor as i64 * (r.high as i64) + v.offset > 2147483647 as i64) {
    return shared.State { ...s, flags: condition.unknown_flags() };
  }
  let cmp = ops.compare(r, v, 0 as i64);
  return shared.State { ...s, flags: condition.Flags { order: condition.Comparison { less: 0, equal: cmp.equal, less_equal: cmp.equal }, signed: cmp, sign: 0 } };
}

pub function final_registers(s: shared.State, r: affine.Interval, expected_register: (affine.Interval, i32) => shared.Word): boolean {
  for i in 0..16 {
    if (!shared.same_word(s.regs[i], expected_register(r, i))) {
      return false;
    }
  }
  return true;
}

function unguarded(s: shared.State, original: shared.State, r: affine.Interval, expected_register: (affine.Interval, i32) => shared.Word): shared.State {
  let regs = s.regs;
  let i = 0;
  while (i < regs.len()) {
    if (!shared.same_word(regs[i], original.regs[i])) {
      if (i == 0 || shared.same_word(expected_register(r, i), shared.identity(2, i))) {
        return shared.State { ...s, ok: false };
      }
      regs = regs.with(i, original.regs[i]);
    }
    i += 1;
  }
  for i in 0..s.cells.len() {
    if (!half.same_half(s.cells[i], original.cells[i])) {
      return shared.State { ...s, ok: false };
    }
  }
  return shared.State { ...s, regs: regs, flags: condition.unknown_flags(), ok: s.ok && s.zeros == 0 && s.links == 0 && s.slots == 0 && s.call_return == -1 };
}

function step(s: shared.State, r: affine.Interval, pc: i32, op: isa.Op, ops: Instructions): shared.State {
  if (op.kind == 1) {
    return s;
  }
  if (op.kind >= 2 && op.kind <= 7) {
    return ops.movement(s, r, op);
  }
  if (op.kind == 9 || op.kind == 10) {
    return ops.arithmetic(s, r, op);
  }
  if (op.kind == 15) {
    return ops.lea(s, r, op);
  }
  if (op.kind == 16) {
    return comparison(s, r, op, ops);
  }
  if (op.kind == 23) {
    return test(s, r, op, ops);
  }
  return ops.extended(s, r, pc, op);
}

pub function path(p: isa.ArrayProgram, r: affine.Interval, register_entry: boolean, s: shared.State, ops: Instructions, expected_register: (affine.Interval, i32) => shared.Word, finished: (shared.State, affine.Interval, boolean) => boolean): boolean {
  let original = s;
  let visited: boolean[] = [];
  for op in p.ops {
    visited = visited.append(false);
  }
  let pc = if (register_entry) { p.register_entry } else { 0 };
  while (in_program(p, pc)) {
    if (visited[pc]) {
      return false;
    }
    visited = visited.with(pc, true);
    if (register_entry && pc == p.unguarded_entry) {
      s = unguarded(s, original, r, expected_register);
    }
    let op = p.ops[pc];
    if (op.kind == 18) {
      return s.ok && (!register_entry || visited[p.unguarded_entry]) && finished(s, r, register_entry);
    }
    if (op.kind == 17) {
      let taken = condition.branch(s.flags, op.condition);
      if (taken < 0) {
        return false;
      }
      pc = if (taken == 1) { op.target } else { pc + 1 };
    } else {
      s = step(s, r, pc, op, ops);
      if (!s.ok) {
        return false;
      }
      pc += 1;
    }
  }
  return false;
}
