import "./util";
import "./rtbytecopy";

pub struct Op {
  kind_tag: i32,
  i32_imm: i32,
  i64_imm: i64,
  f64_imm: f64,
  width: i32,
  unsigned: boolean,
  str: string,
  decl: i32,
  source: i64,
}

pub function width_ptr(): i32 {
  return -1;
}

function op0(tag: i32): Op {
  return Op { source: 0, decl: -1, kind_tag: tag, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

pub function op_const_i32(v: i32): Op {
  return Op { source: 0, decl: -1, kind_tag: 1, i32_imm: v, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

