// A str_len or str_data read of a byte view's string arm. On wasm that
// operand may be a frame window ({data, len}, tagged 1) rather than a string,
// so the read must tell them apart; the native backends ignore the mark.
pub function view_string(o: Op): Op {
  return Op { ...o, i32_imm: 1 };
}

pub function is_view_string(o: Op): boolean {
  return (o.kind_tag == K_STR_LEN || o.kind_tag == K_STR_DATA) && o.i32_imm == 1;
}

