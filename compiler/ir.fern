}

// `sig` is the width tag the wasm backend types the call with, and `cfi` is
// the signature word a hardened native call compares with the callee's stub
// (`cfi_sig_hash`). A raw call carries neither.
pub function op_call_indirect_sig(argc: i32, sig: string, cfi: i32): Op {
  return Op { source: 0, decl: -1, kind_tag: 150, i32_imm: argc, i64_imm: cfi as i64, f64_imm: 0.0, width: 0, unsigned: false, str: sig };
}

// The 32-bit FNV-1a hash of a function's full width tag, the word a hardened
// stub carries ahead of its landing pad. It is never 0, which marks a raw
// call, and never a landing pad or the compare the BTI control patches.
pub function cfi_sig_hash(tag: string): i32 {
  let h: i32 = -2128831035;
  for i in 0..tag.len() {
    h = (h ^ tag[i] as i32) * 16777619;
  }
  if (h == 0) {
    return 1;
  }
  if (h == -721214369 || h == -98693133 || h == 1796276767 || h == 1796211231) {
    return h ^ 1;
  }
  return h;
}

