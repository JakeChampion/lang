  return Op { source: 0, decl: -1, kind_tag: 2, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: t };
}

pub function op_const_ptr_text(t: string): Op {
  return Op { source: 0, decl: -1, kind_tag: 2, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width_ptr(), unsigned: true, str: t };
}

