pub function op_dyn_dispatch(arms: string[], base_slot: i32, argc: i32): Op {
  let tag = "";
  let i = 0;
  while (i < arms.len()) {
    if (i > 0) {
      tag += ",";
    }
    tag += arms[i];
    i += 1;
  }
  return Op { source: 0, decl: -1, kind_tag: 147, i32_imm: base_slot, i64_imm: 0, f64_imm: 0.0, width: argc, unsigned: false, str: tag };
}

pub function dyn_dispatch_arms(tag: string): string[] {
  let out: string[] = [];
  let start = 0;
  let k = 0;
  while (k <= tag.len()) {
    if (k == tag.len() || tag[k] == b',') {
      if (k > start) {
        out = out.append(slice_unchecked(tag, start, k) + "");
      }
      start = k + 1;
    }
    k += 1;
  }
  return out;
}

