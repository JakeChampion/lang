// heap_adopt(start, end) makes [start, end) the heap: the cursor moves to
// start, the end to end, and both free lists are cleared, so every later
// allocation lies inside the region. A forked worker adopts its result
// region with it. A range outside the heap also moves the heap's base, and
// under leak check it fixes the bounds of the process's census, so a free
// outside them is not counted. A range inside the heap keeps both. Pushes 0.
pub function op_heap_adopt(): Op {
  return op0(K_HEAP_ADOPT);
}

// A worker region is a shared anonymous mapping that a fork inherits at the
// same address. Its first word is the root the child hands back, the next
// four hold the leak-check counters (the parent's snapshot at
// worker_region, the child's deltas once worker_exit has run), and the
// sixth is the region's size. Under the sanitizer the reap opens the region
// as a window the quarantine skips, and the unmap closes it.
// worker_region(size) pushes the address or a negative errno.
// worker_exit(region, root) stores the root and ends the child at once.
// worker_reap(region) adds the child's deltas to the counters and pushes
// the root.
pub function op_worker_region(): Op {
  return op0(K_WORKER_REGION);
}

pub function op_worker_exit(): Op {
  return op0(K_WORKER_EXIT);
}

pub function op_worker_reap(): Op {
  return op0(K_WORKER_REAP);
}

// worker_unmap(region, size, reaped) removes the mapping and returns errno.
// A reaped region carries child deltas. Its live boxes leave the census
// only after the kernel removes the mapping. An unused region carries none.
pub function op_worker_unmap(): Op {
  return op0(K_WORKER_UNMAP);
}

// send_adopt marks the word under it as a box this process now owns. It
// emits nothing: the word is a root another process handed over through a
// worker region, and the mark is what the certifier counts.
pub function op_send_adopt(): Op {
  return counted(op0(K_SEND_ADOPT));
}

// send_root takes the box under it from its owner and leaves its address.
// It emits nothing: the word is the box, and the move is what the certifier
// counts.
pub const K_SEND_ROOT: i32 = 497;

pub function op_send_root(): Op {
  return op0(K_SEND_ROOT);
}

// The worker ops, 491 to 497, by name and by id.
function kind_id_worker(name: string): i32 {
  if (name == "heap_adopt") {
    return 491;
  }
  if (name == "worker_region") {
    return 492;
  }
  if (name == "worker_exit") {
    return 493;
  }
  if (name == "worker_reap") {
    return 494;
  }
  if (name == "send_adopt") {
    return 495;
  }
  if (name == "worker_unmap") {
    return 496;
  }
  if (name == "send_root") {
    return 497;
  }
  return 0;
}

function kind_name_worker(id: i32): string {
  if (id == 491) {
    return "heap_adopt";
  }
  if (id == 492) {
    return "worker_region";
  }
  if (id == 493) {
    return "worker_exit";
  }
  if (id == 494) {
    return "worker_reap";
  }
  if (id == 495) {
    return "send_adopt";
  }
  if (id == 496) {
    return "worker_unmap";
  }
  return "send_root";
}

function worker_pops1(t: i32): boolean {
  return t == 492 || t == 494 || t == 495 || t == 497;
}

function worker_pops2(t: i32): boolean {
  return t == 491 || t == 493;
}

