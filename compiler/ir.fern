pub function op_struct_make(type_name: string, nfields: i32, decl_index: i32): Op {
  return Op { source: 0, decl: decl_index, kind_tag: K_STRUCT_MAKE, i32_imm: nfields, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: type_name };
}

pub function op_const_struct(type_name: string, nfields: i32, values: string): Op {
  return Op { source: 0, decl: -1, kind_tag: K_CONST_STRUCT, i32_imm: nfields, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: type_name + "|" + values };
}

pub function const_struct_type(packed: string): string {
  let i = 0;
  while (i < packed.len() && packed[i] != 124) {
    i += 1;
  }
  return slice_unchecked(packed, 0, i).to_owned();
}

pub function const_struct_payload(packed: string): string {
  let i = 0;
  while (i < packed.len() && packed[i] != 124 as u8) {
    i += 1;
  }
  if (i == packed.len()) {
    return "";
  }
  return slice_unchecked(packed, i + 1, packed.len()).to_owned();
}

pub function const_struct_values(packed: string): string[] {
  let out: string[] = [];
  let i = 0;
  while (i < packed.len() && packed[i] != 124) {
    i += 1;
  }
  i += 1;
  let start = i;
  let depth = 0;
  while (i < packed.len()) {
    if (packed[i] == b'{') {
      depth += 1;
    } else if (packed[i] == b'}') {
      depth -= 1;
    } else if (packed[i] == b',' && depth == 0) {
      out = out.append(slice_unchecked(packed, start, i).to_owned());
      start = i + 1;
    }
    i += 1;
  }
  if (start < packed.len()) {
    out = out.append(slice_unchecked(packed, start, packed.len()).to_owned());
  }
  return out;
}

pub function const_str_word(text: string): string {
  return "{&str|" + hex_text(text) + "}";
}

function hex_text(text: string): string {
  let out: u8[] = [];
  for c in text {
    out = out.append(util.hex_digit(c as i32 >> 4)).append(util.hex_digit(c as i32 & 15));
  }
  unsafe {
    return string_from_bytes_unchecked(out);
  }
}

pub function const_struct_is_str(packed: string): boolean {
  return const_struct_type(packed) == "&str";
}

pub function const_str_text(packed: string): string {
  let vals = const_struct_values(packed);
  if (vals.len() == 0) {
    return "";
  }
  let hex = vals[0];
  let out: u8[] = [];
  let i = 0;
  while (i + 1 < hex.len()) {
    out = out.append((hex_value(hex[i]) * 16 + hex_value(hex[i + 1])) as u8);
    i += 2;
  }
  unsafe {
    return string_from_bytes_unchecked(out);
  }
}

function hex_value(c: u8): i32 {
  if (c >= b'a') {
    return c as i32 - 87;
  }
  return c as i32 - 48;
}

pub function const_struct_ref(word: string): string {
  if (word.len() < 2 || word[0] != b'{' || word[word.len() - 1] != b'}') {
    return "";
  }
  return slice_unchecked(word, 1, word.len() - 1).to_owned();
}

// A constant closure whose stub carries the signature word `cfi` under -harden.
pub function op_const_closure(body: string, cfi: i32): Op {
  return op_const_struct("&fn:" + body + "#" + util.i32_to_string(cfi), 0, "");
}

pub function op_const_bytes(values: string): Op {
  return op_const_struct("&bytes", 0, values);
}

pub function op_const_option(tag: i32): Op {
  return op_const_struct("&opt", 0, util.i32_to_string(tag));
}

pub function const_option_ref(tag: i32): string {
  return "{" + op_const_option(tag).str + "}";
}

pub function const_struct_is_option(packed: string): boolean {
  return const_struct_type(packed) == "&opt";
}

pub function const_struct_is_bytes(packed: string): boolean {
  return const_struct_type(packed) == "&bytes";
}

pub function const_struct_is_array(packed: string): boolean {
  return const_struct_type(packed) == "&arr" || const_struct_is_wide_array(packed) || const_struct_is_bytes(packed) || const_struct_is_compact_array(packed);
}

pub function const_struct_is_compact_array(packed: string): boolean {
  return const_struct_type(packed) == "&arr32";
}

pub function const_struct_is_wide_array(packed: string): boolean {
  return const_struct_type(packed) == "&arr64";
}

pub function const_struct_fn_body(packed: string): string {
  let t = const_struct_type(packed);
  if (t.len() <= 4 || !t.starts_with("&fn:")) {
    return "";
  }
  return slice_unchecked(t, 4, const_struct_fn_hash_at(t)).to_owned();
}

// The signature word of a constant closure.
pub function const_struct_fn_sig(packed: string): i32 {
  let t = const_struct_type(packed);
  let at = const_struct_fn_hash_at(t);
  if (at >= t.len()) {
    return 0;
  }
  return util.lit_to_i32(slice_unchecked(t, at + 1, t.len()).to_owned());
}

function const_struct_fn_hash_at(t: string): i32 {
  let i = t.len();
  while (i > 4 && t[i - 1] != b'#') {
    i -= 1;
  }
  if (i > 4) {
    return i - 1;
  }
  return t.len();
}

