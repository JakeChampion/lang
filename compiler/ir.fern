pub function kind_count(): i32 {
  return 188;
}

pub function kind_retired(id: i32): boolean {
  return id == 110 || id == 114 || id == 115 || id == 168 || id >= 62 && id <= 66 || id >= 117 && id <= 119 || id == 121 || id >= 125 && id <= 137 || id == 198;
}

pub function kind_id(name: string): i32 {
  if (name == "alloc_uninit") {
    return K_ALLOC_UNINIT;
  }
  let n = name.len();
  if (n == 7 && name == "mulhi_u") {
    return 430;
  }
  if (n == 7 && name == "mulhi_s") {
    return 484;
  }
  let lane = kind_id_lane(name);
  if (lane > 0) {
    return lane;
  }
  let worker = kind_id_worker(name);
  if (worker > 0) {
    return worker;
  }
  let device = kind_id_device(name);
  if (device > 0) {
    return device;
  }
  if (n >= 8 && n <= 13 && (name[0] == b'd' || name[0] == b'o')) {
    let dir = kind_id_dir(name);
    if (dir > 0) {
      return dir;
    }
  }
  if (n == 2) {
    return kind_id_len2(name);
  }
  if (n == 3) {
    return kind_id_len3(name);
  }
  if (n == 4) {
    return kind_id_len4(name);
  }
  if (n == 5) {
    return kind_id_len5(name);
  }
  if (n == 6) {
    return kind_id_len6(name);
  }
  if (n == 7) {
    return kind_id_len7(name);
  }
  if (n == 8) {
    return kind_id_len8(name);
  }
  if (n == 9) {
    return kind_id_len9(name);
  }
  if (n == 10) {
    return kind_id_len10(name);
  }
  if (n == 11) {
    return kind_id_len11(name);
  }
  if (n == 12) {
    return kind_id_len12(name);
  }
  if (n == 13) {
    return kind_id_len13(name);
  }
  if (n == 14) {
    return kind_id_len14(name);
  }
  if (n == 15) {
    return kind_id_len15(name);
  }
  if (n == 16) {
    return kind_id_len16(name);
  }
  if (n == 17) {
    return kind_id_len17(name);
  }
  if (n == 18) {
    return kind_id_len18(name);
  }
  if (n == 19) {
    return kind_id_len19(name);
  }
  if (n == 20 && name == "buf_push_bytes_range") {
    return 351;
  }
  if (n == 20 && name == "str_from_bytes_range") {
    return 380;
  }
  if (n == 21) {
    return kind_id_len21(name);
  }
  if (n == 23) {
    return kind_id_len23(name);
  }
  if (n == 25 && name == "signal_catch_interrupting") {
    return 394;
  }
  return 0;
}

function dir_kind_names(): string[] {
  return ["open_dir", "dir_open", "dir_entries", "dir_stat", "dir_access", "dir_unlink", "dir_chmod", "dir_chown", "dir_open_file"];
}

function kind_id_dir(name: string): i32 {
  let names = dir_kind_names();
  let i = 0;
  while (i < names.len()) {
    if (name == names[i]) {
      return 420 + i;
    }
    i += 1;
  }
  return 0;
}

function dir_kind_name(id: i32): string {
  return dir_kind_names()[id - 420];
}

function kind_id_len2(name: string): i32 {
  let c = name[0];
  if (c == b'b' && name == "br") {
    return 157;
  }
  if (c == b'e' && name == "eq") {
    return 35;
  }
  if (c == b'i' && name == "if") {
    return 154;
  }
  if (c == b'n' && name == "ne") {
    return 36;
  }
  if (c == b'o' && name == "or") {
    return 29;
  }
  return 0;
}

function kind_id_len3(name: string): i32 {
  let c = name[0];
  if (c == b'a' && name == "add") {
    return 21;
  }
  if (c == b'a' && name == "and") {
    return 28;
  }
  if (c == b'c' && name == "clz") {
    return 219;
  }
  if (c == b'c' && name == "ctz") {
    return 220;
  }
  if (c == b'e' && name == "end") {
    return 156;
  }
  if (c == b'e' && name == "env") {
    return 176;
  }
  if (c == b'f') {
    return kind_id_len3_f(name);
  }
  if (c == b'm' && name == "mul") {
    return 23;
  }
  if (c == b'n' && name == "not") {
    return 34;
  }
  if (c == b's' && name == "sub") {
    return 22;
  }
  if (c == b's' && name == "shl") {
    return 31;
  }
  if (c == b'x' && name == "xor") {
    return 30;
  }
  return 0;
}

// The device ops whose names the length tables do not hold.
function kind_id_device(name: string): i32 {
  if (name == "port_in") {
    return K_PORT_IN;
  }
  if (name == "port_out") {
    return K_PORT_OUT;
  }
  if (name == "wfi") {
    return K_WFI;
  }
  if (name == "hvc") {
    return K_HVC;
  }
  if (name == "smc") {
    return K_SMC;
  }
  if (name == "boot_info") {
    return K_BOOT_INFO;
  }
  return kind_id_sysreg(name);
}

function kind_id_sysreg(name: string): i32 {
  if (name == "sysreg_read") {
    return K_SYSREG_READ;
  }
  if (name == "sysreg_write") {
    return K_SYSREG_WRITE;
  }
  return kind_id_maintenance(name);
}

function kind_id_maintenance(name: string): i32 {
  if (name == "cache_clean") {
    return K_CACHE_CLEAN;
  }
  if (name == "cache_flush") {
    return K_CACHE_FLUSH;
  }
  if (name == "tlb_flush") {
    return K_TLB_FLUSH;
  }
  if (name == "tlb_flush_all") {
    return K_TLB_FLUSH_ALL;
  }
  if (name == "breakpoint") {
    return K_BREAKPOINT;
  }
  return kind_id_irq(name);
}

function kind_id_irq(name: string): i32 {
  if (name == "irq_mask") {
    return K_IRQ_MASK;
  }
  if (name == "irq_unmask") {
    return K_IRQ_UNMASK;
