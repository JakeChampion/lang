}

pub function is_device_kind(id: i32): boolean {
  return id == K_MMIO_LOAD || id == K_MMIO_STORE || id == K_FENCE || id == K_PORT_IN || id == K_PORT_OUT || is_privileged_kind(id);
}

function device_kind_name(id: i32): string {
  if (id == K_MMIO_LOAD) {
    return "mmio_load";
  }
  if (id == K_FENCE) {
    return "fence";
  }
  if (id == K_WFI) {
    return "wfi";
  }
  if (id == K_HVC) {
    return "hvc";
  }
  if (id == K_SMC) {
    return "smc";
  }
  if (id == K_BOOT_INFO) {
    return "boot_info";
  }
  return access_kind_name(id);
}

function access_kind_name(id: i32): string {
  if (id == K_PORT_IN) {
    return "port_in";
  }
  if (id == K_PORT_OUT) {
    return "port_out";
  }
  if (id == K_SYSREG_READ) {
    return "sysreg_read";
  }
  if (id == K_SYSREG_WRITE) {
    return "sysreg_write";
  }
  return maintenance_kind_name(id);
}

function maintenance_kind_name(id: i32): string {
  if (id == K_CACHE_CLEAN) {
    return "cache_clean";
  }
  if (id == K_CACHE_FLUSH) {
    return "cache_flush";
  }
  if (id == K_TLB_FLUSH) {
    return "tlb_flush";
  }
  if (id == K_TLB_FLUSH_ALL) {
    return "tlb_flush_all";
  }
  if (id == K_BREAKPOINT) {
    return "breakpoint";
  }
  return irq_kind_name(id);
}

function irq_kind_name(id: i32): string {
  if (id == K_IRQ_MASK) {
    return "irq_mask";
  }
  if (id == K_IRQ_UNMASK) {
    return "irq_unmask";
  }
  if (id == K_IRQ_WAIT) {
    return "irq_wait";
  }
  if (id == K_IRQ_PENDING) {
    return "irq_pending";
  }
  return "mmio_store";
}

