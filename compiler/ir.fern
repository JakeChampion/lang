// The builtins that each backend runs in a hand-written kernel. kernel_builtin_ops gives the op of each.
const KERNEL_BUILTINS: string[] = [
  "__aes_expand_key", "__aes_ctr32", "__ghash", "__aes_gcm_seal_into", "__aes_gcm_open_into", "__chacha20_xor_into", "__poly1305_blocks",
  "__chacha20_poly1305_seal_into", "__chacha20_poly1305_open_into", "__mont_mul", "__scrypt_block_mix",
];

function kernel_builtin_ops(): Op[] {
  return [
    op_aes_expand_key(), op_aes_ctr32(), op_ghash(), op_aes_gcm_seal_into(), op_aes_gcm_open_into(), op_chacha20_xor_into(), op_poly1305_blocks(),
    op_chacha20_poly1305_seal_into(), op_chacha20_poly1305_open_into(), op_mont_mul(), op_scrypt_block_mix(),
  ];
}

// The packed op of a builtin in KERNEL_BUILTINS, or None.
pub function kernel_builtin_op(name: string): Option[Op] {
  for k in 0..KERNEL_BUILTINS.len() {
    if (KERNEL_BUILTINS[k] == name) {
      return Some(packed(kernel_builtin_ops()[k]));
    }
  }
  return None;
}

// An op that a hand-written kernel of each backend runs over byte arrays.
pub function is_byte_kernel_op(tag: i32): boolean {
  return is_aes_gcm_op(tag) || is_sha_blocks_op(tag) || tag == K_CHACHA20_XOR_INTO || tag == K_POLY1305_BLOCKS || is_chacha20_poly1305_op(tag) || tag == K_MONT_MUL || tag == K_SCRYPT_BLOCK_MIX;
}

pub function is_sha_hw_op(tag: i32): boolean {
  return tag == 409 || tag == 440 || tag == 552;
}

pub function is_sha_blocks_op(tag: i32): boolean {
  return tag == 410 || tag == 441 || tag == 553;
}

// The runtime need of a byte kernel that each native backend calls by
// symbol with its arguments in registers. Other ops give "".
pub function kernel_need(tag: i32): string {
  return match (tag) {
    410 => "sha256",
    553 => "sha1x8",
    554 => "chacha20",
    555 => "poly1305",
    556 => "chacha20poly1305_seal",
    557 => "chacha20poly1305_open",
    558 => "mont_mul",
    559 => "scrypt",
    _ => "",
  };
}

pub function kernel_symbol(tag: i32): string {
  if (tag == K_CHACHA20_XOR_INTO) {
    return "__fern_chacha20_xor_into";
  }
  if (tag == K_POLY1305_BLOCKS) {
    return "__fern_poly1305_blocks";
  }
  if (tag == K_CHACHA20_POLY1305_SEAL_INTO) {
    return "__fern_chacha20_poly1305_seal_into";
  }
  if (tag == K_CHACHA20_POLY1305_OPEN_INTO) {
    return "__fern_chacha20_poly1305_open_into";
  }
  if (tag == K_MONT_MUL) {
    return "__fern_mont_mul";
  }
  if (tag == K_SCRYPT_BLOCK_MIX) {
    return "__fern_scrypt_block_mix";
  }
  return "__fern_" + kernel_need(tag) + "_hw_blocks";
}

pub function kernel_arity(tag: i32): i32 {
  if (tag == K_CHACHA20_XOR_INTO) {
    return 5;
  }
  if (tag == K_POLY1305_BLOCKS) {
    return 4;
  }
  if (is_chacha20_poly1305_op(tag)) {
    return 7;
  }
  if (tag == K_MONT_MUL) {
    return 3;
  }
  if (tag == K_SCRYPT_BLOCK_MIX) {
    return 5;
  }
  return 2;
}

// The cksum and IEEE CRC-32 updates, each in its string and its array form.
pub function is_crc32_op(tag: i32): boolean {
  return tag == 309 || tag == 373 || tag == 480 || tag == 481;
}

pub function sha_builtin_tag(name: string): i32 {
  return match (name) {
    "__sha256_hw" => 409,
    "__sha256_hw_blocks" => 410,
    "__sha1_hw" => 440,
    "__sha1_hw_blocks" => 441,
    "__sha1x8_hw" => 552,
    "__sha1x8_hw_blocks" => 553,
    _ => 0,
  };
}

pub function sha_builtin_op(tag: i32): Op {
  return match (tag) {
    409 => op_sha256_hw(),
    440 => op_sha1_hw(),
    552 => op_sha1x8_hw(),
    410 => packed(op_sha256_hw_blocks()),
    553 => packed(op_sha1x8_hw_blocks()),
    _ => packed(op_sha1_hw_blocks()),
  };
}

