pub function op_dyn_dispatch(arms: string[], base_slot: i32, argc: i32): Op {
  let tag = "";
  for i in 0..arms.len() {
    if (i > 0) {
      tag += ",";
    }
    tag += arms[i];
  }
  return Op { source: 0, decl: -1, kind_tag: K_DYN_DISPATCH, i32_imm: base_slot, i64_imm: 0, f64_imm: 0.0, width: argc, unsigned: false, str: tag };
}

pub function dyn_dispatch_arms(tag: string): string[] {
  let out: string[] = [];
  let start = 0;
  for k in 0..=tag.len() {
    if (k == tag.len() || tag[k] == b',') {
      if (k > start) {
        out = out.append(slice_unchecked(tag, start, k).to_owned());
      }
      start = k + 1;
    }
  }
  return out;
}

pub function op_dyn_box(type_name: string): Op {
  return Op { source: 0, decl: -1, kind_tag: K_DYN_BOX, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: type_name };
