// The width of an array op is the width of its element: 8 for a byte, 32 for a
// 4-byte integer, 64 for an 8-byte scalar, and width_ptr() for a pointer-width slot.
pub function packed(o: Op): Op {
  return Op { ...o, width: 8 };
}

pub function is_packed(o: Op): boolean {
  return o.width == 8;
}

pub function compact(o: Op): Op {
  return Op { ...o, width: 32 };
}

pub function is_compact(o: Op): boolean {
