}

pub function op_int_extend_ptr(): Op {
  return Op { source: 0, decl: -1, kind_tag: K_INT_EXTEND, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width_ptr(), unsigned: true, str: "" };
