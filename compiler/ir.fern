pub function op_const_f64(v: f64): Op {
  return Op { source: 0, decl: -1, kind_tag: K_CONST_F64, i32_imm: 0, i64_imm: 0, f64_imm: v, width: 0, unsigned: false, str: "" };
}

pub function const_i64_text(o: Op): string {
  if (o.str.len() > 0) {
    return o.str;
  }
  return util.i64_to_string(o.i64_imm);
}

pub function const_f64_bits(o: Op): i64 {
  if (o.str.len() > 0) {
    return util.parse_f64_bits(o.str);
  }
  return f64_bits(o.f64_imm);
}

pub function op_const_str(s: string): Op {
  return Op { source: 0, decl: -1, kind_tag: K_CONST_STR, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: s };
}

// The address of function `name`, with `cfi` the signature word its stub
// carries under -harden (`cfi_sig_hash`).
pub function op_const_func(cfi: i32, name: string): Op {
  return Op { source: 0, decl: -1, kind_tag: K_CONST_FUNC, i32_imm: cfi, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: name };
}

