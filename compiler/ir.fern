// A privileged op that only a kernel environment grants: wait for an
// interrupt, or call the hypervisor or the secure monitor with four arguments
// in the SMC calling convention.
pub function op_privileged(kind: i32): Op {
  return Op { source: 0, decl: -1, kind_tag: kind, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

// The privileged kinds are 415 to 417 and 499 to 510.
pub function is_privileged_kind(id: i32): boolean {
  return id >= K_WFI && id <= K_SMC || id >= K_BOOT_INFO && id <= K_IRQ_PENDING;
}

// hvc and smc take the function and three arguments. wfi, boot_info,
// sysreg_read, tlb_flush_all, breakpoint and the IRQ ops take nothing. The
// others take one operand: the value of sysreg_write, or the address of a cache
// or TLB op.
function privileged_pops(id: i32): i32 {
  if (id == K_HVC || id == K_SMC) {
    return 4;
  }
  if (id == K_WFI || id == K_BOOT_INFO || id == K_SYSREG_READ || id == K_TLB_FLUSH_ALL || id >= K_BREAKPOINT) {
    return 0;
  }
  return 1;
}

// A read or a write of the system register `name`. The name is part of the op,
// because an instruction encodes the register.
pub function op_sysreg(kind: i32, name: string): Op {
  return Op { source: 0, decl: -1, kind_tag: kind, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: name };
}

// A port access of `width` bits: in reads the port, out writes it. Only x86-64
// has an I/O port space.
pub function op_port_in(width: i32): Op {
  return Op { source: 0, decl: -1, kind_tag: K_PORT_IN, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
