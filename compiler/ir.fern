pub function const_i64_text(o: Op): string {
  if (o.str.len() > 0) {
    return o.str;
  }
  return util.i64_to_string(o.i64_imm);
}

pub function const_f64_bits(o: Op): i64 {
  if (o.str.len() > 0) {
    return util.parse_f64_bits(o.str);
  }
  return f64_bits(o.f64_imm);
}

