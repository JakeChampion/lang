    || t == 277 || t == 279
    || t == 241 || t == 250 || t == 307
    || t == 299 || t == 300 || t == 301
    || t == 261 || t == 264 || t == 265
    || t == 283
    || t == 270 || t == 271
    || t == 401
    || t == 276 || t == 312
    || t == 185 || t == 212
    || t == 286
    || t == 397
    || t == 399 || t == 400
    || t == 402
    || t == 188 || t == 148 || t == 161 || t == 162 || t == 167
    || t == 116 || t == 112 || t == 200 || t == 201 || t == 203
    || t == 320
    || t == 230
    || t == 316 || t == 317 || t == 318 || t == 319;
}

function pops2_arith(t: i32): boolean {
  return t >= 21 && t <= 33 || t >= 35 && t <= 54 || t == 430;
}

function pops2_kernel(t: i32): boolean {
  return t == 227 || t == 235
    || t == 329 || t == 369
    || t == 390
    || t == 309 || t == 373
    || t == 322 || t == 381
    || is_sha_blocks_op(t);
}

function pops2_mem(t: i32): boolean {
  return t == 359 || t == 72 || t == 73 || t == 199
    || t == 78
    || t == 83 || t == 85 || t == 86 || t == 223
    || t == 88
    || t == 92 || t == 93 || t == 94 || t == 95 || t == 302 || t == 303
    || t == 98 || t == 99 || t == 100 || t == 101
    || t == 105 || t == 108
    || pops2_kernel(t)
    || t == 124 || t == 140 || t == 144;
}

function pops2_io(t: i32): boolean {
  return t == 170 || t == 226 || t == 352
    || t == 237
    || t == 260 || t == 262 || t == 263 || t == 267 || t == 268
    || t == 356 || t == 357
    || t == 405
    || t == 406
    || t == 362 || t == 363 || t == 374 || t == 375
    || t == 273
    || t == 304 || t == 305
    || t == 281
    || t == 285
    || t == 284
    || t == 311
    || t == 178 || t == 348 || t == 349 || t == 350 || t == 187
    || t == 353 || t == 334 || t == 339
    || t == 344
    || t == 202 || t == 213 || t == 308 || t == 431
    || t == 278
    || t == 388;
}

function pops3(t: i32): boolean {
  return t == 379 || t == 361 || t == 360 || t == 358 || t == 74 || t == 75
    || t == 82 || t == 84
    || t == 89 || t == 96 || t == 102 || t == 111
    || t == 177 || t == 225 || t == 234
    || t == 333 || t == 335 || t == 337 || t == 338
    || t == 442
    || t == 346
    || t == 387
    || t == 343 || t == 436
    || t == 438
    || t == 242
    || t == 330
    || t == 407
    || t == 280
    || t == 313
    || t == 314
    || t == 324
    || t == 327
    || t == 364 || t == 365 || t == 376 || t == 377
    || t == 366 || t == 380
    || t == 403 || t == 404
    || t == 433;
}

function pops_buf(t: i32): i32 {
  if (t == 351) {
    return 4;
  }
  if (t == 347 || t == 386) {
    return 1;
  }
  if (t == 306) {
    return 2;
  }
  if (t == 325 || t == 326 || t == 328 || t == 370 || t == 371 || t == 372) {
    return 3;
  }
  if (t < 291 || t > 297) {
    return 0 - 1;
  }
  if (t == 293) {
    return 4;
  }
  if (t == 292 || t == 294) {
    return 2;
  }
  return 1;
}

function pops_dir(t: i32): i32 {
  if (t == 420 || t == 422) {
    return 1;
  }
  if (t == 424) {
    return 3;
  }
  if (t == 426) {
    return 4;
  }
  if (t == 427) {
    return 5;
  }
  return 2;
}

pub function op_pops(o: Op): i32 {
  return pops_of(kind_pops(o.kind_tag), o);
}

pub function op_pops_by(by_kind: i32[], o: Op): i32 {
  let t: i32 = o.kind_tag;
  if (t < 0 || t >= by_kind.len()) {
    return op_pops(o);
  }
  return pops_of(by_kind[t], o);
}

pub function pops_by_kind(): i32[] {
  let out: i32[] = [];
  let t: i32 = 0;
  while (t < 1024) {
    out = out.append(kind_pops(t));
    t = t + 1;
  }
  return out;
}

function pops_of(fixed: i32, o: Op): i32 {
  if (fixed >= 0) {
    return fixed;
  }
  let t: i32 = o.kind_tag;
  if (t == 87 || t == 138 || t == 142 || t == 149) {
    return o.i32_imm;
  }
  if (t == 150) {
    return o.i32_imm + 1;
  }
  return 0 - 1;
}

function kind_pops(t: i32): i32 {
  if (is_lane_kind(t)) {
    return lane_kind_pops()[t - LANE_KIND_FIRST];
  }
  let bufn: i32 = pops_buf(t);
  if (bufn >= 0) {
    return bufn;
  }
  if (t >= 420 && t <= 427) {
    return pops_dir(t);
  }
  if (pops0(t)) {
    return 0;
  }
  if (pops1_conv(t) || pops1_mem(t) || pops1_io(t)) {
    return 1;
  }
  if (pops2_arith(t) || pops2_mem(t) || pops2_io(t)) {
    return 2;
  }
  if (pops3(t)) {
    return 3;
  }
  if (t == 204) {
    return 4;
  }
  if (t == 332) {
    return 4;
  }
  if (t == 336 || t == 355) {
    return 4;
  }
  if (t == 342 || t == 435 || t == 437 || t == 439) {
    return 4;
  }
  if (t == 206) {
    return 5;
  }
  if (t == 245 || t == 378 || t == 446 || t == 444 || t == 445) {
    return 5;
  }
  if (t == 228 || t == 382) {
    return 6;
  }
  if (t == 323) {
    return 7;
  }
  if (t == 269) {
    return 6;
  }
  if (t == 274) {
    return 4;
  }
  if (t == 275) {
    return 4;
  }
  if (t == 321) {
    return 3;
  }
  return 0 - 1;
}

pub function pure_value_op(o: Op): boolean {
  let t: i32 = o.kind_tag;
  if (t == 1 || t == 3 || t == 4 || t == 5 || t == 6 || t == 218 || t == 18) {
    return true;
  }
  if (t == 88 || t == 139 || t == 143 || t == 90 || t == 97 || t == 101) {
    return true;
  }
  if (t == 19 || t == 20) {
    return false;
  }
  return pops2_arith(t) || pops1_conv(t);
}

pub function op_pushes(o: Op): i32 {
  let t: i32 = o.kind_tag;
  if (t == 19 || t == 159 || lane_writes(t)) {
    return 0;
  }
  if (t == 288) {
    return 0;
  }
  if (t == 89 || t == 124 || t == 140 || t == 144) {
    return 0;
  }
  if (t == 152 || t == 153 || t == 154 || t == 155 || t == 156) {
    return 0;
  }
  if (t == 157 || t == 158 || t == 160) {
    return 0;
  }
  return 1;
}

pub function is_const_kind(id: i32): boolean {
  return id == K_CONST_I32 || id == K_CONST_I32_TEXT
    || id == K_CONST_I64 || id == K_CONST_F64
    || id == K_CONST_STR || id == K_CONST_FUNC;
}

pub function is_terminator_kind(id: i32): boolean {
  return id == K_RETURN || id == K_BR || id == K_EXIT;
}

pub function is_foldable_binary_kind(id: i32): boolean {
  return id == K_ADD || id == K_SUB || id == K_MUL
    || id == K_DIV_S || id == K_REM_S
    || id == K_AND || id == K_OR || id == K_XOR
    || id == K_SHL || id == K_SHR_S
    || id == K_EQ || id == K_NE
    || id == K_LT_S || id == K_LE_S
    || id == K_GT_S || id == K_GE_S;
}

struct IfSpan {
  else_at: i32,
  end_at: i32,
}

function scan_if_block(ops: Op[], if_at: i32): IfSpan {
  let k_block: i32 = K_BLOCK;
  let k_loop: i32 = K_LOOP;
  let k_if: i32 = K_IF;
  let k_else: i32 = K_ELSE;
  let k_end: i32 = K_END;
  let else_at: i32 = 0 - 1;
  let d: i32 = 0;
  let i: i32 = if_at + 1;
  while (i < ops.len()) {
    let t: i32 = ops[i].kind_tag;
    if (t == k_block || t == k_loop || t == k_if) {
      d = d + 1;
    } else if (t == k_end) {
      if (d == 0) {
        return IfSpan { else_at: else_at, end_at: i };
      }
      d = d - 1;
    } else if (t == k_else && d == 0 && else_at < 0) {
      else_at = i;
    }
    i = i + 1;
  }
  return IfSpan { else_at: else_at, end_at: 0 - 1 };
}

function arm_escapes_scope(ops: Op[], lo: i32, hi: i32): boolean {
  let k_block: i32 = K_BLOCK;
  let k_loop: i32 = K_LOOP;
  let k_if: i32 = K_IF;
  let k_end: i32 = K_END;
  let k_br: i32 = K_BR;
  let k_brif: i32 = K_BRIF;
  let d: i32 = 0;
  let i: i32 = lo;
  while (i < hi) {
    let t: i32 = ops[i].kind_tag;
    if (t == k_block || t == k_loop || t == k_if) {
      d = d + 1;
    } else if (t == k_end) {
      if (d > 0) {
        d = d - 1;
      }
    } else if (t == k_br || t == k_brif) {
      if (ops[i].i32_imm >= d) {
        return true;
      }
    }
    i = i + 1;
  }
  return false;
}

pub function fold_const_binaries(ops: Op[]): Op[] {
  let k_i32: i32 = K_CONST_I32;
  let k_i32_text: i32 = K_CONST_I32_TEXT;
  let k_i64: i32 = K_CONST_I64;
  let k_not: i32 = K_NOT;
  let k_if: i32 = K_IF;
  let k_brif: i32 = K_BRIF;
  let k_const_str: i32 = K_CONST_STR;
  let k_str_eq: i32 = K_STR_EQ;
  let k_const_f64: i32 = K_CONST_F64;
  let k_fneg: i32 = K_FNEG;
  let cur: Op[] = ops;
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let out: Op[] = [];
    let copying: boolean = false;
    let i: i32 = 0;
    while (i < cur.len()) {
      let folded: boolean = false;
      let at: i32 = i;
      let kt: i32 = cur[i].kind_tag;
      if (kt != k_i32 && kt != k_i32_text && kt != k_i64 && kt != k_const_str && kt != k_const_f64) {
        if (copying) {
          out = out.append(cur[i]);
        }
        i = i + 1;
        continue;
      }
      let r32: boolean = const_i32_readable(cur[i]);
      let r64: boolean = const_i64_readable(cur[i]);
      if (i + 1 < cur.len() && cur[i].kind_tag == k_const_f64 && cur[i + 1].kind_tag == k_fneg) {
        out = out.append(op_const_f64(f64_from_bits(const_f64_bits(cur[i]) ^ 1i64 << 63)));
        i = i + 2;
        changed = true;
        folded = true;
      }
      if (r32 && i + 2 < cur.len()) {
        let b: Op = cur[i + 1];
        let o: Op = cur[i + 2];
        if (const_i32_readable(b)
          && is_foldable_binary_kind(o.kind_tag) && o.width == 0 && !o.unsigned
          && !fold_would_divide_by_zero(o.kind_tag, const_i32_value(b))) {
          out = out.append(op_const_i32(fold_binary_i32(o.kind_tag, const_i32_value(cur[i]), const_i32_value(b))));
          i = i + 3;
          changed = true;
          folded = true;
        }
      }
      if (!folded && i + 2 < cur.len() && r64 && const_i64_readable(cur[i + 1])) {
        let f64r: Fold64 = fold_binary_i64(cur[i + 2], const_i64_value(cur[i]), const_i64_value(cur[i + 1]));
        if (f64r.ok) {
          if (f64r.cmp) {
            out = out.append(op_const_i32(f64r.v as i32));
          } else {
            out = out.append(op_const_i64_text(util.i64_to_string(f64r.v)));
          }
          i = i + 3;
          changed = true;
          folded = true;
        }
      }
      if (!folded && i + 1 < cur.len() && r32
        && cur[i + 1].kind_tag == 7 && cur[i + 1].width == 64) {
        let xv: i64 = const_i32_value(cur[i]) as i64;
        if (cur[i + 1].unsigned) {
          xv = xv & 4294967295i64;
        }
        out = out.append(op_const_i64_text(util.i64_to_string(xv)));
        i = i + 2;
        changed = true;
        folded = true;
      }
      if (!folded && i + 1 < cur.len() && r64
        && cur[i + 1].kind_tag == 8 && cur[i + 1].width == 0
        && (!cur[i + 1].unsigned || const_i64_value(cur[i]) as i32 >= 0)) {
        out = out.append(op_const_i32(const_i64_value(cur[i]) as i32));
        i = i + 2;
        changed = true;
        folded = true;
      }
      if (!folded && i + 1 < cur.len()
        && r32 && cur[i + 1].kind_tag == k_not) {
        let nv: i32 = 0;
        if (const_i32_value(cur[i]) == 0) {
          nv = 1;
        }
        out = out.append(op_const_i32(nv));
        i = i + 2;
        changed = true;
        folded = true;
      }
      if (!folded && i + 2 < cur.len()
        && cur[i].kind_tag == k_const_str && cur[i + 1].kind_tag == k_const_str
        && cur[i + 2].kind_tag == k_str_eq) {
        let sv: i32 = 0;
        if (cur[i].str == cur[i + 1].str) {
          sv = 1;
        }
        out = out.append(op_const_i32(sv));
        i = i + 3;
        changed = true;
        folded = true;
      }
      if (!folded && i + 1 < cur.len() && r32) {
        let wf: WidthFold = fold_width_op(cur[i + 1], const_i32_value(cur[i]));
        if (wf.ok) {
          out = out.append(op_const_i32(wf.v));
          i = i + 2;
          changed = true;
          folded = true;
        }
      }
      if (!folded && i + 1 < cur.len() && r32
        && cur[i + 1].kind_tag == k_if && cur[i + 1].i32_imm == 0) {
        let span: IfSpan = scan_if_block(cur, i + 1);
        if (span.end_at >= 0) {
          let lo: i32 = i + 2;
          let hi: i32 = span.end_at;
          if (const_i32_value(cur[i]) != 0) {
            if (span.else_at >= 0) {
              hi = span.else_at;
            }
          } else if (span.else_at >= 0) {
            lo = span.else_at + 1;
          } else {
            lo = span.end_at;
          }
          let wrap: boolean = arm_escapes_scope(cur, lo, hi);
          if (wrap) {
            out = out.append(op_block(0));
          }
          let j: i32 = lo;
          while (j < hi) {
            out = out.append(cur[j]);
            j = j + 1;
          }
          if (wrap) {
            out = out.append(op_end());
          }
          i = span.end_at + 1;
          changed = true;
          folded = true;
        }
      }
      if (!folded && i + 1 < cur.len()
        && r32 && cur[i + 1].kind_tag == k_brif) {
        if (const_i32_value(cur[i]) != 0) {
          out = out.append(op_br(cur[i + 1].i32_imm));
        }
        i = i + 2;
        changed = true;
        folded = true;
      }
      if (!folded) {
        if (copying) {
          out = out.append(cur[i]);
        }
        i = i + 1;
      } else if (!copying) {
        out = fold_prefixed(cur, at, out);
        copying = true;
      }
    }
    if (copying) {
      cur = out;
    }
  }
  return cur;
}

function fold_prefixed(ops: Op[], at: i32, tail: Op[]): Op[] {
  let out: Op[] = [];
  let j: i32 = 0;
  while (j < at) {
    out = out.append(ops[j]);
    j = j + 1;
  }
  j = 0;
  while (j < tail.len()) {
    out = out.append(tail[j]);
    j = j + 1;
  }
  return out;
}

pub function const_i32_readable(o: Op): boolean {
  if (o.kind_tag == 1) {
    return o.str.len() == 0;
  }
  if (o.kind_tag != 2) {
    return false;
  }
  return util.is_decimal_i32(o.str);
}

pub function const_i64_readable(o: Op): boolean {
  return o.kind_tag == 3 && util.is_decimal_i64(o.str);
}

pub function const_i64_value(o: Op): i64 {
  return util.digits_to_i64(o.str);
}

pub function const_i32_value(o: Op): i32 {
  if (o.kind_tag == 1) {
    return o.i32_imm;
  }
  return util.digits_to_i32(o.str);
}

struct WidthFold {
  ok: boolean,
  v: i32,
}

function fold_width_op(o: Op, v: i32): WidthFold {
  if (o.kind_tag == 10) {
    if (v < 0) {
      return WidthFold { ok: false, v: 0 };
    }
    return WidthFold { ok: true, v: v };
  }
  if (o.kind_tag != 9) {
    return WidthFold { ok: false, v: 0 };
  }
  if (o.str == "i32") {
    return WidthFold { ok: true, v: v };
  }
  if (o.str == "u8") {
    return WidthFold { ok: true, v: v & 255 };
  }
  if (o.str == "u32" && v >= 0) {
    return WidthFold { ok: true, v: v };
  }
  return WidthFold { ok: false, v: 0 };
}

function fold_would_divide_by_zero(k: i32, rhs: i32): boolean {
  if (rhs != 0) {
    return false;
  }
  return k == K_DIV_S || k == K_REM_S;
}

function fold_binary_i32(k: i32, a: i32, b: i32): i32 {
  if (k == K_ADD) {
    return a + b;
  }
  if (k == K_SUB) {
    return a - b;
  }
  if (k == K_MUL) {
    return a * b;
  }
  if (k == K_DIV_S) {
    return a / b;
  }
  if (k == K_REM_S) {
    return a % b;
  }
  if (k == K_AND) {
    return a & b;
  }
  if (k == K_OR) {
    return a | b;
  }
  if (k == K_XOR) {
    return a ^ b;
  }
  if (k == K_SHL) {
    return a << b;
  }
  if (k == K_SHR_S) {
    return a >> b;
  }
  if (k == K_EQ) {
    if (a == b) {
      return 1;
    }
    return 0;
  }
  if (k == K_NE) {
    if (a != b) {
      return 1;
    }
    return 0;
  }
  if (k == K_LT_S) {
    if (a < b) {
      return 1;
    }
    return 0;
  }
  if (k == K_LE_S) {
    if (a <= b) {
      return 1;
    }
    return 0;
  }
  if (k == K_GT_S) {
    if (a > b) {
      return 1;
    }
    return 0;
  }
  if (k == K_GE_S) {
    if (a >= b) {
      return 1;
    }
    return 0;
  }
  return 0;
}

struct Fold64 {
  ok: boolean,
  cmp: boolean,
  v: i64,
}

function fold_binary_i64(o: Op, a: i64, b: i64): Fold64 {
  let no: Fold64 = Fold64 { ok: false, cmp: false, v: 0i64 };
  if (o.width != 64) {
    return no;
  }
  let k: i32 = o.kind_tag;
  if (k == K_ADD) {
    return Fold64 { ok: true, cmp: false, v: a + b };
  }
  if (k == K_SUB) {
    return Fold64 { ok: true, cmp: false, v: a - b };
  }
  if (k == K_MUL) {
    return Fold64 { ok: true, cmp: false, v: a * b };
  }
  if (k == K_AND) {
    return Fold64 { ok: true, cmp: false, v: a & b };
  }
  if (k == K_OR) {
    return Fold64 { ok: true, cmp: false, v: a | b };
  }
  if (k == K_XOR) {
    return Fold64 { ok: true, cmp: false, v: a ^ b };
  }
  if (k == K_SHL) {
    return Fold64 { ok: true, cmp: false, v: a << (b & 63i64) };
  }
  if (k == K_EQ) {
    return Fold64 { ok: true, cmp: true, v: fold_bool64(a == b) };
  }
  if (k == K_NE) {
    return Fold64 { ok: true, cmp: true, v: fold_bool64(a != b) };
  }
  if (o.unsigned) {
    return no;
  }
  let min: i64 = -9223372036854775807i64 - 1i64;
  if (k == K_DIV_S) {
    if (b == 0i64 || a == min && b == -1i64) {
      return no;
    }
    return Fold64 { ok: true, cmp: false, v: a / b };
  }
  if (k == K_REM_S) {
    if (b == 0i64) {
      return no;
    }
    if (a == min && b == -1i64) {
      return Fold64 { ok: true, cmp: false, v: 0i64 };
    }
    return Fold64 { ok: true, cmp: false, v: a % b };
  }
  if (k == K_SHR_S) {
    return Fold64 { ok: true, cmp: false, v: a >> (b & 63i64) };
  }
  if (k == K_LT_S) {
    return Fold64 { ok: true, cmp: true, v: fold_bool64(a < b) };
  }
  if (k == K_LE_S) {
    return Fold64 { ok: true, cmp: true, v: fold_bool64(a <= b) };
  }
  if (k == K_GT_S) {
    return Fold64 { ok: true, cmp: true, v: fold_bool64(a > b) };
  }
  if (k == K_GE_S) {
    return Fold64 { ok: true, cmp: true, v: fold_bool64(a >= b) };
  }
  return no;
}

function fold_bool64(c: boolean): i64 {
  if (c) {
    return 1i64;
  }
  return 0i64;
}

pub struct StrengthResult {
  ops: Op[],
  changed: boolean,
}

struct StrengthRewrite {
  ok: boolean,
  ops: Op[],
}

function strength_none(): StrengthRewrite {
  return StrengthRewrite { ok: false, ops: [] };
}

function strength_del(): StrengthRewrite {
  return StrengthRewrite { ok: true, ops: [] };
}

function strength_drop0(): StrengthRewrite {
  let o: Op[] = [op_drop(), op_const_i32(0)];
  return StrengthRewrite { ok: true, ops: o };
}

function strength_pair(a: Op, b: Op): StrengthRewrite {
  let o: Op[] = [a, b];
  return StrengthRewrite { ok: true, ops: o };
}

function log2_i32(n: i32): i32 {
  if (n <= 0) {
    return 0 - 1;
  }
  if ((n & n - 1) != 0) {
    return 0 - 1;
  }
  let r: i32 = 0;
  let v: i32 = n;
  while (v > 1) {
    r = r + 1;
    v = v >> 1;
  }
  return r;
}

pub struct MagicS {
  m: i64,
  s: i32,
  add: boolean,
  sub: boolean,
}

pub struct MagicU {
  m: u64,
  s: i32,
  add: boolean,
}

function word_mask(w: i32): u64 {
  if (w >= 64) {
    return 0u64 - 1u64;
  }
  return (1u64 << w as u64) - 1u64;
}

pub function derive_magic_s(d: i64, w: i32): MagicS {
  let mask: u64 = word_mask(w);
  let ad: u64 = d as u64 & mask;
  if (d < 0i64) {
    ad = (0i64 - d) as u64 & mask;
  }
  let two: u64 = 1u64 << (w - 1) as u64;
  let t: u64 = two + ((d as u64 & mask) >> (w - 1) as u64);
  let anc: u64 = t - 1u64 - t % ad;
  let p: i32 = w - 1;
  let q1: u64 = two / anc;
  let r1: u64 = two - q1 * anc;
  let q2: u64 = two / ad;
  let r2: u64 = two - q2 * ad;
  let searching: boolean = true;
  while (searching) {
    p = p + 1;
    q1 = q1 * 2u64 & mask;
    r1 = r1 * 2u64 & mask;
    if (r1 >= anc) {
      q1 = q1 + 1u64 & mask;
      r1 = r1 - anc;
    }
    q2 = q2 * 2u64 & mask;
    r2 = r2 * 2u64 & mask;
    if (r2 >= ad) {
      q2 = q2 + 1u64 & mask;
      r2 = r2 - ad;
    }
    let delta: u64 = ad - r2;
    if (q1 > delta || q1 == delta && r1 != 0u64) {
      searching = false;
    }
  }
  let mu: u64 = q2 + 1u64 & mask;
  if (d < 0i64) {
    mu = 0u64 - mu & mask;
  }
  let m: i64 = mu as i64;
  if (w < 64 && mu >= two) {
    m = mu as i64 - (mask as i64 + 1i64);
  }
  return MagicS { m: m, s: p - w, add: d > 0i64 && m < 0i64, sub: d < 0i64 && m > 0i64 };
}

pub function derive_magic_u(d: u64, w: i32): MagicU {
  return derive_magic_u_below(d, w, 0);
}

pub function derive_magic_u_below(d: u64, w: i32, lz: i32): MagicU {
  let mask: u64 = word_mask(w);
  let two: u64 = 1u64 << (w - 1) as u64;
  let top: u64 = mask >> lz as u64;
  let nc: u64 = top - (top + 1u64 - d & mask) % d;
  let p: i32 = w - 1;
  let q1: u64 = two / nc;
  let r1: u64 = two - q1 * nc;
  let q2: u64 = (two - 1u64) / d;
  let r2: u64 = two - 1u64 - q2 * d;
  let add: boolean = false;
  let searching: boolean = true;
  while (searching) {
    p = p + 1;
    if (r1 >= nc - r1) {
      q1 = q1 * 2u64 + 1u64 & mask;
      r1 = r1 * 2u64 - nc & mask;
    } else {
      q1 = q1 * 2u64 & mask;
      r1 = r1 * 2u64 & mask;
    }
    if (r2 + 1u64 >= d - r2) {
      if (q2 >= two - 1u64) {
        add = true;
      }
      q2 = q2 * 2u64 + 1u64 & mask;
      r2 = r2 * 2u64 + 1u64 - d & mask;
    } else {
      if (q2 >= two) {
        add = true;
      }
      q2 = q2 * 2u64 & mask;
      r2 = r2 * 2u64 + 1u64 & mask;
    }
    let delta: u64 = d - 1u64 - r2;
    if (p >= 2 * w || q1 > delta || q1 == delta && r1 != 0u64) {
      searching = false;
    }
  }
  return MagicU { m: q2 + 1u64 & mask, s: p - w, add: add };
}

struct StrengthKinds { mul: i32, add: i32, sub: i32, or: i32, xor: i32, shl: i32, shr_s: i32, shr_u: i32, and: i32, div_s: i32, div_u: i32, rem_s: i32, rem_u: i32 }

function strength_kinds(): StrengthKinds {
  return StrengthKinds { mul: K_MUL, add: K_ADD, sub: K_SUB, or: K_OR, xor: K_XOR, shl: K_SHL, shr_s: K_SHR_S, shr_u: K_SHR_U, and: K_AND, div_s: K_DIV_S, div_u: K_DIV_U, rem_s: K_REM_S, rem_u: K_REM_U };
}

function strength_rewrite(ks: StrengthKinds, k: i32, bop: Op): StrengthRewrite {
  let t: i32 = bop.kind_tag;
  if (t == ks.mul) {
    if (k == 1) {
      return strength_del();
    }
    if (k == 0) {
      return strength_drop0();
    }
    let n: i32 = log2_i32(k);
    if (n > 0) {
      return strength_pair(op_const_i32(n), op_bin("shl", 0, false));
    }
    return strength_none();
  }
  if (t == ks.add || t == ks.sub || t == ks.or || t == ks.xor || t == ks.shl || t == ks.shr_s || t == ks.shr_u) {
    if (k == 0) {
      return strength_del();
    }
    return strength_none();
  }
  if (t == ks.and) {
    if (k == 0) {
      return strength_drop0();
    }
    if (k == 0 - 1) {
      return strength_del();
    }
    return strength_none();
  }
  if (t == ks.div_s) {
    if (k == 1) {
      return strength_del();
    }
    return strength_none();
  }
  if (t == ks.div_u) {
    if (k == 1) {
      return strength_del();
    }
    let nd: i32 = log2_i32(k);
    if (nd > 0) {
      return strength_pair(op_const_i32(nd), op_bin("shr_u", 0, false));
    }
    return strength_none();
  }
  if (t == ks.rem_s) {
    if (k == 1) {
      return strength_drop0();
    }
    return strength_none();
  }
  if (t == ks.rem_u) {
    if (k == 1) {
      return strength_drop0();
    }
    let nr: i32 = log2_i32(k);
    if (nr > 0) {
      return strength_pair(op_const_i32(k - 1), op_bin("and", 0, false));
    }
    return strength_none();
  }
  return strength_none();
}

pub function reduce_strength_ex(ops: Op[]): StrengthResult {
  let k_i32: i32 = K_CONST_I32;
  let k_i32_text: i32 = K_CONST_I32_TEXT;
  let ks: StrengthKinds = strength_kinds();
  let out: Op[] = [];
  let changed: boolean = false;
  let i: i32 = 0;
  while (i < ops.len()) {
    let kt: i32 = ops[i].kind_tag;
    if ((kt == k_i32 || kt == k_i32_text) && i + 1 < ops.len() && const_i32_readable(ops[i]) && ops[i + 1].width == 0) {
      let repl: StrengthRewrite = strength_rewrite(ks, const_i32_value(ops[i]), ops[i + 1]);
      if (repl.ok) {
        if (!changed) {
          out = fold_prefixed(ops, i, []);
        }
        let r: i32 = 0;
        while (r < repl.ops.len()) {
          out = out.append(repl.ops[r]);
          r = r + 1;
        }
        changed = true;
        i = i + 2;
        continue;
      }
    }
    if (changed) {
      out = out.append(ops[i]);
    }
    i = i + 1;
  }
  if (changed) {
    tv_dump("strength", ops, out);
    return StrengthResult { ops: out, changed: true };
  }
  return StrengthResult { ops: ops, changed: false };
}

function tv_dump(pass: string, before: Op[], after: Op[]): void {
  match (env("FERN_TV_DUMP")) {
    Some(want) => {
      if (want == pass) {
        eprint("fern-tv " + pass + "\n" + tv_ops("before", before) + tv_ops("after", after) + "fern-tv end");
      }
    },
    None => {}
  }
}

function tv_ops(side: string, ops: Op[]): string {
  let s: string = "fern-tv " + side + " " + util.i32_to_string(ops.len()) + "\n";
  let i: i32 = 0;
  while (i < ops.len()) {
    let o: Op = ops[i];
    let u: string = "0";
    if (o.unsigned) {
      u = "1";
    }
    s = s + kind_name(o.kind_tag) + " " + util.i32_to_string(o.kind_tag) + " " + util.i32_to_string(o.i32_imm) + " " + util.i64_to_string(o.i64_imm) + " " + util.i64_to_string(f64_bits(o.f64_imm)) + " " + util.i32_to_string(o.width) + " " + u + " " + util.i32_to_string(o.decl) + " :" + hex_text(o.str) + "\n";
    i = i + 1;
  }
  return s;
}

pub function reduce_strength(ops: Op[]): Op[] {
  return reduce_strength_ex(ops).ops;
}

pub function eliminate_dead_code(ops: Op[]): Op[] {
  let out: Op[] = [];
  let copying: boolean = false;
  let depth: i32 = 0;
  let dead: boolean = false;
  let dead_depth: i32 = 0;
  let k_block: i32 = K_BLOCK;
  let k_loop: i32 = K_LOOP;
  let k_if: i32 = K_IF;
  let k_else: i32 = K_ELSE;
  let k_end: i32 = K_END;
  let k_br: i32 = K_BR;
  let k_return: i32 = K_RETURN;
  let i: i32 = 0;
  while (i < ops.len()) {
    let t: i32 = ops[i].kind_tag;
    if (t == k_end || t == k_else) {
      if (dead && depth == dead_depth) {
        dead = false;
      }
    }
    if (!dead) {
      if (copying) {
        out = out.append(ops[i]);
      }
    } else if (!copying) {
      out = fold_prefixed(ops, i, []);
      copying = true;
    }
    if (t == k_block || t == k_loop || t == k_if) {
      depth = depth + 1;
    } else if (t == k_end) {
      depth = depth - 1;
    } else if (!dead && (t == k_return || t == k_br)) {
      dead = true;
      dead_depth = depth;
    }
    i = i + 1;
  }
  if (copying) {
    return out;
  }
  return ops;
}

pub function eliminate_dead_stores(ops: Op[]): Op[] {
  let cur: Op[] = ops;
  let loads: i32[] = slot_reads(ops);
  while (true) {
    let stored: Op[] = drop_dead_stores(cur, loads);
    let c: Cancelled = cancel_dropped_pushes(stored, loads);
    cur = c.ops;
    loads = c.loads;
    if (!c.emptied) {
      return cur;
    }
  }
  return cur;
}

function drop_dead_stores(ops: Op[], loads: i32[]): Op[] {
  let k_store: i32 = K_STORE_LOCAL;
  let k_tee: i32 = K_TEE_LOCAL;
  if (!writes_unread(ops, loads, k_store, k_tee)) {
    return ops;
  }
  let out: Op[] = [];
  for o in ops {
    if (o.kind_tag == k_tee && loads[o.i32_imm] == 0) {
      continue;
    }
    if (o.kind_tag == k_store && loads[o.i32_imm] == 0) {
      out = out.append(op_drop());
    } else {
      out = out.append(o);
    }
  }
  return out;
}

function writes_unread(ops: Op[], loads: i32[], k_store: i32, k_tee: i32): boolean {
  for o in ops {
    if ((o.kind_tag == k_store || o.kind_tag == k_tee) && loads[o.i32_imm] == 0) {
      return true;
    }
  }
  return false;
}

function slot_reads(ops: Op[]): i32[] {
  let k_load: i32 = K_LOAD_LOCAL;
  let k_dyn: i32 = K_DYN_DISPATCH;
  let loads: i32[] = __alloc_i32(cp_max_slot(ops) + 1);
  for o in ops {
    if (o.kind_tag == k_load) {
      loads = loads.with(o.i32_imm, loads[o.i32_imm] + 1);
    }
    if (frame_box_base(o) >= 0) {
      loads = slots_read(loads, frame_box_base(o), 3);
    }
    if (o.kind_tag == k_dyn) {
      loads = slots_read(loads, o.i32_imm, o.width);
    }
  }
  return loads;
}

function slots_read(own loads: i32[], first: i32, n: i32): i32[] {
  let s: i32 = first;
  while (s < first + n) {
    if (s >= 0 && s < loads.len()) {
      loads = loads.with(s, loads[s] + 1);
    }
    s = s + 1;
  }
  return loads;
}

struct Cancelled { ops: Op[], loads: i32[], emptied: boolean }

function cancel_dropped_pushes(ops: Op[], own loads: i32[]): Cancelled {
  let pushes: i32[] = [K_CONST_I32, K_CONST_I32_TEXT, K_CONST_I64, K_CONST_F64, K_CONST_STR, K_LOAD_LOCAL];
  let k_drop: i32 = K_DROP;
  let k_load: i32 = K_LOAD_LOCAL;
  let gone: boolean[] = __alloc_bool(ops.len());
  let kept: i32[] = __alloc_i32(ops.len());
  let top: i32 = 0;
  let any: boolean = false;
  let emptied: boolean = false;
  let i: i32 = 0;
  while (i < ops.len()) {
    let t: i32 = ops[i].kind_tag;
    if (t == k_drop && top > 0 && util.index_of_i32(pushes, ops[kept[top - 1]].kind_tag) >= 0) {
      top = top - 1;
      let pushed: Op = ops[kept[top]];
      if (pushed.kind_tag == k_load) {
        loads = loads.with(pushed.i32_imm, loads[pushed.i32_imm] - 1);
        emptied = emptied || loads[pushed.i32_imm] == 0;
      }
      gone = gone.with(kept[top], true).with(i, true);
      any = true;
    } else {
      kept = kept.with(top, i);
      top = top + 1;
    }
    i = i + 1;
  }
  if (!any) {
    return Cancelled { ops: ops, loads: loads, emptied: false };
  }
  let out: Op[] = [];
  i = 0;
  while (i < ops.len()) {
    if (!gone[i]) {
      out = out.append(ops[i]);
    }
    i = i + 1;
  }
  return Cancelled { ops: out, loads: loads, emptied: emptied };
}

function zg_mark(own first: i32[], sl: i32, at: i32): i32[] {
  if (sl < 0 || sl >= first.len()) {
    return first;
  }
  if (first[sl] <= at) {
    return first;
  }
  return first.with(sl, at);
}

function zg_rezero(ops: Op[], i: i32): boolean {
  if (i == 0) {
    return false;
  }
  if (!const_i32_readable(ops[i - 1])) {
    return false;
  }
  return const_i32_value(ops[i - 1]) == 0;
}

function zg_first_write(ops: Op[], nslots: i32): i32[] {
  let k_store: i32 = K_STORE_LOCAL;
  let k_tee: i32 = K_TEE_LOCAL;
  let first: i32[] = __alloc_i32(nslots);
  let z: i32 = 0;
  while (z < nslots) {
    first = first.with(z, ops.len());
    z = z + 1;
  }
  let i: i32 = 0;
  while (i < ops.len()) {
    let t: i32 = ops[i].kind_tag;
    if ((t == k_store || t == k_tee) && !zg_rezero(ops, i)) {
      first = zg_mark(first, ops[i].i32_imm, i);
    } else if (frame_box_base(ops[i]) >= 0) {
      let fk: i32 = 0;
      while (fk < 3) {
        first = zg_mark(first, frame_box_base(ops[i]) + fk, i);
        fk = fk + 1;
      }
    }
    i = i + 1;
  }
  return first;
}

function zg_in_loop(ops: Op[]): boolean[] {
  let k_block: i32 = K_BLOCK;
  let k_loop: i32 = K_LOOP;
  let k_if: i32 = K_IF;
  let k_end: i32 = K_END;
  let marks: boolean[] = __alloc_bool(ops.len());
  let depth: i32 = 0;
  let loop_at: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < ops.len()) {
    let t: i32 = ops[i].kind_tag;
    if (t == k_block || t == k_if) {
      depth = depth + 1;
    } else if (t == k_loop) {
      if (loop_at < 0) {
        loop_at = depth;
      }
      depth = depth + 1;
    } else if (t == k_end && depth > 0) {
      depth = depth - 1;
      if (depth == loop_at) {
        loop_at = 0 - 1;
      }
    }
    if (loop_at >= 0) {
      marks = marks.with(i, true);
    }
    i = i + 1;
  }
  return marks;
}

function zg_zero_guard(ops: Op[], i: i32, n_params: i32, first: i32[], k_call: i32): boolean {
  if (i + 1 >= ops.len()) {
    return false;
  }
  if (ops[i + 1].kind_tag != k_call || ops[i + 1].str != "__fern_rc_is_unique") {
    return false;
  }
  let sl: i32 = ops[i].i32_imm;
  if (sl < n_params || sl >= first.len()) {
    return false;
  }
  return first[sl] > i;
}

pub function prune_zero_slot_guards(ops: Op[], n_params: i32): Op[] {
  let maxs: i32 = cp_max_slot(ops);
  if (maxs < n_params) {
    return ops;
  }
  let first: i32[] = zg_first_write(ops, maxs + 1);
  let in_loop: boolean[] = zg_in_loop(ops);
  let k_load: i32 = K_LOAD_LOCAL;
  let k_call: i32 = K_CALL_DIRECT;
  let out: Op[] = [];
  let copying: boolean = false;
  let i: i32 = 0;
  while (i < ops.len()) {
    if (ops[i].kind_tag == k_load && !in_loop[i]
      && zg_zero_guard(ops, i, n_params, first, k_call)) {
      if (!copying) {
        out = fold_prefixed(ops, i, []);
        copying = true;
      }
      out = out.append(op_const_i32(0));
      i = i + 2;
    } else {
      if (copying) {
        out = out.append(ops[i]);
      }
      i = i + 1;
    }
  }
  if (copying) {
    return out;
  }
  return ops;
}

pub struct OptimizedOps {
  ops: Op[],
  n_locals: i32,
}

function finish_ops(cur: Op[], n_locals: i32): OptimizedOps {
  let done: Op[] = cleanup(fuse_tee(eliminate_dead_code(cur)));
  let again: StrengthResult = reduce_strength_ex(done);
  if (again.changed) {
    done = cleanup(strength_fixpoint(fold_const_binaries(again.ops)));
  }
  return hoist_loop_invariants(done, n_locals);
}

function cleanup(ops: Op[]): Op[] {
  return eliminate_dead_code(eliminate_dead_stores(propagate_fold(ops)));
}

function propagate_fold(ops: Op[]): Op[] {
  let cur: Op[] = propagate_copies(const_propagate(ops));
  let folded: Op[] = fold_const_binaries(cur);
  while (folded.len() < cur.len()) {
    cur = propagate_copies(const_propagate(folded));
    folded = fold_const_binaries(cur);
  }
  return folded;
}

function strength_fixpoint(ops: Op[]): Op[] {
  let cur: Op[] = ops;
  let rounds: i32 = 0;
  while (rounds < 8) {
    let r: StrengthResult = reduce_strength_ex(cur);
    if (!r.changed) {
      return cur;
    }
    cur = fold_const_binaries(r.ops);
    rounds = rounds + 1;
  }
  return cur;
}

pub function optimize_ops(ops: Op[], n_params: i32, n_locals: i32): OptimizedOps {
  return finish_ops(strength_fixpoint(fold_const_binaries(prune_zero_slot_guards(ops, n_params))), n_locals);
}

pub function hoist_loop_invariants(ops: Op[], n_locals: i32): OptimizedOps {
  let k_loop: i32 = K_LOOP;
  let cur: OptimizedOps = OptimizedOps { ops: ops, n_locals: n_locals };
  let maxs: i32 = cp_max_slot(ops);
  let stored: i32[] = __alloc_i32(maxs + 1);
  let i: i32 = ops.len() - 1;
  while (i >= 0) {
    if (cur.ops[i].kind_tag == k_loop) {
      let h: Hoisted = licm_hoist_from_loop(cur, i, maxs, stored);
      cur = h.cur;
      stored = h.stored;
      if (cur.n_locals - 1 > maxs) {
        maxs = cur.n_locals - 1;
        while (stored.len() <= maxs) {
          stored = stored.append(0);
        }
      }
    }
    i = i - 1;
  }
  return cur;
}

struct Hoisted { cur: OptimizedOps, stored: i32[] }

function licm_hoist_from_loop(cur: OptimizedOps, loop_idx: i32, maxs: i32, own stored: i32[]): Hoisted {
  let ops: Op[] = cur.ops;
  let end: i32 = licm_scope_end(ops, loop_idx);
  if (end < 0) {
    return Hoisted { cur: cur, stored: stored };
  }
  let hdr_end: i32 = licm_header_end(ops, loop_idx);
  let mark: i32 = loop_idx + 1;
  stored = licm_stored_locals(ops, loop_idx + 1, end, stored, mark);
  let order: i32[] = licm_candidates(ops, loop_idx, hdr_end, stored, mark);
  if (order.len() == 0) {
    return Hoisted { cur: cur, stored: stored };
  }
  let slot_for: i32[] = util.minus_ones(maxs + 1);
  let pre: Op[] = [];
  let n: i32 = 0;
  while (n < order.len()) {
    slot_for = slot_for.with(order[n], cur.n_locals + n);
    pre = pre.append(op_load_local(order[n]));
    pre = pre.append(op_str_len());
    pre = pre.append(op_store_local(cur.n_locals + n));
    n = n + 1;
  }
  let data_for: i32[] = licm_data_slots(ops, loop_idx, end, slot_for, cur.n_locals + n);
  let slots: i32 = n;
  let d: i32 = 0;
  while (d < data_for.len()) {
    if (data_for[d] >= 0) {
      pre = pre.append(op_load_local(d));
      pre = pre.append(op_str_data());
      pre = pre.append(op_store_local(data_for[d]));
      slots = slots + 1;
    }
    d = d + 1;
  }
  let out: Op[] = [];
  let j: i32 = 0;
  while (j < loop_idx) {
    out = out.append(ops[j]);
    j = j + 1;
  }
  let p: i32 = 0;
  while (p < pre.len()) {
    out = out.append(pre[p]);
    p = p + 1;
  }
  out = out.append(ops[loop_idx]);
  let k_load: i32 = K_LOAD_LOCAL;
  let k_len: i32 = K_STR_LEN;
  let k_data: i32 = K_STR_DATA;
  j = loop_idx + 1;
  while (j < ops.len()) {
    let slot: i32 = 0 - 1;
    if (j + 1 < end && ops[j].kind_tag == k_load) {
      let src: i32 = ops[j].i32_imm;
      if (j + 1 < hdr_end && ops[j + 1].kind_tag == k_len) {
        slot = slot_for[src];
      } else if (ops[j + 1].kind_tag == k_data && src < data_for.len()) {
        slot = data_for[src];
      }
    }
    if (slot >= 0) {
      out = out.append(op_load_local(slot));
      j = j + 2;
    } else {
      out = out.append(ops[j]);
      j = j + 1;
    }
  }
  return Hoisted { cur: OptimizedOps { ops: out, n_locals: cur.n_locals + slots }, stored: stored };
}

function licm_data_slots(ops: Op[], loop_idx: i32, end: i32, slot_for: i32[], next: i32): i32[] {
  let k_load: i32 = K_LOAD_LOCAL;
  let k_data: i32 = K_STR_DATA;
  let out: i32[] = util.minus_ones(slot_for.len());
  let j: i32 = loop_idx + 1;
  while (j + 1 < end) {
    if (ops[j].kind_tag == k_load && ops[j + 1].kind_tag == k_data) {
      let src: i32 = ops[j].i32_imm;
      if (src < slot_for.len() && slot_for[src] >= 0 && out[src] < 0) {
        out = out.with(src, next);
        next = next + 1;
      }
    }
    j = j + 1;
  }
  return out;
}

function licm_candidates(ops: Op[], loop_idx: i32, hdr_end: i32, stored: i32[], mark: i32): i32[] {
  let k_load: i32 = K_LOAD_LOCAL;
  let k_len: i32 = K_STR_LEN;
  let order: i32[] = [];
  let j: i32 = loop_idx + 1;
  while (j + 1 < hdr_end) {
    if (ops[j].kind_tag == k_load && ops[j + 1].kind_tag == k_len) {
      let src: i32 = ops[j].i32_imm;
      if (stored[src] != mark && !licm_listed(order, src)) {
        order = order.append(src);
      }
    }
    j = j + 1;
  }
  return order;
}

function licm_listed(order: i32[], src: i32): boolean {
  let i: i32 = 0;
  while (i < order.len()) {
    if (order[i] == src) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

function licm_header_end(ops: Op[], loop_idx: i32): i32 {
  let k_brif: i32 = K_BRIF;
  let k_if: i32 = K_IF;
  let k_else: i32 = K_ELSE;
  let k_loop: i32 = K_LOOP;
  let k_end: i32 = K_END;
  let k_return: i32 = K_RETURN;
  let k_br: i32 = K_BR;
  let k_exit: i32 = K_EXIT;
  let j: i32 = loop_idx + 1;
  while (j < ops.len()) {
    let t: i32 = ops[j].kind_tag;
    if (t == k_return || t == k_br || t == k_exit || t == k_brif || t == k_if || t == k_else
      || t == k_loop || t == k_end) {
      return j;
    }
    j = j + 1;
  }
  return j;
}

function licm_scope_end(ops: Op[], open: i32): i32 {
  let k_block: i32 = K_BLOCK;
  let k_loop: i32 = K_LOOP;
  let k_if: i32 = K_IF;
  let k_end: i32 = K_END;
  let depth: i32 = 0;
  let j: i32 = open;
  while (j < ops.len()) {
    let t: i32 = ops[j].kind_tag;
    if (t == k_block || t == k_loop || t == k_if) {
      depth = depth + 1;
    } else if (t == k_end) {
      depth = depth - 1;
      if (depth == 0) {
        return j;
      }
    }
    j = j + 1;
  }
  return 0 - 1;
}

function licm_stored_locals(ops: Op[], lo: i32, hi: i32, own stored: i32[], mark: i32): i32[] {
  let k_store: i32 = K_STORE_LOCAL;
  let k_tee: i32 = K_TEE_LOCAL;
  let j: i32 = lo;
  while (j < hi) {
    let t: i32 = ops[j].kind_tag;
    if (t == k_store || t == k_tee) {
      stored = stored.with(ops[j].i32_imm, mark);
    }
    j = j + 1;
  }
  return stored;
}

function cp_max_slot(ops: Op[]): i32 {
  let k_load: i32 = K_LOAD_LOCAL;
  let k_store: i32 = K_STORE_LOCAL;
  let k_tee: i32 = K_TEE_LOCAL;
  let maxs: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < ops.len()) {
    let kt: i32 = ops[i].kind_tag;
    if (kt == k_load || kt == k_store || kt == k_tee) {
      if (ops[i].i32_imm > maxs) {
        maxs = ops[i].i32_imm;
      }
    }
    i = i + 1;
  }
  return maxs;
}

function cp_kill_after(own has: boolean[], wrote: i32[], at: i32, bound: i32[]): boolean[] {
  let k: i32 = 0;
  while (k < bound.len()) {
    let s: i32 = bound[k];
    if (has[s] && wrote[s] > at) {
      has = has.with(s, false);
    }
    k = k + 1;
  }
  return has;
}

function cp_still_bound(bound: i32[], has: boolean[]): i32[] {
  let out: i32[] = [];
  let k: i32 = 0;
  while (k < bound.len()) {
    if (has[bound[k]]) {
      out = out.append(bound[k]);
    }
    k = k + 1;
  }
  return out;
}

function cp_loop_body_kill(ops: Op[], at: i32, own has: boolean[]): boolean[] {
  let k_store: i32 = K_STORE_LOCAL;
  let k_tee: i32 = K_TEE_LOCAL;
  let k_block: i32 = K_BLOCK;
  let k_loop: i32 = K_LOOP;
  let k_if: i32 = K_IF;
  let k_end: i32 = K_END;
  let d: i32 = 0;
  let j: i32 = at + 1;
  while (j < ops.len()) {
    let t: i32 = ops[j].kind_tag;
    if (t == k_block || t == k_loop || t == k_if) {
      d = d + 1;
    } else if (t == k_end) {
      if (d == 0) {
        return has;
      }
      d = d - 1;
    } else if (t == k_store || t == k_tee) {
      let sl: i32 = ops[j].i32_imm;
      if (sl >= 0 && sl < has.len()) {
        has = has.with(sl, false);
      }
    } else if (frame_box_base(ops[j]) >= 0) {
      let fb: i32 = frame_box_base(ops[j]);
      let fk: i32 = 0;
      while (fk < 3) {
        if (fb + fk >= 0 && fb + fk < has.len()) {
          has = has.with(fb + fk, false);
        }
        fk = fk + 1;
      }
    }
    j = j + 1;
  }
  return has;
}

pub function const_propagate(ops: Op[]): Op[] {
  let maxs: i32 = cp_max_slot(ops);
  if (maxs < 0) {
    return ops;
  }
  let nslots: i32 = maxs + 1;

  let k_load: i32 = K_LOAD_LOCAL;
  let k_store: i32 = K_STORE_LOCAL;
  let k_tee: i32 = K_TEE_LOCAL;
  let k_block: i32 = K_BLOCK;
  let k_loop: i32 = K_LOOP;
  let k_if: i32 = K_IF;
  let k_else: i32 = K_ELSE;
  let k_end: i32 = K_END;
  let k_br: i32 = K_BR;
  let k_brif: i32 = K_BRIF;

  let known: Op[] = [];
  let zero: Op = op_const_i32(0);
  let has: boolean[] = __alloc_bool(nslots);
  let wrote: i32[] = util.minus_ones(nslots);
  let bound: i32[] = [];
  let z: i32 = 0;
  while (z < nslots) {
    known = known.append(zero);
    z = z + 1;
  }

  let fr_kind: i32[] = [];
  let fr_at: i32[] = [];
  let fr_wc: i32[] = [];
  let fr_br: boolean[] = [];
  let depth: i32 = 0;
  let wc: i32 = 0;

  let out: Op[] = [];
  let copying: boolean = false;
  let i: i32 = 0;
  while (i < ops.len()) {
    let o: Op = ops[i];
    let kt: i32 = o.kind_tag;
    let emit: Op = o;
    if (kt == k_block || kt == k_loop || kt == k_if) {
      if (depth < fr_kind.len()) {
        fr_kind = fr_kind.with(depth, kt);
        fr_at = fr_at.with(depth, i);
        fr_wc = fr_wc.with(depth, wc);
        fr_br = fr_br.with(depth, false);
      } else {
        fr_kind = fr_kind.append(kt);
        fr_at = fr_at.append(i);
        fr_wc = fr_wc.append(wc);
        fr_br = fr_br.append(false);
      }
      depth = depth + 1;
      if (kt == k_loop) {
        has = cp_loop_body_kill(ops, i, has);
      }
    } else if (kt == k_else) {
      if (depth > 0 && fr_kind[depth - 1] == k_if && wc != fr_wc[depth - 1]) {
        has = cp_kill_after(has, wrote, fr_at[depth - 1], bound);
        bound = cp_still_bound(bound, has);
      }
    } else if (kt == k_end) {
      if (depth > 0) {
        let straight: boolean = fr_kind[depth - 1] == k_block && !fr_br[depth - 1];
        if (!straight && wc != fr_wc[depth - 1]) {
          has = cp_kill_after(has, wrote, fr_at[depth - 1], bound);
          bound = cp_still_bound(bound, has);
        }
        depth = depth - 1;
      }
    } else if (kt == k_br || kt == k_brif) {
      let tgt: i32 = depth - 1 - o.i32_imm;
      if (o.i32_imm >= 0 && tgt >= 0) {
        fr_br = fr_br.with(tgt, true);
      }
    } else if (frame_box_base(o) >= 0) {
      let fb: i32 = frame_box_base(o);
      let fk: i32 = 0;
      while (fk < 3) {
        let fs: i32 = fb + fk;
        if (fs >= 0 && fs < nslots) {
          wrote = wrote.with(fs, i);
          wc = wc + 1;
          if (has[fs]) {
            has = has.with(fs, false);
          }
        }
        fk = fk + 1;
      }
    } else if (kt == k_store || kt == k_tee) {
      let sl: i32 = o.i32_imm;
      if (sl >= 0 && sl < nslots) {
        wrote = wrote.with(sl, i);
        wc = wc + 1;
        let prev: Op = cp_prev(ops, out, copying, i);
        if (const_i32_readable(prev) || const_i64_readable(prev)) {
          known = known.with(sl, prev);
          if (!has[sl]) {
            bound = bound.append(sl);
          }
          has = has.with(sl, true);
        } else if (has[sl]) {
          has = has.with(sl, false);
        }
      }
    } else if (kt == k_load && o.i32_imm >= 0 && o.i32_imm < nslots && has[o.i32_imm]) {
      emit = known[o.i32_imm];
      if (!copying) {
        out = fold_prefixed(ops, i, []);
        copying = true;
      }
    }
    if (copying) {
      out = out.append(emit);
    }
    i = i + 1;
  }
  if (copying) {
    return out;
  }
  return ops;
}

function cp_prev(ops: Op[], out: Op[], copying: boolean, i: i32): Op {
  if (i == 0) {
    return op_drop();
  }
  if (copying) {
    return out[out.len() - 1];
  }
  return ops[i - 1];
}

pub function propagate_copies(ops: Op[]): Op[] {
  let k_load: i32 = K_LOAD_LOCAL;
  let k_store: i32 = K_STORE_LOCAL;
  let k_tee: i32 = K_TEE_LOCAL;
  let maxs: i32 = 0 - 1;
  let i: i32 = 0;
  while (i < ops.len()) {
    let kt: i32 = ops[i].kind_tag;
    if (kt == k_load || kt == k_store || kt == k_tee) {
      if (ops[i].i32_imm > maxs) {
        maxs = ops[i].i32_imm;
      }
    }
    i = i + 1;
  }
  if (maxs < 0) {
    return ops;
  }
  let reads: i32[] = __alloc_i32(maxs + 1);
  let stores: i32[] = __alloc_i32(maxs + 1);
  let tees: i32[] = __alloc_i32(maxs + 1);
  i = 0;
  while (i < ops.len()) {
    let kt2: i32 = ops[i].kind_tag;
    let sl: i32 = ops[i].i32_imm;
    if (sl >= 0 && sl <= maxs) {
      if (kt2 == k_load) {
        reads = reads.with(sl, reads[sl] + 1);
      } else if (kt2 == k_store) {
        stores = stores.with(sl, stores[sl] + 1);
      } else if (kt2 == k_tee) {
        tees = tees.with(sl, tees[sl] + 1);
      }
    }
    i = i + 1;
  }
  let out: Op[] = [];
  let copying: boolean = false;
  i = 0;
  while (i < ops.len()) {
    let dead_tee: boolean = false;
    let sl2: i32 = ops[i].i32_imm;
    if (ops[i].kind_tag == k_tee && sl2 >= 0 && sl2 <= maxs) {
      dead_tee = reads[sl2] == 0 && stores[sl2] == 0 && tees[sl2] == 1;
    }
    if (!dead_tee) {
      if (copying) {
        out = out.append(ops[i]);
      }
    } else if (!copying) {
      out = fold_prefixed(ops, i, []);
      copying = true;
    }
    i = i + 1;
  }
  if (copying) {
    return out;
  }
  return ops;
}

pub function fuse_tee(ops: Op[]): Op[] {
  let k_store: i32 = K_STORE_LOCAL;
  let k_load: i32 = K_LOAD_LOCAL;
  let out: Op[] = [];
  let copying: boolean = false;
  let i: i32 = 0;
  while (i < ops.len()) {
    if (i + 1 < ops.len()
      && ops[i].kind_tag == k_store
      && ops[i + 1].kind_tag == k_load
      && ops[i].i32_imm == ops[i + 1].i32_imm) {
      if (!copying) {
        out = fold_prefixed(ops, i, []);
        copying = true;
      }
      out = out.append(op_tee_local(ops[i].i32_imm));
      i = i + 2;
    } else {
      if (copying) {
        out = out.append(ops[i]);
      }
      i = i + 1;
    }
  }
  if (copying) {
    return out;
  }
  return ops;
}

pub function is_commutative_kind(id: i32): boolean {
  return id == K_ADD || id == K_MUL
    || id == K_AND || id == K_OR || id == K_XOR
    || id == K_EQ || id == K_NE;
}

pub function render_op(o: Op): string {
  if (o.kind_tag == 1) {
    return "const_i32 " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 2) {
    return "const_i32_text " + o.str;
  }
  if (o.kind_tag == 3) {
    return "const_i64 " + o.str;
  }
  if (o.kind_tag == 7) {
    return "int_extend";
  }
  if (o.kind_tag == 8) {
    return "int_wrap";
  }
  if (o.kind_tag == 5) {
    return "const_str " + o.str;
  }
  if (o.kind_tag == 18) {
    return "load_local " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 19) {
    return "store_local " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 20) {
    return "tee_local " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 149) {
    return "call_direct " + o.str + "/" + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 157) {
    return "br " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 158) {
    return "brif " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 67) {
    return "load w" + util.i32_to_string(o.width);
  }
  if (o.kind_tag == 68) {
    return "store w" + util.i32_to_string(o.width);
  }
  if (o.kind_tag == 87) {
    return "arr_make " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 97) {
    return "str_len";
  }
  if (o.kind_tag == 98) {
    return "str_concat";
  }
  if (o.kind_tag == 99) {
    return "str_eq";
  }
  if (o.kind_tag == 100) {
    return "str_cmp";
  }
  if (o.kind_tag == 101) {
    return "str_index";
  }
  if (o.kind_tag == 102) {
    if (o.i32_imm > 0) {
      return "str_slice frame:" + util.i32_to_string(o.i32_imm - 1);
    }
    return "str_slice";
  }
  if (o.kind_tag == 86 && o.i32_imm > 0) {
    return "raw_string frame:" + util.i32_to_string(o.i32_imm - 1);
  }
  if (o.kind_tag == 96) {
    return "arr_slice";
  }
  if (o.kind_tag == 120) {
    return "opt_make " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 122) {
    return "opt_tag";
  }
  if (o.kind_tag == 123) {
    return "opt_payload";
  }
  if (o.kind_tag == 124) {
    return "opt_set_payload";
  }
  if (o.kind_tag == 138) {
    return "struct_make " + o.str + "/" + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 139) {
    return "struct_get " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 140) {
    return "struct_set " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 145) {
    return "variant_is " + o.str;
  }
  if (o.kind_tag == 218) {
    let cfb: string = const_struct_fn_body(o.str);
    if (cfb.len() > 0) {
      return "const_closure " + cfb;
    }
    return "const_struct " + const_struct_type(o.str) + "/" + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 142) {
    return "tuple_make " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 143) {
    return "tuple_get " + util.i32_to_string(o.i32_imm);
  }
  return kind_name(o.kind_tag);
}

pub function call_needs_heap(name: string): boolean {
  if (rtbytecopy.is_helper(name)) {
    return true;
  }
  if (name == "__fern_alloc_reuse" || name == "__fern_arr_dec") {
    return true;
  }
  if (name == "__fern_rc_inc" || name == "__fern_rc_dec" || name == "__fern_rc_is_unique") {
    return true;
  }
  if (name == "__fern_arr_share_inc" || name == "__fern_arr_share_dec") {
    return true;
  }
