  if (id == 347) {
    return "buf_take_bytes";
  }
  if (id == 351) {
    return "buf_push_bytes_range";
  }
  if (id == 359) {
    return "count_byte_bytes";
  }
  if (id == 358) {
    return "memchr_bytes";
  }
  if (id == 360) {
    return "rmemchr_bytes";
  }
  if (id == 361) {
    return "scan_set_bytes";
  }
  if (id == 362) {
    return "getxattr";
  }
  if (id == 363) {
    return "lgetxattr";
  }
  if (id == 379) {
    return "count_runs_bytes";
  }
  if (id == 378) {
    return "mismatch_bytes";
  }
  if (id == 364) {
    return "setxattr";
  }
  if (id == 365) {
    return "lsetxattr";
  }
  if (id <= 40) {
    return kind_name_0(id);
  }
  if (id <= 80) {
    return kind_name_1(id);
  }
  if (id <= 120) {
    return kind_name_2(id);
  }
  if (id <= 160) {
    return kind_name_3(id);
  }
  return kind_name_4(id);
}

function pops0(t: i32): boolean {
  return t == 1 || t == 2 || t == 3 || t == 4 || t == 5 || t == 6
    || t == 18
    || t == 385
    || t == 79 || t == 80 || t == 315
    || is_sha_hw_op(t)
    || t == 341
    || t == 229
    || t == 147
    || t == 152 || t == 153 || t == 155 || t == 156 || t == 157
    || t == 180
    || t == 182 || t == 183 || t == 184
    || t == 186
    || t == 207 || t == 211 || t == 408
    || t == 331
    || t == 287
    || t == 288
    || t == 367
    || t == 443
    || t == 216 || t == 217 || t == 218
    || t == 222
    || t == 238 || t == 239 || t == 240
    || t == 246 || t == 247 || t == 248 || t == 249
    || t == 251 || t == 252
    || t == 272 || t == 282
    || t == 389
    || t == 398
    || t == 396
    || t == 298;
}

function pops1_conv(t: i32): boolean {
  return t == 7 || t == 8 || t == 9 || t == 10 || t == 11 || t == 12 || t == 13
    || t == 14 || t == 15 || t == 16 || t == 17
    || t == 19 || t == 20
    || t == 34
    || t >= 55 && t <= 61
    || t == 219 || t == 220 || t == 221
    || t == 411;
}

function pops1_mem(t: i32): boolean {
  return t == 69 || t == 70 || t == 71
    || t == 76 || t == 77
    || t == 81 || t == 205 || t == 224 || t == 383
    || t == 90 || t == 91
    || t == 97 || t == 103 || t == 104 || t == 345
    || t == 253 || t == 368
    || t == 106 || t == 107 || t == 109
    || t == 113
    || t == 120 || t == 122 || t == 123
    || t == 139 || t == 141 || t == 143 || t == 145
    || t == 146;
}

function pops1_io(t: i32): boolean {
  return t == 154 || t == 158 || t == 159 || t == 160
    || t == 384
    || t == 434
    || t == 163 || t == 164 || t == 165 || t == 166
    || t == 169 || t == 233 || t == 171 || t == 172 || t == 173
    || t == 340
    || t == 310 || t == 391 || t == 432
    || t == 174 || t == 175 || t == 236 || t == 176 || t == 179 || t == 181
    || t == 266
    || t == 231 || t == 232
