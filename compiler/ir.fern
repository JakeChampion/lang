  if (t == 424 || t == 428) {
    return 3;
  }
  if (t == 426) {
    return 4;
  }
  if (t == 427) {
    return 5;
  }
  return 2;
}

pub function op_pops(o: Op): i32 {
  return pops_of(kind_pops(o.kind_tag), o);
}

pub function op_pops_by(by_kind: i32[], o: Op): i32 {
  let t = o.kind_tag;
  if (t < 0 || t >= by_kind.len()) {
    return op_pops(o);
  }
  return pops_of(by_kind[t], o);
}

pub function pops_by_kind(): i32[] {
  let out: i32[] = [];
  let t = 0;
  while (t < 1024) {
    out = out.append(kind_pops(t));
    t += 1;
  }
  return out;
}

function pops_of(fixed: i32, o: Op): i32 {
  if (fixed >= 0) {
    return fixed;
  }
  let t = o.kind_tag;
  if (t == 87 || t == 138 || t == 142 || t == 149) {
    return o.i32_imm;
  }
  if (t == 150) {
    return o.i32_imm + 1;
  }
  return -1;
}

function kind_pops(t: i32): i32 {
  if (t == K_ALLOC_UNINIT) {
    return 1;
  }
  if (t == K_VEXTRACT_BITS) {
    return 1;
  }
  if (t == K_VPACK || t == K_VPERMUTE) {
    return 2;
  }
  if (is_lane_kind(t)) {
    return lane_kind_pops()[t - LANE_KIND_FIRST];
  }
  let bufn = pops_buf(t);
  if (bufn >= 0) {
    return bufn;
  }
  if (t >= 420 && t <= 428) {
    return pops_dir(t);
  }
  if (is_privileged_kind(t)) {
    return privileged_pops(t);
  }
  if (pops0(t)) {
    return 0;
  }
  if (pops1_conv(t) || pops1_mem(t) || pops1_io(t)) {
    return 1;
  }
  if (pops2_arith(t) || pops2_mem(t) || pops2_io(t)) {
    return 2;
  }
  if (pops3(t)) {
    return 3;
  }
  if (t == 204) {
    return 4;
  }
  if (t == 332) {
    return 4;
  }
  if (t == 336 || t == 355 || t == 516) {
    return 4;
  }
  if (t == 342 || t == 435 || t == 437 || t == 439) {
    return 4;
  }
  if (t == 206) {
    return 5;
  }
  if (t == 245 || t == 378 || t == 446) {
    return 5;
  }
  if (t == 444 || t == 445) {
    return 9;
  }
  if (t == 228 || t == 382) {
    return 6;
  }
  if (t == 323) {
    return 7;
  }
  if (t == 269 || t == 498) {
    return 6;
  }
  if (t == 274) {
    return 4;
  }
  if (t == 275) {
    return 4;
  }
  if (t == 321) {
    return 3;
  }
  return -1;
}

pub function pure_value_op(o: Op): boolean {
  let t = o.kind_tag;
  if (t == 1 || t == 3 || t == 4 || t == 5 || t == 6 || t == 218 || t == 18) {
    return true;
  }
  if (t == 88 || t == 139 || t == 143 || t == 90 || t == 97 || t == 101) {
    return true;
  }
  if (t == 19 || t == 20) {
    return false;
  }
  return pops2_arith(t) || pops1_conv(t);
}

pub function op_pushes(o: Op): i32 {
  let t = o.kind_tag;
  if (t == 19 || t == 159 || lane_writes(t)) {
    return 0;
  }
  if (t == 288) {
    return 0;
  }
  if (t == 89 || t == 124 || t == 140 || t == 144) {
    return 0;
  }
  if (t == 152 || t == 153 || t == 154 || t == 155 || t == 156) {
    return 0;
  }
  if (t == 157 || t == 158 || t == 160) {
    return 0;
  }
  return 1;
}

pub function is_const_kind(id: i32): boolean {
  return id == K_CONST_I32 || id == K_CONST_I32_TEXT
    || id == K_CONST_I64 || id == K_CONST_F64
    || id == K_CONST_STR || id == K_CONST_FUNC;
}

pub function is_terminator_kind(id: i32): boolean {
  return id == K_RETURN || id == K_BR || id == K_EXIT;
}

pub function is_foldable_binary_kind(id: i32): boolean {
  return id == K_ADD || id == K_SUB || id == K_MUL
    || id == K_DIV_S || id == K_REM_S
    || id == K_AND || id == K_OR || id == K_XOR
    || id == K_SHL || id == K_SHR_S
    || id == K_EQ || id == K_NE
    || id == K_LT_S || id == K_LE_S
    || id == K_GT_S || id == K_GE_S;
}

struct IfSpan {
  else_at: i32,
  end_at: i32,
}

function scan_if_block(ops: Op[], if_at: i32): IfSpan {
  let k_block = K_BLOCK;
  let k_loop = K_LOOP;
  let k_if = K_IF;
  let k_else = K_ELSE;
  let k_end = K_END;
  let else_at: i32 = -1;
  let d = 0;
  let i = if_at + 1;
  while (i < ops.len()) {
    let t = ops[i].kind_tag;
    if (t == k_block || t == k_loop || t == k_if) {
      d += 1;
    } else if (t == k_end) {
      if (d == 0) {
        return IfSpan { else_at: else_at, end_at: i };
      }
      d -= 1;
    } else if (t == k_else && d == 0 && else_at < 0) {
      else_at = i;
    }
    i += 1;
  }
  return IfSpan { else_at: else_at, end_at: -1 };
}

function arm_escapes_scope(ops: Op[], lo: i32, hi: i32): boolean {
  let k_block = K_BLOCK;
  let k_loop = K_LOOP;
  let k_if = K_IF;
  let k_end = K_END;
  let k_br = K_BR;
  let k_brif = K_BRIF;
  let d = 0;
  let i = lo;
  while (i < hi) {
    let t = ops[i].kind_tag;
    if (t == k_block || t == k_loop || t == k_if) {
      d += 1;
    } else if (t == k_end) {
      if (d > 0) {
        d -= 1;
      }
    } else if (t == k_br || t == k_brif) {
      if (ops[i].i32_imm >= d) {
        return true;
      }
    }
    i += 1;
  }
  return false;
}

pub function fold_const_binaries(ops: Op[]): Op[] {
  let k_i32 = K_CONST_I32;
  let k_i32_text = K_CONST_I32_TEXT;
  let k_i64 = K_CONST_I64;
  let k_not = K_NOT;
  let k_if = K_IF;
  let k_brif = K_BRIF;
  let k_const_str = K_CONST_STR;
  let k_str_eq = K_STR_EQ;
  let k_const_f64 = K_CONST_F64;
  let k_fneg = K_FNEG;
  let cur = ops;
  let changed = true;
  while (changed) {
    changed = false;
    let out: Op[] = [];
    let copying = false;
    let i = 0;
    while (i < cur.len()) {
      let folded = false;
      let at = i;
      let kt = cur[i].kind_tag;
      if (kt != k_i32 && kt != k_i32_text && kt != k_i64 && kt != k_const_str && kt != k_const_f64) {
        if (copying) {
          out = out.append(cur[i]);
        }
        i += 1;
        continue;
      }
      let r32 = const_i32_readable(cur[i]);
      let r64 = const_i64_readable(cur[i]);
      if (i + 1 < cur.len() && cur[i].kind_tag == k_const_f64 && cur[i + 1].kind_tag == k_fneg) {
        out = out.append(op_const_f64(f64_from_bits(const_f64_bits(cur[i]) ^ 1i64 << 63)));
        i += 2;
        changed = true;
        folded = true;
      }
      if (r32 && i + 2 < cur.len()) {
        let b = cur[i + 1];
        let o = cur[i + 2];
        if (const_i32_readable(b)
          && is_foldable_binary_kind(o.kind_tag) && o.width == 0 && !o.unsigned
          && !fold_would_divide_by_zero(o.kind_tag, const_i32_value(b))) {
          out = out.append(op_const_i32(fold_binary_i32(o.kind_tag, const_i32_value(cur[i]), const_i32_value(b))));
          i += 3;
          changed = true;
          folded = true;
        }
      }
      if (!folded && i + 2 < cur.len() && r64 && const_i64_readable(cur[i + 1])) {
        match (fold_binary_i64(cur[i + 2], const_i64_value(cur[i]), const_i64_value(cur[i + 1]))) {
          Some(value) => {
            out = out.append(value);
            i += 3;
            changed = true;
            folded = true;
          },
          None => {}
        }
      }
      if (!folded && i + 1 < cur.len() && r32
        && cur[i + 1].kind_tag == 7 && cur[i + 1].width == 64) {
        let xv = const_i32_value(cur[i]) as i64;
        if (cur[i + 1].unsigned) {
          xv = xv & 4294967295i64;
        }
        out = out.append(op_const_i64_text(util.i64_to_string(xv)));
        i += 2;
        changed = true;
        folded = true;
      }
      if (!folded && i + 1 < cur.len() && r64
        && cur[i + 1].kind_tag == 8 && cur[i + 1].width == 0
        && (!cur[i + 1].unsigned || const_i64_value(cur[i]) as i32 >= 0)) {
        out = out.append(op_const_i32(const_i64_value(cur[i]) as i32));
        i += 2;
        changed = true;
        folded = true;
      }
      if (!folded && i + 1 < cur.len()
        && r32 && cur[i + 1].kind_tag == k_not) {
        let nv = 0;
        if (const_i32_value(cur[i]) == 0) {
          nv = 1;
        }
        out = out.append(op_const_i32(nv));
        i += 2;
        changed = true;
        folded = true;
      }
      if (!folded && i + 2 < cur.len()
        && cur[i].kind_tag == k_const_str && cur[i + 1].kind_tag == k_const_str
        && cur[i + 2].kind_tag == k_str_eq) {
        let sv = 0;
        if (cur[i].str == cur[i + 1].str) {
          sv = 1;
        }
        out = out.append(op_const_i32(sv));
        i += 3;
        changed = true;
        folded = true;
      }
      if (!folded && i + 1 < cur.len() && r32) {
        match (fold_width_op(cur[i + 1], const_i32_value(cur[i]))) {
          Some(value) => {
            out = out.append(op_const_i32(value));
            i += 2;
            changed = true;
            folded = true;
          },
          None => {}
        }
      }
      if (!folded && i + 1 < cur.len() && r32
        && cur[i + 1].kind_tag == k_if && cur[i + 1].i32_imm == 0) {
        let span = scan_if_block(cur, i + 1);
        if (span.end_at >= 0) {
          let lo = i + 2;
          let hi = span.end_at;
          if (const_i32_value(cur[i]) != 0) {
            if (span.else_at >= 0) {
              hi = span.else_at;
            }
          } else if (span.else_at >= 0) {
            lo = span.else_at + 1;
          } else {
            lo = span.end_at;
          }
          let wrap = arm_escapes_scope(cur, lo, hi);
          if (wrap) {
            out = out.append(op_block(0));
          }
          let j = lo;
          while (j < hi) {
            out = out.append(cur[j]);
            j += 1;
          }
          if (wrap) {
            out = out.append(op_end());
          }
          i = span.end_at + 1;
          changed = true;
          folded = true;
        }
      }
      if (!folded && i + 1 < cur.len()
        && r32 && cur[i + 1].kind_tag == k_brif) {
        if (const_i32_value(cur[i]) != 0) {
          out = out.append(op_br(cur[i + 1].i32_imm));
        }
        i += 2;
        changed = true;
        folded = true;
      }
      if (!folded) {
        if (copying) {
          out = out.append(cur[i]);
        }
        i += 1;
      } else if (!copying) {
        out = fold_prefixed(cur, at, out);
        copying = true;
      }
    }
    if (copying) {
      cur = out;
    }
  }
  return cur;
}

function fold_prefixed(ops: Op[], at: i32, tail: Op[]): Op[] {
  let out: Op[] = [];
  let j = 0;
  while (j < at) {
    out = out.append(ops[j]);
    j += 1;
  }
  j = 0;
  while (j < tail.len()) {
    out = out.append(tail[j]);
    j += 1;
  }
  return out;
}

pub function const_i32_readable(o: Op): boolean {
  if (o.kind_tag == K_CONST_I32) {
    return o.str.len() == 0;
  }
  if (o.kind_tag != K_CONST_I32_TEXT) {
    return false;
  }
  return util.is_decimal_i32(o.str);
}

pub function const_i64_readable(o: Op): boolean {
  return o.kind_tag == K_CONST_I64 && util.is_decimal_i64(o.str);
}

pub function const_i64_value(o: Op): i64 {
  return util.digits_to_i64(o.str);
}

pub function const_i32_value(o: Op): i32 {
  if (o.kind_tag == K_CONST_I32) {
    return o.i32_imm;
  }
  return util.digits_to_i32(o.str);
}

function fold_width_op(o: Op, v: i32): Option[i32] {
  if (o.kind_tag == K_U32_WRAP) {
    if (v < 0) {
      return None;
    }
    return Some(v);
  }
  if (o.kind_tag != K_INT_CAST) {
    return None;
  }
  if (o.str == "i32") {
    return Some(v);
  }
  if (o.str == "u8") {
    return Some(v & 255);
  }
  if (o.str == "u32" && v >= 0) {
    return Some(v);
  }
  return None;
}

function fold_would_divide_by_zero(k: i32, rhs: i32): boolean {
  if (rhs != 0) {
    return false;
  }
  return k == K_DIV_S || k == K_REM_S;
}

function fold_binary_i32(k: i32, a: i32, b: i32): i32 {
  if (k == K_ADD) {
    return a + b;
  }
  if (k == K_SUB) {
    return a - b;
  }
  if (k == K_MUL) {
    return a * b;
  }
  if (k == K_DIV_S) {
    return a / b;
  }
  if (k == K_REM_S) {
    return a % b;
  }
  if (k == K_AND) {
    return a & b;
  }
  if (k == K_OR) {
    return a | b;
  }
  if (k == K_XOR) {
    return a ^ b;
  }
  if (k == K_SHL) {
    return a << b;
  }
  if (k == K_SHR_S) {
    return a >> b;
  }
  if (k == K_EQ) {
    if (a == b) {
      return 1;
    }
    return 0;
  }
  if (k == K_NE) {
    if (a != b) {
      return 1;
    }
    return 0;
  }
  if (k == K_LT_S) {
    if (a < b) {
      return 1;
    }
    return 0;
  }
  if (k == K_LE_S) {
    if (a <= b) {
      return 1;
    }
    return 0;
  }
  if (k == K_GT_S) {
    if (a > b) {
      return 1;
    }
    return 0;
  }
  if (k == K_GE_S) {
    if (a >= b) {
      return 1;
    }
    return 0;
  }
  return 0;
}

function fold_binary_i64(o: Op, a: i64, b: i64): Option[Op] {
  if (o.width != 64) {
    return None;
  }
  let k = o.kind_tag;
  if (k == K_ADD) {
    return Some(op_const_i64_text(util.i64_to_string(a + b)));
  }
  if (k == K_SUB) {
    return Some(op_const_i64_text(util.i64_to_string(a - b)));
  }
  if (k == K_MUL) {
    return Some(op_const_i64_text(util.i64_to_string(a * b)));
  }
  if (k == K_AND) {
    return Some(op_const_i64_text(util.i64_to_string(a & b)));
  }
  if (k == K_OR) {
    return Some(op_const_i64_text(util.i64_to_string(a | b)));
  }
  if (k == K_XOR) {
    return Some(op_const_i64_text(util.i64_to_string(a ^ b)));
  }
  if (k == K_SHL) {
    return Some(op_const_i64_text(util.i64_to_string(a << (b & 63i64))));
  }
  if (k == K_EQ) {
    return Some(op_const_i32(fold_bool64(a == b) as i32));
  }
  if (k == K_NE) {
    return Some(op_const_i32(fold_bool64(a != b) as i32));
  }
  if (o.unsigned) {
    return None;
  }
  let min: i64 = -9223372036854775807i64 - 1i64;
  if (k == K_DIV_S) {
    if (b == 0i64 || a == min && b == -1i64) {
      return None;
    }
    return Some(op_const_i64_text(util.i64_to_string(a / b)));
  }
  if (k == K_REM_S) {
    if (b == 0i64) {
      return None;
    }
    if (a == min && b == -1i64) {
      return Some(op_const_i64_text(util.i64_to_string(0i64)));
    }
    return Some(op_const_i64_text(util.i64_to_string(a % b)));
  }
  if (k == K_SHR_S) {
    return Some(op_const_i64_text(util.i64_to_string(a >> (b & 63i64))));
  }
  if (k == K_LT_S) {
    return Some(op_const_i32(fold_bool64(a < b) as i32));
  }
  if (k == K_LE_S) {
    return Some(op_const_i32(fold_bool64(a <= b) as i32));
  }
  if (k == K_GT_S) {
    return Some(op_const_i32(fold_bool64(a > b) as i32));
  }
  if (k == K_GE_S) {
    return Some(op_const_i32(fold_bool64(a >= b) as i32));
  }
  return None;
}

function fold_bool64(c: boolean): i64 {
  if (c) {
    return 1i64;
  }
  return 0i64;
}

pub struct StrengthResult {
  ops: Op[],
  changed: boolean,
}

function strength_none(): Option[Op[]] {
  return None;
}

// Keep array payload constructors out of line.
// The pinned bootstrap compiler refuses their inlined ownership transfers.
@noinline
function strength_del(): Option[Op[]] {
  let ops: Op[] = [];
  return Some(ops);
}

@noinline
function strength_drop0(): Option[Op[]] {
  let o: Op[] = [op_drop(), op_const_i32(0)];
  return Some(o);
}

@noinline
function strength_pair(a: Op, b: Op): Option[Op[]] {
  let o: Op[] = [a, b];
  return Some(o);
}

function log2_i32(n: i32): i32 {
  if (n <= 0) {
    return -1;
  }
  if ((n & n - 1) != 0) {
    return -1;
  }
  let r = 0;
  let v = n;
  while (v > 1) {
    r += 1;
    v = v >> 1;
  }
  return r;
}

pub struct MagicS {
  m: i64,
  s: i32,
  add: boolean,
  sub: boolean,
}

pub struct MagicU {
  m: u64,
  s: i32,
  add: boolean,
}

function word_mask(w: i32): u64 {
  if (w >= 64) {
    return 0u64 - 1u64;
  }
  return (1u64 << w as u64) - 1u64;
}

pub function derive_magic_s(d: i64): MagicS {
  let ad = d as u64;
  if (d < 0i64) {
    ad = (0i64 - d) as u64;
  }
  let two: u64 = 1u64 << 63u64;
  let t = two + (d as u64 >> 63u64);
  let anc = t - 1u64 - t % ad;
  let p = 63;
  let q1 = two / anc;
  let r1 = two - q1 * anc;
  let q2 = two / ad;
  let r2 = two - q2 * ad;
  let searching = true;
  while (searching) {
    p += 1;
    q1 *= 2u64;
    r1 *= 2u64;
    if (r1 >= anc) {
      q1 += 1u64;
      r1 -= anc;
    }
    q2 *= 2u64;
    r2 *= 2u64;
    if (r2 >= ad) {
      q2 += 1u64;
      r2 -= ad;
    }
    let delta = ad - r2;
    if (q1 > delta || q1 == delta && r1 != 0u64) {
      searching = false;
    }
  }
  let mu = q2 + 1u64;
  if (d < 0i64) {
    mu = 0u64 - mu;
  }
  let m = mu as i64;
  return MagicS { m: m, s: p - 64, add: d > 0i64 && m < 0i64, sub: d < 0i64 && m > 0i64 };
}

// A signed 32-bit divisor d (|d| >= 3, not a power of two) as one 64-bit
// multiply: with t = x * m on the sign-extended dividend, the quotient is
// (t >> s) plus the sign bit of t. |m| < 2^32, so t cannot overflow.
// Lemire, Bartlett and Kaser, "Integer division by constants: optimal bounds".
pub struct MagicS32 {
  m: i64,
  s: i32,
}

pub function derive_magic_s32(d: i64): MagicS32 {
  let ad = d;
  if (d < 0i64) {
    ad = 0i64 - d;
  }
  let s: i32 = 31;
  while (1i64 << s - 31 < ad) {
    s += 1;
  }
  let c: i64 = (1i64 << s) / ad + 1i64;
  if (d < 0i64) {
    c = 0i64 - c;
  }
  return MagicS32 { m: c, s: s };
}

pub function pow2_shift_i64(mag: i64): i32 {
  if (mag == 0i64 || (mag & mag - 1i64) != 0i64) {
    return -1;
  }
  let sh: i32 = 0;
  while (1i64 << sh != mag) {
    sh += 1;
  }
  return sh;
}

pub function derive_magic_u(d: u64, w: i32): MagicU {
  return derive_magic_u_below(d, w, 0);
}

pub function derive_magic_u_below(d: u64, w: i32, lz: i32): MagicU {
  let mask = word_mask(w);
  let two = 1u64 << (w - 1) as u64;
  let top = mask >> lz as u64;
  let nc = top - (top + 1u64 - d & mask) % d;
  let p = w - 1;
  let q1 = two / nc;
  let r1 = two - q1 * nc;
  let q2 = (two - 1u64) / d;
  let r2 = two - 1u64 - q2 * d;
  let add = false;
  let searching = true;
  while (searching) {
    p += 1;
    if (r1 >= nc - r1) {
      q1 = q1 * 2u64 + 1u64 & mask;
      r1 = r1 * 2u64 - nc & mask;
    } else {
      q1 = q1 * 2u64 & mask;
      r1 = r1 * 2u64 & mask;
    }
    if (r2 + 1u64 >= d - r2) {
      if (q2 >= two - 1u64) {
        add = true;
      }
      q2 = q2 * 2u64 + 1u64 & mask;
      r2 = r2 * 2u64 + 1u64 - d & mask;
    } else {
      if (q2 >= two) {
        add = true;
      }
      q2 = q2 * 2u64 & mask;
      r2 = r2 * 2u64 + 1u64 & mask;
    }
    let delta = d - 1u64 - r2;
    if (p >= 2 * w || q1 > delta || q1 == delta && r1 != 0u64) {
      searching = false;
    }
  }
  return MagicU { m: q2 + 1u64 & mask, s: p - w, add: add };
}

struct StrengthKinds { mul: i32, add: i32, sub: i32, or: i32, xor: i32, shl: i32, shr_s: i32, shr_u: i32, and: i32, div_s: i32, div_u: i32, rem_s: i32, rem_u: i32 }

function strength_kinds(): StrengthKinds {
  return StrengthKinds { mul: K_MUL, add: K_ADD, sub: K_SUB, or: K_OR, xor: K_XOR, shl: K_SHL, shr_s: K_SHR_S, shr_u: K_SHR_U, and: K_AND, div_s: K_DIV_S, div_u: K_DIV_U, rem_s: K_REM_S, rem_u: K_REM_U };
}

function strength_rewrite(ks: StrengthKinds, k: i32, bop: Op): Option[Op[]] {
  let t = bop.kind_tag;
  if (t == ks.mul) {
    if (k == 1) {
      return strength_del();
    }
    if (k == 0) {
      return strength_drop0();
    }
    let n = log2_i32(k);
    if (n > 0) {
      return strength_pair(op_const_i32(n), op_bin("shl", 0, false));
    }
    return strength_none();
  }
  if (t == ks.add || t == ks.sub || t == ks.or || t == ks.xor || t == ks.shl || t == ks.shr_s || t == ks.shr_u) {
    if (k == 0) {
      return strength_del();
    }
    return strength_none();
  }
  if (t == ks.and) {
    if (k == 0) {
      return strength_drop0();
    }
    if (k == -1) {
      return strength_del();
    }
    return strength_none();
  }
  if (t == ks.div_s) {
    if (k == 1) {
      return strength_del();
    }
    return strength_none();
  }
  if (t == ks.div_u) {
    if (k == 1) {
      return strength_del();
    }
    let nd = log2_i32(k);
    if (nd > 0) {
      return strength_pair(op_const_i32(nd), op_bin("shr_u", 0, false));
    }
    return strength_none();
  }
  if (t == ks.rem_s) {
    if (k == 1) {
      return strength_drop0();
    }
    return strength_none();
  }
  if (t == ks.rem_u) {
    if (k == 1) {
      return strength_drop0();
    }
    let nr = log2_i32(k);
    if (nr > 0) {
      return strength_pair(op_const_i32(k - 1), op_bin("and", 0, false));
    }
    return strength_none();
  }
  return strength_none();
}

pub function reduce_strength_ex(ops: Op[]): StrengthResult {
  let k_i32 = K_CONST_I32;
  let k_i32_text = K_CONST_I32_TEXT;
  let ks = strength_kinds();
  let out: Op[] = [];
  let changed = false;
  let i = 0;
  while (i < ops.len()) {
    let kt = ops[i].kind_tag;
    if ((kt == k_i32 || kt == k_i32_text) && i + 1 < ops.len() && const_i32_readable(ops[i]) && ops[i + 1].width == 0) {
      match (strength_rewrite(ks, const_i32_value(ops[i]), ops[i + 1])) {
        Some(repl) => {
          if (!changed) {
            out = fold_prefixed(ops, i, []);
          }
          let r = 0;
          while (r < repl.len()) {
            out = out.append(repl[r]);
            r += 1;
          }
          changed = true;
          i += 2;
          continue;
        },
        None => {}
      }
    }
    if (changed) {
      out = out.append(ops[i]);
    }
    i += 1;
  }
  if (changed) {
    tv_dump("strength", ops, out);
    return StrengthResult { ops: out, changed: true };
  }
  return StrengthResult { ops: ops, changed: false };
}

function tv_dump(pass: string, before: Op[], after: Op[]): void {
  match (env("FERN_TV_DUMP")) {
    Some(want) => {
      if (want == pass) {
        eprint("fern-tv " + pass + "\n" + tv_ops("before", before) + tv_ops("after", after) + "fern-tv end");
      }
    },
    None => {}
  }
}

function tv_ops(side: string, ops: Op[]): string {
  let s = "fern-tv " + side + " " + util.i32_to_string(ops.len()) + "\n";
  let i = 0;
  while (i < ops.len()) {
    let o = ops[i];
    let u = "0";
    if (o.unsigned) {
      u = "1";
    }
    s = s + kind_name(o.kind_tag) + " " + util.i32_to_string(o.kind_tag) + " " + util.i32_to_string(o.i32_imm) + " " + util.i64_to_string(o.i64_imm) + " " + util.i64_to_string(f64_bits(o.f64_imm)) + " " + util.i32_to_string(o.width) + " " + u + " " + util.i32_to_string(o.decl) + " :" + hex_text(o.str) + "\n";
    i += 1;
  }
  return s;
}

pub function reduce_strength(ops: Op[]): Op[] {
  return reduce_strength_ex(ops).ops;
}

pub function eliminate_dead_code(ops: Op[]): Op[] {
  let out: Op[] = [];
  let copying = false;
  let depth = 0;
  let dead = false;
  let dead_depth = 0;
  let k_block = K_BLOCK;
  let k_loop = K_LOOP;
  let k_if = K_IF;
  let k_else = K_ELSE;
  let k_end = K_END;
  let k_br = K_BR;
  let k_return = K_RETURN;
  let i = 0;
  while (i < ops.len()) {
    let t = ops[i].kind_tag;
    if (t == k_end || t == k_else) {
      if (dead && depth == dead_depth) {
        dead = false;
      }
    }
    if (!dead) {
      if (copying) {
        out = out.append(ops[i]);
      }
    } else if (!copying) {
      out = fold_prefixed(ops, i, []);
      copying = true;
    }
    if (t == k_block || t == k_loop || t == k_if) {
      depth += 1;
    } else if (t == k_end) {
      depth -= 1;
    } else if (!dead && (t == k_return || t == k_br)) {
      dead = true;
      dead_depth = depth;
    }
    i += 1;
  }
  if (copying) {
    return out;
  }
  return ops;
}

pub function eliminate_dead_stores(ops: Op[]): Op[] {
  let cur = ops;
  let loads = slot_reads(ops);
  while (true) {
    let stored = drop_dead_stores(cur, loads);
    let c = cancel_dropped_pushes(stored, loads);
    cur = c.ops;
    loads = c.loads;
    if (!c.emptied) {
      return cur;
    }
  }
  return cur;
}

function drop_dead_stores(ops: Op[], loads: i32[]): Op[] {
  let k_store = K_STORE_LOCAL;
  let k_tee = K_TEE_LOCAL;
  if (!writes_unread(ops, loads, k_store, k_tee)) {
    return ops;
  }
  let out: Op[] = [];
  for o in ops {
    if (o.kind_tag == k_tee && loads[o.i32_imm] == 0) {
      continue;
    }
    if (o.kind_tag == k_store && loads[o.i32_imm] == 0) {
      out = out.append(op_drop());
    } else {
      out = out.append(o);
    }
  }
  return out;
}

function writes_unread(ops: Op[], loads: i32[], k_store: i32, k_tee: i32): boolean {
  for o in ops {
    if ((o.kind_tag == k_store || o.kind_tag == k_tee) && loads[o.i32_imm] == 0) {
      return true;
    }
  }
  return false;
}

function slot_reads(ops: Op[]): i32[] {
  let k_load = K_LOAD_LOCAL;
  let k_dyn = K_DYN_DISPATCH;
  let loads = __alloc_i32(cp_max_slot(ops) + 1);
  for o in ops {
    if (o.kind_tag == k_load) {
      loads = loads.with(o.i32_imm, loads[o.i32_imm] + 1);
    }
    if (frame_box_base(o) >= 0) {
      loads = slots_read(loads, frame_box_base(o), 3);
    }
    if (o.kind_tag == k_dyn) {
      loads = slots_read(loads, o.i32_imm, o.width);
    }
  }
  return loads;
}

function slots_read(own loads: i32[], first: i32, n: i32): i32[] {
  let s = first;
  while (s < first + n) {
    if (s >= 0 && s < loads.len()) {
      loads = loads.with(s, loads[s] + 1);
    }
    s += 1;
  }
  return loads;
}

struct Cancelled { ops: Op[], loads: i32[], emptied: boolean }

function cancel_dropped_pushes(ops: Op[], own loads: i32[]): Cancelled {
  let pushes: i32[] = [K_CONST_I32, K_CONST_I32_TEXT, K_CONST_I64, K_CONST_F64, K_CONST_STR, K_LOAD_LOCAL];
  let k_drop = K_DROP;
  let k_load = K_LOAD_LOCAL;
  let gone = __alloc_bool(ops.len());
  let kept = __alloc_i32(ops.len());
  let top = 0;
  let any = false;
  let emptied = false;
  let i = 0;
  while (i < ops.len()) {
    let t = ops[i].kind_tag;
    if (t == k_drop && top > 0 && util.index_of_i32(pushes, ops[kept[top - 1]].kind_tag) >= 0) {
      top -= 1;
      let pushed = ops[kept[top]];
      if (pushed.kind_tag == k_load) {
        loads = loads.with(pushed.i32_imm, loads[pushed.i32_imm] - 1);
        emptied = emptied || loads[pushed.i32_imm] == 0;
      }
      gone = gone.with(kept[top], true).with(i, true);
      any = true;
    } else {
      kept = kept.with(top, i);
      top += 1;
    }
    i += 1;
  }
  if (!any) {
    return Cancelled { ops: ops, loads: loads, emptied: false };
  }
  let out: Op[] = [];
  i = 0;
  while (i < ops.len()) {
    if (!gone[i]) {
      out = out.append(ops[i]);
    }
    i += 1;
  }
  return Cancelled { ops: out, loads: loads, emptied: emptied };
}

function zg_mark(own first: i32[], sl: i32, at: i32): i32[] {
  if (sl < 0 || sl >= first.len()) {
    return first;
  }
  if (first[sl] <= at) {
    return first;
  }
  return first.with(sl, at);
}

function zg_rezero(ops: Op[], i: i32): boolean {
  if (i == 0) {
    return false;
  }
  if (!const_i32_readable(ops[i - 1])) {
    return false;
  }
  return const_i32_value(ops[i - 1]) == 0;
}

function zg_first_write(ops: Op[], nslots: i32): i32[] {
  let k_store = K_STORE_LOCAL;
  let k_tee = K_TEE_LOCAL;
  let first = __alloc_i32(nslots);
  let z = 0;
  while (z < nslots) {
    first = first.with(z, ops.len());
    z += 1;
  }
  let i = 0;
  while (i < ops.len()) {
    let t = ops[i].kind_tag;
    if ((t == k_store || t == k_tee) && !zg_rezero(ops, i)) {
      first = zg_mark(first, ops[i].i32_imm, i);
    } else if (frame_box_base(ops[i]) >= 0) {
      let fk = 0;
      while (fk < 3) {
        first = zg_mark(first, frame_box_base(ops[i]) + fk, i);
        fk += 1;
      }
    }
    i += 1;
  }
  return first;
}

function zg_zero_guard(ops: Op[], i: i32, n_params: i32, first: i32[], k_call: i32): boolean {
  if (i + 1 >= ops.len()) {
    return false;
  }
  if (ops[i + 1].kind_tag != k_call || ops[i + 1].str != "__fern_rc_is_unique") {
    return false;
  }
  let sl = ops[i].i32_imm;
  if (sl < n_params || sl >= first.len()) {
    return false;
  }
  return first[sl] > i;
}

pub function prune_zero_slot_guards(ops: Op[], n_params: i32): Op[] {
  let maxs = cp_max_slot(ops);
  if (maxs < n_params) {
    return ops;
  }
  let first = zg_first_write(ops, maxs + 1);
  let depth = 0;
  let loop_at: i32 = -1;
  let k_load = K_LOAD_LOCAL;
  let k_call = K_CALL_DIRECT;
  let out: Op[] = [];
  let copying = false;
  let i = 0;
  while (i < ops.len()) {
    let tag = ops[i].kind_tag;
    if (tag == K_BLOCK || tag == K_IF) {
      depth += 1;
    } else if (tag == K_LOOP) {
      if (loop_at < 0) {
        loop_at = depth;
      }
      depth += 1;
    } else if (tag == K_END && depth > 0) {
      depth -= 1;
      if (depth == loop_at) {
        loop_at = -1;
      }
    }
    if (tag == k_load && loop_at < 0
      && zg_zero_guard(ops, i, n_params, first, k_call)) {
      if (!copying) {
        out = fold_prefixed(ops, i, []);
        copying = true;
      }
      out = out.append(op_const_i32(0));
      i += 2;
    } else {
      if (copying) {
        out = out.append(ops[i]);
      }
      i += 1;
    }
  }
  if (copying) {
    return out;
  }
  return ops;
}

pub struct OptimizedOps {
  ops: Op[],
  n_locals: i32,
}

function finish_ops(cur: Op[], n_locals: i32): OptimizedOps {
  let done = cleanup(fuse_tee(eliminate_dead_code(cur)));
  let again = reduce_strength_ex(done);
  if (again.changed) {
    done = cleanup(strength_fixpoint(fold_const_binaries(again.ops)));
  }
  return hoist_loop_invariants(done, n_locals);
}

function cleanup(ops: Op[]): Op[] {
  return eliminate_dead_code(eliminate_dead_stores(propagate_fold(ops)));
}

function propagate_fold(ops: Op[]): Op[] {
  let cur = propagate_copies(const_propagate(ops));
  let folded = fold_const_binaries(cur);
  while (folded.len() < cur.len()) {
    cur = propagate_copies(const_propagate(folded));
    folded = fold_const_binaries(cur);
  }
  return folded;
}

function strength_fixpoint(ops: Op[]): Op[] {
  let cur = ops;
  let rounds = 0;
  while (rounds < 8) {
    let r = reduce_strength_ex(cur);
    if (!r.changed) {
      return cur;
    }
    cur = fold_const_binaries(r.ops);
    rounds += 1;
  }
  return cur;
}

pub function optimize_ops(ops: Op[], n_params: i32, n_locals: i32): OptimizedOps {
  return finish_ops(strength_fixpoint(fold_const_binaries(prune_zero_slot_guards(ops, n_params))), n_locals);
}

pub function hoist_loop_invariants(ops: Op[], n_locals: i32): OptimizedOps {
  let k_loop = K_LOOP;
  let cur = OptimizedOps { ops: ops, n_locals: n_locals };
  let i = ops.len() - 1;
  while (i >= 0 && ops[i].kind_tag != k_loop) {
    i -= 1;
  }
  if (i < 0) {
    return cur;
  }
  let maxs = cp_max_slot(ops);
  let stored = __alloc_i32(maxs + 1);
  while (i >= 0) {
    if (cur.ops[i].kind_tag == k_loop) {
      let pure = licm_hoist_pure(cur.ops, i, maxs + 1);
      cur = OptimizedOps { ...cur, ops: pure.ops };
      let h = licm_hoist_from_loop(cur, pure.at, maxs, stored);
      cur = h.cur;
      stored = h.stored;
      if (cur.n_locals - 1 > maxs) {
        maxs = cur.n_locals - 1;
        while (stored.len() <= maxs) {
          stored = stored.append(0);
        }
      }
    }
    i -= 1;
  }
  return cur;
}

struct Hoisted { cur: OptimizedOps, stored: i32[] }

struct PureHoist { ops: Op[], at: i32 }

struct SlotUse { stores: i32[], first_load: i32[], last_load: i32[] }

// A pure computation of two invariant operands moves in front of the loop when
// its result goes to a local that the function stores once and reads only
// later in the same loop. A local that it stores counts as invariant after it.
// Every slot of `ops` is below `nslots`.
function licm_hoist_pure(ops: Op[], loop_idx: i32, nslots: i32): PureHoist {
  let end = licm_scope_end(ops, loop_idx);
  if (end < 0) {
    return PureHoist { ops: ops, at: loop_idx };
  }
  let uses = SlotUse { stores: [], first_load: [], last_load: [] };
  let stored = __alloc_bool(nslots);
  for j in loop_idx + 1..end {
    let t = ops[j].kind_tag;
    if (t == K_STORE_LOCAL || t == K_TEE_LOCAL) {
      stored = stored.with(ops[j].i32_imm, true);
    }
  }
  let moved = __alloc_bool(ops.len());
  let pre: Op[] = [];
  let j = loop_idx + 1;
  while (j < end) {
    let st = licm_pure_store(ops, j, end, stored);
    if (st >= 0 && uses.stores.len() == 0) {
      uses = licm_slot_use(ops, nslots);
    }
    if (st < 0 || !licm_stored_once(uses, ops[st].i32_imm, st, end)) {
      j += 1;
      continue;
    }
    let n = st - j + 1;
    for k in j..j + n {
      pre = pre.append(ops[k]);
      moved = moved.with(k, true);
    }
    stored = stored.with(ops[j + n - 1].i32_imm, false);
    j += n;
  }
  if (pre.len() == 0) {
    return PureHoist { ops: ops, at: loop_idx };
  }
  let out: Op[] = [];
  for k in 0..loop_idx {
    out = out.append(ops[k]);
  }
  for p in pre {
    out = out.append(p);
  }
  for k in loop_idx..ops.len() {
    if (!moved[k]) {
      out = out.append(ops[k]);
    }
  }
  return PureHoist { ops: out, at: loop_idx + pre.len() };
}

// The store that ends a pure sequence at j, or -1.
function licm_pure_store(ops: Op[], j: i32, end: i32, stored: boolean[]): i32 {
  if (j + 3 >= end || !licm_invariant(ops[j], stored) || !licm_invariant(ops[j + 1], stored) || !licm_pure_binary(ops[j + 2].kind_tag)) {
    return -1;
  }
  let k = j + 3;
  if (ops[k].kind_tag == K_INT_CAST) {
    k += 1;
  }
  if (k >= end || ops[k].kind_tag != K_STORE_LOCAL) {
    return -1;
  }
  return k;
}

// Slot t has its only store at k and its loads after k, before end.
function licm_stored_once(uses: SlotUse, t: i32, k: i32, end: i32): boolean {
  return t >= 0 && t < uses.stores.len() && uses.stores[t] == 1 && uses.first_load[t] > k && uses.last_load[t] < end;
}

function licm_invariant(o: Op, stored: boolean[]): boolean {
  if (o.kind_tag == K_CONST_I32 || o.kind_tag == K_CONST_I64) {
    return true;
  }
  return o.kind_tag == K_LOAD_LOCAL && o.i32_imm >= 0 && o.i32_imm < stored.len() && !stored[o.i32_imm];
}

function licm_pure_binary(k: i32): boolean {
  return k == K_ADD || k == K_SUB || k == K_MUL || k == K_AND || k == K_OR || k == K_XOR || k == K_SHL || k == K_SHR_S || k == K_SHR_U;
}

// For each slot: its stores, and its first and last load (-1 when none).
function licm_slot_use(ops: Op[], n: i32): SlotUse {
  let stores = __alloc_i32(n);
  let first = util.minus_ones(n);
  let last = util.minus_ones(n);
  for i in 0..ops.len() {
    let t = ops[i].kind_tag;
    let s = ops[i].i32_imm;
    if ((t == K_STORE_LOCAL || t == K_TEE_LOCAL) && s >= 0) {
      stores = stores.with(s, stores[s] + 1);
    } else if (t == K_LOAD_LOCAL && s >= 0) {
      if (first[s] < 0) {
        first = first.with(s, i);
      }
      last = last.with(s, i);
    }
  }
  return SlotUse { stores: stores, first_load: first, last_load: last };
}

function licm_hoist_from_loop(cur: OptimizedOps, loop_idx: i32, maxs: i32, own stored: i32[]): Hoisted {
  let ops = cur.ops;
  let end = licm_scope_end(ops, loop_idx);
  if (end < 0) {
    return Hoisted { cur: cur, stored: stored };
  }
  let hdr_end = licm_header_end(ops, loop_idx);
  let mark = loop_idx + 1;
  stored = licm_stored_locals(ops, loop_idx + 1, end, stored, mark);
  let order = licm_candidates(ops, loop_idx, hdr_end, stored, mark);
  if (order.len() == 0) {
    return Hoisted { cur: cur, stored: stored };
  }
  let slot_for = util.minus_ones(maxs + 1);
  let pre: Op[] = [];
  let n = 0;
  while (n < order.len()) {
    slot_for = slot_for.with(order[n], cur.n_locals + n);
    pre = pre.append(op_load_local(order[n]));
    pre = pre.append(op_str_len());
    pre = pre.append(op_store_local(cur.n_locals + n));
    n += 1;
  }
  let data_for = licm_data_slots(ops, loop_idx, end, slot_for, cur.n_locals + n);
  let slots = n;
  let d = 0;
  while (d < data_for.len()) {
    if (data_for[d] >= 0) {
      pre = pre.append(op_load_local(d));
      pre = pre.append(op_str_data());
      pre = pre.append(op_store_local(data_for[d]));
      slots += 1;
    }
    d += 1;
  }
  let out: Op[] = [];
  let j = 0;
  while (j < loop_idx) {
    out = out.append(ops[j]);
    j += 1;
  }
  let p = 0;
  while (p < pre.len()) {
    out = out.append(pre[p]);
    p += 1;
  }
  out = out.append(ops[loop_idx]);
  let k_load = K_LOAD_LOCAL;
  let k_len = K_STR_LEN;
  let k_data = K_STR_DATA;
  j = loop_idx + 1;
  while (j < ops.len()) {
    let slot: i32 = -1;
    if (j + 1 < end && ops[j].kind_tag == k_load && !is_view_string(ops[j + 1])) {
      let src = ops[j].i32_imm;
      if (j + 1 < hdr_end && ops[j + 1].kind_tag == k_len) {
        slot = slot_for[src];
      } else if (ops[j + 1].kind_tag == k_data && src < data_for.len()) {
        slot = data_for[src];
      }
    }
    if (slot >= 0) {
      out = out.append(op_load_local(slot));
      j += 2;
    } else {
      out = out.append(ops[j]);
      j += 1;
    }
  }
  return Hoisted { cur: OptimizedOps { ops: out, n_locals: cur.n_locals + slots }, stored: stored };
}

function licm_data_slots(ops: Op[], loop_idx: i32, end: i32, slot_for: i32[], next: i32): i32[] {
  let k_load = K_LOAD_LOCAL;
  let k_data = K_STR_DATA;
  let out = util.minus_ones(slot_for.len());
  let j = loop_idx + 1;
  while (j + 1 < end) {
    if (ops[j].kind_tag == k_load && ops[j + 1].kind_tag == k_data && !is_view_string(ops[j + 1])) {
      let src = ops[j].i32_imm;
      if (src < slot_for.len() && slot_for[src] >= 0 && out[src] < 0) {
        out = out.with(src, next);
        next += 1;
      }
    }
    j += 1;
  }
  return out;
}

function licm_candidates(ops: Op[], loop_idx: i32, hdr_end: i32, stored: i32[], mark: i32): i32[] {
  let k_load = K_LOAD_LOCAL;
  let k_len = K_STR_LEN;
  let order: i32[] = [];
  let j = loop_idx + 1;
  while (j + 1 < hdr_end) {
    if (ops[j].kind_tag == k_load && ops[j + 1].kind_tag == k_len && !is_view_string(ops[j + 1])) {
      let src = ops[j].i32_imm;
      if (stored[src] != mark && !licm_listed(order, src)) {
        order = order.append(src);
      }
    }
    j += 1;
  }
  return order;
}

function licm_listed(order: i32[], src: i32): boolean {
  let i = 0;
  while (i < order.len()) {
    if (order[i] == src) {
      return true;
    }
    i += 1;
  }
  return false;
}

function licm_header_end(ops: Op[], loop_idx: i32): i32 {
  let k_brif = K_BRIF;
  let k_if = K_IF;
  let k_else = K_ELSE;
  let k_loop = K_LOOP;
  let k_end = K_END;
  let k_return = K_RETURN;
  let k_br = K_BR;
  let k_exit = K_EXIT;
  let j = loop_idx + 1;
  while (j < ops.len()) {
    let t = ops[j].kind_tag;
    if (t == k_return || t == k_br || t == k_exit || t == k_brif || t == k_if || t == k_else
      || t == k_loop || t == k_end) {
      return j;
    }
    j += 1;
  }
  return j;
}

function licm_scope_end(ops: Op[], open: i32): i32 {
  let k_block = K_BLOCK;
  let k_loop = K_LOOP;
  let k_if = K_IF;
  let k_end = K_END;
  let depth = 0;
  let j = open;
  while (j < ops.len()) {
    let t = ops[j].kind_tag;
    if (t == k_block || t == k_loop || t == k_if) {
      depth += 1;
    } else if (t == k_end) {
      depth -= 1;
      if (depth == 0) {
        return j;
      }
    }
    j += 1;
  }
  return -1;
}

function licm_stored_locals(ops: Op[], lo: i32, hi: i32, own stored: i32[], mark: i32): i32[] {
  let k_store = K_STORE_LOCAL;
  let k_tee = K_TEE_LOCAL;
  let j = lo;
  while (j < hi) {
    let t = ops[j].kind_tag;
    if (t == k_store || t == k_tee) {
      stored = stored.with(ops[j].i32_imm, mark);
    }
    j += 1;
  }
  return stored;
}

function cp_max_slot(ops: Op[]): i32 {
  let k_load = K_LOAD_LOCAL;
  let k_store = K_STORE_LOCAL;
  let k_tee = K_TEE_LOCAL;
  let maxs: i32 = -1;
  let i = 0;
  while (i < ops.len()) {
    let kt = ops[i].kind_tag;
    if (kt == k_load || kt == k_store || kt == k_tee) {
      if (ops[i].i32_imm > maxs) {
        maxs = ops[i].i32_imm;
      }
    }
    i += 1;
  }
  return maxs;
}

function cp_kill_after(own has: boolean[], wrote: i32[], at: i32, bound: i32[]): boolean[] {
  let k = 0;
  while (k < bound.len()) {
    let s = bound[k];
    if (has[s] && wrote[s] > at) {
      has = has.with(s, false);
    }
    k += 1;
  }
  return has;
}

function cp_still_bound(bound: i32[], has: boolean[]): i32[] {
  let out: i32[] = [];
  let k = 0;
  while (k < bound.len()) {
    if (has[bound[k]]) {
      out = out.append(bound[k]);
    }
    k += 1;
  }
  return out;
}

function cp_loop_body_kill(ops: Op[], at: i32, own has: boolean[]): boolean[] {
  let k_store = K_STORE_LOCAL;
  let k_tee = K_TEE_LOCAL;
  let k_block = K_BLOCK;
  let k_loop = K_LOOP;
  let k_if = K_IF;
  let k_end = K_END;
  let d = 0;
  let j = at + 1;
  while (j < ops.len()) {
    let t = ops[j].kind_tag;
    if (t == k_block || t == k_loop || t == k_if) {
      d += 1;
    } else if (t == k_end) {
      if (d == 0) {
        return has;
      }
      d -= 1;
    } else if (t == k_store || t == k_tee) {
      let sl = ops[j].i32_imm;
      if (sl >= 0 && sl < has.len()) {
        has = has.with(sl, false);
      }
    } else if (frame_box_base(ops[j]) >= 0) {
      let fb = frame_box_base(ops[j]);
      let fk = 0;
      while (fk < 3) {
        if (fb + fk >= 0 && fb + fk < has.len()) {
          has = has.with(fb + fk, false);
        }
        fk += 1;
      }
    }
    j += 1;
  }
  return has;
}

pub function const_propagate(ops: Op[]): Op[] {
  let maxs = cp_max_slot(ops);
  if (maxs < 0) {
    return ops;
  }
  let nslots = maxs + 1;

  let k_load = K_LOAD_LOCAL;
  let k_store = K_STORE_LOCAL;
  let k_tee = K_TEE_LOCAL;
  let k_block = K_BLOCK;
  let k_loop = K_LOOP;
  let k_if = K_IF;
  let k_else = K_ELSE;
  let k_end = K_END;
  let k_br = K_BR;
  let k_brif = K_BRIF;

  let known: Op[] = [];
  let zero = op_const_i32(0);
  let has = __alloc_bool(nslots);
  let wrote = util.minus_ones(nslots);
  let bound: i32[] = [];
  let z = 0;
  while (z < nslots) {
    known = known.append(zero);
    z += 1;
  }

  let fr_kind: i32[] = [];
  let fr_at: i32[] = [];
  let fr_wc: i32[] = [];
  let fr_br: boolean[] = [];
  let depth = 0;
  let wc = 0;

  let out: Op[] = [];
  let copying = false;
  let i = 0;
  while (i < ops.len()) {
    let o = ops[i];
    let kt = o.kind_tag;
    let emit = o;
    if (kt == k_block || kt == k_loop || kt == k_if) {
      if (depth < fr_kind.len()) {
        fr_kind = fr_kind.with(depth, kt);
        fr_at = fr_at.with(depth, i);
        fr_wc = fr_wc.with(depth, wc);
        fr_br = fr_br.with(depth, false);
      } else {
        fr_kind = fr_kind.append(kt);
        fr_at = fr_at.append(i);
        fr_wc = fr_wc.append(wc);
        fr_br = fr_br.append(false);
      }
      depth += 1;
      if (kt == k_loop) {
        has = cp_loop_body_kill(ops, i, has);
      }
    } else if (kt == k_else) {
      if (depth > 0 && fr_kind[depth - 1] == k_if && wc != fr_wc[depth - 1]) {
        has = cp_kill_after(has, wrote, fr_at[depth - 1], bound);
        bound = cp_still_bound(bound, has);
      }
    } else if (kt == k_end) {
      if (depth > 0) {
        let straight = fr_kind[depth - 1] == k_block && !fr_br[depth - 1];
        if (!straight && wc != fr_wc[depth - 1]) {
          has = cp_kill_after(has, wrote, fr_at[depth - 1], bound);
          bound = cp_still_bound(bound, has);
        }
        depth -= 1;
      }
    } else if (kt == k_br || kt == k_brif) {
      let tgt = depth - 1 - o.i32_imm;
      if (o.i32_imm >= 0 && tgt >= 0) {
        fr_br = fr_br.with(tgt, true);
      }
    } else if (frame_box_base(o) >= 0) {
      let fb = frame_box_base(o);
      let fk = 0;
      while (fk < 3) {
        let fs = fb + fk;
        if (fs >= 0 && fs < nslots) {
          wrote = wrote.with(fs, i);
          wc += 1;
          if (has[fs]) {
            has = has.with(fs, false);
          }
        }
        fk += 1;
      }
    } else if (kt == k_store || kt == k_tee) {
      let sl = o.i32_imm;
      if (sl >= 0 && sl < nslots) {
        wrote = wrote.with(sl, i);
        wc += 1;
        let prev = cp_prev(ops, out, copying, i);
        if (const_i32_readable(prev) || const_i64_readable(prev)) {
          known = known.with(sl, prev);
          if (!has[sl]) {
            bound = bound.append(sl);
          }
          has = has.with(sl, true);
        } else if (has[sl]) {
          has = has.with(sl, false);
        }
      }
    } else if (kt == k_load && o.i32_imm >= 0 && o.i32_imm < nslots && has[o.i32_imm]) {
      emit = known[o.i32_imm];
      if (!copying) {
        out = fold_prefixed(ops, i, []);
        copying = true;
      }
    }
    if (copying) {
      out = out.append(emit);
    }
    i += 1;
  }
  if (copying) {
    return out;
  }
  return ops;
}

function cp_prev(ops: Op[], out: Op[], copying: boolean, i: i32): Op {
  if (i == 0) {
    return op_drop();
  }
  if (copying) {
    return out[out.len() - 1];
  }
  return ops[i - 1];
}

pub function propagate_copies(ops: Op[]): Op[] {
  let k_load = K_LOAD_LOCAL;
  let k_store = K_STORE_LOCAL;
  let k_tee = K_TEE_LOCAL;
  let maxs: i32 = -1;
  let i = 0;
  while (i < ops.len()) {
    let kt = ops[i].kind_tag;
    if (kt == k_load || kt == k_store || kt == k_tee) {
      if (ops[i].i32_imm > maxs) {
        maxs = ops[i].i32_imm;
      }
    }
    i += 1;
  }
  if (maxs < 0) {
    return ops;
  }
  let reads = __alloc_i32(maxs + 1);
  let stores = __alloc_i32(maxs + 1);
  let tees = __alloc_i32(maxs + 1);
  i = 0;
  while (i < ops.len()) {
    let kt2 = ops[i].kind_tag;
    let sl = ops[i].i32_imm;
    if (sl >= 0 && sl <= maxs) {
      if (kt2 == k_load) {
        reads = reads.with(sl, reads[sl] + 1);
      } else if (kt2 == k_store) {
        stores = stores.with(sl, stores[sl] + 1);
      } else if (kt2 == k_tee) {
        tees = tees.with(sl, tees[sl] + 1);
      }
    }
    i += 1;
  }
  let out: Op[] = [];
  let copying = false;
  i = 0;
  while (i < ops.len()) {
    let dead_tee = false;
    let sl2 = ops[i].i32_imm;
    if (ops[i].kind_tag == k_tee && sl2 >= 0 && sl2 <= maxs) {
      dead_tee = reads[sl2] == 0 && stores[sl2] == 0 && tees[sl2] == 1;
    }
    if (!dead_tee) {
      if (copying) {
        out = out.append(ops[i]);
      }
    } else if (!copying) {
      out = fold_prefixed(ops, i, []);
      copying = true;
    }
    i += 1;
  }
  if (copying) {
    return out;
  }
  return ops;
}

pub function fuse_tee(ops: Op[]): Op[] {
  let k_store = K_STORE_LOCAL;
  let k_load = K_LOAD_LOCAL;
  let out: Op[] = [];
  let copying = false;
  let i = 0;
  while (i < ops.len()) {
    if (i + 1 < ops.len()
      && ops[i].kind_tag == k_store
      && ops[i + 1].kind_tag == k_load
      && ops[i].i32_imm == ops[i + 1].i32_imm) {
      if (!copying) {
        out = fold_prefixed(ops, i, []);
        copying = true;
      }
      out = out.append(op_tee_local(ops[i].i32_imm));
      i += 2;
    } else {
      if (copying) {
        out = out.append(ops[i]);
      }
      i += 1;
    }
  }
  if (copying) {
    return out;
  }
  return ops;
}

pub function is_commutative_kind(id: i32): boolean {
  return id == K_ADD || id == K_MUL
    || id == K_AND || id == K_OR || id == K_XOR
    || id == K_EQ || id == K_NE;
}

pub function render_op(o: Op): string {
  if (o.kind_tag == K_CONST_I32) {
    return "const_i32 " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == K_CONST_I32_TEXT) {
    return "const_i32_text " + o.str;
  }
  if (o.kind_tag == K_CONST_I64) {
    return "const_i64 " + o.str;
  }
  if (o.kind_tag == K_INT_EXTEND) {
    return "int_extend";
  }
  if (o.kind_tag == K_INT_WRAP) {
    return "int_wrap";
  }
  if (o.kind_tag == K_CONST_STR) {
    return "const_str " + o.str;
  }
  if (o.kind_tag == K_LOAD_LOCAL) {
    return "load_local " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == K_STORE_LOCAL) {
    return "store_local " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == K_TEE_LOCAL) {
    return "tee_local " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 149) {
    return "call_direct " + o.str + "/" + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 157) {
    return "br " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 158) {
    return "brif " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == K_LOAD) {
    return "load w" + util.i32_to_string(o.width);
  }
  if (o.kind_tag == K_STORE) {
    return "store w" + util.i32_to_string(o.width);
  }
  if (o.kind_tag == K_ARR_MAKE) {
    return "arr_make " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == K_STR_LEN) {
    return "str_len";
  }
  if (o.kind_tag == K_STR_CONCAT) {
    return "str_concat";
  }
  if (o.kind_tag == K_STR_EQ) {
    return "str_eq";
  }
  if (o.kind_tag == K_STR_CMP) {
    return "str_cmp";
  }
  if (o.kind_tag == K_STR_INDEX) {
    return "str_index";
  }
  if (o.kind_tag == K_STR_SLICE) {
    if (o.i32_imm > 0) {
      return "str_slice frame:" + util.i32_to_string(o.i32_imm - 1);
    }
    return "str_slice";
  }
  if (o.kind_tag == K_RAW_STRING && o.i32_imm > 0) {
    return "raw_string frame:" + util.i32_to_string(o.i32_imm - 1);
  }
  if (o.kind_tag == K_ARR_SLICE) {
    return "arr_slice";
  }
  if (o.kind_tag == K_OPT_MAKE) {
    return "opt_make " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 122) {
    return "opt_tag";
  }
  if (o.kind_tag == 123) {
    return "opt_payload";
  }
  if (o.kind_tag == 124) {
    return "opt_set_payload";
  }
  if (o.kind_tag == 138) {
    return "struct_make " + o.str + "/" + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 139) {
    return "struct_get " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 140) {
    return "struct_set " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 145) {
    return "variant_is " + o.str;
  }
  if (o.kind_tag == K_CONST_STRUCT) {
    let cfb = const_struct_fn_body(o.str);
    if (cfb.len() > 0) {
      return "const_closure " + cfb;
    }
    return "const_struct " + const_struct_type(o.str) + "/" + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 142) {
    return "tuple_make " + util.i32_to_string(o.i32_imm);
  }
  if (o.kind_tag == 143) {
    return "tuple_get " + util.i32_to_string(o.i32_imm);
  }
  return kind_name(o.kind_tag);
}

pub function call_needs_heap(name: string): boolean {
  if (rtbytecopy.is_helper(name)) {
    return true;
  }
  if (name == "__fern_alloc_reuse" || name == "__fern_arr_dec") {
    return true;
  }
  if (name == "__fern_rc_inc" || name == "__fern_rc_dec" || name == "__fern_rc_is_unique") {
    return true;
  }
  if (name == "__fern_arr_share_inc" || name == "__fern_arr_share_dec") {
    return true;
  }
  if (name == "__fern_arr_inc_elems" || name == "__fern_arr_own_elems" || name == "__fern_str_own" || name == "__fern_str_borrow"
    || name == "__fern_str_grow" || name == "__fern_str_grow_range"
    || name == "__fern_str_grow_fresh" || name == "__fern_str_grow_fresh_range") {
    return true;
  }
  if (name == "__fern_rc_underflow_count" || name == "__fern_rc_underflow_get") {
    return true;
  }
  if (name == "__fern_set_args") {
    return true;
  }
  return name == "__fern_str_free" || name == "__fern_str_view_free" || name == "__fern_str_arr_free";
}

pub function op_needs_heap(o: Op): boolean {
  return op_allocates(o.kind_tag) || o.kind_tag == 149 && call_needs_heap(o.str);
}

pub function op_allocates(tag: i32): boolean {
  if (tag == 381 || tag == 382 || tag == 383) {
    return true;
  }
  if (is_aes_gcm_op(tag) || is_sha_blocks_op(tag)) {
    return true;
  }
  if (tag == 348 || tag == 349 || tag == 350 || tag == 352) {
    return true;
  }
  if (tag == 218) {
    return true;
  }
  if (tag == 76 || tag == 77 || tag == 87 || tag == 92 || tag == 93 || tag == 94 || tag == 95 || tag == 302 || tag == 303) {
    return true;
  }
  if (tag == 5 || tag == 98 || tag == 102 || tag == 103 || tag == 380) {
    return true;
  }
  if (tag == 138 || tag == 142) {
    return true;
  }
  if (tag == 120) {
    return true;
  }
  if (tag == 185 || tag == 104 || tag == 105) {
    return true;
  }
  if (tag == 180) {
    return true;
  }
  if (tag == 169 || tag == 170) {
    return true;
  }
  if (tag == 203 || tag == 304 || tag == 305) {
    return true;
  }
  if (tag == 202 || tag == 308 || tag == 431) {
    return true;
  }
  if (tag == 233) {
    return true;
  }
  if (tag == 172) {
    return true;
  }
  if (tag == 173) {
    return true;
  }
  if (tag == 174) {
    return true;
  }
  if (tag == 231) {
    return true;
  }
  if (tag == 260 || tag == 261 || tag == 262 || tag == 263 || tag == 264 || tag == 267 || tag == 269 || tag == 498 || tag == 273 || tag == 356 || tag == 357 || tag == 362 || tag == 363 || tag == 364 || tag == 365 || tag == 405) {
    return true;
  }
  if (tag == 171 || tag == 310 || tag == 391 || tag == 432) {
    return true;
  }
  if (tag == 176) {
    return true;
  }
  if (tag == 175) {
    return true;
  }
  if (tag == 270) {
    return true;
  }
  if (tag == 398) {
    return true;
  }
  if (tag == 401) {
    return true;
  }
  if (tag == 276 || tag == 408) {
    return true;
  }
  if (tag >= 420 && tag <= 428) {
    return true;
  }
  if (util.index_of_i32([241, 242, 281, 490, 307, 330, 407, 366], tag) >= 0) {
    return true;
  }
  if (tag == 177) {
    return true;
  }
  if (tag == 240 || tag == 250 || tag == 251) {
    return true;
  }
  if (tag == 248 || tag == 249) {
    return true;
  }
  if (tag == 106 || tag == 107) {
    return true;
  }
  if (tag == 108 || tag == 109) {
    return true;
  }
  if (tag == 111 || tag == 113) {
    return true;
  }
  if (tag == 146) {
    return true;
  }
  if (tag == 80 || tag == 315) {
    return true;
  }
  if (tag == 229 || tag == 230 || tag == 491) {
    return true;
  }
  if (tag == 216 || tag == 217) {
    return true;
  }
  if (tag == 222) {
    return true;
  }
  return false;
}

// fern-lint: allow cyclomatic-complexity
pub function is_str_op_kind(tag: i32): boolean {
  return tag == 385 || tag == 384 || tag == 383 || tag == 382 || tag == 381 || tag == 380 || tag == 373 || tag == 368 || tag == 369 || tag == 361 || tag == 379 || tag == 378 || tag == 360 || tag == 359 || tag == 482 || tag == 358 || tag == 97 || tag == 101 || tag == 102
    || tag == 104 || tag == 105 || tag == 106
    || tag == 107 || tag == 108 || tag == 109
    || tag == 111 || tag == 113 || tag == 98
    || tag == 99 || tag == 100 || tag == 225 || tag == 227
    || tag == 234 || tag == 235 || tag == 245 || tag == 253 || tag == 446
    || tag == 309 || tag == 480 || tag == 481 || tag == 322 || tag == 324 || tag == 327 || tag == 329 || tag == 390
    || is_aes_gcm_op(tag) || is_sha_blocks_op(tag) || tag == 433;
}
