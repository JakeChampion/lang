pub function op_port_out(width: i32): Op {
  return Op { source: 0, decl: -1, kind_tag: K_PORT_OUT, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}

pub function is_device_kind(id: i32): boolean {
  return id == K_MMIO_LOAD || id == K_MMIO_STORE || id == K_FENCE || id == K_PORT_IN || id == K_PORT_OUT || is_privileged_kind(id);
}

