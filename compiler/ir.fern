pub function frame_box_base(o: Op): i32 {
  if ((o.kind_tag == K_STR_SLICE || o.kind_tag == K_RAW_STRING) && o.i32_imm > 0) {
    return o.i32_imm - 1;
  }
  return -1;
}

pub function placed_frame_box(o: Op, base: i32): Op {
  return Op { ...o, i32_imm: base + 1 };
}

