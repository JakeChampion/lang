import "./util";
import "./rtbytecopy";
import "std/string";

pub struct Op {
  kind_tag: i32,
  i32_imm: i32,
  i64_imm: i64,
  f64_imm: f64,
  width: i32,
  unsigned: boolean,
  str: string,
  decl: i32,
  source: i64,
}

pub function width_ptr(): i32 {
  return -1;
}

function op0(tag: i32): Op {
  return Op { source: 0, decl: -1, kind_tag: tag, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

pub function op_const_i32(v: i32): Op {
  return Op { source: 0, decl: -1, kind_tag: K_CONST_I32, i32_imm: v, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

pub function op_const_i32_text(t: string): Op {
  return Op { source: 0, decl: -1, kind_tag: K_CONST_I32_TEXT, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: t };
}

pub function op_const_ptr_text(t: string): Op {
  return Op { source: 0, decl: -1, kind_tag: K_CONST_I32_TEXT, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width_ptr(), unsigned: true, str: t };
}

pub function op_const_i64(v: i64): Op {
  return Op { source: 0, decl: -1, kind_tag: K_CONST_I64, i32_imm: 0, i64_imm: v, f64_imm: 0.0, width: 64, unsigned: false, str: "" };
}

