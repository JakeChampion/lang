pub struct TypeI32 { is_char: boolean, width: i32, unsigned: boolean, polymorphic: boolean }

pub function width_ptr(): i32 {
  return 0 - 1;
}

pub function is_primitive_type_name(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u32" || t == "u64" || t == "usize"
    || t == "f32" || t == "f64" || lanes_width(t) > 0
    || t == "boolean" || t == "bool"
    || t == "string" || t == "str" || t == "char" || t == "void";
}

pub struct TypeBool { tag: i32 }

pub struct TypeString { tag: i32 }

pub struct TypeFloat { width: i32, polymorphic: boolean }

pub struct TypeLanes { width: i32 }

pub struct TypeArray { elem: Type, view: boolean }

pub struct TypeStruct { name: string, args: Type[] }

pub struct TypeTuple { elements: Type[] }

pub struct TypeFunc { param_types: Type[], param_own: boolean[], ret_type: Type, params_known: boolean }

pub function fn_own_at(f: TypeFunc, i: i32): boolean {
  if (i < 0 || i >= f.param_own.len()) {
    return false;
  }
  return f.param_own[i];
}

pub function ownable(t: Type): boolean {
  if let TypeI32(_) = t {
    return false;
  }
  if let TypeBool(_) = t {
    return false;
  }
  if let TypeFloat(_) = t {
    return false;
  }
  if let TypeLanes(_) = t {
    return false;
  }
  if let TypeVoid(_) = t {
    return false;
  }
  return true;
}

pub function own_flags(flags: boolean[], params: Type[]): boolean[] {
  let kept: boolean[] = [];
  let any: boolean = false;
  let i: i32 = 0;
  while (i < params.len()) {
    let on: boolean = i < flags.len() && flags[i] && ownable(params[i]);
    kept = kept.append(on);
    if (on) {
      any = true;
    }
    i = i + 1;
  }
  if (!any) {
    return [];
  }
  return kept;
}

pub struct TypeMap { key: Type, value: Type }

pub struct TypeUnion { name: string, args: Type[] }

pub struct TypeDyn { traits: string }

pub struct TypeHandle { resource: string, borrowed: boolean }

pub struct TypeVoid { tag: i32 }

pub struct TypeUnknown { reason: string }

pub struct TypeErased { name: string }

pub struct TypeNever { tag: i32 }

pub type Type = TypeI32 | TypeBool | TypeString | TypeFloat | TypeLanes | TypeArray | TypeStruct | TypeTuple | TypeFunc | TypeMap | TypeUnion | TypeDyn | TypeHandle | TypeVoid | TypeUnknown | TypeErased | TypeNever;

pub function unchecked(): Type {
  return TypeUnknown { reason: "not yet checked" };
}

function char_spelling(i: TypeI32): string {
  if (i.width == 32 && !i.unsigned) {
    return "char";
  }
  return "";
}

function unsigned_spelling(i: TypeI32): string {
  if (i.width == width_ptr()) {
    return "usize";
  }
  if (i.width == 8) {
    return "u8";
  }
  if (i.width == 32) {
    return "u32";
  }
  if (i.width == 64) {
    return "u64";
  }
  return "";
}

function signed_spelling(i: TypeI32): string {
  if (i.width == 32) {
    return "i32";
  }
  if (i.width == 64) {
    return "i64";
  }
  return "";
}

function integer_spelling(i: TypeI32): string {
  if (i.is_char) {
    return char_spelling(i);
  }
  if (i.unsigned) {
    return unsigned_spelling(i);
  }
  return signed_spelling(i);
}

pub function handle_spelling(h: TypeHandle): string {
  if (h.borrowed) {
    return "borrow " + h.resource;
  }
  return "own " + h.resource;
}

pub function renamed_nominals(t: Type, clone_of: (Type) => string): Type {
  if let TypeStruct(s) = t {
    let n: string = "";
    if (s.args.len() > 0) {
      n = clone_of(t);
    }
    if (n.len() > 0) {
      return TypeStruct { name: n, args: [] };
    }
    return TypeStruct { ...s, args: renamed_list(s.args, clone_of) };
  }
  if let TypeUnion(u) = t {
    let n: string = "";
    if (u.args.len() > 0) {
      n = clone_of(t);
    }
    if (n.len() > 0) {
      return TypeUnion { name: n, args: [] };
    }
    return TypeUnion { ...u, args: renamed_list(u.args, clone_of) };
  }
  if let TypeArray(a) = t {
    return TypeArray { ...a, elem: renamed_nominals(a.elem, clone_of) };
  }
  if let TypeTuple(tup) = t {
    return TypeTuple { elements: renamed_list(tup.elements, clone_of) };
  }
  if let TypeMap(m) = t {
    return TypeMap { key: renamed_nominals(m.key, clone_of), value: renamed_nominals(m.value, clone_of) };
  }
  if let TypeFunc(f) = t {
    return TypeFunc { ...f, param_types: renamed_list(f.param_types, clone_of), ret_type: renamed_nominals(f.ret_type, clone_of) };
  }
  return t;
}

function renamed_list(ts: Type[], clone_of: (Type) => string): Type[] {
  let out: Type[] = [];
  for el in ts {
    out = out.append(renamed_nominals(el, clone_of));
  }
  return out;
}

pub function lanes_spelling(width: i32): string {
  if (width == 64) {
    return "f64x2";
  }
  if (width == 32) {
    return "f32x4";
  }
  return "";
}

pub function lanes_width(t: string): i32 {
  if (t == "f64x2") {
    return 64;
  }
  if (t == "f32x4") {
    return 32;
  }
  return 0;
}

pub function lane_builtin_width(name: string): i32 {
  if (name.len() <= 8) {
    return 0;
  }
  let head: string = slice_unchecked(name, 0, 8) + "";
  if (head == "__f64x2_") {
    return 64;
  }
  if (head == "__f32x4_") {
    return 32;
  }
  return 0;
}

pub function lane_builtin_verb(name: string): string {
  if (lane_builtin_width(name) == 0) {
    return "";
  }
  return slice_unchecked(name, 8, name.len()) + "";
}

pub function lane_builtin_params(name: string): Type[] {
  let w: i32 = lane_builtin_width(name);
  let lt: Type = TypeLanes { width: w };
  let e: Type = TypeFloat { width: w, polymorphic: false };
  let i: Type = TypeI32 { is_char: false, width: 32, unsigned: false, polymorphic: false };
  let arr: Type = TypeArray { elem: e, view: false };
  let v: string = lane_builtin_verb(name);
  if (v == "splat") {
    return [e];
  }
  if (v == "of") {
    let out: Type[] = [];
    while (out.len() < 128 / w) {
      out = out.append(e);
    }
    return out;
  }
  if (v == "lane") {
    return [lt, i];
  }
  if (v == "load") {
    return [arr, i];
  }
  if (v == "with") {
    return [arr, i, lt];
  }
  return lane_operands(v, lt);
}

function lane_operands(v: string, lt: Type): Type[] {
  if (v == "mul_add" || v == "select") {
    return [lt, lt, lt];
  }
  if (v == "sqrt" || v == "abs" || v == "floor" || v == "round" || v == "bitmask") {
    return [lt];
  }
  return [lt, lt];
}

pub function lane_builtin_result(name: string): Type {
  let w: i32 = lane_builtin_width(name);
  let v: string = lane_builtin_verb(name);
  if (v == "bitmask") {
    return TypeI32 { is_char: false, width: 32, unsigned: false, polymorphic: false };
  }
  if (v == "lane") {
    return TypeFloat { width: w, polymorphic: false };
  }
  if (v == "with") {
    return TypeArray { elem: TypeFloat { width: w, polymorphic: false }, view: false };
  }
  return TypeLanes { width: w };
}

pub function spelling(t: Type): string {
  match (t) {
    TypeI32(i) => {
      return integer_spelling(i);
    },
    TypeBool(_) => {
      return "boolean";
    },
    TypeString(s) => {
      if (s.tag == 0) {
        return "string";
      }
      if (s.tag == 1) {
        return "str";
      }
      return "";
    },
    TypeFloat(f) => {
      if (f.width == 32) {
        return "f32";
      }
      if (f.width == 64 || f.width == 0 && f.polymorphic) {
        return "f64";
      }
      return "";
    },
    TypeLanes(l) => {
      return lanes_spelling(l.width);
    },
    TypeArray(a) => {
      let elem: string = spelling(a.elem);
      if (elem.len() == 0) {
        return "";
      }
      if (a.view) {
        return "[" + elem + "]";
      }
      return elem + "[]";
    },
    TypeStruct(s) => {
      return nominal_spelling(s.name, s.args);
    },
    TypeUnion(u) => {
      return nominal_spelling(u.name, u.args);
    },
    TypeTuple(tup) => {
      if (tup.elements.len() < 2) {
        return "";
      }
      let fields: string = type_list_spelling(tup.elements);
      if (fields.len() == 0) {
        return "";
      }
      return "(" + fields + ")";
    },
    TypeFunc(f) => {
      if (!f.params_known) {
        return "";
      }
      let params: string = param_list_spelling(f);
      if (params.len() == 0 && f.param_types.len() > 0) {
        return "";
      }
      let ret: string = spelling(f.ret_type);
      if (ret.len() == 0) {
        return "";
      }
      return "((" + params + ") => " + ret + ")";
    },
    TypeMap(m) => {
      let key: string = spelling(m.key);
      let value: string = spelling(m.value);
      if (key.len() == 0 || value.len() == 0) {
        return "";
      }
      return "Map[" + key + ", " + value + "]";
    },
    TypeDyn(d) => {
      if (d.traits.len() == 0) {
        return "";
      }
      return "dyn " + d.traits;
    },
    TypeHandle(h) => {
      return handle_spelling(h);
    },
    TypeVoid(_) => {
      return "void";
    },
    TypeNever(_) => {
      return "";
    },
    TypeUnknown(_) => {
      return "";
    },
    TypeErased(_) => {
      return "";
    }
  }
  return "";
}

function param_list_spelling(f: TypeFunc): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < f.param_types.len()) {
    let one: string = spelling(f.param_types[i]);
    if (one.len() == 0) {
      return "";
    }
    if (i > 0) {
      out = out + ", ";
    }
    if (fn_own_at(f, i)) {
      out = out + "own ";
    }
    out = out + one;
    i = i + 1;
  }
  return out;
}

function type_list_spelling(ts: Type[]): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < ts.len()) {
    let next: string = spelling(ts[i]);
    if (next.len() == 0) {
      return "";
    }
    if (i > 0) {
      out = out + ", ";
    }
    out = out + next;
    i = i + 1;
  }
  return out;
}

function nominal_spelling(name: string, args: Type[]): string {
  if (name.len() == 0 || args.len() == 0) {
    return name;
  }
  let params: string = type_list_spelling(args);
  if (params.len() == 0) {
    return "";
  }
  return name + "[" + params + "]";
}
