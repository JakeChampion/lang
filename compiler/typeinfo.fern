import "std/string";

pub struct TypeI32 { is_char: boolean, width: i32, unsigned: boolean, polymorphic: boolean }

pub function width_ptr(): i32 {
  return -1;
}

pub function is_primitive_type_name(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u8" || t == "u32" || t == "u64" || t == "usize"
    || t == "f32" || t == "f64" || lanes_width(t) > 0
    || t == "boolean" || t == "bool"
    || t == "string" || t == "str" || t == "char" || t == "void";
}

pub struct TypeBool { tag: i32 }

pub struct TypeString { tag: i32 }

pub struct TypeFloat { width: i32, polymorphic: boolean }

// `kind` is the kind of an element: LANE_FLOAT, LANE_SIGNED or
// LANE_UNSIGNED. Two lane types with one width and two kinds are two types.
pub struct TypeLanes { width: i32, kind: i32 }

pub const LANE_FLOAT: i32 = 0;

pub const LANE_SIGNED: i32 = 1;

pub const LANE_UNSIGNED: i32 = 2;

pub struct TypeArray { elem: Type, view: boolean }

pub struct TypeStruct { name: string, args: Type[] }

pub struct TypeTuple { elements: Type[] }

pub struct TypeFunc { param_types: Type[], param_own: boolean[], ret_own: boolean, ret_type: Type, params_known: boolean }

pub function fn_own_at(f: TypeFunc, i: i32): boolean {
  if (i < 0 || i >= f.param_own.len()) {
    return false;
  }
  return f.param_own[i];
}

pub function ownable(t: Type): boolean {
  if let TypeI32(_) = t {
    return false;
  }
  if let TypeBool(_) = t {
    return false;
  }
  if let TypeFloat(_) = t {
    return false;
  }
  if let TypeLanes(_) = t {
    return false;
  }
  if let TypeVoid(_) = t {
    return false;
  }
  return true;
}

pub function own_flags(flags: boolean[], params: Type[]): boolean[] {
  let kept: boolean[] = [];
  let any = false;
  for i in 0..params.len() {
    let on = i < flags.len() && flags[i] && ownable(params[i]);
    kept = kept.append(on);
    if (on) {
      any = true;
    }
  }
  if (!any) {
    return [];
  }
  return kept;
}

pub struct TypeMap { key: Type, value: Type }

pub struct TypeUnion { name: string, args: Type[] }

pub struct TypeDyn { traits: string }

pub struct TypeHandle { resource: string, borrowed: boolean }

pub struct TypeVoid { tag: i32 }

pub struct TypeUnknown { reason: string }

pub struct TypeErased { name: string }

pub struct TypeNever { tag: i32 }

// TypeConst is a const argument of a generic type: the `4` of `Ring[4, T]`,
// as its decimal digits. It is a type argument, and no value has it.
pub struct TypeConst { value: string }

pub type Type = TypeI32 | TypeBool | TypeString | TypeFloat | TypeLanes | TypeArray | TypeStruct | TypeTuple | TypeFunc | TypeMap | TypeUnion | TypeDyn | TypeHandle | TypeVoid | TypeUnknown | TypeErased | TypeNever | TypeConst;

pub function t_i32(): Type {
  return TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: false };
}

pub function t_i64(): Type {
  return TypeI32 { width: 64, unsigned: false, is_char: false, polymorphic: false };
}

pub function t_u8(): Type {
  return TypeI32 { width: 8, unsigned: true, is_char: false, polymorphic: false };
}

pub function t_u32(): Type {
  return TypeI32 { width: 32, unsigned: true, is_char: false, polymorphic: false };
}

pub function t_u64(): Type {
  return TypeI32 { width: 64, unsigned: true, is_char: false, polymorphic: false };
}

pub function t_usize(): Type {
  return TypeI32 { width: width_ptr(), unsigned: true, is_char: false, polymorphic: false };
}

pub function t_char(): Type {
  return TypeI32 { width: 32, unsigned: false, is_char: true, polymorphic: false };
}

pub function t_bool(): Type {
  return TypeBool { tag: 0 };
}

pub function t_string(): Type {
  return TypeString { tag: 0 };
}

pub function t_str(): Type {
  return TypeString { tag: 1 };
}

pub function t_f64(): Type {
  return TypeFloat { width: 64, polymorphic: false };
}

pub function t_f32(): Type {
  return TypeFloat { width: 32, polymorphic: false };
}

pub function t_void(): Type {
  return TypeVoid { tag: 0 };
}

// Whether p holds for a type directly inside t: the element of an array, an
// element of a tuple, an argument of a struct or a union, the key or the value
// of a map, or a parameter or the result of a function.
pub function any_child(t: Type, p: (Type) => boolean): boolean {
  if let TypeFunc(f) = t {
    return any_of(f.param_types, p) || p(f.ret_type);
  }
  return any_of(children(t), p);
}

function any_of(ts: Type[], p: (Type) => boolean): boolean {
  for t in ts {
    if (p(t)) {
      return true;
    }
  }
  return false;
}

// The types that t holds directly.
function children(t: Type): Type[] {
  match (t) {
    TypeArray(a) => {
      return [a.elem];
    },
    TypeTuple(tt) => {
      return tt.elements;
    },
    TypeStruct(st) => {
      return st.args;
    },
    TypeUnion(u) => {
      return u.args;
    },
    TypeMap(m) => {
      return [m.key, m.value];
    },
    TypeFunc(f) => {
      let parts: Type[] = [f.ret_type];
      for p in f.param_types {
        parts = parts.append(p);
      }
      return parts;
    },
    _ => {
      return [];
    }
  }
}

// The number of types in t, t included. The count stops above limit.
pub function nodes(t: Type, limit: i32): i32 {
  let n = 1;
  for c in children(t) {
    if (n > limit) {
      return n;
    }
    n += nodes(c, limit - n);
  }
  return n;
}

pub function unchecked(): Type {
  return TypeUnknown { reason: "not yet checked" };
}

pub function is_array(t: Type): boolean {
  if let TypeArray(_) = t {
    return true;
  }
  return false;
}

// array_elem is the element type of an array, or unchecked() for any other type.
pub function array_elem(t: Type): Type {
  if let TypeArray(a) = t {
    return a.elem;
  }
  return unchecked();
}

pub function is_array_view(t: Type): boolean {
  if let TypeArray(a) = t {
    return a.view;
  }
  return false;
}

pub function is_lanes(t: Type): boolean {
  if let TypeLanes(_) = t {
    return true;
  }
  return false;
}

pub function is_dyn(t: Type): boolean {
  if let TypeDyn(_) = t {
    return true;
  }
  return false;
}

pub function is_record(t: Type): boolean {
  if let TypeStruct(_) = t {
    return true;
  }
  return false;
}

pub function is_cell(t: Type): boolean {
  if let TypeStruct(s) = t {
    return s.name == "Cell";
  }
  return false;
}

pub function is_tuple(t: Type): boolean {
  if let TypeTuple(_) = t {
    return true;
  }
  return false;
}

pub function tuple_elements(t: Type): Type[] {
  if let TypeTuple(tup) = t {
    return tup.elements;
  }
  return [];
}

// is_exact_i32 is true for a signed 32-bit integer that is not a char or an untyped literal.
pub function is_exact_i32(t: Type): boolean {
  if let TypeI32(n) = t {
    return n.width == 32 && !n.unsigned && !n.is_char && !n.polymorphic;
  }
  return false;
}

pub function is_owned_array(t: Type): boolean {
  if let TypeArray(a) = t {
    return !a.view;
  }
  return false;
}

pub function is_void(t: Type): boolean {
  if let TypeVoid(_) = t {
    return true;
  }
  return false;
}

// union_name is the name of a union type, or "" for any other type.
pub function union_name(t: Type): string {
  if let TypeUnion(u) = t {
    return u.name;
  }
  return "";
}

function char_spelling(i: TypeI32): string {
  if (i.width == 32 && !i.unsigned) {
    return "char";
  }
  return "";
}

function unsigned_spelling(i: TypeI32): string {
  if (i.width == width_ptr()) {
    return "usize";
  }
  if (i.width == 8) {
    return "u8";
  }
  if (i.width == 32) {
    return "u32";
  }
  if (i.width == 64) {
    return "u64";
  }
  return "";
}

function signed_spelling(i: TypeI32): string {
  if (i.width == 32) {
    return "i32";
  }
  if (i.width == 64) {
    return "i64";
  }
  return "";
}

function integer_spelling(i: TypeI32): string {
  if (i.is_char) {
    return char_spelling(i);
  }
  if (i.unsigned) {
    return unsigned_spelling(i);
  }
  return signed_spelling(i);
}

pub function handle_spelling(h: TypeHandle): string {
  if (h.borrowed) {
    return "borrow " + h.resource;
  }
  return "own " + h.resource;
}

pub function renamed_nominals(t: Type, clone_of: (Type) => string): Type {
  if let TypeStruct(s) = t {
    let n = "";
    if (s.args.len() > 0) {
      n = clone_of(t);
    }
    if (n.len() > 0) {
      return TypeStruct { name: n, args: [] };
    }
    return TypeStruct { ...s, args: renamed_list(s.args, clone_of) };
  }
  if let TypeUnion(u) = t {
    let n = "";
    if (u.args.len() > 0) {
      n = clone_of(t);
    }
    if (n.len() > 0) {
      return TypeUnion { name: n, args: [] };
    }
    return TypeUnion { ...u, args: renamed_list(u.args, clone_of) };
  }
  if let TypeArray(a) = t {
    return TypeArray { ...a, elem: renamed_nominals(a.elem, clone_of) };
  }
  if let TypeTuple(tup) = t {
    return TypeTuple { elements: renamed_list(tup.elements, clone_of) };
  }
  if let TypeMap(m) = t {
    return TypeMap { key: renamed_nominals(m.key, clone_of), value: renamed_nominals(m.value, clone_of) };
  }
  if let TypeFunc(f) = t {
    return TypeFunc { ...f, param_types: renamed_list(f.param_types, clone_of), ret_type: renamed_nominals(f.ret_type, clone_of) };
  }
  return t;
}

function renamed_list(ts: Type[], clone_of: (Type) => string): Type[] {
  let out: Type[] = [];
  for el in ts {
    out = out.append(renamed_nominals(el, clone_of));
  }
  return out;
}

pub function lanes_spelling(width: i32, kind: i32): string {
  if (kind != LANE_FLOAT) {
    return if (kind == LANE_UNSIGNED && width == 8) { "u8x16" } else { "" };
  }
  if (width == 64) {
    return "f64x2";
  }
  if (width == 32) {
    return "f32x4";
  }
  return "";
}

// The lane type with the name `t`. Call it for a name that lanes_width
// accepts.
pub function lanes_named(t: string): Type {
  return TypeLanes { width: lanes_width(t), kind: lanes_kind(t) };
}

// The kind of an element of the lane type with the name `t`.
pub function lanes_kind(t: string): i32 {
  return if (t == "u8x16") { LANE_UNSIGNED } else { LANE_FLOAT };
}

// The type of one element of a lane type.
pub function lane_elem(l: TypeLanes): Type {
  if (l.kind == LANE_FLOAT) {
    return TypeFloat { width: l.width, polymorphic: false };
  }
  return TypeI32 { is_char: false, width: l.width, unsigned: l.kind == LANE_UNSIGNED, polymorphic: false };
}

// The lane type of a lane builtin, from the start of its name.
pub function lane_builtin_lanes(name: string): TypeLanes {
  let w = lane_builtin_width(name);
  return TypeLanes { width: w, kind: if (w == 8) { LANE_UNSIGNED } else { LANE_FLOAT } };
}

// vec_lanes is the lane type spelled `Vec[n, elem]`, or "" when the portable
// tier has none.
pub function vec_lanes(n: string, elem: string): string {
  for lanes in lane_types() {
    let pair = lane_vec_spellings(lanes);
    if (pair[0] == n && pair[1] == elem) {
      return lanes;
    }
  }
  return "";
}

// lane_types are the lane types of the portable tier.
pub function lane_types(): string[] {
  return ["f64x2", "f32x4"];
}

// lane_vec_spellings are the N and T of `Vec[N, T]` for a lane type.
pub function lane_vec_spellings(lanes: string): string[] {
  if (lanes == "f64x2") {
    return ["2", "f64"];
  }
  if (lanes == "f32x4") {
    return ["4", "f32"];
  }
  return [];
}

// lane_vec_args are the arguments of `Vec[N, T]` that a lane type binds.
pub function lane_vec_args(t: Type): Type[] {
  let TypeLanes(l) = t else {
    return [];
  };
  let nt = lane_vec_spellings(lanes_spelling(l.width, l.kind));
  return [TypeConst { value: nt[0] }, lane_elem(l)];
}

pub function lanes_width(t: string): i32 {
  if (t == "f64x2") {
    return 64;
  }
  if (t == "f32x4") {
    return 32;
  }
  if (t == "u8x16") {
    return 8;
  }
  return 0;
}

pub function lane_builtin_width(name: string): i32 {
  if (name.len() <= 8) {
    return 0;
  }
  if (__mismatch(name, 0, "__f64x2_", 0, 8) == 8) {
    return 64;
  }
  if (__mismatch(name, 0, "__f32x4_", 0, 8) == 8) {
    return 32;
  }
  if (__mismatch(name, 0, "__u8x16_", 0, 8) == 8) {
    return 8;
  }
  return 0;
}

pub function lane_builtin_verb(name: string): string {
  if (lane_builtin_width(name) == 0) {
    return "";
  }
  return slice_unchecked(name, 8, name.len()).to_owned();
}

pub function lane_builtin_params(name: string): Type[] {
  let w = lane_builtin_width(name);
  let lanes = lane_builtin_lanes(name);
  let lt: Type = lanes;
  let e: Type = lane_elem(lanes);
  let i: Type = TypeI32 { is_char: false, width: 32, unsigned: false, polymorphic: false };
  let arr: Type = TypeArray { elem: e, view: false };
  let v = lane_builtin_verb(name);
  if (v == "reverse" || v == "swap_halves") {
    return [lt];
  }
  if (v == "zip_lo" || v == "zip_hi") {
    return [lt, lt];
  }
  if (v == "load_ptr" || v == "load_f32_ptr") {
    return [TypeI32 { is_char: false, width: -1, unsigned: true, polymorphic: false }];
  }
  if (v == "store") {
    return [TypeI32 { is_char: false, width: -1, unsigned: true, polymorphic: false }, lt];
  }
  if (v == "pack") {
    return [TypeLanes { width: 64, kind: LANE_FLOAT }, TypeLanes { width: 64, kind: LANE_FLOAT }];
  }
  if (v == "splat") {
    return [e];
  }
  if (v == "of") {
    let out: Type[] = [];
    while (out.len() < 128 / w) {
      out = out.append(e);
    }
    return out;
  }
  if (v == "lane" || v == "lane_bits") {
    return [lt, i];
  }
  if (v == "load_bytes" || v == "with_bytes") {
    let bytes: Type = TypeArray { elem: TypeI32 { is_char: false, width: 8, unsigned: true, polymorphic: false }, view: false };
    if (v == "load_bytes") {
      return [bytes, i];
    }
    return [bytes, i, lt];
  }
  if (v == "load") {
    return [arr, i];
  }
  if (v == "with") {
    return [arr, i, lt];
  }
  return lane_operands(v, lt);
}

function lane_operands(v: string, lt: Type): Type[] {
  if (v == "mul_add" || v == "select") {
    return [lt, lt, lt];
  }
  if (v == "sqrt" || v == "abs" || v == "floor" || v == "round" || v == "bitmask") {
    return [lt];
  }
  return [lt, lt];
}

pub function lane_builtin_result(name: string): Type {
  let w = lane_builtin_width(name);
  let v = lane_builtin_verb(name);
  return match (v) {
    "lane_bits" => TypeI32 { is_char: false, width: w, unsigned: true, polymorphic: false },
    "store" => TypeVoid { tag: 0 },
    "bitmask" => TypeI32 { is_char: false, width: 32, unsigned: false, polymorphic: false },
    "lane" => lane_elem(lane_builtin_lanes(name)),
    "with_bytes" => TypeArray { elem: TypeI32 { is_char: false, width: 8, unsigned: true, polymorphic: false }, view: false },
    "with" => TypeArray { elem: lane_elem(lane_builtin_lanes(name)), view: false },
    _ => lane_builtin_lanes(name),
  };
}

pub function spelling(t: Type): string {
  match (t) {
    TypeI32(i) => {
      return integer_spelling(i);
    },
    TypeBool(_) => {
      return "boolean";
    },
    TypeString(s) => {
      if (s.tag == 0) {
        return "string";
      }
      if (s.tag == 1) {
        return "str";
      }
      return "";
    },
    TypeFloat(f) => {
      if (f.width == 32) {
        return "f32";
      }
      if (f.width == 64 || f.width == 0 && f.polymorphic) {
        return "f64";
      }
      return "";
    },
    TypeLanes(l) => {
      return lanes_spelling(l.width, l.kind);
    },
    TypeArray(a) => {
      let elem = spelling(a.elem);
      if (elem.len() == 0) {
        return "";
      }
      if (a.view) {
        return "[" + elem + "]";
      }
      return elem + "[]";
    },
    TypeStruct(s) => {
      return nominal_spelling(s.name, s.args);
    },
    TypeUnion(u) => {
      return nominal_spelling(u.name, u.args);
    },
    TypeTuple(tup) => {
      if (tup.elements.len() < 2) {
        return "";
      }
      let fields = type_list_spelling(tup.elements);
      if (fields.len() == 0) {
        return "";
      }
      return "(" + fields + ")";
    },
    TypeFunc(f) => {
      if (!f.params_known) {
        return "";
      }
      let params = param_list_spelling(f);
      if (params.len() == 0 && f.param_types.len() > 0) {
        return "";
      }
      let ret = spelling(f.ret_type);
      if (ret.len() == 0) {
        return "";
      }
      if (f.ret_own) {
        ret = "own " + ret;
      }
      return "((" + params + ") => " + ret + ")";
    },
    TypeMap(m) => {
      let key = spelling(m.key);
      let value = spelling(m.value);
      if (key.len() == 0 || value.len() == 0) {
        return "";
      }
      return "Map[" + key + ", " + value + "]";
    },
    TypeDyn(d) => {
      if (d.traits.len() == 0) {
        return "";
      }
      return "dyn " + d.traits;
    },
    TypeHandle(h) => {
      return handle_spelling(h);
    },
    TypeVoid(_) => {
      return "void";
    },
    TypeNever(_) => {
      return "";
    },
    TypeConst(c) => {
      return c.value;
    },
    TypeUnknown(_) => {
      return "";
    },
    TypeErased(_) => {
      return "";
    }
  }
}

function param_list_spelling(f: TypeFunc): string {
  let out = "";
  for i in 0..f.param_types.len() {
    let one = spelling(f.param_types[i]);
    if (one.len() == 0) {
      return "";
    }
    if (i > 0) {
      out += ", ";
    }
    if (fn_own_at(f, i)) {
      out += "own ";
    }
    out += one;
  }
  return out;
}

function type_list_spelling(ts: Type[]): string {
  let out = "";
  for i in 0..ts.len() {
    let next = spelling(ts[i]);
    if (next.len() == 0) {
      return "";
    }
    if (i > 0) {
      out += ", ";
    }
    out += next;
  }
  return out;
}

function nominal_spelling(name: string, args: Type[]): string {
  if (name.len() == 0 || args.len() == 0) {
    return name;
  }
  let params = type_list_spelling(args);
  if (params.len() == 0) {
    return "";
  }
  return name + "[" + params + "]";
}

// A scalar conversion is implicit only when it preserves every source value.
// Pointer widths retain their separate address arithmetic rules.
pub function lossless_widen(from: Type, to: Type): boolean {
  if let TypeI32(a) = from {
    if let TypeI32(b) = to {
      return integer_widens(a, b);
    }
  }
  if let TypeFloat(a) = from {
    if let TypeFloat(b) = to {
      return !a.polymorphic && !b.polymorphic && a.width < b.width;
    }
  }
  return false;
}

// The common signed type for fixed integers with different signedness.
// A u64 has no signed integer destination that preserves every value.
pub function mixed_integer_join(left: Type, right: Type): Type {
  if let TypeI32(a) = left {
    if let TypeI32(b) = right {
      if (fixed_integer(a) && fixed_integer(b) && a.unsigned != b.unsigned) {
        let width = signed_join_width(a, b);
        let target: Type = TypeI32 { is_char: false, width: width, unsigned: false, polymorphic: false };
        if (fits_signed_join(a, left, width, target) && fits_signed_join(b, right, width, target)) {
          return target;
        }
      }
    }
  }
  return TypeUnknown { reason: "integer operands have no lossless common type" };
}

function fixed_integer(t: TypeI32): boolean {
  return !t.is_char && !t.polymorphic && t.width > 0;
}

function signed_join_width(a: TypeI32, b: TypeI32): i32 {
  if (a.width > 32 || b.width > 32 || a.unsigned && a.width == 32 || b.unsigned && b.width == 32) {
    return 64;
  }
  return 32;
}

function fits_signed_join(t: TypeI32, from: Type, width: i32, target: Type): boolean {
  return !t.unsigned && t.width == width || lossless_widen(from, target);
}

function integer_widens(a: TypeI32, b: TypeI32): boolean {
  if (!fixed_integer(a) || !fixed_integer(b)) {
    return false;
  }
  return a.width < b.width && (a.unsigned == b.unsigned || a.unsigned && !b.unsigned);
}
