import "./ir";
import "./rccertify";
import "./ssa";
import "./util";
import "std/envflag";

// stamp is a digest of the compiler's bytes, so an entry another build wrote is not a hit.
pub struct Memo { on: boolean, path: string, known: util.NameIndex, adds: usize, hits: usize, misses: usize, call_kind: i32, stamp: string }

function version(): string {
  return "11";
}

function keep(): i32 {
  return 200000;
}

pub function off(): Memo {
  let none: string[] = [];
  return Memo { on: false, path: "", known: util.name_index(none), adds: 0 as usize, hits: 0 as usize, misses: 0 as usize, call_kind: 0, stamp: "" };
}

function root(): string {
  match (env("FERN_RC_CERTIFY_MEMO")) {
    Some(v) => {
      if (!envflag.value_on(v)) {
        return "";
      }
      return v;
    },
    None => {}
  }
  return util.cache_base();
}

pub function open(target: string): Memo {
  let dir: string = root();
  if (dir == "") {
    return off();
  }
  let Some(stamp) = build_stamp(dir) else {
    return off();
  };
  let path: string = dir + "/certified/" + version() + "-" + target + ".txt";
  return Memo { on: true, path: path, known: util.name_index(lines_of(path)), adds: buf_new(4096), hits: buf_new(64), misses: buf_new(64), call_kind: ir.K_CALL_DIRECT, stamp: stamp };
}

// A digest of the running compiler's bytes. Builds from the same sources are
// byte for byte the same, so they share entries. The digest is read through a
// file that maps the binary's device, inode, size and modification time to it,
// so a compile hashes its binary only the first time it runs.
function build_stamp(dir: string): Option[string] {
  let path: string = own_binary();
  if (path == "") {
    return None;
  }
  let Ok(r) = open_reader(path) else {
    return None;
  };
  let measured: Result[FileStat, IoError] = r.stat();
  r.close();
  let Ok(st) = measured else {
    return None;
  };
  let at: i64 = util.roll_wide(util.roll_wide(util.digest_start(), st.dev), st.ino);
  let meta: string = util.digest_text(util.roll_wide(util.roll_wide(util.roll_wide(at, st.size), st.mtime), st.mtime_nsec));
  let file: string = dir + "/certified/stamps-" + version() + ".txt";
  let lines: string[] = lines_of(file);
  for line in lines {
    if (line.len() > meta.len() + 1 && util.str_has_prefix(line, meta + " ")) {
      return Some(slice_unchecked(line, meta.len() + 1, line.len()) + "");
    }
  }
  let Ok(raw) = read_file_bytes(path) else {
    return None;
  };
  let bytes: string = string_from_bytes_unchecked(raw);
  let d: i64 = util.roll_wide(util.digest_start(), bytes.len() as i64);
  let stamp: string = util.digest_text(util.roll(util.roll(d, __str_hash(bytes, 0)), __str_hash(bytes, 1)));
  record_stamp(file, lines, meta + " " + stamp);
  return Some(stamp);
}

// Keeps the newest stamps. A lost or torn line costs one hash, never a hit.
function record_stamp(file: string, lines: string[], line: string): void {
  let chunks: string[] = [];
  let from: i32 = 0;
  if (lines.len() >= 64) {
    from = lines.len() - 63;
  }
  for i in from..lines.len() {
    chunks = chunks.append(lines[i] + "\n");
  }
  chunks = chunks.append(line + "\n");
  let cut: i32 = file.len();
  while (cut > 0 && file[cut - 1] != b'/') {
    cut = cut - 1;
  }
  let Ok(made) = create_dir_all(slice_unchecked(file, 0, cut) + "") else {
    return;
  };
  let written: Result[void, IoError] = write_file(file, util.str_join_chunks(chunks));
}

function own_binary(): string {
  if (target_os() == "linux" || target_os() == "android") {
    return "/proc/self/exe";
  }
  let argv: string[] = args();
  if (argv.len() > 0 && has_slash(argv[0])) {
    return argv[0];
  }
  return "";
}

function has_slash(s: string): boolean {
  for i in 0..s.len() {
    if (s[i] == b'/') {
      return true;
    }
  }
  return false;
}

function lines_of(path: string): string[] {
  match (read_file(path)) {
    Ok(text) => {
      return newest(split_lines(text));
    },
    Err(e) => {
      return [];
    }
  }
}

function split_lines(text: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < text.len()) {
    if (text[i] == b'\n') {
      if (i > start) {
        out = out.append(slice_unchecked(text, start, i) + "");
      }
      start = i + 1;
    }
    i = i + 1;
  }
  if (text.len() > start) {
    out = out.append(slice_unchecked(text, start, text.len()) + "");
  }
  return out;
}

function newest(lines: string[]): string[] {
  if (lines.len() <= keep()) {
    return lines;
  }
  let out: string[] = [];
  let i: i32 = lines.len() - keep();
  while (i < lines.len()) {
    out = out.append(lines[i]);
    i = i + 1;
  }
  return out;
}

pub function key(m: Memo, fn_name: string, f: ssa.SFunc, ops: ir.Op[], abis: rccertify.Abis): string {
  let d: i64 = util.roll_text(util.roll_text(util.digest_start(), m.stamp), fn_name);
  d = roll_abi(d, abis.lookup(fn_name));
  d = util.roll(util.roll(util.roll_flag(util.roll(d, f.nparams), f.takes_env), f.nvals), f.blocks.len());
  for o in ops {
    d = util.roll_flag(util.roll(util.roll(util.roll(util.roll(d, o.kind_tag), o.i32_imm), o.width), o.decl), o.unsigned);
    d = util.roll_text(util.roll_wide(util.roll_wide(d, o.i64_imm), f64_bits(o.f64_imm)), o.str);
    if (o.kind_tag == m.call_kind) {
      d = roll_abi(d, abis.lookup(o.str));
    }
  }
  return util.digest_text(d);
}

function roll_abi(d: i64, a: rccertify.Abi): i64 {
  let out: i64 = util.roll_words(util.roll_flag(d, a.known), a.modes);
  out = util.roll_flag(util.roll_flag(out, a.result_unit), a.pair_first);
  out = util.roll(util.roll(util.roll(out, a.pair_second), a.split_second), a.split_third);
  return util.roll_flag(out, a.result_word);
}

pub function hit(m: Memo, k: string): boolean {
  if (!m.on) {
    return false;
  }
  if (m.known.find(k) >= 0) {
    buf_push_byte(m.hits, 1);
    return true;
  }
  buf_push_byte(m.misses, 1);
  return false;
}

pub function add(m: Memo, k: string): void {
  if (m.on) {
    buf_push(m.adds, k + "\n");
  }
}

pub function close(m: Memo): string {
  if (!m.on) {
    return "";
  }
  let summary: string = "hits=" + util.i32_to_string(buf_len(m.hits)) + " misses=" + util.i32_to_string(buf_len(m.misses));
  let adds: string = buf_take(m.adds);
  buf_free(m.adds);
  buf_free(m.hits);
  buf_free(m.misses);
  if (adds.len() > 0) {
    write(m, adds);
  }
  return summary;
}

function write(m: Memo, adds: string): void {
  let cut: i32 = m.path.len();
  while (cut > 0 && m.path[cut - 1] != b'/') {
    cut = cut - 1;
  }
  match (create_dir_all(slice_unchecked(m.path, 0, cut) + "")) {
    Ok(made) => {},
    Err(e) => {
      return;
    }
  }
  let chunks: string[] = [];
  for k in m.known.names {
    chunks = chunks.append(k + "\n");
  }
  chunks = chunks.append(adds);
  match (write_file(m.path, util.str_join_chunks(chunks))) {
    Ok(done) => {},
    Err(e) => {}
  }
}
