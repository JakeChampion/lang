// compiler/rcmemo.fern — the emitted-RC certifier's memo (#11908).
//
// A function's certification depends on nothing but what the certifier
// reads: its lowered ops, which the lift turns into the SSA it walks, its
// own contract and the contracts of the callees it names. The memo keeps
// the digests of the functions one target has certified clean, one file per
// target under the user's cache root, so a compile pays the certifier only
// for a function whose lowering it has not seen before. The default compile
// certifies through it; a report compile does not read it, since a report
// wants every function's census.
//
// FERN_RC_CERTIFY_MEMO=0 turns the memo off; any other value is the
// directory it lives in; unset, it lives under $FERN_CACHE_DIR, else
// $XDG_CACHE_HOME/fern, else $HOME/.cache/fern, the package store's root.
// The file is rewritten whole when an emit ends. Two compiles writing it at
// once can tear a line, and a torn line matches nothing, so the memo is
// never wrong, only forgetful. `version` is part of the file's name: bump
// it when the certifier's model, the rcsigs tables or the lift's marks
// change, so no verdict of the old model is read by the new one.
import "./ir";
import "./rccertify";
import "./ssa";
import "./util";

// Memo is the digests one target has certified clean (`known`), the ones
// this emit adds, and the hit and miss counters, one byte each in a buffer
// as the gate's counters are. Off, nothing is read or written.
pub struct Memo { on: boolean, path: string, known: util.NameIndex, adds: usize, hits: usize, misses: usize, call_kind: i32 }

function version(): string {
  return "5";
}

// keep is how many digests the file keeps when it is rewritten: the newest.
function keep(): i32 {
  return 200000;
}

pub function off(): Memo {
  let none: string[] = [];
  return Memo { on: false, path: "", known: util.name_index(none), adds: 0 as usize, hits: 0 as usize, misses: 0 as usize, call_kind: 0 };
}

// root is the directory the memo lives under, "" for none.
function root(): string {
  match (env("FERN_RC_CERTIFY_MEMO")) {
    Some(v) => {
      if (v == "0") {
        return "";
      }
      return v;
    },
    None => {}
  }
  match (env("FERN_CACHE_DIR")) {
    Some(d) => {
      return d;
    },
    None => {}
  }
  match (env("XDG_CACHE_HOME")) {
    Some(x) => {
      return x + "/fern";
    },
    None => {}
  }
  match (env("HOME")) {
    Some(h) => {
      return h + "/.cache/fern";
    },
    None => {}
  }
  return "";
}

// open reads the memo of `target`, or an off memo when there is nowhere to
// keep one.
pub function open(target: string): Memo {
  let dir: string = root();
  if (dir == "") {
    return off();
  }
  let path: string = dir + "/certified/" + version() + "-" + target + ".txt";
  return Memo { on: true, path: path, known: util.name_index(lines_of(path)), adds: buf_new(4096), hits: buf_new(64), misses: buf_new(64), call_kind: ir.K_CALL_DIRECT };
}

function lines_of(path: string): string[] {
  match (read_file(path)) {
    Ok(text) => {
      return newest(split_lines(text));
    },
    Err(e) => {
      return [];
    }
  }
}

// split_lines is the non-empty lines of `text`.
function split_lines(text: string): string[] {
  let out: string[] = [];
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < text.len()) {
    if (text[i] == b'\n') {
      if (i > start) {
        out = out.append(slice_unchecked(text, start, i) + "");
      }
      start = i + 1;
    }
    i = i + 1;
  }
  if (text.len() > start) {
    out = out.append(slice_unchecked(text, start, text.len()) + "");
  }
  return out;
}

// newest keeps the last `keep()` lines: the file grows by what each compile
// certifies afresh and is pruned from the front.
function newest(lines: string[]): string[] {
  if (lines.len() <= keep()) {
    return lines;
  }
  let out: string[] = [];
  let i: i32 = lines.len() - keep();
  while (i < lines.len()) {
    out = out.append(lines[i]);
    i = i + 1;
  }
  return out;
}

// key digests what the certifier reads of one function: its name (a
// generated helper's contract is read off its name), its own contract, the
// shape of its lifted SSA, every field of its ops the lift reads, and the
// contract of every callee its ops name.
pub function key(m: Memo, fn_name: string, f: ssa.SFunc, ops: ir.Op[], abis: rccertify.Abis): string {
  let d: i64 = util.roll_text(util.digest_start(), fn_name);
  d = roll_abi(d, abis.lookup(fn_name));
  d = util.roll(util.roll(util.roll_flag(util.roll(d, f.nparams), f.takes_env), f.nvals), f.blocks.len());
  for o in ops {
    d = util.roll_flag(util.roll(util.roll(util.roll(util.roll(d, o.kind_tag), o.i32_imm), o.width), o.decl), o.unsigned);
    d = util.roll_text(util.roll_wide(util.roll_wide(d, o.i64_imm), f64_bits(o.f64_imm)), o.str);
    if (o.kind_tag == m.call_kind) {
      d = roll_abi(d, abis.lookup(o.str));
    }
  }
  return util.digest_text(d);
}

function roll_abi(d: i64, a: rccertify.Abi): i64 {
  let out: i64 = util.roll_words(util.roll_flag(d, a.known), a.modes);
  out = util.roll_flag(util.roll_flag(out, a.result_unit), a.pair_first);
  return util.roll_flag(util.roll(out, a.pair_second), a.result_word);
}

// hit says whether `k` was certified clean before, and counts.
pub function hit(m: Memo, k: string): boolean {
  if (!m.on) {
    return false;
  }
  if (m.known.find(k) >= 0) {
    buf_push_byte(m.hits, 1);
    return true;
  }
  buf_push_byte(m.misses, 1);
  return false;
}

// add records a function this emit certified clean.
pub function add(m: Memo, k: string): void {
  if (m.on) {
    buf_push(m.adds, k + "\n");
  }
}

// close writes the memo back with what this emit added, releases the
// counters, and returns the hit and miss counts as text, "" when off.
pub function close(m: Memo): string {
  if (!m.on) {
    return "";
  }
  let summary: string = "hits=" + util.i32_to_string(buf_len(m.hits)) + " misses=" + util.i32_to_string(buf_len(m.misses));
  let adds: string = buf_take(m.adds);
  buf_free(m.adds);
  buf_free(m.hits);
  buf_free(m.misses);
  if (adds.len() > 0) {
    write(m, adds);
  }
  return summary;
}

// write rewrites the file: the digests it held, then the new ones. A
// directory that cannot be made or a file that cannot be written leaves the
// memo as it was; the next compile certifies again.
function write(m: Memo, adds: string): void {
  let cut: i32 = m.path.len();
  while (cut > 0 && m.path[cut - 1] != b'/') {
    cut = cut - 1;
  }
  match (create_dir_all(slice_unchecked(m.path, 0, cut) + "")) {
    Ok(made) => {},
    Err(e) => {
      return;
    }
  }
  let chunks: string[] = [];
  for k in m.known.names {
    chunks = chunks.append(k + "\n");
  }
  chunks = chunks.append(adds);
  match (write_file(m.path, util.str_join_chunks(chunks))) {
    Ok(done) => {},
    Err(e) => {}
  }
}
