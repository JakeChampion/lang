import "./asmcore";
import "./physicalbody";
import "./semrecords";
import "./semtypes";
import "./ssacapacityisa" as isa;
import "./ssacreditorigin" as origin;
import "./ssacreditselected" as selected;
import "./ssacredittext" as retained;
import "./ssadecrementtext" as text;
import "./ssaprepare";
import "./ssasem";
import "./typeinfo";
import "std/string";

// tag is the constant in the header of the box: the number of words in its
// low 16 bits and the number of the shape above them.
pub struct Boundary { shape: string, tag: i64, fields: string[], words: i32, error: string }

function failure(message: string): Boundary {
  return Boundary { shape: "", tag: 0i64, fields: [], words: 0, error: message };
}

function schema(m: physicalbody.Metadata, c: ssasem.Contract): semrecords.Record[] {
  if (!selected.compatible(m, m, c.result, 0)) {
    return [];
  }
  let found: semrecords.Record[] = [];
  for record in m.records.list {
    if (semtypes.equal(record.ty, c.result)) {
      found = found.append(record);
    }
  }
  return found;
}

function field_matches(field: semrecords.Field, parameter: typeinfo.Type, mode: i32): boolean {
  return field.name != "" && typeinfo.is_exact_i32(field.ty) && semtypes.equal(field.ty, parameter) && mode == 1;
}

function fields(record: semrecords.Record, c: ssasem.Contract): string[] {
  if (record.fields.len() < 1 || record.fields.len() > 2 || record.fields.len() != c.params.len() || c.params.len() != c.modes.len()) {
    return [];
  }
  let names: string[] = [];
  let i = 0;
  for field in record.fields {
    if (!field_matches(field, c.params[i], c.modes[i])) {
      return [];
    }
    for name in names {
      if (name == field.name) {
        return [];
      }
    }
    names = names.append(field.name);
    i += 1;
  }
  return names;
}

// The tag that the body stores in the header of its box: the constant that
// the one 32-bit store at offset -4 of the result takes. 0 for none.
function shape_tag(output: string, name: string): i64 {
  let p = isa.constructor_program(output, "__fn_" + asmcore.sanitize_label(name));
  if (p.error != "") {
    return 0i64;
  }
  let found = 0i64;
  for i in 0..p.ops.len() {
    let op = p.ops[i];
    if (op.kind == 4 && op.width == 32 && op.base == 0 && op.index == -1 && op.offset == -4) {
      if (found != 0i64) {
        return 0i64;
      }
      found = constant_before(p, i, op.source);
    }
  }
  return found;
}

// The constant that the last 32-bit move to `reg` above index `at` gives.
function constant_before(p: isa.ArrayProgram, at: i32, reg: i32): i64 {
  let i = at - 1;
  while (i >= 0) {
    let op = p.ops[i];
    if (op.kind == 5 && op.destination == reg) {
      return if (op.width == 32 && op.immediate > 0) { op.immediate as i64 } else { 0i64 };
    }
    i -= 1;
  }
  return 0i64;
}

pub function resolve(output: ssaprepare.Output, name: string): Boundary {
  let binding = retained.resolve(output, name);
  if (binding.error != "") {
    return failure(binding.error);
  }
  let row = binding.rows[0];
  if (row.context.rc_free_debug || row.context.sanitize || row.context.leak_check) {
    return failure("unsupported constructor runtime mode");
  }
  let contracts = selected.contracts(row);
  if (contracts.len() != 1) {
    return failure("missing or ambiguous constructor ABI");
  }
  let records = schema(selected.metadata(row), contracts[0]);
  if (records.len() != 1) {
    return failure("missing or ambiguous ordinary constructor schema");
  }
  return bind_fields(output, name, row, records[0], contracts[0]);
}

function bind_fields(output: ssaprepare.Output, name: string, row: ssaprepare.Emitted, record: semrecords.Record, c: ssasem.Contract): Boundary {
  let names = fields(record, c);
  if (names.len() == 0) {
    return failure("unsupported ordered i32 constructor fields");
  }
  let shape = semrecords.name_of(record.ty);
  let refs: boolean[] = [];
  for field in names {
    refs = refs.append(false);
  }
  let proof = origin.producer(row.body.formed.f, shape, refs);
  if (!proof.proof.ok || proof.words != names.len()) {
    return failure("unproved same-graph constructor origin");
  }
  let tag = shape_tag(output.text, name);
  if (tag < 65536i64 || tag % 65536i64 != proof.words as i64) {
    return failure("constructor shape tag differs from selected schema");
  }
  return Boundary { shape: shape, tag: tag, fields: names, words: proof.words, error: "" };
}
