import "./ssa";
import "./ssadeps";
import "./ssasem";
import "./semtypes";
import "./typeinfo";
import "./util";

pub struct Merged { f: ssasem.Func, merged: i32 }

struct Same { of: i32[], merged: i32 }

// A scalar read also merges into the same read in a dominating block. A
// counted read does not: semsink decides those, since the merge keeps the
// first read alive across the blocks between them.
struct Across { reads: ssa.SInst[], at: i32[], slots: Slots, dom: ssadeps.Dom }

pub function merge(f: ssasem.Func): Merged {
  let same: Same = Same { of: identity(f.values.len()), merged: 0 };
  let across: Across = scalar_reads(f.graph, f.values);
  let before: i32 = 0 - 1;
  while (same.merged != before) {
    before = same.merged;
    for b in f.graph.blocks {
      same = merge_block(b, f.values, same);
    }
    if (across.reads.len() > 1) {
      same = merge_dominated(across, f.values, same);
    }
  }
  if (same.merged == 0) {
    return Merged { f: f, merged: 0 };
  }
  return Merged { f: replaced(f, same.of), merged: same.merged };
}

pub function replaced(f: ssasem.Func, same: i32[]): ssasem.Func {
  let blocks: ssa.SBlock[] = [];
  for b in f.graph.blocks {
    blocks = blocks.append(rewritten(b, same));
  }
  return ssasem.Func { ...f, graph: ssa.SFunc { ...f.graph, blocks: blocks } };
}

function scalar_reads(g: ssa.SFunc, values: typeinfo.Type[]): Across {
  let reads: ssa.SInst[] = [];
  let at: i32[] = [];
  let first: i32 = 0 - 1;
  let spread: boolean = false;
  for bi in 0..g.blocks.len() {
    for ins in g.blocks[bi].insts {
      if (read(ins.kind_tag) && ins.result >= 0 && ins.result < values.len() && !ssasem.reference(values[ins.result])) {
        reads = reads.append(ins);
        at = at.append(bi);
        if (first < 0) {
          first = bi;
        }
        spread = spread || bi != first;
      }
    }
  }
  if (!spread) {
    return Across { reads: [], at: [], slots: Slots { head: [], next: [] }, dom: ssadeps.Dom { pre: [], post: [], idom: [], by_clock: [] } };
  }
  return Across { reads: reads, at: at, slots: read_slots(reads), dom: ssadeps.dominates(g) };
}

function merge_dominated(a: Across, values: typeinfo.Type[], own same: Same): Same {
  for k in 0..a.reads.len() {
    let r: ssa.SInst = a.reads[k];
    if (same.of[r.result] == r.result) {
      let first: i32 = dominating(a, k, same.of, values);
      if (first >= 0) {
        same = Same { of: same.of.with(r.result, first), merged: same.merged + 1 };
      }
    }
  }
  return same;
}

function dominating(a: Across, k: i32, same: i32[], values: typeinfo.Type[]): i32 {
  let r: ssa.SInst = a.reads[k];
  let i: i32 = a.slots.head[slot_hash(r) & a.slots.head.len() - 1];
  while (i >= 0) {
    if (a.at[i] != a.at[k] && ssadeps.dom_holds(a.dom, a.at[k], a.at[i]) && same_slot(a.reads[i], r, same, values)) {
      return stand_in(same, a.reads[i].result);
    }
    i = a.slots.next[i];
  }
  return 0 - 1;
}

pub struct Slots { head: i32[], next: i32[] }

pub function slot_hash(u: ssa.SInst): i32 {
  return ((u.kind_tag & 1023) * 31 + (u.imm & 65535)) * 31 + (__str_hash(u.str, 0) & 65535);
}

pub function read_slots(reads: ssa.SInst[]): Slots {
  let nb: i32 = 2;
  while (nb <= reads.len() * 2) {
    nb = nb * 2;
  }
  let head: i32[] = util.minus_ones(nb);
  let next: i32[] = util.minus_ones(reads.len());
  let k: i32 = reads.len() - 1;
  while (k >= 0) {
    let b: i32 = slot_hash(reads[k]) & nb - 1;
    next = next.with(k, head[b]);
    head = head.with(b, k);
    k = k - 1;
  }
  return Slots { head: head, next: next };
}

pub function identity(n: i32): i32[] {
  let out: i32[] = __alloc_i32(n);
  let k: i32 = 0;
  while (k < n) {
    out = out.with(k, k);
    k = k + 1;
  }
  return out;
}

function merge_block(b: ssa.SBlock, values: typeinfo.Type[], own same: Same): Same {
  let seen: ssa.SInst[] = [];
  for ins in b.insts {
    if (read(ins.kind_tag) && ins.result >= 0 && ins.result < same.of.len() && same.of[ins.result] == ins.result) {
      let args: i32[] = renamed(ins.args, same.of);
      let first: i32 = earlier(seen, ins, args, values);
      if (first >= 0) {
        same = Same { of: same.of.with(ins.result, first), merged: same.merged + 1 };
      } else {
        seen = seen.append(ssa.SInst { ...ins, args: args });
      }
    }
  }
  return same;
}

function rewritten(b: ssa.SBlock, same: i32[]): ssa.SBlock {
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (ins.result < 0 || ins.result >= same.len() || same[ins.result] == ins.result) {
      insts = insts.append(renamed_inst(ins, same));
    }
  }
  return ssa.SBlock { ...b, insts: insts, term: renamed_term(b.term, same) };
}

function renamed_inst(ins: ssa.SInst, same: i32[]): ssa.SInst {
  let base: i32 = ssasem.update_base(ins);
  if (base >= 0) {
    return ssa.SInst { ...ins, args: renamed(ins.args, same), imm: stand_in(same, base) + 1 };
  }
  return ssa.SInst { ...ins, args: renamed(ins.args, same) };
}

pub function same_slot(a: ssa.SInst, b: ssa.SInst, same: i32[], values: typeinfo.Type[]): boolean {
  return read(a.kind_tag) && a.kind_tag == b.kind_tag && a.imm == b.imm && a.str == b.str
    && same_args(renamed(a.args, same), renamed(b.args, same)) && semtypes.equal(values[a.result], values[b.result]);
}

function read(kind: i32): boolean {
  return kind == ssasem.record_get() || kind == ssasem.tuple_get() || kind == ssasem.variant_get() || kind == ssasem.array_get() || kind == ssasem.str_index();
}

function earlier(seen: ssa.SInst[], ins: ssa.SInst, args: i32[], values: typeinfo.Type[]): i32 {
  for s in seen {
    if (s.kind_tag == ins.kind_tag && s.imm == ins.imm && s.str == ins.str && same_args(s.args, args) && semtypes.equal(values[s.result], values[ins.result])) {
      return s.result;
    }
  }
  return 0 - 1;
}

function same_args(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function renamed(args: i32[], same: i32[]): i32[] {
  let out: i32[] = args;
  let i: i32 = 0;
  while (i < args.len()) {
    let v: i32 = stand_in(same, args[i]);
    if (v != args[i]) {
      out = out.with(i, v);
    }
    i = i + 1;
  }
  return out;
}

pub function stand_in(same: i32[], v: i32): i32 {
  if (v < 0 || v >= same.len()) {
    return v;
  }
  while (same[v] != v) {
    v = same[v];
  }
  return v;
}

function renamed_term(t: ssa.STerm, same: i32[]): ssa.STerm {
  if (t.kind_tag == 3) {
    return ssa.STerm { ...t, cond: stand_in(same, t.cond) };
  }
  if (t.kind_tag == 1) {
    return ssa.STerm { ...t, value: stand_in(same, t.value) };
  }
  return t;
}
