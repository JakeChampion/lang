import "./ir";
import "./irtables";
import "./ssasem";
import "./typeinfo";
import "./util";

pub struct Set { rows: util.NameIndex, classes: string[], indirect: boolean, on: boolean }

pub function none(): Set {
  let no: string[] = [];
  return Set { rows: util.name_index(no), classes: no, indirect: false, on: false };
}

pub function classify(keys: string[], funcs: ssasem.Func[]): Set {
  let rows = util.name_index(keys);
  let marks: boolean[] = [];
  let dyn_calls: boolean[] = [];
  let through: string[][] = [];
  let made: string[] = [];
  let made_sigs: string[] = [];
  let callers: i32[][] = [];
  let i = 0;
  while (i < keys.len()) {
    marks = marks.append(false);
    dyn_calls = dyn_calls.append(false);
    through = through.append([]);
    callers = callers.append([]);
    i += 1;
  }
  i = 0;
  while (i < funcs.len()) {
    for b in funcs[i].graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag == ssasem.call_value()) {
          through = through.with(i, through[i].append(value_sig(funcs[i], [ins.args[0]])));
        } else if (ins.kind_tag == ssasem.closure_new()) {
          made = made.append(ins.str);
          made_sigs = made_sigs.append(value_sig(funcs[i], [ins.result]));
        } else if (ins.kind_tag == ssasem.call() && ssasem.is_dyn_call(ins.str)) {
          dyn_calls = dyn_calls.with(i, true);
        } else if (ins.kind_tag == ssasem.call()) {
          if (ins.str == "__task_park" || ins.str == "__task_park_until") {
            marks = marks.with(i, true);
          }
          let callee = rows.find(ins.str);
          if (callee >= 0) {
            callers = callers.with(callee, callers[callee].append(i));
          }
        }
      }
    }
    i += 1;
  }
  let closed = spread(marks, callers, keys);
  let sigs = closure_sigs(keys, funcs, closed, made, made_sigs);
  let changed = sigs.len() > 0;
  while (changed) {
    changed = false;
    i = 0;
    while (i < keys.len()) {
      if (!closed[i] && !trampoline(keys[i]) && (dyn_calls[i] || calls_through(through[i], sigs))) {
        closed = closed.with(i, true);
        changed = true;
      }
      i += 1;
    }
    if (changed) {
      closed = spread(closed, callers, keys);
      sigs = closure_sigs(keys, funcs, closed, made, made_sigs);
    }
  }
  let any_closure = sigs.len() > 0;
  let names: string[] = [];
  let classes: string[] = [];
  i = 0;
  while (i < keys.len()) {
    if (closed[i]) {
      names = names.append(keys[i]);
      classes = classes.append(result_class(funcs, i));
      if (i < funcs.len() && funcs[i].graph.name != keys[i]) {
        names = names.append(funcs[i].graph.name);
        classes = classes.append(result_class(funcs, i));
      }
    }
    i += 1;
  }
  return Set { rows: util.name_index(names), classes: classes, indirect: any_closure, on: names.len() > 0 };
}

function closure_sigs(keys: string[], funcs: ssasem.Func[], closed: boolean[], made: string[], made_sigs: string[]): string[] {
  let out: string[] = [];
  let i = 0;
  while (i < keys.len() && i < funcs.len()) {
    if (closed[i] && is_lifted(keys[i])) {
      for sig in made_as(keys[i], funcs[i].graph.name, made, made_sigs) {
        if (!util.has_str(out, sig)) {
          out = out.append(sig);
        }
      }
    }
    i += 1;
  }
  return out;
}

function made_as(key: string, name: string, made: string[], made_sigs: string[]): string[] {
  let sigs: string[] = [];
  let k = 0;
  while (k < made.len()) {
    if (made[k] == key || made[k] == name) {
      sigs = sigs.append(made_sigs[k]);
    }
    k += 1;
  }
  if (sigs.len() == 0) {
    return [""];
  }
  return sigs;
}

function value_sig(f: ssasem.Func, args: i32[]): string {
  if (args.len() == 0 || args[0] >= f.values.len()) {
    return "";
  }
  match (f.values[args[0]]) {
    typeinfo.TypeFunc(ft) => {
      if (ft.params_known) {
        return sig_of(ft.param_types, ft.ret_type);
      }
    },
    _ => {}
  }
  return "";
}

function sig_of(params: typeinfo.Type[], result: typeinfo.Type): string {
  let s = "(";
  let i = 0;
  while (i < params.len()) {
    if (i > 0) {
      s += ", ";
    }
    s += typeinfo.spelling(params[i]);
    i += 1;
  }
  return s + ") => " + typeinfo.spelling(result);
}

function calls_through(through: string[], sigs: string[]): boolean {
  for t in through {
    if (t == "" || util.has_str(sigs, "") || util.has_str(sigs, t)) {
      return true;
    }
  }
  return false;
}

function result_class(funcs: ssasem.Func[], i: i32): string {
  if (i >= funcs.len()) {
    return "w";
  }
  if (ssasem.is_wide(funcs[i].result)) {
    return "i64";
  }
  if (ssasem.is_float(funcs[i].result)) {
    return "f64";
  }
  return "w";
}

function trampoline(key: string): boolean {
  return util.str_has_prefix(key, "async__run_task");
}

function is_lifted(key: string): boolean {
  return __memchr(key, 36, 0) >= 0;
}

function spread(seed: boolean[], callers: i32[][], keys: string[]): boolean[] {
  let marks = seed;
  let work: i32[] = [];
  let i = 0;
  while (i < marks.len()) {
    if (marks[i] && trampoline(keys[i])) {
      marks = marks.with(i, false);
    }
    if (marks[i]) {
      work = work.append(i);
    }
    i += 1;
  }
  let next = 0;
  while (next < work.len()) {
    for c in callers[work[next]] {
      if (!marks[c] && !trampoline(keys[c])) {
        marks = marks.with(c, true);
        work = work.append(c);
      }
    }
    next += 1;
  }
  return marks;
}

function is_site(o: ir.Op, set: Set): boolean {
  if (o.kind_tag == 149) {
    return o.str == "__task_park" || o.str == "__fern_task_park" || o.str == "__task_park_until" || o.str == "__fern_task_park_until" || set.rows.has(o.str);
  }
  if (o.kind_tag == 150 || o.kind_tag == 151 || o.kind_tag == 147) {
    return set.indirect;
  }
  return false;
}

struct Tx {
  out: ir.Op[],
  seg: ir.Op[],
  ci: i32,
  tc: i32,
  before: i32[],
  else_of: i32[],
  end_of: i32[],
  carry: ir.Op[][],
  tmps: string[],
  live: i32[],
  saves: i32[][],
  why: string,
}

pub function transform_state(r: irtables.LowerState, set: Set): irtables.LowerState {
  let t = run(r, set);
  if (t.why != "") {
    return irtables.LowerState { ...r, ok: false, why: t.why };
  }
  let i64s = r.i64_slots;
  let f64s = r.f64_slots;
  let j = 0;
  while (j < t.tmps.len()) {
    if (t.tmps[j] == "i64") {
      i64s = i64s.append(r.n_locals + 2 + j);
    }
    if (t.tmps[j] == "f64") {
      f64s = f64s.append(r.n_locals + 2 + j);
    }
    j += 1;
  }
  return irtables.LowerState { ...r, ops: t.out, n_locals: r.n_locals + 2 + t.tmps.len(), i64_slots: i64s, f64_slots: f64s };
}

function run(r: irtables.LowerState, set: Set): Tx {
  let (ops, tmps) = stored_results(r, set);
  let n = ops.len();
  let before: i32[] = [];
  let count = 0;
  let i = 0;
  while (i <= n) {
    before = before.append(count);
    if (i < n && is_site(ops[i], set)) {
      count += 1;
    }
    i += 1;
  }
  let t = Tx { out: [], seg: [], ci: r.n_locals, tc: r.n_locals + 1, before: before, else_of: [], end_of: [], carry: [], tmps: tmps, live: [], saves: [], why: "" };
  if (count == 0) {
    return Tx { ...t, out: ops };
  }
  let else_of: i32[] = [];
  let end_of: i32[] = [];
  i = 0;
  while (i < n) {
    else_of = else_of.append(-1);
    end_of = end_of.append(-1);
    i += 1;
  }
  let stack: i32[] = [];
  i = 0;
  while (i < n) {
    let k = ops[i].kind_tag;
    if (k == 152 || k == 153 || k == 154) {
      stack = stack.append(i);
    } else if (k == 155) {
      else_of = else_of.with(stack[stack.len() - 1], i);
    } else if (k == 156) {
      let opener = stack[stack.len() - 1];
      stack = sub_i32(stack, 0, stack.len() - 1);
      end_of = end_of.with(opener, i);
    }
    i += 1;
  }
  t = Tx { ...t, else_of: else_of, end_of: end_of, live: live_in(ops, else_of, end_of, r.n_locals) };
  i = 0;
  while (i < n && t.why == "") {
    let o = ops[i];
    let k = o.kind_tag;
    if (is_site(o, set)) {
      t = site(t, r, set, ops, i, before[i]);
      if (t.why == "") {
        i = group_end(ops, i) - 1;
      }
    } else if ((k == 152 || k == 153 || k == 154) && site_free(t, ops, i)) {
      t = Tx { ...t, seg: util.append_all(t.seg, sub_ops(ops, i, t.end_of[i] + 1)) };
      i = t.end_of[i];
    } else if (k == 154) {
      t = routed_if(t, r, set, ops, i);
    } else if (k == 158) {
      t = routed_brif(t, r, set, o);
    } else if (k == 152 || k == 153) {
      t = open_scope(t, r, set, ops, i);
      t = Tx { ...t, out: t.out.append(o) };
    } else if (k == 155) {
      t = flush(t);
      t = Tx { ...t, out: t.out.append(o) };
    } else if (k == 156) {
      t = flush(t);
      let top = t.carry.len() - 1;
      t = Tx { ...t, out: t.out.append(o), seg: t.carry[top], carry: sub_carry(t.carry, top) };
    } else if (ir.op_pops(o) < 0) {
      t = Tx { ...t, why: "suspend: " + r.name + ": " + ir.kind_name(k) + " has no modelled stack effect" };
    } else {
      t = Tx { ...t, seg: t.seg.append(o) };
    }
    i += 1;
  }
  if (t.why != "") {
    return t;
  }
  t = flush(t);
  return Tx { ...t, out: util.append_all(prologue(t, r), t.out) };
}

function stored_results(r: irtables.LowerState, set: Set): (ir.Op[], string[]) {
  let none = Tx { out: [], seg: [], ci: r.n_locals, tc: r.n_locals + 1, before: [], else_of: [], end_of: [], carry: [], tmps: [], live: [], saves: [], why: "" };
  let out: ir.Op[] = [];
  let tmps: string[] = [];
  let i = 0;
  while (i < r.ops.len()) {
    let o = r.ops[i];
    out = out.append(o);
    if (is_site(o, set) && ir.op_pushes(o) == 1 && group_end(r.ops, i) < 0) {
      let class = value_class(none, r, set, o);
      if (class != "") {
        let slot = r.n_locals + 2 + tmps.len();
        tmps = tmps.append(class);
        out = out.append(ir.op_store_local(slot));
        out = out.append(ir.op_load_local(slot));
      }
    }
    i += 1;
  }
  return (out, tmps);
}

function arm_end(t: Tx, at: i32): i32 {
  if (t.else_of[at] >= 0) {
    return t.else_of[at];
  }
  return t.end_of[at];
}

function normal_test(t: Tx): ir.Op[] {
  return [ir.op_load_local(t.ci), ir.op_const_i32(-1), ir.op_bin("eq", 0, false)];
}

function flush(t: Tx): Tx {
  if (t.seg.len() == 0) {
    return t;
  }
  if (height(t.seg, 0, t.seg.len()) != 0 && !ends_control(t.seg)) {
    return Tx { ...t, why: "suspend: a segment leaves a value on the operand stack at a scope boundary (" + ir.kind_name(t.seg[t.seg.len() - 1].kind_tag) + ")" };
  }
  let out = util.append_all(t.out, normal_test(t));
  out = out.append(ir.op_if(0));
  out = util.append_all(out, guarded(t.seg));
  out = out.append(ir.op_end());
  return Tx { ...t, out: out, seg: [] };
}

// A construct with no site in it goes into a segment whole: a rewind skips it
// with the rest of the segment, so it needs no guard of its own.
function site_free(t: Tx, ops: ir.Op[], at: i32): boolean {
  let end = t.end_of[at];
  if (end < 0 || t.before[end + 1] != t.before[at]) {
    return false;
  }
  for j in at..end + 1 {
    let k = ops[j].kind_tag;
    if ((k == 152 || k == 153 || k == 154) && ops[j].i32_imm != 0) {
      return false;
    }
  }
  return height(ops, at + 1, end) == 0;
}

// The ops of a segment inside its guard: a branch out of the segment passes
// one more scope, a branch inside a construct of the segment does not.
function guarded(seg: ir.Op[]): ir.Op[] {
  let out: ir.Op[] = [];
  let depth = 0;
  for o in seg {
    let k = o.kind_tag;
    if ((k == 157 || k == 158) && o.i32_imm >= depth) {
      out = out.append(ir.Op { ...o, i32_imm: o.i32_imm + 1 });
    } else {
      out = out.append(o);
    }
    depth += nest_step(k);
  }
  return out;
}

function nest_step(k: i32): i32 {
  if (k == 152 || k == 153 || k == 154) {
    return 1;
  }
  if (k == 156) {
    return -1;
  }
  return 0;
}

function ends_control(seg: ir.Op[]): boolean {
  let depth = 0;
  for o in seg {
    if (depth == 0 && ir.is_terminator_kind(o.kind_tag)) {
      return true;
    }
    depth += nest_step(o.kind_tag);
  }
  return false;
}

function prologue(t: Tx, r: irtables.LowerState): ir.Op[] {
  let out: ir.Op[] = [ir.op_call_direct("__fern_task_mode", 0), ir.op_const_i32(2), ir.op_bin("eq", 0, false), ir.op_if(0)];
  out = out.append(ir.op_call_direct("__fern_task_pop_w", 0));
  out = out.append(ir.op_store_local(t.ci));
  let k = 0;
  while (k < t.saves.len()) {
    let slots = t.saves[k];
    if (slots.len() > 0) {
      out = util.append_all(out, [ir.op_load_local(t.ci), ir.op_const_i32(k), ir.op_bin("eq", 0, false), ir.op_if(0)]);
      out = util.append_all(out, [ir.op_const_i32(slots.len()), ir.op_call_direct("__fern_task_take", 1), ir.op_store_local(t.tc)]);
      let i = 0;
      while (i < slots.len()) {
        out = util.append_all(out, word_at(t, i));
        out = out.append(ir.op_load_i64());
        out = util.append_all(out, from_word(slot_class(t, r, slots[i])));
        out = out.append(ir.op_store_local(slots[i]));
        i += 1;
      }
      out = out.append(ir.op_end());
    }
    k += 1;
  }
  out = out.append(ir.op_else());
  out = out.append(ir.op_const_i32(-1));
  out = out.append(ir.op_store_local(t.ci));
  out = out.append(ir.op_end());
  return out;
}

function slot_class(t: Tx, r: irtables.LowerState, s: i32): string {
  if (s >= r.n_locals + 2) {
    return t.tmps[s - r.n_locals - 2];
  }
  if (util.index_of_i32(r.i64_slots, s) >= 0) {
    return "i64";
  }
  if (util.index_of_i32(r.f64_slots, s) >= 0) {
    return "f64";
  }
  return "w";
}

function site(t: Tx, r: irtables.LowerState, set: Set, ops: ir.Op[], at: i32, k: i32): Tx {
  let call = ops[at];
  let start = arg_start(t.seg, ir.op_pops(call));
  if (start < 0) {
    return Tx { ...t, why: "suspend: " + r.name + ": call site " + util.i32_to_string(k) + " has no argument loads" };
  }
  let args = sub_ops(t.seg, start, t.seg.len());
  for a in args {
    if (!ir.pure_value_op(a)) {
      return Tx { ...t, why: "suspend: " + r.name + ": call site " + util.i32_to_string(k) + " computes an argument with an effect on the operand stack (" + ir.kind_name(a.kind_tag) + ")" };
    }
  }
  let end = group_end(ops, at);
  if (end < 0) {
    return Tx { ...t, why: "suspend: " + r.name + ": call site " + util.i32_to_string(k) + " is not followed by its result's store" };
  }
  let stores = sub_ops(ops, at + 1, end);
  let c = carry_out(t, r, set, start, stores);
  if (c.t.why != "") {
    return c.t;
  }
  let t2 = flush(Tx { ...c.t, seg: c.prefix });
  let out = util.append_all(t2.out, normal_test(t2));
  out = util.append_all(out, [ir.op_load_local(t2.ci), ir.op_const_i32(k), ir.op_bin("eq", 0, false), ir.op_bin("or", 0, false), ir.op_if(0)]);
  out = util.append_all(out, args);
  out = out.append(call);
  out = util.append_all(out, stores);
  out = out.append(ir.op_const_i32(-1));
  out = out.append(ir.op_store_local(t2.ci));
  out = out.append(ir.op_end());
  let saved = site_saves(t2, r, at, call, util.append_all(args, c.carried));
  out = util.append_all(out, [ir.op_call_direct("__fern_task_mode", 0), ir.op_const_i32(1), ir.op_bin("eq", 0, false), ir.op_if(0)]);
  out = util.append_all(out, save_ops(t2, r, saved, k));
  out = out.append(dummy(r));
  out = out.append(ir.op_return());
  out = out.append(ir.op_end());
  return Tx { ...t2, out: out, seg: c.carried, saves: t2.saves.append(saved) };
}

function save_ops(t: Tx, r: irtables.LowerState, saved: i32[], k: i32): ir.Op[] {
  let out: ir.Op[] = [ir.op_const_i32(saved.len() + 1), ir.op_call_direct("__fern_task_reserve", 1), ir.op_store_local(t.tc)];
  let i = 0;
  while (i < saved.len()) {
    out = util.append_all(out, word_at(t, i));
    out = out.append(ir.op_load_local(saved[i]));
    out = util.append_all(out, to_word(slot_class(t, r, saved[i])));
    out = util.append_all(out, [ir.op_store_i64(), ir.op_drop()]);
    i += 1;
  }
  out = util.append_all(out, word_at(t, saved.len()));
  return util.append_all(out, [ir.op_const_i64(k as i64), ir.op_store_i64(), ir.op_drop()]);
}

function word_at(t: Tx, i: i32): ir.Op[] {
  if (i == 0) {
    return [ir.op_load_local(t.tc)];
  }
  return [ir.op_load_local(t.tc), ir.op_const_i32(i * 8), ir.op_bin("add", ir.width_ptr(), true)];
}

function to_word(class: string): ir.Op[] {
  if (class == "f64") {
    return [ir.op_f64_bits()];
  }
  if (class == "i64") {
    return [];
  }
  return [ir.op_int_extend_ptr()];
}

function from_word(class: string): ir.Op[] {
  if (class == "f64") {
    return [ir.op_f64_from_bits()];
  }
  if (class == "i64") {
    return [];
  }
  return [ir.op_int_wrap_ptr()];
}

function group_end(ops: ir.Op[], at: i32): i32 {
  if (at + 1 >= ops.len() || ops[at + 1].kind_tag != 19 && ops[at + 1].kind_tag != 159) {
    return -1;
  }
  let end = at + 2;
  while (end + 1 < ops.len() && ops[end].kind_tag == 385 && ops[end + 1].kind_tag == 19) {
    end += 2;
  }
  return end;
}

function site_saves(t: Tx, r: irtables.LowerState, at: i32, call: ir.Op, again: ir.Op[]): i32[] {
  let n = r.n_locals + 2 + t.tmps.len();
  let keep: boolean[] = [];
  let s = 0;
  while (s < n) {
    keep = keep.append(s < r.n_locals && has_bit(t.live, (at + 1) * words(r.n_locals), s));
    s += 1;
  }
  keep = mark_reads(keep, [call]);
  keep = mark_reads(keep, again);
  for held in t.carry {
    keep = mark_reads(keep, held);
  }
  let out: i32[] = [];
  s = 0;
  while (s < n) {
    if (keep[s] && s != t.ci && s != t.tc) {
      out = out.append(s);
    }
    s += 1;
  }
  return out;
}

function mark_reads(own keep: boolean[], ops: ir.Op[]): boolean[] {
  for o in ops {
    let lo = read_lo(o);
    let hi = lo + read_count(o);
    while (lo < hi) {
      if (lo < keep.len()) {
        keep = keep.with(lo, true);
      }
      lo += 1;
    }
  }
  return keep;
}

function read_lo(o: ir.Op): i32 {
  return o.i32_imm;
}

function read_count(o: ir.Op): i32 {
  if (o.kind_tag == 18) {
    return 1;
  }
  if (o.kind_tag == 147) {
    return o.width;
  }
  return 0;
}

function words(n_slots: i32): i32 {
  return (n_slots + 31) / 32;
}

function has_bit(bits: i32[], base: i32, s: i32): boolean {
  return (bits[base + s / 32] & 1 << s % 32) != 0;
}

function live_in(ops: ir.Op[], else_of: i32[], end_of: i32[], n_slots: i32): i32[] {
  let n = ops.len();
  let w = words(n_slots);
  let f = flow(ops, else_of, end_of);
  let live: i32[] = [];
  let i = 0;
  while (i < (n + 1) * w) {
    live = live.append(0);
    i += 1;
  }
  let changed = true;
  while (changed) {
    changed = false;
    i = n - 1;
    while (i >= 0) {
      let j = 0;
      while (j < w) {
        let after = live[f.next[i] * w + j];
        if (f.jump[i] >= 0) {
          after = after | live[f.jump[i] * w + j];
        }
        let v = live_word(ops[i], j, after);
        if (v != live[i * w + j]) {
          live = live.with(i * w + j, v);
          changed = true;
        }
        j += 1;
      }
      i -= 1;
    }
  }
  return live;
}

function live_word(o: ir.Op, j: i32, after: i32): i32 {
  let v = after;
  if ((o.kind_tag == 19 || o.kind_tag == 20) && o.i32_imm / 32 == j) {
    v = v & (-1 ^ 1 << o.i32_imm % 32);
  }
  let s = read_lo(o);
  let hi = s + read_count(o);
  while (s < hi) {
    if (s / 32 == j) {
      v = v | 1 << s % 32;
    }
    s += 1;
  }
  return v;
}

struct Flow { next: i32[], jump: i32[] }

function flow(ops: ir.Op[], else_of: i32[], end_of: i32[]): Flow {
  let next: i32[] = [];
  let jump: i32[] = [];
  let open: i32[] = [];
  let i = 0;
  while (i < ops.len()) {
    next = next.append(next_op(ops, i, open, end_of));
    jump = jump.append(jump_op(ops, i, open, else_of, end_of));
    let k = ops[i].kind_tag;
    if (k == 152 || k == 153 || k == 154) {
      open = open.append(i);
    } else if (k == 156) {
      open = sub_i32(open, 0, open.len() - 1);
    }
    i += 1;
  }
  return Flow { next: next, jump: jump };
}

function next_op(ops: ir.Op[], at: i32, open: i32[], end_of: i32[]): i32 {
  let k = ops[at].kind_tag;
  if (k == 157) {
    return branch_target(ops, open, end_of, ops[at].i32_imm, ops.len());
  }
  if (k == ir.K_RETURN || k == ir.K_EXIT) {
    return ops.len();
  }
  if (k == 155) {
    return end_of[open[open.len() - 1]];
  }
  return at + 1;
}

function jump_op(ops: ir.Op[], at: i32, open: i32[], else_of: i32[], end_of: i32[]): i32 {
  let k = ops[at].kind_tag;
  if (k == 158) {
    return branch_target(ops, open, end_of, ops[at].i32_imm, ops.len());
  }
  if (k != 154) {
    return -1;
  }
  if (else_of[at] >= 0) {
    return else_of[at] + 1;
  }
  return end_of[at];
}

function branch_target(ops: ir.Op[], open: i32[], end_of: i32[], depth: i32, n: i32): i32 {
  if (depth >= open.len()) {
    return n;
  }
  let opener = open[open.len() - 1 - depth];
  if (ops[opener].kind_tag == 153) {
    return opener;
  }
  return end_of[opener];
}

struct Carried { t: Tx, prefix: ir.Op[], carried: ir.Op[] }

function carry_out(t: Tx, r: irtables.LowerState, set: Set, hi: i32, body: ir.Op[]): Carried {
  let held = height(t.seg, 0, hi);
  let lo = arg_start(sub_ops(t.seg, 0, hi), held);
  if (lo < 0) {
    return Carried { t: Tx { ...t, why: "suspend: " + r.name + ": values on the operand stack the segment did not produce" }, prefix: [], carried: [] };
  }
  let t2 = t;
  let spills: ir.Op[] = [];
  let carried: ir.Op[] = [];
  let end = hi;
  while (end > lo) {
    let s = lo + arg_start(sub_ops(t.seg, lo, end), 1);
    let chain = sub_ops(t.seg, s, end);
    let pure = true;
    for o in chain {
      if (!ir.pure_value_op(o) || o.kind_tag == 18 && stores_slot(body, o.i32_imm)) {
        pure = false;
      }
    }
    if (pure) {
      carried = util.append_all(chain, carried);
    } else {
      let maker = chain[producer_of(chain)];
      let class = value_class(t2, r, set, maker);
      if (class == "") {
        return Carried { t: Tx { ...t2, why: "suspend: " + r.name + ": a value held on the operand stack has no spill class (" + ir.kind_name(maker.kind_tag) + " " + maker.str + ")" }, prefix: [], carried: [] };
      }
      let slot = r.n_locals + 2 + t2.tmps.len();
      t2 = Tx { ...t2, tmps: t2.tmps.append(class) };
      spills = util.append_all(util.append_all(chain, [ir.op_store_local(slot)]), spills);
      carried = util.append_all([ir.op_load_local(slot)], carried);
    }
    end = s;
  }
  return Carried { t: t2, prefix: util.append_all(sub_ops(t.seg, 0, lo), spills), carried: carried };
}

function producer_of(chain: ir.Op[]): i32 {
  let stack: i32[] = [];
  let i = 0;
  while (i < chain.len()) {
    let pops = ir.op_pops(chain[i]);
    if (pops > stack.len()) {
      pops = stack.len();
    }
    stack = sub_i32(stack, 0, stack.len() - pops);
    if (ir.op_pushes(chain[i]) == 1) {
      stack = stack.append(i);
    }
    i += 1;
  }
  if (stack.len() == 0) {
    return chain.len() - 1;
  }
  return stack[stack.len() - 1];
}

function value_class(t: Tx, r: irtables.LowerState, set: Set, o: ir.Op): string {
  if (o.kind_tag == 18) {
    return slot_class(t, r, o.i32_imm);
  }
  if (o.kind_tag == 149) {
    let row = set.rows.find(o.str);
    if (row >= 0) {
      return set.classes[row];
    }
    return "";
  }
  if (o.kind_tag == 87 || o.kind_tag == 138 || o.kind_tag == 142 || o.kind_tag == 98) {
    return "w";
  }
  return "";
}

function height(seg: ir.Op[], lo: i32, hi: i32): i32 {
  let h = 0;
  let i = lo;
  while (i < hi) {
    h = h + ir.op_pushes(seg[i]) - ir.op_pops(seg[i]);
    i += 1;
  }
  return h;
}

function arg_start(seg: ir.Op[], n: i32): i32 {
  if (n < 0) {
    return -1;
  }
  let need = n;
  let j = seg.len();
  while (need > 0 && j > 0) {
    j -= 1;
    need = need - ir.op_pushes(seg[j]) + ir.op_pops(seg[j]);
  }
  if (need != 0) {
    return -1;
  }
  return j;
}

function sub_ops(xs: ir.Op[], lo: i32, hi: i32): ir.Op[] {
  let out: ir.Op[] = [];
  let i = lo;
  while (i < hi) {
    out = out.append(xs[i]);
    i += 1;
  }
  return out;
}

function sub_i32(xs: i32[], lo: i32, hi: i32): i32[] {
  let out: i32[] = [];
  let i = lo;
  while (i < hi) {
    out = out.append(xs[i]);
    i += 1;
  }
  return out;
}

function sub_carry(xs: ir.Op[][], n: i32): ir.Op[][] {
  let out: ir.Op[][] = [];
  let i = 0;
  while (i < n) {
    out = out.append(xs[i]);
    i += 1;
  }
  return out;
}

function stores_slot(ops: ir.Op[], slot: i32): boolean {
  for o in ops {
    if ((o.kind_tag == 19 || o.kind_tag == 20) && o.i32_imm == slot) {
      return true;
    }
  }
  return false;
}

function dummy(r: irtables.LowerState): ir.Op {
  if (r.result_kind == irtables.result_i64()) {
    return ir.op_const_i64(0 as i64);
  }
  if (r.result_kind == irtables.result_f64()) {
    return ir.op_const_f64(0.0);
  }
  return ir.op_const_i32(0);
}

function routed_if(t: Tx, r: irtables.LowerState, set: Set, ops: ir.Op[], at: i32): Tx {
  let t2 = routed_cond(t, r, set, t.before[at + 1], t.before[arm_end(t, at)], sub_ops(ops, at + 1, t.end_of[at]));
  return Tx { ...t2, out: util.append_all(t2.out, [ir.op_load_local(t2.tc), ir.op_if(0)]), seg: [], carry: t2.carry.append(t2.seg) };
}

function routed_brif(t: Tx, r: irtables.LowerState, set: Set, o: ir.Op): Tx {
  let no: ir.Op[] = [];
  let t2 = routed_cond(t, r, set, 0, 0, no);
  return Tx { ...t2, out: util.append_all(t2.out, [ir.op_load_local(t2.tc), o]) };
}

function routed_cond(t: Tx, r: irtables.LowerState, set: Set, lo: i32, hi: i32, body: ir.Op[]): Tx {
  let cstart = arg_start(t.seg, 1);
  if (cstart < 0) {
    return Tx { ...t, why: "suspend: " + r.name + ": a condition is not produced by its own segment" };
  }
  let cond = sub_ops(t.seg, cstart, t.seg.len());
  let c = carry_out(t, r, set, cstart, util.append_all(cond, body));
  if (c.t.why != "") {
    return c.t;
  }
  let out = util.append_all(c.t.out, normal_test(t));
  out = out.append(ir.op_if(0));
  out = util.append_all(out, guarded(util.append_all(c.prefix, cond)));
  out = out.append(ir.op_store_local(t.tc));
  out = out.append(ir.op_else());
  if (hi > lo) {
    out = util.append_all(out, [ir.op_load_local(t.ci), ir.op_const_i32(lo), ir.op_bin("ge_s", 0, false), ir.op_load_local(t.ci), ir.op_const_i32(hi), ir.op_bin("lt_s", 0, false), ir.op_bin("and", 0, false)]);
  } else {
    out = out.append(ir.op_const_i32(0));
  }
  out = out.append(ir.op_store_local(t.tc));
  out = out.append(ir.op_end());
  return Tx { ...c.t, out: out, seg: c.carried };
}

function open_scope(t: Tx, r: irtables.LowerState, set: Set, ops: ir.Op[], at: i32): Tx {
  let c = carry_out(t, r, set, t.seg.len(), sub_ops(ops, at + 1, t.end_of[at]));
  if (c.t.why != "") {
    return c.t;
  }
  let t2 = flush(Tx { ...c.t, seg: c.prefix });
  return Tx { ...t2, carry: t2.carry.append(c.carried) };
}

pub function dump_state_if_asked(r: irtables.LowerState, stage: string): void {
  match (env("FERN_SUSPEND_DUMP")) {
    Some(name) => {
      if (name != r.name) {
        return;
      }
      eprint("== " + r.name + " " + stage + " n_locals=" + util.i32_to_string(r.n_locals));
      let i = 0;
      while (i < r.ops.len()) {
        let o = r.ops[i];
        eprint(util.i32_to_string(i) + " " + ir.kind_name(o.kind_tag) + " " + util.i32_to_string(o.i32_imm) + " " + o.str);
        i += 1;
      }
    },
    None => {}
  }
}
