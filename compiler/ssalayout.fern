// Structured layout of a reducible control-flow graph: every natural loop is
// a contiguous span headed by its header, nested loops are contiguous inside
// their parent, and everything else is in a forward order. Stack-IR emitters
// need exactly this to place `loop` and `block` labels.
import "./ssa";
import "./ssadeps";
import "./util";

// order holds block POSITIONS (indices into f.blocks) in emission order.
// loop_end[i] is the last order index of the loop headed at order index i,
// or -1 when order[i] heads no loop. Only reachable blocks are laid out.
pub struct Layout { ok: boolean, order: i32[], loop_end: i32[] }

// at maps a block id to its position (-1 for an id no block carries); succ
// lists each position's successor positions.
struct Loops { n: i32, header: boolean[], members: boolean[], at: i32[], succ: i32[][] }

function positions(f: ssa.SFunc): i32[] {
  let top: i32 = 0;
  for b in f.blocks {
    if (b.id > top) {
      top = b.id;
    }
  }
  let out: i32[] = [];
  let i: i32 = 0;
  while (i <= top) {
    out = out.append(0 - 1);
    i = i + 1;
  }
  i = 0;
  while (i < f.blocks.len()) {
    if (f.blocks[i].id >= 0) {
      out = out.with(f.blocks[i].id, i);
    }
    i = i + 1;
  }
  return out;
}

function position(at: i32[], id: i32): i32 {
  if (id < 0 || id >= at.len()) {
    return 0 - 1;
  }
  return at[id];
}

function successor_table(f: ssa.SFunc, at: i32[]): i32[][] {
  let out: i32[][] = [];
  for b in f.blocks {
    let t: ssa.STerm = b.term;
    if (t.kind_tag == 2) {
      out = out.append([position(at, t.target)]);
    } else if (t.kind_tag == 3 && t.t == t.f) {
      out = out.append([position(at, t.t)]);
    } else if (t.kind_tag == 3) {
      out = out.append([position(at, t.t), position(at, t.f)]);
    } else {
      out = out.append([]);
    }
  }
  return out;
}

// The natural loop of a back edge: the header plus every block that reaches
// the edge's source without passing through the header.
function absorb(f: ssa.SFunc, own l: Loops, h: i32, u: i32, reachable: boolean[]): Loops {
  // The work stack keeps its storage: `sp` is its depth.
  let work: i32[] = [u];
  let sp: i32 = 1;
  while (sp > 0) {
    sp = sp - 1;
    let x: i32 = work[sp];
    if (x == h || l.members[h * l.n + x]) {
      continue;
    }
    l = Loops { ...l, members: l.members.with(h * l.n + x, true) };
    for pred in f.blocks[x].preds {
      let pi: i32 = position(l.at, pred);
      if (reachable[pi]) {
        work = pushed_at(work, sp, pi);
        sp = sp + 1;
      }
    }
  }
  return l;
}

function pushed_at(own stack: i32[], d: i32, v: i32): i32[] {
  if (d < stack.len()) {
    return stack.with(d, v);
  }
  return stack.append(v);
}

function find_loops(f: ssa.SFunc, reachable: boolean[], dom: ssadeps.Dom): Loops {
  let n: i32 = f.blocks.len();
  let at: i32[] = positions(f);
  let l: Loops = Loops { n: n, header: __alloc_bool(n), members: __alloc_bool(n * n), at: at, succ: successor_table(f, at) };
  let u: i32 = 0;
  while (u < n) {
    if (reachable[u]) {
      for h in l.succ[u] {
        if (ssadeps.dom_holds(dom, u, h)) {
          l = Loops { ...l, header: l.header.with(h, true), members: l.members.with(h * n + h, true) };
          l = absorb(f, l, h, u, reachable);
        }
      }
    }
    u = u + 1;
  }
  return l;
}

// A region is one loop body (or the whole function). Inner loops collapse to
// their headers while the region is ordered, then expand in place.
// representatives maps every position to the lowest outermost header whose loop
// holds it, else to itself, once per region: the ordering below asks for it once
// per edge per round.
function representatives(l: Loops, list: i32[], root: i32): i32[] {
  let out: i32[] = __alloc_i32(l.n);
  let x: i32 = 0;
  while (x < l.n) {
    out = out.with(x, x);
    x = x + 1;
  }
  let taken: boolean[] = __alloc_bool(l.n);
  for h in list {
    if (h != root && l.header[h] && outermost(l, list, root, h)) {
      for y in list {
        if (!taken[y] && l.members[h * l.n + y]) {
          out = out.with(y, h);
          taken = taken.with(y, true);
        }
      }
    }
  }
  return out;
}

function outermost(l: Loops, list: i32[], root: i32, h: i32): boolean {
  for other in list {
    if (other != root && other != h && l.header[other] && l.members[other * l.n + h]) {
      return false;
    }
  }
  return true;
}

function pending_edges(l: Loops, region: boolean[], list: i32[], root: i32, reps: i32[]): i32[] {
  let pending: i32[] = __alloc_i32(l.n);
  for x in list {
    let rx: i32 = reps[x];
    for y in l.succ[x] {
      if (!region[y] || y == root) {
        continue;
      }
      let ry: i32 = reps[y];
      if (rx != ry) {
        pending = pending.with(ry, pending[ry] + 1);
      }
    }
  }
  return pending;
}

// Members lists the region's blocks by representative: those of `r` are
// `list[start[r]]` up to `list[start[r + 1]]`.
struct Members { start: i32[], list: i32[] }

function members_by_rep(l: Loops, list: i32[], reps: i32[]): Members {
  let start: i32[] = __alloc_i32(l.n + 2);
  for x in list {
    let r: i32 = reps[x] + 2;
    start = start.with(r, start[r] + 1);
  }
  let r2: i32 = 2;
  while (r2 < start.len()) {
    start = start.with(r2, start[r2] + start[r2 - 1]);
    r2 = r2 + 1;
  }
  let out: i32[] = __alloc_i32(start[l.n + 1]);
  for x in list {
    let r: i32 = reps[x] + 1;
    out = out.with(start[r], x);
    start = start.with(r, start[r] + 1);
  }
  return Members { start: start, list: out };
}

// Ready counts, per representative, the edges into it from other
// representatives not yet placed; `floor` is a position below which no
// representative is ready, kept so the position-order fallback scans on
// from where it last found one rather than from zero. A representative
// stays ready once it is until it is placed, so the floor only moves back
// when a release brings a lower one to zero.
struct Ready { pending: i32[], floor: i32 }

function release(l: Loops, region: boolean[], root: i32, chosen: i32, own ready: Ready, reps: i32[], members: Members, index: i32[]): Ready {
  let pending: i32[] = ready.pending;
  let floor: i32 = ready.floor;
  let m: i32 = members.start[chosen];
  while (m < members.start[chosen + 1]) {
    let x: i32 = members.list[m];
    for y in l.succ[x] {
      if (!region[y] || y == root) {
        continue;
      }
      let ry: i32 = reps[y];
      if (ry != chosen) {
        let left: i32 = pending[ry] - 1;
        pending = pending.with(ry, left);
        if (left == 0 && index[ry] < floor) {
          floor = index[ry];
        }
      }
    }
    m = m + 1;
  }
  return Ready { pending: pending, floor: floor };
}

// next_ready is the next representative to place and the floor after the
// search: the fallback's answer when it found one, else the region's size.
function next_ready(l: Loops, region: boolean[], list: i32[], ready: Ready, done: boolean[], reps: i32[], previous: i32): (i32, i32) {
  // Follow a ready successor before the stable position-order fallback.
  // In particular, a ready true arm can fall through instead of jumping
  // across an unrelated ready false arm. Region and predecessor constraints
  // still decide eligibility, including around nested loops and joins.
  for successor in l.succ[previous] {
    let candidate: i32 = reps[successor];
    if (region[candidate] && !done[candidate] && ready.pending[candidate] == 0) {
      return (candidate, ready.floor);
    }
  }
  // `list` is ascending, so the first member at or past the floor that is
  // ready is the lowest ready position; `floor` here is an index into it.
  let i: i32 = ready.floor;
  while (i < list.len()) {
    let x: i32 = list[i];
    if (!done[x] && reps[x] == x && ready.pending[x] == 0) {
      return (x, i);
    }
    i = i + 1;
  }
  return (0 - 1, list.len());
}

function row(l: Loops, h: i32): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < l.n) {
    out = out.append(l.members[h * l.n + i]);
    i = i + 1;
  }
  return out;
}

// row_list is the members of h's loop in ascending position.
function row_list(l: Loops, h: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < l.n) {
    if (l.members[h * l.n + i]) {
      out = out.append(i);
    }
    i = i + 1;
  }
  return out;
}

// indexes_of maps each member position to its index in `list`, -1 outside.
function indexes_of(l: Loops, list: i32[]): i32[] {
  let out: i32[] = util.minus_ones(l.n);
  let i: i32 = 0;
  while (i < list.len()) {
    out = out.with(list[i], i);
    i = i + 1;
  }
  return out;
}

function irreducible(): Layout {
  return Layout { ok: false, order: [], loop_end: [] };
}

function complete(list: i32[], done: boolean[], reps: i32[]): boolean {
  for x in list {
    if (!done[reps[x]]) {
      return false;
    }
  }
  return true;
}

// region_order orders the region whose members `region` marks and `list`
// names in ascending position, root first.
function region_order(l: Loops, region: boolean[], list: i32[], root: i32, out: Layout): Layout {
  let start: i32 = out.order.len();
  let reps: i32[] = representatives(l, list, root);
  let members: Members = members_by_rep(l, list, reps);
  let index: i32[] = indexes_of(l, list);
  let ready: Ready = Ready { pending: pending_edges(l, region, list, root, reps), floor: 0 };
  let done: boolean[] = __alloc_bool(l.n);
  let chosen: i32 = root;
  while (chosen >= 0) {
    done = done.with(chosen, true);
    if (chosen != root && l.header[chosen]) {
      out = region_order(l, row(l, chosen), row_list(l, chosen), chosen, out);
      if (!out.ok) {
        return out;
      }
    } else {
      out = Layout { ok: true, order: out.order.append(chosen), loop_end: out.loop_end.append(0 - 1) };
    }
    ready = release(l, region, root, chosen, ready, reps, members, index);
    let (next, floor) = next_ready(l, region, list, ready, done, reps, chosen);
    ready = Ready { ...ready, floor: floor };
    chosen = next;
  }
  if (!complete(list, done, reps)) {
    return irreducible();
  }
  if (l.header[root]) {
    out = Layout { ...out, loop_end: out.loop_end.with(start, out.order.len() - 1) };
  }
  return out;
}

// A failed layout means the reachable graph has a cycle without a single
// dominating header, which no structured `loop` can express.
pub function compute(f: ssa.SFunc, dom: ssadeps.Dom): Layout {
  let reachable: boolean[] = ssadeps.reachable_blocks(f);
  let l: Loops = find_loops(f, reachable, dom);
  return region_order(l, reachable, marked(reachable), position(l.at, f.entry), Layout { ok: true, order: [], loop_end: [] });
}

// marked is the positions `region` marks, ascending.
function marked(region: boolean[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < region.len()) {
    if (region[i]) {
      out = out.append(i);
    }
    i = i + 1;
  }
  return out;
}
