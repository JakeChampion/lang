import "./ssa";
import "./ssadeps";
import "./util";

pub struct Layout { ok: boolean, order: i32[], loop_end: i32[] }

struct Loops { n: i32, header: boolean[], members: boolean[], at: i32[], succ: i32[][] }

function successor_table(f: ssa.SFunc, at: i32[]): i32[][] {
  let out: i32[][] = [];
  for b in f.blocks {
    let t = b.term;
    if (t.kind_tag == ssa.TERM_BR) {
      out = out.append([ssa.position_of(at, t.target)]);
    } else if (t.kind_tag == ssa.TERM_BRIF && t.t == t.f) {
      out = out.append([ssa.position_of(at, t.t)]);
    } else if (t.kind_tag == ssa.TERM_BRIF) {
      out = out.append([ssa.position_of(at, t.t), ssa.position_of(at, t.f)]);
    } else {
      out = out.append([]);
    }
  }
  return out;
}

function absorb(f: ssa.SFunc, own l: Loops, h: i32, u: i32, reachable: boolean[]): Loops {
  let work: i32[] = [u];
  let sp = 1;
  while (sp > 0) {
    sp -= 1;
    let x = work[sp];
    if (x == h || l.members[h * l.n + x]) {
      continue;
    }
    l = Loops { ...l, members: l.members.with(h * l.n + x, true) };
    for pred in f.blocks[x].preds {
      let pi = ssa.position_of(l.at, pred);
      if (reachable[pi]) {
        work = ssadeps.push_at(work, sp, pi);
        sp += 1;
      }
    }
  }
  return l;
}

function find_loops(f: ssa.SFunc, reachable: boolean[], dom: ssadeps.Dom): Loops {
  let n = f.blocks.len();
  let at = ssa.block_positions(f);
  let l = Loops { n: n, header: __alloc_bool(n), members: __alloc_bool(n * n), at: at, succ: successor_table(f, at) };
  let u = 0;
  while (u < n) {
    if (reachable[u]) {
      for h in l.succ[u] {
        if (ssadeps.dom_holds(dom, u, h)) {
          l = Loops { ...l, header: l.header.with(h, true), members: l.members.with(h * n + h, true) };
          l = absorb(f, l, h, u, reachable);
        }
      }
    }
    u += 1;
  }
  return l;
}

function representatives(l: Loops, list: i32[], root: i32): i32[] {
  let out = __alloc_i32(l.n);
  let x = 0;
  while (x < l.n) {
    out = out.with(x, x);
    x += 1;
  }
  let taken = __alloc_bool(l.n);
  for h in list {
    if (h != root && l.header[h] && outermost(l, list, root, h)) {
      for y in list {
        if (!taken[y] && l.members[h * l.n + y]) {
          out = out.with(y, h);
          taken = taken.with(y, true);
        }
      }
    }
  }
  return out;
}

function outermost(l: Loops, list: i32[], root: i32, h: i32): boolean {
  for other in list {
    if (other != root && other != h && l.header[other] && l.members[other * l.n + h]) {
      return false;
    }
  }
  return true;
}

function pending_edges(l: Loops, region: boolean[], list: i32[], root: i32, reps: i32[]): i32[] {
  let pending = __alloc_i32(l.n);
  for x in list {
    let rx = reps[x];
    for y in l.succ[x] {
      if (!region[y] || y == root) {
        continue;
      }
      let ry = reps[y];
      if (rx != ry) {
        pending = pending.with(ry, pending[ry] + 1);
      }
    }
  }
  return pending;
}

struct Members { start: i32[], list: i32[] }

function members_by_rep(l: Loops, list: i32[], reps: i32[]): Members {
  let start = __alloc_i32(l.n + 2);
  for x in list {
    let r = reps[x] + 2;
    start = start.with(r, start[r] + 1);
  }
  let r2 = 2;
  while (r2 < start.len()) {
    start = start.with(r2, start[r2] + start[r2 - 1]);
    r2 += 1;
  }
  let out = __alloc_i32(start[l.n + 1]);
  for x in list {
    let r = reps[x] + 1;
    out = out.with(start[r], x);
    start = start.with(r, start[r] + 1);
  }
  return Members { start: start, list: out };
}

struct Ready { pending: i32[], floor: i32 }

function release(l: Loops, region: boolean[], root: i32, chosen: i32, own ready: Ready, reps: i32[], members: Members, index: i32[]): Ready {
  let pending = ready.pending;
  let floor = ready.floor;
  let m = members.start[chosen];
  while (m < members.start[chosen + 1]) {
    let x = members.list[m];
    for y in l.succ[x] {
      if (!region[y] || y == root) {
        continue;
      }
      let ry = reps[y];
      if (ry != chosen) {
        let left = pending[ry] - 1;
        pending = pending.with(ry, left);
        if (left == 0 && index[ry] < floor) {
          floor = index[ry];
        }
      }
    }
    m += 1;
  }
  return Ready { pending: pending, floor: floor };
}

function next_ready(l: Loops, region: boolean[], list: i32[], ready: Ready, done: boolean[], reps: i32[], previous: i32): (i32, i32) {
  for successor in l.succ[previous] {
    let candidate = reps[successor];
    if (region[candidate] && !done[candidate] && ready.pending[candidate] == 0) {
      return (candidate, ready.floor);
    }
  }
  let i = ready.floor;
  while (i < list.len()) {
    let x = list[i];
    if (!done[x] && reps[x] == x && ready.pending[x] == 0) {
      return (x, i);
    }
    i += 1;
  }
  return (-1, list.len());
}

function row(l: Loops, h: i32): boolean[] {
  let out: boolean[] = [];
  let i = 0;
  while (i < l.n) {
    out = out.append(l.members[h * l.n + i]);
    i += 1;
  }
  return out;
}

function row_list(l: Loops, h: i32): i32[] {
  let out: i32[] = [];
  let i = 0;
  while (i < l.n) {
    if (l.members[h * l.n + i]) {
      out = out.append(i);
    }
    i += 1;
  }
  return out;
}

function indexes_of(l: Loops, list: i32[]): i32[] {
  let out = util.minus_ones(l.n);
  let i = 0;
  while (i < list.len()) {
    out = out.with(list[i], i);
    i += 1;
  }
  return out;
}

function irreducible(): Layout {
  return Layout { ok: false, order: [], loop_end: [] };
}

function complete(list: i32[], done: boolean[], reps: i32[]): boolean {
  for x in list {
    if (!done[reps[x]]) {
      return false;
    }
  }
  return true;
}

function region_order(l: Loops, region: boolean[], list: i32[], root: i32, out: Layout): Layout {
  let start = out.order.len();
  let reps = representatives(l, list, root);
  let members = members_by_rep(l, list, reps);
  let index = indexes_of(l, list);
  let ready = Ready { pending: pending_edges(l, region, list, root, reps), floor: 0 };
  let done = __alloc_bool(l.n);
  let chosen = root;
  while (chosen >= 0) {
    done = done.with(chosen, true);
    if (chosen != root && l.header[chosen]) {
      out = region_order(l, row(l, chosen), row_list(l, chosen), chosen, out);
      if (!out.ok) {
        return out;
      }
    } else {
      out = Layout { ok: true, order: out.order.append(chosen), loop_end: out.loop_end.append(-1) };
    }
    ready = release(l, region, root, chosen, ready, reps, members, index);
    let (next, floor) = next_ready(l, region, list, ready, done, reps, chosen);
    ready = Ready { ...ready, floor: floor };
    chosen = next;
  }
  if (!complete(list, done, reps)) {
    return irreducible();
  }
  if (l.header[root]) {
    out = Layout { ...out, loop_end: out.loop_end.with(start, out.order.len() - 1) };
  }
  return out;
}

pub function compute(f: ssa.SFunc, dom: ssadeps.Dom): Layout {
  let reachable = ssadeps.reachable_blocks(f);
  let l = find_loops(f, reachable, dom);
  return region_order(l, reachable, marked(reachable), ssa.position_of(l.at, f.entry), Layout { ok: true, order: [], loop_end: [] });
}

function marked(region: boolean[]): i32[] {
  let out: i32[] = [];
  let i = 0;
  while (i < region.len()) {
    if (region[i]) {
      out = out.append(i);
    }
    i += 1;
  }
  return out;
}
