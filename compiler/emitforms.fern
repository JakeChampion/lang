import "./ircore";
import "./parser";
import "./util";
import "./wasm_ir";
import "./watbin";
import "./wit_compose";
import "./wit_decode";
import "./wit_fern_world";
import "./wit_proxy_world";

pub const HTTP_ENTRY_STUB: string = "\nimport \"std/wasi_http\";\n@export(\"wasi:http/incoming-handler@0.2.0\", \"handle\")\nfunction __wasi_http_handle(request: i32, response_out: i32): void { wasi_http.serve(request, response_out, handle); }\n";

pub function entry_source(src: string, target: string): string {
  if (target != "wasm32-wasi-http") {
    return src;
  }
  return src + HTTP_ENTRY_STUB;
}

pub function http_entry_refused(entry: parser.Module, target: string, path: string): string {
  if (target != "wasm32-wasi-http") {
    return "";
  }
  let i: i32 = 0;
  while (i < entry.funcs.len()) {
    let fd: parser.FuncDecl = entry.funcs[i];
    if (fd.name == "handle" && fd.receiver_type.len() == 0) {
      let at: string = path + ":" + util.i32_to_string(fd.line) + ":" + util.i32_to_string(fd.col) + ": error[E075]: ";
      if (fd.params.len() == 3) {
        return at + "a wasi:http handler takes `(req, plat)` and no state: the proxy world starts a fresh instance for every request, so nothing carries from one to the next; build a stateful handler for a native target";
      }
      if (fd.params.len() != 2) {
        return at + "a wasi:http handler takes `(req, plat)`; this `handle` takes " + util.i32_to_string(fd.params.len()) + " parameter(s)";
      }
      return "";
    }
    i = i + 1;
  }
  return "fern: -target wasm32-wasi-http: the program declares no `function handle(req: HttpRequest, plat: platform.Platform): HttpResponse` for the host to call";
}

pub function http_refused(why: string): string {
  return "fern: -target wasm32-wasi-http: the proxy world cannot take this handler: " + why;
}

pub function wasm_http_core(full: parser.Module, sub: ircore.Sub): string {
  let needs: string[] = wasm_ir.needs_of(util.append_all(sub.bodies, sub.extra));
  let host: boolean = wasm_ir.component_needs_host(full, sub.switches) || wasm_ir.needs_abort(needs) || wasm_ir.module_extern_needs_heap(full);
  return wasm_ir.emit_module_mode_or_error_sub(full, true, host, sub);
}

pub function wasm_http_component(full: parser.Module, sub: ircore.Sub): wit_compose.Composed {
  let asyncs: parser.FuncDecl[] = util.append_all(wasm_ir.async_exports(full), wasm_ir.async_imports(full));
  if (asyncs.len() > 0) {
    return wit_compose.Composed { bytes: [], refused: "async function " + asyncs[0].name + ": only -target wasm32-wasi lifts an async export or lowers an async import" };
  }
  let wat: string = wasm_http_core(full, sub);
  if (wat.len() == 0) {
    return wit_compose.Composed { bytes: [], refused: "" };
  }
  let core: i32[] = watbin.wat_to_binary(wat);
  let tbody: i32[] = wit_decode.wit_section_body(watbin.hex_to_bytes(wit_proxy_world.proxy_world_payload()), 7);
  return wit_compose.compose_http(tbody, core);
}

function declares_extern(full: parser.Module): boolean {
  let i: i32 = 0;
  while (i < full.funcs.len()) {
    if (full.funcs[i].import_iface.len() > 0) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function wasm_component(full: parser.Module, sub: ircore.Sub): wit_compose.Composed {
  let ap: AsyncPlan = async_plan(full);
  if (ap.refused.len() > 0) {
    return wit_compose.Composed { bytes: [], refused: "fern: -target wasm32-wasi: " + ap.refused };
  }
  let shape: i32 = wasm_ir.lowered_shape(full, sub.switches, util.append_all(sub.bodies, sub.extra));
  let framed: boolean = shape >= 0 && !declares_extern(full) && ap.asy.lifts.len() == 0;
  if (framed && shape == 0) {
    return wit_compose.Composed { bytes: watbin.component_full(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error_sub(full, true, false, sub))), refused: "" };
  }
  let core: wasm_ir.EmittedCore = wasm_ir.emit_core_or_error_sub(full, true, true, sub);
  if (core.wat.len() == 0) {
    return wit_compose.Composed { bytes: [], refused: "" };
  }
  if (framed && wasm_ir.component_framable(core.needs)) {
    return wit_compose.Composed { bytes: framed_component(watbin.wat_to_binary(core.wat), shape), refused: "" };
  }
  let tbody: i32[] = wit_decode.wit_section_body(watbin.hex_to_bytes(wit_fern_world.fern_world_payload()), 7);
  let c: wit_compose.Composed = wit_compose.compose_run(tbody, watbin.wat_to_binary(core.wat), ap.asy);
  if (c.bytes.len() == 0) {
    return wit_compose.Composed { bytes: [], refused: "fern: -target wasm32-wasi: the fern world cannot take this program: " + c.refused };
  }
  return c;
}

struct AsyncPlan { asy: watbin.AsyncSurface, refused: string }

struct AsyncSig { names: string[], types: i32[][], result: i32[], flat: i32, refused: string }

function sig_refused(why: string): AsyncSig {
  return AsyncSig { names: [], types: [], result: [], flat: 0, refused: why };
}

function async_type(t: string, mem: boolean): i32[] {
  let vt: i32 = wasm_ir.async_lift_valtype(t);
  if (vt >= 0) {
    return [vt];
  }
  if (!mem) {
    return [];
  }
  if (t == "string") {
    return [115];
  }
  if (wasm_ir.extern_byte_array_param(t) || wasm_ir.extern_array_param_supported(t)) {
    return [112, wasm_ir.async_lift_valtype(wasm_ir.list_elem(t))];
  }
  if (wasm_ir.extern_tuple_param_supported(t)) {
    let n: i32 = wasm_ir.tuple_type_elem_count(t);
    let out: i32[] = [111, n];
    let i: i32 = 0;
    while (i < n) {
      out = out.append(wasm_ir.async_lift_valtype(wasm_ir.nth_tuple_type_elem(t, i)));
      i = i + 1;
    }
    return out;
  }
  return [];
}

function flat_count(ct: i32[]): i32 {
  if (ct[0] == 111) {
    return ct[1];
  }
  if (ct[0] == 115 || ct[0] == 112) {
    return 2;
  }
  return 1;
}

function async_sig(f: parser.FuncDecl, role: string, mem: boolean): AsyncSig {
  if (f.receiver_type.len() > 0 || f.type_params.len() > 0) {
    return sig_refused("an " + role + " must be a free, non-generic function");
  }
  let names: string[] = [];
  let types: i32[][] = [];
  let flat: i32 = 0;
  for p in f.params {
    let ct: i32[] = async_type(p.type_name, mem);
    if (ct.len() == 0) {
      return sig_refused("parameter " + p.name + " has type " + p.type_name + ", which an " + role + " cannot take yet");
    }
    if (kebab(p.name).len() == 0) {
      return sig_refused("parameter " + p.name + " has no kebab-case form for the component");
    }
    names = names.append(kebab(p.name));
    types = types.append(ct);
    flat = flat + flat_count(ct);
  }
  let rt: i32[] = [];
  if (wasm_ir.returns_value(f.ret_type)) {
    rt = async_type(f.ret_type, mem);
    if (rt.len() == 0 || rt[0] == 111) {
      return sig_refused("the result type " + f.ret_type + " is one an " + role + " cannot take yet");
    }
  }
  return AsyncSig { names: names, types: types, result: rt, flat: flat, refused: "" };
}

function async_plan(full: parser.Module): AsyncPlan {
  let lifts: watbin.AsyncLift[] = [];
  for f in wasm_ir.async_exports(full) {
    let sg: AsyncSig = async_sig(f, "async export", false);
    let name: string = kebab(f.name);
    if (sg.refused.len() == 0 && name.len() == 0) {
      sg = sig_refused("the name has no kebab-case form for the component export");
    }
    if (sg.refused.len() > 0) {
      return plan_refused("async function " + f.name + ": " + sg.refused);
    }
    lifts = lifts.append(watbin.AsyncLift { name: name, core_name: f.name, param_names: sg.names, param_types: sg.types, result: sg.result });
  }
  let lowers: watbin.AsyncLower[] = [];
  for f in wasm_ir.async_imports(full) {
    let sg: AsyncSig = with_streams(f, async_sig(f, "async import", true));
    if (sg.refused.len() == 0 && sg.flat > 4) {
      sg = sig_refused("its parameters flatten to more than four core values, which an async import cannot pass yet");
    }
    if (sg.refused.len() > 0) {
      return plan_refused("async import " + f.name + ": " + sg.refused);
    }
    lowers = lowers.append(watbin.AsyncLower { iface: f.import_iface, name: f.import_wit, param_names: sg.names, param_types: sg.types, result: sg.result });
  }
  return AsyncPlan { asy: watbin.AsyncSurface { lifts: lifts, lowers: lowers }, refused: "" };
}

function with_streams(f: parser.FuncDecl, sg: AsyncSig): AsyncSig {
  if (sg.refused.len() > 0) {
    return sg;
  }
  for k in f.streams {
    let t: string = f.ret_type;
    if (k >= 0) {
      t = f.params[k].type_name;
    }
    let vt: i32 = wasm_ir.async_lift_valtype(wasm_ir.list_elem(t));
    if (vt < 0) {
      return sig_refused("a stream of " + t + " elements, which an async import cannot carry yet");
    }
    if (k < 0) {
      sg = AsyncSig { ...sg, result: [102, 1, vt] };
    } else {
      sg = AsyncSig { ...sg, types: sg.types.with(k, [102, 1, vt]), flat: sg.flat - 1 };
    }
  }
  return sg;
}

function plan_refused(why: string): AsyncPlan {
  return AsyncPlan { asy: watbin.AsyncSurface { lifts: [], lowers: [] }, refused: why };
}

function kebab(id: string): string {
  let out: u8[] = [];
  let word_start: boolean = true;
  for c in id {
    if (c == 95) {
      if (word_start) {
        return "";
      }
      out = out.append(45);
      word_start = true;
    } else {
      if (!kebab_char(c, word_start)) {
        return "";
      }
      out = out.append(c);
      word_start = false;
    }
  }
  if (word_start) {
    return "";
  }
  return string_from_bytes_unchecked(out);
}

function kebab_char(c: u8, word_start: boolean): boolean {
  return c >= 97 && c <= 122 || c >= 48 && c <= 57 && !word_start;
}

function framed_component(core: i32[], shape: i32): i32[] {
  if (shape == 1) {
    return watbin.component_full_io(core);
  }
  if (shape == 2) {
    return watbin.component_full_io_fs(core);
  }
  if (shape == 3) {
    return watbin.component_full_io_fs_write(core);
  }
  if (shape == 4) {
    return watbin.component_full_io_fs_rw(core);
  }
  if (shape == 5) {
    return watbin.component_full_io_random(core);
  }
  if (shape == 6) {
    return watbin.component_full_io_env(core);
  }
  if (shape == 7) {
    return watbin.component_full_io_args(core);
  }
  if (shape == 8) {
    return watbin.component_full_io_clock(core);
  }
  if (shape == 9) {
    return watbin.component_full_io_clock_mono(core);
  }
  if (shape == 10) {
    return watbin.component_full_io_fs_read_env(core);
  }
  if (shape == 11) {
    return watbin.component_full_io_fs_rw_env(core);
  }
  if (shape == 12) {
    return watbin.component_full_io_random_write(core);
  }
  if (shape == 13) {
    return watbin.component_full_io_eprint(core);
  }
  if (shape == 14) {
    return watbin.component_full_io_exit(core);
  }
  if (shape == 15) {
    return watbin.component_full_io_fs_args_read(core);
  }
  if (shape == 17) {
    return watbin.component_full_io_eprint_exit(core);
  }
  return watbin.component_full_io_fs_rw_args(core);
}
