import "./fern_toml";
import "./caps";
import "./modloader";
import "./util";
import "std/string";

pub struct ManifestAt { dir: string, man: fern_toml.Manifest }

struct Holding { dir: string, grants: string[] }

pub function canonical_dir(dir: string): string {
  if (dir.len() > 0 && dir[0] == b'/') {
    return util.clean_path(dir);
  }
  if (target_os() == "wasi") {
    return util.clean_path(dir);
  } else {
    match (getcwd()) {
      Ok(cwd) => {
        return util.clean_path(cwd + "/" + dir);
      },
      Err(_) => {
        return util.clean_path(dir);
      }
    }
  }
}

pub function with_manifest(own mans: ManifestAt[], dir: string, man: fern_toml.Manifest): ManifestAt[] {
  let explicit = false;
  for dep in man.deps {
    if (dep.governed) {
      explicit = true;
    }
  }
  if (!explicit) {
    return mans;
  }
  let key = canonical_dir(dir);
  for i in 0..mans.len() {
    if (mans[i].dir == key) {
      return mans;
    }
  }
  return mans.append(ManifestAt { dir: key, man: man });
}

function union_grant(own held: Holding[], dir: string, grants: string[]): Holding[] {
  let at = -1;
  for i in 0..held.len() {
    if (held[i].dir == dir) {
      at = i;
    }
  }
  if (at < 0) {
    at = held.len();
    held = held.append(Holding { dir: dir, grants: [] });
  }
  let merged = held[at].grants;
  for cap in grants {
    if (!util.has_str(merged, cap)) {
      merged = merged.append(cap);
    }
  }
  return held.with(at, Holding { dir: dir, grants: merged });
}

struct GrantEdge { from: string, to: string, grants: string[] }

function holding_index(held: Holding[], dir: string): i32 {
  for i in 0..held.len() {
    if (held[i].dir == dir) {
      return i;
    }
  }
  return -1;
}

function grant_edges(mans: ManifestAt[]): GrantEdge[] {
  let edges: GrantEdge[] = [];
  for m in mans {
    for dep in m.man.deps {
      if (dep.governed) {
        match (modloader.dependency_dir(m.man, m.dir + "/", dep.name)) {
          Some(dir) => {
            let to = canonical_dir(dir);
            edges = edges.append(GrantEdge { from: m.dir, to: to, grants: dep.caps });
          },
          None => {}
        }
      }
    }
  }
  return edges;
}

function empty_holdings(edges: GrantEdge[]): Holding[] {
  let held: Holding[] = [];
  for edge in edges {
    held = union_grant(held, edge.to, []);
  }
  return held;
}

function holdings(mans: ManifestAt[], root_dir: string): Holding[] {
  let edges = grant_edges(mans);
  let held = empty_holdings(edges);
  let changed = true;
  while (changed) {
    changed = false;
    for edge in edges {
      let from = holding_index(held, edge.from);
      let to = holding_index(held, edge.to);
      let allowed: string[] = [];
      for cap in edge.grants {
        if (from < 0 || edge.from == root_dir || util.has_str(held[from].grants, cap)) {
          if (!util.has_str(held[to].grants, cap)) {
            allowed = allowed.append(cap);
            changed = true;
          }
        }
      }
      if (allowed.len() > 0) {
        held = union_grant(held, edge.to, allowed);
      }
    }
  }
  return held;
}

function sorted_unique(input: string[]): string[] {
  let xs: string[] = [];
  for x in input {
    xs = xs.append(x);
  }
  let i = 1;
  while (i < xs.len()) {
    let j = i;
    while (j > 0 && util.str_less(xs[j], xs[j - 1])) {
      let a = xs[j];
      let b = xs[j - 1];
      xs = xs.with(j - 1, a).with(j, b);
      j -= 1;
    }
    i += 1;
  }
  let out: string[] = [];
  for x in xs {
    if (out.len() == 0 || out[out.len() - 1] != x) {
      out = out.append(x);
    }
  }
  return out;
}

function joined(xs: string[], sep: string): string {
  let out = "";
  for i in 0..xs.len() {
    if (i > 0) {
      out += sep;
    }
    out += xs[i];
  }
  return out;
}

// Refusal is a dependency entry granting more than its package holds, at
// line `line` of the fern.toml in `dir`.
pub struct Refusal { dir: string, line: i32, message: string }

function violations(m: ManifestAt, held: string[], own out: Refusal[]): Refusal[] {
  for dep in m.man.deps {
    if (dep.governed) {
      for cap in sorted_unique(dep.caps) {
        if (!util.has_str(held, cap)) {
          out = out.append(Refusal { dir: m.dir, line: dep.line, message: "dependency \"" + dep.name + "\" of \"" + m.man.name + "\" is granted '" + cap + "' but \"" + m.man.name + "\" itself holds only [" + joined(sorted_unique(held), ", ") + "] (attenuation: a dependency may grant at most what it holds)" });
        }
      }
    }
  }
  return out;
}

function attenuation_refusals(mans: ManifestAt[], held: Holding[], root_dir: string): Refusal[] {
  let dirs: string[] = [];
  for m in mans {
    dirs = dirs.append(m.dir);
  }
  let out: Refusal[] = [];
  for dir in sorted_unique(dirs) {
    let at = holding_index(held, dir);
    for m in mans {
      if (m.dir == dir && at >= 0 && dir != root_dir) {
        out = violations(m, held[at].grants, out);
      }
    }
  }
  return out;
}

pub struct ModuleAt { dir: string, owner_dir: string, name: string, stdlib: boolean }

pub struct Checked { pkgs: caps.Pkg[], refused: Refusal[] }

function within(dir: string, parent: string): boolean {
  return dir == parent || dir.len() > parent.len() && dir.starts_with(parent) && dir[parent.len()] == b'/';
}

pub function checked(mans: ManifestAt[], root: caps.Pkg, modules: ModuleAt[], prefixes: string[]): Checked {
  let held = holdings(mans, root.dir);
  let pkgs: caps.Pkg[] = [root];
  for i in 0..modules.len() {
    let m = modules[i];
    if (!m.stdlib) {
      pkgs = pkgs.append(module_package(m, prefixes[i], root, held));
    }
  }
  return Checked { pkgs: pkgs, refused: attenuation_refusals(mans, held, root.dir) };
}

function module_package(m: ModuleAt, prefix: string, root: caps.Pkg, held: Holding[]): caps.Pkg {
  let dir = m.owner_dir;
  let name = m.name;
  for h in held {
    if (within(m.dir, h.dir) && (!within(m.dir, dir) || h.dir.len() > dir.len())) {
      dir = h.dir;
      name = slice_unchecked(dir, modloader.dirname(dir).len(), dir.len()).to_owned();
    }
  }
  let at = holding_index(held, dir);
  let grants: string[] = [];
  if (at >= 0) {
    grants = held[at].grants;
  }
  return caps.Pkg { module: prefix, dir: dir, name: name, root: dir == root.dir, governed: at >= 0, grants: grants };
}
