import "./fern_toml";
import "./caps";
import "./modloader";
import "./util";

pub struct ManifestAt { dir: string, man: fern_toml.Manifest }

struct Holding { dir: string, grants: string[] }

pub function canonical_dir(dir: string): string {
  if (dir.len() > 0 && dir[0] == b'/') {
    return util.clean_path(dir);
  }
  if (target_os() == "wasi") {
    return util.clean_path(dir);
  } else {
    match (getcwd()) {
      Ok(cwd) => {
        return util.clean_path(cwd + "/" + dir);
      },
      Err(_) => {
        return util.clean_path(dir);
      }
    }
  }
}

pub function with_manifest(own mans: ManifestAt[], dir: string, man: fern_toml.Manifest): ManifestAt[] {
  let explicit: boolean = false;
  for dep in man.deps {
    if (dep.governed) {
      explicit = true;
    }
  }
  if (!explicit) {
    return mans;
  }
  let key: string = canonical_dir(dir);
  let i: i32 = 0;
  while (i < mans.len()) {
    if (mans[i].dir == key) {
      return mans;
    }
    i = i + 1;
  }
  return mans.append(ManifestAt { dir: key, man: man });
}

function union_grant(own held: Holding[], dir: string, grants: string[]): Holding[] {
  let at: i32 = -1;
  let i: i32 = 0;
  while (i < held.len()) {
    if (held[i].dir == dir) {
      at = i;
    }
    i = i + 1;
  }
  if (at < 0) {
    at = held.len();
    held = held.append(Holding { dir: dir, grants: [] });
  }
  let merged: string[] = held[at].grants;
  for cap in grants {
    if (!util.has_str(merged, cap)) {
      merged = merged.append(cap);
    }
  }
  return held.with(at, Holding { dir: dir, grants: merged });
}

struct GrantEdge { from: string, to: string, grants: string[] }

function holding_index(held: Holding[], dir: string): i32 {
  let i: i32 = 0;
  while (i < held.len()) {
    if (held[i].dir == dir) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function grant_edges(mans: ManifestAt[]): GrantEdge[] {
  let edges: GrantEdge[] = [];
  for m in mans {
    for dep in m.man.deps {
      if (dep.governed) {
        match (modloader.dependency_dir(m.man, m.dir + "/", dep.name)) {
          Some(dir) => {
            let to: string = canonical_dir(dir);
            edges = edges.append(GrantEdge { from: m.dir, to: to, grants: dep.caps });
          },
          None => {}
        }
      }
    }
  }
  return edges;
}

function empty_holdings(edges: GrantEdge[]): Holding[] {
  let held: Holding[] = [];
  for edge in edges {
    held = union_grant(held, edge.to, []);
  }
  return held;
}

function holdings(mans: ManifestAt[], root_dir: string): Holding[] {
  let edges: GrantEdge[] = grant_edges(mans);
  let held: Holding[] = empty_holdings(edges);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for edge in edges {
      let from: i32 = holding_index(held, edge.from);
      let to: i32 = holding_index(held, edge.to);
      let allowed: string[] = [];
      for cap in edge.grants {
        if (from < 0 || edge.from == root_dir || util.has_str(held[from].grants, cap)) {
          if (!util.has_str(held[to].grants, cap)) {
            allowed = allowed.append(cap);
            changed = true;
          }
        }
      }
      if (allowed.len() > 0) {
        held = union_grant(held, edge.to, allowed);
      }
    }
  }
  return held;
}

function sorted_unique(input: string[]): string[] {
  let xs: string[] = [];
  for x in input {
    xs = xs.append(x);
  }
  let i: i32 = 1;
  while (i < xs.len()) {
    let j: i32 = i;
    while (j > 0 && util.str_less(xs[j], xs[j - 1])) {
      let a: string = xs[j];
      let b: string = xs[j - 1];
      xs = xs.with(j - 1, a).with(j, b);
      j = j - 1;
    }
    i = i + 1;
  }
  let out: string[] = [];
  for x in xs {
    if (out.len() == 0 || out[out.len() - 1] != x) {
      out = out.append(x);
    }
  }
  return out;
}

function joined(xs: string[], sep: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < xs.len()) {
    if (i > 0) {
      out = out + sep;
    }
    out = out + xs[i];
    i = i + 1;
  }
  return out;
}

pub struct Refusal { path: string, diag: util.Diag }

function violations(m: ManifestAt, held: string[]): Refusal[] {
  let out: Refusal[] = [];
  for dep in m.man.deps {
    if (dep.governed) {
      for cap in dep.caps {
        if (!util.has_str(held, cap)) {
          let message: string = "dependency \"" + dep.name + "\" of \"" + m.man.name + "\" is granted '" + cap + "' but \"" + m.man.name + "\" itself holds only [" + joined(sorted_unique(held), ", ") + "] (attenuation: a dependency may grant at most what it holds)";
          out = out.append(Refusal { path: m.dir + "/fern.toml", diag: util.Diag { code: "E088", message: message, line: dep.line, col: 1, length: 0, fix: None, related: [] } });
        }
      }
    }
  }
  return out;
}

pub struct ModuleAt { dir: string, owner_dir: string, name: string, stdlib: boolean }

pub struct Checked { pkgs: caps.Pkg[], errors: Refusal[] }

function refusal_after(a: Refusal, b: Refusal): boolean {
  if (a.path != b.path) {
    return util.str_less(b.path, a.path);
  }
  if (a.diag.line != b.diag.line) {
    return a.diag.line > b.diag.line;
  }
  return util.str_less(b.diag.message, a.diag.message);
}

function within(dir: string, parent: string): boolean {
  return dir == parent || dir.len() > parent.len() && slice_unchecked(dir, 0, parent.len()) == parent && dir[parent.len()] == b'/';
}

pub function checked(mans: ManifestAt[], root: caps.Pkg, modules: ModuleAt[], prefixes: string[]): Checked {
  let held: Holding[] = holdings(mans, root.dir);
  let errors: Refusal[] = [];
  for m in mans {
    let at: i32 = holding_index(held, m.dir);
    if (at >= 0 && m.dir != root.dir) {
      for err in violations(m, held[at].grants) {
        errors = errors.append(err);
      }
    }
  }
  let pkgs: caps.Pkg[] = [root];
  let i: i32 = 0;
  while (i < modules.len()) {
    let m: ModuleAt = modules[i];
    if (!m.stdlib) {
      pkgs = pkgs.append(module_package(m, prefixes[i], root, held));
    }
    i = i + 1;
  }
  return Checked { pkgs: pkgs, errors: util.sorted_by(errors, refusal_after) };
}

function module_package(m: ModuleAt, prefix: string, root: caps.Pkg, held: Holding[]): caps.Pkg {
  let dir: string = m.owner_dir;
  let name: string = m.name;
  for h in held {
    if (within(m.dir, h.dir) && (!within(m.dir, dir) || h.dir.len() > dir.len())) {
      dir = h.dir;
      name = slice_unchecked(dir, modloader.dirname(dir).len(), dir.len()) + "";
    }
  }
  let at: i32 = holding_index(held, dir);
  let grants: string[] = [];
  if (at >= 0) {
    grants = held[at].grants;
  }
  return caps.Pkg { module: prefix, dir: dir, name: name, root: dir == root.dir, governed: at >= 0, grants: grants };
}
