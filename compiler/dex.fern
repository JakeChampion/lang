// The DEX classes of fern -apk: Java classes whose methods are native
// methods, for an app with no Java source. Each class gets a public
// constructor with no arguments, which calls the constructor of its
// superclass, a static initializer, which calls System.loadLibrary, and the
// field `public static long fern` for the state of the library. ART then
// binds each native method to its Java_ export in that library.
// `compiler/dexfile.fern` writes the file.
import "std/option";
import "std/string";
import "./dexfile";
import "./util";

pub struct Method { name: string, is_static: boolean, ret: string, params: string[] }

pub struct Class { name: string, superclass: string, interfaces: string[], methods: Method[] }

// The DEX descriptor of Java type `t`: "int" is "I", "java.lang.String" is
// "Ljava/lang/String;", and "int[]" is "[I". "String" and "Object" name
// their java.lang classes.
pub function descriptor(t: string): string {
  if (t.ends_with("[]")) {
    return "[" + descriptor(slice_unchecked(t, 0, t.len() - 2).to_owned());
  }
  let java: string[] = ["void", "boolean", "byte", "char", "short", "int", "long", "float", "double"];
  let dex: string[] = ["V", "Z", "B", "C", "S", "I", "J", "F", "D"];
  let k = util.index_of_str(java, t);
  if (k >= 0) {
    return dex[k];
  }
  if (t == "String" || t == "Object") {
    return "Ljava/lang/" + t + ";";
  }
  return "L" + t.replace(".", "/") + ";";
}

// The static initializer: const-string v0 with the name of the library,
// then invoke-static {v0} on System.loadLibrary, then return-void.
function clinit(library: string): dexfile.Code {
  let load = dexfile.Fixup { at: 3, kind: dexfile.METHOD, text: "Ljava/lang/System;", name: "loadLibrary", ret: "V", params: ["Ljava/lang/String;"] };
  let name = dexfile.Fixup { at: 1, kind: dexfile.STRING, text: library, name: "", ret: "", params: [] };
  return dexfile.Code { registers: 1, ins: 0, outs: 1, units: [0x1A, 0, 0x1071, 0, 0, 0x0E], fixups: [name, load], tries: [], catches: [] };
}

// The constructor: invoke-direct {v0} on the constructor of the
// superclass, then return-void.
function init(superclass: string): dexfile.Code {
  let call = dexfile.Fixup { at: 1, kind: dexfile.METHOD, text: superclass, name: "<init>", ret: "V", params: [] };
  return dexfile.Code { registers: 1, ins: 1, outs: 1, units: [0x1070, 0, 0, 0x0E], fixups: [call], tries: [], catches: [] };
}

const ACC_PUBLIC: i32 = 1;

const ACC_STATIC: i32 = 8;

const ACC_NATIVE: i32 = 256;

// Each class has the field `public static long fern`, where the native
// library keeps the state that its Java callbacks need.
const FIELD: string = "fern";

// The class of the DEX file for `c`: its field, its two constructors and
// its native methods.
function class_of(c: Class, library: string): dexfile.Class {
  let methods: dexfile.Method[] = [
    dexfile.Method { name: "<clinit>", ret: "V", params: [], access: ACC_STATIC | dexfile.ACC_CONSTRUCTOR, code: Some(clinit(library)) },
    dexfile.Method { name: "<init>", ret: "V", params: [], access: ACC_PUBLIC | dexfile.ACC_CONSTRUCTOR, code: Some(init(c.superclass)) },
  ];
  for m in c.methods {
    methods = methods.append(dexfile.Method { name: m.name, ret: m.ret, params: m.params, access: ACC_PUBLIC | ACC_NATIVE | (if (m.is_static) { ACC_STATIC } else { 0 }), code: None });
  }
  let field = dexfile.Field { name: FIELD, desc: "J", access: ACC_PUBLIC | ACC_STATIC, value: None };
  return dexfile.Class { desc: c.name, access: ACC_PUBLIC, superclass: c.superclass, interfaces: c.interfaces, source: "", fields: [field], methods: methods };
}

// The DEX file of `classes`. `library` is the name that each static
// initializer gives to System.loadLibrary.
pub function write(classes: Class[], library: string): Result[u8[], string] {
  return dexfile.write(classes.map((c: Class): dexfile.Class => class_of(c, library)), "035");
}

function get32(b: [u8], at: i32): i32 {
  return b[at] as i32 | b[at + 1] as i32 << 8 | b[at + 2] as i32 << 16 | b[at + 3] as i32 << 24;
}

// The descriptor of type `idx` in DEX file `b`.
function type_name(b: [u8], idx: i32): string {
  let string_idx = get32(b, get32(b, 68) + 4 * idx);
  let at = get32(b, get32(b, 60) + 4 * string_idx);
  let n = 0;
  let len = 1;
  for k in 0..5 {
    if (len == k + 1) {
      n = n | (b[at + k] as i32 & 127) << 7 * k;
      if (b[at + k] as i32 >= 128) {
        len = k + 2;
      }
    }
  }
  let out = "";
  for k in at + len..at + len + n {
    unsafe {
      out += string_from_bytes_unchecked([b[k]]);
    }
  }
  return out;
}

// True when a class in DEX file `b` implements the interface `iface`, a
// Java name.
pub function has_implementer(b: [u8], iface: string): boolean {
  if (b.len() < 112) {
    return false;
  }
  let want = descriptor(iface);
  let defs = get32(b, 100);
  for k in 0..get32(b, 96) {
    // interfaces_off of the class definition: a type_list, or 0.
    let list = get32(b, defs + 32 * k + 12);
    if (list != 0) {
      for i in 0..get32(b, list) {
        let idx = b[list + 4 + 2 * i] as i32 | b[list + 5 + 2 * i] as i32 << 8;
        if (type_name(b, idx) == want) {
          return true;
        }
      }
    }
  }
  return false;
}

// The Java name of the first class in DEX file `b` whose superclass is
// `superclass`, a Java name, or "" when there is none.
pub function subclass_of(b: [u8], superclass: string): string {
  let all = subclasses_of(b, superclass);
  if (all.len() == 0) {
    return "";
  }
  return all[0];
}

// The Java names of the classes in DEX file `b` whose superclass is
// `superclass`, in the order of their class definitions.
pub function subclasses_of(b: [u8], superclass: string): string[] {
  let out: string[] = [];
  if (b.len() < 112) {
    return out;
  }
  let want = descriptor(superclass);
  let defs = get32(b, 100);
  for k in 0..get32(b, 96) {
    let at = defs + 32 * k;
    if (type_name(b, get32(b, at + 8)) == want) {
      let d = type_name(b, get32(b, at));
      out = out.append(slice_unchecked(d, 1, d.len() - 1).replace("/", "."));
    }
  }
  return out;
}
