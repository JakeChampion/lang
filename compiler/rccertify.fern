// compiler/rccertify.fern — the certifier of the reference counting the
// physical lowering emits (#11908).
//
// ssaunits.verify_planned replays the abstract unit plan: every unit is moved,
// dropped or returned exactly once. ssarc then lowers that plan to physical
// RC — retains, releases, reuse tokens, takes and steals, grow brackets — and
// nothing checked the ops it emits. This does. It reads the lifted SSA of a
// lowered function (ssa_lift) and nothing of the plan, and accounts, per
// path, the units the function holds:
//
//   - a value's definition says what the frame holds on it (`origin`): an
//     allocation or an owned call result is a fresh unit, a counted parameter
//     a unit handed in, a load or a borrowed parameter nothing, a phi whatever
//     its edges bring;
//   - a retain adds a unit, a release, a move into a callee or a container
//     and a return each spend one;
//   - at a join the counts are met per value, and a disagreement is
//     `unproved` rather than a finding.
//
// A finding is a definite violation: a unit spent that the frame does not
// hold (an over-release, a double move, a return of a borrow), or a unit the
// frame definitely holds when it returns or when the value is redefined (a
// leak). Fail-soft on what it cannot see — an unknown callee poisons its
// operands, a disagreeing join is unproved, an op with no row consumes
// nothing and produces what the lowering's mark says — so a clean report
// over the compiler means no shape it understood is unbalanced, and the
// counters say how much it understood.
//
// Ownership is tracked per rename root: a `copy`, a retain's result and the
// pointer it was handed are one value. The counts are small integers with a
// cap, met exactly, so a value retained once and moved twice is caught where
// a boolean lattice would let the second move through.
//
// # The box the frame proved unique
//
// The lowering releases a box's children inline under `__fern_rc_is_unique`:
// `if unique(b) { release(b.f) ... } release(b)`. A child read inside that
// arm is the frame's to release — the box is about to be freed shallowly and
// nothing else will — so a load from `b` in a block the arm dominates is a
// unit the frame holds (`child`). The same holds under a reuse token's
// nonzero test, since the token is the box itself when it was unique, and in
// the body of a children-only drop helper (`__sem_drop_<T>`), whose parameter
// its caller proved unique. Elsewhere a load is a borrow, and releasing one
// is the finding this exists for.
//
// # The paths a token decides
//
// The lowering pairs a retain under one test of a reuse token with a
// consume under a later test of the same token, so the join between them
// is where the paths disagree and the count met there is unproved. A token
// is one value on every path through its tests, so when the walk leaves a
// count unproved it walks the function again under each value of each
// tested token, on a copy with the edges that value rules out removed
// (`prune_token`): there the token's box is unique wherever the token
// holds, a finding is on a real path, and a count both walks settle is
// settled.

import "./ir";
import "./ssa";
import "./ssadeps";
import "./ssalive";
import "./rcsigs";
import "./util";

// ---- the boundary ---------------------------------------------------------

// The parameter modes, as ssasem spells them.
pub function value_mode(): i32 {
  return 1;
}

pub function borrow_mode(): i32 {
  return 2;
}

pub function counted_mode(): i32 {
  return 3;
}

// A children-only drop helper's parameter: a box the caller proved unique,
// whose every child the body releases and whose own unit stays the caller's.
pub function children_mode(): i32 {
  return 4;
}

// Abi is one function's declared ownership: a mode per parameter, and
// whether its caller owns the result. `known` is false when nothing declared
// it, and the certifier then assumes nothing of the parameters or the result.
//
// A function sempair returns in two words — a pair as its elements, a
// variant as its position and one payload — is read by the words: the
// callee's `ret` spends a unit of the first iff `pair_first`, its `ret_word`
// one of the second iff `pair_second` says so, and a caller's `call_word` is
// a fresh unit on the same terms. `pair_second` is 0 for a scalar word, -1
// for a pair's reference, -2 where nothing is known, and otherwise the set
// of variant tags whose payload is a reference, one bit per tag: the word
// then holds a unit only where the first word is such a tag, which a
// branch on it settles edge by edge. Whether a function IS paired is what
// its body and its call sites say.
//
// `result_word` says the result is a raw word (`usize`), which core/map's
// functions hand counted boxes around in: a unit the body holds may leave
// through such a return, so one is given up where the frame holds one.
pub struct Abi { known: boolean, modes: i32[], result_unit: boolean, pair_first: boolean, pair_second: i32, result_word: boolean }

pub function unknown_abi(): Abi {
  return Abi { known: false, modes: [], result_unit: false, pair_first: false, pair_second: -2, result_word: false };
}

pub function abi(modes: i32[], result_unit: boolean): Abi {
  return Abi { known: true, modes: modes, result_unit: result_unit, pair_first: false, pair_second: -2, result_word: false };
}

// second_holds: a second word carries a unit under `pair_second` at all.
function second_holds(pair_second: i32): boolean {
  return pair_second == -1 || pair_second > 0;
}

// Abis is the module's contracts as plain rows keyed by function name, built
// by the backend from the contracts the lowering handed it.
pub struct Abis { names: util.NameIndex, modes: i32[][], results: boolean[], firsts: boolean[], seconds: i32[], words: boolean[] }

pub function no_abis(): Abis {
  let none: string[] = [];
  return Abis { names: util.name_index(none), modes: [], results: [], firsts: [], seconds: [], words: [] };
}

pub function abis_of(names: string[], modes: i32[][], results: boolean[], firsts: boolean[], seconds: i32[], words: boolean[]): Abis {
  return Abis { names: util.name_index(names), modes: modes, results: results, firsts: firsts, seconds: seconds, words: words };
}

// lookup is `name`'s declared ownership, or the generated helpers' by their
// names: a children-only drop lends a unique box, a whole-value release
// consumes its argument, and neither hands back a unit.
// env_abi: core/map calls these through a function value, the environment
// first: a column release takes its value owned, a key hash or equality
// lends. A scalar column's value is a word, and a wide one's crosses as a
// raw cell core/map frees, which no count covers.
function env_abi(name: string): Abi {
  if (util.str_has_prefix(name, "__sem_key")) {
    return abi([borrow_mode(), borrow_mode(), borrow_mode()], false);
  }
  if (name == "__sem_scalar_release$env" || name == "__sem_cell_release$env") {
    return abi([borrow_mode(), borrow_mode()], false);
  }
  return abi([borrow_mode(), counted_mode()], false);
}

// byte_view_abi: the helpers ssabytes writes in Fern over a borrowed view.
function byte_view_abi(name: string): Abi {
  if (name == "__sem_byte_view_len" || name == "__sem_byte_view_data") {
    return abi([borrow_mode()], false);
  }
  if (name == "__sem_byte_view_slice") {
    return abi([borrow_mode(), value_mode(), value_mode()], true);
  }
  if (name == "__sem_byte_view_release") {
    return abi([counted_mode()], false);
  }
  return unknown_abi();
}

pub function (a: Abis) lookup(name: string): Abi {
  let at: i32 = a.names.find(name);
  if (at >= 0) {
    return Abi { known: true, modes: a.modes[at], result_unit: a.results[at], pair_first: a.firsts[at], pair_second: a.seconds[at], result_word: a.words[at] };
  }
  if (rcsigs.is_children_drop(name)) {
    return abi([children_mode()], false);
  }
  if (env_closure(name)) {
    return env_abi(name);
  }
  if (rcsigs.is_generated_release(name)) {
    return abi([counted_mode()], false);
  }
  return byte_view_abi(name);
}

// env_closure: a generated body core/map calls as a function value, named
// with the `$env` suffix.
function env_closure(name: string): boolean {
  let n: i32 = name.len();
  return n > 4 && slice_unchecked(name, n - 4, n) == "$env" && util.str_has_prefix(name, "__sem_");
}

// ---- the report -----------------------------------------------------------

// Finding is one definite violation: `kind` names the class, `value` the SSA
// value whose unit it concerns (its rename root), `block` the block it was
// found in, `defined` the kind of the value's definition.
pub struct Finding { kind: string, value: i32, block: i32, defined: string, message: string }

pub function render(fn_name: string, x: Finding): string {
  return fn_name + ": " + x.kind + " of v" + util.i32_to_string(x.value) + " (" + x.defined + ") in b"
    + util.i32_to_string(x.block) + ": " + x.message;
}

// Report is one function's verdict and the coverage behind it: how many
// rename roots the walk tracked, how many it left unproved at a return, the
// callees it had no signature for and the IR ops its table does not name.
// `skipped` names why the walk did not run at all, "" when it did.
pub struct Report { findings: Finding[], tracked: i32, unproved: i32, opaque: string[], skipped: string }

function skipped(why: string): Report {
  return Report { findings: [], tracked: 0, unproved: 0, opaque: [], skipped: why };
}

// ---- origins --------------------------------------------------------------

function org_none(): i32 {
  return 0;
}

function org_fresh(): i32 {
  return 1;
}

function org_transferred(): i32 {
  return 2;
}

function org_borrowed(): i32 {
  return 3;
}

function org_merged(): i32 {
  return 4;
}

function org_unknown(): i32 {
  return 5;
}

function org_child(): i32 {
  return 6;
}

// The count a value's definition puts in the frame's hands.
function initial_count(origin: i32): i32 {
  if (origin == org_fresh() || origin == org_transferred() || origin == org_child()) {
    return 1;
  }
  if (origin == org_unknown() || origin == org_merged()) {
    return maybe();
  }
  return 0;
}

function origin_name(origin: i32): string {
  if (origin == org_fresh()) {
    return "fresh";
  }
  if (origin == org_transferred()) {
    return "parameter";
  }
  if (origin == org_borrowed()) {
    return "borrow";
  }
  if (origin == org_merged()) {
    return "phi";
  }
  if (origin == org_child()) {
    return "child";
  }
  if (origin == org_unknown()) {
    return "unknown";
  }
  return "none";
}

// ---- the count lattice ----------------------------------------------------

// A root's state is a count of the units the frame holds on it, or one of
// two marks: `absent`, no definition reached this point, and `maybe`, the
// paths disagree or an opaque call touched it.
function absent(): i32 {
  return -2;
}

function maybe(): i32 {
  return -1;
}

// owed: a unit of a payload read off the box a token holds was spent ahead
// of the null store that takes it (Walk.debt); the store settles it, and a
// death before the store is the spend without a unit it looked like.
function owed(): i32 {
  return -3;
}

// Counts above the cap are unproved rather than tracked: a retain repeated
// round a loop with no release is a leak the fixpoint would otherwise climb
// forever on.
function cap(): i32 {
  return 8;
}

function meet(a: i32, b: i32): i32 {
  if (a == b || b == absent()) {
    return a;
  }
  if (a == absent()) {
    return b;
  }
  return maybe();
}

// ---- the walk's tables ----------------------------------------------------

// Pos locates a value's definition: the block position and the instruction
// index, -1 for a parameter or an undefined value.
struct Defs { block: i32[], at: i32[] }

function definitions(f: ssa.SFunc): Defs {
  let block: i32[] = util.minus_ones(f.nvals);
  let at: i32[] = util.minus_ones(f.nvals);
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let insts: ssa.SInst[] = f.blocks[bi].insts;
    let i: i32 = 0;
    while (i < insts.len()) {
      let r: i32 = insts[i].result;
      if (r >= 0 && r < f.nvals) {
        block = block.with(r, bi);
        at = at.with(r, i);
      }
      i = i + 1;
    }
    bi = bi + 1;
  }
  return Defs { block: block, at: at };
}

function def_of(f: ssa.SFunc, d: Defs, v: i32): ssa.SInst {
  if (v < 0 || v >= d.block.len() || d.block[v] < 0) {
    return ssa.SInst { kind_tag: 0, result: -1, args: [], imm: 0, str: "" };
  }
  return f.blocks[d.block[v]].insts[d.at[v]];
}

// A const_int zero, which the lowering stores to empty a slot and compares a
// token against.
function is_zero(f: ssa.SFunc, d: Defs, v: i32): boolean {
  let ins: ssa.SInst = def_of(f, d, v);
  return ins.kind_tag == 1 && ins.imm == 0;
}

// def_at: `v`'s definition in the walk's function, or, where the region
// uses it but does not define it, in the base walk's.
function def_at(w: Walk, v: i32): ssa.SInst {
  if (w.outer.on && outside(w.f, w.defs, v)) {
    return def_of(w.outer.f, w.outer.defs, v);
  }
  return def_of(w.f, w.defs, v);
}

function zero_at(w: Walk, v: i32): boolean {
  let ins: ssa.SInst = def_at(w, v);
  return ins.kind_tag == 1 && ins.imm == 0;
}

// marked_result: the lowering marked this runtime call's or flat op's
// result a counted reference (ir.counted): a runtime call carries it in
// `imm`, a flat op on the op its `imm` indexes.
function marked_result(w: Walk, ins: ssa.SInst): boolean {
  if (ins.kind_tag == 49 || ins.kind_tag == 50) {
    return (ins.imm & 2) != 0;
  }
  if (ins.kind_tag == 59) {
    return ins.imm >= 0 && ins.imm < w.irops.len() && ir.is_counted(w.irops[ins.imm]);
  }
  return false;
}

function is_call(ins: ssa.SInst, name: string): boolean {
  return ins.kind_tag == 11 && ins.str == name;
}

// A load of a counted reference: a byte-offset read (40) or a checked
// element read (42) the lowering marked (ir.counted, carried as `rc`). An
// unmarked load reads a scalar word — a length, a tag, a number — and holds
// nothing.
function is_load(ins: ssa.SInst): boolean {
  return (ins.kind_tag == 40 || ins.kind_tag == 42) && ins.str == "rc";
}

// The kinds that store their last operand into the box their first names.
function is_store(k: i32): boolean {
  return k == 41 || k == 43 || k == 53 || k == 55;
}

// The kinds carrying an IR op by name: a Fern-compiled runtime helper (49),
// a register-ABI runtime routine (50) and the stack machine's own arm (59).
function is_named_op(k: i32): boolean {
  return k == 49 || k == 50 || k == 59;
}

// ---- roots ------------------------------------------------------------------

// Walk is everything the per-block transfer reads: the function, its tables
// and the boundary, built once per function.
struct Walk {
  f: ssa.SFunc,
  defs: Defs,
  at: i32[],
  root: i32[],
  origin: i32[],
  idx: i32[],
  tracked: i32,
  self_abi: Abi,
  abis: Abis,
  sigs: rcsigs.Table,
  ops: rcsigs.OpTable,
  paired: boolean,
  why: i32[],
  opened: i32[],
  // The ops the function was lifted from: a flat op's `imm` indexes them,
  // and the mark on the op (ir.counted) says its result is a reference.
  irops: ir.Op[],
  // `p + c`: an address inside the object `p` names, which aliases `p`'s
  // root for a spend but carries no unit of its own into a phi.
  derived: boolean[],
  // For a paired call's second word, the first word it is read beside, and
  // that callee's `pair_second` mask; -1 and 0 for any other value.
  pair_tag: i32[],
  pair_mask: i32[],
  pair_words: i32[],
  // How many instructions and terminators read each value.
  uses: i32[],
  dom: ssadeps.Dom,
  // Per block, the boxes proved unique there (Regions.roots), and the
  // block whose branch opened each (Regions.openers).
  regions: i32[][],
  openers: i32[][],
  // The box a token holds (walk_assuming), -1 in the walk without an
  // assumption and the one where the token is null; and, per root, whether
  // it is a payload read off that box where the hold is a fact whose slot
  // the frame then empties: nothing else reaches the box, so the lowering
  // may spend the payload before the store that takes it (owed).
  held: i32,
  reused: boolean[],
  // The phis the function defines, and the base walk's tables for the
  // phis a region uses but does not define (carries).
  phis: i32[],
  outer: Outer,
  // Per root, the blocks holding an instruction whose first operand has
  // that root: the only blocks a slot's events and releases can be in.
  firsts: i32[][],
  // Per box, the phis that carry it (carries).
  carried: i32[][],
  // The roots whose children the frame owns outright (children_boxes), and
  // the null stores' takes (takes_of).
  children: boolean[],
  takes: Takes,
  // The walk defines the parameters at its entry; a region's walk starts
  // from the counts the base handed in (seeded) instead.
  params_at_entry: boolean,
  debt: boolean[],
  // Per value, whether every store of it back into the slot of the held box
  // it was read from has the slot's unit still in place: such a store keeps
  // the slot's unit and spends nothing (apply_store). A store of it into any
  // other slot spends a unit as usual.
  kept: boolean[],
}

// returns_pair: the body sets a second return word, so it is a paired
// callee and its `ret` returns the first word alone.
function returns_pair(f: ssa.SFunc): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 59 && ins.str == "ret_word") {
        return true;
      }
    }
  }
  return false;
}

// paired_call: the instruction after a call that reads its second word.
function paired_call(b: ssa.SBlock, pos: i32): boolean {
  if (pos + 1 >= b.insts.len()) {
    return false;
  }
  let next: ssa.SInst = b.insts[pos + 1];
  return next.kind_tag == 59 && next.str == "call_word";
}

// pair_word_origin classifies a paired call's words: the call itself is the
// first word, the `call_word` after it the second.
function word_origin(a: Abi, second: boolean): i32 {
  if (!a.known) {
    return org_unknown();
  }
  if (!second) {
    if (a.pair_first) {
      return org_fresh();
    }
    return org_none();
  }
  if (second_holds(a.pair_second)) {
    return org_fresh();
  }
  if (a.pair_second == 0) {
    return org_none();
  }
  return org_unknown();
}

// roots resolves every rename: a `copy`, and a helper that hands back the
// operand it was given (the retains). Operands precede their renames in the
// lift's block order, so one pass settles the chains.
struct Roots { root: i32[], derived: boolean[] }

// Alias is what an instruction renames: the operand index it aliases, -1 for
// none, and whether as an address inside the object (`p + c`) rather than
// the object itself.
struct Alias { of: i32, derived: boolean }

// arith_alias: `p + c` and `p - c` name the object `p` does — a tag in the
// pointer's low bits, a cursor's word, an interior address. A scalar's sum
// aliases its scalar, which holds nothing either way.
function arith_alias(f: ssa.SFunc, defs: Defs, ins: ssa.SInst): Alias {
  if (ins.args.len() != 2 || ins.str != "add" && ins.str != "sub") {
    return Alias { of: -1, derived: false };
  }
  let a: ssa.SInst = def_of(f, defs, ins.args[1]);
  if (a.kind_tag == 1) {
    return Alias { of: 0, derived: cursor_step(a.imm) };
  }
  let b: ssa.SInst = def_of(f, defs, ins.args[0]);
  if (ins.str == "add" && b.kind_tag == 1) {
    return Alias { of: 1, derived: cursor_step(b.imm) };
  }
  return Alias { of: -1, derived: false };
}

// cursor_step: a step of whole words is an address inside the object, a
// cursor that carries no unit into a phi; a step below the word is a tag in
// the pointer's low bits (a byte view over a string or an array), which is
// the object's handle and carries its unit wherever it goes.
function cursor_step(c: i32): boolean {
  return c % 8 == 0;
}

function alias_of(f: ssa.SFunc, defs: Defs, sigs: rcsigs.Table, ins: ssa.SInst): Alias {
  if (ins.kind_tag == 7 && ins.args.len() == 1) {
    return Alias { of: 0, derived: false };
  }
  if (ins.kind_tag == 9) {
    return arith_alias(f, defs, ins);
  }
  if (ins.kind_tag == 11 && ins.args.len() > 0) {
    let sg: rcsigs.Sig = sigs.lookup(ins.str);
    if (sg.known && sg.result == rcsigs.result_operand() && sg.arg >= 0 && sg.arg < ins.args.len()) {
      return Alias { of: sg.arg, derived: false };
    }
  }
  return Alias { of: -1, derived: false };
}

function is_zero_const(ins: ssa.SInst): boolean {
  return ins.kind_tag == 1 && ins.imm == 0 && ins.str == "";
}

function roots(f: ssa.SFunc, defs: Defs, sigs: rcsigs.Table): Roots {
  return roots_over(f, defs, sigs, own_roots(f.nvals));
}

// own_roots is every value its own root, derived from nothing.
function own_roots(n: i32): Roots {
  let root: i32[] = __alloc_i32(n);
  let v: i32 = 0;
  while (v < n) {
    root = root.with(v, v);
    v = v + 1;
  }
  return Roots { root: root, derived: __alloc_bool(n) };
}

// roots_over resolves each alias `f` defines through `start`, which gives
// the values `f` does not define their roots.
function roots_over(f: ssa.SFunc, defs: Defs, sigs: rcsigs.Table, start: Roots): Roots {
  let derived: boolean[] = start.derived;
  let root: i32[] = start.root;
  let zero: i32 = -1;
  for b in f.blocks {
    for ins in b.insts {
      if (ins.result < 0 || ins.result >= f.nvals) {
        continue;
      }
      let a: Alias = alias_of(f, defs, sigs, ins);
      if (a.of >= 0) {
        root = root.with(ins.result, root[ins.args[a.of]]);
        derived = derived.with(ins.result, a.derived || derived[ins.args[a.of]]);
      }
      // Every zero is one value: null, and the address of the empty static
      // box, which a uniqueness test and a load name by different constants.
      if (is_zero_const(ins)) {
        if (zero < 0) {
          zero = ins.result;
        } else {
          root = root.with(ins.result, zero);
        }
      }
    }
  }
  return Roots { root: root, derived: derived };
}

// ---- the unique regions -----------------------------------------------------

// Cond is a branch condition's reading: `root` the box whose uniqueness it
// tests, -1 when it tests no uniqueness; `on_true` whether the box is unique
// on the true arm (else on the false arm).
struct Cond { root: i32, on_true: boolean, also: i32[] }

function no_cond(): Cond {
  return Cond { root: -1, on_true: true, also: [] };
}

// Unique is what a word says of a box: the box it proves unique when the
// word is true, -1 for none, and the phis beside the word's phis that
// select that box on the same edges, so are the box where the word holds.
struct Unique { root: i32, also: i32[] }

function no_unique(): Unique {
  return Unique { root: -1, also: [] };
}

// unique_word reads `v` as a uniqueness test of one box: the test itself, or
// a phi of such tests and the constant false — the test hoisted out of an
// arm, or carried across an async frame's resume — through phis of phis.
function unique_word(w: Walk, v: i32, depth: i32): Unique {
  let root: i32 = w.root[v];
  let ins: ssa.SInst = def_of(w.f, w.defs, root);
  if (is_call(ins, "__fern_rc_is_unique") && ins.args.len() == 1) {
    return Unique { root: w.root[ins.args[0]], also: [] };
  }
  if (ins.kind_tag != 8 || depth >= 8) {
    return no_unique();
  }
  let out: Unique = no_unique();
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let a: i32 = ins.args[i];
    if (a < 0) {
      return no_unique();
    }
    if (!zero_at(w, a) && w.root[a] != root) {
      out = unique_input(w, root, i, a, depth, out);
      if (out.root < 0) {
        return no_unique();
      }
    }
    i = i + 1;
  }
  return out;
}

// unique_input folds one non-null input of a phi into what the phi says:
// the input must say the same box, and the phis beside this one that
// select it on this edge are the box too.
function unique_input(w: Walk, phi: i32, i: i32, a: i32, depth: i32, out: Unique): Unique {
  let u: Unique = unique_word(w, a, depth + 1);
  if (u.root < 0 || out.root >= 0 && u.root != out.root) {
    return no_unique();
  }
  let also: i32[] = out.also;
  for x in u.also {
    also = also.append(x);
  }
  also = beside(w, phi, i, u.root, also);
  return Unique { root: u.root, also: also };
}

// beside adds the phis in `phi`'s block that select `box` on edge `i`.
function beside(w: Walk, phi: i32, i: i32, box: i32, also: i32[]): i32[] {
  let out: i32[] = also;
  for q in w.f.blocks[w.defs.block[phi]].insts {
    if (q.kind_tag == 8 && q.result >= 0 && q.result != phi && i < q.args.len() && q.args[i] >= 0 && w.root[q.args[i]] == box && util.index_of_i32(out, q.result) < 0) {
      out = out.append(q.result);
    }
  }
  return out;
}

// token_root is the box a reuse token stands for: a phi of the box on edges
// from blocks where it was proved unique and of null on the rest, through
// copies. -1 for anything else.
function token_root(w: Walk, regions: i32[][], v: i32): i32 {
  let none: i32[] = [];
  let r: i32 = token_root_at(w, regions, v, none);
  if (r == -2) {
    return -1;
  }
  return r;
}

// token_root_at follows a token through phis of phis: each non-null input
// is the box, unique in the block it comes from, or a token of the same box
// — the shape an async frame's resume gives a token carried across a
// suspension.
function token_root_at(w: Walk, regions: i32[][], v: i32, path: i32[]): i32 {
  let root: i32 = w.root[v];
  if (util.index_of_i32(path, root) >= 0) {
    // Back round a loop to a token on the path: it constrains nothing.
    return -2;
  }
  let ins: ssa.SInst = def_of(w.f, w.defs, root);
  if (ins.kind_tag != 8 || path.len() >= 8) {
    return -1;
  }
  return token_inputs(w, regions, ins, w.f.blocks[w.defs.block[root]].preds, path.append(root));
}

// token_inputs folds a token phi's inputs: every non-null one must name
// the same box; -2 when none names one, -1 when one is neither box nor token.
function token_inputs(w: Walk, regions: i32[][], ins: ssa.SInst, preds: i32[], path: i32[]): i32 {
  let found: i32 = -2;
  let i: i32 = 0;
  while (i < ins.args.len() && i < preds.len()) {
    let a: i32 = ins.args[i];
    if (a < 0) {
      return -1;
    }
    if (!zero_at(w, a)) {
      found = token_merge(found, token_input(w, regions, a, w.at[preds[i]], path));
      if (found == -1) {
        return -1;
      }
    }
    i = i + 1;
  }
  return found;
}

// token_merge combines what two inputs say: a box each must agree on, -2
// for no constraint, -1 for a conflict or a non-token.
function token_merge(found: i32, r: i32): i32 {
  if (r == -1 || found == -1) {
    return -1;
  }
  if (r == -2) {
    return found;
  }
  if (found == -2 || found == r) {
    return r;
  }
  return -1;
}

// token_input reads one input of a token phi from predecessor `pi`: the box
// itself when unique there, else a token of the box (-2 when it constrains
// nothing, -1 when it is neither).
function token_input(w: Walk, regions: i32[][], a: i32, pi: i32, path: i32[]): i32 {
  let r: i32 = w.root[a];
  if (pi >= 0 && util.index_of_i32(regions[pi], r) >= 0) {
    return r;
  }
  return token_root_at(w, regions, a, path);
}

// Tested is the word a branch condition tests and the arm it holds on:
// `brif x` on the true arm, `x != 0` likewise, `x == 0` on the false arm.
struct Tested { word: i32, on_true: boolean }

function tested(w: Walk, cond: i32): Tested {
  let ins: ssa.SInst = def_of(w.f, w.defs, cond);
  if (ins.kind_tag != 9 || ins.args.len() != 2 || ins.str != "eq" && ins.str != "ne") {
    return Tested { word: cond, on_true: true };
  }
  let word: i32 = -1;
  if (zero_at(w, ins.args[1])) {
    word = ins.args[0];
  } else if (zero_at(w, ins.args[0])) {
    word = ins.args[1];
  }
  return Tested { word: word, on_true: ins.str == "ne" };
}

function cond_of(w: Walk, regions: i32[][], cond: i32, with_tokens: boolean): Cond {
  let t: Tested = tested(w, cond);
  if (t.word < 0) {
    return no_cond();
  }
  let u: Unique = unique_word(w, t.word, 0);
  if (u.root >= 0) {
    return Cond { root: u.root, on_true: t.on_true, also: u.also };
  }
  if (!with_tokens) {
    return no_cond();
  }
  let r: i32 = token_root(w, regions, t.word);
  if (r >= 0) {
    return Cond { root: r, on_true: t.on_true, also: [] };
  }
  return no_cond();
}

// Regions is, per block, the boxes proved unique there and, in parallel,
// the block whose branch proved each.
struct Regions { roots: i32[][], openers: i32[][] }

// regions_round adds to `regions` the blocks each uniqueness test's arm
// dominates, keyed by the box the test proved unique. An arm that is also
// reached around the test (the join after a one-sided retain) opens nothing.
// open_region adds `root` to every reachable block `arm` dominates, as
// opened by block `by`.
function open_region(own rg: Regions, dom: ssadeps.Dom, reach: boolean[], arm: i32, root: i32, by: i32): Regions {
  if (dom.pre[arm] < 0) {
    return rg;
  }
  let c: i32 = dom.pre[arm];
  while (c < dom.post[arm]) {
    let other: i32 = dom.by_clock[c];
    if (other >= 0 && reach[other] && util.index_of_i32(rg.roots[other], root) < 0) {
      rg = Regions { roots: rg.roots.with(other, rg.roots[other].append(root)), openers: rg.openers.with(other, rg.openers[other].append(by)) };
    }
    c = c + 1;
  }
  return rg;
}

function regions_round(w: Walk, own rg: Regions, dom: ssadeps.Dom, reach: boolean[], with_tokens: boolean): Regions {
  let bi: i32 = 0;
  while (bi < w.f.blocks.len()) {
    let t: ssa.STerm = w.f.blocks[bi].term;
    if (reach[bi] && t.kind_tag == 3 && t.t != t.f) {
      let c: Cond = cond_of(w, rg.roots, t.cond, with_tokens);
      let arm: i32 = w.at[t.f];
      if (c.on_true) {
        arm = w.at[t.t];
      }
      if (c.root >= 0 && arm >= 0 && w.f.blocks[arm].preds.len() == 1) {
        rg = open_region(rg, dom, reach, arm, c.root, w.f.blocks[bi].id);
        for other in c.also {
          rg = open_region(rg, dom, reach, arm, other, w.f.blocks[bi].id);
        }
      }
    }
    bi = bi + 1;
  }
  return rg;
}

function unique_regions(w: Walk, dom: ssadeps.Dom, reach: boolean[]): Regions {
  let rg: Regions = Regions { roots: [], openers: [] };
  while (rg.roots.len() < w.f.blocks.len()) {
    rg = Regions { roots: rg.roots.append([]), openers: rg.openers.append([]) };
  }
  rg = regions_round(w, rg, dom, reach, false);
  // A token's region can open another token's test, so the token pass runs
  // until no region grows.
  let before: i32 = -1;
  let after: i32 = region_count(rg);
  while (after != before) {
    before = after;
    rg = regions_round(w, rg, dom, reach, true);
    after = region_count(rg);
  }
  return rg;
}

function region_count(rg: Regions): i32 {
  let n: i32 = 0;
  for r in rg.roots {
    n = n + r.len();
  }
  return n;
}

// ---- origins --------------------------------------------------------------

// A value whose definition is a load from a box that is unique here, or
// from a box a children-only drop owns the children of: the frame's to
// release.
function child_load(w: Walk, regions: i32[][], bi: i32, ins: ssa.SInst, children_box: boolean[]): boolean {
  if (ins.args.len() == 0) {
    return false;
  }
  let base: i32 = w.root[ins.args[0]];
  if (base < children_box.len() && children_box[base]) {
    return true;
  }
  return util.index_of_i32(regions[bi], base) >= 0;
}

// Shells is every shell release (ir.shell): the box released shallowly
// after the frame took its payload, by root, with where the release sits.
struct Shells { base: i32[], phi: i32[], block: i32[], at: i32[] }

function shells_of(w: Walk): Shells {
  let out: Shells = Shells { base: [], phi: [], block: [], at: [] };
  let bi: i32 = 0;
  while (bi < w.f.blocks.len()) {
    let insts: ssa.SInst[] = w.f.blocks[bi].insts;
    let i: i32 = 0;
    while (i < insts.len()) {
      let ins: ssa.SInst = insts[i];
      let base: i32 = -1;
      let phi: i32 = -1;
      if (is_shell(w, ins) || ins.kind_tag == 7 && ins.result >= 0 && ins.result < w.reused.len() && w.reused[ins.result]) {
        base = w.root[ins.args[0]];
      } else if (is_reuse(ins)) {
        base = w.root[ins.args[0]];
        if (phi_valued(w, base)) {
          phi = base;
          base = -1;
        }
      }
      if (base >= 0 || phi >= 0) {
        out = Shells { base: out.base.append(base), phi: out.phi.append(phi), block: out.block.append(bi), at: out.at.append(i) };
      }
      i = i + 1;
    }
    bi = bi + 1;
  }
  return out;
}

function is_reuse(ins: ssa.SInst): boolean {
  return ins.kind_tag == 11 && ins.str == "__fern_alloc_reuse" && ins.args.len() > 0;
}

// carries: phi `p` is `base` where it is not null: each input is the box,
// null, or such a phi, and one is the box. A phi the region uses but does
// not define is read off the base walk's tables, and so is a null it does
// not define: the null an arm outside the region gives the token.
function carries(w: Walk, p: i32, base: i32): boolean {
  let path: i32[] = [];
  return carries_at(w, p, base, path, false);
}

function carries_at(w: Walk, p: i32, base: i32, path: i32[], outer: boolean): boolean {
  let f: ssa.SFunc = w.f;
  let defs: Defs = w.defs;
  let root: i32[] = w.root;
  let derived: boolean[] = w.derived;
  if (outer) {
    f = w.outer.f;
    defs = w.outer.defs;
    root = w.outer.root;
    derived = w.outer.derived;
  }
  let ins: ssa.SInst = def_of(f, defs, p);
  if (ins.kind_tag != 8 || path.len() >= 8) {
    return false;
  }
  let any: boolean = false;
  for a in ins.args {
    if (a < 0) {
      return false;
    }
    if (!(is_zero(f, defs, a) || !outer && zero_at(w, a))) {
      let r: i32 = root[a];
      if (r == base && !derived[a]) {
        any = true;
      } else if (r != p && util.index_of_i32(path, r) < 0) {
        let via_outer: boolean = outer || w.outer.on && outside(w.f, w.defs, r);
        if (!carries_at(w, r, base, path.append(p), via_outer)) {
          return false;
        }
        any = true;
      }
    }
  }
  return any;
}

// phi_valued: `v` is a phi, here or in the base walk's function.
function phi_valued(w: Walk, v: i32): boolean {
  return def_at(w, v).kind_tag == 8;
}

function is_shell(w: Walk, ins: ssa.SInst): boolean {
  return ins.kind_tag == 11 && ins.imm == 2 && ins.args.len() > 0;
}

// reuses: `ins` hands the box `base`, or a phi in `boxed`, on as a
// construction's block: the call, or the copy box_ops made of it.
function reuses(w: Walk, ins: ssa.SInst, base: i32, boxed: boolean[]): boolean {
  if (ins.args.len() == 0 || ins.result < 0) {
    return false;
  }
  let on_box: boolean = ins.kind_tag == 7 && ins.result < w.reused.len() && w.reused[ins.result] || is_reuse(ins);
  if (!on_box) {
    return false;
  }
  let r: i32 = w.root[ins.args[0]];
  return r == base || r < boxed.len() && boxed[r];
}

// writes_slot: the construction built in `r`, reused at position `i` of
// block `mb`, stores into the slot `ld` read before reading it again, so
// the payload `ld` read was the frame's: released, or stored back by that
// store, which spends it. A slot the construction keeps stays the box's.
function writes_slot(w: Walk, mb: i32, i: i32, r: i32, ld: ssa.SInst): boolean {
  let insts: ssa.SInst[] = w.f.blocks[mb].insts;
  let key: i32 = load_key(w, ld);
  let j: i32 = i + 1;
  while (j < insts.len()) {
    let d: ssa.SInst = insts[j];
    if (d.args.len() > 0 && w.root[d.args[0]] == w.root[r]) {
      if (is_load(d) && load_key(w, d) == key && d.kind_tag == 40 == (ld.kind_tag == 40)) {
        return false;
      }
      if ((d.kind_tag == 41 || d.kind_tag == 43) && d.args.len() >= 2 && store_key(w, d) == key && d.kind_tag == 41 == (ld.kind_tag == 40)) {
        return true;
      }
    }
    j = j + 1;
  }
  return false;
}

// shell_taken: `ld` reads a box the frame releases as a shell after it, so
// the payload it read is the frame's, unless a later read of the same slot
// or a children-only drop of the box comes first on every path (between),
// or a path from the load returns without the release (escapes).
function shell_taken(w: Walk, sh: Shells, dom: ssadeps.Dom, bi: i32, pos: i32, ld: ssa.SInst): boolean {
  if (ld.args.len() == 0) {
    return false;
  }
  let base: i32 = w.root[ld.args[0]];
  let any: boolean = false;
  let k: i32 = 0;
  while (k < sh.base.len() && !any) {
    any = sh.base[k] == base || sh.phi[k] >= 0 && util.index_of_i32(w.carried[base], sh.phi[k]) >= 0;
    k = k + 1;
  }
  if (!any) {
    return false;
  }
  // The paths from the load, once: whether one returns without the box's
  // release, and which phis of the box they give the box, so a reuse
  // through a phi counts only where the paths say it is the box's.
  let es: Escape = escape_fixpoint(w, ld, bi, pos);
  if (es.escapes) {
    return false;
  }
  let reach: boolean[] = [];
  k = 0;
  while (k < sh.base.len()) {
    if (sh.base[k] == base || sh.phi[k] >= 0 && sh.phi[k] < es.boxed.len() && es.boxed[sh.phi[k]]) {
      let after: boolean = before(dom, bi, pos, sh.block[k], sh.at[k]);
      if (!after) {
        if (reach.len() == 0) {
          reach = reached_in(w.f, w.at, bi, -1);
        }
        after = reach[sh.block[k]];
      }
      if (after && !between(w, dom, ld, bi, pos, sh.block[k], sh.at[k])) {
        return true;
      }
    }
    k = k + 1;
  }
  return false;
}

// Whether position `pos` of block `bi` comes before position `at` of block
// `sb` on every path to the latter.
function before(dom: ssadeps.Dom, bi: i32, pos: i32, sb: i32, at: i32): boolean {
  if (sb == bi) {
    return at > pos;
  }
  return ssadeps.dom_holds(dom, sb, bi);
}

// children_boxes marks the roots whose children the frame owns outright: a
// children-only drop's parameter, and a phi every edge of which brings such
// a box or one proved unique in the block it comes from — the node of a
// chain drop, rebound to the next link once that link is proved unique.
// children_phi: every input of the phi is a children box or a box unique on
// its edge, so the phi is a children box too.
function children_phi(w: Walk, regions: i32[][], out: boolean[], b: ssa.SBlock, ins: ssa.SInst): boolean {
  let i: i32 = 0;
  while (i < ins.args.len()) {
    let a: i32 = ins.args[i];
    if (a < 0) {
      return false;
    }
    let r: i32 = w.root[a];
    let pb: i32 = w.at[b.preds[i]];
    if (!out[r] && (pb < 0 || util.index_of_i32(regions[pb], r) < 0)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// children_params marks the parameters declared children-only.
function children_params(w: Walk, own out: boolean[]): boolean[] {
  let pi: i32 = 0;
  while (w.self_abi.known && pi < w.self_abi.modes.len() && pi < w.f.nparams) {
    if (w.self_abi.modes[pi] == children_mode()) {
      out = out.with(pi, true);
    }
    pi = pi + 1;
  }
  return out;
}

function children_boxes(w: Walk, regions: i32[][]): boolean[] {
  let f: ssa.SFunc = w.f;
  let out: boolean[] = children_params(w, __alloc_bool(f.nvals));
  let grown: boolean = true;
  while (grown) {
    grown = false;
    for b in f.blocks {
      for ins in b.insts {
        if (ins.kind_tag != 8 || ins.result < 0 || out[ins.result] || ins.args.len() != b.preds.len()) {
          continue;
        }
        if (children_phi(w, regions, out, b, ins)) {
          out = out.with(ins.result, true);
          grown = true;
        }
      }
    }
  }
  return out;
}

function result_origin(result: i32): i32 {
  if (result == rcsigs.result_fresh()) {
    return org_fresh();
  }
  if (result == rcsigs.result_borrow()) {
    return org_borrowed();
  }
  if (result == rcsigs.result_unknown()) {
    return org_unknown();
  }
  return org_none();
}

// call_origin classifies a `call_direct` result: by the helper table, by
// contract, else unknown. The table first: a runtime helper core/map calls
// by name has a contract too, written for the planner, which reads the raw
// word it answers as a value; what the call does to a count is this table's
// to say wherever the name appears.
function call_origin(w: Walk, ins: ssa.SInst): i32 {
  let s: rcsigs.Sig = w.sigs.lookup(ins.str);
  if (s.known) {
    if (s.result == rcsigs.result_operand()) {
      return org_none();
    }
    if (s.result == rcsigs.result_marked()) {
      if (ins.imm == 1) {
        return org_fresh();
      }
      if (ins.imm == 3) {
        return org_borrowed();
      }
      return org_none();
    }
    return result_origin(s.result);
  }
  let a: Abi = w.abis.lookup(ins.str);
  if (!a.known) {
    return org_unknown();
  }
  if (a.result_unit) {
    return org_fresh();
  }
  return org_none();
}

// scalar_phis clears the phis every edge of which brings a value that holds
// nothing — a scalar, or another such phi — to a fixpoint. A phi of scalars
// is stored, pushed and returned like any word, and must not read as a unit
// spent without one.
// phi_holds: one edge of the phi brings a value that holds something.
function phi_holds(w: Walk, out: i32[], holds: boolean[], ins: ssa.SInst): boolean {
  for a in ins.args {
    if (a < 0 || w.derived[a]) {
      continue;
    }
    let r: i32 = w.root[a];
    if (out[r] != org_none() && (out[r] != org_merged() || holds[r])) {
      return true;
    }
  }
  return false;
}

function scalar_phis(w: Walk, own out: i32[]): i32[] {
  let f: ssa.SFunc = w.f;
  // A phi holds something when one of its edges brings a value that does, a
  // phi included, to a fixpoint from nothing: a cycle of phis fed only by
  // scalars and statics, an accumulator never appended to, holds nothing.
  let holds: boolean[] = __alloc_bool(f.nvals);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for b in f.blocks {
      for ins in b.insts {
        if (ins.kind_tag == 8 && ins.result >= 0 && !holds[ins.result] && phi_holds(w, out, holds, ins)) {
          holds = holds.with(ins.result, true);
          changed = true;
        }
      }
    }
  }
  return clear_scalar_phis(out, holds);
}

function clear_scalar_phis(own out: i32[], holds: boolean[]): i32[] {
  let v: i32 = 0;
  while (v < out.len()) {
    if (out[v] == org_merged() && !holds[v]) {
      out = out.with(v, org_none());
    }
    v = v + 1;
  }
  return out;
}

// origins classifies every value's definition. The parameters read the
// boundary; everything else its kind, the tables and the regions.
// Origins is every value's origin, and for a child the reason: 1 a load in
// the box's unique region or of a children-only drop's box, 2 a slot the
// frame overwrites, 3 a shell's payload.
struct Origins { origin: i32[], why: i32[], opened: i32[], pair_tag: i32[], pair_mask: i32[], pair_words: i32[] }

// Found is one value's origin with what goes beside it: a child's reason and
// the block whose branch opened its region, a pair word's first word and
// tag set.
struct Found { origin: i32, why: i32, opened: i32, tag: i32, mask: i32 }

function plain(origin: i32): Found {
  return Found { origin: origin, why: 0, opened: -1, tag: -1, mask: 0 };
}

function child(why: i32): Found {
  return Found { origin: org_child(), why: why, opened: -1, tag: -1, mask: 0 };
}

// Context is what classifying a definition reads besides the walk.
struct Context { regions: i32[][], openers: i32[][], children_box: boolean[], dom: ssadeps.Dom, stores: Stores, shells: Shells }

function param_origin(w: Walk, p: i32): i32 {
  if (!w.self_abi.known || p >= w.self_abi.modes.len()) {
    return org_unknown();
  }
  let m: i32 = w.self_abi.modes[p];
  if (m == counted_mode()) {
    return org_transferred();
  }
  if (m == borrow_mode() || m == children_mode()) {
    return org_borrowed();
  }
  return org_none();
}

// load_origin: a marked load is a borrow, or the frame's own unit — a child
// — when it reads a box the frame proved unique, a slot the frame
// overwrites, or a shell's payload.
function load_origin(w: Walk, c: Context, bi: i32, pos: i32, ins: ssa.SInst): Found {
  if (child_load(w, c.regions, bi, ins, c.children_box)) {
    let fd: Found = child(1);
    if (ins.args.len() > 0) {
      let at: i32 = util.index_of_i32(c.regions[bi], w.root[ins.args[0]]);
      if (at >= 0 && at < c.openers[bi].len()) {
        fd = Found { ...fd, opened: c.openers[bi][at] };
      }
    }
    return fd;
  }
  if (overwritten(w, c.stores, c.dom, bi, pos, ins)) {
    return child(2);
  }
  if (shell_taken(w, c.shells, c.dom, bi, pos, ins)) {
    return child(3);
  }
  return plain(org_borrowed());
}

function call_origin_at(w: Walk, c: Context, bi: i32, pos: i32, ins: ssa.SInst): Found {
  // A cursor's map, read to be dropped where the cursor is unique: the
  // cursor's unit of it passes to the frame.
  if (is_call(ins, "__mapiter_map_impl") && child_load(w, c.regions, bi, ins, c.children_box)) {
    return child(1);
  }
  if (paired_call(w.f.blocks[bi], pos) && !w.sigs.lookup(ins.str).known) {
    return plain(word_origin(w.abis.lookup(ins.str), false));
  }
  return plain(call_origin(w, ins));
}

// word_origin_at: a paired call's second word, read right after the call —
// a fresh unit on the callee's terms, bound to the first word where those
// terms are a set of tags.
function word_origin_at(w: Walk, bi: i32, pos: i32): Found {
  let insts: ssa.SInst[] = w.f.blocks[bi].insts;
  if (pos == 0 || insts[pos - 1].kind_tag != 11) {
    return plain(org_unknown());
  }
  let prev: ssa.SInst = insts[pos - 1];
  let a: Abi = w.abis.lookup(prev.str);
  let fd: Found = plain(word_origin(a, true));
  if (a.pair_second > 0 && prev.result >= 0) {
    fd = Found { ...fd, tag: prev.result, mask: a.pair_second };
  }
  return fd;
}

function named_origin(w: Walk, ins: ssa.SInst): i32 {
  let sg: rcsigs.Sig = w.ops.op_lookup(ins.str);
  if (sg.known) {
    return result_origin(sg.result);
  }
  if (marked_result(w, ins)) {
    return org_fresh();
  }
  return org_none();
}

// simple_origin classifies the definitions that need no context: a phi, a
// fresh box, a frame view, a named op, an indirect call. -1 for the rest.
function simple_origin(w: Walk, ins: ssa.SInst): i32 {
  let k: i32 = ins.kind_tag;
  if (k == 8) {
    return org_merged();
  }
  if (k == 48) {
    return org_fresh();
  }
  if (k == 51) {
    if (ins.imm == 0) {
      return org_fresh();
    }
    return org_none();
  }
  if (k == 56 || k == 60) {
    return org_unknown();
  }
  if (is_named_op(k) && ins.str != "call_word") {
    return named_origin(w, ins);
  }
  return -1;
}

function origin_of(w: Walk, c: Context, bi: i32, pos: i32, ins: ssa.SInst): Found {
  let simple: i32 = simple_origin(w, ins);
  if (simple >= 0) {
    return plain(simple);
  }
  if (is_load(ins)) {
    return load_origin(w, c, bi, pos, ins);
  }
  if (ins.kind_tag == 11) {
    return call_origin_at(w, c, bi, pos, ins);
  }
  if (ins.kind_tag == 59) {
    return word_origin_at(w, bi, pos);
  }
  return plain(org_none());
}

function origins(w: Walk, stores: Stores, regions: i32[][], openers: i32[][], children_box: boolean[], dom: ssadeps.Dom): Origins {
  let f: ssa.SFunc = w.f;
  let c: Context = Context { regions: regions, openers: openers, children_box: children_box, dom: dom, stores: stores, shells: shells_of(w) };
  let out: i32[] = __alloc_i32(f.nvals);
  let why: i32[] = __alloc_i32(f.nvals);
  let opened: i32[] = util.minus_ones(f.nvals);
  let pair_tag: i32[] = util.minus_ones(f.nvals);
  let pair_mask: i32[] = __alloc_i32(f.nvals);
  let pair_words: i32[] = [];
  let p: i32 = 0;
  while (p < f.nparams && p < f.nvals) {
    out = out.with(p, param_origin(w, p));
    p = p + 1;
  }
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let pos: i32 = -1;
    for ins in f.blocks[bi].insts {
      pos = pos + 1;
      let v: i32 = ins.result;
      if (v < 0 || v >= f.nvals || w.root[v] != v || ins.kind_tag == 6) {
        continue;
      }
      let fd: Found = origin_of(w, c, bi, pos, ins);
      out = out.with(v, fd.origin);
      why = why.with(v, fd.why);
      opened = opened.with(v, fd.opened);
      if (fd.tag >= 0) {
        pair_tag = pair_tag.with(v, fd.tag);
        pair_mask = pair_mask.with(v, fd.mask);
        pair_words = pair_words.append(v);
      }
    }
    bi = bi + 1;
  }
  return Origins { origin: scalar_phis(w, out), why: why, opened: opened, pair_tag: pair_tag, pair_mask: pair_mask, pair_words: pair_words };
}

// ---- the slots a frame takes from ---------------------------------------------

// Stores is every field and element store, bucketed by the box it writes:
// `key` is the field offset or the index value's root, `zero` whether the
// stored value is the null word.
struct Stores { base: i32[], key: i32[], block: i32[], at: i32[], zero: boolean[], by_base: i32[][] }

function stores_of(w: Walk): Stores {
  let f: ssa.SFunc = w.f;
  let out: Stores = Stores { base: [], key: [], block: [], at: [], zero: [], by_base: [] };
  while (out.by_base.len() < f.nvals) {
    out = Stores { ...out, by_base: out.by_base.append([]) };
  }
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let insts: ssa.SInst[] = f.blocks[bi].insts;
    let i: i32 = 0;
    while (i < insts.len()) {
      let st: ssa.SInst = insts[i];
      if ((st.kind_tag == 41 && st.args.len() == 2 || st.kind_tag == 43 && st.args.len() == 3) && st.args[0] >= 0) {
        let base: i32 = w.root[st.args[0]];
        let key: i32 = st.imm;
        if (st.kind_tag == 43) {
          key = index_key(w, st.args[1]);
        }
        let n: i32 = out.base.len();
        out = Stores {
          base: out.base.append(base), key: out.key.append(key), block: out.block.append(bi), at: out.at.append(i),
          zero: out.zero.append(zero_at(w, st.args[st.args.len() - 1])),
          by_base: out.by_base.with(base, out.by_base[base].append(n)),
        };
      }
      i = i + 1;
    }
    bi = bi + 1;
  }
  return out;
}

// The slot a load reads: the box's root and the field offset or the index
// key, the key stores_of files the writes under.
function load_key(w: Walk, ld: ssa.SInst): i32 {
  if (ld.kind_tag == 40) {
    return ld.imm;
  }
  if (ld.args.len() >= 2) {
    return index_key(w, ld.args[1]);
  }
  return -1;
}

// An index value's key: a constant by its value, below -1 so it meets no
// root, else its root. Two constants of one value are two SSA values and
// one slot.
function index_key(w: Walk, v: i32): i32 {
  let d: ssa.SInst = def_of(w.f, w.defs, w.root[v]);
  if (d.kind_tag == 1 && d.imm >= 0) {
    return -2 - d.imm;
  }
  return w.root[v];
}

function same_slot(w: Walk, st: Stores, k: i32, ld: ssa.SInst): boolean {
  if (st.key[k] != load_key(w, ld)) {
    return false;
  }
  if (ld.kind_tag == 40) {
    return w.f.blocks[st.block[k]].insts[st.at[k]].kind_tag == 41;
  }
  return w.f.blocks[st.block[k]].insts[st.at[k]].kind_tag == 43;
}

// overwritten: a store of another value into the slot `ld` read, after it on
// every path from it (in its block past it, or in a block it dominates). The
// frame replaces what the slot holds, so the value it read is its own to
// release before the write — an element `with` overwrites, a field grown in
// place.
function overwritten(w: Walk, st: Stores, dom: ssadeps.Dom, bi: i32, pos: i32, ld: ssa.SInst): boolean {
  if (ld.args.len() == 0) {
    return false;
  }
  let base: i32 = w.root[ld.args[0]];
  for k in st.by_base[base] {
    if (st.zero[k] || !same_slot(w, st, k, ld) || stores_back(w, st, k, ld)) {
      continue;
    }
    if (st.block[k] == bi) {
      if (st.at[k] > pos && !between(w, dom, ld, bi, pos, st.block[k], st.at[k])) {
        return !escapes(w, ld, bi, pos, 1);
      }
    } else if (ssadeps.dom_holds(dom, st.block[k], bi) && !between(w, dom, ld, bi, pos, st.block[k], st.at[k])) {
      return !escapes(w, ld, bi, pos, 1);
    }
  }
  return false;
}

// escapes: a path from `ld` (block `lb`, `lp`) reaches a return without
// passing what settles the slot: another read of it, a drop of the box, and
// by `mode` a store into the slot (1) or a shell release of the box (2);
// or comes back to the load's own block to read the slot again. On such a
// path the slot keeps the payload, so the frame does not own what `ld`
// read.
function escapes(w: Walk, ld: ssa.SInst, lb: i32, lp: i32, mode: i32): boolean {
  let none: boolean[] = [];
  if (mode != 2) {
    let no_phis: i32[] = [];
    return escape_paths(w, ld, lb, lp, mode, none, slot_blocks(w, w.root[ld.args[0]], no_phis), false).escapes;
  }
  return escape_fixpoint(w, ld, lb, lp).escapes;
}

// Escape is escape_fixpoint's answer: whether a path from the load returns
// without the box's release, and the phis of the box the paths give the
// box.
struct Escape { escapes: boolean, boxed: boolean[] }

// escape_fixpoint: a reuse through a token phi of the box is the box's
// where every edge the paths take into the phi gives it the box: assumed
// of every token phi, and withdrawn from each the paths refute until none
// is.
function escape_fixpoint(w: Walk, ld: ssa.SInst, lb: i32, lp: i32): Escape {
  let base: i32 = w.root[ld.args[0]];
  let cands: i32[] = token_phis_of(w, base);
  let boxed: boolean[] = assumed_boxed(w, cands);
  // The candidates only shrink, so the blocks they mark at the start hold
  // every event a later round can find.
  let marks: boolean[] = slot_blocks(w, base, cands);
  let again: boolean = true;
  while (again) {
    let r: Paths = escape_paths(w, ld, lb, lp, 2, boxed, marks, cands.len() > 0);
    if (r.escapes) {
      return Escape { escapes: true, boxed: boxed };
    }
    again = false;
    for p in cands {
      if (boxed[p] && !box_on_edges(w, p, base, boxed, r.edge)) {
        boxed = boxed.with(p, false);
        again = true;
      }
    }
  }
  return Escape { escapes: false, boxed: boxed };
}

// assumed_boxed flags each candidate phi, and is empty when there is none:
// its readers check the bound.
function assumed_boxed(w: Walk, cands: i32[]): boolean[] {
  if (cands.len() == 0) {
    return [];
  }
  let boxed: boolean[] = __alloc_bool(w.f.nvals);
  for p in cands {
    boxed = boxed.with(p, true);
  }
  return boxed;
}

// firsts_of indexes, per root, the blocks holding an instruction whose
// first operand has that root.
function firsts_of(f: ssa.SFunc, root: i32[]): i32[][] {
  let out: i32[][] = [];
  while (out.len() < f.nvals) {
    out = out.append([]);
  }
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    for ins in f.blocks[bi].insts {
      if (ins.args.len() > 0 && ins.args[0] >= 0 && ins.args[0] < root.len()) {
        let r: i32 = root[ins.args[0]];
        let n: i32 = out[r].len();
        if (n == 0 || out[r][n - 1] != bi) {
          out = out.with(r, out[r].append(bi));
        }
      }
    }
    bi = bi + 1;
  }
  return out;
}

// slot_blocks marks the blocks that can hold an event for a load off
// `base` (event_in, settles_in): an instruction whose first operand is
// rooted at `base` or at a phi in `phis`, or the definition of `base`.
function slot_blocks(w: Walk, base: i32, phis: i32[]): boolean[] {
  let out: boolean[] = __alloc_bool(w.f.blocks.len());
  for b in w.firsts[base] {
    out = out.with(b, true);
  }
  for p in phis {
    for b in w.firsts[p] {
      out = out.with(b, true);
    }
  }
  if (base < w.defs.block.len() && w.defs.block[base] >= 0) {
    out = out.with(w.defs.block[base], true);
  }
  return out;
}

// Paths is what escape_paths walked: whether a path returned, and, when
// asked for (`edges`), the edges it took (block index times two, plus the
// successor).
struct Paths { escapes: boolean, edge: boolean[] }

function escape_paths(w: Walk, ld: ssa.SInst, lb: i32, lp: i32, mode: i32, boxed: boolean[], marks: boolean[], edges: boolean): Paths {
  let edge: boolean[] = edge_flags(w, edges);
  if (marks[lb] && settles_in(w, ld, lb, lp + 1, w.f.blocks[lb].insts.len(), mode, boxed)) {
    return Paths { escapes: false, edge: edge };
  }
  if (w.f.blocks[lb].term.kind_tag == 1) {
    return Paths { escapes: true, edge: edge };
  }
  let seen: boolean[] = __alloc_bool(w.f.blocks.len());
  let stack: i32[] = [lb];
  let top: i32 = 1;
  while (top > 0) {
    top = top - 1;
    let b: i32 = stack[top];
    let e: i32 = 0;
    while (e < 2) {
      let sid: i32 = ssa.successor_id(w.f.blocks[b].term, e);
      let si: i32 = -1;
      if (sid >= 0 && sid < w.at.len()) {
        si = w.at[sid];
      }
      if (si >= 0) {
        edge = took_edge(edge, b * 2 + e);
      }
      if (si == lb) {
        return Paths { escapes: true, edge: edge };
      }
      if (si >= 0 && !seen[si]) {
        seen = seen.with(si, true);
        if (!(marks[si] && settles_in(w, ld, si, 0, w.f.blocks[si].insts.len(), mode, boxed))) {
          if (w.f.blocks[si].term.kind_tag == 1) {
            return Paths { escapes: true, edge: edge };
          }
          stack = pushed(stack, top, si);
          top = top + 1;
        }
      }
      e = e + 1;
    }
  }
  return Paths { escapes: false, edge: edge };
}

// edge_flags is escape_paths' record of the edges it takes: one flag per
// edge when asked for, else empty, which took_edge leaves alone.
function edge_flags(w: Walk, edges: boolean): boolean[] {
  if (!edges) {
    return [];
  }
  return __alloc_bool(w.f.blocks.len() * 2);
}

function took_edge(own edge: boolean[], i: i32): boolean[] {
  if (edge.len() == 0) {
    return edge;
  }
  return edge.with(i, true);
}

// carried_of indexes, per box, the phis that carry it where they are not
// null: the walk's own phis and the base walk's the region uses.
function carried_of(w: Walk): i32[][] {
  let out: i32[][] = [];
  while (out.len() < w.f.nvals) {
    out = out.append([]);
  }
  for p in w.phis {
    out = carried_into(out, w, p);
  }
  if (w.outer.on) {
    for p in w.outer.phis {
      if (p < w.f.nvals && outside(w.f, w.defs, p)) {
        out = carried_into(out, w, p);
      }
    }
  }
  return out;
}

function carried_into(own out: i32[][], w: Walk, p: i32): i32[][] {
  for c in carry_candidates(w, p) {
    if (c < out.len() && util.index_of_i32(out[c], p) < 0 && carries(w, p, c)) {
      out = out.with(c, out[c].append(p));
    }
  }
  return out;
}

// carry_candidates: the boxes phi `p` can carry. carries holds only of a
// box every input past null leads to, so of `p` itself, a phi only it and
// null feed, or of one along the first such input, followed through phis
// as carries_at follows them.
function carry_candidates(w: Walk, p: i32): i32[] {
  let out: i32[] = [p];
  let path: i32[] = [];
  let cur: i32 = p;
  let outer: boolean = false;
  while (path.len() < 8) {
    let f: ssa.SFunc = w.f;
    let defs: Defs = w.defs;
    let root: i32[] = w.root;
    if (outer) {
      f = w.outer.f;
      defs = w.outer.defs;
      root = w.outer.root;
    }
    let ins: ssa.SInst = def_of(f, defs, cur);
    if (ins.kind_tag != 8) {
      return out;
    }
    let next: i32 = -1;
    for a in ins.args {
      if (next < 0 && a >= 0 && !(is_zero(f, defs, a) || !outer && zero_at(w, a)) && root[a] != cur && util.index_of_i32(path, root[a]) < 0) {
        next = root[a];
      }
    }
    if (next < 0) {
      return out;
    }
    out = out.append(next);
    path = path.append(cur);
    outer = outer || w.outer.on && outside(w.f, w.defs, next);
    cur = next;
  }
  return out;
}

// token_phis_of: the phis that carry `base` where they are not null.
function token_phis_of(w: Walk, base: i32): i32[] {
  return w.carried[base];
}

// box_on_edges: the paths took an edge into phi `p`'s block, and every
// edge they took gives it the box, or a phi still assumed the box. A phi
// the paths never enter was given its value before the load, which may be
// null: it is not the box.
function box_on_edges(w: Walk, p: i32, base: i32, boxed: boolean[], edge: boolean[]): boolean {
  let bi: i32 = w.defs.block[p];
  if (bi < 0) {
    return false;
  }
  let ins: ssa.SInst = def_of(w.f, w.defs, p);
  let b: ssa.SBlock = w.f.blocks[bi];
  let any: boolean = false;
  let i: i32 = 0;
  while (i < ins.args.len() && i < b.preds.len()) {
    let pb: i32 = w.at[b.preds[i]];
    if (pb >= 0 && edge_taken(w, edge, pb, b.id)) {
      any = true;
      let a: i32 = ins.args[i];
      if (a < 0 || zero_at(w, a)) {
        return false;
      }
      let r: i32 = w.root[a];
      if (!(r == base && !w.derived[a] || boxed[r])) {
        return false;
      }
    }
    i = i + 1;
  }
  return any;
}

function edge_taken(w: Walk, edge: boolean[], pb: i32, sid: i32): boolean {
  let e: i32 = 0;
  while (e < 2) {
    if (ssa.successor_id(w.f.blocks[pb].term, e) == sid && edge[pb * 2 + e]) {
      return true;
    }
    e = e + 1;
  }
  return false;
}

// settles_in: positions `from` up to `to` of block `mb` hold an event of
// event_in, or by `mode` a store into `ld`'s slot (1) or a shell release of
// its box (2).
function settles_in(w: Walk, ld: ssa.SInst, mb: i32, from: i32, to: i32, mode: i32, boxed: boolean[]): boolean {
  if (event_in(w, ld, mb, from, to)) {
    return true;
  }
  let insts: ssa.SInst[] = w.f.blocks[mb].insts;
  let base: i32 = w.root[ld.args[0]];
  let i: i32 = from;
  while (i < to && i < insts.len()) {
    let d: ssa.SInst = insts[i];
    if (mode == 1 && (d.kind_tag == 41 || d.kind_tag == 43) && d.args.len() >= 2 && w.root[d.args[0]] == base && store_key(w, d) == load_key(w, ld) && d.kind_tag == 41 == (ld.kind_tag == 40)) {
      return true;
    }
    if (mode == 2 && (is_shell(w, d) && w.root[d.args[0]] == base || reuses(w, d, base, boxed) && writes_slot(w, mb, i, d.result, ld))) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// store_key is load_key for a store: the field offset or the index key.
function store_key(w: Walk, st: ssa.SInst): i32 {
  if (st.kind_tag == 41) {
    return st.imm;
  }
  return index_key(w, st.args[1]);
}

// between: on every path from `ld` (block `lb`, `lp`) to the store (block
// `sb`, `sp`) sits another load of its slot, which is the read the store
// follows, or a children-only drop of its box, which released the payload;
// `ld` only borrowed then. A path around every such event, the store's own
// block entered from above included, says the store replaces what `ld`
// read.
function between(w: Walk, dom: ssadeps.Dom, ld: ssa.SInst, lb: i32, lp: i32, sb: i32, sp: i32): boolean {
  let no_phis: i32[] = [];
  let marks: boolean[] = slot_blocks(w, w.root[ld.args[0]], no_phis);
  // A position before the load in its own block is reached round a loop.
  if (lb == sb && sp > lp && !(marks[lb] && event_in(w, ld, lb, lp + 1, sp))) {
    return false;
  }
  let seen: boolean[] = __alloc_bool(w.f.blocks.len());
  let stack: i32[] = [];
  let top: i32 = 0;
  if (!(marks[lb] && event_in(w, ld, lb, lp + 1, w.f.blocks[lb].insts.len()))) {
    stack = stack.append(lb);
    top = 1;
  }
  while (top > 0) {
    top = top - 1;
    let b: i32 = stack[top];
    let e: i32 = 0;
    while (e < 2) {
      let sid: i32 = ssa.successor_id(w.f.blocks[b].term, e);
      let si: i32 = -1;
      if (sid >= 0) {
        si = w.at[sid];
      }
      if (si == sb) {
        if (!(marks[sb] && event_in(w, ld, sb, 0, sp))) {
          return false;
        }
      } else if (si >= 0 && !seen[si]) {
        seen = seen.with(si, true);
        if (!(marks[si] && event_in(w, ld, si, 0, w.f.blocks[si].insts.len()))) {
          stack = pushed(stack, top, si);
          top = top + 1;
        }
      }
      e = e + 1;
    }
  }
  return true;
}

// event_in: positions `from` up to `to` of block `mb` hold another load of
// `ld`'s slot, a children-only drop of its box, or the box's own
// construction: reached again round a loop, it makes another box, whose
// slots are not the one `ld` read.
function event_in(w: Walk, ld: ssa.SInst, mb: i32, from: i32, to: i32): boolean {
  let insts: ssa.SInst[] = w.f.blocks[mb].insts;
  let base: i32 = w.root[ld.args[0]];
  let i: i32 = from;
  while (i < to && i < insts.len()) {
    let d: ssa.SInst = insts[i];
    if (same_slot_load(w, d, ld) || d.result == base || d.kind_tag == 11 && util.str_has_prefix(d.str, "__sem_drop_") && d.args.len() > 0 && w.root[d.args[0]] == base) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// stores_back: store `k` writes the value `ld` read back where it read it,
// which replaces nothing (a slot a reused box keeps, box_ops).
function stores_back(w: Walk, st: Stores, k: i32, ld: ssa.SInst): boolean {
  let s: ssa.SInst = w.f.blocks[st.block[k]].insts[st.at[k]];
  return ld.result >= 0 && w.root[s.args[s.args.len() - 1]] == w.root[ld.result];
}

// same_slot_load: `other` reads the slot `ld` reads, as a different value.
function same_slot_load(w: Walk, other: ssa.SInst, ld: ssa.SInst): boolean {
  return other.result != ld.result && is_load(other) && other.kind_tag == ld.kind_tag
    && other.args.len() > 0 && w.root[other.args[0]] == w.root[ld.args[0]] && load_key(w, other) == load_key(w, ld);
}

// ---- which roots the walk tracks --------------------------------------------

// A borrow or a phi enters the state only where something acts on its unit:
// a retain, a release, a move, a store, a return. Keeping the untouched ones
// out is what keeps a block's row small.
struct Touch { touched: boolean[] }

function touch(own t: Touch, w: Walk, v: i32): Touch {
  if (v >= 0 && v < w.root.len()) {
    t = Touch { touched: t.touched.with(w.root[v], true) };
  }
  return t;
}

function touch_all(own t: Touch, w: Walk, args: i32[]): Touch {
  for a in args {
    t = touch(t, w, a);
  }
  return t;
}

// touch_call marks what a call may spend: by the helper table, else by the
// callee's contract, else every operand.
// touch_sig marks the operands a helper's row names.
function touch_sig(own t: Touch, w: Walk, ins: ssa.SInst, sg: rcsigs.Sig): Touch {
  if (sg.arg >= 0 && sg.arg < ins.args.len() && sg.effect != rcsigs.effect_inspect()) {
    t = touch(t, w, ins.args[sg.arg]);
  }
  for i in sg.also {
    if (i < ins.args.len()) {
      t = touch(t, w, ins.args[i]);
    }
  }
  for i in sg.unsure {
    if (i < ins.args.len()) {
      t = touch(t, w, ins.args[i]);
    }
  }
  return t;
}

function touch_call(own t: Touch, w: Walk, ins: ssa.SInst): Touch {
  let sg: rcsigs.Sig = w.sigs.lookup(ins.str);
  if (sg.known) {
    return touch_sig(t, w, ins, sg);
  }
  let a: Abi = w.abis.lookup(ins.str);
  if (!a.known) {
    return touch_all(t, w, ins.args);
  }
  let i: i32 = 0;
  while (i < ins.args.len() && i < a.modes.len()) {
    if (a.modes[i] == counted_mode()) {
      t = touch(t, w, ins.args[i]);
    }
    i = i + 1;
  }
  return t;
}

// touch_named marks what a named op may spend: the element a push stores,
// every operand a box takes, the operand a row names.
function touch_named(own t: Touch, w: Walk, ins: ssa.SInst): Touch {
  if (ins.str == "ret_word") {
    if (w.self_abi.pair_second != 0) {
      t = touch_all(t, w, ins.args);
    }
    return t;
  }
  if (rcsigs.boxes_operands(ins.str)) {
    return touch_all(t, w, ins.args);
  }
  let sg: rcsigs.Sig = w.ops.op_lookup(ins.str);
  if (!sg.known) {
    return t;
  }
  if (rcsigs.pushes_element(ins.str) && ins.args.len() > 0) {
    t = touch(t, w, ins.args[ins.args.len() - 1]);
  }
  if (sg.arg >= 0 && sg.arg < ins.args.len() && sg.effect != rcsigs.effect_inspect()) {
    t = touch(t, w, ins.args[sg.arg]);
  }
  return t;
}

function touch_inst(own t: Touch, w: Walk, ins: ssa.SInst): Touch {
  let k: i32 = ins.kind_tag;
  if (k == 11) {
    return touch_call(t, w, ins);
  }
  if (is_store(k) && ins.args.len() > 0) {
    return touch(t, w, ins.args[ins.args.len() - 1]);
  }
  if (is_named_op(k)) {
    return touch_named(t, w, ins);
  }
  if (k == 56 || k == 60) {
    return touch_all(t, w, ins.args);
  }
  return t;
}

function touches(w: Walk, null_taken: boolean[]): boolean[] {
  let t: Touch = Touch { touched: null_taken };
  let hands_out: boolean = w.self_abi.result_unit || w.self_abi.pair_first || w.self_abi.result_word;
  for b in w.f.blocks {
    for ins in b.insts {
      t = touch_inst(t, w, ins);
    }
    if (b.term.kind_tag == 1 && b.term.value >= 0 && hands_out) {
      t = touch(t, w, b.term.value);
    }
  }
  return t.touched;
}

// null_takes marks the loads a null store empties the slot of: the frame has
// taken the unit the slot held, so the loaded value holds it from the store
// on. A load qualifies when it reads the same slot of the same box before
// the store, in a block that dominates the store's.
function null_takes(w: Walk, takes: Takes): boolean[] {
  let out: boolean[] = __alloc_bool(w.f.nvals);
  for rs in takes.roots {
    for r in rs {
      out = out.with(r, true);
    }
  }
  return out;
}

// is_take: `st` stores null into a slot of a box the frame reads, not into
// the box it reused as a construction's block (Hold.reused).
function is_take(w: Walk, st: ssa.SInst): boolean {
  return (st.kind_tag == 41 || st.kind_tag == 43) && st.args.len() >= 2 && zero_at(w, st.args[st.args.len() - 1])
    && !(st.args[0] >= 0 && st.args[0] < w.reused.len() && w.reused[st.args[0]]);
}

// The load `st` empties: same kind of read, same box, same offset or index.
function matches_store(w: Walk, ld: ssa.SInst, st: ssa.SInst): boolean {
  if (ld.args.len() == 0 || w.root[ld.args[0]] != w.root[st.args[0]]) {
    return false;
  }
  if (st.kind_tag == 41) {
    return ld.kind_tag == 40 && ld.imm == st.imm;
  }
  return ld.kind_tag == 42 && ld.args.len() >= 2 && st.args.len() >= 3 && w.root[ld.args[1]] == w.root[st.args[1]];
}

// taken_root is the root of the load the null store at (sb, si) gives the
// slot's unit to, -1 for none: the nearest load of that slot before it on
// every path that the body goes on to read after it — the value the lowering
// took the unit for. An older load read after it names the same object but
// the unit is taken once, by the latest; a load read only before the store
// takes nothing. With no load read after, the nearest one is taken, so a
// take the lowering emits and never uses still shows as held. `after` is the
// blocks reached from `sb` (reached_from).
function taken_root(w: Walk, dom: ssadeps.Dom, after: boolean[], sb: i32, si: i32, st: ssa.SInst): i32 {
  let pick: Picked = pick_loads(w, dom, after, Picked { used: -1, any: -1 }, sb, si, sb, si, st);
  // The blocks that dominate the store's are its dominator-tree ancestors.
  let lb: i32 = sb;
  while (dom.idom[lb] >= 0 && dom.idom[lb] != lb) {
    lb = dom.idom[lb];
    pick = pick_loads(w, dom, after, pick, lb, w.f.blocks[lb].insts.len(), sb, si, st);
  }
  if (pick.used >= 0) {
    return w.root[pick.used];
  }
  if (pick.any >= 0) {
    return w.root[pick.any];
  }
  return -1;
}

// Picked is the nearest load of the slot read after the store, and the
// nearest at all, -1 for none yet.
struct Picked { used: i32, any: i32 }

// A read reached from the store only by way of the load's own block reads
// the load's next value, so `after` (the blocks reached from the store)
// leaves that block out where a path from the store comes back to it.
function pick_loads(w: Walk, dom: ssadeps.Dom, after0: boolean[], own pick: Picked, lb: i32, stop: i32, sb: i32, si: i32, st: ssa.SInst): Picked {
  let after: boolean[] = after0;
  let avoided: boolean = !after0[lb];
  let li: i32 = 0;
  while (li < stop) {
    let ld: ssa.SInst = w.f.blocks[lb].insts[li];
    if (is_load(ld) && ld.result >= 0 && ld.result < w.f.nvals && matches_store(w, ld, st)) {
      pick = Picked { ...pick, any: nearer(w, dom, sb, pick.any, ld.result) };
      if (!avoided) {
        after = reached_avoiding(w, sb, lb);
        avoided = true;
      }
      if (used_after(w, after, w.root[ld.result], sb, si)) {
        pick = Picked { ...pick, used: nearer(w, dom, sb, pick.used, ld.result) };
      }
    }
    li = li + 1;
  }
  return pick;
}

// nearer picks, of two loads before the store in block `sb`, the one the
// store sees last: the later in the store's own block, else the one in the
// deeper dominating block.
function nearer(w: Walk, dom: ssadeps.Dom, sb: i32, a: i32, b: i32): i32 {
  if (a < 0) {
    return b;
  }
  let ba: i32 = w.defs.block[a];
  let bb: i32 = w.defs.block[b];
  if (ba == bb) {
    if (w.defs.at[b] > w.defs.at[a]) {
      return b;
    }
    return a;
  }
  if (bb == sb || ba != sb && dom.pre[bb] > dom.pre[ba]) {
    return b;
  }
  return a;
}

// used_after: some value of `root` is read after position (sb, si): later
// in that block, or in a block reached from it (`after`).
function used_after(w: Walk, after: boolean[], root: i32, sb: i32, si: i32): boolean {
  let bi: i32 = 0;
  while (bi < w.f.blocks.len()) {
    if (bi == sb || after[bi]) {
      let from: i32 = 0;
      if (bi == sb && !after[bi]) {
        from = si + 1;
      }
      if (reads_root(w, bi, from, root)) {
        return true;
      }
    }
    bi = bi + 1;
  }
  return false;
}

// reads_root: block `bi` reads a value of `root` at or after position `from`.
function reads_root(w: Walk, bi: i32, from: i32, root: i32): boolean {
  let insts: ssa.SInst[] = w.f.blocks[bi].insts;
  let i: i32 = from;
  while (i < insts.len()) {
    for a in insts[i].args {
      if (a >= 0 && w.root[a] == root) {
        return true;
      }
    }
    i = i + 1;
  }
  let t: ssa.STerm = w.f.blocks[bi].term;
  return t.value >= 0 && w.root[t.value] == root;
}

// reached_from marks the blocks a path leaves block `sb` into, `sb` itself
// only round a loop.
function reached_from(w: Walk, sb: i32): boolean[] {
  return reached_in(w.f, w.at, sb, -1);
}

// reached_avoiding is reached_from with no path through block `avoid`.
function reached_avoiding(w: Walk, sb: i32, avoid: i32): boolean[] {
  return reached_in(w.f, w.at, sb, avoid);
}

function reached_in(f: ssa.SFunc, at: i32[], sb: i32, avoid: i32): boolean[] {
  let n: i32 = f.blocks.len();
  let seen: boolean[] = __alloc_bool(n);
  let work: i32[] = [sb];
  let i: i32 = 0;
  while (i < work.len()) {
    let t: ssa.STerm = f.blocks[work[i]].term;
    let e: i32 = 0;
    while (e < 2) {
      let sid: i32 = ssa.successor_id(t, e);
      if (sid >= 0 && at[sid] >= 0 && at[sid] != avoid && !seen[at[sid]]) {
        seen = seen.with(at[sid], true);
        work = work.append(at[sid]);
      }
      e = e + 1;
    }
    i = i + 1;
  }
  return seen;
}

// indexes assigns each tracked root a slot in the rows: every fresh,
// transferred, child and unknown root, and a borrow or a phi something
// touches. A phi one of whose operands is tracked is tracked too, to a
// fixpoint, since a unit reaches a phi through a phi.
// tracked_root: a fresh, transferred, child or unknown root is always
// tracked; a borrow only once something touches it.
function tracked_root(w: Walk, touched: boolean[], v: i32): boolean {
  if (w.root[v] != v) {
    return false;
  }
  let o: i32 = w.origin[v];
  if (o == org_fresh() || o == org_transferred() || o == org_child() || o == org_unknown()) {
    return true;
  }
  return o != org_none() && touched[v];
}

// grow_phis marks each phi one of whose operands is marked, to a fixpoint:
// a unit reaches a phi through a phi.
function grow_phis(w: Walk, own on: boolean[]): boolean[] {
  let grown: boolean = true;
  while (grown) {
    grown = false;
    for b in w.f.blocks {
      for ins in b.insts {
        if (ins.kind_tag == 8 && ins.result >= 0 && !on[ins.result] && any_on(w, on, ins.args)) {
          on = on.with(ins.result, true);
          grown = true;
        }
      }
    }
  }
  return on;
}

function any_on(w: Walk, on: boolean[], args: i32[]): boolean {
  for a in args {
    if (a >= 0 && !w.derived[a] && on[w.root[a]]) {
      return true;
    }
  }
  return false;
}

function indexes(w: Walk, touched: boolean[]): i32[] {
  let f: ssa.SFunc = w.f;
  let on: boolean[] = __alloc_bool(f.nvals);
  let v: i32 = 0;
  while (v < f.nvals) {
    on = on.with(v, tracked_root(w, touched, v));
    v = v + 1;
  }
  on = grow_phis(w, on);
  let idx: i32[] = util.minus_ones(f.nvals);
  let n: i32 = 0;
  v = 0;
  while (v < f.nvals) {
    if (on[v]) {
      idx = idx.with(v, n);
      n = n + 1;
    }
    v = v + 1;
  }
  return idx;
}

// ---- the rows, by liveness --------------------------------------------------

// Live lays the rows out by liveness. A block's row is the tracked slots
// live at its entry, the slots it defines and the slots its null stores
// credit; the row it hands a successor holds the slots live at that
// successor's entry, in the successor's order, so the entry meet is
// elementwise. A slot in a block's row and not in a successor's entry dies
// on that edge. Every list is a span of `slots`; a block's edge `e` is entry
// `bi * 2 + e` of the per-edge tables, `out_at` -1 for an edge that leads
// nowhere.
struct Live {
  ok: boolean,
  why: string,
  slots: i32[],
  in_at: i32[],
  in_n: i32[],
  row_at: i32[],
  row_n: i32[],
  die_at: i32[],
  die_n: i32[],
  out_at: i32[],
  nout: i32,
}

// alias_deps makes a value's root live wherever the value is: a derived
// pointer or a copy reads the object its root names.
function alias_deps(w: Walk): i32[][] {
  let deps: i32[][] = [];
  let v: i32 = 0;
  while (v < w.f.nvals) {
    if (w.root[v] != v) {
      deps = deps.append([w.root[v]]);
    } else {
      deps = deps.append([]);
    }
    v = v + 1;
  }
  return deps;
}

// Marked is a slot list under construction with the membership marks that
// keep it free of repeats.
struct Marked { mark: boolean[], list: i32[] }

function add_slot(own m: Marked, k: i32): Marked {
  if (k < 0 || m.mark[k]) {
    return m;
  }
  return Marked { mark: m.mark.with(k, true), list: m.list.append(k) };
}

function add_value(own m: Marked, w: Walk, v: i32): Marked {
  if (v < 0) {
    return m;
  }
  return add_slot(m, w.idx[w.root[v]]);
}

function clear_marks(own m: Marked): Marked {
  for k in m.list {
    m = Marked { ...m, mark: m.mark.with(k, false) };
  }
  return Marked { mark: m.mark, list: [] };
}

// in_slots lists the slots of the values live at block bi's entry.
function in_slots(w: Walk, fl: ssalive.Flow, own m: Marked, bi: i32): Marked {
  let ids: i32[] = ssalive.live_in_ids(fl, bi);
  for v in ids {
    m = add_value(m, w, v);
  }
  return m;
}

// row_slots extends a block's live-in slots with the slots the block
// defines and the slots its null stores credit.
function row_slots(w: Walk, takes: Takes, own m: Marked, bi: i32): Marked {
  let b: ssa.SBlock = w.f.blocks[bi];
  if (bi == w.at[w.f.entry]) {
    let v: i32 = 0;
    while (v < w.f.nparams) {
      m = add_value(m, w, v);
      v = v + 1;
    }
  }
  for ins in b.insts {
    m = add_value(m, w, ins.result);
  }
  let i: i32 = takes.first[bi];
  while (i >= 0 && i < takes.block.len() && takes.block[i] == bi) {
    for r in takes.roots[i] {
      m = add_slot(m, w.idx[r]);
    }
    i = i + 1;
  }
  return m;
}

// Spans is the slot pool with one list's span appended at a time.
struct Spans { slots: i32[], at: i32[], n: i32[] }

function push_span(own sp: Spans, list: i32[]): Spans {
  let at: i32 = sp.slots.len();
  let slots: i32[] = sp.slots;
  for k in list {
    slots = slots.append(k);
  }
  return Spans { slots: slots, at: sp.at.append(at), n: sp.n.append(list.len()) };
}

// die_slots lists the slots of block bi's row that are not live at the
// entry of its successor `si`.
function die_slots(lv: Live, own m: Marked, bi: i32, si: i32): Marked {
  let j: i32 = 0;
  while (j < lv.in_n[si]) {
    m = Marked { ...m, mark: m.mark.with(lv.slots[lv.in_at[si] + j], true) };
    j = j + 1;
  }
  let dies: i32[] = [];
  j = 0;
  while (j < lv.row_n[bi]) {
    let k: i32 = lv.slots[lv.row_at[bi] + j];
    if (!m.mark[k]) {
      dies = dies.append(k);
    }
    j = j + 1;
  }
  j = 0;
  while (j < lv.in_n[si]) {
    m = Marked { ...m, mark: m.mark.with(lv.slots[lv.in_at[si] + j], false) };
    j = j + 1;
  }
  return Marked { mark: m.mark, list: dies };
}

function no_live(why: string): Live {
  return Live { ok: false, why: why, slots: [], in_at: [], in_n: [], row_at: [], row_n: [], die_at: [], die_n: [], out_at: [], nout: 0 };
}

// live_rows lays out each block's entry and row lists.
function live_rows(w: Walk, fl: ssalive.Flow, takes: Takes): Live {
  let m: Marked = Marked { mark: __alloc_bool(w.tracked), list: [] };
  let ins: Spans = Spans { slots: [], at: [], n: [] };
  let rows: Spans = Spans { slots: [], at: [], n: [] };
  let bi: i32 = 0;
  while (bi < w.f.blocks.len()) {
    m = in_slots(w, fl, m, bi);
    ins = push_span(ins, m.list);
    m = row_slots(w, takes, m, bi);
    rows = push_span(rows, m.list);
    m = clear_marks(m);
    bi = bi + 1;
  }
  let slots: i32[] = ins.slots;
  let shift: i32 = slots.len();
  for k in rows.slots {
    slots = slots.append(k);
  }
  let row_at: i32[] = [];
  for at in rows.at {
    row_at = row_at.append(at + shift);
  }
  return Live { ok: true, why: "", slots: slots, in_at: ins.at, in_n: ins.n, row_at: row_at, row_n: rows.n, die_at: [], die_n: [], out_at: [], nout: 0 };
}

// live_edges lays out each edge's death list and the span of its out row.
function live_edges(w: Walk, own lv: Live): Live {
  let m: Marked = Marked { mark: __alloc_bool(w.tracked), list: [] };
  let dies: Spans = Spans { slots: lv.slots, at: [], n: [] };
  let out_at: i32[] = [];
  let nout: i32 = 0;
  let bi: i32 = 0;
  while (bi < w.f.blocks.len()) {
    let e: i32 = 0;
    while (e < 2) {
      let sid: i32 = ssa.successor_id(w.f.blocks[bi].term, e);
      let si: i32 = -1;
      if (sid >= 0) {
        si = w.at[sid];
      }
      if (si >= 0) {
        m = die_slots(lv, m, bi, si);
        dies = push_span(dies, m.list);
        out_at = out_at.append(nout);
        nout = nout + lv.in_n[si];
      } else {
        dies = push_span(dies, []);
        out_at = out_at.append(-1);
      }
      e = e + 1;
    }
    bi = bi + 1;
  }
  return Live { ...lv, slots: dies.slots, die_at: dies.at, die_n: dies.n, out_at: out_at, nout: nout };
}

// debt_deps keeps a payload in debt live to the null store that takes it:
// the store's null word depends on the load, where the load comes first.
function debt_deps(w: Walk, takes: Takes, own deps: i32[][]): i32[][] {
  if (w.debt.len() == 0) {
    return deps;
  }
  let k: i32 = 0;
  while (k < takes.block.len()) {
    let st: ssa.SInst = w.f.blocks[takes.block[k]].insts[takes.at[k]];
    let zero: i32 = st.args[st.args.len() - 1];
    for r in takes.roots[k] {
      if (in_debt(w, r) && zero >= 0 && zero < deps.len() && defined_before(w, r, zero)) {
        deps = deps.with(zero, deps[zero].append(r));
      }
    }
    k = k + 1;
  }
  return deps;
}

// defined_before: `a`'s definition comes before `b`'s on every path to it.
function defined_before(w: Walk, a: i32, b: i32): boolean {
  let ab: i32 = w.defs.block[a];
  let bb: i32 = w.defs.block[b];
  if (ab < 0 || bb < 0) {
    return false;
  }
  if (ab == bb) {
    return w.defs.at[a] < w.defs.at[b];
  }
  return ssadeps.dom_holds(w.dom, bb, ab);
}

// tracked_values marks the values whose root the walk tracks, the only ones
// live_rows reads a liveness bit for.
function tracked_values(w: Walk): boolean[] {
  let out: boolean[] = __alloc_bool(w.f.nvals);
  let v: i32 = 0;
  while (v < w.f.nvals && v < w.root.len()) {
    let r: i32 = w.root[v];
    if (r >= 0 && r < w.idx.len() && w.idx[r] >= 0) {
      out = out.with(v, true);
    }
    v = v + 1;
  }
  return out;
}

function live_of(w: Walk, takes: Takes): Live {
  let fl: ssalive.Flow = ssalive.compute_kept(w.f, debt_deps(w, takes, alias_deps(w)), tracked_values(w));
  if (!fl.ok) {
    return no_live(fl.why);
  }
  return live_edges(w, live_rows(w, fl, takes));
}

// ---- the dataflow -----------------------------------------------------------

// Progress is the dataflow's state: `out` holds the row each block hands
// each successor, laid out by `Live`; `phin` holds each tracked phi's
// inputs, those of phi `v` from `phi_at[v]`; `state` is one row of every
// tracked slot, reused block by block and cleared of a block's slots when
// its round ends, so only the slots in the block's row are ever read.
// `maybe_at` is, per slot, the block whose entry first met the slot's
// count to maybe, -1 for none: the join a token's walks may settle.
// `ulog` and `mlog` list the slots the block being run leaves unproved and
// meets at maybe, for its Memo.
struct Progress { out: i32[], done: boolean[], phi_at: i32[], phin: i32[], state: i32[], findings: Finding[], opaque: string[], unproved: boolean[], maybe_at: i32[], ulog: i32[], mlog: i32[] }

function filled(n: i32, v: i32): i32[] {
  let out: i32[] = __alloc_i32(n);
  if (v == 0) {
    return out;
  }
  let i: i32 = 0;
  while (i < n) {
    out = out.with(i, v);
    i = i + 1;
  }
  return out;
}

function kind_of(w: Walk, v: i32): string {
  if (v < w.f.nparams) {
    return "param";
  }
  return ssa.kind_name(def_of(w.f, w.defs, v).kind_tag);
}

function child_why(w: Walk, root: i32): string {
  if (root >= w.why.len() || w.origin[root] != org_child()) {
    return "";
  }
  if (w.why[root] == 1) {
    if (root < w.opened.len() && w.opened[root] >= 0) {
      return " in a unique region opened at b" + util.i32_to_string(w.opened[root]);
    }
    return " of a children-only drop's box";
  }
  if (w.why[root] == 2) {
    return " of an overwritten slot";
  }
  return " of a shell";
}

function found(own p: Progress, w: Walk, kind: string, root: i32, block: i32, message: string): Progress {
  let x: Finding = Finding { kind: kind, value: root, block: block, defined: origin_name(w.origin[root]) + " " + kind_of(w, root) + child_why(w, root), message: message };
  return Progress { ...p, findings: p.findings.append(x) };
}

// spend takes one unit off `v`'s root: a release, a move or a return.
function spend(own p: Progress, w: Walk, v: i32, block: i32, what: string): Progress {
  let r: i32 = w.root[v];
  let k: i32 = w.idx[r];
  if (k < 0) {
    return p;
  }
  let s: i32 = p.state[k];
  if (s == maybe()) {
    return p;
  }
  if (s == absent()) {
    return Progress { ...p, state: p.state.with(k, maybe()) };
  }
  if (s == 0 && in_debt(w, r)) {
    return Progress { ...p, state: p.state.with(k, owed()) };
  }
  if (s == 0 || s == owed()) {
    return found(p, w, "spent without a unit", r, block, what);
  }
  return Progress { ...p, state: p.state.with(k, s - 1) };
}

// spend_counted is a release's or a move's spend: the callee consumes a
// unit, so a word nothing counts — an op's result with no mark and no
// row — handed to it is a producer the lowering left unmarked, or a
// release of a scalar.
function spend_counted(own p: Progress, w: Walk, v: i32, block: i32, what: string): Progress {
  let r: i32 = w.root[v];
  if (w.idx[r] < 0 && w.origin[r] == org_none() && r >= w.f.nparams) {
    let k: i32 = def_of(w.f, w.defs, r).kind_tag;
    if (is_named_op(k)) {
      return found(p, w, "spent a word nothing counts", r, block, what);
    }
  }
  return spend(p, w, v, block, what);
}

// spend_if_held is a return's spend where nothing declared whether the
// result carries a unit: one is given up when the frame holds one, and a
// borrow returned is not a finding.
function spend_if_held(own p: Progress, w: Walk, v: i32): Progress {
  let k: i32 = w.idx[w.root[v]];
  if (k < 0 || p.state[k] <= 0) {
    return p;
  }
  return Progress { ...p, state: p.state.with(k, p.state[k] - 1) };
}

function retain(own p: Progress, w: Walk, v: i32, result: i32): Progress {
  let r: i32 = w.root[v];
  let k: i32 = w.idx[r];
  if (k < 0) {
    return p;
  }
  // A retain of a value read out of a box the frame owns, where neither the
  // retain's result nor the value is read again: the box takes the unit, as
  // when the lowering fills an option it made with a payload it borrowed.
  // Read again, the value is the frame's own binding and the unit is its.
  if (result >= 0 && w.uses[result] == 0 && w.uses[v] == 1 && w.origin[r] == org_borrowed() && owned_base(w, r)) {
    return p;
  }
  let s: i32 = p.state[k];
  if (s == maybe()) {
    return p;
  }
  if (s == owed()) {
    return Progress { ...p, state: p.state.with(k, 0) };
  }
  if (s == absent() || s + 1 > cap()) {
    return Progress { ...p, state: p.state.with(k, maybe()) };
  }
  return Progress { ...p, state: p.state.with(k, s + 1) };
}

function owned_base(w: Walk, v: i32): boolean {
  let d: ssa.SInst = def_of(w.f, w.defs, v);
  if (!is_load(d) || d.args.len() == 0) {
    return false;
  }
  let o: i32 = w.origin[w.root[d.args[0]]];
  return o == org_fresh() || o == org_transferred() || o == org_child();
}

function poison(own p: Progress, w: Walk, v: i32): Progress {
  let k: i32 = w.idx[w.root[v]];
  if (k < 0) {
    return p;
  }
  return Progress { ...p, state: p.state.with(k, maybe()) };
}

function poison_all(own p: Progress, w: Walk, args: i32[]): Progress {
  for a in args {
    p = poison(p, w, a);
  }
  return p;
}

// define sets a root's count to what its definition hands the frame. A count
// still held from the previous execution of the same definition — a loop
// body that allocates without releasing — is a leak of that earlier value.
function define(own p: Progress, w: Walk, v: i32, block: i32): Progress {
  if (v < 0 || w.root[v] != v) {
    return p;
  }
  let k: i32 = w.idx[v];
  if (k < 0) {
    return p;
  }
  if (p.state[k] > 0) {
    p = found(p, w, "redefined while held", v, block, "the previous value's unit was never spent");
  }
  return Progress { ...p, state: p.state.with(k, initial_count(w.origin[v])) };
}

// apply_sig applies a helper's row to its operands.
function apply_sig(own p: Progress, w: Walk, ins: ssa.SInst, block: i32, s: rcsigs.Sig): Progress {
  if (s.arg >= 0 && s.arg < ins.args.len()) {
    p = apply_effect(p, w, ins, block, s.effect, ins.args[s.arg]);
  }
  for i in s.also {
    if (i < ins.args.len()) {
      p = spend(p, w, ins.args[i], block, "moved into " + ins.str);
    }
  }
  for i in s.unsure {
    if (i < ins.args.len()) {
      p = poison(p, w, ins.args[i]);
    }
  }
  return p;
}

function apply_effect(own p: Progress, w: Walk, ins: ssa.SInst, block: i32, effect: i32, v: i32): Progress {
  if (effect == rcsigs.effect_retain()) {
    return retain(p, w, v, ins.result);
  }
  if (effect == rcsigs.effect_release() || effect == rcsigs.effect_move()) {
    return spend_counted(p, w, v, block, "released by " + ins.str);
  }
  if (effect == rcsigs.effect_move_if_held()) {
    return spend_if_held(p, w, v);
  }
  if (effect == rcsigs.effect_unsure()) {
    return poison(p, w, v);
  }
  return p;
}

function apply_call(own p: Progress, w: Walk, ins: ssa.SInst, block: i32): Progress {
  let s: rcsigs.Sig = w.sigs.lookup(ins.str);
  if (s.known) {
    p = apply_sig(p, w, ins, block, s);
    return define(p, w, ins.result, block);
  }
  let a: Abi = w.abis.lookup(ins.str);
  if (!a.known) {
    p = poison_all(p, w, ins.args);
    p = Progress { ...p, opaque: p.opaque.append(ins.str) };
    return define(p, w, ins.result, block);
  }
  let i: i32 = 0;
  while (i < ins.args.len() && i < a.modes.len()) {
    if (a.modes[i] == counted_mode()) {
      p = spend(p, w, ins.args[i], block, "moved into " + ins.str);
    }
    i = i + 1;
  }
  return define(p, w, ins.result, block);
}

// apply_ret_word: the second word of a paired return leaves with a unit on
// the body's own terms.
function apply_ret_word(own p: Progress, w: Walk, ins: ssa.SInst, block: i32): Progress {
  if (second_holds(w.self_abi.pair_second)) {
    return spend(p, w, ins.args[0], block, "returned as the second word");
  }
  if (w.self_abi.pair_second == -2) {
    return spend_if_held(p, w, ins.args[0]);
  }
  return p;
}

// apply_op_row applies a named op's row: the operands it boxes or pushes,
// and the one it consumes.
function apply_op_row(own p: Progress, w: Walk, ins: ssa.SInst, block: i32, s: rcsigs.Sig): Progress {
  if (rcsigs.boxes_operands(ins.str)) {
    for a in ins.args {
      p = spend(p, w, a, block, "boxed by " + ins.str);
    }
  } else if (rcsigs.pushes_element(ins.str) && ins.args.len() > 0) {
    p = spend(p, w, ins.args[ins.args.len() - 1], block, "pushed by " + ins.str);
  }
  if (s.arg < 0 || s.arg >= ins.args.len()) {
    return p;
  }
  if (s.effect == rcsigs.effect_release() || s.effect == rcsigs.effect_move()) {
    return spend_counted(p, w, ins.args[s.arg], block, "consumed by " + ins.str);
  }
  if (s.effect == rcsigs.effect_move_if_held()) {
    return spend_if_held(p, w, ins.args[s.arg]);
  }
  return p;
}

function apply_named_op(own p: Progress, w: Walk, ins: ssa.SInst, block: i32): Progress {
  if (ins.str == "ret_word" && ins.args.len() == 1) {
    return apply_ret_word(p, w, ins, block);
  }
  let s: rcsigs.Sig = w.ops.op_lookup(ins.str);
  if (s.known) {
    p = apply_op_row(p, w, ins, block, s);
  }
  return define(p, w, ins.result, block);
}

// apply_store: the stored value's unit passes into the container. A null
// store empties a slot the frame took the unit of: the loads it matched were
// marked at the definition, and the count moves at the store. Under a
// token's value a reused box is the box itself, so a value read out of a
// slot and stored back into it is kept, not spent (put_back).
function apply_store(own p: Progress, w: Walk, ins: ssa.SInst, block: i32, taken: i32[]): Progress {
  let val: i32 = ins.args[ins.args.len() - 1];
  if (w.held >= 0 && put_back(w, ins, val)) {
    return p;
  }
  if (zero_at(w, val)) {
    for r in taken {
      let k: i32 = w.idx[r];
      if (k >= 0 && p.state[k] != maybe()) {
        let s: i32 = p.state[k];
        if (s == owed()) {
          p = Progress { ...p, state: p.state.with(k, 0) };
        } else if (s == absent() || s + 1 > cap()) {
          p = Progress { ...p, state: p.state.with(k, maybe()) };
        } else {
          p = Progress { ...p, state: p.state.with(k, s + 1) };
        }
      }
    }
    return p;
  }
  return spend(p, w, val, block, "stored into a box");
}

// put_back: `st` stores `val` back where it was read (Walk.kept).
function put_back(w: Walk, st: ssa.SInst, val: i32): boolean {
  if (st.kind_tag != 41 || val < 0 || val >= w.kept.len() || !w.kept[w.root[val]] || st.args.len() < 2 || w.root[st.args[0]] != w.held) {
    return false;
  }
  return def_of(w.f, w.defs, w.root[val]).imm == st.imm;
}

// put_backs marks the borrows read off the held box whose every store back
// into the slot they were read from has no reload of the slot and no
// children-only drop of the box between: the slot's unit is still the
// value's, and the store keeps it there. A reload between released the
// slot's unit (an overwritten slot's child), so the store spends one; and a
// child's unit is the frame's, which the store hands back to the slot.
function put_backs(w: Walk, st: Stores, dom: ssadeps.Dom): boolean[] {
  if (w.held < 0) {
    return [];
  }
  let out: boolean[] = __alloc_bool(w.f.nvals);
  let refused: boolean[] = __alloc_bool(w.f.nvals);
  let k: i32 = 0;
  while (k < st.base.len()) {
    let ins: ssa.SInst = w.f.blocks[st.block[k]].insts[st.at[k]];
    if (st.base[k] == w.held && ins.kind_tag == 41 && !st.zero[k]) {
      let val: i32 = w.root[ins.args[ins.args.len() - 1]];
      let ld: ssa.SInst = def_of(w.f, w.defs, val);
      let lb: i32 = w.defs.block[val];
      if (ld.kind_tag == 40 && ld.args.len() > 0 && ld.imm == ins.imm && w.root[ld.args[0]] == w.held && lb >= 0 && w.origin[val] == org_borrowed()) {
        if ((lb == st.block[k] && w.defs.at[val] < st.at[k] || ssadeps.dom_holds(dom, st.block[k], lb))
          && !between(w, dom, ld, lb, w.defs.at[val], st.block[k], st.at[k])) {
          out = out.with(val, true);
        } else {
          refused = refused.with(val, true);
        }
      }
    }
    k = k + 1;
  }
  let v: i32 = 0;
  while (v < out.len()) {
    if (refused[v]) {
      out = out.with(v, false);
    }
    v = v + 1;
  }
  return out;
}

function apply(own p: Progress, w: Walk, ins: ssa.SInst, block: i32, taken: i32[]): Progress {
  let k: i32 = ins.kind_tag;
  if (k == 11) {
    return apply_call(p, w, ins, block);
  }
  if (is_named_op(k)) {
    return apply_named_op(p, w, ins, block);
  }
  if (is_store(k) && ins.args.len() >= 2) {
    return apply_store(p, w, ins, block, taken);
  }
  if (k == 56 || k == 60) {
    p = poison_all(p, w, ins.args);
    return define(p, w, ins.result, block);
  }
  return define(p, w, ins.result, block);
}

// taken_by lists, for a null store, the load roots it empties the slot of.
// Computed once per store position rather than per round.
struct Takes { block: i32[], at: i32[], roots: i32[][], first: i32[] }

function no_takes(): Takes {
  return Takes { block: [], at: [], roots: [], first: [] };
}

function takes_of(w: Walk, dom: ssadeps.Dom): Takes {
  let out: Takes = Takes { block: [], at: [], roots: [], first: util.minus_ones(w.f.blocks.len()) };
  let sb: i32 = 0;
  while (sb < w.f.blocks.len()) {
    out = block_takes(out, w, dom, sb);
    sb = sb + 1;
  }
  return out;
}

// block_takes adds block `sb`'s takes, finding the blocks reached from it
// once for all of them.
function block_takes(own out: Takes, w: Walk, dom: ssadeps.Dom, sb: i32): Takes {
  let insts: ssa.SInst[] = w.f.blocks[sb].insts;
  let after: boolean[] = [];
  let si: i32 = 0;
  while (si < insts.len()) {
    let st: ssa.SInst = insts[si];
    if (is_take(w, st)) {
      if (after.len() == 0) {
        after = reached_from(w, sb);
      }
      let r: i32 = taken_root(w, dom, after, sb, si, st);
      let rs: i32[] = [];
      if (r >= 0) {
        rs = rs.append(r);
      }
      let first: i32[] = out.first;
      if (first[sb] < 0) {
        first = first.with(sb, out.block.len());
      }
      out = Takes { block: out.block.append(sb), at: out.at.append(si), roots: out.roots.append(rs), first: first };
    }
    si = si + 1;
  }
  return out;
}

// taken_at is the take at instruction `at` of block `block`, found through
// `t.first`: the index of the block's first take, its takes being listed in
// block order and position order.
function taken_at(t: Takes, block: i32, at: i32): i32[] {
  let i: i32 = t.first[block];
  while (i >= 0 && i < t.block.len() && t.block[i] == block) {
    if (t.at[i] == at) {
      return t.roots[i];
    }
    i = i + 1;
  }
  return [];
}

// exits reports a block that ends the process, whose return is never run.
function exits(b: ssa.SBlock): boolean {
  for ins in b.insts {
    if (ins.kind_tag == 50 && ins.str == "exit") {
      return true;
    }
  }
  return false;
}

// entry_row meets the predecessors' rows for the slots live at block bi's
// entry. A count the paths disagree on becomes unproved rather than a
// finding: the lowering pairs a retain on one arm of a test with a consume
// on a later arm of the same test, so disagreement at a join is routine,
// and a unit still held shows where the value dies instead.
function entry_row(own p: Progress, w: Walk, lv: Live, bi: i32): Progress {
  let b: ssa.SBlock = w.f.blocks[bi];
  let bases: i32[] = [];
  for pid in b.preds {
    let pb: i32 = w.at[pid];
    if (pb >= 0 && p.done[pb]) {
      bases = bases.append(edge_base(w, lv, pb, b.id));
    }
  }
  let j: i32 = 0;
  while (j < lv.in_n[bi]) {
    let s: i32 = absent();
    for base in bases {
      s = meet(s, p.out[base + j]);
    }
    let k: i32 = lv.slots[lv.in_at[bi] + j];
    if (s == maybe()) {
      p = met_maybe(p, k, bi);
    }
    p = Progress { ...p, state: p.state.with(k, s) };
    j = j + 1;
  }
  return p;
}

// met_maybe records that block bi's entry met slot k at maybe: the first
// block of the round to do so is the slot's maybe_at.
function met_maybe(own p: Progress, k: i32, bi: i32): Progress {
  if (p.maybe_at[k] < 0) {
    p = Progress { ...p, maybe_at: p.maybe_at.with(k, bi) };
  }
  return Progress { ...p, mlog: p.mlog.append(k) };
}

// edge_base is where block pb's row for the edge into block `id` starts.
function edge_base(w: Walk, lv: Live, pb: i32, id: i32): i32 {
  let t: ssa.STerm = w.f.blocks[pb].term;
  let e: i32 = 0;
  if (ssa.successor_id(t, 1) == id && ssa.successor_id(t, 0) != id) {
    e = 1;
  }
  return lv.out_at[pb * 2 + e];
}

function enter_phis(own p: Progress, w: Walk, bi: i32): Progress {
  let b: ssa.SBlock = w.f.blocks[bi];
  for ins in b.insts {
    if (ins.kind_tag != 8 || ins.result < 0) {
      continue;
    }
    let k: i32 = w.idx[ins.result];
    if (k < 0) {
      continue;
    }
    if (p.state[k] > 0) {
      p = found(p, w, "redefined while held", ins.result, b.id, "the previous value's unit was never spent");
    }
    let at: i32 = p.phi_at[ins.result];
    let s: i32 = absent();
    let i: i32 = 0;
    while (i < b.preds.len()) {
      s = meet(s, p.phin[at + i]);
      i = i + 1;
    }
    if (s == maybe()) {
      p = met_maybe(p, k, bi);
    }
    if (s == absent()) {
      s = maybe();
    }
    p = Progress { ...p, state: p.state.with(k, s) };
  }
  return p;
}

// null_on_edge is the value a branch proves null on the edge to `sid`: the
// `x == 0` arm, the `x != 0` fall-through, or a `brif x` fall-through. A
// null holds no unit whatever its count said, since every release guards
// it, so on that edge the value is absent: a word, not a spent box.
function null_on_edge(w: Walk, bi: i32, sid: i32): i32 {
  let tg: Tag = tag_on_edge(w, bi, sid);
  if (tg.word >= 0 && tg.c == 0 && tg.equal) {
    return tg.word;
  }
  return -1;
}

// Tag is what a branch settles about a word on one edge: `word == c` or
// `word != c`; `word` -1 when it settles nothing.
struct Tag { word: i32, c: i32, equal: boolean }

// compared reads `x == c` / `x != c` against a constant: the word and the
// constant, word -1 when neither side is one.
function compared(w: Walk, ins: ssa.SInst): Tag {
  let a: ssa.SInst = def_at(w, ins.args[1]);
  if (a.kind_tag == 1) {
    return Tag { word: ins.args[0], c: a.imm, equal: true };
  }
  let b: ssa.SInst = def_at(w, ins.args[0]);
  if (b.kind_tag == 1) {
    return Tag { word: ins.args[1], c: b.imm, equal: true };
  }
  return Tag { word: -1, c: 0, equal: false };
}

function tag_on_edge(w: Walk, bi: i32, sid: i32): Tag {
  let t: ssa.STerm = w.f.blocks[bi].term;
  if (t.kind_tag != 3 || t.t == t.f) {
    return Tag { word: -1, c: 0, equal: false };
  }
  let ins: ssa.SInst = def_of(w.f, w.defs, t.cond);
  if (ins.kind_tag == 9 && ins.args.len() == 2 && (ins.str == "eq" || ins.str == "ne")) {
    let tg: Tag = compared(w, ins);
    let equal: boolean = sid == t.t;
    if (ins.str == "ne") {
      equal = !equal;
    }
    return Tag { ...tg, equal: equal };
  }
  return Tag { word: t.cond, c: 0, equal: sid == t.f };
}

// settle_edge applies what the branch into `sid` proves: a null word, and
// the tag a pair word's unit hangs on.
function settle_edge(own p: Progress, w: Walk, bi: i32, sid: i32): Progress {
  let null_v: i32 = null_on_edge(w, bi, sid);
  if (null_v >= 0 && w.idx[w.root[null_v]] >= 0) {
    p = Progress { ...p, state: p.state.with(w.idx[w.root[null_v]], absent()) };
  }
  if (w.pair_words.len() > 0) {
    p = settle_pair_words(p, w, bi, sid);
  }
  return p;
}

// settle_pair_words clears a paired call's second word on the edge where the
// first word is settled to a tag whose payload is no reference, or away from
// the last tag whose payload is, counting the tags the branches dominating
// this one already settled it away from.
function settle_pair_words(own p: Progress, w: Walk, bi: i32, sid: i32): Progress {
  let tg: Tag = tag_on_edge(w, bi, sid);
  if (tg.word < 0 || tg.c < 0 || tg.c >= 31) {
    return p;
  }
  let bit: i32 = 1 << tg.c;
  let away: i32 = -1;
  for v in w.pair_words {
    if (w.root[w.pair_tag[v]] != w.root[tg.word]) {
      continue;
    }
    let mask: i32 = w.pair_mask[v];
    let empty: boolean = false;
    if (tg.equal) {
      empty = (mask & bit) == 0;
    } else {
      if (away < 0) {
        away = bit | excluded_tags(w, bi, tg.word);
      }
      empty = (mask & away) == mask;
    }
    let k: i32 = w.idx[w.root[v]];
    if (empty && k >= 0) {
      p = Progress { ...p, state: p.state.with(k, absent()) };
    }
  }
  return p;
}

// excluded_tags is the set of tags the branches dominating `bi` have settled
// `word` away from: each a compare whose unequal successor has that branch
// as its only predecessor and dominates `bi`.
function excluded_tags(w: Walk, bi: i32, word: i32): i32 {
  let out: i32 = 0;
  let d: i32 = 0;
  while (d < w.f.blocks.len()) {
    let t: ssa.STerm = w.f.blocks[d].term;
    if (d != bi && t.kind_tag == 3 && t.t != t.f && ssadeps.dom_holds(w.dom, bi, d)) {
      out = out | excluded_on(w, bi, d, t.t, word) | excluded_on(w, bi, d, t.f, word);
    }
    d = d + 1;
  }
  return out;
}

function excluded_on(w: Walk, bi: i32, d: i32, sid: i32, word: i32): i32 {
  let tg: Tag = tag_on_edge(w, d, sid);
  if (tg.word < 0 || tg.equal || tg.c < 0 || tg.c >= 31 || w.root[tg.word] != w.root[word]) {
    return 0;
  }
  let si: i32 = w.at[sid];
  if (si < 0 || w.f.blocks[si].preds.len() != 1 || !ssadeps.dom_holds(w.dom, bi, si)) {
    return 0;
  }
  return 1 << tg.c;
}

// feed hands each tracked phi of successor `sid` its input on the edge from
// block `bi`, and spends the unit on the value that feeds it.
// Fed is a phi's input on one edge, with the unit moved off the value that
// feeds it.
struct Fed { p: Progress, input: i32 }

function phi_input(own p: Progress, w: Walk, a: i32): Fed {
  if (a < 0 || w.derived[a]) {
    return Fed { p: p, input: 0 };
  }
  let k: i32 = w.idx[w.root[a]];
  if (k < 0) {
    return Fed { p: p, input: 0 };
  }
  let st: i32 = p.state[k];
  if (st == maybe() || st == absent() || st == owed()) {
    return Fed { p: p, input: maybe() };
  }
  if (st > 0) {
    p = Progress { ...p, state: p.state.with(k, st - 1) };
    return Fed { p: p, input: 1 };
  }
  return Fed { p: p, input: 0 };
}

function feed(own p: Progress, w: Walk, bi: i32, sid: i32): Progress {
  let si: i32 = w.at[sid];
  if (si < 0) {
    return p;
  }
  p = settle_edge(p, w, bi, sid);
  let s: ssa.SBlock = w.f.blocks[si];
  let pi: i32 = util.index_of_i32(s.preds, w.f.blocks[bi].id);
  if (pi < 0) {
    return p;
  }
  for ins in s.insts {
    if (ins.kind_tag != 8 || ins.result < 0 || w.idx[ins.result] < 0 || pi >= ins.args.len()) {
      continue;
    }
    let fed: Fed = phi_input(p, w, ins.args[pi]);
    p = fed.p;
    p = Progress { ...p, phin: p.phin.with(p.phi_at[ins.result] + pi, fed.input) };
  }
  return p;
}

// block_round runs one block's transfer and stores its edge rows. Returns
// whether a row changed.
struct RoundResult { p: Progress, changed: boolean }

// apply_return spends what the return hands out and retires the block's
// row: every value dies here.
function apply_return(own p: Progress, w: Walk, lv: Live, bi: i32): Progress {
  let b: ssa.SBlock = w.f.blocks[bi];
  let t: ssa.STerm = b.term;
  if (t.value >= 0) {
    let unit: boolean = w.self_abi.result_unit;
    let word: boolean = !w.self_abi.known || w.self_abi.result_word;
    if (w.paired) {
      unit = w.self_abi.pair_first;
      word = !w.self_abi.known;
    }
    if (unit) {
      p = spend(p, w, t.value, b.id, "returned");
    } else if (word) {
      p = spend_if_held(p, w, t.value);
    }
  }
  return retire(p, w, lv, lv.row_at[bi], lv.row_n[bi], b.id, "leaked at return");
}

// retire reports a unit still held on a slot whose value has no further
// read, and marks a count it could not settle unproved.
function retire(own p: Progress, w: Walk, lv: Live, at: i32, n: i32, block: i32, kind: string): Progress {
  let j: i32 = 0;
  while (j < n) {
    let k: i32 = lv.slots[at + j];
    let held: i32 = p.state[k];
    if (held > 0) {
      p = found(p, w, kind, root_at(w, k), block, util.i32_to_string(held) + " unit(s) still held");
    } else if (held == owed()) {
      p = found(p, w, "spent without a unit", root_at(w, k), block, "its slot was not emptied on this path");
    } else if (held == maybe()) {
      p = Progress { ...p, unproved: p.unproved.with(k, true), ulog: p.ulog.append(k) };
    }
    j = j + 1;
  }
  return p;
}

// hand_edges hands the block's row to each successor, the second from the
// same state as the first.
function hand_edges(own p: Progress, w: Walk, lv: Live, bi: i32): RoundResult {
  let t: ssa.STerm = w.f.blocks[bi].term;
  let saved: i32[] = row_values(p, lv, bi);
  let changed: boolean = false;
  let e: i32 = 0;
  while (e < 2) {
    if (lv.out_at[bi * 2 + e] >= 0 && (e == 0 || ssa.successor_id(t, 1) != ssa.successor_id(t, 0))) {
      if (e == 1) {
        p = restore_row(p, lv, bi, saved);
      }
      let r: RoundResult = hand_edge(p, w, lv, bi, e);
      p = r.p;
      changed = changed || r.changed;
    }
    e = e + 1;
  }
  return RoundResult { p: p, changed: changed };
}

// hand_edge feeds the successor's phis on edge `e` (feed settles what the
// branch proves on the edge first), retires what dies on the edge, and
// stores the row the successor reads. Returns whether that row changed.
function hand_edge(own p: Progress, w: Walk, lv: Live, bi: i32, e: i32): RoundResult {
  let sid: i32 = ssa.successor_id(w.f.blocks[bi].term, e);
  let si: i32 = w.at[sid];
  p = feed(p, w, bi, sid);
  p = retire(p, w, lv, lv.die_at[bi * 2 + e], lv.die_n[bi * 2 + e], w.f.blocks[bi].id, "leaked where it dies");
  let base: i32 = lv.out_at[bi * 2 + e];
  let changed: boolean = false;
  let j: i32 = 0;
  while (j < lv.in_n[si]) {
    let v: i32 = p.state[lv.slots[lv.in_at[si] + j]];
    if (p.out[base + j] != v) {
      changed = true;
      p = Progress { ...p, out: p.out.with(base + j, v) };
    }
    j = j + 1;
  }
  return RoundResult { p: p, changed: changed };
}

// row_values copies the block's row out of the state; restore_row puts it
// back; clear_row returns the row's slots to absent for the next block.
function row_values(p: Progress, lv: Live, bi: i32): i32[] {
  let out: i32[] = [];
  let j: i32 = 0;
  while (j < lv.row_n[bi]) {
    out = out.append(p.state[lv.slots[lv.row_at[bi] + j]]);
    j = j + 1;
  }
  return out;
}

function restore_row(own p: Progress, lv: Live, bi: i32, saved: i32[]): Progress {
  let j: i32 = 0;
  while (j < lv.row_n[bi]) {
    p = Progress { ...p, state: p.state.with(lv.slots[lv.row_at[bi] + j], saved[j]) };
    j = j + 1;
  }
  return p;
}

function clear_row(own p: Progress, lv: Live, bi: i32): Progress {
  let j: i32 = 0;
  while (j < lv.row_n[bi]) {
    p = Progress { ...p, state: p.state.with(lv.slots[lv.row_at[bi] + j], absent()) };
    j = j + 1;
  }
  return p;
}

function block_round(own p: Progress, w: Walk, lv: Live, bi: i32, takes: Takes): RoundResult {
  let b: ssa.SBlock = w.f.blocks[bi];
  p = entry_row(p, w, lv, bi);
  p = apply_block(p, w, bi, takes);
  let changed: boolean = false;
  if (exits(b)) {} else if (b.term.kind_tag == 1) {
    // The process ends here: nothing flows on to a successor or a return.
    p = apply_return(p, w, lv, bi);
  } else {
    let r: RoundResult = hand_edges(p, w, lv, bi);
    p = r.p;
    changed = r.changed;
  }
  p = clear_row(p, lv, bi);
  if (!p.done[bi]) {
    changed = true;
    p = Progress { ...p, done: p.done.with(bi, true) };
  }
  return RoundResult { p: p, changed: changed };
}

// apply_block defines the parameters at the entry, reads the phis, and
// applies each instruction.
function apply_block(own p: Progress, w: Walk, bi: i32, takes: Takes): Progress {
  let f: ssa.SFunc = w.f;
  let b: ssa.SBlock = f.blocks[bi];
  if (w.params_at_entry && bi == w.at[f.entry]) {
    let v: i32 = 0;
    while (v < f.nparams) {
      p = define(p, w, v, b.id);
      v = v + 1;
    }
  }
  p = enter_phis(p, w, bi);
  let i: i32 = 0;
  while (i < b.insts.len()) {
    let ins: ssa.SInst = b.insts[i];
    if (ins.kind_tag != 8 && ins.kind_tag != 6) {
      p = apply(p, w, ins, b.id, taken_at(takes, bi, i));
    }
    i = i + 1;
  }
  return p;
}

// root_at is the root value at tracked index k.
function root_at(w: Walk, k: i32): i32 {
  let v: i32 = 0;
  while (v < w.idx.len()) {
    if (w.idx[v] == k) {
      return v;
    }
    v = v + 1;
  }
  return -1;
}

// rpo is the reachable blocks in reverse postorder over successors.
function rpo(f: ssa.SFunc, at: i32[]): i32[] {
  let n: i32 = f.blocks.len();
  let entry: i32 = at[f.entry];
  let seen: boolean[] = __alloc_bool(n);
  let order: i32[] = [];
  let stack: i32[] = [entry];
  let sp: i32 = 1;
  let cursor: i32[] = util.minus_ones(n);
  seen = seen.with(entry, true);
  while (sp > 0) {
    let bi: i32 = stack[sp - 1];
    let k: i32 = cursor[bi] + 1;
    let id: i32 = ssa.successor_id(f.blocks[bi].term, k);
    while (id >= 0 && (at[id] < 0 || seen[at[id]])) {
      k = k + 1;
      id = ssa.successor_id(f.blocks[bi].term, k);
    }
    cursor = cursor.with(bi, k);
    if (id >= 0) {
      seen = seen.with(at[id], true);
      stack = pushed(stack, sp, at[id]);
      sp = sp + 1;
    } else {
      order = order.append(bi);
      sp = sp - 1;
    }
  }
  let out: i32[] = [];
  let i: i32 = order.len() - 1;
  while (i >= 0) {
    out = out.append(order[i]);
    i = i - 1;
  }
  return out;
}

// pushed writes `v` at `sp` of a stack whose live part is `stack[0..sp]`,
// growing it when `sp` is at its end: a pop is `sp - 1`, with nothing to
// copy.
function pushed(own stack: i32[], sp: i32, v: i32): i32[] {
  if (sp < stack.len()) {
    return stack.with(sp, v);
  }
  return stack.append(v);
}

// The round limit is a safety net, not a bound the lattice needs: counts
// climb to the cap and then to maybe, so every row settles.
function round_limit(): i32 {
  return 64;
}

// certify walks `f` against its boundary and the module's tables.
function use_counts(f: ssa.SFunc): i32[] {
  let uses: i32[] = __alloc_i32(f.nvals);
  for b in f.blocks {
    for ins in b.insts {
      for a in ins.args {
        uses = count_use(uses, a);
      }
    }
    uses = count_use(uses, b.term.value);
    if (b.term.kind_tag == 3) {
      uses = count_use(uses, b.term.cond);
    }
  }
  return uses;
}

function count_use(own uses: i32[], v: i32): i32[] {
  if (v < 0 || v >= uses.len()) {
    return uses;
  }
  return uses.with(v, uses[v] + 1);
}

// resumes: the body is an async frame that re-enters through the task
// stack (`__fern_task_mode`). Its boxes and reuse tokens come back as popped
// words, and whether a token is null is decided by a word of the frame the
// certifier cannot read, so a child released under it reads as a borrow
// released. Such a body is not certified; the census says so.
function resumes(f: ssa.SFunc): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (is_call(ins, "__fern_task_mode")) {
        return true;
      }
    }
  }
  return false;
}

// walk_of builds the walk's tables over `f`: roots, origins, the tracked
// slots.
// `hold` is what a walk under a token's value holds (walk_assuming), and
// `base` the walk without one, whose tables stand in for what the region
// walked does not define.
function walk_of(f: ssa.SFunc, irops: ir.Op[], self_abi: Abi, abis: Abis, sigs: rcsigs.Table, ops: rcsigs.OpTable, at: i32[], dom: ssadeps.Dom, reach: boolean[], hold: Hold, base: Base): Walk {
  let defs: Defs = definitions(f);
  let rt: Roots = roots_over(f, defs, sigs, inherited_roots(own_roots(f.nvals), f, defs, base));
  let uses: i32[] = base.uses;
  // A region keeps the whole function's paired-return convention. Pruning
  // removes instructions and edges; it cannot introduce a second return word.
  let paired: boolean = base.paired;
  if (!base.on) {
    uses = use_counts(f);
    paired = returns_pair(f);
  }
  let w: Walk = Walk { f: f, defs: defs, at: at, root: rt.root, origin: [], idx: [], tracked: 0, self_abi: self_abi, abis: abis, sigs: sigs, ops: ops, paired: paired, why: [], opened: [], irops: irops, derived: rt.derived, pair_tag: [], pair_mask: [], pair_words: [], uses: uses, dom: dom, regions: [], openers: [], held: hold.box, reused: hold.reused, phis: phis_of(f), outer: outer_of(base), firsts: firsts_of(f, rt.root), carried: [], children: [], takes: no_takes(), params_at_entry: !base.on, debt: [], kept: [] };
  w = Walk { ...w, carried: carried_of(w) };
  let rg: Regions = inherited_regions(unique_regions(w, dom, reach), f, reach, base);
  let own_children: boolean[] = children_boxes(w, rg.roots);
  let children: boolean[] = inherited_children(own_children, f, defs, base);
  let st: Stores = stores_of(w);
  let o: Origins = inherited_origins(origins(w, st, rg.roots, rg.openers, children, dom), f, defs, base);
  w = Walk { ...w, origin: o.origin, why: o.why, opened: o.opened, pair_tag: o.pair_tag, pair_mask: o.pair_mask, pair_words: o.pair_words, regions: rg.roots, openers: rg.openers, children: children };
  let takes: Takes = inherited_takes(takes_of(w, dom), w, base);
  let taken: boolean[] = null_takes(w, takes);
  w = Walk { ...w, takes: takes, debt: debts(w, taken, hold.from), kept: put_backs(w, st, dom), idx: indexes(w, touches(w, taken)) };
  let tracked: i32 = 0;
  for k in w.idx {
    if (k >= 0) {
      tracked = tracked + 1;
    }
  }
  return Walk { ...w, tracked: tracked };
}

// Base is the walk without an assumption, as a walk under one reads it
// (walk_assuming): the tables of the values the region's blocks use but do
// not define, the regions its tests opened, and its null stores' takes.
// `at` maps a block id to its position in it. `on` is false for the walk
// without an assumption itself.
struct Base { on: boolean, at: i32[], root: i32[], derived: boolean[], origin: i32[], why: i32[], opened: i32[], pair_tag: i32[], pair_mask: i32[], children: boolean[], regions: i32[][], openers: i32[][], uses: i32[], paired: boolean, takes: Takes, defs: Defs, f: ssa.SFunc, phis: i32[] }

function no_base(): Base {
  return Base { on: false, at: [], root: [], derived: [], origin: [], why: [], opened: [], pair_tag: [], pair_mask: [], children: [], regions: [], openers: [], uses: [], paired: false, takes: no_takes(), defs: Defs { block: [], at: [] }, f: ssa.SFunc { name: "", nparams: 0, nvals: 0, blocks: [], entry: 0, takes_env: false }, phis: [] };
}

function base_of(w: Walk): Base {
  return Base { on: true, at: w.at, root: w.root, derived: w.derived, origin: w.origin, why: w.why, opened: w.opened, pair_tag: w.pair_tag, pair_mask: w.pair_mask, children: w.children, regions: w.regions, openers: w.openers, uses: w.uses, paired: w.paired, takes: w.takes, defs: w.defs, f: w.f, phis: w.phis };
}

// Outer is the base walk's tables as a walk under an assumption reads a
// phi its region uses but does not define (carries).
struct Outer { on: boolean, f: ssa.SFunc, defs: Defs, root: i32[], derived: boolean[], phis: i32[] }

function outer_of(base: Base): Outer {
  return Outer { on: base.on, f: base.f, defs: base.defs, root: base.root, derived: base.derived, phis: base.phis };
}

function phis_of(f: ssa.SFunc): i32[] {
  let out: i32[] = [];
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 8 && ins.result >= 0) {
        out = out.append(ins.result);
      }
    }
  }
  return out;
}

// outside: value `v` is one the walked region uses but does not define: a
// base's table answers for it.
function outside(f: ssa.SFunc, defs: Defs, v: i32): boolean {
  return v >= f.nparams && v < defs.block.len() && defs.block[v] < 0;
}

// inherited_roots gives each value the region uses but does not define the
// base's root; the region's own copies of it are resolved through that after.
function inherited_roots(own rt: Roots, f: ssa.SFunc, defs: Defs, base: Base): Roots {
  if (!base.on) {
    return rt;
  }
  let v: i32 = 0;
  while (v < f.nvals && v < base.root.len()) {
    if (outside(f, defs, v)) {
      rt = Roots { root: rt.root.with(v, base.root[v]), derived: rt.derived.with(v, base.derived[v]) };
    }
    v = v + 1;
  }
  return rt;
}

// inherited_regions adds the base's regions to the region walk's: the
// pruning only removes edges, so a block an arm dominated it still
// dominates, and the token's own tests, jumps now, opened some of them.
function inherited_regions(own rg: Regions, f: ssa.SFunc, reach: boolean[], base: Base): Regions {
  if (!base.on) {
    return rg;
  }
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let bb: i32 = base.at[f.blocks[bi].id];
    if (reach[bi] && bb >= 0) {
      let k: i32 = 0;
      while (k < base.regions[bb].len()) {
        let r: i32 = base.regions[bb][k];
        if (util.index_of_i32(rg.roots[bi], r) < 0 && k < base.openers[bb].len()) {
          rg = Regions { roots: rg.roots.with(bi, rg.roots[bi].append(r)), openers: rg.openers.with(bi, rg.openers[bi].append(base.openers[bb][k])) };
        }
        k = k + 1;
      }
    }
    bi = bi + 1;
  }
  return rg;
}

function inherited_children(own out: boolean[], f: ssa.SFunc, defs: Defs, base: Base): boolean[] {
  if (!base.on) {
    return out;
  }
  let v: i32 = 0;
  while (v < out.len() && v < base.children.len()) {
    if (outside(f, defs, v) && base.children[v]) {
      out = out.with(v, true);
    }
    v = v + 1;
  }
  return out;
}

function inherited_origins(own o: Origins, f: ssa.SFunc, defs: Defs, base: Base): Origins {
  if (!base.on) {
    return o;
  }
  let v: i32 = 0;
  while (v < o.origin.len() && v < base.origin.len()) {
    if (outside(f, defs, v)) {
      o = Origins { ...o, origin: o.origin.with(v, base.origin[v]), why: o.why.with(v, base.why[v]), opened: o.opened.with(v, base.opened[v]) };
      if (v < base.pair_tag.len() && base.pair_tag[v] >= 0) {
        o = Origins { ...o, pair_tag: o.pair_tag.with(v, base.pair_tag[v]), pair_mask: o.pair_mask.with(v, base.pair_mask[v]), pair_words: o.pair_words.append(v) };
      }
    }
    v = v + 1;
  }
  return o;
}

// inherited_takes gives a null store in the region the load the base
// walk found for it where that load is outside the region, which the
// region's own search cannot reach.
function inherited_takes(own t: Takes, w: Walk, base: Base): Takes {
  if (!base.on) {
    return t;
  }
  let k: i32 = 0;
  while (k < t.block.len()) {
    let bb: i32 = base.at[w.f.blocks[t.block[k]].id];
    let j: i32 = -1;
    if (bb >= 0) {
      j = base.takes.first[bb];
    }
    while (j >= 0 && j < base.takes.block.len() && base.takes.block[j] == bb) {
      if (base.takes.at[j] == t.at[k]) {
        let rs: i32[] = base.takes.roots[j];
        if (rs.len() > 0 && outside(w.f, w.defs, rs[0])) {
          t = Takes { ...t, roots: t.roots.with(k, rs) };
        }
      }
      j = j + 1;
    }
    k = k + 1;
  }
  return t;
}

// debts marks the loads a null store takes the slot's unit for (`taken`)
// that read the box the walk's token holds, in a block the token's (id
// `from_id`) dominates, where the hold is a fact. Empty in a walk that
// holds nothing.
function debts(w: Walk, taken: boolean[], from_id: i32): boolean[] {
  if (w.held < 0 || from_id < 0 || from_id >= w.at.len() || w.at[from_id] < 0) {
    return [];
  }
  let from: i32 = w.at[from_id];
  let out: boolean[] = __alloc_bool(w.f.nvals);
  let v: i32 = 0;
  while (v < taken.len()) {
    if (taken[v] && w.defs.block[v] >= 0 && ssadeps.dom_holds(w.dom, w.defs.block[v], from)) {
      let d: ssa.SInst = def_of(w.f, w.defs, v);
      if (is_load(d) && d.args.len() > 0 && w.root[d.args[0]] == w.held) {
        out = out.with(v, true);
      }
    }
    v = v + 1;
  }
  return out;
}

function in_debt(w: Walk, r: i32): boolean {
  return r >= 0 && r < w.debt.len() && w.debt[r];
}

// progress_of lays out the out rows and the phi input rows, all absent.
function progress_of(w: Walk, lv: Live): Progress {
  let f: ssa.SFunc = w.f;
  let phi_at: i32[] = util.minus_ones(f.nvals);
  let nphin: i32 = 0;
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 8 && ins.result >= 0 && w.idx[ins.result] >= 0) {
        phi_at = phi_at.with(ins.result, nphin);
        nphin = nphin + b.preds.len();
      }
    }
  }
  return Progress { out: filled(lv.nout, absent()), done: __alloc_bool(f.blocks.len()), phi_at: phi_at, phin: filled(nphin, absent()), state: filled(w.tracked, absent()), findings: [], opaque: [], unproved: __alloc_bool(w.tracked), maybe_at: util.minus_ones(w.tracked), ulog: [], mlog: [] };
}

// Settled is the walk's progress once no row changes, or `changed` still
// true at the round limit.
struct Settled { p: Progress, changed: boolean }

function settle(own p: Progress, w: Walk, lv: Live, order: i32[], reach: boolean[], takes: Takes): Settled {
  let rounds: i32 = 0;
  let changed: boolean = true;
  let once: boolean = acyclic(w, order);
  let memos: Memo[] = no_memos(memo_count(w.f.blocks.len(), once));
  while (changed && rounds < round_limit()) {
    changed = false;
    // Findings and the census accumulate across rounds; only the final
    // round's are kept, since an earlier round reads rows not yet settled.
    p = Progress { ...p, findings: [], opaque: [], unproved: __alloc_bool(w.tracked), maybe_at: util.minus_ones(w.tracked) };
    for bi in order {
      if (reach[bi] && !once && memos[bi].ran && inputs_match(p, w, lv, bi, memos[bi].inputs)) {
        p = replayed(p, memos[bi], bi);
      } else if (reach[bi]) {
        let inputs: i32[] = [];
        if (!once) {
          inputs = block_inputs(p, w, lv, bi);
        }
        let f0: i32 = p.findings.len();
        let o0: i32 = p.opaque.len();
        p = Progress { ...p, ulog: [], mlog: [] };
        let r: RoundResult = block_round(p, w, lv, bi, takes);
        p = r.p;
        if (r.changed) {
          changed = true;
        }
        if (!once) {
          memos = memos.with(bi, Memo { ran: true, inputs: inputs, findings: findings_from(p.findings, f0), opaque: strings_from(p.opaque, o0), unproved: p.ulog, maybe: p.mlog });
        }
      }
    }
    rounds = rounds + 1;
    // Without a back edge every predecessor's row is final when its
    // successor reads it, so the first round in reverse postorder is the
    // fixpoint.
    if (once) {
      changed = false;
    }
  }
  return Settled { p: p, changed: changed };
}

// Memo is a block's last run in a settle: the inputs it read and what it
// added to the round. A block whose inputs are those of its last run would
// redo exactly that run, so settle replays it instead.
struct Memo { ran: boolean, inputs: i32[], findings: Finding[], opaque: string[], unproved: i32[], maybe: i32[] }

// memo_count is how many memos a settle keeps: one per block in a cyclic
// settle, none in an acyclic one, whose single round never reads them.
function memo_count(n: i32, once: boolean): i32 {
  if (once) {
    return 0;
  }
  return n;
}

function no_memos(n: i32): Memo[] {
  let out: Memo[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(Memo { ran: false, inputs: [], findings: [], opaque: [], unproved: [], maybe: [] });
    i = i + 1;
  }
  return out;
}

// block_inputs is what block bi's run reads from other blocks' rows: whether
// each predecessor has run, and if so the row on its edge, then the inputs
// of each tracked phi. The run also reads maybe_at, which replay reproduces
// by re-applying the memo's slots in block order. The rest of a run reads
// only the walk's tables and the block's own scratch row.
function block_inputs(p: Progress, w: Walk, lv: Live, bi: i32): i32[] {
  let b: ssa.SBlock = w.f.blocks[bi];
  let out: i32[] = [];
  for pid in b.preds {
    let pb: i32 = w.at[pid];
    if (pb >= 0 && p.done[pb]) {
      out = out.append(1);
      let base: i32 = edge_base(w, lv, pb, b.id);
      let j: i32 = 0;
      while (j < lv.in_n[bi]) {
        out = out.append(p.out[base + j]);
        j = j + 1;
      }
    } else {
      out = out.append(0);
    }
  }
  for ins in b.insts {
    if (ins.kind_tag == 8 && ins.result >= 0 && w.idx[ins.result] >= 0) {
      let at: i32 = p.phi_at[ins.result];
      let i: i32 = 0;
      while (i < b.preds.len()) {
        out = out.append(p.phin[at + i]);
        i = i + 1;
      }
    }
  }
  return out;
}

// replayed adds to the round what block bi's memoized run added.
function replayed(own p: Progress, m: Memo, bi: i32): Progress {
  for x in m.findings {
    p = Progress { ...p, findings: p.findings.append(x) };
  }
  for o in m.opaque {
    p = Progress { ...p, opaque: p.opaque.append(o) };
  }
  for k in m.unproved {
    p = Progress { ...p, unproved: p.unproved.with(k, true) };
  }
  for k in m.maybe {
    if (p.maybe_at[k] < 0) {
      p = Progress { ...p, maybe_at: p.maybe_at.with(k, bi) };
    }
  }
  return p;
}

function findings_from(xs: Finding[], at: i32): Finding[] {
  let out: Finding[] = [];
  let i: i32 = at;
  while (i < xs.len()) {
    out = out.append(xs[i]);
    i = i + 1;
  }
  return out;
}

function strings_from(xs: string[], at: i32): string[] {
  let out: string[] = [];
  let i: i32 = at;
  while (i < xs.len()) {
    out = out.append(xs[i]);
    i = i + 1;
  }
  return out;
}

// inputs_match is `block_inputs(p, w, lv, bi) == old`, read in place.
function inputs_match(p: Progress, w: Walk, lv: Live, bi: i32, old: i32[]): boolean {
  let b: ssa.SBlock = w.f.blocks[bi];
  let at: i32 = 0;
  for pid in b.preds {
    let pb: i32 = w.at[pid];
    let ran: boolean = pb >= 0 && p.done[pb];
    if (at >= old.len() || old[at] == 1 != ran) {
      return false;
    }
    at = at + 1;
    if (ran) {
      let base: i32 = edge_base(w, lv, pb, b.id);
      let j: i32 = 0;
      while (j < lv.in_n[bi]) {
        if (at >= old.len() || old[at] != p.out[base + j]) {
          return false;
        }
        at = at + 1;
        j = j + 1;
      }
    }
  }
  for ins in b.insts {
    if (ins.kind_tag == 8 && ins.result >= 0 && w.idx[ins.result] >= 0) {
      let ph: i32 = p.phi_at[ins.result];
      let i: i32 = 0;
      while (i < b.preds.len()) {
        if (at >= old.len() || old[at] != p.phin[ph + i]) {
          return false;
        }
        at = at + 1;
        i = i + 1;
      }
    }
  }
  return at == old.len();
}

// acyclic: no edge leads to a block at or before its source in `order`.
function acyclic(w: Walk, order: i32[]): boolean {
  let rank: i32[] = util.minus_ones(w.f.blocks.len());
  let i: i32 = 0;
  while (i < order.len()) {
    rank = rank.with(order[i], i);
    i = i + 1;
  }
  for bi in order {
    let t: ssa.STerm = w.f.blocks[bi].term;
    let e: i32 = 0;
    while (e < 2) {
      let sid: i32 = ssa.successor_id(t, e);
      if (sid >= 0 && w.at[sid] >= 0 && rank[w.at[sid]] <= rank[bi]) {
        return false;
      }
      e = e + 1;
    }
  }
  return true;
}

// token_word is the rename root of the reuse token a branch tests, -1 for
// a branch on anything else.
function token_word(w: Walk, t: ssa.STerm): i32 {
  if (t.kind_tag != 3 || t.t == t.f) {
    return -1;
  }
  let ts: Tested = tested(w, t.cond);
  if (ts.word < 0 || token_root(w, w.regions, ts.word) < 0) {
    return -1;
  }
  return w.root[ts.word];
}

// tested_tokens lists the reuse tokens the function branches on, each
// once. A token defined in a loop is a value per time round; a walk under
// one value takes it every time round, which is a path the lowering has to
// balance like any other.
function tested_tokens(w: Walk, reach: boolean[]): i32[] {
  let out: i32[] = [];
  let bi: i32 = 0;
  while (bi < w.f.blocks.len()) {
    if (reach[bi]) {
      let tok: i32 = token_word(w, w.f.blocks[bi].term);
      if (tok >= 0 && util.index_of_i32(out, tok) < 0) {
        out = out.append(tok);
      }
    }
    bi = bi + 1;
  }
  return out;
}

// Pruned is a function copy under construction: per block, the successor
// whose edge is dropped (-1 for none; a block losing every successor is
// dropped from its own predecessors), the terminators as rewritten, and the
// token phis to rewrite as the token's value.
struct Pruned { dropped: i32[], terms: ssa.STerm[], phis: i32[] }

// prune_token is the function with every branch on token `tok` taking the
// arm its value selects, and every edge that would give the token the other
// value removed: the token's phi takes its null inputs only where the token
// is null and its box inputs only where it holds. A branch losing an arm
// becomes a jump; a jump losing its target loses its block, which loses its
// own incoming edges in turn. Each dropped edge takes the predecessor and
// the phi inputs it brought out of its successor. The token's phi, and the
// token phis it is built from, become the value the token has: a copy of the
// box where it holds, so a spend through the token is a spend of the box's
// unit and the box keeps its unit through the phi, and null otherwise.
struct PrunedFunc { f: ssa.SFunc, phis: i32[], hold: Hold }

// Hold is what a walk under a token's value holds: the box, -1 for none,
// the block the token is defined in, and, per value, whether it is the
// box reused as a construction's block (box_ops): a null store into it
// sets a slot, it takes nothing out of one.
// `from` is the id of the block the token is defined in.
struct Hold { box: i32, from: i32, reused: boolean[] }

function no_hold(): Hold {
  return Hold { box: -1, from: -1, reused: [] };
}

// Where the token holds the box's release is a shell, since the box was
// unique and the release frees its block alone, so a payload the frame read
// before and did not read again is the frame's; and a reuse the box is
// handed to is the box, so a slot the construction keeps stays the box's
// and one it replaces was the frame's to release first.
function prune_token(w: Walk, tok: i32, hold: boolean): PrunedFunc {
  let f: ssa.SFunc = w.f;
  let pr: Pruned = Pruned { dropped: util.minus_ones(f.blocks.len()), terms: [], phis: [] };
  for b in f.blocks {
    pr = Pruned { ...pr, terms: pr.terms.append(b.term) };
  }
  let box: i32 = token_root(w, w.regions, tok);
  pr = drop_phi_edges(w, pr, tok, box, hold, 0);
  // A phi the pruning leaves the box, or null, is tested the way the token
  // is, and dropping its other arm can fix another.
  let reach: boolean[] = reached_over(w, pr.terms);
  let fixed: i32[] = fixed_phis(w, pr, reach, box);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let bi: i32 = 0;
    while (bi < f.blocks.len()) {
      let t: ssa.STerm = pr.terms[bi];
      if (reach[bi] && t.kind_tag == 3 && t.t != t.f) {
        let ts: Tested = tested(w, t.cond);
        let fx: i32 = -1;
        if (ts.word >= 0) {
          fx = fixed[w.root[ts.word]];
        }
        if (fx >= 0) {
          let other: i32 = t.t;
          if (ts.on_true == (fx == 1)) {
            other = t.f;
          }
          pr = drop_edge(w, pr, bi, other);
          changed = true;
        }
      }
      bi = bi + 1;
    }
    if (changed) {
      reach = reached_over(w, pr.terms);
      fixed = fixed_phis(w, pr, reach, box);
    }
  }
  let rew: i32[] = pr.phis;
  let want: i32 = 0;
  if (hold) {
    want = 1;
  }
  let v: i32 = 0;
  while (v < fixed.len()) {
    if (fixed[v] == want && util.index_of_i32(rew, v) < 0) {
      rew = rew.append(v);
    }
    v = v + 1;
  }
  let out: ssa.SBlock[] = [];
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    let term: ssa.STerm = pr.terms[bi];
    if (!reach[bi]) {
      // Unreached, so no edge of its own: its successors do not list it.
      term = ssa.STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: -1 };
    }
    let b: ssa.SBlock = ssa.SBlock { ...f.blocks[bi], term: term };
    out = out.append(token_phis(without_dropped_preds(w, b, pr.dropped, reach), rew, box, hold));
    bi = bi + 1;
  }
  let fa: ssa.SFunc = ssa.SFunc { ...f, blocks: out };
  if (!hold) {
    return PrunedFunc { f: fa, phis: pr.phis, hold: no_hold() };
  }
  let ops: BoxOps = box_ops(w, fa, box);
  return PrunedFunc { f: ops.f, phis: pr.phis, hold: Hold { box: box, from: f.blocks[w.defs.block[tok]].id, reused: ops.reused } };
}

// fixed_phis: what the pruning leaves each reached phi, through phis of
// each other: the box (1), null (0), or undecided (-1). An input round a
// loop to the phi itself decides nothing.
function fixed_phis(w: Walk, pr: Pruned, reach: boolean[], box: i32): i32[] {
  let out: i32[] = util.minus_ones(w.f.nvals);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for p in w.phis {
      let bi: i32 = w.defs.block[p];
      if (out[p] < 0 && reach[bi]) {
        let fx: i32 = fixed_phi(w, pr, reach, out, w.f.blocks[bi], def_of(w.f, w.defs, p), box);
        if (fx >= 0) {
          out = out.with(p, fx);
          changed = true;
        }
      }
    }
  }
  return out;
}

function fixed_phi(w: Walk, pr: Pruned, reach: boolean[], out: i32[], b: ssa.SBlock, ins: ssa.SInst, box: i32): i32 {
  let found: i32 = -1;
  let i: i32 = 0;
  while (i < ins.args.len() && i < b.preds.len()) {
    let a: i32 = ins.args[i];
    let pb: i32 = w.at[b.preds[i]];
    if (a >= 0 && a != ins.result && pb >= 0 && reach[pb] && pr.dropped[pb] != b.id) {
      let fx: i32 = -1;
      if (zero_at(w, a)) {
        fx = 0;
      } else if (w.root[a] == box && !w.derived[a]) {
        fx = 1;
      } else {
        fx = out[w.root[a]];
      }
      if (fx < 0 || found >= 0 && found != fx) {
        return -1;
      }
      found = fx;
    }
    i = i + 1;
  }
  return found;
}

// BoxOps is box_ops' answer: the function, and the values that are the box
// reused.
struct BoxOps { f: ssa.SFunc, reused: boolean[] }

// token_phis rewrites the token phis in block `b` as the token's value: a
// copy of the box where it holds, null otherwise.
function token_phis(b: ssa.SBlock, phis: i32[], box: i32, hold: boolean): ssa.SBlock {
  let insts: ssa.SInst[] = [];
  let any: boolean = false;
  for ins in b.insts {
    if (ins.kind_tag == 8 && ins.result >= 0 && util.index_of_i32(phis, ins.result) >= 0) {
      any = true;
      if (hold) {
        insts = insts.append(ssa.SInst { kind_tag: 7, result: ins.result, args: [box], imm: 0, str: "" });
      } else {
        insts = insts.append(ssa.SInst { kind_tag: 1, result: ins.result, args: [], imm: 0, str: "" });
      }
    } else {
      insts = insts.append(ins);
    }
  }
  if (!any) {
    return b;
  }
  return ssa.SBlock { ...b, insts: insts };
}

// box_ops rewrites the held box's reuse as the box itself, reading the box
// through the pruned function's own aliases (a phi of the box and null past
// the test is a copy of the box there), and its shallow
// release as a shell where the box was proved unique: elsewhere a call may
// have kept a unit of it, and the release is the decrement the lowering
// emitted for that. A payload read before the box's children-only drop is
// not the shell's (shell_taken): the drop released it.
function box_ops(w: Walk, f: ssa.SFunc, box: i32): BoxOps {
  // Pruning changes instructions in place and preserves every result position.
  let root: i32[] = roots(f, w.defs, w.sigs).root;
  let ops: BoxOps = BoxOps { f: f, reused: __alloc_bool(f.nvals) };
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    if (calls_on_box(f.blocks[bi], root, box)) {
      ops = box_ops_in(ops, bi, root, box, util.index_of_i32(w.regions[bi], box) >= 0);
    }
    bi = bi + 1;
  }
  return ops;
}

function box_ops_in(own ops: BoxOps, bi: i32, root: i32[], box: i32, unique: boolean): BoxOps {
  let b: ssa.SBlock = ops.f.blocks[bi];
  let insts: ssa.SInst[] = [];
  let any: boolean = false;
  for ins in b.insts {
    let on_box: boolean = ins.kind_tag == 11 && ins.args.len() > 0 && ins.args[0] >= 0 && root[ins.args[0]] == box;
    if (on_box && unique && ins.str == "__fern_rc_dec") {
      any = true;
      insts = insts.append(ssa.SInst { ...ins, imm: 2 });
    } else if (on_box && ins.str == "__fern_alloc_reuse" && ins.result >= 0) {
      // The box is handed on as the construction's block: its unit goes
      // with it, and its slots stay its own until a store replaces them.
      any = true;
      insts = insts.append(ssa.SInst { kind_tag: 7, result: ins.result, args: [box], imm: 0, str: "" });
      ops = BoxOps { ...ops, reused: ops.reused.with(ins.result, true) };
    } else {
      insts = insts.append(ins);
    }
  }
  if (!any) {
    return ops;
  }
  return BoxOps { ...ops, f: ssa.SFunc { ...ops.f, blocks: ops.f.blocks.with(bi, ssa.SBlock { ...b, insts: insts }) } };
}

function calls_on_box(b: ssa.SBlock, root: i32[], box: i32): boolean {
  for ins in b.insts {
    if (ins.kind_tag == 11 && ins.args.len() > 0 && ins.args[0] >= 0 && root[ins.args[0]] == box) {
      return true;
    }
  }
  return false;
}

// drop_phi_edges drops the edges into the token's phi that would give it
// the other value, through the token phis of the same box it is built from.
// A box input that comes from the box's unique region is dropped at the
// branch that opened the region, the test the token reads, so the whole arm
// goes rather than its last edge, which would leave the arm a dead end.
function drop_phi_edges(w: Walk, own pr: Pruned, phi: i32, box: i32, hold: boolean, depth: i32): Pruned {
  let ins: ssa.SInst = def_of(w.f, w.defs, phi);
  let bi: i32 = w.defs.block[phi];
  if (ins.kind_tag != 8 || bi < 0 || depth >= 8 || util.index_of_i32(pr.phis, phi) >= 0) {
    return pr;
  }
  pr = Pruned { ...pr, phis: pr.phis.append(phi) };
  let b: ssa.SBlock = w.f.blocks[bi];
  let i: i32 = 0;
  while (i < ins.args.len() && i < b.preds.len()) {
    let a: i32 = ins.args[i];
    let pb: i32 = w.at[b.preds[i]];
    if (a >= 0 && pb >= 0) {
      let zero: boolean = zero_at(w, a);
      if (zero == hold) {
        pr = drop_arm(w, pr, pb, b.id, box, zero);
      } else if (!zero && w.root[a] != w.root[phi] && w.root[a] != box && token_root(w, w.regions, a) == box) {
        pr = drop_phi_edges(w, pr, w.root[a], box, hold, depth + 1);
      }
    }
    i = i + 1;
  }
  return pr;
}

// drop_arm drops the edge from `pb` to `sid`, or, for a box input out of
// the box's unique region, the opener's edge into that region's arm.
function drop_arm(w: Walk, own pr: Pruned, pb: i32, sid: i32, box: i32, zero: boolean): Pruned {
  if (!zero) {
    let at: i32 = util.index_of_i32(w.regions[pb], box);
    if (at >= 0 && at < w.openers[pb].len() && w.at[w.openers[pb][at]] >= 0) {
      let ob: i32 = w.at[w.openers[pb][at]];
      let t: ssa.STerm = w.f.blocks[ob].term;
      let c: Cond = cond_of(w, w.regions, t.cond, true);
      if (t.kind_tag == 3 && c.root == box) {
        let arm: i32 = t.f;
        if (c.on_true) {
          arm = t.t;
        }
        return drop_edge(w, pr, ob, arm);
      }
    }
  }
  return drop_edge(w, pr, pb, sid);
}

// drop_edge removes the edge from block `pb` to the block `sid`: a branch
// keeps its other arm as a jump, and a jump's block, left with no way on,
// loses its own incoming edges.
function drop_edge(w: Walk, own pr: Pruned, pb: i32, sid: i32): Pruned {
  if (pr.dropped[pb] == sid) {
    return pr;
  }
  let t: ssa.STerm = pr.terms[pb];
  if (t.kind_tag == 3 && t.t != t.f && (t.t == sid || t.f == sid)) {
    let other: i32 = t.f;
    if (t.f == sid) {
      other = t.t;
    }
    pr = Pruned { ...pr, dropped: pr.dropped.with(pb, sid), terms: pr.terms.with(pb, ssa.STerm { kind_tag: 2, cond: 0, target: other, t: 0, f: 0, value: -1 }) };
    return pr;
  }
  if (ssa.successor_id(t, 0) != sid) {
    return pr;
  }
  // The block has no way on: it ends, and loses its own incoming edges.
  let end: ssa.STerm = ssa.STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: -1 };
  pr = Pruned { ...pr, dropped: pr.dropped.with(pb, sid), terms: pr.terms.with(pb, end) };
  for pid in w.f.blocks[pb].preds {
    let pp: i32 = w.at[pid];
    if (pp >= 0) {
      pr = drop_edge(w, pr, pp, w.f.blocks[pb].id);
    }
  }
  return pr;
}

// reached_over is the blocks reached from the entry over the terminators
// `terms`.
function reached_over(w: Walk, terms: ssa.STerm[]): boolean[] {
  let out: boolean[] = __alloc_bool(terms.len());
  let entry: i32 = w.at[w.f.entry];
  out = out.with(entry, true);
  let stack: i32[] = [entry];
  let sp: i32 = 1;
  while (sp > 0) {
    sp = sp - 1;
    let bi: i32 = stack[sp];
    let e: i32 = 0;
    while (e < 2) {
      let sid: i32 = ssa.successor_id(terms[bi], e);
      if (sid >= 0 && w.at[sid] >= 0 && !out[w.at[sid]]) {
        out = out.with(w.at[sid], true);
        stack = pushed(stack, sp, w.at[sid]);
        sp = sp + 1;
      }
      e = e + 1;
    }
  }
  return out;
}

// without_dropped_preds removes from block `b` each predecessor whose edge
// to it was dropped or that is no longer reached, with every phi's input on
// that edge. A phi left with one input is that input: a copy, which aliases
// it, so a box that reaches the join by one edge is the same box past it.
function without_dropped_preds(w: Walk, b: ssa.SBlock, dropped: i32[], reach: boolean[]): ssa.SBlock {
  let keep: boolean[] = [];
  let any: boolean = false;
  for pid in b.preds {
    let pb: i32 = w.at[pid];
    let k: boolean = pb < 0 || dropped[pb] != b.id && reach[pb];
    keep = keep.append(k);
    if (!k) {
      any = true;
    }
  }
  if (!any) {
    return b;
  }
  let preds: i32[] = [];
  let i: i32 = 0;
  while (i < b.preds.len()) {
    if (keep[i]) {
      preds = preds.append(b.preds[i]);
    }
    i = i + 1;
  }
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag == 8) {
      let args: i32[] = [];
      let j: i32 = 0;
      while (j < ins.args.len()) {
        if (j >= keep.len() || keep[j]) {
          args = args.append(ins.args[j]);
        }
        j = j + 1;
      }
      if (args.len() == 1 && ins.args.len() > 1 && args[0] >= 0) {
        insts = insts.append(ssa.SInst { kind_tag: 7, result: ins.result, args: args, imm: 0, str: "" });
      } else {
        insts = insts.append(ssa.SInst { ...ins, args: args });
      }
    } else {
      insts = insts.append(ins);
    }
  }
  return ssa.SBlock { ...b, preds: preds, insts: insts };
}

// Assumed is one walk under a token's value: its tables, and its progress
// once settled. `ok` is false where the walk could not be run or did not
// settle, and nothing is read from it then.
struct Assumed { ok: boolean, w: Walk, p: Progress }

// walk_assuming walks the token's region of the pruned function, the
// blocks its definition reaches, which is where its value decides a path,
// as a function of its own (extracted): the region's blocks and a stub for
// each block outside it that enters it. An edge in from a stub carries the
// row the walk without an assumption settled for it (seeded), so the region
// starts from the counts the function holds there, and the tables of the
// values it uses but does not define are the base's (walk_of). A token
// whose block the value leaves unreached decides no path, and the walk is
// empty.
function walk_assuming(w: Walk, lv: Live, p0: Progress, tok: i32, hold: boolean): Assumed {
  let pf: PrunedFunc = prune_token(w, tok, hold);
  let from: i32 = w.defs.block[tok];
  if (!ssadeps.reachable_blocks(pf.f)[from]) {
    return Assumed { ok: true, w: w, p: progress_of(w, lv) };
  }
  let sub: ssa.SFunc = extracted(pf.f, w.at, from);
  let at: i32[] = ssa.block_positions(sub);
  let reach: boolean[] = ssadeps.reachable_blocks(sub);
  let dom: ssadeps.Dom = ssadeps.dominates(sub);
  let wa: Walk = walk_of(sub, w.irops, w.self_abi, w.abis, w.sigs, w.ops, at, dom, reach, pf.hold, base_of(w));
  let lva: Live = live_of(wa, wa.takes);
  if (!lva.ok) {
    return Assumed { ok: false, w: wa, p: progress_of(wa, lva) };
  }
  let pa: Progress = seeded(progress_of(wa, lva), wa, lva, reach, w, lv, p0);
  let done: Settled = settle(pa, wa, lva, rpo(sub, at), reach, wa.takes);
  return Assumed { ok: !done.changed, w: wa, p: done.p };
}

// extracted is the function of the blocks `from` reaches in `f`, `from`
// first as the entry, and a stub for each other block that enters one of
// them: the stub keeps the block's id and terminator and has no
// instructions and no predecessors, so the edge exists and nothing runs
// in it. Block ids and value numbers are `f`'s.
function extracted(f: ssa.SFunc, at: i32[], from: i32): ssa.SFunc {
  let region: boolean[] = reached_in(f, at, from, -1).with(from, true);
  let blocks: ssa.SBlock[] = [];
  let stubbed: boolean[] = __alloc_bool(f.blocks.len());
  let bi: i32 = 0;
  while (bi < f.blocks.len()) {
    if (region[bi]) {
      blocks = blocks.append(f.blocks[bi]);
    }
    bi = bi + 1;
  }
  bi = 0;
  while (bi < f.blocks.len()) {
    if (region[bi]) {
      for pid in f.blocks[bi].preds {
        let pb: i32 = at[pid];
        if (pb >= 0 && !region[pb] && !stubbed[pb]) {
          stubbed = stubbed.with(pb, true);
          blocks = blocks.append(ssa.SBlock { id: pid, insts: [], term: into_region(f.blocks[pb].term, at, region), preds: [] });
        }
      }
    }
    bi = bi + 1;
  }
  return ssa.SFunc { ...f, blocks: blocks, entry: f.blocks[from].id };
}

// into_region is a stub's terminator with the arm that leaves the region
// dropped, so the function names no block it does not hold.
function into_region(t: ssa.STerm, at: i32[], region: boolean[]): ssa.STerm {
  if (t.kind_tag != 3 || t.t == t.f) {
    return t;
  }
  if (!region[at[t.f]]) {
    return ssa.STerm { kind_tag: 2, cond: 0, target: t.t, t: 0, f: 0, value: -1 };
  }
  if (!region[at[t.t]]) {
    return ssa.STerm { kind_tag: 2, cond: 0, target: t.f, t: 0, f: 0, value: -1 };
  }
  return t;
}

// seeded fills, for each edge into a walked block from a stub, the row and
// the phi inputs the walk without an assumption settled there, and marks
// the stub done. A phi the pruning made a copy of the box adds the unit the
// base handed it on the edge to the box's count: under the token's value
// they are one object.
function seeded(own pa: Progress, wa: Walk, lva: Live, region: boolean[], w: Walk, lv: Live, p0: Progress): Progress {
  let roots: i32[] = slot_roots(wa);
  let bi: i32 = 0;
  while (bi < wa.f.blocks.len()) {
    if (region[bi]) {
      let b: ssa.SBlock = wa.f.blocks[bi];
      let pi: i32 = 0;
      while (pi < b.preds.len()) {
        let pb: i32 = wa.at[b.preds[pi]];
        if (pb >= 0 && !region[pb]) {
          pa = Progress { ...pa, done: pa.done.with(pb, true) };
          pa = seed_edge(pa, wa, lva, roots, bi, pi, w, lv, p0);
        }
        pi = pi + 1;
      }
    }
    bi = bi + 1;
  }
  return pa;
}

function seed_edge(own pa: Progress, wa: Walk, lva: Live, roots: i32[], bi: i32, pi: i32, w: Walk, lv: Live, p0: Progress): Progress {
  let b: ssa.SBlock = wa.f.blocks[bi];
  let pid: i32 = b.preds[pi];
  let pb: i32 = wa.at[pid];
  let bb: i32 = w.at[b.id];
  let pb0: i32 = util.index_of_i32(w.f.blocks[bb].preds, pid);
  let base0: i32 = edge_base(w, lv, w.at[pid], b.id);
  // The phi inputs first: a phi the base tracked hands its input on; one it
  // did not is maybe. The copies' inputs are added to the box below.
  for ins in b.insts {
    if (ins.kind_tag == 8 && ins.result >= 0 && wa.idx[ins.result] >= 0) {
      let v: i32 = maybe();
      if (w.idx[ins.result] >= 0 && pb0 >= 0) {
        v = p0.phin[p0.phi_at[ins.result] + pb0];
      }
      pa = Progress { ...pa, phin: pa.phin.with(pa.phi_at[ins.result] + pi, v) };
    }
  }
  let base: i32 = edge_base(wa, lva, pb, b.id);
  if (base < 0) {
    return pa;
  }
  let j: i32 = 0;
  while (j < lva.in_n[bi]) {
    let k: i32 = lva.slots[lva.in_at[bi] + j];
    let r: i32 = roots[k];
    let v: i32 = base_count(w, lv, p0, base0, bb, r);
    for ins in b.insts {
      if (ins.kind_tag == 7 && ins.result >= 0 && ins.args.len() == 1 && wa.root[ins.result] == r && w.idx[ins.result] >= 0 && pb0 >= 0 && is_phi(w, ins.result)) {
        v = add_counts(v, p0.phin[p0.phi_at[ins.result] + pb0]);
      }
    }
    pa = Progress { ...pa, out: pa.out.with(base + j, v) };
    j = j + 1;
  }
  return pa;
}

function is_phi(w: Walk, v: i32): boolean {
  return def_of(w.f, w.defs, v).kind_tag == 8;
}

// base_count is root `r`'s count on the base walk's row for the edge at
// `base0` into block `bi`: the row's entry when the base tracks `r` there, 0
// for a borrow it did not track, absent otherwise.
function base_count(w: Walk, lv: Live, p0: Progress, base0: i32, bi: i32, r: i32): i32 {
  let kb: i32 = -1;
  if (r >= 0 && r < w.idx.len()) {
    kb = w.idx[r];
  }
  if (kb < 0) {
    if (r >= 0 && r < w.origin.len() && (w.origin[r] == org_borrowed() || w.origin[r] == org_none())) {
      return 0;
    }
    return absent();
  }
  if (base0 < 0) {
    return absent();
  }
  let j: i32 = 0;
  while (j < lv.in_n[bi]) {
    if (lv.slots[lv.in_at[bi] + j] == kb) {
      return p0.out[base0 + j];
    }
    j = j + 1;
  }
  return absent();
}

// add_counts sums two counts: absent adds nothing, maybe is maybe.
function add_counts(a: i32, b: i32): i32 {
  if (a == absent()) {
    return b;
  }
  if (b == absent()) {
    return a;
  }
  if (a == maybe() || b == maybe() || a == owed() || b == owed()) {
    return maybe();
  }
  if (a + b > cap()) {
    return maybe();
  }
  return a + b;
}

// with_findings adds the findings of a walk under an assumption that the
// walks before it did not already report.
function with_findings(own out: Finding[], more: Finding[]): Finding[] {
  for x in more {
    let seen: boolean = false;
    let j: i32 = 0;
    while (j < out.len()) {
      let y: Finding = out[j];
      if (y.kind == x.kind && y.value == x.value && y.block == x.block) {
        seen = true;
      }
      j = j + 1;
    }
    if (!seen) {
      out = out.append(x);
    }
  }
  return out;
}

// slot_roots is each tracked slot's root value.
function slot_roots(w: Walk): i32[] {
  let out: i32[] = util.minus_ones(w.tracked);
  let v: i32 = 0;
  while (v < w.idx.len()) {
    if (w.idx[v] >= 0) {
      out = out.with(w.idx[v], v);
    }
    v = v + 1;
  }
  return out;
}

// unproved_under reads whether the walk under an assumption left root `v`
// unproved: a root it did not track is on no path it walked.
function unproved_under(a: Assumed, v: i32): boolean {
  let k: i32 = a.w.idx[v];
  return k >= 0 && a.p.unproved[k];
}

// still_unproved keeps a slot the token decides unproved only where one of
// the two walks under its values left it so: a count both settled is
// settled, and a join one walk pruned away is on no path under that value.
function still_unproved(own flags: boolean[], decides: boolean[], roots: i32[], a: Assumed, b: Assumed): boolean[] {
  let k: i32 = 0;
  while (k < flags.len()) {
    if (flags[k] && decides[k] && !unproved_under(a, roots[k]) && !unproved_under(b, roots[k])) {
      flags = flags.with(k, false);
    }
    k = k + 1;
  }
  return flags;
}

// decided_by marks the slots still unproved that met their count to maybe
// at a join the token's value can decide, one at or after the token's
// definition. A walk under the token's values settles nothing else.
function decided_by(w: Walk, tok: i32, unproved: boolean[], maybe_at: i32[]): boolean[] {
  let out: boolean[] = __alloc_bool(unproved.len());
  let from: i32 = w.defs.block[tok];
  if (from < 0) {
    return out;
  }
  let infl: boolean[] = reached_from(w, from);
  let k: i32 = 0;
  while (k < unproved.len()) {
    if (unproved[k] && maybe_at[k] >= 0 && (maybe_at[k] == from || infl[maybe_at[k]])) {
      out = out.with(k, true);
    }
    k = k + 1;
  }
  return out;
}

function count_true(flags: boolean[]): i32 {
  let n: i32 = 0;
  for u in flags {
    if (u) {
      n = n + 1;
    }
  }
  return n;
}

pub function certify(f: ssa.SFunc, irops: ir.Op[], self_abi: Abi, abis: Abis, sigs: rcsigs.Table, ops: rcsigs.OpTable): Report {
  if (f.blocks.len() == 0) {
    return skipped("no blocks");
  }
  let at: i32[] = ssadeps.position_of(f);
  if (f.entry < 0 || f.entry >= at.len() || at[f.entry] < 0) {
    return skipped("no entry block");
  }
  if (resumes(f)) {
    return skipped("resumes from a task frame");
  }
  let reach: boolean[] = ssadeps.reachable_blocks(f);
  let dom: ssadeps.Dom = ssadeps.dominates(f);
  let w: Walk = walk_of(f, irops, self_abi, abis, sigs, ops, at, dom, reach, no_hold(), no_base());
  let lv: Live = live_of(w, w.takes);
  if (!lv.ok) {
    return skipped("liveness: " + lv.why);
  }
  let done: Settled = settle(progress_of(w, lv), w, lv, rpo(f, at), reach, w.takes);
  if (done.changed) {
    return skipped("did not settle in " + util.i32_to_string(round_limit()) + " rounds");
  }
  let findings: Finding[] = done.p.findings;
  let unproved: boolean[] = done.p.unproved;
  if (count_true(unproved) > 0) {
    let roots: i32[] = slot_roots(w);
    for tok in tested_tokens(w, reach) {
      let decides: boolean[] = decided_by(w, tok, unproved, done.p.maybe_at);
      if (count_true(decides) == 0) {
        continue;
      }
      let held: Assumed = walk_assuming(w, lv, done.p, tok, true);
      let null_tok: Assumed = walk_assuming(w, lv, done.p, tok, false);
      if (held.ok && null_tok.ok) {
        findings = with_findings(findings, held.p.findings);
        findings = with_findings(findings, null_tok.p.findings);
        unproved = still_unproved(unproved, decides, roots, held, null_tok);
      }
    }
  }
  return Report { findings: findings, tracked: w.tracked, unproved: count_true(unproved), opaque: done.p.opaque, skipped: "" };
}
