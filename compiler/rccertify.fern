import "./ir";
import "./ssa";
import "./ssadeps";
import "./ssalive";
import "./rcsigs";
import "./rcccompact";
import "./util";
import "std/string";

pub function value_mode(): i32 {
  return 1;
}

pub function borrow_mode(): i32 {
  return 2;
}

pub function counted_mode(): i32 {
  return 3;
}

pub function children_mode(): i32 {
  return 4;
}

// split_second and split_third: the masks of the two pair words of a callee
// that returns a two-word payload in three words.
pub struct Abi { known: boolean, modes: i32[], result_unit: boolean, pair_first: boolean, pair_second: i32, split_second: i32, split_third: i32, result_word: boolean }

pub function unknown_abi(): Abi {
  return Abi { known: false, modes: [], result_unit: false, pair_first: false, pair_second: -2, split_second: -2, split_third: -2, result_word: false };
}

pub function abi(modes: i32[], result_unit: boolean): Abi {
  return Abi { known: true, modes: modes, result_unit: result_unit, pair_first: false, pair_second: -2, split_second: -2, split_third: -2, result_word: false };
}

function second_holds(pair_second: i32): boolean {
  return pair_second == -1 || pair_second > 0;
}

pub struct Abis { names: util.NameIndex, modes: i32[][], results: boolean[], firsts: boolean[], seconds: i32[], splits: i32[][], words: boolean[] }

pub function no_abis(): Abis {
  let none: string[] = [];
  return Abis { names: util.name_index(none), modes: [], results: [], firsts: [], seconds: [], splits: [], words: [] };
}

pub function abis_of(names: string[], modes: i32[][], results: boolean[], firsts: boolean[], seconds: i32[], splits: i32[][], words: boolean[]): Abis {
  return Abis { names: util.name_index(names), modes: modes, results: results, firsts: firsts, seconds: seconds, splits: splits, words: words };
}

function env_abi(name: string): Abi {
  if (name.starts_with("__sem_key")) {
    return abi([borrow_mode(), borrow_mode(), borrow_mode()], false);
  }
  if (name == "__sem_scalar_release$env" || name == "__sem_cell_release$env") {
    return abi([borrow_mode(), borrow_mode()], false);
  }
  return abi([borrow_mode(), counted_mode()], false);
}

function view_abi(name: string): Abi {
  if (name == "__sem_view_len" || name == "__sem_view_data") {
    return abi([borrow_mode()], false);
  }
  if (name == "__sem_byte_view_slice" || name == "__sem_view_slice" || name == "__sem_view_slice_16" || name == "__sem_view_slice_32" || name == "__sem_view_slice_wide") {
    return abi([borrow_mode(), value_mode(), value_mode()], true);
  }
  if (name == "__sem_view_release") {
    return abi([counted_mode()], false);
  }
  return unknown_abi();
}

pub function (a: Abis) lookup(name: string): Abi {
  let at = a.names.find(name);
  if (at >= 0) {
    return Abi { known: true, modes: a.modes[at], result_unit: a.results[at], pair_first: a.firsts[at], pair_second: a.seconds[at], split_second: a.splits[at][0], split_third: a.splits[at][1], result_word: a.words[at] };
  }
  if (rcsigs.is_children_drop(name)) {
    return abi([children_mode()], false);
  }
  if (env_closure(name)) {
    return env_abi(name);
  }
  if (rcsigs.is_generated_release(name)) {
    return abi([counted_mode()], false);
  }
  return view_abi(name);
}

function env_closure(name: string): boolean {
  let n = name.len();
  return n > 4 && util.str_range_eq(name, n - 4, n, "$env") && name.starts_with("__sem_");
}

pub struct Finding { kind: string, value: i32, block: i32, defined: string, message: string }

pub function render(fn_name: string, x: Finding): string {
  return fn_name + ": " + x.kind + " of v" + util.i32_to_string(x.value) + " (" + x.defined + ") in b"
    + util.i32_to_string(x.block) + ": " + x.message;
}

// `failed` names a function the certifier could not decide, which the gate
// refuses.
// `rounds`: the most rounds one walk of the function took to settle.
// `unproved_at`: one value of each slot that `unproved` counts.
pub struct Report { findings: Finding[], tracked: i32, unproved: i32, unproved_at: i32[], opaque: string[], failed: string, rounds: i32 }

function failed(why: string): Report {
  return Report { findings: [], tracked: 0, unproved: 0, unproved_at: [], opaque: [], failed: why, rounds: 0 };
}

function org_none(): i32 {
  return 0;
}

function org_fresh(): i32 {
  return 1;
}

function org_transferred(): i32 {
  return 2;
}

function org_borrowed(): i32 {
  return 3;
}

function org_merged(): i32 {
  return 4;
}

function org_unknown(): i32 {
  return 5;
}

function org_child(): i32 {
  return 6;
}

function initial_count(origin: i32): i32 {
  if (origin == org_fresh() || origin == org_transferred() || origin == org_child()) {
    return 1;
  }
  if (origin == org_unknown() || origin == org_merged()) {
    return maybe();
  }
  return 0;
}

function origin_name(origin: i32): string {
  if (origin == org_fresh()) {
    return "fresh";
  }
  if (origin == org_transferred()) {
    return "parameter";
  }
  if (origin == org_borrowed()) {
    return "borrow";
  }
  if (origin == org_merged()) {
    return "phi";
  }
  if (origin == org_child()) {
    return "child";
  }
  if (origin == org_unknown()) {
    return "unknown";
  }
  return "none";
}

function absent(): i32 {
  return -2;
}

function maybe(): i32 {
  return -1;
}

function owed(): i32 {
  return -3;
}

function cap(): i32 {
  return 8;
}

// A literal holds no unit, and every retain and release skips it.
function free(): i32 {
  return -4;
}

// `c` units on some paths, and a literal on the others.
function free_or(c: i32): i32 {
  return 64 + c;
}

function is_free(s: i32): boolean {
  return s == free() || s >= free_or(0);
}

// The units a state holds on the paths that are not a literal, or -1.
function units(s: i32): i32 {
  if (s >= free_or(0)) {
    return s - free_or(0);
  }
  if (s >= 0) {
    return s;
  }
  return -1;
}

// The state with `c` units, or `c` units on some paths when `freed`.
function holding(c: i32, freed: boolean): i32 {
  if (c < 0) {
    return free();
  }
  if (c > cap()) {
    return maybe();
  }
  if (freed) {
    return free_or(c);
  }
  return c;
}

// A side of a twin that no path takes.
function no_side(): i32 {
  return 9;
}

// A value that may be the box of the parameter with root `o`: it holds
// `same` units of its own if it is that box, and `apart` units if it is not.
function twin(o: i32, same: i32, apart: i32): i32 {
  if (same == apart) {
    if (same == no_side()) {
      return absent();
    }
    return same;
  }
  if (same > no_side() || apart > no_side() || same < 0 || apart < 0) {
    return maybe();
  }
  return -1000 - (o * 100 + same * 10 + apart);
}

function is_twin(s: i32): boolean {
  return s <= -1000;
}

function twin_key(s: i32): i32 {
  return (-1000 - s) / 100;
}

function twin_same(s: i32): i32 {
  return (-1000 - s) / 10 % 10;
}

function twin_apart(s: i32): i32 {
  return (-1000 - s) % 10;
}

// The state of a twin read as a plain count.
function flat(s: i32): i32 {
  if (!is_twin(s)) {
    return s;
  }
  if (twin_same(s) == no_side()) {
    return twin_apart(s);
  }
  if (twin_apart(s) == no_side()) {
    return twin_same(s);
  }
  return maybe();
}

// A plain count `c` is the twin of every box with `c` on both sides.
function side_of(s: i32, o: i32, same: boolean): i32 {
  if (is_twin(s)) {
    if (twin_key(s) != o) {
      return -1;
    }
    if (same) {
      return twin_same(s);
    }
    return twin_apart(s);
  }
  if (s >= 0 && s <= cap()) {
    return s;
  }
  return -1;
}

function side_meet(a: i32, b: i32): i32 {
  if (a == no_side()) {
    return b;
  }
  if (b == no_side() || a == b) {
    return a;
  }
  return -1;
}

function meet_twin(a: i32, b: i32): i32 {
  let o = twin_key(b);
  if (is_twin(a)) {
    o = twin_key(a);
  }
  let same = side_meet(side_of(a, o, true), side_of(b, o, true));
  let apart = side_meet(side_of(a, o, false), side_of(b, o, false));
  if (same >= 0 && apart >= 0) {
    return twin(o, same, apart);
  }
  // A twin with one side is a plain count: it meets a twin of another key
  // as that count.
  if (is_twin(a) && is_twin(b) && twin_key(a) != twin_key(b)) {
    if (flat(a) >= 0) {
      return meet(flat(a), b);
    }
    if (flat(b) >= 0) {
      return meet(a, flat(b));
    }
  }
  return meet(flat(a), flat(b));
}

function meet(a: i32, b: i32): i32 {
  if (a == b || b == absent()) {
    return a;
  }
  if (a == absent()) {
    return b;
  }
  if (is_twin(a) || is_twin(b)) {
    return meet_twin(a, b);
  }
  if ((is_free(a) || is_free(b)) && (a >= 0 || a == free()) && (b >= 0 || b == free())) {
    let ca = units(a);
    let cb = units(b);
    if (ca >= 0 && cb >= 0 && ca != cb) {
      return maybe();
    }
    if (ca < 0) {
      ca = cb;
    }
    return holding(ca, true);
  }
  return maybe();
}

function def_of(f: ssa.SFunc, d: ssa.DefSites, v: i32): ssa.SInst {
  if (v < 0 || v >= d.block.len() || d.block[v] < 0) {
    return ssa.no_inst();
  }
  return f.blocks[d.block[v]].insts[d.at[v]];
}

// The definition of `v` in the function of the walk, from the table of the
// walk.
function def_in(w: Walk, v: i32): ssa.SInst {
  if (v < 0 || v >= w.insts.len()) {
    return ssa.no_inst();
  }
  return w.insts[v];
}

function is_zero(f: ssa.SFunc, d: ssa.DefSites, v: i32): boolean {
  return zero_word(def_of(f, d, v));
}

// A constant zero of 32 or of 64 bits.
function zero_word(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssa.CONST_INT && ins.imm == 0 || ins.kind_tag == ssa.CONST_I64 && ins.str == "0";
}

function def_at(w: Walk, v: i32): ssa.SInst {
  if (w.outer.on && outside(w.f, w.defs, v)) {
    return def_of(w.outer.f, w.outer.defs, v);
  }
  return def_in(w, v);
}

function zero_at(w: Walk, v: i32): boolean {
  return zero_word(def_at(w, v));
}

function marked_result(w: Walk, ins: ssa.SInst): boolean {
  if (ins.kind_tag == ssa.STR_CALL || ins.kind_tag == ssa.RT_CALL) {
    return (ins.imm & 2) != 0;
  }
  if (ins.kind_tag == ssa.FLAT_OP) {
    return ins.imm >= 0 && ins.imm < w.irops.len() && ir.is_counted(w.irops[ins.imm]);
  }
  return false;
}

function is_call(ins: ssa.SInst, name: string): boolean {
  return ins.kind_tag == ssa.CALL && ins.str == name;
}

function is_load(ins: ssa.SInst): boolean {
  return (ins.kind_tag == ssa.LD_AT || ins.kind_tag == ssa.ARR_AT) && ins.str == "rc";
}

function is_store(k: i32): boolean {
  return k == 41 || k == 43 || k == 53 || k == 55;
}

function is_named_op(k: i32): boolean {
  return k == 49 || k == 50 || k == 59;
}

struct Walk {
  f: ssa.SFunc,
  defs: ssa.DefSites,
  at: i32[],
  root: i32[],
  origin: i32[],
  idx: i32[],
  tracked: i32,
  self_abi: Abi,
  abis: Abis,
  sigs: rcsigs.Table,
  ops: rcsigs.OpTable,
  paired: boolean,
  why: i32[],
  opened: i32[],
  irops: ir.Op[],
  derived: boolean[],
  pair_tag: i32[],
  pair_mask: i32[],
  pair_words: i32[],
  uses: i32[],
  dom: ssadeps.Dom,
  regions: i32[][],
  openers: i32[][],
  held: i32,
  reused: boolean[],
  phis: i32[],
  outer: Outer,
  splits: Splits,
  insts: ssa.SInst[],
  firsts: i32[][],
  carried: i32[][],
  children: boolean[],
  takes: Takes,
  params_at_entry: boolean,
  debt: boolean[],
  kept: boolean[],
  // The state a load starts with where a tested token decides its origin.
  token_loads: i32[],
}

function returns_pair(f: ssa.SFunc, irops: ir.Op[]): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssa.FLAT_OP && ins.str == "ret_word" && !scalar_lane(irops, ins)) {
        return true;
      }
    }
  }
  return false;
}

function scalar_lane(irops: ir.Op[], ins: ssa.SInst): boolean {
  return ins.imm >= 0 && ins.imm < irops.len() && irops[ins.imm].width == 64;
}

function paired_call(w: Walk, b: ssa.SBlock, pos: i32): boolean {
  for at in pos + 1..b.insts.len() {
    let next = b.insts[at];
    if (next.kind_tag != ssa.FLAT_OP || next.str != "call_word") {
      return false;
    }
    if (!scalar_lane(w.irops, next)) {
      return true;
    }
  }
  return false;
}

function word_origin(a: Abi, second: boolean): i32 {
  if (!a.known) {
    return org_unknown();
  }
  if (!second) {
    if (a.pair_first) {
      return org_fresh();
    }
    return org_none();
  }
  if (second_holds(a.pair_second)) {
    return org_fresh();
  }
  if (a.pair_second == 0) {
    return org_none();
  }
  return org_unknown();
}

struct Roots { root: i32[], derived: boolean[] }

struct Alias { of: i32, derived: boolean }

function arith_alias(f: ssa.SFunc, defs: ssa.DefSites, ins: ssa.SInst): Alias {
  if (ins.args.len() != 2 || ins.ir_kind != ir.K_ADD && ins.ir_kind != ir.K_SUB) {
    return Alias { of: -1, derived: false };
  }
  let a = def_of(f, defs, ins.args[1]);
  if (a.kind_tag == ssa.CONST_INT) {
    return Alias { of: 0, derived: cursor_step(a.imm) };
  }
  let b = def_of(f, defs, ins.args[0]);
  if (ins.ir_kind == ir.K_ADD && b.kind_tag == ssa.CONST_INT) {
    return Alias { of: 1, derived: cursor_step(b.imm) };
  }
  return Alias { of: -1, derived: false };
}

function cursor_step(c: i32): boolean {
  return c % 8 == 0;
}

function alias_of(f: ssa.SFunc, defs: ssa.DefSites, sigs: rcsigs.Table, ins: ssa.SInst): Alias {
  if (ins.kind_tag == ssa.COPY && ins.args.len() == 1) {
    return Alias { of: 0, derived: false };
  }
  if (ins.kind_tag == ssa.BINARY) {
    return arith_alias(f, defs, ins);
  }
  if (ins.kind_tag == ssa.CALL && ins.args.len() > 0) {
    let sg = sigs.lookup(ins.str);
    if (sg.known && sg.result == rcsigs.result_operand() && sg.arg >= 0 && sg.arg < ins.args.len()) {
      return Alias { of: sg.arg, derived: false };
    }
  }
  return Alias { of: -1, derived: false };
}

function is_zero_const(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssa.CONST_INT && ins.imm == 0 && ins.str == "";
}

function roots(f: ssa.SFunc, defs: ssa.DefSites, sigs: rcsigs.Table): Roots {
  return roots_over(f, defs, sigs, own_roots(f.nvals));
}

function own_roots(n: i32): Roots {
  let root = __alloc_i32(n);
  for v in 0..n {
    root = root.with(v, v);
  }
  return Roots { root: root, derived: __alloc_bool(n) };
}

function roots_over(f: ssa.SFunc, defs: ssa.DefSites, sigs: rcsigs.Table, start: Roots): Roots {
  let derived = start.derived;
  let root = start.root;
  let zero = -1;
  for b in f.blocks {
    for ins in b.insts {
      if (ins.result < 0 || ins.result >= f.nvals) {
        continue;
      }
      let a = alias_of(f, defs, sigs, ins);
      if (a.of >= 0) {
        root = root.with(ins.result, root[ins.args[a.of]]);
        derived = derived.with(ins.result, a.derived || derived[ins.args[a.of]]);
      }
      if (is_zero_const(ins)) {
        if (zero < 0) {
          zero = ins.result;
        } else {
          root = root.with(ins.result, zero);
        }
      } else if (zero >= 0 && ins.kind_tag == ssa.PHI && ins.args.len() == 1 && ins.args[0] >= 0 && root[ins.args[0]] == zero) {
        // The one input of a phi a folded branch leaves at its join.
        root = root.with(ins.result, zero);
      }
    }
  }
  return Roots { root: root, derived: derived };
}

struct Cond { root: i32, on_true: boolean, also: i32[] }

function no_cond(): Cond {
  return Cond { root: -1, on_true: true, also: [] };
}

struct Unique { root: i32, also: i32[] }

function no_unique(): Unique {
  return Unique { root: -1, also: [] };
}

function unique_word(w: Walk, v: i32, path: i32[]): Unique {
  let root = w.root[v];
  let ins = def_in(w, root);
  if (is_call(ins, "__fern_rc_is_unique") && ins.args.len() == 1) {
    return Unique { root: w.root[ins.args[0]], also: [] };
  }
  if (ins.kind_tag != ssa.PHI || util.index_of_i32(path, root) >= 0) {
    return no_unique();
  }
  let t = input_tests(w, ins, path.append(root));
  if (!t.ok) {
    return no_unique();
  }
  let box = shared_box(t.each);
  if (box == -1) {
    return joined_unique(w, ins, t.each);
  }
  if (box < 0) {
    return no_unique();
  }
  return Unique { root: box, also: aliases(w, root, t.each, box) };
}

function aliases(w: Walk, phi: i32, each: Unique[], box: i32): i32[] {
  let also: i32[] = [];
  for i in 0..each.len() {
    if (each[i].root >= 0) {
      for x in each[i].also {
        also = also.append(x);
      }
      also = beside(w, phi, i, box, also);
    }
  }
  return also;
}

struct Tests { ok: boolean, each: Unique[] }

// What each input of a join tests. A zero and the join itself test nothing.
function input_tests(w: Walk, phi: ssa.SInst, path: i32[]): Tests {
  let each: Unique[] = [];
  for a in phi.args {
    let u = no_unique();
    if (a < 0) {
      return Tests { ok: false, each: [] };
    }
    if (!zero_at(w, a) && w.root[a] != w.root[phi.result]) {
      u = unique_word(w, a, path);
      if (u.root < 0) {
        return Tests { ok: false, each: [] };
      }
    }
    each = each.append(u);
  }
  return Tests { ok: true, each: each };
}

// The box that every input tests: -1 where two inputs test different boxes, -2 where no input tests one.
function shared_box(each: Unique[]): i32 {
  let box = -2;
  for u in each {
    if (u.root >= 0 && box >= 0 && u.root != box) {
      return -1;
    }
    if (u.root >= 0) {
      box = u.root;
    }
  }
  return box;
}

// A word that tests a different box on each edge tests the value that joins those boxes.
function joined_unique(w: Walk, phi: ssa.SInst, each: Unique[]): Unique {
  for q in w.f.blocks[w.defs.block[w.root[phi.result]]].insts {
    if (q.kind_tag == ssa.PHI && q.result >= 0 && q.result != phi.result && joins(w, each, q)) {
      return Unique { root: w.root[q.result], also: [] };
    }
  }
  return no_unique();
}

function joins(w: Walk, each: Unique[], q: ssa.SInst): boolean {
  if (q.args.len() != each.len()) {
    return false;
  }
  for i in 0..each.len() {
    let u = each[i];
    if (u.root >= 0 && (q.args[i] < 0 || u.root != w.root[q.args[i]] && util.index_of_i32(u.also, w.root[q.args[i]]) < 0)) {
      return false;
    }
  }
  return true;
}

function beside(w: Walk, phi: i32, i: i32, box: i32, also: i32[]): i32[] {
  let out = also;
  for q in w.f.blocks[w.defs.block[phi]].insts {
    if (q.kind_tag == ssa.PHI && q.result >= 0 && q.result != phi && i < q.args.len() && q.args[i] >= 0 && util.index_of_i32(out, q.result) < 0) {
      let from = w.root[q.args[i]];
      if (from == box || util.index_of_i32(also, from) >= 0) {
        out = out.append(q.result);
      }
    }
  }
  return out;
}

function token_root(w: Walk, regions: i32[][], v: i32): i32 {
  let none: i32[] = [];
  let r = token_root_at(w, regions, v, none);
  if (r == -2) {
    return -1;
  }
  return r;
}

function token_root_at(w: Walk, regions: i32[][], v: i32, path: i32[]): i32 {
  let root = w.root[v];
  if (util.index_of_i32(path, root) >= 0) {
    return -2;
  }
  let ins = def_in(w, root);
  if (ins.kind_tag != ssa.PHI || path.len() >= 8) {
    return -1;
  }
  return token_inputs(w, regions, ins, w.f.blocks[w.defs.block[root]].preds, path.append(root));
}

function token_inputs(w: Walk, regions: i32[][], ins: ssa.SInst, preds: i32[], path: i32[]): i32 {
  let found = -2;
  let i = 0;
  while (i < ins.args.len() && i < preds.len()) {
    let a = ins.args[i];
    if (a < 0) {
      return -1;
    }
    if (!zero_at(w, a)) {
      found = token_merge(found, token_input(w, regions, a, w.at[preds[i]], path));
      if (found == -1) {
        return -1;
      }
    }
    i += 1;
  }
  return found;
}

function token_merge(found: i32, r: i32): i32 {
  if (r == -1 || found == -1) {
    return -1;
  }
  if (r == -2) {
    return found;
  }
  if (found == -2 || found == r) {
    return r;
  }
  return -1;
}

function token_input(w: Walk, regions: i32[][], a: i32, pi: i32, path: i32[]): i32 {
  let r = w.root[a];
  if (pi >= 0 && util.index_of_i32(regions[pi], r) >= 0) {
    return r;
  }
  return token_root_at(w, regions, a, path);
}

struct Tested { word: i32, on_true: boolean }

function tested(w: Walk, cond: i32): Tested {
  let ins = def_in(w, cond);
  if (ins.kind_tag != ssa.BINARY || ins.args.len() != 2 || ins.ir_kind != ir.K_EQ && ins.ir_kind != ir.K_NE) {
    return Tested { word: cond, on_true: true };
  }
  let word = -1;
  if (zero_at(w, ins.args[1])) {
    word = ins.args[0];
  } else if (zero_at(w, ins.args[0])) {
    word = ins.args[1];
  }
  return Tested { word: word, on_true: ins.ir_kind == ir.K_NE };
}

function cond_of(w: Walk, regions: i32[][], cond: i32, with_tokens: boolean): Cond {
  let t = tested(w, cond);
  if (t.word < 0) {
    return no_cond();
  }
  let none: i32[] = [];
  let u = unique_word(w, t.word, none);
  if (u.root >= 0) {
    return Cond { root: u.root, on_true: t.on_true, also: u.also };
  }
  if (!with_tokens) {
    return no_cond();
  }
  let r = token_root(w, regions, t.word);
  if (r >= 0) {
    return Cond { root: r, on_true: t.on_true, also: [] };
  }
  return no_cond();
}

struct Regions { roots: i32[][], openers: i32[][] }

function open_region(own rg: Regions, dom: ssadeps.Dom, reach: boolean[], arm: i32, root: i32, by: i32): Regions {
  if (dom.pre[arm] < 0) {
    return rg;
  }
  let c = dom.pre[arm];
  while (c < dom.post[arm]) {
    let other = dom.by_clock[c];
    if (other >= 0 && reach[other] && util.index_of_i32(rg.roots[other], root) < 0) {
      rg = Regions { roots: rg.roots.with(other, rg.roots[other].append(root)), openers: rg.openers.with(other, rg.openers[other].append(by)) };
    }
    c += 1;
  }
  return rg;
}

function regions_round(w: Walk, own rg: Regions, dom: ssadeps.Dom, reach: boolean[], with_tokens: boolean): Regions {
  for bi in 0..w.f.blocks.len() {
    let t = w.f.blocks[bi].term;
    if (reach[bi] && t.kind_tag == ssa.TERM_BRIF && t.t != t.f) {
      let c = cond_of(w, rg.roots, t.cond, with_tokens);
      let arm = w.at[t.f];
      if (c.on_true) {
        arm = w.at[t.t];
      }
      if (c.root >= 0 && arm >= 0 && (w.f.blocks[arm].preds.len() == 1 || each_edge_tests(w, rg.roots, arm, c.root, with_tokens))) {
        rg = open_region(rg, dom, reach, arm, c.root, w.f.blocks[bi].id);
        for other in c.also {
          rg = open_region(rg, dom, reach, arm, other, w.f.blocks[bi].id);
        }
      }
    }
  }
  return rg;
}

// Each edge into the block leaves a branch whose taken arm proves the box
// unique, so each path into the block proves it.
function each_edge_tests(w: Walk, regions: i32[][], arm: i32, root: i32, with_tokens: boolean): boolean {
  for pid in w.f.blocks[arm].preds {
    let pb = w.at[pid];
    if (pb < 0) {
      return false;
    }
    let t = w.f.blocks[pb].term;
    if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f) {
      return false;
    }
    let c = cond_of(w, regions, t.cond, with_tokens);
    let taken = w.at[t.f];
    if (c.on_true) {
      taken = w.at[t.t];
    }
    if (taken != arm || c.root != root && util.index_of_i32(c.also, root) < 0) {
      return false;
    }
  }
  return true;
}

function unique_regions(w: Walk, dom: ssadeps.Dom, reach: boolean[]): Regions {
  let rg = Regions { roots: [], openers: [] };
  while (rg.roots.len() < w.f.blocks.len()) {
    rg = Regions { roots: rg.roots.append([]), openers: rg.openers.append([]) };
  }
  rg = regions_round(w, rg, dom, reach, false);
  let before = -1;
  let after = region_count(rg);
  while (after != before) {
    before = after;
    rg = regions_round(w, rg, dom, reach, true);
    after = region_count(rg);
  }
  return rg;
}

function region_count(rg: Regions): i32 {
  let n = 0;
  for r in rg.roots {
    n += r.len();
  }
  return n;
}

function child_load(w: Walk, regions: i32[][], bi: i32, ins: ssa.SInst, children_box: boolean[]): boolean {
  if (children_load(w, ins, children_box)) {
    return true;
  }
  return ins.args.len() > 0 && util.index_of_i32(regions[bi], w.root[ins.args[0]]) >= 0;
}

function children_load(w: Walk, ins: ssa.SInst, children_box: boolean[]): boolean {
  if (ins.args.len() == 0) {
    return false;
  }
  let base = w.root[ins.args[0]];
  return base < children_box.len() && children_box[base];
}

// Whether each path from the load at pos reads the same slot of the same box
// again, so the later load, not this one, holds the child.
function reloaded(w: Walk, bi: i32, pos: i32, ld: ssa.SInst): boolean {
  if (!slot_read_again(w, ld)) {
    return false;
  }
  let first = reread_in(w, ld, bi, pos + 1);
  if (first != 0) {
    return first > 0;
  }
  let seen = __alloc_bool(w.f.blocks.len());
  let stack: i32[] = [bi];
  let top = 1;
  while (top > 0) {
    top -= 1;
    let b = stack[top];
    if (w.splits.returns[b]) {
      return false;
    }
    for e in 0..2 {
      let si = w.splits.to[b * 2 + e];
      if (si == bi) {
        return false;
      }
      if (si >= 0 && !seen[si]) {
        seen = seen.with(si, true);
        let r = reread_in(w, ld, si, 0);
        if (r < 0) {
          return false;
        }
        if (r == 0) {
          stack = pushed(stack, top, si);
          top += 1;
        }
      }
    }
  }
  return true;
}

// 1 when block b reads the slot of ld again from `from` on, -1 when an op
// first defines, writes or hands on the box, and 0 when the block does neither.
function reread_in(w: Walk, ld: ssa.SInst, b: i32, from: i32): i32 {
  let base = w.root[ld.args[0]];
  let insts = w.f.blocks[b].insts;
  for i in from..insts.len() {
    let d = insts[i];
    if (same_slot_load(w, d, ld)) {
      return 1;
    }
    if (d.result >= 0 && w.root[d.result] == base || d.kind_tag != ssa.LD_AT && d.kind_tag != ssa.ARR_AT && !is_call(d, "__fern_rc_is_unique") && uses_root(w, d, base)) {
      return -1;
    }
  }
  return 0;
}

function uses_root(w: Walk, d: ssa.SInst, base: i32): boolean {
  for a in d.args {
    if (a >= 0 && w.root[a] == base) {
      return true;
    }
  }
  return false;
}

function slot_read_again(w: Walk, ld: ssa.SInst): boolean {
  for b in w.firsts[w.root[ld.args[0]]] {
    for d in w.f.blocks[b].insts {
      if (same_slot_load(w, d, ld)) {
        return true;
      }
    }
  }
  return false;
}

struct Shells { base: i32[], phi: i32[], block: i32[], at: i32[] }

function shells_of(w: Walk): Shells {
  let out = Shells { base: [], phi: [], block: [], at: [] };
  for bi in 0..w.f.blocks.len() {
    let insts = w.f.blocks[bi].insts;
    for i in 0..insts.len() {
      let ins = insts[i];
      let base = -1;
      let phi = -1;
      if (is_shell(w, ins) || ins.kind_tag == ssa.COPY && ins.result >= 0 && ins.result < w.reused.len() && w.reused[ins.result]) {
        base = w.root[ins.args[0]];
      } else if (is_reuse(ins)) {
        base = w.root[ins.args[0]];
        if (phi_valued(w, base)) {
          phi = base;
          base = -1;
        }
      }
      if (base >= 0 || phi >= 0) {
        out = Shells { base: out.base.append(base), phi: out.phi.append(phi), block: out.block.append(bi), at: out.at.append(i) };
      }
    }
  }
  return out;
}

function is_reuse(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssa.CALL && ins.str == "__fern_alloc_reuse" && ins.args.len() > 0;
}

function carries(w: Walk, p: i32, base: i32): boolean {
  let path: i32[] = [];
  return carries_at(w, p, base, path, false);
}

function carries_at(w: Walk, p: i32, base: i32, path: i32[], outer: boolean): boolean {
  let f = w.f;
  let defs = w.defs;
  let root = w.root;
  let derived = w.derived;
  if (outer) {
    f = w.outer.f;
    defs = w.outer.defs;
    root = w.outer.root;
    derived = w.outer.derived;
  }
  let ins = def_of(f, defs, p);
  if (ins.kind_tag != ssa.PHI || path.len() >= 8) {
    return false;
  }
  let any = false;
  for a in ins.args {
    if (a < 0) {
      return false;
    }
    if (!(is_zero(f, defs, a) || !outer && zero_at(w, a))) {
      let r = root[a];
      if (r == base && !derived[a]) {
        any = true;
      } else if (r != p && util.index_of_i32(path, r) < 0) {
        let via_outer = outer || w.outer.on && outside(w.f, w.defs, r);
        if (!carries_at(w, r, base, path.append(p), via_outer)) {
          return false;
        }
        any = true;
      }
    }
  }
  return any;
}

function phi_valued(w: Walk, v: i32): boolean {
  return def_at(w, v).kind_tag == ssa.PHI;
}

function is_shell(w: Walk, ins: ssa.SInst): boolean {
  return ins.kind_tag == ssa.CALL && ins.imm == 2 && ins.args.len() > 0;
}

function reuses(w: Walk, ins: ssa.SInst, base: i32, boxed: boolean[]): boolean {
  if (ins.args.len() == 0 || ins.result < 0) {
    return false;
  }
  let on_box = ins.kind_tag == ssa.COPY && ins.result < w.reused.len() && w.reused[ins.result] || is_reuse(ins);
  if (!on_box) {
    return false;
  }
  let r = w.root[ins.args[0]];
  return r == base || r < boxed.len() && boxed[r];
}

function writes_slot(w: Walk, mb: i32, i: i32, r: i32, ld: ssa.SInst): boolean {
  let insts = w.f.blocks[mb].insts;
  let key = load_key(w, ld);
  for j in i + 1..insts.len() {
    let d = insts[j];
    if (d.args.len() > 0 && w.root[d.args[0]] == w.root[r]) {
      if (is_load(d) && load_key(w, d) == key && d.kind_tag == ssa.LD_AT == (ld.kind_tag == ssa.LD_AT)) {
        return false;
      }
      if ((d.kind_tag == ssa.ST_AT || d.kind_tag == ssa.ARR_ST) && d.args.len() >= 2 && store_key(w, d) == key && d.kind_tag == ssa.ST_AT == (ld.kind_tag == ssa.LD_AT)) {
        return true;
      }
    }
  }
  return false;
}

function shell_taken(w: Walk, sh: Shells, dom: ssadeps.Dom, bi: i32, pos: i32, ld: ssa.SInst): boolean {
  if (ld.args.len() == 0) {
    return false;
  }
  let base = w.root[ld.args[0]];
  let any = false;
  let k = 0;
  while (k < sh.base.len() && !any) {
    any = sh.base[k] == base || sh.phi[k] >= 0 && util.index_of_i32(w.carried[base], sh.phi[k]) >= 0;
    k += 1;
  }
  if (!any) {
    return false;
  }
  let es = escape_fixpoint(w, ld, bi, pos);
  if (es.escapes) {
    return false;
  }
  let reach: boolean[] = [];
  for k in 0..sh.base.len() {
    if (sh.base[k] == base || sh.phi[k] >= 0 && sh.phi[k] < es.boxed.len() && es.boxed[sh.phi[k]]) {
      let after = before(dom, bi, pos, sh.block[k], sh.at[k]);
      if (!after) {
        if (reach.len() == 0) {
          reach = reached_in(w.f, w.at, bi, -1);
        }
        after = reach[sh.block[k]];
      }
      if (after && !between(w, dom, ld, bi, pos, sh.block[k], sh.at[k])) {
        return true;
      }
    }
  }
  return false;
}

function before(dom: ssadeps.Dom, bi: i32, pos: i32, sb: i32, at: i32): boolean {
  if (sb == bi) {
    return at > pos;
  }
  return ssadeps.dom_holds(dom, sb, bi);
}

function children_phi(w: Walk, regions: i32[][], out: boolean[], b: ssa.SBlock, ins: ssa.SInst): boolean {
  for i in 0..ins.args.len() {
    let a = ins.args[i];
    if (a < 0) {
      return false;
    }
    let r = w.root[a];
    let pb = w.at[b.preds[i]];
    if (!out[r] && (pb < 0 || util.index_of_i32(regions[pb], r) < 0)) {
      return false;
    }
  }
  return true;
}

function children_params(w: Walk, own out: boolean[]): boolean[] {
  let pi = 0;
  while (w.self_abi.known && pi < w.self_abi.modes.len() && pi < w.f.nparams) {
    if (w.self_abi.modes[pi] == children_mode()) {
      out = out.with(pi, true);
    }
    pi += 1;
  }
  return out;
}

function children_boxes(w: Walk, regions: i32[][]): boolean[] {
  let f = w.f;
  let out = children_params(w, __alloc_bool(f.nvals));
  let grown = true;
  while (grown) {
    grown = false;
    for b in f.blocks {
      for ins in b.insts {
        if (ins.kind_tag != ssa.PHI || ins.result < 0 || out[ins.result] || ins.args.len() != b.preds.len()) {
          continue;
        }
        if (children_phi(w, regions, out, b, ins)) {
          out = out.with(ins.result, true);
          grown = true;
        }
      }
    }
  }
  return out;
}

function result_origin(result: i32): i32 {
  if (result == rcsigs.result_fresh()) {
    return org_fresh();
  }
  if (result == rcsigs.result_borrow()) {
    return org_borrowed();
  }
  if (result == rcsigs.result_unknown()) {
    return org_unknown();
  }
  return org_none();
}

function call_origin(w: Walk, ins: ssa.SInst): i32 {
  let s = w.sigs.lookup(ins.str);
  if (s.known) {
    if (s.result == rcsigs.result_operand()) {
      return org_none();
    }
    if (s.result == rcsigs.result_marked()) {
      if (ins.imm == 1) {
        return org_fresh();
      }
      if (ins.imm == 3) {
        return org_borrowed();
      }
      return org_none();
    }
    return result_origin(s.result);
  }
  let a = w.abis.lookup(ins.str);
  if (!a.known) {
    return org_unknown();
  }
  if (a.result_unit) {
    return org_fresh();
  }
  return org_none();
}

function phi_holds(w: Walk, out: i32[], holds: boolean[], ins: ssa.SInst): boolean {
  for a in ins.args {
    if (a < 0 || w.derived[a]) {
      continue;
    }
    let r = w.root[a];
    if (out[r] != org_none() && (out[r] != org_merged() || holds[r])) {
      return true;
    }
  }
  return false;
}

function scalar_phis(w: Walk, own out: i32[]): i32[] {
  let f = w.f;
  let holds = __alloc_bool(f.nvals);
  let changed = true;
  while (changed) {
    changed = false;
    for b in f.blocks {
      for ins in b.insts {
        if (ins.kind_tag == ssa.PHI && ins.result >= 0 && !holds[ins.result] && phi_holds(w, out, holds, ins)) {
          holds = holds.with(ins.result, true);
          changed = true;
        }
      }
    }
  }
  return clear_scalar_phis(out, holds);
}

function clear_scalar_phis(own out: i32[], holds: boolean[]): i32[] {
  let v = 0;
  while (v < out.len()) {
    if (out[v] == org_merged() && !holds[v]) {
      out = out.with(v, org_none());
    }
    v += 1;
  }
  return out;
}

struct Origins { origin: i32[], why: i32[], opened: i32[], pair_tag: i32[], pair_mask: i32[], pair_words: i32[] }

struct Found { origin: i32, why: i32, opened: i32, tag: i32, mask: i32 }

function plain(origin: i32): Found {
  return Found { origin: origin, why: 0, opened: -1, tag: -1, mask: 0 };
}

function child(why: i32): Found {
  return Found { origin: org_child(), why: why, opened: -1, tag: -1, mask: 0 };
}

struct Context { regions: i32[][], openers: i32[][], children_box: boolean[], dom: ssadeps.Dom, stores: Stores, shells: Shells }

function param_origin(w: Walk, p: i32): i32 {
  if (!w.self_abi.known || p >= w.self_abi.modes.len()) {
    return org_unknown();
  }
  let m = w.self_abi.modes[p];
  if (m == counted_mode()) {
    return org_transferred();
  }
  if (m == borrow_mode() || m == children_mode()) {
    return org_borrowed();
  }
  return org_none();
}

function load_origin(w: Walk, c: Context, bi: i32, pos: i32, ins: ssa.SInst): Found {
  if (child_load(w, c.regions, bi, ins, c.children_box) && !(children_load(w, ins, c.children_box) && reloaded(w, bi, pos, ins))) {
    let fd = child(1);
    if (ins.args.len() > 0) {
      let at = util.index_of_i32(c.regions[bi], w.root[ins.args[0]]);
      if (at >= 0 && at < c.openers[bi].len()) {
        fd = Found { ...fd, opened: c.openers[bi][at] };
      }
    }
    return fd;
  }
  if (overwritten(w, c.stores, c.dom, bi, pos, ins)) {
    return child(2);
  }
  if (shell_taken(w, c.shells, c.dom, bi, pos, ins)) {
    return child(3);
  }
  return plain(org_borrowed());
}

function call_origin_at(w: Walk, c: Context, bi: i32, pos: i32, ins: ssa.SInst): Found {
  if (paired_call(w, w.f.blocks[bi], pos) && !w.sigs.lookup(ins.str).known) {
    return plain(word_origin(w.abis.lookup(ins.str), false));
  }
  return plain(call_origin(w, ins));
}

function word_origin_at(w: Walk, bi: i32, pos: i32): Found {
  let insts = w.f.blocks[bi].insts;
  let c = pos - 1;
  while (c >= 0 && is_call_word(insts[c])) {
    c -= 1;
  }
  if (c >= 0 && insts[c].kind_tag == ssa.CALL_IND) {
    return plain(indirect_word_origin(indirect_units(insts[c]), word_slot(w, insts[pos])));
  }
  if (c < 0 || insts[c].kind_tag != ssa.CALL) {
    return plain(org_unknown());
  }
  let call = insts[c];
  let a = w.abis.lookup(call.str);
  let mask = word_mask(a, word_slot(w, insts[pos]), three_words(w, insts, c));
  let fd = plain(word_origin(Abi { ...a, pair_second: mask }, true));
  if (mask > 0 && call.result >= 0) {
    fd = Found { ...fd, tag: call.result, mask: mask };
  }
  return fd;
}

// The origin of pair word `slot` of a call through a function value.
function indirect_word_origin(units: i32, slot: i32): i32 {
  if (units < 0) {
    return org_unknown();
  }
  let held = slot >= 0 && (units & ir.call_units_word(slot)) != 0;
  if (held) {
    return org_fresh();
  }
  return org_none();
}

function is_call_word(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssa.FLAT_OP && ins.str == "call_word";
}

// The pair word a call_word or ret_word moves, or -1 for a scalar lane.
function word_slot(w: Walk, ins: ssa.SInst): i32 {
  if (ins.imm < 0 || ins.imm >= w.irops.len() || w.irops[ins.imm].width == 64) {
    return -1;
  }
  return w.irops[ins.imm].i32_imm;
}

// Whether the call at c hands back a second pair word.
function three_words(w: Walk, insts: ssa.SInst[], c: i32): boolean {
  let first = c + 1;
  for k in first..insts.len() {
    if (!is_call_word(insts[k])) {
      return false;
    }
    if (word_slot(w, insts[k]) == 1) {
      return true;
    }
  }
  return false;
}

// The variants whose word at slot holds a unit. A callee's own first word
// can read pair_second either way: it names every variant split_second does.
function word_mask(a: Abi, slot: i32, split: boolean): i32 {
  if (slot < 0) {
    return 0;
  }
  if (slot == 1) {
    return a.split_third;
  }
  if (slot == 0 && split) {
    return a.split_second;
  }
  return a.pair_second;
}

function named_origin(w: Walk, ins: ssa.SInst): i32 {
  let sg = w.ops.op_lookup(ins.str);
  if (sg.known) {
    return result_origin(sg.result);
  }
  if (marked_result(w, ins)) {
    return org_fresh();
  }
  return org_none();
}

function simple_origin(w: Walk, ins: ssa.SInst): i32 {
  let k = ins.kind_tag;
  if (k == ssa.PHI) {
    return org_merged();
  }
  if (k == ssa.ARR_BOX) {
    return org_fresh();
  }
  if (k == ssa.STR_VIEW) {
    if (ins.imm == 0) {
      return org_fresh();
    }
    return org_none();
  }
  if (k == ssa.CALL_IND || k == ssa.DYN_DISPATCH) {
    let units = indirect_units(ins);
    let result = units & ir.call_units_result();
    if (units < 0) {
      return org_unknown();
    }
    if (result != 0) {
      return org_fresh();
    }
    return org_none();
  }
  if (is_named_op(k) && ins.str != "call_word") {
    return named_origin(w, ins);
  }
  return -1;
}

function origin_of(w: Walk, c: Context, bi: i32, pos: i32, ins: ssa.SInst): Found {
  let simple = simple_origin(w, ins);
  if (simple >= 0) {
    return plain(simple);
  }
  if (is_load(ins)) {
    return load_origin(w, c, bi, pos, ins);
  }
  if (ins.kind_tag == ssa.CALL) {
    return call_origin_at(w, c, bi, pos, ins);
  }
  if (ins.kind_tag == ssa.FLAT_OP) {
    return word_origin_at(w, bi, pos);
  }
  return plain(org_none());
}

function origins(w: Walk, stores: Stores, regions: i32[][], openers: i32[][], children_box: boolean[], dom: ssadeps.Dom): Origins {
  let f = w.f;
  let c = Context { regions: regions, openers: openers, children_box: children_box, dom: dom, stores: stores, shells: shells_of(w) };
  let out = __alloc_i32(f.nvals);
  let why = __alloc_i32(f.nvals);
  let opened = util.minus_ones(f.nvals);
  let pair_tag = util.minus_ones(f.nvals);
  let pair_mask = __alloc_i32(f.nvals);
  let pair_words: i32[] = [];
  let p = 0;
  while (p < f.nparams && p < f.nvals) {
    out = out.with(p, param_origin(w, p));
    p += 1;
  }
  let bi = 0;
  while (bi < f.blocks.len()) {
    let pos = -1;
    for ins in f.blocks[bi].insts {
      pos += 1;
      let v = ins.result;
      if (v < 0 || v >= f.nvals || w.root[v] != v || ins.kind_tag == ssa.PARAM) {
        continue;
      }
      let fd = origin_of(w, c, bi, pos, ins);
      out = out.with(v, fd.origin);
      why = why.with(v, fd.why);
      opened = opened.with(v, fd.opened);
      if (fd.tag >= 0) {
        pair_tag = pair_tag.with(v, fd.tag);
        pair_mask = pair_mask.with(v, fd.mask);
        pair_words = pair_words.append(v);
      }
    }
    bi += 1;
  }
  return Origins { origin: scalar_phis(w, out), why: why, opened: opened, pair_tag: pair_tag, pair_mask: pair_mask, pair_words: pair_words };
}

struct Stores { base: i32[], key: i32[], block: i32[], at: i32[], zero: boolean[], by_base: i32[][] }

function stores_of(w: Walk): Stores {
  let f = w.f;
  let out = Stores { base: [], key: [], block: [], at: [], zero: [], by_base: [] };
  while (out.by_base.len() < f.nvals) {
    out = Stores { ...out, by_base: out.by_base.append([]) };
  }
  for bi in 0..f.blocks.len() {
    let insts = f.blocks[bi].insts;
    for i in 0..insts.len() {
      let st = insts[i];
      if ((st.kind_tag == ssa.ST_AT && st.args.len() == 2 || st.kind_tag == ssa.ARR_ST && st.args.len() == 3) && st.args[0] >= 0) {
        let base = w.root[st.args[0]];
        let key = st.imm;
        if (st.kind_tag == ssa.ARR_ST) {
          key = index_key(w, st.args[1]);
        }
        let n = out.base.len();
        out = Stores {
          base: out.base.append(base), key: out.key.append(key), block: out.block.append(bi), at: out.at.append(i),
          zero: out.zero.append(zero_at(w, st.args[st.args.len() - 1])),
          by_base: out.by_base.with(base, out.by_base[base].append(n)),
        };
      }
    }
  }
  return out;
}

function load_key(w: Walk, ld: ssa.SInst): i32 {
  if (ld.kind_tag == ssa.LD_AT) {
    return ld.imm;
  }
  if (ld.args.len() >= 2) {
    return index_key(w, ld.args[1]);
  }
  return -1;
}

function index_key(w: Walk, v: i32): i32 {
  let d = def_in(w, w.root[v]);
  if (d.kind_tag == ssa.CONST_INT && d.imm >= 0) {
    return -2 - d.imm;
  }
  return w.root[v];
}

function same_slot(w: Walk, st: Stores, k: i32, ld: ssa.SInst): boolean {
  if (st.key[k] != load_key(w, ld)) {
    return false;
  }
  if (ld.kind_tag == ssa.LD_AT) {
    return w.f.blocks[st.block[k]].insts[st.at[k]].kind_tag == ssa.ST_AT;
  }
  return w.f.blocks[st.block[k]].insts[st.at[k]].kind_tag == ssa.ARR_ST;
}

function overwritten(w: Walk, st: Stores, dom: ssadeps.Dom, bi: i32, pos: i32, ld: ssa.SInst): boolean {
  if (ld.args.len() == 0) {
    return false;
  }
  let base = w.root[ld.args[0]];
  for k in st.by_base[base] {
    if (st.zero[k] || !same_slot(w, st, k, ld) || stores_back(w, st, k, ld)) {
      continue;
    }
    if (st.block[k] == bi) {
      if (st.at[k] > pos && !between(w, dom, ld, bi, pos, st.block[k], st.at[k])) {
        return !escapes(w, ld, bi, pos, 1);
      }
    } else if (ssadeps.dom_holds(dom, st.block[k], bi) && !between(w, dom, ld, bi, pos, st.block[k], st.at[k])) {
      return !escapes(w, ld, bi, pos, 1);
    }
  }
  return false;
}

function escapes(w: Walk, ld: ssa.SInst, lb: i32, lp: i32, mode: i32): boolean {
  let none: boolean[] = [];
  if (mode != 2) {
    let no_phis: i32[] = [];
    return escape_paths(w, ld, lb, lp, mode, none, slot_blocks(w, w.root[ld.args[0]], no_phis), false).escapes;
  }
  return escape_fixpoint(w, ld, lb, lp).escapes;
}

struct Escape { escapes: boolean, boxed: boolean[] }

function escape_fixpoint(w: Walk, ld: ssa.SInst, lb: i32, lp: i32): Escape {
  let base = w.root[ld.args[0]];
  let cands = token_phis_of(w, base);
  let boxed = assumed_boxed(w, cands);
  let marks = slot_blocks(w, base, cands);
  let again = true;
  while (again) {
    let r = escape_paths(w, ld, lb, lp, 2, boxed, marks, cands.len() > 0);
    if (r.escapes) {
      return Escape { escapes: true, boxed: boxed };
    }
    again = false;
    for p in cands {
      if (boxed[p] && !box_on_edges(w, p, base, boxed, r.edge)) {
        boxed = boxed.with(p, false);
        again = true;
      }
    }
  }
  return Escape { escapes: false, boxed: boxed };
}

function assumed_boxed(w: Walk, cands: i32[]): boolean[] {
  if (cands.len() == 0) {
    return [];
  }
  let boxed = __alloc_bool(w.f.nvals);
  for p in cands {
    boxed = boxed.with(p, true);
  }
  return boxed;
}

function firsts_of(f: ssa.SFunc, root: i32[]): i32[][] {
  let out: i32[][] = [];
  while (out.len() < f.nvals) {
    out = out.append([]);
  }
  for bi in 0..f.blocks.len() {
    for ins in f.blocks[bi].insts {
      if (ins.args.len() > 0 && ins.args[0] >= 0 && ins.args[0] < root.len()) {
        let r = root[ins.args[0]];
        let n = out[r].len();
        if (n == 0 || out[r][n - 1] != bi) {
          out = out.with(r, out[r].append(bi));
        }
      }
    }
  }
  return out;
}

function slot_blocks(w: Walk, base: i32, phis: i32[]): boolean[] {
  let out = __alloc_bool(w.f.blocks.len());
  for b in w.firsts[base] {
    out = out.with(b, true);
  }
  for p in phis {
    for b in w.firsts[p] {
      out = out.with(b, true);
    }
  }
  if (base < w.defs.block.len() && w.defs.block[base] >= 0) {
    out = out.with(w.defs.block[base], true);
  }
  return out;
}

struct Paths { escapes: boolean, edge: boolean[] }

function escape_paths(w: Walk, ld: ssa.SInst, lb: i32, lp: i32, mode: i32, boxed: boolean[], marks: boolean[], edges: boolean): Paths {
  let edge = edge_flags(w, edges);
  if (marks[lb] && settles_in(w, ld, lb, lp + 1, w.f.blocks[lb].insts.len(), mode, boxed)) {
    return Paths { escapes: false, edge: edge };
  }
  if (w.splits.returns[lb]) {
    return Paths { escapes: true, edge: edge };
  }
  let seen = __alloc_bool(w.f.blocks.len());
  let stack: i32[] = [lb];
  let top = 1;
  while (top > 0) {
    top -= 1;
    let b = stack[top];
    for e in 0..2 {
      let si = w.splits.to[b * 2 + e];
      if (si >= 0 && token_zero_edge(w, b, e, boxed)) {
        si = -1;
      }
      if (si >= 0) {
        edge = took_edge(edge, b * 2 + e);
      }
      if (si == lb) {
        return Paths { escapes: true, edge: edge };
      }
      if (si >= 0 && !seen[si]) {
        seen = seen.with(si, true);
        if (!(marks[si] && settles_in(w, ld, si, 0, w.f.blocks[si].insts.len(), mode, boxed))) {
          if (w.splits.returns[si]) {
            return Paths { escapes: true, edge: edge };
          }
          stack = pushed(stack, top, si);
          top += 1;
        }
      }
    }
  }
  return Paths { escapes: false, edge: edge };
}

// The edge a test of a boxed token takes when the token is zero. A token stays
// boxed only while every walked edge into it carries the shell, so no walked
// path takes this edge.
function token_zero_edge(w: Walk, b: i32, e: i32, boxed: boolean[]): boolean {
  let word = w.splits.word[b];
  return word >= 0 && boxed_token(w, boxed, word) && e == 1 == w.splits.on_true[b];
}

// The ends of the blocks, for the walks that follow the edges. For each
// block that ends in a branch with two targets, `word` is the word that the
// branch tests and `on_true` the side that a word that is not zero takes.
// The word is -1 for each other block. `to` has the two successors of each
// block as block indexes, or -1. `returns` marks a block that ends in a
// return.
struct Splits { word: i32[], on_true: boolean[], to: i32[], returns: boolean[] }

function splits_of(w: Walk): Splits {
  let word: i32[] = [];
  let on_true: boolean[] = [];
  let to: i32[] = [];
  let returns: boolean[] = [];
  for b in w.f.blocks {
    let t = b.term;
    returns = returns.append(t.kind_tag == ssa.TERM_RET);
    for e in 0..2 {
      let sid = ssa.successor_id(t, e);
      to = to.append(if (sid >= 0 && sid < w.at.len()) { w.at[sid] } else { -1 });
    }
    if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f) {
      word = word.append(-1);
      on_true = on_true.append(false);
    } else {
      let tt = tested(w, t.cond);
      word = word.append(tt.word);
      on_true = on_true.append(tt.on_true);
    }
  }
  return Splits { word: word, on_true: on_true, to: to, returns: returns };
}

function boxed_token(w: Walk, boxed: boolean[], v: i32): boolean {
  let r = w.root[v];
  return r >= 0 && r < boxed.len() && boxed[r];
}

function edge_flags(w: Walk, edges: boolean): boolean[] {
  if (!edges) {
    return [];
  }
  return __alloc_bool(w.f.blocks.len() * 2);
}

function took_edge(own edge: boolean[], i: i32): boolean[] {
  if (edge.len() == 0) {
    return edge;
  }
  return edge.with(i, true);
}

function carried_of(w: Walk): i32[][] {
  let out: i32[][] = [];
  while (out.len() < w.f.nvals) {
    out = out.append([]);
  }
  for p in w.phis {
    out = carried_into(out, w, p);
  }
  if (w.outer.on) {
    for p in w.outer.phis {
      if (p < w.f.nvals && outside(w.f, w.defs, p)) {
        out = carried_into(out, w, p);
      }
    }
  }
  return out;
}

function carried_into(own out: i32[][], w: Walk, p: i32): i32[][] {
  for c in carry_candidates(w, p) {
    if (c < out.len() && util.index_of_i32(out[c], p) < 0 && carries(w, p, c)) {
      out = out.with(c, out[c].append(p));
    }
  }
  return out;
}

function carry_candidates(w: Walk, p: i32): i32[] {
  let out: i32[] = [p];
  let path: i32[] = [];
  let cur = p;
  let outer = false;
  while (path.len() < 8) {
    let f = w.f;
    let defs = w.defs;
    let root = w.root;
    if (outer) {
      f = w.outer.f;
      defs = w.outer.defs;
      root = w.outer.root;
    }
    let ins = def_of(f, defs, cur);
    if (ins.kind_tag != ssa.PHI) {
      return out;
    }
    let next = -1;
    for a in ins.args {
      if (next < 0 && a >= 0 && !(is_zero(f, defs, a) || !outer && zero_at(w, a)) && root[a] != cur && util.index_of_i32(path, root[a]) < 0) {
        next = root[a];
      }
    }
    if (next < 0) {
      return out;
    }
    out = out.append(next);
    path = path.append(cur);
    outer = outer || w.outer.on && outside(w.f, w.defs, next);
    cur = next;
  }
  return out;
}

function token_phis_of(w: Walk, base: i32): i32[] {
  return w.carried[base];
}

function box_on_edges(w: Walk, p: i32, base: i32, boxed: boolean[], edge: boolean[]): boolean {
  let bi = w.defs.block[p];
  if (bi < 0) {
    return false;
  }
  let ins = def_in(w, p);
  let b = w.f.blocks[bi];
  let any = false;
  let i = 0;
  while (i < ins.args.len() && i < b.preds.len()) {
    let pb = w.at[b.preds[i]];
    if (pb >= 0 && edge_taken(w, edge, pb, b.id)) {
      any = true;
      let a = ins.args[i];
      if (a < 0 || zero_at(w, a)) {
        return false;
      }
      let r = w.root[a];
      if (!(r == base && !w.derived[a] || boxed[r])) {
        return false;
      }
    }
    i += 1;
  }
  return any;
}

function edge_taken(w: Walk, edge: boolean[], pb: i32, sid: i32): boolean {
  for e in 0..2 {
    if (ssa.successor_id(w.f.blocks[pb].term, e) == sid && edge[pb * 2 + e]) {
      return true;
    }
  }
  return false;
}

function settles_in(w: Walk, ld: ssa.SInst, mb: i32, from: i32, to: i32, mode: i32, boxed: boolean[]): boolean {
  if (event_in(w, ld, mb, from, to)) {
    return true;
  }
  let insts = w.f.blocks[mb].insts;
  let base = w.root[ld.args[0]];
  let i = from;
  while (i < to && i < insts.len()) {
    let d = insts[i];
    if (mode == 1 && (d.kind_tag == ssa.ST_AT || d.kind_tag == ssa.ARR_ST) && d.args.len() >= 2 && w.root[d.args[0]] == base && store_key(w, d) == load_key(w, ld) && d.kind_tag == ssa.ST_AT == (ld.kind_tag == ssa.LD_AT)) {
      return true;
    }
    if (mode == 2 && (is_shell(w, d) && w.root[d.args[0]] == base || reuses(w, d, base, boxed) && writes_slot(w, mb, i, d.result, ld) || frees_token(w, d, boxed))) {
      return true;
    }
    i += 1;
  }
  return false;
}

function frees_token(w: Walk, d: ssa.SInst, boxed: boolean[]): boolean {
  return is_call(d, "__fern_rc_dec") && d.args.len() == 1 && boxed_token(w, boxed, d.args[0]);
}

function store_key(w: Walk, st: ssa.SInst): i32 {
  if (st.kind_tag == ssa.ST_AT) {
    return st.imm;
  }
  return index_key(w, st.args[1]);
}

function between(w: Walk, dom: ssadeps.Dom, ld: ssa.SInst, lb: i32, lp: i32, sb: i32, sp: i32): boolean {
  let base = w.root[ld.args[0]];
  let marks = slot_blocks(w, base, w.carried[base]);
  if (lb == sb && sp > lp && !(marks[lb] && event_in(w, ld, lb, lp + 1, sp))) {
    return false;
  }
  let seen = __alloc_bool(w.f.blocks.len());
  let stack: i32[] = [];
  let top = 0;
  if (!(marks[lb] && event_in(w, ld, lb, lp + 1, w.f.blocks[lb].insts.len()))) {
    stack = stack.append(lb);
    top = 1;
  }
  while (top > 0) {
    top -= 1;
    let b = stack[top];
    for e in 0..2 {
      let sid = ssa.successor_id(w.f.blocks[b].term, e);
      let si = -1;
      if (sid >= 0) {
        si = w.at[sid];
      }
      if (si == sb) {
        if (!(marks[sb] && event_in(w, ld, sb, 0, sp))) {
          return false;
        }
      } else if (si >= 0 && !seen[si]) {
        seen = seen.with(si, true);
        if (!(marks[si] && event_in(w, ld, si, 0, w.f.blocks[si].insts.len()))) {
          stack = pushed(stack, top, si);
          top += 1;
        }
      }
    }
  }
  return true;
}

function event_in(w: Walk, ld: ssa.SInst, mb: i32, from: i32, to: i32): boolean {
  let insts = w.f.blocks[mb].insts;
  let base = w.root[ld.args[0]];
  for i in from..to.min(insts.len()) {
    let d = insts[i];
    if (same_slot_load(w, d, ld) || d.result == base || d.kind_tag == ssa.CALL && d.str.starts_with("__sem_drop_") && d.args.len() > 0 && w.root[d.args[0]] == base) {
      return true;
    }
  }
  return false;
}

function stores_back(w: Walk, st: Stores, k: i32, ld: ssa.SInst): boolean {
  let s = w.f.blocks[st.block[k]].insts[st.at[k]];
  return ld.result >= 0 && w.root[s.args[s.args.len() - 1]] == w.root[ld.result];
}

function same_slot_load(w: Walk, other: ssa.SInst, ld: ssa.SInst): boolean {
  return other.result != ld.result && is_load(other) && other.kind_tag == ld.kind_tag
    && other.args.len() > 0 && same_load_box(w, w.root[ld.args[0]], w.root[other.args[0]]) && load_key(w, other) == load_key(w, ld);
}

function same_load_box(w: Walk, base: i32, other: i32): boolean {
  // A token walk can prove that a joined parent still names this box.
  return other == base || util.index_of_i32(w.carried[base], other) >= 0;
}

struct Touch { touched: boolean[] }

function touch(own t: Touch, w: Walk, v: i32): Touch {
  if (v >= 0 && v < w.root.len()) {
    t = Touch { touched: t.touched.with(w.root[v], true) };
  }
  return t;
}

function touch_all(own t: Touch, w: Walk, args: i32[]): Touch {
  for a in args {
    t = touch(t, w, a);
  }
  return t;
}

function touch_sig(own t: Touch, w: Walk, ins: ssa.SInst, sg: rcsigs.Sig): Touch {
  if (sg.arg >= 0 && sg.arg < ins.args.len() && sg.effect != rcsigs.effect_inspect()) {
    t = touch(t, w, ins.args[sg.arg]);
  }
  for i in sg.also {
    if (i < ins.args.len()) {
      t = touch(t, w, ins.args[i]);
    }
  }
  for i in sg.unsure {
    if (i < ins.args.len()) {
      t = touch(t, w, ins.args[i]);
    }
  }
  return t;
}

function touch_call(own t: Touch, w: Walk, ins: ssa.SInst): Touch {
  let sg = w.sigs.lookup(ins.str);
  if (sg.known) {
    return touch_sig(t, w, ins, sg);
  }
  let a = w.abis.lookup(ins.str);
  if (!a.known) {
    return touch_all(t, w, ins.args);
  }
  let i = 0;
  while (i < ins.args.len() && i < a.modes.len()) {
    if (a.modes[i] == counted_mode()) {
      t = touch(t, w, ins.args[i]);
    }
    i += 1;
  }
  return t;
}

function touch_named(own t: Touch, w: Walk, ins: ssa.SInst): Touch {
  if (ins.str == "ret_word") {
    if (word_mask(w.self_abi, word_slot(w, ins), false) != 0) {
      t = touch_all(t, w, ins.args);
    }
    return t;
  }
  if (rcsigs.boxes_operands(ins.str)) {
    return touch_all(t, w, ins.args);
  }
  let sg = w.ops.op_lookup(ins.str);
  if (!sg.known) {
    return t;
  }
  if (rcsigs.pushes_element(ins.str) && ins.args.len() > 0) {
    t = touch(t, w, ins.args[ins.args.len() - 1]);
  }
  if (sg.arg >= 0 && sg.arg < ins.args.len() && sg.effect != rcsigs.effect_inspect()) {
    t = touch(t, w, ins.args[sg.arg]);
  }
  return t;
}

function touch_inst(own t: Touch, w: Walk, ins: ssa.SInst): Touch {
  let k = ins.kind_tag;
  if (k == ssa.CALL) {
    return touch_call(t, w, ins);
  }
  if (is_store(k) && ins.args.len() > 0) {
    return touch(t, w, ins.args[ins.args.len() - 1]);
  }
  if (is_named_op(k)) {
    return touch_named(t, w, ins);
  }
  if (k == ssa.CALL_IND || k == ssa.DYN_DISPATCH) {
    return touch_all(t, w, ins.args);
  }
  return t;
}

function touches(w: Walk, null_taken: boolean[]): boolean[] {
  let t = Touch { touched: null_taken };
  let hands_out = w.self_abi.result_unit || w.self_abi.pair_first || w.self_abi.result_word;
  for b in w.f.blocks {
    for ins in b.insts {
      t = touch_inst(t, w, ins);
    }
    if (b.term.kind_tag == ssa.TERM_RET && b.term.value >= 0 && hands_out) {
      t = touch(t, w, b.term.value);
    }
  }
  return t.touched;
}

function null_takes(w: Walk, takes: Takes): boolean[] {
  let out = __alloc_bool(w.f.nvals);
  for rs in takes.roots {
    for r in rs {
      out = out.with(r, true);
    }
  }
  return out;
}

function is_take(w: Walk, st: ssa.SInst): boolean {
  return (st.kind_tag == ssa.ST_AT || st.kind_tag == ssa.ARR_ST) && st.args.len() >= 2 && zero_at(w, st.args[st.args.len() - 1]);
}

function is_reused(w: Walk, v: i32): boolean {
  return v >= 0 && v < w.reused.len() && w.reused[v];
}

function matches_store(w: Walk, ld: ssa.SInst, st: ssa.SInst): boolean {
  if (ld.args.len() == 0 || w.root[ld.args[0]] != w.root[st.args[0]]) {
    return false;
  }
  // A reused box has the root of the box it replaces, and a slot of one is not a slot of the other.
  if (is_reused(w, ld.args[0]) != is_reused(w, st.args[0])) {
    return false;
  }
  if (st.kind_tag == ssa.ST_AT) {
    return ld.kind_tag == ssa.LD_AT && ld.imm == st.imm;
  }
  return ld.kind_tag == ssa.ARR_AT && ld.args.len() >= 2 && st.args.len() >= 3 && w.root[ld.args[1]] == w.root[st.args[1]];
}

function taken_root(w: Walk, dom: ssadeps.Dom, after: boolean[], sb: i32, si: i32, st: ssa.SInst): i32 {
  let pick = pick_loads(w, dom, after, Picked { used: -1, any: -1 }, sb, si, sb, si, st);
  let lb = sb;
  while (dom.idom[lb] >= 0 && dom.idom[lb] != lb) {
    lb = dom.idom[lb];
    pick = pick_loads(w, dom, after, pick, lb, w.f.blocks[lb].insts.len(), sb, si, st);
  }
  if (pick.used >= 0) {
    return w.root[pick.used];
  }
  if (pick.any >= 0) {
    return w.root[pick.any];
  }
  return -1;
}

struct Picked { used: i32, any: i32 }

function pick_loads(w: Walk, dom: ssadeps.Dom, after0: boolean[], own pick: Picked, lb: i32, stop: i32, sb: i32, si: i32, st: ssa.SInst): Picked {
  let after = after0;
  let avoided = !after0[lb];
  for li in 0..stop {
    let ld = w.f.blocks[lb].insts[li];
    if (is_load(ld) && ld.result >= 0 && ld.result < w.f.nvals && matches_store(w, ld, st)) {
      pick = Picked { ...pick, any: nearer(w, dom, sb, pick.any, ld.result) };
      if (!avoided) {
        after = reached_avoiding(w, sb, lb);
        avoided = true;
      }
      if (used_after(w, after, w.root[ld.result], sb, si)) {
        pick = Picked { ...pick, used: nearer(w, dom, sb, pick.used, ld.result) };
      }
    }
  }
  return pick;
}

function nearer(w: Walk, dom: ssadeps.Dom, sb: i32, a: i32, b: i32): i32 {
  if (a < 0) {
    return b;
  }
  let ba = w.defs.block[a];
  let bb = w.defs.block[b];
  if (ba == bb) {
    if (w.defs.at[b] > w.defs.at[a]) {
      return b;
    }
    return a;
  }
  if (bb == sb || ba != sb && dom.pre[bb] > dom.pre[ba]) {
    return b;
  }
  return a;
}

function used_after(w: Walk, after: boolean[], root: i32, sb: i32, si: i32): boolean {
  for bi in 0..w.f.blocks.len() {
    if (bi == sb || after[bi]) {
      let from = 0;
      if (bi == sb && !after[bi]) {
        from = si + 1;
      }
      if (reads_root(w, bi, from, root)) {
        return true;
      }
    }
  }
  return false;
}

function reads_root(w: Walk, bi: i32, from: i32, root: i32): boolean {
  let insts = w.f.blocks[bi].insts;
  for i in from..insts.len() {
    for a in insts[i].args {
      if (a >= 0 && w.root[a] == root) {
        return true;
      }
    }
  }
  let t = w.f.blocks[bi].term;
  return t.value >= 0 && w.root[t.value] == root;
}

function reached_from(w: Walk, sb: i32): boolean[] {
  return reached_in(w.f, w.at, sb, -1);
}

function reached_avoiding(w: Walk, sb: i32, avoid: i32): boolean[] {
  return reached_in(w.f, w.at, sb, avoid);
}

function reached_in(f: ssa.SFunc, at: i32[], sb: i32, avoid: i32): boolean[] {
  let n = f.blocks.len();
  let seen = __alloc_bool(n);
  let work: i32[] = [sb];
  let i = 0;
  while (i < work.len()) {
    let t = f.blocks[work[i]].term;
    for e in 0..2 {
      let sid = ssa.successor_id(t, e);
      if (sid >= 0 && at[sid] >= 0 && at[sid] != avoid && !seen[at[sid]]) {
        seen = seen.with(at[sid], true);
        work = work.append(at[sid]);
      }
    }
    i += 1;
  }
  return seen;
}

function tracked_root(w: Walk, touched: boolean[], v: i32): boolean {
  if (w.root[v] != v) {
    return false;
  }
  let o = w.origin[v];
  if (o == org_fresh() || o == org_transferred() || o == org_child() || o == org_unknown()) {
    return true;
  }
  return o != org_none() && touched[v];
}

// The values that a return can spend, also when the contract of the function
// does not say that it hands out a unit.
function returned_roots(w: Walk): boolean[] {
  let out = __alloc_bool(w.f.nvals);
  for b in w.f.blocks {
    if (b.term.kind_tag == ssa.TERM_RET && b.term.value >= 0 && b.term.value < w.root.len()) {
      out = out.with(w.root[b.term.value], true);
    }
    for ins in b.insts {
      if (is_named_op(ins.kind_tag) && ins.str == "ret_word") {
        for a in ins.args {
          if (a >= 0 && a < w.root.len()) {
            out = out.with(w.root[a], true);
          }
        }
      }
    }
  }
  return out;
}

// The phis that an operation touches or a return takes, and the phis that
// feed them. Nothing can spend a unit of another phi, so that phi holds none:
// each of its inputs keeps its units.
function spent_phis(w: Walk, touched: boolean[]): boolean[] {
  let out = __alloc_bool(w.f.nvals);
  let returned = returned_roots(w);
  for v in w.phis {
    out = out.with(v, touched[w.root[v]] || returned[w.root[v]]);
  }
  let grown = true;
  while (grown) {
    grown = false;
    for v in w.phis {
      if (!out[v]) {
        continue;
      }
      for a in def_at(w, v).args {
        if (a >= 0 && !w.derived[a] && !out[w.root[a]] && def_at(w, w.root[a]).kind_tag == ssa.PHI) {
          out = out.with(w.root[a], true);
          grown = true;
        }
      }
    }
  }
  return out;
}

function grow_phis(w: Walk, own on: boolean[], spent: boolean[]): boolean[] {
  let grown = true;
  while (grown) {
    grown = false;
    for b in w.f.blocks {
      for ins in b.insts {
        if (ins.kind_tag == ssa.PHI && ins.result >= 0 && !on[ins.result] && spent[ins.result] && any_on(w, on, ins.args)) {
          on = on.with(ins.result, true);
          grown = true;
        }
      }
    }
  }
  return on;
}

function any_on(w: Walk, on: boolean[], args: i32[]): boolean {
  for a in args {
    if (a >= 0 && !w.derived[a] && on[w.root[a]]) {
      return true;
    }
  }
  return false;
}

function indexes(w: Walk, touched: boolean[]): i32[] {
  let f = w.f;
  let on = __alloc_bool(f.nvals);
  let v = 0;
  while (v < f.nvals) {
    on = on.with(v, tracked_root(w, touched, v));
    v += 1;
  }
  on = grow_phis(w, on, spent_phis(w, touched));
  let idx = util.minus_ones(f.nvals);
  let n = 0;
  for v in 0..f.nvals {
    if (on[v]) {
      idx = idx.with(v, n);
      n += 1;
    }
  }
  return idx;
}

struct Live {
  ok: boolean,
  why: string,
  slots: i32[],
  in_at: i32[],
  in_n: i32[],
  row_at: i32[],
  row_n: i32[],
  die_at: i32[],
  die_n: i32[],
  out_at: i32[],
  nout: i32,
}

function alias_deps(w: Walk): i32[][] {
  let deps: i32[][] = [];
  for v in 0..w.f.nvals {
    if (w.root[v] != v) {
      deps = deps.append([w.root[v]]);
    } else {
      deps = deps.append([]);
    }
  }
  return deps;
}

struct Marked { mark: boolean[], list: i32[] }

function add_slot(own m: Marked, k: i32): Marked {
  if (k < 0 || m.mark[k]) {
    return m;
  }
  return Marked { mark: m.mark.with(k, true), list: m.list.append(k) };
}

function add_value(own m: Marked, w: Walk, v: i32): Marked {
  if (v < 0) {
    return m;
  }
  return add_slot(m, w.idx[w.root[v]]);
}

function clear_marks(own m: Marked): Marked {
  for k in m.list {
    m = Marked { ...m, mark: m.mark.with(k, false) };
  }
  return Marked { mark: m.mark, list: [] };
}

function in_slots(w: Walk, fl: ssalive.Flow, own m: Marked, bi: i32): Marked {
  let ids = ssalive.live_in_ids(fl, bi);
  for v in ids {
    m = add_value(m, w, v);
  }
  return m;
}

function row_slots(w: Walk, takes: Takes, own m: Marked, bi: i32): Marked {
  let b = w.f.blocks[bi];
  if (bi == w.at[w.f.entry]) {
    for v in 0..w.f.nparams {
      m = add_value(m, w, v);
    }
  }
  for ins in b.insts {
    m = add_value(m, w, ins.result);
  }
  let i = takes.first[bi];
  while (i >= 0 && i < takes.block.len() && takes.block[i] == bi) {
    for r in takes.roots[i] {
      m = add_slot(m, w.idx[r]);
    }
    i += 1;
  }
  return m;
}

struct Spans { slots: i32[], at: i32[], n: i32[] }

function push_span(own sp: Spans, list: i32[]): Spans {
  let at = sp.slots.len();
  let slots = sp.slots;
  for k in list {
    slots = slots.append(k);
  }
  return Spans { slots: slots, at: sp.at.append(at), n: sp.n.append(list.len()) };
}

function die_slots(lv: Live, own m: Marked, bi: i32, si: i32): Marked {
  let j = 0;
  while (j < lv.in_n[si]) {
    m = Marked { ...m, mark: m.mark.with(lv.slots[lv.in_at[si] + j], true) };
    j += 1;
  }
  let dies: i32[] = [];
  j = 0;
  while (j < lv.row_n[bi]) {
    let k = lv.slots[lv.row_at[bi] + j];
    if (!m.mark[k]) {
      dies = dies.append(k);
    }
    j += 1;
  }
  j = 0;
  while (j < lv.in_n[si]) {
    m = Marked { ...m, mark: m.mark.with(lv.slots[lv.in_at[si] + j], false) };
    j += 1;
  }
  return Marked { mark: m.mark, list: dies };
}

function no_live(why: string): Live {
  return Live { ok: false, why: why, slots: [], in_at: [], in_n: [], row_at: [], row_n: [], die_at: [], die_n: [], out_at: [], nout: 0 };
}

function live_rows(w: Walk, fl: ssalive.Flow, takes: Takes): Live {
  let m = Marked { mark: __alloc_bool(w.tracked), list: [] };
  let ins = Spans { slots: [], at: [], n: [] };
  let rows = Spans { slots: [], at: [], n: [] };
  for bi in 0..w.f.blocks.len() {
    m = in_slots(w, fl, m, bi);
    ins = push_span(ins, m.list);
    m = row_slots(w, takes, m, bi);
    rows = push_span(rows, m.list);
    m = clear_marks(m);
  }
  let slots = ins.slots;
  let shift = slots.len();
  for k in rows.slots {
    slots = slots.append(k);
  }
  let row_at: i32[] = [];
  for at in rows.at {
    row_at = row_at.append(at + shift);
  }
  return Live { ok: true, why: "", slots: slots, in_at: ins.at, in_n: ins.n, row_at: row_at, row_n: rows.n, die_at: [], die_n: [], out_at: [], nout: 0 };
}

function live_edges(w: Walk, own lv: Live): Live {
  let m = Marked { mark: __alloc_bool(w.tracked), list: [] };
  let dies = Spans { slots: lv.slots, at: [], n: [] };
  let out_at: i32[] = [];
  let nout = 0;
  let doomed = doomed_blocks(w);
  for bi in 0..w.f.blocks.len() {
    for e in 0..2 {
      let sid = ssa.successor_id(w.f.blocks[bi].term, e);
      let si = -1;
      if (sid >= 0) {
        si = w.at[sid];
      }
      if (si >= 0 && doomed[si]) {
        dies = push_span(dies, []);
        out_at = out_at.append(nout);
        nout += lv.in_n[si];
      } else if (si >= 0) {
        m = die_slots(lv, m, bi, si);
        dies = push_span(dies, m.list);
        out_at = out_at.append(nout);
        nout += lv.in_n[si];
      } else {
        dies = push_span(dies, []);
        out_at = out_at.append(-1);
      }
    }
  }
  return Live { ...lv, slots: dies.slots, die_at: dies.at, die_n: dies.n, out_at: out_at, nout: nout };
}

// The blocks whose every path ends at an unreachable terminator, such as a
// call of exit. Nothing has to be released on the way, so no value dies
// on an edge into one. A loop that never ends is not in the set.
function doomed_blocks(w: Walk): boolean[] {
  let n = w.f.blocks.len();
  let doomed = __alloc_bool(n);
  let changed = true;
  while (changed) {
    changed = false;
    let bi = n - 1;
    while (bi >= 0) {
      if (!doomed[bi] && ends_doomed(w, doomed, w.f.blocks[bi].term)) {
        doomed = doomed.with(bi, true);
        changed = true;
      }
      bi -= 1;
    }
  }
  return doomed;
}

function ends_doomed(w: Walk, doomed: boolean[], t: ssa.STerm): boolean {
  if (t.kind_tag == ssa.TERM_UNREACHABLE) {
    return true;
  }
  let any = false;
  for e in 0..2 {
    let sid = ssa.successor_id(t, e);
    if (sid >= 0) {
      if (w.at[sid] < 0 || !doomed[w.at[sid]]) {
        return false;
      }
      any = true;
    }
  }
  return any;
}

function debt_deps(w: Walk, takes: Takes, own deps: i32[][]): i32[][] {
  if (w.debt.len() == 0) {
    return deps;
  }
  for k in 0..takes.block.len() {
    let st = w.f.blocks[takes.block[k]].insts[takes.at[k]];
    let zero = st.args[st.args.len() - 1];
    for r in takes.roots[k] {
      if (in_debt(w, r) && zero >= 0 && zero < deps.len() && defined_before(w, r, zero)) {
        deps = deps.with(zero, deps[zero].append(r));
      }
    }
  }
  return deps;
}

function defined_before(w: Walk, a: i32, b: i32): boolean {
  let ab = w.defs.block[a];
  let bb = w.defs.block[b];
  if (ab < 0 || bb < 0) {
    return false;
  }
  if (ab == bb) {
    return w.defs.at[a] < w.defs.at[b];
  }
  return ssadeps.dom_holds(w.dom, bb, ab);
}

function tracked_values(w: Walk): boolean[] {
  let out = __alloc_bool(w.f.nvals);
  let v = 0;
  while (v < w.f.nvals && v < w.root.len()) {
    let r = w.root[v];
    if (r >= 0 && r < w.idx.len() && w.idx[r] >= 0) {
      out = out.with(v, true);
    }
    v += 1;
  }
  return out;
}

function live_of(w: Walk, takes: Takes): Live {
  let fl = ssalive.compute_kept_with_sites(w.f, debt_deps(w, takes, alias_deps(w)), tracked_values(w), w.at, w.defs);
  if (!fl.ok) {
    return no_live(fl.why);
  }
  return live_edges(w, live_rows(w, fl, takes));
}

struct Progress { out: i32[], done: boolean[], dead: boolean[], phi_at: i32[], phin: i32[], state: i32[], findings: Finding[], opaque: string[], unproved: boolean[], maybe_at: i32[], ulog: i32[], mlog: i32[], keyed: boolean[], condkey: boolean[] }

function filled(n: i32, v: i32): i32[] {
  let out = __alloc_i32(n);
  if (v == 0) {
    return out;
  }
  for i in 0..n {
    out = out.with(i, v);
  }
  return out;
}

function kind_of(w: Walk, v: i32): string {
  if (v < w.f.nparams) {
    return "param";
  }
  return ssa.kind_name(def_in(w, v).kind_tag);
}

function child_why(w: Walk, root: i32): string {
  if (root >= w.why.len() || w.origin[root] != org_child()) {
    return "";
  }
  if (w.why[root] == 1) {
    if (root < w.opened.len() && w.opened[root] >= 0) {
      return " in a unique region opened at b" + util.i32_to_string(w.opened[root]);
    }
    return " of a children-only drop's box";
  }
  if (w.why[root] == 2) {
    return " of an overwritten slot";
  }
  return " of a shell";
}

function found(own p: Progress, w: Walk, kind: string, root: i32, block: i32, message: string): Progress {
  let x = Finding { kind: kind, value: root, block: block, defined: origin_name(w.origin[root]) + " " + kind_of(w, root) + child_why(w, root), message: message };
  return Progress { ...p, findings: p.findings.append(x) };
}

function spend(own p: Progress, w: Walk, v: i32, block: i32, what: string): Progress {
  let k = w.idx[w.root[v]];
  if (k < 0) {
    return p;
  }
  let before = p.state[k];
  return one_sided(spend_count(p, w, v, block, what), k, before);
}

function spend_count(own p: Progress, w: Walk, v: i32, block: i32, what: string): Progress {
  let r = w.root[v];
  let k = w.idx[r];
  if (k < 0) {
    return p;
  }
  p = settled(p, k);
  let s = p.state[k];
  if (s == maybe() || s == free()) {
    return p;
  }
  if (s == absent()) {
    return Progress { ...p, state: p.state.with(k, maybe()) };
  }
  if (s >= free_or(0)) {
    if (s > free_or(0)) {
      return Progress { ...p, state: p.state.with(k, s - 1) };
    }
    if (in_debt(w, r)) {
      return Progress { ...p, state: p.state.with(k, maybe()) };
    }
    return found(p, w, "spent without a unit", r, block, what);
  }
  if (s == 0 && in_debt(w, r)) {
    return Progress { ...p, state: p.state.with(k, owed()) };
  }
  if (s == 0 || s == owed()) {
    return found(p, w, "spent without a unit", r, block, what);
  }
  return Progress { ...p, state: p.state.with(k, s - 1) };
}

function spend_counted(own p: Progress, w: Walk, v: i32, block: i32, what: string): Progress {
  let r = w.root[v];
  if (w.idx[r] < 0 && w.origin[r] == org_none() && r >= w.f.nparams) {
    let k = def_in(w, r).kind_tag;
    if (is_named_op(k)) {
      return found(p, w, "spent a word nothing counts", r, block, what);
    }
  }
  return spend(p, w, v, block, what);
}

function spend_if_held(own p: Progress, w: Walk, v: i32): Progress {
  let k = w.idx[w.root[v]];
  if (k < 0) {
    return p;
  }
  let before = p.state[k];
  if (is_twin(before)) {
    let o = twin_key(before);
    return Progress { ...p, state: p.state.with(k, twin(o, held_after_move(twin_same(before)), held_after_move(twin_apart(before)))) };
  }
  return one_sided(spend_held_count(p, w, v), k, before);
}

// The units of one side of a twin after a move of a unit if it holds one.
function held_after_move(side: i32): i32 {
  if (side == no_side() || side == 0) {
    return side;
  }
  return side - 1;
}

function spend_held_count(own p: Progress, w: Walk, v: i32): Progress {
  let k = w.idx[w.root[v]];
  if (k < 0) {
    return p;
  }
  p = settled(p, k);
  if (units(p.state[k]) <= 0) {
    return p;
  }
  return Progress { ...p, state: p.state.with(k, p.state[k] - 1) };
}

function retain(own p: Progress, w: Walk, v: i32, result: i32): Progress {
  let k = w.idx[w.root[v]];
  if (k < 0) {
    return p;
  }
  let before = p.state[k];
  return one_sided(retain_count(p, w, v, result), k, before);
}

// A twin with one side is exact: a spend or a retain changes the count of
// that side, and the twin keeps what it knows about the box.
function one_sided(own p: Progress, k: i32, before: i32): Progress {
  let c = p.state[k];
  if (!is_twin(before) || is_twin(c) || c < 0 || c > cap()) {
    return p;
  }
  if (twin_same(before) == no_side()) {
    return Progress { ...p, state: p.state.with(k, twin(twin_key(before), no_side(), c)) };
  }
  if (twin_apart(before) == no_side()) {
    return Progress { ...p, state: p.state.with(k, twin(twin_key(before), c, no_side())) };
  }
  return p;
}

function retain_count(own p: Progress, w: Walk, v: i32, result: i32): Progress {
  let r = w.root[v];
  let k = w.idx[r];
  if (k < 0) {
    return p;
  }
  if (result >= 0 && w.uses[result] == 0 && w.uses[v] == 1 && w.origin[r] == org_borrowed() && owned_base(w, r)) {
    return p;
  }
  p = settled(p, k);
  let s = p.state[k];
  if (s == maybe() || s == free()) {
    return p;
  }
  if (s == owed()) {
    return Progress { ...p, state: p.state.with(k, 0) };
  }
  if (s >= free_or(0)) {
    return Progress { ...p, state: p.state.with(k, holding(units(s) + 1, true)) };
  }
  if (s == absent() || s + 1 > cap()) {
    return Progress { ...p, state: p.state.with(k, maybe()) };
  }
  return Progress { ...p, state: p.state.with(k, s + 1) };
}

function owned_base(w: Walk, v: i32): boolean {
  let d = def_in(w, v);
  if (!is_load(d) || d.args.len() == 0) {
    return false;
  }
  let o = w.origin[w.root[d.args[0]]];
  return o == org_fresh() || o == org_transferred() || o == org_child();
}

// A twin read as a plain count, before a use that only a count describes.
function settled(own p: Progress, k: i32): Progress {
  if (is_twin(p.state[k])) {
    return Progress { ...p, state: p.state.with(k, flat(p.state[k])) };
  }
  return p;
}

function poison(own p: Progress, w: Walk, v: i32): Progress {
  let k = w.idx[w.root[v]];
  if (k < 0) {
    return p;
  }
  return Progress { ...p, state: p.state.with(k, maybe()) };
}

function poison_all(own p: Progress, w: Walk, args: i32[]): Progress {
  for a in args {
    p = poison(p, w, a);
  }
  return p;
}

function define(own p: Progress, w: Walk, v: i32, block: i32): Progress {
  if (v < 0 || w.root[v] != v) {
    return p;
  }
  let k = w.idx[v];
  if (k < 0) {
    return p;
  }
  if (units(flat(p.state[k])) > 0) {
    p = found(p, w, "redefined while held", v, block, "the previous value's unit was never spent");
  }
  p = forget_key(p, v);
  if (v < w.token_loads.len() && w.token_loads[v] != absent()) {
    return Progress { ...p, state: p.state.with(k, w.token_loads[v]) };
  }
  return Progress { ...p, state: p.state.with(k, initial_count(w.origin[v])) };
}

function apply_sig(own p: Progress, w: Walk, ins: ssa.SInst, block: i32, s: rcsigs.Sig): Progress {
  if (s.arg >= 0 && s.arg < ins.args.len()) {
    p = apply_effect(p, w, ins, block, s.effect, ins.args[s.arg]);
  }
  for i in s.also {
    if (i < ins.args.len()) {
      p = spend(p, w, ins.args[i], block, "moved into " + ins.str);
    }
  }
  for i in s.unsure {
    if (i < ins.args.len()) {
      p = poison(p, w, ins.args[i]);
    }
  }
  return p;
}

function apply_effect(own p: Progress, w: Walk, ins: ssa.SInst, block: i32, effect: i32, v: i32): Progress {
  if (effect == rcsigs.effect_retain()) {
    return retain(p, w, v, ins.result);
  }
  if (effect == rcsigs.effect_release() || effect == rcsigs.effect_move()) {
    return spend_counted(p, w, v, block, "released by " + ins.str);
  }
  if (effect == rcsigs.effect_move_if_held()) {
    return spend_if_held(p, w, v);
  }
  if (effect == rcsigs.effect_unsure()) {
    return poison(p, w, v);
  }
  return p;
}

function apply_call(own p: Progress, w: Walk, ins: ssa.SInst, block: i32): Progress {
  let s = w.sigs.lookup(ins.str);
  if (s.known) {
    p = apply_sig(p, w, ins, block, s);
    return define(p, w, ins.result, block);
  }
  let a = w.abis.lookup(ins.str);
  if (!a.known) {
    p = poison_all(p, w, ins.args);
    p = Progress { ...p, opaque: p.opaque.append(ins.str) };
    return define(p, w, ins.result, block);
  }
  let i = 0;
  while (i < ins.args.len() && i < a.modes.len()) {
    if (a.modes[i] == counted_mode()) {
      p = spend(p, w, ins.args[i], block, "moved into " + ins.str);
    }
    i += 1;
  }
  return define(p, w, ins.result, block);
}

function apply_ret_word(own p: Progress, w: Walk, ins: ssa.SInst, block: i32): Progress {
  let mask = word_mask(w.self_abi, word_slot(w, ins), false);
  if (second_holds(mask)) {
    return spend(p, w, ins.args[0], block, "returned as a pair word");
  }
  if (mask == -2) {
    return spend_if_held(p, w, ins.args[0]);
  }
  return p;
}

function apply_op_row(own p: Progress, w: Walk, ins: ssa.SInst, block: i32, s: rcsigs.Sig): Progress {
  if (rcsigs.boxes_operands(ins.str)) {
    for a in ins.args {
      p = spend(p, w, a, block, "boxed by " + ins.str);
    }
  } else if (rcsigs.pushes_element(ins.str) && ins.args.len() > 0) {
    p = spend(p, w, ins.args[ins.args.len() - 1], block, "pushed by " + ins.str);
  }
  if (s.arg < 0 || s.arg >= ins.args.len()) {
    return p;
  }
  if (s.effect == rcsigs.effect_release() || s.effect == rcsigs.effect_move()) {
    return spend_counted(p, w, ins.args[s.arg], block, "consumed by " + ins.str);
  }
  if (s.effect == rcsigs.effect_move_if_held()) {
    return spend_if_held(p, w, ins.args[s.arg]);
  }
  return p;
}

function apply_named_op(own p: Progress, w: Walk, ins: ssa.SInst, block: i32): Progress {
  if (ins.str == "ret_word" && ins.args.len() == 1) {
    return apply_ret_word(p, w, ins, block);
  }
  let s = w.ops.op_lookup(ins.str);
  let operand = -2;
  if (rcsigs.pushes_element(ins.str) && ins.args.len() > 0 && ins.args[0] >= 0) {
    operand = 0;
    let ko = w.idx[w.root[ins.args[0]]];
    if (ko >= 0) {
      operand = p.state[ko];
    }
  }
  if (s.known) {
    p = apply_op_row(p, w, ins, block, s);
  }
  p = define(p, w, ins.result, block);
  if (operand != -2) {
    p = push_twin(p, w, ins, s, operand, block);
  }
  return p;
}

// A push grows its array in place and returns it, or returns a new box.
// Pushed onto a parameter, or onto a value that is a parameter's box, the
// result holds no unit of its own if it is that box, and one if it is new.
// An owned push onto a value that is not that box gives a value that is not.
function push_twin(own p: Progress, w: Walk, ins: ssa.SInst, s: rcsigs.Sig, operand: i32, block: i32): Progress {
  if (ins.result < 0) {
    return p;
  }
  let kr = w.idx[w.root[ins.result]];
  let r = w.root[ins.args[0]];
  let ko = w.idx[r];
  if (kr < 0 || kr == ko) {
    return p;
  }
  if (s.known && s.effect == rcsigs.effect_move()) {
    if (is_twin(operand) && twin_same(operand) == no_side() && p.state[kr] == 1) {
      return Progress { ...p, state: p.state.with(kr, twin(twin_key(operand), no_side(), 1)) };
    }
    return p;
  }
  if (!s.known || s.effect != rcsigs.effect_none() || s.result != rcsigs.result_unknown()) {
    return p;
  }
  if (first_on_shared_arm(w, block, r, ins.result)) {
    return Progress { ...p, state: p.state.with(kr, 1) };
  }
  let target = -1;
  if (is_twin(operand) && twin_apart(operand) == no_side() && box_key(p, w, twin_key(operand))) {
    target = twin_key(operand);
  } else if (box_key(p, w, r)) {
    target = r;
  }
  if (target < 0) {
    return p;
  }
  p = keyed(p, target);
  return Progress { ...p, state: p.state.with(kr, twin(target, 0, 1)) };
}

function apply_store(own p: Progress, w: Walk, ins: ssa.SInst, block: i32, taken: i32[]): Progress {
  let val = ins.args[ins.args.len() - 1];
  if (w.held >= 0 && put_back(w, ins, val)) {
    return p;
  }
  // An address into a box is a word: storing it hands on no unit.
  if (val >= 0 && val < w.derived.len() && w.derived[val]) {
    return p;
  }
  if (zero_at(w, val)) {
    for r in taken {
      let kn = named_box(p, r);
      if (kn >= 0) {
        let s = p.state[kn];
        p = Progress { ...p, state: p.state.with(kn, twin(twin_key(s), twin_same(s) + 1, no_side())) };
        continue;
      }
      // The unit goes to a live token of the box when the token is the box,
      // and to the box when the token is zero.
      let tok = live_token_of(p, w, r);
      if (tok >= 0) {
        let kt = w.idx[tok];
        let kb = w.idx[r];
        let st = p.state[kt];
        let sb = p.state[kb];
        if (st >= 0 && st < cap() && sb >= 0 && sb < cap()) {
          p = Progress { ...p, state: p.state.with(kb, twin(tok, sb, sb + 1)).with(kt, twin(tok, st + 1, st)) };
          continue;
        }
      }
      let k = w.idx[r];
      if (k >= 0 && flat(p.state[k]) != maybe()) {
        let s = flat(p.state[k]);
        if (s == owed()) {
          p = Progress { ...p, state: p.state.with(k, 0) };
        } else if (s == absent() || is_free(s) || s + 1 > cap()) {
          p = Progress { ...p, state: p.state.with(k, maybe()) };
        } else {
          p = Progress { ...p, state: p.state.with(k, s + 1) };
        }
      }
    }
    return p;
  }
  return spend(p, w, val, block, "stored into a box");
}

function put_back(w: Walk, st: ssa.SInst, val: i32): boolean {
  if (st.kind_tag != ssa.ST_AT || val < 0 || val >= w.kept.len() || !w.kept[w.root[val]] || st.args.len() < 2 || w.root[st.args[0]] != w.held) {
    return false;
  }
  return def_in(w, w.root[val]).imm == st.imm;
}

function put_backs(w: Walk, st: Stores, dom: ssadeps.Dom): boolean[] {
  if (w.held < 0) {
    return [];
  }
  let out = __alloc_bool(w.f.nvals);
  let refused = __alloc_bool(w.f.nvals);
  for k in 0..st.base.len() {
    let ins = w.f.blocks[st.block[k]].insts[st.at[k]];
    if (st.base[k] == w.held && ins.kind_tag == ssa.ST_AT && !st.zero[k]) {
      let val = w.root[ins.args[ins.args.len() - 1]];
      let ld = def_in(w, val);
      let lb = w.defs.block[val];
      if (ld.kind_tag == ssa.LD_AT && ld.args.len() > 0 && ld.imm == ins.imm && w.root[ld.args[0]] == w.held && lb >= 0 && w.origin[val] == org_borrowed()) {
        if ((lb == st.block[k] && w.defs.at[val] < st.at[k] || ssadeps.dom_holds(dom, st.block[k], lb))
          && !between(w, dom, ld, lb, w.defs.at[val], st.block[k], st.at[k])) {
          out = out.with(val, true);
        } else {
          refused = refused.with(val, true);
        }
      }
    }
  }
  let v = 0;
  while (v < out.len()) {
    if (refused[v]) {
      out = out.with(v, false);
    }
    v += 1;
  }
  return out;
}

function apply(own p: Progress, w: Walk, ins: ssa.SInst, block: i32, taken: i32[]): Progress {
  let k = ins.kind_tag;
  if (k == ssa.CALL) {
    return apply_call(p, w, ins, block);
  }
  if (is_named_op(k)) {
    return apply_named_op(p, w, ins, block);
  }
  if (is_store(k) && ins.args.len() >= 2) {
    return apply_store(p, w, ins, block, taken);
  }
  if (k == ssa.CALL_IND || k == ssa.DYN_DISPATCH) {
    return apply_indirect(p, w, ins, block);
  }
  return define(p, w, ins.result, block);
}

// The contract of a call through a function value (ir.call_units), or -1.
// The lift puts the target first, so the operand j of the contract is the
// argument j + 1. A call that ssa.slot_calls rewrote keeps the contract after
// "slot:".
function indirect_units(ins: ssa.SInst): i32 {
  if (ins.kind_tag != ssa.CALL_IND) {
    return -1;
  }
  let text = ins.str;
  if (text.starts_with("slot:")) {
    text = slice_unchecked(text, 5, text.len()).to_owned();
  }
  if (text.len() == 0 || !util.is_all_digits(text)) {
    return -1;
  }
  return util.digits_to_i32(text);
}

function apply_indirect(own p: Progress, w: Walk, ins: ssa.SInst, block: i32): Progress {
  let units = indirect_units(ins);
  if (units < 0) {
    p = poison_all(p, w, ins.args);
    return define(p, w, ins.result, block);
  }
  for i in 1..ins.args.len() {
    let bit = 1 << i - 1;
    let handed = units & bit;
    if (handed != 0) {
      p = spend(p, w, ins.args[i], block, "moved into a call through a function value");
    }
  }
  return define(p, w, ins.result, block);
}

struct Takes { block: i32[], at: i32[], roots: i32[][], first: i32[] }

function no_takes(): Takes {
  return Takes { block: [], at: [], roots: [], first: [] };
}

function takes_of(w: Walk, dom: ssadeps.Dom): Takes {
  let out = Takes { block: [], at: [], roots: [], first: util.minus_ones(w.f.blocks.len()) };
  for sb in 0..w.f.blocks.len() {
    out = block_takes(out, w, dom, sb);
  }
  return out;
}

function block_takes(own out: Takes, w: Walk, dom: ssadeps.Dom, sb: i32): Takes {
  let insts = w.f.blocks[sb].insts;
  let after: boolean[] = [];
  for si in 0..insts.len() {
    let st = insts[si];
    if (is_take(w, st)) {
      if (after.len() == 0) {
        after = reached_from(w, sb);
      }
      let r = taken_root(w, dom, after, sb, si, st);
      let rs: i32[] = [];
      if (r >= 0) {
        rs = rs.append(r);
      }
      let first = out.first;
      if (first[sb] < 0) {
        first = first.with(sb, out.block.len());
      }
      out = Takes { block: out.block.append(sb), at: out.at.append(si), roots: out.roots.append(rs), first: first };
    }
  }
  return out;
}

function taken_at(t: Takes, block: i32, at: i32): i32[] {
  let i = t.first[block];
  while (i >= 0 && i < t.block.len() && t.block[i] == block) {
    if (t.at[i] == at) {
      return t.roots[i];
    }
    i += 1;
  }
  return [];
}

function exits(b: ssa.SBlock): boolean {
  for ins in b.insts {
    if (is_exit(ins)) {
      return true;
    }
  }
  return false;
}

function is_exit(ins: ssa.SInst): boolean {
  return ins.kind_tag == ssa.RT_CALL && ins.str == "exit";
}

// A block that calls exit leaves the process, so no path goes on from it,
// and a block that only such a path reached is gone.
function ended_at_exit(f: ssa.SFunc): ssa.SFunc {
  let blocks: ssa.SBlock[] = [];
  let cut = false;
  for b in f.blocks {
    if (b.term.kind_tag != ssa.TERM_UNREACHABLE && exits(b)) {
      blocks = blocks.append(ssa.SBlock { ...b, term: ssa.STerm { kind_tag: ssa.TERM_UNREACHABLE, cond: 0, target: 0, t: 0, f: 0, value: 0 } });
      cut = true;
    } else {
      blocks = blocks.append(b);
    }
  }
  if (!cut) {
    return f;
  }
  let g = ssa.SFunc { ...f, blocks: blocks };
  let live = ssadeps.reachable_blocks(g);
  let kept: ssa.SBlock[] = [];
  for i in 0..blocks.len() {
    if (live[i]) {
      kept = kept.append(blocks[i]);
    }
  }
  let h = ssa.SFunc { ...g, blocks: kept };
  return ssa.SFunc { ...h, blocks: ssa.refreshed_preds(h) };
}

function entry_row(own p: Progress, w: Walk, lv: Live, bi: i32): Progress {
  let b = w.f.blocks[bi];
  let bases: i32[] = [];
  for pid in b.preds {
    let pb = w.at[pid];
    if (edge_live(p, w, pb, b.id)) {
      bases = bases.append(edge_base(w, lv, pb, b.id));
    }
  }
  let sides = edge_sides(w, b, bases.len(), p);
  let c = join_key(w, bi);
  let j = 0;
  while (j < lv.in_n[bi]) {
    let s = absent();
    for base in bases {
      s = meet(s, p.out[base + j]);
    }
    if (s == maybe() && sides.len() == bases.len() && c >= 0) {
      let t = side_twin(p, bases, sides, j, c);
      if (t != maybe()) {
        s = t;
        p = cond_key(p, c);
      }
    }
    let k = lv.slots[lv.in_at[bi] + j];
    if (s == maybe()) {
      p = met_maybe(p, k, bi);
    }
    p = Progress { ...p, state: p.state.with(k, s) };
    j += 1;
  }
  return p;
}

// The word that the immediate dominator of block `bi` tests, if its two
// arms reach the block apart. -1 if there is none, or if the word keys
// twins of another kind.
function join_key(w: Walk, bi: i32): i32 {
  let d = w.dom.idom[bi];
  if (d < 0 || d == bi) {
    return -1;
  }
  let t = w.f.blocks[d].term;
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f) {
    return -1;
  }
  let ts = tested(w, t.cond);
  if (ts.word < 0 || w.derived[ts.word]) {
    return -1;
  }
  let c = w.root[ts.word];
  if (c < w.f.nparams || token_key(w, c)) {
    return -1;
  }
  return c;
}

// For each edge into `b` that entry_row meets, in the same order: 1 if the
// edge comes from the arm of the test of the immediate dominator where the
// word is not zero, 0 if from the other arm. Empty if an edge is in neither
// arm alone.
function edge_sides(w: Walk, b: ssa.SBlock, n: i32, p: Progress): i32[] {
  let none: i32[] = [];
  let bi = w.at[b.id];
  let d = w.dom.idom[bi];
  if (d < 0 || d == bi) {
    return none;
  }
  let t = w.f.blocks[d].term;
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f) {
    return none;
  }
  let ts = tested(w, t.cond);
  let out: i32[] = [];
  for pid in b.preds {
    let pb = w.at[pid];
    if (edge_live(p, w, pb, b.id)) {
      let side = arm_of(w, d, t, pb, b.id);
      if (side < 0) {
        return none;
      }
      let nonzero = side == 1 == ts.on_true;
      if (nonzero) {
        out = out.append(1);
      } else {
        out = out.append(0);
      }
    }
  }
  if (out.len() != n) {
    return none;
  }
  return out;
}

// 1 if the edge from `pb` into `id` lies in the true arm of the branch of
// block `d`, 0 if in the false arm, -1 if in neither alone.
function arm_of(w: Walk, d: i32, t: ssa.STerm, pb: i32, id: i32): i32 {
  if (pb == d) {
    if (ssa.successor_id(t, 0) == id) {
      return 1;
    }
    return 0;
  }
  let tb = w.at[t.t];
  let fb = w.at[t.f];
  if (tb >= 0 && t.t != id && w.f.blocks[tb].preds.len() == 1 && ssadeps.dom_holds(w.dom, pb, tb)) {
    return 1;
  }
  if (fb >= 0 && t.f != id && w.f.blocks[fb].preds.len() == 1 && ssadeps.dom_holds(w.dom, pb, fb)) {
    return 0;
  }
  return -1;
}

// The counts that the edges bring, met side by side as a twin of the word
// `c`, or maybe if a side is not a plain count.
function side_twin(p: Progress, bases: i32[], sides: i32[], j: i32, c: i32): i32 {
  let same = no_side();
  let apart = no_side();
  for i in 0..bases.len() {
    let s = flat(p.out[bases[i] + j]);
    if (s == absent()) {
      continue;
    }
    if (s < 0 || s > cap()) {
      return maybe();
    }
    if (sides[i] == 1) {
      same = side_meet(same, s);
    } else {
      apart = side_meet(apart, s);
    }
    if (same == -1 || apart == -1) {
      return maybe();
    }
  }
  return twin(c, same, apart);
}

function met_maybe(own p: Progress, k: i32, bi: i32): Progress {
  if (p.maybe_at[k] < 0) {
    p = Progress { ...p, maybe_at: p.maybe_at.with(k, bi) };
  }
  return Progress { ...p, mlog: p.mlog.append(k) };
}

function edge_base(w: Walk, lv: Live, pb: i32, id: i32): i32 {
  let t = w.f.blocks[pb].term;
  let e = 0;
  if (ssa.successor_id(t, 1) == id && ssa.successor_id(t, 0) != id) {
    e = 1;
  }
  return lv.out_at[pb * 2 + e];
}

function enter_phis(own p: Progress, w: Walk, bi: i32): Progress {
  let b = w.f.blocks[bi];
  for ins in b.insts {
    if (ins.kind_tag != ssa.PHI || ins.result < 0) {
      continue;
    }
    let k = w.idx[ins.result];
    if (k < 0) {
      continue;
    }
    if (units(flat(p.state[k])) > 0) {
      p = found(p, w, "redefined while held", ins.result, b.id, "the previous value's unit was never spent");
    }
    let at = p.phi_at[ins.result];
    let s = absent();
    for i in 0..b.preds.len() {
      s = meet(s, p.phin[at + i]);
    }
    if (s == maybe()) {
      p = met_maybe(p, k, bi);
    }
    if (s == absent()) {
      s = maybe();
    }
    p = Progress { ...p, state: p.state.with(k, s) };
  }
  return p;
}

function null_on_edge(w: Walk, bi: i32, sid: i32): i32 {
  let tg = tag_on_edge(w, bi, sid);
  if (tg.word >= 0 && tg.c == 0 && tg.equal) {
    return tg.word;
  }
  return -1;
}

struct Tag { word: i32, c: i32, equal: boolean }

function compared(w: Walk, ins: ssa.SInst): Tag {
  let a = def_at(w, ins.args[1]);
  if (a.kind_tag == ssa.CONST_INT) {
    return Tag { word: ins.args[0], c: a.imm, equal: true };
  }
  let b = def_at(w, ins.args[0]);
  if (b.kind_tag == ssa.CONST_INT) {
    return Tag { word: ins.args[1], c: b.imm, equal: true };
  }
  // A CONST_I64 keeps its width in imm, so only its zero is read here.
  if (zero_word(a)) {
    return Tag { word: ins.args[0], c: 0, equal: true };
  }
  if (zero_word(b)) {
    return Tag { word: ins.args[1], c: 0, equal: true };
  }
  return Tag { word: -1, c: 0, equal: false };
}

function tag_on_edge(w: Walk, bi: i32, sid: i32): Tag {
  let t = w.f.blocks[bi].term;
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f) {
    return Tag { word: -1, c: 0, equal: false };
  }
  let ins = def_in(w, t.cond);
  if (ins.kind_tag == ssa.BINARY && ins.args.len() == 2 && (ins.ir_kind == ir.K_EQ || ins.ir_kind == ir.K_NE)) {
    let tg = compared(w, ins);
    let equal = sid == t.t;
    if (ins.ir_kind == ir.K_NE) {
      equal = !equal;
    }
    return Tag { ...tg, equal: equal };
  }
  return Tag { word: t.cond, c: 0, equal: sid == t.f };
}

function settle_edge(own p: Progress, w: Walk, bi: i32, sid: i32): Progress {
  let null_v = null_on_edge(w, bi, sid);
  if (null_v >= 0 && w.idx[w.root[null_v]] >= 0) {
    p = Progress { ...p, state: p.state.with(w.idx[w.root[null_v]], absent()) };
  }
  p = same_box_on_edge(p, w, bi, sid);
  p = unique_on_edge(p, w, bi, sid);
  p = token_side_on_edge(p, w, bi, sid);
  if (w.pair_words.len() > 0) {
    p = settle_pair_words(p, w, bi, sid);
  }
  return p;
}

// A uniqueness test skips an immortal box, so a literal is never unique. On
// the edge where `__fern_rc_is_unique` is true, a value that is a literal on
// some paths holds the units of the other paths. This applies only where the
// other edge releases the box: there the box is a literal or holds no unit,
// and a token reads it as 0 (`token_fed`). Thus both arms of a token of the
// box hold a plain count.
function unique_on_edge(own p: Progress, w: Walk, bi: i32, sid: i32): Progress {
  let t = w.f.blocks[bi].term;
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f || sid != t.t) {
    return p;
  }
  let c = def_in(w, t.cond);
  if (!is_call(c, "__fern_rc_is_unique") || c.args.len() != 1 || c.args[0] < 0 || w.derived[c.args[0]]) {
    return p;
  }
  let r = w.root[c.args[0]];
  let k = w.idx[r];
  if (k < 0 || p.state[k] < free_or(0) || !releases_root(w, t.f, r)) {
    return p;
  }
  return Progress { ...p, state: p.state.with(k, p.state[k] - free_or(0)) };
}

// The block `id` releases the box `r` with `__fern_rc_dec`.
function releases_root(w: Walk, id: i32, r: i32): boolean {
  let bi = w.at[id];
  if (bi < 0) {
    return false;
  }
  for ins in w.f.blocks[bi].insts {
    if (is_call(ins, "__fern_rc_dec") && ins.args.len() == 1 && ins.args[0] >= 0 && w.root[ins.args[0]] == r) {
      return true;
    }
  }
  return false;
}

// On the edge where a call's result is its operand (effect_kept_or_same),
// the two are one box. The result takes the operand's units, and the fresh
// unit of the result was never there.
function same_box_on_edge(own p: Progress, w: Walk, bi: i32, sid: i32): Progress {
  let t = w.f.blocks[bi].term;
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f) {
    return p;
  }
  let c = def_in(w, t.cond);
  if (c.kind_tag != ssa.BINARY || c.args.len() != 2 || c.ir_kind != ir.K_EQ && c.ir_kind != ir.K_NE) {
    return p;
  }
  let equal = sid == t.t;
  if (c.ir_kind == ir.K_NE) {
    equal = !equal;
  }
  if (equal) {
    p = took_operand(p, w, c.args[0], c.args[1]);
    p = took_operand(p, w, c.args[1], c.args[0]);
  }
  p = twin_on_edge(p, w, c.args[0], c.args[1], equal);
  return twin_on_edge(p, w, c.args[1], c.args[0], equal);
}

// The push is the first call of the arm where `__fern_rc_is_unique` found
// that the box `root` has more than one holder. The push copies such a box.
// A box with a negative count stays in place, and no retain or release
// changes it, so the result counts as a new box on both paths.
function first_on_shared_arm(w: Walk, block: i32, root: i32, result: i32): boolean {
  let bi = w.at[block];
  if (bi < 0 || w.f.blocks[bi].preds.len() != 1) {
    return false;
  }
  let pb = w.at[w.f.blocks[bi].preds[0]];
  if (pb < 0) {
    return false;
  }
  let t = w.f.blocks[pb].term;
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f || t.f != block) {
    return false;
  }
  let c = def_in(w, t.cond);
  if (!is_call(c, "__fern_rc_is_unique") || c.args.len() != 1 || c.args[0] < 0 || w.root[c.args[0]] != root) {
    return false;
  }
  for ins in w.f.blocks[bi].insts {
    if (ins.result == result) {
      return true;
    }
    if (ins.kind_tag == ssa.CALL || ins.kind_tag == ssa.RT_CALL || is_store(ins.kind_tag)) {
      return false;
    }
  }
  return false;
}

// A plain count tested against a parameter: on the equal edge the value is
// the box of the parameter, and on the other edge it is not.
function side_of_test(o: i32, c: i32, equal: boolean): i32 {
  if (equal) {
    return twin(o, c, no_side());
  }
  return twin(o, no_side(), c);
}

// A test of a twin against its box decides the side. On the equal edge the
// two names are one box, and the twin takes the units of the other name.
function twin_on_edge(own p: Progress, w: Walk, x: i32, y: i32, equal: boolean): Progress {
  if (x < 0 || y < 0) {
    return p;
  }
  let kx = w.idx[w.root[x]];
  let o = w.root[y];
  if (kx < 0 || w.root[x] == o) {
    return p;
  }
  let s = p.state[kx];
  if (is_twin(s) && twin_key(s) != o && flat(s) >= 0) {
    s = flat(s);
  }
  if (s >= 0 && s <= cap() && o < w.f.nparams) {
    return Progress { ...p, state: p.state.with(kx, side_of_test(o, s, equal)) };
  }
  if (!is_twin(s) || twin_key(s) != o || !box_key(p, w, o)) {
    return p;
  }
  if (!equal) {
    return Progress { ...p, state: p.state.with(kx, twin(o, no_side(), twin_apart(s))) };
  }
  let same = twin_same(s);
  let ky = w.idx[o];
  if (ky < 0) {
    return Progress { ...p, state: p.state.with(kx, twin(o, same, no_side())) };
  }
  let held = p.state[ky];
  if (same != no_side() && held >= 0 && same + held <= cap()) {
    return Progress { ...p, state: p.state.with(kx, twin(o, same + held, no_side())).with(ky, 0) };
  }
  return Progress { ...p, state: p.state.with(kx, twin(o, same, no_side())) };
}

function took_operand(own p: Progress, w: Walk, result: i32, operand: i32): Progress {
  let d = def_in(w, result);
  if (d.kind_tag != ssa.CALL || result < 0 || operand < 0) {
    return p;
  }
  let s = w.sigs.lookup(d.str);
  if (!s.known || s.effect != rcsigs.effect_kept_or_same() || s.arg < 0 || s.arg >= d.args.len() || d.args[s.arg] < 0 || w.root[d.args[s.arg]] != w.root[operand]) {
    return p;
  }
  let kr = w.idx[w.root[result]];
  let ko = w.idx[w.root[operand]];
  if (kr < 0 || ko < 0 || kr == ko || p.state[kr] != 1) {
    return p;
  }
  return Progress { ...p, state: p.state.with(kr, p.state[ko]).with(ko, 0) };
}

function settle_pair_words(own p: Progress, w: Walk, bi: i32, sid: i32): Progress {
  let tg = tag_on_edge(w, bi, sid);
  if (tg.word < 0 || tg.c < 0 || tg.c >= 31) {
    return p;
  }
  let bit = 1 << tg.c;
  let away = -1;
  for v in w.pair_words {
    if (w.root[w.pair_tag[v]] != w.root[tg.word]) {
      continue;
    }
    let mask = w.pair_mask[v];
    let empty = false;
    if (tg.equal) {
      empty = (mask & bit) == 0;
    } else {
      if (away < 0) {
        away = bit | excluded_tags(w, bi, tg.word);
      }
      empty = (mask & away) == mask;
    }
    let k = w.idx[w.root[v]];
    if (empty && k >= 0) {
      p = Progress { ...p, state: p.state.with(k, absent()) };
    }
  }
  return p;
}

function excluded_tags(w: Walk, bi: i32, word: i32): i32 {
  let out = 0;
  for d in 0..w.f.blocks.len() {
    let t = w.f.blocks[d].term;
    if (d != bi && t.kind_tag == ssa.TERM_BRIF && t.t != t.f && ssadeps.dom_holds(w.dom, bi, d)) {
      out = out | excluded_on(w, bi, d, t.t, word) | excluded_on(w, bi, d, t.f, word);
    }
  }
  return out;
}

function excluded_on(w: Walk, bi: i32, d: i32, sid: i32, word: i32): i32 {
  let tg = tag_on_edge(w, d, sid);
  if (tg.word < 0 || tg.equal || tg.c < 0 || tg.c >= 31 || w.root[tg.word] != w.root[word]) {
    return 0;
  }
  let si = w.at[sid];
  if (si < 0 || w.f.blocks[si].preds.len() != 1 || !ssadeps.dom_holds(w.dom, bi, si)) {
    return 0;
  }
  return 1 << tg.c;
}

struct Fed { p: Progress, input: i32 }

// A string or an aggregate literal, or a phi of them: an immortal box.
function literal(w: Walk, v: i32): boolean {
  return literal_within(w, v, 4);
}

function literal_within(w: Walk, v: i32, depth: i32): boolean {
  let ins = def_at(w, v);
  if (ins.kind_tag == ssa.STR_LIT || ins.kind_tag == ssa.AGG_LIT) {
    return true;
  }
  if (ins.kind_tag != ssa.PHI || depth == 0) {
    return false;
  }
  for a in ins.args {
    if (a < 0 || a != v && !literal_within(w, a, depth - 1)) {
      return false;
    }
  }
  return true;
}

// The units of one side of a twin that a phi input takes: one, as for a
// plain count.
function handed(side: i32): i32 {
  if (side == no_side() || side == 0) {
    return side;
  }
  return 1;
}

function kept_side(side: i32, taken: i32): i32 {
  if (side == no_side()) {
    return side;
  }
  return side - taken;
}

// Where a token is not zero, the token and its box are one box. The other
// name of `v` there, or -1 if `t` is not a token of `v` or `v` itself.
function other_name(w: Walk, v: i32, t: i32): i32 {
  let box = token_box(w, def_in(w, t));
  if (box < 0) {
    return -1;
  }
  if (v == box) {
    return w.idx[t];
  }
  if (v == t) {
    return w.idx[box];
  }
  return -1;
}

function count_input(own p: Progress, w: Walk, a: i32): Fed {
  if (a < 0 || w.derived[a]) {
    return Fed { p: p, input: 0 };
  }
  let k = w.idx[w.root[a]];
  if (k < 0) {
    if (literal(w, w.root[a])) {
      return Fed { p: p, input: free() };
    }
    return Fed { p: p, input: 0 };
  }
  let st = p.state[k];
  if (is_twin(st) && twin_same(st) == 0 && twin_apart(st) == no_side()) {
    let kn = other_name(w, w.root[a], twin_key(st));
    if (kn >= 0 && is_twin(p.state[kn]) && twin_key(p.state[kn]) == twin_key(st) && twin_apart(p.state[kn]) == no_side() && twin_same(p.state[kn]) > 0) {
      let o = twin_key(st);
      p = Progress { ...p, state: p.state.with(kn, twin(o, twin_same(p.state[kn]) - 1, no_side())) };
      return Fed { p: p, input: twin(o, 1, no_side()) };
    }
  }
  if (is_twin(st)) {
    let o = twin_key(st);
    let same = twin_same(st);
    let apart = twin_apart(st);
    let in_same = handed(same);
    let in_apart = handed(apart);
    p = Progress { ...p, state: p.state.with(k, twin(o, kept_side(same, in_same), kept_side(apart, in_apart))) };
    return Fed { p: p, input: twin(o, in_same, in_apart) };
  }
  if (st == maybe() || st == absent() || st == owed()) {
    return Fed { p: p, input: maybe() };
  }
  if (st == free()) {
    return Fed { p: p, input: free() };
  }
  if (st >= free_or(0)) {
    if (st > free_or(0)) {
      p = Progress { ...p, state: p.state.with(k, st - 1) };
      return Fed { p: p, input: free_or(1) };
    }
    return Fed { p: p, input: free_or(0) };
  }
  if (st > 0) {
    p = Progress { ...p, state: p.state.with(k, st - 1) };
    return Fed { p: p, input: 1 };
  }
  return Fed { p: p, input: 0 };
}

// A parameter is its own box: as a phi input, it meets a twin of itself side
// by side.
function phi_input(own p: Progress, w: Walk, a: i32): Fed {
  let fed = count_input(p, w, a);
  if (a >= 0 && !w.derived[a] && w.root[a] < w.f.nparams && fed.input >= 0 && fed.input <= cap()) {
    return Fed { p: fed.p, input: twin(w.root[a], fed.input, no_side()) };
  }
  return fed;
}

// The box that a reuse token names: the token is a phi whose inputs are
// that box or zero, so it is the box when it is not zero. -1 if `ins` is not
// a token.
function token_box(w: Walk, ins: ssa.SInst): i32 {
  if (ins.kind_tag != ssa.PHI || ins.result < 0) {
    return -1;
  }
  let box = -1;
  let zero = false;
  for a in ins.args {
    if (a < 0 || w.derived[a]) {
      return -1;
    }
    if (zero_at(w, a)) {
      zero = true;
    } else if (box >= 0 && w.root[a] != box) {
      return -1;
    } else {
      box = w.root[a];
    }
  }
  if (!zero || box < 0 || box == w.root[ins.result] || w.idx[box] < 0) {
    return -1;
  }
  return box;
}

// A token input makes its box a twin keyed on the token: on the edge where
// the token is the box, the token takes the unit of the box, and on the edge
// where the token is zero, the box keeps it.
function token_fed(own p: Progress, w: Walk, ins: ssa.SInst, a: i32): Fed {
  let box = token_box(w, ins);
  if (box < 0) {
    return phi_input(p, w, a);
  }
  let t = w.root[ins.result];
  let kb = w.idx[box];
  if (is_twin(p.state[kb]) && flat(p.state[kb]) >= 0) {
    p = Progress { ...p, state: p.state.with(kb, flat(p.state[kb])) };
  }
  if (zero_at(w, a)) {
    // A box that is a literal or holds no unit hands the token nothing.
    if (p.state[kb] == free_or(0)) {
      p = Progress { ...p, state: p.state.with(kb, 0) };
    }
    let held = p.state[kb];
    if (held < 0 || held > cap()) {
      return count_input(p, w, a);
    }
    p = Progress { ...p, state: p.state.with(kb, twin(t, no_side(), held)) };
    return Fed { p: p, input: twin(t, no_side(), 0) };
  }
  if (p.state[kb] < 0 || p.state[kb] > cap()) {
    return count_input(p, w, a);
  }
  let fed = count_input(p, w, a);
  p = fed.p;
  let kept = p.state[kb];
  if (fed.input < 0 || fed.input > cap() || kept < 0 || kept > cap()) {
    return Fed { p: p, input: fed.input };
  }
  p = Progress { ...p, state: p.state.with(kb, twin(t, kept, no_side())) };
  return Fed { p: p, input: twin(t, fed.input, no_side()) };
}

// A token that a block defines again ends what the twins keyed on its last
// value knew.
function forget_tokens(own p: Progress, w: Walk, b: ssa.SBlock): Progress {
  for ins in b.insts {
    if (ins.kind_tag == ssa.PHI && ins.result >= 0 && (token_box(w, ins) >= 0 || ins.result < p.keyed.len() && p.keyed[w.root[ins.result]])) {
      p = flatten_key(p, w.root[ins.result]);
    }
  }
  return p;
}

function flatten_key(own p: Progress, t: i32): Progress {
  for k in 0..p.state.len() {
    if (is_twin(p.state[k]) && twin_key(p.state[k]) == t) {
      p = Progress { ...p, state: p.state.with(k, flat(p.state[k])) };
    }
  }
  return p;
}

// A box that keys a twin, and is not a parameter, can be defined again.
function keyed(own p: Progress, t: i32): Progress {
  if (t < 0 || t >= p.keyed.len()) {
    return p;
  }
  return Progress { ...p, keyed: p.keyed.with(t, true) };
}

// A box defined again ends what the twins keyed on its last value knew.
function forget_key(own p: Progress, v: i32): Progress {
  if (v < 0 || v >= p.keyed.len() || !p.keyed[v]) {
    return p;
  }
  return flatten_key(p, v);
}

function token_key(w: Walk, o: i32): boolean {
  return o >= 0 && token_box(w, def_in(w, o)) >= 0;
}

// A key whose twins tell whether a value is the box of the key, and not
// whether the key is zero.
function box_key(p: Progress, w: Walk, o: i32): boolean {
  return o >= 0 && !token_key(w, o) && (o >= p.condkey.len() || !p.condkey[o]);
}

function cond_key(own p: Progress, c: i32): Progress {
  if (c < 0 || c >= p.condkey.len()) {
    return p;
  }
  return Progress { ...p, condkey: p.condkey.with(c, true), keyed: p.keyed.with(c, true) };
}

// The value that is the box `r` on this path: a twin of `r` with one side,
// the side where it is that box. -1 if no value is.
function named_box(p: Progress, r: i32): i32 {
  if (r < 0 || r >= p.keyed.len() || !p.keyed[r]) {
    return -1;
  }
  for k in 0..p.state.len() {
    let s = p.state[k];
    if (is_twin(s) && twin_key(s) == r && twin_apart(s) == no_side() && twin_same(s) < cap()) {
      return k;
    }
  }
  return -1;
}

// The root of a token whose box is `r` and whose slot holds a state, or -1.
function live_token_of(p: Progress, w: Walk, r: i32): i32 {
  if (r < 0 || w.idx[r] < 0) {
    return -1;
  }
  for ph in w.phis {
    let t = w.root[ph];
    if (t == ph && w.idx[t] >= 0 && p.state[w.idx[t]] != absent() && token_box(w, def_in(w, ph)) == r) {
      return t;
    }
  }
  return -1;
}

// A test of a token against zero decides the side of each twin keyed on
// the token.
function token_side_on_edge(own p: Progress, w: Walk, bi: i32, sid: i32): Progress {
  let t = w.f.blocks[bi].term;
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f) {
    return p;
  }
  let ts = tested(w, t.cond);
  if (ts.word < 0) {
    return p;
  }
  let tok = w.root[ts.word];
  if (token_box(w, def_in(w, tok)) < 0 && (tok >= p.condkey.len() || !p.condkey[tok])) {
    return p;
  }
  let is_box = sid == t.t == ts.on_true;
  for k in 0..p.state.len() {
    let s = p.state[k];
    if (is_twin(s) && twin_key(s) == tok) {
      if (is_box) {
        s = twin(tok, twin_same(s), no_side());
      } else {
        s = twin(tok, no_side(), twin_apart(s));
      }
      p = Progress { ...p, state: p.state.with(k, s) };
    }
  }
  return p;
}

function feed(own p: Progress, w: Walk, bi: i32, sid: i32): Progress {
  let si = w.at[sid];
  if (si < 0) {
    return p;
  }
  p = settle_edge(p, w, bi, sid);
  let s = w.f.blocks[si];
  let pi = util.index_of_i32(s.preds, w.f.blocks[bi].id);
  if (pi < 0) {
    return p;
  }
  p = forget_tokens(p, w, s);
  for ins in s.insts {
    if (ins.kind_tag != ssa.PHI || ins.result < 0 || w.idx[ins.result] < 0 || pi >= ins.args.len()) {
      continue;
    }
    let fed = token_fed(p, w, ins, ins.args[pi]);
    p = fed.p;
    p = Progress { ...p, phin: p.phin.with(p.phi_at[ins.result] + pi, fed.input) };
  }
  return p;
}

struct RoundResult { p: Progress, changed: boolean }

function apply_return(own p: Progress, w: Walk, lv: Live, bi: i32): Progress {
  let b = w.f.blocks[bi];
  let t = b.term;
  if (t.value >= 0) {
    let unit = w.self_abi.result_unit;
    let word = !w.self_abi.known || w.self_abi.result_word;
    if (w.paired) {
      unit = w.self_abi.pair_first;
      word = !w.self_abi.known;
    }
    if (unit) {
      p = spend(p, w, t.value, b.id, "returned");
    } else if (word) {
      p = spend_if_held(p, w, t.value);
    }
  }
  return retire(p, w, lv, lv.row_at[bi], lv.row_n[bi], b.id, "leaked at return");
}

function retire(own p: Progress, w: Walk, lv: Live, at: i32, n: i32, block: i32, kind: string): Progress {
  for j in 0..n {
    let k = lv.slots[at + j];
    let held = flat(p.state[k]);
    if (units(held) > 0) {
      p = found(p, w, kind, root_at(w, k), block, util.i32_to_string(units(held)) + " unit(s) still held");
    } else if (held == owed()) {
      p = found(p, w, "spent without a unit", root_at(w, k), block, "its slot was not emptied on this path");
    } else if (held == maybe()) {
      p = Progress { ...p, unproved: p.unproved.with(k, true), ulog: p.ulog.append(k) };
    }
  }
  return p;
}

function hand_edges(own p: Progress, w: Walk, lv: Live, bi: i32): RoundResult {
  let t = w.f.blocks[bi].term;
  let saved = row_values(p, lv, bi);
  let changed = false;
  for e in 0..2 {
    if (lv.out_at[bi * 2 + e] >= 0 && (e == 0 || ssa.successor_id(t, 1) != ssa.successor_id(t, 0))) {
      if (e == 1) {
        p = restore_row(p, lv, bi, saved);
      }
      if (twin_dead_on_edge(p, w, bi, ssa.successor_id(t, e))) {
        let r = kill_edge(p, w, lv, bi, e);
        p = r.p;
        changed = changed || r.changed;
        continue;
      }
      if (p.dead[bi * 2 + e]) {
        p = Progress { ...p, dead: p.dead.with(bi * 2 + e, false) };
        changed = true;
      }
      let r = hand_edge(p, w, lv, bi, e);
      p = r.p;
      changed = changed || r.changed;
    }
  }
  return RoundResult { p: p, changed: changed };
}

// The edge from block `pb` into the block `id` carries a path in this round.
function edge_live(p: Progress, w: Walk, pb: i32, id: i32): boolean {
  if (pb < 0 || !p.done[pb]) {
    return false;
  }
  let e = 0;
  if (ssa.successor_id(w.f.blocks[pb].term, 0) != id) {
    e = 1;
  }
  return !p.dead[pb * 2 + e];
}

// A block that no live edge reaches runs nothing, and its edges carry no path.
function reached(p: Progress, w: Walk, bi: i32): boolean {
  let b = w.f.blocks[bi];
  if (bi == w.at[w.f.entry] || b.preds.len() == 0) {
    return true;
  }
  for pid in b.preds {
    if (edge_live(p, w, w.at[pid], b.id)) {
      return true;
    }
  }
  return false;
}

// A test of a twin against its key that selects a side the twin does not
// have: no path takes the edge.
function twin_dead_on_edge(p: Progress, w: Walk, bi: i32, sid: i32): boolean {
  let t = w.f.blocks[bi].term;
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f) {
    return false;
  }
  let c = def_in(w, t.cond);
  if (c.kind_tag != ssa.BINARY || c.args.len() != 2 || c.ir_kind != ir.K_EQ && c.ir_kind != ir.K_NE) {
    return false;
  }
  let equal = sid == t.t;
  if (c.ir_kind == ir.K_NE) {
    equal = !equal;
  }
  return no_side_of(p, w, c.args[0], c.args[1], equal) || no_side_of(p, w, c.args[1], c.args[0], equal);
}

function no_side_of(p: Progress, w: Walk, x: i32, y: i32, equal: boolean): boolean {
  if (x < 0 || y < 0 || w.derived[x]) {
    return false;
  }
  let kx = w.idx[w.root[x]];
  if (kx < 0) {
    return false;
  }
  let s = p.state[kx];
  if (!is_twin(s) || twin_key(s) != w.root[y]) {
    return false;
  }
  if (equal) {
    return twin_same(s) == no_side();
  }
  return twin_apart(s) == no_side();
}

function kill_edges(own p: Progress, w: Walk, lv: Live, bi: i32): RoundResult {
  let changed = false;
  let t = w.f.blocks[bi].term;
  for e in 0..2 {
    if (lv.out_at[bi * 2 + e] >= 0 && (e == 0 || ssa.successor_id(t, 1) != ssa.successor_id(t, 0))) {
      let r = kill_edge(p, w, lv, bi, e);
      p = r.p;
      changed = changed || r.changed;
    }
  }
  return RoundResult { p: p, changed: changed };
}

// The edge `e` of block `bi` carries no path: its phi inputs are absent.
function kill_edge(own p: Progress, w: Walk, lv: Live, bi: i32, e: i32): RoundResult {
  let changed = !p.dead[bi * 2 + e];
  p = Progress { ...p, dead: p.dead.with(bi * 2 + e, true) };
  let sid = ssa.successor_id(w.f.blocks[bi].term, e);
  let si = w.at[sid];
  if (si < 0) {
    return RoundResult { p: p, changed: changed };
  }
  let s = w.f.blocks[si];
  let pi = util.index_of_i32(s.preds, w.f.blocks[bi].id);
  if (pi < 0) {
    return RoundResult { p: p, changed: changed };
  }
  for ins in s.insts {
    if (ins.kind_tag == ssa.PHI && ins.result >= 0 && w.idx[ins.result] >= 0 && pi < ins.args.len()) {
      let at = p.phi_at[ins.result] + pi;
      if (p.phin[at] != absent()) {
        changed = true;
        p = Progress { ...p, phin: p.phin.with(at, absent()) };
      }
    }
  }
  return RoundResult { p: p, changed: changed };
}

function hand_edge(own p: Progress, w: Walk, lv: Live, bi: i32, e: i32): RoundResult {
  let sid = ssa.successor_id(w.f.blocks[bi].term, e);
  let si = w.at[sid];
  p = feed(p, w, bi, sid);
  p = retire(p, w, lv, lv.die_at[bi * 2 + e], lv.die_n[bi * 2 + e], w.f.blocks[bi].id, "leaked where it dies");
  let base = lv.out_at[bi * 2 + e];
  let changed = false;
  let j = 0;
  while (j < lv.in_n[si]) {
    let v = p.state[lv.slots[lv.in_at[si] + j]];
    if (p.out[base + j] != v) {
      changed = true;
      p = Progress { ...p, out: p.out.with(base + j, v) };
    }
    j += 1;
  }
  return RoundResult { p: p, changed: changed };
}

function row_values(p: Progress, lv: Live, bi: i32): i32[] {
  let out: i32[] = [];
  let j = 0;
  while (j < lv.row_n[bi]) {
    out = out.append(p.state[lv.slots[lv.row_at[bi] + j]]);
    j += 1;
  }
  return out;
}

function restore_row(own p: Progress, lv: Live, bi: i32, saved: i32[]): Progress {
  let j = 0;
  while (j < lv.row_n[bi]) {
    p = Progress { ...p, state: p.state.with(lv.slots[lv.row_at[bi] + j], saved[j]) };
    j += 1;
  }
  return p;
}

function clear_row(own p: Progress, lv: Live, bi: i32): Progress {
  let j = 0;
  while (j < lv.row_n[bi]) {
    p = Progress { ...p, state: p.state.with(lv.slots[lv.row_at[bi] + j], absent()) };
    j += 1;
  }
  return p;
}

function block_round(own p: Progress, w: Walk, lv: Live, bi: i32, takes: Takes): RoundResult {
  let b = w.f.blocks[bi];
  if (!reached(p, w, bi)) {
    let r = kill_edges(p, w, lv, bi);
    p = r.p;
    return RoundResult { p: p, changed: r.changed };
  }
  p = entry_row(p, w, lv, bi);
  p = apply_block(p, w, bi, takes);
  let changed = false;
  if (b.term.kind_tag == ssa.TERM_RET) {
    p = apply_return(p, w, lv, bi);
  } else {
    let r = hand_edges(p, w, lv, bi);
    p = r.p;
    changed = r.changed;
  }
  p = clear_row(p, lv, bi);
  if (!p.done[bi]) {
    changed = true;
    p = Progress { ...p, done: p.done.with(bi, true) };
  }
  return RoundResult { p: p, changed: changed };
}

function apply_block(own p: Progress, w: Walk, bi: i32, takes: Takes): Progress {
  let f = w.f;
  let b = f.blocks[bi];
  if (w.params_at_entry && bi == w.at[f.entry]) {
    for v in 0..f.nparams {
      p = define(p, w, v, b.id);
    }
  }
  p = enter_phis(p, w, bi);
  for i in 0..b.insts.len() {
    let ins = b.insts[i];
    if (ins.kind_tag != ssa.PHI && ins.kind_tag != ssa.PARAM) {
      if (ins.result >= 0) {
        p = forget_key(p, w.root[ins.result]);
      }
      p = apply(p, w, ins, b.id, taken_at(takes, bi, i));
    }
    if (is_exit(ins)) {
      return p;
    }
  }
  return p;
}

function root_at(w: Walk, k: i32): i32 {
  for v in 0..w.idx.len() {
    if (w.idx[v] == k) {
      return v;
    }
  }
  return -1;
}

function pushed(own stack: i32[], sp: i32, v: i32): i32[] {
  if (sp < stack.len()) {
    return stack.with(sp, v);
  }
  return stack.append(v);
}

function round_limit(): i32 {
  return 64;
}

function resumes(f: ssa.SFunc): boolean {
  for b in f.blocks {
    for ins in b.insts {
      if (is_call(ins, "__fern_task_mode") || ins.kind_tag == ssa.LD_IDX && ins.str == "task_mode") {
        return true;
      }
    }
  }
  return false;
}

function walk_of(f: ssa.SFunc, irops: ir.Op[], self_abi: Abi, abis: Abis, sigs: rcsigs.Table, ops: rcsigs.OpTable, at: i32[], dom: ssadeps.Dom, reach: boolean[], hold: Hold, base: Base): Walk {
  let defs = ssa.def_sites_of(f);
  let local = region_values(f, base.on);
  let rt = roots_over(f, defs, sigs, starting_roots(f, local, base));
  let uses = base.uses;
  let paired = base.paired;
  if (!base.on) {
    uses = ssa.use_counts(f);
    paired = returns_pair(f, irops);
  }
  let w = Walk { f: f, defs: defs, at: at, root: rt.root, origin: [], idx: [], tracked: 0, self_abi: self_abi, abis: abis, sigs: sigs, ops: ops, paired: paired, why: [], opened: [], irops: irops, derived: rt.derived, pair_tag: [], pair_mask: [], pair_words: [], uses: uses, dom: dom, regions: [], openers: [], held: hold.box, reused: hold.reused, phis: phis_of(f), outer: outer_of(base), firsts: firsts_of(f, rt.root), carried: [], children: [], takes: no_takes(), params_at_entry: !base.on, debt: [], kept: [], splits: Splits { word: [], on_true: [], to: [], returns: [] }, insts: ssa.inst_defs(f), token_loads: [] };
  w = Walk { ...w, splits: splits_of(w) };
  w = Walk { ...w, carried: carried_of(w) };
  let rg = inherited_regions(unique_regions(w, dom, reach), f, reach, base);
  let own_children = children_boxes(w, rg.roots);
  let children = inherited_children(own_children, local, base);
  let st = stores_of(w);
  let o = inherited_origins(origins(w, st, rg.roots, rg.openers, children, dom), f, defs, base, local);
  w = Walk { ...w, origin: o.origin, why: o.why, opened: o.opened, pair_tag: o.pair_tag, pair_mask: o.pair_mask, pair_words: o.pair_words, regions: rg.roots, openers: rg.openers, children: children };
  let takes = inherited_takes(takes_of(w, dom), w, base);
  let taken = null_takes(w, takes);
  w = Walk { ...w, takes: takes, debt: debts(w, taken, hold.from), kept: put_backs(w, st, dom), idx: indexes(w, touches(w, taken)) };
  let tracked = 0;
  for k in w.idx {
    if (k >= 0) {
      tracked += 1;
    }
  }
  return Walk { ...w, tracked: tracked };
}

struct Base { on: boolean, at: i32[], root: i32[], derived: boolean[], origin: i32[], why: i32[], opened: i32[], pair_tag: i32[], pair_mask: i32[], pair_words: i32[], children: boolean[], regions: i32[][], openers: i32[][], uses: i32[], paired: boolean, takes: Takes, defs: ssa.DefSites, f: ssa.SFunc, phis: i32[] }

function no_base(): Base {
  return Base { on: false, at: [], root: [], derived: [], origin: [], why: [], opened: [], pair_tag: [], pair_mask: [], pair_words: [], children: [], regions: [], openers: [], uses: [], paired: false, takes: no_takes(), defs: ssa.DefSites { block: [], at: [] }, f: ssa.SFunc { name: "", nparams: 0, nvals: 0, blocks: [], entry: 0, takes_env: false }, phis: [] };
}

function base_of(w: Walk): Base {
  return Base { on: true, at: w.at, root: w.root, derived: w.derived, origin: w.origin, why: w.why, opened: w.opened, pair_tag: w.pair_tag, pair_mask: w.pair_mask, pair_words: w.pair_words, children: w.children, regions: w.regions, openers: w.openers, uses: w.uses, paired: w.paired, takes: w.takes, defs: w.defs, f: w.f, phis: w.phis };
}

struct Outer { on: boolean, f: ssa.SFunc, defs: ssa.DefSites, root: i32[], derived: boolean[], phis: i32[] }

function outer_of(base: Base): Outer {
  return Outer { on: base.on, f: base.f, defs: base.defs, root: base.root, derived: base.derived, phis: base.phis };
}

function phis_of(f: ssa.SFunc): i32[] {
  let out: i32[] = [];
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssa.PHI && ins.result >= 0) {
        out = out.append(ins.result);
      }
    }
  }
  return out;
}

function outside(f: ssa.SFunc, defs: ssa.DefSites, v: i32): boolean {
  return v >= f.nparams && v < defs.block.len() && defs.block[v] < 0;
}

function region_values(f: ssa.SFunc, on: boolean): i32[] {
  let out: i32[] = [];
  if (!on) {
    return out;
  }
  let p = 0;
  while (p < f.nparams && p < f.nvals) {
    out = out.append(p);
    p += 1;
  }
  for b in f.blocks {
    for ins in b.insts {
      if (ins.result >= f.nparams && ins.result >= 0 && ins.result < f.nvals) {
        out = out.append(ins.result);
      }
    }
  }
  return out;
}

function starting_roots(f: ssa.SFunc, local: i32[], base: Base): Roots {
  if (!base.on) {
    return own_roots(f.nvals);
  }
  let root = base.root;
  let derived = base.derived;
  for v in local {
    if (root[v] != v) {
      root = root.with(v, v);
    }
    if (derived[v]) {
      derived = derived.with(v, false);
    }
  }
  return Roots { root: root, derived: derived };
}

function inherited_regions(own rg: Regions, f: ssa.SFunc, reach: boolean[], base: Base): Regions {
  if (!base.on) {
    return rg;
  }
  for bi in 0..f.blocks.len() {
    let bb = base.at[f.blocks[bi].id];
    if (reach[bi] && bb >= 0) {
      let k = 0;
      while (k < base.regions[bb].len()) {
        let r = base.regions[bb][k];
        if (util.index_of_i32(rg.roots[bi], r) < 0 && k < base.openers[bb].len()) {
          rg = Regions { roots: rg.roots.with(bi, rg.roots[bi].append(r)), openers: rg.openers.with(bi, rg.openers[bi].append(base.openers[bb][k])) };
        }
        k += 1;
      }
    }
  }
  return rg;
}

function inherited_children(local_children: boolean[], local: i32[], base: Base): boolean[] {
  if (!base.on) {
    return local_children;
  }
  let out = base.children;
  for v in local {
    if (out[v] != local_children[v]) {
      out = out.with(v, local_children[v]);
    }
  }
  return out;
}

function inherited_origins(o: Origins, f: ssa.SFunc, defs: ssa.DefSites, base: Base, local: i32[]): Origins {
  if (!base.on) {
    return o;
  }
  let out = Origins { origin: base.origin, why: base.why, opened: base.opened, pair_tag: base.pair_tag, pair_mask: base.pair_mask, pair_words: o.pair_words };
  for v in local {
    if (out.origin[v] != o.origin[v]) {
      out = Origins { ...out, origin: out.origin.with(v, o.origin[v]) };
    }
    if (out.why[v] != o.why[v]) {
      out = Origins { ...out, why: out.why.with(v, o.why[v]) };
    }
    if (out.opened[v] != o.opened[v]) {
      out = Origins { ...out, opened: out.opened.with(v, o.opened[v]) };
    }
    if (out.pair_tag[v] != o.pair_tag[v]) {
      out = Origins { ...out, pair_tag: out.pair_tag.with(v, o.pair_tag[v]) };
    }
    if (out.pair_mask[v] != o.pair_mask[v]) {
      out = Origins { ...out, pair_mask: out.pair_mask.with(v, o.pair_mask[v]) };
    }
  }
  return inherited_pair_words(out, f, defs, base);
}

function inherited_pair_words(own o: Origins, f: ssa.SFunc, defs: ssa.DefSites, base: Base): Origins {
  if (base.pair_words.len() == 0) {
    return o;
  }
  let v = 0;
  while (v < o.origin.len() && v < base.origin.len()) {
    if (outside(f, defs, v) && v < base.pair_tag.len() && base.pair_tag[v] >= 0) {
      o = Origins { ...o, pair_words: o.pair_words.append(v) };
    }
    v += 1;
  }
  return o;
}

function inherited_takes(own t: Takes, w: Walk, base: Base): Takes {
  if (!base.on) {
    return t;
  }
  let k = 0;
  while (k < t.block.len()) {
    let bb = base.at[w.f.blocks[t.block[k]].id];
    let j = -1;
    if (bb >= 0) {
      j = base.takes.first[bb];
    }
    while (j >= 0 && j < base.takes.block.len() && base.takes.block[j] == bb) {
      if (base.takes.at[j] == t.at[k]) {
        let rs = base.takes.roots[j];
        if (rs.len() > 0 && outside(w.f, w.defs, rs[0])) {
          t = Takes { ...t, roots: t.roots.with(k, rs) };
        }
      }
      j += 1;
    }
    k += 1;
  }
  return t;
}

function debts(w: Walk, taken: boolean[], from_id: i32): boolean[] {
  if (w.held < 0 || from_id < 0 || from_id >= w.at.len() || w.at[from_id] < 0) {
    return [];
  }
  let from = w.at[from_id];
  let out = __alloc_bool(w.f.nvals);
  for v in 0..taken.len() {
    if (taken[v] && w.defs.block[v] >= 0 && ssadeps.dom_holds(w.dom, w.defs.block[v], from)) {
      let d = def_in(w, v);
      if (is_load(d) && d.args.len() > 0 && w.root[d.args[0]] == w.held) {
        out = out.with(v, true);
      }
    }
  }
  return out;
}

function in_debt(w: Walk, r: i32): boolean {
  return r >= 0 && r < w.debt.len() && w.debt[r];
}

function progress_of(w: Walk, lv: Live): Progress {
  let f = w.f;
  let phi_at = util.minus_ones(f.nvals);
  let nphin = 0;
  for b in f.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssa.PHI && ins.result >= 0 && w.idx[ins.result] >= 0) {
        phi_at = phi_at.with(ins.result, nphin);
        nphin += b.preds.len();
      }
    }
  }
  return Progress { out: filled(lv.nout, absent()), done: __alloc_bool(f.blocks.len()), dead: __alloc_bool(f.blocks.len() * 2), phi_at: phi_at, phin: filled(nphin, absent()), state: filled(w.tracked, absent()), findings: [], opaque: [], unproved: __alloc_bool(w.tracked), maybe_at: util.minus_ones(w.tracked), ulog: [], mlog: [], keyed: __alloc_bool(f.nvals), condkey: __alloc_bool(f.nvals) };
}

struct Settled { p: Progress, changed: boolean, rounds: i32 }

function settle(own p: Progress, w: Walk, lv: Live, order: i32[], reach: boolean[], takes: Takes): Settled {
  let rounds = 0;
  let changed = true;
  let once = acyclic(w, order);
  let memos = no_memos(memo_count(w.f.blocks.len(), once));
  while (changed && rounds < round_limit()) {
    changed = false;
    p = Progress { ...p, findings: [], opaque: [], unproved: __alloc_bool(w.tracked), maybe_at: util.minus_ones(w.tracked) };
    for bi in order {
      if (reach[bi] && !once && memos[bi].ran && inputs_match(p, w, lv, bi, memos[bi].inputs)) {
        p = replayed(p, memos[bi], bi);
      } else if (reach[bi]) {
        let inputs: i32[] = [];
        if (!once) {
          inputs = block_inputs(p, w, lv, bi);
        }
        let f0 = p.findings.len();
        let o0 = p.opaque.len();
        p = Progress { ...p, ulog: [], mlog: [] };
        let r = block_round(p, w, lv, bi, takes);
        p = r.p;
        if (r.changed) {
          changed = true;
        }
        if (!once) {
          memos = memos.with(bi, Memo { ran: true, inputs: inputs, findings: findings_from(p.findings, f0), opaque: strings_from(p.opaque, o0), unproved: p.ulog, maybe: p.mlog });
        }
      }
    }
    rounds += 1;
    if (once) {
      changed = false;
    }
  }
  return Settled { p: p, changed: changed, rounds: rounds };
}

struct Memo { ran: boolean, inputs: i32[], findings: Finding[], opaque: string[], unproved: i32[], maybe: i32[] }

function memo_count(n: i32, once: boolean): i32 {
  if (once) {
    return 0;
  }
  return n;
}

function no_memos(n: i32): Memo[] {
  let out: Memo[] = [];
  for i in 0..n {
    out = out.append(Memo { ran: false, inputs: [], findings: [], opaque: [], unproved: [], maybe: [] });
  }
  return out;
}

function block_inputs(p: Progress, w: Walk, lv: Live, bi: i32): i32[] {
  let b = w.f.blocks[bi];
  let out: i32[] = [];
  for pid in b.preds {
    let pb = w.at[pid];
    if (edge_live(p, w, pb, b.id)) {
      out = out.append(1);
      let base = edge_base(w, lv, pb, b.id);
      let j = 0;
      while (j < lv.in_n[bi]) {
        out = out.append(p.out[base + j]);
        j += 1;
      }
    } else {
      out = out.append(0);
    }
  }
  for ins in b.insts {
    if (ins.kind_tag == ssa.PHI && ins.result >= 0 && w.idx[ins.result] >= 0) {
      let at = p.phi_at[ins.result];
      for i in 0..b.preds.len() {
        out = out.append(p.phin[at + i]);
      }
    }
  }
  return out;
}

function replayed(own p: Progress, m: Memo, bi: i32): Progress {
  for x in m.findings {
    p = Progress { ...p, findings: p.findings.append(x) };
  }
  for o in m.opaque {
    p = Progress { ...p, opaque: p.opaque.append(o) };
  }
  for k in m.unproved {
    p = Progress { ...p, unproved: p.unproved.with(k, true) };
  }
  for k in m.maybe {
    if (p.maybe_at[k] < 0) {
      p = Progress { ...p, maybe_at: p.maybe_at.with(k, bi) };
    }
  }
  return p;
}

function findings_from(xs: Finding[], at: i32): Finding[] {
  let out: Finding[] = [];
  for i in at..xs.len() {
    out = out.append(xs[i]);
  }
  return out;
}

function strings_from(xs: string[], at: i32): string[] {
  let out: string[] = [];
  for i in at..xs.len() {
    out = out.append(xs[i]);
  }
  return out;
}

function inputs_match(p: Progress, w: Walk, lv: Live, bi: i32, old: i32[]): boolean {
  let b = w.f.blocks[bi];
  let at = 0;
  for pid in b.preds {
    let pb = w.at[pid];
    let ran = edge_live(p, w, pb, b.id);
    if (at >= old.len() || old[at] == 1 != ran) {
      return false;
    }
    at += 1;
    if (ran) {
      let base = edge_base(w, lv, pb, b.id);
      let j = 0;
      while (j < lv.in_n[bi]) {
        if (at >= old.len() || old[at] != p.out[base + j]) {
          return false;
        }
        at += 1;
        j += 1;
      }
    }
  }
  for ins in b.insts {
    if (ins.kind_tag == ssa.PHI && ins.result >= 0 && w.idx[ins.result] >= 0) {
      let ph = p.phi_at[ins.result];
      for i in 0..b.preds.len() {
        if (at >= old.len() || old[at] != p.phin[ph + i]) {
          return false;
        }
        at += 1;
      }
    }
  }
  return at == old.len();
}

function acyclic(w: Walk, order: i32[]): boolean {
  let rank = util.minus_ones(w.f.blocks.len());
  for i in 0..order.len() {
    rank = rank.with(order[i], i);
  }
  for bi in order {
    let t = w.f.blocks[bi].term;
    for e in 0..2 {
      let sid = ssa.successor_id(t, e);
      if (sid >= 0 && w.at[sid] >= 0 && rank[w.at[sid]] <= rank[bi]) {
        return false;
      }
    }
  }
  return true;
}

function token_word(w: Walk, t: ssa.STerm): i32 {
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f) {
    return -1;
  }
  let ts = tested(w, t.cond);
  if (ts.word < 0 || token_root(w, w.regions, ts.word) < 0) {
    return -1;
  }
  return w.root[ts.word];
}

function tested_tokens(w: Walk, reach: boolean[]): i32[] {
  let out: i32[] = [];
  for bi in 0..w.f.blocks.len() {
    if (reach[bi]) {
      let tok = token_word(w, w.f.blocks[bi].term);
      if (tok >= 0 && util.index_of_i32(out, tok) < 0) {
        out = out.append(tok);
      }
    }
  }
  return out;
}

struct Pruned { dropped: i32[], terms: ssa.STerm[], phis: i32[] }

struct PrunedFunc { f: ssa.SFunc, phis: i32[], hold: Hold }

struct Hold { box: i32, from: i32, reused: boolean[] }

function no_hold(): Hold {
  return Hold { box: -1, from: -1, reused: [] };
}

function prune_token(w: Walk, tok: i32, hold: boolean): PrunedFunc {
  let f = w.f;
  let pr = Pruned { dropped: util.minus_ones(f.blocks.len()), terms: [], phis: [] };
  for b in f.blocks {
    pr = Pruned { ...pr, terms: pr.terms.append(b.term) };
  }
  let box = token_root(w, w.regions, tok);
  pr = drop_phi_edges(w, pr, tok, box, hold, 0);
  let reach = reached_over(w, pr.terms);
  let fixed = fixed_phis(w, pr, reach, box);
  let changed = true;
  while (changed) {
    changed = false;
    let bi = 0;
    while (bi < f.blocks.len()) {
      let t = pr.terms[bi];
      if (reach[bi] && t.kind_tag == ssa.TERM_BRIF && t.t != t.f) {
        let ts = tested(w, t.cond);
        let fx = -1;
        if (ts.word >= 0) {
          fx = fixed[w.root[ts.word]];
        }
        if (fx >= 0) {
          let other = t.t;
          if (ts.on_true == (fx == 1)) {
            other = t.f;
          }
          pr = drop_edge(w, pr, bi, other);
          changed = true;
        }
      }
      bi += 1;
    }
    if (changed) {
      reach = reached_over(w, pr.terms);
      fixed = fixed_phis(w, pr, reach, box);
    }
  }
  let rew = pr.phis;
  let want = 0;
  if (hold) {
    want = 1;
  }
  for v in 0..fixed.len() {
    if (fixed[v] == want && util.index_of_i32(rew, v) < 0) {
      rew = rew.append(v);
    }
  }
  let out: ssa.SBlock[] = [];
  for bi in 0..f.blocks.len() {
    let term = pr.terms[bi];
    if (!reach[bi]) {
      term = ssa.STerm { kind_tag: ssa.TERM_RET, cond: 0, target: 0, t: 0, f: 0, value: -1 };
    }
    let b = ssa.SBlock { ...f.blocks[bi], term: term };
    out = out.append(token_phis(without_dropped_preds(w, b, pr.dropped, reach), rew, box, hold));
  }
  let fa = ssa.SFunc { ...f, blocks: out };
  if (!hold) {
    return PrunedFunc { f: fa, phis: pr.phis, hold: no_hold() };
  }
  let ops = box_ops(w, fa, box);
  return PrunedFunc { f: ops.f, phis: pr.phis, hold: Hold { box: box, from: f.blocks[w.defs.block[tok]].id, reused: ops.reused } };
}

function fixed_phis(w: Walk, pr: Pruned, reach: boolean[], box: i32): i32[] {
  let out = util.minus_ones(w.f.nvals);
  let changed = true;
  while (changed) {
    changed = false;
    for p in w.phis {
      let bi = w.defs.block[p];
      if (out[p] < 0 && reach[bi]) {
        let fx = fixed_phi(w, pr, reach, out, w.f.blocks[bi], def_in(w, p), box);
        if (fx >= 0) {
          out = out.with(p, fx);
          changed = true;
        }
      }
    }
  }
  return out;
}

function fixed_phi(w: Walk, pr: Pruned, reach: boolean[], out: i32[], b: ssa.SBlock, ins: ssa.SInst, box: i32): i32 {
  let found = -1;
  let i = 0;
  while (i < ins.args.len() && i < b.preds.len()) {
    let a = ins.args[i];
    let pb = w.at[b.preds[i]];
    if (a >= 0 && a != ins.result && pb >= 0 && reach[pb] && pr.dropped[pb] != b.id) {
      let fx = -1;
      if (zero_at(w, a)) {
        fx = 0;
      } else if (w.root[a] == box && !w.derived[a]) {
        fx = 1;
      } else {
        fx = out[w.root[a]];
      }
      if (fx < 0 || found >= 0 && found != fx) {
        return -1;
      }
      found = fx;
    }
    i += 1;
  }
  return found;
}

struct BoxOps { f: ssa.SFunc, reused: boolean[] }

function token_phis(b: ssa.SBlock, phis: i32[], box: i32, hold: boolean): ssa.SBlock {
  let insts: ssa.SInst[] = [];
  let any = false;
  for ins in b.insts {
    if (ins.kind_tag == ssa.PHI && ins.result >= 0 && util.index_of_i32(phis, ins.result) >= 0) {
      any = true;
      if (hold) {
        insts = insts.append(ssa.SInst { ir_kind: 0, kind_tag: ssa.COPY, result: ins.result, args: [box], imm: 0, str: "" });
      } else {
        insts = insts.append(ssa.SInst { ir_kind: 0, kind_tag: ssa.CONST_INT, result: ins.result, args: [], imm: 0, str: "" });
      }
    } else {
      insts = insts.append(ins);
    }
  }
  if (!any) {
    return b;
  }
  return ssa.SBlock { ...b, insts: insts };
}

function box_ops(w: Walk, f: ssa.SFunc, box: i32): BoxOps {
  let root = roots(f, w.defs, w.sigs).root;
  let ops = BoxOps { f: f, reused: __alloc_bool(f.nvals) };
  for bi in 0..f.blocks.len() {
    if (calls_on_box(f.blocks[bi], root, box)) {
      ops = box_ops_in(ops, bi, root, box, util.index_of_i32(w.regions[bi], box) >= 0);
    }
  }
  return ops;
}

function box_ops_in(own ops: BoxOps, bi: i32, root: i32[], box: i32, unique: boolean): BoxOps {
  let b = ops.f.blocks[bi];
  let insts: ssa.SInst[] = [];
  let any = false;
  for ins in b.insts {
    let on_box = ins.kind_tag == ssa.CALL && ins.args.len() > 0 && ins.args[0] >= 0 && root[ins.args[0]] == box;
    if (on_box && unique && ins.str == "__fern_rc_dec") {
      any = true;
      insts = insts.append(ssa.SInst { ...ins, imm: 2 });
    } else if (on_box && ins.str == "__fern_alloc_reuse" && ins.result >= 0) {
      any = true;
      insts = insts.append(ssa.SInst { ir_kind: 0, kind_tag: ssa.COPY, result: ins.result, args: [box], imm: 0, str: "" });
      ops = BoxOps { ...ops, reused: ops.reused.with(ins.result, true) };
    } else {
      insts = insts.append(ins);
    }
  }
  if (!any) {
    return ops;
  }
  return BoxOps { ...ops, f: ssa.SFunc { ...ops.f, blocks: ops.f.blocks.with(bi, ssa.SBlock { ...b, insts: insts }) } };
}

function calls_on_box(b: ssa.SBlock, root: i32[], box: i32): boolean {
  for ins in b.insts {
    if (ins.kind_tag == ssa.CALL && ins.args.len() > 0 && ins.args[0] >= 0 && root[ins.args[0]] == box) {
      return true;
    }
  }
  return false;
}

function drop_phi_edges(w: Walk, own pr: Pruned, phi: i32, box: i32, hold: boolean, depth: i32): Pruned {
  let ins = def_in(w, phi);
  let bi = w.defs.block[phi];
  if (ins.kind_tag != ssa.PHI || bi < 0 || depth >= 8 || util.index_of_i32(pr.phis, phi) >= 0) {
    return pr;
  }
  pr = Pruned { ...pr, phis: pr.phis.append(phi) };
  let b = w.f.blocks[bi];
  let i = 0;
  while (i < ins.args.len() && i < b.preds.len()) {
    let a = ins.args[i];
    let pb = w.at[b.preds[i]];
    if (a >= 0 && pb >= 0) {
      let zero = zero_at(w, a);
      if (zero == hold) {
        pr = drop_arm(w, pr, pb, b.id, box, zero);
      } else if (!zero && w.root[a] != w.root[phi] && w.root[a] != box && token_root(w, w.regions, a) == box) {
        pr = drop_phi_edges(w, pr, w.root[a], box, hold, depth + 1);
      }
    }
    i += 1;
  }
  return pr;
}

function drop_arm(w: Walk, own pr: Pruned, pb: i32, sid: i32, box: i32, zero: boolean): Pruned {
  if (!zero) {
    let at = util.index_of_i32(w.regions[pb], box);
    if (at >= 0 && at < w.openers[pb].len() && w.at[w.openers[pb][at]] >= 0) {
      let ob = w.at[w.openers[pb][at]];
      let t = w.f.blocks[ob].term;
      let c = cond_of(w, w.regions, t.cond, true);
      if (t.kind_tag == ssa.TERM_BRIF && c.root == box) {
        let arm = t.f;
        if (c.on_true) {
          arm = t.t;
        }
        return drop_edge(w, pr, ob, arm);
      }
    }
  }
  return drop_edge(w, pr, pb, sid);
}

function drop_edge(w: Walk, own pr: Pruned, pb: i32, sid: i32): Pruned {
  if (pr.dropped[pb] == sid) {
    return pr;
  }
  let t = pr.terms[pb];
  if (t.kind_tag == ssa.TERM_BRIF && t.t != t.f && (t.t == sid || t.f == sid)) {
    let other = t.f;
    if (t.f == sid) {
      other = t.t;
    }
    pr = Pruned { ...pr, dropped: pr.dropped.with(pb, sid), terms: pr.terms.with(pb, ssa.STerm { kind_tag: ssa.TERM_BR, cond: 0, target: other, t: 0, f: 0, value: -1 }) };
    return pr;
  }
  if (ssa.successor_id(t, 0) != sid) {
    return pr;
  }
  let end = ssa.STerm { kind_tag: ssa.TERM_RET, cond: 0, target: 0, t: 0, f: 0, value: -1 };
  pr = Pruned { ...pr, dropped: pr.dropped.with(pb, sid), terms: pr.terms.with(pb, end) };
  for pid in w.f.blocks[pb].preds {
    let pp = w.at[pid];
    if (pp >= 0) {
      pr = drop_edge(w, pr, pp, w.f.blocks[pb].id);
    }
  }
  return pr;
}

function reached_over(w: Walk, terms: ssa.STerm[]): boolean[] {
  let out = __alloc_bool(terms.len());
  let entry = w.at[w.f.entry];
  out = out.with(entry, true);
  let stack: i32[] = [entry];
  let sp = 1;
  while (sp > 0) {
    sp -= 1;
    let bi = stack[sp];
    for e in 0..2 {
      let sid = ssa.successor_id(terms[bi], e);
      if (sid >= 0 && w.at[sid] >= 0 && !out[w.at[sid]]) {
        out = out.with(w.at[sid], true);
        stack = pushed(stack, sp, w.at[sid]);
        sp += 1;
      }
    }
  }
  return out;
}

function without_dropped_preds(w: Walk, b: ssa.SBlock, dropped: i32[], reach: boolean[]): ssa.SBlock {
  let keep: boolean[] = [];
  let any = false;
  for pid in b.preds {
    let pb = w.at[pid];
    let k = pb < 0 || dropped[pb] != b.id && reach[pb];
    keep = keep.append(k);
    if (!k) {
      any = true;
    }
  }
  if (!any) {
    return b;
  }
  let preds: i32[] = [];
  for i in 0..b.preds.len() {
    if (keep[i]) {
      preds = preds.append(b.preds[i]);
    }
  }
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag == ssa.PHI) {
      let args: i32[] = [];
      for j in 0..ins.args.len() {
        if (j >= keep.len() || keep[j]) {
          args = args.append(ins.args[j]);
        }
      }
      if (args.len() == 1 && ins.args.len() > 1 && args[0] >= 0) {
        insts = insts.append(ssa.SInst { ir_kind: 0, kind_tag: ssa.COPY, result: ins.result, args: args, imm: 0, str: "" });
      } else {
        insts = insts.append(ssa.SInst { ...ins, args: args });
      }
    } else {
      insts = insts.append(ins);
    }
  }
  return ssa.SBlock { ...b, preds: preds, insts: insts };
}

struct Assumed { ok: boolean, w: Walk, p: Progress, rounds: i32 }

// The token's region under one value of the token. `on` is false where
// that value cannot reach the token's block.
struct TokenRegion { on: boolean, w: Walk, at: i32[], reach: boolean[] }

function pruned_walk(w: Walk, tok: i32, hold: boolean): TokenRegion {
  let pf = prune_token(w, tok, hold);
  let from = w.defs.block[tok];
  if (!ssadeps.reachable_blocks(pf.f)[from]) {
    return TokenRegion { on: false, w: w, at: [], reach: [] };
  }
  let sub = extracted(pf.f, w.at, from);
  let at = ssa.block_positions(sub);
  let dom = ssadeps.dominates_at(sub, at);
  let reach = ssadeps.reachable_from_dom(dom);
  let wa = walk_of(sub, w.irops, w.self_abi, w.abis, w.sigs, w.ops, at, dom, reach, pf.hold, base_of(w));
  return TokenRegion { on: true, w: wa, at: at, reach: reach };
}

function walk_assuming(w: Walk, lv: Live, p0: Progress, tok: i32, hold: boolean): Assumed {
  let pr = pruned_walk(w, tok, hold);
  if (!pr.on) {
    return Assumed { ok: true, w: w, p: progress_of(w, lv), rounds: 0 };
  }
  let wa = pr.w;
  let lva = live_of(wa, wa.takes);
  if (!lva.ok) {
    return Assumed { ok: false, w: wa, p: progress_of(wa, lva), rounds: 0 };
  }
  let pa = seeded(progress_of(wa, lva), wa, lva, pr.reach, w, lv, p0);
  let done = settle(pa, wa, lva, ssa.reverse_postorder(wa.f, pr.at), pr.reach, wa.takes);
  return Assumed { ok: !done.changed, w: wa, p: done.p, rounds: done.rounds };
}

// A load in the region of a tested token can be the frame's where the token
// is the box and a borrow where it is null. Such a load starts as a twin
// keyed on the token, with the count of its origin under each value. Where
// a value does not reach the load, that side is absent. The token's block
// dominates the load, so the token has the value of the current pass.
function token_loads(w: Walk, reach: boolean[], unproved: boolean[], maybe_at: i32[]): i32[] {
  let out: i32[] = [];
  while (out.len() < w.f.nvals) {
    out = out.append(absent());
  }
  let clash = __alloc_bool(w.f.nvals);
  for tok in tested_tokens(w, reach) {
    let from = w.defs.block[tok];
    if (from < 0 || count_true(decided_by(w, tok, unproved, maybe_at)) == 0) {
      continue;
    }
    let held = pruned_walk(w, tok, true);
    let null_tok = pruned_walk(w, tok, false);
    for bi in 0..w.f.blocks.len() {
      if (!reach[bi] || !ssadeps.dom_holds(w.dom, bi, from)) {
        continue;
      }
      for ins in w.f.blocks[bi].insts {
        let v = ins.result;
        if (!is_load(ins) || v < 0 || w.root[v] != v || w.idx[v] < 0) {
          continue;
        }
        let base = initial_count(w.origin[v]);
        let same = count_under(held, v);
        let apart = count_under(null_tok, v);
        if (same < 0 || apart < 0 || (same == base || same == no_side()) && (apart == base || apart == no_side())) {
          continue;
        }
        let s = twin(tok, same, apart);
        if (out[v] != absent() && out[v] != s) {
          clash = clash.with(v, true);
        }
        out = out.with(v, s);
      }
    }
  }
  for v in 0..clash.len() {
    if (clash[v]) {
      out = out.with(v, absent());
    }
  }
  return out;
}

// The units the origin of `v` gives it under one value of a token:
// `no_side()` where that value does not reach `v`, and -1 where the
// origin gives no plain count.
function count_under(pr: TokenRegion, v: i32): i32 {
  if (!pr.on) {
    return no_side();
  }
  let b = pr.w.defs.block[v];
  if (b < 0 || b >= pr.reach.len() || !pr.reach[b]) {
    return no_side();
  }
  let c = initial_count(pr.w.origin[v]);
  if (c < 0 || c > 1) {
    return -1;
  }
  return c;
}

function any_token_load(loads: i32[]): boolean {
  for s in loads {
    if (s != absent()) {
      return true;
    }
  }
  return false;
}

function extracted(f: ssa.SFunc, at: i32[], from: i32): ssa.SFunc {
  let region = reached_in(f, at, from, -1).with(from, true);
  let blocks: ssa.SBlock[] = [];
  let stubbed = __alloc_bool(f.blocks.len());
  let bi = 0;
  while (bi < f.blocks.len()) {
    if (region[bi]) {
      blocks = blocks.append(f.blocks[bi]);
    }
    bi += 1;
  }
  for bi in 0..f.blocks.len() {
    if (region[bi]) {
      for pid in f.blocks[bi].preds {
        let pb = at[pid];
        if (pb >= 0 && !region[pb] && !stubbed[pb]) {
          stubbed = stubbed.with(pb, true);
          blocks = blocks.append(ssa.SBlock { id: pid, insts: [], term: into_region(f.blocks[pb].term, at, region), preds: [] });
        }
      }
    }
  }
  return ssa.SFunc { ...f, blocks: blocks, entry: f.blocks[from].id };
}

function into_region(t: ssa.STerm, at: i32[], region: boolean[]): ssa.STerm {
  if (t.kind_tag != ssa.TERM_BRIF || t.t == t.f) {
    return t;
  }
  if (!region[at[t.f]]) {
    return ssa.STerm { kind_tag: ssa.TERM_BR, cond: 0, target: t.t, t: 0, f: 0, value: -1 };
  }
  if (!region[at[t.t]]) {
    return ssa.STerm { kind_tag: ssa.TERM_BR, cond: 0, target: t.f, t: 0, f: 0, value: -1 };
  }
  return t;
}

function seeded(own pa: Progress, wa: Walk, lva: Live, region: boolean[], w: Walk, lv: Live, p0: Progress): Progress {
  let roots = slot_roots(wa);
  for bi in 0..wa.f.blocks.len() {
    if (region[bi]) {
      let b = wa.f.blocks[bi];
      for pi in 0..b.preds.len() {
        let pb = wa.at[b.preds[pi]];
        if (pb >= 0 && !region[pb]) {
          pa = Progress { ...pa, done: pa.done.with(pb, true) };
          pa = seed_edge(pa, wa, lva, roots, bi, pi, w, lv, p0);
        }
      }
    }
  }
  return pa;
}

function seed_edge(own pa: Progress, wa: Walk, lva: Live, roots: i32[], bi: i32, pi: i32, w: Walk, lv: Live, p0: Progress): Progress {
  let b = wa.f.blocks[bi];
  let pid = b.preds[pi];
  let pb = wa.at[pid];
  let bb = w.at[b.id];
  let pb0 = util.index_of_i32(w.f.blocks[bb].preds, pid);
  let base0 = edge_base(w, lv, w.at[pid], b.id);
  for ins in b.insts {
    if (ins.kind_tag == ssa.PHI && ins.result >= 0 && wa.idx[ins.result] >= 0) {
      let v = maybe();
      if (w.idx[ins.result] >= 0 && pb0 >= 0) {
        v = p0.phin[p0.phi_at[ins.result] + pb0];
      }
      pa = Progress { ...pa, phin: pa.phin.with(pa.phi_at[ins.result] + pi, v) };
    }
  }
  let base = edge_base(wa, lva, pb, b.id);
  if (base < 0) {
    return pa;
  }
  let j = 0;
  while (j < lva.in_n[bi]) {
    let k = lva.slots[lva.in_at[bi] + j];
    let r = roots[k];
    let v = base_count(w, lv, p0, base0, bb, r);
    for ins in b.insts {
      if (ins.kind_tag == ssa.COPY && ins.result >= 0 && ins.args.len() == 1 && wa.root[ins.result] == r && w.idx[ins.result] >= 0 && pb0 >= 0 && is_phi(w, ins.result)) {
        v = add_counts(v, p0.phin[p0.phi_at[ins.result] + pb0]);
      }
    }
    pa = Progress { ...pa, out: pa.out.with(base + j, v) };
    j += 1;
  }
  return pa;
}

function is_phi(w: Walk, v: i32): boolean {
  return def_in(w, v).kind_tag == ssa.PHI;
}

function base_count(w: Walk, lv: Live, p0: Progress, base0: i32, bi: i32, r: i32): i32 {
  let kb = -1;
  if (r >= 0 && r < w.idx.len()) {
    kb = w.idx[r];
  }
  if (kb < 0) {
    if (r >= 0 && r < w.origin.len() && (w.origin[r] == org_borrowed() || w.origin[r] == org_none())) {
      return 0;
    }
    return absent();
  }
  if (base0 < 0) {
    return absent();
  }
  let j = 0;
  while (j < lv.in_n[bi]) {
    if (lv.slots[lv.in_at[bi] + j] == kb) {
      return p0.out[base0 + j];
    }
    j += 1;
  }
  return absent();
}

function add_counts(a: i32, b: i32): i32 {
  if (a == absent()) {
    return b;
  }
  if (b == absent()) {
    return a;
  }
  if (a == maybe() || b == maybe() || a == owed() || b == owed()) {
    return maybe();
  }
  if (is_free(a) || is_free(b)) {
    let ca = units(a);
    let cb = units(b);
    if (ca < 0) {
      return holding(cb, true);
    }
    if (cb < 0) {
      return holding(ca, true);
    }
    return holding(ca + cb, true);
  }
  if (a + b > cap()) {
    return maybe();
  }
  return a + b;
}

function with_findings(own out: Finding[], more: Finding[]): Finding[] {
  for x in more {
    let seen = false;
    for j in 0..out.len() {
      let y = out[j];
      if (y.kind == x.kind && y.value == x.value && y.block == x.block) {
        seen = true;
      }
    }
    if (!seen) {
      out = out.append(x);
    }
  }
  return out;
}

function slot_roots(w: Walk): i32[] {
  let out = util.minus_ones(w.tracked);
  for v in 0..w.idx.len() {
    if (w.idx[v] >= 0) {
      out = out.with(w.idx[v], v);
    }
  }
  return out;
}

function flagged_roots(flags: boolean[], roots: i32[]): i32[] {
  let out: i32[] = [];
  for k in 0..flags.len() {
    if (flags[k]) {
      out = out.append(roots[k]);
    }
  }
  return out;
}

function unproved_under(a: Assumed, v: i32): boolean {
  let k = a.w.idx[v];
  return k >= 0 && a.p.unproved[k];
}

function still_unproved(own flags: boolean[], decides: boolean[], roots: i32[], a: Assumed, b: Assumed): boolean[] {
  let k = 0;
  while (k < flags.len()) {
    if (flags[k] && decides[k] && !unproved_under(a, roots[k]) && !unproved_under(b, roots[k])) {
      flags = flags.with(k, false);
    }
    k += 1;
  }
  return flags;
}

function decided_by(w: Walk, tok: i32, unproved: boolean[], maybe_at: i32[]): boolean[] {
  let out = __alloc_bool(unproved.len());
  let from = w.defs.block[tok];
  if (from < 0) {
    return out;
  }
  let infl = reached_from(w, from);
  for k in 0..unproved.len() {
    if (unproved[k] && maybe_at[k] >= 0 && (maybe_at[k] == from || infl[maybe_at[k]])) {
      out = out.with(k, true);
    }
  }
  return out;
}

function most(a: i32, b: i32): i32 {
  return if (a > b) { a } else { b };
}

function count_true(flags: boolean[]): i32 {
  let n = 0;
  for u in flags {
    if (u) {
      n += 1;
    }
  }
  return n;
}

pub function certify(f: ssa.SFunc, irops: ir.Op[], self_abi: Abi, abis: Abis, sigs: rcsigs.Table, ops: rcsigs.OpTable): Report {
  let dense = rcccompact.compact(f);
  let report = certify_graph(dense.f, irops, self_abi, abis, sigs, ops);
  if (dense.original.len() == 0) {
    return report;
  }
  let findings: Finding[] = [];
  for x in report.findings {
    let value = x.value;
    if (value >= 0 && value < dense.original.len()) {
      value = dense.original[value];
    }
    findings = findings.append(Finding { kind: x.kind, value: value, block: x.block, defined: x.defined, message: x.message });
  }
  let unproved_at: i32[] = [];
  for v in report.unproved_at {
    if (v >= 0 && v < dense.original.len()) {
      unproved_at = unproved_at.append(dense.original[v]);
    } else {
      unproved_at = unproved_at.append(v);
    }
  }
  return Report { ...report, findings: findings, unproved_at: unproved_at };
}

function certify_graph(f0: ssa.SFunc, irops: ir.Op[], self_abi: Abi, abis: Abis, sigs: rcsigs.Table, ops: rcsigs.OpTable): Report {
  if (f0.blocks.len() == 0) {
    return failed("no blocks");
  }
  let f = ended_at_exit(f0);
  let at = ssa.block_positions(f);
  if (f.entry < 0 || f.entry >= at.len() || at[f.entry] < 0) {
    return failed("no entry block");
  }
  // irverifygate.certify_body_or_refuse gives the body from before the frame.
  if (resumes(f)) {
    return failed("resumes from a task frame, which the certifier does not model");
  }
  let dom = ssadeps.dominates_at(f, at);
  let reach = ssadeps.reachable_from_dom(dom);
  let w = walk_of(f, irops, self_abi, abis, sigs, ops, at, dom, reach, no_hold(), no_base());
  let lv = live_of(w, w.takes);
  if (!lv.ok) {
    return failed("liveness: " + lv.why);
  }
  let done = settle(progress_of(w, lv), w, lv, ssa.reverse_postorder(f, at), reach, w.takes);
  if (done.changed) {
    return failed("did not settle in " + util.i32_to_string(round_limit()) + " rounds");
  }
  // A callee that no table or ABI describes may keep or spend any argument.
  if (done.p.opaque.len() > 0) {
    return failed("calls " + done.p.opaque[0] + ", which has no rc signature and no ABI");
  }
  // A finding of the walk before the twins is a finding too.
  let first: Finding[] = [];
  if (count_true(done.p.unproved) > 0) {
    let loads = token_loads(w, reach, done.p.unproved, done.p.maybe_at);
    if (any_token_load(loads)) {
      let wt = Walk { ...w, token_loads: loads };
      let again = settle(progress_of(wt, lv), wt, lv, ssa.reverse_postorder(f, at), reach, wt.takes);
      if (again.changed) {
        return failed("did not settle in " + util.i32_to_string(round_limit()) + " rounds");
      }
      first = done.p.findings;
      w = wt;
      done = Settled { ...again, rounds: most(done.rounds, again.rounds) };
    }
  }
  let findings = with_findings(first, done.p.findings);
  let unproved = done.p.unproved;
  let rounds = done.rounds;
  if (count_true(unproved) > 0) {
    let roots = slot_roots(w);
    for tok in tested_tokens(w, reach) {
      let decides = decided_by(w, tok, unproved, done.p.maybe_at);
      if (count_true(decides) == 0) {
        continue;
      }
      let held = walk_assuming(w, lv, done.p, tok, true);
      let null_tok = walk_assuming(w, lv, done.p, tok, false);
      rounds = most(rounds, most(held.rounds, null_tok.rounds));
      if (held.ok && null_tok.ok) {
        findings = with_findings(findings, held.p.findings);
        findings = with_findings(findings, null_tok.p.findings);
        unproved = still_unproved(unproved, decides, roots, held, null_tok);
      }
    }
  }
  return Report { findings: findings, tracked: w.tracked, unproved: count_true(unproved), unproved_at: flagged_roots(unproved, slot_roots(w)), opaque: done.p.opaque, failed: "", rounds: rounds };
}
