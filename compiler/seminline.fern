import "./ssa";
import "./sourcepos";
import "./util";
import "./ssasem";
import "./typeinfo";
import "./semtypes";
import "./semrecords";
import "./sempair";
import "./semdead";
import "./ownership";
import "./ssabytes";

function max_leaf_insts(): i32 {
  return 40;
}

function max_leaf_blocks(): i32 {
  return 16;
}

function code_blocks(g: ssa.SFunc): i32 {
  let n: i32 = 0;
  for b in g.blocks {
    if (b.term.kind_tag != 2 || !only_constants(b.insts)) {
      n = n + 1;
    }
  }
  return n;
}

function only_constants(insts: ssa.SInst[]): boolean {
  for ins in insts {
    if (ins.kind_tag != 1 && ins.kind_tag != 2) {
      return false;
    }
  }
  return true;
}

function max_once_insts(): i32 {
  return 400;
}

function max_shared_callers(): i32 {
  return 2;
}

function max_shared_insts(): i32 {
  return 100;
}

function max_reuse_shared_insts(): i32 {
  return 500;
}

function max_splices(): i32 {
  return 64;
}

function max_caller_insts(): i32 {
  return 1500;
}

function max_box_saving_caller_insts(): i32 {
  return 6000;
}

pub struct Inlined { funcs: ssasem.Func[], rewritten: boolean[], spliced: boolean[] }

struct Rewrite { f: ssasem.Func, changed: boolean }

pub function inline_leaves(funcs0: ssasem.Func[], names: string[], modes: i32[][], inlinable: boolean[], rewrite: boolean[], unnamed: boolean[], uncalled: boolean[], size: boolean): Inlined {
  let ix: util.NameIndex = util.name_index(names);
  let calls: i32[] = call_counts(funcs0, ix);
  let sp: Spliceable = splice_plan(funcs0, ix, calls, inlinable, unnamed, size);
  let done: Rounds = splice_rounds(funcs0, rewrite, modes, sp);
  let rounds: Inlined = done.out;
  sp = grown_leaves(rounds, done.sp);
  let ctors: boolean[] = constructor_leaves(rounds.funcs, sp);
  let out: Inlined = split_all(paired_all(rounds, names, rewrite, uncalled), rewrite, modes);
  dump_wanted(out.funcs);
  return Inlined { ...out, spliced: spliced_away(sp, ctors, calls, call_counts(out.funcs, ix)) };
}

function splice_plan(funcs0: ssasem.Func[], ix: util.NameIndex, calls: i32[], inlinable: boolean[], unnamed: boolean[], size: boolean): Spliceable {
  let cycle: i32[] = ownership.cycles(callees_of_all(funcs0, ix));
  let leaves: boolean[] = [];
  let once: boolean[] = [];
  let shared: boolean[] = [];
  let small: boolean[] = [];
  let i: i32 = 0;
  while (i < funcs0.len()) {
    let f: ssasem.Func = funcs0[i];
    let is_leaf: boolean = leaf_spliceable(f, inlinable[i], size);
    let other: boolean = !is_leaf && inlinable[i] && unnamed[i];
    let is_shared: boolean = !size && !is_leaf && inlinable[i] && shared_body(f, calls[i], cycle[i], unnamed[i]);
    small = small.append(is_shared && small_shared_body(f));
    leaves = leaves.append(is_leaf);
    shared = shared.append(is_shared);
    once = once.append(is_shared || other && once_spliceable(f, calls[i]));
    i = i + 1;
  }
  return Spliceable { ix: ix, leaves: leaves, once: once, shared: shared, small: small, inlinable: inlinable, calls: calls, unnamed: unnamed, cycle: cycle, size: size };
}

function dump_wanted(funcs: ssasem.Func[]): void {
  match (env("FERN_SEM_DUMP")) {
    Some(want) => {
      for f in funcs {
        if (f.graph.name == want) {
          dump_func(f);
        }
      }
    },
    None => {}
  }
}

function dump_func(f: ssasem.Func): void {
  eprint("FUNC " + f.graph.name + " entry=" + util.i32_to_string(f.graph.entry) + " nvals=" + util.i32_to_string(f.graph.nvals));
  for b in f.graph.blocks {
    let preds: string = "";
    for p in b.preds {
      preds = preds + util.i32_to_string(p) + ",";
    }
    eprint("BLOCK " + util.i32_to_string(b.id) + " preds=" + preds);
    for ins in b.insts {
      let args: string = "";
      for a in ins.args {
        args = args + util.i32_to_string(a) + ",";
      }
      eprint("  v" + util.i32_to_string(ins.result) + " = k" + util.i32_to_string(ins.kind_tag) + " [" + args + "] imm=" + util.i32_to_string(ins.imm) + " " + ins.str);
    }
    eprint("  TERM k" + util.i32_to_string(b.term.kind_tag) + " cond=" + util.i32_to_string(b.term.cond) + " target=" + util.i32_to_string(b.term.target) + " t=" + util.i32_to_string(b.term.t) + " f=" + util.i32_to_string(b.term.f) + " value=" + util.i32_to_string(b.term.value));
  }
}

function leaf_spliceable(f: ssasem.Func, inlinable: boolean, size: boolean): boolean {
  return !size && inlinable && (leaf(f) || updater(f));
}

function once_spliceable(f: ssasem.Func, calls: i32): boolean {
  return calls == 1 && !lends_view(f) && spliceable(f, max_once_insts());
}

function shared_spliceable(f: ssasem.Func, calls: i32, cycle: i32): boolean {
  return calls > 1 && calls <= max_shared_callers() && !lends_view(f) && spliceable(f, max_reuse_shared_insts()) && returns_boxes(f)
    && cycle < 0;
}

function shared_body(f: ssasem.Func, calls: i32, cycle: i32, unnamed: boolean): boolean {
  return cycle < 0 && record_leaf(f) || unnamed && shared_spliceable(f, calls, cycle);
}

function small_shared_body(f: ssasem.Func): boolean {
  return count_insts(f.graph) <= max_shared_insts() || record_leaf(f);
}

function record_leaf(f: ssasem.Func): boolean {
  return scalar_record(f, f.result) && leaf_body_limit(f, 0 - 1, max_once_insts());
}

function scalar_record(f: ssasem.Func, t: typeinfo.Type): boolean {
  let at: i32 = semrecords.find(f.records, t);
  if (at < 0 || ssasem.has_finalizer(f, t)) {
    return false;
  }
  for field in f.records.list[at].fields {
    if (!scalar(field.ty)) {
      return false;
    }
  }
  return true;
}

function returns_boxes(f: ssasem.Func): boolean {
  let defs: Defs = defs_of(f.graph);
  let boxed: boolean = false;
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1) {
      let r: Returned = returned(defs, b.term.value, 0);
      if (!r.ok) {
        return false;
      }
      boxed = boxed || r.boxed;
    }
  }
  return boxed;
}

struct Returned { ok: boolean, boxed: boolean }

function returned(defs: Defs, v: i32, depth: i32): Returned {
  let d: ssa.SInst = def_inst(defs, through_copies(defs, v));
  if (d.kind_tag == 8 && depth < 8) {
    let boxed: boolean = false;
    for a in d.args {
      let r: Returned = returned(defs, a, depth + 1);
      if (!r.ok) {
        return r;
      }
      boxed = boxed || r.boxed;
    }
    return Returned { ok: true, boxed: boxed };
  }
  if (!construction_kind(d.kind_tag)) {
    return Returned { ok: false, boxed: false };
  }
  let boxed: boolean = d.kind_tag == ssasem.record_new() || d.kind_tag == ssasem.tuple_new() && d.args.len() != 2
    || d.kind_tag == ssasem.variant_new() && d.args.len() > 0 || holds_construction(defs, d);
  return Returned { ok: true, boxed: boxed };
}

function holds_construction(defs: Defs, d: ssa.SInst): boolean {
  for a in d.args {
    if (construction_kind(def_inst(defs, through_copies(defs, a)).kind_tag)) {
      return true;
    }
  }
  return false;
}

function spliced_away(sp: Spliceable, ctors: boolean[], calls: i32[], left: i32[]): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < calls.len()) {
    out = out.append((sp.leaves[i] || sp.once[i] || ctors[i]) && calls[i] > 0 && left[i] == 0);
    i = i + 1;
  }
  return out;
}

struct Spliceable { ix: util.NameIndex, leaves: boolean[], once: boolean[], shared: boolean[], small: boolean[], inlinable: boolean[], calls: i32[], unnamed: boolean[], cycle: i32[], size: boolean }

struct Rounds { out: Inlined, sp: Spliceable }

function splice_rounds(funcs0: ssasem.Func[], rewrite: boolean[], modes: i32[][], sp: Spliceable): Rounds {
  let out: Inlined = Inlined { funcs: funcs0, rewritten: [], spliced: [] };
  let alone: boolean[] = [];
  let i: i32 = 0;
  while (i < funcs0.len()) {
    out = Inlined { ...out, rewritten: out.rewritten.append(false) };
    alone = alone.append(sp.once[i] && !sp.shared[i]);
    i = i + 1;
  }
  let once: boolean[] = alone;
  let sizes: i32[] = sizes_of(funcs0);
  let callees: i32[][] = callees_of_all(funcs0, sp.ix);
  let folded: boolean = false;
  let round: i32 = 0;
  let more: boolean = true;
  let s: Spliceable = sp;
  while (more && round < 16) {
    s = grown_leaves(out, s);
    if (folded) {
      s = grown_shared(out, s);
      once = s.once;
    }
    let ctors: boolean[] = constructor_leaves(out.funcs, s);
    let ready: boolean[] = [];
    let j: i32 = 0;
    while (j < out.funcs.len()) {
      ready = ready.append(s.leaves[j] || ctors[j] || once[j] && !awaits(out.funcs[j], s.ix, once, s.shared, s.small, j));
      j = j + 1;
    }
    let next: Round = splice_round(out, sizes, callees, rewrite, modes, s.ix, ready, ctors, if (folded) { s.shared } else { none_of(s.shared.len()) }, s.small);
    more = next.changed;
    sizes = next.sizes;
    callees = next.callees;
    if (!more && !folded) {
      folded = true;
      once = s.once;
      more = true;
    }
    out = next.out;
    round = round + 1;
  }
  return Rounds { out: out, sp: s };
}

function grown_leaves(sofar: Inlined, sp: Spliceable): Spliceable {
  if (sp.size) {
    return sp;
  }
  let leaves: boolean[] = sp.leaves;
  let i: i32 = 0;
  while (i < sofar.funcs.len()) {
    if (!leaves[i] && sofar.rewritten[i] && sp.inlinable[i] && (leaf(sofar.funcs[i]) || updater(sofar.funcs[i]))) {
      leaves = leaves.with(i, true);
    }
    i = i + 1;
  }
  return Spliceable { ...sp, leaves: leaves };
}

function grown_shared(sofar: Inlined, sp: Spliceable): Spliceable {
  if (sp.size) {
    return sp;
  }
  let shared: boolean[] = sp.shared;
  let once: boolean[] = sp.once;
  let small: boolean[] = sp.small;
  let i: i32 = 0;
  while (i < sofar.funcs.len()) {
    if (!shared[i] && !sp.leaves[i] && sofar.rewritten[i] && sp.inlinable[i] && shared_body(sofar.funcs[i], sp.calls[i], sp.cycle[i], sp.unnamed[i])) {
      shared = shared.with(i, true);
      once = once.with(i, true);
      small = small.with(i, small_shared_body(sofar.funcs[i]));
    }
    i = i + 1;
  }
  return Spliceable { ...sp, shared: shared, once: once, small: small };
}

struct Round { out: Inlined, changed: boolean, sizes: i32[], callees: i32[][] }

function splice_round(prev: Inlined, own sizes: i32[], own callees: i32[][], rewrite: boolean[], modes: i32[][], ix: util.NameIndex, ready: boolean[], ctors: boolean[], shared: boolean[], small: boolean[]): Round {
  let funcs: ssasem.Func[] = prev.funcs;
  let rewritten: boolean[] = prev.rewritten;
  let changed: boolean = false;
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (rewrite[i] && (sizes[i] <= max_caller_insts() || sizes[i] <= max_box_saving_caller_insts() && any_box_saving(funcs, sizes, callees[i], ready, shared)) && any_ready(callees[i], ready)) {
      let spliced: Rewrite = splice_calls(funcs[i], sizes[i], i, funcs, sizes, ix, ready, ctors, shared, small, false);
      if (spliced.changed) {
        spliced = Rewrite { ...spliced, f: semdead.prune(split_constructions(spliced.f, modes[i]).f).f };
      }
      if (spliced.changed) {
        sizes = sizes.with(i, count_insts(spliced.f.graph));
        callees = callees.with(i, callees_of(spliced.f, ix));
        funcs = funcs.with(i, spliced.f);
        rewritten = rewritten.with(i, true);
        changed = true;
      }
    }
    i = i + 1;
  }
  return Round { out: Inlined { ...prev, funcs: funcs, rewritten: rewritten }, changed: changed, sizes: sizes, callees: callees };
}

function paired_all(prev: Inlined, names: string[], rewrite: boolean[], uncalled: boolean[]): Inlined {
  let p: sempair.Paired = sempair.pair_returns(prev.funcs, names, rewrite, uncalled);
  let funcs: ssasem.Func[] = p.funcs;
  let rewritten: boolean[] = prev.rewritten;
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (p.changed[i]) {
      funcs = funcs.with(i, drop_unread(funcs[i]).f);
      rewritten = rewritten.with(i, true);
    }
    i = i + 1;
  }
  return Inlined { ...prev, funcs: funcs, rewritten: rewritten };
}

function split_all(prev: Inlined, rewrite: boolean[], modes: i32[][]): Inlined {
  let funcs: ssasem.Func[] = prev.funcs;
  let rewritten: boolean[] = prev.rewritten;
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (rewrite[i]) {
      let split: Rewrite = split_constructions(funcs[i], modes[i]);
      funcs = funcs.with(i, split.f);
      rewritten = rewritten.with(i, rewritten[i] || split.changed);
    }
    i = i + 1;
  }
  return Inlined { ...prev, funcs: funcs, rewritten: rewritten };
}

function lends_view(f: ssasem.Func): boolean {
  for p in f.params {
    if (ssasem.holds_view(f, p)) {
      return true;
    }
  }
  return ssasem.holds_view(f, f.result);
}

function call_counts(funcs: ssasem.Func[], ix: util.NameIndex): i32[] {
  let out: i32[] = __alloc_i32(funcs.len());
  for f in funcs {
    for b in f.graph.blocks {
      for ins in b.insts {
        let j: i32 = called(ins, ix);
        if (j >= 0) {
          out = out.with(j, out[j] + 1);
        }
      }
    }
  }
  return out;
}

function called(ins: ssa.SInst, ix: util.NameIndex): i32 {
  if (ins.kind_tag != ssasem.call()) {
    return 0 - 1;
  }
  return ix.find(ins.str);
}

function awaits(f: ssasem.Func, ix: util.NameIndex, once: boolean[], shared: boolean[], small: boolean[], self: i32): boolean {
  let whole: boolean[] = [];
  for b in f.graph.blocks {
    for ins in b.insts {
      let j: i32 = called(ins, ix);
      if (j >= 0 && j != self && once[j]) {
        if (!shared[j]) {
          return true;
        }
        if (whole.len() == 0) {
          whole = sempair.whole_values(f, ix, shared, false);
        }
        if (small[j] && !whole_at(whole, ins.result) || returned_only(f, ins.result) && takes_apart(f, ins.result)) {
          return true;
        }
      }
    }
  }
  return false;
}

function spliceable(f: ssasem.Func, limit: i32): boolean {
  if (f.graph.takes_env || f.graph.blocks.len() == 0 || f.graph.blocks[f.graph.entry].preds.len() > 0) {
    return false;
  }
  let returns: boolean = false;
  for b in f.graph.blocks {
    if (b.term.kind_tag < 1 || b.term.kind_tag > 4) {
      return false;
    }
    returns = returns || b.term.kind_tag == 1;
  }
  return returns && count_insts(f.graph) <= limit;
}

pub function inline_closures(funcs: ssasem.Func[], names: string[], modes: i32[][], inlinable: boolean[], rewrite: boolean[]): ssasem.Func[] {
  let any: boolean = false;
  for changed in rewrite {
    any = any || changed;
  }
  if (!any) {
    return funcs;
  }
  let ix: util.NameIndex = util.name_index(names);
  let candidates: ssasem.Func[] = inline_leaves(funcs, names, modes, inlinable, inlinable, inlinable, inlinable, false).funcs;
  let callbacks: boolean[] = [];
  let ci: i32 = 0;
  while (ci < candidates.len()) {
    callbacks = callbacks.append(inlinable[ci] && unused_environment(candidates[ci]) >= 0);
    ci = ci + 1;
  }
  candidates = inline_leaves(candidates, names, modes, inlinable, callbacks, inlinable, inlinable, false).funcs;
  let leaves: boolean[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let env: i32 = unused_environment(candidates[i]);
    leaves = leaves.append(inlinable[i] && env >= 0 && leaf_body(candidates[i], env));
    i = i + 1;
  }
  let sizes: i32[] = sizes_of(candidates);
  let out: ssasem.Func[] = [];
  i = 0;
  while (i < funcs.len()) {
    let f: ssasem.Func = funcs[i];
    let size: i32 = count_insts(f.graph);
    if (rewrite[i] && size <= max_caller_insts()) {
      f = drop_unread(splice_calls(f, size, i, candidates, sizes, ix, leaves, none_of(candidates.len()), none_of(candidates.len()), none_of(candidates.len()), true).f).f;
    }
    out = out.append(f);
    i = i + 1;
  }
  return out;
}

function parameter_value(f: ssasem.Func, index: i32): i32 {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.param() && ins.imm == index) {
        return ins.result;
      }
    }
  }
  return 0 - 1;
}

function reads(g: ssa.SFunc, value: i32): boolean {
  for b in g.blocks {
    for ins in b.insts {
      for arg in ins.args {
        if (arg == value) {
          return true;
        }
      }
    }
    if (b.term.kind_tag == 1 && b.term.value == value || b.term.kind_tag == 3 && b.term.cond == value) {
      return true;
    }
  }
  return false;
}

function unused_environment(f: ssasem.Func): i32 {
  let contract: ssasem.Contract = ssasem.Contract { name: f.graph.name, params: f.params, modes: [], result: f.result };
  if (!ssasem.closure_env(contract) || ssasem.closure_captures(contract).len() != 0) {
    return 0 - 1;
  }
  let env: i32 = parameter_value(f, 0);
  if (env < 0 || reads(f.graph, env)) {
    return 0 - 1;
  }
  return env;
}

function scalar(t: typeinfo.Type): boolean {
  return ssasem.is_integer(t) || ssasem.is_float(t) || ssasem.is_bool(t) || ssasem.is_char(t);
}

function scalar_tuple(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(tt) = t {
    for e in tt.elements {
      if (!scalar(e)) {
        return false;
      }
    }
    return tt.elements.len() > 0;
  }
  return false;
}

function leaf_word(f: ssasem.Func, t: typeinfo.Type): boolean {
  if (scalar(t)) {
    return true;
  }
  if let typeinfo.TypeTuple(tt) = t {
    for e in tt.elements {
      if (!scalar(e) && !(ssasem.reference(e) && !ssasem.holds_view(f, e))) {
        return false;
      }
    }
    return tt.elements.len() > 0;
  }
  return ssasem.reference(t) && !ssasem.holds_view(f, t);
}

function member_read(f: ssasem.Func, ins: ssa.SInst): boolean {
  let e: i32 = semrecords.find_enum(f.enums, f.values[ins.args[0]]);
  return e >= 0 && f.enums[e].layout == semrecords.layout_member();
}

function leaf_kind(k: i32): boolean {
  return k >= 1 && k <= 10 && k != 5 || k == ssasem.cast() || k == ssasem.tuple_new() || k == ssasem.tuple_get()
    || k == ssasem.record_get() || k == ssasem.variant_is() || k == ssasem.variant_get() || k == ssasem.variant_new()
    || line_mark(k);
}

function leaf_array_op(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.kind_tag != ssasem.append() && ins.kind_tag != ssasem.with()) {
    return false;
  }
  if let typeinfo.TypeArray(a) = f.values[ins.args[0]] {
    return !a.view && scalar(a.elem);
  }
  return false;
}

// A scalar element or word read borrows its array or view and carries no
// ownership units.
function leaf_element_read(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.result < 0 || !scalar(f.values[ins.result]) && !ssasem.is_usize(f.values[ins.result])) {
    return false;
  }
  if (ins.kind_tag == ssasem.array_get()) {
    return ins.args.len() == 2;
  }
  return ins.kind_tag == ssasem.call() && word_read(ins.str);
}

// A view parameter that only element and word reads use ends its borrow
// inside the leaf, so the leaf may be spliced.
function read_view_param(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.kind_tag != ssasem.param()) {
    return false;
  }
  for b in f.graph.blocks {
    for reader in b.insts {
      let k: i32 = 0;
      while (k < reader.args.len()) {
        if (reader.args[k] == ins.result && (k != 0 || !leaf_element_read(f, reader))) {
          return false;
        }
        k = k + 1;
      }
    }
    if (b.term.value == ins.result && b.term.kind_tag == 1 || b.term.cond == ins.result && b.term.kind_tag == 3) {
      return false;
    }
  }
  return true;
}

function word_read(name: string): boolean {
  return name == ssabytes.word_name(4) || name == ssabytes.word_name(8) || name == ssabytes.swap_name(4) || name == ssabytes.swap_name(8)
    || name == "__raw_arr_ptr" || name == "__load_i32" || name == "__load_i64";
}

// Scalar fields carry no ownership units. Keep finalizers out of this rule.
function leaf_record_build(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (ins.kind_tag != ssasem.record_new() || ins.result < 0 || !scalar_record(f, f.values[ins.result])) {
    return false;
  }
  for arg in ins.args {
    if (!scalar(f.values[arg])) {
      return false;
    }
  }
  return true;
}

// A scalar call can remain in a record builder after the builder is spliced.
// Its operands carry no ownership units and its result cannot be this builder.
function leaf_record_call(f: ssasem.Func, ins: ssa.SInst): boolean {
  if (!record(f.result) || ins.kind_tag != ssasem.call() || ins.result < 0 || !scalar(f.values[ins.result])) {
    return false;
  }
  for arg in ins.args {
    if (!scalar(f.values[arg])) {
      return false;
    }
  }
  return true;
}

function record(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  return false;
}

function void_type(t: typeinfo.Type): boolean {
  if let typeinfo.TypeVoid(_) = t {
    return true;
  }
  return false;
}

function leaf(f: ssasem.Func): boolean {
  return leaf_body(f, 0 - 1);
}

function updater(f: ssasem.Func): boolean {
  if (!updater_shape(f)) {
    return false;
  }
  let b: ssa.SBlock = f.graph.blocks[0];
  let built: i32 = 0 - 1;
  let n: i32 = 0;
  for ins in b.insts {
    let role: i32 = updater_role(f, ins);
    if (role < 0 || role == 2 && built >= 0) {
      return false;
    }
    if (role == 2) {
      built = ins.result;
    }
    if (role > 0) {
      n = n + 1;
    }
  }
  return built >= 0 && b.term.value == built && n <= max_leaf_insts();
}

function updater_shape(f: ssasem.Func): boolean {
  return straight(f) && !f.graph.takes_env && !lends_view(f) && record(f.result);
}

function updater_role(f: ssasem.Func, ins: ssa.SInst): i32 {
  let k: i32 = ins.kind_tag;
  if (k == ssasem.param() || line_mark(k)) {
    return 0;
  }
  if (literal_kind(k) || k == 7 || k == ssasem.record_get() || k == ssasem.with() || k == ssasem.append()) {
    return 1;
  }
  if (k == ssasem.record_new() && record_param(f, ssasem.update_base(ins))) {
    return 2;
  }
  return 0 - 1;
}

function record_param(f: ssasem.Func, v: i32): boolean {
  if (v < 0 || v >= f.values.len() || !record(f.values[v])) {
    return false;
  }
  for ins in f.graph.blocks[f.graph.entry].insts {
    if (ins.kind_tag == ssasem.param() && ins.result == v) {
      return true;
    }
  }
  return false;
}

function constructor_leaves(funcs: ssasem.Func[], sp: Spliceable): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    out = out.append(sp.inlinable[i] && !sp.leaves[i] && (!sp.once[i] || sp.shared[i]) && constructor_body(funcs[i]));
    i = i + 1;
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    i = 0;
    while (i < funcs.len()) {
      if (out[i] && !calls_constructors(funcs[i], sp.ix, out, i)) {
        out = out.with(i, false);
        changed = true;
      }
      i = i + 1;
    }
  }
  return out;
}

function constructor_body(f: ssasem.Func): boolean {
  if (f.graph.takes_env || code_blocks(f.graph) > max_leaf_blocks() || lends_view(f)) {
    return false;
  }
  if (f.graph.blocks[f.graph.entry].preds.len() > 0) {
    return false;
  }
  let returned: i32 = 0 - 1;
  let n: i32 = 0;
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1) {
      if (returned >= 0 || b.term.value < 0) {
        return false;
      }
      returned = b.term.value;
    } else if (b.term.kind_tag != 2) {
      return false;
    }
    if (b.id != f.graph.blocks[f.graph.entry].id && b.preds.len() != 1) {
      return false;
    }
    for ins in b.insts {
      if (!constructor_kind(ins.kind_tag) && !negation(ins)) {
        return false;
      }
      if (ins.kind_tag != ssasem.param() && !line_mark(ins.kind_tag)) {
        n = n + 1;
      }
    }
  }
  return returned >= 0 && (n <= max_leaf_insts() || f.params.len() == 0) && built_kind(defs_of(f.graph).insts[returned].kind_tag);
}

function constructor_kind(k: i32): boolean {
  return literal_kind(k) || k == ssasem.param() || k == 7 || line_mark(k) || k == ssasem.call() || built_kind(k);
}

function built_kind(k: i32): boolean {
  return construction_kind(k) || k == ssasem.variant_up();
}

function negation(ins: ssa.SInst): boolean {
  return ins.kind_tag == 10 && ins.str == "-";
}

function line_mark(k: i32): boolean {
  return k == 35;
}

function construction_kind(k: i32): boolean {
  return k == ssasem.record_new() || k == ssasem.variant_new() || k == ssasem.tuple_new() || k == ssasem.array_new() || k == ssasem.bytes_new();
}

function literal_kind(k: i32): boolean {
  return k >= 1 && k <= 5;
}

function calls_constructors(f: ssasem.Func, ix: util.NameIndex, ctors: boolean[], self: i32): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call()) {
        let j: i32 = ix.find(ins.str);
        if (j < 0 || j == self || !ctors[j]) {
          return false;
        }
      }
    }
  }
  return true;
}

function literal_args(b: ssa.SBlock, k: i32): boolean {
  for a in b.insts[k].args {
    if (!literal_before(b, k, a)) {
      return false;
    }
  }
  return true;
}

function literal_before(b: ssa.SBlock, k: i32, v: i32): boolean {
  let j: i32 = k - 1;
  while (j >= 0) {
    if (b.insts[j].result == v) {
      return literal_kind(b.insts[j].kind_tag);
    }
    j = j - 1;
  }
  return false;
}

function none_of(n: i32): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(false);
    i = i + 1;
  }
  return out;
}

function leaf_value_records(f: ssasem.Func, ignored: i32): i32 {
  let records: i32 = 0;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result >= 0 && ins.result != ignored) {
        let t: typeinfo.Type = f.values[ins.result];
        if (record(t)) {
          records = records + 1;
        } else if (!leaf_word(f, t) && !void_type(t) && !read_view_param(f, ins)) {
          return 0 - 1;
        }
      }
    }
  }
  return records;
}

function leaf_body(f: ssasem.Func, ignored: i32): boolean {
  return leaf_body_limit(f, ignored, max_leaf_insts());
}

function leaf_body_limit(f: ssasem.Func, ignored: i32, limit: i32): boolean {
  if (f.graph.takes_env && ignored < 0 || code_blocks(f.graph) > max_leaf_blocks()) {
    return false;
  }
  if (f.graph.blocks[f.graph.entry].preds.len() > 0) {
    return false;
  }
  if (!leaf_word(f, f.result)) {
    return false;
  }
  let records: i32 = leaf_value_records(f, ignored);
  if (records < 0) {
    return false;
  }
  let record_sources: i32 = 0;
  let n: i32 = 0;
  let returns: boolean = false;
  for b in f.graph.blocks {
    if (b.term.kind_tag < 1 || b.term.kind_tag > 4) {
      return false;
    }
    returns = returns || b.term.kind_tag == 1;
    for ins in b.insts {
      if (!leaf_kind(ins.kind_tag) && !leaf_array_op(f, ins) && !leaf_element_read(f, ins) && !leaf_record_build(f, ins) && !leaf_record_call(f, ins) && !(ins.kind_tag == ssasem.call() && ssasem.scalar_primitive(ins.str))) {
        return false;
      }
      if ((ins.kind_tag == ssasem.record_get() || ins.kind_tag == ssasem.variant_get() && member_read(f, ins)) && !scalar(f.values[ins.result])) {
        return false;
      }
      if (ins.kind_tag == ssasem.param()) {
        if (ins.result != ignored && record(f.values[ins.result])) {
          record_sources = record_sources + 1;
        }
      } else if (!line_mark(ins.kind_tag)) {
        if ((ins.kind_tag == ssasem.variant_get() || ins.kind_tag == ssasem.record_new()) && record(f.values[ins.result])) {
          record_sources = record_sources + 1;
        }
        n = n + 1;
      }
    }
  }
  return returns && records == record_sources && n <= limit;
}

function ready_callee(f: ssasem.Func, ins: ssa.SInst, ix: util.NameIndex, ready: boolean[], closures: boolean): i32 {
  let j: i32 = called(ins, ix);
  if (closures) {
    j = closure_callee(f, ins, ix);
  }
  if (j < 0 || !ready[j]) {
    return 0 - 1;
  }
  return j;
}

function closure_callee(f: ssasem.Func, ins: ssa.SInst, ix: util.NameIndex): i32 {
  if (ins.kind_tag != ssasem.call_value() || ins.args.len() == 0) {
    return 0 - 1;
  }
  for b in f.graph.blocks {
    for d in b.insts {
      if (d.result == ins.args[0] && d.kind_tag == ssasem.closure_new() && d.args.len() == 0) {
        return ix.find(d.str);
      }
    }
  }
  return 0 - 1;
}

function splice_calls(f0: ssasem.Func, size: i32, self: i32, funcs: ssasem.Func[], sizes: i32[], ix: util.NameIndex, ready: boolean[], ctors: boolean[], shared: boolean[], small: boolean[], closures: boolean): Rewrite {
  let f: ssasem.Func = f0;
  let fsize: i32 = size;
  let done: i32 = 0;
  let swap: i32[] = [];
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len() && done < max_splices()) {
    let k: i32 = 0;
    let spliced: boolean = false;
    while (k < f.graph.blocks[bi].insts.len() && !spliced && done < max_splices()) {
      let at: i32 = ready_callee(f, f.graph.blocks[bi].insts[k], ix, ready, closures);
      if (at >= 0 && ctors[at] && !shared[at] && !literal_args(f.graph.blocks[bi], k)) {
        at = 0 - 1;
      }
      if (at >= 0 && shared[at]) {
        f = renamed(f, swap);
        swap = [];
        let r: i32 = f.graph.blocks[bi].insts[k].result;
        let apart: boolean = small[at] && !whole_at(sempair.whole_values(f, ix, shared, false), r);
        let projected: boolean = record_leaf(funcs[at]) && reads_parts_of(f, r);
        if (!apart && !projected && !(returned_only(f, r) && takes_apart(f, r))) {
          at = 0 - 1;
        }
      }
      if (at >= 0 && at != self
        && (fsize + sizes[at] <= max_caller_insts() || ctors[at] && funcs[at].params.len() == 0
        || fsize + sizes[at] <= max_box_saving_caller_insts() && saves_box(funcs, sizes, at, shared))) {
        done = done + 1;
        if (straight(funcs[at])) {
          let ip: InPlace = splice_in_place(f, bi, k, funcs[at]);
          f = ip.f;
          if (ip.from >= 0) {
            while (swap.len() <= ip.from) {
              swap = swap.append(0 - 1);
            }
            swap = swap.with(ip.from, ip.to);
          }
          fsize = count_insts(f.graph);
          continue;
        }
        f = splice(renamed(f, swap), bi, k, funcs[at]);
        swap = [];
        fsize = count_insts(f.graph);
        spliced = true;
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  return Rewrite { f: renamed(f, swap), changed: done > 0 };
}

function returned_only(f: ssasem.Func, v: i32): boolean {
  let names: i32[] = copies_of(f, v);
  let returned: boolean = false;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag != 7 && (named_arg(ins.args, names) || util.index_of_i32(names, ssasem.update_base(ins)) >= 0)) {
        return false;
      }
    }
  }
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1 && util.index_of_i32(names, b.term.value) >= 0) {
      returned = true;
    } else if (b.term.kind_tag == 3 && util.index_of_i32(names, b.term.cond) >= 0) {
      return false;
    }
  }
  return returned;
}

function copies_of(f: ssasem.Func, v: i32): i32[] {
  return aliases_of(f, v, false);
}

function aliases_of(f: ssasem.Func, v: i32, phis: boolean): i32[] {
  let names: i32[] = [v];
  let grew: boolean = true;
  while (grew) {
    grew = false;
    for b in f.graph.blocks {
      for ins in b.insts {
        if ((ins.kind_tag == 7 || phis && ins.kind_tag == 8) && named_arg(ins.args, names) && util.index_of_i32(names, ins.result) < 0) {
          names = names.append(ins.result);
          grew = true;
        }
      }
    }
  }
  return names;
}

function named_arg(args: i32[], names: i32[]): boolean {
  for a in args {
    if (util.index_of_i32(names, a) >= 0) {
      return true;
    }
  }
  return false;
}

function takes_apart(f: ssasem.Func, v: i32): boolean {
  if (v < 0 || v >= f.values.len()) {
    return false;
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if ((ins.kind_tag == ssasem.variant_get() || ins.kind_tag == ssasem.record_get()) && ins.args.len() == 1
        && ins.args[0] >= 0 && semtypes.equal(f.values[ins.args[0]], f.values[v])) {
        return true;
      }
    }
  }
  return false;
}

function whole_at(whole: boolean[], v: i32): boolean {
  return v < 0 || v >= whole.len() || whole[v];
}

// A loop can carry a builder's result back into its own call before the
// caller reads its fields. Such a phi is a whole use until the call is
// spliced, but the field read still makes the bounded splice useful.
function reads_parts_of(f: ssasem.Func, v: i32): boolean {
  let names: i32[] = aliases_of(f, v, true);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.record_get() && named_arg(ins.args, names)) {
        return true;
      }
    }
  }
  return false;
}

function next_block_id(g: ssa.SFunc): i32 {
  let hi: i32 = 0;
  for b in g.blocks {
    if (b.id >= hi) {
      hi = b.id + 1;
    }
  }
  return hi;
}

function br(target: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function term_targets(t: ssa.STerm): i32[] {
  if (t.kind_tag == 2) {
    return [t.target];
  }
  if (t.kind_tag == 3) {
    return [t.t, t.f];
  }
  return [];
}

function splice(f: ssasem.Func, bi: i32, k: i32, callee: ssasem.Func): ssasem.Func {
  let g: ssa.SFunc = f.graph;
  let b: ssa.SBlock = g.blocks[bi];
  let call: ssa.SInst = b.insts[k];
  let base: i32 = g.nvals;
  let first: i32 = next_block_id(g);
  let cont: i32 = first + callee.graph.blocks.len();
  let vmap: i32[] = [];
  let v: i32 = 0;
  while (v < callee.graph.nvals) {
    vmap = vmap.append(base + v);
    v = v + 1;
  }
  for cb in callee.graph.blocks {
    for ins in cb.insts {
      if (ins.kind_tag == ssasem.param()) {
        vmap = vmap.with(ins.result, call.args[ins.imm]);
      }
    }
  }
  let pos: i32[] = block_positions(callee.graph);
  let entry_id: i32 = callee.graph.blocks[callee.graph.entry].id;
  let copied: ssa.SBlock[] = [];
  let rets: i32[] = [];
  let ret_vals: i32[] = [];
  let j: i32 = 0;
  while (j < callee.graph.blocks.len()) {
    let cb: ssa.SBlock = callee.graph.blocks[j];
    let insts: ssa.SInst[] = [];
    for ins in cb.insts {
      if (ins.kind_tag == ssasem.param()) {
        continue;
      }
      insts = insts.append(ssa.SInst { ...ssasem.mapped_inst(vmap, ins), result: mapped(vmap, ins.result) });
    }
    let preds: i32[] = [];
    for p in cb.preds {
      preds = preds.append(first + position_of(pos, p));
    }
    if (cb.id == entry_id) {
      preds = [b.id];
    }
    let t: ssa.STerm = cb.term;
    if (t.kind_tag == 1) {
      rets = rets.append(first + j);
      if (t.value >= 0) {
        ret_vals = ret_vals.append(vmap[t.value]);
      }
      t = br(cont);
    } else if (t.kind_tag == 2) {
      t = br(first + position_of(pos, t.target));
    } else if (t.kind_tag == 3) {
      t = ssa.STerm { ...t, cond: mapped(vmap, t.cond), t: first + position_of(pos, t.t), f: first + position_of(pos, t.f) };
    }
    copied = copied.append(ssa.SBlock { id: first + j, insts: insts, term: t, preds: preds });
    j = j + 1;
  }
  let values: typeinfo.Type[] = util.append_all(f.values, callee.values);
  let swap: i32[] = result_swap(call, rets, ret_vals, values);
  let head: ssa.SInst[] = [];
  let tail: ssa.SInst[] = [];
  let kind: i32 = 8;
  if (rets.len() == 1) {
    kind = 7;
  }
  if (call.result >= 0 && ret_vals.len() > 0 && swap.len() == 0) {
    tail = tail.append(ssa.SInst { kind_tag: kind, result: call.result, args: ret_vals, imm: 0, str: "" });
  }
  let p: i32 = 0;
  while (p < b.insts.len()) {
    if (p < k) {
      head = head.append(b.insts[p]);
    }
    if (p > k) {
      tail = tail.append(b.insts[p]);
    }
    p = p + 1;
  }
  let blocks: ssa.SBlock[] = [];
  let targets: i32[] = term_targets(b.term);
  for ob in g.blocks {
    if (ob.id == b.id) {
      blocks = blocks.append(ssa.SBlock { ...ob, insts: head, term: br(first + position_of(pos, entry_id)) });
    } else if (index_of(targets, ob.id) >= 0) {
      let preds: i32[] = [];
      for q in ob.preds {
        if (q == b.id) {
          preds = preds.append(cont);
        } else {
          preds = preds.append(q);
        }
      }
      blocks = blocks.append(ssa.SBlock { ...ob, preds: preds });
    } else {
      blocks = blocks.append(ob);
    }
  }
  for cb in copied {
    blocks = blocks.append(cb);
  }
  blocks = blocks.append(ssa.SBlock { id: cont, insts: tail, term: b.term, preds: rets });
  let joined: ssasem.Func = with_tables(f, callee, vmap);
  return ssasem.Func { ...joined, graph: ssa.SFunc { ...g, blocks: swapped_blocks(blocks, swap), nvals: base + callee.graph.nvals }, values: values, dbg_vals: swapped_all(swap, joined.dbg_vals), source_positions: renamed_source(sourcepos.continued(joined.source_positions, b.id, cont), swap) };
}

function straight(f: ssasem.Func): boolean {
  return f.graph.blocks.len() == 1 && f.graph.blocks[0].term.kind_tag == 1;
}

struct InPlace { f: ssasem.Func, from: i32, to: i32 }

function splice_in_place(f: ssasem.Func, bi: i32, k: i32, callee: ssasem.Func): InPlace {
  let g: ssa.SFunc = f.graph;
  let b: ssa.SBlock = g.blocks[bi];
  let call: ssa.SInst = b.insts[k];
  let base: i32 = g.nvals;
  let cb: ssa.SBlock = callee.graph.blocks[0];
  let vmap: i32[] = [];
  let v: i32 = 0;
  while (v < callee.graph.nvals) {
    vmap = vmap.append(base + v);
    v = v + 1;
  }
  for ins in cb.insts {
    if (ins.kind_tag == ssasem.param()) {
      vmap = vmap.with(ins.result, call.args[ins.imm]);
    }
  }
  let insts: ssa.SInst[] = [];
  let p: i32 = 0;
  while (p < k) {
    insts = insts.append(b.insts[p]);
    p = p + 1;
  }
  for ins in cb.insts {
    if (ins.kind_tag == ssasem.param()) {
      continue;
    }
    insts = insts.append(ssa.SInst { ...ssasem.mapped_inst(vmap, ins), result: mapped(vmap, ins.result) });
  }
  let ret_vals: i32[] = [];
  if (cb.term.value >= 0) {
    ret_vals = [vmap[cb.term.value]];
  }
  let values: typeinfo.Type[] = util.append_all(f.values, callee.values);
  let swap: i32[] = result_swap(call, [0], ret_vals, values);
  if (call.result >= 0 && ret_vals.len() > 0 && swap.len() == 0) {
    insts = insts.append(ssa.SInst { kind_tag: 7, result: call.result, args: ret_vals, imm: 0, str: "" });
  }
  p = k + 1;
  while (p < b.insts.len()) {
    insts = insts.append(b.insts[p]);
    p = p + 1;
  }
  let joined: ssasem.Func = with_tables(f, callee, vmap);
  let blocks: ssa.SBlock[] = g.blocks.with(bi, ssa.SBlock { ...b, insts: insts });
  let out: ssasem.Func = ssasem.Func { ...joined, graph: ssa.SFunc { ...g, blocks: blocks, nvals: base + callee.graph.nvals }, values: values };
  if (swap.len() == 0) {
    return InPlace { f: out, from: 0 - 1, to: 0 - 1 };
  }
  return InPlace { f: out, from: call.result, to: ret_vals[0] };
}

function renamed(f: ssasem.Func, swap: i32[]): ssasem.Func {
  return ssasem.Func { ...f, graph: ssa.SFunc { ...f.graph, blocks: swapped_blocks(f.graph.blocks, swap) }, dbg_vals: swapped_all(swap, f.dbg_vals), source_positions: renamed_source(f.source_positions, swap) };
}

function with_tables(f: ssasem.Func, callee: ssasem.Func, vmap: i32[]): ssasem.Func {
  let calls: ssasem.Contract[] = f.calls;
  for c in callee.calls {
    if (ssasem.find_contract_in(calls, c.name) < 0) {
      calls = calls.append(c);
    }
  }
  let fresh: semrecords.Record[] = [];
  for r in callee.records.list {
    if (semrecords.find(f.records, r.ty) < 0) {
      fresh = fresh.append(r);
    }
  }
  let table: semrecords.Records = f.records;
  if (fresh.len() > 0) {
    let records: semrecords.Record[] = f.records.list;
    for r in fresh {
      records = records.append(r);
    }
    table = semrecords.records_of(records);
  }
  let enums: semrecords.Enum[] = f.enums;
  for e in callee.enums {
    if (semrecords.find_enum(enums, e.ty) < 0) {
      enums = enums.append(e);
    }
  }
  let anchors: ssasem.Anchor[] = f.anchors;
  for a in callee.anchors {
    if (!ssasem.anchored(anchors, a.name)) {
      anchors = anchors.append(a);
    }
  }
  let dbg_vals: i32[] = f.dbg_vals;
  let dbg_names: string[] = f.dbg_names;
  let i: i32 = 0;
  while (i < callee.dbg_vals.len()) {
    dbg_vals = dbg_vals.append(mapped(vmap, callee.dbg_vals[i]));
    dbg_names = dbg_names.append(callee.dbg_names[i]);
    i = i + 1;
  }
  return ssasem.Func { ...f, calls: calls, records: table, enums: enums, envs: with_rows(f.envs, callee.envs), anchors: anchors, dyns: with_rows(f.dyns, callee.dyns), dbg_vals: dbg_vals, dbg_names: dbg_names, source_positions: sourcepos.merge(f.source_positions, callee.source_positions, vmap) };
}

function with_rows(rows: ssasem.EnvRow[], more: ssasem.EnvRow[]): ssasem.EnvRow[] {
  let out: ssasem.EnvRow[] = rows;
  for m in more {
    let seen: boolean = false;
    for r in out {
      if (semtypes.equal(r.fn_ty, m.fn_ty) && semtypes.equal(r.env_ty, m.env_ty)) {
        seen = true;
      }
    }
    if (!seen) {
      out = out.append(m);
    }
  }
  return out;
}

function mapped(vmap: i32[], v: i32): i32 {
  if (v < 0 || v >= vmap.len()) {
    return v;
  }
  return vmap[v];
}

function index_of(xs: i32[], x: i32): i32 {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == x) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function block_positions(g: ssa.SFunc): i32[] {
  let at: i32[] = __alloc_i32(next_block_id(g));
  let j: i32 = 0;
  while (j < g.blocks.len()) {
    let id: i32 = g.blocks[j].id;
    if (id >= 0 && at[id] == 0) {
      at = at.with(id, j + 1);
    }
    j = j + 1;
  }
  return at;
}

function position_of(at: i32[], id: i32): i32 {
  if (id < 0 || id >= at.len()) {
    return 0 - 1;
  }
  return at[id] - 1;
}

struct Defs { insts: ssa.SInst[], blocks: i32[] }

function no_inst(): ssa.SInst {
  return ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
}

function defs_of(g: ssa.SFunc): Defs {
  let insts: ssa.SInst[] = [];
  let blocks: i32[] = [];
  let v: i32 = 0;
  while (v < g.nvals) {
    insts = insts.append(no_inst());
    blocks = blocks.append(0 - 1);
    v = v + 1;
  }
  let bi: i32 = 0;
  while (bi < g.blocks.len()) {
    for ins in g.blocks[bi].insts {
      if (ins.result >= 0 && ins.result < insts.len()) {
        insts = insts.with(ins.result, ins);
        blocks = blocks.with(ins.result, bi);
      }
    }
    bi = bi + 1;
  }
  return Defs { insts: insts, blocks: blocks };
}

function def_inst(defs: Defs, v: i32): ssa.SInst {
  if (v < 0 || v >= defs.insts.len()) {
    return no_inst();
  }
  return defs.insts[v];
}

function builds(k: i32): boolean {
  return k == ssasem.tuple_new() || k == ssasem.record_new() || k == ssasem.variant_new();
}

struct Part { ok: boolean, value: i32, flag: i32, filler: boolean }

function part(built: ssa.SInst, read: ssa.SInst): Part {
  let none: Part = Part { ok: false, value: 0 - 1, flag: 0 - 1, filler: false };
  let k: i32 = read.kind_tag;
  if (k == ssasem.variant_is()) {
    if (built.kind_tag != ssasem.variant_new()) {
      return none;
    }
    let flag: i32 = 0;
    if (built.str == read.str) {
      flag = 1;
    }
    return Part { ok: true, value: 0 - 1, flag: flag, filler: false };
  }
  let fits: boolean = k == ssasem.tuple_get() && built.kind_tag == ssasem.tuple_new()
    || k == ssasem.record_get() && built.kind_tag == ssasem.record_new()
    || k == ssasem.variant_get() && built.kind_tag == ssasem.variant_new();
  if (!fits) {
    return none;
  }
  if (k == ssasem.variant_get() && built.str != read.str) {
    return Part { ok: true, value: 0 - 1, flag: 0 - 1, filler: true };
  }
  if (read.imm < 0 || read.imm >= built.args.len()) {
    return none;
  }
  return Part { ok: true, value: built.args[read.imm], flag: 0 - 1, filler: false };
}

struct Head { block: i32, ins: ssa.SInst, of: i32, read: ssa.SInst }

struct Edits { defs: Defs, base: i32, added: typeinfo.Type[], swap: i32[], entry: ssa.SInst[], heads: Head[], kept: boolean[], chained: boolean[] }

function value_type(e: Edits, v: i32): typeinfo.Type {
  return e.added[v - e.base];
}

function split_constructions(f0: ssasem.Func, modes: i32[]): Rewrite {
  if (!reads_parts(f0.graph)) {
    return Rewrite { f: f0, changed: false };
  }
  let f: ssasem.Func = f0;
  let round: i32 = 0;
  let changed: boolean = true;
  let rewritten: boolean = false;
  while (changed && round < 8) {
    let split: Rewrite = split_round(f, modes);
    let swept: Rewrite = drop_unread(split.f);
    changed = split.changed || swept.changed;
    f = swept.f;
    rewritten = rewritten || changed;
    round = round + 1;
  }
  return Rewrite { f: f, changed: rewritten };
}

function split_round(f: ssasem.Func, modes: i32[]): Rewrite {
  let defs: Defs = defs_of(f.graph);
  let swap: i32[] = [];
  let v: i32 = 0;
  while (v < f.graph.nvals) {
    swap = swap.append(0 - 1);
    v = v + 1;
  }
  let chained: boolean[] = chained_rebuilds(f, defs, modes);
  let e: Edits = Edits { defs: defs, base: f.values.len(), added: [], swap: swap, entry: [], heads: [], kept: kept_values(f.graph), chained: chained };
  let any: boolean = false;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (sempair.reads_apart(ins.kind_tag) && ins.args.len() == 1 && splittable(f, e.defs, ins.args[0])) {
        e = resolve(f, e, ins);
        any = any || e.swap[ins.result] >= 0;
      }
    }
  }
  if (!any) {
    return Rewrite { f: f, changed: false };
  }
  return Rewrite { f: applied(f, e), changed: true };
}

function reads_parts(g: ssa.SFunc): boolean {
  for b in g.blocks {
    for ins in b.insts {
      if (sempair.reads_apart(ins.kind_tag)) {
        return true;
      }
    }
  }
  return false;
}

function splittable(f: ssasem.Func, defs: Defs, v: i32): boolean {
  let k: i32 = def_inst(defs, through_copies(defs, v)).kind_tag;
  if (!builds(k) && k != 8) {
    return false;
  }
  return !ssasem.holds_view(f, f.values[v]) && !ssasem.has_finalizer(f, f.values[v]);
}

function through_copies(defs: Defs, v: i32): i32 {
  let x: i32 = v;
  let steps: i32 = 0;
  while (steps < 64) {
    let d: ssa.SInst = def_inst(defs, x);
    if (d.kind_tag != 7 || d.args.len() != 1) {
      return x;
    }
    x = d.args[0];
    steps = steps + 1;
  }
  return x;
}

function scalar_field(read: ssa.SInst, ty: typeinfo.Type): boolean {
  return scalar(ty) && read.kind_tag != ssasem.variant_is() && read.kind_tag != ssasem.variant_get();
}

function kept_values(g: ssa.SFunc): boolean[] {
  let kept: boolean[] = used_whole(g);
  let copy_b: i32[] = __alloc_i32(g.nvals);
  let copy_k: i32[] = __alloc_i32(g.nvals);
  let work: i32[] = [];
  let bi: i32 = 0;
  while (bi < g.blocks.len()) {
    let insts: ssa.SInst[] = g.blocks[bi].insts;
    let k: i32 = 0;
    while (k < insts.len()) {
      let ins: ssa.SInst = insts[k];
      if ((ins.kind_tag == 7 || ins.kind_tag == 8) && ins.result >= 0 && ins.result < g.nvals) {
        copy_b = copy_b.with(ins.result, bi + 1);
        copy_k = copy_k.with(ins.result, k);
        if (kept[ins.result]) {
          work = work.append(ins.result);
        }
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  let at: i32 = 0;
  while (at < work.len()) {
    let v: i32 = work[at];
    at = at + 1;
    for a in g.blocks[copy_b[v] - 1].insts[copy_k[v]].args {
      if (a >= 0 && a < g.nvals && !kept[a]) {
        kept = kept.with(a, true);
        if (copy_b[a] != 0) {
          work = work.append(a);
        }
      }
    }
  }
  return kept;
}

function used_whole(g: ssa.SFunc): boolean[] {
  let kept: boolean[] = __alloc_bool(g.nvals);
  for b in g.blocks {
    for ins in b.insts {
      if (!sempair.reads_apart(ins.kind_tag) && ins.kind_tag != 7 && ins.kind_tag != 8) {
        kept = all_kept(kept, ins.args);
      }
    }
    if (b.term.kind_tag == 1) {
      kept = all_kept(kept, [b.term.value]);
    }
    if (b.term.kind_tag == 3) {
      kept = all_kept(kept, [b.term.cond]);
    }
  }
  return kept;
}

function marked(flags: boolean[], v: i32): boolean {
  return v >= 0 && v < flags.len() && flags[v];
}

function all_kept(own kept: boolean[], vs: i32[]): boolean[] {
  let out: boolean[] = kept;
  for v in vs {
    if (v >= 0 && v < out.len()) {
      out = out.with(v, true);
    }
  }
  return out;
}

function resolve(f: ssasem.Func, own e: Edits, read: ssa.SInst): Edits {
  let feasible: (boolean, i32[]) = resolvable(f, e, read, read.args[0], 0, []);
  if (!feasible.0) {
    return e;
  }
  let w: Walk = part_of(f, Walk { e: e, value: 0 - 1, phis: [], parts: [] }, read, read.args[0], 0);
  return Edits { ...w.e, swap: w.e.swap.with(read.result, w.value) };
}

function resolvable(f: ssasem.Func, e: Edits, read: ssa.SInst, v: i32, depth: i32, phis: i32[]): (boolean, i32[]) {
  let x: i32 = through_copies(e.defs, v);
  let d: ssa.SInst = def_inst(e.defs, x);
  if (depth > 32 || blocked(f, e, read, x)) {
    return (false, phis);
  }
  if (builds(d.kind_tag)) {
    return (part(d, read).ok, phis);
  }
  if (d.kind_tag != 8 || index_of(phis, x) >= 0) {
    return (d.kind_tag == 8 || d.kind_tag == ssasem.zero(), phis);
  }
  let seen: i32[] = phis.append(x);
  for a in d.args {
    let step: (boolean, i32[]) = resolvable(f, e, read, a, depth + 1, seen);
    seen = step.1;
    if (!step.0) {
      return (false, seen);
    }
  }
  return (true, seen);
}

function blocked(f: ssasem.Func, e: Edits, read: ssa.SInst, x: i32): boolean {
  return marked(e.kept, x) && !scalar_field(read, f.values[read.result]) || marked(e.chained, x);
}

struct Walk { e: Edits, value: i32, phis: i32[], parts: i32[] }

function part_of(f: ssasem.Func, own w: Walk, read: ssa.SInst, v: i32, depth: i32): Walk {
  let ty: typeinfo.Type = f.values[read.result];
  let x: i32 = through_copies(w.e.defs, v);
  let d: ssa.SInst = def_inst(w.e.defs, x);
  if (builds(d.kind_tag) || d.kind_tag == ssasem.zero()) {
    let p: Part = Part { ok: true, value: 0 - 1, flag: 0, filler: read.kind_tag != ssasem.variant_is() };
    if (builds(d.kind_tag)) {
      p = part(d, read);
    }
    return part_value(w, p, ty);
  }
  let seen: i32 = index_of(w.phis, x);
  if (seen >= 0) {
    return Walk { ...w, value: w.parts[seen] };
  }
  let made: i32 = made_part(w.e, x, read, ty);
  if (made >= 0) {
    return Walk { ...w, value: made };
  }
  let e0: Edits = w.e;
  let d0: Defs = e0.defs;
  let nv: i32 = e0.base + e0.added.len();
  let pb: i32 = d0.blocks[x];
  let cur: Walk = Walk {
    e: Edits { ...e0, defs: Defs { insts: d0.insts.append(no_inst()), blocks: d0.blocks.append(pb) }, added: e0.added.append(ty) },
    value: 0 - 1, phis: w.phis.append(x), parts: w.parts.append(nv),
  };
  let args: i32[] = [];
  for a in d.args {
    cur = part_of(f, cur, read, a, depth + 1);
    args = args.append(cur.value);
  }
  let ins: ssa.SInst = ssa.SInst { kind_tag: 8, result: nv, args: args, imm: 0, str: "" };
  let e1: Edits = cur.e;
  let d1: Defs = e1.defs;
  return Walk { ...cur, e: Edits { ...e1, defs: Defs { ...d1, insts: d1.insts.with(nv, ins) }, heads: e1.heads.append(Head { block: pb, ins: ins, of: x, read: read }) }, value: nv };
}

function made_part(e: Edits, x: i32, read: ssa.SInst, ty: typeinfo.Type): i32 {
  for h in e.heads {
    if (h.of == x && h.read.kind_tag == read.kind_tag && h.read.imm == read.imm && h.read.str == read.str && semtypes.equal(value_type(e, h.ins.result), ty)) {
      return h.ins.result;
    }
  }
  return 0 - 1;
}

function chained_rebuilds(f: ssasem.Func, defs: Defs, modes: i32[]): boolean[] {
  let rebuilt: boolean[] = rebuilt_values(f, defs);
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (builds(ins.kind_tag) && marked(rebuilt, ins.result) && rebuilds_owned(f, defs, ins, modes)) {
        out = out.with(ins.result, true);
      }
    }
  }
  return out;
}

function rebuilds_owned(f: ssasem.Func, defs: Defs, built: ssa.SInst, modes: i32[]): boolean {
  for a in built.args {
    let donor: i32 = rebuilt_from(f, defs, a, built.result);
    if (donor >= 0) {
      let param: boolean = donor < f.graph.nparams && donor < modes.len();
      return def_inst(defs, donor).kind_tag == ssasem.call() || param && modes[donor] == ssasem.counted_mode();
    }
  }
  return false;
}

function rebuilt_values(f: ssasem.Func, defs: Defs): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (builds(ins.kind_tag)) {
        for a in ins.args {
          out = all_kept(out, [rebuilt_from(f, defs, a, ins.result)]);
        }
      }
    }
  }
  return out;
}

function rebuilt_from(f: ssasem.Func, defs: Defs, a: i32, built: i32): i32 {
  let src: ssa.SInst = def_inst(defs, through_copies(defs, a));
  if (!sempair.reads_apart(src.kind_tag) || src.args.len() != 1 || !semtypes.equal(f.values[src.args[0]], f.values[built])) {
    return 0 - 1;
  }
  return through_copies(defs, src.args[0]);
}

function part_value(own w: Walk, p: Part, ty: typeinfo.Type): Walk {
  if (p.value >= 0) {
    return Walk { ...w, value: p.value };
  }
  let e0: Edits = w.e;
  let d0: Defs = e0.defs;
  let nv: i32 = e0.base + e0.added.len();
  let ins: ssa.SInst = ssa.SInst { kind_tag: 2, result: nv, args: [], imm: p.flag, str: "" };
  if (p.filler) {
    ins = ssa.SInst { kind_tag: ssasem.zero(), result: nv, args: [], imm: 0, str: "" };
  }
  return Walk { ...w, e: Edits { ...e0, defs: Defs { insts: d0.insts.append(ins), blocks: d0.blocks.append(0 - 1) }, added: e0.added.append(ty), entry: e0.entry.append(ins) }, value: nv };
}

function applied(f: ssasem.Func, e: Edits): ssasem.Func {
  let g: ssa.SFunc = f.graph;
  let blocks: ssa.SBlock[] = [];
  let bi: i32 = 0;
  while (bi < g.blocks.len()) {
    let b: ssa.SBlock = g.blocks[bi];
    let insts: ssa.SInst[] = [];
    for h in e.heads {
      if (h.block == bi) {
        insts = insts.append(swapped_inst(e.swap, h.ins));
      }
    }
    let entry: ssa.SInst[] = [];
    if (bi == g.entry) {
      entry = e.entry;
    }
    insts = util.append_all(insts, block_insts(b, entry, e.swap));
    let t: ssa.STerm = b.term;
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts, term: ssa.STerm { ...t, cond: swapped(e.swap, t.cond), value: swapped(e.swap, t.value) } });
    bi = bi + 1;
  }
  let values: typeinfo.Type[] = util.append_all(f.values, e.added);
  return ssasem.Func { ...f, graph: ssa.SFunc { ...g, blocks: blocks, nvals: values.len() }, values: values };
}

function block_insts(b: ssa.SBlock, entry: ssa.SInst[], swap: i32[]): ssa.SInst[] {
  let insts: ssa.SInst[] = [];
  let placed: boolean = entry.len() == 0;
  for ins in b.insts {
    if (!placed && ins.kind_tag != ssasem.param()) {
      insts = util.append_all(insts, entry);
      placed = true;
    }
    if (ins.result >= 0 && ins.result < swap.len() && swap[ins.result] >= 0) {
      insts = insts.append(ssa.SInst { kind_tag: 7, result: ins.result, args: [swapped(swap, ins.result)], imm: 0, str: "" });
    } else {
      insts = insts.append(swapped_inst(swap, ins));
    }
  }
  if (!placed) {
    insts = util.append_all(insts, entry);
  }
  return insts;
}

function swapped(swap: i32[], v: i32): i32 {
  let x: i32 = v;
  let steps: i32 = 0;
  while (x >= 0 && x < swap.len() && swap[x] >= 0 && steps < 64) {
    x = swap[x];
    steps = steps + 1;
  }
  return x;
}

function result_swap(call: ssa.SInst, rets: i32[], ret_vals: i32[], values: typeinfo.Type[]): i32[] {
  let swap: i32[] = [];
  if (call.result < 0 || rets.len() != 1 || ret_vals.len() != 1 || !semtypes.equal(values[call.result], values[ret_vals[0]])) {
    return swap;
  }
  while (swap.len() <= call.result) {
    swap = swap.append(0 - 1);
  }
  return swap.with(call.result, ret_vals[0]);
}

function swapped_blocks(blocks: ssa.SBlock[], swap: i32[]): ssa.SBlock[] {
  if (swap.len() == 0) {
    return blocks;
  }
  let out: ssa.SBlock[] = [];
  for b in blocks {
    if (!block_swaps_any(swap, b)) {
      out = out.append(b);
      continue;
    }
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      insts = insts.append(swapped_inst(swap, ins));
    }
    let t: ssa.STerm = b.term;
    out = out.append(ssa.SBlock { ...b, insts: insts, term: ssa.STerm { ...t, cond: swapped(swap, t.cond), value: swapped(swap, t.value) } });
  }
  return out;
}

function swapped_inst(swap: i32[], ins: ssa.SInst): ssa.SInst {
  let base: i32 = ssasem.update_base(ins);
  if (base >= 0) {
    return ssa.SInst { ...ins, args: swapped_all(swap, ins.args), imm: swapped(swap, base) + 1 };
  }
  return ssa.SInst { ...ins, args: swapped_all(swap, ins.args) };
}

function swaps_any(swap: i32[], args: i32[]): boolean {
  for a in args {
    if (swaps_one(swap, a)) {
      return true;
    }
  }
  return false;
}

function swaps_one(swap: i32[], v: i32): boolean {
  return v >= 0 && v < swap.len() && swap[v] >= 0;
}

function block_swaps_any(swap: i32[], b: ssa.SBlock): boolean {
  for ins in b.insts {
    if (swaps_any(swap, ins.args) || swaps_one(swap, ssasem.update_base(ins))) {
      return true;
    }
  }
  return swaps_one(swap, b.term.cond) || swaps_one(swap, b.term.value);
}

function swapped_all(swap: i32[], args: i32[]): i32[] {
  if (!swaps_any(swap, args)) {
    return args;
  }
  let out: i32[] = [];
  for a in args {
    out = out.append(swapped(swap, a));
  }
  return out;
}

function built_type(f: ssasem.Func, built: typeinfo.Type[], t: typeinfo.Type): boolean {
  for b in built {
    if (semtypes.equal(b, t)) {
      return true;
    }
  }
  return false;
}

function callees_of(f: ssasem.Func, ix: util.NameIndex): i32[] {
  let out: i32[] = [];
  for b in f.graph.blocks {
    for ins in b.insts {
      let j: i32 = called(ins, ix);
      if (j >= 0) {
        out = out.append(j);
      }
    }
  }
  return out;
}

function callees_of_all(funcs: ssasem.Func[], ix: util.NameIndex): i32[][] {
  let out: i32[][] = [];
  for f in funcs {
    out = out.append(callees_of(f, ix));
  }
  return out;
}

function saves_box(funcs: ssasem.Func[], sizes: i32[], at: i32, shared: boolean[]): boolean {
  if (shared[at]) {
    return sizes[at] <= max_reuse_shared_insts();
  }
  return sizes[at] <= max_once_insts() && returns_boxes(funcs[at]);
}

function any_box_saving(funcs: ssasem.Func[], sizes: i32[], callees: i32[], ready: boolean[], shared: boolean[]): boolean {
  for j in callees {
    if (ready[j] && saves_box(funcs, sizes, j, shared)) {
      return true;
    }
  }
  return false;
}

function any_ready(callees: i32[], ready: boolean[]): boolean {
  for j in callees {
    if (ready[j]) {
      return true;
    }
  }
  return false;
}

function sizes_of(funcs: ssasem.Func[]): i32[] {
  let out: i32[] = __alloc_i32(funcs.len());
  let i: i32 = 0;
  while (i < funcs.len()) {
    out = out.with(i, count_insts(funcs[i].graph));
    i = i + 1;
  }
  return out;
}

function count_insts(g: ssa.SFunc): i32 {
  let n: i32 = 0;
  for b in g.blocks {
    for ins in b.insts {
      if (!line_mark(ins.kind_tag)) {
        n = n + 1;
      }
    }
  }
  return n;
}

function drop_unread(f: ssasem.Func): Rewrite {
  let g: ssa.SFunc = f.graph;
  let built: typeinfo.Type[] = built_types(g, f);
  if (built.len() == 0 && !has_static_closure(g)) {
    return Rewrite { f: f, changed: false };
  }
  let reads: i32[] = read_counts(f);
  if (!any_unread(f, built, reads)) {
    return Rewrite { f: f, changed: false };
  }
  let blocks: ssa.SBlock[] = [];
  for b in g.blocks {
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      if (!unread_build(f, built, reads, ins)) {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts });
  }
  return Rewrite { f: ssasem.Func { ...f, graph: ssa.SFunc { ...g, blocks: blocks } }, changed: true };
}

function has_static_closure(g: ssa.SFunc): boolean {
  for b in g.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.closure_new() && ins.args.len() == 0) {
        return true;
      }
    }
  }
  return false;
}

function any_unread(f: ssasem.Func, built: typeinfo.Type[], reads: i32[]): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (unread_build(f, built, reads, ins)) {
        return true;
      }
    }
  }
  return false;
}

function built_types(g: ssa.SFunc, f: ssasem.Func): typeinfo.Type[] {
  let built: typeinfo.Type[] = [];
  for b in g.blocks {
    for ins in b.insts {
      if (builds(ins.kind_tag) && ins.result >= 0 && !built_type(f, built, f.values[ins.result])) {
        built = built.append(f.values[ins.result]);
      }
    }
  }
  return built;
}

function read_counts(f: ssasem.Func): i32[] {
  let g: ssa.SFunc = f.graph;
  let reads: i32[] = [];
  let v: i32 = 0;
  while (v < g.nvals) {
    reads = reads.append(0);
    v = v + 1;
  }
  for b in g.blocks {
    for ins in b.insts {
      for a in ins.args {
        reads = counted(reads, a);
      }
    }
    if (b.term.kind_tag == 1) {
      reads = counted(reads, b.term.value);
    }
    if (b.term.kind_tag == 3) {
      reads = counted(reads, b.term.cond);
    }
  }
  return reads;
}

function counted(own reads: i32[], v: i32): i32[] {
  if (v < 0 || v >= reads.len()) {
    return reads;
  }
  return reads.with(v, reads[v] + 1);
}

function unread_build(f: ssasem.Func, built: typeinfo.Type[], reads: i32[], ins: ssa.SInst): boolean {
  if (ins.result < 0 || ins.result >= reads.len() || reads[ins.result] != 0) {
    return false;
  }
  if (ins.kind_tag == ssasem.closure_new() && ins.args.len() == 0) {
    return true;
  }
  if (!builds(ins.kind_tag) && ins.kind_tag != 7 && ins.kind_tag != 8) {
    return false;
  }
  return built_type(f, built, f.values[ins.result]) && !ssasem.has_finalizer(f, f.values[ins.result]);
}

function renamed_source(source: sourcepos.SourceInfo, swap: i32[]): sourcepos.SourceInfo {
  if (source.entry.line == 0 || swap.len() == 0) {
    return source;
  }
  let map: i32[] = [];
  let i: i32 = 0;
  while (i < source.values.len()) {
    map = map.append(swapped(swap, i));
    i = i + 1;
  }
  return sourcepos.renamed(source, map);
}
