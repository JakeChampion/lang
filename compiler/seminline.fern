// Tiny scalar leaves spliced into their callers, then constructions read apart.
//
// A leaf here computes only on scalars and tuples of them, reading a record
// parameter's scalar fields at most, and calls nothing. Splicing it moves no
// count: every value it makes is a word or a fresh tuple the splice then takes
// apart, and a field read is planned in the caller like any other. A tuple,
// record or variant built and only read, which is what a spliced `(ok, value)`
// return becomes, is never allocated: each read takes the part straight from
// the construction, through the phi that joins several returns, and a
// construction nothing reads is dropped. This runs before the count planner, so
// a part read off the construction is planned like the operand it is. A
// constructor leaf, which only builds its result from its parameters and
// literals, is spliced into the calls whose arguments are all literals, so
// the construction is a constant there (`constructor_leaves`).
import "./ssa";
import "./util";
import "./ssasem";
import "./typeinfo";
import "./semtypes";
import "./semrecords";
import "./sempair";

// Past these a leaf is not tiny, and splicing it grows its callers more than
// the call it removes costs.
function max_leaf_insts(): i32 {
  return 40;
}

function max_leaf_blocks(): i32 {
  return 16;
}

// A function called from one place is spliced there whatever it computes, as
// long as it is no larger than this: the original goes once the splice leaves
// it unreferenced (ircore.cull_spliced_leaves), so the program does not grow.
function max_once_insts(): i32 {
  return 400;
}

function max_splices(): i32 {
  return 64;
}

// A caller already this large gains little from a splice and pays for it in
// register pressure across the whole body.
function max_caller_insts(): i32 {
  return 1500;
}

// What the pass made of each function, and whether it rewrote the graph: a
// caller holding an analysis of what it handed in keeps it only where the
// graph came back as it went in. `spliced` marks the functions spliced
// wherever they are called, which need no body once nothing names them.
pub struct Inlined { funcs: ssasem.Func[], rewritten: boolean[], spliced: boolean[] }

struct Rewrite { f: ssasem.Func, changed: boolean }

// `funcs[i]` is spliced into its callers when `inlinable[i]` and it is a leaf,
// or called once and `unnamed[i]`: nothing outside the bodies names it, so the
// splice leaves no second copy. `rewrite[i]` says which functions may be
// rewritten at all. `names[i]` is the key a call to `funcs[i]` carries, and
// `modes[i]` its parameters' modes.
pub function inline_leaves(funcs0: ssasem.Func[], names: string[], modes: i32[][], inlinable: boolean[], rewrite: boolean[], unnamed: boolean[]): Inlined {
  let ix: util.NameIndex = util.name_index(names);
  let calls: i32[] = call_counts(funcs0, ix);
  let leaves: boolean[] = [];
  let once: boolean[] = [];
  let i: i32 = 0;
  while (i < funcs0.len()) {
    let is_leaf: boolean = inlinable[i] && leaf(funcs0[i]);
    leaves = leaves.append(is_leaf);
    once = once.append(!is_leaf && inlinable[i] && unnamed[i] && once_spliceable(funcs0[i], calls[i]));
    i = i + 1;
  }
  let sp: Spliceable = Spliceable { ix: ix, leaves: leaves, once: once, inlinable: inlinable };
  let rounds: Inlined = splice_rounds(funcs0, rewrite, sp);
  let ctors: boolean[] = constructor_leaves(rounds.funcs, sp);
  let out: Inlined = split_all(paired_all(rounds, names, rewrite, unnamed), rewrite, modes);
  return Inlined { ...out, spliced: spliced_away(sp, ctors, calls, call_counts(out.funcs, ix)) };
}

// Whether `f`, called `calls` times and no leaf, is spliced into its caller.
function once_spliceable(f: ssasem.Func, calls: i32): boolean {
  return calls == 1 && !lends_view(f) && spliceable(f, max_once_insts());
}

// The functions spliced into every one of their callers: called before the
// pass, `calls`, and no longer after it, `left`.
function spliced_away(sp: Spliceable, ctors: boolean[], calls: i32[], left: i32[]): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < calls.len()) {
    out = out.append((sp.leaves[i] || sp.once[i] || ctors[i]) && calls[i] > 0 && left[i] == 0);
    i = i + 1;
  }
  return out;
}

// The functions spliced wherever they are called, by index into the
// function list `ix` names: leaves at once, functions called once when the
// ones they call once are in them, and constructor leaves, read off the
// bodies as each round leaves them (a function called once spliced into
// one can make it a constructor), at the calls whose arguments are all
// literals. `inlinable` is what may be spliced at all.
struct Spliceable { ix: util.NameIndex, leaves: boolean[], once: boolean[], inlinable: boolean[] }

// A function called once is spliced only after the ones it calls once are in
// it, so a chain of them folds from the bottom up.
function splice_rounds(funcs0: ssasem.Func[], rewrite: boolean[], sp: Spliceable): Inlined {
  let out: Inlined = Inlined { funcs: funcs0, rewritten: [], spliced: [] };
  for f in funcs0 {
    out = Inlined { ...out, rewritten: out.rewritten.append(false) };
  }
  let round: i32 = 0;
  let more: boolean = true;
  while (more && round < 16) {
    let ctors: boolean[] = constructor_leaves(out.funcs, sp);
    let ready: boolean[] = [];
    let j: i32 = 0;
    while (j < out.funcs.len()) {
      ready = ready.append(sp.leaves[j] || ctors[j] || sp.once[j] && !calls_any(out.funcs[j], sp.ix, sp.once, j));
      j = j + 1;
    }
    let next: Round = splice_round(out, rewrite, sp.ix, ready, ctors);
    more = next.changed;
    out = next.out;
    round = round + 1;
  }
  return out;
}

struct Round { out: Inlined, changed: boolean }

// splice_round and split_all keep the arrays they rewrite in locals, so each
// `.with` after the first writes in place rather than copying every body.
function splice_round(prev: Inlined, rewrite: boolean[], ix: util.NameIndex, ready: boolean[], ctors: boolean[]): Round {
  let funcs: ssasem.Func[] = prev.funcs;
  let rewritten: boolean[] = prev.rewritten;
  let changed: boolean = false;
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (rewrite[i] && count_insts(funcs[i].graph) <= max_caller_insts()) {
      let spliced: Rewrite = splice_calls(funcs[i], funcs, ix, ready, ctors, false);
      if (spliced.changed) {
        funcs = funcs.with(i, spliced.f);
        rewritten = rewritten.with(i, true);
        changed = true;
      }
    }
    i = i + 1;
  }
  return Round { out: Inlined { ...prev, funcs: funcs, rewritten: rewritten }, changed: changed };
}

// Variant returns paired (sempair) once nothing more is spliced, so split
// reads the rebuilt variants apart; a construction a return no longer reads
// goes with it.
function paired_all(prev: Inlined, names: string[], rewrite: boolean[], unnamed: boolean[]): Inlined {
  let p: sempair.Paired = sempair.pair_returns(prev.funcs, names, rewrite, unnamed);
  let funcs: ssasem.Func[] = p.funcs;
  let rewritten: boolean[] = prev.rewritten;
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (p.changed[i]) {
      funcs = funcs.with(i, drop_unread(funcs[i]));
      rewritten = rewritten.with(i, true);
    }
    i = i + 1;
  }
  return Inlined { ...prev, funcs: funcs, rewritten: rewritten };
}

function split_all(prev: Inlined, rewrite: boolean[], modes: i32[][]): Inlined {
  let funcs: ssasem.Func[] = prev.funcs;
  let rewritten: boolean[] = prev.rewritten;
  let i: i32 = 0;
  while (i < funcs.len()) {
    if (rewrite[i]) {
      let split: Rewrite = split_constructions(funcs[i], modes[i]);
      funcs = funcs.with(i, split.f);
      rewritten = rewritten.with(i, rewritten[i] || split.changed);
    }
    i = i + 1;
  }
  return Inlined { ...prev, funcs: funcs, rewritten: rewritten };
}

// Whether a parameter or the result of `f` holds a view, which only the frame
// that lends it may keep.
function lends_view(f: ssasem.Func): boolean {
  for p in f.params {
    if (ssasem.holds_view(f, p)) {
      return true;
    }
  }
  return ssasem.holds_view(f, f.result);
}

// How many direct calls name each function, over every body.
function call_counts(funcs: ssasem.Func[], ix: util.NameIndex): i32[] {
  let out: i32[] = __alloc_i32(funcs.len());
  for f in funcs {
    for b in f.graph.blocks {
      for ins in b.insts {
        let j: i32 = called(ins, ix);
        if (j >= 0) {
          out = out.with(j, out[j] + 1);
        }
      }
    }
  }
  return out;
}

// The function a direct call names, as an index into `ix`, or -1.
function called(ins: ssa.SInst, ix: util.NameIndex): i32 {
  if (ins.kind_tag != ssasem.call()) {
    return 0 - 1;
  }
  return ix.find(ins.str);
}

// Whether `f` still calls a function `marked` other than function `self`.
function calls_any(f: ssasem.Func, ix: util.NameIndex, marked: boolean[], self: i32): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      let j: i32 = called(ins, ix);
      if (j >= 0 && j != self && marked[j]) {
        return true;
      }
    }
  }
  return false;
}

// Whether `splice` can copy `f`'s body: one entry with no predecessor, no
// environment, only return and branch terminators, and at most `limit`
// instructions.
function spliceable(f: ssasem.Func, limit: i32): boolean {
  if (f.graph.takes_env || f.graph.blocks.len() == 0 || f.graph.blocks[f.graph.entry].preds.len() > 0) {
    return false;
  }
  for b in f.graph.blocks {
    if (b.term.kind_tag < 1 || b.term.kind_tag > 3) {
      return false;
    }
  }
  return count_insts(f.graph) <= limit;
}

// Fusion creates calls through closures whose exact bodies are already known.
// Splice tiny capture-free bodies only into callers that fusion changed. The
// unused environment remains an argument of the original typed call; splice
// maps it like every other parameter, and no copied instruction reads it.
pub function inline_closures(funcs: ssasem.Func[], names: string[], modes: i32[][], inlinable: boolean[], rewrite: boolean[]): ssasem.Func[] {
  let any: boolean = false;
  for changed in rewrite {
    any = any || changed;
  }
  if (!any) {
    return funcs;
  }
  // Prepare callback helpers with the ordinary inliner, then require each
  // resulting callback to satisfy the small scalar-leaf limit. This scratch
  // view does not replace non-fused callers or remove any function body.
  let ix: util.NameIndex = util.name_index(names);
  let candidates: ssasem.Func[] = inline_leaves(funcs, names, modes, inlinable, inlinable, inlinable).funcs;
  // A shared helper cannot take the single-use path. The first pass can
  // expose its leaf body, so rebuild the leaf table before preparing its
  // callback callers. Only callback bodies change in this second scratch pass.
  let callbacks: boolean[] = [];
  let ci: i32 = 0;
  while (ci < candidates.len()) {
    callbacks = callbacks.append(inlinable[ci] && unused_environment(candidates[ci]) >= 0);
    ci = ci + 1;
  }
  candidates = inline_leaves(candidates, names, modes, inlinable, callbacks, inlinable).funcs;
  let leaves: boolean[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    let env: i32 = unused_environment(candidates[i]);
    leaves = leaves.append(inlinable[i] && env >= 0 && leaf_body(candidates[i], env));
    i = i + 1;
  }
  let out: ssasem.Func[] = [];
  i = 0;
  while (i < funcs.len()) {
    let f: ssasem.Func = funcs[i];
    if (rewrite[i] && count_insts(f.graph) <= max_caller_insts()) {
      f = drop_unread(splice_calls(f, candidates, ix, leaves, none_of(candidates.len()), true).f);
    }
    out = out.append(f);
    i = i + 1;
  }
  return out;
}

function parameter_value(f: ssasem.Func, index: i32): i32 {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.param() && ins.imm == index) {
        return ins.result;
      }
    }
  }
  return 0 - 1;
}

function reads(g: ssa.SFunc, value: i32): boolean {
  for b in g.blocks {
    for ins in b.insts {
      for arg in ins.args {
        if (arg == value) {
          return true;
        }
      }
    }
    if (b.term.kind_tag == 1 && b.term.value == value || b.term.kind_tag == 3 && b.term.cond == value) {
      return true;
    }
  }
  return false;
}

function unused_environment(f: ssasem.Func): i32 {
  let contract: ssasem.Contract = ssasem.Contract { name: f.graph.name, params: f.params, modes: [], result: f.result };
  if (!ssasem.closure_env(contract) || ssasem.closure_captures(contract).len() != 0) {
    return 0 - 1;
  }
  let env: i32 = parameter_value(f, 0);
  if (env < 0 || reads(f.graph, env)) {
    return 0 - 1;
  }
  return env;
}

function scalar(t: typeinfo.Type): boolean {
  return ssasem.is_integer(t) || ssasem.is_float(t) || ssasem.is_bool(t) || ssasem.is_char(t);
}

function scalar_tuple(t: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(tt) = t {
    for e in tt.elements {
      if (!scalar(e)) {
        return false;
      }
    }
    return tt.elements.len() > 0;
  }
  return false;
}

function leaf_kind(k: i32): boolean {
  return k >= 1 && k <= 10 && k != 5 || k == ssasem.cast() || k == ssasem.tuple_new() || k == ssasem.tuple_get()
    || k == ssasem.record_get();
}

function record(t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  return false;
}

function leaf(f: ssasem.Func): boolean {
  return leaf_body(f, 0 - 1);
}

// A constructor leaf builds its result from its parameters and literals and
// nothing else: a straight line of blocks (a function spliced into it leaves
// its blocks behind), every instruction a parameter, a literal, a copy, a
// construction (a record, variant, tuple or array) or a call to another
// constructor leaf, the result a construction, and a view in none of it. It
// is spliced into a call whose arguments are all literals, where the
// construction it becomes is of literals alone and goes to the constant
// pool as a static box (ssarc), the way a nullary constructor's already
// does: `http.ok("hello")` is then one static record and allocates nothing.
// A call with an argument computed at run time stays a call, so no
// construction is moved into a caller that would build it there instead.
// Scalar leaves and functions spliced once are neither.
function constructor_leaves(funcs: ssasem.Func[], sp: Spliceable): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < funcs.len()) {
    out = out.append(sp.inlinable[i] && !sp.leaves[i] && !sp.once[i] && constructor_body(funcs[i]));
    i = i + 1;
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    i = 0;
    while (i < funcs.len()) {
      if (out[i] && !calls_constructors(funcs[i], sp.ix, out, i)) {
        out = out.with(i, false);
        changed = true;
      }
      i = i + 1;
    }
  }
  return out;
}

function constructor_body(f: ssasem.Func): boolean {
  if (f.graph.takes_env || f.graph.blocks.len() > max_leaf_blocks() || lends_view(f)) {
    return false;
  }
  if (f.graph.blocks[f.graph.entry].preds.len() > 0) {
    return false;
  }
  let returned: i32 = 0 - 1;
  let n: i32 = 0;
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1) {
      if (returned >= 0 || b.term.value < 0) {
        return false;
      }
      returned = b.term.value;
    } else if (b.term.kind_tag != 2) {
      return false;
    }
    if (b.id != f.graph.blocks[f.graph.entry].id && b.preds.len() != 1) {
      return false;
    }
    for ins in b.insts {
      if (!constructor_kind(ins.kind_tag)) {
        return false;
      }
      if (ins.kind_tag != ssasem.param()) {
        n = n + 1;
      }
    }
  }
  return returned >= 0 && n <= max_leaf_insts() && construction_kind(defs_of(f.graph).insts[returned].kind_tag);
}

// A literal, a parameter, a copy, a construction, a direct call or a source
// position marker (ssa kind 35).
function constructor_kind(k: i32): boolean {
  return literal_kind(k) || k == ssasem.param() || k == 7 || k == 35 || k == ssasem.call() || construction_kind(k);
}

function construction_kind(k: i32): boolean {
  return k == ssasem.record_new() || k == ssasem.variant_new() || k == ssasem.tuple_new() || k == ssasem.array_new();
}

// const_int, const_bool, const_i64, const_float and const_str.
function literal_kind(k: i32): boolean {
  return k >= 1 && k <= 5;
}

// Every direct call in `f` names a constructor leaf other than `f` itself.
function calls_constructors(f: ssasem.Func, ix: util.NameIndex, ctors: boolean[], self: i32): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call()) {
        let j: i32 = ix.find(ins.str);
        if (j < 0 || j == self || !ctors[j]) {
          return false;
        }
      }
    }
  }
  return true;
}

// Every argument of the call `ins` is a literal of `f`.
function literal_args(f: ssasem.Func, ins: ssa.SInst): boolean {
  let defs: Defs = defs_of(f.graph);
  for a in ins.args {
    if (a < 0 || a >= defs.insts.len() || !literal_kind(defs.insts[a].kind_tag)) {
      return false;
    }
  }
  return true;
}

function none_of(n: i32): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(false);
    i = i + 1;
  }
  return out;
}

function leaf_value_records(f: ssasem.Func, ignored: i32): i32 {
  let records: i32 = 0;
  let i: i32 = 0;
  while (i < f.values.len()) {
    if (i != ignored) {
      let t: typeinfo.Type = f.values[i];
      if (record(t)) {
        records = records + 1;
      } else if (!scalar(t) && !scalar_tuple(t)) {
        return 0 - 1;
      }
    }
    i = i + 1;
  }
  return records;
}

function leaf_body(f: ssasem.Func, ignored: i32): boolean {
  if (f.graph.takes_env && ignored < 0 || f.graph.blocks.len() > max_leaf_blocks()) {
    return false;
  }
  // The splice gives the entry one predecessor, the caller's block.
  if (f.graph.blocks[f.graph.entry].preds.len() > 0) {
    return false;
  }
  if (!scalar(f.result) && !scalar_tuple(f.result)) {
    return false;
  }
  let records: i32 = leaf_value_records(f, ignored);
  if (records < 0) {
    return false;
  }
  // Each param defines its own value, so equal counts mean every record is a param.
  let record_params: i32 = 0;
  let n: i32 = 0;
  for b in f.graph.blocks {
    if (b.term.kind_tag < 1 || b.term.kind_tag > 3) {
      return false;
    }
    for ins in b.insts {
      if (!leaf_kind(ins.kind_tag)) {
        return false;
      }
      if (ins.kind_tag == ssasem.record_get() && !scalar(f.values[ins.result])) {
        return false;
      }
      if (ins.kind_tag == ssasem.param()) {
        if (ins.result != ignored && record(f.values[ins.result])) {
          record_params = record_params + 1;
        }
      } else {
        n = n + 1;
      }
    }
  }
  return records == record_params && n <= max_leaf_insts();
}

// The ready function a call instruction names, as an index into `funcs`, or -1.
function ready_callee(f: ssasem.Func, ins: ssa.SInst, ix: util.NameIndex, ready: boolean[], closures: boolean): i32 {
  let j: i32 = called(ins, ix);
  if (closures) {
    j = closure_callee(f, ins, ix);
  }
  if (j < 0 || !ready[j]) {
    return 0 - 1;
  }
  return j;
}

function closure_callee(f: ssasem.Func, ins: ssa.SInst, ix: util.NameIndex): i32 {
  if (ins.kind_tag != ssasem.call_value() || ins.args.len() == 0) {
    return 0 - 1;
  }
  for b in f.graph.blocks {
    for d in b.insts {
      if (d.result == ins.args[0] && d.kind_tag == ssasem.closure_new() && d.args.len() == 0) {
        return ix.find(d.str);
      }
    }
  }
  return 0 - 1;
}

function splice_calls(f0: ssasem.Func, funcs: ssasem.Func[], ix: util.NameIndex, ready: boolean[], ctors: boolean[], closures: boolean): Rewrite {
  let f: ssasem.Func = f0;
  let done: i32 = 0;
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len() && done < max_splices()) {
    let k: i32 = 0;
    let spliced: boolean = false;
    while (k < f.graph.blocks[bi].insts.len() && !spliced) {
      let at: i32 = ready_callee(f, f.graph.blocks[bi].insts[k], ix, ready, closures);
      if (at >= 0 && ctors[at] && !literal_args(f, f.graph.blocks[bi].insts[k])) {
        at = 0 - 1;
      }
      if (at >= 0 && funcs[at].graph.name != f.graph.name
        && count_insts(f.graph) + count_insts(funcs[at].graph) <= max_caller_insts()) {
        f = splice(f, bi, k, funcs[at]);
        done = done + 1;
        spliced = true;
      }
      k = k + 1;
    }
    // The block's tail moved to a new block at the end, which this walk
    // reaches in turn.
    bi = bi + 1;
  }
  return Rewrite { f: f, changed: done > 0 };
}

function next_block_id(g: ssa.SFunc): i32 {
  let hi: i32 = 0;
  for b in g.blocks {
    if (b.id >= hi) {
      hi = b.id + 1;
    }
  }
  return hi;
}

function br(target: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function term_targets(t: ssa.STerm): i32[] {
  if (t.kind_tag == 2) {
    return [t.target];
  }
  if (t.kind_tag == 3) {
    return [t.t, t.f];
  }
  return [];
}

// The call at block `bi`, position `k` becomes a branch into a copy of
// `callee`'s blocks; every return in the copy branches to a new block that
// defines the call's result and carries on with the rest of the old block.
function splice(f: ssasem.Func, bi: i32, k: i32, callee: ssasem.Func): ssasem.Func {
  let g: ssa.SFunc = f.graph;
  let b: ssa.SBlock = g.blocks[bi];
  let call: ssa.SInst = b.insts[k];
  let base: i32 = g.nvals;
  let first: i32 = next_block_id(g);
  let cont: i32 = first + callee.graph.blocks.len();
  let vmap: i32[] = [];
  let v: i32 = 0;
  while (v < callee.graph.nvals) {
    vmap = vmap.append(base + v);
    v = v + 1;
  }
  for cb in callee.graph.blocks {
    for ins in cb.insts {
      if (ins.kind_tag == ssasem.param()) {
        vmap = vmap.with(ins.result, call.args[ins.imm]);
      }
    }
  }
  let ids: i32[] = [];
  for cb in callee.graph.blocks {
    ids = ids.append(cb.id);
  }
  let entry_id: i32 = callee.graph.blocks[callee.graph.entry].id;
  let copied: ssa.SBlock[] = [];
  let rets: i32[] = [];
  let ret_vals: i32[] = [];
  let j: i32 = 0;
  while (j < callee.graph.blocks.len()) {
    let cb: ssa.SBlock = callee.graph.blocks[j];
    let insts: ssa.SInst[] = [];
    for ins in cb.insts {
      if (ins.kind_tag == ssasem.param()) {
        continue;
      }
      let args: i32[] = [];
      for a in ins.args {
        args = args.append(mapped(vmap, a));
      }
      insts = insts.append(ssa.SInst { ...ins, result: mapped(vmap, ins.result), args: args });
    }
    let preds: i32[] = [];
    for p in cb.preds {
      preds = preds.append(first + index_of(ids, p));
    }
    if (cb.id == entry_id) {
      preds = [b.id];
    }
    let t: ssa.STerm = cb.term;
    if (t.kind_tag == 1) {
      rets = rets.append(first + j);
      if (t.value >= 0) {
        ret_vals = ret_vals.append(vmap[t.value]);
      }
      t = br(cont);
    } else if (t.kind_tag == 2) {
      t = br(first + index_of(ids, t.target));
    } else {
      t = ssa.STerm { ...t, cond: mapped(vmap, t.cond), t: first + index_of(ids, t.t), f: first + index_of(ids, t.f) };
    }
    copied = copied.append(ssa.SBlock { id: first + j, insts: insts, term: t, preds: preds });
    j = j + 1;
  }
  let values: typeinfo.Type[] = util.append_all(f.values, callee.values);
  let swap: i32[] = result_swap(call, rets, ret_vals, values);
  let head: ssa.SInst[] = [];
  let tail: ssa.SInst[] = [];
  let kind: i32 = 8;
  if (rets.len() == 1) {
    kind = 7;
  }
  if (call.result >= 0 && ret_vals.len() > 0 && swap.len() == 0) {
    tail = tail.append(ssa.SInst { kind_tag: kind, result: call.result, args: ret_vals, imm: 0, str: "" });
  }
  let p: i32 = 0;
  while (p < b.insts.len()) {
    if (p < k) {
      head = head.append(b.insts[p]);
    }
    if (p > k) {
      tail = tail.append(b.insts[p]);
    }
    p = p + 1;
  }
  let blocks: ssa.SBlock[] = [];
  let targets: i32[] = term_targets(b.term);
  for ob in g.blocks {
    if (ob.id == b.id) {
      blocks = blocks.append(ssa.SBlock { ...ob, insts: head, term: br(first + index_of(ids, entry_id)) });
    } else if (index_of(targets, ob.id) >= 0) {
      let preds: i32[] = [];
      for q in ob.preds {
        if (q == b.id) {
          preds = preds.append(cont);
        } else {
          preds = preds.append(q);
        }
      }
      blocks = blocks.append(ssa.SBlock { ...ob, preds: preds });
    } else {
      blocks = blocks.append(ob);
    }
  }
  for cb in copied {
    blocks = blocks.append(cb);
  }
  blocks = blocks.append(ssa.SBlock { id: cont, insts: tail, term: b.term, preds: rets });
  let joined: ssasem.Func = with_tables(f, callee, vmap);
  return ssasem.Func { ...joined, graph: ssa.SFunc { ...g, blocks: swapped_blocks(blocks, swap), nvals: base + callee.graph.nvals }, values: values, dbg_vals: swapped_all(swap, joined.dbg_vals) };
}

// `f` with the tables `callee`'s body reads added to its own: the contracts of
// what it calls, its record and enum schemas, its environment and dyn rows, its
// anchors, and under `-g` its bindings, renumbered by `vmap`.
function with_tables(f: ssasem.Func, callee: ssasem.Func, vmap: i32[]): ssasem.Func {
  let calls: ssasem.Contract[] = f.calls;
  for c in callee.calls {
    if (ssasem.find_contract_in(calls, c.name) < 0) {
      calls = calls.append(c);
    }
  }
  // A table holds each schema once, so the callee's records absent from `f`
  // need no check against each other.
  let fresh: semrecords.Record[] = [];
  for r in callee.records.list {
    if (semrecords.find(f.records, r.ty) < 0) {
      fresh = fresh.append(r);
    }
  }
  let table: semrecords.Records = f.records;
  if (fresh.len() > 0) {
    let records: semrecords.Record[] = f.records.list;
    for r in fresh {
      records = records.append(r);
    }
    table = semrecords.records_of(records);
  }
  let enums: semrecords.Enum[] = f.enums;
  for e in callee.enums {
    if (semrecords.find_enum(enums, e.ty) < 0) {
      enums = enums.append(e);
    }
  }
  let anchors: ssasem.Anchor[] = f.anchors;
  for a in callee.anchors {
    if (!ssasem.anchored(anchors, a.name)) {
      anchors = anchors.append(a);
    }
  }
  let dbg_vals: i32[] = f.dbg_vals;
  let dbg_names: string[] = f.dbg_names;
  let i: i32 = 0;
  while (i < callee.dbg_vals.len()) {
    dbg_vals = dbg_vals.append(mapped(vmap, callee.dbg_vals[i]));
    dbg_names = dbg_names.append(callee.dbg_names[i]);
    i = i + 1;
  }
  return ssasem.Func { ...f, calls: calls, records: table, enums: enums, envs: with_rows(f.envs, callee.envs), anchors: anchors, dyns: with_rows(f.dyns, callee.dyns), dbg_vals: dbg_vals, dbg_names: dbg_names };
}

function with_rows(rows: ssasem.EnvRow[], more: ssasem.EnvRow[]): ssasem.EnvRow[] {
  let out: ssasem.EnvRow[] = rows;
  for m in more {
    let seen: boolean = false;
    for r in out {
      if (semtypes.equal(r.fn_ty, m.fn_ty) && semtypes.equal(r.env_ty, m.env_ty)) {
        seen = true;
      }
    }
    if (!seen) {
      out = out.append(m);
    }
  }
  return out;
}

// `v` renumbered into the caller; a missing value, such as a void result,
// stays missing.
function mapped(vmap: i32[], v: i32): i32 {
  if (v < 0 || v >= vmap.len()) {
    return v;
  }
  return vmap[v];
}

function index_of(xs: i32[], x: i32): i32 {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == x) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// ---- constructions read apart ---------------------------------------------

// Each value's defining instruction and the index of its block, by value; a
// value nothing defines has kind 0 and block -1.
struct Defs { insts: ssa.SInst[], blocks: i32[] }

function no_inst(): ssa.SInst {
  return ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
}

function defs_of(g: ssa.SFunc): Defs {
  let insts: ssa.SInst[] = [];
  let blocks: i32[] = [];
  let v: i32 = 0;
  while (v < g.nvals) {
    insts = insts.append(no_inst());
    blocks = blocks.append(0 - 1);
    v = v + 1;
  }
  let bi: i32 = 0;
  while (bi < g.blocks.len()) {
    for ins in g.blocks[bi].insts {
      if (ins.result >= 0 && ins.result < insts.len()) {
        insts = insts.with(ins.result, ins);
        blocks = blocks.with(ins.result, bi);
      }
    }
    bi = bi + 1;
  }
  return Defs { insts: insts, blocks: blocks };
}

function def_inst(defs: Defs, v: i32): ssa.SInst {
  if (v < 0 || v >= defs.insts.len()) {
    return no_inst();
  }
  return defs.insts[v];
}

// Whether `k` builds a box a read can see through.
function builds(k: i32): boolean {
  return k == ssasem.tuple_new() || k == ssasem.record_new() || k == ssasem.variant_new();
}

// Whether `k` reads a part of a box, or tests which variant it holds.
function reads_part(k: i32): boolean {
  return k == ssasem.tuple_get() || k == ssasem.record_get() || k == ssasem.variant_get() || k == ssasem.variant_is();
}

// What `read` answers on the box `built` constructs: one of its operands, a
// constant flag for a variant test, or, for a variant's field read on a box
// holding another variant, nothing the read can reach, so any value of its
// type stands in. `ok` is false when the read does not fit the construction.
struct Part { ok: boolean, value: i32, flag: i32, filler: boolean }

function part(built: ssa.SInst, read: ssa.SInst): Part {
  let none: Part = Part { ok: false, value: 0 - 1, flag: 0 - 1, filler: false };
  let k: i32 = read.kind_tag;
  if (k == ssasem.variant_is()) {
    if (built.kind_tag != ssasem.variant_new()) {
      return none;
    }
    let flag: i32 = 0;
    if (built.str == read.str) {
      flag = 1;
    }
    return Part { ok: true, value: 0 - 1, flag: flag, filler: false };
  }
  let fits: boolean = k == ssasem.tuple_get() && built.kind_tag == ssasem.tuple_new()
    || k == ssasem.record_get() && built.kind_tag == ssasem.record_new()
    || k == ssasem.variant_get() && built.kind_tag == ssasem.variant_new();
  if (!fits) {
    return none;
  }
  if (k == ssasem.variant_get() && built.str != read.str) {
    return Part { ok: true, value: 0 - 1, flag: 0 - 1, filler: true };
  }
  if (read.imm < 0 || read.imm >= built.args.len()) {
    return none;
  }
  return Part { ok: true, value: built.args[read.imm], flag: 0 - 1, filler: false };
}

// One round's rewrites, applied together once every read is resolved: the
// value each read becomes (`swap`, -1 where it stays), the flags and stand-ins
// the entry gains after its parameters, and the per-part phis that go at the
// head of the block of the phi they split. `defs` and `values` grow with them.
struct Head { block: i32, ins: ssa.SInst }

struct Edits { defs: Defs, values: typeinfo.Type[], swap: i32[], entry: ssa.SInst[], heads: Head[], kept: boolean[], chained: boolean[] }

// Every read of a known construction reads its part instead, a read of a phi
// joining constructions reads a per-part phi, and a construction, or a phi or
// copy of one, left unread is dropped.
function split_constructions(f0: ssasem.Func, modes: i32[]): Rewrite {
  if (!reads_parts(f0.graph)) {
    return Rewrite { f: f0, changed: false };
  }
  let f: ssasem.Func = f0;
  let round: i32 = 0;
  let changed: boolean = true;
  let rewritten: boolean = false;
  while (changed && round < 8) {
    let split: Rewrite = split_round(f, modes);
    let swept: ssasem.Func = drop_unread(split.f);
    changed = split.changed || count_insts(swept.graph) != count_insts(split.f.graph);
    f = swept;
    rewritten = rewritten || changed;
    round = round + 1;
  }
  return Rewrite { f: f, changed: rewritten };
}

// Every read that resolves, rewritten at once.
function split_round(f: ssasem.Func, modes: i32[]): Rewrite {
  let defs: Defs = defs_of(f.graph);
  let swap: i32[] = [];
  let v: i32 = 0;
  while (v < f.graph.nvals) {
    swap = swap.append(0 - 1);
    v = v + 1;
  }
  let e: Edits = Edits { defs: defs, values: f.values, swap: swap, entry: [], heads: [], kept: kept_values(f.graph), chained: chained_rebuilds(f, defs, modes) };
  let any: boolean = false;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (reads_part(ins.kind_tag) && ins.args.len() == 1 && splittable(f, defs, ins.args[0])) {
        e = resolve(f, e, ins);
        any = any || e.swap[ins.result] >= 0;
      }
    }
  }
  if (!any) {
    return Rewrite { f: f, changed: false };
  }
  return Rewrite { f: applied(f, e), changed: true };
}

function reads_parts(g: ssa.SFunc): boolean {
  for b in g.blocks {
    for ins in b.insts {
      if (reads_part(ins.kind_tag)) {
        return true;
      }
    }
  }
  return false;
}

// Whether a read of `v` may be split: `v` is a construction or a phi, and
// holds no view, since a view may only move and a part phi would retain it.
function splittable(f: ssasem.Func, defs: Defs, v: i32): boolean {
  let k: i32 = def_inst(defs, through_copies(defs, v)).kind_tag;
  if (!builds(k) && k != 8) {
    return false;
  }
  return !ssasem.holds_view(f, f.values[v]);
}

// `v` past any copies.
function through_copies(defs: Defs, v: i32): i32 {
  let x: i32 = v;
  let steps: i32 = 0;
  while (steps < 64) {
    let d: ssa.SInst = def_inst(defs, x);
    if (d.kind_tag != 7 || d.args.len() != 1) {
      return x;
    }
    x = d.args[0];
    steps = steps + 1;
  }
  return x;
}

// Whether `read` takes a scalar field of a tuple or record, which may be read
// off a box that is kept anyway.
function scalar_field(read: ssa.SInst, ty: typeinfo.Type): boolean {
  return scalar(ty) && read.kind_tag != ssasem.variant_is() && read.kind_tag != ssasem.variant_get();
}

// The values something other than a part read needs whole: an operand of
// any other instruction or a terminator, and what a copy or phi of one copies.
// A box kept anyway is still built, so reading a reference part off it would
// only add a second owner of the part, and its variant reads stay together so
// each projection keeps the test that guards it.
function kept_values(g: ssa.SFunc): boolean[] {
  let kept: boolean[] = used_whole(g);
  let moved: boolean = true;
  while (moved) {
    // Mark what each kept copy or phi copies, until nothing new is marked.
    moved = false;
    for b in g.blocks {
      for ins in b.insts {
        if ((ins.kind_tag == 7 || ins.kind_tag == 8) && marked(kept, ins.result) && !all_marked(kept, ins.args)) {
          kept = all_kept(kept, ins.args);
          moved = true;
        }
      }
    }
  }
  return kept;
}

function used_whole(g: ssa.SFunc): boolean[] {
  let kept: boolean[] = __alloc_bool(g.nvals);
  for b in g.blocks {
    for ins in b.insts {
      if (!reads_part(ins.kind_tag) && ins.kind_tag != 7 && ins.kind_tag != 8) {
        kept = all_kept(kept, ins.args);
      }
    }
    if (b.term.kind_tag == 1) {
      kept = all_kept(kept, [b.term.value]);
    }
    if (b.term.kind_tag == 3) {
      kept = all_kept(kept, [b.term.cond]);
    }
  }
  return kept;
}

function all_marked(flags: boolean[], vs: i32[]): boolean {
  for v in vs {
    if (v >= 0 && v < flags.len() && !flags[v]) {
      return false;
    }
  }
  return true;
}

function marked(flags: boolean[], v: i32): boolean {
  return v >= 0 && v < flags.len() && flags[v];
}

function all_kept(own kept: boolean[], vs: i32[]): boolean[] {
  let out: boolean[] = kept;
  for v in vs {
    if (v >= 0 && v < out.len()) {
      out = out.with(v, true);
    }
  }
  return out;
}

// `e` with `read` resolved, when its operand is a construction or phis of
// constructions, all the way down.
function resolve(f: ssasem.Func, e: Edits, read: ssa.SInst): Edits {
  let w: Walk = part_of(f, Walk { e: e, value: 0 - 1, ok: true, phis: [], parts: [] }, read, read.args[0], 0);
  if (!w.ok) {
    return e;
  }
  return Edits { ...w.e, swap: w.e.swap.with(read.result, w.value) };
}

// One step of a read's resolution: the edits so far, the value found, and
// the part phi already made for each phi met, so a loop's phi is split once.
struct Walk { e: Edits, value: i32, ok: boolean, phis: i32[], parts: i32[] }

// What `read` answers on `v`: a construction's part; a stand-in where `v` is
// a stand-in itself, on a path no read reaches; or, for a phi, a phi of what
// it answers on each operand, at the head of the phi's block.
// A failed walk is dropped whole by `resolve`, so it is made where the walk
// fails rather than kept beside the walk, which would hold every array of
// the edits at a second count through the phi's split.
function part_of(f: ssasem.Func, w: Walk, read: ssa.SInst, v: i32, depth: i32): Walk {
  if (depth > 32) {
    return Walk { ...w, ok: false };
  }
  let ty: typeinfo.Type = f.values[read.result];
  let x: i32 = through_copies(w.e.defs, v);
  if (marked(w.e.kept, x) && !scalar_field(read, ty)) {
    return Walk { ...w, ok: false };
  }
  let d: ssa.SInst = def_inst(w.e.defs, x);
  if (marked(w.e.chained, x) || index_of(f.dbg_vals, v) >= 0 || index_of(f.dbg_vals, x) >= 0) {
    return Walk { ...w, ok: false };
  }
  if (builds(d.kind_tag) || d.kind_tag == ssasem.zero()) {
    let p: Part = Part { ok: true, value: 0 - 1, flag: 0, filler: read.kind_tag != ssasem.variant_is() };
    if (builds(d.kind_tag)) {
      p = part(d, read);
    }
    if (!p.ok) {
      return Walk { ...w, ok: false };
    }
    let placed: Placed = part_value(w.e, p, ty);
    return Walk { ...w, e: placed.e, value: placed.value };
  }
  if (d.kind_tag != 8) {
    return Walk { ...w, ok: false };
  }
  let seen: i32 = index_of(w.phis, x);
  if (seen >= 0) {
    return Walk { ...w, value: w.parts[seen] };
  }
  let nv: i32 = w.e.values.len();
  let pb: i32 = w.e.defs.blocks[x];
  let phis: i32[] = w.phis.append(x);
  let parts: i32[] = w.parts.append(nv);
  let e: Edits = w.e;
  let values: typeinfo.Type[] = e.values.append(ty);
  let base: Defs = e.defs;
  let blocks: i32[] = base.blocks.append(pb);
  let placeholder: Defs = Defs { insts: base.insts.append(no_inst()), blocks: blocks };
  let cur: Walk = Walk { e: Edits { ...e, defs: placeholder, values: values }, value: 0 - 1, ok: true, phis: phis, parts: parts };
  let args: i32[] = [];
  for a in d.args {
    cur = part_of(f, cur, read, a, depth + 1);
    if (!cur.ok) {
      return cur;
    }
    args = args.append(cur.value);
  }
  let ins: ssa.SInst = ssa.SInst { kind_tag: 8, result: nv, args: args, imm: 0, str: "" };
  let defs: Defs = Defs { insts: cur.e.defs.insts.with(nv, ins), blocks: cur.e.defs.blocks };
  return Walk { ...cur, e: Edits { ...cur.e, defs: defs, heads: cur.e.heads.append(Head { block: pb, ins: ins }) }, value: nv };
}

// The rebuilds that are rebuilt in turn and rebuild a box the frame owns: a
// call's result or an owned parameter. A rebuild takes over the box it rebuilds
// where that box dies, so such a chain runs in that one box, and splitting a
// link frees it early, leaving the next link to allocate. A borrowed box is not
// the frame's to take over, so its first rebuild allocates either way.
function chained_rebuilds(f: ssasem.Func, defs: Defs, modes: i32[]): boolean[] {
  let rebuilt: boolean[] = rebuilt_values(f, defs);
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (builds(ins.kind_tag) && marked(rebuilt, ins.result) && rebuilds_owned(f, defs, ins, modes)) {
        out = out.with(ins.result, true);
      }
    }
  }
  return out;
}

function rebuilds_owned(f: ssasem.Func, defs: Defs, built: ssa.SInst, modes: i32[]): boolean {
  for a in built.args {
    let donor: i32 = rebuilt_from(f, defs, a, built.result);
    if (donor >= 0) {
      let param: boolean = donor < f.graph.nparams && donor < modes.len();
      return def_inst(defs, donor).kind_tag == ssasem.call() || param && modes[donor] == ssasem.counted_mode();
    }
  }
  return false;
}

// The values a construction of their own type is built from parts of.
function rebuilt_values(f: ssasem.Func, defs: Defs): boolean[] {
  let out: boolean[] = __alloc_bool(f.graph.nvals);
  for b in f.graph.blocks {
    for ins in b.insts {
      if (builds(ins.kind_tag)) {
        for a in ins.args {
          out = all_kept(out, [rebuilt_from(f, defs, a, ins.result)]);
        }
      }
    }
  }
  return out;
}

// The value of `built`'s type the operand `a` is a part of, past copies, or -1.
function rebuilt_from(f: ssasem.Func, defs: Defs, a: i32, built: i32): i32 {
  let src: ssa.SInst = def_inst(defs, through_copies(defs, a));
  if (!reads_part(src.kind_tag) || src.args.len() != 1 || !semtypes.equal(f.values[src.args[0]], f.values[built])) {
    return 0 - 1;
  }
  return through_copies(defs, src.args[0]);
}

struct Placed { e: Edits, value: i32 }

// The value a part names, adding a flag or a stand-in to the entry, where it
// reaches every read.
function part_value(e: Edits, p: Part, ty: typeinfo.Type): Placed {
  if (p.value >= 0) {
    return Placed { e: e, value: p.value };
  }
  let nv: i32 = e.values.len();
  let ins: ssa.SInst = ssa.SInst { kind_tag: 2, result: nv, args: [], imm: p.flag, str: "" };
  if (p.filler) {
    ins = ssa.SInst { kind_tag: ssasem.zero(), result: nv, args: [], imm: 0, str: "" };
  }
  let defs: Defs = Defs { insts: e.defs.insts.append(ins), blocks: e.defs.blocks.append(0 - 1) };
  return Placed { e: Edits { ...e, defs: defs, values: e.values.append(ty), entry: e.entry.append(ins) }, value: nv };
}

// `f` with a round's edits written in, in one pass over its blocks.
function applied(f: ssasem.Func, e: Edits): ssasem.Func {
  let g: ssa.SFunc = f.graph;
  let blocks: ssa.SBlock[] = [];
  let bi: i32 = 0;
  while (bi < g.blocks.len()) {
    let b: ssa.SBlock = g.blocks[bi];
    let insts: ssa.SInst[] = [];
    for h in e.heads {
      if (h.block == bi) {
        insts = insts.append(ssa.SInst { ...h.ins, args: swapped_all(e.swap, h.ins.args) });
      }
    }
    let entry: ssa.SInst[] = [];
    if (bi == g.entry) {
      entry = e.entry;
    }
    insts = util.append_all(insts, block_insts(b, entry, e.swap));
    let t: ssa.STerm = b.term;
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts, term: ssa.STerm { ...t, cond: swapped(e.swap, t.cond), value: swapped(e.swap, t.value) } });
    bi = bi + 1;
  }
  return ssasem.Func { ...f, graph: ssa.SFunc { ...g, blocks: blocks, nvals: e.values.len() }, values: e.values };
}

// A block's own instructions with each resolved read a copy of what it reads,
// every operand swapped, and `entry` placed after the parameters.
function block_insts(b: ssa.SBlock, entry: ssa.SInst[], swap: i32[]): ssa.SInst[] {
  let insts: ssa.SInst[] = [];
  let placed: boolean = entry.len() == 0;
  for ins in b.insts {
    if (!placed && ins.kind_tag != ssasem.param()) {
      insts = util.append_all(insts, entry);
      placed = true;
    }
    if (ins.result >= 0 && ins.result < swap.len() && swap[ins.result] >= 0) {
      insts = insts.append(ssa.SInst { kind_tag: 7, result: ins.result, args: [swapped(swap, ins.result)], imm: 0, str: "" });
    } else {
      insts = insts.append(ssa.SInst { ...ins, args: swapped_all(swap, ins.args) });
    }
  }
  if (!placed) {
    insts = util.append_all(insts, entry);
  }
  return insts;
}

// What a read resolved to stands for the read in every use, so an operand
// reads its part directly rather than through a copy the rc plan would count.
function swapped(swap: i32[], v: i32): i32 {
  let x: i32 = v;
  let steps: i32 = 0;
  while (x >= 0 && x < swap.len() && swap[x] >= 0 && steps < 64) {
    x = swap[x];
    steps = steps + 1;
  }
  return x;
}

// The value a callee with one return site returns stands for the call's
// result in every use, where the types agree: a copy of it would count as a
// second owner.
function result_swap(call: ssa.SInst, rets: i32[], ret_vals: i32[], values: typeinfo.Type[]): i32[] {
  let swap: i32[] = [];
  if (call.result < 0 || rets.len() != 1 || ret_vals.len() != 1 || !semtypes.equal(values[call.result], values[ret_vals[0]])) {
    return swap;
  }
  while (swap.len() <= call.result) {
    swap = swap.append(0 - 1);
  }
  return swap.with(call.result, ret_vals[0]);
}

// `blocks` with every operand and terminator value renamed through `swap`.
function swapped_blocks(blocks: ssa.SBlock[], swap: i32[]): ssa.SBlock[] {
  if (swap.len() == 0) {
    return blocks;
  }
  let out: ssa.SBlock[] = [];
  for b in blocks {
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      insts = insts.append(ssa.SInst { ...ins, args: swapped_all(swap, ins.args) });
    }
    let t: ssa.STerm = b.term;
    out = out.append(ssa.SBlock { ...b, insts: insts, term: ssa.STerm { ...t, cond: swapped(swap, t.cond), value: swapped(swap, t.value) } });
  }
  return out;
}

function swaps_any(swap: i32[], args: i32[]): boolean {
  for a in args {
    if (a >= 0 && a < swap.len() && swap[a] >= 0) {
      return true;
    }
  }
  return false;
}

function swapped_all(swap: i32[], args: i32[]): i32[] {
  if (!swaps_any(swap, args)) {
    return args;
  }
  let out: i32[] = [];
  for a in args {
    out = out.append(swapped(swap, a));
  }
  return out;
}

// Whether `t` is among the types the function's constructions build.
function built_type(f: ssasem.Func, built: typeinfo.Type[], t: typeinfo.Type): boolean {
  for b in built {
    if (semtypes.equal(b, t)) {
      return true;
    }
  }
  return false;
}

function count_insts(g: ssa.SFunc): i32 {
  let n: i32 = 0;
  for b in g.blocks {
    n = n + b.insts.len();
  }
  return n;
}

// Constructions, and phis and copies of a type one builds, that nothing reads.
// A box whose type has a finalizer is kept: dropping it would skip the drop.
function drop_unread(f: ssasem.Func): ssasem.Func {
  let g: ssa.SFunc = f.graph;
  let built: typeinfo.Type[] = built_types(g, f);
  if (built.len() == 0 && !has_static_closure(g)) {
    return f;
  }
  let reads: i32[] = read_counts(f);
  if (!any_unread(f, built, reads)) {
    return f;
  }
  let blocks: ssa.SBlock[] = [];
  for b in g.blocks {
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      if (!unread_build(f, built, reads, ins)) {
        insts = insts.append(ins);
      }
    }
    blocks = blocks.append(ssa.SBlock { ...b, insts: insts });
  }
  return ssasem.Func { ...f, graph: ssa.SFunc { ...g, blocks: blocks } };
}

function has_static_closure(g: ssa.SFunc): boolean {
  for b in g.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.closure_new() && ins.args.len() == 0) {
        return true;
      }
    }
  }
  return false;
}

function any_unread(f: ssasem.Func, built: typeinfo.Type[], reads: i32[]): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (unread_build(f, built, reads, ins)) {
        return true;
      }
    }
  }
  return false;
}

function built_types(g: ssa.SFunc, f: ssasem.Func): typeinfo.Type[] {
  let built: typeinfo.Type[] = [];
  for b in g.blocks {
    for ins in b.insts {
      if (builds(ins.kind_tag) && ins.result >= 0 && !built_type(f, built, f.values[ins.result])) {
        built = built.append(f.values[ins.result]);
      }
    }
  }
  return built;
}

// How often each value is read: as an operand, by a terminator, or as a
// source variable under `-g`, which a debugger reads.
function read_counts(f: ssasem.Func): i32[] {
  let g: ssa.SFunc = f.graph;
  let reads: i32[] = [];
  let v: i32 = 0;
  while (v < g.nvals) {
    reads = reads.append(0);
    v = v + 1;
  }
  for b in g.blocks {
    for ins in b.insts {
      for a in ins.args {
        reads = counted(reads, a);
      }
    }
    if (b.term.kind_tag == 1) {
      reads = counted(reads, b.term.value);
    }
    if (b.term.kind_tag == 3) {
      reads = counted(reads, b.term.cond);
    }
  }
  for v in f.dbg_vals {
    reads = counted(reads, v);
  }
  return reads;
}

function counted(own reads: i32[], v: i32): i32[] {
  if (v < 0 || v >= reads.len()) {
    return reads;
  }
  return reads.with(v, reads[v] + 1);
}

function unread_build(f: ssasem.Func, built: typeinfo.Type[], reads: i32[], ins: ssa.SInst): boolean {
  if (ins.result < 0 || ins.result >= reads.len() || reads[ins.result] != 0) {
    return false;
  }
  // Capture-free closure constants have no capture lifetime to preserve.
  // read_counts includes debug bindings, so those remain visible under -g.
  if (ins.kind_tag == ssasem.closure_new() && ins.args.len() == 0) {
    return true;
  }
  if (!builds(ins.kind_tag) && ins.kind_tag != 7 && ins.kind_tag != 8) {
    return false;
  }
  return built_type(f, built, f.values[ins.result]) && ssasem.finalizer_of(f, f.values[ins.result]) == "";
}
