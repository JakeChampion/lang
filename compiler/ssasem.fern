pub function fresh_result_builtin(name: string): boolean {
  return name == "__sem_bytes_unique" || name == "__bytes_owned" || name == "__bytes_range" || name == "__bytes_into" || name == "__aes_expand_key" || name == "__aes_ctr32"
    || name == "__ghash" || name == "__aes_gcm_seal" || name == "__aes_gcm_open" || name == "__sha256_hw_blocks" || name == "__sha1_hw_blocks";
}

pub function scalar_primitive(name: string): boolean {
  return name == "__mulhi_u64" || name == "__clz32" || name == "__ctz32" || name == "__popcount32" || name == "__clz64"
    || name == "__ctz64" || name == "__popcount64" || name == "__sqrt_f64" || name == "__floor_f64" || name == "__ceil_f64"
    || name == "__round_f64" || name == "__trunc_f64" || name == "__abs_f64";
}

