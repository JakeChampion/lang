pub function is_hole_op(kind: i32): boolean {
  return kind == hole_at() || kind == hole_fill();
}

pub function refused_analysis(why: string): Analysis {
  return failed(why);
}

function failed(why: string): Analysis {
  return Analysis { ok: false, why: why, parents: [], dependencies: [], flow: ssalive.Flow { ok: false, why: why, words: 0, live_in: [], live_out: [], slot: [], slot_value: [], at: [], none: [] }, uses: Uses { start: [0], kinds: [], block: [], at: [], slot: [] }, anchored: Anchored { start: [0], at: [] } };
}

function empty_dependencies(n: i32): i32[][] {
  let out: i32[][] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append([]);
    i = i + 1;
  }
  return out;
}

pub function is_i32(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.width == 32 && !i.unsigned && !i.is_char;
  }
  return false;
}

pub function is_u8(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.width == 8 && i.unsigned && !i.is_char;
  }
  return false;
}

pub function is_u32(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.width == 32 && i.unsigned && !i.is_char;
  }
  return false;
}

pub function is_i64(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.width == 64 && !i.unsigned && !i.is_char;
  }
  return false;
}

pub function is_u64(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.width == 64 && i.unsigned && !i.is_char;
  }
  return false;
}

pub function is_wide(t: typeinfo.Type): boolean {
  return is_i64(t) || is_u64(t);
}

pub function is_usize(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.width == typeinfo.width_ptr() && i.unsigned && !i.is_char;
  }
  return false;
}

pub function is_unsigned_int(t: typeinfo.Type): boolean {
  return is_u8(t) || is_u32(t) || is_u64(t) || is_usize(t);
}

pub function is_f64(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFloat(fl) = t {
    return fl.width == 64 && !fl.polymorphic;
  }
  return false;
}

pub function is_f32(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFloat(fl) = t {
    return fl.width == 32 && !fl.polymorphic;
  }
  return false;
}

pub function is_float(t: typeinfo.Type): boolean {
  return is_f64(t) || is_f32(t);
}

pub function is_lanes(t: typeinfo.Type): boolean {
  if let typeinfo.TypeLanes(_) = t {
    return true;
  }
  return false;
}

pub function is_integer(t: typeinfo.Type): boolean {
  return is_i32(t) || is_u8(t) || is_u32(t) || is_i64(t) || is_u64(t) || is_usize(t);
}

pub function reference(t: typeinfo.Type): boolean {
  if (semtypes.is_handle(t)) {
    return false;
  }
  if let typeinfo.TypeString(_) = t {
    return true;
  }
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  if let typeinfo.TypeUnion(_) = t {
    return true;
  }
  if let typeinfo.TypeFunc(_) = t {
    return true;
  }
  if let typeinfo.TypeMap(_) = t {
    return true;
  }
  if let typeinfo.TypeDyn(_) = t {
    return true;
  }
  return false;
}

pub function text_constant(t: typeinfo.Type): boolean {
  return is_wide(t) || is_u32(t);
}

pub function is_bool(t: typeinfo.Type): boolean {
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  return false;
}

function is_void(t: typeinfo.Type): boolean {
  if let typeinfo.TypeVoid(_) = t {
    return true;
  }
  return false;
}

pub function is_string(t: typeinfo.Type): boolean {
  if let typeinfo.TypeString(s) = t {
    return s.tag == 0;
  }
  return false;
}

pub function is_view(t: typeinfo.Type): boolean {
  if let typeinfo.TypeString(s) = t {
    return s.tag == 1;
  }
  return false;
}

pub function is_text(t: typeinfo.Type): boolean {
  return is_string(t) || is_view(t);
}

pub function is_text_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return !a.view && is_text(a.elem);
  }
  return false;
}

pub function is_char(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(i) = t {
    return i.is_char;
  }
  return false;
}

pub function can_hold(f: Func, outer: typeinfo.Type, inner: typeinfo.Type): boolean {
  let names: string[] = box_names(f, inner);
  let key: string = type_key(inner);
  let seen: string[] = [];
  let work: typeinfo.Type[] = [outer];
  let wi: i32 = 0;
  while (wi < work.len()) {
    let t: typeinfo.Type = work[wi];
    wi = wi + 1;
    let k: string = type_key(t);
    if (k == key) {
      return true;
    }
    if (util.index_of_str(seen, k) >= 0) {
      continue;
    }
    seen = seen.append(k);
    if (semtypes.is_cell(t)) {
      work = work.append(semtypes.cell_elem(t));
      continue;
    }
    match (t) {
      typeinfo.TypeArray(a) => {
        work = work.append(a.elem);
      },
      typeinfo.TypeTuple(tup) => {
        for e in tup.elements {
          work = work.append(e);
        }
      },
      typeinfo.TypeMap(m) => {
        work = work.append(m.key).append(m.value);
      },
      typeinfo.TypeStruct(r) => {
        if (util.index_of_str(names, r.name) >= 0) {
          return true;
        }
        let at: i32 = semrecords.find(f.records, t);
        if (at < 0) {
          return true;
        }
        for field in f.records.list[at].fields {
          work = work.append(field.ty);
        }
      },
      typeinfo.TypeUnion(u) => {
        if (util.index_of_str(names, u.name) >= 0) {
          return true;
        }
        let at: i32 = semrecords.find_enum(f.enums, t);
        if (at < 0) {
          return true;
        }
        for v in f.enums[at].variants {
          if (util.index_of_str(names, v.name) >= 0) {
            return true;
          }
          for field in v.fields {
            work = work.append(field.ty);
          }
        }
      },
      typeinfo.TypeFunc(_) => {
        return true;
      },
      typeinfo.TypeDyn(_) => {
        return true;
      },
      typeinfo.TypeUnknown(_) => {
        return true;
      },
      typeinfo.TypeErased(_) => {
        return true;
      },
      _ => {}
    }
  }
  return false;
}

function box_names(f: Func, t: typeinfo.Type): string[] {
  let out: string[] = [];
  if let typeinfo.TypeUnion(u) = t {
    out = out.append(u.name);
    let at: i32 = semrecords.find_enum(f.enums, t);
    if (at >= 0) {
      for v in f.enums[at].variants {
        out = out.append(v.name);
      }
    }
  }
  if let typeinfo.TypeStruct(r) = t {
    out = out.append(r.name);
    for e in f.enums {
      for v in e.variants {
        if (v.name == r.name) {
          if let typeinfo.TypeUnion(u) = e.ty {
            out = out.append(u.name);
          }
        }
      }
    }
  }
  return out;
}

pub function is_dyn(t: typeinfo.Type): boolean {
  if let typeinfo.TypeDyn(_) = t {
    return true;
  }
  return false;
}

pub function dyn_call_name(method: string, traits: string[], arms: string[]): string {
  let out: string = "dyn " + method + "|";
  let i: i32 = 0;
  while (i < traits.len()) {
    if (i > 0) {
      out = out + ",";
    }
    out = out + traits[i];
    i = i + 1;
  }
  out = out + "|";
  i = 0;
  while (i < arms.len()) {
    if (i > 0) {
      out = out + ",";
    }
    out = out + arms[i];
    i = i + 1;
  }
  return out;
}

pub function is_dyn_call(name: string): boolean {
  return name.len() > 4 && name[0] == b'd' && name[1] == b'y' && name[2] == b'n' && name[3] == b' ';
}

pub function dyn_call_arms(name: string): string[] {
  let out: string[] = [];
  let start: i32 = name.len();
  while (start > 4 && name[start - 1] != b'|') {
    start = start - 1;
  }
  let k: i32 = start;
  while (k <= name.len()) {
    if (k == name.len() || name[k] == b',') {
      if (k > start) {
        out = out.append(slice_unchecked(name, start, k) + "");
      }
      start = k + 1;
    }
    k = k + 1;
  }
  return out;
}

pub function is_func(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFunc(_) = t {
    return true;
  }
  return false;
}

pub function is_map(t: typeinfo.Type): boolean {
  if let typeinfo.TypeMap(_) = t {
    return true;
  }
  return false;
}

pub function map_key(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeMap(m) = t {
    return m.key;
  }
  return typeinfo.unchecked();
}

pub function map_value(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeMap(m) = t {
    return m.value;
  }
  return typeinfo.unchecked();
}

pub function is_supported_map(t: typeinfo.Type): boolean {
  if (!is_map(t)) {
    return false;
  }
  if (!is_text(map_key(t)) && !narrow_map_value(map_key(t)) && !wide_map_key(map_key(t)) && !keyed_map_key(map_key(t))) {
    return false;
  }
  return narrow_map_value(map_value(t)) || wide_map_value(map_value(t)) || float_map_value(map_value(t)) || counted_map_value(map_value(t));
}

pub function wide_map_value(v: typeinfo.Type): boolean {
  return is_integer(v) && is_wide(v);
}

pub function wide_map_key(k: typeinfo.Type): boolean {
  return is_integer(k) && is_wide(k);
}

pub function float_map_value(v: typeinfo.Type): boolean {
  return is_float(v);
}

pub function keyed_map_key(k: typeinfo.Type): boolean {
  if (semtypes.is_handle(k) || semtypes.is_env(k) || semtypes.is_cell(k)) {
    return false;
  }
  if let typeinfo.TypeStruct(r) = k {
    return r.args.len() == 0;
  }
  if let typeinfo.TypeUnion(u) = k {
    return u.args.len() == 0;
  }
  return structural_map_key(k);
}

pub function structural_map_key(k: typeinfo.Type): boolean {
  if let typeinfo.TypeTuple(tup) = k {
    for e in tup.elements {
      if (!structural_key_element(e)) {
        return false;
      }
    }
    return tup.elements.len() > 0;
  }
  if let typeinfo.TypeArray(a) = k {
    return structural_key_element(a.elem);
  }
  return false;
}

function identifier_key(key: string): string {
  let out: string = "";
  let i: i32 = 0;
  while (i < key.len()) {
    let c: u8 = key[i];
    if (c >= b'a' && c <= b'z' || c >= b'A' && c <= b'Z' || c >= b'0' && c <= b'9' || c == b'_') {
      out = out + slice_unchecked(key, i, i + 1);
    } else {
      out = out + "_";
    }
    i = i + 1;
  }
  return out;
}

function structural_key_element(e: typeinfo.Type): boolean {
  return is_integer(e) || is_bool(e) || is_char(e) || is_string(e) || structural_map_key(e);
}

pub function keyed_map_key_fn(k: typeinfo.Type, which: string): string {
  if (structural_map_key(k)) {
    return keyed_map_key_name(k) + "__" + which;
  }
  return keyed_map_key_name(k) + "." + which;
}

pub function keyed_map_key_name(k: typeinfo.Type): string {
  if let typeinfo.TypeStruct(r) = k {
    return r.name;
  }
  if let typeinfo.TypeUnion(u) = k {
    return u.name;
  }
  if (structural_map_key(k)) {
    return "__fern_key" + identifier_key(type_key(k));
  }
  return "";
}

pub function retained_column(elem: typeinfo.Type): boolean {
  return is_string(elem) || narrow_column(elem) || wide_map_value(elem) || float_map_value(elem) || keyed_map_key(elem) || counted_map_value(elem);
}

function narrow_column(t: typeinfo.Type): boolean {
  return semtypes.is_never(t) || is_i32(t) || is_char(t) || is_u8(t) || is_u32(t) || is_bool(t) || is_usize(t);
}

pub function narrow_map_value(v: typeinfo.Type): boolean {
  return semtypes.is_never(v) || is_bool(v) || is_char(v) || is_integer(v) && !is_wide(v);
}

pub function counted_map_value(v: typeinfo.Type): boolean {
  return is_string(v) || is_string_array(v) || boxed_map_value(v);
}

pub function is_string_array(v: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = v {
    return is_string(a.elem);
  }
  return false;
}

pub function boxed_map_value(v: typeinfo.Type): boolean {
  return reference(v) && !is_string(v) && !is_string_array(v);
}

pub function func_params(t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeFunc(fn) = t {
    return fn.param_types;
  }
  return [];
}

pub function func_param_own(t: typeinfo.Type, i: i32): boolean {
  if let typeinfo.TypeFunc(fn) = t {
    return typeinfo.fn_own_at(fn, i);
  }
  return false;
}

pub function func_result(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeFunc(fn) = t {
    return fn.ret_type;
  }
  return typeinfo.unchecked();
}

pub function closure_env(c: Contract): boolean {
  if (c.params.len() == 0) {
    return false;
  }
  if let typeinfo.TypeArray(a) = c.params[0] {
    return semtypes.equal(a.elem, env_word());
  }
  return semtypes.is_env(c.params[0]);
}

pub function env_type(body: string, captures: typeinfo.Type[]): typeinfo.Type {
  return typeinfo.TypeStruct { name: semtypes.env_prefix() + body, args: captures };
}

pub function closure_captures(c: Contract): typeinfo.Type[] {
  if (c.params.len() == 0) {
    return [];
  }
  return semtypes.env_captures(c.params[0]);
}

function env_word(): typeinfo.Type {
  return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false, polymorphic: false };
}

pub function closure_type(c: Contract): typeinfo.Type {
  let params: typeinfo.Type[] = [];
  let owns: boolean[] = [];
  let i: i32 = 1;
  while (i < c.params.len()) {
    params = params.append(c.params[i]);
    owns = owns.append(consuming_mode(c.modes, i, c.params[i]));
    i = i + 1;
  }
  return typeinfo.TypeFunc { param_types: params, param_own: typeinfo.own_flags(owns, params), ret_type: c.result, params_known: true };
}

pub function value_mode(): i32 {
  return 1;
}

pub function borrow_mode(): i32 {
  return 2;
}

pub function counted_mode(): i32 {
  return 3;
}

function consuming_mode(modes: i32[], i: i32, t: typeinfo.Type): boolean {
  if (i >= modes.len()) {
    return false;
  }
  return modes[i] == counted_mode() && typeinfo.ownable(t);
}

function parameter_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 0 || ins.result != ins.imm || !semtypes.equal(result, f.params[ins.imm])) {
    return "parameter type or identity";
  }
  return "";
}

function copy_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.kind_tag == 7 && ins.args.len() != 1 || ins.kind_tag == 8 && ins.args.len() == 0) {
    return "copy or phi arity";
  }
  for arg in ins.args {
    if (!semtypes.equal(result, f.values[arg])) {
      return "copy or phi type";
    }
  }
  return "";
}

function integer_constant_error(ins: ssa.SInst, result: typeinfo.Type): string {
  if (is_void(result)) {
    if (ins.imm != 0 || ins.str != "") {
      return "unit constant";
    }
    return "";
  }
  if (!is_integer(result) && !is_char(result)) {
    return "integer constant type";
  }
  if (text_constant(result)) {
    if (ins.str == "" || ins.imm != 0) {
      return "constant needs its literal text";
    }
    return "";
  }
  if (ins.str != "" && (!is_usize(result) || ins.imm != 0)) {
    return "narrow constant carries text";
  }
  if (is_u8(result) && (ins.imm < 0 || ins.imm > 255)) {
    return "integer constant range";
  }
  return "";
}

function float_constant_error(ins: ssa.SInst): string {
  if (ins.str == "" || ins.imm != 0) {
    return "float constant needs its literal text";
  }
  return "";
}

function constant_error(ins: ssa.SInst, result: typeinfo.Type): string {
  if (ins.args.len() != 0) {
    return "constant arity";
  }
  if (ins.kind_tag == 1 && is_float(result)) {
    return float_constant_error(ins);
  }
  if (ins.kind_tag == 1) {
    return integer_constant_error(ins, result);
  }
  if (ins.kind_tag == 2 && (!is_bool(result) || ins.imm != 0 && ins.imm != 1)) {
    return "boolean constant type or value";
  }
  if (ins.kind_tag == 5 && !is_text(result)) {
    return "string constant type";
  }
  return "";
}

function array_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if let typeinfo.TypeArray(a) = result {
    if (a.view) {
      return "array construction must own storage";
    }
    for arg in ins.args {
      if (!semtypes.equal(a.elem, f.values[arg])) {
        return "array element type";
      }
    }
    return "";
  }
  return "array construction type";
}

function bytes_construction_error(ins: ssa.SInst, result: typeinfo.Type): string {
  if (ins.args.len() != 0 || !byteconst.valid(ins.str, ins.imm)) {
    return "constant byte array payload";
  }
  if let typeinfo.TypeArray(a) = result {
    if (!a.view && is_u8(a.elem)) {
      return "";
    }
  }
  return "constant byte array type";
}

function array_reserve_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1 || !is_i32(f.values[ins.args[0]])) {
    return "array reserve capacity type";
  }
  if let typeinfo.TypeArray(a) = result {
    if (!a.view && (is_integer(a.elem) || is_float(a.elem) || is_bool(a.elem) || is_char(a.elem))) {
      return "";
    }
  }
  return "array reserve requires owned scalar elements";
}

function tuple_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if let typeinfo.TypeTuple(tup) = result {
    if (ins.args.len() != tup.elements.len()) {
      return "tuple construction arity";
    }
    let i: i32 = 0;
    while (i < ins.args.len()) {
      if (!semtypes.equal(tup.elements[i], f.values[ins.args[i]])) {
        return "tuple element type";
      }
      i = i + 1;
    }
    return "";
  }
  return "tuple construction type";
}

function array_projection_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 2) {
    return "array projection arity";
  }
  if (!is_i32(f.values[ins.args[1]])) {
    return "array index type";
  }
  if let typeinfo.TypeArray(a) = f.values[ins.args[0]] {
    if (!semtypes.equal(a.elem, result) && !lane_group(a.elem, result)) {
      return "array projection type";
    }
    return "";
  }
  return "array container type";
}

pub function lane_group(elem: typeinfo.Type, t: typeinfo.Type): boolean {
  if let typeinfo.TypeLanes(l) = t {
    if let typeinfo.TypeFloat(e) = elem {
      return e.width == l.width;
    }
  }
  return false;
}

function tuple_projection_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "tuple projection arity";
  }
  if let typeinfo.TypeTuple(tup) = f.values[ins.args[0]] {
    if (ins.imm < 0 || ins.imm >= tup.elements.len()) {
      return "tuple projection index";
    }
    if (!semtypes.equal(tup.elements[ins.imm], result)) {
      return "tuple projection type";
    }
    return "";
  }
  return "tuple container type";
}

function record_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  let donor: i32 = update_base(ins);
  if (ins.imm < 0 || donor >= f.values.len()) {
    return "record update donor index";
  }
  if (donor >= 0 && !semtypes.equal(f.values[donor], result)) {
    return "record update donor type";
  }
  let at: i32 = semrecords.find(f.records, result);
  if (at < 0) {
    return "missing record construction schema";
  }
  let fields: semrecords.Field[] = f.records.list[at].fields;
  if (ins.args.len() != fields.len()) {
    return "record construction arity";
  }
  let i: i32 = 0;
  while (i < fields.len()) {
    if (!semtypes.equal(fields[i].ty, f.values[ins.args[i]])) {
      return "record field type";
    }
    i = i + 1;
  }
  return "";
}

function append_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 2) {
    return "append arity";
  }
  let recv: typeinfo.Type = f.values[ins.args[0]];
  if (!semtypes.equal(recv, result)) {
    return "append result type";
  }
  if let typeinfo.TypeArray(a) = recv {
    if (a.view) {
      return "append receiver must own storage";
    }
    if (!semtypes.equal(a.elem, f.values[ins.args[1]])) {
      return "append element type";
    }
    return "";
  }
  return "append container type";
}

function with_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 3) {
    return "with arity";
  }
  let recv: typeinfo.Type = f.values[ins.args[0]];
  if (!semtypes.equal(recv, result)) {
    return "with result type";
  }
  if (!is_i32(f.values[ins.args[1]])) {
    return "with index type";
  }
  if let typeinfo.TypeArray(a) = recv {
    if (a.view) {
      return "with receiver must own storage";
    }
    if (!semtypes.equal(a.elem, f.values[ins.args[2]]) && !lane_group(a.elem, f.values[ins.args[2]])) {
      return "with element type";
    }
    return "";
  }
  return "with container type";
}

function length_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "length arity";
  }
  if (!is_i32(result)) {
    return "length result type";
  }
  let recv: typeinfo.Type = f.values[ins.args[0]];
  if let typeinfo.TypeArray(_) = recv {
    return "";
  }
  if (is_text(recv)) {
    return "";
  }
  return "length container type";
}

function record_projection_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "record projection arity";
  }
  let at: i32 = semrecords.find(f.records, f.values[ins.args[0]]);
  if (at < 0) {
    return "missing record projection schema";
  }
  let fields: semrecords.Field[] = f.records.list[at].fields;
  if (ins.imm < 0 || ins.imm >= fields.len()) {
    return "record projection index";
  }
  if (ins.str != fields[ins.imm].name) {
    return "record projection field identity";
  }
  if (!semtypes.equal(fields[ins.imm].ty, result)) {
    return "record projection type";
  }
  return "";
}

function variant_fields(f: Func, t: typeinfo.Type, name: string): semrecords.Field[] {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0) {
    return [];
  }
  let v: i32 = semrecords.find_variant(f.enums[at], name);
  if (v < 0) {
    return [];
  }
  return f.enums[at].variants[v].fields;
}

function variant_known(f: Func, t: typeinfo.Type, name: string): string {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0) {
    return "missing variant schema";
  }
  if (semrecords.find_variant(f.enums[at], name) < 0) {
    return "unknown variant";
  }
  return "";
}

function variant_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  let why: string = variant_known(f, result, ins.str);
  if (why != "") {
    return why;
  }
  let fields: semrecords.Field[] = variant_fields(f, result, ins.str);
  if (ins.args.len() != fields.len()) {
    return "variant construction arity";
  }
  let i: i32 = 0;
  while (i < fields.len()) {
    if (!semtypes.equal(fields[i].ty, f.values[ins.args[i]])) {
      return "variant field type";
    }
    i = i + 1;
  }
  return "";
}

function variant_test_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "variant test arity";
  }
  if (!is_bool(result)) {
    return "variant test type";
  }
  return variant_known(f, f.values[ins.args[0]], ins.str);
}

function variant_projection_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "variant projection arity";
  }
  let why: string = variant_known(f, f.values[ins.args[0]], ins.str);
  if (why != "") {
    return why;
  }
  let fields: semrecords.Field[] = variant_fields(f, f.values[ins.args[0]], ins.str);
  if (ins.imm < 0 || ins.imm >= fields.len()) {
    return "variant projection index";
  }
  if (!semtypes.equal(fields[ins.imm].ty, result)) {
    return "variant projection type";
  }
  return "";
}

function member_layout(f: Func, t: typeinfo.Type): boolean {
  let at: i32 = semrecords.find_enum(f.enums, t);
  return at >= 0 && f.enums[at].layout == semrecords.layout_member();
}

function member_named(t: typeinfo.Type, name: string): boolean {
  if let typeinfo.TypeStruct(r) = t {
    return r.args.len() == 0 && r.name == name;
  }
  return false;
}

function widening_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "variant widening arity";
  }
  if (!member_layout(f, result)) {
    return "variant widening layout";
  }
  let why: string = variant_known(f, result, ins.str);
  if (why != "") {
    return why;
  }
  if (!member_named(f.values[ins.args[0]], ins.str)) {
    return "variant widening type";
  }
  return "";
}

function dyn_widening_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "dyn widening arity";
  }
  if (!is_dyn(result)) {
    return "dyn widening type";
  }
  let from: typeinfo.Type = f.values[ins.args[0]];
  if let typeinfo.TypeStruct(_) = from {
    return "";
  }
  if let typeinfo.TypeUnion(_) = from {
    return "";
  }
  return "dyn widening operand";
}

function dyn_test_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "dyn test arity";
  }
  if (!is_bool(result)) {
    return "dyn test type";
  }
  if (!is_dyn(f.values[ins.args[0]])) {
    return "dyn test operand";
  }
  return "";
}

function dyn_narrowing_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "dyn narrowing arity";
  }
  if (!is_dyn(f.values[ins.args[0]])) {
    return "dyn narrowing operand";
  }
  if (ins.str == "") {
    if (semtypes.equal(f.values[ins.args[0]], result)) {
      return "";
    }
    return "dyn narrowing type";
  }
  if let typeinfo.TypeStruct(r) = result {
    if (r.args.len() == 0 && r.name == ins.str) {
      return "";
    }
  }
  if let typeinfo.TypeUnion(u) = result {
    if (u.name == ins.str) {
      return "";
    }
  }
  return "dyn narrowing type";
}

function dyn_box_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "dyn box arity";
  }
  if (!is_dyn(result)) {
    return "dyn box type";
  }
  let from: typeinfo.Type = f.values[ins.args[0]];
  if (!boxes_into_dyn(from) || typeinfo.spelling(from) != ins.str) {
    return "dyn box operand";
  }
  return "";
}

pub function boxes_into_dyn(t: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(_) = t {
    return true;
  }
  if let typeinfo.TypeBool(_) = t {
    return true;
  }
  if let typeinfo.TypeFloat(_) = t {
    return true;
  }
  return is_string(t);
}

function narrowing_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "variant narrowing arity";
  }
  let whole: typeinfo.Type = f.values[ins.args[0]];
  if (!member_layout(f, whole)) {
    return "variant narrowing layout";
  }
  let why: string = variant_known(f, whole, ins.str);
  if (why != "") {
    return why;
  }
  if (!member_named(result, ins.str)) {
    return "variant narrowing type";
  }
  return "";
}

function retag_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "string retag arity";
  }
  let from: typeinfo.Type = f.values[ins.args[0]];
  let texts: boolean = is_text(from) && is_text(result);
  let arrays: boolean = is_text_array(from) && is_text_array(result);
  if (!texts && !arrays || semtypes.equal(from, result)) {
    return "string retag type";
  }
  return "";
}

function closure_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (!is_func(result)) {
    return "closure value type";
  }
  let at: i32 = find_contract_in(f.calls, ins.str);
  if (at < 0) {
    return "missing closure body contract";
  }
  let c: Contract = f.calls[at];
  if (!closure_env(c)) {
    return "closure environment parameter";
  }
  if (!semtypes.equal(closure_type(c), result)) {
    return "closure signature";
  }
  let caps: typeinfo.Type[] = closure_captures(c);
  if (ins.args.len() != caps.len()) {
    return "closure capture count";
  }
  let i: i32 = 0;
  while (i < caps.len()) {
    if (!semtypes.equal(f.values[ins.args[i]], caps[i])) {
      return "closure capture type";
    }
    i = i + 1;
  }
  return "";
}

function call_value_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() == 0) {
    return "indirect call arity";
  }
  let sig: typeinfo.Type = f.values[ins.args[0]];
  if (!is_func(sig)) {
    return "indirect call target type";
  }
  let params: typeinfo.Type[] = func_params(sig);
  if (ins.args.len() != params.len() + 1) {
    return "indirect call arity";
  }
  let i: i32 = 0;
  while (i < params.len()) {
    if (!semtypes.equal(params[i], f.values[ins.args[i + 1]])) {
      return "indirect call argument type";
    }
    i = i + 1;
  }
  if (!semtypes.equal(func_result(sig), result)) {
    return "indirect call result type";
  }
  return "";
}

pub function is_function_op(kind: i32): boolean {
  return kind == closure_new() || kind == call_value();
}

function function_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.kind_tag == closure_new()) {
    return closure_error(ins, f, result);
  }
  return call_value_error(ins, f, result);
}

function variant_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.kind_tag == variant_new()) {
    return variant_construction_error(ins, f, result);
  }
  if (ins.kind_tag == variant_is()) {
    return variant_test_error(ins, f, result);
  }
  if (ins.kind_tag == variant_up()) {
    return widening_error(ins, f, result);
  }
  if (ins.kind_tag == dyn_up()) {
    return dyn_widening_error(ins, f, result);
  }
  if (ins.kind_tag == dyn_box()) {
    return dyn_box_error(ins, f, result);
  }
  if (ins.kind_tag == dyn_is()) {
    return dyn_test_error(ins, f, result);
  }
  if (ins.kind_tag == dyn_as()) {
    return dyn_narrowing_error(ins, f, result);
  }
  if (ins.kind_tag == str_as()) {
    return retag_error(ins, f, result);
  }
  if (ins.kind_tag == array_lend()) {
    if (ins.args.len() != 1) {
      return "array lend arity";
    }
    if (!semtypes.lends_array(f.values[ins.args[0]], result)) {
      return "array lend type";
    }
    return "";
  }
  if (ins.kind_tag == variant_as()) {
    return narrowing_error(ins, f, result);
  }
  return variant_projection_error(ins, f, result);
}

function slice_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 3) {
    return "slice arity";
  }
  if (!is_view(result) || !is_text(f.values[ins.args[0]])) {
    return "slice container type";
  }
  if (!is_i32(f.values[ins.args[1]]) || !is_i32(f.values[ins.args[2]])) {
    return "slice bound type";
  }
  return "";
}

function append_range_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 4) {
    return "append range arity";
  }
  if (!is_string(result) || !is_string(f.values[ins.args[0]]) || !is_text(f.values[ins.args[1]])) {
    return "append range string type";
  }
  if (!is_i32(f.values[ins.args[2]]) || !is_i32(f.values[ins.args[3]])) {
    return "append range bound type";
  }
  return "";
}

function arr_helper_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.kind_tag == arr_concat()) {
    return arr_concat_error(ins, f, result);
  }
  return arr_join_error(ins, f, result);
}

function arr_concat_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 2) {
    return "array concat arity";
  }
  if (!semtypes.equal(f.values[ins.args[0]], result) || !semtypes.equal(f.values[ins.args[1]], result)) {
    return "array concat operand type";
  }
  if let typeinfo.TypeArray(a) = result {
    if (!a.view && !reference(a.elem)) {
      return "";
    }
  }
  return "array concat result";
}

function arr_slice_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 3) {
    return "slice arity";
  }
  let src: typeinfo.Type = f.values[ins.args[0]];
  if (!semtypes.equal(src, result) && !semtypes.lends_array(src, result)) {
    return "slice container type";
  }
  if let typeinfo.TypeArray(a) = result {
    if (!a.view) {
      return "slice result must be a view";
    }
  } else {
    return "slice container type";
  }
  if (!is_i32(f.values[ins.args[1]]) || !is_i32(f.values[ins.args[2]])) {
    return "slice bound type";
  }
  return "";
}

function str_index_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 2) {
    return "string index arity";
  }
  if (!is_u8(result)) {
    return "string index result type";
  }
  if (!is_text(f.values[ins.args[0]])) {
    return "string index container type";
  }
  if (!is_i32(f.values[ins.args[1]])) {
    return "string index type";
  }
  return "";
}

function is_builtin_op(kind: i32): boolean {
  return kind == length() || kind == append() || kind == with() || kind == slice() || kind == str_index()
    || kind == append_range() || kind == str_bytes() || kind == str_byte_view() || kind == arr_slice() || is_arr_helper_op(kind) || is_cell_op(kind) || is_map_op(kind);
}

pub function is_arr_helper_op(kind: i32): boolean {
  return kind == arr_join() || kind == arr_concat();
}

pub function is_cell_op(kind: i32): boolean {
  return kind == cell_new() || kind == cell_get() || kind == cell_set();
}

pub function is_map_op(kind: i32): boolean {
  return kind == map_new() || kind == map_insert() || kind == map_has() || kind == map_get_or() || kind == map_len() || kind == map_get()
    || kind == map_keys() || kind == map_values() || kind == map_delete() || kind == map_cleared();
}

function str_bytes_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "str bytes arity";
  }
  if (!is_text(f.values[ins.args[0]])) {
    return "str bytes receiver";
  }
  if let typeinfo.TypeArray(a) = result {
    if (a.view == (ins.kind_tag == str_byte_view()) && is_u8(a.elem)) {
      return "";
    }
  }
  return "str bytes result";
}

function arr_join_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 2) {
    return "array join arity";
  }
  if (!is_string(result)) {
    return "array join result";
  }
  if (!is_text(f.values[ins.args[1]])) {
    return "array join separator";
  }
  if let typeinfo.TypeArray(a) = f.values[ins.args[0]] {
    if (is_string(a.elem)) {
      return "";
    }
  }
  return "array join receiver";
}

function builtin_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (is_arr_helper_op(ins.kind_tag)) {
    return arr_helper_error(ins, f, result);
  }
  if (ins.kind_tag == length()) {
    return length_error(ins, f, result);
  }
  if (ins.kind_tag == slice()) {
    return slice_error(ins, f, result);
  }
  if (ins.kind_tag == append_range()) {
    return append_range_error(ins, f, result);
  }
  if (ins.kind_tag == arr_slice()) {
    return arr_slice_error(ins, f, result);
  }
  if (ins.kind_tag == str_index()) {
    return str_index_error(ins, f, result);
  }
  if (ins.kind_tag == str_bytes() || ins.kind_tag == str_byte_view()) {
    return str_bytes_error(ins, f, result);
  }
  if (ins.kind_tag == with()) {
    return with_error(ins, f, result);
  }
  if (is_cell_op(ins.kind_tag)) {
    return cell_error(ins, f, result);
  }
  if (is_map_op(ins.kind_tag)) {
    return map_error(ins, f, result);
  }

  return append_error(ins, f, result);
}

function cell_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.kind_tag == cell_new()) {
    return cell_construction_error(ins, f, result);
  }
  if (ins.kind_tag == cell_get()) {
    return cell_read_error(ins, f, result);
  }
  return cell_write_error(ins, f, result);
}

function cell_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "cell construction arity";
  }
  if (!semtypes.is_cell(result)) {
    return "cell construction type";
  }
  if (!semtypes.equal(semtypes.cell_elem(result), f.values[ins.args[0]])) {
    return "cell element type";
  }
  return "";
}

function cell_read_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "cell read arity";
  }
  let cell: typeinfo.Type = f.values[ins.args[0]];
  if (!semtypes.is_cell(cell)) {
    return "cell read type";
  }
  if (!semtypes.equal(semtypes.cell_elem(cell), result)) {
    return "cell element type";
  }
  return "";
}

function cell_write_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 2) {
    return "cell write arity";
  }
  let cell: typeinfo.Type = f.values[ins.args[0]];
  if (!semtypes.is_cell(cell)) {
    return "cell write type";
  }
  if (!semtypes.equal(semtypes.cell_elem(cell), f.values[ins.args[1]])) {
    return "cell element type";
  }
  if (!is_void(result)) {
    return "cell write result";
  }
  return "";
}

function map_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.kind_tag == map_new()) {
    return map_construction_error(ins, f, result);
  }
  if (ins.kind_tag == map_insert()) {
    return map_insert_error(ins, f, result);
  }
  if (ins.kind_tag == map_has()) {
    return map_has_error(ins, f, result);
  }
  if (ins.kind_tag == map_len()) {
    return map_len_error(ins, f, result);
  }
  if (ins.kind_tag == map_get()) {
    return map_get_error(ins, f, result);
  }
  if (ins.kind_tag == map_keys()) {
    return map_column_error(ins, f, result, true);
  }
  if (ins.kind_tag == map_values()) {
    return map_column_error(ins, f, result, false);
  }
  if (ins.kind_tag == map_delete()) {
    return map_delete_error(ins, f, result);
  }
  if (ins.kind_tag == map_cleared()) {
    return map_cleared_error(ins, f, result);
  }
  return map_get_or_error(ins, f, result);
}

function map_delete_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 2) {
    return "map delete arity";
  }
  let m: typeinfo.Type = f.values[ins.args[0]];
  if (!is_supported_map(m)) {
    return "map delete type";
  }
  if (!semtypes.equal(m, result)) {
    return "map delete result";
  }
  return map_operand_error(m, f.values[ins.args[1]], map_value(m));
}

function map_cleared_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 0) {
    return "map cleared arity";
  }
  if (!is_supported_map(result)) {
    return "map cleared type";
  }
  return "";
}

function map_column_error(ins: ssa.SInst, f: Func, result: typeinfo.Type, keys: boolean): string {
  if (ins.args.len() != 1) {
    return "map column arity";
  }
  let m: typeinfo.Type = f.values[ins.args[0]];
  if (!is_supported_map(m)) {
    return "map column type";
  }
  let elem: typeinfo.Type = map_value(m);
  if (keys) {
    elem = map_key(m);
  }
  if (!retained_column(elem)) {
    return "map column element";
  }
  if (!semtypes.equal(typeinfo.TypeArray { elem: elem, view: false }, result)) {
    return "map column result";
  }
  return "";
}

function map_get_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 2) {
    return "map get arity";
  }
  let m: typeinfo.Type = f.values[ins.args[0]];
  if (!is_supported_map(m)) {
    return "map get type";
  }
  if (!semtypes.equal(option_of(map_value(m)), result)) {
    return "map get result";
  }
  return map_operand_error(m, f.values[ins.args[1]], map_value(m));
}

pub function option_of(v: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeUnion { name: "Option", args: [v] };
}

function map_len_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "map len arity";
  }
  if (!is_supported_map(f.values[ins.args[0]])) {
    return "map len type";
  }
  if (!is_i32(result)) {
    return "map len result";
  }
  return "";
}

function map_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "map construction arity";
  }
  if (!is_supported_map(result)) {
    return "map construction type";
  }
  if (!is_i32(f.values[ins.args[0]])) {
    return "map capacity type";
  }
  return "";
}

function map_insert_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 3) {
    return "map insert arity";
  }
  let m: typeinfo.Type = f.values[ins.args[0]];
  if (!is_supported_map(m)) {
    return "map insert type";
  }
  if (!semtypes.equal(m, result)) {
    return "map insert result";
  }
  return map_operand_error(m, f.values[ins.args[1]], f.values[ins.args[2]]);
}

function map_has_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 2) {
    return "map has arity";
  }
  let m: typeinfo.Type = f.values[ins.args[0]];
  if (!is_supported_map(m)) {
    return "map has type";
  }
  if (!is_bool(result)) {
    return "map has result";
  }
  return map_operand_error(m, f.values[ins.args[1]], map_value(m));
}

function map_get_or_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 3) {
    return "map get_or arity";
  }
  let m: typeinfo.Type = f.values[ins.args[0]];
  if (!is_supported_map(m)) {
    return "map get_or type";
  }
  if (!semtypes.equal(map_value(m), result)) {
    return "map get_or result";
  }
  return map_operand_error(m, f.values[ins.args[1]], f.values[ins.args[2]]);
}

function map_operand_error(m: typeinfo.Type, key: typeinfo.Type, value: typeinfo.Type): string {
  if (!semtypes.equal(map_key(m), key) && !(is_view(map_key(m)) && is_string(key))) {
    return "map key type";
  }
  if (!semtypes.equal(map_value(m), value)) {
    return "map value type";
  }
  return "";
}

function is_variant_op(kind: i32): boolean {
  return kind == variant_new() || kind == variant_is() || kind == variant_get()
    || kind == variant_up() || kind == variant_as() || kind == str_as() || kind == array_lend() || kind == dyn_up() || kind == dyn_box()
    || kind == dyn_is() || kind == dyn_as();
}

function needs_guard(kind: i32): boolean {
  return kind == variant_get() || kind == variant_as() || kind == dyn_as();
}

pub struct Binding { ok: boolean, why: string, names: string[], types: typeinfo.Type[] }

pub function unbound(): Binding {
  return Binding { ok: true, why: "", names: [], types: [] };
}

function unbindable(why: string): Binding {
  return Binding { ok: false, why: why, names: [], types: [] };
}

function bound_at(b: Binding, name: string): i32 {
  let i: i32 = 0;
  while (i < b.names.len()) {
    if (b.names[i] == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function bind_type(b: Binding, want: typeinfo.Type, got: typeinfo.Type): Binding {
  if (semtypes.erased(want)) {
    return bind_variable(b, variable_name(want), got);
  }
  if (semtypes.erased(got)) {
    return unbindable("type variable at a concrete parameter");
  }
  return bind_within(b, want, got);
}

function variable_name(t: typeinfo.Type): string {
  if let typeinfo.TypeErased(e) = t {
    return e.name;
  }
  return "";
}

function bind_variable(b: Binding, name: string, got: typeinfo.Type): Binding {
  if (!semtypes.concrete(got, true)) {
    return unbindable("type variable binds no concrete type");
  }
  let at: i32 = bound_at(b, name);
  if (at >= 0) {
    if (!semtypes.equal(b.types[at], got)) {
      return unbindable("erased variable binds two types");
    }
    return b;
  }
  return Binding { ...b, names: b.names.append(name), types: b.types.append(got) };
}

function bind_within(b: Binding, want: typeinfo.Type, got: typeinfo.Type): Binding {
  if let typeinfo.TypeFunc(x) = want {
    if let typeinfo.TypeFunc(y) = got {
      return bind_callable(b, x, y);
    }
    return mismatch();
  }
  if let typeinfo.TypeArray(x) = want {
    if let typeinfo.TypeArray(y) = got {
      return bind_type(b, x.elem, y.elem);
    }
    return mismatch();
  }
  if let typeinfo.TypeTuple(x) = want {
    if let typeinfo.TypeTuple(y) = got {
      return bind_list(b, x.elements, y.elements);
    }
    return mismatch();
  }
  if let typeinfo.TypeMap(x) = want {
    if let typeinfo.TypeMap(y) = got {
      return bind_type(bind_type(b, x.key, y.key), x.value, y.value);
    }
    return mismatch();
  }
  return bind_nominal(b, want, got);
}

function mismatch(): Binding {
  return unbindable("call argument type");
}

function bind_nominal(b: Binding, want: typeinfo.Type, got: typeinfo.Type): Binding {
  if let typeinfo.TypeStruct(x) = want {
    if let typeinfo.TypeStruct(y) = got {
      if (x.name == y.name) {
        return bind_list(b, x.args, y.args);
      }
    }
    return mismatch();
  }
  if let typeinfo.TypeUnion(x) = want {
    if let typeinfo.TypeUnion(y) = got {
      if (x.name == y.name) {
        return bind_list(b, x.args, y.args);
      }
    }
    return mismatch();
  }
  if (!semtypes.equal(want, got)) {
    return mismatch();
  }
  return b;
}

function bind_callable(b: Binding, x: typeinfo.TypeFunc, y: typeinfo.TypeFunc): Binding {
  if (x.params_known != y.params_known || x.param_types.len() != y.param_types.len()) {
    return mismatch();
  }
  let i: i32 = 0;
  while (i < x.param_types.len()) {
    if (typeinfo.fn_own_at(x, i) && typeinfo.ownable(y.param_types[i]) != typeinfo.fn_own_at(y, i)) {
      return mismatch();
    }
    if (!typeinfo.fn_own_at(x, i) && typeinfo.fn_own_at(y, i)) {
      return mismatch();
    }
    b = bind_type(b, x.param_types[i], y.param_types[i]);
    if (!b.ok) {
      return b;
    }
    i = i + 1;
  }
  return bind_type(b, x.ret_type, y.ret_type);
}

function bind_list(b: Binding, want: typeinfo.Type[], got: typeinfo.Type[]): Binding {
  if (want.len() != got.len()) {
    return mismatch();
  }
  let i: i32 = 0;
  while (i < want.len()) {
    b = bind_type(b, want[i], got[i]);
    if (!b.ok) {
      return b;
    }
    i = i + 1;
  }
  return b;
}

pub function substitute(t: typeinfo.Type, b: Binding): typeinfo.Type {
  if (semtypes.erased(t)) {
    let at: i32 = bound_at(b, variable_name(t));
    if (at >= 0) {
      return b.types[at];
    }
    return t;
  }
  if let typeinfo.TypeFunc(fn) = t {
    let params: typeinfo.Type[] = substitute_list(fn.param_types, b);
    return typeinfo.TypeFunc { ...fn, param_types: params, param_own: typeinfo.own_flags(fn.param_own, params), ret_type: substitute(fn.ret_type, b) };
  }
  if let typeinfo.TypeArray(a) = t {
    return typeinfo.TypeArray { elem: substitute(a.elem, b), view: a.view };
  }
  if let typeinfo.TypeTuple(tup) = t {
    return typeinfo.TypeTuple { elements: substitute_list(tup.elements, b) };
  }
  if let typeinfo.TypeMap(m) = t {
    return typeinfo.TypeMap { key: substitute(m.key, b), value: substitute(m.value, b) };
  }
  if let typeinfo.TypeStruct(r) = t {
    return typeinfo.TypeStruct { ...r, args: substitute_list(r.args, b) };
  }
  if let typeinfo.TypeUnion(u) = t {
    return typeinfo.TypeUnion { ...u, args: substitute_list(u.args, b) };
  }
  return t;
}

function substitute_list(ts: typeinfo.Type[], b: Binding): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for t in ts {
    out = out.append(substitute(t, b));
  }
  return out;
}

pub function contract_variables(c: Contract): string[] {
  let out: string[] = [];
  for p in c.params {
    out = variables(p, out);
  }
  return variables(c.result, out);
}

function variables(t: typeinfo.Type, out: string[]): string[] {
  if (semtypes.erased(t)) {
    let name: string = variable_name(t);
    for seen in out {
      if (seen == name) {
        return out;
      }
    }
    return out.append(name);
  }
  if let typeinfo.TypeArray(a) = t {
    return variables(a.elem, out);
  }
  if let typeinfo.TypeTuple(tup) = t {
    return variables_of(tup.elements, out);
  }
  if let typeinfo.TypeFunc(fn) = t {
    return variables(fn.ret_type, variables_of(fn.param_types, out));
  }
  if let typeinfo.TypeMap(m) = t {
    return variables(m.value, variables(m.key, out));
  }
  if let typeinfo.TypeStruct(r) = t {
    return variables_of(r.args, out);
  }
  if let typeinfo.TypeUnion(u) = t {
    return variables_of(u.args, out);
  }
  return out;
}

function variables_of(ts: typeinfo.Type[], out: string[]): string[] {
  for t in ts {
    out = variables(t, out);
  }
  return out;
}

pub function filled(b: Binding, from: Binding): Binding {
  let out: Binding = b;
  let i: i32 = 0;
  while (i < from.names.len()) {
    if (bound_at(out, from.names[i]) < 0) {
      out = Binding { ...out, names: out.names.append(from.names[i]), types: out.types.append(from.types[i]) };
    }
    i = i + 1;
  }
  return out;
}

pub function binds_all(b: Binding, vars: string[]): boolean {
  for v in vars {
    if (bound_at(b, v) < 0) {
      return false;
    }
  }
  return true;
}

pub function instance_name(key: string, b: Binding, vars: string[]): string {
  let out: string = key;
  for v in vars {
    out = out + "$" + type_key(b.types[bound_at(b, v)]);
  }
  return out;
}

pub function instantiate_contract(c: Contract, b: Binding, vars: string[]): Contract {
  let name: string = instance_name(c.name, b, vars);
  let params: typeinfo.Type[] = [];
  let modes: i32[] = [];
  let i: i32 = 0;
  while (i < c.params.len()) {
    let t: typeinfo.Type = substitute(c.params[i], b);
    if (i == 0 && semtypes.is_env(t)) {
      t = env_type(name, semtypes.env_captures(t));
    }
    params = params.append(t);
    if (semtypes.needs_anchor(t)) {
      modes = modes.append(c.modes[i]);
    } else {
      modes = modes.append(value_mode());
    }
    i = i + 1;
  }
  return Contract { name: name, params: params, modes: modes, result: substitute(c.result, b) };
}

pub function type_key(t: typeinfo.Type): string {
  if let typeinfo.TypeUnion(u) = t {
    return key_args(u.name, u.args);
  }
  if let typeinfo.TypeStruct(r) = t {
    return key_args(r.name, r.args);
  }
  if let typeinfo.TypeArray(a) = t {
    if (a.view) {
      return "$view$" + type_key(a.elem);
    }
    return "$arr$" + type_key(a.elem);
  }
  if let typeinfo.TypeTuple(tup) = t {
    return key_args("$tup", tup.elements);
  }
  if let typeinfo.TypeFunc(fn) = t {
    return key_args("$fn", fn.param_types.append(fn.ret_type));
  }
  if let typeinfo.TypeMap(m) = t {
    return key_args("$map", [m.key, m.value]);
  }
  if let typeinfo.TypeDyn(d) = t {
    return "$dyn$" + trait_set_key(d.traits);
  }
  if let typeinfo.TypeHandle(h) = t {
    if (h.borrowed) {
      return "$borrow$" + h.resource;
    }
    return "$own$" + h.resource;
  }
  return leaf_key(t);
}

pub function variant_key(t: typeinfo.Type, name: string): string {
  if let typeinfo.TypeUnion(u) = t {
    if (u.args.len() > 0 && u.name != "Option" && u.name != "Result") {
      return type_key(t) + "$" + name;
    }
  }
  return name;
}

function trait_set_key(traits: string): string {
  let hex: string = "0123456789abcdef";
  let out: string = "";
  let i: i32 = 0;
  while (i < traits.len()) {
    let b: i32 = traits[i] as i32;
    let alnum: boolean = b >= 48 && b <= 57 || b >= 65 && b <= 90 || b >= 97 && b <= 122;
    if (alnum) {
      out = out + slice_unchecked(traits, i, i + 1);
    } else {
      out = out + "_" + slice_unchecked(hex, b / 16, b / 16 + 1) + slice_unchecked(hex, b % 16, b % 16 + 1);
    }
    i = i + 1;
  }
  return out;
}

function key_args(name: string, args: typeinfo.Type[]): string {
  let out: string = name;
  for a in args {
    out = out + "$" + type_key(a);
  }
  return out;
}

function leaf_key(t: typeinfo.Type): string {
  if (semtypes.is_never(t)) {
    return "$never";
  }
  if let typeinfo.TypeLanes(l) = t {
    return typeinfo.lanes_spelling(l.width);
  }
  if (is_void(t)) {
    return "void";
  }
  if (is_view(t)) {
    return "str";
  }
  if (is_string(t)) {
    return "string";
  }
  if (is_i64(t)) {
    return "i64";
  }
  if (is_u64(t)) {
    return "u64";
  }
  if (is_u8(t)) {
    return "u8";
  }
  if (is_u32(t)) {
    return "u32";
  }
  if (is_usize(t)) {
    return "usize";
  }
  if (is_f64(t)) {
    return "f64";
  }
  if (is_f32(t)) {
    return "f32";
  }
  if (is_char(t)) {
    return "char";
  }
  if (is_integer(t)) {
    return "i32";
  }
  return "bool";
}

function call_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  let at: i32 = find_contract_in(f.calls, ins.str);
  if (at < 0) {
    return "missing call contract";
  }
  let c: Contract = f.calls[at];
  if (ins.args.len() != c.params.len()) {
    return "call arity";
  }
  if (is_dyn_call(ins.str) && (c.params.len() == 0 || !is_dyn(c.params[0]))) {
    return "dyn call receiver type";
  }
  let i: i32 = 0;
  while (i < ins.args.len()) {
    if (!semtypes.equal(c.params[i], f.values[ins.args[i]])) {
      return "call argument type";
    }
    i = i + 1;
  }
  if (!semtypes.equal(c.result, result)) {
    return "call result type";
  }
  if (!call_capture_valid(f, ins)) {
    return "call immediate";
  }
  return "";
}

function call_capture_valid(f: Func, ins: ssa.SInst): boolean {
  if (ins.imm >= 0) {
    return ins.imm == 0 || ins.imm <= f.values.len() && is_usize(f.values[ins.imm - 1]);
  }
  if (ins.imm == 0 - 2147483647 - 1 || !is_wide(f.values[ins.result])) {
    return false;
  }
  let base: i32 = scalar_capture_base(ins.imm);
  let count: i32 = scalar_capture_count(ins.imm);
  if (base < 0 || base > f.values.len() - count) {
    return false;
  }
  let i: i32 = 0;
  while (i < count) {
    if (!is_wide(f.values[base + i]) || !is_unsigned_int(f.values[base + i])) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function scalar_capture_base(imm: i32): i32 {
  return (0 - imm) / 4;
}

pub function scalar_capture_count(imm: i32): i32 {
  return (0 - imm) % 4;
}

function integer_op(op: string): boolean {
  if (op == "+" || op == "-" || op == "*") {
    return true;
  }
  if (op == "/" || op == "%") {
    return true;
  }
  if (op == "&" || op == "|" || op == "^") {
    return true;
  }
  return op == "<<" || op == ">>";
}

function comparison(op: string): boolean {
  return op == "<" || op == "<=" || op == ">" || op == ">=" || op == "==" || op == "!=";
}

function float_op(op: string): boolean {
  return op == "+" || op == "-" || op == "*" || op == "/";
}

pub function binary_result(op: string, left: typeinfo.Type, right: typeinfo.Type): typeinfo.Type {
  if (is_usize(left) && semtypes.equal(left, right)) {
    return address_result(op, left);
  }
  if (is_integer(left) && semtypes.equal(left, right)) {
    return integer_result(op, left);
  }
  if (is_float(left) && semtypes.equal(left, right)) {
    return float_result(op, left);
  }
  if (is_lanes(left) && semtypes.equal(left, right)) {
    return lanes_result(op, left);
  }
  if (is_bool(left) && is_bool(right) && (op == "==" || op == "!=")) {
    return typeinfo.TypeBool { tag: 0 };
  }
  if (is_char(left) && is_char(right) && comparison(op)) {
    return typeinfo.TypeBool { tag: 0 };
  }
  if (is_text(left) && is_text(right)) {
    return string_result(op);
  }
  return typeinfo.unchecked();
}

function address_result(op: string, t: typeinfo.Type): typeinfo.Type {
  if (saturating(op) || checked_arith(op)) {
    return typeinfo.unchecked();
  }
  return integer_result(op, t);
}

pub function saturating(op: string): boolean {
  return op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

pub function checked_arith(op: string): boolean {
  return op == "+?" || op == "-?" || op == "*?" || op == "/?" || op == "%?" || op == "<<?" || op == ">>?";
}

function integer_result(op: string, t: typeinfo.Type): typeinfo.Type {
  if (integer_op(op) || saturating(op)) {
    return t;
  }
  if (checked_arith(op)) {
    return typeinfo.TypeUnion { name: "Option", args: [t] };
  }
  if (comparison(op)) {
    return typeinfo.TypeBool { tag: 0 };
  }
  return typeinfo.unchecked();
}

function float_result(op: string, t: typeinfo.Type): typeinfo.Type {
  if (float_op(op)) {
    return t;
  }
  if (comparison(op)) {
    return typeinfo.TypeBool { tag: 0 };
  }
  return typeinfo.unchecked();
}

function string_result(op: string): typeinfo.Type {
  if (op == "+") {
    return typeinfo.TypeString { tag: 0 };
  }
  if (comparison(op)) {
    return typeinfo.TypeBool { tag: 0 };
  }
  return typeinfo.unchecked();
}

function lanes_result(op: string, t: typeinfo.Type): typeinfo.Type {
  if (util.has_str(["+", "-", "*", "/"], op)) {
    return t;
  }
  return typeinfo.unchecked();
}

pub function unary_result(op: string, operand: typeinfo.Type): typeinfo.Type {
  if (op == "-" && (is_i32(operand) || is_i64(operand) || is_float(operand) || is_lanes(operand))) {
    return operand;
  }
  if (op == "!" && is_bool(operand)) {
    return typeinfo.TypeBool { tag: 0 };
  }
  return typeinfo.unchecked();
}

function binary_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 2) {
    return "binary operator arity";
  }
  let want: typeinfo.Type = binary_result(ins.str, f.values[ins.args[0]], f.values[ins.args[1]]);
  if (!semtypes.concrete(want, false) || !semtypes.equal(want, result)) {
    return "binary operator contract";
  }
  return "";
}

function converts_as_integer(t: typeinfo.Type): boolean {
  return is_integer(t) || is_char(t);
}

function reinterprets(from: typeinfo.Type, to: typeinfo.Type): boolean {
  return is_usize(from) && reference(to) || reference(from) && is_usize(to);
}

pub function cast_ascribes(to: typeinfo.Type): boolean {
  return !converts_as_integer(to) && !is_float(to);
}

pub function lends_handle(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if let typeinfo.TypeHandle(fh) = from {
    if let typeinfo.TypeHandle(th) = to {
      return th.borrowed && !fh.borrowed && th.resource == fh.resource;
    }
  }
  return false;
}

pub function cast_admits(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if (reinterprets(from, to)) {
    return true;
  }
  if (semtypes.is_fd_handle(from) && is_i32(to)) {
    return true;
  }
  if (lends_handle(from, to)) {
    return true;
  }
  if (is_usize(from)) {
    return converts_as_integer(to) || is_float(to);
  }
  if (is_usize(to)) {
    return converts_as_integer(from) || is_float(from);
  }
  if (converts_as_integer(from) && converts_as_integer(to)) {
    return true;
  }
  if (is_float(from) && is_float(to)) {
    return true;
  }
  if (is_float(to)) {
    return is_integer(from);
  }
  if (is_float(from)) {
    return is_integer(to);
  }
  return false;
}

function cast_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "cast arity";
  }
  if (!converts_as_integer(result) && !is_float(result) && !reference(result) && !semtypes.is_resource_handle(result)) {
    return "cast result type";
  }
  if (!cast_admits(f.values[ins.args[0]], result)) {
    return "cast operand type";
  }
  return "";
}

function unary_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.args.len() != 1) {
    return "unary operator arity";
  }
  let want: typeinfo.Type = unary_result(ins.str, f.values[ins.args[0]]);
  if (!semtypes.concrete(want, false) || !semtypes.equal(want, result)) {
    return "unary operator contract";
  }
  return "";
}

pub function scalar_op(kind: i32): boolean {
  return kind == 9 || kind == 10 || kind == cast();
}

function scalar_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.kind_tag == 9) {
    return binary_error(ins, f, result);
  }
  if (ins.kind_tag == 10) {
    return unary_error(ins, f, result);
  }
  return cast_error(ins, f, result);
}

function is_aggregate_op(kind: i32): boolean {
  return kind == array_new() || kind == bytes_new() || kind == array_reserve() || kind == tuple_new() || kind == array_get()
    || kind == tuple_get() || kind == record_new() || kind == record_get();
}

function aggregate_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  let kind: i32 = ins.kind_tag;
  if (kind == bytes_new()) {
    return bytes_construction_error(ins, result);
  }
  if (kind == array_reserve()) {
    return array_reserve_error(ins, f, result);
  }
  if (kind == array_new()) {
    return array_construction_error(ins, f, result);
  }
  if (kind == tuple_new()) {
    return tuple_construction_error(ins, f, result);
  }
  if (kind == array_get()) {
    return array_projection_error(ins, f, result);
  }
  if (kind == tuple_get()) {
    return tuple_projection_error(ins, f, result);
  }
  if (kind == record_new()) {
    return record_construction_error(ins, f, result);
  }
  return record_projection_error(ins, f, result);
}

function composite_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  let kind: i32 = ins.kind_tag;
  if (kind == zero()) {
    return zero_error(ins, result);
  }
  if (is_aggregate_op(kind)) {
    return aggregate_error(ins, f, result);
  }
  if (kind == call()) {
    return call_error(ins, f, result);
  }
  if (is_function_op(kind)) {
    return function_error(ins, f, result);
  }
  if (is_builtin_op(kind)) {
    return builtin_error(ins, f, result);
  }
  if (is_variant_op(kind)) {
    return variant_error(ins, f, result);
  }
  if (is_hole_op(kind)) {
    return hole_error(ins, f, result);
  }
  return "unsupported semantic operation";
}

function hole_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
  if (ins.kind_tag == hole_at()) {
    if (ins.args.len() != 1) {
      return "hole address arity";
    }
    if (!is_usize(result) || !record_laid(f, f.values[ins.args[0]])) {
      return "hole address type";
    }
    return "";
  }
  if (ins.args.len() != 3) {
    return "hole fill arity";
  }
  if (!record_laid(f, result) || !is_usize(f.values[ins.args[1]])) {
    return "hole fill type";
  }
  if (!semtypes.equal(f.values[ins.args[0]], result) || !semtypes.equal(f.values[ins.args[2]], result)) {
    return "hole fill type";
  }
  if (!holds_own_type(f, result, ins.imm)) {
    return "hole fill index";
  }
  return "";
}

function record_laid(f: Func, t: typeinfo.Type): boolean {
  let at: i32 = semrecords.find_enum(f.enums, t);
  return at >= 0 && f.enums[at].layout == semrecords.layout_variant();
}

function holds_own_type(f: Func, t: typeinfo.Type, index: i32): boolean {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0 || index < 0) {
    return false;
  }
  for v in f.enums[at].variants {
    if (index < v.fields.len() && semtypes.equal(v.fields[index].ty, t)) {
      return true;
    }
  }
  return false;
}

function zero_error(ins: ssa.SInst, result: typeinfo.Type): string {
  if (ins.args.len() != 0) {
    return "zero arity";
  }
  if (!semtypes.concrete(result, false)) {
    return "zero type";
  }
  return "";
}

function instruction_error(ins: ssa.SInst, f: Func): string {
  if (ins.result < 0) {
    return "semantic operation needs a result";
  }
  let result: typeinfo.Type = f.values[ins.result];
  let kind: i32 = ins.kind_tag;
  if (kind == 6) {
    return parameter_error(ins, f, result);
  }
  if (kind == 7 || kind == 8) {
    return copy_error(ins, f, result);
  }
  if (kind == 1 || kind == 2 || kind == 5) {
    return constant_error(ins, result);
  }
  if (scalar_op(kind)) {
    return scalar_error(ins, f, result);
  }
  if (kind == 35) {
    return line_error(ins, result);
  }
  return composite_error(ins, f, result);
}

function line_error(ins: ssa.SInst, result: typeinfo.Type): string {
  if (ins.args.len() != 0) {
    return "line mark arity";
  }
  if (!is_void(result)) {
    return "line mark type";
  }
  return "";
}

function func_shape_error(fn: typeinfo.TypeFunc): string {
  if (!fn.params_known) {
    return "function type without a signature";
  }
  for p in fn.param_types {
    if (!is_void(p) && !signature_slot(p)) {
      return "function signature slot";
    }
  }
  if (!is_void(fn.ret_type) && !signature_slot(fn.ret_type)) {
    return "function signature slot";
  }
  return "";
}

function signature_slot(t: typeinfo.Type): boolean {
  if let typeinfo.TypeFunc(inner) = t {
    return func_shape_error(inner) == "";
  }
  if (nests_func(t)) {
    return false;
  }
  return semtypes.concrete(t, false);
}

pub function nests_func(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return nests_func(a.elem);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      if (nests_func(e)) {
        return true;
      }
    }
  }
  if let typeinfo.TypeMap(m) = t {
    return holds_func(m.key) || nests_func(m.value);
  }
  return false;
}

function holds_func(t: typeinfo.Type): boolean {
  return is_func(t) || nests_func(t);
}

function type_placement_error(t: typeinfo.Type): string {
  if let typeinfo.TypeFunc(fn) = t {
    return func_shape_error(fn);
  }
  if (nests_func(t)) {
    return "function value is not an element";
  }
  return "";
}

function field_placement_error(f: Func): string {
  for record in f.records.list {
    if (record.nests_func) {
      return "function value is not a field";
    }
  }
  for e in f.enums {
    if (e.nests_func) {
      return "function value is not a field";
    }
  }
  return "";
}

function placement_error(f: Func): string {
  let named: typeinfo.Type[] = f.values.append(f.result);
  for c in f.calls {
    for t in c.params {
      named = named.append(t);
    }
    named = named.append(c.result);
  }
  for t in named {
    let why: string = type_placement_error(t);
    if (why != "") {
      return why;
    }
  }
  return field_placement_error(f);
}

function dimension_error(f: Func): string {
  if (f.graph.nvals < 0 || f.values.len() != f.graph.nvals || f.params.len() != f.graph.nparams) {
    return "semantic type dimensions";
  }
  if (f.graph.takes_env) {
    return "closure contract not available";
  }
  return "";
}

function schema_error(f: Func): string {
  let why: string = dimension_error(f);
  if (why != "") {
    return why;
  }
  why = ssadeps.limits_error(f.graph);
  if (why != "") {
    return why;
  }
  if (util.verify_on()) {
    why = ssadeps.verify(f.graph, empty_dependencies(f.graph.nvals));
    if (why != "") {
      return why;
    }
  }
  if (!semtypes.concrete(f.result, true)) {
    return "unresolved result type";
  }
  for t in f.values {
    if (!semtypes.concrete(t, true)) {
      return "unresolved value type";
    }
  }
  for t in f.params {
    if (!semtypes.concrete(t, true)) {
      return "unresolved parameter type";
    }
  }
  why = contracts_error(f.calls);
  if (why != "") {
    return why;
  }
  why = placement_error(f);
  if (why != "") {
    return why;
  }
  if (!util.verify_on()) {
    return "";
  }
  return semrecords.verify(f.records, f.enums);
}

function contracts_error(calls: Contract[]): string {
  let i: i32 = 0;
  while (i < calls.len()) {
    let c: Contract = calls[i];
    if (c.name == "") {
      return "empty call contract name";
    }
    if (find_contract_in(calls, c.name) != i) {
      return "duplicate call contract";
    }
    if (c.modes.len() != c.params.len()) {
      return "call contract mode dimensions";
    }
    for t in c.params {
      if (!semtypes.concrete(t, true)) {
        return "unresolved call parameter type";
      }
    }
    if (!semtypes.concrete(c.result, true)) {
      return "unresolved call result type";
    }
    i = i + 1;
  }
  return "";
}

function terminator_error(b: ssa.SBlock, f: Func): string {
  if (b.term.kind_tag == 1) {
    if (b.term.value < 0) {
      if (!is_void(f.result)) {
        return "missing return value";
      }
    } else if (!semtypes.equal(f.result, f.values[b.term.value])) {
      return "return type";
    }
  }
  if (b.term.kind_tag == 3 && !is_bool(f.values[b.term.cond])) {
    return "condition type";
  }
  return "";
}

function operations_error(f: Func): string {
  let seen_params: i32 = 0;
  for b in f.graph.blocks {
    for ins in b.insts {
      let why: string = instruction_error(ins, f);
      if (why != "") {
        return why;
      }
      if (ins.kind_tag == 6) {
        seen_params = seen_params + 1;
      }
    }
    let why: string = terminator_error(b, f);
    if (why != "") {
      return why;
    }
  }
  if (seen_params != f.params.len()) {
    return "missing parameter definition";
  }
  return guard_error(f);
}

struct ViewSources { params: i32[], escapes: boolean, pending: boolean, seen: boolean[], escape_kind: i32 }

function view_sources(f: Func, defs: ssa.SInst[], anchors: Anchor[], names: string[], v: i32, kind: i32, acc: ViewSources): ViewSources {
  if (v < 0 || v >= defs.len() || acc.escapes || acc.seen[v]) {
    return acc;
  }
  let out: ViewSources = ViewSources { ...acc, seen: acc.seen.with(v, true) };
  if (kind == 0) {
    if let typeinfo.TypeArray(a) = f.values[v] {
      if (a.view) {
        kind = 1;
      }
    }
    if (is_view(f.values[v])) {
      kind = 2;
    }
  }
  let d: ssa.SInst = defs[v];
  if (d.kind_tag == 6) {
    if (util.index_of_i32(out.params, d.imm) < 0) {
      out = ViewSources { ...out, params: out.params.append(d.imm) };
    }
    return out;
  }
  if (d.kind_tag == 5) {
    return out;
  }
  if (d.kind_tag == dyn_up() && d.args.len() == 1 && !holds_view(f, f.values[d.args[0]])) {
    return out;
  }
  if (d.kind_tag == 8) {
    for a in d.args {
      out = view_sources(f, defs, anchors, names, a, kind, out);
    }
    return out;
  }
  if (d.kind_tag != 8 && gathers_views(d.kind_tag)) {
    if (!holds_view(f, f.values[v])) {
      return ViewSources { ...out, escapes: true, escape_kind: kind };
    }
    for a in d.args {
      if (a >= 0 && holds_view(f, f.values[a])) {
        out = view_sources(f, defs, anchors, names, a, kind, out);
      }
    }
    return out;
  }
  if (projects(d.kind_tag)) {
    return view_sources(f, defs, anchors, names, d.args[0], kind, out);
  }
  let read: i32[] = map_read_sources(d);
  if (read.len() > 0) {
    for a in read {
      out = view_sources(f, defs, anchors, names, a, kind, out);
    }
    return out;
  }
  if (d.kind_tag == call()) {
    if (!anchored(anchors, d.str)) {
      if (holds_view(f, f.values[v]) && util.index_of_str(names, d.str) >= 0) {
        return ViewSources { ...out, pending: true };
      }
      return ViewSources { ...out, escapes: true, escape_kind: kind };
    }
    for k in anchor_params(anchors, d.str) {
      if (k < d.args.len()) {
        out = view_sources(f, defs, anchors, names, d.args[k], kind, out);
      }
    }
    return out;
  }
  return ViewSources { ...out, escapes: true, escape_kind: kind };
}

pub struct ResultAnchor { escapes: boolean, pending: boolean, params: i32[], escape_kind: i32 }

pub function result_anchor(f: Func, anchors: Anchor[], names: string[]): ResultAnchor {
  let defs: ssa.SInst[] = definitions(f);
  let seen: boolean[] = __alloc_bool(defs.len());
  let acc: ViewSources = ViewSources { params: [], escapes: false, pending: false, seen: seen, escape_kind: 0 };
  for b in f.graph.blocks {
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      acc = view_sources(f, defs, anchors, names, b.term.value, 0, acc);
    }
  }
  return ResultAnchor { escapes: acc.escapes, pending: !acc.escapes && acc.pending, params: acc.params, escape_kind: acc.escape_kind };
}

function definitions(f: Func): ssa.SInst[] {
  let none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
  let out: ssa.SInst[] = [];
  let i: i32 = 0;
  while (i < f.values.len()) {
    out = out.append(none);
    i = i + 1;
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result >= 0 && ins.result < out.len()) {
        out = out.with(ins.result, ins);
      }
    }
  }
  return out;
}

function sole_successor(f: Func, at: i32[], target: i32, from: i32): i32 {
  if (target < 0 || target >= at.len() || at[target] < 0) {
    return 0 - 1;
  }
  let i: i32 = at[target];
  let succ: ssa.SBlock = f.graph.blocks[i];
  if (succ.preds.len() != 1 || succ.preds[0] != from) {
    return 0 - 1;
  }
  return i;
}

struct Known { held: string[], gone: string[] }

function settled(f: Func, value: i32, bi: i32, g: Guards): Known {
  let held: string[] = [];
  let gone: string[] = [];
  for pi in g.tests {
    let b: ssa.SBlock = f.graph.blocks[pi];
    let test: ssa.SInst = g.defs[b.term.cond];
    if (test.args[0] == value || twin_of(g, test.args[0]) == twin_of(g, value)) {
      let ti: i32 = sole_successor(f, g.at, b.term.t, b.id);
      if (ti >= 0 && ssadeps.dom_holds(g.dom, bi, ti)) {
        held = held.append(test.str);
      }
      let fi: i32 = sole_successor(f, g.at, b.term.f, b.id);
      if (fi >= 0 && ssadeps.dom_holds(g.dom, bi, fi)) {
        gone = gone.append(test.str);
      }
    }
  }
  return Known { held: held, gone: gone };
}

function settled_ways(f: Func, value: i32, g: Guards): Known[] {
  let n: i32 = f.graph.blocks.len();
  let known: Known[] = [];
  let seen: boolean[] = __alloc_bool(n);
  let i: i32 = 0;
  while (i < n) {
    known = known.append(Known { held: [], gone: [] });
    i = i + 1;
  }
  let entry: i32 = g.at[f.graph.entry];
  seen = seen.with(entry, true);
  let changed: boolean = true;
  while (changed) {
    changed = false;
    i = 0;
    while (i < n) {
      let m: Met = met_at(f, value, g, known, seen, i);
      if (i != entry && m.any && (!seen[i] || !same_known(m.known, known[i]))) {
        known = known.with(i, m.known);
        seen = seen.with(i, true);
        changed = true;
      }
      i = i + 1;
    }
  }
  return known;
}

struct Met { any: boolean, known: Known }

function met_at(f: Func, value: i32, g: Guards, known: Known[], seen: boolean[], i: i32): Met {
  let met: Met = Met { any: false, known: Known { held: [], gone: [] } };
  for p in f.graph.blocks[i].preds {
    let pi: i32 = 0 - 1;
    if (p >= 0 && p < g.at.len()) {
      pi = g.at[p];
    }
    if (pi >= 0 && seen[pi]) {
      let out: Known = edge_known(f, value, g, pi, known[pi], f.graph.blocks[i].id);
      if (met.any) {
        met = Met { any: true, known: Known { held: common(met.known.held, out.held), gone: common(met.known.gone, out.gone) } };
      } else {
        met = Met { any: true, known: out };
      }
    }
  }
  return met;
}

function edge_known(f: Func, value: i32, g: Guards, pi: i32, known: Known, target: i32): Known {
  let term: ssa.STerm = f.graph.blocks[pi].term;
  let test: i32 = value_test(g, term, value);
  if (test < 0) {
    return known;
  }
  let name: string = g.defs[test].str;
  if (target == term.t && !names_has(known.held, name)) {
    return Known { ...known, held: known.held.append(name) };
  }
  if (target == term.f && !names_has(known.gone, name)) {
    return Known { ...known, gone: known.gone.append(name) };
  }
  return known;
}

function value_test(g: Guards, term: ssa.STerm, value: i32): i32 {
  if (term.kind_tag != 3 || term.t == term.f || term.cond < 0 || term.cond >= g.defs.len()) {
    return 0 - 1;
  }
  let test: ssa.SInst = g.defs[term.cond];
  if (test.kind_tag != variant_is() && test.kind_tag != dyn_is()) {
    return 0 - 1;
  }
  if (test.args[0] != value && twin_of(g, test.args[0]) != twin_of(g, value)) {
    return 0 - 1;
  }
  return term.cond;
}

function common(a: string[], b: string[]): string[] {
  let out: string[] = [];
  for n in a {
    if (names_has(b, n)) {
      out = out.append(n);
    }
  }
  return out;
}

function same_known(a: Known, b: Known): boolean {
  return a.held.len() == b.held.len() && a.gone.len() == b.gone.len() && common(a.held, b.held).len() == a.held.len()
    && common(a.gone, b.gone).len() == a.gone.len();
}

struct Guards { dom: ssadeps.Dom, at: i32[], defs: ssa.SInst[], tests: i32[], same: i32[] }

function twins(defs: ssa.SInst[]): i32[] {
  let t: Twins = Twins { same: [], kids: [] };
  let v: i32 = 0;
  while (v < defs.len()) {
    t = Twins { same: t.same.append(0 - 1), kids: t.kids.append([]) };
    v = v + 1;
  }
  v = 0;
  while (v < defs.len()) {
    t = twin_into(defs, t, v);
    v = v + 1;
  }
  return t.same;
}

struct Twins { same: i32[], kids: i32[][] }

function twin_into(defs: ssa.SInst[], own t: Twins, v: i32): Twins {
  if (t.same[v] >= 0) {
    return t;
  }
  let d: ssa.SInst = defs[v];
  if (d.result != v || twin_arity(d.kind_tag) == 0 || d.args.len() != twin_arity(d.kind_tag) || d.args[0] < 0 || d.args[0] >= defs.len()) {
    return Twins { ...t, same: t.same.with(v, v) };
  }
  t = twin_into(defs, t, d.args[0]);
  let p: i32 = t.same[d.args[0]];
  for k in t.kids[p] {
    if (defs[k].kind_tag == d.kind_tag && defs[k].imm == d.imm && defs[k].str == d.str && (d.args.len() == 1 || defs[k].args[1] == d.args[1])) {
      return Twins { ...t, same: t.same.with(v, k) };
    }
  }
  return Twins { same: t.same.with(v, v), kids: t.kids.with(p, t.kids[p].append(v)) };
}

function twin_arity(kind: i32): i32 {
  if (kind == variant_get() || kind == record_get() || kind == tuple_get()) {
    return 1;
  }
  if (kind == array_get()) {
    return 2;
  }
  return 0;
}

function twin_of(g: Guards, v: i32): i32 {
  if (v >= 0 && v < g.same.len()) {
    return g.same[v];
  }
  return v;
}

function guards_of(f: Func): Guards {
  let defs: ssa.SInst[] = definitions(f);
  let tests: i32[] = [];
  let pi: i32 = 0;
  while (pi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[pi];
    if (b.term.kind_tag == 3 && b.term.t != b.term.f && b.term.cond >= 0 && b.term.cond < defs.len()) {
      let k: i32 = defs[b.term.cond].kind_tag;
      if (k == variant_is() || k == dyn_is()) {
        tests = tests.append(pi);
      }
    }
    pi = pi + 1;
  }
  return Guards { dom: ssadeps.dominates(f.graph), at: ssadeps.position_of(f.graph), defs: defs, tests: tests, same: twins(defs) };
}

function has_guarded_projection(f: Func): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (needs_guard(ins.kind_tag)) {
        return true;
      }
    }
  }
  return false;
}

function names_has(names: string[], name: string): boolean {
  for n in names {
    if (n == name) {
      return true;
    }
  }
  return false;
}

function guarded(f: Func, ins: ssa.SInst, bi: i32, g: Guards): boolean {
  if (guarded_by(f, ins, settled(f, ins.args[0], bi, g))) {
    return true;
  }
  return guarded_by(f, ins, settled_ways(f, ins.args[0], g)[bi]);
}

function guarded_by(f: Func, ins: ssa.SInst, known: Known): boolean {
  let value: i32 = ins.args[0];
  if (settled_viewless(ins)) {
    for c in dyn_view_concretes(f, f.values[value]) {
      if (!names_has(known.gone, shape_name(f, c))) {
        return false;
      }
    }
    return true;
  }
  if (names_has(known.held, ins.str)) {
    return true;
  }
  let at: i32 = semrecords.find_enum(f.enums, f.values[value]);
  if (at < 0) {
    return false;
  }
  for v in f.enums[at].variants {
    if (semrecords.inhabited(v) && v.name != ins.str && !names_has(known.gone, v.name)) {
      return false;
    }
  }
  return true;
}

function guard_error(f: Func): string {
  if (!has_guarded_projection(f)) {
    return "";
  }
  let reachable: boolean[] = ssadeps.reachable_blocks(f.graph);
  let g: Guards = guards_of(f);
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    if (reachable[bi]) {
      for ins in f.graph.blocks[bi].insts {
        if (needs_guard(ins.kind_tag) && !guarded(f, ins, bi, g)) {
          return "unguarded variant projection";
        }
      }
    }
    bi = bi + 1;
  }
  return "";
}

function projects(kind: i32): boolean {
  return kind == 7 || kind == array_get() || kind == tuple_get() || kind == record_get()
    || kind == variant_get() || kind == variant_up() || kind == variant_as()
    || kind == slice() || kind == arr_slice() || kind == str_as() || kind == array_lend() || kind == str_byte_view() || kind == dyn_up() || kind == dyn_as();
}

function borrows_storage(ins: ssa.SInst, f: Func): boolean {
  if (ins.kind_tag != cast()) {
    return false;
  }
  return reference(f.values[ins.args[0]]) && is_usize(f.values[ins.result]);
}

function bytes_roots(f: Func, defs: ssa.SInst[], v: i32, seen: boolean[]): i32[] {
  if (v < 0 || v >= defs.len() || seen[v]) {
    return [];
  }
  let d: ssa.SInst = defs[v];
  let next: boolean[] = seen.with(v, true);
  if (d.kind_tag == str_as() && d.args.len() == 1) {
    return bytes_roots(f, defs, d.args[0], next);
  }
  if (!holds_view(f, f.values[v])) {
    return [v];
  }
  if (d.kind_tag == 5 || settled_viewless(d) || d.kind_tag == dyn_up() && d.args.len() == 1 && !holds_view(f, f.values[d.args[0]])) {
    return [];
  }
  if (projects(d.kind_tag) && d.args.len() > 0) {
    return bytes_roots(f, defs, d.args[0], next);
  }
  let read: i32[] = map_read_sources(d);
  if (read.len() > 0) {
    let from: i32[] = [];
    for a in read {
      from = union_into(from, bytes_roots(f, defs, a, next));
    }
    return from;
  }
  if (d.kind_tag == call()) {
    if (!anchored(f.anchors, d.str)) {
      return [v];
    }
    let called: i32[] = [];
    for k in anchor_params(f.anchors, d.str) {
      if (k < d.args.len()) {
        called = union_into(called, bytes_roots(f, defs, d.args[k], next));
      }
    }
    return called;
  }
  if (!gathers_views(d.kind_tag)) {
    return [v];
  }
  let roots: i32[] = [];
  for a in d.args {
    if (a < 0 || d.kind_tag != 8 && !holds_view(f, f.values[a])) {
      continue;
    }
    if (counted_view(f, defs, a, next)) {
      continue;
    }
    roots = union_into(roots, bytes_roots(f, defs, a, next));
  }
  return roots;
}

function map_read_sources(d: ssa.SInst): i32[] {
  if (d.kind_tag == map_get_or() && d.args.len() == 3) {
    return [d.args[0], d.args[2]];
  }
  if ((d.kind_tag == map_get() || d.kind_tag == map_values()) && d.args.len() > 0) {
    return [d.args[0]];
  }
  return [];
}

function settled_viewless(d: ssa.SInst): boolean {
  return d.kind_tag == dyn_as() && d.str == "";
}

function union_into(own out: i32[], more: i32[]): i32[] {
  for m in more {
    if (util.index_of_i32(out, m) < 0) {
      out = out.append(m);
    }
  }
  return out;
}

function counted_view(f: Func, defs: ssa.SInst[], v: i32, seen: boolean[]): boolean {
  if (v < 0 || v >= defs.len() || seen[v]) {
    return true;
  }
  let d: ssa.SInst = defs[v];
  if (d.kind_tag == 5) {
    return true;
  }
  if (d.kind_tag == str_as() && d.args.len() == 1) {
    return !is_view(f.values[d.args[0]]);
  }
  if (d.kind_tag != 8) {
    return false;
  }
  let next: boolean[] = seen.with(v, true);
  for a in d.args {
    if (!counted_view(f, defs, a, next)) {
      return false;
    }
  }
  return true;
}

function gathers_views(kind: i32): boolean {
  return kind == 8 || kind == tuple_new() || kind == record_new() || kind == variant_new() || kind == array_new()
    || kind == append() || kind == with() || kind == map_new() || kind == map_insert() || kind == dyn_box();
}

function view_roots(f: Func, parents: i32[][]): i32[][] {
  let defs: ssa.SInst[] = definitions(f);
  let none: boolean[] = __alloc_bool(f.graph.nvals);
  let out: i32[][] = parents;
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.result < 0 || !gathers_views(ins.kind_tag) || !holds_view(f, f.values[ins.result])) {
        continue;
      }
      let roots: i32[] = [];
      for r in bytes_roots(f, defs, ins.result, none) {
        if (r != ins.result) {
          roots = roots.append(r);
        }
      }
      if (roots.len() > 0) {
        out = out.with(ins.result, roots);
      }
    }
  }
  return out;
}

function borrow_parents(f: Func): i32[][] {
  let parents: i32[][] = [];
  let i: i32 = 0;
  while (i < f.graph.nvals) {
    parents = parents.append([]);
    i = i + 1;
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      let anchors: boolean = projects(ins.kind_tag) && semtypes.needs_anchor(f.values[ins.result]);
      if (anchors || borrows_storage(ins, f)) {
        parents = parents.with(ins.result, [ins.args[0]]);
      }
      let read: i32[] = map_read_sources(ins);
      if (read.len() > 0 && holds_view(f, f.values[ins.result])) {
        parents = parents.with(ins.result, read);
      }
      if (ins.kind_tag == call() && anchored(f.anchors, ins.str)) {
        let args: i32[] = [];
        for k in anchor_params(f.anchors, ins.str) {
          if (k < ins.args.len() && util.index_of_i32(args, ins.args[k]) < 0) {
            args = args.append(ins.args[k]);
          }
        }
        if (args.len() > 0) {
          parents = parents.with(ins.result, args);
        }
      }
    }
  }
  return view_roots(f, parents);
}

struct Closure { ok: boolean, dependencies: i32[][] }

function closure(parents: i32[][]): Closure {
  let n: i32 = parents.len();
  let derived: i32[][] = [];
  let state: i32[] = __alloc_i32(n);
  let i: i32 = 0;
  while (i < n) {
    derived = derived.append([]);
    i = i + 1;
  }
  let v: i32 = 0;
  while (v < n) {
    if (state[v] == 0) {
      let stack: i32[] = [v];
      let top: i32 = 1;
      state = state.with(v, 1);
      while (top > 0) {
        let x: i32 = stack[top - 1];
        let next: i32 = 0 - 1;
        for p in parents[x] {
          if (p < 0 || p >= n || state[p] == 1) {
            return Closure { ok: false, dependencies: [] };
          }
          if (state[p] == 0) {
            next = p;
            break;
          }
        }
        if (next >= 0) {
          state = state.with(next, 1);
          if (top < stack.len()) {
            stack = stack.with(top, next);
          } else {
            stack = stack.append(next);
          }
          top = top + 1;
          continue;
        }
        derived = derived.with(x, chain_of(parents[x], derived));
        state = state.with(x, 2);
        top = top - 1;
      }
    }
    v = v + 1;
  }
  return Closure { ok: true, dependencies: derived };
}

function chain_of(ps: i32[], derived: i32[][]): i32[] {
  let out: i32[] = [];
  if (ps.len() == 1) {
    out = out.append(ps[0]);
    for d in derived[ps[0]] {
      out = out.append(d);
    }
    return out;
  }
  for p in ps {
    if (util.index_of_i32(out, p) < 0) {
      out = out.append(p);
    }
    out = union_into(out, derived[p]);
  }
  return out;
}

function analyze_parents(f: Func, parents: i32[][]): Analysis {
  let c: Closure = closure(parents);
  if (!c.ok) {
    return failed("cyclic semantic projection");
  }
  let flow: ssalive.Flow = ssadeps.analyze(f.graph, c.dependencies);
  if (!flow.ok) {
    return failed(flow.why);
  }
  return Analysis { ok: true, why: "", parents: parents, dependencies: c.dependencies, flow: flow, uses: uses_of(f), anchored: anchored_of(c.dependencies, f.graph.nvals) };
}

pub function called_names(f: Func): string[] {
  let out: string[] = [];
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == call() && ins.str != "" && !name_seen(out, ins.str)) {
        out = out.append(ins.str);
      }
    }
  }
  return out;
}

function name_seen(names: string[], name: string): boolean {
  for n in names {
    if (n == name) {
      return true;
    }
  }
  return false;
}

pub function analyze(f: Func): Analysis {
  let why: string = schema_error(f);
  if (why != "") {
    return failed(why);
  }
  why = operations_error(f);
  if (why != "") {
    return failed(why);
  }
  return analyze_parents(f, borrow_parents(f));
}

pub function view_copy(first: i32, v: i32): ssa.SInst[] {
  return [
    ssa.SInst { kind_tag: 5, result: first, args: [], imm: 0, str: "" },
    ssa.SInst { kind_tag: 9, result: first + 1, args: [v, first], imm: 0, str: "+" },
    ssa.SInst { kind_tag: str_as(), result: first + 2, args: [first + 1], imm: 0, str: "" },
  ];
}

pub function view_copy_types(): typeinfo.Type[] {
  return [typeinfo.TypeString { tag: 0 }, typeinfo.TypeString { tag: 0 }, typeinfo.TypeString { tag: 1 }];
}

pub struct MergeCopy { at: i32, edge: boolean, consumer: i32, slot: i32, value: i32 }

pub function with_merge_copies(f: Func, copies: MergeCopy[]): Func {
  let s: CopySplice = CopySplice { values: f.values, done: [], id: 0, preds: [], insts: [], next_block: next_block_id(f.graph), unfold: false, helpers: [] };
  let made: i32[] = [];
  for _ in copies {
    made = made.append(0 - 1);
  }
  let last: i32[] = [];
  let pi: i32 = 0;
  while (pi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[pi];
    s = CopySplice { ...s, id: b.id, preds: b.preds, insts: [] };
    for ins in b.insts {
      let k: Made = copies_at(f, s, made, copies, pi, false, ins.result);
      s = CopySplice { ...k.s, insts: k.s.insts.append(ins) };
      made = k.made;
    }
    let e: Made = copies_at(f, s, made, copies, pi, true, 0 - 1);
    s = e.s;
    made = e.made;
    last = last.append(s.id);
    s = sp_close(s, b.term);
    pi = pi + 1;
  }
  let blocks: ssa.SBlock[] = [];
  let first_new: i32 = next_block_id(f.graph);
  for blk in s.done {
    let insts: ssa.SInst[] = [];
    for ins in blk.insts {
      insts = insts.append(with_copied_operands(ins, copies, made));
    }
    let preds: i32[] = blk.preds;
    if (blk.id < first_new) {
      preds = moved_preds(f.graph, preds, last);
    }
    blocks = blocks.append(ssa.SBlock { ...blk, insts: insts, preds: preds });
  }
  return Func { ...f, values: s.values, calls: with_copy_contracts(f.calls, s.helpers), graph: ssa.SFunc { ...f.graph, blocks: blocks, nvals: s.values.len() } };
}

function moved_preds(g: ssa.SFunc, preds: i32[], last: i32[]): i32[] {
  let out: i32[] = [];
  for p in preds {
    let at: i32 = 0 - 1;
    let i: i32 = 0;
    while (i < g.blocks.len()) {
      if (g.blocks[i].id == p) {
        at = i;
      }
      i = i + 1;
    }
    if (at >= 0) {
      out = out.append(last[at]);
    } else {
      out = out.append(p);
    }
  }
  return out;
}

function next_block_id(g: ssa.SFunc): i32 {
  let n: i32 = 0;
  for b in g.blocks {
    if (b.id >= n) {
      n = b.id + 1;
    }
  }
  return n;
}

struct Made { s: CopySplice, made: i32[] }

function copies_at(f: Func, s: CopySplice, made: i32[], copies: MergeCopy[], at: i32, edge: boolean, consumer: i32): Made {
  let ci: i32 = 0;
  while (ci < copies.len()) {
    let c: MergeCopy = copies[ci];
    if (c.at == at && c.edge == edge && (edge || c.consumer == consumer)) {
      let r: Copied = deep_copy(f, s, c.value);
      s = r.s;
      made = made.with(ci, r.value);
    }
    ci = ci + 1;
  }
  return Made { s: s, made: made };
}

function with_copied_operands(ins: ssa.SInst, copies: MergeCopy[], made: i32[]): ssa.SInst {
  let ci: i32 = 0;
  while (ci < copies.len()) {
    let c: MergeCopy = copies[ci];
    if (ins.result >= 0 && ins.result == c.consumer) {
      ins = ssa.SInst { ...ins, args: ins.args.with(c.slot, made[ci]) };
    }
    ci = ci + 1;
  }
  return ins;
}

struct CopySplice { values: typeinfo.Type[], done: ssa.SBlock[], id: i32, preds: i32[], insts: ssa.SInst[], next_block: i32, unfold: boolean, helpers: typeinfo.Type[] }

struct Copied { s: CopySplice, value: i32 }

function sp_emit(s: CopySplice, kind: i32, t: typeinfo.Type, args: i32[], imm: i32, str: string): Copied {
  let v: i32 = s.values.len();
  let ins: ssa.SInst = ssa.SInst { kind_tag: kind, result: v, args: args, imm: imm, str: str };
  return Copied { s: CopySplice { ...s, values: s.values.append(t), insts: s.insts.append(ins) }, value: v };
}

function sp_close(s: CopySplice, term: ssa.STerm): CopySplice {
  let b: ssa.SBlock = ssa.SBlock { id: s.id, insts: s.insts, term: term, preds: s.preds };
  return CopySplice { ...s, done: s.done.append(b), insts: [] };
}

function sp_open(s: CopySplice, id: i32, preds: i32[]): CopySplice {
  return CopySplice { ...s, id: id, preds: preds, insts: [] };
}

function sp_blocks(s: CopySplice, n: i32): CopySplice {
  return CopySplice { ...s, next_block: s.next_block + n };
}

function t_br(target: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function t_brif(cond: i32, t: i32, f: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 3, cond: cond, target: 0, t: t, f: f, value: 0 };
}

function boolean_type(): typeinfo.Type {
  return typeinfo.TypeBool { tag: 0 };
}

function i32_type(): typeinfo.Type {
  return typeinfo.TypeI32 { is_char: false, width: 32, unsigned: false, polymorphic: false };
}

pub function holds_view(f: Func, t: typeinfo.Type): boolean {
  if let typeinfo.TypeString(st) = t {
    return st.tag == 1;
  }
  if let typeinfo.TypeArray(a) = t {
    return a.view || holds_view(f, a.elem);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      if (holds_view(f, e)) {
        return true;
      }
    }
    return false;
  }
  if (semtypes.is_cell(t)) {
    return holds_view(f, semtypes.cell_elem(t));
  }
  if let typeinfo.TypeMap(m) = t {
    return holds_view(f, m.key) || holds_view(f, m.value);
  }
  let r: i32 = semrecords.find(f.records, t);
  if (r >= 0) {
    return f.records.list[r].views;
  }
  let e: i32 = semrecords.find_enum(f.enums, t);
  if (e >= 0) {
    return f.enums[e].views;
  }
  if let typeinfo.TypeUnion(u) = t {
    for a in u.args {
      if (holds_view(f, a)) {
        return true;
      }
    }
  }
  if (is_dyn(t)) {
    return dyn_view_concretes(f, t).len() > 0;
  }
  return false;
}

function copy_refusal(f: Func, t: typeinfo.Type, open: typeinfo.Type[]): string {
  if (!holds_view(f, t) || is_view(t)) {
    return "";
  }
  if let typeinfo.TypeArray(a) = t {
    return copy_refusal(f, a.elem, open);
  }
  if let typeinfo.TypeTuple(tup) = t {
    return all_copyable(f, tup.elements, open);
  }
  if (semtypes.is_cell(t)) {
    return "a cell " + typeinfo.spelling(t) + " is shared storage a copy would split";
  }
  if (is_map(t)) {
    return map_refusal(f, t, open);
  }
  if (has_type(open, t)) {
    return "";
  }
  let inner: typeinfo.Type[] = open.append(t);
  if (is_dyn(t)) {
    return dyn_refusal(f, t, inner);
  }
  if let typeinfo.TypeUnion(_) = t {
    return enum_refusal(f, t, inner);
  }
  let r: i32 = semrecords.find(f.records, t);
  if (r < 0 || semtypes.is_env(t)) {
    return typeinfo.spelling(t) + " has no record schema to rebuild it by";
  }
  for fl in f.records.list[r].fields {
    let why: string = copy_refusal(f, fl.ty, inner);
    if (why != "") {
      return why;
    }
  }
  return "";
}

function all_copyable(f: Func, ts: typeinfo.Type[], open: typeinfo.Type[]): string {
  for e in ts {
    let why: string = copy_refusal(f, e, open);
    if (why != "") {
      return why;
    }
  }
  return "";
}

function enum_refusal(f: Func, t: typeinfo.Type, open: typeinfo.Type[]): string {
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at < 0 || f.enums[at].layout == semrecords.layout_member()) {
    return typeinfo.spelling(t) + " has no variant tests to rebuild it by";
  }
  for v in f.enums[at].variants {
    for fl in v.fields {
      let why: string = copy_refusal(f, fl.ty, open);
      if (why != "") {
        return why;
      }
    }
  }
  return "";
}

function map_refusal(f: Func, t: typeinfo.Type, open: typeinfo.Type[]): string {
  if (!is_supported_map(t) || !retained_column(map_key(t)) || !retained_column(map_value(t))) {
    return "a map " + typeinfo.spelling(t) + " has a column no snapshot owns";
  }
  return all_copyable(f, [map_key(t), map_value(t)], open);
}

function dyn_refusal(f: Func, t: typeinfo.Type, open: typeinfo.Type[]): string {
  for c in dyn_view_concretes(f, t) {
    if (shape_name(f, c) == "") {
      return "the box " + typeinfo.spelling(c) + " of " + typeinfo.spelling(t) + " carries no shape a test names";
    }
    let why: string = copy_refusal(f, c, open);
    if (why != "") {
      return why;
    }
  }
  return "";
}

function dyn_view_concretes(f: Func, t: typeinfo.Type): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for row in f.dyns {
    if (semtypes.equal(row.fn_ty, t) && !semtypes.equal(row.env_ty, t) && holds_view(f, row.env_ty)) {
      out = out.append(row.env_ty);
    }
  }
  return out;
}

function shape_name(f: Func, c: typeinfo.Type): string {
  if let typeinfo.TypeStruct(r) = c {
    if (r.args.len() == 0) {
      return r.name;
    }
  }
  if let typeinfo.TypeUnion(u) = c {
    let at: i32 = semrecords.find_enum(f.enums, c);
    if (u.args.len() == 0 && at >= 0 && f.enums[at].layout == semrecords.layout_variant()) {
      return u.name;
    }
  }
  return "";
}

function deep_copy(f: Func, s: CopySplice, v: i32): Copied {
  let t: typeinfo.Type = s.values[v];
  if (!holds_view(f, t)) {
    return Copied { s: s, value: v };
  }
  if (is_view(t)) {
    let first: i32 = s.values.len();
    let values: typeinfo.Type[] = s.values;
    for vt in view_copy_types() {
      values = values.append(vt);
    }
    let insts: ssa.SInst[] = s.insts;
    for ins in view_copy(first, v) {
      insts = insts.append(ins);
    }
    return Copied { s: CopySplice { ...s, values: values, insts: insts }, value: first + 2 };
  }
  if let typeinfo.TypeArray(a) = t {
    return copy_array(f, s, v, t, a.elem);
  }
  if let typeinfo.TypeTuple(tup) = t {
    return copy_tuple(f, s, v, t, tup.elements);
  }
  if (calls_helper(f, s, t)) {
    return helper_call(s, v, t);
  }
  s = CopySplice { ...s, unfold: false };
  if (is_dyn(t)) {
    return copy_dyn(f, s, v, t);
  }
  if (is_map(t)) {
    return copy_map(f, s, v, t);
  }
  if let typeinfo.TypeStruct(_) = t {
    return copy_record(f, s, v, t);
  }
  return copy_enum(f, s, v, t);
}

function copy_record(f: Func, s: CopySplice, v: i32, t: typeinfo.Type): Copied {
  let fields: semrecords.Field[] = f.records.list[semrecords.find(f.records, t)].fields;
  let parts: i32[] = [];
  let i: i32 = 0;
  while (i < fields.len()) {
    let g: Copied = sp_emit(s, record_get(), fields[i].ty, [v], i, fields[i].name);
    let c: Copied = deep_copy(f, g.s, g.value);
    s = c.s;
    parts = parts.append(c.value);
    i = i + 1;
  }
  return sp_emit(s, record_new(), t, parts, 0, "");
}

function copy_tuple(f: Func, s: CopySplice, v: i32, t: typeinfo.Type, elements: typeinfo.Type[]): Copied {
  let parts: i32[] = [];
  let i: i32 = 0;
  while (i < elements.len()) {
    let e: Copied = sp_emit(s, tuple_get(), elements[i], [v], i, "");
    let c: Copied = deep_copy(f, e.s, e.value);
    s = c.s;
    parts = parts.append(c.value);
    i = i + 1;
  }
  return sp_emit(s, tuple_new(), t, parts, 0, "");
}

function copy_array(f: Func, s: CopySplice, v: i32, t: typeinfo.Type, elem: typeinfo.Type): Copied {
  let owned: typeinfo.Type = typeinfo.TypeArray { elem: elem, view: false };
  let n: Copied = sp_emit(s, length(), i32_type(), [v], 0, "");
  let acc0: Copied = sp_emit(n.s, array_new(), owned, [], 0, "");
  let l: CopyLoop = loop_enter(acc0.s, n.value, acc0.value, owned);
  let e: Copied = sp_emit(l.s, array_get(), elem, [v, l.i], 0, "");
  let c: Copied = deep_copy(f, e.s, e.value);
  let acc1: Copied = sp_emit(c.s, append(), owned, [l.acc, c.value], 0, "");
  let copied: Copied = loop_leave(l, acc1.s, acc1.value);
  if (semtypes.lends_array(owned, t)) {
    return sp_emit(copied.s, array_lend(), t, [copied.value], 0, "");
  }
  return copied;
}

function copy_map(f: Func, s: CopySplice, v: i32, t: typeinfo.Type): Copied {
  let kt: typeinfo.Type = map_key(t);
  let vt: typeinfo.Type = map_value(t);
  let keys: Copied = sp_emit(s, map_keys(), typeinfo.TypeArray { elem: kt, view: false }, [v], 0, "");
  let vals: Copied = sp_emit(keys.s, map_values(), typeinfo.TypeArray { elem: vt, view: false }, [v], 0, "");
  let n: Copied = sp_emit(vals.s, length(), i32_type(), [keys.value], 0, "");
  let acc0: Copied = sp_emit(n.s, map_new(), t, [n.value], 0, "");
  let l: CopyLoop = loop_enter(acc0.s, n.value, acc0.value, t);
  let k: Copied = sp_emit(l.s, array_get(), kt, [keys.value, l.i], 0, "");
  let ck: Copied = deep_copy(f, k.s, k.value);
  let x: Copied = sp_emit(ck.s, array_get(), vt, [vals.value, l.i], 0, "");
  let cx: Copied = deep_copy(f, x.s, x.value);
  let acc1: Copied = sp_emit(cx.s, map_insert(), t, [l.acc, ck.value, cx.value], 0, "");
  return loop_leave(l, acc1.s, acc1.value);
}

struct CopyLoop { s: CopySplice, pre: i32, head: i32, exit: i32, head_at: i32, i: i32, acc: i32, cond: i32, zero: i32, one: i32, n: i32, acc0: i32 }

function loop_enter(s: CopySplice, n: i32, acc0: i32, t: typeinfo.Type): CopyLoop {
  let zero: Copied = sp_emit(s, 1, i32_type(), [], 0, "");
  let one: Copied = sp_emit(zero.s, 1, i32_type(), [], 1, "");
  s = one.s;
  let head: i32 = s.next_block;
  let pre: i32 = s.id;
  let i: i32 = s.values.len();
  s = CopySplice { ...sp_blocks(s, 3), values: s.values.append(i32_type()).append(t).append(boolean_type()) };
  s = sp_close(s, t_br(head));
  let head_at: i32 = s.done.len();
  s = sp_open(s, head + 1, [head]);
  return CopyLoop { s: s, pre: pre, head: head, exit: head + 2, head_at: head_at, i: i, acc: i + 1, cond: i + 2, zero: zero.value, one: one.value, n: n, acc0: acc0 };
}

function loop_leave(l: CopyLoop, s: CopySplice, acc1: i32): Copied {
  let i1: Copied = sp_emit(s, 9, i32_type(), [l.i, l.one], 0, "+");
  s = i1.s;
  let latch: i32 = s.id;
  s = sp_close(s, t_br(l.head));
  let header: ssa.SBlock = ssa.SBlock { id: l.head, preds: [l.pre, latch], term: t_brif(l.cond, l.head + 1, l.exit), insts: [
    ssa.SInst { kind_tag: 8, result: l.i, args: [l.zero, i1.value], imm: 0, str: "" },
    ssa.SInst { kind_tag: 8, result: l.acc, args: [l.acc0, acc1], imm: 0, str: "" },
    ssa.SInst { kind_tag: 9, result: l.cond, args: [l.i, l.n], imm: 0, str: "<" },
  ] };
  s = CopySplice { ...s, done: inserted(s.done, l.head_at, header) };
  s = sp_open(s, l.exit, [l.head]);
  return Copied { s: s, value: l.acc };
}

function inserted(blocks: ssa.SBlock[], at: i32, b: ssa.SBlock): ssa.SBlock[] {
  let out: ssa.SBlock[] = [];
  let i: i32 = 0;
  while (i < blocks.len()) {
    if (i == at) {
      out = out.append(b);
    }
    out = out.append(blocks[i]);
    i = i + 1;
  }
  if (at >= blocks.len()) {
    out = out.append(b);
  }
  return out;
}

function copy_enum(f: Func, s: CopySplice, v: i32, t: typeinfo.Type): Copied {
  let variants: semrecords.Variant[] = f.enums[semrecords.find_enum(f.enums, t)].variants;
  let join: i32 = s.next_block;
  s = sp_blocks(s, 1);
  let froms: i32[] = [];
  let built: i32[] = [];
  let k: i32 = 0;
  while (k < variants.len()) {
    if (k + 1 < variants.len()) {
      let test: Copied = sp_emit(s, variant_is(), boolean_type(), [v], 0, variants[k].name);
      s = test.s;
      let arm: i32 = s.next_block;
      let next: i32 = arm + 1;
      let at: i32 = s.id;
      s = sp_close(sp_blocks(s, 2), t_brif(test.value, arm, next));
      let r: Copied = rebuilt_variant(f, sp_open(s, arm, [at]), v, t, variants[k]);
      froms = froms.append(r.s.id);
      built = built.append(r.value);
      s = sp_open(sp_close(r.s, t_br(join)), next, [at]);
    } else {
      let r: Copied = rebuilt_variant(f, s, v, t, variants[k]);
      froms = froms.append(r.s.id);
      built = built.append(r.value);
      s = sp_close(r.s, t_br(join));
    }
    k = k + 1;
  }
  s = sp_open(s, join, froms);
  let out: i32 = s.values.len();
  let phi: ssa.SInst = ssa.SInst { kind_tag: 8, result: out, args: built, imm: 0, str: "" };
  return Copied { s: CopySplice { ...s, values: s.values.append(t), insts: s.insts.append(phi) }, value: out };
}

function rebuilt_variant(f: Func, s: CopySplice, v: i32, t: typeinfo.Type, variant: semrecords.Variant): Copied {
  let parts: i32[] = [];
  let j: i32 = 0;
  while (j < variant.fields.len()) {
    let g: Copied = sp_emit(s, variant_get(), variant.fields[j].ty, [v], j, variant.name);
    let c: Copied = deep_copy(f, g.s, g.value);
    s = c.s;
    parts = parts.append(c.value);
    j = j + 1;
  }
  return sp_emit(s, variant_new(), t, parts, 0, variant.name);
}

function copy_dyn(f: Func, s: CopySplice, v: i32, t: typeinfo.Type): Copied {
  let join: i32 = s.next_block;
  s = sp_blocks(s, 1);
  let froms: i32[] = [];
  let built: i32[] = [];
  for c in dyn_view_concretes(f, t) {
    let name: string = shape_name(f, c);
    let test: Copied = sp_emit(s, dyn_is(), boolean_type(), [v], 0, name);
    s = test.s;
    let arm: i32 = s.next_block;
    let at: i32 = s.id;
    s = sp_close(sp_blocks(s, 2), t_brif(test.value, arm, arm + 1));
    let n: Copied = sp_emit(sp_open(s, arm, [at]), dyn_as(), c, [v], 0, name);
    let cc: Copied = deep_copy(f, n.s, n.value);
    let up: Copied = sp_emit(cc.s, dyn_up(), t, [cc.value], 0, "");
    froms = froms.append(up.s.id);
    built = built.append(up.value);
    s = sp_open(sp_close(up.s, t_br(join)), arm + 1, [at]);
  }
  let kept: Copied = sp_emit(s, dyn_as(), t, [v], 0, "");
  froms = froms.append(kept.s.id);
  built = built.append(kept.value);
  s = sp_open(sp_close(kept.s, t_br(join)), join, froms);
  let out: i32 = s.values.len();
  let phi: ssa.SInst = ssa.SInst { kind_tag: 8, result: out, args: built, imm: 0, str: "" };
  return Copied { s: CopySplice { ...s, values: s.values.append(t), insts: s.insts.append(phi) }, value: out };
}

pub function copy_helper(t: typeinfo.Type): string {
  return "__fern_copy_" + type_key(t);
}

pub function copy_helpers_called(f: Func): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for c in f.calls {
    if (c.params.len() == 1 && c.name == copy_helper(c.params[0])) {
      out = out.append(c.params[0]);
    }
  }
  return out;
}

pub function copy_helper_func(f: Func, t: typeinfo.Type): Func {
  let param: ssa.SInst = ssa.SInst { kind_tag: 6, result: 0, args: [], imm: 0, str: "" };
  let s: CopySplice = CopySplice { values: [t], done: [], id: 0, preds: [], insts: [param], next_block: 1, unfold: true, helpers: [] };
  let c: Copied = deep_copy(f, s, 0);
  s = sp_close(c.s, ssa.STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: c.value });
  let graph: ssa.SFunc = ssa.SFunc { name: copy_helper(t), nparams: 1, nvals: s.values.len(), blocks: s.done, entry: 0, takes_env: false };
  return Func { ...f, graph: graph, values: s.values, params: [t], result: t, calls: with_copy_contracts([], s.helpers), envs: [] };
}

function calls_helper(f: Func, s: CopySplice, t: typeinfo.Type): boolean {
  return !s.unfold && holds_itself(f, t);
}

function helper_call(s: CopySplice, v: i32, t: typeinfo.Type): Copied {
  let helpers: typeinfo.Type[] = s.helpers;
  if (!has_type(helpers, t)) {
    helpers = helpers.append(t);
  }
  return sp_emit(CopySplice { ...s, helpers: helpers }, call(), t, [v], 0, copy_helper(t));
}

function with_copy_contracts(calls: Contract[], helpers: typeinfo.Type[]): Contract[] {
  let out: Contract[] = calls;
  for t in helpers {
    if (find_contract_in(out, copy_helper(t)) < 0) {
      out = out.append(Contract { name: copy_helper(t), params: [t], modes: [borrow_mode()], result: t });
    }
  }
  return out;
}

function has_type(ts: typeinfo.Type[], t: typeinfo.Type): boolean {
  for x in ts {
    if (semtypes.equal(x, t)) {
      return true;
    }
  }
  return false;
}

function holds_itself(f: Func, t: typeinfo.Type): boolean {
  if (!holds_view(f, t) || is_view(t)) {
    return false;
  }
  return reaches(f, copy_parts(f, t), t, [t]);
}

function reaches(f: Func, parts: typeinfo.Type[], target: typeinfo.Type, seen: typeinfo.Type[]): boolean {
  for p in parts {
    if (holds_view(f, p) && !is_view(p)) {
      if (semtypes.equal(p, target)) {
        return true;
      }
      if (!has_type(seen, p) && reaches(f, copy_parts(f, p), target, seen.append(p))) {
        return true;
      }
    }
  }
  return false;
}

function copy_parts(f: Func, t: typeinfo.Type): typeinfo.Type[] {
  if let typeinfo.TypeArray(a) = t {
    return [a.elem];
  }
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements;
  }
  if (is_map(t)) {
    return [map_key(t), map_value(t)];
  }
  if (is_dyn(t)) {
    return dyn_view_concretes(f, t);
  }
  if let typeinfo.TypeUnion(_) = t {
    return variant_parts(f, t);
  }
  let out: typeinfo.Type[] = [];
  let r: i32 = semrecords.find(f.records, t);
  if (r >= 0) {
    for fl in f.records.list[r].fields {
      out = out.append(fl.ty);
    }
  }
  return out;
}

function variant_parts(f: Func, t: typeinfo.Type): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let at: i32 = semrecords.find_enum(f.enums, t);
  if (at >= 0) {
    for v in f.enums[at].variants {
      for fl in v.fields {
        out = out.append(fl.ty);
      }
    }
  }
  return out;
}

pub struct MergePlan { copies: MergeCopy[], why: string }

pub function merge_copies(f: Func): MergePlan {
  let plan: MergePlan = MergePlan { copies: [], why: "" };
  if (!has_view_phi(f)) {
    return plan;
  }
  let none: boolean[] = __alloc_bool(f.values.len());
  let defs: ssa.SInst[] = definitions(f);
  let m: MergeScan = MergeScan { at: ssadeps.position_of(f.graph), dom: ssadeps.dominates(f.graph), home: defining_positions(f), none: none };
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    for ins in f.graph.blocks[bi].insts {
      if (ins.kind_tag == 8 && holds_view(f, f.values[ins.result])) {
        plan = operand_copies(f, defs, m, bi, ins.result, none, plan);
      }
    }
    bi = bi + 1;
  }
  return plan;
}

function has_view_phi(f: Func): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == 8 && holds_view(f, f.values[ins.result])) {
        return true;
      }
    }
  }
  return false;
}

function copies_slot(copies: MergeCopy[], consumer: i32, slot: i32): boolean {
  for c in copies {
    if (c.consumer == consumer && c.slot == slot) {
      return true;
    }
  }
  return false;
}

struct MergeScan { at: i32[], dom: ssadeps.Dom, home: i32[], none: boolean[] }

function held_copies(f: Func, defs: ssa.SInst[], m: MergeScan, join: i32, consumer: i32, slot: i32, x: i32, seen: boolean[], own plan: MergePlan): MergePlan {
  if (!holds_outlived(f, defs, m, join, x, seen)) {
    return plan;
  }
  if (is_view(f.values[x])) {
    return with_copy(f, defs, m, consumer, slot, x, plan);
  }
  let d: ssa.SInst = defs[x];
  let next: boolean[] = seen.with(x, true);
  if (projects(d.kind_tag) && d.args.len() > 0) {
    return held_copies(f, defs, m, join, x, 0, d.args[0], next, plan);
  }
  if (!gathers_views(d.kind_tag)) {
    let why: string = copy_refusal(f, f.values[x], []);
    if (why != "") {
      if (plan.why == "") {
        plan = MergePlan { ...plan, why: "a value merged past its source has no copy: " + why };
      }
      return plan;
    }
    return with_copy(f, defs, m, consumer, slot, x, plan);
  }
  return operand_copies(f, defs, m, join, x, next, plan);
}

function operand_copies(f: Func, defs: ssa.SInst[], m: MergeScan, join: i32, consumer: i32, seen: boolean[], own plan: MergePlan): MergePlan {
  let args: i32[] = defs[consumer].args;
  let j: i32 = 0;
  while (j < args.len()) {
    plan = held_copies(f, defs, m, join, consumer, j, args[j], seen, plan);
    j = j + 1;
  }
  return plan;
}

function holds_outlived(f: Func, defs: ssa.SInst[], m: MergeScan, join: i32, x: i32, seen: boolean[]): boolean {
  if (x < 0 || x >= defs.len() || seen[x] || !holds_view(f, f.values[x])) {
    return false;
  }
  return !counted_view(f, defs, x, m.none) && roots_outlived(f, defs, m, x, join);
}

function with_copy(f: Func, defs: ssa.SInst[], m: MergeScan, consumer: i32, slot: i32, x: i32, own plan: MergePlan): MergePlan {
  if (copies_slot(plan.copies, consumer, slot)) {
    return plan;
  }
  let home: i32 = m.home[consumer];
  let edge: boolean = defs[consumer].kind_tag == 8;
  let at: i32 = home;
  if (edge) {
    let preds: i32[] = f.graph.blocks[home].preds;
    if (slot >= preds.len()) {
      return plan;
    }
    at = m.at[preds[slot]];
  }
  return MergePlan { ...plan, copies: plan.copies.append(MergeCopy { at: at, edge: edge, consumer: consumer, slot: slot, value: x }) };
}

function roots_outlived(f: Func, defs: ssa.SInst[], m: MergeScan, v: i32, bi: i32): boolean {
  for r in bytes_roots(f, defs, v, m.none) {
    let h: i32 = 0 - 1;
    if (r >= 0 && r < m.home.len()) {
      h = m.home[r];
    }
    if (h < 0 || h == bi || !ssadeps.dom_holds(m.dom, bi, h)) {
      return true;
    }
  }
  return false;
}

function defining_positions(f: Func): i32[] {
  let out: i32[] = [];
  for _ in f.values {
    out = out.append(0 - 1);
  }
  let bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    for ins in f.graph.blocks[bi].insts {
      if (ins.result >= 0 && ins.result < out.len()) {
        out = out.with(ins.result, bi);
      }
    }
    bi = bi + 1;
  }
  return out;
}

pub function tail_recursion(own f: Func, name: string): Func {
  if (name.len() == 0 || f.graph.blocks.len() == 0) {
    return f;
  }
  if (f.graph.blocks[0].preds.len() > 0) {
    return f;
  }
  let nparams: i32 = f.graph.nparams;
  if (f.values.len() < nparams || !calls_itself(f, name)) {
    return f;
  }
  let parents: i32[][] = borrow_parents(f);
  let defs: ssa.SInst[] = definitions(f);
  let kinds: i32[] = back_kinds(f, name, nparams, parents, defs);
  let hole: i32 = agreed_hole(f, kinds, name, nparams, parents, defs);
  if (hole < 0) {
    kinds = without_cons(kinds);
  }
  if (util.index_of_i32(kinds, self_tail()) < 0 && util.index_of_i32(kinds, cons_tail()) < 0) {
    return f;
  }
  return spliced(f, kinds, nparams, hole, name);
}

function calls_itself(f: Func, name: string): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == call() && ins.str == name) {
        return true;
      }
    }
  }
  return false;
}

function self_tail(): i32 {
  return 1;
}

function cons_tail(): i32 {
  return 2;
}

function back_kinds(f: Func, name: string, nparams: i32, parents: i32[][], defs: ssa.SInst[]): i32[] {
  let out: i32[] = [];
  for b in f.graph.blocks {
    let k: i32 = 0;
    if (is_self_tail(f, b, name, nparams, parents, defs)) {
      k = self_tail();
    } else if (cons_hole(f, b, name, nparams, parents, defs) >= 0) {
      k = cons_tail();
    }
    out = out.append(k);
  }
  return out;
}

function agreed_hole(f: Func, kinds: i32[], name: string, nparams: i32, parents: i32[][], defs: ssa.SInst[]): i32 {
  if (!record_laid(f, f.result)) {
    return 0 - 1;
  }
  let hole: i32 = 0 - 1;
  let bi: i32 = 0;
  while (bi < kinds.len()) {
    if (kinds[bi] == cons_tail()) {
      let at: i32 = cons_hole(f, f.graph.blocks[bi], name, nparams, parents, defs);
      if (hole >= 0 && at != hole) {
        return 0 - 1;
      }
      hole = at;
    }
    bi = bi + 1;
  }
  return hole;
}

function without_cons(kinds: i32[]): i32[] {
  let out: i32[] = [];
  for k in kinds {
    if (k == cons_tail()) {
      out = out.append(0);
    } else {
      out = out.append(k);
    }
  }
  return out;
}

function crosses_jump(f: Func, a: i32, parents: i32[][], defs: ssa.SInst[]): boolean {
  if (a < 0 || a >= parents.len() || parents[a].len() == 0) {
    return true;
  }
  if (sliced_view_param(f, a, parents, defs)) {
    return true;
  }
  let t: typeinfo.Type = f.values[a];
  if (!reference(t) || holds_view(f, t) || is_map(t)) {
    return false;
  }
  let k: i32 = defs[a].kind_tag;
  return k == variant_get() || k == record_get() || k == tuple_get() || k == array_get();
}

function sliced_view_param(f: Func, a: i32, parents: i32[][], defs: ssa.SInst[]): boolean {
  if (!is_view(f.values[a]) || defs[a].kind_tag != slice()) {
    return false;
  }
  for p in parents[a] {
    if (p >= f.graph.nparams || !is_view(f.values[p])) {
      return false;
    }
  }
  return true;
}

function args_cross(f: Func, args: i32[], parents: i32[][], defs: ssa.SInst[]): boolean {
  for a in args {
    if (!crosses_jump(f, a, parents, defs)) {
      return false;
    }
  }
  return true;
}

function is_self_tail(f: Func, b: ssa.SBlock, name: string, nparams: i32, parents: i32[][], defs: ssa.SInst[]): boolean {
  if (b.term.kind_tag != 1 || b.insts.len() == 0) {
    return false;
  }
  let last: ssa.SInst = b.insts[b.insts.len() - 1];
  if (last.kind_tag != call() || last.str != name || last.args.len() != nparams) {
    return false;
  }
  if (!args_cross(f, last.args, parents, defs)) {
    return false;
  }
  if (b.term.value == last.result) {
    return true;
  }
  return b.term.value < 0 && is_void(f.result);
}

function cons_hole(f: Func, b: ssa.SBlock, name: string, nparams: i32, parents: i32[][], defs: ssa.SInst[]): i32 {
  let n: i32 = b.insts.len();
  if (b.term.kind_tag != 1 || n < 2) {
    return 0 - 1;
  }
  let cons: ssa.SInst = b.insts[n - 1];
  if (cons.kind_tag != variant_new() || b.term.value != cons.result) {
    return 0 - 1;
  }
  let at: i32 = n - 2;
  while (at >= 0 && !(b.insts[at].kind_tag == call() && b.insts[at].str == name)) {
    if (!reorderable(b.insts[at])) {
      return 0 - 1;
    }
    at = at - 1;
  }
  if (at < 0) {
    return 0 - 1;
  }
  let c: ssa.SInst = b.insts[at];
  if (c.args.len() != nparams || !args_cross(f, c.args, parents, defs)) {
    return 0 - 1;
  }
  let i: i32 = at + 1;
  while (i < n - 1) {
    if (util.index_of_i32(b.insts[i].args, c.result) >= 0) {
      return 0 - 1;
    }
    i = i + 1;
  }
  let uses: i32 = 0;
  for a in cons.args {
    if (a == c.result) {
      uses = uses + 1;
    }
  }
  if (uses != 1) {
    return 0 - 1;
  }
  return util.index_of_i32(cons.args, c.result);
}

pub function reorderable(ins: ssa.SInst): boolean {
  let k: i32 = ins.kind_tag;
  if (k == 9) {
    return ins.str != "/" && ins.str != "%";
  }
  return k == 1 || k == 2 || k == 5 || k == 7 || k == 10 || k == zero() || k == cast()
    || k == variant_get() || k == variant_is() || k == record_get() || k == tuple_get() || k == length();
}

function fresh_block_id(f: Func): i32 {
  let top: i32 = 0;
  for b in f.graph.blocks {
    if (b.id > top) {
      top = b.id;
    }
  }
  return top + 1;
}

function phi_map(f: Func, nparams: i32): i32[] {
  let map: i32[] = [];
  let v: i32 = 0;
  while (v < f.graph.nvals) {
    if (v < nparams) {
      map = map.append(f.graph.nvals + v);
    } else {
      map = map.append(v);
    }
    v = v + 1;
  }
  return map;
}

function mapped(map: i32[], v: i32): i32 {
  if (v < 0 || v >= map.len()) {
    return v;
  }
  return map[v];
}

function mapped_list(map: i32[], vs: i32[]): i32[] {
  let out: i32[] = [];
  for v in vs {
    out = out.append(mapped(map, v));
  }
  return out;
}

pub function mapped_inst(map: i32[], ins: ssa.SInst): ssa.SInst {
  let base: i32 = update_base(ins);
  if (base >= 0) {
    return ssa.SInst { ...ins, args: mapped_list(map, ins.args), imm: mapped(map, base) + 1 };
  }
  return ssa.SInst { ...ins, args: mapped_list(map, ins.args) };
}

function mapped_ret_term(map: i32[], t: ssa.STerm): ssa.STerm {
  if (t.kind_tag == 1) {
    return ssa.STerm { ...t, value: mapped(map, t.value) };
  }
  if (t.kind_tag == 3) {
    return ssa.STerm { ...t, cond: mapped(map, t.cond) };
  }
  return t;
}

struct Splice { values: typeinfo.Type[], blocks: ssa.SBlock[], backs: i32[], rows: i32[][] }

struct Chain { r: i32, h: i32, r0: i32, h0: i32 }

function loop_chain(f: Func, nparams: i32): Chain {
  let r: i32 = f.graph.nvals + nparams;
  return Chain { r: r, h: r + 1, r0: r + 2, h0: r + 3 };
}

function address(): typeinfo.Type {
  return typeinfo.TypeI32 { width: typeinfo.width_ptr(), unsigned: true, is_char: false, polymorphic: false };
}

function spliced(own f: Func, kinds: i32[], nparams: i32, hole: i32, name: string): Func {
  let map: i32[] = phi_map(f, nparams);
  let header: i32 = fresh_block_id(f);
  let entry: ssa.SBlock = f.graph.blocks[0];
  let ch: Chain = loop_chain(f, nparams);
  let values: typeinfo.Type[] = f.values;
  let p: i32 = 0;
  while (p < nparams) {
    values = values.append(f.values[p]);
    p = p + 1;
  }
  if (hole >= 0) {
    values = values.append(f.result).append(address()).append(f.result).append(address());
  }
  let s: Splice = Splice { values: values, blocks: [], backs: [], rows: [] };
  let head: ssa.SBlock = ssa.SBlock { ...entry, id: header, insts: not_kind_6(entry.insts) };
  s = rewrite_block(s, f, head, kinds[0], map, header, hole, ch);
  let bi: i32 = 1;
  while (bi < f.graph.blocks.len()) {
    let b: ssa.SBlock = f.graph.blocks[bi];
    s = rewrite_block(s, f, ssa.SBlock { ...b, preds: repointed(b.preds, entry.id, header) }, kinds[bi], map, header, hole, ch);
    bi = bi + 1;
  }

  let entry_insts: ssa.SInst[] = kind_6(entry.insts);
  let firsts: i32[] = [];
  p = 0;
  while (p < nparams) {
    firsts = firsts.append(p);
    if (sliced_on_back_edge(f, s.rows, p)) {
      let at: i32 = s.values.len();
      entry_insts = entry_insts.append(ssa.SInst { kind_tag: 1, result: at, args: [], imm: 0, str: "" });
      entry_insts = entry_insts.append(ssa.SInst { kind_tag: length(), result: at + 1, args: [p], imm: 0, str: "" });
      entry_insts = entry_insts.append(ssa.SInst { kind_tag: slice(), result: at + 2, args: [p, at, at + 1], imm: 0, str: "" });
      s = Splice { ...s, values: s.values.append(i32_type()).append(i32_type()).append(f.values[p]) };
      firsts = firsts.with(p, at + 2);
    }
    p = p + 1;
  }
  if (hole >= 0) {
    entry_insts = entry_insts.append(ssa.SInst { kind_tag: zero(), result: ch.r0, args: [], imm: 0, str: "" });
    entry_insts = entry_insts.append(ssa.SInst { kind_tag: zero(), result: ch.h0, args: [], imm: 0, str: "" });
  }
  let blocks: ssa.SBlock[] = [ssa.SBlock { id: entry.id, insts: entry_insts, term: branch_to(header), preds: [] }];
  let built: ssa.SBlock = s.blocks[0];
  let head_insts: ssa.SInst[] = phis(map, firsts, s.rows, nparams, hole, ch, name);
  for ins in built.insts {
    head_insts = head_insts.append(ins);
  }
  let preds: i32[] = [entry.id];
  for back in s.backs {
    preds = preds.append(back);
  }
  blocks = blocks.append(ssa.SBlock { ...built, insts: head_insts, preds: preds });
  let k: i32 = 1;
  while (k < s.blocks.len()) {
    blocks = blocks.append(s.blocks[k]);
    k = k + 1;
  }
  let graph: ssa.SFunc = ssa.SFunc { ...f.graph, nvals: s.values.len(), blocks: blocks };
  return Func { ...f, graph: graph, values: s.values };
}

function sliced_on_back_edge(f: Func, rows: i32[][], p: i32): boolean {
  if (!is_view(f.values[p])) {
    return false;
  }
  let defs: ssa.SInst[] = definitions(f);
  for row in rows {
    let v: i32 = row[p];
    if (v >= 0 && v < defs.len() && defs[v].kind_tag == slice()) {
      return true;
    }
  }
  return false;
}

function branch_to(header: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: header, t: 0, f: 0, value: 0 };
}

function rewrite_block(own s: Splice, f: Func, b: ssa.SBlock, kind: i32, map: i32[], header: i32, hole: i32, ch: Chain): Splice {
  if (kind == self_tail()) {
    let kept: ssa.SInst[] = [];
    let i: i32 = 0;
    while (i + 1 < b.insts.len()) {
      kept = kept.append(mapped_inst(map, b.insts[i]));
      i = i + 1;
    }
    let row: i32[] = mapped_list(map, b.insts[b.insts.len() - 1].args);
    if (hole >= 0) {
      row = row.append(ch.r).append(ch.h);
    }
    return Splice { ...s, blocks: s.blocks.append(ssa.SBlock { ...b, insts: kept, term: branch_to(header) }), backs: s.backs.append(b.id), rows: s.rows.append(row) };
  }
  if (kind == cons_tail()) {
    return linked(s, f, b, map, header, hole, ch);
  }
  let insts: ssa.SInst[] = rewritten(map, b.insts);
  let term: ssa.STerm = mapped_ret_term(map, b.term);
  if (hole >= 0 && term.kind_tag == 1 && term.value >= 0) {
    let filled: i32 = s.values.len();
    insts = insts.append(ssa.SInst { kind_tag: hole_fill(), result: filled, args: [ch.r, ch.h, term.value], imm: hole, str: "" });
    term = ssa.STerm { ...term, value: filled };
    s = Splice { ...s, values: s.values.append(f.result) };
  }
  return Splice { ...s, blocks: s.blocks.append(ssa.SBlock { ...b, insts: insts, term: term }) };
}

function linked(own s: Splice, f: Func, b: ssa.SBlock, map: i32[], header: i32, hole: i32, ch: Chain): Splice {
  let cons: ssa.SInst = b.insts[b.insts.len() - 1];
  let placeholder: i32 = cons.args[hole];
  let insts: ssa.SInst[] = [];
  let row: i32[] = [];
  for ins in b.insts {
    if (ins.result == placeholder) {
      row = mapped_list(map, ins.args);
      insts = insts.append(ssa.SInst { kind_tag: zero(), result: placeholder, args: [], imm: 0, str: "" });
    } else {
      insts = insts.append(mapped_inst(map, ins));
    }
  }
  let at: i32 = s.values.len();
  let chain: i32 = at + 1;
  insts = insts.append(ssa.SInst { kind_tag: hole_at(), result: at, args: [cons.result], imm: 0, str: "" });
  insts = insts.append(ssa.SInst { kind_tag: hole_fill(), result: chain, args: [ch.r, ch.h, cons.result], imm: hole, str: "" });
  row = row.append(chain).append(at);
  let block: ssa.SBlock = ssa.SBlock { ...b, insts: insts, term: branch_to(header) };
  return Splice { values: s.values.append(address()).append(f.result), blocks: s.blocks.append(block), backs: s.backs.append(b.id), rows: s.rows.append(row) };
}

function repointed(preds: i32[], from: i32, to: i32): i32[] {
  let out: i32[] = [];
  for p in preds {
    if (p == from) {
      out = out.append(to);
    } else {
      out = out.append(p);
    }
  }
  return out;
}

function kind_6(insts: ssa.SInst[]): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  for ins in insts {
    if (ins.kind_tag == 6) {
      out = out.append(ins);
    }
  }
  return out;
}

function not_kind_6(insts: ssa.SInst[]): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  for ins in insts {
    if (ins.kind_tag != 6) {
      out = out.append(ins);
    }
  }
  return out;
}

function rewritten(map: i32[], insts: ssa.SInst[]): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  for ins in insts {
    out = out.append(mapped_inst(map, ins));
  }
  return out;
}

function phis(map: i32[], firsts: i32[], rows: i32[][], nparams: i32, hole: i32, ch: Chain, name: string): ssa.SInst[] {
  let out: ssa.SInst[] = [];
  let p: i32 = 0;
  while (p < nparams) {
    out = out.append(ssa.SInst { ...phi_over(map[p], firsts[p], rows, p), imm: p, str: name });
    p = p + 1;
  }
  if (hole >= 0) {
    out = out.append(phi_over(ch.r, ch.r0, rows, nparams));
    out = out.append(phi_over(ch.h, ch.h0, rows, nparams + 1));
  }
  return out;
}

function phi_over(result: i32, first: i32, rows: i32[][], at: i32): ssa.SInst {
  let ops: i32[] = [first];
  for row in rows {
    ops = ops.append(row[at]);
  }
  return ssa.SInst { kind_tag: 8, result: result, args: ops, imm: 0, str: "" };
}

pub function no_source(): sourcepos.SourceInfo {
  return sourcepos.no_source();
}
