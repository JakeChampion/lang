pub struct Finalizer { receiver: string, symbol: string }

pub function finalizer_index(rows: Finalizer[], receiver: string): i32 {
  let i: i32 = 0;
  while (i < rows.len()) {
    if (rows[i].receiver == receiver) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub function finalizer_named(rows: Finalizer[], receiver: string): string {
  let i = finalizer_index(rows, receiver);
  if (i >= 0) {
    return rows[i].symbol;
  }
  return "";
}

pub struct Func {
  graph: ssa.SFunc,
  values: typeinfo.Type[],
  params: typeinfo.Type[],
  result: typeinfo.Type,
  records: semrecords.Records,
  enums: semrecords.Enum[],
  calls: Contract[],
  envs: EnvRow[],
  anchors: Anchor[],
  dyns: EnvRow[],
  shadows: string[],
  finalizers: Finalizer[],
  map_module: boolean,
  dbg_vals: i32[],
  dbg_names: string[],
  source_positions: sourcepos.SourceInfo,
}

pub struct Anchor { name: string, params: i32[] }

pub function has_finalizer(f: Func, t: typeinfo.Type): boolean {
  if let typeinfo.TypeStruct(r) = t {
    return finalizer_index(f.finalizers, r.name) >= 0;
  }
  if let typeinfo.TypeUnion(u) = t {
    return finalizer_index(f.finalizers, u.name) >= 0;
  }
  return false;
}

pub function finalizer_of(f: Func, t: typeinfo.Type): string {
  let n: string = "";
  if let typeinfo.TypeStruct(r) = t {
    n = r.name;
  }
  if let typeinfo.TypeUnion(u) = t {
    n = u.name;
  }
  if (n != "") {
    return finalizer_named(f.finalizers, n);
  }
  return "";
}

pub function anchored(anchors: Anchor[], name: string): boolean {
  for a in anchors {
    if (a.name == name) {
      return true;
    }
  }
  return false;
}

pub function anchor_params(anchors: Anchor[], name: string): i32[] {
  for a in anchors {
    if (a.name == name) {
      return a.params;
    }
  }
  return [];
}

pub struct EnvRow { fn_ty: typeinfo.Type, env_ty: typeinfo.Type }

pub struct Contract { name: string, params: typeinfo.Type[], modes: i32[], result: typeinfo.Type }

pub struct Contracts { list: Contract[], names: util.NameIndex, envs: Contract[] }

pub function contracts_of(list: Contract[]): Contracts {
  let names: string[] = [];
  let envs: Contract[] = [];
  for c in list {
    names = names.append(c.name);
    if (c.params.len() > 0 && semtypes.is_env(c.params[0])) {
      envs = envs.append(c);
    }
  }
  return Contracts { list: list, names: util.name_index(names), envs: envs };
}

pub function find_contract(table: Contracts, name: string): i32 {
  return table.names.find(name);
}

pub function find_contract_in(calls: Contract[], name: string): i32 {
  let i: i32 = 0;
  while (i < calls.len()) {
    if (calls[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

pub struct Analysis {
  ok: boolean,
  why: string,
  parents: i32[][],
  dependencies: i32[][],
  flow: ssalive.Flow,
  uses: Uses,
  anchored: Anchored,
}

pub struct Anchored { start: i32[], at: i32[] }

pub function anchored_of(deps: i32[][], nvals: i32): Anchored {
  let count: i32[] = __alloc_i32(nvals + 1);
  let known: i32 = deps.len();
  if (known > nvals) {
    known = nvals;
  }
  let w: i32 = 0;
  while (w < known) {
    for dep in deps[w] {
      if (dep >= 0 && dep < nvals) {
        count = count.with(dep, count[dep] + 1);
      }
    }
    w = w + 1;
  }
  let start: i32[] = __alloc_i32(nvals + 1);
  let total: i32 = 0;
  let v: i32 = 0;
  while (v < nvals) {
    total = total + count[v];
    start = start.with(v + 1, total);
    v = v + 1;
  }
  let at: i32[] = __alloc_i32(total);
  let fill: i32[] = start;
  w = 0;
  while (w < known) {
    for dep in deps[w] {
      if (dep >= 0 && dep < nvals) {
        at = at.with(fill[dep], w);
        fill = fill.with(dep, fill[dep] + 1);
      }
    }
    w = w + 1;
  }
  return Anchored { start: start, at: at };
}

pub struct Uses { start: i32[], kinds: i32[], block: i32[], at: i32[], slot: i32[] }

pub function term_use(): i32 {
  return 0 - 1000;
}

pub function use_count(u: Uses, v: i32): i32 {
  return u.start[v + 1] - u.start[v];
}

pub function uses_only(u: Uses, v: i32, allowed: i32[]): boolean {
  let i: i32 = u.start[v];
  while (i < u.start[v + 1]) {
    if (util.index_of_i32(allowed, u.kinds[i]) < 0) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

pub function read_after(u: Uses, bi: i32, pos: i32, v: i32): boolean {
  let i: i32 = first_use_in(u, v, bi);
  while (i < u.start[v + 1] && u.block[i] == bi) {
    if (u.at[i] > pos) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

pub function first_use_in(u: Uses, v: i32, bi: i32): i32 {
  let lo: i32 = u.start[v];
  let hi: i32 = u.start[v + 1];
  while (lo < hi) {
    let mid: i32 = lo + (hi - lo) / 2;
    if (u.block[mid] < bi) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo;
}

function uses_of(f: Func): Uses {
  let n: i32 = f.graph.nvals;
  let count: i32[] = __alloc_i32(n + 1);
  for b in f.graph.blocks {
    for ins in b.insts {
      for a in ins.args {
        if (a >= 0 && a < n) {
          count = count.with(a + 1, count[a + 1] + 1);
        }
      }
    }
    let t: i32 = term_operand(b.term);
    if (t >= 0 && t < n) {
      count = count.with(t + 1, count[t + 1] + 1);
    }
  }
  let v: i32 = 0;
  while (v < n) {
    count = count.with(v + 1, count[v + 1] + count[v]);
    v = v + 1;
  }
  let kinds: i32[] = __alloc_i32(count[n]);
  let block: i32[] = __alloc_i32(count[n]);
  let at: i32[] = __alloc_i32(count[n]);
  let slot: i32[] = __alloc_i32(count[n]);
  let next: i32[] = count;
  let bi: i32 = 0;
  for b in f.graph.blocks {
    let ii: i32 = 0;
    for ins in b.insts {
      let si: i32 = 0;
      for a in ins.args {
        if (a >= 0 && a < n) {
          let k: i32 = next[a];
          kinds = kinds.with(k, ins.kind_tag);
          block = block.with(k, bi);
          at = at.with(k, ii);
          slot = slot.with(k, si);
          next = next.with(a, k + 1);
        }
        si = si + 1;
      }
      ii = ii + 1;
    }
    let t: i32 = term_operand(b.term);
    if (t >= 0 && t < n) {
      let k: i32 = next[t];
      kinds = kinds.with(k, term_use());
      block = block.with(k, bi);
      at = at.with(k, ii);
      next = next.with(t, k + 1);
    }
    bi = bi + 1;
  }
  return Uses { start: count, kinds: kinds, block: block, at: at, slot: slot };
}

function term_operand(t: ssa.STerm): i32 {
  if (t.kind_tag == 1) {
    return t.value;
  }
  if (t.kind_tag == 3) {
    return t.cond;
  }
  return 0 - 1;
}

