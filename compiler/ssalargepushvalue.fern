// Checked arithmetic for one bounded recycling interval. Public values are
// mathematical data, never a decoded-program, machine-effect or ownership
// certificate. The true unsigned-64 oversized family is outside this domain.
import "./ssalargepushranges" as ranges;

pub struct Value { factor: i32, offset: i64 }

pub struct Comparison { less: i32, equal: i32, less_equal: i32 }

pub function unknown(): Value {
  return Value { factor: -1, offset: 0 as i64 };
}

function bounded(n: i64): boolean {
  return n >= -(4294967295 as i64) && n <= 4294967295 as i64;
}

function endpoint(v: Value, n: i32): i64 {
  return v.factor as i64 * (n as i64) + v.offset;
}

pub function valid(r: ranges.Interval, v: Value): boolean {
  if (!ranges.valid(r) || v.factor != 0 && v.factor != 1 || !bounded(v.offset)) {
    return false;
  }
  return bounded(endpoint(v, r.low)) && bounded(endpoint(v, r.high));
}

function checked(r: ranges.Interval, v: Value): Value {
  return if (valid(r, v)) { v } else { unknown() };
}

pub function number(r: ranges.Interval, n: i64): Value {
  return checked(r, Value { factor: 0, offset: n });
}

pub function original(r: ranges.Interval): Value {
  return checked(r, Value { factor: 1, offset: 0 as i64 });
}

// Addition is mathematical. The machine consumer still has to prove width,
// overflow, zero extension and flags for the particular instruction.
pub function add(r: ranges.Interval, v: Value, delta: i64): Value {
  if (!valid(r, v) || !bounded(delta)) {
    return unknown();
  }
  return checked(r, Value { factor: v.factor, offset: v.offset + delta });
}

pub function negate(r: ranges.Interval, v: Value): Value {
  return if (valid(r, v) && v.factor == 0) { number(r, -v.offset) } else { unknown() };
}

pub function zero32(r: ranges.Interval, v: Value): Value {
  if (!valid(r, v)) {
    return unknown();
  }
  if (endpoint(v, r.low) >= 0 as i64) {
    return v;
  }
  if (endpoint(v, r.high) < 0 as i64) {
    return checked(r, Value { factor: v.factor, offset: v.offset + 4294967296 as i64 });
  }
  return unknown();
}

pub function power(bit: i32): i64 {
  if (bit < 0 || bit > 31) {
    return 0 as i64;
  }
  let result = 1 as i64;
  let at = 0;
  while (at < bit) {
    result = result * (2 as i64);
    at = at + 1;
  }
  return result;
}

function highest(n: i64): i32 {
  let rest = n;
  let bit = -1;
  while (rest > 0 as i64) {
    rest = rest / (2 as i64);
    bit = bit + 1;
  }
  return bit;
}

pub function bit_scan(r: ranges.Interval, v: Value): i32 {
  if (!valid(r, v) || endpoint(v, r.low) <= 0 as i64) {
    return -1;
  }
  let bit = highest(endpoint(v, r.low));
  return if (bit == highest(endpoint(v, r.high))) { bit } else { -1 };
}

// AND with exactly -2^k clears low bits of a nonnegative operand. Equal
// endpoint quotients prove a constant result throughout the whole interval.
pub function mask(r: ranges.Interval, v: Value, m: Value): Value {
  if (!valid(r, v) || !valid(r, m) || m.factor != 0 || m.offset >= 0 as i64) {
    return unknown();
  }
  let step = -m.offset;
  if (power(highest(step)) != step || endpoint(v, r.low) < 0 as i64) {
    return unknown();
  }
  let low = endpoint(v, r.low) / step;
  let high = endpoint(v, r.high) / step;
  return if (low == high) { number(r, low * step) } else { unknown() };
}

function truth(always: boolean, never: boolean): i32 {
  return if (always) { 1 } else { if (never) { 0 } else { -1 } };
}

// These are correlated mathematical comparisons, not x86 signed/unsigned
// flags. A consumer must establish the instruction interpretation separately.
pub function compare(r: ranges.Interval, v: Value, n: i64): Comparison {
  if (!valid(r, v) || !bounded(n)) {
    return Comparison { less: -1, equal: -1, less_equal: -1 };
  }
  let low = endpoint(v, r.low);
  let high = endpoint(v, r.high);
  return Comparison { less: truth(high < n, low >= n), equal: truth(low == n && high == n, n < low || n > high), less_equal: truth(high <= n, low > n) };
}
