// examples/proposals/tombstone_store.fern — proposal turn, drawn line 233:
// "A tombstone-based delete with a garbage-collection pass."
//
// A key/value store where `del` does not remove a slot, it marks it dead.
// Reads skip tombstones; a separate `compact` pass rebuilds the slot array
// without them and reports what it reclaimed. That is the shape every
// log-structured store has, and the reason to write it here is that the
// compaction pass is an allocation churn loop — exactly where a stray
// retain turns linear work quadratic.
//
// The app writes its report to stderr; stdout carries TAP-13 from
// std/test, so the file is its own test suite.

import "std/test";
import "std/i32";
import "std/i64";

struct Slot { key: string, val: string, live: boolean }

struct Store { slots: Slot[], live: i32, dead: i32 }

function store_new(): Store {
    return Store { slots: [], live: 0, dead: 0 };
}

// Index of the LIVE slot holding `k`, or -1. Tombstones are skipped, so a
// deleted key reads as absent even though its slot is still there.
function find_live(s: Store, k: string): i32 {
    var i: i32 = 0;
    while (i < s.slots.len()) {
        if (s.slots[i].live && s.slots[i].key == k) { return i; }
        i = i + 1;
    }
    return -1;
}

function get(s: Store, k: string): Option[string] {
    var at: i32 = find_live(s, k);
    if (at < 0) { return None; }
    return Some(s.slots[at].val);
}

function has(s: Store, k: string): boolean {
    return find_live(s, k) >= 0;
}

// put overwrites a live slot in place, otherwise appends. It never reuses a
// tombstone: that is compaction's job, and keeping the two apart is what
// makes the reclaim count meaningful.
function put(s: Store, k: string, v: string): Store {
    var at: i32 = find_live(s, k);
    if (at >= 0) {
        var updated: Slot[] = [];
        var i: i32 = 0;
        while (i < s.slots.len()) {
            if (i == at) {
                updated = updated.append(Slot { key: k, val: v, live: true });
            } else {
                updated = updated.append(s.slots[i]);
            }
            i = i + 1;
        }
        return Store { slots: updated, live: s.live, dead: s.dead };
    }
    return Store {
        slots: s.slots.append(Slot { key: k, val: v, live: true }),
        live: s.live + 1,
        dead: s.dead,
    };
}

// del marks the slot dead and leaves it in place. Returns the store and
// whether anything was actually deleted, so a caller can tell a real delete
// from a no-op on a missing key.
function del(s: Store, k: string): (Store, boolean) {
    var at: i32 = find_live(s, k);
    if (at < 0) { return (s, false); }
    var updated: Slot[] = [];
    var i: i32 = 0;
    while (i < s.slots.len()) {
        if (i == at) {
            updated = updated.append(Slot {
                key: s.slots[i].key,
                val: s.slots[i].val,
                live: false,
            });
        } else {
            updated = updated.append(s.slots[i]);
        }
        i = i + 1;
    }
    return (Store { slots: updated, live: s.live - 1, dead: s.dead + 1 }, true);
}

// The garbage-collection pass: rebuild the slot array keeping only live
// entries, in their original relative order. Returns the compacted store and
// how many tombstones it dropped.
function compact(s: Store): (Store, i32) {
    var kept: Slot[] = [];
    var i: i32 = 0;
    while (i < s.slots.len()) {
        if (s.slots[i].live) { kept = kept.append(s.slots[i]); }
        i = i + 1;
    }
    var reclaimed: i32 = s.slots.len() - kept.len();
    return (Store { slots: kept, live: kept.len(), dead: 0 }, reclaimed);
}

function live_keys(s: Store): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < s.slots.len()) {
        if (s.slots[i].live) { out = out.append(s.slots[i].key); }
        i = i + 1;
    }
    return out;
}

// ---------------------------------------------------------------- tests

function seeded(): Store {
    var s: Store = store_new();
    s = put(s, "alpha", "1");
    s = put(s, "beta", "2");
    s = put(s, "gamma", "3");
    s = put(s, "delta", "4");
    return s;
}

// A tombstone hides the key from reads but does NOT shrink the backing
// array — that distinction is the whole point of the design, so it is worth
// asserting directly rather than inferring from a later compaction.
function test_delete_tombstones_rather_than_removes(): test.TestOutcome {
    var s: Store = seeded();
    var slots_before: i32 = s.slots.len();
    var (s2, removed) = del(s, "beta");
    if (!removed) { return test.fail("del reported no-op on a present key"); }
    if (has(s2, "beta")) { return test.fail("deleted key still reads live"); }
    if (s2.slots.len() != slots_before) {
        return test.fail("del shrank the slot array: " + slots_before.to_string()
            + " -> " + s2.slots.len().to_string());
    }
    if (s2.dead != 1) {
        return test.fail("wanted 1 tombstone, got " + s2.dead.to_string());
    }
    if (s2.live != 3) {
        return test.fail("wanted 3 live, got " + s2.live.to_string());
    }
    return test.pass();
}

// Deleting an absent key must not fabricate a tombstone.
function test_delete_missing_is_a_noop(): test.TestOutcome {
    var s: Store = seeded();
    var (s2, removed) = del(s, "nope");
    if (removed) { return test.fail("del reported a delete on a missing key"); }
    if (s2.dead != 0 || s2.live != 4 || s2.slots.len() != 4) {
        return test.fail("no-op del changed the store");
    }
    return test.pass();
}

// The property that makes compaction safe: it is invisible to readers. Every
// live key maps to the same value before and after, and nothing else appears.
function test_compaction_preserves_the_live_mapping(): test.TestOutcome {
    var s: Store = seeded();
    var (s1, _) = del(s, "alpha");
    var (s2, _) = del(s1, "gamma");
    var before: string[] = live_keys(s2);

    var (c, reclaimed) = compact(s2);
    if (reclaimed != 2) {
        return test.fail("wanted 2 reclaimed, got " + reclaimed.to_string());
    }
    var after: string[] = live_keys(c);
    if (after.len() != before.len()) {
        return test.fail("live key count changed across compaction: "
            + before.len().to_string() + " -> " + after.len().to_string());
    }
    var i: i32 = 0;
    while (i < before.len()) {
        if (before[i] != after[i]) {
            return test.fail("compaction reordered live keys at " + i.to_string()
                + ": " + before[i] + " != " + after[i]);
        }
        match (get(s2, before[i])) {
            None => { return test.fail("live key vanished before compaction"); },
            Some(v0) => {
                match (get(c, after[i])) {
                    None => { return test.fail("live key vanished after compaction"); },
                    Some(v1) => {
                        if (v0 != v1) {
                            return test.fail("value changed across compaction for "
                                + before[i] + ": " + v0 + " != " + v1);
                        }
                    },
                }
            },
        }
        i = i + 1;
    }
    if (c.dead != 0) {
        return test.fail("compaction left " + c.dead.to_string() + " tombstones");
    }
    return test.pass();
}

// Compacting twice must be the same as compacting once — a GC pass with no
// garbage to collect has to be a no-op, or repeated maintenance drifts.
function test_compaction_is_idempotent(): test.TestOutcome {
    var s: Store = seeded();
    var (s1, _) = del(s, "beta");
    var (c1, first) = compact(s1);
    var (c2, second) = compact(c1);
    if (first != 1) {
        return test.fail("first compaction wanted 1, got " + first.to_string());
    }
    if (second != 0) {
        return test.fail("second compaction reclaimed " + second.to_string()
            + ", so compaction is not idempotent");
    }
    if (c2.slots.len() != c1.slots.len() || c2.live != c1.live) {
        return test.fail("second compaction changed the store");
    }
    return test.pass();
}

// A tombstone must not resurrect. Re-putting a deleted key gives the NEW
// value, and compaction afterwards must not surface the old one.
function test_reinsert_after_delete_does_not_resurrect(): test.TestOutcome {
    var s: Store = seeded();
    var (s1, _) = del(s, "beta");
    var s2: Store = put(s1, "beta", "22");
    match (get(s2, "beta")) {
        None => { return test.fail("re-inserted key reads absent"); },
        Some(v) => {
            if (v != "22") { return test.fail("wanted 22, got " + v); }
        },
    }
    var (c, _) = compact(s2);
    match (get(c, "beta")) {
        None => { return test.fail("re-inserted key lost by compaction"); },
        Some(v) => {
            if (v != "22") {
                return test.fail("compaction resurrected the old value: " + v);
            }
        },
    }
    var ks: string[] = live_keys(c);
    var seen: i32 = 0;
    var i: i32 = 0;
    while (i < ks.len()) {
        if (ks[i] == "beta") { seen = seen + 1; }
        i = i + 1;
    }
    if (seen != 1) {
        return test.fail("wanted exactly one live beta, saw " + seen.to_string());
    }
    return test.pass();
}

// The counters have to agree with the array they describe, under churn --
// a store whose `live` field disagrees with its live slots is how a
// compaction bug hides.
function test_counters_track_the_slots_under_churn(): test.TestOutcome {
    var s: Store = store_new();
    var round: i32 = 0;
    while (round < 40) {
        s = put(s, "k" + round.to_string(), "v" + round.to_string());
        if (round % 3 == 0) {
            var (s2, _) = del(s, "k" + (round / 2).to_string());
            s = s2;
        }
        round = round + 1;
    }
    var counted_live: i32 = live_keys(s).len();
    if (s.live != counted_live) {
        return test.fail("live counter " + s.live.to_string()
            + " disagrees with " + counted_live.to_string() + " live slots");
    }
    if (s.live + s.dead != s.slots.len()) {
        return test.fail("live " + s.live.to_string() + " + dead "
            + s.dead.to_string() + " != " + s.slots.len().to_string() + " slots");
    }
    var (c, reclaimed) = compact(s);
    if (reclaimed != s.dead) {
        return test.fail("reclaimed " + reclaimed.to_string()
            + " but held " + s.dead.to_string() + " tombstones");
    }
    if (c.slots.len() != counted_live) {
        return test.fail("compacted to " + c.slots.len().to_string()
            + " slots, wanted " + counted_live.to_string());
    }
    return test.pass();
}

// ----------------------------------------------------------------- app

// One churn round: fill to `n`, delete every other key, compact.
function churn(n: i32): i32 {
    var s: Store = store_new();
    var i: i32 = 0;
    while (i < n) {
        s = put(s, "k" + i.to_string(), "v" + i.to_string());
        i = i + 1;
    }
    var j: i32 = 0;
    while (j < n) {
        var (s2, _) = del(s, "k" + j.to_string());
        s = s2;
        j = j + 2;
    }
    var (c, reclaimed) = compact(s);
    return c.slots.len() + reclaimed;
}

function main(): i32 {
    eprint("tombstone_store — tombstoned delete + a compaction pass");

    var s: Store = seeded();
    var (s1, _) = del(s, "beta");
    eprint("after one delete: " + s1.live.to_string() + " live, "
        + s1.dead.to_string() + " dead, " + s1.slots.len().to_string() + " slots");
    var (c, reclaimed) = compact(s1);
    eprint("after compaction: " + c.live.to_string() + " live, "
        + c.dead.to_string() + " dead, " + reclaimed.to_string() + " reclaimed");

    // Allocation shape of the churn loop, at n and 2n. The bump allocator's
    // high-water mark is the host-independent measure; RSS is not comparable
    // across THP settings.
    var base: i64 = __heap_bump_bytes();
    var a: i32 = churn(64);
    var after_n: i64 = __heap_bump_bytes();
    var b: i32 = churn(128);
    var after_2n: i64 = __heap_bump_bytes();
    eprint("churn(64)  total=" + a.to_string()
        + " bump=" + (after_n - base).to_string());
    eprint("churn(128) total=" + b.to_string()
        + " bump=" + (after_2n - after_n).to_string());

    var r: test.TestRunner = test.test_new("tombstone_store");
    r = r.it("delete tombstones rather than removes", test_delete_tombstones_rather_than_removes);
    r = r.it("delete of a missing key is a no-op", test_delete_missing_is_a_noop);
    r = r.it("compaction preserves the live mapping", test_compaction_preserves_the_live_mapping);
    r = r.it("compaction is idempotent", test_compaction_is_idempotent);
    r = r.it("reinsert after delete does not resurrect", test_reinsert_after_delete_does_not_resurrect);
    r = r.it("counters track the slots under churn", test_counters_track_the_slots_under_churn);
    return r.finish();
}
