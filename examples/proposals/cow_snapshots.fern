// examples/proposals/cow_snapshots.fern — proposal turn, drawn line 231:
// "A copy-on-write map that shares structure between snapshots."
//
// A persistent map built as a chain of overlays: each snapshot stores only
// the keys IT changed and a link to the one it was taken from, so taking a
// snapshot is O(1) and costs no copying. Reads walk the chain to the nearest
// definition; a deletion is a tombstone in the child that hides a key the
// parent still has.
//
// Structure sharing is the app's whole claim, so it gets a test that can
// disprove it rather than a comment that asserts it: N snapshots over a base
// of M keys, each adding one key, must store M + N entries in total. An
// implementation that copies the base on every snapshot passes every
// correctness test here and fails that one at N*M.
//
// (`tombstone_store` from an earlier turn is a flat slot array with a
// compaction pass; this is the versioned-overlay shape, where the point is
// what the snapshots share rather than what compaction reclaims.)
//
// The app writes its report to stderr; stdout carries TAP-13 from
// std/test, so the file is its own test suite.

import "std/test";
import "core/map";
import "std/i32";

// One overlay. `writes` holds the keys this layer defines; `deletes` holds
// the keys it hides from its parent. `parent` is an index into the store's
// layer array, or -1 for the root.
struct Layer {
    writes: Map[string, i32],
    deletes: string[],
    parent: i32,
}

// Every layer ever created, in creation order. A snapshot is an index into
// this array — that is what makes taking one O(1) and what makes the sharing
// measurable.
struct Store { layers: Layer[] }

function store_new(): Store {
    return Store { layers: [Layer { writes: Map { }, deletes: [], parent: -1 }] };
}

function root(): i32 { return 0; }

// A snapshot is a fresh empty layer over `at`. No copying: the new layer
// starts with nothing of its own.
function snapshot(s: Store, at: i32): (Store, i32) {
    var l: Layer = Layer { writes: Map { }, deletes: [], parent: at };
    var next: Store = Store { layers: s.layers.append(l) };
    return (next, next.layers.len() - 1);
}

function has_str(xs: string[], k: string): boolean {
    for i in 0..xs.len() { if (xs[i] == k) { return true; } }
    return false;
}

// Write into layer `at`, in place. A write to a layer hides any parent
// definition and clears a tombstone the same layer may have had.
function put(s: Store, at: i32, k: string, v: i32): Store {
    var l: Layer = s.layers[at];
    var d: string[] = [];
    for i in 0..l.deletes.len() {
        if (l.deletes[i] != k) { d = d.append(l.deletes[i]); }
    }
    var updated: Layer = Layer { ...l, writes: l.writes.insert(k, v), deletes: d };
    return Store { ...s, layers: s.layers.with(at, updated) };
}

// Delete in layer `at`: a tombstone, plus dropping any write this layer had.
// The parent keeps its own definition — that is the property `del` is for.
function del(s: Store, at: i32, k: string): Store {
    var l: Layer = s.layers[at];
    var w: Map[string, i32] = Map { };
    var ks: string[] = l.writes.keys();
    for i in 0..ks.len() {
        if (ks[i] != k) { w = w.insert(ks[i], l.writes.get_or(ks[i], 0)); }
    }
    var d: string[] = l.deletes;
    if (!has_str(d, k)) { d = d.append(k); }
    return Store { ...s, layers: s.layers.with(at, Layer { ...l, writes: w, deletes: d }) };
}

// Walk to the nearest definition. A tombstone stops the walk with None —
// stopping is the whole point, since the parent may still define the key.
function get(s: Store, at: i32, k: string): Option[i32] {
    var cur: i32 = at;
    while (cur >= 0) {
        var l: Layer = s.layers[cur];
        if (has_str(l.deletes, k)) { return None; }
        if (l.writes.has(k)) { return Some(l.writes.get_or(k, 0)); }
        cur = l.parent;
    }
    return None;
}

function get_or(s: Store, at: i32, k: string, fallback: i32): i32 {
    match (get(s, at, k)) {
        Some(v) => { return v; },
        None => { return fallback; },
    }
}

// Every key visible from `at`, each once. Collected root-first so a child's
// tombstone is applied after the parent's write.
function visible_keys(s: Store, at: i32): string[] {
    var chain: i32[] = [];
    var cur: i32 = at;
    while (cur >= 0) { chain = chain.append(cur); cur = s.layers[cur].parent; }
    var out: string[] = [];
    var i: i32 = chain.len() - 1;
    while (i >= 0) {
        var l: Layer = s.layers[chain[i]];
        var ks: string[] = l.writes.keys();
        for j in 0..ks.len() { if (!has_str(out, ks[j])) { out = out.append(ks[j]); } }
        var kept: string[] = [];
        for j in 0..out.len() {
            if (!has_str(l.deletes, out[j])) { kept = kept.append(out[j]); }
        }
        out = kept;
        i = i - 1;
    }
    return out;
}

// Flatten a chain into one layer. The result must answer every lookup the
// chain did — that equivalence is what makes compaction safe to do.
function flatten(s: Store, at: i32): Store {
    var ks: string[] = visible_keys(s, at);
    var w: Map[string, i32] = Map { };
    for i in 0..ks.len() { w = w.insert(ks[i], get_or(s, at, ks[i], 0)); }
    return Store { layers: [Layer { writes: w, deletes: [], parent: -1 }] };
}

// Total entries the store holds, across every layer. This is the number the
// sharing claim is about: it counts what was STORED, not what is reachable.
function stored_entries(s: Store): i32 {
    var n: i32 = 0;
    for i in 0..s.layers.len() {
        n = n + s.layers[i].writes.len() + s.layers[i].deletes.len();
    }
    return n;
}

// ---------------------------------------------------------------- tests

// THE property. A write to a snapshot must be invisible to every older one,
// and to every sibling. Nothing about copy-on-write is interesting if this
// does not hold.
function test_a_write_is_invisible_to_older_snapshots(): test.TestOutcome {
    var s: Store = store_new();
    s = put(s, root(), "a", 1);
    s = put(s, root(), "b", 2);

    var t: (Store, i32) = snapshot(s, root());
    s = t.0;
    var v1: i32 = t.1;
    s = put(s, v1, "a", 100);
    s = put(s, v1, "c", 3);

    var t2: (Store, i32) = snapshot(s, root());
    s = t2.0;
    var v2: i32 = t2.1;
    s = put(s, v2, "a", 200);

    if (get_or(s, root(), "a", -1) != 1) {
        return test.fail("the root's `a` changed to "
            + get_or(s, root(), "a", -1).to_string());
    }
    if (get_or(s, v1, "a", -1) != 100) { return test.fail("v1 lost its own write"); }
    if (get_or(s, v2, "a", -1) != 200) { return test.fail("v2 lost its own write"); }
    // Siblings do not see each other.
    if (get_or(s, v2, "c", -1) != -1) {
        return test.fail("v2 sees v1's key `c`");
    }
    if (get_or(s, root(), "c", -1) != -1) { return test.fail("the root sees `c`"); }
    // Inherited keys still read through.
    if (get_or(s, v1, "b", -1) != 2 || get_or(s, v2, "b", -1) != 2) {
        return test.fail("an inherited key did not read through");
    }
    return test.pass();
}

// The claim in the app's name, as a number. A base of M keys and N snapshots
// each adding one key must STORE M + N entries. A copying implementation
// stores N*M and passes everything else here.
function test_snapshots_share_the_base(): test.TestOutcome {
    var bases: i32[] = [4, 16, 64];
    var counts: i32[] = [4, 16, 64];
    for b in 0..bases.len() {
        var m: i32 = bases[b];
        var n: i32 = counts[b];
        var s: Store = store_new();
        for i in 0..m { s = put(s, root(), "base" + i.to_string(), i); }
        var at: i32 = root();
        for i in 0..n {
            var t: (Store, i32) = snapshot(s, at);
            s = t.0;
            at = t.1;
            s = put(s, at, "own" + i.to_string(), 1000 + i);
        }
        var want: i32 = m + n;
        var got: i32 = stored_entries(s);
        if (got != want) {
            return test.fail("base " + m.to_string() + " + " + n.to_string()
                + " snapshots stored " + got.to_string() + " entries, wanted "
                + want.to_string() + " — the base is being copied");
        }
        // …and the deepest snapshot still sees everything.
        if (visible_keys(s, at).len() != m + n) {
            return test.fail("the deepest snapshot sees "
                + visible_keys(s, at).len().to_string() + " keys, wanted "
                + (m + n).to_string());
        }
    }
    return test.pass();
}

// A deletion hides a key in the child and leaves the parent alone. Then
// writing it again in the child brings it back with the new value — the
// tombstone must not be permanent.
function test_a_deletion_is_local_to_its_layer(): test.TestOutcome {
    var s: Store = store_new();
    s = put(s, root(), "k", 7);
    var t: (Store, i32) = snapshot(s, root());
    s = t.0;
    var child: i32 = t.1;

    s = del(s, child, "k");
    if (get_or(s, child, "k", -1) != -1) { return test.fail("the child still sees `k`"); }
    if (get_or(s, root(), "k", -1) != 7) { return test.fail("the parent lost `k`"); }
    if (has_str(visible_keys(s, child), "k")) {
        return test.fail("`k` is still in the child's visible keys");
    }

    s = put(s, child, "k", 9);
    if (get_or(s, child, "k", -1) != 9) { return test.fail("`k` did not come back"); }
    if (get_or(s, root(), "k", -1) != 7) { return test.fail("the parent changed"); }
    if (!has_str(visible_keys(s, child), "k")) {
        return test.fail("`k` did not return to the visible keys");
    }

    // Deleting a key nobody defines is not an error, and does not invent one.
    s = del(s, child, "absent");
    if (get_or(s, child, "absent", -1) != -1) {
        return test.fail("deleting an absent key defined it");
    }
    return test.pass();
}

// Flattening a chain must answer every lookup the chain did, for every key
// anyone ever wrote — including the ones that are correctly absent.
function test_flattening_preserves_every_answer(): test.TestOutcome {
    var s: Store = store_new();
    var all: string[] = [];
    for i in 0..12 {
        var k: string = "k" + i.to_string();
        all = all.append(k);
        s = put(s, root(), k, i);
    }
    var at: i32 = root();
    for round in 0..5 {
        var t: (Store, i32) = snapshot(s, at);
        s = t.0;
        at = t.1;
        s = put(s, at, "k" + round.to_string(), 100 + round);
        s = del(s, at, "k" + (round + 6).to_string());
        var extra: string = "extra" + round.to_string();
        all = all.append(extra);
        s = put(s, at, extra, 500 + round);
    }
    var f: Store = flatten(s, at);
    for i in 0..all.len() {
        var a: i32 = get_or(s, at, all[i], -999);
        var b: i32 = get_or(f, root(), all[i], -999);
        if (a != b) {
            return test.fail("key " + all[i] + ": the chain says " + a.to_string()
                + " but the flattened store says " + b.to_string());
        }
    }
    if (visible_keys(f, root()).len() != visible_keys(s, at).len()) {
        return test.fail("flattening changed the visible key count");
    }
    return test.pass();
}

// Visible keys are exactly the keys that read as present — no key listed
// that reads absent, and no key absent from the list that reads present.
function test_visible_keys_agree_with_lookup(): test.TestOutcome {
    var s: Store = store_new();
    var candidates: string[] = [];
    for i in 0..10 {
        var k: string = "c" + i.to_string();
        candidates = candidates.append(k);
        s = put(s, root(), k, i);
    }
    candidates = candidates.append("never_written");
    var t: (Store, i32) = snapshot(s, root());
    s = t.0;
    var child: i32 = t.1;
    s = del(s, child, "c3");
    s = del(s, child, "c7");
    s = put(s, child, "c9", 99);

    var ks: string[] = visible_keys(s, child);
    for i in 0..ks.len() {
        if (get_or(s, child, ks[i], -1) == -1) {
            return test.fail("listed key " + ks[i] + " reads as absent");
        }
    }
    for i in 0..candidates.len() {
        var present: boolean = get_or(s, child, candidates[i], -1) != -1;
        if (present != has_str(ks, candidates[i])) {
            return test.fail("key " + candidates[i] + ": lookup says "
                + bool_str(present) + " but the key list says "
                + bool_str(has_str(ks, candidates[i])));
        }
    }
    // No duplicates.
    for i in 0..ks.len() {
        for j in (i + 1)..ks.len() {
            if (ks[i] == ks[j]) {
                return test.fail("key " + ks[i] + " is listed twice");
            }
        }
    }
    return test.pass();
}

function bool_str(b: boolean): string {
    if (b) { return "present"; }
    return "absent";
}

// A chain of snapshots with no writes reads exactly like its base, however
// long it is — the empty overlay must be transparent.
function test_empty_overlays_are_transparent(): test.TestOutcome {
    var s: Store = store_new();
    for i in 0..6 { s = put(s, root(), "b" + i.to_string(), i); }
    var at: i32 = root();
    for i in 0..40 {
        var t: (Store, i32) = snapshot(s, at);
        s = t.0;
        at = t.1;
    }
    for i in 0..6 {
        if (get_or(s, at, "b" + i.to_string(), -1) != i) {
            return test.fail("a 40-deep empty chain lost key b" + i.to_string());
        }
    }
    if (visible_keys(s, at).len() != 6) {
        return test.fail("the empty chain changed the visible key count");
    }
    if (stored_entries(s) != 6) {
        return test.fail("40 empty snapshots stored "
            + stored_entries(s).to_string() + " entries, wanted 6");
    }
    return test.pass();
}

// Branching: two snapshots taken from the same parent evolve independently,
// and neither disturbs the parent. This is the shape a version-control
// history has, and the one where a shared mutable base shows immediately.
function test_branches_do_not_interfere(): test.TestOutcome {
    var s: Store = store_new();
    s = put(s, root(), "shared", 0);
    var ta: (Store, i32) = snapshot(s, root());
    s = ta.0;
    var a: i32 = ta.1;
    var tb: (Store, i32) = snapshot(s, root());
    s = tb.0;
    var b: i32 = tb.1;

    for i in 0..20 {
        s = put(s, a, "shared", i);
        s = put(s, b, "shared", 1000 - i);
        s = put(s, a, "only_a" + i.to_string(), i);
        s = put(s, b, "only_b" + i.to_string(), i);
    }
    if (get_or(s, root(), "shared", -1) != 0) {
        return test.fail("the parent's `shared` moved to "
            + get_or(s, root(), "shared", -1).to_string());
    }
    if (get_or(s, a, "shared", -1) != 19) { return test.fail("branch a is wrong"); }
    if (get_or(s, b, "shared", -1) != 981) { return test.fail("branch b is wrong"); }
    for i in 0..20 {
        if (get_or(s, a, "only_b" + i.to_string(), -1) != -1) {
            return test.fail("branch a sees branch b's key");
        }
        if (get_or(s, b, "only_a" + i.to_string(), -1) != -1) {
            return test.fail("branch b sees branch a's key");
        }
    }
    return test.pass();
}

// ------------------------------------------------------------------ app

function main(): i32 {
    eprint("cow_snapshots — a persistent map as a chain of overlays");
    var s: Store = store_new();
    for i in 0..8 { s = put(s, root(), "base" + i.to_string(), i); }
    eprint("  base: 8 keys, " + stored_entries(s).to_string() + " entries stored");

    var at: i32 = root();
    for i in 0..8 {
        var t: (Store, i32) = snapshot(s, at);
        s = t.0;
        at = t.1;
        s = put(s, at, "v" + i.to_string(), 100 + i);
    }
    eprint("  after 8 snapshots each adding one key: "
        + stored_entries(s).to_string() + " entries stored, "
        + visible_keys(s, at).len().to_string() + " keys visible");
    eprint("  (a copying implementation would store "
        + (8 * 8 + 8).to_string() + ")");

    s = del(s, at, "base0");
    eprint("  after deleting base0 in the newest snapshot: base0 reads "
        + get_or(s, at, "base0", -1).to_string() + " there and "
        + get_or(s, root(), "base0", -1).to_string() + " at the root");

    var f: Store = flatten(s, at);
    eprint("  flattened: " + stored_entries(f).to_string() + " entries in "
        + f.layers.len().to_string() + " layer");

    var r: test.TestRunner = test.test_new("cow_snapshots");
    r = r.it("a write is invisible to older snapshots", test_a_write_is_invisible_to_older_snapshots);
    r = r.it("snapshots share the base", test_snapshots_share_the_base);
    r = r.it("a deletion is local to its layer", test_a_deletion_is_local_to_its_layer);
    r = r.it("flattening preserves every answer", test_flattening_preserves_every_answer);
    r = r.it("visible keys agree with lookup", test_visible_keys_agree_with_lookup);
    r = r.it("empty overlays are transparent", test_empty_overlays_are_transparent);
    r = r.it("branches do not interfere", test_branches_do_not_interfere);
    return r.finish();
}
