// examples/proposals/mm1_queue.fern — proposal turn, drawn line 112:
// "A queueing simulation (M/M/1) reporting average wait time against
// arrival rate."
//
// A single-server FIFO queue driven by a discrete event list. The oracle
// is queueing theory itself: for M/M/1 with utilisation rho = lambda/mu,
// the mean number in system is rho/(1-rho) and mean wait grows without
// bound as rho approaches 1. That closed form is what
// `test_wait_grows_with_utilisation` and `test_littles_law_holds` check
// against — a simulation that was wrong but self-consistent would pass
// everything else here.
//
// Times are in integer ticks; exponential inter-arrival and service
// times come from a deterministic xorshift, so every backend sees the
// same event stream.
//
// The app writes its report to stderr; stdout carries TAP-13 from
// std/test, so the file is its own test suite.

import "std/test";
import "std/i32";
import "std/i64";

struct Stats {
    served: i32,
    total_wait: i32,     // time spent queued, summed over customers
    total_system: i32,   // wait + service, summed
    busy_ticks: i32,
    horizon: i32,
}

function mean_wait(s: Stats): i32 {
    if (s.served == 0) { return 0; }
    return s.total_wait / s.served;
}

// Utilisation in per-mille: the fraction of the horizon the server was busy.
function utilisation_permille(s: Stats): i32 {
    if (s.horizon == 0) { return 0; }
    return s.busy_ticks * 1000 / s.horizon;
}

function xs_next(s: i64): i64 {
    var x: i64 = s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    return x;
}

function xs_below(s: i64, m: i32): i32 {
    var v: i64 = s;
    if (v < 0) { v = 0 - v; }
    return (v % (m as i64)) as i32;
}

// A crude exponential: mean `m` ticks, floored at 1 so time always
// advances and the event loop cannot stall.
function exp_ticks(s: i64, m: i32): i32 {
    var u: i32 = xs_below(s, 1000) + 1;      // 1..1000
    var t: i32 = m * 1000 / u;               // heavy tail as u -> 1
    if (t < 1) { t = 1; }
    if (t > m * 8) { t = m * 8; }            // truncate the tail
    return t;
}

// Serve `n` customers. mean_gap is the mean inter-arrival time and
// mean_svc the mean service time; utilisation rises as mean_gap falls
// toward mean_svc.
function simulate(n: i32, mean_gap: i32, mean_svc: i32, seed: i64): Stats {
    var s: i64 = seed;
    var clock: i32 = 0;          // arrival time of the newest customer
    var free_at: i32 = 0;        // when the server next becomes idle
    var total_wait: i32 = 0;
    var total_system: i32 = 0;
    var busy: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        s = xs_next(s);
        clock = clock + exp_ticks(s, mean_gap);

        // FIFO: a customer waits until the server is free, if it is not.
        var start: i32 = clock;
        if (free_at > start) { start = free_at; }
        var wait: i32 = start - clock;

        s = xs_next(s);
        var svc: i32 = exp_ticks(s, mean_svc);
        free_at = start + svc;

        total_wait = total_wait + wait;
        total_system = total_system + wait + svc;
        busy = busy + svc;
        i = i + 1;
    }
    var horizon: i32 = free_at;
    if (horizon < clock) { horizon = clock; }
    return Stats { served: n, total_wait: total_wait, total_system: total_system,
                   busy_ticks: busy, horizon: horizon };
}

// ---------------------------------------------------------------- tests

// A server that is never busy makes nobody wait: with arrivals far apart
// relative to service, the queue is empty on arrival every time.
function test_a_light_load_never_queues(): test.TestOutcome {
    var st: Stats = simulate(200, 400, 10, 4242);
    if (mean_wait(st) != 0) {
        return test.fail("light load produced a mean wait of "
            + mean_wait(st).to_string() + " ticks");
    }
    if (utilisation_permille(st) > 200) {
        return test.fail("light load reported utilisation "
            + utilisation_permille(st).to_string() + "/1000");
    }
    return test.pass();
}

// THE oracle. Mean wait must rise monotonically as arrivals get closer
// together — that is the shape of rho/(1-rho), and it is the one thing a
// self-consistent-but-wrong simulation would not reproduce.
function test_wait_grows_with_utilisation(): test.TestOutcome {
    var gaps: i32[] = [200, 100, 50, 30, 22, 18];   // falling gap = rising load
    var prev_wait: i32 = -1;
    var prev_util: i32 = -1;
    for i in 0..gaps.len() {
        var st: Stats = simulate(400, gaps[i], 16, 20260807);
        var w: i32 = mean_wait(st);
        var u: i32 = utilisation_permille(st);
        if (u < prev_util) {
            return test.fail("utilisation fell from " + prev_util.to_string()
                + " to " + u.to_string() + " as arrivals got closer");
        }
        if (w < prev_wait) {
            return test.fail("mean wait fell from " + prev_wait.to_string()
                + " to " + w.to_string() + " as load rose");
        }
        prev_wait = w;
        prev_util = u;
    }
    if (prev_wait <= 0) {
        return test.fail("even the heaviest load produced no waiting");
    }
    return test.pass();
}

// Little's law: L = lambda * W. Here, total time in system summed over
// customers, divided by the horizon, is the mean number in system — and
// it must equal arrivals-per-tick times mean time in system. Both sides
// are computed from the same run but by different routes.
function test_littles_law_holds(): test.TestOutcome {
    var st: Stats = simulate(500, 40, 25, 99991);
    if (st.horizon == 0) { return test.fail("zero horizon"); }
    // L, in per-mille of a customer.
    var l_side: i32 = st.total_system * 1000 / st.horizon;
    // lambda * W, same units: (served / horizon) * (total_system / served).
    var w_side: i32 = st.served * 1000 / st.horizon * (st.total_system / st.served);
    // The second form loses precision to integer division, so compare
    // within a generous band rather than exactly.
    var lo: i32 = l_side - l_side / 4 - 50;
    var hi: i32 = l_side + l_side / 4 + 50;
    if (w_side < lo || w_side > hi) {
        return test.fail("Little's law: L=" + l_side.to_string()
            + " but lambda*W=" + w_side.to_string());
    }
    return test.pass();
}

// FIFO conservation: everyone who arrives is served exactly once, and
// nobody waits a negative time.
function test_every_customer_is_served_once(): test.TestOutcome {
    var counts: i32[] = [1, 10, 137, 500];
    for i in 0..counts.len() {
        var st: Stats = simulate(counts[i], 30, 20, 7);
        if (st.served != counts[i]) {
            return test.fail("served " + st.served.to_string() + " of "
                + counts[i].to_string());
        }
        if (st.total_wait < 0) { return test.fail("negative total wait"); }
        if (st.busy_ticks > st.horizon) {
            return test.fail("server was busy " + st.busy_ticks.to_string()
                + " ticks in a " + st.horizon.to_string() + "-tick horizon");
        }
    }
    return test.pass();
}

// Time in system is wait plus service, so it can never be less than the
// waiting alone.
function test_system_time_dominates_wait(): test.TestOutcome {
    var st: Stats = simulate(300, 35, 25, 5150);
    if (st.total_system < st.total_wait) {
        return test.fail("time in system " + st.total_system.to_string()
            + " is below waiting time " + st.total_wait.to_string());
    }
    if (st.total_system - st.total_wait != st.busy_ticks) {
        return test.fail("system minus wait should be total service");
    }
    return test.pass();
}

// The same seed must reproduce the run exactly, on every backend.
function test_runs_are_deterministic(): test.TestOutcome {
    var a: Stats = simulate(250, 40, 25, 31337);
    var b: Stats = simulate(250, 40, 25, 31337);
    if (a.total_wait != b.total_wait || a.horizon != b.horizon) {
        return test.fail("same seed gave different runs");
    }
    return test.pass();
}

// ----------------------------------------------------------------- app

function main(): i32 {
    eprint("mm1_queue — a single-server FIFO queue, wait against load");
    var gaps: i32[] = [200, 100, 50, 30, 22, 18];
    for i in 0..gaps.len() {
        var st: Stats = simulate(400, gaps[i], 16, 20260807);
        eprint("  gap=" + gaps[i].to_string()
            + " util=" + utilisation_permille(st).to_string() + "/1000"
            + " mean_wait=" + mean_wait(st).to_string() + " ticks");
    }

    var r: test.TestRunner = test.test_new("mm1_queue");
    r = r.it("a light load never queues", test_a_light_load_never_queues);
    r = r.it("wait grows with utilisation", test_wait_grows_with_utilisation);
    r = r.it("Little's law holds", test_littles_law_holds);
    r = r.it("every customer is served once", test_every_customer_is_served_once);
    r = r.it("system time dominates wait", test_system_time_dominates_wait);
    r = r.it("runs are deterministic", test_runs_are_deterministic);
    return r.finish();
}
