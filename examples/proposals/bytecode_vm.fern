// examples/proposals/bytecode_vm.fern — proposal turn, drawn line 170:
// "A bytecode compiler and stack VM for arithmetic and control flow."
//
// A small imperative language — assignment, `if`/`else`, `while`, integer
// arithmetic and comparison — compiled to a flat instruction array and run
// on a stack machine.
//
// The oracle is a tree-walking evaluator over the SAME AST, in this file.
// Every test that checks a program's answer checks it twice, once each way,
// and fails if they disagree: a compiler bug that produces self-consistent
// nonsense (a jump off by one, an operand order reversed) survives every
// hand-written expected value but not this.
//
// Two invariants get their own tests because they are what backpatching
// gets wrong. Every jump target must land inside the code (an unresolved
// placeholder is a negative or out-of-range target, and a VM that silently
// clamps it turns a compiler bug into a wrong answer), and the operand
// stack must be empty between statements — a statement that leaks a value
// per iteration still computes the right answer until the loop runs long
// enough.
//
// The app writes its report to stderr; stdout carries TAP-13 from
// std/test, so the file is its own test suite.

import "std/test";
import "std/i32";

// ------------------------------------------------------------------- AST

// Variables are slots, resolved when the program is built, so neither the
// compiler nor the evaluator needs a name table at run time.
enum Expr {
    Num(i32),
    Var(i32),
    Bin(i32, Expr, Expr),   // op code, left, right
}

enum Stmt {
    Assign(i32, Expr),          // slot = expr
    If(Expr, Stmt[], Stmt[]),
    While(Expr, Stmt[]),
}

// Operator codes, shared by the compiler, the VM and the evaluator so the
// three cannot drift on what `2` means.
function op_add(): i32 { return 0; }
function op_sub(): i32 { return 1; }
function op_mul(): i32 { return 2; }
function op_div(): i32 { return 3; }
function op_mod(): i32 { return 4; }
function op_lt(): i32 { return 5; }
function op_gt(): i32 { return 6; }
function op_eq(): i32 { return 7; }
function op_ne(): i32 { return 8; }
function op_le(): i32 { return 9; }

function op_name(op: i32): string {
    if (op == 0) { return "+"; }
    if (op == 1) { return "-"; }
    if (op == 2) { return "*"; }
    if (op == 3) { return "/"; }
    if (op == 4) { return "%"; }
    if (op == 5) { return "<"; }
    if (op == 6) { return ">"; }
    if (op == 7) { return "=="; }
    if (op == 8) { return "!="; }
    return "<=";
}

// --------------------------------------------------------------- bytecode

// Every instruction carries one i32 operand; the ones that do not need it
// (arithmetic, Pop, Halt) ignore it. A uniform shape keeps the code array a
// plain array and the jump arithmetic honest — an instruction index IS an
// array index, with no variable-width decoding to get wrong.
enum Instr {
    Push(i32),
    Load(i32),
    Store(i32),
    BinOp(i32),
    Jump(i32),
    JumpIfFalse(i32),
    Halt,
}

// A jump emitted before its target is known gets this placeholder, which is
// deliberately out of range for any program: if a backpatch is missed, the
// static check below names it rather than the VM running into it.
function unpatched(): i32 { return -1; }

function instr_str(ins: Instr): string {
    match (ins) {
        Push(v) => { return "push " + v.to_string(); },
        Load(s) => { return "load $" + s.to_string(); },
        Store(s) => { return "store $" + s.to_string(); },
        BinOp(o) => { return op_name(o); },
        Jump(t) => { return "jmp " + t.to_string(); },
        JumpIfFalse(t) => { return "jz " + t.to_string(); },
        Halt => { return "halt"; },
    }
}

// --------------------------------------------------------------- compiler

function compile_expr(code: Instr[], e: Expr): Instr[] {
    match (e) {
        Num(v) => { return code.append(Push(v)); },
        Var(s) => { return code.append(Load(s)); },
        Bin(op, l, r) => {
            // Left before right, so the VM's pop order (right first) puts
            // them back the way they were written. Reversing this is
            // invisible for `+` and `*` and wrong for everything else,
            // which is why the differential runs over `-`, `/` and `%` too.
            var c: Instr[] = compile_expr(code, l);
            c = compile_expr(c, r);
            return c.append(BinOp(op));
        },
    }
}

function compile_block(code: Instr[], body: Stmt[]): Instr[] {
    var c: Instr[] = code;
    for i in 0..body.len() { c = compile_stmt(c, body[i]); }
    return c;
}

function compile_stmt(code: Instr[], s: Stmt): Instr[] {
    match (s) {
        Assign(slot, e) => {
            var c: Instr[] = compile_expr(code, e);
            return c.append(Store(slot));
        },
        If(cond, then_body, else_body) => {
            var c: Instr[] = compile_expr(code, cond);
            var jz_at: i32 = c.len();
            c = c.append(JumpIfFalse(unpatched()));
            c = compile_block(c, then_body);
            var jmp_at: i32 = c.len();
            c = c.append(Jump(unpatched()));
            c = c.with(jz_at, JumpIfFalse(c.len()));   // else starts here
            c = compile_block(c, else_body);
            return c.with(jmp_at, Jump(c.len()));      // both arms land here
        },
        While(cond, body) => {
            var top: i32 = code.len();
            var c: Instr[] = compile_expr(code, cond);
            var jz_at: i32 = c.len();
            c = c.append(JumpIfFalse(unpatched()));
            c = compile_block(c, body);
            c = c.append(Jump(top));
            return c.with(jz_at, JumpIfFalse(c.len()));
        },
    }
}

function compile(body: Stmt[]): Instr[] {
    var c: Instr[] = compile_block([], body);
    return c.append(Halt);
}

// --------------------------------------------------------------------- VM

struct Machine {
    vars: i32[],
    max_depth: i32,     // deepest the operand stack ever got
    steps: i32,
}

function apply_op(op: i32, a: i32, b: i32): Result[i32, string] {
    if (op == 0) { return Ok(a + b); }
    if (op == 1) { return Ok(a - b); }
    if (op == 2) { return Ok(a * b); }
    if (op == 3) {
        if (b == 0) { return Err("division by zero"); }
        return Ok(a / b);
    }
    if (op == 4) {
        if (b == 0) { return Err("modulo by zero"); }
        return Ok(a % b);
    }
    if (op == 5) { if (a < b) { return Ok(1); } return Ok(0); }
    if (op == 6) { if (a > b) { return Ok(1); } return Ok(0); }
    if (op == 7) { if (a == b) { return Ok(1); } return Ok(0); }
    if (op == 8) { if (a != b) { return Ok(1); } return Ok(0); }
    if (a <= b) { return Ok(1); }
    return Ok(0);
}

// A step budget, so a compiler bug that builds an unterminated loop fails
// as a diagnosable error instead of hanging the test suite.
function step_budget(): i32 { return 200000; }

// Drop the top `k` values. `std/array`'s `take` would say this, but it is
// declared for `string[]` only.
function popped(stack: i32[], k: i32): i32[] {
    var out: i32[] = [];
    for i in 0..(stack.len() - k) { out = out.append(stack[i]); }
    return out;
}

function run(code: Instr[], nvars: i32): Result[Machine, string] {
    var vars: i32[] = [];
    for i in 0..nvars { vars = vars.append(0); }
    var stack: i32[] = [];
    var pc: i32 = 0;
    var steps: i32 = 0;
    var max_depth: i32 = 0;
    while (true) {
        if (steps > step_budget()) {
            return Err("step budget exhausted at pc " + pc.to_string());
        }
        steps = steps + 1;
        if (pc < 0 || pc >= code.len()) {
            return Err("pc " + pc.to_string() + " outside a "
                + code.len().to_string() + "-instruction program");
        }
        if (stack.len() > max_depth) { max_depth = stack.len(); }
        var next: i32 = pc + 1;
        match (code[pc]) {
            Push(v) => { stack = stack.append(v); },
            Load(s) => {
                if (s < 0 || s >= vars.len()) {
                    return Err("load of unknown slot " + s.to_string());
                }
                stack = stack.append(vars[s]);
            },
            Store(s) => {
                if (stack.len() < 1) { return Err("store on an empty stack"); }
                if (s < 0 || s >= vars.len()) {
                    return Err("store to unknown slot " + s.to_string());
                }
                vars = vars.with(s, stack[stack.len() - 1]);
                stack = popped(stack, 1);
            },
            BinOp(op) => {
                if (stack.len() < 2) {
                    return Err("binary " + op_name(op) + " with "
                        + stack.len().to_string() + " values on the stack");
                }
                var b: i32 = stack[stack.len() - 1];
                var a: i32 = stack[stack.len() - 2];
                stack = popped(stack, 2);
                match (apply_op(op, a, b)) {
                    Err(e) => { return Err(e); },
                    Ok(v) => { stack = stack.append(v); },
                }
            },
            Jump(t) => { next = t; },
            JumpIfFalse(t) => {
                if (stack.len() < 1) { return Err("branch on an empty stack"); }
                var c: i32 = stack[stack.len() - 1];
                stack = popped(stack, 1);
                if (c == 0) { next = t; }
            },
            Halt => {
                if (stack.len() != 0) {
                    return Err("halted with " + stack.len().to_string()
                        + " values left on the stack");
                }
                return Ok(Machine { vars: vars, max_depth: max_depth, steps: steps });
            },
        }
        pc = next;
    }
    return Err("unreachable");
}

// ---------------------------------------------------------- the oracle

// A direct tree walk over the same AST. Deliberately written without
// reference to the bytecode: no stack, no program counter, no jumps.
function eval_expr(vars: i32[], e: Expr): Result[i32, string] {
    match (e) {
        Num(v) => { return Ok(v); },
        Var(s) => {
            if (s < 0 || s >= vars.len()) {
                return Err("read of unknown slot " + s.to_string());
            }
            return Ok(vars[s]);
        },
        Bin(op, l, r) => {
            match (eval_expr(vars, l)) {
                Err(e1) => { return Err(e1); },
                Ok(a) => {
                    match (eval_expr(vars, r)) {
                        Err(e2) => { return Err(e2); },
                        Ok(b) => { return apply_op(op, a, b); },
                    }
                },
            }
        },
    }
}

struct EvalState { vars: i32[], steps: i32 }

function eval_block(st: EvalState, body: Stmt[]): Result[EvalState, string] {
    var s: EvalState = st;
    for i in 0..body.len() {
        match (eval_stmt(s, body[i])) {
            Err(e) => { return Err(e); },
            Ok(next) => { s = next; },
        }
    }
    return Ok(s);
}

function eval_stmt(st: EvalState, s: Stmt): Result[EvalState, string] {
    if (st.steps > step_budget()) { return Err("evaluator step budget exhausted"); }
    var state: EvalState = EvalState { ...st, steps: st.steps + 1 };
    match (s) {
        Assign(slot, e) => {
            match (eval_expr(state.vars, e)) {
                Err(err) => { return Err(err); },
                Ok(v) => {
                    if (slot < 0 || slot >= state.vars.len()) {
                        return Err("write to unknown slot " + slot.to_string());
                    }
                    return Ok(EvalState { ...state, vars: state.vars.with(slot, v) });
                },
            }
        },
        If(cond, then_body, else_body) => {
            match (eval_expr(state.vars, cond)) {
                Err(err) => { return Err(err); },
                Ok(c) => {
                    if (c != 0) { return eval_block(state, then_body); }
                    return eval_block(state, else_body);
                },
            }
        },
        While(cond, body) => {
            var s2: EvalState = state;
            while (true) {
                if (s2.steps > step_budget()) {
                    return Err("evaluator step budget exhausted");
                }
                s2 = EvalState { ...s2, steps: s2.steps + 1 };
                match (eval_expr(s2.vars, cond)) {
                    Err(err) => { return Err(err); },
                    Ok(c) => {
                        if (c == 0) { return Ok(s2); }
                    },
                }
                match (eval_block(s2, body)) {
                    Err(err) => { return Err(err); },
                    Ok(next) => { s2 = next; },
                }
            }
            return Ok(s2);
        },
    }
}

function evaluate(body: Stmt[], nvars: i32): Result[i32[], string] {
    var vars: i32[] = [];
    for i in 0..nvars { vars = vars.append(0); }
    match (eval_block(EvalState { vars: vars, steps: 0 }, body)) {
        Err(e) => { return Err(e); },
        Ok(st) => { return Ok(st.vars); },
    }
}

// --------------------------------------------------------- test programs

// Every program in the corpus, each with the slot count it needs. They are
// built once here so the differential, the jump-target check and the stack
// discipline check all run over the same set.
function corpus(): Stmt[][] {
    return [
        // $0 = 6 * 7 - 2
        [Assign(0, Bin(op_sub(), Bin(op_mul(), Num(6), Num(7)), Num(2)))],
        // Non-commutative operators, where a reversed operand order shows.
        [Assign(0, Bin(op_sub(), Num(3), Num(10))),
         Assign(1, Bin(op_div(), Num(100), Num(7))),
         Assign(2, Bin(op_mod(), Num(100), Num(7)))],
        // Nested arithmetic, mixed precedence already resolved by the AST.
        [Assign(0, Bin(op_add(), Bin(op_mul(), Num(2), Num(3)),
                                 Bin(op_div(), Num(20), Num(4))))],
        // if / else, both arms reachable across the corpus.
        [Assign(0, Num(5)),
         If(Bin(op_lt(), Var(0), Num(10)), [Assign(1, Num(111))], [Assign(1, Num(222))]),
         If(Bin(op_gt(), Var(0), Num(10)), [Assign(2, Num(111))], [Assign(2, Num(222))])],
        // A counting loop: $1 = sum 1..10, $0 the counter.
        [Assign(0, Num(0)), Assign(1, Num(0)),
         While(Bin(op_lt(), Var(0), Num(10)), [
             Assign(0, Bin(op_add(), Var(0), Num(1))),
             Assign(1, Bin(op_add(), Var(1), Var(0))),
         ])],
        // A loop whose body never runs — the exit jump must skip it.
        [Assign(0, Num(99)),
         While(Bin(op_lt(), Var(0), Num(0)), [Assign(1, Num(1))])],
        // if nested inside while: even/odd tally over 1..20.
        [Assign(0, Num(0)), Assign(1, Num(0)), Assign(2, Num(0)),
         While(Bin(op_lt(), Var(0), Num(20)), [
             Assign(0, Bin(op_add(), Var(0), Num(1))),
             If(Bin(op_eq(), Bin(op_mod(), Var(0), Num(2)), Num(0)),
                [Assign(1, Bin(op_add(), Var(1), Num(1)))],
                [Assign(2, Bin(op_add(), Var(2), Num(1)))]),
         ])],
        // while nested inside while: a multiplication table sum.
        [Assign(0, Num(0)), Assign(3, Num(0)),
         While(Bin(op_lt(), Var(0), Num(5)), [
             Assign(0, Bin(op_add(), Var(0), Num(1))),
             Assign(1, Num(0)),
             While(Bin(op_lt(), Var(1), Num(5)), [
                 Assign(1, Bin(op_add(), Var(1), Num(1))),
                 Assign(3, Bin(op_add(), Var(3), Bin(op_mul(), Var(0), Var(1)))),
             ]),
         ])],
        // Euclid's algorithm: gcd(1071, 462) = 21 in $0.
        [Assign(0, Num(1071)), Assign(1, Num(462)),
         While(Bin(op_ne(), Var(1), Num(0)), [
             Assign(2, Bin(op_mod(), Var(0), Var(1))),
             Assign(0, Var(1)),
             Assign(1, Var(2)),
         ])],
        // if inside the ELSE arm — the far side of the second backpatch.
        [Assign(0, Num(3)),
         If(Bin(op_gt(), Var(0), Num(100)),
            [Assign(1, Num(1))],
            [If(Bin(op_le(), Var(0), Num(3)), [Assign(1, Num(7))], [Assign(1, Num(8))])])],
    ];
}

function slots(): i32 { return 4; }

// ---------------------------------------------------------------- tests

// THE test. Compile-and-run must agree with the tree walk on every program
// in the corpus, variable for variable. Neither side is the expected value;
// their agreement is.
function test_the_vm_agrees_with_the_evaluator(): test.TestOutcome {
    var progs: Stmt[][] = corpus();
    for i in 0..progs.len() {
        var walked: i32[] = [];
        match (evaluate(progs[i], slots())) {
            Err(e) => { return test.fail("program " + i.to_string()
                + " failed to evaluate: " + e); },
            Ok(v) => { walked = v; },
        }
        var ran: i32[] = [];
        match (run(compile(progs[i]), slots())) {
            Err(e) => { return test.fail("program " + i.to_string()
                + " failed to run: " + e); },
            Ok(m) => { ran = m.vars; },
        }
        if (ran.len() != walked.len()) {
            return test.fail("program " + i.to_string() + ": slot counts differ");
        }
        for s in 0..ran.len() {
            if (ran[s] != walked[s]) {
                return test.fail("program " + i.to_string() + " slot $"
                    + s.to_string() + ": VM says " + ran[s].to_string()
                    + ", the evaluator says " + walked[s].to_string());
            }
        }
    }
    return test.pass();
}

// A handful of closed forms, so the pair above cannot agree on a shared
// misconception. sum 1..10 = 55, gcd(1071, 462) = 21, and the 5x5
// multiplication table sums to (1+..+5)^2 = 225.
function test_known_answers(): test.TestOutcome {
    var progs: Stmt[][] = corpus();
    if (!slot_is(progs[4], 1, 55)) { return test.fail("sum 1..10 should be 55"); }
    if (!slot_is(progs[8], 0, 21)) { return test.fail("gcd(1071, 462) should be 21"); }
    if (!slot_is(progs[7], 3, 225)) {
        return test.fail("the 5x5 multiplication table should sum to 225");
    }
    if (!slot_is(progs[6], 1, 10)) { return test.fail("1..20 has 10 even numbers"); }
    if (!slot_is(progs[1], 0, -7)) { return test.fail("3 - 10 should be -7"); }
    if (!slot_is(progs[1], 1, 14)) { return test.fail("100 / 7 should be 14"); }
    if (!slot_is(progs[1], 2, 2)) { return test.fail("100 % 7 should be 2"); }
    if (!slot_is(progs[9], 1, 7)) { return test.fail("the nested else arm should win"); }
    return test.pass();
}

function slot_is(prog: Stmt[], slot: i32, want: i32): boolean {
    match (run(compile(prog), slots())) {
        Err(_) => { return false; },
        Ok(m) => { return m.vars[slot] == want; },
    }
}

// Every jump target must be a real instruction index. An unpatched
// placeholder survives to here, and so does a target one past the end —
// the classic backpatch off-by-one, which a VM that tolerates pc == len
// would turn into a silently truncated program.
function test_every_jump_target_is_in_range(): test.TestOutcome {
    var progs: Stmt[][] = corpus();
    for i in 0..progs.len() {
        var code: Instr[] = compile(progs[i]);
        for k in 0..code.len() {
            var t: i32 = jump_target(code[k]);
            if (t == -2) { continue; }              // not a jump
            if (t < 0) {
                return test.fail("program " + i.to_string() + ": unpatched jump at "
                    + k.to_string());
            }
            if (t >= code.len()) {
                return test.fail("program " + i.to_string() + ": jump at "
                    + k.to_string() + " targets " + t.to_string()
                    + " in a " + code.len().to_string() + "-instruction program");
            }
        }
    }
    return test.pass();
}

// -2 means "not a jump" — distinct from the -1 unpatched placeholder, so a
// missed backpatch cannot be mistaken for a non-jump and skipped.
function jump_target(ins: Instr): i32 {
    match (ins) {
        Jump(t) => { return t; },
        JumpIfFalse(t) => { return t; },
        _ => { return -2; },
    }
}

// Stack discipline: the machine halts with an empty stack (the VM enforces
// that itself) and never needs more depth than the deepest expression. A
// statement that leaks one value per iteration still computes the right
// answer — until the loop is long enough — so depth is the only thing that
// catches it early.
function test_the_stack_is_disciplined(): test.TestOutcome {
    var progs: Stmt[][] = corpus();
    for i in 0..progs.len() {
        match (run(compile(progs[i]), slots())) {
            Err(e) => { return test.fail("program " + i.to_string() + ": " + e); },
            Ok(m) => {
                // Nothing in the corpus nests operands deeper than 3.
                if (m.max_depth > 3) {
                    return test.fail("program " + i.to_string()
                        + " reached stack depth " + m.max_depth.to_string()
                        + " — a leak inside a loop looks exactly like this");
                }
            },
        }
    }
    return test.pass();
}

// Compilation is a pure function of the AST: same program in, byte-identical
// code out, however many times it runs.
function test_compilation_is_deterministic(): test.TestOutcome {
    var progs: Stmt[][] = corpus();
    for i in 0..progs.len() {
        var a: Instr[] = compile(progs[i]);
        var b: Instr[] = compile(progs[i]);
        if (a.len() != b.len()) {
            return test.fail("program " + i.to_string() + ": lengths differ");
        }
        for k in 0..a.len() {
            if (instr_str(a[k]) != instr_str(b[k])) {
                return test.fail("program " + i.to_string() + " instruction "
                    + k.to_string() + ": " + instr_str(a[k]) + " vs "
                    + instr_str(b[k]));
            }
        }
    }
    return test.pass();
}

// A fault is an error on both sides, with the same reason — not a crash,
// and not a zero quietly substituted for an undefined answer.
function test_faults_are_errors_on_both_sides(): test.TestOutcome {
    var bad: Stmt[][] = [
        [Assign(0, Bin(op_div(), Num(1), Num(0)))],
        [Assign(0, Bin(op_mod(), Num(1), Num(0)))],
        // A loop that never terminates: both sides must hit their budget.
        [Assign(0, Num(0)), While(Bin(op_eq(), Num(1), Num(1)), [Assign(0, Num(1))])],
    ];
    for i in 0..bad.len() {
        var walked_err: boolean = false;
        match (evaluate(bad[i], slots())) {
            Err(_) => { walked_err = true; },
            Ok(_) => { },
        }
        var ran_err: boolean = false;
        match (run(compile(bad[i]), slots())) {
            Err(_) => { ran_err = true; },
            Ok(_) => { },
        }
        if (!walked_err) {
            return test.fail("bad program " + i.to_string()
                + " evaluated without error");
        }
        if (!ran_err) {
            return test.fail("bad program " + i.to_string() + " ran without error");
        }
    }
    // The division-by-zero message names the fault rather than a location.
    match (run(compile(bad[0]), slots())) {
        Ok(_) => { return test.fail("1 / 0 succeeded"); },
        Err(msg) => {
            if (msg != "division by zero") {
                return test.fail("unhelpful message: " + msg);
            }
        },
    }
    return test.pass();
}

// The VM refuses code it cannot run rather than reading past the array or
// treating a wild slot as zero. These are hand-built instruction sequences
// the compiler would never emit — the point is that a corrupted or
// hand-written program is rejected, not mis-run.
function test_the_vm_refuses_malformed_code(): test.TestOutcome {
    var progs: Instr[][] = [
        [BinOp(op_add())],                          // binary op, empty stack
        [Push(1), BinOp(op_add())],                 // one operand short
        [Store(0)],                                 // store, empty stack
        [Push(1), Store(99)],                       // slot out of range
        [Load(-1)],                                 // negative slot
        [Jump(50)],                                 // target past the end
        [Push(1), Halt],                            // halts with a full stack
        [JumpIfFalse(0)],                           // branch, empty stack
    ];
    for i in 0..progs.len() {
        match (run(progs[i], slots())) {
            Ok(_) => {
                return test.fail("malformed program " + i.to_string()
                    + " ran to completion");
            },
            Err(_) => { },
        }
    }
    return test.pass();
}

// ---------------------------------------------------------------- app

function main(): i32 {
    eprint("bytecode_vm — a stack machine and its tree-walking oracle");
    var progs: Stmt[][] = corpus();
    var gcd: Instr[] = compile(progs[8]);
    eprint("  gcd(1071, 462), " + gcd.len().to_string() + " instructions:");
    for i in 0..gcd.len() {
        eprint("    " + i.to_string() + "  " + instr_str(gcd[i]));
    }
    match (run(gcd, slots())) {
        Err(e) => { eprint("  error: " + e); },
        Ok(m) => {
            eprint("  -> $0 = " + m.vars[0].to_string()
                + "  (" + m.steps.to_string() + " steps, stack depth "
                + m.max_depth.to_string() + ")");
        },
    }

    var r: test.TestRunner = test.test_new("bytecode_vm");
    r = r.it("the vm agrees with the evaluator", test_the_vm_agrees_with_the_evaluator);
    r = r.it("known answers", test_known_answers);
    r = r.it("every jump target is in range", test_every_jump_target_is_in_range);
    r = r.it("the stack is disciplined", test_the_stack_is_disciplined);
    r = r.it("compilation is deterministic", test_compilation_is_deterministic);
    r = r.it("faults are errors on both sides", test_faults_are_errors_on_both_sides);
    r = r.it("the vm refuses malformed code", test_the_vm_refuses_malformed_code);
    return r.finish();
}
