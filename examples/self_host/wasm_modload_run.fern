// examples/self_host/wasm_modload_run.fern — the per-module wasm driver
// (#5331 step 4c). The wasm sibling of asm_modload_run.fern.
//
// Whole-program wasm emit re-emits everything on every build. Steps 1-3 removed a
// module's dependence on its siblings' string literals, funcref indices, and type
// ids; step 4a/4b split the emitter into a link scope and per-unit bodies; the
// N=2 probe showed two units link into a working module. This driver is what
// turns that into incremental builds.
//
// Modes:
//
//   -per-module-count           how many modules the entry pulls in
//   -per-module-manifest        one line per module: ns|src_hash|sig_hash|imports
//   -per-module-emit N          emit module N's unit (function bodies) to stdout
//     [-cache-dir DIR]          serve it from / populate an object cache
//
// The cache key is modloader.module_cache_key: a module's own source hash folded
// with the SIGNATURE hashes of the modules it imports. That asymmetry is the
// point — a body-only edit re-emits just that module, while a signature change
// also invalidates its importers, whose call-site tagging depends on it.
// hit/miss is reported on stderr (one ns per line) so a build orchestrator, or a
// test, can observe the reuse set; stdout stays exactly the unit text.
//
// What makes the emit cheap enough to be worth caching: producing unit N parses
// every module (cheap — no codegen) to build the whole-program VIEW its side
// tables need, but LOWERS only module N. Lowering is the expensive part, and a
// cache hit skips it entirely along with the emit.

import "./util";
import "./lexer";
import "./parser";
import "./flatten";
import "./wasm_ir";
import "./irlower";
import "./asm_ir";
import "./modloader";
import "./wasm_objfile";

// unit_ns namespaces module `idx`'s base globals. Module 0 keeps the historical
// unnamespaced names so a single-module program's unit is byte-identical to the
// whole-program build's bodies; the rest get a `$m<idx>` suffix. A partial shard
// (lo > 0) gets a further `_s<lo>` suffix so each window's $__str_base /
// $__fn_base and string labels stay distinct at link — mirroring the asm side's
// shard_ns (#3425 / #5508).
function unit_ns(idx: i32, lo: i32): string {
    var base: string = "";
    if (idx != 0) { base = "$m" + util.i32_to_string(idx); }
    if (lo > 0) { base = base + "_s" + util.i32_to_string(lo); }
    return base;
}

// sub_module clones `m` carrying only funcs[lo:hi) (hi < 0 = to the end). The
// type world — structs, enums, impls, trait_reqs — stays whole, since it is
// shared by every shard and resolved against the whole-program view. This is the
// entire mechanism behind window sharding: lower_all_for_view / emit_functions_view
// are already whole-program-view-threaded, so a windowed sub-module lowers and
// emits its slice correctly with no further change (#5508).
function sub_module(m: parser.Module, lo: i32, hi: i32): parser.Module {
    var end: i32 = hi;
    if (end < 0 || end > m.funcs.len()) { end = m.funcs.len(); }
    var fs: parser.FuncDecl[] = [];
    var i: i32 = lo;
    while (i < end) { fs = fs.append(m.funcs[i]); i = i + 1; }
    return parser.Module {
        funcs: fs, structs: m.structs, aliases: m.aliases, imports: m.imports,
        top_stmts: m.top_stmts, enums: m.enums, resources: m.resources,
        exports: m.exports, impls: m.impls, trait_reqs: m.trait_reqs,
    };
}

// whole_program_view returns the inferred, lambda-lifted union of every module's
// functions and structs — the view a unit's lowering and emit must see, because a
// call is shaped by its CALLEE and that routinely lives in another module. It is
// PARSE-level work only: no lowering, so building it for every module on every
// invocation stays cheap, which is what lets a cache hit skip the expensive part.
function whole_program_view(parts: flatten.PerModule[]): parser.Module[] {
    var out: parser.Module[] = [];
    var i: i32 = 0;
    while (i < parts.len()) {
        out = out.append(parser.infer_ret_types_module(wasm_ir.lift_lambdas(parts[i].mod)));
        i = i + 1;
    }
    return out;
}

// ShardRef names one link unit: module `idx` over its [lo, hi) function window
// (hi < 0 = whole module). The link plan is a list of these.
struct ShardRef { idx: i32, lo: i32, hi: i32 }

// parse_plan reads a link plan and returns its ShardRefs. The text is a flat
// stream of integers — `idx lo hi` per unit — separated by ANY whitespace
// (newline-per-line is the convention, but the parser only cares about the int
// sequence, so it needs no split helper). Every three consecutive integers form
// one unit. This is how the orchestrator tells -link the shard layout it chose
// from -per-module-func-counts — the wasm analogue of the asm build passing an
// explicit .s file list to the linker (#5508). A `-` sign is honoured so hi can
// be -1 (whole module to the end).
function parse_plan(text: string): ShardRef[] {
    var nums: i32[] = [];
    var i: i32 = 0;
    while (i < text.len()) {
        var c: i32 = text[i] as i32;
        var neg: boolean = false;
        if (c == 45 && i + 1 < text.len() && (text[i + 1] as i32) >= 48 && (text[i + 1] as i32) <= 57) { neg = true; i = i + 1; c = text[i] as i32; }
        if (c >= 48 && c <= 57) {
            var v: i32 = 0;
            while (i < text.len() && (text[i] as i32) >= 48 && (text[i] as i32) <= 57) { v = v * 10 + ((text[i] as i32) - 48); i = i + 1; }
            if (neg) { v = 0 - v; }
            nums = nums.append(v);
        } else {
            i = i + 1;
        }
    }
    var out: ShardRef[] = [];
    var k: i32 = 0;
    while (k + 2 < nums.len()) {
        out = out.append(ShardRef { idx: nums[k], lo: nums[k + 1], hi: nums[k + 2] });
        k = k + 3;
    }
    return out;
}

// whole_module_plan is the default when no -plan is given: one whole-module unit
// per module, preserving the pre-sharding link behaviour exactly.
function whole_module_plan(nmods: i32): ShardRef[] {
    var out: ShardRef[] = [];
    var i: i32 = 0;
    while (i < nmods) { out = out.append(ShardRef { idx: i, lo: 0, hi: 0 - 1 }); i = i + 1; }
    return out;
}

// build_unit lowers module `idx` and packages its bodies with the metadata link
// needs. This is the only place lowering happens, which is what makes a cache
// hit cheap: it skips this entirely.
function build_unit(infmods: parser.Module[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[], idx: i32, lo: i32, hi: i32): wasm_objfile.UnitObj {
    var ns: string = unit_ns(idx, lo);
    // Lower ONLY this window's functions. lower_all_for_view sees the whole
    // program for its side tables, so a call into a function outside the window
    // (another shard, another module) still tags correctly.
    var sub: parser.Module = sub_module(infmods[idx], lo, hi);
    var cache: irlower.LowerResult[] = wasm_ir.lower_all_for_view(sub, all_funcs, all_structs);
    return wasm_objfile.UnitObj {
        strs: wasm_ir.str_values(cache),
        caggs: wasm_ir.const_agg_values(cache),
        fns: wasm_ir.fn_value_table(cache),
        needs: wasm_ir.needs_of(cache),
        fn_sigs: wasm_ir.indirect_fn_sigs(cache),
        frt: wasm_ir.field_reclaim_types(cache),
        sdt: wasm_ir.struct_drop_types(cache, all_structs),
        aet: wasm_ir.struct_arr_elems_drop_types(cache, all_structs),
        text: wasm_ir.emit_functions_view(ns, sub, cache, all_funcs, all_structs),
    };
}

// load_unit returns module `idx`'s object, served from the cache when its key
// still matches and built (lowered) only when it does not. hit/miss goes to
// stderr so a build, or a test, can observe exactly which modules were reused.
function load_unit(dir: string, entry_path: string, parts: flatten.PerModule[], infmods: parser.Module[], sighashes: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[], idx: i32, lo: i32, hi: i32, cache_dir: string): wasm_objfile.UnitObj {
    var lk: wasm_objfile.MaybeUnit = cache_lookup(dir, entry_path, parts, infmods, sighashes, idx, lo, hi, cache_dir);
    if (lk.found) { return lk.obj; }
    var obj: wasm_objfile.UnitObj = build_unit(infmods, all_funcs, all_structs, idx, lo, hi);
    if (cache_dir.len() > 0 && sighashes.len() > 0) {
        var ck: string = cache_file_for(dir, entry_path, parts, infmods, sighashes, idx, lo, hi, cache_dir);
        if (ck.len() > 0) {
            eprint("cache-miss " + parts[idx].ns + "\n");
            match (write_file(ck, wasm_objfile.encode(obj))) {
                Err(werr) => { eprint("wasm per-module: cache write failed for " + parts[idx].ns + "\n"); },
                Ok(_) => { },
            }
        }
    }
    return obj;
}

// cache_file_for returns the object path for module idx, or "" when the module
// has no stable key (module_src_hash == "?") or no cache is configured. The
// single source of the path both the read and the write use.
function cache_file_for(dir: string, entry_path: string, parts: flatten.PerModule[], infmods: parser.Module[], sighashes: string[], idx: i32, lo: i32, hi: i32, cache_dir: string): string {
    if (cache_dir.len() == 0 || sighashes.len() == 0) { return ""; }
    var src_hash: string = modloader.module_src_hash(dir, entry_path, parts, idx);
    var key: string = modloader.module_cache_key(parts, infmods, sighashes, idx, src_hash, []);
    if (key.len() == 0) { return ""; }
    // Fold the window into the key so two shards of one module get distinct
    // objects; the filename carries the shard-ns for readability.
    key = key + "|r" + util.i32_to_string(lo) + ":" + util.i32_to_string(hi);
    return cache_dir + "/" + parts[idx].ns + unit_ns(idx, lo) + "__" + util.hash_key(key) + ".wu";
}

// cache_lookup reads module idx's object from the cache. It NEVER lowers, which
// is what lets -link be hit-only: a whole-compiler link that lowered every
// module in one process exhausts the bump arena (#3425). A miss returns
// found=false; the caller decides whether to build (-emit) or error (-link).
function cache_lookup(dir: string, entry_path: string, parts: flatten.PerModule[], infmods: parser.Module[], sighashes: string[], idx: i32, lo: i32, hi: i32, cache_dir: string): wasm_objfile.MaybeUnit {
    var cf: string = cache_file_for(dir, entry_path, parts, infmods, sighashes, idx, lo, hi, cache_dir);
    if (cf.len() > 0) {
        match (read_file(cf)) {
            Ok(cached) => {
                // An object written by an older compiler carries an older
                // magic. The key hashes sources and signatures, not the object
                // FORMAT, so nothing else here would tell the two apart — and
                // decode reads its sections positionally, so a stale file would
                // yield a wrong-but-plausible unit rather than an error.
                if (!wasm_objfile.is_current(cached)) {
                    eprint("cache-stale " + parts[idx].ns + "\n");
                    return wasm_objfile.MaybeUnit { found: false, obj: wasm_objfile.empty_unit() };
                }
                eprint("cache-hit " + parts[idx].ns + "\n");
                return wasm_objfile.MaybeUnit { found: true, obj: wasm_objfile.decode(cached) };
            },
            Err(e) => { },
        }
    }
    return wasm_objfile.MaybeUnit { found: false, obj: wasm_objfile.empty_unit() };
}

function run_per_module(dir: string, entry_path: string, entry: parser.Module, loaded: flatten.LoadedModule[], pm_mode: string, pm_index: i32, pm_lo: i32, pm_hi: i32, cache_dir: string, plan_file: string): i32 {
    var parts: flatten.PerModule[] = flatten.bundle_per_module(entry, loaded);
    if (pm_mode == "count") {
        print(util.i32_to_string(parts.len()) + "\n");
        return 0;
    }

    var infmods: parser.Module[] = whole_program_view(parts);
    var all_funcs: parser.FuncDecl[] = [];
    var all_structs: parser.StructDecl[] = [];
    var pi: i32 = 0;
    while (pi < infmods.len()) {
        var fk: i32 = 0;
        while (fk < infmods[pi].funcs.len()) {
            all_funcs = all_funcs.append(infmods[pi].funcs[fk]);
            fk = fk + 1;
        }
        var sk: i32 = 0;
        while (sk < infmods[pi].structs.len()) {
            all_structs = all_structs.append(infmods[pi].structs[sk]);
            sk = sk + 1;
        }
        pi = pi + 1;
    }

    // Signature hashes are needed by the manifest and by any cached emit, and
    // only then: computing them is a whole-program string walk the self-host
    // runtime does not yet reclaim (#3425), so an uncached emit must not pay it.
    var sighashes: string[] = [];
    if (pm_mode == "manifest" || ((pm_mode == "emit" || pm_mode == "link") && cache_dir.len() > 0)) {
        var shi: i32 = 0;
        while (shi < parts.len()) {
            sighashes = sighashes.append(util.hash_key(modloader.module_sig_string(infmods[shi])));
            shi = shi + 1;
        }
    }

    if (pm_mode == "manifest") {
        var mi: i32 = 0;
        while (mi < parts.len()) {
            print(parts[mi].ns + "|" + modloader.module_src_hash(dir, entry_path, parts, mi)
                + "|" + sighashes[mi] + "|" + modloader.module_import_ns(infmods[mi]) + "\n");
            mi = mi + 1;
        }
        return 0;
    }

    if (pm_mode == "link") {
        // Assemble the whole module from per-unit objects. Each unit is served
        // from the cache when its key still matches, so an incremental rebuild
        // lowers ONLY the modules that actually changed — the payoff the rest of
        // #5331 was building toward. Link itself consults no ir_cache at all: the
        // needs, fn_sigs and RC type lists all come from the objects.
        var nss: string[] = [];
        var texts: string[] = [];
        var all_strs: string[] = [];
        var str_counts: i32[] = [];
        var all_caggs: string[] = [];
        var cagg_counts: i32[] = [];
        var all_fns: string[] = [];
        var fn_counts: i32[] = [];
        var needs: string[] = [];
        var fn_sigs: string[] = [];
        var frt: string[] = [];
        var sdt: string[] = [];
        var aet: string[] = [];
        // The link plan: one unit per whole module by default, or the exact
        // shard windows the orchestrator chose (-plan). A big module that OOMs
        // emitted whole is split into function windows, each a separate unit
        // here — the assembly is identical whether a module arrived as one unit
        // or several, since every unit carries its own namespaced bases (#5508).
        var plan: ShardRef[] = whole_module_plan(parts.len());
        if (plan_file.len() > 0) {
            match (read_file(plan_file)) {
                Ok(ptxt) => { plan = parse_plan(ptxt); },
                Err(e) => { eprint("wasm -link: could not read plan " + plan_file + "\n"); return 1; },
            }
        }
        // Hit-only: -link reads every unit from the cache and lowers NOTHING.
        // A missing unit is an error naming it, not a silent in-process build —
        // that is the design that keeps a whole-compiler link off the arena wall
        // (#3425). The orchestrator emits each miss with -per-module-emit (its
        // own process) and links again.
        var missing: string = "";
        var li: i32 = 0;
        while (li < plan.len()) {
            var pidx: i32 = plan[li].idx;
            var plo: i32 = plan[li].lo;
            var phi: i32 = plan[li].hi;
            var lk: wasm_objfile.MaybeUnit = cache_lookup(dir, entry_path, parts, infmods, sighashes, pidx, plo, phi, cache_dir);
            if (!lk.found) {
                missing = missing + " " + parts[pidx].ns + unit_ns(pidx, plo);
                li = li + 1;
                continue;
            }
            var obj: wasm_objfile.UnitObj = lk.obj;
            nss = nss.append(unit_ns(pidx, plo));
            texts = texts.append(obj.text);
            var si: i32 = 0;
            while (si < obj.strs.len()) { all_strs = all_strs.append(obj.strs[si]); si = si + 1; }
            str_counts = str_counts.append(obj.strs.len());
            var ki: i32 = 0;
            while (ki < obj.caggs.len()) { all_caggs = all_caggs.append(obj.caggs[ki]); ki = ki + 1; }
            cagg_counts = cagg_counts.append(obj.caggs.len());
            var fi2: i32 = 0;
            while (fi2 < obj.fns.len()) { all_fns = all_fns.append(obj.fns[fi2]); fi2 = fi2 + 1; }
            fn_counts = fn_counts.append(obj.fns.len());
            needs = wasm_ir.union_strs(needs, obj.needs);
            frt = wasm_ir.union_strs(frt, obj.frt);
            sdt = wasm_ir.union_strs(sdt, obj.sdt);
            aet = wasm_ir.union_strs(aet, obj.aet);
            fn_sigs = wasm_ir.union_strs(fn_sigs, obj.fn_sigs);
            li = li + 1;
        }
        if (missing.len() > 0) {
            eprint("wasm -link: no cached object for:" + missing + "\n");
            eprint("  emit each with `-per-module-emit N -cache-dir DIR` first (one process per module).\n");
            return 1;
        }
        // The struct world is shared by every unit, so the RC helper bodies are
        // emitted once against the merged module. heap_base is a whole-LINK
        // quantity: it sits past every unit's literals.
        var merged: parser.Module = flatten.bundle(entry, loaded);
        merged = parser.infer_ret_types_module(wasm_ir.lift_lambdas(modloader.merge_builtins(dir, merged)));
        var rc: string = wasm_ir.emit_ir_rc_bodies_from(merged, frt, sdt, aet, wasm_ir.heap_base_for_strs(all_strs, all_caggs));
        write(wasm_ir.emit_ir_module_units(nss, texts, all_strs, str_counts, all_caggs, cagg_counts, all_fns, fn_counts, merged, needs, fn_sigs, rc));
        return 0;
    }

    if (pm_mode == "func-counts") {
        // Per-module function count POST lift_lambdas / infer — the exact set
        // build_unit windows over — so an orchestrator can size shards without a
        // hardcoded per-source count. Mirrors asm's -per-module-func-counts.
        var fci: i32 = 0;
        while (fci < infmods.len()) { print(util.i32_to_string(infmods[fci].funcs.len())); fci = fci + 1; }
        return 0;
    }

    if (pm_index < 0 || pm_index >= parts.len()) {
        eprint("wasm per-module: emit index out of range\n");
        return 1;
    }

    var obj: wasm_objfile.UnitObj = load_unit(dir, entry_path, parts, infmods, sighashes, all_funcs, all_structs, pm_index, pm_lo, pm_hi, cache_dir);
    write(wasm_objfile.encode(obj));
    return 0;
}

function main(): i32 {
    var a: string[] = args();
    var entry_path: string = "";
    var pm_mode: string = "";
    var pm_index: i32 = 0 - 1;
    var pm_lo: i32 = 0;
    var pm_hi: i32 = 0 - 1;
    var cache_dir: string = "";
    var plan_file: string = "";
    var ai: i32 = 1;
    while (ai < a.len()) {
        if (a[ai] == "-per-module-count") { pm_mode = "count"; }
        else if (a[ai] == "-per-module-manifest") { pm_mode = "manifest"; }
        else if (a[ai] == "-per-module-func-counts") { pm_mode = "func-counts"; }
        else if (a[ai] == "-link") { pm_mode = "link"; }
        else if (a[ai] == "-per-module-emit" && ai + 1 < a.len()) { pm_mode = "emit"; pm_index = util.digits_to_i32(a[ai + 1]); ai = ai + 1; }
        else if (a[ai] == "-cache-dir" && ai + 1 < a.len()) { cache_dir = a[ai + 1]; ai = ai + 1; }
        else if (a[ai] == "-plan" && ai + 1 < a.len()) { plan_file = a[ai + 1]; ai = ai + 1; }
        else if (a[ai] == "-func-range" && ai + 1 < a.len()) {
            // "LO:HI" — digits_to_i32 stops at ':' for LO; slice past it for HI.
            var rng: string = a[ai + 1];
            var ci: i32 = 0;
            while (ci < rng.len() && rng[ci] != 58) { ci = ci + 1; }  // 58 = ':'
            pm_lo = util.digits_to_i32(rng);
            if (ci + 1 <= rng.len()) { pm_hi = util.digits_to_i32(rng[ci + 1:rng.len()]); }
            ai = ai + 1;
        }
        else if (entry_path == "") { entry_path = a[ai]; }
        ai = ai + 1;
    }
    if (entry_path == "" || pm_mode == "") {
        eprint("usage: wasm_modload_run <entry.fern> [-per-module-count | -per-module-manifest | -per-module-func-counts | -per-module-emit N [-func-range LO:HI] | -link [-plan FILE]] [-cache-dir DIR]\n");
        return 2;
    }
    var dir: string = modloader.dirname(entry_path);
    match (read_file(entry_path)) {
        Ok(src) => {
            var entry: parser.Module = parser.parse_module(lexer.tokenize(src));
            var loaded: flatten.LoadedModule[] = modloader.load_imports(dir, entry);
            return run_per_module(dir, entry_path, entry, loaded, pm_mode, pm_index, pm_lo, pm_hi, cache_dir, plan_file);
        },
        Err(e) => {
            eprint("wasm_modload_run: could not read entry file\n");
            return 1;
        },
    }
    return 3;
}
