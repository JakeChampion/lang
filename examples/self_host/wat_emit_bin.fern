// examples/self_host/wat_emit_bin.fern — the module-walker + opcode
// encoder: the back end of the self-hosted *binary* wasm emitter. Walks
// the parsed WAT SExpr tree (from wat_parse.fern) and emits a wasm binary
// module via the leb128 + wat_encode primitives. Pipeline:
//   tokenize (wat_lex) -> parse (wat_parse) -> ENCODE (this) -> .wasm
//
// Coverage: integer / control-flow / i32+i64+f64 / struct / string / map
// / closure programs — i.e. the full core-module shape emit_module
// produces. Sections are emitted in binary id order (type, import, func,
// table, memory, global, export, elem, code, data). The type section
// holds the named `(type $c …)` declarations first (referenced by
// call_indirect), then one functype per function (imports first; no
// dedup — valid, just slightly larger), so a function's type index is
// offset by the named-type count. Folded instructions encode post-order
// (operands then operator) with per-instruction immediate handling, and a
// control-frame stack resolves br / br_if label depths.
//
// Depends on leb128.fern, wat_lex.fern (WatTok) and wat_parse.fern (SExpr)
// but is otherwise import-free, so the encoder driver imports all of them
// and the unit test concatenates the sources + a driver.

// ---- small helpers -------------------------------------------------------

// index_of_str returns the index of `n` in `xs`, or -1. (A local copy so
// this module stays usable on its own / concatenated.)
function index_of_str(xs: string[], n: string): i32 {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == n) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// node_head returns the head-atom text of a list node ("" if not a list
// or the head isn't an atom).
function node_head(n: SExpr): string {
    if (n.kind == 0 && n.items.len() > 0 && n.items[0].kind == 2) { return n.items[0].text; }
    return "";
}

// parse_dec parses a (possibly negative) decimal integer.
function parse_dec(s: string): i32 {
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == 45) { neg = true; i = 1; }
    var v: i32 = 0;
    while (i < s.len()) {
        v = v * 10 + (s[i] - 48);
        i = i + 1;
    }
    if (neg) { return 0 - v; }
    return v;
}

// parse_dec_i64 parses a (possibly negative) decimal integer as i64.
function parse_dec_i64(s: string): i64 {
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == 45) { neg = true; i = 1; }
    var v: i64 = 0;
    while (i < s.len()) {
        v = v * 10 + ((s[i] - 48) as i64);
        i = i + 1;
    }
    var z: i64 = 0;
    if (neg) { return z - v; }
    return v;
}

// parse_f64 parses a decimal float literal (sign, integer part, optional
// fraction, optional e±exponent) into an f64. NOTE: this digit-by-digit
// accumulation is the nearest f64 for exactly-representable literals and
// within ~1 ULP otherwise — fine for the values emit_module produces and
// the truncate-to-int results the tests assert, but not a bit-exact strtod
// for every decimal.
function parse_f64(s: string): f64 {
    var i: i32 = 0;
    var neg: boolean = false;
    if (s.len() > 0 && s[0] == 45) { neg = true; i = 1; }
    var v: f64 = 0.0;
    while (i < s.len() && s[i] >= 48 && s[i] <= 57) {
        v = v * 10.0 + ((s[i] - 48) as f64);
        i = i + 1;
    }
    if (i < s.len() && s[i] == 46) {        // '.'
        i = i + 1;
        var scale: f64 = 0.1;
        while (i < s.len() && s[i] >= 48 && s[i] <= 57) {
            v = v + ((s[i] - 48) as f64) * scale;
            scale = scale / 10.0;
            i = i + 1;
        }
    }
    if (i < s.len() && (s[i] == 101 || s[i] == 69)) {   // 'e' / 'E'
        i = i + 1;
        var eneg: boolean = false;
        if (i < s.len() && s[i] == 45) { eneg = true; i = i + 1; }
        else if (i < s.len() && s[i] == 43) { i = i + 1; }
        var exp: i32 = 0;
        while (i < s.len() && s[i] >= 48 && s[i] <= 57) { exp = exp * 10 + (s[i] - 48); i = i + 1; }
        var p: f64 = 1.0;
        var k: i32 = 0;
        while (k < exp) { p = p * 10.0; k = k + 1; }
        if (eneg) { v = v / p; } else { v = v * p; }
    }
    if (neg) { return 0.0 - v; }
    return v;
}

// hexval maps an ASCII hex digit to its value.
function hexval(c: i32): i32 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 97 + 10; }
    if (c >= 65 && c <= 70) { return c - 65 + 10; }
    return 0;
}

// data_bytes resolves a WAT data string's escapes (`\NN` hex, `\\`, `\"`,
// `\n`, `\t`) to raw bytes.
function data_bytes(s: string): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < s.len()) {
        var c: i32 = s[i];
        if (c == 92 && i + 1 < s.len()) {
            var n: i32 = s[i + 1];
            if (n == 110) { out = out.push(10); i = i + 2; }
            else if (n == 116) { out = out.push(9); i = i + 2; }
            else if (n == 92) { out = out.push(92); i = i + 2; }
            else if (n == 34) { out = out.push(34); i = i + 2; }
            else if (i + 2 < s.len()) {
                out = out.push(hexval(n) * 16 + hexval(s[i + 2]));
                i = i + 3;
            } else { out = out.push(c); i = i + 1; }
        } else {
            out = out.push(c);
            i = i + 1;
        }
    }
    return out;
}

// ---- function inventory --------------------------------------------------

// func_node returns the actual `(func …)` node for a module child: the
// child itself for a defined func, or the inner func of an import.
function func_node(child: SExpr): SExpr {
    if (node_head(child) == "import") { return child.items[child.items.len() - 1]; }
    return child;
}

// func_name returns a func node's `$name`.
function func_name(fnode: SExpr): string {
    return fnode.items[1].text;
}

// collect_func_names lists every function name in index order: import
// funcs first (in source order), then defined funcs.
function collect_func_names(mod: SExpr): string[] {
    var names: string[] = [];
    var i: i32 = 0;
    while (i < mod.items.len()) {
        if (node_head(mod.items[i]) == "import") { names = names.push(func_name(func_node(mod.items[i]))); }
        i = i + 1;
    }
    i = 0;
    while (i < mod.items.len()) {
        if (node_head(mod.items[i]) == "func") { names = names.push(func_name(mod.items[i])); }
        i = i + 1;
    }
    return names;
}

// func_param_types / func_result_types read a func node's signature.
// They scan from items[1] (skipping a leading `$name` atom if present, so
// they also work on the unnamed `(func …)` inside a `(type $c (func …))`
// declaration). A `(param …)` is either named-single (`(param $n i32)`) or
// a run of bare types (`(param i32 i32 …)`, the import / type-decl form).
function func_param_types(fnode: SExpr): string[] {
    var out: string[] = [];
    var i: i32 = 1;
    while (i < fnode.items.len()) {
        var c: SExpr = fnode.items[i];
        if (node_head(c) == "param") {
            if (c.items.len() >= 2 && c.items[1].text[0] == 36) {
                // `(param $name type)` — named single.
                out = out.push(c.items[2].text);
            } else {
                var j: i32 = 1;
                while (j < c.items.len()) { out = out.push(c.items[j].text); j = j + 1; }
            }
        }
        i = i + 1;
    }
    return out;
}

function func_result_types(fnode: SExpr): string[] {
    var out: string[] = [];
    var i: i32 = 1;
    while (i < fnode.items.len()) {
        var c: SExpr = fnode.items[i];
        if (node_head(c) == "result") {
            var j: i32 = 1;
            while (j < c.items.len()) { out = out.push(c.items[j].text); j = j + 1; }
        }
        i = i + 1;
    }
    return out;
}

// local_names lists a defined func's local index space: params first
// (named), then `(local $name type)` decls.
function local_names(fnode: SExpr): string[] {
    var out: string[] = [];
    var i: i32 = 2;
    while (i < fnode.items.len()) {
        var c: SExpr = fnode.items[i];
        if (node_head(c) == "param") {
            if (c.items.len() >= 2 && c.items[1].text[0] == 36) { out = out.push(c.items[1].text); }
        }
        i = i + 1;
    }
    i = 2;
    while (i < fnode.items.len()) {
        var c2: SExpr = fnode.items[i];
        if (node_head(c2) == "local") { out = out.push(c2.items[1].text); }
        i = i + 1;
    }
    return out;
}

// local_decl_types lists the types of the `(local …)` decls (for the code
// section's locals vec).
function local_decl_types(fnode: SExpr): string[] {
    var out: string[] = [];
    var i: i32 = 2;
    while (i < fnode.items.len()) {
        var c: SExpr = fnode.items[i];
        if (node_head(c) == "local") { out = out.push(c.items[2].text); }
        i = i + 1;
    }
    return out;
}

// ---- instruction encoding ------------------------------------------------

// arith_opcode maps a binary/unary i32 arithmetic / comparison op to its
// wasm byte (0 if not one of them). Binary ops take two stack operands,
// the unary `i32.eqz` one.
function arith_opcode(op: string): i32 {
    if (op == "i32.add") { return 106; }   // 0x6a
    if (op == "i32.sub") { return 107; }
    if (op == "i32.mul") { return 108; }
    if (op == "i32.div_s") { return 109; }
    if (op == "i32.div_u") { return 110; }
    if (op == "i32.rem_s") { return 111; }
    if (op == "i32.rem_u") { return 112; }
    if (op == "i32.and") { return 113; }
    if (op == "i32.or") { return 114; }
    if (op == "i32.xor") { return 115; }
    if (op == "i32.shl") { return 116; }   // 0x74
    if (op == "i32.shr_s") { return 117; } // 0x75
    if (op == "i32.shr_u") { return 118; } // 0x76
    if (op == "i32.rotl") { return 119; }
    if (op == "i32.rotr") { return 120; }
    if (op == "i32.eq") { return 70; }     // 0x46
    if (op == "i32.ne") { return 71; }
    if (op == "i32.lt_s") { return 72; }
    if (op == "i32.lt_u") { return 73; }
    if (op == "i32.gt_s") { return 74; }
    if (op == "i32.gt_u") { return 75; }
    if (op == "i32.le_s") { return 76; }
    if (op == "i32.le_u") { return 77; }
    if (op == "i32.ge_s") { return 78; }
    if (op == "i32.ge_u") { return 79; }   // 0x4f
    if (op == "i32.eqz") { return 69; }    // 0x45
    // i64 arithmetic / comparison (binary; i64.eqz is unary).
    if (op == "i64.add") { return 124; }   // 0x7c
    if (op == "i64.sub") { return 125; }
    if (op == "i64.mul") { return 126; }
    if (op == "i64.div_s") { return 127; }
    if (op == "i64.div_u") { return 128; }
    if (op == "i64.rem_s") { return 129; }
    if (op == "i64.rem_u") { return 130; }
    if (op == "i64.and") { return 131; }
    if (op == "i64.or") { return 132; }
    if (op == "i64.xor") { return 133; }
    if (op == "i64.shl") { return 134; }
    if (op == "i64.shr_s") { return 135; }
    if (op == "i64.shr_u") { return 136; }
    if (op == "i64.rotl") { return 137; }
    if (op == "i64.rotr") { return 138; }
    if (op == "i64.eqz") { return 80; }    // 0x50
    if (op == "i64.eq") { return 81; }
    if (op == "i64.ne") { return 82; }
    if (op == "i64.lt_s") { return 83; }
    if (op == "i64.lt_u") { return 84; }
    if (op == "i64.gt_s") { return 85; }
    if (op == "i64.gt_u") { return 86; }
    if (op == "i64.le_s") { return 87; }
    if (op == "i64.le_u") { return 88; }
    if (op == "i64.ge_s") { return 89; }
    if (op == "i64.ge_u") { return 90; }   // 0x5a
    // Numeric conversions (all unary — one stack operand).
    if (op == "i32.wrap_i64") { return 167; }       // 0xa7
    if (op == "i64.extend_i32_s") { return 172; }   // 0xac
    if (op == "i64.extend_i32_u") { return 173; }   // 0xad
    if (op == "i32.trunc_f64_s") { return 170; }    // 0xaa
    if (op == "i32.trunc_f64_u") { return 171; }    // 0xab
    if (op == "i64.trunc_f64_s") { return 176; }    // 0xb0
    if (op == "i64.trunc_f64_u") { return 177; }    // 0xb1
    if (op == "f64.convert_i32_s") { return 183; }  // 0xb7
    if (op == "f64.convert_i32_u") { return 184; }  // 0xb8
    if (op == "f64.convert_i64_s") { return 185; }  // 0xb9
    if (op == "f64.convert_i64_u") { return 186; }  // 0xba
    // f64 comparison (binary) + arithmetic (binary, except the unary math
    // ops abs/neg/ceil/floor/trunc/nearest/sqrt).
    if (op == "f64.eq") { return 97; }     // 0x61
    if (op == "f64.ne") { return 98; }
    if (op == "f64.lt") { return 99; }
    if (op == "f64.gt") { return 100; }
    if (op == "f64.le") { return 101; }
    if (op == "f64.ge") { return 102; }    // 0x66
    if (op == "f64.abs") { return 153; }   // 0x99
    if (op == "f64.neg") { return 154; }
    if (op == "f64.ceil") { return 155; }
    if (op == "f64.floor") { return 156; }
    if (op == "f64.trunc") { return 157; }
    if (op == "f64.nearest") { return 158; }
    if (op == "f64.sqrt") { return 159; }  // 0x9f
    if (op == "f64.add") { return 160; }   // 0xa0
    if (op == "f64.sub") { return 161; }
    if (op == "f64.mul") { return 162; }
    if (op == "f64.div") { return 163; }
    if (op == "f64.min") { return 164; }
    if (op == "f64.max") { return 165; }
    if (op == "f64.copysign") { return 166; } // 0xa6
    return 0;
}

// labels_push returns a FRESH frame stack = `labels` + `x`. A copy is
// required because `arr.push` mutates in place when the backing array has
// spare capacity — pushing onto the caller's stack directly would corrupt
// the enclosing frame's stack for its later siblings (turning a deeper
// `br` depth into a wrong one).
function labels_push(labels: string[], x: string): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < labels.len()) { out = out.push(labels[i]); i = i + 1; }
    out = out.push(x);
    return out;
}

// label_depth resolves a WAT `$label` to the relative depth wasm `br` /
// `br_if` use: 0 = innermost enclosing frame. `labels` is the frame stack
// (block / loop / if), innermost last; the most recent match wins.
function label_depth(labels: string[], name: string): i32 {
    var i: i32 = labels.len() - 1;
    while (i >= 0) {
        if (labels[i] == name) { return labels.len() - 1 - i; }
        i = i - 1;
    }
    return 0;
}

// memarg_align gives the natural alignment (log2 of access size) for a
// memory op; the self-host emits bare loads/stores, so natural alignment +
// offset 0.
function memarg_align(op: string): i32 {
    if (op == "i32.load8_u" || op == "i32.load8_s" || op == "i32.store8") { return 0; }
    if (op == "i32.load16_u" || op == "i32.load16_s" || op == "i32.store16") { return 1; }
    if (op == "i64.load" || op == "f64.load" || op == "i64.store" || op == "f64.store") { return 3; }
    return 2;
}

// mem_load_opcode / mem_store_opcode: the byte for a memory op (0 if not).
function mem_load_opcode(op: string): i32 {
    if (op == "i32.load") { return 40; }
    if (op == "i64.load") { return 41; }
    if (op == "f64.load") { return 43; }
    if (op == "i32.load8_u") { return 45; }
    if (op == "i32.load8_s") { return 44; }
    return 0;
}
function mem_store_opcode(op: string): i32 {
    if (op == "i32.store") { return 54; }
    if (op == "i64.store") { return 55; }
    if (op == "f64.store") { return 57; }
    if (op == "i32.store8") { return 58; }
    return 0;
}

// enc_instr encodes one folded instruction node post-order. `labels` is
// the enclosing control-frame stack (for br / br_if depth resolution).
function enc_instr(node: SExpr, lnames: string[], fnames: string[], gnames: string[], labels: string[], tnames: string[]): i32[] {
    var out: i32[] = [];
    var op: string = node.items[0].text;
    if (op == "i32.const") {
        out = out.push(65);
        return leb_i32(out, parse_dec(node.items[1].text));
    }
    if (op == "i64.const") {
        out = out.push(66);
        return leb_i64(out, parse_dec_i64(node.items[1].text));
    }
    if (op == "f64.const") {
        // 0x44 then the 8-byte little-endian IEEE-754 double. The value's
        // bits come from f64_bits() on the parsed literal.
        out = out.push(68);
        var bits: i64 = f64_bits(parse_f64(node.items[1].text));
        var k: i32 = 0;
        while (k < 8) {
            out = out.push(((bits >> (k * 8)) & 255) as i32);
            k = k + 1;
        }
        return out;
    }
    if (op == "local.get") {
        out = out.push(32);
        return leb_u32(out, index_of_str(lnames, node.items[1].text));
    }
    if (op == "local.set") {
        out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
        out = out.push(33);
        return leb_u32(out, index_of_str(lnames, node.items[1].text));
    }
    if (op == "local.tee") {
        out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
        out = out.push(34);
        return leb_u32(out, index_of_str(lnames, node.items[1].text));
    }
    if (op == "global.get") {
        out = out.push(35);
        return leb_u32(out, index_of_str(gnames, node.items[1].text));
    }
    if (op == "global.set") {
        out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
        out = out.push(36);
        return leb_u32(out, index_of_str(gnames, node.items[1].text));
    }
    if (op == "return") {
        if (node.items.len() > 1) { out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames)); }
        out = out.push(15);
        return out;
    }
    if (op == "drop") {
        out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
        out = out.push(26);
        return out;
    }
    if (op == "call") {
        var k: i32 = 2;
        while (k < node.items.len()) {
            out = wcat(out, enc_instr(node.items[k], lnames, fnames, gnames, labels, tnames));
            k = k + 1;
        }
        out = out.push(16);
        return leb_u32(out, index_of_str(fnames, node.items[1].text));
    }
    if (op == "call_indirect") {
        // (call_indirect (type $c) <args…> <funcptr>) — the type ref is
        // items[1]; the last operand is the table index (function pointer
        // on the stack top), the rest are call args. Args are pushed first,
        // then the table index, then 0x11 typeidx tableidx(0).
        var lasti: i32 = node.items.len() - 1;
        var k: i32 = 2;
        while (k < lasti) {
            out = wcat(out, enc_instr(node.items[k], lnames, fnames, gnames, labels, tnames));
            k = k + 1;
        }
        out = wcat(out, enc_instr(node.items[lasti], lnames, fnames, gnames, labels, tnames));
        out = out.push(17);    // 0x11
        out = leb_u32(out, index_of_str(tnames, node.items[1].items[1].text));
        return leb_u32(out, 0);    // table index 0
    }
    if (op == "memory.size") {
        out = out.push(63);    // 0x3f
        return out.push(0);    // reserved memory index
    }
    if (op == "memory.grow") {
        out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
        out = out.push(64);    // 0x40
        return out.push(0);    // reserved memory index
    }
    if (op == "br") {
        out = out.push(12);
        return leb_u32(out, label_depth(labels, node.items[1].text));
    }
    if (op == "br_if") {
        out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
        out = out.push(13);
        return leb_u32(out, label_depth(labels, node.items[1].text));
    }
    if (op == "block" || op == "loop") {
        var bi: i32 = 1;
        var label: string = "";
        if (node.items[1].kind == 2 && node.items[1].text[0] == 36) { label = node.items[1].text; bi = 2; }
        var bt: i32 = 64;
        if (bi < node.items.len() && node_head(node.items[bi]) == "result") {
            bt = valtype_byte(node.items[bi].items[1].text);
            bi = bi + 1;
        }
        if (op == "block") { out = out.push(2); } else { out = out.push(3); }
        out = out.push(bt);
        var inner: string[] = labels_push(labels, label);
        while (bi < node.items.len()) {
            out = wcat(out, enc_instr(node.items[bi], lnames, fnames, gnames, inner, tnames));
            bi = bi + 1;
        }
        out = out.push(11);        // end
        return out;
    }
    if (op == "if") {
        var ci: i32 = 1;
        var ibt: i32 = 64;
        if (node_head(node.items[1]) == "result") {
            ibt = valtype_byte(node.items[1].items[1].text);
            ci = 2;
        }
        // condition (stack operand) first
        out = wcat(out, enc_instr(node.items[ci], lnames, fnames, gnames, labels, tnames));
        out = out.push(4);         // if
        out = out.push(ibt);
        var iinner: string[] = labels_push(labels, "");
        var thenN: SExpr = node.items[ci + 1];
        var tk: i32 = 1;
        while (tk < thenN.items.len()) {
            out = wcat(out, enc_instr(thenN.items[tk], lnames, fnames, gnames, iinner, tnames));
            tk = tk + 1;
        }
        if (node.items.len() > ci + 2 && node_head(node.items[ci + 2]) == "else") {
            out = out.push(5);     // else
            var elseN: SExpr = node.items[ci + 2];
            var ek: i32 = 1;
            while (ek < elseN.items.len()) {
                out = wcat(out, enc_instr(elseN.items[ek], lnames, fnames, gnames, iinner, tnames));
                ek = ek + 1;
            }
        }
        out = out.push(11);        // end
        return out;
    }
    var ml: i32 = mem_load_opcode(op);
    if (ml != 0) {
        out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
        out = out.push(ml);
        out = leb_u32(out, memarg_align(op));
        out = leb_u32(out, 0);     // offset
        return out;
    }
    var ms: i32 = mem_store_opcode(op);
    if (ms != 0) {
        out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
        out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
        out = out.push(ms);
        out = leb_u32(out, memarg_align(op));
        out = leb_u32(out, 0);
        return out;
    }
    if (op == "select") {
        // (select a b cond) — three stack operands, then 0x1b.
        out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
        out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
        out = wcat(out, enc_instr(node.items[3], lnames, fnames, gnames, labels, tnames));
        out = out.push(27);    // 0x1b
        return out;
    }
    var ao: i32 = arith_opcode(op);
    if (ao != 0) {
        // unary (eqz) takes one operand; the rest take two.
        out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
        if (op != "i32.eqz" && node.items.len() > 2) {
            out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
        }
        out = out.push(ao);
        return out;
    }
    return out;
}

// ---- section builders ----------------------------------------------------

// enc_locals_vec compresses a func's `(local …)` types into runs of
// (count, valtype), the code section's locals encoding.
function enc_locals_vec(types: string[]): i32[] {
    // count distinct runs
    var runs: i32 = 0;
    var i: i32 = 0;
    while (i < types.len()) {
        if (i == 0 || types[i] != types[i - 1]) { runs = runs + 1; }
        i = i + 1;
    }
    var body: i32[] = [];
    i = 0;
    while (i < types.len()) {
        var n: i32 = 1;
        while (i + n < types.len() && types[i + n] == types[i]) { n = n + 1; }
        body = leb_u32(body, n);
        body = body.push(valtype_byte(types[i]));
        i = i + n;
    }
    return wvec(runs, body);
}

// enc_functype emits `0x60 vec(params) vec(results)`.
function enc_functype(params: string[], results: string[]): i32[] {
    var o: i32[] = [];
    o = o.push(96);
    var pb: i32[] = [];
    var i: i32 = 0;
    while (i < params.len()) { pb = pb.push(valtype_byte(params[i])); i = i + 1; }
    o = wcat(o, wvec(params.len(), pb));
    var rb: i32[] = [];
    i = 0;
    while (i < results.len()) { rb = rb.push(valtype_byte(results[i])); i = i + 1; }
    o = wcat(o, wvec(results.len(), rb));
    return o;
}

// body_instrs returns a defined func's body instruction nodes (skipping
// the param/result/local declarations).
function body_instrs(fnode: SExpr): SExpr[] {
    var out: SExpr[] = [];
    var i: i32 = 2;
    while (i < fnode.items.len()) {
        var c: SExpr = fnode.items[i];
        var h: string = node_head(c);
        if (h != "param" && h != "result" && h != "local") { out = out.push(c); }
        i = i + 1;
    }
    return out;
}

// emit_binary walks the `(module …)` tree and returns the wasm binary.
function emit_binary(mod: SExpr): i32[] {
    var fnames: string[] = collect_func_names(mod);
    var gnames: string[] = [];
    var gi: i32 = 0;
    while (gi < mod.items.len()) {
        if (node_head(mod.items[gi]) == "global") { gnames = gnames.push(mod.items[gi].items[1].text); }
        gi = gi + 1;
    }

    // Func nodes in index order: imports first, then defined.
    var importNodes: SExpr[] = [];
    var definedNodes: SExpr[] = [];
    var i: i32 = 0;
    while (i < mod.items.len()) {
        if (node_head(mod.items[i]) == "import") { importNodes = importNodes.push(mod.items[i]); }
        if (node_head(mod.items[i]) == "func") { definedNodes = definedNodes.push(mod.items[i]); }
        i = i + 1;
    }

    // Named `(type $c (func …))` declarations (for call_indirect, used by
    // closures). They occupy the first type-section indices, in source
    // order; `tnames` maps each name to its index.
    var tnames: string[] = [];
    var namedTypeBody: i32[] = [];
    i = 0;
    while (i < mod.items.len()) {
        if (node_head(mod.items[i]) == "type") {
            var tn: SExpr = mod.items[i];
            tnames = tnames.push(tn.items[1].text);
            var tf: SExpr = tn.items[2];   // the inner (func …)
            namedTypeBody = wcat(namedTypeBody, enc_functype(func_param_types(tf), func_result_types(tf)));
        }
        i = i + 1;
    }
    var ntypes: i32 = tnames.len();

    // --- type section: named types first, then one functype per function
    // (imports, then defined). A function's type index is offset by ntypes.
    var nfuncs: i32 = importNodes.len() + definedNodes.len();
    var typeBody: i32[] = namedTypeBody;
    i = 0;
    while (i < importNodes.len()) {
        var fn: SExpr = func_node(importNodes[i]);
        typeBody = wcat(typeBody, enc_functype(func_param_types(fn), func_result_types(fn)));
        i = i + 1;
    }
    i = 0;
    while (i < definedNodes.len()) {
        typeBody = wcat(typeBody, enc_functype(func_param_types(definedNodes[i]), func_result_types(definedNodes[i])));
        i = i + 1;
    }

    // --- import section. ---
    var impBody: i32[] = [];
    i = 0;
    while (i < importNodes.len()) {
        var imp: SExpr = importNodes[i];
        impBody = wname(impBody, imp.items[1].text);
        impBody = wname(impBody, imp.items[2].text);
        impBody = impBody.push(0);             // import kind: func
        impBody = leb_u32(impBody, ntypes + i); // type index (after named types)
        i = i + 1;
    }

    // --- function section: defined funcs' type indices. ---
    var funcBody: i32[] = [];
    i = 0;
    while (i < definedNodes.len()) {
        funcBody = leb_u32(funcBody, ntypes + importNodes.len() + i);
        i = i + 1;
    }

    // --- memory section: limits {min}. ---
    var memBody: i32[] = [];
    var memCount: i32 = 0;
    i = 0;
    while (i < mod.items.len()) {
        if (node_head(mod.items[i]) == "memory") {
            var mn: SExpr = mod.items[i];
            // min is the last atom child (after an optional (export …)).
            var minv: i32 = parse_dec(mn.items[mn.items.len() - 1].text);
            memBody = memBody.push(0);
            memBody = leb_u32(memBody, minv);
            memCount = memCount + 1;
        }
        i = i + 1;
    }

    // --- global section. ---
    var globBody: i32[] = [];
    var globCount: i32 = 0;
    i = 0;
    while (i < mod.items.len()) {
        if (node_head(mod.items[i]) == "global") {
            var gn: SExpr = mod.items[i];
            // (global $name (mut i32) (i32.const N))
            globBody = globBody.push(valtype_byte("i32"));
            globBody = globBody.push(1);       // mutable
            globBody = wcat(globBody, enc_instr(gn.items[gn.items.len() - 1], [], fnames, gnames, [], []));
            globBody = globBody.push(11);      // end
            globCount = globCount + 1;
        }
        i = i + 1;
    }

    // --- export section: any inline memory export + the (export …) decls. ---
    var expBody: i32[] = [];
    var expCount: i32 = 0;
    i = 0;
    while (i < mod.items.len()) {
        if (node_head(mod.items[i]) == "memory") {
            // (memory (export "memory") N) — inline export of mem 0.
            var mm: SExpr = mod.items[i];
            var j: i32 = 1;
            while (j < mm.items.len()) {
                if (node_head(mm.items[j]) == "export") {
                    expBody = wname(expBody, mm.items[j].items[1].text);
                    expBody = expBody.push(2); // mem
                    expBody = leb_u32(expBody, 0);
                    expCount = expCount + 1;
                }
                j = j + 1;
            }
        }
        if (node_head(mod.items[i]) == "export") {
            var ex: SExpr = mod.items[i];
            expBody = wname(expBody, ex.items[1].text);
            expBody = expBody.push(0);         // func
            expBody = leb_u32(expBody, index_of_str(fnames, ex.items[2].items[1].text));
            expCount = expCount + 1;
        }
        i = i + 1;
    }

    // --- code section. ---
    var codeBody: i32[] = [];
    i = 0;
    while (i < definedNodes.len()) {
        var fnode: SExpr = definedNodes[i];
        var lnames: string[] = local_names(fnode);
        var fbody: i32[] = enc_locals_vec(local_decl_types(fnode));
        var instrs: SExpr[] = body_instrs(fnode);
        var k: i32 = 0;
        while (k < instrs.len()) {
            fbody = wcat(fbody, enc_instr(instrs[k], lnames, fnames, gnames, [], tnames));
            k = k + 1;
        }
        fbody = fbody.push(11);                // end
        codeBody = leb_u32(codeBody, fbody.len());
        codeBody = wcat(codeBody, fbody);
        i = i + 1;
    }

    // --- data section. ---
    var dataBody: i32[] = [];
    var dataCount: i32 = 0;
    i = 0;
    while (i < mod.items.len()) {
        if (node_head(mod.items[i]) == "data") {
            var dn: SExpr = mod.items[i];
            dataBody = dataBody.push(0);       // active, memory 0
            dataBody = wcat(dataBody, enc_instr(dn.items[1], [], fnames, gnames, [], [])); // offset (i32.const N)
            dataBody = dataBody.push(11);      // end
            var bytes: i32[] = data_bytes(dn.items[2].text);
            dataBody = leb_u32(dataBody, bytes.len());
            dataBody = wcat(dataBody, bytes);
            dataCount = dataCount + 1;
        }
        i = i + 1;
    }

    // --- table section: `(table N funcref)` → funcref limits {min N}. ---
    var tableBody: i32[] = [];
    var tableCount: i32 = 0;
    i = 0;
    while (i < mod.items.len()) {
        if (node_head(mod.items[i]) == "table") {
            var tbn: SExpr = mod.items[i];
            tableBody = tableBody.push(112);   // 0x70 funcref
            tableBody = tableBody.push(0);     // limits: no max
            tableBody = leb_u32(tableBody, parse_dec(tbn.items[1].text));
            tableCount = tableCount + 1;
        }
        i = i + 1;
    }

    // --- elem section: `(elem (i32.const N) $f …)` → active segment on
    // table 0 with an offset expr + a vec of function indices. ---
    var elemBody: i32[] = [];
    var elemCount: i32 = 0;
    i = 0;
    while (i < mod.items.len()) {
        if (node_head(mod.items[i]) == "elem") {
            var en: SExpr = mod.items[i];
            elemBody = elemBody.push(0);       // flags: active, table 0
            elemBody = wcat(elemBody, enc_instr(en.items[1], [], fnames, gnames, [], []));
            elemBody = elemBody.push(11);      // end
            var fb: i32[] = [];
            var ei: i32 = 2;
            while (ei < en.items.len()) {
                fb = leb_u32(fb, index_of_str(fnames, en.items[ei].text));
                ei = ei + 1;
            }
            elemBody = wcat(elemBody, wvec(en.items.len() - 2, fb));
            elemCount = elemCount + 1;
        }
        i = i + 1;
    }

    // --- assemble the module (sections in binary id order). ---
    var out: i32[] = wmagic();
    out = wcat(out, wsection(1, wvec(ntypes + nfuncs, typeBody)));
    out = wcat(out, wsection(2, wvec(importNodes.len(), impBody)));
    out = wcat(out, wsection(3, wvec(definedNodes.len(), funcBody)));
    if (tableCount > 0) { out = wcat(out, wsection(4, wvec(tableCount, tableBody))); }
    if (memCount > 0) { out = wcat(out, wsection(5, wvec(memCount, memBody))); }
    if (globCount > 0) { out = wcat(out, wsection(6, wvec(globCount, globBody))); }
    if (expCount > 0) { out = wcat(out, wsection(7, wvec(expCount, expBody))); }
    if (elemCount > 0) { out = wcat(out, wsection(9, wvec(elemCount, elemBody))); }
    out = wcat(out, wsection(10, wvec(definedNodes.len(), codeBody)));
    if (dataCount > 0) { out = wcat(out, wsection(11, wvec(dataCount, dataBody))); }
    return out;
}
