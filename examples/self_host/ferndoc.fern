// examples/self_host/ferndoc.fern — doc-comment association for the
// self-hosted doc generator (#6642), the port of cmd/ferndoc's
// commentWalker + moduleIntro.
//
// The lexer hands back a flat comment list in source order (#6739) and the
// parser hands back declarations carrying `line` / `col` / `is_pub` (#6718,
// #6731). Neither knows about the other. This file is the join: which comment
// block is which declaration's documentation.
//
// That join is where the semantics live, and they are not obvious:
//
//   - A comment block is a RUN — comments on consecutive lines. A blank line
//     between two comments starts a new run, which is how a file-header
//     comment stays out of the first declaration's doc.
//   - A run documents a declaration only when it ends on the line DIRECTLY
//     above it. A run with a blank line before the declaration documents
//     nothing.
//   - The walk is stateful and single-pass. A cursor advances past each run it
//     consumes or skips, so a comment can never be handed to two declarations,
//     and the declarations must be visited in source order for it to be right.
//
// # Why it mirrors native rather than improving on it
//
// The gate for this port is a byte-for-byte differential against `cmd/ferndoc`
// over `internal/stdlib/std/`, so a divergence is a failure even when it is an
// improvement. Two places where that matters:
//
//   - Association is by LINE alone. A trailing comment on the line above a
//     declaration is therefore absorbed as that declaration's doc, even though
//     it visibly belongs to the code it trails. Native does this; so does this.
//   - Only PUBLIC declarations take. A private declaration between a comment
//     run and a public one does not consume the run — but the cursor's
//     run-skipping does, because the run no longer ends directly above the
//     declaration that asks.
//
// # What is not here yet
//
// Four things the self-host FRONT END does not carry, each of which stops a
// page matching native's bytes and none of which can be fixed from here:
//
//   - `trait` reaches the parser only as `TraitReq`, which has no visibility,
//     so `pub trait` cannot be rendered;
//   - `const` desugars to a zero-arg function (`FuncDecl.is_const`) rather than
//     surviving as its own declaration;
//   - `parse_func_decl` keeps `type_params: bounded_tps`, so an unbounded `[T]`
//     survives only as a COUNT and `map[T, U]` cannot be spelled back;
//   - there is no `str` type distinct from `string` (the gap #6604 landed on),
//     so a `str` return renders as `string`.
//
// The page differential lists exactly which stdlib module each of these costs,
// and fails if one is fixed without the list being updated.

import "./lexer";
import "./parser";
import "./util";

// ---- results -----------------------------------------------------------

// DocDecl is one documented declaration. `kind` is the source keyword
// ("function", "struct", "enum"), which is what a renderer dispatches on;
// `doc` is the associated comment run, its lines joined by newline, or empty
// when nothing documents it.
pub struct DocDecl {
    kind: string,
    name: string,
    line: i32,
    col: i32,
    doc: string,
}

// TakeResult is `take_doc`'s pair: the run it consumed and where the cursor
// ended up. Returned rather than mutated because the walker's state is the
// cursor and nothing else — native carries it on a struct receiver.
pub struct TakeResult { doc: string, cursor: i32 }

// ---- text --------------------------------------------------------------

// is_space matches Go's unicode.IsSpace for the ASCII range, which is all
// TrimSpace can see here: comment text is raw source bytes.
function is_space(b: i32): boolean {
    return b == 32 || b == 9 || b == 10 || b == 11 || b == 12 || b == 13;
}

// own copies a `str` view into an owned string. A `str` coerces into a string
// PARAMETER but not into a return type or a struct field, so the round trip
// through a parameter is how the self-host front end already materialises a
// slice — lexer.fern's comment_tok does the same for the same reason.
function own(v: string): string { return v; }

// trim_space is strings.TrimSpace over a comment's text. Comment bodies keep
// the space after `//`, so trimming is what makes two comment lines join into
// readable prose.
pub function trim_space(s: string): string {
    var a: i32 = 0;
    var b: i32 = s.len();
    while (a < b && is_space(s[a] as i32)) { a = a + 1; }
    while (b > a && is_space(s[b - 1] as i32)) { b = b - 1; }
    return own(s[a:b]);
}

// ---- the walk ----------------------------------------------------------

// run_end is the index of the last comment in the run starting at `start` — a
// run being comments on consecutive lines.
function run_end(cs: lexer.Comment[], start: i32): i32 {
    var e: i32 = start;
    while (e + 1 < cs.len() && cs[e + 1].line == cs[e].line + 1) { e = e + 1; }
    return e;
}

// join_run renders comments [start, end] as a doc string: each line trimmed,
// joined by newline.
function join_run(cs: lexer.Comment[], start: i32, end: i32): string {
    var out: string = "";
    var i: i32 = start;
    while (i <= end) {
        if (i > start) { out = out + "\n"; }
        out = out + trim_space(cs[i].text);
        i = i + 1;
    }
    return out;
}

// take_doc is cmd/ferndoc's commentWalker.take: the run that ends on the line
// directly above `decl_line`, with the cursor advanced past it.
//
// The skip loop is the subtle half. It walks past runs that end before
// `decl_line - 1` — those document nothing that is being asked about — but it
// stops the moment it finds a run that DOES reach `decl_line - 1`, because
// that is the answer. Without the stop, a file whose header comment is
// followed by a documented declaration would consume both.
pub function take_doc(cs: lexer.Comment[], cursor: i32, decl_line: i32): TakeResult {
    var cur: i32 = cursor;
    while (cur < cs.len() && cs[cur].line < decl_line - 1) {
        var e0: i32 = run_end(cs, cur);
        if (cs[e0].line == decl_line - 1) { return TakeResult { doc: join_run(cs, cur, e0), cursor: e0 + 1 }; }
        cur = e0 + 1;
    }
    if (cur >= cs.len()) { return TakeResult { doc: "", cursor: cur }; }
    var e: i32 = run_end(cs, cur);
    if (cs[e].line != decl_line - 1) { return TakeResult { doc: "", cursor: cur }; }
    return TakeResult { doc: join_run(cs, cur, e), cursor: e + 1 };
}

// module_intro is the file-header block: the run of comments starting on line
// 1, joined by SPACE rather than newline (it renders as a paragraph, where a
// declaration's doc renders under its signature).
//
// It is not an intro when it runs straight into the first declaration — then
// it is that declaration's doc and take_doc will claim it. `first_decl_line`
// of 0 means the module declares nothing, so there is nothing to run into.
pub function module_intro(cs: lexer.Comment[], first_decl_line: i32): string {
    if (cs.len() == 0) { return ""; }
    if (cs[0].line != 1) { return ""; }
    var end: i32 = 0;
    var i: i32 = 0;
    while (i < cs.len()) {
        if (cs[i].line != i + 1) { break; }
        end = i + 1;
        i = i + 1;
    }
    if (end == 0) { return ""; }
    if (first_decl_line > 0 && first_decl_line == end + 1) { return ""; }
    var out: string = "";
    var j: i32 = 0;
    while (j < end) {
        if (j > 0) { out = out + " "; }
        out = out + trim_space(cs[j].text);
        j = j + 1;
    }
    return out;
}

// ---- declarations ------------------------------------------------------

// public_decls collects the declarations a doc page covers, in source order.
//
// Public only, and functions additionally drop the `__`-prefixed internals —
// both filters are native's, and both matter to the WALK as well as the
// output: a declaration that is not collected never calls take_doc, so the
// run above it is left for the cursor's skip logic rather than consumed.
//
// Sorted by (line, col) because the parser hands back separate lists per decl
// kind and the walk is only correct in source order.
pub function public_decls(mod: parser.Module): DocDecl[] {
    var out: DocDecl[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: parser.FuncDecl = mod.funcs[i];
        if (fd.is_pub && !starts_with_dunder(fd.name)) {
            out = insert_sorted(out, DocDecl { kind: "function", name: fd.name, line: fd.line, col: fd.col, doc: "" });
        }
        i = i + 1;
    }
    var si: i32 = 0;
    while (si < mod.structs.len()) {
        var sd: parser.StructDecl = mod.structs[si];
        // A desugared enum variant is a struct decl carrying its enum's name
        // in enum_owner. It is not a declaration anyone wrote, so it is not
        // one anyone documents.
        if (sd.is_pub && sd.enum_owner.len() == 0) {
            out = insert_sorted(out, DocDecl { kind: "struct", name: sd.name, line: sd.line, col: sd.col, doc: "" });
        }
        si = si + 1;
    }
    var ei: i32 = 0;
    while (ei < mod.enums.len()) {
        var ed: parser.EnumDecl = mod.enums[ei];
        if (ed.is_pub) {
            out = insert_sorted(out, DocDecl { kind: "enum", name: ed.name, line: ed.line, col: ed.col, doc: "" });
        }
        ei = ei + 1;
    }
    // Type aliases are deliberately absent: cmd/ferndoc's renderModule unions
    // funcs, structs, enums, consts and traits, and never touches TypeAlias.
    // Collecting them here would not just add pages native does not have — it
    // would advance the WALK, so an alias sitting above a documented
    // declaration would eat the run that declaration is owed.
    return out;
}

function starts_with_dunder(name: string): boolean {
    return name.len() >= 2 && (name[0] as i32) == 95 && (name[1] as i32) == 95;
}

// insert_sorted places `d` at its (line, col) position. Insertion rather than a
// sort pass because the lists are short and the walk needs a total order, not
// a fast one.
function insert_sorted(xs: DocDecl[], d: DocDecl): DocDecl[] {
    var out: DocDecl[] = [];
    var placed: boolean = false;
    var i: i32 = 0;
    while (i < xs.len()) {
        if (!placed && before(d, xs[i])) { out = out.append(d); placed = true; }
        out = out.append(xs[i]);
        i = i + 1;
    }
    if (!placed) { out = out.append(d); }
    return out;
}

function before(a: DocDecl, b: DocDecl): boolean {
    if (a.line != b.line) { return a.line < b.line; }
    return a.col < b.col;
}

// first_decl_line is the earliest line any declaration starts on, or 0 when
// the module declares nothing. It reads EVERY declaration, public or not:
// module_intro asks whether the header comment runs into the code below it,
// and a private declaration ends the header just as a public one does.
pub function first_decl_line(mod: parser.Module): i32 {
    var min: i32 = 0;
    var i: i32 = 0;
    while (i < mod.funcs.len()) { min = min_line(min, mod.funcs[i].line); i = i + 1; }
    var si: i32 = 0;
    while (si < mod.structs.len()) { min = min_line(min, mod.structs[si].line); si = si + 1; }
    var ei: i32 = 0;
    while (ei < mod.enums.len()) { min = min_line(min, mod.enums[ei].line); ei = ei + 1; }
    var ti: i32 = 0;
    while (ti < mod.aliases.len()) { min = min_line(min, mod.aliases[ti].line); ti = ti + 1; }
    return min;
}

function min_line(min: i32, line: i32): i32 {
    if (line == 0) { return min; }
    if (min == 0 || line < min) { return line; }
    return min;
}

// ---- the pass ----------------------------------------------------------

// associate walks the declarations in source order, handing each the comment
// run directly above it.
pub function associate(cs: lexer.Comment[], decls: DocDecl[]): DocDecl[] {
    var out: DocDecl[] = [];
    var cursor: i32 = 0;
    var i: i32 = 0;
    while (i < decls.len()) {
        var t: TakeResult = take_doc(cs, cursor, decls[i].line);
        cursor = t.cursor;
        out = out.append(DocDecl { ...decls[i], doc: t.doc });
        i = i + 1;
    }
    return out;
}

// DocModule is one source file's documentation inputs, extracted.
pub struct DocModule { intro: string, decls: DocDecl[] }

// docs_of is the whole extraction for one source: lex with comments, parse,
// collect the public declarations, and bind the comment runs to them.
pub function docs_of(src: string): DocModule {
    var lr: lexer.LexResult = lexer.tokenize_full(src);
    var mod: parser.Module = parser.parse_module(lr.tokens);
    var decls: DocDecl[] = public_decls(mod);
    return DocModule {
        intro: module_intro(lr.comments, first_decl_line(mod)),
        decls: associate(lr.comments, decls)
    };
}

// ---- rendering ---------------------------------------------------------
//
// The Markdown half, mirroring cmd/ferndoc's renderModule and its
// per-declaration renderers. Gated byte-for-byte against the native pages, so
// every literal below — the front matter, the fence language, the blank line
// after a signature, the trailing comma inside an enum body — is load-bearing
// rather than styling.
//
// The one structural difference is where the type strings come from. Native
// renders `ast.Type.String()`; the self-host parser stores the source spelling
// on the declaration (`ParamDecl.type_name`, `FuncDecl.ret_type`), so the
// renderer prints what was written. Where the two disagree the differential
// says so, and the answer is to normalise here rather than to loosen the gate.

// type_str renders a declared type. `?` matches native's typeStr for a missing
// type, which is what an unannotated position renders as rather than an empty
// string.
function type_str(t: string): string {
    if (t.len() == 0) { return "?"; }
    return t;
}

// param_type_str renders a parameter's declared type.
//
// A function-typed parameter needs the two sidecars: the parser collapses it to
// the flat tag `fn` and keeps the spellings it threw away in `fn_param_types`
// (comma-separated, no spaces) and `fn_ret`. Their own header says they exist to
// "reconstruct the declared signature the flat `fn` tag threw away" — this is
// the reconstruction, and without it every higher-order function in the stdlib
// documents its callback as `fn`.
function param_type_str(p: parser.ParamDecl): string {
    if (p.type_name != "fn") { return type_str(p.type_name); }
    var out: string = "(";
    if (p.fn_param_types.len() > 0) {
        var parts: string[] = split_commas(p.fn_param_types);
        var i: i32 = 0;
        while (i < parts.len()) {
            if (i > 0) { out = out + ", "; }
            out = out + parts[i];
            i = i + 1;
        }
    }
    // An empty return spelling on a fn type is `void`, not the `?` an absent
    // type renders as: the parser records no return for `() => void`, and the
    // two are different facts.
    if (p.fn_ret.len() == 0) { return out + ") => void"; }
    return out + ") => " + p.fn_ret;
}

// split_commas splits on `,`. Written out rather than reached for as a method:
// these modules import no stdlib, so a string here carries only the builtin
// operations.
function split_commas(s: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < s.len()) {
        if ((s[i] as i32) == 44) {
            out = out.append(own(s[start:i]));
            start = i + 1;
        }
        i = i + 1;
    }
    return out.append(own(s[start:s.len()]));
}

// join_type_params renders `[A, B]`, or nothing when the declaration is not
// generic.
function join_type_params(tps: string[]): string {
    if (tps.len() == 0) { return ""; }
    var out: string = "[";
    var i: i32 = 0;
    while (i < tps.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + tps[i];
        i = i + 1;
    }
    return out + "]";
}

// doc_block is a declaration's doc under its signature, or nothing. Native
// emits the doc followed by a blank line and omits both when there is no doc,
// so an undocumented declaration is not followed by a stray blank.
function doc_block(doc: string): string {
    if (doc.len() == 0) { return ""; }
    return doc + "\n\n";
}

function render_func(fd: parser.FuncDecl, doc: string): string {
    var out: string = "## `" + fd.name + "`\n\n```fern\npub function ";
    if (fd.receiver_type.len() > 0) {
        out = out + "(" + fd.receiver_name + ": " + type_str(fd.receiver_type) + ") ";
    }
    out = out + fd.name + join_type_params(fd.type_params) + "(";
    var i: i32 = 0;
    while (i < fd.params.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + fd.params[i].name + ": " + param_type_str(fd.params[i]);
        i = i + 1;
    }
    out = out + "): " + type_str(fd.ret_type) + "\n```\n\n";
    return out + doc_block(doc);
}

function render_struct(sd: parser.StructDecl, doc: string): string {
    var out: string = "## `struct " + sd.name + "`\n\n```fern\npub struct "
        + sd.name + join_type_params(sd.type_params) + " { ";
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + sd.fields[i].name + ": " + type_str(sd.fields[i].type_name);
        i = i + 1;
    }
    return out + " }\n```\n\n" + doc_block(doc);
}

// variant_payloads renders `(T, U)` for a variant that carries a payload, or
// nothing for a unit variant.
//
// The types are not on the EnumDecl: the parser DESUGARS each variant into a
// StructDecl tagged with `enum_owner`, so the payload lives there.
function variant_payloads(enum_name: string, variant: string, structs: parser.StructDecl[]): string {
    var i: i32 = 0;
    while (i < structs.len()) {
        var sd: parser.StructDecl = structs[i];
        if (sd.enum_owner == enum_name && sd.name == variant) {
            if (sd.fields.len() == 0) { return ""; }
            var out: string = "(";
            var f: i32 = 0;
            while (f < sd.fields.len()) {
                if (f > 0) { out = out + ", "; }
                out = out + type_str(sd.fields[f].type_name);
                f = f + 1;
            }
            return out + ")";
        }
        i = i + 1;
    }
    return "";
}

function render_enum(ed: parser.EnumDecl, structs: parser.StructDecl[], doc: string): string {
    var out: string = "## `enum " + ed.name + "`\n\n```fern\npub enum "
        + ed.name + join_type_params(ed.type_params) + " {\n";
    var v: i32 = 0;
    while (v < ed.variant_names.len()) {
        out = out + "    " + ed.variant_names[v]
            + variant_payloads(ed.name, ed.variant_names[v], structs) + ",\n";
        v = v + 1;
    }
    return out + "}\n```\n\n" + doc_block(doc);
}

// render_impls is the trait to implementing-types table. Grouped by trait in
// FIRST-SEEN order, not sorted: core/cmp alone carries ~30 primitive impls and
// a section each would be unreadable, but the order still has to match native's
// insertion order exactly for the bytes to agree.
//
// `cells` accumulates each trait's row already rendered — the types joined by
// the backtick-comma-backtick that separates them in the table — because the
// self-host has no array-of-arrays to group into.
// trait_label is the trait as the source wrote it — qualifier included — which
// is what native's table shows. parse_type_name resolves `async.Driver` to
// `Driver`, so the spelling rides beside the resolved name on ImplInfo; an
// inherent impl has no trait and no spelling.
function trait_label(im: parser.ImplInfo): string {
    if (im.trait_spelling.len() > 0) { return im.trait_spelling; }
    return im.trait_name;
}

function render_impls(impls: parser.ImplInfo[]): string {
    var order: string[] = [];
    var cells: string[] = [];
    var i: i32 = 0;
    while (i < impls.len()) {
        var tn: string = trait_label(impls[i]);
        var at: i32 = util.index_of_str(order, tn);
        if (at < 0) {
            order = order.append(tn);
            cells = cells.append(impls[i].impl_type);
        } else {
            cells = cells.with(at, cells[at] + "`, `" + impls[i].impl_type);
        }
        i = i + 1;
    }
    if (order.len() == 0) { return ""; }
    var out: string = "## Implementations\n\n| Trait | Implementing types |\n| ----- | ------------------ |\n";
    var t: i32 = 0;
    while (t < order.len()) {
        out = out + "| `" + order[t] + "` | `" + cells[t] + "` |\n";
        t = t + 1;
    }
    return out + "\n";
}

// The three lookups below re-find the declaration a DocDecl came from. Keyed on
// LINE as well as name, since a module may declare a struct and a function with
// the same name.
function func_named(mod: parser.Module, name: string, line: i32): parser.FuncDecl {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].name == name && mod.funcs[i].line == line) { return mod.funcs[i]; }
        i = i + 1;
    }
    return mod.funcs[0];
}

function struct_named(mod: parser.Module, name: string, line: i32): parser.StructDecl {
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        if (mod.structs[i].name == name && mod.structs[i].line == line) { return mod.structs[i]; }
        i = i + 1;
    }
    return mod.structs[0];
}

function enum_named(mod: parser.Module, name: string, line: i32): parser.EnumDecl {
    var i: i32 = 0;
    while (i < mod.enums.len()) {
        if (mod.enums[i].name == name && mod.enums[i].line == line) { return mod.enums[i]; }
        i = i + 1;
    }
    return mod.enums[0];
}

// render_page is cmd/ferndoc's renderModule: front matter, title, the module
// intro, every public declaration in source order, then the impl table.
//
// An empty page is the empty string, matching native's skip-empty-modules rule
// — a page with nothing on it would clutter the sidebar with a heading and no
// content.
pub function render_page(src: string, mod_path: string): string {
    var lr: lexer.LexResult = lexer.tokenize_full(src);
    var mod: parser.Module = parser.parse_module(lr.tokens);
    var decls: DocDecl[] = associate(lr.comments, public_decls(mod));
    if (decls.len() == 0 && mod.impls.len() == 0) { return ""; }

    var out: string = "---\ntitle: " + mod_path + "\ndescription: Standard library reference for "
        + mod_path + ".\n---\n\n# `" + mod_path + "`\n\n";
    var intro: string = module_intro(lr.comments, first_decl_line(mod));
    if (intro.len() > 0) { out = out + intro + "\n\n"; }

    var i: i32 = 0;
    while (i < decls.len()) {
        var d: DocDecl = decls[i];
        if (d.kind == "function") { out = out + render_func(func_named(mod, d.name, d.line), d.doc); }
        else if (d.kind == "struct") { out = out + render_struct(struct_named(mod, d.name, d.line), d.doc); }
        else if (d.kind == "enum") { out = out + render_enum(enum_named(mod, d.name, d.line), mod.structs, d.doc); }
        i = i + 1;
    }
    return out + render_impls(mod.impls);
}
