// examples/self_host/asm_arm64_modload_run.fern — the arm64 counterpart
// of asm_modload_run: an import-driven self-host compiler driver that
// reads an ENTRY file off argv, resolves its imports off disk (the shared
// ./modloader), merges them with flatten.bundle, loads the built-in types
// from a real builtins.fern, and emits aarch64 assembly.
//
//     $ asm_arm64_modload_run path/to/main.fern > main.s
//
// Module resolution + builtin merging are shared with the x86 driver via
// ./modloader; this driver differs only in emitting arm64 asm. Beyond the
// default merged AST emit it carries the SAME per-module flags as the x86
// driver (#3451 / #3457 step 0a) — routing every module through the arm64
// IR path (asm_arm64.emit_module_ir_unit_arm64) instead of the merged AST
// emit:
//   -ir-probe           → report the IR-eligibility frontier
//   -per-module-count   → print the module count N
//   -per-module-needs   → print the whole-program runtime-need union
//   -per-module-emit N [-extra-need X...]
//                       → emit module N's translation unit
// The eligibility gate + need union are target-independent (asm_ir), so they
// are reused; only the per-unit emit is the arm64 mirror.

import "./util";
import "./lexer";
import "./parser";
import "./flatten";
import "./asm_arm64";
import "./asm_ir";
import "./modloader";

// builtin_view returns `base` (the union of every per-module unit's structs)
// extended with the built-in TYPE layouts the compiler's own code references —
// builtins.fern's struct + enum-variant decls plus inject_builtin_enums — so a
// compiler function touching a built-in type lowers against the right layout in
// the WHOLE-PROGRAM struct view. Identical to asm_modload_run's builtin_view.
function builtin_view(dir: string, base: parser.StructDecl[]): parser.StructDecl[] {
    var out: parser.StructDecl[] = base;
    match (read_file(dir + "builtins.fern")) {
        Ok(bsrc) => {
            var bmod: parser.Module = parser.parse_module(lexer.tokenize(bsrc));
            var i: i32 = 0;
            while (i < bmod.structs.len()) { out = out.append(bmod.structs[i]); i = i + 1; }
        },
        Err(e) => { },
    }
    return parser.inject_builtin_enums(out);
}

// run_per_module drives the per-module build of the loaded program (the arm64
// twin of asm_modload_run's run_per_module). The whole-program signature view +
// program-wide known-symbol set and the eligibility gate are target-independent
// (asm_ir), so they are reused verbatim; only the per-unit emit differs —
// asm_arm64.emit_module_ir_unit_arm64 instead of asm_ir.emit_module_ir_unit.
// The per-module incremental-codegen fingerprint helpers below mirror the x86
// driver's (asm_modload_run) verbatim, so both backends key the object cache
// identically — a module's codegen inputs (its own source + the signatures of
// what it calls into) are target-independent. They are kept local to each driver
// rather than shared via ./modloader: hoisting them there enlarged the
// whole-program module set the per-module analysis walks on every invocation,
// which tipped the irlower emit (the ~350-function memory ceiling, #3425) into
// an OOM. Small duplication, no memory regression.
function module_sig_string(mod: parser.Module): string {
    var out: string = "";
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var f: parser.FuncDecl = mod.funcs[fi];
        out = out + "fn " + f.receiver_type + "." + f.name + "(";
        var pi: i32 = 0;
        while (pi < f.params.len()) {
            out = out + f.params[pi].type_name + ",";
            pi = pi + 1;
        }
        out = out + ")" + f.ret_type + ";";
        fi = fi + 1;
    }
    var si: i32 = 0;
    while (si < mod.structs.len()) {
        var sd: parser.StructDecl = mod.structs[si];
        out = out + "st " + sd.name + "{";
        var di: i32 = 0;
        while (di < sd.fields.len()) {
            out = out + sd.fields[di].name + ":" + sd.fields[di].type_name + ",";
            di = di + 1;
        }
        out = out + "}";
        si = si + 1;
    }
    return out;
}

function module_import_ns(mod: parser.Module): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        if (i > 0) { out = out + ","; }
        out = out + modloader.base_name(mod.imports[i].path);
        i = i + 1;
    }
    return out;
}

function module_src_hash(dir: string, entry_path: string, part: flatten.PerModule): string {
    var srcpath: string = dir + part.ns + ".fern";
    if (part.is_entry) { srcpath = entry_path; }
    match (read_file(srcpath)) {
        Ok(msrc) => { return util.hash_key(msrc); },
        Err(e) => { return "?"; },
    }
    return "?";
}

function module_cache_key(parts: flatten.PerModule[], infmods: parser.Module[], sighashes: string[], idx: i32, src_hash: string, extra: string[]): string {
    if (src_hash == "?") { return ""; }
    var key: string = parts[idx].ns + "|" + src_hash;
    var imps: parser.Import[] = infmods[idx].imports;
    var j: i32 = 0;
    while (j < parts.len()) {
        var ii: i32 = 0;
        var imported: boolean = false;
        while (ii < imps.len()) {
            if (modloader.base_name(imps[ii].path) == parts[j].ns) { imported = true; }
            ii = ii + 1;
        }
        if (imported) { key = key + "#" + sighashes[j]; }
        j = j + 1;
    }
    if (parts[idx].is_entry) {
        var ex: string = "";
        var ei: i32 = 0;
        while (ei < extra.len()) { ex = ex + extra[ei] + ","; ei = ei + 1; }
        key = key + "@" + util.hash_key(ex);
    }
    return key;
}

function run_per_module(dir: string, entry_path: string, entry: parser.Module, loaded: flatten.LoadedModule[], pm_mode: string, pm_index: i32, pm_extra: string[], cache_dir: string): i32 {
    var parts: flatten.PerModule[] = flatten.bundle_per_module(entry, loaded);
    if (pm_mode == "count") {
        print(util.i32_to_string(parts.len()) + "\n");
        return 0;
    }
    var infmods: parser.Module[] = [];
    var all_funcs: parser.FuncDecl[] = [];
    var all_structs: parser.StructDecl[] = [];
    var known: string[] = [];
    var pi: i32 = 0;
    while (pi < parts.len()) {
        var im: parser.Module = parser.infer_ret_types_module(asm_ir.lift_lambdas(parts[pi].mod));
        infmods = infmods.append(im);
        var fk: i32 = 0;
        while (fk < im.funcs.len()) {
            all_funcs = all_funcs.append(im.funcs[fk]);
            known = known.append(im.funcs[fk].name);
            if (im.funcs[fk].receiver_type.len() > 0) {
                known = known.append(util.base_type_name(im.funcs[fk].receiver_type) + "." + im.funcs[fk].name);
            }
            fk = fk + 1;
        }
        var sk: i32 = 0;
        while (sk < im.structs.len()) { all_structs = all_structs.append(im.structs[sk]); sk = sk + 1; }
        pi = pi + 1;
    }
    all_structs = builtin_view(dir, all_structs);
    // Per-module signature hashes (aligned with parts), computed only when a
    // caller needs them (manifest or a cached emit) — a plain emit keeps its
    // memory profile (#3425). Shared keying logic with the x86 driver.
    var sighashes: string[] = [];
    if (pm_mode == "manifest" || (pm_mode == "emit" && cache_dir.len() > 0)) {
        var shi: i32 = 0;
        while (shi < parts.len()) {
            sighashes = sighashes.append(util.hash_key(module_sig_string(infmods[shi])));
            shi = shi + 1;
        }
    }
    if (pm_mode == "manifest") {
        // Per-module incremental-codegen manifest (#3451 step 6 / #3458), arm64
        // twin. One line per module: <ns>|<src_hash>|<sig_hash>|<imports> — see
        // module_cache_key for how an orchestrator folds these into a
        // cache key. The keys are backend-independent (same source, same imports,
        // same signatures), so an arm64 manifest matches the x86 one.
        var mi: i32 = 0;
        while (mi < parts.len()) {
            var src_hash: string = module_src_hash(dir, entry_path, parts[mi]);
            print(parts[mi].ns + "|" + src_hash + "|" + sighashes[mi] + "|" + module_import_ns(infmods[mi]) + "\n");
            mi = mi + 1;
        }
        return 0;
    }
    if (pm_mode == "needs") {
        // Seed the entry's shared runtime with the full root set instead of an
        // exact per-module union (asm_ir.all_runtime_need_roots): a sound,
        // deterministic over-approximation that avoids re-emitting every module
        // here via module_runtime_needs — that aggregation OOMs a self-host-built
        // driver (#3425), the one thing blocking a self-host per-module self-compile.
        var needs: string[] = asm_ir.all_runtime_need_roots();
        var no: i32 = 0;
        while (no < needs.len()) { print(needs[no] + "\n"); no = no + 1; }
        return 0;
    }
    if (pm_index < 0 || pm_index >= parts.len()) {
        eprint("per-module: emit index out of range\n");
        return 1;
    }
    var extra: string[] = [];
    if (parts[pm_index].is_entry) { extra = pm_extra; }
    // Incremental object cache (#3451 step 6 / #3458), arm64 twin — same keying
    // as the x86 driver (module_cache_key). A hit serves the arm64 unit
    // asm from disk and skips codegen; a miss emits, populates, then writes.
    // hit/miss is reported on stderr; stdout stays the unit asm.
    var cachefile: string = "";
    if (cache_dir.len() > 0) {
        var src_hash: string = module_src_hash(dir, entry_path, parts[pm_index]);
        var key: string = module_cache_key(parts, infmods, sighashes, pm_index, src_hash, extra);
        if (key.len() > 0) {
            cachefile = cache_dir + "/" + parts[pm_index].ns + "__" + util.hash_key(key) + ".s";
            match (read_file(cachefile)) {
                Ok(cached) => {
                    eprint("cache-hit " + parts[pm_index].ns + "\n");
                    write(cached);
                    return 0;
                },
                Err(e) => { },
            }
        }
    }
    var elig: boolean = asm_ir.all_eligible_lib_known_view(infmods[pm_index], known, all_funcs, all_structs);
    if (parts[pm_index].is_entry) { elig = asm_ir.all_eligible_known_view(infmods[pm_index], known, all_funcs, all_structs); }
    if (!elig) {
        eprint("per-module: module not IR-eligible: ");
        eprint(parts[pm_index].ns);
        eprint("\n");
        return 1;
    }
    var unit: string = asm_arm64.emit_module_ir_unit_arm64(infmods[pm_index], parts[pm_index].is_entry, true, parts[pm_index].ns, extra, all_funcs, all_structs);
    // stdout first, then populate the cache last (see the x86 driver).
    write(unit);
    if (cachefile.len() > 0) {
        eprint("cache-miss " + parts[pm_index].ns + "\n");
        match (write_file(cachefile, unit)) {
            Some(werr) => { eprint("per-module: cache write failed for " + parts[pm_index].ns + "\n"); },
            None => { },
        }
    }
    return 0;
}

function main(): i32 {
    var a: string[] = args();
    var probe: boolean = false;
    var entry_path: string = "";
    var pm_mode: string = "";
    var pm_index: i32 = 0 - 1;
    var pm_extra: string[] = [];
    var cache_dir: string = "";
    var ai: i32 = 1;
    while (ai < a.len()) {
        if (a[ai] == "-ir-probe") { probe = true; }
        else if (a[ai] == "-per-module-count") { pm_mode = "count"; }
        else if (a[ai] == "-per-module-needs") { pm_mode = "needs"; }
        else if (a[ai] == "-per-module-manifest") { pm_mode = "manifest"; }
        else if (a[ai] == "-per-module-emit" && ai + 1 < a.len()) { pm_mode = "emit"; pm_index = util.digits_to_i32(a[ai + 1]); ai = ai + 1; }
        else if (a[ai] == "-extra-need" && ai + 1 < a.len()) { pm_extra = pm_extra.append(a[ai + 1]); ai = ai + 1; }
        else if (a[ai] == "-cache-dir" && ai + 1 < a.len()) { cache_dir = a[ai + 1]; ai = ai + 1; }
        else if (entry_path == "") { entry_path = a[ai]; }
        ai = ai + 1;
    }
    if (entry_path == "") {
        eprint("usage: asm_arm64_modload_run <entry.fern> [-ir-probe | -per-module-count | -per-module-needs | -per-module-manifest | -per-module-emit N [-cache-dir DIR]]\n");
        return 2;
    }
    var dir: string = modloader.dirname(entry_path);
    match (read_file(entry_path)) {
        Ok(src) => {
            var entry: parser.Module = parser.parse_module(lexer.tokenize(src));
            var loaded: flatten.LoadedModule[] = modloader.load_imports(dir, entry);
            if (pm_mode.len() > 0) {
                return run_per_module(dir, entry_path, entry, loaded, pm_mode, pm_index, pm_extra, cache_dir);
            }
            var merged: parser.Module = flatten.bundle(entry, loaded);
            merged = modloader.merge_builtins(dir, merged);
            if (probe) {
                write(asm_ir.eligibility_report(asm_ir.lift_lambdas(merged)));
                return 0;
            }
            write(asm_arm64.emit_module(parser.module_with_builtins(merged), false));
            return 0;
        },
        Err(e) => {
            eprint("asm_arm64_modload_run: could not read entry file\n");
            return 1;
        },
    }
    return 3;
}
