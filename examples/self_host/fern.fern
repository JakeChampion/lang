// examples/self_host/fern.fern — the unified self-hosted `fern` CLI
// driver. Where the older `*_run.fern` shims each hard-wired one mode
// (asm_load_run = emit, checker_run = check, interp_run = evaluate),
// this is a single binary that parses argv flags and dispatches:
//
//     fern -o OUT <entry.fern> [stdlib]     a runnable x86-64 Linux ELF
//     fern -target arm64-linux -o OUT <e>   a runnable arm64 Linux ELF
//     fern -target arm64-darwin -o OUT …    a runnable arm64 Mach-O
//     fern -target wasm32-wasi <entry>      a wasi:cli/run component
//     fern -emit asm <entry.fern>           emit the emitter's text instead
//     fern -emit core-module -target …      a raw wasm core module
//     fern -ssa <entry.fern>                opt into the SSA pipeline
//     fern -check <entry.fern>              type-check; exit 0 ok / 1 bad
//     fern -check <DIR>                     check a package, or every
//                                           member of the workspace it roots
//     fern -interp <entry.fern>             evaluate; exit = program result
//     fern -fmt <entry.fern>                format the entry file to stdout
//     fern -targets                         list the targets + capabilities
//     fern -resolve <ABS-DIR>               run MVS; write fern.lock
//
// A target is `<isa>-<environment>` (#6529 / #6635): the ISA half picks the
// backend, the environment half says what the host provides, and neither is
// implied — there is no bare `arm64` meaning arm64-Linux. Output FORM is a
// separate axis, `-emit`, because it is a property of the artifact and not of
// the machine it runs on; folding it into the target name is what once let
// a wasm output form skip capability enforcement.
//
// The three native targets assemble and link IN-PROCESS (x86_native /
// arm64_native + elf.fern, or the Mach-O writer on darwin), so producing a
// runnable binary needs nothing on $PATH — no `.s`, no gcc, no ld. `-emit asm`
// stops at the emitter's text (GAS on the natives, WAT on wasm), which is what
// a harness assembling with its own toolchain wants, and the only way to
// observe an emitter in isolation.
//
// Codegen routes through the IR path (asm_ir / asm_arm64_ir / wasm_ir,
// each IR-or-error per #3457) for every target. The SSA pipeline (AST →
// SSA → optimise → regalloc → emit) is opt-in via `-ssa` and applies only
// when every function is in its subset, else it falls through to the IR
// path. See docs/SELFHOST-SSA-DECISION.md.
//
// It is a drop-in-shaped replacement for cmd/fern: one binary hosting
// both the x86-64 (asm_ir.fern) and arm64 (asm_arm64.fern) emitters,
// selected at runtime by -target — where the codebase previously had
// two separate compilers. Module loading is the import-driven,
// file-loading scheme from asm_load_run (follow `import "./x"` to
// sibling files; resolve `std/…` / `core/…` under an optional stdlib
// root).

import "./util";
import "./lexer";
import "./parser";
import "./flatten";
import "./asm_ir";
import "./asm_arm64_ir";
import "./wasm_ir";
import "./checker";
import "./interp";
import "./printer";
import "./ssa";
import "./ssa_x86";
import "./ssa_arm64";
import "./ssa_wasm";
import "./watbin";
import "./constfold";
import "./platforms";
import "./caps";
import "./modloader";
import "./visibility";
import "./fern_toml";
import "./mvs";
import "./treeshake";
import "./arm64_native";
import "./x86_native";
import "./elf";

// to_u8 copies an i32[] byte buffer (values 0..255, as the wasm binary
// encoder produces) into a u8[] so string_from_bytes_unchecked can pack it into a
// string whose bytes are written verbatim (incl. 0x00 / high bytes) by
// write_file. Used by the wasm binary output forms.
function to_u8(b: i32[]): u8[] {
    var o: u8[] = [];
    var i: i32 = 0;
    while (i < b.len()) { o = o.append(b[i] as u8); i = i + 1; }
    return o;
}

// arm64_refusals renders the assembler's / linker's refusal list as ONE
// diagnostic line and returns "" — the empty-binary sentinel every caller
// already returns on failure, so a caller reads `return arm64_refusals(…)`.
//
// Two things this fixes over the three-eprint sequence it replaces. `eprint`
// appends its own newline, so "…does not yet support: " / entry / "\n" printed
// the reason on its own line with a blank one after it, which read as an EMPTY
// instruction and looked like the compiler could not say what it choked on
// (#6164). And only unknown[0] was printed: a module with twenty refusals
// reported one, so each fix revealed the next.
//
// `stage` names where it came from ("assembler" / "linker"), since the two are
// different failures: an unrecognised mnemonic is an instruction-selection gap,
// while `label:__fern_x` is an emitted call to a runtime helper the emitter did
// not define — not an instruction at all, which the old wording insisted it was.
function arm64_refusals(target: string, stage: string, unknown: string[]): string {
    var msg: string = "fern: -target " + target + ": in-process " + stage
        + " refused " + util.i32_to_string(unknown.len()) + ": ";
    var i: i32 = 0;
    while (i < unknown.len()) {
        if (i > 0) { msg = msg + ", "; }
        msg = msg + unknown[i];
        i = i + 1;
    }
    eprint(msg);
    return "";
}

// arm64_elf_binary assembles arm64 Linux GAS text (from either the SSA or AST
// emitter) into a runnable static ELF entirely in-process via arm64_native +
// elf.fern — no `.s` + external gcc/ld. Returns the binary bytes packed into a
// string (written verbatim by write_file), or "" if the assembler hit an
// instruction it doesn't yet support (the caller reports it and exits 2). The
// arm64-darwin counterpart is the macho_executable path above.
function arm64_elf_binary(asm: string, emit_syms: boolean): string {
    var p: arm64_native.Arm64GasProg = arm64_native.arm64_gas_program(asm);
    if (p.unknown.len() > 0) {
        return arm64_refusals("arm64-linux", "assembler", p.unknown);
    }
    var pa: arm64_native.Arm64Asm = p.asm;
    // W^X two-segment layout: .text loads R+X at elf_text_vaddr_wx() and the
    // data blob (.rodata + globals + the .bss heap) loads R+W on the first
    // page boundary past .text, so no mapping is both writable and
    // executable (required by W^X-enforcing loaders such as Android's).
    var tv: i64 = (elf.elf_text_vaddr_wx()) as i64;
    var dv: i64 = (elf.elf_data_vaddr_wx(pa.code.len())) as i64;
    p = arm64_native.arm64_gas_link(p, tv, dv);
    // Symbol resolution happens IN the link, so its refusals land here rather
    // than in the parse check above. Reporting them matters more than it
    // sounds: an unresolvable symbol used to be patched as an offset anyway,
    // which is how a function value became an address in the middle of .data
    // and stayed a runtime SEGV rather than a compile error (#6045).
    if (p.unknown.len() > 0) {
        return arm64_refusals("arm64-linux", "linker", p.unknown);
    }
    var pa2: arm64_native.Arm64Asm = p.asm;
    var eoff: i32 = arm64_native.arm64_asm_label_off(pa2, "_start");
    if (eoff < 0) { eoff = 0; }
    var bin: i32[] = elf.elf_image_wx(pa2.code, p.data, elf.elf_em_aarch64(), eoff, p.bss_size);
    if (emit_syms) {
        // `-g`, the W^X counterpart of the x86 path. Arm64Asm records no
        // section per label — every label it holds is a .text label — so the
        // section filter is -1 rather than 0.
        var aend: i32 = pa2.code.len();
        var nosec: i32[] = [];
        bin = elf.elf_append_symtab(bin, elf.elf_text_vaddr_wx(), elf.elf_wx_text_off(), pa2.code.len(),
            elf.elf_func_sym_names(pa2.lab_names, pa2.lab_offs, nosec, 0 - 1, aend),
            elf.elf_func_sym_offs(pa2.lab_names, pa2.lab_offs, nosec, 0 - 1, aend),
            elf.elf_func_sym_sizes(pa2.lab_names, pa2.lab_offs, nosec, 0 - 1, aend));
    }
    return string_from_bytes_unchecked(to_u8(bin));
}

// arm64_elf_binary_pie is arm64_elf_binary as a static position-independent
// executable (the -target arm64-android path): ET_DYN at a load base of 0 so
// the kernel can map it anywhere (Android rejects non-PIE for normal exec).
// Now that the arm64 heap is mmap'd at the low 0x10000000 hint (not reserved
// as a giant .bss in the loaded image), the data segment is tiny and the
// heap lives below 4 GiB regardless of the binary's load base — so the PIE
// runs at any base. The self-host arm64 emitter embeds no absolute pointers
// (function addresses via runtime adrp/:lo12:), so no dynamic relocations are
// needed; only the ELF container (ET_DYN) and the base-0 layout differ.
function arm64_elf_binary_pie(asm: string): string {
    var p: arm64_native.Arm64GasProg = arm64_native.arm64_gas_program(asm);
    if (p.unknown.len() > 0) {
        return arm64_refusals("arm64-android", "assembler", p.unknown);
    }
    var pa: arm64_native.Arm64Asm = p.asm;
    var tv: i64 = (elf.elf_text_vaddr_pie()) as i64;
    var dv: i64 = (elf.elf_data_vaddr_pie(pa.code.len())) as i64;
    p = arm64_native.arm64_gas_link(p, tv, dv);
    if (p.unknown.len() > 0) {
        return arm64_refusals("arm64-android", "linker", p.unknown);
    }
    var pa2: arm64_native.Arm64Asm = p.asm;
    var eoff: i32 = arm64_native.arm64_asm_label_off(pa2, "_start");
    if (eoff < 0) { eoff = 0; }
    var bin: i32[] = elf.elf_image_pie(pa2.code, p.data, elf.elf_em_aarch64(), eoff, p.bss_size);
    return string_from_bytes_unchecked(to_u8(bin));
}

// x86_elf_binary assembles x86-64 Linux GAS text into a runnable static ELF
// in-process via x86_native + elf.fern — the counterpart of
// arm64_elf_binary. Returns the binary bytes packed into a string, or "" if
// the assembler could not encode something (the caller exits 2).
//
// Single R+W+X PT_LOAD, not the two-segment W^X image arm64 uses:
// x86_resolve fixes .rodata references against the 8-byte-padded .text
// length, which is exactly this layout. W^X would need the assembler to
// resolve against a page-aligned data vaddr, as arm64_gas_link does.
function x86_elf_binary(asm: string, emit_syms: boolean): string {
    var a: x86_native.X86Asm = x86_native.x86_gas_assemble(asm);
    // Absolute `.quad <label>` pointers need the load address, which the ELF
    // container picks — the analogue of arm64_gas_link's data-vaddr argument.
    a = x86_native.x86_resolve_data(a, elf.elf_text_vaddr());
    // Anything unencodable means bytes were dropped, so every offset past
    // the first is wrong — refuse rather than write it (SH-005, #6045).
    if (a.unknown.len() > 0) {
        eprint("fern: -target x86-64: in-process assembler could not encode: ");
        eprint(a.unknown[0]);
        eprint("\n");
        return "";
    }
    var eoff: i32 = x86_native.x86_label_off(a, "_start");
    if (eoff < 0) {
        eprint("fern: -target x86-64: no _start symbol in the emitted program\n");
        return "";
    }
    var bin: i32[] = elf.elf_static_executable_bss_x86_at(a.code, a.rodata, a.bss_size, eoff);
    if (emit_syms) {
        // `-g`: a static .symtab so nm / a debugger / a profiler can map an
        // address back to a function. Only .text labels (section 0) become
        // symbols, and the sizes span to the end of the code, which is what
        // lets a backtrace attribute an address INSIDE a function rather
        // than only an exact entry point.
        var end: i32 = a.code.len();
        bin = elf.elf_append_symtab(bin, elf.elf_text_vaddr(), elf.elf_text_off(), a.code.len(),
            elf.elf_func_sym_names(a.lab_names, a.lab_offs, a.lab_secs, 0, end),
            elf.elf_func_sym_offs(a.lab_names, a.lab_offs, a.lab_secs, 0, end),
            elf.elf_func_sym_sizes(a.lab_names, a.lab_offs, a.lab_secs, 0, end));
    }
    return string_from_bytes_unchecked(to_u8(bin));
}

// last_slash returns the index of the final '/' in p, or -1.
function last_slash(p: string): i32 {
    var i: i32 = 0;
    var last: i32 = 0 - 1;
    while (i < p.len()) {
        if (p[i] == 47) { last = i; }
        i = i + 1;
    }
    return last;
}

// dir_of returns the directory portion of a path ("" if none).
function dir_of(p: string): string {
    var ls: i32 = last_slash(p);
    if (ls < 0) { return ""; }
    return p[0:ls] + "";
}

// module_name maps an import path to its bundle name: the final path
// segment (`./a/lexer` → `lexer`, `./parser` → `parser`).
function module_name(import_path: string): string {
    var ls: i32 = last_slash(import_path);
    if (ls >= 0) { return import_path[ls + 1:import_path.len()] + ""; }
    return import_path;
}

// is_local is true for `./…` / `../…` imports (loaded from the entry's
// directory), false for `core/…` / `std/…` (resolved under the stdlib
// root, when one is configured).
function is_local(import_path: string): boolean {
    if (import_path.len() == 0) { return false; }
    return import_path[0] == 46;   // '.'
}

// join_path builds `<dir>/<name>.fern` (or `<name>.fern` if dir empty).
function join_path(dir: string, name: string): string {
    if (dir.len() == 0) { return name + ".fern"; }
    return dir + "/" + name + ".fern";
}

// contains_name -> util.has_str (SH-020).

// should_load decides whether an import path names a module file to
// load. Local (`./…`) imports always load; a name `deps` declares (the entry
// manifest's dependencies) loads through the manifest; `std/…` / `core/…`
// load only when a stdlib root is given.
function should_load(import_path: string, root: string, deps: string[]): boolean {
    if (import_path.len() == 0) { return false; }
    if (is_local(import_path)) { return true; }
    if (util.has_str(deps, module_name(import_path))) { return true; }
    if (root.len() == 0) { return false; }
    return true;
}

// resolve_path maps an import path to a file on disk.
function resolve_path(import_path: string, entry_dir: string, root: string): string {
    if (is_local(import_path)) {
        return join_path(entry_dir, module_name(import_path));
    }
    return root + "/" + import_path + ".fern";
}

// add_imports appends each of mod's loadable import paths to paths
// (deduped by full path), returning the grown list.
function add_imports(paths: string[], mod: parser.Module, root: string, deps: string[]): string[] {
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        var ip: string = mod.imports[i].path;
        if (should_load(ip, root, deps) && !util.has_str(paths, ip)) {
            paths = paths.append(ip);
        }
        i = i + 1;
    }
    return paths;
}

// is_flag is true for an argument that begins with '-'.
function is_flag(a: string): boolean {
    if (a.len() == 0) { return false; }
    return a[0] == 45;   // '-'
}

function usage(): i32 {
    eprint("usage: fern [-check | -interp | -fmt | -capabilities] [-ssa] [-target <isa>-<environment>] [-emit asm|core-module] [-o OUT] <entry.fern> [stdlib-root]\n");
    eprint("       fern -targets                                (list supported targets + capabilities)\n");
    eprint("       fern -resolve <ABS-DIR>                      (run MVS over the manifest's index; write fern.lock)\n");
    return 2;
}

// list_targets implements `-targets`: every target the descriptor table
// answers for, with what its environment grants. The self-host descriptor
// carries no prose description (platforms.fern says why), so a target is
// printed as the two axes its name spells out.
function list_targets(): i32 {
    var all: string[] = platforms.targets();
    var i: i32 = 0;
    while (i < all.len()) {
        var d: platforms.Descriptor = platforms.for_target(all[i]);
        var line: string = d.name + ": " + d.isa + " / " + d.environment + "\n    capabilities: [";
        var c: i32 = 0;
        while (c < d.capabilities.len()) {
            if (c > 0) { line = line + " "; }
            line = line + d.capabilities[c];
            c = c + 1;
        }
        line = line + "]\n";
        if (!platforms.emits_code(d.name)) {
            line = line + "    note:         check-only — no backend emits for this target yet\n";
        }
        write(line);
        i = i + 1;
    }
    return 0;
}

// SsaResult carries the SSA backend's output and whether it applied.
struct SsaResult { asm: string, ok: boolean }

// try_ssa attempts to compile the whole program through the experimental SSA
// pipeline (build_func → optimise → emit). It is opt-in via -ssa now that the
// IR path is the production default (issue #4391); it applies only when EVERY
// function is in the SSA subset (build_func ok) and a `main` exists, otherwise
// it returns ok=false so the caller falls back to the AST shell (which itself
// routes eligible modules through the IR path). The SSA backends cover x86-64,
// arm64, and (a core integer subset of) wasm; arm64-darwin and the wasm binary
// output forms always fall back. Register allocation is always on for the
// native path.
function try_ssa(funcs: parser.FuncDecl[], structs: parser.StructDecl[], target: string, emit: string): SsaResult {
    if (target != "x86-64-linux" && target != "arm64-linux" && target != "arm64-android" && target != "wasm32-wasi") { return SsaResult { asm: "", ok: false }; }
    // The wasm SSA backend emits WAT and nothing wraps it, so it reaches only
    // the text form; a component or core module falls back to the IR path.
    if (target == "wasm32-wasi" && emit != "asm") { return SsaResult { asm: "", ok: false }; }
    // The set of user-defined function names the SSA backend can `call`, and
    // the subset that return a pointer (so their call results are 64-bit).
    // Lambda bindings `var f = function(...){...}` lift to top-level functions
    // (collect_lambdas); they're built like user functions and join the known /
    // ptr_ret sets. A capturing lambda's lifted body references an enclosing
    // local and fails to build (or a call lands on an unbuilt name), so the
    // whole program falls back to the AST emitter.
    var lifted: parser.FuncDecl[] = ssa.collect_lambdas(funcs);
    var allfuncs: parser.FuncDecl[] = funcs;
    var lai: i32 = 0;
    while (lai < lifted.len()) { allfuncs = allfuncs.append(lifted[lai]); lai = lai + 1; }
    var known: string[] = [];
    var ptr_ret: string[] = [];
    var float_ret: string[] = [];
    var ni: i32 = 0;
    while (ni < allfuncs.len()) {
        known = known.append(ssa.fn_sym(allfuncs[ni]));
        if (ssa.is_ptr_type(allfuncs[ni].ret_type) || ssa.is_struct_type(allfuncs[ni].ret_type, structs)) { ptr_ret = ptr_ret.append(ssa.fn_sym(allfuncs[ni])); }
        if (allfuncs[ni].ret_type == "f64") { float_ret = float_ret.append(ssa.fn_sym(allfuncs[ni])); }
        ni = ni + 1;
    }
    // The runtime helpers (map ops / array push / slice, ssa.ssa_helpers_src)
    // are emitted as calls by build_func; their names join known / ptr_ret so
    // those calls resolve, and the bodies are injected below (only the ones a
    // program actually uses). Without this a program using a map / push / slice
    // would fail calls_all_known and fall back to the AST emitter.
    var hmod: parser.Module = parser.parse_module(lexer.tokenize(ssa.ssa_helpers_src()));
    var hk: i32 = 0;
    while (hk < hmod.funcs.len()) {
        known = known.append(hmod.funcs[hk].name);
        if (ssa.is_ptr_type(hmod.funcs[hk].ret_type)) { ptr_ret = ptr_ret.append(hmod.funcs[hk].name); }
        hk = hk + 1;
    }
    // Derive the module-wide var-type seed (global function + receiver-method
    // signatures) once; build_func would otherwise rebuild it per function —
    // O(n²)+ persistent-vt pushes that OOM on large modules.
    var seed: ssa.Seed = ssa.build_seed(allfuncs);
    var sfuncs: ssa.SFunc[] = [];
    var has_main: boolean = false;
    var i: i32 = 0;
    while (i < allfuncs.len()) {
        var r: ssa.BResult = ssa.build_func_seeded(allfuncs[i], structs, seed);
        if (!r.ok) { return SsaResult { asm: "", ok: false }; }
        // A call to a builtin (print, write, …) or any unknown name can't be
        // lowered — fall back to the AST emitter for the whole program.
        if (!ssa.calls_all_known(r.func, known)) { return SsaResult { asm: "", ok: false }; }
        if (allfuncs[i].name == "main") { has_main = true; }
        sfuncs = sfuncs.append(ssa.optimize(ssa.mark_float_calls(ssa.mark_ptr_calls(r.func, ptr_ret), float_ret)));
        i = i + 1;
    }
    if (!has_main) { return SsaResult { asm: "", ok: false }; }
    // Inject each runtime helper body the program actually calls.
    var hj: i32 = 0;
    while (hj < hmod.funcs.len()) {
        if (ssa.calls_func(sfuncs, hmod.funcs[hj].name)) {
            var hr: ssa.BResult = ssa.build_func_seeded(hmod.funcs[hj], structs, seed);
            if (hr.ok) { sfuncs = sfuncs.append(ssa.optimize(ssa.mark_float_calls(ssa.mark_ptr_calls(hr.func, ptr_ret), float_ret))); }
        }
        hj = hj + 1;
    }
    // The wasm SSA backend covers a narrower subset than build_func (the
    // core integer ops); anything it can't lower yet falls back to the AST
    // wasm emitter rather than emitting broken WAT.
    if (target == "wasm32-wasi" && !ssa_wasm.supported(sfuncs)) { return SsaResult { asm: "", ok: false }; }
    var asm: string = "";
    if (target == "arm64-linux" || target == "arm64-android") { asm = ssa_arm64.emit_program(sfuncs, true); }
    else if (target == "wasm32-wasi") { asm = ssa_wasm.emit_program(sfuncs); }
    else { asm = ssa_x86.emit_program(sfuncs, true); }
    return SsaResult { asm: asm, ok: true };
}

// ssa_scan is the non-bailing twin of try_ssa: it runs build_func over EVERY
// function in the merged program (plus lifted lambdas), and instead of
// returning on the first failure it records ALL build_func failures and ALL
// unknown callees across the whole program in one pass — the measurement that
// `try_ssa` (first-bail, all-or-nothing) can't give. Used by `-ssa-scan` to
// prove the self-host compiler's per-function SSA coverage (zero failures +
// zero unknown callees = the whole compiler is in the subset; the only
// remaining blocker to a full SSA self-compile is then memory, not coverage).
function ssa_scan(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): i32 {
    var lifted: parser.FuncDecl[] = ssa.collect_lambdas(funcs);
    var allfuncs: parser.FuncDecl[] = funcs;
    var lai: i32 = 0;
    while (lai < lifted.len()) { allfuncs = allfuncs.append(lifted[lai]); lai = lai + 1; }
    // The same known set try_ssa builds: every user/lifted function symbol plus
    // the injected runtime-helper names (so map/push/slice calls resolve).
    var known: string[] = [];
    var ni: i32 = 0;
    while (ni < allfuncs.len()) { known = known.append(ssa.fn_sym(allfuncs[ni])); ni = ni + 1; }
    var hmod: parser.Module = parser.parse_module(lexer.tokenize(ssa.ssa_helpers_src()));
    var hk: i32 = 0;
    while (hk < hmod.funcs.len()) { known = known.append(hmod.funcs[hk].name); hk = hk + 1; }
    var seed: ssa.Seed = ssa.build_seed(allfuncs);

    var fails: string[] = [];
    var unknown: string[] = [];
    var i: i32 = 0;
    while (i < allfuncs.len()) {
        var r: ssa.BResult = ssa.build_func_seeded(allfuncs[i], structs, seed);
        if (!r.ok) {
            fails = fails.append(ssa.fn_sym(allfuncs[i]));
        } else {
            // Collect every call / funcaddr target this function emits that
            // isn't a known function (dedup) — the calls_all_known bail set.
            var bi: i32 = 0;
            while (bi < r.func.blocks.len()) {
                var blk: ssa.SBlock = r.func.blocks[bi];
                var k: i32 = 0;
                while (k < blk.insts.len()) {
                    var ins: ssa.SInst = blk.insts[k];
                    if (ins.kind_tag == 11 || ins.kind_tag == 13) {   // call / funcaddr
                        if (!util.has_str(known, ins.str) && !util.has_str(unknown, ins.str)) {
                            unknown = unknown.append(ins.str);
                        }
                    }
                    k = k + 1;
                }
                bi = bi + 1;
            }
        }
        i = i + 1;
    }

    write("functions scanned: " + checker.itoa_nn(allfuncs.len()) + "\n");
    write("build_func failures: " + checker.itoa_nn(fails.len()) + "\n");
    var fi: i32 = 0;
    while (fi < fails.len()) { write("  FAIL " + fails[fi] + "\n"); fi = fi + 1; }
    write("unknown callees: " + checker.itoa_nn(unknown.len()) + "\n");
    var ui: i32 = 0;
    while (ui < unknown.len()) { write("  UNKNOWN " + unknown[ui] + "\n"); ui = ui + 1; }
    if (fails.len() == 0 && unknown.len() == 0) { write("RESULT: full per-function SSA coverage (0 failures, 0 unknown callees)\n"); }
    else { write("RESULT: coverage gaps remain\n"); }
    return 0;
}

// main wraps `run` in the opt-in quadratic-copy readout (FERN_CLIFF_REPORT,
// #6056). Off by default, so an ordinary run is byte-identical in behaviour,
// output and exit code.
//
// rc_underflow_guard — which asm_ir_run and wasm_ir_run DO carry on every run —
// is deliberately NOT here yet, and that absence is a finding rather than an
// oversight. Wrapping `run` in it immediately turned an exit-0 compile into
// exit 120: this CLI over-releases 52 blocks compiling parser.fern and 92
// compiling checker.fern, while emitting byte-identical output. That is the
// #6021 signature exactly — correct output over a corrupted freelist, invisible
// until an unrelated change shifts allocation sizes and the poisoned head is
// popped — and it is why the production CLI being the one driver without the
// guard mattered. It is pre-existing, not a regression: a compiler built from
// the pre-#6043 native compiler reports the identical 52.
//
// Enabling the guard here is the acceptance test for that fix, so it goes in
// with it. Adding it now would only convert a silent corruption into a broken
// CLI. See #6057.
function main(): i32 {
    return util.arr_push_cliff_report("fern", run());
}

// target_writes_binary reports whether `-target t` produces a finished
// EXECUTABLE rather than assembler text or a wasm module — the targets that
// assemble and link in-process. Their output must land 0755, the way the
// native CLI's does: a non-executable binary run under qemu exits 1 with no
// output, which is indistinguishable from a program that ran and returned 1,
// and that has already cost one investigation a fabricated reproduction
// (#6133). A wasm core module / component is a binary too, but it is a module
// loaded by a runtime, not something the kernel execs, so it stays 0644 — as
// does anything `-emit asm` produced, which is text.
function target_writes_binary(t: string, emit: string): boolean {
    if (emit.len() > 0) { return false; }
    return t == "x86-64-linux" || t == "arm64-linux" || t == "arm64-android" || t == "arm64-darwin";
}

// write_output writes the compiler's output, executable when the target
// produced one. Both emit paths (the SSA one and the AST shell) go through it
// so the mode rule cannot be applied at one and forgotten at the other.
function write_output(out_path: string, data: string, t: string, emit: string): Result[void, IoError] {
    if (target_writes_binary(t, emit)) { return write_file_exec(out_path, data); }
    return write_file(out_path, data);
}

// capability_violations reports every call to a builtin the target does not
// grant (E066 — platforms.fern), printing one diagnostic per violation, and
// returns true when the program must be rejected.
//
// Two passes, because reachability is the expensive half. The flat scan over
// the whole bundle over-approximates: an imported stdlib wrapper nothing calls
// still counts. That answer is usually "nothing", and when it is, there is no
// reason to pay for the tree-shake — so the shake runs only once a candidate
// exists, and it is the shaken module's answer that is reported. Native does
// the same enforcement on an already-shaken program (cmd/fern's
// enforceTargetCapabilities); the cheap pre-pass is only about not shaking a
// module whose answer cannot change.
function capability_violations(merged: parser.Module, target: string): boolean {
    if (platforms.enforce(merged, target).len() == 0) { return false; }
    var vs: platforms.Violation[] = platforms.enforce(treeshake.treeshake(merged), target);
    var i: i32 = 0;
    while (i < vs.len()) {
        var v: platforms.Violation = vs[i];
        var msg: string = "error[E066]: " + platforms.violation_message(v);
        // Only the entry module's positions index the file being reported on
        // — an imported module's line numbers index ITS source, so a
        // violation from one degrades to a position-less line whose message
        // names the function and module instead. Native's renderer makes the
        // same split.
        if (v.fn_module.len() == 0 && v.line > 0) {
            eprint(checker.itoa_nn(v.line) + ":" + checker.itoa_nn(v.col) + ": " + msg + "\n");
        } else {
            eprint(msg + "\n");
        }
        i = i + 1;
    }
    return true;
}

// read_manifest parses `<dir>fern.toml`, or an empty manifest when the entry
// has none — which is every compiler source, and a program with no packages
// to govern.
function read_manifest(dir_slash: string): fern_toml.Manifest {
    match (read_file(dir_slash + "fern.toml")) {
        Ok(src) => { return fern_toml.parse(src); },
        Err(e) => { },
    }
    var no_deps: fern_toml.Dep[] = [];
    var no_members: string[] = [];
    var no_excl: string[] = [];
    return fern_toml.Manifest {
        name: "", lib: "lib.fern", index: "", deps: no_deps, members: no_members,
        excl_pkg: no_excl, excl_ver: no_excl,
    };
}

// manifest_reqs is a manifest's versioned ([package] index) dependencies as
// MVS demands: name → its declared LOWEST acceptable version.
function manifest_reqs(man: fern_toml.Manifest): mvs.Req[] {
    var out: mvs.Req[] = [];
    var i: i32 = 0;
    while (i < man.deps.len()) {
        if (man.deps[i].kind == "version" && man.deps[i].version.len() > 0) {
            out = out.append(mvs.Req { pkg: man.deps[i].name + "", min: man.deps[i].version + "" });
        }
        i = i + 1;
    }
    return out;
}

// find_manifest_dir walks up from `dir` to the first directory holding a
// fern.toml, or "" when nothing governs it.
function find_manifest_dir(dir: string): string {
    var d: string = dir;
    while (d.len() > 0) {
        var found: boolean = false;
        match (read_file(d + "/fern.toml")) {
            Ok(s) => { found = true; },
            Err(e) => { },
        }
        if (found) { return d; }
        if (d.len() <= 1) { return ""; }
        var up: string = dir_of(d);
        if (up.len() == 0) { up = "/"; }
        d = up;
    }
    return "";
}

// run_resolve implements `-resolve [DIR]`: read the manifest governing DIR,
// run Minimum Version Selection over its [package] index for every versioned
// dependency, and write the chosen versions to fern.lock. The compiler reads
// the lock, never the index (the no-build-time-network constraint), so this
// is the step that makes the following build offline.
//
// Two deliberate departures from native's `fern -resolve`. DIR must be
// absolute: there is no working-directory builtin, and a lock recording a
// path resolved against the wrong root is worse than a refusal. And a url
// source cannot be materialised — fetching is native-only — so an index
// entry MVS actually selects by url is a diagnostic rather than a download.
function run_resolve(start: string): i32 {
    if (start.len() == 0 || start[0] != 47) {   // '/'
        eprint("resolve: pass an absolute path (this driver has no working-directory builtin)");
        return 2;
    }
    var dir: string = start;
    match (read_file(start)) {
        Ok(s) => { dir = dir_of(start); },
        Err(e) => { },
    }
    var mdir: string = find_manifest_dir(dir);
    if (mdir.len() == 0) {
        eprint("resolve: no fern.toml governs " + dir);
        return 1;
    }
    var mpath: string = mdir + "/fern.toml";
    var man: fern_toml.Manifest = read_manifest(mdir + "/");
    var roots: mvs.Req[] = manifest_reqs(man);
    if (roots.len() == 0) {
        eprint("resolve: " + mpath + " declares no versioned dependencies (nothing to resolve)");
        return 1;
    }
    if (man.index.len() == 0) {
        eprint("resolve: " + mpath + " has versioned dependencies but no `index = \"…\"` under [package]");
        return 1;
    }
    var ipath: string = man.index;
    if (!mvs.is_abs(ipath)) { ipath = mvs.join_path(mdir, ipath); }
    var isrc: string = "";
    var iok: boolean = false;
    match (read_file(ipath)) {
        Ok(s) => { isrc = s; iok = true; },
        Err(e) => { },
    }
    if (!iok) {
        eprint("index " + ipath + ": cannot read");
        return 1;
    }
    var ix: mvs.Index = mvs.parse_index(isrc);
    if (ix.err.len() > 0) {
        eprint("index " + ipath + ": " + ix.err);
        return 1;
    }
    ix = mvs.with_dir(ix, mvs.join_path(dir_of(ipath), "."));

    var bans: mvs.Ban[] = [];
    var bi: i32 = 0;
    while (bi < man.excl_pkg.len()) {
        bans = bans.append(mvs.Ban { pkg: man.excl_pkg[bi] + "", ver: man.excl_ver[bi] + "" });
        bi = bi + 1;
    }

    // The step loop native spells as a `DepsOf` closure: materialise the
    // package version MVS is asking about and hand back ITS versioned deps.
    // That is what makes the resolution transitive, and it reads only the
    // versions actually selected.
    var st: mvs.State = mvs.begin(roots, bans, ix);
    while (st.err.len() == 0 && !mvs.done(st)) {
        var src: mvs.Source = mvs.index_source(ix, st.need_pkg, st.need_ver);
        if (src.path.len() == 0) {
            st = mvs.fail(st, "url sources need `fern -fetch`, which this driver does not have");
        } else {
            var dsrc: string = "";
            var dok: boolean = false;
            match (read_file(src.path + "/fern.toml")) {
                Ok(s) => { dsrc = s; dok = true; },
                Err(e) => { },
            }
            if (!dok) {
                st = mvs.fail(st, st.need_pkg + "@" + st.need_ver + " has no fern.toml");
            } else {
                st = mvs.supply(st, manifest_reqs(fern_toml.parse(dsrc)));
            }
        }
    }
    if (st.err.len() > 0) {
        eprint(st.err);
        return 1;
    }

    var sel: mvs.Sel[] = mvs.selected(st);
    var lock: string = mdir + "/fern.lock";
    var wrote: boolean = false;
    match (write_file(lock, mvs.lock_text(sel))) {
        Ok(u) => { wrote = true; },
        Err(e) => { },
    }
    if (!wrote) {
        eprint("resolve: cannot write " + lock);
        return 1;
    }
    eprint("resolve: " + util.i32_to_string(sel.len()) + " package(s) pinned in " + lock);
    var i: i32 = 0;
    while (i < sel.len()) {
        eprint("  " + sel[i].name + " " + sel[i].ver);
        i = i + 1;
    }
    return 0;
}

// Bundle is a loaded program: the entry module, the modules its imports
// pulled in, the flattened whole, and the packages the capability layers
// attribute to. `ok` is false when a module could not be read — the
// diagnostic is already printed.
struct Bundle {
    entry: parser.Module,
    loaded: flatten.LoadedModule[],
    merged: parser.Module,
    pkgs: caps.Pkg[],
    ok: boolean,
}

// load_bundle loads `entry_mod`'s transitive imports off disk and flattens
// them into one module (the import-driven scheme from asm_load_run). The
// entry is parsed by the caller, which needs it for `-fmt` before any import
// is resolved.
function load_bundle(entry_path: string, entry_mod: parser.Module, root: string): Bundle {
    var dir: string = dir_of(entry_path);
    // The entry's own manifest, when it has one: it names the dependency
    // packages, which are both a way to RESOLVE an import the sibling-file and
    // stdlib-root rules cannot name, and the identity every capability grant
    // is attached to (caps.fern / #6634).
    var dir_slash: string = "";
    if (dir.len() > 0) { dir_slash = dir + "/"; }
    var man: fern_toml.Manifest = read_manifest(dir_slash);
    var deps: string[] = fern_toml.dep_names(man);
    var pkgs: caps.Pkg[] = [root_pkg(man)];
    var no_mods: flatten.LoadedModule[] = [];

    var paths: string[] = add_imports([], entry_mod, root, deps);
    var loaded: flatten.LoadedModule[] = [];
    var done: string[] = [];
    var j: i32 = 0;
    while (j < paths.len()) {
        var ipath: string = paths[j];
        j = j + 1;
        if (!util.has_str(done, ipath)) {
            done = done.append(ipath);
            var mpath: string = resolve_path(ipath, dir, root);
            var msrc: string = "";
            var mok: boolean = false;
            match (read_file(mpath)) {
                Ok(s2) => { msrc = s2; mok = true; },
                Err(e) => { mok = false; },
            }
            if (!mok) {
                // Manifest fallback: a DECLARED dependency resolves through
                // fern.toml across the disk-resolvable forms (path, workspace
                // member, lock, vendor tree, content-addressed store). It is
                // the only way to reach a package that carries its own
                // manifest — the rules above can only name a sibling file or
                // something under the stdlib root.
                match (modloader.resolve_module_src(dir_slash, ipath, module_name(ipath))) {
                    Some(s3) => { msrc = s3; mok = true; },
                    None => { },
                }
            }
            if (!mok) {
                eprint("fern: cannot read module: ");
                eprint(mpath);
                eprint("\n");
                return Bundle { entry: entry_mod, loaded: no_mods, merged: entry_mod, pkgs: pkgs, ok: false };
            }
            var m: parser.Module = parser.parse_module(lexer.tokenize(msrc));
            loaded = loaded.append(flatten.LoadedModule { name: module_name(ipath), mod: m });
            pkgs = add_pkg(pkgs, man, dir_slash, ipath);
            paths = add_imports(paths, m, root, deps);
        }
    }
    var merged: parser.Module = flatten.bundle(entry_mod, loaded);
    // Fill omitted trailing args from default parameter values up front, so the
    // checker, SSA, interpreter, and AST fallback all see complete calls.
    merged = parser.fill_default_args_module(merged);
    // A record-form variant pattern on an IMPORTED enum has no declaration to
    // settle against until the bundle exists; parse_module resolved the
    // same-module ones already, and the pass is idempotent.
    merged = parser.resolve_variant_fields_module(merged);
    return Bundle { entry: entry_mod, loaded: loaded, merged: merged, pkgs: pkgs, ok: true };
}

// bundle_visibility_diags reports cross-module visibility errors (#6714): a
// reference to another module's non-`pub` function is an error, as it is in
// native's modload. Checked on the bundle, where flatten has already turned
// `lib.hidden` into the bare `lib__hidden`. Reported on the compile paths as
// well as `-check` — native REFUSES TO BUILD such a program, and accepting it
// here is the divergence. True means the program is refused.
function bundle_visibility_diags(b: Bundle): boolean {
    var vis_diags: checker.Diag[] = visibility.export_diags(b.entry, b.loaded);
    var vi: i32 = 0;
    while (vi < vis_diags.len()) {
        var vd: checker.Diag = vis_diags[vi];
        eprint(checker.itoa_nn(vd.line) + ":" + checker.itoa_nn(vd.col) + ": " + vd.message + "\n");
        vi = vi + 1;
    }
    return vis_diags.len() > 0;
}

// check_bundle type-checks a loaded program and reports its diagnostics,
// returning the exit code `-check` answers with: 0 well-typed and within
// every capability grant, 1 otherwise.
function check_bundle(b: Bundle, target: string, target_given: boolean): i32 {
    var merged: parser.Module = b.merged;
    var pkgs: caps.Pkg[] = b.pkgs;
    var mt: checker.ModuleTypes = checker.check_module(merged);
    // Surface the coded diagnostics (the same E0XX codes the Go
    // checker emits — see docs/SELFHOST-CHECKER-PORT.md) on stderr.
    // Positions aren't threaded through the AST yet, so a diagnostic
    // is `error[E0XX]: message` without a line:col prefix for now.
    var di: i32 = 0;
    while (di < mt.diags.len()) {
        var d: checker.Diag = mt.diags[di];
        // An empty code renders with no `error[…]` segment — some native
        // diagnostics are uncoded (the const-grammar rule is one), and
        // parity is on the text native actually prints.
        var tag: string = "";
        if (d.code.len() > 0) { tag = "error[" + d.code + "]: "; }
        if (d.line > 0) {
            eprint(checker.itoa_nn(d.line) + ":" + checker.itoa_nn(d.col) + ": " + tag + d.message + "\n");
        } else {
            eprint(tag + d.message + "\n");
        }
        di = di + 1;
    }
    // The capability boundary, when a target was asked for. It runs
    // whatever the checker concluded: the scan is syntactic — a call to a
    // named builtin — so it holds where the partial checker collapses an
    // expression to TypeUnknown (#4346), and that is exactly where a
    // violation would otherwise go unreported while native names it.
    var caps_violated: boolean = false;
    if (target_given) { caps_violated = capability_violations(merged, target); }
    // The package boundary (E070) runs whether or not a target was named:
    // what a dependency may reach is a property of the manifests, not of
    // what the program is being built for.
    if (package_violations(merged, pkgs)) { caps_violated = true; }
    if (mt.all_well_typed) {
        if (caps_violated) { return 1; }
        return 0;
    }
    // The module is ill-typed but produced no coded diagnostic — an
    // expression collapsed to TypeUnknown on a type the partial checker
    // can't model yet (#4346). Surface a best-effort hint so `-check`
    // never exits 1 silently; the native `fern` remains the full oracle.
    if (mt.diags.len() == 0) {
        var hints: checker.Diag[] = checker.ill_typed_hint(merged);
        var hi: i32 = 0;
        while (hi < hints.len()) {
            var h: checker.Diag = hints[hi];
            if (h.line > 0) {
                eprint(checker.itoa_nn(h.line) + ":" + checker.itoa_nn(h.col) + ": error[" + h.code + "]: " + h.message + "\n");
            } else {
                eprint("error[" + h.code + "]: " + h.message + "\n");
            }
            hi = hi + 1;
        }
    }
    return 1;
}

// package_entry returns the entry module to type-check for the package rooted
// at `dir`: its manifest's `lib` module when that file exists, else
// `main.fern` (an application member), else "" — the caller reports it naming
// both spellings, as native does.
function package_entry(dir: string): string {
    var lib: string = read_manifest(dir + "/").lib;
    if (file_readable(dir + "/" + lib)) { return dir + "/" + lib; }
    if (file_readable(dir + "/main.fern")) { return dir + "/main.fern"; }
    return "";
}

function file_readable(path: string): boolean {
    match (read_file(path)) {
        Ok(s) => { return true; },
        Err(e) => { return false; },
    }
    return false;
}

// is_dir reports whether `path` names a directory. `read_dir` is the probe: a
// file answers ENOTDIR, so a mistyped entry path stays a file error rather
// than being read as a package directory.
function is_dir(path: string): boolean {
    match (read_dir(path)) {
        Ok(names) => { return true; },
        Err(e) => { return false; },
    }
    return false;
}

// check_dir implements `-check <DIR>`: type-check the package governing DIR,
// or — when that manifest declares a `[workspace]` — every member of it,
// aggregating rather than stopping at the first failure, so one broken package
// does not hide the rest. This is the workspace-wide check a multi-package
// program wants: one command validates every member.
function check_dir(dir: string, root: string, target: string, target_given: boolean): i32 {
    var mdir: string = find_manifest_dir(dir);
    if (mdir.len() == 0) {
        eprint("check: " + dir + " is a directory with no fern.toml — pass a .fern file, or run inside a package");
        return 1;
    }
    var man: fern_toml.Manifest = read_manifest(mdir + "/");
    if (man.members.len() == 0) {
        var entry: string = package_entry(mdir);
        if (entry.len() == 0) {
            eprint("no entry module in " + mdir + " (looked for " + man.lib + " and main.fern)");
            return 1;
        }
        return check_file(entry, root, target, target_given);
    }
    var failed: i32 = 0;
    var i: i32 = 0;
    while (i < man.members.len()) {
        var rel: string = man.members[i];
        i = i + 1;
        var mem: string = rel;
        if (!mvs.is_abs(rel)) { mem = mvs.join_path(mdir, rel); }
        var mentry: string = package_entry(mem);
        if (mentry.len() == 0) {
            eprint("FAIL " + rel + ": no entry module in " + mem + " (looked for " + read_manifest(mem + "/").lib + " and main.fern)");
            failed = failed + 1;
            continue;
        }
        if (check_file(mentry, root, target, target_given) != 0) {
            eprint("FAIL " + rel);
            failed = failed + 1;
            continue;
        }
        eprint("ok   " + rel);
    }
    if (failed > 0) {
        eprint("check: " + util.i32_to_string(failed) + " of " + util.i32_to_string(man.members.len()) + " workspace member(s) failed");
        return 1;
    }
    eprint("check: " + util.i32_to_string(man.members.len()) + " workspace member(s) ok");
    return 0;
}

// check_file loads one entry module and type-checks it — the single-package
// half of `-check`, and the per-member step of the workspace half.
function check_file(entry_path: string, root: string, target: string, target_given: boolean): i32 {
    var src: string = "";
    var ok: boolean = false;
    match (read_file(entry_path)) {
        Ok(s) => { src = s; ok = true; },
        Err(e) => { },
    }
    if (!ok) {
        eprint("fern: cannot read entry file: " + entry_path);
        return 1;
    }
    var b: Bundle = load_bundle(entry_path, parser.parse_module(lexer.tokenize(src)), root);
    if (!b.ok) { return 1; }
    if (bundle_visibility_diags(b)) { return 1; }
    return check_bundle(b, target, target_given);
}

// root_pkg is the entry's own package: its manifest's [package] name, or
// `(root)` when nothing governs the program. It is never enforced or warned —
// grants restrict DEPENDENCIES, and the program's author is trusting
// themselves.
function root_pkg(man: fern_toml.Manifest): caps.Pkg {
    var name: string = "(root)";
    if (man.name.len() > 0) { name = man.name; }
    var no_grants: string[] = [];
    return caps.Pkg { module: "", name: name, root: true, governed: false, grants: no_grants };
}

// dep_pkg_name is a dependency's REPORT name: the [package] name in its own
// manifest, falling back to the key that declared it. Native attributes by the
// governing manifest, so a dep declared under a different key still reports
// under its own name.
function dep_pkg_name(man: fern_toml.Manifest, dir_slash: string, dep: string): string {
    match (fern_toml.dep_path(man, dep)) {
        Some(dp) => {
            match (read_file(dir_slash + dp + "/fern.toml")) {
                Ok(src) => {
                    var dm: fern_toml.Manifest = fern_toml.parse(src);
                    if (dm.name.len() > 0) { return dm.name; }
                },
                Err(e) => { },
            }
        },
        None => { },
    }
    return dep;
}

// add_pkg records the package a just-loaded module belongs to. Three cases,
// matching native's resolver: a local sibling folds into the root package, a
// declared dependency is its own package carrying that entry's grant, and
// anything else (the stdlib) gets no entry at all — caps.analyze folds a
// module with no entry into whichever package calls it.
//
// Only the ENTRY manifest is consulted, because that is as far as this
// driver's loader resolves: a dependency's own dependencies are not reachable
// from here, so there is no deeper package to attribute.
function add_pkg(pkgs: caps.Pkg[], man: fern_toml.Manifest, dir_slash: string, import_path: string): caps.Pkg[] {
    var mod: string = module_name(import_path);
    var no_grants: string[] = [];
    if (is_local(import_path)) {
        return pkgs.append(caps.Pkg { module: mod, name: pkgs[0].name, root: true, governed: false, grants: no_grants });
    }
    if (fern_toml.dep_kind(man, mod).len() == 0) { return pkgs; }
    return pkgs.append(caps.Pkg {
        module: mod,
        name: dep_pkg_name(man, dir_slash, mod),
        root: false,
        governed: fern_toml.dep_governed(man, mod),
        grants: fern_toml.dep_caps(man, mod),
    });
}

// package_violations is phase 2 of docs/PACKAGE-CAPABILITIES-BRIEF.md: hold
// every dependency package to the grant in the manifest that declares it
// (caps.fern — E070). A governed package reaching outside its grant is an
// error; an ungoverned one warns and is allowed, which is the migration
// default for manifests predating the key. Returns true when the program must
// be rejected.
//
// The reachability walk is skipped outright when no non-root package has any
// function in the bundle — the common single-package compile, including every
// compiler source.
function package_violations(merged: parser.Module, pkgs: caps.Pkg[]): boolean {
    if (!caps.enforceable(merged, pkgs)) { return false; }
    var vs: caps.Violation[] = caps.enforce(caps.analyze(merged, pkgs), pkgs);
    var bad: boolean = false;
    var i: i32 = 0;
    while (i < vs.len()) {
        if (!vs[i].governed) { eprint("warning: " + caps.violation_message(vs[i]) + "\n"); }
        i = i + 1;
    }
    var k: i32 = 0;
    while (k < vs.len()) {
        if (vs[k].governed) {
            eprint("error[E070]: " + caps.violation_message(vs[k]) + "\n");
            bad = true;
        }
        k = k + 1;
    }
    return bad;
}

function run(): i32 {
    var av: string[] = args();

    var entry_path: string = "";
    var out_path: string = "";
    var root: string = "";
    var target: string = "x86-64-linux";
    // Output FORM, independent of the target: "" is the target's default
    // (a linked executable, or a component on wasm), "asm" the emitter's
    // text, "core-module" a raw wasm core module.
    var emit: string = "";
    var mode_check: boolean = false;
    var mode_interp: boolean = false;
    var mode_fmt: boolean = false;
    var mode_caps: boolean = false;
    var mode_targets: boolean = false;
    var mode_resolve: boolean = false;
    var use_ssa: boolean = false;
    var mode_scan: boolean = false;
    var optimize: boolean = false;
    var emit_syms: boolean = false;
    var have_entry: boolean = false;
    // Whether -target was given, as distinct from the default above. It only
    // matters to `-check`: native type-checks against a capability set only
    // when asked for a target, so enforcing the default one here would refuse
    // a program `fern -check` accepts.
    var target_given: boolean = false;

    var i: i32 = 1;
    while (i < av.len()) {
        var a: string = av[i];
        if (a == "-check") {
            mode_check = true;
        } else if (a == "-interp") {
            mode_interp = true;
        } else if (a == "-fmt") {
            mode_fmt = true;
        } else if (a == "-ssa") {
            // Opt into the experimental SSA lowering pipeline (build_func →
            // optimise → regalloc → emit) for x86-64 / arm64 / a wasm subset.
            // The IR path is the production default now (issue #4391 /
            // docs/SELFHOST-SSA-DECISION.md); -ssa is opt-in/experimental.
            use_ssa = true;
        } else if (a == "-no-ssa") {
            // Back-compat no-op: the IR/AST path is already the default, so
            // there is nothing to disable. Accepted so existing invocations
            // (and the AST-baseline tests) keep working unchanged.
        } else if (a == "-ssa-scan") {
            // Diagnostic: report every build_func failure + unknown callee across
            // the whole merged program (non-bailing), then exit. Measures
            // per-function SSA coverage without the all-or-nothing try_ssa bail.
            mode_scan = true;
        } else if (a == "-g") {
            // Emit a static .symtab into the native binary (#6637). x86-64
            // Linux only for now: arm64 links through arm64_gas_link's W^X
            // image, which needs its own wiring. Native excludes darwin and
            // android from -g too.
            emit_syms = true;
        } else if (a == "-capabilities") {
            mode_caps = true;
        } else if (a == "-resolve") {
            // Version resolution (MVS) over the manifest's [package] index,
            // writing fern.lock. It reads manifests, not sources, so it takes
            // a directory rather than an entry file.
            mode_resolve = true;
        } else if (a == "-targets") {
            mode_targets = true;
        } else if (a == "-emit") {
            i = i + 1;
            if (i >= av.len()) { return usage(); }
            emit = av[i];
        } else if (a == "-O") {
            optimize = true;
        } else if (a == "-target") {
            i = i + 1;
            if (i >= av.len()) { return usage(); }
            target = av[i];
            target_given = true;
        } else if (a == "-o") {
            i = i + 1;
            if (i >= av.len()) { return usage(); }
            out_path = av[i];
        } else if (is_flag(a)) {
            eprint("fern: unknown flag: ");
            eprint(a);
            eprint("\n");
            return 2;
        } else {
            if (!have_entry) {
                entry_path = a;
                have_entry = true;
            } else {
                root = a;
            }
        }
        i = i + 1;
    }

    // `-targets` answers from the table alone; it needs no entry file.
    if (mode_targets) { return list_targets(); }

    // `-resolve` takes a directory (or any file inside the package), not an
    // entry module — it reads manifests and never compiles anything.
    if (mode_resolve) { return run_resolve(entry_path); }

    if (!have_entry) { return usage(); }

    // `-check <DIR>` checks the package governing DIR, or every member of the
    // workspace it roots. A file argument takes the single-entry path below,
    // and so does a bad one — `is_dir` answers false for both.
    if (mode_check && is_dir(entry_path)) { return check_dir(entry_path, root, target, target_given); }

    if (!platforms.for_target(target).known) {
        // One eprint, not one per name: eprint appends its own newline, so a
        // loop of them prints the target list down the left margin.
        var msg: string = "fern: unknown -target: " + target + " (want one of:";
        var tn: string[] = platforms.targets();
        var ti: i32 = 0;
        while (ti < tn.len()) { msg = msg + " " + tn[ti]; ti = ti + 1; }
        eprint(msg + ")");
        return 2;
    }
    if (emit.len() > 0 && emit != "asm" && emit != "core-module") {
        eprint("fern: unknown -emit: " + emit + " (want asm, core-module, or omit it for the target's default output form)\n");
        return 2;
    }
    if (emit == "core-module" && platforms.for_target(target).isa != "wasm32") {
        eprint("fern: -emit core-module is a wasm output form; -target " + target + " has no core module to emit\n");
        return 2;
    }

    // Load the entry + its transitive imports off disk and flatten them
    // into one module (the import-driven scheme from asm_load_run).
    var dir: string = dir_of(entry_path);
    var esrc: string = "";
    var eok: boolean = false;
    match (read_file(entry_path)) {
        Ok(s) => { esrc = s; eok = true; },
        Err(e) => { eok = false; },
    }
    if (!eok) {
        eprint("fern: cannot read entry file: ");
        eprint(entry_path);
        eprint("\n");
        return 1;
    }
    var entry_mod: parser.Module = parser.parse_module(lexer.tokenize(esrc));

    // -fmt is per-file: format the entry source and emit it, without
    // loading transitive imports (formatting one file never needs them).
    if (mode_fmt) {
        var formatted: string = printer.print_module(entry_mod);
        if (out_path.len() > 0) {
            match (write_file(out_path, formatted)) {
                Err(e) => {
                    eprint("fern: cannot write output: ");
                    eprint(out_path);
                    eprint("\n");
                    return 1;
                },
                Ok(_) => {},
            }
        } else {
            write(formatted);
        }
        return 0;
    }

    var b: Bundle = load_bundle(entry_path, entry_mod, root);
    if (!b.ok) { return 1; }
    var merged: parser.Module = b.merged;
    var pkgs: caps.Pkg[] = b.pkgs;

    if (bundle_visibility_diags(b)) { return 1; }

    // `-capabilities`: print the per-package capability report and stop
    // (docs/PACKAGE-CAPABILITIES-BRIEF.md phase 1). Report mode enforces
    // nothing — the grants are enforced on the compile / -check / -interp
    // paths below.
    if (mode_caps) {
        write(caps.format_rows(caps.analyze(merged, pkgs)));
        return 0;
    }

    if (mode_scan) { return ssa_scan(merged.funcs, merged.structs); }

    if (mode_check) { return check_bundle(b, target, target_given); }

    if (mode_interp) {
        // Package-capability gate (E070 — caps.fern): a dependency reaching
        // past its grant is refused before the program runs, not after it has
        // already opened the socket.
        if (package_violations(merged, pkgs)) { return 1; }
        // Evaluate via the tree-walking interpreter; the program's
        // result becomes the process exit code (VInt → its value,
        // VBool → 1/0), matching interp_run.fern. A non-i32/bool
        // result exits 254.
        var result: interp.Value = interp.eval_module(merged);
        match (result) {
            interp.VInt(iv) => { return iv.v; },
            interp.VBool(bv) => {
                if (bv.v) { return 1; }
                return 0;
            },
            // The interpreter's bottom carries WHY it stopped. Printing it is
            // the difference between "exit 254" and a usable report: #5990 was
            // filed against a silent 254 whose cause (an unimplemented
            // construct) the message already named.
            interp.VErr(ev) => {
                eprint("fern: interp: " + ev.msg + "\n");
                return 254;
            },
            _ => { return 254; },
        }
        return 254;
    }

    // Immutability gate: reject the immutable-data cycle rules (E048 field
    // assign / E049 reference-capture write-back / E055 discarded pure-
    // collection result / E056 subscript assign / E057 Cell[composite]
    // element) BEFORE codegen, so the compiler is not MORE permissive than
    // the native compiler / `-check`
    // (issue #2825 — the SSA / IR / AST codegen paths previously compiled
    // forbidden field mutation like `p.x = v` straight to a working binary).
    // Native always type-checks ahead of codegen; this is the matching gate
    // for the self-host CLI's compile path. Filtered to the cycle rules so
    // the partial checker's other rules can't false-positive-reject a valid
    // program (or this very source under fixpoint), and reported with the
    // same `line:col: error[CODE]: message` shape as `-check`.
    var imm: checker.Diag[] = checker.filter_immutability(checker.check_module(merged).diags);
    if (imm.len() > 0) {
        var ii: i32 = 0;
        while (ii < imm.len()) {
            var idg: checker.Diag = imm[ii];
            if (idg.line > 0) {
                eprint(checker.itoa_nn(idg.line) + ":" + checker.itoa_nn(idg.col) + ": error[" + idg.code + "]: " + idg.message + "\n");
            } else {
                eprint("error[" + idg.code + "]: " + idg.message + "\n");
            }
            ii = ii + 1;
        }
        return 1;
    }

    // Target-capability gate (E066 — platforms.fern): reject, before codegen,
    // a call to a runtime builtin the target's descriptor does not grant
    // (`subprocess` anywhere compiled, `proc_fork` / `__heap_mark` on wasm).
    // Without it the self-host compiles a program native refuses, and the
    // failure lands mid-build as an undefined label or, on wasm, as a
    // host-side instantiation error.
    if (capability_violations(merged, target)) { return 1; }

    // Package-capability gate (E070 — caps.fern): the other capability
    // system, gating what a DEPENDENCY may reach rather than what the target
    // provides. Without it the self-host builds a program native refuses.
    if (package_violations(merged, pkgs)) { return 1; }

    // -O: constant-fold the program before codegen (constfold.fold_module),
    // matching the native compiler's constant folding. Compile-only — applied
    // after -check / -interp / -fmt (which return above and want the original
    // AST), ahead of both the SSA and AST emit paths. Folding is
    // behaviour-preserving (it skips `/`/`%` by zero, leaving the runtime
    // error intact), so it changes only the shape of the emitted code.
    if (optimize) {
        merged = constfold.fold_module(merged);
    }

    // typed-IR (#5531): stamp each call expression with its checker-inferred
    // result type so the IR lowering READS the type instead of re-deriving it
    // structurally (docs/TYPED-IR-REWRITE.md). Runs after check + constfold and
    // before every emit path, so the emit_module_ir routing sees c.ty. Deterministic,
    // so the byte-identical self-compile fixpoint is preserved.
    merged = checker.annotate_module(merged);

    // Production default: the IR path. All three targets route IR-or-error
    // (asm_ir / asm_arm64_ir / wasm_ir `.emit_module*_or_error`, #3457), so this
    // driver imports no legacy AST emitter at all — there are none left to
    // import. The IR is the single production lowering (issue #4391 /
    // docs/SELFHOST-SSA-DECISION.md). The SSA pipeline is opt-in
    // via -ssa (experimental): it applies only if every function is in the SSA
    // subset (else it too falls through), covering x86-64 / arm64 / a wasm
    // subset. arm64-darwin and the wasm binary output forms have no SSA
    // consumer and always use the AST shell.
    if (use_ssa) {
        var sr: SsaResult = try_ssa(merged.funcs, merged.structs, target, emit);
        if (sr.ok) {
            // Both Linux targets emit a runnable ELF in-process (x86_native /
            // arm64_native + elf.fern), dropping the `.s` + gcc/ld link —
            // same flip as arm64-darwin. Other targets write the SSA text
            // as-is.
            var ssa_out: string = sr.asm;
            if (emit != "asm") {
                if (target == "x86-64-linux") {
                    ssa_out = x86_elf_binary(sr.asm, emit_syms);
                    if (ssa_out.len() == 0) { return 2; }
                } else if (target == "arm64-linux") {
                    ssa_out = arm64_elf_binary(sr.asm, emit_syms);
                    if (ssa_out.len() == 0) { return 2; }
                } else if (target == "arm64-android") {
                    ssa_out = arm64_elf_binary_pie(sr.asm);
                    if (ssa_out.len() == 0) { return 2; }
                }
            }
            if (out_path.len() > 0) {
                match (write_output(out_path, ssa_out, target, emit)) {
                    Err(e) => {
                        eprint("fern: cannot write output: ");
                        eprint(out_path);
                        eprint("\n");
                        return 1;
                    },
                    Ok(_) => {},
                }
            } else {
                write(ssa_out);
            }
            return 0;
        }
    }

    if (!platforms.emits_code(target)) {
        // Native reports the same shape from its descriptor's NoBackend flag.
        // A freestanding target type-checks (against an empty capability set)
        // and has nothing to lower with, so refusing here is the honest answer
        // — the alternative is an artifact built for the wrong machine.
        eprint("fern: -target " + target + ": check-only — no backend emits for this target yet\n");
        return 2;
    }

    var full: parser.Module = parser.module_with_builtins(merged);
    var out_asm: string = "";
    var emit_text: boolean = emit == "asm";
    if (target == "arm64-linux") {
        // `-emit asm` is the arm64 emitter's GAS text, stopping short of the
        // in-process assembler + linker the default form runs on top of it —
        // the shape a harness wants when it assembles with its own toolchain.
        //
        // It is also the only way to observe the emitter in isolation, which
        // is what corrected #6011: measured through the linked form the arm64
        // path looked 5x hungrier than x86-64, but that compared "emit +
        // assemble + link" against x86-64's "emit". Emitter to emitter they
        // are at parity (1.56 GB vs 1.50 GB on an empty `main` importing
        // std/array); the excess is all in arm64_gas_program.
        //
        // The default form is the in-process ELF (arm64_native + elf.fern) —
        // no `.s` + gcc/ld. Both run the IR path; -ssa opts into the SSA
        // pipeline above instead.
        out_asm = asm_arm64_ir.emit_module_or_error(full, false);
        if (out_asm.len() == 0) { return 2; }
        if (!emit_text) {
            out_asm = arm64_elf_binary(out_asm, emit_syms);
            if (out_asm.len() == 0) { return 2; }
        }
    } else if (target == "arm64-android") {
        // arm64-android is the arm64 emitter wrapped in a static-PIE (ET_DYN)
        // image instead of the fixed-address W^X one. The emitter's text is
        // the same as arm64-linux's — the PIE-ness is a link-time property —
        // so `-emit asm` produces the same GAS either way.
        out_asm = asm_arm64_ir.emit_module_or_error(full, false);
        if (out_asm.len() == 0) { return 2; }
        if (!emit_text) {
            out_asm = arm64_elf_binary_pie(out_asm);
            if (out_asm.len() == 0) { return 2; }
        }
    } else if (target == "arm64-darwin") {
        // Same arm64 code generator with the Darwin syscall builtins
        // (gettimeofday / getentropy) selected via the darwin flag;
        // darwinize() reskins the emitter output into the Mach-O assembler
        // dialect (@PAGE/@PAGEOFF, _main entry, BSD syscalls). That GAS
        // text is then assembled + linked entirely in-process by
        // arm64_native: arm64_gas_program parses + selects instructions,
        // macho_text_vaddr/macho_data_vaddr fix the segment addresses,
        // arm64_gas_link resolves @PAGE/@PAGEOFF + branch fixups against
        // them, and macho_executable writes the signed Mach-O
        // (ad-hoc LC_CODE_SIGNATURE — Apple Silicon refuses unsigned
        // binaries). No external clang / ld64. The output bytes are packed
        // into a string written verbatim by write_file (see the wasm core
        // module for the same i32[]->u8[]->string idiom).
        //
        // `-emit asm` stops at the darwinized text: it is the only way to hand
        // the emitter's output to clang, which decides whether a misbehaving
        // binary is the emitter's fault or arm64_gas_program's.
        out_asm = asm_arm64_ir.darwinize(asm_arm64_ir.emit_module_or_error(full, true));
        if (out_asm.len() == 0) { return 2; }
        if (!emit_text) {
            var prog: arm64_native.Arm64GasProg = arm64_native.arm64_gas_program(out_asm);
            if (prog.unknown.len() > 0) {
                var _ar: string = arm64_refusals("arm64-darwin", "assembler", prog.unknown);
                return 2;
            }
            var pa: arm64_native.Arm64Asm = prog.asm;
            var tv: i64 = arm64_native.macho_text_vaddr(pa.code.len(), prog.data.len());
            var dv: i64 = arm64_native.macho_data_vaddr(pa.code.len(), prog.data.len());
            prog = arm64_native.arm64_gas_link(prog, tv, dv);
            if (prog.unknown.len() > 0) {
                var _lr: string = arm64_refusals("arm64-darwin", "linker", prog.unknown);
                return 2;
            }
            var pa2: arm64_native.Arm64Asm = prog.asm;
            // darwinize renames the ELF `_start` entry to `_main`; like the
            // ELF path, resolve its label rather than assuming offset 0 — the
            // emitter writes the entry after the user's functions.
            var deoff: i32 = arm64_native.macho_entry_off(pa2);
            var dreb: i32[] = arm64_native.arm64_gas_rebase_offs(prog);
            out_asm = string_from_bytes_unchecked(to_u8(arm64_native.macho_executable(pa2.code, prog.data, "fern", deoff, prog.bss_size, dreb)));
        }
    } else if (target == "wasm32-wasi" && emit_text) {
        // WASI core module in text format (WAT). Runnable directly by
        // `wasmtime run`; main()'s result becomes the process exit code.
        out_asm = wasm_ir.emit_module_mode_or_error(full, false, false);
    } else if (target == "wasm32-wasi" && emit == "core-module") {
        // Same WASI core module, assembled to the wasm *binary* format:
        // emit WAT, then run it through the self-hosted
        // WAT->binary assembler (watbin). The binary bytes (an i32[] of
        // 0..255) are packed into a string whose bytes write_file / write
        // emit verbatim, so the output file is a runnable `.wasm`.
        out_asm = string_from_bytes_unchecked(to_u8(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, false, false))));
    } else if (target == "wasm32-wasi") {
        // A Component-Model `wasi:cli/run` component. Pick the framing from
        // the program's WASI usage: no-I/O (component_full), stdout/exit
        // (component_full_io), or filesystem read / write / read+write over
        // stdout (component_full_io_fs / _fs_write / _fs_rw). Programs using
        // WASI the self-host component path doesn't wrap yet (random / env /
        // args / clock / stderr) are rejected rather than emitting a broken
        // component.
        var shape: i32 = wasm_ir.component_shape(full);
        if (shape < 0) {
            eprint("fern: -target wasm32-wasi: program uses WASI imports not yet supported by the component wrapper (no-I/O, stdout, and filesystem are wrapped so far); -emit core-module emits the bare module instead\n");
            return 2;
        }
        var comp: i32[] = [];
        if (shape == 1) {
            comp = watbin.component_full_io(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 2) {
            comp = watbin.component_full_io_fs(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 3) {
            comp = watbin.component_full_io_fs_write(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 4) {
            comp = watbin.component_full_io_fs_rw(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 5) {
            comp = watbin.component_full_io_random(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 6) {
            comp = watbin.component_full_io_env(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 7) {
            comp = watbin.component_full_io_args(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 8) {
            comp = watbin.component_full_io_clock(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 9) {
            comp = watbin.component_full_io_clock_mono(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 13) {
            comp = watbin.component_full_io_eprint(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 14) {
            comp = watbin.component_full_io_exit(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 10) {
            comp = watbin.component_full_io_fs_read_env(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 11) {
            comp = watbin.component_full_io_fs_rw_env(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 12) {
            comp = watbin.component_full_io_random_write(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 15) {
            comp = watbin.component_full_io_fs_args_read(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else if (shape == 16) {
            comp = watbin.component_full_io_fs_rw_args(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, true)));
        } else {
            comp = watbin.component_full(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error(full, true, false)));
        }
        out_asm = string_from_bytes_unchecked(to_u8(comp));
    } else {
        // #3457 slice 3: the x86 CLI path routes IR-or-error, never the legacy
        // AST emitter. As of slice 5 asm.emit_module has no callers at all.
        // `-emit asm` stops at that text — what a harness assembling with its
        // own toolchain wants; the default form assembles + links it in-process
        // (x86_native + elf.fern), so it produces a runnable binary like
        // arm64-linux does and needs nothing on $PATH.
        out_asm = asm_ir.emit_module_or_error(full);
        if (!emit_text) {
            out_asm = x86_elf_binary(out_asm, emit_syms);
            if (out_asm.len() == 0) { return 2; }
        }
    }
    if (out_path.len() > 0) {
        match (write_output(out_path, out_asm, target, emit)) {
            Err(e) => {
                eprint("fern: cannot write output: ");
                eprint(out_path);
                eprint("\n");
                return 1;
            },
            Ok(_) => {},
        }
    } else {
        write(out_asm);
    }
    return 0;
}
