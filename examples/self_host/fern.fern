// examples/self_host/fern.fern — the unified self-hosted `fern` CLI
// driver. Where the older `*_run.fern` shims each hard-wired one mode
// (asm_load_run = emit, checker_run = check, interp_run = evaluate),
// this is a single binary that parses argv flags and dispatches:
//
//     fern <entry.fern> [stdlib-root]      emit asm to stdout (def x86-64)
//     fern -target arm64 <entry.fern>      emit arm64 (Linux ELF) asm
//     fern -target arm64-darwin <e.fern>   emit arm64 (macOS Mach-O) asm
//     fern -target wasm <entry.fern>       emit a WASI WAT module
//     fern -o OUT <entry.fern>             emit asm to OUT
//     fern -check <entry.fern>             type-check; exit 0 ok / 1 bad
//     fern -interp <entry.fern>            evaluate; exit = program result
//     fern -fmt <entry.fern>               format the entry file to stdout
//
// It is a drop-in-shaped replacement for cmd/fern: one binary hosting
// both the x86-64 (asm.fern) and arm64 (asm_arm64.fern) emitters,
// selected at runtime by -target — where the codebase previously had
// two separate compilers. Module loading is the import-driven,
// file-loading scheme from asm_load_run (follow `import "./x"` to
// sibling files; resolve `std/…` / `core/…` under an optional stdlib
// root).

import "core/no_prelude";
import "./lexer";
import "./parser";
import "./flatten";
import "./asm";
import "./asm_arm64";
import "./wasm";
import "./checker";
import "./interp";
import "./printer";
import "./ssa";
import "./ssa_x86";
import "./ssa_arm64";

// last_slash returns the index of the final '/' in p, or -1.
function last_slash(p: string): i32 {
    var i: i32 = 0;
    var last: i32 = 0 - 1;
    while (i < p.len()) {
        if (p[i] == 47) { last = i; }
        i = i + 1;
    }
    return last;
}

// dir_of returns the directory portion of a path ("" if none).
function dir_of(p: string): string {
    var ls: i32 = last_slash(p);
    if (ls < 0) { return ""; }
    return p[0:ls];
}

// module_name maps an import path to its bundle name: the final path
// segment (`./a/lexer` → `lexer`, `./parser` → `parser`).
function module_name(import_path: string): string {
    var ls: i32 = last_slash(import_path);
    if (ls >= 0) { return import_path[ls + 1:import_path.len()]; }
    return import_path;
}

// is_local is true for `./…` / `../…` imports (loaded from the entry's
// directory), false for `core/…` / `std/…` (resolved under the stdlib
// root, when one is configured).
function is_local(import_path: string): boolean {
    if (import_path.len() == 0) { return false; }
    return import_path[0] == 46;   // '.'
}

// join_path builds `<dir>/<name>.fern` (or `<name>.fern` if dir empty).
function join_path(dir: string, name: string): string {
    if (dir.len() == 0) { return name + ".fern"; }
    return dir + "/" + name + ".fern";
}

function contains_name(xs: string[], n: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == n) { return true; }
        i = i + 1;
    }
    return false;
}

// should_load decides whether an import path names a module file to
// load. Local (`./…`) imports always load; `std/…` / `core/…` load only
// when a stdlib root is given; `core/no_prelude` is a directive.
function should_load(import_path: string, root: string): boolean {
    if (import_path.len() == 0) { return false; }
    if (is_local(import_path)) { return true; }
    if (root.len() == 0) { return false; }
    if (import_path == "core/no_prelude") { return false; }
    return true;
}

// resolve_path maps an import path to a file on disk.
function resolve_path(import_path: string, entry_dir: string, root: string): string {
    if (is_local(import_path)) {
        return join_path(entry_dir, module_name(import_path));
    }
    return root + "/" + import_path + ".fern";
}

// add_imports appends each of mod's loadable import paths to paths
// (deduped by full path), returning the grown list.
function add_imports(paths: string[], mod: parser.Module, root: string): string[] {
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        var ip: string = mod.imports[i].path;
        if (should_load(ip, root) && !contains_name(paths, ip)) {
            paths = paths.push(ip);
        }
        i = i + 1;
    }
    return paths;
}

// is_flag is true for an argument that begins with '-'.
function is_flag(a: string): boolean {
    if (a.len() == 0) { return false; }
    return a[0] == 45;   // '-'
}

function usage(): i32 {
    eprint("usage: fern [-check | -interp | -fmt] [-target x86-64|arm64|arm64-darwin|wasm] [-o OUT] <entry.fern> [stdlib-root]\n");
    return 2;
}

// SsaResult carries the SSA backend's output and whether it applied.
struct SsaResult { asm: string, ok: boolean }

// try_ssa attempts to compile the whole program through the SSA pipeline
// (build_func → optimise → emit). It applies only when EVERY function is in
// the SSA subset (build_func ok) and a `main` exists; otherwise it returns
// ok=false so the caller falls back to the AST emitter. The SSA backends
// cover x86-64 and arm64; other targets always fall back. Register
// allocation is always on for this path.
function try_ssa(funcs: parser.FuncDecl[], target: string): SsaResult {
    if (target != "x86-64" && target != "arm64") { return SsaResult { asm: "", ok: false }; }
    // The set of user-defined function names the SSA backend can `call`.
    var known: string[] = [];
    var ni: i32 = 0;
    while (ni < funcs.len()) { known = known.push(funcs[ni].name); ni = ni + 1; }
    var sfuncs: ssa.SFunc[] = [];
    var has_main: boolean = false;
    var i: i32 = 0;
    while (i < funcs.len()) {
        var r: ssa.BResult = ssa.build_func(funcs[i]);
        if (!r.ok) { return SsaResult { asm: "", ok: false }; }
        // A call to a builtin (print, write, …) or any unknown name can't be
        // lowered — fall back to the AST emitter for the whole program.
        if (!ssa.calls_all_known(r.func, known)) { return SsaResult { asm: "", ok: false }; }
        if (funcs[i].name == "main") { has_main = true; }
        sfuncs = sfuncs.push(ssa.optimize(r.func));
        i = i + 1;
    }
    if (!has_main) { return SsaResult { asm: "", ok: false }; }
    var asm: string = "";
    if (target == "arm64") { asm = ssa_arm64.emit_program(sfuncs, true); }
    else { asm = ssa_x86.emit_program(sfuncs, true); }
    return SsaResult { asm: asm, ok: true };
}

function main(): i32 {
    var av: string[] = args();

    var entry_path: string = "";
    var out_path: string = "";
    var root: string = "";
    var target: string = "x86-64";
    var mode_check: boolean = false;
    var mode_interp: boolean = false;
    var mode_fmt: boolean = false;
    var use_ssa: boolean = false;
    var have_entry: boolean = false;

    var i: i32 = 1;
    while (i < av.len()) {
        var a: string = av[i];
        if (a == "-check") {
            mode_check = true;
        } else if (a == "-interp") {
            mode_interp = true;
        } else if (a == "-fmt") {
            mode_fmt = true;
        } else if (a == "-ssa") {
            use_ssa = true;
        } else if (a == "-target") {
            i = i + 1;
            if (i >= av.len()) { return usage(); }
            target = av[i];
        } else if (a == "-o") {
            i = i + 1;
            if (i >= av.len()) { return usage(); }
            out_path = av[i];
        } else if (is_flag(a)) {
            eprint("fern: unknown flag: ");
            eprint(a);
            eprint("\n");
            return 2;
        } else {
            if (!have_entry) {
                entry_path = a;
                have_entry = true;
            } else {
                root = a;
            }
        }
        i = i + 1;
    }

    if (!have_entry) { return usage(); }

    if (target != "x86-64" && target != "arm64" && target != "arm64-darwin" && target != "wasm") {
        eprint("fern: unknown -target: ");
        eprint(target);
        eprint(" (want x86-64, arm64, arm64-darwin, or wasm)\n");
        return 2;
    }

    // Load the entry + its transitive imports off disk and flatten them
    // into one module (the import-driven scheme from asm_load_run).
    var dir: string = dir_of(entry_path);
    var esrc: string = "";
    var eok: boolean = false;
    match (read_file(entry_path)) {
        Ok(s) => { esrc = s; eok = true; },
        Err(e) => { eok = false; },
    }
    if (!eok) {
        eprint("fern: cannot read entry file: ");
        eprint(entry_path);
        eprint("\n");
        return 1;
    }
    var entry_mod: parser.Module = parser.parse_module(lexer.tokenize(esrc));

    // -fmt is per-file: format the entry source and emit it, without
    // loading transitive imports (formatting one file never needs them).
    if (mode_fmt) {
        var formatted: string = printer.print_module(entry_mod);
        if (out_path.len() > 0) {
            match (write_file(out_path, formatted)) {
                Some(e) => {
                    eprint("fern: cannot write output: ");
                    eprint(out_path);
                    eprint("\n");
                    return 1;
                },
                None => {},
            }
        } else {
            write(formatted);
        }
        return 0;
    }

    var paths: string[] = add_imports([], entry_mod, root);
    var loaded: flatten.LoadedModule[] = [];
    var done: string[] = [];
    var j: i32 = 0;
    while (j < paths.len()) {
        var ipath: string = paths[j];
        j = j + 1;
        if (!contains_name(done, ipath)) {
            done = done.push(ipath);
            var mpath: string = resolve_path(ipath, dir, root);
            var msrc: string = "";
            var mok: boolean = false;
            match (read_file(mpath)) {
                Ok(s2) => { msrc = s2; mok = true; },
                Err(e) => { mok = false; },
            }
            if (!mok) {
                eprint("fern: cannot read module: ");
                eprint(mpath);
                eprint("\n");
                return 1;
            }
            var m: parser.Module = parser.parse_module(lexer.tokenize(msrc));
            loaded = loaded.push(flatten.LoadedModule { name: module_name(ipath), mod: m });
            paths = add_imports(paths, m, root);
        }
    }
    var merged: parser.Module = flatten.bundle(entry_mod, loaded);

    if (mode_check) {
        var mt: checker.ModuleTypes = checker.check_module(merged);
        if (mt.all_well_typed) { return 0; }
        return 1;
    }

    if (mode_interp) {
        // Evaluate via the tree-walking interpreter; the program's
        // result becomes the process exit code (VInt → its value,
        // VBool → 1/0), matching interp_run.fern. A non-i32/bool
        // result exits 254.
        // Lower `defer` the same way the emit path does (module_with_
        // builtins) so the interpreter and the backends agree.
        var result: interp.Value = interp.eval_module(parser.lower_defers_module(merged));
        match (result) {
            interp.VInt(iv) => { return iv.v; },
            interp.VBool(bv) => {
                if (bv.v) { return 1; }
                return 0;
            },
            _ => { return 254; },
        }
        return 254;
    }

    // Opt-in SSA backend: when -ssa is given, try the AST → SSA → optimise
    // → regalloc → emit pipeline for the whole program. It applies only if
    // every function is in the SSA subset (else we fall through to the AST
    // emitter below), so it never changes the output of programs it can't
    // yet handle.
    if (use_ssa) {
        var sr: SsaResult = try_ssa(merged.funcs, target);
        if (sr.ok) {
            if (out_path.len() > 0) {
                match (write_file(out_path, sr.asm)) {
                    Some(e) => {
                        eprint("fern: cannot write output: ");
                        eprint(out_path);
                        eprint("\n");
                        return 1;
                    },
                    None => {},
                }
            } else {
                write(sr.asm);
            }
            return 0;
        }
    }

    var full: parser.Module = parser.module_with_builtins(merged);
    var out_asm: string = "";
    if (target == "arm64") {
        out_asm = asm_arm64.emit_module(full, false);
    } else if (target == "arm64-darwin") {
        // Same arm64 code generator with the Darwin syscall builtins
        // (gettimeofday / getentropy) selected via the darwin flag;
        // darwinize() then reskins the GAS output into the Mach-O
        // dialect clang/ld64 link on Apple Silicon. See
        // asm_arm64.darwinize for the transform + supported surface.
        out_asm = asm_arm64.darwinize(asm_arm64.emit_module(full, true));
    } else if (target == "wasm") {
        // WASI core module in text format (WAT). Runnable directly by
        // `wasmtime run`; main()'s result becomes the process exit code.
        out_asm = wasm.emit_module(full);
    } else {
        out_asm = asm.emit_module(full);
    }
    if (out_path.len() > 0) {
        match (write_file(out_path, out_asm)) {
            Some(e) => {
                eprint("fern: cannot write output: ");
                eprint(out_path);
                eprint("\n");
                return 1;
            },
            None => {},
        }
    } else {
        write(out_asm);
    }
    return 0;
}
