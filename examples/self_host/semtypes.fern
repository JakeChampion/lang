// Exact semantic identity, distinct from frontend assignability or spelling.
import "./typeinfo";

pub function equal(a: typeinfo.Type, b: typeinfo.Type): boolean {
    if let typeinfo.TypeArray(x) = a { if let typeinfo.TypeArray(y) = b { return equal(x.elem, y.elem); } }
    if let typeinfo.TypeTuple(x) = a { if let typeinfo.TypeTuple(y) = b { return equal_list(x.elements, y.elements); } }
    if let typeinfo.TypeMap(x) = a { if let typeinfo.TypeMap(y) = b { return equal(x.key, y.key) && equal(x.value, y.value); } }
    return named_equal(a, b) || numeric_equal(a, b) || atomic_equal(a, b);
}

function numeric_equal(a: typeinfo.Type, b: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(x) = a {
        if let typeinfo.TypeI32(y) = b { return x.width == y.width && x.unsigned == y.unsigned && x.is_char == y.is_char; }
    }
    if let typeinfo.TypeFloat(x) = a {
        if let typeinfo.TypeFloat(y) = b { return x.width == y.width && x.polymorphic == y.polymorphic; }
    }
    return false;
}

function atomic_equal(a: typeinfo.Type, b: typeinfo.Type): boolean {
    if let typeinfo.TypeBool(_) = a { if let typeinfo.TypeBool(_) = b { return true; } }
    if let typeinfo.TypeString(x) = a { if let typeinfo.TypeString(y) = b { return x.tag == y.tag; } }
    if let typeinfo.TypeVoid(_) = a { if let typeinfo.TypeVoid(_) = b { return true; } }
    return false;
}

function named_args_equal(a: string, aa: typeinfo.Type[], b: string, ba: typeinfo.Type[]): boolean {
    return a == b && equal_list(aa, ba);
}

// A type VARIABLE of a template: what a generic declaration's contract spells
// where an instantiation will bind a concrete type. It stands in a template's
// contract and nowhere else — a produced body is an instance, whose every
// type is concrete (docs/SEMANTIC-GENERICS.md).
pub function erased(t: typeinfo.Type): boolean {
    if let typeinfo.TypeErased(_) = t { return true; }
    return false;
}

// A template's type: `concrete`, with a variable admitted wherever a type may
// stand, since the instance binds it before anything reads a width or a drop
// off it.
pub function shaped(t: typeinfo.Type, allow_void: boolean): boolean {
    return erased(t) || shaped_container(t) || shaped_named(t) || concrete(t, allow_void);
}

function shaped_container(t: typeinfo.Type): boolean {
    if let typeinfo.TypeArray(a) = t { return shaped(a.elem, false); }
    if let typeinfo.TypeTuple(tup) = t { return tup.elements.len() >= 2 && shaped_list(tup.elements); }
    if let typeinfo.TypeMap(m) = t { return shaped(m.key, false) && shaped(m.value, false); }
    return false;
}

function shaped_named(t: typeinfo.Type): boolean {
    if let typeinfo.TypeFunc(f) = t { return f.params_known && shaped_list(f.param_types) && shaped(f.ret_type, true); }
    if let typeinfo.TypeStruct(s) = t { return s.name.len() > 0 && shaped_list(s.args); }
    if let typeinfo.TypeUnion(u) = t { return u.name.len() > 0 && shaped_payloads(u.args); }
    return false;
}

function shaped_list(ts: typeinfo.Type[]): boolean {
    for t in ts { if (!shaped(t, false)) { return false; } }
    return true;
}

// A union's argument is a PAYLOAD, and `void` is one: `Result[void, IoError]`
// is the outcome of a write, whose Ok arm carries nothing.
function shaped_payloads(ts: typeinfo.Type[]): boolean {
    for t in ts { if (!shaped(t, true)) { return false; } }
    return true;
}

// The CONSUMING slots are part of a callable's identity: a function value that
// releases its argument and one that borrows it promise opposite things of the
// same call, so neither may stand in for the other.
function own_masks_equal(a: typeinfo.TypeFunc, b: typeinfo.TypeFunc): boolean {
    var i: i32 = 0;
    while (i < a.param_types.len()) {
        if (typeinfo.fn_own_at(a, i) != typeinfo.fn_own_at(b, i)) { return false; }
        i = i + 1;
    }
    return true;
}

function callable_equal(a: typeinfo.TypeFunc, b: typeinfo.TypeFunc): boolean {
    return a.params_known == b.params_known && equal_list(a.param_types, b.param_types)
        && own_masks_equal(a, b) && equal(a.ret_type, b.ret_type);
}

function named_equal(a: typeinfo.Type, b: typeinfo.Type): boolean {
    if let typeinfo.TypeErased(x) = a { if let typeinfo.TypeErased(y) = b { return x.name == y.name; } }
    if let typeinfo.TypeStruct(x) = a { if let typeinfo.TypeStruct(y) = b { return named_args_equal(x.name, x.args, y.name, y.args); } }
    if let typeinfo.TypeUnion(x) = a { if let typeinfo.TypeUnion(y) = b { return named_args_equal(x.name, x.args, y.name, y.args); } }
    if let typeinfo.TypeFunc(x) = a { if let typeinfo.TypeFunc(y) = b { return callable_equal(x, y); } }
    if let typeinfo.TypeDyn(x) = a { if let typeinfo.TypeDyn(y) = b { return x.traits == y.traits; } }
    return false;
}

function equal_list(a: typeinfo.Type[], b: typeinfo.Type[]): boolean {
    if (a.len() != b.len()) { return false; }
    var i: i32 = 0;
    while (i < a.len()) {
        if (!equal(a[i], b[i])) { return false; }
        i = i + 1;
    }
    return true;
}

// Each helper admits a closed representation family. Unknown types match none.
// Nominal identities remain opaque until a declaration schema is supplied.
pub function concrete(t: typeinfo.Type, allow_void: boolean): boolean {
    return concrete_numeric(t) || concrete_leaf(t, allow_void) || concrete_container(t) || concrete_named(t);
}

function concrete_integer(i: typeinfo.TypeI32): boolean {
    if (i.is_char) { return i.width == 32 && !i.unsigned; }
    return i.width == 32 || i.width == 64 || (i.width == 8 && i.unsigned) || (i.width == typeinfo.width_ptr() && i.unsigned);
}

function concrete_numeric(t: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(i) = t { return concrete_integer(i); }
    if let typeinfo.TypeFloat(f) = t { return !f.polymorphic && (f.width == 32 || f.width == 64); }
    return false;
}

function concrete_leaf(t: typeinfo.Type, allow_void: boolean): boolean {
    if let typeinfo.TypeBool(_) = t { return true; }
    if let typeinfo.TypeString(s) = t { return s.tag == 0 || s.tag == 1; }
    if let typeinfo.TypeDyn(d) = t { return d.traits.len() > 0; }
    if let typeinfo.TypeVoid(_) = t { return allow_void; }
    return false;
}

function concrete_container(t: typeinfo.Type): boolean {
    if let typeinfo.TypeArray(a) = t { return concrete(a.elem, false); }
    if let typeinfo.TypeTuple(tup) = t { return tup.elements.len() >= 2 && concrete_list(tup.elements); }
    if let typeinfo.TypeMap(m) = t { return concrete(m.key, false) && concrete(m.value, false); }
    return false;
}

// A closure body's ENVIRONMENT: the box the lambda lift builds, the body's
// address in slot 0 and the captures after it. It is typed as a record of
// its own — `__env$<body>` with the capture types as its arguments — because
// a record's fields occupy the slots an array's elements do: a shape word where
// the array keeps its length, then one word per field. So a capture is read
// as a field projection and a box's captures are walked by the record's own
// drop helper, while the box itself stays the word array every call through
// it expects.
pub function env_prefix(): string { return "__env$"; }

pub function is_env(t: typeinfo.Type): boolean {
    if let typeinfo.TypeStruct(s) = t { return prefixed(s.name, env_prefix()); }
    return false;
}

pub function env_captures(t: typeinfo.Type): typeinfo.Type[] {
    if let typeinfo.TypeStruct(s) = t { return s.args; }
    return [];
}

// The body whose address the box's slot 0 holds.
pub function env_body(t: typeinfo.Type): string {
    if let typeinfo.TypeStruct(s) = t { return slice_unchecked(s.name, env_prefix().len(), s.name.len()) + ""; }
    return "";
}

function prefixed(name: string, prefix: string): boolean {
    if (name.len() <= prefix.len()) { return false; }
    return slice_unchecked(name, 0, prefix.len()) == prefix;
}

// Cell[T] is the language's one mutable slot (docs/CELL-TYPE-PLAN.md): a
// reserved name over a one-element box rather than a declared record, so its
// element is read from the instantiation and an argless `Cell` names no layout.
pub function is_cell(t: typeinfo.Type): boolean {
    if let typeinfo.TypeStruct(s) = t { return s.name == "Cell"; }
    return false;
}

pub function cell_elem(t: typeinfo.Type): typeinfo.Type {
    if let typeinfo.TypeStruct(s) = t { if (s.args.len() == 1) { return s.args[0]; } }
    return typeinfo.unchecked();
}

// A stream HANDLE — the `Reader` / `Writer` the front end injects, never
// declared by a module — is REPRESENTED by its bare descriptor: an i32 the
// resource ops take directly, the same value `stdin()` answers. So the
// nominal is a record's only in the type system; it holds no box, anchors
// nothing, and carries no unit to release.
pub function is_handle(t: typeinfo.Type): boolean {
    if let typeinfo.TypeStruct(s) = t { return s.name == "Reader" || s.name == "Writer"; }
    return false;
}

// `MapIter[K, V]` — the map cursor. It wears a record's nominal like a handle
// does, but it holds an ADDRESS rather than a descriptor: a counted block over
// the map's own storage. Every read through it reads the map, so it must not
// outlive the map.
pub function is_map_iter(t: typeinfo.Type): boolean {
    if let typeinfo.TypeStruct(s) = t { return s.name == "MapIter" && s.args.len() == 2; }
    return false;
}

// A cursor inside a type, through every constructor that can carry one out of
// a frame: an array element, a tuple element, a cell's element, a map's key or
// value, and a union's argument. A result carries the cursor out of the frame
// whose map it reads, and a container result carries it just as far as the
// cursor itself does.
//
// Two shapes are deliberately not here. A cursor in a RECORD FIELD is refused
// by the schema walk, which has no layout to record for one. `dyn Trait`
// carries no type argument at all, so there is nothing to walk. Neither is a
// gap this predicate is papering over — both refuse before a body is produced.
// Whether a value of `t` holds a `str` view anywhere a caller could read it.
pub function holds_view(t: typeinfo.Type): boolean {
    if let typeinfo.TypeString(s) = t { return s.tag == 1; }
    if let typeinfo.TypeArray(a) = t { return holds_view(a.elem); }
    if let typeinfo.TypeTuple(tup) = t {
        for e in tup.elements { if (holds_view(e)) { return true; } }
        return false;
    }
    if (is_cell(t)) { return holds_view(cell_elem(t)); }
    if let typeinfo.TypeMap(m) = t { return holds_view(m.key) || holds_view(m.value); }
    if let typeinfo.TypeUnion(u) = t {
        for a in u.args { if (holds_view(a)) { return true; } }
        return false;
    }
    return false;
}

pub function holds_map_iter(t: typeinfo.Type): boolean {
    if (is_map_iter(t)) { return true; }
    if let typeinfo.TypeArray(a) = t { return holds_map_iter(a.elem); }
    if let typeinfo.TypeTuple(tup) = t {
        for e in tup.elements { if (holds_map_iter(e)) { return true; } }
        return false;
    }
    if (is_cell(t)) { return holds_map_iter(cell_elem(t)); }
    if let typeinfo.TypeMap(m) = t { return holds_map_iter(m.key) || holds_map_iter(m.value); }
    if let typeinfo.TypeUnion(u) = t {
        for a in u.args { if (holds_map_iter(a)) { return true; } }
        return false;
    }
    return false;
}

// The key and value a cursor answers, read off the nominal's arguments.
pub function map_iter_key(t: typeinfo.Type): typeinfo.Type {
    if let typeinfo.TypeStruct(s) = t { if (s.args.len() == 2) { return s.args[0]; } }
    return typeinfo.unchecked();
}
pub function map_iter_value(t: typeinfo.Type): typeinfo.Type {
    if let typeinfo.TypeStruct(s) = t { if (s.args.len() == 2) { return s.args[1]; } }
    return typeinfo.unchecked();
}

function concrete_struct(s: typeinfo.TypeStruct): boolean {
    if (s.name == "Cell") { return s.args.len() == 1 && concrete(s.args[0], false); }
    return s.name.len() > 0 && concrete_list(s.args);
}

function concrete_named(t: typeinfo.Type): boolean {
    if let typeinfo.TypeStruct(s) = t { return concrete_struct(s); }
    if let typeinfo.TypeUnion(u) = t { return concrete_union(u); }
    if let typeinfo.TypeFunc(f) = t { return f.params_known && concrete_list(f.param_types) && concrete(f.ret_type, true); }
    return false;
}

// The checker types a constructor call by its family alone — `Some(1)` is
// `Option`, not `Option[i32]` — so a builtin generic missing its payloads
// names a family, not a type.
function concrete_union(u: typeinfo.TypeUnion): boolean {
    if (u.name.len() == 0) { return false; }
    if (u.name == "Option" && u.args.len() != 1) { return false; }
    if (u.name == "Result" && u.args.len() != 2) { return false; }
    return concrete_payloads(u.args);
}

function concrete_list(ts: typeinfo.Type[]): boolean {
    for t in ts { if (!concrete(t, false)) { return false; } }
    return true;
}

function concrete_payloads(ts: typeinfo.Type[]): boolean {
    for t in ts { if (!concrete(t, true)) { return false; } }
    return true;
}

// This is a conservative lifetime classification, not an RC layout or a claim
// that a value carries a counted unit. Views and opaque nominal values retain
// their anchors too. Their eventual unit/layout contracts must be verified.
pub function needs_anchor(t: typeinfo.Type): boolean {
    // A template's variable anchors: its declared mode is a reference's until
    // an instance binds it to a scalar.
    if let typeinfo.TypeI32(_) = t { return false; }
    if let typeinfo.TypeBool(_) = t { return false; }
    if let typeinfo.TypeFloat(_) = t { return false; }
    if let typeinfo.TypeVoid(_) = t { return false; }
    if (is_handle(t)) { return false; }
    return true;
}
