// examples/self_host/parser.lang — recursive-descent parser
// layered on the lang-port lexer (`./lexer`). Together they form
// the second concrete step of the self-host port (after the
// standalone lexer in `lexer.lang`). Now that cross-module
// qualified variant patterns work (`lexer.TokIdent(x) => …`),
// the parser imports the lexer rather than inlining a copy.
//
// Scope:
//   - Expressions with precedence: + - * / % comparisons
//     equality && || (mirrors Go parser's precedence climbing)
//   - Numbers (with float / integer / suffix distinction
//     surfaced on the AST node)
//   - Identifier expressions + function calls `f(a, b)`
//   - Parenthesised grouping
//   - Statements: `var x = expr;`, `return expr;`, expression
//     stmts
//
// Out of scope (Go parser covers them; follow-up port):
//   - Types / type annotations
//   - Struct / enum / union decls
//   - `if` / `while` / `for` / `match` / `defer` / `arena`
//   - String / f-string handling (lexer recognises them; parser
//     stub treats them as opaque ExprUnknown)
//   - Receivers, type-params, `pub`, `import`

import "core/no_prelude";
import "./lexer";

// =================== PARSER ====================

// Expression nodes. Recursive via the union — `ExprBinary` holds
// two Expr children, `ExprCall` holds a list of args, etc. The Go
// parser produces a denser typed AST (NumberLit / FloatLit /
// Ident / Binary / Call); this port collapses similar shapes into
// fewer variants to keep the union member count tractable.

pub struct ExprNumber { text: string, suffix: string, is_float: boolean }
pub struct ExprIdent { name: string }
pub struct ExprString { value: string }
pub struct ExprBool { value: boolean }
pub struct ExprBinary { op: string, left: Expr, right: Expr }
pub struct ExprUnary { op: string, operand: Expr }
pub struct ExprCall { callee: Expr, args: Expr[] }
pub struct ExprUnknown { kind: string }

pub type Expr = ExprNumber | ExprIdent | ExprString | ExprBool
              | ExprBinary | ExprUnary | ExprCall | ExprUnknown;

// Statement nodes.

pub struct StmtVar { name: string, init: Expr }
pub struct StmtReturn { value: Expr }
pub struct StmtExpr { value: Expr }
// StmtIf models `if (cond) { then... } else { else... }`. else_body
// is empty (`[]`) when the source omits the `else` branch; the
// checker / interp branch on `len(else_body) == 0` rather than a
// separate `has_else` flag.
pub struct StmtIf { cond: Expr, then_body: Stmt[], else_body: Stmt[] }
// StmtWhile models `while (cond) { body... }`. The body executes
// repeatedly as long as cond evaluates to a true VBool; an
// in-body `return` short-circuits the loop the same way it
// short-circuits an if-branch.
pub struct StmtWhile { cond: Expr, body: Stmt[] }
// StmtAssign models a re-assignment to an existing var: `x = expr;`.
// The target is an ident name — full lvalue syntax (field /
// index / tuple) is a later port milestone. The checker verifies
// the target is already bound and that types match; the interp
// updates the env's slot in place.
pub struct StmtAssign { target: string, value: Expr }
pub struct StmtUnknown { kind: string }

pub type Stmt = StmtVar | StmtReturn | StmtExpr | StmtIf | StmtWhile | StmtAssign | StmtUnknown;

// Helper wraps to satisfy the implicit-union-wrap return-position
// rule. Same pattern lexer.lang uses for Token construction.

function e_number(text: string, suffix: string, is_float: boolean): Expr {
    return ExprNumber { text: text, suffix: suffix, is_float: is_float };
}
function e_ident(name: string): Expr { return ExprIdent { name: name }; }
function e_string(value: string): Expr { return ExprString { value: value }; }
function e_bool(value: boolean): Expr { return ExprBool { value: value }; }
function e_binary(op: string, left: Expr, right: Expr): Expr {
    return ExprBinary { op: op, left: left, right: right };
}
function e_unary(op: string, operand: Expr): Expr { return ExprUnary { op: op, operand: operand }; }
function e_call(callee: Expr, args: Expr[]): Expr { return ExprCall { callee: callee, args: args }; }
function e_unknown(kind: string): Expr { return ExprUnknown { kind: kind }; }

function s_var(name: string, init: Expr): Stmt { return StmtVar { name: name, init: init }; }
function s_return(value: Expr): Stmt { return StmtReturn { value: value }; }
function s_expr(value: Expr): Stmt { return StmtExpr { value: value }; }
function s_if(cond: Expr, then_body: Stmt[], else_body: Stmt[]): Stmt {
    return StmtIf { cond: cond, then_body: then_body, else_body: else_body };
}
function s_while(cond: Expr, body: Stmt[]): Stmt {
    return StmtWhile { cond: cond, body: body };
}
function s_assign(target: string, value: Expr): Stmt {
    return StmtAssign { target: target, value: value };
}
function s_unknown(kind: string): Stmt { return StmtUnknown { kind: kind }; }

// Parser state. `toks` is the lexer's output; `pos` is the
// current cursor into it. We mutate via value-semantics (return
// fresh Par from each consume()).

struct Par { toks: lexer.Token[], pos: i32 }

function (p: Par) at_end(): boolean {
    if (p.pos >= len(p.toks)) { return true; }
    var t: lexer.Token = p.toks[p.pos];
    match (t) {
        lexer.TokEof(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

function (p: Par) peek(): lexer.Token {
    if (p.pos < len(p.toks)) { return p.toks[p.pos]; }
    return lexer.eof_tok(0, 0);
}

function (p: Par) advance(): Par {
    return Par { toks: p.toks, pos: p.pos + 1 };
}

// Token-shape queries: each returns "" when the token isn't of
// the expected kind, otherwise the text/name. Callers branch on
// the empty-string result rather than re-matching.
function (p: Par) peek_punct(): string {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokPunct(x) => { return x.text; },
        _ => { return ""; }
    }
    return "";
}
function (p: Par) peek_keyword(): string {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokKeyword(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}
function (p: Par) peek_ident(): string {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokIdent(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}

// Result types — both pieces of the (new_parser, parsed_thing)
// pair we need to thread through recursive-descent. Avoids a
// stateful `var p: Par` shared across helpers.
struct ExprResult { par: Par, expr: Expr }
struct StmtResult { par: Par, stmt: Stmt }

// parse_primary: number, ident (which may extend to call), string,
// bool, parenthesised expr, unknown otherwise.
function parse_primary(p: Par): ExprResult {
    var t: lexer.Token = p.peek();
    match (t) {
        lexer.TokNumber(x) => {
            p = p.advance();
            return ExprResult { par: p, expr: e_number(x.text, x.suffix, x.is_float) };
        },
        lexer.TokString(x) => {
            p = p.advance();
            return ExprResult { par: p, expr: e_string(x.value) };
        },
        lexer.TokKeyword(x) => {
            if (x.name == "true") {
                p = p.advance();
                return ExprResult { par: p, expr: e_bool(true) };
            }
            if (x.name == "false") {
                p = p.advance();
                return ExprResult { par: p, expr: e_bool(false) };
            }
            return ExprResult { par: p, expr: e_unknown("keyword:" + x.name) };
        },
        lexer.TokIdent(x) => {
            p = p.advance();
            var base: Expr = e_ident(x.name);
            // Postfix `(`: function call.
            if (p.peek_punct() == "(") {
                p = p.advance();
                var args: Expr[] = [];
                if (p.peek_punct() != ")") {
                    while (true) {
                        var ra = parse_expr(p);
                        p = ra.par;
                        args = args.push(ra.expr);
                        if (p.peek_punct() == ",") { p = p.advance(); continue; }
                        break;
                    }
                }
                if (p.peek_punct() != ")") {
                    return ExprResult { par: p, expr: e_unknown("missing ) in call") };
                }
                p = p.advance();
                return ExprResult { par: p, expr: e_call(base, args) };
            }
            return ExprResult { par: p, expr: base };
        },
        lexer.TokPunct(x) => {
            if (x.text == "(") {
                p = p.advance();
                var inner = parse_expr(p);
                p = inner.par;
                if (p.peek_punct() == ")") { p = p.advance(); }
                return ExprResult { par: p, expr: inner.expr };
            }
            if (x.text == "-" || x.text == "!") {
                p = p.advance();
                var operand = parse_primary(p);
                return ExprResult { par: operand.par, expr: e_unary(x.text, operand.expr) };
            }
            return ExprResult { par: p, expr: e_unknown("punct:" + x.text) };
        },
        lexer.TokEof(_) => { return ExprResult { par: p, expr: e_unknown("eof") }; }
    }
    return ExprResult { par: p, expr: e_unknown("primary") };
}

// precedence: higher binds tighter. Returns -1 for non-binop
// punctuators. Mirrors the Go parser's Pratt-style table.
function precedence(op: string): i32 {
    if (op == "||") { return 1; }
    if (op == "&&") { return 2; }
    if (op == "==" || op == "!=") { return 3; }
    if (op == "<" || op == ">" || op == "<=" || op == ">=") { return 4; }
    if (op == "+" || op == "-") { return 5; }
    if (op == "*" || op == "/" || op == "%") { return 6; }
    return 0 - 1;
}

// parse_binary uses precedence climbing. `min_prec` is the
// minimum precedence the caller will accept — recursively
// climbs while the next operator's prec is >= min_prec.
function parse_binary(p: Par, min_prec: i32): ExprResult {
    var lhs = parse_primary(p);
    p = lhs.par;
    while (true) {
        var op: string = p.peek_punct();
        var prec: i32 = precedence(op);
        if (prec < min_prec) { return ExprResult { par: p, expr: lhs.expr }; }
        p = p.advance();
        var rhs = parse_binary(p, prec + 1);
        p = rhs.par;
        var combined: Expr = e_binary(op, lhs.expr, rhs.expr);
        lhs = ExprResult { par: p, expr: combined };
    }
    return lhs;
}

function parse_expr(p: Par): ExprResult {
    return parse_binary(p, 1);
}

// parse_stmt: `var x = expr;`, `return expr;`, or `expr;`.
// parse_block consumes `{ stmt; stmt; … }` and returns the
// resulting Stmt[]. The opening `{` is expected to be the current
// token. On malformed input — missing `{` or `}` — the result is
// a single StmtUnknown so the outer caller can still surface a
// reasonable error site.
pub struct BlockResult { par: Par, body: Stmt[] }

function parse_block(p: Par): BlockResult {
    var body: Stmt[] = [];
    if (p.peek_punct() != "{") {
        body = body.push(s_unknown("missing { in block"));
        return BlockResult { par: p, body: body };
    }
    p = p.advance();
    while (p.peek_punct() != "}" && !p.at_end()) {
        var r: StmtResult = parse_stmt(p);
        p = r.par;
        body = body.push(r.stmt);
    }
    if (p.peek_punct() == "}") { p = p.advance(); }
    return BlockResult { par: p, body: body };
}

function parse_stmt(p: Par): StmtResult {
    var kw: string = p.peek_keyword();
    if (kw == "if") {
        p = p.advance();
        if (p.peek_punct() != "(") {
            return StmtResult { par: p, stmt: s_unknown("missing ( in if") };
        }
        p = p.advance();
        var c = parse_expr(p);
        p = c.par;
        if (p.peek_punct() == ")") { p = p.advance(); }
        var then_blk: BlockResult = parse_block(p);
        p = then_blk.par;
        var else_body: Stmt[] = [];
        if (p.peek_keyword() == "else") {
            p = p.advance();
            // `else if` — wrap as a nested StmtIf in the else
            // branch so an else-chain reads as one shape.
            if (p.peek_keyword() == "if") {
                var nested: StmtResult = parse_stmt(p);
                p = nested.par;
                else_body = else_body.push(nested.stmt);
            } else {
                var else_blk: BlockResult = parse_block(p);
                p = else_blk.par;
                else_body = else_blk.body;
            }
        }
        return StmtResult { par: p, stmt: s_if(c.expr, then_blk.body, else_body) };
    }
    if (kw == "while") {
        p = p.advance();
        if (p.peek_punct() != "(") {
            return StmtResult { par: p, stmt: s_unknown("missing ( in while") };
        }
        p = p.advance();
        var wc = parse_expr(p);
        p = wc.par;
        if (p.peek_punct() == ")") { p = p.advance(); }
        var wb: BlockResult = parse_block(p);
        p = wb.par;
        return StmtResult { par: p, stmt: s_while(wc.expr, wb.body) };
    }
    if (kw == "var") {
        p = p.advance();
        var name: string = p.peek_ident();
        if (len(name) == 0) {
            return StmtResult { par: p, stmt: s_unknown("missing var name") };
        }
        p = p.advance();
        // Optional `: Type` — skip past until `=` for this port.
        if (p.peek_punct() == ":") {
            p = p.advance();
            // Consume one token (the type name); a richer port
            // would parse full type syntax here.
            p = p.advance();
        }
        if (p.peek_punct() != "=") {
            return StmtResult { par: p, stmt: s_unknown("missing = in var") };
        }
        p = p.advance();
        var init = parse_expr(p);
        p = init.par;
        if (p.peek_punct() == ";") { p = p.advance(); }
        return StmtResult { par: p, stmt: s_var(name, init.expr) };
    }
    if (kw == "return") {
        p = p.advance();
        var val = parse_expr(p);
        p = val.par;
        if (p.peek_punct() == ";") { p = p.advance(); }
        return StmtResult { par: p, stmt: s_return(val.expr) };
    }
    // Expression statement — or assignment if `=` follows. The
    // parser doesn't accept `=` as a binary operator (it's not in
    // the precedence table), so parse_expr stops at the ident; we
    // peek for `=` here and switch to StmtAssign when seen. Only
    // bare-ident targets are supported in this cut — full lvalue
    // syntax (field / index / tuple) is a later milestone.
    var e = parse_expr(p);
    p = e.par;
    if (p.peek_punct() == "=") {
        // Pull the target name out of the parsed Expr. Anything
        // other than a bare ident is an unsupported lvalue shape;
        // surface as StmtUnknown so the surrounding test can spot
        // the failure site.
        var target: string = "";
        match (e.expr) {
            ExprIdent(id) => { target = id.name; },
            _ => { return StmtResult { par: p, stmt: s_unknown("lhs of `=` must be ident") }; }
        }
        p = p.advance(); // consume `=`
        var av = parse_expr(p);
        p = av.par;
        if (p.peek_punct() == ";") { p = p.advance(); }
        return StmtResult { par: p, stmt: s_assign(target, av.expr) };
    }
    if (p.peek_punct() == ";") { p = p.advance(); }
    return StmtResult { par: p, stmt: s_expr(e.expr) };
}

pub function parse_program(toks: lexer.Token[]): Stmt[] {
    var p: Par = Par { toks: toks, pos: 0 };
    var out: Stmt[] = [];
    while (!p.at_end()) {
        var r = parse_stmt(p);
        p = r.par;
        out = out.push(r.stmt);
    }
    return out;
}

// =================== VALIDATION ====================

function main(): i32 {
    // Source under test:
    //   var x = 1 + 2 * 3;        // x = 7
    //   var y = (1 + 2) * 3;      // y = 9
    //   return x + y;             // returns 16
    var src: string = "var x = 1 + 2 * 3; var y = (1 + 2) * 3; return x + y;";
    var toks: lexer.Token[] = lexer.tokenize(src);
    var prog: Stmt[] = parse_program(toks);
    if (len(prog) != 3) { return 1; }

    // Stmt 0: var x = 1 + 2 * 3   →   StmtVar { name: "x", init: ExprBinary "+" }
    match (prog[0]) {
        StmtVar(s0) => {
            if (s0.name != "x") { return 100; }
            match (s0.init) {
                ExprBinary(b) => {
                    if (b.op != "+") { return 101; }
                    // Right side should be `2 * 3` (binary with op "*").
                    match (b.right) {
                        ExprBinary(rb) => {
                            if (rb.op != "*") { return 102; }
                        },
                        _ => { return 103; }
                    }
                    // Left side should be number 1.
                    match (b.left) {
                        ExprNumber(n) => { if (n.text != "1") { return 104; } },
                        _ => { return 105; }
                    }
                },
                _ => { return 106; }
            }
        },
        _ => { return 107; }
    }

    // Stmt 1: var y = (1 + 2) * 3   →  StmtVar { name: "y", init: ExprBinary "*" }
    match (prog[1]) {
        StmtVar(s1) => {
            if (s1.name != "y") { return 200; }
            match (s1.init) {
                ExprBinary(b) => {
                    if (b.op != "*") { return 201; }
                    // Left side is the grouped `1 + 2` — should
                    // be a `+` binary thanks to the parens.
                    match (b.left) {
                        ExprBinary(lb) => {
                            if (lb.op != "+") { return 202; }
                        },
                        _ => { return 203; }
                    }
                },
                _ => { return 204; }
            }
        },
        _ => { return 205; }
    }

    // Stmt 2: return x + y   →  StmtReturn { value: ExprBinary "+" }
    match (prog[2]) {
        StmtReturn(s2) => {
            match (s2.value) {
                ExprBinary(b) => {
                    if (b.op != "+") { return 300; }
                    match (b.left) {
                        ExprIdent(id) => { if (id.name != "x") { return 301; } },
                        _ => { return 302; }
                    }
                    match (b.right) {
                        ExprIdent(id) => { if (id.name != "y") { return 303; } },
                        _ => { return 304; }
                    }
                },
                _ => { return 305; }
            }
        },
        _ => { return 306; }
    }

    // If-statement parse: `if (x < 0) { var a = 1; } else { var b = 2; }`
    // should produce a single StmtIf with one stmt in each branch.
    var src2: string = "if (x < 0) { var a = 1; } else { var b = 2; }";
    var prog2: Stmt[] = parse_program(lexer.tokenize(src2));
    if (len(prog2) != 1) { return 400; }
    match (prog2[0]) {
        StmtIf(ifs) => {
            // cond: ExprBinary `<`.
            match (ifs.cond) {
                ExprBinary(b) => { if (b.op != "<") { return 401; } },
                _ => { return 402; }
            }
            if (len(ifs.then_body) != 1) { return 403; }
            if (len(ifs.else_body) != 1) { return 404; }
        },
        _ => { return 405; }
    }

    // Else-less if: ensure else_body is empty.
    var src3: string = "if (true) { return 1; }";
    var prog3: Stmt[] = parse_program(lexer.tokenize(src3));
    match (prog3[0]) {
        StmtIf(ifs) => {
            if (len(ifs.else_body) != 0) { return 500; }
        },
        _ => { return 501; }
    }

    // While loop: `while (i < 5) { i = i + 1; }` → one StmtWhile
    // with cond ExprBinary `<` and a single-stmt body (StmtAssign).
    var src4: string = "while (i < 5) { i = i + 1; }";
    var prog4: Stmt[] = parse_program(lexer.tokenize(src4));
    if (len(prog4) != 1) { return 600; }
    match (prog4[0]) {
        StmtWhile(w) => {
            match (w.cond) {
                ExprBinary(b) => { if (b.op != "<") { return 601; } },
                _ => { return 602; }
            }
            if (len(w.body) != 1) { return 603; }
            match (w.body[0]) {
                StmtAssign(a) => {
                    if (a.target != "i") { return 604; }
                    match (a.value) {
                        ExprBinary(b) => { if (b.op != "+") { return 605; } },
                        _ => { return 606; }
                    }
                },
                _ => { return 607; }
            }
        },
        _ => { return 608; }
    }

    return 0;
}
