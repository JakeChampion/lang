// examples/self_host/wat_encode.fern — byte-emission primitives for the
// self-hosted *binary* wasm backend. Slice 4a: the low-level building
// blocks the module-walker (a later slice) uses to turn a parsed WAT
// SExpr tree into a wasm binary module. Pipeline:
//   tokenize (wat_lex) -> parse (wat_parse) -> ENCODE (wat_encode) -> .wasm
//
// A byte buffer is an `i32[]` of 0..255 values, matching leb128.fern's
// `buf = f(buf, …)` idiom. These helpers wrap the wasm binary format's
// recurring shapes:
//   * a *vec(T)* is `LEB_u32(count)` followed by the elements' bytes;
//   * a *name* is a vec of its UTF-8 bytes (`LEB_u32(len)` + bytes);
//   * a *section* is `id` + `LEB_u32(byte_len)` + contents.
//
// Depends on leb128.fern's leb_u32 / leb_i32 but is otherwise import-free,
// so the encoder can `import` both and the unit test can concatenate
// leb128.fern + this file + a driver (wasm_run doesn't resolve imports).

// wcat appends every byte of `src` to `buf`.
function wcat(buf: i32[], src: i32[]): i32[] {
    var i: i32 = 0;
    while (i < src.len()) {
        buf = buf.push(src[i]);
        i = i + 1;
    }
    return buf;
}

// wstr_bytes appends the raw bytes of `s` (each char is one byte in the
// self-host string representation).
function wstr_bytes(buf: i32[], s: string): i32[] {
    var i: i32 = 0;
    while (i < s.len()) {
        buf = buf.push(s[i]);
        i = i + 1;
    }
    return buf;
}

// wname appends a wasm `name`: LEB_u32(len) then the UTF-8 bytes.
function wname(buf: i32[], s: string): i32[] {
    buf = leb_u32(buf, s.len());
    return wstr_bytes(buf, s);
}

// wsection wraps `contents` as a top-level section: the id byte, the
// LEB_u32 byte length, then the contents.
function wsection(id: i32, contents: i32[]): i32[] {
    var o: i32[] = [];
    o = o.push(id);
    o = leb_u32(o, contents.len());
    return wcat(o, contents);
}

// wvec builds a `vec`: LEB_u32(count) then the already-encoded element
// bytes.
function wvec(count: i32, elems: i32[]): i32[] {
    var o: i32[] = [];
    o = leb_u32(o, count);
    return wcat(o, elems);
}

// valtype_byte maps a WAT value-type spelling to its wasm binary code.
function valtype_byte(t: string): i32 {
    if (t == "i32") { return 127; }   // 0x7f
    if (t == "i64") { return 126; }   // 0x7e
    if (t == "f32") { return 125; }   // 0x7d
    if (t == "f64") { return 124; }   // 0x7c
    if (t == "funcref") { return 112; } // 0x70
    return 127;
}

// wmagic emits the 8-byte module preamble: "\0asm" + version 1.
function wmagic(): i32[] {
    var o: i32[] = [];
    o = o.push(0);
    o = o.push(97);
    o = o.push(115);
    o = o.push(109);
    o = o.push(1);
    o = o.push(0);
    o = o.push(0);
    o = o.push(0);
    return o;
}
