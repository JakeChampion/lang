// Producer-consumer fusion of std/array pipelines (#11072): a chain of `map`
// and `filter` stages ending in `fold` or `reduce` becomes one loop, and the
// intermediate arrays are never built. The self-host half of
// internal/ir/array_fusion.go, run on the typed semantic graphs every backend
// lowers from, before ownership is planned, so the loop carries no counts of
// its own.
//
// docs/ARRAY-FUSION-OPERATORS.md is the contract: each stage contributes a
// step (pass through, rebind, or skip), the fused body is the steps
// concatenated, and `fold` and `reduce` differ only in how the accumulator is
// seeded and finished. docs/ARRAY-ALGEBRA.md §1 is the purity boundary: every
// element function is a closure built here whose body reaches no effect, since
// fusing interleaves the stages' calls.
//
// A chain is refused, and left exactly as it was, unless:
//   - each intermediate has one use, the next stage, so nothing else reads
//     the array the loop never builds;
//   - the stages and the sink sit in one block with nothing but inert values
//     between them, so no effect moves relative to the stages' calls;
//   - every element and the accumulator is a scalar.
import "./ssa";
import "./ssasem";
import "./semtypes";
import "./typeinfo";
import "./util";

// What the pass made of each function, and whether it rewrote the graph.
pub struct Fused { funcs: ssasem.Func[], rewritten: boolean[] }

// `index` finds a body by the name a call carries; `verbs[i]` is the std/array
// combinator body i is, or ""; `bad[i]` says body i can reach an effect. A
// body that was not produced is no combinator and counts as effectful. `any`
// says the module holds a combinator at all.
struct Context { index: util.NameIndex, verbs: string[], bad: boolean[], any: boolean }

// One recognised chain. `stages` are instruction positions in `block`, head
// first, with `verbs` and the element function values `fns` beside them.
struct Chain { ok: boolean, block: i32, sink: i32, verb: string, stages: i32[], verbs: string[], fns: i32[], base: i32 }

struct Def { block: i32, pos: i32 }

// `usable[i]` says body i was produced and may be read and rewritten.
pub function fuse_pipelines(funcs: ssasem.Func[], names: string[], usable: boolean[]): Fused {
  var cx: Context = context(funcs, names, usable);
  var out: ssasem.Func[] = [];
  var rewritten: boolean[] = [];
  var i: i32 = 0;
  while (i < funcs.len()) {
    var f: ssasem.Func = funcs[i];
    var changed: boolean = false;
    if (cx.any && usable[i] && cx.verbs[i] == "") {
      var c: Chain = find_chain(f, cx);
      while (c.ok) {
        f = fuse(f, c);
        changed = true;
        c = find_chain(f, cx);
      }
    }
    out = out.append(f);
    rewritten = rewritten.append(changed);
    i = i + 1;
  }
  return Fused { funcs: out, rewritten: rewritten };
}

function context(funcs: ssasem.Func[], names: string[], usable: boolean[]): Context {
  var index: util.NameIndex = util.name_index(names);
  var verbs: string[] = [];
  var any: boolean = false;
  var i: i32 = 0;
  while (i < funcs.len()) {
    verbs = verbs.append(combinator(funcs[i], names[i], usable[i]));
    any = any || verbs[i] != "";
    i = i + 1;
  }
  // A module with no combinator body has no chain, and is spared the effect
  // analysis.
  if (!any) {
    return Context { index: index, verbs: verbs, bad: [], any: false };
  }
  return Context { index: index, verbs: verbs, bad: effectful(funcs, usable, index), any: true };
}

// ---- recognition ----------------------------------------------------------

// The verb a name has the shape of: std/array's free function `array__<verb>`
// or the array-method wrapper `__arrm_<verb>`, each followed by the
// instance's `__` or `$` suffixes.
function verb_of(name: string): string {
  if (!util.str_has_prefix(name, "__arrm_") && !util.str_has_prefix(name, "array__")) {
    return "";
  }
  var v: string = slice_unchecked(name, 7, suffix_at(name, 7)) + "";
  if (v == "map" || v == "filter" || v == "fold" || v == "reduce") {
    return v;
  }
  return "";
}

// Where the instance suffixes start: the first `$` or `__` at or after `from`.
function suffix_at(name: string, from: i32): i32 {
  var end: i32 = from;
  while (end < name.len() && name[end] != b'$' && !(name[end] == b'_' && end + 1 < name.len() && name[end + 1] == b'_')) {
    end = end + 1;
  }
  return end;
}

// Which combinator body `name` is. The free function is std/array's by its
// module prefix. The method spelling is the mangling of ANY array-receiver
// method, a user's included, so it counts only when its body delegates to the
// free function of the same verb, as std/array's one-line wrappers do.
function combinator(f: ssasem.Func, name: string, usable: boolean): string {
  var v: string = verb_of(name);
  if (!usable || v == "") {
    return "";
  }
  if (util.str_has_prefix(name, "array__")) {
    return v;
  }
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call() && util.str_has_prefix(ins.str, "array__") && verb_of(ins.str) == v) {
        return v;
      }
    }
  }
  return "";
}

function verb_at(cx: Context, callee: string): string {
  var at: i32 = cx.index.find(callee);
  if (at < 0) {
    return "";
  }
  return cx.verbs[at];
}

// ---- the purity boundary --------------------------------------------------

// The kinds that compute a value and nothing else. Everything outside the
// list counts as an effect: a call through a function value (its target is
// not known here), a cell write, a map iterator's cursor, and any kind added
// later until it is placed here on purpose. A direct call is pure when its
// callee is, which `effectful` settles over the whole module.
//
// The semantic kinds are numbered downward without gaps, so the pure ones are
// two runs: `array_new` through `arr_slice` less the call through a value and
// the cell write, and `dyn_up` through `dyn_as`. The map iterator kinds sit
// between the runs; the holes and anything newer sit past the second.
function pure_kind(k: i32): boolean {
  if (k >= 1) {
    return k <= 10;
  }
  if (k == ssasem.call_value() || k == ssasem.cell_set()) {
    return false;
  }
  return k >= ssasem.arr_slice() || k <= ssasem.dyn_up() && k >= ssasem.dyn_as();
}

function direct_effect(f: ssasem.Func): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (!pure_kind(ins.kind_tag)) {
        return true;
      }
    }
  }
  return false;
}

// A body is effectful when it holds an effect or calls anything that is not a
// pure body of this module: a builtin, an unproduced body, or an effectful
// one. Recursion between pure bodies stays pure: the walk only ever marks.
function effectful(funcs: ssasem.Func[], usable: boolean[], index: util.NameIndex): boolean[] {
  var bad: boolean[] = [];
  var i: i32 = 0;
  while (i < funcs.len()) {
    bad = bad.append(!usable[i] || direct_effect(funcs[i]));
    i = i + 1;
  }
  var changed: boolean = true;
  while (changed) {
    changed = false;
    i = 0;
    while (i < funcs.len()) {
      if (!bad[i] && calls_bad(funcs[i], bad, index)) {
        bad = bad.with(i, true);
        changed = true;
      }
      i = i + 1;
    }
  }
  return bad;
}

function calls_bad(f: ssasem.Func, bad: boolean[], index: util.NameIndex): boolean {
  for b in f.graph.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call()) {
        var at: i32 = index.find(ins.str);
        if (at < 0 || bad[at]) {
          return true;
        }
      }
    }
  }
  return false;
}

// ---- finding a chain ------------------------------------------------------

function no_chain(): Chain {
  return Chain { ok: false, block: 0, sink: 0, verb: "", stages: [], verbs: [], fns: [], base: 0 };
}

function find_chain(f: ssasem.Func, cx: Context): Chain {
  var uses: i32[] = use_counts(f.graph);
  var defs: Def[] = defs_of(f.graph);
  var bi: i32 = 0;
  while (bi < f.graph.blocks.len()) {
    var k: i32 = 0;
    while (k < f.graph.blocks[bi].insts.len()) {
      var c: Chain = chain_at(f, cx, uses, defs, bi, k);
      if (c.ok) {
        return c;
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  return no_chain();
}

// The chain whose sink is the instruction at (bi, k), walked back from the
// sink through every intermediate that only its next stage reads.
function chain_at(f: ssasem.Func, cx: Context, uses: i32[], defs: Def[], bi: i32, k: i32): Chain {
  var sink: ssa.SInst = f.graph.blocks[bi].insts[k];
  var verb: string = sink_verb(sink, cx);
  if (verb == "") {
    return no_chain();
  }
  var c: Chain = Chain { ...no_chain(), block: bi, sink: k, verb: verb, base: sink.args[0] };
  var d: Def = defs[c.base];
  while (d.block == bi && uses[c.base] == 1 && stage_verb(f.graph.blocks[bi].insts[d.pos], cx) != "") {
    var p: ssa.SInst = f.graph.blocks[bi].insts[d.pos];
    c = Chain { ...c, stages: prepend(d.pos, c.stages), verbs: prepend_str(stage_verb(p, cx), c.verbs), fns: prepend(p.args[1], c.fns), base: p.args[0] };
    d = defs[c.base];
  }
  return Chain { ...c, ok: admissible(f, cx, defs, c) };
}

function sink_verb(ins: ssa.SInst, cx: Context): string {
  if (ins.kind_tag != ssasem.call()) {
    return "";
  }
  var v: string = verb_at(cx, ins.str);
  if (v == "fold" && ins.args.len() == 3 || v == "reduce" && ins.args.len() == 2) {
    return v;
  }
  return "";
}

function admissible(f: ssasem.Func, cx: Context, defs: Def[], c: Chain): boolean {
  return c.stages.len() > 0 && inert_between(f.graph.blocks[c.block], c) && resolved_pure(f, cx, defs, c) && scalar_chain(f, c);
}

function stage_verb(ins: ssa.SInst, cx: Context): string {
  if (ins.kind_tag != ssasem.call() || ins.args.len() != 2) {
    return "";
  }
  var v: string = verb_at(cx, ins.str);
  if (v == "map" || v == "filter") {
    return v;
  }
  return "";
}

// Between the first stage and the sink, only values that read nothing but
// their operands: the closures and the seed the stages are handed. A call
// there would run before stages it used to follow.
function inert_between(b: ssa.SBlock, c: Chain): boolean {
  var p: i32 = c.stages[0] + 1;
  while (p < c.sink) {
    var k: i32 = b.insts[p].kind_tag;
    if (index_of(c.stages, p) < 0 && (k == ssasem.call() || !pure_kind(k))) {
      return false;
    }
    p = p + 1;
  }
  return true;
}

// Every element function, and the sink's, is a closure built in this body
// whose own body reaches no effect.
function resolved_pure(f: ssasem.Func, cx: Context, defs: Def[], c: Chain): boolean {
  var sink: ssa.SInst = f.graph.blocks[c.block].insts[c.sink];
  for v in c.fns.append(sink.args[sink.args.len() - 1]) {
    var d: Def = defs[v];
    if (d.block < 0) {
      return false;
    }
    var ins: ssa.SInst = f.graph.blocks[d.block].insts[d.pos];
    var at: i32 = cx.index.find(ins.str);
    if (ins.kind_tag != ssasem.closure_new() || at < 0 || cx.bad[at]) {
      return false;
    }
  }
  return true;
}

function scalar(t: typeinfo.Type): boolean {
  return ssasem.is_integer(t) || ssasem.is_float(t) || ssasem.is_bool(t) || ssasem.is_char(t);
}

function element(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeArray(a) = t {
    return a.elem;
  }
  return typeinfo.unchecked();
}

// The array the chain starts from, every intermediate, and the accumulator
// are all scalars, so no value in the loop carries a count.
function scalar_chain(f: ssasem.Func, c: Chain): boolean {
  var b: ssa.SBlock = f.graph.blocks[c.block];
  var sink: ssa.SInst = b.insts[c.sink];
  if (!scalar(element(f.values[c.base]))) {
    return false;
  }
  for p in c.stages {
    if (!scalar(element(f.values[b.insts[p].result]))) {
      return false;
    }
  }
  if (c.verb == "fold") {
    return scalar(f.values[sink.result]) && semtypes.equal(f.values[sink.args[1]], f.values[sink.result]);
  }
  return true;
}

// ---- graph helpers --------------------------------------------------------

function use_counts(g: ssa.SFunc): i32[] {
  var out: i32[] = [];
  var v: i32 = 0;
  while (v < g.nvals) {
    out = out.append(0);
    v = v + 1;
  }
  for b in g.blocks {
    for ins in b.insts {
      for a in ins.args {
        out = out.with(a, out[a] + 1);
      }
    }
    if (b.term.kind_tag == 1 && b.term.value >= 0) {
      out = out.with(b.term.value, out[b.term.value] + 1);
    }
    if (b.term.kind_tag == 3) {
      out = out.with(b.term.cond, out[b.term.cond] + 1);
    }
  }
  return out;
}

function defs_of(g: ssa.SFunc): Def[] {
  var out: Def[] = [];
  var v: i32 = 0;
  while (v < g.nvals) {
    out = out.append(Def { block: 0 - 1, pos: 0 - 1 });
    v = v + 1;
  }
  var bi: i32 = 0;
  while (bi < g.blocks.len()) {
    var k: i32 = 0;
    while (k < g.blocks[bi].insts.len()) {
      var r: i32 = g.blocks[bi].insts[k].result;
      if (r >= 0 && r < out.len()) {
        out = out.with(r, Def { block: bi, pos: k });
      }
      k = k + 1;
    }
    bi = bi + 1;
  }
  return out;
}

function index_of(xs: i32[], x: i32): i32 {
  var i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == x) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function prepend(x: i32, xs: i32[]): i32[] {
  var out: i32[] = [x];
  for y in xs {
    out = out.append(y);
  }
  return out;
}

function prepend_str(x: string, xs: string[]): string[] {
  var out: string[] = [x];
  for y in xs {
    out = out.append(y);
  }
  return out;
}

function next_block_id(g: ssa.SFunc): i32 {
  var hi: i32 = 0;
  for b in g.blocks {
    if (b.id >= hi) {
      hi = b.id + 1;
    }
  }
  return hi;
}

function br(target: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function brif(cond: i32, t: i32, f: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 3, cond: cond, target: 0, t: t, f: f, value: 0 };
}

function term_targets(t: ssa.STerm): i32[] {
  if (t.kind_tag == 2) {
    return [t.target];
  }
  if (t.kind_tag == 3) {
    return [t.t, t.f];
  }
  return [];
}

// ---- building the loop ----------------------------------------------------

// The blocks built so far, the open block, and the next free block id.
struct Build { values: typeinfo.Type[], blocks: ssa.SBlock[], id: i32, preds: i32[], insts: ssa.SInst[], next: i32 }

struct Emitted { s: Build, v: i32 }

function emit(s: Build, kind: i32, t: typeinfo.Type, args: i32[], imm: i32, str: string): Emitted {
  var v: i32 = s.values.len();
  var ins: ssa.SInst = ssa.SInst { kind_tag: kind, result: v, args: args, imm: imm, str: str };
  return Emitted { s: Build { ...s, values: s.values.append(t), insts: s.insts.append(ins) }, v: v };
}

// An instruction defining a value that already has an id and a type: the
// sink's result, so every later reader of it is left as it was.
function emit_at(s: Build, kind: i32, args: i32[], result: i32): Build {
  return Build { ...s, insts: s.insts.append(ssa.SInst { kind_tag: kind, result: result, args: args, imm: 0, str: "" }) };
}

function close(s: Build, term: ssa.STerm): Build {
  return Build { ...s, blocks: s.blocks.append(ssa.SBlock { id: s.id, insts: s.insts, term: term, preds: s.preds }), insts: [] };
}

function open(s: Build, id: i32, preds: i32[]): Build {
  return Build { ...s, id: id, preds: preds, insts: [] };
}

function fresh(s: Build, n: i32): Build {
  return Build { ...s, next: s.next + n };
}

// The loop's carried values: the cursor, the accumulator, and for `reduce`
// whether anything has arrived. Each back edge supplies one of each.
struct Loop { head: i32, i: i32, acc: i32, seen: i32, next_i: i32, backs: i32[], accs: i32[], seens: i32[] }

function back(l: Loop, from: i32, acc: i32, seen: i32): Loop {
  return Loop { ...l, backs: l.backs.append(from), accs: l.accs.append(acc), seens: l.seens.append(seen) };
}

struct Stepped { s: Build, l: Loop, e: i32 }

// The stages' steps, concatenated: a `map` rebinds the element, a `filter`
// whose predicate says no skips straight back to the header.
function steps(f: ssasem.Func, c: Chain, s: Build, l: Loop, e: i32): Stepped {
  var j: i32 = 0;
  while (j < c.stages.len()) {
    var fn: i32 = c.fns[j];
    if (c.verbs[j] == "map") {
      var m: Emitted = emit(s, ssasem.call_value(), ssasem.func_result(f.values[fn]), [fn, e], 0, "");
      s = m.s;
      e = m.v;
    } else {
      var keep: Emitted = emit(s, ssasem.call_value(), typeinfo.TypeBool { tag: 0 }, [fn, e], 0, "");
      var from: i32 = keep.s.id;
      var yes: i32 = keep.s.next;
      s = close(fresh(keep.s, 2), brif(keep.v, yes, yes + 1));
      s = close(open(s, yes + 1, [from]), br(l.head));
      l = back(l, yes + 1, l.acc, l.seen);
      s = open(s, yes, [from]);
    }
    j = j + 1;
  }
  return Stepped { s: s, l: l, e: e };
}

// The sink's step. `fold` combines into the accumulator; `reduce` takes the
// first element to arrive as the accumulator and combines the rest, so its
// combining function never sees a lone element.
function sink_step(c: Chain, combine: i32, t: typeinfo.Type, st: Stepped, yes: i32): Stepped {
  var s: Build = st.s;
  var l: Loop = st.l;
  if (c.verb == "fold") {
    var a: Emitted = emit(s, ssasem.call_value(), t, [combine, l.acc, st.e], 0, "");
    return Stepped { s: close(a.s, br(l.head)), l: back(l, a.s.id, a.v, l.seen), e: st.e };
  }
  var from: i32 = s.id;
  var comb: i32 = s.next;
  s = close(fresh(s, 3), brif(l.seen, comb, comb + 1));
  var a: Emitted = emit(open(s, comb, [from]), ssasem.call_value(), t, [combine, l.acc, st.e], 0, "");
  s = close(a.s, br(comb + 2));
  s = close(open(s, comb + 1, [from]), br(comb + 2));
  var joined: Emitted = emit(open(s, comb + 2, [comb, comb + 1]), 8, t, [a.v, st.e], 0, "");
  return Stepped { s: close(joined.s, br(l.head)), l: back(l, comb + 2, joined.v, yes), e: st.e };
}

// The sink's finish, left in the sink's own result: fold's accumulator, or
// reduce's `Some(acc)`, `None` when nothing arrived.
function finish(f: ssasem.Func, c: Chain, s: Build, l: Loop, result: i32): Build {
  if (c.verb == "fold") {
    return emit_at(s, 7, [l.acc], result);
  }
  var whole: typeinfo.Type = f.values[result];
  var from: i32 = s.id;
  var some: i32 = s.next;
  s = close(fresh(s, 3), brif(l.seen, some, some + 1));
  var vs: Emitted = emit(open(s, some, [from]), ssasem.variant_new(), whole, [l.acc], 0, "Some");
  s = close(vs.s, br(some + 2));
  var vn: Emitted = emit(open(s, some + 1, [from]), ssasem.variant_new(), whole, [], 0, "None");
  s = close(vn.s, br(some + 2));
  return emit_at(open(s, some + 2, [some, some + 1]), 8, [vs.v, vn.v], result);
}

// The header's phis, completed once every back edge is known.
function header(s: Build, l: Loop, entry: i32, start: i32, init: i32, unseen: i32): Build {
  var at: i32 = 0;
  while (s.blocks[at].id != l.head) {
    at = at + 1;
  }
  var h: ssa.SBlock = s.blocks[at];
  var is: i32[] = [start];
  for _ in l.backs {
    is = is.append(l.next_i);
  }
  var phis: ssa.SInst[] = [
    ssa.SInst { kind_tag: 8, result: l.i, args: is, imm: 0, str: "" },
    ssa.SInst { kind_tag: 8, result: l.acc, args: prepend(init, l.accs), imm: 0, str: "" },
  ];
  if (l.seen >= 0) {
    phis = phis.append(ssa.SInst { kind_tag: 8, result: l.seen, args: prepend(unseen, l.seens), imm: 0, str: "" });
  }
  for ins in h.insts {
    phis = phis.append(ins);
  }
  var full: ssa.SBlock = ssa.SBlock { ...h, insts: phis, preds: prepend(entry, l.backs) };
  return Build { ...s, blocks: s.blocks.with(at, full) };
}

struct Opened { s: Build, l: Loop, init: i32, unseen: i32, yes: i32, start: i32 }

// What runs once before the loop: the length, read once since the array is a
// value nothing in the loop can replace, the cursor one before the first
// element, and the accumulator's seed. Then the header: advance, and test
// against the length.
function enter(f: ssasem.Func, c: Chain, s: Build, acc_t: typeinfo.Type): Opened {
  var i32t: typeinfo.Type = typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false };
  var bool_t: typeinfo.Type = typeinfo.TypeBool { tag: 0 };
  var n: Emitted = emit(s, ssasem.length(), i32t, [c.base], 0, "");
  var start: Emitted = emit(n.s, 1, i32t, [], 0 - 1, "");
  s = start.s;
  var sink: ssa.SInst = f.graph.blocks[c.block].insts[c.sink];
  var o: Opened = Opened { s: s, l: Loop { head: 0, i: 0, acc: 0, seen: 0 - 1, next_i: 0, backs: [], accs: [], seens: [] }, init: 0, unseen: 0 - 1, yes: 0 - 1, start: start.v };
  if (c.verb == "fold") {
    o = Opened { ...o, init: sink.args[1] };
  } else {
    var z: Emitted = emit(s, ssasem.zero(), acc_t, [], 0, "");
    var no: Emitted = emit(z.s, 2, bool_t, [], 0, "");
    var yes: Emitted = emit(no.s, 2, bool_t, [], 1, "");
    o = Opened { ...o, s: yes.s, init: z.v, unseen: no.v, yes: yes.v };
  }
  s = o.s;
  var head: i32 = s.next;
  var l: Loop = Loop { ...o.l, head: head, i: s.values.len(), acc: s.values.len() + 1 };
  s = Build { ...fresh(s, 3), values: s.values.append(i32t).append(acc_t) };
  if (c.verb == "reduce") {
    l = Loop { ...l, seen: s.values.len() };
    s = Build { ...s, values: s.values.append(bool_t) };
  }
  s = open(close(s, br(head)), head, []);
  var one: Emitted = emit(s, 1, i32t, [], 1, "");
  var step: Emitted = emit(one.s, 9, i32t, [l.i, one.v], 0, "+");
  var more: Emitted = emit(step.s, 9, bool_t, [step.v, n.v], 0, "<");
  s = close(more.s, brif(more.v, head + 1, head + 2));
  return Opened { ...o, s: open(s, head + 1, [head]), l: Loop { ...l, next_i: step.v } };
}

// Replaces the chain with one loop. The block holding it is split: what came
// before the sink (less the stages) runs first, the loop follows, and what
// came after the sink continues from the loop's exit under the old
// terminator.
function fuse(f: ssasem.Func, c: Chain): ssasem.Func {
  var g: ssa.SFunc = f.graph;
  var b: ssa.SBlock = g.blocks[c.block];
  var sink: ssa.SInst = b.insts[c.sink];
  var acc_t: typeinfo.Type = f.values[sink.result];
  if (c.verb == "reduce") {
    acc_t = element(f.values[sink.args[0]]);
  }
  var s: Build = Build { values: f.values, blocks: [], id: b.id, preds: b.preds, insts: kept_before(b, c), next: next_block_id(g) };
  var o: Opened = enter(f, c, s, acc_t);
  var fetched: Emitted = emit(o.s, ssasem.array_get(), element(f.values[c.base]), [c.base, o.l.next_i], 1, "");
  var st: Stepped = steps(f, c, fetched.s, o.l, fetched.v);
  st = sink_step(c, sink.args[sink.args.len() - 1], acc_t, st, o.yes);
  s = finish(f, c, open(st.s, o.l.head + 2, [o.l.head]), st.l, sink.result);
  var p: i32 = c.sink + 1;
  while (p < b.insts.len()) {
    s = Build { ...s, insts: s.insts.append(b.insts[p]) };
    p = p + 1;
  }
  s = header(close(s, b.term), st.l, b.id, o.start, o.init, o.unseen);
  var graph: ssa.SFunc = ssa.SFunc { ...g, blocks: spliced(g, c.block, s.blocks), nvals: s.values.len() };
  var gone: string[] = [sink.str];
  for at in c.stages {
    gone = gone.append(b.insts[at].str);
  }
  return ssasem.Func { ...f, graph: graph, values: s.values, calls: still_called(f.calls, gone, graph) };
}

function kept_before(b: ssa.SBlock, c: Chain): ssa.SInst[] {
  var out: ssa.SInst[] = [];
  var p: i32 = 0;
  while (p < c.sink) {
    if (index_of(c.stages, p) < 0) {
      out = out.append(b.insts[p]);
    }
    p = p + 1;
  }
  return out;
}

// The old block's place takes the first built block; the rest go last. A
// successor of the old block now follows the block its terminator moved to.
function spliced(g: ssa.SFunc, at: i32, built: ssa.SBlock[]): ssa.SBlock[] {
  var old: ssa.SBlock = g.blocks[at];
  var last: i32 = built[built.len() - 1].id;
  var targets: i32[] = term_targets(old.term);
  var out: ssa.SBlock[] = [];
  var i: i32 = 0;
  while (i < g.blocks.len()) {
    var blk: ssa.SBlock = g.blocks[i];
    if (i == at) {
      blk = built[0];
    }
    if (index_of(targets, blk.id) >= 0) {
      blk = ssa.SBlock { ...blk, preds: renamed(blk.preds, old.id, last) };
    }
    out = out.append(blk);
    i = i + 1;
  }
  i = 1;
  while (i < built.len()) {
    out = out.append(built[i]);
    i = i + 1;
  }
  return out;
}

function renamed(xs: i32[], from: i32, to: i32): i32[] {
  var out: i32[] = [];
  for x in xs {
    if (x == from) {
      out = out.append(to);
    } else {
      out = out.append(x);
    }
  }
  return out;
}

// The call table less the combinators the fusion removed the last call to.
function still_called(calls: ssasem.Contract[], gone: string[], g: ssa.SFunc): ssasem.Contract[] {
  var named: string[] = [];
  for b in g.blocks {
    for ins in b.insts {
      if (ins.kind_tag == ssasem.call()) {
        named = named.append(ins.str);
      }
    }
  }
  var out: ssasem.Contract[] = [];
  for c in calls {
    if (!util.has_str(gone, c.name) || util.has_str(named, c.name)) {
      out = out.append(c);
    }
  }
  return out;
}
