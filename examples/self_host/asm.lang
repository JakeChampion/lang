// examples/self_host/asm.lang — first true codegen layer in the
// self-host port. Walks a parser.Module and emits AT&T x86_64
// assembly text. The emitted asm uses Linux syscall conventions
// (sys_exit_group = 60) and is assemble-able with
// `gcc -nostdlib`.
//
// Scope:
//   - i32 literals
//   - i32 arithmetic: + - * / %
//   - Comparisons: < <= > >= == != → 0/1 i32 via cmpq + setcc
//   - Parenthesised grouping (handled implicitly via recursion)
//   - Unary `-`
//   - Control flow: if/else and while (forward-jump patching
//     via unique generated labels)
//   - Statement-level: `return <expr>;` lowers to sys_exit_group
//
// The output programs are valid standalone Linux ELF binaries
// after `gcc -nostdlib -static <out>.s -o <out>`. A follow-up
// Go-side test could exec them and assert the exit code matches
// the lang-port's interp.lang on the same source — that would
// be a real "lang emits running native code" demo. For now the
// lang-side validation is substring assertions on the emitted
// text.
//
// Lowering shape — a textual stack machine. Each expr emits ops
// that leave its result on the rt-stack via push %rax:
//   literal n:  movq $n, %rax; pushq %rax
//   bin l op r: <emit l>; <emit r>; popq %rcx; popq %rax;
//               <op>; pushq %rax
// Statement `return <expr>;` emits the expr, then pops into %rdi
// and issues `sys_exit_group`. Same lowering the production
// codegen uses for the same shape — just typeset as text.

import "core/no_prelude";
import "./lexer";
import "./parser";

// =================== TEXT HELPERS ====================

function i32_to_string(n: i32): string {
    if (n == 0) { return "0"; }
    var neg: boolean = false;
    if (n < 0) { neg = true; n = 0 - n; }
    var out: string = "";
    while (n > 0) {
        var d: i32 = n % 10;
        var c: string = "";
        if (d == 0) { c = "0"; } else if (d == 1) { c = "1"; }
        else if (d == 2) { c = "2"; } else if (d == 3) { c = "3"; }
        else if (d == 4) { c = "4"; } else if (d == 5) { c = "5"; }
        else if (d == 6) { c = "6"; } else if (d == 7) { c = "7"; }
        else if (d == 8) { c = "8"; } else { c = "9"; }
        out = c + out;
        n = n / 10;
    }
    if (neg) { out = "-" + out; }
    return out;
}

// sanitize_label rewrites `.` to `__` so qualified-name
// function labels (e.g. `parser.parse_module`) emit a label
// like `__fn_parser__parse_module:` rather than the
// dot-in-symbol form that GNU as parses inconsistently.
function sanitize_label(name: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < len(name)) {
        var b: i32 = name[i];
        if (b == 46) { out = out + "__"; }
        else { out = out + name[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

function digits_to_i32(s: string): i32 {
    if (len(s) == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == 45) { neg = true; start = 1; }
    var acc: i32 = 0;
    var i: i32 = start;
    while (i < len(s)) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) {
            if (neg) { return 0 - acc; }
            return acc;
        }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    if (neg) { return 0 - acc; }
    return acc;
}

// is_all_digits returns true iff `s` is non-empty and every
// byte is an ASCII digit. Used by ExprFieldAccess to detect
// tuple-style numeric field names (`.0`, `.1`, …) versus
// struct field names.
function is_all_digits(s: string): boolean {
    if (len(s) == 0) { return false; }
    var i: i32 = 0;
    while (i < len(s)) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return false; }
        i = i + 1;
    }
    return true;
}

// =================== FREE-VAR WALKER ====================
// Used by ExprLambda capture analysis. Same shape as the
// walker in vm.lang's #824.

function has_str(xs: string[], s: string): boolean {
    var i: i32 = 0;
    while (i < len(xs)) {
        if (xs[i] == s) { return true; }
        i = i + 1;
    }
    return false;
}

function collect_idents_expr(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprIdent(id) => { return acc.push(id.name); },
        parser.ExprNumber(_) => { return acc; },
        parser.ExprString(_) => { return acc; },
        parser.ExprBool(_) => { return acc; },
        parser.ExprBinary(b) => {
            acc = collect_idents_expr(b.left, acc);
            return collect_idents_expr(b.right, acc);
        },
        parser.ExprUnary(u) => { return collect_idents_expr(u.operand, acc); },
        parser.ExprCall(c) => {
            acc = collect_idents_expr(c.callee, acc);
            var i: i32 = 0;
            while (i < len(c.args)) {
                acc = collect_idents_expr(c.args[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < len(a.elements)) {
                acc = collect_idents_expr(a.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < len(t.elements)) {
                acc = collect_idents_expr(t.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprIndex(x) => {
            acc = collect_idents_expr(x.array, acc);
            return collect_idents_expr(x.index, acc);
        },
        parser.ExprSlice(sl) => {
            acc = collect_idents_expr(sl.array, acc);
            acc = collect_idents_expr(sl.start, acc);
            return collect_idents_expr(sl.end, acc);
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < len(sl.field_values)) {
                acc = collect_idents_expr(sl.field_values[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprFieldAccess(fa) => { return collect_idents_expr(fa.obj, acc); },
        parser.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < len(lm.body)) {
                acc = collect_idents_stmt(lm.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

function collect_idents_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        parser.StmtVar(v) => { return collect_idents_expr(v.init, acc); },
        parser.StmtReturn(r) => { return collect_idents_expr(r.value, acc); },
        parser.StmtExpr(e) => { return collect_idents_expr(e.value, acc); },
        parser.StmtIf(i) => {
            acc = collect_idents_expr(i.cond, acc);
            var ti: i32 = 0;
            while (ti < len(i.then_body)) {
                acc = collect_idents_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < len(i.else_body)) {
                acc = collect_idents_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            acc = collect_idents_expr(w.cond, acc);
            var i: i32 = 0;
            while (i < len(w.body)) {
                acc = collect_idents_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(a) => { return collect_idents_expr(a.value, acc); },
        parser.StmtMatch(m) => {
            acc = collect_idents_expr(m.scrutinee, acc);
            var ai: i32 = 0;
            while (ai < len(m.arms)) {
                var bi: i32 = 0;
                while (bi < len(m.arms[ai].body)) {
                    acc = collect_idents_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = collect_idents_expr(f.iter, acc);
            var i: i32 = 0;
            while (i < len(f.body)) {
                acc = collect_idents_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

function collect_bound_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        parser.StmtVar(v) => { return acc.push(v.name); },
        parser.StmtReturn(_) => { return acc; },
        parser.StmtExpr(_) => { return acc; },
        parser.StmtIf(i) => {
            var ti: i32 = 0;
            while (ti < len(i.then_body)) {
                acc = collect_bound_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < len(i.else_body)) {
                acc = collect_bound_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            var i: i32 = 0;
            while (i < len(w.body)) {
                acc = collect_bound_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(_) => { return acc; },
        parser.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < len(m.arms)) {
                match (m.arms[ai].pattern) {
                    parser.PatVariant(pv) => {
                        if (len(pv.binding) > 0) { acc = acc.push(pv.binding); }
                    },
                    parser.PatWildcard(_) => { }
                }
                var bi: i32 = 0;
                while (bi < len(m.arms[ai].body)) {
                    acc = collect_bound_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = acc.push(f.var_name);
            var i: i32 = 0;
            while (i < len(f.body)) {
                acc = collect_bound_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// lambda_captures returns the names that the lambda body
// reads and that resolve to a local in the OUTER scope (i.e.
// real captures). Params and body-bound names are subtracted;
// top-level function names are filtered by checking has_local.
function lambda_captures(lm: parser.ExprLambda, outer: EmitState): string[] {
    var refs: string[] = [];
    var bi: i32 = 0;
    while (bi < len(lm.body)) {
        refs = collect_idents_stmt(lm.body[bi], refs);
        bi = bi + 1;
    }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < len(lm.params)) {
        bound = bound.push(lm.params[pi].name);
        pi = pi + 1;
    }
    var si: i32 = 0;
    while (si < len(lm.body)) {
        bound = collect_bound_stmt(lm.body[si], bound);
        si = si + 1;
    }
    var caps: string[] = [];
    var ri: i32 = 0;
    while (ri < len(refs)) {
        var nm: string = refs[ri];
        if (!has_str(bound, nm) && !has_str(caps, nm) && outer.has_local(nm)) {
            caps = caps.push(nm);
        }
        ri = ri + 1;
    }
    return caps;
}

// infer_expr_type returns a coarse type tag for an expression
// based on its syntactic shape + the current EmitState's
// local_types. Used by ExprBinary / ExprIndex / etc. to
// dispatch on operand types (e.g. string + string → concat,
// i32 + i32 → addq). Tag values:
//   "i32", "bool", "string", "array", "tuple", "struct",
//   "fn", "unknown".
function infer_expr_type(e: parser.Expr, s: EmitState): string {
    match (e) {
        parser.ExprNumber(_) => { return "i32"; },
        parser.ExprBool(_) => { return "bool"; },
        parser.ExprString(_) => { return "string"; },
        parser.ExprArray(a) => {
            // Element-type tracking: if the first element is
            // a string (or another array-of-string), tag the
            // whole array as "array_string" so indexing routes
            // string-aware dispatch. Empty arrays default to
            // plain "array"; the explicit `string[]` annotation
            // on a `var` declaration overrides.
            if (len(a.elements) == 0) { return "array"; }
            var et: string = infer_expr_type(a.elements[0], s);
            if (et == "string") { return "array_string"; }
            return "array";
        },
        parser.ExprTuple(_) => { return "tuple"; },
        parser.ExprStructLit(_) => { return "struct"; },
        parser.ExprLambda(lm) => {
            // Encode the return type in the tag so a later
            // `f()` call site can recover it from the local's
            // recorded type. The closure-box itself is just an
            // 8-byte pointer regardless of return shape, so
            // capture / call machinery is unaffected; this is
            // purely for the type-aware dispatch on the result
            // (e.g. `print(f())` needs to know the result is a
            // string to route through `__lang_print_str`).
            return "fn_" + ret_tag_of(lm.ret_type);
        },
        parser.ExprIdent(id) => { return s.local_type_of(id.name); },
        parser.ExprBinary(b) => {
            // `+` propagates string when either side is string
            // (string + string → string concat). Comparisons
            // and logical ops return bool. Other arithmetic
            // returns i32.
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">="
                    || b.op == "==" || b.op == "!=" || b.op == "&&" || b.op == "||") {
                return "bool";
            }
            if (b.op == "+") {
                var lt: string = infer_expr_type(b.left, s);
                var rt: string = infer_expr_type(b.right, s);
                if (lt == "string" || rt == "string") { return "string"; }
                return "i32";
            }
            return "i32";
        },
        parser.ExprUnary(u) => {
            if (u.op == "!") { return "bool"; }
            return "i32";
        },
        parser.ExprCall(c) => {
            // `len(_)` always returns i32. Plain calls look up
            // the FuncDecl.ret_type. Method calls on primitive
            // receivers also resolve via the FuncDecl table —
            // for struct receivers the shape can vary at
            // runtime, so we keep those as "unknown".
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (id.name == "len") { return "i32"; }
                    if (id.name == "read_int") { return "i32"; }
                    if (id.name == "read_line") { return "string"; }
                    if (id.name == "i32_to_string") { return "string"; }
                    if (id.name == "str_to_i32") { return "i32"; }
                    if (id.name == "str_starts_with") { return "bool"; }
                    if (id.name == "str_ends_with") { return "bool"; }
                    if (id.name == "str_contains") { return "bool"; }
                    if (id.name == "str_index_of") { return "i32"; }
                    if (id.name == "str_trim") { return "string"; }
                    if (id.name == "str_to_upper") { return "string"; }
                    if (id.name == "str_to_lower") { return "string"; }
                    if (id.name == "str_repeat") { return "string"; }
                    if (id.name == "str_replace") { return "string"; }
                    if (id.name == "chr") { return "string"; }
                    if (id.name == "exit") { return "i32"; }
                    if (id.name == "args_count") { return "i32"; }
                    if (id.name == "arg_at") { return "string"; }
                    if (id.name == "str_split") { return "array_string"; }
                    // Local-callee path: when `f()` invokes a
                    // local var that was bound to a lambda, its
                    // recorded type is `fn_<ret>` (see the
                    // ExprLambda match arm above). Strip the
                    // prefix so downstream dispatch (`print(f())`,
                    // string concat, etc.) sees the actual return
                    // type rather than `"unknown"`.
                    if (s.has_local(id.name)) {
                        var lt: string = s.local_type_of(id.name);
                        if (lt == "fn_string") { return "string"; }
                        if (lt == "fn_i32") { return "i32"; }
                        if (lt == "fn_bool") { return "bool"; }
                        if (lt == "fn_array_string") { return "array_string"; }
                        if (lt == "fn_array_i32") { return "array_i32"; }
                    }
                    // Plain function call: look up ret_type.
                    var fi: i32 = 0;
                    while (fi < len(s.funcs)) {
                        if (s.funcs[fi].name == id.name && len(s.funcs[fi].receiver_type) == 0) {
                            return ret_tag_of(s.funcs[fi].ret_type);
                        }
                        fi = fi + 1;
                    }
                    return "unknown";
                },
                parser.ExprFieldAccess(fa) => {
                    // Method call: only inferable when the
                    // receiver has a known primitive type (so
                    // we can find a single FuncDecl that
                    // matches name + receiver_type).
                    var rt: string = infer_expr_type(fa.obj, s);
                    if ((rt == "i32" || rt == "string") && fa.field == "to_string") {
                        return "string";
                    }
                    if (rt == "string" || rt == "i32" || rt == "bool" || rt == "f64") {
                        var mi: i32 = 0;
                        while (mi < len(s.funcs)) {
                            if (s.funcs[mi].name == fa.field && s.funcs[mi].receiver_type == rt) {
                                return ret_tag_of(s.funcs[mi].ret_type);
                            }
                            mi = mi + 1;
                        }
                    }
                    return "unknown";
                },
                _ => { return "unknown"; }
            }
            return "unknown";
        },
        parser.ExprIndex(x) => {
            // Container type drives element type:
            //   string → "i32" (byte)
            //   array_string → "string"
            //   array_i32 / array → "i32"
            var at: string = infer_expr_type(x.array, s);
            if (at == "string") { return "i32"; }
            if (at == "array_string") { return "string"; }
            return "i32";
        },
        parser.ExprSlice(sl) => {
            // Slice preserves the container type.
            var at: string = infer_expr_type(sl.array, s);
            return at;
        },
        parser.ExprFieldAccess(_) => { return "unknown"; },
        parser.ExprUnknown(_) => { return "unknown"; }
    }
    return "unknown";
}

// ret_tag_of maps a parser-side type name string to one of
// the infer_expr_type tag values. Unknown shapes (struct
// names, generics, etc.) fall through to "unknown".
function ret_tag_of(name: string): string {
    if (name == "i32" || name == "f64" || name == "f32") { return "i32"; }
    if (name == "bool" || name == "boolean") { return "bool"; }
    if (name == "string") { return "string"; }
    if (name == "string[]") { return "array_string"; }
    if (name == "i32[]") { return "array_i32"; }
    if (name == "bool[]" || name == "boolean[]") { return "array_i32"; }
    if (len(name) > 0 && name[len(name) - 1] == 93) {
        // Trailing `]` → other `T[]` shapes (struct[] etc.)
        // or Map[..]. Treat as plain array.
        return "array";
    }
    return "unknown";
}

// =================== EMIT STATE ====================

// EmitState bundles the running output text, a monotonic label
// counter, the active locals table, an `in_function` flag, and
// a pool of string literals that get materialised in `.rodata`
// at the end of emit. Threaded by value through every emit_*
// call — each return produces a fresh EmitState with the
// appended text and (where relevant) updated counters /
// locals / literals.
pub struct EmitState {
    out: string,
    label_n: i32,
    local_names: string[],
    in_function: boolean,
    string_lits: string[],
    needs_print_int: boolean,
    needs_read_int: boolean,
    needs_heap: boolean,
    // struct_decls: the module's struct decls — used by
    // ExprStructLit + ExprFieldAccess to look up field
    // layout. Seeded from mod.structs at the start of
    // emit_module.
    struct_decls: parser.StructDecl[],
    // loop_exit_labels / loop_cont_labels: stacks of jump
    // targets for break + continue inside the currently-active
    // loops. Pushed when entering a StmtWhile / StmtFor body,
    // popped on the way out. break uses the top of
    // loop_exit_labels; continue uses the top of
    // loop_cont_labels (which for `for` points at the index-
    // increment block, NOT the top of the loop).
    loop_exit_labels: string[],
    loop_cont_labels: string[],
    // funcs: the module's FuncDecls — used by ExprCall on an
    // ExprFieldAccess callee (method call) to find every
    // struct that has a matching method, so the dispatch
    // chain can emit a shape-compare arm per matching struct.
    funcs: parser.FuncDecl[],
    // local_types: parallel to local_names — the inferred
    // type of each local, populated at StmtVar binding time
    // via infer_expr_type. Used by ExprBinary("+") / ExprIndex
    // / `len()` etc. to dispatch on operand types (string vs
    // i32 vs array). Tag values: "i32", "bool", "string",
    // "array", "tuple", "struct", "fn", "unknown".
    local_types: string[],
    // needs_str_*: lazy-emit flags for the string runtime
    // helpers (set by emit_expr when the helpers are
    // referenced; checked at the end of emit_module).
    needs_str_concat: boolean,
    needs_str_eq: boolean,
    needs_str_print: boolean,
    needs_str_cmp: boolean,
    needs_str_read_line: boolean,
    needs_i32_to_string: boolean,
    needs_str_to_i32: boolean,
    needs_eprint: boolean,
    needs_str_search: boolean,
    needs_args: boolean
}

function new_state(): EmitState {
    var ns: string[] = [];
    var sl: string[] = [];
    var lex: string[] = [];
    var lcn: string[] = [];
    var fns: parser.FuncDecl[] = [];
    var lts: string[] = [];
    return EmitState {
        out: "",
        label_n: 0,
        local_names: ns,
        in_function: false,
        string_lits: sl,
        needs_print_int: false,
        needs_read_int: false,
        needs_heap: false,
        struct_decls: [],
        loop_exit_labels: lex,
        loop_cont_labels: lcn,
        funcs: fns,
        local_types: lts,
        needs_str_concat: false,
        needs_str_eq: false,
        needs_str_print: false,
        needs_str_cmp: false,
        needs_str_read_line: false,
        needs_i32_to_string: false,
        needs_str_to_i32: false,
        needs_eprint: false,
        needs_str_search: false,
        needs_args: false
    };
}

function (s: EmitState) write(text: string): EmitState {
    return EmitState {
        out: s.out + text,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args
    };
}

function (s: EmitState) bind_local(name: string): EmitState {
    return s.bind_local_typed(name, "unknown");
}

