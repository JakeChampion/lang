// examples/self_host/asm.lang — first true codegen layer in the
// self-host port. Walks a parser.Module and emits AT&T x86_64
// assembly text. The emitted asm uses Linux syscall conventions
// (sys_exit_group = 60) and is assemble-able with
// `gcc -nostdlib`.
//
// Scope:
//   - i32 literals
//   - i32 arithmetic: + - * / %
//   - Comparisons: < <= > >= == != → 0/1 i32 via cmpq + setcc
//   - Parenthesised grouping (handled implicitly via recursion)
//   - Unary `-`
//   - Control flow: if/else and while (forward-jump patching
//     via unique generated labels)
//   - Statement-level: `return <expr>;` lowers to sys_exit_group
//
// The output programs are valid standalone Linux ELF binaries
// after `gcc -nostdlib -static <out>.s -o <out>`. A follow-up
// Go-side test could exec them and assert the exit code matches
// the lang-port's interp.lang on the same source — that would
// be a real "lang emits running native code" demo. For now the
// lang-side validation is substring assertions on the emitted
// text.
//
// Lowering shape — a textual stack machine. Each expr emits ops
// that leave its result on the rt-stack via push %rax:
//   literal n:  movq $n, %rax; pushq %rax
//   bin l op r: <emit l>; <emit r>; popq %rcx; popq %rax;
//               <op>; pushq %rax
// Statement `return <expr>;` emits the expr, then pops into %rdi
// and issues `sys_exit_group`. Same lowering the production
// codegen uses for the same shape — just typeset as text.

import "core/no_prelude";
import "./lexer";
import "./parser";

// =================== TEXT HELPERS ====================

function i32_to_string(n: i32): string {
    if (n == 0) { return "0"; }
    var neg: boolean = false;
    if (n < 0) { neg = true; n = 0 - n; }
    var out: string = "";
    while (n > 0) {
        var d: i32 = n % 10;
        var c: string = "";
        if (d == 0) { c = "0"; } else if (d == 1) { c = "1"; }
        else if (d == 2) { c = "2"; } else if (d == 3) { c = "3"; }
        else if (d == 4) { c = "4"; } else if (d == 5) { c = "5"; }
        else if (d == 6) { c = "6"; } else if (d == 7) { c = "7"; }
        else if (d == 8) { c = "8"; } else { c = "9"; }
        out = c + out;
        n = n / 10;
    }
    if (neg) { out = "-" + out; }
    return out;
}

// sanitize_label rewrites `.` to `__` so qualified-name
// function labels (e.g. `parser.parse_module`) emit a label
// like `__fn_parser__parse_module:` rather than the
// dot-in-symbol form that GNU as parses inconsistently.
function sanitize_label(name: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < len(name)) {
        var b: i32 = name[i];
        if (b == 46) { out = out + "__"; }
        else { out = out + name[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

function digits_to_i32(s: string): i32 {
    if (len(s) == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == 45) { neg = true; start = 1; }
    var acc: i32 = 0;
    var i: i32 = start;
    while (i < len(s)) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) {
            if (neg) { return 0 - acc; }
            return acc;
        }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    if (neg) { return 0 - acc; }
    return acc;
}

// is_all_digits returns true iff `s` is non-empty and every
// byte is an ASCII digit. Used by ExprFieldAccess to detect
// tuple-style numeric field names (`.0`, `.1`, …) versus
// struct field names.
function is_all_digits(s: string): boolean {
    if (len(s) == 0) { return false; }
    var i: i32 = 0;
    while (i < len(s)) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return false; }
        i = i + 1;
    }
    return true;
}

// =================== EMIT STATE ====================

// EmitState bundles the running output text, a monotonic label
// counter, the active locals table, an `in_function` flag, and
// a pool of string literals that get materialised in `.rodata`
// at the end of emit. Threaded by value through every emit_*
// call — each return produces a fresh EmitState with the
// appended text and (where relevant) updated counters /
// locals / literals.
pub struct EmitState {
    out: string,
    label_n: i32,
    local_names: string[],
    in_function: boolean,
    string_lits: string[],
    needs_print_int: boolean,
    needs_read_int: boolean,
    needs_heap: boolean,
    // struct_decls: the module's struct decls — used by
    // ExprStructLit + ExprFieldAccess to look up field
    // layout. Seeded from mod.structs at the start of
    // emit_module.
    struct_decls: parser.StructDecl[],
    // loop_exit_labels / loop_cont_labels: stacks of jump
    // targets for break + continue inside the currently-active
    // loops. Pushed when entering a StmtWhile / StmtFor body,
    // popped on the way out. break uses the top of
    // loop_exit_labels; continue uses the top of
    // loop_cont_labels (which for `for` points at the index-
    // increment block, NOT the top of the loop).
    loop_exit_labels: string[],
    loop_cont_labels: string[],
    // funcs: the module's FuncDecls — used by ExprCall on an
    // ExprFieldAccess callee (method call) to find every
    // struct that has a matching method, so the dispatch
    // chain can emit a shape-compare arm per matching struct.
    funcs: parser.FuncDecl[]
}

function new_state(): EmitState {
    var ns: string[] = [];
    var sl: string[] = [];
    var lex: string[] = [];
    var lcn: string[] = [];
    var fns: parser.FuncDecl[] = [];
    return EmitState {
        out: "",
        label_n: 0,
        local_names: ns,
        in_function: false,
        string_lits: sl,
        needs_print_int: false,
        needs_read_int: false,
        needs_heap: false,
        struct_decls: [],
        loop_exit_labels: lex,
        loop_cont_labels: lcn,
        funcs: fns
    };
}

function (s: EmitState) write(text: string): EmitState {
    return EmitState {
        out: s.out + text,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs
    };
}

function (s: EmitState) bind_local(name: string): EmitState {
    var ln: string[] = s.local_names.push(name);
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: ln,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs
    };
}

function (s: EmitState) reset_locals(): EmitState {
    var ln: string[] = [];
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: ln,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs
    };
}

function (s: EmitState) enter_function(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: true,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs
    };
}

function (s: EmitState) push_loop_labels(exit_lbl: string, cont_lbl: string): EmitState {
    var nex: string[] = s.loop_exit_labels.push(exit_lbl);
    var ncn: string[] = s.loop_cont_labels.push(cont_lbl);
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: nex,
        loop_cont_labels: ncn,
        funcs: s.funcs
    };
}

function (s: EmitState) pop_loop_labels(): EmitState {
    var nex: string[] = [];
    var ncn: string[] = [];
    var i: i32 = 0;
    while (i < len(s.loop_exit_labels) - 1) {
        nex = nex.push(s.loop_exit_labels[i]);
        ncn = ncn.push(s.loop_cont_labels[i]);
        i = i + 1;
    }
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: nex,
        loop_cont_labels: ncn,
        funcs: s.funcs
    };
}

function (s: EmitState) top_loop_exit(): string {
    if (len(s.loop_exit_labels) == 0) { return ""; }
    return s.loop_exit_labels[len(s.loop_exit_labels) - 1];
}

function (s: EmitState) top_loop_cont(): string {
    if (len(s.loop_cont_labels) == 0) { return ""; }
    return s.loop_cont_labels[len(s.loop_cont_labels) - 1];
}

function (s: EmitState) leave_function(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: false,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs
    };
}

// mark_print_int flips the "this module needs the print_int
// helper" flag. emit_module checks it after the body emit and
// appends the __lang_print_int label + body if true.
function (s: EmitState) mark_print_int(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: true,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs
    };
}

// mark_heap flips the "this module needs the heap allocator"
// flag. emit_module checks it after the body emit and appends
// the `__lang_heap_ptr` bump-pointer + `__lang_alloc` helper
// when true. Used by struct literals + array literals once the
// asm backend grows real heap-backed value codegen.
function (s: EmitState) mark_heap(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: true,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs
    };
}

// mark_read_int flips the "this module needs the read_int
// helper" flag. Companion to mark_print_int.
function (s: EmitState) mark_read_int(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: true,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs
    };
}

// add_string_lit appends the literal to the pool and returns
// its index, used by the caller to emit `leaq .S<idx>(%rip), …`.
// The pool is materialised in .rodata at end-of-module.
struct StringLitOut { state: EmitState, idx: i32 }
function add_string_lit(s: EmitState, v: string): StringLitOut {
    // Dedup: if the same value has already been interned,
    // return its existing slot. This is load-bearing for the
    // shape-pointer dispatch in ExprFieldAccess + StmtMatch,
    // which compares the runtime shape ptr against a freshly-
    // interned struct-name string. Without dedup, the two
    // .S<N> labels resolve to different .rodata addresses and
    // string-pointer equality always fails.
    var i: i32 = 0;
    while (i < len(s.string_lits)) {
        if (s.string_lits[i] == v) {
            return StringLitOut { state: s, idx: i };
        }
        i = i + 1;
    }
    var idx: i32 = len(s.string_lits);
    var sl: string[] = s.string_lits.push(v);
    var ns: EmitState = EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: sl,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs
    };
    return StringLitOut { state: ns, idx: idx };
}

// lookup_local returns the byte offset off %rbp for `name`, or
// 0 if not found (callers should sanity-check via the parallel
// "is bound" path — emit_expr's ExprIdent arm surfaces a
// comment marker on miss).
function (s: EmitState) lookup_local(name: string): i32 {
    // Newest binding wins. Walk back-to-front so shadowing
    // resolves to the most-recent slot.
    var i: i32 = len(s.local_names) - 1;
    while (i >= 0) {
        if (s.local_names[i] == name) {
            return 0 - 8 * (i + 1);
        }
        i = i - 1;
    }
    return 0;
}

function (s: EmitState) has_local(name: string): boolean {
    var i: i32 = 0;
    while (i < len(s.local_names)) {
        if (s.local_names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// fresh_label hands out a unique label name (".L<n>") and
// returns the new state with label_n already bumped — so the
// caller can reuse `s` for subsequent emits without
// double-allocating.
struct LabelOut { state: EmitState, name: string }
function fresh_label(s: EmitState): LabelOut {
    var name: string = ".L" + i32_to_string(s.label_n);
    var ns: EmitState = EmitState {
        out: s.out,
        label_n: s.label_n + 1,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs
    };
    return LabelOut { state: ns, name: name };
}

// count_locals walks a stmt body recursively (into if / while
// bodies) to determine the total number of `var` decls. The
// result feeds the function-entry `subq $<N*8>, %rsp` so the
// frame has enough room for every local that might be live.
// Conservative: counts every var even if branches make them
// mutually exclusive at runtime — that's fine for stack
// allocation, and far simpler than a liveness analysis.
function count_locals(body: parser.Stmt[]): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < len(body)) {
        n = n + count_locals_in_stmt(body[i]);
        i = i + 1;
    }
    return n;
}

function count_locals_in_stmt(stmt: parser.Stmt): i32 {
    match (stmt) {
        parser.StmtVar(_) => { return 1; },
        parser.StmtIf(ifs) => { return count_locals(ifs.then_body) + count_locals(ifs.else_body); },
        parser.StmtWhile(w) => { return count_locals(w.body); },
        parser.StmtMatch(m) => {
            // +1 for the synthetic scrutinee local + one per
            // non-empty PatVariant binding + the recursive body
            // counts. Wildcard arms add no binding.
            var n: i32 = 1;
            var i: i32 = 0;
            while (i < len(m.arms)) {
                match (m.arms[i].pattern) {
                    parser.PatVariant(pv) => {
                        if (len(pv.binding) > 0 && pv.binding != "_") { n = n + 1; }
                    },
                    parser.PatWildcard(_) => { }
                }
                n = n + count_locals(m.arms[i].body);
                i = i + 1;
            }
            return n;
        },
        parser.StmtFor(f) => {
            // +1 for the synthetic array-pointer slot, +1 for
            // the loop counter, +1 for the bound element var,
            // + body locals.
            return 3 + count_locals(f.body);
        },
        _ => { return 0; }
    }
    return 0;
}

// =================== ASM EMITTER ====================

function emit_expr(e: parser.Expr, s: EmitState): EmitState {
    match (e) {
        parser.ExprNumber(n) => {
            s = s.write("    movq $" + n.text + ", %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprBinary(b) => {
            s = emit_expr(b.left, s);
            s = emit_expr(b.right, s);
            s = s.write("    popq %rcx\n");        // rhs
            s = s.write("    popq %rax\n");        // lhs
            if (b.op == "+") {
                s = s.write("    addq %rcx, %rax\n");
            } else if (b.op == "-") {
                s = s.write("    subq %rcx, %rax\n");
            } else if (b.op == "*") {
                s = s.write("    imulq %rcx, %rax\n");
            } else if (b.op == "/") {
                // idivq: dividend in rdx:rax (sign-extended via
                // cqto), divisor in operand. Result quotient in
                // rax, remainder in rdx.
                s = s.write("    cqto\n");
                s = s.write("    idivq %rcx\n");
            } else if (b.op == "%") {
                s = s.write("    cqto\n");
                s = s.write("    idivq %rcx\n");
                s = s.write("    movq %rdx, %rax\n");
            } else if (b.op == "<" || b.op == "<=" || b.op == ">"
                    || b.op == ">=" || b.op == "==" || b.op == "!=") {
                // Comparison: `cmpq rhs, lhs` sets flags from
                // (lhs - rhs); setcc materialises the bool in
                // %al, movzbq zero-extends into %rax so the
                // surrounding stack push gets a clean 0/1.
                s = s.write("    cmpq %rcx, %rax\n");
                var cc: string = "";
                if (b.op == "<") { cc = "setl"; }
                else if (b.op == "<=") { cc = "setle"; }
                else if (b.op == ">") { cc = "setg"; }
                else if (b.op == ">=") { cc = "setge"; }
                else if (b.op == "==") { cc = "sete"; }
                else { cc = "setne"; }
                s = s.write("    " + cc + " %al\n");
                s = s.write("    movzbq %al, %rax\n");
            } else {
                s = s.write("    # unsupported binop: " + b.op + "\n");
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                s = s.write("    negq %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    # unsupported unary: " + u.op + "\n");
            return s;
        },
        parser.ExprIdent(id) => {
            if (s.has_local(id.name)) {
                var off: i32 = s.lookup_local(id.name);
                s = s.write("    pushq " + i32_to_string(off) + "(%rbp)\n");
                return s;
            }
            s = s.write("    # unresolved ident: " + id.name + "\n");
            s = s.write("    pushq $0\n");
            return s;
        },
        parser.ExprBool(b) => {
            // Bool literal — encode as a 0/1 i32 so it can flow
            // through comparison-style consumers (e.g. an if
            // cond branching on `true`).
            var v: i32 = 0;
            if (b.value) { v = 1; }
            s = s.write("    movq $" + i32_to_string(v) + ", %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprString(_) => {
            s = s.write("    # unsupported: string\n");
            s = s.write("    pushq $0\n");
            return s;
        },
        parser.ExprCall(c) => {
            var name: string = "";
            match (c.callee) {
                parser.ExprIdent(id) => { name = id.name; },
                parser.ExprFieldAccess(fa) => {
                    // Method call: `obj.method(args)`. Push
                    // args right-to-left, then push the
                    // receiver (so receiver sits at +16(%rbp)
                    // and arg[0] at +24(%rbp) inside the
                    // callee). Then dispatch on the receiver's
                    // shape pointer.
                    var mi: i32 = len(c.args) - 1;
                    while (mi >= 0) {
                        s = emit_expr(c.args[mi], s);
                        mi = mi - 1;
                    }
                    s = emit_expr(fa.obj, s);
                    // Peek receiver pointer (top of stack) to
                    // read its shape pointer; load shape into
                    // %rcx without consuming the receiver.
                    s = s.write("    movq (%rsp), %rax\n");
                    s = s.write("    movq (%rax), %rcx\n");
                    var m_end_lbl: i32 = s.label_n;
                    s = EmitState {
                        out: s.out,
                        label_n: s.label_n + 1,
                        local_names: s.local_names,
                        in_function: s.in_function,
                        string_lits: s.string_lits,
                        needs_print_int: s.needs_print_int,
                        needs_read_int: s.needs_read_int,
                        needs_heap: s.needs_heap,
                        struct_decls: s.struct_decls,
                        loop_exit_labels: s.loop_exit_labels,
                        loop_cont_labels: s.loop_cont_labels,
                        funcs: s.funcs
                    };
                    // For each func whose name matches and
                    // receiver_type is non-empty, emit a shape-
                    // compare arm. Walk in declaration order so
                    // the asm is deterministic.
                    var fdi: i32 = 0;
                    while (fdi < len(s.funcs)) {
                        var fd_m: parser.FuncDecl = s.funcs[fdi];
                        if (fd_m.name == fa.field && len(fd_m.receiver_type) > 0) {
                            var arm_lit: StringLitOut = add_string_lit(s, fd_m.receiver_type);
                            s = arm_lit.state;
                            var next_l: LabelOut = fresh_label(s);
                            s = next_l.state;
                            s = s.write("    leaq .S" + i32_to_string(arm_lit.idx) + "(%rip), %rdx\n");
                            s = s.write("    cmpq %rdx, %rcx\n");
                            s = s.write("    jne " + next_l.name + "\n");
                            s = s.write("    call __fn_" + sanitize_label(fd_m.receiver_type + "." + fd_m.name) + "\n");
                            // Caller cleans up args + receiver.
                            s = s.write("    addq $" + i32_to_string((len(c.args) + 1) * 8) + ", %rsp\n");
                            s = s.write("    pushq %rax\n");
                            s = s.write("    jmp .Lmethod_end_" + i32_to_string(m_end_lbl) + "\n");
                            s = s.write(next_l.name + ":\n");
                        }
                        fdi = fdi + 1;
                    }
                    // Fallthrough: no matching method. Clean up
                    // args + receiver, push sentinel -1.
                    s = s.write("    addq $" + i32_to_string((len(c.args) + 1) * 8) + ", %rsp\n");
                    s = s.write("    movq $-1, %rax\n");
                    s = s.write("    pushq %rax\n");
                    s = s.write(".Lmethod_end_" + i32_to_string(m_end_lbl) + ":\n");
                    return s;
                },
                _ => {
                    s = s.write("    # call target not ident\n");
                    s = s.write("    pushq $0\n");
                    return s;
                }
            }
            // print(str_literal) — builtin lowering to write(1, ptr, len).
            // Compile-time we already know the literal's bytes, so we
            // intern it in `.rodata`, look up the offset, and emit the
            // syscall directly. Other string-typed args fall through
            // as unsupported.
            // len(arr) — load the length prefix at offset 0
            // of the array box. Today this assumes the arg is
            // an array (a string arg would read random bytes);
            // a future slice with type info can route string
            // arguments through __lang_str_len.
            if (name == "len" && len(c.args) == 1) {
                s = emit_expr(c.args[0], s);
                s = s.write("    popq %rax\n");
                s = s.write("    movq (%rax), %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (name == "print" && len(c.args) == 1) {
                var arg: parser.Expr = c.args[0];
                match (arg) {
                    parser.ExprString(sv) => {
                        var lo: StringLitOut = add_string_lit(s, sv.value);
                        s = lo.state;
                        s = s.write("    movq $1, %rdi\n");
                        s = s.write("    leaq .S" + i32_to_string(lo.idx) + "(%rip), %rsi\n");
                        s = s.write("    movq $" + i32_to_string(len(sv.value)) + ", %rdx\n");
                        s = s.write("    movq $1, %rax\n");
                        s = s.write("    syscall\n");
                        s = s.write("    pushq $0\n");
                        return s;
                    },
                    _ => { }
                }
            }
            // print_int(i32_expr) — builtin lowering to a call into
            // a runtime helper that converts the value to decimal
            // text and writes it to stdout. The helper is emitted
            // once at the end of the module if any print_int call
            // appears.
            if (name == "print_int" && len(c.args) == 1) {
                s = emit_expr(c.args[0], s);
                s = s.write("    popq %rdi\n");
                s = s.write("    call __lang_print_int\n");
                s = s.write("    pushq $0\n");
                s = s.mark_print_int();
                return s;
            }
            // read_int() — builtin no-arg call to the read_int helper.
            // Reads up to 16 bytes from stdin, parses an optional
            // leading `-` followed by decimal digits, returns the
            // result in %rax. Push it so the surrounding expression
            // sees it on the rt-stack.
            if (name == "read_int" && len(c.args) == 0) {
                s = s.write("    call __lang_read_int\n");
                s = s.write("    pushq %rax\n");
                s = s.mark_read_int();
                return s;
            }
            // Closure call: callee ident resolves to a local
            // var (not a top-level function). The local holds
            // a function pointer (from a capture-less lambda).
            // Push args, load fn ptr, indirect-call.
            if (s.has_local(name)) {
                var ci: i32 = len(c.args) - 1;
                while (ci >= 0) {
                    s = emit_expr(c.args[ci], s);
                    ci = ci - 1;
                }
                var off: i32 = s.lookup_local(name);
                s = s.write("    movq " + i32_to_string(off) + "(%rbp), %rax\n");
                s = s.write("    call *%rax\n");
                if (len(c.args) > 0) {
                    s = s.write("    addq $" + i32_to_string(len(c.args) * 8) + ", %rsp\n");
                }
                s = s.write("    pushq %rax\n");
                return s;
            }
            // Generic user-function call. Push args RIGHT-to-LEFT
            // so the callee sees param[0] at +16(%rbp) (after
            // `pushq %rbp` + the return address). The callee
            // prologue copies args from those positive offsets
            // into local slots so the body reads them like any
            // other local.
            var i: i32 = len(c.args) - 1;
            while (i >= 0) {
                s = emit_expr(c.args[i], s);
                i = i - 1;
            }
            s = s.write("    call __fn_" + sanitize_label(name) + "\n");
            // Caller cleans up stack args (System V style for
            // pure-stack args; we don't use the register-arg
            // path of the standard SysV ABI).
            if (len(c.args) > 0) {
                s = s.write("    addq $" + i32_to_string(len(c.args) * 8) + ", %rsp\n");
            }
            // Result is in %rax — push for the surrounding
            // expression's stack-machine semantics.
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprTuple(t) => {
            // Layout: [val0, val1, …, val_(N-1)] — no shape
            // pointer because tuple field access uses the
            // numeric `.0` / `.1` / … spelling, and the offset
            // is known at the access site without runtime
            // dispatch.
            //
            // Steps:
            //   1. Compile each element in source order
            //      (push N values onto the rt-stack).
            //   2. Allocate N*8 bytes on the heap.
            //   3. Pop each element from the rt-stack into
            //      [%rax + i*8] — descending i so the top-of-
            //      stack lands in the LAST slot.
            //   4. Push %rax (the tuple pointer).
            var n_elems: i32 = len(t.elements);
            var ti: i32 = 0;
            while (ti < n_elems) {
                s = emit_expr(t.elements[ti], s);
                ti = ti + 1;
            }
            var t_bytes: i32 = n_elems * 8;
            if (n_elems == 0) { t_bytes = 8; }
            s = s.write("    movq $" + i32_to_string(t_bytes) + ", %rdi\n");
            s = s.write("    call __lang_alloc\n");
            s = s.mark_heap();
            var tj: i32 = n_elems - 1;
            while (tj >= 0) {
                s = s.write("    popq %rcx\n");
                s = s.write("    movq %rcx, " + i32_to_string(tj * 8) + "(%rax)\n");
                tj = tj - 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprArray(a) => {
            // Layout: [len: 8 bytes, val0, val1, …, val_(N-1)].
            // The length prefix lets `len(a)` lower to a single
            // load at offset 0 without dragging type info
            // through the backend. ExprIndex shifts the index
            // by +1 slot to skip the prefix.
            //
            // Steps:
            //   1. Compile each element in source order
            //      (push N values onto the rt-stack).
            //   2. Allocate (N+1)*8 bytes on the heap.
            //   3. Store the length at [%rax + 0].
            //   4. Pop each element from the rt-stack into
            //      [%rax + (i+1)*8] — descending i so the
            //      top-of-stack lands in the LAST slot.
            //   5. Push %rax (the array pointer).
            var n_elems: i32 = len(a.elements);
            var ai: i32 = 0;
            while (ai < n_elems) {
                s = emit_expr(a.elements[ai], s);
                ai = ai + 1;
            }
            var a_bytes: i32 = (n_elems + 1) * 8;
            s = s.write("    movq $" + i32_to_string(a_bytes) + ", %rdi\n");
            s = s.write("    call __lang_alloc\n");
            s = s.mark_heap();
            s = s.write("    movq $" + i32_to_string(n_elems) + ", %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            var aj: i32 = n_elems - 1;
            while (aj >= 0) {
                s = s.write("    popq %rcx\n");
                s = s.write("    movq %rcx, " + i32_to_string((aj + 1) * 8) + "(%rax)\n");
                aj = aj - 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprIndex(x) => {
            // Lowering: compile array → push ptr; compile index
            // → push i32; pop i32 into %rcx, pop ptr into %rax,
            // load [%rax + (rcx+1)*8] into %rax, push.
            //
            // No bounds check in this first cut — out-of-range
            // produces undefined data, matching the wasm
            // backend's i32[] semantics today.
            s = emit_expr(x.array, s);
            s = emit_expr(x.index, s);
            s = s.write("    popq %rcx\n");
            s = s.write("    popq %rax\n");
            s = s.write("    incq %rcx\n");
            s = s.write("    movq (%rax,%rcx,8), %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprSlice(_) => {
            s = s.write("    # unsupported: slice\n");
            s = s.write("    pushq $0\n");
            return s;
        },
        parser.ExprStructLit(sl) => {
            // Layout: [shape_ptr, val0, val1, …, val_(N-1)].
            // The shape pointer is the interned struct-name
            // string in .rodata — string-pointer equality is
            // enough to identify the struct type at runtime.
            //
            // Steps:
            //   1. Compile each field value in source order
            //      (push N values onto the rt-stack).
            //   2. Allocate (N+1)*8 bytes on the heap.
            //   3. Store the shape pointer at [%rax + 0].
            //   4. Pop each field value from the rt-stack into
            //      [%rax + (i+1)*8] — descending i so the
            //      top-of-stack lands in the LAST field slot.
            //   5. Push %rax (the struct pointer).
            var n_fields: i32 = len(sl.field_values);
            var i: i32 = 0;
            while (i < n_fields) {
                s = emit_expr(sl.field_values[i], s);
                i = i + 1;
            }
            var slot_bytes: i32 = (n_fields + 1) * 8;
            s = s.write("    movq $" + i32_to_string(slot_bytes) + ", %rdi\n");
            s = s.write("    call __lang_alloc\n");
            s = s.mark_heap();
            // Intern the struct name string in .rodata.
            var nameLit: StringLitOut = add_string_lit(s, sl.type_name);
            s = nameLit.state;
            s = s.write("    leaq .S" + i32_to_string(nameLit.idx) + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            // Pop fields off the rt-stack into the struct.
            var j: i32 = n_fields - 1;
            while (j >= 0) {
                s = s.write("    popq %rcx\n");
                s = s.write("    movq %rcx, " + i32_to_string((j + 1) * 8) + "(%rax)\n");
                j = j - 1;
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprFieldAccess(fa) => {
            // Numeric field name (`.0` / `.1` / …) → tuple
            // access. Tuples are laid out without a shape
            // pointer, so the offset is just idx*8 from the
            // box pointer. No runtime dispatch needed.
            if (is_all_digits(fa.field)) {
                var tup_idx: i32 = digits_to_i32(fa.field);
                s = emit_expr(fa.obj, s);
                s = s.write("    popq %rax\n");
                s = s.write("    movq " + i32_to_string(tup_idx * 8) + "(%rax), %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            // Lowering: compile the receiver expression, pop
            // the struct pointer into %rax, dispatch on the
            // shape pointer at [%rax + 0]. For each struct
            // decl in mod.structs that contains a field with
            // this name, emit a "if shape matches → load at
            // compile-time offset" arm. Falls through to a
            // sentinel (-1) if no match.
            s = emit_expr(fa.obj, s);
            s = s.write("    popq %rax\n");
            // Use the label counter for end-of-dispatch label.
            var end_lbl: i32 = s.label_n;
            s = EmitState {
                out: s.out,
                label_n: s.label_n + 1,
                local_names: s.local_names,
                in_function: s.in_function,
                string_lits: s.string_lits,
                needs_print_int: s.needs_print_int,
                needs_read_int: s.needs_read_int,
                needs_heap: s.needs_heap,
                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels,
                funcs: s.funcs
            };
            // Walk each struct decl looking for the named
            // field. Emit a shape-pointer comparison arm for
            // each match.
            var di: i32 = 0;
            while (di < len(s.struct_decls)) {
                var sd: parser.StructDecl = s.struct_decls[di];
                var fi: i32 = 0;
                var found_idx: i32 = 0 - 1;
                while (fi < len(sd.fields)) {
                    if (sd.fields[fi].name == fa.field) { found_idx = fi; }
                    fi = fi + 1;
                }
                if (found_idx >= 0) {
                    var arm_lit: StringLitOut = add_string_lit(s, sd.name);
                    s = arm_lit.state;
                    s = s.write("    movq (%rax), %rcx\n");
                    s = s.write("    leaq .S" + i32_to_string(arm_lit.idx) + "(%rip), %rdx\n");
                    s = s.write("    cmpq %rdx, %rcx\n");
                    s = s.write("    jne .Lfa_next_" + i32_to_string(s.label_n) + "\n");
                    s = s.write("    movq " + i32_to_string((found_idx + 1) * 8) + "(%rax), %rax\n");
                    s = s.write("    pushq %rax\n");
                    s = s.write("    jmp .Lfa_end_" + i32_to_string(end_lbl) + "\n");
                    s = s.write(".Lfa_next_" + i32_to_string(s.label_n) + ":\n");
                    s = EmitState {
                        out: s.out,
                        label_n: s.label_n + 1,
                        local_names: s.local_names,
                        in_function: s.in_function,
                        string_lits: s.string_lits,
                        needs_print_int: s.needs_print_int,
                        needs_read_int: s.needs_read_int,
                        needs_heap: s.needs_heap,
                        struct_decls: s.struct_decls,
                        loop_exit_labels: s.loop_exit_labels,
                        loop_cont_labels: s.loop_cont_labels,
                        funcs: s.funcs
                    };
                }
                di = di + 1;
            }
            // No-shape-matched fallthrough: push sentinel -1.
            s = s.write("    movq $-1, %rax\n");
            s = s.write("    pushq %rax\n");
            s = s.write(".Lfa_end_" + i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.ExprLambda(lm) => {
            // Lowering (capture-less first cut, matching the
            // vm.lang and the early VM port):
            //   jmp .Lskip_lambda_N
            //   .Llambda_N:
            //       <function-style prologue + params + body +
            //        fallback epilogue>
            //   .Lskip_lambda_N:
            //   leaq .Llambda_N(%rip), %rax
            //   pushq %rax
            //
            // The pushed value is the lambda's entry address.
            // ExprCall on a local ident loads this and emits an
            // indirect `call *%rax`. Captures aren't handled
            // yet — a follow-up can box (fn_addr, captures) and
            // pass the box ptr as a hidden first arg, mirroring
            // the vm.lang OpMakeClosure path.
            var lam_id: i32 = s.label_n;
            s = EmitState {
                out: s.out,
                label_n: s.label_n + 2,
                local_names: s.local_names,
                in_function: s.in_function,
                string_lits: s.string_lits,
                needs_print_int: s.needs_print_int,
                needs_read_int: s.needs_read_int,
                needs_heap: s.needs_heap,
                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels,
                funcs: s.funcs
            };
            var skip_lbl: string = ".Lskip_lambda_" + i32_to_string(lam_id);
            var body_lbl: string = ".Llambda_" + i32_to_string(lam_id);
            s = s.write("    jmp " + skip_lbl + "\n");
            s = s.write(body_lbl + ":\n");
            s = s.write("    pushq %rbp\n");
            s = s.write("    movq %rsp, %rbp\n");
            // Body locals: params + inner var declarations.
            var saved_locals: string[] = s.local_names;
            var saved_in_function: boolean = s.in_function;
            var argc_l: i32 = len(lm.params);
            var n_body_locals_l: i32 = count_locals(lm.body);
            var total_locals_l: i32 = argc_l + n_body_locals_l;
            if (total_locals_l > 0) {
                var bytes_l: i32 = total_locals_l * 8;
                if (bytes_l % 16 != 0) { bytes_l = bytes_l + 8; }
                s = s.write("    subq $" + i32_to_string(bytes_l) + ", %rsp\n");
            }
            s = s.reset_locals();
            s = s.enter_function();
            var pi: i32 = 0;
            while (pi < argc_l) {
                s = s.bind_local(lm.params[pi].name);
                var p_off: i32 = s.lookup_local(lm.params[pi].name);
                var a_off: i32 = 16 + pi * 8;
                s = s.write("    movq " + i32_to_string(a_off) + "(%rbp), %rax\n");
                s = s.write("    movq %rax, " + i32_to_string(p_off) + "(%rbp) # param " + lm.params[pi].name + "\n");
                pi = pi + 1;
            }
            var bi_l: i32 = 0;
            while (bi_l < len(lm.body)) {
                s = emit_stmt(lm.body[bi_l], s);
                bi_l = bi_l + 1;
            }
            // Fallback implicit return 0.
            s = s.write("    movq $0, %rax\n");
            s = s.write("    leave\n");
            s = s.write("    ret\n");
            // Restore outer scope's locals + in_function flag.
            s = EmitState {
                out: s.out,
                label_n: s.label_n,
                local_names: saved_locals,
                in_function: saved_in_function,
                string_lits: s.string_lits,
                needs_print_int: s.needs_print_int,
                needs_read_int: s.needs_read_int,
                needs_heap: s.needs_heap,
                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels,
                funcs: s.funcs
            };
            s = s.write(skip_lbl + ":\n");
            s = s.write("    leaq " + body_lbl + "(%rip), %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprUnknown(_) => {
            s = s.write("    # parser-side unknown\n");
            s = s.write("    pushq $0\n");
            return s;
        }
    }
    return s;
}

function emit_block(body: parser.Stmt[], s: EmitState): EmitState {
    var i: i32 = 0;
    while (i < len(body)) {
        s = emit_stmt(body[i], s);
        i = i + 1;
    }
    return s;
}

function emit_stmt(stmt: parser.Stmt, s: EmitState): EmitState {
    match (stmt) {
        parser.StmtReturn(r) => {
            s = emit_expr(r.value, s);
            if (s.in_function) {
                // Function return: result in %rax, restore
                // caller's frame, ret.
                s = s.write("    popq %rax\n");
                s = s.write("    leave\n");
                s = s.write("    ret\n");
            } else {
                // Top-level return: lower to sys_exit_group so
                // the program terminates with the right exit
                // code.
                s = s.write("    popq %rdi\n");
                s = s.write("    movq $60, %rax\n");
                s = s.write("    syscall\n");
            }
            return s;
        },
        parser.StmtIf(ifs) => {
            // if/else lowers to:
            //   <cond>; popq %rax; cmpq $0, %rax; je <else_lbl>
            //   <then-body>; jmp <end_lbl>
            // <else_lbl>: <else-body>; <end_lbl>:
            // No-else uses a single label = end of then.
            s = emit_expr(ifs.cond, s);
            s = s.write("    popq %rax\n");
            s = s.write("    cmpq $0, %rax\n");
            var else_l: LabelOut = fresh_label(s);
            s = else_l.state;
            s = s.write("    je " + else_l.name + "\n");
            s = emit_block(ifs.then_body, s);
            if (len(ifs.else_body) > 0) {
                var end_l: LabelOut = fresh_label(s);
                s = end_l.state;
                s = s.write("    jmp " + end_l.name + "\n");
                s = s.write(else_l.name + ":\n");
                s = emit_block(ifs.else_body, s);
                s = s.write(end_l.name + ":\n");
            } else {
                s = s.write(else_l.name + ":\n");
            }
            return s;
        },
        parser.StmtWhile(w) => {
            // while lowers to:
            // <top_lbl>: <cond>; popq %rax; cmpq $0, %rax;
            //            je <exit_lbl>
            //            <body>; jmp <top_lbl>
            // <exit_lbl>:
            //
            // break inside the body jumps to <exit_lbl>;
            // continue jumps to <top_lbl> (re-evaluate cond).
            var top_l: LabelOut = fresh_label(s);
            s = top_l.state;
            var exit_l: LabelOut = fresh_label(s);
            s = exit_l.state;
            s = s.write(top_l.name + ":\n");
            s = emit_expr(w.cond, s);
            s = s.write("    popq %rax\n");
            s = s.write("    cmpq $0, %rax\n");
            s = s.write("    je " + exit_l.name + "\n");
            s = s.push_loop_labels(exit_l.name, top_l.name);
            s = emit_block(w.body, s);
            s = s.pop_loop_labels();
            s = s.write("    jmp " + top_l.name + "\n");
            s = s.write(exit_l.name + ":\n");
            return s;
        },
        parser.StmtVar(v) => {
            // Compile init, then pop to the new local's slot.
            // bind_local first so lookup_local resolves to the
            // correct offset on the right-hand side.
            s = emit_expr(v.init, s);
            s = s.bind_local(v.name);
            var off: i32 = s.lookup_local(v.name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(off) + "(%rbp)\n");
            return s;
        },
        parser.StmtAssign(a) => {
            if (!s.has_local(a.target)) {
                s = s.write("    # unresolved assign: " + a.target + "\n");
                return s;
            }
            s = emit_expr(a.value, s);
            var off: i32 = s.lookup_local(a.target);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(off) + "(%rbp)\n");
            return s;
        },
        parser.StmtExpr(x) => {
            // Evaluate for side effects, drop the result.
            s = emit_expr(x.value, s);
            s = s.write("    popq %rax\n");
            return s;
        },
        parser.StmtMatch(m) => {
            // Lowering: eval the scrutinee, save into a fresh
            // local slot (so each arm can reload it without
            // worrying about %rax being clobbered by inner ops).
            // Then for each arm, emit:
            //   PatVariant: load shape ptr, compare to interned
            //   struct name, jump to next arm on mismatch. On
            //   match, bind `binding` to the scrutinee value
            //   (if non-empty), execute body, jump to end.
            //   PatWildcard: always match, no dispatch.
            // No exhaustiveness check — that's the checker's job.
            s = emit_expr(m.scrutinee, s);
            // Allocate the synthetic scrutinee slot.
            var scrut_name: string = "__match_scrut_" + i32_to_string(s.label_n);
            s = s.bind_local(scrut_name);
            var scrut_off: i32 = s.lookup_local(scrut_name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(scrut_off) + "(%rbp)\n");
            // Bump the label counter for end-of-match.
            var end_lbl: i32 = s.label_n;
            s = EmitState {
                out: s.out,
                label_n: s.label_n + 1,
                local_names: s.local_names,
                in_function: s.in_function,
                string_lits: s.string_lits,
                needs_print_int: s.needs_print_int,
                needs_read_int: s.needs_read_int,
                needs_heap: s.needs_heap,
                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels,
                funcs: s.funcs
            };
            var ai: i32 = 0;
            while (ai < len(m.arms)) {
                var arm: parser.MatchArm = m.arms[ai];
                var next_lbl: i32 = s.label_n;
                s = EmitState {
                    out: s.out,
                    label_n: s.label_n + 1,
                    local_names: s.local_names,
                    in_function: s.in_function,
                    string_lits: s.string_lits,
                    needs_print_int: s.needs_print_int,
                    needs_read_int: s.needs_read_int,
                    needs_heap: s.needs_heap,
                    struct_decls: s.struct_decls,
                    loop_exit_labels: s.loop_exit_labels,
                    loop_cont_labels: s.loop_cont_labels,
                    funcs: s.funcs
                };
                match (arm.pattern) {
                    parser.PatVariant(pv) => {
                        // Shape-pointer compare against pv.type_name.
                        s = s.write("    movq " + i32_to_string(scrut_off) + "(%rbp), %rax\n");
                        s = s.write("    movq (%rax), %rcx\n");
                        var nameLit: StringLitOut = add_string_lit(s, pv.type_name);
                        s = nameLit.state;
                        s = s.write("    leaq .S" + i32_to_string(nameLit.idx) + "(%rip), %rdx\n");
                        s = s.write("    cmpq %rdx, %rcx\n");
                        s = s.write("    jne .Lmatch_next_" + i32_to_string(next_lbl) + "\n");
                        // Match: bind variable if non-empty.
                        if (len(pv.binding) > 0 && pv.binding != "_") {
                            s = s.bind_local(pv.binding);
                            var bind_off: i32 = s.lookup_local(pv.binding);
                            s = s.write("    movq %rax, " + i32_to_string(bind_off) + "(%rbp)\n");
                        }
                    },
                    parser.PatWildcard(_) => {
                        // Wildcard always matches — no dispatch.
                    }
                }
                // Emit the arm body.
                var bi: i32 = 0;
                while (bi < len(arm.body)) {
                    s = emit_stmt(arm.body[bi], s);
                    bi = bi + 1;
                }
                s = s.write("    jmp .Lmatch_end_" + i32_to_string(end_lbl) + "\n");
                s = s.write(".Lmatch_next_" + i32_to_string(next_lbl) + ":\n");
                ai = ai + 1;
            }
            s = s.write(".Lmatch_end_" + i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtFor(f) => {
            // Lowering desugar: `for x in arr { body }`
            //   var __for_arr_N = arr;
            //   var __for_i_N = 0;
            //   while (__for_i_N < len(__for_arr_N)) {
            //       var x = __for_arr_N[__for_i_N];
            //       body;
            //       __for_i_N = __for_i_N + 1;
            //   }
            //
            // Allocate three synthetic locals (array ptr, index,
            // element var). The index lives in a slot so the
            // body can read it for diagnostics; the iter
            // expression is hoisted into a slot so it isn't re-
            // evaluated each iteration (mirrors how `for` works
            // in higher-level languages — the iterator is
            // resolved once).
            s = emit_expr(f.iter, s);
            var arr_name: string = "__for_arr_" + i32_to_string(s.label_n);
            s = s.bind_local(arr_name);
            var arr_off: i32 = s.lookup_local(arr_name);
            s = s.write("    popq %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(arr_off) + "(%rbp)\n");
            var idx_name: string = "__for_i_" + i32_to_string(s.label_n);
            s = s.bind_local(idx_name);
            var idx_off: i32 = s.lookup_local(idx_name);
            s = s.write("    movq $0, " + i32_to_string(idx_off) + "(%rbp)\n");
            s = s.bind_local(f.var_name);
            var elem_off: i32 = s.lookup_local(f.var_name);
            // Loop labels: top (cond), cont (i++), end (exit).
            var top_lbl: i32 = s.label_n;
            var cont_lbl: i32 = s.label_n + 1;
            var end_lbl: i32 = s.label_n + 2;
            s = EmitState {
                out: s.out,
                label_n: s.label_n + 3,
                local_names: s.local_names,
                in_function: s.in_function,
                string_lits: s.string_lits,
                needs_print_int: s.needs_print_int,
                needs_read_int: s.needs_read_int,
                needs_heap: s.needs_heap,
                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels,
                funcs: s.funcs
            };
            s = s.write(".Lfor_top_" + i32_to_string(top_lbl) + ":\n");
            // Condition: __for_i_N < len(__for_arr_N).
            s = s.write("    movq " + i32_to_string(arr_off) + "(%rbp), %rax\n");
            s = s.write("    movq (%rax), %rcx\n");        // length
            s = s.write("    movq " + i32_to_string(idx_off) + "(%rbp), %rdx\n");
            s = s.write("    cmpq %rcx, %rdx\n");
            s = s.write("    jge .Lfor_end_" + i32_to_string(end_lbl) + "\n");
            // Bind element: x = arr[i].
            s = s.write("    movq " + i32_to_string(arr_off) + "(%rbp), %rax\n");
            s = s.write("    movq " + i32_to_string(idx_off) + "(%rbp), %rcx\n");
            s = s.write("    incq %rcx\n");
            s = s.write("    movq (%rax,%rcx,8), %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(elem_off) + "(%rbp)\n");
            // Body — break jumps to .Lfor_end; continue jumps
            // to .Lfor_cont (the i++ block) so the loop still
            // advances.
            s = s.push_loop_labels(".Lfor_end_" + i32_to_string(end_lbl), ".Lfor_cont_" + i32_to_string(cont_lbl));
            var bi: i32 = 0;
            while (bi < len(f.body)) {
                s = emit_stmt(f.body[bi], s);
                bi = bi + 1;
            }
            s = s.pop_loop_labels();
            // i = i + 1; jump to top.
            s = s.write(".Lfor_cont_" + i32_to_string(cont_lbl) + ":\n");
            s = s.write("    movq " + i32_to_string(idx_off) + "(%rbp), %rax\n");
            s = s.write("    incq %rax\n");
            s = s.write("    movq %rax, " + i32_to_string(idx_off) + "(%rbp)\n");
            s = s.write("    jmp .Lfor_top_" + i32_to_string(top_lbl) + "\n");
            s = s.write(".Lfor_end_" + i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtBreak(_) => {
            var lbl: string = s.top_loop_exit();
            if (len(lbl) == 0) { return s.write("    # break outside loop\n"); }
            return s.write("    jmp " + lbl + "\n");
        },
        parser.StmtContinue(_) => {
            var lbl: string = s.top_loop_cont();
            if (len(lbl) == 0) { return s.write("    # continue outside loop\n"); }
            return s.write("    jmp " + lbl + "\n");
        },
        parser.StmtUnknown(_) => { return s.write("    # unsupported: StmtUnknown\n"); }
    }
    return s;
}

// emit_module produces the full assembly text. Top-level stmts
// are emitted in order under `_start`. The Linux runtime calls
// `_start` first; sys_exit_group terminates the process with
// the exit code in %rdi.
// emit_function emits a single FuncDecl as a `__fn_<name>:`
// label with prologue, body, and (fallback) epilogue. Params
// arrive on the stack at +16(%rbp), +24(%rbp), … (caller
// pushed right-to-left, so param[0] is closest to the return
// address); the prologue copies them into the function's
// own local slots so the body reads them uniformly.
function emit_function(fd: parser.FuncDecl, s: EmitState): EmitState {
    // Methods get `__fn_<RecvType>__<method>:` so multiple
    // structs can have the same method name without colliding.
    // Plain funcs keep `__fn_<name>:` for source compat with the
    // earlier slices' call emitters.
    var label_name: string = fd.name;
    if (len(fd.receiver_type) > 0) {
        label_name = fd.receiver_type + "." + fd.name;
    }
    s = s.write("__fn_" + sanitize_label(label_name) + ":\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    var has_recv: boolean = len(fd.receiver_name) > 0;
    var argc: i32 = len(fd.params);
    if (has_recv) { argc = argc + 1; }
    var n_body_locals: i32 = count_locals(fd.body);
    var total_locals: i32 = argc + n_body_locals;
    if (total_locals > 0) {
        var bytes: i32 = total_locals * 8;
        if (bytes % 16 != 0) { bytes = bytes + 8; }
        s = s.write("    subq $" + i32_to_string(bytes) + ", %rsp\n");
    }
    // Fresh locals table for this function's scope; keep the
    // monotonic label_n + in_function flag.
    s = s.reset_locals();
    s = s.enter_function();
    // For methods, bind receiver first so it occupies local
    // slot 0 (at -8(%rbp)) and reads from +16(%rbp).
    if (has_recv) {
        s = s.bind_local(fd.receiver_name);
        var recv_off: i32 = s.lookup_local(fd.receiver_name);
        s = s.write("    movq 16(%rbp), %rax\n");
        s = s.write("    movq %rax, " + i32_to_string(recv_off) + "(%rbp) # recv " + fd.receiver_name + "\n");
    }
    // Bind params + copy from caller-stack offsets into local
    // slots. param[i] sits at +(16 + (i + recv_shift)*8)(%rbp).
    var recv_shift: i32 = 0;
    if (has_recv) { recv_shift = 1; }
    var n_params: i32 = len(fd.params);
    var i: i32 = 0;
    while (i < n_params) {
        s = s.bind_local(fd.params[i].name);
        var local_off: i32 = s.lookup_local(fd.params[i].name);
        var arg_off: i32 = 16 + (i + recv_shift) * 8;
        s = s.write("    movq " + i32_to_string(arg_off) + "(%rbp), %rax\n");
        s = s.write("    movq %rax, " + i32_to_string(local_off) + "(%rbp) # param " + fd.params[i].name + "\n");
        i = i + 1;
    }
    // Body. Any StmtReturn inside lowers to leave + ret
    // (because in_function is set).
    var bi: i32 = 0;
    while (bi < len(fd.body)) {
        s = emit_stmt(fd.body[bi], s);
        bi = bi + 1;
    }
    // Fallback: implicit `return 0;` so falling off the end
    // doesn't run into the next function's label.
    s = s.write("    movq $0, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    s = s.leave_function();
    s = s.reset_locals();
    return s;
}

// has_main returns true if any FuncDecl in mod is named `main`.
function has_main(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < len(mod.funcs)) {
        if (mod.funcs[i].name == "main") { return true; }
        i = i + 1;
    }
    return false;
}

// escape_for_ascii rewrites a string for `.ascii "…"` syntax:
// quotes get backslashed, backslashes doubled, newlines become
// the literal escape sequence so GAS treats them as the byte.
function escape_for_ascii(s: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < len(s)) {
        var b: i32 = s[i];
        if (b == 34) { out = out + "\\\""; }
        else if (b == 92) { out = out + "\\\\"; }
        else if (b == 10) { out = out + "\\n"; }
        else if (b == 9) { out = out + "\\t"; }
        else if (b == 13) { out = out + "\\r"; }
        else { out = out + s[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

pub function emit_module(mod: parser.Module): string {
    var s: EmitState = new_state();
    // Seed the struct-decl table so emit_expr's ExprStructLit
    // / ExprFieldAccess paths can look up field layout.
    s = EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: mod.structs,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: mod.funcs
    };
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    // Emit each function body first. Each gets its own label
    // (__fn_<name>:); _start dispatches into main() if it
    // exists.
    var fi: i32 = 0;
    while (fi < len(mod.funcs)) {
        s = emit_function(mod.funcs[fi], s);
        fi = fi + 1;
    }
    // _start: program entry point. If main() exists, call it
    // and use its return value as the exit code. Otherwise
    // run top-level stmts directly.
    s = s.write("_start:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    if (has_main(mod)) {
        // call __fn_main; exit with %rax.
        s = s.write("    call __fn_main\n");
        s = s.write("    movq %rax, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    } else {
        var n_locals: i32 = count_locals(mod.top_stmts);
        if (n_locals > 0) {
            var bytes: i32 = n_locals * 8;
            if (bytes % 16 != 0) { bytes = bytes + 8; }
            s = s.write("    subq $" + i32_to_string(bytes) + ", %rsp\n");
        }
        var i: i32 = 0;
        while (i < len(mod.top_stmts)) {
            s = emit_stmt(mod.top_stmts[i], s);
            i = i + 1;
        }
        // Fallback exit (in case there's no return).
        s = s.write("    movq $0, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    }
    // __lang_print_int helper: appended once at the end of the
    // .text section if any print_int call surfaced needs_print_int.
    // Converts the i64 in %rdi to decimal text in a stack buffer
    // and writes it to stdout. Handles zero, positive, and
    // negative values (prepending `-`).
    if (s.needs_print_int) {
        s = s.write("__lang_print_int:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    subq $32, %rsp\n");
        s = s.write("    movq %rdi, %rax\n");
        s = s.write("    movq $0, %r10\n");        // sign flag
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jge .Lpi_pos\n");
        s = s.write("    negq %rax\n");
        s = s.write("    movq $1, %r10\n");
        s = s.write(".Lpi_pos:\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Lpi_loop_start\n");
        s = s.write("    movb $48, -1(%rbp)\n");   // '0'
        s = s.write("    leaq -1(%rbp), %rsi\n");
        s = s.write("    movq $1, %rdx\n");
        s = s.write("    jmp .Lpi_write\n");
        s = s.write(".Lpi_loop_start:\n");
        s = s.write("    leaq -1(%rbp), %rsi\n");
        s = s.write("    movq $0, %r8\n");         // length
        s = s.write(".Lpi_div:\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rcx\n");
        s = s.write("    divq %rcx\n");            // rax/=10, rdx=remainder
        s = s.write("    addq $48, %rdx\n");
        s = s.write("    movb %dl, (%rsi)\n");
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Lpi_div\n");
        s = s.write("    cmpq $0, %r10\n");
        s = s.write("    je .Lpi_no_neg\n");
        s = s.write("    movb $45, (%rsi)\n");     // '-'
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write(".Lpi_no_neg:\n");
        s = s.write("    incq %rsi\n");
        s = s.write("    movq %r8, %rdx\n");
        s = s.write(".Lpi_write:\n");
        s = s.write("    movq $1, %rdi\n");
        s = s.write("    movq $1, %rax\n");        // sys_write
        s = s.write("    syscall\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // __lang_read_int helper: reads up to 16 bytes from stdin
    // into a stack buffer, then parses an optional leading `-`
    // followed by decimal digits. Returns the parsed value in
    // %rax. Stops at the first non-digit (including newline /
    // EOF). Skips leading whitespace not implemented — input
    // is expected to start with the digits / minus.
    if (s.needs_read_int) {
        s = s.write("__lang_read_int:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    subq $32, %rsp\n");
        s = s.write("    movq $0, %rdi\n");          // fd 0
        s = s.write("    leaq -16(%rbp), %rsi\n");
        s = s.write("    movq $16, %rdx\n");
        s = s.write("    movq $0, %rax\n");          // sys_read
        s = s.write("    syscall\n");
        s = s.write("    leaq -16(%rbp), %rcx\n");   // cursor
        s = s.write("    leaq -16(%rbp), %r8\n");    // end ptr
        s = s.write("    addq %rax, %r8\n");
        s = s.write("    movq $0, %r9\n");           // accumulator
        s = s.write("    movq $0, %r10\n");          // neg flag
        s = s.write("    cmpq %rcx, %r8\n");
        s = s.write("    je .Lri_done\n");
        s = s.write("    movzbq (%rcx), %rax\n");
        s = s.write("    cmpq $45, %rax\n");         // '-'
        s = s.write("    jne .Lri_loop\n");
        s = s.write("    movq $1, %r10\n");
        s = s.write("    incq %rcx\n");
        s = s.write(".Lri_loop:\n");
        s = s.write("    cmpq %rcx, %r8\n");
        s = s.write("    je .Lri_done\n");
        s = s.write("    movzbq (%rcx), %rax\n");
        s = s.write("    subq $48, %rax\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jl .Lri_done\n");
        s = s.write("    cmpq $9, %rax\n");
        s = s.write("    jg .Lri_done\n");
        s = s.write("    imulq $10, %r9\n");
        s = s.write("    addq %rax, %r9\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lri_loop\n");
        s = s.write(".Lri_done:\n");
        s = s.write("    cmpq $0, %r10\n");
        s = s.write("    je .Lri_no_neg\n");
        s = s.write("    negq %r9\n");
        s = s.write(".Lri_no_neg:\n");
        s = s.write("    movq %r9, %rax\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // .rodata: emit each interned string literal as a
    // labelled `.ascii` directive. GAS interprets the escape
    // sequences in the quoted string, so a `\n` byte in the
    // source string lands as a single LF in the resulting
    // .rodata bytes.
    if (len(s.string_lits) > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < len(s.string_lits)) {
            s = s.write(".S" + i32_to_string(li) + ": .ascii \"" + escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
    }
    // Heap allocator: a 1 MiB .bss buffer + bump pointer. The
    // pointer starts at `__lang_heap` and advances by `size`
    // each `__lang_alloc(size)` call. No deallocation — fine
    // for the small validation programs that exercise structs.
    if (s.needs_heap) {
        s = s.write("    .section .bss\n");
        s = s.write("    .align 8\n");
        s = s.write("__lang_heap_ptr: .quad 0\n");
        s = s.write("    .align 8\n");
        s = s.write("__lang_heap: .skip 1048576\n");
        s = s.write("    .section .text\n");
        s = s.write(".globl __lang_alloc\n");
        s = s.write(".type __lang_alloc, @function\n");
        s = s.write("__lang_alloc:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        // Initialise __lang_heap_ptr on first call (lazy).
        s = s.write("    movq __lang_heap_ptr(%rip), %rax\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Lalloc_inited\n");
        s = s.write("    leaq __lang_heap(%rip), %rax\n");
        s = s.write("    movq %rax, __lang_heap_ptr(%rip)\n");
        s = s.write(".Lalloc_inited:\n");
        // Result = current ptr; advance ptr by %rdi (the size).
        s = s.write("    movq __lang_heap_ptr(%rip), %rax\n");
        s = s.write("    addq %rax, %rdi\n");
        s = s.write("    movq %rdi, __lang_heap_ptr(%rip)\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
        s = s.write(".size __lang_alloc, .-__lang_alloc\n");
    }
    return s.out;
}

// =================== VALIDATION ====================

// contains: trivial substring search, same shape as the
// disasm validation harness.
function contains(haystack: string, needle: string): boolean {
    if (len(needle) == 0) { return true; }
    if (len(haystack) < len(needle)) { return false; }
    var i: i32 = 0;
    while (i <= len(haystack) - len(needle)) {
        if (haystack[i:i + len(needle)] == needle) { return true; }
        i = i + 1;
    }
    return false;
}

function emit_source(src: string): string {
    return emit_module(parser.parse_module(lexer.tokenize(src)));
}

function main(): i32 {
    // Minimal: `return 42;` should produce asm that contains the
    // literal `$42`, a `pushq` of it, the syscall epilogue with
    // `$60` (sys_exit_group), and `syscall`.
    var a1: string = emit_source("return 42;");
    if (!contains(a1, "movq $42")) { return 10; }
    if (!contains(a1, "pushq %rax")) { return 11; }
    if (!contains(a1, "popq %rdi")) { return 12; }
    if (!contains(a1, "movq $60, %rax")) { return 13; }
    if (!contains(a1, "syscall")) { return 14; }
    if (!contains(a1, ".globl _start")) { return 15; }

    // Arithmetic: `return 2 + 3;` should emit addq.
    var a2: string = emit_source("return 2 + 3;");
    if (!contains(a2, "movq $2")) { return 20; }
    if (!contains(a2, "movq $3")) { return 21; }
    if (!contains(a2, "addq")) { return 22; }

    // Subtraction.
    var a3: string = emit_source("return 7 - 4;");
    if (!contains(a3, "subq")) { return 30; }

    // Multiplication.
    var a4: string = emit_source("return 6 * 7;");
    if (!contains(a4, "imulq")) { return 40; }

    // Division — emits cqto for sign-extension + idivq.
    var a5: string = emit_source("return 20 / 4;");
    if (!contains(a5, "cqto")) { return 50; }
    if (!contains(a5, "idivq")) { return 51; }

    // Modulo — moves remainder from rdx into rax.
    var a6: string = emit_source("return 23 % 5;");
    if (!contains(a6, "cqto")) { return 60; }
    if (!contains(a6, "idivq")) { return 61; }
    if (!contains(a6, "movq %rdx, %rax")) { return 62; }

    // Unary negation.
    var a7: string = emit_source("return -5;");
    if (!contains(a7, "negq")) { return 70; }

    // Nested expressions: `return (2 + 3) * 4;` — should have
    // an addq before the imulq (left subtree fully emitted
    // first).
    var a8: string = emit_source("return (2 + 3) * 4;");
    if (!contains(a8, "addq")) { return 80; }
    if (!contains(a8, "imulq")) { return 81; }

    // Comparisons: each op emits `cmpq` + the matching setcc +
    // a movzbq zero-extension. Result is a 0 or 1 on the rt
    // stack, suitable as an i32 exit code.
    var a9: string = emit_source("return 5 < 10;");
    if (!contains(a9, "cmpq")) { return 90; }
    if (!contains(a9, "setl")) { return 91; }
    if (!contains(a9, "movzbq")) { return 92; }

    var a10: string = emit_source("return 5 <= 5;");
    if (!contains(a10, "setle")) { return 100; }

    var a11: string = emit_source("return 7 > 3;");
    if (!contains(a11, "setg")) { return 110; }

    var a12: string = emit_source("return 7 >= 7;");
    if (!contains(a12, "setge")) { return 120; }

    var a13: string = emit_source("return 4 == 4;");
    if (!contains(a13, "sete")) { return 130; }

    var a14: string = emit_source("return 4 != 5;");
    if (!contains(a14, "setne")) { return 140; }

    // If/else: emits `cmpq $0`, `je .L0`, the then-block, `jmp
    // .L1`, `.L0:`, the else-block, `.L1:`.
    var a15: string = emit_source("if (true) { return 1; } else { return 2; }");
    if (!contains(a15, "cmpq $0")) { return 150; }
    if (!contains(a15, "je .L")) { return 151; }
    if (!contains(a15, "jmp .L")) { return 152; }
    if (!contains(a15, ".L0:")) { return 153; }
    if (!contains(a15, ".L1:")) { return 154; }

    // No-else if: only the cond-fail jump label, no second jmp.
    var a16: string = emit_source("if (true) { return 1; } return 0;");
    if (!contains(a16, "cmpq $0")) { return 160; }
    if (!contains(a16, "je .L")) { return 161; }

    // While: emits top label, cond, je exit, body, jmp top,
    // exit label.
    var a17: string = emit_source("while (1 < 2) { return 0; }");
    if (!contains(a17, "cmpq $0")) { return 170; }
    if (!contains(a17, "je .L")) { return 171; }
    if (!contains(a17, "jmp .L")) { return 172; }

    // Locals: frame prologue + slot store + slot load. `var x =
    // 5; return x;` should pushq %rbp, subq the frame, then
    // movq the literal into -8(%rbp), then pushq from -8(%rbp).
    var a18: string = emit_source("var x = 5; return x;");
    if (!contains(a18, "pushq %rbp")) { return 180; }
    if (!contains(a18, "movq %rsp, %rbp")) { return 181; }
    if (!contains(a18, "subq $")) { return 182; }
    if (!contains(a18, "movq %rax, -8(%rbp)")) { return 183; }
    if (!contains(a18, "pushq -8(%rbp)")) { return 184; }

    // Multiple locals get distinct slots: -8, -16, -24, ...
    var a19: string = emit_source("var a = 1; var b = 2; var c = 3; return c;");
    if (!contains(a19, "movq %rax, -8(%rbp)")) { return 190; }
    if (!contains(a19, "movq %rax, -16(%rbp)")) { return 191; }
    if (!contains(a19, "movq %rax, -24(%rbp)")) { return 192; }
    if (!contains(a19, "pushq -24(%rbp)")) { return 193; }

    // Re-assignment: `x = x + 1;` reads + writes the same slot.
    var a20: string = emit_source("var x = 5; x = x + 1; return x;");
    if (!contains(a20, "pushq -8(%rbp)")) { return 200; }
    if (!contains(a20, "movq %rax, -8(%rbp)")) { return 201; }
    if (!contains(a20, "addq")) { return 202; }

    // Compound assign desugars: `x += 1` → `x = x + 1` so the
    // asm shape is identical.
    var a21: string = emit_source("var x = 0; x += 7; return x;");
    if (!contains(a21, "addq")) { return 210; }
    if (!contains(a21, "movq %rax, -8(%rbp)")) { return 211; }

    // Counter loop: `var i = 0; while (i < 3) { i = i + 1; }
    // return i;` exercises locals + branches together.
    var a22: string = emit_source(
        "var i = 0; while (i < 3) { i = i + 1; } return i;"
    );
    if (!contains(a22, "pushq -8(%rbp)")) { return 220; }
    if (!contains(a22, "je .L")) { return 221; }
    if (!contains(a22, "jmp .L")) { return 222; }

    // Function decl + call: emits __fn_add label, calls from
    // main, has leave + ret in the body, and _start calls
    // __fn_main.
    var a23: string = emit_source(
        "function add(x: i32, y: i32): i32 { return x + y; }"
        + " function main(): i32 { return add(2, 3); }"
    );
    if (!contains(a23, "__fn_add:")) { return 230; }
    if (!contains(a23, "__fn_main:")) { return 231; }
    if (!contains(a23, "call __fn_add")) { return 232; }
    if (!contains(a23, "call __fn_main")) { return 233; }
    if (!contains(a23, "leave")) { return 234; }
    if (!contains(a23, "ret\n")) { return 235; }

    // print("...") lowers to a write syscall + emits the
    // literal in .rodata at label .S0.
    var a24: string = emit_source("print(\"hi\\n\"); return 0;");
    if (!contains(a24, "leaq .S0(%rip)")) { return 240; }
    if (!contains(a24, "movq $1, %rdi")) { return 241; }
    if (!contains(a24, "movq $1, %rax")) { return 242; }  // sys_write
    if (!contains(a24, ".section .rodata")) { return 243; }
    if (!contains(a24, ".S0: .ascii")) { return 244; }
    if (!contains(a24, "hi")) { return 245; }

    // print_int(N) emits a call to the __lang_print_int helper,
    // which the module appends once at the end of .text.
    var a25: string = emit_source("print_int(42); return 0;");
    if (!contains(a25, "call __lang_print_int")) { return 250; }
    if (!contains(a25, "__lang_print_int:")) { return 251; }
    if (!contains(a25, ".Lpi_div:")) { return 252; }

    // read_int() emits a call to the __lang_read_int helper,
    // which the module appends once at the end of .text.
    var a26: string = emit_source("return read_int();");
    if (!contains(a26, "call __lang_read_int")) { return 260; }
    if (!contains(a26, "__lang_read_int:")) { return 261; }
    if (!contains(a26, ".Lri_loop:")) { return 262; }

    return 0;
}
