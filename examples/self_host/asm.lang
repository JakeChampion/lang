            var t_bytes: i32 = n_elems * 8;
            if (n_elems == 0) { t_bytes = 8; }
            s = s.write("    movq $" + i32_to_string(t_bytes) + ", %rdi\n");
            s = s.write("    call __lang_alloc\n");
            s = s.mark_heap();
            var tj: i32 = n_elems - 1;
            while (tj >= 0) {
                s = s.write("    popq %rcx\n");
                s = s.write("    movq %rcx, " + i32_to_string(tj * 8) + "(%rax)\n");
