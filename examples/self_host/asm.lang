// add_string_lit appends the literal to the pool and returns
// its index, used by the caller to emit `leaq .S<idx>(%rip), …`.
// The pool is materialised in .rodata at end-of-module.
struct StringLitOut { state: EmitState, idx: i32 }
function add_string_lit(s: EmitState, v: string): StringLitOut {
    // Dedup: if the same value has already been interned,
    // return its existing slot. This is load-bearing for the
    // shape-pointer dispatch in ExprFieldAccess + StmtMatch,
    // which compares the runtime shape ptr against a freshly-
    // interned struct-name string. Without dedup, the two
    // .S<N> labels resolve to different .rodata addresses and
    // string-pointer equality always fails.
    var i: i32 = 0;
    while (i < len(s.string_lits)) {
        if (s.string_lits[i] == v) {
            return StringLitOut { state: s, idx: i };
        }
        i = i + 1;
    }
    var idx: i32 = len(s.string_lits);
    var sl: string[] = s.string_lits.push(v);
    var ns: EmitState = EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: sl,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args
    };
    return StringLitOut { state: ns, idx: idx };
}

// lookup_local returns the byte offset off %rbp for `name`, or
// 0 if not found (callers should sanity-check via the parallel
// "is bound" path — emit_expr's ExprIdent arm surfaces a
// comment marker on miss).
function (s: EmitState) lookup_local(name: string): i32 {
    // Newest binding wins. Walk back-to-front so shadowing
    // resolves to the most-recent slot.
    var i: i32 = len(s.local_names) - 1;
    while (i >= 0) {
        if (s.local_names[i] == name) {
            return 0 - 8 * (i + 1);
        }
        i = i - 1;
    }
    return 0;
}

function (s: EmitState) has_local(name: string): boolean {
    var i: i32 = 0;
    while (i < len(s.local_names)) {
        if (s.local_names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// fresh_label hands out a unique label name (".L<n>") and
// returns the new state with label_n already bumped — so the
// caller can reuse `s` for subsequent emits without
// double-allocating.
struct LabelOut { state: EmitState, name: string }
function fresh_label(s: EmitState): LabelOut {
    var name: string = ".L" + i32_to_string(s.label_n);
    var ns: EmitState = EmitState {
        out: s.out,
        label_n: s.label_n + 1,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args
    };
    return LabelOut { state: ns, name: name };
}

// count_locals walks a stmt body recursively (into if / while
// bodies) to determine the total number of `var` decls. The
// result feeds the function-entry `subq $<N*8>, %rsp` so the
// frame has enough room for every local that might be live.
// Conservative: counts every var even if branches make them
// mutually exclusive at runtime — that's fine for stack
// allocation, and far simpler than a liveness analysis.
function count_locals(body: parser.Stmt[]): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < len(body)) {
        n = n + count_locals_in_stmt(body[i]);
        i = i + 1;
    }
    return n;
}

function count_locals_in_stmt(stmt: parser.Stmt): i32 {
    match (stmt) {
        parser.StmtVar(_) => { return 1; },
        parser.StmtIf(ifs) => { return count_locals(ifs.then_body) + count_locals(ifs.else_body); },
        parser.StmtWhile(w) => { return count_locals(w.body); },
        parser.StmtMatch(m) => {
            // +1 for the synthetic scrutinee local + one per
            // non-empty PatVariant binding + the recursive body
            // counts. Wildcard arms add no binding.
            var n: i32 = 1;
            var i: i32 = 0;
            while (i < len(m.arms)) {
                match (m.arms[i].pattern) {
                    parser.PatVariant(pv) => {
                        if (len(pv.binding) > 0 && pv.binding != "_") { n = n + 1; }
                    },
                    parser.PatWildcard(_) => { }
                }
                n = n + count_locals(m.arms[i].body);
                i = i + 1;
            }
            return n;
        },
        parser.StmtFor(f) => {
            // +1 for the synthetic array-pointer slot, +1 for
            // the loop counter, +1 for the bound element var,
            // + body locals.
            return 3 + count_locals(f.body);
        },
        _ => { return 0; }
    }
    return 0;
}

// =================== ASM EMITTER ====================

function emit_expr(e: parser.Expr, s: EmitState): EmitState {
    match (e) {
        parser.ExprNumber(n) => {
            s = s.write("    movq $" + n.text + ", %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprBinary(b) => {
            // String-aware dispatch: `s + t` where either side
            // is a string lowers to __lang_str_concat; `s == t`
            // / `s != t` for strings lowers to __lang_str_eq.
            // Type info comes from infer_expr_type on the
            // operands — that walks the AST + local_types.
            if (b.op == "+") {
                var lt: string = infer_expr_type(b.left, s);
                var rt: string = infer_expr_type(b.right, s);
                if (lt == "string" || rt == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");      // rhs
                    s = s.write("    popq %rdi\n");      // lhs
                    s = s.write("    call __lang_str_concat\n");
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_concat();
                    return s;
                }
            }
            if (b.op == "==" || b.op == "!=") {
                var elt: string = infer_expr_type(b.left, s);
                var ert: string = infer_expr_type(b.right, s);
                if (elt == "string" || ert == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");
                    s = s.write("    popq %rdi\n");
                    s = s.write("    call __lang_str_eq\n");
                    if (b.op == "!=") {
                        s = s.write("    xorq $1, %rax\n");
                    }
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_eq();
                    return s;
                }
            }
            // String ordering: route < / <= / > / >= for
            // string operands through __lang_str_cmp, then
            // compare its signed result against zero to derive
            // the bool.
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                var olt: string = infer_expr_type(b.left, s);
                var ort: string = infer_expr_type(b.right, s);
                if (olt == "string" || ort == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    popq %rsi\n");
                    s = s.write("    popq %rdi\n");
                    s = s.write("    call __lang_str_cmp\n");
                    s = s.write("    cmpq $0, %rax\n");
                    s = s.write("    movq $0, %rax\n");
                    if (b.op == "<") { s = s.write("    setl %al\n"); }
                    else if (b.op == "<=") { s = s.write("    setle %al\n"); }
                    else if (b.op == ">") { s = s.write("    setg %al\n"); }
                    else { s = s.write("    setge %al\n"); }
                    s = s.write("    movzbq %al, %rax\n");
                    s = s.write("    pushq %rax\n");
                    s = s.mark_str_cmp();
                    return s;
                }
            }
            // Short-circuit boolean ops. The right operand's
            // side effects must not run when the left already
            // decides the result. `&&` short-circuits on false
            // (left == 0 ⇒ result = 0); `||` short-circuits on
            // true (left != 0 ⇒ result = 1). Otherwise the
            // right operand becomes the result.
            if (b.op == "&&" || b.op == "||") {
                s = emit_expr(b.left, s);
                s = s.write("    popq %rax\n");
                s = s.write("    testq %rax, %rax\n");
                var short_l: LabelOut = fresh_label(s);
                s = short_l.state;
                var end_l: LabelOut = fresh_label(s);
                s = end_l.state;
                if (b.op == "&&") {
                    s = s.write("    jz " + short_l.name + "\n");
                } else {
                    s = s.write("    jnz " + short_l.name + "\n");
                }
                s = emit_expr(b.right, s);
                s = s.write("    popq %rax\n");
                s = s.write("    jmp " + end_l.name + "\n");
                s = s.write(short_l.name + ":\n");
                if (b.op == "&&") {
                    s = s.write("    movq $0, %rax\n");
                } else {
                    s = s.write("    movq $1, %rax\n");
                }
                s = s.write(end_l.name + ":\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = emit_expr(b.left, s);
            s = emit_expr(b.right, s);
            s = s.write("    popq %rcx\n");        // rhs
            s = s.write("    popq %rax\n");        // lhs
            if (b.op == "+") {
                s = s.write("    addq %rcx, %rax\n");
            } else if (b.op == "-") {
                s = s.write("    subq %rcx, %rax\n");
            } else if (b.op == "*") {
                s = s.write("    imulq %rcx, %rax\n");
            } else if (b.op == "/") {
                // idivq: dividend in rdx:rax (sign-extended via
                // cqto), divisor in operand. Result quotient in
                // rax, remainder in rdx.
                s = s.write("    cqto\n");
                s = s.write("    idivq %rcx\n");
            } else if (b.op == "%") {
                s = s.write("    cqto\n");
                s = s.write("    idivq %rcx\n");
                s = s.write("    movq %rdx, %rax\n");
            } else if (b.op == "<" || b.op == "<=" || b.op == ">"
                    || b.op == ">=" || b.op == "==" || b.op == "!=") {
                // Comparison: `cmpq rhs, lhs` sets flags from
                // (lhs - rhs); setcc materialises the bool in
                // %al, movzbq zero-extends into %rax so the
                // surrounding stack push gets a clean 0/1.
                s = s.write("    cmpq %rcx, %rax\n");
                var cc: string = "";
                if (b.op == "<") { cc = "setl"; }
                else if (b.op == "<=") { cc = "setle"; }
                else if (b.op == ">") { cc = "setg"; }
                else if (b.op == ">=") { cc = "setge"; }
                else if (b.op == "==") { cc = "sete"; }
                else { cc = "setne"; }
                s = s.write("    " + cc + " %al\n");
                s = s.write("    movzbq %al, %rax\n");
            } else {
                s = s.write("    # unsupported binop: " + b.op + "\n");
            }
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                s = s.write("    negq %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (u.op == "!") {
                // Boolean negation. Operand is in the
                // `{0, 1}` normal form maintained by every
                // bool-producing path (literal, comparison,
                // short-circuit, str_*), so XOR with 1 flips
                // it without needing to widen first.
                s = emit_expr(u.operand, s);
                s = s.write("    popq %rax\n");
                s = s.write("    xorq $1, %rax\n");
                s = s.write("    pushq %rax\n");
                return s;
            }
            s = s.write("    # unsupported unary: " + u.op + "\n");
            return s;
        },
        parser.ExprIdent(id) => {
            if (s.has_local(id.name)) {
                var off: i32 = s.lookup_local(id.name);
                s = s.write("    pushq " + i32_to_string(off) + "(%rbp)\n");
                return s;
            }
            s = s.write("    # unresolved ident: " + id.name + "\n");
            s = s.write("    pushq $0\n");
            return s;
        },
        parser.ExprBool(b) => {
            // Bool literal — encode as a 0/1 i32 so it can flow
            // through comparison-style consumers (e.g. an if
            // cond branching on `true`).
            var v: i32 = 0;
            if (b.value) { v = 1; }
            s = s.write("    movq $" + i32_to_string(v) + ", %rax\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprString(sv) => {
            // String literal lowering: intern the bytes in
            // .rodata, then allocate a 16-byte box on the heap
            // `[data_ptr: 8, len: 8]` and push the box pointer.
            // The box layout is shared with __lang_str_concat
            // / _eq / _slice / _print runtime helpers.
            var lo: StringLitOut = add_string_lit(s, sv.value);
            s = lo.state;
            s = s.write("    movq $16, %rdi\n");
            s = s.write("    call __lang_alloc\n");
            s = s.mark_heap();
            s = s.write("    leaq .S" + i32_to_string(lo.idx) + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            s = s.write("    movq $" + i32_to_string(len(sv.value)) + ", %rcx\n");
            s = s.write("    movq %rcx, 8(%rax)\n");
            s = s.write("    pushq %rax\n");
            return s;
        },
        parser.ExprCall(c) => {
            var name: string = "";
            match (c.callee) {
                parser.ExprIdent(id) => { name = id.name; },
                parser.ExprFieldAccess(fa) => {
                    // Primitive-receiver fast path: when the
                    // receiver's inferred type is "string" /
                    // "i32" / "bool" / "f64", skip the shape-
                    // pointer dispatch chain (those values
                    // aren't heap-boxed with a shape ptr) and
                    // call `__fn_<type>__<method>` directly.
                    var prim_recv: string = infer_expr_type(fa.obj, s);
                    // Built-in `.to_string()` on i32 and string —
                    // i32 routes to the existing runtime helper,
                    // string returns the receiver unchanged. The
                    // generic path below would chase a
                    // `__fn_i32.to_string` symbol that no FuncDecl
                    // emits, producing a link error.
                    if (fa.field == "to_string" && len(c.args) == 0
                            && (prim_recv == "i32" || prim_recv == "string")) {
                        s = emit_expr(fa.obj, s);
                        if (prim_recv == "i32") {
                            s = s.write("    popq %rdi\n");
                            s = s.write("    call __lang_i32_to_string\n");
                            s = s.write("    pushq %rax\n");
                            s = s.mark_i32_to_string();
                        }
                        return s;
                    }
                    if (prim_recv == "string" || prim_recv == "i32" || prim_recv == "bool" || prim_recv == "f64") {
                        var pmi: i32 = len(c.args) - 1;
                        while (pmi >= 0) {
                            s = emit_expr(c.args[pmi], s);
                            pmi = pmi - 1;
                        }
                        s = emit_expr(fa.obj, s);
                        s = s.write("    call __fn_" + sanitize_label(prim_recv + "." + fa.field) + "\n");
                        s = s.write("    addq $" + i32_to_string((len(c.args) + 1) * 8) + ", %rsp\n");
                        s = s.write("    pushq %rax\n");
                        return s;
                    }
                    // Method call: `obj.method(args)`. Push
                    // args right-to-left, then push the
                    // receiver (so receiver sits at +16(%rbp)
                    // and arg[0] at +24(%rbp) inside the
                    // callee). Then dispatch on the receiver's
                    // shape pointer.
                    var mi: i32 = len(c.args) - 1;
                    while (mi >= 0) {
                        s = emit_expr(c.args[mi], s);
                        mi = mi - 1;
                    }
                    s = emit_expr(fa.obj, s);
                    // Peek receiver pointer (top of stack) to
                    // read its shape pointer; load shape into
                    // %rcx without consuming the receiver.
                    s = s.write("    movq (%rsp), %rax\n");
                    s = s.write("    movq (%rax), %rcx\n");
                    var m_end_lbl: i32 = s.label_n;
                    s = EmitState {
                        out: s.out,
                        label_n: s.label_n + 1,
                        local_names: s.local_names,
                        in_function: s.in_function,
                        string_lits: s.string_lits,
                        needs_print_int: s.needs_print_int,
                        needs_read_int: s.needs_read_int,
                        needs_heap: s.needs_heap,
                        struct_decls: s.struct_decls,
                        loop_exit_labels: s.loop_exit_labels,
                        loop_cont_labels: s.loop_cont_labels,
                        funcs: s.funcs,
                        local_types: s.local_types,
                        needs_str_concat: s.needs_str_concat,
                        needs_str_eq: s.needs_str_eq,
                        needs_str_print: s.needs_str_print,
                        needs_str_cmp: s.needs_str_cmp,
                        needs_str_read_line: s.needs_str_read_line,
                        needs_i32_to_string: s.needs_i32_to_string,
                        needs_str_to_i32: s.needs_str_to_i32,
                        needs_eprint: s.needs_eprint,
                        needs_str_search: s.needs_str_search,
                        needs_args: s.needs_args
                    };
                    // For each func whose name matches and
                    // receiver_type is non-empty, emit a shape-
                    // compare arm. Walk in declaration order so
                    // the asm is deterministic.
                    var fdi: i32 = 0;
                    while (fdi < len(s.funcs)) {
                        var fd_m: parser.FuncDecl = s.funcs[fdi];
                        if (fd_m.name == fa.field && len(fd_m.receiver_type) > 0) {
                            var arm_lit: StringLitOut = add_string_lit(s, fd_m.receiver_type);
                            s = arm_lit.state;
                            var next_l: LabelOut = fresh_label(s);
                            s = next_l.state;
                            s = s.write("    leaq .S" + i32_to_string(arm_lit.idx) + "(%rip), %rdx\n");
                            s = s.write("    cmpq %rdx, %rcx\n");
                            s = s.write("    jne " + next_l.name + "\n");
                            s = s.write("    call __fn_" + sanitize_label(fd_m.receiver_type + "." + fd_m.name) + "\n");
                            // Caller cleans up args + receiver.
                            s = s.write("    addq $" + i32_to_string((len(c.args) + 1) * 8) + ", %rsp\n");
                            s = s.write("    pushq %rax\n");
                            s = s.write("    jmp .Lmethod_end_" + i32_to_string(m_end_lbl) + "\n");
                            s = s.write(next_l.name + ":\n");
                        }
                        fdi = fdi + 1;
                    }
                    // Fallthrough: no matching method. Clean up
                    // args + receiver, push sentinel -1.
                    s = s.write("    addq $" + i32_to_string((len(c.args) + 1) * 8) + ", %rsp\n");
                    s = s.write("    movq $-1, %rax\n");
                    s = s.write("    pushq %rax\n");
                    s = s.write(".Lmethod_end_" + i32_to_string(m_end_lbl) + ":\n");
                    return s;
                },
                _ => {
                    s = s.write("    # call target not ident\n");
                    s = s.write("    pushq $0\n");
                    return s;
                }
            }
            // print(str_literal) — builtin lowering to write(1, ptr, len).
            // Compile-time we already know the literal's bytes, so we
            // intern it in `.rodata`, look up the offset, and emit the
            // syscall directly. Other string-typed args fall through
            // as unsupported.
            // len(arr) — load the length prefix at offset 0
            // of the array box. Today this assumes the arg is
            // an array (a string arg would read random bytes);
            // a future slice with type info can route string
            // arguments through __lang_str_len.
            if (name == "len" && len(c.args) == 1) {
                // Dispatch on operand type: string → load
                // box.len at offset 8; array → load len prefix
                // at offset 0. Unknown defaults to array.
                var lt: string = infer_expr_type(c.args[0], s);
                s = emit_expr(c.args[0], s);
                s = s.write("    popq %rax\n");
                if (lt == "string") {
                    s = s.write("    movq 8(%rax), %rax\n");
                } else {
                    s = s.write("    movq (%rax), %rax\n");
                }
                s = s.write("    pushq %rax\n");
                return s;
            }
            if (name == "print" && len(c.args) == 1) {
                var arg: parser.Expr = c.args[0];
                match (arg) {
                    parser.ExprString(sv) => {
                        // Fast path for literals — direct
                        // syscall, no heap-box alloc.
                        var lo: StringLitOut = add_string_lit(s, sv.value);
                        s = lo.state;
                        s = s.write("    movq $1, %rdi\n");
                        s = s.write("    leaq .S" + i32_to_string(lo.idx) + "(%rip), %rsi\n");
                        s = s.write("    movq $" + i32_to_string(len(sv.value)) + ", %rdx\n");
                        s = s.write("    movq $1, %rax\n");
                        s = s.write("    syscall\n");
                        s = s.write("    pushq $0\n");
                        return s;
                    },
                    _ => { }
                }
                // Non-literal string argument: eval as box ptr,
                // route through __lang_print_str.
                var at: string = infer_expr_type(arg, s);
                if (at == "string") {
                    s = emit_expr(arg, s);
                    s = s.write("    popq %rdi\n");
                    s = s.write("    call __lang_print_str\n");
                    s = s.write("    pushq $0\n");
                    s = s.mark_str_print();
                    return s;
                }
            }
            // eprint(s) — same as print but writes to stderr
            // (fd=2). Useful for error messages that shouldn't
            // mix with normal stdout output.
            if (name == "eprint" && len(c.args) == 1) {
                var earg: parser.Expr = c.args[0];
                match (earg) {
                    parser.ExprString(esv) => {
                        var elo: StringLitOut = add_string_lit(s, esv.value);
                        s = elo.state;
                        s = s.write("    movq $2, %rdi\n");
                        s = s.write("    leaq .S" + i32_to_string(elo.idx) + "(%rip), %rsi\n");
                        s = s.write("    movq $" + i32_to_string(len(esv.value)) + ", %rdx\n");
                        s = s.write("    movq $1, %rax\n");
                        s = s.write("    syscall\n");
                        s = s.write("    pushq $0\n");
                        return s;
                    },
                    _ => { }
                }
                var eat: string = infer_expr_type(earg, s);
                if (eat == "string") {
                    s = emit_expr(earg, s);
