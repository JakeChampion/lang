                                || is_int_array_tag(prim_recv)
                                || prim_recv == "array_string"
                                || prim_recv == "array")) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    ldr x0, [sp], #16\n");
                        if (prim_recv == "string") {
                            s = s.write("    ldr x0, [x0, #8]\n");
