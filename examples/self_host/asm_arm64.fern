        s = s.write("    str x21, [sp, #-16]!\n");
        s = s.write("    ldr x0, =33554432\n");   // 32 MiB buffer
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x19, x0\n");          // buf base
        s = s.write("    mov x20, x0\n");          // write ptr
        s = s.write("    mov x21, #0\n");          // total
        s = s.write(".Lras_loop:\n");
        s = s.write("    mov x0, #0\n");           // fd 0
        s = s.write("    mov x1, x20\n");          // dst
