        s = s.write("    mov x8, #64\n");
        s = s.write("    svc #0\n");
        s = s.write("    mov w1, #10\n");
        s = s.write("    strb w1, [sp, #-16]!\n");
        s = s.write("    mov x0, #2\n");
        s = s.write("    mov x1, sp\n");
        s = s.write("    mov x2, #1\n");
        s = s.write("    mov x8, #64\n");
        s = s.write("    svc #0\n");
        s = s.write("    add sp, sp, #16\n");
        s = s.write("    ret\n");
