// examples/self_host/asm_arm64.fern — sibling of asm.fern for
// the ARM64 / aarch64 Linux target. Walks a parser.Module and
// emits GAS-flavoured aarch64 assembly text. The emitted asm
// uses Linux syscall conventions (sys_exit = 93) and is
// assemble-able with `aarch64-linux-gnu-gcc -nostdlib`.
//
// Scope:
//   - i32 literals
//   - i32 arithmetic: + - * / %
//   - Comparisons: < <= > >= == != → 0/1 i32 via cmp + cset
//   - Bool literals (false=0, true=1 on the rt-stack)
//   - Unary `-`
//   - Control flow: if/else and while (forward-branch patching
//     via unique generated labels)
//   - Statement-level: `return <expr>;` lowers to sys_exit
//
// Lowering shape — a textual stack machine on the architectural
// stack (sp). Each expr leaves its result on the rt-stack via:
//   literal n:  ldr x0, =n; str x0, [sp, #-16]!
//   bin l op r: <emit l>; <emit r>;
//               ldr x1, [sp], #16; ldr x0, [sp], #16;
//               <op>; str x0, [sp, #-16]!
// Statement `return <expr>;` pops into x0 and issues sys_exit
// (syscall number in x8, args in x0..x7).
//
// 16-byte stack alignment requirement on ARM64 means we use
// `[sp, #-16]!` even though each value is 8 bytes — wastes 8
// bytes per push but keeps sp 16-aligned for any nested
// syscalls / function calls that follow.

import "core/no_prelude";
import "./lexer";
import "./parser";

// =================== TEXT HELPERS ====================

// sanitize_label rewrites `.` to `__` so qualified-name
// function labels (e.g. `parser.parse_module`) survive GNU
// as's label parsing. Same shape as the x86-64 backend.
function sanitize_label(name: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < name.len()) {
        var b: i32 = name[i];
        if (b == 46) { out = out + "__"; }
        else { out = out + name[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

function i32_to_string(n: i32): string {
    if (n == 0) { return "0"; }
    var neg: boolean = false;
    if (n < 0) { neg = true; n = 0 - n; }
    var out: string = "";
    while (n > 0) {
        var d: i32 = n % 10;
        var c: string = "";
        if (d == 0) { c = "0"; } else if (d == 1) { c = "1"; }
        else if (d == 2) { c = "2"; } else if (d == 3) { c = "3"; }
        else if (d == 4) { c = "4"; } else if (d == 5) { c = "5"; }
        else if (d == 6) { c = "6"; } else if (d == 7) { c = "7"; }
        else if (d == 8) { c = "8"; } else { c = "9"; }
        out = c + out;
        n = n / 10;
    }
    if (neg) { out = "-" + out; }
    return out;
}

// digits_to_i32 parses a decimal integer literal (optional
// leading `-`). Stops at the first non-digit byte. Mirrors
// the x86-64 backend helper of the same name.
function digits_to_i32(s: string): i32 {
    if (s.len() == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == 45) { neg = true; start = 1; }
    var acc: i32 = 0;
    var i: i32 = start;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) {
            if (neg) { return 0 - acc; }
            return acc;
        }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    if (neg) { return 0 - acc; }
    return acc;
}

// is_all_digits returns true iff `s` is non-empty and every
// byte is an ASCII digit. Used by ExprFieldAccess to detect
// tuple-style numeric field names versus struct field names.
function is_all_digits(s: string): boolean {
    if (s.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return false; }
        i = i + 1;
    }
    return true;
}

// =================== FREE-VAR WALKER ====================
// Used by ExprLambda capture analysis. Same shape as the
// walker in vm.fern's #824 / asm.fern's port.

function has_str(xs: string[], s: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == s) { return true; }
        i = i + 1;
    }
    return false;
}

function collect_idents_expr(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprIdent(id) => { return acc.push(id.name); },
        parser.ExprNumber(_) => { return acc; },
        parser.ExprString(_) => { return acc; },
        parser.ExprBool(_) => { return acc; },
        parser.ExprBinary(b) => {
            acc = collect_idents_expr(b.left, acc);
            return collect_idents_expr(b.right, acc);
        },
        parser.ExprUnary(u) => { return collect_idents_expr(u.operand, acc); },
        parser.ExprCall(c) => {
            acc = collect_idents_expr(c.callee, acc);
            var i: i32 = 0;
            while (i < c.args.len()) {
                acc = collect_idents_expr(c.args[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                acc = collect_idents_expr(a.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                acc = collect_idents_expr(t.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprIndex(x) => {
            acc = collect_idents_expr(x.array, acc);
            return collect_idents_expr(x.index, acc);
        },
        parser.ExprSlice(sl) => {
            acc = collect_idents_expr(sl.array, acc);
            acc = collect_idents_expr(sl.start, acc);
            return collect_idents_expr(sl.end, acc);
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                acc = collect_idents_expr(sl.field_values[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprFieldAccess(fa) => { return collect_idents_expr(fa.obj, acc); },
        parser.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < lm.body.len()) {
                acc = collect_idents_stmt(lm.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

function collect_idents_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        parser.StmtVar(v) => { return collect_idents_expr(v.init, acc); },
        parser.StmtReturn(r) => { return collect_idents_expr(r.value, acc); },
        parser.StmtExpr(e) => { return collect_idents_expr(e.value, acc); },
        parser.StmtIf(i) => {
            acc = collect_idents_expr(i.cond, acc);
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_idents_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_idents_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            acc = collect_idents_expr(w.cond, acc);
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_idents_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(a) => { return collect_idents_expr(a.value, acc); },
        parser.StmtMatch(m) => {
            acc = collect_idents_expr(m.scrutinee, acc);
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_idents_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = collect_idents_expr(f.iter, acc);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_idents_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

function collect_bound_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        parser.StmtVar(v) => { return acc.push(v.name); },
        parser.StmtReturn(_) => { return acc; },
        parser.StmtExpr(_) => { return acc; },
        parser.StmtIf(i) => {
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_bound_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_bound_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_bound_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(_) => { return acc; },
        parser.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                match (m.arms[ai].pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.binding.len() > 0) { acc = acc.push(pv.binding); }
                    },
                    parser.PatWildcard(_) => { }
                }
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_bound_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = acc.push(f.var_name);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_bound_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

function lambda_captures(lm: parser.ExprLambda, outer: EmitState): string[] {
    var refs: string[] = [];
    var bi: i32 = 0;
    while (bi < lm.body.len()) {
        refs = collect_idents_stmt(lm.body[bi], refs);
        bi = bi + 1;
    }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lm.params.len()) {
        bound = bound.push(lm.params[pi].name);
        pi = pi + 1;
    }
    var si: i32 = 0;
    while (si < lm.body.len()) {
        bound = collect_bound_stmt(lm.body[si], bound);
        si = si + 1;
    }
    var caps: string[] = [];
    var ri: i32 = 0;
    while (ri < refs.len()) {
        var nm: string = refs[ri];
        if (!has_str(bound, nm) && !has_str(caps, nm) && outer.has_local(nm)) {
            caps = caps.push(nm);
        }
        ri = ri + 1;
    }
    return caps;
}

// =================== EMIT STATE ====================

// EmitState carries the running output text, a monotonic label
// counter, the active locals table, and a flag for whether the
// current emit position is inside a function body (so
// StmtReturn knows to use ldp+ret instead of sys_exit).
// local_names is parallel-array shape: index i → offset
// -8*(i+1) off x29.
pub struct EmitState {
    out: string,
    label_n: i32,
    local_names: string[],
    in_function: boolean,
    string_lits: string[],
    needs_print_int: boolean,
    needs_read_int: boolean,
    needs_heap: boolean,
    struct_decls: parser.StructDecl[],
    // loop_exit_labels / loop_cont_labels: see asm.fern for
    // semantics. break / continue use the top of each stack.
    loop_exit_labels: string[],
    loop_cont_labels: string[],
    // funcs: the module's FuncDecls — used by method dispatch
    // in ExprCall(ExprFieldAccess(...), args).
    funcs: parser.FuncDecl[],
    // local_types: parallel to local_names. See asm.fern.
    local_types: string[],
    needs_str_concat: boolean,
    needs_str_eq: boolean,
    needs_str_print: boolean,
    needs_str_cmp: boolean,
    needs_str_read_line: boolean,
    needs_i32_to_string: boolean,
    needs_str_to_i32: boolean,
    needs_eprint: boolean,
    needs_str_search: boolean,
    needs_args: boolean,
    needs_arr_push: boolean,
    needs_arr_slice: boolean,
    needs_arr_i32_index_of: boolean,
    needs_arr_reverse: boolean,
    needs_arr_concat: boolean,
    needs_arr_str_index_of: boolean,
    needs_arr_str_join: boolean,
    needs_arr_i32_sum: boolean,
    needs_arr_i32_min_max: boolean,
    needs_arr_i32_product: boolean,
    needs_str_chars: boolean,
    needs_str_bytes: boolean,
    needs_str_reverse: boolean,
    needs_i32_pow: boolean
}

function new_state(): EmitState {
    var ns: string[] = [];
    var sl: string[] = [];
    var lex: string[] = [];
    var lcn: string[] = [];
    var fns: parser.FuncDecl[] = [];
    var lts: string[] = [];
    return EmitState {
        out: "",
        label_n: 0,
        local_names: ns,
        in_function: false,
        string_lits: sl,
        needs_print_int: false,
        needs_read_int: false,
        needs_heap: false,
        struct_decls: [],
        loop_exit_labels: lex,
        loop_cont_labels: lcn,
        funcs: fns,
        local_types: lts,
        needs_str_concat: false,
        needs_str_eq: false,
        needs_str_print: false,
        needs_str_cmp: false,
        needs_str_read_line: false,
        needs_i32_to_string: false,
        needs_str_to_i32: false,
        needs_eprint: false,
        needs_str_search: false,
        needs_args: false,
        needs_arr_push: false,
        needs_arr_slice: false,
        needs_arr_i32_index_of: false,
        needs_arr_reverse: false,
        needs_arr_concat: false,
        needs_arr_str_index_of: false,
        needs_arr_str_join: false,
        needs_arr_i32_sum: false,
        needs_arr_i32_min_max: false,
        needs_arr_i32_product: false,
        needs_str_chars: false,
        needs_str_bytes: false,
        needs_str_reverse: false,
        needs_i32_pow: false
    };
}

function (s: EmitState) write(text: string): EmitState {
    // O(N) amortised: route through the global strbuf primitive
    // instead of `s.out + text` (which is O(N²) — fatal for self-
    // hosting). The .out field stays "" through the build; the
    // accumulated bytes live in the strbuf until emit_module's
    // tail calls strbuf_take to materialise the final string.
    // Mirrors the x86-64 backend (asm.fern).
    strbuf_append(text);
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) bind_local(name: string): EmitState {
    return s.bind_local_typed(name, "unknown");
}

function (s: EmitState) bind_local_typed(name: string, ty: string): EmitState {
    var ln: string[] = s.local_names.push(name);
    var lts: string[] = s.local_types.push(ty);
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: ln,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: lts,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) local_type_of(name: string): string {
    var i: i32 = s.local_names.len() - 1;
    while (i >= 0) {
        if (s.local_names[i] == name) { return s.local_types[i]; }
        i = i - 1;
    }
    return "unknown";
}

function (s: EmitState) mark_str_concat(): EmitState {
    return EmitState {
        out: s.out, label_n: s.label_n, local_names: s.local_names,
        in_function: s.in_function, string_lits: s.string_lits,
        needs_print_int: s.needs_print_int, needs_read_int: s.needs_read_int,
        needs_heap: true,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels, loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs, local_types: s.local_types,
        needs_str_concat: true, needs_str_eq: s.needs_str_eq, needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) mark_str_eq(): EmitState {
    return EmitState {
        out: s.out, label_n: s.label_n, local_names: s.local_names,
        in_function: s.in_function, string_lits: s.string_lits,
        needs_print_int: s.needs_print_int, needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels, loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs, local_types: s.local_types,
        needs_str_concat: s.needs_str_concat, needs_str_eq: true, needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
