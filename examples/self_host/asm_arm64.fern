// emit_ldc loads the f64 constant at .rodata label `lbl` into the
// given d-register, using x12 as the address scratch. Used by the
// transcendental runtime functions (their polynomial coefficients
// live in .rodata). x12 is caller-saved and unused elsewhere in
// those functions.
function emit_ldc(s: EmitState, reg: string, lbl: string): EmitState {
    s = s.write("    adrp x12, " + lbl + "\n");
    s = s.write("    add x12, x12, :lo12:" + lbl + "\n");
    s = s.write("    ldr " + reg + ", [x12]\n");
    return s;
}

// count_locals walks a stmt body recursively (into if / while
// bodies) to determine the total number of `var` decls. The
// result feeds the prologue's `sub sp, sp, #<N*8>` so the
// frame has enough room for every local that might be live.
// Conservative: counts every var even if branches make them
// mutually exclusive at runtime — fine for stack allocation.
function count_locals(body: parser.Stmt[]): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < body.len()) {
        n = n + count_locals_in_stmt(body[i]);
        i = i + 1;
    }
    return n;
}

// name_has_comma — see asm.fern. "a,b"-encoded pair bindings.
function name_has_comma(name: string): boolean {
    var i: i32 = 0;
    while (i < name.len()) {
        if (name[i] == 44) { return true; }
        i = i + 1;
    }
    return false;
}

function count_locals_in_stmt(stmt: parser.Stmt): i32 {
    match (stmt) {
        parser.StmtVar(v) => {
            if (name_has_comma(v.name)) { return 2; }
            return 1;
        },
        parser.StmtIf(ifs) => { return count_locals(ifs.then_body) + count_locals(ifs.else_body); },
        parser.StmtWhile(w) => { return count_locals(w.body); },
        parser.StmtMatch(m) => {
            // +1 for the synthetic scrutinee local + one per
            // non-empty PatVariant binding + the recursive body
            // counts. Wildcard arms add no binding.
            var n: i32 = 1;
            var i: i32 = 0;
            while (i < m.arms.len()) {
                match (m.arms[i].pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.binding.len() > 0 && pv.binding != "_") { n = n + 1; }
                    },
                    parser.PatWildcard(_) => { }
                }
                n = n + count_locals(m.arms[i].body);
                i = i + 1;
            }
            return n;
        },
        parser.StmtFor(f) => {
            // `for (k,v) in m` binds 4 locals (map ptr, index, k, v);
            // plain `for x in arr` binds 3.
            if (name_has_comma(f.var_name)) { return 4 + count_locals(f.body); }
            return 3 + count_locals(f.body);
        },
        _ => { return 0; }
    }
    return 0;
}

// add_string_lit appends the literal to the pool and returns
// its index, used by the caller to emit `adrp + add` for the
// literal's address. The pool is materialised in .rodata at
// end-of-module.
struct StringLitOut { state: EmitState, idx: i32 }
function add_string_lit(s: EmitState, v: string): StringLitOut {
    // Dedup: load-bearing for shape-pointer dispatch in
    // ExprFieldAccess + StmtMatch. See asm.fern for rationale.
    var i: i32 = 0;
    while (i < s.string_lits.len()) {
        if (s.string_lits[i] == v) {
            return StringLitOut { state: s, idx: i };
        }
        i = i + 1;
    }
    var idx: i32 = s.string_lits.len();
    var sl: string[] = s.string_lits.push(v);
    var ns: EmitState = EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: sl,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
    return StringLitOut { state: ns, idx: idx };
}

