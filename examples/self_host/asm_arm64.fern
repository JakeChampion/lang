        s = s.write("    b.eq .Ltrim_front_step\n");
        s = s.write("    cmp w0, #10\n");
        s = s.write("    b.eq .Ltrim_front_step\n");
        s = s.write("    cmp w0, #13\n");
        s = s.write("    b.eq .Ltrim_front_step\n");
        s = s.write("    b .Ltrim_back\n");
