                            s = emit_expr(c.args[0], s);
                            s = s.write("    ldr x1, [sp], #16\n");
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    cmp x0, x1\n");
                            s = s.write("    csel x0, x0, x1, lt\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
