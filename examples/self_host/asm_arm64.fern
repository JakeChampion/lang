        s = s.write("    ldr x19, [x0]\n");          // data ptr
        s = s.write("    ldr x20, [x0, #8]\n");      // len
        s = s.write(".Ltrim_front:\n");
        s = s.write("    cbz x20, .Ltrim_box\n");
        s = s.write("    ldrb w0, [x19]\n");
        s = s.write("    cmp w0, #32\n");
        s = s.write("    b.eq .Ltrim_front_step\n");
