        s = s.write("    ldr x1, [x1]\n");
        s = s.write("    cbz x2, .Lew_yes\n");
        s = s.write(".Lew_loop:\n");
        s = s.write("    ldrb w3, [x0], #1\n");
        s = s.write("    ldrb w4, [x1], #1\n");
        s = s.write("    cmp w3, w4\n");
