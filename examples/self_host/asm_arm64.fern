function (s: EmitState) pop_loop_labels(): EmitState {
    var nex: string[] = [];
    var ncn: string[] = [];
    var i: i32 = 0;
    while (i < s.loop_exit_labels.len() - 1) {
        nex = nex.push(s.loop_exit_labels[i]);
        ncn = ncn.push(s.loop_cont_labels[i]);
        i = i + 1;
    }
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
