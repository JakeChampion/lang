        s = s.write(".Lrepl_alloc:\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x24, x0\n");            // dst buf
        // Second pass.
        s = s.write("    ldr x4, [x19]\n");
        s = s.write("    ldr x5, [x19, #8]\n");
        s = s.write("    ldr x6, [x20]\n");
        s = s.write("    ldr x3, [x20, #8]\n");      // lenO
        s = s.write("    mov x7, #0\n");             // i
        s = s.write("    mov x8, x24\n");            // dst cursor
        s = s.write(".Lrepl_walk:\n");
        s = s.write("    add x9, x7, x3\n");
        s = s.write("    cmp x9, x5\n");
        s = s.write("    b.gt .Lrepl_tail\n");
        s = s.write("    mov x9, #0\n");
        s = s.write(".Lrepl_chk:\n");
        s = s.write("    cmp x9, x3\n");
        s = s.write("    b.eq .Lrepl_writenew\n");
        s = s.write("    add x10, x4, x7\n");
        s = s.write("    add x10, x10, x9\n");
        s = s.write("    ldrb w11, [x10]\n");
        s = s.write("    add x10, x6, x9\n");
        s = s.write("    ldrb w12, [x10]\n");
        s = s.write("    cmp w11, w12\n");
        s = s.write("    b.ne .Lrepl_chknomatch\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lrepl_chk\n");
        s = s.write(".Lrepl_writenew:\n");
        s = s.write("    ldr x10, [x21]\n");
        s = s.write("    ldr x11, [x21, #8]\n");
        s = s.write("    cbz x11, .Lrepl_advance\n");
        s = s.write(".Lrepl_wn_loop:\n");
        s = s.write("    ldrb w12, [x10], #1\n");
        s = s.write("    strb w12, [x8], #1\n");
        s = s.write("    subs x11, x11, #1\n");
        s = s.write("    b.ne .Lrepl_wn_loop\n");
        s = s.write(".Lrepl_advance:\n");
        s = s.write("    add x7, x7, x3\n");
        s = s.write("    b .Lrepl_walk\n");
        s = s.write(".Lrepl_chknomatch:\n");
        s = s.write("    add x10, x4, x7\n");
        s = s.write("    ldrb w11, [x10]\n");
        s = s.write("    strb w11, [x8], #1\n");
        s = s.write("    add x7, x7, #1\n");
        s = s.write("    b .Lrepl_walk\n");
        s = s.write(".Lrepl_tail:\n");
        s = s.write("    cmp x7, x5\n");
        s = s.write("    b.eq .Lrepl_box\n");
        s = s.write("    add x10, x4, x7\n");
        s = s.write("    ldrb w11, [x10]\n");
        s = s.write("    strb w11, [x8], #1\n");
        s = s.write("    add x7, x7, #1\n");
        s = s.write("    b .Lrepl_tail\n");
        s = s.write(".Lrepl_box:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x24, [x0]\n");
        s = s.write("    str x23, [x0, #8]\n");
        s = s.write("    b .Lrepl_exit\n");
        s = s.write(".Lrepl_passthru:\n");
        s = s.write("    mov x0, x19\n");
        s = s.write(".Lrepl_exit:\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        // __fern_chr: x0 = i32 byte value → 1-char string box.
        s = s.write("__fern_chr:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");            // save value
        s = s.write("    mov x0, #1\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x20, x0\n");            // buf ptr
        s = s.write("    strb w19, [x20]\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x20, [x0]\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        // __fern_str_split: x0 = haystack box, x1 = sep box.
        // Returns string[] of segments. Empty sep → [haystack].
        //
        // Callee-saved regs (preserved across __fern_alloc):
        //   x19 = haystack box ptr
        //   x20 = sep box ptr
        //   x21 = count
        //   x22 = array ptr
        //   x23 = write_idx
        //   x24 = seg_start offset
        //   x25 = i (loop cursor)
        //   x26 = unused (paired with x25)
        // Working temps (caller-saved, reloaded as needed):
        //   x4 = haystack data, x5 = haystack len
        //   x6 = sep data, x7 = sep len
        //   x9-x12 = inner loop scratch
        s = s.write("__fern_str_split:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    stp x25, x26, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    mov x20, x1\n");
        s = s.write("    mov x21, #0\n");
        s = s.write("    ldr x2, [x20, #8]\n");
        s = s.write("    cbz x2, .Lsplit_single\n");
        // First pass.
        s = s.write("    ldr x4, [x19]\n");          // hd
        s = s.write("    ldr x5, [x19, #8]\n");      // hl
        s = s.write("    ldr x6, [x20]\n");          // sd
        s = s.write("    ldr x7, [x20, #8]\n");      // sl
        s = s.write("    mov x25, #0\n");            // i
        s = s.write(".Lsplit_cl:\n");
        s = s.write("    add x9, x25, x7\n");
        s = s.write("    cmp x9, x5\n");
        s = s.write("    b.gt .Lsplit_count_done\n");
        s = s.write("    mov x9, #0\n");             // j
        s = s.write(".Lsplit_clm:\n");
        s = s.write("    cmp x9, x7\n");
        s = s.write("    b.eq .Lsplit_match\n");
        s = s.write("    add x10, x4, x25\n");
        s = s.write("    add x10, x10, x9\n");
        s = s.write("    ldrb w11, [x10]\n");
        s = s.write("    add x10, x6, x9\n");
        s = s.write("    ldrb w12, [x10]\n");
        s = s.write("    cmp w11, w12\n");
        s = s.write("    b.ne .Lsplit_clnomatch\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lsplit_clm\n");
        s = s.write(".Lsplit_match:\n");
        s = s.write("    add x21, x21, #1\n");
        s = s.write("    add x25, x25, x7\n");
        s = s.write("    b .Lsplit_cl\n");
        s = s.write(".Lsplit_clnomatch:\n");
        s = s.write("    add x25, x25, #1\n");
        s = s.write("    b .Lsplit_cl\n");
        s = s.write(".Lsplit_count_done:\n");
        // Allocate array: 16 (cap + len words) + (count+1)*8 bytes.
        s = s.write("    add x0, x21, #1\n");
        s = s.write("    lsl x0, x0, #3\n");
        s = s.write("    add x0, x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        // cap at base, shift to base+8, store returned ptr + len
        // (hidden-cap layout; see __fern_arr_push).
        s = s.write("    add x1, x21, #1\n");        // len = count + 1
        s = s.write("    str x1, [x0]\n");           // cap
        s = s.write("    add x0, x0, #8\n");
        s = s.write("    mov x22, x0\n");            // returned arr ptr (base+8)
        s = s.write("    str x1, [x22]\n");          // len
        s = s.write("    mov x23, #0\n");
        s = s.write("    mov x24, #0\n");
        s = s.write("    ldr x4, [x19]\n");
        s = s.write("    ldr x5, [x19, #8]\n");
        s = s.write("    ldr x6, [x20]\n");
        s = s.write("    ldr x7, [x20, #8]\n");
        s = s.write("    mov x25, #0\n");
        s = s.write(".Lsplit_walk:\n");
        s = s.write("    add x9, x25, x7\n");
        s = s.write("    cmp x9, x5\n");
        s = s.write("    b.gt .Lsplit_tail\n");
        s = s.write("    mov x9, #0\n");
        s = s.write(".Lsplit_chk:\n");
        s = s.write("    cmp x9, x7\n");
        s = s.write("    b.eq .Lsplit_segend\n");
        s = s.write("    add x10, x4, x25\n");
        s = s.write("    add x10, x10, x9\n");
        s = s.write("    ldrb w11, [x10]\n");
        s = s.write("    add x10, x6, x9\n");
        s = s.write("    ldrb w12, [x10]\n");
        s = s.write("    cmp w11, w12\n");
        s = s.write("    b.ne .Lsplit_chknomatch\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lsplit_chk\n");
        s = s.write(".Lsplit_segend:\n");
        // Emit segment [seg_start, i).
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    ldr x1, [x19]\n");
        s = s.write("    add x1, x1, x24\n");
        s = s.write("    str x1, [x0]\n");
        s = s.write("    sub x1, x25, x24\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write("    add x10, x23, #1\n");
        s = s.write("    str x0, [x22, x10, lsl #3]\n");
        s = s.write("    add x23, x23, #1\n");
        // Reload sep len before advancing i, since x7 is
        // caller-saved and may have been clobbered by alloc.
        s = s.write("    ldr x7, [x20, #8]\n");
        s = s.write("    add x25, x25, x7\n");
        s = s.write("    mov x24, x25\n");
        // Reload the other working regs too.
        s = s.write("    ldr x4, [x19]\n");
        s = s.write("    ldr x5, [x19, #8]\n");
        s = s.write("    ldr x6, [x20]\n");
        s = s.write("    b .Lsplit_walk\n");
        s = s.write(".Lsplit_chknomatch:\n");
        s = s.write("    add x25, x25, #1\n");
        s = s.write("    b .Lsplit_walk\n");
        s = s.write(".Lsplit_tail:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    ldr x1, [x19]\n");
        s = s.write("    add x1, x1, x24\n");
        s = s.write("    str x1, [x0]\n");
        s = s.write("    ldr x1, [x19, #8]\n");
        s = s.write("    sub x1, x1, x24\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write("    add x10, x23, #1\n");
        s = s.write("    str x0, [x22, x10, lsl #3]\n");
        s = s.write("    mov x0, x22\n");
        s = s.write("    b .Lsplit_exit\n");
        s = s.write(".Lsplit_single:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x22, x0\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x22]\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    ldr x1, [x19]\n");
        s = s.write("    str x1, [x0]\n");
        s = s.write("    ldr x1, [x19, #8]\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write("    str x0, [x22, #8]\n");
        s = s.write("    mov x0, x22\n");
        s = s.write(".Lsplit_exit:\n");
        s = s.write("    ldp x25, x26, [sp], #16\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // Pre-intern "FileStat" so the __fern_stat runtime helper (emitted
    // after this pool, inside the needs_heap block) can reference its
    // shape-name label. The helper's own add_string_lit dedups to this
    // slot; without the early intern the label would be undefined for
    // programs that never mention stat() themselves. Same for the
    // __fern_subprocess helper's "ProcessResult" shape name.
    if (s.needs_heap) {
        var fsPre: StringLitOut = add_string_lit(s, "FileStat");
        s = fsPre.state;
        var prPre: StringLitOut = add_string_lit(s, "ProcessResult");
        s = prPre.state;
    }
    // .rodata: emit each interned string literal as a
    // labelled `.ascii` directive. GAS interprets the escape
    // sequences in the quoted string, so a `\n` byte in the
    // source string lands as a single LF in the resulting
    // .rodata bytes.
    if (s.string_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < s.string_lits.len()) {
            s = s.write(".S" + i32_to_string(li) + ": .ascii \"" + escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
    }
    // Heap allocator (arm64): 1 MiB .bss buffer + bump pointer.
    // Same shape as the x86-64 backend; instructions translated
    // to aarch64. Sets x0 = old ptr (return), advances the
    // ptr by x0 (the size arg).
    if (s.needs_heap) {
        var heap_size: string = "1073741824";   // 1 GiB
        s = s.write("    .bss\n");
        s = s.write("    .align 3\n");
        s = s.write("__fern_heap_ptr: .quad 0\n");
        s = s.write("    .align 3\n");
        s = s.write("__fern_heap: .skip " + heap_size + "\n");   // 1 GiB — room for read_all_stdin + self-compiling a whole source bundle (zero-page .bss)
        s = s.write("    .text\n");
        s = s.write(".globl __fern_alloc\n");
        s = s.write(".type __fern_alloc, %function\n");
        s = s.write("__fern_alloc:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    adrp x1, __fern_heap_ptr\n");
        s = s.write("    add x1, x1, :lo12:__fern_heap_ptr\n");
        s = s.write("    ldr x2, [x1]\n");
        s = s.write("    cbnz x2, .Lalloc_inited\n");
        s = s.write("    adrp x2, __fern_heap\n");
        s = s.write("    add x2, x2, :lo12:__fern_heap\n");
        s = s.write("    str x2, [x1]\n");
        s = s.write(".Lalloc_inited:\n");
        s = s.write("    ldr x2, [x1]\n");
        s = s.write("    add x3, x2, x0\n");
        // Bounds check: a bump heap has no GC, so an overflow would
        // silently run past the buffer into adjacent .bss (e.g. the
        // strbuf output accumulator) and corrupt it. Trap with a clean,
        // recognisable exit code (137) instead of corrupting memory.
        // x0 is free now (size consumed into x3); x4 is saved/restored
        // so __fern_alloc keeps its original clobber contract (x0..x3) —
        // callers hold live values in higher registers across the call.
        // The ldr restoring x4 doesn't disturb the cmp's flags.
        s = s.write("    str x4, [sp, #-16]!\n");
        s = s.write("    ldr x4, =" + heap_size + "\n");
        s = s.write("    adrp x0, __fern_heap\n");
        s = s.write("    add x0, x0, :lo12:__fern_heap\n");
        s = s.write("    add x0, x0, x4\n");
        s = s.write("    cmp x3, x0\n");
        s = s.write("    ldr x4, [sp], #16\n");
        s = s.write("    b.hi .Lalloc_oom\n");
        s = s.write("    str x3, [x1]\n");
        s = s.write("    mov x0, x2\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".Lalloc_oom:\n");
        s = s.write("    mov x8, #93\n");
        s = s.write("    mov x0, #137\n");
        s = s.write("    svc #0\n");
        s = s.write(".size __fern_alloc, .-__fern_alloc\n");

        // Global string-builder primitive — the amortised-O(1) output
        // accumulator (strbuf_reset / strbuf_append / strbuf_take).
        // Emitted alongside the heap (strbuf_take allocates via
        // __fern_alloc). A string is a 16-byte box {data@0, len@8}.
        // Mirrors asm.fern's x86 emitStrBufRuntime; required so a
        // program that uses strbuf — including asm_arm64.fern itself —
        // self-compiles and links.
        s = s.write("    .bss\n");
        s = s.write("    .align 3\n");
        s = s.write("__fern_strbuf_len: .quad 0\n");
        s = s.write("    .align 3\n");
        s = s.write("__fern_strbuf_data: .skip 16777216\n");   // 16 MiB
        s = s.write("    .text\n");
        // reset: len = 0
        s = s.write(".globl __fern_strbuf_reset\n");
        s = s.write(".type __fern_strbuf_reset, %function\n");
        s = s.write("__fern_strbuf_reset:\n");
        s = s.write("    adrp x1, __fern_strbuf_len\n");
        s = s.write("    add x1, x1, :lo12:__fern_strbuf_len\n");
        s = s.write("    str xzr, [x1]\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_strbuf_reset, .-__fern_strbuf_reset\n");
        // append(box in x0): copy box.len bytes from box.data to
        // strbuf_data + strbuf_len, then bump len. Leaf (no frame);
        // clobbers x1..x6, all caller-saved temporaries.
        s = s.write(".globl __fern_strbuf_append\n");
        s = s.write(".type __fern_strbuf_append, %function\n");
        s = s.write("__fern_strbuf_append:\n");
        s = s.write("    ldr x1, [x0]\n");                      // src data ptr
        s = s.write("    ldr x2, [x0, #8]\n");                  // src len
        s = s.write("    cbz x2, .Lsbapp_done\n");
        s = s.write("    adrp x3, __fern_strbuf_data\n");
        s = s.write("    add x3, x3, :lo12:__fern_strbuf_data\n");
        s = s.write("    adrp x4, __fern_strbuf_len\n");
        s = s.write("    add x4, x4, :lo12:__fern_strbuf_len\n");
        s = s.write("    ldr x5, [x4]\n");
        s = s.write("    add x3, x3, x5\n");                    // dst = data + len
        s = s.write(".Lsbapp_loop:\n");
        s = s.write("    ldrb w6, [x1], #1\n");
        s = s.write("    strb w6, [x3], #1\n");
        s = s.write("    sub x2, x2, #1\n");
        s = s.write("    cbnz x2, .Lsbapp_loop\n");
        s = s.write(".Lsbapp_done:\n");
        s = s.write("    ldr x2, [x0, #8]\n");                  // reload src len
        s = s.write("    adrp x4, __fern_strbuf_len\n");
        s = s.write("    add x4, x4, :lo12:__fern_strbuf_len\n");
        s = s.write("    ldr x5, [x4]\n");
        s = s.write("    add x5, x5, x2\n");
        s = s.write("    str x5, [x4]\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_strbuf_append, .-__fern_strbuf_append\n");
        // take(): alloc data + 16-byte box, copy bytes, reset, return
        // box ptr in x0. Live values (len, data ptr) held in callee-
        // saved x19/x20 across the __fern_alloc calls.
        s = s.write(".globl __fern_strbuf_take\n");
        s = s.write(".type __fern_strbuf_take, %function\n");
        s = s.write("__fern_strbuf_take:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    adrp x19, __fern_strbuf_len\n");
        s = s.write("    add x19, x19, :lo12:__fern_strbuf_len\n");
        s = s.write("    ldr x19, [x19]\n");                    // x19 = len
        s = s.write("    mov x0, x19\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x20, x0\n");                       // x20 = data ptr
        s = s.write("    adrp x1, __fern_strbuf_data\n");
        s = s.write("    add x1, x1, :lo12:__fern_strbuf_data\n");
        s = s.write("    mov x2, x20\n");                       // dst
        s = s.write("    mov x3, x19\n");                       // count
        s = s.write("    cbz x3, .Lsbtake_box\n");
        s = s.write(".Lsbtake_loop:\n");
        s = s.write("    ldrb w4, [x1], #1\n");
        s = s.write("    strb w4, [x2], #1\n");
        s = s.write("    sub x3, x3, #1\n");
        s = s.write("    cbnz x3, .Lsbtake_loop\n");
        s = s.write(".Lsbtake_box:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x20, [x0]\n");                     // box.data
        s = s.write("    str x19, [x0, #8]\n");                 // box.len
        s = s.write("    adrp x1, __fern_strbuf_len\n");
        s = s.write("    add x1, x1, :lo12:__fern_strbuf_len\n");
        s = s.write("    str xzr, [x1]\n");                     // reset
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_strbuf_take, .-__fern_strbuf_take\n");

        // Low-level memory intrinsics (`__alloc` / `__free` / the
        // `__load_*` / `__store_*` pokes / `__ptr_width` / `__memset`)
        // and the RC intrinsics (`__fern_rc_inc` / `__fern_arr_dec` /
        // `__fern_drop_arr_ptr`). Plain runtime functions under the
        // self-host's stack-arg ABI (param[0] at [x29, #16], result in
        // x0). They exist so a program that imports `std/json` /
        // `core/map` links: that map implementation's source pokes raw
        // memory through these names. The self-host's own `Map[K,V]`
        // lowers to the native `__fern_map_*` runtime, so the
        // `core/map` bodies are never actually called — but their
        // symbols must resolve. RC + `__free` are no-ops, consistent
        // with the leak-everything bump heap (nothing is reclaimed).
        s = s.write("__fn___alloc:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    ldr x0, [x29, #16]\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write("__fn___free:\n");
        s = s.write("    ret\n");
        s = s.write("__fn___memset:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    ldr x0, [x29, #16]\n");     // dst
        s = s.write("    ldr x1, [x29, #32]\n");     // fill byte
        s = s.write("    ldr x2, [x29, #48]\n");     // count
        s = s.write("    cbz x2, .Lfnmemset_done\n");
        s = s.write(".Lfnmemset_loop:\n");
        s = s.write("    strb w1, [x0], #1\n");
        s = s.write("    subs x2, x2, #1\n");
        s = s.write("    bne .Lfnmemset_loop\n");
        s = s.write(".Lfnmemset_done:\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write("__fn___load_i32:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    ldr x0, [x29, #16]\n");
        s = s.write("    ldrsw x0, [x0]\n");          // i32 load, sign-extended
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write("__fn___store_i32:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    ldr x0, [x29, #16]\n");     // addr
        s = s.write("    ldr x1, [x29, #32]\n");     // val
        s = s.write("    str w1, [x0]\n");            // store low 4 bytes
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write("__fn___load_i64:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    ldr x0, [x29, #16]\n");
        s = s.write("    ldr x0, [x0]\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write("__fn___load_ptr:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    ldr x0, [x29, #16]\n");
        s = s.write("    ldr x0, [x0]\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write("__fn___store_ptr:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    ldr x0, [x29, #16]\n");     // addr
        s = s.write("    ldr x1, [x29, #32]\n");     // val
        s = s.write("    str x1, [x0]\n");            // store 8 bytes
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write("__fn___ptr_width:\n");
        s = s.write("    mov x0, #8\n");
        s = s.write("    ret\n");
        // RC intrinsics — no-ops (leak-everything heap). __fern_rc_inc
        // passes its argument through in x0 in case a caller chains.
        s = s.write("__fn___fern_rc_inc:\n");
        s = s.write("    ldr x0, [sp]\n");
        s = s.write("    ret\n");
        s = s.write("__fn___fern_arr_dec:\n");
        s = s.write("    ret\n");
        s = s.write("__fn___fern_drop_arr_ptr:\n");
        s = s.write("    ret\n");

        // __fern_reader_read_chunk(x0 = fd, x1 = n) → Option[string].
        // Reads up to n bytes; Some(string) on a non-empty read — an
        // Option box [tag=0, strbox@8] wrapping a {data@0, len@8}
        // string box — and None (box [tag=1]) at EOF (read ≤ 0).
        s = s.write(".globl __fern_reader_read_chunk\n");
        s = s.write(".type __fern_reader_read_chunk, %function\n");
        s = s.write("__fern_reader_read_chunk:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // fd
        s = s.write("    mov x20, x1\n");           // n
        s = s.write("    mov x0, x20\n");           // alloc n data bytes
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x21, x0\n");           // data ptr
        s = s.write("    mov x0, x19\n");           // read(fd, data, n)
        s = s.write("    mov x1, x21\n");
        s = s.write("    mov x2, x20\n");
        s = s.write("    mov x8, #63\n");           // sys_read
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.le .Larrc_none\n");
        s = s.write("    mov x22, x0\n");           // bytes_read
        s = s.write("    mov x0, #16\n");           // string box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x21, [x0]\n");         // data@0
        s = s.write("    str x22, [x0, #8]\n");     // len@8
        s = s.write("    mov x21, x0\n");           // strbox
        s = s.write("    mov x0, #16\n");           // Some box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0]\n");          // tag = Some
        s = s.write("    str x21, [x0, #8]\n");     // payload
        s = s.write("    b .Larrc_ret\n");
        s = s.write(".Larrc_none:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0]\n");          // tag = None
        s = s.write(".Larrc_ret:\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_reader_read_chunk, .-__fern_reader_read_chunk\n");

        // __fern_reader_close(x0 = fd) → Option[IoError]. Closes the
        // fd and always returns None (error arm unused by read_all_stdin).
        s = s.write(".globl __fern_reader_close\n");
        s = s.write(".type __fern_reader_close, %function\n");
        s = s.write("__fern_reader_close:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    mov x8, #57\n");           // sys_close(fd)
        s = s.write("    svc #0\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0]\n");          // None
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_reader_close, .-__fern_reader_close\n");

        // __fern_read_file(x0 = path string box) → Result[string,
        // IoError]: [tag@0, payload@8] with tag=0 Ok(contents) on
        // success, tag=1 Err(_) on any I/O error (payload 0). Copies
        // the path to a NUL-terminated buffer, openat(AT_FDCWD, path,
        // O_RDONLY), reads to EOF into a 64 MiB buffer, closes.
        // Linux aarch64 syscalls: openat=56, read=63, close=57.
        s = s.write(".globl __fern_read_file\n");
        s = s.write(".type __fern_read_file, %function\n");
        s = s.write("__fern_read_file:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // path box
        s = s.write("    ldr x20, [x19]\n");        // path data ptr
        s = s.write("    ldr x21, [x19, #8]\n");    // path len
        s = s.write("    add x0, x21, #1\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x22, x0\n");           // pathz
        s = s.write("    mov x9, #0\n");
        s = s.write(".Lrdf_copy:\n");
        s = s.write("    cmp x9, x21\n");
        s = s.write("    b.ge .Lrdf_copydone\n");
        s = s.write("    ldrb w10, [x20, x9]\n");
        s = s.write("    strb w10, [x22, x9]\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lrdf_copy\n");
        s = s.write(".Lrdf_copydone:\n");
        s = s.write("    mov w10, #0\n");
        s = s.write("    strb w10, [x22, x21]\n");  // NUL terminator
        // openat(AT_FDCWD=-100, pathz, O_RDONLY=0, 0)
        s = s.write("    mov x0, #-100\n");
        s = s.write("    mov x1, x22\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    mov x3, #0\n");
        s = s.write("    mov x8, #56\n");           // sys_openat
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.lt .Lrdf_err\n");
        s = s.write("    mov x23, x0\n");           // fd
        // Size the file via lseek so we allocate exactly what's needed
        // (a fixed buffer would exhaust the heap when a driver
        // read_file's several modules). lseek=62, SEEK_END=2, SEEK_SET=0.
        s = s.write("    mov x0, x23\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    mov x2, #2\n");
        s = s.write("    mov x8, #62\n");
        s = s.write("    svc #0\n");
        s = s.write("    mov x24, x0\n");           // file size (temp)
        s = s.write("    mov x0, x23\n");           // rewind to start
        s = s.write("    mov x1, #0\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    mov x8, #62\n");
        s = s.write("    svc #0\n");
        s = s.write("    mov x0, x24\n");           // alloc exactly size bytes
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x24, x0\n");           // buf base
        s = s.write("    mov x20, x0\n");           // write ptr
        s = s.write("    mov x21, #0\n");           // total
        s = s.write(".Lrdf_rdloop:\n");
        s = s.write("    mov x0, x23\n");
        s = s.write("    mov x1, x20\n");
        s = s.write("    ldr x2, =1048576\n");      // up to 1 MiB per read
        s = s.write("    mov x8, #63\n");           // sys_read
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.le .Lrdf_rddone\n");
        s = s.write("    add x21, x21, x0\n");
        s = s.write("    add x20, x20, x0\n");
        s = s.write("    b .Lrdf_rdloop\n");
        s = s.write(".Lrdf_rddone:\n");
        s = s.write("    mov x0, x23\n");           // close(fd)
        s = s.write("    mov x8, #57\n");
        s = s.write("    svc #0\n");
        s = s.write("    mov x0, #16\n");           // string box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x24, [x0]\n");         // data@0
        s = s.write("    str x21, [x0, #8]\n");     // len@8
        s = s.write("    mov x24, x0\n");           // strbox
        s = s.write("    mov x0, #16\n");           // Result Ok box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0]\n");          // tag = Ok
        s = s.write("    str x24, [x0, #8]\n");     // payload = string
        s = s.write("    b .Lrdf_ret\n");
        s = s.write(".Lrdf_err:\n");
        s = s.write("    mov x0, #16\n");           // Result Err box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0]\n");          // tag = Err
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");      // payload (unused)
        s = s.write(".Lrdf_ret:\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_read_file, .-__fern_read_file\n");

        // __fern_write_file(x0 = path box, x1 = content box) →
        // Option[IoError]: tag=1 None on success, tag=0 Some(_) on any
        // I/O error (payload 0, like __fern_read_file's Err). NUL-
        // terminates the path, openat(AT_FDCWD, O_WRONLY|O_CREAT|
        // O_TRUNC=577, 0644), writes the content bytes, closes. Linux
        // arm64: openat=56, write=64, close=57.
        s = s.write(".globl __fern_write_file\n");
        s = s.write(".type __fern_write_file, %function\n");
        s = s.write("__fern_write_file:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    ldr x19, [x1]\n");          // content data ptr
        s = s.write("    ldr x20, [x1, #8]\n");       // content len
        s = s.write("    ldr x21, [x0]\n");          // path data ptr
        s = s.write("    ldr x22, [x0, #8]\n");       // path len
        s = s.write("    add x0, x22, #1\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x23, x0\n");            // pathz
        s = s.write("    mov x9, #0\n");
        s = s.write(".Lwf_copy:\n");
        s = s.write("    cmp x9, x22\n");
        s = s.write("    b.ge .Lwf_copydone\n");
        s = s.write("    ldrb w10, [x21, x9]\n");
        s = s.write("    strb w10, [x23, x9]\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lwf_copy\n");
        s = s.write(".Lwf_copydone:\n");
        s = s.write("    mov w10, #0\n");
        s = s.write("    strb w10, [x23, x22]\n");   // NUL terminator
        // openat(AT_FDCWD=-100, pathz, O_WRONLY|O_CREAT|O_TRUNC=577, 0644=420)
        s = s.write("    mov x0, #-100\n");
        s = s.write("    mov x1, x23\n");
        s = s.write("    mov x2, #577\n");
        s = s.write("    mov x3, #420\n");
        s = s.write("    mov x8, #56\n");
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.lt .Lwf_err\n");
        s = s.write("    mov x23, x0\n");            // fd (pathz no longer needed)
        s = s.write("    mov x24, #0\n");            // bytes written
        s = s.write(".Lwf_loop:\n");
        s = s.write("    cmp x24, x20\n");
        s = s.write("    b.ge .Lwf_done\n");
        s = s.write("    mov x0, x23\n");            // fd
        s = s.write("    add x1, x19, x24\n");       // content data + written
        s = s.write("    sub x2, x20, x24\n");       // remaining
        s = s.write("    mov x8, #64\n");            // write
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.lt .Lwf_err_close\n");
        s = s.write("    add x24, x24, x0\n");
        s = s.write("    b .Lwf_loop\n");
        s = s.write(".Lwf_done:\n");
        s = s.write("    mov x0, x23\n");
        s = s.write("    mov x8, #57\n");            // close
        s = s.write("    svc #0\n");
        s = s.write("    mov x0, #16\n");            // None box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0]\n");           // tag = None
        s = s.write("    b .Lwf_ret\n");
        s = s.write(".Lwf_err_close:\n");
        s = s.write("    mov x0, x23\n");
        s = s.write("    mov x8, #57\n");            // close, ignore result
        s = s.write("    svc #0\n");
        s = s.write(".Lwf_err:\n");
        s = s.write("    mov x0, #16\n");            // Some box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0]\n");           // tag = Some
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");        // payload 0
        s = s.write(".Lwf_ret:\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_write_file, .-__fern_write_file\n");

        // __fern_env(x0 = name string box) → Option[string]: a
        // [tag@0, payload@8] box — tag=0 Some(value string box) if set,
        // tag=1 None otherwise. Walks __fern_envp (saved by _start) for
        // an entry whose key matches the first name.len bytes followed
        // by '='. The value box points directly at the immortal envp
        // bytes (no copy). x19-x24 survive __fern_alloc, as in
        // __fern_read_file.
        s = s.write("    .section .bss\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_envp: .quad 0\n");
        s = s.write("    .section .text\n");
        s = s.write(".globl __fern_env\n");
        s = s.write(".type __fern_env, %function\n");
        s = s.write("__fern_env:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    ldr x20, [x0]\n");           // name data
        s = s.write("    ldr x21, [x0, #8]\n");       // name len
        s = s.write("    adrp x19, __fern_envp\n");
        s = s.write("    add x19, x19, :lo12:__fern_envp\n");
        s = s.write("    ldr x19, [x19]\n");          // envp base
        s = s.write(".Lenv_loop:\n");
        s = s.write("    ldr x1, [x19]\n");           // envp[i]
        s = s.write("    cbz x1, .Lenv_none\n");
        // Compare the first name.len bytes of the entry with the name.
        s = s.write("    mov x9, #0\n");
        s = s.write(".Lenv_cmp:\n");
        s = s.write("    cmp x9, x21\n");
        s = s.write("    b.ge .Lenv_cmpdone\n");
        s = s.write("    ldrb w10, [x1, x9]\n");
        s = s.write("    ldrb w11, [x20, x9]\n");
        s = s.write("    cmp w10, w11\n");
        s = s.write("    b.ne .Lenv_next\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lenv_cmp\n");
        s = s.write(".Lenv_cmpdone:\n");
        // Require '=' immediately after the matched key bytes.
        s = s.write("    ldrb w10, [x1, x21]\n");
        s = s.write("    cmp w10, #61\n");            // '='
        s = s.write("    b.ne .Lenv_next\n");
        // value start = entry + name.len + 1; strlen it.
        s = s.write("    add x22, x1, x21\n");
        s = s.write("    add x22, x22, #1\n");
        s = s.write("    mov x23, #0\n");
        s = s.write(".Lenv_strlen:\n");
        s = s.write("    ldrb w10, [x22, x23]\n");
        s = s.write("    cbz w10, .Lenv_strlen_done\n");
        s = s.write("    add x23, x23, #1\n");
        s = s.write("    b .Lenv_strlen\n");
        s = s.write(".Lenv_strlen_done:\n");
        s = s.write("    mov x0, #16\n");             // string box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x22, [x0]\n");           // data@0
        s = s.write("    str x23, [x0, #8]\n");       // len@8
        s = s.write("    mov x22, x0\n");             // strbox
        s = s.write("    mov x0, #16\n");             // Option Some box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0]\n");            // tag = Some
        s = s.write("    str x22, [x0, #8]\n");       // payload = strbox
        s = s.write("    b .Lenv_ret\n");
        s = s.write(".Lenv_next:\n");
        s = s.write("    add x19, x19, #8\n");
        s = s.write("    b .Lenv_loop\n");
        s = s.write(".Lenv_none:\n");
        s = s.write("    mov x0, #16\n");             // Option None box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0]\n");            // tag = None
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write(".Lenv_ret:\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_env, .-__fern_env\n");

        // __fern_temp_dir(x0 = prefix box) → Result[string]. Mirror of
        // asm.fern: make "/tmp/<prefix>-<monotonic_ns>", mkdirat it,
        // return Ok(path) / Err(_). arm64 syscalls: mkdirat=34.
        s = s.write(".globl __fern_temp_dir\n");
        s = s.write(".type __fern_temp_dir, %function\n");
        s = s.write("__fern_temp_dir:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // prefix box
        s = s.write("    bl __fern_monotonic_ns\n");
        s = s.write("    mov x23, x0\n");           // ns
        s = s.write("    ldr x20, [x19, #8]\n");    // prefix len
        s = s.write("    add x0, x20, #27\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x21, x0\n");           // path base
        s = s.write("    mov w9, #47\n");
        s = s.write("    strb w9, [x21]\n");         // '/'
        s = s.write("    mov w9, #116\n");
        s = s.write("    strb w9, [x21, #1]\n");     // 't'
        s = s.write("    mov w9, #109\n");
        s = s.write("    strb w9, [x21, #2]\n");     // 'm'
        s = s.write("    mov w9, #112\n");
        s = s.write("    strb w9, [x21, #3]\n");     // 'p'
        s = s.write("    mov w9, #47\n");
        s = s.write("    strb w9, [x21, #4]\n");     // '/'
        s = s.write("    mov x22, #5\n");            // cursor
        s = s.write("    ldr x10, [x19]\n");         // prefix data
        s = s.write("    mov x11, #0\n");
        s = s.write(".Ltd_pcopy:\n");
        s = s.write("    cmp x11, x20\n");
        s = s.write("    b.ge .Ltd_pdone\n");
        s = s.write("    ldrb w9, [x10, x11]\n");
        s = s.write("    strb w9, [x21, x22]\n");
        s = s.write("    add x22, x22, #1\n");
        s = s.write("    add x11, x11, #1\n");
        s = s.write("    b .Ltd_pcopy\n");
        s = s.write(".Ltd_pdone:\n");
        s = s.write("    mov w9, #45\n");            // '-'
        s = s.write("    strb w9, [x21, x22]\n");
        s = s.write("    add x22, x22, #1\n");
        // count digits of ns → x12
        s = s.write("    mov x9, x23\n");
        s = s.write("    mov x12, #0\n");
        s = s.write("    cbnz x9, .Ltd_cnt\n");
        s = s.write("    mov x12, #1\n");
        s = s.write("    b .Ltd_cntdone\n");
        s = s.write(".Ltd_cnt:\n");
        s = s.write("    cbz x9, .Ltd_cntdone\n");
        s = s.write("    mov x13, #10\n");
        s = s.write("    udiv x14, x9, x13\n");
        s = s.write("    mov x9, x14\n");
        s = s.write("    add x12, x12, #1\n");
        s = s.write("    b .Ltd_cnt\n");
        s = s.write(".Ltd_cntdone:\n");
        // write digits backward from cursor + ndigits - 1
        s = s.write("    add x15, x22, x12\n");
        s = s.write("    sub x15, x15, #1\n");
        s = s.write("    mov x9, x23\n");
        s = s.write("    mov x13, #10\n");
        s = s.write(".Ltd_wr:\n");
        s = s.write("    udiv x14, x9, x13\n");      // q
        s = s.write("    msub x16, x14, x13, x9\n"); // rem = x9 - q*10
        s = s.write("    add x16, x16, #48\n");
        s = s.write("    strb w16, [x21, x15]\n");
        s = s.write("    sub x15, x15, #1\n");
        s = s.write("    mov x9, x14\n");
        s = s.write("    cbnz x9, .Ltd_wr\n");
        s = s.write("    add x22, x22, x12\n");      // total len
        s = s.write("    mov w9, #0\n");
        s = s.write("    strb w9, [x21, x22]\n");    // NUL
        // mkdirat(AT_FDCWD, pathz, 0700)
        s = s.write("    mov x0, #-100\n");
        s = s.write("    mov x1, x21\n");
        s = s.write("    mov x2, #448\n");
        s = s.write("    mov x8, #34\n");            // mkdirat
        s = s.write("    svc #0\n");
        s = s.write("    cbnz x0, .Ltd_err\n");
        s = s.write("    mov x0, #16\n");            // string box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x21, [x0]\n");
        s = s.write("    str x22, [x0, #8]\n");
        s = s.write("    mov x21, x0\n");            // strbox
        s = s.write("    mov x0, #16\n");            // Result Ok
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0]\n");           // Ok
        s = s.write("    str x21, [x0, #8]\n");
        s = s.write("    b .Ltd_ret\n");
        s = s.write(".Ltd_err:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0]\n");           // Err
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write(".Ltd_ret:\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_temp_dir, .-__fern_temp_dir\n");

        // __fern_stat(x0 = path box) → Result[FileStat]. newfstatat=79
        // into a stack buffer; st_mode is at offset 16 on arm64 (vs 24
        // on x86-64), st_size at 48. Builds the FileStat struct whose
        // shape pointer is the interned "FileStat" name.
        var fsLit: StringLitOut = add_string_lit(s, "FileStat");
        s = fsLit.state;
        s = s.write(".globl __fern_stat\n");
        s = s.write(".type __fern_stat, %function\n");
        s = s.write("__fern_stat:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    sub sp, sp, #160\n");       // statbuf
        s = s.write("    mov x19, x0\n");           // path box
        s = s.write("    ldr x20, [x19]\n");        // path data
        s = s.write("    ldr x21, [x19, #8]\n");    // path len
        s = s.write("    add x0, x21, #1\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x22, x0\n");           // pathz
        s = s.write("    mov x9, #0\n");
        s = s.write(".Lstat_copy:\n");
        s = s.write("    cmp x9, x21\n");
        s = s.write("    b.ge .Lstat_cpd\n");
        s = s.write("    ldrb w10, [x20, x9]\n");
        s = s.write("    strb w10, [x22, x9]\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lstat_copy\n");
        s = s.write(".Lstat_cpd:\n");
        s = s.write("    mov w10, #0\n");
        s = s.write("    strb w10, [x22, x21]\n");
        // newfstatat(AT_FDCWD, pathz, statbuf=sp, 0)
        s = s.write("    mov x0, #-100\n");
        s = s.write("    mov x1, x22\n");
        s = s.write("    mov x2, sp\n");
        s = s.write("    mov x3, #0\n");
        s = s.write("    mov x8, #79\n");            // newfstatat
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.lt .Lstat_err\n");
        s = s.write("    ldr w9, [sp, #16]\n");      // st_mode (arm64 offset)
        s = s.write("    mov w11, #61440\n");        // 0xF000
        s = s.write("    and w9, w9, w11\n");
        s = s.write("    mov x23, #0\n");            // is_file
        s = s.write("    mov w10, #32768\n");        // S_IFREG
        s = s.write("    cmp w9, w10\n");
        s = s.write("    b.ne .Lstat_nf\n");
        s = s.write("    mov x23, #1\n");
        s = s.write(".Lstat_nf:\n");
        s = s.write("    mov x24, #0\n");            // is_dir
        s = s.write("    mov w10, #16384\n");        // S_IFDIR
        s = s.write("    cmp w9, w10\n");
        s = s.write("    b.ne .Lstat_nd\n");
        s = s.write("    mov x24, #1\n");
        s = s.write(".Lstat_nd:\n");
        s = s.write("    ldr x20, [sp, #48]\n");     // st_size
        s = s.write("    mov x0, #32\n");            // FileStat struct
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    adrp x9, .S" + i32_to_string(fsLit.idx) + "\n");
        s = s.write("    add x9, x9, :lo12:.S" + i32_to_string(fsLit.idx) + "\n");
        s = s.write("    str x9, [x0]\n");           // shape
        s = s.write("    str x23, [x0, #8]\n");      // is_file
        s = s.write("    str x24, [x0, #16]\n");     // is_dir
        s = s.write("    str x20, [x0, #24]\n");     // size
        s = s.write("    mov x21, x0\n");            // struct ptr
        s = s.write("    mov x0, #16\n");            // Result Ok
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0]\n");           // Ok
        s = s.write("    str x21, [x0, #8]\n");
        s = s.write("    b .Lstat_ret\n");
        s = s.write(".Lstat_err:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0]\n");           // Err
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write(".Lstat_ret:\n");
        s = s.write("    add sp, sp, #160\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_stat, .-__fern_stat\n");

        // __fern_read_dir(x0 = path box) → Result[string[]]. openat
        // O_DIRECTORY, getdents64=61 into a 1 MiB buffer, two passes to
        // build the [cap, len, e0…] array of base-name string boxes.
        s = s.write(".globl __fern_read_dir\n");
        s = s.write(".type __fern_read_dir, %function\n");
        s = s.write("__fern_read_dir:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // path box
        s = s.write("    ldr x20, [x19]\n");        // path data
        s = s.write("    ldr x23, [x19, #8]\n");    // path len
        s = s.write("    add x0, x23, #1\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x20, x0\n");           // pathz (temp; data not needed after copy)
        s = s.write("    ldr x21, [x19]\n");        // reload path data
        s = s.write("    mov x9, #0\n");
        s = s.write(".Lrd_copy:\n");
        s = s.write("    cmp x9, x23\n");
        s = s.write("    b.ge .Lrd_cpd\n");
        s = s.write("    ldrb w10, [x21, x9]\n");
        s = s.write("    strb w10, [x20, x9]\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lrd_copy\n");
        s = s.write(".Lrd_cpd:\n");
        s = s.write("    mov w10, #0\n");
        s = s.write("    strb w10, [x20, x23]\n");
        // openat(AT_FDCWD, pathz, O_RDONLY|O_DIRECTORY, 0). Note: on
        // arm64 Linux O_DIRECTORY=040000=16384 (arch-specific override
        // of the asm-generic value); on x86-64 it's 65536. Using
        // 65536 here would mean O_RDONLY|O_DIRECT — EINVAL on /tmp.
        s = s.write("    mov x0, #-100\n");
        s = s.write("    mov x1, x20\n");
        s = s.write("    mov x2, #16384\n");
        s = s.write("    mov x3, #0\n");
        s = s.write("    mov x8, #56\n");            // openat
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.lt .Lrd_err\n");
        s = s.write("    mov x20, x0\n");            // fd
        s = s.write("    ldr x0, =1048576\n");       // 1 MiB buffer
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x21, x0\n");            // buf base
        s = s.write("    mov x22, #0\n");            // total
        s = s.write(".Lrd_g:\n");
        s = s.write("    mov x0, x20\n");
        s = s.write("    add x1, x21, x22\n");
        s = s.write("    ldr x2, =1048576\n");
        s = s.write("    sub x2, x2, x22\n");
        s = s.write("    mov x8, #61\n");            // getdents64
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.le .Lrd_gd\n");
        s = s.write("    add x22, x22, x0\n");
        s = s.write("    b .Lrd_g\n");
        s = s.write(".Lrd_gd:\n");
        s = s.write("    mov x0, x20\n");            // close(fd)
        s = s.write("    mov x8, #57\n");
        s = s.write("    svc #0\n");
        // pass 1: count valid entries → x23
        s = s.write("    mov x23, #0\n");            // count
        s = s.write("    mov x19, #0\n");            // offset
        s = s.write(".Lrd_c1:\n");
        s = s.write("    cmp x19, x22\n");
        s = s.write("    b.ge .Lrd_c1d\n");
        s = s.write("    add x10, x21, x19\n");      // entry base
        s = s.write("    add x10, x10, #19\n");      // name ptr
        s = s.write("    ldrb w11, [x10]\n");
        s = s.write("    cmp w11, #46\n");           // '.'
        s = s.write("    b.ne .Lrd_c1n\n");
        s = s.write("    ldrb w11, [x10, #1]\n");
        s = s.write("    cbz w11, .Lrd_c1s\n");      // "." → skip
        s = s.write("    cmp w11, #46\n");
        s = s.write("    b.ne .Lrd_c1n\n");
        s = s.write("    ldrb w11, [x10, #2]\n");
        s = s.write("    cbz w11, .Lrd_c1s\n");      // ".." → skip
        s = s.write(".Lrd_c1n:\n");
        s = s.write("    add x23, x23, #1\n");
        s = s.write(".Lrd_c1s:\n");
        s = s.write("    add x12, x21, x19\n");
        s = s.write("    ldrh w11, [x12, #16]\n");   // d_reclen
        s = s.write("    add x19, x19, x11\n");
        s = s.write("    b .Lrd_c1\n");
        s = s.write(".Lrd_c1d:\n");
        s = s.write("    add x0, x23, #2\n");        // (count+2)*8
        s = s.write("    lsl x0, x0, #3\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x23, [x0]\n");          // cap
        s = s.write("    add x0, x0, #8\n");
        s = s.write("    str x23, [x0]\n");          // len
        s = s.write("    mov x20, x0\n");            // array ptr P
        // pass 2: fill
        s = s.write("    mov x19, #0\n");            // offset
        s = s.write("    mov x23, #0\n");            // element index
        s = s.write(".Lrd_p2:\n");
        s = s.write("    cmp x19, x22\n");
        s = s.write("    b.ge .Lrd_p2d\n");
        s = s.write("    add x10, x21, x19\n");
        s = s.write("    add x10, x10, #19\n");      // name ptr
        s = s.write("    ldrb w11, [x10]\n");
        s = s.write("    cmp w11, #46\n");
        s = s.write("    b.ne .Lrd_p2t\n");
        s = s.write("    ldrb w11, [x10, #1]\n");
        s = s.write("    cbz w11, .Lrd_p2a\n");
        s = s.write("    cmp w11, #46\n");
        s = s.write("    b.ne .Lrd_p2t\n");
        s = s.write("    ldrb w11, [x10, #2]\n");
        s = s.write("    cbz w11, .Lrd_p2a\n");
        s = s.write(".Lrd_p2t:\n");
        s = s.write("    mov x11, #0\n");            // strlen
        s = s.write(".Lrd_p2sl:\n");
        s = s.write("    ldrb w12, [x10, x11]\n");
        s = s.write("    cbz w12, .Lrd_p2sd\n");
        s = s.write("    add x11, x11, #1\n");
        s = s.write("    b .Lrd_p2sl\n");
        s = s.write(".Lrd_p2sd:\n");
        s = s.write("    mov x24, x10\n");           // name ptr (survives alloc)
        s = s.write("    str x11, [sp, #-16]!\n");   // len
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    ldr x11, [sp], #16\n");     // len
        s = s.write("    str x24, [x0]\n");          // box.data
        s = s.write("    str x11, [x0, #8]\n");      // box.len
        s = s.write("    add x12, x23, #1\n");
        s = s.write("    str x0, [x20, x12, lsl #3]\n"); // P[index+1] = box
        s = s.write("    add x23, x23, #1\n");
        s = s.write(".Lrd_p2a:\n");
        s = s.write("    add x12, x21, x19\n");
        s = s.write("    ldrh w11, [x12, #16]\n");
        s = s.write("    add x19, x19, x11\n");
        s = s.write("    b .Lrd_p2\n");
        s = s.write(".Lrd_p2d:\n");
        s = s.write("    mov x0, #16\n");            // Result Ok
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0]\n");           // Ok
        s = s.write("    str x20, [x0, #8]\n");
        s = s.write("    b .Lrd_ret\n");
        s = s.write(".Lrd_err:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0]\n");           // Err
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write(".Lrd_ret:\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_read_dir, .-__fern_read_dir\n");

        // __fern_remove_dir_all(x0 = path box) → Option[IoError].
        // Recursive rm -rf, mirror of asm.fern. arm64 syscalls:
        // openat=56, getdents64=61, close=57, unlinkat=35.
        s = s.write(".globl __fern_remove_dir_all\n");
        s = s.write(".type __fern_remove_dir_all, %function\n");
        s = s.write("__fern_remove_dir_all:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // path box
        s = s.write("    ldr x20, [x19]\n");        // path data
        s = s.write("    ldr x21, [x19, #8]\n");    // path len
        s = s.write("    add x0, x21, #1\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x19, x0\n");           // pathz (reuse x19)
        s = s.write("    mov x9, #0\n");
        s = s.write(".Lrda_copy:\n");
        s = s.write("    cmp x9, x21\n");
        s = s.write("    b.ge .Lrda_cpd\n");
        s = s.write("    ldrb w10, [x20, x9]\n");
        s = s.write("    strb w10, [x19, x9]\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lrda_copy\n");
        s = s.write(".Lrda_cpd:\n");
        s = s.write("    mov w10, #0\n");
        s = s.write("    strb w10, [x19, x21]\n");
        // openat(AT_FDCWD, pathz, O_RDONLY|O_DIRECTORY). arm64
        // O_DIRECTORY=040000=16384 (NOT the x86 65536, which is
        // O_DIRECT on arm64 — see the same note in __fern_read_dir).
        s = s.write("    mov x0, #-100\n");
        s = s.write("    mov x1, x19\n");
        s = s.write("    mov x2, #16384\n");
        s = s.write("    mov x3, #0\n");
        s = s.write("    mov x8, #56\n");
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.ge .Lrda_dir\n");
        s = s.write("    cmn x0, #2\n");             // x0 == -2 (ENOENT)?
        s = s.write("    b.eq .Lrda_none\n");
        s = s.write("    cmn x0, #20\n");            // x0 == -20 (ENOTDIR)?
        s = s.write("    b.ne .Lrda_some\n");
        s = s.write("    mov x0, #-100\n");          // unlinkat(file)
        s = s.write("    mov x1, x19\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    mov x8, #35\n");            // unlinkat
        s = s.write("    svc #0\n");
        s = s.write("    b .Lrda_none\n");
        s = s.write(".Lrda_dir:\n");
        s = s.write("    mov x20, x0\n");            // fd
        s = s.write("    ldr x0, =65536\n");         // 64 KiB getdents buffer
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x21, x0\n");            // buf
        s = s.write("    mov x22, #0\n");            // total
        s = s.write(".Lrda_g:\n");
        s = s.write("    mov x0, x20\n");
        s = s.write("    add x1, x21, x22\n");
        s = s.write("    ldr x2, =65536\n");
        s = s.write("    sub x2, x2, x22\n");
        s = s.write("    mov x8, #61\n");            // getdents64
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.le .Lrda_gd\n");
        s = s.write("    add x22, x22, x0\n");
        s = s.write("    b .Lrda_g\n");
        s = s.write(".Lrda_gd:\n");
        s = s.write("    mov x23, #0\n");            // offset
        s = s.write(".Lrda_it:\n");
        s = s.write("    cmp x23, x22\n");
        s = s.write("    b.ge .Lrda_itd\n");
        s = s.write("    add x10, x21, x23\n");
        s = s.write("    add x10, x10, #19\n");      // name ptr
        s = s.write("    ldrb w11, [x10]\n");
        s = s.write("    cmp w11, #46\n");
        s = s.write("    b.ne .Lrda_ch\n");
        s = s.write("    ldrb w11, [x10, #1]\n");
        s = s.write("    cbz w11, .Lrda_adv\n");
        s = s.write("    cmp w11, #46\n");
        s = s.write("    b.ne .Lrda_ch\n");
        s = s.write("    ldrb w11, [x10, #2]\n");
        s = s.write("    cbz w11, .Lrda_adv\n");
        s = s.write(".Lrda_ch:\n");
        s = s.write("    mov x24, x10\n");           // name ptr (survives alloc/recursion)
        s = s.write("    mov x9, #0\n");             // plen = strlen(pathz)
        s = s.write(".Lrda_pl:\n");
        s = s.write("    ldrb w11, [x19, x9]\n");
        s = s.write("    cbz w11, .Lrda_pld\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lrda_pl\n");
        s = s.write(".Lrda_pld:\n");
        s = s.write("    mov x13, #0\n");            // nlen = strlen(name)
        s = s.write(".Lrda_nl:\n");
        s = s.write("    ldrb w11, [x24, x13]\n");
        s = s.write("    cbz w11, .Lrda_nld\n");
        s = s.write("    add x13, x13, #1\n");
        s = s.write("    b .Lrda_nl\n");
        s = s.write(".Lrda_nld:\n");
        // child data buf = plen + 1 + nlen. Save plen/nlen across alloc
        // in callee-saved-ish: stash on stack (x9=plen, x13=nlen).
        s = s.write("    stp x9, x13, [sp, #-16]!\n");
        s = s.write("    add x0, x9, x13\n");
        s = s.write("    add x0, x0, #1\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    ldp x9, x13, [sp], #16\n");
        s = s.write("    mov x1, x0\n");             // child data buf
        s = s.write("    mov x12, #0\n");            // copy pathz[0..plen]
        s = s.write(".Lrda_cc1:\n");
        s = s.write("    cmp x12, x9\n");
        s = s.write("    b.ge .Lrda_cc1d\n");
        s = s.write("    ldrb w11, [x19, x12]\n");
        s = s.write("    strb w11, [x1, x12]\n");
        s = s.write("    add x12, x12, #1\n");
        s = s.write("    b .Lrda_cc1\n");
        s = s.write(".Lrda_cc1d:\n");
        s = s.write("    mov w11, #47\n");           // '/'
        s = s.write("    strb w11, [x1, x9]\n");
        s = s.write("    mov x12, #0\n");            // copy name at plen+1
        s = s.write(".Lrda_cc2:\n");
        s = s.write("    cmp x12, x13\n");
        s = s.write("    b.ge .Lrda_cc2d\n");
        s = s.write("    ldrb w11, [x24, x12]\n");
        s = s.write("    add x14, x9, #1\n");
        s = s.write("    add x14, x14, x12\n");
        s = s.write("    strb w11, [x1, x14]\n");
        s = s.write("    add x12, x12, #1\n");
        s = s.write("    b .Lrda_cc2\n");
        s = s.write(".Lrda_cc2d:\n");
        s = s.write("    add x14, x9, x13\n");       // child len = plen+nlen+1
        s = s.write("    add x14, x14, #1\n");
        // build child string box; preserve data ptr (x1) + len (x14)
        s = s.write("    stp x1, x14, [sp, #-16]!\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    ldp x1, x14, [sp], #16\n");
        s = s.write("    str x1, [x0]\n");           // data
        s = s.write("    str x14, [x0, #8]\n");      // len
        s = s.write("    mov x0, x0\n");
        s = s.write("    bl __fern_remove_dir_all\n"); // recurse (x0 = childbox)
        s = s.write(".Lrda_adv:\n");
        s = s.write("    add x12, x21, x23\n");
        s = s.write("    ldrh w11, [x12, #16]\n");
        s = s.write("    add x23, x23, x11\n");
        s = s.write("    b .Lrda_it\n");
        s = s.write(".Lrda_itd:\n");
        s = s.write("    mov x0, x20\n");            // close(fd)
        s = s.write("    mov x8, #57\n");
        s = s.write("    svc #0\n");
        s = s.write("    mov x0, #-100\n");          // rmdir via unlinkat
        s = s.write("    mov x1, x19\n");
        s = s.write("    mov x2, #512\n");           // AT_REMOVEDIR
        s = s.write("    mov x8, #35\n");
        s = s.write("    svc #0\n");
        s = s.write(".Lrda_none:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0]\n");           // None
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write("    b .Lrda_ret\n");
        s = s.write(".Lrda_some:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0]\n");           // Some
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write(".Lrda_ret:\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_remove_dir_all, .-__fern_remove_dir_all\n");

        // __fern_remove_file(x0 = path box) → Option[IoError]. arm64
        // mirror of asm.fern: NUL-terminate the path, unlinkat(AT_FDCWD,
        // pathz, 0). Returns None on success, Some(_) on error.
        s = s.write(".globl __fern_remove_file\n");
        s = s.write(".type __fern_remove_file, %function\n");
        s = s.write("__fern_remove_file:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // path box
        s = s.write("    ldr x20, [x19]\n");         // path data
        s = s.write("    ldr x21, [x19, #8]\n");     // path len
        s = s.write("    add x0, x21, #1\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x22, x0\n");            // pathz
        s = s.write("    mov x9, #0\n");
        s = s.write(".Lrf_copy:\n");
        s = s.write("    cmp x9, x21\n");
        s = s.write("    b.ge .Lrf_cpd\n");
        s = s.write("    ldrb w10, [x20, x9]\n");
        s = s.write("    strb w10, [x22, x9]\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lrf_copy\n");
        s = s.write(".Lrf_cpd:\n");
        s = s.write("    mov w10, #0\n");
        s = s.write("    strb w10, [x22, x21]\n");
        s = s.write("    mov x0, #-100\n");
        s = s.write("    mov x1, x22\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    mov x8, #35\n");            // unlinkat
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.lt .Lrf_err\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #1\n");
        s = s.write("    str x1, [x0]\n");           // None
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write("    b .Lrf_ret\n");
        s = s.write(".Lrf_err:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0]\n");           // Some
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write(".Lrf_ret:\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_remove_file, .-__fern_remove_file\n");

        // __fern_subprocess(x0 = cmd box, x1 = args box (string[]),
        //                   x2 = stdin box) → ProcessResult struct.
        // arm64 mirror of asm.fern's helper: 3 pipes via pipe2 (sysno
        // 59), fork via clone(SIGCHLD,0,…) (sysno 220, no fork on
        // arm64), child execve (sysno 221, dup3=24, close=57) trying
        // cmd → /bin/cmd → /usr/bin/cmd then exit(127) (sysno 93).
        // Parent writes stdin (sysno 64), reads stdout + stderr to
        // EOF (sysno 63) into 64 KiB scratch bufs, wait4s (sysno 260),
        // decodes WIFEXITED (status >> 8) vs signaled (128 + sig),
        // packs {shape, stdout, stderr, exit_code} on the heap.
        var prLitA: StringLitOut = add_string_lit(s, "ProcessResult");
        s = prLitA.state;
        s = s.write(".globl __fern_subprocess\n");
        s = s.write(".type __fern_subprocess, %function\n");
        s = s.write("__fern_subprocess:\n");
        // Big frame: x29/x30 + 5 callee-saved pairs (x19..x28) + 128
        // bytes of locals = 224 bytes. Layout (from sp = x29):
        //   [sp+ 0]  saved x29
        //   [sp+ 8]  saved x30
        //   [sp+16]  saved x19  (cmd box)
        //   [sp+24]  saved x20  (args box)
        //   [sp+32]  saved x21  (stdin box)
        //   [sp+40]  saved x22  (scratch / child pid)
        //   [sp+48]  saved x23  (cmdz)
        //   [sp+56]  saved x24  (argv)
        //   [sp+64]  saved x25  (stdout buf)
        //   [sp+72]  saved x26  (stdout len)
        //   [sp+80]  saved x27  (stderr buf)
        //   [sp+88]  saved x28  (stderr len)
        //   [sp+96..119]  6 pipe fds (4 bytes each)
        //   [sp+120..123] wait4 status (4 bytes)
        //   [sp+124..223] scratch / padding
        s = s.write("    sub sp, sp, #224\n");
        s = s.write("    stp x29, x30, [sp, #0]\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #16]\n");
        s = s.write("    stp x21, x22, [sp, #32]\n");
        s = s.write("    stp x23, x24, [sp, #48]\n");
        s = s.write("    stp x25, x26, [sp, #64]\n");
        s = s.write("    stp x27, x28, [sp, #80]\n");
        // Save input boxes into callee-saved regs.
        s = s.write("    mov x19, x0\n");    // cmd box
        s = s.write("    mov x20, x1\n");    // args box
        s = s.write("    mov x21, x2\n");    // stdin box
        // Build cmdz: NUL-terminated cmd string. cmd_len + 1 bytes.
        s = s.write("    ldr x22, [x19, #8]\n");   // cmd_len
        s = s.write("    add x0, x22, #1\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x23, x0\n");          // cmdz
        s = s.write("    ldr x9, [x19]\n");        // cmd data
        s = s.write("    mov x10, #0\n");
        s = s.write(".Lsp_ccmd:\n");
        s = s.write("    cmp x10, x22\n");
        s = s.write("    b.ge .Lsp_ccmd_d\n");
        s = s.write("    ldrb w11, [x9, x10]\n");
        s = s.write("    strb w11, [x23, x10]\n");
        s = s.write("    add x10, x10, #1\n");
        s = s.write("    b .Lsp_ccmd\n");
        s = s.write(".Lsp_ccmd_d:\n");
        s = s.write("    mov w11, #0\n");
        s = s.write("    strb w11, [x23, x22]\n");
        // Build argv: (nargs + 2) * 8 bytes ptr slots.
        s = s.write("    ldr x22, [x20]\n");       // nargs
        s = s.write("    add x0, x22, #2\n");
        s = s.write("    lsl x0, x0, #3\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x24, x0\n");          // argv
        // argv[0] = cmdz
        s = s.write("    str x23, [x24]\n");
        // argv[i+1] = NUL-terminated copy of args[i] for i in 0..nargs.
        s = s.write("    mov x25, #0\n");          // i (reuses x25 — restored later if needed; safe before stdout buf)
        s = s.write(".Lsp_arg:\n");
        s = s.write("    cmp x25, x22\n");
        s = s.write("    b.ge .Lsp_arg_d\n");
        s = s.write("    add x9, x25, #1\n");
        s = s.write("    ldr x10, [x20, x9, lsl #3]\n");   // args[i] box
        s = s.write("    ldr x26, [x10, #8]\n");           // arg_len
        s = s.write("    add x0, x26, #1\n");
        s = s.write("    str x10, [sp, #128]\n");          // spill arg box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    ldr x10, [sp, #128]\n");          // reload arg box
        s = s.write("    ldr x9, [x10]\n");                // arg data
        s = s.write("    mov x11, #0\n");
        s = s.write(".Lsp_acopy:\n");
        s = s.write("    cmp x11, x26\n");
        s = s.write("    b.ge .Lsp_acopy_d\n");
        s = s.write("    ldrb w12, [x9, x11]\n");
        s = s.write("    strb w12, [x0, x11]\n");
        s = s.write("    add x11, x11, #1\n");
        s = s.write("    b .Lsp_acopy\n");
        s = s.write(".Lsp_acopy_d:\n");
        s = s.write("    mov w12, #0\n");
        s = s.write("    strb w12, [x0, x26]\n");
        s = s.write("    add x9, x25, #1\n");
        s = s.write("    str x0, [x24, x9, lsl #3]\n");
        s = s.write("    add x25, x25, #1\n");
        s = s.write("    b .Lsp_arg\n");
        s = s.write(".Lsp_arg_d:\n");
        // argv[nargs + 1] = NULL.
        s = s.write("    add x9, x22, #1\n");
        s = s.write("    mov x10, #0\n");
        s = s.write("    str x10, [x24, x9, lsl #3]\n");
        // Create 3 pipes via pipe2(fds, 0). Each pipe writes 2 fds.
        s = s.write("    add x0, sp, #96\n");      // in fds
        s = s.write("    mov x1, #0\n");
        s = s.write("    mov x8, #59\n");
        s = s.write("    svc #0\n");
        s = s.write("    add x0, sp, #104\n");     // out fds
        s = s.write("    mov x1, #0\n");
        s = s.write("    mov x8, #59\n");
        s = s.write("    svc #0\n");
        s = s.write("    add x0, sp, #112\n");     // err fds
        s = s.write("    mov x1, #0\n");
        s = s.write("    mov x8, #59\n");
        s = s.write("    svc #0\n");
        // fork via clone(SIGCHLD=17, 0, 0, 0, 0). Returns child pid in
        // parent, 0 in child.
        s = s.write("    mov x0, #17\n");
        s = s.write("    mov x1, #0\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    mov x3, #0\n");
        s = s.write("    mov x4, #0\n");
        s = s.write("    mov x8, #220\n");
        s = s.write("    svc #0\n");
        s = s.write("    cbnz x0, .Lsp_parent\n");
        // ---------- CHILD ----------
        // dup3(in_r, 0, 0); dup3(out_w, 1, 0); dup3(err_w, 2, 0).
        s = s.write("    ldr w0, [sp, #96]\n");    // in_r
        s = s.write("    mov x1, #0\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    mov x8, #24\n");
        s = s.write("    svc #0\n");
        s = s.write("    ldr w0, [sp, #108]\n");   // out_w
        s = s.write("    mov x1, #1\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    mov x8, #24\n");
        s = s.write("    svc #0\n");
        s = s.write("    ldr w0, [sp, #116]\n");   // err_w
        s = s.write("    mov x1, #2\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    mov x8, #24\n");
        s = s.write("    svc #0\n");
        // Close all 6 original pipe fds.
        s = s.write("    ldr w0, [sp, #96]\n  mov x8, #57\n  svc #0\n");
        s = s.write("    ldr w0, [sp, #100]\n  mov x8, #57\n  svc #0\n");
        s = s.write("    ldr w0, [sp, #104]\n  mov x8, #57\n  svc #0\n");
        s = s.write("    ldr w0, [sp, #108]\n  mov x8, #57\n  svc #0\n");
        s = s.write("    ldr w0, [sp, #112]\n  mov x8, #57\n  svc #0\n");
        s = s.write("    ldr w0, [sp, #116]\n  mov x8, #57\n  svc #0\n");
        // execve(cmdz, argv, envp). envp is the value of __fern_envp.
        s = s.write("    mov x0, x23\n");                         // cmdz
        s = s.write("    mov x1, x24\n");                         // argv
        s = s.write("    adrp x9, __fern_envp\n");
        s = s.write("    add x9, x9, :lo12:__fern_envp\n");
        s = s.write("    ldr x2, [x9]\n");                        // envp
        s = s.write("    mov x8, #221\n");
        s = s.write("    svc #0\n");
        // execve only returns on failure. Fall back to /bin/<cmd> and
        // /usr/bin/<cmd> so bare names like "echo" / "sh" / "cat"
        // resolve without re-implementing $PATH search.
        // Compute cmd_len (cmdz length).
        s = s.write("    mov x22, #0\n");                         // cmd_len
        s = s.write(".Lsp_clen:\n");
        s = s.write("    ldrb w9, [x23, x22]\n");
        s = s.write("    cbz w9, .Lsp_clen_d\n");
        s = s.write("    add x22, x22, #1\n");
        s = s.write("    b .Lsp_clen\n");
        s = s.write(".Lsp_clen_d:\n");
        // Try /bin/<cmd> (5 + cmd_len + 1).
        s = s.write("    add x0, x22, #6\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x25, x0\n");                         // path buf
        s = s.write("    mov w9, #47\n  strb w9, [x25]\n");       // '/'
        s = s.write("    mov w9, #98\n  strb w9, [x25, #1]\n");   // 'b'
        s = s.write("    mov w9, #105\n strb w9, [x25, #2]\n");   // 'i'
        s = s.write("    mov w9, #110\n strb w9, [x25, #3]\n");   // 'n'
        s = s.write("    mov w9, #47\n  strb w9, [x25, #4]\n");   // '/'
        s = s.write("    mov x10, #0\n");
        s = s.write(".Lsp_bcopy:\n");
        s = s.write("    cmp x10, x22\n");
        s = s.write("    b.ge .Lsp_bcopy_d\n");
        s = s.write("    ldrb w11, [x23, x10]\n");
        s = s.write("    add x9, x10, #5\n");
        s = s.write("    strb w11, [x25, x9]\n");
        s = s.write("    add x10, x10, #1\n");
        s = s.write("    b .Lsp_bcopy\n");
        s = s.write(".Lsp_bcopy_d:\n");
        s = s.write("    add x9, x22, #5\n");
        s = s.write("    mov w11, #0\n");
        s = s.write("    strb w11, [x25, x9]\n");                 // NUL
        s = s.write("    mov x0, x25\n");
        s = s.write("    mov x1, x24\n");
        s = s.write("    adrp x9, __fern_envp\n");
        s = s.write("    add x9, x9, :lo12:__fern_envp\n");
        s = s.write("    ldr x2, [x9]\n");
        s = s.write("    mov x8, #221\n");
        s = s.write("    svc #0\n");
        // Try /usr/bin/<cmd> (9 + cmd_len + 1).
        s = s.write("    add x0, x22, #10\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x25, x0\n");
        s = s.write("    mov w9, #47\n  strb w9, [x25]\n");
        s = s.write("    mov w9, #117\n strb w9, [x25, #1]\n");   // 'u'
        s = s.write("    mov w9, #115\n strb w9, [x25, #2]\n");   // 's'
        s = s.write("    mov w9, #114\n strb w9, [x25, #3]\n");   // 'r'
        s = s.write("    mov w9, #47\n  strb w9, [x25, #4]\n");
        s = s.write("    mov w9, #98\n  strb w9, [x25, #5]\n");
        s = s.write("    mov w9, #105\n strb w9, [x25, #6]\n");
        s = s.write("    mov w9, #110\n strb w9, [x25, #7]\n");
        s = s.write("    mov w9, #47\n  strb w9, [x25, #8]\n");
        s = s.write("    mov x10, #0\n");
        s = s.write(".Lsp_ucopy:\n");
        s = s.write("    cmp x10, x22\n");
        s = s.write("    b.ge .Lsp_ucopy_d\n");
        s = s.write("    ldrb w11, [x23, x10]\n");
        s = s.write("    add x9, x10, #9\n");
        s = s.write("    strb w11, [x25, x9]\n");
        s = s.write("    add x10, x10, #1\n");
        s = s.write("    b .Lsp_ucopy\n");
        s = s.write(".Lsp_ucopy_d:\n");
        s = s.write("    add x9, x22, #9\n");
        s = s.write("    mov w11, #0\n");
        s = s.write("    strb w11, [x25, x9]\n");
        s = s.write("    mov x0, x25\n");
        s = s.write("    mov x1, x24\n");
        s = s.write("    adrp x9, __fern_envp\n");
        s = s.write("    add x9, x9, :lo12:__fern_envp\n");
        s = s.write("    ldr x2, [x9]\n");
        s = s.write("    mov x8, #221\n");
        s = s.write("    svc #0\n");
        // All execve attempts failed → exit(127).
        s = s.write("    mov x0, #127\n");
        s = s.write("    mov x8, #93\n");
        s = s.write("    svc #0\n");
        // ---------- PARENT ----------
        s = s.write(".Lsp_parent:\n");
        s = s.write("    mov x22, x0\n");                         // child pid
        // Close child ends: in_r, out_w, err_w.
        s = s.write("    ldr w0, [sp, #96]\n   mov x8, #57\n  svc #0\n");
        s = s.write("    ldr w0, [sp, #108]\n  mov x8, #57\n  svc #0\n");
        s = s.write("    ldr w0, [sp, #116]\n  mov x8, #57\n  svc #0\n");
        // Write stdin payload (if any) to in_w, then close in_w.
        s = s.write("    ldr x2, [x21, #8]\n");                   // stdin len
        s = s.write("    cbz x2, .Lsp_close_in\n");
        s = s.write("    ldr w0, [sp, #100]\n");                  // in_w
        s = s.write("    ldr x1, [x21]\n");                       // stdin data
        s = s.write("    mov x8, #64\n");                         // write
        s = s.write("    svc #0\n");
        s = s.write(".Lsp_close_in:\n");
        s = s.write("    ldr w0, [sp, #100]\n  mov x8, #57\n  svc #0\n");
        // Read stdout to EOF into 64 KiB buf. x25 = buf, x26 = total.
        s = s.write("    mov x0, #65536\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x25, x0\n");
        s = s.write("    mov x26, #0\n");
        s = s.write(".Lsp_rdo:\n");
        s = s.write("    mov x2, #65536\n");
        s = s.write("    sub x2, x2, x26\n");
        s = s.write("    cmp x2, #0\n");
        s = s.write("    b.le .Lsp_rdo_d\n");
        s = s.write("    ldr w0, [sp, #104]\n");                  // out_r
        s = s.write("    add x1, x25, x26\n");
        s = s.write("    mov x8, #63\n");                         // read
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.le .Lsp_rdo_d\n");
        s = s.write("    add x26, x26, x0\n");
        s = s.write("    b .Lsp_rdo\n");
        s = s.write(".Lsp_rdo_d:\n");
        s = s.write("    ldr w0, [sp, #104]\n  mov x8, #57\n  svc #0\n");
        // Read stderr similarly. x27 = buf, x28 = total.
        s = s.write("    mov x0, #65536\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x27, x0\n");
        s = s.write("    mov x28, #0\n");
        s = s.write(".Lsp_rde:\n");
        s = s.write("    mov x2, #65536\n");
        s = s.write("    sub x2, x2, x28\n");
        s = s.write("    cmp x2, #0\n");
        s = s.write("    b.le .Lsp_rde_d\n");
        s = s.write("    ldr w0, [sp, #112]\n");                  // err_r
        s = s.write("    add x1, x27, x28\n");
        s = s.write("    mov x8, #63\n");
        s = s.write("    svc #0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    b.le .Lsp_rde_d\n");
        s = s.write("    add x28, x28, x0\n");
        s = s.write("    b .Lsp_rde\n");
        s = s.write(".Lsp_rde_d:\n");
        s = s.write("    ldr w0, [sp, #112]\n  mov x8, #57\n  svc #0\n");
        // wait4(pid, &status, 0, NULL).
        s = s.write("    mov x0, x22\n");
        s = s.write("    add x1, sp, #120\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    mov x3, #0\n");
        s = s.write("    mov x8, #260\n");
        s = s.write("    svc #0\n");
        // Decode exit status.
        s = s.write("    ldr w9, [sp, #120]\n");
        s = s.write("    and w10, w9, #127\n");                  // sig
        s = s.write("    cbnz w10, .Lsp_signaled\n");
        s = s.write("    lsr w9, w9, #8\n");
        s = s.write("    and w9, w9, #255\n");
        s = s.write("    b .Lsp_have_exit\n");
        s = s.write(".Lsp_signaled:\n");
        s = s.write("    and w9, w9, #127\n");
        s = s.write("    add w9, w9, #128\n");
        s = s.write(".Lsp_have_exit:\n");
        s = s.write("    mov x22, x9\n");                         // exit_code (full reg, x22)
        // Build stdout box {data=x25, len=x26}.
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x25, [x0]\n");
        s = s.write("    str x26, [x0, #8]\n");
        s = s.write("    mov x25, x0\n");                         // stdout box
        // Build stderr box {data=x27, len=x28}.
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x27, [x0]\n");
        s = s.write("    str x28, [x0, #8]\n");
        s = s.write("    mov x27, x0\n");                         // stderr box
        // Build ProcessResult struct: [shape, stdout, stderr, exit_code].
        s = s.write("    mov x0, #32\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    adrp x9, .S" + i32_to_string(prLitA.idx) + "\n");
        s = s.write("    add x9, x9, :lo12:.S" + i32_to_string(prLitA.idx) + "\n");
        s = s.write("    str x9, [x0]\n");
        s = s.write("    str x25, [x0, #8]\n");
        s = s.write("    str x27, [x0, #16]\n");
        s = s.write("    str x22, [x0, #24]\n");
        // Epilogue.
        s = s.write("    ldp x27, x28, [sp, #80]\n");
        s = s.write("    ldp x25, x26, [sp, #64]\n");
        s = s.write("    ldp x23, x24, [sp, #48]\n");
        s = s.write("    ldp x21, x22, [sp, #32]\n");
        s = s.write("    ldp x19, x20, [sp, #16]\n");
        s = s.write("    ldp x29, x30, [sp, #0]\n");
        s = s.write("    add sp, sp, #224\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_subprocess, .-__fern_subprocess\n");

        // __fern_f64_to_string(x0 = IEEE-754 f64 bits) → string box.
        // arm64 mirror of asm.fern: fixed-precision decimal matching
        // std/float's __float_to_string (k=15) — NaN → "NaN"; sign
        // split via fneg; Inf (x != 0 && x*2 == x) → "Inf"; integer
        // part via fcvtzs; fraction scaled by 1e15, truncated, then
        // zero-padded to 15 digits with trailing zeros trimmed. The 15
        // fraction digits stage in a 16-byte stack temp.
        s = s.write(".globl __fern_f64_to_string\n");
        s = s.write(".type __fern_f64_to_string, %function\n");
        s = s.write("__fern_f64_to_string:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    sub sp, sp, #32\n");          // 15-digit fraction temp
        s = s.write("    mov x22, x0\n");              // save bits
        s = s.write("    fmov d0, x0\n");
        s = s.write("    fcmp d0, d0\n");
        s = s.write("    b.vs .Lf2s_nan\n");           // unordered → NaN
        s = s.write("    mov x0, #64\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x19, x0\n");              // buffer
        s = s.write("    mov x20, #0\n");              // cursor
        s = s.write("    fmov d0, x22\n");             // reload x
        // sign
        s = s.write("    fcmp d0, #0.0\n");
        s = s.write("    b.ge .Lf2s_nonneg\n");
        s = s.write("    mov w9, #45\n");              // '-'
        s = s.write("    strb w9, [x19, x20]\n");
        s = s.write("    add x20, x20, #1\n");
        s = s.write("    fneg d0, d0\n");
        s = s.write(".Lf2s_nonneg:\n");
        // Inf: x != 0 && x*2 == x
        s = s.write("    fcmp d0, #0.0\n");
        s = s.write("    b.eq .Lf2s_notinf\n");
        s = s.write("    fmov d1, #2.0\n");
        s = s.write("    fmul d2, d0, d1\n");
        s = s.write("    fcmp d2, d0\n");
        s = s.write("    b.ne .Lf2s_notinf\n");
        s = s.write("    mov w9, #73\n");              // 'I'
        s = s.write("    strb w9, [x19, x20]\n");
        s = s.write("    add x20, x20, #1\n");
        s = s.write("    mov w9, #110\n");             // 'n'
        s = s.write("    strb w9, [x19, x20]\n");
        s = s.write("    add x20, x20, #1\n");
        s = s.write("    mov w9, #102\n");             // 'f'
        s = s.write("    strb w9, [x19, x20]\n");
        s = s.write("    add x20, x20, #1\n");
        s = s.write("    b .Lf2s_finish\n");
        s = s.write(".Lf2s_notinf:\n");
        s = s.write("    fcvtzs x21, d0\n");           // intPart
        // count int digits → x10
        s = s.write("    mov x9, x21\n");
        s = s.write("    mov x10, #0\n");
        s = s.write("    cbnz x9, .Lf2s_icnt\n");
        s = s.write("    mov x10, #1\n");
        s = s.write("    b .Lf2s_icntd\n");
        s = s.write(".Lf2s_icnt:\n");
        s = s.write("    cbz x9, .Lf2s_icntd\n");
        s = s.write("    mov x11, #10\n");
        s = s.write("    udiv x12, x9, x11\n");
        s = s.write("    mov x9, x12\n");
        s = s.write("    add x10, x10, #1\n");
        s = s.write("    b .Lf2s_icnt\n");
        s = s.write(".Lf2s_icntd:\n");
        s = s.write("    add x13, x20, x10\n");
        s = s.write("    sub x13, x13, #1\n");          // last pos
        s = s.write("    mov x9, x21\n");
        s = s.write("    mov x11, #10\n");
        s = s.write(".Lf2s_iwr:\n");
        s = s.write("    udiv x12, x9, x11\n");
        s = s.write("    msub x14, x12, x11, x9\n");    // rem
        s = s.write("    add x14, x14, #48\n");
        s = s.write("    strb w14, [x19, x13]\n");
        s = s.write("    sub x13, x13, #1\n");
        s = s.write("    mov x9, x12\n");
        s = s.write("    cbnz x9, .Lf2s_iwr\n");
        s = s.write("    add x20, x20, x10\n");         // cursor += intdigits
        // frac = x - intPart
        s = s.write("    scvtf d1, x21\n");
        s = s.write("    fsub d0, d0, d1\n");
        s = s.write("    fcmp d0, #0.0\n");
        s = s.write("    b.ge .Lf2s_fracpos\n");
        s = s.write("    fneg d0, d0\n");
        s = s.write(".Lf2s_fracpos:\n");
        s = s.write("    ldr x9, =4831355200913801216\n"); // 1e15
        s = s.write("    fmov d1, x9\n");
        s = s.write("    fmul d0, d0, d1\n");
        s = s.write("    fcvtzs x21, d0\n");           // fracInt
        // fill 15 padded digits temp[14..0]
        s = s.write("    mov x9, x21\n");
        s = s.write("    mov x13, #14\n");
        s = s.write(".Lf2s_ffill:\n");
        s = s.write("    mov x11, #10\n");
        s = s.write("    udiv x12, x9, x11\n");
        s = s.write("    msub x14, x12, x11, x9\n");
        s = s.write("    add x14, x14, #48\n");
        s = s.write("    strb w14, [sp, x13]\n");
        s = s.write("    sub x13, x13, #1\n");
        s = s.write("    mov x9, x12\n");
        s = s.write("    cmp x13, #0\n");
        s = s.write("    b.ge .Lf2s_ffill\n");
        // effective = 15 - trailing zeros
        s = s.write("    mov x21, #15\n");
        s = s.write(".Lf2s_ftrim:\n");
        s = s.write("    cbz x21, .Lf2s_fdone\n");
        s = s.write("    sub x14, x21, #1\n");
        s = s.write("    ldrb w11, [sp, x14]\n");
        s = s.write("    cmp w11, #48\n");
        s = s.write("    b.ne .Lf2s_fdone\n");
        s = s.write("    sub x21, x21, #1\n");
        s = s.write("    b .Lf2s_ftrim\n");
        s = s.write(".Lf2s_fdone:\n");
        s = s.write("    cbz x21, .Lf2s_finish\n");
        s = s.write("    mov w9, #46\n");              // '.'
        s = s.write("    strb w9, [x19, x20]\n");
        s = s.write("    add x20, x20, #1\n");
        s = s.write("    mov x9, #0\n");
        s = s.write(".Lf2s_fcopy:\n");
        s = s.write("    cmp x9, x21\n");
        s = s.write("    b.ge .Lf2s_finish\n");
        s = s.write("    ldrb w11, [sp, x9]\n");
        s = s.write("    strb w11, [x19, x20]\n");
        s = s.write("    add x20, x20, #1\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lf2s_fcopy\n");
        s = s.write(".Lf2s_finish:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x19, [x0]\n");
        s = s.write("    str x20, [x0, #8]\n");
        s = s.write("    b .Lf2s_ret\n");
        s = s.write(".Lf2s_nan:\n");
        s = s.write("    mov x0, #4\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    mov w9, #78\n");              // 'N'
        s = s.write("    strb w9, [x19]\n");
        s = s.write("    mov w9, #97\n");              // 'a'
        s = s.write("    strb w9, [x19, #1]\n");
        s = s.write("    mov w9, #78\n");              // 'N'
        s = s.write("    strb w9, [x19, #2]\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x19, [x0]\n");
        s = s.write("    mov x9, #3\n");
        s = s.write("    str x9, [x0, #8]\n");
        s = s.write(".Lf2s_ret:\n");
        s = s.write("    add sp, sp, #32\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_f64_to_string, .-__fern_f64_to_string\n");

        // __fern_alloc_u8(x0 = n) → fresh n-element array (cap header,
        // 8-byte slots, returned base+8). Elements start zero (.bss).
        s = s.write(".globl __fern_alloc_u8\n");
        s = s.write(".type __fern_alloc_u8, %function\n");
        s = s.write("__fern_alloc_u8:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // n
        s = s.write("    add x0, x19, #2\n");       // (n+2)*8 bytes
        s = s.write("    lsl x0, x0, #3\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x19, [x0]\n");          // cap
        s = s.write("    add x0, x0, #8\n");
        s = s.write("    str x19, [x0]\n");          // len
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_alloc_u8, .-__fern_alloc_u8\n");

        // __fern_string_from_bytes(x0 = arr ptr) → string box: pack
        // the low byte of each element slot into a len-byte buffer.
        s = s.write(".globl __fern_string_from_bytes\n");
        s = s.write(".type __fern_string_from_bytes, %function\n");
        s = s.write("__fern_string_from_bytes:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // arr
        s = s.write("    ldr x20, [x19]\n");         // len
        s = s.write("    mov x0, x20\n");
        s = s.write("    bl __fern_alloc\n");        // len-byte buffer
        s = s.write("    mov x21, x0\n");            // data buf
        s = s.write("    mov x22, #0\n");            // i
        s = s.write(".Lsfb_loop:\n");
        s = s.write("    cmp x22, x20\n");
        s = s.write("    b.ge .Lsfb_done\n");
        s = s.write("    add x9, x22, #1\n");
        s = s.write("    ldr x10, [x19, x9, lsl #3]\n");  // slot (i+1)*8
        s = s.write("    strb w10, [x21, x22]\n");        // low byte
        s = s.write("    add x22, x22, #1\n");
        s = s.write("    b .Lsfb_loop\n");
        s = s.write(".Lsfb_done:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x21, [x0]\n");          // data@0
        s = s.write("    str x20, [x0, #8]\n");      // len@8
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_string_from_bytes, .-__fern_string_from_bytes\n");

        // __fern_random_bytes(x0 = n) → string box of n random bytes
        // via getrandom (aarch64 syscall 278).
        s = s.write(".globl __fern_random_bytes\n");
        s = s.write(".type __fern_random_bytes, %function\n");
        s = s.write("__fern_random_bytes:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // n
        s = s.write("    bl __fern_alloc\n");        // alloc n bytes (x0 = n)
        s = s.write("    mov x20, x0\n");           // buf
        s = s.write("    mov x0, x20\n");           // getrandom(buf, n, 0)
        s = s.write("    mov x1, x19\n");
        s = s.write("    mov x2, #0\n");
        s = s.write("    mov x8, #278\n");          // sys_getrandom
        s = s.write("    svc #0\n");
        s = s.write("    mov x0, #16\n");           // string box
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x20, [x0]\n");          // data@0
        s = s.write("    str x19, [x0, #8]\n");      // len@8
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_random_bytes, .-__fern_random_bytes\n");

        // __fern_i32_gcd(x0 = n, x1 = other) → gcd(|n|, |other|) by
        // Euclid. Mirrors std/i32.gcd. (x9-x13 are temps; leaf fn.)
        s = s.write(".globl __fern_i32_gcd\n");
        s = s.write(".type __fern_i32_gcd, %function\n");
        s = s.write("__fern_i32_gcd:\n");
        s = s.write("    neg x10, x0\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    csel x9, x10, x0, lt\n");    // a = |n|
        s = s.write("    neg x10, x1\n");
        s = s.write("    cmp x1, #0\n");
        s = s.write("    csel x11, x10, x1, lt\n");   // b = |other|
        s = s.write(".Lgcd_loop:\n");
        s = s.write("    cbz x11, .Lgcd_done\n");
        s = s.write("    mov x12, x11\n");            // t = b
        s = s.write("    sdiv x13, x9, x11\n");       // q = a / b
        s = s.write("    msub x11, x13, x11, x9\n");  // b = a - q*b = a%b
        s = s.write("    mov x9, x12\n");             // a = t
        s = s.write("    b .Lgcd_loop\n");
        s = s.write(".Lgcd_done:\n");
        s = s.write("    mov x0, x9\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_i32_gcd, .-__fern_i32_gcd\n");

        // __fern_i32_lcm(x0 = n, x1 = other) → lcm. Mirrors
        // std/i32.lcm: 0 if either is 0, else |n/gcd| * |other|.
        s = s.write(".globl __fern_i32_lcm\n");
        s = s.write(".type __fern_i32_lcm, %function\n");
        s = s.write("__fern_i32_lcm:\n");
        s = s.write("    cbz x0, .Llcm_zero\n");
        s = s.write("    cbz x1, .Llcm_zero\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");             // n
        s = s.write("    mov x20, x1\n");             // other
        s = s.write("    bl __fern_i32_gcd\n");       // x0 = g
        s = s.write("    sdiv x1, x19, x0\n");        // n / g
        s = s.write("    neg x2, x1\n");
        s = s.write("    cmp x1, #0\n");
        s = s.write("    csel x1, x2, x1, lt\n");     // |n/g|
        s = s.write("    neg x2, x20\n");
        s = s.write("    cmp x20, #0\n");
        s = s.write("    csel x2, x2, x20, lt\n");    // |other|
        s = s.write("    mul x0, x1, x2\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".Llcm_zero:\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_i32_lcm, .-__fern_i32_lcm\n");
    }
    // Map runtime (string-keyed, 8-byte values). Mirror of asm.fern's
    // x86-64 runtime. A Map is a 16-byte box [keys: string[] @0,
    // values: T[] @8]; linear scan + str_eq; set/get grow via
    // __fern_arr_push. Gated on (arr_push && str_eq), both marked at
    // every map op.
    if (s.needs_arr_push && s.needs_str_eq) {
        // __fern_map_new(x0 = capacity hint, ignored) → empty map box.
        s = s.write(".globl __fern_map_new\n");
        s = s.write(".type __fern_map_new, %function\n");
        s = s.write("__fern_map_new:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");          // mapbox
        s = s.write("    mov x19, x0\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    bl __fern_alloc_u8\n");        // empty keys
        s = s.write("    str x0, [x19]\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    bl __fern_alloc_u8\n");        // empty values
        s = s.write("    str x0, [x19, #8]\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_new, .-__fern_map_new\n");

        // __fern_map_set(x0 = mapbox, x1 = key, x2 = val) → mapbox.
        // Updates in place on a key hit, else appends.
        s = s.write(".globl __fern_map_set\n");
        s = s.write(".type __fern_map_set, %function\n");
        s = s.write("__fern_map_set:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // mapbox
        s = s.write("    mov x20, x1\n");           // key
        s = s.write("    mov x21, x2\n");           // val
        s = s.write("    ldr x22, [x19]\n");        // keys arr
        s = s.write("    mov x23, #0\n");           // i
        s = s.write("    cbnz x3, .Lms_loop_i32\n"); // keykind (1 = i32)
        s = s.write(".Lms_loop:\n");                 // string-key loop
        s = s.write("    ldr x9, [x22]\n");         // keys.len
        s = s.write("    cmp x23, x9\n");
        s = s.write("    b.ge .Lms_append\n");
        s = s.write("    add x9, x23, #1\n");
        s = s.write("    ldr x0, [x22, x9, lsl #3]\n");  // keys[i+1]
        s = s.write("    mov x1, x20\n");
        s = s.write("    bl __fern_str_eq\n");
        s = s.write("    cbnz x0, .Lms_found\n");
        s = s.write("    add x23, x23, #1\n");
        s = s.write("    b .Lms_loop\n");
        s = s.write(".Lms_loop_i32:\n");             // i32-key loop
        s = s.write("    ldr x9, [x22]\n");
        s = s.write("    cmp x23, x9\n");
        s = s.write("    b.ge .Lms_append\n");
        s = s.write("    add x9, x23, #1\n");
        s = s.write("    ldr x9, [x22, x9, lsl #3]\n");  // keys[i+1]
        s = s.write("    cmp x9, x20\n");
        s = s.write("    b.eq .Lms_found\n");
        s = s.write("    add x23, x23, #1\n");
        s = s.write("    b .Lms_loop_i32\n");
        s = s.write(".Lms_found:\n");
        s = s.write("    ldr x9, [x19, #8]\n");      // values arr
        s = s.write("    add x10, x23, #1\n");
        s = s.write("    str x21, [x9, x10, lsl #3]\n");  // values[i+1] = val
        s = s.write("    b .Lms_ret\n");
        s = s.write(".Lms_append:\n");
        s = s.write("    ldr x0, [x19]\n");
        s = s.write("    mov x1, x20\n");
        s = s.write("    bl __fern_arr_push\n");      // keys.push(key)
        s = s.write("    str x0, [x19]\n");
        s = s.write("    ldr x0, [x19, #8]\n");
        s = s.write("    mov x1, x21\n");
        s = s.write("    bl __fern_arr_push\n");      // values.push(val)
        s = s.write("    str x0, [x19, #8]\n");
        s = s.write(".Lms_ret:\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_set, .-__fern_map_set\n");

        // __fern_map_get(x0 = mapbox, x1 = key) → Option[V]:
        // Some(values[i]) on hit, None otherwise.
        s = s.write(".globl __fern_map_get\n");
        s = s.write(".type __fern_map_get, %function\n");
        s = s.write("__fern_map_get:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // mapbox
        s = s.write("    mov x20, x1\n");           // key
        s = s.write("    ldr x21, [x19]\n");        // keys arr
        s = s.write("    mov x22, #0\n");
        s = s.write("    cbnz x2, .Lmg_loop_i32\n"); // keykind (1 = i32)
        s = s.write(".Lmg_loop:\n");                 // string-key loop
        s = s.write("    ldr x9, [x21]\n");
        s = s.write("    cmp x22, x9\n");
        s = s.write("    b.ge .Lmg_none\n");
        s = s.write("    add x9, x22, #1\n");
        s = s.write("    ldr x0, [x21, x9, lsl #3]\n");
        s = s.write("    mov x1, x20\n");
        s = s.write("    bl __fern_str_eq\n");
        s = s.write("    cbnz x0, .Lmg_found\n");
        s = s.write("    add x22, x22, #1\n");
        s = s.write("    b .Lmg_loop\n");
        s = s.write(".Lmg_loop_i32:\n");             // i32-key loop
        s = s.write("    ldr x9, [x21]\n");
        s = s.write("    cmp x22, x9\n");
        s = s.write("    b.ge .Lmg_none\n");
        s = s.write("    add x9, x22, #1\n");
        s = s.write("    ldr x9, [x21, x9, lsl #3]\n");
        s = s.write("    cmp x9, x20\n");
        s = s.write("    b.eq .Lmg_found\n");
        s = s.write("    add x22, x22, #1\n");
        s = s.write("    b .Lmg_loop_i32\n");
        s = s.write(".Lmg_found:\n");
        s = s.write("    ldr x9, [x19, #8]\n");      // values arr
        s = s.write("    add x10, x22, #1\n");
        s = s.write("    ldr x20, [x9, x10, lsl #3]\n");  // values[i+1]
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");          // Some box
        s = s.write("    mov x9, #0\n");
        s = s.write("    str x9, [x0]\n");             // tag = Some
        s = s.write("    str x20, [x0, #8]\n");        // payload
        s = s.write("    b .Lmg_ret\n");
        s = s.write(".Lmg_none:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");          // None box
        s = s.write("    mov x9, #1\n");
        s = s.write("    str x9, [x0]\n");             // tag = None
        s = s.write(".Lmg_ret:\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_get, .-__fern_map_get\n");

        // __fern_map_has(x0 = mapbox, x1 = key) → 0/1.
        s = s.write(".globl __fern_map_has\n");
        s = s.write(".type __fern_map_has, %function\n");
        s = s.write("__fern_map_has:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    mov x20, x1\n");
        s = s.write("    ldr x21, [x19]\n");
        s = s.write("    mov x22, #0\n");
        s = s.write("    cbnz x2, .Lmh_loop_i32\n"); // keykind (1 = i32)
        s = s.write(".Lmh_loop:\n");                 // string-key loop
        s = s.write("    ldr x9, [x21]\n");
        s = s.write("    cmp x22, x9\n");
        s = s.write("    b.ge .Lmh_no\n");
        s = s.write("    add x9, x22, #1\n");
        s = s.write("    ldr x0, [x21, x9, lsl #3]\n");
        s = s.write("    mov x1, x20\n");
        s = s.write("    bl __fern_str_eq\n");
        s = s.write("    cbnz x0, .Lmh_yes\n");
        s = s.write("    add x22, x22, #1\n");
        s = s.write("    b .Lmh_loop\n");
        s = s.write(".Lmh_loop_i32:\n");             // i32-key loop
        s = s.write("    ldr x9, [x21]\n");
        s = s.write("    cmp x22, x9\n");
        s = s.write("    b.ge .Lmh_no\n");
        s = s.write("    add x9, x22, #1\n");
        s = s.write("    ldr x9, [x21, x9, lsl #3]\n");
        s = s.write("    cmp x9, x20\n");
        s = s.write("    b.eq .Lmh_yes\n");
        s = s.write("    add x22, x22, #1\n");
        s = s.write("    b .Lmh_loop_i32\n");
        s = s.write(".Lmh_yes:\n");
        s = s.write("    mov x0, #1\n");
        s = s.write("    b .Lmh_ret\n");
        s = s.write(".Lmh_no:\n");
        s = s.write("    mov x0, #0\n");
        s = s.write(".Lmh_ret:\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __fern_map_has, .-__fern_map_has\n");
    }
    // f64 transcendental runtime functions (always emitted; arm64 has
    // no transcendental instructions, unlike x86's x87 FPU). Polynomial
    // approximations validated to <1e-5 against libm. Each takes its
    // arg in d0 (pow also d1) and returns in d0; x12 is the constant-
    // address scratch (see emit_ldc). Coefficients live in .rodata.
    s = s.write("    .section .rodata\n");
    s = s.write("    .align 8\n");
    s = s.write(".Lfc_log2e: .double 1.4426950408889634\n");
    s = s.write(".Lfc_ln2: .double 0.6931471805599453\n");
    s = s.write(".Lfc_halfpi: .double 1.5707963267948966\n");
    s = s.write(".Lfc_sqrt2: .double 1.4142135623730951\n");
    s = s.write(".Lfc_one: .double 1.0\n");
    s = s.write(".Lfc_half: .double 0.5\n");
    s = s.write(".Lfc_e7: .double 0.00019841269841269841\n");
    s = s.write(".Lfc_e6: .double 0.0013888888888888889\n");
    s = s.write(".Lfc_e5: .double 0.0083333333333333332\n");
    s = s.write(".Lfc_e4: .double 0.041666666666666664\n");
    s = s.write(".Lfc_e3: .double 0.16666666666666666\n");
    s = s.write(".Lfc_s7: .double -0.00019841269841269841\n");
    s = s.write(".Lfc_s5: .double 0.0083333333333333332\n");
    s = s.write(".Lfc_s3: .double -0.16666666666666666\n");
    s = s.write(".Lfc_c6: .double -0.0013888888888888889\n");
    s = s.write(".Lfc_c4: .double 0.041666666666666664\n");
    s = s.write(".Lfc_c2: .double -0.5\n");
    s = s.write(".Lfc_l11: .double 0.090909090909090912\n");
    s = s.write(".Lfc_l9: .double 0.1111111111111111\n");
    s = s.write(".Lfc_l7: .double 0.14285714285714285\n");
    s = s.write(".Lfc_l5: .double 0.2\n");
    s = s.write(".Lfc_l3: .double 0.33333333333333331\n");
    s = s.write("    .text\n");

    // __fern_exp_f64(d0 = x) → e^x. exp(x) = 2^k · poly(r), where
    // k = round(x·log2 e), r = x − k·ln2 ∈ [−ln2/2, ln2/2]. poly is a
    // degree-7 Taylor of e^r; 2^k is built directly in the exponent bits.
    s = s.write(".globl __fern_exp_f64\n");
    s = s.write(".type __fern_exp_f64, %function\n");
    s = s.write("__fern_exp_f64:\n");
    s = emit_ldc(s, "d1", ".Lfc_log2e");
    s = s.write("    fmul d2, d0, d1\n");        // t = x*log2e
    s = s.write("    frinta d3, d2\n");          // kf = round(t)
    s = s.write("    fcvtzs x10, d3\n");         // ki
    s = emit_ldc(s, "d4", ".Lfc_ln2");
    s = s.write("    fmul d5, d3, d4\n");        // kf*ln2
    s = s.write("    fsub d0, d0, d5\n");        // r
    s = emit_ldc(s, "d6", ".Lfc_e7");
    s = emit_ldc(s, "d7", ".Lfc_e6");
    s = s.write("    fmul d6, d6, d0\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = emit_ldc(s, "d7", ".Lfc_e5");
    s = s.write("    fmul d6, d6, d0\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = emit_ldc(s, "d7", ".Lfc_e4");
    s = s.write("    fmul d6, d6, d0\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = emit_ldc(s, "d7", ".Lfc_e3");
    s = s.write("    fmul d6, d6, d0\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = emit_ldc(s, "d7", ".Lfc_half");
    s = s.write("    fmul d6, d6, d0\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = emit_ldc(s, "d7", ".Lfc_one");
    s = s.write("    fmul d6, d6, d0\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = s.write("    fmul d6, d6, d0\n");
    s = s.write("    fadd d6, d6, d7\n");        // poly(r) = e^r
    s = s.write("    add x10, x10, #1023\n");
    s = s.write("    lsl x10, x10, #52\n");
    s = s.write("    fmov d1, x10\n");           // 2^ki
    s = s.write("    fmul d0, d6, d1\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_exp_f64, .-__fern_exp_f64\n");

    // __fern_log_f64(d0 = x) → ln x (x > 0). Decompose x = m·2^e with
    // m ∈ [1,2); normalize m to [√2/2, √2) so f = (m−1)/(m+1) is small;
    // ln(m) = 2·(f + f³/3 + … + f¹¹/11); ln(x) = e·ln2 + ln(m).
    s = s.write(".globl __fern_log_f64\n");
    s = s.write(".type __fern_log_f64, %function\n");
    s = s.write("__fern_log_f64:\n");
    s = s.write("    fmov x10, d0\n");           // bits
    s = s.write("    lsr x11, x10, #52\n");
    s = s.write("    and x11, x11, #0x7ff\n");
    s = s.write("    sub x11, x11, #1023\n");     // e
    s = s.write("    mov x13, #1\n");
    s = s.write("    lsl x13, x13, #52\n");
    s = s.write("    sub x13, x13, #1\n");        // mask (1<<52)-1
    s = s.write("    and x10, x10, x13\n");       // mantissa
    s = s.write("    mov x14, #1023\n");
    s = s.write("    lsl x14, x14, #52\n");
    s = s.write("    orr x10, x10, x14\n");
    s = s.write("    fmov d1, x10\n");            // m in [1,2)
    s = emit_ldc(s, "d2", ".Lfc_sqrt2");
    s = s.write("    fcmp d1, d2\n");
    s = s.write("    b.le .Llog_nohalf\n");
    s = emit_ldc(s, "d3", ".Lfc_half");
    s = s.write("    fmul d1, d1, d3\n");
    s = s.write("    add x11, x11, #1\n");
    s = s.write(".Llog_nohalf:\n");
    s = emit_ldc(s, "d4", ".Lfc_one");
    s = s.write("    fsub d5, d1, d4\n");         // m-1
    s = s.write("    fadd d6, d1, d4\n");         // m+1
    s = s.write("    fdiv d0, d5, d6\n");         // f
    s = s.write("    fmul d7, d0, d0\n");         // f2
    s = emit_ldc(s, "d2", ".Lfc_l11");
    s = emit_ldc(s, "d3", ".Lfc_l9");
    s = s.write("    fmul d2, d2, d7\n");
    s = s.write("    fadd d2, d2, d3\n");
    s = emit_ldc(s, "d3", ".Lfc_l7");
    s = s.write("    fmul d2, d2, d7\n");
    s = s.write("    fadd d2, d2, d3\n");
    s = emit_ldc(s, "d3", ".Lfc_l5");
    s = s.write("    fmul d2, d2, d7\n");
    s = s.write("    fadd d2, d2, d3\n");
    s = emit_ldc(s, "d3", ".Lfc_l3");
    s = s.write("    fmul d2, d2, d7\n");
    s = s.write("    fadd d2, d2, d3\n");
    s = s.write("    fmul d2, d2, d7\n");
    s = s.write("    fadd d2, d2, d4\n");         // poly + 1
    s = s.write("    fmul d2, d2, d0\n");         // f*poly
    s = s.write("    fadd d2, d2, d2\n");         // 2*f*poly = ln(m)
    s = s.write("    scvtf d3, x11\n");           // e
    s = emit_ldc(s, "d4", ".Lfc_ln2");
    s = s.write("    fmul d3, d3, d4\n");         // e*ln2
    s = s.write("    fadd d0, d3, d2\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_log_f64, .-__fern_log_f64\n");

    // __fern_sin_f64(d0 = x) → sin x. Range-reduce k = round(x/(π/2)),
    // r = x − k·(π/2) ∈ [−π/4, π/4]; quadrant q = k & 3 selects ±sin(r)
    // / ±cos(r). sin(r), cos(r) are Taylor polynomials in r.
    s = s.write(".globl __fern_sin_f64\n");
    s = s.write(".type __fern_sin_f64, %function\n");
    s = s.write("__fern_sin_f64:\n");
    s = emit_ldc(s, "d1", ".Lfc_halfpi");
    s = s.write("    fdiv d2, d0, d1\n");
    s = s.write("    frinta d3, d2\n");
    s = s.write("    fcvtzs x10, d3\n");
    s = s.write("    fmul d4, d3, d1\n");
    s = s.write("    fsub d0, d0, d4\n");         // r
    s = s.write("    and x10, x10, #3\n");        // quadrant
    s = s.write("    fmul d5, d0, d0\n");         // r2
    s = emit_ldc(s, "d6", ".Lfc_s7");
    s = emit_ldc(s, "d7", ".Lfc_s5");
    s = s.write("    fmul d6, d6, d5\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = emit_ldc(s, "d7", ".Lfc_s3");
    s = s.write("    fmul d6, d6, d5\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = emit_ldc(s, "d7", ".Lfc_one");
    s = s.write("    fmul d6, d6, d5\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = s.write("    fmul d6, d6, d0\n");         // sin(r)
    s = emit_ldc(s, "d16", ".Lfc_c6");
    s = emit_ldc(s, "d17", ".Lfc_c4");
    s = s.write("    fmul d16, d16, d5\n");
    s = s.write("    fadd d16, d16, d17\n");
    s = emit_ldc(s, "d17", ".Lfc_c2");
    s = s.write("    fmul d16, d16, d5\n");
    s = s.write("    fadd d16, d16, d17\n");
    s = emit_ldc(s, "d17", ".Lfc_one");
    s = s.write("    fmul d16, d16, d5\n");
    s = s.write("    fadd d16, d16, d17\n");      // cos(r)
    s = s.write("    cmp x10, #0\n");
    s = s.write("    b.eq .Lsin_sr\n");
    s = s.write("    cmp x10, #1\n");
    s = s.write("    b.eq .Lsin_cr\n");
    s = s.write("    cmp x10, #2\n");
    s = s.write("    b.eq .Lsin_nsr\n");
    s = s.write("    fneg d0, d16\n");            // q3: -cos(r)
    s = s.write("    ret\n");
    s = s.write(".Lsin_sr:\n");
    s = s.write("    fmov d0, d6\n");
    s = s.write("    ret\n");
    s = s.write(".Lsin_cr:\n");
    s = s.write("    fmov d0, d16\n");
    s = s.write("    ret\n");
    s = s.write(".Lsin_nsr:\n");
    s = s.write("    fneg d0, d6\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_sin_f64, .-__fern_sin_f64\n");

    // __fern_cos_f64(d0 = x) → cos x. Same reduction as sin; quadrant
    // selects cos(r) / −sin(r) / −cos(r) / sin(r).
    s = s.write(".globl __fern_cos_f64\n");
    s = s.write(".type __fern_cos_f64, %function\n");
    s = s.write("__fern_cos_f64:\n");
    s = emit_ldc(s, "d1", ".Lfc_halfpi");
    s = s.write("    fdiv d2, d0, d1\n");
    s = s.write("    frinta d3, d2\n");
    s = s.write("    fcvtzs x10, d3\n");
    s = s.write("    fmul d4, d3, d1\n");
    s = s.write("    fsub d0, d0, d4\n");         // r
    s = s.write("    and x10, x10, #3\n");
    s = s.write("    fmul d5, d0, d0\n");         // r2
    s = emit_ldc(s, "d6", ".Lfc_s7");
    s = emit_ldc(s, "d7", ".Lfc_s5");
    s = s.write("    fmul d6, d6, d5\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = emit_ldc(s, "d7", ".Lfc_s3");
    s = s.write("    fmul d6, d6, d5\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = emit_ldc(s, "d7", ".Lfc_one");
    s = s.write("    fmul d6, d6, d5\n");
    s = s.write("    fadd d6, d6, d7\n");
    s = s.write("    fmul d6, d6, d0\n");         // sin(r)
    s = emit_ldc(s, "d16", ".Lfc_c6");
    s = emit_ldc(s, "d17", ".Lfc_c4");
    s = s.write("    fmul d16, d16, d5\n");
    s = s.write("    fadd d16, d16, d17\n");
    s = emit_ldc(s, "d17", ".Lfc_c2");
    s = s.write("    fmul d16, d16, d5\n");
    s = s.write("    fadd d16, d16, d17\n");
    s = emit_ldc(s, "d17", ".Lfc_one");
    s = s.write("    fmul d16, d16, d5\n");
    s = s.write("    fadd d16, d16, d17\n");      // cos(r)
    s = s.write("    cmp x10, #0\n");
    s = s.write("    b.eq .Lcos_cr\n");
    s = s.write("    cmp x10, #1\n");
    s = s.write("    b.eq .Lcos_nsr\n");
    s = s.write("    cmp x10, #2\n");
    s = s.write("    b.eq .Lcos_ncr\n");
    s = s.write("    fmov d0, d6\n");             // q3: sin(r)
    s = s.write("    ret\n");
    s = s.write(".Lcos_cr:\n");
    s = s.write("    fmov d0, d16\n");
    s = s.write("    ret\n");
    s = s.write(".Lcos_nsr:\n");
    s = s.write("    fneg d0, d6\n");
    s = s.write("    ret\n");
    s = s.write(".Lcos_ncr:\n");
    s = s.write("    fneg d0, d16\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_cos_f64, .-__fern_cos_f64\n");

    // __fern_pow_f64(d0 = x, d1 = y) → x^y = exp(y·ln x), x > 0.
    // Non-leaf: stashes y in callee-saved d8 across the log call.
    s = s.write(".globl __fern_pow_f64\n");
    s = s.write(".type __fern_pow_f64, %function\n");
    s = s.write("__fern_pow_f64:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    str d8, [sp, #-16]!\n");
    s = s.write("    fmov d8, d1\n");             // y
    s = s.write("    bl __fern_log_f64\n");       // d0 = ln(x)
    s = s.write("    fmul d0, d8, d0\n");         // y*ln(x)
    s = s.write("    bl __fern_exp_f64\n");
    s = s.write("    ldr d8, [sp], #16\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_pow_f64, .-__fern_pow_f64\n");

    // Command-line args. Mirror of asm.fern.
    if (s.needs_args) {
        s = s.write("    .section .bss\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_argc: .quad 0\n");
        s = s.write("    .align 8\n");
        s = s.write("__fern_argv: .quad 0\n");
        s = s.write("    .section .text\n");
        s = s.write("__fern_arg_at:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    adrp x1, __fern_argv\n");
        s = s.write("    add x1, x1, :lo12:__fern_argv\n");
        s = s.write("    ldr x1, [x1]\n");
        s = s.write("    ldr x19, [x1, x0, lsl #3]\n");   // argv[i]
        s = s.write("    mov x2, x19\n");
        s = s.write("    mov x20, #0\n");
        s = s.write(".Larg_strlen:\n");
        s = s.write("    ldrb w0, [x2]\n");
        s = s.write("    cbz w0, .Larg_done\n");
        s = s.write("    add x2, x2, #1\n");
        s = s.write("    add x20, x20, #1\n");
        s = s.write("    b .Larg_strlen\n");
        s = s.write(".Larg_done:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x19, [x0]\n");
        s = s.write("    str x20, [x0, #8]\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        // __fern_args: → string[] of all argv entries. Builds the
        // cap-header array layout ([cap, len, e0…] at base B, returned
        // B+8) and fills it with one __fern_arg_at box per argument.
        s = s.write("__fern_args:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    adrp x19, __fern_argc\n");
        s = s.write("    add x19, x19, :lo12:__fern_argc\n");
        s = s.write("    ldr x19, [x19]\n");        // argc
        s = s.write("    add x0, x19, #2\n");       // (argc+2)*8 bytes
        s = s.write("    lsl x0, x0, #3\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x19, [x0]\n");         // cap
        s = s.write("    add x0, x0, #8\n");
        s = s.write("    str x19, [x0]\n");         // len
        s = s.write("    mov x20, x0\n");           // arr (base+8)
        s = s.write("    mov x21, #0\n");           // i
        s = s.write(".Largs_loop:\n");
        s = s.write("    cmp x21, x19\n");
        s = s.write("    b.ge .Largs_done\n");
        s = s.write("    mov x0, x21\n");
        s = s.write("    bl __fern_arg_at\n");
        s = s.write("    add x22, x21, #1\n");
        s = s.write("    str x0, [x20, x22, lsl #3]\n");  // arr[i+1] = box
        s = s.write("    add x21, x21, #1\n");
        s = s.write("    b .Largs_loop\n");
        s = s.write(".Largs_done:\n");
        s = s.write("    mov x0, x20\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // __fern_arr_push: append an 8-byte payload to an array.
    // x0 = arr ptr (returned form, [len@0, e_i@(i+1)*8]; capacity
    // hidden at -8), x1 = value. Amortised O(1): mutate in place when
    // len < cap, else alloc a doubled buffer ([cap, len, …] at base
    // B, returned B+8), copy, return the new pointer. Mirrors the
    // x86-64 emitter; replaces the old O(N²) fresh-copy-every-push.
    if (s.needs_arr_push) {
        s = s.write("__fern_arr_push:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // arr ptr
        s = s.write("    mov x20, x1\n");           // value
        s = s.write("    ldr x21, [x19]\n");        // len
        s = s.write("    ldur x22, [x19, #-8]\n");  // cap (hidden at -8)
        s = s.write("    cmp x21, x22\n");
        s = s.write("    b.ge .Larr_push_grow\n");  // len >= cap → grow
        // In place: store value at slot (len+1), bump len.
        s = s.write("    add x1, x21, #1\n");
        s = s.write("    str x20, [x19, x1, lsl #3]\n");
        s = s.write("    add x21, x21, #1\n");
        s = s.write("    str x21, [x19]\n");
        s = s.write("    mov x0, x19\n");
        s = s.write("    b .Larr_push_ret\n");
        s = s.write(".Larr_push_grow:\n");
        // newcap = cap == 0 ? 4 : cap * 2.
        s = s.write("    cmp x22, #0\n");
        s = s.write("    b.ne .Larr_push_dbl\n");
        s = s.write("    mov x2, #4\n");
        s = s.write("    b .Larr_push_cap\n");
        s = s.write(".Larr_push_dbl:\n");
        s = s.write("    lsl x2, x22, #1\n");
        s = s.write(".Larr_push_cap:\n");
        s = s.write("    mov x22, x2\n");           // x22 = newcap
        s = s.write("    add x0, x2, #2\n");
        s = s.write("    lsl x0, x0, #3\n");
        s = s.write("    bl __fern_alloc\n");        // base in x0
        s = s.write("    str x22, [x0]\n");          // cap at base
        s = s.write("    add x0, x0, #8\n");         // returned ptr = base+8
        s = s.write("    add x1, x21, #1\n");
        s = s.write("    str x1, [x0]\n");           // new len = old+1
        // Copy old elements (slots 1..len) from old arr to new.
        s = s.write("    mov x2, #1\n");
        s = s.write(".Larr_push_copy:\n");
        s = s.write("    cmp x2, x21\n");
        s = s.write("    b.gt .Larr_push_copy_done\n");
        s = s.write("    ldr x3, [x19, x2, lsl #3]\n");
        s = s.write("    str x3, [x0, x2, lsl #3]\n");
        s = s.write("    add x2, x2, #1\n");
        s = s.write("    b .Larr_push_copy\n");
        s = s.write(".Larr_push_copy_done:\n");
        // Store the new value at slot (len+1).
        s = s.write("    add x1, x21, #1\n");
        s = s.write("    str x20, [x0, x1, lsl #3]\n");
        s = s.write(".Larr_push_ret:\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // __fern_arr_slice: return a fresh array containing
    // arr[start..end] (end exclusive). x0 = src arr ptr,
    // x1 = start, x2 = end. Source array layout matches the
    // ExprArray emit: [len: 8, e0: 8, …]. Each element is an
    // 8-byte payload — i32 zero-extended or string-box ptr.
    if (s.needs_arr_slice) {
        s = s.write("__fern_arr_slice:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
