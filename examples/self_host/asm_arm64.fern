        s = s.write("    ldur w1, [x0, #-8]\n");
        s = s.write("    tbnz w1, #31, .Loaf_ret\n");
        s = s.write("    cmp w1, #1\n");
        s = s.write("    bgt .Loaf_dec\n");
        s = s.write("    blt .Loaf_uf\n");
        s = s.write("    stp x19, x30, [sp, #-16]!\n");
        s = s.write("    stp x20, x21, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");
        s = s.write("    ldr x20, [x19]\n");
        s = s.write("    mov x21, #0\n");
        s = s.write(".Loaf_loop:\n");
        s = s.write("    cmp x21, x20\n");
        s = s.write("    bge .Loaf_freebuf\n");
        s = s.write("    add x9, x21, #1\n");
        s = s.write("    ldr x0, [x19, x9, lsl #3]\n");   // e = option box
        s = s.write("    cbz x0, .Loaf_next\n");
        s = s.write("    mov x9, #0x10000\n");
        s = s.write("    cmp x0, x9\n");
        s = s.write("    blo .Loaf_next\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_rc_is_unique\n"); // shared box -> skip payload
        s = s.write("    add sp, sp, #16\n");
        s = s.write("    cbz x0, .Loaf_box\n");
        s = s.write("    add x9, x21, #1\n");
        s = s.write("    ldr x0, [x19, x9, lsl #3]\n");   // reload e
        s = s.write("    ldr w1, [x0]\n");                // tag @ e+0 (0 = Some/Ok)
        s = s.write("    cbnz w1, .Loaf_box\n");
        s = s.write("    ldr x0, [x0, #8]\n");            // payload buffer @ e+8
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_arr_dec\n");      // payload free (rc-guarded)
        s = s.write("    add sp, sp, #16\n");
        s = s.write(".Loaf_box:\n");
        s = s.write("    add x9, x21, #1\n");
        s = s.write("    ldr x0, [x19, x9, lsl #3]\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.write("    bl __fn___fern_arr_dec\n");      // option box free (rc-guarded)
        s = s.write("    add sp, sp, #16\n");
        s = s.write(".Loaf_next:\n");
        s = s.write("    add x21, x21, #1\n");
        s = s.write("    b .Loaf_loop\n");
        s = s.write(".Loaf_freebuf:\n");
        s = s.write("    stur wzr, [x19, #-8]\n");
        s = s.write("    ldur x1, [x19, #-16]\n");
        s = s.write("    add x1, x1, #3\n");
        s = s.write("    mov x9, #0x10000\n");
        s = s.write("    cmp x1, x9\n");
        s = s.write("    bhs .Loaf_pop\n");
        s = s.write("    sub x2, x19, #16\n");
        s = s.write("    adrp x3, __fern_freelist\n");
        s = s.write("    add x3, x3, :lo12:__fern_freelist\n");
        s = s.write("    ldr x9, [x3, x1, lsl #3]\n");
        s = s.write("    str x9, [x2]\n");
        s = s.write("    str x2, [x3, x1, lsl #3]\n");
        s = s.write(".Loaf_pop:\n");
        s = s.write("    ldp x20, x21, [sp], #16\n");
        s = s.write("    ldp x19, x30, [sp], #16\n");
        s = s.write("    b .Loaf_ret\n");
        s = s.write(".Loaf_dec:\n");
        s = s.write("    sub w1, w1, #1\n");
        s = s.write("    stur w1, [x0, #-8]\n");
        s = s.write("    b .Loaf_ret\n");
        s = s.write(".Loaf_uf:\n");
        s = s.write("    adrp x2, __fern_rc_underflow\n");
        s = s.write("    add x2, x2, :lo12:__fern_rc_underflow\n");
        s = s.write("    ldr w3, [x2]\n");
        s = s.write("    add w3, w3, #1\n");
        s = s.write("    str w3, [x2]\n");
