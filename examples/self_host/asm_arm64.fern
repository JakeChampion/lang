        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) mark_read_int(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: true,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

// escape_for_ascii rewrites a string for `.ascii "…"` syntax:
// quotes get backslashed, backslashes doubled, common whitespace
// bytes become GAS escape sequences so a `\n` byte in the source
// string lands as a single LF byte in .rodata. Other control
// bytes (NUL, DEL, anything < 0x20 we don't handle by name) get
// a 3-digit octal escape — always 3 digits to avoid ambiguity
// when followed by a literal digit.
function escape_for_ascii(s: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b == 34) { out = out + "\\\""; }
        else if (b == 92) { out = out + "\\\\"; }
        else if (b == 10) { out = out + "\\n"; }
        else if (b == 9) { out = out + "\\t"; }
        else if (b == 13) { out = out + "\\r"; }
        else if (b < 32 || b == 127) {
            // 3-digit octal: \<o2><o1><o0>.
            var o0: i32 = b % 8;
            var o1: i32 = (b / 8) % 8;
            var o2: i32 = (b / 64) % 8;
            out = out + "\\" + i32_to_string(o2) + i32_to_string(o1) + i32_to_string(o0);
        }
        else { out = out + s[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

// =================== ASM EMITTER ====================

// emit_fn_value emits a 1-slot closure box [&__fn_name] for a function
// referenced by name as a value. Shared by ExprIdent (params>0) and the
// call-arg path (a fn-typed param of any arity — including a 0-arg
// `() => R`, which can't be distinguished from a const at the ident
// site, so the boxing decision is made at the call site instead).
function emit_fn_value(name: string, s: EmitState): EmitState {
    s = s.write("    mov x0, #8\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.mark_heap();
    s = s.write("    adrp x1, __fn_" + sanitize_label(name) + "\n");
    s = s.write("    add x1, x1, :lo12:__fn_" + sanitize_label(name) + "\n");
    s = s.write("    str x1, [x0]\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    return s;
}

// is_value_fn_name reports whether name is a receiver-less function.
function is_value_fn_name(s: EmitState, name: string): boolean {
    var fi: i32 = 0;
    while (fi < s.funcs.len()) {
        if (s.funcs[fi].name == name && s.funcs[fi].receiver_type.len() == 0) { return true; }
        fi = fi + 1;
    }
    return false;
}

// callee_param_is_fn reports whether the named receiver-less function's
// param at idx has a function type ("fn").
function callee_param_is_fn(s: EmitState, name: string, idx: i32): boolean {
    // Match receiver methods as well as free functions so
    // `f.bench("…", n, my_workload)` boxes `my_workload` the same way
    // a free-fn call does. See asm.fern.
    var fi: i32 = 0;
    while (fi < s.funcs.len()) {
        if (s.funcs[fi].name == name) {
            if (idx < s.funcs[fi].params.len()
                    && s.funcs[fi].params[idx].type_name == "fn") {
                return true;
            }
        }
        fi = fi + 1;
    }
    return false;
}

// arg_fn_value_name returns the function name to box for a call argument
// when the callee's param at idx is fn-typed and the arg is a bare ident
// naming a function; otherwise "". This makes a 0-arg function passed by
// name (e.g. `bench(name, n, my_workload)`) lower to a function value
// rather than a call.
function arg_fn_value_name(arg: parser.Expr, callee: string, idx: i32, s: EmitState): string {
    match (arg) {
        parser.ExprIdent(id) => {
            if (callee_param_is_fn(s, callee, idx) && is_value_fn_name(s, id.name)) {
                return id.name;
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

function emit_expr(e: parser.Expr, s: EmitState): EmitState {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) {
                // Float literal: GAS converts the decimal text to an
                // IEEE-754 double in .rodata; load its bits and push
                // them (floats flow as their 8-byte bit pattern).
                var fl: LabelOut = fresh_label(s);
                s = fl.state;
                s = s.write("    .section .rodata\n");
                s = s.write(fl.name + ": .double " + n.text + "\n");
                s = s.write("    .text\n");
                s = s.write("    adrp x0, " + fl.name + "\n");
                s = s.write("    add x0, x0, :lo12:" + fl.name + "\n");
                s = s.write("    ldr d0, [x0]\n");
                s = s.write("    fmov x0, d0\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            // `ldr x0, =N` puts N in a literal pool; works for
            // any 64-bit value, including ones that don't fit
            // mov's 16-bit immediate field.
            s = s.write("    ldr x0, =" + n.text + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprBinary(b) => {
            if (b.op == "+") {
                var lt: string = infer_expr_type(b.left, s);
                var rt: string = infer_expr_type(b.right, s);
                if (lt == "string" || rt == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    ldr x1, [sp], #16\n");
                    s = s.write("    ldr x0, [sp], #16\n");
                    s = s.write("    bl __fern_str_concat\n");
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.mark_str_concat();
                    return s;
                }
            }
            if (b.op == "==" || b.op == "!=") {
                var elt: string = infer_expr_type(b.left, s);
                var ert: string = infer_expr_type(b.right, s);
                if (elt == "string" || ert == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    ldr x1, [sp], #16\n");
                    s = s.write("    ldr x0, [sp], #16\n");
                    s = s.write("    bl __fern_str_eq\n");
                    if (b.op == "!=") {
                        s = s.write("    eor x0, x0, #1\n");
                    }
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.mark_str_eq();
                    return s;
                }
            }
            // String ordering: < / <= / > / >= → __fern_str_cmp
            // and compare its signed result against zero.
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                var olt: string = infer_expr_type(b.left, s);
                var ort: string = infer_expr_type(b.right, s);
                if (olt == "string" || ort == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    ldr x1, [sp], #16\n");
                    s = s.write("    ldr x0, [sp], #16\n");
                    s = s.write("    bl __fern_str_cmp\n");
                    s = s.write("    cmp x0, #0\n");
                    if (b.op == "<") { s = s.write("    cset x0, lt\n"); }
                    else if (b.op == "<=") { s = s.write("    cset x0, le\n"); }
                    else if (b.op == ">") { s = s.write("    cset x0, gt\n"); }
                    else { s = s.write("    cset x0, ge\n"); }
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.mark_str_cmp();
                    return s;
                }
            }
            // Short-circuit boolean ops. Can't naively
            // emit both sides — the right operand's side
            // effects must not run when the left already
            // decides the result. `&&` short-circuits on
            // false (left == 0 ⇒ result = 0); `||` short-
            // circuits on true (left != 0 ⇒ result = 1).
            // Otherwise the right operand becomes the result.
            if (b.op == "&&" || b.op == "||") {
                s = emit_expr(b.left, s);
                s = s.write("    ldr x0, [sp], #16\n");
                var short_l: LabelOut = fresh_label(s);
                s = short_l.state;
                var end_l: LabelOut = fresh_label(s);
                s = end_l.state;
                if (b.op == "&&") {
                    s = s.write("    cbz x0, " + short_l.name + "\n");
                } else {
                    s = s.write("    cbnz x0, " + short_l.name + "\n");
                }
                s = emit_expr(b.right, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    b " + end_l.name + "\n");
                s = s.write(short_l.name + ":\n");
                if (b.op == "&&") {
                    s = s.write("    mov x0, #0\n");
                } else {
                    s = s.write("    mov x0, #1\n");
                }
                s = s.write(end_l.name + ":\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            // Float (f64) arithmetic + comparison. Operands flow as
            // 8-byte bit patterns; fmov into d-regs and operate.
            var is_flt: boolean = infer_expr_type(b.left, s) == "f64" || infer_expr_type(b.right, s) == "f64";
            if (is_flt && (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/")) {
                s = emit_expr(b.left, s);
                s = emit_expr(b.right, s);
                s = s.write("    ldr x0, [sp], #16\n");   // rhs
                s = s.write("    ldr x1, [sp], #16\n");   // lhs
                s = s.write("    fmov d0, x0\n");
                s = s.write("    fmov d1, x1\n");
                if (b.op == "+") { s = s.write("    fadd d0, d1, d0\n"); }
                else if (b.op == "-") { s = s.write("    fsub d0, d1, d0\n"); }
                else if (b.op == "*") { s = s.write("    fmul d0, d1, d0\n"); }
                else { s = s.write("    fdiv d0, d1, d0\n"); }
                s = s.write("    fmov x0, d0\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            if (is_flt && (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "==" || b.op == "!=")) {
                s = emit_expr(b.left, s);
                s = emit_expr(b.right, s);
                s = s.write("    ldr x0, [sp], #16\n");   // rhs
                s = s.write("    ldr x1, [sp], #16\n");   // lhs
                s = s.write("    fmov d0, x0\n");
                s = s.write("    fmov d1, x1\n");
                s = s.write("    fcmp d1, d0\n");          // lhs vs rhs
                if (b.op == "<") { s = s.write("    cset w0, mi\n"); }
                else if (b.op == "<=") { s = s.write("    cset w0, ls\n"); }
                else if (b.op == ">") { s = s.write("    cset w0, gt\n"); }
                else if (b.op == ">=") { s = s.write("    cset w0, ge\n"); }
                else if (b.op == "==") { s = s.write("    cset w0, eq\n"); }
                else { s = s.write("    cset w0, ne\n"); }
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = emit_expr(b.left, s);
            s = emit_expr(b.right, s);
            s = s.write("    ldr x1, [sp], #16\n");   // rhs
            s = s.write("    ldr x0, [sp], #16\n");   // lhs
            if (b.op == "+") {
                s = s.write("    add x0, x0, x1\n");
            } else if (b.op == "-") {
                s = s.write("    sub x0, x0, x1\n");
            } else if (b.op == "*") {
                s = s.write("    mul x0, x0, x1\n");
            } else if (b.op == "/") {
                s = s.write("    sdiv x0, x0, x1\n");
            } else if (b.op == "%") {
                // ARM64 has no native modulo. Compute via
                // remainder = lhs - (lhs/rhs)*rhs.
                // msub x_d, x_n, x_m, x_a → x_d = x_a - x_n*x_m
                s = s.write("    sdiv x2, x0, x1\n");
                s = s.write("    msub x0, x2, x1, x0\n");
            } else if (b.op == "&") {
                s = s.write("    and x0, x0, x1\n");
            } else if (b.op == "|") {
                s = s.write("    orr x0, x0, x1\n");
            } else if (b.op == "^") {
                s = s.write("    eor x0, x0, x1\n");
            } else if (b.op == "<<") {
                s = s.write("    lsl x0, x0, x1\n");
            } else if (b.op == ">>") {
                // Arithmetic (signed) shift right — Fern i32 is signed.
                s = s.write("    asr x0, x0, x1\n");
            } else if (b.op == "<" || b.op == "<=" || b.op == ">"
                    || b.op == ">=" || b.op == "==" || b.op == "!=") {
                // Comparison: `cmp lhs, rhs` sets the condition
                // flags; `cset` materialises the bool (0/1) into
                // x0 based on the chosen cc.
                // Pick signed vs unsigned cset codes from the operand
                // tags — `u32` / `u64` / `usize` use lo / ls / hi / hs
                // so values near u64::MAX sort/compare in the expected
                // order (signed lt would treat them as negative).
                var is_unsigned: boolean = is_unsigned_tag(infer_expr_type(b.left, s))
                    || is_unsigned_tag(infer_expr_type(b.right, s));
                s = s.write("    cmp x0, x1\n");
                var cc: string = "";
                if (b.op == "<") { if (is_unsigned) { cc = "lo"; } else { cc = "lt"; } }
                else if (b.op == "<=") { if (is_unsigned) { cc = "ls"; } else { cc = "le"; } }
                else if (b.op == ">") { if (is_unsigned) { cc = "hi"; } else { cc = "gt"; } }
                else if (b.op == ">=") { if (is_unsigned) { cc = "hs"; } else { cc = "ge"; } }
                else if (b.op == "==") { cc = "eq"; }
                else { cc = "ne"; }
                s = s.write("    cset x0, " + cc + "\n");
            } else {
                s = s.write("    // unsupported binop: " + b.op + "\n");
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprUnary(u) => {
            // `expr?` try operator — see asm.fern.
            if (u.op == "try_") {
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");   // option/result box
                s = s.write("    ldr x1, [x0]\n");        // tag (0 = Some/Ok)
                var tlbl: LabelOut = fresh_label(s);
                s = tlbl.state;
                s = s.write("    cbz x1, " + tlbl.name + "\n");
                // None/Err: return the box (already in x0) from the fn.
                s = s.write("    mov sp, x29\n");
                s = s.write("    ldp x29, x30, [sp], #16\n");
                s = s.write("    ret\n");
                s = s.write(tlbl.name + ":\n");
                s = s.write("    ldr x0, [x0, #8]\n");     // payload
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            if (u.op == "-") {
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");
                if (infer_expr_type(u.operand, s) == "f64") {
                    s = s.write("    fmov d0, x0\n");
                    s = s.write("    fneg d0, d0\n");
                    s = s.write("    fmov x0, d0\n");
                } else {
                    s = s.write("    neg x0, x0\n");
                }
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            if (u.op == "!") {
                // Boolean negation. Operand is in the
                // `{0, 1}` normal form maintained by every
                // bool-producing path (literal, comparison,
                // short-circuit, str_*), so XOR with 1 flips
                // it without needing to widen first.
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    eor x0, x0, #1\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            // `expr as Type` casts (parser desugars to unary `as_<Type>`).
            // Integer widths are 64-bit slots; mask (unsigned) or
            // sign-extend (signed) to the target width; i64/u64/usize
            // and anything else are no-ops.
            if (u.op.len() >= 3 && u.op[0:3] == "as_") {
                var ty: string = u.op[3:u.op.len()];
                var src_ty: string = infer_expr_type(u.operand, s);
                var to_float: boolean = ty == "f64" || ty == "f32" || ty == "float";
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");
                if (to_float) {
                    // → float. From int: scvtf. From float: no-op.
                    if (src_ty != "f64") {
                        s = s.write("    scvtf d0, x0\n");
                        s = s.write("    fmov x0, d0\n");
                    }
                } else if (src_ty == "f64") {
                    // float → int: truncate toward zero, then width-mask.
                    s = s.write("    fmov d0, x0\n");
                    s = s.write("    fcvtzs x0, d0\n");
                    if (ty == "u8") { s = s.write("    uxtb w0, w0\n"); }
                    else if (ty == "u16") { s = s.write("    uxth w0, w0\n"); }
                    else if (ty == "i8") { s = s.write("    sxtb x0, w0\n"); }
                    else if (ty == "i16") { s = s.write("    sxth x0, w0\n"); }
                } else {
                    if (ty == "u8") { s = s.write("    uxtb w0, w0\n"); }
                    else if (ty == "u16") { s = s.write("    uxth w0, w0\n"); }
                    else if (ty == "u32") { s = s.write("    mov w0, w0\n"); }
                    else if (ty == "i8") { s = s.write("    sxtb x0, w0\n"); }
                    else if (ty == "i16") { s = s.write("    sxth x0, w0\n"); }
                    else if (ty == "i32") { s = s.write("    sxtw x0, w0\n"); }
                }
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = s.write("    // unsupported unary: " + u.op + "\n");
            return s;
        },
        parser.ExprBool(b) => {
            // Bool literal — 1 for true, 0 for false on the
            // rt-stack so it can flow through comparison-style
            // consumers (e.g. an if cond branching on `true`).
            var v: i32 = 0;
            if (b.value) { v = 1; }
            s = s.write("    mov x0, #" + i32_to_string(v) + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprIdent(id) => {
            if (s.has_local(id.name)) {
                var off: i32 = s.lookup_local(id.name);
                s = s.frame_ldr("x0", off);
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            // Built-in `None` — empty Option. Heap box [tag=1 @0].
            // See the Some(x) constructor + StmtMatch Some/None arms.
            if (id.name == "None") {
                s = s.write("    mov x0, #16\n");
                s = s.write("    bl __fern_alloc\n");
                s = s.mark_heap();
                s = s.write("    mov x1, #1\n");
                s = s.write("    str x1, [x0]\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            // A bare ident naming a zero-arg, receiver-less function
            // (a `const`) lowers to a call to that function.
            var cfi: i32 = 0;
            while (cfi < s.funcs.len()) {
                if (s.funcs[cfi].name == id.name && s.funcs[cfi].receiver_type.len() == 0 && s.funcs[cfi].params.len() == 0) {
                    s = s.write("    bl __fn_" + sanitize_label(id.name) + "\n");
                    s = s.write("    str x0, [sp, #-16]!\n");
                    return s;
                }
                cfi = cfi + 1;
            }
            // A bare ident naming a receiver-less function WITH params
            // is a function value (higher-order use). Represent it as a
            // 1-slot closure box [&__fn_name] so it flows through the
            // closure-call path. The box-in-x9 convention means the
            // plain function ignores the box and reads params at +16. See asm.fern.
            var fvi: i32 = 0;
            while (fvi < s.funcs.len()) {
                if (s.funcs[fvi].name == id.name && s.funcs[fvi].receiver_type.len() == 0 && s.funcs[fvi].params.len() > 0) {
                    return emit_fn_value(id.name, s);
                }
                fvi = fvi + 1;
            }
            // Bare ident naming a zero-field struct: no-payload enum
            // variant (`JNull`). Construct [shape_ptr]. See asm.fern.
            if (is_unit_variant(id.name, s)) {
                s = s.write("    mov x0, #8\n");
                s = s.write("    bl __fern_alloc\n");
                s = s.mark_heap();
                var uvLit: StringLitOut = add_string_lit(s, id.name);
