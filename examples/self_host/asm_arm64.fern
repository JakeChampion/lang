                            s = emit_expr(c.args[0], s);
                            s = s.write("    ldr x1, [sp], #16\n");   // other
                            s = s.write("    ldr x0, [sp], #16\n");   // n
                            s = s.write("    bl __fern_i32_lcm\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            s = s.mark_heap();
                            return s;
