        s = s.write("    ldrb w12, [x10]\n");
        s = s.write("    cmp w11, w12\n");
        s = s.write("    b.ne .Lrepl_clnomatch\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lrepl_clm\n");
        s = s.write(".Lrepl_match:\n");
        s = s.write("    add x22, x22, #1\n");
        s = s.write("    add x7, x7, x3\n");
        s = s.write("    b .Lrepl_cl\n");
        s = s.write(".Lrepl_clnomatch:\n");
        s = s.write("    add x7, x7, #1\n");
        s = s.write("    b .Lrepl_cl\n");
        s = s.write(".Lrepl_count_done:\n");
        s = s.write("    cbz x22, .Lrepl_passthru\n");
