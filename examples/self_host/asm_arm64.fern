    // Pre-intern "FileStat" so the __fern_stat runtime helper (emitted
    // after this pool, inside the needs_heap block) can reference its
    // shape-name label. The helper's own add_string_lit dedups to this
    // slot; without the early intern the label would be undefined for
    // programs that never mention stat() themselves. Same for the
    // __fern_subprocess helper's "ProcessResult" shape name.
    if (s.has_need("heap")) {
        var fsPre: asm_ir.ShapeRefOut = asm_ir.shape_ref(s, "FileStat");
        s = fsPre.state;
        var prPre: asm_ir.ShapeRefOut = asm_ir.shape_ref(s, "ProcessResult");
        s = prPre.state;
        // IoError variant shapes for __fern_io_error (#4624, the arm64 leg
        // of #4370) — interned early for the same reason as FileStat above.
        var ioe1: asm_ir.ShapeRefOut = asm_ir.shape_ref(s, "NotFound");
        s = ioe1.state;
        var ioe2: asm_ir.ShapeRefOut = asm_ir.shape_ref(s, "PermissionDenied");
        s = ioe2.state;
        var ioe3: asm_ir.ShapeRefOut = asm_ir.shape_ref(s, "AlreadyExists");
        s = ioe3.state;
        var ioe4: asm_ir.ShapeRefOut = asm_ir.shape_ref(s, "Interrupted");
        s = ioe4.state;
        var ioe5: asm_ir.ShapeRefOut = asm_ir.shape_ref(s, "Other");
        s = ioe5.state;
