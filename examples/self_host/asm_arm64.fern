    // __fern_arr_i32_product / _sum are now Fern runtime functions (#2649),
    // compiled through emit_function (see asmcore.rt_src_arr_i32_*). They link
    // as __fn___fern_arr_i32_product / __fn___fern_arr_i32_sum and are called
    // via the ordinary stack convention; the array param is borrowed.
    if (s.has_need("arr_i32_product")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_arr_i32_product(), s);
    }
    if (s.has_need("arr_i32_sum")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_arr_i32_sum(), s);
    }
    // __fern_arr_str_index_of is now a Fern runtime function (#2649): see
    // asmcore.rt_src_arr_str_index_of. It calls str_eq (also Fern); the dep is
    // marked by mark_arr_str_index_of so str_eq's body is emitted alongside.
    if (s.has_need("arr_str_index_of")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_arr_str_index_of(), s);
    }
    // __fern_arr_i32_index_of is now a Fern runtime function (#2649): see
    // asmcore.rt_src_arr_i32_index_of. Linear scan returning the first index
    // where arr[i] == target, or -1; called via the stack convention.
    if (s.has_need("arr_i32_index_of")) {
        s = emit_runtime_fern_fn(asmcore.rt_src_arr_i32_index_of(), s);
    }
    return s;
}

// emit_module_ir is the FORCED-IR whole-program emit — the use_ir branch of
// emit_module without the eligibility fallback or the pre-codegen check, the
// arm64 sibling of asm_ir.emit_module_ir. The asm_ir_run `-target arm64 -ir`
// differential driver calls this (with an already lambda-lifted module) so the
// IR orchestration lives in ONE place: the driver's old hand-copy of this
// sequence drifted when emit_arm64_reclaim_drop_bodies was added to
// emit_module's dispatch (#3457) but not to the driver, so a reclaimable
// struct-with-array-field program link-failed on `__struct_drop_<T>` there.
pub function emit_module_ir(mod: parser.Module, darwin: boolean): string {
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    s = asmcore.EmitState { ...s, struct_decls: mod.structs, funcs: mod.funcs };
    s = asm_arm64_ir.emit_body(mod, s);
    // Expand the declarative runtime-dependency closure (see emit_module's IR
    // dispatch) before emit_runtime gates each helper on has_need.
    s = s.close_needs();
    // #4355: replaced-STRING-field admission — this driver route is
    // single-module whole-program, so mod.funcs IS the full read scope.
    var sfok: string[] = irlower.strfld_reclaim_ok_types_of(mod.funcs, mod.structs);
    var sfoi: i32 = 0;
    while (sfoi < sfok.len()) { s = s.need("strfldok:" + sfok[sfoi]); sfoi = sfoi + 1; }
    // #5235: plain-fn-pointer-array field registry (see the emit_module_funcs twin).
    var fpk: string[] = irlower.fnptr_arr_fields_of(mod.funcs, mod.structs);
    var fpi: i32 = 0;
    while (fpi < fpk.len()) { s = s.need(fpk[fpi]); fpi = fpi + 1; }
    // Per-type __field_reclaim_<T> / __struct_drop_<T> bodies (#3457).
    s = emit_arm64_reclaim_drop_bodies(s);
    s = emit_runtime(s, darwin);
    return strbuf_take();
}

pub function emit_module(mod: parser.Module, darwin: boolean): string {
    var parse_errs: string = asmcore.parse_unknown_errors_module(mod);
    if (parse_errs.len() > 0) {
        eprint(parse_errs);
        exit(1);
        return "";
    }
    // Reset the global strbuf before any .write calls. Output is
    // accumulated there (amortised O(1) per append) and materialised
    // into a fresh string at the tail via strbuf_take().
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    // Seed the struct-decl table for ExprStructLit /
    // ExprFieldAccess. Builtin enum injection happens in the driver
    // (parser.module_with_builtins); emit_module stays pure.
    s = asmcore.EmitState { ...s, struct_decls: mod.structs, funcs: mod.funcs };
    // Type-check before codegen. On any diagnostic, report and abort —
    // emitting assembly for ill-typed input would miscompile silently.
    var check_errs: string = asmcore.check_module(mod, s);
    if (check_errs.len() > 0) {
        eprint(check_errs);
        exit(1);
        return "";
    }
    // IR path (docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md §3): when use_ir is set
    // (default on) AND the whole module is in the IR's i32 + arrays subset,
    // emit each function body from the target-agnostic stack IR
    // (asm_arm64_ir.emit_body — the arm64 mirror of asm_ir, with asm_arm64's
    // own array layout + RC, proven behaviour-equivalent via the differential
    // gate) and append THIS module's runtime. Out-of-subset modules (strings,
    // structs, methods, …) fall through to the AST emitter below, so the
    // self-host compiler itself still compiles via AST and the bootstrap is
    // unaffected. asm_arm64_ir does NOT import asm_arm64 (no cycle); the
    // runtime is reused from here, not duplicated.
    var lm: parser.Module = asm_ir.lift_lambdas(mod);
    if (asmcore.new_state().use_ir && asm_ir.all_eligible(lm)) {
        // Hoist no-capture lambda call-args (closures slice 2a); lambda-free
        // modules are unchanged. The single shared IR orchestration
        // (emit_body -> close_needs -> reclaim/drop bodies -> emit_runtime)
        // lives in emit_module_ir; nothing has been written to the strbuf
        // yet, so its internal reset keeps this byte-identical.
        return emit_module_ir(lm, darwin);
    }
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    // Emit each function body first. Each gets its own
    // __fn_<name>: label; _start dispatches into main() if it
    // exists.
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        s = emit_function(mod.funcs[fi], s);
        fi = fi + 1;
    }
    s = s.write("_start:\n");
    // Save argc + argv BEFORE the frame push. Linux (ELF, raw _start):
    // the kernel lays out the SysV entry stack — argc at [sp], argv at
    // sp+8. Darwin (Mach-O, _start->_main via dyld/LC_MAIN): the entry is
    // a C-ABI `main(argc, argv, envp, apple)`, so argc=x0, argv=x1,
    // envp=x2 arrive in registers, not on the stack.
    if (s.has_need("args")) {
        if (darwin) {
            s = s.write("    adrp x9, __fern_argc\n");
            s = s.write("    add x9, x9, :lo12:__fern_argc\n");
            s = s.write("    str x0, [x9]\n");            // argc = x0
            s = s.write("    adrp x9, __fern_argv\n");
            s = s.write("    add x9, x9, :lo12:__fern_argv\n");
            s = s.write("    str x1, [x9]\n");            // argv = x1
        } else {
            s = s.write("    ldr x0, [sp]\n");
            s = s.write("    adrp x1, __fern_argc\n");
            s = s.write("    add x1, x1, :lo12:__fern_argc\n");
            s = s.write("    str x0, [x1]\n");
            s = s.write("    add x0, sp, #8\n");
            s = s.write("    adrp x1, __fern_argv\n");
            s = s.write("    add x1, x1, :lo12:__fern_argv\n");
            s = s.write("    str x0, [x1]\n");
        }
    }
    // Save envp for env() / subprocess. Linux: envp = sp + 16 + argc*8 on
    // the entry stack. Darwin: envp = x2 (C-ABI arg). Gated on needs_heap
    // (env()/subprocess allocate, so they only link with the heap
    // present, and any caller marks the heap). x2 survives the needs_args
    // block above (which only touches x0/x1/x9).
    if (s.has_need("heap")) {
        if (darwin) {
            s = s.write("    adrp x9, __fern_envp\n");
            s = s.write("    add x9, x9, :lo12:__fern_envp\n");
            s = s.write("    str x2, [x9]\n");            // envp = x2
        } else {
            s = s.write("    ldr x0, [sp]\n");            // argc
            s = s.write("    lsl x0, x0, #3\n");          // argc*8
            s = s.write("    add x0, x0, #16\n");         // + 16
            s = s.write("    add x0, sp, x0\n");          // envp base
            s = s.write("    adrp x1, __fern_envp\n");
            s = s.write("    add x1, x1, :lo12:__fern_envp\n");
            s = s.write("    str x0, [x1]\n");
        }
    }
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    if (asmcore.has_main(mod)) {
        s = s.write("    bl __fn_main\n");
        s = s.write("    mov x8, #93\n");
        s = s.write("    svc #0\n");
    } else {
        var n_locals: i32 = asmcore.count_locals(mod.top_stmts);
        if (n_locals > 0) {
            var bytes: i32 = n_locals * 8;
            if (bytes % 16 != 0) { bytes = bytes + 8; }
            s = s.write("    sub sp, sp, #" + util.i32_to_string(bytes) + "\n");
        }
        var i: i32 = 0;
        while (i < mod.top_stmts.len()) {
            s = emit_stmt(mod.top_stmts[i], s);
            i = i + 1;
        }
        // Fallback exit.
        s = s.write("    mov x0, #0\n");
        s = s.write("    mov x8, #93\n");
        s = s.write("    svc #0\n");
    }
    s = emit_runtime(s, darwin);
    // s.out is always empty by design (writes route through the
    // strbuf primitive instead). Materialise the accumulated bytes.
    return strbuf_take();
}

// =================== arm64-darwin (Mach-O) ====================
//
// darwinize rewrites the Linux arm64 GAS assembly emitted by
// emit_module into the arm64-apple-darwin (Mach-O) dialect that
// `clang --target=arm64-apple-darwin` assembles and ld64 / lld link
// into a Mach-O executable. The transform is purely lexical plus a
// syscall-number remap — emit_module's instruction selection is
// byte-for-byte identical on both platforms, so the same code
// generator backs the Linux ELF and the Darwin Mach-O target:
//
//   - PC-relative symbol addressing. GNU `adrp Xd, sym` /
//     `add Xd, Xd, :lo12:sym` becomes Apple's `adrp Xd, sym@PAGE` /
//     `add Xd, Xd, sym@PAGEOFF`. Both name the identical ADRP/ADD
//     relocation pair; only the assembler syntax differs. Every
//     emitted `adrp` is paired with an `add ..., :lo12:...` and there
//     are no `ldr [.., :lo12:..]` forms, so the rewrite is unambiguous.
//   - Sections. `.section .rodata` -> `.section __TEXT,__const`;
//     `.bss` / `.section .bss` -> `.section __DATA,__bss`;
//     `.section .text` -> `.text`.
//   - ELF-only directives. `.type` / `.size` / `.note.GNU-stack` are
//     dropped — Mach-O records function-vs-data via section
//     membership, not per-symbol metadata.
//   - Entry symbol. `_start` -> `_main`: ld64 / lld's default
//     executable entry, which dyld invokes via LC_MAIN.
//   - Syscalls. Linux issues `mov x8, #N` + `svc #0`; Darwin BSD
//     issues `mov x16, #M` + `svc #0x80`. We remap the syscalls whose
//     argument + result ABI is number-compatible (read / write /
//     close / openat / lseek / newfstatat / unlinkat / mkdirat /
//     getdents64→getdirentries64 / dup3→dup2 / execve / wait4 / exit /
//     mmap — see darwin_sysno) and flip the trap, normalising the
//     carry-flag errno back to Linux's -errno. Syscalls with no
//     number-compatible Darwin form are emitted directly by the code
//     generator behind its `darwin` flag instead: clock_gettime →
//     gettimeofday (now_unix_ms) / CNTVCT_EL0 (monotonic_ns), getrandom
//     → getentropy (random_bytes), nanosleep → select (sleep_ms), and
//     the subprocess pipe2 → pipe / clone → fork divergences. The
//     supported surface is the core language (arithmetic, control flow,
//     functions, structs, enums, arrays, strings incl. heap concat,
//     closures, maps), stdin/stdout I/O, the filesystem builtins
//     (read_file / write_file / stat / temp_dir / remove_file /
//     read_dir / remove_dir_all), time + randomness, sleep,
//     subprocess, and the TCP socket primitives (tcp_listen /
//     tcp_accept / tcp_recv / tcp_send / tcp_close — socket 198→97 /
//     bind 200→104 / listen 201→106 / accept 202→30, plus the Darwin
//     sockaddr_in sin_len byte) that std/tcp.fern's HTTP edge-handler
//     loop is built on, and one-shot IPv4 UDP (udp_send — socket /
//     sendto 206→133 / close, dotted-quad host parse).

function darwin_starts_with(s: string, p: string): boolean {
    if (s.len() < p.len()) { return false; }
    return s[0:p.len()] == p;
}

// darwin_lstrip drops leading ASCII spaces.
function darwin_lstrip(s: string): string {
    var i: i32 = 0;
    while (i < s.len() && s[i] == 32) { i = i + 1; }
    return s[i:s.len()] + "";
}

// darwin_index_of returns the first index of sub in s, or -1.
function darwin_index_of(s: string, sub: string): i32 {
    if (sub.len() == 0) { return 0; }
    if (s.len() < sub.len()) { return 0 - 1; }
    var i: i32 = 0;
    while (i <= s.len() - sub.len()) {
        if (s[i:i + sub.len()] == sub) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// darwin_sysno maps a Linux arm64 syscall number to its Darwin BSD
// equivalent, for syscalls whose argument + result ABI is identical
// (only the number + trap instruction differ). Returns -1 when there
// is no number-compatible Darwin form.
function darwin_sysno(n: i32): i32 {
    if (n == 63) { return 3; }     // read
    if (n == 64) { return 4; }     // write
    if (n == 57) { return 6; }     // close
    if (n == 56) { return 463; }   // openat
    if (n == 61) { return 344; }   // getdents64 -> getdirentries64
    if (n == 62) { return 199; }   // lseek
    if (n == 79) { return 470; }   // newfstatat -> fstatat64 (same args)
    if (n == 35) { return 472; }   // unlinkat (same args)
    if (n == 34) { return 475; }   // mkdirat (same args)
    if (n == 24) { return 90; }    // dup3(.,.,0) -> dup2 (flags 0 == dup2)
    if (n == 221) { return 59; }   // execve (same args)
    if (n == 260) { return 7; }    // wait4 (same args)
    if (n == 198) { return 97; }   // socket (same args)
    if (n == 200) { return 104; }  // bind (sockaddr_in gets a sin_len byte)
    if (n == 201) { return 106; }  // listen (same args)
    if (n == 202) { return 30; }   // accept (same args)
    if (n == 206) { return 133; }  // sendto (same args)
    if (n == 93) { return 1; }     // exit
    if (n == 94) { return 1; }     // exit_group -> exit
    if (n == 222) { return 197; }  // mmap
    return 0 - 1;
}

pub function darwinize(asm: string): string {
    // Accumulate transformed lines into a local string. We deliberately
    // do NOT use the global strbuf here: emit_module has just run a
    // strbuf cycle to produce `asm`, and re-entering strbuf inside the
    // same call chain is fragile. Plain `+` accumulation is O(n^2) in
    // the worst case, but the arm64-darwin surface is small CLI / edge
    // programs whose asm is a few KB, so this stays well within budget.
    var out: string = "";
    var n: i32 = asm.len();
    var start: i32 = 0;
    var i: i32 = 0;
    // prev_sys_num holds the Darwin number of a remapped syscall whose
    // `mov x16, #M` we just emitted, so the following `svc` knows whether
    // (and how) to flip the trap + normalise the errno. -1 = none.
    var prev_sys_num: i32 = 0 - 1;
    var norm_n: i32 = 0;   // fresh-label counter for errno normalisation
    while (i <= n) {
        if (i == n || asm[i] == 10) {
            var line: str = asm[start:i];
            var has_nl: boolean = (i < n);
            var body: string = darwin_lstrip(line);
            var keep: boolean = true;
            var out_line: string = line + "";
            var this_sys_num: i32 = 0 - 1;

            if (darwin_starts_with(body, ".type ") || darwin_starts_with(body, ".size ")) {
                keep = false;
            } else if (darwin_starts_with(body, ".note.GNU-stack")) {
                keep = false;
            } else if (body == ".section .rodata") {
                out_line = "    .section __TEXT,__const";
            } else if (body == ".bss" || body == ".section .bss") {
                out_line = "    .section __DATA,__bss";
            } else if (body == ".section .text") {
                out_line = "    .text";
            } else if (body == ".globl _start" || body == ".global _start") {
                out_line = "    .globl _main";
            } else if (line == "_start:") {
                out_line = "_main:";
            } else if (darwin_starts_with(body, "adrp ")) {
                out_line = line + "@PAGE";
            } else if (darwin_index_of(line, ":lo12:") >= 0) {
                var idx: i32 = darwin_index_of(line, ":lo12:");
                out_line = line[0:idx] + line[idx + 6:line.len()] + "@PAGEOFF";
            } else if (darwin_starts_with(line, "    mov x8, #")) {
                var num: i32 = util.digits_to_i32(line[13:line.len()]);
                var m: i32 = darwin_sysno(num);
                if (m >= 0) {
                    out_line = "    mov x16, #" + util.i32_to_string(m);
                    this_sys_num = m;
                }
            } else if (line == "    svc #0") {
                if (prev_sys_num == 1) {
                    // exit / exit_group: never returns, so no errno
                    // normalisation — just flip the trap.
                    out_line = "    svc #0x80";
                } else if (prev_sys_num >= 0) {
                    // Fallible syscall. Darwin returns +errno with the
                    // carry flag SET on error; Linux returns -errno. The
                    // self-host's callers test `x0 < 0`, so negate x0 when
                    // carry is set to restore the Linux-shaped -errno.
                    // Mirrors the Go backend's syscall() normalisation.
                    var lbl: string = ".Ldwsc_" + util.i32_to_string(norm_n);
                    norm_n = norm_n + 1;
                    out_line = "    svc #0x80\n    b.cc " + lbl + "\n    neg x0, x0\n" + lbl + ":";
                }
            }

            if (keep) {
                if (has_nl) {
                    out = out + out_line + "\n";
                } else {
                    out = out + out_line;
                }
            }
            prev_sys_num = this_sys_num;
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}


function emit_source(src: string): string {
    return emit_module(parser.parse_module(lexer.tokenize(src)), false);
}

function main(): i32 {
    // Minimal: `return 42;` should produce asm with the literal,
    // the rt-stack push, exit code load, sys_exit syscall.
    var a1: string = emit_source("return 42;");
    if (!util.contains(a1, "ldr x0, =42")) { return 10; }
    if (!util.contains(a1, "str x0, [sp, #-16]!")) { return 11; }
    if (!util.contains(a1, "ldr x0, [sp], #16")) { return 12; }
    if (!util.contains(a1, "mov x8, #93")) { return 13; }
    if (!util.contains(a1, "svc #0")) { return 14; }
    if (!util.contains(a1, ".globl _start")) { return 15; }

    // Arithmetic: + emits add.
    var a2: string = emit_source("return 2 + 3;");
    if (!util.contains(a2, "add x0, x0, x1")) { return 20; }

    // Subtraction.
    var a3: string = emit_source("return 7 - 4;");
    if (!util.contains(a3, "sub x0, x0, x1")) { return 30; }

    // Multiplication.
    var a4: string = emit_source("return 6 * 7;");
    if (!util.contains(a4, "mul x0, x0, x1")) { return 40; }

    // Division: ARM64 sdiv.
    var a5: string = emit_source("return 20 / 4;");
    if (!util.contains(a5, "sdiv x0, x0, x1")) { return 50; }

    // Modulo: sdiv + msub (no native mod on ARM64).
    var a6: string = emit_source("return 23 % 5;");
    if (!util.contains(a6, "sdiv x2, x0, x1")) { return 60; }
    if (!util.contains(a6, "msub x0, x2, x1, x0")) { return 61; }

    // Unary negation.
    var a7: string = emit_source("return -5;");
    if (!util.contains(a7, "neg x0, x0")) { return 70; }

    // Nested expressions: `return (2 + 3) * 4;` emits add before mul.
    var a8: string = emit_source("return (2 + 3) * 4;");
    if (!util.contains(a8, "add x0, x0, x1")) { return 80; }
    if (!util.contains(a8, "mul x0, x0, x1")) { return 81; }

    // Comparisons: cmp + cset with the matching cc.
    var a9: string = emit_source("return 5 < 10;");
    if (!util.contains(a9, "cmp x0, x1")) { return 90; }
    if (!util.contains(a9, "cset x0, lt")) { return 91; }

    var a10: string = emit_source("return 5 <= 5;");
    if (!util.contains(a10, "cset x0, le")) { return 100; }

    var a11: string = emit_source("return 7 > 3;");
    if (!util.contains(a11, "cset x0, gt")) { return 110; }

    var a12: string = emit_source("return 7 >= 7;");
    if (!util.contains(a12, "cset x0, ge")) { return 120; }

    var a13: string = emit_source("return 4 == 4;");
    if (!util.contains(a13, "cset x0, eq")) { return 130; }

    var a14: string = emit_source("return 4 != 5;");
    if (!util.contains(a14, "cset x0, ne")) { return 140; }

    // If/else: emits cbz to else label, body, b to end label,
    // else label, else-body, end label.
    var a15: string = emit_source("if (true) { return 1; } else { return 2; }");
    if (!util.contains(a15, "cbz x0, .L")) { return 150; }
    if (!util.contains(a15, "b .L")) { return 151; }
    if (!util.contains(a15, ".L0:")) { return 152; }
    if (!util.contains(a15, ".L1:")) { return 153; }
    if (!util.contains(a15, "mov x0, #1")) { return 154; }  // true literal

    // No-else if.
    var a16: string = emit_source("if (true) { return 1; } return 0;");
    if (!util.contains(a16, "cbz x0, .L")) { return 160; }

    // While.
    var a17: string = emit_source("while (1 < 2) { return 0; }");
    if (!util.contains(a17, "cbz x0, .L")) { return 170; }
    if (!util.contains(a17, "b .L")) { return 171; }

    // Locals: frame prologue + slot store + slot load.
    var a18: string = emit_source("var x = 5; return x;");
    if (!util.contains(a18, "stp x29, x30, [sp, #-16]!")) { return 180; }
    if (!util.contains(a18, "mov x29, sp")) { return 181; }
    if (!util.contains(a18, "sub sp, sp, #")) { return 182; }
    if (!util.contains(a18, "str x0, [x29, #-8]")) { return 183; }
    if (!util.contains(a18, "ldr x0, [x29, #-8]")) { return 184; }

    // Multiple locals at -8, -16, -24.
    var a19: string = emit_source("var a = 1; var b = 2; var c = 3; return c;");
    if (!util.contains(a19, "str x0, [x29, #-8]")) { return 190; }
    if (!util.contains(a19, "str x0, [x29, #-16]")) { return 191; }
    if (!util.contains(a19, "str x0, [x29, #-24]")) { return 192; }
    if (!util.contains(a19, "ldr x0, [x29, #-24]")) { return 193; }

    // Re-assignment via assign.
    var a20: string = emit_source("var x = 5; x = x + 1; return x;");
    if (!util.contains(a20, "ldr x0, [x29, #-8]")) { return 200; }
    if (!util.contains(a20, "str x0, [x29, #-8]")) { return 201; }
    if (!util.contains(a20, "add x0, x0, x1")) { return 202; }

    // Function decl + call.
    var a21: string = emit_source(
        "function add(x: i32, y: i32): i32 { return x + y; }"
        + " function main(): i32 { return add(2, 3); }"
    );
    if (!util.contains(a21, "__fn_add:")) { return 210; }
    if (!util.contains(a21, "__fn_main:")) { return 211; }
    if (!util.contains(a21, "bl __fn_add")) { return 212; }
    if (!util.contains(a21, "bl __fn_main")) { return 213; }
    if (!util.contains(a21, "ldp x29, x30, [sp], #16")) { return 214; }
    if (!util.contains(a21, "ret\n")) { return 215; }

    // print("...") emits adrp + add for the literal address,
    // mov fd/len, sys_write syscall, and .rodata at end.
    var a22: string = emit_source("print(\"hi\\n\"); return 0;");
    if (!util.contains(a22, "adrp x1, .S0")) { return 220; }
    if (!util.contains(a22, "add x1, x1, :lo12:.S0")) { return 221; }
    if (!util.contains(a22, "mov x8, #64")) { return 222; }  // sys_write
    if (!util.contains(a22, ".section .rodata")) { return 223; }
    if (!util.contains(a22, ".S0: .ascii")) { return 224; }
    if (!util.contains(a22, "hi")) { return 225; }

    // print_int(N) emits a call to __fern_print_int + the
    // helper appended once at end of .text.
    var a23: string = emit_source("print_int(42); return 0;");
    if (!util.contains(a23, "bl __fern_print_int")) { return 230; }
    if (!util.contains(a23, "__fern_print_int:")) { return 231; }
    if (!util.contains(a23, ".Lpi_div:")) { return 232; }

    // read_int() emits a call to __fern_read_int + the helper.
    var a24: string = emit_source("return read_int();");
    if (!util.contains(a24, "bl __fern_read_int")) { return 240; }
    if (!util.contains(a24, "__fern_read_int:")) { return 241; }
    if (!util.contains(a24, ".Lri_loop:")) { return 242; }

    // arm64-darwin: darwinize() reskins Linux arm64 GAS asm into the
    // Mach-O dialect. Drive it over a hand-built fragment that exercises
    // every transform branch. (The full emit -> darwinize -> clang ->
    // Mach-O path is covered by the Go e2e test, which runs one program
    // per process; chaining it here would exhaust the bump heap.)
    var src: string = ""
        + "    .globl _start\n"
        + "    .text\n"
        + "_start:\n"
        + "    adrp x1, .S0\n"
        + "    add x1, x1, :lo12:.S0\n"
        + "    mov x0, #1\n"
        + "    mov x8, #64\n"      // write
        + "    svc #0\n"
        + "    mov x8, #113\n"     // clock_gettime: NO Darwin number form
        + "    svc #0\n"
        + "    mov x8, #93\n"      // exit
        + "    svc #0\n"
        + "    .type __fn_main, %function\n"
        + "    .size __fn_main, .-__fn_main\n"
        + "    .section .rodata\n"
        + "    .bss\n"
        + "    .section .bss\n"
        + "    .section .text\n";
    var d1: string = darwinize(src);
    // Entry symbol renamed _start -> _main.
    if (!util.contains(d1, ".globl _main")) { return 250; }
    if (util.contains(d1, ".globl _start")) { return 251; }
    if (!util.contains(d1, "_main:")) { return 252; }
    if (util.contains(d1, "_start:")) { return 253; }
    // PC-relative addressing reskinned to @PAGE / @PAGEOFF.
    if (!util.contains(d1, "adrp x1, .S0@PAGE")) { return 254; }
    if (!util.contains(d1, "add x1, x1, .S0@PAGEOFF")) { return 255; }
    if (util.contains(d1, ":lo12:")) { return 256; }
    // Sections reskinned to Mach-O.
    if (!util.contains(d1, ".section __TEXT,__const")) { return 257; }
    if (util.contains(d1, ".section .rodata")) { return 258; }
    if (!util.contains(d1, ".section __DATA,__bss")) { return 259; }
    if (util.contains(d1, "    .bss\n")) { return 260; }
    // write (64 -> 4) and exit (93 -> 1) remapped with svc #0x80.
    if (!util.contains(d1, "mov x16, #4")) { return 261; }
    if (!util.contains(d1, "mov x16, #1")) { return 262; }
    if (!util.contains(d1, "svc #0x80")) { return 263; }
    if (util.contains(d1, "mov x8, #64")) { return 264; }
    if (util.contains(d1, "mov x8, #93")) { return 265; }
    // ABI-divergent syscall (clock_gettime, #113) has no Darwin number
    // form: its `mov x8, #113` and following `svc #0` are left intact.
    if (!util.contains(d1, "mov x8, #113")) { return 266; }
    if (!util.contains(d1, "    svc #0\n")) { return 267; }
    // ELF-only directives stripped.
    if (util.contains(d1, ".type ")) { return 268; }
    if (util.contains(d1, ".size ")) { return 269; }
    if (util.contains(d1, ".note.GNU-stack")) { return 270; }
    // Fallible syscalls (write here) get Darwin errno normalisation:
    // `b.cc <lbl>; neg x0, x0; <lbl>:` after the trap so the self-host's
    // `x0 < 0` error checks see Linux-shaped -errno. exit (#1) doesn't.
    if (!util.contains(d1, "b.cc .Ldwsc_")) { return 271; }
    if (!util.contains(d1, "neg x0, x0")) { return 272; }

    // arm64-darwin ABI-divergent syscall builtins: emit_module(_, true)
    // selects gettimeofday for now_unix_ms (Darwin has no clock_gettime
    // syscall) and chunked getentropy for random_bytes (no getrandom).
    // These are emitted directly by the code generator (the darwin flag),
    // not by the darwinize post-pass — so check emit_module output, which
    // keeps it cheap (no O(n^2) post-pass over a full module). We assert
    // the positive marker on each path: x16 is a general scratch register,
    // so "absence of #116/#500" would be a flaky check.
    var nowsrc: string = "var t: i64 = now_unix_ms(); return 0;";
    var nowd: string = emit_module(parser.parse_module(lexer.tokenize(nowsrc)), true);
    if (!util.contains(nowd, "mov x16, #116")) { return 280; }   // Darwin: gettimeofday
    if (!util.contains(nowd, "svc #0x80")) { return 281; }
    var nowl: string = emit_module(parser.parse_module(lexer.tokenize(nowsrc)), false);
    if (!util.contains(nowl, "mov x8, #113")) { return 282; }    // Linux: clock_gettime

    var rbsrc: string = "var b: string = random_bytes(8); return 0;";
    var rbd: string = emit_module(parser.parse_module(lexer.tokenize(rbsrc)), true);
    if (!util.contains(rbd, "mov x16, #500")) { return 283; }    // Darwin: getentropy
    if (!util.contains(rbd, ".Lrb_loop:")) { return 284; }       // chunked-loop marker
    var rbl: string = emit_module(parser.parse_module(lexer.tokenize(rbsrc)), false);
    if (!util.contains(rbl, "mov x8, #278")) { return 285; }     // Linux: getrandom

    // sleep_ms — emitted unconditionally. Darwin: select (sysno 93, no
    // nanosleep); Linux: nanosleep (101).
    var slsrc: string = "sleep_ms(5); return 0;";
    var sld: string = emit_module(parser.parse_module(lexer.tokenize(slsrc)), true);
    if (!util.contains(sld, "mov x16, #93")) { return 286; }     // Darwin: select
    var sll: string = emit_module(parser.parse_module(lexer.tokenize(slsrc)), false);
    if (!util.contains(sll, "mov x8, #101")) { return 287; }     // Linux: nanosleep

    // subprocess — Darwin branches pipe (pipe() sysno 42 + the x1
    // write-fd store) and fork (fork() sysno 2 + the .Lsp_forked
    // child-flag normalisation); dup3→dup2 / execve / wait4 ride
    // darwin_sysno (90 / 59 / 7). Linux keeps pipe2 (59) / clone (220).
    var spsrc: string = "var r: ProcessResult = subprocess(\"echo\", [\"hi\"], \"\"); return r.exit_code;";
    var spd: string = emit_module(parser.parse_module(lexer.tokenize(spsrc)), true);
    // pipe + fork are emitted directly by the code generator's darwin
    // flag (like gettimeofday / getentropy above).
    if (!util.contains(spd, "mov x16, #42")) { return 288; }     // Darwin: pipe
    if (!util.contains(spd, ".Lsp_forked:")) { return 289; }     // Darwin: fork child-flag
    // dup3→dup2 / execve / wait4 ride the darwinize syscall-number remap,
    // so assert against the post-pass output.
    var spdd: string = darwinize(spd);
    if (!util.contains(spdd, "mov x16, #90")) { return 290; }    // Darwin: dup2
    if (!util.contains(spdd, "mov x16, #59")) { return 291; }    // Darwin: execve
    if (!util.contains(spdd, "mov x16, #7")) { return 292; }     // Darwin: wait4
    var spl: string = emit_module(parser.parse_module(lexer.tokenize(spsrc)), false);
    if (!util.contains(spl, "mov x8, #220")) { return 293; }     // Linux: clone
    if (!util.contains(spl, "mov x8, #59")) { return 294; }      // Linux: pipe2

    // TCP — socket/bind/listen/accept ride darwin_sysno (97/104/106/30);
    // the sockaddr_in sin_len byte (strb #16) is emitted directly.
    var tcsrc: string = "var fd: i32 = tcp_listen(8080); var c: i32 = tcp_accept(fd); var r: string = tcp_recv(c, 16); var n: i32 = tcp_send(c, \"hi\"); return tcp_close(c);";
    var tcl: string = emit_module(parser.parse_module(lexer.tokenize(tcsrc)), false);
    if (!util.contains(tcl, "mov x8, #198")) { return 295; }     // Linux: socket
    if (!util.contains(tcl, "mov x8, #202")) { return 296; }     // Linux: accept
    var tcd: string = darwinize(emit_module(parser.parse_module(lexer.tokenize(tcsrc)), true));
    if (!util.contains(tcd, "mov x16, #97")) { return 297; }     // Darwin: socket
    if (!util.contains(tcd, "mov x16, #104")) { return 298; }    // Darwin: bind
    if (!util.contains(tcd, "mov x16, #106")) { return 299; }    // Darwin: listen
    if (!util.contains(tcd, "mov x16, #30")) { return 300; }     // Darwin: accept
    if (!util.contains(tcd, "strb w0, [sp, #1]")) { return 301; } // Darwin: sin_len/family

    // UDP — socket/sendto/close; the dotted-quad parse + SOCK_DGRAM.
    var udsrc: string = "return udp_send(\"127.0.0.1\", 8125, \"m:1|c\");";
    var udl: string = emit_module(parser.parse_module(lexer.tokenize(udsrc)), false);
    if (!util.contains(udl, "mov x8, #206")) { return 302; }     // Linux: sendto
    if (!util.contains(udl, ".Ludp_pl:")) { return 303; }        // dotted-quad parse loop
    var udd: string = darwinize(emit_module(parser.parse_module(lexer.tokenize(udsrc)), true));
    if (!util.contains(udd, "mov x16, #133")) { return 304; }    // Darwin: sendto

    return 0;
}
