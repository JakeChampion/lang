                s = s.write("    adrp x1, .S" + i32_to_string(uvLit.idx) + "\n");
                s = s.write("    add x1, x1, :lo12:.S" + i32_to_string(uvLit.idx) + "\n");
                s = s.write("    str x1, [x0]\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = s.write("    // unresolved ident: " + id.name + "\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprString(sv) => {
            // String literal: intern bytes in .rodata, allocate
            // 16-byte heap box [data_ptr, len], push box ptr.
            var lo: StringLitOut = add_string_lit(s, sv.value);
            s = lo.state;
            s = s.write("    mov x0, #16\n");
            s = s.write("    bl __fern_alloc\n");
            s = s.mark_heap();
            s = s.write("    adrp x1, .S" + i32_to_string(lo.idx) + "\n");
            s = s.write("    add x1, x1, :lo12:.S" + i32_to_string(lo.idx) + "\n");
            s = s.write("    str x1, [x0]\n");
            s = s.write("    mov x1, #" + i32_to_string(sv.value.len()) + "\n");
            s = s.write("    str x1, [x0, #8]\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprCall(c) => {
            var name: string = "";
