// examples/self_host/asm_arm64.fern — sibling of asm.fern for
// the ARM64 / aarch64 Linux target. Walks a parser.Module and
// emits GAS-flavoured aarch64 assembly text. The emitted asm
// uses Linux syscall conventions (sys_exit = 93) and is
// assemble-able with `aarch64-linux-gnu-gcc -nostdlib`.
//
// Scope:
//   - i32 literals
//   - i32 arithmetic: + - * / %
//   - Comparisons: < <= > >= == != → 0/1 i32 via cmp + cset
//   - Bool literals (false=0, true=1 on the rt-stack)
//   - Unary `-`
//   - Control flow: if/else and while (forward-branch patching
//     via unique generated labels)
//   - Statement-level: `return <expr>;` lowers to sys_exit
//
// Lowering shape — a textual stack machine on the architectural
// stack (sp). Each expr leaves its result on the rt-stack via:
//   literal n:  ldr x0, =n; str x0, [sp, #-16]!
//   bin l op r: <emit l>; <emit r>;
//               ldr x1, [sp], #16; ldr x0, [sp], #16;
//               <op>; str x0, [sp, #-16]!
// Statement `return <expr>;` pops into x0 and issues sys_exit
// (syscall number in x8, args in x0..x7).
//
// 16-byte stack alignment requirement on ARM64 means we use
// `[sp, #-16]!` even though each value is 8 bytes — wastes 8
// bytes per push but keeps sp 16-aligned for any nested
// syscalls / function calls that follow.

import "./lexer";
import "./parser";
import "./asmcore";
import "./util";
import "./ir";
import "./irlower";
import "./asm_ir";
import "./asm_arm64_ir";






































































// frame_ldr / frame_str load/store `reg` at the x29-relative frame
// offset `off` (always <= 0 — locals live below the frame pointer,
// since sp moves with the operand-stack push/pop). A scaled ldr/str
// can't encode a negative offset and the unscaled (ldur/stur) form
// only reaches -256, so a frame with >32 slots overflows. When `off`
// is out of range, materialise the address in x16 (an AAPCS scratch
// register never live across a frame access here) via `sub` first.
function (s: asmcore.EmitState) frame_ldr(reg: string, off: i32): asmcore.EmitState {
    if (off >= 0 - 256) {
        s = s.write("    ldr " + reg + ", [x29, #" + util.i32_to_string(off) + "]\n"); return s;
    }
    s = s.write("    sub x16, x29, #" + util.i32_to_string(0 - off) + "\n");
    s = s.write("    ldr " + reg + ", [x16]\n"); return s;
}

function (s: asmcore.EmitState) frame_str(reg: string, off: i32): asmcore.EmitState {
    if (off >= 0 - 256) {
        s = s.write("    str " + reg + ", [x29, #" + util.i32_to_string(off) + "]\n"); return s;
    }
    s = s.write("    sub x16, x29, #" + util.i32_to_string(0 - off) + "\n");
    s = s.write("    str " + reg + ", [x16]\n"); return s;
}



// emit_ldc loads the f64 constant at .rodata label `lbl` into the
// given d-register, using x12 as the address scratch. Used by the
// transcendental runtime functions (their polynomial coefficients
// live in .rodata). x12 is caller-saved and unused elsewhere in
// those functions.
function emit_ldc(s: asmcore.EmitState, reg: string, lbl: string): asmcore.EmitState {
    s = s.write("    adrp x12, " + lbl + "\n");
    s = s.write("    add x12, x12, :lo12:" + lbl + "\n");
    s = s.write("    ldr " + reg + ", [x12]\n");
    return s;
}











// =================== ASM EMITTER ====================

// emit_fn_value emits a 1-slot closure box [&__fn_name] for a function
// referenced by name as a value. Shared by ExprIdent (params>0) and the
// call-arg path (a fn-typed param of any arity — including a 0-arg
// `() => R`, which can't be distinguished from a const at the ident
// site, so the boxing decision is made at the call site instead).
function emit_fn_value(name: string, s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("    mov x0, #8\n");
    s = s.write("    bl __fern_alloc\n");
    s = s.mark_heap();
    s = s.write("    adrp x1, __fn_" + asmcore.sanitize_label(name) + "\n");
    s = s.write("    add x1, x1, :lo12:__fn_" + asmcore.sanitize_label(name) + "\n");
    s = s.write("    str x1, [x0]\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    return s;
}




// emit_call lowers a parser.ExprCall (the `c` payload). Split out
// of emit_expr's match so the dispatch reads as a table and this
// arm — the largest by far — is independently navigable.
// CallOut signals whether try_emit_builtin handled the call.
struct CallOut { state: asmcore.EmitState, done: boolean }

// try_emit_builtin lowers a builtin/intrinsic free call by name
// (print, len, str_*, map_new, Some/Ok/Err, f64 intrinsics, strbuf,
// …). Returns done=true when it emitted the call; done=false (with
// the state untouched) when `name` is not a builtin, so emit_call
// falls through to the closure / generic user-call path.
// enum_payload_retain — arm64 mirror: retain an enum / Option / Result
// payload in x1 when it aliases an rc-tracked array (the box now owns
// the reference). Box ptr in x0 preserved across the call. A fresh
// literal / call payload is owned and not re-retained.
function enum_payload_retain(arg: parser.Expr, s: asmcore.EmitState): asmcore.EmitState {
    if (!asmcore.needs_rc_inc_on_alias(arg, s)) { return s; }
    s = s.mark_heap();
    s = s.write("    str x0, [sp, #-16]!\n");   // save box ptr
    s = s.write("    str x1, [sp, #-16]!\n");   // retain arg = payload
    s = s.write("    bl __fn___fern_rc_inc\n");
    s = s.write("    mov x1, x0\n");            // payload (helper returns ptr)
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    ldr x0, [sp], #16\n");     // restore box ptr
    return s;
}

function try_emit_builtin(c: parser.ExprCall, name: string, s: asmcore.EmitState): CallOut {
    if (name == "len" && c.args.len() == 1) {
        // Dispatch on operand type: string box → load
        // len at +8; array box → load len at +0.
        var lt: asmcore.Ty = asmcore.infer_expr_type(c.args[0], s);
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        if (asmcore.ty_is_string(lt)) {
            s = s.write("    ldr x0, [x0, #8]\n");
        } else {
            s = s.write("    ldr x0, [x0]\n");
        }
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // Raw-memory intrinsics (#2649 Tier-2 floor — docs/RUNTIME-INTRINSICS.md).
    // Unsafe/unchecked; only the audited Tier-2 helpers use them. Args arrive on
    // the operand stack left-to-right (16-byte slots; last arg on top). Stores
    // push the value back to keep the one-value-per-expr invariant. Mirrors asm.fern.
    if (name == "__raw_alloc" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n    bl __fern_alloc\n    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "__raw_store8" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = emit_expr(c.args[2], s);
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    add x0, x0, x1\n    strb w2, [x0]\n    str x2, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    if (name == "__raw_load8" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    add x0, x0, x1\n    ldrb w0, [x0]\n    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    if (name == "__raw_store_ptr" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = emit_expr(c.args[2], s);
        s = s.write("    ldr x2, [sp], #16\n    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    str x2, [x0, x1, lsl #3]\n    str x2, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    if (name == "__raw_load_ptr" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    ldr x0, [x0, x1, lsl #3]\n    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    if (name == "__raw_string" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        // rc-headered box via __fern_str_box (#2649 Option A A1b): len (top) -> x1,
        // data -> x0. A legacy-path box can flow into an IR caller that reclaims it,
        // so it carries the same rc header as the IR path's boxes.
        s = s.write("    ldr x1, [sp], #16\n    ldr x0, [sp], #16\n    bl __fern_str_box\n    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // `write(s)` == `print(s)` here (the self-host print
    // runtime has no trailing newline); the bootstrap driver
    // uses write for byte-identical output. Mirrors asm.fern.
    if ((name == "print" || name == "write") && c.args.len() == 1) {
        // `print` appends a newline (Fern's print == println);
        // `write` emits the bytes verbatim.
        var add_nl: boolean = name == "print";
        var arg: parser.Expr = c.args[0];
        match (arg) {
            parser.ExprString(sv) => {
                var lit_val: string = sv.value;
                if (add_nl) { lit_val = sv.value + "\n"; }
                var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, lit_val);
                s = lo.state;
                var lbl: string = "" + asm_ir.str_lit_label(s, lo.idx);
                s = s.write("    mov x0, #1\n");     // fd
                s = s.write("    adrp x1, " + lbl + "\n");
                s = s.write("    add x1, x1, :lo12:" + lbl + "\n");
                s = s.write("    mov x2, #" + util.i32_to_string(lit_val.len()) + "\n");
                s = s.write("    mov x8, #64\n");    // sys_write
                s = s.write("    svc #0\n");
                s = s.write("    mov x0, #0\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return CallOut { state: s, done: true };
            },
            _ => { }
        }
        // Non-literal string argument → __fern_print_str.
        var at: asmcore.Ty = asmcore.infer_expr_type(arg, s);
        if (asmcore.ty_is_string(at)) {
            s = emit_expr(arg, s);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.write("    bl __fern_print_str\n");
            s = s.mark_str_print();
            if (add_nl) {
                var nlo: asmcore.StringLitOut = asmcore.add_string_lit(s, "\n");
                s = nlo.state;
                var nlbl: string = "" + asm_ir.str_lit_label(s, nlo.idx);
                s = s.write("    mov x0, #1\n");
                s = s.write("    adrp x1, " + nlbl + "\n");
                s = s.write("    add x1, x1, :lo12:" + nlbl + "\n");
                s = s.write("    mov x2, #1\n");
                s = s.write("    mov x8, #64\n");
                s = s.write("    svc #0\n");
            }
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.mark_str_print();
            return CallOut { state: s, done: true };
        }
    }
    // eprint(s) — same as print but writes to stderr.
    if (name == "eprint" && c.args.len() == 1) {
        var earg: parser.Expr = c.args[0];
        match (earg) {
            parser.ExprString(esv) => {
                // eprint appends a newline (stderr line-printer); the trailing
                // "\n" rides along in the interned literal so it's one write.
                var elit: string = esv.value + "\n";
                var elo: asmcore.StringLitOut = asmcore.add_string_lit(s, elit);
                s = elo.state;
                var elbl: string = "" + asm_ir.str_lit_label(s, elo.idx);
                s = s.write("    mov x0, #2\n");     // fd 2 stderr
                s = s.write("    adrp x1, " + elbl + "\n");
                s = s.write("    add x1, x1, :lo12:" + elbl + "\n");
                s = s.write("    mov x2, #" + util.i32_to_string(elit.len()) + "\n");
                s = s.write("    mov x8, #64\n");
                s = s.write("    svc #0\n");
                s = s.write("    mov x0, #0\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return CallOut { state: s, done: true };
            },
            _ => { }
        }
        var eat: asmcore.Ty = asmcore.infer_expr_type(earg, s);
        if (asmcore.ty_is_string(eat)) {
            s = emit_expr(earg, s);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.write("    bl __fern_eprint_str\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.mark_eprint();
            return CallOut { state: s, done: true };
        }
    }
    // print_int(i32_expr) — builtin lowering to a call into
    // a runtime helper that converts the value to decimal
    // text and writes it to stdout.
    if (name == "print_int" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_print_int\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_print_int();
        return CallOut { state: s, done: true };
    }
    if (name == "eprint_int" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    bl __fn___fern_i32_to_string\n");
        s = s.write("    add sp, sp, #16\n");
        s = s.write("    bl __fern_eprint_str\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_i32_to_string();
        s = s.mark_eprint();
        return CallOut { state: s, done: true };
    }
    if (name == "exit" && c.args.len() == 1) {
        // sys_exit is syscall #93 on aarch64.
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    mov x8, #93\n");
        s = s.write("    svc #0\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    if (name == "args_count" && c.args.len() == 0) {
        s = s.write("    adrp x0, __fern_argc\n");
        s = s.write("    add x0, x0, :lo12:__fern_argc\n");
        s = s.write("    ldr x0, [x0]\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_args();
        return CallOut { state: s, done: true };
    }
    // args() — the full language's argv accessor: returns a
    // string[] of all command-line arguments (argv[0] first).
    if (name == "args" && c.args.len() == 0) {
        s = s.write("    bl __fern_args\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_args();
        return CallOut { state: s, done: true };
    }
    if (name == "arg_at" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_arg_at\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_args();
        return CallOut { state: s, done: true };
    }
    if (name == "str_split" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);   // s
        s = emit_expr(c.args[1], s);   // sep
        s = s.write("    ldr x1, [sp], #16\n");   // sep
        s = s.write("    ldr x0, [sp], #16\n");   // s
        // __fn_ stack convention: param[0]=s on top (+16), param[1]=sep (+32).
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_split\n    add sp, sp, #32\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_split();
        return CallOut { state: s, done: true };
    }
    // read_int() — builtin no-arg call to the read_int
    // helper. Returns the value in x0; push to rt-stack.
    if (name == "read_int" && c.args.len() == 0) {
        s = s.write("    bl __fern_read_int\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_read_int();
        return CallOut { state: s, done: true };
    }
    // read_line() — no-arg builtin. Returns string box.
    if (name == "read_line" && c.args.len() == 0) {
        s = s.write("    bl __fern_read_line\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_read_line();
        return CallOut { state: s, done: true };
    }
    // read_all_stdin() — read fd 0 to EOF into one box (loops
    // the read syscall, unlike read_line's single read).
    // Piggybacks the read_line needs-flag for runtime + heap.
    if (name == "read_all_stdin" && c.args.len() == 0) {
        s = s.write("    bl __fern_read_all_stdin\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_read_line();
        return CallOut { state: s, done: true };
    }
    // read_file(path) — read the whole named file. Returns
    // Result[string, IoError]: Ok(contents) / Err(_). Matches
    // the full language's signature (see asm.fern).
    if (name == "read_file" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_read_file\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // write_file(path, content) — write content to the named
    // file. Returns Option[IoError]: None ok, Some(_) on error.
    if (name == "write_file" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x1, [sp], #16\n");   // content box
        s = s.write("    ldr x0, [sp], #16\n");   // path box
        s = s.write("    bl __fern_write_file\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // now_unix_ms() — wall-clock milliseconds since the Unix
    // epoch (clock_gettime(CLOCK_REALTIME)). Returns an i64 in
    // x0; no heap.
    if (name == "now_unix_ms" && c.args.len() == 0) {
        s = s.write("    bl __fern_now_unix_ms\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // monotonic_ns() — nanoseconds from a monotonic clock
    // (clock_gettime(CLOCK_MONOTONIC)). For elapsed-time
    // measurement, not wall-clock. Returns an i64 in x0.
    if (name == "monotonic_ns" && c.args.len() == 0) {
        s = s.write("    bl __fern_monotonic_ns\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // now_ns() — wall-clock nanoseconds since the Unix epoch
    // (clock_gettime(CLOCK_REALTIME)). The i64 nanosecond twin of
    // now_unix_ms. Returns an i64 in x0; no heap.
    if (name == "now_ns" && c.args.len() == 0) {
        s = s.write("    bl __fern_now_ns\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // sleep_ms / remove_file / f{32,64}_bits / f{32,64}_from_bits —
    // see asm.fern for the rationale; the same shape ports cleanly.
    if (name == "sleep_ms" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_sleep_ms\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    if (name == "remove_file" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_remove_file\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // subprocess(cmd, args, stdin) → ProcessResult. Mirror of
    // the x86 dispatch in asm.fern. Args (left to right) reach
    // the helper in x0 / x1 / x2.
    if (name == "subprocess" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = emit_expr(c.args[2], s);
        s = s.write("    ldr x2, [sp], #16\n");   // stdin box
        s = s.write("    ldr x1, [sp], #16\n");   // args box
        s = s.write("    ldr x0, [sp], #16\n");   // cmd box
        s = s.write("    bl __fern_subprocess\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // TCP primitives — the raw sockets layer std/tcp.fern's
    // tcp_serve() builds the HTTP edge-handler loop on. All return
    // an i32 (fd / byte count / -errno) except tcp_recv, which
    // returns a fresh string box. mark_heap() pulls in the helper
    // block (and the allocator) where the bodies are emitted.
    if (name == "tcp_listen" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");   // port
        s = s.write("    bl __fern_tcp_listen\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "tcp_accept" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");   // listener fd
        s = s.write("    bl __fern_tcp_accept\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "tcp_recv" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x1, [sp], #16\n");   // max
        s = s.write("    ldr x0, [sp], #16\n");   // fd
        s = s.write("    bl __fern_tcp_recv\n");
        s = s.write("    str x0, [sp, #-16]!\n"); // string box
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "tcp_send" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x1, [sp], #16\n");   // data box
        s = s.write("    ldr x0, [sp], #16\n");   // fd
        s = s.write("    bl __fern_tcp_send\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "tcp_close" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");   // fd
        s = s.write("    bl __fern_tcp_close\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // udp_send(host, port, data) → i32 — one-shot IPv4 datagram.
    // Args reach the helper in x0 (host box) / x1 (port) / x2
    // (data box).
    if (name == "udp_send" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = emit_expr(c.args[2], s);
        s = s.write("    ldr x2, [sp], #16\n");   // data box
        s = s.write("    ldr x1, [sp], #16\n");   // port
        s = s.write("    ldr x0, [sp], #16\n");   // host box
        s = s.write("    bl __fern_udp_send\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // temp_dir(prefix) — make a uniquely-named directory under
    // /tmp. Returns Result[string]: Ok(path) or Err(_). The
    // helper body is emitted unconditionally above; this was
    // the missing dispatch.
    if (name == "temp_dir" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_temp_dir\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // stat(path) — file metadata. Returns Result[FileStat]:
    // Ok(FileStat{is_file, is_dir, size}) or Err(_).
    if (name == "stat" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_stat\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // read_dir(path) — list a directory's base-name children.
    // Returns Result[string[]]: Ok(names) or Err(_).
    if (name == "read_dir" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_read_dir\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // remove_dir_all(path) — recursive rm -rf. Returns
    // Option[IoError]: None ok, Some(_) on error.
    if (name == "remove_dir_all" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_remove_dir_all\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if ((name == "f64_bits" || name == "f64_from_bits") && c.args.len() == 1) {
        return CallOut { state: emit_expr(c.args[0], s), done: true };
    }
    if (name == "f32_bits" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    fmov d0, x0\n");
        s = s.write("    fcvt s0, d0\n");
        s = s.write("    fmov w0, s0\n");
        s = s.write("    sxtw x0, w0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    if (name == "f32_from_bits" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    fmov s0, w0\n");
        s = s.write("    fcvt d0, s0\n");
        s = s.write("    fmov x0, d0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // env(name) — look up an environment variable. Returns
    // Option[string]: Some(value) if set, None otherwise.
    if (name == "env" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");   // name box
        s = s.write("    bl __fern_env\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // Filesystem builtins (mirror of asm.fern): each lowers to
    // a `bl __fern_<name>` runtime helper that handles the
    // actual syscall + box layout. Without these dispatches the
    // generic user-fn path emits `bl __fn_temp_dir` etc., which
    // link-error against undefined symbols.
    if (name == "temp_dir" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_temp_dir\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "read_dir" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_read_dir\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "stat" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_stat\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "remove_dir_all" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_remove_dir_all\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // f64 math intrinsics — the cheap subset that lowers to a
    // single FP instruction. The -nostdlib native backends
    // can't link libm, so std/float's `__*_f64` primitives are
    // implemented directly. Operand + result are f64 bit
    // patterns on the stack (in x0). `__round_f64` is round-
    // half-away-from-zero (Go's math.Round) = frinta.
    if ((name == "__abs_f64" || name == "__sqrt_f64" || name == "__floor_f64"
            || name == "__ceil_f64" || name == "__trunc_f64" || name == "__round_f64")
            && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    fmov d0, x0\n");
        if (name == "__abs_f64") { s = s.write("    fabs d0, d0\n"); }
        else if (name == "__sqrt_f64") { s = s.write("    fsqrt d0, d0\n"); }
        else if (name == "__floor_f64") { s = s.write("    frintm d0, d0\n"); }
        else if (name == "__ceil_f64") { s = s.write("    frintp d0, d0\n"); }
        else if (name == "__trunc_f64") { s = s.write("    frintz d0, d0\n"); }
        else { s = s.write("    frinta d0, d0\n"); }
        s = s.write("    fmov x0, d0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // f64 transcendentals — arm64 has no transcendental
    // instructions, so these are polynomial-approximation
    // runtime functions (emitted unconditionally below). Pass
    // the arg in d0, result returns in d0.
    if ((name == "__sin_f64" || name == "__cos_f64"
            || name == "__exp_f64" || name == "__log_f64") && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    fmov d0, x0\n");
        if (name == "__sin_f64") { s = s.write("    bl __fern_sin_f64\n"); }
        else if (name == "__cos_f64") { s = s.write("    bl __fern_cos_f64\n"); }
        else if (name == "__exp_f64") { s = s.write("    bl __fern_exp_f64\n"); }
        else { s = s.write("    bl __fern_log_f64\n"); }
        s = s.write("    fmov x0, d0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // pow(x, y) = exp(y·log x) — d0 = x, d1 = y.
    if (name == "__pow_f64" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);   // x
        s = emit_expr(c.args[1], s);   // y
        s = s.write("    ldr x9, [sp], #16\n");   // y (top of stack)
        s = s.write("    ldr x0, [sp], #16\n");   // x
        s = s.write("    fmov d0, x0\n");
        s = s.write("    fmov d1, x9\n");
        s = s.write("    bl __fern_pow_f64\n");
        s = s.write("    fmov x0, d0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // __alloc_u8(n) — fresh zeroed byte array of n elements
    // (8-byte slots, cap header).
    if (name == "__alloc_u8" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_alloc_u8\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // __memcpy(dst, src, n) — raw byte copy (byte loop). See
    // asm.fern: only reached from std/string's dead bytes()
    // body, present so std/string links.
    if (name == "__memcpy" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);   // dst
        s = emit_expr(c.args[1], s);   // src
        s = emit_expr(c.args[2], s);   // n
        s = s.write("    ldr x2, [sp], #16\n");   // n
        s = s.write("    ldr x1, [sp], #16\n");   // src
        s = s.write("    ldr x0, [sp], #16\n");   // dst
        var mtop: asmcore.LabelOut = asmcore.fresh_label(s);
        s = mtop.state;
        var mdone: asmcore.LabelOut = asmcore.fresh_label(s);
        s = mdone.state;
        s = s.write(mtop.name + ":\n");
        s = s.write("    cbz x2, " + mdone.name + "\n");
        s = s.write("    ldrb w3, [x1], #1\n");
        s = s.write("    strb w3, [x0], #1\n");
        s = s.write("    sub x2, x2, #1\n");
        s = s.write("    b " + mtop.name + "\n");
        s = s.write(mdone.name + ":\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // string_from_bytes(arr) — pack each element's low byte
    // into a fresh string.
    if (name == "string_from_bytes" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);   // arr (stays on the stack = param[0])
        s = s.write("    bl __fn___fern_string_from_bytes\n    add sp, sp, #16\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_from_bytes();
        return CallOut { state: s, done: true };
    }
    // map_new(n) — fresh empty Map. The capacity hint is
    // evaluated for side effects then ignored.
    if ((name == "map_new" || name == "map_new_i32") && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_map_new\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return CallOut { state: s, done: true };
    }
    // cell_new(v) — single-slot box (docs/CELL-TYPE-PLAN.md): alloc 8
    // bytes, store the value, return the pointer (leak-everything, no RC).
    if (name == "cell_new" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);             // value on the stack
        s = s.write("    mov x0, #8\n");
        s = s.write("    bl __fern_alloc\n");     // x0 = cell ptr
        s = s.write("    ldr x1, [sp], #16\n");   // value
        s = s.write("    str x1, [x0]\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // random_bytes(n) — string of n random bytes (getrandom).
    if (name == "random_bytes" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_random_bytes\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    // __set_index(arr, idx, val) — array element assignment
    // (desugar of `arr[idx] = val`). Pushes a dummy result.
    if (name == "__set_index" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);   // arr
        s = emit_expr(c.args[1], s);   // idx
        s = emit_expr(c.args[2], s);   // val
        s = s.write("    ldr x2, [sp], #16\n");   // val
        s = s.write("    ldr x1, [sp], #16\n");   // idx
        s = s.write("    ldr x0, [sp], #16\n");   // arr
        s = s.write("    add x1, x1, #1\n");       // skip len prefix
        s = s.write("    str x2, [x0, x1, lsl #3]\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // __set_field(obj, "field", val) — desugar of
    // `obj.field = val`. Mirrors asm.fern: shape-dispatch and
    // store val at the field's slot (idx+1)*8.
    if (name == "__set_field" && c.args.len() == 3) {
        var sf_field: string = "";
        match (c.args[1]) {
            parser.ExprString(sv) => { sf_field = sv.value; },
            _ => { }
        }
        s = emit_expr(c.args[0], s);   // obj
        s = emit_expr(c.args[2], s);   // val
        s = s.write("    ldr x1, [sp], #16\n");   // val
        s = s.write("    ldr x0, [sp], #16\n");   // obj ptr
        var sf_end: asmcore.LabelOut = asmcore.fresh_label(s);
        s = sf_end.state;
        var sfdi: i32 = 0;
        while (sfdi < s.struct_decls.len()) {
            var sfsd: parser.StructDecl = s.struct_decls[sfdi];
            var sffi: i32 = 0;
            var sf_found: i32 = 0 - 1;
            while (sffi < sfsd.fields.len()) {
                if (sfsd.fields[sffi].name == sf_field) { sf_found = sffi; }
                sffi = sffi + 1;
            }
            if (sf_found >= 0) {
                var sf_next: asmcore.LabelOut = asmcore.fresh_label(s);
                s = sf_next.state;
                var sf_lit: asmcore.StringLitOut = asmcore.add_string_lit(s, sfsd.name);
                s = sf_lit.state;
                s = s.write("    ldr x2, [x0]\n");
                s = s.write("    adrp x3, " + asm_ir.str_lit_label(s, sf_lit.idx) + "\n");
                s = s.write("    add x3, x3, :lo12:" + asm_ir.str_lit_label(s, sf_lit.idx) + "\n");
                s = s.write("    cmp x2, x3\n");
                s = s.write("    b.ne " + sf_next.name + "\n");
                s = s.write("    str x1, [x0, #" + util.i32_to_string((sf_found + 1) * 8) + "]\n");
                s = s.write("    b " + sf_end.name + "\n");
                s = s.write(sf_next.name + ":\n");
            }
            sfdi = sfdi + 1;
        }
        s = s.write(sf_end.name + ":\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // stdin() — returns a Reader (its fd; 0 for stdin).
    // read_chunk / close take the fd value directly.
    if (name == "stdin" && c.args.len() == 0) {
        s = s.write("    mov x0, #0\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // Some(x) — wrap a payload in an Option. Heap box
    // [tag=0 @0, payload @8]; the matching None has tag 1.
    if (name == "Some" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.mark_heap();
        s = s.write("    ldr x1, [sp], #16\n");   // payload
        s = enum_payload_retain(c.args[0], s);    // Perceus: retain an rc-tracked array payload
        s = s.write("    mov x2, #0\n");
        s = s.write("    str x2, [x0]\n");         // tag = Some
        s = s.write("    str x1, [x0, #8]\n");     // payload
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // Ok(x) / Err(x) — Result wrapper. Same box shape as
    // Option: tag @0, payload @8. Ok = 0 / Err = 1. See asm.fern.
    if ((name == "Ok" || name == "Err") && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.mark_heap();
        s = s.write("    ldr x1, [sp], #16\n");
        s = enum_payload_retain(c.args[0], s);    // Perceus: retain an rc-tracked array payload
        if (name == "Ok") {
            s = s.write("    mov x2, #0\n");
        } else {
            s = s.write("    mov x2, #1\n");
        }
        s = s.write("    str x2, [x0]\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // Enum variant constructor with payload: `Circle(x)`. Heap
    // box [shape_ptr @0, payload @8] — see asm.fern.
    if (asmcore.is_enum_variant(name, s) && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.mark_heap();
        s = s.write("    ldr x1, [sp], #16\n");   // payload
        s = enum_payload_retain(c.args[0], s);    // Perceus: retain an rc-tracked array payload
        var evLit: asmcore.StringLitOut = asmcore.add_string_lit(s, name);
        s = evLit.state;
        s = s.write("    adrp x2, " + asm_ir.str_lit_label(s, evLit.idx) + "\n");
        s = s.write("    add x2, x2, :lo12:" + asm_ir.str_lit_label(s, evLit.idx) + "\n");
        s = s.write("    str x2, [x0]\n");         // shape ptr
        s = s.write("    str x1, [x0, #8]\n");     // payload
        s = s.write("    str x0, [sp, #-16]!\n");
        return CallOut { state: s, done: true };
    }
    // i32_to_string(n) — decimal text → string box.
    if (name == "i32_to_string" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    bl __fn___fern_i32_to_string\n");
        s = s.write("    add sp, sp, #16\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_i32_to_string();
        return CallOut { state: s, done: true };
    }
    // `int.int_to_string(n)` → __fern_i32_to_string. See asm.fern.
    if (name == "int__int_to_string" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    bl __fn___fern_i32_to_string\n");
        s = s.write("    add sp, sp, #16\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_i32_to_string();
        return CallOut { state: s, done: true };
    }
    // str_to_i32(s) — parse string box to i32.
    if (name == "str_to_i32" && c.args.len() == 1) {
        // __fern_str_to_i32 is a Fern runtime function (#2649): call it via the
        // ordinary __fn_ stack convention (the borrowed string is param[0]).
        // One Fern body serves both the AST and IR arm64 paths (they share
        // asm_arm64.emit_runtime), since the IR call site also uses this symbol.
        s = emit_expr(c.args[0], s);
        s = s.write("    bl __fn___fern_str_to_i32\n");
        s = s.write("    add sp, sp, #16\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_to_i32();
        return CallOut { state: s, done: true };
    }
    // str_starts_with / str_contains / str_index_of —
    // shared __fern_str_starts_with + __fern_str_index_of
    // runtime helpers.
    if (name == "str_starts_with" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x1, [sp], #16\n");
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_starts_with\n    add sp, sp, #32\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_search();
        return CallOut { state: s, done: true };
    }
    if (name == "str_ends_with" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x1, [sp], #16\n");
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_ends_with\n    add sp, sp, #32\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_search();
        return CallOut { state: s, done: true };
    }
    if (name == "str_contains" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x1, [sp], #16\n");
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_index_of\n    add sp, sp, #32\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    cset x0, ge\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_search();
        return CallOut { state: s, done: true };
    }
    if (name == "str_index_of" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x1, [sp], #16\n");
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_index_of\n    add sp, sp, #32\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_search();
        return CallOut { state: s, done: true };
    }
    if (name == "str_trim" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_str_trim\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_search();
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "str_to_upper" && c.args.len() == 1) {
        // __fern_str_to_upper is a Fern runtime function now (#2649): __fn_ stack
        // convention; mark_str_case pulls heap. Un-bundled from str_search.
        s = emit_expr(c.args[0], s);
        s = s.write("    bl __fn___fern_str_to_upper\n");
        s = s.write("    add sp, sp, #16\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_case();
        return CallOut { state: s, done: true };
    }
    if (name == "str_to_lower" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    bl __fn___fern_str_to_lower\n");
        s = s.write("    add sp, sp, #16\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_case();
        return CallOut { state: s, done: true };
    }
    if (name == "str_repeat" && c.args.len() == 2) {
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x1, [sp], #16\n");   // n
        s = s.write("    ldr x0, [sp], #16\n");   // s
        // __fn_ stack convention: param[0]=s on top (+16), param[1]=n (+32).
        s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_repeat\n    add sp, sp, #32\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_repeat();
        return CallOut { state: s, done: true };
    }
    if (name == "str_replace" && c.args.len() == 3) {
        s = emit_expr(c.args[0], s);   // h
        s = emit_expr(c.args[1], s);   // o
        s = emit_expr(c.args[2], s);   // nw
        s = s.write("    ldr x2, [sp], #16\n");   // nw
        s = s.write("    ldr x1, [sp], #16\n");   // o
        s = s.write("    ldr x0, [sp], #16\n");   // h
        // __fn_ stack convention: param[0]=h on top (+16), param[1]=o (+32),
        // param[2]=nw (+48). Push param2, param1, param0.
        s = s.write("    str x2, [sp, #-16]!\n    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_replace\n    add sp, sp, #48\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_replace();
        return CallOut { state: s, done: true };
    }
    if (name == "chr" && c.args.len() == 1) {
        // __fern_chr is a Fern runtime function now (#2649, via the raw-memory
        // intrinsics): __fn_ stack convention (b=param[0] at [x29,#16]). mark_chr
        // pulls in heap. No longer rides the str_search bundle.
        s = emit_expr(c.args[0], s);
        s = s.write("    bl __fn___fern_chr\n");
        s = s.write("    add sp, sp, #16\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_chr();
        return CallOut { state: s, done: true };
    }
    // strbuf_reset() / strbuf_append(s) / strbuf_take() —
    // the global string-builder primitive. The Go backend
    // emits these as builtins; the self-host emitter must do
    // the same, otherwise a program that uses strbuf (such as
    // asm_arm64.fern itself — its `write` routes through it)
    // links with undefined `__fern_strbuf_*` references.
    // Runtime calling convention (arg in x0, result in x0),
    // NOT the stack-arg user-call path. mark_heap pulls in
    // __fern_alloc (strbuf_take allocates) and gates the
    // runtime emission below on needs_heap.
    if (name == "strbuf_reset" && c.args.len() == 0) {
        s = s.write("    bl __fern_strbuf_reset\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "strbuf_append" && c.args.len() == 1) {
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    bl __fern_strbuf_append\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    if (name == "strbuf_take" && c.args.len() == 0) {
        s = s.write("    bl __fern_strbuf_take\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return CallOut { state: s, done: true };
    }
    return CallOut { state: s, done: false };
}

// emit_method_call lowers a method / field-access call
// (obj.method(args)): the reader, map, string and array
// intrinsics plus the runtime shape-pointer dispatch over
// struct + enum receiver methods. Split out of emit_call's
// callee match; the arm always handles the call (a no-match
// pushes the -1 sentinel), so this returns EmitState directly.
function emit_method_call(c: parser.ExprCall, fa: parser.ExprFieldAccess, s: asmcore.EmitState): asmcore.EmitState {
    // Reader.read_chunk(n) — read up to n bytes from
    // the receiver fd; Some(string) on a non-empty
    // read, None at EOF. Receiver is a Reader (fd).
    if (fa.field == "read_chunk" && c.args.len() == 1) {
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x1, [sp], #16\n");   // n
        s = s.write("    ldr x0, [sp], #16\n");   // fd
        s = s.write("    bl __fern_reader_read_chunk\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return s;
    }
    // Reader.close() — close the receiver fd; always
    // returns None (the IoError arm is unused here).
    if (fa.field == "close" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    ldr x0, [sp], #16\n");   // fd
        s = s.write("    bl __fern_reader_close\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        return s;
    }
    // Primitive-receiver fast path: see
    // asm.fern for rationale.
    var prim_recv: asmcore.Ty = asmcore.infer_expr_type(fa.obj, s);
    // Cell[T] (docs/CELL-TYPE-PLAN.md): get() loads slot 0; set(v) stores
    // it in place and returns void (dummy pushed for the statement pop).
    if (asmcore.is_cell(prim_recv) && fa.field == "get" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    ldr x0, [x0]\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return s;
    }
    if (asmcore.is_cell(prim_recv) && fa.field == "set" && c.args.len() == 1) {
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x1, [sp], #16\n");   // value
        s = s.write("    ldr x0, [sp], #16\n");   // cell ptr
        s = s.write("    str x1, [x0]\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    str x0, [sp, #-16]!\n");  // void placeholder
        return s;
    }
    // Map methods (string-keyed). set → map; get →
    // Option[V]; has → bool; len → i32. Mirror of
    // asm.fern's x86-64 dispatch.
    if (asmcore.is_map(prim_recv) && (fa.field == "insert") && c.args.len() == 2) {
        var kk_set: string = "0";
        if (asmcore.map_key_is_i32(prim_recv)) { kk_set = "1"; }
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        s = s.write("    ldr x2, [sp], #16\n");   // v
        s = s.write("    ldr x1, [sp], #16\n");   // k
        s = s.write("    ldr x0, [sp], #16\n");   // mapbox
        s = s.write("    mov x3, #" + kk_set + "\n");   // keykind
        // x4 = per-insert flag bits (kconsume / owncols — the IR path's
        // reclaim flags). The AST path never proves key freshness or column
        // ownership, so pass 0 explicitly: the shared __fern_map_set reads
        // x4, and an uninitialised register here would randomly free the
        // overwritten key or the superseded grow buffer.
        s = s.write("    mov x4, #0\n");
        s = s.write("    bl __fern_map_set\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return s;
    }
    // m.without(k) → tuple (map, existed). See
    // the x86-64 mirror in asm.fern for the contract.
    if (asmcore.is_map(prim_recv) && (fa.field == "without") && c.args.len() == 1) {
        var kk_del: string = "0";
        if (asmcore.map_key_is_i32(prim_recv)) { kk_del = "1"; }
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x1, [sp], #16\n");   // k
        s = s.write("    ldr x0, [sp], #16\n");   // mapbox
        s = s.write("    mov x2, #" + kk_del + "\n");   // keykind
        s = s.write("    bl __fern_map_delete\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return s;
    }
    if (asmcore.is_map(prim_recv) && fa.field == "get" && c.args.len() == 1) {
        var kk_get: string = "0";
        if (asmcore.map_key_is_i32(prim_recv)) { kk_get = "1"; }
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x1, [sp], #16\n");   // k
        s = s.write("    ldr x0, [sp], #16\n");   // mapbox
        s = s.write("    mov x2, #" + kk_get + "\n");   // keykind
        s = s.write("    bl __fern_map_get\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return s;
    }
    // m.get_or(k, default) — see asm.fern. Inline as
    // __fern_map_get + Some/None branch on the tag.
    if (asmcore.is_map(prim_recv) && fa.field == "get_or" && c.args.len() == 2) {
        var kk_or: string = "0";
        if (asmcore.map_key_is_i32(prim_recv)) { kk_or = "1"; }
        var or_lbl: i32 = s.label_n;
        s = asmcore.EmitState { ...s, label_n: s.label_n + 2 };
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = emit_expr(c.args[1], s);
        // stack: [default, k, mapbox] (top down).
        s = s.write("    ldr x3, [sp], #16\n");   // default
        s = s.write("    ldr x1, [sp], #16\n");   // k
        s = s.write("    ldr x0, [sp], #16\n");   // mapbox
        s = s.write("    str x3, [sp, #-16]!\n"); // save default
        s = s.write("    mov x2, #" + kk_or + "\n");
        s = s.write("    bl __fern_map_get\n");   // x0 = Option box
        s = s.write("    ldr x3, [sp], #16\n");   // restore default
        s = s.write("    ldr x4, [x0]\n");
        s = s.write("    cbnz x4, .Lgo_def_" + util.i32_to_string(or_lbl) + "\n");
        s = s.write("    ldr x0, [x0, #8]\n");
        s = s.write("    b .Lgo_end_" + util.i32_to_string(or_lbl) + "\n");
        s = s.write(".Lgo_def_" + util.i32_to_string(or_lbl) + ":\n");
        s = s.write("    mov x0, x3\n");
        s = s.write(".Lgo_end_" + util.i32_to_string(or_lbl) + ":\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return s;
    }
    if (asmcore.is_map(prim_recv) && fa.field == "has" && c.args.len() == 1) {
        var kk_has: string = "0";
        if (asmcore.map_key_is_i32(prim_recv)) { kk_has = "1"; }
        s = emit_expr(fa.obj, s);
        s = emit_expr(c.args[0], s);
        s = s.write("    ldr x1, [sp], #16\n");   // k
        s = s.write("    ldr x0, [sp], #16\n");   // mapbox
        s = s.write("    mov x2, #" + kk_has + "\n");   // keykind
        s = s.write("    bl __fern_map_has\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return s;
    }
    if (asmcore.is_map(prim_recv) && fa.field == "len" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    ldr x0, [x0]\n");        // keys arr
        s = s.write("    ldr x0, [x0]\n");        // keys.len
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.mark_heap();
        s = s.mark_str_eq();
        s = s.mark_arr_push();
        return s;
    }
    // m.keys() / m.values() — see asm.fern; the box holds
    // the parallel arrays at offset 0/8.
    if (asmcore.is_map(prim_recv) && fa.field == "keys" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    ldr x0, [x0]\n");        // keys arr
        s = s.write("    str x0, [sp, #-16]!\n");
        return s;
    }
    if (asmcore.is_map(prim_recv) && fa.field == "values" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    ldr x0, [x0, #8]\n");    // values arr
        s = s.write("    str x0, [sp, #-16]!\n");
        return s;
    }
    // Map iteration — mirror of asm.fern. Iterator box
    // [map_ptr @0, cursor @8] over the parallel arrays.
    if (asmcore.is_map(prim_recv) && fa.field == "iter" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);                 // map ptr
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.mark_heap();
        s = s.write("    ldr x1, [sp], #16\n");   // map ptr
        s = s.write("    str x1, [x0]\n");        // map @0
        s = s.write("    mov x1, #0\n");
        s = s.write("    str x1, [x0, #8]\n");    // cursor @8
        s = s.write("    str x0, [sp, #-16]!\n");
        return s;
    }
    if (asmcore.is_mapiter(prim_recv) && fa.field == "has_next" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    ldr x0, [sp], #16\n");   // iter
        s = s.write("    ldr x1, [x0, #8]\n");    // cursor
        s = s.write("    ldr x2, [x0]\n");        // map
        s = s.write("    ldr x2, [x2]\n");        // keys arr
        s = s.write("    ldr x2, [x2]\n");        // keys.len
        s = s.write("    cmp x1, x2\n");
        s = s.write("    cset x0, lt\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        return s;
    }
    if (asmcore.is_mapiter(prim_recv) && fa.field == "key" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    ldr x1, [x0, #8]\n");    // cursor
        s = s.write("    ldr x2, [x0]\n");        // map
        s = s.write("    ldr x2, [x2]\n");        // keys arr
        s = s.write("    add x1, x1, #1\n");
        s = s.write("    ldr x0, [x2, x1, lsl #3]\n");  // keys[cursor+1]
        s = s.write("    str x0, [sp, #-16]!\n");
        return s;
    }
    if (asmcore.is_mapiter(prim_recv) && fa.field == "value" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    ldr x0, [sp], #16\n");
        s = s.write("    ldr x1, [x0, #8]\n");    // cursor
        s = s.write("    ldr x2, [x0]\n");        // map
        s = s.write("    ldr x2, [x2, #8]\n");    // values arr
        s = s.write("    add x1, x1, #1\n");
        s = s.write("    ldr x0, [x2, x1, lsl #3]\n");  // values[cursor+1]
        s = s.write("    str x0, [sp, #-16]!\n");
        return s;
    }
    if (asmcore.is_mapiter(prim_recv) && fa.field == "advance" && c.args.len() == 0) {
        s = emit_expr(fa.obj, s);
        s = s.write("    ldr x0, [sp], #16\n");   // iter
        s = s.write("    ldr x1, [x0, #8]\n");    // cursor
        s = s.write("    add x1, x1, #1\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    str x0, [sp, #-16]!\n"); // dummy result
        return s;
    }
    // Built-in `.to_string()` on i32 and string —
    // i32 routes to the existing runtime helper,
