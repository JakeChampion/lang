    while (efi < s.funcs.len()) {
        var efd: parser.FuncDecl = s.funcs[efi];
        if (enum_recv.len() == 0 && efd.name == fa.field && efd.receiver_type.len() > 0
                && !asmcore.recv_is_array(efd.receiver_type)
                && asmcore.is_enum_recv(util.base_type_name(efd.receiver_type), s)) {
            enum_recv = util.base_type_name(efd.receiver_type);
        }
        efi = efi + 1;
    }
    if (enum_recv.len() > 0) {
        s = s.write("    bl __fn_" + asmcore.sanitize_label(enum_recv + "." + fa.field) + "\n");
        s = s.write("    add sp, sp, #" + util.i32_to_string((c.args.len() + 1) * 16) + "\n");
        s = s.write("    str x0, [sp, #-16]!\n");
        s = s.write(".Lmethod_end_" + util.i32_to_string(m_end_lbl) + ":\n");
        return s;
    }
    s = s.write("    add sp, sp, #" + util.i32_to_string((c.args.len() + 1) * 16) + "\n");
    s = s.write("    mov x0, #-1\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write(".Lmethod_end_" + util.i32_to_string(m_end_lbl) + ":\n");
    return s;
    return s;
}

function emit_call(c: parser.ExprCall, s: asmcore.EmitState): asmcore.EmitState {
    var name: string = "";
    // Inline-lambda call (IIFE), e.g. an if-expression desugar
    // `(function(): T { … })()`. Emit the closure box, push the
    // args above it, then invoke via the closure convention (box
    // ptr in x9, args at +16, +32, …) — same as the local-closure
    // path below, but the box comes from the inline lambda rather
    // than a frame slot.
    match (c.callee) {
        parser.ExprLambda(_) => {
            s = emit_expr(c.callee, s);          // push closure box
            var la: i32 = c.args.len() - 1;
            while (la >= 0) {
                s = emit_expr(c.args[la], s);
                la = la - 1;
            }
            s = s.write("    ldr x9, [sp, #" + util.i32_to_string(c.args.len() * 16) + "]\n"); // box ptr
            s = s.write("    ldr x2, [x9]\n");
            s = s.write("    blr x2\n");
            s = s.write("    add sp, sp, #" + util.i32_to_string((c.args.len() + 1) * 16) + "\n"); // pop args + box
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        _ => {}
    }
    match (c.callee) {
        parser.ExprIdent(id) => { name = id.name; },
        parser.ExprFieldAccess(fa) => {
            // s.p.N() — a fn-valued TUPLE ELEMENT call (numeric field = tuple
            // index), not a method. A method name is never all-digits, so route
            // it to the generic closure-value call instead of emit_method_call,
            // which found no method "N" and returned the -1 sentinel (exit 255).
            // Reading the element (`var g = s.p.N; g()`) already works; this is
            // the direct-call sibling.
            if (util.is_all_digits(fa.field)) {
                s = emit_expr(c.callee, s);          // push closure box
                var tla: i32 = c.args.len() - 1;
                while (tla >= 0) {
                    s = emit_expr(c.args[tla], s);
                    tla = tla - 1;
                }
                s = s.write("    ldr x9, [sp, #" + util.i32_to_string(c.args.len() * 16) + "]\n");
                s = s.write("    ldr x2, [x9]\n");
                s = s.write("    blr x2\n");
                s = s.write("    add sp, sp, #" + util.i32_to_string((c.args.len() + 1) * 16) + "\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            return emit_method_call(c, fa, s);
        },
        _ => {
            // Generic closure-VALUE call: any callee expression that
            // evaluates to a closure box — an array element `arr[i]()`,
            // a tuple element, a call result — not just a bare
            // ident / lambda / method. Evaluate the callee to its box
            // ptr, push args above it, then invoke via the closure
            // convention (box ptr in x9, fn_addr = box[0]). Same shape
            // as the ExprLambda IIFE arm above; the previous `mov x0, #0`
            // stub silently compiled such a call to "return 0".
            s = emit_expr(c.callee, s); // push closure box
            var cla: i32 = c.args.len() - 1;
            while (cla >= 0) {
                s = emit_expr(c.args[cla], s);
                cla = cla - 1;
            }
            s = s.write("    ldr x9, [sp, #" + util.i32_to_string(c.args.len() * 16) + "]\n"); // box ptr (below args)
            s = s.write("    ldr x2, [x9]\n");
            s = s.write("    blr x2\n");
            s = s.write("    add sp, sp, #" + util.i32_to_string((c.args.len() + 1) * 16) + "\n"); // pop args + box
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        }
    }
    // print(str_literal) — builtin lowering to write(1,
    // ptr, len). Compile-time we already know the
    // literal's bytes, so we intern it in `.rodata`,
    // load its address via adrp+add, set the length, and
    // syscall directly.
    // len(arr) — load the length prefix at offset 0.
    // Same semantics as the x86-64 backend.
    var bo: CallOut = try_emit_builtin(c, name, s);
    s = bo.state;
    if (bo.done) { return s; }
    // Closure call: callee ident resolves to a local
    // holding a closure box ptr. See asm.fern for the
    // calling convention rationale.
    if (s.has_local(name)) {
        var ci: i32 = c.args.len() - 1;
        while (ci >= 0) {
            s = emit_expr(c.args[ci], s);
            ci = ci - 1;
        }
        var off: i32 = s.lookup_local(name);
        // Box ptr in x9 (not on the stack) — see asm.fern. Args
        // sit at +16, +32, … just like a direct call.
        s = s.frame_ldr("x9", off);
        s = s.write("    ldr x2, [x9]\n");
        s = s.write("    blr x2\n");
        if (c.args.len() > 0) {
            s = s.write("    add sp, sp, #" + util.i32_to_string(c.args.len() * 16) + "\n");
        }
        s = s.write("    str x0, [sp, #-16]!\n");
        return s;
    }
    var i: i32 = c.args.len() - 1;
    while (i >= 0) {
        var fvn: string = asmcore.arg_fn_value_name(c.args[i], name, i, s);
        if (fvn.len() > 0) { s = emit_fn_value(fvn, s); }
        else { s = emit_expr(c.args[i], s); }
        i = i - 1;
    }
    s = s.write("    bl __fn_" + asmcore.sanitize_label(name) + "\n");
    // Caller cleans up stack args.
    if (c.args.len() > 0) {
        s = s.write("    add sp, sp, #" + util.i32_to_string(c.args.len() * 16) + "\n");
    }
    // Result in x0 — push for the surrounding expr's
    // stack-machine semantics.
    s = s.write("    str x0, [sp, #-16]!\n");
    return s;
    return s;
}

function emit_expr(e: parser.Expr, s: asmcore.EmitState): asmcore.EmitState {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) {
                // Float literal: GAS converts the decimal text to an
                // IEEE-754 double in .rodata; load its bits and push
                // them (floats flow as their 8-byte bit pattern).
                var fl: asmcore.LabelOut = asmcore.fresh_label(s);
                s = fl.state;
                s = s.write("    .section .rodata\n");
                s = s.write(fl.name + ": .double " + n.text + "\n");
                s = s.write("    .text\n");
                s = s.write("    adrp x0, " + fl.name + "\n");
                s = s.write("    add x0, x0, :lo12:" + fl.name + "\n");
                s = s.write("    ldr d0, [x0]\n");
                s = s.write("    fmov x0, d0\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            // `ldr x0, =N` puts N in a literal pool; works for
            // any 64-bit value, including ones that don't fit
            // mov's 16-bit immediate field.
            s = s.write("    ldr x0, =" + n.text + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprBinary(b) => {
            if (b.op == "+") {
                var lt: asmcore.Ty = asmcore.infer_expr_type(b.left, s);
                var rt: asmcore.Ty = asmcore.infer_expr_type(b.right, s);
                if (asmcore.ty_is_string(lt) || asmcore.ty_is_string(rt)) {
                    // __fern_str_concat is a Fern runtime function now (#2649): __fn_
                    // stack convention — a=param[0] at [x29,#16], b=param[1] at
                    // [x29,#32]. Eval lhs then rhs, then re-push so a lands on top.
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    ldr x1, [sp], #16\n");   // rhs (b)
                    s = s.write("    ldr x0, [sp], #16\n");   // lhs (a)
                    s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_concat\n    add sp, sp, #32\n");
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.mark_str_concat();
                    return s;
                }
            }
            if (b.op == "==" || b.op == "!=") {
                var elt: asmcore.Ty = asmcore.infer_expr_type(b.left, s);
                var ert: asmcore.Ty = asmcore.infer_expr_type(b.right, s);
                if (asmcore.ty_is_string(elt) || asmcore.ty_is_string(ert)) {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    ldr x1, [sp], #16\n");
                    s = s.write("    ldr x0, [sp], #16\n");
                    s = s.write("    str x1, [sp, #-16]!\n    str x0, [sp, #-16]!\n    bl __fn___fern_str_eq\n    add sp, sp, #32\n");
                    if (b.op == "!=") {
                        s = s.write("    eor x0, x0, #1\n");
                    }
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.mark_str_eq();
                    return s;
                }
            }
            // String ordering: < / <= / > / >= → __fern_str_cmp
            // and compare its signed result against zero.
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                var olt: asmcore.Ty = asmcore.infer_expr_type(b.left, s);
                var ort: asmcore.Ty = asmcore.infer_expr_type(b.right, s);
                if (asmcore.ty_is_string(olt) || asmcore.ty_is_string(ort)) {
                    // __fern_str_cmp is a Fern runtime function (#2649): call it
                    // via the ordinary __fn_ stack convention. Operand stack has
                    // [left, right] (right on top); re-push so left=a is param[0]
                    // at [x29,#16] and right=b is param[1] at [x29,#32].
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    ldr x1, [sp], #16\n");   // right (b)
                    s = s.write("    ldr x0, [sp], #16\n");   // left (a)
                    s = s.write("    str x1, [sp, #-16]!\n"); // b -> +32
                    s = s.write("    str x0, [sp, #-16]!\n"); // a -> +16 (top)
                    s = s.write("    bl __fn___fern_str_cmp\n");
                    s = s.write("    add sp, sp, #32\n");
                    s = s.write("    cmp x0, #0\n");
                    if (b.op == "<") { s = s.write("    cset x0, lt\n"); }
                    else if (b.op == "<=") { s = s.write("    cset x0, le\n"); }
                    else if (b.op == ">") { s = s.write("    cset x0, gt\n"); }
                    else { s = s.write("    cset x0, ge\n"); }
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.mark_str_cmp();
                    return s;
                }
            }
            // Short-circuit boolean ops. Can't naively
            // emit both sides — the right operand's side
            // effects must not run when the left already
            // decides the result. `&&` short-circuits on
            // false (left == 0 ⇒ result = 0); `||` short-
            // circuits on true (left != 0 ⇒ result = 1).
            // Otherwise the right operand becomes the result.
            if (b.op == "&&" || b.op == "||") {
                s = emit_expr(b.left, s);
                s = s.write("    ldr x0, [sp], #16\n");
                var short_l: asmcore.LabelOut = asmcore.fresh_label(s);
                s = short_l.state;
                var end_l: asmcore.LabelOut = asmcore.fresh_label(s);
                s = end_l.state;
                if (b.op == "&&") {
                    s = s.write("    cbz x0, " + short_l.name + "\n");
                } else {
                    s = s.write("    cbnz x0, " + short_l.name + "\n");
                }
                s = emit_expr(b.right, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    b " + end_l.name + "\n");
                s = s.write(short_l.name + ":\n");
                if (b.op == "&&") {
                    s = s.write("    mov x0, #0\n");
                } else {
                    s = s.write("    mov x0, #1\n");
                }
                s = s.write(end_l.name + ":\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            // Float (f64) arithmetic + comparison. Operands flow as
            // 8-byte bit patterns; fmov into d-regs and operate.
            var is_flt: boolean = asmcore.ty_is_f64(asmcore.infer_expr_type(b.left, s)) || asmcore.ty_is_f64(asmcore.infer_expr_type(b.right, s));
            if (is_flt && (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/")) {
                s = emit_expr(b.left, s);
                s = emit_expr(b.right, s);
                s = s.write("    ldr x0, [sp], #16\n");   // rhs
                s = s.write("    ldr x1, [sp], #16\n");   // lhs
                s = s.write("    fmov d0, x0\n");
                s = s.write("    fmov d1, x1\n");
                if (b.op == "+") { s = s.write("    fadd d0, d1, d0\n"); }
                else if (b.op == "-") { s = s.write("    fsub d0, d1, d0\n"); }
                else if (b.op == "*") { s = s.write("    fmul d0, d1, d0\n"); }
                else { s = s.write("    fdiv d0, d1, d0\n"); }
                s = s.write("    fmov x0, d0\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            if (is_flt && (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "==" || b.op == "!=")) {
                s = emit_expr(b.left, s);
                s = emit_expr(b.right, s);
                s = s.write("    ldr x0, [sp], #16\n");   // rhs
                s = s.write("    ldr x1, [sp], #16\n");   // lhs
                s = s.write("    fmov d0, x0\n");
                s = s.write("    fmov d1, x1\n");
                s = s.write("    fcmp d1, d0\n");          // lhs vs rhs
                if (b.op == "<") { s = s.write("    cset w0, mi\n"); }
                else if (b.op == "<=") { s = s.write("    cset w0, ls\n"); }
                else if (b.op == ">") { s = s.write("    cset w0, gt\n"); }
                else if (b.op == ">=") { s = s.write("    cset w0, ge\n"); }
                else if (b.op == "==") { s = s.write("    cset w0, eq\n"); }
                else { s = s.write("    cset w0, ne\n"); }
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = emit_expr(b.left, s);
            s = emit_expr(b.right, s);
            s = s.write("    ldr x1, [sp], #16\n");   // rhs
            s = s.write("    ldr x0, [sp], #16\n");   // lhs
            if (b.op == "+") {
                s = s.write("    add x0, x0, x1\n");
            } else if (b.op == "-") {
                s = s.write("    sub x0, x0, x1\n");
            } else if (b.op == "*") {
                s = s.write("    mul x0, x0, x1\n");
            } else if (b.op == "/") {
                // UNSIGNED operands (u32/u64/usize) divide with udiv, not the
                // signed sdiv — else a u64 value with bit 63 set (e.g. umax()
                // = (0 as u64) - (1 as u64)) divides as a negative i64 and
                // 18446744073709551615 / 10 yields 0 instead of the unsigned
                // quotient (the `# std/u64 to_string umax` printed "/" =
                // '0' + (-1 % 10)). Mirrors x86 asm.fern's emit_divmod and the
                // arm64 IR path's ir_bin_asm (div_u tag 25). The signed path is
                // unchanged. This only fires when a program routes the AST
                // backend (over the IR budget) — the IR path already did udiv.
                if (asmcore.is_unsigned_tag(asmcore.infer_expr_type(b.left, s))
                        || asmcore.is_unsigned_tag(asmcore.infer_expr_type(b.right, s))) {
                    s = s.write("    udiv x0, x0, x1\n");
                } else {
                    s = s.write("    sdiv x0, x0, x1\n");
                }
            } else if (b.op == "%") {
                // ARM64 has no native modulo. Compute via
                // remainder = lhs - (lhs/rhs)*rhs.
                // msub x_d, x_n, x_m, x_a → x_d = x_a - x_n*x_m
                // Unsigned operands take udiv (see `/` above); the msub is
                // sign-agnostic (it recomputes lhs - q*rhs).
                if (asmcore.is_unsigned_tag(asmcore.infer_expr_type(b.left, s))
                        || asmcore.is_unsigned_tag(asmcore.infer_expr_type(b.right, s))) {
                    s = s.write("    udiv x2, x0, x1\n");
                } else {
                    s = s.write("    sdiv x2, x0, x1\n");
                }
                s = s.write("    msub x0, x2, x1, x0\n");
            } else if (b.op == "&") {
                s = s.write("    and x0, x0, x1\n");
            } else if (b.op == "|") {
                s = s.write("    orr x0, x0, x1\n");
            } else if (b.op == "^") {
                s = s.write("    eor x0, x0, x1\n");
            } else if (b.op == "<<") {
                s = s.write("    lsl x0, x0, x1\n");
            } else if (b.op == ">>") {
                // Arithmetic (signed) shift right — Fern i32 is signed.
                s = s.write("    asr x0, x0, x1\n");
            } else if (b.op == "<" || b.op == "<=" || b.op == ">"
                    || b.op == ">=" || b.op == "==" || b.op == "!=") {
                // Comparison: `cmp lhs, rhs` sets the condition
                // flags; `cset` materialises the bool (0/1) into
                // x0 based on the chosen cc.
                // Pick signed vs unsigned cset codes from the operand
                // tags — `u32` / `u64` / `usize` use lo / ls / hi / hs
                // so values near u64::MAX sort/compare in the expected
                // order (signed lt would treat them as negative).
                var is_unsigned: boolean = asmcore.is_unsigned_tag(asmcore.infer_expr_type(b.left, s))
                    || asmcore.is_unsigned_tag(asmcore.infer_expr_type(b.right, s));
                s = s.write("    cmp x0, x1\n");
                var cc: string = "";
                if (b.op == "<") { if (is_unsigned) { cc = "lo"; } else { cc = "lt"; } }
                else if (b.op == "<=") { if (is_unsigned) { cc = "ls"; } else { cc = "le"; } }
                else if (b.op == ">") { if (is_unsigned) { cc = "hi"; } else { cc = "gt"; } }
                else if (b.op == ">=") { if (is_unsigned) { cc = "hs"; } else { cc = "ge"; } }
                else if (b.op == "==") { cc = "eq"; }
                else { cc = "ne"; }
                s = s.write("    cset x0, " + cc + "\n");
            } else {
                s = s.write("    // unsupported binop: " + b.op + "\n");
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprUnary(u) => {
            // `expr?` try operator — see asm.fern.
            if (u.op == "try_") {
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");   // option/result box
                s = s.write("    ldr x1, [x0]\n");        // tag (0 = Some/Ok)
                var tlbl: asmcore.LabelOut = asmcore.fresh_label(s);
                s = tlbl.state;
                s = s.write("    cbz x1, " + tlbl.name + "\n");
                // None/Err: return the box (already in x0) from the fn.
                s = s.write("    mov sp, x29\n");
                s = s.write("    ldp x29, x30, [sp], #16\n");
                s = s.write("    ret\n");
                s = s.write(tlbl.name + ":\n");
                s = s.write("    ldr x0, [x0, #8]\n");     // payload
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            if (u.op == "-") {
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");
                if (asmcore.ty_is_f64(asmcore.infer_expr_type(u.operand, s))) {
                    s = s.write("    fmov d0, x0\n");
                    s = s.write("    fneg d0, d0\n");
                    s = s.write("    fmov x0, d0\n");
                } else {
                    s = s.write("    neg x0, x0\n");
                }
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            if (u.op == "!") {
                // Boolean negation. Operand is in the
                // `{0, 1}` normal form maintained by every
                // bool-producing path (literal, comparison,
                // short-circuit, str_*), so XOR with 1 flips
                // it without needing to widen first.
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    eor x0, x0, #1\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            // `expr as Type` casts (parser desugars to unary `as_<Type>`).
            // Integer widths are 64-bit slots; mask (unsigned) or
            // sign-extend (signed) to the target width; i64/u64/usize
            // and anything else are no-ops.
            if (u.op.len() >= 3 && u.op[0:3] == "as_") {
                var ty: str = u.op[3:u.op.len()];
                var src_ty: asmcore.Ty = asmcore.infer_expr_type(u.operand, s);
                var to_float: boolean = ty == "f64" || ty == "f32" || ty == "float";
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");
                if (to_float) {
                    // → float. From int: scvtf. From float: no-op.
                    if (!asmcore.ty_is_f64(src_ty)) {
                        s = s.write("    scvtf d0, x0\n");
                        s = s.write("    fmov x0, d0\n");
                    }
                } else if (asmcore.ty_is_f64(src_ty)) {
                    // float → int: truncate toward zero, then width-mask.
                    s = s.write("    fmov d0, x0\n");
                    s = s.write("    fcvtzs x0, d0\n");
                    if (ty == "u8") { s = s.write("    uxtb w0, w0\n"); }
                } else {
                    if (ty == "u8") { s = s.write("    uxtb w0, w0\n"); }
                    else if (ty == "u32") { s = s.write("    mov w0, w0\n"); }
                    else if (ty == "i32") { s = s.write("    sxtw x0, w0\n"); }
                }
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = s.write("    // unsupported unary: " + u.op + "\n");
            return s;
        },
        parser.ExprBool(b) => {
            // Bool literal — 1 for true, 0 for false on the
            // rt-stack so it can flow through comparison-style
            // consumers (e.g. an if cond branching on `true`).
            var v: i32 = 0;
            if (b.value) { v = 1; }
            s = s.write("    mov x0, #" + util.i32_to_string(v) + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprIdent(id) => {
            if (s.has_local(id.name)) {
                var off: i32 = s.lookup_local(id.name);
                s = s.frame_ldr("x0", off);
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            // Built-in `None` — empty Option. Heap box [tag=1 @0].
            // See the Some(x) constructor + StmtMatch Some/None arms.
            if (id.name == "None") {
                s = s.write("    mov x0, #16\n");
                s = s.write("    bl __fern_alloc\n");
                s = s.mark_heap();
                s = s.write("    mov x1, #1\n");
                s = s.write("    str x1, [x0]\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            // A bare ident naming a zero-arg, receiver-less function
            // (a `const`) lowers to a call to that function.
            var cfi: i32 = 0;
            while (cfi < s.funcs.len()) {
                if (s.funcs[cfi].name == id.name && s.funcs[cfi].receiver_type.len() == 0 && s.funcs[cfi].params.len() == 0) {
                    s = s.write("    bl __fn_" + asmcore.sanitize_label(id.name) + "\n");
                    s = s.write("    str x0, [sp, #-16]!\n");
                    return s;
                }
                cfi = cfi + 1;
            }
            // A bare ident naming a receiver-less function WITH params
            // is a function value (higher-order use). Represent it as a
            // 1-slot closure box [&__fn_name] so it flows through the
            // closure-call path. The box-in-x9 convention means the
            // plain function ignores the box and reads params at +16. See asm.fern.
            var fvi: i32 = 0;
            while (fvi < s.funcs.len()) {
                if (s.funcs[fvi].name == id.name && s.funcs[fvi].receiver_type.len() == 0 && s.funcs[fvi].params.len() > 0) {
                    return emit_fn_value(id.name, s);
                }
                fvi = fvi + 1;
            }
            // Bare ident naming a zero-field struct: no-payload enum
            // variant (`JNull`). Construct [shape_ptr]. See asm.fern.
            if (asmcore.is_unit_variant(id.name, s)) {
                s = s.write("    mov x0, #8\n");
                s = s.write("    bl __fern_alloc\n");
                s = s.mark_heap();
                var uvLit: asmcore.StringLitOut = asmcore.add_string_lit(s, id.name);
                s = uvLit.state;
                s = s.write("    adrp x1, " + asm_ir.str_lit_label(s, uvLit.idx) + "\n");
                s = s.write("    add x1, x1, :lo12:" + asm_ir.str_lit_label(s, uvLit.idx) + "\n");
                s = s.write("    str x1, [x0]\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = s.write("    // unresolved ident: " + id.name + "\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprString(sv) => {
            // String literal: intern bytes in .rodata, build an rc-headered box via
            // __fern_str_box (#2649 Option A A1b) — data = .rodata label, len = byte
            // count. box = [rc=1][data][len]; data@box+0 / len@box+8 unchanged (so the
            // string runtime helpers are unaffected), rc header keeps the layout
            // consistent with the IR path across a merged legacy/IR bundle.
            var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, sv.value);
            s = lo.state;
            s = s.mark_heap();
            s = s.write("    adrp x0, " + asm_ir.str_lit_label(s, lo.idx) + "\n");
            s = s.write("    add x0, x0, :lo12:" + asm_ir.str_lit_label(s, lo.idx) + "\n");
            s = s.write("    mov x1, #" + util.i32_to_string(sv.value.len()) + "\n");
            s = s.write("    bl __fern_str_box\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprCall(c) => {
            return emit_call(c, s);
        },
        parser.ExprTuple(t) => {
            // Layout: [val0, val1, …, val_(N-1)] — no shape
            // pointer, same as the x86-64 backend; tuple field
            // access uses numeric `.0` / `.1` / … spellings and
            // resolves to a direct offset at the access site.
            var n_elems: i32 = t.elements.len();
            var ti: i32 = 0;
            while (ti < n_elems) {
                s = emit_expr(t.elements[ti], s);
                ti = ti + 1;
            }
            var t_bytes: i32 = n_elems * 8;
            if (n_elems == 0) { t_bytes = 8; }
            s = s.write("    mov x0, #" + util.i32_to_string(t_bytes) + "\n");
            s = s.write("    bl __fern_alloc\n");
            s = s.mark_heap();
            var tj: i32 = n_elems - 1;
            while (tj >= 0) {
                s = s.write("    ldr x1, [sp], #16\n");
                if (asmcore.needs_rc_inc_on_alias(t.elements[tj], s)) {
                    s = s.mark_heap();
                    s = s.write("    str x0, [sp, #-16]!\n");   // save tuple ptr
                    s = s.write("    str x1, [sp, #-16]!\n");   // retain arg = element
                    s = s.write("    bl __fn___fern_rc_inc\n");
                    s = s.write("    mov x1, x0\n");            // element (helper returns the ptr)
                    s = s.write("    add sp, sp, #16\n");
                    s = s.write("    ldr x0, [sp], #16\n");     // restore tuple ptr
                }
                s = s.write("    str x1, [x0, #" + util.i32_to_string(tj * 8) + "]\n");
                tj = tj - 1;
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprArray(a) => {
            // Layout: [len: 8 bytes, val0, val1, …, val_(N-1)].
            // Same shape as the x86-64 backend; see asm.fern
            // for the rationale.
            var n_elems: i32 = a.elements.len();
            var ai: i32 = 0;
            while (ai < n_elems) {
                s = emit_expr(a.elements[ai], s);
                ai = ai + 1;
            }
            // Allocate via __fern_arr_box (rc-header layout): the data
            // ptr reads as the classic [len@0, e_i@(i+1)*8] while rc is
            // at -8 and cap at -16. cap = len for a literal (first push
            // reallocs, then doubles).
            s = s.write("    mov x0, #" + util.i32_to_string(n_elems) + "\n");   // cap = element count
            s = s.write("    bl __fern_arr_box\n");   // -> data ptr in x0 (cap + len written)
            s = s.mark_heap();
            var aj: i32 = n_elems - 1;
            while (aj >= 0) {
                s = s.write("    ldr x1, [sp], #16\n");
                if (asmcore.needs_rc_inc_on_alias(a.elements[aj], s)) {
                    s = s.mark_heap();
                    s = s.write("    str x0, [sp, #-16]!\n");   // save array ptr
                    s = s.write("    str x1, [sp, #-16]!\n");   // retain arg = element
                    s = s.write("    bl __fn___fern_rc_inc\n");
                    s = s.write("    mov x1, x0\n");            // element (helper returns the ptr)
                    s = s.write("    add sp, sp, #16\n");
                    s = s.write("    ldr x0, [sp], #16\n");     // restore array ptr
                }
                s = s.write("    str x1, [x0, #" + util.i32_to_string((aj + 1) * 8) + "]\n");
                aj = aj - 1;
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprIndex(x) => {
            // Dispatch on container type: string → byte load
            // at box.data + i; array → 8-byte slot at +(i+1)*8.
            var ct: asmcore.Ty = asmcore.infer_expr_type(x.array, s);
            s = emit_expr(x.array, s);
            s = emit_expr(x.index, s);
            s = s.write("    ldr x1, [sp], #16\n");
            s = s.write("    ldr x0, [sp], #16\n");
            if (asmcore.ty_is_string(ct)) {
                s = s.write("    ldr x0, [x0]\n");
                s = s.write("    ldrb w0, [x0, x1]\n");
            } else {
                s = s.write("    add x1, x1, #1\n");
                s = s.write("    ldr x0, [x0, x1, lsl #3]\n");
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprSlice(sl) => {
            // String slice: allocate new 16-byte box with
            // data_ptr = src.data_ptr + start, len = end-start.
            var st: asmcore.Ty = asmcore.infer_expr_type(sl.array, s);
            if (asmcore.ty_is_string(st)) {
                s = emit_expr(sl.array, s);
                s = emit_expr(sl.start, s);
                s = emit_expr(sl.end, s);
                s = s.write("    ldr x3, [sp], #16\n");   // end
                s = s.write("    ldr x4, [sp], #16\n");   // start
                s = s.write("    ldr x5, [sp], #16\n");   // src box
                // Save end/start/src across __fern_alloc call.
                // x19, x20, x21 are callee-saved AAPCS regs.
                s = s.write("    stp x19, x20, [sp, #-16]!\n");
                s = s.write("    str x21, [sp, #-16]!\n");
                s = s.write("    mov x19, x3\n");
                s = s.write("    mov x20, x4\n");
                s = s.write("    mov x21, x5\n");
                s = s.write("    mov x0, #16\n");
                s = s.write("    bl __fern_alloc\n");
                s = s.mark_heap();
                // box.data_ptr = src.data_ptr + start.
                s = s.write("    ldr x1, [x21]\n");
                s = s.write("    add x1, x1, x20\n");
                s = s.write("    str x1, [x0]\n");
                // box.len = end - start.
                s = s.write("    sub x1, x19, x20\n");
                s = s.write("    str x1, [x0, #8]\n");
                s = s.write("    ldr x21, [sp], #16\n");
                s = s.write("    ldp x19, x20, [sp], #16\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            if (asmcore.is_int_array_tag(st) || asmcore.ty_is_array_string(st) || asmcore.ty_is_array(st)) {
                s = emit_expr(sl.array, s);
                s = emit_expr(sl.start, s);
                s = emit_expr(sl.end, s);
                s = s.write("    ldr x2, [sp], #16\n");   // end
                s = s.write("    ldr x1, [sp], #16\n");   // start
                s = s.write("    ldr x0, [sp], #16\n");   // src arr
                s = s.write("    bl __fern_arr_slice\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                s = s.mark_arr_slice();
                return s;
            }
            s = s.write("    // unsupported: slice on non-string\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprStructLit(sl) => {
            // Layout: [shape_ptr, val0, val1, …, val_(N-1)].
            // Same shape as the x86-64 backend; see asm.fern
            // for the rationale.
            //
            // Struct-update `Name { ...base, f: v }`: one slot per
            // DECLARED field (decl order); un-overridden slots copy
            // from the base, the rest are overrides. Leak-everything
            // heap → no rc bookkeeping on copies (mirrors asm.fern).
            if (sl.has_base) {
                var dn: i32 = 0;
                var fields: parser.StructFieldDecl[] = [];
                var ddi: i32 = 0;
                while (ddi < s.struct_decls.len()) {
                    if (s.struct_decls[ddi].name == sl.type_name) {
                        fields = s.struct_decls[ddi].fields;
                        dn = fields.len();
                    }
                    ddi = ddi + 1;
                }
                // Evaluate the base (its pointer lands on the rt-stack).
                s = emit_expr(sl.base, s);
                // Allocate the new box. Base ptr stays on the rt-stack
                // across the call (alloc clobbers scratch regs).
                var su_bytes: i32 = (dn + 1) * 8;
                s = s.write("    mov x0, #" + util.i32_to_string(su_bytes) + "\n");
                s = s.write("    bl __fern_alloc\n");
                s = s.mark_heap();
                // x0 = box. Shape pointer at [x0].
                var suNameLit: asmcore.StringLitOut = asmcore.add_string_lit(s, sl.type_name);
                s = suNameLit.state;
                s = s.write("    adrp x1, " + asm_ir.str_lit_label(s, suNameLit.idx) + "\n");
                s = s.write("    add x1, x1, :lo12:" + asm_ir.str_lit_label(s, suNameLit.idx) + "\n");
                s = s.write("    str x1, [x0]\n");
                // Pop the base pointer into x2. The copy loop may call
                // __fern_rc_inc to retain array fields; x2 (base) and x0
                // (box) are saved/restored across any such call.
                s = s.write("    ldr x2, [sp], #16\n");
                var ci: i32 = 0;
                while (ci < dn) {
                    var cname: string = fields[ci].name;
                    var overridden: boolean = false;
                    var oj: i32 = 0;
                    while (oj < sl.field_names.len()) {
                        if (sl.field_names[oj] == cname) { overridden = true; }
                        oj = oj + 1;
                    }
                    if (!overridden) {
                        s = s.write("    ldr x1, [x2, #" + util.i32_to_string((ci + 1) * 8) + "]\n");
                        // Perceus construction inc: retain the base's array
                        // field the new struct now references (base x2 +
                        // box x0 preserved across the call).
                        if (asmcore.ty_is_array_like(asmcore.ty_from_name(fields[ci].type_name))) {
                            s = s.mark_heap();
                            s = s.write("    str x2, [sp, #-16]!\n");   // save base
                            s = s.write("    str x0, [sp, #-16]!\n");   // save box
                            s = s.write("    str x1, [sp, #-16]!\n");   // retain arg
                            s = s.write("    bl __fn___fern_rc_inc\n");
                            s = s.write("    mov x1, x0\n");            // value (helper returns ptr)
                            s = s.write("    add sp, sp, #16\n");
                            s = s.write("    ldr x0, [sp], #16\n");     // restore box
                            s = s.write("    ldr x2, [sp], #16\n");     // restore base
                        }
                        s = s.write("    str x1, [x0, #" + util.i32_to_string((ci + 1) * 8) + "]\n");
                    }
                    ci = ci + 1;
                }
                // Save the box pointer on the rt-stack; override value
                // exprs below may use both registers and the stack.
                s = s.write("    str x0, [sp, #-16]!\n");
                var ok: i32 = 0;
                while (ok < sl.field_names.len()) {
                    var oidx: i32 = 0;
                    var of2: i32 = 0;
                    while (of2 < dn) {
                        if (fields[of2].name == sl.field_names[ok]) { oidx = of2; }
                        of2 = of2 + 1;
                    }
                    var ov_inc: boolean = asmcore.needs_rc_inc_on_alias(sl.field_values[ok], s);
                    s = emit_expr(sl.field_values[ok], s);   // rt: [box, val]
                    s = s.write("    ldr x1, [sp], #16\n");   // val → x1
                    s = s.write("    ldr x0, [sp], #16\n");   // box → x0
                    if (ov_inc) {
                        s = s.mark_heap();
                        s = s.write("    str x0, [sp, #-16]!\n");   // save box
                        s = s.write("    str x1, [sp, #-16]!\n");   // retain arg = override value
                        s = s.write("    bl __fn___fern_rc_inc\n");
                        s = s.write("    mov x1, x0\n");            // value (helper returns ptr)
                        s = s.write("    add sp, sp, #16\n");
                        s = s.write("    ldr x0, [sp], #16\n");     // restore box
                    }
                    s = s.write("    str x1, [x0, #" + util.i32_to_string((oidx + 1) * 8) + "]\n");
                    s = s.write("    str x0, [sp, #-16]!\n"); // box back on rt-stack
                    ok = ok + 1;
                }
                return s;
            }
            var n_fields: i32 = sl.field_values.len();
            // Field-slot mapping (#4554, mirrors asm.fern): values are
            // EVALUATED in literal order but STORED at their field's
            // DECLARATION-order slot — the offset ExprFieldAccess reads back
            // at. Positional stores silently scrambled every field of a
            // literal written out of decl order. slot_of[j] = decl index of
            // literal field j, falling back to j when the decl is unknown or
            // a name doesn't resolve.
            var lit_fields: parser.StructFieldDecl[] = [];
            var lfi: i32 = 0;
            while (lfi < s.struct_decls.len()) {
                if (s.struct_decls[lfi].name == sl.type_name) { lit_fields = s.struct_decls[lfi].fields; }
                lfi = lfi + 1;
            }
            // Allocation-free fast path: virtually every literal already lists
            // its fields in decl order, and this emitter runs on the
            // leak-everything bump heap — building a slot_of array per literal
            // across a whole self-compile is real heap pressure (the arm64
            // stage-2 self-compile sits near its arena limit, #3425). Only
            // build the mapping when a name is actually out of place.
            var lit_in_order: boolean = true;
            var oc: i32 = 0;
            while (oc < n_fields) {
                if (lit_fields.len() > 0 && oc < sl.field_names.len() && oc < lit_fields.len()) {
                    if (lit_fields[oc].name != sl.field_names[oc]) { lit_in_order = false; }
                }
                oc = oc + 1;
            }
            var slot_of: i32[] = [];
            if (!lit_in_order) {
                var so: i32 = 0;
                while (so < n_fields) {
                    var so_idx: i32 = so;
                    if (lit_fields.len() > 0 && so < sl.field_names.len()) {
                        var sd: i32 = 0;
                        while (sd < lit_fields.len()) {
                            if (lit_fields[sd].name == sl.field_names[so]) { so_idx = sd; }
                            sd = sd + 1;
                        }
                    }
                    slot_of = slot_of.append(so_idx);
                    so = so + 1;
                }
            }
            var i: i32 = 0;
            while (i < n_fields) {
                s = emit_expr(sl.field_values[i], s);
                i = i + 1;
            }
            // Box size: the DECLARED field count when the decl is known
            // (the layout truth), else the literal count.
            var box_fields: i32 = n_fields;
            if (lit_fields.len() > 0) { box_fields = lit_fields.len(); }
            var slot_bytes: i32 = (box_fields + 1) * 8;
            s = s.write("    mov x0, #" + util.i32_to_string(slot_bytes) + "\n");
            s = s.write("    bl __fern_alloc\n");
            s = s.mark_heap();
            // x0 now holds the struct pointer.
            var nameLit: asmcore.StringLitOut = asmcore.add_string_lit(s, sl.type_name);
            s = nameLit.state;
            s = s.write("    adrp x1, " + asm_ir.str_lit_label(s, nameLit.idx) + "\n");
            s = s.write("    add x1, x1, :lo12:" + asm_ir.str_lit_label(s, nameLit.idx) + "\n");
            s = s.write("    str x1, [x0]\n");
            // Pop field values into [x0 + (j+1)*8]. Perceus construction
            // inc (Phase 1d): a field initialised from an rc-tracked
            // array alias is retained (the struct now owns a reference;
            // prevents a use-after-free once free is on). x0 (box ptr)
            // must survive the retain call.
            var j: i32 = n_fields - 1;
            while (j >= 0) {
                s = s.write("    ldr x1, [sp], #16\n");
                if (asmcore.needs_rc_inc_on_alias(sl.field_values[j], s)) {
                    s = s.mark_heap();
                    s = s.write("    str x0, [sp, #-16]!\n");   // save box ptr
                    s = s.write("    str x1, [sp, #-16]!\n");   // retain arg = field value
                    s = s.write("    bl __fn___fern_rc_inc\n");
                    s = s.write("    mov x1, x0\n");            // value (helper returns the ptr)
                    s = s.write("    add sp, sp, #16\n");       // pop retain arg
                    s = s.write("    ldr x0, [sp], #16\n");     // restore box ptr
                }
                var st_idx: i32 = j;
                if (!lit_in_order) { st_idx = slot_of[j]; }
                s = s.write("    str x1, [x0, #" + util.i32_to_string((st_idx + 1) * 8) + "]\n");
                j = j - 1;
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprFieldAccess(fa) => {
            // Numeric field name → tuple access (offset idx*8,
            // no shape dispatch). See asm.fern for rationale.
            if (util.is_all_digits(fa.field)) {
                var tup_idx: i32 = util.digits_to_i32(fa.field);
                s = emit_expr(fa.obj, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    ldr x0, [x0, #" + util.i32_to_string(tup_idx * 8) + "]\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = emit_expr(fa.obj, s);
            s = s.write("    ldr x0, [sp], #16\n");
            var end_lbl: i32 = s.label_n;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
            var di: i32 = 0;
            while (di < s.struct_decls.len()) {
                var sd: parser.StructDecl = s.struct_decls[di];
                var fi: i32 = 0;
                var found_idx: i32 = 0 - 1;
                while (fi < sd.fields.len()) {
                    if (sd.fields[fi].name == fa.field) { found_idx = fi; }
                    fi = fi + 1;
                }
                if (found_idx >= 0) {
                    var arm_lit: asmcore.StringLitOut = asmcore.add_string_lit(s, sd.name);
                    s = arm_lit.state;
                    s = s.write("    ldr x1, [x0]\n");
                    s = s.write("    adrp x2, " + asm_ir.str_lit_label(s, arm_lit.idx) + "\n");
                    s = s.write("    add x2, x2, :lo12:" + asm_ir.str_lit_label(s, arm_lit.idx) + "\n");
                    s = s.write("    cmp x1, x2\n");
                    s = s.write("    b.ne .Lfa_next_" + util.i32_to_string(s.label_n) + "\n");
                    s = s.write("    ldr x0, [x0, #" + util.i32_to_string((found_idx + 1) * 8) + "]\n");
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.write("    b .Lfa_end_" + util.i32_to_string(end_lbl) + "\n");
                    s = s.write(".Lfa_next_" + util.i32_to_string(s.label_n) + ":\n");
                    s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
                }
                di = di + 1;
            }
            s = s.write("    mov x0, #-1\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write(".Lfa_end_" + util.i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.ExprLambda(lm) => {
            // Always-box lowering mirror of asm.fern. The box
            // layout is [fn_addr, cap0, cap1, …] and the call
            // convention puts the box at the lowest positive
            // offset above the saved fp (callee sees it at
            // +16(x29), then args at +32, +48, …).
            var caps: string[] = asmcore.lambda_captures(lm, s);
            var n_caps: i32 = caps.len();
            var lam_id: i32 = s.label_n;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 2 };
            var skip_lbl: string = ".Lskip_lambda_" + util.i32_to_string(lam_id);
            var body_lbl: string = ".Llambda_" + util.i32_to_string(lam_id);
            s = s.write("    b " + skip_lbl + "\n");
            s = s.write(body_lbl + ":\n");
            s = s.write("    stp x29, x30, [sp, #-16]!\n");
            s = s.write("    mov x29, sp\n");
            var saved_locals: string[] = s.local_names;
            var saved_local_types: asmcore.Ty[] = s.local_types;
            var saved_in_function: boolean = s.in_function;
            var argc_l: i32 = lm.params.len();
            var n_body_locals_l: i32 = asmcore.count_locals(lm.body);
            var total_locals_l: i32 = 1 + n_caps + argc_l + n_body_locals_l;
            if (total_locals_l > 0) {
                var bytes_l: i32 = total_locals_l * 8;
                if (bytes_l % 16 != 0) { bytes_l = bytes_l + 8; }
                s = s.write("    sub sp, sp, #" + util.i32_to_string(bytes_l) + "\n");
            }
            s = s.reset_locals();
            s = s.enter_function();
            // Bind __closure_box (slot 0), stash from x9 (the box ptr
            // the call site placed in that register).
            var box_name: string = "__closure_box";
            s = s.bind_local(box_name);
            var box_off: i32 = s.lookup_local(box_name);
            s = s.frame_str("x9", box_off);
            // Bind each capture, load from box[+(i+1)*8]. The
            // capture preserves the outer scope's type so that
            // type-aware dispatch inside the lambda body (e.g.
            // `len(s)` resolving to the string-len helper, or
            // `a + b` routing through `__fern_str_concat`)
            // sees the right thing — without this the captured
            // local lands here as `"unknown"` and falls through
            // to the i32 path.
            var ci: i32 = 0;
            while (ci < n_caps) {
                var cap_ty: asmcore.Ty = asmcore.ty_unknown();
                var li: i32 = 0;
                while (li < saved_locals.len()) {
                    if (saved_locals[li] == caps[ci]) {
                        cap_ty = saved_local_types[li];
                        li = saved_locals.len();
                    } else {
                        li = li + 1;
                    }
                }
                s = s.bind_local_typed(caps[ci], cap_ty);
                var c_off: i32 = s.lookup_local(caps[ci]);
                s = s.frame_ldr("x1", box_off);
                s = s.write("    ldr x0, [x1, #" + util.i32_to_string((ci + 1) * 8) + "]\n");
                s = s.frame_str("x0", c_off);
                ci = ci + 1;
            }
            // Bind params; args at +16, +32, … — IDENTICAL to a direct
            // call, because the box now arrives in x9, not on the stack.
            var pi2: i32 = 0;
            while (pi2 < argc_l) {
                s = s.bind_local_typed(lm.params[pi2].name, asmcore.ty_from_name(lm.params[pi2].type_name));
                var p_off: i32 = s.lookup_local(lm.params[pi2].name);
                var a_off: i32 = 16 + pi2 * 16;
                s = s.frame_ldr("x0", a_off);
                s = s.frame_str("x0", p_off);
                pi2 = pi2 + 1;
            }
            var bi_l: i32 = 0;
            while (bi_l < lm.body.len()) {
                s = emit_stmt(lm.body[bi_l], s);
                bi_l = bi_l + 1;
            }
            // Fallback implicit return 0.
            s = s.write("    mov x0, #0\n");
            s = s.write("    mov sp, x29\n");
            s = s.write("    ldp x29, x30, [sp], #16\n");
            s = s.write("    ret\n");
            s = asmcore.EmitState { ...s, local_names: saved_locals, in_function: saved_in_function, local_types: saved_local_types };
            s = s.write(skip_lbl + ":\n");
            // Allocate box: (1 + n_caps) * 8 bytes.
            var box_bytes: i32 = (1 + n_caps) * 8;
            s = s.write("    mov x0, #" + util.i32_to_string(box_bytes) + "\n");
            s = s.write("    bl __fern_alloc\n");
            s = s.mark_heap();
            // Store fn_addr at box[0].
            s = s.write("    adrp x1, " + body_lbl + "\n");
            s = s.write("    add x1, x1, :lo12:" + body_lbl + "\n");
            s = s.write("    str x1, [x0]\n");
            // Store captures. Perceus construction inc: a captured
            // rc-tracked array is retained (the closure box owns it) —
            // box ptr (x0) preserved across the retain call.
            var oi: i32 = 0;
            while (oi < n_caps) {
                var outer_off: i32 = s.lookup_local(caps[oi]);
                s = s.frame_ldr("x1", outer_off);
                if (asmcore.ty_is_array_like(s.local_type_of(caps[oi]))) {
                    s = s.mark_heap();
                    s = s.write("    str x0, [sp, #-16]!\n");   // save box ptr
                    s = s.write("    str x1, [sp, #-16]!\n");   // retain arg = capture
                    s = s.write("    bl __fn___fern_rc_inc\n");
                    s = s.write("    mov x1, x0\n");            // value (helper returns ptr)
                    s = s.write("    add sp, sp, #16\n");
                    s = s.write("    ldr x0, [sp], #16\n");     // restore box ptr
                }
                s = s.write("    str x1, [x0, #" + util.i32_to_string((oi + 1) * 8) + "]\n");
                oi = oi + 1;
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprUnknown(_) => {
            s = s.write("    // parser-side unknown\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        }
    }
    return s;
}

function emit_block(body: parser.Stmt[], s: asmcore.EmitState): asmcore.EmitState {
    var i: i32 = 0;
    while (i < body.len()) {
        s = emit_stmt(body[i], s);
        i = i + 1;
    }
    return s;
}

// emit_map_kv_for — see asm.fern. `for (k, v) in m`, separate function
// so the StmtFor arm stays small.
function emit_map_kv_for(s: asmcore.EmitState, f: parser.StmtFor, kv_comma: i32): asmcore.EmitState {
    var iter_ty: asmcore.Ty = asmcore.infer_expr_type(f.iter, s);
    var kvk: str = f.var_name[0 : kv_comma];
    var kvv: str = f.var_name[kv_comma + 1 : f.var_name.len()];
    var kvk_ty: asmcore.Ty = asmcore.ty_string();
    if (asmcore.map_key_is_i32(iter_ty)) { kvk_ty = asmcore.ty_i32(); }
    var kvv_ty: asmcore.Ty = asmcore.map_val(iter_ty);
    s = emit_expr(f.iter, s);
    var kvm_name: string = "__forkv_map_" + util.i32_to_string(s.label_n);
    s = s.bind_local(kvm_name);
    var kvm_off: i32 = s.lookup_local(kvm_name);
    s = s.write("    ldr x0, [sp], #16\n");
    s = s.frame_str("x0", kvm_off);
    var kvi_name: string = "__forkv_i_" + util.i32_to_string(s.label_n);
    s = s.bind_local(kvi_name);
    var kvi_off: i32 = s.lookup_local(kvi_name);
    s = s.write("    mov x0, #0\n");
    s = s.frame_str("x0", kvi_off);
    s = s.bind_local_typed(kvk, kvk_ty);
    var kvk_off: i32 = s.lookup_local(kvk);
    s = s.bind_local_typed(kvv, kvv_ty);
    var kvv_off: i32 = s.lookup_local(kvv);
    var kvtop: asmcore.LabelOut = asmcore.fresh_label(s);
    s = kvtop.state;
    var kvcont: asmcore.LabelOut = asmcore.fresh_label(s);
    s = kvcont.state;
    var kvend: asmcore.LabelOut = asmcore.fresh_label(s);
    s = kvend.state;
    s = s.write(kvtop.name + ":\n");
    s = s.frame_ldr("x0", kvm_off);
    s = s.write("    ldr x1, [x0]\n");        // keys arr
    s = s.write("    ldr x1, [x1]\n");        // keys.len
    s = s.frame_ldr("x2", kvi_off);
    s = s.write("    cmp x2, x1\n");
    s = s.write("    b.ge " + kvend.name + "\n");
    s = s.frame_ldr("x0", kvm_off);
    s = s.write("    ldr x1, [x0]\n");        // keys arr
    s = s.frame_ldr("x2", kvi_off);
    s = s.write("    add x2, x2, #1\n");
    s = s.write("    ldr x0, [x1, x2, lsl #3]\n");   // keys[i+1]
    s = s.frame_str("x0", kvk_off);
    s = s.frame_ldr("x0", kvm_off);
    s = s.write("    ldr x1, [x0, #8]\n");    // values arr
    s = s.frame_ldr("x2", kvi_off);
    s = s.write("    add x2, x2, #1\n");
    s = s.write("    ldr x0, [x1, x2, lsl #3]\n");   // values[i+1]
    s = s.frame_str("x0", kvv_off);
    s = s.push_loop_labels(kvend.name, kvcont.name);
    var kvbi: i32 = 0;
    while (kvbi < f.body.len()) {
        s = emit_stmt(f.body[kvbi], s);
        kvbi = kvbi + 1;
    }
    s = s.pop_loop_labels();
    s = s.write(kvcont.name + ":\n");
    s = s.frame_ldr("x0", kvi_off);
    s = s.write("    add x0, x0, #1\n");
    s = s.frame_str("x0", kvi_off);
    s = s.write("    b " + kvtop.name + "\n");
    s = s.write(kvend.name + ":\n");
    return s;
}

// emit_array_exit_dec — the arm64 Perceus function-exit release sweep
// (mirror of the x86-64 emitter). Releases (dec) each array-typed LOCAL
// slot, skipping the leading n_params receiver+param slots (borrowed).
// Slot for local index i is at [x29, -8*(i+1)]. The dec helper
// short-circuits null / low-address / sentinel, so an unassigned
// (zero-init) slot is a no-op. Clobbers x0 (and the dec helper's
// temps); callers needing a live value across the sweep save it first.
//
// `excl` is the local index to SKIP (Perceus move-on-return elides the
// dec for the slot handed to the caller); pass -1 to sweep all.
function emit_array_exit_dec_excl(s: asmcore.EmitState, excl: i32): asmcore.EmitState {
    var i: i32 = s.n_params;
    var any: boolean = false;
    while (i < s.local_names.len()) {
        if (i != excl && asmcore.ty_is_array_like(s.local_types[i])) {
            var off: i32 = 0 - 8 * (i + 1);
            s = s.frame_ldr("x0", off);                 // slot value
            s = s.write("    str x0, [sp, #-16]!\n");    // dec arg
            s = s.write("    bl __fn___fern_arr_dec\n");
            s = s.write("    add sp, sp, #16\n");
            any = true;
        }
        i = i + 1;
    }
    if (any) { s = s.mark_heap(); }
    return s;
}

function emit_array_exit_dec(s: asmcore.EmitState): asmcore.EmitState {
    return emit_array_exit_dec_excl(s, 0 - 1);
}

function emit_stmt(stmt: parser.Stmt, s: asmcore.EmitState): asmcore.EmitState {
    match (stmt) {
        // StmtDefer is lowered away (parser.lower_defers) before emit; this
        // arm only satisfies exhaustiveness — a survivor (e.g. a defer in a
        // lambda body, which lower_defers doesn't descend into) is flagged.
        parser.StmtDefer(_) => { s = s.write("    // unsupported: StmtDefer survived lowering\n"); return s; },
        parser.StmtReturn(r) => {
            var ret_is_arr: boolean = asmcore.ty_is_array_like(asmcore.infer_expr_type(r.value, s));
            // Perceus move-on-return: returning a bare owned array local
            // hands its buffer to the caller — skip the retain inc and
            // exclude that slot from the sweep (a balanced pair).
            var mov_idx: i32 = s.move_on_return_idx(r.value);
            s = emit_expr(r.value, s);
            if (s.in_function) {
                // Function return: pop value to x0. Perceus exit: retain
                // an array result so it survives the local release sweep
                // (which dec's its slot), then sweep, then restore the
                // result and ret. Net rc for the returned buffer is
                // unchanged for the caller. `mov sp, x29` undoes the
                // prologue's sub sp; ldp post-indexes sp by 16. When
                // move-on-return applies (mov_idx >= 0) the inc is elided
                // and the sweep skips that slot, so the pair cancels.
                s = s.write("    ldr x0, [sp], #16\n");
                if (ret_is_arr && mov_idx < 0) {
                    s = s.mark_heap();
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.write("    bl __fn___fern_rc_inc\n");
                    s = s.write("    add sp, sp, #16\n");
                }
                s = s.write("    str x0, [sp, #-16]!\n");   // save result across the sweep
                s = emit_array_exit_dec_excl(s, mov_idx);
                s = s.write("    ldr x0, [sp], #16\n");      // restore result
                s = s.write("    mov sp, x29\n");
                s = s.write("    ldp x29, x30, [sp], #16\n");
                s = s.write("    ret\n");
            } else {
                // Top-level return: sys_exit syscall.
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    mov x8, #93\n");
                s = s.write("    svc #0\n");
            }
            return s;
        },
        parser.StmtIf(ifs) => {
            // if/else lowers to:
            //   <cond>; ldr x0, [sp], #16; cbz x0, <else_lbl>
            //   <then-body>; b <end_lbl>
            //   <else_lbl>: <else-body>; <end_lbl>:
            // No-else uses a single label = end of then.
            s = emit_expr(ifs.cond, s);
            s = s.write("    ldr x0, [sp], #16\n");
            var else_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = else_l.state;
            s = s.write("    cbz x0, " + else_l.name + "\n");
            s = emit_block(ifs.then_body, s);
            if (ifs.else_body.len() > 0) {
                var end_l: asmcore.LabelOut = asmcore.fresh_label(s);
                s = end_l.state;
                s = s.write("    b " + end_l.name + "\n");
                s = s.write(else_l.name + ":\n");
                s = emit_block(ifs.else_body, s);
                s = s.write(end_l.name + ":\n");
            } else {
                s = s.write(else_l.name + ":\n");
            }
            return s;
        },
        parser.StmtWhile(w) => {
            // while lowers to:
            // <top_lbl>: <cond>; ldr x0, [sp], #16; cbz x0, <exit_lbl>
            //            <body>; b <top_lbl>
            // <exit_lbl>:
            //
            // break → <exit_lbl>; continue → <top_lbl>.
            var top_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = top_l.state;
            var exit_l: asmcore.LabelOut = asmcore.fresh_label(s);
            s = exit_l.state;
            s = s.write(top_l.name + ":\n");
            s = emit_expr(w.cond, s);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.write("    cbz x0, " + exit_l.name + "\n");
            s = s.push_loop_labels(exit_l.name, top_l.name);
            s = emit_block(w.body, s);
            s = s.pop_loop_labels();
            s = s.write("    b " + top_l.name + "\n");
            s = s.write(exit_l.name + ":\n");
            return s;
        },
        parser.StmtVar(v) => {
            // `var (a, b, …) = E` tuple destructuring (name "a,b,c"): eval
            // the tuple box, bind name[i] = box[i*8] for any arity. The box
            // pointer stays in x0 across the loop (frame_str scratches x16,
            // not x0). See asm.fern.
            var td_has_comma: boolean = false;
            var tdci: i32 = 0;
            while (tdci < v.name.len()) {
                if (v.name[tdci] == 44) { td_has_comma = true; }
                tdci = tdci + 1;
            }
            if (td_has_comma) {
                s = emit_expr(v.init, s);
                s = s.write("    ldr x0, [sp], #16\n");   // tuple box
                var td_seg: i32 = 0;
                var td_idx: i32 = 0;
                var td_pos: i32 = 0;
                while (td_pos <= v.name.len()) {
                    if (td_pos == v.name.len() || v.name[td_pos] == 44) {
                        var td_nm: str = v.name[td_seg : td_pos];
                        var td_tag: asmcore.Ty = asmcore.tuple_destructure_tag_at(v.init, td_idx, s);
                        s = s.bind_local_typed(td_nm, td_tag);
                        var td_off: i32 = s.lookup_local(td_nm);
                        s = s.write("    ldr x1, [x0, #" + util.i32_to_string(td_idx * 8) + "]\n");
                        s = s.frame_str("x1", td_off);
                        td_idx = td_idx + 1;
                        td_seg = td_pos + 1;
                    }
                    td_pos = td_pos + 1;
                }
                return s;
            }
            // Infer init type for string-aware dispatch.
            // Explicit annotation overrides inference.
            var ity: asmcore.Ty = asmcore.infer_expr_type(v.init, s);
            if (v.type_name.len() > 0) {
                ity = asmcore.ty_from_name(v.type_name);
            }
            // Perceus inc (Phase 1d): `var y = x` aliasing an rc-tracked
            // array retains the buffer; a fresh literal/call is owned.
            var alias_inc: boolean = asmcore.needs_rc_inc_on_alias(v.init, s);
            s = emit_expr(v.init, s);
            s = s.bind_local_typed(v.name, ity);
            var off: i32 = s.lookup_local(v.name);
            s = s.write("    ldr x0, [sp], #16\n");
            if (alias_inc) {
                s = s.mark_heap();
                s = s.write("    str x0, [sp, #-16]!\n");   // arg for __fern_rc_inc ([sp])
                s = s.write("    bl __fn___fern_rc_inc\n");  // returns the ptr in x0
                s = s.write("    add sp, sp, #16\n");
            }
            // Perceus dec-on-overwrite at a re-bound array slot: a loop
            // body's `var r = …` maps to ONE frame slot (zero-init at entry,
            // so the first binding releases null — a no-op), so releasing the
            // slot's prior buffer here frees each iteration's value instead
            // of leaking all but the last. Cow-guarded; balanced with the
            // alias-inc above. (Mirror of the x86-64 StmtVar release.)
            if (asmcore.ty_is_array_like(ity)) {
                s = s.mark_heap();
                var dvov: asmcore.LabelOut = asmcore.fresh_label(s);
                s = dvov.state;
                s = s.frame_ldr("x1", off);                  // OLD slot value
                s = s.write("    cmp x0, x1\n");
                s = s.write("    b.eq " + dvov.name + "\n");
                s = s.write("    str x0, [sp, #-16]!\n");     // save new value across the dec
                s = s.write("    str x1, [sp, #-16]!\n");     // dec arg = OLD value
                s = s.write("    bl __fn___fern_arr_dec\n");
                s = s.write("    add sp, sp, #16\n");         // pop dec arg
                s = s.write("    ldr x0, [sp], #16\n");       // restore new value
                s = s.write(dvov.name + ":\n");
            }
            s = s.frame_str("x0", off);
            return s;
        },
        parser.StmtAssign(a) => {
            if (!s.has_local(a.target)) {
                s = s.write("    // unresolved assign: " + a.target + "\n");
                return s;
            }
            // Perceus inc/dec (Phase 1d): retain the new reference when
            // `y = x` aliases an rc-tracked array, and release the OLD
            // value the slot held (dec-on-overwrite).
            var reassign_inc: boolean = asmcore.needs_rc_inc_on_alias(a.value, s);
            var target_is_arr: boolean = asmcore.ty_is_array_like(s.local_type_of(a.target));
            // Borrow model: a reassigned array PARAMETER (idx < n_params)
            // must NOT release its old value -- the caller owns it.
            if ((0 - s.lookup_local(a.target)) / 8 - 1 < s.n_params) { target_is_arr = false; }
            s = emit_expr(a.value, s);
            var off: i32 = s.lookup_local(a.target);
            s = s.write("    ldr x0, [sp], #16\n");          // new value
            if (reassign_inc) {
                s = s.mark_heap();
                s = s.write("    str x0, [sp, #-16]!\n");
                s = s.write("    bl __fn___fern_rc_inc\n");   // retain new (ptr back in x0)
                s = s.write("    add sp, sp, #16\n");
            }
            if (target_is_arr) {
                s = s.mark_heap();
                // Cow-aware dec (Phase 3 prep): skip the release when the
                // new value IS the old value the slot held — an in-place
                // mutator (`xs = xs.append(v)`) returned the same buffer,
                // which is still live. Only release a DIFFERENT object.
                var skip_lbl: asmcore.LabelOut = asmcore.fresh_label(s);
                s = skip_lbl.state;
                s = s.frame_ldr("x1", off);                   // OLD value
                s = s.write("    cmp x0, x1\n");
                s = s.write("    b.eq " + skip_lbl.name + "\n");
                s = s.write("    str x0, [sp, #-16]!\n");     // save new value across the dec
                s = s.write("    str x1, [sp, #-16]!\n");     // dec arg = OLD value
                s = s.write("    bl __fn___fern_arr_dec\n");
                s = s.write("    add sp, sp, #16\n");         // pop dec arg
                s = s.write("    ldr x0, [sp], #16\n");       // restore new value
                s = s.write(skip_lbl.name + ":\n");
            }
            s = s.frame_str("x0", off);
            return s;
        },
        parser.StmtExpr(x) => {
            s = emit_expr(x.value, s);
            s = s.write("    ldr x0, [sp], #16\n");  // drop result
            return s;
        },
        parser.StmtMatch(m) => {
            // Mirror of the x86-64 lowering in asm.fern. Eval
            // scrutinee, save into a fresh local slot, then for
            // each arm:
            //   PatVariant: load shape ptr from [scrut], cmp
            //   against the interned struct name, b.ne next arm;
            //   on match, bind `binding` to the scrutinee and
            //   emit the body.
            //   PatWildcard: always match.
            s = emit_expr(m.scrutinee, s);
            var scrut_name: string = "__match_scrut_" + util.i32_to_string(s.label_n);
            s = s.bind_local(scrut_name);
            var scrut_off: i32 = s.lookup_local(scrut_name);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.frame_str("x0", scrut_off);
            var end_lbl: i32 = s.label_n;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var arm: parser.MatchArm = m.arms[ai];
                var next_lbl: i32 = s.label_n;
                s = asmcore.EmitState { ...s, label_n: s.label_n + 1 };
                match (arm.pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.type_name == "true" || pv.type_name == "false") {
                            // `match (b) { true => …, false => … }`: the
                            // scrutinee is the bool itself (0/1), not a box.
                            s = s.frame_ldr("x0", scrut_off);
                            s = s.write("    cmp x0, #0\n");
                            if (pv.type_name == "true") {
                                s = s.write("    b.eq .Lmatch_next_" + util.i32_to_string(next_lbl) + "\n");
                            } else {
                                s = s.write("    b.ne .Lmatch_next_" + util.i32_to_string(next_lbl) + "\n");
                            }
                        } else if (pv.type_name == "Some" || pv.type_name == "None"
                                || pv.type_name == "Ok" || pv.type_name == "Err") {
                            // Built-in Option / Result: discriminate on
                            // the i32 tag at offset 0 (Some/Ok=0,
                            // None/Err=1), not the struct shape pointer.
                            // The non-empty variant (Some/Ok) binds its
                            // PAYLOAD (offset 8), not the box.
                            s = s.frame_ldr("x0", scrut_off);
                            s = s.write("    ldr x1, [x0]\n");
                            var want: i32 = 0;
                            if (pv.type_name == "None" || pv.type_name == "Err") { want = 1; }
                            s = s.write("    cmp x1, #" + util.i32_to_string(want) + "\n");
                            s = s.write("    b.ne .Lmatch_next_" + util.i32_to_string(next_lbl) + "\n");
                            if (pv.binding.len() > 0 && pv.binding != "_") {
                                s = s.write("    ldr x1, [x0, #8]\n");   // payload
                                // read_chunk → Some / read_file → Ok carry
                                // string payloads; bind as string for
                                // print / concat dispatch.
                                s = s.bind_local_typed(pv.binding, asmcore.match_payload_type(m.scrutinee, s));
                                var pbind_off: i32 = s.lookup_local(pv.binding);
                                s = s.frame_str("x1", pbind_off);
                            }
                        } else {
                        s = s.frame_ldr("x0", scrut_off);
                        s = s.write("    ldr x1, [x0]\n");
                        var nameLit: asmcore.StringLitOut = asmcore.add_string_lit(s, pv.type_name);
                        s = nameLit.state;
                        s = s.write("    adrp x2, " + asm_ir.str_lit_label(s, nameLit.idx) + "\n");
                        s = s.write("    add x2, x2, :lo12:" + asm_ir.str_lit_label(s, nameLit.idx) + "\n");
                        s = s.write("    cmp x1, x2\n");
                        s = s.write("    b.ne .Lmatch_next_" + util.i32_to_string(next_lbl) + "\n");
                        if (pv.binding.len() > 0 && pv.binding != "_") {
                            if (asmcore.is_enum_variant(pv.type_name, s)) {
                                // Enum variant `Circle(r)`: bind the
                                // payload at offset 8 (typed via "__ev").
                                s = s.write("    ldr x1, [x0, #8]\n");
                                s = s.bind_local_typed(pv.binding, asmcore.field_type_tag_in(pv.type_name, "__ev", s));
                                var ev_off: i32 = s.lookup_local(pv.binding);
                                s = s.frame_str("x1", ev_off);
                            } else {
                                // `type X = A|B` member: bind whole struct,
                                // typed so a field read resolves within it.
                                s = s.bind_local_typed(pv.binding, asmcore.ty_named(pv.type_name));
                                var bind_off: i32 = s.lookup_local(pv.binding);
                                s = s.frame_str("x0", bind_off);
                            }
                        }
                        }
                    },
                    parser.PatWildcard(_) => { }
                }
                // Guard: a `Pat when <expr> =>` arm runs only if the guard is
                // true. The binding is in scope, so the guard may reference it.
                // A false guard branches to the next arm (same as a pattern
                // mismatch); an all-guards-fail match falls through to the end.
                if (arm.has_guard) {
                    s = emit_expr(arm.guard, s);
                    s = s.write("    ldr x0, [sp], #16\n");
                    s = s.write("    cbz x0, .Lmatch_next_" + util.i32_to_string(next_lbl) + "\n");
                }
                var bi: i32 = 0;
                while (bi < arm.body.len()) {
                    s = emit_stmt(arm.body[bi], s);
                    bi = bi + 1;
                }
                s = s.write("    b .Lmatch_end_" + util.i32_to_string(end_lbl) + "\n");
                s = s.write(".Lmatch_next_" + util.i32_to_string(next_lbl) + ":\n");
                ai = ai + 1;
            }
            s = s.write(".Lmatch_end_" + util.i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtFor(f) => {
            // Mirror of the x86-64 StmtFor lowering in asm.fern.
            // Desugar: `for x in arr { body }` →
            //   __for_arr_N = arr; __for_i_N = 0;
            //   while (__for_i_N < len(__for_arr_N)) {
            //       x = __for_arr_N[__for_i_N]; body;
            //       __for_i_N = __for_i_N + 1;
            //   }
            var iter_ty: asmcore.Ty = asmcore.infer_expr_type(f.iter, s);
            // `for (k, v) in m` — see emit_map_kv_for.
            var kv_comma: i32 = 0 - 1;
            var kvci: i32 = 0;
            while (kvci < f.var_name.len()) {
                if (f.var_name[kvci] == 44 && kv_comma < 0) { kv_comma = kvci; }
                kvci = kvci + 1;
            }
            if (asmcore.is_map(iter_ty) && kv_comma >= 0) {
                return emit_map_kv_for(s, f, kv_comma);
            }
            var elem_ty: asmcore.Ty = asmcore.ty_i32();
            if (asmcore.ty_is_array_string(iter_ty)) { elem_ty = asmcore.ty_string(); }
            if (asmcore.ty_is_array_u32(iter_ty)) { elem_ty = asmcore.ty_u32(); }
            if (asmcore.ty_is_array_u64(iter_ty)) { elem_ty = asmcore.ty_u64(); }
            if (asmcore.ty_is_array_i64(iter_ty)) { elem_ty = asmcore.ty_i64(); }
            // Generic `array` tag (struct / `dyn Trait` / otherwise
            // non-primitive elements): bind the loop var "unknown" so a
            // method call on it dispatches by runtime shape, not the
            // primitive path. See the x86-64 backend for the rationale.
            if (asmcore.ty_is_array(iter_ty)) { elem_ty = asmcore.ty_unknown(); }
            // `for b in STR` (iterate a string's BYTES): a string box is
            // { data_ptr @0, len @8 } with byte elements, NOT the array layout
            // (len @0, 8-byte elements @ base + (idx+1)*8) the loop below
            // assumes — reading it as an array walks the header as data (#2822).
            // The IR path desugars this in lower_string_foreach; the AST path
            // (which emits the runtime helpers via emit_runtime_fern_fn, e.g.
            // __fern_str_to_i32's `for b in s`) needs the same string-shaped
            // length load + byte element load. Bytes bind as i32.
            var is_str_iter: boolean = asmcore.ty_is_string(iter_ty);
            if (is_str_iter) { elem_ty = asmcore.ty_i32(); }
            s = emit_expr(f.iter, s);
            var arr_name: string = "__for_arr_" + util.i32_to_string(s.label_n);
            s = s.bind_local(arr_name);
            var arr_off: i32 = s.lookup_local(arr_name);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.frame_str("x0", arr_off);
            var idx_name: string = "__for_i_" + util.i32_to_string(s.label_n);
            s = s.bind_local(idx_name);
            var idx_off: i32 = s.lookup_local(idx_name);
            s = s.write("    mov x0, #0\n");
            s = s.frame_str("x0", idx_off);
            s = s.bind_local_typed(f.var_name, elem_ty);
            var elem_off: i32 = s.lookup_local(f.var_name);
            var top_lbl: i32 = s.label_n;
            var cont_lbl: i32 = s.label_n + 1;
            var end_lbl: i32 = s.label_n + 2;
            s = asmcore.EmitState { ...s, label_n: s.label_n + 3 };
            s = s.write(".Lfor_top_" + util.i32_to_string(top_lbl) + ":\n");
            // Condition: idx < len. String len is @8; array len is @0.
            s = s.frame_ldr("x0", arr_off);
            if (is_str_iter) {
                s = s.write("    ldr x1, [x0, #8]\n");
            } else {
                s = s.write("    ldr x1, [x0]\n");
            }
            s = s.frame_ldr("x2", idx_off);
            s = s.write("    cmp x2, x1\n");
            s = s.write("    b.ge .Lfor_end_" + util.i32_to_string(end_lbl) + "\n");
            // Bind element. String: byte-load data_ptr[idx] (data_ptr @0);
            // array: 8-byte element at base + (idx+1)*8 (header offset).
            s = s.frame_ldr("x0", arr_off);
            if (is_str_iter) {
                s = s.write("    ldr x3, [x0]\n");           // data_ptr @0
                s = s.frame_ldr("x1", idx_off);
                s = s.write("    ldrb w0, [x3, x1]\n");      // byte at data[idx] (zero-extends)
            } else {
                s = s.frame_ldr("x1", idx_off);
                s = s.write("    add x1, x1, #1\n");
                s = s.write("    ldr x0, [x0, x1, lsl #3]\n");
            }
            s = s.frame_str("x0", elem_off);
            // Body — break → .Lfor_end; continue → .Lfor_cont.
            s = s.push_loop_labels(".Lfor_end_" + util.i32_to_string(end_lbl), ".Lfor_cont_" + util.i32_to_string(cont_lbl));
            var bi: i32 = 0;
            while (bi < f.body.len()) {
                s = emit_stmt(f.body[bi], s);
                bi = bi + 1;
            }
            s = s.pop_loop_labels();
            // i = i + 1; jump to top.
            s = s.write(".Lfor_cont_" + util.i32_to_string(cont_lbl) + ":\n");
            s = s.frame_ldr("x0", idx_off);
            s = s.write("    add x0, x0, #1\n");
            s = s.frame_str("x0", idx_off);
            s = s.write("    b .Lfor_top_" + util.i32_to_string(top_lbl) + "\n");
            s = s.write(".Lfor_end_" + util.i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtBreak(_) => {
            var lbl: string = s.top_loop_exit();
            if (lbl.len() == 0) { s = s.write("    // break outside loop\n"); return s; }
            s = s.write("    b " + lbl + "\n"); return s;
        },
        parser.StmtContinue(_) => {
            var lbl: string = s.top_loop_cont();
            if (lbl.len() == 0) { s = s.write("    // continue outside loop\n"); return s; }
            s = s.write("    b " + lbl + "\n"); return s;
        },
        parser.StmtUnknown(_) => { s = s.write("    // unsupported: StmtUnknown\n"); return s; }
    }
    return s;
}

// emit_function emits a single FuncDecl as a `__fn_<name>:`
// label with prologue, arg-copy, body, and (fallback) epilogue.
// Args arrive on the stack at [x29, #16], [x29, #32], … (caller
// pushed right-to-left, so arg 0 is closest to the saved pair).
// Each arg takes 16 bytes because the rt-stack pushes/pops with
// 16-byte alignment. The prologue copies each arg into its
// local slot at [x29, #-8*(i+1)] so the body reads them
// uniformly.
function emit_function(fd: parser.FuncDecl, s: asmcore.EmitState): asmcore.EmitState {
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) {
        // Generic receiver types (`Box[T]`) strip to the base struct
        // name so the symbol matches the dispatch shape compare.
        label_name = util.base_type_name(fd.receiver_type) + "." + fd.name;
    }
    s = s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    var has_recv: boolean = fd.receiver_name.len() > 0;
    var argc: i32 = fd.params.len();
    if (has_recv) { argc = argc + 1; }
    var n_body_locals: i32 = asmcore.count_locals(fd.body);
    var total_locals: i32 = argc + n_body_locals;
    if (total_locals > 0) {
        var bytes: i32 = total_locals * 8;
        if (bytes % 16 != 0) { bytes = bytes + 8; }
        s = s.write("    sub sp, sp, #" + util.i32_to_string(bytes) + "\n");
    }
    // Zero-init the body-local slots (Perceus exit-sweep safety): a
    // `var` skipped on the current path must read NULL (dec no-op), not
    // stack garbage. Body locals are slots [argc, total_locals), the
    // range [x29-total_locals*8 .. x29-argc*8); param slots are above
    // and untouched. x9/x10 are dead here (before the param copy).
    if (n_body_locals > 0) {
        var zl: asmcore.LabelOut = asmcore.fresh_label(s); s = zl.state;
        var zd: asmcore.LabelOut = asmcore.fresh_label(s); s = zd.state;
        s = s.write("    sub x9, x29, #" + util.i32_to_string(total_locals * 8) + "\n");
        s = s.write("    mov x10, #" + util.i32_to_string(n_body_locals) + "\n");
        s = s.write(zl.name + ":\n");
        s = s.write("    cbz x10, " + zd.name + "\n");
        s = s.write("    str xzr, [x9], #8\n");
        s = s.write("    sub x10, x10, #1\n");
        s = s.write("    b " + zl.name + "\n");
        s = s.write(zd.name + ":\n");
    }
    s = s.reset_locals();
    s = s.enter_function();
    // For methods: receiver sits at +16(x29), params at
    // +32, +48, … (caller pushed args right-to-left then the
    // receiver, so receiver is closest to the saved fp).
    if (has_recv) {
        s = s.bind_local_typed(fd.receiver_name, asmcore.struct_local_tag(fd.receiver_type, s));
        var recv_off: i32 = s.lookup_local(fd.receiver_name);
        s = s.write("    ldr x0, [x29, #16]   // recv " + fd.receiver_name + "\n");
        s = s.frame_str("x0", recv_off);
    }
    var recv_shift: i32 = 0;
    if (has_recv) { recv_shift = 1; }
    var n_params: i32 = fd.params.len();
    var i: i32 = 0;
    while (i < n_params) {
        s = s.bind_local_typed(fd.params[i].name, asmcore.struct_local_tag(fd.params[i].type_name, s));
        var local_off: i32 = s.lookup_local(fd.params[i].name);
        var arg_off: i32 = 16 + (i + recv_shift) * 16;
        s = s.frame_ldr("x0", arg_off);
        s = s.frame_str("x0", local_off);
        i = i + 1;
    }
    // Receiver+param slot boundary for the Perceus exit sweep (params
    // are borrowed — released by the caller, not here).
    s = s.set_n_params(argc);
    var bi: i32 = 0;
    while (bi < fd.body.len()) {
        s = emit_stmt(fd.body[bi], s);
        bi = bi + 1;
    }
    // Fallback: implicit `return 0;` so falling off the end doesn't run
    // into the next function's label. Release the array locals first
    // (Perceus exit sweep); the 0 return is not an array, so no retain.
    s = emit_array_exit_dec(s);
    s = s.write("    mov x0, #0\n");
    s = s.write("    mov sp, x29\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    // Flush the literal pool after each function body so any `ldr X, =N`
    // we've emitted stays within the PC-relative ±1 MiB window. Without
    // this, programs >1 MiB of code (e.g. the bundled self-host
    // compiler) trip `as` with "pc-relative load offset out of range".
    s = s.write("    .ltorg\n");
    s = s.leave_function();
    s = s.reset_locals();
    return s;
}

// emit_runtime_fern_fn is the migration primitive for issue #2649 (arm64
// mirror of asm.fern's): a runtime helper written in *Fern* rather than a
// hand-written asm string is parsed and lowered through the normal function
// emitter, so it links as `__fn_<name>` and is called via the ordinary stack
// convention. The body must be self-contained — fully type-annotated and
// bottoming out in inline-lowered operations (scalar arithmetic, control
// flow) — so it needs no checker pass and calls no other helper.
function emit_runtime_fern_fn(src: string, s: asmcore.EmitState): asmcore.EmitState {
    var m: parser.Module = parser.parse_module(lexer.tokenize(src));
    // Flush any string literals the helper body interns (e.g. "" in
    // arr_str_join) — they land after the main .rodata pool, so emit them in
    // their own .rodata block then return to .text. No-op for a literal-free
    // helper. (See the x86-64 mirror in asm.fern.)
    var lit0: i32 = s.string_lits.len();
    var i: i32 = 0;
    while (i < m.funcs.len()) {
        s = emit_function(m.funcs[i], s);
        i = i + 1;
    }
    if (s.string_lits.len() > lit0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = lit0;
        while (li < s.string_lits.len()) {
            s = s.write(asm_ir.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
        s = s.write("    .text\n");
    }
    return s;
}










// emit_runtime appends the runtime-library helper bodies the
// module requested via need()/has_need(): print_int, the heap
// bump-allocator, string + array helpers, args, strbuf, etc.
// Each block is gated on has_need(...) so only referenced
// helpers are emitted. Split out of emit_module so that the
// orchestration (type-check, function bodies, _start) stays
// readable; the relative emission order is unchanged.
// darwin selects Mach-O vs ELF sections/syscalls in the bodies.
// emit_rodata_pools_arm64 writes this unit's .rodata constant pools: the
// interned string literals (str_lit_label — str_ns-namespaced per-module,
// `.S<idx>` on the merged path) and, per-module only, the enum/struct SHAPE
// names as `.weak` global symbols (shape_sym) so the SAME shape merges to one
// linker address across translation units — pointer-equality shape
// discrimination then holds across the module boundary (the arm64 mirror of
// asm_ir's #3451-step-3 shape sharing). On the merged path shape_lits is empty
// (shape_ref interns shapes as ordinary string lits when str_ns==""), so the
// shape block is inert and the string pool stays byte-identical to the
// pre-refactor `.S<idx>` emission.
pub function emit_rodata_pools_arm64(s: asmcore.EmitState): asmcore.EmitState {
    if (s.string_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < s.string_lits.len()) {
            s = s.write(asm_ir.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
    }
    if (s.shape_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var shi: i32 = 0;
        while (shi < s.shape_lits.len()) {
            var shsym: string = asmcore.shape_sym(s.shape_lits[shi]);
            s = s.write(".weak " + shsym + "\n");
            s = s.write(shsym + ": .ascii \"" + asmcore.escape_for_ascii(s.shape_lits[shi]) + "\"\n");
            shi = shi + 1;
        }
    }
    return s;
}

// emit_module_ir_unit_arm64 is the arm64 mirror of asm_ir.emit_module_ir_unit
// (the per-module-compilation epic, #3451 / #3457 step 0a): it emits ONE
// translation unit's worth of arm64 asm from the IR path. The four knobs match
// x86's: is_entry (emit `_start` + the single shared __fern_* runtime),
// globl_defs (mark each emitted `__fn_<label>` `.globl` so a sibling unit's
// `bl __fn_...` extern resolves at link), str_ns (per-module .rodata namespace
// so two units' string + shape pools co-link without collision), and
// extra_needs (the whole-program runtime-need union, folded into the entry's
// single runtime so a sibling's helper is present). all_funcs/all_structs are
// the whole-program signature view (#3454) driving call/return tagging + struct
// layout; only mod.funcs are EMITTED. The _start is copied verbatim from
// emit_body (the proven single-unit IR path). Caller must have established
// asm_ir.all_eligible_*_known_view(mod) and seeded nothing (we reset here).
pub function emit_module_ir_unit_arm64(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[], lo: i32, hi: i32): string {
    mod = parser.infer_ret_types_module(mod);
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    // struct_decls is the WHOLE-PROGRAM struct set so a function emitting an
    // imported struct's layout resolves it; str_ns namespaces this unit's pools.
    s = asmcore.EmitState { ...s, struct_decls: all_structs, funcs: mod.funcs, str_ns: str_ns };
    if (is_entry) { s = s.write("    .globl _start\n"); }
    s = s.write("    .text\n");
    // The entry exports its shared runtime entry points (__fern_alloc /
    // __fern_arr_box / …) `.globl` so sibling library units' `bl __fern_*`
    // externs resolve against the single copy it emits. Target-independent
    // symbol list — reused from asm_ir.
    if (is_entry && globl_defs) { s = asm_ir.emit_runtime_globls(s); }
    // Side-tables derived ONCE over the whole-program all_funcs (#3454) — per-fn
    // derivation is O(n^2) and OOMs the bump heap (mirrors emit_body / x86
    // emit_module_funcs). struct_ret over all_structs.
    var arf: string[] = asm_ir.array_ret_fns_of(all_funcs);
    var bparams: string[] = irlower.borrowable_params_interproc(all_funcs);
    var csparams: string[] = irlower.consume_safe_params_interproc(all_funcs, bparams);
    var srf: string[] = irlower.str_ret_fns_of(all_funcs);
    var sarf: string[] = irlower.strarr_ret_fns_of(all_funcs);
    var amf: string[] = irlower.arr_method_fns_of(all_funcs);
    var orf: string[] = irlower.opt_ret_fns_of(all_funcs);
    var irf: string[] = irlower.i64_ret_fns_of(all_funcs);
    var trf: string[] = irlower.tuple_ret_fns_of(all_funcs);
    var srtf: string[] = irlower.struct_ret_fns_of(all_funcs, all_structs);
    var mrtf: string[] = irlower.map_ret_fns_of(all_funcs);
    var frf: string[] = irlower.f64_ret_fns_of(all_funcs);
    var farf: string[] = irlower.f64arr_ret_fns_of(all_funcs);
    var iarf: string[] = irlower.i64arr_ret_fns_of(all_funcs);
    var fps: string[] = irlower.fn_param_sigs_of(all_funcs, all_structs);
    var cfs: string[] = irlower.closure_and_fnptr_fns_of(all_funcs, all_structs);
    var cnf: string[] = irlower.const_fns_of(all_funcs);
    var frsf: string[] = irlower.fresh_struct_ret_fns_of(all_funcs, all_structs);
    var rfrsf: string[] = irlower.return_fresh_struct_ret_fns_of(all_funcs, all_structs);
    var sfrf: string[] = irlower.str_fresh_ret_fns_of(all_funcs);
    var ofrf: string[] = irlower.opt_fresh_ret_fns_of(all_funcs, all_structs);
    var sfot: string[] = irlower.strfld_reclaim_ok_types_of(all_funcs, all_structs);
    var tfrf: string[] = irlower.tuple_fresh_ret_fns_of(all_funcs);
    // [lo, hi) function-index window (function-sharding, #3425 — the arm64
    // mirror of asm_ir.emit_module_funcs' windowing). A full window (lo=0,
    // hi<0 "to the end") is byte-identical to the unsharded emit; a partial
    // window lets an oversized module emit across separate processes without
    // any single emit's leak-mode heap crossing the arena ceiling.
    var hh: i32 = hi;
    if (hh < 0 || hh > mod.funcs.len()) { hh = mod.funcs.len(); }
    var fi: i32 = lo;
    while (fi < hh) {
        if (globl_defs) {
            var gname: string = mod.funcs[fi].name;
            if (mod.funcs[fi].receiver_type.len() > 0) { gname = util.base_type_name(mod.funcs[fi].receiver_type) + "." + mod.funcs[fi].name; }
            s = s.write(".globl __fn_" + asmcore.sanitize_label(gname) + "\n");
        }
        s = asm_arm64_ir.emit_function_via_ir(mod.funcs[fi], arf, s, bparams, srf, sarf, amf, orf, irf, trf, srtf, mrtf, frf, farf, iarf, fps, cfs, irlower.closurearr_ret_fns_of(mod.funcs, mod.structs), cnf, irlower.fn_names_of(mod.funcs), frsf, csparams, rfrsf, sfrf, ofrf, sfot, tfrf);
        fi = fi + 1;
    }
    // #4355: admit the replaced-STRING-field arm per type from the
    // WHOLE-PROGRAM read scan (all_funcs — see asm_ir.emit_module_ir_unit's
    // sibling seeding and irlower.strfld_reclaim_ok_types_of).
    var sfok: string[] = irlower.strfld_reclaim_ok_types_of(all_funcs, all_structs);
    var sfoi: i32 = 0;
    while (sfoi < sfok.len()) { s = s.need("strfldok:" + sfok[sfoi]); sfoi = sfoi + 1; }
    // #5235: seed the plain-fn-pointer-array field registry as needs so
    // emit_arm64_struct_drop_one buffer-only-decs those fields (no element walk).
    var fpk: string[] = irlower.fnptr_arr_fields_of(all_funcs, all_structs);
    var fpi: i32 = 0;
    while (fpi < fpk.len()) { s = s.need(fpk[fpi]); fpi = fpi + 1; }
    // Per-type __field_reclaim_<T> + __struct_drop_<T> bodies (#3457). Shared
    // with emit_module's single-unit IR path (so the load_run / emit_module
    // route also emits them — previously only this multi-unit path did, so a
    // reclaimable struct-with-array-field link-failed there).
    s = emit_arm64_reclaim_drop_bodies(s);
    // Fold the whole-program need union (sibling modules' needs) into the entry's
    // single runtime BEFORE _start, so _start's args gating sees a sibling's
    // args() need. Inert (empty) on the single-unit path.
    var en: i32 = 0;
    while (en < extra_needs.len()) { s = s.need(extra_needs[en]); en = en + 1; }
    // _start belongs only to the entry (one program entry point). Copied verbatim
    // from emit_body: save argc/argv from the SysV entry stack (gated on args),
    // frame push, call __fn_main, exit with its result.
    if (is_entry) {
        s = s.write("_start:\n");
        if (s.has_need("args")) {
            s = s.write("    ldr x0, [sp]\n");
            s = s.write("    adrp x1, __fern_argc\n");
            s = s.write("    add x1, x1, :lo12:__fern_argc\n");
            s = s.write("    str x0, [x1]\n");
            s = s.write("    add x0, sp, #8\n");
            s = s.write("    adrp x1, __fern_argv\n");
            s = s.write("    add x1, x1, :lo12:__fern_argv\n");
            s = s.write("    str x0, [x1]\n");
        }
        // Save envp for env() / subprocess (Linux SysV: envp = sp + 16 +
        // argc*8), gated on heap like the AST _start and the __fern_env
        // helper. The multi-unit IR _start missed it just like emit_body's;
        // without it __fern_envp stays null and env() derefs a null base.
        if (s.has_need("heap")) {
            s = s.write("    ldr x0, [sp]\n");            // argc
            s = s.write("    lsl x0, x0, #3\n");          // argc*8
            s = s.write("    add x0, x0, #16\n");         // + 16 (argc slot + argv NULL)
            s = s.write("    add x0, sp, x0\n");          // envp base
            s = s.write("    adrp x1, __fern_envp\n");
            s = s.write("    add x1, x1, :lo12:__fern_envp\n");
            s = s.write("    str x0, [x1]\n");
        }
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    bl __fn_main\n");
        s = s.write("    mov x8, #93\n");
        s = s.write("    svc #0\n");
    }
    s = s.close_needs();
    // The entry emits the single shared __fern_* runtime (its helpers are already
    // `.globl`, so sibling `bl __fern_*` externs resolve against it) AND its own
    // .rodata pools (emit_runtime calls emit_rodata_pools_arm64). A non-entry
    // module emits ONLY its own pools — no runtime, no _start.
    if (is_entry) {
        s = emit_runtime(s, false);
    } else {
        s = emit_rodata_pools_arm64(s);
    }
    return strbuf_take();
}

// emit_arm64_reclaim_drop_bodies emits this unit's per-type __field_reclaim_<T>
// + __struct_drop_<T> helper bodies (#3457), `.weak` (link-deduped across units).
// Called by BOTH arm64 IR emit paths — emit_module_ir_unit_arm64 (multi-unit)
// and emit_module's single-unit IR dispatch — so a reclaimable struct with an
// rc-array field links on either. Both are now REAL: __struct_drop the deep-drop
// (slice 1a), __field_reclaim the consume-rebind replaced-field reclaim (slice
// 1b, now that arm64's __fern_snapshot_dec frees the old box).
function emit_arm64_reclaim_drop_bodies(s: asmcore.EmitState): asmcore.EmitState {
    var fri: i32 = 0;
    while (fri < s.needed.len()) {
        var frnd: string = s.needed[fri];
        if (frnd.len() > 14 && frnd[0:14] == "field_reclaim:") {
            s = emit_arm64_field_reclaim_one(s, frnd[14 : frnd.len()]);
        }
        fri = fri + 1;
    }
    var sdi: i32 = 0;
    while (sdi < s.needed.len()) {
        var sdnd: string = s.needed[sdi];
        // One index-driven loop over both prefixes so the transitive needs
        // (arr_elems -> struct_drop, and a struct_drop k_box arm -> arr_elems) are all
        // absorbed as they are appended, regardless of discovery order.
        if (sdnd.len() > 22 && sdnd[0:22] == "struct_arr_elems_drop:") {
            s = emit_arm64_struct_arr_elems_drop_one(s, sdnd[22 : sdnd.len()]);
        } else if (sdnd.len() > 12 && sdnd[0:12] == "struct_drop:") {
            s = emit_arm64_struct_drop_one(s, sdnd[12 : sdnd.len()]);
        }
        sdi = sdi + 1;
    }
    return s;
}

// emit_arm64_field_reclaim_one emits one __field_reclaim_<sty> body, the arm64
// transcription of asm_ir.emit_ir_field_reclaim_one. Stack-arg ABI: [sp]=snap,
// [sp+16]=old, [sp+32]=new. For each rc-array field (offset (k+1)*8 off the
// struct box) it SHALLOW-frees old.field_k via __fern_arr_dec iff it differs from
// new.field_k (cow) AND, when snap != 0, from snap.field_k (the caller's
// original); then frees the old BOX via __fern_snapshot_dec(new, old, snap) and
// returns `new` in x0. x10/x11/x12 hold new/old/snap across the field loop —
// __fern_arr_dec clobbers only x0..x3,x9, so they survive (snapshot_dec is the
// last call, after the loop). stp x29,x30 saves LR for the bls; the low-addr
// guard uses `cmp #16, lsl #12` (= 0x10000).
function emit_arm64_field_reclaim_one(s: asmcore.EmitState, sty: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(sty);
    var n: i32 = irlower.decl_field_count(s.struct_decls, sty);
    s = s.write(".weak __fn___field_reclaim_" + san + "\n");
    s = s.write("__fn___field_reclaim_" + san + ":\n");
    s = s.write("    ldr x10, [sp, #32]\n");            // new
    s = s.write("    ldr x11, [sp, #16]\n");            // old
    s = s.write("    ldr x12, [sp]\n");                 // snap
    s = s.write("    stp x29, x30, [sp, #-16]!\n");     // save LR for the nested bls
    s = s.write("    cmp x11, #16, lsl #12\n");         // old null/low -> skip fields
    s = s.write("    blo .Lafr_" + san + "_box\n");
    var k: i32 = 0;
    while (k < n) {
        var fdt: string = irlower.decl_field_type_at(s.struct_decls, sty, k);
        // A replaced STRING field (#4355): released via the rc-aware
        // __fern_str_free under the same cow + snap guards — mirrors the x86
        // emit_ir_field_reclaim_one string arm (see its comment for the
        // construction-retain balance and the "strfldok:<T>" whole-program
        // read-scan gate). UNLIKE arr_dec, __fern_str_free CLOBBERS
        // x10/x11/x12 (its heap-base / heap-end / freelist-head scratch), so
        // new/old/snap are reloaded from the stable stack args after the
        // call — the frame push above shifts them to [sp+48] / [sp+32] /
        // [sp+16].
        var fr_str: boolean = fdt == "string" && s.has_need("strfldok:" + sty);
        // A replaced STRING[] field: deep-freed via __fern_str_arr_free (the
        // strarrfld-gated x86 sibling arm's transcription). Its per-element
        // __fern_str_free clobbers x10/x11/x12, so the same reload applies.
        var fr_str_arr: boolean = fdt == "string[]" && s.has_need("strfldok:arr:" + sty);
        // A replaced fn (closure) field — the x86 fr_clo arm's transcription
        // (clofld-gated shallow arr_dec, generic branch below).
        var fr_clo: boolean = fdt == "fn" && s.has_need("strfldok:clo:" + sty);
        if (fr_str || fr_str_arr || fr_clo || irlower.is_leaksafe_array_field(fdt) || irlower.is_struct_array_field_type(s.struct_decls, fdt) || irlower.is_enum_array_field_type(s.struct_decls, fdt)) {
            var off: string = util.i32_to_string((k + 1) * 8);
            var ks: string = util.i32_to_string(k);
            s = s.write("    ldr x1, [x11, #" + off + "]\n");      // old.field_k
            s = s.write("    ldr x2, [x10, #" + off + "]\n");      // new.field_k
            s = s.write("    cmp x1, x2\n");                       // == new? (cow)
            s = s.write("    beq .Lafr_" + san + "_skip" + ks + "\n");
            s = s.write("    cbz x12, .Lafr_" + san + "_dec" + ks + "\n");  // snap == 0 (local)?
            s = s.write("    ldr x2, [x12, #" + off + "]\n");      // snap.field_k
            s = s.write("    cmp x1, x2\n");                       // == snap? (caller's)
            s = s.write("    beq .Lafr_" + san + "_skip" + ks + "\n");
            s = s.write(".Lafr_" + san + "_dec" + ks + ":\n");
            s = s.write("    str x1, [sp, #-16]!\n");
            if (fr_str || fr_str_arr) {
                if (fr_str) {
                    s = s.write("    bl __fn___fern_str_free\n");  // rc-aware string free (data buffer + box)
                } else {
                    s = s.write("    bl __fn___fern_str_arr_free\n");  // deep string[] free (rc-guarded)
                }
                s = s.write("    add sp, sp, #16\n");
                // str_free / str_arr_free clobbered x10/x11/x12 — reload
                // new/old/snap from the stack args (shifted +16 by the stp
                // x29,x30 frame).
                s = s.write("    ldr x10, [sp, #48]\n");           // new
                s = s.write("    ldr x11, [sp, #32]\n");           // old
                s = s.write("    ldr x12, [sp, #16]\n");           // snap
            } else {
                s = s.write("    bl __fn___fern_arr_dec\n");       // shallow dec/free the dead buffer
                s = s.write("    add sp, sp, #16\n");
            }
            s = s.write(".Lafr_" + san + "_skip" + ks + ":\n");
        }
        k = k + 1;
    }
    s = s.write(".Lafr_" + san + "_box:\n");
    // snapshot_dec(new, old, snap): push so [sp]=snap, [sp+16]=old, [sp+32]=new.
    s = s.write("    str x10, [sp, #-16]!\n");          // new
    s = s.write("    str x11, [sp, #-16]!\n");          // old
    s = s.write("    str x12, [sp, #-16]!\n");          // snap
    s = s.write("    bl __fn___fern_snapshot_dec\n");   // free old box (cow + snap guarded); x0 = new
    s = s.write("    add sp, sp, #48\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

// emit_arm64_struct_drop_one emits one __struct_drop_<sty>(box) -> box body, the
// arm64 transcription of asm_ir.emit_ir_struct_drop_one. Stack-arg ABI: [sp]=box.
// For each rc-tracked ARRAY field (offset (k+1)*8 off the box's data pointer) it
// releases the field BUFFER via __fn___fern_arr_dec (rc-guarded shallow dec/free);
// for a struct/enum-array field it FIRST walks the buffer (when uniquely owned)
// dec'ing each element box, then dec's the buffer. Returns `box` in x0 (the call
// site drops it). x10/x11/x12 hold box/buffer/index across the field loop —
// __fern_arr_dec and __fern_rc_is_unique clobber only x0..x3,x9, so they survive;
// the low-addr guard uses `cmp #16, lsl #12` (= 0x10000) to avoid tying up x9
// across the calls. The nested bls need LR saved, hence the stp x29,x30 frame;
// each call's arg is pushed at [sp] (the helpers' frameless ABI) then popped.
// IR array layout: len at buffer[0], element i at buffer[(i+1)*8], rc at buffer-8.
function emit_arm64_struct_drop_one(s: asmcore.EmitState, sty: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(sty);
    var n: i32 = irlower.decl_field_count(s.struct_decls, sty);
    s = s.write(".weak __fn___struct_drop_" + san + "\n");
    s = s.write("__fn___struct_drop_" + san + ":\n");
    s = s.write("    ldr x10, [sp]\n");                 // box (read before the frame push)
    s = s.write("    mov x0, x10\n");                   // default return = box
    s = s.write("    stp x29, x30, [sp, #-16]!\n");     // save LR/FP for the nested bls
    s = s.write("    cmp x10, #16, lsl #12\n");         // box null / low-addr -> skip fields
    s = s.write("    blo .Lasd_" + san + "_ret\n");
    var k: i32 = 0;
    while (k < n) {
        var fdt: string = irlower.decl_field_type_at(s.struct_decls, sty, k);
        var k_scalar: boolean = irlower.is_leaksafe_array_field(fdt);
        // A registered PLAIN-fn-pointer array field (#5235): route to the
        // buffer-only shallow dec (k_scalar arm) instead of the k_box element
        // WALK — its elements are raw code addresses (a box walk SIGSEGVs). The
        // arm64 transcription of the x86 emit_ir_struct_drop_one k_fnptr gate.
        var k_fnptr: boolean = !k_scalar && irlower.is_enum_array_field_type(s.struct_decls, fdt)
            && s.has_need("FNPTR:" + sty + "." + irlower.decl_field_name_at(s.struct_decls, sty, k));
        var k_box: boolean = !k_scalar && !k_fnptr && (irlower.is_struct_array_field_type(s.struct_decls, fdt) || irlower.is_enum_array_field_type(s.struct_decls, fdt));
        // A DIRECT nested-struct field (`inner: Inner`): freed SHALLOW via the
        // same __fern_arr_dec as a scalar-array buffer — one level, like a struct-
        // array element box (arr_dec already frees struct boxes). rc-guarded inside
        // arr_dec; the construction alias-inc (shared irlower) balances it. Mirrors
        // the x86 emit_ir_struct_drop_one k_struct case (Perceus slice 3b).
        var k_struct: boolean = !k_scalar && !k_box && irlower.decl_is_struct(s.struct_decls, fdt);
        // A `string` field is rc-headered (#4294); reclaimed via the rc-aware
        // __fern_str_free (free rc==1, dec rc>1, skip view/literal rc<0), balanced
        // by the shared-irlower construction alias-inc. Mirrors the x86 k_str arm
        // (#4297 A2). GATED on the whole-program read scan ("strfldok:<T>"),
        // exactly like __field_reclaim_<T>'s string arm above: the construction
        // retain only fires for STRFLDOK-admitted types, so a non-admitted
        // type's string fields are uncounted aliases this free would dangle —
        // the merged-bundle IR self-compile corruption (#3425, x86 twin note).
        var k_str: boolean = !k_scalar && !k_box && !k_struct && fdt == "string" && s.has_need("strfldok:" + sty);
        // A DIRECT enum field (`e: MyEnum`, decl_is_enum): freed SHALLOW via the same
        // __fern_arr_dec as the scalar-array / nested-struct box (arr_dec frees enum
        // boxes too) — one level, the variant payload leaks (deferred deep-drop).
        // Construction alias-incs a non-fresh enum field (shared irlower) so this dec
        // is balanced. Mirrors the x86 emit_ir_struct_drop_one k_enum arm. #4297 A2.
        var k_enum: boolean = !k_scalar && !k_box && !k_struct && !k_str && irlower.decl_is_enum(s.struct_decls, fdt);
        // A string[] field: deep-freed via __fern_str_arr_free, gated on the
        // strarrfld admission ("strfldok:arr:<T>") — the arm64 transcription
        // of the x86 k_str_arr arm (see its comment for the element-freshness
        // soundness contract).
        var k_str_arr: boolean = !k_scalar && !k_box && !k_struct && !k_str && !k_enum && fdt == "string[]" && s.has_need("strfldok:arr:" + sty);
        // An fn-typed (closure) field: shallow-freed via the same rc-guarded
        // __fern_arr_dec as k_struct / k_enum — the arm64 transcription of the
        // x86 k_clo arm (clofld-gated, captures leak).
        var k_clo: boolean = !k_scalar && !k_box && !k_struct && !k_str && !k_enum && !k_str_arr && fdt == "fn" && s.has_need("strfldok:clo:" + sty);
        var off: string = util.i32_to_string((k + 1) * 8);
        var ks: string = util.i32_to_string(k);
        if (k_box) {
            // MULTI-LEVEL array-element deep-drop (#2649): a struct-ARRAY field `X[]`
            // whose element struct X is deep-drop-ok releases each element's OWN rc
            // fields via __struct_arr_elems_drop_X BEFORE the element/buffer arr_dec
            // below frees the boxes. The helper calls __struct_drop_X, clobbering
            // x10/x11/x12, so reload box from the frame-relative stack arg [sp, #16]
            // (entry pushed one stp frame), mirroring the k_struct deep-drop arm.
            // Enum-array elements have no __struct_drop, so they stay shallow.
            if (irlower.is_struct_array_field_type(s.struct_decls, fdt)) {
                var elem_ty: str = fdt[0 : fdt.len() - 2];
                if (irlower.nested_field_deep_drop_ok(s.struct_decls, elem_ty)) {
                    var esan: string = asmcore.sanitize_label(elem_ty);
                    s = s.need("struct_arr_elems_drop:" + elem_ty);
                    s = s.write("    ldr x0, [x10, #" + off + "]\n");       // buffer
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.write("    bl __fn___struct_arr_elems_drop_" + esan + "\n");
                    s = s.write("    add sp, sp, #16\n");
                    s = s.write("    ldr x10, [sp, #16]\n");                // reload box (helper clobbered x10)
                }
            }
            s = s.write("    ldr x11, [x10, #" + off + "]\n");      // buffer = box.field_k
            s = s.write("    cmp x11, #16, lsl #12\n");             // null/low -> skip walk
            s = s.write("    blo .Lasd_" + san + "_buf" + ks + "\n");
            s = s.write("    str x11, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_rc_is_unique\n");       // shared (rc>1) -> skip element walk
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    cbz x0, .Lasd_" + san + "_buf" + ks + "\n");
            s = s.write("    mov x12, #0\n");                       // i = 0
            s = s.write(".Lasd_" + san + "_loop" + ks + ":\n");
            s = s.write("    ldr x0, [x11]\n");                     // len = buffer[0]
            s = s.write("    cmp x12, x0\n");
            s = s.write("    bge .Lasd_" + san + "_buf" + ks + "\n");  // i >= len -> done
            s = s.write("    add x1, x12, #1\n");
            s = s.write("    ldr x0, [x11, x1, lsl #3]\n");         // elem = buffer[(i+1)*8]
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_arr_dec\n");            // shallow dec the element box
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    add x12, x12, #1\n");
            s = s.write("    b .Lasd_" + san + "_loop" + ks + "\n");
            s = s.write(".Lasd_" + san + "_buf" + ks + ":\n");
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // reload buffer (x11 may be past-end)
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_arr_dec\n");            // shallow dec the buffer slab
            s = s.write("    add sp, sp, #16\n");
        } else if (k_struct && irlower.nested_field_deep_drop_ok(s.struct_decls, fdt)) {
            // DEEP nested-struct field drop (Perceus slice 3 deep-drop): when the
            // inner box is UNIQUELY owned, first __struct_drop_<fdt> releases the
            // inner's OWN rc-array buffers, THEN __fern_arr_dec frees the inner box —
            // mirroring the k_box element walk and the x86 emit_ir_struct_drop_one
            // deep-drop arm. fdt is deep-drop-ok (its nested-struct closure is ACYCLIC
            // per nested_field_deep_drop_ok), so __struct_drop_<fdt> may itself recurse
            // into fdt's own deep-drop-ok fields: the emitted call graph is a DAG (multi-
            // level, bounded by the struct-type count, no cycle). Emit the inner's per-
            // type body (transitive need: emit_arm64_reclaim_drop_bodies re-checks needed.len(),
            // need() dedups). __fern_arr_dec / __fern_rc_is_unique preserve x10, but
            // __struct_drop_<fdt> CLOBBERS it, so reload box from the frame-relative
            // stack arg [sp, #16] after the call (entry pushed an stp x29,x30 frame,
            // so the box stack arg sits one frame slot above sp once the per-call
            // push is balanced off).
            var fsan: string = asmcore.sanitize_label(fdt);
            s = s.need("struct_drop:" + fdt);
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // inner = box.field_k
            s = s.write("    cmp x0, #16, lsl #12\n");              // null / low -> skip field-release
            s = s.write("    blo .Lasd_" + san + "_sdf" + ks + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_rc_is_unique\n");       // shared (rc>1) -> skip field-release
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    cbz x0, .Lasd_" + san + "_sdf" + ks + "\n");
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // reload inner (x10 valid here)
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___struct_drop_" + fsan + "\n");  // release inner's rc fields (clobbers x10)
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    ldr x10, [sp, #16]\n");                // reload box (struct_drop clobbered x10)
            s = s.write(".Lasd_" + san + "_sdf" + ks + ":\n");
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // inner box
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_arr_dec\n");            // free the inner box (rc-guarded)
            s = s.write("    add sp, sp, #16\n");
        } else if (k_str) {
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // box.field_k string box
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_str_free\n");           // rc-aware: free rc==1, dec rc>1, skip view/literal rc<0
            s = s.write("    add sp, sp, #16\n");
            // str_free clobbers x10 (freelist-head scratch) — reload the box
            // from the frame-relative stack arg so a LATER field's arm reads
            // a valid pointer. Before this, a string field ordered BEFORE
            // another rc field left x10 stale and the next arm freed through
            // garbage (the .ret reload only covered the RETURN, not the loop).
            s = s.write("    ldr x10, [sp, #16]\n");
        } else if (k_str_arr) {
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // box.field_k string[] buffer
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_str_arr_free\n");       // deep at rc==1 (elements + buffer); shared -> dec
            s = s.write("    add sp, sp, #16\n");
            s = s.write("    ldr x10, [sp, #16]\n");                // reload box (helper clobbers x10/x11/x12)
        } else if (k_scalar || k_struct || k_enum || k_clo || k_fnptr) {
            s = s.write("    ldr x0, [x10, #" + off + "]\n");       // box.field_k buffer / nested box / enum box / closure box / fn-ptr array buffer (shallow, no element walk)
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write("    bl __fn___fern_arr_dec\n");
            s = s.write("    add sp, sp, #16\n");
        }
        k = k + 1;
    }
    s = s.write(".Lasd_" + san + "_ret:\n");
    // Return the BOX (the documented contract) by reloading the stack arg —
    // NOT `mov x0, x10`: __fern_str_free and a nested __struct_drop_* bl
    // clobber x10/x11/x12 (the slice-2 field-reclaim lesson), so a string /
    // deep-struct field release left x10 stale and the enum-payload deep-drop
    // (which CONSUMES this return for its payload-box free) dec'd a garbage /
    // already-freed pointer. The arg sits at [sp, #16] under the stp frame.
    s = s.write("    ldr x0, [sp, #16]\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

// emit_arm64_struct_arr_elems_drop_one is the arm64 transcription of
// asm_ir.emit_ir_struct_arr_elems_drop_one: __struct_arr_elems_drop_<E>(buffer) walks a
// uniquely-owned buffer and, per uniquely-owned element box, calls __struct_drop_<E> to
// release the element's OWN rc fields (the level the shallow k_box walk leaked). It frees
// neither the element boxes nor the buffer — the k_box caller's arr_dec does that. Stack-
// arg ABI: [sp]=buffer at entry (at [sp, #32] after the two stp saves). x19=buffer,
// x20=index are callee-saved so they survive the nested __struct_drop_<E> call (which
// clobbers x10/x11/x12) and the arr_dec/is_unique calls (x0..x3,x9). Buffer + each element
// are is_unique-gated. `.weak`, per-unit, needs __struct_drop_<E>.
function emit_arm64_struct_arr_elems_drop_one(s: asmcore.EmitState, ety: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(ety);
    s = s.need("struct_drop:" + ety);
    s = s.write(".weak __fn___struct_arr_elems_drop_" + san + "\n");
    s = s.write("__fn___struct_arr_elems_drop_" + san + ":\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");             // save FP/LR for the bls
    s = s.write("    stp x19, x20, [sp, #-16]!\n");             // save callee-saved x19/x20
    s = s.write("    ldr x19, [sp, #32]\n");                    // buffer (arg + 32 for two stp saves)
    s = s.write("    cmp x19, #16, lsl #12\n");                 // null / low -> nothing to walk
    s = s.write("    blo .Lsaed_" + san + "_ret\n");
    s = s.write("    str x19, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_rc_is_unique\n");           // shared buffer -> elements shared -> skip
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    cbz x0, .Lsaed_" + san + "_ret\n");
    s = s.write("    mov x20, #0\n");                           // i = 0
    s = s.write(".Lsaed_" + san + "_loop:\n");
    s = s.write("    ldr x0, [x19]\n");                         // len = buffer[0]
    s = s.write("    cmp x20, x0\n");
    s = s.write("    bge .Lsaed_" + san + "_ret\n");            // i >= len -> done
    s = s.write("    add x1, x20, #1\n");
    s = s.write("    ldr x0, [x19, x1, lsl #3]\n");             // elem = buffer[(i+1)*8]
    s = s.write("    cmp x0, #16, lsl #12\n");                  // null / low -> skip
    s = s.write("    blo .Lsaed_" + san + "_next\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___fern_rc_is_unique\n");           // shared element (aliased out) -> skip
    s = s.write("    add sp, sp, #16\n");
    s = s.write("    cbz x0, .Lsaed_" + san + "_next\n");
    s = s.write("    add x1, x20, #1\n");                       // recompute elem (x1 clobbered by call)
    s = s.write("    ldr x0, [x19, x1, lsl #3]\n");
    s = s.write("    str x0, [sp, #-16]!\n");
    s = s.write("    bl __fn___struct_drop_" + san + "\n");     // release elem's OWN rc fields
    s = s.write("    add sp, sp, #16\n");
    s = s.write(".Lsaed_" + san + "_next:\n");
    s = s.write("    add x20, x20, #1\n");
    s = s.write("    b .Lsaed_" + san + "_loop\n");
    s = s.write(".Lsaed_" + san + "_ret:\n");
    s = s.write("    mov x0, x19\n");                           // return buffer (caller dec's it)
    s = s.write("    ldp x19, x20, [sp], #16\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ccall_shim1_arm64 emits one `__fn___c_call<n>[suffix]` FFI shim (#4375),
// the arm64 sibling of asm_ir.emit_ccall_shim1. Entered like any stack-ABI
// callee (the generic call_direct emit reversed the args so arg0/fn sits on
// top): param0 (fn) @ [x29,#16], a_i @ [x29,#(32 + 16i)]. Marshal fn into x9
// and a0..a{n-1} into the AAPCS64 arg registers x0..x3, then `blr x9`; the
// result lands in x0 (or d0 for the _f32/_f64 variants) and flows straight back.
// The 16-byte-slotted rt-stack keeps sp 16-aligned, so no extra alignment is
// needed for the C call.
function emit_ccall_shim1_arm64(s: asmcore.EmitState, variant: string, n: i32): asmcore.EmitState {
    s = s.write("\n__fn_" + variant + ":\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n");
    s = s.write("    ldr x9, [x29, #16]\n");
    if (n >= 1) { s = s.write("    ldr x0, [x29, #32]\n"); }
    if (n >= 2) { s = s.write("    ldr x1, [x29, #48]\n"); }
    if (n >= 3) { s = s.write("    ldr x2, [x29, #64]\n"); }
    if (n >= 4) { s = s.write("    ldr x3, [x29, #80]\n"); }
    s = s.write("    blr x9\n");
    s = s.write("    ldp x29, x30, [sp], #16\n    ret\n");
    return s;
}

// emit_ccall_shims_arm64 emits every __c_call variant the module referenced
// (each registered as `need("ccall:<name>")` by the arm64 call_direct emit).
function emit_ccall_shims_arm64(s: asmcore.EmitState): asmcore.EmitState {
    var ca: i32 = 0;
    while (ca <= 4) {
        var cbase: string = "__c_call" + util.i32_to_string(ca);
        if (s.has_need("ccall:" + cbase)) { s = emit_ccall_shim1_arm64(s, cbase, ca); }
        if (s.has_need("ccall:" + cbase + "_f32")) { s = emit_ccall_shim1_arm64(s, cbase + "_f32", ca); }
        if (s.has_need("ccall:" + cbase + "_f64")) { s = emit_ccall_shim1_arm64(s, cbase + "_f64", ca); }
        ca = ca + 1;
    }
    return s;
}

pub function emit_runtime(s: asmcore.EmitState, darwin: boolean): asmcore.EmitState {
    // FFI __c_call<n> shims (#4375): allocation-free arg-marshal + `blr fn`.
    s = emit_ccall_shims_arm64(s);
    // __fern_print_int helper: converts the i64 in x0 to
    // decimal text in a stack buffer and writes to stdout.
    if (s.has_need("print_int")) {
        s = s.write("__fern_print_int:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    sub sp, sp, #32\n");
        s = s.write("    mov x9, x0\n");
        s = s.write("    mov x10, #0\n");
        s = s.write("    cmp x9, #0\n");
        s = s.write("    bge .Lpi_pos\n");
        s = s.write("    neg x9, x9\n");
        s = s.write("    mov x10, #1\n");
        s = s.write(".Lpi_pos:\n");
        s = s.write("    sub x11, x29, #1\n");
        s = s.write("    cbnz x9, .Lpi_loop\n");
        s = s.write("    mov w12, #48\n");           // '0'
        s = s.write("    strb w12, [x11]\n");
        s = s.write("    sub x11, x11, #1\n");       // match loop's post-decrement
        s = s.write("    mov x12, #1\n");
        s = s.write("    b .Lpi_maybe_neg\n");
        s = s.write(".Lpi_loop:\n");
        s = s.write("    mov x12, #0\n");
        s = s.write(".Lpi_div:\n");
        s = s.write("    mov x13, #10\n");
        s = s.write("    sdiv x14, x9, x13\n");
        s = s.write("    msub x15, x14, x13, x9\n");
        s = s.write("    add x15, x15, #48\n");
        s = s.write("    strb w15, [x11]\n");
        s = s.write("    sub x11, x11, #1\n");
        s = s.write("    add x12, x12, #1\n");
        s = s.write("    mov x9, x14\n");
        s = s.write("    cbnz x9, .Lpi_div\n");
        s = s.write(".Lpi_maybe_neg:\n");
        s = s.write("    cmp x10, #0\n");
        s = s.write("    beq .Lpi_no_neg\n");
        s = s.write("    mov w15, #45\n");           // '-'
        s = s.write("    strb w15, [x11]\n");
        s = s.write("    sub x11, x11, #1\n");
        s = s.write("    add x12, x12, #1\n");
        s = s.write(".Lpi_no_neg:\n");
        s = s.write("    add x11, x11, #1\n");
        s = s.write("    mov x1, x11\n");
        s = s.write("    mov x2, x12\n");
        s = s.write("    mov x0, #1\n");
        s = s.write("    mov x8, #64\n");            // sys_write
        s = s.write("    svc #0\n");
        s = s.write("    mov sp, x29\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // __fern_now_unix_ms / __fern_monotonic_ns: clock_gettime
    // (arm64 syscall 113) helpers. Emitted unconditionally — they
    // don't touch the heap, so they can't ride the needs_heap gate
    // that carries read_file/write_file, and a pure-scalar program
    // that times something must still link. The kernel writes a
    // `struct timespec { i64 tv_sec; i64 tv_nsec }` to the buffer.
    // Errno is ignored: with a fixed clock id and a stack buffer we
    // control, the realistic failures (EFAULT/EINVAL) can't fire.
    // now_unix_ms: CLOCK_REALTIME=0 → tv_sec*1000 + tv_nsec/1e6.
    s = s.write("__fern_now_unix_ms:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    sub sp, sp, #16\n");        // time buffer
    if (darwin) {
        // Darwin has no clock_gettime syscall; gettimeofday(tp, NULL)
        // (BSD 116) fills `struct timeval { i64 tv_sec @0; i32 tv_usec
        // @8 }`. ms = tv_sec*1000 + tv_usec/1000.
        s = s.write("    mov x0, sp\n");             // &timeval
        s = s.write("    mov x1, #0\n");             // tz = NULL
        s = s.write("    mov x16, #116\n");          // gettimeofday
        s = s.write("    svc #0x80\n");
        s = s.write("    ldr x9, [sp]\n");           // tv_sec
        s = s.write("    mov x10, #1000\n");
        s = s.write("    mul x9, x9, x10\n");        // sec * 1000
        s = s.write("    ldr w11, [sp, #8]\n");      // tv_usec (i32)
        s = s.write("    mov x12, #1000\n");
        s = s.write("    udiv x11, x11, x12\n");     // usec / 1000
        s = s.write("    add x0, x9, x11\n");
    } else {
        s = s.write("    mov x0, #0\n");             // CLOCK_REALTIME
        s = s.write("    mov x1, sp\n");             // &timespec
        s = s.write("    mov x8, #113\n");           // clock_gettime
        s = s.write("    svc #0\n");
        s = s.write("    ldr x9, [sp]\n");           // tv_sec
        s = s.write("    mov x10, #1000\n");
        s = s.write("    mul x9, x9, x10\n");        // sec * 1000
        s = s.write("    ldr x11, [sp, #8]\n");      // tv_nsec
        s = s.write("    ldr x12, =1000000\n");
        s = s.write("    udiv x11, x11, x12\n");     // nsec / 1e6
        s = s.write("    add x0, x9, x11\n");
    }
    s = s.write("    mov sp, x29\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    // monotonic_ns: CLOCK_MONOTONIC=1 → tv_sec*1e9 + tv_nsec.
    s = s.write("__fern_monotonic_ns:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    if (darwin) {
        // Darwin has no clock_gettime syscall. mach_absolute_time on
        // Apple Silicon is a read of the architectural counter
        // CNTVCT_EL0 (EL0-readable), scaled by its frequency CNTFRQ_EL0
        // (24 MHz on Apple Silicon) to nanoseconds. Compute
        // ns = (count/freq)*1e9 + ((count%freq)*1e9)/freq to avoid the
        // u64 overflow a bare count*1e9 would hit over long uptimes.
        s = s.write("    mrs x9, cntvct_el0\n");      // count
        s = s.write("    mrs x10, cntfrq_el0\n");     // freq (Hz)
        s = s.write("    udiv x11, x9, x10\n");       // sec = count / freq
        s = s.write("    msub x12, x11, x10, x9\n");  // rem = count - sec*freq
        s = s.write("    ldr x13, =1000000000\n");
        s = s.write("    mul x11, x11, x13\n");       // sec * 1e9
        s = s.write("    mul x12, x12, x13\n");       // rem * 1e9
        s = s.write("    udiv x12, x12, x10\n");      // (rem*1e9) / freq
        s = s.write("    add x0, x11, x12\n");        // ns
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    } else {
        s = s.write("    sub sp, sp, #16\n");        // timespec
        s = s.write("    mov x0, #1\n");             // CLOCK_MONOTONIC
        s = s.write("    mov x1, sp\n");             // &timespec
        s = s.write("    mov x8, #113\n");           // clock_gettime
        s = s.write("    svc #0\n");
        s = s.write("    ldr x9, [sp]\n");           // tv_sec
        s = s.write("    ldr x10, =1000000000\n");
        s = s.write("    mul x9, x9, x10\n");        // sec * 1e9
        s = s.write("    ldr x11, [sp, #8]\n");      // tv_nsec
        s = s.write("    add x0, x9, x11\n");
        s = s.write("    mov sp, x29\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // now_ns: CLOCK_REALTIME=0 → tv_sec*1e9 + tv_nsec (the
    // nanosecond-resolution twin of now_unix_ms). Same frame as
    // now_unix_ms; Darwin uses gettimeofday scaled to ns.
    s = s.write("__fern_now_ns:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    sub sp, sp, #16\n");        // time buffer
    if (darwin) {
        s = s.write("    mov x0, sp\n");             // &timeval
        s = s.write("    mov x1, #0\n");             // tz = NULL
        s = s.write("    mov x16, #116\n");          // gettimeofday
        s = s.write("    svc #0x80\n");
        s = s.write("    ldr x9, [sp]\n");           // tv_sec
        s = s.write("    ldr x10, =1000000000\n");
        s = s.write("    mul x9, x9, x10\n");        // sec * 1e9
        s = s.write("    ldr w11, [sp, #8]\n");      // tv_usec (i32)
        s = s.write("    mov x12, #1000\n");
        s = s.write("    mul x11, x11, x12\n");      // usec * 1000 = ns
        s = s.write("    add x0, x9, x11\n");
    } else {
        s = s.write("    mov x0, #0\n");             // CLOCK_REALTIME
        s = s.write("    mov x1, sp\n");             // &timespec
        s = s.write("    mov x8, #113\n");           // clock_gettime
        s = s.write("    svc #0\n");
        s = s.write("    ldr x9, [sp]\n");           // tv_sec
        s = s.write("    ldr x10, =1000000000\n");
        s = s.write("    mul x9, x9, x10\n");        // sec * 1e9
        s = s.write("    ldr x11, [sp, #8]\n");      // tv_nsec
        s = s.write("    add x0, x9, x11\n");
    }
    s = s.write("    mov sp, x29\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    // __fern_sleep_ms(x0 = ms) — nanosleep wrapper, no heap. Same
    // shape as the x86 mirror but arm64 syscall numbers: nanosleep=101.
    s = s.write(".globl __fern_sleep_ms\n");
    s = s.write(".type __fern_sleep_ms, %function\n");
    s = s.write("__fern_sleep_ms:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    s = s.write("    sub sp, sp, #32\n");
    s = s.write("    cmp x0, #0\n");
    s = s.write("    b.le .Lsm_done\n");
    s = s.write("    mov x9, #1000\n");
