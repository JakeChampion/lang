// match_payload_type — see asm.fern. Infers an Option/Result payload
// binding's type from the match scrutinee so an i32 payload isn't
// wrongly typed "string".
function match_payload_type(scrut: parser.Expr, s: EmitState): string {
    match (scrut) {
        parser.ExprIdent(id) => {
            // Scrutinee is a local — recover the wrapped payload tag
            // from its declared/inferred type.
            if (s.has_local(id.name)) {
                var lt: string = s.local_type_of(id.name);
                if (lt.len() >= 7 && lt[0:7] == "option:") { return lt[7 : lt.len()]; }
                if (lt.len() >= 7 && lt[0:7] == "result:") { return lt[7 : lt.len()]; }
            }
            return "unknown";
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if ((id.name == "Some" || id.name == "Ok") && c.args.len() == 1) {
                        return infer_expr_type(c.args[0], s);
                    }
                    if (id.name == "read_file" || id.name == "read_all_stdin") { return "string"; }
                    if (id.name == "temp_dir") { return "string"; }
                    if (id.name == "read_dir") { return "array_string"; }
                    // Arbitrary free / module function returning
                    // Option[T] or Result[T, …] — see asm.fern.
                    var fi: i32 = 0;
                    while (fi < s.funcs.len()) {
                        if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
                            var rt: string = s.funcs[fi].ret_type;
                            if (rt.len() >= 8 && rt[0:7] == "Option[" && rt[rt.len() - 1] == 93) {
                                return ret_tag_of(rt[7 : rt.len() - 1]);
                            }
                            if (rt.len() >= 8 && rt[0:7] == "Result[") {
                                var inner: string = "(" + rt[7 : rt.len() - 1] + ")";
                                return split_tuple_ret(inner).a;
                            }
                            return "unknown";
                        }
                        fi = fi + 1;
                    }
                    return "unknown";
                },
                parser.ExprFieldAccess(fa) => {
                    if (fa.field == "read_chunk") { return "string"; }
                    if (fa.field == "get") {
                        var rt: string = infer_expr_type(fa.obj, s);
                        if (is_map(rt)) { return map_value_part(rt); }
                    }
                    if (fa.field == "min" || fa.field == "max") {
                        if (infer_expr_type(fa.obj, s) == "array_i32") { return "i32"; }
                    }
                    // Receiver method call. See asm.fern.
                    var rcv: string = infer_expr_type(fa.obj, s);
                    if (rcv.len() > 0) {
                        var fi: i32 = 0;
                        while (fi < s.funcs.len()) {
                            if (s.funcs[fi].name == fa.field && s.funcs[fi].receiver_type == rcv) {
                                var rt: string = s.funcs[fi].ret_type;
                                if (rt.len() >= 8 && rt[0:7] == "Option[" && rt[rt.len() - 1] == 93) {
                                    return ret_tag_of(rt[7 : rt.len() - 1]);
                                }
                                if (rt.len() >= 8 && rt[0:7] == "Result[") {
                                    var inner: string = "(" + rt[7 : rt.len() - 1] + ")";
                                    return split_tuple_ret(inner).a;
                                }
                                return "unknown";
                            }
                            fi = fi + 1;
                        }
                    }
                    return "unknown";
                },
                _ => { return "unknown"; }
            }
        },
        _ => { return "unknown"; }
    }
    return "unknown";
}

function ret_tag_of(name: string): string {
    if (name == "i32") { return "i32"; }
    // See asm.fern: wider / unsigned integer scalars get their own
    // tags so the compare emit can pick signed vs unsigned cset
    // (lo/ls/hi/hs instead of lt/le/gt/ge) — values near u64::MAX
    // sort by unsigned order. Method dispatch (.to_string / .len /
    // .push / etc.) accepts every is_int_tag / is_int_array_tag.
    if (name == "u32") { return "u32"; }
    if (name == "u64") { return "u64"; }
    if (name == "i64") { return "i64"; }
    if (name == "usize") { return "usize"; }
    if (name == "isize") { return "isize"; }
    if (name == "u32[]") { return "array_u32"; }
    if (name == "u64[]") { return "array_u64"; }
    if (name == "i64[]") { return "array_i64"; }
    if (name == "f64" || name == "f32" || name == "float") { return "f64"; }
    if (name == "bool" || name == "boolean") { return "bool"; }
    if (name == "string") { return "string"; }
    if (name == "string[]") { return "array_string"; }
    if (name == "i32[]") { return "array_i32"; }
    if (name == "bool[]" || name == "boolean[]") { return "array_i32"; }
    if (name.len() >= 8 && name[0:8] == "MapIter[") {
        return "mapiter:" + generic_value_tag(name, 8);
    }
    if (name.len() >= 4 && name[0:4] == "Map[") {
        // i32-keyed maps tag as "mapI:<V>" (integer key comparison);
        // otherwise "map:<V>". See asm.fern.
        if (generic_key_tag(name, 4) == "i32") {
            return "mapI:" + generic_value_tag(name, 4);
        }
        return "map:" + generic_value_tag(name, 4);
    }
    if (name.len() >= 3 && name[0:3] == "Map") { return "map:unknown"; }
    // Option[T] / Result[T, E] → first-class wrapper tags. Must precede
    // the trailing-`]` → "array" fallback below (both end in `]`). The
    // payload of Result is left "unknown" — the checker only compares the
    // wrapper-ness, never the error arm.
    if (name.len() >= 8 && name[0:7] == "Option[") {
        return "option:" + ret_tag_of(name[7:name.len() - 1]);
    }
    if (name.len() >= 8 && name[0:7] == "Result[") {
        // Result[T, E] — preserve the Ok payload tag. See asm.fern.
        var inner: string = "(" + name[7 : name.len() - 1] + ")";
        return "result:" + split_tuple_ret(inner).a;
    }
    if (name.len() > 0 && name[name.len() - 1] == 93) { return "array"; }
    return "unknown";
}

// TwoTags / split_tuple_ret / tuple_destructure_tags — see asm.fern
// for the full rationale. They recover the element type tags of a
// `var (a, b) = init` binding so a struct-typed element's receiver
// methods dispatch through the runtime shape-pointer path rather than
// mis-mangling as `__fn_i32__<method>`.
struct TwoTags { a: string, b: string }

function split_tuple_ret(tt: string): TwoTags {
    if (tt.len() < 3 || tt[0] != 40) { return TwoTags { a: "i32", b: "i32" }; }
    var inner: string = tt[1 : tt.len() - 1];
    var depth: i32 = 0;
    var i: i32 = 0;
    var split_at: i32 = 0 - 1;
    while (i < inner.len()) {
        var ch: i32 = inner[i];
        if (ch == 91 || ch == 40) { depth = depth + 1; }
        else if (ch == 93 || ch == 41) { depth = depth - 1; }
        else if (ch == 44 && depth == 0 && split_at < 0) { split_at = i; }
        i = i + 1;
    }
    if (split_at < 0) { return TwoTags { a: "i32", b: "i32" }; }
    var a: string = inner[0 : split_at];
    var bstart: i32 = split_at + 1;
    if (bstart < inner.len() && inner[bstart] == 32) { bstart = bstart + 1; }
    var b: string = inner[bstart : inner.len()];
    return TwoTags { a: ret_tag_of(a), b: ret_tag_of(b) };
}

function tuple_destructure_tags(init: parser.Expr, s: EmitState): TwoTags {
    match (init) {
        parser.ExprTuple(t) => {
            if (t.elements.len() >= 2) {
                return TwoTags { a: infer_expr_type(t.elements[0], s), b: infer_expr_type(t.elements[1], s) };
            }
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    var fi: i32 = 0;
                    while (fi < s.funcs.len()) {
                        if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
                            return split_tuple_ret(s.funcs[fi].ret_type);
                        }
                        fi = fi + 1;
                    }
                },
                _ => { }
            }
        },
        _ => { }
    }
    return TwoTags { a: "i32", b: "i32" };
}

// is_int_tag accepts every integer-shaped type tag — i32 / i64 /
// u32 / u64 / usize / isize — so method-dispatch sites that used
// to check `tag == "i32"` keep accepting wider/unsigned values.
function is_int_tag(t: string): boolean {
    return t == "i32" || t == "u32" || t == "u64" || t == "i64"
        || t == "usize" || t == "isize";
}

// is_int_array_tag — same idea for arrays of integers.
function is_int_array_tag(t: string): boolean {
    return t == "array_i32" || t == "array_u32" || t == "array_u64"
        || t == "array_i64";
}

// is_unsigned_tag picks out the tags whose values need unsigned
// compare semantics (lo / ls / hi / hs instead of lt / le / gt / ge
// on arm64; setb / setbe / seta / setae on x86).
function is_unsigned_tag(t: string): boolean {
    return t == "u32" || t == "u64" || t == "usize";
}

// is_unsigned_int_array_tag — array element type is unsigned.
function is_unsigned_int_array_tag(t: string): boolean {
    return t == "array_u32" || t == "array_u64";
}

// generic_key_tag — see asm.fern. Key type from a `Map[K, V]` name.
function generic_key_tag(name: string, start: i32): string {
    if (name.len() <= start + 1) { return "unknown"; }
    var inner: string = name[start : name.len() - 1];
    var i: i32 = 0;
    while (i + 1 < inner.len()) {
        if (inner[i] == 44 && inner[i + 1] == 32) {
            return ret_tag_of(inner[0 : i]);
        }
        i = i + 1;
    }
    return "unknown";
}

// is_map — see asm.fern. "map", "map:<V>", or "mapI:<V>".
function is_map(t: string): boolean {
    return t == "map" || (t.len() >= 4 && t[0:4] == "map:")
        || (t.len() >= 5 && t[0:5] == "mapI:");
}

// map_key_is_i32 / map_value_part — see asm.fern.
function map_key_is_i32(t: string): boolean {
    return t.len() >= 5 && t[0:5] == "mapI:";
}

function map_value_part(t: string): string {
    if (t.len() >= 5 && t[0:5] == "mapI:") { return t[5 : t.len()]; }
    if (t.len() >= 4 && t[0:4] == "map:") { return t[4 : t.len()]; }
    return "unknown";
}

// is_mapiter — see asm.fern.
function is_mapiter(t: string): boolean {
    return t.len() >= 8 && t[0:8] == "mapiter:";
}

// is_enum_variant / is_unit_variant — see asm.fern. A payload-bearing
// enum variant is a synthesized struct with the marker field "__ev"; a
// no-payload variant is a zero-field struct.
function is_enum_variant(name: string, s: EmitState): boolean {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == name) {
            var sd: parser.StructDecl = s.struct_decls[di];
            var fi: i32 = 0;
            while (fi < sd.fields.len()) {
                if (sd.fields[fi].name == "__ev") { return true; }
                fi = fi + 1;
            }
            return false;
        }
        di = di + 1;
    }
    return false;
}

function is_unit_variant(name: string, s: EmitState): boolean {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == name) {
            return s.struct_decls[di].fields.len() == 0;
        }
        di = di + 1;
    }
    return false;
}

// generic_value_tag — see asm.fern. Extracts the value-type tag from a
// `Map[K, V]` / `MapIter[K, V]` type name; `start` is past the `[`.
function generic_value_tag(name: string, start: i32): string {
    if (name.len() <= start + 1) { return "unknown"; }
    var inner: string = name[start : name.len() - 1];
    var i: i32 = 0;
    while (i + 1 < inner.len()) {
        if (inner[i] == 44 && inner[i + 1] == 32) {
            return ret_tag_of(inner[i + 2 : inner.len()]);
        }
        i = i + 1;
    }
    return "unknown";
}

// field_type_tag infers the type tag of a struct-field read (`x.s`)
// by finding a struct decl that declares a field of that name and
// mapping its declared type. Mirrors the x86-64 emitter (asm.fern).
// field_type_tag_in — see asm.fern. Resolves a field within a named
// struct (used when the receiver's struct type is known).
function field_type_tag_in(struct_name: string, field: string, s: EmitState): string {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == struct_name) {
            var sd: parser.StructDecl = s.struct_decls[di];
            var fi: i32 = 0;
            while (fi < sd.fields.len()) {
                if (sd.fields[fi].name == field) {
                    return ret_tag_of(sd.fields[fi].type_name);
                }
                fi = fi + 1;
            }
            return "unknown";
        }
        di = di + 1;
    }
    return "unknown";
}

function field_type_tag(field: string, s: EmitState): string {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        var sd: parser.StructDecl = s.struct_decls[di];
        var fi: i32 = 0;
        while (fi < sd.fields.len()) {
            if (sd.fields[fi].name == field) {
                return ret_tag_of(sd.fields[fi].type_name);
            }
            fi = fi + 1;
        }
        di = di + 1;
    }
    return "unknown";
}

function infer_expr_type(e: parser.Expr, s: EmitState): string {
    match (e) {
        parser.ExprNumber(n) => { if (n.is_float) { return "f64"; } return "i32"; },
        parser.ExprBool(_) => { return "bool"; },
        parser.ExprString(_) => { return "string"; },
        parser.ExprArray(a) => {
            if (a.elements.len() == 0) { return "array"; }
            var et: string = infer_expr_type(a.elements[0], s);
            if (et == "string") { return "array_string"; }
            if (et == "i32" || et == "bool") { return "array_i32"; }
            return "array";
        },
        parser.ExprTuple(_) => { return "tuple"; },
        parser.ExprStructLit(_) => { return "struct"; },
        parser.ExprLambda(lm) => {
            // Encode the return type in the tag so a later
            // `f()` call site can recover it from the local's
            // recorded type. The closure-box itself is just an
            // 8-byte pointer regardless of return shape, so
            // capture / call machinery is unaffected; this is
            // purely for the type-aware dispatch on the result
            // (e.g. `print(f())` needs to know the result is a
            // string to route through `__fern_print_str`).
            return "fn_" + ret_tag_of(lm.ret_type);
        },
        parser.ExprIdent(id) => {
            if (id.name == "None") { return "option:unknown"; }
            if (s.has_local(id.name)) { return s.local_type_of(id.name); }
            // A bare ident may name a zero-arg function (a `const`).
            var cfi: i32 = 0;
            while (cfi < s.funcs.len()) {
                if (s.funcs[cfi].name == id.name && s.funcs[cfi].receiver_type.len() == 0 && s.funcs[cfi].params.len() == 0) {
                    return ret_tag_of(s.funcs[cfi].ret_type);
                }
                cfi = cfi + 1;
            }
            return s.local_type_of(id.name);
        },
        parser.ExprBinary(b) => {
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">="
                    || b.op == "==" || b.op == "!=" || b.op == "&&" || b.op == "||") {
                return "bool";
            }
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                var lt: string = infer_expr_type(b.left, s);
                var rt: string = infer_expr_type(b.right, s);
                if (lt == "string" || rt == "string") { return "string"; }
                if (lt == "f64" || rt == "f64") { return "f64"; }
                return "i32";
            }
            return "i32";
        },
        parser.ExprUnary(u) => {
            if (u.op == "!") { return "bool"; }
            if (u.op == "-") { return infer_expr_type(u.operand, s); }
            if (u.op.len() >= 3 && u.op[0:3] == "as_") {
                var ct: string = u.op[3:u.op.len()];
                if (ct == "f64" || ct == "f32" || ct == "float") { return "f64"; }
                return "i32";
            }
            return "i32";
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (id.name == "Some" && c.args.len() == 1) {
                        return "option:" + infer_expr_type(c.args[0], s);
                    }
                    if (id.name == "Ok" && c.args.len() == 1) {
                        return "result:" + infer_expr_type(c.args[0], s);
                    }
                    if (id.name == "Err" && c.args.len() == 1) { return "result:unknown"; }
                    if (id.name == "read_file") { return "result:string"; }
                    if (id.name == "write_file") { return "option:unknown"; }
                    // now_unix_ms / monotonic_ns return i64. The self-host
                    // has no distinct i64 tag — integers live in 64-bit x0
                    // slots and compare via cmp — so "i32" routes them
                    // through the integer path without truncation.
                    if (id.name == "now_unix_ms") { return "i32"; }
                    if (id.name == "monotonic_ns") { return "i32"; }
                    // See asm.fern for rationale.
                    if (id.name == "sleep_ms") { return "i32"; }
                    if (id.name == "remove_file") { return "option:unknown"; }
                    // subprocess(cmd, args, stdin) → ProcessResult struct.
                    // See asm.fern: returns "unknown" because the struct's
                    // fields resolve through the shape-pointer dispatch path
                    // (parser.inject_builtin_enums injects the decl).
                    if (id.name == "subprocess") { return "unknown"; }
                    if (id.name == "temp_dir") { return "result:string"; }
                    if (id.name == "read_dir") { return "result:array_string"; }
                    if (id.name == "stat") { return "result:unknown"; }
                    if (id.name == "remove_dir_all") { return "option:unknown"; }
                    if (id.name == "f64_bits" || id.name == "f32_bits") { return "i32"; }
                    if (id.name == "f64_from_bits" || id.name == "f32_from_bits") { return "f64"; }
                    // env(name): Option[string] — Some(value) if the
                    // variable is set (including empty), None otherwise.
                    if (id.name == "env") { return "option:string"; }
                    if (id.name == "len") { return "i32"; }
                    if (id.name == "read_int") { return "i32"; }
                    if (id.name == "read_line") { return "string"; }
                    if (id.name == "read_all_stdin") { return "string"; }
                    if (id.name == "i32_to_string") { return "string"; }
                    if (id.name == "int__int_to_string") { return "string"; }
                    if (id.name == "str_to_i32") { return "i32"; }
                    if (id.name == "str_starts_with") { return "bool"; }
                    if (id.name == "str_ends_with") { return "bool"; }
                    if (id.name == "str_contains") { return "bool"; }
                    if (id.name == "str_index_of") { return "i32"; }
                    if (id.name == "str_trim") { return "string"; }
                    if (id.name == "str_to_upper") { return "string"; }
                    if (id.name == "str_to_lower") { return "string"; }
                    if (id.name == "str_repeat") { return "string"; }
                    if (id.name == "str_replace") { return "string"; }
                    if (id.name == "chr") { return "string"; }
                    if (id.name == "exit") { return "i32"; }
                    if (id.name == "args_count") { return "i32"; }
                    if (id.name == "arg_at") { return "string"; }
                    if (id.name == "args") { return "array_string"; }
                    if (id.name == "__alloc_u8") { return "array_i32"; }
                    if (id.name == "string_from_bytes") { return "string"; }
                    if (id.name == "random_bytes") { return "string"; }
                    if (id.name == "map_new") { return "map:unknown"; }
                    if (id.name == "map_new_i32") { return "mapI:unknown"; }
                    if (id.name == "__abs_f64" || id.name == "__sqrt_f64"
                            || id.name == "__floor_f64" || id.name == "__ceil_f64"
                            || id.name == "__trunc_f64" || id.name == "__round_f64"
                            || id.name == "__sin_f64" || id.name == "__cos_f64"
                            || id.name == "__exp_f64" || id.name == "__log_f64"
                            || id.name == "__pow_f64") {
                        return "f64";
                    }
                    if (id.name == "str_split") { return "array_string"; }
                    // Local-callee path: when `f()` invokes a
                    // local var that was bound to a lambda, its
                    // recorded type is `fn_<ret>` (see the
                    // ExprLambda match arm above). Strip the
                    // prefix so downstream dispatch (`print(f())`,
                    // string concat, etc.) sees the actual return
                    // type rather than `"unknown"`.
                    if (s.has_local(id.name)) {
                        var lt: string = s.local_type_of(id.name);
                        if (lt == "fn_string") { return "string"; }
                        if (lt == "fn_i32") { return "i32"; }
                        if (lt == "fn_bool") { return "bool"; }
                        if (lt == "fn_array_string") { return "array_string"; }
                        if (lt == "fn_array_i32") { return "array_i32"; }
                    }
                    var fi: i32 = 0;
                    while (fi < s.funcs.len()) {
                        if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
                            return ret_tag_of(s.funcs[fi].ret_type);
                        }
                        fi = fi + 1;
                    }
                    return "unknown";
                },
                parser.ExprFieldAccess(fa) => {
                    var rt: string = infer_expr_type(fa.obj, s);
                    if (fa.field == "read_chunk") { return "option:string"; }
                    if (is_map(rt) && fa.field == "get") {
                        return "option:" + map_value_part(rt);
                    }
                    if (is_map(rt) && fa.field == "get_or") {
                        return map_value_part(rt);
                    }
                    if (is_map(rt) && fa.field == "set") { return rt; }
                    if (is_map(rt) && fa.field == "has") { return "bool"; }
                    if (is_map(rt) && fa.field == "len") { return "i32"; }
                    if (is_map(rt) && fa.field == "keys") {
                        if (map_key_is_i32(rt)) { return "array_i32"; }
                        return "array_string";
                    }
                    if (is_map(rt) && fa.field == "values") {
                        var vt: string = map_value_part(rt);
                        if (vt == "i32") { return "array_i32"; }
                        if (vt == "string") { return "array_string"; }
                        return "array";
                    }
                    if (is_map(rt) && fa.field == "iter") {
                        return "mapiter:" + map_value_part(rt);
                    }
                    if (is_mapiter(rt) && fa.field == "has_next") { return "bool"; }
                    if (is_mapiter(rt) && fa.field == "key") { return "string"; }
                    if (is_mapiter(rt) && fa.field == "value") { return rt[8:rt.len()]; }
                    if ((is_int_tag(rt) || rt == "string") && fa.field == "to_string") {
                        return "string";
                    }
                    if ((rt == "f64" || rt == "f32" || rt == "float") && fa.field == "to_string") {
                        return "string";
                    }
                    if (rt == "i32" && (fa.field == "abs" || fa.field == "min" || fa.field == "max" || fa.field == "clamp" || fa.field == "pow" || fa.field == "sign" || fa.field == "to_lower" || fa.field == "to_upper" || fa.field == "gcd" || fa.field == "lcm")) {
                        return "i32";
                    }
                    if (rt == "i32" && fa.field == "to_ascii_string") {
                        return "string";
                    }
                    if (rt == "i32" && (fa.field == "is_even" || fa.field == "is_odd" || fa.field == "is_zero" || fa.field == "is_positive" || fa.field == "is_negative" || fa.field == "is_digit" || fa.field == "is_alpha" || fa.field == "is_letter" || fa.field == "is_alnum" || fa.field == "is_lower" || fa.field == "is_upper" || fa.field == "is_hex_digit")) {
                        return "bool";
                    }
                    if (fa.field == "len"
                            && (rt == "string" || is_int_array_tag(rt) || rt == "array_string" || rt == "array")) {
                        return "i32";
                    }
                    if (fa.field == "is_empty"
                            && (rt == "string" || is_int_array_tag(rt) || rt == "array_string" || rt == "array")) {
                        return "bool";
                    }
                    // `.push(x)` / `.reverse()` / `.concat(b)` return the same array type.
                    if ((fa.field == "push" || fa.field == "reverse" || fa.field == "concat")
                            && (is_int_array_tag(rt) || rt == "array_string" || rt == "array")) {
                        return rt;
                    }
                    // `.first()` / `.last()` return the element type.
                    if ((fa.field == "first" || fa.field == "last")
                            && (is_int_array_tag(rt) || rt == "array_string")) {
                        if (rt == "array_i32") { return "i32"; }
                        if (rt == "array_u32") { return "u32"; }
                        if (rt == "array_u64") { return "u64"; }
                        if (rt == "array_i64") { return "i64"; }
                        return "string";
                    }
                    // i32/string-array search methods.
                    if (rt == "array_i32" || rt == "array_string") {
                        if (fa.field == "index_of") { return "i32"; }
                        if (fa.field == "contains") { return "bool"; }
                    }
                    if (rt == "array_i32"
                            && (fa.field == "sum" || fa.field == "product")) {
                        return "i32";
                    }
                    // .min()/.max() on an i32 array → Option[i32] (None on
                    // empty); the Some payload is i32 (match_payload_type).
                    if (rt == "array_i32" && (fa.field == "min" || fa.field == "max")) {
                        return "option:i32";
                    }
                    if (rt == "array_string" && fa.field == "join") {
                        return "string";
                    }
                    // String methods that mirror existing builtins.
                    if (rt == "string") {
                        if (fa.field == "split") { return "array_string"; }
                        if (fa.field == "chars") { return "array_string"; }
                        if (fa.field == "lines") { return "array_string"; }
                        if (fa.field == "bytes") { return "array_i32"; }
                        if (fa.field == "as_bytes") { return "array_i32"; }
                        if (fa.field == "reverse") { return "string"; }
                        if (fa.field == "first_byte" || fa.field == "last_byte") { return "i32"; }
                        if (fa.field == "contains") { return "bool"; }
                        if (fa.field == "starts_with") { return "bool"; }
                        if (fa.field == "ends_with") { return "bool"; }
                        if (fa.field == "index_of") { return "i32"; }
                        if (fa.field == "trim") { return "string"; }
                        if (fa.field == "to_upper") { return "string"; }
                        if (fa.field == "to_lower") { return "string"; }
                        if (fa.field == "repeat") { return "string"; }
                        if (fa.field == "replace") { return "string"; }
                    }
                    if (rt == "string" || rt == "i32" || rt == "bool" || rt == "f64") {
                        var mi: i32 = 0;
                        while (mi < s.funcs.len()) {
                            if (s.funcs[mi].name == fa.field && s.funcs[mi].receiver_type == rt) {
                                return ret_tag_of(s.funcs[mi].ret_type);
                            }
                            mi = mi + 1;
                        }
                    }
                    // Method call on a struct receiver: resolve by
                    // method name alone (the coarse "struct" tag loses
                    // the receiver's name). Mirrors asm.fern.
                    var mj: i32 = 0;
                    while (mj < s.funcs.len()) {
                        if (s.funcs[mj].name == fa.field && s.funcs[mj].receiver_type.len() > 0) {
                            return ret_tag_of(s.funcs[mj].ret_type);
                        }
                        mj = mj + 1;
                    }
                    return "unknown";
                },
                _ => { return "unknown"; }
            }
            return "unknown";
        },
        parser.ExprIndex(x) => {
            // Container type drives element type:
            //   string → "i32" (byte)
            //   array_string → "string"
            //   array_u64 → "u64" (so element compares pick unsigned)
            //   array_u32 → "u32"; array_i64 → "i64"; else → "i32"
            var at: string = infer_expr_type(x.array, s);
            if (at == "string") { return "i32"; }
            if (at == "array_string") { return "string"; }
            if (at == "array_u64") { return "u64"; }
            if (at == "array_u32") { return "u32"; }
            if (at == "array_i64") { return "i64"; }
            return "i32";
        },
        parser.ExprSlice(sl) => { return infer_expr_type(sl.array, s); },
        parser.ExprFieldAccess(fa) => {
            // Resolve within the receiver's struct when its type is a
            // known struct name (match-bound variant payloads); else
            // fall back to the first-match field scan. See asm.fern.
            var frt: string = infer_expr_type(fa.obj, s);
            var di: i32 = 0;
            while (di < s.struct_decls.len()) {
                if (s.struct_decls[di].name == frt) {
                    return field_type_tag_in(frt, fa.field, s);
                }
                di = di + 1;
            }
            return field_type_tag(fa.field, s);
        },
        parser.ExprUnknown(_) => { return "unknown"; }
    }
    return "unknown";
}

