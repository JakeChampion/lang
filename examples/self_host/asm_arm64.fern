        s = s.write("    add x21, x21, x0\n");
        s = s.write("    add x20, x20, x0\n");
        s = s.write("    b .Lras_loop\n");
        s = s.write(".Lras_done:\n");
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __fern_alloc\n");
        s = s.write("    str x19, [x0]\n");
        s = s.write("    str x21, [x0, #8]\n");
        s = s.write("    ldr x21, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
