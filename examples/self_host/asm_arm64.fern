                        s = s.write("    ldr x0, [sp], #16\n");
                        s = s.write("    ldr x1, [x0, #8]\n");    // cursor
                        s = s.write("    ldr x2, [x0]\n");        // map
                        s = s.write("    ldr x2, [x2]\n");        // keys arr
