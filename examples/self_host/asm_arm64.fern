                            s = s.write("    ldr x0, [sp], #16\n");   // n
                            s = s.write("    bl __fern_i32_gcd\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            s = s.mark_heap();
                            return s;
                        }
