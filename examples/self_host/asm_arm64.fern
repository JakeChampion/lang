                    if (fa.field == "to_string" && c.args.len() == 0
                            && (prim_recv == "f64" || prim_recv == "f32" || prim_recv == "float")) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    ldr x0, [sp], #16\n");
                        s = s.write("    bl __fern_f64_to_string\n");
                        s = s.write("    str x0, [sp, #-16]!\n");
                        s = s.mark_heap();
