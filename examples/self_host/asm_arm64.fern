            if (name == "str_to_upper" && c.args.len() == 1) {
                s = emit_expr(c.args[0], s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    bl __fern_str_to_upper\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                s = s.mark_str_search();
                s = s.mark_heap();
                return s;
