                            // Computed as `(n>0) - (n<0)`.
                            s = emit_expr(fa.obj, s);
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    cmp x0, #0\n");
                            s = s.write("    cset x1, gt\n");
                            s = s.write("    cset x2, lt\n");
                            s = s.write("    sub x0, x1, x2\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                        if (fa.field == "is_even" && c.args.len() == 0) {
                            s = emit_expr(fa.obj, s);
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    and x0, x0, #1\n");
                            s = s.write("    eor x0, x0, #1\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
