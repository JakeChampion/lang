function (s: EmitState) lookup_local(name: string): i32 {
    var i: i32 = s.local_names.len() - 1;
    while (i >= 0) {
        if (s.local_names[i] == name) {
            return 0 - 8 * (i + 1);
        }
        i = i - 1;
    }
    return 0;
}

// frame_ldr / frame_str load/store `reg` at the x29-relative frame
// offset `off` (always <= 0 — locals live below the frame pointer,
// since sp moves with the operand-stack push/pop). A scaled ldr/str
// can't encode a negative offset and the unscaled (ldur/stur) form
// only reaches -256, so a frame with >32 slots overflows. When `off`
// is out of range, materialise the address in x16 (an AAPCS scratch
// register never live across a frame access here) via `sub` first.
function (s: EmitState) frame_ldr(reg: string, off: i32): EmitState {
    if (off >= 0 - 256) {
        return s.write("    ldr " + reg + ", [x29, #" + i32_to_string(off) + "]\n");
    }
    s = s.write("    sub x16, x29, #" + i32_to_string(0 - off) + "\n");
    return s.write("    ldr " + reg + ", [x16]\n");
}

function (s: EmitState) frame_str(reg: string, off: i32): EmitState {
    if (off >= 0 - 256) {
        return s.write("    str " + reg + ", [x29, #" + i32_to_string(off) + "]\n");
    }
    s = s.write("    sub x16, x29, #" + i32_to_string(0 - off) + "\n");
    return s.write("    str " + reg + ", [x16]\n");
}

function (s: EmitState) has_local(name: string): boolean {
    var i: i32 = 0;
    while (i < s.local_names.len()) {
        if (s.local_names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

struct LabelOut { state: EmitState, name: string }
function fresh_label(s: EmitState): LabelOut {
    var name: string = ".L" + i32_to_string(s.label_n);
    var ns: EmitState = EmitState {
