// Abstract counted-unit planning and independent replay before physical RC.
import "./ssa";
import "./ssasem";
import "./ssadeps";
import "./ssalive";
import "./semrecords";
import "./semtypes";
import "./typeinfo";

pub function value_mode(): i32 { return ssasem.value_mode(); }
pub function borrow_mode(): i32 { return ssasem.borrow_mode(); }
pub function counted_mode(): i32 { return ssasem.counted_mode(); }
pub function retain_unit(): i32 { return 1; }
pub function move_unit(): i32 { return 2; }
// A steal takes the unit from the record the value projects: at run time,
// when the record has no other holder, the field is nulled and its unit goes
// to the callee; otherwise the supply retains as any other. Chosen only where
// the record is this frame's own and read no further through that field
// (projection_root), so the null is seen by nothing but the record's own
// release, which skips it.
pub function steal_unit(): i32 { return 3; }
pub function entry_point(): i32 { return 0 - 1; }
pub function return_point(): i32 { return 0 - 2; }
pub function edge_point(): i32 { return 0 - 3; }

pub struct Supply { value: i32, slot: i32, mode: i32 }
// point is an instruction position, or entry/return/edge. target is a block
// id only for edges and -1 otherwise. All acquisitions execute before moves,
// the semantic operation then creates its result, and drops execute last.
//
// `hand_roots` / `hand_fields`, one per operand of a direct call: the record
// whose field the operand projects, or the parameter itself, when this frame
// reads it no further after the call (projection_root) and so hands the
// buffer on without a bracket; -1 otherwise. `hand_fields` is the field's
// index, or -1 for a parameter's own buffer — an array's, or a whole record
// parameter's, whose every field the callee may grow is handed with it.
pub struct Step { block: i32, point: i32, target: i32, supplies: Supply[], drops: i32[], hand_roots: i32[], hand_fields: i32[] }
// `grows` names, at an append's or a with's result, the record value whose
// field buffer the operation may grow or write IN PLACE (field_grow_root), or
// -1; `grow_fields` holds that field's index at the same position.
// `held` marks an element read that takes a unit of its own at the read
// (held_elements); the physical lowering retains what it read.
// `literal` marks the values that can only hold a string literal (`literals`).
pub struct Plan { ok: boolean, why: string, steps: Step[], owned: boolean[], literal: boolean[], grows: i32[], grow_fields: i32[], takes: i32[], held: boolean[], payloads: boolean[] }
struct Ledger { ok: boolean, why: string, bits: boolean[] }

// A callee parameter whose buffer the callee may grow in place: `field` is the
// index of a record parameter's array field, or -1 for an array parameter's
// own buffer. A caller still reading such an argument after the call holds a
// second count on the buffer across it, so the callee's push takes the copy
// (#4873, #8785).
pub struct GrowRow { callee: string, param: i32, field: i32 }

pub function grow_fields_of(rows: GrowRow[], callee: string, param: i32): i32[] {
    var out: i32[] = [];
    for row in rows {
        if (row.callee == callee && row.param == param && row.field >= 0) { out = out.append(row.field); }
    }
    return out;
}

function has_row(rows: GrowRow[], callee: string, param: i32, field: i32): boolean {
    for row in rows {
        if (row.callee == callee && row.param == param && row.field == field) { return true; }
    }
    return false;
}

// Whether two grow tables say the same thing about `callees`.
//
// A body reads this table only through `grow_fields_of(grows, ins.str, i)` in
// `ssarc.bracketed`, keyed by the name each call instruction names — so two
// tables that agree on the callees one body names produce that body
// identically, however much they differ elsewhere. That is what lets a second
// lowering keep a body the inference did not move.
pub function grow_rows_agree(a: GrowRow[], b: GrowRow[], callees: string[]): boolean {
    for row in a {
        if (names_has(callees, row.callee) && !has_row(b, row.callee, row.param, row.field)) { return false; }
    }
    for row in b {
        if (names_has(callees, row.callee) && !has_row(a, row.callee, row.param, row.field)) { return false; }
    }
    return true;
}

function names_has(names: string[], name: string): boolean {
    for n in names { if (n == name) { return true; } }
    return false;
}

function with_row(rows: GrowRow[], callee: string, param: i32, field: i32): GrowRow[] {
    if (has_row(rows, callee, param, field)) { return rows; }
    return rows.append(GrowRow { callee: callee, param: param, field: field });
}

// The rows this function's plan contributes, given the rows `table` already
// holds for its callees: one per borrowed parameter position an admitted
// in-place grow or write reaches, directly through an append or a with of its
// own, or through a buffer it hands on unbracketed to a callee whose row says
// that position may grow. A with on a buffer the plan did not admit copies,
// so it contributes no row. An owned parameter needs no caller bracket — its caller moved the
// unit in, or retained and so made the record's own count answer "shared".
pub function grow_rows(callee: string, f: ssasem.Func, p: Plan, table: GrowRow[]): GrowRow[] {
    var out: GrowRow[] = [];
    var defs: ssa.SInst[] = definitions(f);
    for b in f.graph.blocks {
        for ins in b.insts {
            if (ins.kind_tag != ssasem.append() && ins.kind_tag != ssasem.with()) { continue; }
            var root: i32 = ins.args[0];
            var field: i32 = 0 - 1;
            if (p.grows[ins.result] >= 0) { root = p.grows[ins.result]; field = p.grow_fields[ins.result]; }
            else if (ins.kind_tag == ssasem.with()) { continue; }
            if (defs[root].kind_tag != 6 || p.owned[root]) { continue; }
            out = with_row(out, callee, defs[root].imm, field);
        }
    }
    for s in p.steps {
        var i: i32 = 0;
        while (i < s.hand_roots.len()) {
            var root: i32 = s.hand_roots[i];
            if (root >= 0 && defs[root].kind_tag == 6 && !p.owned[root]) {
                var ins: ssa.SInst = f.graph.blocks[block_index(f.graph, s.block)].insts[s.point];
                if (is_record(f.values[root]) && s.hand_fields[i] < 0) {
                    // A whole record handed on: every field the callee may
                    // grow, this parameter may grow.
                    for field in grow_fields_of(table, ins.str, i) { out = with_row(out, callee, defs[root].imm, field); }
                } else if (has_row(table, ins.str, i, 0 - 1)) { out = with_row(out, callee, defs[root].imm, s.hand_fields[i]); }
            }
            i = i + 1;
        }
    }
    return out;
}

// Every produced body's rows, closed over the buffers handed on: a row only
// ever gains, so the rounds converge.
pub function grow_table(keys: string[], funcs: ssasem.Func[], plans: Plan[]): GrowRow[] {
    var table: GrowRow[] = [];
    var changed: boolean = true;
    while (changed) {
        changed = false;
        var i: i32 = 0;
        while (i < plans.len()) {
            if (plans[i].ok) {
                for row in grow_rows(keys[i], funcs[i], plans[i], table) {
                    if (!has_row(table, row.callee, row.param, row.field)) {
                        table = table.append(row);
                        changed = true;
                    }
                }
            }
            i = i + 1;
        }
    }
    return table;
}

function bad(why: string): Plan { return Plan { ok: false, why: why, steps: [], owned: [], literal: [], grows: [], grow_fields: [], takes: [], held: [], payloads: [] }; }
pub function refused(why: string): Plan { return bad(why); }
function rejected(why: string): Ledger { return Ledger { ok: false, why: why, bits: [] }; }
function step(block: i32, point: i32, target: i32): Step { return Step { block: block, point: point, target: target, supplies: [], drops: [], hand_roots: [], hand_fields: [] }; }
function bits(n: i32): boolean[] {
    var out: boolean[] = [];
    var i: i32 = 0;
    while (i < n) { out = out.append(false); i = i + 1; }
    return out;
}
function block_index(f: ssa.SFunc, id: i32): i32 {
    var i: i32 = 0;
    while (i < f.blocks.len()) { if (f.blocks[i].id == id) { return i; } i = i + 1; }
    return 0 - 1;
}
function successors(b: ssa.SBlock): i32[] {
    if (b.term.kind_tag == 2) { return [b.term.target]; }
    if (b.term.kind_tag == 3) {
        if (b.term.t == b.term.f) { return [b.term.t]; }
        return [b.term.t, b.term.f];
    }
    return [];
}
function supported_tuple(tup: typeinfo.TypeTuple, f: ssasem.Func): boolean {
    for t in tup.elements { if (!supported(t, f)) { return false; } }
    return true;
}
// The types this pass plans no unit for: the scalars, and the stream handles,
// which are a descriptor and so one of them.
// The types that carry no unit at all: the scalars, a stream handle, which is
// its descriptor, and a map cursor, whose block has no rc header. The cursor
// still has to outlive nothing and be outlived by its map, which the anchor on
// `ssasem.projects` states rather than the ledger.
function unit_free(t: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(_) = t { return true; }
    if let typeinfo.TypeBool(_) = t { return true; }
    if let typeinfo.TypeFloat(_) = t { return true; }
    if let typeinfo.TypeVoid(_) = t { return true; }
    return semtypes.is_handle(t) || semtypes.is_map_iter(t);
}
function supported(t: typeinfo.Type, f: ssasem.Func): boolean {
    if (unit_free(t)) { return true; }
    if let typeinfo.TypeString(_) = t { return true; }
    if let typeinfo.TypeFunc(_) = t { return true; }
    if let typeinfo.TypeDyn(_) = t { return true; }
    if let typeinfo.TypeArray(a) = t { return supported(a.elem, f); }
    if let typeinfo.TypeTuple(tup) = t { return supported_tuple(tup, f); }
    // A cell holds one unit of its own and one slot; no declaration names it.
    if (semtypes.is_cell(t)) { return supported(semtypes.cell_elem(t), f); }
    // A map holds one unit of its own and one of every key in its column, and
    // one of every value when that column is counted; only the shapes whose
    // release does that are admitted, and a column of boxes only when the box
    // itself is a value this pass plans.
    if (ssasem.is_map(t)) {
        if (!ssasem.is_supported_map(t)) { return false; }
        if (ssasem.keyed_map_key(ssasem.map_key(t)) && !supported(ssasem.map_key(t), f)) { return false; }
        return !ssasem.boxed_map_value(ssasem.map_value(t)) || supported(ssasem.map_value(t), f);
    }
    if let typeinfo.TypeStruct(_) = t { return semrecords.find(f.records, t) >= 0; }
    if let typeinfo.TypeUnion(_) = t { return semrecords.find_enum(f.enums, t) >= 0; }
    return false;
}
function mode_error(params: typeinfo.Type[], modes: i32[]): string {
    var i: i32 = 0;
    while (i < modes.len()) {
        if (ssasem.reference(params[i])) {
            if (modes[i] != borrow_mode() && modes[i] != counted_mode()) { return "reference parameter mode"; }
        } else if (modes[i] != value_mode()) { return "scalar parameter mode"; }
        i = i + 1;
    }
    return "";
}
// A callee's contract is held to the same representation and mode rules as
// this function's own parameters: its counted result is a fresh unit here.
function call_contract_error(c: ssasem.Contract, f: ssasem.Func): string {
    for t in c.params { if (!supported(t, f)) { return "unsupported counted-unit call parameter"; } }
    if (!supported(c.result, f)) { return "unsupported counted-unit call result"; }
    return mode_error(c.params, c.modes);
}
// Check the finite schema tables, not recursive nominal field expansion.
function schema_fields_error(f: ssasem.Func): string {
    for record in f.records {
        for field in record.fields {
            if (!supported(field.ty, f)) { return "unsupported counted record field"; }
        }
    }
    for e in f.enums {
        for v in e.variants {
            for field in v.fields { if (!supported(field.ty, f)) { return "unsupported counted variant field"; } }
        }
    }
    return "";
}
// A closure is dispatched through with no declaration in hand, so the units its
// arguments carry are read off the function TYPE the box hands out. A counted
// parameter is a CONSUMING slot and the type spells one with `own`: what
// ssasem.closure_type builds from these same modes is what every call through
// the box is checked against, so the two sides cannot disagree.
//
// The environment parameter is the box, which is lent like any other receiver
// and never appears in the type the box hands out, so a counted one there would
// be a promise nothing can state.
function closure_body_error(f: ssasem.Func, ins: ssa.SInst): string {
    var c: ssasem.Contract = f.calls[ssasem.find_contract(f.calls, ins.str)];
    if (c.modes.len() > 0 && c.modes[0] == counted_mode()) { return "function value consumes its environment"; }
    return "";
}

function function_ops_error(f: ssasem.Func): string {
    for b in f.graph.blocks {
        for ins in b.insts {
            if (ins.kind_tag == ssasem.closure_new()) {
                var why: string = closure_body_error(f, ins);
                if (why != "") { return why; }
            }
        }
    }
    return "";
}

function contract_error(f: ssasem.Func, modes: i32[]): string {
    if (modes.len() != f.params.len()) { return "parameter mode dimensions"; }
    for t in f.values { if (!supported(t, f)) { return "unsupported counted-unit type"; } }
    if (!supported(f.result, f)) { return "unsupported counted-unit result"; }
    var why: string = schema_fields_error(f);
    if (why != "") { return why; }
    for c in f.calls {
        why = call_contract_error(c, f);
        if (why != "") { return why; }
    }
    why = function_ops_error(f);
    if (why != "") { return why; }
    return mode_error(f.params, modes);
}
// A construction, a closure box, a call result, a phi, a string constant and a
// binary operator's result are fresh; only a reference-typed one is a unit of
// this function's own (a string concatenation), so a scalar operator's result
// is never owned. A projection or a copy borrows its source.
// A closure box is a construction too: it owns one unit per reference capture,
// released when the box is. So is a cell, over its one element; a read of a
// cell hands out a unit of the element rather than borrowing the slot.
function construction(kind: i32): boolean {
    return kind == ssasem.array_new() || kind == ssasem.tuple_new() || kind == ssasem.record_new() || kind == ssasem.variant_new() || kind == ssasem.dyn_box()
        || kind == ssasem.closure_new() || kind == ssasem.cell_new() || kind == ssasem.map_new()
        || kind == ssasem.map_cleared();
}
// The operand types a construction takes a unit of: every reference, without
// exception. A closure box used to BORROW a captured function value, secured
// by requiring the capture to be a borrowed parameter so its owner outlived
// the box. That rule could not describe a box that escapes: a local function
// value captured into a returned box is owned by a frame that is going away,
// and the box never took it, so nobody freed it (#9637). The box owns it now,
// and its release walks the field (ssarc.walked) — which a frame that never
// built the box can do, because `semsource.env_rows` pairs every environment
// a value of that type could carry with the type itself, and the whole module
// contract table is what it reads.
//
// No `kind`: there is no construction with an exception any more.
function taken(t: typeinfo.Type): boolean {
    return ssasem.reference(t);
}

// A zero is a unit this frame holds, not one it allocated: at a reference type
// it is the null word, so the release it owes is the null guard every drop
// helper carries, and the replacement the declaration site assigns drops
// exactly that nothing. It is deliberately NOT a `construction` — no box was
// made, so nothing may take a field out of one.
//
// A string literal (kind 5) is not a unit either: its static box carries the
// immortal count on every backend, so it is never released, and a consumer
// that takes one is handed it with no retain (`literal`).
function fresh_unit(kind: i32): boolean {
    return kind == 8 || kind == 9 || kind == ssasem.zero() || construction(kind) || hands_out(kind);
}
// The operations whose result is a unit handed to this function: a call's
// result, a rebuilt container, a view's box, a cell's element, a map read,
// which retains what it answers because the value may come from the column or
// from the caller's default, a column snapshot, which semsource admits only
// where the runtime hands back a copy the frame owns whole, and a delete,
// whose tuple is fresh and holds the map the receiver handed over.
function hands_out(kind: i32): boolean {
    return kind == ssasem.call() || kind == ssasem.call_value() || kind == ssasem.closure_new()
        || kind == ssasem.append() || kind == ssasem.with() || kind == ssasem.slice() || kind == ssasem.cell_get()
        || kind == ssasem.map_insert() || kind == ssasem.map_get_or() || kind == ssasem.map_get()
        || kind == ssasem.map_keys() || kind == ssasem.map_values() || kind == ssasem.map_delete()
        || kind == ssasem.str_bytes() || kind == ssasem.arr_join() || kind == ssasem.arr_slice();
}
// A phi is a literal too when every operand is: assumed of every phi, then
// withdrawn from each one with another operand, to a fixpoint, so a loop
// phi that only ever carries literals keeps the mark.
function literals(f: ssasem.Func): boolean[] {
    var out: boolean[] = bits(f.graph.nvals);
    for b in f.graph.blocks {
        for ins in b.insts { if (ins.kind_tag == 5 || ins.kind_tag == 8) { out = out.with(ins.result, true); } }
    }
    var changed: boolean = true;
    while (changed) {
        changed = false;
        for b in f.graph.blocks {
            for ins in b.insts {
                if (ins.kind_tag != 8 || !out[ins.result]) { continue; }
                var lit: boolean = true;
                for a in ins.args { if (a < 0 || !out[a]) { lit = false; } }
                if (!lit) { out = out.with(ins.result, false); changed = true; }
            }
        }
    }
    return out;
}

function owned_values(f: ssasem.Func, modes: i32[]): boolean[] {
    var out: boolean[] = bits(f.graph.nvals);
    for b in f.graph.blocks {
        for ins in b.insts {
            var owns: boolean = false;
            if (ins.kind_tag == 6) { owns = modes[ins.imm] == counted_mode(); }
            if (ins.kind_tag != 8 && fresh_unit(ins.kind_tag)) { owns = ssasem.reference(f.values[ins.result]); }
            out = out.with(ins.result, owns);
        }
    }
    return phi_ownership(f, out);
}

// A phi owns a unit unless every operand is lent whole: a borrowed parameter,
// a string literal, or another phi that is. Such a phi holds nothing its edges could supply --
// asking them retains a view with a no-op and releases it with a free
// (#9802), and retains a counted box for nothing. Any other operand makes the
// phi owned as before: a projection of an owned record is anchored to its
// root, and the retain the edge supplies is what keeps the child alive past
// the root's release. To a fixpoint, since ownership reaches a phi through a
// phi.
function phi_ownership(f: ssasem.Func, owned: boolean[]): boolean[] {
    var defs: ssa.SInst[] = definitions(f);
    var out: boolean[] = owned;
    for b in f.graph.blocks {
        for ins in b.insts {
            if (ins.kind_tag != 8 || !ssasem.reference(f.values[ins.result])) { continue; }
            var lent: boolean = true;
            for a in ins.args {
                if (a < 0) { continue; }
                if (defs[a].kind_tag == 8 || defs[a].kind_tag == 5) { continue; }
                if (defs[a].kind_tag == 6 && !out[a]) { continue; }
                lent = false;
            }
            if (!lent) { out = out.with(ins.result, true); }
        }
    }
    var grown: boolean = true;
    while (grown) {
        grown = false;
        for b in f.graph.blocks {
            for ins in b.insts {
                if (ins.kind_tag != 8 || out[ins.result] || !ssasem.reference(f.values[ins.result])) { continue; }
                for a in ins.args {
                    if (a >= 0 && out[a]) { out = out.with(ins.result, true); grown = true; }
                }
            }
        }
    }
    return out;
}

// A view is lent, never retained: its box carries the immortal sentinel
// rather than a count, so the retain the runtime would emit is a no-op while
// the release that balances it frees the box (#9802). A supply that MOVES a
// view is fine, the one unit changes hands; one that retains it, because the
// value stays live past the step, would give back a unit nothing took: a
// phi merging a live view with a fresh one released the live one from
// under its holder. `ssarc`'s #9328 note is the same asymmetry at the call
// bracket, which it restricts to arrays.
//
// A string retagged as a view is the string's own counted box, so retaining
// it retains the string, which `__fern_str_view_free` then releases as one.
// A literal's retain is never emitted (ssarc.supplies), so it lends nothing.
function view_retain_error(f: ssasem.Func, steps: Step[], literal: boolean[]): string {
    var defs: ssa.SInst[] = definitions(f);
    for s in steps {
        for item in s.supplies {
            if (item.mode == retain_unit() && ssasem.is_view(f.values[item.value]) && !retagged_string(f, defs, item.value) && !literal[item.value]) { return "a view is lent, never retained"; }
        }
    }
    return "";
}

function retagged_string(f: ssasem.Func, defs: ssa.SInst[], v: i32): boolean {
    var d: ssa.SInst = defs[v];
    return d.kind_tag == ssasem.str_as() && d.args.len() == 1 && !ssasem.is_view(f.values[d.args[0]]);
}

// A unit whose release would reach a dyn value of an open type
// (`ssasem.Func.open_dyns`) is refused rather than released without the
// children of a generic implementation.
function open_dyn_error(f: ssasem.Func, owned: boolean[]): string {
    if (f.open_dyns.len() == 0) { return ""; }
    var v: i32 = 0;
    while (v < f.graph.nvals) {
        if (owned[v] && reaches_open_dyn(f, f.values[v], [])) { return "a dyn value over a generic implementation is lent, never owned"; }
        v = v + 1;
    }
    return "";
}

function reaches_open_dyn(f: ssasem.Func, t: typeinfo.Type, seen: string[]): boolean {
    if (ssasem.is_dyn(t)) {
        for o in f.open_dyns { if (semtypes.equal(o, t)) { return true; } }
        return false;
    }
    var key: string = ssasem.type_key(t);
    for k in seen { if (k == key) { return false; } }
    seen = seen.append(key);
    var parts: typeinfo.Type[] = [];
    if let typeinfo.TypeArray(a) = t { parts = parts.append(a.elem); }
    if let typeinfo.TypeTuple(tup) = t { parts = tup.elements; }
    if let typeinfo.TypeMap(m) = t { parts = [m.key, m.value]; }
    if (semtypes.is_cell(t)) { parts = parts.append(semtypes.cell_elem(t)); }
    if let typeinfo.TypeUnion(u) = t { parts = u.args; }
    var ri: i32 = semrecords.find(f.records, t);
    if (ri >= 0) { for field in f.records[ri].fields { parts = parts.append(field.ty); } }
    var ei: i32 = semrecords.find_enum(f.enums, t);
    if (ei >= 0) {
        for variant in f.enums[ei].variants {
            for field in variant.fields { parts = parts.append(field.ty); }
        }
    }
    for p in parts { if (reaches_open_dyn(f, p, seen)) { return true; } }
    return false;
}

function live_out_row(flow: ssalive.Flow, bi: i32, n: i32): boolean[] {
    var out: boolean[] = bits(n);
    for v in ssalive.live_out_ids(flow, bi) { out = out.with(v, true); }
    return out;
}
function add_use(own live: boolean[], value: i32, deps: i32[][]): boolean[] {
    if (value < 0) { return live; }
    live = live.with(value, true);
    for dep in deps[value] { live = live.with(dep, true); }
    return live;
}
// A construction takes one unit per reference operand, function values
// included: the closure box that used to borrow its captures of that type now
// owns them (#9637). A call takes one per counted parameter; a borrowed parameter
// only reads the caller's unit. An append or a with takes one for its
// receiver, which a receiver this function does not own reaches by retaining;
// a cell write takes one for the element it stores and reads the cell. A map
// insert takes one for the receiver it hands back and one for the key its
// column holds until the map is released, and one for the value when that
// column is counted too. A delete takes one for the receiver it hands back
// inside its tuple and only COMPARES the key, whose unit stays with the
// caller.
function operation_supplies(f: ssasem.Func, ins: ssa.SInst): Supply[] {
    var out: Supply[] = [];
    var counted: boolean[] = [];
    if (ins.kind_tag == ssasem.call()) {
        counted = call_supplied(f, ins);
    } else if (ins.kind_tag == ssasem.call_value()) {
        counted = call_value_supplied(f, ins);
    } else if (ins.kind_tag == ssasem.cell_set()) {
        counted = [false, ssasem.reference(f.values[ins.args[1]])];
    } else if (ins.kind_tag == ssasem.map_insert()) {
        counted = [true, ssasem.reference(f.values[ins.args[1]]), ssasem.reference(f.values[ins.args[2]])];
    } else if (ins.kind_tag == ssasem.map_delete()) {
        counted = [true, false];
    } else if (ins.kind_tag == ssasem.append()) {
        counted = [true, ssasem.reference(f.values[ins.args[1]])];
    } else if (ins.kind_tag == ssasem.with()) {
        counted = [true, false, ssasem.reference(f.values[ins.args[2]])];
    } else if (construction(ins.kind_tag)) {
        for arg in ins.args { counted = counted.append(taken(f.values[arg])); }
    }
    var i: i32 = 0;
    while (i < counted.len()) {
        if (counted[i]) { out = out.append(Supply { value: ins.args[i], slot: i, mode: 0 }); }
        i = i + 1;
    }
    return out;
}
// An indirect call LENDS every reference it is handed except at a slot the
// function type spells CONSUMING, `own T`. The callee box itself (operand 0)
// is lent like any other.
function call_value_supplied(f: ssasem.Func, ins: ssa.SInst): boolean[] {
    var out: boolean[] = [false];
    var callee: typeinfo.Type = f.values[ins.args[0]];
    var params: typeinfo.Type[] = ssasem.func_params(callee);
    var i: i32 = 0;
    while (i < params.len()) {
        out = out.append(ssasem.func_param_own(callee, i) && ssasem.reference(f.values[ins.args[i + 1]]));
        i = i + 1;
    }
    return out;
}

function call_supplied(f: ssasem.Func, ins: ssa.SInst): boolean[] {
    var c: ssasem.Contract = f.calls[ssasem.find_contract(f.calls, ins.str)];
    var out: boolean[] = [];
    var i: i32 = 0;
    while (i < ins.args.len()) {
        out = out.append(c.modes[i] == counted_mode() && ssasem.reference(f.values[ins.args[i]]));
        i = i + 1;
    }
    return out;
}
// The callee's declared mode at each operand of a direct call, for a caller
// deciding which arguments its bracket covers. `call_supplied` reads the same
// contract for the ledger; this is the whole row rather than the counted half.
pub function callee_modes(f: ssasem.Func, ins: ssa.SInst): i32[] {
    var at: i32 = ssasem.find_contract(f.calls, ins.str);
    if (at < 0) { return []; }
    return f.calls[at].modes;
}

// An unreachable end (kind 4) supplies nothing and, like a return, releases
// every unit the frame still holds at its step.
function return_supplies(f: ssasem.Func, b: ssa.SBlock): Supply[] {
    if (b.term.kind_tag == 1 && b.term.value >= 0 && ssasem.reference(f.values[b.term.value])) { return [Supply { value: b.term.value, slot: 0, mode: 0 }]; }
    return [];
}
// The edge from b into the block at position si.
function edge_supplies(f: ssasem.Func, b: ssa.SBlock, si: i32, owned: boolean[]): Supply[] {
    var succ: ssa.SBlock = f.graph.blocks[si];
    var pi: i32 = 0;
    while (succ.preds[pi] != b.id) { pi = pi + 1; }
    var out: Supply[] = [];
    var i: i32 = 0;
    for ins in succ.insts {
        if (ins.kind_tag == 8 && owned[ins.result]) { out = out.append(Supply { value: ins.args[pi], slot: i, mode: 0 }); }
        i = i + 1;
    }
    return out;
}

function definitions(f: ssasem.Func): ssa.SInst[] {
    var none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
    var out: ssa.SInst[] = [];
    var i: i32 = 0;
    while (i < f.graph.nvals) { out = out.append(none); i = i + 1; }
    for b in f.graph.blocks {
        for ins in b.insts { if (ins.result >= 0 && ins.result < out.len()) { out = out.with(ins.result, ins); } }
    }
    return out;
}

function is_record(t: typeinfo.Type): boolean {
    if let typeinfo.TypeStruct(_) = t { return true; }
    return false;
}

// A value reached through another: a copy, a projection, or a retag.
function projection(kind: i32): boolean {
    return kind == 7 || kind == ssasem.array_get() || kind == ssasem.tuple_get() || kind == ssasem.record_get()
        || kind == ssasem.variant_get() || kind == ssasem.variant_up() || kind == ssasem.variant_as()
        || kind == ssasem.slice() || kind == ssasem.str_as() || kind == ssasem.dyn_up();
}

// Whether reading `arg` reads `w`: the value itself, or one anchored to it.
function reads(a: ssasem.Analysis, arg: i32, w: i32): boolean {
    if (arg < 0) { return false; }
    if (arg == w) { return true; }
    for dep in a.dependencies[arg] { if (dep == w) { return true; } }
    return false;
}

// Whether `w` is read after position `pos` of block `bi`: by a later
// instruction, by the terminator, or on the way out of the block.
function used_after(f: ssasem.Func, a: ssasem.Analysis, bi: i32, pos: i32, w: i32): boolean {
    var b: ssa.SBlock = f.graph.blocks[bi];
    if (ssalive.live_out_has(a.flow, bi, w)) { return true; }
    var i: i32 = pos + 1;
    while (i < b.insts.len()) {
        for arg in b.insts[i].args { if (reads(a, arg, w)) { return true; } }
        i = i + 1;
    }
    if (b.term.kind_tag == 1 && reads(a, b.term.value, w)) { return true; }
    if (b.term.kind_tag == 3 && reads(a, b.term.cond, w)) { return true; }
    return false;
}

// The projection of `root` that `w` reaches it through: `w` itself when its
// parent is the root, else the chain element just before the root.
function first_hop(a: ssasem.Analysis, w: i32, root: i32): i32 {
    var prev: i32 = w;
    for dep in a.dependencies[w] {
        if (dep == root) { return prev; }
        prev = dep;
    }
    return 0 - 1;
}

function other_field_get(ins: ssa.SInst, root: i32, field: i32): boolean {
    return ins.kind_tag == ssasem.record_get() && ins.args[0] == root && ins.imm != field;
}

// The record whose field the projection `v` names, when this frame reads
// that field no further after the instruction at (`bi`, `pos`), or -1. The
// record is one this frame holds as a parameter or owns outright, and after
// the instruction it is read only through projections of its OTHER fields —
// the functional update `R { ...r, xs: f(r.xs) }` — with nothing anchored to
// the projected field, and nothing anchored to the record any other way,
// still live. The record must not leave the block either, so a loop that
// reaches the same record again is refused; a loop-carried record is a fresh
// phi each round.
//
// What this proves is that THIS frame never reads the field again, so the
// buffer may be grown in place by the instruction, or by a callee it is
// handed to without a bracket. Whether another holder reads it is answered at
// run time — the record's own count, when it is shared — and by the
// caller-side bracket (`grow_rows`) for the frame that lent the record and
// still reads it.
function projection_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, v: i32): i32 {
    var none: i32 = 0 - 1;
    var get: ssa.SInst = defs[v];
    if (get.kind_tag != ssasem.record_get()) { return none; }
    var root: i32 = get.args[0];
    if (!is_record(f.values[root]) || semtypes.is_env(f.values[root])) { return none; }
    if (defs[root].kind_tag != 6 && !owned[root]) { return none; }
    if (projection(defs[root].kind_tag)) { return none; }
    var b: ssa.SBlock = f.graph.blocks[bi];
    if (ssalive.live_out_has(a.flow, bi, root)) { return none; }
    var i: i32 = pos + 1;
    while (i < b.insts.len()) {
        var later: ssa.SInst = b.insts[i];
        var mentions: boolean = false;
        for arg in later.args { if (arg == root) { mentions = true; } }
        if (mentions && !other_field_get(later, root, get.imm)) { return none; }
        i = i + 1;
    }
    if (b.term.kind_tag == 1 && b.term.value == root) { return none; }
    var w: i32 = 0;
    while (w < f.graph.nvals) {
        if (w != root && reads(a, w, root) && used_after(f, a, bi, pos, w)) {
            var hop: i32 = first_hop(a, w, root);
            if (hop < 0 || !other_field_get(defs[hop], root, get.imm)) { return none; }
        }
        w = w + 1;
    }
    return root;
}

function other_tuple_get(ins: ssa.SInst, root: i32, field: i32): boolean {
    return ins.kind_tag == ssasem.tuple_get() && ins.args.len() == 1 && ins.args[0] == root && ins.imm != field;
}

// A source whose box this frame ALLOCATED, so nulling a slot in it is invisible
// to everyone else. The take nulls without asking, so this is the whole of its
// safety: owning a unit is not enough, the box has to be the frame's alone.
//
// Only two kinds of instruction can define a TUPLE and qualify:
//
//   - a construction — `tuple_new` builds the box here, refcount 1;
//   - `map_delete`, whose result is the fresh two-word box the runtime
//     allocates to pair the map with whether the key was there.
//
// Everything else that can define a tuple hands back a box someone else still
// names, and is excluded:
//
//   - a counted PARAMETER. `own` transfers ONE unit, not exclusive ownership,
//     so the box may have other holders. `steal` next door admits a parameter
//     root only because it pays for it with a runtime `__fern_rc_is_unique`
//     test before nulling; the take does not test.
//   - `cell_get` and `map_get_or`, which RETAIN what they read (`cell_read`'s
//     and `map_op`'s `__fern_rc_inc`) — the cell and the map's value column
//     still hold the box, and a counted column may hold a tuple, so nulling
//     here would show up in every later read through the container.
//   - a CALL result, whose exclusivity this boundary cannot establish: a callee
//     may return a retained alias of something it goes on holding.
//   - a phi, because one of its incoming edges may be any of the above.
//
// The other `hands_out` operations answer an array, a map, an Option or a
// closure box and so can never be a take's source; naming them here would
// suggest a judgement about them that this predicate does not make.
function takeable_root(kind: i32): boolean {
    return construction(kind) || kind == ssasem.map_delete();
}

// The element index a tuple read at (`bi`, `pos`) TAKES rather than borrows,
// or -1. A projection borrows by default, so a consuming use of what it read
// owes a retain — and a map box carries no count to retain, which is what made
// a map read back out of a tuple impossible to use again (#9555).
//
// It takes when the source is a unit of this frame's own, dies at this read,
// and is reached after it only through reads of its OTHER elements. The
// element's unit then becomes the frame's for nothing: the physical lowering
// nulls the slot, and the source's own drop — in this same step, since it dies
// here — walks past the null rather than releasing what the frame now holds.
//
// Same shape as `projection_root` above and the same reasoning, over a tuple
// rather than a record, and over the whole source rather than one field: a
// tuple has no functional-update form, so a later read through another element
// is the only way the source may still be mentioned.
function tuple_take_field(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
    var none: i32 = 0 - 1;
    var ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
    if (ins.kind_tag != ssasem.tuple_get()) { return none; }
    // This runs BEFORE the graph is verified, so a malformed instruction has
    // to answer "no take" rather than read past the end of its own operands.
    if (ins.args.len() != 1) { return none; }
    if (ins.result < 0 || ins.result >= f.graph.nvals) { return none; }
    var root: i32 = ins.args[0];
    if (root < 0 || root >= f.graph.nvals || root >= owned.len() || root >= defs.len()) { return none; }
    if (!ssasem.reference(f.values[ins.result])) { return none; }
    if (!owned[root] || !takeable_root(defs[root].kind_tag)) { return none; }
    var b: ssa.SBlock = f.graph.blocks[bi];
    if (ssalive.live_out_has(a.flow, bi, root)) { return none; }
    var i: i32 = pos + 1;
    while (i < b.insts.len()) {
        var later: ssa.SInst = b.insts[i];
        var mentions: boolean = false;
        for arg in later.args { if (arg == root) { mentions = true; } }
        if (mentions && !other_tuple_get(later, root, ins.imm)) { return none; }
        i = i + 1;
    }
    if (b.term.kind_tag == 1 && b.term.value == root) { return none; }
    if (b.term.kind_tag == 3 && b.term.cond == root) { return none; }
    var w: i32 = 0;
    while (w < f.graph.nvals) {
        if (w != root && w != ins.result && reads(a, w, root) && used_after(f, a, bi, pos, w)) {
            var hop: i32 = first_hop(a, w, root);
            if (hop != ins.result && (hop < 0 || !other_tuple_get(defs[hop], root, ins.imm))) { return none; }
        }
        w = w + 1;
    }
    return ins.imm;
}

// The element each tuple read takes, indexed by the read's result value, and
// -1 where it borrows. Computed before the step walk because the walk runs
// BACKWARDS: a taken element is a unit of the frame's own, and the consuming
// use that moves it is reached before the read that produced it.
function tuple_takes(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[]): i32[] {
    var out: i32[] = [];
    var vi: i32 = 0;
    while (vi < f.graph.nvals) { out = out.append(0 - 1); vi = vi + 1; }
    var bi: i32 = 0;
    while (bi < f.graph.blocks.len()) {
        var pos: i32 = 0;
        while (pos < f.graph.blocks[bi].insts.len()) {
            var field: i32 = tuple_take_field(f, a, owned, defs, bi, pos);
            if (field >= 0) { out = out.with(f.graph.blocks[bi].insts[pos].result, field); }

            pos = pos + 1;
        }
        bi = bi + 1;
    }
    return out;
}

// What a take changes about the plan's inputs, derived once so the planner and
// the independent replay below reach it the same way: the element becomes a
// unit of this frame's own, and it stops being ANCHORED to the tuple it came
// out of — the source is released in the same step, and leaving the dependency
// would read every later use of the element as a borrow outliving its
// container. A payload take says the same about an enum box's payload.
// `reflow` marks a take whose box is released alone (`shell_root`): that box
// has to die at the read, which the flow derived before the take cannot say.
struct Units { owned: boolean[], deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[], reflow: boolean }

// The payload takes are derived FIRST and folded into ownership before the
// other two run: a taken payload is a unit of this frame's own, and the tuple
// takes and the element holds both ask whether the value they read through is
// owned. Deriving them against the base instead reads a taken payload as a
// borrow, and an element read of one then pins the array it came out of
// rather than taking its own unit — which is the whole of what a hold exists
// to prevent (#9891).
function units_of(f: ssasem.Func, base: boolean[], a: ssasem.Analysis, defs: ssa.SInst[]): Units {
    var payloads: boolean[] = payload_takes(f, a, base, defs);
    var owned: boolean[] = base;
    var i: i32 = 0;
    while (i < payloads.len()) {
        if (payloads[i]) { owned = owned.with(i, true); }
        i = i + 1;
    }
    var takes: i32[] = tuple_takes(f, a, owned, defs);
    var held: boolean[] = held_elements(f, a, owned, defs);
    var deps: i32[][] = a.dependencies;
    var reflow: boolean = false;
    i = 0;
    while (i < takes.len()) {
        if (payloads[i] && option_layout(f, f.values[defs[i].args[0]])) { reflow = true; }
        if (takes[i] >= 0 || held[i] || payloads[i]) {
            owned = owned.with(i, true);
            // A view's bytes are its source's, not the box's it came out of, so
            // a taken view stays anchored to what the box was.
            var chain: i32[] = [];
            if ((takes[i] >= 0 || payloads[i]) && ssasem.is_view(f.values[i])) { chain = a.dependencies[defs[i].args[0]]; }
            deps = deps.with(i, chain);
        }
        i = i + 1;
    }
    if (reflow) { deps = through_takes(deps, takes, held, payloads); }
    return Units { owned: owned, deps: deps, takes: takes, held: held, payloads: payloads, reflow: reflow };
}

// A value read through one that became a unit of its own reaches the storage
// behind it only through that unit's new chain, so every chain stops at the
// first such value and continues with its chain.
function through_takes(deps: i32[][], takes: i32[], held: boolean[], payloads: boolean[]): i32[][] {
    var out: i32[][] = deps;
    var w: i32 = 0;
    while (w < deps.len()) {
        var chain: i32[] = [];
        for d in deps[w] {
            chain = chain.append(d);
            if (takes[d] >= 0 || held[d] || payloads[d]) {
                for e in deps[d] { chain = chain.append(e); }
                break;
            }
        }
        out = out.with(w, chain);
        w = w + 1;
    }
    return out;
}

// The analysis the plan and its replay read once the takes and holds are in:
// the reads that became units of their own anchor nothing. A hold shortens a
// chain that is still live, so the flow is derived again over the new chains
// and the array a held read came from dies where its own uses end; a take's
// source dies at the read, so a take alone leaves the flow as it was.
function units_analysis(f: ssasem.Func, a: ssasem.Analysis, units: Units): ssasem.Analysis {
    var any: boolean = units.reflow;
    for h in units.held { if (h) { any = true; } }
    if (!any) { return ssasem.Analysis { ...a, dependencies: units.deps }; }
    var flow: ssalive.Flow = ssadeps.analyze(f.graph, units.deps);
    return ssasem.Analysis { ...a, ok: flow.ok, why: flow.why, dependencies: units.deps, flow: flow };
}

// An element read of a type the frame can hold a unit of: a view is lent,
// never retained, and a scalar has no unit.
function retainable_element(f: ssasem.Func, defs: ssa.SInst[], w: i32): boolean {
    if (defs[w].kind_tag != ssasem.array_get()) { return false; }
    var t: typeinfo.Type = f.values[w];
    return ssasem.reference(t) && !ssasem.is_view(t);
}

// The element reads anchored to `s` that are still in hand once `s` is
// supplied: past the operation at (`bi`, `pos`), or into block `si` when `s`
// goes out along an edge.
function outliving(f: ssasem.Func, a: ssasem.Analysis, defs: ssa.SInst[], held: boolean[], s: i32, bi: i32, pos: i32, si: i32): boolean[] {
    var out: boolean[] = held;
    var w: i32 = 0;
    while (w < f.graph.nvals) {
        if (w != s && !out[w] && retainable_element(f, defs, w) && reads(a, w, s)) {
            var live: boolean = false;
            if (si >= 0) { live = ssalive.live_in_has(a.flow, si, w); } else { live = used_after(f, a, bi, pos, w); }
            if (live) { out = out.with(w, true); }
        }
        w = w + 1;
    }
    return out;
}

// An element read that outlives a consuming use of its array takes a unit of
// its own at the read: retained there, released when it dies, anchored to
// nothing. As a borrow it kept the array alive past the use, so a `.with` or
// an append there retained the array instead of moving it and copied the
// whole buffer (#9849). A read that dies before any such use stays a borrow
// and costs nothing.
function held_elements(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[]): boolean[] {
    var out: boolean[] = bits(f.graph.nvals);
    var bi: i32 = 0;
    while (bi < f.graph.blocks.len()) {
        var b: ssa.SBlock = f.graph.blocks[bi];
        var pos: i32 = 0;
        while (pos < b.insts.len()) {
            var ins: ssa.SInst = b.insts[pos];
            if (ins.kind_tag != 6 && ins.kind_tag != 8) {
                var supplies: Supply[] = operation_supplies(f, ins);
                for got in supplies {
                    if (owned[got.value]) { out = outliving(f, a, defs, out, got.value, bi, pos, 0 - 1); }
                }
            }
            pos = pos + 1;
        }
        var targets: i32[] = successors(b);
        for target in targets {
            var si: i32 = ssalive.position(a.flow, target);
            var along: Supply[] = edge_supplies(f, b, si, owned);
            for got in along {
                if (owned[got.value]) { out = outliving(f, a, defs, out, got.value, bi, 0, si); }
            }
        }
        bi = bi + 1;
    }
    return out;
}

// A later read of a DIFFERENT payload slot of the same box: the box is
// mentioned again, but not through the slot a take has emptied.
function other_payload_get(ins: ssa.SInst, root: i32, slot: i32): boolean {
    return ins.kind_tag == ssasem.variant_get() && ins.args.len() == 1 && ins.args[0] == root && ins.imm != slot;
}

// The enum box whose payload the variant read at (`bi`, `pos`) may MOVE out
// of rather than borrow, or -1. Same shape as `projection_root` above, over
// an enum rather than a record and over the one payload slot the arm names:
// the box is a unit of this frame's own, it does not leave the block, and
// after the read it is reached only through reads of its OTHER slots.
//
// A tuple take next door demands more of its source — `takeable_root`, a box
// this frame ALLOCATED — because it nulls without asking. Here the physical
// lowering pays for a weaker source with a runtime uniqueness test on the box
// (`ssarc.steal`): a box somebody else also holds keeps its payload and the
// read retains, exactly as a borrow did. So what this predicate has to prove
// is only that THIS frame reads the slot no further.
//
// The builtin Option layout is refused: its box is a tag word and one payload
// word the physical lowering reads with `op_opt_payload`, which has no store
// form to null the slot with.
function payload_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
    var none: i32 = 0 - 1;
    var ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
    if (ins.kind_tag != ssasem.variant_get() || ins.args.len() != 1) { return none; }
    // This runs BEFORE the graph is verified, so a malformed instruction has
    // to answer "no take" rather than read past the end of its own operands.
    if (ins.result < 0 || ins.result >= f.graph.nvals) { return none; }
    var root: i32 = ins.args[0];
    if (root < 0 || root >= f.graph.nvals || root >= owned.len() || root >= defs.len()) { return none; }
    var got: typeinfo.Type = f.values[ins.result];
    if (!ssasem.reference(got) || !is_union(f.values[root])) { return none; }
    if ((ssasem.is_view(got) || option_layout(f, f.values[root])) && !sole_box(f, defs, root, bits(f.graph.nvals))) { return none; }
    if (!owned[root] || projection(defs[root].kind_tag)) { return none; }
    var b: ssa.SBlock = f.graph.blocks[bi];
    if (ssalive.live_out_has(a.flow, bi, root)) { return none; }
    var i: i32 = pos + 1;
    while (i < b.insts.len()) {
        var later: ssa.SInst = b.insts[i];
        var mentions: boolean = false;
        for arg in later.args { if (arg == root) { mentions = true; } }
        if (mentions && !other_payload_get(later, root, ins.imm)) { return none; }
        i = i + 1;
    }
    if (b.term.kind_tag == 1 && b.term.value == root) { return none; }
    if (b.term.kind_tag == 3 && b.term.cond == root) { return none; }
    var w: i32 = 0;
    while (w < f.graph.nvals) {
        if (w != root && w != ins.result && reads(a, w, root) && used_after(f, a, bi, pos, w)) {
            var hop: i32 = first_hop(a, w, root);
            if (hop != ins.result && (hop < 0 || !other_payload_get(defs[hop], root, ins.imm))) { return none; }
        }
        w = w + 1;
    }
    return root;
}

// A box nobody but this frame's tag tests and payload reads ever sees: built
// here, or a phi of boxes that are, and never handed to anything else. Its
// count is 1 when its payload is read, so the read may take the payload with no
// runtime test — which a view needs, since the test's shared arm retains, and
// the builtin Option layout needs, since it has no store to null the slot with.
// The box's drop in that step then releases the box alone (`shell_root`).
function sole_box(f: ssasem.Func, defs: ssa.SInst[], v: i32, seen: boolean[]): boolean {
    if (v < 0 || v >= defs.len()) { return false; }
    if (seen[v]) { return true; }
    var d: ssa.SInst = defs[v];
    if (d.kind_tag != ssasem.variant_new() && d.kind_tag != 8) { return false; }
    for b in f.graph.blocks {
        for ins in b.insts {
            var reads: boolean = false;
            for a in ins.args { if (a == v) { reads = true; } }
            if (reads && ins.kind_tag != 8 && ins.kind_tag != ssasem.variant_is() && ins.kind_tag != ssasem.variant_get()) { return false; }
        }
        if (b.term.kind_tag == 1 && b.term.value == v) { return false; }
    }
    if (d.kind_tag == 8) {
        var next: boolean[] = seen.with(v, true);
        for a in d.args { if (!sole_box(f, defs, a, next)) { return false; } }
    }
    return true;
}

// The box whose drop at `ins` releases the box alone: the root of a payload
// take out of the builtin Option layout, whose slot the take cannot null, or -1.
pub function shell_root(f: ssasem.Func, p: Plan, ins: ssa.SInst): i32 {
    if (ins.kind_tag != ssasem.variant_get() || ins.result < 0 || ins.result >= p.payloads.len() || !p.payloads[ins.result]) { return 0 - 1; }
    if (!option_layout(f, f.values[ins.args[0]])) { return 0 - 1; }
    return ins.args[0];
}

function is_union(t: typeinfo.Type): boolean {
    if let typeinfo.TypeUnion(_) = t { return true; }
    return false;
}

// True for the builtin Option/Result layout, and for a union whose schema this
// function does not carry — neither is a box a take may null a slot in.
function option_layout(f: ssasem.Func, t: typeinfo.Type): boolean {
    var at: i32 = semrecords.find_enum(f.enums, t);
    if (at < 0) { return true; }
    return f.enums[at].layout == semrecords.layout_option();
}

// The variant reads that take their payload's unit, indexed by the read's
// result value. Computed before the step walk for the same reason the tuple
// takes are: the walk runs backwards, so the consuming use that moves the
// payload is reached before the read that produced it.
function payload_takes(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[]): boolean[] {
    var out: boolean[] = bits(f.graph.nvals);
    var bi: i32 = 0;
    while (bi < f.graph.blocks.len()) {
        var pos: i32 = 0;
        while (pos < f.graph.blocks[bi].insts.len()) {
            if (payload_root(f, a, owned, defs, bi, pos) >= 0) {
                out = out.with(f.graph.blocks[bi].insts[pos].result, true);
            }
            pos = pos + 1;
        }
        bi = bi + 1;
    }
    return out;
}

// The record whose field buffer the append or with at (`bi`, `pos`) may grow
// or write in place, or -1: `projection_root` of its receiver.
function field_grow_root(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32): i32 {
    var ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
    if (ins.kind_tag != ssasem.append() && ins.kind_tag != ssasem.with()) { return 0 - 1; }
    return projection_root(f, a, owned, defs, bi, pos, ins.args[0]);
}

function is_array(t: typeinfo.Type): boolean {
    if let typeinfo.TypeArray(_) = t { return true; }
    return false;
}

function occurrences(xs: i32[], v: i32): i32 {
    var n: i32 = 0;
    for x in xs { if (x == v) { n = n + 1; } }
    return n;
}

// A direct call's counted slot fed by a projection of a record this frame
// owns and reads no further through that field takes the field's unit rather
// than a retained one (steal_unit): the callee then holds the buffer's only
// count and grows it in place. `Emit { ...e, r: emit(e.r, op) }` is the shape,
// and retaining there put a second count on every buffer the emit chain
// threads, so the callee's first append copied it.
function steals(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, s: Step): Step {
    var ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
    if (ins.kind_tag != ssasem.call()) { return s; }
    var out: Supply[] = s.supplies;
    var i: i32 = 0;
    while (i < out.len()) {
        var v: i32 = out[i].value;
        if (out[i].mode == retain_unit() && defs[v].kind_tag == ssasem.record_get() && occurrences(ins.args, v) == 1) {
            var root: i32 = projection_root(f, a, owned, defs, bi, pos, v);
            if (root >= 0 && owned[root]) { out = out.with(i, Supply { ...out[i], mode: steal_unit() }); }
        }
        i = i + 1;
    }
    return Step { ...s, supplies: out };
}

// The buffers a direct call at (`bi`, `pos`) is handed without a bracket:
// an array operand this frame reads no further, either a borrowed parameter
// of its own or a projection whose record it reads no further through that
// field (projection_root); or a whole record parameter this frame reads no
// further, whose fields the callee grows under the record's own count. An
// operand named twice is bracketed, since a callee growing one name would
// move the other. The buffer's only later holder is then the callee's result
// — retained on identity, fresh on a realloc — and the record or the caller
// releases the old one.
function hands(f: ssasem.Func, a: ssasem.Analysis, owned: boolean[], defs: ssa.SInst[], bi: i32, pos: i32, s: Step): Step {
    var ins: ssa.SInst = f.graph.blocks[bi].insts[pos];
    if (ins.kind_tag != ssasem.call()) { return s; }
    var roots: i32[] = [];
    var fields: i32[] = [];
    for v in ins.args {
        var root: i32 = 0 - 1;
        var field: i32 = 0 - 1;
        var lent_param: boolean = defs[v].kind_tag == 6 && !owned[v] && occurrences(ins.args, v) == 1 && !used_after(f, a, bi, pos, v);
        if (is_array(f.values[v]) && !ssasem.is_text(f.values[v]) && occurrences(ins.args, v) == 1) {
            if (lent_param) { root = v; }
            if (defs[v].kind_tag == ssasem.record_get()) {
                root = projection_root(f, a, owned, defs, bi, pos, v);
                if (root >= 0) { field = defs[v].imm; }
            }
        }
        if (is_record(f.values[v]) && !semtypes.is_env(f.values[v]) && lent_param) { root = v; }
        roots = roots.append(root);
        fields = fields.append(field);
    }
    return Step { ...s, hand_roots: roots, hand_fields: fields };
}

// Last occurrence may move one dead unit; every other occurrence retains.
function choose(s: Step, supplies: Supply[], dead: boolean[], owned: boolean[]): Step {
    var ids: i32[] = [];
    var i: i32 = 0;
    while (i < dead.len()) { if (dead[i]) { ids = ids.append(i); } i = i + 1; }
    return choose_ids(s, supplies, ids, owned);
}

// choose_ids is choose over the dead values listed by id, in any order: a
// dead owned supply moves its unit (the last one to name it), and the other
// dead owned values drop, in ascending id order.
function choose_ids(s: Step, supplies: Supply[], dead: i32[], owned: boolean[]): Step {
    var moved: i32[] = [];
    var selected: Supply[] = supplies;
    var i: i32 = selected.len() - 1;
    while (i >= 0) {
        var item: Supply = selected[i];
        var mode: i32 = retain_unit();
        if (owned[item.value] && has_id(dead, item.value) && !has_id(moved, item.value)) {
            mode = move_unit();
            moved = moved.append(item.value);
        }
        selected = selected.with(i, Supply { ...item, mode: mode });
        i = i - 1;
    }
    var drops: i32[] = [];
    for v in dead {
        if (owned[v] && !has_id(moved, v)) { drops = insert_sorted(drops, v); }
    }
    return Step { ...s, supplies: selected, drops: drops };
}

function has_id(xs: i32[], v: i32): boolean {
    for x in xs { if (x == v) { return true; } }
    return false;
}

function insert_sorted(own xs: i32[], v: i32): i32[] {
    xs = xs.append(v);
    var i: i32 = xs.len() - 1;
    while (i > 0 && xs[i - 1] > v) { xs = xs.with(i, xs[i - 1]); i = i - 1; }
    return xs.with(i, v);
}

pub function plan(f: ssasem.Func, modes: i32[]): Plan {
    var analysis: ssasem.Analysis = ssasem.analyze(f);
    if (!analysis.ok) { return bad(analysis.why); }
    var why: string = contract_error(f, modes);
    if (why != "") { return bad(why); }
    var owned: boolean[] = owned_values(f, modes);
    var reachable: boolean[] = ssadeps.reachable_blocks(f.graph);
    var defs: ssa.SInst[] = definitions(f);
    var units: Units = units_of(f, owned, analysis, defs);
    owned = units.owned;
    why = open_dyn_error(f, owned);
    if (why != "") { return bad(why); }
    var takes: i32[] = units.takes;
    analysis = units_analysis(f, analysis, units);
    if (!analysis.ok) { return bad(analysis.why); }
    var grows: i32[] = [];
    var grow_fields: i32[] = [];
    var vi0: i32 = 0;
    while (vi0 < f.graph.nvals) { grows = grows.append(0 - 1); grow_fields = grow_fields.append(0 - 1); vi0 = vi0 + 1; }
    var steps: Step[] = [];
    var bi: i32 = 0;
    while (bi < f.graph.blocks.len()) {
        var b: ssa.SBlock = f.graph.blocks[bi];
        if (reachable[bi]) {
            var live: boolean[] = live_out_row(analysis.flow, bi, f.graph.nvals);
            if (b.term.kind_tag == 1) { live = add_use(live, b.term.value, analysis.dependencies); }
            if (b.term.kind_tag == 3) { live = add_use(live, b.term.cond, analysis.dependencies); }
            var pos: i32 = b.insts.len() - 1;
            while (pos >= 0) {
                var ins: ssa.SInst = b.insts[pos];
                if (ins.kind_tag != 6 && ins.kind_tag != 8) {
                    var dead: i32[] = [];
                    if (owned[ins.result] && !live[ins.result]) { dead = dead.append(ins.result); }
                    live = live.with(ins.result, false);
                    for arg in ins.args {
                        if (arg >= 0) {
                            if (!live[arg]) { dead = dead.append(arg); live = live.with(arg, true); }
                            for dep in analysis.dependencies[arg] {
                                if (!live[dep]) { dead = dead.append(dep); live = live.with(dep, true); }
                            }
                        }
                    }
                    steps = steps.append(steals(f, analysis, owned, defs, bi, pos, hands(f, analysis, owned, defs, bi, pos, choose_ids(step(b.id, pos, 0 - 1), operation_supplies(f, ins), dead, owned))));
                    var root: i32 = field_grow_root(f, analysis, owned, defs, bi, pos);
                    if (root >= 0) {
                        grows = grows.with(ins.result, root);
                        grow_fields = grow_fields.with(ins.result, defs[ins.args[0]].imm);
                    }
                }
                pos = pos - 1;
            }
            var entry_dead: boolean[] = bits(f.graph.nvals);
            for ins in b.insts {
                if ((ins.kind_tag == 6 || ins.kind_tag == 8) && owned[ins.result] && !live[ins.result]) { entry_dead = entry_dead.with(ins.result, true); }
            }
            steps = steps.append(choose(step(b.id, entry_point(), 0 - 1), [], entry_dead, owned));
            if (b.term.kind_tag == 1 || b.term.kind_tag == 4) {
                var dead: boolean[] = bits(f.graph.nvals);
                if (b.term.kind_tag == 1) { dead = add_use(dead, b.term.value, analysis.dependencies); }
                steps = steps.append(choose(step(b.id, return_point(), 0 - 1), return_supplies(f, b), dead, owned));
            }
            for target in successors(b) {
                var si: i32 = ssalive.position(analysis.flow, target);
                var dead: i32[] = ssalive.out_not_in(analysis.flow, bi, si);
                steps = steps.append(choose_ids(step(b.id, edge_point(), target), edge_supplies(f, b, si, owned), dead, owned));
            }
        }
        bi = bi + 1;
    }
    var literal: boolean[] = literals(f);
    why = view_retain_error(f, steps, literal);
    if (why != "") { return bad(why); }
    return Plan { ok: true, why: "", steps: steps, owned: owned, literal: literal, grows: grows, grow_fields: grow_fields, takes: takes, held: units.held, payloads: units.payloads };
}

function read_error(state: boolean[], value: i32, owned: boolean[], deps: i32[][]): string {
    if (value < 0) { return ""; }
    if (owned[value] && !state[value]) { return "read without counted unit"; }
    for dep in deps[value] {
        if (owned[dep] && !state[dep]) { return "borrow outlives container unit"; }
    }
    return "";
}
function invariant(f: ssasem.Func, bi: i32, owned: boolean[], flow: ssalive.Flow): boolean[] {
    var state: boolean[] = bits(f.graph.nvals);
    for v in ssalive.live_in_ids(flow, bi) {
        if (owned[v]) { state = state.with(v, true); }
    }
    for ins in f.graph.blocks[bi].insts {
        if ((ins.kind_tag == 8 || ins.kind_tag == 6) && owned[ins.result]) { state = state.with(ins.result, true); }
    }
    return state;
}
// holds_invariant is same_bits(state, invariant(f, bi, owned, flow)) without
// building the invariant.
function holds_invariant(state: boolean[], f: ssasem.Func, bi: i32, owned: boolean[], flow: ssalive.Flow): boolean {
    var want: i32 = 0;
    for v in ssalive.live_in_ids(flow, bi) {
        if (owned[v]) {
            if (!state[v]) { return false; }
            want = want + 1;
        }
    }
    for ins in f.graph.blocks[bi].insts {
        if ((ins.kind_tag == 8 || ins.kind_tag == 6) && owned[ins.result] && !ssalive.live_in_has(flow, bi, ins.result)) {
            if (!state[ins.result]) { return false; }
            want = want + 1;
        }
    }
    var have: i32 = 0;
    for bit in state { if (bit) { have = have + 1; } }
    return have == want;
}
function same_bits(a: boolean[], b: boolean[]): boolean {
    var i: i32 = 0;
    while (i < a.len()) { if (a[i] != b[i]) { return false; } i = i + 1; }
    return true;
}
// step_index lists, for each block id, the positions of the plan's steps at
// that block, so a lookup scans one block's steps rather than the whole plan.
pub function step_index(p: Plan): i32[][] {
    var top: i32 = 0 - 1;
    for s in p.steps { if (s.block > top) { top = s.block; } }
    var out: i32[][] = [];
    var i: i32 = 0;
    while (i <= top) { out = out.append([]); i = i + 1; }
    i = 0;
    while (i < p.steps.len()) {
        var b: i32 = p.steps[i].block;
        if (b >= 0) { out = out.with(b, out[b].append(i)); }
        i = i + 1;
    }
    return out;
}

// step_at is the first step at (block, point, target), or -1.
pub function step_at(p: Plan, idx: i32[][], block: i32, point: i32, target: i32): i32 {
    if (block < 0 || block >= idx.len()) { return 0 - 1; }
    for i in idx[block] {
        if (p.steps[i].point == point && p.steps[i].target == target) { return i; }
    }
    return 0 - 1;
}

// find_step is the one step at (block, point, target), or -1 when there is
// none or more than one.
function find_step(p: Plan, idx: i32[][], block: i32, point: i32, target: i32): i32 {
    if (block < 0 || block >= idx.len()) { return 0 - 1; }
    var found: i32 = 0 - 1;
    for i in idx[block] {
        var s: Step = p.steps[i];
        if (s.point == point && s.target == target) {
            if (found >= 0) { return 0 - 1; }
            found = i;
        }
    }
    return found;
}

// Acquisitions observe the original state: a later move in the same step
// must not invalidate an earlier retain of the same value.
function supply_error(state: boolean[], supplies: Supply[], wanted: Supply[], owned: boolean[], deps: i32[][]): string {
    if (supplies.len() != wanted.len()) { return "unit supply arity"; }
    var i: i32 = 0;
    while (i < wanted.len()) {
        var got: Supply = supplies[i];
        if (got.value != wanted[i].value || got.slot != wanted[i].slot) { return "unit supply identity or slot"; }
        var why: string = read_error(state, got.value, owned, deps);
        if (why != "") { return why; }
        if (got.mode != retain_unit() && got.mode != move_unit() && got.mode != steal_unit()) { return "invalid unit supply mode"; }
        i = i + 1;
    }
    return "";
}

function move_supplies(state: boolean[], supplies: Supply[], owned: boolean[]): Ledger {
    var next: boolean[] = state;
    for got in supplies {
        if (got.mode == move_unit()) {
            if (!owned[got.value] || !next[got.value]) { return rejected("move without counted unit"); }
            next = next.with(got.value, false);
        }
    }
    return Ledger { ok: true, why: "", bits: next };
}

function drop_units(state: boolean[], drops: i32[], owned: boolean[]): Ledger {
    var next: boolean[] = state;
    for value in drops {
        if (value < 0 || value >= owned.len()) { return rejected("drop value out of range"); }
        if (!owned[value] || !next[value]) { return rejected("drop without counted unit"); }
        next = next.with(value, false);
    }
    return Ledger { ok: true, why: "", bits: next };
}

// Replay checks supplies against freshly derived effect obligations. It does
// not reuse the planner's last-use sets or chosen move/drop decisions.
function replay(state: boolean[], s: Step, wanted: Supply[], result: i32, owned: boolean[], deps: i32[][]): Ledger {
    var why: string = supply_error(state, s.supplies, wanted, owned, deps);
    if (why != "") { return rejected(why); }
    var moved: Ledger = move_supplies(state, s.supplies, owned);
    if (!moved.ok) { return moved; }
    var next: boolean[] = moved.bits;
    if (result >= 0 && owned[result]) {
        if (next[result]) { return rejected("result unit already present"); }
        next = next.with(result, true);
    }
    return drop_units(next, s.drops, owned);
}

struct ReplayProgress { why: string, state: boolean[], count: i32 }
function progress_error(why: string): ReplayProgress { return ReplayProgress { why: why, state: [], count: 0 }; }

function verify_operations(f: ssasem.Func, b: ssa.SBlock, p: Plan, idx: i32[][], state: boolean[], owned: boolean[], deps: i32[][]): ReplayProgress {
    var next: boolean[] = state;
    var count: i32 = 0;
    var pos: i32 = 0;
    for ins in b.insts {
        if (ins.kind_tag != 6 && ins.kind_tag != 8) {
            for arg in ins.args {
                var why: string = read_error(next, arg, owned, deps);
                if (why != "") { return progress_error(why); }
            }
            var at: i32 = find_step(p, idx, b.id, pos, 0 - 1);
            if (at < 0) { return progress_error("missing or duplicate operation step"); }
            var done: Ledger = replay(next, p.steps[at], operation_supplies(f, ins), ins.result, owned, deps);
            if (!done.ok) { return progress_error(done.why); }
            next = done.bits;
            count = count + 1;
        }
        pos = pos + 1;
    }
    return ReplayProgress { why: "", state: next, count: count };
}

function verify_return(f: ssasem.Func, b: ssa.SBlock, p: Plan, idx: i32[][], state: boolean[], owned: boolean[], deps: i32[][]): string {
    if (b.term.kind_tag == 1) {
        var why: string = read_error(state, b.term.value, owned, deps);
        if (why != "") { return why; }
    }
    var at: i32 = find_step(p, idx, b.id, return_point(), 0 - 1);
    if (at < 0) { return "missing or duplicate return step"; }
    var done: Ledger = replay(state, p.steps[at], return_supplies(f, b), 0 - 1, owned, deps);
    if (!done.ok) { return done.why; }
    for bit in done.bits { if (bit) { return "counted unit leaks at return"; } }
    return "";
}

function enter_phis(b: ssa.SBlock, state: boolean[], owned: boolean[]): Ledger {
    var next: boolean[] = state;
    for ins in b.insts {
        if (ins.kind_tag == 8 && owned[ins.result]) {
            if (next[ins.result]) { return rejected("phi unit already present"); }
            next = next.with(ins.result, true);
        }
    }
    return Ledger { ok: true, why: "", bits: next };
}

function verify_edge(f: ssasem.Func, b: ssa.SBlock, target: i32, p: Plan, idx: i32[][], state: boolean[], owned: boolean[], analysis: ssasem.Analysis): string {
    var at: i32 = find_step(p, idx, b.id, edge_point(), target);
    if (at < 0) { return "missing or duplicate edge step"; }
    var si: i32 = ssalive.position(analysis.flow, target);
    var done: Ledger = replay(state, p.steps[at], edge_supplies(f, b, si, owned), 0 - 1, owned, analysis.dependencies);
    if (!done.ok) { return done.why; }
    var entered: Ledger = enter_phis(f.graph.blocks[si], done.bits, owned);
    if (!entered.ok) { return entered.why; }
    if (!holds_invariant(entered.bits, f, si, owned, analysis.flow)) { return "edge unit invariant mismatch"; }
    return "";
}

function verify_block(f: ssasem.Func, bi: i32, p: Plan, idx: i32[][], owned: boolean[], analysis: ssasem.Analysis): ReplayProgress {
    var b: ssa.SBlock = f.graph.blocks[bi];
    var state: boolean[] = invariant(f, bi, owned, analysis.flow);
    var at: i32 = find_step(p, idx, b.id, entry_point(), 0 - 1);
    if (at < 0) { return progress_error("missing or duplicate entry step"); }
    var done: Ledger = replay(state, p.steps[at], [], 0 - 1, owned, analysis.dependencies);
    if (!done.ok) { return progress_error(done.why); }
    var operations: ReplayProgress = verify_operations(f, b, p, idx, done.bits, owned, analysis.dependencies);
    if (operations.why != "") { return operations; }
    state = operations.state;
    var count: i32 = 1 + operations.count;
    if (b.term.kind_tag == 1 || b.term.kind_tag == 4) {
        var why: string = verify_return(f, b, p, idx, state, owned, analysis.dependencies);
        if (why != "") { return progress_error(why); }
        count = count + 1;
    }
    if (b.term.kind_tag == 3) {
        var why: string = read_error(state, b.term.cond, owned, analysis.dependencies);
        if (why != "") { return progress_error(why); }
    }
    for target in successors(b) {
        var why: string = verify_edge(f, b, target, p, idx, state, owned, analysis);
        if (why != "") { return progress_error(why); }
        count = count + 1;
    }
    return ReplayProgress { why: "", state: state, count: count };
}

function same_takes(a: i32[], b: i32[]): boolean {
    if (a.len() != b.len()) { return false; }
    var i: i32 = 0;
    while (i < a.len()) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

pub function verify(f: ssasem.Func, modes: i32[], p: Plan): string {
    if (!p.ok || p.why != "") { return "missing successful unit plan"; }
    var analysis: ssasem.Analysis = ssasem.analyze(f);
    if (!analysis.ok) { return analysis.why; }
    var why: string = contract_error(f, modes);
    if (why != "") { return why; }
    var units: Units = units_of(f, owned_values(f, modes), analysis, definitions(f));
    var owned: boolean[] = units.owned;
    if (!same_takes(units.takes, p.takes)) { return "tuple take disagrees with the plan"; }
    if (!same_bits(units.held, p.held)) { return "element hold disagrees with the plan"; }
    if (!same_bits(units.payloads, p.payloads)) { return "payload take disagrees with the plan"; }
    analysis = units_analysis(f, analysis, units);
    if (!analysis.ok) { return analysis.why; }
    var reachable: boolean[] = ssadeps.reachable_blocks(f.graph);
    var idx: i32[][] = step_index(p);
    var count: i32 = 0;
    var bi: i32 = 0;
    while (bi < f.graph.blocks.len()) {
        if (reachable[bi]) {
            var done: ReplayProgress = verify_block(f, bi, p, idx, owned, analysis);
            if (done.why != "") { return done.why; }
            count = count + done.count;
        }
        bi = bi + 1;
    }
    if (count != p.steps.len()) { return "extra unit plan steps"; }
    return "";
}
