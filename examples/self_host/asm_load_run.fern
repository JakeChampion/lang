// examples/self_host/asm_load_run.fern — import-driven, file-loading
// self-host compiler driver. Takes an entry .fern file path on the
// command line, follows its `import "./x"` declarations to sibling
// files (x.fern in the entry's directory), loads them transitively,
// flattens the whole set into one module, and prints its x86-64 asm.
//
//     $ asm_load_run prog.fern > prog.s
//
// This retires the stdin marker-bundle (bundle_run): modules are
// resolved from the filesystem the way a real compiler driver works,
// using read_file + the parser's captured Import list. Non-local
// imports (core/…, std/…) are skipped — the entry must be
// self-contained over local modules + builtins.

import "core/no_prelude";
import "./lexer";
import "./parser";
import "./flatten";
import "./asm";

// last_slash returns the index of the final '/' in p, or -1.
function last_slash(p: string): i32 {
    var i: i32 = 0;
    var last: i32 = 0 - 1;
    while (i < p.len()) {
        if (p[i] == 47) { last = i; }
        i = i + 1;
    }
    return last;
}

// dir_of returns the directory portion of a path ("" if none).
function dir_of(p: string): string {
    var ls: i32 = last_slash(p);
    if (ls < 0) { return ""; }
    return p[0:ls];
}

// module_name maps an import path to its bundle name: the final path
// segment (`./a/lexer` → `lexer`, `./parser` → `parser`).
function module_name(import_path: string): string {
    var ls: i32 = last_slash(import_path);
    if (ls >= 0) { return import_path[ls + 1:import_path.len()]; }
    return import_path;
}

// is_local is true for `./…` / `../…` imports (loaded from disk),
// false for `core/…` / `std/…` (skipped — provided by builtins).
function is_local(import_path: string): boolean {
    if (import_path.len() == 0) { return false; }
    return import_path[0] == 46;   // '.'
}

// join_path builds `<dir>/<name>.fern` (or `<name>.fern` if dir empty).
function join_path(dir: string, name: string): string {
    if (dir.len() == 0) { return name + ".fern"; }
    return dir + "/" + name + ".fern";
}

function contains_name(xs: string[], n: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == n) { return true; }
        i = i + 1;
    }
    return false;
}

// add_local_imports appends each of mod's local import names to names
// (deduped), returning the grown list.
function add_local_imports(names: string[], mod: parser.Module): string[] {
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        var ip: string = mod.imports[i].path;
        if (is_local(ip)) {
            var nm: string = module_name(ip);
            if (!contains_name(names, nm)) { names = names.push(nm); }
        }
        i = i + 1;
    }
    return names;
}

function main(): i32 {
    var av: string[] = args();
    if (av.len() < 2) {
        eprint("usage: asm_load_run <entry.fern>\n");
        return 2;
    }
    var entry_path: string = av[1];
    var dir: string = dir_of(entry_path);

    var esrc: string = "";
    var eok: boolean = false;
    match (read_file(entry_path)) {
        Ok(s) => { esrc = s; eok = true; },
        Err(e) => { eok = false; },
    }
    if (!eok) {
        eprint("asm_load_run: cannot read entry file\n");
        return 1;
    }
    var entry_mod: parser.Module = parser.parse_module(lexer.tokenize(esrc));

    // Worklist of module names to load (seeded from the entry's
    // imports, grown as each loaded module's imports are discovered).
    var names: string[] = add_local_imports([], entry_mod);
    var loaded: flatten.LoadedModule[] = [];
    var done: string[] = [];
    var j: i32 = 0;
    while (j < names.len()) {
        var name: string = names[j];
        j = j + 1;
        if (!contains_name(done, name)) {
            done = done.push(name);
            var mpath: string = join_path(dir, name);
            var msrc: string = "";
            var mok: boolean = false;
            match (read_file(mpath)) {
                Ok(s2) => { msrc = s2; mok = true; },
                Err(e) => { mok = false; },
            }
            if (!mok) {
                eprint("asm_load_run: cannot read module: ");
                eprint(mpath);
                eprint("\n");
                return 1;
            }
            var m: parser.Module = parser.parse_module(lexer.tokenize(msrc));
            loaded = loaded.push(flatten.LoadedModule { name: name, mod: m });
            names = add_local_imports(names, m);
        }
    }

    var merged: parser.Module = flatten.bundle(entry_mod, loaded);
    write(asm.emit_module(parser.module_with_builtins(merged)));
    return 0;
}
