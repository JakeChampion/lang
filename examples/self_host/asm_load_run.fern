// examples/self_host/asm_load_run.fern — import-driven, file-loading
// self-host compiler driver. Takes an entry .fern file path on the
// command line, follows its `import "./x"` declarations to sibling
// files (x.fern in the entry's directory), loads them transitively,
// flattens the whole set into one module, and prints its x86-64 asm.
//
//     $ asm_load_run prog.fern > prog.s
//
// This retires the stdin marker-bundle (bundle_run): modules are
// resolved from the filesystem the way a real compiler driver works,
// using read_file + the parser's captured Import list. Non-local
// imports (core/…, std/…) are skipped — the entry must be
// self-contained over local modules + builtins.

import "./util";
import "./lexer";
import "./parser";
import "./flatten";
import "./checker";
import "./asm";
import "./asm_ir";

// last_slash returns the index of the final '/' in p, or -1.
function last_slash(p: string): i32 {
    var i: i32 = 0;
    var last: i32 = 0 - 1;
    while (i < p.len()) {
        if (p[i] == 47) { last = i; }
        i = i + 1;
    }
    return last;
}

// dir_of returns the directory portion of a path ("" if none).
function dir_of(p: string): string {
    var ls: i32 = last_slash(p);
    if (ls < 0) { return ""; }
    return p[0:ls];
}

// module_name maps an import path to its bundle name: the final path
// segment (`./a/lexer` → `lexer`, `./parser` → `parser`).
function module_name(import_path: string): string {
    var ls: i32 = last_slash(import_path);
    if (ls >= 0) { return import_path[ls + 1:import_path.len()]; }
    return import_path;
}

// is_local is true for `./…` / `../…` imports (loaded from the entry's
// directory), false for `core/…` / `std/…` (resolved under the stdlib
// root, when one is configured).
function is_local(import_path: string): boolean {
    if (import_path.len() == 0) { return false; }
    return import_path[0] == 46;   // '.'
}

// join_path builds `<dir>/<name>.fern` (or `<name>.fern` if dir empty).
function join_path(dir: string, name: string): string {
    if (dir.len() == 0) { return name + ".fern"; }
    return dir + "/" + name + ".fern";
}

// contains_name -> util.has_str (SH-020).

// should_load decides whether an import path names a module file to
// load. Local (`./…`) imports always load (from the entry's dir).
// `std/…` / `core/…` imports load only when a stdlib root is given.
// With no root the std/core paths are skipped — identical to
// the pre-stdlib-root behaviour.
function should_load(import_path: string, root: string): boolean {
    if (import_path.len() == 0) { return false; }
    if (is_local(import_path)) { return true; }
    if (root.len() == 0) { return false; }
    return true;
}

// resolve_path maps an import path to a file on disk. Local imports
// resolve to `<entry_dir>/<name>.fern`; std/core imports resolve to
// `<root>/<import_path>.fern` (e.g. `std/math` → `<root>/std/math.fern`).
function resolve_path(import_path: string, entry_dir: string, root: string): string {
    if (is_local(import_path)) {
        return join_path(entry_dir, module_name(import_path));
    }
    return root + "/" + import_path + ".fern";
}

// add_imports appends each of mod's loadable import paths to paths
// (deduped by full path), returning the grown list.
function add_imports(paths: string[], mod: parser.Module, root: string): string[] {
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        var ip: string = mod.imports[i].path;
        if (should_load(ip, root) && !util.has_str(paths, ip)) {
            paths = paths.append(ip);
        }
        i = i + 1;
    }
    return paths;
}

function main(): i32 {
    var av: string[] = args();
    if (av.len() < 2) {
        eprint("usage: asm_load_run <entry.fern> [stdlib-root]\n");
        return 2;
    }
    var entry_path: string = av[1];
    var dir: string = dir_of(entry_path);
    // Optional stdlib root: the first non-flag arg after the entry. When given,
    // `std/…` / `core/…` imports are resolved under it (`<root>/std/foo.fern`);
    // without it those imports are skipped (the entry must be self-contained
    // over local modules + builtins). `-ir-probe` reports the IR-eligibility
    // frontier of the fully-loaded program instead of emitting asm — a
    // per-function breakdown of what lowers through the stack-IR path vs what
    // bails to the AST emitter (asm_ir.eligibility_report). Unlike the
    // single-module asm_ir_run probe, this sees the WHOLE program with its
    // stdlib imports flattened in, so it reports the frontier real programs hit.
    var root: string = "";
    var probe: boolean = false;
    var ag: i32 = 2;
    while (ag < av.len()) {
        if (av[ag] == "-ir-probe") { probe = true; }
        else if (root == "") { root = av[ag]; }
        ag = ag + 1;
    }

    var esrc: string = "";
    var eok: boolean = false;
    match (read_file(entry_path)) {
        Ok(s) => { esrc = s; eok = true; },
        Err(e) => { eok = false; },
    }
    if (!eok) {
        eprint("asm_load_run: cannot read entry file\n");
        return 1;
    }
    var entry_mod: parser.Module = parser.parse_module(lexer.tokenize(esrc));

    // Worklist of import PATHS to load (seeded from the entry's
    // imports, grown as each loaded module's imports are discovered).
    // Tracking the full path — not just the basename — lets std/core
    // paths resolve under the stdlib root.
    var paths: string[] = add_imports([], entry_mod, root);
    var loaded: flatten.LoadedModule[] = [];
    var done: string[] = [];
    var j: i32 = 0;
    while (j < paths.len()) {
        var ipath: string = paths[j];
        j = j + 1;
        if (!util.has_str(done, ipath)) {
            done = done.append(ipath);
            var mpath: string = resolve_path(ipath, dir, root);
            var msrc: string = "";
            var mok: boolean = false;
            match (read_file(mpath)) {
                Ok(s2) => { msrc = s2; mok = true; },
                Err(e) => { mok = false; },
            }
            if (!mok) {
                eprint("asm_load_run: cannot read module: ");
                eprint(mpath);
                eprint("\n");
                return 1;
            }
            var m: parser.Module = parser.parse_module(lexer.tokenize(msrc));
            loaded = loaded.append(flatten.LoadedModule { name: module_name(ipath), mod: m });
            paths = add_imports(paths, m, root);
        }
    }

    var merged: parser.Module = flatten.bundle(entry_mod, loaded);

    // `-ir-probe`: report the IR-eligibility frontier of the whole loaded
    // program (lambda-lifted to match what the emitter routes on) and stop —
    // no codegen, no checker gate.
    if (probe) {
        write(asm_ir.eligibility_report(asm_ir.lift_lambdas(merged)));
        return 0;
    }

    // Immutability gate: reject the immutable-data cycle rules
    // (E048 field assign / E049 capture write-back / E055 discarded pure
    // result / E056 subscript assign) before codegen — the self-host
    // enforcement of the immutable-data model (docs/IMMUTABILITY-MIGRATION-
    // PLAN.md §4). Filtered to the cycle rules so the rest of the partial
    // checker can't false-positive-reject a valid program (or this very
    // source under fixpoint). A hit prints the diagnostic to stderr and
    // fails the build.
    var imm: checker.Diag[] = checker.filter_immutability(checker.check_module(merged).diags);
    if (imm.len() > 0) {
        eprint(checker.format_diags(imm));
        return 1;
    }

    write(asm.emit_module(parser.module_with_builtins(merged)));
    return 0;
}
