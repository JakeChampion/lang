// examples/self_host/asm_load_run.fern — import-driven, file-loading
// self-host compiler driver. Takes an entry .fern file path on the
// command line, follows its `import "./x"` declarations to sibling
// files (x.fern in the entry's directory), loads them transitively,
// flattens the whole set into one module, and prints its x86-64 asm.
//
//     $ asm_load_run prog.fern > prog.s
//
// This retires the stdin marker-bundle (bundle_run): modules are
// resolved from the filesystem the way a real compiler driver works,
// using read_file + the parser's captured Import list. Non-local
// imports (core/…, std/…) are skipped — the entry must be
// self-contained over local modules + builtins.

import "./util";
import "./lexer";
import "./parser";
import "./flatten";
import "./checker";
import "./asm_arm64_ir";
import "./asm_ir";
import "./treeshake";

// add_imports appends each of mod's loadable import paths to paths
// (deduped by full path), returning the grown list.
function add_imports(paths: string[], mod: parser.Module, root: string): string[] {
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        var ip: string = mod.imports[i].path;
        if (util.should_load(ip, root, []) && !util.has_str(paths, ip)) {
            paths = paths.append(ip);
        }
        i = i + 1;
    }
    return paths;
}

// prune_to_reachable keeps only `mod`'s funcs whose mangled name is in `reach`
// (the reachable-name set derived from the treeshaked merged module). Both
// flatten.bundle (the merged path) and flatten.bundle_per_module mangle a
// non-entry decl to `prefix__name`, so the names line up. Runs BEFORE
// lift_lambdas — exactly where the merged path treeshakes — so a kept function's
// lifted lambdas (generated names, not in `reach`) survive.
function prune_to_reachable(mod: parser.Module, reach: string[]): parser.Module {
    var kept: parser.FuncDecl[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        if (util.has_str(reach, mod.funcs[fi].name)) { kept = kept.append(mod.funcs[fi]); }
        fi = fi + 1;
    }
    return parser.Module { funcs: kept, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs, trait_decls: mod.trait_decls };
}

// emit_per_module_concat compiles a program's modules SEPARATELY (per-module IR
// units) and concatenates them into one linkable asm stream, routing a program
// that overflows the merged 512-function IR budget through the IR path anyway
// (#3457). Each module is under budget, so each unit lowers
// on the IR path; the units share a whole-program func/struct view (all_funcs /
// all_structs) so cross-module calls and imported struct layouts resolve, and
// only the entry unit emits `_start` + the shared runtime (seeded with the full
// need roots). `reach` is the reachable-name set: each module is pruned to it
// first, so unused stdlib functions — which may use per-function constructs the
// IR path cannot lower yet — do NOT make the module ineligible.
// Returns "" if a REACHABLE module is still not IR-eligible; the caller then
// falls through to the merged IR-or-error emit.
//
// Bounded to programs that fit ONE process: the whole-compiler self-compile
// (~2040 funcs) would accumulate every unit's working set in a single process
// and OOM (that path uses the batched, file-based per-module emit instead), so
// the caller only routes here for merged sizes comfortably below it.
function emit_per_module_concat(entry_mod: parser.Module, loaded: flatten.LoadedModule[], reach: string[]): string {
    var parts: flatten.PerModule[] = flatten.bundle_per_module(entry_mod, loaded);
    var infmods: parser.Module[] = [];
    var all_funcs: parser.FuncDecl[] = [];
    var all_structs: parser.StructDecl[] = [];
    var known: string[] = [];
    var pruned: parser.Module[] = [];
    var si0: i32 = 0;
    while (si0 < parts.len()) { pruned = pruned.append(prune_to_reachable(parts[si0].mod, reach)); si0 = si0 + 1; }
    var lifted: parser.Module[] = asm_ir.lift_lambdas_parts(pruned);
    var pi: i32 = 0;
    while (pi < parts.len()) {
        var im: parser.Module = lifted[pi];
        infmods = infmods.append(im);
        var fk: i32 = 0;
        while (fk < im.funcs.len()) {
            all_funcs = all_funcs.append(im.funcs[fk]);
            known = known.append(im.funcs[fk].name);
            if (im.funcs[fk].receiver_type.len() > 0) {
                known = known.append(util.base_type_name(im.funcs[fk].receiver_type) + "." + im.funcs[fk].name);
            }
            fk = fk + 1;
        }
        var sk: i32 = 0;
        while (sk < im.structs.len()) { all_structs = all_structs.append(im.structs[sk]); sk = sk + 1; }
        pi = pi + 1;
    }
    var needs: string[] = asm_ir.all_runtime_need_roots();
    var out: string = "";
    var idx: i32 = 0;
    while (idx < parts.len()) {
        // Per-module eligibility against the whole-program view, exactly as the
        // per-module emit lowers. Any ineligible REACHABLE module aborts the whole
        // concat so the caller falls through to the merged emit.
        var elig: boolean = asm_ir.all_eligible_lib_known_view(infmods[idx], known, all_funcs, all_structs);
        if (parts[idx].is_entry) { elig = asm_ir.all_eligible_known_view(infmods[idx], known, all_funcs, all_structs); }
        if (!elig) { return ""; }
        var extra: string[] = [];
        if (parts[idx].is_entry) { extra = needs; }
        out = out + asm_ir.emit_module_ir_unit(infmods[idx], parts[idx].is_entry, true, parts[idx].ns, extra, all_funcs, all_structs, 0, 0 - 1, []);
        idx = idx + 1;
    }
    return out;
}

function main(): i32 {
    var av: string[] = args();
    if (av.len() < 2) {
        eprint("usage: asm_load_run <entry.fern> [stdlib-root]\n");
        return 2;
    }
    var entry_path: string = av[1];
    var dir: string = util.dir_of(entry_path);
    // Optional stdlib root: the first non-flag arg after the entry. When given,
    // `std/…` / `core/…` imports are resolved under it (`<root>/std/foo.fern`);
    // without it those imports are skipped (the entry must be self-contained
    // over local modules + builtins). `-ir-probe` reports the IR-eligibility
    // frontier of the fully-loaded program instead of emitting asm — a
    // per-function breakdown of what lowers through the stack-IR path vs what
    // bails (asm_ir.eligibility_report). Unlike the
    // single-module asm_ir_run probe, this sees the WHOLE program with its
    // stdlib imports flattened in, so it reports the frontier real programs hit.
    var root: string = "";
    var probe: boolean = false;
    var probe_start: i32 = 0 - 1;   // >= 0 selects the sharded probe
    var probe_count: i32 = 0;
    // Per-module compilation modes (#3451 step 4 / #3456). One emit per process
    // (native strbuf limit), so the build is driven across invocations:
    //   -per-module-count / -per-module-needs / -per-module-emit <N>
    // with -extra-need <name> supplying the entry's whole-program need union.
    var pm_mode: string = "";
    var pm_index: i32 = 0 - 1;
    var pm_extra: string[] = [];
    // -treeshake prunes the merged module to functions reachable from main
    // before codegen, so a stdlib-importing program fits asm_ir's IR budget
    // instead of being made ineligible by unused stdlib. -decide prints
    // "ir"/"ast" ("ast" being the probe's historical word for "not IR-eligible")
    // and stops, for observing the treeshake effect without emitting.
    var do_treeshake: boolean = false;
    // -no-treeshake opts OUT of the default (stdlib-root) prune — for observing
    // the un-pruned baseline (e.g. a budget-busting program coming out
    // ineligible).
    var no_treeshake: boolean = false;
    var do_decide: boolean = false;
    // `-target x86_64|arm64` selects the emit backend (#4398 part 1: the fold
    // that retired the asm_arm64_load_run mirror). Default x86_64 keeps every
    // pre-fold caller byte-identical. Loading, treeshake, -decide, -ir-probe
    // and the immutability gate are target-agnostic; the per-module modes
    // remain x86-64-only (the mirror never had them).
    var target: string = "x86-64-linux";
    var ag: i32 = 2;
    while (ag < av.len()) {
        if (av[ag] == "-ir-probe") { probe = true; }
        else if (av[ag] == "-treeshake") { do_treeshake = true; }
        else if (av[ag] == "-no-treeshake") { no_treeshake = true; }
        else if (av[ag] == "-decide") { do_decide = true; }
        else if (av[ag] == "-target" && ag + 1 < av.len()) { target = av[ag + 1]; ag = ag + 1; }
        else if (av[ag] == "-per-module-count") { pm_mode = "count"; }
        else if (av[ag] == "-per-module-needs") { pm_mode = "needs"; }
        else if (av[ag] == "-per-module-emit" && ag + 1 < av.len()) { pm_mode = "emit"; pm_index = util.digits_to_i32(av[ag + 1]); ag = ag + 1; }
        else if (av[ag] == "-extra-need" && ag + 1 < av.len()) { pm_extra = pm_extra.append(av[ag + 1]); ag = ag + 1; }
        // `-ir-probe-range START COUNT`: shard the probe over function indices
        // [START, START+COUNT). Each invocation lowers only that slice, so the
        // large self-host modules (which exhaust the bump heap when the whole-
        // module probe lowers every function at once) stay auditable a shard at
        // a time. The START==0 shard prints a "funcs: <N>" header for driving
        // the loop. COUNT <= 0 means "to the end".
        else if (av[ag] == "-ir-probe-range" && ag + 2 < av.len()) {
            probe = true;
            probe_start = util.digits_to_i32(av[ag + 1]);
            probe_count = util.digits_to_i32(av[ag + 2]);
            ag = ag + 2;
        }

        // The first argument matching no flag is the stdlib root. It has to stay
        // in this chain: hoisted out of it, a flag reaches it as well — and so
        // does the value `-target` has just stepped over, which then resolves
        // `core/…` imports under "arm64-linux".
        else if (root == "") { root = av[ag]; }
        ag = ag + 1;
    }

    // An unrecognised -target is refused rather than emitted for. This driver
    // dispatches by naming the targets it knows and letting everything else
    // reach the x86-64 branch, so a stale or misspelled name used to come back
    // as a successful emit for the WRONG machine — the arm64 leg of #6710 was
    // handed x86-64 text and surfaced as "unknown mnemonic `movq'" from the
    // aarch64 assembler, which reads as a codegen bug rather than a typo.
    if (target != "x86-64-linux" && target != "arm64-linux" && target != "arm64-darwin") {
        eprint("asm_load_run: unknown -target: " + target + " (want x86-64-linux, arm64-linux, arm64-darwin)\n");
        return 2;
    }

    var esrc: string = "";
    var eok: boolean = false;
    match (read_file(entry_path)) {
        Ok(s) => { esrc = s; eok = true; },
        Err(e) => { eok = false; },
    }
    if (!eok) {
        eprint("asm_load_run: cannot read entry file\n");
        return 1;
    }
    var entry_mod: parser.Module = parser.parse_module(lexer.tokenize(esrc));

    // Worklist of import PATHS to load (seeded from the entry's
    // imports, grown as each loaded module's imports are discovered).
    // Tracking the full path — not just the basename — lets std/core
    // paths resolve under the stdlib root.
    var paths: string[] = add_imports([], entry_mod, root);
    var loaded: flatten.LoadedModule[] = [];
    var done: string[] = [];
    var j: i32 = 0;
    while (j < paths.len()) {
        var ipath: string = paths[j];
        j = j + 1;
        if (!util.has_str(done, ipath)) {
            done = done.append(ipath);
            var mpath: string = util.resolve_path(ipath, dir, root);
            var msrc: string = "";
            var mok: boolean = false;
            match (read_file(mpath)) {
                Ok(s2) => { msrc = s2; mok = true; },
                Err(e) => { mok = false; },
            }
            if (!mok) {
                eprint("asm_load_run: cannot read module: ");
                eprint(mpath);
                eprint("\n");
                return 1;
            }
            var m: parser.Module = parser.parse_module(lexer.tokenize(msrc));
            loaded = loaded.append(flatten.LoadedModule { name: util.module_name(ipath), mod: m });
            paths = add_imports(paths, m, root);
        }
    }

    // Per-module compilation (#3451 step 4 / #3456). Run BEFORE flatten.bundle
    // (which mangles entry_mod / loaded in place) so bundle_per_module sees the
    // un-mangled modules. The native runtime's global string buffer can hold
    // only ONE emit per process (its len is reset by process start, not by an
    // in-process strbuf_reset/take), so — exactly like a real build system —
    // per-module compilation is driven across SEPARATE invocations:
    //   -per-module-count        → print the module count N
    //   -per-module-needs        → print the whole-program runtime-need union
    //   -per-module-emit N [-extra-need X...]
    //                            → emit module N's translation unit (the entry
    //                              folds the supplied -extra-need union into its
    //                              single shared runtime)
    // bundle_per_module + the whole-program signature view are recomputed each
    // invocation (cheap: parse + analysis, no codegen) so every per-module emit
    // tags cross-module calls by the callee's real signature.
    if (pm_mode.len() > 0) {
        var parts: flatten.PerModule[] = flatten.bundle_per_module(entry_mod, loaded);
        if (pm_mode == "count") {
            print(util.i32_to_string(parts.len()) + "\n");
            return 0;
        }
        // Whole-program signature view + program-wide known-symbol set.
        var infmods: parser.Module[] = [];
        var all_funcs: parser.FuncDecl[] = [];
        var all_structs: parser.StructDecl[] = [];
        var known: string[] = [];
        var rawmods: parser.Module[] = [];
        var rpi: i32 = 0;
        while (rpi < parts.len()) { rawmods = rawmods.append(parts[rpi].mod); rpi = rpi + 1; }
        var lifted: parser.Module[] = asm_ir.lift_lambdas_parts(rawmods);
        var pi: i32 = 0;
        while (pi < parts.len()) {
            var im: parser.Module = lifted[pi];
            infmods = infmods.append(im);
            var fk: i32 = 0;
            while (fk < im.funcs.len()) {
                all_funcs = all_funcs.append(im.funcs[fk]);
                known = known.append(im.funcs[fk].name);
                if (im.funcs[fk].receiver_type.len() > 0) {
                    known = known.append(util.base_type_name(im.funcs[fk].receiver_type) + "." + im.funcs[fk].name);
                }
                fk = fk + 1;
            }
            var sk: i32 = 0;
            while (sk < im.structs.len()) { all_structs = all_structs.append(im.structs[sk]); sk = sk + 1; }
            pi = pi + 1;
        }
        if (pm_mode == "needs") {
            // Seed the entry's shared runtime with the full root set instead of an
            // exact per-module union (asm_ir.all_runtime_need_roots): a sound,
            // deterministic over-approximation. Computing the exact union here ran
            // module_runtime_needs (a full emit) over EVERY module in one process,
            // which OOMs a self-host-built driver (#3425) — the one thing blocking a
            // self-host per-module self-compile. The entry over-emits a few unused
            // helpers; close_needs still pulls each root's transitive deps.
            var needs: string[] = asm_ir.all_runtime_need_roots();
            var no: i32 = 0;
            while (no < needs.len()) { print(needs[no] + "\n"); no = no + 1; }
            return 0;
        }
        // pm_mode == "emit": emit exactly module pm_index (the ONLY strbuf-emit
        // in this process, so the buffer is clean).
        if (pm_index < 0 || pm_index >= parts.len()) {
            eprint("per-module: emit index out of range\n");
            return 1;
        }
        // Entry requires a main (it emits `_start` → `call __fn_main`); a
        // library unit has none by design (all_eligible_lib_known_view). Both
        // gate against the WHOLE-PROGRAM all_funcs / all_structs view, so a
        // function touching a sibling module's struct layout lowers in the gate
        // exactly as it does in emit_module_ir_unit (which already lowers against
        // all_structs) — without the view, every module importing another's
        // struct bails (#3451).
        var elig: boolean = asm_ir.all_eligible_lib_known_view(infmods[pm_index], known, all_funcs, all_structs);
        if (parts[pm_index].is_entry) { elig = asm_ir.all_eligible_known_view(infmods[pm_index], known, all_funcs, all_structs); }
        if (!elig) {
            eprint("per-module: module not IR-eligible: ");
            eprint(parts[pm_index].ns);
            eprint("\n");
            return 1;
        }
        // The entry folds the whole-program runtime-need union (-extra-need,
        // from the -per-module-needs invocation) into its single shared runtime.
        var extra: string[] = [];
        if (parts[pm_index].is_entry) { extra = pm_extra; }
        write(asm_ir.emit_module_ir_unit(infmods[pm_index], parts[pm_index].is_entry, true, parts[pm_index].ns, extra, all_funcs, all_structs, 0, 0 - 1, []));
        return 0;
    }

    var merged: parser.Module = flatten.bundle(entry_mod, loaded);

    // Prune unreachable functions (sound, name-based reachability from main)
    // so a stdlib-importing program's merged module fits the IR budget. Raw
    // (pre-module_with_builtins) pruning is sound: derive-synthesised methods
    // and monomorph instantiations are added AFTER this from functions that are
    // themselves reachable, so nothing reachable is dropped. Applied by default
    // whenever a stdlib root is in play (the only time the transitive closure
    // bloats past the IR budget); `-treeshake` forces it on even without a root.
    // A program with no stdlib imports (the bootstrap self-compile, root == "")
    // is left exactly as before.
    if ((do_treeshake || root.len() > 0) && !no_treeshake) { merged = treeshake.treeshake(merged); }

    // `-decide`: print the path the merged module routes through (ir / ast) —
    // the same all_eligible decision emit_module makes — and stop. Annotates
    // first (typed-IR #5531): emit_module receives the annotate_module'd tree
    // (line below), and some functions are IR-eligible ONLY once the checker's
    // types are stamped (e.g. a `f().N` tuple-element read whose element is a
    // struct, resolved via expr_tuple_elem_tag's c.ty read). Without annotating
    // here `-decide` under-reported those as "ast", diverging from what
    // emit_module actually does. asm_ir.script_normalized closes the other half
    // of that divergence: a script's `main` is synthesised inside the emit, so
    // judging the raw module reported "ast" for a program that in fact lowers IR.
    if (do_decide) {
        var dm: parser.Module = asm_ir.lift_lambdas(parser.module_with_builtins(checker.annotate_module(merged)));
        if (asm_ir.all_eligible(asm_ir.script_normalized(dm))) { print("ir\n"); } else { print("ast\n"); }
        return 0;
    }

    // `-ir-probe`: report the IR-eligibility frontier of the whole loaded
    // program and stop — no codegen, no checker gate. Runs the SAME
    // module_with_builtins pipeline `-decide` and emit_module route on
    // (monomorphise + builtin-enum injection), so the frontier reflects the
    // module codegen actually sees. Without it the probe scanned the RAW
    // merged module, whose un-instantiated bounded-generic TEMPLATES
    // (core/cmp's min[T:Ord] etc.) are still present — their `a.cmp(b)` on a
    // type-param receiver bails, so the probe reported `module: AST` for a
    // program that in fact routes IR once monomorphise drops those templates
    // (#4374). Lambda-lifted last, matching what the emitter routes on.
    if (probe) {
        var lifted: parser.Module = asm_ir.lift_lambdas(parser.module_with_builtins(merged));
        if (probe_start >= 0) {
            write(asm_ir.eligibility_report_range(lifted, probe_start, probe_count));
        } else {
            write(asm_ir.eligibility_report(lifted));
        }
        return 0;
    }

    // Build gate: reject a program the checker rejects before codegen, so this
    // driver is not more permissive than `-check` or the native compiler
    // (#6961). checker.is_build_gate_code decides the set — every coded
    // diagnostic except the partial-port rules measured to false-positive.
    // A hit prints the diagnostic to stderr and fails the build.
    var gated: util.Diag[] = checker.filter_build_gate(checker.check_module(merged).diags);
    if (gated.len() > 0) {
        eprint(util.format_diags(gated));
        return 1;
    }

    // typed-IR (#5531): stamp each call expression with its checker-inferred
    // result type so the IR lowering READS the type instead of re-deriving it
    // (docs/TYPED-IR-REWRITE.md). Runs after the checker (its Scope resolves the
    // types) and before emit_module's eligible-module IR routing, which is what
    // reads c.ty. A no-op on drivers that skip it (asm_ir_run leaves ty "").
    merged = checker.annotate_module(merged);

    if (target == "arm64-linux") {
        // IR-or-error (#3457 slice 5): the arm64 leg has no fallback either.
        // asm_arm64_ir.emit_module_or_error runs the same prologue asm_arm64
        // .emit_module did and errors where the fallback used to be. Note the arm64
        // merged path shares the 512-function budget (#5949 corrected the old "arm64
        // needs none of this"), so an over-budget program errors here exactly as it
        // does on x86 — the per-module path is what compiles those.
        write(asm_arm64_ir.emit_module_or_error(parser.module_with_builtins(merged), false));
        return 0;
    }
    if (target == "arm64-darwin") {
        // The same emitter with the Darwin syscall builtins selected, reskinned
        // to the Mach-O dialect — the GAS text `fern.fern -target arm64-darwin`
        // hands to its in-process assembler. Emitted here so a harness can
        // inspect the darwinized output without building the whole CLI.
        write(asm_arm64_ir.darwinize(asm_arm64_ir.emit_module_or_error(parser.module_with_builtins(merged), true)));
        return 0;
    }
    var mwb: parser.Module = parser.module_with_builtins(merged);
    // OVER the merged 512-function IR budget but small enough to fit one process:
    // route per-module (each module is under budget → IR) instead of failing the
    // whole program (#3457). The lower bound is the budget the
    // merged IR path bails at (asm_ir.emit_module_ir_gated: sm.funcs.len() > 512);
    // the upper bound keeps the whole-compiler self-compile (~2040 funcs, driven
    // through this same default) OUT — a single-process per-module concat of that
    // many funcs OOMs, and it has the batched file-based per-module path instead.
    // `merged` is already treeshaked (above), so its func names are the reachable
    // set the per-module emit prunes each module to; emit_per_module_concat
    // returns "" if a reachable module is genuinely IR-ineligible, so such
    // programs fall through to the merged emit below.
    var nfuncs: i32 = asm_ir.lift_lambdas(mwb).funcs.len();
    if (nfuncs > 512 && nfuncs < 1500) {
        var reach: string[] = [];
        var ri: i32 = 0;
        while (ri < merged.funcs.len()) { reach = reach.append(merged.funcs[ri].name); ri = ri + 1; }
        var pmc: string = emit_per_module_concat(entry_mod, loaded, reach);
        if (pmc.len() > 0) { write(pmc); return 0; }
    }
    // Last resort, and no longer a fallback: a module the per-module concat rescue
    // above declined (or one past its 1500-function ceiling) is an ERROR, not a
    // silent drop to the legacy AST emitter (#3457 slice 5).
    write(asm_ir.emit_module_or_error(mwb));
    return 0;
}
