// examples/self_host/asm_load_run.fern — import-driven, file-loading
// self-host compiler driver. Takes an entry .fern file path on the
// command line, follows its `import "./x"` declarations to sibling
// files (x.fern in the entry's directory), loads them transitively,
// flattens the whole set into one module, and prints its x86-64 asm, or
// with `-target` its arm64 asm or wasm32-wasi WAT.
//
//     $ asm_load_run prog.fern > prog.s
//     $ asm_load_run prog.fern <stdlib-root> -target wasm32-wasi > prog.wat
//     $ asm_load_run prog.fern <stdlib-root> -target wasm32-wasi -emit component-core > core.wat
//
// This retires the stdin marker-bundle (bundle_run): modules are
// resolved from the filesystem the way a real compiler driver works,
// using read_file + the parser's captured Import list. Non-local
// imports (core/…, std/…) are skipped — the entry must be
// self-contained over local modules + builtins.

import "./util";
import "./lexer";
import "./parser";
import "./flatten";
import "./checker";
import "./asm_arm64_ir";
import "./asm_ir";
import "./wasm_ir";
import "./asmcore";
import "./treeshake";
import "./constfold";
import "./platforms";
import "./ircore";
import "./semlower";

// add_imports appends each of mod's loadable import paths to paths
// (deduped by full path), returning the grown list.
function add_imports(paths: string[], mod: parser.Module, root: string): string[] {
  let i: i32 = 0;
  while (i < mod.imports.len()) {
    let ip: string = mod.imports[i].path;
    if (util.should_load(ip, root, []) && !util.has_str(paths, ip)) {
      paths = paths.append(ip);
    }
    i = i + 1;
  }
  return paths;
}

// shaken_program prunes an annotated module to what main reaches when `prune`
// is set, and returns it unchanged otherwise. Callers annotate first: the
// checker's Display rewrite is what roots a `to_string` method a `print(x)`
// call reaches (docs/TRAITS.md §3a).
function shaken_program(typed: parser.Module, prune: boolean): parser.Module {
  if (!prune) {
    return typed;
  }
  return treeshake.treeshake(typed);
}

// emit_per_module_concat compiles a program's modules as separate units and
// concatenates them into one linkable asm stream. `d` is the merged emit's
// program and the units are cut from its lowering; only the entry unit emits
// `_start` and the shared runtime (seeded with the full need roots).
function emit_per_module_concat(entry_mod: parser.Module, loaded: flatten.LoadedModule[], target: string, d: semlower.Driven): string {
  let parts: flatten.PerModule[] = flatten.bundle_per_module(entry_mod, loaded, target);
  let needs: string[] = ircore.all_runtime_need_roots();
  let out: string = "";
  let g: ircore.Gated = semlower.program(d);
  let u: ircore.Units = ircore.split_units(g, part_mods(parts), entry_index(parts));
  let ti: i32 = 0;
  while (ti < parts.len()) {
    let textra: string[] = [];
    if (parts[ti].is_entry) {
      textra = needs;
    }
    out = out + asm_ir.emit_module_ir_unit_flat(u.mods[ti], parts[ti].is_entry, true, parts[ti].ns, textra, g.im.funcs, g.stab, 0, 0 - 1, u.caches[ti], d.sub.rt_lower, 0 as usize, asmcore.env_switches());
    ti = ti + 1;
  }
  return asmcore.dedupe_weak_defs(out);
}

function part_mods(parts: flatten.PerModule[]): parser.Module[] {
  let out: parser.Module[] = [];
  for pt in parts {
    out = out.append(pt.mod);
  }
  return out;
}

function entry_index(parts: flatten.PerModule[]): i32 {
  let i: i32 = 0;
  while (i < parts.len()) {
    if (parts[i].is_entry) {
      return i;
    }
    i = i + 1;
  }
  return 0;
}

// targeted is `merged` as built for `target`: `target_os()` / `target_arch()`
// folded to the target's names and the branch the target never takes
// dropped, ahead of the shake, so a function reached only through the other
// target's arm (std/fetch's hosted route, which calls std/wasi_http's
// externs) is not emitted for this one.
function targeted(merged: parser.Module, target: string): parser.Module {
  let md: platforms.Descriptor = platforms.for_target(target);
  return constfold.prune_literal_branches(constfold.fold_target_name(merged, md.environment, md.isa));
}

// checked_or_exit is the program the merged emit reads: the bundle, held to
// the checker's build gate, built for the target, annotated and pruned when
// `prune` is set.
function checked_or_exit(merged: parser.Module, prune: boolean, target: string): parser.Module {
  // Build gate: reject a program the checker rejects before codegen, so this
  // driver is not more permissive than `-check` or the native compiler
  // (#6961). checker.is_build_gate_code decides the set — every coded
  // diagnostic except the partial-port rules measured to false-positive.
  let gated: util.Diag[] = checker.build_gate_diags(merged);
  if (gated.len() > 0) {
    eprint(util.format_diags(gated));
    exit(1);
  }
  // typed-IR (#5531): stamp each call expression with its checker-inferred
  // result type so the IR lowering READS the type instead of re-deriving it
  // (docs/TYPED-IR-REWRITE.md).
  return shaken_program(checker.annotate_module(targeted(merged, target)), prune);
}

// decided is the typed lowering's verdict on the program checked_or_exit
// hands the merged emit, without exiting.
function decided(merged: parser.Module, prune: boolean, target: string): semlower.Verdict {
  let gated: util.Diag[] = checker.build_gate_diags(merged);
  if (gated.len() > 0) {
    return semlower.Verdict { ok: false, errors: gated, rows: [] };
  }
  return semlower.verdict_annotated(shaken_program(checker.annotate_module(targeted(merged, target)), prune), target);
}

function main(): i32 {
  let av: string[] = args();
  if (av.len() < 2) {
    eprint("usage: asm_load_run <entry.fern> [stdlib-root]");
    return 2;
  }
  let entry_path: string = av[1];
  let dir: string = util.dir_of(entry_path);
  // Optional stdlib root: the first non-flag arg after the entry. When given,
  // `std/…` / `core/…` imports are resolved under it (`<root>/std/foo.fern`);
  // without it those imports are skipped (the entry must be self-contained
  // over local modules + builtins). `-ir-probe` reports the typed lowering's
  // verdict on the fully-loaded program instead of emitting asm
  // (semlower.verdict_text). Unlike the single-module asm_ir_run probe, this
  // sees the WHOLE program with its stdlib imports flattened in.
  let root: string = "";
  let probe: boolean = false;
  // Per-module compilation modes (#3451 step 4 / #3456). One emit per process
  // (native strbuf limit), so the build is driven across invocations:
  //   -per-module-count / -per-module-needs / -per-module-emit <N>
  // with -extra-need <name> supplying the entry's whole-program need union.
  let pm_mode: string = "";
  let pm_index: i32 = 0 - 1;
  let pm_extra: string[] = [];
  // -treeshake prunes the merged module to functions reachable from main
  // before codegen, so a stdlib-importing program fits asm_ir's IR budget
  // instead of being made ineligible by unused stdlib. -decide prints
  // "ir" or "refused" and stops, for observing the treeshake effect without emitting.
  let do_treeshake: boolean = false;
  // -no-treeshake opts OUT of the default (stdlib-root) prune — for observing
  // the un-pruned baseline (e.g. a budget-busting program coming out
  // ineligible).
  let no_treeshake: boolean = false;
  let do_decide: boolean = false;
  // `-target` selects the emit backend: x86-64-linux, arm64-linux,
  // arm64-darwin (#4398 part 1: the fold that retired the
  // asm_arm64_load_run mirror) or wasm32-wasi. Default x86_64 keeps every
  // pre-fold caller byte-identical. Loading, treeshake and the immutability
  // gate are target-agnostic, and -decide / -ir-probe lower for the target;
  // the per-module modes remain x86-64-only (the mirror never had them).
  let target: string = "x86-64-linux";
  // `-emit component-core` (wasm32-wasi only): the core the CLI frames into a
  // wasi:cli/run component, rather than the preview1 command core.
  let emit_form: string = "";
  let ag: i32 = 2;
  while (ag < av.len()) {
    if (av[ag] == "-ir-probe") {
      probe = true;
    } else if (av[ag] == "-treeshake") {
      do_treeshake = true;
    } else if (av[ag] == "-no-treeshake") {
      no_treeshake = true;
    } else if (av[ag] == "-decide") {
      do_decide = true;
    } else if (av[ag] == "-target" && ag + 1 < av.len()) {
      target = av[ag + 1];
      ag = ag + 1;
    } else if (av[ag] == "-emit" && ag + 1 < av.len()) {
      emit_form = av[ag + 1];
      ag = ag + 1;
    } else if (av[ag] == "-per-module-count") {
      pm_mode = "count";
    } else if (av[ag] == "-per-module-needs") {
      pm_mode = "needs";
    } else if (av[ag] == "-per-module-emit" && ag + 1 < av.len()) {
      pm_mode = "emit";
      pm_index = util.digits_to_i32(av[ag + 1]);
      ag = ag + 1;
    } else if (av[ag] == "-extra-need" && ag + 1 < av.len()) {
      pm_extra = pm_extra.append(av[ag + 1]);
      ag = ag + 1;
    } else if (root == "") {
      // The first argument matching no flag is the stdlib root. It has to stay
      // in this chain: hoisted out of it, a flag reaches it as well — and so
      // does the value `-target` has just stepped over, which then resolves
      // `core/…` imports under "arm64-linux".
      root = av[ag];
    }
    ag = ag + 1;
  }

  // An unrecognised -target is refused rather than emitted for. This driver
  // dispatches by naming the targets it knows and letting everything else
  // reach the x86-64 branch, so a stale or misspelled name used to come back
  // as a successful emit for the WRONG machine — the arm64 leg of #6710 was
  // handed x86-64 text and surfaced as "unknown mnemonic `movq'" from the
  // aarch64 assembler, which reads as a codegen bug rather than a typo.
  if (target != "x86-64-linux" && target != "arm64-linux" && target != "arm64-darwin" && target != "wasm32-wasi") {
    eprint("asm_load_run: unknown -target: " + target + " (want x86-64-linux, arm64-linux, arm64-darwin, wasm32-wasi)");
    return 2;
  }
  if (emit_form != "" && (emit_form != "component-core" || target != "wasm32-wasi")) {
    eprint("asm_load_run: -emit " + emit_form + " is not an output form for " + target + " (want component-core with -target wasm32-wasi)");
    return 2;
  }

  let esrc: string = "";
  let eok: boolean = false;
  match (read_file(entry_path)) {
    Ok(s) => {
      esrc = s;
      eok = true;
    },
    Err(e) => {
      eok = false;
    }
  }
  if (!eok) {
    eprint("asm_load_run: cannot read entry file");
    return 1;
  }
  let entry_mod: parser.Module = parser.parse_module(lexer.tokenize(esrc));

  // Worklist of import PATHS to load (seeded from the entry's
  // imports, grown as each loaded module's imports are discovered).
  // Tracking the full path — not just the basename — lets std/core
  // paths resolve under the stdlib root.
  let paths: string[] = add_imports([], entry_mod, root);
  let loaded: flatten.LoadedModule[] = [];
  let done: string[] = [];
  let j: i32 = 0;
  while (j < paths.len()) {
    let ipath: string = paths[j];
    j = j + 1;
    if (!util.has_str(done, ipath)) {
      done = done.append(ipath);
      let mpath: string = util.resolve_path(ipath, dir, root);
      let msrc: string = "";
      let mok: boolean = false;
      match (read_file(mpath)) {
        Ok(s2) => {
          msrc = s2;
          mok = true;
        },
        Err(e) => {
          mok = false;
        }
      }
      if (!mok) {
        eprint("asm_load_run: cannot read module: " + mpath);
        return 1;
      }
      let m: parser.Module = parser.with_stdlib_origin(parser.parse_module(lexer.tokenize(msrc)), ipath);
      loaded = loaded.append(flatten.LoadedModule { name: util.module_name(ipath), ident: "", mod: m });
      paths = add_imports(paths, m, root);
    }
  }

  let parsed: parser.Module[] = [entry_mod];
  for lm in loaded {
    parsed = parsed.append(lm.mod);
  }
  if (asmcore.refuse_decl_names(parsed)) {
    return 1;
  }
  if (asmcore.refuse_parse_unknowns(parsed)) {
    return 1;
  }

  // Prune unreachable functions (sound, name-based reachability from main)
  // so a stdlib-importing program's merged module fits the IR budget. Raw
  // (pre-module_with_builtins) pruning is sound: derive-synthesised methods
  // and monomorph instantiations are added AFTER this from functions that are
  // themselves reachable, so nothing reachable is dropped. Applied by default
  // whenever a stdlib root is in play (the only time the transitive closure
  // bloats past the IR budget); `-treeshake` forces it on even without a root.
  // A program with no stdlib imports (the bootstrap self-compile, root == "")
  // is left exactly as before.
  //
  // The prune runs on the ANNOTATED module and after the build gate, in the
  // order fern.fern uses. The gate has to read the module as written: the
  // prune drops mod.funcs while leaving mod.impls whole, so an empty
  // `impl Trait for T { }` whose adopted method is unreachable reads to the
  // checker as a missing method (#8885). And the annotate pass has to run
  // first because it is what roots a Display method: `print(q)` becomes
  // `q.to_string()` there (docs/TRAITS.md §3a), and the prune keeps
  // `Q.to_string` only once that call exists.
  let prune: boolean = (do_treeshake || root.len() > 0) && !no_treeshake;

  // Per-module compilation (#3451 step 4 / #3456). Run BEFORE flatten.bundle
  // (which mangles entry_mod / loaded in place) so bundle_per_module sees the
  // un-mangled modules. The native runtime's global string buffer can hold
  // only ONE emit per process (its len is reset by process start, not by an
  // in-process strbuf_reset/take), so — exactly like a real build system —
  // per-module compilation is driven across SEPARATE invocations:
  //   -per-module-count        → print the module count N
  //   -per-module-needs        → print the whole-program runtime-need union
  //   -per-module-emit N [-extra-need X...]
  //                            → emit module N's translation unit (the entry
  //                              folds the supplied -extra-need union into its
  //                              single shared runtime)
  // bundle_per_module + the whole-program signature view are recomputed each
  // invocation (cheap: parse + analysis, no codegen) so every per-module emit
  // tags cross-module calls by the callee's real signature.
  if (pm_mode.len() > 0) {
    let parts: flatten.PerModule[] = flatten.bundle_per_module(entry_mod, loaded, target);
    if (pm_mode == "count") {
      print(util.i32_to_string(parts.len()) + "\n");
      return 0;
    }
    if (pm_mode == "needs") {
      // Seed the entry's shared runtime with the full root set instead of an
      // exact per-module union (ircore.all_runtime_need_roots): a sound,
      // deterministic over-approximation. Computing the exact union here ran
      // module_runtime_needs (a full emit) over EVERY module in one process,
      // which OOMs a self-host-built driver (#3425) — the one thing blocking a
      // self-host per-module self-compile. The entry over-emits a few unused
      // helpers; close_needs still pulls each root's transitive deps.
      let needs: string[] = ircore.all_runtime_need_roots();
      let no: i32 = 0;
      while (no < needs.len()) {
        print(needs[no] + "\n");
        no = no + 1;
      }
      return 0;
    }
    // pm_mode == "emit": emit exactly module pm_index (the ONLY strbuf-emit
    // in this process, so the buffer is clean).
    if (pm_index < 0 || pm_index >= parts.len()) {
      eprint("per-module: emit index out of range");
      return 1;
    }
    let extra: string[] = [];
    if (parts[pm_index].is_entry) {
      extra = pm_extra;
    }
    // The typed lowering lowers the program the merged emit reads, whole,
    // and this unit is cut from it.
    let pd: semlower.Driven = semlower.driven_annotated(checked_or_exit(flatten.bundle(entry_mod, loaded, target), prune, target), target);
    let pg: ircore.Gated = semlower.program(pd);
    let pu: ircore.Units = ircore.split_units(pg, part_mods(parts), entry_index(parts));
    write(asm_ir.emit_module_ir_unit_flat(pu.mods[pm_index], parts[pm_index].is_entry, true, parts[pm_index].ns, extra, pg.im.funcs, pg.stab, 0, 0 - 1, pu.caches[pm_index], pd.sub.rt_lower, 0 as usize, asmcore.env_switches()));
    return 0;
  }

  let merged: parser.Module = flatten.bundle(entry_mod, loaded, target);

  // `-decide` prints whether the typed lowering produces the program the
  // merged emit reads ("ir") or refuses it ("refused"), and `-ir-probe` the
  // verdict per declaration; both stop there.
  if (do_decide || probe) {
    let v: semlower.Verdict = decided(merged, prune, target);
    if (probe) {
      write(semlower.verdict_text(v));
    } else if (v.ok) {
      print("ir\n");
    } else {
      print("refused\n");
    }
    return 0;
  }

  merged = checked_or_exit(merged, prune, target);

  if (target == "wasm32-wasi") {
    // The preview1 command core, or the component core, as the CLI emits it.
    let dw: semlower.Driven = semlower.driven_annotated(merged, target);
    if (emit_form == "component-core") {
      let shape: i32 = wasm_ir.component_shape(dw.full, dw.sub.switches);
      if (shape < 0) {
        eprint("asm_load_run: the program uses WASI imports the component wrapper does not frame");
        return 1;
      }
      write(wasm_ir.emit_module_mode_or_error_sub(dw.full, true, shape != 0, dw.sub));
      return 0;
    }
    write(wasm_ir.emit_module_mode_or_error_sub(dw.full, false, false, dw.sub));
    return 0;
  }
  if (target == "arm64-linux") {
    // IR-or-error (#3457 slice 5): the arm64 leg has no fallback either.
    // asm_arm64_ir.emit_module_or_error_sub runs the same prologue asm_arm64
    // .emit_module did and errors where the fallback used to be. Note the arm64
    // merged path shares the 512-function budget (#5949 corrected the old "arm64
    // needs none of this"), so an over-budget program errors here exactly as it
    // does on x86 — the per-module path is what compiles those.
    let d64: semlower.Driven = semlower.driven_annotated(merged, target);
    write(asm_arm64_ir.emit_module_or_error_sub(d64.full, false, d64.sub, 0 as usize));
    return 0;
  }
  if (target == "arm64-darwin") {
    // The same emitter with the Darwin syscall builtins selected, reskinned
    // to the Mach-O dialect — the GAS text `fern.fern -target arm64-darwin`
    // hands to its in-process assembler. Emitted here so a harness can
    // inspect the darwinized output without building the whole CLI.
    let dd: semlower.Driven = semlower.driven_annotated(merged, target);
    write(asm_arm64_ir.darwinize(asm_arm64_ir.emit_module_or_error_sub(dd.full, true, dd.sub, 0 as usize)));
    return 0;
  }
  // OVER the merged 512-function IR budget but small enough to fit one process:
  // route per-module (each module is under budget → IR) instead of failing the
  // whole program (#3457). The lower bound is the budget the
  // merged IR path bails at (asm_ir.emit_module_ir_gated_sub: sm.funcs.len() > 512);
  // the upper bound keeps the whole-compiler self-compile (~2040 funcs, driven
  // through this same default) OUT — a single-process per-module concat of that
  // many funcs OOMs, and it has the batched file-based per-module path instead.
  let d: semlower.Driven = semlower.driven_annotated(merged, target);
  let nfuncs: i32 = ircore.lift_lambdas(parser.module_with_builtins(merged)).funcs.len();
  if (nfuncs > 512 && nfuncs < 1500) {
    write(emit_per_module_concat(entry_mod, loaded, target, d));
    return 0;
  }
  // Every other program takes the merged emit, where a module the gate
  // declines is an ERROR (#3457 slice 5).
  write(asm_ir.emit_module_or_error_sub(d.full, d.sub, 0 as usize));
  return 0;
}
