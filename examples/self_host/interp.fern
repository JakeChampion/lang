function check_match_statements(): i32 {
  // StmtMatch — variant pattern binds the scrutinee and the
  // body reads a field off it.
  let src39: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 5 }; match (c) { Circle(x) => { return x.r; }, _ => { return -1; } } return -2; }";
  let r39: Value = run_module(src39);
  match (r39) {
    VInt(i) => {
      if (i.v != 5) {
        return 390;
      }
    },
    _ => {
      return 391;
    }
  }

  // StmtMatch — second variant matches, first is skipped.
  let src40: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { let q = Square { s: 7 }; match (q) { Circle(_) => { return 1; }, Square(sq) => { return sq.s; }, _ => { return -1; } } return -2; }";
  let r40: Value = run_module(src40);
  match (r40) {
    VInt(i) => {
      if (i.v != 7) {
        return 400;
      }
    },
    _ => {
      return 401;
    }
  }

  // StmtMatch — wildcard catches when no variant matches.
  let src41: string = "struct Circle { r: i32 } struct Square { s: i32 } struct Triangle { b: i32 } function main(): i32 { let t = Triangle { b: 3 }; match (t) { Circle(_) => { return 1; }, Square(_) => { return 2; }, _ => { return 99; } } return -1; }";
  let r41: Value = run_module(src41);
  match (r41) {
    VInt(i) => {
      if (i.v != 99) {
        return 410;
      }
    },
    _ => {
      return 411;
    }
  }

  // StmtMatch — bare variant pattern (no binding), arm body
  // doesn't reference the value.
  let src42: string = "struct Empty { } function main(): i32 { let e = Empty { }; match (e) { Empty => { return 42; }, _ => { return -1; } } return -2; }";
  let r42: Value = run_module(src42);
  match (r42) {
    VInt(i) => {
      if (i.v != 42) {
        return 420;
      }
    },
    _ => {
      return 421;
    }
  }

  // StmtMatch — non-exhaustive: scrutinee doesn't match any
  // arm and there's no wildcard. v_err("non-exhaustive match")
  // bubbles out as the function's return value.
  let src43: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { let c = Circle { r: 1 }; match (c) { Square(_) => { return 2; } } return -1; }";
  let r43: Value = run_module(src43);
  match (r43) {
    VErr(_) => {},
    _ => {
      return 430;
    }
  }

  // StmtMatch — arm body without `return` falls through to
  // the stmt after the match. Verifies the no-return signal
  // doesn't accidentally short-circuit.
  let src44: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 8 }; let n: i32 = 0; match (c) { Circle(x) => { n = x.r; }, _ => { n = -1; } } return n; }";
  let r44: Value = run_module(src44);
  match (r44) {
    VInt(i) => {
      if (i.v != 8) {
        return 440;
      }
    },
    _ => {
      return 441;
    }
  }

  // StmtMatch — arm-local bindings die after the arm. After
  // the match closes, the outer scope must NOT see `x`.
  // Re-binding `x` in the surrounding scope to a different
  // value verifies the inner binding was dropped.
  let src45: string = "struct Circle { r: i32 } function main(): i32 { let c = Circle { r: 1 }; match (c) { Circle(x) => { }, _ => { } } let x: i32 = 77; return x; }";
  let r45: Value = run_module(src45);
  match (r45) {
    VInt(i) => {
      if (i.v != 77) {
        return 450;
      }
    },
    _ => {
      return 451;
    }
  }

  return 0;
}

function check_receiver_methods(): i32 {
  // Receiver method on a struct: `c.area()` dispatches to
  // the method whose receiver_type matches the struct type
  // (Circle). The method body reads the receiver via its
  // bound name and returns a derived value.
  let src46: string = "struct Circle { r: i32 } function (c: Circle) area(): i32 { return c.r * c.r; } function main(): i32 { let k = Circle { r: 5 }; return k.area(); }";
  let r46: Value = run_module(src46);
  match (r46) {
    VInt(i) => {
      if (i.v != 25) {
        return 460;
      }
    },
    _ => {
      return 461;
    }
  }

  // Method takes an arg. `b.scale(3)` binds c=b and n=3.
  let src47: string = "struct Box { v: i32 } function (b: Box) scale(n: i32): i32 { return b.v * n; } function main(): i32 { let x = Box { v: 4 }; return x.scale(3); }";
  let r47: Value = run_module(src47);
  match (r47) {
    VInt(i) => {
      if (i.v != 12) {
        return 470;
      }
    },
    _ => {
      return 471;
    }
  }

  // Method name and plain function name don't collide. Plain
  // call resolves to the non-method (receiver_name empty).
  let src48: string = "struct Circle { r: i32 } function (c: Circle) area(): i32 { return c.r * c.r; } function area(): i32 { return 100; } function main(): i32 { let k = Circle { r: 5 }; let m: i32 = area(); let n: i32 = k.area(); return m + n; }";
  let r48: Value = run_module(src48);
  match (r48) {
    VInt(i) => {
      if (i.v != 125) {
        return 480;
      }
    },
    _ => {
      return 481;
    }
  }

  // Method on wrong receiver type → VErr. Circle has an
  // `area` method; Square does not.
  let src49: string = "struct Circle { r: i32 } struct Square { s: i32 } function (c: Circle) area(): i32 { return c.r; } function main(): i32 { let sq = Square { s: 7 }; return sq.area(); }";
  let r49: Value = run_module(src49);
  match (r49) {
    VErr(_) => {},
    _ => {
      return 490;
    }
  }

  return 0;
}

function check_floats(): i32 {
  // Float literal — `3.14` evaluates to a VFloat.
  let r50: Value = run_source("return 3.14;");
  match (r50) {
    VFloat(f) => {
      if (f.v < 3.13 || f.v > 3.15) {
        return 500;
      }
    },
    _ => {
      return 501;
    }
  }

  // Float arithmetic: `1.5 + 2.5` → 4.0.
  let r51: Value = run_source("return 1.5 + 2.5;");
  match (r51) {
    VFloat(f) => {
      if (f.v < 3.99 || f.v > 4.01) {
        return 510;
      }
    },
    _ => {
      return 511;
    }
  }

  // Float multiplication: `2.5 * 4.0` → 10.0.
  let r52: Value = run_source("return 2.5 * 4.0;");
  match (r52) {
    VFloat(f) => {
      if (f.v < 9.99 || f.v > 10.01) {
        return 520;
      }
    },
    _ => {
      return 521;
    }
  }

  // Float comparison: `3.14 > 3.0` → true.
  let r53: Value = run_source("return 3.14 > 3.0;");
  match (r53) {
    VBool(b) => {
      if (!b.v) {
        return 530;
      }
    },
    _ => {
      return 531;
    }
  }

  // Float equality through ==: `1.5 == 1.5` → true.
  let r54: Value = run_source("return 1.5 == 1.5;");
  match (r54) {
    VBool(b) => {
      if (!b.v) {
        return 540;
      }
    },
    _ => {
      return 541;
    }
  }

  // Mixed-numeric `+` is rejected: `1 + 2.5` → VErr.
  let r55: Value = run_source("return 1 + 2.5;");
  match (r55) {
    VErr(_) => {},
    _ => {
      return 550;
    }
  }

  // Float division: `10.0 / 4.0` → 2.5.
  let r56: Value = run_source("return 10.0 / 4.0;");
  match (r56) {
    VFloat(f) => {
      if (f.v < 2.49 || f.v > 2.51) {
        return 560;
      }
    },
    _ => {
      return 561;
    }
  }

  // Unary minus on a float: `-3.5` → -3.5.
  let r57: Value = run_source("return 0.0 - 3.5;");
  match (r57) {
    VFloat(f) => {
      if (f.v > 0.0 - 3.49 || f.v < 0.0 - 3.51) {
        return 570;
      }
    },
    _ => {
      return 571;
    }
  }

  return 0;
}

