// examples/self_host/interp.fern — fourth concrete step of the
// self-host port. Imports lexer + parser and evaluates the
// Stmt[] tree directly, producing a runtime value rather than a
// static type or compiled artifact. Completes the
// lexer → parser → interpreter vertical slice in Fern —
// the Fern-port pipeline can now actually run Fern code, end to
// end, from a thin self-validating driver.
//
// Scope (matches the parser's): i32 / bool / string runtime
// values, var binding through a flat scope, arithmetic /
// comparison / logical / string-concat ops over the same op
// set the checker (#619) handles. The return value of the first
// `return` statement is what main() surfaces — anything past it
// is dead code.
//
// Out of scope (next iteration): function decls + calls, control
// flow (`if` / `while` / `for`), structs / unions, generics. The
// parser stub doesn't emit those yet either.

import "./lexer";
import "./parser";
import "./util";

// =================== VALUES ====================

pub struct VInt { v: i32 }
// VInt64 holds an integer beyond i32 range (an i64 literal or the result
// of i64 arithmetic). The value is stored as two i32 halves rather than a
// single i64 field on purpose: a union variant carrying a raw i64 payload
// trips a native-backend codegen fault in the compiled interpreter (the
// i64 slot is mishandled on the drop path), whereas two i32 fields are
// laid out and dropped cleanly. The full i64 is reconstructed into a local
// only for arithmetic (local i64s are fine); it never lives in the union.
pub struct VInt64 { hi: i32, lo: i32 }
// VUint carries a u32 as its 32-bit pattern in an i32 field. Unsigned
// semantics (div / rem / compares / logical `>>`, docs/INTEGER-SEMANTICS.md)
// live in eval_binary's unsigned dispatch; `+ - * & | ^ <<` are
// bit-identical to signed i32 and compute on the pattern directly.
pub struct VUint { v: i32 }
pub struct VBool { v: boolean }
pub struct VString { v: string }
// VFloat carries a 64-bit IEEE 754 float. Literals tagged
// `is_float = true` by the parser produce a VFloat; arithmetic
// + comparison operators on two VFloats stay in float-land.
// Mixed i32/f64 isn't supported — explicit cast at the source
// level would route through a future numeric coercion pass.
pub struct VFloat { v: f64 }
// VFloat32 carries an f32-precision value as the ALREADY-ROUNDED f64
// (the native pipelines' f32 model, #4366): arithmetic computes at f64,
// then the result rounds to single precision via f32_round, and the
// f32 tag stays sticky through operator chains.
pub struct VFloat32 { v: f64 }
pub struct VArr { elements: Value[] }
// VTuple holds an immutable fixed-arity sequence of values.
// Each slot's runtime type stays whatever the source emitted;
// `.0` / `.1` / … indices read positionally.
pub struct VTuple { elements: Value[] }
// VFunc is a first-class callable value (a closure). It captures
// the lambda's body / params / ret_type plus the scope at the
// point of construction so free identifiers in the body resolve
// against the enclosing function's bindings rather than the
// caller's.
pub struct VFunc { params: parser.ParamDecl[], ret_type: string, body: parser.Stmt[], captured_names: string[], captured_values: Value[] }
// VMap models the runtime hash-map. Parallel arrays for keys
// and values keep the implementation trivial — lookup is a
// linear scan via value_eq. Realistic-size programs would
// route through std/map's hash table; this is the self-host
// port's minimal-viable storage.
pub struct VMap { keys: Value[], values: Value[] }
// VStruct holds a user-defined struct value. Parallel arrays
// for field names and corresponding evaluated values.
// type_name is the struct's declared name — useful for
// diagnostics and (later) for struct-aware equality.
pub struct VStruct { type_name: string, field_names: string[], field_values: Value[] }
pub struct VErr { msg: string }

// VErr is the bottom of the value lattice — it propagates
// silently through every operator that touches it so the first
// error wins. Mirrors how the checker's TypeUnknown works.

// VCellI / VCellF are the by-reference binding for a MUTABLE SCALAR CAPTURE
// (SH-057 / #2850). The language deliberately splits capture semantics: scalars
// are captured by reference and a closure may write them (closures-as-counters
// is a supported feature), while reference-typed captures are read-only (E049)
// precisely so a write-back cannot close an RC cycle — the same no-cycles model
// Roc uses. Env is persistent (bind/update return fresh copies), so there is no
// shared mutable state to write through; a cell supplies exactly that, and only
// for the scalar cases the language allows. Cell's own element-type restriction
// (E057: scalars and strings, no composites, for the same cycle reason) lines up
// with E049's, which is why this needs two scalar-shaped variants rather than a
// single Cell[Value].
pub struct VCellI { c: Cell[i32] }
pub struct VCellF { c: Cell[f64] }

// VTry is the `expr?` early-return in flight. `?` on a None / Err unwinds to
// the enclosing function's return, which a value-returning eval_unary cannot
// do on its own — so it yields this marker carrying the box to return, and
// is_err reports it as abrupt so the existing "propagate the first error"
// plumbing (`if (is_err(v)) { return v; }`, at every operand site) carries it
// out of the expression for free. Every function boundary — call_func,
// call_method, call_closure — unwraps it back into `box` as that function's
// return value, which is what keeps the unwind from escaping one frame too
// far. Distinct from VErr: an unwind is a normal result of a correct program,
// not a diagnostic.
pub struct VTry { box: Value }
pub type Value = VInt | VInt64 | VUint | VBool | VString | VFloat | VFloat32 | VArr | VTuple | VFunc | VMap | VStruct | VCellI | VCellF | VErr | VTry;

function v_int(n: i32): Value { return VInt { v: n }; }
// v_int64 packs an i64 into a VInt64's two i32 halves; unpack_i64 rebuilds
// the i64. `lo` keeps the low 32 bits (masked so a negative low half isn't
// sign-extended into the high word); `hi` is the arithmetic-shifted top 32.
function v_int64(n: i64): Value { return VInt64 { hi: (n >> 32) as i32, lo: (n & 4294967295) as i32 }; }
function unpack_i64(x: VInt64): i64 {
    // The low-32 mask is held in a local, NOT written inline as
    // `& 4294967295`: the native backend mis-emits that i64 literal as a
    // sign-extended 32-bit immediate (-1), so an inline mask is a no-op and
    // a negative `lo` stays sign-extended into the high word (which then
    // corrupts e.g. an i64 divide). A `var` forces a full 64-bit load.
    var lo_mask: i64 = 4294967295;
    return ((x.hi as i64) << 32) | ((x.lo as i64) & lo_mask);
}
function v_uint(n: i32): Value { return VUint { v: n }; }
// uint_zext zero-extends a u32 bit pattern to i64 — the value plane for
// unsigned div / rem / compares / logical shift. The mask lives in a local
// for the same native-backend immediate reason as unpack_i64's.
function uint_zext(n: i32): i64 {
    var lo_mask: i64 = 4294967295;
    return (n as i64) & lo_mask;
}
// box_i64 narrows an i64 result back to a compact VInt when it fits i32,
// so values that fall back into range don't stay wide (and downstream i32
// consumers keep seeing a VInt). Only genuinely-wide results stay VInt64.
function box_i64(n: i64): Value {
    if (n >= -2147483648 && n <= 2147483647) { return v_int(n as i32); }
    return v_int64(n);
}
// coerce_int_width promotes a compact VInt to a VInt64 when a binding's
// declared type is a 64-bit integer, so arithmetic on it takes the 64-bit
// path even when the value happens to fit i32 — `var x: i64 = 100000;
// x * 100000` must not overflow as i32. The interpreter is otherwise
// untyped at the value level, so this declared-type hint at var/param
// binding sites is where width intent enters.
function coerce_int_width(val: Value, type_name: string): Value {
    if (type_name == "i64" || type_name == "u64") {
        match (val) {
            VInt(i) => { return v_int64(i.v as i64); },
            _ => { return val; }
        }
    }
    // A declared u32 tags the 32-bit pattern unsigned (a wide VInt64
    // initializer contributes its low word); a declared f32 rounds the
    // value to single precision and tags it sticky.
    if (type_name == "u32") {
        match (val) {
            VInt(i) => { return v_uint(i.v); },
            VInt64(i) => { return v_uint(i.lo); },
            _ => { return val; }
        }
    }
    if (type_name == "f32") {
        match (val) {
            VFloat(f) => { return v_float32(f.v); },
            VInt(i) => { return v_float32(i.v as f64); },
            VInt64(i) => { return v_float32(unpack_i64(i) as f64); },
            _ => { return val; }
        }
    }
    return val;
}
// is_int_like / is_vint64 / vint_as_i64 bridge the integer variants so
// integer arithmetic can widen to 64 bits when either operand is a VInt64
// (a VUint contributes its ZERO-extended value in that context).
function is_int_like(v: Value): boolean {
    match (v) { VInt(_) => { return true; }, VInt64(_) => { return true; }, VUint(_) => { return true; }, _ => { return false; } }
}
function is_vint64(v: Value): boolean {
    match (v) { VInt64(_) => { return true; }, _ => { return false; } }
}
function vint_as_i64(v: Value): i64 {
    match (v) { VInt(i) => { return i.v as i64; }, VInt64(i) => { return unpack_i64(i); }, VUint(u) => { return uint_zext(u.v); }, _ => { return 0; } }
}
// is_vuint / vint_bits mirror the pair above for the 32-bit unsigned
// dispatch: vint_bits reads the raw 32-bit pattern of a compact carrier
// (VInt or VUint) for the sign-agnostic ops.
function is_vuint(v: Value): boolean {
    match (v) { VUint(_) => { return true; }, _ => { return false; } }
}
function vint_bits(v: Value): i32 {
    match (v) { VInt(i) => { return i.v; }, VUint(u) => { return u.v; }, _ => { return 0; } }
}
// is_float_like / is_vfloat32 / vfloat_as_f64 are the float-side bridges:
// a VFloat32's payload is already rounded, so reading it as f64 is exact.
function is_float_like(v: Value): boolean {
    match (v) { VFloat(_) => { return true; }, VFloat32(_) => { return true; }, _ => { return false; } }
}
function is_vfloat32(v: Value): boolean {
    match (v) { VFloat32(_) => { return true; }, _ => { return false; } }
}
function vfloat_as_f64(v: Value): f64 {
    match (v) { VFloat(f) => { return f.v; }, VFloat32(f) => { return f.v; }, _ => { return 0.0; } }
}
function v_bool(b: boolean): Value { return VBool { v: b }; }
function v_string(s: string): Value { return VString { v: s }; }
function v_float(n: f64): Value { return VFloat { v: n }; }
// f32_round rounds an f64 to single precision. The demote rides the
// f32_bits / f32_from_bits builtin pair (not a bare `as f32` round-trip):
// every pipeline that runs this interpreter special-cases the pair with a
// real cvtsd2ss/cvtss2sd narrowing, whereas the legacy self-host AST
// backend treats float→f32 `as` casts as no-ops.
function f32_round(x: f64): f64 { return (f32_from_bits(f32_bits(x as f32))) as f64; }
function v_float32(x: f64): Value { return VFloat32 { v: f32_round(x) }; }
function v_arr(elements: Value[]): Value { return VArr { elements: elements }; }
function v_tuple(elements: Value[]): Value { return VTuple { elements: elements }; }
function v_map(keys: Value[], values: Value[]): Value { return VMap { keys: keys, values: values }; }
function v_map_new(): Value {
    var ks: Value[] = [];
    var vs: Value[] = [];
    return VMap { keys: ks, values: vs };
}
function v_struct(type_name: string, names: string[], values: Value[]): Value {
    return VStruct { type_name: type_name, field_names: names, field_values: values };
}
function v_err(msg: string): Value { return VErr { msg: msg }; }

// is_err reports an ABRUPT value — one that must propagate out of the
// enclosing expression rather than being operated on. Both bottoms qualify:
// VErr (a diagnostic, which runs to the top) and VTry (a `?` unwind, which
// every function boundary catches and converts back into a return value).
function is_err(v: Value): boolean {
    match (v) {
        VErr(_) => { return true; },
        VTry(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// unwrap_try converts a `?` unwind that reached a function boundary into that
// function's return value — the box (`None` / `Err(e)`) the operand carried.
// A VErr or an ordinary value passes through untouched.
function unwrap_try(v: Value): Value {
    match (v) {
        VTry(t) => { return t.box; },
        _ => { return v; }
    }
    return v;
}

// is_builtin_variant_name names the four Option / Result constructors. They
// are declared nowhere a program can see — the parser has no enum decl for
// them and modload injects no module — so `Some(42)` reaches eval_expr as a
// plain call to an undefined name and `None` as an unbound identifier. Both build
// the same payload-variant VStruct a user enum's `E.Some(x)` / `E.Red` build,
// so match arms, `variant_simple_name` and value_eq need no Option-specific
// case (#5990).
function is_builtin_variant_name(name: string): boolean {
    return name == "Some" || name == "None" || name == "Ok" || name == "Err";
}

// user_func_exists reports whether the module declares a non-method function
// of this name. A program is free to define its own `Ok(...)`; the declaration
// wins, so the builtin constructor is only reached when nothing else answers.
function user_func_exists(name: string, funcs: parser.FuncDecl[]): boolean {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == name && funcs[i].receiver_name.len() == 0) { return true; }
        i = i + 1;
    }
    return false;
}

// v_variant builds the runtime shape a payload enum variant has: a VStruct
// tagged with the variant name whose fields carry the parser's synthesised
// `__ev` / `__ev1` / … names, which is the marker StmtMatch keys on to bind a
// `V(a, b, …)` pattern positionally. A nullary variant has no fields.
function v_variant(name: string, args: Value[]): Value {
    var vnames: string[] = [];
    var vi: i32 = 0;
    while (vi < args.len()) {
        if (vi == 0) { vnames = vnames.append("__ev"); }
        else { vnames = vnames.append("__ev" + util.i32_to_string(vi)); }
        vi = vi + 1;
    }
    return v_struct(name, vnames, args);
}

// =================== SCOPE ====================

// Same shape as the checker's Scope but the parallel slot is
// Value rather than Type. Linear scan, newest binding wins —
// matches `let` semantics for the limited stmt set we handle.
// Env carries both the value scope and the immutable function
// table (so ExprCall can dispatch from anywhere a value lives in
// scope). bind / update / trim preserve `funcs` unchanged.
// aliases carries the module's `pub type X = A | B` decls so
// call_method can dispatch a method declared on a union (e.g.
// `function (sh: Shape) area()`) when the receiver is one of
// the union's variant structs.
pub struct Env { names: string[], values: Value[], funcs: parser.FuncDecl[], aliases: parser.TypeAlias[] }

function new_env(): Env {
    var ns: string[] = [];
    var vs: Value[] = [];
    var fs: parser.FuncDecl[] = [];
    var al: parser.TypeAlias[] = [];
    return Env { names: ns, values: vs, funcs: fs, aliases: al };
}

function new_env_with_funcs(fs: parser.FuncDecl[]): Env {
    var ns: string[] = [];
    var vs: Value[] = [];
    var al: parser.TypeAlias[] = [];
    return Env { names: ns, values: vs, funcs: fs, aliases: al };
}

function new_env_with_funcs_aliases(fs: parser.FuncDecl[], al: parser.TypeAlias[]): Env {
    var ns: string[] = [];
    var vs: Value[] = [];
    return Env { names: ns, values: vs, funcs: fs, aliases: al };
}

function (e: Env) bind(name: string, v: Value): Env {
    var ns: string[] = e.names.append(name);
    var vs: Value[] = e.values.append(v);
    return Env { names: ns, values: vs, funcs: e.funcs, aliases: e.aliases };
}

function (e: Env) lookup(name: string): Value {
    var i: i32 = e.names.len() - 1;
    while (i >= 0) {
        if (e.names[i] == name) { return deref_cell(e.values[i]); }
        i = i - 1;
    }
    return v_err("undefined identifier: " + name);
}

// deref_cell reads through a mutable-scalar-capture cell (SH-057). Every read
// path goes via lookup, so a VCell* is never observed by the rest of the
// interpreter — it exists only in the Env slot and in the closure snapshot that
// shares it. Non-cell values pass straight through.
function deref_cell(v: Value): Value {
    match (v) {
        VCellI(ci) => { return v_int(ci.c.get()); },
        VCellF(cf) => { return VFloat { v: cf.c.get() }; },
        _ => { return v; }
    }
}

// cell_slot_set writes through a cell slot, returning true when `v` was one.
// The Env is left alone in that case: the mutation lives in the cell, which the
// enclosing scope and every closure that captured it already share.
function cell_slot_set(slot: Value, v: Value): boolean {
    match (slot) {
        VCellI(ci) => {
            match (v) {
                VInt(n) => { ci.c.set(n.v); return true; },
                VBool(bb) => { if (bb.v) { ci.c.set(1); } else { ci.c.set(0); } return true; },
                _ => { return false; }
            }
        },
        VCellF(cf) => {
            match (v) {
                VFloat(f) => { cf.c.set(f.v); return true; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// ---- mutable scalar captures: deciding which locals need a cell (SH-057) ----
//
// A local needs one exactly when some lambda in the same statement ASSIGNS to
// it. Reads alone are fine — the by-value snapshot already sees the right
// value — which is why the bug only ever showed on a write, and why the audit
// repro assigns without reading.
//
// The decision is made per STATEMENT rather than per function body: a lambda
// can appear in any expression position (a `var` init, a call argument, an
// array element), and doing it here means every one of those is covered by the
// same code path without threading a set through Env.

// lam_assign_targets collects assignment targets anywhere in a lambda body,
// including nested control flow and nested lambdas.
function lam_assign_targets(stmts: parser.Stmt[], acc: string[]): string[] {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtAssign(a) => { acc = acc.append(a.target); acc = lam_targets_expr(a.value, acc); },
            parser.StmtVar(v) => { acc = lam_targets_expr(v.init, acc); },
            parser.StmtReturn(r) => { acc = lam_targets_expr(r.value, acc); },
            parser.StmtExpr(x) => { acc = lam_targets_expr(x.value, acc); },
            parser.StmtIf(f) => {
                acc = lam_targets_expr(f.cond, acc);
                acc = lam_assign_targets(f.then_body, acc);
                acc = lam_assign_targets(f.else_body, acc);
            },
            parser.StmtWhile(w) => { acc = lam_targets_expr(w.cond, acc); acc = lam_assign_targets(w.body, acc); },
            parser.StmtFor(fo) => { acc = lam_targets_expr(fo.iter, acc); acc = lam_assign_targets(fo.body, acc); },
            parser.StmtMatch(m) => {
                acc = lam_targets_expr(m.scrutinee, acc);
                var ai: i32 = 0;
                while (ai < m.arms.len()) { acc = lam_assign_targets(m.arms[ai].body, acc); ai = ai + 1; }
            },
            _ => {}
        }
        i = i + 1;
    }
    return acc;
}

// lam_targets_expr recurses an expression for nested lambda bodies.
function lam_targets_expr(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprLambda(lm) => { return lam_assign_targets(lm.body, acc); },
        parser.ExprBinary(b) => { return lam_targets_expr(b.right, lam_targets_expr(b.left, acc)); },
        parser.ExprUnary(u) => { return lam_targets_expr(u.operand, acc); },
        parser.ExprIndex(ix) => { return lam_targets_expr(ix.index, lam_targets_expr(ix.array, acc)); },
        parser.ExprSlice(sl) => { return lam_targets_expr(sl.end, lam_targets_expr(sl.start, lam_targets_expr(sl.array, acc))); },
        parser.ExprFieldAccess(fa) => { return lam_targets_expr(fa.obj, acc); },
        parser.ExprCall(c) => {
            acc = lam_targets_expr(c.callee, acc);
            var i: i32 = 0;
            while (i < c.args.len()) { acc = lam_targets_expr(c.args[i], acc); i = i + 1; }
            return acc;
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { acc = lam_targets_expr(a.elements[i], acc); i = i + 1; }
            return acc;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { acc = lam_targets_expr(t.elements[i], acc); i = i + 1; }
            return acc;
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) { acc = lam_targets_expr(sl.field_values[i], acc); i = i + 1; }
            return acc;
        },
        _ => { return acc; }
    }
    return acc;
}

// ---- the OUTER-write clause of a mutable scalar capture (#5394 / #6578) ----
//
// The rule above cells a local because a LAMBDA writes it. This is the other
// direction, and the one that was never ported: the lambda only READS the
// local, and the ENCLOSING body reassigns it afterwards. A by-value snapshot
// freezes the pre-assignment value, so `var i = 0; var f = (x) => x + i;
// i = 3; f(0)` answered 0 here and 3 on every other engine.
//
// The reassignment guard is what keeps this narrow, and the narrowness is the
// whole point. A local the body never reassigns reads the same either way, so
// celling it is invisible — but a per-iteration `var n = k` captured in a loop
// MUST stay by value, and celling that would hand every closure the last
// iteration's n. Native answers 3 for that shape, not 6.

// ib_idents_expr / ib_idents_stmts collect every ident mentioned. Used only to
// approximate what a lambda READS: a superset is safe here because the result
// is intersected with the names the enclosing body actually reassigns, and
// cellify_env only touches names bound in this scope.
function ib_idents_expr(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprIdent(id) => { return acc.append(id.name); },
        parser.ExprLambda(lm) => { return ib_idents_stmts(lm.body, acc); },
        parser.ExprBinary(b) => { return ib_idents_expr(b.right, ib_idents_expr(b.left, acc)); },
        parser.ExprUnary(u) => { return ib_idents_expr(u.operand, acc); },
        parser.ExprIndex(ix) => { return ib_idents_expr(ix.index, ib_idents_expr(ix.array, acc)); },
        parser.ExprSlice(sl) => { return ib_idents_expr(sl.end, ib_idents_expr(sl.start, ib_idents_expr(sl.array, acc))); },
        parser.ExprFieldAccess(fa) => { return ib_idents_expr(fa.obj, acc); },
        parser.ExprCall(c) => {
            var a1: string[] = ib_idents_expr(c.callee, acc);
            var i: i32 = 0;
            while (i < c.args.len()) { a1 = ib_idents_expr(c.args[i], a1); i = i + 1; }
            return a1;
        },
        parser.ExprArray(ar) => {
            var a2: string[] = acc;
            var j: i32 = 0;
            while (j < ar.elements.len()) { a2 = ib_idents_expr(ar.elements[j], a2); j = j + 1; }
            return a2;
        },
        parser.ExprTuple(t) => {
            var a3: string[] = acc;
            var k: i32 = 0;
            while (k < t.elements.len()) { a3 = ib_idents_expr(t.elements[k], a3); k = k + 1; }
            return a3;
        },
        parser.ExprStructLit(sl2) => {
            var a4: string[] = acc;
            if (sl2.has_base) { a4 = ib_idents_expr(sl2.base, a4); }
            var m: i32 = 0;
            while (m < sl2.field_values.len()) { a4 = ib_idents_expr(sl2.field_values[m], a4); m = m + 1; }
            return a4;
        },
        _ => { return acc; }
    }
    return acc;
}
function ib_idents_stmts(stmts: parser.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => { a = ib_idents_expr(v.init, a); },
            parser.StmtAssign(asg) => { a = a.append(asg.target); a = ib_idents_expr(asg.value, a); },
            parser.StmtReturn(r) => { a = ib_idents_expr(r.value, a); },
            parser.StmtExpr(x) => { a = ib_idents_expr(x.value, a); },
            parser.StmtIf(f) => { a = ib_idents_expr(f.cond, a); a = ib_idents_stmts(f.then_body, a); a = ib_idents_stmts(f.else_body, a); },
            parser.StmtWhile(w) => { a = ib_idents_expr(w.cond, a); a = ib_idents_stmts(w.body, a); },
            parser.StmtFor(fo) => { a = ib_idents_expr(fo.iter, a); a = ib_idents_stmts(fo.body, a); },
            parser.StmtMatch(m) => {
                a = ib_idents_expr(m.scrutinee, a);
                var ai: i32 = 0;
                while (ai < m.arms.len()) { a = ib_idents_stmts(m.arms[ai].body, a); ai = ai + 1; }
            },
            parser.StmtDefer(d) => { a = ib_idents_stmts([d.action], a); },
            _ => {}
        }
        i = i + 1;
    }
    return a;
}

// lam_reads_expr / lam_read_names: the names some lambda in `st` mentions. Only
// a LAMBDA body contributes, exactly as stmt_lambda_writes does — an ident in
// the statement's own expression is an ordinary read in this scope.
function lam_reads_expr(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprLambda(lm) => { return ib_idents_stmts(lm.body, acc); },
        parser.ExprBinary(b) => { return lam_reads_expr(b.right, lam_reads_expr(b.left, acc)); },
        parser.ExprUnary(u) => { return lam_reads_expr(u.operand, acc); },
        parser.ExprIndex(ix) => { return lam_reads_expr(ix.index, lam_reads_expr(ix.array, acc)); },
        parser.ExprSlice(sl) => { return lam_reads_expr(sl.end, lam_reads_expr(sl.start, lam_reads_expr(sl.array, acc))); },
        parser.ExprFieldAccess(fa) => { return lam_reads_expr(fa.obj, acc); },
        parser.ExprCall(c) => {
            var a1: string[] = lam_reads_expr(c.callee, acc);
            var i: i32 = 0;
            while (i < c.args.len()) { a1 = lam_reads_expr(c.args[i], a1); i = i + 1; }
            return a1;
        },
        parser.ExprArray(ar) => {
            var a2: string[] = acc;
            var j: i32 = 0;
            while (j < ar.elements.len()) { a2 = lam_reads_expr(ar.elements[j], a2); j = j + 1; }
            return a2;
        },
        parser.ExprTuple(t) => {
            var a3: string[] = acc;
            var k: i32 = 0;
            while (k < t.elements.len()) { a3 = lam_reads_expr(t.elements[k], a3); k = k + 1; }
            return a3;
        },
        parser.ExprStructLit(sl2) => {
            var a4: string[] = acc;
            if (sl2.has_base) { a4 = lam_reads_expr(sl2.base, a4); }
            var m: i32 = 0;
            while (m < sl2.field_values.len()) { a4 = lam_reads_expr(sl2.field_values[m], a4); m = m + 1; }
            return a4;
        },
        _ => { return acc; }
    }
    return acc;
}
function lam_read_names(st: parser.Stmt): string[] {
    var acc: string[] = [];
    match (st) {
        parser.StmtVar(v) => { return lam_reads_expr(v.init, acc); },
        parser.StmtAssign(a) => { return lam_reads_expr(a.value, acc); },
        parser.StmtReturn(r) => { return lam_reads_expr(r.value, acc); },
        parser.StmtExpr(x) => { return lam_reads_expr(x.value, acc); },
        _ => { return acc; }
    }
    return acc;
}

// body_assign_names: every name this body reassigns, at any depth. A name NOT
// in here is captured by value, which is what keeps a loop-local `var` per
// iteration.
function body_assign_names(stmts: parser.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtAssign(asg) => { a = a.append(asg.target); },
            parser.StmtIf(f) => { a = body_assign_names(f.then_body, a); a = body_assign_names(f.else_body, a); },
            parser.StmtWhile(w) => { a = body_assign_names(w.body, a); },
            parser.StmtFor(fo) => { a = body_assign_names(fo.body, a); },
            parser.StmtMatch(m) => { var ai: i32 = 0; while (ai < m.arms.len()) { a = body_assign_names(m.arms[ai].body, a); ai = ai + 1; } },
            parser.StmtDefer(d) => { a = body_assign_names([d.action], a); },
            _ => {}
        }
        i = i + 1;
    }
    return a;
}

// cellify_outer_writes applies the clause: a name a lambda in `st` reads AND
// this body reassigns becomes a shared cell before the closure snapshots it.
function cellify_outer_writes(env: Env, st: parser.Stmt, reassigned: string[]): Env {
    if (reassigned.len() == 0) { return env; }
    var reads: string[] = lam_read_names(st);
    var hit: string[] = [];
    var i: i32 = 0;
    while (i < reads.len()) {
        if (util.index_of_str(reassigned, reads[i]) >= 0) { hit = hit.append(reads[i]); }
        i = i + 1;
    }
    if (hit.len() == 0) { return env; }
    return cellify_env(env, hit);
}

// stmt_lambda_writes lists the names some lambda in `st` assigns to.
function stmt_lambda_writes(st: parser.Stmt): string[] {
    var one: parser.Stmt[] = [st];
    var acc: string[] = [];
    // Only a lambda body contributes: walk the statement's EXPRESSIONS, never
    // its own top-level assignments (those are ordinary writes in this scope).
    match (st) {
        parser.StmtVar(v) => { return lam_targets_expr(v.init, acc); },
        parser.StmtAssign(a) => { return lam_targets_expr(a.value, acc); },
        parser.StmtReturn(r) => { return lam_targets_expr(r.value, acc); },
        parser.StmtExpr(x) => { return lam_targets_expr(x.value, acc); },
        _ => { return acc; }
    }
    return acc;
}

// raw_slot reads a slot WITHOUT the lookup deref — cellify needs to see whether
// a binding is already a cell.
function (e: Env) raw_slot(name: string): i32 {
    var i: i32 = e.names.len() - 1;
    while (i >= 0) {
        if (e.names[i] == name) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

// cellify_env converts each named scalar binding into a shared cell, so the
// closure about to be built and the enclosing scope write through the same one.
function cellify_env(e: Env, names: string[]): Env {
    var out: Env = e;
    var i: i32 = 0;
    while (i < names.len()) {
        var idx: i32 = out.raw_slot(names[i]);
        if (idx >= 0) {
            var cur: Value = out.values[idx];
            var boxed: Value = cell_for(cur);
            // cell_for returns its argument unchanged for a non-scalar (E049
            // keeps those read-only) and for an already-celled slot, so this
            // is idempotent and never re-seeds a live cell.
            if (!is_cell(cur)) { out = out.update(names[i], boxed); }
        }
        i = i + 1;
    }
    return out;
}

function is_cell(v: Value): boolean {
    match (v) {
        VCellI(_) => { return true; },
        VCellF(_) => { return true; },
        _ => { return false; }
    }
}

// cell_for makes the by-reference binding for a mutable scalar capture, or
// returns `v` unchanged when it is not a scalar the language lets a closure
// write (E049 keeps reference captures read-only).
function cell_for(v: Value): Value {
    match (v) {
        VInt(n) => { return VCellI { c: cell_new(n.v) }; },
        VBool(bb) => { if (bb.v) { return VCellI { c: cell_new(1) }; } return VCellI { c: cell_new(0) }; },
        VFloat(f) => { return VCellF { c: cell_new(f.v) }; },
        _ => { return v; }
    }
}

// update mutates the slot for an existing name. Linear back-to-
// front scan so the most-recent shadowing binding wins (matches
// lookup). Returns a fresh Env — the parallel-array shape is
// rebuilt with the slot replaced because the underlying arrays
// are value-typed (push returns a new array). Returns the
// original env unchanged when the name isn't bound; the checker
// is supposed to surface that as a type error, but the interp
// guards against it via VErr-on-read at the call site.
function (e: Env) update(name: string, v: Value): Env {
    var n: i32 = e.names.len();
    var ns: string[] = [];
    var vs: Value[] = [];
    var found: boolean = false;
    var i: i32 = n - 1;
    // Walk from the end forward, recording which index to
    // replace. Then rebuild forward to keep declaration order.
    var hit_idx: i32 = 0 - 1;
    while (i >= 0) {
        if (!found && e.names[i] == name) {
            hit_idx = i;
            found = true;
        }
        i = i - 1;
    }
    if (!found) { return e; }
    var j: i32 = 0;
    while (j < n) {
        ns = ns.append(e.names[j]);
        if (j == hit_idx) {
            vs = vs.append(v);
        } else {
            vs = vs.append(e.values[j]);
        }
        j = j + 1;
    }
    return Env { names: ns, values: vs, funcs: e.funcs, aliases: e.aliases };
}

// =================== INTEGER PARSE ====================

// The parser hands us a TokNumber whose text is the original
// digit run. Turn that into an i32. No suffix handling here —
// we lump everything into i32 at this layer, mirroring the
// checker's TypeI32-only stance for the first cut.
// str_to_i32 now lives in util.fern (imported as `util`). See SH-020.

// str_to_f64 parses a decimal float literal: an optional `-`,
// integer digits, optional `.` + fractional digits, and an
// optional `e`/`E` exponent with an optional sign. Walks the
// integer part first, then the fractional part with a 1/10**k
// divisor, then scales by 10**exp. (The exponent scaling is a
// minimal power-of-ten loop — SH-004/#2849 tracks a correctly
// rounding decimal parser; this only stops `1e3` losing its
// exponent entirely, #4342.)
function str_to_f64(s: string): f64 {
    var n: i32 = s.len();
    var neg: boolean = false;
    var i: i32 = 0;
    if (n > 0 && s[0] == 45) { neg = true; i = 1; }  // '-' = 0x2D
    var int_part: f64 = 0.0;
    var frac_part: f64 = 0.0;
    var divisor: f64 = 1.0;
    var seen_dot: boolean = false;
    while (i < n) {
        var b: i32 = s[i] as i32;
        if (b == 46) { seen_dot = true; i = i + 1; continue; }  // '.' = 0x2E
        if (b < 48 || b > 57) { break; }
        var d: i32 = b - 48;
        var df: f64 = (d as f64);
        if (seen_dot) {
            divisor = divisor * 10.0;
            frac_part = frac_part + (df / divisor);
        } else {
            int_part = int_part * 10.0 + df;
        }
        i = i + 1;
    }
    var v: f64 = int_part + frac_part;
    // Exponent: `e`/`E`, an optional `+`/`-`, then digits. The mantissa loop
    // broke at the `e`, so `i` points at it here. `1e3` -> 1000.0, `1.5e-2` ->
    // 0.015. Applied before the mantissa sign so `-1e2` = -100.0.
    if (i < n && (s[i] == 101 || s[i] == 69)) {  // 'e' / 'E'
        i = i + 1;
        var exp_neg: boolean = false;
        if (i < n && (s[i] == 43 || s[i] == 45)) {  // '+' / '-'
            if (s[i] == 45) { exp_neg = true; }
            i = i + 1;
        }
        var exp: i32 = 0;
        while (i < n) {
            var eb: i32 = s[i] as i32;
            if (eb < 48 || eb > 57) { break; }
            exp = exp * 10 + (eb - 48);
            i = i + 1;
        }
        var k: i32 = 0;
        while (k < exp) {
            if (exp_neg) { v = v / 10.0; } else { v = v * 10.0; }
            k = k + 1;
        }
    }
    if (neg) { v = 0.0 - v; }
    return v;
}

// =================== EVAL ====================

// eval_expr: a depth-first walk of the parser's Expr tree.
// Errors propagate via VErr — the moment any sub-expression
// errors, the surrounding op returns the same VErr. This keeps
// the early-return pattern out of the body and matches the
// checker's TypeUnknown threading.
// is_sat_op_name reports whether `op` is a saturating arithmetic operator
// (`+|` / `-|` / `*|` / `<<|`, #5542) — clamping to the operand type's
// [MIN, MAX] rather than wrapping.
function is_sat_op_name(op: string): boolean {
    return op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

// sat_exact computes a saturating op EXACTLY in the host i64, valid only when
// both operands are 32-bit-or-narrower (so no host overflow is possible); the
// caller clamps the wide result to the operand type's range.
function sat_exact(op: string, a: i64, b: i64): i64 {
    if (op == "+|") { return a + b; }
    if (op == "-|") { return a - b; }
    // The count is masked to the 32-bit lane the callers work in, so the
    // widest exact product here is (2^32-1) * 2^31 — still inside i64.
    if (op == "<<|") { return a << (b & 31); }
    return a * b;
}

// sat_clamp clamps an exact result into [minv, maxv].
function sat_clamp(v: i64, minv: i64, maxv: i64): i64 {
    if (v > maxv) { return maxv; }
    if (v < minv) { return minv; }
    return v;
}

// sat_i64 saturates at full 64-bit width, where no wider host type exists.
// Add / sub pre-check against the bound; mul post-checks the WRAPPED product
// with a division round-trip, plus the `a == -1 && b == MIN` term that a total
// `MIN / -1 == MIN` would otherwise hide. Mirrors the IR lowering
// (irlower.lower_sat_binary) and native's ir.satBinary.
function sat_i64(op: string, a: i64, b: i64): i64 {
    var maxv: i64 = 9223372036854775807;
    var minv: i64 = 0 - 9223372036854775807 - 1;
    if (op == "+|") {
        if (b > 0 && a > maxv - b) { return maxv; }
        if (b < 0 && a < minv - b) { return minv; }
        return a + b;
    }
    if (op == "-|") {
        if (b < 0 && a > maxv + b) { return maxv; }
        if (b > 0 && a < minv + b) { return minv; }
        return a - b;
    }
    if (op == "<<|") {
        // Round-trip check: at 64 bits there is no wider host type to
        // compute the exact result in, and the negative-side pre-check
        // bound would need a ceiling division an arithmetic shift cannot
        // give. `>>` is arithmetic, so it restores `a` iff nothing was
        // shifted out.
        var sc: i64 = b & 63;
        var sh: i64 = a << sc;
        if ((sh >> sc) == a) { return sh; }
        if (a < 0) { return minv; }
        return maxv;
    }
    var prod: i64 = a * b;
    if (a != 0) {
        var bad: boolean = prod / a != b;
        if (a == 0 - 1 && b == minv) { bad = true; }
        if (bad) {
            var neg: boolean = false;
            if (a < 0) { neg = !neg; }
            if (b < 0) { neg = !neg; }
            if (neg) { return minv; }
            return maxv;
        }
    }
    return prod;
}

// eval_binary applies a binary operator to two already-evaluated
// operands. Pure in (op, lv, rv) — extracted from eval_expr's
// ExprBinary arm so the operator semantics live in one place,
// mirroring the VM's apply_binary (SH-048).
function eval_binary(op: string, lv: Value, rv: Value): Value {
    // 64-bit integer arithmetic: when either operand is a VInt64, widen
    // both to i64, compute in 64 bits, then box back (narrowing to a VInt
    // when the result fits i32). The pure VInt (i32) path below is left
    // untouched, so i32 overflow wrapping and every existing case behave
    // exactly as before. Total div/mod semantics match the i32 path
    // (x/0 == 0, x%0 == x).
    if (is_int_like(lv) && is_int_like(rv) && (is_vint64(lv) || is_vint64(rv))) {
        var a: i64 = vint_as_i64(lv);
        var b: i64 = vint_as_i64(rv);
        // An i64-typed operation always yields a VInt64, even when the
        // result happens to fit i32: narrowing here would strip the width
        // from e.g. a running accumulator (`s = s + 1000000000` whose
        // partial sum dips into i32 range), so the next op would wrap on
        // the i32 path. Only literals narrow by magnitude (box_i64 in
        // ExprNumber); an explicit `as i32` is the way back to a VInt.
        if (op == "+") { return v_int64(a + b); }
        if (op == "-") { return v_int64(a - b); }
        if (op == "*") { return v_int64(a * b); }
        if (is_sat_op_name(op)) { return v_int64(sat_i64(op, a, b)); }
        if (op == "/") { if (b == 0) { return v_int64(0); } var q64: i64 = a / b; return v_int64(q64); }
        if (op == "%") { if (b == 0) { return v_int64(a); } var r64: i64 = a % b; return v_int64(r64); }
        if (op == "<") { return v_bool(a < b); }
        if (op == "<=") { return v_bool(a <= b); }
        if (op == ">") { return v_bool(a > b); }
        if (op == ">=") { return v_bool(a >= b); }
        if (op == "==") { return v_bool(a == b); }
        if (op == "!=") { return v_bool(a != b); }
        if (op == "&") { return v_int64(a & b); }
        if (op == "|") { return v_int64(a | b); }
        if (op == "^") { return v_int64(a ^ b); }
        if (op == "<<") { return v_int64(a << b); }
        if (op == ">>") { return v_int64(a >> b); }
    }
    // Unsigned 32-bit dispatch (docs/INTEGER-SEMANTICS.md): when either
    // compact operand is a VUint, div / rem / compares / `>>` run UNSIGNED
    // via zero-extension to i64 (shift counts masked &31, total division
    // x/0 == 0 and x%0 == x), and `+ - * & | ^ <<` — bit-identical to
    // signed — compute on the 32-bit patterns. Arithmetic results stay
    // VUint (sticky); a VUint mixed with a VInt64 zero-extends through the
    // 64-bit block above instead.
    if (is_int_like(lv) && is_int_like(rv) && (is_vuint(lv) || is_vuint(rv))) {
        var la: i32 = vint_bits(lv);
        var rb: i32 = vint_bits(rv);
        if (op == "+") { return v_uint(la + rb); }
        if (op == "-") { return v_uint(la - rb); }
        if (op == "*") { return v_uint(la * rb); }
        if (is_sat_op_name(op)) {
            return v_uint(sat_clamp(sat_exact(op, uint_zext(la), uint_zext(rb)), 0, 4294967295) as i32);
        }
        if (op == "&") { return v_uint(la & rb); }
        if (op == "|") { return v_uint(la | rb); }
        if (op == "^") { return v_uint(la ^ rb); }
        if (op == "<<") { return v_uint(la << (rb & 31)); }
        var ua: i64 = uint_zext(la);
        var ub: i64 = uint_zext(rb);
        if (op == ">>") {
            var sc: i64 = (rb & 31) as i64;
            var shifted: i64 = ua >> sc;
            return v_uint(shifted as i32);
        }
        if (op == "/") {
            if (ub == 0) { return v_uint(0); }
            var uq: i64 = ua / ub;
            return v_uint(uq as i32);
        }
        if (op == "%") {
            if (ub == 0) { return v_uint(la); }
            var ur: i64 = ua % ub;
            return v_uint(ur as i32);
        }
        if (op == "<") { return v_bool(ua < ub); }
        if (op == "<=") { return v_bool(ua <= ub); }
        if (op == ">") { return v_bool(ua > ub); }
        if (op == ">=") { return v_bool(ua >= ub); }
        if (op == "==") { return v_bool(la == rb); }
        if (op == "!=") { return v_bool(la != rb); }
    }
    // f32 dispatch (#4366 model): when either operand is a VFloat32 and
    // the other is numeric, compute at f64 and round the RESULT to single
    // precision, staying sticky as VFloat32. Comparisons compare the
    // (already rounded) f64 payloads and yield VBool.
    if ((is_vfloat32(lv) || is_vfloat32(rv)) && (is_float_like(lv) || is_int_like(lv)) && (is_float_like(rv) || is_int_like(rv))) {
        var fa: f64 = vfloat_as_f64(lv);
        if (is_int_like(lv)) { fa = vint_as_i64(lv) as f64; }
        var fb: f64 = vfloat_as_f64(rv);
        if (is_int_like(rv)) { fb = vint_as_i64(rv) as f64; }
        if (op == "+") { return v_float32(fa + fb); }
        if (op == "-") { return v_float32(fa - fb); }
        if (op == "*") { return v_float32(fa * fb); }
        if (op == "/") { return v_float32(fa / fb); }
        if (op == "%") { return v_err("`%` on f32 is unsupported"); }
        if (op == "<") { return v_bool(fa < fb); }
        if (op == "<=") { return v_bool(fa <= fb); }
        if (op == ">") { return v_bool(fa > fb); }
        if (op == ">=") { return v_bool(fa >= fb); }
        if (op == "==") { return v_bool(fa == fb); }
        if (op == "!=") { return v_bool(fa != fb); }
    }
    // Saturating arithmetic (#5542) on plain i32: the exact 64-bit result
    // always fits the host i64, so it is computed wide and clamped.
    if (is_sat_op_name(op)) {
        match (lv) {
            VInt(li) => {
                match (rv) {
                    VInt(ri) => {
                        var sv: i64 = sat_exact(op, li.v as i64, ri.v as i64);
                        return v_int(sat_clamp(sv, 0 - 2147483647 - 1, 2147483647) as i32);
                    },
                    _ => { return v_err("saturating rhs not i32"); }
                }
            },
            _ => { return v_err("saturating lhs not i32"); }
        }
    }
    // `+` overloads i32 (arithmetic) and string (concat).
    if (op == "+") {
        match (lv) {
            VInt(li) => {
                match (rv) {
                    VInt(ri) => { return v_int(li.v + ri.v); },
                    _ => { return v_err("`+` rhs not i32"); }
                }
            },
            VString(ls) => {
                match (rv) {
                    VString(rs) => { return v_string(ls.v + rs.v); },
                    _ => { return v_err("`+` rhs not string"); }
                }
            },
            VFloat(lf) => {
                match (rv) {
                    VFloat(rf) => { return v_float(lf.v + rf.v); },
                    _ => { return v_err("`+` rhs not f64"); }
                }
            },
            _ => { return v_err("`+` lhs not i32, string, or f64"); }
        }
    }
    if (op == "-" || op == "*" || op == "/" || op == "%") {
        match (lv) {
            VInt(li) => {
                match (rv) {
                    VInt(ri) => {
                        if (op == "-") { return v_int(li.v - ri.v); }
                        if (op == "*") { return v_int(li.v * ri.v); }
                        // Total division semantics (docs/INTEGER-SEMANTICS.md):
                        // `x / 0 == 0` and `x % 0 == x`, not a runtime error —
                        // matching native (#4348 item 6). The engine also
                        // shouldn't trap on data-dependent zero divisors.
                        if (op == "/") {
                            if (ri.v == 0) { return v_int(0); }
                            return v_int(li.v / ri.v);
                        }
                        if (ri.v == 0) { return v_int(li.v); }
                        return v_int(li.v % ri.v);
                    },
                    _ => { return v_err("arithmetic rhs not i32"); }
                }
            },
            VFloat(lf) => {
                match (rv) {
                    VFloat(rf) => {
                        if (op == "-") { return v_float(lf.v - rf.v); }
                        if (op == "*") { return v_float(lf.v * rf.v); }
                        // IEEE total semantics: `1.0/0.0` is +Inf and
                        // `0.0/0.0` is NaN, not a runtime error (#4348 item 6).
                        if (op == "/") {
                            return v_float(lf.v / rf.v);
                        }
                        // `%` on floats isn't supported — the
                        // semantics differ across languages
                        // and the parser side doesn't yet
                        // distinguish.
                        return v_err("`%` on f64 is unsupported");
                    },
                    _ => { return v_err("arithmetic rhs not f64"); }
                }
            },
            _ => { return v_err("arithmetic lhs not i32 or f64"); }
        }
    }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") {
        match (lv) {
            VInt(li) => {
                match (rv) {
                    VInt(ri) => {
                        if (op == "<") { return v_bool(li.v < ri.v); }
                        if (op == "<=") { return v_bool(li.v <= ri.v); }
                        if (op == ">") { return v_bool(li.v > ri.v); }
                        return v_bool(li.v >= ri.v);
                    },
                    _ => { return v_err("comparison rhs not i32"); }
                }
            },
            VFloat(lf) => {
                match (rv) {
                    VFloat(rf) => {
                        if (op == "<") { return v_bool(lf.v < rf.v); }
                        if (op == "<=") { return v_bool(lf.v <= rf.v); }
                        if (op == ">") { return v_bool(lf.v > rf.v); }
                        return v_bool(lf.v >= rf.v);
                    },
                    _ => { return v_err("comparison rhs not f64"); }
                }
            },
            _ => { return v_err("comparison lhs not i32 or f64"); }
        }
    }
    if (op == "==" || op == "!=") {
        var eq: boolean = value_eq(lv, rv);
        if (op == "==") { return v_bool(eq); }
        return v_bool(!eq);
    }
    if (op == "&&" || op == "||") {
        match (lv) {
            VBool(lb) => {
                match (rv) {
                    VBool(rb) => {
                        if (op == "&&") { return v_bool(lb.v && rb.v); }
                        return v_bool(lb.v || rb.v);
                    },
                    _ => { return v_err("logical rhs not bool"); }
                }
            },
            _ => { return v_err("logical lhs not bool"); }
        }
    }
    // Bitwise / shift ops on i32 (#4348 item 7) — previously unimplemented,
    // so any `& | ^ << >>` program evaluated to VErr (exit 254). The host
    // operators match the native i32 semantics (arithmetic `>>`, shift-count
    // masking as emitted by the compiler).
    if (op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>") {
        match (lv) {
            VInt(li) => {
                match (rv) {
                    VInt(ri) => {
                        if (op == "&") { return v_int(li.v & ri.v); }
                        if (op == "|") { return v_int(li.v | ri.v); }
                        if (op == "^") { return v_int(li.v ^ ri.v); }
                        if (op == "<<") { return v_int(li.v << ri.v); }
                        return v_int(li.v >> ri.v);
                    },
                    _ => { return v_err("bitwise rhs not i32"); }
                }
            },
            _ => { return v_err("bitwise lhs not i32"); }
        }
    }
    return v_err("unknown binary op: " + op);
}

// eval_unary applies a unary operator to an already-evaluated
// operand. Pure in (op, ov) — extracted from eval_expr's ExprUnary
// arm, mirroring eval_binary (SH-048).
function eval_unary(op: string, ov: Value): Value {
    if (op == "-") {
        match (ov) {
            VInt(i) => { return v_int(0 - i.v); },
            VInt64(i) => { return v_int64(0 - unpack_i64(i)); },
            VUint(u) => { return v_uint(0 - u.v); },
            VFloat(f) => { return v_float(0.0 - f.v); },
            VFloat32(f) => { return v_float32(0.0 - f.v); },
            _ => { return v_err("unary `-` operand not i32 or f64"); }
        }
    }
    if (op == "!") {
        match (ov) {
            VBool(b) => { return v_bool(!b.v); },
            _ => { return v_err("unary `!` operand not bool"); }
        }
    }
    // `expr as <Type>` numeric casts (desugared to `as_<Type>`).
    // The interp's numeric model is VInt (i32) + VFloat (f64): an
    // integer-target cast is identity on an int and truncates a
    // float; a float-target cast widens an int and is identity on a
    // float. Without these every cast fell through to the
    // "unknown unary op" error below.
    // `as u8` / `as byte` truncate to the low 8 bits at runtime (native masks
    // the value, e.g. `(255 + 1) as u8 == 0`) — the interp previously returned
    // the operand unchanged, so a u8 cast was a no-op (#4348 item 3, cast
    // slice). u8 is the only sub-i32 integer type in the language, so this is
    // the whole runtime-truncation surface. (An out-of-range u8 *literal* is a
    // separate compile-time E047, not a runtime concern here.)
    if (op == "as_u8" || op == "as_byte") {
        match (ov) {
            VInt(i) => { return v_int(i.v & 255); },
            VInt64(i) => { return v_int((unpack_i64(i) & 255) as i32); },
            VUint(u) => { return v_int(u.v & 255); },
            VFloat(f) => { return v_int((f.v as i32) & 255); },
            VFloat32(f) => { return v_int((f.v as i32) & 255); },
            _ => { return v_err("`as` integer cast operand not numeric"); }
        }
    }
    // `as i32` narrows a wider integer to 32 bits, SIGNED (a VInt64
    // truncates to its low 32 bits — this is what brings an i64 value back
    // into i32 range, e.g. `(5000000000 as i32)`; a VUint keeps its bit
    // pattern and drops the unsigned tag).
    if (op == "as_i32") {
        match (ov) {
            VInt(i) => { return v_int(i.v); },
            VInt64(i) => { return v_int(i.lo); },
            VUint(u) => { return v_int(u.v); },
            VFloat(f) => { return v_int(f.v as i32); },
            VFloat32(f) => { return v_int(f.v as i32); },
            _ => { return v_err("`as` integer cast operand not numeric"); }
        }
    }
    // `as u32` is the same 32-bit narrowing but tags the pattern unsigned
    // (a float truncates through i64 first so a value above i32.max keeps
    // its low 32 bits, matching native's cvttsd2si + 32-bit mask).
    if (op == "as_u32") {
        match (ov) {
            VInt(i) => { return v_uint(i.v); },
            VInt64(i) => { return v_uint(i.lo); },
            VUint(u) => { return ov; },
            VFloat(f) => { return v_uint((f.v as i64) as i32); },
            VFloat32(f) => { return v_uint((f.v as i64) as i32); },
            _ => { return v_err("`as` integer cast operand not numeric"); }
        }
    }
    // `as i64` / `as u64` keep 64-bit width: a VInt64 passes through, a
    // small VInt stays a VInt (an in-range value round-trips identically),
    // a VUint widens zero-extended, and a float widens to i64.
    if (op == "as_i64" || op == "as_u64") {
        match (ov) {
            VInt(i) => { return v_int(i.v); },
            VInt64(i) => { return ov; },
            VUint(u) => { return box_i64(uint_zext(u.v)); },
            VFloat(f) => { return v_int64(f.v as i64); },
            VFloat32(f) => { return v_int64(f.v as i64); },
            _ => { return v_err("`as` integer cast operand not numeric"); }
        }
    }
    if (op == "as_f64") {
        match (ov) {
            VInt(i) => { return v_float(i.v as f64); },
            VInt64(i) => { return v_float(unpack_i64(i) as f64); },
            VUint(u) => { return v_float(uint_zext(u.v) as f64); },
            VFloat(f) => { return v_float(f.v); },
            VFloat32(f) => { return v_float(f.v); },
            _ => { return v_err("`as` float cast operand not numeric"); }
        }
    }
    // `as f32` rounds to single precision and tags the result sticky (an
    // already-f32 value passes through — its payload is already rounded).
    if (op == "as_f32") {
        match (ov) {
            VInt(i) => { return v_float32(i.v as f64); },
            VInt64(i) => { return v_float32(unpack_i64(i) as f64); },
            VUint(u) => { return v_float32(uint_zext(u.v) as f64); },
            VFloat(f) => { return v_float32(f.v); },
            VFloat32(f) => { return ov; },
            _ => { return v_err("`as` float cast operand not numeric"); }
        }
    }
    // `expr?` (parsed as the unary `try_`): unwrap a Some / Ok payload, or
    // unwind the None / Err box out to the enclosing function's return via
    // VTry. The operand is the runtime shape v_variant builds, so the payload
    // is field 0 of a `__ev`-tagged VStruct. A `?` on anything else is a
    // checker error upstream (E042), so it can only be reached on an invalid
    // program (#5990).
    if (op == "try_") {
        match (ov) {
            VStruct(sv) => {
                if (sv.type_name == "Some" || sv.type_name == "Ok") {
                    if (sv.field_values.len() == 0) { return v_err("`?` on a payload-less " + sv.type_name); }
                    return sv.field_values[0];
                }
                if (sv.type_name == "None" || sv.type_name == "Err") { return VTry { box: ov }; }
                return v_err("`?` operand is not an Option or Result: " + sv.type_name);
            },
            _ => { return v_err("`?` operand is not an Option or Result"); }
        }
    }
    // A non-numeric `as <Type>` (`as_i32[]`, `as_string`, `as_Option[i32]`,
    // …) is a zero-cost type ascription — identity on the runtime value.
    // Pass the operand through unchanged (matching the AST/IR emitters, which
    // treat every non-numeric `as_<T>` as a no-op).
    if (op.len() > 3 && op[0:3] == "as_") { return ov; }
    return v_err("unknown unary op: " + op);
}

// eval_number_literal parses a numeric literal to a Value. Kept OUT of
// eval_expr's ExprNumber arm on purpose: inlining the i64 path (an extra
// i64 local, the range compare, and the digits_to_i64 / box_i64 calls)
// into the already-huge eval_expr pushed its arm64 frame / register
// pressure over a threshold and tripped a layout-sensitive native-codegen
// abort (the arm64 sibling of the #3425 x86 heap Heisenbug) — even though
// the logic is correct in isolation. A separate function keeps eval_expr
// small. Hex / binary literals keep i32 low-bits semantics via lit_to_i32
// (digits_to_i32/i64 stop at the `x`/`b` and yield 0, #4341); decimal
// literals parse as i64 so a value beyond i32 range survives, and box_i64
// narrows it back to a compact VInt when it fits.
function eval_number_literal(is_float: boolean, t: string): Value {
    if (is_float) { return v_float(str_to_f64(t)); }
    var hs: i32 = 0;
    if (t.len() > 0 && t[0] == 45) { hs = 1; }
    var is_radix: boolean = t.len() > hs + 1 && t[hs] == 48 && (t[hs + 1] == 120 || t[hs + 1] == 88 || t[hs + 1] == 98 || t[hs + 1] == 66);
    if (is_radix) { return v_int(util.lit_to_i32(t)); }
    return box_i64(util.digits_to_i64(t));
}

function eval_expr(e: parser.Expr, env: Env): Value {
    match (e) {
        parser.ExprNumber(n) => { return eval_number_literal(n.is_float, n.text); },
        parser.ExprBool(b) => { return v_bool(b.value); },
        parser.ExprString(s) => { return v_string(s.value); },
        parser.ExprIdent(id) => {
            var idv: Value = env.lookup(id.name);
            // A bare identifier with no local binding may name a
            // `const`: the parser desugars `const N = expr;` into a
            // zero-arg function `N()`, and the native compiler lowers a
            // bare `N` reference to a call. Mirror that here — if no
            // local binding exists but a zero-arg, non-method function
            // of this name does, evaluate it as a nullary call. Regular
            // zero-arg functions referenced bare are a checker error
            // (E002) upstream, so on valid programs this only fires for
            // consts.
            if (is_err(idv)) {
                var ci: i32 = 0;
                while (ci < env.funcs.len()) {
                    if (env.funcs[ci].name == id.name && env.funcs[ci].receiver_name.len() == 0 && env.funcs[ci].params.len() == 0) {
                        var no_args: Value[] = [];
                        return call_func(id.name, no_args, env.funcs, env.aliases);
                    }
                    ci = ci + 1;
                }
                // `None` — the one builtin Option / Result constructor that
                // takes no payload, so it appears as a bare identifier rather
                // than a call (#5990). The const lookup above runs first, so a
                // user `const None = …` still wins.
                if (id.name == "None") {
                    var none_args: Value[] = [];
                    return v_variant("None", none_args);
                }
            }
            return idv;
        },
        parser.ExprBinary(b) => {
            var lv: Value = eval_expr(b.left, env);
            if (is_err(lv)) { return lv; }
            // Short-circuit `&&` / `||`: the RHS is NOT evaluated when the LHS
            // already determines the result (#4348 item 5). Matches native and
            // keeps a guarded side-effecting / out-of-bounds RHS from running
            // (e.g. `i < len && a[i] == x`). The non-short-circuit path still
            // flows through eval_binary with both operands.
            if (b.op == "&&" || b.op == "||") {
                match (lv) {
                    VBool(lb) => {
                        if (b.op == "&&" && !lb.v) { return v_bool(false); }
                        if (b.op == "||" && lb.v) { return v_bool(true); }
                    },
                    _ => { },
                }
            }
            var rv: Value = eval_expr(b.right, env);
            if (is_err(rv)) { return rv; }
            return eval_binary(b.op, lv, rv);
        },
        parser.ExprUnary(u) => {
            var ov: Value = eval_expr(u.operand, env);
            if (is_err(ov)) { return ov; }
            return eval_unary(u.op, ov);
        },
        parser.ExprCall(c) => {
            // Bare-ident callee → plain function call OR
            // closure call when the name is bound to a VFunc.
            // FieldAccess callee → method call.
            // Any other expression evaluates to a callee value
            // — VFunc → closure call, else error.
            var name: string = "";
            var is_method: boolean = false;
            var is_closure: boolean = false;
            var is_variant: boolean = false;
            var variant_name: string = "";
            var recv: Value = v_err("__noreceiver__");
            var closure_val: Value = v_err("__noclosure__");
            match (c.callee) {
                parser.ExprIdent(id) => {
                    // If the name is bound in scope to a VFunc,
                    // it's a closure call. Plain function names
                    // shadow ident bindings via call_func's
                    // walk, but a `var f = function (...) {…}`
                    // binding is observable here.
                    var bound: Value = env.lookup(id.name);
                    match (bound) {
                        VFunc(_) => { is_closure = true; closure_val = bound; },
                        _ => { name = id.name; }
                    }
                    // `Some(x)` / `Ok(x)` / `Err(e)` — the builtin Option /
                    // Result constructors, which no function table declares.
                    // Checked after the VFunc probe and behind user_func_exists
                    // so a local closure or a user-declared function of the same
                    // name still wins (#5990).
                    if (!is_closure && is_builtin_variant_name(name) && !user_func_exists(name, env.funcs)) {
                        is_variant = true;
                        variant_name = name;
                    }
                },
                parser.ExprFieldAccess(fa) => {
                    // Qualified-name call: `Ns.func(...)` where
                    // Ns is an imported namespace prefix. We
                    // recognise this when fa.obj is a bare
                    // ExprIdent (no chained method) AND there's
                    // a function in env.funcs literally named
                    // `Ns.func`. Falls back to method-call
                    // semantics otherwise.
                    var qualified_handled: boolean = false;
                    match (fa.obj) {
                        parser.ExprIdent(ns_id) => {
                            var qname: string = ns_id.name + "." + fa.field;
                            var qi: i32 = 0;
                            var qfound: boolean = false;
                            while (qi < env.funcs.len()) {
                                if (env.funcs[qi].name == qname && env.funcs[qi].receiver_name.len() == 0) {
                                    qfound = true;
                                }
                                qi = qi + 1;
                            }
                            if (qfound) {
                                name = qname;
                                qualified_handled = true;
                            }
                        },
                        _ => { }
                    }
                    if (!qualified_handled) {
                        // `E.Some(x)` — a call whose callee object is a
                        // bare identifier with no runtime value is a
                        // payload enum-variant construction (the nullary
                        // sibling `E.Red` is handled on the ExprFieldAccess
                        // eval path). Anything with a real object value is a
                        // method call.
                        var variant_call: boolean = false;
                        match (fa.obj) {
                            parser.ExprIdent(oid) => {
                                var probe: Value = env.lookup(oid.name);
                                if (is_err(probe)) { variant_call = true; }
                            },
                            _ => { }
                        }
                        if (variant_call) {
                            is_variant = true;
                            variant_name = fa.field;
                        } else {
                            name = fa.field;
                            is_method = true;
                            recv = eval_expr(fa.obj, env);
                            if (is_err(recv)) { return recv; }
                        }
                    }
                },
                _ => {
                    // Treat as a value-producing expression
                    // (e.g. immediate `function () { … }()`).
                    var cv: Value = eval_expr(c.callee, env);
                    if (is_err(cv)) { return cv; }
                    match (cv) {
                        VFunc(_) => { is_closure = true; closure_val = cv; },
                        _ => { return v_err("call target is not callable"); }
                    }
                }
            }
            // Evaluate args in order, propagating the first VErr.
            var arg_vals: Value[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) {
                var av: Value = eval_expr(c.args[i], env);
                if (is_err(av)) { return av; }
                arg_vals = arg_vals.append(av);
                i = i + 1;
            }
            if (is_variant) { return v_variant(variant_name, arg_vals); }
            if (is_method) {
                return call_method(recv, name, arg_vals, env.funcs, env.aliases);
            }
            if (is_closure) {
                return call_closure(closure_val, arg_vals, env.funcs, env.aliases);
            }
            return call_func(name, arg_vals, env.funcs, env.aliases);
        },
        parser.ExprTuple(t) => {
            var elems: Value[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) {
                var ev: Value = eval_expr(t.elements[i], env);
                if (is_err(ev)) { return ev; }
                elems = elems.append(ev);
                i = i + 1;
            }
            return v_tuple(elems);
        },
        parser.ExprArray(a) => {
            var elems: Value[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) {
                var ev: Value = eval_expr(a.elements[i], env);
                if (is_err(ev)) { return ev; }
                elems = elems.append(ev);
                i = i + 1;
            }
            return v_arr(elems);
        },
        parser.ExprIndex(x) => {
            var av: Value = eval_expr(x.array, env);
            if (is_err(av)) { return av; }
            var iv: Value = eval_expr(x.index, env);
            if (is_err(iv)) { return iv; }
            match (av) {
                VArr(arr) => {
                    match (iv) {
                        VInt(ii) => {
                            if (ii.v < 0 || ii.v >= arr.elements.len()) {
                                return v_err("array index out of range");
                            }
                            return arr.elements[ii.v];
                        },
                        _ => { return v_err("array index must be i32"); }
                    }
                },
                VString(s) => {
                    // String indexing returns the byte at the
                    // given position as i32 — matches the Fern
                    // semantics in the Go pipeline. Useful for
                    // any text-processing code (the lexer's
                    // own implementation reads bytes this way).
                    match (iv) {
                        VInt(ii) => {
                            if (ii.v < 0 || ii.v >= s.v.len()) {
                                return v_err("string index out of range");
                            }
                            return v_int((s.v[ii.v] as i32));
                        },
                        _ => { return v_err("string index must be i32"); }
                    }
                },
                _ => { return v_err("can only index into an array or string"); }
            }
            return v_err("unreachable index arm");
        },
        parser.ExprSlice(sl) => {
            var av: Value = eval_expr(sl.array, env);
            if (is_err(av)) { return av; }
            var sv: Value = eval_expr(sl.start, env);
            if (is_err(sv)) { return sv; }
            var ev: Value = eval_expr(sl.end, env);
            if (is_err(ev)) { return ev; }
            var sb: i32 = 0;
            var eb: i32 = 0;
            match (sv) {
                VInt(i) => { sb = i.v; },
                _ => { return v_err("slice start must be i32"); }
            }
            match (ev) {
                VInt(i) => { eb = i.v; },
                _ => { return v_err("slice end must be i32"); }
            }
            match (av) {
                VString(s) => {
                    if (sb < 0 || eb > s.v.len() || sb > eb) {
                        return v_err("string slice out of range");
                    }
                    return v_string(s.v[sb:eb]);
                },
                VArr(a) => {
                    if (sb < 0 || eb > a.elements.len() || sb > eb) {
                        return v_err("array slice out of range");
                    }
                    var out: Value[] = [];
                    var i: i32 = sb;
                    while (i < eb) { out = out.append(a.elements[i]); i = i + 1; }
                    return v_arr(out);
                },
                _ => { return v_err("can only slice array or string"); }
            }
            return v_err("unreachable slice arm");
        },
        parser.ExprStructLit(sl) => {
            // Struct-update `Name { ...base, f: v }`: start from the
            // base struct's fields, then overwrite the named overrides
            // (or append any not already present). Field lookup is by
            // name, so order is irrelevant.
            if (sl.has_base) {
                var bv: Value = eval_expr(sl.base, env);
                if (is_err(bv)) { return bv; }
                match (bv) {
                    VStruct(sv) => {
                        var bnames: string[] = sv.field_names;
                        var bvals: Value[] = sv.field_values;
                        var oi: i32 = 0;
                        while (oi < sl.field_values.len()) {
                            var ov2: Value = eval_expr(sl.field_values[oi], env);
                            if (is_err(ov2)) { return ov2; }
                            var oname: string = sl.field_names[oi];
                            var replaced: boolean = false;
                            var bi: i32 = 0;
                            while (bi < bnames.len()) {
                                if (bnames[bi] == oname) {
                                    bvals = bvals.with(bi, ov2);
                                    replaced = true;
                                }
                                bi = bi + 1;
                            }
                            if (!replaced) {
                                bnames = bnames.append(oname);
                                bvals = bvals.append(ov2);
                            }
                            oi = oi + 1;
                        }
                        return v_struct(sl.type_name, bnames, bvals);
                    },
                    _ => { return v_err("struct update base is not a struct"); }
                }
            }
            // Evaluate each field's value in declaration order,
            // propagating the first VErr. Field names are
            // copied as-is from the parser; the runtime treats
            // them as opaque strings for lookup.
            var fvs: Value[] = [];
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                var fv: Value = eval_expr(sl.field_values[i], env);
                if (is_err(fv)) { return fv; }
                fvs = fvs.append(fv);
                i = i + 1;
            }
            return v_struct(sl.type_name, sl.field_names, fvs);
        },
        parser.ExprFieldAccess(fa) => {
            // Evaluate the object. Field can be:
            //   * struct field name (linear scan)
            //   * tuple index `0` / `1` / … (string-of-digits)
            // The parser stores both shapes as a bare string;
            // we disambiguate on the receiver's runtime type.
            var ov: Value = eval_expr(fa.obj, env);
            if (is_err(ov)) {
                // `E.Red` — a field access whose object is a bare
                // identifier that resolves to no runtime value is a
                // nullary enum-variant construction. The parser
                // desugars enum variants into payload-less variant
                // structs named for the variant, so the value is a
                // zero-field VStruct tagged with the variant name; a
                // qualified variant pattern `E.Red` matches it by its
                // final path segment (see StmtMatch / variant_simple_
                // name). Payload variants `E.Some(x)` are constructed
                // on the ExprCall path. On a valid (checker-passed)
                // program a bare undefined-identifier object only
                // arises for an enum type name.
                match (fa.obj) {
                    parser.ExprIdent(_) => {
                        var no_names: string[] = [];
                        var no_vals: Value[] = [];
                        return v_struct(fa.field, no_names, no_vals);
                    },
                    _ => { return ov; }
                }
            }
            match (ov) {
                VStruct(sv) => {
                    var i: i32 = 0;
                    while (i < sv.field_names.len()) {
                        if (sv.field_names[i] == fa.field) {
                            return sv.field_values[i];
                        }
                        i = i + 1;
                    }
                    return v_err("struct " + sv.type_name + " has no field `" + fa.field + "`");
                },
                VTuple(tv) => {
                    var idx: i32 = util.digits_to_i32(fa.field);
                    if (idx < 0 || idx >= tv.elements.len()) {
                        return v_err("tuple index `" + fa.field + "` out of range");
                    }
                    return tv.elements[idx];
                },
                _ => { return v_err("can only field-access a struct or tuple"); }
            }
            return v_err("unreachable field-access arm");
        },
        parser.ExprLambda(lm) => {
            // Capture the lexical environment by snapshotting
            // env.names / env.values. The body resolves free
            // idents against this snapshot first; the call
            // site re-binds params on top.
            return VFunc {
                params: lm.params,
                ret_type: lm.ret_type,
                body: lm.body,
                captured_names: env.names,
                captured_values: env.values
            };
        },
        parser.ExprUnknown(u) => { return v_err("parser-side unknown: " + u.kind); }
    }
    return v_err("unhandled Expr variant");
}

// call_func looks up `name` in the function table, binds args
// to params in a fresh env that shares the same funcs table, and
// evals the body. A missing function or arity mismatch surfaces
// as VErr. The callee runs with its own scope — caller bindings
// are NOT visible (no closures yet).
// call_method dispatches on the receiver's struct type_name.
// Searches funcs for a method-shaped FuncDecl whose name and
// receiver_type both match — VStruct receivers nominate
// receiver_type by exact name (so a method declared on
// `(c: Circle)` matches a VStruct whose type_name is "Circle").
// The receiver is bound to `receiver_name` first, then the
// remaining args follow in declaration order.
// is_variant_of_alias_interp checks whether struct_name is a
// listed variant of union_name in aliases. Used by call_method
// to dispatch methods declared on a union receiver type when
// the runtime receiver is one of its variant structs.
function is_variant_of_alias_interp(struct_name: string, union_name: string, aliases: parser.TypeAlias[]): boolean {
    var i: i32 = 0;
    while (i < aliases.len()) {
        if (aliases[i].name == union_name) {
            var j: i32 = 0;
            while (j < aliases[i].variants.len()) {
                if (aliases[i].variants[j] == struct_name) { return true; }
                j = j + 1;
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// variant_simple_name returns the final `.`-separated segment of a
// (possibly qualified) variant name — `E.Red` → `Red`,
// `lexer.TokIdent` → `TokIdent`, `Red` → `Red`. Used to match a
// qualified variant pattern against a runtime enum value, whose
// type_name is the bare variant name.
function variant_simple_name(name: string): string {
    var last_dot: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < name.len()) {
        if (name[i] == 46) { last_dot = i; }
        i = i + 1;
    }
    if (last_dot >= 0) { return name[last_dot + 1 : name.len()] + ""; }
    return name;
}

// aliases_with_enums appends a synthetic union alias (name → variant
// names) for each enum to the alias list. Enums desugar to variant
// structs but not to a TypeAlias, so without this a method declared on
// the enum type — `function (s: Shape) area()` where `Shape` is an enum —
// wouldn't dispatch on a variant value: is_variant_of_alias_interp only
// consults the alias table. Treating each enum as a union of its
// variants makes union-receiver method dispatch resolve enum methods too.
function aliases_with_enums(aliases: parser.TypeAlias[], enums: parser.EnumDecl[]): parser.TypeAlias[] {
    var out: parser.TypeAlias[] = aliases;
    var i: i32 = 0;
    while (i < enums.len()) {
        out = out.append(parser.TypeAlias { name: enums[i].name, variants: enums[i].variant_names, line: 0, col: 0 });
        i = i + 1;
    }
    return out;
}

// call_closure runs a VFunc with the given args. The closure's
// captured names + values seed the body's env so free idents in
// the lambda body resolve against the enclosing function's
// scope. Args bind on top in declaration order.
function call_closure(cv: Value, args: Value[], funcs: parser.FuncDecl[], aliases: parser.TypeAlias[]): Value {
    var fv: VFunc = VFunc { params: [], ret_type: "", body: [], captured_names: [], captured_values: [] };
    match (cv) {
        VFunc(v) => { fv = v; },
        _ => { return v_err("call_closure: not a VFunc"); }
    }
    if (args.len() != fv.params.len()) {
        return v_err("arity mismatch calling closure");
    }
    var env: Env = Env { names: fv.captured_names, values: fv.captured_values, funcs: funcs, aliases: aliases };
    var j: i32 = 0;
    while (j < fv.params.len()) {
        env = env.bind(fv.params[j].name, coerce_int_width(args[j], fv.params[j].type_name));
        j = j + 1;
    }
    var step: StepResult = eval_block(fv.body, env);
    if (step.sig != 1) {
        return v_err("closure reached end without `return`");
    }
    // A `?` unwind stops at the frame that owns it: unwrap_try turns the
    // in-flight VTry back into the None / Err box this call returns (#5990).
    return unwrap_try(step.ret);
}

function call_method(recv: Value, name: string, args: Value[], funcs: parser.FuncDecl[], aliases: parser.TypeAlias[]): Value {
    // Built-in VMap methods are dispatched ahead of the user
    // FuncDecl walk — set / get_or / has / delete / len /
    // keys / values are baked in rather than user-defined.
    // String and array carry the two zero-import builtin
    // methods the native compiler recognises — `.len()` on
    // both and `.append(x)` on arrays (the method mirrors of
    // the bare `len(x)` builtin in call_func). Unknown method
    // names fall through to the user-method walk below rather
    // than erroring, so user-declared string/array receivers
    // still dispatch.
    match (recv) {
        VString(sv) => {
            if (name == "len") {
                if (args.len() != 0) { return v_err("string.len: takes no arguments"); }
                return v_int(sv.v.len());
            }
        },
        VArr(av) => {
            if (name == "len") {
                if (args.len() != 0) { return v_err("array.len: takes no arguments"); }
                return v_int(av.elements.len());
            }
            if (name == "append") {
                if (args.len() != 1) { return v_err("array.append: need 1 arg"); }
                // Build a fresh element buffer element-by-element
                // rather than appending onto `av.elements`, which is
                // shared with the receiver's binding — appending onto
                // the shared buffer directly can alias it and mutate
                // the original array in place. Mirrors the copy-loop
                // the VMap methods use for the same reason.
                var out: Value[] = [];
                var ai: i32 = 0;
                while (ai < av.elements.len()) {
                    out = out.append(av.elements[ai]);
                    ai = ai + 1;
                }
                out = out.append(args[0]);
                return v_arr(out);
            }
        },
        VMap(m) => {
            if (name == "insert") {
                if (args.len() != 2) { return v_err("map.set: need 2 args"); }
                var i: i32 = 0;
                while (i < m.keys.len()) {
                    if (value_eq(m.keys[i], args[0])) {
                        // Replace value at slot i.
                        var nvs: Value[] = [];
                        var j: i32 = 0;
                        while (j < m.values.len()) {
                            if (j == i) { nvs = nvs.append(args[1]); }
                            else { nvs = nvs.append(m.values[j]); }
                            j = j + 1;
                        }
                        return VMap { keys: m.keys, values: nvs };
                    }
                    i = i + 1;
                }
                return VMap { keys: m.keys.append(args[0]), values: m.values.append(args[1]) };
            }
            if (name == "get_or") {
                if (args.len() != 2) { return v_err("map.get_or: need 2 args"); }
                var gi: i32 = 0;
                while (gi < m.keys.len()) {
                    if (value_eq(m.keys[gi], args[0])) { return m.values[gi]; }
                    gi = gi + 1;
                }
                return args[1];
            }
            if (name == "has") {
                if (args.len() != 1) { return v_err("map.has: need 1 arg"); }
                var hi: i32 = 0;
                while (hi < m.keys.len()) {
                    if (value_eq(m.keys[hi], args[0])) { return v_bool(true); }
                    hi = hi + 1;
                }
                return v_bool(false);
            }
            if (name == "without") {
                if (args.len() != 1) { return v_err("map.delete: need 1 arg"); }
                var nk: Value[] = [];
                var nv: Value[] = [];
                var di: i32 = 0;
                while (di < m.keys.len()) {
                    if (!value_eq(m.keys[di], args[0])) {
                        nk = nk.append(m.keys[di]);
                        nv = nv.append(m.values[di]);
                    }
                    di = di + 1;
                }
                var found: boolean = nk.len() != m.keys.len();
                return v_tuple([v_map(nk, nv), v_bool(found)]);
            }
            if (name == "len") { return v_int(m.keys.len()); }
            if (name == "keys") { return v_arr(m.keys); }
            if (name == "values") { return v_arr(m.values); }
            return v_err("unknown map method `" + name + "`");
        },
        _ => { }
    }
    // Derive the receiver-type name from the runtime Value
    // variant. VStruct uses its declared type_name; primitive
    // variants map to the language's primitive type-keywords
    // so `function (s: string) len(): i32 { … }` dispatches.
    var recv_type: string = "";
    match (recv) {
        VStruct(sv) => { recv_type = sv.type_name; },
        VString(_) => { recv_type = "string"; },
        VInt(_) => { recv_type = "i32"; },
        VUint(_) => { recv_type = "u32"; },
        VBool(_) => { recv_type = "bool"; },
        VFloat(_) => { recv_type = "f64"; },
        VFloat32(_) => { recv_type = "f32"; },
        _ => { return v_err("method dispatch: receiver not a typed value"); }
    }
    var i: i32 = 0;
    while (i < funcs.len()) {
        var fd: parser.FuncDecl = funcs[i];
        var rt_match: boolean = fd.receiver_type == recv_type;
        // `bool` and `boolean` are interchangeable receiver
        // type-names — the lexer's keyword set accepts both.
        if (!rt_match && recv_type == "bool" && fd.receiver_type == "boolean") {
            rt_match = true;
        }
        // Union-receiver methods: a method declared on a union
        // (`function (sh: Shape) area()`) matches when recv's
        // struct type_name is in the union's variant list.
        if (!rt_match && is_variant_of_alias_interp(recv_type, fd.receiver_type, aliases)) {
            rt_match = true;
        }
        if (fd.name == name && fd.receiver_name.len() > 0 && rt_match) {
            if (args.len() != fd.params.len()) {
                return v_err("arity mismatch calling method `" + name + "`");
            }
            var env: Env = new_env_with_funcs_aliases(funcs, aliases);
            env = env.bind(fd.receiver_name, recv);
            var j: i32 = 0;
            while (j < fd.params.len()) {
                env = env.bind(fd.params[j].name, coerce_int_width(args[j], fd.params[j].type_name));
                j = j + 1;
            }
            var step: StepResult = eval_block(fd.body, env);
            if (step.sig != 1) {
                return v_err("method `" + name + "` reached end without `return`");
            }
            return unwrap_try(step.ret);
        }
        i = i + 1;
    }
    // No user method matched. Before erroring, try a FIELD holding a closure
    // (#6596): `h.f(3)` where `f: (i32) => i32` is a field, not a method. The
    // compiled path has always supported this — it is the shape #6461 is about,
    // a struct carrying a handler — but this engine read every `recv.name(...)`
    // as method dispatch and gave up here.
    //
    // Deliberately a FALLBACK rather than a check ahead of the walk: a real
    // method keeps winning, so no existing dispatch changes and this can only
    // turn an error into an answer.
    match (recv) {
        VStruct(sv2) => {
            var fi: i32 = 0;
            while (fi < sv2.field_names.len()) {
                if (sv2.field_names[fi] == name) {
                    match (sv2.field_values[fi]) {
                        VFunc(_) => { return call_closure(sv2.field_values[fi], args, funcs, aliases); },
                        _ => {}
                    }
                }
                fi = fi + 1;
            }
        },
        _ => {}
    }
    return v_err("undefined method `" + name + "` on `" + recv_type + "`");
}

function call_func(name: string, args: Value[], funcs: parser.FuncDecl[], aliases: parser.TypeAlias[]): Value {
    // Builtin: `len(a)` on an array → i32. Special-cased here
    // because the parser doesn't model builtins separately and
    // the interp has no Go-side host functions yet.
    if (name == "len") {
        if (args.len() != 1) { return v_err("len takes exactly 1 argument"); }
        match (args[0]) {
            VArr(a) => { return v_int(a.elements.len()); },
            VString(s) => { return v_int(s.v.len()); },
            VMap(m) => { return v_int(m.keys.len()); },
            _ => { return v_err("len: argument must be array, string, or map"); }
        }
    }
    // map_new(cap) — capacity arg is accepted but ignored
    // since VMap uses dynamic parallel arrays.
    if (name == "map_new") {
        return v_map_new();
    }
    var i: i32 = 0;
    while (i < funcs.len()) {
        // Skip receiver methods — they're dispatched via
        // call_method only. A plain function call must match
        // a non-method (receiver_name empty) of the same name.
        if (funcs[i].name == name && funcs[i].receiver_name.len() == 0) {
            var fd: parser.FuncDecl = funcs[i];
            if (args.len() != fd.params.len()) {
                return v_err("arity mismatch calling `" + name + "`");
            }
            var env: Env = new_env_with_funcs_aliases(funcs, aliases);
            var j: i32 = 0;
            while (j < fd.params.len()) {
                env = env.bind(fd.params[j].name, coerce_int_width(args[j], fd.params[j].type_name));
                j = j + 1;
            }
            var step: StepResult = eval_block(fd.body, env);
            if (step.sig != 1) {
                return v_err("function `" + name + "` reached end without `return`");
            }
            return unwrap_try(step.ret);
        }
        i = i + 1;
    }
    return v_err("undefined function: " + name);
}

// value_eq: structural equality on Value. Two values of the
// same shape compare by payload; everything else is false.
// VErr never equals anything (including itself) — equality on
// error is itself an error in spirit, but we surface it as
// `false` so the caller branches consistently.
function value_eq(a: Value, b: Value): boolean {
    match (a) {
        VInt(ai) => {
            match (b) {
                VInt(bi) => { return ai.v == bi.v; },
                VInt64(bi) => { return (ai.v as i64) == unpack_i64(bi); },
                VUint(bu) => { return ai.v == bu.v; },
                _ => { return false; }
            }
        },
        VInt64(ai) => {
            match (b) {
                VInt(bi) => { return unpack_i64(ai) == (bi.v as i64); },
                VInt64(bi) => { return ai.hi == bi.hi && ai.lo == bi.lo; },
                VUint(bu) => { return unpack_i64(ai) == uint_zext(bu.v); },
                _ => { return false; }
            }
        },
        VUint(au) => {
            // Same-width compact int compares by bit pattern (a VInt on the
            // other side is the untagged same pattern); a wide VInt64
            // compares against the zero-extended value.
            match (b) {
                VUint(bu) => { return au.v == bu.v; },
                VInt(bi) => { return au.v == bi.v; },
                VInt64(bi) => { return uint_zext(au.v) == unpack_i64(bi); },
                _ => { return false; }
            }
        },
        VBool(ab) => {
            match (b) {
                VBool(bb) => { return ab.v == bb.v; },
                _ => { return false; }
            }
        },
        VString(av) => {
            match (b) {
                VString(bs) => { return av.v == bs.v; },
                _ => { return false; }
            }
        },
        VFloat(af) => {
            match (b) {
                VFloat(bf) => { return af.v == bf.v; },
                VFloat32(bf) => { return af.v == bf.v; },
                _ => { return false; }
            }
        },
        VFloat32(af) => {
            // The payload is already rounded, so f64-plane comparison is
            // exact for both same-width and mixed-width operands.
            match (b) {
                VFloat32(bf) => { return af.v == bf.v; },
                VFloat(bf) => { return af.v == bf.v; },
                _ => { return false; }
            }
        },
        VArr(aa) => {
            // Structural equality: same length, each element-pair
            // structurally equal via the same value_eq path.
            match (b) {
                VArr(ba) => {
                    if (aa.elements.len() != ba.elements.len()) { return false; }
                    var ai: i32 = 0;
                    while (ai < aa.elements.len()) {
                        if (!value_eq(aa.elements[ai], ba.elements[ai])) { return false; }
                        ai = ai + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        VFunc(_) => { return false; },
        VMap(_) => { return false; },
        VStruct(asv) => {
            // Structural equality: same type_name + same field
            // count + pairwise structural equality on each
            // field value. Field names already match because
            // the type_name match implies a common StructDecl
            // and the field order is fixed at construction.
            match (b) {
                VStruct(bsv) => {
                    if (asv.type_name != bsv.type_name) { return false; }
                    if (asv.field_values.len() != bsv.field_values.len()) { return false; }
                    var si: i32 = 0;
                    while (si < asv.field_values.len()) {
                        if (!value_eq(asv.field_values[si], bsv.field_values[si])) { return false; }
                        si = si + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        VTuple(at) => {
            // Structural equality: same arity, each element-pair
            // structurally equal via the same value_eq path.
            match (b) {
                VTuple(bt) => {
                    if (at.elements.len() != bt.elements.len()) { return false; }
                    var ti: i32 = 0;
                    while (ti < at.elements.len()) {
                        if (!value_eq(at.elements[ti], bt.elements[ti])) { return false; }
                        ti = ti + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        // A cell never reaches a comparison: Env.lookup derefs it, so the only
        // places a VCell* is observable are the slot itself and a closure's
        // captured snapshot. Answering `false` keeps value_eq total without
        // inventing an equality for a binding-site artifact.
        VCellI(_) => { return false; },
        VCellF(_) => { return false; },
        // Neither bottom compares equal — a diagnostic and a `?` unwind are
        // both abrupt, and an abrupt value never reaches an ordinary operand
        // position (is_err short-circuits ahead of every comparison).
        VErr(_) => { return false; },
        VTry(_) => { return false; }
    }
    return false;
}

// eval_stmt returns (new env, control signal, optional value). The
// returned env carries `var x = …;` bindings forward. Control flow
// rides the DEDICATED `sig` channel (SH-002) — never the Value union,
// so a user value like Err("__break__") can no longer be mistaken for
// a loop signal (the old encoding keyed break/continue/return off
// magic VErr message strings). `ret` is meaningful only for SIG 1:
// a `return`'s value, or a runtime error propagating outward (both
// stop execution identically, exactly as before).
//   sig 0 = none (keep going; ret is a placeholder, never read)
//   sig 1 = stop (return value or runtime error in ret)
//   sig 2 = break     sig 3 = continue
pub struct StepResult { env: Env, ret: Value, sig: i32 }

function step_none(env: Env): StepResult { return StepResult { env: env, ret: VErr { msg: "" }, sig: 0 }; }
function step_stop(env: Env, v: Value): StepResult { return StepResult { env: env, ret: v, sig: 1 }; }

function eval_stmt(st: parser.Stmt, env: Env): StepResult {
    match (st) {
        // StmtDefer is lowered away by lower_defers_module before eval; this
        // arm recurses on the lowered form.
        parser.StmtDefer(d) => { return eval_stmt(d.action, env); },
        parser.StmtVar(v) => {
            // Mutable scalar captures (SH-057): if the initialiser contains a
            // lambda that WRITES an enclosing local, rebind that local as a
            // shared cell first, so the closure's env snapshot and this scope
            // point at the same one. Read-only captures are untouched.
            env = cellify_env(env, stmt_lambda_writes(st));
            var val: Value = eval_expr(v.init, env);
            // A runtime error in the initializer aborts the function rather
            // than being bound and silently swallowed (#4348 item 4). eval_expr
            // only ever yields VALUES (control signals are statement-level,
            // on the sig channel), so any VErr here is a real error to propagate.
            if (is_err(val)) { return step_stop(env, val); }
            var env2: Env = env.bind(v.name, coerce_int_width(val, v.type_name));
            return step_none(env2);
        },
        parser.StmtReturn(r) => {
            var val: Value = eval_expr(r.value, env);
            return step_stop(env, val);
        },
        parser.StmtExpr(x) => {
            var val: Value = eval_expr(x.value, env);
            // A runtime error in an expression-statement aborts rather than
            // being dropped and swallowed (#4348 item 4). Otherwise the value
            // is discarded (expression-statements are side-effect only here).
            if (is_err(val)) { return step_stop(env, val); }
            return step_none(env);
        },
        parser.StmtIf(ifs) => {
            var cv: Value = eval_expr(ifs.cond, env);
            if (is_err(cv)) { return step_stop(env, cv); }
            // lower_defers_module's synthesized cleanup guards
            // (`if (__dfa0) { … }`) condition on i32 FLAGS, not bools —
            // normalise a VInt cond to its non-zero truth here (#4348
            // item 1). Checker-validated user programs can only reach
            // this arm with a bool, so user-facing semantics are
            // unchanged.
            match (cv) {
                VInt(civ) => { cv = VBool { v: civ.v != 0 }; },
                _ => {}
            }
            match (cv) {
                VBool(b) => {
                    var body: parser.Stmt[] = ifs.else_body;
                    if (b.v) { body = ifs.then_body; }
                    // Branch-local `var`s don't escape: trim the
                    // env back to the entry length. Assignments
                    // to outer-scoped names sit at index < base
                    // and survive the trim (update() rewrites
                    // slots in place).
                    var base: i32 = env.names.len();
                    var step: StepResult = eval_block(body, env);
                    return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig };
                },
                _ => { return step_stop(env, v_err("if cond not bool")); }
            }
            return step_stop(env, v_err("unreachable if-arm"));
        },
        parser.StmtWhile(w) => {
            // Loop until cond is false or the body returns.
            // Assignments inside the body need to outlive each
            // iteration — eval_block's "drop branch-local
            // bindings" stance is wrong here, so we step the body
            // ourselves and thread `cur` forward. `var` declared
            // inside the body still doesn't leak past the loop:
            // we snapshot the names-length at entry and trim back
            // on each iteration boundary, simulating block scope.
            //
            // Concretely: the names array grows only by `var`
            // inside the body; truncating to entry-length on each
            // iteration discards those bindings before the next
            // iteration starts, but keeps any updates to
            // outer-scoped names (those slots sit at index < base
            // and update() rewrites them in place). The trim also
            // applies on loop exit so the outer scope sees the
            // env it started with, plus assignment updates.
            var cur: Env = env;
            var base: i32 = env.names.len();
            while (true) {
                var cv: Value = eval_expr(w.cond, cur);
                if (is_err(cv)) { return step_stop(env, cv); }
                match (cv) {
                    VBool(b) => {
                        if (!b.v) { return step_none(cur); }
                    },
                    _ => { return step_stop(env, v_err("while cond not bool")); }
                }
                var step: StepResult = eval_block(w.body, cur);
                // break inside the loop exits immediately —
                // discard the body's env, return noreturn so
                // the surrounding stmt list continues.
                if (step.sig == 2) {
                    return step_none(trim_env(step.env, base));
                }
                // continue trims body-local bindings and loops.
                if (step.sig == 3) {
                    cur = trim_env(step.env, base);
                    continue;
                }
                if (step.sig == 1) {
                    // A return (or error) inside the loop short-circuits
                    // all remaining iterations.
                    return step;
                }
                // A deeper labeled break/continue (#4348 item 2): this loop
                // is one of the levels being unwound — peel one level and
                // re-propagate to the enclosing loop.
                if (step.sig > 3) {
                    return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig - 2 };
                }
                cur = trim_env(step.env, base);
            }
            return step_none(cur);
        },
        parser.StmtAssign(a) => {
            var av: Value = eval_expr(a.value, env);
            if (is_err(av)) { return step_stop(env, av); }
            // update silently no-ops on undefined names; surface
            // the error explicitly so a mistake is observable in
            // tests.
            var i: i32 = env.names.len() - 1;
            var found: boolean = false;
            while (i >= 0 && !found) {
                if (env.names[i] == a.target) { found = true; }
                i = i - 1;
            }
            if (!found) {
                return step_stop(env, v_err("assign to undefined `" + a.target + "`"));
            }
            // A celled slot is a mutable scalar capture: write THROUGH it and
            // leave the Env alone. That is what makes the write visible to the
            // enclosing scope and to every other closure sharing the cell —
            // env.update would only rebind this copy (SH-057).
            var tslot: i32 = env.raw_slot(a.target);
            if (tslot >= 0 && cell_slot_set(env.values[tslot], av)) { return step_none(env); }
            // A lambda in the RHS may itself write an enclosing local.
            env = cellify_env(env, stmt_lambda_writes(st));
            return step_none(env.update(a.target, av));
        },
        parser.StmtMatch(m) => {
            // Evaluate the scrutinee. An error in the scrutinee
            // propagates without running any arm.
            var sv: Value = eval_expr(m.scrutinee, env);
            if (is_err(sv)) { return step_stop(env, sv); }
            // Walk arms top-to-bottom and run the first that
            // matches. Variant patterns require a VStruct
            // scrutinee whose type_name matches the pattern's
            // type_name; PatWildcard always matches.
            var i: i32 = 0;
            while (i < m.arms.len()) {
                var arm: parser.MatchArm = m.arms[i];
                var matched: boolean = false;
                var bind_names: string[] = [];
                var bind_values: Value[] = [];
                match (arm.pattern) {
                    parser.PatWildcard(_) => { matched = true; },
                    parser.PatVariant(pv) => {
                        // `match (b) { true => …, false => … }` over a bool.
                        if (pv.type_name == "true" || pv.type_name == "false") {
                            match (sv) {
                                VBool(bv) => {
                                    if (pv.type_name == "true" && bv.v) { matched = true; }
                                    if (pv.type_name == "false" && !bv.v) { matched = true; }
                                },
                                _ => { }
                            }
                        }
                        match (sv) {
                            VStruct(vs) => {
                                // A runtime enum/variant value carries the
                                // bare variant name as its type_name, so a
                                // qualified pattern `E.Red` matches by its
                                // final path segment as well as by exact
                                // name (a bare `Red` pattern still matches
                                // exactly).
                                if (vs.type_name == pv.type_name || vs.type_name == variant_simple_name(pv.type_name)) {
                                    matched = true;
                                    // A payload enum variant carries the
                                    // parser's `__ev` marker as its first
                                    // synthesised field; a `V(a, b, …)`
                                    // pattern binds each payload field
                                    // positionally. A plain tagged-struct /
                                    // union variant `Circle(c)` has no `__ev`
                                    // marker, so a single binding takes the
                                    // whole struct (so `c.field` works).
                                    // Bare `Foo` / `Foo(_)` bind nothing.
                                    var is_payload: boolean = vs.field_names.len() > 0 && vs.field_names[0] == "__ev";
                                    if (is_payload) {
                                        var pat_binds: string[] = [];
                                        if (pv.binding.len() > 0) { pat_binds = pat_binds.append(pv.binding); }
                                        var xi: i32 = 0;
                                        while (xi < pv.extra_bindings.len()) {
                                            pat_binds = pat_binds.append(pv.extra_bindings[xi]);
                                            xi = xi + 1;
                                        }
                                        var pbi: i32 = 0;
                                        while (pbi < pat_binds.len() && pbi < vs.field_values.len()) {
                                            if (pat_binds[pbi] != "_") {
                                                bind_names = bind_names.append(pat_binds[pbi]);
                                                bind_values = bind_values.append(vs.field_values[pbi]);
                                            }
                                            pbi = pbi + 1;
                                        }
                                    } else {
                                        if (pv.binding.len() > 0 && pv.binding != "_") {
                                            bind_names = bind_names.append(pv.binding);
                                            bind_values = bind_values.append(sv);
                                        }
                                    }
                                }
                            },
                            _ => { }
                        }
                    }
                }
                if (matched) {
                    // Arm-local bindings die at the close of the
                    // arm body, same as branch-local `var`s in
                    // StmtIf. Trim env back to the entry length
                    // before returning so the surrounding scope
                    // doesn't see the binding (or any nested
                    // `var`s) leak out.
                    var base: i32 = env.names.len();
                    var bodyEnv: Env = env;
                    var bk: i32 = 0;
                    while (bk < bind_names.len()) {
                        bodyEnv = bodyEnv.bind(bind_names[bk], bind_values[bk]);
                        bk = bk + 1;
                    }
                    // A guard (`Pat if <expr> =>`) is evaluated with the
                    // binding in scope; a false guard falls through to the
                    // next arm instead of running this body.
                    var pass: boolean = true;
                    if (arm.has_guard) {
                        var gv: Value = eval_expr(arm.guard, bodyEnv);
                        if (is_err(gv)) { return step_stop(trim_env(bodyEnv, base), gv); }
                        match (gv) {
                            VBool(gb) => { pass = gb.v; },
                            _ => { pass = false; }
                        }
                    }
                    if (pass) {
                        var step: StepResult = eval_block(arm.body, bodyEnv);
                        return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig };
                    }
                }
                i = i + 1;
            }
            return step_stop(env, v_err("non-exhaustive match"));
        },
        // A labeled break/continue carries its resolve_labels_module-baked
        // relative loop depth (tag 0 = innermost) in the sig encoding
        // (#4348 item 2): sig 2+2d = break out of d+1 loops, 3+2d =
        // continue the d-th enclosing loop. Each loop arm consumes sig
        // 2/3 and peels one level off anything deeper (sig - 2), so a
        // 2-level `break outer` unwinds both loops instead of silently
        // degrading to the innermost (which hung `outer: while(true)`).
        parser.StmtBreak(b) => { return StepResult { env: env, ret: VErr { msg: "" }, sig: 2 + b.tag * 2 }; },
        parser.StmtContinue(c) => { return StepResult { env: env, ret: VErr { msg: "" }, sig: 3 + c.tag * 2 }; },
        parser.StmtFor(f) => {
            // Evaluate the iter expression — must be a VArr.
            var iv: Value = eval_expr(f.iter, env);
            if (is_err(iv)) { return step_stop(env, iv); }
            var elems: Value[] = [];
            match (iv) {
                VArr(a) => { elems = a.elements; },
                _ => { return step_stop(env, v_err("for-in iter not an array")); }
            }
            // Each iteration binds f.var_name to the current
            // element, walks the body, then trims back to the
            // pre-loop env length. An in-body return short-
            // circuits the rest of the iterations.
            var base: i32 = env.names.len();
            var cur: Env = env;
            var i: i32 = 0;
            while (i < elems.len()) {
                var iter_env: Env = cur.bind(f.var_name, elems[i]);
                var step: StepResult = eval_block(f.body, iter_env);
                if (step.sig == 2) {
                    return step_none(trim_env(step.env, base));
                }
                if (step.sig == 3) {
                    cur = trim_env(step.env, base);
                    i = i + 1;
                    continue;
                }
                if (step.sig == 1) { return step; }
                // A deeper labeled break/continue (#4348 item 2): peel one
                // level and re-propagate to the enclosing loop.
                if (step.sig > 3) {
                    return StepResult { env: trim_env(step.env, base), ret: step.ret, sig: step.sig - 2 };
                }
                cur = trim_env(step.env, base);
                i = i + 1;
            }
            return step_none(cur);
        },
        parser.StmtUnknown(u) => { return step_stop(env, v_err("parser-side unknown stmt: " + u.kind)); }
    }
    return step_stop(env, v_err("unhandled Stmt variant"));
}

// trim_env drops bindings past index `base`. Used by the while
// loop to discard body-local `var`s between iterations while
// preserving any update()s to outer-scoped names (those sit at
// index < base and aren't touched).
function trim_env(e: Env, base: i32): Env {
    if (e.names.len() <= base) { return e; }
    var ns: string[] = [];
    var vs: Value[] = [];
    var i: i32 = 0;
    while (i < base) {
        ns = ns.append(e.names[i]);
        vs = vs.append(e.values[i]);
        i = i + 1;
    }
    return Env { names: ns, values: vs, funcs: e.funcs, aliases: e.aliases };
}

// eval_block walks a body, threading env forward through every
// stmt. Returns the threaded env so the caller can decide how
// much of it to keep — the StmtIf path trims back to the entry
// length (branch-local `var`s die), while StmtWhile uses the
// same trim per iteration but keeps it. Both rely on the fact
// that update() rewrites slots in place, so reassignments to
// outer-scoped names sit at index < base and survive the trim.
// The first non-zero sig short-circuits the walk.
function eval_block(body: parser.Stmt[], env: Env): StepResult {
    var cur: Env = env;
    var reassigned: string[] = body_assign_names(body, []);
    var i: i32 = 0;
    while (i < body.len()) {
        cur = cellify_outer_writes(cur, body[i], reassigned);
        var r: StepResult = eval_stmt(body[i], cur);
        cur = r.env;
        if (r.sig != 0) {
            return StepResult { env: cur, ret: r.ret, sig: r.sig };
        }
        i = i + 1;
    }
    return step_none(cur);
}

// eval_program drives the stmt list. Stops at the first return
// (or end of stmts). Returns the return-value or VErr if no
// explicit return was seen.
function eval_program(prog: parser.Stmt[]): Value {
    var env: Env = new_env();
    var preassigned: string[] = body_assign_names(prog, []);
    var i: i32 = 0;
    while (i < prog.len()) {
        env = cellify_outer_writes(env, prog[i], preassigned);
        var r: StepResult = eval_stmt(prog[i], env);
        env = r.env;
        if (r.sig != 0) { return r.ret; }
        i = i + 1;
    }
    return v_err("program reached end without `return`");
}

// eval_module is the main entry for sources that declare
// functions. If `main` exists, call it with no args. Otherwise
// fall back to running the top-level stmts in a fresh env that
// still has access to the function table.
pub function eval_module(raw_mod: parser.Module): Value {
    // Lower `for i in LOW..HIGH` range-loops (iter = the synthetic `__range`
    // call) to counting while-loops up front — the interpreter's StmtFor only
    // iterates arrays, so an undesugared `__range` iter would mis-evaluate.
    // (The IR path keeps the `__range` shape for irlower.lower_range_for.)
    // Lower `defer` to its scope-exit position HERE (#4348 item 1) rather
    // than relying on each caller: the stdin drivers (interp_run) fed the
    // raw module straight in, so StmtDefer's recurse-arm executed deferred
    // actions eagerly at their source position (native 2 / eager 101 on the
    // timing-sensitive repro). lower_defers_module is idempotent on a
    // defer-free module, so callers that already lowered stay correct.
    var mod: parser.Module = parser.fill_default_args_module(parser.desugar_ranges_module(parser.lower_defers_module(raw_mod)));
    // Fold each enum into the alias table as a synthetic union so a method
    // declared on the enum type dispatches on its variant values.
    var all_aliases: parser.TypeAlias[] = aliases_with_enums(mod.aliases, mod.enums);
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].name == "main") {
            var empty_args: Value[] = [];
            return call_func("main", empty_args, mod.funcs, all_aliases);
        }
        i = i + 1;
    }
    var env: Env = new_env_with_funcs_aliases(mod.funcs, all_aliases);
    var j: i32 = 0;
    while (j < mod.top_stmts.len()) {
        var r: StepResult = eval_stmt(mod.top_stmts[j], env);
        env = r.env;
        if (r.sig != 0) { return r.ret; }
        j = j + 1;
    }
    return v_err("module has no `main` and no top-level `return`");
}

// =================== VALIDATION ====================

function run_source(src: string): Value {
    var toks: lexer.Token[] = lexer.tokenize(src);
    var stmts: parser.Stmt[] = parser.parse_program(toks);
    return eval_program(stmts);
}

function run_module(src: string): Value {
    var toks: lexer.Token[] = lexer.tokenize(src);
    var mod: parser.Module = parser.parse_module(toks);
    return eval_module(mod);
}

function main(): i32 {
    // Arithmetic + ident lookup. var x = 7; var y = 9; return x + y.
    var r1: Value = run_source("var x = 1 + 2 * 3; var y = (1 + 2) * 3; return x + y;");
    match (r1) {
        VInt(i) => { if (i.v != 16) { return 10; } },
        _ => { return 11; }
    }

    // String concat.
    var r2: Value = run_source("var a = \"hi \" + \"there\"; return 0 - 1;");
    match (r2) {
        VInt(i) => { if (i.v != 0 - 1) { return 20; } },
        _ => { return 21; }
    }

    // Logical + equality. var b = 5 < 10; return b && (1 == 1).
    // Can't `return bool` directly — surface as i32 via a
    // separate var + a ternary-shaped return.
    var r3: Value = run_source("var b = 5 < 10; var c = b && (1 == 1); return 42;");
    match (r3) {
        VInt(i) => { if (i.v != 42) { return 30; } },
        _ => { return 31; }
    }

    // Unary minus.
    var r4: Value = run_source("var n = 0 - 5; return n;");
    match (r4) {
        VInt(i) => { if (i.v != 0 - 5) { return 40; } },
        _ => { return 41; }
    }

    // Division.
    var r5: Value = run_source("return 20 / 4;");
    match (r5) {
        VInt(i) => { if (i.v != 5) { return 50; } },
        _ => { return 51; }
    }

    // Division by zero → 0 (total semantics, docs/INTEGER-SEMANTICS.md /
    // #4348 item 6), not a VErr. `x % 0 == x` likewise.
    var r6: Value = run_source("return 1 / 0;");
    match (r6) {
        VInt(i) => { if (i.v != 0) { return 60; } },
        _ => { return 61; }
    }
    var r6b: Value = run_source("return 7 % 0;");
    match (r6b) {
        VInt(i) => { if (i.v != 7) { return 62; } },
        _ => { return 63; }
    }

    // Undefined identifier → VErr.
    var r7: Value = run_source("return missing;");
    match (r7) {
        VErr(_) => { },
        _ => { return 70; }
    }

    // If/else, then-branch taken: `var x = 5; if (x < 10) { return 1; } else { return 2; }`
    var r8: Value = run_source("var x = 5; if (x < 10) { return 1; } else { return 2; }");
    match (r8) {
        VInt(i) => { if (i.v != 1) { return 80; } },
        _ => { return 81; }
    }

    // Else-branch taken.
    var r9: Value = run_source("var x = 20; if (x < 10) { return 1; } else { return 2; }");
    match (r9) {
        VInt(i) => { if (i.v != 2) { return 90; } },
        _ => { return 91; }
    }

    // No else, condition false: control falls past the if to the
    // trailing return.
    var r10: Value = run_source("if (false) { return 7; } return 11;");
    match (r10) {
        VInt(i) => { if (i.v != 11) { return 100; } },
        _ => { return 101; }
    }

    // Chained else-if: branches through the second arm.
    var r11: Value = run_source("var k = 2; if (k == 1) { return 10; } else if (k == 2) { return 20; } else { return 30; }");
    match (r11) {
        VInt(i) => { if (i.v != 20) { return 110; } },
        _ => { return 111; }
    }

    // Plain assignment: declared, reassigned, returned.
    var r12: Value = run_source("var n = 1; n = 7; return n;");
    match (r12) {
        VInt(i) => { if (i.v != 7) { return 120; } },
        _ => { return 121; }
    }

    // While loop, counter. Sum of 1..=5 == 15.
    var r13: Value = run_source(
        "var i = 1; var s = 0; while (i <= 5) { s = s + i; i = i + 1; } return s;"
    );
    match (r13) {
        VInt(i) => { if (i.v != 15) { return 130; } },
        _ => { return 131; }
    }

    // Early `return` inside while short-circuits the loop.
    var r14: Value = run_source(
        "var i = 0; while (i < 10) { if (i == 3) { return i; } i = i + 1; } return 0 - 1;"
    );
    match (r14) {
        VInt(i) => { if (i.v != 3) { return 140; } },
        _ => { return 141; }
    }

    // While with always-false cond: body never runs.
    var r15: Value = run_source("var x = 5; while (false) { x = 99; } return x;");
    match (r15) {
        VInt(i) => { if (i.v != 5) { return 150; } },
        _ => { return 151; }
    }

    // Function decl + call: `add(2, 3)` via `main` → 5.
    var r16: Value = run_module(
        "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }"
    );
    match (r16) {
        VInt(i) => { if (i.v != 5) { return 160; } },
        _ => { return 161; }
    }

    // Recursive factorial: fact(5) = 120.
    var r17: Value = run_module(
        "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); } function main(): i32 { return fact(5); }"
    );
    match (r17) {
        VInt(i) => { if (i.v != 120) { return 170; } },
        _ => { return 171; }
    }

    // Mutual recursion: is_even(4) → true (encoded as 1).
    var r18: Value = run_module(
        "function is_even(n: i32): i32 { if (n == 0) { return 1; } return is_odd(n - 1); }"
        + " function is_odd(n: i32): i32 { if (n == 0) { return 0; } return is_even(n - 1); }"
        + " function main(): i32 { return is_even(4); }"
    );
    match (r18) {
        VInt(i) => { if (i.v != 1) { return 180; } },
        _ => { return 181; }
    }

    // Undefined function call → VErr.
    var r19: Value = run_module(
        "function main(): i32 { return missing(1); }"
    );
    match (r19) {
        VErr(_) => { },
        _ => { return 190; }
    }

    // Arity mismatch → VErr.
    var r20: Value = run_module(
        "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1); }"
    );
    match (r20) {
        VErr(_) => { },
        _ => { return 200; }
    }

    // Array literal + indexing: `a[0] == 10`, `a[2] == 30`.
    var r21: Value = run_source(
        "var a = [10, 20, 30]; return a[2];"
    );
    match (r21) {
        VInt(i) => { if (i.v != 30) { return 210; } },
        _ => { return 211; }
    }

    // len() builtin on array.
    var r22: Value = run_source("var a = [1, 2, 3, 4]; return len(a);");
    match (r22) {
        VInt(i) => { if (i.v != 4) { return 220; } },
        _ => { return 221; }
    }

    // Sum-an-array via while loop. Sum of [3, 5, 7, 9] = 24.
    var r23: Value = run_source(
        "var a = [3, 5, 7, 9]; var i = 0; var s = 0; while (i < len(a)) { s = s + a[i]; i = i + 1; } return s;"
    );
    match (r23) {
        VInt(i) => { if (i.v != 24) { return 230; } },
        _ => { return 231; }
    }

    // Out-of-range index → VErr.
    var r24: Value = run_source("var a = [1, 2]; return a[5];");
    match (r24) {
        VErr(_) => { },
        _ => { return 240; }
    }

    // Empty array literal: len → 0.
    var r25: Value = run_source("var a = []; return len(a);");
    match (r25) {
        VInt(i) => { if (i.v != 0) { return 250; } },
        _ => { return 251; }
    }

    // String indexing returns the byte at position as i32.
    // ASCII 'h' is 104.
    var r26: Value = run_source("var s = \"hello\"; return s[0];");
    match (r26) {
        VInt(i) => { if (i.v != 104) { return 260; } },
        _ => { return 261; }
    }

    // String indexing + arithmetic: "ABC" → 'A' + 'B' + 'C' = 65 + 66 + 67 = 198.
    var r27: Value = run_source("var s = \"ABC\"; return s[0] + s[1] + s[2];");
    match (r27) {
        VInt(i) => { if (i.v != 198) { return 270; } },
        _ => { return 271; }
    }

    // Out-of-range string index → VErr.
    var r28: Value = run_source("var s = \"hi\"; return s[5];");
    match (r28) {
        VErr(_) => { },
        _ => { return 280; }
    }

    // String slicing: `"hello"[1:4]` → "ell". We can't directly
