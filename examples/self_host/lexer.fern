// examples/self_host/lexer.fern — a port of internal/lexer/lexer.go
// into Fern itself, exercising the language features that landed
// in the bug-hunt + feature-gap session:
//
//   - union types (Token = … | … | …)
//   - generic struct methods (collected here as i32 helpers; the
//     full Go lexer threads positions through a `*lexer` struct)
//   - mutual recursion isn't needed; everything's a forward loop
//   - pattern matching with literal patterns drives the dispatch
//     between Number / Ident / Keyword / Punct / String / Error
//
// Parity with internal/lexer/lexer.go now covers: hex integer
// literals (`0x2A`, `0x10u8`), scientific-notation floats
// (`1e3`, `1.5e-2`), the afterDot guard for chained tuple
// access (`t.1.0`), closed-list numeric-suffix validation, and a
// first-class TokError variant for the failure paths (bad
// suffix, unterminated / bad-escape / newline-in string, bare
// `0x`, unexpected character) instead of the old EOF-as-error
// sentinel.
//
// f-strings (`f"..."`) now lex here too: a single TokFString
// whose `parts` hold the alternating literal / interpolant
// pieces (`{{` / `}}` escape literal braces; standard escapes
// apply in the literal portions; `{...}` interpolants pass
// through verbatim, with inner string literals skipped during
// the brace-matching scan). The PARSER side now sub-parses each
// interpolant Expr text and desugars the f-string to a `+`-chain
// of literal parts and `(<expr>).to_string()` calls (see the
// `lexer.TokFString` arm in parser.fern's parse_primary), so an
// f-string lowers end-to-end through both self-host backends.
//
// Goal: validate that the language can express the lexer's logic
// end-to-end without resorting to Go-side workarounds. The Go
// build still owns the production code path; this file is run
// from a Go test that compiles + executes it.

pub struct TokEof { line: i32, col: i32 }
// `raw` is the source spelling of a quoted literal — `'x'` / `b'x'`,
// which reach the parser AS number tokens: the decoded value rides
// `text` as a decimal numeral and the type rides `suffix` ("char" /
// "u8"), so every consumer of a suffixed integer literal handles them
// unchanged. Empty for an ordinary number, where `text` already is the
// spelling. The printer re-emits `raw` so an author's escape survives
// `-fmt`, matching native's ast.CharLit.Raw.
pub struct TokNumber { text: string, suffix: string, raw: string, is_float: boolean, line: i32, col: i32 }
pub struct TokIdent { name: string, line: i32, col: i32 }
pub struct TokKeyword { name: string, line: i32, col: i32 }
pub struct TokPunct { text: string, line: i32, col: i32 }
pub struct TokString { value: string, line: i32, col: i32 }
// TokError surfaces a lex failure (bad numeric suffix, unterminated
// string, bare `0x`, unexpected character, …) as a first-class
// token rather than masquerading as EOF. The Go lexer returns a
// `*lexer.Error` through a side channel; Fern has no exception /
// multi-return-with-error idiom in this port, so the error rides
// the token stream and `tokenize` stops at the first one. Parser
// consumers already fall through these via their `_` match arms.
pub struct TokError { msg: string, line: i32, col: i32 }

// FStringPart is one piece of an f-string. Exactly one of the two
// payload fields is meaningful, selected by `is_expr`: a literal
// segment (escapes already processed) when false, or the raw
// interpolant expression text (the parser sub-parses it) when
// true. `line` / `col` locate `expr`'s first byte in the enclosing
// source so the parser can rebase the sub-parse onto it; they are 0
// on a literal part. Mirrors `lexer.FStringPart` in the Go lexer.
pub struct FStringPart { lit: string, expr: string, is_expr: boolean, line: i32, col: i32 }
pub struct TokFString { parts: FStringPart[], line: i32, col: i32 }

pub type Token = TokEof | TokNumber | TokIdent | TokKeyword | TokPunct | TokString | TokError | TokFString;

// is_digit / is_alpha / is_alnum — byte-level classifiers,
// matching the Go lexer's `unicode.IsDigit` / `IsLetter` on the
// ASCII subset (multibyte UTF-8 source isn't supported here).
function is_digit(b: i32): boolean { return b >= 48 && b <= 57; }
function is_alpha(b: i32): boolean {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}
function is_alnum(b: i32): boolean { return is_digit(b) || is_alpha(b); }
function is_hex_digit(b: i32): boolean {
    return (b >= 48 && b <= 57) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70);
}

// hex_val returns the numeric value of a hex-digit byte (0 otherwise).
function hex_val(b: i32): i32 {
    if (b >= 48 && b <= 57) { return b - 48; }
    if (b >= 97 && b <= 102) { return b - 97 + 10; }
    if (b >= 65 && b <= 70) { return b - 65 + 10; }
    return 0;
}
// Whitespace bytes skipped between tokens. Native uses unicode.IsSpace
// (internal/lexer/lexer.go); at the byte level that includes the ASCII
// set space/tab/LF/CR plus vertical-tab (0x0B) and form-feed (0x0C).
// Without \v/\f a form feed lexed to TokError and tokenize STOPPED,
// silently truncating the program (bogus E052 "missing return") (#4339).
function is_space(b: i32): boolean { return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12; }
function is_suffix_start(b: i32): boolean { return b == 105 || b == 117 || b == 102; }   // 'i' 'u' 'f'

// Keyword set — mirrors `internal/lexer/lexer.go`'s `keywords` map.
// Inlined as a string-comparison chain instead of a Map[string, bool]
// so the lexer stays a single file with no init-order dependency.
function is_keyword(name: string): boolean {
    return name == "function" || name == "var" || name == "let"
        || name == "use" || name == "if" || name == "else"
        || name == "while" || name == "for" || name == "loop" || name == "break"
        || name == "continue" || name == "return"
        || name == "true" || name == "false"
        || name == "boolean" || name == "void" || name == "string"
        || name == "i32" || name == "i64"
        || name == "u8" || name == "u32" || name == "u64"
        || name == "usize" || name == "f32" || name == "f64"
        || name == "as" || name == "default"
        || name == "struct" || name == "import" || name == "pub" || name == "const"
        || name == "enum" || name == "type" || name == "match" || name == "when"
        || name == "defer" || name == "errdefer"
        || name == "trait" || name == "impl" || name == "dyn";
}

function is_valid_numeric_suffix(s: string): boolean {
    return s == "i32" || s == "i64"
        || s == "u8" || s == "u32" || s == "u64"
        || s == "f32" || s == "f64";
}

// Multi-char punctuator longest-prefix match. The Go lexer
// iterates a sorted-by-length string list; here we hand-code the
// length-3 cases first, then length-2, then fall through. Returns
// the matched literal text, or "" if none matched.
//
// `..` (the half-open range operator, `for i in LO..HI`) is in the
// length-2 set; the length-3 `...` spread and `..=` (inclusive range,
// `for i in LO..=HI`) are checked first so `...` / `..=` never mis-lex
// as `..` + `.` / `..` + `=`. A float needs a digit right after
// `.` (scan_number's guard), and `.field` / `.0` stay single-dot, so
// `..` never clashes with field access or fractions.
function match_multipunct(src: string, i: i32, n: i32): string {
    if (i + 3 <= n) {
        var s3: str = slice_unchecked(src, i, i + 3);
        if (s3 == "<<=" || s3 == ">>=" || s3 == "<<|"
            || s3 == "<<?" || s3 == ">>?"
            || s3 == "..." || s3 == "..=") { return s3 + ""; }
    }
    if (i + 2 <= n) {
        var s2: str = slice_unchecked(src, i, i + 2);
        if (s2 == "==" || s2 == "!=" || s2 == "<=" || s2 == ">="
            || s2 == "&&" || s2 == "||" || s2 == "<<" || s2 == ">>"
            || s2 == "=>" || s2 == "|>" || s2 == ".." || s2 == "::"
            || s2 == "+=" || s2 == "-=" || s2 == "*=" || s2 == "/="
            || s2 == "%=" || s2 == "&=" || s2 == "|=" || s2 == "^="
            || s2 == "+|" || s2 == "-|" || s2 == "*|"
            || s2 == "+?" || s2 == "-?" || s2 == "*?"
            || s2 == "/?" || s2 == "%?") {
            return s2 + "";
        }
    }
    return "";
}

// is_single_punct mirrors the Go lexer's bare-punctuation set:
// `+`, `-`, `*`, `/`, `%`, parens / braces / brackets, `,`, `;`,
// `:`, `=`, `<`, `>`, `!`, `&`, `|`, `^`, `?`, `.`, `@`.
function is_single_punct(b: i32): boolean {
    return b == 43 || b == 45 || b == 42 || b == 47 || b == 37
        || b == 40 || b == 41 || b == 123 || b == 125
        || b == 91 || b == 93 || b == 44 || b == 59 || b == 58
        || b == 61 || b == 60 || b == 62 || b == 33
        || b == 38 || b == 124 || b == 94 || b == 63 || b == 46
        || b == 64;
}

// Lexer state, passed as a struct through the helpers below.
// `i` is the byte cursor; `line` / `col` track position for
// diagnostics. The Go lexer carries the same trio on a *lexer
// receiver — porting it as a struct lets the same shape work
// without generic methods on the lexer state.
pub struct Comment { line: i32, col: i32, text: string }

// Takes the body as a `string` parameter so the slice is copied at the call —
// a `str` coerces into a string param but not into a struct field, and the
// Comment outlives the scan.
function comment_tok(line: i32, col: i32, text: string): Comment {
    return Comment { line: line, col: col, text: text };
}

// Comments ride beside the tokens rather than becoming a token kind, so the
// parser stays grammar-only — same split as the Go lexer's Tokenize.
pub struct LexResult { tokens: Token[], comments: Comment[] }

struct TrivResult { lex: Lex, comments: Comment[] }

struct Lex { src: string, i: i32, n: i32, line: i32, col: i32 }

function (l: Lex) at_end(): boolean { return l.i >= l.n; }
function (l: Lex) peek_byte(): i32 {
    if (l.i >= l.n) { return 0; }
    return (l.src[l.i] as i32);
}

// advance consumes one byte, updates line/col. Returns the new
// Lex value — the language is value-semantics-by-default so the
// caller threads the updated state back through.
function (l: Lex) advance(): Lex {
    if (l.i >= l.n) { return l; }
    var b: i32 = l.src[l.i] as i32;
    var new_line: i32 = l.line;
    var new_col: i32 = l.col;
    if (b == 10) {
        new_line = new_line + 1;
        new_col = 1;
    } else {
        new_col = new_col + 1;
    }
    return Lex { src: l.src, i: l.i + 1, n: l.n, line: new_line, col: new_col };
}

// advance_to consumes every byte in [l.i, end) at once, allocating a
// SINGLE Lex instead of one per byte. It tracks line/col exactly as a
// run of `advance()` calls would (newlines reset col, bump line), so
// it's a drop-in for the hot `while (...) { l = l.advance(); }` scan
// loops — which otherwise churn one throwaway Lex box per source
// character (the dominant per-char struct allocation).
function (l: Lex) advance_to(end: i32): Lex {
    if (end <= l.i) { return l; }
    var i: i32 = l.i;
    var new_line: i32 = l.line;
    var new_col: i32 = l.col;
    while (i < end) {
        if (l.src[i] == b'\n') {
            new_line = new_line + 1;
            new_col = 1;
        } else {
            new_col = new_col + 1;
        }
        i = i + 1;
    }
    return Lex { src: l.src, i: end, n: l.n, line: new_line, col: new_col };
}

// skip_trivia drops whitespace and, when `keep` is set, collects `//` line
// comments onto `acc`. Mirrors the Go lexer's `skipTrivia`, except that the Go
// lexer always accumulates: there, comments cost an append into a GC'd slice,
// whereas here each one copies its text into an owned string, and the compile
// path has no consumer for them.
function skip_trivia(l: Lex, acc: Comment[], keep: boolean): TrivResult {
    while (!l.at_end()) {
        var b: i32 = l.peek_byte();
        if (is_space(b)) {
            var we: i32 = l.i;
            while (we < l.n && is_space((l.src[we] as i32))) {
                we = we + 1;
            }
            l = l.advance_to(we);
            continue;
        }
        if (b == 47 && l.i + 1 < l.n && l.src[l.i + 1] == b'/') {
            // `//` line comment — consume to newline (newline
            // itself is left for the next iteration's whitespace
            // path so line tracking stays simple).
            var c_line: i32 = l.line;
            var c_col: i32 = l.col;
            var body: i32 = l.i + 2;
            var ce: i32 = body;
            while (ce < l.n && l.src[ce] != b'\n') {
                ce = ce + 1;
            }
            if (keep) { acc = acc.append(comment_tok(c_line, c_col, slice_unchecked(l.src, body, ce))); }
            l = l.advance_to(ce);
            continue;
        }
        return TrivResult { lex: l, comments: acc };
    }
    return TrivResult { lex: l, comments: acc };
}

// scan_number reads the digit run + optional fractional digits +
// optional typed suffix. The Go lexer returns Token{Kind: Number
// or Float, Text: ..., Suffix: ...}; we mirror with TokNumber
// carrying `is_float`. Returns (Lex post-scan, Token).
struct NumResult { lex: Lex, tok: Token }

// Helper wrap functions — the implicit struct → union wrap
// fires reliably in return position, so each tok-* helper
// upgrades a concrete struct into a Token. Callers just write
// `eof_tok(line, col)` instead of declaring an intermediate
// `var t: Token = TokEof { … };`. Mirrors the Rust `From` impls
// you'd write on top of a sum type.
pub function eof_tok(line: i32, col: i32): Token {
    return TokEof { line: line, col: col };
}
pub function string_tok(value: string, line: i32, col: i32): Token {
    return TokString { value: value, line: line, col: col };
}
pub function ident_tok(name: string, line: i32, col: i32): Token {
    return TokIdent { name: name, line: line, col: col };
}
pub function keyword_tok(name: string, line: i32, col: i32): Token {
    return TokKeyword { name: name, line: line, col: col };
}
pub function punct_tok(text: string, line: i32, col: i32): Token {
    return TokPunct { text: text, line: line, col: col };
}
pub function number_tok(text: string, suffix: string, is_float: boolean, line: i32, col: i32): Token {
    return TokNumber { text: text, suffix: suffix, raw: "", is_float: is_float, line: line, col: col };
}
pub function quoted_tok(text: string, suffix: string, raw: string, line: i32, col: i32): Token {
    return TokNumber { text: text, suffix: suffix, raw: raw, is_float: false, line: line, col: col };
}
pub function error_tok(msg: string, line: i32, col: i32): Token {
    return TokError { msg: msg, line: line, col: col };
}
pub function fstring_tok(parts: FStringPart[], line: i32, col: i32): Token {
    return TokFString { parts: parts, line: line, col: col };
}

// offset_line / offset_col map a position inside a re-lexed fragment
// onto the enclosing source, given where the fragment starts. Only the
// fragment's first line shares a line with the base, so only there does
// the column shift. Mirrors the Go parser's offsetPos.
function offset_line(base_line: i32, line: i32): i32 {
    if (line <= 1) { return base_line; }
    return base_line + line - 1;
}
function offset_col(base_col: i32, line: i32, col: i32): i32 {
    if (line <= 1) { return base_col + col - 1; }
    return col;
}

// rebase_parts renumbers an f-string's interpolant positions, which
// are relative to the fragment the parts were lexed from.
function rebase_parts(parts: FStringPart[], base_line: i32, base_col: i32): FStringPart[] {
    var out: FStringPart[] = [];
    var i: i32 = 0;
    while (i < parts.len()) {
        var p: FStringPart = parts[i];
        if (p.is_expr) {
            out = out.append(FStringPart { lit: p.lit, expr: p.expr, is_expr: true,
                line: offset_line(base_line, p.line), col: offset_col(base_col, p.line, p.col) });
        } else {
            out = out.append(p);
        }
        i = i + 1;
    }
    return out;
}

// rebase_tokens renumbers a token stream lexed from a fragment of a
// larger source so its positions name the enclosing file. The parser
// needs it for f-string interpolants: they are re-lexed from raw text,
// so tokenize numbers them from 1:1 and every diagnostic against the
// resulting AST would otherwise land at the start of the file.
pub function rebase_tokens(toks: Token[], base_line: i32, base_col: i32): Token[] {
    var out: Token[] = [];
    var i: i32 = 0;
    while (i < toks.len()) {
        var t: Token = toks[i];
        match (t) {
            TokEof(x) => { out = out.append(eof_tok(offset_line(base_line, x.line), offset_col(base_col, x.line, x.col))); },
            TokNumber(x) => { out = out.append(number_tok(x.text, x.suffix, x.is_float, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col))); },
            TokIdent(x) => { out = out.append(ident_tok(x.name, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col))); },
            TokKeyword(x) => { out = out.append(keyword_tok(x.name, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col))); },
            TokPunct(x) => { out = out.append(punct_tok(x.text, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col))); },
            TokString(x) => { out = out.append(string_tok(x.value, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col))); },
            TokError(x) => { out = out.append(error_tok(x.msg, offset_line(base_line, x.line), offset_col(base_col, x.line, x.col))); },
            TokFString(x) => { out = out.append(fstring_tok(rebase_parts(x.parts, base_line, base_col), offset_line(base_line, x.line), offset_col(base_col, x.line, x.col))); }
        }
        i = i + 1;
    }
    return out;
}

// is_blank_range — true if every byte of s is ASCII whitespace
// (or s is empty). Stands in for `strings.TrimSpace(x) == ""` in
// the f-string empty-interpolant check; written by hand so the
// lexer keeps to built-ins and imports nothing (the
// parser imports this module that way).
function is_blank_range(s: string): boolean {
    var i: i32 = 0;
    while (i < s.len()) {
        if (!is_space((s[i] as i32))) { return false; }
        i = i + 1;
    }
    return true;
}

// is_error_tok / has_error — predicates over the Token union used
// by `tokenize` to halt at the first lex error and by the test
// harness to assert that malformed inputs surface one.
pub function is_error_tok(t: Token): boolean {
    match (t) {
        TokError(_) => { return true; },
        _ => { return false; }
    }
    return false;
}
pub function has_error(toks: Token[]): boolean {
    var i: i32 = 0;
    while (i < toks.len()) {
        if (is_error_tok(toks[i])) { return true; }
        i = i + 1;
    }
    return false;
}

// `after_dot` is true when the previously-emitted token was a `.`
// punctuator. In that context a trailing `.<digit>` (or `e<digit>`)
// is the NEXT field access of a chained tuple selector like
// `t.1.0`, not a fractional / exponent continuation — so the float
// upgrades below are suppressed. Mirrors the Go lexer's
// `l.afterDot` guard.
function scan_number(l: Lex, after_dot: boolean, start_line: i32, start_col: i32): NumResult {
    var begin: i32 = l.i;
    var is_hex: boolean = false;
    // `0x` / `0X` hex integer literal: consume hex digits, skip the
    // float (fractional / exponent) upgrades. A bare `0x` with no
    // following hex digit is an error, not a silent `0` + `x` ident.
    if (l.peek_byte() == 48 && l.i + 1 < l.n
        && (l.src[l.i + 1] == b'x' || l.src[l.i + 1] == b'X')) {
        is_hex = true;
        l = l.advance_to(l.i + 2);   // '0' then 'x' / 'X'
        var hex_start: i32 = l.i;
        var he: i32 = l.i;
        while (he < l.n && is_hex_digit((l.src[he] as i32))) {
            he = he + 1;
        }
        l = l.advance_to(he);
        if (l.i == hex_start) {
            return NumResult { lex: l, tok: error_tok("hex literal needs at least one digit after 0x", start_line, start_col) };
        }
    } else {
        var de: i32 = l.i;
        while (de < l.n && is_digit((l.src[de] as i32))) {
            de = de + 1;
        }
        l = l.advance_to(de);
    }
    var is_float: boolean = false;
    // Fractional part: `.<digit>+`. Suppressed for hex and right
    // after a `.` (chained tuple index).
    if (!is_hex && !after_dot && l.i + 1 < l.n && l.src[l.i] == b'.' && is_digit((l.src[l.i + 1] as i32))) {
        is_float = true;
        l = l.advance_to(l.i + 1);   // consume `.`
        var fe: i32 = l.i;
        while (fe < l.n && is_digit((l.src[fe] as i32))) {
            fe = fe + 1;
        }
        l = l.advance_to(fe);
    }
    // Scientific-notation exponent: `[eE][+-]?[0-9]+`, valid on an
    // integer base (`1e3`) or a fractional one (`1.5e-2`). Only
    // consumed when at least one exponent digit follows the optional
    // sign — a bare `1e` / `1efoo` leaves the `e` for the next token.
    if (!is_hex && !after_dot && !l.at_end()
        && (l.peek_byte() == 101 || l.peek_byte() == 69)) {   // 'e' / 'E'
        var j: i32 = l.i + 1;
        if (j < l.n && (l.src[j] == b'+' || l.src[j] == b'-')) { j = j + 1; }
        if (j < l.n && is_digit((l.src[j] as i32))) {
            is_float = true;
            l = l.advance_to(l.i + 1);   // 'e' / 'E'
            if (!l.at_end() && (l.peek_byte() == 43 || l.peek_byte() == 45)) {
                l = l.advance_to(l.i + 1);   // sign
            }
            var ee: i32 = l.i;
            while (ee < l.n && is_digit((l.src[ee] as i32))) {
                ee = ee + 1;
            }
            l = l.advance_to(ee);
        }
    }
    var text: str = slice_unchecked(l.src, begin, l.i);
    // Optional typed suffix: i32/i64/u8/u32/u64/f32/f64.
    // The suffix character set is a closed list, so misspellings
    // like `42i33` / a truncated `42i` fail here rather than
    // partially consuming. An integer suffix on a float literal
    // (`1.5i32`) is likewise an error.
    var suffix: string = "";
    if (!l.at_end() && is_suffix_start(l.peek_byte())) {
        var s_begin: i32 = l.i;
        l = l.advance_to(l.i + 1);
        var se: i32 = l.i;
        while (se < l.n && is_digit((l.src[se] as i32))) {
            se = se + 1;
        }
        l = l.advance_to(se);
        suffix = slice_unchecked(l.src, s_begin, l.i) + "";
        if (!is_valid_numeric_suffix(suffix)) {
            return NumResult { lex: l, tok: error_tok("unknown numeric suffix", start_line, start_col) };
        }
        if (is_float && suffix[0] != b'f') {
            return NumResult { lex: l, tok: error_tok("integer suffix on float literal", start_line, start_col) };
        }
    }
    // `42f32` / `42f64` — integer text with float suffix promotes
    // the token to Float so a downstream parser routes via the
    // float-literal construction path.
    if (!is_float && suffix.len() > 0 && suffix[0] == b'f') {
        is_float = true;
    }
    var tok: Token = number_tok(text, suffix, is_float, start_line, start_col);
    return NumResult { lex: l, tok: tok };
}

// scan_ident reads the identifier run + classifies as keyword or
// plain identifier.
function scan_ident(l: Lex, start_line: i32, start_col: i32): NumResult {
    var begin: i32 = l.i;
    var e: i32 = l.i;
    while (e < l.n && is_alnum((l.src[e] as i32))) {
        e = e + 1;
    }
    l = l.advance_to(e);
    var text: str = slice_unchecked(l.src, begin, l.i);
    var tok: Token = ident_tok(text, start_line, start_col);
    if (is_keyword(text)) {
        tok = keyword_tok(text, start_line, start_col);
    }
    return NumResult { lex: l, tok: tok };
}

// apply_escape decodes a C-style escape whose escape byte `esc` has
// already been consumed (so `l` is positioned just past it). It returns
// the decoded fragment plus flags for the two failure shapes — `\x`
// needing two hex digits (`hexerr`) and an unrecognised escape
// (`unknown`) — so scan_string and scan_fstring share one decode ladder
// while keeping their own literal-kind error messages (SH-043).
struct EscResult { lex: Lex, frag: string, hexerr: boolean, unknown: boolean }

function apply_escape(l: Lex, esc: i32): EscResult {
    if (esc == 110) { return EscResult { lex: l, frag: "\n", hexerr: false, unknown: false }; }
    if (esc == 116) { return EscResult { lex: l, frag: "\t", hexerr: false, unknown: false }; }
    if (esc == 114) { return EscResult { lex: l, frag: "\r", hexerr: false, unknown: false }; }
    if (esc == 48) { return EscResult { lex: l, frag: "\0", hexerr: false, unknown: false }; }
    if (esc == 34) { return EscResult { lex: l, frag: "\"", hexerr: false, unknown: false }; }
    if (esc == 92) { return EscResult { lex: l, frag: "\\", hexerr: false, unknown: false }; }
    if (esc == 120) {
        // \xNN — two hex digits → one byte.
        if (l.i + 1 >= l.n || !is_hex_digit((l.src[l.i] as i32)) || !is_hex_digit((l.src[l.i + 1] as i32))) {
            return EscResult { lex: l, frag: "", hexerr: true, unknown: false };
        }
        var b: i32 = hex_val((l.src[l.i] as i32)) * 16 + hex_val((l.src[l.i + 1] as i32));
        l = l.advance();
        l = l.advance();
        return EscResult { lex: l, frag: string_from_bytes_unchecked([b]), hexerr: false, unknown: false };
    }
    return EscResult { lex: l, frag: "", hexerr: false, unknown: true };
}

// dec_str renders a non-negative i32 in base 10. util.i32_to_string is
// the shared home for this, but reaching it means importing util here,
// and this module deliberately imports nothing — see the header. Only
// scan_quoted needs it, over the scalar range 0..0x10FFFF.
function dec_str(v: i32): string {
    if (v == 0) { return "0"; }
    var rev: i32[] = [];
    while (v > 0) {
        rev = rev.append(48 + (v % 10));
        v = v / 10;
    }
    var out: string = "";
    var i: i32 = rev.len() - 1;
    while (i >= 0) {
        out = out + string_from_bytes_unchecked([rev[i]]);
        i = i - 1;
    }
    return out;
}

// Utf8 is one decoded UTF-8 sequence: `val` is the scalar, `len` its
// byte length, and len 0 marks a malformed sequence. Only character
// literals need it — every other scanner here works byte-at-a-time.
struct Utf8 { val: i32, len: i32 }

function decode_utf8(src: string, i: i32, n: i32): Utf8 {
    var b0: i32 = src[i] as i32;
    if (b0 < 128) { return Utf8 { val: b0, len: 1 }; }
    var need: i32 = 0;
    var val: i32 = 0;
    if (b0 >= 240 && b0 < 248) { need = 3; val = b0 & 7; }
    else if (b0 >= 224) { need = 2; val = b0 & 15; }
    else if (b0 >= 192) { need = 1; val = b0 & 31; }
    else { return Utf8 { val: 0, len: 0 }; }
    if (i + need >= n) { return Utf8 { val: 0, len: 0 }; }
    var k: i32 = 1;
    while (k <= need) {
        var c: i32 = src[i + k] as i32;
        if (c < 128 || c >= 192) { return Utf8 { val: 0, len: 0 }; }
        val = (val << 6) | (c & 63);
        k = k + 1;
    }
    return Utf8 { val: val, len: need + 1 };
}

// EscVal is one decoded escape inside a quoted literal: the advanced
// lexer, the scalar it produced, and a non-empty `err` when the escape
// was rejected.
struct EscVal { lex: Lex, val: i32, err: string }

// quoted_escape decodes the escape at the current `\`, which it
// consumes along with the escape body. `\u{...}` is a Unicode scalar so
// it is character-literal-only, and `\xNN` reaches the full byte range
// in a byte literal but stops at 0x7F in a character literal, where
// anything above ASCII has two readings and `\u{...}` says which.
// Mirrors the Go lexer's scanQuotedEscape.
function quoted_escape(l: Lex, is_byte: boolean): EscVal {
    l = l.advance();   // backslash
    if (l.at_end()) { return EscVal { lex: l, val: 0, err: "unterminated quoted literal" }; }
    var esc: i32 = l.peek_byte();
    l = l.advance();
    if (esc == 110) { return EscVal { lex: l, val: 10, err: "" }; }
    if (esc == 116) { return EscVal { lex: l, val: 9, err: "" }; }
    if (esc == 114) { return EscVal { lex: l, val: 13, err: "" }; }
    if (esc == 48) { return EscVal { lex: l, val: 0, err: "" }; }
    if (esc == 92) { return EscVal { lex: l, val: 92, err: "" }; }
    if (esc == 39) { return EscVal { lex: l, val: 39, err: "" }; }
    if (esc == 34) { return EscVal { lex: l, val: 34, err: "" }; }
    if (esc == 120) {
        if (l.i + 1 >= l.n || !is_hex_digit((l.src[l.i] as i32)) || !is_hex_digit((l.src[l.i + 1] as i32))) {
            return EscVal { lex: l, val: 0, err: "\\x escape needs two hex digits" };
        }
        var v: i32 = hex_val((l.src[l.i] as i32)) * 16 + hex_val((l.src[l.i + 1] as i32));
        l = l.advance();
        l = l.advance();
        if (!is_byte && v > 127) {
            return EscVal { lex: l, val: 0, err: "\\x escape is above ASCII in a character literal; write \\u{...} for the scalar" };
        }
        return EscVal { lex: l, val: v, err: "" };
    }
    if (esc == 117) {
        if (is_byte) {
            return EscVal { lex: l, val: 0, err: "\\u{...} is a Unicode scalar; a byte literal takes \\xNN" };
        }
        if (l.at_end() || l.peek_byte() != 123) {
            return EscVal { lex: l, val: 0, err: "\\u escape needs braces: \\u{1F600}" };
        }
        l = l.advance();   // {
        var digits: i32 = 0;
        var uv: i32 = 0;
        while (!l.at_end() && is_hex_digit(l.peek_byte())) {
            if (digits == 6) { return EscVal { lex: l, val: 0, err: "\\u{...} takes at most 6 hex digits" }; }
            uv = uv * 16 + hex_val(l.peek_byte());
            digits = digits + 1;
            l = l.advance();
        }
        if (digits == 0) { return EscVal { lex: l, val: 0, err: "\\u{...} needs at least one hex digit" }; }
        if (l.at_end() || l.peek_byte() != 125) { return EscVal { lex: l, val: 0, err: "unterminated \\u{...} escape" }; }
        l = l.advance();   // }
        if (uv > 1114111) { return EscVal { lex: l, val: 0, err: "\\u{...} is above the maximum Unicode scalar 10FFFF" }; }
        if (uv >= 55296 && uv <= 57343) { return EscVal { lex: l, val: 0, err: "\\u{...} is a surrogate, not a Unicode scalar value" }; }
        return EscVal { lex: l, val: uv, err: "" };
    }
    return EscVal { lex: l, val: 0, err: "unknown escape in quoted literal" };
}

// closing_quote_ahead separates a too-long literal (`'ab'`) from an
// unterminated one (`'ab`) so each error names its own problem.
function closing_quote_ahead(l: Lex): boolean {
    var j: i32 = l.i;
    while (j < l.n && l.src[j] != b'\n') {
        if (l.src[j] == b'\'') { return true; }
        j = j + 1;
    }
    return false;
}

// scan_quoted reads a character literal `'x'` or, when `is_byte`, a
// byte literal `b'x'`; `l` is positioned at the leading `b` / `'`.
// Everything a literal cannot mean is rejected here rather than left
// for the parser: an empty `''`, more than one scalar / byte, a
// non-ASCII `b'é'`, and an unterminated one. Mirrors scanQuoted in
// internal/lexer/lexer.go.
function scan_quoted(l: Lex, is_byte: boolean, start_line: i32, start_col: i32): NumResult {
    var begin: i32 = l.i;
    var kind_name: string = "character";
    var suffix: string = "char";
    if (is_byte) {
        kind_name = "byte";
        suffix = "u8";
        l = l.advance();   // `b`
    }
    l = l.advance();       // opening '
    if (l.at_end()) {
        return NumResult { lex: l, tok: error_tok("unterminated " + kind_name + " literal", start_line, start_col) };
    }
    var c: i32 = l.peek_byte();
    if (c == 39) {
        l = l.advance();
        return NumResult { lex: l, tok: error_tok("empty " + kind_name + " literal", start_line, start_col) };
    }
    if (c == 10) {
        return NumResult { lex: l, tok: error_tok("newline inside " + kind_name + " literal", start_line, start_col) };
    }
    var val: i32 = 0;
    if (c == 92) {
        var ev: EscVal = quoted_escape(l, is_byte);
        l = ev.lex;
        if (ev.err.len() > 0) {
            return NumResult { lex: l, tok: error_tok(ev.err, start_line, start_col) };
        }
        val = ev.val;
    } else if (is_byte) {
        if (c >= 128) {
            return NumResult { lex: l, tok: error_tok("byte literal must be ASCII; write a character literal for a Unicode scalar", start_line, start_col) };
        }
        val = c;
        l = l.advance();
    } else {
        var u: Utf8 = decode_utf8(l.src, l.i, l.n);
        if (u.len == 0) {
            return NumResult { lex: l, tok: error_tok("invalid UTF-8 byte in character literal", start_line, start_col) };
        }
        val = u.val;
        l = l.advance_to(l.i + u.len);
    }
    if (l.at_end() || l.peek_byte() != 39) {
        if (closing_quote_ahead(l)) {
            return NumResult { lex: l, tok: error_tok(kind_name + " literal must hold exactly one " + kind_name, start_line, start_col) };
        }
        return NumResult { lex: l, tok: error_tok("unterminated " + kind_name + " literal", start_line, start_col) };
    }
    l = l.advance();       // closing '
    return NumResult { lex: l, tok: quoted_tok(dec_str(val), suffix, slice_unchecked(l.src, begin, l.i) + "", start_line, start_col) };
}

// scan_string reads `"…"` with C-style escapes. The Go lexer
// uses strings.Builder + WriteRune; here we build the unescaped
// value by walking the source and concatenating. Errors (newline
// inside string, unknown escape, unterminated) surface as a
// TokError carrying a diagnostic message — matching the Go
// lexer's error shapes.
function scan_string(l: Lex, start_line: i32, start_col: i32): NumResult {
    l = l.advance();   // opening "
    var out: string = "";
    while (!l.at_end() && l.peek_byte() != 34) {
        var c: i32 = l.peek_byte();
        if (c == 10) {
            return NumResult { lex: l, tok: error_tok("newline inside string literal", start_line, start_col) };
        }
        if (c == 92) {   // backslash
            l = l.advance();
            if (l.at_end()) {
                return NumResult { lex: l, tok: error_tok("unterminated string literal", start_line, start_col) };
            }
            var esc: i32 = l.peek_byte();
            l = l.advance();
            var er: EscResult = apply_escape(l, esc);
            l = er.lex;
            if (er.hexerr) {
                return NumResult { lex: l, tok: error_tok("\\x escape needs two hex digits", start_line, start_col) };
            }
            if (er.unknown) {
                return NumResult { lex: l, tok: error_tok("unknown escape in string literal", start_line, start_col) };
            }
            out = out + er.frag;
            continue;
        }
        out = out + slice_unchecked(l.src, l.i, l.i + 1);
        l = l.advance();
    }
    if (l.at_end()) {
        return NumResult { lex: l, tok: error_tok("unterminated string literal", start_line, start_col) };
    }
    l = l.advance();   // closing "
    return NumResult { lex: l, tok: string_tok(out, start_line, start_col) };
}

// scan_fstring consumes the body of an f-string. `l` is positioned
// at the opening `"` (the leading `f` is already consumed). It
// returns a TokFString whose parts alternate literal segments with
// raw interpolant-expression text, mirroring the Go lexer's
// scanFString:
//
//   f"hi {x + 1}!"  → [Lit "hi ", Expr "x + 1", Lit "!"]
//   f"{count}"      → [Expr "count"]
//   f"plain"        → [Lit "plain"]
//   f""             → []
//
// `{{` / `}}` escape literal braces; standard escapes apply in the
// literal portions; inside `{...}` the bytes pass through verbatim
// (with nested braces tracked and inner string literals skipped so
// their quotes / braces don't break the boundary scan). All the
// failure shapes surface a TokError.
function scan_fstring(l: Lex, start_line: i32, start_col: i32): NumResult {
    l = l.advance();   // opening "
    var lit: string = "";
    var have_lit: boolean = false;
    var parts: FStringPart[] = [];
    while (!l.at_end()) {
        var c: i32 = l.peek_byte();
        if (c == 34) {   // closing "
            l = l.advance();
            if (have_lit) {
                parts = parts.append(FStringPart { lit: lit, expr: "", is_expr: false, line: 0, col: 0 });
            }
            return NumResult { lex: l, tok: fstring_tok(parts, start_line, start_col) };
        }
        if (c == 10) {
            return NumResult { lex: l, tok: error_tok("newline inside f-string literal", start_line, start_col) };
        }
        if (c == 92) {   // backslash escape (literal portion only)
            l = l.advance();
            if (l.at_end()) {
                return NumResult { lex: l, tok: error_tok("unterminated f-string literal", start_line, start_col) };
            }
            var esc: i32 = l.peek_byte();
            l = l.advance();
            var fer: EscResult = apply_escape(l, esc);
            l = fer.lex;
            if (fer.hexerr) {
                return NumResult { lex: l, tok: error_tok("\\x escape needs two hex digits", start_line, start_col) };
            }
            if (fer.unknown) {
                return NumResult { lex: l, tok: error_tok("unknown escape in f-string", start_line, start_col) };
            }
            lit = lit + fer.frag;
            have_lit = true;
            continue;
        }
        if (c == 123) {   // {
            if (l.i + 1 < l.n && l.src[l.i + 1] == b'{') {   // {{ → literal {
                lit = lit + "{";
                have_lit = true;
                l = l.advance();
                l = l.advance();
                continue;
            }
            l = l.advance();   // opening {
            if (have_lit) {   // flush the literal accumulated so far
                parts = parts.append(FStringPart { lit: lit, expr: "", is_expr: false, line: 0, col: 0 });
                lit = "";
                have_lit = false;
            }
            // Find the matching `}` at brace-depth 0. Nested braces
            // bump the depth; a string literal inside the interpolant
            // is skipped wholesale so its quotes / braces don't move
            // the boundary.
            var expr_start: i32 = l.i;
            var expr_line: i32 = l.line;
            var expr_col: i32 = l.col;
            var depth: i32 = 1;
            while (!l.at_end() && depth > 0) {
                var d: i32 = l.peek_byte();
                if (d == 123) {
                    depth = depth + 1;
                } else if (d == 125) {
                    depth = depth - 1;
                    if (depth == 0) { break; }
                } else if (d == 10) {
                    return NumResult { lex: l, tok: error_tok("newline inside f-string interpolation", start_line, start_col) };
                } else if (d == 34) {
                    l = l.advance();   // opening "
                    while (!l.at_end() && l.peek_byte() != 34) {
                        if (l.peek_byte() == 92 && l.i + 1 < l.n) {
                            l = l.advance();   // skip escaped char
                        }
                        l = l.advance();
                    }
                    if (l.at_end()) {
                        return NumResult { lex: l, tok: error_tok("unterminated string inside f-string interpolation", start_line, start_col) };
                    }
                    // l now at the closing `"`; the advance below consumes it.
                }
                if (depth > 0) {
                    l = l.advance();
                }
            }
            if (depth != 0) {
                return NumResult { lex: l, tok: error_tok("unterminated `{` in f-string", start_line, start_col) };
            }
            var expr_text: str = slice_unchecked(l.src, expr_start, l.i);
            l = l.advance();   // closing }
            if (is_blank_range(expr_text)) {
                return NumResult { lex: l, tok: error_tok("empty `{}` in f-string", start_line, start_col) };
            }
            parts = parts.append(FStringPart { lit: "", expr: expr_text + "", is_expr: true, line: expr_line, col: expr_col });
            continue;
        }
        if (c == 125) {   // }
            if (l.i + 1 < l.n && l.src[l.i + 1] == b'}') {   // }} → literal }
                lit = lit + "}";
                have_lit = true;
                l = l.advance();
                l = l.advance();
                continue;
            }
            return NumResult { lex: l, tok: error_tok("unmatched `}` in f-string (use `}}` for a literal `}`)", start_line, start_col) };
        }
        lit = lit + slice_unchecked(l.src, l.i, l.i + 1);
        have_lit = true;
        l = l.advance();
    }
    return NumResult { lex: l, tok: error_tok("unterminated f-string literal", start_line, start_col) };
}

// tokenize returns just the tokens, for the compile path, which has no use
// for comments. Callers that want them (doc extraction, formatting) call
// tokenize_full.
pub function tokenize(src: string): Token[] {
    return tokenize_impl(src, false).tokens;
}

// tokenize_full is the top-level entrypoint. Mirrors the Go lexer's
// `Tokenize` — a Token[] terminated by TokEof, plus the `//` comments
// seen along the way, in source order.
pub function tokenize_full(src: string): LexResult {
    return tokenize_impl(src, true);
}

function tokenize_impl(src: string, keep: boolean): LexResult {
    var l: Lex = Lex { src: src, i: 0, n: src.len(), line: 1, col: 1 };
    var out: Token[] = [];
    var comments: Comment[] = [];
    // Tracks whether the previously-emitted token was a `.` punct,
    // so the number scanner can suppress the chained-tuple float
    // upgrade (`t.1.0`). Mirrors the Go lexer's `l.afterDot`.
    var after_dot: boolean = false;
    while (true) {
        var tr: TrivResult = skip_trivia(l, comments, keep);
        l = tr.lex;
        comments = tr.comments;
        if (l.at_end()) {
            out = out.append(TokEof { line: l.line, col: l.col });
            return LexResult { tokens: out, comments: comments };
        }
        var start_line: i32 = l.line;
        var start_col: i32 = l.col;
        var b: i32 = l.peek_byte();
        // f-string `f"..."` — checked before the identifier path so
        // the leading `f` isn't scooped up as an ident. Mirrors the
        // Go lexer's first-branch f-string detection.
        if (b == 102 && l.i + 1 < l.n && l.src[l.i + 1] == b'"') {
            l = l.advance();   // consume `f`
            var rf = scan_fstring(l, start_line, start_col);
            l = rf.lex;
            out = out.append(rf.tok);
            if (is_error_tok(rf.tok)) { return LexResult { tokens: out, comments: comments }; }
            after_dot = false;
            continue;
        }
        // Byte literal `b'x'` — checked before the identifier path for
        // the same reason the f-string prefix is: `b` starts an
        // identifier, and no valid program has one immediately followed
        // by a `'`.
        if (b == 98 && l.i + 1 < l.n && l.src[l.i + 1] == b'\'') {
            var rb = scan_quoted(l, true, start_line, start_col);
            l = rb.lex;
            out = out.append(rb.tok);
            if (is_error_tok(rb.tok)) { return LexResult { tokens: out, comments: comments }; }
            after_dot = false;
            continue;
        }
        if (b == 39) {   // '
            var rc = scan_quoted(l, false, start_line, start_col);
            l = rc.lex;
            out = out.append(rc.tok);
            if (is_error_tok(rc.tok)) { return LexResult { tokens: out, comments: comments }; }
            after_dot = false;
            continue;
        }
        if (is_digit(b)) {
            var rn = scan_number(l, after_dot, start_line, start_col);
            l = rn.lex;
            out = out.append(rn.tok);
            if (is_error_tok(rn.tok)) { return LexResult { tokens: out, comments: comments }; }
            after_dot = false;
            continue;
        }
        if (is_alpha(b)) {
            var ri = scan_ident(l, start_line, start_col);
            l = ri.lex;
            out = out.append(ri.tok);
            after_dot = false;
            continue;
        }
        if (b == 34) {   // "
            var rs = scan_string(l, start_line, start_col);
            l = rs.lex;
            out = out.append(rs.tok);
            if (is_error_tok(rs.tok)) { return LexResult { tokens: out, comments: comments }; }
            after_dot = false;
            continue;
        }
        var mp: string = match_multipunct(l.src, l.i, l.n);
        if (mp.len() > 0) {
            var i: i32 = 0;
            while (i < mp.len()) {
                l = l.advance();
                i = i + 1;
            }
            // `::` is the path separator — pure surface syntax, equivalent to
            // `.` (`Type::f` / `mod::g` / `Type::CONST`). The self-host AST
            // carries no record of the separator, so normalise it to a `.`
            // token here and every `.`-handling parser site (postfix access,
            // qualified names, qualified patterns) treats it identically.
            // Mirrors the native parser's `::` → FieldAccess. See #2700.
            var ptext: string = mp;
            if (mp == "::") { ptext = "."; }
            out = out.append(TokPunct { text: ptext, line: start_line, col: start_col });
            after_dot = false;
            continue;
        }
        if (is_single_punct(b)) {
            var text: str = slice_unchecked(l.src, l.i, l.i + 1);
            l = l.advance();
            out = out.append(TokPunct { text: text + "", line: start_line, col: start_col });
            after_dot = (text == ".");
            continue;
        }
        // Unknown byte — surface a TokError and stop, matching the
        // Go lexer's `unexpected character` error.
        out = out.append(error_tok("unexpected character", start_line, start_col));
        return LexResult { tokens: out, comments: comments };
    }
    return LexResult { tokens: out, comments: comments };
}

// test_mixed feeds a mixed-token input through tokenize, walks the
// resulting Token[] with literal-pattern match arms, and returns 0
// if every assertion holds. Non-zero return codes pinpoint which
// arm fired so the Go test can surface the right diagnostic.
function test_mixed(): i32 {
    var src: string = "var x: i32 = 42i64; // a comment\nreturn x + 1.5f64;\n";
    var toks: Token[] = tokenize(src);

    // Expected sequence:
    //   Keyword "var"
    //   Ident "x"
    //   Punct ":"
    //   Keyword "i32"
    //   Punct "="
    //   Number "42" suffix="i64"
    //   Punct ";"
    //   Keyword "return"
    //   Ident "x"
    //   Punct "+"
    //   Number "1.5" suffix="f64" is_float=true
    //   Punct ";"
    //   Eof

    if (toks.len() != 13) { return 1; }

    match (toks[0]) {
        TokKeyword(t) => {
            if (t.name != "var") { return 100; }
        },
        _ => { return 101; }
    }
    match (toks[1]) {
        TokIdent(t) => {
            if (t.name != "x") { return 200; }
        },
        _ => { return 201; }
    }
    match (toks[2]) {
        TokPunct(t) => {
            if (t.text != ":") { return 300; }
        },
        _ => { return 301; }
    }
    match (toks[3]) {
        TokKeyword(t) => {
            if (t.name != "i32") { return 400; }
        },
        _ => { return 401; }
    }
    match (toks[4]) {
        TokPunct(t) => {
            if (t.text != "=") { return 500; }
        },
        _ => { return 501; }
    }
    match (toks[5]) {
        TokNumber(t) => {
            if (t.text != "42") { return 600; }
            if (t.suffix != "i64") { return 601; }
            if (t.is_float) { return 602; }
        },
        _ => { return 603; }
    }
    match (toks[6]) {
        TokPunct(t) => {
            if (t.text != ";") { return 700; }
        },
        _ => { return 701; }
    }
    match (toks[7]) {
        TokKeyword(t) => {
            if (t.name != "return") { return 800; }
            if (t.line != 2) { return 801; }
        },
        _ => { return 802; }
    }
    match (toks[8]) {
        TokIdent(t) => {
            if (t.name != "x") { return 900; }
        },
        _ => { return 901; }
    }
    match (toks[9]) {
        TokPunct(t) => {
            if (t.text != "+") { return 1000; }
        },
        _ => { return 1001; }
    }
    match (toks[10]) {
        TokNumber(t) => {
            if (t.text != "1.5") { return 1100; }
            if (t.suffix != "f64") { return 1101; }
            if (!t.is_float) { return 1102; }
        },
        _ => { return 1103; }
    }
    match (toks[11]) {
        TokPunct(t) => {
            if (t.text != ";") { return 1200; }
        },
        _ => { return 1201; }
    }
    match (toks[12]) {
        TokEof(_) => {
            return 0;
        },
        _ => { return 1300; }
    }
    return -1;
}

// test_hex — `0x` / `0X` integer literals, mixed-case digits, and a
// trailing typed suffix (`0x10u8`). All come back as non-float
// Number tokens whose text includes the prefix.
function test_hex(): i32 {
    var toks: Token[] = tokenize("0x2A 0xff 0X0 0xDEADBEEF 0x10u8");
    if (toks.len() != 6) { return 1400; }
    match (toks[0]) {
        TokNumber(t) => {
            if (t.text != "0x2A") { return 1401; }
            if (t.is_float) { return 1402; }
        },
        _ => { return 1403; }
    }
    match (toks[1]) {
        TokNumber(t) => { if (t.text != "0xff") { return 1404; } },
        _ => { return 1405; }
    }
    match (toks[2]) {
        TokNumber(t) => { if (t.text != "0X0") { return 1406; } },
        _ => { return 1407; }
    }
    match (toks[3]) {
        TokNumber(t) => { if (t.text != "0xDEADBEEF") { return 1408; } },
        _ => { return 1409; }
    }
    match (toks[4]) {
        TokNumber(t) => {
            if (t.text != "0x10") { return 1410; }
            if (t.suffix != "u8") { return 1411; }
        },
        _ => { return 1412; }
    }
    match (toks[5]) {
        TokEof(_) => { return 0; },
        _ => { return 1413; }
    }
    return 1414;
}

// test_scientific — `[eE][+-]?[0-9]+` exponents on both integer and
// fractional bases. Every input is a single Float whose text is
// ParseFloat-ready.
function test_scientific(): i32 {
    var toks: Token[] = tokenize("1e3 1.5e10 1.5E3 2.0e-2 6.022e+23");
    if (toks.len() != 6) { return 1500; }
    match (toks[0]) {
        TokNumber(t) => {
            if (t.text != "1e3") { return 1501; }
            if (!t.is_float) { return 1502; }
        },
        _ => { return 1503; }
    }
    match (toks[1]) {
        TokNumber(t) => { if (t.text != "1.5e10") { return 1504; } },
        _ => { return 1505; }
    }
    match (toks[2]) {
        TokNumber(t) => { if (t.text != "1.5E3") { return 1506; } },
        _ => { return 1507; }
    }
    match (toks[3]) {
        TokNumber(t) => { if (t.text != "2.0e-2") { return 1508; } },
        _ => { return 1509; }
    }
    match (toks[4]) {
        TokNumber(t) => { if (t.text != "6.022e+23") { return 1510; } },
        _ => { return 1511; }
    }
    return 0;
}

// test_bare_e — a dangling `e` with no exponent digits is NOT an
// exponent: the number stops before it and the `e...` lexes as a
// separate identifier. `1e foo` → Number "1", Ident "e", Ident
// "foo", EOF.
function test_bare_e(): i32 {
    var toks: Token[] = tokenize("1e foo");
    if (toks.len() != 4) { return 1550; }
    match (toks[0]) {
        TokNumber(t) => { if (t.text != "1") { return 1551; } },
        _ => { return 1552; }
    }
    match (toks[1]) {
        TokIdent(t) => { if (t.name != "e") { return 1553; } },
        _ => { return 1554; }
    }
    match (toks[2]) {
        TokIdent(t) => { if (t.name != "foo") { return 1555; } },
        _ => { return 1556; }
    }
    return 0;
}

// test_chained_tuple — `t.1.0` must lex as three values joined by
// two dots, NOT `t . 1.0` with `1.0` eaten as a float. The afterDot
// guard suppresses the `.<digit>` float upgrade after a `.`.
function test_chained_tuple(): i32 {
    var toks: Token[] = tokenize("t.1.0");
    if (toks.len() != 6) { return 1600; }
    match (toks[0]) {
        TokIdent(t) => { if (t.name != "t") { return 1601; } },
        _ => { return 1602; }
    }
    match (toks[1]) {
        TokPunct(t) => { if (t.text != ".") { return 1603; } },
        _ => { return 1604; }
    }
    match (toks[2]) {
        TokNumber(t) => {
            if (t.text != "1") { return 1605; }
            if (t.is_float) { return 1606; }
        },
        _ => { return 1607; }
    }
    match (toks[3]) {
        TokPunct(t) => { if (t.text != ".") { return 1608; } },
        _ => { return 1609; }
    }
    match (toks[4]) {
        TokNumber(t) => {
            if (t.text != "0") { return 1610; }
            if (t.is_float) { return 1611; }
        },
        _ => { return 1612; }
    }
    return 0;
}

// test_float_after_nondot — pin that the afterDot suppression
// doesn't over-fire: a `.<digit>` after a non-dot context still
// upgrades to a float. `var f = 1.5;` yields exactly one Float.
function test_float_after_nondot(): i32 {
    var toks: Token[] = tokenize("var f = 1.5;");
    var floats: i32 = 0;
    var i: i32 = 0;
    while (i < toks.len()) {
        match (toks[i]) {
            TokNumber(t) => { if (t.is_float) { floats = floats + 1; } },
            _ => {}
        }
        i = i + 1;
    }
    if (floats != 1) { return 1650; }
    return 0;
}

// test_suffix_errors — the closed-list suffix validation: bad
// (`42i33`), truncated (`42i`), and integer-on-float (`1.5i32`)
// suffixes all surface a TokError, while the valid forms don't.
function test_suffix_errors(): i32 {
    if (!has_error(tokenize("42i33"))) { return 1700; }
    if (!has_error(tokenize("42i"))) { return 1701; }
    if (!has_error(tokenize("1.5i32"))) { return 1702; }
    if (has_error(tokenize("42i64"))) { return 1703; }
    if (has_error(tokenize("7u8"))) { return 1704; }
    if (has_error(tokenize("42f32"))) { return 1705; }
    if (has_error(tokenize("1.5f64"))) { return 1706; }
    return 0;
}

// test_hex_needs_digits — a bare `0x` with no hex digit is an error.
function test_hex_needs_digits(): i32 {
    if (!has_error(tokenize("0x"))) { return 1800; }
    if (has_error(tokenize("0x1"))) { return 1801; }
    return 0;
}

// test_string_errors — unterminated, unknown-escape, and
// newline-inside string literals each surface a TokError; a
// well-formed literal does not.
function test_string_errors(): i32 {
    if (!has_error(tokenize("\"oops"))) { return 1850; }
    if (!has_error(tokenize("\"a\\zb\""))) { return 1851; }
    if (!has_error(tokenize("\"with\nnewline\""))) { return 1852; }
    if (has_error(tokenize("\"ok\""))) { return 1853; }
    return 0;
}

// test_unknown_char — an unexpected byte surfaces a TokError. `@` is a
// valid punctuator now (it introduces the `@derive` attribute, matching
// the Go lexer), so the unknown-char case uses `$`.
function test_unknown_char(): i32 {
    if (!has_error(tokenize("$"))) { return 1900; }
    if (has_error(tokenize("@"))) { return 1901; }
    return 0;
}

// check_quoted — assert toks[0] is the number token a quoted literal
// lexes to, with the decoded scalar in `text`, the type in `suffix`
// and the spelling in `raw`.
function check_quoted(src: string, want_text: string, want_suffix: string): boolean {
    var t: Token[] = tokenize(src);
    if (t.len() != 2) { return false; }
    match (t[0]) {
        TokNumber(n) => {
            return n.text == want_text && n.suffix == want_suffix
                && n.raw == src && !n.is_float;
        },
        _ => { return false; }
    }
    return false;
}

// test_quoted_literals — `'x'` (a `char`) and `b'x'` (a `u8`), the
// escape set each accepts, and every spelling rejected at lex time.
// Mirrors the Go lexer's TestCharAndByteLiterals /
// TestCharAndByteLiteralErrors.
function test_quoted_literals(): i32 {
    if (!check_quoted("'x'", "120", "char")) { return 1950; }
    if (!check_quoted("'['", "91", "char")) { return 1951; }
    if (!check_quoted("'\\n'", "10", "char")) { return 1952; }
    if (!check_quoted("'\\0'", "0", "char")) { return 1953; }
    if (!check_quoted("'\\''", "39", "char")) { return 1954; }
    if (!check_quoted("'\\\\'", "92", "char")) { return 1955; }
    if (!check_quoted("'\\x7F'", "127", "char")) { return 1956; }
    if (!check_quoted("'\\u{41}'", "65", "char")) { return 1957; }
    if (!check_quoted("'\\u{1F600}'", "128512", "char")) { return 1958; }
    if (!check_quoted("'\\u{10FFFF}'", "1114111", "char")) { return 1959; }
    if (!check_quoted("'😀'", "128512", "char")) { return 1960; }
    if (!check_quoted("'é'", "233", "char")) { return 1961; }
    if (!check_quoted("b'x'", "120", "u8")) { return 1962; }
    if (!check_quoted("b'['", "91", "u8")) { return 1963; }
    if (!check_quoted("b'\\n'", "10", "u8")) { return 1964; }
    if (!check_quoted("b'\\xFF'", "255", "u8")) { return 1965; }

    // Rejected at lex time, not left for the parser.
    if (!has_error(tokenize("''"))) { return 1970; }
    if (!has_error(tokenize("b''"))) { return 1971; }
    if (!has_error(tokenize("'ab'"))) { return 1972; }
    if (!has_error(tokenize("b'ab'"))) { return 1973; }
    if (!has_error(tokenize("'a"))) { return 1974; }
    if (!has_error(tokenize("b'é'"))) { return 1975; }
    if (!has_error(tokenize("b'\\u{41}'"))) { return 1976; }
    if (!has_error(tokenize("'\\u{D800}'"))) { return 1977; }
    if (!has_error(tokenize("'\\u{110000}'"))) { return 1978; }
    if (!has_error(tokenize("'\\xFF'"))) { return 1979; }
    if (!has_error(tokenize("'\\q'"))) { return 1980; }
    if (!has_error(tokenize("'\n'"))) { return 1981; }

    // A `b` not followed by `'` is an ordinary identifier.
    var idt: Token[] = tokenize("b bytes");
    match (idt[0]) {
        TokIdent(x) => { if (x.name != "b") { return 1990; } },
        _ => { return 1991; }
    }
    match (idt[1]) {
        TokIdent(x) => { if (x.name != "bytes") { return 1992; } },
        _ => { return 1993; }
    }
    return 0;
}

// check_part — assert one FStringPart matches the expected kind +
// text + position. `want_expr` selects which payload field to compare;
// a literal part carries no position, so both coordinates are 0 there.
function check_part(p: FStringPart, want_expr: boolean, want_text: string, want_line: i32, want_col: i32): boolean {
    if (p.is_expr != want_expr) { return false; }
    if (p.line != want_line || p.col != want_col) { return false; }
    if (want_expr) { return p.expr == want_text; }
    return p.lit == want_text;
}

// test_fstring — the f-string parts split + brace-escape + escape-
// sequence + nested-string handling, plus the four error shapes.
// Mirrors the Go lexer's TestFStringParts / TestFStringErrors.
function test_fstring(): i32 {
    // f"" → no parts.
    var t0: Token[] = tokenize("f\"\"");
    if (t0.len() != 2) { return 2000; }
    match (t0[0]) {
        TokFString(f) => { if (f.parts.len() != 0) { return 2001; } },
        _ => { return 2002; }
    }
    // f"plain" → [Lit "plain"].
    var t1: Token[] = tokenize("f\"plain\"");
    match (t1[0]) {
        TokFString(f) => {
            if (f.parts.len() != 1) { return 2010; }
            if (!check_part(f.parts[0], false, "plain", 0, 0)) { return 2011; }
        },
        _ => { return 2012; }
    }
    // f"a{x}b" → [Lit "a", Expr "x", Lit "b"].
    var t2: Token[] = tokenize("f\"a{x}b\"");
    match (t2[0]) {
        TokFString(f) => {
            if (f.parts.len() != 3) { return 2020; }
            if (!check_part(f.parts[0], false, "a", 0, 0)) { return 2021; }
            if (!check_part(f.parts[1], true, "x", 1, 5)) { return 2022; }
            if (!check_part(f.parts[2], false, "b", 0, 0)) { return 2023; }
        },
        _ => { return 2024; }
    }
    // f"{{lit}}" → [Lit "{lit}"] (brace escapes).
    var t3: Token[] = tokenize("f\"{{lit}}\"");
    match (t3[0]) {
        TokFString(f) => {
            if (f.parts.len() != 1) { return 2030; }
            if (!check_part(f.parts[0], false, "{lit}", 0, 0)) { return 2031; }
        },
        _ => { return 2032; }
    }
    // f"k={"x"}" → [Lit "k=", Expr "\"x\""] (inner string skipped
    // during the brace-matching scan).
    var t4: Token[] = tokenize("f\"k={\"x\"}\"");
    match (t4[0]) {
        TokFString(f) => {
            if (f.parts.len() != 2) { return 2040; }
            if (!check_part(f.parts[0], false, "k=", 0, 0)) { return 2041; }
            if (!check_part(f.parts[1], true, "\"x\"", 1, 6)) { return 2042; }
        },
        _ => { return 2043; }
    }
    // f"sum {a + b}" → [Lit "sum ", Expr "a + b"].
    var t5: Token[] = tokenize("f\"sum {a + b}\"");
    match (t5[0]) {
        TokFString(f) => {
            if (f.parts.len() != 2) { return 2050; }
            if (!check_part(f.parts[0], false, "sum ", 0, 0)) { return 2051; }
            if (!check_part(f.parts[1], true, "a + b", 1, 8)) { return 2052; }
        },
        _ => { return 2053; }
    }
    // f"hi\nthere" → [Lit "hi\nthere"] (escape in literal segment).
    var t6: Token[] = tokenize("f\"hi\\nthere\"");
    match (t6[0]) {
        TokFString(f) => {
            if (f.parts.len() != 1) { return 2060; }
            if (!check_part(f.parts[0], false, "hi\nthere", 0, 0)) { return 2061; }
        },
        _ => { return 2062; }
    }
    // Error shapes: unterminated, newline inside, bare `}`, empty `{}`.
    if (!has_error(tokenize("f\"unterminated"))) { return 2070; }
    if (!has_error(tokenize("f\"with\nnewline\""))) { return 2071; }
    if (!has_error(tokenize("f\"bare}brace\""))) { return 2072; }
    if (!has_error(tokenize("f\"empty{}\""))) { return 2073; }
    return 0;
}

// test_fstring_positions — each interpolant's own offset, and the
// rebase the parser applies to the sub-lex. Two interpolants are the
// discriminating case: rebasing onto the f-string's own start places
// the first plausibly and every later one short (#6989).
function test_fstring_positions(): i32 {
    var t: Token[] = tokenize("var s = f\"a{aaa} b{bbb}\";");
    match (t[3]) {
        TokFString(f) => {
            if (f.parts.len() != 4) { return 2080; }
            if (!check_part(f.parts[1], true, "aaa", 1, 13)) { return 2081; }
            if (!check_part(f.parts[3], true, "bbb", 1, 20)) { return 2082; }
        },
        _ => { return 2083; }
    }
    // An f-string on a later line keeps its own line number.
    match (tokenize("var a = 1;\nvar s = f\"x{yy}\";")[8]) {
        TokFString(f) => {
            if (!check_part(f.parts[1], true, "yy", 2, 13)) { return 2090; }
        },
        _ => { return 2091; }
    }
    // rebase_tokens shifts the column only on the fragment's first
    // line; a later line takes the fragment's own column.
    var sub: Token[] = rebase_tokens(tokenize("a\nb"), 4, 10);
    match (sub[0]) {
        TokIdent(x) => { if (x.line != 4 || x.col != 10) { return 2092; } },
        _ => { return 2093; }
    }
    match (sub[1]) {
        TokIdent(x) => { if (x.line != 5 || x.col != 1) { return 2094; } },
        _ => { return 2095; }
    }
    return 0;
}

// main runs every feature test in sequence and returns the first
// non-zero code. Exit code 0 means the Fern lexer port matches the
// Go lexer across mixed tokens, hex / scientific literals, the
// afterDot chained-tuple guard, suffix validation, and the error
// paths.
// test_comments — the `//` comment list. The fixture pins the three
// properties a doc/format consumer depends on: the text excludes the
// leading `//` and the trailing newline, the position points at the
// `//` itself (so a consumer can tell leading from trailing), and a
// `//` INSIDE a string literal is not a comment. That last one is why
// comments are collected in the lexer rather than by a separate scan.
function check_comment(c: Comment, line: i32, col: i32, text: string): boolean {
    return c.line == line && c.col == col && c.text == text;
}

function test_comments(): i32 {
    var src: string = "// leading\nvar u: string = \"http://x//y\"; // trailing\nvar n: i32 = 1;\n//: last\n";
    var r: LexResult = tokenize_full(src);
    if (r.comments.len() != 3) { return 2100; }
    if (!check_comment(r.comments[0], 1, 1, " leading")) { return 2101; }
    if (!check_comment(r.comments[1], 2, 32, " trailing")) { return 2102; }
    if (!check_comment(r.comments[2], 4, 1, ": last")) { return 2103; }
    // The token stream is unaffected by collecting comments.
    if (r.tokens.len() != tokenize(src).len()) { return 2104; }
    // A source with no comments yields an empty list, not a stray entry.
    if (tokenize_full("var x: i32 = 1;\n").comments.len() != 0) { return 2105; }
    // An unterminated string bails out of the loop early; the comments
    // seen before the failure still come back with the tokens.
    if (tokenize_full("// kept\nvar s: string = \"oops\n").comments.len() != 1) { return 2106; }
    return 0;
}

function main(): i32 {
    var c: i32 = 0;
    c = test_mixed();              if (c != 0) { return c; }
    c = test_hex();                if (c != 0) { return c; }
    c = test_scientific();         if (c != 0) { return c; }
    c = test_bare_e();             if (c != 0) { return c; }
    c = test_chained_tuple();      if (c != 0) { return c; }
    c = test_float_after_nondot(); if (c != 0) { return c; }
    c = test_suffix_errors();      if (c != 0) { return c; }
    c = test_hex_needs_digits();   if (c != 0) { return c; }
    c = test_string_errors();      if (c != 0) { return c; }
    c = test_unknown_char();       if (c != 0) { return c; }
    c = test_quoted_literals();    if (c != 0) { return c; }
    c = test_fstring();            if (c != 0) { return c; }
    c = test_fstring_positions();  if (c != 0) { return c; }
    c = test_comments();           if (c != 0) { return c; }
    return 0;
}
