// examples/self_host/asm_arm64_ir_run.fern — differential driver for the
// arm64 IR code path (the arm64 sibling of asm_ir_run). Like asm_arm64_run,
// but with a `-ir` flag: when set AND the module is fully i32-eligible, it
// emits via the IR path (asm_arm64_ir.emit_module_ir: AST -> stack IR ->
// arm64); otherwise it uses the unchanged AST backend (asm_arm64.emit_module).
// The companion Go test (self_host_asm_ir_arm64_path_test.go) pipes each
// program through both ways, assembles + runs under qemu-aarch64, and asserts
// identical exit codes — proving the arm64 IR path is behaviour-equivalent to
// the production arm64 AST path on the shared subset.
//
// A SEPARATE driver so neither asm_arm64.fern nor the asm_arm64_run bootstrap
// gains an `ir` dependency — they stay untouched until a later fold/flip slice.

import "std/io";
import "./lexer";
import "./parser";
import "./asm_arm64";
import "./asm_arm64_ir";
import "./asm_ir";

function main(): i32 {
    var av: string[] = args();
    var use_ir: boolean = false;
    var ai: i32 = 1;
    while (ai < av.len()) {
        if (av[ai] == "-ir") { use_ir = true; }
        ai = ai + 1;
    }
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    var emitted: string = "";
    if (use_ir && asm_ir.all_eligible(mod)) {
        emitted = asm_arm64_ir.emit_module_ir(mod, false);
    } else {
        emitted = asm_arm64.emit_module(parser.module_with_builtins(mod), false);
    }
    print(emitted);
    return 0;
}
