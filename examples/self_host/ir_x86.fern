// examples/self_host/ir_x86.fern — the first IR-consuming backend (slice 3
// of the IR rebuild, docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md): it emits a
// complete, freestanding x86-64 (AT&T / GAS) program directly from a lowered
// Op[] (irlower.LowerResult), rather than from the AST. This proves the
// stack IR can drive real codegen on x86-64; later slices grow it toward
// parity with asm.fern's AST emit path and then flip the default.
//
// The translation is the natural stack-machine -> machine-stack mapping:
//   - the IR operand stack IS the x86 stack (pushq / popq);
//   - locals live in an rbp frame at -8*(i+1)(%rbp), params in slots
//     0..n_params-1 (the IR drives a `_start` with no args, so for now the
//     i32 subset's `main()` takes none — params are framed for later call
//     lowering);
//   - i32 arithmetic uses the 32-bit subregisters (%eax/%ecx) for faithful
//     i32 semantics, while the operand stack stays 64-bit wide.
//
// SCOPE (slice 3): the straight-line i32 subset irlower lowers — constants,
// local load/store, the binary + unary operators, and `return`. A LowerResult
// with ok=false (out of subset) emits a program that exits 200, matching the
// driver/interpreter bail so the differential harness agrees.

import "./ir";
import "./irlower";
import "./util";

// loc renders the rbp-relative address of local slot i.
function loc(i: i32): string {
    return "-" + util.i32_to_string(8 * (i + 1)) + "(%rbp)";
}

// bin_mid renders the instruction(s) that combine %eax (l) and %ecx (r),
// leaving the result in %eax. Returns "" for an unknown kind (caller treats
// it as a no-op; lowering never emits one).
function bin_mid(kind: string): string {
    if (kind == "add") { return "    addl %ecx, %eax\n"; }
    if (kind == "sub") { return "    subl %ecx, %eax\n"; }
    if (kind == "mul") { return "    imull %ecx, %eax\n"; }
    if (kind == "div_s") { return "    cltd\n    idivl %ecx\n"; }
    if (kind == "rem_s") { return "    cltd\n    idivl %ecx\n    movl %edx, %eax\n"; }
    if (kind == "and") { return "    andl %ecx, %eax\n"; }
    if (kind == "or") { return "    orl %ecx, %eax\n"; }
    if (kind == "xor") { return "    xorl %ecx, %eax\n"; }
    if (kind == "shl") { return "    shll %cl, %eax\n"; }
    if (kind == "shr_s") { return "    sarl %cl, %eax\n"; }
    if (kind == "eq") { return "    cmpl %ecx, %eax\n    sete %al\n    movzbl %al, %eax\n"; }
    if (kind == "ne") { return "    cmpl %ecx, %eax\n    setne %al\n    movzbl %al, %eax\n"; }
    if (kind == "lt_s") { return "    cmpl %ecx, %eax\n    setl %al\n    movzbl %al, %eax\n"; }
    if (kind == "le_s") { return "    cmpl %ecx, %eax\n    setle %al\n    movzbl %al, %eax\n"; }
    if (kind == "gt_s") { return "    cmpl %ecx, %eax\n    setg %al\n    movzbl %al, %eax\n"; }
    if (kind == "ge_s") { return "    cmpl %ecx, %eax\n    setge %al\n    movzbl %al, %eax\n"; }
    return "";
}

// emit_op renders one IR op. Stack discipline: every value-producing op ends
// with the value pushed; consumers pop. `return` pops the result into %eax
// and jumps to the shared exit.
function emit_op(o: ir.Op, exitlabel: string): string {
    if (o.kind == "const_i32") {
        return "    pushq $" + util.i32_to_string(o.i32_imm) + "\n";
    }
    if (o.kind == "const_i32_text") {
        // Integer literal source text spliced into the immediate (hex / full
        // u32 range), like the AST path; the assembler parses base + range.
        return "    pushq $" + o.str + "\n";
    }
    if (o.kind == "load_local") {
        return "    movl " + loc(o.i32_imm) + ", %eax\n    pushq %rax\n";
    }
    if (o.kind == "store_local") {
        return "    popq %rax\n    movl %eax, " + loc(o.i32_imm) + "\n";
    }
    if (o.kind == "not") {
        return "    popq %rax\n    testl %eax, %eax\n    sete %al\n    movzbl %al, %eax\n    pushq %rax\n";
    }
    if (o.kind == "return") {
        return "    popq %rax\n    jmp " + exitlabel + "\n";
    }
    if (o.kind == "alloc") {
        // pop size into the arg register; fn___fern_alloc reuses a same-size
        // freed block or bump-allocates; push the pointer.
        return "    popq %rdi\n    call fn___fern_alloc\n    pushq %rax\n";
    }
    if (o.kind == "store") {
        // pop val, pop addr; *addr = val (i32).
        return "    popq %rcx\n    popq %rax\n    movl %ecx, (%rax)\n";
    }
    if (o.kind == "load") {
        return "    popq %rax\n    movl (%rax), %eax\n    pushq %rax\n";
    }
    if (o.kind == "drop") {
        // discard one operand-stack slot.
        return "    addq $8, %rsp\n";
    }
    if (o.kind == "arr_make") {
        // n element values are on the operand stack (element n-1 on top).
        // 4-byte layout: alloc (n+2) words, base = rawptr+4 (points at len),
        // rc=1 at base-4, len=n at base, element i at base+4+i*4. Pop the
        // elements top-down (slot n-1 .. slot 0); base stays live in %rax
        // (the pops only touch the operand stack), then push base.
        var n: i32 = o.i32_imm;
        var out: string = "    movq $" + util.i32_to_string((n + 2) * 4) + ", %rdi\n";
        out = out + "    call fn___fern_alloc\n    addq $4, %rax\n";
        out = out + "    movl $1, -4(%rax)\n";
        out = out + "    movl $" + util.i32_to_string(n) + ", (%rax)\n";
        var i: i32 = n - 1;
        while (i >= 0) {
            out = out + "    popq %rcx\n    movl %ecx, " + util.i32_to_string(4 + i * 4) + "(%rax)\n";
            i = i - 1;
        }
        return out + "    pushq %rax\n";
    }
    if (o.kind == "arr_get") {
        // pop idx (top) + base; load element at base+4+idx*4.
        return "    popq %rcx\n    popq %rax\n    movl 4(%rax,%rcx,4), %eax\n    pushq %rax\n";
    }
    if (o.kind == "arr_set") {
        // pop val (top), idx, base; store at base+4+idx*4.
        return "    popq %rdx\n    popq %rcx\n    popq %rax\n    movl %edx, 4(%rax,%rcx,4)\n";
    }
    if (o.kind == "arr_len") {
        // pop base; load the length header at base.
        return "    popq %rax\n    movl (%rax), %eax\n    pushq %rax\n";
    }
    if (o.kind == "arr_rc") {
        // pop base; load the refcount header at base-4.
        return "    popq %rax\n    movl -4(%rax), %eax\n    pushq %rax\n";
    }
    if (o.kind == "int_cast") {
        // `x as <ty>` int->int width mask/extend, AND the wrap irlower emits
        // after a default-i32 / sub-word `+`/`-`/`*`/`<<` to keep the result in
        // its declared width (e.g. `2147483647 + 1 == -2147483648`). A single
        // operand in, one out — NOT a binary op. Byte-identical to asm_ir.fern.
        // Without this case the op fell through to the binary-op default below
        // (pop two, push one), corrupting the operand stack on every i32 add /
        // sub / mul / shl (e.g. `2 + 3 * 4` -> 5 instead of 14).
        var c: string = "    popq %rax\n";
        if (o.str == "u8") { c = c + "    andq $255, %rax\n"; }
        else if (o.str == "u32") { c = c + "    movl %eax, %eax\n"; }
        else if (o.str == "i32") { c = c + "    movslq %eax, %rax\n"; }
        return c + "    pushq %rax\n";
    }
    if (o.kind == "u32_wrap") {
        // Reduce a u32 arithmetic result to the u32 range (zero-extend low 32),
        // wrapping at 2^32 on this 64-bit-register backend. One operand in/out.
        return "    popq %rax\n    movl %eax, %eax\n    pushq %rax\n";
    }
    // otherwise a binary op: pop r into %ecx, l into %eax, combine, push.
    return "    popq %rcx\n    popq %rax\n" + bin_mid(o.kind) + "    pushq %rax\n";
}

// arg_reg returns the 64-bit SysV integer argument register for arg index i
// (0..5). Our emitted code uses only integer instructions, so the 16-byte
// stack-alignment ABI contract is not required for correctness — a call is
// just pop-args-to-registers + `call`.
function arg_reg(i: i32): string {
    if (i == 0) { return "%rdi"; }
    if (i == 1) { return "%rsi"; }
    if (i == 2) { return "%rdx"; }
    if (i == 3) { return "%rcx"; }
    if (i == 4) { return "%r8"; }
    return "%r9";
}

// arg_reg32 is the 32-bit subregister, for storing an i32 param into its slot.
function arg_reg32(i: i32): string {
    if (i == 0) { return "%edi"; }
    if (i == 1) { return "%esi"; }
    if (i == 2) { return "%edx"; }
    if (i == 3) { return "%ecx"; }
    if (i == 4) { return "%r8d"; }
    return "%r9d";
}

// EmitX86 threads the output plus a scope stack for structured control
// flow: each open `if` records its else / end labels and whether an `else`
// was seen. The stack is depth-indexed and grown-then-overwritten (the
// self-host has no pop-by-slice that preserves the array type), which is
// sound because if/else/end are strictly nested and processed in order, so
// index `depth` is always rewritten on push before being read.
struct EmitX86 {
    out: string,
    nlabel: i32,
    depth: i32,
    s_else: string[],
    s_end: string[],
    s_haselse: i32[],
    s_kind: string[],
    s_brtarget: string[],
}

function ensure_str(a: string[], n: i32): string[] {
    var r: string[] = a;
    while (r.len() < n) { r = r.append(""); }
    return r;
}

function ensure_i32(a: i32[], n: i32): i32[] {
    var r: i32[] = a;
    while (r.len() < n) { r = r.append(0); }
    return r;
}

// emit_body_x86 lowers an op stream (including structured control flow) to
// x86-64. Non-control-flow ops defer to emit_op; if/else/end manage labels.
// push_scope grows the depth-indexed scope arrays and records one scope.
function (e: EmitX86) push_scope(kind: string, le: string, lend: string, brtarget: string): EmitX86 {
    var d: i32 = e.depth;
    var se: string[] = ensure_str(e.s_else, d + 1).with(d, le);
    var sn: string[] = ensure_str(e.s_end, d + 1).with(d, lend);
    var sh: i32[] = ensure_i32(e.s_haselse, d + 1).with(d, 0);
    var sk: string[] = ensure_str(e.s_kind, d + 1).with(d, kind);
    var sb: string[] = ensure_str(e.s_brtarget, d + 1).with(d, brtarget);
    return EmitX86 { out: e.out, nlabel: e.nlabel + 1, depth: d + 1, s_else: se, s_end: sn, s_haselse: sh, s_kind: sk, s_brtarget: sb };
}

// with_out returns e with text appended (the other fields unchanged).
function (e: EmitX86) with_out(s: string): EmitX86 {
    return EmitX86 { out: e.out + s, nlabel: e.nlabel, depth: e.depth, s_else: e.s_else, s_end: e.s_end, s_haselse: e.s_haselse, s_kind: e.s_kind, s_brtarget: e.s_brtarget };
}

function emit_body_x86(ops: ir.Op[], fname: string, exitlabel: string): string {
    // Labels are function-prefixed so they stay unique across the module.
    var lp: string = ".L" + fname + "_";
    var e: EmitX86 = EmitX86 { out: "", nlabel: 0, depth: 0, s_else: [], s_end: [], s_haselse: [], s_kind: [], s_brtarget: [] };
    var i: i32 = 0;
    while (i < ops.len()) {
        var o: ir.Op = ops[i];
        if (o.kind == "if") {
            var le: string = lp + "else_" + util.i32_to_string(e.nlabel);
            var lend: string = lp + "end_" + util.i32_to_string(e.nlabel);
            // pop cond, branch to the else/end label when false. A `br` to an
            // if targets its end label.
            var e1: EmitX86 = e.with_out("    popq %rax\n    testl %eax, %eax\n    jz " + le + "\n");
            e = e1.push_scope("if", le, lend, lend);
        }
        else if (o.kind == "block") {
            // forward scope; `br` to it exits to its end label (emitted at end).
            var lb: string = lp + "blk_" + util.i32_to_string(e.nlabel);
            e = e.push_scope("block", lb, lb, lb);
        }
        else if (o.kind == "loop") {
            // backward scope; `br` to it jumps to its header label, emitted here.
            var ll: string = lp + "loop_" + util.i32_to_string(e.nlabel);
            var e2: EmitX86 = e.with_out(ll + ":\n");
            e = e2.push_scope("loop", ll, ll, ll);
        }
        else if (o.kind == "br") {
            var tgt: string = e.s_brtarget[e.depth - 1 - o.i32_imm];
            e = e.with_out("    jmp " + tgt + "\n");
        }
        else if (o.kind == "brif") {
            // pop cond, branch when nonzero.
            var tgt2: string = e.s_brtarget[e.depth - 1 - o.i32_imm];
            e = e.with_out("    popq %rax\n    testl %eax, %eax\n    jnz " + tgt2 + "\n");
        }
        else if (o.kind == "else") {
            var d: i32 = e.depth - 1;
            // end of the then-branch: jump past the else, then land the
            // false-path here.
            var e3: EmitX86 = e.with_out("    jmp " + e.s_end[d] + "\n" + e.s_else[d] + ":\n");
            e = EmitX86 { out: e3.out, nlabel: e3.nlabel, depth: e3.depth, s_else: e3.s_else, s_end: e3.s_end, s_haselse: e3.s_haselse.with(d, 1), s_kind: e3.s_kind, s_brtarget: e3.s_brtarget };
        }
        else if (o.kind == "end") {
            var d2: i32 = e.depth - 1;
            var kind: string = e.s_kind[d2];
            var tail: string = "";
            if (kind == "if") {
                // with an else, the false path already landed at the else
                // label, so close with the end label; without one, the if's jz
                // target IS the end, so emit the else label here.
                if (e.s_haselse[d2] == 1) { tail = e.s_end[d2] + ":\n"; }
                else { tail = e.s_else[d2] + ":\n"; }
            }
            else if (kind == "block") {
                // the block's exit label (br/br_if jumped here).
                tail = e.s_brtarget[d2] + ":\n";
            }
            // a loop's label was emitted at its head -> nothing to close here.
            e = EmitX86 { out: e.out + tail, nlabel: e.nlabel, depth: d2, s_else: e.s_else, s_end: e.s_end, s_haselse: e.s_haselse, s_kind: e.s_kind, s_brtarget: e.s_brtarget };
        }
        else if (o.kind == "call_direct") {
            // args are on the operand stack (arg0..arg n-1, n-1 on top): pop
            // each into its SysV register (highest index first), call, push
            // the result. No stack alignment needed (integer-only callees).
            var argc: i32 = o.i32_imm;
            var seq: string = "";
            var k: i32 = argc - 1;
            while (k >= 0) { seq = seq + "    popq " + arg_reg(k) + "\n"; k = k - 1; }
            seq = seq + "    call fn_" + o.str + "\n    pushq %rax\n";
            e = e.with_out(seq);
        }
        else {
            e = e.with_out(emit_op(o, exitlabel));
        }
        i = i + 1;
    }
    return e.out;
}

// emit_exit renders a minimal freestanding program that exits with `code`.
function emit_exit(code: i32): string {
    var out: string = ".text\n.globl _start\n_start:\n";
    out = out + "    movq $" + util.i32_to_string(code) + ", %rdi\n";
    out = out + "    movq $60, %rax\n    syscall\n";
    return out;
}

// emit_function renders one function: prologue, params copied from their
// SysV registers into local slots, body, then a single exit label +
// epilogue (the `return` op jumps to the exit with the value in %eax).
function emit_function(fn: irlower.LoweredFn): string {
    var frame: i32 = fn.n_locals * 8;
    if (frame - (frame / 16) * 16 != 0) { frame = frame + 8; }
    var exitlabel: string = ".L" + fn.name + "_ret";

    var out: string = "fn_" + fn.name + ":\n";
    out = out + "    pushq %rbp\n    movq %rsp, %rbp\n";
    if (frame > 0) { out = out + "    subq $" + util.i32_to_string(frame) + ", %rsp\n"; }
    var p: i32 = 0;
    while (p < fn.n_params) {
        out = out + "    movl " + arg_reg32(p) + ", " + loc(p) + "\n";
        p = p + 1;
    }
    // Zero the array slots so the exit dec-sweep never decs an uninitialised
    // (declared-in-an-untaken-branch) slot — __fern_rc_dec null-guards 0.
    var z: i32 = 0;
    while (z < fn.arr_slots.len()) {
        out = out + "    movq $0, " + loc(fn.arr_slots[z]) + "\n";
        z = z + 1;
    }
    out = out + emit_body_x86(fn.ops, fn.name, exitlabel);
    out = out + exitlabel + ":\n";
    out = out + "    movq %rbp, %rsp\n    popq %rbp\n    ret\n";
    return out;
}

// emit_module renders the whole freestanding program: `_start` calls main
// and exits with its result, followed by every (lowered) function. A main
// that is out of subset (ok=false) exits 200, matching the interpreter.
pub function emit_module(fns: irlower.LoweredFn[]): string {
    var mi: i32 = irlower.find_fn(fns, "main");
    if (mi < 0) { return emit_exit(201); }
    if (!fns[mi].ok) { return emit_exit(200); }

    var out: string = ".text\n.globl _start\n_start:\n";
    out = out + "    call fn_main\n    movq %rax, %rdi\n    movq $60, %rax\n    syscall\n";
    var i: i32 = 0;
    while (i < fns.len()) {
        if (fns[i].ok) { out = out + emit_function(fns[i]); }
        i = i + 1;
    }
    // RC retain helper (the `call_direct __fern_rc_inc` target): inc the
    // refcount header at [ptr-4], return ptr. (Counting only — no free yet.)
    out = out + "fn___fern_rc_inc:\n";
    out = out + "    movl -4(%rdi), %eax\n    addl $1, %eax\n    movl %eax, -4(%rdi)\n    movq %rdi, %rax\n    ret\n";
    // RC release helper: dec [ptr-4]. An over-release (rc already <= 0) bumps
    // __fern_rc_underflow. At rc==0 the raw block (ptr-4) is returned to its
    // size-class freelist (size = (len+2)*4 from the length header). Null /
    // sub-heap pointers are skipped. Pointers are 32-bit values (static
    // -no-pie heap < 4 GiB) held in 64-bit regs for addressing.
    out = out + "fn___fern_rc_dec:\n";
    out = out + "    cmpq $8, %rdi\n    jb .Ldec_skip\n";
    out = out + "    movl -4(%rdi), %eax\n    cmpl $0, %eax\n    jg .Ldec_do\n";
    out = out + "    movl __fern_rc_underflow, %ecx\n    addl $1, %ecx\n    movl %ecx, __fern_rc_underflow\n    jmp .Ldec_skip\n";
    out = out + ".Ldec_do:\n    subl $1, %eax\n    movl %eax, -4(%rdi)\n    testl %eax, %eax\n    jnz .Ldec_skip\n";
    // rc hit 0 -> free: rawblock = rdi-4; size = (len+2)*4; push onto freelist.
    out = out + "    leaq -4(%rdi), %rdx\n    movl (%rdi), %ecx\n    addl $2, %ecx\n    shll $2, %ecx\n";
    out = out + "    movl __freelist, %eax\n    movl %eax, (%rdx)\n    movl %ecx, 4(%rdx)\n    movl %edx, __freelist\n";
    out = out + ".Ldec_skip:\n    movq %rdi, %rax\n    ret\n";
    // RC over-release counter reader (the `__rc_underflow()` hook).
    out = out + "fn___fern_rc_underflow_get:\n    movl __fern_rc_underflow, %eax\n    ret\n";
    // Bytes bump-allocated so far = __heap_ptr - __heap (the `__heap_used()`
    // hook; freelist reuse does not bump, so this measures peak growth).
    out = out + "fn___fern_heap_used:\n    movl __heap_ptr, %eax\n    subl $__heap, %eax\n    ret\n";
    // Allocator: reuse a freed block of the exact requested size (a free node
    // stores [next@0, size@4]), else bump. edi = size -> rax = raw block.
    out = out + "fn___fern_alloc:\n";
    out = out + "    movl __freelist, %eax\n    xorl %edx, %edx\n";
    out = out + ".Lal_scan:\n    testl %eax, %eax\n    jz .Lal_bump\n";
    out = out + "    movl 4(%rax), %ecx\n    cmpl %edi, %ecx\n    je .Lal_found\n";
    out = out + "    movl %eax, %edx\n    movl (%rax), %eax\n    jmp .Lal_scan\n";
    out = out + ".Lal_found:\n    movl (%rax), %ecx\n    testl %edx, %edx\n    jz .Lal_head\n";
    out = out + "    movl %ecx, (%rdx)\n    ret\n";
    out = out + ".Lal_head:\n    movl %ecx, __freelist\n    ret\n";
    out = out + ".Lal_bump:\n    movl __heap_ptr, %eax\n    movl %eax, %ecx\n    addl %edi, %ecx\n    movl %ecx, __heap_ptr\n    ret\n";
    // Freelist allocator state: a 1 MiB .bss heap, a 32-bit bump pointer, the
    // freelist head, and the RC over-release counter.
    out = out + ".data\n__heap_ptr: .long __heap\n__freelist: .long 0\n__fern_rc_underflow: .long 0\n.bss\n__heap: .skip 1048576\n";
    return out;
}
