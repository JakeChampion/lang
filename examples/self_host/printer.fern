// examples/self_host/printer.fern — fifth concrete step of the
// self-host port. Walks a parser.Module and produces a textual
// rendering of it: a tree-to-source emitter that round-trips
// through the lexer + parser.
//
// Same shape as the checker (#619) and interp (#623): a
// recursive walk over ast.Expr / ast.Stmt with one match
// arm per variant. Output isn't strictly pretty — no alignment,
// no comment-preserving — but it produces re-parseable text for
// every shape the parser handles today.
//
// The .fern file's main() prints a non-trivial program, re-
// parses the result, and asserts the round-trip preserved the
// AST shape. Exit code 0 means every assertion passed; non-
// zero codes identify which arm failed.

import "./ast";
import "./lexer";
import "./parser";
import "./util";
import "core/map";

// =================== EXPRESSIONS ====================

// hex_digit is one lowercase hex digit as its ASCII byte.
function hex_digit(d: i32): u8 {
    if (d < 10) { return (48 + d) as u8; }
    return (87 + d) as u8;
}

// append_hex_escape writes `\xNN` for one byte. A control byte stays an escape
// so the formatted source stays text — a raw NUL makes git read the file as
// binary — and scan_string's `\xNN` reads the same byte back.
function append_hex_escape(out: u8[], b: i32): u8[] {
    var a: u8[] = out;
    a = a.append(92 as u8);
    a = a.append(120 as u8);
    a = a.append(hex_digit(b / 16));
    a = a.append(hex_digit(b % 16));
    return a;
}

// is_control_byte: the bytes native's printer re-escapes rather than emit raw.
function is_control_byte(b: i32): boolean {
    return b < 32 || b == 127;
}

// quote_string wraps a string value in `"`-delimited form, with
// the same escape set scan_string in the lexer recognises (so
// the result re-parses). The Fern strings here don't carry the
// surrounding `"`s — they store decoded bytes — so we re-encode
// on emit.
function quote_string(s: string): string {
    // Byte-level rebuild: the escapes are ASCII and every other byte
    // (multibyte sequences included) passes through byte-exact.
    var out: u8[] = [];
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i] as i32;
        if (b == 34) { out = out.append(92 as u8); out = out.append(34 as u8); }        // \"
        else if (b == 92) { out = out.append(92 as u8); out = out.append(92 as u8); }   // \\
        else if (b == 10) { out = out.append(92 as u8); out = out.append(110 as u8); }  // \n
        else if (b == 9) { out = out.append(92 as u8); out = out.append(116 as u8); }   // \t
        else if (b == 13) { out = out.append(92 as u8); out = out.append(114 as u8); }  // \r
        else if (is_control_byte(b)) { out = append_hex_escape(out, b); }
        else { out = out.append(s[i]); }
        i = i + 1;
    }
    return "\"" + string_from_bytes_unchecked(out) + "\"";
}

// escape_fstring_lit re-escapes an f-string's literal segment: the plain string
// rules plus `{` / `}` doubled, so the body re-lexes into the same parts.
function escape_fstring_lit(s: string): string {
    // Same byte-level rebuild as quote_string, plus the doubled braces.
    var out: u8[] = [];
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i] as i32;
        if (b == 34) { out = out.append(92 as u8); out = out.append(34 as u8); }         // \"
        else if (b == 92) { out = out.append(92 as u8); out = out.append(92 as u8); }    // \\
        else if (b == 10) { out = out.append(92 as u8); out = out.append(110 as u8); }   // \n
        else if (b == 9) { out = out.append(92 as u8); out = out.append(116 as u8); }    // \t
        else if (b == 13) { out = out.append(92 as u8); out = out.append(114 as u8); }   // \r
        else if (b == 123) { out = out.append(123 as u8); out = out.append(123 as u8); } // {{
        else if (b == 125) { out = out.append(125 as u8); out = out.append(125 as u8); } // }}
        else if (is_control_byte(b)) { out = append_hex_escape(out, b); }
        else { out = out.append(s[i]); }
        i = i + 1;
    }
    return string_from_bytes_unchecked(out);
}

// =================== PRECEDENCE ====================
//
// Levels mirror the parser's, and native's printer's: higher binds tighter, and
// an operand is parenthesised only where its own operator binds less tightly
// than the context around it. The two tables must agree or the two formatters
// disagree about the canonical form of every expression (#6762).
//
// Bitwise (`|`, `^`, `&`) sits BELOW the comparison family, matching the
// grammar (parse_logical_and → parse_bit_or → parse_bit_xor → parse_bit_and →
// parse_equality → parse_relational), so `==` binds tighter than `&`. Ordering
// these the other way silently rewrites `(n & (n - 1)) == 0` — the
// is-power-of-2 idiom — into `n & n - 1 == 0`, which re-parses as ANDing a
// number with a boolean.
function prec_lowest(): i32 { return 0; }
function prec_assign(): i32 { return 1; }
function prec_cast(): i32 { return 14; }
function prec_unary(): i32 { return 15; }
function prec_primary(): i32 { return 16; }

// binary_prec is the level of `op`; an operator the table does not know sits at
// the lowest level, so it keeps its parens.
function binary_prec(op: string): i32 {
    // `|>` is the loosest operator in the grammar (parse_pipe wraps parse_range
    // wraps parse_binary), and only a `-fmt` parse produces one — the compile
    // parse desugars a pipe into the call it means.
    if (op == "|>") { return 2; }
    if (op == "||") { return 4; }
    if (op == "&&") { return 5; }
    if (op == "|") { return 6; }
    if (op == "^") { return 7; }
    if (op == "&") { return 8; }
    if (op == "==" || op == "!=") { return 9; }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") { return 10; }
    if (op == "<<" || op == ">>" || op == "<<|" || op == "<<?" || op == ">>?") { return 11; }
    if (op == "+" || op == "-" || op == "+|" || op == "-|" || op == "+?" || op == "-?") { return 12; }
    if (op == "*" || op == "/" || op == "%" || op == "*|" || op == "*?" || op == "/?" || op == "%?") { return 13; }
    return prec_lowest();
}

// print_expr emits an expression at the outermost level, where nothing around
// it can require parens. `depth` is the nesting level of the statement the
// expression sits in: an expression is normally one line, but a braced arrow
// lambda body is a block inside an expression and indents against that
// statement.
function print_expr(e: ast.Expr, depth: i32): string {
    return print_expr_prec(e, prec_lowest(), depth);
}

// print_lit prints a pattern literal, which has no body to indent.
function print_lit(e: ast.Expr): string {
    return print_expr(e, 0);
}

// arrow_return_type renders an arrow lambda's return annotation. The lambda's
// own `=>` follows it, so the type parser reserves the top-level function-type
// arrow there: a function-typed return needs its grouping parens back, or
// `(p: i32): (i32) => (i32, i32) => …` re-parses with the wrong split.
function arrow_return_type(ret: string): string {
    if (parser.top_arrow_at(ret) >= 0) { return "(" + ret + ")"; }
    return ret;
}

// print_lambda_params renders a lambda's `(p: T, …)` list — shared by the
// arrow lambda and the nested `function` declaration it desugars from.
function print_lambda_params(lm: ast.ExprLambda): string {
    var (pats, _) = param_patterns_for(lm.params, lm.body);
    return print_params_with(lm.params, pats);
}

// print_params_with renders a parameter list, spelling a destructuring
// parameter as the pattern it was written with rather than the holder the
// desugar minted (#7338).
function print_params_with(params: ast.ParamDecl[], pats: string[]): string {
    var out: string = "(";
    var pi: i32 = 0;
    while (pi < params.len()) {
        if (pi > 0) { out = out + ", "; }
        if (pi < pats.len() && pats[pi].len() > 0) {
            out = out + pats[pi];
        } else {
            out = out + params[pi].name;
        }
        if (params[pi].type_name.len() > 0) {
            out = out + ": " + params[pi].type_name;
        }
        pi = pi + 1;
    }
    return out + ")";
}

// drop_prelude returns body with its first `n` statements removed — the `let`s
// the parameter desugar minted, now spelled in the parameter list.
function drop_prelude(body: ast.Stmt[], n: i32): ast.Stmt[] {
    if (n <= 0) { return body; }
    var out: ast.Stmt[] = [];
    var i: i32 = n;
    while (i < body.len()) { out = out.append(body[i]); i = i + 1; }
    return out;
}

// print_return_only prints the expression of a body that is exactly one
// `return <expr>;`, and "" for any other body — the shape a value-position
// branch has once the if / match-expression desugar has rewritten it. A real
// expression never prints empty, so "" is unambiguous.
function print_return_only(body: ast.Stmt[], depth: i32): string {
    if (body.len() != 1) { return ""; }
    match (body[0]) {
        ast.StmtReturn(r) => {
            if (expr_is_missing(r.value) || as_use(r.value).ok) { return ""; }
            return print_expr(r.value, depth);
        },
        _ => { return ""; }
    }
    return "";
}

// print_block_expr renders a value-position `{ stmt; …; tail }` from the tagged
// 0-arg IIFE parse_primary desugars it to, and "" when `c` is any other call.
//
// The desugar ends the body with `return <tail>`, so the tail is that return's
// expression and the leading statements print inline. A block with no leading
// statements is just its tail — braces there would be noise, and native drops
// them too, so the tail carries the caller's precedence.
function print_block_expr(c: ast.ExprCall, parent_prec: i32, depth: i32): string {
    if (c.args.len() != 0) { return ""; }
    match (c.callee) {
        ast.ExprLambda(lm) => {
            if (lm.origin != parser.ORIGIN_BLOCK || lm.body.len() == 0) { return ""; }
            var last: ast.Stmt = lm.body[lm.body.len() - 1];
            var tail: string = print_return_only([last], depth);
            if (tail.len() == 0) { return ""; }
            if (lm.body.len() == 1) { return print_expr_prec(tail_expr(last), parent_prec, depth); }
            // The leading statements sit at depth 0, as native's
            // formatBlockExpr renders them; only the tail keeps the depth.
            var out: string = "{ ";
            var i: i32 = 0;
            while (i + 1 < lm.body.len()) {
                out = out + print_stmt_inline(lm.body[i], 0) + " ";
                i = i + 1;
            }
            return out + tail + " }";
        },
        _ => { return ""; }
    }
    return "";
}

// tail_expr is the expression of a `return <expr>;` statement.
function tail_expr(st: ast.Stmt): ast.Expr {
    match (st) {
        ast.StmtReturn(r) => { return r.value; },
        _ => { return parser.e_unknown("block tail"); },
    }
}

// print_expr_iife renders the WRITTEN form of a match- or if-expression from
// the 0-argument IIFE parse_primary desugars it to, or "" when the call is an
// ordinary one.
//
// The shape is the marker: a 0-arg call of a 0-parameter lambda whose whole
// body is one match / if, every branch of which is a single `return`. A
// hand-written IIFE of that exact shape reprints as the expression form, which
// is the same program — the desugar is what the two spellings share.
//
// The tuple- and struct-pattern desugars carry their value in a local instead
// (IfChain.value_local), so their bodies are three statements and fall through
// to the ordinary call rendering.
// iife_value_local names the local a value-producing chain assigns, when the
// first and last statements of an IIFE body are its declaration and its
// return. "" when the body is any other shape.
function iife_value_local(first: ast.Stmt, last: ast.Stmt): string {
    var name: string = "";
    match (first) {
        ast.StmtVar(v) => { name = v.name; },
        _ => { return ""; }
    }
    if (name.len() == 0) { return ""; }
    match (last) {
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprIdent(id) => { if (id.name == name) { return name; } },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

function print_expr_iife(c: ast.ExprCall, depth: i32): string {
    if (c.args.len() != 0) { return ""; }
    match (c.callee) {
        ast.ExprLambda(lm) => {
            if (lm.params.len() != 0) { return ""; }
            // The VALUE-LOCAL shape: a chain cannot `return` an arm's value the
            // way a match arm does, so the desugar declares a local, lets the
            // chain assign it, and returns it — three statements, not one.
            // `arm_expr_value` reads each arm's body back through that local.
            if (lm.body.len() == 3) {
                var vl: string = iife_value_local(lm.body[0], lm.body[2]);
                if (vl.len() > 0) {
                    match (lm.body[1]) {
                        // "" not `vl`: the carrier holds the arms as WRITTEN,
                        // whose bodies still `return` their value — only the
                        // LOWERED arms were rewritten to assign the local.
                        ast.StmtIf(vf) => { return print_sugared_match_expr(vf.sugar, "", depth); },
                        _ => { return ""; }
                    }
                }
                return "";
            }
            if (lm.body.len() != 1) { return ""; }
            match (lm.body[0]) {
                ast.StmtMatch(m) => {
                    // The WRITTEN arms when the parse consumed something into
                    // the lowering (a nested or literal payload) — otherwise a
                    // `match (o) { A(Ok2(n)) => n, … }` reprints as the merged
                    // arm and its inner match, wrapped back up in the IIFE.
                    var marms: ast.MatchArm[] = m.arms;
                    if (m.sugar.len() > 0) { marms = m.sugar; }
                    if (marms.len() == 0) { return ""; }
                    var out: string = "match (" + print_expr(m.scrutinee, depth) + ") { ";
                    var i: i32 = 0;
                    while (i < marms.len()) {
                        var av: string = print_return_only(marms[i].body, depth);
                        if (av.len() == 0) { return ""; }
                        if (i > 0) { out = out + ", "; }
                        var head: string = print_pattern(marms[i].pattern);
                        var guarded: ast.MatchArm = marms[i];
                        // See print_match: or-pattern alternatives rejoin here.
                        while (i + 1 < marms.len() && marms[i + 1].alt_cont) {
                            i = i + 1;
                            head = head + " | " + print_pattern(marms[i].pattern);
                        }
                        out = out + head;
                        if (guarded.has_guard) { out = out + " when " + print_expr(guarded.guard, depth); }
                        out = out + " => " + av;
                        i = i + 1;
                    }
                    return out + " }";
                },
                ast.StmtIf(f) => {
                    // A literal-scrutinee match in expression position is an
                    // if/else-if chain inside the IIFE; the carrier on its
                    // outermost `if` holds the arms as written.
                    if (f.sugar.lits.len() > 0) { return print_sugared_match_expr(f.sugar, "", depth); }
                    var tv: string = print_return_only(f.then_body, depth);
                    if (tv.len() == 0) { return ""; }
                    var ev: string = print_return_only(f.else_body, depth);
                    if (ev.len() == 0) { return ""; }
                    return "if (" + print_expr(f.cond, depth) + ") { " + tv + " } else { " + ev + " }";
                },
                _ => { return ""; }
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// print_value_local_iife renders the WRITTEN form of an expression-position
// match whose desugar stores arm values in a local — a tuple or struct
// scrutinee, or a variant match with a tuple sub-pattern — and "" for any other
// call. Without it `-fmt` emitted the whole IIFE, writing the synthesised
// `__tm<l>_<c>_r` into the user's source (#7089).
//
// parse_primary builds exactly `{ var V = <zero>; <the desugared match>; return V }`
// (IfChain.value_local), so the shape is the marker, and the match inside it
// already reprints correctly — this only has to unwrap it and put the arm
// values back where the `return`s were.
function print_value_local_iife(c: ast.ExprCall, depth: i32): string {
    if (c.args.len() != 0) { return ""; }
    match (c.callee) {
        ast.ExprLambda(lm) => {
            if (lm.params.len() != 0 || lm.body.len() != 3) { return ""; }
            var v: string = value_local_name(lm.body[0], lm.body[2]);
            if (v.len() == 0) { return ""; }
            match (lm.body[1]) {
                ast.StmtIf(ifs) => { return print_sugared_match_expr(ifs.sugar, v, depth); },
                ast.StmtMatch(m) => { return print_match_expr_arms(m, v, depth); },
                _ => { return ""; }
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// value_local_name is the local an IIFE body declares first and returns last,
// or "" when `first` / `last` are not that pair.
function value_local_name(first: ast.Stmt, last: ast.Stmt): string {
    var declared: string = "";
    match (first) {
        ast.StmtVar(vd) => { declared = vd.name; },
        _ => { return ""; },
    }
    if (declared.len() == 0) { return ""; }
    match (last) {
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprIdent(id) => {
                    if (id.name == declared) { return declared; }
                    return "";
                },
                _ => { return ""; },
            }
        },
        _ => { return ""; },
    }
    return "";
}

// print_match_expr_arms is print_sugared_match_expr for a match the desugar
// left as a StmtMatch — a variant match with a tuple sub-pattern, whose arms
// are ordinary MatchArms rather than a carrier's.
function print_match_expr_arms(m: ast.StmtMatch, v: string, depth: i32): string {
    // The WRITTEN arms are snapshotted BEFORE value_arm_body rewrites the
    // terminal `return E` into `V = E`, so they still carry the return and the
    // value local does not apply to them.
    var arms: ast.MatchArm[] = m.arms;
    var val: string = v;
    if (m.sugar.len() > 0) { arms = m.sugar; val = ""; }
    if (arms.len() == 0) { return ""; }
    var out: string = "match (" + print_expr(m.scrutinee, depth) + ") { ";
    var i: i32 = 0;
    while (i < arms.len()) {
        var av: string = arm_expr_value(arms[i].body, val, depth);
        if (av.len() == 0) { return ""; }
        if (i > 0) { out = out + ", "; }
        var head: string = print_pattern(arms[i].pattern);
        var guarded: ast.MatchArm = arms[i];
        while (i + 1 < arms.len() && arms[i + 1].alt_cont) {
            i = i + 1;
            head = head + " | " + print_pattern(arms[i].pattern);
        }
        out = out + head;
        if (guarded.has_guard) { out = out + " when " + print_expr(guarded.guard, depth); }
        out = out + " => " + av;
        i = i + 1;
    }
    return out + " }";
}

// print_sugared_match_expr renders a carrier's match in EXPRESSION form — one
// line, arm bodies unbraced — or "" when an arm has no recoverable value.
//
// `v` names the local the desugar stores arm values into (IfChain.value_local),
// or is "" when the arms kept their `return`. See arm_expr_value.
function print_sugared_match_expr(sg: ast.MatchSugar, v: string, depth: i32): string {
    var arms: WrittenArm[] = sugar_written_arms(sg);
    if (arms.len() == 0) { return ""; }
    var out: string = "match (" + print_expr(sg.scrut, depth) + ") { ";
    var i: i32 = 0;
    while (i < arms.len()) {
        var av: string = arm_expr_value(arms[i].body, v, depth);
        if (av.len() == 0) { return ""; }
        if (i > 0) { out = out + ", "; }
        out = out + arms[i].head;
        if (arms[i].has_guard) { out = out + " when " + print_expr(arms[i].guard, depth); }
        out = out + " => " + av;
        i = i + 1;
    }
    return out + " }";
}

// arm_expr_value recovers an expression-form arm's value from its lowered body.
// The literal chain leaves the arm's `return E` in place; the tuple and struct
// desugars turn it into `V = E`, so `v` names that local and is "" for the
// return form. Statements ahead of the terminal one become the block-expression
// spelling `{ stmts; E }`.
//
// "" when the body has no terminal value at all — a divergent arm, which
// value_arm_body deliberately leaves alone.
function arm_expr_value(body: ast.Stmt[], v: string, depth: i32): string {
    if (body.len() == 0) { return ""; }
    var last: ast.Stmt = body[body.len() - 1];
    var tail: string = "";
    if (v.len() == 0) {
        tail = print_return_only([last], depth);
    } else {
        if (assign_target(last) != v) { return ""; }
        tail = print_expr(assign_value(last), depth);
    }
    if (tail.len() == 0) { return ""; }
    if (body.len() == 1) { return tail; }
    // Depth 0 for the leading statements, as in print_block_expr.
    var out: string = "{ ";
    var i: i32 = 0;
    while (i + 1 < body.len()) { out = out + print_stmt_inline(body[i], 0) + " "; i = i + 1; }
    return out + tail + " }";
}

// print_expr_prec emits `e` inside a context binding at `parent_prec`, adding
// parentheses only where dropping them would reassociate. A left-associative
// operator passes its own level to its LEFT operand and one above it to the
// right, which is what keeps `a - (b - c)` parenthesised and `(a - b) - c`
// bare.
function print_expr_prec(e: ast.Expr, parent_prec: i32, depth: i32): string {
    match (e) {
        ast.ExprNumber(n) => {
            // A quoted literal prints its spelling, escapes and all — the
            // decoded value in `text` is not what the author wrote.
            if (n.raw.len() > 0) { return n.raw; }
            if (n.suffix.len() > 0) { return n.text + n.suffix; }
            return n.text;
        },
        ast.ExprIdent(id) => { return id.name; },
        ast.ExprString(s) => { return quote_string(s.value); },
        ast.ExprBool(b) => {
            if (b.value) { return "true"; }
            return "false";
        },
        ast.ExprBinary(b) => {
            var p: i32 = binary_prec(b.op);
            var inner: string = print_expr_prec(b.left, p, depth) + " " + b.op + " " + print_expr_prec(b.right, p + 1, depth);
            if (p < parent_prec) { return "(" + inner + ")"; }
            return inner;
        },
        ast.ExprUnary(u) => {
            // A cast is a unary node whose op is `as_<type>` (parse_cast's
            // e_unary_at), not a prefix operator — printing it as one produced
            // `as_i32s[i + 1]` for `s[i + 1] as i32`, which re-parses as a call
            // to an undefined name. It binds at its own level, above every
            // binary operator and below the postfix positions.
            if (u.op.len() > 3 && util.str_has_prefix(u.op, "as_")) {
                var cinner: string = print_expr_prec(u.operand, prec_cast(), depth) + " as " + slice_unchecked(u.op, 3, u.op.len());
                if (parent_prec >= prec_cast()) { return "(" + cinner + ")"; }
                return cinner;
            }
            // The `?` try operator is a POSTFIX form the parser records as the
            // unary op `try_` (parse_postfix). Printing it as a prefix gave
            // `try_first(xs)` — a call to an undefined name.
            if (u.op == "try_") {
                return print_expr_prec(u.operand, prec_unary(), depth) + "?";
            }
            var uinner: string = u.op + print_expr_prec(u.operand, prec_unary(), depth);
            if (parent_prec >= prec_unary()) { return "(" + uinner + ")"; }
            return uinner;
        },
        ast.ExprCall(c) => {
            // A match- or if-EXPRESSION reaches here as the 0-arg IIFE
            // parse_primary desugars it to. Printing that back is not a style
            // choice: the IIFE's return type is a TAG the desugar guessed from
            // one branch's shape (if_expr_rt), so `match (o) { … }` yielding a
            // string came back as `(): i32 => { … }()`, which no longer
            // type-checks.
            // A value-position `{ … }` block expression is a 0-arg IIFE too,
            // but a TAGGED one — a hand-written IIFE is not interchangeable
            // with it (its `return` stays inside the lambda, and a `defer` in
            // it is the lambda's, not the enclosing function's), so this reads
            // the parser's tag rather than the shape.
            var blk: string = print_block_expr(c, parent_prec, depth);
            if (blk.len() > 0) { return blk; }
            // A tuple- or struct-scrutinee match in expression position routes
            // its arm values through a local rather than a `return`, so the
            // IIFE body is three statements and print_expr_iife's one-statement
            // shape does not fit it (#7089).
            var vl: string = print_value_local_iife(c, depth);
            if (vl.len() > 0) { return vl; }
            var iife: string = print_expr_iife(c, depth);
            if (iife.len() > 0) { return iife; }
            var out: string = print_expr_prec(c.callee, prec_primary(), depth) + "(";
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (i > 0) { out = out + ", "; }
                out = out + print_expr(c.args[i], depth);
                i = i + 1;
            }
            return out + ")";
        },
        ast.ExprArray(a) => {
            var out: string = "[";
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (i > 0) { out = out + ", "; }
                out = out + print_expr(a.elements[i], depth);
                i = i + 1;
            }
            return out + "]";
        },
        ast.ExprTuple(t) => {
            var out: string = "(";
            var i: i32 = 0;
            while (i < t.elements.len()) {
                if (i > 0) { out = out + ", "; }
                out = out + print_expr(t.elements[i], depth);
                i = i + 1;
            }
            return out + ")";
        },
        ast.ExprIndex(x) => {
            return print_expr_prec(x.array, prec_primary(), depth) + "[" + print_expr(x.index, depth) + "]";
        },
        ast.ExprSlice(sl) => {
            return print_expr_prec(sl.array, prec_primary(), depth) + "[" + print_expr(sl.start, depth) + ":" + print_expr(sl.end, depth) + "]";
        },
        ast.ExprStructLit(sl) => {
            var out: string = sl.type_name + " { ";
            var first: boolean = true;
            if (sl.has_base) {
                out = out + "..." + print_expr(sl.base, depth);
                first = false;
            }
            var i: i32 = 0;
            while (i < sl.field_names.len()) {
                if (!first) { out = out + ", "; }
                out = out + sl.field_names[i] + ": " + print_expr(sl.field_values[i], depth);
                first = false;
                i = i + 1;
            }
            return out + " }";
        },
        ast.ExprFieldAccess(fa) => { return print_expr_prec(fa.obj, prec_primary(), depth) + "." + fa.field; },
        ast.ExprLambda(lm) => {
            // Every lambda is an arrow: `(p: T): R => body`. The return type
            // prints only when written — the arrow form does not have to state
            // one. An expression body is recovered from the one-statement
            // `return` it desugars to; anything else stays braced, and a
            // single-statement braced body renders inline so a short predicate
            // lambda stays on the line that passes it.
            // Past the desugar's prelude, a lambda with a destructuring
            // parameter has the same body shape as one without (#7338).
            var (pats, npre) = param_patterns_for(lm.params, lm.body);
            var out: string = print_params_with(lm.params, pats);
            if (lm.ret_type.len() > 0) { out = out + ": " + arrow_return_type(lm.ret_type); }
            out = out + " => ";
            var body: ast.Stmt[] = drop_prelude(lm.body, npre);
            var av: string = print_return_only(body, depth);
            if (av.len() > 0) {
                out = out + av;
            } else if (body.len() == 1 && stmt_is_single_line(body[0])) {
                out = out + "{ " + print_stmt_inline(body[0], depth) + " }";
            } else {
                var (lam_body, _) = print_block(body, depth, empty_fmt());
                out = out + lam_body;
            }
            // The body runs as far right as it can, so any context that
            // continues with a tighter operator needs parens. An assignment's
            // RHS is terminal, hence `>` not `>=`.
            if (parent_prec > prec_assign()) { return "(" + out + ")"; }
            return out;
        },
        ast.ExprFString(fs) => {
            var out: string = "f\"";
            var i: i32 = 0;
            while (i < fs.lits.len()) {
                if (fs.is_expr[i]) {
                    out = out + "{" + print_expr(fs.exprs[i], depth) + "}";
                } else {
                    out = out + escape_fstring_lit(fs.lits[i]);
                }
                i = i + 1;
            }
            return out + "\"";
        },
        ast.ExprMapLit(ml) => {
            var out: string = "Map {";
            var i: i32 = 0;
            while (i < ml.keys.len()) {
                if (i > 0) { out = out + ","; }
                out = out + " " + print_expr(ml.keys[i], depth) + ": " + print_expr(ml.vals[i], depth);
                i = i + 1;
            }
            return out + " }";
        },
        ast.ExprUnknown(u) => { return "/*unknown:" + u.kind + "*/"; }
    }
    return "/*unhandled-expr*/";
}

// =================== STATEMENTS ====================

// indent_str returns `depth` copies of "  " — two spaces per level, the width
// native's formatter uses and the one `make fmt-check` gates the tree against.
function indent_str(depth: i32): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < depth) { out = out + "  "; i = i + 1; }
    return out;
}

// =================== COMMENTS AND BLANK LINES ====================
//
// Comments and blank lines are not in the AST — the lexer hands them back
// beside the tokens, and blank lines are read off the source text — so the
// statement walk carries a CURSOR over the comment list and consumes from it
// as it passes each source line (#6769). The rules are native's:
//
//   - a comment before the next statement's line emits as its own line at that
//     statement's indent;
//   - a comment ON the line of a just-emitted single-line statement emits
//     inline after two spaces;
//   - comments left over at the end of a block emit before its closing brace;
//   - one blank line before a statement whose source had a blank directly
//     above it, so runs collapse to one and a second format pass is a no-op.
//
// `comments` must be in source order, which is how tokenize_full returns them.
// A cursor that never moves is the no-comment case, so print_module keeps
// working by passing an empty list.
struct Fmt { comments: lexer.Comment[], ci: i32, blanks: boolean[] }

function empty_fmt(): Fmt { return Fmt { comments: [], ci: 0, blanks: [] }; }

// blank_at reports whether source line `line` was blank. Out-of-range lines
// (line 0, or past the end) are not blank.
function (f: Fmt) blank_at(line: i32): boolean {
    if (line < 0 || line >= f.blanks.len()) { return false; }
    return f.blanks[line];
}

// blank_before: did the source have a blank line directly above this
// construct? A leading comment block belongs to the construct, so the line
// looked at is the comment's, not the statement's.
function (f: Fmt) blank_before(line: i32): boolean {
    var top: i32 = line;
    if (f.ci < f.comments.len() && f.comments[f.ci].line < line) { top = f.comments[f.ci].line; }
    return f.blank_at(top - 1);
}

// drain_leading emits every pending comment written ABOVE source line `line`.
// A comment on the same line stays queued for emit_trailing.
function drain_leading(f: Fmt, line: i32, depth: i32): (string, Fmt) {
    var out: string = "";
    var g: Fmt = f;
    while (g.ci < g.comments.len() && g.comments[g.ci].line < line) {
        out = out + indent_str(depth) + "//" + g.comments[g.ci].text + "\n";
        g = Fmt { ...g, ci: g.ci + 1 };
    }
    return (out, g);
}

// emit_trailing emits a comment sharing the source line of the statement just
// written — `putchar(70);  // F`. No newline: the caller's line break follows.
function emit_trailing(f: Fmt, line: i32): (string, Fmt) {
    if (f.ci < f.comments.len() && f.comments[f.ci].line == line) {
        return ("  //" + f.comments[f.ci].text, Fmt { ...f, ci: f.ci + 1 });
    }
    return ("", f);
}

// inner_comment_pending: is a queued comment written INSIDE a declaration's
// braces — below its first line, at or above the last field's? A struct or enum
// carrying one has to print in the multi-line block form, since the one-liner
// has nowhere to put it and the cursor would flush it above the NEXT
// declaration instead.
function inner_comment_pending(f: Fmt, decl_line: i32, last: i32): boolean {
    var i: i32 = f.ci;
    while (i < f.comments.len()) {
        var ln: i32 = f.comments[i].line;
        if (ln > last) { return false; }
        if (ln > decl_line) { return true; }
        i = i + 1;
    }
    return false;
}

// field_lines_for returns the per-field source lines recorded for the named
// declaration, or an empty list when the parse did not record any (every parse
// but `-fmt`'s, and any decl the parser could not read).
function field_lines_for(flines: parser.FieldLines[], name: string, decl_line: i32): i32[] {
    var i: i32 = 0;
    while (i < flines.len()) {
        if (flines[i].name == name && flines[i].decl_line == decl_line) { return flines[i].lines; }
        i = i + 1;
    }
    var none: i32[] = [];
    return none;
}

// drain_all flushes every remaining comment at `depth` — end of file, and the
// tail of a block whose last statement is behind the cursor.
function drain_all(f: Fmt, depth: i32): (string, Fmt) {
    var out: string = "";
    var g: Fmt = f;
    while (g.ci < g.comments.len()) {
        out = out + indent_str(depth) + "//" + g.comments[g.ci].text + "\n";
        g = Fmt { ...g, ci: g.ci + 1 };
    }
    return (out, g);
}

// drain_before flushes the comments written above `limit` — a block's closing
// brace, whose line the AST does not record, so the bound is the line of the
// construct that FOLLOWS the block instead.
function drain_before(f: Fmt, limit: i32, depth: i32): (string, Fmt) {
    return drain_leading(f, limit, depth);
}

// print_block renders `{ … }` and is the one place statements are drained
// against: a comment above a statement, a blank line the author left before
// it, and whatever is still queued when the block ends.
function print_block(body: ast.Stmt[], depth: i32, f: Fmt): (string, Fmt) {
    // An empty block is a one-liner, as native prints it. Supporting a comment
    // inside one would force it multi-line for a comment with nothing to
    // attach to; the parent's drain picks those up instead.
    if (body.len() == 0) { return ("{}", f); }
    var out: string = "{\n";
    var g: Fmt = f;
    var i: i32 = 0;
    var last_line: i32 = 0;
    while (i < body.len()) {
        var ln: i32 = ast.stmt_line(body[i]);
        // Never a blank just inside the opening brace.
        if (i > 0 && ln > 0 && g.blank_before(ln)) { out = out + "\n"; }
        if (ln > 0) {
            var (lead, g1) = drain_leading(g, ln, depth + 1);
            out = out + lead;
            g = g1;
        }
        var (body_text, g2) = print_stmt(body[i], depth + 1, g);
        out = out + body_text;
        g = g2;
        if (ln > last_line) { last_line = ln; }
        i = i + 1;
    }
    out = out + indent_str(depth) + "}";
    return (out, g);
}

function print_pattern(pat: ast.Pattern): string {
    return print_pattern_ctx(pat, false);
}

// print_pattern_ctx is print_pattern with the one context difference the
// grammar makes: a payload-less variant is `B` at an ARM position but must be
// `B()` as a TUPLE ELEMENT, where a bare `B` binds a local named B instead —
// a different program, not a different spelling.
function print_pattern_ctx(pat: ast.Pattern, always_parens: boolean): string {
    match (pat) {
        ast.PatWildcard(_) => { return "_"; },
        ast.PatVariant(pv) => {
            var head: string = pv.type_name;
            if (pv.at_binding.len() > 0) { head = pv.at_binding + " @ " + pv.type_name; }
            // A NESTED payload (`Some(Ok(n))`) binds nothing itself, so the
            // empty binding below is not "no payload list" — printing `head`
            // there would drop the sub-pattern and re-parse as a payload-less
            // arm. The sub-pattern is the payload.
            //
            // `nested` runs parallel to the payload list, so EVERY slot is
            // rendered: a slot with a pattern prints it, a slot without
            // prints the binder it named. Printing only nested[0] dropped the
            // rest of the list once a sub-pattern could sit at any position
            // (#7524).
            if (pv.nested.len() > 0) {
                var np: string = head + "(";
                var ni: i32 = 0;
                while (ni < pv.nested.len()) {
                    if (ni > 0) { np = np + ", "; }
                    if (pv_pattern_name(pv.nested[ni]).len() > 0) {
                        np = np + print_pattern(pv.nested[ni]);
                    } else {
                        np = np + payload_slot(pv, nested_slot_binder(pv, ni));
                    }
                    ni = ni + 1;
                }
                return np + ")";
            }
            // A TUPLE sub-pattern (`Pr((a, b))`) rides on tup_* rather than on
            // nested, and binds nothing itself either — printing `head` here
            // dropped it and re-parsed as a payload-less arm, leaving the
            // desugar's `__nest_<l>_<c>_<d>` temp behind in its place.
            if (pv.tup_kinds.len() > 0) {
                return head + "(" + print_tuple_elems(pv.tup_kinds, pv.tup_binds, pv.tup_lits, pv.tup_pats) + ")";
            }
            if (pv.binding.len() == 0) {
                if (always_parens) { return head + "()"; }
                return head;
            }
            // Every payload binding, not just the first — a `Pair(a, b)` printed
            // as `Pair(a)` re-parses as a different (E015) program.
            var out: string = head + "(" + payload_slot(pv, pv.binding);
            var i: i32 = 0;
            while (i < pv.extra_bindings.len()) {
                out = out + ", " + payload_slot(pv, pv.extra_bindings[i]);
                i = i + 1;
            }
            return out + ")";
        }
    }
    return "_";
}

// payload_slot renders one payload slot: the binder as written, or the LITERAL
// it was written as. A literal slot (`Sm(0)`) parses to a synthetic binder plus
// a `binder == 0` condition that fold_lit_cond moves onto the arm's guard, so
// the binder is a lowering artefact and printing it emits `Sm(__pl12_5) when
// __pl12_5 == 0` — a different program in the source the user gets back.
// pv_pattern_name is the variant a pattern names, "" for a wildcard — which
// is what `nested` holds at a slot that is a plain binder.
function pv_pattern_name(pat: ast.Pattern): string {
    match (pat) {
        ast.PatVariant(v) => { return v.type_name; },
        ast.PatWildcard(_) => { return ""; }
    }
    return "";
}

// nested_slot_binder is the name a variant pattern binds at payload slot i.
function nested_slot_binder(pv: ast.PatVariant, i: i32): string {
    if (i == 0) { return pv.binding; }
    if (i - 1 < pv.extra_bindings.len()) { return pv.extra_bindings[i - 1]; }
    return "";
}

// range_pair renders `lo..hi` / `lo..=hi` when a `&&`'s two sides are the
// bound PAIR a range payload builds for `binder`, and "" otherwise.
function range_pair(lo: ast.Expr, hi: ast.Expr, binder: string): string {
    match (lo) {
        ast.ExprBinary(lb) => {
            if (lb.op != ">=") { return ""; }
            match (lb.left) {
                ast.ExprIdent(li) => { if (li.name != binder) { return ""; } },
                _ => { return ""; }
            }
            match (hi) {
                ast.ExprBinary(hb) => {
                    if (hb.op != "<" && hb.op != "<=") { return ""; }
                    match (hb.left) {
                        ast.ExprIdent(hri) => { if (hri.name != binder) { return ""; } },
                        _ => { return ""; }
                    }
                    var sep: string = "..";
                    if (hb.op == "<=") { sep = "..="; }
                    return print_lit(lb.right) + sep + print_lit(hb.right);
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// range_slot_for is lit_cond_for for a RANGE payload (`V(1..5)`). A range
// folds to `binder >= lo && binder <op> hi`, which has no `==` conjunct, so
// lit_cond_for cannot see it and the slot printed as its synthetic temp.
function range_slot_for(cond: ast.Expr, binder: string): string {
    match (cond) {
        ast.ExprBinary(b) => {
            if (b.op != "&&") { return ""; }
            var here: string = range_pair(b.left, b.right, binder);
            if (here.len() > 0) { return here; }
            var l: string = range_slot_for(b.left, binder);
            if (l.len() > 0) { return l; }
            return range_slot_for(b.right, binder);
        },
        _ => { return ""; }
    }
    return "";
}

function payload_slot(pv: ast.PatVariant, binder: string): string {
    if (!pv.has_lit_cond) { return binder; }
    var rng: string = range_slot_for(pv.lit_cond, binder);
    if (rng.len() > 0) { return rng; }
    var lit: ast.Expr = lit_cond_for(pv.lit_cond, binder);
    if (expr_is_missing(lit)) { return binder; }
    return print_lit(lit);
}

// lit_cond_for finds the literal a slot was compared against inside the
// `&&`-joined condition fold_lit_cond built — the right-hand side of the
// `binder == <lit>` conjunct. Missing when the slot carries no literal.
function lit_cond_for(cond: ast.Expr, binder: string): ast.Expr {
    match (cond) {
        ast.ExprBinary(b) => {
            if (b.op == "&&") {
                var left: ast.Expr = lit_cond_for(b.left, binder);
                if (!expr_is_missing(left)) { return left; }
                return lit_cond_for(b.right, binder);
            }
            if (b.op == "==") {
                match (b.left) {
                    ast.ExprIdent(id) => { if (id.name == binder) { return b.right; } },
                    _ => {}
                }
            }
        },
        _ => {}
    }
    return parser.e_unknown("");
}

// print_tuple_elem renders ONE position of a tuple arm pattern, from the
// element kinds build_tuple_match encodes: 0 = binder, 1 = `_`, 2 = literal,
// 3 = variant sub-pattern, 4 = nested tuple (whose own encoding rides on
// elem_pats via p_tuple_carrier).
function print_tuple_elem(kind: i32, bind: string, lit: ast.Expr, pat: ast.Pattern): string {
    if (kind == 1) { return "_"; }
    if (kind == 2) { return print_lit(lit); }
    if (kind == 3) { return print_pattern_ctx(pat, true); }
    if (kind == 4) {
        var (nk, nb, nl, np) = parser.pv_tup(pat);
        return print_tuple_elems(nk, nb, nl, np);
    }
    return bind;
}

// print_tuple_elems renders `(p0, p1, …)`.
function print_tuple_elems(kinds: i32[], binds: string[], lits: ast.Expr[], pats: ast.Pattern[]): string {
    var out: string = "(";
    var i: i32 = 0;
    while (i < kinds.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + print_tuple_elem(kinds[i], binds[i], lits[i], pats[i]);
        i = i + 1;
    }
    return out + ")";
}

// print_tup_arm renders one tuple-match arm's pattern, `@` binding included.
function print_tup_arm(a: ast.TupArm): string {
    if (a.is_wild) {
        if (a.at_binding.len() > 0) { return a.at_binding + " @ _"; }
        return "_";
    }
    var pat: string = print_tuple_elems(a.elem_kinds, a.binds, a.lits, a.elem_pats);
    if (a.at_binding.len() > 0) { return a.at_binding + " @ " + pat; }
    return pat;
}

// rest_suffix is the `..` a partial pattern wrote, with the separator it needs
// after `n` already-printed fields. The `..` binds nothing — a named-field
// pattern binds only the fields it lists — so it survives only by being
// carried to here, and dropping it made `-fmt -w` delete what the author
// wrote.
function rest_suffix(rest_written: boolean, n: i32): string {
    if (!rest_written) { return ""; }
    if (n > 0) { return ", .."; }
    return "..";
}

// print_struct_arm renders one struct-match arm's pattern `P { x, y: b }`,
// using the same field kinds build_struct_match encodes (0 = bind, 2 =
// literal, 3 = sub-pattern). A field bound to its own name prints shorthand.
function print_struct_arm(a: ast.StructArm): string {
    if (a.is_wild) {
        if (a.at_binding.len() > 0) { return a.at_binding + " @ _"; }
        return "_";
    }
    var out: string = a.type_name + " { ";
    var i: i32 = 0;
    while (i < a.fields.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + a.fields[i];
        if (a.field_kinds[i] == 2) { out = out + ": " + print_lit(a.field_lits[i]); }
        else if (a.field_kinds[i] == 3) { out = out + ": " + print_pattern(a.field_pats[i]); }
        else if (a.binds[i] != a.fields[i]) { out = out + ": " + a.binds[i]; }
        i = i + 1;
    }
    out = out + rest_suffix(a.rest_written, a.fields.len());
    out = out + " }";
    if (a.at_binding.len() > 0) { return a.at_binding + " @ " + out; }
    return out;
}

// WrittenArm is one arm of a sugared match as the source spelled it: the
// pattern text with any `|` alternatives already rejoined, and the guard and
// body those alternatives shared.
struct WrittenArm { head: string, body: ast.Stmt[], guard: ast.Expr, has_guard: boolean }

// sugar_written_arms regroups a carrier's per-alternative arms back into the
// arms as written. A MatchSugar holds exactly one of the three arm lists — the
// tuple, struct and literal desugars each populate their own — and every one of
// them expands `P1 | P2 => …` to one entry per alternative sharing a body, so
// the regroup is the same walk in all three cases (#7077).
function sugar_written_arms(sg: ast.MatchSugar): WrittenArm[] {
    var out: WrittenArm[] = [];
    var i: i32 = 0;
    // The VARIANT-arm carrier: build_nested_arm_match's chain stands in for a
    // match whose arms are ordinary MatchArms, so they render straight through
    // print_pattern rather than through the tup/strct/lit spellings.
    if (sg.arms.len() > 0) {
        while (i < sg.arms.len()) {
            var a: ast.MatchArm = sg.arms[i];
            var ahead: string = print_pattern(a.pattern);
            // `A | B => …` parses to one arm per alternative with the body
            // cloned into each; alt_cont is what records that they were
            // written as one, so they rejoin here.
            while (i + 1 < sg.arms.len() && sg.arms[i + 1].alt_cont) {
                i = i + 1;
                ahead = ahead + " | " + print_pattern(sg.arms[i].pattern);
            }
            out = out.append(WrittenArm { head: ahead, body: a.body, guard: a.guard, has_guard: a.has_guard });
            i = i + 1;
        }
        return out;
    }
    var n: i32 = sg.tup.len() + sg.strct.len() + sg.lits.len();
    while (i < n) {
        var head: string = "";
        var body: ast.Stmt[] = [];
        var guard: ast.Expr = parser.e_bool(true);
        var has_guard: boolean = false;
        if (sg.tup.len() > 0) {
            head = print_tup_arm(sg.tup[i]);
            body = sg.tup[i].body;
            guard = sg.tup[i].guard;
            has_guard = sg.tup[i].has_guard;
            while (i + 1 < n && sg.tup[i + 1].alt_cont) {
                i = i + 1;
                head = head + " | " + print_tup_arm(sg.tup[i]);
            }
        } else {
            if (sg.strct.len() > 0) {
                head = print_struct_arm(sg.strct[i]);
                body = sg.strct[i].body;
                guard = sg.strct[i].guard;
                has_guard = sg.strct[i].has_guard;
            } else {
                head = print_lit_pat(sg.lits[i]);
                body = sg.lits[i].body;
                guard = sg.lits[i].guard;
                has_guard = sg.lits[i].has_guard;
                while (i + 1 < n && sg.lits[i + 1].alt_cont) {
                    i = i + 1;
                    head = head + " | " + print_lit_pat(sg.lits[i]);
                }
            }
        }
        out = out.append(WrittenArm { head: head, body: body, guard: guard, has_guard: has_guard });
        i = i + 1;
    }
    return out;
}

// print_sugared_match reprints a match the parser replaced outright — a tuple
// or struct scrutinee, whose done-flag chain the carrier hangs off (#7065), or
// a non-enum scrutinee, whose if/else-if chain it hangs off (#7072). Without it
// `-fmt` emitted the chain — `var __sm4_5_d = false; …` — over the user's match.
function print_sugared_match(sg: ast.MatchSugar, depth: i32, f: Fmt): (string, Fmt) {
    var pad: string = indent_str(depth);
    var arms: WrittenArm[] = sugar_written_arms(sg);
    var out: string = "match (" + print_expr(sg.scrut, depth) + ") {\n";
    var g: Fmt = f;
    var i: i32 = 0;
    while (i < arms.len()) {
        var (arm_body, g1) = print_block(arms[i].body, depth + 1, g);
        g = g1;
        out = out + indent_str(depth + 1) + arms[i].head;
        if (arms[i].has_guard) { out = out + " when " + print_expr(arms[i].guard, depth); }
        out = out + " => " + arm_body;
        if (i + 1 < arms.len()) { out = out + ","; }
        out = out + "\n";
        i = i + 1;
    }
    return (out + pad + "}", g);
}

// print_sugared_let_else reprints `let PAT = EXPR else { … };` for a LITERAL
// or range head, whose desugar is build_literal_match's if/else chain rather
// than a StmtMatch — so the carrier on the `if` is the only record of what was
// written. Sibling of print_let_else, which recovers the variant-pattern form
// from its StmtMatch, and it re-emits the statements that followed the same
// way: the desugar moved them inside the success arm.
function print_sugared_let_else(sg: ast.MatchSugar, depth: i32, f: Fmt): (string, Fmt) {
    var arms: WrittenArm[] = sugar_written_arms(sg);
    if (arms.len() < 2) { return print_sugared_match(sg, depth, f); }
    var g: Fmt = f;
    var (els, g1) = print_block(arms[arms.len() - 1].body, depth, g);
    g = g1;
    var head: string = "";
    var hi: i32 = 0;
    while (hi + 1 < arms.len()) {
        if (hi > 0) { head = head + " | "; }
        head = head + arms[hi].head;
        hi = hi + 1;
    }
    var out: string = "let " + head + " = " + print_expr(sg.scrut, depth) + " else " + els + ";";
    var rest: ast.Stmt[] = arms[0].body;
    var i: i32 = 0;
    while (i < rest.len()) {
        var ln: i32 = ast.stmt_line(rest[i]);
        out = out + "\n";
        if (ln > 0 && g.blank_before(ln)) { out = out + "\n"; }
        if (ln > 0) {
            var (lead, gl) = drain_leading(g, ln, depth);
            out = out + lead;
            g = gl;
        }
        var (stext, g2) = print_stmt_line(rest[i], depth, g);
        out = out + stext;
        g = g2;
        i = i + 1;
    }
    return (out, g);
}

// print_sugared_if_let reprints an `if let` whose head is a tuple, struct or
// literal pattern. Those heads take the same builders a `match` on such a
// scrutinee does, so the chain they leave behind carries the arms as written
// and nothing else — sibling of print_if_let, which recovers the source form
// for the variant-pattern path from its StmtMatch.
//
// The last written arm is the else block (empty when none was written); every
// arm before it is the head, with any `|` alternatives already joined by
// sugar_written_arms.
function print_sugared_if_let(sg: ast.MatchSugar, depth: i32, f: Fmt): (string, Fmt) {
    var arms: WrittenArm[] = sugar_written_arms(sg);
    if (arms.len() < 2) { return print_sugared_match(sg, depth, f); }
    var g: Fmt = f;
    var (then_block, g1) = print_block(arms[0].body, depth, g);
    g = g1;
    var out: string = "if let ";
    var i: i32 = 0;
    while (i + 1 < arms.len()) {
        if (i > 0) { out = out + " | "; }
        out = out + arms[i].head;
        i = i + 1;
    }
    out = out + " = " + print_expr(sg.scrut, depth) + " " + then_block;
    var els: ast.Stmt[] = arms[arms.len() - 1].body;
    if (els.len() > 0) {
        var (else_block, g2) = print_block(els, depth, g);
        g = g2;
        out = out + " else " + else_block;
    }
    return (out, g);
}

// print_lit_pat renders one literal arm pattern: `_`, a literal, or a range.
function print_lit_pat(a: ast.LitArm): string {
    if (a.is_wild) { return "_"; }
    if (a.has_range) {
        var dots: string = "..";
        if (a.range_inclusive) { dots = "..="; }
        return print_lit(a.lit) + dots + print_lit(a.range_hi);
    }
    return print_lit(a.lit);
}

function print_match(m: ast.StmtMatch, depth: i32, f: Fmt): (string, Fmt) {
    var pad: string = indent_str(depth);
    var out: string = "match (" + print_expr(m.scrutinee, depth) + ") {\n";
    var g: Fmt = f;
    // The arms as WRITTEN when the parse consumed something into the lowering
    // — a nested payload merged into one arm plus an inner match, or a literal
    // payload folded onto the guard. Empty on an ordinary match.
    var arms: ast.MatchArm[] = m.arms;
    if (m.sugar.len() > 0) { arms = m.sugar; }
    var i: i32 = 0;
    while (i < arms.len()) {
        var (arm_body, g1) = print_block(arms[i].body, depth + 1, g);
        g = g1;
        var head: string = print_pattern(arms[i].pattern);
        var guarded: ast.MatchArm = arms[i];
        // `A | B => …` parsed to one arm per alternative sharing the body; the
        // continuations rejoin their head here.
        while (i + 1 < arms.len() && arms[i + 1].alt_cont) {
            i = i + 1;
            head = head + " | " + print_pattern(arms[i].pattern);
        }
        out = out + indent_str(depth + 1) + head;
        if (guarded.has_guard) { out = out + " when " + print_expr(guarded.guard, depth); }
        out = out + " => " + arm_body;
        if (i + 1 < arms.len()) { out = out + ","; }
        out = out + "\n";
        i = i + 1;
    }
    return (out + pad + "}", g);
}

// print_if_let reconstructs `if let PAT = EXPR { … }` (plus an optional
// `else`) from the two-arm match the parser desugars it to: the leading arms
// are the pattern alternatives and the trailing wildcard arm is the else.
// StmtMatch.origin already recorded which form was written — only let_else was
// reading it, so an `if let` reprinted as the desugared match, `_ => {}` and
// all.
function print_if_let(m: ast.StmtMatch, depth: i32, f: Fmt): (string, Fmt) {
    // The written arms when a nested or literal payload was consumed into the
    // lowering; otherwise the lowered ones already are the written ones.
    var arms: ast.MatchArm[] = m.arms;
    if (m.sugar.len() > 0) { arms = m.sugar; }
    var g: Fmt = f;
    var (then_block, g1) = print_block(arms[0].body, depth, g);
    g = g1;
    var out: string = "if let ";
    var i: i32 = 0;
    while (i + 1 < arms.len()) {
        if (i > 0) { out = out + " | "; }
        out = out + print_pattern(arms[i].pattern);
        i = i + 1;
    }
    out = out + " = " + print_expr(m.scrutinee, depth) + " " + then_block;
    var els: ast.Stmt[] = arms[arms.len() - 1].body;
    if (els.len() > 0) {
        var (else_block, g2) = print_block(els, depth, g);
        g = g2;
        out = out + " else " + else_block;
    }
    return (out, g);
}

// print_let_else reconstructs `let PAT = EXPR else { … };` plus the statements
// that followed it, which the desugar moved inside the success arm. They re-emit
// as the siblings they were written as, at the same depth.
function print_let_else(m: ast.StmtMatch, depth: i32, f: Fmt): (string, Fmt) {
    // The written arms when a nested payload or an or-pattern was consumed
    // into the lowering; otherwise the lowered ones already are the written
    // ones. Same carrier print_if_let reads, for the same reason.
    var arms: ast.MatchArm[] = m.arms;
    if (m.sugar.len() > 0) { arms = m.sugar; }
    var g: Fmt = f;
    var (els, g1) = print_block(arms[arms.len() - 1].body, depth, g);
    g = g1;
    var head: string = "";
    var hi: i32 = 0;
    while (hi + 1 < arms.len()) {
        if (hi > 0) { head = head + " | "; }
        head = head + print_pattern(arms[hi].pattern);
        hi = hi + 1;
    }
    var out: string = "let " + head + " = " + print_expr(m.scrutinee, depth) + " else " + els + ";";
    var rest: ast.Stmt[] = arms[0].body;
    var i: i32 = 0;
    while (i < rest.len()) {
        var ln: i32 = ast.stmt_line(rest[i]);
        out = out + "\n";
        if (ln > 0 && g.blank_before(ln)) { out = out + "\n"; }
        if (ln > 0) {
            var (lead, gl) = drain_leading(g, ln, depth);
            out = out + lead;
            g = gl;
        }
        var (stext, g2) = print_stmt_line(rest[i], depth, g);
        out = out + stext;
        g = g2;
        i = i + 1;
    }
    return (out, g);
}

// UseSugar is the `use NAME[: TYPE] <- CALL;` a `return CALL(…, cb);` was
// desugared from — ok when CALL's last argument is the ORIGIN_USE callback,
// whose one parameter is the binding and whose body is the rest of the block.
struct UseSugar { ok: boolean, name: string, type_name: string, call: ast.Expr, body: ast.Stmt[] }

function as_use(e: ast.Expr): UseSugar {
    var none: UseSugar = UseSugar { ok: false, name: "", type_name: "", call: e, body: [] };
    if let ast.ExprCall(c) = e {
        if (c.args.len() == 0) { return none; }
        if let ast.ExprLambda(lm) = c.args[c.args.len() - 1] {
            if (lm.origin != parser.ORIGIN_USE || lm.params.len() != 1) { return none; }
            var written: ast.Expr[] = [];
            var i: i32 = 0;
            while (i + 1 < c.args.len()) { written = written.append(c.args[i]); i = i + 1; }
            var call: ast.Expr = ast.ExprCall { ...c, args: written };
            return UseSugar { ok: true, name: lm.params[0].name, type_name: lm.params[0].type_name, call: call, body: lm.body };
        }
    }
    return none;
}

// print_use reprints `use NAME[: TYPE] <- CALL;` plus the statements that
// followed it, which the desugar moved into the callback body. They re-emit as
// the siblings they were written as, at the same depth — the shape
// print_let_else recovers for the other rest-of-block desugar. The type prints
// only when the source wrote one; otherwise the checker infers it.
function print_use(us: UseSugar, line: i32, depth: i32, f: Fmt): (string, Fmt) {
    var out: string = "use " + us.name;
    if (us.type_name.len() > 0) { out = out + ": " + us.type_name; }
    out = out + " <- " + print_expr(us.call, depth) + ";";
    var g: Fmt = f;
    if (line > 0) {
        var (tr, g0) = emit_trailing(g, line);
        out = out + tr;
        g = g0;
    }
    var i: i32 = 0;
    while (i < us.body.len()) {
        var ln: i32 = ast.stmt_line(us.body[i]);
        out = out + "\n";
        if (ln > 0 && g.blank_before(ln)) { out = out + "\n"; }
        if (ln > 0) {
            var (lead, gl) = drain_leading(g, ln, depth);
            out = out + lead;
            g = gl;
        }
        var (stext, g2) = print_stmt_line(us.body[i], depth, g);
        out = out + stext;
        g = g2;
        i = i + 1;
    }
    return (out, g);
}

// expr_is_missing reports an expression slot the parser never filled — a void
// `return;`, whose value is the unknown-token placeholder for the `;`.
function expr_is_missing(e: ast.Expr): boolean {
    match (e) {
        ast.ExprUnknown(u) => { return u.kind.len() == 0 || util.str_has_prefix(u.kind, "punct:"); },
        _ => { return false; }
    }
    return false;
}

// stmt_is_single_line: the statement kinds native renders on one line, and so
// the ones a one-statement lambda body may keep inline.
function stmt_is_single_line(st: ast.Stmt): boolean {
    match (st) {
        ast.StmtReturn(r) => { return !as_use(r.value).ok; },
        ast.StmtVar(_) => { return true; },
        ast.StmtExpr(_) => { return true; },
        ast.StmtAssign(_) => { return true; },
        ast.StmtBreak(_) => { return true; },
        ast.StmtContinue(_) => { return true; },
        ast.StmtDefer(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// print_chain_assign reprints `a = b = c = expr;` from its desugar, which
// assigns the innermost target first and copies leftwards — so the written
// targets are the assignment targets read back to front, and the written value
// is the first assignment's right-hand side.
function print_chain_assign(stmts: ast.Stmt[], depth: i32): string {
    var out: string = "";
    var i: i32 = stmts.len() - 1;
    while (i >= 0) {
        out = out + assign_target(stmts[i]) + " = ";
        i = i - 1;
    }
    return out + print_expr(assign_value(stmts[0]), depth) + ";";
}

function assign_target(st: ast.Stmt): string {
    match (st) {
        ast.StmtAssign(a) => { return a.target; },
        _ => { return ""; },
    }
}

function assign_value(st: ast.Stmt): ast.Expr {
    match (st) {
        ast.StmtAssign(a) => { return a.value; },
        _ => { return parser.e_bool(true); },
    }
}

// is_block_stmt reports whether `st` is a bare `{ … }` statement — the if-true
// scope parse_stmt_at tags as such.
function is_block_stmt(st: ast.Stmt): boolean {
    match (st) {
        ast.StmtIf(ifs) => { return ifs.origin == "block"; },
        _ => { return false; },
    }
}

// block_stmts is the body of the if-true scope `st`; empty for anything that
// is not an `if` at all.
function block_stmts(st: ast.Stmt): ast.Stmt[] {
    var none: ast.Stmt[] = [];
    match (st) {
        ast.StmtIf(ifs) => { return ifs.then_body; },
        _ => { return none; },
    }
}

// print_stmt_inline renders `st` for a position that CONTINUES the current
// line — a one-statement lambda body. A lambda carries no comment cursor: it
// is an expression, and native does not drain inside one either.
function print_stmt_inline(st: ast.Stmt, depth: i32): string {
    var (text, _) = print_stmt_body(st, 0, empty_fmt());
    return text;
}

// ForCSugar is a C-style `for` recovered from the desugar the parser lowered it
// to. `ok` is false for an ordinary `if`.
//
// `init` and `step` hold zero or one statement each — the header allows both to
// be empty (`for (; c; )`). `cond` is the loop condition; an omitted one
// desugars to the literal `true` and is reprinted that way, since the lowered
// form keeps no record of which of the two was written.
// `label` is the loop label the source wrote, which with_loop_label parks on
// the desugar's inner while — there is no other loop in the shape to carry it.
struct ForCSugar { init: ast.Stmt[], cond: ast.Expr, step: ast.Stmt[], body: ast.Stmt[], label: string, ok: boolean }

function no_c_for(): ForCSugar {
    var none: ast.Stmt[] = [];
    return ForCSugar { init: none, cond: ast.ExprBool { value: true }, step: none, body: none, label: "", ok: false };
}

// as_c_for recognises the C-style-for desugar and takes the three header
// clauses and the body back out of it. Its marker is the synthesised flag
// variable, `__forc_<line>_<col>`: the `__` prefix is reserved, so no source
// program can present this shape by accident.
//
// The shape is parse_for's, and the two must move together — a change to the
// desugar that this stops recognising silently reverts to printing the
// while-loop.
//
//     if (true) { INIT…; var __forc_L_C = true; while (true) {
//         if (!__forc_L_C) { STEP }
//         __forc_L_C = false;
//         if (!(COND)) { break; }
//         BODY…
//     } }
function as_c_for(ifs: ast.StmtIf): ForCSugar {
    if (!expr_is_true(ifs.cond) || ifs.else_body.len() != 0) { return no_c_for(); }
    var outer: ast.Stmt[] = ifs.then_body;
    if (outer.len() < 2) { return no_c_for(); }
    var flag: string = "";
    match (outer[outer.len() - 2]) {
        ast.StmtVar(v) => {
            if (is_forc_name(v.name) && expr_is_true(v.init)) { flag = v.name; }
        },
        _ => {},
    }
    if (flag.len() == 0) { return no_c_for(); }
    var wbody: ast.Stmt[] = [];
    var label: string = "";
    var have_while: boolean = false;
    match (outer[outer.len() - 1]) {
        ast.StmtWhile(w) => {
            if (expr_is_true(w.cond)) { wbody = w.body; label = w.label; have_while = true; }
        },
        _ => {},
    }
    if (!have_while || wbody.len() < 3) { return no_c_for(); }

    // wbody[0]: `if (!flag) { STEP }` — STEP is its then-body, possibly empty.
    var step: ast.Stmt[] = [];
    var step_ok: boolean = false;
    match (wbody[0]) {
        ast.StmtIf(s) => {
            if (is_not_of_ident(s.cond, flag) && s.else_body.len() == 0) { step = s.then_body; step_ok = true; }
        },
        _ => {},
    }
    if (!step_ok) { return no_c_for(); }

    // wbody[1]: `flag = false`.
    var assign_ok: boolean = false;
    match (wbody[1]) {
        ast.StmtAssign(a) => {
            if (a.target == flag && expr_is_false(a.value)) { assign_ok = true; }
        },
        _ => {},
    }
    if (!assign_ok) { return no_c_for(); }

    // wbody[2]: `if (!(COND)) { break; }`.
    var cond: ast.Expr = ast.ExprBool { value: true };
    var cond_ok: boolean = false;
    match (wbody[2]) {
        ast.StmtIf(c) => {
            if (c.else_body.len() == 0 && c.then_body.len() == 1) {
                match (c.then_body[0]) {
                    ast.StmtBreak(b) => {
                        if (b.label.len() == 0) {
                            match (c.cond) {
                                ast.ExprUnary(u) => {
                                    if (u.op == "!") { cond = u.operand; cond_ok = true; }
                                },
                                _ => {},
                            }
                        }
                    },
                    _ => {},
                }
            }
        },
        _ => {},
    }
    if (!cond_ok) { return no_c_for(); }

    var init: ast.Stmt[] = [];
    var ii: i32 = 0;
    while (ii + 2 < outer.len()) { init = init.append(outer[ii]); ii = ii + 1; }
    var body: ast.Stmt[] = [];
    var bi: i32 = 3;
    while (bi < wbody.len()) { body = body.append(wbody[bi]); bi = bi + 1; }
    return ForCSugar { init: init, cond: cond, step: step, body: body, label: label, ok: true };
}

// is_forc_name reports the synthesised first-iteration flag `__forc_<l>_<c>`.
function is_forc_name(name: string): boolean {
    return name.len() > 7 && util.str_has_prefix(name, "__forc_");
}

function expr_is_true(e: ast.Expr): boolean {
    match (e) {
        ast.ExprBool(b) => { return b.value; },
        _ => { return false; },
    }
    return false;
}

function expr_is_false(e: ast.Expr): boolean {
    match (e) {
        ast.ExprBool(b) => { return !b.value; },
        _ => { return false; },
    }
    return false;
}

// is_not_of_ident reports `!<name>`.
function is_not_of_ident(e: ast.Expr, name: string): boolean {
    match (e) {
        ast.ExprUnary(u) => {
            if (u.op != "!") { return false; }
            match (u.operand) {
                ast.ExprIdent(id) => { return id.name == name; },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// print_c_for renders the recovered header. The clause statements print with
// their trailing `;` stripped: the header's own separators supply them, and a
// clause is an ordinary statement everywhere else.
function print_c_for(fc: ForCSugar, depth: i32, f: Fmt): (string, Fmt) {
    var init: string = "";
    if (fc.init.len() == 1) { init = strip_semi(print_stmt_inline(fc.init[0], depth)); }
    var step: string = "";
    if (fc.step.len() == 1) { step = strip_semi(print_stmt_inline(fc.step[0], depth)); }
    var (body, g) = print_block(fc.body, depth, f);
    return (loop_label(fc.label) + "for (" + init + "; " + print_expr(fc.cond, depth) + "; " + step + ") " + body, g);
}

function strip_semi(s: string): string {
    if (s.len() > 0 && s[s.len() - 1] == b';') { return slice_unchecked(s, 0, s.len() - 1) + ""; }
    return s;
}

// print_if_chain renders an if/else with no leading indent and no trailing
// newline. An `else` the SOURCE wrote as a chain stays one — but only then:
// `else if` and `else { if … }` parse to the same one-element else_body, so
// rendering every such body as a chain rewrote the second spelling into the
// first (#6779). They are not interchangeable to a reader, to `make fmt-check`,
// or to a block-scoped binding written before the inner `if`.
function print_if_chain(ifs: ast.StmtIf, depth: i32, f: Fmt): (string, Fmt) {
    var (then_text, g) = print_block(ifs.then_body, depth, f);
    var out: string = "if (" + print_expr(ifs.cond, depth) + ") " + then_text;
    if (ifs.else_body.len() == 0) { return (out, g); }
    if (ifs.else_chained && ifs.else_body.len() == 1) {
        match (ifs.else_body[0]) {
            ast.StmtIf(nested) => {
                var (nested_text, g2) = print_if_chain(nested, depth, g);
                return (out + " else " + nested_text, g2);
            },
            _ => {}
        }
    }
    var (else_text, g3) = print_block(ifs.else_body, depth, g);
    return (out + " else " + else_text, g3);
}

// loop_label renders the `name: ` a labeled loop carries. Dropping it also
// strips the `break name` / `continue name` that target it, so the reformatted
// program leaves a different loop than the one written.
function loop_label(label: string): string {
    if (label.len() == 0) { return ""; }
    return label + ": ";
}

// for_binder renders a StmtFor's binder. The map form `for (k, v) in m` stores
// its two names comma-joined in the one field, and reprinting that bare gives
// `for k,v in m`, which does not parse.
function for_binder(var_name: string): string {
    if (!util.contains(var_name, ",")) { return var_name; }
    return "(" + join_csv(var_name) + ")";
}

// drop_first_stmt is `stmts` without its head — the pattern header's
// destructure, once it has been reprinted as the header itself.
function drop_first_stmt(stmts: ast.Stmt[]): ast.Stmt[] {
    var out: ast.Stmt[] = [];
    var i: i32 = 1;
    while (i < stmts.len()) { out = out.append(stmts[i]); i = i + 1; }
    return out;
}

// print_for_iter renders a StmtFor's iterable. The range forms are carried as
// a synthetic `__range(LOW, HIGH)` / `__range_incl(LOW, HIGH)` call
// (parse_for_stmt), which is a parser-internal name no source may write.
function print_for_iter(e: ast.Expr, depth: i32): string {
    match (e) {
        ast.ExprCall(c) => {
            if (c.args.len() == 2) {
                match (c.callee) {
                    ast.ExprIdent(id) => {
                        if (id.name == "__range") { return print_expr(c.args[0], depth) + ".." + print_expr(c.args[1], depth); }
                        if (id.name == "__range_incl") { return print_expr(c.args[0], depth) + "..=" + print_expr(c.args[1], depth); }
                    },
                    _ => {}
                }
            }
        },
        _ => {}
    }
    return print_expr(e, depth);
}

// print_stmt renders ONE statement as a complete line — indent, text, any
// inline trailing comment, and the newline. Comments ABOVE it were already
// drained by the block loop; a nested block drains its own.
function print_stmt(st: ast.Stmt, depth: i32, f: Fmt): (string, Fmt) {
    var (text, g) = print_stmt_line(st, depth, f);
    return (text + "\n", g);
}

// print_stmt_line is one statement indented at `depth` with NO trailing newline
// — the form a caller that supplies its own separator needs.
function print_stmt_line(st: ast.Stmt, depth: i32, f: Fmt): (string, Fmt) {
    var (text, g) = print_stmt_body(st, depth, f);
    var out: string = indent_str(depth) + text;
    // Only a single-line statement can carry a trailing comment: on a compound
    // one the same-line comment sits against the header, not the body, and
    // native does not attach it either.
    if (stmt_is_single_line(st)) {
        var ln: i32 = ast.stmt_line(st);
        if (ln > 0) {
            var (tr, g2) = emit_trailing(g, ln);
            return (out + tr, g2);
        }
    }
    return (out, g);
}

// split_commas splits a comma-joined binding / field list. Destructure names
// never contain a comma, so no nesting awareness is needed.
function split_commas(csv: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= csv.len()) {
        if (i == csv.len() || csv[i] == b',') {
            out = out.append(slice_unchecked(csv, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// join_csv respells a comma-joined list with native's `, ` separator.
function join_csv(csv: string): string {
    var parts: string[] = split_commas(csv);
    var out: string = "";
    var i: i32 = 0;
    while (i < parts.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + parts[i];
        i = i + 1;
    }
    return out;
}

// destr_at_prefix is the `w @ ` an `@` binding puts in front of a destructuring
// pattern, or "" when the source wrote none. The binding is a real name the
// body may read, so a pattern printed without it stops compiling.
function destr_at_prefix(type_name: string): string {
    var at: string = parser.destr_marker_split(type_name).at;
    if (at.len() == 0) { return ""; }
    return at + " @ ";
}

// print_struct_destructure respells `let Point { x, y } = E;` from the marker
// parse_struct_destructure encodes into type_name ("@sd:<Struct>:<fields>",
// with the bound names comma-joined in `name`). A field renamed on binding
// prints as `field: binding`, which is also how it was written.
function print_struct_destructure(v: ast.StmtVar, depth: i32): string {
    return "let " + destr_at_prefix(v.type_name) + struct_destr_pattern(v) + " = " + print_expr(v.init, depth) + ";";
}

// struct_destr_pattern is print_struct_destructure's PATTERN — `Point { x, y }`
// — without the `let` and the initialiser. A destructuring PARAMETER prints the
// same pattern in its parameter position, so the two share this rather than
// each spelling the marker decode (#7338).
function struct_destr_pattern(v: ast.StmtVar): string {
    var sd_marker: string = parser.destr_marker_split(v.type_name).tag;
    var rest: str = slice_unchecked(sd_marker, 4, sd_marker.len());
    var colon: i32 = 0 - 1;
    var ri: i32 = 0;
    while (ri < rest.len()) {
        if (rest[ri] == b':' && colon < 0) { colon = ri; }
        ri = ri + 1;
    }
    if (colon < 0) { return ""; }
    var struct_name: str = slice_unchecked(rest, 0, colon);
    var fields: string[] = split_commas(slice_unchecked(rest, colon + 1, rest.len()));
    var binds: string[] = split_commas(v.name);
    var out: string = struct_name + " { ";
    var i: i32 = 0;
    while (i < fields.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + fields[i];
        if (i < binds.len() && binds[i] != fields[i]) { out = out + ": " + binds[i]; }
        i = i + 1;
    }
    out = out + rest_suffix(parser.destr_marker_split(v.type_name).rest_written, fields.len());
    return out + " }";
}

// param_pattern_from renders the pattern a destructuring parameter was written
// with, recovered from the prelude `let` the parser minted for `holder` —
// `(a, b)` for a tuple, `P { x, y }` for a struct. "" when st is not that
// prelude, which is what stops a body's OWN destructuring being mistaken for
// the desugar's and swallowed into a parameter list.
//
// The prelude is identified by the `@pp;` tag on its marker channel, and only
// by that: a hand-written `let P { x, y } = p;` whose `p` is a parameter has
// the same binding list, the same `@sd:` marker and the same holder
// initialiser. Testing the holder name instead only separates a MINTED
// `__ptuple_` holder, and a parameter written `p @ P { x, y }: P` keeps the
// source's name as its holder — so that test passed the body's own
// destructure through, rewriting the function's signature under `-fmt -w`
// (#7523).
//
// Recovered rather than retained, unlike native, which carries the written
// pattern on ast.Param. ParamDecl is spelled at 41 sites across the self-host
// and the printer already decodes structure from these markers, so reading the
// prelude is both smaller and idiomatic here. The two compilers have to agree
// on OUTPUT, which the fmt parity gate checks; they need not agree on where the
// pattern is kept.
function param_pattern_from(st: ast.Stmt, holder: string): string {
    match (st) {
        ast.StmtVar(v) => {
            if (!parser.is_param_prelude_marker(v.type_name)) { return ""; }
            var from_holder: boolean = false;
            match (v.init) {
                ast.ExprIdent(id) => { if (id.name == holder) { from_holder = true; } },
                _ => { }
            }
            if (!from_holder) { return ""; }
            // An `@` binding names the WHOLE value beside the pattern —
            // `v @ P { x, y }` — and the parser uses that name as the holder
            // instead of minting a `__ptuple_` one. It is a real binding the
            // body may read, so the pattern alone would drop it.
            var at: string = "";
            if (!util.str_has_prefix(holder, "__ptuple_")) { at = holder + " @ "; }
            if (parser.is_struct_destr_marker(v.type_name)) { return at + struct_destr_pattern(v); }
            if (util.contains(v.name, ",")) { return at + "(" + join_csv(v.name) + ")"; }
            return "";
        },
        _ => { }
    }
    return "";
}

// param_patterns_for returns the written pattern for each parameter ("" for an
// ordinary one) and how many leading body statements are the desugar's prelude.
// The count is 0 unless EVERY pattern found is accounted for, so a caller either
// skips the whole prelude or prints the desugared form — never drops a binding.
function param_patterns_for(params: ast.ParamDecl[], body: ast.Stmt[]): (string[], i32) {
    var pats: string[] = [];
    var pi: i32 = 0;
    while (pi < params.len()) { pats = pats.append(""); pi = pi + 1; }

    var n: i32 = 0;
    while (n < body.len()) {
        var matched: boolean = false;
        var k: i32 = 0;
        while (k < params.len()) {
            if (pats[k].len() == 0) {
                var pat: string = param_pattern_from(body[n], params[k].name);
                if (pat.len() > 0) {
                    pats = pats.with(k, pat);
                    matched = true;
                    k = params.len();
                }
            }
            k = k + 1;
        }
        if (!matched) { n = body.len(); } else { n = n + 1; }
    }
    // Recount: the loop above exits by jumping n to body.len(), so derive the
    // prelude length from how many patterns were recovered instead.
    var found: i32 = 0;
    var j: i32 = 0;
    while (j < pats.len()) {
        if (pats[j].len() > 0) { found = found + 1; }
        j = j + 1;
    }
    return (pats, found);
}

// print_nested_func_decl respells a nested `function name(…): T { … }` from the
// lambda-valued local the parser desugars it to (marked "@fndecl" on type_name).
function print_nested_func_decl(v: ast.StmtVar, depth: i32, f: Fmt): (string, Fmt) {
    match (v.init) {
        ast.ExprLambda(lm) => {
            var out: string = "function " + v.name + print_lambda_params(lm);
            if (lm.ret_type.len() > 0) { out = out + ": " + lm.ret_type; }
            var (body, g) = print_block(lm.body, depth, f);
            return (out + " " + body, g);
        },
        _ => { }
    }
    return ("var " + v.name + " = " + print_expr(v.init, depth) + ";", f);
}

// print_stmt_body is the statement text with no indent and no newline.
function print_stmt_body(st: ast.Stmt, depth: i32, f: Fmt): (string, Fmt) {
    match (st) {
        ast.StmtDefer(d) => {
            // `defer { … }` parses its action with parse_stmt, so a block
            // action arrives as the tagged if-true scope. Native parses the
            // same action as a block EXPRESSION and prints it compactly, so
            // the braces go on one line here too.
            if (is_block_stmt(d.action)) {
                var blk: ast.Stmt[] = block_stmts(d.action);
                var inl: string = "{ ";
                var bi: i32 = 0;
                while (bi < blk.len()) { inl = inl + print_stmt_inline(blk[bi], 0) + " "; bi = bi + 1; }
                if (d.on_error != 0) { return ("errdefer " + inl + "}", f); }
                return ("defer " + inl + "}", f);
            }
            var (act, dg) = print_stmt_body(d.action, depth, f);
            if (d.on_error != 0) { return ("errdefer " + act, dg); }
            return ("defer " + act, dg);
        },
        ast.StmtVar(v) => {
            // Both destructuring forms parse to a StmtVar: the bindings are
            // comma-joined into `name`, and a STRUCT destructure additionally
            // tags `type_name` with the parser's `@sd:Type:field,field` marker.
            // Printed as a plain `var` they re-parse as something else — or, for
            // the tuple form, do not re-parse at all (#6773).
            if (parser.is_struct_destr_marker(v.type_name)) { return (print_struct_destructure(v, depth), f); }
            if (v.type_name == "@fndecl") { return print_nested_func_decl(v, depth, f); }
            if (util.contains(v.name, ",")) {
                return ("let " + destr_at_prefix(v.type_name) + "(" + join_csv(v.name) + ") = " + print_expr(v.init, depth) + ";", f);
            }
            var ann: string = "";
            if (v.type_name.len() > 0) { ann = ": " + v.type_name; }
            return ("var " + v.name + ann + " = " + print_expr(v.init, depth) + ";", f);
        },
        ast.StmtReturn(r) => {
            // A void `return;` parses with no value expression, which reaches
            // the printer as the unknown-token placeholder for the `;` that
            // followed. Printing that placeholder emits a comment INTO the
            // source; the statement is just `return;`.
            if (expr_is_missing(r.value)) { return ("return;", f); }
            // A `use` reaches the printer as the return of the call it
            // appended its callback to; printing that call rewrites the
            // rest of the block into a lambda.
            var us: UseSugar = as_use(r.value);
            if (us.ok) { return print_use(us, r.line, depth, f); }
            return ("return " + print_expr(r.value, depth) + ";", f);
        },
        ast.StmtExpr(x) => { return (print_expr(x.value, depth) + ";", f); },
        ast.StmtIf(ifs) => {
            // A C-style `for` reaches the printer as its desugar — the parser
            // lowers it at parse time and the Stmt union has no node for it
            // (StmtFor models the range form only). Printing the desugar
            // rewrites the user's loop into a synthesised while-loop, flag and
            // all, so reprint the header from the shape instead (#6771).
            var fc: ForCSugar = as_c_for(ifs);
            if (fc.ok) { return print_c_for(fc, depth, f); }
            // A tuple- or struct-scrutinee `match` desugars to `if (true) { … }`
            // and leaves no StmtMatch, so the carrier on the if is the only
            // record of what was written (#7065).
            if (ifs.sugar.tup.len() > 0 || ifs.sugar.strct.len() > 0 || ifs.sugar.lits.len() > 0 || ifs.sugar.arms.len() > 0) {
                if (ifs.sugar.origin == "if_let") { return print_sugared_if_let(ifs.sugar, depth, f); }
                if (ifs.sugar.origin == "let_else") { return print_sugared_let_else(ifs.sugar, depth, f); }
                return print_sugared_match(ifs.sugar, depth, f);
            }
            // A bare `{ … }` statement is the same if-true scope, tagged.
            if (ifs.origin == "block") { return print_block(ifs.then_body, depth, f); }
            // As is a chained assignment `a = b = c;`, whose desugar is one
            // assignment per target.
            if (ifs.origin == "chain_assign") { return (print_chain_assign(ifs.then_body, depth), f); }
            return print_if_chain(ifs, depth, f);
        },
        ast.StmtWhile(w) => {
            var (wb, wg) = print_block(w.body, depth, f);
            if (w.is_loop) { return (loop_label(w.label) + "loop " + wb, wg); }
            return (loop_label(w.label) + "while (" + print_expr(w.cond, depth) + ") " + wb, wg);
        },
        ast.StmtAssign(a) => { return (a.target + " = " + print_expr(a.value, depth) + ";", f); },
        ast.StmtMatch(m) => {
            // `let … else` is parsed as a two-arm match whose FIRST arm holds the
            // rest of the enclosing block (that is where the bindings are live),
            // so printing the match rewrites the whole tail of the function into
            // a nested one. StmtMatch.origin already records which form was
            // written; the printer just had to read it.
            if (m.origin == "let_else" && m.arms.len() >= 2) { return print_let_else(m, depth, f); }
            if (m.origin == "if_let" && m.arms.len() >= 2) { return print_if_let(m, depth, f); }
            return print_match(m, depth, f);
        },
        ast.StmtFor(fo) => {
            // A pattern-shaped header desugars to a synthetic `$forpat_`
            // element plus a destructure of it (parse_for_stmt), so it reprints
            // from that destructure — writing the synthetic name into the
            // source instead would make `-fmt -w` permanent.
            var fo_body: ast.Stmt[] = fo.body;
            var fo_binder: string = for_binder(fo.var_name);
            if (util.str_has_prefix(fo.var_name, "$forpat_") && fo.body.len() > 0) {
                match (fo.body[0]) {
                    ast.StmtVar(fpv) => {
                        fo_binder = destr_at_prefix(fpv.type_name);
                        if (parser.is_struct_destr_marker(fpv.type_name)) { fo_binder = fo_binder + struct_destr_pattern(fpv); }
                        else { fo_binder = fo_binder + "(" + join_csv(fpv.name) + ")"; }
                        fo_body = drop_first_stmt(fo.body);
                    },
                    _ => { }
                }
            }
            var (fb, fg) = print_block(fo_body, depth, f);
            return (loop_label(fo.label) + "for " + fo_binder + " in " + print_for_iter(fo.iter, depth) + " " + fb, fg);
        },
        ast.StmtBreak(b) => {
            if (b.label.len() > 0) { return ("break " + b.label + ";", f); }
            return ("break;", f);
        },
        ast.StmtContinue(c) => {
            if (c.label.len() > 0) { return ("continue " + c.label + ";", f); }
            return ("continue;", f);
        },
        ast.StmtUnknown(u) => { return ("/*unknown-stmt:" + u.kind + "*/", f); }
    }
    return ("/*unhandled-stmt*/", f);
}

// =================== MODULE ====================

// print_type_params renders `[T, K: cmp.Ord]`, or "" when the decl has none.
// The trait bound matters: dropping it turns a constrained generic into an
// unconstrained one, which the checker then refuses at the call site.
function print_type_params(fd: parser.FuncDecl): string {
    if (fd.type_params.len() == 0) { return ""; }
    var out: string = "[";
    var i: i32 = 0;
    while (i < fd.type_params.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + fd.type_params[i];
        if (i < fd.bound_traits.len() && fd.bound_traits[i].len() > 0) {
            // Multi-trait bounds are stored `+`-joined; native spells them
            // ` + `.
            out = out + ": " + join_plus(fd.bound_traits[i]);
        }
        i = i + 1;
    }
    return out + "]";
}

// join_plus respells a `+`-joined trait list with native's ` + ` separator.
function join_plus(bounds: string): string {
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= bounds.len()) {
        if (i == bounds.len() || bounds[i] == b'+') {
            if (out.len() > 0) { out = out + " + "; }
            out = out + slice_unchecked(bounds, start, i);
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

function print_func_decl(fd: parser.FuncDecl, f: Fmt): (string, Fmt) {
    // An `@import` extern (P4 — docs/WIT-BRING-YOUR-OWN.md) renders as the
    // attribute on its own line followed by a body-less function (`;`).
    var out: string = "";
    if (fd.import_iface.len() > 0) {
        out = out + "@import(" + quote_string(fd.import_iface) + ", " + quote_string(fd.import_wit) + ")\n";
    }
    // Modifier ORDER is native's: `pub`, then `fip`/`fbip`, then `async`.
    //
    // `pub` is what makes the function reachable across modules, so dropping it
    // turns a formatted library file into one whose exports no longer resolve.
    // `fip` selects the E053 no-allocation walk and `fbip` its constructor-
    // relaxed sibling, with the graded `(n)` naming the allocation budget E068
    // enforces. `async` selects the WASI Preview-3 `canon lift async` export
    // surface, so dropping it changes what a `-emit core-module` build exports.
    if (fd.is_pub) { out = out + "pub "; }
    if (fd.fip || fd.fbip) {
        if (fd.fip) { out = out + "fip"; } else { out = out + "fbip"; }
        if (fd.fip_allowance > 0) { out = out + "(" + util.i32_to_string(fd.fip_allowance) + ")"; }
        out = out + " ";
    }
    if (fd.async) { out = out + "async "; }
    out = out + "function ";
    // Type parameters. `function first[T](xs: T[])` formatted without them
    // leaves every `T` in the signature unbound, so the file stops compiling.
    // They follow the name for methods too (`function (o: Opt[T]) map[U]`),
    // the form spec/grammar.ebnf derives and native prints; the receiver's
    // own type variables are bound by the receiver type.
    var tps: string = print_type_params(fd);
    // Receiver clause: `(recv: RecvType)` after `function` and
    // before the method name. Both fields empty for plain funcs.
    if (fd.receiver_name.len() > 0) {
        out = out + "(" + fd.receiver_name;
        if (fd.receiver_type.len() > 0) { out = out + ": " + fd.receiver_type; }
        out = out + ") ";
    }
    out = out + fd.name + tps;
    var (dpats, dpre) = param_patterns_for(fd.params, fd.body);
    out = out + "(";
    var i: i32 = 0;
    while (i < fd.params.len()) {
        if (i > 0) { out = out + ", "; }
        // `own` is checked, not decorative: dropping it made E053 fire on the
        // formatted `fip` sort helpers, which pass their array `own` precisely
        // so `with` is in-place.
        if (fd.params[i].own) { out = out + "own "; }
        // A destructuring parameter prints the pattern it was written with,
        // not the holder the desugar minted (#7338).
        if (i < dpats.len() && dpats[i].len() > 0) {
            out = out + dpats[i];
        } else {
            out = out + fd.params[i].name;
        }
        if (fd.params[i].type_name.len() > 0) {
            out = out + ": " + fd.params[i].type_name;
        }
        i = i + 1;
    }
    out = out + ")";
    if (fd.ret_type.len() > 0) { out = out + ": " + fd.ret_type; }
    if (fd.import_iface.len() > 0) {
        return (out + ";\n", f);
    }
    // The parameter list carries the patterns now, so the prelude `let`s would
    // be a second, redundant binding of the same names.
    var (body_text, g) = print_block(drop_prelude(fd.body, dpre), 0, f);
    return (out + " " + body_text + "\n", g);
}

function print_struct_decl(sd: parser.StructDecl, flines: parser.FieldLines[], f: Fmt): (string, Fmt) {
    var out: string = "";
    // Attributes, on their own lines above the decl. Both change what the
    // program MEANS: `@derive` names methods the next parse synthesises, and
    // `@must_consume` arms the E067 obligation walk.
    if (sd.derives.len() > 0) {
        out = out + "@derive(";
        var di: i32 = 0;
        while (di < sd.derives.len()) {
            if (di > 0) { out = out + ", "; }
            out = out + sd.derives[di];
            di = di + 1;
        }
        out = out + ")\n";
    }
    if (sd.must_consume) { out = out + "@must_consume\n"; }
    if (sd.is_pub) { out = out + "pub "; }
    out = out + "struct " + sd.name;
    // Type parameters, for the same reason a function's matter: `struct Set { xs: T[] }`
    // leaves T unbound.
    if (sd.type_params.len() > 0) {
        out = out + "[";
        var tpi: i32 = 0;
        while (tpi < sd.type_params.len()) {
            if (tpi > 0) { out = out + ", "; }
            out = out + sd.type_params[tpi];
            tpi = tpi + 1;
        }
        out = out + "]";
    }
    // A comment inside the braces forces the multi-line form, one field per
    // line, so each field drains its own leading and trailing comment. Printing
    // the one-liner leaves those comments queued and the cursor then emits them
    // above the NEXT declaration, which is where they stop describing the field
    // they were written on.
    var lns: i32[] = field_lines_for(flines, sd.name, sd.line);
    if (lns.len() == sd.fields.len() && lns.len() > 0 && inner_comment_pending(f, sd.line, lns[lns.len() - 1])) {
        out = out + " {\n";
        var mi: i32 = 0;
        while (mi < sd.fields.len()) {
            var (lead, f1) = drain_leading(f, lns[mi], 1);
            out = out + lead;
            f = f1;
            out = out + indent_str(1) + sd.fields[mi].name + ": " + sd.fields[mi].type_name + ",";
            var (tr, f2) = emit_trailing(f, lns[mi]);
            out = out + tr + "\n";
            f = f2;
            mi = mi + 1;
        }
        return (out + "}\n", f);
    }
    out = out + " { ";
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + sd.fields[i].name + ": " + sd.fields[i].type_name;
        i = i + 1;
    }
    return (out + " }\n", f);
}

// print_const_decl re-spells a const from the zero-arg FuncDecl the parser
// desugars it into: the body is a single `return EXPR;`, and EXPR is the
// initialiser. Printing the desugar instead would emit `function NAME(): T {
// return EXPR; }`, which the SELF-HOST accepts (a bare reference to a zero-arg
// function is exactly what a const reference lowers to) but native rejects —
// it has no such rule, so `NAME + 1` there is an operator applied to a
// function value.
function print_const_decl(fd: parser.FuncDecl): string {
    var out: string = "";
    if (fd.is_pub) { out = out + "pub "; }
    out = out + "const " + fd.name;
    if (fd.ret_type.len() > 0) { out = out + ": " + fd.ret_type; }
    var i: i32 = 0;
    while (i < fd.body.len()) {
        match (fd.body[i]) {
            ast.StmtReturn(r) => { return out + " = " + print_expr(r.value, 0) + ";\n"; },
            _ => { }
        }
        i = i + 1;
    }
    return out + ";\n";
}

// enum_index returns the position of the enum named `name` in `enums`, or -1.
function enum_index(enums: parser.EnumDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < enums.len()) {
        if (enums[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// variant_decl_index returns the position of an enum variant's desugared struct
// record in `structs`, or -1. Both names are matched: a variant record is keyed
// by (enum_owner, name), and a plain struct may share a variant's name.
function variant_decl_index(structs: parser.StructDecl[], owner: string, name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].enum_owner == owner && structs[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// print_enum_decl reconstructs `enum Name[T] { V, W(A, B) }` from the EnumDecl
// and the variant structs the parser desugared it into. The payload types are
// the variant record's `__ev`, `__ev1`, … fields in declaration order, and the
// enum's `@derive` is read back from a variant record because that is where the
// parser stamps it — EnumDecl carries only `@must_consume`.
function print_enum_decl(ed: parser.EnumDecl, structs: parser.StructDecl[], flines: parser.FieldLines[], f: Fmt): (string, Fmt) {
    var out: string = "";
    var d0: i32 = 0 - 1;
    if (ed.variant_names.len() > 0) { d0 = variant_decl_index(structs, ed.name, ed.variant_names[0]); }
    if (d0 >= 0 && structs[d0].derives.len() > 0) {
        out = out + "@derive(";
        var di: i32 = 0;
        while (di < structs[d0].derives.len()) {
            if (di > 0) { out = out + ", "; }
            out = out + structs[d0].derives[di];
            di = di + 1;
        }
        out = out + ")\n";
    }
    if (ed.must_consume) { out = out + "@must_consume\n"; }
    if (ed.is_pub) { out = out + "pub "; }
    out = out + "enum " + ed.name;
    if (ed.type_params.len() > 0) {
        out = out + "[";
        var ti: i32 = 0;
        while (ti < ed.type_params.len()) {
            if (ti > 0) { out = out + ", "; }
            out = out + ed.type_params[ti];
            ti = ti + 1;
        }
        out = out + "]";
    }
    // One variant per line whenever a comment was written inside the braces,
    // for the same reason print_struct_decl does it.
    var lns: i32[] = field_lines_for(flines, ed.name, ed.line);
    if (lns.len() == ed.variant_names.len() && lns.len() > 0 && inner_comment_pending(f, ed.line, lns[lns.len() - 1])) {
        out = out + " {\n";
        var mvi: i32 = 0;
        while (mvi < ed.variant_names.len()) {
            var (lead, f1) = drain_leading(f, lns[mvi], 1);
            out = out + lead;
            f = f1;
            out = out + indent_str(1) + print_enum_variant(ed, structs, mvi) + ",";
            var (tr, f2) = emit_trailing(f, lns[mvi]);
            out = out + tr + "\n";
            f = f2;
            mvi = mvi + 1;
        }
        return (out + "}\n", f);
    }
    out = out + " { ";
    var vi: i32 = 0;
    while (vi < ed.variant_names.len()) {
        if (vi > 0) { out = out + ", "; }
        out = out + print_enum_variant(ed, structs, vi);
        vi = vi + 1;
    }
    return (out + " }\n", f);
}

// print_enum_variant renders variant `vi` — bare, tuple-payload `V(A, B)`, or
// record form `V { f: A }` — from the variant struct the parser desugared it to.
function print_enum_variant(ed: parser.EnumDecl, structs: parser.StructDecl[], vi: i32): string {
    var out: string = ed.variant_names[vi];
    var si: i32 = variant_decl_index(structs, ed.name, ed.variant_names[vi]);
    if (si >= 0 && structs[si].variant_field_names.len() > 0) {
        // Record form — the payload fields carry positional `__ev` markers, so
        // the written names come from variant_field_names, parallel to them.
        out = out + " {";
        var ri: i32 = 0;
        while (ri < structs[si].fields.len()) {
            if (ri > 0) { out = out + ","; }
            out = out + " " + structs[si].variant_field_names[ri] + ": " + structs[si].fields[ri].type_name;
            ri = ri + 1;
        }
        return out + " }";
    }
    if (si >= 0 && structs[si].fields.len() > 0) {
        out = out + "(";
        var fi: i32 = 0;
        while (fi < structs[si].fields.len()) {
            if (fi > 0) { out = out + ", "; }
            out = out + structs[si].fields[fi].type_name;
            fi = fi + 1;
        }
        return out + ")";
    }
    return out;
}

// print_type_params_except renders a decl's type parameters minus `skip`, or ""
// when nothing is left.
function print_type_params_except(fd: parser.FuncDecl, skip: string[]): string {
    var names: string[] = [];
    var bounds: string[] = [];
    var i: i32 = 0;
    while (i < fd.type_params.len()) {
        if (!util.has_str(skip, fd.type_params[i])) {
            names = names.append(fd.type_params[i]);
            if (i < fd.bound_traits.len()) { bounds = bounds.append(fd.bound_traits[i]); } else { bounds = bounds.append(""); }
        }
        i = i + 1;
    }
    if (names.len() == 0) { return ""; }
    var out: string = "[";
    var j: i32 = 0;
    while (j < names.len()) {
        if (j > 0) { out = out + ", "; }
        out = out + names[j];
        if (bounds[j].len() > 0) { out = out + ": " + join_plus(bounds[j]); }
        j = j + 1;
    }
    return out + "]";
}

// print_impl_decl reconstructs `impl[T: Bound] Trait for Type { … }` (or an
// inherent `impl Type { … }`) from the written form parse_impl_decl retains.
// The methods are the DESUGARED forms, which is what native prints too.
function print_impl_decl(id: parser.ImplDecl, f: Fmt): (string, Fmt) {
    var out: string = "impl";
    if (id.type_params.len() > 0) {
        out = out + "[";
        var tpi: i32 = 0;
        while (tpi < id.type_params.len()) {
            if (tpi > 0) { out = out + ", "; }
            out = out + id.type_params[tpi];
            if (tpi < id.bounds.len() && id.bounds[tpi].len() > 0) { out = out + ": " + join_plus(id.bounds[tpi]); }
            tpi = tpi + 1;
        }
        out = out + "]";
    }
    out = out + " ";
    if (id.trait_ref.len() > 0) { out = out + id.trait_ref + " for "; }
    out = out + id.type_ref;
    if (id.methods.len() == 0) { return (out + " {}\n", f); }
    out = out + " {\n";
    var g: Fmt = f;
    var mi: i32 = 0;
    while (mi < id.methods.len()) {
        var (mtext, mg) = print_impl_method(id.methods[mi], id.type_params, g);
        out = out + mtext;
        g = mg;
        mi = mi + 1;
    }
    return (out + "}\n", g);
}

// print_impl_method emits one method at one indent level. An impl block states
// its methods with `self` as an ordinary first PARAMETER, so a receiver — which
// is what the decl was desugared into — is re-inserted there. A receiver-less
// method is an associated function and its parameters stand as written.
function print_impl_method(m: parser.FuncDecl, impl_tps: string[], f: Fmt): (string, Fmt) {
    // finalize_impl_method merges the IMPL's type parameters into the method's,
    // so printing them here would restate `[T]` on every method of an
    // `impl[T] …` — which native rejects outright ("cannot declare its own type
    // parameters inside a parametric impl block").
    var out: string = indent_str(1) + "function " + m.name + print_type_params_except(m, impl_tps) + "(";
    var first: boolean = true;
    if (m.receiver_name.len() > 0) {
        out = out + m.receiver_name;
        if (m.receiver_type.len() > 0) { out = out + ": " + m.receiver_type; }
        first = false;
    }
    var i: i32 = 0;
    while (i < m.params.len()) {
        if (!first) { out = out + ", "; }
        if (m.params[i].own) { out = out + "own "; }
        out = out + m.params[i].name;
        if (m.params[i].type_name.len() > 0) { out = out + ": " + m.params[i].type_name; }
        first = false;
        i = i + 1;
    }
    out = out + ")";
    if (m.ret_type.len() > 0) { out = out + ": " + m.ret_type; }
    if (m.body.len() == 0) { return (out + ";\n", f); }
    var (body, g) = print_block(m.body, 1, f);
    return (out + " " + body + "\n", g);
}

// print_trait_decl reconstructs `pub trait Name[T]: Super { … }` from the
// written form parse_trait_decl retains. The compile path's own views of a
// trait cannot be printed from — see parser.TraitDecl.
function print_trait_decl(td: parser.TraitDecl, f: Fmt): (string, Fmt) {
    var out: string = "";
    if (td.is_pub) { out = out + "pub "; }
    out = out + "trait " + td.name;
    if (td.type_params.len() > 0) {
        out = out + "[";
        var tpi: i32 = 0;
        while (tpi < td.type_params.len()) {
            if (tpi > 0) { out = out + ", "; }
            out = out + td.type_params[tpi];
            tpi = tpi + 1;
        }
        out = out + "]";
    }
    if (td.supertraits.len() > 0) {
        out = out + ": ";
        var spi: i32 = 0;
        while (spi < td.supertraits.len()) {
            if (spi > 0) { out = out + " + "; }
            out = out + td.supertraits[spi];
            spi = spi + 1;
        }
    }
    if (td.methods.len() == 0) { return (out + " {}\n", f); }
    out = out + " {\n";
    var g: Fmt = f;
    var mi: i32 = 0;
    while (mi < td.methods.len()) {
        var (mtext, mg) = print_trait_method(td.methods[mi], g);
        out = out + mtext;
        g = mg;
        mi = mi + 1;
    }
    return (out + "}\n", g);
}

// print_trait_method emits one signature at one indent level: `;`-terminated
// when it was written abstract, else with its default body.
function print_trait_method(m: parser.FuncDecl, f: Fmt): (string, Fmt) {
    var out: string = indent_str(1) + "function " + m.name + print_type_params(m) + "(";
    var i: i32 = 0;
    while (i < m.params.len()) {
        if (i > 0) { out = out + ", "; }
        if (m.params[i].own) { out = out + "own "; }
        out = out + m.params[i].name;
        if (m.params[i].type_name.len() > 0) { out = out + ": " + m.params[i].type_name; }
        i = i + 1;
    }
    out = out + ")";
    if (m.ret_type.len() > 0) { out = out + ": " + m.ret_type; }
    if (m.body.len() == 0) { return (out + ";\n", f); }
    var (body, g) = print_block(m.body, 1, f);
    return (out + " " + body + "\n", g);
}

function print_type_alias(a: parser.TypeAlias): string {
    var out: string = "";
    if (a.is_pub) { out = out + "pub "; }
    out = out + "type " + a.name + " = ";
    var i: i32 = 0;
    while (i < a.variants.len()) {
        if (i > 0) { out = out + " | "; }
        out = out + a.variants[i];
        i = i + 1;
    }
    return out + ";\n";
}

function print_import(im: parser.Import): string {
    // A `pub use "path".{a, b};` re-export is an import record too, and both
    // its spelling and the `as` ALIAS are load-bearing: dropping either leaves
    // every use of the bound name undefined, so it is data loss rather than a
    // style difference.
    if (im.is_reexport) {
        var re: string = "pub use " + quote_string(im.path) + ".{";
        var ri: i32 = 0;
        while (ri < im.reexport_names.len()) {
            if (ri > 0) { re = re + ", "; }
            re = re + im.reexport_names[ri];
            ri = ri + 1;
        }
        return re + "};\n";
    }
    if (im.alias.len() > 0) {
        return "import " + quote_string(im.path) + " as " + im.alias + ";\n";
    }
    return "import " + quote_string(im.path) + ";\n";
}

// decl_sep is the separator before a top-level declaration: native's formatter
// blank-separates every one of them unconditionally, and emits nothing before
// the first (#6762). Imports are the exception — they cluster with no blank
// between them — so they do not go through this.
function decl_sep(out: string): string {
    if (out.len() == 0) { return ""; }
    return "\n";
}

pub function print_module(mod: parser.Module): string {
    return format_module(mod, [], [], [], [], []);
}

// format_module is the `-fmt` entry point: the module, the comments the lexer
// collected beside the tokens (`tokenize_full`), and a per-line blank-line map.
// Passing empty lists for both gives the plain printer, which is what
// print_module is.
//
// Declarations emit in SOURCE ORDER rather than grouped by kind. The comment
// cursor only moves forward, so a kind-grouped emit would drain a comment
// against whichever declaration happened to be printed first and RELOCATE it
// onto an unrelated one — the same reason native's Format orders by position.
pub function format_module(mod: parser.Module, traits: parser.TraitDecl[], impls: parser.ImplDecl[], flines: parser.FieldLines[], comments: lexer.Comment[], blanks: boolean[]): string {
    var f: Fmt = Fmt { comments: comments, ci: 0, blanks: blanks };
    // Chunk-join rather than a left fold: format_module is the whole-FILE
    // accumulator, so `out = out + decl` copies the document once per
    // declaration. `wrote` replaces the `out.len() > 0` probes, which were
    // the only reads of the partial string.
    var chunks: string[] = [];
    var wrote: boolean = false;
    // Imports cluster at the top with no blank between them.
    var ii: i32 = 0;
    while (ii < mod.imports.len()) {
        if (mod.imports[ii].line > 0) {
            var (ilead, fi2) = drain_leading(f, mod.imports[ii].line, 0);
            chunks = chunks.append(ilead); wrote = true;
            f = fi2;
        }
        chunks = chunks.append(print_import(mod.imports[ii])); wrote = true;
        ii = ii + 1;
    }
    // The declarations to emit, as (kind, index) pairs ordered by source line.
    // kind 0 = struct, 1 = enum (at its first variant's position), 2 = alias,
    // 3 = function/const.
    //
    // An enum is desugared into one variant struct per variant, so it is
    // reconstructed at the position its FIRST variant occupies and its
    // remaining variants are skipped — rendering them as bare structs would
    // drop the enum type and leave every annotation naming it dangling. A
    // variant whose owner is not declared here keeps the struct rendering:
    // `module_with_builtins` synthesises Option / Result variant records with
    // an `enum_owner` and no matching EnumDecl.
    var kinds: i32[] = [];
    var idxs: i32[] = [];
    var lines: i32[] = [];
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        var owner: string = mod.structs[i].enum_owner;
        var ei: i32 = 0 - 1;
        if (owner.len() > 0) { ei = enum_index(mod.enums, owner); }
        if (ei < 0) {
            kinds = kinds.append(0); idxs = idxs.append(i); lines = lines.append(mod.structs[i].line);
        } else if (mod.enums[ei].variant_names[0] == mod.structs[i].name) {
            // The EnumDecl carries the source line; its desugared variant
            // records are all stamped 0, which sorts every enum above the
            // first struct in the file.
            kinds = kinds.append(1); idxs = idxs.append(ei); lines = lines.append(mod.enums[ei].line);
        }
        i = i + 1;
    }
    // A variant-less `enum E {}` has no struct record to be positioned by, so
    // nothing above emits it.
    var vi: i32 = 0;
    while (vi < mod.enums.len()) {
        if (mod.enums[vi].variant_names.len() == 0) {
            kinds = kinds.append(1); idxs = idxs.append(vi); lines = lines.append(mod.enums[vi].line);
        }
        vi = vi + 1;
    }
    var ai: i32 = 0;
    while (ai < mod.aliases.len()) {
        kinds = kinds.append(2); idxs = idxs.append(ai); lines = lines.append(mod.aliases[ai].line);
        ai = ai + 1;
    }
    var ti2: i32 = 0;
    while (ti2 < traits.len()) {
        kinds = kinds.append(4); idxs = idxs.append(ti2); lines = lines.append(traits[ti2].line);
        ti2 = ti2 + 1;
    }
    var ipi: i32 = 0;
    while (ipi < impls.len()) {
        kinds = kinds.append(5); idxs = idxs.append(ipi); lines = lines.append(impls[ipi].line);
        ipi = ipi + 1;
    }
    // SOURCE functions only. `@derive` synthesises its methods at PARSE time
    // (synth_derives), so they are in `mod.funcs` by the time the printer runs —
    // printing them expands one attribute into hand-written method bodies, and
    // the next parse then synthesises them again on top. A synthesised decl is
    // the one with no source position: the parser's lines are 1-based, so
    // `line == 0` cannot name anything the user wrote.
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        if (mod.funcs[fi].line > 0) {
            kinds = kinds.append(3); idxs = idxs.append(fi); lines = lines.append(mod.funcs[fi].line);
        }
        fi = fi + 1;
    }
    // Insertion sort by source line — stable, so two declarations sharing a
    // line keep the order they were collected in.
    var si: i32 = 1;
    while (si < lines.len()) {
        var sj: i32 = si;
        while (sj > 0 && lines[sj - 1] > lines[sj]) {
            var tl: i32 = lines[sj - 1]; var tk: i32 = kinds[sj - 1]; var ti: i32 = idxs[sj - 1];
            lines = lines.with(sj - 1, lines[sj]); kinds = kinds.with(sj - 1, kinds[sj]); idxs = idxs.with(sj - 1, idxs[sj]);
            lines = lines.with(sj, tl); kinds = kinds.with(sj, tk); idxs = idxs.with(sj, ti);
            sj = sj - 1;
        }
        si = si + 1;
    }
    var di: i32 = 0;
    while (di < kinds.len()) {
        var dline: i32 = lines[di];
        if (wrote) {
            if (f.blank_before(dline) || di > 0 || mod.imports.len() > 0) { chunks = chunks.append("\n"); wrote = true; }
        }
        if (dline > 0) {
            var (lead, fl) = drain_leading(f, dline, 0);
            chunks = chunks.append(lead); wrote = true;
            f = fl;
        }
        if (kinds[di] == 0) {
            var (stext, sf2) = print_struct_decl(mod.structs[idxs[di]], flines, f);
            chunks = chunks.append(stext); wrote = true;
            f = sf2;
        }
        else if (kinds[di] == 1) {
            var (etext, ef) = print_enum_decl(mod.enums[idxs[di]], mod.structs, flines, f);
            chunks = chunks.append(etext); wrote = true;
            f = ef;
        }
        else if (kinds[di] == 2) { chunks = chunks.append(print_type_alias(mod.aliases[idxs[di]])); wrote = true; }
        else if (kinds[di] == 4) {
            var (ttext, tf) = print_trait_decl(traits[idxs[di]], f);
            chunks = chunks.append(ttext); wrote = true;
            f = tf;
        }
        else if (kinds[di] == 5) {
            var (itext, iff) = print_impl_decl(impls[idxs[di]], f);
            chunks = chunks.append(itext); wrote = true;
            f = iff;
        }
        else {
            if (mod.funcs[idxs[di]].is_const) { chunks = chunks.append(print_const_decl(mod.funcs[idxs[di]])); wrote = true; }
            else {
                var (ftext, ff) = print_func_decl(mod.funcs[idxs[di]], f);
                chunks = chunks.append(ftext); wrote = true;
                f = ff;
            }
        }
        di = di + 1;
    }
    var j: i32 = 0;
    while (j < mod.top_stmts.len()) {
        if (wrote) { chunks = chunks.append("\n"); wrote = true; }
        var (stext, sf) = print_stmt(mod.top_stmts[j], 0, f);
        chunks = chunks.append(stext); wrote = true;
        f = sf;
        j = j + 1;
    }
    // Comments past the last declaration.
    var (tail, _) = drain_all(f, 0);
    chunks = chunks.append(tail);
    return util.str_join_chunks(chunks);
}

// =================== VALIDATION ====================

// Round-trip: parse → print → parse again → assert the same
// shape comes back. Catches printer bugs that would silently
// drop or mangle nodes.
function roundtrip_module(src: string): parser.Module {
    var toks: lexer.Token[] = lexer.tokenize(src);
    var mod: parser.Module = parser.parse_module(toks);
    var emitted: string = print_module(mod);
    var toks2: lexer.Token[] = lexer.tokenize(emitted);
    return parser.parse_module(toks2);
}

function main(): i32 {
    var rc: i32 = check_expressions_and_control_flow();
    if (rc != 0) { return rc; }
    rc = check_string_and_slice_literals();
    if (rc != 0) { return rc; }
    rc = check_structs_and_aliases();
    if (rc != 0) { return rc; }
    rc = check_match_statements();
    if (rc != 0) { return rc; }
    rc = check_annotations_and_receivers();
    if (rc != 0) { return rc; }
    rc = check_imports();
    if (rc != 0) { return rc; }
    rc = check_loops_and_tuples();
    if (rc != 0) { return rc; }
    rc = check_lambdas();
    if (rc != 0) { return rc; }
    rc = check_qualified_names_and_externs();
    if (rc != 0) { return rc; }
    rc = check_declaration_modifiers();
    if (rc != 0) { return rc; }
    rc = check_enums();
    if (rc != 0) { return rc; }
    rc = check_const_and_for_sugar();
    if (rc != 0) { return rc; }
    rc = check_visibility_and_destructuring();
    if (rc != 0) { return rc; }
    rc = check_traits_and_impls();
    if (rc != 0) { return rc; }

    return 0;
}

function check_expressions_and_control_flow(): i32 {
    // Expression printing: ensure the binary-op rendering
    // parenthesises and round-trips. `1 + 2 * 3` parses as
    // `1 + (2*3)` (precedence) and prints as `(1 + (2 * 3))`.
    var toks1: lexer.Token[] = lexer.tokenize("var a = 1 + 2 * 3; return a;");
    var mod1: parser.Module = parser.parse_module(toks1);
    var s1: string = print_module(mod1);
    // Re-parse the emitted text and confirm we still get two
    // top-level stmts with the same shape.
    var rt1: parser.Module = parser.parse_module(lexer.tokenize(s1));
    if (rt1.top_stmts.len() != 2) { return 10; }
    match (rt1.top_stmts[0]) {
        ast.StmtVar(v) => {
            if (v.name != "a") { return 11; }
            match (v.init) {
                ast.ExprBinary(b) => { if (b.op != "+") { return 12; } },
                _ => { return 13; }
            }
        },
        _ => { return 14; }
    }

    // Function decl + call: print + re-parse preserves both
    // functions and the call site shape.
    var src2: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
    var rt2: parser.Module = roundtrip_module(src2);
    if (rt2.funcs.len() != 2) { return 20; }
    if (rt2.funcs[0].name != "add") { return 21; }
    if (rt2.funcs[0].params.len() != 2) { return 22; }
    if (rt2.funcs[0].params[0].type_name != "i32") { return 23; }
    if (rt2.funcs[1].name != "main") { return 24; }

    // If/else with assignment: round-trip the whole thing.
    var src3: string = "var x = 5; if (x < 10) { x = x + 1; } else { x = 0; } return x;";
    var rt3: parser.Module = roundtrip_module(src3);
    if (rt3.top_stmts.len() != 3) { return 30; }
    match (rt3.top_stmts[1]) {
        ast.StmtIf(ifs) => {
            if (ifs.then_body.len() != 1) { return 31; }
            if (ifs.else_body.len() != 1) { return 32; }
        },
        _ => { return 33; }
    }

    // While + array literal + index + len.
    var src4: string = "var a = [3, 5, 7]; var i = 0; var s = 0; while (i < len(a)) { s = s + a[i]; i = i + 1; } return s;";
    var rt4: parser.Module = roundtrip_module(src4);
    if (rt4.top_stmts.len() != 5) { return 40; }
    match (rt4.top_stmts[0]) {
        ast.StmtVar(v) => {
            match (v.init) {
                ast.ExprArray(a) => { if (a.elements.len() != 3) { return 41; } },
                _ => { return 42; }
            }
        },
        _ => { return 43; }
    }
    // While loop preserved with body of length 2.
    match (rt4.top_stmts[3]) {
        ast.StmtWhile(w) => {
            if (w.body.len() != 2) { return 44; }
        },
        _ => { return 45; }
    }

    return 0;
}

function check_string_and_slice_literals(): i32 {
    // String literal escapes round-trip (`"a\"b\n"` → same).
    var src5: string = "var s = \"hello\\nworld\"; return 0;";
    var rt5: parser.Module = roundtrip_module(src5);
    match (rt5.top_stmts[0]) {
        ast.StmtVar(v) => {
            match (v.init) {
                ast.ExprString(_) => { },
                _ => { return 50; }
            }
        },
        _ => { return 51; }
    }

    // Slice round-trip: `s[1:4]` → re-parses as an ExprSlice.
    var src6: string = "var s = \"hello\"; var t = s[1:4]; return 0;";
    var rt6: parser.Module = roundtrip_module(src6);
    match (rt6.top_stmts[1]) {
        ast.StmtVar(v) => {
            match (v.init) {
                ast.ExprSlice(_) => { },
                _ => { return 60; }
            }
        },
        _ => { return 61; }
    }

    return 0;
}

function check_structs_and_aliases(): i32 {
    // Struct decls + struct literals round-trip.
    var src7: string = "struct Point { x: i32, y: i32 } function main(): i32 { var p = Point { x: 3, y: 4 }; return p.x; }";
    var rt7: parser.Module = roundtrip_module(src7);
    if (rt7.structs.len() != 1) { return 70; }
    if (rt7.structs[0].name != "Point") { return 71; }
    if (rt7.structs[0].fields.len() != 2) { return 72; }
    if (rt7.funcs.len() != 1) { return 73; }

    // Type alias round-trip.
    var src8: string = "struct Circle { r: i32 } struct Square { s: i32 } type Shape = Circle | Square; function main(): i32 { return 0; }";
    var rt8: parser.Module = roundtrip_module(src8);
    if (rt8.aliases.len() != 1) { return 80; }
    if (rt8.aliases[0].name != "Shape") { return 81; }
    if (rt8.aliases[0].variants.len() != 2) { return 82; }

    return 0;
}

function check_match_statements(): i32 {
    // Match statement round-trip.
    var src9: string = "var x = 0; match (x) { Foo(f) => { return 1; }, _ => { return 0; } }";
    var rt9: parser.Module = roundtrip_module(src9);
    if (rt9.top_stmts.len() != 2) { return 90; }
    match (rt9.top_stmts[1]) {
        ast.StmtMatch(m) => {
            if (m.arms.len() != 2) { return 91; }
            match (m.arms[0].pattern) {
                ast.PatVariant(pv) => {
                    if (pv.type_name != "Foo") { return 92; }
                    if (pv.binding != "f") { return 93; }
                },
                _ => { return 94; }
            }
        },
        _ => { return 95; }
    }

    return 0;
}

function check_annotations_and_receivers(): i32 {
    // Var type annotation round-trip.
    var srcA: string = "var n: i32 = 7; var sh: Shape = c; return n;";
    var rtA: parser.Module = roundtrip_module(srcA);
    match (rtA.top_stmts[0]) {
        ast.StmtVar(v) => {
            if (v.type_name != "i32") { return 100; }
        },
        _ => { return 101; }
    }
    match (rtA.top_stmts[1]) {
        ast.StmtVar(v) => {
            if (v.type_name != "Shape") { return 102; }
        },
        _ => { return 103; }
    }

    // Receiver method round-trip.
    var srcB: string = "function (p: Par) advance(): Par { return p; } function main(): i32 { return 0; }";
    var rtB: parser.Module = roundtrip_module(srcB);
    if (rtB.funcs.len() != 2) { return 110; }
    if (rtB.funcs[0].name != "advance") { return 111; }
    if (rtB.funcs[0].receiver_name != "p") { return 112; }
    if (rtB.funcs[0].receiver_type != "Par") { return 113; }
    if (rtB.funcs[1].receiver_name != "") { return 114; }

    return 0;
}

function check_imports(): i32 {
    // Import round-trip — multiple imports survive emit + re-
    // parse with the same path list.
    var srcC: string = "import \"./lexer\"; import \"./parser\"; function main(): i32 { return 0; }";
    var rtC: parser.Module = roundtrip_module(srcC);
    if (rtC.imports.len() != 2) { return 120; }
    if (rtC.imports[0].path != "./lexer") { return 121; }
    if (rtC.imports[1].path != "./parser") { return 122; }
    if (rtC.funcs.len() != 1) { return 123; }

    return 0;
}

function check_loops_and_tuples(): i32 {
    // For-in + break / continue + tuple all round-trip.
    var srcD: string = "for n in [1, 2, 3] { if (n == 2) { break; } if (n == 1) { continue; } }";
    var rtD: parser.Module = roundtrip_module(srcD);
    if (rtD.top_stmts.len() != 1) { return 130; }
    match (rtD.top_stmts[0]) {
        ast.StmtFor(f) => {
            if (f.var_name != "n") { return 131; }
            if (f.body.len() != 2) { return 132; }
            match (f.body[0]) {
                ast.StmtIf(ifs) => {
                    match (ifs.then_body[0]) {
                        ast.StmtBreak(_) => { },
                        _ => { return 133; }
                    }
                },
                _ => { return 134; }
            }
            match (f.body[1]) {
                ast.StmtIf(ifs) => {
                    match (ifs.then_body[0]) {
                        ast.StmtContinue(_) => { },
                        _ => { return 135; }
                    }
                },
                _ => { return 136; }
            }
        },
        _ => { return 137; }
    }

    // Tuple round-trip via printer: a bound tuple plus a
    // separate field-access expression survive emit + re-
    // parse with the same shape. Postfix directly on a
    // tuple literal (`(1,2,3).0`) isn't supported yet — the
    // parser's postfix-chain is inside the TokIdent branch.
    var srcE: string = "var t = (10, 20, 30); var x = t.0; return x;";
    var rtE: parser.Module = roundtrip_module(srcE);
    if (rtE.top_stmts.len() != 3) { return 140; }
    match (rtE.top_stmts[0]) {
        ast.StmtVar(v) => {
            match (v.init) {
                ast.ExprTuple(t) => {
                    if (t.elements.len() != 3) { return 141; }
                },
                _ => { return 142; }
            }
        },
        _ => { return 143; }
    }
    match (rtE.top_stmts[1]) {
        ast.StmtVar(v) => {
            match (v.init) {
                ast.ExprFieldAccess(fa) => {
                    if (fa.field != "0") { return 144; }
                },
                _ => { return 145; }
            }
        },
        _ => { return 146; }
    }

    return 0;
}

function check_lambdas(): i32 {
    // Lambda round-trip: `var f = (x: i32): i32 => { return
    // x + 1; }; return f(41);` — print should emit a re-parseable
    // annotated arrow lambda, `(x: i32): i32 => x + 1`.
    var srcF: string = "function main(): i32 { var f = (x: i32): i32 => { return x + 1; }; return f(41); }";
    var rtF: parser.Module = roundtrip_module(srcF);
    if (rtF.funcs.len() != 1) { return 150; }
    if (rtF.funcs[0].body.len() != 2) { return 151; }
    match (rtF.funcs[0].body[0]) {
        ast.StmtVar(v) => {
            if (v.name != "f") { return 152; }
            match (v.init) {
                ast.ExprLambda(lm) => {
                    if (lm.params.len() != 1) { return 153; }
                    if (lm.params[0].name != "x") { return 154; }
                    if (lm.params[0].type_name != "i32") { return 155; }
                    if (lm.ret_type != "i32") { return 156; }
                    if (lm.body.len() != 1) { return 157; }
                },
                _ => { return 158; }
            }
        },
        _ => { return 159; }
    }

    // IIFE round-trip: `(): i32 => { return 7; }()` — printer
    // parenthesises the callee, `((): i32 => 7)()`, and the re-parse
    // sees an ExprCall whose callee is an ExprLambda.
    var srcG: string = "function main(): i32 { return (): i32 => { return 7; }(); }";
    var rtG: parser.Module = roundtrip_module(srcG);
    match (rtG.funcs[0].body[0]) {
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprCall(cc) => {
                    match (cc.callee) {
                        ast.ExprLambda(_) => { },
                        _ => { return 161; }
                    }
                },
                _ => { return 162; }
            }
        },
        _ => { return 163; }
    }

    // #8706 / #8717: an arrow lambda's return annotation is followed by the
    // lambda's own `=>`, so the type parser reserves the top-level
    // function-type arrow there. A parenthesised annotation is a tuple, and a
    // function-typed return has to be reprinted with its grouping parens —
    // bare, `(p: i32): (i32) => i32 => …` re-parses with the wrong split.
    var srcR: string = "function main(): i32 { var g = (): (string, i32) => { return (\"ab\", 7); }; var h = (p: i32): (i32) => i32 => (q: i32) => p + q; return 0; }";
    var pfR: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(srcR));
    var outR: string = format_module(pfR.pmod, pfR.ptraits, pfR.pimpls, pfR.pflines, [], []);
    if (!util.contains(outR, "var g = (): (string, i32) => (\"ab\", 7);")) { return 371; }
    if (!util.contains(outR, "var h = (p: i32): ((i32) => i32) => (q: i32) => p + q;")) { return 372; }
    // The parens the reprint added are grouping, so a second pass adds no more.
    var pfR2: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(outR));
    if (format_module(pfR2.pmod, pfR2.ptraits, pfR2.pimpls, pfR2.pflines, [], []) != outR) { return 373; }
    match (pfR2.pmod.funcs[0].body[0]) {
        ast.StmtVar(vr) => {
            match (vr.init) {
                ast.ExprLambda(lr) => {
                    if (lr.ret_type != "(string, i32)") { return 374; }
                },
                _ => { return 375; }
            }
        },
        _ => { return 376; }
    }

    return 0;
}

function check_qualified_names_and_externs(): i32 {
    // Qualified-name call round-trip: `parser.parse_module(x)`.
    // The printer emits ExprFieldAccess as `obj.field` and ExprCall
    // wraps it the same way, so the re-parse should preserve the
    // ExprCall(ExprFieldAccess(ExprIdent), field) shape.
    var srcH: string = "function main(): i32 { return parser.parse_module(42); }";
    var rtH: parser.Module = roundtrip_module(srcH);
    match (rtH.funcs[0].body[0]) {
        ast.StmtReturn(r) => {
            match (r.value) {
                ast.ExprCall(cc) => {
                    match (cc.callee) {
                        ast.ExprFieldAccess(fa) => {
                            if (fa.field != "parse_module") { return 171; }
                            match (fa.obj) {
                                ast.ExprIdent(id) => {
                                    if (id.name != "parser") { return 172; }
                                },
                                _ => { return 173; }
                            }
                        },
                        _ => { return 174; }
                    }
                },
                _ => { return 175; }
            }
        },
        _ => { return 176; }
    }

    // @import extern declaration round-trip (P4 — docs/WIT-BRING-YOUR-OWN.md):
    // a body-less function bound by `@import("iface", "wit")` survives parse →
    // print → re-parse with both binding strings intact and an empty body.
    var srcI: string = "@import(\"wasi:random/random@0.2.0\", \"get-random-u64\")\nfunction random_u64(): u64; function main(): i32 { return 0; }";
    var modI: parser.Module = parser.parse_module(lexer.tokenize(srcI));
    if (modI.funcs.len() != 2) { return 180; }
    if (modI.funcs[0].name != "random_u64") { return 181; }
    if (modI.funcs[0].import_iface != "wasi:random/random@0.2.0") { return 182; }
    if (modI.funcs[0].import_wit != "get-random-u64") { return 183; }
    if (modI.funcs[0].body.len() != 0) { return 184; }
    // Ordinary functions carry empty binding strings.
    if (modI.funcs[1].import_iface.len() != 0) { return 185; }
    var rtI: parser.Module = roundtrip_module(srcI);
    if (rtI.funcs.len() != 2) { return 186; }
    if (rtI.funcs[0].import_iface != "wasi:random/random@0.2.0") { return 187; }
    if (rtI.funcs[0].import_wit != "get-random-u64") { return 188; }
    if (rtI.funcs[0].body.len() != 0) { return 189; }

    return 0;
}

function check_declaration_modifiers(): i32 {
    // Declaration MODIFIERS survive the round trip (#6660). Each of these
    // changes what the program MEANS, so a printer that drops one makes
    // formatting a semantics change rather than a layout one: `fip` selects the
    // E053 no-allocation walk, `@must_consume` arms E067, and `@derive` names
    // the methods the next parse synthesises.
    //
    // Every assertion reads the FIELD back, never just the name — a dropped bit
    // round-trips through a name-and-arity check without complaint, which is
    // exactly how this went unnoticed.
    var srcM: string = "fip function pure_add(a: i32, b: i32): i32 { return a + b; } function main(): i32 { return pure_add(1, 2); }";
    var rtM: parser.Module = roundtrip_module(srcM);
    if (rtM.funcs.len() != 2) { return 190; }
    if (rtM.funcs[0].name != "pure_add") { return 191; }
    if (!rtM.funcs[0].fip) { return 192; }
    if (rtM.funcs[0].fbip || rtM.funcs[0].fip_allowance != 0) { return 164; }
    // The non-fip sibling must NOT pick the modifier up.
    if (rtM.funcs[1].fip) { return 193; }

    // `fbip` and the graded `(n)` are separate bits, and each changes what the
    // IR's E068 budget check permits — a printer that normalised either into a
    // plain `fip` would turn a legal body into an E053 rejection on reparse.
    var srcFB: string = "fbip function keep(a: i32): i32 { return a; } function main(): i32 { return keep(1); }";
    var rtFB: parser.Module = roundtrip_module(srcFB);
    if (rtFB.funcs.len() != 2) { return 165; }
    if (!rtFB.funcs[0].fbip || rtFB.funcs[0].fip) { return 166; }
    if (rtFB.funcs[0].fip_allowance != 0) { return 167; }

    var srcFG: string = "fbip(2) function graded(a: i32): i32 { return a; } fip(1) function g1(a: i32): i32 { return a; } function main(): i32 { return graded(1) + g1(2); }";
    var rtFG: parser.Module = roundtrip_module(srcFG);
    if (rtFG.funcs.len() != 3) { return 168; }
    if (!rtFG.funcs[0].fbip || rtFG.funcs[0].fip_allowance != 2) { return 169; }
    if (!rtFG.funcs[1].fip || rtFG.funcs[1].fbip || rtFG.funcs[1].fip_allowance != 1) { return 170; }

    var srcMC: string = "@must_consume\nstruct Res { code: i32 } function main(): i32 { var r: Res = Res { code: 7 }; return r.code; }";
    var rtMC: parser.Module = roundtrip_module(srcMC);
    if (rtMC.structs.len() != 1) { return 194; }
    if (!rtMC.structs[0].must_consume) { return 195; }

    // `@derive` must survive as the ATTRIBUTE. The methods it names are
    // synthesised at parse time, so a printer that emits them instead expands
    // one attribute into hand-written bodies — and the re-parse then synthesises
    // them again on top, which is what the function count catches.
    var srcDrv: string = "@derive(Eq)\nstruct Pt { x: i32 } function main(): i32 { var p: Pt = Pt { x: 1 }; return p.x; }";
    var modDrv: parser.Module = parser.parse_module(lexer.tokenize(srcDrv));
    var rtDrv: parser.Module = roundtrip_module(srcDrv);
    if (rtDrv.structs.len() != 1) { return 196; }
    if (rtDrv.structs[0].derives.len() != 1) { return 197; }
    if (rtDrv.structs[0].derives[0] != "Eq") { return 198; }
    if (rtDrv.funcs.len() != modDrv.funcs.len()) { return 199; }

    // `async` is the same class of modifier (#6631): it selects the Preview-3
    // `canon lift async` export surface, so dropping it changes what a
    // `-target wasm32-wasi -emit core-module` build exports. The bit has to survive BOTH the parse
    // and the print — the AST-rewrite passes each rebuild a FuncDecl field by
    // field, so a copy site that hardcodes `async: false` drops it downstream
    // of a parse that reported it set, which only the round trip catches.
    var srcJ: string = "async function work(): i32 { return 7; } function main(): i32 { return work(); }";
    var modJ: parser.Module = parser.parse_module(lexer.tokenize(srcJ));
    if (modJ.funcs.len() != 2) { return 200; }
    if (!modJ.funcs[0].async) { return 201; }
    if (modJ.funcs[1].async) { return 202; }
    var rtJ: parser.Module = roundtrip_module(srcJ);
    if (rtJ.funcs.len() != 2) { return 203; }
    if (!rtJ.funcs[0].async) { return 204; }
    if (rtJ.funcs[1].async) { return 205; }
    // `pub async function` — `pub` is stripped by the parser and stays dropped
    // (#6633); the `async` bit behind it must still survive.
    var rtK: parser.Module = roundtrip_module("pub async function w(): i32 { return 1; }");
    if (rtK.funcs.len() != 1) { return 206; }
    if (!rtK.funcs[0].async) { return 207; }
    // Contextual only: `async` followed by anything else stays an ordinary
    // identifier, and no function is marked.
    var rtL: parser.Module = roundtrip_module("function main(): i32 { var async: i32 = 3; return async + 4; }");
    if (rtL.funcs.len() != 1) { return 208; }
    if (rtL.funcs[0].async) { return 209; }

    return 0;
}

function check_enums(): i32 {
    // An enum must survive as an ENUM. The parser desugars it into one struct
    // per variant, so a printer with no enum arm renders those structs and the
    // type itself disappears — output that no longer compiles, because the
    // annotations naming it are still there. Every assertion below reads back
    // through `enum_owner` rather than the variant names, since the variants
    // come back under their own names either way.
    var srcEnum: string = "@derive(Eq)\nenum Color { Red, Green(i32) } function main(): i32 { var c: Color = Red; return 0; }";
    var modEnum: parser.Module = parser.parse_module(lexer.tokenize(srcEnum));
    var rtEnum: parser.Module = roundtrip_module(srcEnum);
    if (rtEnum.enums.len() != 1) { return 210; }
    if (rtEnum.enums[0].name != "Color") { return 211; }
    if (rtEnum.enums[0].variant_names.len() != 2) { return 212; }
    if (rtEnum.enums[0].variant_names[0] != "Red") { return 213; }
    if (rtEnum.enums[0].variant_names[1] != "Green") { return 214; }
    var rgi: i32 = variant_decl_index(rtEnum.structs, "Color", "Green");
    if (rgi < 0) { return 215; }
    if (rtEnum.structs[rgi].fields.len() != 1) { return 216; }
    if (rtEnum.structs[rgi].fields[0].type_name != "i32") { return 217; }
    // …and the payload-less variant must not acquire one.
    var rri: i32 = variant_decl_index(rtEnum.structs, "Color", "Red");
    if (rri < 0) { return 218; }
    if (rtEnum.structs[rri].fields.len() != 0) { return 219; }
    // No variant may come back as a free-standing struct.
    var esi: i32 = 0;
    while (esi < rtEnum.structs.len()) {
        if (rtEnum.structs[esi].enum_owner.len() == 0) { return 220; }
        esi = esi + 1;
    }
    // `@derive` once on the enum, not once per variant: the re-parse
    // synthesises the same method set the first parse did.
    if (rtEnum.structs[rgi].derives.len() != 1) { return 221; }
    if (rtEnum.structs[rgi].derives[0] != "Eq") { return 222; }
    if (rtEnum.funcs.len() != modEnum.funcs.len()) { return 223; }

    // Generic parameters and `@must_consume` live on the EnumDecl, not on the
    // variant records, so they travel a different route out of the printer.
    var srcEG: string = "@must_consume\nenum Slot[T] { Full(T), Empty } function main(): i32 { return 0; }";
    var rtEG: parser.Module = roundtrip_module(srcEG);
    if (rtEG.enums.len() != 1) { return 224; }
    if (!rtEG.enums[0].must_consume) { return 225; }
    if (rtEG.enums[0].type_params.len() != 1) { return 226; }
    if (rtEG.enums[0].type_params[0] != "T") { return 227; }
    var fgi: i32 = variant_decl_index(rtEG.structs, "Slot", "Full");
    if (fgi < 0) { return 228; }
    if (rtEG.structs[fgi].fields[0].type_name != "T") { return 229; }

    // A multi-payload variant keeps every payload, in order.
    var srcEM: string = "enum Pair { Two(i32, string), Neither } function main(): i32 { return 0; }";
    var rtEM: parser.Module = roundtrip_module(srcEM);
    var tpi: i32 = variant_decl_index(rtEM.structs, "Pair", "Two");
    if (tpi < 0) { return 230; }
    if (rtEM.structs[tpi].fields.len() != 2) { return 231; }
    if (rtEM.structs[tpi].fields[0].type_name != "i32") { return 232; }
    if (rtEM.structs[tpi].fields[1].type_name != "string") { return 233; }

    // A record-form variant round-trips with its field NAMES — printed
    // positionally the re-parse would lose them and the `{ w, h }` patterns
    // that destructure it would stop resolving.
    var srcER: string = "enum Shape { Rect { w: i32, h: string }, Unit } function main(): i32 { return 0; }";
    var rtER: parser.Module = roundtrip_module(srcER);
    var rcvi: i32 = variant_decl_index(rtER.structs, "Shape", "Rect");
    if (rcvi < 0) { return 234; }
    if (rtER.structs[rcvi].variant_field_names.len() != 2) { return 235; }
    if (rtER.structs[rcvi].variant_field_names[0] != "w") { return 236; }
    if (rtER.structs[rcvi].variant_field_names[1] != "h") { return 237; }
    if (rtER.structs[rcvi].fields.len() != 2) { return 238; }
    if (rtER.structs[rcvi].fields[0].name != "__ev") { return 239; }
    if (rtER.structs[rcvi].fields[1].name != "__ev1") { return 240; }
    if (rtER.structs[rcvi].fields[1].type_name != "string") { return 241; }
    var uri: i32 = variant_decl_index(rtER.structs, "Shape", "Unit");
    if (uri < 0) { return 242; }
    if (rtER.structs[uri].variant_field_names.len() != 0) { return 243; }

    // Every payload binding of a match arm survives the round-trip: printing
    // only the first turns `Pair(a, b)` into an E015 one-binding pattern.
    var srcPB: string = "enum Pair { Two(i32, i32) } function f(p: Pair): i32 { match (p) { Two(a, b) => { return a + b; }, } return 0; } function main(): i32 { return 0; }";
    var rtPB: parser.Module = roundtrip_module(srcPB);
    if (rtPB.funcs.len() < 1) { return 244; }
    match (rtPB.funcs[0].body[0]) {
        ast.StmtMatch(m) => {
            match (m.arms[0].pattern) {
                ast.PatVariant(pv) => {
                    if (pv.binding != "a") { return 245; }
                    if (pv.extra_bindings.len() != 1) { return 246; }
                    if (pv.extra_bindings[0] != "b") { return 247; }
                },
                _ => { return 248; }
            }
        },
        _ => { return 249; }
    }

    return 0;
}

function check_const_and_for_sugar(): i32 {
    // A `const` desugars to a zero-arg FuncDecl. It was dropped outright,
    // because the synthesised-decl filter keys on `line == 0` and the desugar
    // left the position there — so the declaration vanished while every
    // reference to it survived.
    //
    // The assertions read `is_const` back, not just the name: printing the
    // desugar as `function LIMIT(): i32 { return 41; }` also makes the name
    // resolve, and the self-host even compiles it, but NATIVE rejects that
    // form — it has no rule making a bare zero-arg-function reference a call.
    // Losing the marker is therefore a silent rewrite into something only one
    // compiler accepts, which a name-and-arity check would not catch.
    var srcConst: string = "const LIMIT: i32 = 41; function main(): i32 { return LIMIT + 1; }";
    var rtConst: parser.Module = roundtrip_module(srcConst);
    if (rtConst.funcs.len() != 2) { return 250; }
    var limit_i: i32 = 0 - 1;
    var ci: i32 = 0;
    while (ci < rtConst.funcs.len()) {
        if (rtConst.funcs[ci].name == "LIMIT") { limit_i = ci; }
        ci = ci + 1;
    }
    if (limit_i < 0) { return 251; }
    if (!rtConst.funcs[limit_i].is_const) { return 252; }
    if (rtConst.funcs[limit_i].ret_type != "i32") { return 253; }
    // …and an ordinary zero-arg function, whose AST shape is identical, must
    // NOT come back marked — that is what stops the printer guessing by shape.
    var rtFn: parser.Module = roundtrip_module("function LIMIT(): i32 { return 41; }");
    if (rtFn.funcs.len() != 1) { return 254; }
    if (rtFn.funcs[0].is_const) { return 255; }

    // Every `for` reprints as the sugar the source wrote, not as the desugar
    // it parses to (#6771). Round-tripping is not enough to see this: the
    // expansion re-parses to itself, so the assertions read the emitted TEXT
    // and reject the synthesised names — `__forc_<line>_<col>` bakes the
    // loop's position into the program, so the same loop one line down would
    // otherwise reformat to different source.
    var srcCFor: string = "function main(): i32 { var s: i32 = 0; for (var i: i32 = 0; i < 3; i = i + 1) { s = s + i; } return s; }";
    var outCFor: string = print_module(parser.parse_module(lexer.tokenize(srcCFor)));
    if (!util.contains(outCFor, "for (var i: i32 = 0; i < 3; i = i + 1) {")) { return 260; }
    if (util.contains(outCFor, "__forc_")) { return 261; }
    // …and it still re-parses to the same desugar, so the loop the compiler
    // sees is unchanged.
    var rtCFor: parser.Module = roundtrip_module(srcCFor);
    if (rtCFor.funcs.len() != 1) { return 262; }
    match (rtCFor.funcs[0].body[1]) {
        ast.StmtIf(cf) => { if (!as_c_for(cf).ok) { return 263; } },
        _ => { return 264; }
    }

    // An omitted INIT / STEP keeps the header's arity.
    var outBare: string = print_module(parser.parse_module(lexer.tokenize(
        "function main(): i32 { var i: i32 = 0; for (; i < 3; ) { i = i + 1; } return i; }")));
    if (!util.contains(outBare, "for (; i < 3; ) {")) { return 265; }

    // The range forms are carried as a synthetic `__range` / `__range_incl`
    // call, which is a parser-internal name no source may spell.
    var outRange: string = print_module(parser.parse_module(lexer.tokenize(
        "function main(): i32 { var t: i32 = 0; for i in 0..4 { t = t + i; } for j in 0..=4 { t = t + j; } return t; }")));
    if (!util.contains(outRange, "for i in 0..4 {")) { return 266; }
    if (!util.contains(outRange, "for j in 0..=4 {")) { return 267; }
    if (util.contains(outRange, "__range")) { return 268; }

    // The map form stores its two binders comma-joined in the one field;
    // reprinting that bare gives `for k,v in m`, which does not parse.
    var outMap: string = print_module(parser.parse_module(lexer.tokenize(
        "function main(m: map[string, i32]): i32 { var t: i32 = 0; for (k, v) in m { t = t + v; } return t; }")));
    if (!util.contains(outMap, "for (k, v) in m {")) { return 269; }

    // A label and the break / continue naming it are one fact written twice.
    var srcLabels: string = "function main(): i32 { var t: i32 = 0; outer: while (t < 10) { inner: for (var i: i32 = 0; i < 3; i = i + 1) { if (i == 2) { continue outer; } break inner; } t = t + 1; } return t; }";
    var outLabels: string = print_module(parser.parse_module(lexer.tokenize(srcLabels)));
    if (!util.contains(outLabels, "outer: while (t < 10) {")) { return 270; }
    if (!util.contains(outLabels, "inner: for (var i: i32 = 0; i < 3; i = i + 1) {")) { return 271; }
    if (!util.contains(outLabels, "continue outer;")) { return 272; }
    if (!util.contains(outLabels, "break inner;")) { return 273; }

    return 0;
}

function check_visibility_and_destructuring(): i32 {
    // #6773: `pub` on a struct / enum / alias. Printed from is_pub, which
    // already recorded the written keyword — nothing read it, so a formatted
    // library file kept its function exports and lost every type export.
    var srcVis: string = "pub struct A { x: i32 } struct B { y: i32 } pub enum C { P } enum D { Q } pub type E = A | B; type F = A | B; function main(): i32 { return 0; }";
    var rtVis: parser.Module = roundtrip_module(srcVis);
    if (!rtVis.structs[struct_index(rtVis.structs, "A")].is_pub) { return 280; }
    if (rtVis.structs[struct_index(rtVis.structs, "B")].is_pub) { return 281; }
    if (!rtVis.enums[enum_index(rtVis.enums, "C")].is_pub) { return 282; }
    if (rtVis.enums[enum_index(rtVis.enums, "D")].is_pub) { return 283; }
    if (rtVis.aliases.len() != 2) { return 284; }
    if (!rtVis.aliases[0].is_pub) { return 285; }
    if (rtVis.aliases[1].is_pub) { return 286; }

    // #6773: both destructuring forms. Printed as a plain `var` the tuple one
    // emitted `var a,b = …`, which is not syntax the parser accepts back — so
    // the re-parse is the assertion.
    var srcTd: string = "function pair(): (i32, i32) { return (1, 2); } function main(): i32 { let (a, b) = pair(); return a + b; }";
    var rtTd: parser.Module = roundtrip_module(srcTd);
    var mti: i32 = func_index(rtTd.funcs, "main");
    if (mti < 0) { return 287; }
    if (rtTd.funcs[mti].body.len() != 2) { return 288; }
    match (rtTd.funcs[mti].body[0]) {
        ast.StmtVar(v) => {
            if (v.name != "a,b") { return 289; }
            if (v.type_name.len() != 0) { return 290; }
        },
        _ => { return 291; }
    }
    // The struct form keeps the type it destructures and each field's binding,
    // including a field renamed on binding (`y: bb`).
    var srcSd: string = "struct P { x: i32, y: i32 } function main(): i32 { let P { x, y: bb } = P { x: 1, y: 2 }; return x + bb; }";
    var rtSd: parser.Module = roundtrip_module(srcSd);
    var msi: i32 = func_index(rtSd.funcs, "main");
    if (msi < 0) { return 292; }
    match (rtSd.funcs[msi].body[0]) {
        ast.StmtVar(v) => {
            if (v.name != "x,bb") { return 293; }
            if (v.type_name != "@sd:P:x,y") { return 294; }
        },
        _ => { return 295; }
    }

    // #6773: a METHOD's type parameters written before its receiver parse
    // too; the printer writes them after the name, and both spellings carry
    // the same declaration.
    var srcMt: string = "enum Opt[T] { Some(T), None } pub function [U] (o: Opt[T]) map(f: (T) => U): Opt[U] { return None; } function main(): i32 { return 0; }";
    var rtMt: parser.Module = roundtrip_module(srcMt);
    var mmi: i32 = func_index(rtMt.funcs, "map");
    if (mmi < 0) { return 296; }
    if (rtMt.funcs[mmi].receiver_name != "o") { return 297; }
    if (rtMt.funcs[mmi].type_param_count != 1) { return 298; }

    return 0;
}

function check_traits_and_impls(): i32 {
    // #6773 item 3: a `trait` block reaches the printer only through the two
    // DERIVED views the compile path keeps, so it has to be retained beside the
    // Module. The re-parse is the assertion: an emitted trait that does not
    // come back is a declaration the reformat deleted.
    var srcTr: string = "pub trait Greet[T]: Display { function hi(self: Self, x: T): string; function loud(self: Self, x: T): string { return self.hi(x); } } function main(): i32 { return 0; }";
    var pfTr: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(srcTr));
    var outTr: string = format_module(pfTr.pmod, pfTr.ptraits, pfTr.pimpls, pfTr.pflines, [], []);
    var rtTr: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(outTr));
    if (rtTr.ptraits.len() != 1) { return 299; }
    if (rtTr.ptraits[0].name != "Greet") { return 300; }
    if (!rtTr.ptraits[0].is_pub) { return 301; }
    if (rtTr.ptraits[0].type_params.len() != 1) { return 302; }
    if (rtTr.ptraits[0].type_params[0] != "T") { return 303; }
    if (rtTr.ptraits[0].supertraits.len() != 1) { return 304; }
    if (rtTr.ptraits[0].supertraits[0] != "Display") { return 305; }
    // Both methods, in source order, with the abstract / default split intact.
    if (rtTr.ptraits[0].methods.len() != 2) { return 306; }
    if (rtTr.ptraits[0].methods[0].name != "hi") { return 307; }
    if (rtTr.ptraits[0].methods[0].body.len() != 0) { return 308; }
    if (rtTr.ptraits[0].methods[1].name != "loud") { return 309; }
    if (rtTr.ptraits[0].methods[1].body.len() == 0) { return 310; }
    // A qualified supertrait keeps its module prefix — printed bare it names a
    // trait that may not be in scope.
    var pfQ: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
        "import \"core/cmp\"; pub trait Sortable: cmp.Ord {} function main(): i32 { return 0; }"));
    if (pfQ.ptraits.len() != 1) { return 311; }
    if (pfQ.ptraits[0].supertraits.len() != 1) { return 312; }
    if (pfQ.ptraits[0].supertraits[0] != "cmp.Ord") { return 313; }
    if (!util.contains(format_module(pfQ.pmod, pfQ.ptraits, pfQ.pimpls, pfQ.pflines, [], []), "pub trait Sortable: cmp.Ord {}")) { return 314; }

    // #6783: an `impl` block is desugared into free-standing receiver methods on
    // the way in, so the block has to be retained beside the Module too. Under
    // the formatter's parse its methods live on the ImplDecl ALONE — leaving
    // them on Module.funcs as well would print each one twice.
    var srcIm: string = "trait Display { function to_string(self: Self): string; } impl Display for i32 {} impl Display for boolean { function to_string(self: Self): string { return \"t\"; } } function main(): i32 { return 0; }";
    var pfIm: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(srcIm));
    if (pfIm.pimpls.len() != 2) { return 315; }
    if (pfIm.pimpls[0].trait_ref != "Display") { return 316; }
    if (pfIm.pimpls[0].type_ref != "i32") { return 317; }
    if (pfIm.pimpls[0].methods.len() != 0) { return 318; }
    if (pfIm.pimpls[1].methods.len() != 1) { return 319; }
    // The written method is NOT also a free function, or it would print twice.
    if (func_index(pfIm.pmod.funcs, "to_string") >= 0) { return 320; }
    var outIm: string = format_module(pfIm.pmod, pfIm.ptraits, pfIm.pimpls, pfIm.pflines, [], []);
    if (!util.contains(outIm, "impl Display for i32 {}")) { return 321; }
    // `Self` reads as the concrete type and the receiver goes back to being the
    // first parameter — the shape an impl block requires, and what native emits.
    if (!util.contains(outIm, "function to_string(self: boolean): string {")) { return 322; }
    var rtIm: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(outIm));
    if (rtIm.pimpls.len() != 2) { return 323; }

    // An inherent `impl Type { … }` has no trait, and an associated function
    // (no `self`) keeps its parameter list exactly as written.
    var pfIn: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
        "struct Box { item: i32 } impl Box { function zero(): Box { return Box { item: 0 }; } } function main(): i32 { return 0; }"));
    if (pfIn.pimpls.len() != 1) { return 324; }
    if (pfIn.pimpls[0].trait_ref.len() != 0) { return 325; }
    if (!util.contains(format_module(pfIn.pmod, pfIn.ptraits, pfIn.pimpls, pfIn.pflines, [], []), "impl Box {")) { return 326; }
    if (!util.contains(format_module(pfIn.pmod, pfIn.ptraits, pfIn.pimpls, pfIn.pflines, [], []), "function zero(): Box {")) { return 327; }

    // A parametric impl states its bounds once, on the block: restating them on
    // each method is a program native rejects outright.
    var pfPa: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
        "import \"core/cmp\"; struct Box[T] { item: T } impl[T: cmp.Eq] cmp.Eq for Box[T] { function eq(self: Self, other: Self): boolean { return true; } } function main(): i32 { return 0; }"));
    if (pfPa.pimpls.len() != 1) { return 328; }
    var outPa: string = format_module(pfPa.pmod, pfPa.ptraits, pfPa.pimpls, pfPa.pflines, [], []);
    if (!util.contains(outPa, "impl[T: cmp.Eq] cmp.Eq for Box[T] {")) { return 329; }
    if (!util.contains(outPa, "function eq(self: Box[T], other: Box[T]): boolean {")) { return 330; }

    // A float literal too large for f64 is rejected by the compile parse
    // (#6842) — but a reformat must return the text it was handed, so the
    // verbatim parse keeps the literal and the printer writes it back
    // unchanged. Printing the rejection instead loses the program's number.
    var pfOor: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
        "function main(): i32 { var x: f64 = 1e309; return 0; }"));
    var outOor: string = format_module(pfOor.pmod, pfOor.ptraits, pfOor.pimpls, pfOor.pflines, [], []);
    if (!util.contains(outOor, "var x: f64 = 1e309;")) { return 331; }

    // Multibyte string content must pass through the byte-level escape
    // rebuilds byte-exact (no per-byte slicing of split code points).
    if (quote_string("héllo\nwörld") != "\"héllo\\nwörld\"") { return 340; }
    if (escape_fstring_lit("pré{x}é") != "pré{{x}}é") { return 341; }

    // A control byte re-emits as `\xNN` rather than raw, so the formatted
    // source stays text and scan_string reads the same byte back. `\0` takes
    // the hex form too — native's printer has no `\0` arm either.
    if (quote_string("a\x00b\x1fc\x7fd") != "\"a\\x00b\\x1fc\\x7fd\"") { return 342; }
    if (escape_fstring_lit("a\x00b") != "a\\x00b") { return 343; }
    // And survive a full format → re-lex round-trip: the verbatim parse
    // keeps the f-string form, so its literal parts go through
    // escape_fstring_lit.
    var srcMb: string = "function main(): i32 { var s: string = \"héllo\"; var f: string = f\"pré {s}\"; return 0; }";
    var pfMb: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(srcMb));
    var outMb: string = format_module(pfMb.pmod, pfMb.ptraits, pfMb.pimpls, pfMb.pflines, [], []);
    var rtMb: parser.Module = parser.parse_module(lexer.tokenize(outMb));
    if (rtMb.funcs.len() != 1) { return 342; }
    if (!util.contains(outMb, "\"héllo\"")) { return 343; }
    if (!util.contains(outMb, "f\"pré {s}\"")) { return 344; }
    // diff_split_lines byte-scans for '\n'; multibyte lines split intact.
    var dl: string[] = diff_split_lines("é\nü");
    if (dl.len() != 2) { return 345; }
    if (dl[0] != "é\n" || dl[1] != "ü") { return 346; }

    // The linear-space alignment (#8611): the properties the byte-parity gates
    // against native cannot state, since a shortest edit script is not unique.
    var dcode: i32 = diff_selftest();
    if (dcode != 0) { return dcode; }

    return 0;
}

// struct_index / func_index locate a declaration by name for the assertions
// above, which cannot rely on declaration order surviving the round-trip.
function struct_index(structs: parser.StructDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name && structs[i].enum_owner.len() == 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function func_index(funcs: parser.FuncDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// Unified-diff half of `-fmt -d`. The two drivers' `-d` output is compared
// byte-for-byte, so the alignment, the tie-breaks and the three-line context
// window here are internal/printer/diff.go's rather than a re-derivation.

// diff_split_lines breaks s on '\n' with the newline kept on each line, so the
// hunk emitter reproduces a "no newline at end of file" tail verbatim. The
// phantom empty entry a trailing '\n' would produce is dropped.
function diff_split_lines(s: string): string[] {
    var out: string[] = [];
    if (s.len() == 0) { return out; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i] == b'\n') {
            out = out.append(slice_unchecked(s, start, i + 1));
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < s.len()) { out = out.append(slice_unchecked(s, start, s.len())); }
    return out;
}

// DiffScript is the edit script as two parallel arrays: `kinds[i]` is 0 for a
// line both sides share, 1 for one only `a` has, 2 for one only `b` has.
struct DiffScript { kinds: i32[], lines: string[] }

// diff_max_search_cost caps how far the middle-snake search looks for its two
// halves to meet before giving up on minimality and splitting at the
// furthest-reaching diagonal instead. The halves meet after about D/2 rounds
// each, so edit distances up to twice the cap come out minimal; past that the
// script is still correct, just not guaranteed shortest.
function diff_max_search_cost(): i32 { return 16384; }

// DiffIds is the two line lists with each distinct line replaced by a small
// integer, plus how many distinct lines there were. The snake loops compare
// ints rather than strings, and `distinct` sizes the occurrence flags.
struct DiffIds { ia: i32[], ib: i32[], distinct: i32 }

// diff_intern numbers the lines of both sides in order of first appearance.
function diff_intern(a: string[], b: string[]): DiffIds {
    var ids: Map[string, i32] = map_new(a.len() + b.len() + 1);
    var ia: i32[] = [];
    var ib: i32[] = [];
    var next: i32 = 0;
    var i: i32 = 0;
    while (i < a.len()) {
        var ida: i32 = ids.get_or(a[i], 0 - 1);
        if (ida < 0) {
            ida = next;
            ids = ids.insert(a[i], ida);
            next = next + 1;
        }
        ia = ia.append(ida);
        i = i + 1;
    }
    var j: i32 = 0;
    while (j < b.len()) {
        var idb: i32 = ids.get_or(b[j], 0 - 1);
        if (idb < 0) {
            idb = next;
            ids = ids.insert(b[j], idb);
            next = next + 1;
        }
        ib = ib.append(idb);
        j = j + 1;
    }
    return DiffIds { ia: ia, ib: ib, distinct: next };
}

// diff_furthest picks the split point for a subproblem whose edit distance
// exceeded the cost cap. The forward search's best point is the one that
// consumed most of both inputs from the front and the reverse search's is the
// one that consumed most from the back, so the two are scored on their own
// progress and the deeper one wins. Progress is at least the budget either
// way, so the recursion terminates.
function diff_furthest(vf: i32[], vr: i32[], off: i32, size: i32, alo: i32, ahi: i32, blo: i32, bhi: i32): (i32, i32) {
    var na: i32 = ahi - alo;
    var nb: i32 = bhi - blo;
    var best_f: i32 = 0;
    var fx: i32 = 0;
    var fy: i32 = 0;
    var best_r: i32 = 0;
    var rx: i32 = 0;
    var ry: i32 = 0;
    var o: i32 = 0;
    while (o < size) {
        var j: i32 = o - off;
        var xf: i32 = vf[o];
        if (xf >= 0) {
            var yf: i32 = xf - j;
            if (xf <= na && yf >= 0 && yf <= nb && xf + yf > best_f) {
                best_f = xf + yf;
                fx = xf;
                fy = yf;
            }
        }
        var xr: i32 = vr[o];
        if (xr >= 0) {
            var yr: i32 = xr - j;
            if (xr <= na && yr >= 0 && yr <= nb && xr + yr > best_r) {
                best_r = xr + yr;
                rx = na - xr;
                ry = nb - yr;
            }
        }
        o = o + 1;
    }
    if (best_f >= best_r) {
        if (best_f > 0 && (fx < na || fy < nb)) { return (alo + fx, blo + fy); }
    } else if (rx > 0 || ry > 0) {
        return (alo + rx, blo + ry);
    }
    // No usable split. Halve both sides so the recursion still shrinks;
    // diff_compare's guard turns a truly degenerate range into a replace.
    return (alo + na / 2, blo + nb / 2);
}

// diff_bisect finds a point (x, y) on a shortest edit path between ia[alo:ahi]
// and ib[blo:bhi] by growing the forward search from the top left and the
// reverse search from the bottom right until they meet on a common diagonal.
// Past the cost cap it stops waiting for them to meet and returns the
// furthest-reaching point either search has found.
function diff_bisect(ia: i32[], ib: i32[], alo: i32, ahi: i32, blo: i32, bhi: i32, max_cost: i32): (i32, i32) {
    var na: i32 = ahi - alo;
    var nb: i32 = bhi - blo;
    // The searches meet after at most ceil(D/2) rounds each, and D is at most
    // na+nb; the extra round leaves room for the odd-delta case.
    var maxd: i32 = (na + nb + 3) / 2;
    var budget: i32 = maxd;
    if (budget > max_cost) { budget = max_cost; }
    // vf and vr hold each search's furthest-reaching x per diagonal, with
    // diagonal 0 at `off`. Only diagonals within `budget` of 0 are ever
    // written, so the budget sizes them: a diagonal outside that window reads
    // as "not reached", which is what an unwritten slot says too.
    var off: i32 = budget + 1;
    var size: i32 = 2 * budget + 4;
    var vf: i32[] = [];
    var vr: i32[] = [];
    var z: i32 = 0;
    while (z < size) {
        vf = vf.append(0 - 1);
        vr = vr.append(0 - 1);
        z = z + 1;
    }
    vf = vf.with(off + 1, 0);
    vr = vr.with(off + 1, 0);
    var delta: i32 = na - nb;
    // The two searches can only meet on a forward step when delta is odd, and
    // only on a reverse step when it is even.
    var meet_forward: boolean = delta % 2 != 0;
    // Diagonals that have run off the grid stop being extended.
    var flo: i32 = 0;
    var fhi: i32 = 0;
    var rlo: i32 = 0;
    var rhi: i32 = 0;
    var k: i32 = 0;
    while (k < budget) {
        var jf: i32 = 0 - k + flo;
        while (jf <= k - fhi) {
            var o: i32 = off + jf;
            var x: i32 = 0;
            if (jf == 0 - k || (jf != k && vf[o - 1] < vf[o + 1])) {
                x = vf[o + 1];
            } else {
                x = vf[o - 1] + 1;
            }
            var y: i32 = x - jf;
            while (x < na && y < nb && ia[alo + x] == ib[blo + y]) {
                x = x + 1;
                y = y + 1;
            }
            vf = vf.with(o, x);
            if (x > na) {
                fhi = fhi + 2;
            } else if (y > nb) {
                flo = flo + 2;
            } else if (meet_forward) {
                var ro: i32 = off + delta - jf;
                if (ro >= 0 && ro < size && vr[ro] >= 0 && x >= na - vr[ro]) {
                    return (alo + x, blo + y);
                }
            }
            jf = jf + 2;
        }
        var jr: i32 = 0 - k + rlo;
        while (jr <= k - rhi) {
            var o2: i32 = off + jr;
            var x2: i32 = 0;
            if (jr == 0 - k || (jr != k && vr[o2 - 1] < vr[o2 + 1])) {
                x2 = vr[o2 + 1];
            } else {
                x2 = vr[o2 - 1] + 1;
            }
            var y2: i32 = x2 - jr;
            while (x2 < na && y2 < nb && ia[ahi - 1 - x2] == ib[bhi - 1 - y2]) {
                x2 = x2 + 1;
                y2 = y2 + 1;
            }
            vr = vr.with(o2, x2);
            if (x2 > na) {
                rhi = rhi + 2;
            } else if (y2 > nb) {
                rlo = rlo + 2;
            } else if (!meet_forward) {
                var fo: i32 = off + delta - jr;
                if (fo >= 0 && fo < size && vf[fo] >= 0 && vf[fo] >= na - x2) {
                    return (alo + vf[fo], blo + vf[fo] - (delta - jr));
                }
            }
            jr = jr + 2;
        }
        k = k + 1;
    }
    return diff_furthest(vf, vr, off, size, alo, ahi, blo, bhi);
}

// diff_compare appends the alignment of ia[alo:ahi] against ib[blo:bhi] to
// `anchors` as (a, b) index pairs, in increasing order.
function diff_compare(anchors: i32[], ia: i32[], ib: i32[], alo: i32, ahi: i32, blo: i32, bhi: i32, max_cost: i32): i32[] {
    // Peeling the shared ends off every subproblem is not just a shortcut: it
    // is what guarantees the bisect below splits strictly inside the range, so
    // the recursion terminates.
    var lo_a: i32 = alo;
    var lo_b: i32 = blo;
    while (lo_a < ahi && lo_b < bhi && ia[lo_a] == ib[lo_b]) {
        anchors = anchors.append(lo_a);
        anchors = anchors.append(lo_b);
        lo_a = lo_a + 1;
        lo_b = lo_b + 1;
    }
    var suffix: i32 = 0;
    while (ahi - suffix > lo_a && bhi - suffix > lo_b && ia[ahi - 1 - suffix] == ib[bhi - 1 - suffix]) {
        suffix = suffix + 1;
    }
    var hi_a: i32 = ahi - suffix;
    var hi_b: i32 = bhi - suffix;
    if (lo_a < hi_a && lo_b < hi_b) {
        var (x, y) = diff_bisect(ia, ib, lo_a, hi_a, lo_b, hi_b, max_cost);
        // A split that makes no progress would not terminate. The end peeling
        // above rules that out; the guard keeps a bug in the bisect from
        // becoming a hang.
        if ((x != lo_a || y != lo_b) && (x != hi_a || y != hi_b)) {
            anchors = diff_compare(anchors, ia, ib, lo_a, x, lo_b, y, max_cost);
            anchors = diff_compare(anchors, ia, ib, x, hi_a, y, hi_b, max_cost);
        }
    }
    var s: i32 = 0;
    while (s < suffix) {
        anchors = anchors.append(hi_a + s);
        anchors = anchors.append(hi_b + s);
        s = s + 1;
    }
    return anchors;
}

// diff_edit_script diffs a against b and returns the merge of the two as one
// ordered script. The alignment is Myers' O(ND) greedy diff in its
// linear-space divide-and-conquer form: memory is O(m+n), where the LCS table
// this replaced was O(m*n) and so could not diff a source the size of
// irlower.fern at all.
function diff_edit_script(a: string[], b: string[]): DiffScript {
    var m: i32 = a.len();
    var n: i32 = b.len();
    var ids: DiffIds = diff_intern(a, b);
    var ia: i32[] = ids.ia;
    var ib: i32[] = ids.ib;

    // Shared ends belong to every optimal alignment, so peel them off before
    // searching. The usual case — a handful of reformatted lines in an
    // otherwise untouched file — then costs about what the change costs.
    var pre: i32 = 0;
    while (pre < m && pre < n && ia[pre] == ib[pre]) { pre = pre + 1; }
    var suf: i32 = 0;
    while (suf < m - pre && suf < n - pre && ia[m - 1 - suf] == ib[n - 1 - suf]) { suf = suf + 1; }

    // A line occurring on only one side cannot be part of any common
    // subsequence, so it is an edit in every alignment and the search never
    // needs to see it. On a wholly reformatted source that is most of the
    // file, and the search cost scales with the edit distance.
    var in_a: boolean[] = [];
    var in_b: boolean[] = [];
    var z: i32 = 0;
    while (z < ids.distinct) {
        in_a = in_a.append(false);
        in_b = in_b.append(false);
        z = z + 1;
    }
    var i: i32 = pre;
    while (i < m - suf) {
        in_a = in_a.with(ia[i], true);
        i = i + 1;
    }
    var j: i32 = pre;
    while (j < n - suf) {
        in_b = in_b.with(ib[j], true);
        j = j + 1;
    }
    var fa: i32[] = [];
    var map_a: i32[] = [];
    var fb: i32[] = [];
    var map_b: i32[] = [];
    i = pre;
    while (i < m - suf) {
        if (in_b[ia[i]]) {
            fa = fa.append(ia[i]);
            map_a = map_a.append(i);
        }
        i = i + 1;
    }
    j = pre;
    while (j < n - suf) {
        if (in_a[ib[j]]) {
            fb = fb.append(ib[j]);
            map_b = map_b.append(j);
        }
        j = j + 1;
    }
    var anchors: i32[] = [];
    anchors = diff_compare(anchors, fa, fb, 0, fa.len(), 0, fb.len(), diff_max_search_cost());

    // Everything between two matched lines is an edit; deletions come before
    // insertions within each such run.
    var kinds: i32[] = [];
    var lines: string[] = [];
    var p: i32 = 0;
    while (p < pre) {
        kinds = kinds.append(0);
        lines = lines.append(a[p]);
        p = p + 1;
    }
    var q: i32 = pre;
    var t: i32 = 0;
    while (t < anchors.len()) {
        var ai: i32 = map_a[anchors[t]];
        var bj: i32 = map_b[anchors[t + 1]];
        while (p < ai) {
            kinds = kinds.append(1);
            lines = lines.append(a[p]);
            p = p + 1;
        }
        while (q < bj) {
            kinds = kinds.append(2);
            lines = lines.append(b[q]);
            q = q + 1;
        }
        kinds = kinds.append(0);
        lines = lines.append(a[p]);
        p = p + 1;
        q = q + 1;
        t = t + 2;
    }
    while (p < m - suf) {
        kinds = kinds.append(1);
        lines = lines.append(a[p]);
        p = p + 1;
    }
    while (q < n - suf) {
        kinds = kinds.append(2);
        lines = lines.append(b[q]);
        q = q + 1;
    }
    while (p < m) {
        kinds = kinds.append(0);
        lines = lines.append(a[p]);
        p = p + 1;
    }
    return DiffScript { kinds: kinds, lines: lines };
}

// unified_diff returns a unified diff of `before` against `after`, empty when
// they are byte-identical. `-fmt -d` exits 1 exactly when the result is
// non-empty, which is what makes it usable as a CI check.
pub function unified_diff(before: string, after: string, path_before: string, path_after: string): string {
    if (before == after) { return ""; }
    var script: DiffScript = diff_edit_script(diff_split_lines(before), diff_split_lines(after));
    var kinds: i32[] = script.kinds;
    if (kinds.len() == 0) { return ""; }
    var context: i32 = 3;

    // Runs of changed lines, then merged wherever their context windows touch.
    var lo: i32[] = [];
    var hi: i32[] = [];
    var i: i32 = 0;
    while (i < kinds.len()) {
        if (kinds[i] == 0) {
            i = i + 1;
        } else {
            var s: i32 = i;
            while (i < kinds.len() && kinds[i] != 0) { i = i + 1; }
            if (lo.len() > 0 && s - hi[hi.len() - 1] <= 2 * context) {
                hi = hi.with(hi.len() - 1, i);
            } else {
                lo = lo.append(s);
                hi = hi.append(i);
            }
        }
    }
    if (lo.len() == 0) { return ""; }

    var out: string = "--- " + path_before + "\n+++ " + path_after + "\n";
    var h: i32 = 0;
    while (h < lo.len()) {
        var start: i32 = lo[h] - context;
        if (start < 0) { start = 0; }
        var end: i32 = hi[h] + context;
        if (end > kinds.len()) { end = kinds.len(); }
        var a_pos: i32 = 0;
        var b_pos: i32 = 0;
        var k: i32 = 0;
        while (k < start) {
            if (kinds[k] != 2) { a_pos = a_pos + 1; }
            if (kinds[k] != 1) { b_pos = b_pos + 1; }
            k = k + 1;
        }
        var a_len: i32 = 0;
        var b_len: i32 = 0;
        k = start;
        while (k < end) {
            if (kinds[k] != 2) { a_len = a_len + 1; }
            if (kinds[k] != 1) { b_len = b_len + 1; }
            k = k + 1;
        }
        out = out + "@@ -" + util.i32_to_string(a_pos + 1) + "," + util.i32_to_string(a_len)
                  + " +" + util.i32_to_string(b_pos + 1) + "," + util.i32_to_string(b_len) + " @@\n";
        k = start;
        while (k < end) {
            var mark: string = " ";
            if (kinds[k] == 1) { mark = "-"; }
            if (kinds[k] == 2) { mark = "+"; }
            var line: string = script.lines[k];
            out = out + mark + line;
            // A final line with no newline still has to leave the diff itself
            // well-formed.
            if (line.len() == 0 || line[line.len() - 1] != b'\n') { out = out + "\n"; }
            k = k + 1;
        }
        h = h + 1;
    }
    return out;
}

// ---- diff self-test ----------------------------------------------------
//
// A shortest edit script is not unique, so the byte-parity gates against
// native can only pin the alignment where the script is forced. These state
// the two properties that hold whatever the tie-breaks are: the script
// reproduces both of its inputs, and it is as short as an LCS table says the
// shortest is.

// diff_replay rebuilds one side of an edit script — `keep` is 1 for `a` and 2
// for `b`; a shared line belongs to both.
function diff_replay(sc: DiffScript, keep: i32): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < sc.kinds.len()) {
        if (sc.kinds[i] == 0 || sc.kinds[i] == keep) { out = out + sc.lines[i]; }
        i = i + 1;
    }
    return out;
}

// diff_edits counts the lines the script does not share.
function diff_edits(sc: DiffScript): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < sc.kinds.len()) {
        if (sc.kinds[i] != 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// diff_lcs_edits is the shortest edit-script length for a and b, straight from
// an LCS table. Quadratic in time and memory, which is exactly why
// diff_edit_script may not use one — but it is the ground truth the search is
// checked against on inputs small enough to afford it.
function diff_lcs_edits(a: string[], b: string[]): i32 {
    var m: i32 = a.len();
    var n: i32 = b.len();
    var prev: i32[] = [];
    var cur: i32[] = [];
    var z: i32 = 0;
    while (z <= n) {
        prev = prev.append(0);
        cur = cur.append(0);
        z = z + 1;
    }
    var i: i32 = m - 1;
    while (i >= 0) {
        // `cur` is rewritten at every j below, so aliasing the finished row is
        // safe: the first write copies it away from `prev`, which then holds
        // the row this one reads.
        prev = cur;
        var j: i32 = n - 1;
        while (j >= 0) {
            if (a[i] == b[j]) {
                cur = cur.with(j, prev[j + 1] + 1);
            } else if (prev[j] >= cur[j + 1]) {
                cur = cur.with(j, prev[j]);
            } else {
                cur = cur.with(j, cur[j + 1]);
            }
            j = j - 1;
        }
        i = i - 1;
    }
    return m + n - 2 * cur[0];
}

// diff_rand is a deterministic 31-bit Lehmer generator, so a failing case is
// reproducible.
function diff_rand(s: i64): i64 { return (s * 48271i64) % 2147483647i64; }

// diff_lines_from draws `n` lines from the first `alphabet` entries of a fixed
// vocabulary. The vocabulary is tiny on purpose: ties between equally short
// scripts are then the common case rather than a rarity.
function diff_lines_from(seed: i64, n: i32, alphabet: i32): string[] {
    var vocab: string[] = ["a\n", "b\n", "c\n", "d\n", "e\n"];
    var out: string[] = [];
    var s: i64 = seed;
    var i: i32 = 0;
    while (i < n) {
        s = diff_rand(s);
        out = out.append(vocab[(s % (alphabet as i64)) as i32]);
        i = i + 1;
    }
    return out;
}

// diff_selftest returns 0 when every property holds, or the failing case's
// code. Called from main.
function diff_selftest(): i32 {
    // The script reproduces both inputs and is minimal, over inputs small
    // enough for the LCS table to answer.
    var s: i64 = 12345i64;
    var iter: i32 = 0;
    while (iter < 300) {
        s = diff_rand(s);
        var alphabet: i32 = 2 + (s % 4i64) as i32;
        s = diff_rand(s);
        var na: i32 = (s % 14i64) as i32;
        s = diff_rand(s);
        var nb: i32 = (s % 14i64) as i32;
        s = diff_rand(s);
        var a: string[] = diff_lines_from(s, na, alphabet);
        s = diff_rand(s);
        var b: string[] = diff_lines_from(s, nb, alphabet);
        var sc: DiffScript = diff_edit_script(a, b);
        if (diff_replay(sc, 1) != util.str_join_chunks(a)) { return 350; }
        if (diff_replay(sc, 2) != util.str_join_chunks(b)) { return 351; }
        if (diff_edits(sc) != diff_lcs_edits(a, b)) { return 352; }
        iter = iter + 1;
    }

    // Same two properties over an input long enough to drive the recursive
    // split several levels deep, which the small cases never reach.
    var la: string[] = diff_lines_from(777i64, 400, 3);
    var lb: string[] = diff_lines_from(999i64, 400, 3);
    var lsc: DiffScript = diff_edit_script(la, lb);
    if (diff_replay(lsc, 1) != util.str_join_chunks(la)) { return 353; }
    if (diff_replay(lsc, 2) != util.str_join_chunks(lb)) { return 354; }
    if (diff_edits(lsc) != diff_lcs_edits(la, lb)) { return 355; }

    // A file with a shared head and tail costs what the change costs: the
    // peeling leaves one line on each side for the search.
    var pa: string[] = diff_split_lines("one\ntwo\nthree\nfour\nfive\n");
    var pb: string[] = diff_split_lines("one\ntwo\nTHREE\nfour\nfive\n");
    var psc: DiffScript = diff_edit_script(pa, pb);
    if (diff_edits(psc) != 2) { return 356; }
    if (diff_replay(psc, 1) != "one\ntwo\nthree\nfour\nfive\n") { return 357; }
    if (diff_replay(psc, 2) != "one\ntwo\nTHREE\nfour\nfive\n") { return 358; }

    // The unified-diff wrapper's layout: header rows, one hunk, the changed
    // pair between context lines.
    var ud: string = unified_diff("one\ntwo\nthree\nfour\nfive\n", "one\ntwo\nTHREE\nfour\nfive\n", "x.fern", "x.fern");
    if (ud != "--- x.fern\n+++ x.fern\n@@ -1,5 +1,5 @@\n one\n two\n-three\n+THREE\n four\n five\n") { return 359; }
    if (unified_diff("a\n", "a\n", "x", "y") != "") { return 360; }
    return 0;
}
