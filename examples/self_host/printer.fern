// examples/self_host/printer.fern — fifth concrete step of the
// self-host port. Walks a parser.Module and produces a textual
// rendering of it: a tree-to-source emitter that round-trips
// through the lexer + parser.
//
// Same shape as the checker (#619) and interp (#623): a
// recursive walk over parser.Expr / parser.Stmt with one match
// arm per variant. Output isn't strictly pretty — no alignment,
// no comment-preserving — but it produces re-parseable text for
// every shape the parser handles today.
//
// The .fern file's main() prints a non-trivial program, re-
// parses the result, and asserts the round-trip preserved the
// AST shape. Exit code 0 means every assertion passed; non-
// zero codes identify which arm failed.

import "./lexer";
import "./parser";
import "./util";

// =================== EXPRESSIONS ====================

// quote_string wraps a string value in `"`-delimited form, with
// the same escape set scan_string in the lexer recognises (so
// the result re-parses). The Fern strings here don't carry the
// surrounding `"`s — they store decoded bytes — so we re-encode
// on emit.
function quote_string(s: string): string {
    var out: string = "\"";
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i] as i32;
        if (b == 34) { out = out + "\\\""; }
        else if (b == 92) { out = out + "\\\\"; }
        else if (b == 10) { out = out + "\\n"; }
        else if (b == 9) { out = out + "\\t"; }
        else if (b == 13) { out = out + "\\r"; }
        else { out = out + s[i:i + 1]; }
        i = i + 1;
    }
    return out + "\"";
}

// =================== PRECEDENCE ====================
//
// Levels mirror the parser's, and native's printer's: higher binds tighter, and
// an operand is parenthesised only where its own operator binds less tightly
// than the context around it. The two tables must agree or the two formatters
// disagree about the canonical form of every expression (#6762).
//
// Bitwise (`|`, `^`, `&`) sits BELOW the comparison family, matching the
// grammar (parse_logical_and → parse_bit_or → parse_bit_xor → parse_bit_and →
// parse_equality → parse_relational), so `==` binds tighter than `&`. Ordering
// these the other way silently rewrites `(n & (n - 1)) == 0` — the
// is-power-of-2 idiom — into `n & n - 1 == 0`, which re-parses as ANDing a
// number with a boolean.
function prec_lowest(): i32 { return 0; }
function prec_cast(): i32 { return 14; }
function prec_unary(): i32 { return 15; }
function prec_primary(): i32 { return 16; }

// binary_prec is the level of `op`; an operator the table does not know sits at
// the lowest level, so it keeps its parens.
function binary_prec(op: string): i32 {
    if (op == "||") { return 4; }
    if (op == "&&") { return 5; }
    if (op == "|") { return 6; }
    if (op == "^") { return 7; }
    if (op == "&") { return 8; }
    if (op == "==" || op == "!=") { return 9; }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") { return 10; }
    if (op == "<<" || op == ">>" || op == "<<|" || op == "<<?" || op == ">>?") { return 11; }
    if (op == "+" || op == "-" || op == "+|" || op == "-|" || op == "+?" || op == "-?") { return 12; }
    if (op == "*" || op == "/" || op == "%" || op == "*|" || op == "*?" || op == "/?" || op == "%?") { return 13; }
    return prec_lowest();
}

// print_expr emits an expression at the outermost level, where nothing around
// it can require parens.
function print_expr(e: parser.Expr): string {
    return print_expr_prec(e, prec_lowest());
}

// print_expr_prec emits `e` inside a context binding at `parent_prec`, adding
// parentheses only where dropping them would reassociate. A left-associative
// operator passes its own level to its LEFT operand and one above it to the
// right, which is what keeps `a - (b - c)` parenthesised and `(a - b) - c`
// bare.
function print_expr_prec(e: parser.Expr, parent_prec: i32): string {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.suffix.len() > 0) { return n.text + n.suffix; }
            return n.text;
        },
        parser.ExprIdent(id) => { return id.name; },
        parser.ExprString(s) => { return quote_string(s.value); },
        parser.ExprBool(b) => {
            if (b.value) { return "true"; }
            return "false";
        },
        parser.ExprBinary(b) => {
            var p: i32 = binary_prec(b.op);
            var inner: string = print_expr_prec(b.left, p) + " " + b.op + " " + print_expr_prec(b.right, p + 1);
            if (p < parent_prec) { return "(" + inner + ")"; }
            return inner;
        },
        parser.ExprUnary(u) => {
            // A cast is a unary node whose op is `as_<type>` (parse_cast's
            // e_unary_at), not a prefix operator — printing it as one produced
            // `as_i32s[i + 1]` for `s[i + 1] as i32`, which re-parses as a call
            // to an undefined name. It binds at its own level, above every
            // binary operator and below the postfix positions.
            if (u.op.len() > 3 && u.op[0:3] == "as_") {
                var cinner: string = print_expr_prec(u.operand, prec_cast()) + " as " + u.op[3:u.op.len()];
                if (parent_prec >= prec_cast()) { return "(" + cinner + ")"; }
                return cinner;
            }
            var uinner: string = u.op + print_expr_prec(u.operand, prec_unary());
            if (parent_prec >= prec_unary()) { return "(" + uinner + ")"; }
            return uinner;
        },
        parser.ExprCall(c) => {
            var out: string = print_expr_prec(c.callee, prec_primary()) + "(";
            var i: i32 = 0;
            while (i < c.args.len()) {
                if (i > 0) { out = out + ", "; }
                out = out + print_expr(c.args[i]);
                i = i + 1;
            }
            return out + ")";
        },
        parser.ExprArray(a) => {
            var out: string = "[";
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (i > 0) { out = out + ", "; }
                out = out + print_expr(a.elements[i]);
                i = i + 1;
            }
            return out + "]";
        },
        parser.ExprTuple(t) => {
            var out: string = "(";
            var i: i32 = 0;
            while (i < t.elements.len()) {
                if (i > 0) { out = out + ", "; }
                out = out + print_expr(t.elements[i]);
                i = i + 1;
            }
            return out + ")";
        },
        parser.ExprIndex(x) => {
            return print_expr_prec(x.array, prec_primary()) + "[" + print_expr(x.index) + "]";
        },
        parser.ExprSlice(sl) => {
            return print_expr_prec(sl.array, prec_primary()) + "[" + print_expr(sl.start) + ":" + print_expr(sl.end) + "]";
        },
        parser.ExprStructLit(sl) => {
            var out: string = sl.type_name + " {";
            var first: boolean = true;
            if (sl.has_base) {
                out = out + " ..." + print_expr(sl.base);
                first = false;
            }
            var i: i32 = 0;
            while (i < sl.field_names.len()) {
                if (!first) { out = out + ","; }
                out = out + " " + sl.field_names[i] + ": " + print_expr(sl.field_values[i]);
                first = false;
                i = i + 1;
            }
            return out + " }";
        },
        parser.ExprFieldAccess(fa) => { return print_expr_prec(fa.obj, prec_primary()) + "." + fa.field; },
        parser.ExprLambda(lm) => {
            // `function(` with no space, matching native — the spaced form
            // re-parses but is not the canonical spelling.
            var out: string = "function(";
            var pi: i32 = 0;
            while (pi < lm.params.len()) {
                if (pi > 0) { out = out + ", "; }
                out = out + lm.params[pi].name;
                if (lm.params[pi].type_name.len() > 0) {
                    out = out + ": " + lm.params[pi].type_name;
                }
                pi = pi + 1;
            }
            out = out + ")";
            if (lm.ret_type.len() > 0) { out = out + ": " + lm.ret_type; }
            // A one-statement body renders inline, so a short predicate lambda
            // stays on the line that passes it. A lambda is an EXPRESSION, so
            // the multi-line form indents against a depth this walk does not
            // carry — it lands at column 0 mid-line, which is why matching
            // native's inline rule matters beyond style.
            if (lm.body.len() == 1 && stmt_is_single_line(lm.body[0])) {
                return out + " { " + print_stmt_inline(lm.body[0]) + " }";
            }
            var (lam_body, _) = print_block(lm.body, 0, empty_fmt());
            return out + " " + lam_body;
        },
        parser.ExprUnknown(u) => { return "/*unknown:" + u.kind + "*/"; }
    }
    return "/*unhandled-expr*/";
}

// =================== STATEMENTS ====================

// indent_str returns `depth` copies of "  " — two spaces per level, the width
// native's formatter uses and the one `make fmt-check` gates the tree against.
function indent_str(depth: i32): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < depth) { out = out + "  "; i = i + 1; }
    return out;
}

// =================== COMMENTS AND BLANK LINES ====================
//
// Comments and blank lines are not in the AST — the lexer hands them back
// beside the tokens, and blank lines are read off the source text — so the
// statement walk carries a CURSOR over the comment list and consumes from it
// as it passes each source line (#6769). The rules are native's:
//
//   - a comment before the next statement's line emits as its own line at that
//     statement's indent;
//   - a comment ON the line of a just-emitted single-line statement emits
//     inline after two spaces;
//   - comments left over at the end of a block emit before its closing brace;
//   - one blank line before a statement whose source had a blank directly
//     above it, so runs collapse to one and a second format pass is a no-op.
//
// `comments` must be in source order, which is how tokenize_full returns them.
// A cursor that never moves is the no-comment case, so print_module keeps
// working by passing an empty list.
struct Fmt { comments: lexer.Comment[], ci: i32, blanks: boolean[] }

function empty_fmt(): Fmt { return Fmt { comments: [], ci: 0, blanks: [] }; }

// blank_at reports whether source line `line` was blank. Out-of-range lines
// (line 0, or past the end) are not blank.
function (f: Fmt) blank_at(line: i32): boolean {
    if (line < 0 || line >= f.blanks.len()) { return false; }
    return f.blanks[line];
}

// blank_before: did the source have a blank line directly above this
// construct? A leading comment block belongs to the construct, so the line
// looked at is the comment's, not the statement's.
function (f: Fmt) blank_before(line: i32): boolean {
    var top: i32 = line;
    if (f.ci < f.comments.len() && f.comments[f.ci].line < line) { top = f.comments[f.ci].line; }
    return f.blank_at(top - 1);
}

// drain_leading emits every pending comment written ABOVE source line `line`.
// A comment on the same line stays queued for emit_trailing.
function drain_leading(f: Fmt, line: i32, depth: i32): (string, Fmt) {
    var out: string = "";
    var g: Fmt = f;
    while (g.ci < g.comments.len() && g.comments[g.ci].line < line) {
        out = out + indent_str(depth) + "//" + g.comments[g.ci].text + "\n";
        g = Fmt { ...g, ci: g.ci + 1 };
    }
    return (out, g);
}

// emit_trailing emits a comment sharing the source line of the statement just
// written — `putchar(70);  // F`. No newline: the caller's line break follows.
function emit_trailing(f: Fmt, line: i32): (string, Fmt) {
    if (f.ci < f.comments.len() && f.comments[f.ci].line == line) {
        return ("  //" + f.comments[f.ci].text, Fmt { ...f, ci: f.ci + 1 });
    }
    return ("", f);
}

// drain_all flushes every remaining comment at `depth` — end of file, and the
// tail of a block whose last statement is behind the cursor.
function drain_all(f: Fmt, depth: i32): (string, Fmt) {
    var out: string = "";
    var g: Fmt = f;
    while (g.ci < g.comments.len()) {
        out = out + indent_str(depth) + "//" + g.comments[g.ci].text + "\n";
        g = Fmt { ...g, ci: g.ci + 1 };
    }
    return (out, g);
}

// drain_before flushes the comments written above `limit` — a block's closing
// brace, whose line the AST does not record, so the bound is the line of the
// construct that FOLLOWS the block instead.
function drain_before(f: Fmt, limit: i32, depth: i32): (string, Fmt) {
    return drain_leading(f, limit, depth);
}

// stmt_line reports the source line a statement starts on, or 0 for one the
// compiler synthesised (no source position, so nothing can attach to it).
function stmt_line(st: parser.Stmt): i32 {
    match (st) {
        parser.StmtVar(v) => { return v.line; },
        parser.StmtReturn(r) => { return r.line; },
        parser.StmtAssign(a) => { return a.line; },
        parser.StmtExpr(x) => { return x.line; },
        parser.StmtIf(f) => { return f.line; },
        parser.StmtWhile(w) => { return w.line; },
        parser.StmtFor(fo) => { return fo.line; },
        parser.StmtMatch(m) => { return m.line; },
        parser.StmtDefer(d) => { return d.line; },
        parser.StmtBreak(b) => { return b.line; },
        parser.StmtContinue(c) => { return c.line; },
        _ => { return 0; }
    }
    return 0;
}

// print_block renders `{ … }` and is the one place statements are drained
// against: a comment above a statement, a blank line the author left before
// it, and whatever is still queued when the block ends.
function print_block(body: parser.Stmt[], depth: i32, f: Fmt): (string, Fmt) {
    // An empty block is a one-liner, as native prints it. Supporting a comment
    // inside one would force it multi-line for a comment with nothing to
    // attach to; the parent's drain picks those up instead.
    if (body.len() == 0) { return ("{}", f); }
    var out: string = "{\n";
    var g: Fmt = f;
    var i: i32 = 0;
    var last_line: i32 = 0;
    while (i < body.len()) {
        var ln: i32 = stmt_line(body[i]);
        // Never a blank just inside the opening brace.
        if (i > 0 && ln > 0 && g.blank_before(ln)) { out = out + "\n"; }
        if (ln > 0) {
            var (lead, g1) = drain_leading(g, ln, depth + 1);
            out = out + lead;
            g = g1;
        }
        var (body_text, g2) = print_stmt(body[i], depth + 1, g);
        out = out + body_text;
        g = g2;
        if (ln > last_line) { last_line = ln; }
        i = i + 1;
    }
    out = out + indent_str(depth) + "}";
    return (out, g);
}

function print_pattern(pat: parser.Pattern): string {
    match (pat) {
        parser.PatWildcard(_) => { return "_"; },
        parser.PatVariant(pv) => {
            var head: string = pv.type_name;
            if (pv.at_binding.len() > 0) { head = pv.at_binding + " @ " + pv.type_name; }
            if (pv.binding.len() == 0) { return head; }
            // Every payload binding, not just the first — a `Pair(a, b)` printed
            // as `Pair(a)` re-parses as a different (E015) program.
            var out: string = head + "(" + pv.binding;
            var i: i32 = 0;
            while (i < pv.extra_bindings.len()) {
                out = out + ", " + pv.extra_bindings[i];
                i = i + 1;
            }
            return out + ")";
        }
    }
    return "_";
}

function print_match(m: parser.StmtMatch, depth: i32, f: Fmt): (string, Fmt) {
    var pad: string = indent_str(depth);
    var out: string = "match (" + print_expr(m.scrutinee) + ") {\n";
    var g: Fmt = f;
    var i: i32 = 0;
    while (i < m.arms.len()) {
        var (arm_body, g1) = print_block(m.arms[i].body, depth + 1, g);
        g = g1;
        out = out + indent_str(depth + 1) + print_pattern(m.arms[i].pattern) + " => " + arm_body;
        if (i + 1 < m.arms.len()) { out = out + ","; }
        out = out + "\n";
        i = i + 1;
    }
    return (out + pad + "}", g);
}

// expr_is_missing reports an expression slot the parser never filled — a void
// `return;`, whose value is the unknown-token placeholder for the `;`.
function expr_is_missing(e: parser.Expr): boolean {
    match (e) {
        parser.ExprUnknown(u) => { return u.kind.len() == 0 || u.kind[0:6] == "punct:"; },
        _ => { return false; }
    }
    return false;
}

// stmt_is_single_line: the statement kinds native renders on one line, and so
// the ones a one-statement lambda body may keep inline.
function stmt_is_single_line(st: parser.Stmt): boolean {
    match (st) {
        parser.StmtReturn(_) => { return true; },
        parser.StmtVar(_) => { return true; },
        parser.StmtExpr(_) => { return true; },
        parser.StmtAssign(_) => { return true; },
        parser.StmtBreak(_) => { return true; },
        parser.StmtContinue(_) => { return true; },
        parser.StmtDefer(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// print_stmt_inline renders `st` for a position that CONTINUES the current
// line — a one-statement lambda body. A lambda carries no comment cursor: it
// is an expression, and native does not drain inside one either.
function print_stmt_inline(st: parser.Stmt): string {
    var (text, _) = print_stmt_body(st, 0, empty_fmt());
    return text;
}

// ForCSugar is a C-style `for` recovered from the desugar the parser lowered it
// to. `ok` is false for an ordinary `if`.
//
// `init` and `step` hold zero or one statement each — the header allows both to
// be empty (`for (; c; )`). `cond` is the loop condition; an omitted one
// desugars to the literal `true` and is reprinted that way, since the lowered
// form keeps no record of which of the two was written.
// `label` is the loop label the source wrote, which with_loop_label parks on
// the desugar's inner while — there is no other loop in the shape to carry it.
struct ForCSugar { init: parser.Stmt[], cond: parser.Expr, step: parser.Stmt[], body: parser.Stmt[], label: string, ok: boolean }

function no_c_for(): ForCSugar {
    var none: parser.Stmt[] = [];
    return ForCSugar { init: none, cond: parser.ExprBool { value: true }, step: none, body: none, label: "", ok: false };
}

// as_c_for recognises the C-style-for desugar and takes the three header
// clauses and the body back out of it. Its marker is the synthesised flag
// variable, `__forc_<line>_<col>`: the `__` prefix is reserved, so no source
// program can present this shape by accident.
//
// The shape is parse_for's, and the two must move together — a change to the
// desugar that this stops recognising silently reverts to printing the
// while-loop.
//
//     if (true) { INIT…; var __forc_L_C = true; while (true) {
//         if (!__forc_L_C) { STEP }
//         __forc_L_C = false;
//         if (!(COND)) { break; }
//         BODY…
//     } }
function as_c_for(ifs: parser.StmtIf): ForCSugar {
    if (!expr_is_true(ifs.cond) || ifs.else_body.len() != 0) { return no_c_for(); }
    var outer: parser.Stmt[] = ifs.then_body;
    if (outer.len() < 2) { return no_c_for(); }
    var flag: string = "";
    match (outer[outer.len() - 2]) {
        parser.StmtVar(v) => {
            if (is_forc_name(v.name) && expr_is_true(v.init)) { flag = v.name; }
        },
        _ => {},
    }
    if (flag.len() == 0) { return no_c_for(); }
    var wbody: parser.Stmt[] = [];
    var label: string = "";
    var have_while: boolean = false;
    match (outer[outer.len() - 1]) {
        parser.StmtWhile(w) => {
            if (expr_is_true(w.cond)) { wbody = w.body; label = w.label; have_while = true; }
        },
        _ => {},
    }
    if (!have_while || wbody.len() < 3) { return no_c_for(); }

    // wbody[0]: `if (!flag) { STEP }` — STEP is its then-body, possibly empty.
    var step: parser.Stmt[] = [];
    var step_ok: boolean = false;
    match (wbody[0]) {
        parser.StmtIf(s) => {
            if (is_not_of_ident(s.cond, flag) && s.else_body.len() == 0) { step = s.then_body; step_ok = true; }
        },
        _ => {},
    }
    if (!step_ok) { return no_c_for(); }

    // wbody[1]: `flag = false`.
    var assign_ok: boolean = false;
    match (wbody[1]) {
        parser.StmtAssign(a) => {
            if (a.target == flag && expr_is_false(a.value)) { assign_ok = true; }
        },
        _ => {},
    }
    if (!assign_ok) { return no_c_for(); }

    // wbody[2]: `if (!(COND)) { break; }`.
    var cond: parser.Expr = parser.ExprBool { value: true };
    var cond_ok: boolean = false;
    match (wbody[2]) {
        parser.StmtIf(c) => {
            if (c.else_body.len() == 0 && c.then_body.len() == 1) {
                match (c.then_body[0]) {
                    parser.StmtBreak(b) => {
                        if (b.label.len() == 0) {
                            match (c.cond) {
                                parser.ExprUnary(u) => {
                                    if (u.op == "!") { cond = u.operand; cond_ok = true; }
                                },
                                _ => {},
                            }
                        }
                    },
                    _ => {},
                }
            }
        },
        _ => {},
    }
    if (!cond_ok) { return no_c_for(); }

    var init: parser.Stmt[] = [];
    var ii: i32 = 0;
    while (ii + 2 < outer.len()) { init = init.append(outer[ii]); ii = ii + 1; }
    var body: parser.Stmt[] = [];
    var bi: i32 = 3;
    while (bi < wbody.len()) { body = body.append(wbody[bi]); bi = bi + 1; }
    return ForCSugar { init: init, cond: cond, step: step, body: body, label: label, ok: true };
}

// is_forc_name reports the synthesised first-iteration flag `__forc_<l>_<c>`.
function is_forc_name(name: string): boolean {
    return name.len() > 7 && name[0:7] == "__forc_";
}

function expr_is_true(e: parser.Expr): boolean {
    match (e) {
        parser.ExprBool(b) => { return b.value; },
        _ => { return false; },
    }
    return false;
}

function expr_is_false(e: parser.Expr): boolean {
    match (e) {
        parser.ExprBool(b) => { return !b.value; },
        _ => { return false; },
    }
    return false;
}

// is_not_of_ident reports `!<name>`.
function is_not_of_ident(e: parser.Expr, name: string): boolean {
    match (e) {
        parser.ExprUnary(u) => {
            if (u.op != "!") { return false; }
            match (u.operand) {
                parser.ExprIdent(id) => { return id.name == name; },
                _ => { return false; },
            }
        },
        _ => { return false; },
    }
    return false;
}

// print_c_for renders the recovered header. The clause statements print with
// their trailing `;` stripped: the header's own separators supply them, and a
// clause is an ordinary statement everywhere else.
function print_c_for(fc: ForCSugar, depth: i32, f: Fmt): (string, Fmt) {
    var init: string = "";
    if (fc.init.len() == 1) { init = strip_semi(print_stmt_inline(fc.init[0])); }
    var step: string = "";
    if (fc.step.len() == 1) { step = strip_semi(print_stmt_inline(fc.step[0])); }
    var (body, g) = print_block(fc.body, depth, f);
    return (loop_label(fc.label) + "for (" + init + "; " + print_expr(fc.cond) + "; " + step + ") " + body, g);
}

function strip_semi(s: string): string {
    if (s.len() > 0 && s[s.len() - 1] == 59) { return s[0:s.len() - 1] + ""; }   // ';'
    return s;
}

// print_if_chain renders an if/else with no leading indent and no trailing
// newline. An `else` the SOURCE wrote as a chain stays one — but only then:
// `else if` and `else { if … }` parse to the same one-element else_body, so
// rendering every such body as a chain rewrote the second spelling into the
// first (#6779). They are not interchangeable to a reader, to `make fmt-check`,
// or to a block-scoped binding written before the inner `if`.
function print_if_chain(ifs: parser.StmtIf, depth: i32, f: Fmt): (string, Fmt) {
    var (then_text, g) = print_block(ifs.then_body, depth, f);
    var out: string = "if (" + print_expr(ifs.cond) + ") " + then_text;
    if (ifs.else_body.len() == 0) { return (out, g); }
    if (ifs.else_chained && ifs.else_body.len() == 1) {
        match (ifs.else_body[0]) {
            parser.StmtIf(nested) => {
                var (nested_text, g2) = print_if_chain(nested, depth, g);
                return (out + " else " + nested_text, g2);
            },
            _ => {}
        }
    }
    var (else_text, g3) = print_block(ifs.else_body, depth, g);
    return (out + " else " + else_text, g3);
}

// loop_label renders the `name: ` a labeled loop carries. Dropping it also
// strips the `break name` / `continue name` that target it, so the reformatted
// program leaves a different loop than the one written.
function loop_label(label: string): string {
    if (label.len() == 0) { return ""; }
    return label + ": ";
}

// for_binder renders a StmtFor's binder. The map form `for (k, v) in m` stores
// its two names comma-joined in the one field, and reprinting that bare gives
// `for k,v in m`, which does not parse.
function for_binder(var_name: string): string {
    if (!util.contains(var_name, ",")) { return var_name; }
    return "(" + join_csv(var_name) + ")";
}

// print_for_iter renders a StmtFor's iterable. The range forms are carried as
// a synthetic `__range(LOW, HIGH)` / `__range_incl(LOW, HIGH)` call
// (parse_for_stmt), which is a parser-internal name no source may write.
function print_for_iter(e: parser.Expr): string {
    match (e) {
        parser.ExprCall(c) => {
            if (c.args.len() == 2) {
                match (c.callee) {
                    parser.ExprIdent(id) => {
                        if (id.name == "__range") { return print_expr(c.args[0]) + ".." + print_expr(c.args[1]); }
                        if (id.name == "__range_incl") { return print_expr(c.args[0]) + "..=" + print_expr(c.args[1]); }
                    },
                    _ => {}
                }
            }
        },
        _ => {}
    }
    return print_expr(e);
}

// print_stmt renders ONE statement as a complete line — indent, text, any
// inline trailing comment, and the newline. Comments ABOVE it were already
// drained by the block loop; a nested block drains its own.
function print_stmt(st: parser.Stmt, depth: i32, f: Fmt): (string, Fmt) {
    var (text, g) = print_stmt_body(st, depth, f);
    var out: string = indent_str(depth) + text;
    // Only a single-line statement can carry a trailing comment: on a compound
    // one the same-line comment sits against the header, not the body, and
    // native does not attach it either.
    if (stmt_is_single_line(st)) {
        var ln: i32 = stmt_line(st);
        if (ln > 0) {
            var (tr, g2) = emit_trailing(g, ln);
            return (out + tr + "\n", g2);
        }
    }
    return (out + "\n", g);
}

// split_commas splits a comma-joined binding / field list. Destructure names
// never contain a comma, so no nesting awareness is needed.
function split_commas(csv: string): string[] {
    var out: string[] = [];
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= csv.len()) {
        if (i == csv.len() || csv[i] == 44) {
            out = out.append(csv[start : i]);
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// join_csv respells a comma-joined list with native's `, ` separator.
function join_csv(csv: string): string {
    var parts: string[] = split_commas(csv);
    var out: string = "";
    var i: i32 = 0;
    while (i < parts.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + parts[i];
        i = i + 1;
    }
    return out;
}

function is_struct_destructure(type_name: string): boolean {
    return type_name.len() >= 4 && type_name[0:4] == "@sd:";
}

// print_struct_destructure respells `let Point { x, y } = E;` from the marker
// parse_struct_destructure encodes into type_name ("@sd:<Struct>:<fields>",
// with the bound names comma-joined in `name`). A field renamed on binding
// prints as `field: binding`, which is also how it was written.
function print_struct_destructure(v: parser.StmtVar): string {
    var rest: str = v.type_name[4 : v.type_name.len()];
    var colon: i32 = 0 - 1;
    var ri: i32 = 0;
    while (ri < rest.len()) {
        if (rest[ri] == 58 && colon < 0) { colon = ri; }
        ri = ri + 1;
    }
    if (colon < 0) { return "var " + v.name + " = " + print_expr(v.init) + ";"; }
    var struct_name: str = rest[0 : colon];
    var fields: string[] = split_commas(rest[colon + 1 : rest.len()]);
    var binds: string[] = split_commas(v.name);
    var out: string = "let " + struct_name + " { ";
    var i: i32 = 0;
    while (i < fields.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + fields[i];
        if (i < binds.len() && binds[i] != fields[i]) { out = out + ": " + binds[i]; }
        i = i + 1;
    }
    return out + " } = " + print_expr(v.init) + ";";
}

// print_stmt_body is the statement text with no indent and no newline.
function print_stmt_body(st: parser.Stmt, depth: i32, f: Fmt): (string, Fmt) {
    match (st) {
        parser.StmtDefer(d) => {
            var (act, dg) = print_stmt_body(d.action, depth, f);
            if (d.on_error != 0) { return ("errdefer " + act, dg); }
            return ("defer " + act, dg);
        },
        parser.StmtVar(v) => {
            // Both destructuring forms parse to a StmtVar: the bindings are
            // comma-joined into `name`, and a STRUCT destructure additionally
            // tags `type_name` with the parser's `@sd:Type:field,field` marker.
            // Printed as a plain `var` they re-parse as something else — or, for
            // the tuple form, do not re-parse at all (#6773).
            if (is_struct_destructure(v.type_name)) { return (print_struct_destructure(v), f); }
            if (util.contains(v.name, ",")) {
                return ("let (" + join_csv(v.name) + ") = " + print_expr(v.init) + ";", f);
            }
            var ann: string = "";
            if (v.type_name.len() > 0) { ann = ": " + v.type_name; }
            return ("var " + v.name + ann + " = " + print_expr(v.init) + ";", f);
        },
        parser.StmtReturn(r) => {
            // A void `return;` parses with no value expression, which reaches
            // the printer as the unknown-token placeholder for the `;` that
            // followed. Printing that placeholder emits a comment INTO the
            // source; the statement is just `return;`.
            if (expr_is_missing(r.value)) { return ("return;", f); }
            return ("return " + print_expr(r.value) + ";", f);
        },
        parser.StmtExpr(x) => { return (print_expr(x.value) + ";", f); },
        parser.StmtIf(ifs) => {
            // A C-style `for` reaches the printer as its desugar — the parser
            // lowers it at parse time and the Stmt union has no node for it
            // (StmtFor models the range form only). Printing the desugar
            // rewrites the user's loop into a synthesised while-loop, flag and
            // all, so reprint the header from the shape instead (#6771).
            var fc: ForCSugar = as_c_for(ifs);
            if (fc.ok) { return print_c_for(fc, depth, f); }
            return print_if_chain(ifs, depth, f);
        },
        parser.StmtWhile(w) => {
            var (wb, wg) = print_block(w.body, depth, f);
            return (loop_label(w.label) + "while (" + print_expr(w.cond) + ") " + wb, wg);
        },
        parser.StmtAssign(a) => { return (a.target + " = " + print_expr(a.value) + ";", f); },
        parser.StmtMatch(m) => { return print_match(m, depth, f); },
        parser.StmtFor(fo) => {
            var (fb, fg) = print_block(fo.body, depth, f);
            return (loop_label(fo.label) + "for " + for_binder(fo.var_name) + " in " + print_for_iter(fo.iter) + " " + fb, fg);
        },
        parser.StmtBreak(b) => {
            if (b.label.len() > 0) { return ("break " + b.label + ";", f); }
            return ("break;", f);
        },
        parser.StmtContinue(c) => {
            if (c.label.len() > 0) { return ("continue " + c.label + ";", f); }
            return ("continue;", f);
        },
        parser.StmtUnknown(u) => { return ("/*unknown-stmt:" + u.kind + "*/", f); }
    }
    return ("/*unhandled-stmt*/", f);
}

// =================== MODULE ====================

// print_type_params renders `[T, K: cmp.Ord]`, or "" when the decl has none.
// The trait bound matters: dropping it turns a constrained generic into an
// unconstrained one, which the checker then refuses at the call site.
function print_type_params(fd: parser.FuncDecl): string {
    if (fd.type_params.len() == 0) { return ""; }
    var out: string = "[";
    var i: i32 = 0;
    while (i < fd.type_params.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + fd.type_params[i];
        if (i < fd.bound_traits.len() && fd.bound_traits[i].len() > 0) {
            // Multi-trait bounds are stored `+`-joined; native spells them
            // ` + `.
            out = out + ": " + join_plus(fd.bound_traits[i]);
        }
        i = i + 1;
    }
    return out + "]";
}

// join_plus respells a `+`-joined trait list with native's ` + ` separator.
function join_plus(bounds: string): string {
    var out: string = "";
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= bounds.len()) {
        if (i == bounds.len() || bounds[i] == 43) {
            if (out.len() > 0) { out = out + " + "; }
            out = out + bounds[start : i];
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

function print_func_decl(fd: parser.FuncDecl, f: Fmt): (string, Fmt) {
    // An `@import` extern (P4 — docs/WIT-BRING-YOUR-OWN.md) renders as the
    // attribute on its own line followed by a body-less function (`;`).
    var out: string = "";
    if (fd.import_iface.len() > 0) {
        out = out + "@import(" + quote_string(fd.import_iface) + ", " + quote_string(fd.import_wit) + ")\n";
    }
    // Modifier ORDER is native's: `pub`, then `fip`/`fbip`, then `async`.
    //
    // `pub` is what makes the function reachable across modules, so dropping it
    // turns a formatted library file into one whose exports no longer resolve.
    // `fip` selects the E053 no-allocation walk and `fbip` its constructor-
    // relaxed sibling, with the graded `(n)` naming the allocation budget E068
    // enforces. `async` selects the WASI Preview-3 `canon lift async` export
    // surface, so dropping it changes what a `-emit core-module` build exports.
    if (fd.is_pub) { out = out + "pub "; }
    if (fd.fip || fd.fbip) {
        if (fd.fip) { out = out + "fip"; } else { out = out + "fbip"; }
        if (fd.fip_allowance > 0) { out = out + "(" + util.i32_to_string(fd.fip_allowance) + ")"; }
        out = out + " ";
    }
    if (fd.async) { out = out + "async "; }
    out = out + "function ";
    // Type parameters. `function first[T](xs: T[])` formatted without them
    // leaves every `T` in the signature unbound, so the file stops compiling.
    // A METHOD's go BEFORE its receiver clause (`function [U] (o: Opt) map`),
    // which is where native prints them and the only spelling that re-parses:
    // the receiver's own type variables come from the receiver type.
    var tps: string = print_type_params(fd);
    // Receiver clause: `(recv: RecvType)` after `function` and
    // before the method name. Both fields empty for plain funcs.
    if (fd.receiver_name.len() > 0) {
        if (tps.len() > 0) { out = out + tps + " "; }
        out = out + "(" + fd.receiver_name;
        if (fd.receiver_type.len() > 0) { out = out + ": " + fd.receiver_type; }
        out = out + ") ";
        out = out + fd.name;
    } else {
        out = out + fd.name + tps;
    }
    out = out + "(";
    var i: i32 = 0;
    while (i < fd.params.len()) {
        if (i > 0) { out = out + ", "; }
        out = out + fd.params[i].name;
        if (fd.params[i].type_name.len() > 0) {
            out = out + ": " + fd.params[i].type_name;
        }
        i = i + 1;
    }
    out = out + ")";
    if (fd.ret_type.len() > 0) { out = out + ": " + fd.ret_type; }
    if (fd.import_iface.len() > 0) {
        return (out + ";\n", f);
    }
    var (body_text, g) = print_block(fd.body, 0, f);
    return (out + " " + body_text + "\n", g);
}

function print_struct_decl(sd: parser.StructDecl): string {
    var out: string = "";
    // Attributes, on their own lines above the decl. Both change what the
    // program MEANS: `@derive` names methods the next parse synthesises, and
    // `@must_consume` arms the E067 obligation walk.
    if (sd.derives.len() > 0) {
        out = out + "@derive(";
        var di: i32 = 0;
        while (di < sd.derives.len()) {
            if (di > 0) { out = out + ", "; }
            out = out + sd.derives[di];
            di = di + 1;
        }
        out = out + ")\n";
    }
    if (sd.must_consume) { out = out + "@must_consume\n"; }
    if (sd.is_pub) { out = out + "pub "; }
    out = out + "struct " + sd.name;
    // Type parameters, for the same reason a function's matter: `struct Set { xs: T[] }`
    // leaves T unbound.
    if (sd.type_params.len() > 0) {
        out = out + "[";
        var tpi: i32 = 0;
        while (tpi < sd.type_params.len()) {
            if (tpi > 0) { out = out + ", "; }
            out = out + sd.type_params[tpi];
            tpi = tpi + 1;
        }
        out = out + "]";
    }
    out = out + " {";
    var i: i32 = 0;
    while (i < sd.fields.len()) {
        if (i > 0) { out = out + ","; }
        out = out + " " + sd.fields[i].name + ": " + sd.fields[i].type_name;
        i = i + 1;
    }
    if (sd.fields.len() > 0) { out = out + " "; }
    return out + "}\n";
}

// print_const_decl re-spells a const from the zero-arg FuncDecl the parser
// desugars it into: the body is a single `return EXPR;`, and EXPR is the
// initialiser. Printing the desugar instead would emit `function NAME(): T {
// return EXPR; }`, which the SELF-HOST accepts (a bare reference to a zero-arg
// function is exactly what a const reference lowers to) but native rejects —
// it has no such rule, so `NAME + 1` there is an operator applied to a
// function value.
function print_const_decl(fd: parser.FuncDecl): string {
    var out: string = "";
    if (fd.is_pub) { out = out + "pub "; }
    out = out + "const " + fd.name;
    if (fd.ret_type.len() > 0) { out = out + ": " + fd.ret_type; }
    var i: i32 = 0;
    while (i < fd.body.len()) {
        match (fd.body[i]) {
            parser.StmtReturn(r) => { return out + " = " + print_expr(r.value) + ";\n"; },
            _ => { }
        }
        i = i + 1;
    }
    return out + ";\n";
}

// enum_index returns the position of the enum named `name` in `enums`, or -1.
function enum_index(enums: parser.EnumDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < enums.len()) {
        if (enums[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// variant_decl_index returns the position of an enum variant's desugared struct
// record in `structs`, or -1. Both names are matched: a variant record is keyed
// by (enum_owner, name), and a plain struct may share a variant's name.
function variant_decl_index(structs: parser.StructDecl[], owner: string, name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].enum_owner == owner && structs[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// print_enum_decl reconstructs `enum Name[T] { V, W(A, B) }` from the EnumDecl
// and the variant structs the parser desugared it into. The payload types are
// the variant record's `__ev`, `__ev1`, … fields in declaration order, and the
// enum's `@derive` is read back from a variant record because that is where the
// parser stamps it — EnumDecl carries only `@must_consume`.
function print_enum_decl(ed: parser.EnumDecl, structs: parser.StructDecl[]): string {
    var out: string = "";
    var d0: i32 = 0 - 1;
    if (ed.variant_names.len() > 0) { d0 = variant_decl_index(structs, ed.name, ed.variant_names[0]); }
    if (d0 >= 0 && structs[d0].derives.len() > 0) {
        out = out + "@derive(";
        var di: i32 = 0;
        while (di < structs[d0].derives.len()) {
            if (di > 0) { out = out + ", "; }
            out = out + structs[d0].derives[di];
            di = di + 1;
        }
        out = out + ")\n";
    }
    if (ed.must_consume) { out = out + "@must_consume\n"; }
    if (ed.is_pub) { out = out + "pub "; }
    out = out + "enum " + ed.name;
    if (ed.type_params.len() > 0) {
        out = out + "[";
        var ti: i32 = 0;
        while (ti < ed.type_params.len()) {
            if (ti > 0) { out = out + ", "; }
            out = out + ed.type_params[ti];
            ti = ti + 1;
        }
        out = out + "]";
    }
    out = out + " {";
    var vi: i32 = 0;
    while (vi < ed.variant_names.len()) {
        if (vi > 0) { out = out + ","; }
        out = out + " " + ed.variant_names[vi];
        var si: i32 = variant_decl_index(structs, ed.name, ed.variant_names[vi]);
        if (si >= 0 && structs[si].variant_field_names.len() > 0) {
            // Record form — the payload fields carry positional `__ev` markers, so
            // the written names come from variant_field_names, parallel to them.
            out = out + " {";
            var ri: i32 = 0;
            while (ri < structs[si].fields.len()) {
                if (ri > 0) { out = out + ","; }
                out = out + " " + structs[si].variant_field_names[ri] + ": " + structs[si].fields[ri].type_name;
                ri = ri + 1;
            }
            out = out + " }";
        } else if (si >= 0 && structs[si].fields.len() > 0) {
            out = out + "(";
            var fi: i32 = 0;
            while (fi < structs[si].fields.len()) {
                if (fi > 0) { out = out + ", "; }
                out = out + structs[si].fields[fi].type_name;
                fi = fi + 1;
            }
            out = out + ")";
        }
        vi = vi + 1;
    }
    if (ed.variant_names.len() > 0) { out = out + " "; }
    return out + "}\n";
}

// print_type_params_except renders a decl's type parameters minus `skip`, or ""
// when nothing is left.
function print_type_params_except(fd: parser.FuncDecl, skip: string[]): string {
    var names: string[] = [];
    var bounds: string[] = [];
    var i: i32 = 0;
    while (i < fd.type_params.len()) {
        if (!util.has_str(skip, fd.type_params[i])) {
            names = names.append(fd.type_params[i]);
            if (i < fd.bound_traits.len()) { bounds = bounds.append(fd.bound_traits[i]); } else { bounds = bounds.append(""); }
        }
        i = i + 1;
    }
    if (names.len() == 0) { return ""; }
    var out: string = "[";
    var j: i32 = 0;
    while (j < names.len()) {
        if (j > 0) { out = out + ", "; }
        out = out + names[j];
        if (bounds[j].len() > 0) { out = out + ": " + join_plus(bounds[j]); }
        j = j + 1;
    }
    return out + "]";
}

// print_impl_decl reconstructs `impl[T: Bound] Trait for Type { … }` (or an
// inherent `impl Type { … }`) from the written form parse_impl_decl retains.
// The methods are the DESUGARED forms, which is what native prints too.
function print_impl_decl(id: parser.ImplDecl, f: Fmt): (string, Fmt) {
    var out: string = "impl";
    if (id.type_params.len() > 0) {
        out = out + "[";
        var tpi: i32 = 0;
        while (tpi < id.type_params.len()) {
            if (tpi > 0) { out = out + ", "; }
            out = out + id.type_params[tpi];
            if (tpi < id.bounds.len() && id.bounds[tpi].len() > 0) { out = out + ": " + join_plus(id.bounds[tpi]); }
            tpi = tpi + 1;
        }
        out = out + "]";
    }
    out = out + " ";
    if (id.trait_ref.len() > 0) { out = out + id.trait_ref + " for "; }
    out = out + id.type_ref;
    if (id.methods.len() == 0) { return (out + " {}\n", f); }
    out = out + " {\n";
    var g: Fmt = f;
    var mi: i32 = 0;
    while (mi < id.methods.len()) {
        var (mtext, mg) = print_impl_method(id.methods[mi], id.type_params, g);
        out = out + mtext;
        g = mg;
        mi = mi + 1;
    }
    return (out + "}\n", g);
}

// print_impl_method emits one method at one indent level. An impl block states
// its methods with `self` as an ordinary first PARAMETER, so a receiver — which
// is what the decl was desugared into — is re-inserted there. A receiver-less
// method is an associated function and its parameters stand as written.
function print_impl_method(m: parser.FuncDecl, impl_tps: string[], f: Fmt): (string, Fmt) {
    // finalize_impl_method merges the IMPL's type parameters into the method's,
    // so printing them here would restate `[T]` on every method of an
    // `impl[T] …` — which native rejects outright ("cannot declare its own type
    // parameters inside a parametric impl block").
    var out: string = indent_str(1) + "function " + m.name + print_type_params_except(m, impl_tps) + "(";
    var first: boolean = true;
    if (m.receiver_name.len() > 0) {
        out = out + m.receiver_name;
        if (m.receiver_type.len() > 0) { out = out + ": " + m.receiver_type; }
        first = false;
    }
    var i: i32 = 0;
    while (i < m.params.len()) {
        if (!first) { out = out + ", "; }
        if (m.params[i].own) { out = out + "own "; }
        out = out + m.params[i].name;
        if (m.params[i].type_name.len() > 0) { out = out + ": " + m.params[i].type_name; }
        first = false;
        i = i + 1;
    }
    out = out + ")";
    if (m.ret_type.len() > 0) { out = out + ": " + m.ret_type; }
    if (m.body.len() == 0) { return (out + ";\n", f); }
    var (body, g) = print_block(m.body, 1, f);
    return (out + " " + body + "\n", g);
}

// print_trait_decl reconstructs `pub trait Name[T]: Super { … }` from the
// written form parse_trait_decl retains. The compile path's own views of a
// trait cannot be printed from — see parser.TraitDecl.
function print_trait_decl(td: parser.TraitDecl, f: Fmt): (string, Fmt) {
    var out: string = "";
    if (td.is_pub) { out = out + "pub "; }
    out = out + "trait " + td.name;
    if (td.type_params.len() > 0) {
        out = out + "[";
        var tpi: i32 = 0;
        while (tpi < td.type_params.len()) {
            if (tpi > 0) { out = out + ", "; }
            out = out + td.type_params[tpi];
            tpi = tpi + 1;
        }
        out = out + "]";
    }
    if (td.supertraits.len() > 0) {
        out = out + ": ";
        var spi: i32 = 0;
        while (spi < td.supertraits.len()) {
            if (spi > 0) { out = out + " + "; }
            out = out + td.supertraits[spi];
            spi = spi + 1;
        }
    }
    if (td.methods.len() == 0) { return (out + " {}\n", f); }
    out = out + " {\n";
    var g: Fmt = f;
    var mi: i32 = 0;
    while (mi < td.methods.len()) {
        var (mtext, mg) = print_trait_method(td.methods[mi], g);
        out = out + mtext;
        g = mg;
        mi = mi + 1;
    }
    return (out + "}\n", g);
}

// print_trait_method emits one signature at one indent level: `;`-terminated
// when it was written abstract, else with its default body.
function print_trait_method(m: parser.FuncDecl, f: Fmt): (string, Fmt) {
    var out: string = indent_str(1) + "function " + m.name + print_type_params(m) + "(";
    var i: i32 = 0;
    while (i < m.params.len()) {
        if (i > 0) { out = out + ", "; }
        if (m.params[i].own) { out = out + "own "; }
        out = out + m.params[i].name;
        if (m.params[i].type_name.len() > 0) { out = out + ": " + m.params[i].type_name; }
        i = i + 1;
    }
    out = out + ")";
    if (m.ret_type.len() > 0) { out = out + ": " + m.ret_type; }
    if (m.body.len() == 0) { return (out + ";\n", f); }
    var (body, g) = print_block(m.body, 1, f);
    return (out + " " + body + "\n", g);
}

function print_type_alias(a: parser.TypeAlias): string {
    var out: string = "";
    if (a.is_pub) { out = out + "pub "; }
    out = out + "type " + a.name + " = ";
    var i: i32 = 0;
    while (i < a.variants.len()) {
        if (i > 0) { out = out + " | "; }
        out = out + a.variants[i];
        i = i + 1;
    }
    return out + ";\n";
}

function print_import(im: parser.Import): string {
    // A `pub use "path".{a, b};` re-export is an import record too, and both
    // its spelling and the `as` ALIAS are load-bearing: dropping either leaves
    // every use of the bound name undefined, so it is data loss rather than a
    // style difference.
    if (im.is_reexport) {
        var re: string = "pub use " + quote_string(im.path) + ".{";
        var ri: i32 = 0;
        while (ri < im.reexport_names.len()) {
            if (ri > 0) { re = re + ", "; }
            re = re + im.reexport_names[ri];
            ri = ri + 1;
        }
        return re + "};\n";
    }
    if (im.alias.len() > 0) {
        return "import " + quote_string(im.path) + " as " + im.alias + ";\n";
    }
    return "import " + quote_string(im.path) + ";\n";
}

// decl_sep is the separator before a top-level declaration: native's formatter
// blank-separates every one of them unconditionally, and emits nothing before
// the first (#6762). Imports are the exception — they cluster with no blank
// between them — so they do not go through this.
function decl_sep(out: string): string {
    if (out.len() == 0) { return ""; }
    return "\n";
}

pub function print_module(mod: parser.Module): string {
    return format_module(mod, [], [], [], []);
}

// format_module is the `-fmt` entry point: the module, the comments the lexer
// collected beside the tokens (`tokenize_full`), and a per-line blank-line map.
// Passing empty lists for both gives the plain printer, which is what
// print_module is.
//
// Declarations emit in SOURCE ORDER rather than grouped by kind. The comment
// cursor only moves forward, so a kind-grouped emit would drain a comment
// against whichever declaration happened to be printed first and RELOCATE it
// onto an unrelated one — the same reason native's Format orders by position.
pub function format_module(mod: parser.Module, traits: parser.TraitDecl[], impls: parser.ImplDecl[], comments: lexer.Comment[], blanks: boolean[]): string {
    var f: Fmt = Fmt { comments: comments, ci: 0, blanks: blanks };
    var out: string = "";
    // Imports cluster at the top with no blank between them.
    var ii: i32 = 0;
    while (ii < mod.imports.len()) {
        if (mod.imports[ii].line > 0) {
            var (ilead, fi2) = drain_leading(f, mod.imports[ii].line, 0);
            out = out + ilead;
            f = fi2;
        }
        out = out + print_import(mod.imports[ii]);
        ii = ii + 1;
    }
    // The declarations to emit, as (kind, index) pairs ordered by source line.
    // kind 0 = struct, 1 = enum (at its first variant's position), 2 = alias,
    // 3 = function/const.
    //
    // An enum is desugared into one variant struct per variant, so it is
    // reconstructed at the position its FIRST variant occupies and its
    // remaining variants are skipped — rendering them as bare structs would
    // drop the enum type and leave every annotation naming it dangling. A
    // variant whose owner is not declared here keeps the struct rendering:
    // `module_with_builtins` synthesises Option / Result variant records with
    // an `enum_owner` and no matching EnumDecl.
    var kinds: i32[] = [];
    var idxs: i32[] = [];
    var lines: i32[] = [];
    var i: i32 = 0;
    while (i < mod.structs.len()) {
        var owner: string = mod.structs[i].enum_owner;
        var ei: i32 = 0 - 1;
        if (owner.len() > 0) { ei = enum_index(mod.enums, owner); }
        if (ei < 0) {
            kinds = kinds.append(0); idxs = idxs.append(i); lines = lines.append(mod.structs[i].line);
        } else if (mod.enums[ei].variant_names[0] == mod.structs[i].name) {
            // The EnumDecl carries the source line; its desugared variant
            // records are all stamped 0, which sorts every enum above the
            // first struct in the file.
            kinds = kinds.append(1); idxs = idxs.append(ei); lines = lines.append(mod.enums[ei].line);
        }
        i = i + 1;
    }
    // A variant-less `enum E {}` has no struct record to be positioned by, so
    // nothing above emits it.
    var vi: i32 = 0;
    while (vi < mod.enums.len()) {
        if (mod.enums[vi].variant_names.len() == 0) {
            kinds = kinds.append(1); idxs = idxs.append(vi); lines = lines.append(mod.enums[vi].line);
        }
        vi = vi + 1;
    }
    var ai: i32 = 0;
    while (ai < mod.aliases.len()) {
        kinds = kinds.append(2); idxs = idxs.append(ai); lines = lines.append(mod.aliases[ai].line);
        ai = ai + 1;
    }
    var ti2: i32 = 0;
    while (ti2 < traits.len()) {
        kinds = kinds.append(4); idxs = idxs.append(ti2); lines = lines.append(traits[ti2].line);
        ti2 = ti2 + 1;
    }
    var ipi: i32 = 0;
    while (ipi < impls.len()) {
        kinds = kinds.append(5); idxs = idxs.append(ipi); lines = lines.append(impls[ipi].line);
        ipi = ipi + 1;
    }
    // SOURCE functions only. `@derive` synthesises its methods at PARSE time
    // (synth_derives), so they are in `mod.funcs` by the time the printer runs —
    // printing them expands one attribute into hand-written method bodies, and
    // the next parse then synthesises them again on top. A synthesised decl is
    // the one with no source position: the parser's lines are 1-based, so
    // `line == 0` cannot name anything the user wrote.
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        if (mod.funcs[fi].line > 0) {
            kinds = kinds.append(3); idxs = idxs.append(fi); lines = lines.append(mod.funcs[fi].line);
        }
        fi = fi + 1;
    }
    // Insertion sort by source line — stable, so two declarations sharing a
    // line keep the order they were collected in.
    var si: i32 = 1;
    while (si < lines.len()) {
        var sj: i32 = si;
        while (sj > 0 && lines[sj - 1] > lines[sj]) {
            var tl: i32 = lines[sj - 1]; var tk: i32 = kinds[sj - 1]; var ti: i32 = idxs[sj - 1];
            lines = lines.with(sj - 1, lines[sj]); kinds = kinds.with(sj - 1, kinds[sj]); idxs = idxs.with(sj - 1, idxs[sj]);
            lines = lines.with(sj, tl); kinds = kinds.with(sj, tk); idxs = idxs.with(sj, ti);
            sj = sj - 1;
        }
        si = si + 1;
    }
    var di: i32 = 0;
    while (di < kinds.len()) {
        var dline: i32 = lines[di];
        if (out.len() > 0) {
            if (f.blank_before(dline) || di > 0 || mod.imports.len() > 0) { out = out + "\n"; }
        }
        if (dline > 0) {
            var (lead, fl) = drain_leading(f, dline, 0);
            out = out + lead;
            f = fl;
        }
        if (kinds[di] == 0) { out = out + print_struct_decl(mod.structs[idxs[di]]); }
        else if (kinds[di] == 1) { out = out + print_enum_decl(mod.enums[idxs[di]], mod.structs); }
        else if (kinds[di] == 2) { out = out + print_type_alias(mod.aliases[idxs[di]]); }
        else if (kinds[di] == 4) {
            var (ttext, tf) = print_trait_decl(traits[idxs[di]], f);
            out = out + ttext;
            f = tf;
        }
        else if (kinds[di] == 5) {
            var (itext, iff) = print_impl_decl(impls[idxs[di]], f);
            out = out + itext;
            f = iff;
        }
        else {
            if (mod.funcs[idxs[di]].is_const) { out = out + print_const_decl(mod.funcs[idxs[di]]); }
            else {
                var (ftext, ff) = print_func_decl(mod.funcs[idxs[di]], f);
                out = out + ftext;
                f = ff;
            }
        }
        di = di + 1;
    }
    var j: i32 = 0;
    while (j < mod.top_stmts.len()) {
        if (out.len() > 0) { out = out + "\n"; }
        var (stext, sf) = print_stmt(mod.top_stmts[j], 0, f);
        out = out + stext;
        f = sf;
        j = j + 1;
    }
    // Comments past the last declaration.
    var (tail, _) = drain_all(f, 0);
    return out + tail;
}

// =================== VALIDATION ====================

// Round-trip: parse → print → parse again → assert the same
// shape comes back. Catches printer bugs that would silently
// drop or mangle nodes.
function roundtrip_module(src: string): parser.Module {
    var toks: lexer.Token[] = lexer.tokenize(src);
    var mod: parser.Module = parser.parse_module(toks);
    var emitted: string = print_module(mod);
    var toks2: lexer.Token[] = lexer.tokenize(emitted);
    return parser.parse_module(toks2);
}

function main(): i32 {
    // Expression printing: ensure the binary-op rendering
    // parenthesises and round-trips. `1 + 2 * 3` parses as
    // `1 + (2*3)` (precedence) and prints as `(1 + (2 * 3))`.
    var toks1: lexer.Token[] = lexer.tokenize("var a = 1 + 2 * 3; return a;");
    var mod1: parser.Module = parser.parse_module(toks1);
    var s1: string = print_module(mod1);
    // Re-parse the emitted text and confirm we still get two
    // top-level stmts with the same shape.
    var rt1: parser.Module = parser.parse_module(lexer.tokenize(s1));
    if (rt1.top_stmts.len() != 2) { return 10; }
    match (rt1.top_stmts[0]) {
        parser.StmtVar(v) => {
            if (v.name != "a") { return 11; }
            match (v.init) {
                parser.ExprBinary(b) => { if (b.op != "+") { return 12; } },
                _ => { return 13; }
            }
        },
        _ => { return 14; }
    }

    // Function decl + call: print + re-parse preserves both
    // functions and the call site shape.
    var src2: string = "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }";
    var rt2: parser.Module = roundtrip_module(src2);
    if (rt2.funcs.len() != 2) { return 20; }
    if (rt2.funcs[0].name != "add") { return 21; }
    if (rt2.funcs[0].params.len() != 2) { return 22; }
    if (rt2.funcs[0].params[0].type_name != "i32") { return 23; }
    if (rt2.funcs[1].name != "main") { return 24; }

    // If/else with assignment: round-trip the whole thing.
    var src3: string = "var x = 5; if (x < 10) { x = x + 1; } else { x = 0; } return x;";
    var rt3: parser.Module = roundtrip_module(src3);
    if (rt3.top_stmts.len() != 3) { return 30; }
    match (rt3.top_stmts[1]) {
        parser.StmtIf(ifs) => {
            if (ifs.then_body.len() != 1) { return 31; }
            if (ifs.else_body.len() != 1) { return 32; }
        },
        _ => { return 33; }
    }

    // While + array literal + index + len.
    var src4: string = "var a = [3, 5, 7]; var i = 0; var s = 0; while (i < len(a)) { s = s + a[i]; i = i + 1; } return s;";
    var rt4: parser.Module = roundtrip_module(src4);
    if (rt4.top_stmts.len() != 5) { return 40; }
    match (rt4.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprArray(a) => { if (a.elements.len() != 3) { return 41; } },
                _ => { return 42; }
            }
        },
        _ => { return 43; }
    }
    // While loop preserved with body of length 2.
    match (rt4.top_stmts[3]) {
        parser.StmtWhile(w) => {
            if (w.body.len() != 2) { return 44; }
        },
        _ => { return 45; }
    }

    // String literal escapes round-trip (`"a\"b\n"` → same).
    var src5: string = "var s = \"hello\\nworld\"; return 0;";
    var rt5: parser.Module = roundtrip_module(src5);
    match (rt5.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprString(_) => { },
                _ => { return 50; }
            }
        },
        _ => { return 51; }
    }

    // Slice round-trip: `s[1:4]` → re-parses as an ExprSlice.
    var src6: string = "var s = \"hello\"; var t = s[1:4]; return 0;";
    var rt6: parser.Module = roundtrip_module(src6);
    match (rt6.top_stmts[1]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprSlice(_) => { },
                _ => { return 60; }
            }
        },
        _ => { return 61; }
    }

    // Struct decls + struct literals round-trip.
    var src7: string = "struct Point { x: i32, y: i32 } function main(): i32 { var p = Point { x: 3, y: 4 }; return p.x; }";
    var rt7: parser.Module = roundtrip_module(src7);
    if (rt7.structs.len() != 1) { return 70; }
    if (rt7.structs[0].name != "Point") { return 71; }
    if (rt7.structs[0].fields.len() != 2) { return 72; }
    if (rt7.funcs.len() != 1) { return 73; }

    // Type alias round-trip.
    var src8: string = "struct Circle { r: i32 } struct Square { s: i32 } type Shape = Circle | Square; function main(): i32 { return 0; }";
    var rt8: parser.Module = roundtrip_module(src8);
    if (rt8.aliases.len() != 1) { return 80; }
    if (rt8.aliases[0].name != "Shape") { return 81; }
    if (rt8.aliases[0].variants.len() != 2) { return 82; }

    // Match statement round-trip.
    var src9: string = "var x = 0; match (x) { Foo(f) => { return 1; }, _ => { return 0; } }";
    var rt9: parser.Module = roundtrip_module(src9);
    if (rt9.top_stmts.len() != 2) { return 90; }
    match (rt9.top_stmts[1]) {
        parser.StmtMatch(m) => {
            if (m.arms.len() != 2) { return 91; }
            match (m.arms[0].pattern) {
                parser.PatVariant(pv) => {
                    if (pv.type_name != "Foo") { return 92; }
                    if (pv.binding != "f") { return 93; }
                },
                _ => { return 94; }
            }
        },
        _ => { return 95; }
    }

    // Var type annotation round-trip.
    var srcA: string = "var n: i32 = 7; var sh: Shape = c; return n;";
    var rtA: parser.Module = roundtrip_module(srcA);
    match (rtA.top_stmts[0]) {
        parser.StmtVar(v) => {
            if (v.type_name != "i32") { return 100; }
        },
        _ => { return 101; }
    }
    match (rtA.top_stmts[1]) {
        parser.StmtVar(v) => {
            if (v.type_name != "Shape") { return 102; }
        },
        _ => { return 103; }
    }

    // Receiver method round-trip.
    var srcB: string = "function (p: Par) advance(): Par { return p; } function main(): i32 { return 0; }";
    var rtB: parser.Module = roundtrip_module(srcB);
    if (rtB.funcs.len() != 2) { return 110; }
    if (rtB.funcs[0].name != "advance") { return 111; }
    if (rtB.funcs[0].receiver_name != "p") { return 112; }
    if (rtB.funcs[0].receiver_type != "Par") { return 113; }
    if (rtB.funcs[1].receiver_name != "") { return 114; }

    // Import round-trip — multiple imports survive emit + re-
    // parse with the same path list.
    var srcC: string = "import \"./lexer\"; import \"./parser\"; function main(): i32 { return 0; }";
    var rtC: parser.Module = roundtrip_module(srcC);
    if (rtC.imports.len() != 2) { return 120; }
    if (rtC.imports[0].path != "./lexer") { return 121; }
    if (rtC.imports[1].path != "./parser") { return 122; }
    if (rtC.funcs.len() != 1) { return 123; }

    // For-in + break / continue + tuple all round-trip.
    var srcD: string = "for n in [1, 2, 3] { if (n == 2) { break; } if (n == 1) { continue; } }";
    var rtD: parser.Module = roundtrip_module(srcD);
    if (rtD.top_stmts.len() != 1) { return 130; }
    match (rtD.top_stmts[0]) {
        parser.StmtFor(f) => {
            if (f.var_name != "n") { return 131; }
            if (f.body.len() != 2) { return 132; }
            match (f.body[0]) {
                parser.StmtIf(ifs) => {
                    match (ifs.then_body[0]) {
                        parser.StmtBreak(_) => { },
                        _ => { return 133; }
                    }
                },
                _ => { return 134; }
            }
            match (f.body[1]) {
                parser.StmtIf(ifs) => {
                    match (ifs.then_body[0]) {
                        parser.StmtContinue(_) => { },
                        _ => { return 135; }
                    }
                },
                _ => { return 136; }
            }
        },
        _ => { return 137; }
    }

    // Tuple round-trip via printer: a bound tuple plus a
    // separate field-access expression survive emit + re-
    // parse with the same shape. Postfix directly on a
    // tuple literal (`(1,2,3).0`) isn't supported yet — the
    // parser's postfix-chain is inside the TokIdent branch.
    var srcE: string = "var t = (10, 20, 30); var x = t.0; return x;";
    var rtE: parser.Module = roundtrip_module(srcE);
    if (rtE.top_stmts.len() != 3) { return 140; }
    match (rtE.top_stmts[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprTuple(t) => {
                    if (t.elements.len() != 3) { return 141; }
                },
                _ => { return 142; }
            }
        },
        _ => { return 143; }
    }
    match (rtE.top_stmts[1]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprFieldAccess(fa) => {
                    if (fa.field != "0") { return 144; }
                },
                _ => { return 145; }
            }
        },
        _ => { return 146; }
    }

    // Lambda round-trip: `var f = function (x: i32): i32 { return
    // x + 1; }; return f(41);` — print should emit a re-parseable
    // `function (...)` literal.
    var srcF: string = "function main(): i32 { var f = function (x: i32): i32 { return x + 1; }; return f(41); }";
    var rtF: parser.Module = roundtrip_module(srcF);
    if (rtF.funcs.len() != 1) { return 150; }
    if (rtF.funcs[0].body.len() != 2) { return 151; }
    match (rtF.funcs[0].body[0]) {
        parser.StmtVar(v) => {
            if (v.name != "f") { return 152; }
            match (v.init) {
                parser.ExprLambda(lm) => {
                    if (lm.params.len() != 1) { return 153; }
                    if (lm.params[0].name != "x") { return 154; }
                    if (lm.params[0].type_name != "i32") { return 155; }
                    if (lm.ret_type != "i32") { return 156; }
                    if (lm.body.len() != 1) { return 157; }
                },
                _ => { return 158; }
            }
        },
        _ => { return 159; }
    }

    // IIFE round-trip: `function () { return 7; }()` — printer
    // wraps the lambda the same way and the re-parse sees an
    // ExprCall whose callee is an ExprLambda.
    var srcG: string = "function main(): i32 { return function (): i32 { return 7; }(); }";
    var rtG: parser.Module = roundtrip_module(srcG);
    match (rtG.funcs[0].body[0]) {
        parser.StmtReturn(r) => {
            match (r.value) {
                parser.ExprCall(cc) => {
                    match (cc.callee) {
                        parser.ExprLambda(_) => { },
                        _ => { return 161; }
                    }
                },
                _ => { return 162; }
            }
        },
        _ => { return 163; }
    }

    // Qualified-name call round-trip: `parser.parse_module(x)`.
    // The printer emits ExprFieldAccess as `obj.field` and ExprCall
    // wraps it the same way, so the re-parse should preserve the
    // ExprCall(ExprFieldAccess(ExprIdent), field) shape.
    var srcH: string = "function main(): i32 { return parser.parse_module(42); }";
    var rtH: parser.Module = roundtrip_module(srcH);
    match (rtH.funcs[0].body[0]) {
        parser.StmtReturn(r) => {
            match (r.value) {
                parser.ExprCall(cc) => {
                    match (cc.callee) {
                        parser.ExprFieldAccess(fa) => {
                            if (fa.field != "parse_module") { return 171; }
                            match (fa.obj) {
                                parser.ExprIdent(id) => {
                                    if (id.name != "parser") { return 172; }
                                },
                                _ => { return 173; }
                            }
                        },
                        _ => { return 174; }
                    }
                },
                _ => { return 175; }
            }
        },
        _ => { return 176; }
    }

    // @import extern declaration round-trip (P4 — docs/WIT-BRING-YOUR-OWN.md):
    // a body-less function bound by `@import("iface", "wit")` survives parse →
    // print → re-parse with both binding strings intact and an empty body.
    var srcI: string = "@import(\"wasi:random/random@0.2.0\", \"get-random-u64\")\nfunction random_u64(): u64; function main(): i32 { return 0; }";
    var modI: parser.Module = parser.parse_module(lexer.tokenize(srcI));
    if (modI.funcs.len() != 2) { return 180; }
    if (modI.funcs[0].name != "random_u64") { return 181; }
    if (modI.funcs[0].import_iface != "wasi:random/random@0.2.0") { return 182; }
    if (modI.funcs[0].import_wit != "get-random-u64") { return 183; }
    if (modI.funcs[0].body.len() != 0) { return 184; }
    // Ordinary functions carry empty binding strings.
    if (modI.funcs[1].import_iface.len() != 0) { return 185; }
    var rtI: parser.Module = roundtrip_module(srcI);
    if (rtI.funcs.len() != 2) { return 186; }
    if (rtI.funcs[0].import_iface != "wasi:random/random@0.2.0") { return 187; }
    if (rtI.funcs[0].import_wit != "get-random-u64") { return 188; }
    if (rtI.funcs[0].body.len() != 0) { return 189; }

    // Declaration MODIFIERS survive the round trip (#6660). Each of these
    // changes what the program MEANS, so a printer that drops one makes
    // formatting a semantics change rather than a layout one: `fip` selects the
    // E053 no-allocation walk, `@must_consume` arms E067, and `@derive` names
    // the methods the next parse synthesises.
    //
    // Every assertion reads the FIELD back, never just the name — a dropped bit
    // round-trips through a name-and-arity check without complaint, which is
    // exactly how this went unnoticed.
    var srcM: string = "fip function pure_add(a: i32, b: i32): i32 { return a + b; } function main(): i32 { return pure_add(1, 2); }";
    var rtM: parser.Module = roundtrip_module(srcM);
    if (rtM.funcs.len() != 2) { return 190; }
    if (rtM.funcs[0].name != "pure_add") { return 191; }
    if (!rtM.funcs[0].fip) { return 192; }
    if (rtM.funcs[0].fbip || rtM.funcs[0].fip_allowance != 0) { return 164; }
    // The non-fip sibling must NOT pick the modifier up.
    if (rtM.funcs[1].fip) { return 193; }

    // `fbip` and the graded `(n)` are separate bits, and each changes what the
    // IR's E068 budget check permits — a printer that normalised either into a
    // plain `fip` would turn a legal body into an E053 rejection on reparse.
    var srcFB: string = "fbip function keep(a: i32): i32 { return a; } function main(): i32 { return keep(1); }";
    var rtFB: parser.Module = roundtrip_module(srcFB);
    if (rtFB.funcs.len() != 2) { return 165; }
    if (!rtFB.funcs[0].fbip || rtFB.funcs[0].fip) { return 166; }
    if (rtFB.funcs[0].fip_allowance != 0) { return 167; }

    var srcFG: string = "fbip(2) function graded(a: i32): i32 { return a; } fip(1) function g1(a: i32): i32 { return a; } function main(): i32 { return graded(1) + g1(2); }";
    var rtFG: parser.Module = roundtrip_module(srcFG);
    if (rtFG.funcs.len() != 3) { return 168; }
    if (!rtFG.funcs[0].fbip || rtFG.funcs[0].fip_allowance != 2) { return 169; }
    if (!rtFG.funcs[1].fip || rtFG.funcs[1].fbip || rtFG.funcs[1].fip_allowance != 1) { return 170; }

    var srcMC: string = "@must_consume\nstruct Res { code: i32 } function main(): i32 { var r: Res = Res { code: 7 }; return r.code; }";
    var rtMC: parser.Module = roundtrip_module(srcMC);
    if (rtMC.structs.len() != 1) { return 194; }
    if (!rtMC.structs[0].must_consume) { return 195; }

    // `@derive` must survive as the ATTRIBUTE. The methods it names are
    // synthesised at parse time, so a printer that emits them instead expands
    // one attribute into hand-written bodies — and the re-parse then synthesises
    // them again on top, which is what the function count catches.
    var srcDrv: string = "@derive(Eq)\nstruct Pt { x: i32 } function main(): i32 { var p: Pt = Pt { x: 1 }; return p.x; }";
    var modDrv: parser.Module = parser.parse_module(lexer.tokenize(srcDrv));
    var rtDrv: parser.Module = roundtrip_module(srcDrv);
    if (rtDrv.structs.len() != 1) { return 196; }
    if (rtDrv.structs[0].derives.len() != 1) { return 197; }
    if (rtDrv.structs[0].derives[0] != "Eq") { return 198; }
    if (rtDrv.funcs.len() != modDrv.funcs.len()) { return 199; }

    // `async` is the same class of modifier (#6631): it selects the Preview-3
    // `canon lift async` export surface, so dropping it changes what a
    // `-target wasm32-wasi -emit core-module` build exports. The bit has to survive BOTH the parse
    // and the print — the AST-rewrite passes each rebuild a FuncDecl field by
    // field, so a copy site that hardcodes `async: false` drops it downstream
    // of a parse that reported it set, which only the round trip catches.
    var srcJ: string = "async function work(): i32 { return 7; } function main(): i32 { return work(); }";
    var modJ: parser.Module = parser.parse_module(lexer.tokenize(srcJ));
    if (modJ.funcs.len() != 2) { return 200; }
    if (!modJ.funcs[0].async) { return 201; }
    if (modJ.funcs[1].async) { return 202; }
    var rtJ: parser.Module = roundtrip_module(srcJ);
    if (rtJ.funcs.len() != 2) { return 203; }
    if (!rtJ.funcs[0].async) { return 204; }
    if (rtJ.funcs[1].async) { return 205; }
    // `pub async function` — `pub` is stripped by the parser and stays dropped
    // (#6633); the `async` bit behind it must still survive.
    var rtK: parser.Module = roundtrip_module("pub async function w(): i32 { return 1; }");
    if (rtK.funcs.len() != 1) { return 206; }
    if (!rtK.funcs[0].async) { return 207; }
    // Contextual only: `async` followed by anything else stays an ordinary
    // identifier, and no function is marked.
    var rtL: parser.Module = roundtrip_module("function main(): i32 { var async: i32 = 3; return async + 4; }");
    if (rtL.funcs.len() != 1) { return 208; }
    if (rtL.funcs[0].async) { return 209; }

    // An enum must survive as an ENUM. The parser desugars it into one struct
    // per variant, so a printer with no enum arm renders those structs and the
    // type itself disappears — output that no longer compiles, because the
    // annotations naming it are still there. Every assertion below reads back
    // through `enum_owner` rather than the variant names, since the variants
    // come back under their own names either way.
    var srcEnum: string = "@derive(Eq)\nenum Color { Red, Green(i32) } function main(): i32 { var c: Color = Red; return 0; }";
    var modEnum: parser.Module = parser.parse_module(lexer.tokenize(srcEnum));
    var rtEnum: parser.Module = roundtrip_module(srcEnum);
    if (rtEnum.enums.len() != 1) { return 210; }
    if (rtEnum.enums[0].name != "Color") { return 211; }
    if (rtEnum.enums[0].variant_names.len() != 2) { return 212; }
    if (rtEnum.enums[0].variant_names[0] != "Red") { return 213; }
    if (rtEnum.enums[0].variant_names[1] != "Green") { return 214; }
    var rgi: i32 = variant_decl_index(rtEnum.structs, "Color", "Green");
    if (rgi < 0) { return 215; }
    if (rtEnum.structs[rgi].fields.len() != 1) { return 216; }
    if (rtEnum.structs[rgi].fields[0].type_name != "i32") { return 217; }
    // …and the payload-less variant must not acquire one.
    var rri: i32 = variant_decl_index(rtEnum.structs, "Color", "Red");
    if (rri < 0) { return 218; }
    if (rtEnum.structs[rri].fields.len() != 0) { return 219; }
    // No variant may come back as a free-standing struct.
    var esi: i32 = 0;
    while (esi < rtEnum.structs.len()) {
        if (rtEnum.structs[esi].enum_owner.len() == 0) { return 220; }
        esi = esi + 1;
    }
    // `@derive` once on the enum, not once per variant: the re-parse
    // synthesises the same method set the first parse did.
    if (rtEnum.structs[rgi].derives.len() != 1) { return 221; }
    if (rtEnum.structs[rgi].derives[0] != "Eq") { return 222; }
    if (rtEnum.funcs.len() != modEnum.funcs.len()) { return 223; }

    // Generic parameters and `@must_consume` live on the EnumDecl, not on the
    // variant records, so they travel a different route out of the printer.
    var srcEG: string = "@must_consume\nenum Slot[T] { Full(T), Empty } function main(): i32 { return 0; }";
    var rtEG: parser.Module = roundtrip_module(srcEG);
    if (rtEG.enums.len() != 1) { return 224; }
    if (!rtEG.enums[0].must_consume) { return 225; }
    if (rtEG.enums[0].type_params.len() != 1) { return 226; }
    if (rtEG.enums[0].type_params[0] != "T") { return 227; }
    var fgi: i32 = variant_decl_index(rtEG.structs, "Slot", "Full");
    if (fgi < 0) { return 228; }
    if (rtEG.structs[fgi].fields[0].type_name != "T") { return 229; }

    // A multi-payload variant keeps every payload, in order.
    var srcEM: string = "enum Pair { Two(i32, string), Neither } function main(): i32 { return 0; }";
    var rtEM: parser.Module = roundtrip_module(srcEM);
    var tpi: i32 = variant_decl_index(rtEM.structs, "Pair", "Two");
    if (tpi < 0) { return 230; }
    if (rtEM.structs[tpi].fields.len() != 2) { return 231; }
    if (rtEM.structs[tpi].fields[0].type_name != "i32") { return 232; }
    if (rtEM.structs[tpi].fields[1].type_name != "string") { return 233; }

    // A record-form variant round-trips with its field NAMES — printed
    // positionally the re-parse would lose them and the `{ w, h }` patterns
    // that destructure it would stop resolving.
    var srcER: string = "enum Shape { Rect { w: i32, h: string }, Unit } function main(): i32 { return 0; }";
    var rtER: parser.Module = roundtrip_module(srcER);
    var rcvi: i32 = variant_decl_index(rtER.structs, "Shape", "Rect");
    if (rcvi < 0) { return 234; }
    if (rtER.structs[rcvi].variant_field_names.len() != 2) { return 235; }
    if (rtER.structs[rcvi].variant_field_names[0] != "w") { return 236; }
    if (rtER.structs[rcvi].variant_field_names[1] != "h") { return 237; }
    if (rtER.structs[rcvi].fields.len() != 2) { return 238; }
    if (rtER.structs[rcvi].fields[0].name != "__ev") { return 239; }
    if (rtER.structs[rcvi].fields[1].name != "__ev1") { return 240; }
    if (rtER.structs[rcvi].fields[1].type_name != "string") { return 241; }
    var uri: i32 = variant_decl_index(rtER.structs, "Shape", "Unit");
    if (uri < 0) { return 242; }
    if (rtER.structs[uri].variant_field_names.len() != 0) { return 243; }

    // Every payload binding of a match arm survives the round-trip: printing
    // only the first turns `Pair(a, b)` into an E015 one-binding pattern.
    var srcPB: string = "enum Pair { Two(i32, i32) } function f(p: Pair): i32 { match (p) { Two(a, b) => { return a + b; }, } return 0; } function main(): i32 { return 0; }";
    var rtPB: parser.Module = roundtrip_module(srcPB);
    if (rtPB.funcs.len() < 1) { return 244; }
    match (rtPB.funcs[0].body[0]) {
        parser.StmtMatch(m) => {
            match (m.arms[0].pattern) {
                parser.PatVariant(pv) => {
                    if (pv.binding != "a") { return 245; }
                    if (pv.extra_bindings.len() != 1) { return 246; }
                    if (pv.extra_bindings[0] != "b") { return 247; }
                },
                _ => { return 248; }
            }
        },
        _ => { return 249; }
    }
    // A `const` desugars to a zero-arg FuncDecl. It was dropped outright,
    // because the synthesised-decl filter keys on `line == 0` and the desugar
    // left the position there — so the declaration vanished while every
    // reference to it survived.
    //
    // The assertions read `is_const` back, not just the name: printing the
    // desugar as `function LIMIT(): i32 { return 41; }` also makes the name
    // resolve, and the self-host even compiles it, but NATIVE rejects that
    // form — it has no rule making a bare zero-arg-function reference a call.
    // Losing the marker is therefore a silent rewrite into something only one
    // compiler accepts, which a name-and-arity check would not catch.
    var srcConst: string = "const LIMIT: i32 = 41; function main(): i32 { return LIMIT + 1; }";
    var rtConst: parser.Module = roundtrip_module(srcConst);
    if (rtConst.funcs.len() != 2) { return 250; }
    var limit_i: i32 = 0 - 1;
    var ci: i32 = 0;
    while (ci < rtConst.funcs.len()) {
        if (rtConst.funcs[ci].name == "LIMIT") { limit_i = ci; }
        ci = ci + 1;
    }
    if (limit_i < 0) { return 251; }
    if (!rtConst.funcs[limit_i].is_const) { return 252; }
    if (rtConst.funcs[limit_i].ret_type != "i32") { return 253; }
    // …and an ordinary zero-arg function, whose AST shape is identical, must
    // NOT come back marked — that is what stops the printer guessing by shape.
    var rtFn: parser.Module = roundtrip_module("function LIMIT(): i32 { return 41; }");
    if (rtFn.funcs.len() != 1) { return 254; }
    if (rtFn.funcs[0].is_const) { return 255; }

    // Every `for` reprints as the sugar the source wrote, not as the desugar
    // it parses to (#6771). Round-tripping is not enough to see this: the
    // expansion re-parses to itself, so the assertions read the emitted TEXT
    // and reject the synthesised names — `__forc_<line>_<col>` bakes the
    // loop's position into the program, so the same loop one line down would
    // otherwise reformat to different source.
    var srcCFor: string = "function main(): i32 { var s: i32 = 0; for (var i: i32 = 0; i < 3; i = i + 1) { s = s + i; } return s; }";
    var outCFor: string = print_module(parser.parse_module(lexer.tokenize(srcCFor)));
    if (!util.contains(outCFor, "for (var i: i32 = 0; i < 3; i = i + 1) {")) { return 260; }
    if (util.contains(outCFor, "__forc_")) { return 261; }
    // …and it still re-parses to the same desugar, so the loop the compiler
    // sees is unchanged.
    var rtCFor: parser.Module = roundtrip_module(srcCFor);
    if (rtCFor.funcs.len() != 1) { return 262; }
    match (rtCFor.funcs[0].body[1]) {
        parser.StmtIf(cf) => { if (!as_c_for(cf).ok) { return 263; } },
        _ => { return 264; }
    }

    // An omitted INIT / STEP keeps the header's arity.
    var outBare: string = print_module(parser.parse_module(lexer.tokenize(
        "function main(): i32 { var i: i32 = 0; for (; i < 3; ) { i = i + 1; } return i; }")));
    if (!util.contains(outBare, "for (; i < 3; ) {")) { return 265; }

    // The range forms are carried as a synthetic `__range` / `__range_incl`
    // call, which is a parser-internal name no source may spell.
    var outRange: string = print_module(parser.parse_module(lexer.tokenize(
        "function main(): i32 { var t: i32 = 0; for i in 0..4 { t = t + i; } for j in 0..=4 { t = t + j; } return t; }")));
    if (!util.contains(outRange, "for i in 0..4 {")) { return 266; }
    if (!util.contains(outRange, "for j in 0..=4 {")) { return 267; }
    if (util.contains(outRange, "__range")) { return 268; }

    // The map form stores its two binders comma-joined in the one field;
    // reprinting that bare gives `for k,v in m`, which does not parse.
    var outMap: string = print_module(parser.parse_module(lexer.tokenize(
        "function main(m: map[string, i32]): i32 { var t: i32 = 0; for (k, v) in m { t = t + v; } return t; }")));
    if (!util.contains(outMap, "for (k, v) in m {")) { return 269; }

    // A label and the break / continue naming it are one fact written twice.
    var srcLabels: string = "function main(): i32 { var t: i32 = 0; outer: while (t < 10) { inner: for (var i: i32 = 0; i < 3; i = i + 1) { if (i == 2) { continue outer; } break inner; } t = t + 1; } return t; }";
    var outLabels: string = print_module(parser.parse_module(lexer.tokenize(srcLabels)));
    if (!util.contains(outLabels, "outer: while (t < 10) {")) { return 270; }
    if (!util.contains(outLabels, "inner: for (var i: i32 = 0; i < 3; i = i + 1) {")) { return 271; }
    if (!util.contains(outLabels, "continue outer;")) { return 272; }
    if (!util.contains(outLabels, "break inner;")) { return 273; }

    // #6773: `pub` on a struct / enum / alias. Printed from is_pub, which
    // already recorded the written keyword — nothing read it, so a formatted
    // library file kept its function exports and lost every type export.
    var srcVis: string = "pub struct A { x: i32 } struct B { y: i32 } pub enum C { P } enum D { Q } pub type E = A | B; type F = A | B; function main(): i32 { return 0; }";
    var rtVis: parser.Module = roundtrip_module(srcVis);
    if (!rtVis.structs[struct_index(rtVis.structs, "A")].is_pub) { return 280; }
    if (rtVis.structs[struct_index(rtVis.structs, "B")].is_pub) { return 281; }
    if (!rtVis.enums[enum_index(rtVis.enums, "C")].is_pub) { return 282; }
    if (rtVis.enums[enum_index(rtVis.enums, "D")].is_pub) { return 283; }
    if (rtVis.aliases.len() != 2) { return 284; }
    if (!rtVis.aliases[0].is_pub) { return 285; }
    if (rtVis.aliases[1].is_pub) { return 286; }

    // #6773: both destructuring forms. Printed as a plain `var` the tuple one
    // emitted `var a,b = …`, which is not syntax the parser accepts back — so
    // the re-parse is the assertion.
    var srcTd: string = "function pair(): (i32, i32) { return (1, 2); } function main(): i32 { let (a, b) = pair(); return a + b; }";
    var rtTd: parser.Module = roundtrip_module(srcTd);
    var mti: i32 = func_index(rtTd.funcs, "main");
    if (mti < 0) { return 287; }
    if (rtTd.funcs[mti].body.len() != 2) { return 288; }
    match (rtTd.funcs[mti].body[0]) {
        parser.StmtVar(v) => {
            if (v.name != "a,b") { return 289; }
            if (v.type_name.len() != 0) { return 290; }
        },
        _ => { return 291; }
    }
    // The struct form keeps the type it destructures and each field's binding,
    // including a field renamed on binding (`y: bb`).
    var srcSd: string = "struct P { x: i32, y: i32 } function main(): i32 { let P { x, y: bb } = P { x: 1, y: 2 }; return x + bb; }";
    var rtSd: parser.Module = roundtrip_module(srcSd);
    var msi: i32 = func_index(rtSd.funcs, "main");
    if (msi < 0) { return 292; }
    match (rtSd.funcs[msi].body[0]) {
        parser.StmtVar(v) => {
            if (v.name != "x,bb") { return 293; }
            if (v.type_name != "@sd:P:x,y") { return 294; }
        },
        _ => { return 295; }
    }

    // #6773: a METHOD's type parameters are written before its receiver. The
    // parser accepts that spelling now, so the printer's own output re-parses.
    var srcMt: string = "enum Opt[T] { Some(T), None } pub function [U] (o: Opt[T]) map(f: (T) => U): Opt[U] { return None; } function main(): i32 { return 0; }";
    var rtMt: parser.Module = roundtrip_module(srcMt);
    var mmi: i32 = func_index(rtMt.funcs, "map");
    if (mmi < 0) { return 296; }
    if (rtMt.funcs[mmi].receiver_name != "o") { return 297; }
    if (rtMt.funcs[mmi].type_param_count != 1) { return 298; }

    // #6773 item 3: a `trait` block reaches the printer only through the two
    // DERIVED views the compile path keeps, so it has to be retained beside the
    // Module. The re-parse is the assertion: an emitted trait that does not
    // come back is a declaration the reformat deleted.
    var srcTr: string = "pub trait Greet[T]: Display { function hi(self: Self, x: T): string; function loud(self: Self, x: T): string { return self.hi(x); } } function main(): i32 { return 0; }";
    var pfTr: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(srcTr));
    var outTr: string = format_module(pfTr.pmod, pfTr.ptraits, pfTr.pimpls, [], []);
    var rtTr: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(outTr));
    if (rtTr.ptraits.len() != 1) { return 299; }
    if (rtTr.ptraits[0].name != "Greet") { return 300; }
    if (!rtTr.ptraits[0].is_pub) { return 301; }
    if (rtTr.ptraits[0].type_params.len() != 1) { return 302; }
    if (rtTr.ptraits[0].type_params[0] != "T") { return 303; }
    if (rtTr.ptraits[0].supertraits.len() != 1) { return 304; }
    if (rtTr.ptraits[0].supertraits[0] != "Display") { return 305; }
    // Both methods, in source order, with the abstract / default split intact.
    if (rtTr.ptraits[0].methods.len() != 2) { return 306; }
    if (rtTr.ptraits[0].methods[0].name != "hi") { return 307; }
    if (rtTr.ptraits[0].methods[0].body.len() != 0) { return 308; }
    if (rtTr.ptraits[0].methods[1].name != "loud") { return 309; }
    if (rtTr.ptraits[0].methods[1].body.len() == 0) { return 310; }
    // A qualified supertrait keeps its module prefix — printed bare it names a
    // trait that may not be in scope.
    var pfQ: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
        "import \"core/cmp\"; pub trait Sortable: cmp.Ord {} function main(): i32 { return 0; }"));
    if (pfQ.ptraits.len() != 1) { return 311; }
    if (pfQ.ptraits[0].supertraits.len() != 1) { return 312; }
    if (pfQ.ptraits[0].supertraits[0] != "cmp.Ord") { return 313; }
    if (!util.contains(format_module(pfQ.pmod, pfQ.ptraits, pfQ.pimpls, [], []), "pub trait Sortable: cmp.Ord {}")) { return 314; }

    // #6783: an `impl` block is desugared into free-standing receiver methods on
    // the way in, so the block has to be retained beside the Module too. Under
    // the formatter's parse its methods live on the ImplDecl ALONE — leaving
    // them on Module.funcs as well would print each one twice.
    var srcIm: string = "trait Display { function to_string(self: Self): string; } impl Display for i32 {} impl Display for boolean { function to_string(self: Self): string { return \"t\"; } } function main(): i32 { return 0; }";
    var pfIm: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(srcIm));
    if (pfIm.pimpls.len() != 2) { return 315; }
    if (pfIm.pimpls[0].trait_ref != "Display") { return 316; }
    if (pfIm.pimpls[0].type_ref != "i32") { return 317; }
    if (pfIm.pimpls[0].methods.len() != 0) { return 318; }
    if (pfIm.pimpls[1].methods.len() != 1) { return 319; }
    // The written method is NOT also a free function, or it would print twice.
    if (func_index(pfIm.pmod.funcs, "to_string") >= 0) { return 320; }
    var outIm: string = format_module(pfIm.pmod, pfIm.ptraits, pfIm.pimpls, [], []);
    if (!util.contains(outIm, "impl Display for i32 {}")) { return 321; }
    // `Self` reads as the concrete type and the receiver goes back to being the
    // first parameter — the shape an impl block requires, and what native emits.
    if (!util.contains(outIm, "function to_string(self: boolean): string {")) { return 322; }
    var rtIm: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(outIm));
    if (rtIm.pimpls.len() != 2) { return 323; }

    // An inherent `impl Type { … }` has no trait, and an associated function
    // (no `self`) keeps its parameter list exactly as written.
    var pfIn: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
        "struct Box { item: i32 } impl Box { function zero(): Box { return Box { item: 0 }; } } function main(): i32 { return 0; }"));
    if (pfIn.pimpls.len() != 1) { return 324; }
    if (pfIn.pimpls[0].trait_ref.len() != 0) { return 325; }
    if (!util.contains(format_module(pfIn.pmod, pfIn.ptraits, pfIn.pimpls, [], []), "impl Box {")) { return 326; }
    if (!util.contains(format_module(pfIn.pmod, pfIn.ptraits, pfIn.pimpls, [], []), "function zero(): Box {")) { return 327; }

    // A parametric impl states its bounds once, on the block: restating them on
    // each method is a program native rejects outright.
    var pfPa: parser.ParsedFmt = parser.parse_module_verbatim(lexer.tokenize(
        "import \"core/cmp\"; struct Box[T] { item: T } impl[T: cmp.Eq] cmp.Eq for Box[T] { function eq(self: Self, other: Self): boolean { return true; } } function main(): i32 { return 0; }"));
    if (pfPa.pimpls.len() != 1) { return 328; }
    var outPa: string = format_module(pfPa.pmod, pfPa.ptraits, pfPa.pimpls, [], []);
    if (!util.contains(outPa, "impl[T: cmp.Eq] cmp.Eq for Box[T] {")) { return 329; }
    if (!util.contains(outPa, "function eq(self: Box[T], other: Box[T]): boolean {")) { return 330; }

    return 0;
}

// struct_index / func_index locate a declaration by name for the assertions
// above, which cannot rely on declaration order surviving the round-trip.
function struct_index(structs: parser.StructDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name && structs[i].enum_owner.len() == 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function func_index(funcs: parser.FuncDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
