// examples/self_host/fnsigs.fern — the whole-program registries the emitters'
// field-reclaim admissions read. FnSigs carries the borrowability registry
// (borrowable_params_interproc, widened with the counted "CNT:" rows
// param_counted_of proves) and the string-field verdict
// (strfld_reclaim_ok_types_of); structfld_reclaim_ok_types_of derives the
// nested-field verdict from the first, and wp_fact_rows folds all three into
// the per-unit cache key. Every analysis here reads the AST.

import "./ast";
import "./parser";
import "./util";
import "./astwalk";
import "./enumcontract";
import "./irtables";

// FnSigs is the whole-program registry pair the emitters' field-reclaim
// admissions read, derived once per program (ircore.wp_fn_sigs) and threaded
// read-only.
pub struct FnSigs {
  // borrowable_params: params a callee only reads, so the caller need not
  // retain across the call, plus the counted-position "CNT:" rows. The emit
  // paths pass an inter-procedural fixpoint here rather than
  // borrowable_params_of's single pass.
  borrowable_params: string[],
  // strfld_ok_types: struct types whose `string` fields are reclaim-safe at
  // field-drop (strfld_reclaim_ok_types_of).
  strfld_ok_types: string[],
}

// wp_fact_rows lists the whole-program facts a unit's emit reads that come from
// function BODIES: the borrowability registry and the two field-reclaim
// verdicts. A body-only edit in one module can move any of them for a unit
// elsewhere, so the per-module caches fold them into their keys
// (modloader.module_fact_hashes).
pub function wp_fact_rows(b: FnSigs, all_funcs: parser.FuncDecl[], all_stab: irtables.StructTab): string[] {
  var cols: string[][] = [b.borrowable_params, b.strfld_ok_types, structfld_reclaim_ok_types_of(all_funcs, all_stab, b.borrowable_params)];
  var out: string[] = [];
  var ci: i32 = 0;
  for c in cols {
    for row in c {
      // A registry row can hold a whole hash bucket, entries joined by
      // newlines, and which entries share a bucket depends on the table's
      // size; so each entry is its own fact. An empty entry is a slot for a
      // function with nothing to record.
      var start: i32 = 0;
      var i: i32 = 0;
      while (i <= row.len()) {
        if (i == row.len() || row[i] == b'\n') {
          if (i > start) {
            out = out.append(util.i32_to_string(ci) + "#" + slice_unchecked(row, start, i) + "");
          }
          start = i + 1;
        }
        i = i + 1;
      }
    }
    ci = ci + 1;
  }
  return out;
}

// ident_name_or_empty is `e`'s name when it is a BARE ident, and "" otherwise.
// Three predicates here open-coded the same one-arm match to ask it.
pub function ident_name_or_empty(e: ast.Expr): string {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// bytes_at: `e` carries the bytes of `s` starting at index `at`.
function bytes_at(e: string, at: i32, s: string): boolean {
  var n: i32 = s.len();
  if (at + n > e.len()) {
    return false;
  }
  var k: i32 = 0;
  while (k < n) {
    if (e[at + k] != s[k]) {
      return false;
    }
    k = k + 1;
  }
  return true;
}

// tagged_value_start: for a registry entry `e` shaped "<pfx><name>|<value>",
// the index at which <value> begins; -1 for any other entry. An entry whose
// value is EMPTY still matches, at `e.len()` — the sig registries record a name
// with no payload, and callers that read an empty value as "absent" test for it.
//
// Byte compares only. These scans run inside the per-function emit, whose bump
// arena never frees, so slicing a candidate to compare it allocated once or
// twice for every entry of every probe — and the probes run per local slot or
// per call argument, over registries that are module-wide.
function tagged_value_start(e: string, pfx: string, name: string): i32 {
  var pl: i32 = pfx.len();
  var nl: i32 = name.len();
  if (e.len() < pl + nl + 1) {
    return 0 - 1;
  }
  // Prefix first: it discriminates on the first byte for most of the list,
  // where the bar test reads a far offset the entry usually does not reach.
  if (!bytes_at(e, 0, pfx)) {
    return 0 - 1;
  }
  if (e[pl + nl] != b'|') {
    return 0 - 1;
  }
  var k: i32 = 0;
  while (k < nl) {
    // A '|' inside `name` would put the entry's first bar before the one
    // tested above, which is a miss — as it was for the decoders that
    // located the bar by scanning.
    if (name[k] == b'|') {
      return 0 - 1;
    }
    if (e[pl + k] != name[k]) {
      return 0 - 1;
    }
    k = k + 1;
  }
  return pl + nl + 1;
}

// tagged_value_of: the <value> of the first "<pfx><name>|<value>" entry in
// `names` that carries a non-empty one. Every reclaim caller reads "" as "not
// registered", which is what an empty value would mean too, so the scan passes
// those by rather than stopping on them.
function tagged_value_of(names: string[], pfx: string, name: string): string {
  var i: i32 = 0;
  while (i < names.len()) {
    var e: string = names[i];
    var st: i32 = tagged_value_start(e, pfx, name);
    if (st >= 0 && st < e.len()) {
      return slice_unchecked(e, st, e.len()) + "";
    }
    i = i + 1;
  }
  return "";
}

// reclaim_has: the registry holds the exact entry "<pfx><name>". Byte compares
// against each candidate, where `index_of_str(names, pfx + name)` had to build
// the key string first — one allocation per probe, and the sweep runs a dozen
// of these probes per local slot.
function reclaim_has(names: string[], pfx: string, name: string): boolean {
  var want: i32 = pfx.len() + name.len();
  var i: i32 = 0;
  while (i < names.len()) {
    var e: string = names[i];
    if (e.len() == want && bytes_at(e, 0, pfx) && bytes_at(e, pfx.len(), name)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// is_cell_type_name reports whether a declared type SPELLING is a `Cell[T]`.
// The tuple-element tags and the struct-field table both hold the spelling
// verbatim, so this one test answers for either.
pub function is_cell_type_name(t: string): boolean {
  return t.len() > 5 && slice_unchecked(t, 0, 5) == "Cell[";
}

// cell_elem_of_type_name returns T for a `Cell[T]` type spelling, "" otherwise —
// the shared reader behind both the local-annotation marking and the param
// column, so a Cell PARAM tracks exactly like a Cell local.
pub function cell_elem_of_type_name(t: string): string {
  if (t.len() > 6 && slice_unchecked(t, 0, 5) == "Cell[" && slice_unchecked(t, t.len() - 1, t.len()) == "]") {
    return slice_unchecked(t, 5, t.len() - 1) + "";
  }
  return "";
}

// variant_enum_owner returns the enum a variant struct belongs to
// (StructDecl.enum_owner, set when the parser desugars an enum's variants),
// or "" if `name` isn't a known enum variant. Lets the IR path recover a
// freshly-constructed variant's enum type for `<Enum>.<method>` dispatch.
//
// The table is keyed by the BARE name and a plain struct may share one with a
// variant, so the walk skips the entries that are not variants rather than
// reading the first entry's owner: `struct Empty` declared above
// `enum Shape { Square(i32), Empty }` otherwise masked the variant and
// `Empty.to_string()` dispatched to a nonexistent `Empty.to_string` (#9900).
//
// FIRST VARIANT match wins, so this still cannot answer for a name two enums
// both declare. Anywhere the enum is already known — a qualified
// `Enum.Variant` — use variant_decl_index.
pub function variant_enum_owner(structs: irtables.StructTab, name: string): string {
  var i: i32 = irtables.stab_first(structs, name);
  while (i >= 0) {
    if (structs.decls[i].enum_owner != "") {
      return structs.decls[i].enum_owner;
    }
    i = irtables.stab_next(structs, i, name);
  }
  return "";
}

pub function decl_field_index(structs: irtables.StructTab, struct_name: string, field: string): i32 {
  var si: i32 = irtables.stab_struct_first(structs, struct_name);
  if (si < 0) {
    return 0 - 1;
  }
  var fi: i32 = 0;
  while (fi < structs.decls[si].fields.len()) {
    if (structs.decls[si].fields[fi].name == field) {
      return fi;
    }
    fi = fi + 1;
  }
  return 0 - 1;
}

// is_leaksafe_array_field reports whether `t` is an array type that is leak-safe
// AS A STRUCT FIELD: the scalar-element arrays (i32[]/boolean[]), the 4-byte
// u32[], the sub-word u8[] (is_subword_array_type), and the
// 8-byte-element f64[]/i64[]. All store a pointer in the field slot, are owned
// by the struct (a fresh array literal at construction — is_scalar_arr_field_
// access bails the aliasing forms), and are deep-dropped on the struct's
// reclamation. u32[] / the sub-word array use the i32[] 4-byte element read
// unchanged (each element lives in a full 32-bit slot, pre-wrapped by the `as
// u8` cast at the producing site); their narrowness only affects arithmetic ON
// a read element, not the field round-trip. char[] uses that same 4-byte read —
// a char IS an i32 value in an i32 slot (its element-kind dispatch is #7763,
// separate from the field round-trip). u64[] uses the i64-width element
// dispatch through the "u64[]" field tag, like the u64 tuple element slice. NOT
// used for enum payloads (those need the element-width mark, not a plain
// mark_arr).
// A fresh, empty name list. A fold's CONSUMING accumulator takes a value the
// caller owns; a local initialised from a literal is not provably one, and a
// call with no reference parameter is.
function no_names(): string[] {
  return [];
}

// is_map_type_name reports whether `t` is a Map[K, V] type. Maps are leak-only
// on the IR path (the exit sweep tracks local_is_arr, not local_map_type — a map
// box is never freed), so a Map-typed struct field leaks with the struct like a
// string / Option / tuple / enum field: no RC, no aliasing bail. Reading the
// field into a `var m: Map[K, V] = c.m` local re-marks the map type from the
// annotation, so the map's get/insert/has/... dispatch keeps working.
pub function is_map_type_name(t: string): boolean {
  return t.len() >= 5 && slice_unchecked(t, 0, 4) == "Map[";
}

// is_leaksafe_payload reports whether a payload type is a leak-safe scalar/string.
// u32 occupies one full i32 slot exactly like i32 (no narrowing on read), so an
// Option/Result box carrying a u32 stores / reads at the default 32-bit width
// (op_opt_make / op_opt_payload) and the match binding marks the bound slot u32
// so its `>>` is logical and its arithmetic wraps at 2^32. u64 occupies the i64
// 8-byte slot: construction already tags a u64 arg "i64" (elem_type_tag's
// infer_expr_width==64 path) so the box stores 8 bytes, and the match binding
// reads via op_opt_payload_w(64) + marks the slot u64 (unsigned, 8-byte). The
// sub-word int (u8) is NOT here: its payload-box read needs
// zero-extension that currently differs across backends (a u8 read
// mis-extends on wasm), so an Option/Result-of-it field is excluded here.
function is_leaksafe_payload(p: string): boolean {
  // f32 / `float` occupy the f64 slot (elem_ty_is_f64slot) and are inline
  // scalars in the box with nothing to free, so they are leak-safe on the
  // same reasoning f64 is.
  return p == "i32" || p == "boolean" || p == "string" || p == "i64" || irtables.elem_ty_is_f64slot(p)
    || p == "u32" || p == "u64";
}

// opt_payload_ok_dv threads the leak-safe proof's depth + visiting set (the
// struct names on the current path) so a struct payload re-enters
// decl_is_leaksafe_d WITH that context, not the fresh decl_is_leaksafe wrapper.
// Without this a self-referential field — `next: Option[Node]` on
// `struct Node` — recursed decl_is_leaksafe_d -> is_leaksafe_opt_field_d ->
// opt_payload_ok_d -> decl_is_leaksafe (fresh, visiting reset) -> … forever,
// SIGSEGV-ing the compiler on a valid linked list / tree. Threading the set lets
// decl_is_leaksafe_d's back-edge check short-circuit the cycle (leak-only, safe),
// admitting recursive structs to the IR path — the intent decl_is_leaksafe_d's
// header already states for the struct-array back-edge.
function opt_payload_ok_dv(structs: irtables.StructTab, p: string, depth: i32, visiting: string[]): boolean {
  if (is_leaksafe_payload(p)) {
    return true;
  }
  if (irtables.decl_is_struct(structs, p) && decl_is_leaksafe_d(structs, p, depth + 1, visiting)) {
    return true;
  }
  // A leak-safe TUPLE payload (`Option[(i32, i32)]` as a struct field): the
  // Option box holds one tuple pointer, leak-only like a struct payload. The
  // local-position path already admits it; this is the struct-field twin. A
  // nested Option payload (`Option[Option[P]]`) recurses through the same
  // predicate. (visiting-threaded for recursion safety.)
  if (is_leaksafe_tuple_field_dv(structs, p, depth, visiting)) {
    return true;
  }
  // A leak-safe ARRAY payload (`Option[i32[]]` / `Option[string[]]` as a struct
  // field): the Option box holds one array pointer, leak-only exactly like the
  // struct and tuple payloads above. Same step the tuple clause took — the
  // LOCAL position already admits it (`var o: Option[i32[]] = Some([..])`
  // lowers and matches today), so this is the struct-field twin, and without
  // it `struct H { o: Option[i32[]] }` refused the whole module the moment it
  // was CONSTRUCTED — `H { o: None }` was enough (#7745).
  if (irtables.is_leaksafe_array_field(p) || p == "string[]") {
    return true;
  }
  if (p.len() >= 8 && (slice_unchecked(p, 0, 7) == "Option[" || slice_unchecked(p, 0, 7) == "Result[") && is_leaksafe_opt_field_dv(structs, p, depth, visiting)) {
    return true;
  }
  // An `Option[<enum>]` payload is one enum-variant pointer in the box,
  // leak-only — the same reasoning that admits a bare `c: Color` field.
  if (irtables.is_enum_like_name(p, structs)) {
    return true;
  }
  return false;
}

// is_leaksafe_opt_field_d is the structs-aware variant of is_leaksafe_opt_field:
// it additionally admits an Option[Struct] / Result[Struct, …] field whose struct
// payload is itself leak-safe (the construction + match lowering already handle
// it on every backend; only this eligibility predicate forced such fields to AST).
pub function is_leaksafe_opt_field_d(structs: irtables.StructTab, t: string): boolean {
  var seen: string[] = [];
  return is_leaksafe_opt_field_dv(structs, t, 0, seen);
}

// Depth/visiting-threaded variant — see opt_payload_ok_dv.
pub function is_leaksafe_opt_field_dv(structs: irtables.StructTab, t: string, depth: i32, visiting: string[]): boolean {
  var n: i32 = t.len();
  if (n < 9) {
    return false;
  }
  if (slice_unchecked(t, 0, 7) == "Option[") {
    return opt_payload_ok_dv(structs, opt_payload_type(t, "Some"), depth, visiting);
  }
  if (slice_unchecked(t, 0, 7) == "Result[") {
    return opt_payload_ok_dv(structs, opt_payload_type(t, "Ok"), depth, visiting) && opt_payload_ok_dv(structs, opt_payload_type(t, "Err"), depth, visiting);
  }
  return false;
}

// is_leaksafe_tuple_field_d widens is_leaksafe_tuple_field with the `structs`
// view: a STRUCT-array (`Inner[]`) or ENUM-array (`Color[]`) tuple element is
// also a leak-only heap pointer in one tuple slot — the set tuple_elems_lowerable
// already admits for tuple construction / return, where the `.N` read binds the
// slot mark_arr + the element struct/enum name so `t.N[i].field` / `match (t.N[i])`
// resolve. Only decl_is_leaksafe_d (which holds the struct view) uses this; the
// reuse-analysis callers keep the narrower structs-free predicate, so a struct
// with such a tuple field is admitted to the IR path but conservatively skips
// constructor reuse (alloc path — sound, just unoptimised).
pub function is_leaksafe_tuple_field_d(structs: irtables.StructTab, t: string): boolean {
  var seen: string[] = [];
  return is_leaksafe_tuple_field_dv(structs, t, 0, seen);
}

// Depth/visiting-threaded variant — see opt_payload_ok_dv. Threads the set into
// its Option-element and nested-tuple recursion so a tuple field carrying a
// self-referential Option / tuple element does not spin the same cycle.
pub function is_leaksafe_tuple_field_dv(structs: irtables.StructTab, t: string, depth: i32, visiting: string[]): boolean {
  var len: i32 = t.len();
  if (len < 3 || slice_unchecked(t, 0, 1) != "(" || slice_unchecked(t, len - 1, len) != ")") {
    return false;
  }
  var any: boolean = false;
  var i: i32 = 0;
  while (i < 64) {
    var tag: string = irtables.tuple_type_elem_tag(t, i);
    if (tag == "") {
      return any;
    }
    var elem_ok: boolean = is_leaksafe_payload(tag);
    if (!elem_ok) {
      elem_ok = is_leaksafe_opt_field_dv(structs, tag, depth, visiting);
    }
    if (!elem_ok && (tag == "string[]" || tag == "f64[]" || tag == "i64[]" || irtables.is_leaksafe_array_field(tag))) {
      elem_ok = true;
    }
    // The struct-view additions over the plain gate: a struct-array / enum-
    // array element.
    if (!elem_ok && (irtables.is_struct_array_field_type(structs, tag) || irtables.is_enum_array_field_type(structs, tag))) {
      elem_ok = true;
    }
    // A fn-typed element (tuple_type_elem_tag maps "fn" -> "clo") holds a
    // `__mkclo$` closure BOX at runtime — one leak-only pointer slot, like an
    // Option box — so a struct field carrying it is IR-eligible. Reading the
    // slot (`s.p.N`) and calling it (`s.p.N(args)`, the "clo" env-first
    // dispatch) already lower; only this gate rejected the field. Admitted in
    // the wide (`_d`) predicate ONLY, so the struct routes IR but conservatively
    // skips constructor reuse (the narrow predicate the reuse pass consults
    // still declines) — sound, just unoptimised, exactly like the struct-array
    // element case above.
    if (!elem_ok && tag == "clo") {
      elem_ok = true;
    }
    // A bare STRUCT element (`(A, i32)` — element A) is a leak-only pointer
    // slot like a struct-array / Option element: the tuple stores the struct
    // box, `t.N.field` reads it (expr_tuple_elem_tag tags element N with the
    // struct name). Admitted when the element struct is itself leak-safe;
    // decl_is_leaksafe_d is threaded with depth + visiting so a self-
    // referential element short-circuits instead of recursing forever.
    if (!elem_ok && irtables.decl_is_struct(structs, tag) && decl_is_leaksafe_d(structs, tag, depth + 1, visiting)) {
      elem_ok = true;
    }
    // A bare nominal-ENUM element is leak-only on the IR path (the exit sweep
    // never frees an enum box), like an enum-array / Option element.
    if (!elem_ok && irtables.is_enum_like_name(tag, structs)) {
      elem_ok = true;
    }
    // A NESTED tuple element recurses through THIS predicate so an inner
    // struct-/enum-array element is admitted at any depth.
    if (!elem_ok && util.is_tuple_type_name(tag)) {
      elem_ok = is_leaksafe_tuple_field_dv(structs, tag, depth, visiting);
    }
    if (!elem_ok) {
      return false;
    }
    any = true;
    i = i + 1;
  }
  return any;
}

// selfrebind_field_alias reports whether `e` is exactly `srb.<f>` — a field read
// off the local whose own self-rebind literal is being lowered (#6653). `srb` is
// "" everywhere else, so this is false unless LowerState.selfrebind was set for
// this expression. Only a DIRECT `srb.<f>`: a deeper chain `srb.a.b` reaches a
// box the successor does not supersede, so that one keeps its retain.
pub function selfrebind_field_alias(e: ast.Expr, srb: string): boolean {
  if (srb.len() == 0) {
    return false;
  }
  match (e) {
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(oid) => {
          return oid.name == srb;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

pub function decl_is_leaksafe(structs: irtables.StructTab, struct_name: string): boolean {
  var seen: string[] = [];
  return decl_is_leaksafe_d(structs, struct_name, 0, seen);
}

// decl_is_leaksafe_d is the recursion: a struct is leak-safe if every field is a
// scalar (i32/boolean/string/scalar-array) OR a struct that is itself leak-safe
// (composite struct fields, leak mode — the pointer is stored in one slot, no
// RC). `visiting` is the set of struct names on the current proof path: a field
// whose (element) type is already being proven is a leak-only BACK-EDGE in the
// type graph — a self-referential `next: Node[]` or a mutually-recursive
// `A.b: B[]` / `B.a: A[]` — and in leak mode that back-pointer is just a slot
// that leaks with the struct (no RC), so the cycle introduces no unsafe field.
// We short-circuit such an edge as leak-safe (the OUTER struct's own fields are
// still each validated), which admits linked lists / trees / ASTs onto the IR
// path. The depth cap stays as a backstop for pathological non-cyclic graphs.
function decl_is_leaksafe_d(structs: irtables.StructTab, struct_name: string, depth: i32, visiting: string[]): boolean {
  if (depth > 16) {
    return false;
  }
  // Back-edge to a struct already on the proof path: leak-only, so safe.
  // Checked before the lookup so a name with no decl at all still bails.
  if (util.has_str(visiting, struct_name)) {
    return true;
  }
  return decl_is_leaksafe_at_d(structs, irtables.decl_index_of(structs, struct_name), depth, visiting);
}

function decl_is_leaksafe_at_d(structs: irtables.StructTab, decl_index: i32, depth: i32, visiting: string[]): boolean {
  if (depth > 16) {
    return false;
  }
  if (decl_index < 0 || decl_index >= structs.decls.len()) {
    return false;
  }
  var struct_name: string = structs.decls[decl_index].name;
  if (util.has_str(visiting, struct_name)) {
    return true;
  }
  var nv: string[] = visiting.append(struct_name);
  var fi: i32 = 0;
  while (fi < structs.decls[decl_index].fields.len()) {
    var t: string = structs.decls[decl_index].fields[fi].type_name;
    // The ≤32-bit integer scalars (u32 + the sub-word u8)
    // are leak-only and occupy one i32 slot exactly like i32, so a struct
    // carrying them is leaf-safe and lowers (construction stores / field
    // read loads at the default 32-bit width; a sub-word cast wraps the
    // value before the store). The 64-bit-slot scalars (i64 / u64 / f64 /
    // f32 / float) are here too, on the same leak-only reasoning. `usize`
    // likewise: it is a raw machine word (a bare address, never an rc box),
    // so it occupies the default pointer slot and leaks with nothing to free —
    // is_scalar_field_type has always called it a scalar. `char` is a code
    // point in one i32 slot, the same class the receiver gate already puts
    // it in.
    // `string[][]` is spelled out because is_leaksafe_array_field bottoms
    // out in the scalar-element arrays, so neither it nor
    // is_nested_array_field_type reaches a nested STRING array — the same
    // reason the match-arm payload admission spells the pair out.
    // Thread this proof's depth + visiting set (`nv`) into the Option /
    // tuple field predicates so a self-referential `Option[Node]` /
    // `(Node, …)` field re-enters decl_is_leaksafe_d WITH the path — its
    // back-edge check then short-circuits the cycle instead of recursing
    // forever (was a SIGSEGV on any linked list / tree).
    if (t == "i32" || t == "boolean" || t == "string" || t == "string[]" || t == "f64" || t == "i64" || t == "u32" || t == "u8" || t == "f32" || t == "float" || t == "u64" || t == "usize" || t == "char" || t == "Reader" || t == "Writer" || irtables.is_leaksafe_array_field(t) || t == "string[][]" || is_leaksafe_opt_field_dv(structs, t, depth, nv) || is_leaksafe_tuple_field_dv(structs, t, depth, nv) || is_map_type_name(t) || t.len() > 5 && slice_unchecked(t, 0, 5) == "Cell[") {
      fi = fi + 1;
      continue;
    }
    // A struct-typed field is allowed if its struct is leak-safe too.
    if (irtables.decl_is_struct(structs, t) && decl_is_leaksafe_d(structs, t, depth + 1, nv)) {
      fi = fi + 1;
      continue;
    }
    // A nominal-enum field (Color, Expr, …) is leak-only on the IR
    // path — the exit sweep never frees an enum box — so it leaks
    // with the struct like a string / Option / tuple field: no RC, no
    // aliasing bail. is_enum_like_name can still over-match a bare type
    // VARIABLE, but the only consequence is the construction / match site
    // bailing on an absent symbol (never a miscompile).
    if (irtables.is_enum_like_name(t, structs)) {
      fi = fi + 1;
      continue;
    }
    // An array-of-struct field `X[]` (X a leak-safe struct): admitted
    // in leak mode (the array + its elements leak with the struct; a
    // recursive-drop follow-up frees them). The element's leaf-safety
    // uses the SAME depth-bounded recursion so a cyclic `X[]` graph
    // hits the cap and bails.
    if (t.len() >= 3 && slice_unchecked(t, t.len() - 2, t.len()) == "[]") {
      var elt: str = slice_unchecked(t, 0, t.len() - 2);
      if (irtables.decl_is_struct(structs, elt) && decl_is_leaksafe_d(structs, elt, depth + 1, nv)) {
        fi = fi + 1;
        continue;
      }
      // An array-of-ENUM field `C[]` — enum boxes leak with the
      // struct like the struct-element arrays above (and the
      // nominal-enum field case), so admit it in leak mode.
      if (irtables.is_enum_like_name(elt, structs)) {
        fi = fi + 1;
        continue;
      }
      // An array-of-ARRAY field `T[][]`, an array-of-Option/Result
      // field `Option[T][]` whose element `Option[T]` is a leak-safe
      // Option/Result, or an array-of-TUPLE field `(i32, string)[]`
      // whose element tuple is a leak-safe tuple: the whole nested
      // structure leaks with the struct. Covers the common 2-D field;
      // deeper nesting still bails.
      if (irtables.is_nested_array_field_type(structs, t) || is_leaksafe_opt_field_d(structs, elt) || is_leaksafe_tuple_field_d(structs, elt)) {
        fi = fi + 1;
        continue;
      }
    }
    return false;
  }
  return true;
}

// decl_at_field_name returns the NAME of field `index` (decl order) of the decl
// at `decl_index`, or "".
pub function decl_at_field_name(structs: irtables.StructTab, decl_index: i32, index: i32): string {
  if (decl_index < 0 || decl_index >= structs.decls.len()) {
    return "";
  }
  if (index < 0 || index >= structs.decls[decl_index].fields.len()) {
    return "";
  }
  return structs.decls[decl_index].fields[index].name;
}

// decl_field_name_at returns the NAME of field `index` (decl order) in struct
// `struct_name`, or "". The name-side twin of decl_field_type_at.
pub function decl_field_name_at(structs: irtables.StructTab, struct_name: string, index: i32): string {
  return decl_at_field_name(structs, irtables.decl_index_of(structs, struct_name), index);
}

// str_free_producer_ident reports whether an UNAMBIGUOUS named fresh-string
// producer — a builtin / free-function that ALWAYS returns a freshly-allocated,
// sole-owned heap string boxed at an allocation boundary — is being called. Each
// is unambiguous by NAME (no operand-type inference needed), so it is admitted
// regardless of the binding annotation (the un-annotated widening, mirroring the
// tuple `(i, 1)` case):
//   - chr(n) / string_from_bytes_unchecked(a)           — alloc builtins, fresh box
//   - str_to_upper/str_to_lower/str_repeat(s) — free-fn spellings, fresh copy
//   - i32_to_string(n)                         — decimal-text builtin. Also Owned
//     in str_producer_ownership / expr_is_fresh_str since #4355 (the historical
//     exclusion guarded the NATIVE emitter's mid-buffer boxing; everything
//     irlower emits calls the self-host __fern_i32_to_string, which
//     __raw_alloc(len)s a tight buffer and boxes it at the base, so its data
//     pointer IS an alloc boundary and __fern_str_free (class = ceil(len/8))
//     reclaims it cleanly). (u32_to_string is left out — expr_is_str doesn't
//     str-track it, so its slot never marks is_str.)
//   - __raw_string(p, n)                       — the Tier-2 raw box constructor
// EXCLUDED here (need the `: string` disambiguation, handled in the caller): a
// bare `a + b` (could be int add) and the `.<m>()` methods (`.reverse()` /
// `.repeat()` also exist on arrays). `.to_string()` is a method, not an ident
// callee, so it never reaches this test; str_local_binding_is_fresh admits it on
// a stamped scalar receiver and refuses it on a string one.
function str_free_producer_ident(c: ast.ExprCall): boolean {
  match (c.callee) {
    ast.ExprIdent(cid) => {
      if (cid.name == "chr" || cid.name == "string_from_bytes_unchecked") {
        return true;
      }
      if (cid.name == "str_to_upper" || cid.name == "str_to_lower"
        || cid.name == "str_repeat" || cid.name == "str_trim") {
        return true;
      }
      if (cid.name == "i32_to_string" && c.args.len() == 1) {
        return true;
      }
      if (cid.name == "__raw_string" && c.args.len() == 2) {
        return true;
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// str_local_binding_is_fresh reports (purely SYNTACTICALLY) whether `var <name> =
// init` binds a value shaped like a FRESH, sole-owned HEAP string — the string
// analogue of tuple_lit_is_fresh_scalar. It is the FRESH gate only; the TYPE gate
// is applied separately by slot_is_reclaimable_str (the slot's `is_str`, set from
// the type-aware expr_is_str at the StmtVar lowering). That two-gate split is why
// NO `: string` annotation is needed here: an un-annotated `a + b` or `x.reverse()`
// that is actually int-add / an array method has is_str == false, so it is never
// reclaimed even though it matches syntactically. The admitted shapes each allocate
// a fresh buffer + box when they ARE strings:
//   - an UNAMBIGUOUS named producer (str_free_producer_ident) — chr /
//     string_from_bytes_unchecked / str_to_upper / str_to_lower / str_repeat /
//     str_trim (copies since #7393) / i32_to_string / __raw_string;
//   - an `a + b` CONCAT (fresh buffer + box when either side is a string);
//   - a `.to_ascii_upper()` / `.to_ascii_lower()` / `.reverse()` / `.repeat(n)`
//     method (str_fresh_alloc_method: each copies into a fresh buffer on a string
//     receiver; expr_is_str only marks the slot is_str for a STRING receiver, so
//     an array `.reverse()`/`.repeat()` is never reclaimed). The `.trim()` METHOD
//     is not among them — only the `str_trim` free-function spelling is.
// DELIBERATELY EXCLUDED (each may ALIAS a live box → freeing would over-release,
// and each is is_str yet NOT fresh, so the type gate alone would not stop them):
// a string LITERAL (static, not heap), a bare ident / field / index / slice
// (aliases a live string), `.replace()` and a string receiver's `.to_string()`
// (receiver-identity fast-paths), and a general call (may return a borrowed
// param). A stamped scalar's `.to_string()` is admitted: only the
// stamped_scalar receiver test separates it from the string receiver's alias.
function str_local_binding_is_fresh(init: ast.Expr): boolean {
  match (init) {
    ast.ExprCall(c) => {
      if (str_free_producer_ident(c)) {
        return true;
      }
      match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
          if (cfa.field == "to_string") {
            return c.args.len() == 0 && stamped_scalar(cfa.obj);
          }
          if (!str_fresh_alloc_method(cfa.field)) {
            return false;
          }
          if (cfa.field == "repeat") {
            return c.args.len() == 1;
          }
          return c.args.len() == 0;
        },
        _ => {
          return false;
        }
      }
    },
    ast.ExprBinary(b) => {
      // A concat allocates a fresh box. The checker's tag tells it from an
      // integer add; an unannotated tree keeps the structural answer.
      return b.op == "+" && (b.ty == "" || b.ty == "string");
    },
    _ => {
      return false;
    }
  }
  return false;
}

// str_fresh_alloc_method: a string builtin whose result is ALWAYS a newly
// allocated box. Strictly smaller than str_borrowing_method, which also admits
// the predicates (scalar results, no box at all) and is about what a method does
// to its RECEIVER; this is about what it returns. `trim` copies since #7393
// but stays OUT of this state-free set: a user method named `trim` on a
// non-string receiver may return a field alias, and admitting it by name
// alone frees the field under its owner (the str-trim-user-method pin) — its
// credit comes from the receiver-TYPE-gated trim collector instead. `replace`
// returns the receiver unchanged when the needle is absent, so it stays out —
// and `lines` / `split` return arrays, not strings.
// stamped_scalar reports whether the checker typed `e` a number, whose
// `to_string` is the builtin decimal-text producer and always allocates. A
// struct's may return an alias of a field, and an unstamped receiver proves
// nothing.
function stamped_scalar(e: ast.Expr): boolean {
  if let ast.ExprNumber(_) = e {
    return true;
  }
  var t: string = ast.expr_ty(e);
  return t == "i32" || t == "i64" || t == "u32" || t == "u64" || t == "f64" || t == "f32" || t == "u8" || t == "usize";
}

function str_fresh_alloc_method(field: string): boolean {
  return field == "to_ascii_upper" || field == "to_ascii_lower" || field == "repeat";
}

// is_tostring_scalar_tag: `t` names a scalar type whose `to_string` is the
// builtin decimal-text producer.
function is_tostring_scalar_tag(t: string): boolean {
  return t == "i32" || t == "i64" || t == "u32" || t == "u64"
    || t == "f64" || t == "f32" || t == "u8" || t == "usize";
}

// scalar_tostring_call: `c` is `x.to_string()` on a receiver the checker typed
// scalar — tostring_recv_is_scalar's claim, read off the annotations for a walk
// that runs without a frame.
function scalar_tostring_call(c: ast.ExprCall): boolean {
  if (c.args.len() != 0) {
    return false;
  }
  match (c.callee) {
    ast.ExprFieldAccess(fa) => {
      if (fa.field != "to_string") {
        return false;
      }
      match (fa.obj) {
        ast.ExprNumber(_) => {
          return true;
        },
        ast.ExprIdent(id) => {
          return is_tostring_scalar_tag(id.ty);
        },
        ast.ExprBinary(b) => {
          return is_tostring_scalar_tag(b.ty);
        },
        ast.ExprUnary(u) => {
          return is_tostring_scalar_tag(u.ty);
        },
        ast.ExprCall(rc) => {
          return is_tostring_scalar_tag(rc.ty);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// is_str_builtin_method reports whether `field` names a string builtin method the
// IR path lowers directly: the 0-arg transforms `to_upper` / `to_lower` (→ fresh
// string) and `split` (→ string[]). The search predicates are not here: they
// are std/string's methods, whose one-byte needle reaches `__memchr`. The
// caller checks arity (str_method_argc) + that the receiver is a string before
// dispatching to lower_str_method.
pub function is_str_builtin_method(field: string): boolean {
  return field == "to_ascii_upper" || field == "to_ascii_lower" || field == "trim"
    || field == "repeat" || field == "replace"
    || field == "lines"
    || field == "split";
}

// variant_counted_struct_payload: `arg` is a bare ident stored into a variant
// payload field of type `fty`, and that field is one emit_enum_variant_payload_drops
// actually RELEASES (its deep-drop-ok and scalar-only arms). Both the construction
// retain and the counted credit ask exactly this, in those words, because a credit
// the retain does not honour is an over-release rather than a missed optimisation —
// the same rule struct_routes_field_reclaim_at states for the string-field store.
//
// A bare ident of struct type always names a box (local or param). If the credit
// then declines the name on one of its escape gates, the retain is unmatched and
// the box LEAKS — the safe-leak side of the invariant, never a dangle.
function variant_counted_struct_payload(arg: ast.Expr, fty: string, structs: irtables.StructTab): boolean {
  if (!irtables.decl_is_struct(structs, fty)) {
    return false;
  }
  if (!irtables.nested_field_deep_drop_ok(structs, fty) && !struct_lit_all_scalar(structs, fty)) {
    return false;
  }
  match (arg) {
    ast.ExprIdent(_) => {
      return true;
    },
    _ => {}
  }
  return false;
}

// ── the fresh-owned-container READ reclaim (#6491) ───────────────────────────
//
// `mk()[i]` / `mk().f` read a value out of a container NOTHING NAMES, so the
// read is the only place that container can be reclaimed — there is no slot for
// the exit sweep to find. Native bounds both shapes; the self-host leaked the
// whole container per evaluation (measured 184 B a round on the three-read
// probe, exactly x2 per doubling, against 0 on all three native backends).
//
// This is the discarded-`mk(i);` statement reclaim one expression position over,
// and it deliberately borrows that site's admission rather than inventing one:
// the callee must be in the STRICT-fresh registry, so the returned box is the
// unambiguous sole owner (rc == 1) of itself and of every field buffer. The
// releases are the same rc-guarded helpers, so a shared box degrades to today's
// leak instead of dangling.
//
// SCALAR reads only. A pointer element/field ALIASES the container about to be
// freed, so it needs the retain-and-deep-drop pair plus a binding site that
// takes the read as a move — three sites that have to agree, and none of them
// is here. A scalar is copied out of the buffer, so nothing survives the release
// to dangle.

// owned_scalar_field_type reports whether a declared field type names a value
// that is COPIED out of its container rather than pointing back into it. Every
// scalar width plus `boolean`; `string` / arrays / structs / enums are pointers
// and are excluded. The index read needs no such test — its "ARR:" admission
// already restricts the container to a scalar-element array.
function owned_scalar_field_type(t: string): boolean {
  return irtables.is_scalar_type_name(t) || t == "boolean" || t == "f32"
    || t == "u8" || t == "i8" || t == "u16" || t == "i16" || t == "char";
}

// tuple_field_share_kind: the release a tuple literal's element owes when it is
// a struct ARRAY field read (#10203, #10314) — "S" for a string[] field (the
// rc-guarded __fern_str_arr_free), "a" for any other array (one buffer dec), ""
// otherwise. The literal retains exactly these elements, so the tuple holds a
// counted reference rather than aliasing the struct's buffer. A function of the
// node and its checker stamp alone, so the literal's retain, the tuple local's
// kinds and a returned tuple's ARRF: flags cannot disagree.
function tuple_field_share_kind(e: ast.Expr): string {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      if (util.is_all_digits(fa.field) || !irtables.is_array_type_name(fa.ty)) {
        return "";
      }
      if (fa.ty == "string[]") {
        return "S";
      }
      return "a";
    },
    _ => {}
  }
  return "";
}

// vb_stmt_leaves appends the leaves of one value-producing statement to `acc`;
// false when the statement is of a shape the walk does not know.
function vb_stmt_leaves(st: ast.Stmt, acc: ast.Expr[]): (boolean, ast.Expr[]) {
  match (st) {
    ast.StmtReturn(r) => {
      return (true, acc.append(r.value));
    },
    ast.StmtIf(iff) => {
      let (tok, a) = vb_body_leaves(iff.then_body, acc);
      if (!tok) {
        return (false, acc);
      }
      return vb_body_leaves(iff.else_body, a);
    },
    ast.StmtMatch(mm) => {
      var a: ast.Expr[] = acc;
      for arm in mm.arms {
        let (aok, na) = vb_body_leaves(arm.body, a);
        if (!aok) {
          return (false, acc);
        }
        a = na;
      }
      return (true, a);
    },
    _ => {
      return (false, acc);
    }
  }
  return (false, acc);
}

// vb_body_leaves: one branch body. A diverging branch adds nothing.
function vb_body_leaves(body: ast.Stmt[], acc: ast.Expr[]): (boolean, ast.Expr[]) {
  if (body.len() == 0) {
    return (false, acc);
  }
  if (value_arm_diverges(body)) {
    return (true, acc);
  }
  return vb_stmt_leaves(body[body.len() - 1], acc);
}

// ── owned if / match / block values (#10438) ────────────────────────────────
//
// A value-position if, match or block hands its value over through a temp that
// nothing sweeps, so a consumer that does not bind it — a call argument, a
// `.len()` receiver, an index or field read — is the only place it can be
// released. That is sound only when the value is owned whichever arm ran:
// every arm yields a reference the arm retained or a value that is already
// owned, native's countedConditionalType. An arm retains the local it yields
// when that local is an array, string, struct or dyn value declared outside
// the conditional (native's emitCountedYield); any other arm has to be fresh.

// cond_value_body is the body of an if-, match- or block value, or empty.
function cond_value_body(e: ast.Expr): ast.Stmt[] {
  var none: ast.Stmt[] = [];
  if let ast.ExprCall(c) = e {
    if let ast.ExprLambda(lam) = c.callee {
      if (c.args.len() != 0 || lam.params.len() != 0) {
        return none;
      }
      if (block_of_bare_name(lam)) {
        return none;
      }
      if (lam.origin == parser.ORIGIN_BLOCK || lam.origin == parser.ORIGIN_IF_EXPR || lam.origin == parser.ORIGIN_MATCH_EXPR) {
        return lam.body;
      }
    }
  }
  return none;
}

// block_of_bare_name: `{ x }`. It lowers to the plain read of x, with no arm
// store to retain at, so it is not a conditional value.
function block_of_bare_name(lam: ast.ExprLambda): boolean {
  if (lam.origin != parser.ORIGIN_BLOCK || lam.body.len() != 1) {
    return false;
  }
  if let ast.StmtReturn(r) = lam.body[0] {
    if let ast.ExprIdent(_) = r.value {
      return true;
    }
  }
  return false;
}

// cond_value_leaves lists what such a body can yield: its final statement's
// value, through nested if / match tails. Empty for a shape the walk does not
// know, so nothing is claimed about it.
function cond_value_leaves(body: ast.Stmt[]): ast.Expr[] {
  var none: ast.Expr[] = [];
  if (body.len() == 0) {
    return none;
  }
  let (ok, leaves) = vb_stmt_leaves(body[body.len() - 1], none);
  if (!ok) {
    return none;
  }
  return leaves;
}

// iife_any_nonarray_return reports whether ANY `return` reachable in an
// if-/match-expression IIFE body yields a value that is NOT a fresh array
// LITERAL (`[..]`). Used to admit a struct array FIELD set from an if-/match-
// expression (`B { xs: if (c) { [1,2,3] } else { [4] } }`) only when EVERY branch
// is a fresh owned array — so the field leaks with the struct, never aliasing a
// swept local (the safety invariant the direct-`ExprArray` field check enforces).
function iife_any_nonarray_return(st: ast.Stmt): boolean {
  match (st) {
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprArray(_) => {
          return false;
        },
        _ => {
          return true;
        }
      }
    },
    ast.StmtIf(iff) => {
      var k: i32 = 0;
      while (k < iff.then_body.len()) {
        if (iife_any_nonarray_return(iff.then_body[k])) {
          return true;
        }
        k = k + 1;
      }
      var j: i32 = 0;
      while (j < iff.else_body.len()) {
        if (iife_any_nonarray_return(iff.else_body[j])) {
          return true;
        }
        j = j + 1;
      }
      return false;
    },
    ast.StmtMatch(mm) => {
      var a: i32 = 0;
      while (a < mm.arms.len()) {
        var b: i32 = 0;
        while (b < mm.arms[a].body.len()) {
          if (iife_any_nonarray_return(mm.arms[a].body[b])) {
            return true;
          }
          b = b + 1;
        }
        a = a + 1;
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// iife_returns_fresh_array reports whether `e` is an if-/match-expression IIFE
// whose every branch returns a fresh array literal (so it's a safe owned value
// for a struct array field). False for a non-IIFE expression.
function iife_returns_fresh_array(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprLambda(lam) => {
          if (lam.body.len() == 0) {
            return false;
          }
          var i: i32 = 0;
          while (i < lam.body.len()) {
            if (iife_any_nonarray_return(lam.body[i])) {
              return false;
            }
            i = i + 1;
          }
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// value_arm_diverges reports a value branch whose leading statements always
// leave (`Err(_) => { return false; }`): its tail is parse_branch_body's
// unreachable filler, typed like the enclosing function's result rather than
// the block's, so it neither stores into the block's temp nor classifies it.
function value_arm_diverges(body: ast.Stmt[]): boolean {
  return body.len() > 1 && parser.branch_stmts_diverge(value_arm_leading(body));
}

// value_arm_leading is a value branch's statements before its tail.
function value_arm_leading(body: ast.Stmt[]): ast.Stmt[] {
  var out: ast.Stmt[] = [];
  var i: i32 = 0;
  while (i + 1 < body.len()) {
    out = out.append(body[i]);
    i = i + 1;
  }
  return out;
}

// struct_lit_all_scalar reports whether every field of struct `name` is a flat
// scalar — so a discarded fresh `T { … };` box is single-level and a shallow
// __fern_rc_dec fully reclaims it (no rc-field deep-drop needed). Structs with
// array / string / nested-struct fields bail (their box dec would leave the
// field payloads on the safe-leak floor — a later cut using __struct_drop).
function struct_lit_all_scalar(structs: irtables.StructTab, name: string): boolean {
  var nf: i32 = irtables.decl_field_count(structs, name);
  if (nf == 0) {
    return false;
  }
  var fi: i32 = 0;
  while (fi < nf) {
    if (!reuse_field_is_scalar(irtables.decl_field_type_at(structs, name, fi))) {
      return false;
    }
    fi = fi + 1;
  }
  return true;
}

// --- static aggregate constants (#6149) --------------------------------------
//
// `TypeI32 { is_char: false, width: 32, unsigned: false }` is a compile-time
// constant, and the checker's nullary type constructors return one per call —
// ~21% of every allocation the compiler makes, each box leaked (the run frees
// 2,228 of 5,947). Recognised here and lowered to op_const_struct, which the
// backends place in static data instead of allocating.
//
// Slice 1's admission is deliberately narrow: a NO-BASE literal of a declared
// struct / variant whose every DECLARED field is an i32-width scalar and whose
// value is a literal of that kind. Wider fields (i64 / f64), strings and nested
// aggregates need more than the one word per field the backends emit for this
// op, so they stay on struct_make.

// handback_param_name: `p` for a bare `p` or a field read `p.f`, else "".
function handback_param_name(e: ast.Expr): string {
  if let ast.ExprFieldAccess(fa) = e {
    return ident_name_or_empty(fa.obj);
  }
  return ident_name_or_empty(e);
}

// slice_unchecked_call reports whether `e` is the builtin call
// `slice_unchecked(src, a, b)` — the raw byte slice under its explicit name
// (#5634), source/start/end in args[0]/[1]/[2]. It is the ONLY spelling the
// frame path and the borrow scans admit: `s[a:b]` is the checked form and
// yields an `Option[str]` box that escapes the expression.
pub function slice_unchecked_call(e: ast.Expr): boolean {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return cid.name == "slice_unchecked" && c.args.len() == 3;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// is_direct_ident_field_read: `e` is exactly `x.f` for a bare ident `x`.
function is_direct_ident_field_read(e: ast.Expr): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(_) => {
          return true;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// struct_has_reclaim_array_field reports whether struct type `sty` has at least
// one rc-tracked ARRAY field — a scalar-element array (i32[]/u32[]/f64[]/…), an
// array-of-struct, or an array-of-enum field. These are exactly the fields whose
// BUFFER the per-type field-reclaim helper shallow-frees on a consume-rebind, so
// this is the gate that picks `__field_reclaim_<T>` over the scalar-only
// `__fern_snapshot_dec` / the plain box `__fern_rc_dec`. Also admits a struct
// carrying a DIRECT nested-struct field or (since #4297 A2) a DIRECT enum field,
// each SHALLOW-reclaimed one level by __struct_drop's k_struct / k_enum arm.
// (string / map / option / tuple fields are still NOT reclaimed — they leak with
// the struct, sound.)
pub function struct_has_reclaim_array_field(structs: irtables.StructTab, sty: string): boolean {
  if (sty.len() == 0) {
    return false;
  }
  var n: i32 = irtables.decl_field_count(structs, sty);
  var fi: i32 = 0;
  while (fi < n) {
    var fdt: string = irtables.decl_field_type_at(structs, sty, fi);
    if (irtables.is_leaksafe_array_field(fdt)) {
      return true;
    }
    if (irtables.is_struct_array_field_type(structs, fdt)) {
      return true;
    }
    if (irtables.is_enum_array_field_type(structs, fdt)) {
      return true;
    }
    if (irtables.is_row_array_field_type(structs, fdt)) {
      return true;
    }
    // A DIRECT nested-struct field (`inner: Inner`) is now SHALLOW-reclaimed
    // (emit_ir_struct_drop_one's k_struct), so a struct carrying one needs its
    // exit drop emitted too — admit it to the reclaim set (the construction
    // alias-inc in the ExprStructLit lowering keeps it balanced).
    if (irtables.decl_is_struct(structs, fdt)) {
      return true;
    }
    // A DIRECT enum field (`e: MyEnum`) is now SHALLOW-reclaimed too
    // (emit_ir_struct_drop_one's k_enum → arr_dec of the enum box, one level —
    // the variant payload leaks, matching the k_struct gap). Admit it so the
    // struct's __struct_drop is emitted; the construction alias-inc balances the
    // dec. #4297 A2.
    if (irtables.decl_is_enum(structs, fdt)) {
      return true;
    }
    fi = fi + 1;
  }
  return false;
}

// struct_has_string_field reports whether struct `sty` has a bare `string` field.
// __struct_drop's k_str arm frees such a field (rc-aware __fern_str_free), but only
// when the field's constructed value is provably FRESH (sole-owned) — an ALIASED
// bare-ident string field is retained by the caller, so freeing it double-releases
// (the two-alias case). struct_lit_all_string_fields_fresh proves that per-site.
pub function struct_has_string_field(structs: irtables.StructTab, sty: string): boolean {
  if (sty.len() == 0) {
    return false;
  }
  var n: i32 = irtables.decl_field_count(structs, sty);
  var fi: i32 = 0;
  while (fi < n) {
    if (irtables.decl_field_type_at(structs, sty, fi) == "string") {
      return true;
    }
    fi = fi + 1;
  }
  return false;
}

// tuple_field_deep_droppable: `t` is a tuple TYPE whose every element is a flat
// scalar, a leak-safe scalar array, or a nested deep-droppable tuple — with AT
// LEAST ONE array somewhere (else nothing rc to reclaim). Released by
// emit_tuple_type_child_drops + a box dec. String / struct / enum / option / map
// elements are excluded (first cut).
function tuple_field_deep_droppable(t: string, structs: irtables.StructTab): boolean {
  if (t.len() < 2 || slice_unchecked(t, 0, 1) != "(") {
    return false;
  }
  var any_arr: boolean = false;
  var k: i32 = 0;
  while (k < 64) {
    var tag: string = irtables.tuple_type_elem_tag(t, k);
    if (tag == "") {
      break;
    }
    if (irtables.is_leaksafe_array_field(tag)) {
      any_arr = true;
    } else if (util.is_tuple_type_name(tag)) {
      if (!tuple_field_deep_droppable(tag, structs)) {
        return false;
      }
      any_arr = true;
    } else if (irtables.decl_is_struct(structs, tag)) {
      // A reclaim-STRUCT element (P with an rc-array field, #4365): deep-droppable
      // via emit_tuple_type_child_drops' struct arm. A plain struct (no rc field)
      // stays un-admitted (leak-safe) — the drop only handles field-reclaim structs.
      if (!struct_has_reclaim_array_field(structs, tag)) {
        return false;
      }
      any_arr = true;
    } else if (tag == "string") {
      // A STRING element (#4353 item 2, probe p4): construction str_box's
      // every string element into a fresh sole-owned copy (#5443), so the
      // type-driven drop's rc-aware __fern_str_free is deep-droppable —
      // gated at admission (tuple_arg_payload_fresh) on a literal / fresh
      // producer element expression.
      any_arr = true;
    } else if (tag == "string[]") {
      // A string-ARRAY element: released by __fern_str_arr_free, gated at
      // admission on an array literal of provably fresh strings.
      any_arr = true;
    } else if (!irtables.is_scalar_type_name(tag)) {
      return false;
    }
    k = k + 1;
  }
  return any_arr;
}

function tuple_arg_payload_droppable(ttype: string, arg: ast.Expr, structs: irtables.StructTab, ident_arr_ok: boolean, str_fresh_ret: string[]): boolean {
  match (arg) {
    ast.ExprTuple(tl) => {
      var k: i32 = 0;
      while (k < tl.elements.len()) {
        var tag: string = irtables.tuple_type_elem_tag(ttype, k);
        if (tag == "") {
          return false;
        }
        if (irtables.is_leaksafe_array_field(tag)) {
          var isarr: boolean = false;
          match (tl.elements[k]) {
            ast.ExprArray(_) => {
              isarr = true;
            },
            ast.ExprIdent(_) => {
              // A bare ident is admitted only for the retained flavour: the
              // construction retain is what the drop's dec gives back, and
              // nothing else at this position takes one.
              isarr = ident_arr_ok;
            },
            _ => {}
          }
          if (!isarr) {
            return false;
          }
        } else if (tag == "string[]") {
          // A string-ARRAY position must be an array literal of fresh
          // strings — the type-driven drop element-walks it blind, so an
          // ident element would put a live local's box under str_free.
          if (!tuple_strarr_elem_fresh(tl.elements[k], str_fresh_ret)) {
            return false;
          }
        } else if (tag == "string") {
          // A string position must be a LITERAL (construction copies it
          // fresh) or a fresh producer (concat / .to_string() / a
          // registered fresh-string function, tuple_str_elem_fresh_reg)
          // — a bare-ident element would put a live local's box under
          // the blind type-driven str_free.
          var isfs: boolean = false;
          match (tl.elements[k]) {
            ast.ExprString(_) => {
              isfs = true;
            },
            _ => {
              isfs = tuple_str_elem_fresh_reg(tl.elements[k], str_fresh_ret);
            }
          }
          if (!isfs) {
            return false;
          }
        } else if (util.is_tuple_type_name(tag)) {
          if (!tuple_arg_payload_droppable(tag, tl.elements[k], structs, ident_arr_ok, str_fresh_ret)) {
            return false;
          }
        } else if (irtables.decl_is_struct(structs, tag)) {
          // A reclaim-STRUCT position must be a FRESH struct literal so the
          // type-driven drop dec's a sole-owned box (an ident alias would
          // double-release). #4365.
          if (!struct_has_reclaim_array_field(structs, tag)) {
            return false;
          }
          var isslit: boolean = false;
          match (tl.elements[k]) {
            ast.ExprStructLit(_) => {
              isslit = true;
            },
            _ => {}
          }
          if (!isslit) {
            return false;
          }
        } else if (!irtables.is_scalar_type_name(tag)) {
          return false;
        }
        k = k + 1;
      }
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// struct_has_deep_tuple_field: `sty` has a direct tuple field whose shape
// tuple_field_deep_droppable admits. The tuple sibling of
// struct_has_reclaim_array_field, and the routing predicate both the
// construction retain and emit_struct_tuple_field_drops read.
function struct_has_deep_tuple_field(structs: irtables.StructTab, sty: string): boolean {
  var n: i32 = irtables.decl_field_count(structs, sty);
  var fi: i32 = 0;
  while (fi < n) {
    var ft: string = irtables.decl_field_type_at(structs, sty, fi);
    if (tuple_field_deep_droppable(ft, structs)) {
      return true;
    }
    fi = fi + 1;
  }
  return false;
}

// --- Perceus precise drops (drop-on-last-use) for arrays -----------------
//
// Native's computePreciseDrops (ir.go ~3294) releases a value right after its
// last use instead of at function exit, bounding the live set. This is the
// conservative self-host first cut: it fires ONLY for a provably linear, owned
// array literal local — `var v = [ ... ]` declared once, never reassigned, and
// used ONLY as a borrow read (`v[i]`, `v.method()`, `for x in v`). Such a v is
// the sole owner of a fresh rc=1 buffer that never escapes, so releasing it
// right after its last top-level use is sound. Anything uncertain is omitted and
// falls back to the function-exit dec-sweep (the safe-leak invariant). The drop
// is emitted as dec + ZERO the slot, so the later exit-sweep harmlessly decs a
// null on that slot (no LowerState threading needed).

// str_borrowing_method reports whether a string method neither hands its
// receiver's box out nor returns a view of it: `len` plus the predicates and the
// fresh-copy transforms, each of which either reads the receiver's bytes or
// allocates a new buffer. A receiver at one of these is BORROWED for the call
// and nothing survives it. `.trim()` and `.replace()` are absent on purpose —
// both can return a VIEW of the receiver, which is a lasting alias.
function str_borrowing_method(field: string): boolean {
  return field == "len" || field == "to_ascii_upper" || field == "to_ascii_lower"
    || field == "repeat";
}

// str_method_recv_borrows extends str_borrowing_method's carve-out from the
// fixed builtin set to any SOURCE-DECLARED method the callee-side proof already
// clears, so `slice_unchecked(base, a, b).to_owned()` reads `base` instead of
// aliasing it.
//
// The proof is the plain recv_borrow key, which body_unsafe_for grants only when
// nothing carries the receiver out — so `to_owned` (`return s + ""`) qualifies
// and `trim` (`return slice_unchecked(s, low, high)`, a view of the receiver)
// does not. That is the same warrant the receiver RELEASE sites use; here it
// decides whether the SOURCE keeps its reclaim credit.
//
// The key can only be spelled `string.<method>`: this scan runs on bare AST with
// no types, so a same-named method on another type answers to it. That is sound
// only because admitting a receiver is what routes it to
// expr_unsafe_for_view_pos, which DIFFERS from expr_unsafe_for on a
// `slice_unchecked` call alone and delegates straight to it for every other
// shape — so any other receiver reaches the same verdict either way, and a view
// of a string is a string. A type check here would be dead code, not a guard.
function str_method_recv_borrows(field: string, recv_borrow: string[]): boolean {
  if (recv_borrow.len() == 0) {
    return false;
  }
  return util.index_of_str(recv_borrow, "string." + field) >= 0;
}

function binop_operand_unsafe_for_vb(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[], vb_borrow: boolean): boolean {
  match (e) {
    ast.ExprIdent(_) => {
      return false;
    },
    _ => {
      return expr_unsafe_for_view_pos_vb(e, name, borrowable, recv_borrow, vb_borrow);
    }
  }
  return expr_unsafe_for_view_pos_vb(e, name, borrowable, recv_borrow, vb_borrow);
}

// expr_unsafe_for_view_pos is expr_unsafe_for at a position that only BORROWS a
// string for the duration of one expression: the escape-scan twin of
// lower_view_borrowed, called from the same positions the lowerer treats as
// view-borrowing. A `slice_unchecked` of `name` there is a view that dies inside
// the expression — lower_str_slice_frame puts its box in reserved frame slots no
// slot_of can name — so the source is READ, not aliased out, and keeps its
// reclaim credit. Counting it as an escape cost
// `slice_unchecked(base, a, b).len()` the whole reclaim of `base`. The bounds
// are ordinary positions and scan unchanged.
//
// `s[a:b]` is deliberately absent: it wraps the view in an `Option[str]` box
// (#5634) that leaves the expression, and on the register backends that view
// still points into the SOURCE buffer (ir.fern's str_slice is zero-copy), so the
// source is aliased out and must fall through to expr_unsafe_for's escaping arm.
function expr_unsafe_for_view_pos(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[]): boolean {
  return expr_unsafe_for_view_pos_vb(e, name, borrowable, recv_borrow, false);
}

function expr_unsafe_for_view_pos_vb(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[], vb_borrow: boolean): boolean {
  match (e) {
    ast.ExprCall(c) => {
      // slice_unchecked(src, a, b) (#5634): the ExprSlice arm's builtin
      // spelling — the same frame-boxed view, so an ident source there
      // is the same borrow read.
      if (slice_unchecked_call(e)) {
        var su_unsafe: boolean = false;
        match (c.args[0]) {
          ast.ExprIdent(_) => {},
          _ => {
            su_unsafe = expr_unsafe_for_view_pos_vb(c.args[0], name, borrowable, recv_borrow, vb_borrow);
          }
        }
        return su_unsafe || expr_unsafe_for_vb(c.args[1], name, borrowable, recv_borrow, vb_borrow)
          || expr_unsafe_for_vb(c.args[2], name, borrowable, recv_borrow, vb_borrow);
      }
      return expr_unsafe_for_vb(e, name, borrowable, recv_borrow, vb_borrow);
    },
    _ => {
      return expr_unsafe_for_vb(e, name, borrowable, recv_borrow, vb_borrow);
    }
  }
  return expr_unsafe_for_vb(e, name, borrowable, recv_borrow, vb_borrow);
}

// expr_unsafe_for reports whether `name` appears anywhere in `e` in a position
// that could create a reference outliving a precise drop — i.e. ANY occurrence
// except a borrow read: the base of an index (`name[i]`), the receiver of a
// method/field access (`name.m(...)` / `name.f`), or a slice at one of the
// view-borrowing positions expr_unsafe_for_view_pos names. A bare ident, a
// slice anywhere else (the view aliases the buffer and can be carried out), a
// container-literal element, or a lambda capture all escape. A CALL ARGUMENT
// normally escapes too (the callee might retain it),
// EXCEPT a direct bare-ident `name` passed at a *borrowable* param position of a
// known free function (`borrowable` registry, "callee|flags") — a provably
// read-only callee cannot retain the arg, so passing it there is a BORROW. The
// registry is "" for Level-1 borrowability computation itself (every call arg
// escapes), avoiding circularity.
// expr_unsafe_for is the STRICT entry point: a value block inside `e` is walked
// with the strict walker too. expr_unsafe_for_vb is the same walk with the
// match-borrow reading carried into value blocks — see its ExprLambda arm.
function expr_unsafe_for(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[]): boolean {
  return expr_unsafe_for_vb(e, name, borrowable, recv_borrow, false);
}

function expr_unsafe_for_vb(e: ast.Expr, name: string, borrowable: string[], recv_borrow: string[], vb_borrow: boolean): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    ast.ExprNumber(_) => {
      return false;
    },
    ast.ExprString(_) => {
      return false;
    },
    ast.ExprBool(_) => {
      return false;
    },
    ast.ExprBinary(b) => {
      // The string binary ops — concat and the comparisons — read their
      // operands' bytes and move nothing, which is what lower_expr's
      // lower_view_borrowed calls at each of them say. Every other op is
      // arithmetic on scalars, where a slice operand cannot arise.
      if (b.op == "+" || b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
        return binop_operand_unsafe_for_vb(b.left, name, borrowable, recv_borrow, vb_borrow)
          || binop_operand_unsafe_for_vb(b.right, name, borrowable, recv_borrow, vb_borrow);
      }
      return expr_unsafe_for_vb(b.left, name, borrowable, recv_borrow, vb_borrow) || expr_unsafe_for_vb(b.right, name, borrowable, recv_borrow, vb_borrow);
    },
    ast.ExprUnary(u) => {
      return expr_unsafe_for_vb(u.operand, name, borrowable, recv_borrow, vb_borrow);
    },
    ast.ExprIndex(ix) => {
      var base_unsafe: boolean = false;
      match (ix.array) {
        ast.ExprIdent(_) => {  // name[i] / other[i]: base read is a borrow
          base_unsafe = false;
        },
        _ => {
          base_unsafe = expr_unsafe_for_view_pos(ix.array, name, borrowable, recv_borrow);
        }
      }
      return base_unsafe || expr_unsafe_for_vb(ix.index, name, borrowable, recv_borrow, vb_borrow);
    },
    ast.ExprSlice(sl) => {
      // a slice creates a VIEW that aliases the source buffer → escapes.
      return expr_unsafe_for_vb(sl.array, name, borrowable, recv_borrow, vb_borrow) || expr_unsafe_for_vb(sl.start, name, borrowable, recv_borrow, vb_borrow) || expr_unsafe_for_vb(sl.end, name, borrowable, recv_borrow, vb_borrow);
    },
    ast.ExprCall(c) => {
      var callee_unsafe: boolean = false;
      var callee_name: string = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          // A bare callee is a free function or a function value; calling
          // a function value reads its env box and keeps nothing, so
          // `name(args)` borrows `name`.
          callee_name = cid.name;
        },
        ast.ExprFieldAccess(fa) => {
          match (fa.obj) {
            ast.ExprIdent(_) => {
              callee_unsafe = false;  // name.method(): receiver is a borrow
              // `w.write(s)`: the registry carries "Writer.write" only
              // while the name can mean nothing else (copying_builtin_keys).
              if (fa.field == "write") {
                callee_name = "Writer.write";
              }
            },
            _ => {
              // `name[a:b].len()`: a view receiver at a method that
              // cannot retain it borrows the source, exactly as the
              // bare-ident receiver above does.
              if (str_borrowing_method(fa.field) || str_method_recv_borrows(fa.field, recv_borrow)) {
                callee_unsafe = expr_unsafe_for_view_pos(fa.obj, name, borrowable, recv_borrow);
              } else {
                callee_unsafe = expr_unsafe_for_vb(fa.obj, name, borrowable, recv_borrow, vb_borrow);
              }
            }
          }
          // every other method's args stay escapes: method-param
          // borrowability isn't in the registry (callee_name left "").
        },
        _ => {
          callee_unsafe = expr_unsafe_for_vb(c.callee, name, borrowable, recv_borrow, vb_borrow);
        }
      }
      if (callee_unsafe) {
        return true;
      }
      var ai: i32 = 0;
      while (ai < c.args.len()) {
        // Level 2: a DIRECT bare-ident `name` at a borrowable param position
        // of a known free function is a BORROW, not an escape.
        //
        // The "CNT:" tier admits a second position, and it is the only
        // tier on this registry that admits where the box flag REFUSES
        // ("TUPB:" / "ELB:" both narrow it). The two ask different
        // questions. The box flag asks whether the callee keeps a
        // reference at all; "CNT:" asks whether every reference it does
        // keep was RETAINED (param_counted_of). A retained one leaves
        // the caller's own claim intact and the callee's drop gives the
        // retain back, so exactly one release still belongs to the
        // caller — withholding it is the leak, not the safety.
        var arg_is_borrow: boolean = false;
        match (c.args[ai]) {
          ast.ExprIdent(aid) => {
            if (aid.name == name && callee_name.len() > 0
              && (param_is_borrowable(borrowable, callee_name, ai)
              || param_is_borrowable(borrowable, "CNT:" + callee_name, ai))) {
              arg_is_borrow = true;
            }
          },
          _ => {}
        }
        if (!arg_is_borrow && expr_unsafe_for_vb(c.args[ai], name, borrowable, recv_borrow, vb_borrow)) {
          return true;
        }
        ai = ai + 1;
      }
      return false;
    },
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(_) => {  // name.field: base read is a borrow
          return false;
        },
        _ => {
          return expr_unsafe_for_vb(fa.obj, name, borrowable, recv_borrow, vb_borrow);
        }
      }
    },
    ast.ExprArray(a) => {
      var i: i32 = 0;
      while (i < a.elements.len()) {
        if (expr_unsafe_for_vb(a.elements[i], name, borrowable, recv_borrow, vb_borrow)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        if (expr_unsafe_for_vb(el, name, borrowable, recv_borrow, vb_borrow)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprStructLit(sl) => {
      // A BARE-IDENT functional-update base (`T { ...name, … }`) reads
      // name's fields with struct_get and copies them out. That is a
      // BORROW of the box, the same as a method receiver — counting it as
      // an escape left every `d = T { ...d, … }` self-update with no
      // reclaim credit at all, so neither the box a rebind superseded nor
      // the final one was ever released. What the field copy does hazard
      // is the DEEP drop, because the copies carry no inc;
      // moves_fields_expr marks the name for that instead.
      if (sl.has_base) {
        match (sl.base) {
          ast.ExprIdent(_) => {},
          _ => {
            if (expr_unsafe_for_vb(sl.base, name, borrowable, recv_borrow, vb_borrow)) {
              return true;
            }
          }
        }
      }
      for fv in sl.field_values {
        if (expr_unsafe_for_vb(fv, name, borrowable, recv_borrow, vb_borrow)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprLambda(lm) => {
      // A VALUE BLOCK (`match`/`if`/block/comprehension expression, which
      // parser.fern desugars to a zero-arg IIFE) is not a closure: irlower
      // INLINES it, so nothing outlives the expression and a name read
      // inside it is an ordinary in-scope read. Walk it with the same rules
      // as the surrounding code — the strict walker's own StmtReturn arm
      // still flags the block's VALUE, which is the one way a name really
      // does leave (`var y = match (k) { A => p, … }`).
      //
      // The blanket capture test below is for a REAL lambda, whose body may
      // run after this frame. Applying it to a value block cost every struct
      // local read through a match expression its reclaim credit: the
      // apparent capture refused the alias-bind site, which withdrew the
      // source's credit too (#7282's two uses must agree), so neither box
      // was released — 0 frees where the same code without the match
      // expression is flat.
      if (parser.is_value_block_origin(lm.origin)) {
        // Walked by the caller's OWN walker, because the block is inlined:
        // a name read inside it is a read in the enclosing function, under
        // whatever reading that function's walker applies. `vb_borrow` is
        // the match-borrow walkers saying so — for them a bare-ident
        // `match (name)` scrutinee is a borrow, and recursing strictly here
        // threw that away, so a name read through a match EXPRESSION still
        // escaped. That cost the enum local its release AND the
        // borrowability of any param read that way, which cost every CALLER
        // its release too: 200 allocs / 0 frees against native's 200/200 on
        // `var v: E = E.A([..]); consume(v);`, where the same helper written
        // with a match STATEMENT was already flat.
        //
        // The strict walker keeps recursing strictly. precise_drop_names
        // reads it and widens to the match-borrow reading for ONE class at a
        // time on purpose; making the value block borrow-aware for everyone
        // silently widened the enum class too, and the plan then claimed a
        // precise drop of a box its own consuming-match reuse still owned.
        if (vb_borrow) {
          return body_unsafe_for_match_borrow(lm.body, name, borrowable, recv_borrow, []);
        }
        return body_unsafe_for(lm.body, name, borrowable, recv_borrow);
      }
      var used: string[] = [];
      var i: i32 = 0;
      while (i < lm.body.len()) {
        used = astwalk.collect_idents_stmt(lm.body[i], used);
        i = i + 1;
      }
      return util.index_of_str(used, name) >= 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// param_is_borrowable reports whether param `idx` of free function `name` is
// borrowable per a borrowability registry (see borrow_reg_new for the layout).
// Defaults false (unknown callee / out-of-range index → conservative escape).
//
// One bucket is scanned, not the whole registry. This runs for every call-arg on
// every body walk of every pass of both interproc fixpoints, over a table with
// an entry per function in the module — 1,359 of them for the pre-split
// irlower.fern — so the probe length is what this costs, and bucketing is what
// bounds it.
//
// Keys are matched by byte comparison, NOT by slicing out `e[p:bar]` and
// comparing strings: the slice allocated a fresh string per record examined, and
// that churn was ~800 MB of the whole-program emit floor (#3457 step 2). The
// length guard rejects a mismatched record before looking at any byte.
function param_is_borrowable(borrowable: string[], name: string, idx: i32): boolean {
  var nb: i32 = borrowable.len();
  // An empty registry is the conservative caller (`none`): nothing borrowable.
  if (nb == 0) {
    return false;
  }
  var e: string = borrowable[util.hash_bucket(name, nb)];
  var nl: i32 = name.len();
  var n: i32 = e.len();
  var p: i32 = 0;
  while (p < n) {
    var bar: i32 = p;
    while (bar < n && e[bar] != b'|') {
      bar = bar + 1;
    }
    var end: i32 = bar;
    while (end < n && e[end] != b'\n') {
      end = end + 1;
    }
    if (bar < n && bar - p == nl) {
      var eq: boolean = true;
      var k: i32 = 0;
      while (eq && k < nl) {
        if (e[p + k] != name[k]) {
          eq = false;
        }
        k = k + 1;
      }
      if (eq) {
        var pos: i32 = bar + 1 + idx;
        return pos < end && e[pos] == b'1';
      }
    }
    p = end + 1;
  }
  return false;
}

// sfld_assign_site: the key an assign-form counted field share is recorded under —
// the assignment's own position, so the escape walker matches this statement and
// no other assignment to the same holder.
function sfld_assign_site(asg: ast.StmtAssign): string {
  return irtables.reclaim_site_key_of(asg.target, asg.line, asg.col);
}

// alias_ok_holds_name: any site key in `alias_ok` is for the variable `name`. Used
// by the alias-REASSIGN forgiveness, which has only the target's name to key on.
function alias_ok_holds_name(alias_ok: string[], name: string): boolean {
  var i: i32 = 0;
  while (i < alias_ok.len()) {
    if (reclaim_site_name(alias_ok[i]) == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// body_unsafe_for lifts expr_unsafe_for over statements,
// special-casing `for x in name` (a borrow iteration, safe) and recursing into
// nested control-flow bodies. A reassignment of `name` is handled separately by
// the body_assign_targets bail, so StmtAssign only checks the RHS here.
function body_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[]): boolean {
  var no_alias: string[] = [];
  return body_unsafe_for_alias(stmts, name, borrowable, recv_borrow, no_alias);
}

// body_unsafe_for_alias is body_unsafe_for with one forgiveness: a plain
// `var v: T = name` bind whose own site key is listed in `alias_ok` does NOT
// flag `name` (#7282).
//
// The arithmetic that licenses it is DUPLICATION, not transfer. lower_stmt_var's
// ExprIdent arm retains an rc-container source at the bind, so both slots hold a
// counted reference; the alias is credited the source's own class, so both
// sweep, and the box reaches zero exactly once. Forgiving the escape without
// both halves would leave two slots sweeping one box at rc 1 — which is why the
// retain lands first and this gate is keyed on the alias's site rather than on
// its name.
//
// Only a BARE-IDENT init is forgiven, and only at a `var`. Every other mention
// of `name` — a container element, a call argument, a return, a lambda capture,
// a reassignment — still flags, because none of those takes the bind's retain.
function body_unsafe_for_alias(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[]): boolean {
  return body_unsafe_for_alias_vb(stmts, name, borrowable, recv_borrow, alias_ok, false);
}

function body_unsafe_for_alias_vb(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[], vb_borrow: boolean): boolean {
  for stmt in stmts {
    if (stmt_unsafe_for_alias_vb(stmt, name, borrowable, recv_borrow, alias_ok, vb_borrow)) {
      return true;
    }
  }
  return false;
}

// body_unsafe_for_alias_ret_ok: body_unsafe_for_alias with the one exemption
// the tuple owned-return admission needs — a bare top-level `return <name>`
// is the move-out the local exists for, not an escape (the ret_ok family's
// rule, alias-aware). Compound statements recurse HERE so a nested return in
// an if-arm is forgiven too; every other statement delegates to the strict
// walker.
function body_unsafe_for_alias_ret_ok(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[], bare_ret_ok: boolean): boolean {
  var no_counted: string[] = [];
  return body_unsafe_for_alias_ret_counted(stmts, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, no_counted);
}

// body_unsafe_for_alias_ret_counted is that gate with the counted-store
// forgiveness: a struct literal at a site in `counted_ok` took a COUNTED share
// of `name` (rctuple_counted_field_share), so storing into it is not an escape
// — both owners release, and the box reaches zero exactly once. Keyed by site,
// so the forgiveness cannot outrun the retain that pays for it (#7253).
function body_unsafe_for_alias_ret_counted(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[], bare_ret_ok: boolean, counted_ok: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        var bare: boolean = false;
        match (r.value) {
          ast.ExprIdent(rid) => {
            bare = bare_ret_ok && rid.name == name;
          },
          _ => {}
        }
        if (rctuple_counted_store_at(r.value, counted_ok)) {
          bare = true;
        }
        if (!bare && expr_unsafe_for(r.value, name, borrowable, recv_borrow)) {
          return true;
        }
      },
      ast.StmtVar(v) => {
        if (!rctuple_counted_store_at(v.init, counted_ok)
          && stmt_unsafe_for_alias(stmt, name, borrowable, recv_borrow, alias_ok)) {
          return true;
        }
      },
      ast.StmtExpr(e) => {
        if (!rctuple_counted_store_at(e.value, counted_ok)
          && stmt_unsafe_for_alias(stmt, name, borrowable, recv_borrow, alias_ok)) {
          return true;
        }
      },
      ast.StmtAssign(asg) => {
        if (!(asg.target != name && rctuple_counted_store_at(asg.value, counted_ok))
          && stmt_unsafe_for_alias(stmt, name, borrowable, recv_borrow, alias_ok)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (expr_unsafe_for(f.cond, name, borrowable, recv_borrow)) {
          return true;
        }
        if (body_unsafe_for_alias_ret_counted(f.then_body, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, counted_ok)) {
          return true;
        }
        if (body_unsafe_for_alias_ret_counted(f.else_body, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, counted_ok)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (expr_unsafe_for(w.cond, name, borrowable, recv_borrow)) {
          return true;
        }
        if (body_unsafe_for_alias_ret_counted(w.body, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, counted_ok)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        var fiter: boolean = true;
        match (fo.iter) {
          ast.ExprIdent(_) => {
            fiter = false;
          },
          _ => {
            fiter = expr_unsafe_for(fo.iter, name, borrowable, recv_borrow);
          }
        }
        if (fiter) {
          return true;
        }
        if (body_unsafe_for_alias_ret_counted(fo.body, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, counted_ok)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        if (expr_unsafe_for(m.scrutinee, name, borrowable, recv_borrow)) {
          return true;
        }
        var mi: i32 = 0;
        while (mi < m.arms.len()) {
          if (m.arms[mi].has_guard && expr_unsafe_for(m.arms[mi].guard, name, borrowable, recv_borrow)) {
            return true;
          }
          if (body_unsafe_for_alias_ret_counted(m.arms[mi].body, name, borrowable, recv_borrow, alias_ok, bare_ret_ok, counted_ok)) {
            return true;
          }
          mi = mi + 1;
        }
      },
      _ => {
        if (stmt_unsafe_for_alias(stmt, name, borrowable, recv_borrow, alias_ok)) {
          return true;
        }
      }
    }
  }
  return false;
}

function stmt_unsafe_for_alias(st: ast.Stmt, name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[]): boolean {
  return stmt_unsafe_for_alias_vb(st, name, borrowable, recv_borrow, alias_ok, false);
}

function stmt_unsafe_for_alias_vb(st: ast.Stmt, name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[], vb_borrow: boolean): boolean {
  match (st) {
    ast.StmtVar(v) => {
      if (alias_ok.len() > 0) {
        match (v.init) {
          ast.ExprIdent(aid) => {
            if (aid.name == name
              && util.index_of_str(alias_ok, irtables.reclaim_site_key_of(v.name, v.line, v.col)) >= 0) {
              return false;
            }
          },
          _ => {}
        }
      }
      return expr_unsafe_for_vb(v.init, name, borrowable, recv_borrow, vb_borrow);
    },
    ast.StmtReturn(r) => {
      return expr_unsafe_for_vb(r.value, name, borrowable, recv_borrow, vb_borrow);
    },
    ast.StmtExpr(e) => {
      return expr_unsafe_for_vb(e.value, name, borrowable, recv_borrow, vb_borrow);
    },
    ast.StmtAssign(a) => {
      // The REASSIGN twin of the StmtVar alias forgiveness above: `t = name`
      // hands the box to a slot that RETAINS it, so it is a counted share
      // rather than an escape. Only reached when the caller put t's site in
      // alias_ok, which it does only for a target it is about to credit.
      //
      // Matched by NAME rather than by site key, because an assignment
      // carries only the target's name — there is no line/col to key on. The
      // precision loss is bounded and lands in the safe direction: two
      // same-named string locals in sibling blocks share a verdict, and for
      // the STRING class sharing a verdict leaks rather than frees (the
      // struct class, where it would free a live box, is the one #7253 calls
      // out and is not this).
      if (alias_ok.len() > 0) {
        match (a.value) {
          ast.ExprIdent(rid) => {
            if (rid.name == name && alias_ok_holds_name(alias_ok, a.target)) {
              return false;
            }
          },
          _ => {}
        }
      }
      return expr_unsafe_for_vb(a.value, name, borrowable, recv_borrow, vb_borrow);
    },
    ast.StmtIf(f) => {
      if (expr_unsafe_for_vb(f.cond, name, borrowable, recv_borrow, vb_borrow)) {
        return true;
      }
      return body_unsafe_for_alias_vb(f.then_body, name, borrowable, recv_borrow, alias_ok, vb_borrow) || body_unsafe_for_alias_vb(f.else_body, name, borrowable, recv_borrow, alias_ok, vb_borrow);
    },
    ast.StmtWhile(w) => {
      if (expr_unsafe_for_vb(w.cond, name, borrowable, recv_borrow, vb_borrow)) {
        return true;
      }
      return body_unsafe_for_alias_vb(w.body, name, borrowable, recv_borrow, alias_ok, vb_borrow);
    },
    ast.StmtFor(fo) => {
      var iter_unsafe: boolean = true;
      match (fo.iter) {
        ast.ExprIdent(_) => {  // `for x in name`: borrow iteration
          iter_unsafe = false;
        },
        _ => {
          iter_unsafe = expr_unsafe_for_vb(fo.iter, name, borrowable, recv_borrow, vb_borrow);
        }
      }
      if (iter_unsafe) {
        return true;
      }
      return body_unsafe_for_alias_vb(fo.body, name, borrowable, recv_borrow, alias_ok, vb_borrow);
    },
    ast.StmtMatch(m) => {
      if (expr_unsafe_for_vb(m.scrutinee, name, borrowable, recv_borrow, vb_borrow)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && expr_unsafe_for_vb(arm.guard, name, borrowable, recv_borrow, vb_borrow)) {
          return true;
        }
        if (body_unsafe_for_alias_vb(arm.body, name, borrowable, recv_borrow, alias_ok, vb_borrow)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// body_unsafe_for_match_borrow / stmt_unsafe_for_match_borrow: body_unsafe_for,
// except the SCRUTINEE of a `match (name)` is a BORROW rather than an escape
// (#6127). expr_unsafe_for flags any bare ident, so the consuming match of an
// Option is itself read as an escape — which is right for a value that could be
// retained, and wrong for a match, which reads the tag and the payload and
// retains neither.
//
// consumed_rcpayload_option_frees has always made that argument, via
// name_escapes_outside_stmt skipping the consuming match by INDEX. That works
// only while the match is a top-level statement. precise_drop_names covers the
// case where it is not — the match sits in an `if` or a `while` body — and it
// gates on the coarse body_unsafe_for, so the nested form was refused outright
// and the whole box leaked. Measured over 100 rounds with the nesting as the only
// variable: top-level 0, inside an `if` 8000, inside a `while` 8000.
//
// Only an EXACT bare-ident scrutinee is exempted. `match (f(o))` and a scrutinee
// that merely mentions the name stay escapes, and arm guards and arm bodies are
// still walked in full — as is every other use of the name anywhere in the
// function, so an alias, a return or a call argument still refuses the candidate.
function body_unsafe_for_match_borrow(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[]): boolean {
  for stmt in stmts {
    if (stmt_unsafe_for_match_borrow(stmt, name, borrowable, recv_borrow, alias_ok)) {
      return true;
    }
  }
  return false;
}

function stmt_unsafe_for_match_borrow(st: ast.Stmt, name: string, borrowable: string[], recv_borrow: string[], alias_ok: string[]): boolean {
  match (st) {
    ast.StmtIf(f) => {
      if (expr_unsafe_for_vb(f.cond, name, borrowable, recv_borrow, true)) {
        return true;
      }
      return body_unsafe_for_match_borrow(f.then_body, name, borrowable, recv_borrow, alias_ok)
        || body_unsafe_for_match_borrow(f.else_body, name, borrowable, recv_borrow, alias_ok);
    },
    ast.StmtWhile(w) => {
      if (expr_unsafe_for_vb(w.cond, name, borrowable, recv_borrow, true)) {
        return true;
      }
      return body_unsafe_for_match_borrow(w.body, name, borrowable, recv_borrow, alias_ok);
    },
    ast.StmtFor(fo) => {
      var iter_unsafe: boolean = true;
      match (fo.iter) {
        ast.ExprIdent(_) => {
          iter_unsafe = false;
        },
        _ => {
          iter_unsafe = expr_unsafe_for_vb(fo.iter, name, borrowable, recv_borrow, true);
        }
      }
      if (iter_unsafe) {
        return true;
      }
      return body_unsafe_for_match_borrow(fo.body, name, borrowable, recv_borrow, alias_ok);
    },
    ast.StmtMatch(m) => {
      var scrut_borrow: boolean = false;
      match (m.scrutinee) {
        ast.ExprIdent(sid) => {
          if (sid.name == name) {
            scrut_borrow = true;
          }
        },
        _ => {}
      }
      if (!scrut_borrow && expr_unsafe_for_vb(m.scrutinee, name, borrowable, recv_borrow, true)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && expr_unsafe_for_vb(arm.guard, name, borrowable, recv_borrow, true)) {
          return true;
        }
        if (body_unsafe_for_match_borrow(arm.body, name, borrowable, recv_borrow, alias_ok)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      // The mode carries through the fallback too: a `var t = match (name) { … }`
      // is a StmtVar, so it lands here, and dropping to the strict walker is
      // exactly how the match-EXPRESSION read lost its borrow reading.
      return stmt_unsafe_for_alias_vb(st, name, borrowable, recv_borrow, alias_ok, true);
    }
  }
}

// body_unsafe_for_allow_ret / stmt_unsafe_for_allow_ret: the borrow check for the
// SNAPSHOT-param reclaim (#3456 slice 2) — identical to body_unsafe_for except a
// bare `return name` is SAFE (the builder param's final value is MOVED OUT to the
// caller, not retained). Every other unsafe use — an alias `var c = name`, a
// store into a container, a non-borrowable call arg, a slice — is still flagged.
function body_unsafe_for_allow_ret(stmts: ast.Stmt[], name: string, borrowable: string[], recv_borrow: string[]): boolean {
  for stmt in stmts {
    if (stmt_unsafe_for_allow_ret(stmt, name, borrowable, recv_borrow)) {
      return true;
    }
  }
  return false;
}

function stmt_unsafe_for_allow_ret(st: ast.Stmt, name: string, borrowable: string[], recv_borrow: string[]): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return expr_unsafe_for(v.init, name, borrowable, recv_borrow);
    },
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprIdent(_) => {  // `return name`: move-out, safe
          return false;
        },
        _ => {
          return expr_unsafe_for(r.value, name, borrowable, recv_borrow);
        }
      }
    },
    ast.StmtExpr(e) => {
      return expr_unsafe_for(e.value, name, borrowable, recv_borrow);
    },
    ast.StmtAssign(a) => {
      return expr_unsafe_for(a.value, name, borrowable, recv_borrow);
    },
    ast.StmtIf(f) => {
      if (expr_unsafe_for(f.cond, name, borrowable, recv_borrow)) {
        return true;
      }
      return body_unsafe_for_allow_ret(f.then_body, name, borrowable, recv_borrow) || body_unsafe_for_allow_ret(f.else_body, name, borrowable, recv_borrow);
    },
    ast.StmtWhile(w) => {
      if (expr_unsafe_for(w.cond, name, borrowable, recv_borrow)) {
        return true;
      }
      return body_unsafe_for_allow_ret(w.body, name, borrowable, recv_borrow);
    },
    ast.StmtFor(fo) => {
      var iter_unsafe: boolean = true;
      match (fo.iter) {
        ast.ExprIdent(_) => {
          iter_unsafe = false;
        },
        _ => {
          iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, recv_borrow);
        }
      }
      if (iter_unsafe) {
        return true;
      }
      return body_unsafe_for_allow_ret(fo.body, name, borrowable, recv_borrow);
    },
    ast.StmtMatch(m) => {
      if (expr_unsafe_for(m.scrutinee, name, borrowable, recv_borrow)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, recv_borrow)) {
          return true;
        }
        if (body_unsafe_for_allow_ret(arm.body, name, borrowable, recv_borrow)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// --- struct reclamation: conservative intra-procedural escape analysis ---
//
// reclaimable_names_of computes the struct-local names that are SAFE to free at
// scope exit / loop-rebind: names bound from a FRESH struct literal (a sole-owner
// rc=1 box) that never ESCAPE the function. A name escapes if it appears anywhere
// as a value — a return value, a call argument, a method receiver, a struct-lit
// field value, an array/tuple element, an operand, or the RHS of any binding /
// assignment — i.e. anything but a pure field READ (p.x, even `return p.x`,
// copies a scalar out and leaves p local). Anything uncertain is treated as
// escaping and left to leak: freeing only proven sole-owner non-escaping boxes
// cannot dangle another live reference (the safety property the earlier shallow-RC
// slice lacked — it freed escaping boxes and use-after-free'd the self-compile).
// Later slices widen this toward the native inter-procedural borrow inference.

// push_str_unique appends s to xs unless already present.
function push_str_unique(xs: string[], s: string): string[] {
  if (util.index_of_str(xs, s) >= 0) {
    return xs;
  }
  return xs.append(s);
}

// reclaim_site_name recovers the bare variable name from a site key, for the
// escape gates and declaration lookups, which all take a name.
function reclaim_site_name(key: string): string {
  var i: i32 = 0;
  while (i < key.len() && key[i] != b'@') {
    i = i + 1;
  }
  return slice_unchecked(key, 0, i) + "";
}

// --- frame-allocated string views (#6713) ------------------------------------
//
// A string view `slice_unchecked(s, a, b)` is zero-copy: a 24-byte box
// [rc=-1, data = src.data + start, len] sharing the source buffer. Sharing is
// why it is born IMMORTAL (rc=-1, #4294) — freeing it would release the middle
// of the source's allocation — and immortal is why it is never reclaimed, so a
// slice in a loop costs one unreclaimable box per EVALUATION where native, which
// has no box at all, allocates nothing.
//
// view_frame_names_of returns the local names whose box may live in the FRAME
// instead of the heap: names bound from a slice and used ONLY where the box is
// borrowed for the duration of one expression — the `.len()` receiver, a byte
// index `t[i]`, a comparison or concat operand, and the source of a further
// slice (whose own data pointer aims at the SOURCE buffer, not at this box, so
// it outlives it safely).
//
// Everything else is refused, and the whitelist has to be that narrow because
// there are two distinct hazards, not one. A reference that outlives the FRAME
// dangles. A reference that outlives the next execution of the same SITE reads
// the newer view instead — one frame slot serves a site, so a loop rewrites it
// once per iteration. Copying the name into a second local (`var u = t`,
// `prev = cur`)
// is the second hazard's classic shape, which is why a bare ident in a binding
// position is refused even though the frame is still very much alive.
function ident_named_is(e: ast.Expr, name: string): boolean {
  return ident_name_or_empty(e) == name && name.len() > 0;
}

// expr_mentions_name: does `name` appear anywhere in `e`? The fallback for an
// expression shape the borrow whitelist does not model — mentioned there at all
// means refused.
function expr_mentions_name(e: ast.Expr, name: string): boolean {
  return util.index_of_str(astwalk.collect_idents_expr(e, []), name) >= 0;
}

// --- borrowed-value guard (#6158) --------------------------------------------
//
// The alias scan above answers "does another LOCAL name reach this buffer",
// which is only half of what the in-place self-reassign needs. The other half
// is OWNERSHIP: `x = x.with(i, v)` overwrites in place on the assumption that
// `x` is a sole owner, and a BORROWED value is not one no matter how few local
// aliases it has. Three shapes reached the in-place path while the caller still
// owned the buffer, so the write landed in the caller's array:
//
//   * a borrowed ARRAY PARAM self-reassigned directly
//     (`function patch(buf: i32[], …) { buf = buf.with(at, v); }`);
//   * a local bound from an array FIELD of a borrowed struct param
//     (`var sn = st.seen; sn = sn.with(pc, g);` — std/regex's __rx_addthread);
//   * the same off a LOCAL struct that is still read afterwards.
//
// The language already models the sound version, and the hot paths already use
// it: `arm64_write_word(own buf: i32[], …)` consumes its buffer precisely so
// the rc check sees a unique owner, and E051 makes that annotation trustworthy
// at every call site. So the rule is ownership, not syntax — an `own` param
// keeps the fast path, a borrowed one copies (once, for a scalar-element array
// whose rebinds carry the ownership flag; on every update otherwise).
//
// The `own`-param + field-clear idiom (`var code = a.code; a = A { ...a, code:
// [] };` — arm64_asm_resolve's three quadratic patch loops, #6011) stays
// in-place: the source field is emptied before the mutation, so the local IS
// the only reference. That exemption is why this keys on a positional scan
// rather than flagging every field-read binding.

// stmt_assigns_name reports whether `st` is a direct `NAME = …` assignment.
function stmt_assigns_name(st: ast.Stmt, name: string): boolean {
  match (st) {
    ast.StmtAssign(a) => {
      return a.target == name;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// --- map locals borrowed by a tuple element (#7212) --------------------------
//
// `var t: (i32, Map[K, V]) = (i, m)` mentions `m` at a container-element
// position, so both map-reclaim gates refuse it: alias_idents_in_value credits
// the alias and expr_unsafe_for calls the element an escape. Nothing on the
// TUPLE side takes over — tuple construction emits no rc_inc for a map slot, and
// emit_tuple_child_drops skips a bare-ident element, and emit_tuple_type_child_drops
// never sees a Map-typed one — both payload predicates refuse that position outright,
// which is what keeps the ident widening for ARRAY positions (#7281) clear of this
// case. So the map box ends up with no owner at all and leaks every round, where
// native is flat.
//
// Exactly ONE release is owed, and the local is the one that owes it: with no
// retain at construction the tuple holds a BARE pointer, so `m` and `t.1` are one
// box at rc 1. Freeing from both sides would double-release, which is why the
// element side stays untouched here.
//
// The relaxation is sound only while the tuple cannot be read after the map's
// sweep point. Scope exit is after every read of a local tuple, so the "MAP:"
// exit set may take it; the PRECISE drop fires at the map's last TOP-LEVEL use —
// which is the tuple binding itself — so that gate keeps refusing.

// is_fresh_struct_init: an init producing a SOLE-OWNER (rc=1) struct value — a
// direct struct literal of a known struct type. (A struct-returning call is a
// move too, but this slice reclaims only directly-constructed structs; an aliased
// or call-bound struct is simply left to leak.) A functional update
// `T { ...base, … }` qualifies only when every field it CARRIES copies counted
// (spread_carried_fields_counted): a carried field the box does not own a
// deep-releasable count of would be freed under the base by the reclaim the
// credit admits.
function is_fresh_struct_init(e: ast.Expr, structs: irtables.StructTab, sfok: string[]): boolean {
  match (e) {
    ast.ExprStructLit(slit) => {
      if (!irtables.decl_is_struct(structs, slit.type_name)) {
        return false;
      }
      return !slit.has_base || spread_carried_fields_counted(structs, sfok, slit);
    },
    _ => {
      return false;
    }
  }
}

// tuple_str_elem_fresh reports whether a tuple element expression PRODUCES a
// provably fresh string box: a `+` concat with a string-literal (or itself
// fresh-string) operand — concat always allocates a new box whatever its
// operands' ownership — or a 0-arg `.to_string()` call. The tuple box sole-owns
// the result, so the deep-drop's rc-aware __fern_str_free is exactly balanced
// (#4353 item 1, the string sibling of the fresh-array-literal element). A bare
// string IDENT element aliases a live local and is NOT fresh (the caller rejects
// the tuple, leak-safe — same as the array arm's ident exclusion); a plain
// `a + b` ident concat is excluded too (indistinguishable from numeric add
// without type info).
function tuple_str_elem_fresh(e: ast.Expr): boolean {
  match (e) {
    ast.ExprBinary(b) => {
      if (b.op != "+") {
        return false;
      }
      var lok: boolean = false;
      match (b.left) {
        ast.ExprString(_) => {
          lok = true;
        },
        _ => {
          lok = tuple_str_elem_fresh(b.left);
        }
      }
      if (lok) {
        return true;
      }
      match (b.right) {
        ast.ExprString(_) => {
          return true;
        },
        _ => {
          return tuple_str_elem_fresh(b.right);
        }
      }
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field == "to_string" && c.args.len() == 0) {
            return true;
          }
        },
        _ => {}
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// tuple_str_elem_fresh_reg widens tuple_str_elem_fresh by the whole-program
// fresh-string registry (#7374): a direct call to a registered producer
// (str_fresh_ret_fns' bare-name entries) hands back a fresh sole-owned box by
// the registry's own fixpoint — the same admission the syntactic form already
// gives `.to_string()`. A separate named predicate so every gate that widens
// says so at its call site (the #7553/OPTSTR lesson); concat operands recurse
// through the widened form, so `w("p") + q` counts too (the registry proves
// the `+` is a string concat, and a concat always allocates).
function tuple_str_elem_fresh_reg(e: ast.Expr, str_fresh_ret: string[]): boolean {
  if (tuple_str_elem_fresh(e)) {
    return true;
  }
  match (e) {
    ast.ExprBinary(b) => {
      if (b.op != "+") {
        return false;
      }
      if (tuple_str_elem_fresh_reg(b.left, str_fresh_ret)) {
        return true;
      }
      return tuple_str_elem_fresh_reg(b.right, str_fresh_ret);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return util.index_of_str(str_fresh_ret, cid.name) >= 0;
        },
        _ => {}
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// tuple_strarr_elem_fresh reports whether `e` is a non-empty string-ARRAY literal
// whose every element is a provably fresh string box (a literal, or a
// tuple_str_elem_fresh producer). Such a position sole-owns the buffer AND every
// element box, so __fern_str_arr_free releases it exactly; one bare-ident element
// aliases a live local and keeps the position on the shallow buffer-only dec.
function tuple_strarr_elem_fresh(e: ast.Expr, str_fresh: string[]): boolean {
  match (e) {
    ast.ExprArray(al) => {
      if (al.elements.len() == 0) {
        return false;
      }
      var i: i32 = 0;
      while (i < al.elements.len()) {
        var ok: boolean = false;
        match (al.elements[i]) {
          ast.ExprString(_) => {
            ok = true;
          },
          _ => {
            ok = tuple_str_elem_fresh_reg(al.elements[i], str_fresh);
          }
        }
        if (!ok) {
          return false;
        }
        i = i + 1;
      }
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// rctuple_counted_store_at reports whether `e` is a struct literal whose site is
// in the counted-store list.
function rctuple_counted_store_at(e: ast.Expr, counted_ok: string[]): boolean {
  if (counted_ok.len() == 0) {
    return false;
  }
  match (e) {
    ast.ExprStructLit(sl) => {
      return util.index_of_str(counted_ok, util.i32_to_string(sl.line) + ":" + util.i32_to_string(sl.col)) >= 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// rctuple_esc_expr_is_ident reports whether `e` is exactly the bare ident
// `name` — the only field-value spelling the counted-store forgiveness admits.
function rctuple_esc_expr_is_ident(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// rctuple_struct_field_counted_store: field `fi` of literal `sl` is a direct
// tuple field whose store the construction arm RETAINS and
// emit_struct_tuple_field_drops releases. struct_has_deep_tuple_field is the
// narrower half of the retain's slit_reclaim gate, so this implies the retain
// fired; the field's own type must be deep-droppable too, or the drop emits no
// arm for it.
function rctuple_struct_field_counted_store(sl: ast.ExprStructLit, fi: i32, name: string, structs: irtables.StructTab): boolean {
  if (!struct_has_deep_tuple_field(structs, sl.type_name)) {
    return false;
  }
  if (fi < 0 || fi >= sl.field_names.len()) {
    return false;
  }
  var di: i32 = decl_field_index(structs, sl.type_name, sl.field_names[fi]);
  if (di < 0) {
    return false;
  }
  return tuple_field_deep_droppable(irtables.decl_field_type_at(structs, sl.type_name, di), structs);
}

// esc_tuple_field_of: `e` is a field read directly off the bare local `root`
// (`root.<f>`) — returns `<f>`; "" otherwise.
function esc_tuple_field_of(e: ast.Expr, root: string): string {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      if (ident_name_or_empty(fa.obj) == root) {
        return fa.field;
      }
      return "";
    },
    _ => {
      return "";
    }
  }
  return "";
}

// rctuple_esc_shape classifies one node for the rc-tuple escape scan
// (rctuple_esc_expr below has the scan's contract). It is the single source of
// truth BOTH fold closures consult: `descend` walks a node's children exactly
// when it answers 0, and rctuple_esc_at maps every other answer to a verdict
// or a re-scan of the shape's chosen children. The codes, shared by all three
// element-escape scanners (this one, arrtup, arrstruct):
//   0 — generic: no verdict at this node; the spine walks the children.
//   1 — settled false: an opaque node (lambda / map-literal / f-string, which
//       the scan treats as no-use rather than walking into) or a whitelisted
//       borrow with nothing left to check.
//   2 — escape.
//   3 — borrow chain: the access chain itself is safe; every index expression
//       along it and every call argument still needs its own scan (the
//       family's chain_esc).
//   4 — free-function call with per-argument borrow forgiveness.
//   5 — a sanctioned counted store: forgiven slots are skipped, the rest scanned.
function rctuple_esc_shape(e: ast.Expr, name: string, ttype: string, structs: irtables.StructTab): i32 {
  match (e) {
    ast.ExprIdent(id) => {  // bare whole tuple escapes
      if (id.name == name) {
        return 2;
      }
      return 1;
    },
    ast.ExprNumber(_) => {
      return 1;
    },
    ast.ExprString(_) => {
      return 1;
    },
    ast.ExprBool(_) => {
      return 1;
    },
    ast.ExprFieldAccess(fa) => {
      var tf: string = esc_tuple_field_of(e, name);
      if (tf.len() > 0) {
        // name.<i> : a pointer element extracted bare escapes; a scalar
        // element (or a non-positional field) is a by-value copy.
        if (util.is_all_digits(tf)
          && !irtables.is_scalar_type_name(irtables.tuple_type_elem_tag(ttype, util.digits_to_i32(tf)))) {
          return 2;
        }
        return 1;
      }
      var pf: string = esc_tuple_field_of(fa.obj, name);
      if (pf.len() > 0 && util.is_all_digits(pf)) {
        // name.<i>.<f> : a struct-element field read.
        var ety: string = irtables.tuple_type_elem_tag(ttype, util.digits_to_i32(pf));
        // A NESTED TUPLE element indexes BY POSITION, not by struct
        // field name: `t.2.0` copies a scalar out of t's tuple element,
        // a borrow exactly like the struct scalar-field read below.
        // decl_field_type finds no struct for a `(..)` tag and the ""
        // it returns is not scalar, so such a read counted as a bare
        // pointer extraction and cost the whole tuple its reclaim.
        if (util.is_tuple_type_name(ety) && util.is_all_digits(fa.field)) {
          if (irtables.is_scalar_type_name(irtables.tuple_type_elem_tag(ety, util.digits_to_i32(fa.field)))) {
            return 1;
          }
          return 2;
        }
        if (irtables.is_scalar_type_name(irtables.decl_field_type(structs, ety, fa.field))) {  // scalar struct-field copy
          return 1;
        }
        return 2;  // struct array/pointer field extracted bare
      }
      return 0;
    },
    ast.ExprIndex(ix) => {
      if (ident_name_or_empty(ix.array) == name) {  // bare name[..]
        return 2;
      }
      var bf: string = esc_tuple_field_of(ix.array, name);
      if (bf.len() > 0 && util.is_all_digits(bf)) {  // name.<i>[j] : indexed array-element read
        return 3;
      }
      match (ix.array) {
        ast.ExprFieldAccess(bfa) => {
          var pbf: string = esc_tuple_field_of(bfa.obj, name);
          if (pbf.len() > 0 && util.is_all_digits(pbf)) {  // name.<i>.<f>[j] : indexed struct array-field read
            return 3;
          }
          return 0;
        },
        _ => {
          return 0;
        }
      }
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(_) => {
          return 4;
        },
        ast.ExprFieldAccess(cfa) => {
          // name.<i>(args) : a call through a closure element borrows it.
          var cf: string = esc_tuple_field_of(c.callee, name);
          if (util.is_all_digits(cf) && irtables.tuple_type_elem_tag(ttype, util.digits_to_i32(cf)) == "clo") {
            return 3;
          }
          if (cfa.field == "len") {
            var rf: string = esc_tuple_field_of(cfa.obj, name);
            if (rf.len() > 0 && util.is_all_digits(rf)) {  // name.<i>.len() : array-element length borrow
              return 3;
            }
            match (cfa.obj) {
              ast.ExprFieldAccess(ofa) => {
                var orf: string = esc_tuple_field_of(ofa.obj, name);
                if (orf.len() > 0 && util.is_all_digits(orf)) {  // name.<i>.<f>.len() : struct array-field length borrow
                  return 3;
                }
              },
              _ => {}
            }
          }
          return 0;
        },
        _ => {
          return 0;
        }
      }
    },
    ast.ExprBinary(_) => {
      return 0;
    },
    ast.ExprUnary(_) => {
      return 0;
    },
    ast.ExprSlice(_) => {
      return 0;
    },
    ast.ExprArray(_) => {
      return 0;
    },
    ast.ExprTuple(_) => {
      return 0;
    },
    ast.ExprStructLit(sl) => {
      var sfi: i32 = 0;
      for fv in sl.field_values {
        if (rctuple_struct_field_counted_store(sl, sfi, name, structs)
          && rctuple_esc_expr_is_ident(fv, name)) {
          return 5;
        }
        sfi = sfi + 1;
      }
      return 0;
    },
    ast.ExprLambda(_) => {
      return 1;
    },
    ast.ExprMapLit(_) => {
      return 1;
    },
    ast.ExprFString(_) => {
      return 1;
    },
    ast.ExprUnknown(_) => {
      return 1;
    },
    ast.ExprZero(_) => {
      return 1;
    }
  }
  return 0;
}

// rctuple_chain_esc re-scans the parts of a code-3 borrow chain the shape did
// not settle: every index expression along it and every call argument. The
// chain links themselves (field reads, the indexed reads' arrays, a `.len()`
// callee) were classified safe as one shape, and the root ident is the
// borrowed local; a link the classifier did not admit errs toward escape.
function rctuple_chain_esc(x: ast.Expr, name: string, ttype: string, structs: irtables.StructTab, borrowable: string[]): boolean {
  match (x) {
    ast.ExprCall(c) => {
      if (rctuple_chain_esc(c.callee, name, ttype, structs, borrowable)) {
        return true;
      }
      for arg in c.args {
        if (rctuple_esc_expr(arg, name, ttype, structs, borrowable)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprFieldAccess(fa) => {
      return rctuple_chain_esc(fa.obj, name, ttype, structs, borrowable);
    },
    ast.ExprIndex(ix) => {
      if (rctuple_chain_esc(ix.array, name, ttype, structs, borrowable)) {
        return true;
      }
      return rctuple_esc_expr(ix.index, name, ttype, structs, borrowable);
    },
    ast.ExprIdent(_) => {
      return false;
    },
    _ => {
      return true;
    }
  }
  return false;
}

// rctuple_esc_at is the fold visitor: `esc` latches true, and each node
// answers per its rctuple_esc_shape code.
function rctuple_esc_at(x: ast.Expr, esc: boolean, name: string, ttype: string, structs: irtables.StructTab, borrowable: string[]): boolean {
  if (esc) {
    return true;
  }
  var code: i32 = rctuple_esc_shape(x, name, ttype, structs);
  if (code == 2) {
    return true;
  }
  if (code == 3) {
    return rctuple_chain_esc(x, name, ttype, structs, borrowable);
  }
  if (code == 4) {
    match (x) {
      ast.ExprCall(c) => {
        var callee: string = ident_name_or_empty(c.callee);
        if (callee == name) {
          return true;
        }
        // A DIRECT bare-ident `name` at a PAYLOAD-borrowable param
        // position of a known free function is a BORROW, not a payload
        // escape. The key is the "TUPB:" tier, NOT the plain box flag:
        // box borrowability only proves the callee never keeps the box,
        // and a callee returning src.1 keys box-borrowable while this
        // scan's deep reclaim would free the handed-out element under it
        // (sanitizer-confirmed UAF). TUPB additionally proves no payload
        // of the param escapes the callee — the question a TUPRCS deep
        // free actually asks. Without any forgiveness, `round(keep, i)`
        // with a purely-reading callee cost the caller's rc-tuple its
        // whole deep reclaim.
        //
        // "CNT:" is the second admission: the callee does not merely
        // borrow, it stores the tuple into a struct literal that RETAINS
        // it, so the caller's deep free and the holder's field drop net
        // to one owner. The shared key ORs every counted tier, but only
        // "TCNT:" can have flagged a position whose param type is a
        // tuple — the array, string, enum and array-of-boxes tiers each
        // test a type this argument does not have — so reading the
        // merged flag cannot borrow another tier's verdict.
        var rai: i32 = 0;
        while (rai < c.args.len()) {
          var rarg_borrow: boolean = ident_name_or_empty(c.args[rai]) == name
            && (param_is_borrowable(borrowable, "TUPB:" + callee, rai)
            || param_is_borrowable(borrowable, "CNT:" + callee, rai));
          if (!rarg_borrow && rctuple_esc_expr(c.args[rai], name, ttype, structs, borrowable)) {
            return true;
          }
          rai = rai + 1;
        }
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  if (code == 5) {
    match (x) {
      ast.ExprStructLit(sl) => {
        if (sl.has_base && rctuple_esc_expr(sl.base, name, ttype, structs, borrowable)) {
          return true;
        }
        var sfi: i32 = 0;
        for fv in sl.field_values {
          // `S { t: name, ... }` into a deep-droppable tuple field of a
          // type that routes tuple field reclaim is a COUNTED store, not
          // an escape: the construction arm inc'd the box and
          // emit_struct_tuple_field_drops decs it once per owner, so the
          // source keeps its own release (rc 1 -> inc 2 -> this sweep 1 ->
          // the struct's field drop 0). Forgiven on the same predicate
          // that gates the retain, so the two cannot come apart (#7253) —
          // and on the narrower half of it, so a forgiven store is always
          // one the retain actually fired for.
          if (!(rctuple_struct_field_counted_store(sl, sfi, name, structs)
            && rctuple_esc_expr_is_ident(fv, name))) {
            if (rctuple_esc_expr(fv, name, ttype, structs, borrowable)) {
              return true;
            }
          }
          sfi = sfi + 1;
        }
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  return false;
}

// rctuple_esc_expr: does `e` use the fresh rc-tuple local `name` (declared tuple type
// `ttype`) in a way that ESCAPES an owned pointer the whole-tuple deep-drop would free?
// The tuple carries at least one owned pointer element (an array / a reclaim-struct box);
// the deep-drop frees those, so a WHOLE element extracted bare would then be over-released.
// Borrows (safe): a scalar element read `name.<i>` (by-value copy); an indexed array-element
// read `name.<i>[j]`; a struct-element scalar-field read `name.<i>.<f>`; an indexed struct
// array-field read `name.<i>.<f>[j]`; and the `.len()` of either. ESCAPES (true): a bare
// `name`; a bare POINTER element `name.<i>` (array / struct box); a bare struct array-field
// `name.<i>.<f>`. Erring toward escape is a safe leak, never an over-release. Mirrors
// arrtup_elem_esc_expr, rooted at a bare-local tuple (`name.<i>`) instead of `name[k].<i>`.
function rctuple_esc_expr(e: ast.Expr, name: string, ttype: string, structs: irtables.StructTab, borrowable: string[]): boolean {
  function visit(x: ast.Expr, own esc: boolean): boolean {
    return rctuple_esc_at(x, esc, name, ttype, structs, borrowable);
  }
  function descend(x: ast.Expr): boolean {
    return rctuple_esc_shape(x, name, ttype, structs) == 0;
  }
  return astwalk.fold_expr_pruned(e, false, visit, descend);
}

// rctuple_scrutinee_is_elem_read reports whether `e` is exactly `name.<i>` — a
// positional read of one element of the candidate tuple local, and nothing more.
// Anything wrapping it (a call, an index, the bare local) is not this shape.
function rctuple_scrutinee_is_elem_read(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      if (!util.is_all_digits(fa.field)) {
        return false;
      }
      match (fa.obj) {
        ast.ExprIdent(id) => {
          return id.name == name;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// tuple_elem_ret_dup: THE dup-at-extract admission — `e` is exactly
// `name.<i>` and element <i> of `ttype` is an rc ARRAY. This one predicate
// has two entry points and no near-copy (the 08-22 struct-producer rule):
// the return lowering's ret_is_tuple_elem_dup gates the retain for
// exactly this shape, and the rc-tuple escape scans forgive exactly this
// shape — so "the escape stops being an escape" is true by construction,
// never by two conditions happening to line up. String / struct / nested
// tuple elements are refused here ON BOTH SIDES (their retain protocol is
// a separate port), which keeps unretained shapes refused.
pub function tuple_elem_ret_dup(e: ast.Expr, name: string, ttype: string): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      if (!util.is_all_digits(fa.field)) {
        return false;
      }
      match (fa.obj) {
        ast.ExprIdent(id) => {
          if (id.name != name) {
            return false;
          }
          return irtables.is_array_type_name(irtables.tuple_type_elem_tag(ttype, util.digits_to_i32(fa.field)));
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// rctuple_esc_stmt_alias carries the #7282 alias forgiveness THROUGH the
// recursion, which is the whole point: a first version checked the forgiven
// bind only at the top level of the statement list and fell into the plain
// walker for anything nested, so a block-scoped `{ var v = t; }` still denied
// the credit. The function-scope sibling measured clean while the block-scoped
// one sat at exactly its unfixed number — two dec sites missing from the emitted
// asm, and nothing else to see.
function rctuple_esc_stmt_alias(st: ast.Stmt, name: string, ttype: string, structs: irtables.StructTab, borrowable: string[], alias_ok: string[], elem_ok: string[], ret_dup_ok: boolean): boolean {
  match (st) {
    ast.StmtVar(v) => {
      if (alias_ok.len() > 0) {
        match (v.init) {
          ast.ExprIdent(aid) => {
            if (aid.name == name
              && util.index_of_str(alias_ok, irtables.reclaim_site_key_of(v.name, v.line, v.col)) >= 0) {
              return false;
            }
          },
          _ => {}
        }
      }
      // A vetted ELEMENT bind is not an escape (#7766): the target is a
      // local the frame keeps, so it is dead by the exit sweep and the deep
      // free releases memory nothing reads again. tuple_elem_bind_sites_of
      // admits only targets that are neither reassigned nor escaping, so
      // `return name.1` and a stored element still land below.
      if (elem_ok.len() > 0
        && util.index_of_str(elem_ok, irtables.reclaim_site_key_of(v.name, v.line, v.col)) >= 0) {
        return false;
      }
      return rctuple_esc_expr(v.init, name, ttype, structs, borrowable);
    },
    ast.StmtReturn(r) => {
      if (ret_dup_ok && tuple_elem_ret_dup(r.value, name, ttype)) {
        return false;
      }
      return rctuple_esc_expr(r.value, name, ttype, structs, borrowable);
    },
    ast.StmtExpr(e) => {
      return rctuple_esc_expr(e.value, name, ttype, structs, borrowable);
    },
    ast.StmtAssign(a) => {
      return rctuple_esc_expr(a.value, name, ttype, structs, borrowable);
    },
    ast.StmtIf(f) => {
      if (rctuple_esc_expr(f.cond, name, ttype, structs, borrowable)) {
        return true;
      }
      var ti: i32 = 0;
      while (ti < f.then_body.len()) {
        if (rctuple_esc_stmt_alias(f.then_body[ti], name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) {
          return true;
        }
        ti = ti + 1;
      }
      var ei: i32 = 0;
      while (ei < f.else_body.len()) {
        if (rctuple_esc_stmt_alias(f.else_body[ei], name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) {
          return true;
        }
        ei = ei + 1;
      }
      return false;
    },
    ast.StmtWhile(w) => {
      if (rctuple_esc_expr(w.cond, name, ttype, structs, borrowable)) {
        return true;
      }
      var i: i32 = 0;
      while (i < w.body.len()) {
        if (rctuple_esc_stmt_alias(w.body[i], name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.StmtFor(fo) => {
      if (rctuple_esc_expr(fo.iter, name, ttype, structs, borrowable)) {
        return true;
      }
      var i: i32 = 0;
      while (i < fo.body.len()) {
        if (rctuple_esc_stmt_alias(fo.body[i], name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.StmtMatch(m) => {
      // A scrutinee that is EXACTLY `name.<i>` reads that element's tag and
      // copies its payload into the arm binding; it stores the box nowhere,
      // so it is a BORROW rather than the bare pointer extraction
      // rctuple_esc_expr sees in a non-scalar element read. The reclaim
      // frees the tuple's own children and its box but never a union
      // element's PAYLOAD, so a binding taken from one stays valid.
      //
      // Only that exact shape. `match (t)` on the whole tuple, or an
      // element handed through a call, still walks as an escape — those
      // hand the pointer somewhere the reclaim cannot see.
      if (!rctuple_scrutinee_is_elem_read(m.scrutinee, name)
        && rctuple_esc_expr(m.scrutinee, name, ttype, structs, borrowable)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && rctuple_esc_expr(arm.guard, name, ttype, structs, borrowable)) {
          return true;
        }
        var bi: i32 = 0;
        while (bi < arm.body.len()) {
          if (rctuple_esc_stmt_alias(arm.body[bi], name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) {
            return true;
          }
          bi = bi + 1;
        }
      }
      return false;
    },
    ast.StmtDefer(d) => {
      return rctuple_esc_stmt_alias(d.action, name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// rctuple_payload_escapes_alias is the same scan with the #7282 forgiveness: a
// plain `var v = name` bind listed in `alias_ok` is not a payload escape,
// because the bind retained the box and the alias carries the source's own
// credit, so both slots release it.
//
// A CLASS CONSULTS MORE THAN ONE ESCAPE SCAN, and every one of them has to be
// told. body_unsafe_for is the shared gate; this is the rc-tuple class's second,
// and forgiving only the first left "TUPRC:" denied and the shape measuring
// exactly its unfixed 8000 while the scalar-tuple sibling went to 0. Enumerate
// the scans a class consults, not just the shared one.
function rctuple_payload_escapes_alias(stmts: ast.Stmt[], name: string, ttype: string, structs: irtables.StructTab, borrowable: string[], alias_ok: string[], elem_ok: string[], ret_dup_ok: boolean): boolean {
  for stmt in stmts {
    if (rctuple_esc_stmt_alias(stmt, name, ttype, structs, borrowable, alias_ok, elem_ok, ret_dup_ok)) {
      return true;
    }
  }
  return false;
}

// enum_field_alias_candidate: `e` may be a struct field read (`h.e`) — the AST
// cannot type it, so a qualified variant (`E.B`) and a tuple element are the
// only field accesses it rules out.
function enum_field_alias_candidate(e: ast.Expr, structs: irtables.StructTab): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      return !util.is_all_digits(fa.field) && variant_enum_owner(structs, fa.field) == "";
    },
    _ => {
      return false;
    }
  }
}

// --- fresh-string-return-call reclaim (#2649) ---------------------------------
//
// A `var r = f(..)` whose callee f ALWAYS returns a freshly-allocated string: r
// solely owns the box the callee moved out, so reclaiming r at scope exit (and per
// loop-rebind) closes the caller-side leak that survives the returned-builder
// move-on-return (whose freed intermediates live inside f; its final was moved to
// the caller and leaked here until now).

// body_has_nonfresh_str_return_reg: any return whose value is NOT a fresh string
// producer (str_local_binding_is_fresh — a concat, a string method, or a named
// producer). A bare `return ident` (an accumulator move-out) is conservatively
// NOT admitted: proving that ident is a sole-owned local needs the per-callee
// accumulator analysis, a follow-up. A `return param` / `return field` / `return
// "lit"` is likewise not fresh (may alias / is static).
// str_return_is_fresh: the RETURN-position freshness test, which is
// str_local_binding_is_fresh plus a bare string LITERAL.
//
// A literal belongs here for the reason #6582/#6590 established for a
// literal-INITIALISED local: `const_str` allocates a fresh box per evaluation
// (the DATA is .rodata, which __fern_str_free's heap-base guard skips; the box
// is not), so `return "even"` hands the caller a box it solely owns — exactly
// what str_fresh_ret_fns_of needs to prove.
//
// It is a SEPARATE predicate rather than a widening of
// str_local_binding_is_fresh for the reason #6590 records: that one has ~20
// callers driving the accumulator consume-rebind and concat-temp analyses, and
// folding the literal in there made `s = "reset"` read as a fresh rebind and
// credited an accumulator its own gate pins as un-reclaimable. Return position
// has no such consumer — a return value is never rebound.
// str_call_ret_is_fresh_reg: `f(..)` where `f` is already proven to return a
// freshly-allocated string on every path. `reg` is str_fresh_ret_fns_of's own
// accumulator, so this is the transitive step its fixpoint is for: a stdlib
// wrapper like `(s: string) to_upper() { return unicode.to_upper(s); }` returns
// nothing but a fresh string, and refusing it cost the consuming site its
// reclaim (43 B/round on `base.to_upper().len()`). Names are the MANGLED
// whole-program ones on both sides — the registry stores each func's name and the
// callee reaches here as a plain ident (`unicode__to_upper`), the same spelling
// the emitted `__fn_` symbol carries.
function str_call_ret_is_fresh_reg(e: ast.Expr, reg: string[]): boolean {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return util.index_of_str(reg, cid.name) >= 0;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// str_local_is_fresh_ret: `return out` where `out` is a LOCAL this body built
// out of nothing but fresh pieces. That is the shape every string builder in the
// stdlib ends with — `var out = ""` then `out = out + …` in a loop — and
// refusing it is what stopped the transitive chase at the leaf:
// `string.to_upper` -> `unicode.to_upper` -> `_map_upper`, which returns exactly
// this.
//
// Positive evidence only, and the local must be INVISIBLE outside its own
// construction: a declaration whose init is fresh, assignments whose values are
// fresh (`out + x` is a concat, so the self-reference is fine), and NO other
// appearance anywhere in the body. That last clause is what keeps the caller's
// release sound — a local also stored into a struct, passed to a call, or
// captured has another owner, and the returned pointer would be an alias rather
// than a handover. A parameter never qualifies: it has no declaration here.
function str_local_is_fresh_ret(stmts: ast.Stmt[], name: string, reg: string[], params: ast.ParamDecl[]): boolean {
  if (name.len() == 0) {
    return false;
  }
  if (!strloc_declared_fresh(stmts, name, reg, stmts, params)) {
    return false;
  }
  return !strloc_escapes(stmts, name, reg, stmts, params);
}

function strloc_declared_fresh(stmts: ast.Stmt[], name: string, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          return str_return_is_fresh_reg(v.init, reg, body, params);
        }
      },
      _ => {}
    }
  }
  return false;
}

// strloc_escapes: `name` appears somewhere other than its own declaration, an
// assignment TO it whose value is fresh, and a bare `return name`.
function strloc_escapes(stmts: ast.Stmt[], name: string, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name != name && expr_mentions_name(v.init, name)) {
          return true;
        }
      },
      ast.StmtAssign(a) => {
        // `target` is a NAME, so a compound target (`o.f`, `xs[i]`) spells
        // the base name here too — any of those touching `name` is an
        // escape, and only the plain self-assign is credited.
        if (a.target == name) {
          if (!str_return_is_fresh_reg(a.value, reg, body, params)) {
            return true;
          }
        } else if (expr_mentions_name(a.value, name)) {
          return true;
        }
      },
      ast.StmtReturn(r) => {
        var bare: boolean = false;
        match (r.value) {
          ast.ExprIdent(rid) => {
            bare = rid.name == name;
          },
          _ => {}
        }
        if (!bare && expr_mentions_name(r.value, name)) {
          return true;
        }
      },
      ast.StmtExpr(e) => {
        if (expr_mentions_name(e.value, name)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (expr_mentions_name(f.cond, name)) {
          return true;
        }
        if (strloc_escapes(f.then_body, name, reg, body, params) || strloc_escapes(f.else_body, name, reg, body, params)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (expr_mentions_name(w.cond, name)) {
          return true;
        }
        if (strloc_escapes(w.body, name, reg, body, params)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (expr_mentions_name(fo.iter, name)) {
          return true;
        }
        if (strloc_escapes(fo.body, name, reg, body, params)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        if (expr_mentions_name(m.scrutinee, name)) {
          return true;
        }
        for arm in m.arms {
          if (arm.has_guard && expr_mentions_name(arm.guard, name)) {
            return true;
          }
          if (strloc_escapes(arm.body, name, reg, body, params)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

// tostring_recv_is_scalar_param is the state-free twin of tostring_recv_is_scalar,
// for the whole-program fresh-ret registry: str_fresh_ret_fns_of walks FuncDecls
// with no LowerState, so a receiver is resolved against the callee's DECLARED
// params instead of its slots. Only a provably scalar receiver admits — a struct
// / enum / dyn `to_string` (user-written or @derive) may return an ALIAS of a
// live field, which is the same reason tostring_recv_is_scalar gates on it.
// A receiver that is not one of the callee's params answers false: its type is
// not in the signature, and an unregistered function merely leaks.
// trim_recv_is_string_param: the receiver of a `.trim()` is provably a STRING
// — a param annotated `string`, or a callee local declared `var s: string = …`
// with exactly one declaration. The return-side twin of trim_str_init's
// receiver-type test: a user method named `trim` on another type may return a
// field alias, so a return `x.trim()` is the fresh builtin copy (#7393) only
// when the receiver's string-ness is proven, not assumed from the name.
function trim_recv_is_string_param(e: ast.Expr, body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      var i: i32 = 0;
      while (i < params.len()) {
        if (params[i].name == id.name) {
          return params[i].type_name == "string";
        }
        i = i + 1;
      }
      if (irtables.local_decl_count(body, id.name) != 1) {
        return false;
      }
      return decl_string_local(body, id.name);
    },
    _ => {}
  }
  return false;
}

function tostring_recv_is_scalar_param(e: ast.Expr, body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  match (e) {
    ast.ExprNumber(_) => {
      return true;
    },
    ast.ExprIdent(id) => {
      var i: i32 = 0;
      while (i < params.len()) {
        if (params[i].name == id.name) {
          return irtables.is_scalar_type_name(params[i].type_name);
        }
        i = i + 1;
      }
      // Not a param: a callee LOCAL declared `var v: <scalar> = …` proves
      // the same thing the param's annotation does. Without this a helper
      // that computes before formatting — `var v: i32 = n * 2; return
      // v.to_string();` — never entered the registry, where the
      // param-receiver spelling of the same helper did, and every caller's
      // binding leaked its result at frees=0.
      return decl_scalar_local(body, id.name);
    },
    _ => {}
  }
  return false;
}

// decl_scalar_local: `name` is declared in `body` and EVERY declaration of it
// annotates a flat scalar type. Every one, because a nested block may shadow the
// name with a pointer-shaped local, and this scan has no scopes; requiring all of
// them keeps a shadow from licensing the outer name. An un-annotated `var`
// answers false — the type is what carries the proof here, and refusing costs a
// leak where guessing would cost an over-release.
// decl_string_local: the single `var <name>: string = …` declaration test the
// trim return arm pairs with local_decl_count == 1 — one declaration anywhere,
// annotated string. The count gate is what makes the flat verdict safe: with
// exactly one declaration there is no shadowed sibling to mis-attribute.
function decl_string_local(stmts: ast.Stmt[], name: string): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          return v.type_name == "string";
        }
      },
      ast.StmtIf(f) => {
        if (decl_string_local(f.then_body, name)) {
          return true;
        }
        if (decl_string_local(f.else_body, name)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (decl_string_local(w.body, name)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (decl_string_local(fo.body, name)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (decl_string_local(arm.body, name)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

function decl_scalar_local(stmts: ast.Stmt[], name: string): boolean {
  var found: boolean = false;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          if (!irtables.is_scalar_type_name(v.type_name)) {
            return false;
          }
          found = true;
        }
      },
      ast.StmtIf(f) => {
        if (decl_scalar_local_bad(f.then_body, name) || decl_scalar_local_bad(f.else_body, name)) {
          return false;
        }
        if (decl_scalar_local(f.then_body, name) || decl_scalar_local(f.else_body, name)) {
          found = true;
        }
      },
      ast.StmtWhile(w) => {
        if (decl_scalar_local_bad(w.body, name)) {
          return false;
        }
        if (decl_scalar_local(w.body, name)) {
          found = true;
        }
      },
      ast.StmtFor(fo) => {
        // A `for NAME in …` binder is not a `var` and carries no
        // annotation, so it cannot be proved scalar here.
        if (fo.var_name == name) {
          return false;
        }
        if (decl_scalar_local_bad(fo.body, name)) {
          return false;
        }
        if (decl_scalar_local(fo.body, name)) {
          found = true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (match_arm_binds_name(arm, name)) {
            return false;
          }
          if (decl_scalar_local_bad(arm.body, name)) {
            return false;
          }
          if (decl_scalar_local(arm.body, name)) {
            found = true;
          }
        }
      },
      _ => {}
    }
  }
  return found;
}

// decl_scalar_local_bad: `name` is declared somewhere in `stmts` with a
// NON-scalar annotation. The refusing half of the pair — decl_scalar_local
// answers "every declaration is scalar", which needs both a witness and the
// absence of a counter-example, and the two recursions cannot be folded into one
// boolean without losing which of the two it is reporting.
function decl_scalar_local_bad(stmts: ast.Stmt[], name: string): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name && !irtables.is_scalar_type_name(v.type_name)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (decl_scalar_local_bad(f.then_body, name) || decl_scalar_local_bad(f.else_body, name)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (decl_scalar_local_bad(w.body, name)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (fo.var_name == name) {
          return true;
        }
        if (decl_scalar_local_bad(fo.body, name)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (match_arm_binds_name(arm, name)) {
            return true;
          }
          if (decl_scalar_local_bad(arm.body, name)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

// match_arm_binds_name: the arm's pattern binds `name`. Such a binding has no
// annotation to read, so it can never be proved scalar and must refuse.
function match_arm_binds_name(arm: ast.MatchArm, name: string): boolean {
  match (arm.pattern) {
    ast.PatVariant(pv) => {
      return pv.binding == name;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function str_return_is_fresh_reg_in(e: ast.Expr, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  if (str_return_is_fresh_reg(e, reg, body, params)) {
    return true;
  }
  match (e) {
    ast.ExprIdent(id) => {
      return str_local_is_fresh_ret(body, id.name, reg, params);
    },
    ast.ExprCall(_) => {
      return cond_str_return_counted(e, reg, body, params);
    },
    _ => {}
  }
  return false;
}

// cond_str_return_counted: `e` is an if, match or block value each of whose
// leaves is a fresh string or a local of the function it does not bind, which
// its arm retains, so the caller receives a count of its own.
function cond_str_return_counted(e: ast.Expr, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  var vb: ast.Stmt[] = cond_value_body(e);
  var leaves: ast.Expr[] = cond_value_leaves(vb);
  if (leaves.len() == 0) {
    return false;
  }
  for lf in leaves {
    var local: boolean = cond_leaf_is_outer_local(lf, vb, body, []);
    if (!local && !str_return_is_fresh_reg_in(lf, reg, body, params)) {
      return false;
    }
  }
  return true;
}

function str_return_is_fresh_reg(e: ast.Expr, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  if (str_return_is_fresh(e, body, params)) {
    return true;
  }
  return str_call_ret_is_fresh_reg(e, reg);
}

function body_has_nonfresh_str_return_reg(stmts: ast.Stmt[], reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        if (!str_return_is_fresh_reg_in(r.value, reg, body, params)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (body_has_nonfresh_str_return_reg(f.then_body, reg, body, params) || body_has_nonfresh_str_return_reg(f.else_body, reg, body, params)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_nonfresh_str_return_reg(w.body, reg, body, params)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_nonfresh_str_return_reg(fo.body, reg, body, params)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (body_has_nonfresh_str_return_reg(m.arms[a].body, reg, body, params)) {
            return true;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

function body_has_nonfreshrecv_str_return_reg(stmts: ast.Stmt[], recv: string, reg: string[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        var ok: boolean = str_return_is_fresh_reg_in(r.value, reg, body, params);
        if (!ok) {
          match (r.value) {
            ast.ExprIdent(rid) => {
              ok = rid.name == recv;
            },
            ast.ExprCall(rcall) => {
              // `slice_unchecked(recv, a, b)` is a kind-102 view box
              // over the receiver's bytes, released the same way by the
              // consuming site. `recv[a:b]` cannot appear here: it is an
              // `Option[str]`, which no `string`-returning function can
              // return (#5634).
              match (rcall.callee) {
                ast.ExprIdent(rcid) => {
                  if (rcid.name == "slice_unchecked" && rcall.args.len() == 3) {
                    match (rcall.args[0]) {
                      ast.ExprIdent(raid) => {
                        ok = raid.name == recv;
                      },
                      _ => {}
                    }
                  }
                },
                _ => {}
              }
            },
            _ => {}
          }
        }
        if (!ok) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (body_has_nonfreshrecv_str_return_reg(f.then_body, recv, reg, body, params) || body_has_nonfreshrecv_str_return_reg(f.else_body, recv, reg, body, params)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_nonfreshrecv_str_return_reg(w.body, recv, reg, body, params)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_nonfreshrecv_str_return_reg(fo.body, recv, reg, body, params)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (body_has_nonfreshrecv_str_return_reg(m.arms[a].body, recv, reg, body, params)) {
            return true;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

function str_return_is_fresh(e: ast.Expr, body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  match (e) {
    ast.ExprString(_) => {
      return true;
    },
    ast.ExprIdent(id) => {
      // An `own` string param handed straight back: the caller moved its
      // reference in, and the release row's exit elision hands the same one back.
      if (own_str_param_moved_out(id.name, body, params)) {
        return true;
      }
      return str_local_binding_is_fresh(e);
    },
    ast.ExprCall(c) => {
      // `n.to_string()` on a provably SCALAR receiver is the builtin
      // decimal-text producer — always a fresh box. is_fresh_str_temp has
      // credited it since #4353 and its comment names this predicate as the
      // one that missed it; the miss is why a `f(i) { return i.to_string(); }`
      // helper never entered the fresh-ret registry and every caller's binding
      // leaked its result.
      if (c.args.len() == 0) {
        match (c.callee) {
          ast.ExprFieldAccess(fa) => {
            if (fa.field == "to_string" && tostring_recv_is_scalar_param(fa.obj, body, params)) {
              return true;
            }
            // `.trim()` on a proven-string receiver is the builtin
            // owned copy (#7393); a name-only admission would reach
            // user methods that alias (the str-trim-user-method pin).
            if (fa.field == "trim" && trim_recv_is_string_param(fa.obj, body, params)) {
              return true;
            }
          },
          _ => {}
        }
      }
      return str_local_binding_is_fresh(e);
    },
    _ => {
      return str_local_binding_is_fresh(e);
    }
  }
  return false;
}

// own_str_param_moved_out reports whether `name` is an `own` string param that
// own_string_param_release_rows_of would grant a row with no borrowable callee,
// so its bare return is the only reference leaving the frame.
function own_str_param_moved_out(name: string, body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  for pd in params {
    if (pd.name != name) {
      continue;
    }
    if (!pd.own || pd.type_name != "string") {
      return false;
    }
    if (irtables.local_decl_count(body, name) != 0 || util.index_of_str(irtables.body_assign_targets(body), name) >= 0) {
      return false;
    }
    var none: string[] = [];
    return !body_unsafe_for_alias_ret_ok(body, name, none, none, none, true);
  }
  return false;
}

// str_fresh_ret_fns_of: bare NAMES of FREE functions (no receiver) whose return is
// ALWAYS a freshly-allocated string — so `var r = f(..)` owns a fresh box, never an
// alias of a borrowed arg / field / literal. Only free functions: a method key
// would need the receiver type the string binding can't supply (is_fresh_ret_binding
// keys a method on recv_type, empty here).
// body_has_nonfreshrecv_str_return_reg: any return whose value is none of a fresh
// string producer, the bare RECEIVER ident, or a direct SLICE OF THE RECEIVER.
// It is body_has_nonfresh_str_return_reg widened by the two shapes a borrowing
// string method is built from: the identity path `if (n <= 0) { return s; }`
// and the view path `return s[n:sLen]`.
//
// A slice is not fresh — on the register backends it is a 24-byte rc-IMMORTAL
// box over the receiver's own bytes — so it earns no place in
// str_return_is_fresh. What makes it admissible HERE is that the consuming site
// releases such a result through __fern_str_view_free, which returns the view
// BOX to the freelist and never touches the shared data. The slice must be a
// direct return expression over the receiver ident: a slice of a callee LOCAL
// is a view of a buffer that local's own sweep frees, and a slice bound to a
// name first could have been stored somewhere else on the way out.

// The walk is a LEAST FIXPOINT over the bare-name half, for the same reason
// param_counted_of's is: a function whose returns are all calls cannot be judged
// until those callees are, and the stdlib stacks them three deep
// (`string.to_upper` -> `unicode.to_upper` -> `_ascii_fold` / `_map_upper`).
// Starting empty and only ever ADDING keeps it monotone, so it settles on the
// grounded fixpoint and an ungrounded mutual-recursion cycle stays OUT, which is
// the conservative direction: a missing name costs a leak, never an
// over-release. Rounds are bounded — the chains are shallow and the bound is a
// backstop, not the operating point.
pub function str_fresh_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
  var reg: string[] = [];
  var round: i32 = 0;
  while (round < 8) {
    var next: string[] = str_fresh_ret_fns_round(funcs, reg);
    if (next.len() == reg.len()) {
      return next;
    }
    reg = next;
    round = round + 1;
  }
  return reg;
}

function str_fresh_ret_fns_round(funcs: parser.FuncDecl[], reg: string[]): string[] {
  var out: string[] = [];
  for fn in funcs {
    if (fn.ret_type == "string" && fn.receiver_type.len() == 0
      && body_has_return(fn.body) && !body_has_nonfresh_str_return_reg(fn.body, reg, fn.body, fn.params)) {
      out = out.append(fn.name);
    }
    // "SFRRECV:<Recv>.<method>" — a string-shaped METHOD whose every return
    // is fresh, the RECEIVER itself, or a view of the receiver (#6544). That
    // is the shape a borrowing string method actually has:
    // `(s: string) drop(n): str` returns `""`, `s` unchanged, or the slice
    // `s[n:sLen]`.
    //
    // Freshness alone cannot admit these, and native's route is not open
    // either: it reclaims an identity return through an is_unique gate that
    // rests on a return-transfer inc the self-host emits for array params
    // only — and adding that inc UNPAIRED measures strictly worse (§9,
    // 2026-08-17). What this key buys instead is a runtime discriminator
    // that needs no inc at all: a fresh box is never the receiver's pointer
    // and an identity return always is, so the consuming site frees only
    // when the two differ.
    //
    // A bare `str` return spelling never reaches here: parse_type_name
    // erases it to "string" outside `-fmt`, so both spellings key the same.
    // Stored in the str_fresh_ret_fns list under a prefix (the "ARRF:"
    // convention — ':' can never appear in an identifier), so the bare-name
    // membership checks cannot match it and no registry field is added.
    if (fn.receiver_type.len() > 0 && fn.receiver_name.len() > 0
      && fn.ret_type == "string"
      && body_has_return(fn.body)
      && !body_has_nonfreshrecv_str_return_reg(fn.body, fn.receiver_name, reg, fn.body, fn.params)) {
      out = out.append("SFRRECV:" + util.base_type_name(fn.receiver_type) + "." + fn.name);
    }
  }
  return sfrfresh_names_of(funcs, reg, out);
}

// "SFRFRESHNAME:<method>" — the STRICT half of SFRRECV. SFRRECV admits a method
// that returns its RECEIVER or a view of it, which a consuming site sorts out
// with a pointer compare against the chain root — in binding position as well as
// receiver position (sfrrecv_str_init). This key is for the consumers that have
// no root to compare against, so they may only take ownership of a result that is
// nobody's box but its own. It says every return is a freshly allocated one:
// `(s: string) to_owned(): string { return s + ""; }` qualifies, and `trim` /
// `replace` — both able to hand the receiver straight back — do not.
//
// Keyed by METHOD NAME rather than `<Recv>.<method>` because the consumer is an
// AST scan with no types: a `var t: string = <expr>.m()` cannot say what `<expr>`
// is. A name is therefore admitted only when every STRING-RETURNING declaration
// of it is strictly fresh, so no receiver can reach a weaker one. A name that
// also spells a string BUILTIN is refused outright — `trim` and `replace` lower
// to ops these declarations never see, and a user type declaring a fresh `trim`
// must not license the builtin's view.
function sfrfresh_names_of(funcs: parser.FuncDecl[], reg: string[], acc: string[]): string[] {
  var cand: string[] = [];
  var bad: string[] = [];
  for fn in funcs {
    // A declaration that does not return `string` is not a hazard: the
    // binding this key serves is string-typed, so the checker cannot have
    // resolved it to one. `(c: char) to_upper(): char` sits beside
    // `(s: string) to_upper(): string` in the stdlib, and counting it would
    // cost the string method its credit for a call it can never receive.
    if (fn.receiver_type.len() > 0 && fn.receiver_name.len() > 0
      && fn.ret_type == "string") {
      if (body_has_return(fn.body)
        && !body_has_nonfresh_str_return_reg(fn.body, reg, fn.body, fn.params)
        && !is_str_builtin_method(fn.name)) {
        cand = push_str_unique(cand, fn.name);
      } else {
        bad = push_str_unique(bad, fn.name);
      }
    }
  }
  var out: string[] = acc;
  var c: i32 = 0;
  while (c < cand.len()) {
    if (util.index_of_str(bad, cand[c]) < 0) {
      out = out.append("SFRFRESHNAME:" + cand[c]);
    }
    c = c + 1;
  }
  return out;
}

// body_declares_name: `name` is declared as a LOCAL anywhere in the body. The
// read reclaim refuses a call whose callee NAME is a local (it holds an unknown
// closure body, not the registered producer), and this credit has to refuse the
// same shape — otherwise the sweep would free a string no read ever retained.
// Over astwalk's binder walk rather than a hand-rolled one (#7253): that is the
// single definition of "what does this statement bind", it splits the
// comma-joined destructure and `for (k, v)` forms, and it reads match patterns —
// including `at_binding` and `extra_bindings`. The copy this replaces saw a
// `var` and a `for` binder only, so a payload binder or a destructure was a
// declaration it reported as absent, and every caller here uses it to VETO a
// name-keyed registry hit. A veto that does not fire credits a local that is not
// the registered producer, and the sweep then frees what no read retained.
function body_declares_name(stmts: ast.Stmt[], name: string): boolean {
  var bound: string[] = astwalk.collect_bound_stmts(stmts, []);
  return util.index_of_str(bound, name) >= 0;
}

// name_is_param: `name` is one of this function's parameters. local_decl_count
// counts STATEMENT bindings only, so a parameter registers nowhere in the body
// scans — a nested `var b = Big { … }` shadowing a `b: Small` parameter passes
// the one-declaration guard, and the receiver resolvers below would answer with
// the shadow's type while the call site outside that scope still means the
// parameter. Refusing the name is the safe direction: no credit rather than one
// keyed to the wrong struct, whose sweep would drop a box of another layout.
function name_is_param(params: ast.ParamDecl[], name: string): boolean {
  for pd in params {
    if (pd.name == name) {
      return true;
    }
  }
  return false;
}

// cond_leaf_is_outer_local: `lf` names a local or parameter of the function
// that the conditional with body `vb` does not bind.
function cond_leaf_is_outer_local(lf: ast.Expr, vb: ast.Stmt[], body: ast.Stmt[], params: ast.ParamDecl[]): boolean {
  if let ast.ExprIdent(id) = lf {
    return !body_declares_name(vb, id.name) && (body_declares_name(body, id.name) || name_is_param(params, id.name));
  }
  return false;
}

// --- #4353: string-VALUE column deep-release for a reclaimable map ------------
// A reclaimable map (fresh, non-escaping, non-aliased, non-iterated) declared
// `Map[K, string]` whose EVERY value is a fresh string is credited "MAPVS:", so
// emit_map_buffers_free routes it to __fern_map_free_vs (register backends free
// the vals column via __fern_str_arr_free — a rc==1-gated per-element string free
// — instead of the shallow arr_dec; wasm already deep-releases). SOUNDNESS: the
// register __fern_map_set stores a STRING value pointer with no rc-inc (only an
// aliased ARRAY value takes one — map_insert_value_retains), so the map owns no
// counted ref to this column — freeing a value is safe ONLY when the map is its
// sole owner, i.e. the value was FRESH at the set site (nothing else references it).
// The freshness predicate (str_local_binding_is_fresh) is purely SYNTACTIC (an
// int `a+b` matches too), so the declared `Map[K, string]` type gate is required
// to confirm the column really holds strings before freeing them as such. Keys
// deep-release the same way via "MAPKS:" / __fern_map_free_ks; non-fresh-column
// or unannotated maps stay on the shallow free (sound). The map's separate
// arr_push grow-leak is closed for snapshot-kind columns by map_owncols (#5335
// layer 0: i32/string K/V route grows through __fern_arr_push_owned); only
// flag-1 alias columns (i64/f64/struct/generic) keep the LOAD-BEARING leak.

// --- string[] ELEMENT reclaim (#4355: string RC, string-array slice) ---------
//
// A fresh string[] local whose EVERY stored element is provably fresh (a concat /
// named producer / string method copy) or a static literal box owns each element
// box at rc==1 for its whole life: array stores are MOVES (op_arr_push copies no
// rc), the sanctioned self-append rebind `xs = xs.append(e)` transfers elements
// buffer-to-buffer (the push helper never frees; the assign's cow-guarded shallow
// dec releases only the superseded buffer), and the element-hazard walk below
// proves no element pointer ever outlives the frame. Such a local is credited
// "SARR:<name>" so the exit sweep frees it with __fern_str_arr_free — the
// element-walking sibling of the shallow __fern_rc_dec: at rc==1 it
// __fern_str_free's every element box (rc-aware: a shared element decs, a static
// literal's .rodata data is heap-guard-skipped, an immortal view is skipped) and
// then frees the buffer. Anything the analyses cannot prove stays on the shallow
// buffer-only dec (elements leak — sound, never an over-release).

// fn_field_value_is_fresh: `e` is a FRESH closure value for an fn-typed
// struct field — a lambda literal (pre-lift AST) or its lifted spelling, a
// `__mkclo$…` env-box constructor call (the reuse-site walkers run on the
// LIFTED module, where every fn-field lambda is already wrapped). Both build
// a sole-owned rc=1 env box at the construction site, so the reuse arm's
// shallow arr_dec of the OLD box can never free a live alias.
function fn_field_value_is_fresh(e: ast.Expr): boolean {
  match (e) {
    ast.ExprLambda(_) => {
      return true;
    },
    ast.ExprCall(cv) => {
      match (cv.callee) {
        ast.ExprIdent(cvid) => {
          if (cvid.name.len() > 8 && slice_unchecked(cvid.name, 0, 8) == "__mkclo$") {
            return true;
          }
        },
        _ => {}
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// closure_value_is_counted: `e` hands whatever stores it a counted closure
// box — a fresh one (fn_field_value_is_fresh), or the result of a call to a
// closure-returning function (`closureset`, closure_ret_fns_of), whose return
// retains any box it does not own (ret_closure_uncounted).
function closure_value_is_counted(e: ast.Expr, closureset: string[]): boolean {
  if (fn_field_value_is_fresh(e)) {
    return true;
  }
  if let ast.ExprCall(c) = e {
    var cn: string = ident_name_or_empty(c.callee);
    return cn.len() > 0 && util.index_of_str(closureset, cn) >= 0;
  }
  return false;
}

// strarr_lit_all_elems_fresh_reg: the same proof against a fresh-string registry,
// so an element may be a call to a str_fresh_ret_fns_of producer and not only a
// syntactic literal or concat.
function strarr_lit_all_elems_fresh_reg(e: ast.Expr, str_fresh: string[]): boolean {
  match (e) {
    ast.ExprArray(al) => {
      var i: i32 = 0;
      while (i < al.elements.len()) {
        if (!strarr_value_is_fresh(al.elements[i], str_fresh)) {
          return false;
        }
        i = i + 1;
      }
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// boxarr_lit_all_elems_fresh: `e` is an ARRAY LITERAL for a struct[] / enum[]
// field whose every element is FRESH — a no-base struct literal of the element
// type, resp. a variant ctor of the element enum (an empty `[]` qualifies).
// The value-freshness proof the reuse admission uses for box-element-array
// fields: such a literal builds a sole-owned buffer of sole-owned rc=1
// element boxes, so the reuse-arm __fern_arrarr_free (element boxes + buffer,
// each rc-guarded) can never free a live alias.
function boxarr_lit_all_elems_fresh(e: ast.Expr, structs: irtables.StructTab, elem_ty: string, is_enum: boolean): boolean {
  match (e) {
    ast.ExprArray(al) => {
      var i: i32 = 0;
      while (i < al.elements.len()) {
        if (is_enum) {
          if (variant_ctor_enum_owner(al.elements[i], structs) != elem_ty) {
            return false;
          }
        } else {
          var el_ok: boolean = false;
          match (al.elements[i]) {
            ast.ExprStructLit(esl) => {
              if (!esl.has_base && esl.type_name == elem_ty) {
                el_ok = true;
              }
            },
            _ => {}
          }
          if (!el_ok) {
            return false;
          }
        }
        i = i + 1;
      }
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// strarr_elem_read: `e` is a DIRECT element read `name[i]` of the candidate array.
function strarr_elem_read(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprIndex(ix) => {
      match (ix.array) {
        ast.ExprIdent(id) => {
          return id.name == name;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// strarr_expr_unsafe: the element-hazard sibling of expr_unsafe_for. TRUE when
// `e` uses `name` (the candidate string[] local) or an ELEMENT of it in a way
// that could let a pointer outlive the frame's exit sweep — in which case the
// element walk would free a box someone still holds. expr_unsafe_for alone is
// NOT enough here: it deliberately treats `name[i]` as a borrow (safe for the
// buffer-only dec), but for ELEMENT reclaim a `var t = xs[i]` binding, a
// `return xs[i]`, or an `ys.append(xs[i])` store is a lasting element alias.
// SAFE element-read positions (the element is read transiently, before the
// sweep): a binary operand (`xs[i] + y` copies bytes, `xs[i] == y` compares),
// a read-only / fresh-copy method receiver (`xs[i].len()` / `.to_upper()` /
// `.to_lower()` / `.reverse()` / `.repeat(n)` / `.starts_with(p)` /
// `.ends_with(p)` / `.contains(p)` / `.index_of(p)`), a byte read `xs[i][j]`,
// a match scrutinee (string match compares), and a DIRECT arg to a free
// function whose param is borrowable. Everything else — bare binding, return,
// container/struct/tuple store, method arg, non-borrowable call arg, a slice
// or `.trim()` VIEW of an element (shares the element's buffer), an unknown
// method — is a hazard. The array ITSELF follows expr_unsafe_for's rules,
// tightened: a method receiver `name.m()` is only `.len()`-safe (`.append` is
// sanctioned only as the `name = name.append(e)` rebind, handled at the
// StmtAssign arm; `.with()` / slices alias the buffer AND its elements).
// strarr_borrowing_method: a string[] builtin that only READS its receiver — it
// keeps no reference to the array or to any element, so calling it on a
// reclaimable local is not an escape. `len` reads the length word; `join`
// (__fern_arr_str_join) walks the elements building a fresh accumulator with
// `+`, storing nothing. The array-method sibling of str_borrowing_method.
//
// Everything else stays an escape by default, which is the right way round: a
// method that returns an element, a slice, or the array itself hands out a
// lasting alias, and the reclaim would free it out from under the caller.
function strarr_borrowing_method(field: string): boolean {
  return field == "len" || field == "join";
}

function strarr_expr_unsafe(e: ast.Expr, name: string, borrowable: string[]): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    ast.ExprNumber(_) => {
      return false;
    },
    ast.ExprString(_) => {
      return false;
    },
    ast.ExprBool(_) => {
      return false;
    },
    ast.ExprBinary(b) => {
      var lu: boolean = false;
      if (!strarr_elem_read(b.left, name)) {
        lu = strarr_expr_unsafe(b.left, name, borrowable);
      }
      if (lu) {
        return true;
      }
      if (!strarr_elem_read(b.right, name)) {
        return strarr_expr_unsafe(b.right, name, borrowable);
      }
      return false;
    },
    ast.ExprUnary(u) => {
      return strarr_expr_unsafe(u.operand, name, borrowable);
    },
    ast.ExprIndex(ix) => {
      // `name[i]` reaching here is a general VALUE position (binding /
      // container element / index-store value / ...): a lasting alias.
      if (strarr_elem_read(e, name)) {
        return true;
      }
      // `xs[i][j]` byte read: the inner element read is transient.
      var base_u: boolean = false;
      if (!strarr_elem_read(ix.array, name)) {
        match (ix.array) {
          ast.ExprIdent(_) => {
            base_u = false;
          },
          _ => {
            base_u = strarr_expr_unsafe(ix.array, name, borrowable);
          }
        }
      }
      if (base_u) {
        return true;
      }
      return strarr_expr_unsafe(ix.index, name, borrowable);
    },
    ast.ExprSlice(sl) => {
      // a slice of an ELEMENT is a zero-copy view of its buffer; a slice of
      // the ARRAY aliases buffer + elements. Both are hazards.
      if (strarr_elem_read(sl.array, name)) {
        return true;
      }
      if (strarr_expr_unsafe(sl.array, name, borrowable)) {
        return true;
      }
      if (strarr_expr_unsafe(sl.start, name, borrowable)) {
        return true;
      }
      return strarr_expr_unsafe(sl.end, name, borrowable);
    },
    ast.ExprCall(c) => {
      var callee_name: string = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          callee_name = cid.name;
          if (cid.name == name) {
            return true;
          }
        },
        ast.ExprFieldAccess(fa) => {
          if (strarr_elem_read(fa.obj, name)) {
            if (!str_borrowing_method(fa.field)) {
              return true;
            }
          } else {
            match (fa.obj) {
              ast.ExprIdent(rid) => {
                if (rid.name == name && !strarr_borrowing_method(fa.field)) {
                  return true;
                }
              },
              _ => {
                if (strarr_expr_unsafe(fa.obj, name, borrowable)) {
                  return true;
                }
              }
            }
          }
        },
        _ => {
          if (strarr_expr_unsafe(c.callee, name, borrowable)) {
            return true;
          }
        }
      }
      var ai: i32 = 0;
      while (ai < c.args.len()) {
        var arg_ok: boolean = false;
        match (c.args[ai]) {
          ast.ExprIdent(aid) => {
            // The "CNT:" tier admits the whole array at a position the
            // callee only STORES counted. The deep walk survives it:
            // the store retains the BUFFER, so __fern_str_arr_free's rc
            // gate leaves the elements to whichever owner reaches rc 1
            // — and the tier's own rule refuses an element read, so the
            // callee can hand no element out uncounted.
            if (aid.name == name && callee_name.len() > 0
              && (param_is_borrowable(borrowable, callee_name, ai)
              || param_is_borrowable(borrowable, "CNT:" + callee_name, ai))) {
              arg_ok = true;
            }
          },
          _ => {
            // a DIRECT `name[i]` arg to a free fn at a borrowable param
            // is a transient read (the callee provably retains nothing).
            if (strarr_elem_read(c.args[ai], name) && callee_name.len() > 0
              && param_is_borrowable(borrowable, callee_name, ai)) {
              arg_ok = true;
            }
          }
        }
        if (!arg_ok && strarr_expr_unsafe(c.args[ai], name, borrowable)) {
          return true;
        }
        ai = ai + 1;
      }
      return false;
    },
    ast.ExprFieldAccess(fa) => {
      if (strarr_elem_read(fa.obj, name)) {
        return true;
      }
      match (fa.obj) {
        ast.ExprIdent(_) => {
          return false;
        },
        _ => {
          return strarr_expr_unsafe(fa.obj, name, borrowable);
        }
      }
    },
    ast.ExprArray(a) => {
      var i: i32 = 0;
      while (i < a.elements.len()) {
        if (strarr_expr_unsafe(a.elements[i], name, borrowable)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        if (strarr_expr_unsafe(el, name, borrowable)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprStructLit(slz) => {
      if (slz.has_base && strarr_expr_unsafe(slz.base, name, borrowable)) {
        return true;
      }
      var i: i32 = 0;
      while (i < slz.field_values.len()) {
        if (strarr_expr_unsafe(slz.field_values[i], name, borrowable)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.ExprLambda(lm) => {
      // A VALUE BLOCK is not a closure — see expr_unsafe_for's arm. Same
      // bug, same shape, one kind over: `xs[0].len()` read through a match
      // expression left a string[] local uncredited, so its elements and
      // buffer stranded where the identical plain read is flat.
      //
      // The empty str_fresh is a deliberate conservative bound: it only
      // disables the self-`append` / self-`.with` rebind forgiveness inside
      // the block, which can refuse a credit but never grant one.
      if (parser.is_value_block_origin(lm.origin)) {
        var no_str_fresh: string[] = [];
        var no_producers: string[] = [];
        return strarr_unsafe_for(lm.body, name, borrowable, no_str_fresh, no_producers);
      }
      var used: string[] = [];
      var i: i32 = 0;
      while (i < lm.body.len()) {
        used = astwalk.collect_idents_stmt(lm.body[i], used);
        i = i + 1;
      }
      return util.index_of_str(used, name) >= 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// strarr_handback_call: `f(.., name, ..)` hands the local to a counted handback,
// which gives it back uncounted or leaves it with this frame, and no other
// argument reads it but as a borrow. Returned, settle_returned_handbacks keeps
// it when given back; rebound, the store's cow guard does.
function strarr_handback_call(e: ast.Expr, name: string, borrowable: string[], rows: string[]): boolean {
  var k: i32 = handback_pos(e, name, rows, "SARRH:");
  if (k < 0) {
    return false;
  }
  if let ast.ExprCall(c) = e {
    var i: i32 = 0;
    while (i < c.args.len()) {
      if (i != k && strarr_expr_unsafe(c.args[i], name, borrowable)) {
        return false;
      }
      i = i + 1;
    }
  }
  return true;
}

// strarr_rebind_is_fresh: `name = <e>` rebuilds the local from a value it can
// solely own, so the store may release what the slot held. It is the SAME
// freshness proof collect_fresh_strarr_in_stmt applies to the declaration — an
// array literal whose every element is element-fresh (`[]` included), or a call
// to a visible whole-program string[] producer — asked at the rebind instead.
//
// The release itself already exists: emit_strarr_reclaim_store frees the old
// buffer and its element boxes before the store, under a cow guard, which is
// why the self-`append` and self-`.with` rebinds beside this one are safe. This
// form differs only in that the new value shares nothing with the old, so the
// guard never fires and the old value is always freed.
//
// `name` must not appear in the value: an element read would be a lasting alias
// into the buffer the store is about to free.
function strarr_rebind_is_fresh(e: ast.Expr, name: string, borrowable: string[], str_fresh: string[], strarr_producers: string[]): boolean {
  if (strarr_expr_unsafe(e, name, borrowable)) {
    return false;
  }
  match (e) {
    ast.ExprArray(al) => {
      var i: i32 = 0;
      while (i < al.elements.len()) {
        if (!strarr_value_is_fresh(al.elements[i], str_fresh)) {
          return false;
        }
        i = i + 1;
      }
      return true;
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return util.index_of_str(strarr_producers, cid.name) >= 0;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// strarr_unsafe_for / stmt_strarr_unsafe_for: the whole-body gate for string[]
// ELEMENT reclaim. Like body_unsafe_for plus the element hazards, with exactly
// one sanctioned reassignment form — the self-append rebind
// `name = name.append(e)` where `e` is itself a fresh/static element store
// (strarr_value_is_fresh, the same question the credit's declaration arm asks)
// that doesn't otherwise leak `name`. `for x in name` binds an element per
// iteration (a lasting alias the walker can't see through) — conservatively
// unsafe.
function strarr_unsafe_for(stmts: ast.Stmt[], name: string, borrowable: string[], str_fresh: string[], strarr_producers: string[]): boolean {
  var no_alias: string[] = [];
  var no_sfld: string[] = [];
  return strarr_unsafe_for_alias(stmts, name, borrowable, str_fresh, strarr_producers, no_alias, no_sfld);
}

// strarr_unsafe_for_alias is strarr_unsafe_for carrying the #7282 alias
// forgiveness: a plain `var v: string[] = name` bind whose own site key is in
// `alias_ok` does not flag `name` — the bind retains the shared buffer and the
// alias site is granted the same "SARR:" credit, so both slots release and
// __fern_str_arr_free arbitrates (elements walk only at the last owner's
// rc==1). The parameter rather than a second walker, as body_unsafe_for_tup_alias.
function strarr_unsafe_for_alias(stmts: ast.Stmt[], name: string, borrowable: string[], str_fresh: string[], strarr_producers: string[], alias_ok: string[], sfld_ok: string[]): boolean {
  for stmt in stmts {
    if (stmt_strarr_unsafe_for(stmt, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok)) {
      return true;
    }
  }
  return false;
}

function stmt_strarr_unsafe_for(st: ast.Stmt, name: string, borrowable: string[], str_fresh: string[], strarr_producers: string[], alias_ok: string[], sfld_ok: string[]): boolean {
  match (st) {
    ast.StmtVar(v) => {
      match (v.init) {
        ast.ExprIdent(aid) => {
          if (aid.name == name
            && util.index_of_str(alias_ok, irtables.reclaim_site_key_of(v.name, v.line, v.col)) >= 0) {
            return false;
          }
        },
        ast.ExprStructLit(_) => {
          // The struct-literal FIELD share. `var p: T = T { .., f: name, .. }`
          // over a `string[]` field retains the buffer, and T's field drop
          // releases it through the same rc-gated __fern_str_arr_free the
          // alias bind above relies on — so `name` keeps its own DEEP credit
          // and the walk still runs exactly once, at whichever owner finds
          // rc 1. Without it the element walk lives ONLY in the holder's
          // field drop, which is correct until a path skips the construction
          // and nothing walks at all.
          if (util.index_of_str(sfld_ok, irtables.reclaim_site_key_of(v.name, v.line, v.col)) >= 0) {
            return false;
          }
        },
        _ => {}
      }
      return strarr_expr_unsafe(v.init, name, borrowable);
    },
    ast.StmtReturn(r) => {
      // A bare `return name` moves the array out: the return excludes the slot
      // from the exit sweep (returned_moved_arr_slots).
      return ident_name_or_empty(r.value) != name && strarr_expr_unsafe(r.value, name, borrowable)
        && !strarr_handback_call(r.value, name, borrowable, strarr_producers);
    },
    ast.StmtExpr(e) => {
      return strarr_expr_unsafe(e.value, name, borrowable);
    },
    ast.StmtAssign(a) => {
      if (a.target == name) {
        match (a.value) {
          ast.ExprCall(c) => {
            var is_self_append: boolean = false;
            match (c.callee) {
              ast.ExprFieldAccess(fa) => {
                if (fa.field == "append") {
                  match (fa.obj) {
                    ast.ExprIdent(rid) => {
                      is_self_append = rid.name == name;
                    },
                    _ => {}
                  }
                }
              },
              _ => {}
            }
            if (is_self_append && c.args.len() == 1
              && strarr_value_is_fresh(c.args[0], str_fresh)
              && !strarr_expr_unsafe(c.args[0], name, borrowable)) {
              return false;
            }
            // The self-`.with` rebind `name = name.with(i, v)`
            // (#6407). lower_strarr_with_store makes it a
            // reference-correct element store — the superseded box
            // is released and `v` is retained — so an ELEMENT of
            // `name` is admissible as the value here even though it
            // is a lasting alias everywhere else.
            var is_self_with: boolean = false;
            match (c.callee) {
              ast.ExprFieldAccess(wfa) => {
                if (wfa.field == "with") {
                  match (wfa.obj) {
                    ast.ExprIdent(wid) => {
                      is_self_with = wid.name == name;
                    },
                    _ => {}
                  }
                }
              },
              _ => {}
            }
            if (is_self_with && c.args.len() == 2
              && !strarr_expr_unsafe(c.args[0], name, borrowable)
              && (strarr_elem_read(c.args[1], name)
              || !strarr_expr_unsafe(c.args[1], name, borrowable))) {
              return false;
            }
          },
          _ => {}
        }
        // The REBUILD rebind: a value the local can solely own, sharing
        // nothing with what the slot holds. Unlike the two self-rebinds
        // above it is not a call shape, so it is tested after the match.
        if (strarr_rebind_is_fresh(a.value, name, borrowable, str_fresh, strarr_producers)) {
          return false;
        }
        if (thread_rebind(a.value, name, borrowable, strarr_producers, true)) {
          return false;
        }
        if (strarr_handback_call(a.value, name, borrowable, strarr_producers)) {
          return false;
        }
        return true;  // any other reassignment of the candidate
      }
      // The assign form of the struct-literal field share above: the
      // holder's rebind releases the superseded box's field.
      if (util.index_of_str(sfld_ok, sfld_assign_site(a)) >= 0) {
        return false;
      }
      return strarr_expr_unsafe(a.value, name, borrowable);
    },
    ast.StmtIf(f) => {
      if (strarr_expr_unsafe(f.cond, name, borrowable)) {
        return true;
      }
      return strarr_unsafe_for_alias(f.then_body, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok) || strarr_unsafe_for_alias(f.else_body, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok);
    },
    ast.StmtWhile(w) => {
      if (strarr_expr_unsafe(w.cond, name, borrowable)) {
        return true;
      }
      return strarr_unsafe_for_alias(w.body, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok);
    },
    ast.StmtFor(fo) => {
      var iter_unsafe: boolean = true;
      match (fo.iter) {
        ast.ExprIdent(fid) => {
          // `for s in name` binds an ELEMENT per iteration, which is
          // a LASTING alias only if the binder is one. A body that
          // does nothing but read it — `s.len()`, a comparison, a
          // borrowable call argument — leaves nothing behind for the
          // deep free to dangle, which is the same transient line
          // strarr_expr_unsafe already draws for `name[i]` in those
          // positions. body_unsafe_for asks it of the binder: a bind,
          // a return, a container or struct store, or a retaining
          // call argument all make the loop unsafe again.
          //
          // A binder that SHADOWS `name` is refused outright: the
          // walk below would then be reading a different value under
          // the same spelling.
          if (fid.name == name) {
            iter_unsafe = fo.var_name == name || body_unsafe_for(fo.body, fo.var_name, borrowable, []);
          } else {
            iter_unsafe = false;
          }
        },
        _ => {
          iter_unsafe = strarr_expr_unsafe(fo.iter, name, borrowable);
        }
      }
      if (iter_unsafe) {
        return true;
      }
      return strarr_unsafe_for_alias(fo.body, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok);
    },
    ast.StmtMatch(m) => {
      // a string scrutinee only compares (transient); an element read there is safe.
      if (!strarr_elem_read(m.scrutinee, name) && strarr_expr_unsafe(m.scrutinee, name, borrowable)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && strarr_expr_unsafe(arm.guard, name, borrowable)) {
          return true;
        }
        if (strarr_unsafe_for_alias(arm.body, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok)) {
          return true;
        }
      }
      return false;
    },
    ast.StmtDefer(d) => {
      return stmt_strarr_unsafe_for(d.action, name, borrowable, str_fresh, strarr_producers, alias_ok, sfld_ok);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// --- dyn Trait[] ELEMENT reclaim (#4351 slice 3) ------------------------------
//
// A fresh `var xs: dyn T[] = [<literals>]` local owns every element box at
// rc==1 for its whole life: a prim/string literal element is an rc-headered
// op_dyn_box cell (slice 2), a scalar-only leak-safe struct literal element is
// its rc-headered struct box, and array stores are moves (no rc traffic). If
// no element pointer ever outlives the frame, the exit sweep can release each
// element (per-index, kinds recorded at the credit) before the buffer dec —
// the self-host analog of native's __drop_arr_dyn_<set> walk. Kinds: 'p' = a
// plain cell/box dec (prim cell or scalar-only struct box); 's' = a string
// cell (free the sole-owned inner string box at cell@8 first, then dec the
// cell). Any element that doesn't classify uncredits the whole array (sound
// leak, exactly today's behaviour).

// moves_fields_expr: does `name` appear in `e` as a method RECEIVER —
// `name.m(...)` — anywhere in the expression tree? That is the ONE position
// where a use can carry `name`'s rc FIELD values into a surviving value with
// no counted reference: the method body can return a struct built from
// `self`'s fields (`ops: self.ops.append(op)`, the builder shape), and when
// the `.append` is in place it hands the receiver's rc==1 buffer straight to
// its result. The escape analysis that credits a reclaimable struct treats a
// method receiver as a BORROW (so the builder chain stays reclaimable), which
// is exactly why the sweep would otherwise deep-drop a receiver whose field
// has escaped — the #3425 residual.
//
// Deliberately NOT flagged (they are borrows / balanced for any CREDITED
// struct, so flagging them only strands the field — the string-only-struct
// reclaim leak):
//   - a bare call ARGUMENT `f(name)` — a credited struct only ever reaches a
//     BORROWABLE param (a non-borrowable/own arg escapes, so body_unsafe_for
//     would not credit it), and a borrowable param is read-only;
//   - a struct-update BASE `T { ...name, .. }` when `spread_counted` says every
//     field of name's type copies COUNTED (a scalar, or a string / enum /
//     nested-struct field the base copy retains — spread_copy_counted), so the
//     deep drop is balanced (dec, not free). A type with an array, tuple, map,
//     option or closure field copies that field uncounted, and such a base IS
//     flagged: the caller passes false when it cannot vouch for the type;
//   - a closure CAPTURE that merely READS `name`'s fields — a borrow;
//   - a field / index READ (`name.f`, `name[i]`).
// So a read-only / borrow-only local keeps its deep drop and its string field
// reclaims. The recursion is exhaustive over every Expr variant (leaves return
// false), so a receiver buried in a nested sub-expression / lambda body is
// still found.
// `nomove` lists the call names in `name.<f>(...)` position that provably move
// nothing, so the receiver hazard does not apply to them. Two sources feed it,
// both computed at the call site from `name`'s struct type:
//
//   - the fn-typed FIELD names (clo_field_names_of): `name.f(args)` where f is
//     such a field is a FIELD-CLOSURE CALL, not a user method — the closure sees
//     only its args + captures (built before `name` existed), so it cannot move
//     `name`'s fields into its result;
//   - the METHOD names whose receiver is a proven pure borrow.
//
// Pass [] when the receiver's type is unknown (every method receiver marks).
function moves_fields_expr(e: ast.Expr, name: string, nomove: string[], spread_counted: boolean): boolean {
  match (e) {
    ast.ExprBinary(b) => {
      return moves_fields_expr(b.left, name, nomove, spread_counted) || moves_fields_expr(b.right, name, nomove, spread_counted);
    },
    ast.ExprUnary(u) => {
      return moves_fields_expr(u.operand, name, nomove, spread_counted);
    },
    ast.ExprIndex(ix) => {
      return moves_fields_expr(ix.array, name, nomove, spread_counted) || moves_fields_expr(ix.index, name, nomove, spread_counted);
    },
    ast.ExprSlice(sl) => {
      return moves_fields_expr(sl.array, name, nomove, spread_counted) || moves_fields_expr(sl.start, name, nomove, spread_counted) || moves_fields_expr(sl.end, name, nomove, spread_counted);
    },
    ast.ExprFieldAccess(fa) => {
      return moves_fields_expr(fa.obj, name, nomove, spread_counted);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          match (fa.obj) {
            ast.ExprIdent(rid) => {
              // method receiver — the hazard (except a field-closure call)
              if (rid.name == name && util.index_of_str(nomove, fa.field) < 0) {
                return true;
              }
            },
            _ => {
              if (moves_fields_expr(fa.obj, name, nomove, spread_counted)) {
                return true;
              }
            }
          }
        },
        _ => {
          if (moves_fields_expr(c.callee, name, nomove, spread_counted)) {
            return true;
          }
        }
      }
      for arg in c.args {
        if (moves_fields_expr(arg, name, nomove, spread_counted)) {  // a receiver nested inside an arg
          return true;
        }
      }
      return false;
    },
    ast.ExprArray(a) => {
      var i: i32 = 0;
      while (i < a.elements.len()) {
        if (moves_fields_expr(a.elements[i], name, nomove, spread_counted)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        if (moves_fields_expr(el, name, nomove, spread_counted)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprStructLit(sl) => {
      // A BARE-IDENT base copies name's fields into the new box, and an
      // array / tuple / map / option / closure field goes with no inc
      // (op_struct_copy, and the per-field path's array copy), so the
      // new value and name alias the same buffers. Deep-dropping name
      // would free them out from under it — the NODEEP hazard, in the
      // same class as a method receiver. `spread_counted` is the
      // caller's word that every field of name's type copies counted,
      // which makes the base a borrow. The SELF-update
      // `name = T { ...name, … }` is exempted by moves_fields_stmt: there
      // the two boxes are the same slot's before and after, so ownership
      // moves forward rather than being shared.
      if (sl.has_base) {
        match (sl.base) {
          ast.ExprIdent(bid) => {
            if (bid.name == name && !spread_counted) {
              return true;
            }
          },
          _ => {
            if (moves_fields_expr(sl.base, name, nomove, spread_counted)) {
              return true;
            }
          }
        }
      }
      for fv in sl.field_values {
        if (moves_fields_expr(fv, name, nomove, spread_counted)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprLambda(lm) => {  // a receiver used inside the closure body
      return moves_fields_stmts(lm.body, name, nomove, spread_counted);
    },
    _ => {  // ExprIdent / ExprNumber / ExprString / ExprBool / ExprUnknown — leaves, no move
      return false;
    }
  }
  return false;
}

function moves_fields_stmts(stmts: ast.Stmt[], name: string, nomove: string[], spread_counted: boolean): boolean {
  for stmt in stmts {
    if (moves_fields_stmt(stmt, name, nomove, spread_counted)) {
      return true;
    }
  }
  return false;
}

function moves_fields_stmt(st: ast.Stmt, name: string, nomove: string[], spread_counted: boolean): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return moves_fields_expr(v.init, name, nomove, spread_counted);
    },
    ast.StmtReturn(r) => {
      return moves_fields_expr(r.value, name, nomove, spread_counted);
    },
    ast.StmtExpr(e) => {
      return moves_fields_expr(e.value, name, nomove, spread_counted);
    },
    ast.StmtAssign(a) => {
      // SELF-rebind exemption: `name = name.emit(op)` / `name = f(name)`
      // (the #3456 builder chain) keeps its per-rebind reclaim — the cow
      // guard is sound for a self-derived result: a field carried into
      // the new value compares EQUAL (skip), a field it dropped is the
      // dead old box's sole reference (free OK). Only the TOP-LEVEL
      // receiver/arg position is exempt; `name` moved anywhere deeper in
      // the RHS still marks.
      if (a.target == name) {
        match (a.value) {
          ast.ExprCall(sc) => {
            var deep_move: boolean = false;
            match (sc.callee) {
              ast.ExprFieldAccess(sfa) => {
                match (sfa.obj) {
                  ast.ExprIdent(_) => {},
                  _ => {
                    if (moves_fields_expr(sfa.obj, name, nomove, spread_counted)) {
                      deep_move = true;
                    }
                  }
                }
              },
              _ => {
                if (moves_fields_expr(sc.callee, name, nomove, spread_counted)) {
                  deep_move = true;
                }
              }
            }
            var sai: i32 = 0;
            while (sai < sc.args.len()) {
              match (sc.args[sai]) {
                ast.ExprIdent(_) => {},
                _ => {
                  if (moves_fields_expr(sc.args[sai], name, nomove, spread_counted)) {
                    deep_move = true;
                  }
                }
              }
              sai = sai + 1;
            }
            return deep_move;
          },
          ast.ExprStructLit(ssl) => {
            // `name = T { ...name, … }` — the same exemption for the
            // functional-update form. The copied fields land in the box
            // this very slot is about to hold, so ownership moves
            // forward instead of being shared with a second live value,
            // and the superseded box's deep drop stays sound. Only the
            // TOP-LEVEL base is exempt; `name` anywhere in an override
            // value still marks.
            var base_self: boolean = false;
            if (ssl.has_base) {
              match (ssl.base) {
                ast.ExprIdent(sbid) => {
                  base_self = sbid.name == name;
                },
                _ => {}
              }
            }
            if (!base_self) {
              return moves_fields_expr(a.value, name, nomove, spread_counted);
            }
            var sfi: i32 = 0;
            while (sfi < ssl.field_values.len()) {
              if (moves_fields_expr(ssl.field_values[sfi], name, nomove, spread_counted)) {
                return true;
              }
              sfi = sfi + 1;
            }
            return false;
          },
          _ => {
            return moves_fields_expr(a.value, name, nomove, spread_counted);
          }
        }
      }
      return moves_fields_expr(a.value, name, nomove, spread_counted);
    },
    ast.StmtIf(f) => {
      if (moves_fields_expr(f.cond, name, nomove, spread_counted)) {
        return true;
      }
      return moves_fields_stmts(f.then_body, name, nomove, spread_counted) || moves_fields_stmts(f.else_body, name, nomove, spread_counted);
    },
    ast.StmtWhile(w) => {
      if (moves_fields_expr(w.cond, name, nomove, spread_counted)) {
        return true;
      }
      return moves_fields_stmts(w.body, name, nomove, spread_counted);
    },
    ast.StmtFor(fo) => {
      if (moves_fields_expr(fo.iter, name, nomove, spread_counted)) {
        return true;
      }
      return moves_fields_stmts(fo.body, name, nomove, spread_counted);
    },
    ast.StmtMatch(m) => {
      if (moves_fields_expr(m.scrutinee, name, nomove, spread_counted)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && moves_fields_expr(arm.guard, name, nomove, spread_counted)) {
          return true;
        }
        if (moves_fields_stmts(arm.body, name, nomove, spread_counted)) {
          return true;
        }
      }
      return false;
    },
    ast.StmtDefer(d) => {
      return moves_fields_stmt(d.action, name, nomove, spread_counted);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// --- fresh-struct-return classification + snapshot-LOCAL reclaim (#3457) ------
//
// The dominant self-host builder is a LOCAL that is threaded and MOVED OUT:
//   var st: LowerState = se.emit(op);   // bound from a fresh-RET method
//   st = st.emit(op2);                  // threaded via own methods (safe)
//   return st;                          // moved out
// `reclaimable_names_of` excludes it (`return st` is an escape under
// body_unsafe_for), so its intermediate rebind clones leak. The snapshot-LOCAL
// path reclaims each REBIND via emit_field_reclaim_store and KEEPS the final via
// struct move-on-return. The rebind release is guarded by a snapshot of the box
// the binding DERIVED from (`se` here): a fresh box copies the borrowed
// receiver's fields uncounted, so without it the first rebind released a field
// buffer the caller still owned. The same snapshot admits the alias `var sc = s`
// and the call-derived `var sl = lower_expr(x, s)`, whose box may BE the
// source's; those two earn no struct credit and reclaim by their rebinds only.

// body_has_return: does any return appear, nested control flow included?
function body_has_return(stmts: ast.Stmt[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(_) => {
        return true;
      },
      ast.StmtIf(f) => {
        if (body_has_return(f.then_body) || body_has_return(f.else_body)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_return(w.body)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_return(fo.body)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (body_has_return(m.arms[a].body)) {
            return true;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

// --- strict-fresh struct return (discarded-local reclaim guard) --------------
//
// return_fresh_struct_ret_fns_of names the functions whose every return is a struct literal (no base) whose every array-
// typed field is set from a FRESH array LITERAL of a SCALAR or STRING element
// type. Such a returned box is unambiguously the SOLE owner of every field
// buffer (no alias anywhere, scalar/string elements carry no shared inner
// pointers), so a CALLER that binds it to a DISCARDED local can deep-drop it at
// scope exit with no use-after-free. Admitting alias-inc'd fields or
// struct[]/enum[] fields whose elements alias live locals is NOT sufficient:
// the outer-pointer alias-inc does not guard the inner element buffers, so a
// discarded-local deep-drop double-frees them. Consumed by
// reclaimable_names_of (collect_fresh_ret_call_names). #3457 follow-up.
function field_type_is_array(t: string): boolean {
  return t.len() >= 2 && slice_unchecked(t, t.len() - 2, t.len()) == "[]";
}

// struct_lit_field_ident_count: how many of `slit`'s field values are the bare
// ident `name`. One is a move-out; TWO would give the returned box two owning
// references to one buffer under a single rc, so __struct_drop_<T> would free it
// twice. The array-LITERAL form cannot express that (two literals are two
// buffers), so the check arrives with the ident form.
function struct_lit_field_ident_count(slit: ast.ExprStructLit, name: string): i32 {
  var n: i32 = 0;
  var i: i32 = 0;
  while (i < slit.field_values.len()) {
    match (slit.field_values[i]) {
      ast.ExprIdent(fid) => {
        if (fid.name == name) {
          n = n + 1;
        }
      },
      _ => {}
    }
    i = i + 1;
  }
  return n;
}

// arr_field_ident_is_frame_built: `name` is an array LOCAL this frame owns from
// its declaration, only ever self-appended to, and never escaped except into the
// returned struct literal — so the returned box reaches the caller as the sole
// owner of that buffer, exactly as a direct array literal in the field would.
// The three predicates are the ones "ARR:" already uses for the same proof one
// container out; the difference is only which single escape is forgiven.
function arr_field_ident_is_frame_built(name: string, fnbody: ast.Stmt[], arr_fresh: string[]): boolean {
  // Exactly one declaration, so the init witness below cannot be a shadowed
  // sibling of a `var xs = param` in another block — arr_local_init_is_frame_
  // fresh answers on the first declaration it meets, and the two escape scans
  // are name-keyed, so neither would see the second one.
  if (irtables.local_decl_count(fnbody, name) != 1) {
    return false;
  }
  if (!arr_local_init_is_frame_fresh(fnbody, name, arr_fresh, fnbody)) {
    return false;
  }
  if (arr_reassigned_other_than_selfappend(fnbody, name)) {
    return false;
  }
  var no_borrow: string[] = [];
  return !body_unsafe_for_allow_structret(fnbody, name, no_borrow);
}

// strarr_share_read_holder_type: `fv` is the counted-share read `q.f` of a
// `string[]` field off a bare-ident holder this frame can type — a parameter,
// or a local declared exactly once by annotation or by a no-base literal — and
// the answer is that holder's struct type; "" for any other shape. A name bound
// both as a parameter and a local, or declared twice, is refused: every scan
// here is name-keyed and would answer for the wrong binding.
//
// Why the returned literal may hold such a read and still be strict-fresh: the
// ExprStructLit lowering retains the read (enum_arr_field_share_read's arm), so
// the box leaves with a counted reference of its own. The source holder's drop
// releases only the count the source held, and the caller's deep drop decs the
// one the literal took; __fern_str_arr_free walks elements only at rc 1, so a
// second reader that outlives this frame — a holder that was a parameter, a
// second literal, a holder that escaped and was never dropped — leaves the
// count above 1 and costs a leak, never a free. The same terms as the bare
// ident the caller admits one branch up, whose retain is is_arr_slot's.
function strarr_share_read_holder_type(fv: ast.Expr, fnbody: ast.Stmt[], fnparams: ast.ParamDecl[], structs: irtables.StructTab): string {
  if let ast.ExprFieldAccess(fa) = fv {
    if let ast.ExprIdent(hid) = fa.obj {
      var hty: string = "";
      var pi: i32 = 0;
      while (pi < fnparams.len()) {
        if (fnparams[pi].name == hid.name) {
          hty = fnparams[pi].type_name;
        }
        pi = pi + 1;
      }
      var decls: i32 = irtables.local_decl_count(fnbody, hid.name);
      if (decls > 1 || decls > 0 && hty.len() > 0) {
        return "";
      }
      if (hty.len() == 0) {
        hty = declared_struct_type_of(fnbody, hid.name, structs);
      }
      if (hty.len() == 0) {
        hty = fresh_struct_lit_type_deep(fnbody, hid.name);
      }
      if (!irtables.decl_is_struct(structs, hty)) {
        return "";
      }
      if (irtables.decl_field_type(structs, hty, fa.field) != "string[]") {
        return "";
      }
      return hty;
    }
  }
  return "";
}

// body_unsafe_for_allow_structret / stmt_unsafe_for_allow_structret: body_unsafe_for
// with one use forgiven — `name` appearing as a bare field value of a
// RETURN-POSITION struct literal, which is the move-out being proved. Every other
// unsafe use, including a non-bare field value in that same literal, still flags.
function body_unsafe_for_allow_structret(stmts: ast.Stmt[], name: string, borrowable: string[]): boolean {
  return body_unsafe_for_ret_ok(stmts, name, borrowable, false);
}

// body_unsafe_for_allow_bare_ret is the same gate with ONE more forgiveness: a
// top-level `return <name>`. The struct-literal variant above forgives the name
// only at a FIELD of a returned literal (`return P { xs: p }`), so a bare
// `return p` still reads as an escape there — correct for its caller, which asks
// about an array field moved INTO a returned struct, and wrong for a local that
// IS the returned struct (#7343).
//
// Everything else stays flagged: an alias bind, a container store, a moved-out
// field, a non-borrowable call argument. Only the one escape that is the point of
// the shape is forgiven, and only in return position.
function body_unsafe_for_allow_bare_ret(stmts: ast.Stmt[], name: string, borrowable: string[]): boolean {
  return body_unsafe_for_ret_ok(stmts, name, borrowable, true);
}

function body_unsafe_for_ret_ok(stmts: ast.Stmt[], name: string, borrowable: string[], bare_ret_ok: boolean): boolean {
  for stmt in stmts {
    if (stmt_unsafe_for_ret_ok(stmt, name, borrowable, bare_ret_ok)) {
      return true;
    }
  }
  return false;
}

function stmt_unsafe_for_ret_ok(st: ast.Stmt, name: string, borrowable: string[], bare_ret_ok: boolean): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return expr_unsafe_for(v.init, name, borrowable, []);
    },
    ast.StmtReturn(r) => {
      match (r.value) {
        ast.ExprStructLit(rlit) => {
          var fi: i32 = 0;
          while (fi < rlit.field_values.len()) {
            var bare: boolean = false;
            match (rlit.field_values[fi]) {
              ast.ExprIdent(fid) => {
                bare = fid.name == name;
              },
              _ => {}
            }
            if (!bare && expr_unsafe_for(rlit.field_values[fi], name, borrowable, [])) {
              return true;
            }
            fi = fi + 1;
          }
          return false;
        },
        ast.ExprIdent(rid) => {
          // A bare `return <name>` — the move-out this local exists for, and
          // an escape for every other caller of this gate.
          if (bare_ret_ok && rid.name == name) {
            return false;
          }
          return expr_unsafe_for(r.value, name, borrowable, []);
        },
        _ => {
          return expr_unsafe_for(r.value, name, borrowable, []);
        }
      }
    },
    ast.StmtExpr(e) => {
      return expr_unsafe_for(e.value, name, borrowable, []);
    },
    ast.StmtAssign(a) => {
      return expr_unsafe_for(a.value, name, borrowable, []);
    },
    ast.StmtIf(f) => {
      if (expr_unsafe_for(f.cond, name, borrowable, [])) {
        return true;
      }
      return body_unsafe_for_ret_ok(f.then_body, name, borrowable, bare_ret_ok) || body_unsafe_for_ret_ok(f.else_body, name, borrowable, bare_ret_ok);
    },
    ast.StmtWhile(w) => {
      if (expr_unsafe_for(w.cond, name, borrowable, [])) {
        return true;
      }
      return body_unsafe_for_ret_ok(w.body, name, borrowable, bare_ret_ok);
    },
    ast.StmtFor(fo) => {
      var iter_unsafe: boolean = true;
      match (fo.iter) {
        ast.ExprIdent(_) => {
          iter_unsafe = false;
        },
        _ => {
          iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable, []);
        }
      }
      if (iter_unsafe) {
        return true;
      }
      return body_unsafe_for_ret_ok(fo.body, name, borrowable, bare_ret_ok);
    },
    ast.StmtMatch(m) => {
      if (expr_unsafe_for(m.scrutinee, name, borrowable, [])) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, [])) {
          return true;
        }
        if (body_unsafe_for_ret_ok(arm.body, name, borrowable, bare_ret_ok)) {
          return true;
        }
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// spread_copy_field_counted: a field of type `t` of struct `sty`, CARRIED
// through a `T { ...base, … }` spread, reaches the new box as a COUNTED
// reference the box may release DEEP. The base-copy path of
// lower_expr_struct_lit retains a nested-struct or enum field and every array
// field unconditionally, and a STRING field only under `slit_reclaim` — the
// routing verdict — so the string case asks the very same predicate rather than
// assuming it. A scalar carries no reference at all. Tuples, maps, options and
// closures are copied uncounted.
//
// Every array kind counts. The release walks are rc-gated per buffer and per
// element, and the one copy that used to leave a pointer-element buffer's
// elements shared without a count — arr_push's un-share of a shared receiver —
// now retains them first (emit_secure_shared_elems), so the last owner's walk
// frees each element exactly once.
//
// The string clause is not a detail: an unrouted string-fielded type spread as
// a base mints an uncounted co-owner, and treating that as counted hands two
// owners one buffer. Claiming it segfaulted gen1 of the per-module emit-all
// fixpoint while every small-program gate stayed green.
function spread_copy_field_counted(structs: irtables.StructTab, sfok: string[], sty: string, t: string): boolean {
  if (reuse_field_is_scalar(t) || irtables.decl_is_enum(structs, t) || irtables.decl_is_struct(structs, t) || field_type_is_array(t)) {
    return true;
  }
  return t == "string" && struct_routes_field_reclaim_at(structs, sfok, sty);
}

// spread_copy_counted: every field of struct `sty` is spread_copy_field_counted,
// so a `T { ...base, … }` over it mints no uncounted co-owner of base's fields.
function spread_copy_counted(structs: irtables.StructTab, sfok: string[], sty: string): boolean {
  var n: i32 = irtables.decl_field_count(structs, sty);
  var fi: i32 = 0;
  while (fi < n) {
    if (!spread_copy_field_counted(structs, sfok, sty, irtables.decl_field_type_at(structs, sty, fi))) {
      return false;
    }
    fi = fi + 1;
  }
  return n > 0;
}

// spread_carried_fields_counted: the fields `slit` CARRIES from its base — every
// declared field it does not override — all copy counted, so the box it builds
// sole-owns a reference to each, exactly as a no-base literal's fields do. The
// overrides take the caller's per-field walk like any literal's.
function spread_carried_fields_counted(structs: irtables.StructTab, sfok: string[], slit: ast.ExprStructLit): boolean {
  var n: i32 = irtables.decl_field_count(structs, slit.type_name);
  var fi: i32 = 0;
  while (fi < n) {
    if (util.index_of_str(slit.field_names, decl_field_name_at(structs, slit.type_name, fi)) < 0
      && !spread_copy_field_counted(structs, sfok, slit.type_name, irtables.decl_field_type_at(structs, slit.type_name, fi))) {
      return false;
    }
    fi = fi + 1;
  }
  return true;
}

// own_param_ret_is_frame_fresh: `return name` where name is an `own` struct
// PARAMETER hands the caller the box it moved in — sole-owned by the own
// contract, its fields counted by the caller's construction — provided this
// frame took no second reference to it: never redeclared, reassigned, aliased,
// stored or passed on (body_unsafe_for_allow_bare_ret with an empty borrow
// registry, so any call argument refuses), and no field copied out uncounted
// (a spread over counted kinds is forgiven).
function own_param_ret_is_frame_fresh(name: string, structs: irtables.StructTab, sfok: string[], fnbody: ast.Stmt[], fnparams: ast.ParamDecl[]): boolean {
  var ty: string = "";
  var pi: i32 = 0;
  while (pi < fnparams.len()) {
    if (fnparams[pi].name == name && fnparams[pi].own) {
      ty = fnparams[pi].type_name;
    }
    pi = pi + 1;
  }
  if (ty.len() == 0 || !irtables.decl_is_struct(structs, ty) || !decl_is_leaksafe(structs, ty)) {
    return false;
  }
  if (irtables.local_decl_count(fnbody, name) != 0) {
    return false;
  }
  if (util.index_of_str(irtables.body_assign_targets(fnbody), name) >= 0) {
    return false;
  }
  var no_borrow: string[] = [];
  if (body_unsafe_for_allow_bare_ret(fnbody, name, no_borrow)) {
    return false;
  }
  var no_nomove: string[] = [];
  if (moves_fields_stmts(fnbody, name, no_nomove, spread_copy_counted(structs, sfok, ty))) {
    return false;
  }
  return !optstruct_body_moves_field(fnbody, name, ty, structs, no_borrow);
}

function return_value_is_strictfresh_struct(e: ast.Expr, structs: irtables.StructTab, fnbody: ast.Stmt[], arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
  match (e) {
    ast.ExprStructLit(slit) => {
      if (!(irtables.decl_is_struct(structs, slit.type_name) && decl_is_leaksafe(structs, slit.type_name))) {
        return false;
      }
      // A functional update `T { ...base, … }` qualifies when every
      // CARRIED field copies counted; its overrides take the walk below.
      if (slit.has_base && !spread_carried_fields_counted(structs, sfok, slit)) {
        return false;
      }
      var i: i32 = 0;
      while (i < slit.field_names.len()) {
        var ft: string = irtables.decl_field_type(structs, slit.type_name, slit.field_names[i]);
        if (field_type_is_array(ft)) {
          // Only scalar-element / string / nested arrays — a struct[]/enum[]
          // field (deep-drop recursion into possibly-aliased elements)
          // bails. A nested array's rows are counted buffers the drop
          // releases one dec each, so a shared row is never freed early.
          if (!(irtables.is_leaksafe_array_field(ft) || ft == "string[]" || irtables.is_row_array_field_type(structs, ft))) {
            return false;
          }
          var v: ast.Expr = slit.field_values[i];
          var ok: boolean = iife_returns_fresh_array(v);
          match (v) {
            ast.ExprArray(_) => {
              ok = true;
            },
            _ => {}
          }
          // `Q { xs: mk(i) }` — a PRODUCER call. The registries have
          // already proven whole-program that such a callee hands back
          // an array box it allocated, elements included for a
          // string[], so the literal moves that sole reference into
          // the struct exactly as it moves a literal's. Declining it
          // cost the CALLER's binding its whole reclaim — box, buffer
          // and elements — on the ordinary way a producer is written.
          // `arr_fresh` carries the scalar-element registry under bare
          // names and the string[] one under an "SA:" prefix, inert
          // for every bare lookup (the reclaimable_names convention).
          match (v) {
            ast.ExprCall(vc) => {
              match (vc.callee) {
                ast.ExprIdent(vcid) => {
                  var known: boolean = false;
                  if (ft == "string[]") {
                    known = util.index_of_str(arr_fresh, "SA:" + vcid.name) >= 0;
                  } else {
                    known = util.index_of_str(arr_fresh, vcid.name) >= 0;
                  }
                  if (known) {
                    ok = true;
                  }
                },
                _ => {}
              }
            },
            _ => {}
          }
          // `var xs = [ … ]; return Q { xs: xs, … }` — how a producer is
          // actually written, and the literal-only rule declined it, so
          // every caller's `var q = mk(i)` earned no reclaim credit and
          // leaked box + buffer per call (#6758).
          match (v) {
            ast.ExprIdent(vid) => {
              if (!ok && struct_lit_field_ident_count(slit, vid.name) == 1
                && arr_field_ident_is_frame_built(vid.name, fnbody, arr_fresh)) {
                ok = true;
              }
            },
            _ => {}
          }
          // A bare IDENT — a parameter or a live local. Admitted only
          // when this struct's type ROUTES field reclaim, because that
          // is the same predicate the construction retain is gated on
          // (the struct-lit `slit_reclaim` gate): routed means the
          // literal took a reference, so the caller's drop decs a count
          // it owns instead of freeing the caller's array. Unrouted, the
          // field is an uncounted alias and crediting the caller would
          // hand the struct freed memory (#6703's class).
          if (!ok) {
            match (v) {
              ast.ExprIdent(_) => {
                if (struct_routes_field_reclaim_at(structs, sfok, slit.type_name)) {
                  ok = true;
                }
              },
              _ => {}
            }
          }
          // `Q { f: q.f }` over a `string[]` field — the counted-share
          // READ (#5338), admitted on the same terms as the bare ident
          // above: the construction retains it, so the returned box
          // holds a count of its own that the caller's drop decs.
          if (!ok && ft == "string[]"
            && strarr_share_read_holder_type(v, fnbody, fnparams, structs).len() > 0
            && struct_routes_field_reclaim_at(structs, sfok, slit.type_name)) {
            ok = true;
          }
          if (!ok) {
            return false;
          }
        }
        i = i + 1;
      }
      return true;
    },
    ast.ExprCall(fc) => {
      // `return mkp(a, b)` — a FORWARDING frame. The callee is already proven
      // to hand back a box it allocated, and this frame neither binds nor
      // aliases it, so what reaches the caller is that same sole reference.
      // Without this the caller's binding earned no reclaim credit at all and
      // the box leaked whole: 48 B a round on a scalar-only struct, where the
      // direct call to the same producer is flat (#7062).
      match (fc.callee) {
        ast.ExprIdent(fcid) => {
          return util.index_of_str(fwd, fcid.name) >= 0;
        },
        _ => {
          return false;
        }
      }
    },
    ast.ExprIdent(rid) => {
      // `return p` — a LOCAL this frame built and hands straight back. The form
      // real code has: anything that assembles a struct's fields before
      // returning it cannot use the literal-return form, so refusing this cost
      // every caller of such a producer its whole reclaim (#7343).
      //
      // The proof is struct_ret_local_is_frame_fresh, the struct-level sibling
      // of the arr_field_ident_is_frame_built check this same function already
      // runs one level down for an ARRAY field.
      if (own_param_ret_is_frame_fresh(rid.name, structs, sfok, fnbody, fnparams)) {
        return true;
      }
      return struct_ret_local_is_frame_fresh(rid.name, structs, fnbody, arr_fresh, fwd, fnparams, sfok);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// struct_ret_local_is_frame_fresh: `name` is a LOCAL this frame built from a
// strict-fresh struct value and then returned, so what reaches the caller is the
// same sole reference the literal-return form would have handed it.
//
// Four conditions, each ruling out a different way the box could already be
// shared when it leaves:
//
//   - EXACTLY ONE declaration of the name in the body, so the init witness below
//     cannot be a shadowed sibling in another block — the scans here are
//     name-keyed and would not see the second one. Same first line, same reason,
//     as arr_field_ident_is_frame_built.
//   - not a PARAMETER: the caller owns that box, and handing it back is the
//     `return self` shape this whole registry exists to refuse.
//   - never REASSIGNED, which is what makes the declaration's init the whole
//     answer rather than one of several possible final values.
//   - its init is itself strict-fresh, recursively — a literal, a forwarding
//     call, or another such local. Fern requires declaration before use, so the
//     chain walks strictly backwards and terminates.
//
// Then the escape gate, and the ALLOW_STRUCTRET variant is the essential
// choice: it forgives exactly one escape, the `return` that is the point of the
// shape, and still flags an alias bind, a container store, a moved-out field or
// a non-borrowable call argument. A second reference taken anywhere before the
// return defeats the credit.
function struct_ret_local_is_frame_fresh(name: string, structs: irtables.StructTab, fnbody: ast.Stmt[], arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
  if (irtables.local_decl_count(fnbody, name) != 1) {
    return false;
  }
  var pi: i32 = 0;
  while (pi < fnparams.len()) {
    if (fnparams[pi].name == name) {
      return false;
    }
    pi = pi + 1;
  }
  // A REASSIGNED local is admitted only when every assignment carries a
  // strict-fresh struct value itself: the box the return hands out is then
  // frame-fresh whichever write produced it, and the escape gates below
  // still defeat the credit if any reference was taken along the way. One
  // write outside the classifier keeps the refusal — the final value's
  // provenance is unknowable to a flow-free scan. Without this arm the
  // ordinary rebuild-and-return producer freed nothing at all: the caller's
  // binding earned no credit, and 240 B leaked per call (#7357's
  // struct_producer_returns_local decomposition).
  if (util.index_of_str(irtables.body_assign_targets(fnbody), name) >= 0
    && !struct_local_assigns_all_strictfresh(fnbody, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
    return false;
  }
  if (!struct_ret_local_init_strictfresh(fnbody, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
    return false;
  }
  // A FIELD read out of the local is refused as well, and this is the one
  // condition the escape gate above does not cover: `var stolen = p.xs;` is
  // not an escape OF p — expr_unsafe_for sees a borrow — but it takes a second
  // reference to the very buffer the caller's deep drop will free. The shape
  // measures balanced today (200/200, underflow 0, all three oracles agreeing)
  // because the reader dies at this frame's exit, so this refusal costs a leak
  // rather than fixing a fault. It is the safe direction and it is deliberate:
  // admitting it would rest on "no reader outlives the frame", which is a
  // liveness claim this predicate does not make and moves_fields_stmts does.
  var no_nomove: string[] = [];
  var mvsty: string = declared_struct_type_of(fnbody, name, structs);
  if (moves_fields_stmts(fnbody, name, no_nomove, mvsty != "" && spread_copy_counted(structs, sfok, mvsty))) {
    return false;
  }
  var no_mv_borrow: string[] = [];
  if (mvsty != "" && optstruct_body_moves_field(fnbody, name, mvsty, structs, no_mv_borrow)) {
    return false;
  }
  var no_borrow: string[] = [];
  return !body_unsafe_for_allow_bare_ret(fnbody, name, no_borrow);
}

// struct_local_assigns_all_strictfresh: every `name = …` assignment anywhere in
// the subtree (nested blocks and defer actions included) carries a value the
// strict-fresh classifier admits. Vacuously true for an unassigned name; the
// caller pairs it with body_assign_targets so it is only consulted when at
// least one assignment exists.
function struct_local_assigns_all_strictfresh(stmts: ast.Stmt[], name: string, structs: irtables.StructTab, fnbody: ast.Stmt[], arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        if (a.target == name && !return_value_is_strictfresh_struct(a.value, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return false;
        }
      },
      ast.StmtIf(f) => {
        if (!struct_local_assigns_all_strictfresh(f.then_body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return false;
        }
        if (!struct_local_assigns_all_strictfresh(f.else_body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return false;
        }
      },
      ast.StmtWhile(w) => {
        if (!struct_local_assigns_all_strictfresh(w.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return false;
        }
      },
      ast.StmtFor(fo) => {
        if (!struct_local_assigns_all_strictfresh(fo.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return false;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (!struct_local_assigns_all_strictfresh(arm.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
            return false;
          }
        }
      },
      ast.StmtDefer(d) => {
        var one: ast.Stmt[] = [d.action];
        if (!struct_local_assigns_all_strictfresh(one, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return false;
        }
      },
      _ => {}
    }
  }
  return true;
}

// struct_ret_local_init_strictfresh finds `name`'s single declaration anywhere in
// `stmts` (nested blocks included) and asks whether its initialiser is a
// strict-fresh struct value. Answers false when no declaration is found, which is
// the conservative direction: an undeclared name is a parameter or a shadow the
// caller already refused.
function struct_ret_local_init_strictfresh(stmts: ast.Stmt[], name: string, structs: irtables.StructTab, fnbody: ast.Stmt[], arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          return return_value_is_strictfresh_struct(v.init, structs, fnbody, arr_fresh, fwd, fnparams, sfok);
        }
      },
      ast.StmtIf(f) => {
        if (struct_ret_local_init_strictfresh(f.then_body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return true;
        }
        if (struct_ret_local_init_strictfresh(f.else_body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (struct_ret_local_init_strictfresh(w.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (struct_ret_local_init_strictfresh(fo.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (struct_ret_local_init_strictfresh(arm.body, name, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

function body_has_nonstrictfresh_return(stmts: ast.Stmt[], structs: irtables.StructTab, fnbody: ast.Stmt[], arr_fresh: string[], fwd: string[], fnparams: ast.ParamDecl[], sfok: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        if (!return_value_is_strictfresh_struct(r.value, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (body_has_nonstrictfresh_return(f.then_body, structs, fnbody, arr_fresh, fwd, fnparams, sfok) || body_has_nonstrictfresh_return(f.else_body, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_nonstrictfresh_return(w.body, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_nonstrictfresh_return(fo.body, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (body_has_nonstrictfresh_return(m.arms[a].body, structs, fnbody, arr_fresh, fwd, fnparams, sfok)) {
            return true;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

// body_has_nonfresh_arrlit_return: any return whose value is NOT a direct,
// non-empty array LITERAL. The array sibling of body_has_nonstrictfresh_return:
// a literal in return position constructs a
// fresh rc-headered box the callee never binds, so the CALLER'S shallow box
// dec (which never reads elements) is balanced against it. A bare `return out`
// of a local declines (could alias / be swept by the callee).
function body_has_nonfresh_arrlit_return(stmts: ast.Stmt[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        var fresh: boolean = false;
        match (r.value) {
          ast.ExprArray(ae) => {
            fresh = ae.elements.len() > 0;
          },
          _ => {}
        }
        if (!fresh) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (body_has_nonfresh_arrlit_return(f.then_body) || body_has_nonfresh_arrlit_return(f.else_body)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_nonfresh_arrlit_return(w.body)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_nonfresh_arrlit_return(fo.body)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (body_has_nonfresh_arrlit_return(m.arms[a].body)) {
            return true;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

// ── the LOCAL-built scalar-array producer (#6491 follow-up) ──────────────────
//
// `var out: i32[] = []; … out = out.append(v); … return out;` is how a producer
// is actually written, and the literal-return rule above declines it — so the
// caller's reclaims (the discarded `mk(i);` statement and the `mk()[i]` read)
// both left the buffer to leak, 2824 B over 50 rounds where native is flat.
//
// The three predicates below admit it. Together they prove the returned buffer
// is built ENTIRELY in this frame and reaches the caller as its sole rc == 1
// reference: the init is a literal (so it cannot start as a param's buffer), the
// only rebind is the self-append (so it cannot become one later), and nothing
// else escapes it. Element freshness needs no proof at all here — the ret type
// is is_leaksafe_array_field, so every element is a SCALAR, and the shallow
// element-blind `__fern_rc_dec` both consumers emit has no pointer to dangle.

// arr_returned_ident_names collects the name of every `return <ident>` in
// `stmts`. Paired with body_has_nonident_arr_return, which refuses the function
// outright if any return is some other shape.
function arr_returned_ident_names(stmts: ast.Stmt[], acc: string[]): string[] {
  var a: string[] = acc;
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        match (r.value) {
          ast.ExprIdent(rid) => {
            a = push_str_unique(a, rid.name);
          },
          _ => {}
        }
      },
      ast.StmtIf(f) => {
        a = arr_returned_ident_names(f.then_body, a);
        a = arr_returned_ident_names(f.else_body, a);
      },
      ast.StmtWhile(w) => {
        a = arr_returned_ident_names(w.body, a);
      },
      ast.StmtFor(fo) => {
        a = arr_returned_ident_names(fo.body, a);
      },
      ast.StmtMatch(m) => {
        var k: i32 = 0;
        while (k < m.arms.len()) {
          a = arr_returned_ident_names(m.arms[k].body, a);
          k = k + 1;
        }
      },
      _ => {}
    }
  }
  return a;
}

function body_has_nonident_arr_return(stmts: ast.Stmt[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        var ok: boolean = false;
        match (r.value) {
          ast.ExprIdent(_) => {
            ok = true;
          },
          _ => {}
        }
        if (!ok) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (body_has_nonident_arr_return(f.then_body) || body_has_nonident_arr_return(f.else_body)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_nonident_arr_return(w.body)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_nonident_arr_return(fo.body)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var k: i32 = 0;
        while (k < m.arms.len()) {
          if (body_has_nonident_arr_return(m.arms[k].body)) {
            return true;
          }
          k = k + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

// arr_local_init_is_frame_fresh: `name` is declared in `stmts` as `var name = [ … ]`
// (an empty `[]` qualifies — that is the accumulator idiom) or as a call to a
// producer in `arr_fresh`. Without this the name could be seeded from a
// parameter and the caller would free the caller's caller's buffer.
function arr_local_init_is_frame_fresh(stmts: ast.Stmt[], name: string, arr_fresh: string[], fnbody: ast.Stmt[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          match (v.init) {
            ast.ExprArray(_) => {
              return true;
            },
            ast.ExprCall(c) => {
              // A call to an "ARR:" producer proves the same thing the
              // literal does — the returned buffer is a sole-owned rc=1
              // box this frame allocated — one call out. A LOCAL
              // shadowing the callee's name is refused: the registry is
              // keyed by declaration, so the name would resolve to
              // something the proof never saw.
              match (c.callee) {
                ast.ExprIdent(cid) => {
                  return util.index_of_str(arr_fresh, cid.name) >= 0
                    && irtables.local_decl_count(fnbody, cid.name) == 0;
                },
                _ => {
                  return false;
                }
              }
            },
            _ => {
              return false;
            }
          }
        }
      },
      ast.StmtIf(f) => {
        if (arr_local_init_is_frame_fresh(f.then_body, name, arr_fresh, fnbody) || arr_local_init_is_frame_fresh(f.else_body, name, arr_fresh, fnbody)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (arr_local_init_is_frame_fresh(w.body, name, arr_fresh, fnbody)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (arr_local_init_is_frame_fresh(fo.body, name, arr_fresh, fnbody)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var k: i32 = 0;
        while (k < m.arms.len()) {
          if (arr_local_init_is_frame_fresh(m.arms[k].body, name, arr_fresh, fnbody)) {
            return true;
          }
          k = k + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

// arr_reassigned_other_than_selfappend: `name` is rebound by anything other than
// the sanctioned `name = name.append(v)`. body_unsafe_for_allow_ret cannot see
// this — its StmtAssign arm inspects only the assigned VALUE, so `out = param`
// reads as safe there while it is exactly what would alias a buffer this frame
// does not own.
function arr_reassigned_other_than_selfappend(stmts: ast.Stmt[], name: string): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        if (a.target == name) {
          var self_append: boolean = false;
          match (a.value) {
            ast.ExprCall(c) => {
              match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                  if (fa.field == "append" && c.args.len() == 1) {
                    match (fa.obj) {
                      ast.ExprIdent(rid) => {
                        self_append = rid.name == name;
                      },
                      _ => {}
                    }
                  }
                },
                _ => {}
              }
            },
            _ => {}
          }
          if (!self_append) {
            return true;
          }
        }
      },
      ast.StmtIf(f) => {
        if (arr_reassigned_other_than_selfappend(f.then_body, name) || arr_reassigned_other_than_selfappend(f.else_body, name)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (arr_reassigned_other_than_selfappend(w.body, name)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (arr_reassigned_other_than_selfappend(fo.body, name)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var k: i32 = 0;
        while (k < m.arms.len()) {
          if (arr_reassigned_other_than_selfappend(m.arms[k].body, name)) {
            return true;
          }
          k = k + 1;
        }
      },
      ast.StmtDefer(d) => {
        if (arr_reassigned_other_than_selfappend([d.action], name)) {
          return true;
        }
      },
      _ => {}
    }
  }
  return false;
}

// body_returns_local_built_arr: every return hands back a local this frame built
// from a literal and only ever self-appended to, and nothing else escapes it.
function body_returns_local_built_arr(stmts: ast.Stmt[]): boolean {
  if (body_has_nonident_arr_return(stmts)) {
    return false;
  }
  var names: string[] = arr_returned_ident_names(stmts, []);
  if (names.len() == 0) {
    return false;
  }
  var no_borrow: string[] = [];
  // Literal inits only here: this predicate is what arr_fresh_ret_fns_of asks,
  // so consulting that registry from inside it would be circular. A producer
  // returning a local built from ANOTHER producer's result is a widening of
  // its own, not this one.
  var no_producers: string[] = [];
  var i: i32 = 0;
  while (i < names.len()) {
    if (!arr_local_init_is_frame_fresh(stmts, names[i], no_producers, stmts)) {
      return false;
    }
    if (arr_reassigned_other_than_selfappend(stmts, names[i])) {
      return false;
    }
    if (body_unsafe_for_allow_ret(stmts, names[i], no_borrow, [])) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// ── the POINTER half of the fresh-owned-container read (#6491) ───────────────
//
// The scalar half above copies the value out of the container, so releasing the
// container cannot dangle it. A `string` element / field POINTS BACK INTO what
// is being freed, so admitting one needs a stronger property than "the container
// is sole-owned": the extracted reference must be one the container SOLE-OWNS
// too, else the read hands the destination a reference someone else still
// releases. The predicates below prove exactly that, per producer.

// strarr_value_is_fresh: `e` produces a string box this frame constructs and
// nothing else names — a literal (const_str builds a fresh rc=1 box per
// evaluation), a concat / string-method producer (str_local_binding_is_fresh),
// a call to a whole-program str-fresh-ret free function, or a scalar's
// `to_string()`. A bare ident / param / field read is refused: it may alias a
// live box, and transferring it out of the container would leave two owners of
// one reference.
function strarr_value_is_fresh(e: ast.Expr, str_fresh: string[]): boolean {
  match (e) {
    ast.ExprString(_) => {
      return true;
    },
    ast.ExprCall(c) => {
      if (scalar_tostring_call(c)) {
        return true;
      }
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (util.index_of_str(str_fresh, cid.name) >= 0) {
            return true;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return str_local_binding_is_fresh(e);
}

// body_has_nonfresh_strarr_lit_return: any return whose value is NOT a direct,
// non-empty string-array LITERAL of fresh elements. The `string[]` sibling of
// body_has_nonfresh_arrlit_return, with the element proof that one does not need
// (its elements are scalars).
function body_has_nonfresh_strarr_lit_return(stmts: ast.Stmt[], str_fresh: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        var fresh: boolean = false;
        match (r.value) {
          ast.ExprArray(ae) => {
            fresh = ae.elements.len() > 0;
            var ei: i32 = 0;
            while (ei < ae.elements.len()) {
              if (!strarr_value_is_fresh(ae.elements[ei], str_fresh)) {
                fresh = false;
              }
              ei = ei + 1;
            }
          },
          _ => {}
        }
        if (!fresh) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (body_has_nonfresh_strarr_lit_return(f.then_body, str_fresh) || body_has_nonfresh_strarr_lit_return(f.else_body, str_fresh)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_nonfresh_strarr_lit_return(w.body, str_fresh)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_nonfresh_strarr_lit_return(fo.body, str_fresh)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (body_has_nonfresh_strarr_lit_return(m.arms[a].body, str_fresh)) {
            return true;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

// strarr_local_stores_nonfresh: `name` is initialised or self-appended with a
// value that is not provably fresh. Paired with arr_local_has_literal_init /
// arr_reassigned_other_than_selfappend (which prove the BUFFER is this frame's),
// it proves every ELEMENT is this frame's too.
function strarr_local_stores_nonfresh(stmts: ast.Stmt[], name: string, str_fresh: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          match (v.init) {
            ast.ExprArray(ae) => {
              var ei: i32 = 0;
              while (ei < ae.elements.len()) {
                if (!strarr_value_is_fresh(ae.elements[ei], str_fresh)) {
                  return true;
                }
                ei = ei + 1;
              }
            },
            _ => {
              return true;
            }
          }
        }
      },
      ast.StmtAssign(a) => {
        if (a.target == name) {
          var ok: boolean = false;
          match (a.value) {
            ast.ExprCall(c) => {
              match (c.callee) {
                ast.ExprFieldAccess(fa) => {
                  if (fa.field == "append" && c.args.len() == 1) {
                    ok = strarr_value_is_fresh(c.args[0], str_fresh);
                  }
                },
                _ => {}
              }
            },
            _ => {}
          }
          if (!ok) {
            return true;
          }
        }
      },
      ast.StmtIf(f) => {
        if (strarr_local_stores_nonfresh(f.then_body, name, str_fresh) || strarr_local_stores_nonfresh(f.else_body, name, str_fresh)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (strarr_local_stores_nonfresh(w.body, name, str_fresh)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (strarr_local_stores_nonfresh(fo.body, name, str_fresh)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var k: i32 = 0;
        while (k < m.arms.len()) {
          if (strarr_local_stores_nonfresh(m.arms[k].body, name, str_fresh)) {
            return true;
          }
          k = k + 1;
        }
      },
      ast.StmtDefer(d) => {
        if (strarr_local_stores_nonfresh([d.action], name, str_fresh)) {
          return true;
        }
      },
      _ => {}
    }
  }
  return false;
}

// Caller provenance and owned returns are different facts. The former tells
// a store when it must count a second element reference; the latter tells the
// result's owner that it owes an element walk. Neither implies uniqueness.
pub struct StringArraySources { arrays: string[], elements: string[] }

function single_immutable_binding(name: string, bound: string[], assigned: string[]): boolean {
  if (util.has_str(assigned, name)) {
    return false;
  }
  var count: i32 = 0;
  for nm in bound {
    if (nm == name) {
      count = count + 1;
    }
  }
  return count == 1;
}

function caller_string_element(e: ast.Expr, sources: StringArraySources): boolean {
  if let ast.ExprIdent(id) = e {
    return util.has_str(sources.elements, id.name);
  }
  if let ast.ExprIndex(ix) = e {
    return util.has_str(sources.arrays, ident_name_or_empty(ix.array));
  }
  return false;
}

function string_array_sources_in(stmts: ast.Stmt[], bound: string[], assigned: string[], sources: StringArraySources): StringArraySources {
  var out: StringArraySources = sources;
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (single_immutable_binding(v.name, bound, assigned)) {
          if (util.has_str(out.arrays, ident_name_or_empty(v.init))) {
            out = StringArraySources { ...out, arrays: out.arrays.append(v.name) };
          } else if (caller_string_element(v.init, out)) {
            out = StringArraySources { ...out, elements: out.elements.append(v.name) };
          }
        }
      },
      ast.StmtIf(f) => {
        out = string_array_sources_in(f.then_body, bound, assigned, out);
        out = string_array_sources_in(f.else_body, bound, assigned, out);
      },
      ast.StmtWhile(w) => {
        out = string_array_sources_in(w.body, bound, assigned, out);
      },
      ast.StmtFor(f) => {
        if (util.has_str(out.arrays, ident_name_or_empty(f.iter)) && single_immutable_binding(f.var_name, bound, assigned)) {
          out = StringArraySources { ...out, elements: out.elements.append(f.var_name) };
        }
        out = string_array_sources_in(f.body, bound, assigned, out);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          out = string_array_sources_in(arm.body, bound, assigned, out);
        }
      },
      ast.StmtDefer(d) => {
        out = string_array_sources_in([d.action], bound, assigned, out);
      },
      ast.StmtAssign(_) => {},
      ast.StmtReturn(_) => {},
      ast.StmtExpr(_) => {},
      ast.StmtBreak(_) => {},
      ast.StmtContinue(_) => {},
      ast.StmtUnknown(_) => {}
    }
  }
  return out;
}

function string_array_sources_of(fn: parser.FuncDecl): StringArraySources {
  var candidate: boolean = false;
  for p in fn.params {
    if (p.type_name == "string[]" && !p.own) {
      candidate = true;
    }
  }
  if (!candidate) {
    return StringArraySources { arrays: [], elements: [] };
  }
  var arrays: string[] = [];
  var bound: string[] = astwalk.collect_bound_stmts(fn.body, []);
  var assigned: string[] = irtables.body_assign_targets(fn.body);
  for p in fn.params {
    if (p.type_name == "string[]" && !p.own && !util.has_str(bound, p.name) && !util.has_str(assigned, p.name)) {
      arrays = arrays.append(p.name);
    }
  }
  var sources: StringArraySources = StringArraySources { arrays: arrays, elements: [] };
  if (arrays.len() == 0) {
    return sources;
  }
  // A single local declaration can still shadow a parameter. Its fact must
  // not describe that parameter after the local's scope ends.
  var alias_forbidden: string[] = assigned;
  for p in fn.params {
    alias_forbidden = alias_forbidden.append(p.name);
  }
  return string_array_sources_in(fn.body, bound, alias_forbidden, sources);
}

function counted_strarr_store(e: ast.Expr, sources: StringArraySources, str_fresh: string[]): boolean {
  // These are exactly the fresh moves and caller-element shares counted by
  // the array literal / append lowering. An arbitrary borrowed string or
  // local-array element is not evidence of a counted store.
  return strarr_value_is_fresh(e, str_fresh) || caller_string_element(e, sources);
}

function counted_strarr_value(e: ast.Expr, fn: parser.FuncDecl, sources: StringArraySources, owned: string[], str_fresh: string[]): boolean {
  if let ast.ExprArray(a) = e {
    for el in a.elements {
      if (!counted_strarr_store(el, sources, str_fresh)) {
        return false;
      }
    }
    return true;
  }
  if let ast.ExprCall(c) = e {
    var nm: string = ident_name_or_empty(c.callee);
    if (util.has_str(owned, nm)) {
      return true;
    }
    if (!util.has_str(owned, "H:" + nm)) {
      return false;
    }
    var i: i32 = 0;
    while (i < c.args.len()) {
      if (util.has_str(owned, handback_pos_row("H:", nm, i)) && !counted_strarr_arg(c.args[i], fn, sources, owned, str_fresh)) {
        return false;
      }
      i = i + 1;
    }
    return true;
  }
  return false;
}

// handback_pos_row: the row naming position `k` of a handback callee under `tag`.
function handback_pos_row(tag: string, callee: string, k: i32): string {
  return tag + callee + "|" + util.i32_to_string(k);
}

// handback_pos: the position at which the direct call `e` holds the bare ident
// `name`, when that is its only mention and a handback position of a callee
// `rows` lists under `tag`; else -1.
function handback_pos(e: ast.Expr, name: string, rows: string[], tag: string): i32 {
  if let ast.ExprCall(c) = e {
    var callee: string = ident_name_or_empty(c.callee);
    if (callee.len() == 0 || !util.has_str(rows, tag + callee)) {
      return 0 - 1;
    }
    var k: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < c.args.len()) {
      if (ident_name_or_empty(c.args[i]) == name) {
        if (k >= 0 || !util.has_str(rows, handback_pos_row(tag, callee, i))) {
          return 0 - 1;
        }
        k = i;
      }
      i = i + 1;
    }
    return k;
  }
  return 0 - 1;
}

// counted_strarr_handback: `name` is handed to a counted handback callee, whose
// result is either `name` itself or a counted array. Every other handback
// position holds a counted value that is not a local, and no other argument
// reads `name` or an element of it other than as a borrow.
function counted_strarr_handback(e: ast.Expr, name: string, fn: parser.FuncDecl, sources: StringArraySources, owned: string[], str_fresh: string[]): boolean {
  var k: i32 = handback_pos(e, name, owned, "H:");
  if (k < 0) {
    return false;
  }
  if let ast.ExprCall(c) = e {
    var callee: string = ident_name_or_empty(c.callee);
    var i: i32 = 0;
    while (i < c.args.len()) {
      if (i != k) {
        if (strarr_expr_unsafe(c.args[i], name, [])) {
          return false;
        }
        if (util.has_str(owned, handback_pos_row("H:", callee, i)) && !counted_strarr_value(c.args[i], fn, sources, owned, str_fresh)) {
          return false;
        }
      }
      i = i + 1;
    }
  }
  return true;
}

// counted_strarr_arg: an argument at a handback position holds a counted array
// — a counted value, or a counted builder local handed over here.
function counted_strarr_arg(e: ast.Expr, fn: parser.FuncDecl, sources: StringArraySources, owned: string[], str_fresh: string[]): boolean {
  var nm: string = ident_name_or_empty(e);
  if (nm.len() == 0) {
    return counted_strarr_value(e, fn, sources, owned, str_fresh);
  }
  return counted_strarr_local(nm, fn, sources, owned, str_fresh);
}

// counted_strarr_local: `nm` holds a counted array wherever it is returned or
// handed back — a local declared once from a counted value, or an `own`
// parameter the handback proof assumes counted ("P:" in `owned`), used only as
// a counted builder either way.
function counted_strarr_local(nm: string, fn: parser.FuncDecl, sources: StringArraySources, owned: string[], str_fresh: string[]): boolean {
  if (fn_has_param_named(fn, nm)) {
    // A binder of the same name reads another value under this spelling.
    if (!util.has_str(owned, "P:" + nm) || util.has_str(astwalk.collect_bound_stmts(fn.body, []), nm)) {
      return false;
    }
  } else if (irtables.local_decl_count(fn.body, nm) != 1 || !counted_strarr_value(cap_local_init(fn.body, nm), fn, sources, owned, str_fresh)) {
    // A unique binder is not an initializer witness: tuple, foreach and
    // match binders are counted too, and cap_local_init returns Unknown
    // unless a matching var supplies an initializer.
    return false;
  }
  return counted_strarr_builder_ok(fn.body, nm, fn, sources, owned, str_fresh);
}

// Validate every use of a returned builder, not only its final append. Element
// handouts and buffer aliases would need their own counted claim, so remain
// refused. Returning the builder transfers its claim rather than escaping an
// uncounted element. Inspecting an unrelated return still checks its operands.
function counted_strarr_builder_ok(stmts: ast.Stmt[], name: string, fn: parser.FuncDecl, sources: StringArraySources, owned: string[], str_fresh: string[]): boolean {
  for st in stmts {
    match (st) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          if (!counted_strarr_value(v.init, fn, sources, owned, str_fresh)) {
            return false;
          }
        } else if (strarr_expr_unsafe(v.init, name, [])) {
          return false;
        }
      },
      ast.StmtAssign(a) => {
        if (a.target == name) {
          var ok: boolean = false;
          if let ast.ExprCall(c) = a.value {
            if let ast.ExprFieldAccess(fa) = c.callee {
              if (fa.field == "append" && ident_name_or_empty(fa.obj) == name && c.args.len() == 1) {
                ok = counted_strarr_store(c.args[0], sources, str_fresh) && !strarr_expr_unsafe(c.args[0], name, []);
              }
            }
          }
          if (!ok && ident_name_or_empty(a.value).len() == 0 && !strarr_expr_unsafe(a.value, name, [])) {
            ok = counted_strarr_value(a.value, fn, sources, owned, str_fresh);
          }
          if (!ok && !counted_strarr_handback(a.value, name, fn, sources, owned, str_fresh)) {
            return false;
          }
        } else if (strarr_expr_unsafe(a.value, name, [])) {
          return false;
        }
      },
      ast.StmtReturn(r) => {
        if (ident_name_or_empty(r.value) != name && strarr_expr_unsafe(r.value, name, [])
          && !counted_strarr_handback(r.value, name, fn, sources, owned, str_fresh)) {
          return false;
        }
      },
      ast.StmtIf(f) => {
        if (strarr_expr_unsafe(f.cond, name, []) || !counted_strarr_builder_ok(f.then_body, name, fn, sources, owned, str_fresh) || !counted_strarr_builder_ok(f.else_body, name, fn, sources, owned, str_fresh)) {
          return false;
        }
      },
      ast.StmtWhile(w) => {
        if (strarr_expr_unsafe(w.cond, name, []) || !counted_strarr_builder_ok(w.body, name, fn, sources, owned, str_fresh)) {
          return false;
        }
      },
      ast.StmtFor(f) => {
        if (strarr_expr_unsafe(f.iter, name, []) || !counted_strarr_builder_ok(f.body, name, fn, sources, owned, str_fresh)) {
          return false;
        }
      },
      ast.StmtMatch(m) => {
        if (strarr_expr_unsafe(m.scrutinee, name, [])) {
          return false;
        }
        for arm in m.arms {
          if (arm.has_guard && strarr_expr_unsafe(arm.guard, name, []) || !counted_strarr_builder_ok(arm.body, name, fn, sources, owned, str_fresh)) {
            return false;
          }
        }
      },
      ast.StmtDefer(d) => {
        if (!counted_strarr_builder_ok([d.action], name, fn, sources, owned, str_fresh)) {
          return false;
        }
      },
      ast.StmtExpr(e) => {
        if (strarr_expr_unsafe(e.value, name, [])) {
          return false;
        }
      },
      ast.StmtBreak(_) => {},
      ast.StmtContinue(_) => {},
      ast.StmtUnknown(_) => {
        return false;
      }
    }
  }
  return true;
}

function counted_strarr_returns_ok(stmts: ast.Stmt[], fn: parser.FuncDecl, sources: StringArraySources, owned: string[], str_fresh: string[]): boolean {
  for st in stmts {
    match (st) {
      ast.StmtReturn(r) => {
        if (!counted_strarr_value(r.value, fn, sources, owned, str_fresh)) {
          var nm: string = ident_name_or_empty(r.value);
          if (nm.len() == 0 || !counted_strarr_local(nm, fn, sources, owned, str_fresh)) {
            return false;
          }
        }
      },
      ast.StmtIf(f) => {
        if (!counted_strarr_returns_ok(f.then_body, fn, sources, owned, str_fresh) || !counted_strarr_returns_ok(f.else_body, fn, sources, owned, str_fresh)) {
          return false;
        }
      },
      ast.StmtWhile(w) => {
        if (!counted_strarr_returns_ok(w.body, fn, sources, owned, str_fresh)) {
          return false;
        }
      },
      ast.StmtFor(f) => {
        if (!counted_strarr_returns_ok(f.body, fn, sources, owned, str_fresh)) {
          return false;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (!counted_strarr_returns_ok(arm.body, fn, sources, owned, str_fresh)) {
            return false;
          }
        }
      },
      ast.StmtDefer(d) => {
        if (!counted_strarr_returns_ok([d.action], fn, sources, owned, str_fresh)) {
          return false;
        }
      },
      ast.StmtVar(_) => {},
      ast.StmtAssign(_) => {},
      ast.StmtExpr(_) => {},
      ast.StmtBreak(_) => {},
      ast.StmtContinue(_) => {},
      ast.StmtUnknown(_) => {
        return false;
      }
    }
  }
  return true;
}

// Least fixed point: a forwarding result qualifies only after its callee.
// Remove proved functions from the worklist; an ungrounded recursion cycle
// adds nothing and terminates without claiming ownership. No depth cut-off.
// A function whose returns are counted only when its `own string[]`
// parameters hold counted arrays is a HANDBACK: "H:<name>" plus one
// "H:<name>|<k>" row per such position, and a call to it is counted when each
// of those arguments is.
function counted_strarr_returns_of(funcs: parser.FuncDecl[], str_fresh: string[]): string[] {
  var pending: i32[] = [];
  var i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].receiver_type.len() == 0 && funcs[i].ret_type == "string[]" && body_has_return(funcs[i].body)) {
      pending = pending.append(i);
    }
    i = i + 1;
  }
  var owned: string[] = [];
  while (pending.len() > 0) {
    var next: i32[] = [];
    for fi in pending {
      var fn: parser.FuncDecl = funcs[fi];
      var sources: StringArraySources = string_array_sources_of(fn);
      var assumed: string[] = own_strarr_param_rows(fn);
      if (counted_strarr_returns_ok(fn.body, fn, sources, owned, str_fresh)) {
        owned = owned.append(fn.name);
      } else if (assumed.len() > 0 && counted_strarr_returns_ok(fn.body, fn, sources, util.append_all(owned, assumed), str_fresh)) {
        owned = owned.append("H:" + fn.name);
        var k: i32 = 0;
        while (k < fn.params.len()) {
          if (fn.params[k].own && fn.params[k].type_name == "string[]") {
            owned = owned.append(handback_pos_row("H:", fn.name, k));
          }
          k = k + 1;
        }
      } else {
        next = next.append(fi);
      }
    }
    if (next.len() == pending.len()) {
      return owned;
    }
    pending = next;
  }
  return owned;
}

// own_strarr_param_rows: a "P:<name>" row per `own string[]` parameter of `fn`,
// the handback proof's assumption that each holds a counted array.
function own_strarr_param_rows(fn: parser.FuncDecl): string[] {
  var out: string[] = [];
  for p in fn.params {
    if (p.own && p.type_name == "string[]") {
      out = out.append("P:" + p.name);
    }
  }
  return out;
}

// fn_returns_fresh_strarr: `fn` is a FREE function every return of which hands
// back a `string[]` whose buffer AND every element box this frame allocated —
// a direct element-fresh literal, or a local built from one and only ever
// self-appended to. The "STRARR:" registry's admission rule, named so the
// string[]-FIELD store gate can ask the same question the registry asks rather
// than keeping a second, narrower answer.
function fn_returns_fresh_strarr(fn: parser.FuncDecl, str_fresh: string[]): boolean {
  if (fn.receiver_type.len() > 0 || fn.ret_type != "string[]") {
    return false;
  }
  if (!body_has_return(fn.body)) {
    return false;
  }
  return !body_has_nonfresh_strarr_lit_return(fn.body, str_fresh)
    || body_returns_local_built_strarr(fn.body, str_fresh);
}

// body_returns_local_built_strarr: the accumulator idiom for a `string[]` —
// body_returns_local_built_arr plus the per-element freshness proof.
function body_returns_local_built_strarr(stmts: ast.Stmt[], str_fresh: string[]): boolean {
  if (!body_returns_local_built_arr(stmts)) {
    return false;
  }
  var names: string[] = arr_returned_ident_names(stmts, []);
  var i: i32 = 0;
  while (i < names.len()) {
    if (strarr_local_stores_nonfresh(stmts, names[i], str_fresh)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// body_strfields_all_fresh: every return is a struct literal whose every
// `string`-typed DECL field is set from a fresh producer. Applied on top of the
// strict-fresh admission, this is what lets the field read MOVE the string out
// of the box: the box holds the value's only reference (a fresh field takes no
// construction alias-inc), so handing it to the destination and freeing the box
// is one owner in, one owner out.
function body_strfields_all_fresh(stmts: ast.Stmt[], structs: irtables.StructTab, str_fresh: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        match (r.value) {
          ast.ExprStructLit(slit) => {
            var fi: i32 = 0;
            while (fi < slit.field_names.len()) {
              if (irtables.decl_field_type(structs, slit.type_name, slit.field_names[fi]) == "string"
                && !strarr_value_is_fresh(slit.field_values[fi], str_fresh)) {
                return false;
              }
              fi = fi + 1;
            }
          },
          _ => {
            return false;
          }
        }
      },
      ast.StmtIf(f) => {
        if (!body_strfields_all_fresh(f.then_body, structs, str_fresh) || !body_strfields_all_fresh(f.else_body, structs, str_fresh)) {
          return false;
        }
      },
      ast.StmtWhile(w) => {
        if (!body_strfields_all_fresh(w.body, structs, str_fresh)) {
          return false;
        }
      },
      ast.StmtFor(fo) => {
        if (!body_strfields_all_fresh(fo.body, structs, str_fresh)) {
          return false;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (!body_strfields_all_fresh(m.arms[a].body, structs, str_fresh)) {
            return false;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return true;
}

// decl_has_string_field: `sty` declares at least one `string` field.
function decl_has_string_field(structs: irtables.StructTab, sty: string): boolean {
  var n: i32 = irtables.decl_field_count(structs, sty);
  var fi: i32 = 0;
  while (fi < n) {
    if (irtables.decl_field_type_at(structs, sty, fi) == "string") {
      return true;
    }
    fi = fi + 1;
  }
  return false;
}

// arr_fresh_ret_fns_of: NAMES of functions whose every return hands back a
// SCALAR-element array box THIS frame allocated — a direct array literal, or a
// local built from a literal and only ever self-appended to
// (body_returns_local_built_arr). That is the "ARR:" registry's own admission
// rule, lifted out so the strict-fresh struct walk can ask the same question
// about a field value's producer instead of re-deriving it.
//
// A METHOD is admitted under the "<Base>.<method>" key the struct entries of
// this registry already use, and a free function under its bare name. The two
// key spaces cannot collide (a method key contains a '.', an identifier cannot),
// which is what lets the struct walk keep asking bare-name questions of the same
// list and get its prior answers exactly.
//
// Methods were excluded until #7259, and the whole reclaim went with them: a
// method returning a fresh array had its result released by nobody, in every
// consumption form, at 40 B/round UNBOUNDED (4000 / 8000 / 16000 at 100 / 200 /
// 400 rounds, frees=0) where the identical free function is flat. The consumers
// were already method-aware — owned_fresh_call_callee resolves "<Base>.<method>"
// — so they were looking up a key this producer never wrote.
pub function arr_fresh_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
  var out: string[] = [];
  for fn in funcs {
    if (irtables.is_leaksafe_array_field(fn.ret_type)
      && body_has_return(fn.body)
      && (!body_has_nonfresh_arrlit_return(fn.body)
      || body_returns_local_built_arr(fn.body))) {
      out = out.append(arr_fresh_ret_key(fn));
    }
  }
  return out;
}

// arr_fresh_ret_key: the registry key for `fn` — "<Base>.<method>" for a method,
// the bare name for a free function. The one place the two forms are spelled, so
// producer and consumer cannot drift.
pub function arr_fresh_ret_key(fn: parser.FuncDecl): string {
  if (fn.receiver_type.len() > 0) {
    return util.base_type_name(fn.receiver_type) + "." + fn.name;
  }
  return fn.name;
}

// --- owned-array-returning callees ("ARROWN:", #7259) -----------------------
//
// The general form of "ARR:", which asks the same question of a narrower body.
// The question is: does a call to this function leave THIS frame owning one
// reference to the result? Three return shapes say yes, by two mechanisms:
//
//   - `return h.xs` (an rc-array field of the receiver or a struct param) and
//     `return a` (a bare BORROWED array param) are RETAINED on the way out —
//     the return-transfer Perceus dup — so the caller holds a counted alias;
//   - `return [x, y]` MOVES a fresh reference out of the callee's frame.
//
// An `own` param returned bare is NOT admitted. It moves the caller's own
// reference back out, so the caller would hold two names for one reference and
// the release under-flows — measured on the `id(own a) { return a; }` shape,
// which the checker rejects at the call site but the self-host still lowers.
//
// A caller that BINDS the result pays the dec from the binding slot's exit
// sweep. A caller that consumes it in place — `h.get().len()`, `grab(h)[0]`,
// a discarded `h.get();` — has no slot, so nothing paid it and the rc ratcheted
// up once per call: 48 B/round on `i32[]`, unbounded, where native is flat at
// zero. These entries are what the in-place consumers release against.
//
// The release is the SHALLOW rc-guarded `__fern_rc_dec`. For a retained alias
// that is right at any element kind — the dup was on the buffer POINTER and the
// elements belong to whoever the callee borrowed from. For a moved LITERAL the
// elements come with it, so that shape is admitted only at a scalar element
// type, where shallow and complete are the same thing. That is also what
// separates this from "STRARR:", whose deep free needs a fresh buffer.

// arrown_ret_type: `t` is one of the four rc-array types the StmtReturn dup arms
// classify — scalar-element, array-of-struct, array-of-enum, `string[]`. A
// `T[][]` field is deliberately absent: no return arm claims it, so it reaches
// the generic move-on-return path with no dup to release.
function arrown_ret_type(structs: irtables.StructTab, t: string): boolean {
  return irtables.is_leaksafe_array_field(t) || irtables.is_struct_array_field_type(structs, t)
    || irtables.is_enum_array_field_type(structs, t) || t == "string[]";
}

// arrown_obj_struct_type: the DECLARED struct type of `name` inside `fn` when it
// is the receiver or a struct-typed parameter, else "". Those are the two
// receivers whose `expr_struct_type` the lowering resolves from the signature
// alone, which is what keeps this AST-side answer and the lowering's agreeing.
function arrown_obj_struct_type(fn: parser.FuncDecl, name: string, structs: irtables.StructTab): string {
  if (fn.receiver_name.len() > 0 && fn.receiver_name == name) {
    var rty: string = util.base_type_name(fn.receiver_type);
    if (irtables.decl_is_struct(structs, rty)) {
      return rty;
    }
    return "";
  }
  var i: i32 = 0;
  while (i < fn.params.len()) {
    if (fn.params[i].name == name) {
      if (irtables.decl_is_struct(structs, fn.params[i].type_name)) {
        return fn.params[i].type_name;
      }
      return "";
    }
    i = i + 1;
  }
  return "";
}

// arrown_ret_value: `e` is a return value that leaves the caller owning one
// reference — the three shapes in the section comment. An array LITERAL moves
// rather than retains, so it carries its elements with it and is admitted only
// at a scalar element type.
function arrown_ret_value(e: ast.Expr, fn: parser.FuncDecl, structs: irtables.StructTab, acc: string[]): boolean {
  match (e) {
    ast.ExprCall(c) => {
      // A forwarding call to a free function already admitted: its result is
      // the caller's on every path, so it is this function's caller's too.
      // A free function's call to itself is owned by induction on the
      // returns the rest of the walk checks.
      match (c.callee) {
        ast.ExprIdent(cid) => {
          if (cid.name == fn.name && fn.receiver_type.len() == 0) {
            return true;
          }
          return util.index_of_str(acc, "ARROWN:" + cid.name) >= 0;
        },
        _ => {
          return false;
        }
      }
    },
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(oid) => {
          var oty: string = arrown_obj_struct_type(fn, oid.name, structs);
          if (oty.len() == 0) {
            return false;
          }
          return arrown_ret_type(structs, irtables.decl_field_type(structs, oty, fa.field));
        },
        _ => {
          return false;
        }
      }
    },
    ast.ExprIdent(id) => {
      var i: i32 = 0;
      while (i < fn.params.len()) {
        if (fn.params[i].name == id.name) {
          if (fn.params[i].own) {
            return false;
          }
          return arrown_ret_type(structs, fn.params[i].type_name);
        }
        i = i + 1;
      }
      return false;
    },
    ast.ExprArray(_) => {
      return irtables.is_leaksafe_array_field(fn.ret_type);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// body_has_non_arrown_return: some return in `stmts` hands back something the
// caller does not own, so it cannot be told it owns one on every path.
function body_has_non_arrown_return(stmts: ast.Stmt[], fn: parser.FuncDecl, structs: irtables.StructTab, acc: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        if (!arrown_ret_value(r.value, fn, structs, acc)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (body_has_non_arrown_return(f.then_body, fn, structs, acc) || body_has_non_arrown_return(f.else_body, fn, structs, acc)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_non_arrown_return(w.body, fn, structs, acc)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_non_arrown_return(fo.body, fn, structs, acc)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (body_has_non_arrown_return(m.arms[a].body, fn, structs, acc)) {
            return true;
          }
          a = a + 1;
        }
      },
      ast.StmtDefer(_) => {},
      _ => {}
    }
  }
  return false;
}

// fn_returns_owned_arr: EVERY return of `fn` leaves the caller owning one
// reference to the result. All-or-nothing — the consumers release
// unconditionally, so one path that hands back a borrow refuses the whole
// function.
pub function fn_returns_owned_arr(fn: parser.FuncDecl, structs: irtables.StructTab, acc: string[]): boolean {
  return arrown_ret_type(structs, fn.ret_type)
    && body_has_return(fn.body)
    && !body_has_non_arrown_return(fn.body, fn, structs, acc);
}

// fresh_enum_ret_value: `e` is a return value of an enum-returning fn that the
// caller owns outright: a fresh variant ctor (the ctor's own payload counting
// is position-independent — a bare-ident array payload is dup'd, a literal is
// owned — so the box hands over sole-owned exactly like a ctor written at the
// use site), or a forwarding call to a free function already credited in `acc`.
function fresh_enum_ret_value(e: ast.Expr, structs: irtables.StructTab, acc: string[]): boolean {
  if (variant_ctor_enum_owner(e, structs).len() > 0) {
    return true;
  }
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return util.index_of_str(acc, cid.name) >= 0;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// body_has_nonfreshenum_return: some return in `stmts` hands back an enum value
// the caller cannot be told it owns — anything but a fresh variant ctor, an
// admitted forwarding call, a local enum_ret_local_kind admits, or a borrowed
// parameter or parameter field the return retains (enum_ret_param_handback).
// All-or-nothing, like the struct walk beneath.
function body_has_nonfreshenum_return(stmts: ast.Stmt[], fn: parser.FuncDecl, structs: irtables.StructTab, acc: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        if (!fresh_enum_ret_value(r.value, structs, acc) && enum_ret_local_kind(fn, ident_name_or_empty(r.value), structs, acc) == ""
          && !enum_ret_param_handback(fn, r.value, structs)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (body_has_nonfreshenum_return(f.then_body, fn, structs, acc) || body_has_nonfreshenum_return(f.else_body, fn, structs, acc)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_nonfreshenum_return(w.body, fn, structs, acc)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_nonfreshenum_return(fo.body, fn, structs, acc)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (body_has_nonfreshenum_return(m.arms[a].body, fn, structs, acc)) {
            return true;
          }
          a = a + 1;
        }
      },
      ast.StmtDefer(_) => {},
      _ => {}
    }
  }
  return false;
}

// enum_ret_param_handback: `e` is a non-own parameter of `fn`'s enum return
// type, or that type's field of a non-own struct parameter, the parameter
// never reassigned or redeclared. ret_enum_param_handback retains it at the
// return, so the result carries a count of its own.
function enum_ret_param_handback(fn: parser.FuncDecl, e: ast.Expr, structs: irtables.StructTab): boolean {
  if let ast.ExprIdent(id) = e {
    return counted_handback_param(fn, id.name);
  }
  if let ast.ExprFieldAccess(fa) = e {
    var pn: string = ident_name_or_empty(fa.obj);
    if (pn.len() == 0 || irtables.local_decl_count(fn.body, pn) != 0 || util.index_of_str(irtables.body_assign_targets(fn.body), pn) >= 0) {
      return false;
    }
    for pd in fn.params {
      if (pd.name == pn) {
        return !pd.own && irtables.decl_is_struct(structs, pd.type_name) && irtables.decl_field_type(structs, pd.type_name, fa.field) == fn.ret_type;
      }
    }
  }
  return false;
}

// enum_ret_local_kind: how a bare `return name` of `fn` hands the caller a
// count, or "" when it may not. "fresh": a never-reassigned local built by a
// fresh ctor or a member call that escapes only by the return, so its box is
// this frame's own whether or not a credit sweeps it. "alias": a
// never-reassigned `var g = h.e` field alias, which counts only when its
// EALIAS credit dup'd it; the return path retains it otherwise
// (enum_ret_alias_rows).
function enum_ret_local_kind(fn: parser.FuncDecl, name: string, structs: irtables.StructTab, acc: string[]): string {
  if (name.len() == 0 || irtables.local_decl_count(fn.body, name) != 1) {
    return "";
  }
  for pd in fn.params {
    if (pd.name == name) {
      return "";
    }
  }
  if (util.index_of_str(irtables.body_assign_targets(fn.body), name) >= 0) {
    return "";
  }
  var kind: string = enum_local_init_kind(fn.body, name, structs, acc);
  if (kind == "fresh" && body_unsafe_for_allow_bare_ret(fn.body, name, [])) {
    return "";
  }
  return kind;
}

// enum_local_init_kind: enum_ret_local_kind's reading of `name`'s declaration.
function enum_local_init_kind(stmts: ast.Stmt[], name: string, structs: irtables.StructTab, acc: string[]): string {
  for stmt in stmts {
    var k: string = "";
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          if (fresh_enum_ret_value(v.init, structs, acc)) {
            return "fresh";
          }
          if (enum_field_alias_candidate(v.init, structs)) {
            return "alias";
          }
          return "";
        }
      },
      ast.StmtIf(f) => {
        k = enum_local_init_kind(f.then_body, name, structs, acc);
        if (k == "") {
          k = enum_local_init_kind(f.else_body, name, structs, acc);
        }
      },
      ast.StmtWhile(w) => {
        k = enum_local_init_kind(w.body, name, structs, acc);
      },
      ast.StmtFor(fo) => {
        k = enum_local_init_kind(fo.body, name, structs, acc);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (k == "") {
            k = enum_local_init_kind(arm.body, name, structs, acc);
          }
        }
      },
      _ => {}
    }
    if (k != "") {
      return k;
    }
  }
  return "";
}

// fresh_enum_fwd_fixpoint: the bare names of FREE functions whose every return
// hands the caller a count — a fresh variant ctor, a forwarding call to another
// member, or a local enum_ret_local_kind admits — the "ENUM:" half of the
// strict-fresh registry, iterated like the struct fixpoint below so
// forwarding chains ground out; mutual recursion with no grounding stays
// uncredited (conservative).
function fresh_enum_fwd_fixpoint(funcs: parser.FuncDecl[], structs: irtables.StructTab): string[] {
  var pending: i32[] = [];
  var k: i32 = 0;
  while (k < funcs.len()) {
    if (funcs[k].receiver_type.len() == 0 && irtables.decl_is_enum(structs, funcs[k].ret_type)
      && body_has_return(funcs[k].body)) {
      pending = pending.append(k);
    }
    k = k + 1;
  }
  var acc: string[] = [];
  var round: i32 = 0;
  while (round < 8) {
    var still: i32[] = [];
    var added: boolean = false;
    var p: i32 = 0;
    while (p < pending.len()) {
      var fi: i32 = pending[p];
      if (!body_has_nonfreshenum_return(funcs[fi].body, funcs[fi], structs, acc)) {
        acc = acc.append(funcs[fi].name);
        added = true;
      } else {
        still = still.append(fi);
      }
      p = p + 1;
    }
    pending = still;
    if (!added || pending.len() == 0) {
      return acc;
    }
    round = round + 1;
  }
  return acc;
}

// enum_fresh_ret_call: `e` is a call to a free function in the "ENUM:" half of
// the strict-fresh registry, so its result is a variant box carrying one count
// this caller owns, which may be shared (an alias return, a produced callee).
pub function enum_fresh_ret_call(e: ast.Expr, reg: string[]): boolean {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(cid) => {
          return util.index_of_str(reg, "ENUM:" + cid.name) >= 0;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// fresh_struct_fwd_fixpoint: the bare NAMES of free functions whose every return
// is a strict-fresh struct — the set the forwarding arm of
// return_value_is_strictfresh_struct resolves a callee against. Iterated to a
// fixpoint so a chain of forwarding frames is admitted end to end; the round cap
// bounds the chain length rather than the call graph, and a longer one simply
// stays uncredited.
function fresh_struct_fwd_fixpoint(funcs: parser.FuncDecl[], structs: irtables.StructTab, arr_fresh: string[], sfok: string[]): string[] {
  // Candidates are fixed by their signature, so the type tests are done once.
  var pending: i32[] = [];
  var k: i32 = 0;
  while (k < funcs.len()) {
    var rt: string = funcs[k].ret_type;
    if (funcs[k].receiver_type.len() == 0 && irtables.decl_is_struct(structs, rt) && decl_is_leaksafe(structs, rt)
      && body_has_return(funcs[k].body)) {
      pending = pending.append(k);
    }
    k = k + 1;
  }
  // Later rounds re-walk only what is still UNCREDITED. The classifier is
  // monotone — a credited name never loses its entry when the set grows — so
  // re-asking about one that already qualified can only produce the same
  // answer, and the body walk is the expensive part of this pass.
  var acc: string[] = [];
  var round: i32 = 0;
  while (round < 8) {
    var still: i32[] = [];
    var added: boolean = false;
    var p: i32 = 0;
    while (p < pending.len()) {
      var fi: i32 = pending[p];
      if (!body_has_nonstrictfresh_return(funcs[fi].body, structs, funcs[fi].body, arr_fresh, acc, funcs[fi].params, sfok)) {
        acc = acc.append(funcs[fi].name);
        added = true;
      } else {
        still = still.append(fi);
      }
      p = p + 1;
    }
    pending = still;
    if (!added || pending.len() == 0) {
      return acc;
    }
    round = round + 1;
  }
  return acc;
}

// closure_body_name: `name` is a body the lift hoists for a function value — a
// named function's or lambda's trampoline (`$wrap`), a capturing lambda
// (`$clo`), or a hoisted no-capture lambda (`__lam_`: a call argument, an IIFE
// callee, or a local that is only ever called). The first two are reached
// through the value; a `__lam_` body is called by name, and is named here so
// the verdicts below never leave one out.
pub function closure_body_name(name: string): boolean {
  if (name.len() >= 6 && slice_unchecked(name, 0, 6) == "__lam_") {
    return true;
  }
  return util.contains(name, "$wrap") || util.contains(name, "$clo");
}

// closure_result_known: the declared result of `fn` names one type, so a
// closure body it heads cannot return an enum it does not declare. A type
// variable, an alias, or no result on a body that returns does not.
function closure_result_known(fn: parser.FuncDecl, structs: irtables.StructTab): boolean {
  var rt: string = fn.ret_type;
  if (rt.len() == 0) {
    return !body_has_return(fn.body);
  }
  if (irtables.decl_is_enum(structs, rt) || irtables.decl_is_struct(structs, rt) || irtables.is_scalar_type_name(rt)) {
    return true;
  }
  if (rt == "void" || rt == "string" || rt == "fn" || rt[0] == b'(' || irtables.is_array_type_name(rt) || is_map_type_name(rt)) {
    return true;
  }
  return bytes_at(rt, 0, "Option[") || bytes_at(rt, 0, "Result[");
}

// closure_result_enums: the enums some closure body declares it returns, or
// none when any closure body's result is not known — a call through a function
// value may then reach a body returning an enum no declaration names.
function closure_result_enums(funcs: parser.FuncDecl[], structs: irtables.StructTab): string[] {
  var out: string[] = [];
  for fn in funcs {
    if (closure_body_name(fn.name)) {
      if (!closure_result_known(fn, structs)) {
        return [];
      }
      if (irtables.decl_is_enum(structs, fn.ret_type)) {
        out = push_str_unique(out, fn.ret_type);
      }
    }
  }
  return out;
}

// counted_closure_enum_rows: "CLOENUM:<E>" for each enum a call through a
// function value hands its caller one count of, and "ENUM:<body>" for each
// closure body returning one that fresh_enum_fwd_fixpoint (`members`) did not
// already admit. Such a body retains a return it holds no count for
// (ret_enum_closure_uncounted), so every closure body of result E is a member.
function counted_closure_enum_rows(funcs: parser.FuncDecl[], structs: irtables.StructTab, members: string[]): string[] {
  var enums: string[] = closure_result_enums(funcs, structs);
  var out: string[] = [];
  for e in enums {
    out = out.append("CLOENUM:" + e);
  }
  for fn in funcs {
    if (closure_body_name(fn.name) && util.index_of_str(enums, fn.ret_type) >= 0
      && body_has_return(fn.body) && util.index_of_str(members, fn.name) < 0) {
      out = out.append("ENUM:" + fn.name);
    }
  }
  return out;
}

pub function return_fresh_struct_ret_fns_of(funcs: parser.FuncDecl[], structs: irtables.StructTab, sfok: string[]): string[] {
  var out: string[] = [];
  // The whole-program str-fresh-ret registry, needed to prove a `string`
  // element / field value is this frame's own box. Computed once, and only
  // when some function can actually produce a pointer-bearing container —
  // the walk is linear in every body, so a module with no such producer must
  // not pay for it.
  var str_fresh: string[] = [];
  var pk: i32 = 0;
  var want_str_fresh: boolean = false;
  for fn in funcs {
    if (fn.ret_type == "string[]") {
      want_str_fresh = true;
    } else if (irtables.decl_is_struct(structs, fn.ret_type) && decl_has_string_field(structs, fn.ret_type)) {
      want_str_fresh = true;
    }
  }
  if (want_str_fresh) {
    str_fresh = str_fresh_ret_fns_of(funcs);
  }
  // Counted elements need not be fresh or unique. Keep this result separate
  // from STRARR: so projection and field-freshness consumers do not widen.
  // A handback row "H:..." is registered as "SARRH:...".
  for nm in counted_strarr_returns_of(funcs, str_fresh) {
    if (bytes_at(nm, 0, "H:")) {
      out = out.append("SARRH:" + slice_unchecked(nm, 2, nm.len()));
    } else {
      out = out.append("SARRC:" + nm);
    }
  }
  var arr_fresh: string[] = arr_fresh_ret_fns_of(funcs);
  // The string[] producers are in the same list under "SA:" so the strict-fresh
  // walk can ask about either element kind without a second parameter; every
  // other consumer of this list looks up a bare name, which the prefix cannot
  // match. Only walked when the string-fresh registry was worth computing.
  for fn in funcs {
    if (fn_returns_fresh_strarr(fn, str_fresh)) {
      arr_fresh = arr_fresh.append("SA:" + fn.name);
    }
  }
  // The bare-name half is a LEAST FIXPOINT, because a return may now forward
  // to another producer (`return mkp(a, b)`) and so depends on that one's
  // verdict. Starts empty and only ever adds — a use is credited on a literal
  // or on a callee already proven — so the iteration is monotone; a mutual
  // recursion with no grounding stays uncredited, the conservative direction.
  // Free functions only: the forwarding arm resolves a bare-ident callee, so a
  // method key could never be the thing it looks up.
  var fwd: string[] = fresh_struct_fwd_fixpoint(funcs, structs, arr_fresh, sfok);
  out = util.append_all(out, thread_rows_of(funcs, structs, sfok, str_fresh, fwd));
  // "ENUM:<name>" — FREE functions whose every return hands the caller a
  // count (fresh_enum_fwd_fixpoint). The ExprStructLit enum arm hands such a
  // result over with no alias-inc, the same class as a ctor written at the
  // field position.
  var enum_fresh: string[] = fresh_enum_fwd_fixpoint(funcs, structs);
  var efi: i32 = 0;
  while (efi < enum_fresh.len()) {
    out = out.append("ENUM:" + enum_fresh[efi]);
    efi = efi + 1;
  }
  out = append_all(out, counted_closure_enum_rows(funcs, structs, enum_fresh));
  for fn in funcs {
    var rt: string = fn.ret_type;
    // A FREE function's verdict is exactly its membership in the fixpoint
    // above, which asked this question with the same arguments; only a
    // METHOD (never a forwarding-arm callee, so never in that set) still
    // needs the walk here.
    var strict_fresh_ret: boolean = irtables.decl_is_struct(structs, rt) && decl_is_leaksafe(structs, rt) && body_has_return(fn.body);
    if (strict_fresh_ret) {
      if (fn.receiver_type.len() == 0) {
        strict_fresh_ret = util.index_of_str(fwd, fn.name) >= 0;
      } else {
        strict_fresh_ret = !body_has_nonstrictfresh_return(fn.body, structs, fn.body, arr_fresh, fwd, fn.params, sfok);
      }
    }
    if (strict_fresh_ret) {
      var key: string = fn.name;
      if (fn.receiver_type.len() > 0) {
        key = util.base_type_name(fn.receiver_type) + "." + fn.name;
      }
      out = out.append(key);
    }
    // "ARR:<name>" entries (#4365): FREE functions returning a SCALAR-element
    // array box this frame allocated. Uses this registry (prefix-multiplexed, the reclaimable_
    // names convention) so the discarded-call reclaim in lower_stmt reads it
    // off LowerState with no new threading; every other consumer looks up bare
    // names / "<Base>.<method>" keys, which an "ARR:"-prefixed entry can never
    // match. Consumed by the discarded `mk(i);` statement reclaim and by the
    // `mk()[i]` read reclaim (#6491) — both the caller-side shallow
    // __fern_rc_dec of the returned rc=1 buffer (native's
    // ownedCallResultType arc; the box is fresh-by-construction in return
    // position, so the dec is balanced and element-blind).
    //
    // Which functions qualify is arr_fresh_ret_fns_of's question, asked once
    // above so the strict-fresh struct walk can ask the same one.
    var arrkey: string = arr_fresh_ret_key(fn);
    if (util.index_of_str(arr_fresh, arrkey) >= 0) {
      out = out.append("ARR:" + arrkey);
    }
    // "ARROWN:<key>" — the general sibling of "ARR:" (#7259): every return
    // leaves the caller owning one reference, whether the callee retained a
    // borrowed buffer or moved a fresh one out. Consumed by the same
    // in-place release sites; the two overlap where a body is all fresh
    // literals, and both spell the same shallow dec there.
    if (fn_returns_owned_arr(fn, structs, out)) {
      out = out.append("ARROWN:" + arrkey);
    }
    // "STRARR:<name>" — the POINTER-element sibling of "ARR:" (#6491): a FREE
    // function returning a `string[]` every element of which this frame
    // allocated. The read reclaim retains the extracted element and then
    // DEEP-frees the container (__fern_str_arr_free), so the other elements
    // and the buffer go back and the extracted one arrives at the destination
    // holding its own single reference. "ARR:" cannot carry this: its
    // consumers release the buffer element-blind, which for a string[] would
    // strand every element it did not extract.
    if (fn_returns_fresh_strarr(fn, str_fresh)) {
      out = out.append("STRARR:" + fn.name);
    }
    // "ARRTUPF:<name>" / "ARRSTRUCTF:<name>" — the array-of-BOXES producers
    // (#4353): a FREE function whose every return is a fresh array literal of
    // fresh tuple (resp. struct) literals. A binding from one earns the same
    // ARRTUP: / ARRSTRUCT: credit an array literal earns, so the caller's
    // deep free reaches every element box; the callee's returned value
    // escapes its own frame and keeps the shallow dec.
    if (fn_returns_fresh_arrtup(fn, structs, str_fresh)) {
      out = out.append("ARRTUPF:" + fn.name);
    }
    if (fn_returns_fresh_arrstruct(fn, structs, sfok, fwd)) {
      out = out.append("ARRSTRUCTF:" + fn.name);
    }
    // "STRUCTARRF:<name>" — the same for the SCALAR-FIELD struct arrays the
    // row above does not claim (#7445). It was the one element kind whose
    // producer had no registry: a `var v: P[] = mk()` binding earned no
    // credit at all, so its exit sweep took the generic shallow buffer dec
    // and stranded every element box — 160 B per round, unbounded, where the
    // byte-identical literal init was flat.
    if (fn_returns_fresh_structarr(fn, structs, sfok, fwd)) {
      out = out.append("STRUCTARRF:" + fn.name);
    }
    // "ARENUMF:<name>|<Enum>" — the array-of-ENUM sibling of the rows above.
    // The enum is carried in the row because an `E[]` slot records its element type
    // nowhere, the same reason the "ARRENUM:" credit carries it.
    var aef: string = arrenum_producer_enum(fn, structs);
    if (aef.len() > 0) {
      out = out.append("ARENUMF:" + fn.name + "|" + aef);
    }
    // "STRFLDF:<name>" / "STRFLDF:<Base>.<method>" — the field-read half: a
    // strict-fresh struct producer whose every `string` field is fresh, and
    // whose return type carries no rc-ARRAY field (so the read's release is
    // the bare box dec, with no __struct_drop_<T> to also touch the field
    // being moved out). The read then MOVES the string: no retain, no field
    // dec, one owner in and one owner out. Every OTHER string field of the
    // box leaks with it — the established safe floor, never an over-release.
    //
    // A METHOD earns the entry on the same terms. The receiver is not a
    // special case for it: every return being a strict-fresh LITERAL
    // already refuses `return b`, and body_strfields_all_fresh refuses a
    // literal built out of `b.tag` — the two shapes in which the result
    // could carry the receiver's own box.
    if (irtables.decl_is_struct(structs, rt) && decl_is_leaksafe(structs, rt)
      && decl_has_string_field(structs, rt) && !struct_has_reclaim_array_field(structs, rt)
      && strict_fresh_ret
      && body_strfields_all_fresh(fn.body, structs, str_fresh)) {
      var skey: string = fn.name;
      if (fn.receiver_type.len() > 0) {
        skey = util.base_type_name(fn.receiver_type) + "." + fn.name;
      }
      out = out.append("STRFLDF:" + skey);
    }
  }
  // "CNTRET:<key>" — the counted-return class, the MIXED-path producer
  // (`if (t.len() == 0) { return b; }`, which every builder-ish method opens
  // with) included: neither the bare entry nor "STRFLDF:" can hold it (both
  // demand every path be fresh), and refusing it strands the fresh path's
  // box at every call. Its handback path is counted by the return path, so a
  // read-through or discarded result takes the bare box dec either way.
  for ck in counted_struct_ret_fns_of(funcs, structs, arr_fresh, fwd, sfok) {
    out = out.append("CNTRET:" + ck);
  }
  return out;
}

// counted_struct_ret_fns_of: the "CNTRET:" class.
// A least fixpoint over every function with a leak-safe struct return: a
// return is counted when it is strict-fresh, a bare non-own parameter or
// receiver of the return type that the body never reassigns or redeclares
// (the return path retains it), or a call to a member already proven — a
// free function by its bare name, a method through a declared receiver type.
function counted_struct_ret_fns_of(funcs: parser.FuncDecl[], structs: irtables.StructTab, arr_fresh: string[], fwd: string[], sfok: string[]): string[] {
  var pending: i32[] = [];
  var k: i32 = 0;
  while (k < funcs.len()) {
    if (irtables.decl_is_struct(structs, funcs[k].ret_type) && decl_is_leaksafe(structs, funcs[k].ret_type) && body_has_return(funcs[k].body)) {
      pending = pending.append(k);
    }
    k = k + 1;
  }
  var acc: string[] = [];
  var round: i32 = 0;
  while (round < 8) {
    var still: i32[] = [];
    var added: boolean = false;
    var p: i32 = 0;
    while (p < pending.len()) {
      var fi: i32 = pending[p];
      if (!body_has_uncounted_return(funcs[fi].body, funcs[fi], structs, arr_fresh, fwd, sfok, acc)) {
        acc = acc.append(struct_ret_key(funcs[fi]));
        added = true;
      } else {
        still = still.append(fi);
      }
      p = p + 1;
    }
    pending = still;
    if (!added || pending.len() == 0) {
      return acc;
    }
    round = round + 1;
  }
  return acc;
}

function body_has_uncounted_return(stmts: ast.Stmt[], fn: parser.FuncDecl, structs: irtables.StructTab, arr_fresh: string[], fwd: string[], sfok: string[], acc: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        if (!counted_ret_value(r.value, fn, structs, arr_fresh, fwd, sfok, acc)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (body_has_uncounted_return(f.then_body, fn, structs, arr_fresh, fwd, sfok, acc) || body_has_uncounted_return(f.else_body, fn, structs, arr_fresh, fwd, sfok, acc)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_uncounted_return(w.body, fn, structs, arr_fresh, fwd, sfok, acc)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_uncounted_return(fo.body, fn, structs, arr_fresh, fwd, sfok, acc)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (body_has_uncounted_return(arm.body, fn, structs, arr_fresh, fwd, sfok, acc)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

function counted_ret_value(e: ast.Expr, fn: parser.FuncDecl, structs: irtables.StructTab, arr_fresh: string[], fwd: string[], sfok: string[], acc: string[]): boolean {
  if (return_value_is_strictfresh_struct(e, structs, fn.body, arr_fresh, fwd, fn.params, sfok)) {
    return true;
  }
  if let ast.ExprIdent(rid) = e {
    return counted_handback_param(fn, rid.name);
  }
  var vb: ast.Stmt[] = cond_value_body(e);
  if (vb.len() > 0) {
    return cond_leaves_counted(vb, fn, structs, arr_fresh, fwd, sfok, acc);
  }
  var key: string = counted_forward_key(e, fn, structs);
  return key.len() > 0 && util.index_of_str(acc, key) >= 0;
}

// cond_leaves_counted: every leaf of the if, match or block value with body
// `vb` is a counted return, or a local of `fn` the value does not bind, which
// its arm retains.
function cond_leaves_counted(vb: ast.Stmt[], fn: parser.FuncDecl, structs: irtables.StructTab, arr_fresh: string[], fwd: string[], sfok: string[], acc: string[]): boolean {
  var leaves: ast.Expr[] = cond_value_leaves(vb);
  if (leaves.len() == 0) {
    return false;
  }
  for lf in leaves {
    if (!cond_leaf_is_outer_local(lf, vb, fn.body, []) && !counted_ret_value(lf, fn, structs, arr_fresh, fwd, sfok, acc)) {
      return false;
    }
  }
  return true;
}

// counted_handback_param: `name` is a non-own parameter or the receiver of
// `fn`, of its return type, never reassigned or redeclared in the body — the
// shape ret_struct_param_counted retains at `return name`.
function counted_handback_param(fn: parser.FuncDecl, name: string): boolean {
  if (name.len() == 0 || irtables.local_decl_count(fn.body, name) != 0) {
    return false;
  }
  if (util.index_of_str(irtables.body_assign_targets(fn.body), name) >= 0) {
    return false;
  }
  if (fn.receiver_name.len() > 0 && name == fn.receiver_name) {
    return util.base_type_name(fn.receiver_type) == util.base_type_name(fn.ret_type);
  }
  for pd in fn.params {
    if (pd.name == name) {
      return !pd.own && pd.type_name == fn.ret_type;
    }
  }
  return false;
}

// counted_forward_key: the registry key of a forwarding return's callee, "" for
// a callee this frame shadows or a receiver of unknown type.
function counted_forward_key(e: ast.Expr, fn: parser.FuncDecl, structs: irtables.StructTab): string {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      if (decl_type_in_fn(fn, cid.name).len() > 0 || body_declares_name(fn.body, cid.name)) {
        return "";
      }
      return cid.name;
    }
    if let ast.ExprFieldAccess(fa) = c.callee {
      var rt: string = util.base_type_name(decl_type_in_fn(fn, ident_name_or_empty(fa.obj)));
      if (rt.len() == 0 || !irtables.decl_is_struct(structs, rt)) {
        return "";
      }
      return rt + "." + fa.field;
    }
  }
  return "";
}

// --- consumed scalar-payload enum scrutinee free (Perceus) -------------------
//
// The simplest SOUND enum-box reclamation: a function-local `var x = V(args...)`
// of an enum ALL of whose variants carry ONLY scalar payloads (no array/string/
// struct/nested/option/tuple/map field → the box needs NO per-variant deep-drop)
// that is CONSUMED by exactly one `match (x) { ... }` where x is single-owner and
// DEAD after the match. The match reads the scalar payloads as BORROWS (struct_get
// copies them into their own slots) BEFORE the bodies run, and never decs the box,
// so after the match statement the box is the sole reference in x's slot and can be
// freed: dec + zero the slot (mirrors the array precise-drop), SOUND now that
// op_struct_make gives the box an rc header. Anything not provably this shape is
// left to leak (sound). Conservative + deterministic — a mis-classified free is a
// use-after-free that breaks the byte-identical fixpoint.

// enum_variant_scalar_payload: every payload field of variant struct `vname` is a
// flat scalar (i32/boolean/i64/f64/u32/u64). A no-payload (0-field) variant
// trivially qualifies. The shape-ptr is at slot 0; payload fields are __ev, __ev1…
function enum_variant_scalar_payload(structs: irtables.StructTab, vname: string): boolean {
  var n: i32 = irtables.decl_field_count(structs, vname);
  var fi: i32 = 0;
  while (fi < n) {
    if (!reuse_field_is_scalar(irtables.decl_field_type_at(structs, vname, fi))) {
      return false;
    }
    fi = fi + 1;
  }
  return true;
}

// enum_all_variants_scalar: every variant of enum `enum_name` (every struct whose
// enum_owner == enum_name) has only scalar payloads. False if the enum has no
// variants (defensive — never a free candidate then).
function enum_all_variants_scalar(structs: irtables.StructTab, enum_name: string): boolean {
  var any: boolean = false;
  for sd in structs.decls {
    if (sd.enum_owner == enum_name) {
      any = true;
      if (!enum_variant_scalar_payload(structs, sd.name)) {
        return false;
      }
    }
  }
  return any;
}

// fresh_scalar_enum_init: `e` is a sole-owner construction of an all-scalar enum —
// a call `V(args...)` whose callee V is a variant ctor of such an enum, OR a bare
// unit variant `V` (an ExprIdent resolving to a 0-field variant struct). Returns
// the enum's name, or "" if not.
function fresh_scalar_enum_init(e: ast.Expr, structs: irtables.StructTab): string {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          var owner: string = variant_enum_owner(structs, id.name);
          if (owner != "" && enum_all_variants_scalar(structs, owner)) {
            return owner;
          }
          return "";
        },
        ast.ExprFieldAccess(fa) => {
          // Qualified ctor `Enum.Variant(args...)` — resolve by field name.
          var ownerq: string = variant_enum_owner(structs, fa.field);
          if (ownerq != "" && enum_all_variants_scalar(structs, ownerq)) {
            return ownerq;
          }
          return "";
        },
        _ => {
          return "";
        }
      }
    },
    ast.ExprIdent(id) => {
      var owner2: string = variant_enum_owner(structs, id.name);
      if (owner2 != "" && enum_all_variants_scalar(structs, owner2)) {
        return owner2;
      }
      return "";
    },
    ast.ExprFieldAccess(fa) => {
      // Qualified bare UNIT variant `Enum.Variant` (no call).
      var owner3: string = variant_enum_owner(structs, fa.field);
      if (owner3 != "" && enum_all_variants_scalar(structs, owner3)) {
        return owner3;
      }
      return "";
    },
    _ => {
      return "";
    }
  }
}

// --- consumed RC-PAYLOAD enum free (deep-drop at the free site) -------------
//
// The scalar-enum free above only admits enums whose variant payloads are all
// flat scalars: a single __fern_rc_dec on the box buffer is the whole free. This
// widens that to enums whose variants carry an RC-TRACKED payload that a SINGLE
// __fern_rc_dec fully releases — a leak-safe scalar array
// (i32[]/i64[]/f64[]/boolean[]; a flat rc-headered element buffer, exactly the
// types emit_struct_field_drops already deep-drops on a struct's reclamation).
//
// A `string` payload IS eligible, and a nested struct is too — see
// enum_field_rc_droppable, which admits `t == "string"` (#4355) and a
// deep-drop-ok or scalar-only nested struct. String boxes have been rc-HEADERED
// since #4294 and are released by the rc-aware __fern_str_free (box + separate
// data buffer on asm, one inline block on wasm), with
// variant_struct_payloads_fresh keeping the payload the box's sole owner. This
// paragraph used to say the opposite at length — that a string was a raw
// __fern_alloc(16) fat pointer with no rc header, so decing one would mis-free —
// which was true before #4294 and has been wrong ever since.
//
// Still EXCLUDED: string[] / enum / map / option / tuple payloads, whose buffers
// hold pointers needing an element walk a shallow dec does not perform. At the free the
// runtime variant of x is unknown, so per variant V with an rc payload we emit a
// `variant_is(box, V)` guard that struct_gets + decs exactly V's rc fields, then
// the box dec — a runtime variant-dispatch deep-drop (emit_enum_variant_drops).
//
// SOUNDNESS GATE (problem-2, the trivial-and-sound starting point): the candidate
// is REJECTED if ANY arm BINDS an rc-typed payload variable (a non-`_` binding at
// an rc payload field position). When no arm names the rc payload, the payload can
// never escape the arm — the box still solely owns it — so deep-dropping it at the
// free is sound (no use-after-free / double-free). Borrow-only escape analysis is
// deliberately sidestepped. Scalar payloads may be bound freely (they are copied,
// not rc-tracked); only the rc payload binding is forbidden.
//
// DISJOINTNESS: this set is kept entirely SEPARATE from consumed_scalar_enum_frees
// and is NOT passed to enum_donor_reuse_sites, so an rc-payload box can never be
// donated (the donor path overwrites fields without dropping old values — sound
// only for scalar donors) and is freed by exactly one deep-drop here.

// enum_field_rc_droppable: a payload field type whose value is an rc-headered box
// the match-consume reclaim can release — a leak-safe scalar array
// (i32[]/i64[]/f64[]/boolean[], freed by one __fern_rc_dec), a deep-drop-ok
// nested struct (Perceus enum-payload slice: an rc-array-carrying LEAF struct,
// released by __struct_drop_<T> + a box dec, the same depth-1 recursion the
// struct-field deep-drop uses — see emit_enum_variant_drops), OR a STRING (#4355:
// string boxes are rc-HEADERED since #4294, released by the rc-aware
// __fern_str_free — box + separate data buffer on asm, one inline block on wasm;
// the freshness gate in variant_struct_payloads_fresh keeps the payload the box's
// sole owner), OR a string[] (deep-freed by __fern_str_arr_free, under the same
// freshness gate), OR a map (released by nothing, see below), OR a closure (one
// rc-guarded dec of the env box; lower_variant_ctor_args counts every closure
// payload, so the box always holds a claim of its own). NOT a scalar (no rc —
// released with the box), NOT enum / opt / tuple, and NOT a non-leaf (cycle-risk)
// struct.
function enum_field_rc_droppable(structs: irtables.StructTab, t: string): boolean {
  // An ENUM-array payload (`Seq(N[])`, including the self-referential shape a
  // tree enum is built from): `__fern_arrarr_free` rc-guards the buffer, decs
  // each element BOX, then frees the buffer. That is the one-level model the
  // struct-array path already uses — an element's own payload survives one
  // level down, which leaks rather than dangles (#6758).
  //
  // Admitting it is what unblocks the whole enum: enum_all_variants_rc_droppable
  // bails on the first non-droppable variant, so `Seq(N[])` was taking the
  // scalar `Leaf(i32)` variant down with it and neither was reclaimed.
  // A string[] payload: __fern_str_arr_free decs each element string and then
  // frees the buffer — the deep free the struct-field k_str_arr arm already
  // uses. Fresh-gated at admission (variant_struct_payloads_fresh requires an
  // array literal of fresh elements), so the enum is the sole owner.
  return irtables.is_enum_array_field_type(structs, t) || irtables.is_leaksafe_array_field(t) || t == "string" || t == "string[]"
    || irtables.decl_is_struct(structs, t) && irtables.nested_field_deep_drop_ok(structs, t)
    // #4355 slice 8: a SCALAR-ONLY struct payload (`S { m: i32, n: i32 }`)
    // is one flat rc-headered box with no inner rc fields — released by a
    // single __fern_rc_dec, exactly like a leak-safe array. Fresh-gated at
    // admission (variant_struct_payloads_fresh requires a fresh struct
    // LITERAL for this arm too), so the box is the sole owner.
    || irtables.decl_is_struct(structs, t) && struct_lit_all_scalar(structs, t)
    // A MAP payload is admitted and released by nothing: a map box carries no
    // count, so no drop here could tell whether the enum is its only holder,
    // and it leaks as it always did. Refusing it instead turned off the whole
    // enum's release, every other variant's payloads with it (#9304).
    || is_map_type_name(t)
    || t == "fn";
}

// enum_variant_rc_droppable: every payload field of variant `vname` is either a
// flat scalar (reuse_field_is_scalar — no rc, dropped by box free) or rc-droppable
// (enum_field_rc_droppable). A field outside both bails the whole enum.
function enum_variant_rc_droppable(structs: irtables.StructTab, vname: string): boolean {
  var n: i32 = irtables.decl_field_count(structs, vname);
  var fi: i32 = 0;
  while (fi < n) {
    var t: string = irtables.decl_field_type_at(structs, vname, fi);
    if (!reuse_field_is_scalar(t) && !enum_field_rc_droppable(structs, t)) {
      return false;
    }
    fi = fi + 1;
  }
  return true;
}

// enum_variant_has_rc_payload: variant `vname` has at least one rc-droppable
// payload field (string / leak-safe array) — the field(s) the deep-drop releases.
function enum_variant_has_rc_payload(structs: irtables.StructTab, vname: string): boolean {
  var n: i32 = irtables.decl_field_count(structs, vname);
  var fi: i32 = 0;
  while (fi < n) {
    if (enum_field_rc_droppable(structs, irtables.decl_field_type_at(structs, vname, fi))) {
      return true;
    }
    fi = fi + 1;
  }
  return false;
}

// enum_arr_release_walk_ok: the enum-array element release may run for E —
// either the payload walk is provably balanced (enum_arr_elems_walk_ok), or
// every variant's payloads are scalar, where the release degenerates to a
// box-only free per element with no payload dec to protect (#7678: without
// it an all-scalar enum array stranded every element box). A wrapper on
// purpose: enum_arr_elems_walk_ok keeps its meaning, so the field-walk
// emitters keyed on it emit no empty-dispatch helper for the scalar case.
pub function enum_arr_release_walk_ok(structs: irtables.StructTab, ename: string): boolean {
  if (irtables.enum_arr_elems_walk_ok(structs, ename)) {
    return true;
  }
  return irtables.decl_is_enum(structs, ename) && enum_all_variants_scalar(structs, ename);
}

// enum_all_variants_rc_droppable: every variant of `enum_name` is rc-droppable AND
// at least one variant actually carries an rc payload. The second clause keeps this
// set DISJOINT from the all-scalar set (enum_all_variants_scalar) — a pure-scalar
// enum is handled by consumed_scalar_enum_frees, not here.
function enum_all_variants_rc_droppable(structs: irtables.StructTab, enum_name: string): boolean {
  var any: boolean = false;
  var rc: boolean = false;
  for sd in structs.decls {
    if (sd.enum_owner == enum_name) {
      any = true;
      if (!enum_variant_rc_droppable(structs, sd.name)) {
        return false;
      }
      if (enum_variant_has_rc_payload(structs, sd.name)) {
        rc = true;
      }
    }
  }
  return any && rc;
}

// variant_struct_payloads_fresh: every deep-drop-ok STRUCT payload arg of this
// variant construction `V(args...)` is a fresh struct LITERAL (sole-owned). The
// enum reclaim deep-drops such a payload at the consuming match; a bare-ident / call
// payload would alias a local whose own exit-sweep ALSO deep-drops it → a double-free
// of the payload's inner buffers (the variant-construction alias-inc protects only
// the box pointer, not the rc fields one level down — the exact hazard the struct-
// field deep-drop guards with the same fresh-literal rule). Array payloads are exempt
// here: their bare-ident aliasing IS balanced by the construction array alias-inc, so
// they stay admissible. A non-struct / non-deep-drop-ok field imposes no constraint.
// `str_fresh` is str_fresh_ret_fns (whole-program fresh-string producers, #7364) —
// pass [] where the registry is out of reach and only the syntactic set applies.
function variant_struct_payloads_fresh(args: ast.Expr[], variant_name: string, structs: irtables.StructTab, str_fresh: string[], msites: string[], counted: boolean): boolean {
  var n: i32 = irtables.decl_field_count(structs, variant_name);
  var i: i32 = 0;
  while (i < n && i < args.len()) {
    var ft: string = irtables.decl_field_type_at(structs, variant_name, i);
    // Deep-drop-ok OR scalar-only struct payloads (#4355 slice 8) both get
    // released at the consuming match, so both must be FRESH struct
    // literals — a bare-ident payload aliases a local whose own sweep
    // would double-free the box.
    if (irtables.decl_is_struct(structs, ft)
      && (irtables.nested_field_deep_drop_ok(structs, ft) || struct_lit_all_scalar(structs, ft))) {
      var fresh: boolean = false;
      match (args[i]) {
        ast.ExprStructLit(_) => {
          fresh = true;
        },
        _ => {}
      }
      // A bare ident the store MOVES qualifies too, and NOT for the reason
      // the fresh-literal rule above states. There is no sweep to double-free:
      // struct_box_sink_stored_expr already refuses a variant-ctor argument its
      // struct credit, so the source releases nothing. What a move adds is that
      // the source's VALUE is dead after this store, which is what makes the
      // enum the only reader and its payload drop the one release.
      if (!fresh && moved_ident_at(args[i], msites)) {
        fresh = true;
      }
      // A COUNTED payload: the construction retained this box
      // (lower_variant_ctor_args, same predicate), so the enum holds a claim
      // of its own and its release is balanced whether or not the source
      // stays live. Admissible ONLY to callers whose release is rc-gated —
      // emit_enum_variant_payload_drops walks the payload under
      // __fern_rc_is_unique — which is what `counted` asserts. The
      // sole-ownership consumers (struct_lit_all_enum_fields_fresh and the
      // two registry scans) pass false: their premise is rc == 1 and no
      // construction alias-inc, which a retained payload contradicts by
      // definition.
      if (!fresh && counted && variant_counted_struct_payload(args[i], ft, structs)) {
        fresh = true;
      }
      if (!fresh) {
        return false;
      }
    }
    // A STRING payload (#4355) must be FRESH too — a literal (const_str allocs
    // a fresh box per construction; its .rodata data is heap-guard-skipped by
    // __fern_str_free) or a fresh producer (concat / named producer / string
    // method copy). A bare ident / field read / general call would alias a
    // live box the match-site __fern_str_free would free out from under it.
    if (ft == "string") {
      var sfresh: boolean = false;
      match (args[i]) {
        ast.ExprString(_) => {
          sfresh = true;
        },
        ast.ExprCall(c2) => {
          // A CALL to a whole-program-proven fresh-string producer
          // (str_fresh_ret_fns — every return a fresh sole-owned box)
          // hands the variant its only reference, exactly like a concat
          // (#7364). Bare rows only: the "SFR*:"-tagged method rows can
          // never equal a bare callee name.
          match (c2.callee) {
            ast.ExprIdent(cid2) => {
              sfresh = util.index_of_str(str_fresh, cid2.name) >= 0;
            },
            _ => {}
          }
          if (!sfresh) {
            sfresh = str_local_binding_is_fresh(args[i]);
          }
        },
        _ => {
          sfresh = str_local_binding_is_fresh(args[i]);
        }
      }
      if (!sfresh) {
        return false;
      }
    }
    // A string[] payload must be an array literal of fresh elements, for the
    // reason the string arm states: the match-site __fern_str_arr_free frees
    // each element, so a bare ident / field read would alias boxes a live
    // local still owns.
    if (ft == "string[]" && !strarr_lit_all_elems_fresh_reg(args[i], str_fresh)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// fresh_rcpayload_enum_init: `e` is a sole-owner construction of an rc-payload
// (deep-droppable) enum — `V(args...)` or a bare unit variant `V`. Returns the
// enum's name, or "". Mirrors fresh_scalar_enum_init for the widened set. A
// deep-drop-ok STRUCT payload must be a fresh struct literal and a STRING payload a
// fresh literal/producer (variant_struct_payloads_fresh) so the match-site drop
// can't double-free a local the payload aliases; array payloads take the
// construction alias-inc and need no such gate.
function fresh_rcpayload_enum_init(e: ast.Expr, structs: irtables.StructTab, str_fresh: string[], msites: string[], counted: boolean): string {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          var owner: string = variant_enum_owner(structs, id.name);
          if (owner != "" && enum_all_variants_rc_droppable(structs, owner)
            && variant_struct_payloads_fresh(c.args, id.name, structs, str_fresh, msites, counted)) {
            return owner;
          }
          return "";
        },
        ast.ExprFieldAccess(fa) => {
          // Qualified ctor `Enum.Variant(args...)` — the callee is a field
          // access (obj=Enum, field=Variant), not a bare ident. Resolve the
          // variant by its field name, same gates. Without this a qualified-style
          // construction never reaches the consume-by-match reclaim (the box +
          // payload leak), unlike the unqualified form.
          var ownerq: string = variant_enum_owner(structs, fa.field);
          if (ownerq != "" && enum_all_variants_rc_droppable(structs, ownerq)
            && variant_struct_payloads_fresh(c.args, fa.field, structs, str_fresh, msites, counted)) {
            return ownerq;
          }
          return "";
        },
        _ => {
          return "";
        }
      }
    },
    ast.ExprIdent(id) => {
      var owner2: string = variant_enum_owner(structs, id.name);
      if (owner2 != "" && enum_all_variants_rc_droppable(structs, owner2)) {
        return owner2;
      }
      return "";
    },
    ast.ExprFieldAccess(fa) => {
      // Qualified bare UNIT variant `Enum.Variant` (no call) — a payload-free init,
      // admitted for parity with the unqualified unit case (the reclaim is a runtime
      // variant_is no-op for a unit box, but keeps the analysis uniform).
      var owner3: string = variant_enum_owner(structs, fa.field);
      if (owner3 != "" && enum_all_variants_rc_droppable(structs, owner3)) {
        return owner3;
      }
      return "";
    },
    _ => {
      return "";
    }
  }
}

// binding_escapes_arm reports whether the arm-bound rc payload `name` escapes its
// arm: it is used anywhere in the arm body or guard in a position other than a
// borrow read. Reuses the precise-drop escape family (body_unsafe_for /
// expr_unsafe_for) with an EMPTY borrowable registry, so every call argument is
// conservatively a retain (escape). A borrow-only binding (indexing, `.len()`,
// arithmetic over reads) returns false and is admitted.
function binding_escapes_arm(arm: ast.MatchArm, name: string, borrowable: string[]): boolean {
  if (arm.has_guard && expr_unsafe_for(arm.guard, name, borrowable, [])) {
    return true;
  }
  return body_unsafe_for(arm.body, name, borrowable, []);
}

// payload_binding_escapes_arm: binding_escapes_arm for an rc payload of type
// `ft`. A closure payload called directly (`name(args)`) is borrowed for the
// call, so only a mention that is not such a call — a capture included —
// escapes.
function payload_binding_escapes_arm(arm: ast.MatchArm, name: string, ft: string): boolean {
  if (ft != "fn") {
    return binding_escapes_arm(arm, name, no_names());
  }
  return clo_binding_other_uses(arm, name, false, no_names()) > 0;
}

// clo_binding_other_uses: the mentions of closure binding `name` in `arm` that
// are neither a direct call `name(args)`, nor a bare `name` argument at a
// position `borrowable` says the callee only reads, nor, when `returns` is set,
// a bare `return name` — which retains the box (ret_closure_uncounted). A
// capture by a lambda counts.
function clo_binding_other_uses(arm: ast.MatchArm, name: string, returns: boolean, borrowable: string[]): i32 {
  function at_expr(e: ast.Expr, own n: i32): i32 {
    if let ast.ExprCall(c) = e {
      var cn: string = ident_name_or_empty(c.callee);
      if (cn == name) {
        return n + 1;
      }
      return n + borrowed_arg_count(c, cn, name, borrowable);
    }
    return n;
  }
  function at_stmt(st: ast.Stmt, own n: i32): i32 {
    if let ast.StmtReturn(r) = st {
      if (returns && ident_name_or_empty(r.value) == name) {
        return n + 1;
      }
    }
    return n;
  }
  var mentions: i32 = astwalk.count_ident_stmts(arm.body, name);
  var borrows: i32 = 0;
  for st in arm.body {
    borrows = astwalk.fold_stmt_nodes(st, borrows, at_stmt, at_expr, astwalk.not_lambda);
  }
  if (arm.has_guard) {
    mentions = mentions + astwalk.count_ident_expr(arm.guard, name);
    borrows = astwalk.fold_expr_pruned(arm.guard, borrows, at_expr, astwalk.not_lambda);
  }
  return mentions - borrows;
}

// borrowed_arg_count: the bare `name` arguments of call `c`, to the free
// function `cn`, at positions `borrowable` marks as only read.
function borrowed_arg_count(c: ast.ExprCall, cn: string, name: string, borrowable: string[]): i32 {
  var n: i32 = 0;
  if (cn.len() == 0) {
    return n;
  }
  var ai: i32 = 0;
  while (ai < c.args.len()) {
    if (ident_name_or_empty(c.args[ai]) == name && param_is_borrowable(borrowable, cn, ai)) {
      n = n + 1;
    }
    ai = ai + 1;
  }
  return n;
}

// --- enum self-reassign deep-drop (Perceus: close the reassigned-enum payload leak) ---
//
// A loop-carried enum with a scalar-ARRAY payload — `var b: E = V0([..]); while (..) {
// b = V1([..]); b = V2([..]); }` — leaks the superseded variant's payload array on the
// register backends (box-only shallow free; a 50M-iter churn OOMs on x86). This routes
// such a reassign through a variant-dispatch DEEP-DROP of the OLD box before storing the
// new one. On WASM this pattern is already reclaimed (verified flat), so the extra dec is
// a rc-GUARDED no-op there (arr_dec on an already-released buffer bumps the underflow
// detector without re-freeing). SOUND only when b's payload is never aliased AND every
// variant payload is a leak-safe SCALAR ARRAY (single arr_dec fully releases it — NOT a
// nested struct, whose __struct_drop would double-free a shared payload). The reassign
// RHS is always a FRESH variant ctor, so the new box never equals the old — no cow guard.

// variant_ctor_qualified_name: the VARIANT a qualified construction `E.V(args)`
// / bare `E.V` names, or "". The structs-only sibling of qualified_variant_enum
// (which needs a LowerState for its shadowing check): the field must be a
// variant and the object the bare name of the enum that owns it, so a method
// call `o.v(…)` cannot pass by naming a receiver after its own enum.
function variant_ctor_qualified_name(fa: ast.ExprFieldAccess, structs: irtables.StructTab): string {
  var owner: string = variant_enum_owner(structs, fa.field);
  if (owner == "") {
    return "";
  }
  match (fa.obj) {
    ast.ExprIdent(eid) => {
      if (eid.name == owner) {
        return fa.field;
      }
    },
    _ => {}
  }
  return "";
}

// variant_ctor_enum_owner: the enum E a variant-constructor expr `V(args)` /
// bare `V` — or the qualified `E.V(args)` / `E.V` spelling of either — belongs
// to, or "". Both spellings build the same fresh rc=1 box, so every gate that
// asks "is this a fresh variant construction?" must read them the same way; the
// qualified one going unrecognised left a struct literal's enum field retained
// as if it aliased, leaking one box per construction (#6681).
function variant_ctor_enum_owner(e: ast.Expr, structs: irtables.StructTab): string {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(id) => {
          return variant_enum_owner(structs, id.name);
        },
        ast.ExprFieldAccess(cfa) => {
          return variant_enum_owner(structs, variant_ctor_qualified_name(cfa, structs));
        },
        _ => {
          return "";
        }
      }
    },
    ast.ExprIdent(id) => {
      return variant_enum_owner(structs, id.name);
    },
    ast.ExprFieldAccess(fa) => {
      return variant_enum_owner(structs, variant_ctor_qualified_name(fa, structs));
    },
    _ => {
      return "";
    }
  }
}

// --- consumed RC-PAYLOAD option/result deep-drop free -----------------------
//
// The Option/Result analogue of consumed_rcpayload_enum_frees. The scalar
// Option/Result free (consumed_scalar_enum_frees via fresh_scalar_option_init)
// only admits a SCALAR payload — a `var o = Some([1,2,3])` / `var r = Ok([..])`
// with a leak-safe scalar-ARRAY payload still leaked both the box AND its array.
// This widens the consume-by-match free to those: the constructed variant is
// statically known, so the box's payload (offset 8 / 4 via op_opt_payload) is a
// flat rc-headered scalar buffer a single __fern_rc_dec fully releases, then the
// box itself is freed. DISJOINT from the scalar option set (that admits only
// scalar payloads; this only array payloads), so an option is freed by at most
// one path — never double-freed.

// ── The arm binding may MOVE a field out, and only the DEEP drop cares (#6127) ──
//
// `binding_escapes_arm` proves the arm does not let the payload STRUCT BOX
// outlive the match, which is all the shallow box dec needs. The deep drop frees
// the box's rc FIELDS as well, so it needs the stronger property: no field of the
// binding is extracted whole. `match (o) { Some(p) => { held = p.xs; } … }` passes
// the box-level gate — `p` itself never escapes — while handing `held` the buffer
// the deep drop would free, a use-after-free the freelist hides.
//
// So this walker gates ONLY the deep-drop upgrade: a moved field downgrades the
// drop back to the shallow box dec (today's sound leak), it never withdraws the
// candidate. Same borrow vocabulary as rctuple_esc_expr, rooted one level up at a
// bare local's field (`name.<f>`) instead of a tuple element (`name.<i>`).
// SAFE: a scalar field read `name.<f>` (value copy), an indexed array-field read
// `name.<f>[j]`, and `name.<f>.len()`. ESCAPES: a bare `name`, and a bare
// non-scalar field `name.<f>`. Erring toward escape leaks; erring the other way
// dangles, so unknown shapes fall to the generic recursion and escape.
// optstruct_chain_leaf_type: the field TYPE `e` reads when it is a pure field-
// access CHAIN rooted at the bare local `name` of struct type `sty` —
// `name.<f>` gives f's type, `name.<f>.<g>` gives g's type (f borrowed as the
// receiver), to any depth. Returns "" when `e` is not such a chain, and "?" when
// it IS one but a link could not be resolved (an unknown field, or a non-struct
// intermediate), which the caller must treat as an escape.
//
// The one-level version of this refused `p.inner.ys.len()`: the chain fell
// through to the generic call tail, which reached the bare-ident arm through
// `p.inner` and reported the non-scalar field `inner` extracted. Reaching `ys`
// THROUGH `inner` retains only ys's box, so `inner` is borrowed — the same
// distinction structfld_safe_operand draws for the whole-program scan, and the
// reason that scan could not reuse the string walker either (#6274).
function optstruct_chain_leaf_type(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab): string {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(oid) => {
          if (oid.name != name) {
            return "";
          }
          var t0: string = irtables.decl_field_type(structs, sty, fa.field);
          if (t0.len() == 0) {
            return "?";
          }
          return t0;
        },
        _ => {
          var mid: string = optstruct_chain_leaf_type(fa.obj, name, sty, structs);
          if (mid.len() == 0) {
            return "";
          }
          if (mid == "?") {
            return "?";
          }
          if (!irtables.decl_is_struct(structs, mid)) {
            return "?";
          }
          var t1: string = irtables.decl_field_type(structs, mid, fa.field);
          if (t1.len() == 0) {
            return "?";
          }
          return t1;
        }
      }
    },
    _ => {
      return "";
    }
  }
}

// declared_struct_type_of: the DECLARED struct type of local `name` — the type
// fresh_struct_lit_type_deep cannot supply, because it reads the type off a struct
// LITERAL init and the shapes that matter here are bound from a CALL
// (`var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, ..)`). Resolves the
// qualified spelling too: `a.B` is tried as written, then as the mangled `a__B`,
// then as the bare tail `B`. "" when the name is not a struct-annotated local.
function declared_struct_type_of(stmts: ast.Stmt[], name: string, structs: irtables.StructTab): string {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name && v.type_name.len() > 0) {
          if (irtables.decl_is_struct(structs, v.type_name)) {
            return v.type_name;
          }
          var dot: i32 = 0 - 1;
          var c: i32 = 0;
          while (c < v.type_name.len()) {
            if (v.type_name[c] == b'.') {
              dot = c;
            }
            c = c + 1;
          }
          if (dot > 0) {
            var head: string = slice_unchecked(v.type_name, 0, dot) + "";
            var tail: string = slice_unchecked(v.type_name, dot + 1, v.type_name.len()) + "";
            var mangled: string = head + "__" + tail;
            if (irtables.decl_is_struct(structs, mangled)) {
              return mangled;
            }
            if (irtables.decl_is_struct(structs, tail)) {
              return tail;
            }
          }
        }
      },
      ast.StmtIf(f) => {
        var t1: string = declared_struct_type_of(f.then_body, name, structs);
        if (t1 != "") {
          return t1;
        }
        var t2: string = declared_struct_type_of(f.else_body, name, structs);
        if (t2 != "") {
          return t2;
        }
      },
      ast.StmtWhile(w) => {
        var t: string = declared_struct_type_of(w.body, name, structs);
        if (t != "") {
          return t;
        }
      },
      ast.StmtFor(fo) => {
        var t: string = declared_struct_type_of(fo.body, name, structs);
        if (t != "") {
          return t;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          var t: string = declared_struct_type_of(arm.body, name, structs);
          if (t != "") {
            return t;
          }
        }
      },
      _ => {}
    }
  }
  return "";
}

// --- fieldmove: which POSITIONS actually move a field out (#6127) -----------
//
// The "NODEEP:" marker needs to know when a local's NON-SCALAR field is handed to
// something longer-lived — `var lo: StringLitOut = add_string_lit(s, ..); s =
// lo.state;`, where the deep drop would then free that EmitState's arrays out
// from under the live `s`.
//
// This is deliberately a POSITIVE list of move positions, not a general escape
// walker with borrow exemptions. The first cut reused optstruct_bind_esc_expr
// (#6336), which reports every bare non-scalar field read and admits a whitelist
// of borrows — and that polarity is wrong for a WHOLE-FUNCTION scan: it fired on
// `match (t.e)` (withholding #4357's per-iteration struct-enum reclaim, an 80
// bytes/iteration leak) and on `h.f(10)` (withholding the k_clo drop for every
// called fn-field struct), and each fix added another exemption. The borrow
// positions are open-ended; the MOVE positions are not.
//
// A move is a chain rooted at `name` whose leaf field is non-scalar, appearing as
// the WHOLE value of a bind / assign / return, as a direct call ARGUMENT, or as a
// container element. Every other position — a match scrutinee, a call callee, an
// index base, a `.len()` receiver, an operand — reads through and is a borrow.
function fieldmove_is_move_value(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab, borrowable: string[]): boolean {
  var lt: string = optstruct_chain_leaf_type(e, name, sty, structs);
  if (lt.len() == 0) {
    return false;
  }
  if (lt == "?") {  // unresolved chain — assume the worst
    return true;
  }
  return !irtables.is_scalar_type_name(lt);
}

// fieldmove_expr: the move positions reachable inside an expression — a call
// argument the callee may retain, or an element of an array / tuple / struct
// literal (including a functional-update base, which copies every field pointer
// into the new box).
//
// A BORROWABLE param position is not a move: `borrowable_params_of` admits a
// param only when the callee provably never returns, stores, slices or captures
// it, so `f(o.inner)` there leaves the field owned by `o` alone and the deep
// drop stays sound. Same registry and same Level-2 rule expr_unsafe_for already
// applies to a bare-ident argument — which it trusts for caller-side FREES, a
// strictly stronger action than keeping a deep drop. Without it a single
// `tag(o.v)` cost the local its whole reclaim credit, so every superseded box
// AND its array buffers leaked per iteration, where native is flat (#6691).
function fieldmove_expr(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab, borrowable: string[]): boolean {
  match (e) {
    ast.ExprCall(c) => {
      // Free calls only: method-param borrowability is not in the
      // (free-function-keyed) registry, so a method arg keeps marking. A
      // counted-retain position ("CNT:") is no move either: the callee
      // takes a count of its own, so the deep drop stays balanced (#9203).
      var callee_name: string = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          callee_name = cid.name;
        },
        _ => {}
      }
      var ai: i32 = 0;
      while (ai < c.args.len()) {
        if (callee_name.len() == 0 || !(param_is_borrowable(borrowable, callee_name, ai)
          || param_is_borrowable(borrowable, "CNT:" + callee_name, ai))) {
          if (fieldmove_is_move_value(c.args[ai], name, sty, structs, borrowable)) {
            return true;
          }
        }
        if (fieldmove_expr(c.args[ai], name, sty, structs, borrowable)) {
          return true;
        }
        ai = ai + 1;
      }
      return fieldmove_expr(c.callee, name, sty, structs, borrowable);
    },
    ast.ExprArray(a) => {
      var i: i32 = 0;
      while (i < a.elements.len()) {
        if (fieldmove_is_move_value(a.elements[i], name, sty, structs, borrowable)) {
          return true;
        }
        if (fieldmove_expr(a.elements[i], name, sty, structs, borrowable)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        // An array field read is a counted share: the tuple literal
        // retains it unconditionally (tuple_field_share_kind), unlike
        // the struct literal below, whose string and string[] retains
        // are gated and so stay marked.
        if (tuple_field_share_kind(el).len() == 0
          && fieldmove_is_move_value(el, name, sty, structs, borrowable)) {
          return true;
        }
        if (fieldmove_expr(el, name, sty, structs, borrowable)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprStructLit(sl) => {
      if (sl.has_base) {
        if (fieldmove_is_move_value(sl.base, name, sty, structs, borrowable)) {
          return true;
        }
        if (fieldmove_expr(sl.base, name, sty, structs, borrowable)) {
          return true;
        }
      }
      for fv in sl.field_values {
        // A `name.<f>` value of a kind whose construction retain is
        // GUARANTEED (fieldmove_counted_field_alias's list — nested
        // struct, enum, leak-safe scalar array, struct array) is a
        // COUNTED share: the literal incs it, so the source keeps its
        // deep drop and both decs balance. Marking it a move withheld
        // the source's drop while the retained claim stood — the arr
        // buffer leaked at rc 1 (the construction-retain matrix's
        // fieldread column, i32[]/struct/struct[] flavors). Call args
        // and returns keep marking: no retain is guaranteed there.
        if (!fieldmove_counted_field_alias(fv, name, sty, structs)
          && fieldmove_is_move_value(fv, name, sty, structs, borrowable)) {
          return true;
        }
        if (fieldmove_expr(fv, name, sty, structs, borrowable)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprBinary(b) => {
      return fieldmove_expr(b.left, name, sty, structs, borrowable) || fieldmove_expr(b.right, name, sty, structs, borrowable);
    },
    ast.ExprUnary(u) => {
      return fieldmove_expr(u.operand, name, sty, structs, borrowable);
    },
    ast.ExprIndex(ix) => {
      return fieldmove_expr(ix.array, name, sty, structs, borrowable) || fieldmove_expr(ix.index, name, sty, structs, borrowable);
    },
    ast.ExprSlice(sl2) => {
      return fieldmove_expr(sl2.array, name, sty, structs, borrowable) || fieldmove_expr(sl2.start, name, sty, structs, borrowable) || fieldmove_expr(sl2.end, name, sty, structs, borrowable);
    },
    ast.ExprFieldAccess(fa) => {
      return fieldmove_expr(fa.obj, name, sty, structs, borrowable);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// fieldmove_counted_field_alias: `e` is exactly `name.<f>`, where f is a field
// whose struct-literal retain is GUARANTEED — so a read of it into ANY struct
// literal is a COUNTED share: the literal incs the value, the source keeps its
// deep drop, and both decs balance against the one inc. Treating such a read
// as a move costs `name` its whole reclaim credit (#6623) — and, generalized
// past the self-rebind (`name = T { …, f: name.f, … }`) to every literal
// position, withheld the SOURCE's drop while the retained claim stood, so the
// shared buffer leaked at rc 1 (the construction-retain matrix's fieldread
// column). Call-arg and return positions keep marking: no retain is
// guaranteed there.
//
// Three field kinds qualify, each because its arm of the override path incs a field
// READ with no further condition:
//
//   - a nested-struct or enum field, whose arms inc anything that is not a fresh
//     literal / ctor — which a field read never is;
//   - a scalar-element or array-of-struct field, whose ExprFieldAccess arm incs on
//     `field_access_arr_field_type` resolving. It cannot silently decline: an
//     unresolved receiver leaves `fav_ok` false and BAILS the whole lowering rather
//     than emitting an uncounted store, so there is no third outcome to guard (#6628).
//
// STRING and `string[]` fields stay marked (the retain is gated on slit_reclaim plus
// a freshness test), and so does an array-of-ENUM field: `Ty[]` enters neither array
// gate, and the fallback retain below them admits only a bare IDENT, so a field read
// there really can reach the successor box uncounted.
function fieldmove_counted_field_alias(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(oid) => {
          if (oid.name != name) {
            return false;
          }
          var ft: string = irtables.decl_field_type(structs, sty, fa.field);
          return irtables.decl_is_struct(structs, ft) || irtables.decl_is_enum(structs, ft)
            || irtables.is_leaksafe_array_field(ft) || irtables.is_struct_array_field_type(structs, ft);
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// fieldmove_counted_arr_return: `e` is exactly `name.<f>` where f is one of the
// rc-ARRAY field kinds StmtReturn hands back WITH the return-transfer dup
// (arrown_ret_type). The escape is therefore COUNTED, and every arm that
// reclaims such a field is rc-guarded — `__fern_arr_dec` and
// `__fern_str_arr_free` both dec a shared buffer instead of freeing it — so the
// deep drop cannot take the buffer out from under the caller.
//
// Marking it a move costs `name` its whole reclaim credit, which is all-or-
// nothing: one field-returning method left every rc field of the struct
// stranded, including fields that method never names (#7259).
function fieldmove_counted_arr_return(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(oid) => {
          if (oid.name != name) {
            return false;
          }
          return arrown_ret_type(structs, irtables.decl_field_type(structs, sty, fa.field));
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// fieldmove_assign_moves: an assignment's value moves a field of `name` out. A
// `t = name.f` read of a STRING field does not: the drop releases f only when
// its type routes field reclaim, and then the reassign retains
// (str_field_reassign_retains), so the read is a counted share either way.
function fieldmove_assign_moves(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab, borrowable: string[]): boolean {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(oid) => {
          if (oid.name == name && irtables.decl_field_type(structs, sty, fa.field) == "string") {
            return false;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return fieldmove_is_move_value(e, name, sty, structs, borrowable) || fieldmove_expr(e, name, sty, structs, borrowable);
}

function fieldmove_stmt(st: ast.Stmt, name: string, sty: string, structs: irtables.StructTab, borrowable: string[]): boolean {
  match (st) {
    ast.StmtVar(v) => {
      // A direct `var t = x.f` init is a BORROW, not a move — the same split
      // structfld_collect_unsafe_stmts (#6274) already draws for the whole-program
      // scan, and for the same reason: the fresh binding dies with the scope, while
      // a REASSIGN `t = x.f` hands the field to a name that outlives it. That is
      // exactly the `s = lo.state` hazard, and dropping this case is what keeps
      // `var xs = r.hs; xs[1]()` deep-drop-worthy.
      return fieldmove_expr(v.init, name, sty, structs, borrowable);
    },
    ast.StmtAssign(a) => {
      // The self-rebind literal keeps its retained field aliases (see
      // fieldmove_counted_field_alias); every other value in it still marks.
      if (a.target == name) {
        match (a.value) {
          ast.ExprStructLit(asl) => {
            if (asl.has_base) {
              if (fieldmove_is_move_value(asl.base, name, sty, structs, borrowable)) {
                return true;
              }
              if (fieldmove_expr(asl.base, name, sty, structs, borrowable)) {
                return true;
              }
            }
            var fi: i32 = 0;
            while (fi < asl.field_values.len()) {
              if (!fieldmove_counted_field_alias(asl.field_values[fi], name, sty, structs)
                && fieldmove_is_move_value(asl.field_values[fi], name, sty, structs, borrowable)) {
                return true;
              }
              if (fieldmove_expr(asl.field_values[fi], name, sty, structs, borrowable)) {
                return true;
              }
              fi = fi + 1;
            }
            return false;
          },
          _ => {}
        }
      }
      return fieldmove_assign_moves(a.value, name, sty, structs, borrowable);
    },
    ast.StmtReturn(r) => {
      if (fieldmove_counted_arr_return(r.value, name, sty, structs)) {
        return false;
      }
      return fieldmove_is_move_value(r.value, name, sty, structs, borrowable) || fieldmove_expr(r.value, name, sty, structs, borrowable);
    },
    ast.StmtExpr(e) => {
      return fieldmove_expr(e.value, name, sty, structs, borrowable);
    },
    ast.StmtIf(f) => {
      if (fieldmove_expr(f.cond, name, sty, structs, borrowable)) {
        return true;
      }
      var ti: i32 = 0;
      while (ti < f.then_body.len()) {
        if (fieldmove_stmt(f.then_body[ti], name, sty, structs, borrowable)) {
          return true;
        }
        ti = ti + 1;
      }
      var ei: i32 = 0;
      while (ei < f.else_body.len()) {
        if (fieldmove_stmt(f.else_body[ei], name, sty, structs, borrowable)) {
          return true;
        }
        ei = ei + 1;
      }
      return false;
    },
    ast.StmtWhile(w) => {
      if (fieldmove_expr(w.cond, name, sty, structs, borrowable)) {
        return true;
      }
      var i: i32 = 0;
      while (i < w.body.len()) {
        if (fieldmove_stmt(w.body[i], name, sty, structs, borrowable)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.StmtFor(fo) => {
      if (fieldmove_expr(fo.iter, name, sty, structs, borrowable)) {
        return true;
      }
      var i: i32 = 0;
      while (i < fo.body.len()) {
        if (fieldmove_stmt(fo.body[i], name, sty, structs, borrowable)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.StmtMatch(m) => {
      if (fieldmove_expr(m.scrutinee, name, sty, structs, borrowable)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && fieldmove_expr(arm.guard, name, sty, structs, borrowable)) {
          return true;
        }
        var bi: i32 = 0;
        while (bi < arm.body.len()) {
          if (fieldmove_stmt(arm.body[bi], name, sty, structs, borrowable)) {
            return true;
          }
          bi = bi + 1;
        }
      }
      return false;
    },
    ast.StmtDefer(d) => {
      return fieldmove_stmt(d.action, name, sty, structs, borrowable);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// optstruct_body_moves_field: any statement in `stmts` moves a NON-SCALAR field of
// the struct local `name` (declared type `sty`) into something longer-lived.
function optstruct_body_moves_field(stmts: ast.Stmt[], name: string, sty: string, structs: irtables.StructTab, borrowable: string[]): boolean {
  for stmt in stmts {
    if (fieldmove_stmt(stmt, name, sty, structs, borrowable)) {
      return true;
    }
  }
  return false;
}

// --- map alias group releases (#7235; the group model is at map_alias_holder_sites)

// A THREADER hands back its parameter k grown only by fresh elements (#10420):
// every return is `k`, `k.append(e)` with `e` an element the array may own, a
// local alias of k rebuilt only that way, or a call to another threader holding
// such a value at its threaded position, and k and its elements are otherwise
// read only as a borrow — the element gate of k's class, since the caller's
// walk releases every element this body could have handed out. `acc =
// walk(n, acc)` then leaves acc holding its own elements plus fresh ones held
// nowhere else, so a credited acc keeps its exit element walk.
// The rebind store stays shallow: the result carries the old elements uncounted.
// Registered "THREAD<k>:<name>" in return_fresh_struct_ret_fns_of's rows, for a
// free function whose `string[]` or struct-array return type is k's type.
function thread_row(k: i32, name: string): string {
  return "THREAD" + util.i32_to_string(k) + ":" + name;
}

// thread_rebind_pos: the argument index at which the direct call `e` hands the
// bare ident `name` to a threader in `rows` at its threaded position, or -1.
function thread_rebind_pos(e: ast.Expr, name: string, rows: string[]): i32 {
  if let ast.ExprCall(c) = e {
    var callee: string = ident_name_or_empty(c.callee);
    if (callee.len() == 0) {
      return 0 - 1;
    }
    var i: i32 = 0;
    while (i < c.args.len()) {
      if (ident_name_or_empty(c.args[i]) == name && util.index_of_str(rows, thread_row(i, callee)) >= 0) {
        return i;
      }
      i = i + 1;
    }
  }
  return 0 - 1;
}

// thread_rebind: `name = g(.., name, ..)` through a threader, with no other
// argument reading `name` or an element of it other than as a borrow — by the
// `string[]` element gate when `strs`, else the struct-array one.
function thread_rebind(e: ast.Expr, name: string, borrowable: string[], rows: string[], strs: boolean): boolean {
  var k: i32 = thread_rebind_pos(e, name, rows);
  if (k < 0) {
    return false;
  }
  if let ast.ExprCall(c) = e {
    var i: i32 = 0;
    while (i < c.args.len()) {
      if (i != k && thread_arg_unsafe(c.args[i], name, borrowable, strs)) {
        return false;
      }
      i = i + 1;
    }
  }
  return true;
}

// thread_arg_unsafe: one other argument of a threader rebind. With no element
// struct named, any field read off an element (`acc[0].f`) refuses the rebind.
function thread_arg_unsafe(x: ast.Expr, name: string, borrowable: string[], strs: boolean): boolean {
  if (strs) {
    return strarr_expr_unsafe(x, name, borrowable);
  }
  return structarr_elem_unsafe(x, name, "", irtables.struct_tab_empty(), [], borrowable);
}

// structarr_elem_unsafe: `e` reads the struct array `name` or one of its
// elements other than as a borrow. A non-scalar field extraction is judged only
// when `sty` names the element struct.
function structarr_elem_unsafe(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab, sfok: string[], borrowable: string[]): boolean {
  return expr_unsafe_for(e, name, borrowable, []) || arrstruct_elem_esc_expr(e, name, sty, structs, [], borrowable, sfok, []);
}

// ThreadScan: one threader candidate's body proof. `names` holds k and its
// aliases, `shadow` every name the body or the parameters bind, and `elem` the
// array's element type.
struct ThreadScan { names: string[], elem: string, rows: string[], shadow: string[], structs: irtables.StructTab, sfok: string[], str_fresh: string[], fwd: string[] }

// thread_elem_fresh: an element the threaded array may own outright — a fresh
// string, or a fresh struct literal or strict-fresh struct producer's result.
// A producer a local or parameter shadows is the local's value.
function thread_elem_fresh(e: ast.Expr, sc: ThreadScan): boolean {
  if let ast.ExprCall(c) = e {
    if (util.index_of_str(sc.shadow, ident_name_or_empty(c.callee)) >= 0) {
      return false;
    }
  }
  if (sc.elem == "string") {
    return strarr_value_is_fresh(e, sc.str_fresh);
  }
  if (is_fresh_struct_init(e, sc.structs, sc.sfok)) {
    return true;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      return util.index_of_str(sc.fwd, cid.name) >= 0;
    }
  }
  return false;
}

// thread_expr_unsafe: `e` reads a threaded name or one of its elements other
// than as a borrow, by the element gate of the array's class. No move sites
// and no borrowable parameters are consulted: both only widen what the gates
// admit.
function thread_expr_unsafe(e: ast.Expr, sc: ThreadScan): boolean {
  for n in sc.names {
    if (sc.elem == "string") {
      if (expr_unsafe_for(e, n, [], []) || strarr_expr_unsafe(e, n, [])) {
        return true;
      }
    } else if (structarr_elem_unsafe(e, n, sc.elem, sc.structs, sc.sfok, [])) {
      return true;
    }
  }
  return false;
}

// thread_call_ok: `c` calls a threader, holding a threaded value at its threaded
// position and reading the threaded names nowhere else.
function thread_call_ok(c: ast.ExprCall, sc: ThreadScan): boolean {
  var callee: string = ident_name_or_empty(c.callee);
  if (callee.len() == 0 || util.index_of_str(sc.shadow, callee) >= 0) {
    return false;
  }
  var k: i32 = 0 - 1;
  var i: i32 = 0;
  while (i < c.args.len()) {
    if (k < 0 && util.index_of_str(sc.rows, thread_row(i, callee)) >= 0 && thread_expr_ok(c.args[i], sc)) {
      k = i;
    } else if (thread_expr_unsafe(c.args[i], sc)) {
      return false;
    }
    i = i + 1;
  }
  return k >= 0;
}

// thread_expr_ok: `e` is a threaded value — a threaded name, one grown by a
// fresh element, or a threader's result over one.
function thread_expr_ok(e: ast.Expr, sc: ThreadScan): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return util.index_of_str(sc.names, id.name) >= 0;
    },
    ast.ExprCall(c) => {
      if let ast.ExprFieldAccess(fa) = c.callee {
        return fa.field == "append" && c.args.len() == 1 && thread_expr_ok(fa.obj, sc)
          && thread_elem_fresh(c.args[0], sc) && !thread_expr_unsafe(c.args[0], sc);
      }
      return thread_call_ok(c, sc);
    },
    _ => {}
  }
  return false;
}

function thread_alias_visit(st: ast.Stmt, own sc: ThreadScan): ThreadScan {
  if let ast.StmtVar(v) = st {
    if (util.index_of_str(sc.names, v.name) < 0 && thread_expr_ok(v.init, sc)) {
      return ThreadScan { ...sc, names: sc.names.append(v.name) };
    }
  }
  return sc;
}

// thread_aliases: k's alias set, grown until no `var` bound from a threaded
// value is left out.
function thread_aliases(body: ast.Stmt[], sc: ThreadScan): ThreadScan {
  var cur: ThreadScan = sc;
  var n: i32 = 0 - 1;
  while (n != cur.names.len()) {
    n = cur.names.len();
    for st in body {
      cur = astwalk.fold_stmt_spine(st, cur, thread_alias_visit);
    }
  }
  return cur;
}

function thread_body_ok(stmts: ast.Stmt[], sc: ThreadScan): boolean {
  for st in stmts {
    if (!thread_stmt_ok(st, sc)) {
      return false;
    }
  }
  return true;
}

// thread_rebinds_ok: a `var` or assignment of a threaded name takes a threaded
// value; any other reads the threaded names only as a borrow.
function thread_rebinds_ok(target: string, value: ast.Expr, sc: ThreadScan): boolean {
  if (util.index_of_str(sc.names, target) >= 0) {
    return thread_expr_ok(value, sc);
  }
  return !thread_expr_unsafe(value, sc);
}

function thread_stmt_ok(st: ast.Stmt, sc: ThreadScan): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return thread_rebinds_ok(v.name, v.init, sc);
    },
    ast.StmtAssign(a) => {
      return thread_rebinds_ok(a.target, a.value, sc);
    },
    ast.StmtReturn(r) => {
      return thread_expr_ok(r.value, sc);
    },
    ast.StmtIf(f) => {
      return thread_if_ok(f, sc);
    },
    ast.StmtWhile(w) => {
      return thread_block_ok(w.cond, w.body, sc);
    },
    ast.StmtFor(fo) => {
      return !thread_shadowed(st, sc) && thread_for_ok(st, fo, sc);
    },
    ast.StmtMatch(m) => {
      return !thread_shadowed(st, sc) && thread_match_ok(m, sc);
    },
    ast.StmtDefer(d) => {
      return thread_stmt_ok(d.action, sc);
    },
    ast.StmtExpr(x) => {
      return !thread_expr_unsafe(x.value, sc);
    },
    _ => {
      return true;
    }
  }
  return false;
}

// thread_shadowed: a loop variable or match binding of `st` rebinds a threaded
// name, so the reads under it are of another value.
function thread_shadowed(st: ast.Stmt, sc: ThreadScan): boolean {
  for b in astwalk.binders_of(st, []) {
    if (util.index_of_str(sc.names, b) >= 0) {
      return true;
    }
  }
  return false;
}

function thread_if_ok(f: ast.StmtIf, sc: ThreadScan): boolean {
  return thread_block_ok(f.cond, f.then_body, sc) && thread_body_ok(f.else_body, sc);
}

// thread_block_ok: a condition that reads the threaded names only as a borrow,
// and a body that keeps the threading.
function thread_block_ok(cond: ast.Expr, body: ast.Stmt[], sc: ThreadScan): boolean {
  return !thread_expr_unsafe(cond, sc) && thread_body_ok(body, sc);
}

// thread_for_ok: `for x in name` borrows each element for the iteration, on
// the loop-variable confinement of the array's class.
function thread_for_ok(st: ast.Stmt, fo: ast.StmtFor, sc: ThreadScan): boolean {
  var it: string = ident_name_or_empty(fo.iter);
  if (it.len() == 0 && thread_expr_unsafe(fo.iter, sc)) {
    return false;
  }
  if (util.index_of_str(sc.names, it) >= 0) {
    if (sc.elem == "string") {
      if (body_unsafe_for(fo.body, fo.var_name, [], [])) {
        return false;
      }
    } else if (arrstruct_row_escapes([st], it, sc.elem, sc.structs, [])) {
      return false;
    }
  }
  return thread_body_ok(fo.body, sc);
}

function thread_match_ok(m: ast.StmtMatch, sc: ThreadScan): boolean {
  if (thread_expr_unsafe(m.scrutinee, sc)) {
    return false;
  }
  for arm in m.arms {
    if (arm.has_guard && thread_expr_unsafe(arm.guard, sc)) {
      return false;
    }
    if (!thread_body_ok(arm.body, sc)) {
      return false;
    }
  }
  return true;
}

// thread_param_elem: the element type when parameter k of `fn` may thread —
// a free function returning k's own `string[]` or struct-array type — or "".
function thread_param_elem(fn: parser.FuncDecl, k: i32, structs: irtables.StructTab): string {
  var rt: string = fn.ret_type;
  if (fn.receiver_type.len() > 0 || fn.params[k].type_name != rt || rt.len() < 3) {
    return "";
  }
  if (slice_unchecked(rt, rt.len() - 2, rt.len()) != "[]") {
    return "";
  }
  var el: string = slice_unchecked(rt, 0, rt.len() - 2) + "";
  if (el == "string" || irtables.decl_is_struct(structs, el)) {
    return el;
  }
  return "";
}

// ThreadCands: the (function index, parameter) pairs still standing in the
// threader fixpoint.
struct ThreadCands { fis: i32[], ks: i32[] }

function thread_candidates(funcs: parser.FuncDecl[], structs: irtables.StructTab): ThreadCands {
  var out: ThreadCands = ThreadCands { fis: [], ks: [] };
  var fi: i32 = 0;
  while (fi < funcs.len()) {
    var k: i32 = 0;
    while (k < funcs[fi].params.len() && body_has_return(funcs[fi].body)) {
      if (thread_param_elem(funcs[fi], k, structs) != "") {
        out = ThreadCands { fis: out.fis.append(fi), ks: out.ks.append(k) };
      }
      k = k + 1;
    }
    fi = fi + 1;
  }
  return out;
}

function thread_cand_rows(funcs: parser.FuncDecl[], cands: ThreadCands): string[] {
  var rows: string[] = [];
  var i: i32 = 0;
  while (i < cands.fis.len()) {
    rows = rows.append(thread_row(cands.ks[i], funcs[cands.fis[i]].name));
    i = i + 1;
  }
  return rows;
}

function thread_param_holds(fn: parser.FuncDecl, k: i32, rows: string[], structs: irtables.StructTab, sfok: string[], str_fresh: string[], fwd: string[]): boolean {
  var shadow: string[] = astwalk.collect_bound_stmts(fn.body, []);
  for p in fn.params {
    shadow = shadow.append(p.name);
  }
  var sc: ThreadScan = ThreadScan {
    names: [fn.params[k].name], elem: thread_param_elem(fn, k, structs), rows: rows,
    shadow: shadow, structs: structs, sfok: sfok, str_fresh: str_fresh, fwd: fwd,
  };
  return thread_body_ok(fn.body, thread_aliases(fn.body, sc));
}

// thread_rows_of: the "THREAD<k>:" rows, as a GREATEST fixpoint — a candidate
// leaves once its body cites one that already left. A recursive threader holds
// by induction on the calls that return, which a least fixpoint would refuse.
function thread_rows_of(funcs: parser.FuncDecl[], structs: irtables.StructTab, sfok: string[], str_fresh: string[], fwd: string[]): string[] {
  var cands: ThreadCands = thread_candidates(funcs, structs);
  var n: i32 = 0 - 1;
  while (n != cands.fis.len()) {
    n = cands.fis.len();
    var rows: string[] = thread_cand_rows(funcs, cands);
    var kept: ThreadCands = ThreadCands { fis: [], ks: [] };
    var i: i32 = 0;
    while (i < cands.fis.len()) {
      if (thread_param_holds(funcs[cands.fis[i]], cands.ks[i], rows, structs, sfok, str_fresh, fwd)) {
        kept = ThreadCands { fis: kept.fis.append(cands.fis[i]), ks: kept.ks.append(cands.ks[i]) };
      }
      i = i + 1;
    }
    cands = kept;
  }
  return thread_cand_rows(funcs, cands);
}

// One walker behind all three, rather than a near-copy per class (the 08-22
// struct-producer rule). `dup_at_index` says whether this class's element bind
// takes the counted retain that turns an index read from an escape into a
// borrow the reclaim can outlive; `box_iter_ok` says whether its `for` iteration
// — transient in every class, since the loop ends before the reclaim — has a
// confinement proof for a BOX loop var, which is a separate question from the
// index bind and answered by a different walk. `elem_sty` names the element
// struct of a class whose walk is DEEP (arrstruct_row_escapes), and is "" for
// every other class.
function arrarr_row_escapes_ex(stmts: ast.Stmt[], name: string, dup_at_index: boolean, borrowable: string[], box_iter_ok: boolean, elem_sty: string, structs: irtables.StructTab): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (!dup_at_index && expr_is_bare_row_read(v.init, name)) {
          return true;
        }
      },
      ast.StmtAssign(asg) => {
        if (!dup_at_index && expr_is_bare_row_read(asg.value, name)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (ident_named_is(fo.iter, name)) {
          // The loop var is an unretained borrow of each element, and
          // the bind is transient — the loop ends before the exit
          // reclaim. What differs per class is the confinement proof
          // the element kind admits: an arr-of-arr ROW is an array the
          // ordinary escape walk vets, an option BOX is consumed by a
          // `match` that walk reads as an escape and needs the
          // scrutinee reading plus an arm-binding vet, and a class with
          // neither proof refuses outright.
          if (dup_at_index) {
            if (body_unsafe_for(fo.body, fo.var_name, borrowable, [])) {
              return true;
            }
          } else if (box_iter_ok) {
            if (body_unsafe_for_match_borrow(fo.body, fo.var_name, no_names(), no_names(), no_names())) {
              return true;
            }
            if (elem_box_iter_bind_escapes(fo.body, fo.var_name)) {
              return true;
            }
          } else if (elem_sty != "") {
            // A struct element whose walk frees its fields: the loop
            // var stays in the body, hands out none of its rc fields,
            // and the array is not rebound under the loop (#10161).
            if (body_unsafe_for(fo.body, fo.var_name, borrowable, [])
              || forvar_field_escapes(fo.body, fo.var_name, elem_sty, structs)
              || stmts_assign_name_deep(fo.body, name)) {
              return true;
            }
          } else {
            return true;
          }
        }
        if (arrarr_row_escapes_ex(fo.body, name, dup_at_index, borrowable, box_iter_ok, elem_sty, structs)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (arrarr_row_escapes_ex(f.then_body, name, dup_at_index, borrowable, box_iter_ok, elem_sty, structs) || arrarr_row_escapes_ex(f.else_body, name, dup_at_index, borrowable, box_iter_ok, elem_sty, structs)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (arrarr_row_escapes_ex(w.body, name, dup_at_index, borrowable, box_iter_ok, elem_sty, structs)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (arrarr_row_escapes_ex(arm.body, name, dup_at_index, borrowable, box_iter_ok, elem_sty, structs)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

// elem_box_iter_bind_escapes: the loop variable of `for o in xs` over an array of
// option boxes, checked for anything that could outlive the loop.
//
// The box itself is handled by the caller's body_unsafe_for_match_borrow, which
// admits `o` in exactly one position — the bare scrutinee of a `match (o)` — and
// refuses every alias, call argument, store and return. This walk covers what
// that reading opens up: the arm BINDINGS such a match hands out. Each one
// (payload, extra payloads, and the at-binding, which is the element box itself)
// must stay inside its arm, vetted by elem_arm_bindings_confined and so by the
// STRICT binding_escapes_arm. binding_escapes_arm_scrut, which reads a nested
// `match (binding)` as a borrow, is deliberately NOT used: it is sound only
// where the inner payload is scalar, and this class's payload is an rc array.
//
// A GUARDED arm on the admitted match refuses outright. binding_escapes_arm does
// check the guard, so this is a narrowing rather than a soundness requirement —
// the same one consumed_rcpayload_enum_frees makes for the neighbouring consuming
// match, and for the same reason: under a guard which arm ran is not syntactic,
// and this admission's proof is per-arm.
function elem_box_iter_bind_escapes(stmts: ast.Stmt[], bnd: string): boolean {
  for stmt in stmts {
    if (elem_box_iter_bind_escapes_stmt(stmt, bnd)) {
      return true;
    }
  }
  return false;
}

function elem_box_iter_bind_escapes_stmt(st: ast.Stmt, bnd: string): boolean {
  match (st) {
    ast.StmtMatch(m) => {
      var scrut_is_bnd: boolean = ident_named_is(m.scrutinee, bnd);
      for arm in m.arms {
        if (scrut_is_bnd) {
          if (arm.has_guard) {
            return true;
          }
          if (!elem_arm_bindings_confined(arm)) {
            return true;
          }
        }
        if (elem_box_iter_bind_escapes(arm.body, bnd)) {
          return true;
        }
      }
      return false;
    },
    ast.StmtIf(f) => {
      return elem_box_iter_bind_escapes(f.then_body, bnd)
        || elem_box_iter_bind_escapes(f.else_body, bnd);
    },
    ast.StmtWhile(w) => {
      return elem_box_iter_bind_escapes(w.body, bnd);
    },
    ast.StmtFor(fo) => {
      return elem_box_iter_bind_escapes(fo.body, bnd);
    },
    ast.StmtDefer(d) => {
      return elem_box_iter_bind_escapes_stmt(d.action, bnd);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// arrstruct_row_escapes: arrarr_row_escapes for an array of structs whose
// element walk is DEEP. A bare element bind still refuses; `for p in name` is
// admitted on the struct proof in arrarr_row_escapes_ex (#10161).
function arrstruct_row_escapes(stmts: ast.Stmt[], name: string, sty: string, structs: irtables.StructTab, borrowable: string[]): boolean {
  return arrarr_row_escapes_ex(stmts, name, false, borrowable, false, sty, structs);
}

// forvar_field_escapes: does the loop body read an rc field of the struct loop
// var `p` (element type `sty`) other than as a borrow? A scalar field is a copy,
// and `p.f[j]` / `p.f.len()` read through the field without keeping it; any
// other `p.f` over a non-scalar field hands out a pointer the element walk frees.
function forvar_field_escapes(stmts: ast.Stmt[], p: string, sty: string, structs: irtables.StructTab): boolean {
  function visit(x: ast.Expr, own esc: boolean): boolean {
    return forvar_field_esc_at(x, esc, p, sty, structs);
  }
  function descend(x: ast.Expr): boolean {
    return forvar_field_shape(x, p, sty, structs) == 0;
  }
  for stmt in stmts {
    if (astwalk.fold_stmt_pruned(stmt, false, visit, descend)) {
      return true;
    }
  }
  return false;
}

function forvar_field_esc_expr(e: ast.Expr, p: string, sty: string, structs: irtables.StructTab): boolean {
  function visit(x: ast.Expr, own esc: boolean): boolean {
    return forvar_field_esc_at(x, esc, p, sty, structs);
  }
  function descend(x: ast.Expr): boolean {
    return forvar_field_shape(x, p, sty, structs) == 0;
  }
  return astwalk.fold_expr_pruned(e, false, visit, descend);
}

// forvar_field_shape: 0 descend, 1 safe leaf, 2 escape, 3 a borrow through
// `p.f` whose index still needs the scan.
function forvar_field_shape(e: ast.Expr, p: string, sty: string, structs: irtables.StructTab): i32 {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      if (ident_name_or_empty(fa.obj) != p) {
        return 0;
      }
      // A name the declaration does not know (a method) is refused rather
      // than read as a scalar.
      if (irtables.is_scalar_type_name(irtables.decl_field_type(structs, sty, fa.field))) {
        return 1;
      }
      return 2;
    },
    ast.ExprIndex(ix) => {
      if let ast.ExprFieldAccess(ifa) = ix.array {
        if (ident_name_or_empty(ifa.obj) == p) {
          return 3;
        }
      }
      return 0;
    },
    ast.ExprCall(c) => {
      if let ast.ExprFieldAccess(cfa) = c.callee {
        if (cfa.field == "len" && c.args.len() == 0) {
          if let ast.ExprFieldAccess(rfa) = cfa.obj {
            if (ident_name_or_empty(rfa.obj) == p) {
              return 1;
            }
          }
        }
      }
      return 0;
    },
    _ => {
      return 0;
    }
  }
  return 0;
}

function forvar_field_esc_at(x: ast.Expr, esc: boolean, p: string, sty: string, structs: irtables.StructTab): boolean {
  if (esc) {
    return true;
  }
  var code: i32 = forvar_field_shape(x, p, sty, structs);
  if (code == 2) {
    return true;
  }
  if (code == 3) {
    if let ast.ExprIndex(ix) = x {
      return forvar_field_esc_expr(ix.index, p, sty, structs);
    }
  }
  return false;
}

// stmts_assign_name_deep: some statement at any depth of `stmts` assigns `name`.
function stmts_assign_name_deep(stmts: ast.Stmt[], name: string): boolean {
  function hit(st: ast.Stmt, own acc: boolean): boolean {
    return acc || stmt_assigns_name(st, name);
  }
  function no_expr(x: ast.Expr, own acc: boolean): boolean {
    return acc;
  }
  for stmt in stmts {
    if (astwalk.fold_stmt_nodes(stmt, false, hit, no_expr, astwalk.descend_all)) {
      return true;
    }
  }
  return false;
}

function expr_is_bare_row_read(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprIndex(ix) => {
      match (ix.array) {
        ast.ExprIdent(iid) => {
          return iid.name == name;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// ── CLOARR: closure-array element reclaim (#4354) ───────────────────────────
//
// A closure ARRAY local (`var fns: (() => i32)[] = [() => n, …]`) is an is_arr
// slot whose elements are env boxes — rc-headered arrays `[fn, caps…]` whose
// captures are borrowed, never counted. The shallow buffer dec every other
// array slot takes leaked every box (measured 40 B per element per round on
// x86-64 against 0 on native). Credited "CLOARR:<site>", the slot is released
// whole by __fern_arrarr_free: one rc-guarded arr_dec per element, then the
// buffer — the arr-of-arr helper, because an env box IS an inner array to it.
//
// The credit is the whole safety argument, since the walk frees any box the
// buffer holds at rc==1. Two conditions: every element that ever enters the
// buffer is OWNED by it — a fresh box (a lambda or its `__mkclo$` marker) or a
// closure local the literal / self-append retains as an is_arr ident — at the
// literal, at a self-append, or in every return of a "CAC:" producer; and
// every read of the array is one of: `fns[i](args)` (dispatched, never
// stored), `var d = fns[i]` (lower_stmt_var_closure retains the element, so d
// is a counted owner), `for f in fns` with f only ever called, `fns.len()`, or
// a bare argument at a borrowable position. `.with` / `.append` bound
// elsewhere clone the buffer and share its boxes uncounted, so any other
// method refuses.

// ── OPTARRARR: reclaim `Option[<scalar-arr-of-arr>]` locals (#4365) ──
// The arr-of-arr sibling of OPTSTRUCT: the Some payload is an arr-of-arr box, freed whole by
// the backend-complete __fern_arrarr_free (inner scalar buffers + outer). Scalar-inner only
// (i32[][]/boolean[][]/…); a string-inner arr-of-arr would need __fern_strarrarr_free
// (deferred). opt_type carries the full Option[T[][]] for this annotated binding.

// ── ARRTUP: reclaim `(<tuple-with-array>)[]` array-of-tuples locals (#4365) ──
// arrtup_elem_tuple_type: for an array type `(<tuple>)[]`, return the element tuple
// type `(<tuple>)` when it is deep-droppable (>=1 array, all scalar / leaf array /
// nested tuple), else "". The element boxes are tuples carrying fresh arrays; the
// release walks the buffer element-by-element and type-drives each tuple's drop.
function arrtup_elem_tuple_type(type_name: string, structs: irtables.StructTab): string {
  var n: i32 = type_name.len();
  if (n < 4) {
    return "";
  }
  if (slice_unchecked(type_name, n - 2, n) != "[]") {
    return "";
  }
  var elem: str = slice_unchecked(type_name, 0, n - 2);
  if (!tuple_field_deep_droppable(elem, structs)) {
    return "";
  }
  return elem + "";
}

// arrtup_lit_is_fresh: `e` is a non-empty array literal whose EVERY element is a
// FRESH tuple literal for the element type `ttype` — every array position a direct
// array literal (tuple_arg_payload_fresh), so each element tuple box AND its arrays
// are sole-owned at the binding. A scalar position accepts any expression.
function arrtup_lit_is_fresh(e: ast.Expr, ttype: string, structs: irtables.StructTab, str_fresh: string[]): boolean {
  match (e) {
    ast.ExprArray(arr) => {
      if (arr.elements.len() == 0) {
        return false;
      }
      var i: i32 = 0;
      while (i < arr.elements.len()) {
        if (!tuple_arg_payload_droppable(ttype, arr.elements[i], structs, false, str_fresh)) {
          return false;
        }
        i = i + 1;
      }
      return true;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// body_has_nonfresh_arrtup_return: any return whose value is NOT a fresh
// `(<tuple-with-array>)[]` literal for element type `elem`. The array-of-tuples
// sibling of body_has_nonfresh_arrlit_return, which needs no per-element proof
// because its elements are scalars.
function body_has_nonfresh_arrtup_return(stmts: ast.Stmt[], elem: string, structs: irtables.StructTab, str_fresh: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        if (!arrtup_lit_is_fresh(r.value, elem, structs, str_fresh)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (body_has_nonfresh_arrtup_return(f.then_body, elem, structs, str_fresh) || body_has_nonfresh_arrtup_return(f.else_body, elem, structs, str_fresh)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_nonfresh_arrtup_return(w.body, elem, structs, str_fresh)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_nonfresh_arrtup_return(fo.body, elem, structs, str_fresh)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (body_has_nonfresh_arrtup_return(m.arms[a].body, elem, structs, str_fresh)) {
            return true;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

// fn_returns_fresh_arrtup: `fn` is a free function whose declared return is a
// deep-droppable `(<tuple-with-array>)[]` and whose every return hands back a
// fresh array literal of fresh tuple literals — so the caller's binding sole-owns
// the buffer, every element tuple box and the arrays inside them. Registered
// "ARRTUPF:<name>" so a call-bound local earns the ARRTUP credit.
function fn_returns_fresh_arrtup(fn: parser.FuncDecl, structs: irtables.StructTab, str_fresh: string[]): boolean {
  if (fn.receiver_type.len() > 0) {
    return false;
  }
  var elem: string = arrtup_elem_tuple_type(fn.ret_type, structs);
  if (elem == "") {
    return false;
  }
  if (!body_has_return(fn.body)) {
    return false;
  }
  return !body_has_nonfresh_arrtup_return(fn.body, elem, structs, str_fresh);
}

// ── ARRSTRUCT: reclaim `(<struct-with-array-field>)[]` array-of-structs locals (#4365) ──
// The struct sibling of ARRTUP: an array whose elements are struct boxes each carrying
// an rc-array field. The element struct type is already recorded on the (is_arr) slot
// as struct_type (the array-of-structs binding sets struct_ty = <elem>[]-stripped), so
// no extra marking is needed. Release reuses the ARRTUP counted element-walk but drops
// each element via the struct-field deep-drop (__struct_drop_<T>, backend-complete)
// instead of the tuple deep-drop.

// arrstruct_elem_struct_type: for an array type `T[]` whose element T is a struct decl
// that routes field-reclaim (has an rc-array / nested-struct / enum field), return T,
// else "". `structs` is the decl table.
function arrstruct_elem_struct_type(type_name: string, structs: irtables.StructTab): string {
  var n: i32 = type_name.len();
  if (n < 3) {
    return "";
  }
  if (slice_unchecked(type_name, n - 2, n) != "[]") {
    return "";
  }
  var elem: str = slice_unchecked(type_name, 0, n - 2);
  if (!irtables.decl_is_struct(structs, elem)) {
    return "";
  }
  if (!struct_has_reclaim_array_field(structs, elem)) {
    return "";
  }
  return elem + "";
}

// structarr_elem_struct_type: the element struct of a SCALAR-FIELD struct array,
// the DISJOINT sibling of the above — arrstruct owns the rc-array-field structs,
// this class the rest. `dyn T[]` answers "" through decl_is_struct, which is what
// keeps the dyn sweep's slots out.
function structarr_elem_struct_type(type_name: string, structs: irtables.StructTab): string {
  var n: i32 = type_name.len();
  if (n < 3) {
    return "";
  }
  if (slice_unchecked(type_name, n - 2, n) != "[]") {
    return "";
  }
  var elem: str = slice_unchecked(type_name, 0, n - 2);
  if (!irtables.decl_is_struct(structs, elem)) {
    return "";
  }
  if (struct_has_reclaim_array_field(structs, elem)) {
    return "";
  }
  return elem + "";
}

// arrstruct_self_store_elem / arrstruct_name_is_appended / arrstruct_unsafe_for:
// the append-built half of this class (#6535), transcribed from the shallow
// STRUCTARR siblings #6127 introduced. The literal-built credit refused any
// REASSIGNED name, and `vals = vals.append(Val { .. })` is a reassignment — so
// an append-built array-of-structs earned no credit at all and leaked its whole
// structure per round, where the literal-built form of the identical value was
// flat. Measured 35200 bytes over 100 rounds on a 4-element `Val { kind: i32,
// kids: i32[] }[]`, doubling with the round count, against 0 for the literal.
//
// Two element shapes qualify. A producer_elem_is_fresh element — a fresh struct
// literal or a call into a strict-fresh producer — is the rule
// arrstruct_lit_is_fresh applies per element: the box is sole-owned exactly as
// in the literal-built form the deep walk already frees. A BARE IDENT qualifies
// because the append RETAINS it: the container holds a counted reference, and
// the element walk deep-drops the fields only under __fern_rc_is_unique, so a
// source that outlives the push keeps its own claim and its own field walk.
// The retain is gated on this very credit (slot_is_reclaimable_arrstruct at the
// append), which is what keeps the inc and the dec the same set.

// moved_ident_at: `e` is a bare ident the move analysis recorded at this source
// position. Keyed on line:col, not the name, so a local that is moved at one store
// and merely read at another admits only the store that moved it.
//
// The question is not specific to any container: wherever a store would take over
// a local's only reference, this is what says the store may.
function moved_ident_at(e: ast.Expr, msites: string[]): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return util.index_of_str(msites, util.i32_to_string(id.line) + ":" + util.i32_to_string(id.col)) >= 0;
    },
    _ => {}
  }
  return false;
}

// arrstruct_self_store_elem_index: the ARGUMENT index of the element in a
// self-store `name = name.append(x)` (0) or `name = name.with(i, x)` (1), or -1
// when `e` is neither. One reader for both shapes, so the credit gate, the stamping
// pass and the lowering cannot disagree about which operand is the element.
function arrstruct_self_store_elem_index(e: ast.Expr, name: string): i32 {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          var self_recv: boolean = false;
          match (fa.obj) {
            ast.ExprIdent(rid) => {
              self_recv = rid.name == name;
            },
            _ => {}
          }
          if (!self_recv) {
            return 0 - 1;
          }
          if (fa.field == "append" && c.args.len() == 1) {
            return 0;
          }
          if (fa.field == "with" && c.args.len() == 2) {
            return 1;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return 0 - 1;
}

// arrstruct_self_store_elem: `e` is a sanctioned self-store rebind of the credited
// container `name`, whose element is one the container may own.
//
// `with` joins `append` here because both store an element the container's walk
// then releases. It differs in one way that costs a release rather than a credit:
// `with` REPLACES, so the superseded element has to be freed at the store
// (emit_arrstruct_with_store) — `append` displaces nothing.
function arrstruct_self_store_elem(e: ast.Expr, name: string, structs: irtables.StructTab, msites: string[], sfok: string[], pfresh: string[]): boolean {
  match (e) {
    ast.ExprCall(c) => {
      var eidx: i32 = arrstruct_self_store_elem_index(e, name);
      if (eidx < 0) {
        return false;
      }
      if (moved_ident_at(c.args[eidx], msites)) {
        return true;
      }
      // ANY bare ident. The credit no longer needs the element to be dead
      // after the push, because the append RETAINS it and both owners run
      // their field walk under __fern_rc_is_unique: whichever reaches rc 1
      // does the deep work, the other takes the box dec. Requiring a MOVE
      // cost the CONTAINER its element walk on every shape where the source
      // outlives the push — `ps = ps.append(p); p = P { … }` reads as
      // neither a move nor a literal, and the whole array then leaked.
      match (c.args[eidx]) {
        ast.ExprIdent(_) => {
          return true;
        },
        _ => {}
      }
      return producer_elem_is_fresh(c.args[eidx], structs, sfok, pfresh);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// arrstruct_counted_field_share: `e` is a struct literal that mentions `name`
// ONLY as the bare-ident value of a field whose declared type takes the
// construction alias-inc — the ExprStructLit ident arm in lower_expr, which
// retains an array-of-struct field source unconditionally. The field therefore
// holds a COUNTED share, and reading it as an escape cost the source its whole
// reclaim: `var p: P = P { f: src, … }` left `src` with the generic buffer dec,
// freeing the outer array while every element box and element array field
// stranded. Measured 88 bytes per round on a one-element `Inner[]`, and only on
// the path where the share did NOT run — with the share live the holder's
// rc-gated field walk did the work and the census was flat.
//
// Both releases are rc-gated, which is what makes granting this safe rather than
// a double free: the holder's walk is __struct_arr_elems_drop_<E>, which
// is_unique-gates the buffer, and the source's is emit_arrstruct_deep_free,
// gated the same way. Whichever finds rc 1 walks; the other takes the buffer dec.
//
// A `{ ...base }` update is refused: the copied fields carry no inc, so the new
// box would co-own the buffer with no count behind it.
//
// A MOVED share is refused for the same reason, one step further on. The retain
// is move-gated (#6726): where the analysis says the construction moves the
// local, the box takes over its reference and BOTH the inc and the sweep dec
// that cancels it are dropped (note_moved_elided pairs them). This credit does
// not route that plain sweep dec — it routes emit_arrstruct_deep_free — so
// granting it at a moved site frees a buffer whose ownership left the frame. It
// is the shape `return T { f: src, … }` has, because the return is src's last
// use: measured as gen2 segfaulting under qemu on the arm64 stage-2 fixpoint,
// with every x86-64 gate, both matrices and all three x86-64 fixpoints green.
// The credit therefore asks exactly the question the retain asks.
function arrstruct_counted_field_share(e: ast.Expr, name: string, structs: irtables.StructTab, msites: string[]): boolean {
  match (e) {
    ast.ExprStructLit(sl) => {
      if (sl.has_base) {
        return false;
      }
      var seen: boolean = false;
      var i: i32 = 0;
      while (i < sl.field_values.len()) {
        match (sl.field_values[i]) {
          ast.ExprIdent(fid) => {
            if (fid.name == name) {
              if (!irtables.is_struct_array_field_type(structs, irtables.decl_field_type(structs, sl.type_name, sl.field_names[i]))) {
                return false;
              }
              if (moved_ident_at(sl.field_values[i], msites)) {
                return false;
              }
              seen = true;
            }
          },
          _ => {
            if (expr_unsafe_for(sl.field_values[i], name, [], [])) {
              return false;
            }
          }
        }
        i = i + 1;
      }
      return seen;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// producer_elem_is_fresh: an element a producer's array owns outright — a fresh
// struct literal, or a call into `pfresh`, the strict-fresh producers this
// function does not shadow. That call's box is rc 1 and unaliased, the same
// freshness one frame out, which is what structarr_elem_store_ok already admits
// on the store side (#8609). is_fresh_struct_init itself stays literal-only: it
// serves the plain struct-local credit too.
function producer_elem_is_fresh(e: ast.Expr, structs: irtables.StructTab, sfok: string[], pfresh: string[]): boolean {
  if (is_fresh_struct_init(e, structs, sfok)) {
    return true;
  }
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      return util.index_of_str(pfresh, cid.name) >= 0;
    }
  }
  return false;
}

// producer_lit_is_fresh: a non-empty array literal of producer_elem_is_fresh
// elements. A bare ident does not qualify: a RETURNED literal's counted co-owner
// would be a local of the frame being left.
function producer_lit_is_fresh(e: ast.Expr, structs: irtables.StructTab, sfok: string[], pfresh: string[]): boolean {
  if let ast.ExprArray(arr) = e {
    if (arr.elements.len() == 0) {
      return false;
    }
    for el in arr.elements {
      if (!producer_elem_is_fresh(el, structs, sfok, pfresh)) {
        return false;
      }
    }
    return true;
  }
  return false;
}

// body_has_nonfresh_arrstruct_return: any return whose value is NOT a fresh
// array-of-structs the callee owns outright — a fresh literal, or a local this
// body built by self-append (arrstruct_producer_ret_local). `fnbody` stays the
// whole function body so a return nested in a block can still find that local's
// declaration and its rebinds.
function body_has_nonfresh_arrstruct_return(stmts: ast.Stmt[], fnbody: ast.Stmt[], structs: irtables.StructTab, sfok: string[], pfresh: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        if (!producer_lit_is_fresh(r.value, structs, sfok, pfresh)) {
          match (r.value) {
            ast.ExprIdent(rid) => {
              if (!arrstruct_producer_ret_local(fnbody, rid.name, structs, sfok, pfresh)) {
                return true;
              }
            },
            _ => {
              return true;
            }
          }
        }
      },
      ast.StmtIf(f) => {
        if (body_has_nonfresh_arrstruct_return(f.then_body, fnbody, structs, sfok, pfresh) || body_has_nonfresh_arrstruct_return(f.else_body, fnbody, structs, sfok, pfresh)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_nonfresh_arrstruct_return(w.body, fnbody, structs, sfok, pfresh)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_nonfresh_arrstruct_return(fo.body, fnbody, structs, sfok, pfresh)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        var a: i32 = 0;
        while (a < m.arms.len()) {
          if (body_has_nonfresh_arrstruct_return(m.arms[a].body, fnbody, structs, sfok, pfresh)) {
            return true;
          }
          a = a + 1;
        }
      },
      _ => {}
    }
  }
  return false;
}

// arrstruct_producer_ret_local: `name` is a local this body builds by self-append
// and hands back — `var vals: Val[] = []; vals = vals.append(Val { .. }); return vals;`,
// the shape the literal-only rule above refused even though the local-credit arm
// (ARRSTRUCTA:) already trusts it inside a single frame. A producer written this
// way registered nothing, so every consumer of it — `var g: Val[] = mk(..)` —
// took the shallow buffer dec and stranded each element box and its array fields.
//
// Strictness matches the registry's question, not the local credit's: every
// appended element must be producer_elem_is_fresh. A bare ident would leave the
// container's counted co-owner in the frame being left.
function arrstruct_producer_ret_local(fnbody: ast.Stmt[], name: string, structs: irtables.StructTab, sfok: string[], pfresh: string[]): boolean {
  if (!arrstruct_local_fresh_init(fnbody, name, structs, sfok, pfresh)) {
    return false;
  }
  if (arrstruct_local_foreign_rebind(fnbody, name, structs, sfok, pfresh)) {
    return false;
  }
  return !body_unsafe_for_allow_ret(fnbody, name, [], []);
}

// arrstruct_local_fresh_init: `name` is declared IN this body with an array
// literal every element of which is producer_elem_is_fresh. `[]` qualifies
// vacuously — that is what an append-built producer starts from. Requiring the
// declaration to be here is what keeps the soleness proof local: a param, or a
// name from an enclosing scope, is already owned by someone else.
function arrstruct_local_fresh_init(stmts: ast.Stmt[], name: string, structs: irtables.StructTab, sfok: string[], pfresh: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          match (v.init) {
            ast.ExprArray(lit) => {
              var j: i32 = 0;
              while (j < lit.elements.len()) {
                if (!producer_elem_is_fresh(lit.elements[j], structs, sfok, pfresh)) {
                  return false;
                }
                j = j + 1;
              }
              return true;
            },
            _ => {
              return false;
            }
          }
        }
      },
      ast.StmtIf(f) => {
        if (arrstruct_local_fresh_init(f.then_body, name, structs, sfok, pfresh)) {
          return true;
        }
        if (arrstruct_local_fresh_init(f.else_body, name, structs, sfok, pfresh)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (arrstruct_local_fresh_init(w.body, name, structs, sfok, pfresh)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (arrstruct_local_fresh_init(fo.body, name, structs, sfok, pfresh)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (arrstruct_local_fresh_init(arm.body, name, structs, sfok, pfresh)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

// arrstruct_local_foreign_rebind: any reassignment of `name` that is NOT
// `name.append(e)` / `name.with(i, e)` with a producer_elem_is_fresh `e`.
// The store INDEX comes from arrstruct_self_store_elem_index so the two spellings
// stay one question; the element rule is the strict one above.
function arrstruct_local_foreign_rebind(stmts: ast.Stmt[], name: string, structs: irtables.StructTab, sfok: string[], pfresh: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        if (a.target == name && !arrstruct_fresh_store_elem(a.value, name, structs, sfok, pfresh)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (arrstruct_local_foreign_rebind(f.then_body, name, structs, sfok, pfresh)) {
          return true;
        }
        if (arrstruct_local_foreign_rebind(f.else_body, name, structs, sfok, pfresh)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (arrstruct_local_foreign_rebind(w.body, name, structs, sfok, pfresh)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (arrstruct_local_foreign_rebind(fo.body, name, structs, sfok, pfresh)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (arrstruct_local_foreign_rebind(arm.body, name, structs, sfok, pfresh)) {
            return true;
          }
        }
      },
      ast.StmtDefer(d) => {
        return arrstruct_local_foreign_rebind([d.action], name, structs, sfok, pfresh);
      },
      _ => {}
    }
  }
  return false;
}

// arrstruct_fresh_store_elem: the strict half of arrstruct_self_store_elem — the
// self-store spellings it recognises, with a producer_elem_is_fresh element only.
function arrstruct_fresh_store_elem(e: ast.Expr, name: string, structs: irtables.StructTab, sfok: string[], pfresh: string[]): boolean {
  match (e) {
    ast.ExprCall(c) => {
      var eidx: i32 = arrstruct_self_store_elem_index(e, name);
      if (eidx < 0) {
        return false;
      }
      return producer_elem_is_fresh(c.args[eidx], structs, sfok, pfresh);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// fn_returns_fresh_arrstruct: the array-of-structs sibling of
// fn_returns_fresh_arrtup, registered "ARRSTRUCTF:<name>".
function fn_returns_fresh_arrstruct(fn: parser.FuncDecl, structs: irtables.StructTab, sfok: string[], fwd: string[]): boolean {
  if (fn.receiver_type.len() > 0) {
    return false;
  }
  if (arrstruct_elem_struct_type(fn.ret_type, structs) == "") {
    return false;
  }
  if (!body_has_return(fn.body)) {
    return false;
  }
  return !body_has_nonfresh_arrstruct_return(fn.body, fn.body, structs, sfok, fwd);
}

// fn_returns_fresh_structarr: the SCALAR-FIELD sibling of the above, registered
// "STRUCTARRF:<name>" (#7445). The body proof is the SAME — every return either a
// fresh struct-literal array or a local built by self-append and handed back — and
// only the element-struct test differs, so the two registries are as disjoint as
// the credits they feed and a function is claimed by exactly one.
function fn_returns_fresh_structarr(fn: parser.FuncDecl, structs: irtables.StructTab, sfok: string[], fwd: string[]): boolean {
  if (fn.receiver_type.len() > 0) {
    return false;
  }
  if (structarr_elem_struct_type(fn.ret_type, structs) == "") {
    return false;
  }
  if (!body_has_return(fn.body)) {
    return false;
  }
  return !body_has_nonfresh_arrstruct_return(fn.body, fn.body, structs, sfok, fwd);
}

// arrstruct_elem_esc_shape classifies one node for the array-of-structs
// element escape scan (arrstruct_elem_esc_expr below has the scan's contract);
// codes as rctuple_esc_shape's.
function arrstruct_elem_esc_shape(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab, msites: string[], sfok: string[], producers: string[]): i32 {
  match (e) {
    ast.ExprIdent(id) => {  // bare array escapes
      if (id.name == name) {
        return 2;
      }
      return 1;
    },
    ast.ExprNumber(_) => {
      return 1;
    },
    ast.ExprString(_) => {
      return 1;
    },
    ast.ExprBool(_) => {
      return 1;
    },
    ast.ExprFieldAccess(fa) => {
      var owner: string = arrstruct_chain_owner(e, name, sty, structs);
      if (owner == "") {
        return 0;
      }
      if (owner == "?") {
        return 2;
      }
      // name[i].f / name[i].g.f : a bare non-scalar field extract escapes; a
      // scalar (or unknown) field is a value copy with only the indices to check.
      var ft: string = irtables.decl_field_type(structs, owner, fa.field);
      if (ft != "" && !irtables.is_scalar_type_name(ft)) {
        return 2;
      }
      return 3;
    },
    ast.ExprIndex(ix) => {
      if (ident_name_or_empty(ix.array) == name) {  // bare name[i] struct box
        return 2;
      }
      return arrstruct_chain_read_code(ix.array, name, sty, structs);  // name[i].f[j] : indexed array-field read
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprIdent(_) => {
          return 4;
        },
        ast.ExprFieldAccess(cfa) => {
          if (cfa.field == "len") {
            // `name.len()` on the ARRAY ITSELF — a header read, no element
            // touched, so it is a borrow exactly like the element-field
            // `.len()`. Left generic it recurses into the callee and hits
            // the bare-ident arm, so ANY `.len()` on the local refused the
            // whole credit. Measured: the identical array leaked 8000 over
            // 100 rounds with `ps.len()` and reclaimed cleanly with
            // `ps[0].xs[0]` — reading LESS made it leak, and one `.len()`
            // poisoned the credit even alongside an element read. #6127.
            if (ident_name_or_empty(cfa.obj) == name) {
              return 3;
            }
            var rc: i32 = arrstruct_chain_read_code(cfa.obj, name, sty, structs);  // name[i].f.len() : the whitelisted borrow method
            if (rc != 0) {
              return rc;
            }
          }
          // `name.append(<elem>)` / `name.with(i, <elem>)` — the sanctioned
          // self-store rebind (#6535). The receiver is READ to copy the
          // buffer, and the element stored is one the container may own per
          // arrstruct_self_store_elem, so nothing here binds an element
          // pointer or extracts a field payload. The shape is checked, not
          // assumed: a non-store method or an unsanctioned element falls to
          // the generic tail and still escapes through the bare receiver.
          if (ident_name_or_empty(cfa.obj) == name
            && arrstruct_self_store_elem(e, name, structs, msites, sfok, producers)) {
            return 5;
          }
          return 0;
        },
        _ => {
          return 0;
        }
      }
    },
    ast.ExprBinary(_) => {
      return 0;
    },
    ast.ExprUnary(_) => {
      return 0;
    },
    ast.ExprSlice(_) => {
      return 0;
    },
    ast.ExprArray(_) => {
      return 0;
    },
    ast.ExprTuple(_) => {
      return 0;
    },
    ast.ExprStructLit(_) => {
      // The counted field share is not an element-payload escape either:
      // the field holds a counted reference to the SAME buffer, so the
      // elements' owned fields are reachable from exactly the two owners
      // whose walks are both is_unique-gated. Refusing it here denied the
      // credit even once arrstruct_unsafe_for admitted the share.
      if (arrstruct_counted_field_share(e, name, structs, msites)) {
        return 1;
      }
      return 0;
    },
    ast.ExprLambda(lm) => {
      // A value block is inlined into this frame, so its statements are
      // scanned as the frame's own (code 6); a closure's body is not.
      if (parser.is_value_block_origin(lm.origin)) {
        return 6;
      }
      return 1;
    },
    ast.ExprMapLit(_) => {
      return 1;
    },
    ast.ExprFString(_) => {
      return 1;
    },
    ast.ExprUnknown(_) => {
      return 1;
    },
    ast.ExprZero(_) => {
      return 1;
    }
  }
  return 0;
}

// arrstruct_chain_owner: the struct type declaring the last field of an element
// field chain `name[i].f` / `name[i].g.f` — `sty` for one link, "" when `e` is
// no such chain, "?" when a link does not resolve to a struct field.
function arrstruct_chain_owner(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab): string {
  if let ast.ExprFieldAccess(fa) = e {
    if let ast.ExprIndex(ix) = fa.obj {
      if (ident_name_or_empty(ix.array) == name) {
        return sty;
      }
      return "";
    }
    if let ast.ExprFieldAccess(pfa) = fa.obj {
      var po: string = arrstruct_chain_owner(fa.obj, name, sty, structs);
      if (po == "" || po == "?") {
        return po;
      }
      var pt: string = irtables.decl_field_type(structs, po, pfa.field);
      if (irtables.decl_is_struct(structs, pt)) {
        return pt;
      }
      return "?";
    }
  }
  return "";
}

// arrstruct_chain_read_code: the shape code of a borrow read (`[j]`, `.len()`)
// through the element field chain `e` — 3 to re-scan its indices, 2 when a link
// is unresolved, 0 when `e` is no chain.
function arrstruct_chain_read_code(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab): i32 {
  var owner: string = arrstruct_chain_owner(e, name, sty, structs);
  if (owner == "") {
    return 0;
  }
  if (owner == "?") {
    return 2;
  }
  return 3;
}

// arrstruct_chain_esc: rctuple_chain_esc's array-of-structs sibling — re-scans
// a code-3 chain's index expressions and call arguments.
function arrstruct_chain_esc(x: ast.Expr, name: string, sty: string, structs: irtables.StructTab, msites: string[], borrowable: string[], sfok: string[], producers: string[]): boolean {
  match (x) {
    ast.ExprCall(c) => {
      if (arrstruct_chain_esc(c.callee, name, sty, structs, msites, borrowable, sfok, producers)) {
        return true;
      }
      for arg in c.args {
        if (arrstruct_elem_esc_expr(arg, name, sty, structs, msites, borrowable, sfok, producers)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprFieldAccess(fa) => {
      return arrstruct_chain_esc(fa.obj, name, sty, structs, msites, borrowable, sfok, producers);
    },
    ast.ExprIndex(ix) => {
      if (arrstruct_chain_esc(ix.array, name, sty, structs, msites, borrowable, sfok, producers)) {
        return true;
      }
      return arrstruct_elem_esc_expr(ix.index, name, sty, structs, msites, borrowable, sfok, producers);
    },
    ast.ExprIdent(_) => {
      return false;
    },
    _ => {
      return true;
    }
  }
  return false;
}

// arrstruct_elem_esc_at is the fold visitor: `esc` latches true, and each node
// answers per its arrstruct_elem_esc_shape code.
function arrstruct_elem_esc_at(x: ast.Expr, esc: boolean, name: string, sty: string, structs: irtables.StructTab, msites: string[], borrowable: string[], sfok: string[], producers: string[]): boolean {
  if (esc) {
    return true;
  }
  var code: i32 = arrstruct_elem_esc_shape(x, name, sty, structs, msites, sfok, producers);
  if (code == 2) {
    return true;
  }
  if (code == 3) {
    return arrstruct_chain_esc(x, name, sty, structs, msites, borrowable, sfok, producers);
  }
  if (code == 4) {
    match (x) {
      ast.ExprCall(c) => {
        var callee: string = ident_name_or_empty(c.callee);
        if (callee == name) {
          return true;
        }
        // A bare-ident ARGUMENT at a param proven to touch no ELEMENT of it
        // ("ELB:") is a borrow, not an escape. Reading it as one cost the
        // array its whole element walk: `rd(keep, r)` over a callee that only
        // reads `src.len()` measured 4 allocs / 2 frees against native's 4/4,
        // the payload stranded — the argument position alone, independent of
        // the binding source and of any loop.
        //
        // The plain box flag is NOT enough, the same as the arrenum twin. It
        // proves the callee never keeps the BOX, which licenses a box-only
        // release; this class's release walks the ELEMENTS. Reading
        // emit_arrstruct_deep_free suggests otherwise — its per-element step
        // is an rc-GATED field drop plus a plain __fern_rc_dec, and a dec
        // cannot over-free a box a second owner holds a COUNTED reference to.
        // That last word is the gap: an element handed out UNCOUNTED has no
        // such reference, and the box flag says nothing about it. Every
        // handout probe that could be written by hand reads clean on the box
        // flag; the compiler's own sources segfault gen2 in three fixpoint
        // programs. Ask the element question.
        //
        // "CNT:" admits a SECOND position, where "ELB:" refuses — the
        // arrenum twin's reasoning verbatim. A callee that STORES the array
        // in a struct literal keeps a reference, so the element flag says
        // no, but that store is COUNTED: the construction incs the array and
        // the holder's field drop decs it, leaving the caller's own claim
        // intact and its element walk still owed. Withholding it is the leak
        // (`struct_arr__param`, a constant 2 objects), not the safety.
        // param_counted_of's "DCNT:" tier proves the store counted, and
        // admits only where the element walk exists and no `p[i]` hands one
        // out.
        //
        // Free functions only — a method's receiver is a second borrow
        // question the tier does not answer.
        var eai: i32 = 0;
        while (eai < c.args.len()) {
          if (ident_name_or_empty(c.args[eai]) == name) {
            // A threader's position (#10420) hands the elements back only
            // through the result, which arrstruct_unsafe_for admits solely
            // as a rebind of `name` itself.
            if (!(param_is_borrowable(borrowable, "ELB:" + callee, eai)
              || param_is_borrowable(borrowable, "CNT:" + callee, eai)
              || util.index_of_str(producers, thread_row(eai, callee)) >= 0)) {
              return true;
            }
          } else if (arrstruct_elem_esc_expr(c.args[eai], name, sty, structs, msites, borrowable, sfok, producers)) {
            return true;
          }
          eai = eai + 1;
        }
        return false;
      },
      _ => {
        return true;
      }
    }
  }
  if (code == 6) {
    if let ast.ExprLambda(lm) = x {
      return arrstruct_elem_payload_escapes(lm.body, name, sty, structs, msites, borrowable, sfok, producers);
    }
    return true;
  }
  if (code == 5) {
    // The sanctioned self-store scans only the FIRST argument — `append`'s
    // element, `with`'s index. `with`'s element argument was vetted by
    // arrstruct_self_store_elem (a bare ident or a producer_elem_is_fresh one) and the
    // hand scan never walked it; preserved exactly.
    match (x) {
      ast.ExprCall(c) => {
        return arrstruct_elem_esc_expr(c.args[0], name, sty, structs, msites, borrowable, sfok, producers);
      },
      _ => {
        return true;
      }
    }
  }
  return false;
}

// arrstruct_elem_esc_expr: does `e` use the array-of-structs local `name` (element
// struct type `sty`) in a way that ESCAPES an owned field the reclaim would free? The
// leaf is an ELEMENT field access `name[i].f`: a scalar field is a safe value copy; an
// ARRAY / nested-struct / enum field extracted bare escapes. `name[i].f[j]` (indexed
// array-field read) and `name[i].f.len()` are borrows; a BARE `name[i]` element (the
// struct box) or a bare `name` escapes — except as an ARGUMENT at an "ELB:"-flagged
// param, where the callee is proven to touch no element.
function arrstruct_elem_esc_expr(e: ast.Expr, name: string, sty: string, structs: irtables.StructTab, msites: string[], borrowable: string[], sfok: string[], producers: string[]): boolean {
  function visit(x: ast.Expr, own esc: boolean): boolean {
    return arrstruct_elem_esc_at(x, esc, name, sty, structs, msites, borrowable, sfok, producers);
  }
  function descend(x: ast.Expr): boolean {
    return arrstruct_elem_esc_shape(x, name, sty, structs, msites, sfok, producers) == 0;
  }
  return astwalk.fold_expr_pruned(e, false, visit, descend);
}

// A `for p in name` iterable is not an escape here: arrstruct_row_escapes
// judges the iteration, and only its body is scanned.
function arrstruct_elem_payload_escapes(stmts: ast.Stmt[], name: string, sty: string, structs: irtables.StructTab, msites: string[], borrowable: string[], sfok: string[], producers: string[]): boolean {
  function visit(x: ast.Expr, own esc: boolean): boolean {
    return arrstruct_elem_esc_at(x, esc, name, sty, structs, msites, borrowable, sfok, producers);
  }
  function descend(x: ast.Expr): boolean {
    return arrstruct_elem_esc_shape(x, name, sty, structs, msites, sfok, producers) == 0;
  }
  function esc_expr(x: ast.Expr): boolean {
    return astwalk.fold_expr_pruned(x, false, visit, descend);
  }
  function esc_body(b: ast.Stmt[]): boolean {
    return arrstruct_elem_payload_escapes(b, name, sty, structs, msites, borrowable, sfok, producers);
  }
  for stmt in stmts {
    match (stmt) {
      ast.StmtFor(fo) => {
        if (!ident_named_is(fo.iter, name) && esc_expr(fo.iter)) {
          return true;
        }
        if (esc_body(fo.body)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (esc_expr(f.cond) || esc_body(f.then_body) || esc_body(f.else_body)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (esc_expr(w.cond) || esc_body(w.body)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        if (esc_expr(m.scrutinee)) {
          return true;
        }
        for arm in m.arms {
          if (arm.has_guard && esc_expr(arm.guard)) {
            return true;
          }
          if (esc_body(arm.body)) {
            return true;
          }
        }
      },
      ast.StmtDefer(d) => {
        if (esc_body([d.action])) {
          return true;
        }
      },
      _ => {
        if (astwalk.fold_stmt_pruned(stmt, false, visit, descend)) {
          return true;
        }
      }
    }
  }
  return false;
}

// ── ARRENUM: reclaim `MyEnum[]` array-of-enums locals (#5474 / #4353 item 4) ──
// The last missing array-of-X element kind. `string[]` (#5471), `struct[]`
// (ARRSTRUCT) and `(…)[]` (ARRTUP) all reclaim their elements; an enum array was
// left on a buffer-only dec, so the outer buffer was freed and every element enum
// box — and any rc payload it carried — leaked.
//
// Two things make this class its own machinery rather than another ARRSTRUCT:
//
//   - The per-element drop DISPATCHES on the variant at runtime, so it routes
//     emit_enum_variant_drops_gated rather than a type-directed __struct_drop_<T>.
//   - emit_enum_variant_drops_gated decs the element box ITSELF and zeroes the slot,
//     so this walk must NOT copy ARRTUP/ARRSTRUCT's trailing __fern_rc_dec on the
//     element. Copying it double-frees every element.
//
// The element enum name reaches the release side through the CREDIT
// ("ARRENUM:<local>#<Enum>"), not through the slot: an `E[]` slot records its
// element enum in neither `arrarr_elem` (populated only for `T[][]`, and only for
// four scalar tags) nor `struct_type`, and adding a slot column for one class is
// more surface than parsing a credit that is already per-name.

// arrenum_lit_enum: `e` is a non-empty array literal whose EVERY element is a fresh
// construction of the SAME enum (fresh_rcpayload_enum_init — the ctor forms the
// scalar-enum reclaim already admits, qualified and unqualified, call and unit),
// or a call to an "ENUM:" member of the enum `tname` annotates as `E[]`, whose
// result is a counted element the rc-gated walk releases. Returns that enum's
// name, else "". A bare-ident element would alias a live enum box the free
// could dangle, so it never qualifies.
function arrenum_lit_enum(e: ast.Expr, structs: irtables.StructTab, fresh_ret: string[], tname: string): string {
  match (e) {
    ast.ExprArray(arr) => {
      if (arr.elements.len() == 0) {
        return "";
      }
      var owner: string = "";
      var i: i32 = 0;
      while (i < arr.elements.len()) {
        var o: string = fresh_rcpayload_enum_init(arr.elements[i], structs, [], [], false);
        // An all-scalar enum's fresh ctor qualifies too (#7678): its
        // element release is a box-only free, so the same sole-owner
        // argument holds with no payload counting to prove.
        if (o.len() == 0) {
          o = fresh_scalar_enum_init(arr.elements[i], structs);
        }
        if (o.len() == 0 && enum_fresh_ret_call(arr.elements[i], fresh_ret)) {
          o = enum_array_type_elem(structs, tname);
        }
        if (o.len() == 0) {
          return "";
        }
        if (owner.len() == 0) {
          owner = o;
        }
        if (o != owner) {
          return "";
        }
        i = i + 1;
      }
      return owner;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// enum_array_type_elem: the declared enum `t` spells as `E[]`, or "".
function enum_array_type_elem(structs: irtables.StructTab, t: string): string {
  if (t.len() < 3 || slice_unchecked(t, t.len() - 2, t.len()) != "[]") {
    return "";
  }
  var en: string = slice_unchecked(t, 0, t.len() - 2) + "";
  if (!irtables.decl_is_enum(structs, en)) {
    return "";
  }
  return en;
}

// arrenum_scrut_elem_read: `e` is exactly `name[<idx>]`, an element read of the
// candidate array, with `name` appearing nowhere in the index. That is the one
// shape the match-scrutinee widening below admits.
function arrenum_scrut_elem_read(e: ast.Expr, name: string, borrowable: string[]): boolean {
  match (e) {
    ast.ExprIndex(ix) => {
      if (ident_name_or_empty(ix.array) != name) {
        return false;
      }
      return !arrenum_esc_expr(ix.index, name, borrowable);
    },
    _ => {
      return false;
    }
  }
}

// arrenum_binding_confined: the arm binding `bnd`, which names payload field `fi`
// of variant `vname`, cannot outlive its arm. A SCALAR payload is a value copy —
// storing it aliases nothing, so it is confined whatever the arm does with it,
// the same reading arrtup_elem_esc_shape gives a scalar tuple element. A POINTER
// payload has to prove itself borrow-only through binding_escapes_arm.
function arrenum_binding_confined(arm: ast.MatchArm, bnd: string, vname: string, fi: i32, structs: irtables.StructTab, borrowable: string[]): boolean {
  if (bnd == "" || bnd == "_") {
    return true;
  }
  if (irtables.is_scalar_type_name(irtables.decl_field_type_at(structs, vname, fi))) {
    return true;
  }
  return !binding_escapes_arm(arm, bnd, borrowable);
}

// arrenum_match_arms_borrow_only: every arm of `m` confines its pattern bindings
// to the arm, per arrenum_binding_confined.
//
// This is what makes `match (name[i])` safe to treat as a borrow (#8610). The
// element boxes are freed by the reclaim that runs AFTER the whole match, so a
// binding whose last use is inside its arm is already dead by then; a POINTER
// binding that is stored, returned or passed on outlives the arm and would
// dangle. An `@` binding names the whole element box rather than a payload, so it
// is refused outright rather than reasoned about.
function arrenum_match_arms_borrow_only(m: ast.StmtMatch, structs: irtables.StructTab, borrowable: string[]): boolean {
  for arm in m.arms {
    match (arm.pattern) {
      ast.PatVariant(pv) => {
        if (pv.at_binding.len() > 0) {
          return false;
        }
        // Strip a qualified `Payload.Some` to the bare variant name the
        // struct table records the payload fields under.
        var vname: string = pv.type_name;
        var vc: i32 = 0;
        while (vc < pv.type_name.len()) {
          if (pv.type_name[vc] == b'.') {
            vname = slice_unchecked(pv.type_name, vc + 1, pv.type_name.len()) + "";
          }
          vc = vc + 1;
        }
        if (!arrenum_binding_confined(arm, pv.binding, vname, 0, structs, borrowable)) {
          return false;
        }
        var ebi: i32 = 0;
        while (ebi < pv.extra_bindings.len()) {
          if (!arrenum_binding_confined(arm, pv.extra_bindings[ebi], vname, ebi + 1, structs, borrowable)) {
            return false;
          }
          ebi = ebi + 1;
        }
      },
      _ => {}
    }
  }
  return true;
}

// arrenum_esc_expr reports whether `e` uses `name` in ANY way other than as the
// receiver of `name.len()`.
//
// The hazard is a double-free rather than a leak: freeing an element while a
// binding still aliases its payload corrupts the self-compile. So every extraction
// — `xs[i]` bare, or a payload binding that outlives its arm — falls back to the
// leak-safe shallow dec.
//
// One extraction is admitted, and NOT here: `match (xs[i])` is vetted at the
// statement level by arrenum_append_escapes, which pairs it with
// arrenum_match_arms_borrow_only (#8610). This expression scan never sees that
// scrutinee, so it stays strict.
function arrenum_esc_expr(e: ast.Expr, name: string, borrowable: string[]): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      return id.name == name;
    },
    ast.ExprNumber(_) => {
      return false;
    },
    ast.ExprString(_) => {
      return false;
    },
    ast.ExprBool(_) => {
      return false;
    },
    ast.ExprUnknown(_) => {
      return false;
    },
    ast.ExprZero(_) => {
      return false;
    },
    ast.ExprMapLit(ml) => {
      var mi: i32 = 0;
      while (mi < ml.keys.len()) {
        if (arrenum_esc_expr(ml.keys[mi], name, borrowable) || arrenum_esc_expr(ml.vals[mi], name, borrowable)) {
          return true;
        }
        mi = mi + 1;
      }
      return false;
    },
    ast.ExprFString(fs) => {
      var fi: i32 = 0;
      while (fi < fs.exprs.len()) {
        if (fs.is_expr[fi] && arrenum_esc_expr(fs.exprs[fi], name, borrowable)) {
          return true;
        }
        fi = fi + 1;
      }
      return false;
    },
    ast.ExprBinary(b) => {
      return arrenum_esc_expr(b.left, name, borrowable) || arrenum_esc_expr(b.right, name, borrowable);
    },
    ast.ExprUnary(u) => {
      return arrenum_esc_expr(u.operand, name, borrowable);
    },
    ast.ExprCall(c) => {
      // `name.len()` — a header read that touches no element, so a borrow.
      match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
          if (cfa.field == "len") {
            match (cfa.obj) {
              ast.ExprIdent(rid) => {
                if (rid.name == name) {
                  for arg in c.args {
                    if (arrenum_esc_expr(arg, name, borrowable)) {
                      return true;
                    }
                  }
                  return false;
                }
              },
              _ => {}
            }
          }
        },
        _ => {}
      }
      if (arrenum_esc_expr(c.callee, name, borrowable)) {
        return true;
      }
      // A bare-ident ARGUMENT whose callee position is proven to touch no
      // ELEMENT of it ("ELB:") is a borrow, not an escape. The plain box
      // flag is NOT enough here and asking it would be a double free: it
      // says the callee never keeps the BOX, while this class's release
      // WALKS the element boxes and frees them, so a callee that merely
      // hands one out would leave the caller's walk dangling it. Free
      // functions only — a method's receiver is a second borrow question
      // this tier does not answer.
      var eb_callee: string = "";
      match (c.callee) {
        ast.ExprIdent(ecid) => {
          eb_callee = ecid.name;
        },
        _ => {}
      }
      var eai: i32 = 0;
      while (eai < c.args.len()) {
        var eb_bare: boolean = false;
        match (c.args[eai]) {
          ast.ExprIdent(eaid) => {
            if (eaid.name == name) {
              eb_bare = true;
            }
          },
          _ => {}
        }
        if (eb_bare) {
          // "CNT:" admits a SECOND position, where "ELB:" refuses: a
          // callee that STORES the array in a struct literal keeps a
          // reference, so the element flag says no, but that store is
          // a counted one — the construction incs the array and the
          // holder's field drop decs it — so the caller's own claim
          // is untouched and its walk is still owed. Withholding it
          // is the leak (`enum_arr__param`, a constant 2 objects),
          // not the safety. param_counted_of's "DCNT:" tier is what
          // proves the store counted, and it admits only where the
          // element walk exists and no `p[i]` hands one out.
          if (eb_callee.len() == 0
            || !(param_is_borrowable(borrowable, "ELB:" + eb_callee, eai)
            || param_is_borrowable(borrowable, "CNT:" + eb_callee, eai))) {
            return true;
          }
        } else if (arrenum_esc_expr(c.args[eai], name, borrowable)) {
          return true;
        }
        eai = eai + 1;
      }
      return false;
    },
    ast.ExprArray(a) => {
      var i: i32 = 0;
      while (i < a.elements.len()) {
        if (arrenum_esc_expr(a.elements[i], name, borrowable)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        if (arrenum_esc_expr(el, name, borrowable)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprIndex(x) => {
      return arrenum_esc_expr(x.array, name, borrowable) || arrenum_esc_expr(x.index, name, borrowable);
    },
    ast.ExprSlice(sl) => {
      return arrenum_esc_expr(sl.array, name, borrowable) || arrenum_esc_expr(sl.start, name, borrowable) || arrenum_esc_expr(sl.end, name, borrowable);
    },
    ast.ExprStructLit(sl) => {
      if (sl.has_base) {
        if (arrenum_esc_expr(sl.base, name, borrowable)) {
          return true;
        }
      }
      for fv in sl.field_values {
        if (arrenum_esc_expr(fv, name, borrowable)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprFieldAccess(fa) => {
      return arrenum_esc_expr(fa.obj, name, borrowable);
    },
    ast.ExprLambda(lm) => {
      // A lambda capturing the name carries it out of the frame entirely.
      var used: string[] = astwalk.collect_idents_expr(e, []);
      return util.index_of_str(used, name) >= 0;
    }
  }
  return true;
}

function arrenum_esc_stmt(st: ast.Stmt, name: string, borrowable: string[]): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return arrenum_esc_expr(v.init, name, borrowable);
    },
    ast.StmtAssign(a) => {
      // A reassignment of the name itself is not a read of it, but the value
      // is; the credit separately refuses reassigned names.
      if (a.target == name) {
        return true;
      }
      return arrenum_esc_expr(a.value, name, borrowable);
    },
    ast.StmtReturn(r) => {
      return arrenum_esc_expr(r.value, name, borrowable);
    },
    ast.StmtExpr(e) => {
      return arrenum_esc_expr(e.value, name, borrowable);
    },
    ast.StmtIf(f) => {
      if (arrenum_esc_expr(f.cond, name, borrowable)) {
        return true;
      }
      return arrenum_escapes(f.then_body, name, borrowable) || arrenum_escapes(f.else_body, name, borrowable);
    },
    ast.StmtWhile(w) => {
      if (arrenum_esc_expr(w.cond, name, borrowable)) {
        return true;
      }
      return arrenum_escapes(w.body, name, borrowable);
    },
    ast.StmtFor(fo) => {
      if (arrenum_esc_expr(fo.iter, name, borrowable)) {
        return true;
      }
      return arrenum_escapes(fo.body, name, borrowable);
    },
    ast.StmtMatch(m) => {
      // Any match over the name (or over anything mentioning it) extracts.
      if (arrenum_esc_expr(m.scrutinee, name, borrowable)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard) {
          if (arrenum_esc_expr(arm.guard, name, borrowable)) {
            return true;
          }
        }
        if (arrenum_escapes(arm.body, name, borrowable)) {
          return true;
        }
      }
      return false;
    },
    ast.StmtDefer(d) => {
      return arrenum_esc_stmt(d.action, name, borrowable);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function arrenum_escapes(stmts: ast.Stmt[], name: string, borrowable: string[]): boolean {
  for stmt in stmts {
    if (arrenum_esc_stmt(stmt, name, borrowable)) {
      return true;
    }
  }
  return false;
}

// arrenum_elem_read_of: `e` is exactly an indexed read `name[i]` whose index
// does not itself mention `name`; the admissible-extraction shape the two
// arms below share.
function arrenum_elem_read_of(e: ast.Expr, name: string): boolean {
  var no_reg: string[] = [];
  match (e) {
    ast.ExprIndex(x) => {
      match (x.array) {
        ast.ExprIdent(aid) => {
          if (aid.name == name) {
            return !arrenum_esc_expr(x.index, name, no_reg);
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  return false;
}

// elem_arm_bindings_confined: every binding a match arm takes from an admitted
// element read stays confined to its arm — vetted by binding_escapes_arm,
// the strict form (a bare re-bind or bare assign of the binding refuses;
// `.len()`, indexing, arithmetic over reads admit). The at-binding holds the
// ELEMENT BOX itself and gets the same vet: confined-to-the-arm means it dies
// before the caller's walk frees the box.
function elem_arm_bindings_confined(arm: ast.MatchArm): boolean {
  var no_reg: string[] = [];
  match (arm.pattern) {
    ast.PatVariant(pv) => {
      if (pv.binding.len() > 0 && pv.binding != "_" && binding_escapes_arm(arm, pv.binding, no_reg)) {
        return false;
      }
      var bi: i32 = 0;
      while (bi < pv.extra_bindings.len()) {
        var bn: string = pv.extra_bindings[bi];
        if (bn.len() > 0 && bn != "_" && binding_escapes_arm(arm, bn, no_reg)) {
          return false;
        }
        bi = bi + 1;
      }
      if (pv.at_binding.len() > 0 && pv.at_binding != "_" && binding_escapes_arm(arm, pv.at_binding, no_reg)) {
        return false;
      }
    },
    _ => {}
  }
  return true;
}

// arrenum_param_esc_expr: the expression half of arrenum_param_escapes. It
// widens arrenum_esc_expr in exactly ONE place — a zero-param IIFE, the shape
// the parser builds for an `if` / `match` in VALUE position. Such a body is
// lowered INLINE in the enclosing frame, or a hand-written one becomes a direct
// call taking its captures as arguments; neither builds an env box, so an
// element read inside it is the same read the statement form makes and earns
// the same admissions. Without it the lambda-capture arm reads the param as carried out of the frame entirely and
// refuses, which is why `return (match (src[0]) { … })` leaked where its
// statement sibling balanced. Every other form delegates to the stricter
// walker, so the widening cannot reach past this shape.
function arrenum_param_esc_expr(e: ast.Expr, name: string, body: ast.Stmt[]): boolean {
  var no_reg: string[] = [];
  match (e) {
    ast.ExprCall(c) => {
      if (irtables.is_iife_callee(c)) {
        match (c.callee) {
          ast.ExprLambda(lm) => {
            return arrenum_param_escapes(lm.body, name, body);
          },
          _ => {}
        }
      }
      return arrenum_esc_expr(e, name, no_reg);
    },
    ast.ExprBinary(b) => {
      return arrenum_param_esc_expr(b.left, name, body) || arrenum_param_esc_expr(b.right, name, body);
    },
    ast.ExprUnary(u) => {
      return arrenum_param_esc_expr(u.operand, name, body);
    },
    _ => {
      return arrenum_esc_expr(e, name, no_reg);
    }
  }
  return arrenum_esc_expr(e, name, no_reg);
}

// arrenum_param_escapes: arrenum_escapes for the "ELB:" flag question only —
// the callee-side walk of a borrowed array-of-boxes PARAM, widened with the
// extract-then-die admissions the borrowed-arg suites' callee_extracts_element
// rows name. Two shapes of an element read `name[i]` are admitted:
//
//   - the exact scrutinee of a `match`, when every arm binding (payloads and
//     the at-binding) is confined to its arm (elem_arm_bindings_confined);
//   - the whole init of `var e = name[i]`, when the local is confined by the
//     same proof pair the box flag trusts for a param name —
//     body_unsafe_for_match_borrow (a bare-ident `match (e)` is a borrow) and
//     param_match_binding_escapes (its arms' bindings stay confined).
//
// In both, the extracted box dies inside the callee before the CALLER's
// element walk frees it. Every other position of `name[i]` — a struct-literal
// slot, an append or call argument, a return value — stays an escape: that
// boundary is what keeps element_handed_out refused, and weakening it was a
// measured rc underflow (exit 99) with a perfect-looking census. All inner
// proofs run under empty registries, so the flag this feeds stays
// registry-independent and the interproc fixpoint cannot oscillate.
function arrenum_param_escapes(stmts: ast.Stmt[], name: string, body: ast.Stmt[]): boolean {
  var no_reg: string[] = [];
  for stmt in stmts {
    var st_esc: boolean = true;
    match (stmt) {
      ast.StmtVar(v) => {
        var whole_alias: boolean = false;
        match (v.init) {
          ast.ExprIdent(vaid) => {
            if (vaid.name == name) {
              whole_alias = true;
            }
          },
          _ => {}
        }
        if (arrenum_elem_read_of(v.init, name)
          && !body_unsafe_for_match_borrow(body, v.name, no_reg, no_reg, [])
          && !param_match_binding_escapes(body, v.name, "", irtables.struct_tab_empty())) {
          st_esc = false;
        } else if (whole_alias && !arrenum_param_escapes(body, v.name, body)) {
          // A whole-array alias (`var x = src`) is admissible when the
          // alias itself passes this same walk — its element reads get
          // the admissions above, its bare uses (a return, a store, an
          // append) refuse. Recursion is bounded by the def chain: the
          // alias's own walk asks about x, and only another
          // `var y = x` recurses further down it.
          st_esc = false;
        } else {
          st_esc = arrenum_param_esc_expr(v.init, name, body);
        }
      },
      ast.StmtAssign(a) => {
        if (a.target == name) {
          st_esc = true;
        } else {
          st_esc = arrenum_param_esc_expr(a.value, name, body);
        }
      },
      ast.StmtReturn(r) => {
        st_esc = arrenum_param_esc_expr(r.value, name, body);
      },
      ast.StmtExpr(e) => {
        st_esc = arrenum_param_esc_expr(e.value, name, body);
      },
      ast.StmtIf(f) => {
        st_esc = arrenum_esc_expr(f.cond, name, no_reg)
          || arrenum_param_escapes(f.then_body, name, body)
          || arrenum_param_escapes(f.else_body, name, body);
      },
      ast.StmtWhile(w) => {
        st_esc = arrenum_esc_expr(w.cond, name, no_reg) || arrenum_param_escapes(w.body, name, body);
      },
      ast.StmtFor(fo) => {
        st_esc = arrenum_esc_expr(fo.iter, name, no_reg) || arrenum_param_escapes(fo.body, name, body);
      },
      ast.StmtMatch(m) => {
        var m_esc: boolean = false;
        if (arrenum_elem_read_of(m.scrutinee, name)) {
          for arm in m.arms {
            if (!elem_arm_bindings_confined(arm)) {
              m_esc = true;
            }
            if (arm.has_guard && arrenum_esc_expr(arm.guard, name, no_reg)) {
              m_esc = true;
            }
            if (arrenum_param_escapes(arm.body, name, body)) {
              m_esc = true;
            }
          }
        } else {
          m_esc = arrenum_esc_expr(m.scrutinee, name, no_reg);
          if (!m_esc) {
            for arm in m.arms {
              if (arm.has_guard && arrenum_esc_expr(arm.guard, name, no_reg)) {
                m_esc = true;
              }
              if (arrenum_param_escapes(arm.body, name, body)) {
                m_esc = true;
              }
            }
          }
        }
        st_esc = m_esc;
      },
      ast.StmtDefer(d) => {
        var dl: ast.Stmt[] = [d.action];
        st_esc = arrenum_param_escapes(dl, name, body);
      },
      _ => {
        st_esc = false;
      }
    }
    if (st_esc) {
      return true;
    }
  }
  return false;
}

// ── the APPEND-BUILT half of the arrenum class ───────────────────────────────
//
// `var xs: E[] = []` grown by `xs = xs.append(E.A(..))`. arrenum_lit_enum rejects
// `[]` (no elements to prove fresh), which was right for a literal-only credit
// but left every append-built enum array uncredited and leaking its whole
// structure — the shape any code that computes its elements has to use.
//
// The per-element rule is the SAME one the literal applies
// (fresh_rcpayload_enum_init): a bare ident element would alias a live enum box
// the element walk could dangle, and this class's walk frees the element box
// itself. So the credit granted is the same "ARRENUM:" — there is no extra
// condition on the append form the way slot_is_reclaimable_structarr has one, and
// emit_arrenum_reclaim_store is already cow-guarded (old != new), which is the
// piece that makes a self-append rebind safe.
//
// `with` is NOT admitted here, unlike arrstruct's: it REPLACES, so the superseded
// element has to be released at the store, and this class's element release is a
// variant dispatch that frees the box rather than a dec. That is its own slice.

// arrenum_lit_is_empty: `e` is the `[]` an append-built array starts from.
function arrenum_lit_is_empty(e: ast.Expr): boolean {
  match (e) {
    ast.ExprArray(arr) => {
      return arr.elements.len() == 0;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// arrenum_self_append_elem: `e` is `name.append(<fresh ctor of ename>)`, and the
// appended element mentions `name` nowhere (so `xs.append(E.A(xs[0]))` is refused
// by the same walk the escape gate uses).
function arrenum_self_append_elem(e: ast.Expr, name: string, structs: irtables.StructTab, ename: string, borrowable: string[]): boolean {
  match (e) {
    ast.ExprCall(c) => {
      if (c.args.len() != 1) {
        return false;
      }
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field != "append") {
            return false;
          }
          match (fa.obj) {
            ast.ExprIdent(rid) => {
              if (rid.name != name) {
                return false;
              }
              if (arrenum_esc_expr(c.args[0], name, borrowable)) {
                return false;
              }
              if (fresh_rcpayload_enum_init(c.args[0], structs, [], [], false) == ename) {
                return true;
              }
              // The all-scalar sibling of the line above (#7678).
              return fresh_scalar_enum_init(c.args[0], structs) == ename;
            },
            _ => {
              return false;
            }
          }
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

// arrenum_name_is_appended: at least one sanctioned self-append of `name`.
function arrenum_name_is_appended(stmts: ast.Stmt[], name: string, structs: irtables.StructTab, ename: string, borrowable: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(a) => {
        if (a.target == name && arrenum_self_append_elem(a.value, name, structs, ename, borrowable)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (arrenum_name_is_appended(f.then_body, name, structs, ename, borrowable)) {
          return true;
        }
        if (arrenum_name_is_appended(f.else_body, name, structs, ename, borrowable)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (arrenum_name_is_appended(w.body, name, structs, ename, borrowable)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (arrenum_name_is_appended(fo.body, name, structs, ename, borrowable)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (arrenum_name_is_appended(arm.body, name, structs, ename, borrowable)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

// arrenum_counted_field_share: `e` is a struct literal that mentions `name` ONLY
// as the bare-ident value of a field whose declared type is an ARRAY OF ENUMS.
// The construction retains such a field — `is_array_type_name` covers `E[]` in the
// ExprStructLit fallback arm, so the alias-inc fires even though the gate above it
// names only scalar- and struct-arrays — so the field holds a COUNTED share, and
// reading it as an escape cost the source its whole reclaim.
//
// Both releases are rc-gated, which is what makes granting this safe rather than a
// double free: the holder's walk is __enum_arr_elems_drop_<E>, which is_unique-gates
// the buffer, and the source's is emit_arrenum_deep_free, now gated the same way.
// The stakes are higher than the struct sibling's — this walk FREES each element
// box — so both halves are a hard requirement, not an optimisation.
//
// Refused for a `{ ...base }` update (the copied fields carry no inc) and for a
// MOVED share. The move refusal is the one the struct sibling learned from a gen2
// segfault: the retain is move-gated (#6726), so at a move site the box takes over
// the local's reference and both the inc and the sweep dec are dropped — and this
// credit routes emit_arrenum_deep_free rather than that plain dec, so granting it
// there frees a buffer whose ownership left the frame. `return T { f: xs, … }` is
// that shape, because the return is the source's last use.
function arrenum_counted_field_share(e: ast.Expr, name: string, structs: irtables.StructTab, msites: string[], borrowable: string[]): boolean {
  match (e) {
    ast.ExprStructLit(sl) => {
      if (sl.has_base) {
        return false;
      }
      var seen: boolean = false;
      var i: i32 = 0;
      while (i < sl.field_values.len()) {
        match (sl.field_values[i]) {
          ast.ExprIdent(fid) => {
            if (fid.name == name) {
              if (!irtables.is_enum_array_field_type(structs, irtables.decl_field_type(structs, sl.type_name, sl.field_names[i]))) {
                return false;
              }
              if (moved_ident_at(sl.field_values[i], msites)) {
                return false;
              }
              seen = true;
            }
          },
          _ => {
            if (arrenum_esc_expr(sl.field_values[i], name, borrowable)) {
              return false;
            }
          }
        }
        i = i + 1;
      }
      return seen;
    },
    _ => {
      return false;
    }
  }
  return false;
}

// arrenum_append_escapes: arrenum_escapes with exactly one sanctioned use — the
// self-append rebind. Only the assign case differs; everything else delegates, so
// the class keeps its deliberately tight "only xs.len()" rule everywhere else.
function arrenum_append_escapes(stmts: ast.Stmt[], name: string, structs: irtables.StructTab, ename: string, msites: string[], allow_ret: boolean, borrowable: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (!arrenum_counted_field_share(v.init, name, structs, msites, borrowable)) {
          if (arrenum_esc_expr(v.init, name, borrowable)) {
            return true;
          }
        }
      },
      ast.StmtReturn(r) => {
        // `return name` is a move-out, safe when the caller is asking the
        // PRODUCER question (arrenum_producer_ret_local). For the local
        // credit it is an escape like any other and delegates below.
        var ret_ok: boolean = false;
        match (r.value) {
          ast.ExprIdent(rid) => {
            ret_ok = allow_ret && rid.name == name;
          },
          _ => {}
        }
        if (!ret_ok && !arrenum_counted_field_share(r.value, name, structs, msites, borrowable)
          && arrenum_esc_expr(r.value, name, borrowable)) {
          return true;
        }
      },
      ast.StmtExpr(e) => {
        if (!arrenum_counted_field_share(e.value, name, structs, msites, borrowable)
          && arrenum_esc_expr(e.value, name, borrowable)) {
          return true;
        }
      },
      ast.StmtAssign(a) => {
        if (a.target == name) {
          if (!arrenum_self_append_elem(a.value, name, structs, ename, borrowable)) {
            return true;
          }
        } else if (!arrenum_counted_field_share(a.value, name, structs, msites, borrowable)
          && arrenum_esc_expr(a.value, name, borrowable)) {
          return true;
        }
      },
      ast.StmtIf(f) => {
        if (arrenum_esc_expr(f.cond, name, borrowable)) {
          return true;
        }
        if (arrenum_append_escapes(f.then_body, name, structs, ename, msites, allow_ret, borrowable)) {
          return true;
        }
        if (arrenum_append_escapes(f.else_body, name, structs, ename, msites, allow_ret, borrowable)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (arrenum_esc_expr(w.cond, name, borrowable)) {
          return true;
        }
        if (arrenum_append_escapes(w.body, name, structs, ename, msites, allow_ret, borrowable)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (arrenum_esc_expr(fo.iter, name, borrowable)) {
          return true;
        }
        if (arrenum_append_escapes(fo.body, name, structs, ename, msites, allow_ret, borrowable)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        // `match (name[i])` reads an element box as a BORROW, admitted when
        // every arm's bindings stay inside their arm (#8610). Without this
        // the whole class fell back to the shallow dec and leaked every
        // element box, per round.
        var aem_elem: boolean = arrenum_scrut_elem_read(m.scrutinee, name, borrowable);
        if (aem_elem) {
          if (!arrenum_match_arms_borrow_only(m, structs, borrowable)) {
            return true;
          }
        } else if (arrenum_esc_expr(m.scrutinee, name, borrowable)) {
          return true;
        }
        for arm in m.arms {
          if (arm.has_guard && arrenum_esc_expr(arm.guard, name, borrowable)) {
            return true;
          }
          if (arrenum_append_escapes(arm.body, name, structs, ename, msites, allow_ret, borrowable)) {
            return true;
          }
        }
      },
      _ => {
        if (arrenum_esc_stmt(stmt, name, borrowable)) {
          return true;
        }
      }
    }
  }
  return false;
}

// --- struct in-place reuse (FBIP): functional-update self-overwrite ---------
//
// Native's struct_reuse / computeReuseSources (ir.go ~3661): pair a freed box
// with a same-shape construction so the construction REUSES the box instead of
// free-then-alloc. This is the first, most contained slice — the
// functional-update self-overwrite: for `var c = T { ...d, f: v }` where `d` is
// a struct local of the SAME type T that is fresh, non-escaping (reclaimable),
// and DEAD after this statement (its last use is this update), reuse d's box in
// place: write only the overridden fields into d's box, leave the rest (already
// correct in d's box), make c be d's box, and zero d's slot so the exit sweep
// frees the box once (through c), never twice.
//
// Restricted to a SOUND case: T's fields are each either a flat scalar (i32 /
// boolean / i64 / f64 / u32 / u64 — leak-only, no rc) OR a leak-safe array field
// (i32[] / boolean[] / i64[] / f64[] — rc-tracked, deep-dropped on the struct's
// reclamation by emit_struct_field_drops). The base is a bare ident of a
// reclaimable same-type local, the override values do not themselves reference d,
// every override that targets an array field is a FRESH array literal, and d is
// referenced nowhere in the rest of the body. Anything else (string / nested-
// struct / struct-array / map / option / tuple fields, or an array-field override
// that isn't a fresh literal) falls back to the existing alloc-a-new-box path
// (unchanged behaviour). Soundness is gated by the byte-identical self-compile
// fixpoint.
//
// The one extra correctness rule vs the scalar-only slice: an OVERRIDDEN array
// field's OLD value in d's box must be released (dec) before the new value is
// written, or it leaks. Non-overridden array fields stay in d's box and move to c
// (deep-dropped at c's reclamation). See emit_self_overwrite_reuse.

// reuse_field_is_scalar: a flat leak-only scalar field (no rc) — i32 / boolean /
// the 8-byte i64 / f64 and the u32 / u64 widths.
function reuse_field_is_scalar(t: string): boolean {
  return t == "i32" || t == "boolean" || t == "i64" || t == "f64" || t == "u32" || t == "u64";
}

// fresh_struct_lit_type_deep: the nesting-aware sibling — finds `name`'s
// declaration(s) anywhere in the body (loop / if / match / defer bodies
// included) and returns the no-base struct-lit type they were bound from,
// or "" when any binding is a different shape or a different type (a
// shadowed / branch-divergent name stays conservatively untyped). Used by
// the NODEEP exemption in reclaimable_names_of, whose candidates include
// loop-nested locals the top-level-only lookup above can't see.
function fresh_struct_lit_type_deep(stmts: ast.Stmt[], name: string): string {
  var tys: string[] = fresh_struct_lit_types_acc(stmts, name, []);
  if (tys.len() == 0) {
    return "";
  }
  var t0: string = tys[0];
  var i: i32 = 1;
  while (i < tys.len()) {
    if (tys[i] != t0) {
      return "";
    }
    i = i + 1;
  }
  return t0;
}

function fresh_struct_lit_types_acc(stmts: ast.Stmt[], name: string, acc: string[]): string[] {
  var a: string[] = acc;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          match (v.init) {
            ast.ExprStructLit(sl) => {
              if (sl.has_base) {
                a = a.append("");
              } else {
                a = a.append(sl.type_name);
              }
            },
            _ => {
              a = a.append("");
            }
          }
        }
      },
      ast.StmtIf(iff) => {
        a = fresh_struct_lit_types_acc(iff.then_body, name, a);
        a = fresh_struct_lit_types_acc(iff.else_body, name, a);
      },
      ast.StmtWhile(w) => {
        a = fresh_struct_lit_types_acc(w.body, name, a);
      },
      ast.StmtFor(fo) => {
        a = fresh_struct_lit_types_acc(fo.body, name, a);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          a = fresh_struct_lit_types_acc(arm.body, name, a);
        }
      },
      ast.StmtDefer(d) => {
        a = fresh_struct_lit_types_acc([d.action], name, a);
      },
      _ => {}
    }
  }
  return a;
}

// --- `?`-consumed fresh source-box reclaim (#4355) -----------------------------
//
// `mk(pre)?` evaluates the callee's Option/Result box into a $try temp, reads
// the success payload, and the box is dead — but it was never dec'd, so a
// per-iteration `?` leaked one box per success (and, for Option, one None box
// per failure). Mirrors native's reclaimableTryScrutinee/emitTryBoxFree.
// The self-host IR path has NO return-transfer inc (a callee returning its
// param hands back an rc==1 alias a runtime rc gate cannot distinguish from a
// fresh box), so freshness is proven STATICALLY: every return in the callee
// must be a DIRECT Ok/Err/Some constructor or None — each allocates a fresh
// rc-headered box (op_opt_make / op_opt_none), so the caller's `?` is the sole
// owner and a shallow __fern_rc_dec at the consume edge frees exactly once.

// arrenum_producer_enum: the element enum of an array-of-enums producer, or "".
// The return type is `E[]` for an enum the element walk admits
// (enum_arr_elems_walk_ok — every payload a scalar or a leak-safe array, the one
// kind whose construction counting is guaranteed), and EVERY return is a fresh
// `[E.A(..), …]` literal of that same enum.
//
// Literal-only, like ARRSTRUCTF: was before the append-built arm: a returned
// container's co-owner would be a local of the frame being left, so soleness needs
// the fresh-literal evidence rather than a count. The append-built shape is the
// next slice and needs the ARRENUMA: local credit first — a self-append is a
// reassignment, which collect_fresh_arrenum_names excludes outright today.
function arrenum_producer_enum(fn: parser.FuncDecl, structs: irtables.StructTab): string {
  if (fn.receiver_type.len() > 0) {
    return "";
  }
  var rt: string = fn.ret_type;
  if (rt.len() < 3) {
    return "";
  }
  if (slice_unchecked(rt, rt.len() - 2, rt.len()) != "[]") {
    return "";
  }
  var ename: string = slice_unchecked(rt, 0, rt.len() - 2) + "";
  if (!enum_arr_release_walk_ok(structs, ename)) {
    return "";
  }
  if (!body_has_return(fn.body)) {
    return "";
  }
  if (body_has_nonfresh_arrenum_return(fn.body, fn.body, structs, ename, [])) {
    return "";
  }
  return ename;
}

// arrenum_producer_ret_local: `name` is a local this body builds by self-append
// and hands back. The strictness the producer registry needs is already in
// arrenum_self_append_elem, which admits only a fresh ctor element — there is no
// bare-ident laxity here for a returned container's co-owner to exploit, so the
// same predicate serves both questions.
function arrenum_producer_ret_local(fnbody: ast.Stmt[], name: string, structs: irtables.StructTab, ename: string): boolean {
  if (!arrenum_local_empty_init(fnbody, name)) {
    return false;
  }
  if (!arrenum_name_is_appended(fnbody, name, structs, ename, [])) {
    return false;
  }
  return !arrenum_append_escapes(fnbody, name, structs, ename, [], true, []);
}

// arrenum_local_empty_init: `name` is declared IN this body from `[]`. Requiring
// the declaration to be here is what keeps the soleness proof local — a param, or
// a name from an enclosing scope, is already owned by someone else.
function arrenum_local_empty_init(stmts: ast.Stmt[], name: string): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          return arrenum_lit_is_empty(v.init);
        }
      },
      ast.StmtIf(f) => {
        if (arrenum_local_empty_init(f.then_body, name)) {
          return true;
        }
        if (arrenum_local_empty_init(f.else_body, name)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (arrenum_local_empty_init(w.body, name)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (arrenum_local_empty_init(fo.body, name)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (arrenum_local_empty_init(arm.body, name)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

// body_has_nonfresh_arrenum_return: any return whose value is NOT an
// array-of-enums the callee owns outright — a fresh literal of `ename`, or a
// local this body built by self-append. `fnbody` stays the whole function body so
// a return nested in a block can still find that local's declaration.
function body_has_nonfresh_arrenum_return(stmts: ast.Stmt[], fnbody: ast.Stmt[], structs: irtables.StructTab, ename: string, borrowable: string[]): boolean {
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        if (arrenum_lit_enum(r.value, structs, [], "") != ename) {
          match (r.value) {
            ast.ExprIdent(rid) => {
              if (!arrenum_producer_ret_local(fnbody, rid.name, structs, ename)) {
                return true;
              }
            },
            _ => {
              return true;
            }
          }
        }
      },
      ast.StmtIf(f) => {
        if (body_has_nonfresh_arrenum_return(f.then_body, fnbody, structs, ename, borrowable) || body_has_nonfresh_arrenum_return(f.else_body, fnbody, structs, ename, borrowable)) {
          return true;
        }
      },
      ast.StmtWhile(w) => {
        if (body_has_nonfresh_arrenum_return(w.body, fnbody, structs, ename, borrowable)) {
          return true;
        }
      },
      ast.StmtFor(fo) => {
        if (body_has_nonfresh_arrenum_return(fo.body, fnbody, structs, ename, borrowable)) {
          return true;
        }
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (body_has_nonfresh_arrenum_return(arm.body, fnbody, structs, ename, borrowable)) {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  return false;
}

// --- replaced-string-field reclaim admission (#4355) ---------------------------
//
// The __field_reclaim_<T> string arm frees a REPLACED string field at rc==1.
// That is sound only if no read of the field can outlive the box chain: the
// self-host has no read-side alias-inc discipline for strings, so a field
// read that ESCAPES (a retaining call arg, a return, a container/struct store,
// a slice/trim view) is an UNCOUNTED alias the free would dangle — the
// per-module compiler self-run segfaulted on exactly this (its own
// LowerState/EmitState string fields are passed to helpers everywhere).
// strfld_reclaim_ok_types_of therefore admits a type's string arm only when
// EVERY read of its string-field NAMES, across the WHOLE program, is a
// provable transient borrow: a binary operand (concat/compare), a byte-index
// base, the receiver of a read-only / fresh-copy string method, a BORROWABLE
// call-argument position (#6703), a direct `var t = x.f` init (retained by
// the #4768 read-side alias-inc), or a direct `t = x.f` reassign (retained by
// str_field_reassign_retains). The walk is field-NAME-keyed and
// obj-type-blind — a same-named field on another type over-excludes (sound).
// Callers must pass the WHOLE-PROGRAM func list (all_funcs on the per-module
// paths); a partial list would under-count the reads and re-open the UAF.

// strfld_mark: record e's field name as unsafely read (dedup'd), then keep
// walking its receiver chain.
function strfld_mark(e: ast.Expr, acc: string[]): string[] {
  var a: string[] = acc;
  match (e) {
    ast.ExprFieldAccess(fa) => {
      a = push_str_unique(a, fa.field);
      a = strfld_collect_unsafe(fa.obj, a);
    },
    _ => {}
  }
  return a;
}

// strfld_safe_operand: the DIRECT read in this position is a transient
// borrow — skip marking it, but keep walking beneath it (its obj chain and
// any nested expressions).
function strfld_safe_operand(e: ast.Expr, acc: string[]): string[] {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      return strfld_collect_unsafe(fa.obj, acc);
    },
    _ => {}
  }
  return strfld_collect_unsafe(e, acc);
}

// strfld_defer_arg parks the verdict on `callee(… <field> …)` at position
// `idx` — a borrowable position is a transient borrow, any other retains — as
// a "?<callee>#<idx>:<field>" record in the same accumulator. The record is
// inert for every exact field-name lookup, so it does not admit anything on
// its own; strfld_resolve_deferred turns the non-borrowable ones into marks.
// A field already marked cannot be un-marked by any verdict, so it parks
// nothing — which is what keeps the record count (and the resolve's registry
// walks) proportional to the fields that can still change the answer.
function strfld_defer_arg(acc: string[], callee: string, idx: i32, field: string): string[] {
  if (util.index_of_str(acc, field) >= 0) {
    return acc;
  }
  return push_str_unique(acc, "?" + callee + "#" + util.i32_to_string(idx) + ":" + field);
}

// strfld_resolve_deferred settles every parked call-argument record against
// the borrowability registry: a field handed to a position the callee only
// reads stays admissible, every other one marks. `borrowable_params_of` admits
// a param only when the callee provably never returns, stores, SLICES or
// captures it — the slice exclusion is what makes this sound for strings
// specifically, a view into the buffer being the one alias a later
// `__fern_str_free` would dangle.
function strfld_resolve_deferred(names: string[], borrowable: string[]): string[] {
  var a: string[] = names;
  var n: i32 = names.len();
  var i: i32 = 0;
  while (i < n) {
    var e: string = names[i];
    if (e.len() > 0 && e[0] == b'?') {
      var h: i32 = 1;
      while (h < e.len() && e[h] != b'#') {
        h = h + 1;
      }
      var c: i32 = h + 1;
      var idx: i32 = 0;
      while (c < e.len() && e[c] != b':') {  // 48 = '0'
        idx = idx * 10 + (e[c] as i32 - 48);
        c = c + 1;
      }
      if (c < e.len() && h < e.len()) {
        if (!param_is_borrowable(borrowable, slice_unchecked(e, 1, h), idx)) {
          a = push_str_unique(a, slice_unchecked(e, c + 1, e.len()));
        }
      }
    }
    i = i + 1;
  }
  return a;
}

// strfld_collect_unsafe walks one expression and accumulates every field
// NAME read in a position that could outlive its box (see the section
// comment). A bare ExprFieldAccess reached here — i.e. not consumed by one
// of the safe parents (binary operand, byte-index base, read-only /
// fresh-copy method receiver, direct var-init) — is unsafe by default.
function strfld_collect_unsafe(e: ast.Expr, acc: string[]): string[] {
  var a: string[] = acc;
  match (e) {
    ast.ExprFieldAccess(_) => {
      return strfld_mark(e, a);
    },
    ast.ExprBinary(b) => {
      // direct operands borrow (concat copies bytes, compares read).
      a = strfld_safe_operand(b.left, a);
      return strfld_safe_operand(b.right, a);
    },
    ast.ExprUnary(u) => {
      return strfld_collect_unsafe(u.operand, a);
    },
    ast.ExprIndex(ix) => {
      // x.f[i] byte read borrows the base.
      a = strfld_safe_operand(ix.array, a);
      return strfld_collect_unsafe(ix.index, a);
    },
    ast.ExprSlice(sl) => {
      // a slice/trim of a field is a VIEW aliasing the buffer — unsafe.
      a = strfld_collect_unsafe(sl.array, a);
      match (sl.array) {
        ast.ExprFieldAccess(_) => {
          a = strfld_mark(sl.array, a);
        },
        _ => {}
      }
      a = strfld_collect_unsafe(sl.start, a);
      return strfld_collect_unsafe(sl.end, a);
    },
    ast.ExprCall(c) => {
      // Free calls only: the borrowability registry is keyed by function
      // name, and a method's params are not in it.
      var callee_name: string = "";
      match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
          if (str_borrowing_method(cfa.field)) {
            a = strfld_safe_operand(cfa.obj, a);
          } else {
            a = strfld_collect_unsafe(cfa.obj, a);
            match (cfa.obj) {
              ast.ExprFieldAccess(_) => {
                a = strfld_mark(cfa.obj, a);
              },
              _ => {}
            }
          }
        },
        ast.ExprIdent(cid) => {
          callee_name = cid.name;
        },
        _ => {
          a = strfld_collect_unsafe(c.callee, a);
        }
      }
      // An argument may retain the value (helpers, appends, map sets are
      // all calls), so a direct read there is unsafe by default — unless
      // the position is BORROWABLE, which is the same warrant the method
      // receiver above gets. The verdict lives in a registry this walk
      // does not carry: threading it through cost the per-module emit-all
      // ~170 s of walk time on its own (#6703), so the site is PARKED as
      // a "?callee#idx:field" record and strfld_resolve_deferred settles
      // every one of them, once, after the walk.
      var ai: i32 = 0;
      while (ai < c.args.len()) {
        var deferred: boolean = false;
        if (callee_name.len() > 0) {
          match (c.args[ai]) {
            ast.ExprFieldAccess(fa2) => {
              a = strfld_defer_arg(a, callee_name, ai, fa2.field);
              a = strfld_collect_unsafe(fa2.obj, a);
              deferred = true;
            },
            _ => {}
          }
        }
        if (!deferred) {
          a = strfld_collect_unsafe(c.args[ai], a);
        }
        ai = ai + 1;
      }
      return a;
    },
    _ => {}
  }
  return a;
}

function strfld_assign_value(v: ast.Expr, acc: string[]): string[] {
  if (is_direct_ident_field_read(v)) {
    return strfld_safe_operand(v, acc);
  }
  return strfld_collect_unsafe(v, acc);
}

// strfld_collect_unsafe_stmts: single-pass statement walk. A direct
// `var t = x.f` init is SAFE (the #4768 read-side retain incs it), and so is a
// direct REASSIGN `t = x.f`, which retains whenever x's type routes field
// reclaim (str_field_reassign_retains) — every type this scan admits does.
function strfld_collect_unsafe_stmts(stmts: ast.Stmt[], acc: string[]): string[] {
  var a: string[] = acc;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        a = strfld_safe_operand(v.init, a);
      },
      ast.StmtReturn(r) => {
        a = strfld_collect_unsafe(r.value, a);
      },
      ast.StmtAssign(as2) => {
        a = strfld_assign_value(as2.value, a);
      },
      ast.StmtExpr(ex) => {
        a = strfld_collect_unsafe(ex.value, a);
      },
      ast.StmtIf(iff) => {
        a = strfld_collect_unsafe(iff.cond, a);
        a = strfld_collect_unsafe_stmts(iff.then_body, a);
        a = strfld_collect_unsafe_stmts(iff.else_body, a);
      },
      ast.StmtWhile(w) => {
        a = strfld_collect_unsafe(w.cond, a);
        a = strfld_collect_unsafe_stmts(w.body, a);
      },
      ast.StmtFor(fo) => {
        a = strfld_collect_unsafe(fo.iter, a);
        a = strfld_collect_unsafe_stmts(fo.body, a);
      },
      ast.StmtMatch(m) => {
        a = strfld_collect_unsafe(m.scrutinee, a);
        for arm in m.arms {
          if (arm.has_guard) {
            a = strfld_collect_unsafe(arm.guard, a);
          }
          a = strfld_collect_unsafe_stmts(arm.body, a);
        }
      },
      _ => {}
    }
  }
  return a;
}

// struct_routes_field_reclaim_at is the same question without a LowerState, so
// the whole-program registry passes can ask it. The construction-side string
// retain is gated on this verdict (slit_reclaim), so any analysis that decides a
// string field store COUNTS has to consult the same one — a credit the retain
// does not honour is an over-release, not a missed optimisation.
pub function struct_routes_field_reclaim_at(structs: irtables.StructTab, sfok: string[], sty: string): boolean {
  if (struct_has_reclaim_array_field(structs, sty)) {
    return true;
  }
  // A direct TUPLE field whose shape is deep-droppable: routes so the
  // IR-level emit_struct_tuple_field_drops reaches it. The construction
  // retain reads this very predicate (slit_reclaim). The asm __struct_drop
  // ladder has no tuple arm — every k_* test is false for a "(…)" type — so
  // the IR side owns the child walk AND the box dec with no second releaser.
  //
  // Removing this clause looks free and is not. With it knocked out, BOTH
  // leak matrices, the tuple / rc-tuple / construction-retain /
  // container-sink / census suites and the stage-2 fixpoint all pass —
  // because no corpus here contains a struct whose tuple field carries a
  // STRUCT element, the shape only this clause admits (via
  // struct_has_reclaim_array_field on the element type). It costs 12800 bytes
  // per 100 rounds. TestSelfHostTupleStructElemFieldX86_64 is what moves.
  if (struct_has_deep_tuple_field(structs, sty)) {
    return true;
  }
  // string[]-fielded type admitted by the strarrfld scan (the "arr:"-tagged
  // half of strfld_reclaim_ok_types_of) — routes so the backend
  // __struct_drop k_str_arr arm reaches the field.
  if (struct_has_strarr_field(structs, sty)
    && reclaim_has(sfok, "arr:", sty)) {
    return true;
  }
  // fn-fielded (closure) type admitted by the clofld scan ("clo:"-tagged) —
  // routes so the backend k_clo arm shallow-frees the field's env box.
  if (struct_has_clo_field(structs, sty)
    && reclaim_has(sfok, "clo:", sty)) {
    return true;
  }
  return struct_has_string_field(structs, sty)
    && reclaim_has(sfok, "", sty);
}

// strfld_reclaim_ok_types_of: struct types whose __field_reclaim_<T> body may
// include the string arm — see the section comment for the contract. The
// backends seed each admitted type as a "strfldok:<T>" need at their
// whole-program emit orchestration, and the lowering-time routing +
// construction-retain decisions read this same list off FnSigs — the two must
// agree, so both come from this one scan; partial-funcs emit paths must pass
// [] funcs (admitting nothing) rather than a unit-local list.
//
// `borrowable` is the SAME registry the caller's FnSigs carries. The two must
// come from one verdict: the interprocedural fixpoint admits more borrows than
// the single pass, so a backend seeding "strfldok:" from the fixpoint while the
// lowering routed on the single pass would free fields nothing retained. Every
// emit path therefore overrides FnSigs.strfld_ok_types wherever it overrides
// FnSigs.borrowable_params.
pub function strfld_reclaim_ok_types_of(funcs: parser.FuncDecl[], structs: irtables.StructTab, borrowable: string[]): string[] {
  // Single pass: collect every unsafely-read field NAME across the whole
  // program, then admit each candidate type iff none of its string-field
  // names is in the set.
  var unsafe_names: string[] = [];
  for fn in funcs {
    unsafe_names = strfld_collect_unsafe_stmts(fn.body, unsafe_names);
  }
  unsafe_names = strfld_resolve_deferred(unsafe_names, borrowable);
  var out: string[] = [];
  for sd in structs.decls {
    var t: string = sd.name;
    // Any string-fielded struct is a candidate — array-carrying types
    // gain the string arm in their existing __field_reclaim body, and
    // string-ONLY types (slice 3) gain the routing itself (their body is
    // the string arms + the snapshot_dec box free).
    if (struct_has_string_field(structs, t)) {
      var ok: boolean = true;
      var n: i32 = sd.fields.len();
      var fi: i32 = 0;
      while (fi < n) {
        if (sd.fields[fi].type_name == "string"
          && util.index_of_str(unsafe_names, sd.fields[fi].name) >= 0) {
          ok = false;
        }
        fi = fi + 1;
      }
      if (ok) {
        out = out.append(t);
      }
    }
  }
  // string[]-FIELD admissions (the string[]-struct-field exit-drop slice),
  // returned as "arr:"-prefixed entries in the SAME list: the lowering asks
  // for them under that tag and the backend gates its k_str_arr arm on
  // "strfldok:arr:<T>", and the prefixed spellings are inert for every
  // untagged scalar lookup. A type T is admitted iff every one of its
  // string[] FIELDS is (a) never read outside a bare `.len()` borrow
  // (strarrfld_scan — any other read binds/escapes an ELEMENT alias the deep
  // free would dangle: element stores into a string[] are MOVES, so element
  // rc does not count the buffer's references) and (b) only ever constructed
  // from an element-fresh array literal (strarr_value_is_fresh elements /
  // `[]`) — the exact element-freshness contract the "SARR:" local credit
  // uses. Marks the scan could key to a type are matched as "<T>.<field>";
  // the bare-name lookup is the fallback for a read whose receiver type it
  // could not resolve, which still poisons the field in every type.
  // __fern_str_arr_free itself rc-guards the BUFFER (shared -> dec only),
  // so buffer aliasing degrades to the old leak instead of corrupting.
  var arr_unsafe: string[] = [];
  // The element-freshness proof consults the whole-program fresh-string
  // registry, so a field built from `[wide(n), …]` is admitted on the same
  // terms as one built from inline concats. Walked only when some type
  // actually has a string[] field — it is linear in every body.
  var has_strarr_fld: boolean = strarrfld_program_has_field(structs);
  var arr_str_fresh: string[] = [];
  if (has_strarr_fld) {
    arr_str_fresh = str_fresh_ret_fns_of(funcs);
  }
  // Whole-array PRODUCERS the field store gate may accept, on the same terms
  // the "STRARR:" registry admits them.
  var arr_producers: string[] = [];
  for fn in funcs {
    if (fn_returns_fresh_strarr(fn, arr_str_fresh)) {
      arr_producers = arr_producers.append(fn.name);
    }
  }
  // string[]-field FORWARDERS, whose reads move from the forwarding return to
  // the call sites (#7417). Whole-program, like every other row here: the
  // exemption is only sound while every call is visible, which is the same
  // condition the partial-funcs paths already satisfy by passing [] funcs.
  var arr_fwd: string[] = strarrfld_forwarders_of(funcs, structs);
  for fn in funcs {
    arr_unsafe = strarrfld_scan_stmts(fn.body, structs, strarrfld_fn_binds(fn, structs), arr_str_fresh, strarr_visible_producers(fn, arr_producers), arr_fwd, strarrfld_fwd_field_of(fn, structs), arr_unsafe);
  }
  if (has_strarr_fld) {
    arr_unsafe = strarrfld_borrowed_elem_marks(funcs, structs, arr_str_fresh, arr_producers, arr_unsafe);
  }
  for sd in structs.decls {
    var at: string = sd.name;
    if (struct_has_strarr_field(structs, at)) {
      var aok: boolean = true;
      for fld in sd.fields {
        if (fld.type_name == "string[]"
          && (util.index_of_str(arr_unsafe, at + "." + fld.name) >= 0
          || util.index_of_str(arr_unsafe, fld.name) >= 0)) {
          aok = false;
        }
      }
      if (aok) {
        out = out.append("arr:" + at);
      }
      // The BUFFER-release admission ("arrbuf:"-prefixed), the store half
      // of the verdict above. The construction-side retain for a
      // bare-ident array field value is unconditional, so a type whose
      // string[] fields are only ever stored a retained or sole-owned
      // value has a buffer reference to give back at reclaim time even
      // when an element READ withholds the deep walk. A store the scan
      // refused is an uncounted alias, and dec'ing that frees a buffer
      // another owner still holds.
      var abufok: boolean = true;
      for fld in sd.fields {
        if (fld.type_name == "string[]"
          && util.index_of_str(arr_unsafe, "store:" + at + "." + fld.name) >= 0) {
          abufok = false;
        }
      }
      if (abufok) {
        out = out.append("arrbuf:" + at);
      }
    }
    // struct-ARRAY / enum-ARRAY FIELD admissions ("sarr:"-prefixed), read
    // out of the SAME unsafe-mark set (#7067): the backends gate
    // __field_reclaim_<T>'s element walk on "strfldok:sarr:<T>". A type is
    // admitted iff every one of its struct/enum-array fields is (a) never
    // read outside a bare `.len()` borrow — any other read binds an element
    // alias the walk would dangle — and (b) only ever stored an array
    // literal of fresh elements, so no surviving buffer shares an element
    // with the one being released. Marks are matched type-keyed first and
    // by bare NAME as the fallback, exactly like the "arr:" half above.
    // __struct_drop_<T>'s walk needs neither: at scope exit the box and
    // every buffer that ever aliased its elements are dying together.
    var sa_has: boolean = false;
    for fld in sd.fields {
      if (irtables.is_struct_array_field_type(structs, fld.type_name)
        || irtables.is_enum_array_field_type(structs, fld.type_name)) {
        sa_has = true;
      }
    }
    if (sa_has) {
      var saok: boolean = true;
      for fld in sd.fields {
        var saft: string = fld.type_name;
        if ((irtables.is_struct_array_field_type(structs, saft) || irtables.is_enum_array_field_type(structs, saft))
          && (util.index_of_str(arr_unsafe, at + "." + fld.name) >= 0
          || util.index_of_str(arr_unsafe, fld.name) >= 0)) {
          saok = false;
        }
      }
      if (saok) {
        out = out.append("sarr:" + at);
      }
    }
  }
  // CLOSURE-field admissions ("clo:"-prefixed, threaded exactly like the
  // "arr:" half): a type is admitted iff every fn-typed field name passes
  // clofld_scan — counted construction values (closure_value_is_counted),
  // no base-including construction of the type, and no read of the field
  // outside a direct `b.f(x)` call. The k_clo drop arm then shallow-frees
  // the field's closure box (captures leak — the k_struct one-level model).
  var clo_unsafe: string[] = [];
  var cloret: string[] = closure_ret_fns_of(funcs);
  for fn in funcs {
    clo_unsafe = clofld_scan_stmts(fn.body, structs, cloret, clo_unsafe);
  }
  for sd in structs.decls {
    var ct: string = sd.name;
    if (struct_has_clo_field(structs, ct)) {
      var cok: boolean = true;
      for fld in sd.fields {
        if (fld.type_name == "fn"
          && util.index_of_str(clo_unsafe, fld.name) >= 0) {
          cok = false;
        }
      }
      if (cok) {
        out = out.append("clo:" + ct);
      }
    }
  }
  return out;
}

// ── structfldok: admit the DIRECT nested-struct / nested-enum field arm ──────
//
// The struct/enum sibling of strfld_reclaim_ok_types_of, and the precondition
// #6148's revert established for #6127's nested_struct row. A rebound struct
// local whose field is itself a struct leaks that field's box on every rebind:
// __struct_drop_<T> HAS k_struct / k_enum arms, so a SINGLE bind reclaims
// cleanly at scope exit (measured 200/200/0), but __field_reclaim_<T>'s field
// loop has no such arm, so only the rebinds leak (900/600/12000 over 100 rounds
// against 0 on native).
//
// #6148 added the arms without an admission scan and it was a use-after-free:
// a struct-literal field value is sole-owned at rc=1, so `items.append(p.node)`
// takes an UNCOUNTED alias, and the next rebind's field release freed a box the
// container still pointed at. The self-host has no read-side alias-inc for these
// reads, so the scan IS the safety argument — hand-rolling a looser predicate to
// make a probe pass is exactly what had to be reverted.
//
// It cannot reuse strfld_collect_unsafe: that walker recurses into a marked
// access's RECEIVER as unsafe, so `o.f.v` would mark `f` and exclude every type
// whose nested field is merely read through. Here the receiver of a borrow chain
// is a borrow — the inner read is judged under its own field's name — which is
// the one structural difference between the two scans.
pub function structfld_reclaim_ok_types_of(funcs: parser.FuncDecl[], structs: irtables.StructTab, borrowable: string[]): string[] {
  var unsafe_names: string[] = [];
  var enum_members: string[] = fresh_enum_fwd_fixpoint(funcs, structs);
  for fn in funcs {
    var ret_hb: boolean = fn.receiver_type.len() == 0 && util.index_of_str(enum_members, fn.name) >= 0;
    unsafe_names = structfld_collect_unsafe_stmts(fn.body, unsafe_names, borrowable, structs, ret_hb);
  }
  var out: string[] = [];
  for sd in structs.decls {
    var has: boolean = false;
    var ok: boolean = true;
    for fld in sd.fields {
      var fdt: string = fld.type_name;
      if (irtables.decl_is_struct(structs, fdt) || irtables.decl_is_enum(structs, fdt)) {
        has = true;
        if (util.index_of_str(unsafe_names, fld.name) >= 0) {
          ok = false;
        }
      }
    }
    if (has && ok) {
      out = out.append(sd.name);
    }
  }
  return out;
}

// structfld_mark: record e's field name as unsafely read, then treat its
// RECEIVER as a borrow. This is the difference from strfld_mark, which recurses
// into the receiver as unsafe: reaching `g` through `o.f.g` retains only g's
// box, so `f` is borrowed and stays admissible.
function structfld_mark(e: ast.Expr, acc: string[], borrowable: string[], structs: irtables.StructTab): string[] {
  var a: string[] = acc;
  match (e) {
    ast.ExprFieldAccess(fa) => {
      a = push_str_unique(a, fa.field);
      a = structfld_safe_operand(fa.obj, a, borrowable, structs);
    },
    _ => {}
  }
  return a;
}

// structfld_safe_operand: the DIRECT read here is a transient borrow — do not
// mark it, but keep walking beneath.
function structfld_safe_operand(e: ast.Expr, acc: string[], borrowable: string[], structs: irtables.StructTab): string[] {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      return structfld_safe_operand(fa.obj, acc, borrowable, structs);
    },
    _ => {}
  }
  return structfld_collect_unsafe(e, acc, borrowable, structs);
}

// structfld_counted_literal_field: every struct declaring a field called `fname`
// declares it at a kind whose struct-literal retain is GUARANTEED — the same
// disjunction fieldmove_counted_field_alias proves the counted share from. A read
// of such a field into a literal is inc'd by the literal, so it is a counted
// share and not the uncounted escape the scan exists to refuse (#8658).
//
// Name-wise because the scan is: it marks by field NAME, so one struct declaring
// `p` as a string is enough to keep every `p` marked. Deliberately keyed on the
// retain's own predicate rather than a looser hand-rolled one — that is what
// #6148 had to revert.
function structfld_counted_literal_field(fname: string, structs: irtables.StructTab): boolean {
  var seen: boolean = false;
  for sd in structs.decls {
    for fld in sd.fields {
      if (fld.name == fname) {
        seen = true;
        if (!(irtables.decl_is_struct(structs, fld.type_name) || irtables.decl_is_enum(structs, fld.type_name)
          || irtables.is_leaksafe_array_field(fld.type_name) || irtables.is_struct_array_field_type(structs, fld.type_name))) {
          return false;
        }
      }
    }
  }
  return seen;
}

// structfld_literal_field_value: a struct-literal FIELD VALUE position. A field
// read here is unsafe by default, but where the literal's retain is guaranteed
// the new owner holds a COUNTED reference — `Asm { p: a.p }` incs — so the
// source keeps its deep drop and both decs balance. Without this carve-out one
// such literal anywhere in the program stripped the enum arm out of
// `__field_reclaim_<T>` for the whole type, and the supersede then never
// released its claim (#8658: 88 B a round, where a LOCAL alias of the same
// field across the same supersede is clean).
//
// The receiver still walks as a borrow, exactly as structfld_mark would treat
// it; only the field's own name escapes marking.
function structfld_literal_field_value(e: ast.Expr, acc: string[], borrowable: string[], structs: irtables.StructTab): string[] {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      if (structfld_counted_literal_field(fa.field, structs)) {
        return structfld_safe_operand(fa.obj, acc, borrowable, structs);
      }
    },
    _ => {}
  }
  return structfld_collect_unsafe(e, acc, borrowable, structs);
}

// structfld_collect_unsafe: every field NAME read in a position that could
// outlive its box. A bare ExprFieldAccess reached here — not consumed by one of
// the borrow parents — is unsafe by default.
function structfld_collect_unsafe(e: ast.Expr, acc: string[], borrowable: string[], structs: irtables.StructTab): string[] {
  var a: string[] = acc;
  match (e) {
    ast.ExprFieldAccess(_) => {
      return structfld_mark(e, a, borrowable, structs);
    },
    ast.ExprBinary(b) => {
      a = structfld_safe_operand(b.left, a, borrowable, structs);
      return structfld_safe_operand(b.right, a, borrowable, structs);
    },
    ast.ExprUnary(u) => {
      return structfld_collect_unsafe(u.operand, a, borrowable, structs);
    },
    ast.ExprIndex(ix) => {
      a = structfld_safe_operand(ix.array, a, borrowable, structs);
      return structfld_collect_unsafe(ix.index, a, borrowable, structs);
    },
    ast.ExprSlice(sl) => {
      a = structfld_collect_unsafe(sl.array, a, borrowable, structs);
      match (sl.array) {
        ast.ExprFieldAccess(_) => {
          a = structfld_mark(sl.array, a, borrowable, structs);
        },
        _ => {}
      }
      a = structfld_collect_unsafe(sl.start, a, borrowable, structs);
      return structfld_collect_unsafe(sl.end, a, borrowable, structs);
    },
    ast.ExprStructLit(sl2) => {
      // A struct-literal FIELD VALUE re-homes the box into the new literal
      // (`PS { node: other.node }`) — the new owner outlives this one, so the
      // read is unsafe UNLESS the literal's retain is guaranteed, which makes
      // it a counted share instead (structfld_literal_field_value). strfld's
      // walker never visits ExprStructLit at all; this scan must, because a
      // nested-struct field is exactly the thing that gets copied between
      // literals.
      var fi: i32 = 0;
      while (fi < sl2.field_values.len()) {
        a = structfld_literal_field_value(sl2.field_values[fi], a, borrowable, structs);
        fi = fi + 1;
      }
      // A functional-update BASE (`S { ..o, n: 1 }`) copies o's field
      // pointers into the new box, so every one of them gains an owner.
      if (sl2.has_base) {
        a = structfld_collect_unsafe(sl2.base, a, borrowable, structs);
      }
      return a;
    },
    ast.ExprTuple(tl2) => {
      // A tuple element is a store into a box that outlives the read, the
      // same position as an array element.
      var ti2: i32 = 0;
      while (ti2 < tl2.elements.len()) {
        a = structfld_collect_unsafe(tl2.elements[ti2], a, borrowable, structs);
        ti2 = ti2 + 1;
      }
      return a;
    },
    ast.ExprArray(arr) => {
      // An array literal ELEMENT is a store into a container that outlives
      // the read, the literal-built sibling of `xs.append(o.f)`.
      var ai2: i32 = 0;
      while (ai2 < arr.elements.len()) {
        a = structfld_collect_unsafe(arr.elements[ai2], a, borrowable, structs);
        ai2 = ai2 + 1;
      }
      return a;
    },
    ast.ExprCall(c) => {
      // A BORROWABLE param position cannot retain what it is handed, so
      // `f(o.inner)` there is a transient borrow like the method receiver
      // below — judged by structfld_safe_operand, which keeps walking
      // beneath without marking the field. Same registry and same rule
      // expr_unsafe_for and the NODEEP field-move scan (#6691) already
      // apply; here it is what lets the type keep its nested-struct / enum
      // arms at all. Free calls only: method-param borrowability is not in
      // the free-function-keyed registry.
      var callee_name: string = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          callee_name = cid.name;
        },
        ast.ExprFieldAccess(cfa) => {
          // A method CALL on a field borrows its receiver for the
          // call — `o.f.len()` / `o.f.method()` read through it. The
          // receiver chain is judged by structfld_safe_operand; the
          // arguments below are what can retain.
          a = structfld_safe_operand(cfa.obj, a, borrowable, structs);
        },
        _ => {
          a = structfld_collect_unsafe(c.callee, a, borrowable, structs);
        }
      }
      var ai: i32 = 0;
      while (ai < c.args.len()) {
        // Shape first, registry second. param_is_borrowable is a linear
        // walk of the registry with a char compare per entry, and this
        // scan visits every call argument in the whole program once per
        // emitted unit — asking it about every argument cost the
        // per-module emit-all ~50%. A bare field access is the only
        // argument shape this arm marks directly, so it is the only one
        // whose answer can change anything.
        var arg_is_field: boolean = false;
        match (c.args[ai]) {
          ast.ExprFieldAccess(_) => {
            arg_is_field = true;
          },
          _ => {}
        }
        if (arg_is_field && callee_name.len() > 0 && param_is_borrowable(borrowable, callee_name, ai)) {
          a = structfld_safe_operand(c.args[ai], a, borrowable, structs);
        } else {
          a = structfld_collect_unsafe(c.args[ai], a, borrowable, structs);
        }
        ai = ai + 1;
      }
      return a;
    },
    _ => {}
  }
  return a;
}

// structfld_collect_unsafe_assign: an assignment's RHS, with the SELF-REBIND
// field reads in `o = S { …, f: o.f, … }` left unmarked (#6653).
//
// The literal's successor box goes into the slot `o` names, so `o.f` gains no
// owner the old box did not already have: the override path retains it and the
// old box's __field_reclaim_ releases it in the same rebind. That is exactly the
// balance the `...o` spelling of the same update has always had — and it has it
// because it reads no field, which is the only reason its type stays admitted.
//
// A fork to a DIFFERENT local (`p = S { f: o.f }`) does create a second owner —
// but a COUNTED one, so it takes the same carve-out the `var` spelling of the
// literal does (structfld_literal_field_value). The retain arms are position-
// independent: nothing about them distinguishes an assignment's RHS from an
// initialiser's, so refusing the type here while admitting it there left the
// identical #8658 leak reachable through `b = Asm { p: a.p, n: 1 }` — measured
// at 120 B against native's balanced 6/6/0.
//
// Every other value in the literal still marks, and so does the functional-
// update BASE below: `..o` copies o's field pointers into the new box wholesale
// rather than taking the single-field retain fieldmove_counted_field_alias
// proves, so the counted-share argument does not reach it.
function structfld_collect_unsafe_assign(target: string, v: ast.Expr, acc: string[], borrowable: string[], structs: irtables.StructTab): string[] {
  var a: string[] = acc;
  match (v) {
    ast.ExprStructLit(sl) => {
      for fv in sl.field_values {
        // Only a DIRECT `target.<f>`: a deeper chain reaches a box the
        // successor does not supersede (selfrebind_field_alias).
        if (!selfrebind_field_alias(fv, target)) {
          a = structfld_literal_field_value(fv, a, borrowable, structs);
        }
      }
      if (sl.has_base) {
        a = structfld_collect_unsafe(sl.base, a, borrowable, structs);
      }
      return a;
    },
    _ => {}
  }
  return structfld_collect_unsafe(v, a, borrowable, structs);
}

// structfld_collect_unsafe_stmts: a direct `var t = x.f` init is SAFE — the
// binding is a borrow the exit sweep does not double-free — while a REASSIGN
// `t = x.f` is not, matching the string scan's split.
// `ret_hb`: the function is an "ENUM:" member, whose `return p.f` retains the
// field (ret_enum_param_handback), a counted share like the `var` bind's dup.
function structfld_collect_unsafe_stmts(stmts: ast.Stmt[], acc: string[], borrowable: string[], structs: irtables.StructTab, ret_hb: boolean): string[] {
  var a: string[] = acc;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        a = structfld_safe_operand(v.init, a, borrowable, structs);
      },
      ast.StmtReturn(r) => {
        if (ret_hb) {
          a = structfld_safe_operand(r.value, a, borrowable, structs);
        } else {
          a = structfld_collect_unsafe(r.value, a, borrowable, structs);
        }
      },
      ast.StmtAssign(as2) => {
        a = structfld_collect_unsafe_assign(as2.target, as2.value, a, borrowable, structs);
      },
      ast.StmtExpr(ex) => {
        a = structfld_collect_unsafe(ex.value, a, borrowable, structs);
      },
      ast.StmtIf(iff) => {
        a = structfld_collect_unsafe(iff.cond, a, borrowable, structs);
        a = structfld_collect_unsafe_stmts(iff.then_body, a, borrowable, structs, ret_hb);
        a = structfld_collect_unsafe_stmts(iff.else_body, a, borrowable, structs, ret_hb);
      },
      ast.StmtWhile(w) => {
        a = structfld_collect_unsafe(w.cond, a, borrowable, structs);
        a = structfld_collect_unsafe_stmts(w.body, a, borrowable, structs, ret_hb);
      },
      ast.StmtFor(fo) => {
        a = structfld_collect_unsafe(fo.iter, a, borrowable, structs);
        a = structfld_collect_unsafe_stmts(fo.body, a, borrowable, structs, ret_hb);
      },
      ast.StmtMatch(m) => {
        // A match SCRUTINEE is a transient borrow, exactly as a `var`
        // initialiser is (StmtVar above): the box is read to test its
        // tag and outlives nothing the arms do not own in their own
        // right. Marking it unsafe disqualified the whole struct type
        // from __field_reclaim_<T>, so `match (h.e)` stranded the enum
        // field 100 times over where `var t = h.e; match (t)` did not.
        a = structfld_safe_operand(m.scrutinee, a, borrowable, structs);
        for arm in m.arms {
          if (arm.has_guard) {
            a = structfld_collect_unsafe(arm.guard, a, borrowable, structs);
          }
          a = structfld_collect_unsafe_stmts(arm.body, a, borrowable, structs, ret_hb);
        }
      },
      ast.StmtDefer(d) => {
        var one: ast.Stmt[] = [d.action];
        a = structfld_collect_unsafe_stmts(one, a, borrowable, structs, ret_hb);
      },
      _ => {}
    }
  }
  return a;
}

// struct_has_strarr_field: does `sty` declare at least one string[] field?
pub function struct_has_strarr_field(structs: irtables.StructTab, sty: string): boolean {
  var si: i32 = irtables.stab_struct_first(structs, sty);
  if (si < 0) {
    return false;
  }
  for fld in structs.decls[si].fields {
    if (fld.type_name == "string[]") {
      return true;
    }
  }
  return false;
}

// struct_has_clo_field: does `sty` declare at least one fn-typed field (the
// parser coarsens a `(T) => R` field spelling to "fn"; the struct-lit lift
// wraps its value into a `__mkclo$…` env box, so the slot holds an
// rc-headered closure box at runtime)?
pub function struct_has_clo_field(structs: irtables.StructTab, sty: string): boolean {
  var si: i32 = irtables.stab_struct_first(structs, sty);
  if (si < 0) {
    return false;
  }
  for fld in structs.decls[si].fields {
    if (fld.type_name == "fn") {
      return true;
    }
  }
  return false;
}

// clofld_scan / clofld_scan_stmts: the fn-field (closure-field) admission
// walk, the closure sibling of strarrfld_scan. Marks a field NAME unsafe
// (name-keyed over-approximation, like the string scans) when:
//   - a struct-literal stores an UNCOUNTED value into an fn-typed field —
//     the k_clo shallow dec takes back the count the value arrived with: a
//     lambda, its `__mkclo$` box or a closure-returning call carries one
//     (closure_value_is_counted), and the literal retains a bare ident
//     (clo_field_ident_counted); a field copy is a second owner's box;
//   - a struct-literal WITH A BASE constructs a type carrying fn fields —
//     the base copy carries the field's box pointer into a second struct
//     (two k_clo decs of one box);
//   - the field is READ anywhere except as a direct CALL callee or a bare
//     `return b.f` — `b.f(x)` borrows the box for the call and the return
//     retains it, but `var g = b.f` binds an uncounted alias the drop would
//     dangle.
// Runs on the PRE-lift AST (fn-field values are still lambdas/idents there).
function clofld_scan(e: ast.Expr, structs: irtables.StructTab, cset: string[], acc: string[]): string[] {
  var a: string[] = acc;
  match (e) {
    ast.ExprFieldAccess(fa) => {
      a = push_str_unique(a, fa.field);
      return clofld_scan(fa.obj, structs, cset, a);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
          // `b.f(args)` — the direct field CALL is the one tolerated
          // borrow: skip marking f, keep walking beneath it.
          match (cfa.obj) {
            ast.ExprFieldAccess(ffa) => {
              a = clofld_scan(ffa, structs, cset, a);
            },
            _ => {
              a = clofld_scan(cfa.obj, structs, cset, a);
            }
          }
        },
        _ => {
          a = clofld_scan(c.callee, structs, cset, a);
        }
      }
      for arg in c.args {
        a = clofld_scan(arg, structs, cset, a);
      }
      return a;
    },
    ast.ExprBinary(b) => {
      return clofld_scan(b.right, structs, cset, clofld_scan(b.left, structs, cset, a));
    },
    ast.ExprUnary(u) => {
      return clofld_scan(u.operand, structs, cset, a);
    },
    ast.ExprIndex(ix) => {
      return clofld_scan(ix.index, structs, cset, clofld_scan(ix.array, structs, cset, a));
    },
    ast.ExprSlice(sl) => {
      return clofld_scan(sl.end, structs, cset, clofld_scan(sl.start, structs, cset, clofld_scan(sl.array, structs, cset, a)));
    },
    ast.ExprStructLit(sl2) => {
      if (sl2.has_base) {
        a = clofld_scan(sl2.base, structs, cset, a);
        // A base copy of an fn-fielded type carries the closure box —
        // mark every fn field of the type unsafe.
        var sdi: i32 = irtables.stab_struct_first(structs, sl2.type_name);
        while (sdi >= 0) {
          for fld in structs.decls[sdi].fields {
            if (fld.type_name == "fn") {
              a = push_str_unique(a, fld.name);
            }
          }
          sdi = irtables.stab_next(structs, sdi, sl2.type_name);
        }
      }
      var i: i32 = 0;
      while (i < sl2.field_names.len()) {
        if (irtables.decl_field_type(structs, sl2.type_name, sl2.field_names[i]) == "fn"
          && !closure_value_is_counted(sl2.field_values[i], cset) && ident_name_or_empty(sl2.field_values[i]).len() == 0) {
          a = push_str_unique(a, sl2.field_names[i]);
        }
        a = clofld_scan(sl2.field_values[i], structs, cset, a);
        i = i + 1;
      }
      return a;
    },
    ast.ExprArray(av2) => {
      var i: i32 = 0;
      while (i < av2.elements.len()) {
        a = clofld_scan(av2.elements[i], structs, cset, a);
        i = i + 1;
      }
      return a;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        a = clofld_scan(el, structs, cset, a);
      }
      return a;
    },
    ast.ExprLambda(lm) => {
      return clofld_scan_stmts(lm.body, structs, cset, a);
    },
    _ => {
      return a;
    }
  }
}

function clofld_scan_stmts(stmts: ast.Stmt[], structs: irtables.StructTab, cset: string[], acc: string[]): string[] {
  var a: string[] = acc;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        a = clofld_scan(v.init, structs, cset, a);
      },
      ast.StmtAssign(as2) => {
        a = clofld_scan(as2.value, structs, cset, a);
      },
      ast.StmtExpr(ex) => {
        a = clofld_scan(ex.value, structs, cset, a);
      },
      ast.StmtReturn(r) => {
        // `return b.f` retains the box for the caller (ret_closure_uncounted).
        if let ast.ExprFieldAccess(rfa) = r.value {
          a = clofld_scan(rfa.obj, structs, cset, a);
        } else {
          a = clofld_scan(r.value, structs, cset, a);
        }
      },
      ast.StmtIf(iff) => {
        a = clofld_scan(iff.cond, structs, cset, a);
        a = clofld_scan_stmts(iff.then_body, structs, cset, a);
        a = clofld_scan_stmts(iff.else_body, structs, cset, a);
      },
      ast.StmtWhile(w) => {
        a = clofld_scan(w.cond, structs, cset, a);
        a = clofld_scan_stmts(w.body, structs, cset, a);
      },
      ast.StmtFor(fo) => {
        a = clofld_scan(fo.iter, structs, cset, a);
        a = clofld_scan_stmts(fo.body, structs, cset, a);
      },
      ast.StmtMatch(m) => {
        a = clofld_scan(m.scrutinee, structs, cset, a);
        for arm in m.arms {
          if (arm.has_guard) {
            a = clofld_scan(arm.guard, structs, cset, a);
          }
          a = clofld_scan_stmts(arm.body, structs, cset, a);
        }
      },
      ast.StmtDefer(d) => {
        a = clofld_scan_stmts([d.action], structs, cset, a);
      },
      _ => {}
    }
  }
  return a;
}

// fnfld_obj_type resolves the struct type of a field-access RECEIVER from
// declarations alone: a `T { … }` literal, or a name bound by a param / an
// annotated `var` / a `var` initialised from a literal. Anything else yields ""
// and the gate stays silent — the conservative direction for a rejector.
function fnfld_obj_type(e: ast.Expr, structs: irtables.StructTab, binds: string[]): string {
  match (e) {
    ast.ExprStructLit(sl) => {
      return sl.type_name;
    },
    ast.ExprIdent(id) => {
      return fnfld_lookup(binds, id.name);
    },
    _ => {
      return "";
    }
  }
  return "";
}

// fnfld_lit_type reads the struct type off an initialiser that is a struct
// literal, so an UNANNOTATED `var r = R { … }` still binds.
function fnfld_lit_type(e: ast.Expr): string {
  match (e) {
    ast.ExprStructLit(sl) => {
      return sl.type_name;
    },
    _ => {
      return "";
    }
  }
  return "";
}

// fnfld_bind records `name` as `ty` when `ty` names a declared struct, and drops
// any prior binding for the name otherwise (shadowing must not inherit a type).
// Entries are "name ty" pairs in one flat list — two slots per binding, so the
// list stays a plain string[] the way the other scan accumulators do.
function fnfld_bind(binds: string[], name: string, ty: string, structs: irtables.StructTab): string[] {
  var out: string[] = [];
  var i: i32 = 0;
  while (i + 1 < binds.len()) {
    if (binds[i] != name) {
      out = out.append(binds[i]);
      out = out.append(binds[i + 1]);
    }
    i = i + 2;
  }
  var known: boolean = irtables.decl_is_struct(structs, ty);
  if (known) {
    out = out.append(name);
    out = out.append(ty);
  }
  return out;
}

function fnfld_lookup(binds: string[], name: string): string {
  var i: i32 = 0;
  while (i + 1 < binds.len()) {
    if (binds[i] == name) {
      return binds[i + 1];
    }
    i = i + 2;
  }
  return "";
}

// strarrfld_scan / strarrfld_scan_stmts: the string[]-field admission walk,
// which the struct[]/enum[]-field admission ("sarr:", #7067) reuses — the read
// rule below is the same question for both, so one walk feeds both halves.
// Marks a field unsafe when:
//   - it is READ anywhere except as a bare `.len()` receiver, or an element
//     `x.f[i]` read as a binary operand or a borrowing method's receiver — any
//     other indexed read, an iteration (`for s in x.f`), a bare copy, a method
//     receiver, or a call argument all create/bind an element or buffer
//     alias the deep free could dangle;
//   - a struct-literal stores a NON-element-fresh value into a string[]
//     field — anything but an array literal whose every element is
//     strarr_value_is_fresh (string literal / concat / proven producer call)
//     or `[]`;
//   - a struct-literal stores a non-element-fresh value into a struct-ARRAY /
//     enum-ARRAY field (boxarr_lit_all_elems_fresh).
// Over-marking names of fields of the other kind is harmless: each admission
// consults only its own field names.
//
// Marks are keyed "<T>.<field>" wherever the owning type is known — always at
// a struct-literal store, and at a read whose receiver fnfld_obj_type can
// resolve (a param, an annotated `var`, a literal-initialised `var`). An
// unresolvable receiver falls back to the bare field NAME, which the admission
// reads as poisoning that field in EVERY type — the conservative direction,
// and what every mark used to be. Two structs sharing a field name no longer
// share its verdict: a `mk(notes) { Other { notes: notes } }` elsewhere in the
// module used to cost every `notes` field in the program its reclaim.
// strarrfld_transient_elem_recv reports whether a method call's callee is
// `<struct>.<string[] field>[i].<read-only method>` — an ELEMENT borrowed for one
// call and never bound. str_borrowing_method is the method set.
function strarrfld_transient_elem_recv(cfa: ast.ExprFieldAccess, structs: irtables.StructTab, binds: string[]): boolean {
  return str_borrowing_method(cfa.field) && strarrfld_elem_read(cfa.obj, structs, binds);
}

// strarrfld_elem_read: `e` is `x.f[i]` for a `string[]` field `f` of a struct
// whose type fnfld_obj_type resolves.
function strarrfld_elem_read(e: ast.Expr, structs: irtables.StructTab, binds: string[]): boolean {
  if let ast.ExprIndex(ix) = e {
    if let ast.ExprFieldAccess(ffa) = ix.array {
      var oty: string = fnfld_obj_type(ffa.obj, structs, binds);
      return oty.len() > 0 && irtables.decl_field_type(structs, oty, ffa.field) == "string[]";
    }
  }
  return false;
}

// strarrfld_scan_operand: a binary operand or a borrowing method's receiver. An
// `x.f[i]` there is read once and never bound — the transient position
// strarr_expr_unsafe grants a string[] local's `xs[i]` — so only the index and
// the holder are walked.
function strarrfld_scan_operand(e: ast.Expr, structs: irtables.StructTab, binds: string[], str_fresh: string[], strarr_producers: string[], forwarders: string[], acc: string[]): string[] {
  if (!strarrfld_elem_read(e, structs, binds)) {
    return strarrfld_scan(e, structs, binds, str_fresh, strarr_producers, forwarders, acc);
  }
  var a: string[] = acc;
  if let ast.ExprIndex(ix) = e {
    a = strarrfld_scan(ix.index, structs, binds, str_fresh, strarr_producers, forwarders, a);
    if let ast.ExprFieldAccess(ffa) = ix.array {
      a = strarrfld_scan(ffa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
    }
  }
  return a;
}

// strarrfld_fwd_param_own: `name` is an `own` parameter of `fn` — a struct it
// CONSUMES, so a field read out of it is not a borrow anyone else still holds.
function strarrfld_fwd_param_own(fn: parser.FuncDecl, name: string): boolean {
  var i: i32 = 0;
  while (i < fn.params.len()) {
    if (fn.params[i].name == name) {
      return fn.params[i].own;
    }
    i = i + 1;
  }
  return false;
}

// strarrfld_fwd_ret_key: the `"<T>.<field>"` one return value hands out of a
// BORROWED receiver or struct parameter, "" for anything else.
function strarrfld_fwd_ret_key(e: ast.Expr, fn: parser.FuncDecl, structs: irtables.StructTab): string {
  match (e) {
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(oid) => {
          if (strarrfld_fwd_param_own(fn, oid.name)) {
            return "";
          }
          var oty: string = arrown_obj_struct_type(fn, oid.name, structs);
          if (oty.len() == 0) {
            return "";
          }
          if (irtables.decl_field_type(structs, oty, fa.field) != "string[]") {
            return "";
          }
          return oty + "." + fa.field;
        },
        _ => {
          return "";
        }
      }
    },
    _ => {
      return "";
    }
  }
  return "";
}

// strarrfld_fwd_ret_keys: strarrfld_fwd_ret_key for every return in `stmts`,
// one entry per return — including the "" a non-forwarding return contributes,
// so the caller sees that it disagrees. Lambda bodies are not walked: a return
// inside one belongs to the lambda.
function strarrfld_fwd_ret_keys(stmts: ast.Stmt[], fn: parser.FuncDecl, structs: irtables.StructTab, acc: string[]): string[] {
  var a: string[] = acc;
  for stmt in stmts {
    match (stmt) {
      ast.StmtReturn(r) => {
        a = a.append(strarrfld_fwd_ret_key(r.value, fn, structs));
      },
      ast.StmtIf(f) => {
        a = strarrfld_fwd_ret_keys(f.then_body, fn, structs, a);
        a = strarrfld_fwd_ret_keys(f.else_body, fn, structs, a);
      },
      ast.StmtWhile(w) => {
        a = strarrfld_fwd_ret_keys(w.body, fn, structs, a);
      },
      ast.StmtFor(fo) => {
        a = strarrfld_fwd_ret_keys(fo.body, fn, structs, a);
      },
      ast.StmtMatch(m) => {
        var i: i32 = 0;
        while (i < m.arms.len()) {
          a = strarrfld_fwd_ret_keys(m.arms[i].body, fn, structs, a);
          i = i + 1;
        }
      },
      ast.StmtDefer(_) => {},
      _ => {}
    }
  }
  return a;
}

// strarrfld_fwd_field_of: the `"<T>.<field>"` EVERY return of `fn` hands out,
// or "" when `fn` is not a string[]-field forwarder. All-or-nothing and
// single-valued — a body whose returns forward two different fields, or one
// that returns anything else on some path, is not one.
//
// A forwarder is why declaring `(h: Holder) get(): string[] { return h.xs; }`
// stranded every `Holder` in the program (#7417): `h.xs` is a read the
// admission walk marks, and the mark is keyed on the TYPE, so one declaration
// refused the field reclaim for every instance in every function — whether or
// not the method was ever called. The verdict belongs at the forwarder's CALL
// sites (strarrfld_fwd_marks), and the forwarding return is exempt there.
function strarrfld_fwd_field_of(fn: parser.FuncDecl, structs: irtables.StructTab): string {
  if (fn.ret_type != "string[]") {
    return "";
  }
  if (!body_has_return(fn.body)) {
    return "";
  }
  var seed: string[] = [];
  var keys: string[] = strarrfld_fwd_ret_keys(fn.body, fn, structs, seed);
  if (keys.len() == 0) {
    return "";
  }
  var k0: string = keys[0];
  if (k0.len() == 0) {
    return "";
  }
  var i: i32 = 1;
  while (i < keys.len()) {
    if (keys[i] != k0) {
      return "";
    }
    i = i + 1;
  }
  return k0;
}

// strarrfld_forwarders_of: the whole program's string[]-field forwarders, as
// registry rows the call-site probe reads with tagged_value_of:
//
//   "m:<Recv>.<method>|<T>.<field>"  a method, for a call whose receiver type
//                                    fnfld_obj_type resolves
//   "n:<method>|<field>"             the same method by NAME alone, for a call
//                                    whose receiver type it does not — the mark
//                                    is the bare field name, which the
//                                    admission reads as poisoning that field in
//                                    every type
//   "f:<name>|<T>.<field>"           a free function
//
// A free-function row is NOT filtered against the names a frame shadows, the
// way the fresh-array producers are. The two registries answer opposite
// questions: a producer row ADMITS a store, so a shadowed name must drop out or
// an unknown body gets credited; a forwarder row MARKS a read, so a shadowed
// name marks a field that was never handed out — over-marking, the direction
// this whole scan already errs in.
function strarrfld_forwarders_of(funcs: parser.FuncDecl[], structs: irtables.StructTab): string[] {
  var out: string[] = [];
  for fn in funcs {
    var k: string = strarrfld_fwd_field_of(fn, structs);
    if (k.len() > 0) {
      if (fn.receiver_name.len() > 0) {
        out = push_str_unique(out, "m:" + util.base_type_name(fn.receiver_type) + "." + fn.name + "|" + k);
        var dot: i32 = 0;
        while (dot < k.len() && k[dot] != b'.') {
          dot = dot + 1;
        }
        out = push_str_unique(out, "n:" + fn.name + "|" + slice_unchecked(k, dot + 1, k.len()));
      } else {
        out = push_str_unique(out, "f:" + fn.name + "|" + k);
      }
    }
  }
  return out;
}

// strarrfld_fwd_values: every <value> under "<pfx><name>|" in `names`. The
// tagged_value_of sibling for a key more than one row can answer — two types
// may declare the same method name, and a call whose receiver will not resolve
// has to mark what all of them forward.
function strarrfld_fwd_values(names: string[], pfx: string, name: string, acc: string[]): string[] {
  var a: string[] = acc;
  var i: i32 = 0;
  while (i < names.len()) {
    var e: string = names[i];
    var st: i32 = tagged_value_start(e, pfx, name);
    if (st >= 0 && st < e.len()) {
      a = push_str_unique(a, slice_unchecked(e, st, e.len()) + "");
    }
    i = i + 1;
  }
  return a;
}

// strarrfld_fwd_marks: the field marks a CALL of a registered forwarder makes.
// Empty when the call is not one, which is also how the callers test for it.
function strarrfld_fwd_marks(c: ast.ExprCall, structs: irtables.StructTab, binds: string[], forwarders: string[]): string[] {
  var out: string[] = [];
  if (forwarders.len() == 0) {
    return out;
  }
  match (c.callee) {
    ast.ExprFieldAccess(cfa) => {
      var oty: string = fnfld_obj_type(cfa.obj, structs, binds);
      if (oty.len() > 0) {
        var v: string = tagged_value_of(forwarders, "m:", oty + "." + cfa.field);
        if (v.len() > 0) {
          out = out.append(v);
        }
        return out;
      }
      return strarrfld_fwd_values(forwarders, "n:", cfa.field, out);
    },
    ast.ExprIdent(cid) => {
      var fv: string = tagged_value_of(forwarders, "f:", cid.name);
      if (fv.len() > 0) {
        out = out.append(fv);
      }
      return out;
    },
    _ => {
      return out;
    }
  }
  return out;
}

// strarrfld_elem_src_marks: the field marks a registered forwarder call makes
// when `e` is one and its result is read for its ELEMENTS — indexed, sliced or
// iterated. Only there does the caller take an uncounted alias: the forwarding
// return retains the buffer ("ret-field"), so a result bound or handed on whole
// is a counted reference whose own release keeps the elements alive past the
// holder's field reclaim (#9187). An element read off it is not, exactly as
// `h.xs[0]` is not.
function strarrfld_elem_src_marks(e: ast.Expr, structs: irtables.StructTab, binds: string[], forwarders: string[], acc: string[]): string[] {
  var a: string[] = acc;
  match (e) {
    ast.ExprCall(c) => {
      for m in strarrfld_fwd_marks(c, structs, binds, forwarders) {
        a = push_str_unique(a, m);
      }
    },
    _ => {}
  }
  return a;
}

// strarrfld_ret_is_fwd: `e` is exactly the forwarding read `<recv>.<field>`
// that `key` names — the one read a forwarder's own body is exempt from.
function strarrfld_ret_is_fwd(e: ast.Expr, structs: irtables.StructTab, binds: string[], key: string): boolean {
  if (key.len() == 0) {
    return false;
  }
  match (e) {
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(_) => {
          var oty: string = fnfld_obj_type(fa.obj, structs, binds);
          if (oty.len() == 0) {
            return false;
          }
          return oty + "." + fa.field == key;
        },
        _ => {
          return false;
        }
      }
    },
    _ => {
      return false;
    }
  }
  return false;
}

function strarrfld_scan(e: ast.Expr, structs: irtables.StructTab, binds: string[], str_fresh: string[], strarr_producers: string[], forwarders: string[], acc: string[]): string[] {
  var a: string[] = acc;
  match (e) {
    ast.ExprFieldAccess(fa) => {
      var oty: string = fnfld_obj_type(fa.obj, structs, binds);
      if (oty.len() > 0) {
        a = push_str_unique(a, oty + "." + fa.field);
      } else {
        a = push_str_unique(a, fa.field);
      }
      return strarrfld_scan(fa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
          // The transient ELEMENT receiver is tested FIRST: `.len()` is
          // in both vocabularies, and the whole-array branch below would
          // otherwise take `x.f[i].len()` and walk the index expression,
          // marking the field the element came out of.
          if (strarrfld_transient_elem_recv(cfa, structs, binds)) {
            // `x.f[i].len()` and its read-only siblings: the ELEMENT
            // is borrowed for the length of one call and never bound,
            // so the field's elements stay solely the struct's — the
            // same transient-vs-lasting line strarr_expr_unsafe draws
            // for a string[] LOCAL, which this scan did not draw for a
            // FIELD. Skip marking the receiver field; keep walking the
            // index expression and everything beneath the field.
            a = strarrfld_scan_operand(cfa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
          } else if (cfa.field == "len") {
            // `x.f.len()` is the other tolerated borrow: skip marking
            // the receiver FIELD, but keep walking beneath it.
            match (cfa.obj) {
              ast.ExprFieldAccess(ffa) => {
                a = strarrfld_scan(ffa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
              },
              _ => {
                a = strarrfld_scan(cfa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
              }
            }
          } else {
            a = strarrfld_scan(cfa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
          }
        },
        _ => {
          a = strarrfld_scan(c.callee, structs, binds, str_fresh, strarr_producers, forwarders, a);
        }
      }
      for arg in c.args {
        a = strarrfld_scan(arg, structs, binds, str_fresh, strarr_producers, forwarders, a);
      }
      return a;
    },
    ast.ExprBinary(b) => {
      return strarrfld_scan_operand(b.right, structs, binds, str_fresh, strarr_producers, forwarders, strarrfld_scan_operand(b.left, structs, binds, str_fresh, strarr_producers, forwarders, a));
    },
    ast.ExprUnary(u) => {
      return strarrfld_scan(u.operand, structs, binds, str_fresh, strarr_producers, forwarders, a);
    },
    ast.ExprIndex(ix) => {
      a = strarrfld_elem_src_marks(ix.array, structs, binds, forwarders, a);
      return strarrfld_scan(ix.index, structs, binds, str_fresh, strarr_producers, forwarders, strarrfld_scan(ix.array, structs, binds, str_fresh, strarr_producers, forwarders, a));
    },
    ast.ExprSlice(sl) => {
      a = strarrfld_elem_src_marks(sl.array, structs, binds, forwarders, a);
      return strarrfld_scan(sl.end, structs, binds, str_fresh, strarr_producers, forwarders, strarrfld_scan(sl.start, structs, binds, str_fresh, strarr_producers, forwarders, strarrfld_scan(sl.array, structs, binds, str_fresh, strarr_producers, forwarders, a)));
    },
    ast.ExprStructLit(sl2) => {
      if (sl2.has_base) {
        a = strarrfld_scan(sl2.base, structs, binds, str_fresh, strarr_producers, forwarders, a);
        // A functional-update BASE copies every field the literal does
        // not override, pointer-for-pointer. The copy takes no retain
        // for an array field, so both boxes hold the same buffer with
        // one reference between them: STORE-unsafe for the buffer dec,
        // whatever the overrides look like.
        var sdi: i32 = irtables.stab_struct_first(structs, sl2.type_name);
        while (sdi >= 0) {
          for fld in structs.decls[sdi].fields {
            if (fld.type_name == "string[]") {
              a = push_str_unique(a, "store:" + sl2.type_name + "." + fld.name);
            }
          }
          sdi = irtables.stab_next(structs, sdi, sl2.type_name);
        }
      }
      var i: i32 = 0;
      while (i < sl2.field_names.len()) {
        var fkt: string = irtables.decl_field_type(structs, sl2.type_name, sl2.field_names[i]);
        // Set by the string[] admission below and read by the value walk
        // at the end of this iteration, so it lives in the loop-body scope
        // rather than inside that branch.
        var share_read: boolean = false;
        // A struct-ARRAY / enum-ARRAY field uses the SAME scan (#7067):
        // its element boxes are freed by __field_reclaim_<T>'s walk on a
        // rebind, so the field is admitted only when every stored value
        // is an array literal of FRESH elements — boxarr_lit_all_elems_fresh,
        // the identical proof the reuse admission makes for these fields.
        // `d.vals.append(v)` and any other non-literal store share element
        // pointers with the buffer it supersedes, and freeing those is a
        // double free.
        if (irtables.is_struct_array_field_type(structs, fkt) || irtables.is_enum_array_field_type(structs, fkt)) {
          if (!boxarr_lit_all_elems_fresh(sl2.field_values[i], structs, slice_unchecked(fkt, 0, fkt.len() - 2), irtables.is_enum_array_field_type(structs, fkt))) {
            a = push_str_unique(a, sl2.type_name + "." + sl2.field_names[i]);
          }
        }
        if (fkt == "string[]") {
          var store_ok: boolean = false;
          match (sl2.field_values[i]) {
            ast.ExprArray(av) => {
              store_ok = true;
              var ei: i32 = 0;
              while (ei < av.elements.len()) {
                if (!strarr_value_is_fresh(av.elements[ei], str_fresh)) {
                  store_ok = false;
                }
                ei = ei + 1;
              }
            },
            ast.ExprCall(fc) => {
              // A whole-array PRODUCER call: fn_returns_fresh_strarr
              // proved whole-program that every element of the result
              // is a box the callee allocated and handed out at rc=1,
              // so the struct owns them exactly as it owns a literal's.
              // `strarr_producers` is filtered per function before the
              // walk, so a callee name this frame declares or takes
              // as a parameter is already absent — it would hold an
              // unknown body, the refusal every registry consumer
              // makes.
              match (fc.callee) {
                ast.ExprIdent(fcid) => {
                  store_ok = util.index_of_str(strarr_producers, fcid.name) >= 0;
                },
                _ => {}
              }
            },
            _ => {}
          }
          // A bare IDENT — a parameter or a live local. Admitting it
          // is what turns the construction retain on for this type
          // (both go through struct_routes_field_reclaim), so the field
          // holds a counted reference rather than an uncounted alias
          // and the drop's dec is balanced against it. Refusing it was
          // the third leg of the circularity: unadmitted meant no
          // retain, and no retain meant it could not be admitted.
          match (sl2.field_values[i]) {
            ast.ExprIdent(_) => {
              store_ok = true;
            },
            _ => {}
          }
          // A bare `q.f` READ of another holder's string[] field, handed
          // straight into a string[] field of this literal — the counted
          // share str_field_share_read draws for a scalar `string`, and
          // enum_arr_field_share_read for an `E[]`. `string[]` was the one
          // field kind left out, which is `str_arr__fieldread` (#5338).
          //
          // Admitting it is sound for the reason the bare-ident case above
          // is: the construction RETAINS an array field unconditionally
          // (is_array_type_name covers string[] in the ExprStructLit arm),
          // so the new holder co-owns a COUNTED reference and its drop's dec
          // is balanced against it. `str_arr__local` measures that retain
          // already working — the difference here is only that the value is
          // read out of a sibling rather than out of a local.
          //
          // Both ends are checked: the SOURCE field and the TARGET field
          // must both be string[], and the holder must be a bare ident so
          // the share has one identifiable co-owner. `foo().f` is refused —
          // there is no second holder to keep alive, so the read is an
          // ordinary escape.
          match (sl2.field_values[i]) {
            ast.ExprFieldAccess(sfa) => {
              match (sfa.obj) {
                ast.ExprIdent(_) => {
                  var soty: string = fnfld_obj_type(sfa.obj, structs, binds);
                  if (soty.len() > 0
                    && irtables.decl_field_type(structs, soty, sfa.field) == "string[]"
                    && irtables.decl_field_type(structs, sl2.type_name, sl2.field_names[i]) == "string[]") {
                    store_ok = true;
                    share_read = true;
                  }
                },
                _ => {}
              }
            },
            _ => {}
          }
          if (!store_ok) {
            a = push_str_unique(a, sl2.type_name + "." + sl2.field_names[i]);
            // The STORE half on its own, under an inert prefixed
            // spelling. The plain mark above is pushed for a bad
            // store AND for an unsafe READ, and the two gate
            // different things: a read hazard costs the ELEMENT
            // walk, a store hazard costs the BUFFER dec as well,
            // because the stored value is then an uncounted alias
            // the construction never retained.
            a = push_str_unique(a, "store:" + sl2.type_name + "." + sl2.field_names[i]);
          }
        }
        // The admitted share is NOT walked as a read: marking it would
        // refuse the SOURCE holder's reclaim, and a share needs both ends
        // alive to balance. Its holder is still walked, so a mark owed by a
        // more complex object expression is not lost — though a non-ident
        // holder never reaches here, since the admission above requires one.
        if (share_read) {
          match (sl2.field_values[i]) {
            ast.ExprFieldAccess(wfa) => {
              a = strarrfld_scan(wfa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
            },
            _ => {}
          }
        } else {
          a = strarrfld_scan(sl2.field_values[i], structs, binds, str_fresh, strarr_producers, forwarders, a);
        }
        i = i + 1;
      }
      return a;
    },
    ast.ExprArray(av2) => {
      var i: i32 = 0;
      while (i < av2.elements.len()) {
        a = strarrfld_scan(av2.elements[i], structs, binds, str_fresh, strarr_producers, forwarders, a);
        i = i + 1;
      }
      return a;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        // A string[] field read the literal retains is a counted
        // reference, not an alias: the field keeps its element walk.
        match (el) {
          ast.ExprFieldAccess(tfa) => {
            if (tuple_field_share_kind(el) == "S") {
              a = strarrfld_scan(tfa.obj, structs, binds, str_fresh, strarr_producers, forwarders, a);
              continue;
            }
          },
          _ => {}
        }
        a = strarrfld_scan(el, structs, binds, str_fresh, strarr_producers, forwarders, a);
      }
      return a;
    },
    ast.ExprMapLit(ml) => {
      // A map literal and an f-string carry ordinary sub-expressions, which
      // every sibling walk in this file visits and this one did not: an
      // unwalked `f"{h.xs[0]}"` is an element handed to a formatter with
      // nothing marked.
      for k in ml.keys {
        a = strarrfld_scan(k, structs, binds, str_fresh, strarr_producers, forwarders, a);
      }
      for v in ml.vals {
        a = strarrfld_scan(v, structs, binds, str_fresh, strarr_producers, forwarders, a);
      }
      return a;
    },
    ast.ExprFString(fs) => {
      for x in fs.exprs {
        a = strarrfld_scan(x, structs, binds, str_fresh, strarr_producers, forwarders, a);
      }
      return a;
    },
    ast.ExprLambda(lm) => {
      return strarrfld_scan_stmts(lm.body, structs, binds, str_fresh, strarr_producers, forwarders, "", a);
    },
    _ => {
      return a;
    }
  }
}

// strarrfld_share_bind_stores: the site keys of every
// `var p: T = T { …, <string[] field>: name, … }` bind directly in `stmts` —
// the one position a share-bound local may legally reach. The store retains
// the buffer, so the new holder co-owns a COUNTED reference exactly as the
// inline share's does. Feeds strarr_unsafe_for_alias's `sfld_ok`, which is
// already keyed this way for the local credit's own version of this question.
//
// A store nested inside an if / while / match body is not collected, so
// strarr_unsafe_for_alias flags it and the bind is refused — the conservative
// direction, and the reason this only needs the flat list.
function strarrfld_share_bind_stores(stmts: ast.Stmt[], name: string, structs: irtables.StructTab): string[] {
  var out: string[] = [];
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        match (v.init) {
          ast.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_names.len()) {
              match (sl.field_values[i]) {
                ast.ExprIdent(id) => {
                  if (id.name == name
                    && irtables.decl_field_type(structs, sl.type_name, sl.field_names[i]) == "string[]") {
                    out = push_str_unique(out, irtables.reclaim_site_key_of(v.name, v.line, v.col));
                  }
                },
                _ => {}
              }
              i = i + 1;
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
  }
  return out;
}

// strarrfld_bind_read: the expression a `var` initialiser contributes to the
// read walk. Normally the initialiser itself; for an admitted share BIND, only
// its HOLDER.
//
// `var tt: string[] = q.f;` is the hoisted spelling of the inline share
// strarrfld_scan admits at its struct-literal store — the same read, through a
// local.
// Marking it would refuse the SOURCE holder's reclaim, and a share needs both
// ends alive to balance, so the read drops out and the holder is still walked.
//
// Admitting it needs one thing the inline position gets for free: proof that
// the local reaches nothing but that store. `tt` is a plain local, so the field
// scan sees none of its uses, and an unchecked bind would let `return tt[0]`
// outlive the holder's deep free. strarr_unsafe_for_alias is that proof, and
// it is the classifier the local "SARR:" credit already uses for the identical
// question: its `sfld_ok` carve-out forgives the struct-literal store, while
// every other use of `tt` — an element bind, a return, a call argument, an
// append, a slice, an iteration — stays a hazard.
//
// `borrowable` is empty rather than the real registry, which is not built at
// admission time: it can only refuse a call-argument borrow, never grant one.
function strarrfld_bind_read(v: ast.StmtVar, stmts: ast.Stmt[], structs: irtables.StructTab, binds: string[], str_fresh: string[]): ast.Expr {
  if (v.type_name != "string[]") {
    return v.init;
  }
  match (v.init) {
    ast.ExprFieldAccess(fa) => {
      match (fa.obj) {
        ast.ExprIdent(_) => {
          var oty: string = fnfld_obj_type(fa.obj, structs, binds);
          if (oty.len() == 0 || irtables.decl_field_type(structs, oty, fa.field) != "string[]") {
            return v.init;
          }
          var sfld_ok: string[] = strarrfld_share_bind_stores(stmts, v.name, structs);
          if (sfld_ok.len() == 0) {
            return v.init;
          }
          var no_alias: string[] = [];
          var no_borrow: string[] = [];
          var no_producers: string[] = [];
          if (strarr_unsafe_for_alias(stmts, v.name, no_borrow, str_fresh, no_producers, no_alias, sfld_ok)) {
            return v.init;
          }
          return fa.obj;
        },
        _ => {
          return v.init;
        }
      }
    },
    _ => {
      return v.init;
    }
  }
  return v.init;
}

function strarrfld_scan_stmts(stmts: ast.Stmt[], structs: irtables.StructTab, binds: string[], str_fresh: string[], strarr_producers: string[], forwarders: string[], fwd_exempt: string, acc: string[]): string[] {
  var a: string[] = acc;
  var b: string[] = binds;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        a = strarrfld_scan(strarrfld_bind_read(v, stmts, structs, b, str_fresh), structs, b, str_fresh, strarr_producers, forwarders, a);
        // `var r: R = …` binds by annotation, `var r = R { … }` by the
        // literal; anything else drops the name, so a shadowing rebind
        // never inherits the old type. Same rule as fnfld_read_stmts.
        var vty: string = v.type_name;
        if (vty.len() == 0) {
          vty = fnfld_lit_type(v.init);
        }
        b = fnfld_bind(b, v.name, vty, structs);
      },
      ast.StmtAssign(as2) => {
        a = strarrfld_scan(as2.value, structs, b, str_fresh, strarr_producers, forwarders, a);
      },
      ast.StmtExpr(ex) => {
        a = strarrfld_scan(ex.value, structs, b, str_fresh, strarr_producers, forwarders, a);
      },
      ast.StmtReturn(r) => {
        // A forwarder's own forwarding return: handing the field out is
        // its contract, and its CALL sites carry the verdict. Marking
        // it here refused the type program-wide on the declaration
        // alone, called or not (#7417).
        if (!strarrfld_ret_is_fwd(r.value, structs, b, fwd_exempt)) {
          a = strarrfld_scan(r.value, structs, b, str_fresh, strarr_producers, forwarders, a);
        }
      },
      ast.StmtIf(iff) => {
        a = strarrfld_scan(iff.cond, structs, b, str_fresh, strarr_producers, forwarders, a);
        a = strarrfld_scan_stmts(iff.then_body, structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
        a = strarrfld_scan_stmts(iff.else_body, structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
      },
      ast.StmtWhile(w) => {
        a = strarrfld_scan(w.cond, structs, b, str_fresh, strarr_producers, forwarders, a);
        a = strarrfld_scan_stmts(w.body, structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
      },
      ast.StmtFor(fo) => {
        a = strarrfld_elem_src_marks(fo.iter, structs, b, forwarders, a);
        a = strarrfld_scan(fo.iter, structs, b, str_fresh, strarr_producers, forwarders, a);
        a = strarrfld_scan_stmts(fo.body, structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
      },
      ast.StmtMatch(m) => {
        a = strarrfld_scan(m.scrutinee, structs, b, str_fresh, strarr_producers, forwarders, a);
        for arm in m.arms {
          if (arm.has_guard) {
            a = strarrfld_scan(arm.guard, structs, b, str_fresh, strarr_producers, forwarders, a);
          }
          a = strarrfld_scan_stmts(arm.body, structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
        }
      },
      ast.StmtDefer(d) => {
        a = strarrfld_scan_stmts([d.action], structs, b, str_fresh, strarr_producers, forwarders, fwd_exempt, a);
      },
      _ => {}
    }
  }
  return a;
}

// fn_has_param_named: `fn` takes a parameter (or receiver) spelled `name`.
function fn_has_param_named(fn: parser.FuncDecl, name: string): boolean {
  if (fn.receiver_name == name) {
    return true;
  }
  var i: i32 = 0;
  while (i < fn.params.len()) {
    if (fn.params[i].name == name) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// strarrfld_fn_binds seeds the scan's type bindings for one function: its
// receiver and every parameter, so `b.notes[0]` inside a method resolves to
// "<Recv>.notes" instead of poisoning the bare name everywhere.
// strarrfld_program_has_field: some struct declares a `string[]` field.
function strarrfld_program_has_field(structs: irtables.StructTab): boolean {
  for sd in structs.decls {
    if (struct_has_strarr_field(structs, sd.name)) {
      return true;
    }
  }
  return false;
}

// strarr_visible_producers: the whole-array producers `fn` can call by name —
// a local or parameter of a producer's name holds an unknown body, not the
// registered declaration.
function strarr_visible_producers(fn: parser.FuncDecl, producers: string[]): string[] {
  var bound: string[] = astwalk.collect_bound_stmts(fn.body, []);
  var vis: string[] = [];
  for pn in producers {
    if (!util.has_str(bound, pn) && !fn_has_param_named(fn, pn)) {
      vis = vis.append(pn);
    }
  }
  return vis;
}

// StrarrOwnSrc is what strarr_owned_value can prove ownership from: the
// frame's fresh-string and producer registries, its owned locals, and its
// struct-typed names (fnfld_bind pairs) for a field read's receiver.
struct StrarrOwnSrc { str_fresh: string[], producers: string[], owned: string[], binds: string[], structs: irtables.StructTab }

// strarr_owned_value: `e` hands over a `string[]` whose elements are owned by
// its buffer — an element-fresh literal, a call to a visible producer, a local
// in `owned`, or a holder's `string[]` field read, the counted share the
// struct-literal gate already admits inline.
function strarr_owned_value(e: ast.Expr, src: StrarrOwnSrc): boolean {
  if let ast.ExprArray(al) = e {
    for el in al.elements {
      if (!strarr_value_is_fresh(el, src.str_fresh)) {
        return false;
      }
    }
    return true;
  }
  if let ast.ExprCall(c) = e {
    return util.has_str(src.producers, ident_name_or_empty(c.callee));
  }
  if let ast.ExprIdent(id) = e {
    return util.has_str(src.owned, id.name);
  }
  if let ast.ExprFieldAccess(fa) = e {
    if (ident_name_or_empty(fa.obj).len() == 0) {
      return false;
    }
    return irtables.decl_field_type(src.structs, fnfld_obj_type(fa.obj, src.structs, src.binds), fa.field) == "string[]";
  }
  return false;
}

// strarr_owned_rebind: an assignment to an element-owned local keeps it one —
// an owned value, or a self-append of a fresh element.
function strarr_owned_rebind(a: ast.StmtAssign, src: StrarrOwnSrc): boolean {
  if (strarr_owned_value(a.value, src)) {
    return true;
  }
  if let ast.ExprCall(c) = a.value {
    if let ast.ExprFieldAccess(fa) = c.callee {
      return fa.field == "append" && ident_name_or_empty(fa.obj) == a.target && c.args.len() == 1
        && strarr_value_is_fresh(c.args[0], src.str_fresh);
    }
  }
  return false;
}

// strarr_local_owned_decls: how many `var name = …` declarations `stmts` holds,
// or -1 when one of them, or an assignment to `name`, stores a value whose
// elements the local would not own.
function strarr_local_owned_decls(stmts: ast.Stmt[], name: string, src: StrarrOwnSrc): i32 {
  var acc: StrarrDeclCount = StrarrDeclCount { name: name, src: src, n: 0 };
  for st in stmts {
    acc = astwalk.fold_stmt_spine(st, acc, strarr_decl_count_step);
  }
  return acc.n;
}

// StrarrDeclCount threads strarr_local_owned_decls' walk: the local, what its
// ownership is proved from, and the declarations counted so far.
struct StrarrDeclCount { name: string, src: StrarrOwnSrc, n: i32 }

function strarr_decl_count_step(st: ast.Stmt, own acc: StrarrDeclCount): StrarrDeclCount {
  if (acc.n < 0) {
    return acc;
  }
  if let ast.StmtVar(v) = st {
    if (v.name != acc.name) {
      return acc;
    }
    if (!strarr_owned_value(v.init, acc.src)) {
      return StrarrDeclCount { ...acc, n: 0 - 1 };
    }
    return StrarrDeclCount { ...acc, n: acc.n + 1 };
  }
  if let ast.StmtAssign(a) = st {
    if (a.target == acc.name && !strarr_owned_rebind(a, acc.src)) {
      return StrarrDeclCount { ...acc, n: 0 - 1 };
    }
  }
  return acc;
}

// StrarrOwnFrame is what strarrfld_borrowed_elem_marks knows about one body:
// `params` is aligned with the function's parameters, naming each one whose
// value is the caller's argument for the whole body ("" otherwise); `owned`
// (in `src`) holds the locals whose every element is theirs. `stores` is the second pass's
// parameter-store registry, empty on the first.
// store_keys indexes `stores` by the key before each row's '|', so a call
// asks whether a parameter position has a store without a prefix scan.
struct StrarrOwnFrame { fnkey: string, params: string[], src: StrarrOwnSrc, stores: string[], store_keys: util.NameIndex, store_fns: string[] }

function strarr_store_keys(stores: string[]): util.NameIndex {
  var keys: string[] = [];
  for row in stores {
    var bar: i32 = 0;
    while (bar < row.len() && row[bar] != b'|') {
      bar = bar + 1;
    }
    keys = keys.append(slice_unchecked(row, 0, bar) + "");
  }
  return util.name_index(keys);
}

function strarr_own_frame_of(fn: parser.FuncDecl, structs: irtables.StructTab, str_fresh: string[], producers: string[], stores: string[], store_keys: util.NameIndex, store_fns: string[]): StrarrOwnFrame {
  var vis: string[] = strarr_visible_producers(fn, producers);
  var bound: string[] = astwalk.collect_bound_stmts(fn.body, []);
  var assigned: string[] = irtables.body_assign_targets(fn.body);
  var params: string[] = [];
  for p in fn.params {
    if (p.type_name == "string[]" && !util.has_str(bound, p.name) && !util.has_str(assigned, p.name)) {
      params = params.append(p.name);
    } else {
      params = params.append("");
    }
  }
  var src: StrarrOwnSrc = StrarrOwnSrc { str_fresh: str_fresh, producers: vis, owned: [], binds: strarr_frame_binds(fn, structs), structs: structs };
  src = StrarrOwnSrc { ...src, owned: strarr_owned_locals(fn, bound, src) };
  return StrarrOwnFrame { fnkey: fn.name, params: params, src: src, stores: stores, store_keys: store_keys, store_fns: store_fns };
}

// strarr_frame_binds: strarrfld_fn_binds plus every struct-typed local of `fn`,
// name-level like the rest of the frame.
function strarr_frame_binds(fn: parser.FuncDecl, structs: irtables.StructTab): string[] {
  var b: string[] = strarrfld_fn_binds(fn, structs);
  for v in strarr_var_decls(fn.body, []) {
    var vty: string = v.type_name;
    if (vty.len() == 0) {
      vty = fnfld_lit_type(v.init);
    }
    if (irtables.decl_is_struct(structs, vty)) {
      b = fnfld_bind(b, v.name, vty, structs);
    }
  }
  return b;
}

// strarr_owned_locals: the `string[]` locals of `fn` whose elements their own
// buffer owns — every binder of the name a declaration, and every declaration
// and assignment an owned value. An alias of an owned local is one too, so the
// set grows to a fixed point.
function strarr_owned_locals(fn: parser.FuncDecl, bound: string[], src: StrarrOwnSrc): string[] {
  var cands: string[] = strarr_owned_candidates(fn);
  var owned: string[] = [];
  var grew: boolean = true;
  while (grew) {
    grew = false;
    for nm in cands {
      if (!util.has_str(owned, nm)) {
        var decls: i32 = strarr_local_owned_decls(fn.body, nm, StrarrOwnSrc { ...src, owned: owned });
        if (decls > 0 && decls == strarr_count_of(bound, nm)) {
          owned = owned.append(nm);
          grew = true;
        }
      }
    }
  }
  return owned;
}

// strarr_owned_candidates: the locals of `fn` declared `string[]` or
// unannotated, parameters and the receiver excluded.
function strarr_owned_candidates(fn: parser.FuncDecl): string[] {
  var cands: string[] = [];
  for v in strarr_var_decls(fn.body, []) {
    if ((v.type_name == "string[]" || v.type_name == "") && !util.has_str(cands, v.name)
      && !fn_has_param_named(fn, v.name) && v.name != fn.receiver_name) {
      cands = cands.append(v.name);
    }
  }
  return cands;
}

function strarr_count_of(names: string[], nm: string): i32 {
  var n: i32 = 0;
  for b in names {
    if (b == nm) {
      n = n + 1;
    }
  }
  return n;
}

// strarr_var_decls: every `var` declaration in `stmts`, lambda bodies aside.
function strarr_var_decls(stmts: ast.Stmt[], own acc: ast.StmtVar[]): ast.StmtVar[] {
  for st in stmts {
    acc = astwalk.fold_stmt_spine(st, acc, strarr_var_decl_step);
  }
  return acc;
}

function strarr_var_decl_step(st: ast.Stmt, own acc: ast.StmtVar[]): ast.StmtVar[] {
  if let ast.StmtVar(v) = st {
    return acc.append(v);
  }
  return acc;
}

// strarr_frame_param_key: "<fn>#<index>" when `e` names one of the frame's
// tracked parameters, else "".
function strarr_frame_param_key(e: ast.Expr, fr: StrarrOwnFrame): string {
  var nm: string = ident_name_or_empty(e);
  if (nm.len() == 0) {
    return "";
  }
  var j: i32 = 0;
  while (j < fr.params.len()) {
    if (fr.params[j] == nm) {
      return fr.fnkey + "#" + util.i32_to_string(j);
    }
    j = j + 1;
  }
  return "";
}

function strarr_callee_key(c: ast.ExprCall): string {
  if let ast.ExprIdent(id) = c.callee {
    return id.name;
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    return fa.field;
  }
  return "";
}

// strarr_own_node is one expression's contribution. First pass (no `stores`
// yet): "st:<fn>#<j>|<T>.<f>" for a parameter stored bare into a `string[]`
// field, "mk:<T>.<f>" for any other bare ident stored there whose elements
// this frame does not own, and "ln:<callee>#<i>|<fn>#<j>" for a tracked
// parameter passed on bare. Second pass: "bd:<callee>#<i>" for an argument
// that reaches a storing parameter without owning its elements, and
// "cl:" / "id:" occurrences of a storing function's name, to find one used as
// a value (whose callers are unseen).
function strarr_own_node(e: ast.Expr, own st: StrarrOwnAcc): StrarrOwnAcc {
  var fr: StrarrOwnFrame = st.fr;
  var a: string[] = st.out;
  if let ast.ExprStructLit(sl) = e {
    a = strarr_own_struct_lit(sl, fr, a);
  }
  if let ast.ExprCall(c) = e {
    a = strarr_own_call(c, fr, a);
  }
  if let ast.ExprIdent(id) = e {
    if (fr.store_fns.len() > 0 && util.has_str(fr.store_fns, id.name)) {
      a = a.append("id:" + id.name);
    }
  }
  if let ast.ExprLambda(lm) = e {
    a = strarr_own_stmts(lm.body, StrarrOwnFrame { ...fr, fnkey: "", params: [], src: StrarrOwnSrc { ...fr.src, owned: [], binds: [] } }, a);
  }
  return StrarrOwnAcc { fr: fr, out: a };
}

function strarr_own_struct_lit(sl: ast.ExprStructLit, fr: StrarrOwnFrame, own a: string[]): string[] {
  if (fr.store_fns.len() > 0) {
    return a;
  }
  var i: i32 = 0;
  while (i < sl.field_names.len()) {
    if (irtables.decl_field_type(fr.src.structs, sl.type_name, sl.field_names[i]) == "string[]"
      && ident_name_or_empty(sl.field_values[i]).len() > 0) {
      var tf: string = sl.type_name + "." + sl.field_names[i];
      var pk: string = strarr_frame_param_key(sl.field_values[i], fr);
      if (pk.len() > 0) {
        a = a.append("st:" + pk + "|" + tf);
      } else if (!strarr_owned_value(sl.field_values[i], fr.src)) {
        a = a.append("mk:" + tf);
      }
    }
    i = i + 1;
  }
  return a;
}

function strarr_own_call(c: ast.ExprCall, fr: StrarrOwnFrame, own a: string[]): string[] {
  var k: string = strarr_callee_key(c);
  if (k.len() == 0) {
    return a;
  }
  if (fr.store_fns.len() > 0 && util.has_str(fr.store_fns, ident_name_or_empty(c.callee))) {
    a = a.append("cl:" + k);
  }
  var i: i32 = 0;
  while (i < c.args.len()) {
    var ck: string = k + "#" + util.i32_to_string(i);
    var pk: string = strarr_frame_param_key(c.args[i], fr);
    if (fr.store_fns.len() == 0) {
      if (pk.len() > 0) {
        a = a.append("ln:" + ck + "|" + pk);
      }
    } else if (pk.len() == 0 && !strarr_owned_value(c.args[i], fr.src) && fr.store_keys.has(ck)) {
      a = a.append("bd:" + ck);
    }
    i = i + 1;
  }
  return a;
}

function strarr_not_lambda(e: ast.Expr): boolean {
  if let ast.ExprLambda(_) = e {
    return false;
  }
  return true;
}

// StrarrOwnAcc threads the frame through the fold beside the rows it collects.
struct StrarrOwnAcc { fr: StrarrOwnFrame, out: string[] }

// strarr_own_stmts folds strarr_own_node over `stmts`. A lambda body is folded
// on its own with an empty frame: its parameters and locals are not the
// enclosing function's.
function strarr_own_stmts(stmts: ast.Stmt[], fr: StrarrOwnFrame, out: string[]): string[] {
  var acc: StrarrOwnAcc = StrarrOwnAcc { fr: fr, out: out };
  for st in stmts {
    acc = astwalk.fold_stmt_pruned(st, acc, strarr_own_node, strarr_not_lambda);
  }
  return acc.out;
}

// strarr_keyed_values: the text after `pfx` of every entry of `rows` that
// starts with it.
function strarr_keyed_values(rows: string[], pfx: string): string[] {
  var out: string[] = [];
  for r in rows {
    if (r.len() >= pfx.len() && bytes_at(r, 0, pfx)) {
      out = out.append(slice_unchecked(r, pfx.len(), r.len()) + "");
    }
  }
  return out;
}

// strarr_param_stores: "<fn>#<j>|<T>.<f>" for every parameter whose argument
// reaches a `string[]` field bare — stored there, or passed on bare to a
// parameter that is (`links`, least fixed point over forwarding chains).
function strarr_param_stores(direct: string[], links: string[]): string[] {
  var stores: string[] = direct;
  var grew: boolean = true;
  while (grew) {
    grew = false;
    for ln in links {
      var bar: i32 = 0;
      while (ln[bar] != b'|') {
        bar = bar + 1;
      }
      var callee: string = slice_unchecked(ln, 0, bar + 1) + "";
      var caller: string = slice_unchecked(ln, bar + 1, ln.len()) + "";
      for tf in strarr_keyed_values(stores, callee) {
        var row: string = caller + "|" + tf;
        if (!util.has_str(stores, row)) {
          stores = stores.append(row);
          grew = true;
        }
      }
    }
  }
  return stores;
}

// strarrfld_borrowed_elem_marks: the `string[]` fields a bare-ident store can
// reach with elements it does not own (#10405). The struct-literal gate admits a
// bare ident because the construction retains the BUFFER, but the element walk
// also needs every element to be the array's: `names = names.append(item.name)`
// holds boxes `item` still owns, and walking them from a field frees them under
// it. A local proves that in its own frame (strarr_local_owned_decls); a
// parameter at every call site, so its verdict moves there as a forwarder's does.
// Each mark is the READ half only: the retained buffer still goes back through
// "arrbuf:".
function strarrfld_borrowed_elem_marks(funcs: parser.FuncDecl[], structs: irtables.StructTab, str_fresh: string[], producers: string[], acc: string[]): string[] {
  var none: string[] = [];
  var no_keys: util.NameIndex = util.name_index(none);
  var first: string[] = [];
  for fn in funcs {
    first = strarr_own_stmts(fn.body, strarr_own_frame_of(fn, structs, str_fresh, producers, none, no_keys, none), first);
  }
  var stores: string[] = strarr_param_stores(strarr_keyed_values(first, "st:"), strarr_keyed_values(first, "ln:"));
  var store_keys: util.NameIndex = strarr_store_keys(stores);
  var a: string[] = acc;
  for tf in strarr_keyed_values(first, "mk:") {
    a = push_str_unique(a, tf);
  }
  if (stores.len() == 0) {
    return a;
  }
  var store_fns: string[] = strarr_store_fns(stores);
  var second: string[] = [];
  for fn in funcs {
    second = strarr_own_stmts(fn.body, strarr_own_frame_of(fn, structs, str_fresh, producers, stores, store_keys, store_fns), second);
  }
  for bk in strarr_keyed_values(second, "bd:") {
    for tf in strarr_keyed_values(stores, bk + "|") {
      a = push_str_unique(a, tf);
    }
  }
  for fname in store_fns {
    if (strarr_count_of(second, "id:" + fname) > strarr_count_of(second, "cl:" + fname)) {
      for pf in strarr_keyed_values(stores, fname + "#") {
        a = push_str_unique(a, strarr_after_bar(pf));
      }
    }
  }
  return a;
}

// strarr_store_fns: the functions that own a storing parameter.
function strarr_store_fns(stores: string[]): string[] {
  var out: string[] = [];
  for row in stores {
    var h: i32 = 0;
    while (row[h] != b'#') {
      h = h + 1;
    }
    out = push_str_unique(out, slice_unchecked(row, 0, h) + "");
  }
  return out;
}

// strarr_after_bar: the text after the first `|` of a registry row.
function strarr_after_bar(row: string): string {
  var bar: i32 = 0;
  while (row[bar] != b'|') {
    bar = bar + 1;
  }
  return slice_unchecked(row, bar + 1, row.len()) + "";
}

function strarrfld_fn_binds(fn: parser.FuncDecl, structs: irtables.StructTab): string[] {
  var b: string[] = [];
  if (fn.receiver_name.len() > 0) {
    b = fnfld_bind(b, fn.receiver_name, util.base_type_name(fn.receiver_type), structs);
  }
  var i: i32 = 0;
  while (i < fn.params.len()) {
    b = fnfld_bind(b, fn.params[i].name, fn.params[i].type_name, structs);
    i = i + 1;
  }
  return b;
}

pub function closure_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
  var gfns: string[] = [];
  for fn in funcs {
    if (fn.receiver_type.len() == 0) {
      gfns = gfns.append(fn.name);
    }
  }
  // Indexed once for the whole pass: gfns_visible_in asks whether any of this
  // frame's binders shadows a module function, and the list is fixed here.
  var gset: irtables.SigReg = irtables.sig_reg_of(gfns);
  var out: string[] = [];
  // Every function value is an env box, so a function declared to return one
  // returns a box whatever its return statements spell (#10076). Without a
  // declared return, only a trailing `return <capturing lambda>` says so.
  // A method is listed under its bare name and, as "METHCLO:<recv>.<name>",
  // under the receiver type that resolves a call to it (closure_method_call).
  for fn in funcs {
    if (fn.ret_type == "fn") {
      out = out.append(fn.name);
      if (fn.receiver_type.len() > 0) {
        out = out.append("METHCLO:" + fn.receiver_type + "." + fn.name);
      }
    } else if (fn.body.len() > 0) {
      match (fn.body[fn.body.len() - 1]) {
        ast.StmtReturn(r) => {
          match (r.value) {
            ast.ExprLambda(lam) => {
              if (!irtables.lambda_has_no_captures(lam, irtables.gfns_visible_in(fn, gfns, gset))) {
                out = out.append(fn.name);
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
    }
  }
  // "PASSTHRU:<fn>:<argidx>" markers share the same list — a marker can never
  // collide with a function name, so every membership consumer is unaffected,
  // and the classifiers that ask whether a CALL yields a closure box can
  // recognise the generic passthrough that forwards one (arr_elem_is_closure_box).
  var ptm: string[] = typevar_passthrough_markers_of(funcs);
  var pmi: i32 = 0;
  while (pmi < ptm.len()) {
    out = out.append(ptm[pmi]);
    pmi = pmi + 1;
  }
  return out;
}

// typevar_passthrough_markers_of lists "PASSTHRU:<fn>:<argidx>" for every
// receiver-less generic function whose parameter at `argidx` is declared with
// its own return type — the lift-side lift_callee_is_typevar_passthrough test,
// carried to the read side, where the module funcs are no longer in scope.
function typevar_passthrough_markers_of(funcs: parser.FuncDecl[]): string[] {
  var out: string[] = [];
  for fn in funcs {
    if (fn.receiver_type.len() == 0 && fn.all_type_params.len() > 0) {
      var p: i32 = 0;
      while (p < fn.params.len()) {
        if (fn.params[p].type_name.len() > 0 && fn.params[p].type_name == fn.ret_type) {
          out = out.append("PASSTHRU:" + fn.name + ":" + util.i32_to_string(p));
        }
        p = p + 1;
      }
    }
  }
  return out;
}

// mkclo_funcval extracts the closure funcval name from a `__mkclo$<fv>` env-box
// constructor marker (`__mkclo$pick$clo0` -> `pick$clo0`), or "" if not one.
function mkclo_funcval(name: string): string {
  if (name.len() > 8 && slice_unchecked(name, 0, 8) == "__mkclo$") {
    return slice_unchecked(name, 8, name.len()) + "";
  }
  return "";
}

// param_consumed_in_body reports whether the callee body CONSUMES param `name`
// in a way the borrow walker reads as a harmless borrow: a reassignment
// (`name = …` — the functional-update spelling `xs = xs.append(x)` /
// `m = m.insert(k, v)`), or `name.append(…)` in ANY position — append REUSES or
// FREES a unique receiver's buffer on growth, so even the unbound
// `var ys = xs.append(x)` can free the caller's buffer out from under a
// caller-side release. expr_unsafe_for deliberately treats a bare-ident method
// receiver as a borrow (that rule is correct for its named-LOCAL consumers,
// which bail on reassignment separately via body_assign_targets), but a
// borrowability verdict feeds CALLER-side frees (the Level-2 precise drop, the
// call-arg temp reclaim), so a consumed param admitted as borrowable
// over-released: caller dec'd a buffer append had already freed (rc underflow,
// found by the #4365 stage-(b) probes; pre-existing for the L2 named-local
// drop). Consuming set: `append` — the one receiver method that releases the
// receiver buffer itself; map mutators keep the box pointer alive so the
// caller's release stays sole.
function param_consumed_expr(e: ast.Expr, name: string): boolean {
  match (e) {
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(fa) => {
          if (fa.field == "append") {
            match (fa.obj) {
              ast.ExprIdent(rid) => {
                if (rid.name == name) {
                  return true;
                }
              },
              _ => {}
            }
          }
          if (param_consumed_expr(fa.obj, name)) {
            return true;
          }
        },
        _ => {
          if (param_consumed_expr(c.callee, name)) {
            return true;
          }
        }
      }
      for arg in c.args {
        if (param_consumed_expr(arg, name)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprBinary(b) => {
      return param_consumed_expr(b.left, name) || param_consumed_expr(b.right, name);
    },
    ast.ExprUnary(u) => {
      return param_consumed_expr(u.operand, name);
    },
    ast.ExprIndex(ix) => {
      return param_consumed_expr(ix.array, name) || param_consumed_expr(ix.index, name);
    },
    ast.ExprSlice(sl) => {
      return param_consumed_expr(sl.array, name) || param_consumed_expr(sl.start, name) || param_consumed_expr(sl.end, name);
    },
    ast.ExprFieldAccess(fa) => {
      return param_consumed_expr(fa.obj, name);
    },
    ast.ExprArray(a) => {
      var i: i32 = 0;
      while (i < a.elements.len()) {
        if (param_consumed_expr(a.elements[i], name)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        if (param_consumed_expr(el, name)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprStructLit(sl) => {
      if (sl.has_base && param_consumed_expr(sl.base, name)) {
        return true;
      }
      for fv in sl.field_values {
        if (param_consumed_expr(fv, name)) {
          return true;
        }
      }
      return false;
    },
    ast.ExprLambda(lm) => {
      var i: i32 = 0;
      while (i < lm.body.len()) {
        if (param_consumed_stmt(lm.body[i], name)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    _ => {
      return false;
    }
  }
  return false;
}

function param_consumed_stmt(st: ast.Stmt, name: string): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return param_consumed_expr(v.init, name);
    },
    ast.StmtReturn(r) => {
      return param_consumed_expr(r.value, name);
    },
    ast.StmtExpr(e) => {
      return param_consumed_expr(e.value, name);
    },
    ast.StmtAssign(a) => {
      return param_consumed_expr(a.value, name);
    },
    ast.StmtIf(f) => {
      if (param_consumed_expr(f.cond, name)) {
        return true;
      }
      var ti: i32 = 0;
      while (ti < f.then_body.len()) {
        if (param_consumed_stmt(f.then_body[ti], name)) {
          return true;
        }
        ti = ti + 1;
      }
      var ei: i32 = 0;
      while (ei < f.else_body.len()) {
        if (param_consumed_stmt(f.else_body[ei], name)) {
          return true;
        }
        ei = ei + 1;
      }
      return false;
    },
    ast.StmtWhile(w) => {
      if (param_consumed_expr(w.cond, name)) {
        return true;
      }
      var i: i32 = 0;
      while (i < w.body.len()) {
        if (param_consumed_stmt(w.body[i], name)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.StmtFor(fo) => {
      if (param_consumed_expr(fo.iter, name)) {
        return true;
      }
      var i: i32 = 0;
      while (i < fo.body.len()) {
        if (param_consumed_stmt(fo.body[i], name)) {
          return true;
        }
        i = i + 1;
      }
      return false;
    },
    ast.StmtMatch(m) => {
      if (param_consumed_expr(m.scrutinee, name)) {
        return true;
      }
      for arm in m.arms {
        if (arm.has_guard && param_consumed_expr(arm.guard, name)) {
          return true;
        }
        var bi: i32 = 0;
        while (bi < arm.body.len()) {
          if (param_consumed_stmt(arm.body[bi], name)) {
            return true;
          }
          bi = bi + 1;
        }
      }
      return false;
    },
    ast.StmtDefer(d) => {
      return param_consumed_stmt(d.action, name);
    },
    _ => {
      return false;
    }
  }
  return false;
}

function param_consumed_in_body(stmts: ast.Stmt[], name: string, reassigned: string[]): boolean {
  if (util.index_of_str(reassigned, name) >= 0) {
    return true;
  }
  for stmt in stmts {
    if (param_consumed_stmt(stmt, name)) {
      return true;
    }
  }
  return false;
}

// param_match_binding_escapes: for every `match (name)` anywhere in `stmts`, does
// any arm bind a name that escapes its arm (binding_escapes_arm)? This is the
// hazard the scrutinee-is-a-borrow reading opens up on a PARAM: `b` itself is
// never mentioned outside the match, so no walk over `b` can see a payload the
// arm handed out, and a caller that then released `b` would free a live buffer.
//
// A binding of a SCALAR payload is skipped: it carries no pointer, so nothing
// it reaches keeps the box alive, and refusing the param for it stranded every
// fresh box a caller passed there (#9187). `ptype` is the scrutinee's declared
// type, which resolves the payload through the enum's StructDecl or, for the
// built-in Option / Result, through the type's own arguments; "" (unknown)
// checks every binding.
function param_match_binding_escapes(stmts: ast.Stmt[], name: string, ptype: string, structs: irtables.StructTab): boolean {
  for stmt in stmts {
    if (param_match_binding_escapes_stmt(stmt, name, ptype, structs)) {
      return true;
    }
  }
  return false;
}

function param_match_binding_escapes_stmt(st: ast.Stmt, name: string, ptype: string, structs: irtables.StructTab): boolean {
  match (st) {
    ast.StmtMatch(m) => {
      var scrut_is_name: boolean = false;
      match (m.scrutinee) {
        ast.ExprIdent(sid) => {
          if (sid.name == name) {
            scrut_is_name = true;
          }
        },
        _ => {}
      }
      for arm in m.arms {
        if (scrut_is_name) {
          match (arm.pattern) {
            ast.PatVariant(pv) => {
              if (pv.binding != "" && pv.binding != "_"
                && param_payload_binding_escapes(arm, pv.binding, payload_type_at(structs, ptype, pv.type_name, 0))) {
                return true;
              }
              var eb: i32 = 0;
              while (eb < pv.extra_bindings.len()) {
                var ebn: string = pv.extra_bindings[eb];
                if (ebn != "" && ebn != "_"
                  && param_payload_binding_escapes(arm, ebn, payload_type_at(structs, ptype, pv.type_name, eb + 1))) {
                  return true;
                }
                eb = eb + 1;
              }
            },
            _ => {}
          }
        }
        if (param_match_binding_escapes(arm.body, name, ptype, structs)) {
          return true;
        }
      }
      return false;
    },
    ast.StmtIf(iff) => {
      return param_match_binding_escapes(iff.then_body, name, ptype, structs)
        || param_match_binding_escapes(iff.else_body, name, ptype, structs);
    },
    ast.StmtWhile(w) => {
      return param_match_binding_escapes(w.body, name, ptype, structs);
    },
    ast.StmtFor(f) => {
      return param_match_binding_escapes(f.body, name, ptype, structs);
    },
    ast.StmtDefer(d) => {
      return param_match_binding_escapes_stmt(d.action, name, ptype, structs);
    },
    _ => {
      return false;
    }
  }
  return false;
}

// param_payload_binding_escapes: an arm binding of a payload of type `ft`
// ("" when unknown) escapes its arm. A scalar is a copy and never does.
function param_payload_binding_escapes(arm: ast.MatchArm, name: string, ft: string): boolean {
  return !irtables.is_scalar_type_name(ft) && payload_binding_escapes_arm(arm, name, ft);
}

// payload_type_at: the declared type of payload `k` of `variant` in the enum
// type `ptype`, or "" when it cannot be resolved.
function payload_type_at(structs: irtables.StructTab, ptype: string, variant: string, k: i32): string {
  if (ptype.len() == 0) {
    return "";
  }
  var opt: string = opt_payload_type(ptype, variant);
  if (opt.len() > 0) {
    if (k == 0) {
      return opt;
    }
    return "";
  }
  var vi: i32 = irtables.variant_decl_index(structs, variant, ptype);
  if (vi < 0 || k >= structs.decls[vi].fields.len()) {
    return "";
  }
  return structs.decls[vi].fields[k].type_name;
}

// A borrowability registry is a fixed-width bucket array, NOT a list of entries:
// exactly BORROW_REG_BUCKETS strings, bucket b holding the '\n'-terminated
// "<key>|<flags>" records whose key hashes to b. It stays a `string[]` so the
// ~20 walker signatures that thread it are untouched.
//
// Bucketing on the key's FIRST BYTE would not do: self-host names are dominated
// by shared prefixes (set_*, emit_*, is_*, lower_*, collect_*), so the worst
// first-byte bucket held 159 of the pre-split irlower.fern's 1,359 functions —
// 11.7% of the table. The whole key is hashed instead.
//
// A prime count keeps unrelated hash strides from aliasing onto the same bucket.
// Sized to the table: the compiler's own registry holds some 11 k keys across
// its tiers, and a lookup walks its bucket's records byte by byte, so 251
// buckets cost about 9.7 k instructions per lookup.
function borrow_reg_buckets(): i32 {
  return 4093;
}

pub function borrow_reg_new(): string[] {
  var out: string[] = [];
  var i: i32 = 0;
  var n: i32 = borrow_reg_buckets();
  while (i < n) {
    out = out.append("");
    i = i + 1;
  }
  return out;
}

// `own` + self-reassign, not a value-producing `.with`: the bare-param
// receiver has no struct field to key the in-place analysis on, so the
// value form clones all 251 buckets per insert. The move form stores into
// the sole-owned buffer. E051 rejects a borrowed argument here, so every
// caller must already hand the registry over.
function borrow_reg_put(own reg: string[], key: string, flags: string): string[] {
  var b: i32 = util.hash_bucket(key, reg.len());
  reg = reg.with(b, reg[b] + borrow_reg_record(key, flags));
  return reg;
}

// borrow_reg_set replaces the record for `key` — the lookup takes the first
// record of a name in its bucket, so the old one is dropped rather than
// shadowed — and an empty `flags` leaves the key with no record, which the
// lookup reads as nothing borrowable. An empty registry is given its buckets.
// `reg` stays borrowed, as borrow_reg_with_counted's does; the one store is a
// `with`, which copies the bucket array once when the registry is shared.
pub function borrow_reg_set(reg: string[], key: string, flags: string): string[] {
  var out: string[] = reg;
  if (reg.len() == 0) {
    out = borrow_reg_new();
  }
  var b: i32 = util.hash_bucket(key, out.len());
  var bucket: string = out[b];
  var kept: string = "";
  var p: i32 = 0;
  while (p < bucket.len()) {
    var end: i32 = p;
    while (end < bucket.len() && bucket[end] != b'\n') {
      end = end + 1;
    }
    var bar: i32 = p;
    while (bar < end && bucket[bar] != b'|') {
      bar = bar + 1;
    }
    if (slice_unchecked(bucket, p, bar) != key) {
      kept = kept + slice_unchecked(bucket, p, end) + "\n";
    }
    p = end + 1;
  }
  if (flags.len() > 0) {
    kept = kept + borrow_reg_record(key, flags);
  }
  return out.with(b, kept);
}

function borrow_reg_record(key: string, flags: string): string {
  return key + "|" + flags + "\n";
}

// copying_builtin_keys: the registry keys whose position 0 is a string the
// callee COPIES rather than retains — native's copyingBuiltinArgs
// (rc_analysis.go), read off the same runtime bodies: strbuf_append memcpys the
// bytes, print / write / eprint / Writer.write write(2) them, the byte scanners
// return a scalar. A string local passed there keeps its reclaim; without the
// rows every `print(out)` cost `out` its release. The checker rejects a user
// function redeclaring a builtin name, so the free keys can never name one.
// `Writer.write_some` is the same write with the loop taken out, and its
// Result carries a COUNT, so the string it wrote is named by nothing it
// hands back.
// Each method key is seeded only while no user receiver method carries that
// name: the escape walks see no receiver type, so the name alone must settle
// it.
function copying_builtin_keys(funcs: parser.FuncDecl[]): string[] {
  var keys: string[] = ["print", "write", "eprint", "strbuf_append", "buf_push", "buf_push_range", "buf_push_bytes_range", "buf_push_mapped", "buf_push_filtered", "buf_push_expanded", "__memchr", "__rmemchr", "__ascii_run", "__scan_set", "__count_runs", "__bsd_sum", "__count_byte", "__sum_bytes", "__mismatch", "__crc32_cksum", "__scale_f64"];
  var has_write: boolean = false;
  var has_write_some: boolean = false;
  for fn in funcs {
    if (fn.receiver_type.len() > 0 && fn.name == "write") {
      has_write = true;
    }
    if (fn.receiver_type.len() > 0 && fn.name == "write_some") {
      has_write_some = true;
    }
  }
  if (!has_write) {
    keys = keys.append("Writer.write");
  }
  if (!has_write_some) {
    keys = keys.append("Writer.write_some");
  }
  return keys;
}

// copying_builtin_flags: the per-parameter borrowability flag string for one
// copying-builtin key. Most keys copy a single string at position 0;
// __mismatch reads TWO ranges and retains neither, so positions 0 and 2 both
// carry the credit (native's copyingBuiltinArgs["__mismatch"] is {0, 2}), and
// the two buf_push forms take the builder handle at position 0, and
// __crc32_cksum the carried CRC, so the string they copy is at position 1;
// buf_push_mapped, buf_push_filtered and buf_push_expanded read their table at
// position 2 as well.
// A position past the string's end reads as not borrowable, which is what the
// i32 parameters want.
function copying_builtin_flags(key: string): string {
  if (key == "__mismatch") {
    return "10100";
  }
  if (key == "__count_runs") {
    return "101";
  }
  if (key == "buf_push_mapped" || key == "buf_push_filtered" || key == "buf_push_expanded") {
    return "011";
  }
  if (key == "buf_push" || key == "buf_push_range" || key == "buf_push_bytes_range" || key == "__crc32_cksum") {
    return "01";
  }
  return "1";
}

// ── counted-retain array params (#6522, native's inferParamCountedRetain) ────
//
// The arg-temp stash releases a fresh argument only at a BORROWABLE position,
// because a callee that retains its argument must be the one to free it. That
// leaves the shape the conformance row is built from stranded: a constructor
// that STORES the array — `node(name, deps_of(n), mtime)` — is not borrowable
// by construction, so the caller's reference to the temp has nothing to
// release it.
//
// Native's answer is not to widen borrowability but to ask a different
// question per ARGUMENT: is every appearance of the callee's parameter a
// COUNTED store or a non-retaining read? If so, an argument that reaches the
// callee's result got there through a construction that inc'd it. The temp is
// then rc 2 on the escaping path and rc 1 on the non-escaping one, and a single
// post-call dec nets it to exactly one owner either way — which is why this
// admits where the whole-call gate cannot.
//
// Credited (safe) occurrences, mirroring arrayParamCounted:
//   - a bare `p` as a slot value of a struct / tuple / array literal — the
//     construction incs it;
//   - `p.len()`, the pure-read builtin receiver — reads, retains nothing;
//   - `p.append(v)` for a scalar-element array, whose result is a
//     retained alias or a fresh copy (arr_param_counted_ok);
//   - `p` as argument i of a call whose parameter i is itself counted;
//   - `return p` in an "ARROWN:" member, where the return retains it.
// EVERYTHING else disqualifies, including `return p` where the return does
// not retain it, `x = p`, an element read and a non-counted call argument.
// Positive evidence only.
//
// ARRAY parameters only. Native also classifies string and struct params and
// then withdraws a scalar exemption when some pointer param is unproven
// (`ptrAllCounted`); classifying only arrays and leaving every other param
// uncredited is strictly narrower than that, so the exemption never arises and
// a missing credit costs a leak rather than an over-release.
function arrparam_use_ok(e: ast.Expr, pn: string, counted: boolean, reg: string[], pfx: string, structs: irtables.StructTab, sfok: string[]): boolean {
  match (e) {
    ast.ExprIdent(id) => {
      if (id.name == pn) {
        return counted;
      }
      return true;
    },
    ast.ExprArray(a) => {
      // Array construction incs an ARRAY element and a borrowed struct or
      // enum parameter (box_param_ident_escapes); whether it incs a STRING
      // one is not established, so the string tier declines it rather than
      // crediting a store that may never have retained.
      var acnt: boolean = pfx == "ACNT:" || pfx == "PCNT:" || pfx == "ECNT:";
      var i: i32 = 0;
      while (i < a.elements.len()) {
        if (!arrparam_use_ok(a.elements[i], pn, acnt, reg, pfx, structs, sfok)) {
          return false;
        }
        i = i + 1;
      }
      return true;
    },
    ast.ExprTuple(t) => {
      var tcnt: boolean = pfx == "ACNT:";
      for el in t.elements {
        if (!arrparam_use_ok(el, pn, tcnt, reg, pfx, structs, sfok)) {
          return false;
        }
      }
      return true;
    },
    ast.ExprStructLit(sl) => {
      // A functional-update BASE copies field pointers without a counted
      // store, so it is not a credited slot.
      if (sl.has_base && !arrparam_use_ok(sl.base, pn, false, reg, pfx, structs, sfok)) {
        return false;
      }
      // The construction-side string, enum and TUPLE retains are gated on
      // slit_reclaim, so such a slot in a literal whose type does not route
      // field reclaim is stored UNCOUNTED — crediting it would make the
      // caller's post-call free an over-release. Array slots are
      // unconditional and unaffected.
      var scnt: boolean = true;
      if ((pfx == "SCNT:" || pfx == "ECNT:" || pfx == "TCNT:") && !struct_routes_field_reclaim_at(structs, sfok, sl.type_name)) {
        scnt = false;
      }
      // A closure field retains a bare ident only under the type's "clo:"
      // admission (clo_field_ident_counted).
      if (pfx == "FCNT:" && !reclaim_has(sfok, "clo:", sl.type_name)) {
        scnt = false;
      }
      // The STRUCT tier credits ONLY the counted append store below. A
      // bare param in a field slot takes the construction-side retain
      // just for a type that routes field reclaim, and crediting it
      // where that retain does not fire makes the caller's post-call
      // release an over-release — `wrap(p, i) -> Box { a: p, n: i }`
      // at rc underflow, which is what callee_wraps_param pins. Refusing
      // costs the leak that shape already had.
      if (pfx == "PCNT:") {
        scnt = false;
      }
      for fv in sl.field_values {
        if (!arrparam_use_ok(fv, pn, scnt, reg, pfx, structs, sfok)) {
          return false;
        }
      }
      return true;
    },
    ast.ExprCall(c) => {
      var callee_name: string = "";
      match (c.callee) {
        ast.ExprIdent(cid) => {
          callee_name = cid.name;
        },
        ast.ExprFieldAccess(fa) => {
          // `p.len()` — the pure-read builtin receiver — and, at the
          // array tier, `p.append(v)` (arr_param_counted_ok). Any
          // other method may thread the receiver, so it is not
          // credited.
          var recv_counted: boolean = fa.field == "len"
            || pfx == "ACNT:" && fa.field == "append" && c.args.len() == 1;
          if (!arrparam_use_ok(fa.obj, pn, recv_counted, reg, pfx, structs, sfok)) {
            return false;
          }
          // `xs.append(p)` at the STRUCT or ENUM tier is a COUNTED
          // store: every append retains a borrowed struct or enum
          // parameter, so the caller's post-call release nets to the
          // reference the array owns.
          if ((pfx == "PCNT:" || pfx == "ECNT:") && fa.field == "append" && c.args.len() == 1) {
            return arrparam_use_ok(c.args[0], pn, true, reg, pfx, structs, sfok);
          }
        },
        _ => {
          if (!arrparam_use_ok(c.callee, pn, false, reg, pfx, structs, sfok)) {
            return false;
          }
        }
      }
      var ai: i32 = 0;
      while (ai < c.args.len()) {
        var argc: boolean = callee_name.len() > 0 && param_counted_at(reg, pfx, callee_name, ai);
        if (!arrparam_use_ok(c.args[ai], pn, argc, reg, pfx, structs, sfok)) {
          return false;
        }
        ai = ai + 1;
      }
      return true;
    },
    ast.ExprBinary(b) => {
      return arrparam_use_ok(b.left, pn, false, reg, pfx, structs, sfok) && arrparam_use_ok(b.right, pn, false, reg, pfx, structs, sfok);
    },
    ast.ExprUnary(u) => {
      return arrparam_use_ok(u.operand, pn, false, reg, pfx, structs, sfok);
    },
    ast.ExprIndex(ix) => {
      // `p[i]` is credited for a STRING parameter and refused for an array
      // one: a string's byte index yields a u8 VALUE copy that references
      // nothing, while an array element may BE a reference the read hands out
      // uncounted. Native draws the same line (stringParamCounted has the
      // Index arm, arrayParamCounted does not).
      //
      // A SLICE is NOT credited for either, though native credits it for
      // strings on the grounds that `__str_slice` copies. In Fern `p[a:b]`
      // yields a `str` — a borrowed VIEW over the parameter's buffer, which
      // the checker's own E043 says when it refuses to store one in a
      // `string` field without `.to_owned()`. A view keeps the argument
      // reachable after the caller's post-call release, so crediting it
      // corrupts the value rather than leaking one.
      var icnt: boolean = pfx == "SCNT:";
      return arrparam_use_ok(ix.array, pn, icnt, reg, pfx, structs, sfok) && arrparam_use_ok(ix.index, pn, false, reg, pfx, structs, sfok);
    },
    ast.ExprSlice(sl2) => {
      return arrparam_use_ok(sl2.array, pn, false, reg, pfx, structs, sfok) && arrparam_use_ok(sl2.start, pn, false, reg, pfx, structs, sfok) && arrparam_use_ok(sl2.end, pn, false, reg, pfx, structs, sfok);
    },
    ast.ExprFieldAccess(fa2) => {
      return arrparam_use_ok(fa2.obj, pn, false, reg, pfx, structs, sfok);
    },
    ast.ExprLambda(lm) => {
      return arrparam_uses_ok_stmts(lm.body, pn, reg, pfx, structs, sfok, false);
    },
    _ => {
      return true;
    }
  }
  return true;
}

function arrparam_uses_ok_stmts(stmts: ast.Stmt[], pn: string, reg: string[], pfx: string, structs: irtables.StructTab, sfok: string[], ret_hb: boolean): boolean {
  for stmt in stmts {
    if (!arrparam_use_ok_stmt(stmt, pn, reg, pfx, structs, sfok, ret_hb)) {
      return false;
    }
  }
  return true;
}

function arrparam_use_ok_stmt(st: ast.Stmt, pn: string, reg: string[], pfx: string, structs: irtables.StructTab, sfok: string[], ret_hb: boolean): boolean {
  match (st) {
    ast.StmtVar(v) => {
      return arrparam_use_ok(v.init, pn, false, reg, pfx, structs, sfok);
    },
    ast.StmtAssign(a) => {
      return arrparam_use_ok(a.value, pn, false, reg, pfx, structs, sfok);
    },
    ast.StmtReturn(r) => {
      // A bare return of the parameter or of one of its fields is a
      // counted store where the return retains it (`ret_hb`).
      if (ret_hb && handback_param_name(r.value) == pn) {
        return true;
      }
      // A returned array literal stores a struct or enum parameter uncounted
      // (lower_expr_array's `returning`), so it is no counted use there.
      match (r.value) {
        ast.ExprArray(ra) => {
          if (pfx == "PCNT:" || pfx == "ECNT:") {
            for el in ra.elements {
              if (!arrparam_use_ok(el, pn, false, reg, pfx, structs, sfok)) {
                return false;
              }
            }
            return true;
          }
        },
        _ => {}
      }
      return arrparam_use_ok(r.value, pn, false, reg, pfx, structs, sfok);
    },
    ast.StmtExpr(e) => {
      return arrparam_use_ok(e.value, pn, false, reg, pfx, structs, sfok);
    },
    ast.StmtIf(f) => {
      return arrparam_use_ok(f.cond, pn, false, reg, pfx, structs, sfok)
        && arrparam_uses_ok_stmts(f.then_body, pn, reg, pfx, structs, sfok, ret_hb)
        && arrparam_uses_ok_stmts(f.else_body, pn, reg, pfx, structs, sfok, ret_hb);
    },
    ast.StmtWhile(w) => {
      return arrparam_use_ok(w.cond, pn, false, reg, pfx, structs, sfok) && arrparam_uses_ok_stmts(w.body, pn, reg, pfx, structs, sfok, ret_hb);
    },
    ast.StmtFor(fo) => {
      return arrparam_use_ok(fo.iter, pn, false, reg, pfx, structs, sfok) && arrparam_uses_ok_stmts(fo.body, pn, reg, pfx, structs, sfok, ret_hb);
    },
    ast.StmtMatch(m) => {
      if (!arrparam_use_ok(m.scrutinee, pn, false, reg, pfx, structs, sfok)) {
        return false;
      }
      for arm in m.arms {
        if (arm.has_guard && !arrparam_use_ok(arm.guard, pn, false, reg, pfx, structs, sfok)) {
          return false;
        }
        if (!arrparam_uses_ok_stmts(arm.body, pn, reg, pfx, structs, sfok, ret_hb)) {
          return false;
        }
      }
      return true;
    },
    ast.StmtDefer(d) => {
      return arrparam_use_ok_stmt(d.action, pn, reg, pfx, structs, sfok, ret_hb);
    },
    _ => {
      return true;
    }
  }
  return true;
}

// param_counted_at: parameter `ai` of `callee` is counted-retain in tier `pfx`
// ("ACNT:" for array params, "SCNT:" for string ones).
pub function param_counted_at(reg: string[], pfx: string, callee: string, ai: i32): boolean {
  var i: i32 = 0;
  while (i < reg.len()) {
    var st: i32 = tagged_value_start(reg[i], pfx, callee);
    if (st >= 0 && st < reg[i].len()) {
      if (st + ai < reg[i].len()) {
        return reg[i][st + ai] == b'1';
      }
      return false;
    }
    i = i + 1;
  }
  return false;
}

// borrow_reg_with_counted folds param_counted_of's verdict into the borrowability
// registry under a "CNT:" key prefix. The verdict was reachable only from the
// argument-temp stash, which holds the sigs; the ESCAPE walker threads the borrow
// registry and nothing else, so a NAMED local passed at a counted position read as
// an escape and lost its scope-exit release entirely — the callee's store retained
// and its drop gave the retain back, and no one ever released the caller's own
// claim, a constant 2-object leak. This closes the `string`, `string[]`, `enum`
// and enum-ARRAY construction-retain `__param` cells. The struct-array one is
// still uncounted: admission is BY TYPE, and its tier is its own slice.
//
// All tiers merge into one flag string: at a call argument the question is
// whether THIS position is counted, not which type tier proved it. What the
// caller then RELEASES is decided by its own local's type — the deep tier needs
// a distinct key only so param_counted_of's consumers can tell a plain-dec
// credit from an element-walk one, not so this merge can. Keys are
// distinct from the bare names by the prefix, so every existing lookup is inert.
function borrow_reg_with_counted(reg: string[], pcnt: string[]): string[] {
  var keys: string[] = [];
  var flags: string[] = [];
  var i: i32 = 0;
  while (i < pcnt.len()) {
    var row: string = pcnt[i];
    var bar: i32 = 0;
    while (bar < row.len() && row[bar] != b'|') {
      bar = bar + 1;
    }
    // Every tier key is five bytes ("ACNT:" / "SCNT:" / "ECNT:" / "DCNT:" /
    // "TCNT:" / "PCNT:" / "FCNT:") — the slice below hard-codes that width;
    // a row with no key or no '|' is not one param_counted_of wrote.
    if (bar < row.len() && bar > 5) {
      var key: string = "CNT:" + slice_unchecked(row, 5, bar);
      var fl: string = slice_unchecked(row, bar + 1, row.len()) + "";
      var at: i32 = util.index_of_str(keys, key);
      if (at < 0) {
        keys = keys.append(key);
        flags = flags.append(fl);
      } else {
        flags = flags.with(at, merge_counted_flags(flags[at], fl));
      }
    }
    i = i + 1;
  }
  // `reg` stays BORROWED: fn_sigs_for_borrow reads `bparams` again after
  // handing it here, so ownership cannot be transferred. Copy it once up
  // front and own-thread that copy — one copy, not keys.len() of them.
  var out: string[] = [];
  var c: i32 = 0;
  while (c < reg.len()) {
    out = out.append(reg[c]);
    c = c + 1;
  }
  var k: i32 = 0;
  while (k < keys.len()) {
    out = borrow_reg_put(out, keys[k], flags[k]);
    k = k + 1;
  }
  return out;
}

// merge_counted_flags: '1' at a position either tier credits.
function merge_counted_flags(a: string, b: string): string {
  var n: i32 = a.len();
  if (b.len() > n) {
    n = b.len();
  }
  var out: string = "";
  var i: i32 = 0;
  while (i < n) {
    if (i < a.len() && a[i] == b'1' || i < b.len() && b[i] == b'1') {
      out = out + "1";
    } else {
      out = out + "0";
    }
    i = i + 1;
  }
  return out;
}

// param_counted_of: the least fixpoint, over both tiers at once — the walk is
// name-keyed and type-blind, so classifying array and string params in one pass
// costs one traversal instead of two. Starts all-false and only ever
// ADDS credits — a use is credited on positive local evidence or on a callee
// already proven counted — so the iteration is monotone and settles on the
// grounded fixpoint. A mutual-recursion cycle with no grounding stays
// uncredited, which is the conservative direction.
// str_result_cannot_alias: `ret` cannot BE a `string` argument. Native's
// resultCannotAliasArg, and the reason the string tier does not copy the array
// one's CONCRETE SCALAR guard: a struct or enum result CONTAINS the argument,
// which is exactly the shape this tier exists for — the callee's counted store
// and the caller's post-call dec net to the one reference the result owns. The
// shape that is unsafe is a result of the parameter's OWN type, which the use
// vocabulary credits (`both(t, k) { var n = Q { tag: t, k: k }; return n.tag; }`
// reads the field off a LOCAL, so `t` itself never appears in a refused
// position) and only a result-type test can refuse. An unresolved name — a bare
// type var — refuses with everything else it is not.
function str_result_cannot_alias(ret: string, structs: irtables.StructTab): boolean {
  if (ret == "string" || ret == "str") {
    return false;
  }
  return irtables.is_scalar_type_name(ret) || irtables.decl_is_struct(structs, ret) || irtables.decl_is_enum(structs, ret);
}

// struct_result_cannot_alias: the STRUCT tier's sibling of the two above. A
// result of the parameter's OWN type could hand the argument straight back,
// which one post-call release would dangle; a result that CONTAINS it is what
// the tier exists for.
function struct_result_cannot_alias(ret: string, pty: string, structs: irtables.StructTab): boolean {
  if (ret == pty) {
    return false;
  }
  return irtables.is_scalar_type_name(ret) || irtables.decl_is_struct(structs, ret) || irtables.decl_is_enum(structs, ret);
}

// enum_result_cannot_alias: the ENUM tier's sibling of str_result_cannot_alias.
// The counted claim is that ONE post-call release nets the argument to the
// owner the callee's construction retained, so a result that could BE the
// argument breaks it. For an enum param that is any enum result — the tier is
// name-keyed and type-blind, so it cannot tell E from some other enum, and the
// conservative reading costs a leak rather than an over-release.
function enum_result_cannot_alias(ret: string, structs: irtables.StructTab): boolean {
  if (irtables.decl_is_enum(structs, ret)) {
    return false;
  }
  return irtables.is_scalar_type_name(ret) || irtables.decl_is_struct(structs, ret);
}

pub function param_counted_of(funcs: parser.FuncDecl[], structs: irtables.StructTab, sfok: string[], enum_members: string[], arr_members: string[]): string[] {
  var reg: string[] = [];
  var n: i32 = funcs.len();
  var deps: CallDeps = call_deps_of(funcs, false, false);
  var dirty: i32[] = i32_filled(n, 1);
  // Entries per function in `reg`: they are appended in funcs order every
  // round, so a function's previous entries are the next `nent[fi]` at a
  // cursor, which is what a skipped function carries over and what an
  // examined one is compared against.
  var nent: i32[] = i32_filled(n, 0);
  var round: i32 = 0;
  while (round < 16 && any_i32_set(dirty)) {
    var next: string[] = [];
    var changed: i32[] = i32_filled(n, 0);
    var ri: i32 = 0;
    var fi: i32 = 0;
    while (fi < n) {
      var cnt: i32 = nent[fi];
      if (dirty[fi] == 1) {
        var ents: string[] = param_counted_entries_of(funcs[fi], reg, structs, sfok, enum_members, arr_members);
        var same: boolean = ents.len() == cnt;
        var k: i32 = 0;
        while (same && k < cnt) {
          if (ents[k] != reg[ri + k]) {
            same = false;
          }
          k = k + 1;
        }
        if (!same) {
          changed = changed.with(fi, 1);
        }
        k = 0;
        while (k < ents.len()) {
          next = next.append(ents[k]);
          k = k + 1;
        }
        nent = nent.with(fi, ents.len());
      } else {
        var c: i32 = 0;
        while (c < cnt) {
          next = next.append(reg[ri + c]);
          c = c + 1;
        }
      }
      ri = ri + cnt;
      fi = fi + 1;
    }
    reg = next;
    round = round + 1;
    dirty = worklist_next(deps, changed);
  }
  return reg;
}

// arr_param_counted_ok: the ARRAY tier's verdict for parameter `p`.
// `result_ok` says the result cannot hand the argument back uncounted. An
// "ARROWN:" member (`arr_hb`) may return a scalar-element `p` bare, which the
// return retains. An append on `p` leaves its result a retained alias or a
// copy of the elements, which holds pointer elements uncounted, so a
// `string[]` may not be an append receiver.
function arr_param_counted_ok(fn: parser.FuncDecl, p: ast.ParamDecl, result_ok: boolean, arr_hb: boolean, reg: string[], structs: irtables.StructTab, sfok: string[]): boolean {
  var t: string = p.type_name;
  var scalar: boolean = irtables.is_leaksafe_array_field(t);
  if (p.own || !scalar && t != "string[]") {
    return false;
  }
  var hb: boolean = arr_hb && scalar;
  if (!result_ok && !hb) {
    return false;
  }
  if (!scalar && fn_appends_to(fn, p.name)) {
    return false;
  }
  return arrparam_uses_ok_stmts(fn.body, p.name, reg, "ACNT:", structs, sfok, hb);
}

// fn_appends_to: some `name.append(v)` or `name.set(i, v)` in `fn`'s body.
function fn_appends_to(fn: parser.FuncDecl, name: string): boolean {
  var recvs: string[] = [];
  for st in fn.body {
    recvs = collect_append_recvs_stmt(st, recvs);
  }
  return util.index_of_str(recvs, name) >= 0;
}

// param_counted_entries_of: one function's tier entries under the registry
// `reg`, in the fixed tier order the list is built in.
function param_counted_entries_of(fn: parser.FuncDecl, reg: string[], structs: irtables.StructTab, sfok: string[], enum_members: string[], arr_members: string[]): string[] {
  var ents: string[] = [];
  // ARRAY tier. The result must not BE the argument: the release
  // fires immediately after the call, so a callee handing `d` straight
  // back out would leave the caller reading freed memory. A CONCRETE
  // SCALAR result settles that outright; so does a struct result whose
  // drop ROUTES field reclaim, which is the shape this tier exists for
  // — the callee's counted store and the caller's post-call dec net to
  // the one reference the returned struct owns. (The string tier's
  // str_result_cannot_alias reads it the same way, minus the routing
  // requirement.) An array RESULT is admitted only for an "ARROWN:"
  // member (`arr_hb`): every return hands back a count of its own, so a
  // bare `return p` is the retained handback and the caller's dec leaves
  // the result its one reference.
  //
  // Candidacy spans SCALAR-element arrays and `string[]`. For a
  // pointer-element array the caller's release is a shallow arr_dec,
  // not the deep element free — the returned struct retains the array
  // and deep-frees it on its own drop — so the credited use vocabulary
  // is the same either way: a bare `p` in a struct literal is a
  // counted slot, and the construction-side retain for an ARRAY field
  // is not gated on slit_reclaim the way the string one is.
  var scalar_result: boolean = owned_scalar_field_type(fn.ret_type);
  var arr_hb: boolean = fn.receiver_type.len() == 0 && util.index_of_str(arr_members, fn.name) >= 0;
  var aflags: string = "";
  var aany: boolean = false;
  var sflags: string = "";
  var sany: boolean = false;
  var str_ok_result: boolean = str_result_cannot_alias(fn.ret_type, structs);
  // An "ENUM:" member's every return carries a count of its own, a retained
  // parameter or parameter field included (ret_enum_param_handback), so a
  // result that IS the argument still leaves the caller exactly one release.
  var ret_hb: boolean = fn.receiver_type.len() == 0 && util.index_of_str(enum_members, fn.name) >= 0;
  var enum_ok_result: boolean = ret_hb || enum_result_cannot_alias(fn.ret_type, structs);
  var eflags: string = "";
  var eany: boolean = false;
  var eaflags: string = "";
  var eaany: boolean = false;
  var tflags: string = "";
  var tany: boolean = false;
  var pflags: string = "";
  var pany: boolean = false;
  var fflags: string = "";
  var fany: boolean = false;
  var ret_routes: boolean = struct_routes_field_reclaim_at(structs, sfok, fn.ret_type);
  var pj: i32 = 0;
  while (pj < fn.params.len()) {
    var aok: boolean = arr_param_counted_ok(fn, fn.params[pj], scalar_result || ret_routes, arr_hb, reg, structs, sfok);
    if (aok) {
      aflags = aflags + "1";
      aany = true;
    } else {
      aflags = aflags + "0";
    }
    var sok: boolean = false;
    if (str_ok_result
      && fn.params[pj].type_name == "string"
      && !fn.params[pj].own
      && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "SCNT:", structs, sfok, false)) {
      sok = true;
    }
    if (sok) {
      sflags = sflags + "1";
      sany = true;
    } else {
      sflags = sflags + "0";
    }
    // ENUM tier. Same shape as the string one: the construction
    // retains the payload box and the holder's field drop decs it,
    // so the caller keeps the claim its own creation owes. Gated on
    // the holder ROUTING field reclaim for the same reason the
    // string slot is — a literal whose type carries no arm of the
    // right type never gives the retain back.
    var eok: boolean = false;
    if (enum_ok_result
      && irtables.decl_is_enum(structs, fn.params[pj].type_name)
      && !fn.params[pj].own
      && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "ECNT:", structs, sfok, ret_hb)) {
      eok = true;
    }
    if (eok) {
      eflags = eflags + "1";
      eany = true;
    } else {
      eflags = eflags + "0";
    }
    // ARRAY-OF-BOXES tier, the DEEP class. Its own key rather than
    // a widening of "ACNT:": that tier's credit routes a plain
    // arr_dec, and an array of BOXES owes an element walk, so its
    // consumers must be able to tell the two apart.
    //
    // ENUM and STRUCT element arrays share the key. What the caller
    // RELEASES is decided by its own local's type — emit_arrenum_
    // deep_free or emit_arrstruct_deep_free — not by which type
    // proved the store counted, so one tier answers both and the
    // escape walkers differ only in which one they consult.
    //
    // Admission needs the element walk to EXIST, asked with the same
    // predicate the release side asks: enum_arr_elems_walk_ok for the
    // enum arm (what the backends check before emitting
    // __enum_arr_elems_drop_<E>), and struct_has_reclaim_array_field
    // for the struct one (what slot_is_reclaimable_arrstruct checks
    // before routing emit_arrstruct_deep_free). Without it the credit
    // would route a walk nothing emits, which is the leak it is
    // trying to close rather than a fix.
    //
    // Both releases are rc-gated (the holder's walk and the source's
    // deep free each is_unique-gate the buffer), so the callee's
    // counted store and the caller's own claim net to one owner: with
    // rc 2 the first sweep decs and the second walks. The element
    // handout the "ELB:" tier had to ask about is already refused
    // here — arrparam_use_ok credits `p[i]` only for "SCNT:", so an
    // element read disqualifies the param outright.
    var pty: string = fn.params[pj].type_name;
    var elem_walk_ok: boolean = false;
    if (irtables.is_enum_array_field_type(structs, pty)) {
      elem_walk_ok = irtables.enum_arr_elems_walk_ok(structs, slice_unchecked(pty, 0, pty.len() - 2));
    } else if (irtables.is_struct_array_field_type(structs, pty)) {
      elem_walk_ok = struct_has_reclaim_array_field(structs, slice_unchecked(pty, 0, pty.len() - 2));
    }
    // TUPLE tier. `keepit(t) { return Hold { t: t, n: 1 } }`: the
    // callee stores a borrowed tuple param into a struct literal,
    // which since the counted-store trio RETAINS it, so the caller's
    // own deep free and the holder's field drop net to one owner —
    // rc 2, the struct loop's box-only dec, then the rc-tuple loop's
    // walk. Gated on the result routing field reclaim for the same
    // reason the string and enum tiers are: a holder whose drop
    // carries no arm of the right type never gives the retain back.
    //
    // The element handout that sinks the "TUPB:" payload tier is
    // already refused here — arrparam_use_ok credits `p[i]` only for
    // "SCNT:", and a `p.<i>` field read is not in its credited
    // vocabulary at all, so a callee that extracts an element never
    // reaches this flag.
    var tok: boolean = false;
    if (ret_routes
      && tuple_field_deep_droppable(fn.params[pj].type_name, structs)
      && !fn.params[pj].own
      && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "TCNT:", structs, sfok, false)) {
      tok = true;
    }
    if (tok) {
      tflags = tflags + "1";
      tany = true;
    } else {
      tflags = tflags + "0";
    }
    var eaok: boolean = false;
    if (scalar_result
      && elem_walk_ok
      && !fn.params[pj].own
      && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "DCNT:", structs, sfok, false)) {
      eaok = true;
    }
    if (eaok) {
      eaflags = eaflags + "1";
      eaany = true;
    } else {
      eaflags = eaflags + "0";
    }
    // STRUCT tier. The callee stores a borrowed struct param into a
    // container, which the clone-append now RETAINS, so the caller's
    // post-call release and that retain net to the one reference the
    // result owns (#7853).
    var pok: boolean = false;
    if (struct_result_cannot_alias(fn.ret_type, fn.params[pj].type_name, structs)
      && irtables.decl_is_struct(structs, fn.params[pj].type_name)
      && !fn.params[pj].own
      && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "PCNT:", structs, sfok, ret_hb)) {
      pok = true;
    }
    if (pok) {
      pflags = pflags + "1";
      pany = true;
    } else {
      pflags = pflags + "0";
    }
    // CLOSURE tier. `keepit(f) { return Box { f: f } }` stores a borrowed
    // closure into an admitted closure field, which retains it, so the
    // caller's own release and the holder's field drop net to one owner.
    // The result must not be the closure itself.
    var fok: boolean = false;
    if ((scalar_result || ret_routes)
      && fn.params[pj].type_name == "fn"
      && !fn.params[pj].own
      && arrparam_uses_ok_stmts(fn.body, fn.params[pj].name, reg, "FCNT:", structs, sfok, false)) {
      fok = true;
    }
    if (fok) {
      fflags = fflags + "1";
      fany = true;
    } else {
      fflags = fflags + "0";
    }
    pj = pj + 1;
  }
  if (aany) {
    var aent: string = "ACNT:" + borrowable_key(fn) + "|" + aflags;
    ents = ents.append(aent);
  }
  if (eany) {
    var eent: string = "ECNT:" + borrowable_key(fn) + "|" + eflags;
    ents = ents.append(eent);
  }
  if (eaany) {
    var eaent: string = "DCNT:" + borrowable_key(fn) + "|" + eaflags;
    ents = ents.append(eaent);
  }
  if (sany) {
    var sent: string = "SCNT:" + borrowable_key(fn) + "|" + sflags;
    ents = ents.append(sent);
  }
  if (tany) {
    var tent: string = "TCNT:" + borrowable_key(fn) + "|" + tflags;
    ents = ents.append(tent);
  }
  if (pany) {
    var pent: string = "PCNT:" + borrowable_key(fn) + "|" + pflags;
    ents = ents.append(pent);
  }
  if (fany) {
    ents = ents.append("FCNT:" + borrowable_key(fn) + "|" + fflags);
  }
  return ents;
}

// tuple_payload_borrow_flags: the "TUPB:" tier for one function — per-param
// flag '1' iff the box flag is '1', the param is tuple-typed, and the rc-tuple
// payload walker proves no PAYLOAD of the param escapes the callee's body.
// The box flag proves the callee never keeps the BOX and licenses box-only
// releases; a TUPRCS deep free (every rc position, then the box) must ask this
// stronger question — a callee returning src.1 keys box-borrowable while its
// caller's deep free would dangle the handed-out element (native's
// taintedReachesSlot draws the same payload line). Registry-independent (empty
// borrowable inside — an onward pass of the param is an escape) and
// structs-blind (a struct-element field read is a conservative escape), so
// the interproc fixpoint cannot oscillate and both builders share it.
function tuple_payload_borrow_flags(fn: parser.FuncDecl, boxflags: string): string {
  var no_structs: irtables.StructTab = irtables.struct_tab_empty();
  var no_strs: string[] = [];
  var tupb: string = "";
  var any1: boolean = false;
  var pj: i32 = 0;
  while (pj < fn.params.len()) {
    var pty: string = fn.params[pj].type_name;
    if (pj < boxflags.len() && boxflags[pj] == b'1'
      && util.is_tuple_type_name(pty) && !util.contains(pty, "=>")) {
      var tal: string[] = rctuple_param_alias_bind_sites(fn.body, fn.params[pj].name, pty, no_structs, fn.body, no_strs);
      if (!rctuple_payload_escapes_alias(fn.body, fn.params[pj].name, pty, no_structs, no_strs, tal, [], true)) {
        tupb = tupb + "1";
        any1 = true;
      } else {
        tupb = tupb + "0";
      }
    } else {
      tupb = tupb + "0";
    }
    pj = pj + 1;
  }
  if (!any1) {
    return "";
  }
  return tupb;
}

// rctuple_param_alias_bind_sites: alias binds of a tuple PARAM whose payloads
// provably stay confined — the "TUPB:" flavor of param_alias_bind_sites. The
// vet is the rc-tuple payload scan on the ALIAS's own name, never the plain
// box walker: box-level vetting would admit `var x = src; return x.1;`, whose
// caller's TUPRCS deep free walks every rc position and frees the handed-out
// element (the sanitizer-confirmed UAF that retired v1 of the tier). Scanning
// the alias over the whole body with empty alias_ok also keeps a chained
// alias (`var y = x`) and a reassigned alias refused. Empty registries only,
// so the flag stays registry-independent for the interproc fixpoint.
function rctuple_param_alias_bind_sites(stmts: ast.Stmt[], src: string, pty: string, structs: irtables.StructTab, body: ast.Stmt[], acc: string[]): string[] {
  var no_strs: string[] = [];
  var a: string[] = acc;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if let ast.ExprIdent(aid) = v.init {
          if (aid.name == src
            && !rctuple_payload_escapes_alias(body, v.name, pty, structs, no_strs, no_strs, [], false)) {
            a = push_str_unique(a, irtables.reclaim_site_key_of(v.name, v.line, v.col));
          }
        }
      },
      ast.StmtIf(f) => {
        a = rctuple_param_alias_bind_sites(f.then_body, src, pty, structs, body, a);
        a = rctuple_param_alias_bind_sites(f.else_body, src, pty, structs, body, a);
      },
      ast.StmtWhile(w) => {
        a = rctuple_param_alias_bind_sites(w.body, src, pty, structs, body, a);
      },
      ast.StmtFor(fo) => {
        a = rctuple_param_alias_bind_sites(fo.body, src, pty, structs, body, a);
      },
      ast.StmtMatch(m) => {
        var ai: i32 = 0;
        while (ai < m.arms.len()) {
          a = rctuple_param_alias_bind_sites(m.arms[ai].body, src, pty, structs, body, a);
          ai = ai + 1;
        }
      },
      ast.StmtDefer(d) => {
        if let ast.StmtWhile(dw) = d.action {
          a = rctuple_param_alias_bind_sites(dw.body, src, pty, structs, body, a);
        }
      },
      _ => {}
    }
  }
  return a;
}

// arrenum_elem_borrow_flags: the "ELB:" tier for one function — per-param flag
// '1' iff the box flag is '1', the param is an ARRAY, and no ELEMENT of it
// escapes the callee's body. Element TYPE is not asked, so the one tier answers
// for every array-of-boxes class; arrenum and arrstruct both read it.
//
// The box flag licenses a box-only release: it proves the callee never keeps the
// param. An array-of-boxes local's release is not box-only — it WALKS every
// element box and frees it — so passing such a local to a call needs this
// stronger proof before the caller may keep its walk. Exactly the distinction
// "TUPB:" draws for rc-tuples, and for exactly the same reason.
//
// The element rule is the class's own: `arrenum_escapes` with an EMPTY registry,
// so the only admitted use is `xs.len()` and an onward pass of the param counts
// as an escape. Registry-independent by construction, like
// tuple_payload_borrow_flags, so the interproc fixpoint cannot oscillate.
function arrenum_elem_borrow_flags(fn: parser.FuncDecl, boxflags: string): string {
  var elb: string = "";
  var any1: boolean = false;
  var pj: i32 = 0;
  while (pj < fn.params.len()) {
    var pty: string = fn.params[pj].type_name;
    if (pj < boxflags.len() && boxflags[pj] == b'1'
      && pty.len() >= 3 && slice_unchecked(pty, pty.len() - 2, pty.len()) == "[]"
      && !arrenum_param_escapes(fn.body, fn.params[pj].name, fn.body)) {
      elb = elb + "1";
      any1 = true;
    } else {
      elb = elb + "0";
    }
    pj = pj + 1;
  }
  if (!any1) {
    return "";
  }
  return elb;
}

// borrowable_key is the registry key for a function's borrowability entry: the
// bare name for a free function, "<Type>.<method>" for a receiver method.
function borrowable_key(fn: parser.FuncDecl): string {
  if (fn.receiver_type.len() > 0) {
    return util.base_type_name(fn.receiver_type) + "." + fn.name;
  }
  return fn.name;
}

// borrowable_params_interproc is the inter-procedural widening of
// borrowable_params_of: an ITERATED greatest fixpoint from above, re-running the
// escape walker over every function until the registry stops changing (cap 64;
// real call graphs converge in a handful of passes). The algorithm is described
// in full inside the body — it replaced a single forward pass with a growing
// registry, which could not bootstrap a mutually recursive borrow.
//
// COST: the growing registry makes the escape walker short-circuit less, so this
// is materially heavier than the empty-registry conservative pass — recomputing it
// once per lowered function OOMs the arm64 self-compile (measured). It is therefore
// used ONLY on the emit path, computed ONCE per module before the per-function emit
// loop and threaded through `emit_function_via_ir` / `emit_function_ir`. The
// remaining callers of the cheap conservative `borrowable_params_of` (`fn_sigs_of`
// and the `reuse_sources_of` / `reuse_consumed_of` / `rc_plan_dump` views) only
// inspect op shapes, and the only op a precise drop adds (__fern_arr_dec) is
// already emitted by the function-exit dec-sweep, so no inspection result can flip.
// param_local_decl_site: the `var` binding-site key for local `name` in `stmts`,
// or "". Needed because an ASSIGNMENT carries only the target's name, while the
// alias_ok forgiveness is keyed on binding sites.
function param_local_decl_site(stmts: ast.Stmt[], name: string): string {
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          return irtables.reclaim_site_key_of(v.name, v.line, v.col);
        }
      },
      ast.StmtIf(f) => {
        var t1: string = param_local_decl_site(f.then_body, name);
        if (t1.len() > 0) {
          return t1;
        }
        var e1: string = param_local_decl_site(f.else_body, name);
        if (e1.len() > 0) {
          return e1;
        }
      },
      ast.StmtWhile(w) => {
        var t2: string = param_local_decl_site(w.body, name);
        if (t2.len() > 0) {
          return t2;
        }
      },
      ast.StmtFor(fo) => {
        var t3: string = param_local_decl_site(fo.body, name);
        if (t3.len() > 0) {
          return t3;
        }
      },
      ast.StmtMatch(m) => {
        var ai: i32 = 0;
        while (ai < m.arms.len()) {
          var t4: string = param_local_decl_site(m.arms[ai].body, name);
          if (t4.len() > 0) {
            return t4;
          }
          ai = ai + 1;
        }
      },
      _ => {}
    }
  }
  return "";
}

// param_alias_reassign_sites: the sites of locals REASSIGNED from a bare `src`
// (`t = src`). The assign sibling of param_alias_bind_sites, and the reason the
// param verdict needs both: `var q = p; q = o;` escapes `p` through the bind and
// `o` through the assignment, and forgiving only one leaves the other's caller
// still refusing its release (measured 80/40 with the bind arm alone).
//
// The local must be safe in its own right under the current registry, which is
// what still refuses `q = o; return q;`.
function param_alias_reassign_sites(stmts: ast.Stmt[], src: string, borrowable: string[], recv_borrow: string[], body: ast.Stmt[], acc: string[]): string[] {
  var a: string[] = acc;
  for stmt in stmts {
    match (stmt) {
      ast.StmtAssign(asg) => {
        if let ast.ExprIdent(rid) = asg.value {
          if (rid.name == src && asg.target != src
            && !body_unsafe_for(body, asg.target, borrowable, recv_borrow)) {
            var site: string = param_local_decl_site(body, asg.target);
            if (site.len() > 0) {
              a = push_str_unique(a, site);
            }
          }
        }
      },
      ast.StmtIf(f) => {
        a = param_alias_reassign_sites(f.then_body, src, borrowable, recv_borrow, body, a);
        a = param_alias_reassign_sites(f.else_body, src, borrowable, recv_borrow, body, a);
      },
      ast.StmtWhile(w) => {
        a = param_alias_reassign_sites(w.body, src, borrowable, recv_borrow, body, a);
      },
      ast.StmtFor(fo) => {
        a = param_alias_reassign_sites(fo.body, src, borrowable, recv_borrow, body, a);
      },
      ast.StmtMatch(m) => {
        var ai: i32 = 0;
        while (ai < m.arms.len()) {
          a = param_alias_reassign_sites(m.arms[ai].body, src, borrowable, recv_borrow, body, a);
          ai = ai + 1;
        }
      },
      ast.StmtDefer(d) => {
        if let ast.StmtWhile(dw) = d.action {
          a = param_alias_reassign_sites(dw.body, src, borrowable, recv_borrow, body, a);
        }
      },
      _ => {}
    }
  }
  return a;
}

// param_alias_bind_sites: the binding sites of locals bound from a bare `name`,
// for the PARAM borrowability question only. This is alias_bind_sites_of WITHOUT
// its reassigned-target exclusion, and the difference is deliberate.
//
// That exclusion protects a LOCAL's reclaim credit: a slot later reassigned holds
// something else by the time it is swept, so crediting it off the alias would
// release the wrong box. The question here is narrower and different — does the
// PARAM escape? — and `var q = p; q = o;` answers it plainly: q briefly aliases p,
// then stops naming it. p is not referenced afterwards, so p does not escape.
//
// The local still has to be safe in its own right (body_unsafe_for under the
// current registry), which is what refuses `var q = p; return q;`.
function param_alias_bind_sites(stmts: ast.Stmt[], src: string, borrowable: string[], recv_borrow: string[], body: ast.Stmt[], acc: string[]): string[] {
  var a: string[] = acc;
  for stmt in stmts {
    match (stmt) {
      ast.StmtVar(v) => {
        if let ast.ExprIdent(aid) = v.init {
          if (aid.name == src && !body_unsafe_for(body, v.name, borrowable, recv_borrow)) {
            a = push_str_unique(a, irtables.reclaim_site_key_of(v.name, v.line, v.col));
          }
        }
      },
      ast.StmtIf(f) => {
        a = param_alias_bind_sites(f.then_body, src, borrowable, recv_borrow, body, a);
        a = param_alias_bind_sites(f.else_body, src, borrowable, recv_borrow, body, a);
      },
      ast.StmtWhile(w) => {
        a = param_alias_bind_sites(w.body, src, borrowable, recv_borrow, body, a);
      },
      ast.StmtFor(fo) => {
        a = param_alias_bind_sites(fo.body, src, borrowable, recv_borrow, body, a);
      },
      ast.StmtMatch(m) => {
        var ai: i32 = 0;
        while (ai < m.arms.len()) {
          a = param_alias_bind_sites(m.arms[ai].body, src, borrowable, recv_borrow, body, a);
          ai = ai + 1;
        }
      },
      ast.StmtDefer(d) => {
        if let ast.StmtWhile(dw) = d.action {
          a = param_alias_bind_sites(dw.body, src, borrowable, recv_borrow, body, a);
        }
      },
      _ => {}
    }
  }
  return a;
}

// ── interprocedural worklist ─────────────────────────────────────────────────
//
// The two registry fixpoints — param_counted_of and borrowable_params_interproc
// — examine every function in round 1 and thereafter only a function some
// dependency of which changed its entry in the previous round; the rest carry
// their entries over. The walkers read the registry at two kinds of key: a
// direct callee's ident (param_is_borrowable, param_counted_at) and the
// ".<method>" suffix of a method call, so a function's dependencies are its direct
// callees and, where the fixpoint reads method entries, every function whose
// key ends in a called method's name. Collected over astwalk's fold spine so
// lambda bodies and defer actions are covered: the set is a SUPERSET of what
// any one walk reads, and a walk none of whose consulted entries changed
// reproduces its verdict, which is what makes skipping it exact.

// CallDeps: function `fi` depends on the functions at
// deps[starts[fi] .. starts[fi + 1]).
struct CallDeps {
  starts: i32[],
  deps: i32[],
}

function i32_filled(n: i32, v: i32): i32[] {
  var out: i32[] = [];
  var i: i32 = 0;
  while (i < n) {
    out = out.append(v);
    i = i + 1;
  }
  return out;
}

function any_i32_set(xs: i32[]): boolean {
  var i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == 1) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// call_names_of_body: every direct callee ident and, spelled ".<method>",
// every method name called anywhere in `stmts`, with duplicates.
function call_names_of_body(stmts: ast.Stmt[]): string[] {
  var out: string[] = [];
  for st in stmts {
    out = astwalk.fold_stmt(st, out, call_name_of);
  }
  return out;
}

function call_name_of(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(cid) = c.callee {
      return acc.append(cid.name);
    }
    if let ast.ExprFieldAccess(fa) = c.callee {
      return acc.append("." + fa.field);
    }
  }
  return acc;
}

// call_deps_of builds the dependency table. `with_methods` adds, for each
// method call, every function whose key ends in "." + the method name — the
// records a method-name lookup matches; `with_self` adds the function
// itself, for a fixpoint that reads its own entry.
//
// The callee-name lookup is an integer chained hash table, private to this
// function, NOT one of the record-text registries: a registry put rewrites its
// whole bucket array per entry, which costs more than the body walks it feeds.
// `ekeys[e]` is function `e`'s key for e < n and function `e - n`'s ".<method>"
// key above it, "" where there is none. `head[b]` starts the chain of plain keys
// in bucket b and `mhead[b]` the chain of method keys — separate heads so a
// method call can only ever find a method key, as two registries gave — with
// `next[e]` continuing both, in ascending function order (entries are inserted
// in reverse) and -1 for the end.
function call_deps_of(funcs: parser.FuncDecl[], with_methods: boolean, with_self: boolean): CallDeps {
  var n: i32 = funcs.len();
  var nb: i32 = irtables.sig_bucket_count(n);
  var ekeys: string[] = [];
  var fi: i32 = 0;
  while (fi < n) {
    ekeys = ekeys.append(borrowable_key(funcs[fi]));
    fi = fi + 1;
  }
  if (with_methods) {
    fi = 0;
    while (fi < n) {
      var key: string = ekeys[fi];
      var dot: i32 = key.len();
      while (dot > 0 && key[dot - 1] != b'.') {
        dot = dot - 1;
      }
      if (dot > 0) {
        ekeys = ekeys.append("." + slice_unchecked(key, dot, key.len()));
      } else {
        ekeys = ekeys.append("");
      }
      fi = fi + 1;
    }
  }
  var head: i32[] = i32_filled(nb, -1);
  var mhead: i32[] = i32_filled(nb, -1);
  var next: i32[] = i32_filled(ekeys.len(), -1);
  var e: i32 = ekeys.len() - 1;
  while (e >= 0) {
    if (ekeys[e].len() > 0) {
      var eb: i32 = util.hash_bucket(ekeys[e], nb);
      if (e < n) {
        next = next.with(e, head[eb]);
        head = head.with(eb, e);
      } else {
        next = next.with(e, mhead[eb]);
        mhead = mhead.with(eb, e);
      }
    }
    e = e - 1;
  }
  var starts: i32[] = [];
  var deps: i32[] = [];
  // stamp[d] == fi + 1 marks `d` as already listed for `fi`.
  var stamp: i32[] = i32_filled(n, 0);
  fi = 0;
  while (fi < n) {
    starts = starts.append(deps.len());
    if (with_self) {
      stamp = stamp.with(fi, fi + 1);
      deps = deps.append(fi);
    }
    var names: string[] = call_names_of_body(funcs[fi].body);
    var ni: i32 = 0;
    while (ni < names.len()) {
      var nm: string = names[ni];
      var c: i32 = -1;
      if (nm.len() > 0 && nm[0] == b'.') {
        if (with_methods) {
          c = mhead[util.hash_bucket(nm, nb)];
        }
      } else {
        c = head[util.hash_bucket(nm, nb)];
      }
      while (c >= 0) {
        if (ekeys[c] == nm) {
          var d: i32 = c;
          if (d >= n) {
            d = d - n;
          }
          if (stamp[d] != fi + 1) {
            stamp = stamp.with(d, fi + 1);
            deps = deps.append(d);
          }
        }
        c = next[c];
      }
      ni = ni + 1;
    }
    fi = fi + 1;
  }
  starts = starts.append(deps.len());
  return CallDeps { starts: starts, deps: deps };
}

// worklist_next: the functions to examine next round — those with a
// dependency whose entry changed this round.
function worklist_next(deps: CallDeps, changed: i32[]): i32[] {
  var n: i32 = changed.len();
  var out: i32[] = i32_filled(n, 0);
  var fi: i32 = 0;
  while (fi < n) {
    var k: i32 = deps.starts[fi];
    var e: i32 = deps.starts[fi + 1];
    while (k < e) {
      if (changed[deps.deps[k]] == 1) {
        out = out.with(fi, 1);
        k = e;
      } else {
        k = k + 1;
      }
    }
    fi = fi + 1;
  }
  return out;
}

// A bucketed fixpoint registry is kept as per-row text between rounds:
// rows[r] is a whole record (borrow_reg_row) and row_bucket[r] its bucket, in
// the order a full re-put would land them. borrow_reg_rebuild clears only the
// STALE buckets — those a changed record hashes to — and re-fills them in row
// order, which is the layout a full re-put produces, since bucket assignment
// is a function of the key alone; every other bucket is carried over as is.
// `own` for the same reason as borrow_reg_put: an alias of a param
// (`var out = reg;`) is a borrowed name and refuses the in-place
// self-reassign, so the registry is written through the param itself.
function borrow_reg_rebuild(own reg: string[], stale: i32[], rows: string[], row_bucket: i32[]): string[] {
  var b: i32 = 0;
  while (b < stale.len()) {
    if (stale[b] == 1) {
      reg = reg.with(b, "");
    }
    b = b + 1;
  }
  var r: i32 = 0;
  while (r < rows.len()) {
    var rb: i32 = row_bucket[r];
    if (rows[r].len() > 0 && stale[rb] == 1) {
      reg = reg.with(rb, reg[rb] + rows[r]);
    }
    r = r + 1;
  }
  return reg;
}

// borrow_reg_row: the record for `key`, or "" when there are no flags to
// record — a function none of whose parameters qualifies has no entry.
function borrow_reg_row(key: string, flags: string): string {
  if (flags.len() == 0) {
    return "";
  }
  return borrow_reg_record(key, flags);
}

// seed_flags: every parameter of `fn` marked, the optimistic start of a
// greatest fixpoint.
function seed_flags(fn: parser.FuncDecl): string {
  var out: string = "";
  var sp: i32 = 0;
  while (sp < fn.params.len()) {
    out = out + "1";
    sp = sp + 1;
  }
  return out;
}

// A closure box (`__mkclo$<clo>(caps…)`) is keyed in the borrowability
// registry like a call to `<clo>`, one flag per capture: the box holds each
// capture as a borrow, so passing a local there is a borrow while the box dies
// before the local and the closure body keeps the capture no longer than the
// box. CloSite is one such box: the function `host` builds it and `clo` is the
// lifted body.
struct CloSite { key: string, host: i32, clo: i32, caps: i32 }

// clo_sites: every capturing closure box the module builds, with its host and
// its lifted body.
function clo_sites(funcs: parser.FuncDecl[]): CloSite[] {
  var out: CloSite[] = [];
  var hi: i32 = 0;
  while (hi < funcs.len()) {
    var found: CloScan = CloScan { markers: [], caps: [] };
    for st in funcs[hi].body {
      found = astwalk.fold_stmt(st, found, clo_marker_visit);
    }
    var k: i32 = 0;
    while (k < found.markers.len()) {
      var ci: i32 = func_index_named(funcs, mkclo_funcval(found.markers[k]));
      if (ci >= 0) {
        out = out.append(CloSite { key: found.markers[k], host: hi, clo: ci, caps: found.caps[k] });
      }
      k = k + 1;
    }
    hi = hi + 1;
  }
  return out;
}

struct CloScan { markers: string[], caps: i32[] }

function clo_marker_visit(e: ast.Expr, own sc: CloScan): CloScan {
  if let ast.ExprCall(c) = e {
    var nm: string = ident_name_or_empty(c.callee);
    if (c.args.len() > 0 && mkclo_funcval(nm).len() > 0) {
      return CloScan { markers: sc.markers.append(nm), caps: sc.caps.append(c.args.len()) };
    }
  }
  return sc;
}

function func_index_named(funcs: parser.FuncDecl[], name: string): i32 {
  var i: i32 = 0;
  while (i < funcs.len()) {
    if (funcs[i].receiver_type.len() == 0 && funcs[i].name == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// clo_site_flags: the flags the box `site` earns under `reg`, or "" when it
// earns none. A box that dies in its host (clo_box_dies_in_host) borrows its
// captures, so none of them may be reassigned while it could read them. A box
// that outlives its host holds a count of each, which
// leaves the host's own reference its own to release — for the kinds whose
// release there is rc-gated. Either way a capture is a borrow only while the
// body keeps it no longer than the box; a bare `return <cap>` retains it.
function clo_site_flags(site: CloSite, funcs: parser.FuncDecl[], reg: string[], structs: irtables.StructTab): string {
  var dies: boolean = clo_box_dies_in_host(site, funcs, reg);
  var host: parser.FuncDecl = funcs[site.host];
  var body: ast.Stmt[] = funcs[site.clo].body;
  var cloreasg: string[] = irtables.body_assign_targets(body);
  var flags: string = "";
  var any: boolean = false;
  var k: i32 = 0;
  while (k < site.caps) {
    var cap: string = env_capture_name(body, k);
    var ok: boolean = cap.len() > 0 && !util.has_str(cloreasg, cap) && !body_unsafe_for_allow_ret(body, cap, reg, []);
    if (ok && !dies) {
      ok = owned_capture_shares(capture_kind(env_capture_type(body, k), structs));
    }
    if (ok) {
      flags = flags + "1";
      any = true;
    } else {
      flags = flags + "0";
    }
    k = k + 1;
  }
  if (!any) {
    return "";
  }
  if (dies && clo_site_captures_reassigned(host.body, site.key, irtables.body_assign_targets(host.body))) {
    return "";
  }
  return flags;
}

// owned_capture_shares: an owning box's count of a capture of this kind leaves
// the host free to keep its own release, which for these kinds is rc-gated.
function owned_capture_shares(kind: string): boolean {
  return kind == "s" || kind == "S" || kind == "r" || kind == "a";
}

// clo_box_dies_in_host: the box `site` builds is released by the frame that
// built it — bound once to a local that is only called or lent to borrowable
// positions, or passed straight to a borrowable position, where the call's own
// release frees it.
function clo_box_dies_in_host(site: CloSite, funcs: parser.FuncDecl[], reg: string[]): boolean {
  var host: parser.FuncDecl = funcs[site.host];
  var seen: CloUse = CloUse { key: site.key, reg: reg, total: 0, lent: false, bound: "" };
  for st in host.body {
    seen = astwalk.fold_stmt(st, seen, clo_use_visit);
  }
  for st in host.body {
    seen = astwalk.fold_stmt_spine(st, seen, clo_bind_visit);
  }
  if (seen.total != 1) {
    return false;
  }
  if (seen.bound.len() > 0) {
    return irtables.local_decl_count(host.body, seen.bound) == 1 && !util.has_str(irtables.body_assign_targets(host.body), seen.bound)
      && !body_unsafe_for(host.body, seen.bound, reg, []);
  }
  return seen.lent;
}

// capture_kind: how an owning box releases a capture of type `t` — 's' a
// string, 'S' a string[], 'r' an array of arrays, 'a' a scalar array or
// scalar cell, 'p' a struct, enum or closure (one shallow dec each), 'k' a
// counted kind with no release here, whose count it keeps and leaks, and '.'
// anything it holds no count of. Only a type known to be a counted pointer
// takes a count: retaining a scalar reads its value as an address.
function capture_kind(t: string, structs: irtables.StructTab): string {
  if (t == "string") {
    return "s";
  }
  if (t == "string[]") {
    return "S";
  }
  if (t == "fn" || is_fn_payload_spelling(t)) {
    return "p";
  }
  if (irtables.decl_is_struct(structs, t) || irtables.decl_is_enum(structs, t)) {
    return "p";
  }
  if (is_cell_type_name(t)) {
    if (is_scalar_cell_elem(cell_elem_of_type_name(t))) {
      return "a";
    }
    return "k";
  }
  if (t.len() > 4 && slice_unchecked(t, t.len() - 4, t.len()) == "[][]") {
    return "r";
  }
  if (irtables.is_leaksafe_array_field(t)) {
    return "a";
  }
  if (irtables.is_array_type_name(t) || is_map_type_name(t) || util.is_tuple_type_name(t)) {
    return "k";
  }
  return ".";
}

// env_capture_type: the declared type of capture `k`'s extract, or "".
function env_capture_type(body: ast.Stmt[], k: i32): string {
  var nm: string = env_capture_name(body, k);
  for st in body {
    if let ast.StmtVar(v) = st {
      if (v.name == nm) {
        return v.type_name;
      }
    }
  }
  return "";
}

function is_scalar_cell_elem(t: string): boolean {
  return irtables.is_scalar_type_name(t) || t == "bool" || t == "boolean" || t == "char" || t == "u8" || t == "usize";
}

// flags_meet: the positions set in both `a` and `b`, either of which may be ""
// (none set).
function flags_meet(a: string, b: string): string {
  if (a.len() == 0 || b.len() == 0) {
    return "";
  }
  var out: string = "";
  var any: boolean = false;
  var i: i32 = 0;
  while (i < a.len()) {
    if (i < b.len() && a[i] == b'1' && b[i] == b'1') {
      out = out + "1";
      any = true;
    } else {
      out = out + "0";
    }
    i = i + 1;
  }
  if (!any) {
    return "";
  }
  return out;
}

function i32_or(a: i32[], b: i32[]): i32[] {
  var out: i32[] = a;
  var i: i32 = 0;
  while (i < b.len()) {
    if (b[i] == 1) {
      out = out.with(i, 1);
    }
    i = i + 1;
  }
  return out;
}

struct CloUse { key: string, reg: string[], total: i32, lent: boolean, bound: string }

function clo_use_visit(e: ast.Expr, own u: CloUse): CloUse {
  if let ast.ExprCall(c) = e {
    var nm: string = ident_name_or_empty(c.callee);
    if (nm == u.key) {
      return CloUse { ...u, total: u.total + 1 };
    }
    var i: i32 = 0;
    while (i < c.args.len()) {
      if let ast.ExprCall(ac) = c.args[i] {
        if (ident_name_or_empty(ac.callee) == u.key && nm.len() > 0 && param_is_borrowable(u.reg, nm, i)) {
          return CloUse { ...u, lent: true };
        }
      }
      i = i + 1;
    }
  }
  return u;
}

function clo_bind_visit(st: ast.Stmt, own u: CloUse): CloUse {
  if let ast.StmtVar(v) = st {
    if let ast.ExprCall(c) = v.init {
      if (ident_name_or_empty(c.callee) == u.key) {
        return CloUse { ...u, bound: v.name };
      }
    }
  }
  return u;
}

// env_capture_name: the local the lifted body reads capture `k` into — its
// `var <cap> = __env[1+k]` extract — or "".
function env_capture_name(body: ast.Stmt[], k: i32): string {
  for st in body {
    if let ast.StmtVar(v) = st {
      if let ast.ExprIndex(ix) = v.init {
        if (ident_name_or_empty(ix.array) == "__env") {
          if let ast.ExprNumber(n) = ix.index {
            if (n.text == util.i32_to_string(k + 1)) {
              return v.name;
            }
          }
        }
      }
    }
  }
  return "";
}

// clo_site_captures_reassigned: some local the box `key` captures is reassigned
// in the host, which could free the buffer the box still reads.
function clo_site_captures_reassigned(body: ast.Stmt[], key: string, reasg: string[]): boolean {
  var caps: CloCaps = CloCaps { key: key, names: [] };
  for st in body {
    caps = astwalk.fold_stmt(st, caps, clo_caps_visit);
  }
  for n in caps.names {
    if (util.has_str(reasg, n)) {
      return true;
    }
  }
  return false;
}

struct CloCaps { key: string, names: string[] }

function clo_caps_visit(e: ast.Expr, own cc: CloCaps): CloCaps {
  if let ast.ExprCall(c) = e {
    if (ident_name_or_empty(c.callee) == cc.key) {
      var names: string[] = cc.names;
      for a in c.args {
        names = names.append(ident_name_or_empty(a));
      }
      return CloCaps { key: cc.key, names: names };
    }
  }
  return cc;
}

pub function borrowable_params_interproc(funcs: parser.FuncDecl[], structs: irtables.StructTab): string[] {
  // Greatest-fixpoint FROM ABOVE (the native `inferParamEscapes`, ir.go): start
  // OPTIMISTIC — EVERY param borrowable — then repeatedly re-run the escape
  // walker; a param flips to NON-borrowable (and never back) the first pass the
  // walker finds it escaping under the CURRENT registry. The non-call escape
  // channels (return / alias / container store / slice / lambda capture) don't
  // consult the registry, so they flip params off on their own; a call-arg
  // escape only fires once the callee's position is known non-borrowable, so the
  // set SHRINKS monotonically to the greatest sound fixpoint.
  //
  // This supersedes the old least-fixpoint FROM BELOW (start empty, grow): the
  // from-below pass could never bootstrap a MUTUALLY RECURSIVE borrow — each
  // param only became borrowable once its callee already was, so a cycle (e.g.
  // the `expr_unsafe_for`/`stmt_unsafe_for`/`body_unsafe_for` walkers passing
  // their read-only registry param around the cycle) stayed conservatively
  // non-borrowable forever. From-above keeps a cyclic param borrowable unless an
  // ACTUAL escape is proven, matching native and recovering those borrows for the
  // downstream reclaim (`reclaimable_names_of`, snapshot/precise-drop gating).
  //
  // SOUNDNESS NOTE: from-below is fail-safe on its iteration cap (an un-converged
  // result is SMALLER than the fixpoint ⇒ conservative). From-above is the
  // opposite — an un-converged result is LARGER ⇒ would mark an escaping param
  // borrowable. So convergence is detected EXACTLY (the registry signature stops
  // changing) and the cap is a generous backstop only; real call graphs converge
  // in a handful of passes (escapes propagate at call-graph-depth speed).
  // Computed ONCE per module on the emit path (the emit_function_via_ir /
  // emit_function_ir call sites), not per lowered function. Encoded
  // "callee|flags"; methods keyed "<Type>.<method>".
  //
  // Seed: every param of every function optimistically borrowable.
  var n: i32 = funcs.len();
  var nb: i32 = borrow_reg_buckets();
  var keys: string[] = [];
  var cur: string[] = [];
  // The reassign set is a function of the BODY, which no round changes, so
  // each round's borrowable_flags_under reads it instead of re-folding it.
  var reasgs: string[][] = [];
  // Three rows per function: its box entry, then its "TUPB:" and "ELB:" tiers.
  var rows: string[] = [];
  var row_bucket: i32[] = [];
  var fi: i32 = 0;
  while (fi < n) {
    var key: string = borrowable_key(funcs[fi]);
    var seedflags: string = seed_flags(funcs[fi]);
    keys = keys.append(key);
    cur = cur.append(seedflags);
    if (funcs[fi].params.len() > 0) {
      reasgs = reasgs.append(irtables.body_assign_targets(funcs[fi].body));
    } else {
      reasgs = reasgs.append([]);
    }
    rows = rows.append(borrow_reg_row(key, seedflags));
    rows = rows.append("");
    rows = rows.append("");
    row_bucket = row_bucket.append(util.hash_bucket(key, nb));
    row_bucket = row_bucket.append(util.hash_bucket("TUPB:" + key, nb));
    row_bucket = row_bucket.append(util.hash_bucket("ELB:" + key, nb));
    fi = fi + 1;
  }
  // The copying builtins go in the same rows so a rebuild keeps them; nothing
  // below rewrites an index past the function triples.
  for ck in copying_builtin_keys(funcs) {
    rows = rows.append(borrow_reg_record(ck, copying_builtin_flags(ck)));
    row_bucket = row_bucket.append(util.hash_bucket(ck, nb));
  }
  // Closure boxes follow, seeded borrowable at every capture like a function.
  var sites: CloSite[] = clo_sites(funcs);
  var site_row0: i32 = rows.len();
  var site_flags: string[] = [];
  for site in sites {
    var sflags: string = "";
    var sk: i32 = 0;
    while (sk < site.caps) {
      sflags = sflags + "1";
      sk = sk + 1;
    }
    site_flags = site_flags.append(sflags);
    rows = rows.append(borrow_reg_row(site.key, sflags));
    row_bucket = row_bucket.append(util.hash_bucket(site.key, nb));
  }
  var reg: string[] = borrow_reg_rebuild(borrow_reg_new(), i32_filled(nb, 1), rows, row_bucket);
  var deps: CallDeps = call_deps_of(funcs, false, false);
  var dirty: i32[] = i32_filled(n, 1);
  var cap: i32 = 64;
  var iter: i32 = 0;
  // Monotone-DECREASING (flags only go 1->0), so the registry strictly
  // shrinks until the fixpoint and the cap can never truncate a still-
  // growing sequence. A round that changes no entry leaves nothing to
  // examine, which is the convergence test.
  while (iter < cap && any_i32_set(dirty)) {
    var changed: i32[] = i32_filled(n, 0);
    var stale: i32[] = i32_filled(nb, 0);
    // A box's flags only fall, and its host re-reads the ones that did.
    var hosts: i32[] = i32_filled(n, 0);
    var si: i32 = 0;
    while (si < sites.len()) {
      var nf: string = flags_meet(site_flags[si], clo_site_flags(sites[si], funcs, reg, structs));
      if (nf != site_flags[si]) {
        site_flags = site_flags.with(si, nf);
        rows = rows.with(site_row0 + si, borrow_reg_row(sites[si].key, nf));
        stale = stale.with(row_bucket[site_row0 + si], 1);
        hosts = hosts.with(sites[si].host, 1);
        dirty = dirty.with(sites[si].host, 1);
      }
      si = si + 1;
    }
    reg = borrow_reg_rebuild(reg, stale, rows, row_bucket);
    stale = i32_filled(nb, 0);
    fi = 0;
    while (fi < n) {
      if (dirty[fi] == 1 && funcs[fi].params.len() > 0) {
        var flags: string = borrowable_flags_under(funcs[fi], reasgs[fi], reg, structs);
        // The "TUPB:" payload tier and the "ELB:" element tier are
        // functions of the box flags alone (both walk with empty
        // registries), so they follow a changed verdict — and the
        // first round, whose seed carries neither.
        if (iter == 0 || flags != cur[fi]) {
          if (flags != cur[fi]) {
            changed = changed.with(fi, 1);
          }
          cur = cur.with(fi, flags);
          var ip_tupb: string = "";
          var ip_elb: string = "";
          if (flags.len() > 0) {
            ip_tupb = tuple_payload_borrow_flags(funcs[fi], flags);
            ip_elb = arrenum_elem_borrow_flags(funcs[fi], flags);
          }
          rows = rows.with(3 * fi, borrow_reg_row(keys[fi], flags));
          rows = rows.with(3 * fi + 1, borrow_reg_row("TUPB:" + keys[fi], ip_tupb));
          rows = rows.with(3 * fi + 2, borrow_reg_row("ELB:" + keys[fi], ip_elb));
          stale = stale.with(row_bucket[3 * fi], 1);
          stale = stale.with(row_bucket[3 * fi + 1], 1);
          stale = stale.with(row_bucket[3 * fi + 2], 1);
        }
      }
      fi = fi + 1;
    }
    reg = borrow_reg_rebuild(reg, stale, rows, row_bucket);
    iter = iter + 1;
    dirty = i32_or(worklist_next(deps, changed), hosts);
  }
  return reg;
}

// borrowable_flags_under: one function's box-borrowability flags under the
// registry `reg`, or "" when no parameter is borrowable.
function borrowable_flags_under(fn: parser.FuncDecl, ip_reasgn: string[], reg: string[], structs: irtables.StructTab): string {
  var flags: string = "";
  var any: boolean = false;
  var pj: i32 = 0;
  while (pj < fn.params.len()) {
    // The scrutinee of a `match (param)` is a BORROW — see
    // borrowable_params_of for why, and for what
    // param_match_binding_escapes has to rule out. Widening the set
    // keeps this pass monotone-decreasing: it only ever withholds a
    // 1->0 flip, so the convergence test is unaffected.
    // A param ALIASED into a local that never escapes is still a
    // BORROW. This call passes an EMPTY alias_ok, so the walker
    // reads `var q = p` as a bare-ident escape and the param flips
    // off — and every CALLER then refuses its own release, which is
    // where the whole cost lands. Measured against one caller: a
    // callee reading `p.len()` directly leaves it flat at 80/80, the
    // same callee with `var q: string = p` costs it 80/40, and
    // adding `q = o` costs the other half at 80/0. The callee
    // releases nothing in any of the three.
    //
    // The two readings are a UNION of independent proofs, not a
    // relaxation of either: the first forgives a bare-ident match
    // scrutinee and stays strict on aliases, the second forgives
    // non-escaping aliases and stays strict on scrutinees. A body
    // with BOTH satisfies neither and stays refused.
    //
    // Both run under the CURRENT registry `reg`, so this shrinks
    // monotonically with the rest of the from-above fixpoint.
    var ip_psal: string[] = param_alias_bind_sites(fn.body, fn.params[pj].name, reg, [], fn.body, []);
    ip_psal = param_alias_reassign_sites(fn.body, fn.params[pj].name, reg, [], fn.body, ip_psal);
    var ip_borrow: boolean = !body_unsafe_for_match_borrow(fn.body, fn.params[pj].name, reg, [], [])
      || ip_psal.len() > 0
      && !body_unsafe_for_alias(fn.body, fn.params[pj].name, reg, [], ip_psal);
    if (!fn.params[pj].own
      && !param_consumed_in_body(fn.body, fn.params[pj].name, ip_reasgn)
      && ip_borrow
      && !param_match_binding_escapes(fn.body, fn.params[pj].name, fn.params[pj].type_name, structs)) {
      flags = flags + "1";
      any = true;
    } else {
      flags = flags + "0";
    }
    pj = pj + 1;
  }
  if (!any) {
    return "";
  }
  return flags;
}

// fn_sigs_empty is the all-empty registry pair.
pub function fn_sigs_empty(): FnSigs {
  return FnSigs { borrowable_params: [], strfld_ok_types: [] };
}

// typed_enum_borrows widens `original` with the parameters each verified
// enum-contract region proves borrowed.
function typed_enum_borrows(regions: enumcontract.Region[], original: string[]): string[] {
  var out: string[] = [];
  for bucket in original {
    out = out.append(bucket);
  }
  if (out.len() == 0) {
    out = borrow_reg_new();
  }
  for region in regions {
    var plan: enumcontract.Plan = enumcontract.verify(region);
    if (plan.ok) {
      var flags: string = "";
      var i: i32 = 0;
      var changed: boolean = false;
      for borrowed in plan.borrowed {
        if (borrowed || param_is_borrowable(original, region.name, i)) {
          flags = flags + "1";
        } else {
          flags = flags + "0";
        }
        if (borrowed && !param_is_borrowable(original, region.name, i)) {
          changed = true;
        }
        i = i + 1;
      }
      if (changed) {
        var bucket: i32 = util.hash_bucket(region.name, out.len());
        out = out.with(bucket, borrow_reg_record(region.name, flags) + out[bucket]);
      }
    }
  }
  return out;
}

// fn_sigs_for_borrow builds FnSigs from the SUPPLIED borrowability verdict
// `bparams` (the interprocedural fixpoint). Both registries read that verdict,
// so both are built here from the one argument (#6703): a strfld admission
// derived from a WEAKER registry than the one the backend seeds "strfldok:"
// from would free fields nothing retained.
pub function fn_sigs_for_borrow(funcs: parser.FuncDecl[], structs: irtables.StructTab, bparams: string[]): FnSigs {
  bparams = typed_enum_borrows(enumcontract.leaves(funcs, structs.decls), bparams);
  // Hoisted: the counted-retain registry needs the same verdict the
  // construction-side string retain is gated on, and this walk is
  // whole-program — computing it twice would be a second pass over every body.
  var sfok: string[] = strfld_reclaim_ok_types_of(funcs, structs, bparams);
  // The counted-retain verdict is computed here and folded into the
  // borrowability registry the escape walker threads, so the two registries
  // cannot disagree about a position and the walker needs no extra parameter.
  var rf: string[] = return_fresh_struct_ret_fns_of(funcs, structs, sfok);
  var pcnt: string[] = param_counted_of(funcs, structs, sfok, prefixed_names_of(rf, "ENUM:"), prefixed_names_of(rf, "ARROWN:"));
  return FnSigs { borrowable_params: borrow_reg_with_counted(bparams, pcnt), strfld_ok_types: sfok };
}

function struct_ret_key(fn: parser.FuncDecl): string {
  if (fn.receiver_type.len() > 0) {
    return util.base_type_name(fn.receiver_type) + "." + fn.name;
  }
  return fn.name;
}

// prefixed_names_of: the rows of `rows` carrying `pfx`, with it stripped.
function prefixed_names_of(rows: string[], pfx: string): string[] {
  var out: string[] = [];
  for r in rows {
    if (r.len() > pfx.len() && util.str_has_prefix(r, pfx)) {
      out = out.append(slice_unchecked(r, pfx.len(), r.len()) + "");
    }
  }
  return out;
}

// --- movedLocals port (#4482, native computeMovedLocals) ---------------------
//
// Move-on-alias / move-on-construction pair cancellation: an owned rc LOCAL
// whose last mention is a bare-ident RHS of a dominating top-level alias
// (`var b = a` / `b = a` / `var (x, y) = a`) or a bare-ident value in a
// counted construction slot (struct-lit rc-tracked non-string field, array /
// tuple literal element) is MOVED — the alias/construction inc and the exit
// sweep dec cancel, the container frees it once. Ported from
// internal/ir/rc_analysis.go:1037 with two scoping cuts, both documented in
// the diff harness: (a) move-on-call (`own` args into `own` callee params +
// own-param match scrutinees) is not ported — no `own` shapes in the corpus;
// (b) closure-capture construction moves are not ported. "Last mention" is
// approximated as: the name occurs exactly ONCE in the site statement and in
// no later top-level statement — exact for single-mention statements (native
// keys per ident NODE, which only differs when the same name recurs inside
// one statement).

// opt_payload_type parses a "Option[T]" / "Result[T, E]" ret_type and the bound
// variant to the payload type tag: T for Some/Ok, E for Err. Returns "" if the
// shape isn't a simple single-type-arg form (nested generics / tuples bail).
pub function opt_payload_type(rettype: string, variant: string): string {
  var n: i32 = rettype.len();
  if (n >= 8 && slice_unchecked(rettype, 0, 7) == "Option[" && rettype[n - 1] == b']') {
    return slice_unchecked(rettype, 7, n - 1) + "";
  }
  if (n >= 8 && slice_unchecked(rettype, 0, 7) == "Result[" && rettype[n - 1] == b']') {
    // Split the inside on the top-level comma: T , E.
    var inside: str = slice_unchecked(rettype, 7, n - 1);
    var ci: i32 = top_level_comma(inside);
    if (ci >= inside.len()) {
      return "";
    }
    if (variant == "Err") {
      return trim_spaces(slice_unchecked(inside, ci + 1, inside.len()));
    }
    return trim_spaces(slice_unchecked(inside, 0, ci));
  }
  return "";
}

// is_fn_payload_spelling reports whether a recovered Option/Result payload type
// spelling `t` names a FUNCTION type (slice #3445 match-fn). Detected
// CONSERVATIVELY: only the unambiguous single-paren fn forms — `() => …` (no
// params) or `(T) => …` (one param) — count. A multi-element tuple spelling
// `(A, B)` is NEVER a fn (it has no top-level `=>` and the leading `(` is a
// tuple, not a param list), so a top-level comma inside the leading parens
// disqualifies it. The match arm marks a payload of this spelling a closure
// local so the bound `f(args)` dispatches env-first against the env box the
// constructor side wrapped.
pub function is_fn_payload_spelling(t: string): boolean {
  var n: i32 = t.len();
  if (n < 5) {  // shortest is "()=>X"
    return false;
  }
  if (t[0] != b'(') {
    return false;
  }
  // Find the matching ')' for the leading '(' at top depth; reject a
  // top-level comma inside (that's a multi-element tuple, not a param list).
  var depth: i32 = 0;
  var i: i32 = 0;
  var close: i32 = 0 - 1;
  while (i < n) {
    var ch: u8 = t[i];
    if (ch == b'(' || ch == b'[') {
      depth = depth + 1;
    } else if (ch == b')' || ch == b']') {
      depth = depth - 1;
      if (depth == 0 && ch == b')') {
        close = i;
        i = n;
      }
    } else if (ch == b',' && depth == 1) {  // a top-level comma means a tuple
      return false;
    }
    i = i + 1;
  }
  if (close < 0) {
    return false;
  }
  // After the ')' (skipping spaces) the next two chars must be "=>".
  var j: i32 = close + 1;
  while (j < n && t[j] == b' ') {
    j = j + 1;
  }
  if (j + 1 >= n) {
    return false;
  }
  return t[j] == b'=' && t[j + 1] == b'>';
}

// top_level_comma returns the index of the first comma at bracket depth zero
// in `inner`, or its length when there is none. It is what separates the two
// halves of a two-parameter type spelling — K from V in `Map[K, V]`, T from E
// in `Result[T, E]` — where either half carries commas of its own:
// `(i32, i32)`, `Pair[i32, i32]`. Stopping at the FIRST comma read
// `Map[(i32, i32), i32]` as a key of `(i32` and a value of `i32), i32`.
function top_level_comma(inner: str): i32 {
  var depth: i32 = 0;
  var ci: i32 = 0;
  while (ci < inner.len()) {
    var c: u8 = inner[ci];
    if (c == b'[' || c == b'(') {
      depth = depth + 1;
    } else if (c == b']' || c == b')') {
      depth = depth - 1;
    } else if (c == b',' && depth == 0) {
      return ci;
    }
    ci = ci + 1;
  }
  return inner.len();
}

// trim_spaces drops leading/trailing ASCII spaces.
function trim_spaces(t: string): string {
  var a: i32 = 0;
  var b: i32 = t.len();
  while (a < b && t[a] == b' ') {
    a = a + 1;
  }
  while (b > a && t[b - 1] == b' ') {
    b = b - 1;
  }
  return slice_unchecked(t, a, b) + "";
}

// cap_local_init returns the initialiser of the local `name` bound by a `var` in
// `body`, or an unknown expression when there is none. This is a remaining
// legacy ownership query, not an authority for capture types.
function cap_local_init(body: ast.Stmt[], name: string): ast.Expr {
  function init_of(st: ast.Stmt, own acc: ast.Expr): ast.Expr {
    var found: ast.Expr = acc;
    if let ast.ExprUnknown(_) = found {
      if let ast.StmtVar(v) = st {
        if (v.name == name) {
          return v.init;
        }
      }
    }
    return found;
  }
  var found: ast.Expr = parser.e_unknown("");
  for st in body {
    found = astwalk.fold_stmt_spine(st, found, init_of);
    match (found) {
      ast.ExprUnknown(_) => {},
      _ => {
        return found;
      }
    }
  }
  return found;
}

function append_all(dst: string[], src: string[]): string[] {
  var i: i32 = 0;
  while (i < src.len()) {
    dst = dst.append(src[i]);
    i = i + 1;
  }
  return dst;
}

// collect_append_recvs_expr appends the receiver NAME of every
// `<ident>.append(v)` / `<ident>.set(i, v)` call in `e` (recursing all
// expression containers; a nested lambda recurses plainly — an inner
// param shadowing an outer name only over-collects, which at worst adds a
// harmless extra bracket).
function collect_append_recvs_expr(e: ast.Expr, acc: string[]): string[] {
  match (e) {
    ast.ExprBinary(b) => {
      acc = collect_append_recvs_expr(b.left, acc);
      return collect_append_recvs_expr(b.right, acc);
    },
    ast.ExprUnary(u) => {
      return collect_append_recvs_expr(u.operand, acc);
    },
    ast.ExprCall(c) => {
      match (c.callee) {
        ast.ExprFieldAccess(cfa) => {
          if (cfa.field == "append" && c.args.len() == 1 || cfa.field == "set" && c.args.len() == 2) {
            match (cfa.obj) {
              ast.ExprIdent(rid) => {
                acc = acc.append(rid.name);
              },
              _ => {}
            }
          }
          acc = collect_append_recvs_expr(cfa.obj, acc);
        },
        _ => {
          acc = collect_append_recvs_expr(c.callee, acc);
        }
      }
      for arg in c.args {
        acc = collect_append_recvs_expr(arg, acc);
      }
      return acc;
    },
    ast.ExprArray(a) => {
      var i: i32 = 0;
      while (i < a.elements.len()) {
        acc = collect_append_recvs_expr(a.elements[i], acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprTuple(t) => {
      for el in t.elements {
        acc = collect_append_recvs_expr(el, acc);
      }
      return acc;
    },
    ast.ExprIndex(x) => {
      acc = collect_append_recvs_expr(x.array, acc);
      return collect_append_recvs_expr(x.index, acc);
    },
    ast.ExprSlice(sl) => {
      acc = collect_append_recvs_expr(sl.array, acc);
      acc = collect_append_recvs_expr(sl.start, acc);
      return collect_append_recvs_expr(sl.end, acc);
    },
    ast.ExprStructLit(sl) => {
      if (sl.has_base) {
        acc = collect_append_recvs_expr(sl.base, acc);
      }
      for fv in sl.field_values {
        acc = collect_append_recvs_expr(fv, acc);
      }
      return acc;
    },
    ast.ExprFieldAccess(fa) => {
      return collect_append_recvs_expr(fa.obj, acc);
    },
    ast.ExprMapLit(ml) => {
      var i: i32 = 0;
      while (i < ml.keys.len()) {
        acc = collect_append_recvs_expr(ml.keys[i], acc);
        i = i + 1;
      }
      var j: i32 = 0;
      while (j < ml.vals.len()) {
        acc = collect_append_recvs_expr(ml.vals[j], acc);
        j = j + 1;
      }
      return acc;
    },
    ast.ExprFString(fs) => {
      var i: i32 = 0;
      while (i < fs.exprs.len()) {
        acc = collect_append_recvs_expr(fs.exprs[i], acc);
        i = i + 1;
      }
      return acc;
    },
    ast.ExprLambda(lm) => {
      var i: i32 = 0;
      while (i < lm.body.len()) {
        acc = collect_append_recvs_stmt(lm.body[i], acc);
        i = i + 1;
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

function collect_append_recvs_stmt(st: ast.Stmt, acc: string[]): string[] {
  match (st) {
    ast.StmtDefer(d) => {
      return collect_append_recvs_stmt(d.action, acc);
    },
    ast.StmtVar(v) => {
      return collect_append_recvs_expr(v.init, acc);
    },
    ast.StmtReturn(r) => {
      return collect_append_recvs_expr(r.value, acc);
    },
    ast.StmtExpr(e) => {
      return collect_append_recvs_expr(e.value, acc);
    },
    ast.StmtAssign(a) => {
      return collect_append_recvs_expr(a.value, acc);
    },
    ast.StmtIf(f) => {
      acc = collect_append_recvs_expr(f.cond, acc);
      var ti: i32 = 0;
      while (ti < f.then_body.len()) {
        acc = collect_append_recvs_stmt(f.then_body[ti], acc);
        ti = ti + 1;
      }
      var ei: i32 = 0;
      while (ei < f.else_body.len()) {
        acc = collect_append_recvs_stmt(f.else_body[ei], acc);
        ei = ei + 1;
      }
      return acc;
    },
    ast.StmtWhile(w) => {
      acc = collect_append_recvs_expr(w.cond, acc);
      var i: i32 = 0;
      while (i < w.body.len()) {
        acc = collect_append_recvs_stmt(w.body[i], acc);
        i = i + 1;
      }
      return acc;
    },
    ast.StmtFor(f2) => {
      acc = collect_append_recvs_expr(f2.iter, acc);
      var i: i32 = 0;
      while (i < f2.body.len()) {
        acc = collect_append_recvs_stmt(f2.body[i], acc);
        i = i + 1;
      }
      return acc;
    },
    ast.StmtMatch(m) => {
      acc = collect_append_recvs_expr(m.scrutinee, acc);
      for arm in m.arms {
        var bi: i32 = 0;
        while (bi < arm.body.len()) {
          acc = collect_append_recvs_stmt(arm.body[bi], acc);
          bi = bi + 1;
        }
      }
      return acc;
    },
    _ => {
      return acc;
    }
  }
  return acc;
}

// grow_fn_key is the registry spelling of a function: bare for a free function,
// "<BaseType>.<method>" for a receiver method.
pub function grow_fn_key(fd: parser.FuncDecl): string {
  if (fd.receiver_type.len() > 0) {
    return util.base_type_name(fd.receiver_type) + "." + fd.name;
  }
  return fd.name;
}

// decl_type_in_fn: the declared type of `name` in `fn` — receiver, parameter,
// or the annotation of its `var` — "" when it has none the AST states.
function decl_type_in_fn(fn: parser.FuncDecl, name: string): string {
  if (fn.receiver_name.len() > 0 && fn.receiver_name == name) {
    return util.base_type_name(fn.receiver_type);
  }
  for pd in fn.params {
    if (pd.name == name) {
      return pd.type_name;
    }
  }
  return var_annot_in_stmts(fn.body, name);
}

function var_annot_in_stmts(stmts: ast.Stmt[], name: string): string {
  for stmt in stmts {
    var t: string = "";
    match (stmt) {
      ast.StmtVar(v) => {
        if (v.name == name) {
          return v.type_name;
        }
      },
      ast.StmtIf(f) => {
        t = var_annot_in_stmts(f.then_body, name);
        if (t.len() == 0) {
          t = var_annot_in_stmts(f.else_body, name);
        }
      },
      ast.StmtWhile(w) => {
        t = var_annot_in_stmts(w.body, name);
      },
      ast.StmtFor(fo) => {
        t = var_annot_in_stmts(fo.body, name);
      },
      ast.StmtMatch(m) => {
        for arm in m.arms {
          if (t.len() == 0) {
            t = var_annot_in_stmts(arm.body, name);
          }
        }
      },
      _ => {}
    }
    if (t.len() > 0) {
      return t;
    }
  }
  return "";
}
