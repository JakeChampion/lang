// examples/self_host/fnsigs.fern — the borrowability registry: per function,
// which parameters a callee only reads and which it takes counted, as rows
// keyed by the function's name. ssarc.caller_sigs writes each produced
// callee's rows from its verified contract, and wp_fact_rows folds them into
// the per-unit cache key.

import "./parser";
import "./util";

// FnSigs is the registry ssarc.caller_sigs writes for one program.
pub struct FnSigs {
  // borrowable_params: params a callee only reads, so the caller need not
  // retain across the call, plus the counted-position "CNT:" rows.
  borrowable_params: string[],
}

// fn_sigs_empty is the empty registry.
pub function fn_sigs_empty(): FnSigs {
  return FnSigs { borrowable_params: [] };
}

// wp_fact_rows lists the whole-program facts that come from function BODIES:
// the borrowability rows, which each callee's verified contract decides. A
// body-only edit in one module can move them for a unit elsewhere, so the
// per-module caches fold them into their keys (modloader.module_fact_hashes).
pub function wp_fact_rows(b: FnSigs): string[] {
  let out: string[] = [];
  for row in b.borrowable_params {
    // A registry row is a whole hash bucket, entries joined by newlines, and
    // which entries share a bucket depends on the table's size; so each entry
    // is its own fact. An empty bucket records nothing.
    let start: i32 = 0;
    let i: i32 = 0;
    while (i <= row.len()) {
      if (i == row.len() || row[i] == b'\n') {
        if (i > start) {
          out = out.append(slice_unchecked(row, start, i) + "");
        }
        start = i + 1;
      }
      i = i + 1;
    }
  }
  return out;
}

// A borrowability registry is a fixed-width bucket array, NOT a list of entries:
// exactly borrow_reg_buckets() strings, bucket b holding the '\n'-terminated
// "<key>|<flags>" records whose key hashes to b.
//
// Bucketing on the key's FIRST BYTE would not do: self-host names are dominated
// by shared prefixes (set_*, emit_*, is_*, lower_*, collect_*), so the worst
// first-byte bucket held 159 of the pre-split irlower.fern's 1,359 functions —
// 11.7% of the table. The whole key is hashed instead.
//
// A prime count keeps unrelated hash strides from aliasing onto the same bucket.
// Sized to the table: the compiler's own registry holds some 11 k keys across
// its tiers, and a lookup walks its bucket's records byte by byte, so 4093
// buckets keep a bucket to a few records.
function borrow_reg_buckets(): i32 {
  return 4093;
}

pub function borrow_reg_new(): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  let n: i32 = borrow_reg_buckets();
  while (i < n) {
    out = out.append("");
    i = i + 1;
  }
  return out;
}

// borrow_reg_set replaces the record for `key` — a lookup takes the first
// record of a name in its bucket, so the old one is dropped rather than
// shadowed — and an empty `flags` leaves the key with no record, which a
// lookup reads as nothing borrowable. An empty registry is given its buckets.
// `reg` is moved in and stored to in place.
pub function borrow_reg_set(own reg: string[], key: string, flags: string): string[] {
  if (reg.len() == 0) {
    reg = borrow_reg_new();
  }
  let b: i32 = util.hash_bucket(key, reg.len());
  let bucket: string = reg[b];
  let kept: string = "";
  let p: i32 = 0;
  while (p < bucket.len()) {
    let end: i32 = p;
    while (end < bucket.len() && bucket[end] != b'\n') {
      end = end + 1;
    }
    let bar: i32 = p;
    while (bar < end && bucket[bar] != b'|') {
      bar = bar + 1;
    }
    if (slice_unchecked(bucket, p, bar) != key) {
      kept = kept + slice_unchecked(bucket, p, end) + "\n";
    }
    p = end + 1;
  }
  if (flags.len() > 0) {
    kept = kept + key + "|" + flags + "\n";
  }
  reg = reg.with(b, kept);
  return reg;
}

// grow_fn_key is the registry spelling of a function: bare for a free function,
// "<BaseType>.<method>" for a receiver method.
pub function grow_fn_key(fd: parser.FuncDecl): string {
  if (fd.receiver_type.len() > 0) {
    return util.base_type_name(fd.receiver_type) + "." + fd.name;
  }
  return fd.name;
}
