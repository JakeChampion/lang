// examples/self_host/irlower_run.fern — driver for the AST -> stack-IR
// lowering (irlower.fern). Reads a program on stdin, lowers the whole module
// to the stack IR (irlower.lower_module), evaluates `main` with the IR
// interpreter (which dispatches direct calls across the module), and returns
// the result as the process exit code — end-to-end proof that AST -> IR ->
// eval preserves the program's value, now including multi-function programs
// and recursion. With `-dump`, prints `main`'s lowered op stream instead
// (`-dump-fn <name>` for any other function). A `main` outside the lowered
// subset makes lowering bail -> exit 200.
//
// `-verify` / `-verifystack` / `-verifyfip` (#6639): run the IR verifiers over
// every lowered function and report, exiting 1 when anything is found.
// `-verifystack` also prints how much of the module it could model, and
// `-verifyfip` a per-function `claim=… fresh=… paired=…` census, since an empty
// problem list means nothing without knowing how much was looked at.
//
// `-rc-plan` (#4482): print each function's Perceus decision-table dump
// (irlower.rc_plan_dump — the self-host half of the rcPlan differential
// harness, pinned to native's internal/ir/rc_dump.go format) instead of
// evaluating. One `== <name>` header per function (receiver methods keyed
// `<Type>.<name>` like native's fn.Name), then the function's non-empty
// table lines. The Go-side gate diffs this against ir.RcPlanHook's output
// for the same source.
//
// `-clocensus` (#6638): print one line counting this module's closure call
// sites — the population a defunctionalisation pass would devirtualise, split
// by how decidable each site is. Measurement only; nothing on the emit path
// reads it.
//
// `-str-own` (#4297 CS4): print each function's slot-carried string-
// ownership facts (irlower.str_own_dump — `p/v/r <name>: <ownership>` lines,
// codes mirroring native ast.Ownership) instead of evaluating; pinned by the
// Go-side gate in internal/e2eselfhost/self_host_strown_dump_test.go.

import "std/io";
import "./lexer";
import "./parser";
import "./ir";
import "./irexec";
import "./irlower";
import "./irverify";
import "./irverifystack";
import "./irfipverify";
import "./util";

// verify_all runs the IR structure verifier (#6639 slice 1) over every
// successfully lowered function and returns the problems, so the driver can
// be pointed at real modules — which is where a structural bug would
// actually be, and the only way to know the pass does not fire on valid IR.
function verify_all(funcs: parser.FuncDecl[], fns: ir.LoweredFn[]): irverify.Problem[] {
    // The index the BACKENDS build, from the same declarations, so the corpus
    // sweep gates the derivation the compile-path gate actually consults —
    // including its receiver-counting rule, which an off-by-one would turn
    // into a reported mismatch on every method call in the corpus.
    var ix: irverify.NameIndex = irlower.fn_sig_index(funcs);
    var out: irverify.Problem[] = [];
    var j: i32 = 0;
    while (j < fns.len()) {
        if (fns[j].ok) {
            var ps: irverify.Problem[] = irverify.verify_fn(fns[j].name, fns[j].ops, fns[j].n_params, fns[j].n_locals, ix);
            var k: i32 = 0;
            while (k < ps.len()) { out = out.append(ps[k]); k = k + 1; }
        }
        j = j + 1;
    }
    return out;
}

// StackSweep is one module's operand-stack verdict: the problems found, and
// how much of the module the pass could model. The coverage half travels with
// the problems because an empty problem list means nothing without it.
struct StackSweep { problems: irverify.Problem[], cov: irverifystack.Coverage }

// verify_stack_all runs the operand-stack verifier (#6639 slice 2) over every
// successfully lowered function. A function the pass cannot model contributes
// a skip reason rather than a problem, so a widening op vocabulary shows up as
// a coverage drop instead of a false failure.
function verify_stack_all(fns: ir.LoweredFn[]): StackSweep {
    var out: irverify.Problem[] = [];
    var cov: irverifystack.Coverage = irverifystack.coverage_new();
    var i: i32 = 0;
    while (i < fns.len()) {
        if (fns[i].ok) {
            var r: irverifystack.StackResult = irverifystack.verify_stack_fn(fns[i].name, fns[i].ops);
            cov = irverifystack.coverage_add(cov, fns[i].name, r.bail);
            var k: i32 = 0;
            while (k < r.problems.len()) { out = out.append(r.problems[k]); k = k + 1; }
        }
        i = i + 1;
    }
    return StackSweep { problems: out, cov: cov };
}

// FipSweep is one module's `fip` / `fbip` allocation-budget verdict: the
// problems found, and the per-function census behind them. The census travels
// with the problems for the same reason the stack pass reports coverage — a
// clean verdict over a module whose reuse layer paired nothing is not the same
// result as one over a module where it paired everything, and only the counts
// tell them apart.
struct FipSweep { problems: irverify.Problem[], census: string }

// verify_fip_all runs the allocation-budget verifier (#6639 slice 3) over every
// successfully lowered function, pairing each with its declared claim.
// `funcs` is the same list, in the same order, that `fns` was lowered from.
function verify_fip_all(funcs: parser.FuncDecl[], fns: ir.LoweredFn[]): FipSweep {
    var out: irverify.Problem[] = [];
    var census: string = "";
    var i: i32 = 0;
    while (i < fns.len() && i < funcs.len()) {
        if (fns[i].ok) {
            var claim: irfipverify.FipClaim = irfipverify.FipClaim {
                fn_name: fns[i].name, is_fip: funcs[i].fip, is_fbip: funcs[i].fbip,
                allowance: funcs[i].fip_allowance
            };
            var r: irfipverify.FipResult = irfipverify.verify_fip_fn(claim, fns[i].ops);
            var kw: string = "-";
            if (funcs[i].fip) { kw = "fip"; }
            if (funcs[i].fbip) { kw = "fbip"; }
            census = census + fns[i].name + " claim=" + kw
                + "(" + util.i32_to_string(funcs[i].fip_allowance) + ")"
                + " fresh=" + util.i32_to_string(r.fresh)
                + " paired=" + util.i32_to_string(r.paired) + "\n";
            var k: i32 = 0;
            while (k < r.problems.len()) { out = out.append(r.problems[k]); k = k + 1; }
        }
        i = i + 1;
    }
    return FipSweep { problems: out, census: census };
}

// clo_env_slot answers whether the call_indirect at `at` is reached through the
// env-first closure tail every closure dispatch emits:
//
//     load_local S ; const_i32 0 ; arr_get 32 ; call_indirect(argc + 1)
//
// The env box is loaded TWICE at such a site — once as the `__env` first
// argument, once again here to read `box[0]` as the call target — and it is the
// second load this matches. A plain fn-pointer call ends `load_local S ;
// call_indirect(argc)` with no box read, so the two dispatch shapes are
// distinguishable from the op stream alone. Returns the box slot, or -1.
function clo_env_slot(ops: ir.Op[], at: i32, k_load: i32, k_const: i32, k_arrget: i32): i32 {
    if (at < 3) { return 0 - 1; }
    if (ops[at - 1].kind_tag != k_arrget || ops[at - 1].width != 32) { return 0 - 1; }
    if (ops[at - 2].kind_tag != k_const || ops[at - 2].i32_imm != 0) { return 0 - 1; }
    if (ops[at - 3].kind_tag != k_load) { return 0 - 1; }
    return ops[at - 3].i32_imm;
}

// clo_sole_store returns the index of the ONLY write to `slot`, or -1 when the
// slot is written zero times or more than once. A slot written twice can carry
// two different closures to the one call site, which is precisely what a
// devirtualising rewrite may not assume away. Both store_local and tee_local
// write: a `var f = mk(); f(x)` binding lowers to a tee, so counting only
// store_local would classify the commonest closure binding as unwritten.
function clo_sole_store(ops: ir.Op[], slot: i32, k_store: i32, k_tee: i32): i32 {
    var found: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < ops.len()) {
        if (ops[i].kind_tag == k_store || ops[i].kind_tag == k_tee) {
            if (ops[i].i32_imm == slot) {
                if (found >= 0) { return 0 - 1; }
                found = i;
            }
        }
        i = i + 1;
    }
    return found;
}

// clo_flat_box answers whether ops[m] closes a closure-box construction of the
// shape both constructors emit — `const_func <fn> ; load_local … ; arr_make(k, 32)`
// — and so names exactly one call target. A construction whose captures are
// expressions rather than plain loads is NOT recognised: deciding those needs an
// operand-stack walk, so the provable figure this yields is a floor.
function clo_flat_box(ops: ir.Op[], m: i32, k_make: i32, k_load: i32, k_func: i32): boolean {
    if (m < 0) { return false; }
    if (ops[m].kind_tag != k_make || ops[m].width != 32) { return false; }
    var k: i32 = ops[m].i32_imm;
    if (k < 1 || m - k < 0) { return false; }
    if (ops[m - k].kind_tag != k_func) { return false; }
    var i: i32 = m - k + 1;
    while (i < m) {
        if (ops[i].kind_tag != k_load) { return false; }
        i = i + 1;
    }
    return true;
}

// clo_census renders one module's closure-call-site population (#6638
// defunctionalise S0) as a single line, over the ops the BACKENDS see.
//
// The whole population is `env`, partitioned by where the env box the site
// dispatches through comes FROM — which is what decides how much analysis a
// devirtualising rewrite would need to resolve it:
//
//   env_local a box built in this same function, single-assigned to the slot,
//             by the flat `const_func <fn> ; load_local … ; arr_make` shape:
//             one named target, decidable with no analysis beyond the op
//             stream. Expected to be near zero, and that is not a measurement
//             error — try_lift_binding already direct-calls a lambda that is
//             only ever called, so a site in this bucket is one that escaped it
//   env_call  a box single-assigned from an adjacent `call_direct`: a
//             closure-RETURNING callee, resolvable by looking at that one
//             function's returns
//   env_param a box arriving as a PARAMETER: the higher-order case, undecidable
//             inside the function and needing a whole-program pass
//   env_other multiply-assigned slots and every other provenance: what no
//             rewrite short of a full points-to analysis can name
//
//   plain     plain fn-pointer call_indirect sites, which carry no env box and
//             are a different rewrite entirely
//
// `bail` is the honest denominator: a function outside the lowered subset
// contributes no ops, so a census over a module that mostly bailed is a census
// over almost nothing.
function clo_census(fns: ir.LoweredFn[]): string {
    var k_load: i32 = ir.kind_id("load_local");
    var k_store: i32 = ir.kind_id("store_local");
    var k_tee: i32 = ir.kind_id("tee_local");
    var k_const: i32 = ir.kind_id("const_i32");
    var k_func: i32 = ir.kind_id("const_func");
    var k_arrget: i32 = ir.kind_id("arr_get");
    var k_make: i32 = ir.kind_id("arr_make");
    var k_ind: i32 = ir.kind_id("call_indirect");
    var k_calld: i32 = ir.kind_id("call_direct");

    var n_fns: i32 = 0;
    var n_bail: i32 = 0;
    var n_ops: i32 = 0;
    var n_env: i32 = 0;
    var n_local: i32 = 0;
    var n_call: i32 = 0;
    var n_param: i32 = 0;
    var n_other: i32 = 0;
    var n_plain: i32 = 0;

    var i: i32 = 0;
    while (i < fns.len()) {
        if (!fns[i].ok) {
            n_bail = n_bail + 1;
            i = i + 1;
            continue;
        }
        n_fns = n_fns + 1;
        var ops: ir.Op[] = fns[i].ops;
        n_ops = n_ops + ops.len();
        var j: i32 = 0;
        while (j < ops.len()) {
            if (ops[j].kind_tag == k_ind) {
                var slot: i32 = clo_env_slot(ops, j, k_load, k_const, k_arrget);
                if (slot < 0) {
                    n_plain = n_plain + 1;
                } else {
                    n_env = n_env + 1;
                    if (slot < fns[i].n_params) {
                        n_param = n_param + 1;
                    } else {
                        var st: i32 = clo_sole_store(ops, slot, k_store, k_tee);
                        if (st > 0 && clo_flat_box(ops, st - 1, k_make, k_load, k_func)) {
                            n_local = n_local + 1;
                        } else if (st > 0 && ops[st - 1].kind_tag == k_calld) {
                            n_call = n_call + 1;
                        } else {
                            n_other = n_other + 1;
                        }
                    }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return "clocensus: fns=" + util.i32_to_string(n_fns)
        + " bail=" + util.i32_to_string(n_bail)
        + " ops=" + util.i32_to_string(n_ops)
        + " env=" + util.i32_to_string(n_env)
        + " env_local=" + util.i32_to_string(n_local)
        + " env_call=" + util.i32_to_string(n_call)
        + " env_param=" + util.i32_to_string(n_param)
        + " env_other=" + util.i32_to_string(n_other)
        + " plain=" + util.i32_to_string(n_plain) + "\n";
}

// slot_line renders one slot class, or nothing when the class is empty — so a
// function with no strings has no `str` line rather than an empty one.
function slot_line(kind: string, slots: i32[]): string {
    if (slots.len() == 0) { return ""; }
    var out: string = "  " + kind + ":";
    var i: i32 = 0;
    while (i < slots.len()) {
        out = out + " " + util.i32_to_string(slots[i]);
        i = i + 1;
    }
    return out + "\n";
}

function main(): i32 {
    var av: string[] = args();
    var want_dump: boolean = false;
    var want_rc_plan: boolean = false;
    var want_str_own: boolean = false;
    var want_verify: boolean = false;
    var want_vstack: boolean = false;
    var want_vfip: boolean = false;
    var want_slots: boolean = false;
    var want_clocensus: boolean = false;
    // `-dump-fn <name>` dumps that function's op stream instead of `main`'s.
    // The verifiers report per function, so the follow-up question is always
    // "show me the ops of the one it named".
    var dump_fn: string = "main";
    var ai: i32 = 1;
    while (ai < av.len()) {
        if (av[ai] == "-dump") { want_dump = true; }
        if (av[ai] == "-dump-fn" && ai + 1 < av.len()) {
            want_dump = true;
            dump_fn = av[ai + 1];
        }
        if (av[ai] == "-rc-plan") { want_rc_plan = true; }
        if (av[ai] == "-str-own") { want_str_own = true; }
        if (av[ai] == "-verify") { want_verify = true; }
        if (av[ai] == "-verifystack") { want_vstack = true; }
        if (av[ai] == "-verifyfip") { want_vfip = true; }
        if (av[ai] == "-slots") { want_slots = true; }
        if (av[ai] == "-clocensus") { want_clocensus = true; }
        ai = ai + 1;
    }

    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));

    // `-str-own` (#4297 CS4): print each function's slot-carried string-
    // ownership facts (irlower.str_own_dump) instead of evaluating — the
    // observable surface for the ownership-axis unit gate, format-mirroring
    // `-rc-plan` (one `== <name>` header per function, then the dump lines).
    if (want_str_own) {
        var sout: string = "";
        var sfi: i32 = 0;
        while (sfi < mod.funcs.len()) {
            var skey: string = mod.funcs[sfi].name;
            if (mod.funcs[sfi].receiver_type.len() > 0) {
                skey = util.base_type_name(mod.funcs[sfi].receiver_type) + "." + mod.funcs[sfi].name;
            }
            sout = sout + "== " + skey + "\n";
            sout = sout + irlower.str_own_dump(mod.funcs[sfi], mod.structs, mod.funcs);
            sfi = sfi + 1;
        }
        write(sout);
        return 0;
    }

    if (want_rc_plan) {
        // The pure per-table analyses come from rc_plan_dump; the retain plan
        // (aliasBindIncs) is an EMISSION-time record, so lower the module the
        // way the eval path does and read each function's alias_incs off its
        // LoweredFn. Same funcs order, so the two halves key together.
        var pfns: ir.LoweredFn[] = irlower.lower_module(mod.funcs, mod.structs);
        var out: string = "";
        var fi: i32 = 0;
        while (fi < mod.funcs.len()) {
            var key: string = mod.funcs[fi].name;
            if (mod.funcs[fi].receiver_type.len() > 0) {
                key = util.base_type_name(mod.funcs[fi].receiver_type) + "." + mod.funcs[fi].name;
            }
            out = out + "== " + key + "\n";
            out = out + irlower.rc_plan_dump(mod.funcs[fi], mod.structs, mod.funcs);
            if (fi < pfns.len() && pfns[fi].ok && pfns[fi].alias_incs.len() > 0) {
                // Lexicographic sort, mirroring native sort.Strings.
                var abi: string[] = [];
                var xi: i32 = 0;
                while (xi < pfns[fi].alias_incs.len()) {
                    var entry: string = pfns[fi].alias_incs[xi];
                    var at: i32 = 0;
                    while (at < abi.len() && abi[at] < entry) { at = at + 1; }
                    var ns: string[] = [];
                    var q: i32 = 0;
                    while (q < at) { ns = ns.append(abi[q]); q = q + 1; }
                    ns = ns.append(entry);
                    while (q < abi.len()) { ns = ns.append(abi[q]); q = q + 1; }
                    abi = ns;
                    xi = xi + 1;
                }
                out = out + "aliasBindIncs: ";
                var ao: i32 = 0;
                while (ao < abi.len()) {
                    if (ao > 0) { out = out + ","; }
                    out = out + abi[ao];
                    ao = ao + 1;
                }
                out = out + "\n";
            }
            fi = fi + 1;
        }
        write(out);
        return 0;
    }
    // `-clocensus` (#6638): count this module's closure call sites instead of
    // evaluating. Lowered the way the BACKENDS lower — lift_lambdas (which
    // fills defaults and hoists every capturing lambda to a `$clo` /
    // `__mkclo$` pair) over a builtin-enum-injected struct table, exactly as
    // asm_ir.lift_lambdas does. Lowering the raw module instead would count
    // closure sites that lambda lifting has not created yet.
    if (want_clocensus) {
        var cmod: parser.Module = irlower.lift_lambdas(mod);
        write(clo_census(irlower.lower_module(cmod.funcs, parser.inject_builtin_enums(cmod.structs))));
        return 0;
    }

    var fns: ir.LoweredFn[] = irlower.lower_module(mod.funcs, mod.structs);

    // `-slots` (#6639 slice 1.5): print each lowered function's per-slot value
    // kinds and declared return type — the facts LowerState knows and the op
    // stream alone does not. One `<name> ret=<type> params=<n> locals=<n>`
    // line, then one line per non-empty slot class. The Go-side gate reads it;
    // nothing on the emit path does.
    if (want_slots) {
        var sl: string = "";
        var si: i32 = 0;
        while (si < fns.len()) {
            var f: ir.LoweredFn = fns[si];
            if (f.ok) {
                sl = sl + f.name + " ret=" + f.ret_type
                    + " params=" + util.i32_to_string(f.n_params)
                    + " locals=" + util.i32_to_string(f.n_locals) + "\n";
                sl = sl + slot_line("i64", f.i64_slots);
                sl = sl + slot_line("f64", f.f64_slots);
                sl = sl + slot_line("str", f.str_slots);
                sl = sl + slot_line("arr", f.arr_slots);
            }
            si = si + 1;
        }
        write(sl);
        return 0;
    }

    if (want_verify) {
        // Lower from a defaults-FILLED module. The production backends reach
        // the IR through lift_lambdas, which runs fill_default_args_module
        // first, so `box(1)` against `box(w, h = 2, d = 3)` arrives as
        // `box(1, 2, 3)`. Verifying the raw lower_module output instead would
        // report a 1-arg call to a 3-param callee on every defaulted call in
        // the corpus — a property of this driver's shortcut, not of the IR any
        // backend is handed.
        var vfilled: parser.Module = parser.fill_default_args_module(mod);
        var vfns: ir.LoweredFn[] = irlower.lower_module(vfilled.funcs, mod.structs);
        var probs: irverify.Problem[] = verify_all(vfilled.funcs, vfns);
        if (probs.len() == 0) {
            write("irverify: clean\n");
            return 0;
        }
        write("irverify: " + util.i32_to_string(probs.len()) + " problem(s)"
            + irverify.format_problems(probs, 20) + "\n");
        return 1;
    }

    if (want_vstack) {
        // Same defaults-FILLED module as `-verify`, for the same reason: the
        // production backends reach the IR through lift_lambdas, which runs
        // fill_default_args_module first, so a defaulted call arrives with its
        // arguments already pushed.
        var sfns: ir.LoweredFn[] = irlower.lower_module(parser.fill_default_args_module(mod).funcs, mod.structs);
        var sw: StackSweep = verify_stack_all(sfns);
        if (sw.problems.len() == 0) {
            write("irverifystack: clean (" + irverifystack.coverage_str(sw.cov) + ")\n");
            return 0;
        }
        write("irverifystack: " + util.i32_to_string(sw.problems.len()) + " problem(s) ("
            + irverifystack.coverage_str(sw.cov) + ")"
            + irverify.format_problems(sw.problems, 20) + "\n");
        return 1;
    }

    if (want_vfip) {
        // Same defaults-FILLED module as `-verify`, for the same reason: the
        // production backends reach the IR through lift_lambdas, which runs
        // fill_default_args_module first.
        var ffilled: parser.Module = parser.fill_default_args_module(mod);
        var ffns: ir.LoweredFn[] = irlower.lower_module(ffilled.funcs, mod.structs);
        var fw: FipSweep = verify_fip_all(ffilled.funcs, ffns);
        write(fw.census);
        if (fw.problems.len() == 0) {
            write("irfipverify: clean\n");
            return 0;
        }
        write("irfipverify: " + util.i32_to_string(fw.problems.len()) + " problem(s)"
            + irverify.format_problems(fw.problems, 20) + "\n");
        return 1;
    }

    var wanted: string = "main";
    if (want_dump) { wanted = dump_fn; }
    var mi: i32 = irexec.find_fn(fns, wanted);
    if (mi < 0) { return 201; }
    var mainfn: ir.LoweredFn = fns[mi];
    if (!mainfn.ok) { return 200; }

    if (want_dump) {
        var out: string = "";
        var k: i32 = 0;
        while (k < mainfn.ops.len()) {
            if (k > 0) { out = out + "\n"; }
            out = out + ir.render_op(mainfn.ops[k]);
            k = k + 1;
        }
        print(out);
        return mainfn.ops.len();
    }
    return irexec.eval_program(fns);
}
