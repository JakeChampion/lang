// examples/self_host/wasm_run.fern — stdin-driven driver for the
// self-hosted wasm emitter. Reads Fern source from stdin, runs it
// through lexer + parser + wasm_ir.emit_module_mode_or_error, and prints the
// WASI core module (WAT text) to stdout. Companion to asm_run.fern
// (x86-64) and asm_ir_run.fern (which serves arm64 / arm64-darwin via
// `-target`): the same front end feeding the wasm backend.
//
// The Go-side test (self_host_wasm_test.go) pipes a source program in,
// captures the WAT, and runs it with `wasmtime run prog.wat` — asserting
// the process exit code matches the program's result. End-to-end proof
// that the wasm IR emitter emits runnable WebAssembly.

import "std/io";
import "./lexer";
import "./parser";
import "./asmcore";
import "./wasm_ir";

function main(): i32 {
    // `-decide`: print the ROUTING verdict ("ir" / "ast") instead of emitting.
    // The wasm side had no such probe — its drivers expose only `-ir`, which
    // FORCES the IR path and so bypasses the gates whose declines are exactly
    // what an IR-or-error reroute turns into hard errors. Enumerating those
    // declines from Go test literals does not work either: a test file that
    // mentions a driver does not mean its programs are fed to that driver
    // (self_host_x86_gas_test.go names wasm_run.fern while its programs are
    // x86), so an extraction sweep silently probes the wrong backend. This is
    // the wasm sibling of asm_pathprobe_run / `-ir-probe`.
    var decide: boolean = false;
    var av: string[] = args();
    var ai: i32 = 1;
    while (ai < av.len()) {
        if (av[ai] == "-decide") { decide = true; }
        ai = ai + 1;
    }
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    // Call-arity gate (#4360): an arg-count mismatch used to sail through the
    // wasm emitter and miscompile where the Go compiler rejects with E004.
    // Checked on a default-filled COPY so omitted defaulted args don't read
    // as mismatches; the emit input stays untouched.
    var arity_errs: string = asmcore.check_call_arity(parser.fill_default_args_module(mod));
    // Bare-map_new chain gate (native E038/E003 parity) — same
    // reject-don't-miscompile rationale as the arity gate.
    arity_errs = arity_errs + asmcore.check_map_new_chain(mod);
    // Undefined-callee gate (native E001, #5644): a callee naming nothing
    // otherwise reaches the emitter's generic call path, which emits a call
    // against a symbol nothing defines — an opaque load-time `unknown func`
    // instead of a diagnostic pointing at the source.
    arity_errs = arity_errs + asmcore.check_undefined_calls(mod);
    if (arity_errs.len() > 0) {
        eprint(arity_errs);
        return 1;
    }
    // Builtins with no wasm meaning at all (subprocess #4320, timer_fd #4317).
    // The differential wasm_ir_run driver has rejected these since #4320; this
    // production driver never did, so a timer_fd / subprocess program emitted a
    // WAT calling a symbol nothing defines and failed at load with an opaque
    // `unknown func: failed to find name $timer_fd` instead of a diagnostic
    // naming the feature.
    var unsupported: string = wasm_ir.wasm_unsupported_builtin(mod);
    if (unsupported.len() > 0) {
        eprint(wasm_ir.wasm_unsupported_message(unsupported));
        return 1;
    }
    var mwb: parser.Module = parser.module_with_builtins(mod);
    if (decide) {
        // The same two-halves decision emit_module_mode makes, in its default
        // (non-component) mode — reused from wasm_ir rather than restated, so
        // the probe cannot drift from the emitter it describes.
        var plm: parser.Module = wasm_ir.route_normalized(mwb);
        var pok: boolean = wasm_ir.ir_route_precheck(plm);
        if (pok) { pok = wasm_ir.ir_route_final(wasm_ir.lower_all_for(plm), false, false); }
        if (pok) { print("ir\n"); } else { print("ast\n"); }
        return 0;
    }
    var emitted: string = wasm_ir.emit_module_mode_or_error(mwb, false, false);
    write(emitted);
    return 0;
}
