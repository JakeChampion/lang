// examples/self_host/wasm_run.fern — stdin-driven driver for the
// self-hosted wasm emitter. Reads Fern source from stdin, runs it
// through lexer + parser + wasm.emit_module, and prints the resulting
// WASI core module (WAT text) to stdout. Companion to asm_run.fern
// (x86-64) and asm_ir_run.fern (which serves arm64 / arm64-darwin via
// `-target`): the same front end feeding the wasm backend.
//
// The Go-side test (self_host_wasm_test.go) pipes a source program in,
// captures the WAT, and runs it with `wasmtime run prog.wat` — asserting
// the process exit code matches the program's result. End-to-end proof
// that wasm.fern emits runnable WebAssembly.

import "std/io";
import "./lexer";
import "./parser";
import "./asmcore";
import "./wasm";
import "./wasm_ir";

function main(): i32 {
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    // Call-arity gate (#4360): an arg-count mismatch used to sail through the
    // wasm emitter and miscompile where the Go compiler rejects with E004.
    // Checked on a default-filled COPY so omitted defaulted args don't read
    // as mismatches; the emit input stays untouched.
    var arity_errs: string = asmcore.check_call_arity(parser.fill_default_args_module(mod));
    // Bare-map_new chain gate (native E038/E003 parity) — same
    // reject-don't-miscompile rationale as the arity gate.
    arity_errs = arity_errs + asmcore.check_map_new_chain(mod);
    if (arity_errs.len() > 0) {
        eprint(arity_errs);
        return 1;
    }
    // Builtins with no wasm meaning at all (subprocess #4320, timer_fd #4317).
    // The differential wasm_ir_run driver has rejected these since #4320; this
    // production driver never did, so a timer_fd / subprocess program emitted a
    // WAT calling a symbol nothing defines and failed at load with an opaque
    // `unknown func: failed to find name $timer_fd` instead of a diagnostic
    // naming the feature.
    var unsupported: string = wasm_ir.wasm_unsupported_builtin(mod);
    if (unsupported.len() > 0) {
        eprint(wasm_ir.wasm_unsupported_message(unsupported));
        return 1;
    }
    var emitted: string = wasm.emit_module(parser.module_with_builtins(mod));
    write(emitted);
    return 0;
}
