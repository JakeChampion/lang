// examples/self_host/wasm_run.fern — stdin-driven driver for the
// self-hosted wasm emitter. Reads Fern source from stdin, runs it
// through lexer + parser + wasm.emit_module, and prints the resulting
// WASI core module (WAT text) to stdout. Companion to asm_run.fern
// (x86-64) and asm_arm64_run.fern (arm64): the same front end feeding
// the wasm backend.
//
// The Go-side test (self_host_wasm_test.go) pipes a source program in,
// captures the WAT, and runs it with `wasmtime run prog.wat` — asserting
// the process exit code matches the program's result. End-to-end proof
// that wasm.fern emits runnable WebAssembly.

import "core/no_prelude";
import "std/io";
import "./lexer";
import "./parser";
import "./wasm";

function main(): i32 {
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    var emitted: string = wasm.emit_module(parser.module_with_builtins(mod));
    write(emitted);
    return 0;
}
