// examples/self_host/wit_compose.fern — the self-host world-driven component
// composer (docs/WIT-BRING-YOUR-OWN.md, P2/P3). Given a decoded world's
// type-section body and a user core module, it derives the imports the core
// uses, classifies each against the world, emits the world import prefix
// pruned to those imports (and the ones the world's own aliases depend on),
// and wires the suffix — producing a component scoped to that world. The
// world's type-body may come from an embedded world (wit_proxy_world.fern) or
// a user-supplied WIT (bring-your-own); the path is identical.
//
// Two export shapes: compose_run lifts the core's `_lang_run` as
// wasi:cli/run, and its async exports with the async option; compose_http its `wasi:http/incoming-handler@0.2.0#handle`
// as the incoming-handler interface (`fern -target wasm32-wasi-http`).
//
// A `[resource-drop]<res>` core import is not a function of the interface: it
// lowers to a canon resource.drop, which needs the resource as a component
// type. The world import prefix does not surface one, so each dropped
// resource is aliased out of its imported instance once, right after the
// prefix, and shared by every drop of it (mirror of component.ComposeFromWorld).

import "./util";
import "./watbin";
import "./wit_decode";

// Composed is a composition's outcome: the component bytes, or, when `bytes`
// is empty, why the world could not take the core (an import it does not
// declare). Names the first offending import.
pub struct Composed { bytes: i32[], refused: string }

// WorldWired is the per-import lowering plan for a core against a world, and
// the prefix it composes on: the world imports plus the resource types
// surfaced so far (aliased in the order first met).
struct WorldWired { o: i32[], n_type: i32, n_inst: i32, plan: wit_decode.WitImportPlan, kinds: i32[], insts: i32[], rts: i32[], res_names: string[], res_types: i32[], async_ifaces: string[], async_insts: i32[], refused: string }

function drop_prefix(): string {
  return "[resource-drop]";
}

function is_resource_drop(name: string): boolean {
  let pre: string = drop_prefix();
  if (name.len() <= pre.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < pre.len()) {
    if (name[i] != pre[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// name_from is the tail of `s` from byte `from`.
function name_from(s: string, from: i32): string {
  let bytes: u8[] = [];
  let i: i32 = from;
  while (i < s.len()) {
    bytes = bytes.append(s[i]);
    i = i + 1;
  }
  return string_from_bytes_unchecked(bytes);
}

// surface_resource returns the component type index of resource `res` of the
// world instance `inst`, aliasing it out of the instance on first use.
function surface_resource(w: WorldWired, inst: i32, res: string): (WorldWired, i32) {
  let i: i32 = 0;
  while (i < w.res_names.len()) {
    if (w.res_names[i] == res) {
      return (w, w.res_types[i]);
    }
    i = i + 1;
  }
  let rt: i32 = w.n_type;
  let o: i32[] = watbin.wcat(w.o, watbin.comp_alias_inst_type(inst, res));
  return (WorldWired { ...w, o: o, n_type: rt + 1, res_names: w.res_names.append(res), res_types: w.res_types.append(rt) }, rt);
}

function refuse(w: WorldWired, why: string): WorldWired {
  return WorldWired { ...w, refused: why };
}

// wire_world emits the world import prefix the plan keeps — the exports the
// core imports and the (interface, export) pairs `req_ifaces` / `req_names`
// an export's types need, and what those read — and plans each core import's
// lowering against the world: 0 no-opt, 1 memory, 2 memory + realloc, 3 a
// resource drop (with the surfaced resource type in rts), 4 an async export's
// task.return (with its result valtype in rts), 5 / 6 an async lower, 7 / 8 a
// waitable intrinsic (wire_intrinsic).
function wire_world(tbody: i32[], ci: wit_decode.WitCoreImports, req_ifaces: string[], req_names: string[], asy: watbin.AsyncSurface): WorldWired {
  let ifaces: string[] = req_ifaces;
  let wanted: string[] = req_names;
  let k: i32 = 0;
  while (k < ci.names.len()) {
    if (world_supplied(ci.ifaces[k], ci.names[k])) {
      ifaces = ifaces.append(ci.ifaces[k]);
      wanted = wanted.append(world_name(ci.names[k]));
    }
    k = k + 1;
  }
  let plan: wit_decode.WitImportPlan = wit_decode.wit_import_plan(tbody, ifaces, wanted);
  let o: i32[] = watbin.component_preamble();
  o = watbin.wcat(o, wit_decode.wit_emit_world_imports(tbody, plan));
  let w: WorldWired = WorldWired { o: o, n_type: plan.n_type, n_inst: plan.n_inst, plan: plan, kinds: [], insts: [], rts: [], res_names: [], res_types: [], async_ifaces: [], async_insts: [], refused: "" };
  w = import_async_ifaces(w, tbody, asy.lowers);
  let i: i32 = 0;
  while (i < ci.ifaces.len() && w.refused.len() == 0) {
    w = wire_import(w, tbody, asy, ci.ifaces[i], ci.names[i]);
    i = i + 1;
  }
  return w;
}

// world_supplied reports whether the world supplies the core import `name`
// from `iface`. A task.return, a waitable intrinsic and an async lower are
// the component's own.
function world_supplied(iface: string, name: string): boolean {
  return iface != task_return_iface() && iface != intrinsic_iface() && !is_async_lower(name);
}

function intrinsic_iface(): string {
  return "$root";
}

function is_async_lower(name: string): boolean {
  return watbin.lowered_name(name) != name;
}

// import_async_ifaces imports each interface the async imports `lowers` name,
// as an instance of an async func per import: the world does not declare it,
// so the component does.
function import_async_ifaces(w: WorldWired, tbody: i32[], lowers: watbin.AsyncLower[]): WorldWired {
  for l in lowers {
    if (!util.has_str(w.async_ifaces, l.iface)) {
      if (wit_decode.wit_world_declares(tbody, l.iface)) {
        return refuse(w, "async import from " + l.iface + ", an interface the world declares");
      }
      let mine: watbin.AsyncLower[] = [];
      for m in lowers {
        if (m.iface == l.iface) {
          mine = mine.append(m);
        }
      }
      let o: i32[] = watbin.wcat(w.o, watbin.comp_type_async_instance(mine));
      o = watbin.wcat(o, watbin.comp_import_instance(l.iface, w.n_type));
      w = WorldWired { ...w, o: o, n_type: w.n_type + 1, n_inst: w.n_inst + 1, async_ifaces: w.async_ifaces.append(l.iface), async_insts: w.async_insts.append(w.n_inst) };
    }
  }
  return w;
}

// world_name is the world export a core import `name` needs: the resource
// itself for a resource drop, else the function.
function world_name(name: string): string {
  if (is_resource_drop(name)) {
    return name_from(name, drop_prefix().len());
  }
  return name;
}

// wire_import plans the lowering of the core import `name` from `iface`.
function wire_import(w: WorldWired, tbody: i32[], asy: watbin.AsyncSurface, iface: string, name: string): WorldWired {
  if (iface == intrinsic_iface()) {
    return wire_intrinsic(w, name);
  }
  if (is_async_lower(name)) {
    return wire_async_lower(w, asy.lowers, iface, name);
  }
  if (iface == task_return_iface()) {
    let vt: i32 = task_return_result(asy.lifts, name);
    if (vt < 0 - 1) {
      return refuse(w, "core imports " + name + " from " + iface + " for no async export");
    }
    return WorldWired { ...w, kinds: w.kinds.append(4), insts: w.insts.append(0), rts: w.rts.append(vt) };
  }
  let inst: i32 = wit_decode.wit_import_instance_index(tbody, w.plan, iface);
  if (inst < 0) {
    return refuse(w, "core imports interface " + iface + " not declared by the world");
  }
  let kind: i32 = 0;
  let rt: i32 = 0;
  if (is_resource_drop(name)) {
    let res: string = name_from(name, drop_prefix().len());
    if (!wit_decode.wit_iface_has_resource(tbody, iface, res)) {
      return refuse(w, "world interface " + iface + " has no resource " + res + " to drop");
    }
    let (w2, rt2) = surface_resource(w, inst, res);
    w = w2;
    rt = rt2;
    kind = 3;
  } else {
    if (!wit_decode.wit_iface_func_lookup(tbody, iface, name).found) {
      return refuse(w, "interface " + iface + " has no function " + name);
    }
    kind = wit_decode.wit_classify(tbody, iface, name);
  }
  return WorldWired { ...w, kinds: w.kinds.append(kind), insts: w.insts.append(inst), rts: w.rts.append(rt) };
}

// wire_intrinsic plans a waitable intrinsic: waitable-set.wait writes its
// event into the user module's memory, so is trampolined (kind 7); the rest
// are operand-free canons (kind 8, the opcode in rts).
function wire_intrinsic(w: WorldWired, name: string): WorldWired {
  if (name == "[waitable-set-wait]") {
    return WorldWired { ...w, kinds: w.kinds.append(7), insts: w.insts.append(0), rts: w.rts.append(0) };
  }
  let names: string[] = ["[waitable-set-new]", "[waitable-join]", "[subtask-drop]", "[waitable-set-drop]"];
  let ops: i32[] = [31, 35, 13, 34];
  let j: i32 = 0;
  while (j < names.len()) {
    if (names[j] == name) {
      return WorldWired { ...w, kinds: w.kinds.append(8), insts: w.insts.append(0), rts: w.rts.append(ops[j]) };
    }
    j = j + 1;
  }
  return refuse(w, "core imports " + name + " from " + intrinsic_iface() + ", which is no intrinsic the composer supplies");
}

// wire_async_lower plans the async lower of an import of the interface
// import_async_ifaces imported: kind 6, with the realloc, when the host
// writes a string or list result into the module's memory, else kind 5.
function wire_async_lower(w: WorldWired, lowers: watbin.AsyncLower[], iface: string, name: string): WorldWired {
  let j: i32 = 0;
  while (j < w.async_ifaces.len()) {
    if (w.async_ifaces[j] == iface) {
      let kind: i32 = 5;
      if (lower_result_in_memory(lowers, iface, watbin.lowered_name(name))) {
        kind = 6;
      }
      return WorldWired { ...w, kinds: w.kinds.append(kind), insts: w.insts.append(w.async_insts[j]), rts: w.rts.append(0) };
    }
    j = j + 1;
  }
  return refuse(w, "core imports " + name + " from " + iface + " for no async import");
}

// lower_result_in_memory reports whether async import `name` of `iface`
// returns a string (0x73) or a list (a 0x70 defined type).
function lower_result_in_memory(lowers: watbin.AsyncLower[], iface: string, name: string): boolean {
  for l in lowers {
    if (l.iface == iface && l.name == name && l.result.len() > 0) {
      return l.result[0] == 115 || l.result[0] == 112;
    }
  }
  return false;
}

// task_return_iface is the core import module an async export's task.return
// comes from (wasm_ir.async_lift_imports).
function task_return_iface(): string {
  return "[export]$root";
}

// task_return_result is the result valtype of the async export whose
// task.return the core imports as `name` (-1 for none), or -2 when no async
// export has that name.
function task_return_result(lifts: watbin.AsyncLift[], name: string): i32 {
  for l in lifts {
    if ("[task-return]" + l.core_name == name && l.result.len() == 0) {
      return 0 - 1;
    }
    if ("[task-return]" + l.core_name == name) {
      return l.result[0];
    }
  }
  return 0 - 2;
}

// compose_run composes `core` — a command exporting `_lang_run` — into a
// wasi:cli/run component of the world, also exporting the async exports of
// `asy` and importing the interfaces its async imports name.
pub function compose_run(tbody: i32[], core: i32[], asy: watbin.AsyncSurface): Composed {
  let ci: wit_decode.WitCoreImports = wit_decode.wit_core_func_imports(core);
  let w: WorldWired = wire_world(tbody, ci, [], [], asy);
  if (w.refused.len() > 0) {
    return Composed { bytes: [], refused: w.refused };
  }
  let o: i32[] = watbin.wcat(w.o, watbin.comp_core_module_section(core));
  o = watbin.wcat(o, watbin.component_suffix(ci.ifaces, ci.names, w.kinds, w.insts, ci.params, ci.results, w.rts, w.n_type, w.n_inst, 0, "_lang_run", asy.lifts));
  return Composed { bytes: o, refused: "" };
}

// component_from_world is compose_run's bytes, empty on refusal.
pub function component_from_world(tbody: i32[], core: i32[]): i32[] {
  return compose_run(tbody, core, watbin.AsyncSurface { lifts: [], lowers: [] }).bytes;
}

// compose_http composes `core` — a reactor exporting
// `wasi:http/incoming-handler@0.2.0#handle` — into a component of the world
// that exports wasi:http/incoming-handler. The world must import
// wasi:http/types, whose incoming-request and response-outparam resources
// type the export.
pub function compose_http(tbody: i32[], core: i32[]): Composed {
  let ci: wit_decode.WitCoreImports = wit_decode.wit_core_func_imports(core);
  let http_iface: string = "wasi:http/types@0.2.0";
  let w: WorldWired = wire_world(tbody, ci, [http_iface, http_iface], ["incoming-request", "response-outparam"], watbin.AsyncSurface { lifts: [], lowers: [] });
  if (w.refused.len() > 0) {
    return Composed { bytes: [], refused: w.refused };
  }
  let http_inst: i32 = wit_decode.wit_import_instance_index(tbody, w.plan, http_iface);
  if (http_inst < 0) {
    return Composed { bytes: [], refused: "world does not import " + http_iface };
  }
  let (w2, req_t) = surface_resource(w, http_inst, "incoming-request");
  let (w3, out_t) = surface_resource(w2, http_inst, "response-outparam");
  let o: i32[] = watbin.wcat(w3.o, watbin.comp_core_module_section(core));
  o = watbin.wcat(o, watbin.component_suffix_http(ci.ifaces, ci.names, w3.kinds, w3.insts, ci.params, ci.results, w3.rts, w3.n_type, w3.n_inst, 0, req_t, out_t));
  return Composed { bytes: o, refused: "" };
}
