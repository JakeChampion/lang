// examples/self_host/asm_arm64_darwin_run.fern — stdin-driven driver
// that emits the arm64-apple-darwin assembler TEXT (the GAS dialect:
// @PAGE/@PAGEOFF addressing, _main entry, BSD syscalls). Reads Fern
// source from stdin, runs it through lexer + parser +
// asm_arm64.emit_module(darwin=true) + asm_arm64.darwinize, and prints
// the resulting assembly to stdout.
//
// Companion to asm_arm64_run.fern (Linux ELF asm). It exists so tests
// can obtain the darwin GAS text on its own: the unified `fern` CLI's
// `-target arm64-darwin` no longer emits text — it assembles + links the
// Mach-O binary in-process via arm64_native — so this driver is how the
// arm64_native assembler tests (which feed real darwin text to
// arm64_gas_program) get their input.

import "std/io";
import "./lexer";
import "./parser";
import "./asm_arm64";

function main(): i32 {
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    var emitted: string = asm_arm64.darwinize(asm_arm64.emit_module(parser.module_with_builtins(mod), true));
    print(emitted);
    return 0;
}
