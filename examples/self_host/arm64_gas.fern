// examples/self_host/arm64_gas.fern — a self-hosted AArch64 GAS-text
// assembler: it parses an assembly-text subset into machine-code bytes via
// the arm64_encode.fern encoders + named-label assembler (Arm64Asm). It is
// the arm64 counterpart of x86_gas.fern and the text->bytes step that lets
// the arm64-darwin native path turn `asm_arm64`-style assembly into a
// runnable Mach-O (via macho.fern) with no external `as`/`clang`.
//
// This module `import`s nothing but depends on the names defined in
// arm64_encode.fern (the encoders + Arm64Asm), so a build / test
// concatenates the two (plus macho.fern) the same way the x86 gas slices
// concatenate x86_encode.fern.
//
// Supported subset (the canonical AArch64 GAS spellings):
//   mov Xd, #imm | mov Xd, Xm | movz/movk Xd, #imm{, lsl #s}
//   add/sub Xd, Xn, #imm | add/sub Xd, Xn, Xm
//   cmp Xn, #imm | cmp Xn, Xm
//   ldr/str Xt, [Xn{, #off}]
//   b/bl <label> | b.<cond> <label> | cbz/cbnz Xt, <label>
//   svc #imm | ret
// Directives: .text (others ignored); `name:` labels; `//` line comments.

// ---- text helpers ----

// arm64_gas_trim strips leading/trailing ASCII spaces and tabs.
function arm64_gas_trim(s: string): string {
    var i: i32 = 0;
    while (i < s.len() && (s[i] == 32 || s[i] == 9)) {
        i = i + 1;
    }
    var j: i32 = s.len();
    while (j > i && (s[j - 1] == 32 || s[j - 1] == 9)) {
        j = j - 1;
    }
    return s[i:j];
}

// arm64_gas_atoi parses a signed integer token: optional '-', decimal or
// `0x…` hex. Two's-complement wrap gives the right bits for negatives.
function arm64_gas_atoi(tok: string): i32 {
    var s: string = tok;
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == 45) { // '-'
        neg = true;
        i = 1;
    }
    var v: i32 = 0;
    if (i + 1 < s.len() && s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)) { // 0x
        i = i + 2;
        while (i < s.len()) {
            var c: i32 = s[i];
            var d: i32 = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else { if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else { if (c >= 65 && c <= 70) { d = c - 65 + 10; } } }
            if (d >= 0) { v = v * 16 + d; }
            i = i + 1;
        }
    } else {
        while (i < s.len()) {
            var c2: i32 = s[i];
            if (c2 >= 48 && c2 <= 57) { v = v * 10 + (c2 - 48); }
            i = i + 1;
        }
    }
    if (neg) {
        return 0 - v;
    }
    return v;
}

// arm64_gas_imm parses an immediate operand `#N` (decimal or 0x hex,
// optional '-'); the leading '#' is dropped.
function arm64_gas_imm(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (s.len() > 0 && s[0] == 35) { // '#'
        s = s[1:s.len()];
    }
    return arm64_gas_atoi(s);
}

// arm64_gas_reg parses a register token: x0..x30, plus the aliases sp / lr
// / xzr (and the w… 32-bit names map to the same number). Defaults to 0.
function arm64_gas_reg(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (s == "sp") { return 31; }
    if (s == "xzr" || s == "wzr") { return 31; }
    if (s == "lr") { return 30; }
    if (s.len() >= 2 && (s[0] == 120 || s[0] == 119)) { // 'x' / 'w'
        return arm64_gas_atoi(s[1:s.len()]);
    }
    return 0;
}

// arm64_gas_cond maps a condition suffix (the `eq` in `b.eq`) to its 4-bit
// code, matching arm64_encode's arm64_eq/ne/ge/lt/gt/le.
function arm64_gas_cond(s: string): i32 {
    if (s == "eq") { return 0; }
    if (s == "ne") { return 1; }
    if (s == "cs" || s == "hs") { return 2; }  // carry set / unsigned >=
    if (s == "cc" || s == "lo") { return 3; }  // carry clear / unsigned <
    if (s == "mi") { return 4; }               // negative
    if (s == "pl") { return 5; }               // non-negative
    if (s == "vs") { return 6; }               // overflow set
    if (s == "vc") { return 7; }               // overflow clear
    if (s == "hi") { return 8; }               // unsigned >
    if (s == "ls") { return 9; }               // unsigned <=
    if (s == "ge") { return 10; }
    if (s == "lt") { return 11; }
    if (s == "gt") { return 12; }
    if (s == "le") { return 13; }
    if (s == "al") { return 14; }              // always
    return 0;
}

// arm64_gas_is_cond reports whether a 2-letter suffix is a condition code
// (so `b<cc>` no-dot aliases like bhi/blt/bne can be told from b/bl/br).
function arm64_gas_is_cond(s: string): boolean {
    return s == "eq" || s == "ne" || s == "cs" || s == "hs" || s == "cc" || s == "lo"
        || s == "mi" || s == "pl" || s == "vs" || s == "vc" || s == "hi" || s == "ls"
        || s == "ge" || s == "lt" || s == "gt" || s == "le" || s == "al";
}

// arm64_gas_is_w reports whether a register token names a 32-bit w-register.
function arm64_gas_is_w(tok: string): boolean {
    var s: string = arm64_gas_trim(tok);
    return s.len() >= 1 && s[0] == 119; // 'w'
}

// arm64_gas_operands splits an operand list on top-level commas, ignoring
// commas inside `[ … ]` (so a memory operand stays one token).
function arm64_gas_operands(rest: string): string[] {
    var out: string[] = [];
    var depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < rest.len()) {
        var c: i32 = rest[i];
        if (c == 91) { depth = depth + 1; }        // '['
        else if (c == 93) { depth = depth - 1; }   // ']'
        else if (c == 44 && depth == 0) {           // ','
            out = out.append(arm64_gas_trim(rest[start:i]));
            start = i + 1;
        }
        i = i + 1;
    }
    var last: string = arm64_gas_trim(rest[start:rest.len()]);
    if (last.len() > 0) {
        out = out.append(last);
    }
    return out;
}

// Arm64Mem is a parsed `[Xn{, #off}]` memory operand.
struct Arm64Mem {
    base: i32,
    off: i32,
}

// arm64_gas_mem parses `[Xn]` or `[Xn, #off]`, tolerating a trailing `!`
// (pre-index writeback marker — detect it separately with
// arm64_gas_has_bang).
function arm64_gas_mem(op: string): Arm64Mem {
    var s: string = arm64_gas_trim(op);
    var lb: i32 = s.index_of("[");
    var rb: i32 = s.index_of("]");
    var inner: string = s;
    if (lb >= 0 && rb > lb) {
        inner = s[lb + 1:rb];
    }
    var parts: string[] = arm64_gas_operands(inner);
    var base: i32 = arm64_gas_reg(parts[0]);
    var off: i32 = 0;
    if (parts.len() > 1) {
        off = arm64_gas_imm(parts[1]);
    }
    return Arm64Mem { base: base, off: off };
}

// arm64_gas_has_bang reports whether an operand carries the `!` pre-index
// writeback marker.
function arm64_gas_has_bang(op: string): boolean {
    return op.index_of("!") >= 0;
}

// arm64_gas_lsl_amount parses a `lsl #N` shift operand (the `lsl #16` of a
// movk); returns 0 if it is not recognised.
function arm64_gas_lsl_amount(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    var h: i32 = s.index_of("#");
    if (h < 0) {
        return 0;
    }
    return arm64_gas_atoi(arm64_gas_trim(s[h + 1:s.len()]));
}

// ---- instruction dispatch ----

// arm64_gas_emit assembles one mnemonic + operand string into a.code (or
// queues a label fixup). Unknown mnemonics are ignored.
function arm64_gas_emit(a: Arm64Asm, mnem: string, rest: string): Arm64Asm {
    if (mnem == "ret") {
        a.code = arm64_ret(a.code, arm64_lr());
        return a;
    }
    var ops: string[] = arm64_gas_operands(rest);
    if (mnem == "svc") {
        a.code = arm64_svc(a.code, arm64_gas_imm(ops[0]));
        return a;
    }
    if (mnem == "b") {
        return arm64_asm_b(a, ops[0]);
    }
    if (mnem == "bl") {
        return arm64_asm_bl(a, ops[0]);
    }
    if (mnem == "cbz") {
        return arm64_asm_cbz(a, arm64_gas_reg(ops[0]), ops[1]);
    }
    if (mnem == "cbnz") {
        return arm64_asm_cbnz(a, arm64_gas_reg(ops[0]), ops[1]);
    }
    // b.<cond>
    if (mnem.len() >= 3 && mnem[0] == 98 && mnem[1] == 46) { // 'b' '.'
        return arm64_asm_bcond(a, arm64_gas_cond(mnem[2:mnem.len()]), ops[0]);
    }
    // b<cond> (no-dot GAS alias: bhi / blt / bne / …)
    if (mnem.len() == 3 && mnem[0] == 98 && arm64_gas_is_cond(mnem[1:3])) {
        return arm64_asm_bcond(a, arm64_gas_cond(mnem[1:3]), ops[0]);
    }
    if (mnem == "mov" || mnem == "movz") {
        var rd: i32 = arm64_gas_reg(ops[0]);
        if (ops[1].len() > 0 && ops[1][0] == 35) { // '#'
            a.code = arm64_movz(a.code, rd, arm64_gas_imm(ops[1]), 0);
        } else if (arm64_gas_trim(ops[0]) == "sp" || arm64_gas_trim(ops[1]) == "sp") {
            // `mov Xd, sp` / `mov sp, Xn` is the `add Xd, Xn, #0` alias
            // (ORR can't name SP).
            a.code = arm64_addimm(a.code, rd, arm64_gas_reg(ops[1]), 0);
        } else {
            a.code = arm64_movreg(a.code, rd, arm64_gas_reg(ops[1]));
        }
        return a;
    }
    if (mnem == "movk") {
        var sh: i32 = 0;
        if (ops.len() > 2) {
            sh = arm64_gas_lsl_amount(ops[2]);
        }
        a.code = arm64_movk(a.code, arm64_gas_reg(ops[0]), arm64_gas_imm(ops[1]), sh);
        return a;
    }
    if (mnem == "add") {
        var ad: i32 = arm64_gas_reg(ops[0]);
        var an: i32 = arm64_gas_reg(ops[1]);
        if (ops[2].len() > 0 && ops[2][0] == 35) {
            a.code = arm64_addimm(a.code, ad, an, arm64_gas_imm(ops[2]));
        } else {
            a.code = arm64_addreg(a.code, ad, an, arm64_gas_reg(ops[2]));
        }
        return a;
    }
    if (mnem == "sub") {
        var sd: i32 = arm64_gas_reg(ops[0]);
        var sn: i32 = arm64_gas_reg(ops[1]);
        if (ops[2].len() > 0 && ops[2][0] == 35) {
            a.code = arm64_subimm(a.code, sd, sn, arm64_gas_imm(ops[2]));
        } else {
            a.code = arm64_subreg(a.code, sd, sn, arm64_gas_reg(ops[2]));
        }
        return a;
    }
    if (mnem == "cmp") {
        var cn: i32 = arm64_gas_reg(ops[0]);
        if (ops[1].len() > 0 && ops[1][0] == 35) {
            a.code = arm64_cmpimm(a.code, cn, arm64_gas_imm(ops[1]));
        } else {
            a.code = arm64_cmpreg(a.code, cn, arm64_gas_reg(ops[1]));
        }
        return a;
    }
    if (mnem == "ldr" || mnem == "str") {
        var rt: i32 = arm64_gas_reg(ops[0]);
        if (ops.len() >= 3) {
            // post-index: `ldr Xt, [Xn], #off` (ops[1]="[Xn]", ops[2]="#off")
            var pb: i32 = arm64_gas_mem(ops[1]).base;
            var po: i32 = arm64_gas_imm(ops[2]);
            if (mnem == "ldr") { a.code = arm64_ldr_post(a.code, rt, pb, po); }
            else { a.code = arm64_str_post(a.code, rt, pb, po); }
            return a;
        }
        var m: Arm64Mem = arm64_gas_mem(ops[1]);
        if (arm64_gas_has_bang(ops[1])) {
            // pre-index writeback: `[Xn, #off]!`
            if (mnem == "ldr") { a.code = arm64_ldr_pre(a.code, rt, m.base, m.off); }
            else { a.code = arm64_str_pre(a.code, rt, m.base, m.off); }
        } else {
            if (mnem == "ldr") { a.code = arm64_ldr(a.code, rt, m.base, m.off); }
            else { a.code = arm64_str(a.code, rt, m.base, m.off); }
        }
        return a;
    }
    if (mnem == "stp") {
        // prologue form: `stp Xt, Xt2, [Xn, #off]!` (pre-index)
        var sm: Arm64Mem = arm64_gas_mem(ops[2]);
        a.code = arm64_stp_pre(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), sm.base, sm.off);
        return a;
    }
    if (mnem == "ldp") {
        // epilogue form: `ldp Xt, Xt2, [Xn], #off` (post-index)
        var lb: i32 = arm64_gas_mem(ops[2]).base;
        var lo: i32 = arm64_gas_imm(ops[3]);
        a.code = arm64_ldp_post(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), lb, lo);
        return a;
    }
    if (mnem == "neg") {
        a.code = arm64_neg(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]));
        return a;
    }
    if (mnem == "ubfx") {
        a.code = arm64_ubfx(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_imm(ops[3]));
        return a;
    }
    if (mnem == "tbnz") {
        return arm64_asm_tbnz(a, arm64_gas_reg(ops[0]), arm64_gas_imm(ops[1]), ops[2]);
    }
    if (mnem == "tbz") {
        return arm64_asm_tbz(a, arm64_gas_reg(ops[0]), arm64_gas_imm(ops[1]), ops[2]);
    }
    if (mnem == "mul") {
        a.code = arm64_mul(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]));
        return a;
    }
    if (mnem == "ldur") {
        var um: Arm64Mem = arm64_gas_mem(ops[1]);
        a.code = arm64_ldur(a.code, arm64_gas_reg(ops[0]), um.base, um.off);
        return a;
    }
    if (mnem == "stur") {
        var sm2: Arm64Mem = arm64_gas_mem(ops[1]);
        a.code = arm64_stur(a.code, arm64_gas_reg(ops[0]), sm2.base, sm2.off);
        return a;
    }
    if (mnem == "cset") {
        a.code = arm64_cset(a.code, arm64_gas_reg(ops[0]), arm64_gas_cond(ops[1]));
        return a;
    }
    if (mnem == "lsl") {
        a.code = arm64_lsl_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0]));
        return a;
    }
    if (mnem == "lsr") {
        a.code = arm64_lsr_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0]));
        return a;
    }
    if (mnem == "cmn") {
        a.code = arm64_cmn_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_imm(ops[1]));
        return a;
    }
    if (mnem == "csel") {
        a.code = arm64_csel(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_cond(ops[3]));
        return a;
    }
    if (mnem == "and") {
        // register form only here; `and Xd, Xn, #imm` is handled in the
        // program loop (it needs the unknown-immediate guard).
        a.code = arm64_andreg(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]));
        return a;
    }
    return a; // unknown mnemonic — ignored
}

// ============================================================
// data section + named-symbol (@PAGE/@PAGEOFF) relocation
// ============================================================
//
// Arm64GasProg extends the text assembler (Arm64Asm) with a `__DATA`/
// `__const` blob, a data-symbol table (name -> offset within the blob),
// and a queue of page fixups: adrp `sym@PAGE` and ldr/add `sym@PAGEOFF`
// references whose immediates can only be resolved once the final segment
// addresses are known (macho.fern lays __TEXT and __DATA at separate
// page-aligned vaddrs). arm64_gas_program parses; arm64_gas_link patches.

struct Arm64GasProg {
    asm: Arm64Asm,
    data: i32[],
    dlab_names: string[],
    dlab_offs: i32[],
    pf_sites: i32[],    // byte offset of the instruction to patch in .text
    pf_syms: string[],  // target data symbol
    pf_kinds: i32[],    // 0 = adrp@PAGE, 1 = ldr@PAGEOFF, 2 = add@PAGEOFF
    unknown: string[],  // mnemonics the assembler did not recognise
}

function arm64_gas_prog_new(): Arm64GasProg {
    return Arm64GasProg {
        asm: arm64_asm_new(), data: [],
        dlab_names: [], dlab_offs: [],
        pf_sites: [], pf_syms: [], pf_kinds: [],
        unknown: [],
    };
}

// arm64_gas_known reports whether a mnemonic is handled by the assembler
// (so the program loop can record anything silently dropped). adrp / and
// the @PAGEOFF forms of ldr / add are handled in the program loop itself.
function arm64_gas_known(mnem: string): boolean {
    if (mnem == "mov" || mnem == "movz" || mnem == "movk" || mnem == "movn") { return true; }
    if (mnem == "add" || mnem == "sub" || mnem == "cmp" || mnem == "neg" || mnem == "mul") { return true; }
    if (mnem == "ldr" || mnem == "str" || mnem == "ldur" || mnem == "stur") { return true; }
    if (mnem == "stp" || mnem == "ldp") { return true; }
    if (mnem == "b" || mnem == "bl" || mnem == "ret" || mnem == "svc") { return true; }
    if (mnem == "cbz" || mnem == "cbnz" || mnem == "tbz" || mnem == "tbnz") { return true; }
    if (mnem == "ubfx" || mnem == "cset" || mnem == "adrp") { return true; }
    if (mnem == "lsl" || mnem == "lsr" || mnem == "cmn" || mnem == "csel" || mnem == "and") { return true; }
    if (mnem.len() >= 3 && mnem[0] == 98 && mnem[1] == 46) { return true; } // b.<cond>
    if (mnem.len() == 3 && mnem[0] == 98 && arm64_gas_is_cond(mnem[1:3])) { return true; } // b<cond>
    return false;
}

// arm64_gas_dlabel_off returns the data-blob offset of a data symbol, or
// -1 if it is not defined.
function arm64_gas_dlabel_off(p: Arm64GasProg, name: string): i32 {
    var i: i32 = 0;
    while (i < p.dlab_names.len()) {
        if (p.dlab_names[i] == name) {
            return p.dlab_offs[i];
        }
        i = i + 1;
    }
    return 0 - 1;
}

// arm64_gas_strip_at returns the symbol portion of a `sym@PAGE` /
// `sym@PAGEOFF` operand (everything before the '@'), trimmed.
function arm64_gas_strip_at(tok: string): string {
    var s: string = arm64_gas_trim(tok);
    var at: i32 = s.index_of("@");
    if (at >= 0) {
        s = s[0:at];
    }
    return arm64_gas_trim(s);
}

// arm64_gas_data_le appends `n` little-endian bytes of `v` to the data blob.
function arm64_gas_data_le(p: Arm64GasProg, v: i64, n: i32): Arm64GasProg {
    var i: i32 = 0;
    while (i < n) {
        p.data = p.data.append(((v >> (i * 8)) & 255) as i32);
        i = i + 1;
    }
    return p;
}

// arm64_gas_data_asciz appends a `.asciz "…"` string + NUL to the data
// blob, decoding the common \n \t \0 \\ escapes.
function arm64_gas_data_asciz(p: Arm64GasProg, line: string): Arm64GasProg {
    var q1: i32 = line.index_of("\"");
    if (q1 < 0) {
        p.data = p.data.append(0);
        return p;
    }
    var i: i32 = q1 + 1;
    while (i < line.len() && line[i] != 34) { // until closing '"'
        var c: i32 = line[i];
        if (c == 92 && i + 1 < line.len()) { // '\'
            var e: i32 = line[i + 1];
            if (e == 110) { c = 10; }       // \n
            else if (e == 116) { c = 9; }   // \t
            else if (e == 48) { c = 0; }    // \0
            else { c = e; }                 // \\ , \"
            i = i + 1;
        }
        p.data = p.data.append(c);
        i = i + 1;
    }
    p.data = p.data.append(0); // .asciz NUL terminator
    return p;
}

// arm64_gas_data_align pads the data blob to a 2^n byte boundary.
function arm64_gas_data_align(p: Arm64GasProg, n: i32): Arm64GasProg {
    var a: i32 = 1;
    var k: i32 = 0;
    while (k < n) { a = a * 2; k = k + 1; }
    while ((p.data.len() % a) != 0) {
        p.data = p.data.append(0);
    }
    return p;
}

// arm64_gas_data_directive handles a `.`-directive inside a data section.
function arm64_gas_data_directive(p: Arm64GasProg, line: string): Arm64GasProg {
    if (line.starts_with(".quad")) {
        return arm64_gas_data_le(p, arm64_gas_atoi(arm64_gas_trim(line[5:line.len()])) as i64, 8);
    }
    if (line.starts_with(".4byte") || line.starts_with(".word")) {
        var off: i32 = 6;
        if (line.starts_with(".word")) { off = 5; }
        return arm64_gas_data_le(p, arm64_gas_atoi(arm64_gas_trim(line[off:line.len()])) as i64, 4);
    }
    if (line.starts_with(".byte")) {
        return arm64_gas_data_le(p, arm64_gas_atoi(arm64_gas_trim(line[5:line.len()])) as i64, 1);
    }
    if (line.starts_with(".asciz") || line.starts_with(".string")) {
        return arm64_gas_data_asciz(p, line);
    }
    if (line.starts_with(".align") || line.starts_with(".p2align") || line.starts_with(".balign")) {
        var sp: i32 = line.index_of(" ");
        if (sp >= 0) {
            return arm64_gas_data_align(p, arm64_gas_atoi(arm64_gas_trim(line[sp + 1:line.len()])));
        }
    }
    return p; // other directives ignored
}

// ---- the assemble loop ----

// arm64_gas_program parses a GAS-text program (one statement per line)
// into an Arm64GasProg: .text code (forward branches resolved), a data
// blob, a data-symbol table, and a queue of @PAGE/@PAGEOFF fixups (left
// for arm64_gas_link). The first .text label must sit at offset 0, since
// macho.fern enters at the first text byte.
function arm64_gas_program(src: string): Arm64GasProg {
    var p: Arm64GasProg = arm64_gas_prog_new();
    var section: i32 = 0; // 0 = .text, 1 = data (__const / __data)
    var lines: string[] = src.split("\n");
    var li: i32 = 0;
    while (li < lines.len()) {
        var raw: string = lines[li];
        li = li + 1;
        var cm: i32 = raw.index_of("//");
        if (cm >= 0) {
            raw = raw[0:cm];
        }
        var line: string = arm64_gas_trim(raw);
        if (line.len() == 0) {
            continue;
        }
        // label prefix `name:`
        var colon: i32 = line.index_of(":");
        if (colon > 0) {
            var before: string = line[0:colon];
            if (before.index_of(" ") < 0 && before.index_of(",") < 0) {
                if (section == 1) {
                    p.dlab_names = p.dlab_names.append(before);
                    p.dlab_offs = p.dlab_offs.append(p.data.len());
                } else {
                    p.asm = arm64_asm_label(p.asm, before);
                }
                line = arm64_gas_trim(line[colon + 1:line.len()]);
                if (line.len() == 0) {
                    continue;
                }
            }
        }
        // directives
        if (line[0] == 46) { // '.'
            if (line == ".text") {
                section = 0;
            } else if (line.starts_with(".section")) {
                if (line.contains("__const") || line.contains("__DATA") || line.contains(".data") || line.contains(".rodata")) {
                    section = 1;
                } else {
                    section = 0;
                }
            } else if (line.starts_with(".data")) {
                section = 1;
            } else if (section == 1) {
                p = arm64_gas_data_directive(p, line);
            }
            continue;
        }
        // mnemonic + operands
        var sp: i32 = line.index_of(" ");
        var mnem: string = line;
        var rest: string = "";
        if (sp >= 0) {
            mnem = line[0:sp];
            rest = arm64_gas_trim(line[sp + 1:line.len()]);
        }
        // @PAGE / @PAGEOFF symbol references queue a fixup; everything else
        // assembles directly into .text.
        if (mnem == "adrp") {
            var aops: string[] = arm64_gas_operands(rest);
            var aas: Arm64Asm = p.asm;
            aas.code = arm64_adrp(aas.code, arm64_gas_reg(aops[0]), 0);
            p.asm = aas;
            p.pf_sites = p.pf_sites.append(aas.code.len() - 4);
            p.pf_syms = p.pf_syms.append(arm64_gas_strip_at(aops[1]));
            p.pf_kinds = p.pf_kinds.append(0);
            continue;
        }
        if (mnem == "ldr" && rest.index_of("@PAGEOFF") >= 0) {
            var lops: string[] = arm64_gas_operands(rest);
            var lm: Arm64Mem = arm64_gas_mem(lops[1]); // base reg; off symbolic
            // symbol is the bracket's second operand, before '@'
            var linner: string = lops[1];
            var lb: i32 = linner.index_of("[");
            var rb: i32 = linner.index_of("]");
            var lparts: string[] = arm64_gas_operands(linner[lb + 1:rb]);
            var las: Arm64Asm = p.asm;
            las.code = arm64_ldr(las.code, arm64_gas_reg(lops[0]), lm.base, 0);
            p.asm = las;
            p.pf_sites = p.pf_sites.append(las.code.len() - 4);
            p.pf_syms = p.pf_syms.append(arm64_gas_strip_at(lparts[1]));
            p.pf_kinds = p.pf_kinds.append(1);
            continue;
        }
        if (mnem == "add" && rest.index_of("@PAGEOFF") >= 0) {
            var dops: string[] = arm64_gas_operands(rest);
            var das: Arm64Asm = p.asm;
            das.code = arm64_addimm(das.code, arm64_gas_reg(dops[0]), arm64_gas_reg(dops[1]), 0);
            p.asm = das;
            p.pf_sites = p.pf_sites.append(das.code.len() - 4);
            p.pf_syms = p.pf_syms.append(arm64_gas_strip_at(dops[2]));
            p.pf_kinds = p.pf_kinds.append(2);
            continue;
        }
        // `and Xd, Xn, #imm` (logical immediate) needs a verified bitmask
        // encoding; an unsupported immediate is recorded (never silently
        // mis-encoded). Register-form `and` falls through to emit.
        if (mnem == "and" && rest.index_of("#") >= 0) {
            var nops: string[] = arm64_gas_operands(rest);
            var nimm: i32 = arm64_gas_imm(nops[2]);
            if (arm64_and_imm_ok(nimm)) {
                var aand: Arm64Asm = p.asm;
                aand.code = arm64_and_imm(aand.code, arm64_gas_reg(nops[0]), arm64_gas_reg(nops[1]), nimm);
                p.asm = aand;
            } else {
                p.unknown = p.unknown.append("and#");
            }
            continue;
        }
        if (!arm64_gas_known(mnem)) {
            p.unknown = p.unknown.append(mnem);
        }
        p.asm = arm64_gas_emit(p.asm, mnem, rest);
    }
    p.asm = arm64_asm_resolve(p.asm);
    return p;
}

// arm64_gas_link resolves the queued @PAGE/@PAGEOFF fixups now that the
// final __TEXT / __DATA segment addresses are known (the caller supplies
// them from macho.fern's macho_text_vaddr / macho_data_vaddr). After this,
// p.asm.code + p.data are the final sections.
function arm64_gas_link(p: Arm64GasProg, text_vaddr: i64, data_vaddr: i64): Arm64GasProg {
    var aw: Arm64Asm = p.asm;
    var i: i32 = 0;
    while (i < p.pf_sites.len()) {
        var site: i32 = p.pf_sites[i];
        var target: i64 = data_vaddr + (arm64_gas_dlabel_off(p, p.pf_syms[i]) as i64);
        var kind: i32 = p.pf_kinds[i];
        if (kind == 0) {
            var adrp_addr: i64 = text_vaddr + (site as i64);
            aw.code = arm64_patch_adrp(aw.code, site, arm64_page_delta(target, adrp_addr));
        } else if (kind == 1) {
            aw.code = arm64_patch_ldr_off(aw.code, site, arm64_page_off(target));
        } else {
            aw.code = arm64_patch_addimm_off(aw.code, site, arm64_page_off(target));
        }
        i = i + 1;
    }
    p.asm = aw;
    return p;
}

// arm64_gas_assemble parses a text-only program (no data section / symbol
// relocation) and returns the resolved .text — the back-compat entry the
// earlier slices use.
function arm64_gas_assemble(src: string): Arm64Asm {
    return arm64_gas_program(src).asm;
}
