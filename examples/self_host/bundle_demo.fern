// examples/self_host/bundle_demo.fern — end-to-end demo of the
// self-host module-flattening pipeline. Takes a tiny TWO-module
// program (an imported module `a` exporting `add`, and an entry that
// calls `a.add`), flattens + mangles + merges it into one Module via
// flatten.bundle, then lowers it to x86-64 asm with asm.emit_module
// and prints it.
//
// The companion Go test assembles that asm and runs it: the entry's
// `main` returns `a.add(2, 3)` == 5, so the produced binary exits 5.
// That's the proof that multi-module Lang source — the shape the
// compiler itself has — now lowers to a single working binary through
// the self-host pipeline.

import "core/no_prelude";
import "std/io";
import "./lexer";
import "./parser";
import "./flatten";
import "./asm";

function main(): i32 {
    var asrc: string =
        "pub function add(x: i32, y: i32): i32 { return x + y; }"
        + " function main(): i32 { return 0; }";
    var esrc: string =
        "import \"./a\"; function main(): i32 { return a.add(2, 3); }";

    var amod: parser.Module = parser.parse_module(lexer.tokenize(asrc));
    var emod: parser.Module = parser.parse_module(lexer.tokenize(esrc));

    var loaded: flatten.LoadedModule[] = [];
    loaded = loaded.push(flatten.LoadedModule { name: "a", mod: amod });

    var merged: parser.Module = flatten.bundle(emod, loaded);
    print(asm.emit_module(merged));
    return 0;
}
