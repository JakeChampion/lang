// examples/self_host/macho.fern — a minimal static, ad-hoc-signed arm64
// Mach-O executable writer for the self-hosted *native* backend. This is
// the Darwin counterpart of elf.fern (Linux): the container half of the
// native-binary path that aims to remove the external `clang` / `ld64`
// link step the self-host currently shells out to for arm64-darwin
// (mirroring the Go reference internal/native/macho/*.go).
//
// The image is a fixed-address, non-PIE executable: __PAGEZERO, an r-x
// __TEXT segment holding the Mach-O header + load commands + machine
// code, an optional r/w __DATA segment (rodata + writable globals,
// merged), and a __LINKEDIT segment carrying an ad-hoc code signature.
// Apple Silicon's kernel refuses to execute an unsigned arm64 binary, so
// the signature is mandatory; "ad-hoc" means there is no CMS/certificate
// — the CodeDirectory's SHA-256 page hashes are the identity.
//
// Execution starts via LC_UNIXTHREAD (the kernel sets PC directly), not
// LC_MAIN (which needs dyld). The code generator's `_main` entry calls
// `main` and then exits with a raw `svc #0x80`, so it never returns —
// exactly what a thread-state entry needs.
//
// Conventions (matching elf.fern):
//   * A byte buffer is an `i32[]` of values in 0..255; each helper appends
//     to it and returns the (possibly grown) buffer (`buf = f(buf, …)`).
//   * This module is intentionally **import-free** so (a) the native
//     emitter can `import "./macho"` and (b) the unit test can concatenate
//     this file with a driver `main()` and feed the whole thing to the
//     single-module wasm_run driver.
//   * Mach-O headers/load-commands are little-endian (arm64 host); the
//     code-signing blobs are big-endian. Both emitters live here.
//
// References: Apple's loader.h / cs_blobs.h, and FIPS 180-4 (SHA-256).

// ============================================================
// SHA-256 (FIPS 180-4)
// ============================================================
//
// The ad-hoc code signature hashes each 4 KiB page of the image with
// SHA-256. We have no stdlib here, so a self-contained implementation
// lives in this module. Words are carried in i64 values kept in the range
// [0, 2^32); every arithmetic result is masked back with `& 0xffffffff`,
// so the signed-i64 `>>` (arithmetic) shift acts as a logical shift on the
// always-positive words.

// sha256_rotr rotates a 32-bit word right by n (1..31) bits.
function sha256_rotr(x: i64, n: i32): i64 {
    return ((x >> n) | (x << (32 - n))) & 0xffffffff;
}

// sha256_shr is a logical right shift of a 32-bit word by n bits.
function sha256_shr(x: i64, n: i32): i64 {
    return (x >> n) & 0xffffffff;
}

function sha256_ssig0(x: i64): i64 {
    return (sha256_rotr(x, 7) ^ sha256_rotr(x, 18) ^ sha256_shr(x, 3)) & 0xffffffff;
}

function sha256_ssig1(x: i64): i64 {
    return (sha256_rotr(x, 17) ^ sha256_rotr(x, 19) ^ sha256_shr(x, 10)) & 0xffffffff;
}

function sha256_bsig0(x: i64): i64 {
    return (sha256_rotr(x, 2) ^ sha256_rotr(x, 13) ^ sha256_rotr(x, 22)) & 0xffffffff;
}

function sha256_bsig1(x: i64): i64 {
    return (sha256_rotr(x, 6) ^ sha256_rotr(x, 11) ^ sha256_rotr(x, 25)) & 0xffffffff;
}

// sha256_ch is the choose function: (x & y) ^ (~x & z).
function sha256_ch(x: i64, y: i64, z: i64): i64 {
    return ((x & y) ^ ((x ^ 0xffffffff) & z)) & 0xffffffff;
}

// sha256_maj is the majority function: (x & y) ^ (x & z) ^ (y & z).
function sha256_maj(x: i64, y: i64, z: i64): i64 {
    return ((x & y) ^ (x & z) ^ (y & z)) & 0xffffffff;
}

// sha256_k returns the 64 round constants K (the first 32 bits of the
// fractional parts of the cube roots of the first 64 primes).
function sha256_k(): i64[] {
    var k: i64[] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ];
    return k;
}

// macho_be32_word appends a 32-bit word (held in an i64) big-endian.
function macho_be32_word(buf: i32[], v: i64): i32[] {
    buf = buf.append(((v >> 24) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append((v & 255) as i32);
    return buf;
}

// sha256_bytes returns the 32-byte SHA-256 digest of data[start:start+n]
// as an i32[] of bytes.
function sha256_bytes(data: i32[], start: i32, n: i32): i32[] {
    // ---- pre-processing: pad to a multiple of 64 bytes ----
    var m: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        m = m.append(data[start + i]);
        i = i + 1;
    }
    m = m.append(128); // the single 0x80 bit
    while ((m.len() % 64) != 56) {
        m = m.append(0);
    }
    // 64-bit big-endian message length in bits.
    var bits: i64 = (n as i64) * 8;
    var bb: i32 = 7;
    while (bb >= 0) {
        m = m.append(((bits >> (bb * 8)) & 255) as i32);
        bb = bb - 1;
    }

    var k: i64[] = sha256_k();

    // ---- initial hash value (fractional cube... square roots of primes) ----
    var h0: i64 = 0x6a09e667;
    var h1: i64 = 0xbb67ae85;
    var h2: i64 = 0x3c6ef372;
    var h3: i64 = 0xa54ff53a;
    var h4: i64 = 0x510e527f;
    var h5: i64 = 0x9b05688c;
    var h6: i64 = 0x1f83d9ab;
    var h7: i64 = 0x5be0cd19;

    var blocks: i32 = m.len() / 64;
    var blk: i32 = 0;
    while (blk < blocks) {
        var base: i32 = blk * 64;

        // ---- message schedule W[0..63] ----
        var w: i64[] = [];
        var t: i32 = 0;
        while (t < 16) {
            var p: i32 = base + t * 4;
            var word: i64 = ((m[p] as i64) << 24)
                | ((m[p + 1] as i64) << 16)
                | ((m[p + 2] as i64) << 8)
                | (m[p + 3] as i64);
            w = w.append(word & 0xffffffff);
            t = t + 1;
        }
        while (t < 64) {
            var s0: i64 = sha256_ssig0(w[t - 15]);
            var s1: i64 = sha256_ssig1(w[t - 2]);
            var wt: i64 = (s1 + w[t - 7] + s0 + w[t - 16]) & 0xffffffff;
            w = w.append(wt);
            t = t + 1;
        }

        // ---- compression ----
        var a: i64 = h0;
        var b: i64 = h1;
        var c: i64 = h2;
        var d: i64 = h3;
        var e: i64 = h4;
        var f: i64 = h5;
        var g: i64 = h6;
        var hh: i64 = h7;

        var r: i32 = 0;
        while (r < 64) {
            var t1: i64 = (hh + sha256_bsig1(e) + sha256_ch(e, f, g) + k[r] + w[r]) & 0xffffffff;
            var t2: i64 = (sha256_bsig0(a) + sha256_maj(a, b, c)) & 0xffffffff;
            hh = g;
            g = f;
            f = e;
            e = (d + t1) & 0xffffffff;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) & 0xffffffff;
            r = r + 1;
        }

        h0 = (h0 + a) & 0xffffffff;
        h1 = (h1 + b) & 0xffffffff;
        h2 = (h2 + c) & 0xffffffff;
        h3 = (h3 + d) & 0xffffffff;
        h4 = (h4 + e) & 0xffffffff;
        h5 = (h5 + f) & 0xffffffff;
        h6 = (h6 + g) & 0xffffffff;
        h7 = (h7 + hh) & 0xffffffff;

        blk = blk + 1;
    }

    var out: i32[] = [];
    out = macho_be32_word(out, h0);
    out = macho_be32_word(out, h1);
    out = macho_be32_word(out, h2);
    out = macho_be32_word(out, h3);
    out = macho_be32_word(out, h4);
    out = macho_be32_word(out, h5);
    out = macho_be32_word(out, h6);
    out = macho_be32_word(out, h7);
    return out;
}

// ============================================================
// byte emitters + buffer helpers
// ============================================================

// macho_le32 appends the low 4 bytes of `v`, little-endian.
function macho_le32(buf: i32[], v: i32): i32[] {
    buf = buf.append(v & 255);
    buf = buf.append((v >> 8) & 255);
    buf = buf.append((v >> 16) & 255);
    buf = buf.append((v >> 24) & 255);
    return buf;
}

// macho_le64 appends the 8 bytes of a 64-bit `v`, little-endian.
function macho_le64(buf: i32[], v: i64): i32[] {
    var b: i32 = 0;
    while (b < 8) {
        buf = buf.append(((v >> (b * 8)) & 255) as i32);
        b = b + 1;
    }
    return buf;
}

// macho_be32 appends the low 4 bytes of `v`, big-endian (for code-signing
// blobs, which are big-endian on disk).
function macho_be32(buf: i32[], v: i32): i32[] {
    buf = buf.append((v >> 24) & 255);
    buf = buf.append((v >> 16) & 255);
    buf = buf.append((v >> 8) & 255);
    buf = buf.append(v & 255);
    return buf;
}

// macho_be64 appends the 8 bytes of a 64-bit `v`, big-endian.
function macho_be64(buf: i32[], v: i64): i32[] {
    var b: i32 = 7;
    while (b >= 0) {
        buf = buf.append(((v >> (b * 8)) & 255) as i32);
        b = b - 1;
    }
    return buf;
}

// macho_name16 writes a 16-byte, NUL-padded segment/section name.
function macho_name16(buf: i32[], s: string): i32[] {
    var i: i32 = 0;
    while (i < s.len()) {
        buf = buf.append(s[i]);
        i = i + 1;
    }
    while (i < 16) {
        buf = buf.append(0);
        i = i + 1;
    }
    return buf;
}

// macho_zeros appends `n` zero bytes.
function macho_zeros(buf: i32[], n: i32): i32[] {
    var i: i32 = 0;
    while (i < n) {
        buf = buf.append(0);
        i = i + 1;
    }
    return buf;
}

// macho_cat appends every byte of `src` to `buf`.
function macho_cat(buf: i32[], src: i32[]): i32[] {
    var i: i32 = 0;
    while (i < src.len()) {
        buf = buf.append(src[i]);
        i = i + 1;
    }
    return buf;
}

// macho_pad_to appends zero bytes until the buffer length reaches `n`.
function macho_pad_to(buf: i32[], n: i32): i32[] {
    while (buf.len() < n) {
        buf = buf.append(0);
    }
    return buf;
}

// ============================================================
// fixed-layout constants
// ============================================================

// macho_page_size is the 16 KiB Mach-O segment alignment on arm64.
function macho_page_size(): i32 { return 16384; }

// macho_base_vaddr is the __TEXT load address (just past __PAGEZERO).
function macho_base_vaddr(): i64 { return 0x100000000; }

// macho_align_up rounds n up to a multiple of the power-of-two a.
function macho_align_up(n: i32, a: i32): i32 {
    return (n + a - 1) & (0 - a);
}

// macho_load_cmds_len is the total size of all load commands: __PAGEZERO
// + __TEXT (1 section) + optional __DATA (1 section) + __LINKEDIT +
// LC_UNIXTHREAD + LC_CODE_SIGNATURE. (segCmd=72, section=80,
// unixThread=288, codeSig=16.)
function macho_load_cmds_len(has_data: boolean): i32 {
    var n: i32 = 72 + (72 + 80) + 72; // PAGEZERO + TEXT(1 sect) + LINKEDIT
    if (has_data) {
        n = n + (72 + 80); // DATA(1 sect)
    }
    n = n + 288 + 16; // LC_UNIXTHREAD + LC_CODE_SIGNATURE
    return n;
}

// macho_text_off is the file offset of code within __TEXT (after the
// Mach-O header + load commands). A native assembler needs this to
// resolve @PAGE / @PAGEOFF references before the same blobs are laid out
// here at the same address.
function macho_text_off(has_data: boolean): i32 {
    return 32 + macho_load_cmds_len(has_data);
}

// macho_text_vaddr returns the address of the first code byte (== entry)
// for the given code/data sizes.
function macho_text_vaddr(text_len: i32, data_len: i32): i64 {
    var has_data: boolean = data_len > 0;
    return macho_base_vaddr() + (macho_text_off(has_data) as i64);
}

// macho_data_vaddr returns the __DATA segment base for the given
// code/data sizes (0 if there is no data).
function macho_data_vaddr(text_len: i32, data_len: i32): i64 {
    if (data_len <= 0) {
        return 0;
    }
    var has_data: boolean = true;
    var text_off: i32 = macho_text_off(has_data);
    var text_vmsize: i32 = macho_align_up(text_off + text_len, macho_page_size());
    return macho_base_vaddr() + (text_vmsize as i64);
}

// ============================================================
// load-command writers
// ============================================================

// macho_seg writes an LC_SEGMENT_64 command header for nsects sections.
function macho_seg(buf: i32[], name: string, vmaddr: i64, vmsize: i64, fileoff: i64, filesize: i64, maxprot: i32, initprot: i32, nsects: i32): i32[] {
    buf = macho_le32(buf, 25); // LC_SEGMENT_64 = 0x19
    buf = macho_le32(buf, 72 + nsects * 80);
    buf = macho_name16(buf, name);
    buf = macho_le64(buf, vmaddr);
    buf = macho_le64(buf, vmsize);
    buf = macho_le64(buf, fileoff);
    buf = macho_le64(buf, filesize);
    buf = macho_le32(buf, maxprot);
    buf = macho_le32(buf, initprot);
    buf = macho_le32(buf, nsects);
    buf = macho_le32(buf, 0); // flags
    return buf;
}

// macho_sect writes a section_64 record.
function macho_sect(buf: i32[], sect: string, seg: string, addr: i64, size: i32, offset: i32, align: i32, flags: i32): i32[] {
    buf = macho_name16(buf, sect);
    buf = macho_name16(buf, seg);
    buf = macho_le64(buf, addr);
    buf = macho_le64(buf, size as i64);
    buf = macho_le32(buf, offset);
    buf = macho_le32(buf, align);
    buf = macho_le32(buf, 0); // reloff
    buf = macho_le32(buf, 0); // nreloc
    buf = macho_le32(buf, flags);
    buf = macho_le32(buf, 0); // reserved1
    buf = macho_le32(buf, 0); // reserved2
    buf = macho_le32(buf, 0); // reserved3
    return buf;
}

// ============================================================
// code signature
// ============================================================

// macho_sig_len computes the signature length analytically (it depends
// only on code_limit and the identifier length, not on the content), so
// the LC_CODE_SIGNATURE command + __LINKEDIT sizing can be emitted before
// the hashes are known.
function macho_sig_len(code_limit: i32, ident_len: i32): i32 {
    var id_len: i32 = ident_len + 1; // + NUL terminator
    var hash_off: i32 = 88 + id_len; // cdHeaderLen + identifier
    var n_slots: i32 = (code_limit + 4095) / 4096;
    var cd_len: i32 = hash_off + n_slots * 32;
    return 20 + cd_len; // SuperBlob header (12) + 1 BlobIndex (8) + CD
}

// macho_code_signature builds an ad-hoc CSMAGIC_EMBEDDED_SIGNATURE
// SuperBlob containing one CodeDirectory whose code-slot hashes are
// SHA-256 of each 4 KiB page of content[0:code_limit]. exec_seg_limit is
// the size of the executable (__TEXT) segment.
function macho_code_signature(content: i32[], code_limit: i32, exec_seg_limit: i32, ident: string): i32[] {
    var id_len: i32 = ident.len() + 1;
    var hash_off: i32 = 88 + id_len;
    var n_slots: i32 = (code_limit + 4095) / 4096;
    var cd_len: i32 = hash_off + n_slots * 32;
    var total: i32 = 20 + cd_len;

    var sb: i32[] = [];
    // ---- SuperBlob header + one BlobIndex ----
    sb = macho_be32(sb, 0xfade0cc0); // CSMAGIC_EMBEDDED_SIGNATURE
    sb = macho_be32(sb, total);
    sb = macho_be32(sb, 1);          // sub-blob count
    sb = macho_be32(sb, 0);          // CSSLOT_CODEDIRECTORY
    sb = macho_be32(sb, 20);         // offset of the CodeDirectory

    // ---- CodeDirectory ----
    sb = macho_be32(sb, 0xfade0c02); // CSMAGIC_CODEDIRECTORY
    sb = macho_be32(sb, cd_len);
    sb = macho_be32(sb, 0x20400);    // version (supports execSeg fields)
    sb = macho_be32(sb, 2);          // CS_ADHOC
    sb = macho_be32(sb, hash_off);   // hashOffset
    sb = macho_be32(sb, 88);         // identOffset
    sb = macho_be32(sb, 0);          // nSpecialSlots
    sb = macho_be32(sb, n_slots);    // nCodeSlots
    sb = macho_be32(sb, code_limit); // codeLimit
    sb = sb.append(32);                // hashSize (SHA-256)
    sb = sb.append(2);                 // hashType = SHA-256
    sb = sb.append(0);                 // platform
    sb = sb.append(12);                // log2(pageSize) = 4096
    sb = macho_zeros(sb, 24);        // spare2 / scatter / team / spare3 / codeLimit64
    sb = macho_be64(sb, 0);          // execSegBase
    sb = macho_be64(sb, exec_seg_limit as i64); // execSegLimit
    sb = macho_be64(sb, 1);          // execSegFlags = CS_EXECSEG_MAIN_BINARY

    // identifier + NUL
    var i: i32 = 0;
    while (i < ident.len()) {
        sb = sb.append(ident[i]);
        i = i + 1;
    }
    sb = sb.append(0);

    // page hashes
    var slot: i32 = 0;
    while (slot < n_slots) {
        var pstart: i32 = slot * 4096;
        var pend: i32 = pstart + 4096;
        if (pend > code_limit) {
            pend = code_limit;
        }
        var dig: i32[] = sha256_bytes(content, pstart, pend - pstart);
        var j: i32 = 0;
        while (j < 32) {
            sb = sb.append(dig[j]);
            j = j + 1;
        }
        slot = slot + 1;
    }
    return sb;
}

// ============================================================
// the image writer
// ============================================================

// macho_static_executable wraps machine code and a data blob into a
// runnable, ad-hoc-signed static arm64 Mach-O executable. Code occupies
// the r-x __TEXT segment; data (read-only constants + writable globals,
// merged by the assembler) occupies a r/w __DATA segment. Execution
// begins at the first code byte (the code generator's `_main`). `ident`
// is the ad-hoc signing identifier (any short string).
function macho_static_executable(text: i32[], data: i32[], ident: string): i32[] {
    var has_data: boolean = data.len() > 0;
    var text_len: i32 = text.len();
    var data_len: i32 = data.len();
    var text_off: i32 = macho_text_off(has_data);
    var page: i32 = macho_page_size();
    var text_vmsize: i32 = macho_align_up(text_off + text_len, page);
    var data_file_len: i32 = 0;
    if (has_data) {
        data_file_len = macho_align_up(data_len, page);
    }
    var code_limit: i32 = text_vmsize + data_file_len;

    var base: i64 = macho_base_vaddr();
    var text_vaddr: i64 = base + (text_off as i64);
    var data_vaddr: i64 = base + (text_vmsize as i64);
    var linkedit_vaddr: i64 = data_vaddr + (data_file_len as i64);

    var sig_len: i32 = macho_sig_len(code_limit, ident.len());
    var linkedit_vmsize: i32 = macho_align_up(sig_len, page);

    var ncmds: i32 = 5;
    if (has_data) {
        ncmds = 6;
    }
    var sizeofcmds: i32 = macho_load_cmds_len(has_data);

    var buf: i32[] = [];

    // ---- Mach-O header (32 bytes) ----
    buf = macho_le32(buf, 0xfeedfacf); // MH_MAGIC_64
    buf = macho_le32(buf, 0x0100000c); // CPU_TYPE_ARM64
    buf = macho_le32(buf, 0);          // CPU_SUBTYPE_ARM64_ALL
    buf = macho_le32(buf, 2);          // MH_EXECUTE
    buf = macho_le32(buf, ncmds);
    buf = macho_le32(buf, sizeofcmds);
    buf = macho_le32(buf, 1);          // MH_NOUNDEFS
    buf = macho_le32(buf, 0);          // reserved

    // ---- __PAGEZERO ----
    buf = macho_seg(buf, "__PAGEZERO", 0, base, 0, 0, 0, 0, 0);

    // ---- __TEXT (r-x), 1 section ----
    buf = macho_seg(buf, "__TEXT", base, text_vmsize as i64, 0, text_vmsize as i64, 5, 5, 1);
    // flags = S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    buf = macho_sect(buf, "__text", "__TEXT", text_vaddr, text_len, text_off, 2, 0x80000400);

    // ---- __DATA (r/w), 1 section (optional) ----
    if (has_data) {
        buf = macho_seg(buf, "__DATA", data_vaddr, data_file_len as i64, text_vmsize as i64, data_file_len as i64, 3, 3, 1);
        buf = macho_sect(buf, "__data", "__DATA", data_vaddr, data_len, text_vmsize, 3, 0);
    }

    // ---- __LINKEDIT (r) ----
    buf = macho_seg(buf, "__LINKEDIT", linkedit_vaddr, linkedit_vmsize as i64, code_limit as i64, sig_len as i64, 1, 1, 0);

    // ---- LC_UNIXTHREAD ----
    buf = macho_le32(buf, 5);   // LC_UNIXTHREAD
    buf = macho_le32(buf, 288); // cmdsize
    buf = macho_le32(buf, 6);   // ARM_THREAD_STATE64
    buf = macho_le32(buf, 68);  // count (uint32 units)
    // arm_thread_state64: x0..x28 (29), fp, lr, sp (32 u64) then pc, cpsr.
    buf = macho_zeros(buf, 256);       // x0..x28, fp, lr, sp
    buf = macho_le64(buf, text_vaddr); // pc (the 33rd u64) == entry
    buf = macho_zeros(buf, 8);         // cpsr + pad

    // ---- LC_CODE_SIGNATURE ----
    buf = macho_le32(buf, 29);         // LC_CODE_SIGNATURE = 0x1d
    buf = macho_le32(buf, 16);         // cmdsize
    buf = macho_le32(buf, code_limit); // dataoff
    buf = macho_le32(buf, sig_len);    // datasize

    // buf is now exactly text_off bytes (header + load commands).

    // ---- code + data ----
    buf = macho_cat(buf, text);
    buf = macho_pad_to(buf, text_vmsize);
    if (has_data) {
        buf = macho_cat(buf, data);
        buf = macho_pad_to(buf, code_limit);
    }
    // buf length is now code_limit; sign it and append the signature.
    var sig: i32[] = macho_code_signature(buf, code_limit, text_vmsize, ident);
    buf = macho_cat(buf, sig);
    return buf;
}
