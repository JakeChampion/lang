// examples/self_host/irverify_run.fern — driver for the IR verifiers: the
// structure pass (irverify.fern, #6639 slice 1), the operand-stack pass
// (irverifystack.fern, slice 2), the allocation-budget pass
// (irfipverify.fern, slice 3), and the compile-path gate the backends call
// (irverifygate.fern).
//
// Every check is asserted in BOTH directions: a malformed op stream it must
// report, and a well-formed one it must stay silent on. The silent half is
// the one that matters most — a verifier that reports a problem on valid IR
// is worse than none at all, because it would fire on the compiler
// compiling itself and there would be nothing to fix.
//
// Exit code 0 means every assertion held; a non-zero code identifies which
// one failed, so a regression names its own case without needing the
// stdout diff.
//
// `-refuse` drives the gate's REFUSAL instead: it hands verify_or_refuse a
// stream whose local index is outside the frame, so the half that reads
// FERN_IR_VERIFY and exits is testable from somewhere. It cannot be reached
// through a backend — the compiler does not emit malformed IR on demand.

import "./ir";
import "./irverify";
import "./irverifystack";
import "./irfipverify";
import "./irverifyprovided";
import "./irverifygate";
import "./util";

function no_sigs(): irverify.NameIndex { return irverify.sig_index([]); }

// count_problems verifies `ops` and returns how many problems came back.
function count_problems(ops: ir.Op[], n_params: i32, n_locals: i32): i32 {
    return irverify.verify_fn("f", ops, n_params, n_locals, no_sigs()).len();
}

// first_msg returns the first problem's rendered message, or "" if clean.
function first_msg(ops: ir.Op[], n_params: i32, n_locals: i32): string {
    var ps: irverify.Problem[] = irverify.verify_fn("f", ops, n_params, n_locals, no_sigs());
    if (ps.len() == 0) { return ""; }
    return irverify.problem_str(ps[0]);
}

// ---- operand-stack pass helpers (#6639 slice 2) ------------------------

// sp_count is how many stack problems `ops` draws. A bailed function reports
// nothing, so this is 0 for an unmodelled stream — sp_bail is what
// distinguishes "clean" from "not looked at".
function sp_count(ops: ir.Op[]): i32 {
    return irverifystack.verify_stack_fn("f", ops).problems.len();
}

function sp_msg(ops: ir.Op[]): string {
    var r: irverifystack.StackResult = irverifystack.verify_stack_fn("f", ops);
    if (r.problems.len() == 0) { return ""; }
    return irverify.problem_str(r.problems[0]);
}

function sp_bail(ops: ir.Op[]): string {
    return irverifystack.verify_stack_fn("f", ops).bail;
}

// stack_checks runs the operand-stack assertions and returns 0, or the failing
// case's id. Split out of main because the two passes' cases are independent
// and the driver's exit code has to name exactly one of them.
function stack_checks(): i32 {
    // ---- 1. the balanced baseline -------------------------------------
    // A stream that pushes its result and returns it is clean, and so is one
    // that ends at height 0: both backends append a fallthrough result past
    // the last op, so an empty stack at the end IS the well-formed shape.
    if (sp_count([ir.op_const_i32(1), ir.op_return()]) != 0) { return 70; }
    if (sp_count([ir.op_const_i32(1), ir.op_drop()]) != 0) { return 71; }
    if (sp_count([]) != 0) { return 72; }

    // A value still held where the function falls off its end is the case
    // that backend fallthrough cannot absorb: it would be pushed ON TOP.
    var dangling: ir.Op[] = [ir.op_const_i32(1)];
    if (sp_count(dangling) != 1) { return 73; }
    if (!util.contains(sp_msg(dangling), "falls off its end holding 1 operand slot")) { return 74; }

    // ---- 2. underflow --------------------------------------------------
    // An op with no operands to take. One report, not one per following op.
    var starved: ir.Op[] = [ir.op_bin("add", 0, false), ir.op_return()];
    if (sp_count(starved) != 1) { return 75; }
    if (!util.contains(sp_msg(starved), "operand stack underflow - needs 2 operand slot(s)")) { return 76; }
    if (sp_count([ir.op_drop()]) != 1) { return 77; }

    // A scope's floor is its own: the enclosing frame's values are not
    // reachable from inside it, which is what makes each `end` checkable.
    if (sp_count([ir.op_const_i32(1), ir.op_block(0), ir.op_drop(), ir.op_end(), ir.op_return()]) != 1) { return 78; }

    // ---- 3. scope height -----------------------------------------------
    // Every scope irlower opens is void, so it must leave the stack where it
    // found it.
    var leaky_if: ir.Op[] = [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(2), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
    if (sp_count(leaky_if) != 1) { return 80; }
    if (!util.contains(sp_msg(leaky_if), "the if opened at op 1 leaves 1 operand slot(s), but it is void")) { return 81; }

    // The then-arm is checked at the `else`, so a two-armed if names which
    // arm is unbalanced rather than blaming the end.
    var leaky_then: ir.Op[] = [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(2), ir.op_else(), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
    if (sp_count(leaky_then) != 1) { return 82; }
    if (!util.contains(sp_msg(leaky_then), "the then-arm leaves 1 operand slot(s)")) { return 83; }

    // A balanced if/else, and a balanced loop, are clean.
    var balanced_if: ir.Op[] = [ir.op_const_i32(1), ir.op_if(0), ir.op_const_i32(2), ir.op_drop(), ir.op_else(), ir.op_const_i32(3), ir.op_drop(), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
    if (sp_count(balanced_if) != 0) { return 84; }
    var wloop: ir.Op[] = [ir.op_block(0), ir.op_loop(0), ir.op_const_i32(1), ir.op_brif(1), ir.op_br(0), ir.op_end(), ir.op_end(), ir.op_const_i32(0), ir.op_return()];
    if (sp_count(wloop) != 0) { return 85; }

    // ---- 4. unreachable code is polymorphic ----------------------------
    // After a `br` the rest of the scope cannot be entered, so wasm validates
    // it against a polymorphic stack — and so does this pass, or every
    // lowered `return` inside a match arm would report an underflow.
    if (sp_count([ir.op_block(0), ir.op_br(0), ir.op_bin("add", 0, false), ir.op_end(), ir.op_const_i32(0), ir.op_return()]) != 0) { return 86; }
    if (sp_count([ir.op_const_i32(1), ir.op_return(), ir.op_drop()]) != 0) { return 87; }

    // A branch to the FUNCTION BODY is the return-shaped exit, so it carries
    // the result — the one label in the function that is not void.
    if (sp_count([ir.op_br(0)]) != 1) { return 88; }
    if (!util.contains(sp_msg([ir.op_br(0)]), "branch to the function body needs 1 operand slot")) { return 89; }
    if (sp_count([ir.op_const_i32(0), ir.op_br(0)]) != 0) { return 90; }

    // ---- 5. arities the corpus sweep pinned ----------------------------
    // The three composite-element writes consume their value; the raw store
    // intrinsics beside them re-push it. Getting either backwards leaves a
    // slot at the enclosing end, which is how the sweep found them.
    if (sp_count([ir.op_const_i32(0), ir.op_const_i32(0), ir.op_const_i32(0), ir.op_arr_set(32)]) != 0) { return 91; }
    if (sp_count([ir.op_const_i32(0), ir.op_const_i32(0), ir.op_struct_set(0, 0)]) != 0) { return 92; }
    if (sp_count([ir.op_const_i32(0), ir.op_const_i32(0), ir.op_store_i32(), ir.op_drop()]) != 0) { return 93; }
    // map_new takes its size hint from the stack, unlike the nullary builtins.
    if (sp_count([ir.op_const_i32(4), ir.op_map_new(1, ""), ir.op_return()]) != 0) { return 94; }
    // call_indirect pops its arguments AND the funcref pushed above them.
    if (sp_count([ir.op_const_i32(1), ir.op_const_func(0, "f"), ir.op_call_indirect(1), ir.op_return()]) != 0) { return 95; }
    if (sp_count([ir.op_const_func(0, "f"), ir.op_call_indirect(1), ir.op_return()]) != 1) { return 96; }

    // ---- 6. fail-soft --------------------------------------------------
    // An op the pass does not model abandons the function rather than
    // guessing at its arity, and says which op it was.
    var unmodelled: ir.Op[] = [ir.op_load(32)];
    if (sp_bail(unmodelled) != "unmodelled op load") { return 100; }
    if (sp_count(unmodelled) != 0) { return 101; }

    // A non-void scope is not something irlower emits; modelling what it
    // leaves behind would be guessing.
    if (!util.contains(sp_bail([ir.op_block(1), ir.op_end()]), "non-void block type 1")) { return 102; }

    // The malformed-scope shapes belong to the structure pass, so this one
    // stands down rather than reporting the same defect twice.
    if (sp_bail([ir.op_end()]) != "end with no open scope") { return 103; }
    if (sp_bail([ir.op_block(0), ir.op_else(), ir.op_end()]) != "malformed else") { return 104; }
    if (sp_bail([ir.op_block(0), ir.op_br(9), ir.op_end()]) != "branch depth has no target") { return 105; }

    // A clean function bails with nothing, which is what makes the coverage
    // number meaningful.
    if (sp_bail([ir.op_const_i32(1), ir.op_return()]).len() != 0) { return 106; }

    // ---- 7. coverage ---------------------------------------------------
    var cov: irverifystack.Coverage = irverifystack.coverage_new();
    cov = irverifystack.coverage_add(cov, "a", "");
    cov = irverifystack.coverage_add(cov, "b", "unmodelled op load");
    cov = irverifystack.coverage_add(cov, "c", "unmodelled op load");
    if (cov.funcs != 3 || cov.modelled != 1) { return 110; }
    if (cov.skipped_fns.len() != 2 || cov.skipped_fns[0] != "b") { return 111; }
    if (!util.contains(irverifystack.coverage_str(cov), "modelled 1/3")) { return 112; }
    // Reasons are grouped by cause, so a systemic skip reads as one line.
    if (!util.contains(irverifystack.coverage_str(cov), "skipped 2: unmodelled op load")) { return 113; }
    return 0;
}

// ---- allocation-budget pass helpers (#6639 slice 3) --------------------

function fip_claim(kw: string, allowance: i32): irfipverify.FipClaim {
    return irfipverify.FipClaim { fn_name: "f", is_fip: kw == "fip", is_fbip: kw == "fbip", allowance: allowance };
}

function fip_problems(kw: string, allowance: i32, ops: ir.Op[]): i32 {
    return irfipverify.verify_fip_fn(fip_claim(kw, allowance), ops).problems.len();
}

function fip_msg(kw: string, allowance: i32, ops: ir.Op[]): string {
    var r: irfipverify.FipResult = irfipverify.verify_fip_fn(fip_claim(kw, allowance), ops);
    if (r.problems.len() == 0) { return ""; }
    return irverify.problem_str(r.problems[0]);
}

// fip_checks runs the allocation-budget assertions and returns 0, or the
// failing case's id. Both directions per shape, as with the two passes above:
// the counted op must be reported past its allowance, and must be silent
// within it — a pass that charges a reuse-paired site would report every real
// `fbip` function, which is the failure mode that matters here.
function fip_checks(): i32 {
    var fresh_struct: ir.Op[] = [ir.op_const_i32(1), ir.op_const_i32(2), ir.op_struct_make("P", 2, 0 - 1)];
    var paired_struct: ir.Op[] = [ir.op_const_i32(0), ir.op_const_i32(3), ir.op_call_direct("__fern_alloc_reuse", 2)];

    // ---- 1. the budget -------------------------------------------------
    // One fresh constructor: over a bare claim's allowance of 0, within a
    // graded one's.
    if (fip_problems("fbip", 0, fresh_struct) != 1) { return 120; }
    if (fip_problems("fbip", 1, fresh_struct) != 0) { return 121; }
    if (fip_problems("fip", 0, fresh_struct) != 1) { return 122; }
    if (fip_problems("fip", 1, fresh_struct) != 0) { return 123; }

    // An unannotated function is verified vacuously, however it allocates —
    // that is what lets a caller hand the whole module in unfiltered.
    if (fip_problems("", 0, fresh_struct) != 0) { return 124; }

    // ---- 2. a paired site is not charged -------------------------------
    // The reuse-paired call is the whole reason `fbip` may write constructors,
    // so charging it would make every earned claim fail.
    if (fip_problems("fbip", 0, paired_struct) != 0) { return 125; }
    var pr: irfipverify.FipResult = irfipverify.verify_fip_fn(fip_claim("fbip", 0), paired_struct);
    if (pr.paired != 1 || pr.fresh != 0) { return 126; }
    // A call to anything else is neither charged nor credited.
    if (irfipverify.verify_fip_fn(fip_claim("fbip", 0), [ir.op_call_direct("__fern_rc_dec", 1)]).paired != 0) { return 127; }

    // ---- 3. the counted ops --------------------------------------------
    // Each constructor op the lowering emits for a fresh site, and the two
    // E053 never admits under any grading.
    if (fip_problems("fbip", 0, [ir.op_struct_make("P", 2, 0 - 1)]) != 1) { return 130; }
    if (fip_problems("fbip", 0, [ir.op_struct_copy(2)]) != 1) { return 131; }
    if (fip_problems("fbip", 0, [ir.op_tuple_make(2)]) != 1) { return 132; }
    if (fip_problems("fbip", 0, [ir.op_arr_make(3, 32)]) != 1) { return 133; }
    if (fip_problems("fbip", 0, [ir.op_opt_make(1)]) != 1) { return 134; }
    if (fip_problems("fbip", 0, [ir.op_str_concat()]) != 1) { return 135; }
    if (fip_problems("fbip", 0, [ir.op_alloc()]) != 1) { return 136; }

    // const_struct's box is STATIC DATA, so it allocates nothing — it is in
    // ir.op_allocates (which answers "needs the heap runtime") and must not be
    // in this list, or a function whose every aggregate is constant would be
    // reported for allocating none of them.
    if (fip_problems("fip", 0, [ir.op_const_struct("P", 2, "1,2")]) != 0) { return 137; }
    // Reading the heap cursor is not allocating either, for the same reason.
    if (fip_problems("fip", 0, [ir.op_heap_bump_bytes()]) != 0) { return 138; }
    // Nor is a field read off a box, or a scalar push.
    if (fip_problems("fip", 0, [ir.op_struct_get(0, 0), ir.op_const_i32(1)]) != 0) { return 139; }

    // ---- 4. the census -------------------------------------------------
    // Counts are reported whether or not the claim is exceeded, so a caller
    // can tell "constructs nothing" from "pairs everything".
    var mixed: ir.Op[] = [ir.op_struct_make("P", 2, 0 - 1), ir.op_call_direct("__fern_alloc_reuse", 2), ir.op_tuple_make(2)];
    var mr: irfipverify.FipResult = irfipverify.verify_fip_fn(fip_claim("fbip", 2), mixed);
    if (mr.fresh != 2 || mr.paired != 1) { return 140; }
    if (mr.problems.len() != 0) { return 141; }

    // ---- 5. the message ------------------------------------------------
    // One problem per function naming every site, not one problem per site:
    // the count IS the verdict, and a per-site list would bury it.
    var over: irfipverify.FipResult = irfipverify.verify_fip_fn(fip_claim("fbip", 0), mixed);
    if (over.problems.len() != 1) { return 150; }
    var m: string = irverify.problem_str(over.problems[0]);
    if (!util.contains(m, "`fbip` function \"f\" allocates: 2 un-reused allocation site(s)")) { return 151; }
    if (!util.contains(m, "allowance of 0")) { return 152; }
    if (!util.contains(m, "struct/enum construction \"P\" at op 0")) { return 153; }
    if (!util.contains(m, "tuple literal at op 2")) { return 154; }
    // The keyword in the message is the one that was written.
    if (!util.contains(fip_msg("fip", 0, mixed), "`fip` function")) { return 155; }

    // A bare `fip` overrun is checker/IR drift — E053 rejected every allocating
    // construct, so the remedy is a bug report, not a donor.
    if (!util.contains(fip_msg("fip", 0, fresh_struct), "checker/IR drift")) { return 156; }
    // A graded claim, and every `fbip`, gets the pairing remedy instead.
    if (!util.contains(fip_msg("fip", 1, mixed), "grade the claim (`fip(n)`)")) { return 157; }
    if (!util.contains(fip_msg("fbip", 0, fresh_struct), "grade the claim (`fbip(n)`)")) { return 158; }

    // The problem is whole-function, so it renders without an op index.
    if (over.problems[0].op >= 0) { return 159; }
    if (!util.contains(m, "f: `fbip` function")) { return 160; }
    return 0;
}

// gate_checks covers irverifygate.verify_problems — the verdict the backends
// ---- callee resolution (#6639 slice 4) ---------------------------------

// pv_count is how many unresolved-callee problems `ops` draws against a
// program declaring `declared`.
function pv_count(ops: ir.Op[], declared: string[]): i32 {
    return irverifyprovided.verify_provided_fn("f", ops, irverify.name_index(declared)).problems.len();
}

function pv_msg(ops: ir.Op[], declared: string[]): string {
    var r: irverifyprovided.ProvidedResult = irverifyprovided.verify_provided_fn("f", ops, irverify.name_index(declared));
    if (r.problems.len() == 0) { return ""; }
    return irverify.problem_str(r.problems[0]);
}

// provided_checks asserts the resolution pass in both directions: the callee
// nothing defines it must report, and the four things that resolve — a
// declared function, a runtime helper, a per-type generated helper, and an FFI
// shim — it must stay silent on.
function provided_checks(): i32 {
    var none: string[] = [];
    var decl: string[] = ["main", "helper"];

    // The failure this pass exists to catch: a call to a name nothing defines.
    if (pv_count([ir.op_call_direct("nope", 1)], decl) != 1) { return 70; }
    if (!util.contains(pv_msg([ir.op_call_direct("nope", 1)], decl),
        "calls nope, which the program does not declare and no backend provides")) { return 71; }
    // Located like every other problem: function, op index, kind.
    if (!util.contains(pv_msg([ir.op_load_local(0), ir.op_call_direct("nope", 1)], decl),
        "f: op 1 (call_direct):")) { return 72; }

    // A declared function resolves.
    if (pv_count([ir.op_call_direct("helper", 1)], decl) != 0) { return 73; }
    // A runtime helper resolves off the inventory.
    if (pv_count([ir.op_call_direct("__fern_rc_dec", 1)], none) != 0) { return 74; }
    if (pv_count([ir.op_call_direct("__fern_arr_str_join", 2)], none) != 0) { return 75; }
    // The per-type helpers resolve by prefix — their suffix is a type name the
    // program supplies, so no inventory could carry them.
    if (pv_count([ir.op_call_direct("__struct_drop_Holder", 1)], none) != 0) { return 76; }
    if (pv_count([ir.op_call_direct("__field_reclaim_Box", 1)], none) != 0) { return 77; }
    // The FFI shim family, across the arity and return-suffix axes.
    if (pv_count([ir.op_call_direct("__c_call0", 1)], none) != 0) { return 78; }
    if (pv_count([ir.op_call_direct("__c_call4_f64", 5)], none) != 0) { return 79; }
    // …and its near-misses do NOT: the prefix rules must not admit a typo.
    if (pv_count([ir.op_call_direct("__c_call5", 1)], none) != 1) { return 80; }
    if (pv_count([ir.op_call_direct("__c_call0_f16", 1)], none) != 1) { return 81; }
    if (pv_count([ir.op_call_direct("__struct_drop_", 1)], none) != 1) { return 82; }
    if (pv_count([ir.op_call_direct("__fern_rc_de", 1)], none) != 1) { return 83; }

    // An empty callee name is irverify.fern's problem; reporting it here too
    // would double every occurrence.
    if (pv_count([ir.op_call_direct("", 1)], none) != 0) { return 84; }
    // Only call_direct names a callee — an indirect call has none to resolve.
    if (pv_count([ir.op_call_indirect(2)], none) != 0) { return 85; }

    // The call tally travels with the verdict, so a clean result over a module
    // with no calls is distinguishable from a clean result over one with many.
    var mixed: ir.Op[] = [ir.op_call_direct("helper", 1), ir.op_call_direct("__fern_rc_inc", 1), ir.op_call_direct("nope", 0)];
    var mr: irverifyprovided.ProvidedResult = irverifyprovided.verify_provided_fn("f", mixed, irverify.name_index(decl));
    if (mr.calls != 3) { return 86; }
    if (mr.problems.len() != 1) { return 87; }

    // ---- the name index ------------------------------------------------
    // Membership is what the pass rests on, and a bucketing bug would show up
    // as a false unresolved report rather than a crash. Check both answers,
    // and check them at a size that spans many buckets.
    var big: string[] = [];
    var i: i32 = 0;
    while (i < 3000) { big = big.append("fn_" + util.i32_to_string(i)); i = i + 1; }
    var ix: irverify.NameIndex = irverify.name_index(big);
    if (!irverify.index_has(ix, "fn_0")) { return 88; }
    if (!irverify.index_has(ix, "fn_1499")) { return 89; }
    if (!irverify.index_has(ix, "fn_2999")) { return 90; }
    if (irverify.index_has(ix, "fn_3000")) { return 91; }
    if (irverify.index_has(ix, "")) { return 92; }
    // Every name goes in exactly once — a placement bug that overwrote a
    // bucket entry would leave an earlier name unfindable.
    var placed: i32 = 0;
    var pj: i32 = 0;
    while (pj < big.len()) {
        if (irverify.index_has(ix, big[pj])) { placed = placed + 1; }
        pj = pj + 1;
    }
    if (placed != 3000) { return 93; }
    // The empty program's index answers no to everything rather than trapping.
    if (irverify.index_has(irverify.name_index(none), "x")) { return 94; }

    // A duplicated name resolves to its FIRST declaration. Two entries can
    // disagree about arity, and the call check reads whichever the index kept,
    // so this is the difference between an arity report and a false one.
    var dsigs: irverify.FnSig[] = [
        irverify.FnSig { name: "dup", n_params: 2 },
        irverify.FnSig { name: "other", n_params: 1 },
        irverify.FnSig { name: "dup", n_params: 7 }
    ];
    var dix: irverify.NameIndex = irverify.sig_index(dsigs);
    if (irverify.index_params(dix, "dup") != 2) { return 97; }
    if (irverify.index_params(dix, "other") != 1) { return 98; }
    if (irverify.index_params(dix, "absent") != 0 - 1) { return 99; }
    // A membership-only index carries no arity, so index_params declines for a
    // name index_has admits — the two answers are independent.
    var mix: irverify.NameIndex = irverify.name_index(["solo"]);
    if (!irverify.index_has(mix, "solo")) { return 107; }
    if (irverify.index_params(mix, "solo") != 0 - 1) { return 108; }

    // The inventory is non-empty and every entry resolves through is_provided
    // — an entry that did not would be dead weight the audit could not see.
    var inv: string[] = irverifyprovided.provided_names();
    if (inv.len() < 30) { return 95; }
    var vi: i32 = 0;
    while (vi < inv.len()) {
        if (!irverifyprovided.is_provided(inv[vi])) { return 96; }
        vi = vi + 1;
    }
    return 0;
}

// act on (#6639). It is its own case set because the gate MERGES the two
// passes, and a merge that dropped one of them would still look clean against
// either pass's own tests.
function gate_checks(): i32 {
    // A function that pushes its result and returns it draws nothing from
    // either pass. This is the case that decides whether the gate is usable at
    // all: it runs on every function of every compile, so a false positive here
    // would refuse valid programs.
    var clean: ir.Op[] = [ir.op_const_i32(1), ir.op_return()];
    if (irverifygate.verify_problems("f", clean, 0, 1, no_sigs()).len() != 0) { return 170; }

    // A STRUCTURE problem alone: the local index is outside a 1-slot frame.
    // The stack pass is silent on it (load_local pops nothing either way), so
    // this reaches the gate only through irverify.
    var bad_slot: ir.Op[] = [ir.op_load_local(5), ir.op_return()];
    if (irverifygate.verify_problems("f", bad_slot, 0, 1, no_sigs()).len() != 1) { return 171; }
    if (!util.contains(irverify.problem_str(irverifygate.verify_problems("f", bad_slot, 0, 1, no_sigs())[0]),
        "is outside the frame")) { return 172; }

    // A STACK problem alone: `add` needs two operands and is handed one. The
    // frame is well-formed, so irverify says nothing and only the stack pass
    // reaches the gate — the direction a merge dropping irverifystack would
    // miss, which is the class the gate was built for.
    var underflow: ir.Op[] = [ir.op_const_i32(1), ir.op_bin("add", 0, false), ir.op_return()];
    if (irverifygate.verify_problems("f", underflow, 0, 1, no_sigs()).len() != 1) { return 173; }
    if (!util.contains(irverify.problem_str(irverifygate.verify_problems("f", underflow, 0, 1, no_sigs())[0]),
        "operand stack underflow")) { return 174; }

    // Both at once: the gate reports each pass's findings, structure first.
    var both: ir.Op[] = [ir.op_load_local(5), ir.op_bin("add", 0, false), ir.op_return()];
    var bps: irverify.Problem[] = irverifygate.verify_problems("f", both, 0, 1, no_sigs());
    if (bps.len() != 2) { return 175; }
    if (!util.contains(irverify.problem_str(bps[0]), "is outside the frame")) { return 176; }
    if (!util.contains(irverify.problem_str(bps[1]), "operand stack underflow")) { return 177; }

    // The callee index the backends hand in has to REACH irverify, not sit in
    // the parameter list. A wrong-arity call is invisible to the stack pass —
    // it pops what the op says it pops — so this is the only case that fails
    // if the gate goes back to verifying against an empty signature set.
    var sigs: irverify.NameIndex = irverify.sig_index([irverify.FnSig { name: "takes2", n_params: 2 }]);
    var arity: ir.Op[] = [ir.op_call_direct("takes2", 0), ir.op_return()];
    var aps: irverify.Problem[] = irverifygate.verify_problems("f", arity, 0, 1, sigs);
    if (aps.len() != 1) { return 178; }
    if (!util.contains(irverify.problem_str(aps[0]), "calls takes2 with 0 args")) { return 179; }
    // Same stream, no index: clean, so the case above is the index doing the
    // work rather than the op stream being malformed some other way.
    if (irverifygate.verify_problems("f", arity, 0, 1, no_sigs()).len() != 0) { return 180; }
    return 0;
}

// refuse_probe drives irverifygate.verify_or_refuse — the half that reads
// FERN_IR_VERIFY and exits — from a stream that is definitely malformed.
//
// It exists because the backends' call sites cannot be tested from the other
// side: the compiler does not emit malformed IR on demand, so nothing would
// otherwise pin that the flag is read, that a non-empty verdict is acted on,
// or that the exit code is 4. Reached only via `-refuse`.
function refuse_probe(): i32 {
    var malformed: ir.Op[] = [ir.op_load_local(5), ir.op_return()];
    irverifygate.verify_or_refuse("probe", malformed, 0, 1, no_sigs());
    // Only reachable under FERN_IR_VERIFY=0: the opt-out must make the gate
    // inert, which is as much of the contract as the refusal is.
    print("irverifygate: inert (FERN_IR_VERIFY=0)");
    return 0;
}

function main(): i32 {
    var av: string[] = args();
    var ai: i32 = 0;
    while (ai < av.len()) {
        if (av[ai] == "-refuse") { return refuse_probe(); }
        ai = ai + 1;
    }

    // ---- 1. local index bounds ----------------------------------------
    // A frame of 3 slots admits 0..2 and refuses 3 and -1.
    var in_range: ir.Op[] = [ir.op_load_local(0), ir.op_store_local(2), ir.op_tee_local(1)];
    if (count_problems(in_range, 1, 3) != 0) { return 1; }

    var past_end: ir.Op[] = [ir.op_load_local(3)];
    if (count_problems(past_end, 1, 3) != 1) { return 2; }

    var negative_idx: ir.Op[] = [ir.op_store_local(0 - 1)];
    if (count_problems(negative_idx, 1, 3) != 1) { return 3; }

    // The message names the frame breakdown, not just the index.
    var m1: string = first_msg(past_end, 1, 3);
    if (!util.contains(m1, "local index 3 is outside the frame")) { return 4; }
    if (!util.contains(m1, "1 params + 2 locals = 3 slots")) { return 5; }

    // A zero-slot frame refuses every index, including 0.
    if (count_problems([ir.op_load_local(0)], 0, 0) != 1) { return 6; }

    // ---- 2. control scope discipline ----------------------------------
    // Balanced block/end is clean, and so is a nested if/else/end.
    var balanced: ir.Op[] = [ir.op_block(0), ir.op_end()];
    if (count_problems(balanced, 0, 1) != 0) { return 10; }

    var if_else: ir.Op[] = [ir.op_if(0), ir.op_else(), ir.op_end()];
    if (count_problems(if_else, 0, 1) != 0) { return 11; }

    var nested: ir.Op[] = [ir.op_block(0), ir.op_loop(0), ir.op_if(0), ir.op_else(), ir.op_end(), ir.op_end(), ir.op_end()];
    if (count_problems(nested, 0, 1) != 0) { return 12; }

    // An unclosed scope is reported once, against the op that opened it.
    var unclosed: ir.Op[] = [ir.op_block(0)];
    if (count_problems(unclosed, 0, 1) != 1) { return 13; }
    if (!util.contains(first_msg(unclosed, 0, 1), "scope is never closed")) { return 14; }

    // Two unclosed scopes are two problems, not one.
    if (count_problems([ir.op_block(0), ir.op_loop(0)], 0, 1) != 2) { return 15; }

    // An end with nothing open.
    var extra_end: ir.Op[] = [ir.op_end()];
    if (count_problems(extra_end, 0, 1) != 1) { return 16; }
    if (!util.contains(first_msg(extra_end, 0, 1), "end with no open scope")) { return 17; }

    // An else against a block rather than an if.
    var else_on_block: ir.Op[] = [ir.op_block(0), ir.op_else(), ir.op_end()];
    if (count_problems(else_on_block, 0, 1) != 1) { return 18; }
    if (!util.contains(first_msg(else_on_block, 0, 1), "else closes a block")) { return 19; }

    // A second else for one if.
    var double_else: ir.Op[] = [ir.op_if(0), ir.op_else(), ir.op_else(), ir.op_end()];
    if (count_problems(double_else, 0, 1) != 1) { return 20; }
    if (!util.contains(first_msg(double_else, 0, 1), "second else")) { return 21; }

    // An else with nothing open at all.
    if (count_problems([ir.op_else()], 0, 1) != 1) { return 22; }

    // ---- 3. branch depth ----------------------------------------------
    // Inside one block, depth 0 targets it and depth 1 targets the implicit
    // function-body scope — both legal. Depth 2 has no target.
    var br0: ir.Op[] = [ir.op_block(0), ir.op_br(0), ir.op_end()];
    if (count_problems(br0, 0, 1) != 0) { return 30; }

    var br1: ir.Op[] = [ir.op_block(0), ir.op_br(1), ir.op_end()];
    if (count_problems(br1, 0, 1) != 0) { return 31; }

    var br2: ir.Op[] = [ir.op_block(0), ir.op_br(2), ir.op_end()];
    if (count_problems(br2, 0, 1) != 1) { return 32; }
    if (!util.contains(first_msg(br2, 0, 1), "branch depth 2 has no target")) { return 33; }

    // brif obeys the same rule.
    if (count_problems([ir.op_block(0), ir.op_brif(1), ir.op_end()], 0, 1) != 0) { return 34; }
    if (count_problems([ir.op_block(0), ir.op_brif(2), ir.op_end()], 0, 1) != 1) { return 35; }

    // A branch at the top level may still target the function body (depth 0).
    if (count_problems([ir.op_br(0)], 0, 1) != 0) { return 36; }
    if (count_problems([ir.op_br(1)], 0, 1) != 1) { return 37; }

    // A negative depth has no target either.
    if (count_problems([ir.op_block(0), ir.op_br(0 - 1), ir.op_end()], 0, 1) != 1) { return 38; }

    // ---- 4. call arity -------------------------------------------------
    var sigs: irverify.NameIndex = irverify.sig_index([
        irverify.FnSig { name: "takes2", n_params: 2 },
        irverify.FnSig { name: "takes0", n_params: 0 }
    ]);

    // Exact arity is clean.
    var call_ok: ir.Op[] = [ir.op_call_direct("takes2", 2)];
    if (irverify.verify_fn("f", call_ok, 0, 1, sigs).len() != 0) { return 40; }

    // One fewer than declared is the closure-environment shape, also clean.
    var call_env: ir.Op[] = [ir.op_call_direct("takes2", 1)];
    if (irverify.verify_fn("f", call_env, 0, 1, sigs).len() != 0) { return 41; }

    // Two fewer is a real mismatch.
    var call_bad: ir.Op[] = [ir.op_call_direct("takes2", 0)];
    var bad_ps: irverify.Problem[] = irverify.verify_fn("f", call_bad, 0, 1, sigs);
    if (bad_ps.len() != 1) { return 42; }
    if (!util.contains(irverify.problem_str(bad_ps[0]), "calls takes2 with 0 args, but it declares 2")) { return 43; }

    // Too many is a mismatch as well.
    if (irverify.verify_fn("f", [ir.op_call_direct("takes2", 3)], 0, 1, sigs).len() != 1) { return 44; }

    // An UNKNOWN callee is deliberately not reported — the self-host has no
    // builtin inventory, so it cannot tell a builtin from a typo (#6639
    // slice 4). This is the check that keeps the pass false-positive-free
    // on real modules, which call builtins and __-prefixed helpers
    // constantly.
    if (irverify.verify_fn("f", [ir.op_call_direct("__fern_rc_inc", 1)], 0, 1, sigs).len() != 0) { return 45; }
    if (irverify.verify_fn("f", [ir.op_call_direct("print", 1)], 0, 1, sigs).len() != 0) { return 46; }

    // With no signatures at all, arity is skipped entirely rather than
    // every call becoming a problem.
    if (count_problems([ir.op_call_direct("takes2", 99)], 0, 1) != 0) { return 47; }

    // A negative count is impossible regardless of the callee.
    if (count_problems([ir.op_call_direct("anything", 0 - 1)], 0, 1) != 1) { return 48; }

    // An empty callee name.
    if (count_problems([ir.op_call_direct("", 1)], 0, 1) != 1) { return 49; }

    // Indirect and closure calls check the count only.
    if (count_problems([ir.op_call_indirect(2)], 0, 1) != 0) { return 50; }
    if (count_problems([ir.op_call_indirect(0 - 1)], 0, 1) != 1) { return 51; }

    // ---- 5. reporting --------------------------------------------------
    // Problems accumulate in op order across classes.
    var many: ir.Op[] = [ir.op_load_local(9), ir.op_end(), ir.op_br(4)];
    var mp: irverify.Problem[] = irverify.verify_fn("g", many, 0, 1, no_sigs());
    if (mp.len() != 3) { return 60; }
    if (mp[0].op != 0 || mp[1].op != 1 || mp[2].op != 2) { return 61; }
    if (mp[0].fn_name != "g") { return 62; }

    // The rendered form names function, op index and kind.
    if (!util.contains(irverify.problem_str(mp[0]), "g: op 0 (load_local):")) { return 63; }

    // format_problems caps its output and says how many it dropped.
    if (!util.contains(irverify.format_problems(mp, 2), "... and 1 more")) { return 64; }
    if (util.contains(irverify.format_problems(mp, 10), "more")) { return 65; }

    // A clean function renders to the empty string.
    if (irverify.format_problems(irverify.verify_fn("f", balanced, 0, 1, no_sigs()), 10).len() != 0) { return 66; }

    var sc: i32 = stack_checks();
    if (sc != 0) { return sc; }

    var fc: i32 = fip_checks();
    if (fc != 0) { return fc; }

    var pc: i32 = provided_checks();
    if (pc != 0) { return pc; }

    var gc: i32 = gate_checks();
    if (gc != 0) { return gc; }

    print("irverify: all structural checks agree");
    print("irverifystack: all stack checks agree");
    print("irfipverify: all allocation-budget checks agree");
    print("irverifyprovided: all callee-resolution checks agree");
    print("irverifygate: compile-path gate agrees");
    return 0;
}
