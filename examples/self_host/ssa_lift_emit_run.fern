// examples/self_host/ssa_lift_emit_run.fern — end-to-end driver for the
// stack-IR -> SSA LIFT feeding a real backend. Where ssa_emit_run.fern drives
// AST -> SSA (`build_func`) -> emit, this driver drives hand-built ir.Op[] ->
// SSA (`ssa_lift.lift_from_ir`) -> `ssa.optimize` -> `ssa_x86.emit_program` /
// `ssa_arm64.emit_program` -> assembly. The companion Go test
// (internal/e2e/self_host_ssa_lift_emit_test.go) assembles the output and runs
// it (arm64 under qemu), asserting the process exit code matches the program's
// value — proof that the lift's SSA is not just interpretable (eval_func) but
// feeds the existing optimiser and both production backends all the way to
// executing native code.
//
// A program is one or more functions (a multi-function program exercises
// cross-function `call_direct`, including recursion). argv[1] selects the
// program; `-target arm64-linux` selects the backend; `-regalloc` exercises the
// linear-scan allocator over the lifted SSA.

import "./ir";
import "./ssa";
import "./ssa_x86";
import "./ssa_arm64";
import "./ssa_lift";
import "./parser";

// FnSpec is one function of a program: its name + arity + local-slot count and
// the ir.Op[] body. The first spec of a program is the entry `main`.
struct FnSpec { name: string, nparams: i32, nslots: i32, ops: ir.Op[] }

// fn_specs returns the function list for the named program.
function fn_specs(name: string): FnSpec[] {
    if (name == "arith") {
        // (3 + 4) * 2 - 1 = 13
        return [ FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
            ir.op_const_i32(3), ir.op_const_i32(4), ir.op_bin("add", 0, false),
            ir.op_const_i32(2), ir.op_bin("mul", 0, false),
            ir.op_const_i32(1), ir.op_bin("sub", 0, false),
            ir.op_return()
        ] } ];
    }
    if (name == "loopsum") {
        // var i=1,acc=0; while (i<=5) { acc=acc+i; i=i+1; } return acc;  => 15
        return [ FnSpec { name: "main", nparams: 0, nslots: 2, ops: [
            ir.op_const_i32(1), ir.op_store_local(0),
            ir.op_const_i32(0), ir.op_store_local(1),
            ir.op_block(0), ir.op_loop(0),
                ir.op_load_local(0), ir.op_const_i32(5), ir.op_bin("le_s", 0, false), ir.op_bin("not", 0, false), ir.op_brif(1),
                ir.op_load_local(1), ir.op_load_local(0), ir.op_bin("add", 0, false), ir.op_store_local(1),
                ir.op_load_local(0), ir.op_const_i32(1), ir.op_bin("add", 0, false), ir.op_store_local(0),
                ir.op_br(0),
            ir.op_end(), ir.op_end(),
            ir.op_load_local(1), ir.op_return()
        ] } ];
    }
    if (name == "branch") {
        // var x=0; if (7 > 3) { x = 42; } return x;  => 42
        return [ FnSpec { name: "main", nparams: 0, nslots: 1, ops: [
            ir.op_const_i32(0), ir.op_store_local(0),
            ir.op_const_i32(7), ir.op_const_i32(3), ir.op_bin("gt_s", 0, false),
            ir.op_if(0),
                ir.op_const_i32(42), ir.op_store_local(0),
            ir.op_end(),
            ir.op_load_local(0), ir.op_return()
        ] } ];
    }
    if (name == "breakloop") {
        // var i=0; while (i<100) { if (i==42) { break; } i=i+1; } return i;  => 42
        return [ FnSpec { name: "main", nparams: 0, nslots: 1, ops: [
            ir.op_const_i32(0), ir.op_store_local(0),
            ir.op_block(0), ir.op_loop(0),
                ir.op_load_local(0), ir.op_const_i32(100), ir.op_bin("lt_s", 0, false), ir.op_bin("not", 0, false), ir.op_brif(1),
                ir.op_load_local(0), ir.op_const_i32(42), ir.op_bin("eq", 0, false),
                ir.op_if(0), ir.op_br(2), ir.op_end(),
                ir.op_load_local(0), ir.op_const_i32(1), ir.op_bin("add", 0, false), ir.op_store_local(0),
                ir.op_br(0),
            ir.op_end(), ir.op_end(),
            ir.op_load_local(0), ir.op_return()
        ] } ];
    }
    if (name == "callsum") {
        // add(a,b) = a + b;  main() = add(20, 22)  => 42 (cross-function call_direct)
        return [
            FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
                ir.op_const_i32(20), ir.op_const_i32(22), ir.op_call_direct("add", 2), ir.op_return()
            ] },
            FnSpec { name: "add", nparams: 2, nslots: 2, ops: [
                ir.op_load_local(0), ir.op_load_local(1), ir.op_bin("add", 0, false), ir.op_return()
            ] }
        ];
    }
    if (name == "factrec") {
        // fact(n) = if (n <= 1) { return 1; } return n * fact(n-1);
        // main() = fact(5)  => 120 (self-recursion through the lifted SSA)
        return [
            FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
                ir.op_const_i32(5), ir.op_call_direct("fact", 1), ir.op_return()
            ] },
            FnSpec { name: "fact", nparams: 1, nslots: 1, ops: [
                ir.op_load_local(0), ir.op_const_i32(1), ir.op_bin("le_s", 0, false),
                ir.op_if(0),
                    ir.op_const_i32(1), ir.op_return(),
                ir.op_end(),
                ir.op_load_local(0),
                ir.op_load_local(0), ir.op_const_i32(1), ir.op_bin("sub", 0, false), ir.op_call_direct("fact", 1),
                ir.op_bin("mul", 0, false), ir.op_return()
            ] }
        ];
    }
    if (name == "arrsum") {
        // var a = [5, 10, 15]; return a[0] + a[1] + a[2];  => 30
        // Exercises the slice-2 i32-array lift (arr_make / arr_get) all the way
        // through optimise / regalloc / emit on both backends. One slot holds
        // the array pointer; arr_make pops the three elements (element 0
        // deepest) and pushes the length-prefixed heap box.
        return [
            FnSpec { name: "main", nparams: 0, nslots: 1, ops: [
                ir.op_const_i32(5), ir.op_const_i32(10), ir.op_const_i32(15),
                ir.op_arr_make(3, 32), ir.op_store_local(0),
                ir.op_load_local(0), ir.op_const_i32(0), ir.op_arr_get(32),
                ir.op_load_local(0), ir.op_const_i32(1), ir.op_arr_get(32), ir.op_bin("add", 0, false),
                ir.op_load_local(0), ir.op_const_i32(2), ir.op_arr_get(32), ir.op_bin("add", 0, false),
                ir.op_return()
            ] }
        ];
    }
    if (name == "structsum") {
        // struct P { x: i32, y: i32 }; var p = P { x: 10, y: 32 };
        // return p.x + p.y;  => 42
        // Exercises the slice-3 scalar-struct lift (struct_make / struct_get)
        // through optimise / regalloc / emit on both backends. struct_make pops
        // the two fields (field 0 deepest) and pushes the tag-prefixed box.
        return [
            FnSpec { name: "main", nparams: 0, nslots: 1, ops: [
                ir.op_const_i32(10), ir.op_const_i32(32),
                ir.op_struct_make("P", 2), ir.op_store_local(0),
                ir.op_load_local(0), ir.op_struct_get(0, 0),
                ir.op_load_local(0), ir.op_struct_get(1, 0), ir.op_bin("add", 0, false),
                ir.op_return()
            ] }
        ];
    }
    if (name == "tuplesum") {
        // var t = (10, 32); return t.0 + t.1;  => 42
        // Exercises the slice-4 tuple lift (tuple_make / tuple_get) through
        // optimise / regalloc / emit on both backends. tuple_make pops the two
        // elements (element 0 deepest) and pushes the prefix-free box (element
        // i at slot i).
        return [
            FnSpec { name: "main", nparams: 0, nslots: 1, ops: [
                ir.op_const_i32(10), ir.op_const_i32(32),
                ir.op_tuple_make(2), ir.op_store_local(0),
                ir.op_load_local(0), ir.op_tuple_get(0),
                ir.op_load_local(0), ir.op_tuple_get(1), ir.op_bin("add", 0, false),
                ir.op_return()
            ] }
        ];
    }
    if (name == "f64cmp") {
        // return (1.5 * 2.0 + 0.5 > 3.0) ? 1 : 0;  => 1
        // Exercises the slice-5 f64 lift (const_f64 + fmul / fadd / fgt) through
        // optimise / regalloc / emit on both backends. compute_isfloat infers
        // the operand widths from the const_float seeds; the compare yields i32.
        return [
            FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
                ir.op_const_f64_text("1.5"), ir.op_const_f64_text("2.0"), ir.op_fbin("fmul"),
                ir.op_const_f64_text("0.5"), ir.op_fbin("fadd"),
                ir.op_const_f64_text("3.0"), ir.op_fbin("fgt"),
                ir.op_return()
            ] }
        ];
    }
    if (name == "castrt") {
        // return ((10 as f64) * 1.5) as i32;  => 15
        // Exercises the slice-6 casts (i32_to_f64 + f64_to_i32) around an f64
        // multiply, through optimise / regalloc / emit on both backends.
        return [
            FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
                ir.op_const_i32(10), ir.op_i32_to_f64(),
                ir.op_const_f64_text("1.5"), ir.op_fbin("fmul"),
                ir.op_f64_to_i32(),
                ir.op_return()
            ] }
        ];
    }
    if (name == "strcat") {
        // return ("foo" + "bar").len();  => 6
        // Exercises the slice-7 string lift (const_str + str_concat + str_len)
        // through optimise / regalloc / emit on both backends.
        return [
            FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
                ir.op_const_str("foo"), ir.op_const_str("bar"), ir.op_str_concat(),
                ir.op_str_len(),
                ir.op_return()
            ] }
        ];
    }
    if (name == "strbuf") {
        // strbuf_reset(); strbuf_append("ab"); strbuf_append("cde");
        // return strbuf_take().len();  => 5
        // Exercises the slice-8 string-builder lift (strbuf_reset / _append /
        // _take) through optimise / regalloc / emit on both backends.
        return [
            FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
                ir.op_strbuf_reset(),
                ir.op_const_str("ab"), ir.op_strbuf_append(),
                ir.op_const_str("cde"), ir.op_strbuf_append(),
                ir.op_strbuf_take(), ir.op_str_len(),
                ir.op_return()
            ] }
        ];
    }
    if (name == "exitprog") {
        // exit(42); return 0;  => process exits 42 (the return is dead)
        // Exercises the slice-9 `exit` lift: a diverging inst emitted mid-block,
        // with the following return still lowered as dead code.
        return [
            FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
                ir.op_const_i32(42), ir.op_exit(),
                ir.op_const_i32(0), ir.op_return()
            ] }
        ];
    }
    if (name == "strindex") {
        // return "ABC"[1];  => 66 ('B')
        // Exercises the slice-10 str_index lift (load_elem at idx+1 over the
        // [len, byte-per-word] string) through optimise / regalloc / emit.
        return [
            FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
                ir.op_const_str("ABC"), ir.op_const_i32(1), ir.op_str_index(),
                ir.op_return()
            ] }
        ];
    }
    if (name == "optval") {
        // return Some(42).payload;  => 42
        // Exercises the slice-11 Option lift (opt_make tag 0 + opt_payload) —
        // the 2-word { tag, payload } box — through optimise / regalloc / emit.
        return [
            FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
                ir.op_const_i32(42), ir.op_opt_make(0), ir.op_opt_payload(),
                ir.op_return()
            ] }
        ];
    }
    if (name == "argslen") {
        // return args().len();  => 1 (the program name; run with no extra argv)
        // Exercises the slice-12 `args` lift (the argv string[] + str_len)
        // through optimise / regalloc / emit on both backends.
        return [
            FnSpec { name: "main", nparams: 0, nslots: 0, ops: [
                ir.op_args(), ir.op_str_len(),
                ir.op_return()
            ] }
        ];
    }
    if (name == "closure") {
        // var x = 10; var f = (y) => x + y; return f(5);  => 15
        // Exercises the slice-13 closure lift (const_func -> funcaddr, the
        // arr_make [funcval, x] box, the arr_get capture read, call_indirect
        // env-first) through optimise / regalloc / emit on both backends. Two
        // functions: main builds+calls the closure, `clo(__env, y)` is the
        // lifted lambda reading its capture from __env[1].
        return [
            FnSpec { name: "main", nparams: 0, nslots: 2, ops: [
                ir.op_const_i32(10), ir.op_store_local(0),
                ir.op_const_func(0, "clo"), ir.op_load_local(0), ir.op_arr_make(2, 32),
                ir.op_store_local(1),
                ir.op_load_local(1), ir.op_const_i32(5),
                ir.op_load_local(1), ir.op_const_i32(0), ir.op_arr_get(32),
                ir.op_call_indirect(2),
                ir.op_return()
            ] },
            FnSpec { name: "clo", nparams: 2, nslots: 2, ops: [
                ir.op_load_local(0), ir.op_const_i32(1), ir.op_arr_get(32),
                ir.op_load_local(1), ir.op_bin("add", 0, false),
                ir.op_return()
            ] }
        ];
    }
    return [];
}

function main(): i32 {
    var av: string[] = args();
    var prog: string = "loopsum";
    var target: string = "x86-64-linux";
    var use_regalloc: boolean = false;
    var ai: i32 = 1;
    while (ai < av.len()) {
        if (av[ai] == "-regalloc") { use_regalloc = true; }
        else if (av[ai] == "-target") { ai = ai + 1; if (ai < av.len()) { target = av[ai]; } }
        else { prog = av[ai]; }
        ai = ai + 1;
    }

    var specs: FnSpec[] = fn_specs(prog);
    if (specs.len() == 0) { return 2; }

    // The same pre-emit passes the build_func path runs. With only i32-returning
    // callees, mark_ptr_calls / mark_float_calls are no-ops, but keep them so
    // the pipeline matches. optimise also proves the lifted SSA is accepted by
    // the existing optimiser. Every function is lifted, then the whole set is
    // emitted together so cross-function `call`s resolve.
    var empty: string[] = [];
    // The hand-built emit specs never construct enum/struct boxes, so the tag
    // discriminant is unused — an empty struct table (struct_id_of -> -1) suffices.
    var no_structs: parser.StructDecl[] = [];
    var funcs: ssa.SFunc[] = [];
    var i: i32 = 0;
    while (i < specs.len()) {
        var lr: ssa_lift.LResult = ssa_lift.lift_from_ir(specs[i].name, specs[i].nparams, specs[i].nslots, specs[i].ops, no_structs);
        if (!lr.ok) { return 1; }
        funcs = funcs.append(ssa.optimize(ssa.mark_float_calls(ssa.mark_ptr_calls(lr.func, empty), empty)));
        i = i + 1;
    }

    if (target == "arm64-linux") { write(ssa_arm64.emit_program(funcs, use_regalloc)); }
    else { write(ssa_x86.emit_program(funcs, use_regalloc)); }
    return 0;
}
