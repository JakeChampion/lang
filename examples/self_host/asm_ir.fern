    // rebind reclaim (#3456 slice 2). Stack-arg ABI: 24(%rsp)=new, 16=old,
    // 8=snap. Frees `old` (rc-guarded SHALLOW box release, the __fern_arr_dec free
    // path) only when it differs from BOTH `new` (cow) AND `snap` (never freed).
    // Returns `new` in %rax. %rcx/%rdx/%rsi/%rdi/%r8/%r9 are scratch.
    s = s.write("__fn___fern_snapshot_dec:\n");
    s = s.write("    movq 24(%rsp), %rax\n");      // new (return value)
    s = s.write("    movq 16(%rsp), %rcx\n");      // old
    s = s.write("    cmpq %rax, %rcx\n");          // old == new? (cow)
    s = s.write("    je .Lsd_ret\n");
    s = s.write("    movq 8(%rsp), %rdx\n");       // snap
    s = s.write("    cmpq %rdx, %rcx\n");          // old == snap? (caller's original)
    s = s.write("    je .Lsd_ret\n");
    s = s.write("    cmpq $0x10000, %rcx\n");      // low-addr / SSO sentinel
    s = s.write("    jb .Lsd_ret\n");
    s = s.write("    movl -8(%rcx), %esi\n");      // old rc
    s = s.write(san_poison_check("%esi"));
    s = s.write("    testl %esi, %esi\n");
    s = s.write("    js .Lsd_ret\n");              // static sentinel (rc<0)
    s = s.write("    cmpl $1, %esi\n");
    s = s.write("    jne .Lsd_ret\n");             // shared — leave (defensive)
    s = s.write("    movl -16(%rcx), %esi\n");     // old cap
    s = s.write("    addq $3, %rsi\n");            // words = cap + 3 (header)
    s = s.write("    cmpq $65536, %rsi\n");
