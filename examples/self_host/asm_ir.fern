    // calls __fern_arr_push, and — iff the result differs (grow) — pushes the old
    // box onto its size class (the arr_dec free path). Sound only because the
    // emitting site proved the slot unaliased (sole owner), so the superseded old
    // buffer has no surviving reference. This is the safe, gated form of the free
    // the shared __fern_arr_push must NOT do (see .Larr_push_grow). Closes the
    // dominant per-module self-compile leak (#3452 / #3425). Depends on
    // __fern_arr_push, so it shares arr_push's emit gate — the op handler marks the
    // arr_push need alongside arr_push_owned, so the two are always co-present, and
    // the per-module entry (which emits __fern_arr_push) gets this wrapper too
    // without threading a separate need through the union.
    if (s.has_need("arr_push") || s.has_need("maps")) {
        s = s.write("__fern_arr_push_owned:\n");
        s = s.write(arr_push_fast(".Lapo_slow"));
        s = s.write(".Lapo_slow:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");            // align stack to 16 for the call
        s = s.write("    movq %rdi, %r12\n");        // save old arr ptr
        // %rax = new (grew) or old (in place); the fast path already declined.
        if (rc_free_debug_on()) { s = s.write("    call __fern_arr_push\n"); } else { s = s.write("    call .Larr_push_slow\n"); }
        s = s.write("    cmpq %rax, %r12\n");
        s = s.write("    je .Lapo_ret\n");            // in place — nothing freed
        s = s.write("    cmpq $0x10000, %r12\n");     // grew: free the dead old box %r12
        s = s.write("    jb .Lapo_ret\n");            // low-addr / SSO sentinel
        s = s.write("    movl -8(%r12), %ecx\n");     // old rc
        s = s.write(san_poison_check("%ecx"));
        s = s.write("    testl %ecx, %ecx\n");
        s = s.write("    js .Lapo_ret\n");            // static sentinel (rc<0)
        s = s.write("    cmpl $1, %ecx\n");
        s = s.write("    jne .Lapo_ret\n");           // not sole owner — leave (defensive)
        s = s.write("    movl -16(%r12), %ecx\n");    // old cap
        s = s.write("    addq $3, %rcx\n");           // words = cap + 3 (header)
        s = s.write("    cmpq $65536, %rcx\n");
        s = s.write("    jae .Lapo_large\n");         // large tier -> recycle via __fern_large_push
        s = s.write(quarantine_rc("-8(%r12)"));
        s = s.write("    leaq -16(%r12), %rdx\n");    // old box base
        s = hev_free(s, "%rdx", "%rcx");
        if (!rc_free_debug_on()) {
        s = freelist_push(s, "%rdx", "%rcx", "%rdi");
        }
        s = s.write(".Lapo_ret:\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
        // Large tier (#3425): recycle the >=512 KiB superseded old buffer (base =
        // old-16, bytes = words*8) instead of leaking. %rax holds the return value
        // `new` and __fern_large_push clobbers it, so preserve it across the call;
        // %r12 is callee-saved.
        s = s.write(".Lapo_large:\n");
        s = s.write(quarantine_rc("-8(%r12)"));
        s = s.write("    leaq -16(%r12), %r8\n");     // base = old - 16
        s = s.write("    leaq 0(,%rcx,8), %rsi\n");   // bytes = words*8
        s = s.write("    pushq %rax\n");              // preserve return value (new)
        s = s.write("    call __fern_large_push\n");
        s = s.write("    popq %rax\n");
        s = s.write("    jmp .Lapo_ret\n");
    }

    // Map runtime (transcribed from asm.fern) — only for map-using modules, so a
    // non-map heap program doesn't pull in map_set's __fern_str_eq dependency.
    if (s.has_need("maps")) {
    // __fern_map_new (transcribed from asm.fern for the IR map path).
    s = s.write(".globl __fern_map_new\n");
    s = s.write(".type __fern_map_new, @function\n");
    s = s.write("__fern_map_new:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    subq $8, %rsp\n");
    s = s.write("    movq $2, %rdi\n");
    s = s.write("    call __fern_arr_box\n");      // mapbox: a counted two-word box
    s = s.write("    movq %rax, %rbx\n");
    s = s.write("    movq $0, %rdi\n");
    s = s.write("    call __fern_alloc_u8\n");      // empty keys
    s = s.write("    movq %rax, (%rbx)\n");
    s = s.write("    movq $0, %rdi\n");
    s = s.write("    call __fern_alloc_u8\n");      // empty values
    s = s.write("    movq %rax, 8(%rbx)\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_new, .-__fern_map_new\n");

    // __fern_map_snapshot_col(%rdi = column buffer) -> %rax = fresh rc=1 copy.
    // #4353 scalar keys()/values() snapshot: allocates a fresh __fern_arr_box
    // of the column's length (cap = len, rc = 1, len at data+0 — the same
    // layout arr_slice / array literals build), copies the len elements
    // (slots 1..len), and returns the copy. Kinds 131/132 call it for a
    // scalar (i32) column so the read result is an OWNED array: the exit
    // sweep's arr_dec reclaims the copy, and map_set's owned grow can free
    // the superseded live buffer without dangling the read. Elements are
    // copied bit-for-bit and NOT rc-inc'd — scalar columns only; the
    // string-column snapshot (element inc + deep free) is slice 3.
    s = s.write(".globl __fern_map_snapshot_col\n");
    s = s.write(".type __fern_map_snapshot_col, @function\n");
    s = s.write("__fern_map_snapshot_col:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq %rdi, %rbx\n");           // src column
    s = s.write("    movq (%rbx), %r12\n");         // len
    s = s.write("    movq %r12, %rdi\n");
    s = s.write("    call __fern_arr_box\n");       // -> data ptr (cap=len, rc=1, len=cap)
    s = s.write("    movq %r12, (%rax)\n");         // len = src len (cap == len already)
    s = s.write("    movq $1, %rcx\n");             // slot index 1..len
    s = s.write(".Lmsc_copy:\n");
    s = s.write("    cmpq %r12, %rcx\n");
    s = s.write("    jg .Lmsc_done\n");
    s = s.write("    movq (%rbx,%rcx,8), %rdx\n");
    s = s.write("    movq %rdx, (%rax,%rcx,8)\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lmsc_copy\n");
    s = s.write(".Lmsc_done:\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_snapshot_col, .-__fern_map_snapshot_col\n");

    // __fern_map_snapshot_col_str(%rdi = column buffer) -> %rax = fresh rc=1
    // copy with each STRING element retained (#4353 slice 3). Same box shape
    // as __fern_map_snapshot_col; after the bit copy, each element is
    // __fn___fern_rc_inc'd (its guards skip NULL / SSO-tagged / low-address /
    // static-literal values), so the snapshot co-owns every string and the
    // deep __fern_str_arr_free release (rc-aware per-element __fern_str_free,
    // dec each element, then the buffer) balances exactly. The map keeps its
    // own references — it stays a co-owner, exactly like an element read
    // through m.get() that gets stored.
    s = s.write(".globl __fern_map_snapshot_col_str\n");
    s = s.write(".type __fern_map_snapshot_col_str, @function\n");
    s = s.write("__fern_map_snapshot_col_str:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");                // dest (callee-saved across inc calls)
    s = s.write("    subq $8, %rsp\n");             // 16-byte align pad (rbp+3 pushes = odd)
    s = s.write("    movq %rdi, %rbx\n");           // src column
    s = s.write("    movq (%rbx), %r12\n");         // len
    s = s.write("    movq %r12, %rdi\n");
    s = s.write("    call __fern_arr_box\n");       // -> data ptr (cap=len, rc=1)
    s = s.write("    movq %r12, (%rax)\n");         // len = src len
    s = s.write("    movq %rax, %r13\n");           // dest
    s = s.write("    movq $1, %rcx\n");             // slot index 1..len
    s = s.write(".Lmscs_copy:\n");
    s = s.write("    cmpq %r12, %rcx\n");
    s = s.write("    jg .Lmscs_done\n");
    s = s.write("    movq (%rbx,%rcx,8), %rdx\n");
    s = s.write("    movq %rdx, (%r13,%rcx,8)\n");
    s = s.write("    pushq %rcx\n");                // save index across the call
    s = s.write("    pushq %rdx\n");                // stack arg for __fn___fern_rc_inc (arg at 8(%rsp)); rsp aligned
    s = s.write("    call __fn___fern_rc_inc\n");   // retain element (guards skip literals/SSO/null)
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lmscs_copy\n");
    s = s.write(".Lmscs_done:\n");
    s = s.write("    movq %r13, %rax\n");           // return dest
    s = s.write("    addq $8, %rsp\n");             // drop align pad
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_snapshot_col_str, .-__fern_map_snapshot_col_str\n");

    // __fern_map_set: probe with __fern_map_find, then overwrite or append.
    s = s.write(".globl __fern_map_set\n");
    s = s.write(".type __fern_map_set, @function\n");
    s = s.write("__fern_map_set:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r14\n");
    // %r9 = per-insert flag bits (bit 0 = kconsume: the incoming KEY is a
    // fresh, sole-owned string temp, from irlower's is_fresh_str_temp; bit 1 =
    // owncols: i32/string-column map whose keys()/values() reads ALL snapshot,
    // so the map solely owns its column buffers — #4353/#5335). Saved to the frame
    // because the __fern_map_find call clobbers caller-saved
    // %r9; bit 0 is reloaded at .Lms_found to free the DISCARDED new key on an
    // overwrite (the register twin of the wasm #4876 fix — a recurring computed
    // key, e.g. word-count `m.set(word, n)`, otherwise leaks one key box per
    // overwrite); bit 1 is reloaded at .Lms_append to pick the reclaim-on-grow
    // __fern_arr_push_owned over the leak-only __fern_arr_push.
    // %r10 (the value release of a column of boxes, vkind 3), %r11 (the key
    // release of a keyed column) and the key kind are saved beside the flag
    // bits; the four keep the frame 16-byte aligned for the inner calls.
    s = s.write("    pushq %r9\n");                 // saved flag bits @ -40(%rbp)
    s = s.write("    pushq %r10\n");                // saved value release @ -48(%rbp)
    s = s.write("    pushq %r11\n");                // saved key release @ -56(%rbp)
    s = s.write("    pushq %rcx\n");                // saved key kind @ -64(%rbp)
    s = s.write("    movq %rdi, %r12\n");          // mapbox
    s = s.write("    movq %rsi, %r13\n");          // key
    s = s.write("    movq %rdx, %r14\n");          // val
    // The key search is __fern_map_find's (#2649) — the one body the whole map
    // runtime shares, in place of the string / i32 / struct triple this
    // function, map_get and map_has each carried. Stack ABI: args pushed in
    // REVERSE so arg0 (the keys array) lands on top, four slots dropped after.
    // A miss answers -1, which is this function's append.
    s = s.write("    pushq %r8\n");                 // arg3 = derived K.eq, or 0
    s = s.write("    pushq %rcx\n");               // arg2 = keykind
    s = s.write("    pushq %rsi\n");               // arg1 = key
    s = s.write("    movq (%r12), %rax\n");        // arg0 = keys arr
    s = s.write("    pushq %rax\n");
    s = s.write("    call __fn___fern_map_find\n");
    s = s.write("    addq $32, %rsp\n");
    s = s.write("    movq %rax, %rbx\n");          // i, or -1 on a miss
    s = s.write("    cmpq $0, %rbx\n");
    s = s.write("    jl .Lms_append\n");
    s = s.write(".Lms_found:\n");
    // An overwrite REPLACES the value pointer, and the reclaim helper only ever
    // reaches entries still in the column, so a superseded value is freed here
    // or never (#9300). %r9 bits 2/3 name the column's release: the map owns one
    // unit per live entry, so releasing what it drops is exactly balanced. Both
    // helpers are rc-aware and null-safe. The slot address is recomputed after
    // the call rather than held across it; %r12 / %rbx / %r14 are callee-saved,
    // so the three inputs it is rebuilt from survive. vkind 0 — the AST path,
    // and any column the map does not own — skips the block entirely, which is
    // the historical behaviour.
    // Gated on the need, not just on the runtime flag: the `call
    // __fn___fern_str_arr_free` TEXT trips the negative asm-grep contracts
    // (strarr-elem-alias-excluded) in every unrelated program, the same reason
    // __fern_arrarr_free and __fern_strarrarr_free are need-gated above. A
    // program with no counted value column emits none of this.
    if (s.has_need("map_vfree")) {
    s = s.write("    movq -40(%rbp), %rcx\n");      // flag bits
    s = s.write("    testq $12, %rcx\n");           // bits 2|3 = vkind
    s = s.write("    jz .Lms_found_novf\n");
    s = s.write("    movq 8(%r12), %rax\n");        // values arr
    s = s.write("    movq %rbx, %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    pushq (%rax,%rdx,8)\n");       // superseded value
    s = s.write("    testq $8, %rcx\n");
    s = s.write("    jz .Lms_found_vs\n");           // vkind 1: a string
    s = s.write("    testq $4, %rcx\n");
    s = s.write("    jz .Lms_found_vsa\n");          // vkind 2: a string array
    s = s.write("    movq -48(%rbp), %r11\n");       // vkind 3: the named release
    s = s.write("    call *%r11\n");
    s = s.write("    jmp .Lms_found_vfdone\n");
    s = s.write(".Lms_found_vs:\n");
    s = s.write("    call __fn___fern_str_free\n");
    s = s.write("    jmp .Lms_found_vfdone\n");
    s = s.write(".Lms_found_vsa:\n");
    s = s.write("    call __fn___fern_str_arr_free\n");
    s = s.write(".Lms_found_vfdone:\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write(".Lms_found_novf:\n");
    }
    s = s.write("    movq 8(%r12), %rax\n");        // values arr
    s = s.write("    movq %rbx, %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq %r14, (%rax,%rdx,8)\n");  // values[i+1] = val
    // Overwrite keeps the EXISTING key; the incoming key %r13 is discarded. When
    // it is a fresh sole-owned temp (kconsume), free it — a string key via the
    // rc-aware __fern_str_free (a literal's .rodata data / an aliased rc>1 key
    // are handled safely by str_free's guards), a keyed column's box via the
    // key release the op site passed, or the shallow dec when it passed none —
    // so a recurring computed key doesn't leak. An aliased key (kconsume 0) is
    // left untouched — its source local's sweep owns it. Every release here
    // preserves %r12/%r13, so the mapbox return is intact.
    s = s.write("    movq -40(%rbp), %rax\n");      // reload flag bits
    s = s.write("    testq $1, %rax\n");            // bit 0 = kconsume
    s = s.write("    jz .Lms_found_nokf\n");
    s = s.write("    pushq %r13\n");                // discarded fresh key
    s = s.write("    cmpq $2, -64(%rbp)\n");        // keyed column?
    s = s.write("    jne .Lms_found_kstr\n");
    s = s.write("    movq -56(%rbp), %r11\n");      // the key release
    s = s.write("    testq %r11, %r11\n");
    s = s.write("    jz .Lms_found_kbox\n");
    s = s.write("    call *%r11\n");
    s = s.write("    jmp .Lms_found_kfdone\n");
    s = s.write(".Lms_found_kbox:\n");
    s = s.write("    call __fn___fern_arr_dec\n");
    s = s.write("    jmp .Lms_found_kfdone\n");
    s = s.write(".Lms_found_kstr:\n");
    s = s.write("    call __fn___fern_str_free\n");
    s = s.write(".Lms_found_kfdone:\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write(".Lms_found_nokf:\n");
    s = s.write("    jmp .Lms_ret\n");
    s = s.write(".Lms_append:\n");
    // owncols (flag bit 1, #4353/#5335): a map whose columns ALL snapshot on
    // read — i32 columns via __fern_map_snapshot_col (kinds 131/132 flag 0),
    // string columns via __fern_map_snapshot_col_str (flag 2) — is the sole
    // owner of its column buffers, so route the appends through the
    // reclaim-on-grow __fern_arr_push_owned (frees the superseded rc==1
    // buffer, closing the cap-0 grow-leak #4877). Flag-1 alias columns
    // (i64/f64/struct/generic view) keep the LEAK-ONLY __fern_arr_push: their
    // keys()/values() still return the RAW keys@0 / vals@8 buffer (an
    // uncounted alias), and arr_push_owned would free the buffer a live
    // `var vs = m.values()` still points to (use-after-free).
    s = s.write("    movq -40(%rbp), %rax\n");      // reload flag bits
    s = s.write("    testq $2, %rax\n");            // bit 1 = owncols
    s = s.write("    jnz .Lms_append_owned\n");
    s = s.write("    movq (%r12), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    call __fern_arr_push\n");      // keys.append(key)
    s = s.write("    movq %rax, (%r12)\n");
    s = s.write("    movq 8(%r12), %rdi\n");
    s = s.write("    movq %r14, %rsi\n");
    s = s.write("    call __fern_arr_push\n");      // values.append(val)
    s = s.write("    movq %rax, 8(%r12)\n");
    s = s.write("    jmp .Lms_ret\n");
    s = s.write(".Lms_append_owned:\n");
    s = s.write("    movq (%r12), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    call __fern_arr_push_owned\n"); // keys.append(key), frees old buffer on grow
    s = s.write("    movq %rax, (%r12)\n");
    s = s.write("    movq 8(%r12), %rdi\n");
    s = s.write("    movq %r14, %rsi\n");
    s = s.write("    call __fern_arr_push_owned\n"); // values.append(val), frees old buffer on grow
    s = s.write("    movq %rax, 8(%r12)\n");
    s = s.write(".Lms_ret:\n");
    s = s.write("    movq %r12, %rax\n");
    s = s.write("    addq $32, %rsp\n");            // discard the saved key kind, releases and flag bits
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_set, .-__fern_map_set\n");
    // __fern_map_get + __fern_map_has: __fern_map_find plus an Option box /
    // a boolean. Both are thin over the shared search now (#2649).
    s = s.write(".globl __fern_map_get\n");
    s = s.write(".type __fern_map_get, @function\n");
    s = s.write("__fern_map_get:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    movq %rdi, %r12\n");          // mapbox
    // Key search via __fern_map_find (#2649). Stack ABI: args pushed in
    // REVERSE so arg0 (the keys array) lands on top, four slots dropped after.
    s = s.write("    pushq %r8\n");                 // arg3 = derived K.eq, or 0
    s = s.write("    pushq %rdx\n");               // arg2 = keykind
    s = s.write("    pushq %rsi\n");               // arg1 = key
    s = s.write("    movq (%r12), %rax\n");        // arg0 = keys arr
    s = s.write("    pushq %rax\n");
    s = s.write("    call __fn___fern_map_find\n");
    s = s.write("    addq $32, %rsp\n");
    s = s.write("    cmpq $0, %rax\n");
    s = s.write("    jl .Lmg_none\n");
    s = s.write("    movq 8(%r12), %rcx\n");        // values arr
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%rcx,%rax,8), %r13\n");   // values[i+1]
    s = s.write("    movq $2, %rdi\n");
    s = s.write("    call __fern_arr_box\n");        // Some box (rc-headered)
    s = s.write("    movq $0, (%rax)\n");
    s = s.write("    movq %r13, 8(%rax)\n");
    s = s.write("    jmp .Lmg_ret\n");
    s = s.write(".Lmg_none:\n");
    s = s.write("    movq $2, %rdi\n");
    s = s.write("    call __fern_arr_box\n");        // None box (rc-headered)
    s = s.write("    movq $1, (%rax)\n");
    s = s.write("    movq $0, 8(%rax)\n");
    s = s.write(".Lmg_ret:\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_get, .-__fern_map_get\n");
    s = s.write(".globl __fern_map_has\n");
    s = s.write(".type __fern_map_has, @function\n");
    s = s.write("__fern_map_has:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    // Same __fern_map_find call as map_get (#2649); only the answer differs,
    // so nothing here outlives the call and the frame holds no saved registers.
    s = s.write("    pushq %r8\n");                 // arg3 = derived K.eq, or 0
    s = s.write("    pushq %rdx\n");               // arg2 = keykind
    s = s.write("    pushq %rsi\n");               // arg1 = key
    s = s.write("    movq (%rdi), %rax\n");        // arg0 = keys arr
    s = s.write("    pushq %rax\n");
    s = s.write("    call __fn___fern_map_find\n");
    s = s.write("    addq $32, %rsp\n");
    s = s.write("    cmpq $0, %rax\n");
    s = s.write("    jl .Lmh_no\n");
    s = s.write("    movq $1, %rax\n");
    s = s.write("    jmp .Lmh_ret\n");
    s = s.write(".Lmh_no:\n");
    s = s.write("    movq $0, %rax\n");
    s = s.write(".Lmh_ret:\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_has, .-__fern_map_has\n");
    // __fern_map_delete is now a Fern runtime function (#2649): see
    // asmcore.rt_src_map_delete, lowered through the IR pipeline as
    // __fn___fern_map_delete. The op site passes the derived-eq address as an
    // ordinary stack argument rather than in %r8.
    }

    // __fern_i32_to_string is now a Fern runtime function (#2649): emitted
    // entry-only via emit_ir_runtime_fern_fn (lowered through the IR pipeline as
    // __fn___fern_i32_to_string, using the raw-memory intrinsics), not a
    // hand-written body here. See the emit_ir_runtime_fern_fn call in
    // emit_module_ir_unit's entry block.

    // __fern_chr is now a Fern runtime function (#2649): see asmcore.rt_src_chr,
    // lowered through the IR pipeline via emit_ir_runtime_fern_fn in the entry
    // block (using the raw-memory intrinsics). No longer hand-rolled here.

    // No static `.bss` heap reservation: the arena is mmap'd lazily on the
    // first __fern_alloc call (see the .bss block + __fern_alloc above), so
    // the binary is linker-agnostic (issue #4081). Mirrors what the retired x86 AST emitter did.
    return s;
}

// ir_bin_asm renders the asm for one IR binary op (lhs in %rax, rhs in %rcx,
// result in %rax) — mirroring asm.fern's own ExprBinary sequences (64-bit,
// signed i32 div/cmp) so the two paths agree exactly.
// `d` holds the left operand and takes the result; `r` holds the right and
// must be %rcx for the shifts, which read their count from %cl. The stack
// machine passes %rax and %rcx; the register path passes its own working
// register, since %rax is a value home there.
function ir_bin_asm(tag: i32, width: i32, d: string, r: string): string {
    if (tag == 21) { return "    addq " + r + ", " + d + "\n"; }
    if (tag == 22) { return "    subq " + r + ", " + d + "\n"; }
    if (tag == 23) {
        // The in-process assembler encodes imul with an immediate only in its
        // three-operand form.
        if (r[0] == 36) { return "    imulq " + r + ", " + d + ", " + d + "\n"; }
        return "    imulq " + r + ", " + d + "\n";
    }
    // div_s / rem_s / div_u / rem_u are NOT handled here — the op loop routes
    // them through ir_div_guarded (below) so a divide-by-zero / INT_MIN/-1 does
    // not raise #DE. The language contract is total, never-trapping (#4329).
    if (tag == 28) { return "    andq " + r + ", " + d + "\n"; }
    if (tag == 29) { return "    orq " + r + ", " + d + "\n"; }
    if (tag == 30) { return "    xorq " + r + ", " + d + "\n"; }
    // Shift counts mask to the operand width: mod 64 for i64 (the q-form masks
    // %cl to 6 bits in hardware), mod 32 for i32/u32. A 32-bit i32 shift used
    // to emit the q-form, so a count >= 32 wrapped mod 64 instead of mod 32
    // (#4330). Fix by masking the count to 5 bits BUT keeping the 64-bit shift
    // instruction, so the operand's slot extension is preserved: a u32 value is
    // zero-extended (bit 63 = 0) and an i32 value sign-extended (bit 63 = bit
    // 31), and `sarq`/`shrq`/`shlq` on the full register does the right thing for
    // both. (A 32-bit `sarl` would fill from bit 31, corrupting a u32 `>>` —
    // which lowers through shr_s — whose bit 31 is a data bit, not a sign bit.)
    if (width == 64) {
        if (tag == 31) { return "    shlq %cl, " + d + "\n"; }
        if (tag == 32) { return "    sarq %cl, " + d + "\n"; }
        if (tag == 33) { return "    shrq %cl, " + d + "\n"; }
    }
    if (tag == 31) { return "    andl $31, %ecx\n    shlq %cl, " + d + "\n"; }
    if (tag == 32) { return "    andl $31, %ecx\n    sarq %cl, " + d + "\n"; }
    if (tag == 33) { return "    andl $31, %ecx\n    shrq %cl, " + d + "\n"; }
    if (tag == 35) { return "    cmpq " + r + ", " + d + "\n    sete " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    if (tag == 36) { return "    cmpq " + r + ", " + d + "\n    setne " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    if (tag == 37) { return "    cmpq " + r + ", " + d + "\n    setl " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    if (tag == 38) { return "    cmpq " + r + ", " + d + "\n    setle " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    if (tag == 39) { return "    cmpq " + r + ", " + d + "\n    setg " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    if (tag == 40) { return "    cmpq " + r + ", " + d + "\n    setge " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    // Unsigned 64-bit compares (u64, #2904): same cmpq, but the below/above
    // setcc family reads CF instead of SF/OF — correct once bit 63 is set.
    if (tag == 41) { return "    cmpq " + r + ", " + d + "\n    setb " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    if (tag == 42) { return "    cmpq " + r + ", " + d + "\n    setbe " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    if (tag == 43) { return "    cmpq " + r + ", " + d + "\n    seta " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    if (tag == 44) { return "    cmpq " + r + ", " + d + "\n    setae " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    return ircore.unsupported_op_refuse(tag, "x86-64");
}

// ir_cmp_jcc names the conditional jump an integer comparison feeds when its
// result goes straight to a branch: the mnemonic that fires when the comparison
// holds (when_true) or its inverse. `cmpq %rcx, %rax` has already set the flags,
// so the signed/unsigned split is the same one ir_bin_asm's setcc family makes.
function ir_cmp_jcc(tag: i32, when_true: boolean): string {
    var direct: string = "";
    var neg: string = "";
    if (tag == 35) { direct = "je"; neg = "jne"; }
    else if (tag == 36) { direct = "jne"; neg = "je"; }
    else if (tag == 37) { direct = "jl"; neg = "jge"; }
    else if (tag == 38) { direct = "jle"; neg = "jg"; }
    else if (tag == 39) { direct = "jg"; neg = "jle"; }
    else if (tag == 40) { direct = "jge"; neg = "jl"; }
    else if (tag == 41) { direct = "jb"; neg = "jae"; }
    else if (tag == 42) { direct = "jbe"; neg = "ja"; }
    else if (tag == 43) { direct = "ja"; neg = "jbe"; }
    else { direct = "jae"; neg = "jb"; }  // ge_u
    if (when_true) { return direct; }
    return neg;
}

// shift_imm_asm is one shift by a known count into `d`, the mask folded into
// the immediate at the operand's width; the count comes from the allocator's
// immediate table.
function shift_imm_asm(tag: i32, width: i32, count: i64, d: string): string {
    var k: i32 = (count as i32) & 31;
    if (width == 64) { k = (count as i32) & 63; }
    var imm: string = " $" + util.i32_to_string(k) + ", " + d + "\n";
    if (tag == 31) { return "    shlq" + imm; }
    if (tag == 32) { return "    sarq" + imm; }
    return "    shrq" + imm;
}

// DivRegs names the accumulator, scratch and high registers, and the size
// suffix, at a divide's width. i32 uses the l-forms on the low halves — dirty
// upper bits cannot reach a 32-bit divide, so nothing has to be widened first.
struct DivRegs {
    a: string,
    c: string,
    d: string,
    sfx: string,
    bits: i32,
}

function div_regs(w64: boolean): DivRegs {
    if (w64) { return DivRegs { a: "%rax", c: "%rcx", d: "%rdx", sfx: "q", bits: 64 }; }
    return DivRegs { a: "%eax", c: "%ecx", d: "%edx", sfx: "l", bits: 32 };
}

// ir_div_guarded renders a non-trapping div or rem by a divisor only known at
// run time (dividend in %rax, divisor in %rcx, result in %rax). x86 idiv/div
// raise #DE (SIGFPE) on a zero divisor and on INT_MIN/-1 overflow, but the
// language contract (docs/INTEGER-SEMANTICS.md) is total: x/0 = 0, x%0 = x,
// INT_MIN/-1 = INT_MIN, INT_MIN%-1 = 0. Guard both faults inline, mirroring
// native emitIntDivRem. `lb` is a per-op-unique label base (loop prefix + op
// index). (#4329)
function ir_div_guarded(tag: i32, width: i32, lb: string): string {
    var r: DivRegs = div_regs(width == 64);
    var s: string = "    test" + r.sfx + " " + r.c + ", " + r.c + "\n";
    if (tag == 25 || tag == 27) {
        // Unsigned (u32/u64, #2904): only the divide-by-zero fault to guard —
        // unsigned division has no overflow case.
        var divide: string = "    xorl %edx, %edx\n    div" + r.sfx + " " + r.c + "\n";
        if (tag == 25) {
            s = s + "    jz " + lb + "_dz\n" + divide;
            s = s + "    jmp " + lb + "_dn\n";
            s = s + lb + "_dz:\n    xorl %eax, %eax\n";
        } else {
            s = s + "    jz " + lb + "_dn\n" + divide;      // divisor 0 -> rem = dividend (rax)
            s = s + "    mov" + r.sfx + " " + r.d + ", " + r.a + "\n";
        }
        return s + lb + "_dn:\n";
    }
    var idivide: string = "    cqto\n    idivq %rcx\n";
    if (width != 64) { idivide = "    cltd\n    idivl %ecx\n"; }
    var cmp_neg1: string = "    cmp" + r.sfx + " $-1, " + r.c + "\n";
    if (tag == 24) {
        s = s + "    jz " + lb + "_dz\n";                                    // /0 -> 0
        s = s + cmp_neg1 + "    je " + lb + "_ng\n" + idivide;               // /-1 -> -dividend (wraps at INT_MIN)
        s = s + "    jmp " + lb + "_dn\n";
        s = s + lb + "_ng:\n    neg" + r.sfx + " " + r.a + "\n    jmp " + lb + "_dn\n";
        s = s + lb + "_dz:\n    xorl %eax, %eax\n";
    } else {
        s = s + "    jz " + lb + "_dn\n";                                    // %0 -> dividend (rax)
        s = s + cmp_neg1 + "    je " + lb + "_z0\n" + idivide;               // %-1 -> 0
        s = s + "    mov" + r.sfx + " " + r.d + ", " + r.a + "\n    jmp " + lb + "_dn\n";
        s = s + lb + "_z0:\n    xorl %eax, %eax\n";
    }
    s = s + lb + "_dn:\n";
    // An i32 result is stored sign-extended in its 64-bit slot.
    if (width != 64) { s = s + "    cltq\n"; }
    return s;
}

// ---- division by a literal divisor (native emitConstDivRem) --------------
//
// A divide whose right operand is an integer constant (ssa.Imms.konst) knows
// its divisor, which collapses most of what ir_div_guarded spends its
// instructions on: both guards branch on a value that is now a compile-time
// constant, a power of two needs no divide at all, and any other divisor
// takes the multiply-high reciprocal.

// pow2_shift_i64 gives sh when `mag`, read as an unsigned 64-bit bit pattern,
// is 2^sh, and -1 otherwise.
function pow2_shift_i64(mag: i64): i32 {
    if (mag == 0i64 || (mag & (mag - 1i64)) != 0i64) { return 0 - 1; }
    var sh: i32 = 0;
    while ((1i64 << sh) != mag) { sh = sh + 1; }
    return sh;
}

// ir_div_const renders `dividend / k` or `dividend % k` for the literal k
// (dividend in %rax, result in %rax); tag is div_s / div_u / rem_s / rem_u.
function ir_div_const(tag: i32, width: i32, k: i64): string {
    var w64: boolean = (width == 64);
    var uns: boolean = (tag == 25 || tag == 27);
    var body: string = ir_div_const_body(w64, uns, tag == 26 || tag == 27, k);
    // An i32 result is stored sign-extended in its 64-bit slot; the l-forms
    // zero-extend, which is already the u32 convention.
    if (!w64 && !uns) { body = body + "    cltq\n"; }
    return body;
}

function ir_div_const_body(w64: boolean, uns: boolean, is_rem: boolean, k: i64): string {
    var r: DivRegs = div_regs(w64);
    // Normalise the divisor's magnitude. Unsigned reads the literal's bit
    // pattern at the operand width; signed keeps the sign for the negation a
    // negative divisor's quotient needs at the end.
    var mag: i64 = k;
    var neg: boolean = false;
    if (uns) {
        if (!w64) { mag = ((k as i32) as i64) & 4294967295i64; }
    } else {
        var v: i64 = k;
        if (!w64) { v = (k as i32) as i64; }
        var min: i64 = -2147483648i64;
        if (w64) { min = -9223372036854775808i64; }
        // The most negative divisor has no positive magnitude, so it takes the
        // divide rather than a negation that wraps.
        if (v == min) { return ir_div_const_generic(r, uns, is_rem, k); }
        if (v < 0i64) { neg = true; mag = 0i64 - v; } else { mag = v; }
    }
    if (mag == 0i64) {
        // x / 0 = 0, x % 0 = x: the guarded sequence's zero arm, with no branch to reach it.
        if (is_rem) { return ""; }
        return "    xorl %eax, %eax\n";
    }
    if (mag == 1i64) {
        // x % ±1 = 0. x / 1 = x. x / -1 = -x, and INT_MIN / -1 keeps the
        // contract's answer because `neg` wraps to INT_MIN itself.
        if (is_rem) { return "    xorl %eax, %eax\n"; }
        if (neg) { return "    neg" + r.sfx + " " + r.a + "\n"; }
        return "";
    }
    var sh: i32 = pow2_shift_i64(mag);
    // Signed stops one short of the sign bit: the bias needs 2^sh to be a
    // positive value at the operand width.
    var max_sh: i32 = r.bits - 2;
    if (uns) { max_sh = r.bits - 1; }
    if (sh >= 0 && sh <= max_sh) { return ir_div_const_pow2(r, uns, is_rem, neg, sh); }
    return ir_div_const_magic(r, uns, is_rem, k);
}

// ir_div_const_pow2 is division or remainder by 2^sh. Signed division by a
// power of two is NOT an arithmetic shift: `sar` rounds toward negative
// infinity and the language rounds toward zero, so -1/2 would be -1 rather
// than 0. Biasing the dividend by 2^sh-1 when it is negative — what the
// sar/shr pair computes branchlessly — makes the shift round the right way.
function ir_div_const_pow2(r: DivRegs, uns: boolean, is_rem: boolean, neg: boolean, sh: i32): string {
    var shs: string = util.i32_to_string(sh);
    if (uns) {
        if (is_rem) { return mask_low_bits(r, r.a, sh, true); }
        return "    shr" + r.sfx + " $" + shs + ", " + r.a + "\n";
    }
    var s: string = "    mov" + r.sfx + " " + r.a + ", " + r.c + "\n";
    s = s + "    sar" + r.sfx + " $" + util.i32_to_string(r.bits - 1) + ", " + r.c + "\n";   // all ones iff negative
    s = s + "    shr" + r.sfx + " $" + util.i32_to_string(r.bits - sh) + ", " + r.c + "\n";  // 2^sh-1 iff negative
    s = s + "    add" + r.sfx + " " + r.a + ", " + r.c + "\n";                              // biased dividend
    if (is_rem) {
        // r = x - (x/2^sh)*2^sh, and the multiply is a mask.
        s = s + mask_low_bits(r, r.c, sh, false);
        return s + "    sub" + r.sfx + " " + r.c + ", " + r.a + "\n";
    }
    s = s + "    mov" + r.sfx + " " + r.c + ", " + r.a + "\n";
    s = s + "    sar" + r.sfx + " $" + shs + ", " + r.a + "\n";
    if (neg) { s = s + "    neg" + r.sfx + " " + r.a + "\n"; }
    return s;
}

// mask_low_bits keeps (keep) or clears the low sh bits of reg. `and` takes an
// imm32, so a mask past bit 31 is a shift pair instead.
function mask_low_bits(r: DivRegs, reg: string, sh: i32, keep: boolean): string {
    if (keep && sh <= 31) {
        return "    and" + r.sfx + " $" + util.i64_to_string((1i64 << sh) - 1i64) + ", " + reg + "\n";
    }
    if (keep) {
        var back: string = util.i32_to_string(r.bits - sh);
        return "    shl" + r.sfx + " $" + back + ", " + reg + "\n    shr" + r.sfx + " $" + back + ", " + reg + "\n";
    }
    if (sh <= 31) {
        return "    and" + r.sfx + " $" + util.i64_to_string(0i64 - (1i64 << sh)) + ", " + reg + "\n";
    }
    var shs: string = util.i32_to_string(sh);
    return "    shr" + r.sfx + " $" + shs + ", " + reg + "\n    shl" + r.sfx + " $" + shs + ", " + reg + "\n";
}

// ir_div_const_magic is division or remainder by a divisor that is neither
// 0, ±1 nor a power of two: the reciprocal from ir.derive_magic_*. A divide
// is 20-40 cycles at 32 bits and up to 90 at 64, where the multiply and shift
// are about five.
//
// The one-operand imul / mul multiply the accumulator by their operand and
// leave the high half in %edx / %rdx, so the DIVIDEND goes in %ecx and the
// MAGIC in %eax — the product is the same either way, and that ordering leaves
// the dividend intact in %ecx for the fixup and for a remainder's
// multiply-back.
function ir_div_const_magic(r: DivRegs, uns: boolean, is_rem: boolean, k: i64): string {
    var x: string = r.sfx;
    var s: string = "    mov" + x + " " + r.a + ", " + r.c + "\n";
    var load: string = "    movl $";
    if (r.bits == 64) { load = "    movabsq $"; }
    var d: i64 = k;
    if (r.bits == 32) { d = (k as i32) as i64; }
    if (uns) {
        var mu: ir.MagicU = ir.derive_magic_u((k as u64) & ((0u64 - 1u64) >> ((64 - r.bits) as u64)), r.bits);
        var m: i64 = mu.m as i64;
        if (r.bits == 32) { m = ((mu.m as u32) as i32) as i64; }
        s = s + load + util.i64_to_string(m) + ", " + r.a + "\n    mul" + x + " " + r.c + "\n";
        if (!mu.add) {
            s = s + "    shr" + x + " $" + util.i32_to_string(mu.s) + ", " + r.d + "\n    mov" + x + " " + r.d + ", " + r.a + "\n";
        } else {
            // A magic one bit wider than the word. Averaging the dividend and
            // the high half by shifting keeps the carry a plain add would drop
            // off the top.
            s = s + "    mov" + x + " " + r.c + ", " + r.a + "\n    sub" + x + " " + r.d + ", " + r.a + "\n";
            s = s + "    shr" + x + " $1, " + r.a + "\n    add" + x + " " + r.d + ", " + r.a + "\n";
            s = s + "    shr" + x + " $" + util.i32_to_string(mu.s - 1) + ", " + r.a + "\n";
        }
    } else {
        var ms: ir.MagicS = ir.derive_magic_s(d, r.bits);
        s = s + load + util.i64_to_string(ms.m) + ", " + r.a + "\n    imul" + x + " " + r.c + "\n";
        if (ms.add) { s = s + "    add" + x + " " + r.c + ", " + r.d + "\n"; }
        if (ms.sub) { s = s + "    sub" + x + " " + r.c + ", " + r.d + "\n"; }
        if (ms.s != 0) { s = s + "    sar" + x + " $" + util.i32_to_string(ms.s) + ", " + r.d + "\n"; }
        // The shift floors, so a negative quotient is one too low.
        s = s + "    mov" + x + " " + r.d + ", " + r.a + "\n    shr" + x + " $" + util.i32_to_string(r.bits - 1) + ", " + r.d + "\n";
        s = s + "    add" + x + " " + r.d + ", " + r.a + "\n";
    }
    if (is_rem) {
        // r = x - (x / d) * d, with the dividend still in %ecx. imul takes at
        // most a 32-bit immediate.
        if (d == ((d as i32) as i64)) {
            s = s + "    imul" + x + " $" + util.i64_to_string(d) + ", " + r.a + ", " + r.a + "\n";
        } else {
            s = s + "    movabsq $" + util.i64_to_string(d) + ", %rdx\n    imulq %rdx, %rax\n";
        }
        s = s + "    sub" + x + " " + r.a + ", " + r.c + "\n    mov" + x + " " + r.c + ", " + r.a + "\n";
    }
    return s;
}

// ir_div_const_generic is the divide itself, for the most negative divisor,
// which has no positive magnitude to take a reciprocal of: the guarded
// sequence with both guards and all four labels gone, since the divisor is
// neither zero nor -1.
function ir_div_const_generic(r: DivRegs, uns: boolean, is_rem: boolean, k: i64): string {
    var s: string = "    movl $" + util.i64_to_string(k) + ", %ecx\n";
    if (r.bits == 64) { s = "    movabsq $" + util.i64_to_string(k) + ", %rcx\n"; }
    if (uns) { s = s + "    xorl %edx, %edx\n    div" + r.sfx + " " + r.c + "\n"; }
    else if (r.bits == 64) { s = s + "    cqto\n    idivq %rcx\n"; }
    else { s = s + "    cltd\n    idivl %ecx\n"; }
    if (is_rem) { s = s + "    mov" + r.sfx + " " + r.d + ", " + r.a + "\n"; }
    return s;
}

// ir_fround renders __round_f64 — round-half-AWAY-from-zero (Go's math.Round).
// roundsd only offers ties-to-even / floor / ceil / trunc, so the answer is
// built from trunc plus an exact fractional-part test, mirroring native
// emitF64UnaryIntrinsic:
//
//     t = trunc(x); if (|x - t| >= 0.5) { t = t + copysign(1.0, x); }
//
// x - t is exact by construction, which the shorter trunc(x + copysign(0.5, x))
// identity is not: the addition rounds first, so it answered 1 for
// 0.5 - 2^-54 and shifted EVERY integral double at or above 2^52 by one (#7880).
// The ucomisd/jb pair also carries NaN and the infinities through untouched —
// their |x - t| is NaN, which leaves CF set, so the bump is skipped.
// `lb` is a per-op-unique label base.
function ir_fround_rax(lb: string, d: string): string {
    var s: string = "    movq " + d + ", %xmm0\n";                                   // x
    s = s + "    roundsd $3, %xmm0, %xmm1\n";                                  // t = trunc(x)
    s = s + "    subsd %xmm1, %xmm0\n";                                        // frac = x - t
    s = s + "    movq %xmm0, %rcx\n    movabsq $0x7fffffffffffffff, %rdx\n    andq %rdx, %rcx\n";
    s = s + "    movq %rcx, %xmm0\n";                                          // |frac|
    s = s + "    movabsq $0x3fe0000000000000, %rcx\n    movq %rcx, %xmm2\n";    // 0.5
    s = s + "    ucomisd %xmm2, %xmm0\n    jb " + lb + "_rdone\n";
    s = s + "    movq " + d + ", %rcx\n    movabsq $0x8000000000000000, %rdx\n    andq %rdx, %rcx\n";
    s = s + "    movabsq $0x3ff0000000000000, %rdx\n    orq %rdx, %rcx\n";      // copysign(1.0, x)
    s = s + "    movq %rcx, %xmm0\n    addsd %xmm0, %xmm1\n";
    s = s + lb + "_rdone:\n    movq %xmm1, " + d + "\n";
    return s;
}

// ir_f2i_sat renders a saturating f64 -> signed integer truncation (operand
// bits on the rt-stack, result on the rt-stack). x86 cvttsd2si is NOT
// saturating — it returns the 0x8000.. "integer indefinite" on NaN/overflow
// and otherwise wraps — but the contract (docs/FLOAT-SEMANTICS.md) is total:
// NaN -> 0, +overflow -> INT_MAX, -overflow -> INT_MIN. Mirror native
// emitFloatToIntSat. `lb` is a per-op-unique label base. width is 32 or 64. (#4332)
function ir_f2i_sat_rax(width: i32, lb: string, d: string): string {
    if (width != 64) {
        // i32: clamp the DOUBLE into [INT32_MIN, INT32_MAX] (as f64 bit
        // patterns) so cvttsd2si never hits its sentinel, after an explicit
        // NaN -> 0. minsd/maxsd here are safe because NaN is already handled.
        var s: string = "    movq " + d + ", %xmm0\n";
        s = s + "    ucomisd %xmm0, %xmm0\n    jp " + lb + "_nan\n";
        s = s + "    movabsq $0x41dfffffffc00000, %rcx\n    movq %rcx, %xmm1\n    minsd %xmm1, %xmm0\n";   // INT32_MAX as f64
        s = s + "    movabsq $0xc1e0000000000000, %rcx\n    movq %rcx, %xmm1\n    maxsd %xmm1, %xmm0\n";   // INT32_MIN as f64
        s = s + "    cvttsd2si %xmm0, " + ssa_r32(d) + "\n    movslq " + ssa_r32(d) + ", " + d + "\n    jmp " + lb + "_done\n";
        s = s + lb + "_nan:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
        s = s + lb + "_done:\n";
        return s;
    }
    // i64: cvttsd2si is exact for in-range values; only NaN and |x| >= 2^63
    // yield the INT64_MIN sentinel. On the sentinel, disambiguate via x:
    // NaN -> 0, x > 0 -> INT64_MAX, else keep INT64_MIN (also the correct
    // answer for the exact -2^63 input).
    var s64: string = "    movq " + d + ", %xmm0\n    cvttsd2si %xmm0, " + d + "\n";
    s64 = s64 + "    movabsq $0x8000000000000000, %rcx\n    cmpq %rcx, " + d + "\n    jne " + lb + "_done\n";
    s64 = s64 + "    ucomisd %xmm0, %xmm0\n    jp " + lb + "_nan\n";
    s64 = s64 + "    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm0\n    jbe " + lb + "_done\n";
    s64 = s64 + "    movabsq $0x7fffffffffffffff, " + d + "\n    jmp " + lb + "_done\n";
    s64 = s64 + lb + "_nan:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n";
    s64 = s64 + lb + "_done:\n";
    return s64;
}

// ir_f2u_sat renders a saturating f64 -> UNSIGNED integer truncation (#4332)
// — the unsigned sibling of ir_f2i_sat, mirroring native emitFloatToIntSat's
// unsigned shapes: NaN / x < 0 -> 0, x >= 2^width -> all-ones. `lb` is a
// per-op-unique label base. width is 32 or 64.
function ir_f2u_sat_rax(width: i32, lb: string, d: string): string {
    if (width != 64) {
        // u32: convert with 64-bit headroom (rax covers the whole u32 range
        // exactly), then clamp against the ORIGINAL float: x < 0 / NaN -> 0
        // (ucomisd sets CF on less-than AND on unordered, so one jb catches
        // both), x >= 2^32 -> u32::MAX.
        var s: string = "    movq " + d + ", %xmm0\n    cvttsd2si %xmm0, " + d + "\n";
        s = s + "    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm0\n    jb " + lb + "_zero\n";
        s = s + "    movabsq $0x41f0000000000000, %rcx\n    movq %rcx, %xmm1\n";   // 2^32 as f64
        s = s + "    ucomisd %xmm1, %xmm0\n    jae " + lb + "_max\n    jmp " + lb + "_done\n";
        s = s + lb + "_zero:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n    jmp " + lb + "_done\n";
        s = s + lb + "_max:\n    movl $0xffffffff, " + ssa_r32(d) + "\n";                        // zero-extends into rax
        s = s + lb + "_done:\n";
        return s;
    }
    // u64: cvttsd2si only covers [0, 2^63); for x >= 2^63 convert x - 2^63 and
    // set bit 63 back. The original x is saved in xmm2 (the subtraction
    // mutates xmm0) and the edge clamps compare against it: x < 0 / NaN -> 0,
    // x >= 2^64 -> u64::MAX.
    var u: string = "    movq " + d + ", %xmm0\n    movaps %xmm0, %xmm2\n";
    u = u + "    movabsq $0x43e0000000000000, %rcx\n    movq %rcx, %xmm1\n";       // 2^63 as f64
    u = u + "    ucomisd %xmm1, %xmm0\n    jae " + lb + "_big\n";
    u = u + "    cvttsd2si %xmm0, " + d + "\n    jmp " + lb + "_sat\n";
    u = u + lb + "_big:\n    subsd %xmm1, %xmm0\n    cvttsd2si %xmm0, " + d + "\n";
    u = u + "    movabsq $0x8000000000000000, %rcx\n    xorq %rcx, " + d + "\n";
    u = u + lb + "_sat:\n    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm2\n    jb " + lb + "_zero\n";
    u = u + "    movabsq $0x43f0000000000000, %rcx\n    movq %rcx, %xmm1\n";       // 2^64 as f64
    u = u + "    ucomisd %xmm1, %xmm2\n    jae " + lb + "_umax\n    jmp " + lb + "_done\n";
    u = u + lb + "_zero:\n    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n    jmp " + lb + "_done\n";
    u = u + lb + "_umax:\n    movq $-1, " + d + "\n";
    u = u + lb + "_done:\n";
    return u;
}

// emit_str_op emits one string operand-stack op (the bodies factored out of
// emit_stack_op's dispatch — see ir.is_str_op_kind). Each pops its box
// operand(s), calls the matching __fern_str_* runtime, and pushes the result;
// the mark_* needs pull in the helper bodies (emit_ir_runtime).
// emit_mismatch_x86 emits the __mismatch kernel (#8791): operand stack
// [a box, ao, b box, bo, n] (n on top) -> the offset of the first byte where
// a[ao..ao+n) and b[bo..bo+n) differ, or the clamped n when they are equal.
//
// SSE2, 16 bytes of each operand an iteration: movdqu / pcmpeqb / pmovmskb,
// where the mask means EQUAL rather than memchr's FOUND, so the loop runs
// while it is all-ones and `not` precedes the bsf.
//
// Sub-16 ranges take memcmp's OVERLAPPING WINDOWS rather than the scalar
// remainder — the leading and trailing 8 (or 4) bytes, which overlap, so two
// loads per operand cover the whole band. A line-oriented caller compares
// SHORT ranges, and walking those a byte at a time is the cost this kernel
// exists to remove.
//
// The clamps are the op's contract, not defensive tidying: the value returned
// on equality is the clamped n, so a caller asking for more than either range
// holds gets the shorter answer and its `== n` test fails.
//
// %rsi and %rcx become the two range base POINTERS and %rdx the shared cursor
// index, which keeps every memory operand on a low register; %r8 holds the
// clamped n (also the answer on equality) and %rdi is the window offset.
// This is a leaf body — no call, so every register it touches is free.
function emit_mismatch_x86(s: asmcore.EmitState): asmcore.EmitState {
    var mlo: asmcore.LabelOut = asmcore.fresh_label(s);
    var lb: string = mlo.name;
    s = mlo.state;
    s = s.write("    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rax\n");
    s = s.write("    movq 8(%rax), %r9\n    movq (%rax), %rax\n");
    s = s.write("    movq 8(%rdx), %r10\n    movq (%rdx), %rdx\n");
    // Each offset clamps into [0, len] of its own string.
    s = s.write("    cmpq $0, %rsi\n    jge " + lb + "_aop\n    xorq %rsi, %rsi\n");
    s = s.write(lb + "_aop:\n    cmpq %r9, %rsi\n    jle " + lb + "_aok\n    movq %r9, %rsi\n");
    s = s.write(lb + "_aok:\n    cmpq $0, %rcx\n    jge " + lb + "_bop\n    xorq %rcx, %rcx\n");
    s = s.write(lb + "_bop:\n    cmpq %r10, %rcx\n    jle " + lb + "_bok\n    movq %r10, %rcx\n");
    // n = min(n, len(a) - ao, len(b) - bo), floored at 0.
    s = s.write(lb + "_bok:\n    subq %rsi, %r9\n    subq %rcx, %r10\n");
    s = s.write("    cmpq %r9, %r8\n    jle " + lb + "_na\n    movq %r9, %r8\n");
    s = s.write(lb + "_na:\n    cmpq %r10, %r8\n    jle " + lb + "_nb\n    movq %r10, %r8\n");
    s = s.write(lb + "_nb:\n    cmpq $0, %r8\n    jge " + lb + "_nok\n    xorq %r8, %r8\n");
    s = s.write(lb + "_nok:\n    addq %rax, %rsi\n    addq %rdx, %rcx\n    xorq %rdx, %rdx\n");
    // Length dispatch: the sub-16 band never reaches the vector loop, so it
    // gets its own windows rather than a byte walk.
    s = s.write("    cmpq $16, %r8\n    jge " + lb + "_vec\n");
    s = s.write("    cmpq $8, %r8\n    jge " + lb + "_w8\n");
    s = s.write("    cmpq $4, %r8\n    jge " + lb + "_w4\n    jmp " + lb + "_tail\n");
    // 8..15 bytes: the leading 8 and the trailing 8, which overlap.
    s = s.write(lb + "_w8:\n    movq (%rsi), %rax\n    xorq (%rcx), %rax\n    jnz " + lb + "_w8l\n");
    s = s.write("    movq %r8, %rdi\n    subq $8, %rdi\n");
    s = s.write("    movq (%rsi,%rdi), %rax\n    xorq (%rcx,%rdi), %rax\n    jz " + lb + "_eq\n");
    // The leading window proved [0, 8) equal, so a difference the trailing
    // window reports cannot land below 8 — its offset is the first one.
    s = s.write("    bsfq %rax, %rax\n    shrq $3, %rax\n    addq %rdi, %rax\n    jmp " + lb + "_done\n");
    // bsf finds the lowest set BIT of the xor; >> 3 turns it into the byte,
    // little-endian, so byte 0 is the low one.
    s = s.write(lb + "_w8l:\n    bsfq %rax, %rax\n    shrq $3, %rax\n    jmp " + lb + "_done\n");
    // 4..7 bytes: the same pair of windows, four bytes wide.
    s = s.write(lb + "_w4:\n    movl (%rsi), %eax\n    xorl (%rcx), %eax\n    jnz " + lb + "_w4l\n");
    s = s.write("    movq %r8, %rdi\n    subq $4, %rdi\n");
    s = s.write("    movl (%rsi,%rdi), %eax\n    xorl (%rcx,%rdi), %eax\n    jz " + lb + "_eq\n");
    s = s.write("    bsfl %eax, %eax\n    shrl $3, %eax\n    addq %rdi, %rax\n    jmp " + lb + "_done\n");
    s = s.write(lb + "_w4l:\n    bsfl %eax, %eax\n    shrl $3, %eax\n    jmp " + lb + "_done\n");
    // SSE2 loop, 16 bytes of each operand per iteration. The load runs only
    // with a full block left in both ranges, so it never reads past either.
    s = s.write(lb + "_vec:\n    movq %r8, %rax\n    subq %rdx, %rax\n    cmpq $16, %rax\n    jl " + lb + "_tail\n");
    s = s.write("    movdqu (%rsi,%rdx), %xmm0\n    movdqu (%rcx,%rdx), %xmm1\n");
    s = s.write("    pcmpeqb %xmm1, %xmm0\n    pmovmskb %xmm0, %eax\n");
    s = s.write("    cmpl $65535, %eax\n    jne " + lb + "_hit\n");
    s = s.write("    addq $16, %rdx\n    jmp " + lb + "_vec\n");
    // pmovmskb writes only the low 16 bits, so `not` sets the top half; the
    // branch above guarantees a clear bit below 16, which is the one bsf
    // finds first.
    s = s.write(lb + "_hit:\n    notl %eax\n    bsfl %eax, %eax\n    addq %rdx, %rax\n    jmp " + lb + "_done\n");
    // Scalar remainder: fewer than 16 bytes left after the vector loop, or
    // fewer than 4 from the dispatch above.
    s = s.write(lb + "_tail:\n    cmpq %r8, %rdx\n    jge " + lb + "_eq\n");
    s = s.write("    movzbq (%rsi,%rdx), %rax\n    movzbq (%rcx,%rdx), %rdi\n");
    s = s.write("    cmpq %rdi, %rax\n    jne " + lb + "_th\n");
    s = s.write("    addq $1, %rdx\n    jmp " + lb + "_tail\n");
    s = s.write(lb + "_th:\n    movq %rdx, %rax\n    jmp " + lb + "_done\n");
    s = s.write(lb + "_eq:\n    movq %r8, %rax\n");
    s = s.write(lb + "_done:\n    pushq %rax\n");
    return s;
}

function emit_str_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind_tag == 225) {  // memchr
        // operand stack [box, byte, from] (from on top) -> i32 index or -1.
        //
        // The needle is splat across xmm1 and broadcast to ymm1; then 32
        // bytes an iteration with AVX2 while at least 32 remain, 16 with
        // SSE2 while at least 16 remain, and a scalar tail — the same three
        // tiers as native's __fern_memchr. Each vector load runs only with a
        // whole block left, so it never reads past the string and needs no
        // alignment prologue; the tail is the whole algorithm for anything
        // shorter than one block. vzeroupper on every way out of the AVX
        // loop, since the SSE loop and the caller are legacy-SSE code.
        //
        // The cursor is an INDEX in %rdx rather than a pointer, which keeps
        // the sequence inside the five registers the scalar body used (%rax
        // data, %rcx byte, %rdx cursor, %r8 len, %r9 scratch): no end pointer
        // to hold and no index to reconstruct on a hit.
        //
        // No feature detection: AVX2 and popcnt are inside the x86-64-v3
        // baseline, hard requirements rather than a fast path.
        var mlo: asmcore.LabelOut = asmcore.fresh_label(s);
        var l_clamped: string = mlo.name;
        var mlo2: asmcore.LabelOut = asmcore.fresh_label(mlo.state);
        var l_vec: string = mlo2.name;
        var mlo3: asmcore.LabelOut = asmcore.fresh_label(mlo2.state);
        var l_hit: string = mlo3.name;
        var mlo4: asmcore.LabelOut = asmcore.fresh_label(mlo3.state);
        var l_tail: string = mlo4.name;
        var mlo5: asmcore.LabelOut = asmcore.fresh_label(mlo4.state);
        var l_none: string = mlo5.name;
        var mlo6: asmcore.LabelOut = asmcore.fresh_label(mlo5.state);
        var l_done: string = mlo6.name;
        var mlo7: asmcore.LabelOut = asmcore.fresh_label(mlo6.state);
        var l_avx: string = mlo7.name;
        var mlo8: asmcore.LabelOut = asmcore.fresh_label(mlo7.state);
        var l_hit32: string = mlo8.name;
        var mlo9: asmcore.LabelOut = asmcore.fresh_label(mlo8.state);
        var l_avx_done: string = mlo9.name;
        s = mlo9.state;
        s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n");
        s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
        // from clamps at 0.
        s = s.write("    cmpq $0, %rdx\n    jge " + l_clamped + "\n    xorq %rdx, %rdx\n");
        s = s.write(l_clamped + ":\n");
        // A byte outside 0..255 can never match. One UNSIGNED compare covers
        // both ends: a negative arrives as a huge unsigned and fails it too.
        // Checked once here, so neither loop needs a per-iteration guard.
        s = s.write("    cmpq $255, %rcx\n    ja " + l_none + "\n");
        // Broadcast the needle byte across xmm1, then ymm1.
        s = s.write("    movd %ecx, %xmm1\n    punpcklbw %xmm1, %xmm1\n");
        s = s.write("    punpcklwd %xmm1, %xmm1\n    pshufd $0, %xmm1, %xmm1\n");
        s = s.write("    vpbroadcastb %xmm1, %ymm1\n");
        s = s.write(l_avx + ":\n");
        s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
        s = s.write("    cmpq $32, %r9\n    jl " + l_avx_done + "\n");
        s = s.write("    vmovdqu (%rax,%rdx), %ymm0\n    vpcmpeqb %ymm1, %ymm0, %ymm0\n");
        s = s.write("    vpmovmskb %ymm0, %r9d\n    testl %r9d, %r9d\n    jnz " + l_hit32 + "\n");
        s = s.write("    addq $32, %rdx\n    jmp " + l_avx + "\n");
        s = s.write(l_hit32 + ":\n    vzeroupper\n    bsfl %r9d, %r9d\n    addq %r9, %rdx\n    jmp " + l_done + "\n");
        s = s.write(l_avx_done + ":\n    vzeroupper\n");
        s = s.write(l_vec + ":\n");
        s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
        s = s.write("    cmpq $16, %r9\n    jl " + l_tail + "\n");
        s = s.write("    movdqu (%rax,%rdx), %xmm0\n    pcmpeqb %xmm1, %xmm0\n");
        s = s.write("    pmovmskb %xmm0, %r9d\n    testl %r9d, %r9d\n    jnz " + l_hit + "\n");
        s = s.write("    addq $16, %rdx\n    jmp " + l_vec + "\n");
        // bsf gives the lane of the lowest set mask bit — the first matching
        // byte in this block.
        s = s.write(l_hit + ":\n    bsfl %r9d, %r9d\n    addq %r9, %rdx\n    jmp " + l_done + "\n");
        // Scalar tail: fewer than 16 bytes left, and the whole algorithm for a
        // string shorter than one block.
        s = s.write(l_tail + ":\n");
        s = s.write("    cmpq %r8, %rdx\n    jge " + l_none + "\n");
        s = s.write("    movzbq (%rax,%rdx), %r9\n");
        s = s.write("    cmpq %rcx, %r9\n    je " + l_done + "\n");
        s = s.write("    addq $1, %rdx\n    jmp " + l_tail + "\n");
        s = s.write(l_none + ":\n    movq $-1, %rdx\n");
        s = s.write(l_done + ":\n    pushq %rdx\n");
        return s;
    }
    if (o.kind_tag == 234) {  // rmemchr
        // operand stack [box, byte, from] (from on top) -> the index of the
        // LAST `byte` at or before `from`, or -1.
        //
        // memchr's tiers walking DOWN: 32 bytes an iteration with AVX2, then
        // 16 with SSE2, then a scalar tail. The block ENDING at the cursor
        // is loaded at `cursor - 31` (`- 15`), and the mask is scanned with
        // **bsr** rather than bsf, because the HIGHEST set bit is the
        // rightmost matching byte. That one instruction is the entire
        // difference from the memchr body above; splat, load, compare and
        // gather are identical.
        //
        // In the SSE2 loop the base index and its address are carried across
        // iterations and stepped by 16 rather than recomputed from the
        // cursor: measured on the native twin, recomputing cost about a
        // third of the loop. The forward kernel never pays this — it walks
        // UP from a pointer it already holds.
        //
        // The clamp is memchr's mirrored: a forward scan clamps `from` UP to
        // 0, a backward scan clamps it DOWN to len-1, so a negative `from`
        // finds nothing here.
        var rlo: asmcore.LabelOut = asmcore.fresh_label(s);
        var r_ok: string = rlo.name;
        var rlo2: asmcore.LabelOut = asmcore.fresh_label(rlo.state);
        var r_vec: string = rlo2.name;
        var rlo3: asmcore.LabelOut = asmcore.fresh_label(rlo2.state);
        var r_hit: string = rlo3.name;
        var rlo4: asmcore.LabelOut = asmcore.fresh_label(rlo3.state);
        var r_step: string = rlo4.name;
        var rlo5: asmcore.LabelOut = asmcore.fresh_label(rlo4.state);
        var r_tail: string = rlo5.name;
        var rlo6: asmcore.LabelOut = asmcore.fresh_label(rlo5.state);
        var r_loop: string = rlo6.name;
        var rlo7: asmcore.LabelOut = asmcore.fresh_label(rlo6.state);
        var r_none: string = rlo7.name;
        var rlo8: asmcore.LabelOut = asmcore.fresh_label(rlo7.state);
        var r_done: string = rlo8.name;
        var rlo9: asmcore.LabelOut = asmcore.fresh_label(rlo8.state);
        var r_avx: string = rlo9.name;
        var rlo10: asmcore.LabelOut = asmcore.fresh_label(rlo9.state);
        var r_hit32: string = rlo10.name;
        var rlo11: asmcore.LabelOut = asmcore.fresh_label(rlo10.state);
        var r_avx_done: string = rlo11.name;
        s = rlo11.state;
        s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n");
        s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
        // A byte outside 0..255 can never match. One UNSIGNED compare covers
        // both ends, checked once so neither loop needs a per-iteration guard.
        s = s.write("    cmpq $255, %rcx\n    ja " + r_none + "\n");
        // Clamp `from` down to the last index; an empty string has none.
        s = s.write("    subq $1, %r8\n    cmpq $0, %r8\n    jl " + r_none + "\n");
        s = s.write("    cmpq %r8, %rdx\n    jle " + r_ok + "\n    movq %r8, %rdx\n");
        s = s.write(r_ok + ":\n");
        // Broadcast the needle byte across xmm1, then ymm1.
        s = s.write("    movd %ecx, %xmm1\n    punpcklbw %xmm1, %xmm1\n");
        s = s.write("    punpcklwd %xmm1, %xmm1\n    pshufd $0, %xmm1, %xmm1\n");
        s = s.write("    vpbroadcastb %xmm1, %ymm1\n");
        // Each AVX2 iteration covers the 32 bytes ENDING at the cursor,
        // [rdx-31, rdx], while a whole block fits below it; the 16-byte loop
        // takes over from whatever cursor is left, negative included. That
        // bound keeps the load in bounds at the LOW end, where memchr's "32
        // or more left" keeps it in bounds at the high end.
        s = s.write(r_avx + ":\n");
        s = s.write("    cmpq $31, %rdx\n    jl " + r_avx_done + "\n");
        s = s.write("    movq %rdx, %r9\n    subq $31, %r9\n");
        s = s.write("    vmovdqu (%rax,%r9), %ymm0\n    vpcmpeqb %ymm1, %ymm0, %ymm0\n");
        s = s.write("    vpmovmskb %ymm0, %r11d\n    testl %r11d, %r11d\n    jnz " + r_hit32 + "\n");
        s = s.write("    subq $32, %rdx\n    jmp " + r_avx + "\n");
        // bsr gives the LAST match in the block.
        s = s.write(r_hit32 + ":\n    vzeroupper\n    bsrl %r11d, %r11d\n");
        s = s.write("    movq %r9, %rdx\n    addq %r11, %rdx\n    jmp " + r_done + "\n");
        s = s.write(r_avx_done + ":\n    vzeroupper\n");
        s = s.write("    cmpq $15, %rdx\n    jl " + r_tail + "\n");
        s = s.write("    movq %rdx, %r9\n    subq $15, %r9\n");   // block base index
        s = s.write("    movq %rax, %r10\n    addq %r9, %r10\n"); // block address
        s = s.write(r_vec + ":\n");
        s = s.write("    movdqu (%r10), %xmm0\n    pcmpeqb %xmm1, %xmm0\n");
        s = s.write("    pmovmskb %xmm0, %r11d\n    testl %r11d, %r11d\n    jnz " + r_hit + "\n");
        s = s.write("    subq $16, %r9\n    cmpq $0, %r9\n    jge " + r_step + "\n");
