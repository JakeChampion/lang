            // emits exactly the per-type bodies actually called; needs the heap
            // runtime (the freelist + __fn___fern_arr_dec it frees through).
            if (is_struct_drop_name(o.str)) { s = s.need("heap"); s = s.need("struct_drop:" + struct_drop_type(o.str)); }
            s = s.write("    call " + ir_helper_symbol(o.str) + "\n");
            if (o.i32_imm > 0) { s = s.write("    addq $" + util.i32_to_string(o.i32_imm * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind_tag == 149) {  // call_direct
            // User call: the IR pushes args left-to-right (arg0 deepest);
            // asm.fern's stack ABI wants arg0 on TOP (param[i] at +16+i*8(%rbp)).
            // Reverse the argc on-stack slots, call, pop the args, push %rax.
            var argc: i32 = o.i32_imm;
            // FFI __c_call<n> (#4375): a normal call to the shim __fn___c_call<n>
            // (emitted by emit_ir_runtime). Register its need so the body is
            // emitted; the shim reads its params off the stack ABI like any
            // callee and marshals them into the C-ABI registers.
            if (is_c_call(o.str)) { s = s.need("ccall:" + o.str); }
            var h: i32 = 0;
            while (h < argc / 2) {
                var lo: i32 = h * 8;
                var hi: i32 = (argc - 1 - h) * 8;
                s = s.write("    movq " + util.i32_to_string(lo) + "(%rsp), %rax\n");
                s = s.write("    movq " + util.i32_to_string(hi) + "(%rsp), %rcx\n");
                s = s.write("    movq %rax, " + util.i32_to_string(hi) + "(%rsp)\n");
                s = s.write("    movq %rcx, " + util.i32_to_string(lo) + "(%rsp)\n");
                h = h + 1;
            }
            s = s.write("    call __fn_" + asmcore.sanitize_label(o.str) + "\n");
            if (argc > 0) { s = s.write("    addq $" + util.i32_to_string(argc * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind_tag == 147) {  // dyn_dispatch
            // `dyn Trait` method call. Receiver (arg0) + args are spilled in argc
            // consecutive locals from base_slot. Read the receiver's shape pointer
            // and dispatch to the matching `<Type>.<method>` — a compare-branch
            // chain over every module method named o.str with a struct receiver,
            // mirroring asm.fern's dyn dispatch. Each matched arm pushes the argc
            // locals (arg0/receiver on top, asm.fern's ABI) and calls.
            var dbase: i32 = o.i32_imm;
            var dargc: i32 = o.width;
            s = s.write("    movq " + util.i32_to_string(0 - 8 * (dbase + 1)) + "(%rbp), %rax\n");
            s = s.write("    movq (%rax), %rcx\n");
            var dend: string = lp + "dynend" + util.i32_to_string(i);
            var dfi: i32 = 0;
            var darmn: i32 = 0;
            while (dfi < s.funcs.len()) {
                var dfd: parser.FuncDecl = s.funcs[dfi];
                var ddbn: string = util.base_type_name(dfd.receiver_type);
                // Dispatch arms: every method named o.str whose receiver is a
                // struct (value carries its shape) OR a primitive/string (value
                // is heap-boxed at coercion — docs/DYN-TRAITS.md §4.2.3). A
                // primitive arm UNBOXES: the receiver local holds the box pointer,
                // so arg0 is reloaded from box+8, not pushed directly.
                var dprim: boolean = dfd.receiver_type.len() > 0 && asmcore.is_prim_recv_name(ddbn, s);
                if (dfd.name == o.str && dfd.receiver_type.len() > 0
                        && (asmcore.is_struct_decl_name(ddbn, s) || dprim)) {
                    var dbn: string = ddbn;
                    var dlit: ShapeRefOut = shape_ref(s, dbn);
                    s = dlit.state;
                    var dnext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
                    s = s.write("    leaq " + dlit.label + "(%rip), %rdx\n");
                    s = s.write("    cmpq %rdx, %rcx\n");
                    s = s.write("    jne " + dnext + "\n");
                    var dk: i32 = dargc - 1;
                    while (dk >= 0) {
                        if (dk == 0 && dprim) {
                            // arg0 is the receiver: unbox the value from box+8.
                            s = s.write("    movq " + util.i32_to_string(0 - 8 * (dbase + 1)) + "(%rbp), %rax\n");
                            s = s.write("    pushq 8(%rax)\n");
                        } else {
                            s = s.write("    pushq " + util.i32_to_string(0 - 8 * (dbase + dk + 1)) + "(%rbp)\n");
                        }
                        dk = dk - 1;
                    }
                    s = s.write("    call __fn_" + asmcore.sanitize_label(dbn + "." + dfd.name) + "\n");
                    s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
                    s = s.write("    pushq %rax\n");
                    s = s.write("    jmp " + dend + "\n");
                    s = s.write(dnext + ":\n");
                    darmn = darmn + 1;
                }
                // ENUM-receiver arm (`impl Trait for <Enum>`, #4785): an enum
                // value's offset-0 shape is its VARIANT's interned shape
                // (struct_make with the variant name — the same identity
                // op_variant_is reads), never the enum name itself, so the
                // struct-arm compare above can never identify it. Match the
                // receiver against EVERY variant of the enum; on any hit call
                // `<Enum>.<method>` with the variant box as the receiver (its
                // body's `match (self)` re-reads the variant). Keyed
                // per-variant — not a blanket last-arm fallback like the AST
                // backend's — so two enums implementing the same trait
                // dispatch to their own impls. recv_is_array excludes an
                // array method's `T[]` receiver (base_type_name strips the
                // `[]`, which would otherwise mis-read as an enum — #2766).
                if (dfd.name == o.str && dfd.receiver_type.len() > 0
                        && !asmcore.recv_is_array(dfd.receiver_type)
                        && irlower.decl_is_enum(s.struct_decls, ddbn)) {
                    var dehit: string = lp + "dynehit" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
                    var denext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
                    var dvi: i32 = 0;
                    while (dvi < s.struct_decls.len()) {
                        if (s.struct_decls[dvi].enum_owner == ddbn) {
                            var vlit: ShapeRefOut = shape_ref(s, s.struct_decls[dvi].name);
                            s = vlit.state;
                            s = s.write("    leaq " + vlit.label + "(%rip), %rdx\n");
                            s = s.write("    cmpq %rdx, %rcx\n");
                            s = s.write("    je " + dehit + "\n");
                        }
                        dvi = dvi + 1;
                    }
                    s = s.write("    jmp " + denext + "\n");
                    s = s.write(dehit + ":\n");
                    var dek: i32 = dargc - 1;
                    while (dek >= 0) {
                        s = s.write("    pushq " + util.i32_to_string(0 - 8 * (dbase + dek + 1)) + "(%rbp)\n");
                        dek = dek - 1;
                    }
                    s = s.write("    call __fn_" + asmcore.sanitize_label(ddbn + "." + dfd.name) + "\n");
                    s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
                    s = s.write("    pushq %rax\n");
                    s = s.write("    jmp " + dend + "\n");
                    s = s.write(denext + ":\n");
                    darmn = darmn + 1;
                }
                dfi = dfi + 1;
            }
            s = s.write("    pushq $0\n");   // fallback (unreachable for a valid dyn value)
            s = s.write(dend + ":\n");
        } else if (o.kind_tag == 146) {  // dyn_box
            // Heap-box a primitive/string value coerced into a `dyn Trait` slot
            // (docs/DYN-TRAITS.md §4.2.3). Cell = [shape@0, value@8], 2 words;
            // shape = the interned primitive type name (the SAME .S label struct
            // shapes use), so op_dyn_dispatch's offset-0 compare matches. The
            // cell is rc-HEADERED via __fern_arr_box(cap=2) — exactly like
            // opt_make — so a fresh, non-escaping prim/string dyn local can be
            // freed by the exit sweep's __fern_rc_dec (#4351; the former raw
            // __fern_alloc cell had no header, so it could never be reclaimed).
            // Offsets unchanged (arr_box's len@0 is overwritten by the shape;
            // cap@data-16 drives the free size). The value (one word — an
            // i32/i64/f64 scalar OR a string box pointer) is on the operand
            // stack; alloc first (it survives on the machine stack, like
            // opt_make), then store shape + value, push the cell pointer.
            var dbl: ShapeRefOut = shape_ref(s, o.str);
            s = dbl.state;
            s = s.write("    movq $2, %rdi\n    call __fern_arr_box\n");
            s = s.write("    leaq " + dbl.label + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");
        } else if (o.kind_tag == 148) {  // dyn_downcast
            // `e as? T` downcast (docs/DYN-TRAITS.md §9). The `dyn` value (a heap
            // pointer carrying its concrete shape @0) is on top of the operand
            // (machine) stack. Read its shape and compare to T's interned shape
            // (the SAME .S label struct_make / dyn_dispatch use, so pointer
            // identity holds): equal → Some(value) box [tag0@0, payload@8]; else
            // → None box [tag1@0, 0@8] — the ordinary Option box `match` reads.
            // The dyn value rides the machine stack across __fern_alloc (like
            // opt_make/dyn_box), so the hit path reuses it as the Some payload.
            var dcl: ShapeRefOut = shape_ref(s, o.str);
            s = dcl.state;
            var dcmiss: string = lp + "dcmiss" + util.i32_to_string(i);
            var dcend: string = lp + "dcend" + util.i32_to_string(i);
            s = s.write("    movq (%rsp), %rax\n");        // peek dyn ptr (left on stack)
            s = s.write("    movq (%rax), %rcx\n");        // shape @0
            s = s.write("    leaq " + dcl.label + "(%rip), %rdx\n");
            s = s.write("    cmpq %rdx, %rcx\n    jne " + dcmiss + "\n");
            // hit: Some(value) — pop the dyn ptr as payload.
            s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
            s = s.write("    movq $0, (%rax)\n");
            s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");
            s = s.write("    jmp " + dcend + "\n");
            // miss: None — discard the dyn ptr, build a payloadless tag-1 box.
            s = s.write(dcmiss + ":\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
            s = s.write("    movq $1, (%rax)\n    movq $0, 8(%rax)\n    pushq %rax\n");
            s = s.write(dcend + ":\n");
        } else if (o.kind_tag == 6) {  // const_func
            // A function VALUE is the function's code address — push it. Register
            // backends need no funcref table (unlike wasm's table index): the
            // address is the value, dispatched directly by call_indirect.
            s = s.write("    leaq __fn_" + asmcore.sanitize_label(o.str) + "(%rip), %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 150) {  // call_indirect
            // Indirect call through a function value: the stack holds
            // [arg0(deepest) … argN-1, fn_addr(top)]. Pop the target into a
            // scratch reg, reverse the args so arg0 is on TOP (the stack-arg ABI
            // the callee reads at +16+i*8(%rbp)), call through the pointer, pop
            // the args, push the result. Same arg discipline as call_direct.
            var icargc: i32 = o.i32_imm;
            s = s.write("    popq %r11\n");
            var ih: i32 = 0;
            while (ih < icargc / 2) {
                var ilo: i32 = ih * 8;
                var ihi: i32 = (icargc - 1 - ih) * 8;
                s = s.write("    movq " + util.i32_to_string(ilo) + "(%rsp), %rax\n");
                s = s.write("    movq " + util.i32_to_string(ihi) + "(%rsp), %rcx\n");
                s = s.write("    movq %rax, " + util.i32_to_string(ihi) + "(%rsp)\n");
                s = s.write("    movq %rcx, " + util.i32_to_string(ilo) + "(%rsp)\n");
                ih = ih + 1;
            }
            s = s.write("    call *%r11\n");
            if (icargc > 0) { s = s.write("    addq $" + util.i32_to_string(icargc * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind_tag == 4) {  // const_f64
            // Float literal: GAS assembles the source text to an IEEE double in
            // .rodata; load its bits and push them (floats flow on the rt-stack
            // as their 8-byte bit pattern, like i64). Mirrors asm.fern.
            var flb: asmcore.LabelOut = asmcore.fresh_label(s);
            s = flb.state;
            s = s.write("    .section .rodata\n" + flb.name + ": .double " + o.str + "\n    .text\n");
            s = s.write("    movsd " + flb.name + "(%rip), %xmm0\n    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 11) {  // i32_to_f64
            // signed i32 -> f64 (cvtsi2sd); value rides the stack as bits.
            s = s.write("    popq %rax\n    cvtsi2sd %rax, %xmm0\n    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 12) {  // f64_to_i32
            // Saturating f64 -> i32 / u32 (#4332); needs a per-op-unique label base.
            if (o.unsigned) { s = s.write(ir_f2u_sat(32, lp + util.i32_to_string(i))); }
            else { s = s.write(ir_f2i_sat(32, lp + util.i32_to_string(i))); }
        } else if (o.kind_tag == 13) {  // f64_to_i64
            // Saturating f64 -> i64 / u64 (#4332).
            if (o.unsigned) { s = s.write(ir_f2u_sat(64, lp + util.i32_to_string(i))); }
            else { s = s.write(ir_f2i_sat(64, lp + util.i32_to_string(i))); }
        } else if (o.kind_tag == 16 || o.kind_tag == 17) {  // f64_bits, f64_from_bits
            // No-op reinterpret: the 8-byte rt-stack slot already holds the
            // IEEE-754 bit pattern, identical to the i64 bits.
        } else if (o.kind_tag == 14) {  // f32_bits
            // f64 -> f32 (cvtsd2ss), take the 32-bit pattern, sign-extend into
            // the 64-bit slot.
            s = s.write("    popq %rax\n    movq %rax, %xmm0\n    cvtsd2ss %xmm0, %xmm0\n    movd %xmm0, %eax\n    movsxd %eax, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 15) {  // f32_from_bits
            // interpret the low 32 bits as an IEEE-754 f32 and widen to f64.
            s = s.write("    popq %rax\n    movd %eax, %xmm0\n    cvtss2sd %xmm0, %xmm0\n    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 45 || o.kind_tag == 46 || o.kind_tag == 47 || o.kind_tag == 48) {  // fadd, fsub, fmul, fdiv
            // f64 arithmetic: pop rhs/lhs bits into xmm1/xmm0, op, push result.
            s = s.write("    popq %rax\n    movq %rax, %xmm1\n    popq %rax\n    movq %rax, %xmm0\n");
            if (o.kind_tag == 45) { s = s.write("    addsd %xmm1, %xmm0\n"); }  // fadd
            else if (o.kind_tag == 46) { s = s.write("    subsd %xmm1, %xmm0\n"); }  // fsub
            else if (o.kind_tag == 47) { s = s.write("    mulsd %xmm1, %xmm0\n"); }  // fmul
            else { s = s.write("    divsd %xmm1, %xmm0\n"); }
            s = s.write("    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 66) {  // fpow
            // pow(x, y) = x^y = 2^(y·log2 x) on the x87 FPU (x > 0): fyl2x gives
            // t = y·log2(x), then the f2xm1 + fscale reconstruction of 2^t.
            // Mirrors asm.fern's __pow_f64. fbin pops rhs (y) then lhs (x).
            s = s.write("    popq %rcx\n    popq %rax\n");        // y, x
            s = s.write("    subq $16, %rsp\n");
            s = s.write("    movq %rax, (%rsp)\n");               // x
            s = s.write("    movq %rcx, 8(%rsp)\n");              // y
            s = s.write("    fldl 8(%rsp)\n");                    // st0 = y
            s = s.write("    fldl (%rsp)\n");                     // st0 = x, st1 = y
            s = s.write("    fyl2x\n");                           // t = y·log2(x)
            s = s.write("    fld %st(0)\n");
            s = s.write("    frndint\n");                         // n = round(t)
            s = s.write("    fsubr %st, %st(1)\n");               // st1 = t - n = f
            s = s.write("    fxch %st(1)\n");
            s = s.write("    f2xm1\n");
            s = s.write("    fld1\n");
            s = s.write("    faddp\n");
            s = s.write("    fscale\n");
            s = s.write("    fstp %st(1)\n");
            s = s.write("    fstpl (%rsp)\n");
            s = s.write("    movq (%rsp), %rax\n");
            s = s.write("    addq $16, %rsp\n    pushq %rax\n");
        } else if (o.kind_tag == 64 || o.kind_tag == 65 || o.kind_tag == 62 || o.kind_tag == 63) {  // fsin, fcos, fexp, flog
            // f64 transcendentals on the x87 FPU (the -nostdlib backend can't link
            // libm; x87 computes these directly). The operand bits ride a scratch
            // stack slot (x87 loads from memory, not xmm). exp(x) = 2^(x·log2 e)
            // via f2xm1 + fscale; log(x) = ln2·log2(x) via fyl2x. Mirrors asm.fern.
            s = s.write("    popq %rax\n    subq $8, %rsp\n    movq %rax, (%rsp)\n");
            if (o.kind_tag == 64) { s = s.write("    fldl (%rsp)\n    fsin\n    fstpl (%rsp)\n"); }  // fsin
            else if (o.kind_tag == 65) { s = s.write("    fldl (%rsp)\n    fcos\n    fstpl (%rsp)\n"); }  // fcos
            else if (o.kind_tag == 63) { s = s.write("    fldln2\n    fldl (%rsp)\n    fyl2x\n    fstpl (%rsp)\n"); }  // flog
            else {
                s = s.write("    fldl2e\n    fmull (%rsp)\n");     // t = x·log2(e)
                s = s.write("    fld %st(0)\n    frndint\n");      // n = round(t)
                s = s.write("    fsubr %st, %st(1)\n    fxch %st(1)\n"); // st0=f, st1=n
                s = s.write("    f2xm1\n    fld1\n    faddp\n");   // 2^f
                s = s.write("    fscale\n    fstp %st(1)\n");      // 2^f · 2^n
                s = s.write("    fstpl (%rsp)\n");
            }
            s = s.write("    movq (%rsp), %rax\n    addq $8, %rsp\n    pushq %rax\n");
        } else if (o.kind_tag == 57 || o.kind_tag == 59 || o.kind_tag == 58 || o.kind_tag == 60) {  // fsqrt, ffloor, fceil, ftrunc
            // f64 unary math (op_funary): pop the operand bits into xmm0, apply the
            // single SSE instruction, push. roundsd needs SSE4.1 (universal on
            // x86-64); $1/$2/$3 select floor / ceil / trunc. Mirrors asm.fern.
            s = s.write("    popq %rax\n    movq %rax, %xmm0\n");
            if (o.kind_tag == 57) { s = s.write("    sqrtsd %xmm0, %xmm0\n"); }  // fsqrt
            else if (o.kind_tag == 59) { s = s.write("    roundsd $1, %xmm0, %xmm0\n"); }  // ffloor
            else if (o.kind_tag == 58) { s = s.write("    roundsd $2, %xmm0, %xmm0\n"); }  // fceil
            else { s = s.write("    roundsd $3, %xmm0, %xmm0\n"); }
            s = s.write("    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 56) {  // fabs
            // |x| clears the f64 sign bit — a plain mask on the bits in %rax, no
            // xmm needed (mirrors asm.fern's __abs_f64).
            s = s.write("    popq %rax\n    movabsq $0x7fffffffffffffff, %rcx\n    andq %rcx, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 55) {  // fneg
            // -x flips the f64 sign bit (XOR), preserving signed zero — unlike
            // the old 0.0 - x lowering which flushed -0.0 to +0.0 (#4333).
            s = s.write("    popq %rax\n    movabsq $0x8000000000000000, %rcx\n    xorq %rcx, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 61) {  // fround
            // round-half-away-from-zero (Go's math.Round): roundsd only offers
            // ties-to-even / floor / ceil / trunc, so emulate via
            // trunc(x + copysign(0.5, x)). Build copysign(0.5, x) by OR-ing x's
            // sign bit into the 0.5 bit pattern (0x3fe0000000000000), add, trunc
            // ($3). Mirrors asm.fern's __round_f64.
            s = s.write("    popq %rax\n    movq %rax, %rcx\n");
            s = s.write("    movabsq $0x8000000000000000, %rdx\n    andq %rdx, %rcx\n");
            s = s.write("    movabsq $0x3fe0000000000000, %rdx\n    orq %rdx, %rcx\n");
            s = s.write("    movq %rcx, %xmm1\n    movq %rax, %xmm0\n");
            s = s.write("    addsd %xmm1, %xmm0\n    roundsd $3, %xmm0, %xmm0\n");
            s = s.write("    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 51 || o.kind_tag == 52 || o.kind_tag == 53 || o.kind_tag == 54 || o.kind_tag == 49 || o.kind_tag == 50) {  // flt, fle, fgt, fge, feq, fne
            // f64 compare → i32 0/1, NaN-correct (mirrors asm.fern): ucomisd sets
            // CF=ZF=PF=1 when unordered, so `<`/`<=`/`==` mask with setnp and
            // `!=` accepts unordered via setp; `>`/`>=` use seta/setae (CF=0).
            s = s.write("    popq %rax\n    movq %rax, %xmm1\n    popq %rax\n    movq %rax, %xmm0\n");
            s = s.write("    ucomisd %xmm1, %xmm0\n    movq $0, %rax\n");
            if (o.kind_tag == 51) { s = s.write("    setb %al\n    setnp %dl\n    andb %dl, %al\n"); }  // flt
            else if (o.kind_tag == 52) { s = s.write("    setbe %al\n    setnp %dl\n    andb %dl, %al\n"); }  // fle
            else if (o.kind_tag == 53) { s = s.write("    seta %al\n"); }  // fgt
            else if (o.kind_tag == 54) { s = s.write("    setae %al\n"); }  // fge
            else if (o.kind_tag == 49) { s = s.write("    sete %al\n    setnp %dl\n    andb %dl, %al\n"); }  // feq
            else { s = s.write("    setne %al\n    setp %dl\n    orb %dl, %al\n"); }
            s = s.write("    movzbq %al, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 156) {  // end
            // Define the label at this end's index — the target of the if/else
            // that opened it (no-else if's jz, else's jmp) or a block's br.
            // A loop's closing end is unused (harmless).
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else {
            // binary op: pop rhs (rcx), lhs (rax), combine, push.
            s = s.write("    popq %rcx\n    popq %rax\n");
            if (o.kind_tag == 24 || o.kind_tag == 26 || o.kind_tag == 25 || o.kind_tag == 27) {  // div_s, rem_s, div_u, rem_u
                // Non-trapping guarded div/rem (#4329); needs a per-op-unique
                // label base — reuse the loop prefix + this op's index.
                s = s.write(ir_div_guarded(o.kind_tag, o.width, lp + util.i32_to_string(i)));
            } else {
                s = s.write(ir_bin_asm(o.kind_tag, o.width));
            }
            s = s.write("    pushq %rax\n");
        }
        i = i + 1;
    }

    // Function-boundary label. Any control-flow target that resolves to the
    // one-past-the-last op index (`ops.len()`) lands here — the function exit.
    // In a well-formed op stream every opener has an explicit `end` before the
    // body ends, so no bare `.Lir_*` reference ever reaches `ops.len()` and this
    // label is a harmless no-op. It becomes load-bearing only when a scope is
    // left unterminated (a br/if to a block whose `end` is missing): `find_matching_end`
    // then walks off the end and returns `ops.len()`, and WITHOUT this definition
    // the emitted asm carries a dangling `.Lir_<fn>_<len>` reference that fails at
    // link (`undefined reference to .Lir_main_13`, issue #4442). Defining it here
    // turns that link error into a jump to the epilogue — the correct "exit the
    // scope" behaviour — keeping the output linkable and deterministic.
    s = s.write(lp + util.i32_to_string(r.ops.len()) + ":\n");

    // Fallback (subset functions always end in `return`).
    s = s.write("    movq $0, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// lift_lambdas re-exports irlower's lambda-lift pre-pass so the dispatch sites
// (asm.emit_module / asm_ir_run) can hoist no-capture lambda arguments before
// the eligibility check + emit without importing irlower directly. It also
// injects the built-in struct/enum declarations (FileStat / HeaderMap /
// JsonValue / the std/time types / …) into the module's struct table — the AST
// path gets these via parser.module_with_builtins, but the IR path (probe +
// emit_module_ir) both funnel through here, so this is the single point that
// keeps the IR path's struct visibility in sync with the AST path's. Without
// it the IR path can't resolve built-in struct layouts (e.g. std/time's Date)
// and bails every function that uses one.
pub function lift_lambdas(mod: parser.Module): parser.Module {
    var lifted: parser.Module = irlower.lift_lambdas(mod);
    return parser.Module { funcs: lifted.funcs, structs: parser.inject_builtin_enums(lifted.structs), aliases: lifted.aliases, imports: lifted.imports, top_stmts: lifted.top_stmts, enums: lifted.enums, resources: lifted.resources, exports: lifted.exports, impls: lifted.impls, trait_reqs: lifted.trait_reqs };
}

// emit_module_ir emits a full all-i32-eligible module via the IR path. The
// program is self-contained (pure i32 uses no runtime helpers): every
// function via the IR, then a `_start` that calls __fn_main and exits with
// its result. Caller must ensure all_eligible(mod).
// emit_module_funcs derives the per-module side-tables ONCE and emits every
// function through the IR (asm into the strbuf), marking each function's runtime
// needs (the maps/heap op-scan + the str_*/print mark_* calls all live inside
// emit_function_via_ir). globl_defs marks each `__fn_<label>` `.globl` for
// per-module linking. Shared by emit_module_ir_unit (which then writes _start /
// .rodata / the runtime) and module_runtime_needs (which discards the asm and
// reads the accumulated `needed`). Factoring it out keeps the two callers from
// drifting on which functions / side-tables drive need detection.
// all_funcs / all_structs are the WHOLE-PROGRAM signature view (#3451 step 2 /
// #3454): the union of every loaded module's functions and structs. The
// return-type / signature side-tables are derived over them so a cross-module
// call to an imported function whose return type is non-i32 (string / struct /
// i64 / array / …) is tagged by the CALLEE's real signature — the callee lives
// in a sibling module and would otherwise be invisible, mis-tagging the call as
// i32 and miscompiling a chained method on its result. Only `mod.funcs` are
// EMITTED; all_funcs/all_structs drive analysis only. For the whole-program
// single-unit path all_funcs==mod.funcs / all_structs==mod.structs, so the
// derived tables — and the emitted asm — are byte-identical.
// emit_ir_field_reclaims emits the per-type __field_reclaim_<T> helper bodies
// this module's lowering marked (#3457 field-level move tracking). Each `T` was
// recorded as a "field_reclaim:<T>" need at the call site. Emitted as `.weak`
// (like the shape symbols) so two per-module translation units that both use
// `__field_reclaim_<T>` co-link to one definition. The body calls the shared,
// entry-exported __fn___fern_arr_dec (per-field buffer free) and
// __fn___fern_snapshot_dec (the box free), so a LIBRARY module's body references
// only those .globl externs — never the .bss freelist directly — and resolves
// against the entry's single runtime copy.
function emit_ir_field_reclaims(s: asmcore.EmitState): asmcore.EmitState {
    var ni: i32 = 0;
    while (ni < s.needed.len()) {
        var nd: string = s.needed[ni];
        if (nd.len() > 14 && nd[0:14] == "field_reclaim:") {
            s = emit_ir_field_reclaim_one(s, nd[14 : nd.len()]);
        }
        ni = ni + 1;
    }
    return s;
}

// emit_ir_field_reclaim_one emits one __field_reclaim_<sty> body. Stack-arg ABI:
// 24(%rsp)=new, 16=old, 8=snap. For each rc-tracked ARRAY field (offset (k+1)*8
// off the struct box's data pointer) it frees old.field[k] via __fn___fern_arr_dec
// (rc-guarded SHALLOW dec/free) iff old.field[k] differs from new.field[k] (cow)
// AND, when snap != 0, from snap.field[k] (the caller's original). It then frees
// the old box itself via __fn___fern_snapshot_dec(new, old, snap) and returns
// `new` in %rax. r9/r10/r11 hold snap/old/new across the field loop —
// __fn___fern_arr_dec clobbers only rax/rcx/rdx/rsi/rdi/r8, so they survive.
function emit_ir_field_reclaim_one(s: asmcore.EmitState, sty: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(sty);
    var n: i32 = irlower.decl_field_count(s.struct_decls, sty);
    s = s.write(".weak __fn___field_reclaim_" + san + "\n");
    s = s.write("__fn___field_reclaim_" + san + ":\n");
    s = s.write("    movq 24(%rsp), %r11\n");      // new
    s = s.write("    movq 16(%rsp), %r10\n");      // old
    s = s.write("    movq 8(%rsp), %r9\n");        // snap
    s = s.write("    cmpq $0x10000, %r10\n");      // old null / low-addr -> skip fields
    s = s.write("    jb .Lfr_" + san + "_box\n");
    var k: i32 = 0;
    while (k < n) {
        var fdt: string = irlower.decl_field_type_at(s.struct_decls, sty, k);
        // A replaced STRING field (#4355): released via the rc-aware
        // __fern_str_free (free rc==1, dec rc>1, skip immortal view /
        // literal) under the SAME cow + snap guards as the array fields —
        // a carried-over field (functional update / `name: s.name` copy)
        // is pointer-equal in new and skipped; the caller's original is
        // protected by the snap compare. Balanced by the struct-lit
        // string-field retain (lower_expr's ExprStructLit arm, gated on
        // slit_reclaim — true for every type routed here): a non-fresh
        // field value was inc'd into the box, a fresh one is sole-owned.
        // Gated on the whole-program read scan ("strfldok:<T>", seeded by
        // emit_module_ir_unit): a type whose string fields are read in any
        // ESCAPING position (call arg / return / view / reassign-alias)
        // keeps the arrays-only body — those reads are uncounted aliases
        // the free would dangle (the per-module compiler self-run segfault).
        var fr_str: boolean = fdt == "string" && s.has_need("strfldok:" + sty);
        // A replaced STRING[] field: released DEEP via the rc-aware
        // __fern_str_arr_free (elements + buffer at rc==1; shared buffer just
        // decs), under the same cow + snap guards. Gated on the strarrfld
        // admission ("strfldok:arr:<T>" — element-fresh stores, .len()-only
        // reads), the string[] sibling of fr_str's gate. The helper preserves
        // r9/r10/r11 (it saves rbx/r12/r13; its per-element __fern_str_free
        // clobbers only rax/rcx/rdx/rsi/r8), so the field loop's registers
        // survive.
        var fr_str_arr: boolean = fdt == "string[]" && s.has_need("strfldok:arr:" + sty);
        // A replaced fn (closure) field: the superseded env box shallow-freed
        // via arr_dec under the same cow + snap guards, gated on the clofld
        // admission (fresh-lambda-only values — the box is solely the
        // field's). Takes the generic arr_dec branch below.
        var fr_clo: boolean = fdt == "fn" && s.has_need("strfldok:clo:" + sty);
        if (fr_str || fr_str_arr || fr_clo || irlower.is_leaksafe_array_field(fdt) || irlower.is_struct_array_field_type(s.struct_decls, fdt) || irlower.is_enum_array_field_type(s.struct_decls, fdt)) {
            var off: string = util.i32_to_string((k + 1) * 8);
            var ks: string = util.i32_to_string(k);
            s = s.write("    movq " + off + "(%r10), %rsi\n");      // old.field_k
            s = s.write("    cmpq " + off + "(%r11), %rsi\n");      // == new.field_k? (cow)
            s = s.write("    je .Lfr_" + san + "_skip" + ks + "\n");
            s = s.write("    testq %r9, %r9\n");                    // snap == 0 (local)?
            s = s.write("    jz .Lfr_" + san + "_dec" + ks + "\n");
            s = s.write("    cmpq " + off + "(%r9), %rsi\n");       // == snap.field_k? (caller's)
            s = s.write("    je .Lfr_" + san + "_skip" + ks + "\n");
            s = s.write(".Lfr_" + san + "_dec" + ks + ":\n");
            s = s.write("    pushq %rsi\n");
            if (fr_str) {
                s = s.write("    call __fn___fern_str_free\n");     // rc-aware string free (data buffer + box)
            } else if (fr_str_arr) {
                s = s.write("    call __fn___fern_str_arr_free\n"); // deep string[] free (rc-guarded)
            } else {
                s = s.write("    call __fn___fern_arr_dec\n");      // shallow dec/free the dead buffer
            }
            s = s.write("    addq $8, %rsp\n");
            s = s.write(".Lfr_" + san + "_skip" + ks + ":\n");
        }
        k = k + 1;
    }
    s = s.write(".Lfr_" + san + "_box:\n");
    s = s.write("    pushq %r11\n");                // new
    s = s.write("    pushq %r10\n");                // old
    s = s.write("    pushq %r9\n");                 // snap
    s = s.write("    call __fn___fern_snapshot_dec\n");   // free old box (cow + snap guarded); -> %rax = new
    s = s.write("    addq $24, %rsp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_struct_drops emits the per-type __struct_drop_<T> helper bodies this
// module's lowering marked (#3457 — the deep struct-drop, formerly emitted inline
// by emit_struct_field_drops). Each `T` was recorded as a "struct_drop:<T>" need
// at the call site. `.weak` (like __field_reclaim) so two per-module units that
// both sweep a `T` co-link to one definition; the body references only the shared
// .globl externs __fn___fern_arr_dec / __fn___fern_rc_is_unique.
function emit_ir_struct_drops(s: asmcore.EmitState): asmcore.EmitState {
    var ni: i32 = 0;
    while (ni < s.needed.len()) {
        var nd: string = s.needed[ni];
        // struct_arr_elems_drop: must be checked BEFORE struct_drop: (the former is not
        // a prefix of the latter, but both start distinctly — order is not load-bearing,
        // yet keep the more specific longer key first for clarity). Each emitter records
        // its own transitive needs (arr_elems -> struct_drop), absorbed by this index-
        // driven loop.
        if (nd.len() > 22 && nd[0:22] == "struct_arr_elems_drop:") {
            s = emit_ir_struct_arr_elems_drop_one(s, nd[22 : nd.len()]);
        } else if (nd.len() > 12 && nd[0:12] == "struct_drop:") {
            s = emit_ir_struct_drop_one(s, nd[12 : nd.len()]);
        }
        ni = ni + 1;
    }
    return s;
}

// emit_ir_struct_drop_one emits one __struct_drop_<sty>(box) -> box body. Stack-
// arg ABI: 8(%rsp)=box. For each rc-tracked ARRAY field (offset (k+1)*8 off the
// box's data pointer) it releases the field BUFFER via __fn___fern_arr_dec (rc-
// guarded SHALLOW dec/free). For a struct/enum-array field it FIRST walks the
// buffer (when uniquely owned) dec'ing each element box, then dec's the buffer.
// Returns `box` in %rax (the call site drops it). %r11 holds box, %r10 the
// current buffer, %r9 the loop index across the field loop — __fn___fern_arr_dec
// and __fn___fern_rc_is_unique clobber only rax/rcx/rdx/rsi/rdi/r8, so they
// survive. Mirrors the IR ops the inline emit_struct_field_drops used to write.
function emit_ir_struct_drop_one(s: asmcore.EmitState, sty: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(sty);
    var n: i32 = irlower.decl_field_count(s.struct_decls, sty);
    s = s.write(".weak __fn___struct_drop_" + san + "\n");
    s = s.write("__fn___struct_drop_" + san + ":\n");
    s = s.write("    movq 8(%rsp), %r11\n");       // box
    s = s.write("    movq %r11, %rax\n");          // return box (caller drops)
    s = s.write("    cmpq $0x10000, %r11\n");      // box null / low-addr -> skip fields
    s = s.write("    jb .Lstd_" + san + "_ret\n");
    var k: i32 = 0;
    while (k < n) {
        var fdt: string = irlower.decl_field_type_at(s.struct_decls, sty, k);
        var k_scalar: boolean = irlower.is_leaksafe_array_field(fdt);
        var k_box: boolean = !k_scalar && (irlower.is_struct_array_field_type(s.struct_decls, fdt) || irlower.is_enum_array_field_type(s.struct_decls, fdt));
        // A DIRECT nested-struct field (`inner: Inner`, not an array): the field
        // slot holds the inner struct's box pointer, freed SHALLOW via the same
        // __fern_arr_dec as a scalar-array buffer — one level, exactly like a
        // struct-array element box (k_box's per-element dec). rc-guarded inside
        // arr_dec, so an aliased (rc>1) inner just decs; only the sole owner frees.
        // The inner's OWN rc fields leak (the one-level gap, a deep-drop follow-up),
        // matching the struct-array-element model. Construction alias-incs the field
        // (lower_expr's ExprStructLit arm) so this dec is balanced. A DIRECT enum
        // field is handled by the parallel k_enum arm below (same shallow box dec);
        // its variant-payload deep-drop is the deferred follow-up.
        var k_struct: boolean = !k_scalar && !k_box && irlower.decl_is_struct(s.struct_decls, fdt);
        // A `string` field is rc-headered on the asm IR path (#4294), reclaimed via
        // the rc-aware __fern_str_free — frees a fresh (rc=1) field, decs a shared
        // (rc>1) one, skips an immortal slice/trim view or literal (rc<0). The
        // struct-lit alias-inc (irlower, gated on the per-lit ownership precompute)
        // retains non-fresh values so this dec is balanced; a fresh field is
        // sole-owned → freed here, the #4297 A2 heap-leak win.
        //
        // GATED on the whole-program read scan ("strfldok:<T>"), exactly like
        // __field_reclaim_<T>'s string arm (#4768): the construction-side retain
        // (slit_reclaim → struct_routes_field_reclaim) only fires for
        // STRFLDOK-admitted types, so a NON-admitted type's string fields are
        // uncounted aliases this free would dangle. The mismatch was fatal once
        // the merged whole-compiler bundle routed through the IR path (#3425):
        // ir.Op is string-fielded but not admitted (Op.str reads escape
        // everywhere), yet the array-element walk (__struct_arr_elems_drop_ir__Op,
        // reached via nested_field_deep_drop_ok's unconditional string credit)
        // freed every dropped Op's shared .str — corrupting the freelist and
        // crashing the IR-built compiler on its first lower_func. A non-admitted
        // type keeps the sound leak here, mirroring the field-reclaim contract.
        var k_str: boolean = !k_scalar && !k_box && !k_struct && fdt == "string" && s.has_need("strfldok:" + sty);
        // A DIRECT enum field (`e: MyEnum`, decl_is_enum, not an array): the slot
        // holds the enum's box pointer, freed SHALLOW via __fern_arr_dec (the same
        // rc-guarded generic box free the shallow k_struct / scalar-array arms use —
        // it frees struct AND enum boxes identically). One level: the variant payload
        // (an array/string/nested box) leaks, matching the shallow k_struct gap (the
        // variant-payload deep-drop needs a register-backend enum drop helper that does
        // not exist yet — a follow-up). Construction alias-incs a non-fresh enum field
        // (irlower ExprStructLit) so this dec is balanced; a fresh variant ctor is
        // sole-owned (rc 1) → freed here. #4297 A2.
        var k_enum: boolean = !k_scalar && !k_box && !k_struct && !k_str && irlower.decl_is_enum(s.struct_decls, fdt);
        // A string[] field (`names: string[]`): freed DEEP via the rc-aware
        // __fern_str_arr_free — at buffer rc==1 it __fern_str_free's every
        // element box then frees the buffer; a shared buffer just decs; null /
        // low-addr / immortal skipped inside the helper. GATED on
        // "strfldok:arr:<T>" (the strarrfld half of strfld_reclaim_ok_types_of)
        // exactly like k_str's strfldok gate: the admission proves every value
        // stored into the field is an element-fresh array literal and every
        // read a bare .len() borrow, so the element walk frees only boxes the
        // field solely owns. A non-admitted type keeps the sound leak.
        var k_str_arr: boolean = !k_scalar && !k_box && !k_struct && !k_str && !k_enum && fdt == "string[]" && s.has_need("strfldok:arr:" + sty);
        // An fn-typed (closure) field: the slot holds an rc-headered
        // `__mkclo$` env box (op_arr_make), shallow-freed via the same
        // rc-guarded __fern_arr_dec as the k_struct / k_enum boxes — one
        // level, captures leak. GATED on the clofld admission
        // ("strfldok:clo:<T>"): fresh-lambda-only construction values (the
        // box is solely the field's, rc=1 — no construction inc to balance),
        // no base copies, call-only reads.
        var k_clo: boolean = !k_scalar && !k_box && !k_struct && !k_str && !k_enum && !k_str_arr && fdt == "fn" && s.has_need("strfldok:clo:" + sty);
        var off: string = util.i32_to_string((k + 1) * 8);
        var ks: string = util.i32_to_string(k);
        if (k_box) {
            // MULTI-LEVEL array-element deep-drop (#2649): for a struct-ARRAY field
            // `X[]` whose element struct X is deep-drop-ok (acyclic + reclaimable),
            // first release each element's OWN rc fields via the per-element helper
            // __struct_arr_elems_drop_X (which is_unique-gates the buffer AND each
            // element, then calls __struct_drop_X per uniquely-owned element). The
            // existing element/buffer arr_dec below still frees the boxes — the helper
            // only ADDS the field release the shallow walk used to leak. The helper
            // calls __struct_drop_X, clobbering r9/r10/r11, so reload box from the
            // frameless stack arg 8(%rsp) afterwards. Enum-array elements have no
            // __struct_drop (enums aren't structs), so they stay shallow.
            if (irlower.is_struct_array_field_type(s.struct_decls, fdt)) {
                var elem_ty: str = fdt[0 : fdt.len() - 2];
                if (irlower.nested_field_deep_drop_ok(s.struct_decls, elem_ty)) {
                    var esan: string = asmcore.sanitize_label(elem_ty);
                    s = s.need("struct_arr_elems_drop:" + elem_ty);
                    s = s.write("    movq " + off + "(%r11), %rdi\n");      // buffer
                    s = s.write("    pushq %rdi\n");
                    s = s.write("    call __fn___struct_arr_elems_drop_" + esan + "\n");
                    s = s.write("    addq $8, %rsp\n");
                    s = s.write("    movq 8(%rsp), %r11\n");                // reload box (helper clobbered r11)
                }
            }
            s = s.write("    movq " + off + "(%r11), %r10\n");          // a = box.field_k (buffer)
            s = s.write("    cmpq $0x10000, %r10\n");                   // null / low -> skip walk (buffer dec is a null no-op)
            s = s.write("    jb .Lstd_" + san + "_buf" + ks + "\n");
            s = s.write("    pushq %r10\n");
            s = s.write("    call __fn___fern_rc_is_unique\n");         // shared (rc>1) -> skip element walk
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    testq %rax, %rax\n");
            s = s.write("    jz .Lstd_" + san + "_buf" + ks + "\n");
            s = s.write("    xorq %r9, %r9\n");                         // i = 0
            s = s.write(".Lstd_" + san + "_loop" + ks + ":\n");
            s = s.write("    movq (%r10), %rax\n");                     // len = a[0] (length header at data+0)
            s = s.write("    cmpq %rax, %r9\n");
            s = s.write("    jge .Lstd_" + san + "_buf" + ks + "\n");   // i >= len -> done walking
            s = s.write("    movq %r9, %rcx\n");
            s = s.write("    incq %rcx\n");
            s = s.write("    movq (%r10,%rcx,8), %rdi\n");              // a[i] at data+(i+1)*8
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___fern_arr_dec\n");              // shallow dec the element box
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    incq %r9\n");
            s = s.write("    jmp .Lstd_" + san + "_loop" + ks + "\n");
            s = s.write(".Lstd_" + san + "_buf" + ks + ":\n");
            s = s.write("    movq " + off + "(%r11), %rdi\n");          // reload buffer (r10 may be stale across walk)
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___fern_arr_dec\n");              // shallow dec the buffer slab
            s = s.write("    addq $8, %rsp\n");
        } else if (k_struct && irlower.nested_field_deep_drop_ok(s.struct_decls, fdt)) {
            // DEEP nested-struct field drop (Perceus slice 3 deep-drop): when the
            // inner box is UNIQUELY owned, first __struct_drop_<fdt> releases the
            // inner's OWN rc-array buffers, THEN __fern_arr_dec frees the inner box —
            // mirroring the k_box element walk. fdt is deep-drop-ok (its nested-struct
            // closure is ACYCLIC per nested_field_deep_drop_ok), so __struct_drop_<fdt>
            // may itself recurse into fdt's own deep-drop-ok fields: the emitted call
            // graph is a DAG (multi-level, bounded by the struct-type count, no cycle).
            // Emit the inner's per-type body (transitive need: emit_ir_struct_drops re-
            // checks needed.len() so each newly needed inner body is emitted in turn, and
            // need() dedups). __fern_arr_dec / __fern_rc_is_unique preserve %r11, but
            // __struct_drop_<fdt> CLOBBERS it, so reload box from the stable stack arg
            // 8(%rsp) (this body pushes no frame) after the call.
            var fsan: string = asmcore.sanitize_label(fdt);
            s = s.need("struct_drop:" + fdt);
            s = s.write("    movq " + off + "(%r11), %rax\n");          // inner = box.field_k
            s = s.write("    cmpq $0x10000, %rax\n");                   // null / low -> skip field-release
            s = s.write("    jb .Lstd_" + san + "_sdf" + ks + "\n");
            s = s.write("    pushq %rax\n");
            s = s.write("    call __fn___fern_rc_is_unique\n");         // shared (rc>1) -> skip field-release
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    testq %rax, %rax\n");
            s = s.write("    jz .Lstd_" + san + "_sdf" + ks + "\n");
            s = s.write("    movq " + off + "(%r11), %rax\n");          // reload inner (r11 valid here)
            s = s.write("    pushq %rax\n");
            s = s.write("    call __fn___struct_drop_" + fsan + "\n");  // release inner's rc fields (clobbers r11)
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    movq 8(%rsp), %r11\n");                    // reload box (struct_drop clobbered r11)
            s = s.write(".Lstd_" + san + "_sdf" + ks + ":\n");
            s = s.write("    movq " + off + "(%r11), %rdi\n");          // inner box
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___fern_arr_dec\n");              // free the inner box (rc-guarded)
            s = s.write("    addq $8, %rsp\n");
        } else if (k_str) {
            s = s.write("    movq " + off + "(%r11), %rdi\n");          // box.field_k string box
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___fern_str_free\n");             // rc-aware: free rc==1, dec rc>1, skip view/literal rc<0
            s = s.write("    addq $8, %rsp\n");
        } else if (k_str_arr) {
            s = s.write("    movq " + off + "(%r11), %rdi\n");          // box.field_k string[] buffer
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___fern_str_arr_free\n");         // deep at rc==1 (elements + buffer); shared -> dec; null skipped
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    movq 8(%rsp), %r11\n");                    // reload box (helper may clobber r11)
        } else if (k_scalar || k_struct || k_enum || k_clo) {
            s = s.write("    movq " + off + "(%r11), %rdi\n");          // box.field_k buffer / nested box / enum box / closure box (shallow)
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___fern_arr_dec\n");
            s = s.write("    addq $8, %rsp\n");
        }
        k = k + 1;
    }
    s = s.write(".Lstd_" + san + "_ret:\n");
    // Return the BOX (the documented contract): the field-release calls above
    // (__fern_arr_dec / __fern_str_free / nested __struct_drop_*) all return in
    // %rax, so the entry-time copy is clobbered by the time we get here — the
    // enum-payload deep-drop (emit_enum_variant_drops) CONSUMES this return for
    // its payload-box free, and the clobber made it dec the LAST-FREED FIELD a
    // second time (rc-underflow tick per consume; heap corruption for a string
    // field via the wrong-size-class free) while the payload box itself leaked.
    s = s.write("    movq 8(%rsp), %rax\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_struct_arr_elems_drop_one emits __struct_arr_elems_drop_<E>(buffer) -> buffer,
// the per-element-type deep-drop for a struct-ARRAY field (#2649 multi-level). It walks
// a uniquely-owned buffer and, for each uniquely-owned element box, calls
// __struct_drop_<E> to release the element's OWN rc fields — the level the shallow k_box
// walk leaked. It does NOT free the element boxes or the buffer; the caller's existing
// element/buffer arr_dec does that. Stack-arg ABI: 8(%rsp)=buffer (frame-relative 24 after
// the two callee-saved pushes). rbx=buffer, r12=index are callee-saved so they survive the
// nested __struct_drop_<E> call (which clobbers r9/r10/r11) and the arr_dec/is_unique calls
// (which clobber only rax/rcx/rdx/rsi/rdi/r8). Buffer + each element are is_unique-gated:
// a shared buffer (aliased array) or a shared element (aliased out) skips the field
// release, exactly as the direct-field deep-drop does. `.weak`, per-unit, needs
// __struct_drop_<E> so its body co-emits.
function emit_ir_struct_arr_elems_drop_one(s: asmcore.EmitState, ety: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(ety);
    s = s.need("struct_drop:" + ety);
    s = s.write(".weak __fn___struct_arr_elems_drop_" + san + "\n");
    s = s.write("__fn___struct_arr_elems_drop_" + san + ":\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq 24(%rsp), %rbx\n");                    // buffer (arg 8 + 16 for two pushes)
    s = s.write("    cmpq $0x10000, %rbx\n");                    // null / low -> nothing to walk
    s = s.write("    jb .Lsaed_" + san + "_ret\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    call __fn___fern_rc_is_unique\n");          // shared buffer -> elements shared -> skip
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lsaed_" + san + "_ret\n");
    s = s.write("    xorq %r12, %r12\n");                        // i = 0
    s = s.write(".Lsaed_" + san + "_loop:\n");
    s = s.write("    movq (%rbx), %rax\n");                      // len = buffer[0]
    s = s.write("    cmpq %rax, %r12\n");
    s = s.write("    jge .Lsaed_" + san + "_ret\n");             // i >= len -> done
    s = s.write("    movq %r12, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq (%rbx,%rcx,8), %rdi\n");               // elem = buffer[(i+1)*8]
    s = s.write("    cmpq $0x10000, %rdi\n");                    // null / low -> skip
    s = s.write("    jb .Lsaed_" + san + "_next\n");
    s = s.write("    pushq %rdi\n");
    s = s.write("    call __fn___fern_rc_is_unique\n");          // shared element (aliased out) -> skip field release
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lsaed_" + san + "_next\n");
    s = s.write("    movq %r12, %rcx\n");                        // recompute elem (rcx clobbered by call)
    s = s.write("    incq %rcx\n");
    s = s.write("    movq (%rbx,%rcx,8), %rdi\n");
    s = s.write("    pushq %rdi\n");
    s = s.write("    call __fn___struct_drop_" + san + "\n");    // release elem's OWN rc fields (clobbers r9/r10/r11)
    s = s.write("    addq $8, %rsp\n");
    s = s.write(".Lsaed_" + san + "_next:\n");
    s = s.write("    incq %r12\n");
    s = s.write("    jmp .Lsaed_" + san + "_loop\n");
    s = s.write(".Lsaed_" + san + "_ret:\n");
    s = s.write("    movq %rbx, %rax\n");                        // return buffer (caller dec's it)
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_runtime_fern_fn lowers a runtime helper WRITTEN IN FERN through the
// IR pipeline (issue #2649) — the IR-path analog of asm.fern's
// emit_runtime_fern_fn. The helper emits as __fn_<name> exactly like a user
// function (so the IR call site's `call __fn___fern_<name>` resolves to it),
// replacing a hand-written stack-arg wrapper in emit_ir_runtime.
//
// The helper MUST be self-contained — it calls no other user function — so the
// per-function side-tables computed over the helper ALONE are complete: in
// particular its borrowability analysis correctly borrows a read-only
// string/array param (never returned, stored, or consumed), so the lowering
// inserts no RC dec that would free the caller's borrowed value. Emitted
// entry-only and gated on the helper's need by the caller; emit_runtime_globls
// already `.globl`s the symbol so the per-module link resolves it.
function emit_ir_runtime_fern_fn(src: string, all_structs: parser.StructDecl[], s: asmcore.EmitState): asmcore.EmitState {
    var m: parser.Module = parser.infer_ret_types_module(parser.parse_module(lexer.tokenize(src)));
    var fns: parser.FuncDecl[] = m.funcs;
    var bparams: string[] = irlower.borrowable_params_interproc(fns);
    var csparams: string[] = irlower.consume_safe_params_interproc(fns, bparams);
    var arf: string[] = array_ret_fns_of(fns);
    var srf: string[] = irlower.str_ret_fns_of(fns);
    var sarf: string[] = irlower.strarr_ret_fns_of(fns);
    var amf: string[] = irlower.arr_method_fns_of(fns);
    var orf: string[] = irlower.opt_ret_fns_of(fns);
    var irf: string[] = irlower.i64_ret_fns_of(fns);
    var trf: string[] = irlower.tuple_ret_fns_of(fns);
    var srtf: string[] = irlower.struct_ret_fns_of(fns, all_structs);
    var mrtf: string[] = irlower.map_ret_fns_of(fns);
    var frf: string[] = irlower.f64_ret_fns_of(fns);
    var farf: string[] = irlower.f64arr_ret_fns_of(fns);
    var iarf: string[] = irlower.i64arr_ret_fns_of(fns);
    var fps: string[] = irlower.fn_param_sigs_of(fns);
    var cfs: string[] = irlower.closure_ret_fns_of(fns);
    var cnf: string[] = irlower.const_fns_of(fns);
    var frsf: string[] = irlower.fresh_struct_ret_fns_of(fns, all_structs);
    var rfrsf: string[] = irlower.return_fresh_struct_ret_fns_of(fns, all_structs);
    var sfrf: string[] = irlower.str_fresh_ret_fns_of(fns);
    var ofrf: string[] = irlower.opt_fresh_ret_fns_of(fns, s.struct_decls);
    var sfot: string[] = irlower.strfld_reclaim_ok_types_of(fns, s.struct_decls);
    var tfrf: string[] = irlower.tuple_fresh_ret_fns_of(fns);
    var fnames: string[] = irlower.fn_names_of(fns);
    // String literals the helper body interns (e.g. "\n" in str_lines's
    // s.split("\n")) land in string_lits AFTER the main .rodata pool was emitted
    // (this runs in the entry block, past the pool), so flush any NEW ones here in
    // their own .rodata block then return to .text. A literal-free helper (the
    // str_search / str_eq / str_cmp / str_to_i32 / str_trim bodies) adds none, so
    // this is a no-op for them. Mirrors the AST emit_runtime_fern_fn flush.
    var lit0: i32 = s.string_lits.len();
    var i: i32 = 0;
    while (i < fns.len()) {
        s = emit_function_via_ir(fns[i], arf, s, bparams, srf, sarf, amf, orf, irf, trf, srtf, mrtf, frf, farf, iarf, fps, cfs, irlower.closurearr_ret_fns_of(fns), cnf, fnames, frsf, csparams, rfrsf, sfrf, ofrf, sfot, tfrf);
        i = i + 1;
    }
    if (s.string_lits.len() > lit0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = lit0;
        while (li < s.string_lits.len()) {
            s = s.write(str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
        s = s.write("    .text\n");
    }
    return s;
}

// emit_module_funcs emits mod's function bodies in the index window [lo, hi).
// A full window (lo=0, hi=mod.funcs.len(), or hi<0 as a "to the end" sentinel)
// reproduces the whole-module emit byte-for-byte; a partial window emits only
// that slice's `__fn_*` defs (its own string pool, its weak field-reclaims /
// struct-drops), so an oversized module (irlower, 511 funcs — #3425) can be
// sharded across separate process invocations to keep each emit's peak heap
// under the leak-mode ceiling. The hoisted side-tables below are ALWAYS
// computed over the WHOLE all_funcs (never windowed) so cross-window call
// tagging is identical to the unsharded emit; only the emit loop is windowed.
function emit_module_funcs(mod: parser.Module, all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[], s: asmcore.EmitState, globl_defs: boolean, lo: i32, hi: i32, cache: irlower.LowerResult[]): asmcore.EmitState {
    // #4394 lever 3: when `cache` is non-empty the caller (emit_module_ir_gated)
    // has ALREADY lowered every function — into cache[i], indexed by mod.funcs
    // position — during its fused eligibility scan, so emit reuses that lowering
    // (via emit_function_via_ir_pre) instead of lowering it a second time. An
    // empty cache is the standard path: every function is lowered here from the
    // eighteen side-tables below, exactly as before. The side-tables are cheap
    // relative to the lowering they feed, so they are derived unconditionally
    // (the lever's win is skipping the re-LOWERING, not the derivation).
    var arf: string[] = array_ret_fns_of(all_funcs);
    // Inter-procedural borrowability computed ONCE per module (not per function —
    // that OOMs the arm64 self-compile); threaded into every emit_function_via_ir.
    var bparams: string[] = irlower.borrowable_params_interproc(all_funcs);
    var csparams: string[] = irlower.consume_safe_params_interproc(all_funcs, bparams);
    // The fourteen return-type / signature side-tables lower_func consults are
    // derived ONCE here (each scans all of all_funcs — the WHOLE-PROGRAM
    // signature view, #3454), then threaded into every emit_function_via_ir —
    // recomputing them per function is O(n^2) and OOMs the bump heap on a large
    // module (parser, ~300 funcs). This mirrors bparams above and the wasm
    // backend's emit_module, which already hoists them.
    var srf: string[] = irlower.str_ret_fns_of(all_funcs);
    var sarf: string[] = irlower.strarr_ret_fns_of(all_funcs);
    var amf: string[] = irlower.arr_method_fns_of(all_funcs);
    var orf: string[] = irlower.opt_ret_fns_of(all_funcs);
    var irf: string[] = irlower.i64_ret_fns_of(all_funcs);
    var trf: string[] = irlower.tuple_ret_fns_of(all_funcs);
    var srtf: string[] = irlower.struct_ret_fns_of(all_funcs, all_structs);
    var mrtf: string[] = irlower.map_ret_fns_of(all_funcs);
    var frf: string[] = irlower.f64_ret_fns_of(all_funcs);
    var farf: string[] = irlower.f64arr_ret_fns_of(all_funcs);
    var iarf: string[] = irlower.i64arr_ret_fns_of(all_funcs);
    var fps: string[] = irlower.fn_param_sigs_of(all_funcs);
    var cfs: string[] = irlower.closure_ret_fns_of(all_funcs);
    var cnf: string[] = irlower.const_fns_of(all_funcs);
    var frsf: string[] = irlower.fresh_struct_ret_fns_of(all_funcs, all_structs);
    var rfrsf: string[] = irlower.return_fresh_struct_ret_fns_of(all_funcs, all_structs);
    var sfrf: string[] = irlower.str_fresh_ret_fns_of(all_funcs);
    var ofrf: string[] = irlower.opt_fresh_ret_fns_of(all_funcs, all_structs);
    var sfot: string[] = irlower.strfld_reclaim_ok_types_of(all_funcs, all_structs);
    var tfrf: string[] = irlower.tuple_fresh_ret_fns_of(all_funcs);
    // hi<0 is the "to the end" sentinel; an over-large hi is clamped so a shard
    // window that overshoots the module length can't index past mod.funcs.
    var hh: i32 = hi;
    if (hh < 0 || hh > mod.funcs.len()) { hh = mod.funcs.len(); }
    var fi: i32 = lo;
    while (fi < hh) {
        // Per-module: mark the definition `.globl` so a sibling module's
        // `call __fn_<label>` (an unresolved extern in that module) links
        // against it. The label is computed exactly as emit_function_via_ir
        // writes it below (receiver-qualified for methods).
        if (globl_defs) {
            var gname: string = mod.funcs[fi].name;
            if (mod.funcs[fi].receiver_type.len() > 0) { gname = util.base_type_name(mod.funcs[fi].receiver_type) + "." + mod.funcs[fi].name; }
            s = s.write(".globl __fn_" + asmcore.sanitize_label(gname) + "\n");
        }
        if (cache.len() == 0) {
            s = emit_function_via_ir(mod.funcs[fi], arf, s, bparams, srf, sarf, amf, orf, irf, trf, srtf, mrtf, frf, farf, iarf, fps, cfs, irlower.closurearr_ret_fns_of(mod.funcs), cnf, irlower.fn_names_of(mod.funcs), frsf, csparams, rfrsf, sfrf, ofrf, sfot, tfrf);
        } else {
            s = emit_function_via_ir_pre(cache[fi], mod.funcs[fi], s);
        }
        fi = fi + 1;
    }
    return s;
}

// module_runtime_needs returns the runtime helpers a module requires (the
// closed need-set: "heap", "maps", "str_concat", …), for whole-program runtime
// aggregation in per-module emit (#3451 step 3 / #3455). The entry module emits
// the single shared runtime, but on its OWN it only knows its own needs — a
// library module that uses a helper the entry doesn't (e.g. str_concat) would
// reference an undefined symbol at link. The driver unions module_runtime_needs
// across every loaded module and passes the result as emit_module_ir_unit's
// extra_needs, so the entry's runtime covers every module. It runs the same
// per-function emit as the real path (so the need-set is exact) but discards
// the asm (strbuf_reset) and reads `needed`.
pub function module_runtime_needs(mod: parser.Module): string[] {
    mod = parser.infer_ret_types_module(mod);
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    s = asmcore.EmitState { ...s, struct_decls: mod.structs, funcs: mod.funcs };
    // Needs depend only on this module's own ops, so the single-module
    // signature view suffices (a cross-module call's NEED set is the callee's,
    // aggregated separately via module_runtime_needs over each module).
    s = emit_module_funcs(mod, mod.funcs, mod.structs, s, false, 0, 0 - 1, []);
    s = s.close_needs();
    strbuf_reset();
    return s.needed;
}

// all_runtime_need_roots is the closed set of runtime-need ROOT names — every
// string the codegen ever passes to `s.need("…")` (the mark_* helpers all bottom
// out in one of these). It is the over-approximation the per-module driver feeds
// the ENTRY module's shared runtime instead of the exact union computed by
// running module_runtime_needs over every loaded module.
//
// Why: module_runtime_needs does a FULL emit_module_funcs (the heavy IR lowering)
// per module purely to read back `needed`. Aggregating it across the ~12 whole-
// compiler modules in ONE process — what `-per-module-needs` does — re-emits the
// entire compiler, and the self-host runtime does not yet reclaim the per-function
// IR-op allocations (#3425), so a self-host-built driver OOMs (exit 137) there
// even though each SINGLE module emits fine. That OOM is the one thing blocking a
// self-host-built compiler from driving its OWN per-module self-compile (the
// IR-only bootstrap #3456 needs to retire the AST emitters, #3457).
//
// Feeding the entry every root instead makes it emit the full `__fern_*` runtime
// (close_needs still pulls each root's transitive deps). It is SOUND — the entry's
// runtime is a superset of what any module references, so no `call __fern_*` extern
// dangles at link — and DETERMINISTIC, so the byte-identical per-module fixpoint is
// preserved (every generation emits the same full runtime). The cost is a handful
// of unused helpers in the entry unit (the existing extra_needs path already emits
// sibling-only helpers, so over-emission is already the per-module norm). If a NEW
// `.need("x")` root is added without listing it here, a module using x links against
// an undefined `__fern_x` — caught immediately by the per-module link test, never a
// silent miscompile.
pub function all_runtime_need_roots(): string[] {
    return [
        "alloc_u8", "args", "arr_concat", "arr_i32_index_of", "arr_i32_min_max",
        "arr_i32_product", "arr_i32_sum", "arr_push", "arr_push_owned", "arr_reverse", "arr_slice",
        "arr_str_index_of", "arr_str_join", "arrarr_free", "chr", "env", "eprint", "heap", "i32_gcd",
        "i32_lcm", "i32_pow",
        "i32_to_string", "u32_to_string", "maps", "monotonic_ns", "now_ns", "now_unix_ms",
        "print_int", "putchar", "random_bytes", "random_i32", "read_file",
        "read_int", "sleep_ms", "str_bytes", "str_case", "str_chars", "str_cmp",
        "str_concat", "str_eq", "str_from_bytes", "str_lines", "str_print",
        "str_read_line", "str_repeat", "str_replace", "str_reverse", "str_search",
        "optarrarr_free", "str_split", "str_to_i32", "str_trim", "strarrarr_free", "strbuf"
    ];
}

pub function emit_module_ir(mod: parser.Module): string {
    // Infer return types BEFORE snapshotting all_funcs: the side-tables are
    // derived over all_funcs, so they must see the inferred (unannotated)
    // return types — otherwise a function with an inferred string/struct/…
    // return is mis-tagged i32 and a chained method on its result miscompiles.
    // emit_module_ir_unit re-infers `mod` (idempotent), keeping the emitted
    // module and the analysis set consistent.
    var im: parser.Module = parser.infer_ret_types_module(mod);
    return emit_module_ir_unit(im, true, false, "", [], im.funcs, im.structs, 0, 0 - 1, []);
}

// emit_module_ir_gated is the FUSED eligibility-gate + whole-program emit (#4394
// lever 3): it replaces the driver's two-call `if (all_eligible_known(m, known))
// { emit_module_ir(m) }` — which lowered every function TWICE (once in the gate's
// per-function eligibility scan, once in emit) — with a single lowering pass. It
// lowers each function ONCE into a cache while checking eligibility on that same
// LowerResult, then, if every function is eligible, emits from the cache (no
// re-lowering); otherwise it returns "" to signal the caller to fall back to the
// AST emitter. The eligibility verdict is identical to all_eligible_known's:
// r.ok plus a call_direct/const_func scan whose only rejections are USER function
// names (RC-inserted __struct_drop_/__field_reclaim_/__fern_* helper calls all
// pass is_fern_helper), and those user calls come from the AST — unaffected by
// the fuller emit-side RC side-tables this path lowers with. So a module that
// routed IR before still routes IR (byte-identically), one that fell back to AST
// still falls back — just at half the lowering cost.
//
// "" is an unambiguous "ineligible" sentinel: an eligible module always emits at
// least `.globl _start\n    .text\n…`, never the empty string.
pub function emit_module_ir_gated(mod: parser.Module, known: string[]): string {
    // Module-level gates, mirroring eligible_core_known_main's pre-checks: no
    // functions / over the merged-bundle size budget (#3425) / no `main` (the
    // whole-program emit writes `_start` → `call __fn_main`) all fall back to AST.
    if (mod.funcs.len() == 0) { return ""; }
    if (mod.funcs.len() > 512) { return ""; }
    if (!asmcore.has_main(mod)) { return ""; }
    // Infer ret types BEFORE lowering the cache so the side-tables see inferred
    // return types (emit_module_ir_unit re-infers idempotently, keeping the cache
    // indices aligned with the module it emits).
    var im: parser.Module = parser.infer_ret_types_module(mod);
    // Derive the emit-side side-tables ONCE (over im.funcs/im.structs — the whole-
    // program view, all_funcs == im.funcs here) exactly as emit_module_funcs does,
    // so the cached lowering is byte-identical to what emit would produce.
    var arf: string[] = array_ret_fns_of(im.funcs);
    var bparams: string[] = irlower.borrowable_params_interproc(im.funcs);
    var csparams: string[] = irlower.consume_safe_params_interproc(im.funcs, bparams);
    var srf: string[] = irlower.str_ret_fns_of(im.funcs);
    var sarf: string[] = irlower.strarr_ret_fns_of(im.funcs);
    var amf: string[] = irlower.arr_method_fns_of(im.funcs);
    var orf: string[] = irlower.opt_ret_fns_of(im.funcs);
    var irf: string[] = irlower.i64_ret_fns_of(im.funcs);
    var trf: string[] = irlower.tuple_ret_fns_of(im.funcs);
    var srtf: string[] = irlower.struct_ret_fns_of(im.funcs, im.structs);
    var mrtf: string[] = irlower.map_ret_fns_of(im.funcs);
    var frf: string[] = irlower.f64_ret_fns_of(im.funcs);
    var farf: string[] = irlower.f64arr_ret_fns_of(im.funcs);
    var iarf: string[] = irlower.i64arr_ret_fns_of(im.funcs);
    var fps: string[] = irlower.fn_param_sigs_of(im.funcs);
    var cfs: string[] = irlower.closure_ret_fns_of(im.funcs);
    var cnf: string[] = irlower.const_fns_of(im.funcs);
    var frsf: string[] = irlower.fresh_struct_ret_fns_of(im.funcs, im.structs);
    var rfrsf: string[] = irlower.return_fresh_struct_ret_fns_of(im.funcs, im.structs);
    var sfrf: string[] = irlower.str_fresh_ret_fns_of(im.funcs);
    var ofrf: string[] = irlower.opt_fresh_ret_fns_of(im.funcs, im.structs);
    var sfot: string[] = irlower.strfld_reclaim_ok_types_of(im.funcs, im.structs);
    var tfrf: string[] = irlower.tuple_fresh_ret_fns_of(im.funcs);
    var fnames: string[] = irlower.fn_names_of(im.funcs);
    // Lower every function once into `cache`, checking eligibility on each result.
    // Bail (AST fallback) on the first function whose body doesn't lower or whose
    // direct calls / function values reference an unknown symbol.
    var cache: irlower.LowerResult[] = [];
    var i: i32 = 0;
    while (i < im.funcs.len()) {
        var r: irlower.LowerResult = irlower.lower_func(im.funcs[i], arf, im.structs, srf, sarf, amf, orf, irf, trf, srtf, mrtf, frf, farf, iarf, fps, cfs, irlower.closurearr_ret_fns_of(im.funcs), cnf, bparams, fnames, frsf, csparams, rfrsf, sfrf, ofrf, sfot, tfrf);
        if (!r.ok) { return ""; }
        var j: i32 = 0;
        while (j < r.ops.len()) {
            var o: ir.Op = r.ops[j];
            if (o.kind_tag == 149) {  // call_direct
                if (!is_fern_helper(o.str) && !is_c_call(o.str) && !module_has_func(im, o.str) && !known_includes(known, o.str)) { return ""; }
            } else if (o.kind_tag == 6) {  // const_func
                if (!module_has_func(im, o.str) && !known_includes(known, o.str)) { return ""; }
            }
            j = j + 1;
        }
        cache = cache.append(r);
        i = i + 1;
    }
    // Every function eligible — emit from the cache (no second lowering).
    return emit_module_ir_unit(im, true, false, "", [], im.funcs, im.structs, 0, 0 - 1, cache);
}

// emit_module_ir_unit is emit_module_ir parameterised for per-module
// translation units (the per-module-compilation epic, #3451 — step 1's emit
// side / #3453, step 3 / #3455). Two knobs:
//
//   is_entry   — the entry module emits `_start` (→ call __fn_main + exit) AND
//                the single shared `__fern_*` runtime. Non-entry (library)
//                modules omit both: they expose only their `__fn_*` definitions
//                and reference the runtime helpers / sibling `__fn_*` symbols as
//                externs, resolved at link. (Aggregating runtime "needs" across
//                ALL modules so the entry's single runtime covers every helper
//                any module uses is the remaining step-3 piece; until then a
//                non-entry module that itself allocates must be linked with an
//                entry that pulls the heap runtime in.)
//   globl_defs — mark each emitted `__fn_<label>` `.globl` so a sibling module
//                can `call` into it across the translation-unit boundary.
//
// emit_module_ir delegates with is_entry=true, globl_defs=false, which
// reproduces the whole-program merged output byte-for-byte (no per-function
// `.globl`, the `_start` + runtime present, `str_ns` empty so string labels
// stay `.S<idx>`), so the existing single-unit path is unchanged.
//
//   str_ns — per-module namespace for string-literal `.rodata` labels. Empty
//            keeps `.S<idx>`; a non-empty ns makes each module's pool
//            `.S<ns>_<idx>`, so two STRING-using modules co-link without
//            label collision. A string-free module emits no `.rodata` either
//            way, so a "" ns there is harmless.
//   extra_needs — additional runtime needs to fold into the entry's single
//            runtime (the whole-program union of every module's
//            module_runtime_needs), so the entry emits the helpers a sibling
//            library uses even when the entry itself doesn't. Empty for the
//            whole-program path and for non-entry units.
//   all_funcs / all_structs — the WHOLE-PROGRAM signature view (#3454): the
//            union of every loaded module's functions / structs, over which the
//            return-type side-tables + struct layouts are derived so a
//            cross-module call is tagged by the callee's real signature. Only
//            `mod.funcs` are emitted. For the single-unit path pass mod.funcs /
//            mod.structs (byte-identical).
//   lo / hi — the [lo, hi) function-index window this unit emits (function-
//            sharding, #3425). A full window (lo=0, hi=mod.funcs.len(), or
//            hi<0 as a "to the end" sentinel) is byte-identical to the
//            unsharded emit; a partial window emits only that slice's `__fn_*`
//            defs plus its own (str_ns-namespaced) string pool and its
//            weak-deduped field-reclaims / struct-drops, so an oversized module
//            can be emitted across separate processes without any single emit's
//            leak-mode heap crossing the arena ceiling. Only non-entry library
//            shards are windowed; the entry emits its full window.
pub function emit_module_ir_unit(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[], lo: i32, hi: i32, cache: irlower.LowerResult[]): string {
    // Infer return types for unannotated functions so the IR path's
    // ret-type-keyed call tagging (str_ret_fns_of / opt_ret_fns_of / …)
    // matches the AST path, which gets the same via module_with_builtins.
    // (#4394 lever 3: `cache`, when non-empty, is the caller's pre-lowered
    // per-function LowerResult set — indexed by mod.funcs position — reused by
    // emit_module_funcs instead of re-lowering. The caller must have inferred
    // ret types before lowering; infer_ret_types_module is idempotent, so this
    // re-infer is a no-op there and the cache indices stay aligned.)
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    // struct_decls is the WHOLE-PROGRAM struct set so a function emitting an
    // imported struct's layout (field offsets / sizes) resolves it.
    s = asmcore.EmitState { ...s, struct_decls: all_structs, funcs: mod.funcs, str_ns: str_ns };
    if (is_entry) { s = s.write("    .globl _start\n"); }
    s = s.write("    .text\n");
    // Per-module: the entry exports its shared runtime entry points so sibling
    // library modules can link their `call __fern_*` externs against them.
    if (is_entry && globl_defs) { s = emit_runtime_globls(s); }
    s = emit_module_funcs(mod, all_funcs, all_structs, s, globl_defs, lo, hi, cache);
    // #4355: admit the replaced-STRING-field arm per type, from the
    // WHOLE-PROGRAM read scan (all_funcs — a unit-local list would
    // under-count the reads and re-open the UAF the scan exists to prevent;
    // see irlower.strfld_reclaim_ok_types_of). Seeded as "strfldok:<T>"
    // needs so emit_ir_field_reclaim_one can gate its string arm; every
    // unit computes the same verdict, so the weak-deduped bodies agree.
    var sfok: string[] = irlower.strfld_reclaim_ok_types_of(all_funcs, all_structs);
    var sfoi: i32 = 0;
    while (sfoi < sfok.len()) {
        s = s.need("strfldok:" + sfok[sfoi]);
        sfoi = sfoi + 1;
    }
    // Per-type __field_reclaim_<T> bodies (#3457), in .text alongside the module
    // funcs — emitted by EVERY unit that uses one (weak-deduped at link), so a
    // library module's call resolves locally rather than relying on the entry's
    // need-set covering a per-type symbol the fixed all_runtime_need_roots can't.
    s = emit_ir_field_reclaims(s);
    // Per-type __struct_drop_<T> bodies (#3457) — same weak-deduped per-unit
    // emission as the field-reclaims; replaces the former inline field-drop.
    s = emit_ir_struct_drops(s);
    // Fold the whole-program extra_needs (sibling modules' needs, for the entry's
    // single shared runtime) into the need set BEFORE _start, so _start's
    // need-gated argc/argv save below fires even when only a LIBRARY module
    // (not the entry itself) calls args(). For the single-unit path extra_needs
    // is empty, so this is inert there.
    var en: i32 = 0;
    while (en < extra_needs.len()) {
        s = s.need(extra_needs[en]);
        en = en + 1;
    }
    // _start belongs only to the entry module (one program entry point). A
    // non-entry library module exposes its `__fn_*` definitions and nothing else.
    if (is_entry) {
        s = s.write("_start:\n");
        // args() reads __fern_argc / __fern_argv; save them from the initial stack
        // (the kernel puts argc at the top of the stack on entry) BEFORE any push.
        // Matches asm.fern's _start. Gated on the args need so a non-args program
        // is byte-identical.
        if (s.has_need("args")) {
            s = s.write("    movq (%rsp), %rax\n");
            s = s.write("    movq %rax, __fern_argc(%rip)\n");
            s = s.write("    leaq 8(%rsp), %rax\n");
            s = s.write("    movq %rax, __fern_argv(%rip)\n");
        }
        // env() reads __fern_envp; save it from the initial stack BEFORE any push.
        // envp follows argv's NULL terminator: envp = rsp + 16 + argc*8 (argc at
        // [rsp], argv at rsp+8 with argc+1 slots incl. the NULL). Gated on the env /
        // subprocess needs (not heap, unlike asm.fern) so other programs stay
        // byte-identical. Both __fern_env and __fern_subprocess (execve) read it.
        if (s.has_need("env") || s.has_need("subprocess")) {
            s = s.write("    movq (%rsp), %rax\n");
            s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");
            s = s.write("    movq %rax, __fern_envp(%rip)\n");
        }
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    call __fn_main\n");
        s = s.write("    movq %rax, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    }
    // Pre-intern "FileStat" so the __fern_stat runtime helper (emitted after this
    // literal pool, inside the heap/stat block) can reference its shape label. The
    // helper's own shape_ref dedups to this slot; without the early intern the label
    // would be undefined (the runtime emits AFTER the pool). Mirrors asm.fern's +
    // asm_arm64.fern's FileStat pre-intern. Gated on the stat need.
    if (s.has_need("stat")) {
        var fsPre: ShapeRefOut = shape_ref(s, "FileStat");
        s = fsPre.state;
    }
    // Pre-intern "ProcessResult" for the __fern_subprocess runtime's shape label
    // (same reasoning as FileStat above). Gated on the subprocess need.
    if (s.has_need("subprocess")) {
        var prPre: ShapeRefOut = shape_ref(s, "ProcessResult");
        s = prPre.state;
    }
    // Pre-intern the IoError variant shapes for __fern_io_error (#4370) —
    // same reasoning as FileStat above; keep the gate in sync with the
    // helper's own (the union of the fs needs).
    if (s.has_need("read_file") || s.has_need("write_file") || s.has_need("remove_file")
            || s.has_need("stat") || s.has_need("read_dir") || s.has_need("remove_dir_all")
            || s.has_need("temp_dir")) {
        var ioePre1: ShapeRefOut = shape_ref(s, "NotFound");
        s = ioePre1.state;
        var ioePre2: ShapeRefOut = shape_ref(s, "PermissionDenied");
        s = ioePre2.state;
        var ioePre3: ShapeRefOut = shape_ref(s, "AlreadyExists");
        s = ioePre3.state;
        var ioePre4: ShapeRefOut = shape_ref(s, "Interrupted");
        s = ioePre4.state;
        var ioePre5: ShapeRefOut = shape_ref(s, "Other");
        s = ioePre5.state;
    }
    // .rodata: each interned string literal as a labelled `.ascii` directive
    // (GAS interprets the escapes), matching asm.fern's emit_module so the box's
    // .S<idx> data pointer resolves. string_lits was populated by const_str.
    if (s.string_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < s.string_lits.len()) {
            s = s.write(str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
    }
    // Per-module shape pointers: emit each distinct shape name once as a `.weak`
    // global symbol (shape_sym) carrying its name bytes. Every unit referencing the
    // same shape emits the same weak symbol, so the linker merges them to ONE
    // address — pointer-equality shape discrimination then holds across the module
    // boundary (a token constructed in the lexer unit matches in the parser unit).
    // Only populated on the per-module path (shape_ref interns shapes as ordinary
    // string literals when str_ns == "", so the whole-program emit is unchanged).
    if (s.shape_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var shi: i32 = 0;
        while (shi < s.shape_lits.len()) {
            var shsym: string = asmcore.shape_sym(s.shape_lits[shi]);
            s = s.write(".weak " + shsym + "\n");
            s = s.write(shsym + ": .ascii \"" + asmcore.escape_for_ascii(s.shape_lits[shi]) + "\"\n");
            shi = shi + 1;
        }
    }
    // The "maps" / "heap" needs were marked per-function during the emit loop
    // above (off the ops each lower_func already produced), so there is no need to
    // re-lower the module here. The whole-program extra_needs (sibling modules'
    // needs, for the entry's single shared runtime) were folded in above, BEFORE
    // _start (so its argc/argv save sees a sibling's args need) and hence before
    // close_needs, so their declared deps resolve too. close_needs() pulls in
    // maps' declared deps (str_eq, arr_push, heap) so the runtime links.
    s = s.close_needs();
    // The shared `__fern_*` runtime is emitted ONCE, by the entry module — a
    // non-entry library module references these helpers as externs (resolved at
    // link against the entry's copy), so emitting them again would duplicate-
    // define the symbols. (Until runtime needs are aggregated whole-program,
    // the entry only knows its OWN needs; a non-entry module that itself
    // allocates relies on the entry having pulled the heap runtime in.)
    if (is_entry) {
    // __fern_str_to_i32 (#2649): the first runtime helper hosted on the IR path
    // as a Fern function — lowered through the IR pipeline rather than emitted
    // as hand-written asm. Emitted in .text (we're in .rodata after the literal
    // pools) and gated on its need; emit_runtime_globls already .globl'd it.
    if (s.has_need("str_to_i32")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_i32(), all_structs, s);
    }
    // __fern_str_cmp (#2649): string-ordering helper, also hosted on the IR path
    // as a Fern function. Self-contained (two borrowed strings, byte compare, no
    // alloc / no other helper call), so emit_ir_runtime_fern_fn's singleton
    // side-tables are complete. Same .text + need-gated, entry-only emission.
    if (s.has_need("str_cmp")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_cmp(), all_structs, s);
    }
    // The freestanding allocator + RC runtime, only when the program allocates.
    // i32.to_string() allocates its box even in an otherwise heap-free program,
    // so its emit-time need pulls the runtime in too (its body calls __fern_alloc).
    if (s.has_need("heap") || s.has_need("i32_to_string") || s.has_need("u32_to_string") || s.has_need("str_to_i32") || s.has_need("chr") || s.has_need("print_int") || s.has_need("read_int") || s.has_need("str_read_line") || s.has_need("putchar") || s.has_need("strbuf") || s.has_need("reader") || s.has_need("write_file") || s.has_need("remove_dir_all") || s.has_need("temp_dir") || s.has_need("read_dir") || s.has_need("remove_file") || s.has_need("env") || s.has_need("stat") || s.has_need("subprocess")) { s = emit_ir_runtime(s); }
    // FFI __c_call<n> shims (#4375): allocation-free register-marshal + `call
    // *fn`, so independent of the heap runtime above. Emitted in .text when the
    // module referenced any variant (emit_ir_runtime, when it ran, left .bss).
    if (any_ccall_need(s)) {
        s = s.write("    .text\n");
        s = emit_ccall_shims(s);
    }
    // String search predicates (starts_with / ends_with / index_of) are now
    // Fern runtime functions (#2649): allocation-free + self-contained, lowered
    // through the IR pipeline via emit_ir_runtime_fern_fn (entry-only, .text;
    // emit_ir_runtime above left us in .bss). emit_runtime_globls .globl's them.
    if (s.has_need("str_search")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_search(), all_structs, s);
    }
    // __fern_str_eq (#2649): string equality, also called by the map / arr_str
    // helpers (the map_set→str_eq edge that motivated the issue). Self-contained,
    // so same entry-only .text emission; gated on str_eq (maps pulls it in via
    // close_needs).
    if (s.has_need("str_eq")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_eq(), all_structs, s);
    }
    // ASCII case transforms (to_upper / to_lower) — heap-dependent, so the heap
    // runtime is already present; emitted on their own str_case need.
    // str_to_upper / _lower — now Fern runtime functions (#2649), lowered through
    // the IR pipeline: copy each byte case-flipped if alpha. Heap-dependent.
    if (s.has_need("str_case")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_upper(), all_structs, s);
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_lower(), all_structs, s);
    }
    // String repeat — now a Fern runtime function (#2649), lowered through the
    // IR pipeline: n copies of `s` in a fresh buffer via the raw-memory
    // intrinsics. Heap-dependent (present above).
    if (s.has_need("str_repeat")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_repeat(), all_structs, s);
    }
    // String trim — now a Fern runtime function (#2649), lowered through the IR
    // pipeline (zero-copy slice; the slice box allocates, so the heap runtime
    // above is present). .text since the heap runtime left us in .bss.
    if (s.has_need("str_trim")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_trim(), all_structs, s);
    }
    // String reverse — now a Fern runtime function (#2649), lowered through the
    // IR pipeline: a fresh box with s's bytes reversed via the raw-memory
    // intrinsics. Heap-dependent (present above).
    if (s.has_need("str_reverse")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_reverse(), all_structs, s);
    }
    // String replace — now a Fern runtime function (#2649), lowered through the
    // IR pipeline: two-pass count + build via the raw-memory intrinsics.
    // Heap-dependent (present above).
    if (s.has_need("str_replace")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_replace(), all_structs, s);
    }
    // string_from_bytes — now a Fern runtime function (#2649), lowered through the
    // IR pipeline: pack each array element's low byte into a fresh string box via
    // the raw-memory intrinsics. Heap-dependent (present above).
    if (s.has_need("str_from_bytes")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_string_from_bytes(), all_structs, s);
    }
    // str_split — now a Fern runtime function (#2649), lowered through the IR
    // pipeline: scan for `sep`, append each segment slice (.append() ->
    // arr_push_owned, present via its str_split need deps). Heap-dependent (above).
    if (s.has_need("str_split")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_split(), all_structs, s);
    }
    // String chars — now a Fern runtime function (#2649), lowered through the IR
    // pipeline: appends each 1-char slice s[i:i+1] (arr_push, present via its own
    // need-gated block + the heap runtime above). .text since the heap runtime
    // left us in .bss.
    if (s.has_need("str_chars")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_chars(), all_structs, s);
    }
    // String lines — now a Fern runtime function (#2649), lowered through the IR
    // pipeline: splits on '\n' (str_split) + drops the trailing empty via an array
    // slice (arr_slice); both deps are present (heap runtime above + their own
    // need-gated blocks). .text since the heap runtime left us in .bss.
    if (s.has_need("str_lines")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_lines(), all_structs, s);
    }
    // String bytes — now a Fern runtime function (#2649), lowered through the IR
    // pipeline: builds the byte i32[] by appending each byte (arr_push, present via
    // its own need-gated block + the heap runtime above). .text since the heap
    // runtime left us in .bss.
    if (s.has_need("str_bytes")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_bytes(), all_structs, s);
    }
    // chr — first Tier-2 helper via the raw-memory intrinsics (#2649): alloc 1
    // byte, store b, box it. Lowered through the IR pipeline; the heap runtime
    // above is present (mark_chr pulls heap).
    if (s.has_need("chr")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_chr(), all_structs, s);
    }
    // str_concat — backs `+` on strings, now Tier-2 via the intrinsics (#2649):
    // alloc lenA+lenB, copy A then B byte-by-byte, box it. Heap-dependent (present
    // above). .text since the heap runtime left us in .bss.
    if (s.has_need("str_concat")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_concat(), all_structs, s);
    }
    // i32_to_string — backs (n).to_string(), Tier-2 via the intrinsics (#2649):
    // digit-buffer build. Heap-dependent (present above).
    if (s.has_need("i32_to_string")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_i32_to_string(), all_structs, s);
    }
    // u32_to_string — UNSIGNED sibling for (u32).to_string() (#2649). Heap-dep.
    if (s.has_need("u32_to_string")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_u32_to_string(), all_structs, s);
    }
    // random_i32 allocates nothing, so its helper is emitted independently of
    // the heap runtime (a random_i32-only program is heap-free).
    if (s.has_need("random_i32")) { s = emit_ir_random_i32(s); }
    // Clock helpers: allocation-free, so emitted independently of the heap
    // runtime (a clock-only program is heap-free), like random_i32.
    if (s.has_need("monotonic_ns")) { s = emit_ir_monotonic_ns(s); }
    if (s.has_need("now_unix_ms")) { s = emit_ir_now_unix_ms(s); }
    if (s.has_need("now_ns")) { s = emit_ir_now_ns(s); }
    if (s.has_need("poll")) { s = emit_ir_poll(s); }
    if (s.has_need("timer_fd")) { s = emit_ir_timer_fd(s); }
    if (s.has_need("wasm_timer_pollable")) { s = emit_ir_wasm_timer_pollable(s); }
    if (s.has_need("wasm_pollable_drop")) { s = emit_ir_wasm_pollable_drop(s); }
    if (s.has_need("wasm_block")) { s = emit_ir_wasm_block(s); }
    if (s.has_need("wasm_poll")) { s = emit_ir_wasm_poll(s); }
    if (s.has_need("tcp_connect")) { s = emit_ir_tcp_connect(s); }
    if (s.has_need("tcp_pollable")) { s = emit_ir_tcp_pollable(s); }
    if (s.has_need("tcp_close")) { s = emit_ir_tcp_close(s); }
    if (s.has_need("tcp_recv")) { s = emit_ir_tcp_recv(s); }
    if (s.has_need("tcp_send")) { s = emit_ir_tcp_send(s); }
    if (s.has_need("tcp_listen")) { s = emit_ir_tcp_listen(s); }
    if (s.has_need("tcp_accept")) { s = emit_ir_tcp_accept(s); }
    if (s.has_need("open_file")) { s = emit_ir_open_fd(s); }
    if (s.has_need("sleep_ms")) { s = emit_ir_sleep_ms(s); }
    }
    return strbuf_take();
}
