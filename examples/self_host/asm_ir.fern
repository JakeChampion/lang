        s = s.write("    cmpq $0, %rdx\n    jl " + r_none + "\n");
        s = s.write(r_loop + ":\n");
        s = s.write("    movzbq (%rax,%rdx), %r9\n");
        s = s.write("    cmpq %rcx, %r9\n    je " + r_done + "\n");
        s = s.write("    subq $1, %rdx\n    cmpq $0, %rdx\n    jge " + r_loop + "\n");
        s = s.write(r_none + ":\n    movq $-1, %rdx\n");
        s = s.write(r_done + ":\n    pushq %rdx\n");
