// examples/self_host/asm_ir.fern — the IR code path for the production
// x86-64 backend, the first integration of the native-shaped stack IR
// (ir.fern / irlower.fern) into asm.fern's world (docs/RC-PERCEUS-SELF-HOST-
// IR-REBUILD.md §3). emit_module_ir lowers each function AST -> stack IR ->
// asm and instruction-selects it into asm.fern's OWN dialect: same
// `__fn_<name>:` label, same rbp frame + leave/ret, same machine-stack
// operand discipline (every value `pushq`-ed, consumers `popq`), so an
// IR-emitted function is ABI-identical to an AST-emitted one — and the two
// must produce identical behaviour (the differential gate).
//
// SCOPE (slice 16): pure i32 functions — no params, no user calls, no arrays
// — proving the seam end-to-end. asm.fern itself is UNCHANGED (this module is
// imported only by asm_run via its `-ir` flag), so the byte-identical
// self-bootstrap and every asm.fern-based harness are unaffected. emit_module_ir
// only handles modules where EVERY function is eligible (all_eligible); the
// driver falls back to asm.emit_module otherwise. As the eligible subset
// widens, this folds back into asm.fern's emit_module behind a flag.

import "./parser";
import "./asmcore";
import "./util";
import "./ir";
import "./irlower";

// ir_eligible reports whether a function is in the IR path's current subset:
// i32 functions with params, direct calls, and arrays (heap alloc / index /
// write / len + Perceus RC, including borrowed array params and array returns
// via move-on-return) — but no methods. Cross-function arrays are sound here
// because the IR path only fires when the WHOLE module is eligible
// (all_eligible), so every function — caller and callee — uses irlower's
// array layout; nothing crosses an IR/AST boundary.
pub function ir_eligible(fd: parser.FuncDecl, mod: parser.Module): boolean {
    // Methods (receiver functions) are lowered too — lower_func binds the
    // receiver as slot 0 and bails for non-scalar-struct receivers.
    //
    // The eligibility probe lowers fd with the SAME registries
    // emit_function_via_ir (and the wasm emit_function_ir) use, so "eligible"
    // means exactly "lowers". Threading the array registries matters for ok/bail,
    // not just op selection: `var a = mk()` (an array-returning call) is tracked
    // as an array only when `mk` is in arr_ret_fns, and a later `for x in a`
    // bails when its slot isn't array-typed; str_ret_fns likewise decides whether
    // `for b in greet()` (a string-returning-call iterable) types as a string and
    // lowers via the byte-foreach path (#2822). An empty registry here
    // under-approximates, routing such modules to the AST path even though they
    // lower; all three backends now thread the real registries through emission
    // too, so the gate and the emitter agree.
    var r: irlower.LowerResult = irlower.lower_func_for(fd, array_ret_fns(mod), mod.structs, mod.funcs);
    if (!r.ok) { return false; }
    return true;
}

// is_array_type reports whether a type string denotes an array (ends "[]").
function is_array_type(t: string): boolean {
    var n: i32 = t.len();
    if (n < 2) { return false; }
    return t[n - 2 : n] == "[]";
}

// array_ret_fns collects the names of functions whose return type is an array,
// so move-on-return / move-from-call fire (mirrors irlower.lower_module).
pub function array_ret_fns(mod: parser.Module): string[] {
    return array_ret_fns_of(mod.funcs);
}

// array_ret_fns_of is array_ret_fns over an explicit funcs array, so it can be
// derived over the WHOLE-PROGRAM function set (#3454) rather than one module's.
pub function array_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (is_array_type(funcs[i].ret_type)) { out = out.append(funcs[i].name); }
        // A lifted if-/match-expression `__lam_` whose branch is an array literal
        // carries a default i32 ret_type, so `var xs = if (c) { [..] } else { .. }`
        // was mis-treated as a scalar. Register it (a fresh owned-array move, like
        // any array-returning fn) so the binding tracks as an array (#3224).
        else if (funcs[i].name.len() >= 6 && funcs[i].name[0:6] == "__lam_" && irlower.lam_leaf_array_elem(funcs[i], funcs, 0) != "") { out = out.append(funcs[i].name); }
        i = i + 1;
    }
    return out;
}

// is_fern_helper reports whether a call_direct callee is one of the IR
// runtime helpers the emitter actually provides (emit_ir_runtime). These now
// use asm.fern's OWN stack-arg ABI + symbols (so the IR path is a drop-in for
// asm.fern's array RC) — see ir_helper_symbol for the name map. The whitelist
// is exact: any OTHER __fern_* / __rc_* call is NOT provided here, so
// calls_only_known disqualifies the module from the IR path and it falls back
// to the AST emitter. (__fern_heap_used has no asm.fern equivalent, so a
// program using it now routes through the AST path.)
pub function is_fern_helper(name: string): boolean {
    return name == "__fern_rc_inc"
        || name == "__fern_rc_dec"
        || name == "__fern_rc_is_unique"
        || name == "__fern_rc_underflow_get"
        // i32.to_string()'s decimal-text helper (emit_ir_runtime provides the
        // stack-arg body under __fn___fern_i32_to_string).
        || name == "__fern_i32_to_string"
        // str_to_i32(s)'s decimal-parse helper (allocation-free stack-arg body
        // under __fn___fern_str_to_i32, also from emit_ir_runtime).
        || name == "__fern_str_to_i32"
        // chr(n)'s 1-char-string-box helper (stack-arg body under
        // __fn___fern_chr; allocates, so it needs the heap runtime).
        || name == "__fern_chr";
}

// ir_helper_symbol maps an IR runtime-helper name to the asm.fern symbol the
// IR path calls (stack-arg ABI). The exit-sweep / reassign release
// (__fern_rc_dec) maps to __fn___fern_arr_dec — the array release that frees
// at rc==1 via the size-class freelist — so the IR path reclaims exactly as
// asm.fern's AST path does.
pub function ir_helper_symbol(name: string): string {
    if (name == "__fern_rc_inc") { return "__fn___fern_rc_inc"; }
    if (name == "__fern_rc_dec") { return "__fn___fern_arr_dec"; }
    if (name == "__fern_rc_is_unique") { return "__fn___fern_rc_is_unique"; }
    if (name == "__fern_rc_underflow_get") { return "__fn___fern_rc_underflow_count"; }
    return "__fn_" + name;
}

// emit_ir_str_search appends the scalar string search predicates
// (__fern_str_starts_with / _ends_with / _index_of), transcribed verbatim from
// asm.fern's str_search block. All three only read the two string boxes — no
// allocation, no calls — so they're emitted independently of the heap runtime
// (a predicate-only program is heap-free) and kept in their OWN function: folding
// them into emit_ir_runtime pushed it past the self-host's oversized-function
// miscompile threshold (#2720 — the stage-2 self-compile crashed with signal 9).
function emit_ir_str_search(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_str_starts_with:\n");
    s = s.write("    movq 8(%rsi), %rcx\n");
    s = s.write("    movq 8(%rdi), %rax\n");
    s = s.write("    cmpq %rcx, %rax\n");
    s = s.write("    jl .Lir_sw_no\n");
    s = s.write("    movq (%rdi), %rdi\n");
    s = s.write("    movq (%rsi), %rsi\n");
    s = s.write("    cmpq $0, %rcx\n");
    s = s.write("    je .Lir_sw_yes\n");
    s = s.write(".Lir_sw_loop:\n");
    s = s.write("    movzbq (%rdi), %rax\n");
    s = s.write("    movzbq (%rsi), %rdx\n");
    s = s.write("    cmpq %rdx, %rax\n");
    s = s.write("    jne .Lir_sw_no\n");
    s = s.write("    incq %rdi\n");
    s = s.write("    incq %rsi\n");
    s = s.write("    decq %rcx\n");
    s = s.write("    jne .Lir_sw_loop\n");
    s = s.write(".Lir_sw_yes:\n");
    s = s.write("    movq $1, %rax\n");
    s = s.write("    ret\n");
    s = s.write(".Lir_sw_no:\n");
    s = s.write("    movq $0, %rax\n");
    s = s.write("    ret\n");
    s = s.write("__fern_str_ends_with:\n");
    s = s.write("    movq 8(%rsi), %rcx\n");
    s = s.write("    movq 8(%rdi), %rax\n");
    s = s.write("    cmpq %rcx, %rax\n");
    s = s.write("    jl .Lir_ew_no\n");
    s = s.write("    subq %rcx, %rax\n");
    s = s.write("    movq (%rdi), %rdi\n");
    s = s.write("    addq %rax, %rdi\n");
    s = s.write("    movq (%rsi), %rsi\n");
    s = s.write("    cmpq $0, %rcx\n");
    s = s.write("    je .Lir_ew_yes\n");
    s = s.write(".Lir_ew_loop:\n");
    s = s.write("    movzbq (%rdi), %rax\n");
    s = s.write("    movzbq (%rsi), %rdx\n");
    s = s.write("    cmpq %rdx, %rax\n");
    s = s.write("    jne .Lir_ew_no\n");
    s = s.write("    incq %rdi\n");
    s = s.write("    incq %rsi\n");
    s = s.write("    decq %rcx\n");
    s = s.write("    jne .Lir_ew_loop\n");
    s = s.write(".Lir_ew_yes:\n");
    s = s.write("    movq $1, %rax\n");
    s = s.write("    ret\n");
    s = s.write(".Lir_ew_no:\n");
    s = s.write("    movq $0, %rax\n");
    s = s.write("    ret\n");
    s = s.write("__fern_str_index_of:\n");
    s = s.write("    movq 8(%rdi), %r8\n");
    s = s.write("    movq 8(%rsi), %r9\n");
    s = s.write("    cmpq $0, %r9\n");
    s = s.write("    je .Lir_idx_zero\n");
    s = s.write("    movq %r8, %r10\n");
    s = s.write("    subq %r9, %r10\n");
    s = s.write("    cmpq $0, %r10\n");
    s = s.write("    jl .Lir_idx_no\n");
    s = s.write("    movq (%rdi), %r11\n");
    s = s.write("    movq (%rsi), %rdi\n");
    s = s.write("    movq $0, %rcx\n");
    s = s.write(".Lir_idx_outer:\n");
    s = s.write("    cmpq %r10, %rcx\n");
    s = s.write("    jg .Lir_idx_no\n");
    s = s.write("    movq %rcx, %rdx\n");
    s = s.write("    movq $0, %r12\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq $0, %r12\n");
    s = s.write(".Lir_idx_inner:\n");
    s = s.write("    cmpq %r9, %r12\n");
    s = s.write("    je .Lir_idx_match\n");
    s = s.write("    movq %r11, %rax\n");
    s = s.write("    addq %rcx, %rax\n");
    s = s.write("    addq %r12, %rax\n");
    s = s.write("    movzbq (%rax), %rdx\n");
    s = s.write("    movq %rdi, %rax\n");
    s = s.write("    addq %r12, %rax\n");
    s = s.write("    movzbq (%rax), %rax\n");
    s = s.write("    cmpq %rax, %rdx\n");
    s = s.write("    jne .Lir_idx_skip\n");
    s = s.write("    incq %r12\n");
    s = s.write("    jmp .Lir_idx_inner\n");
    s = s.write(".Lir_idx_skip:\n");
    s = s.write("    popq %r12\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lir_idx_outer\n");
    s = s.write(".Lir_idx_match:\n");
    s = s.write("    popq %r12\n");
    s = s.write("    movq %rcx, %rax\n");
    s = s.write("    ret\n");
    s = s.write(".Lir_idx_zero:\n");
    s = s.write("    movq $0, %rax\n");
    s = s.write("    ret\n");
    s = s.write(".Lir_idx_no:\n");
    s = s.write("    movq $-1, %rax\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_str_case appends the ASCII case transforms (__fern_str_to_upper /
// _to_lower), transcribed verbatim from asm.fern. Each allocates a fresh char
// buffer (len bytes, min 1) + 16-byte box and copies `s` case-flipping ASCII
// letters. Heap-dependent (calls __fern_alloc), so the heap runtime is already
// present (module_uses_heap covers str_to_upper/_lower); gated on the str_case
// need. Its own function — see emit_ir_str_search re #2720.
function emit_ir_str_case(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_str_to_upper:\n");
    s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n    pushq %r13\n    pushq %r14\n");
    s = s.write("    movq (%rdi), %r12\n    movq 8(%rdi), %r13\n");
    s = s.write("    movq %r13, %rdi\n    cmpq $0, %rdi\n    jne .Lir_upper_alloc\n    movq $1, %rdi\n");
    s = s.write(".Lir_upper_alloc:\n    call __fern_alloc\n");
    s = s.write("    movq %rax, %r14\n    movq %r12, %rsi\n    movq %r14, %rdi\n    movq %r13, %rcx\n");
    s = s.write("    cmpq $0, %rcx\n    je .Lir_upper_box\n");
    s = s.write(".Lir_upper_loop:\n    movzbq (%rsi), %rax\n");
    s = s.write("    cmpq $97, %rax\n    jl .Lir_upper_skip\n    cmpq $122, %rax\n    jg .Lir_upper_skip\n    subq $32, %rax\n");
    s = s.write(".Lir_upper_skip:\n    movb %al, (%rdi)\n    incq %rsi\n    incq %rdi\n    decq %rcx\n    jne .Lir_upper_loop\n");
    s = s.write(".Lir_upper_box:\n    movq $16, %rdi\n    call __fern_alloc\n");
    s = s.write("    movq %r14, (%rax)\n    movq %r13, 8(%rax)\n");
    s = s.write("    popq %r14\n    popq %r13\n    popq %r12\n    leave\n    ret\n");
    s = s.write("__fern_str_to_lower:\n");
    s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n    pushq %r13\n    pushq %r14\n");
    s = s.write("    movq (%rdi), %r12\n    movq 8(%rdi), %r13\n");
    s = s.write("    movq %r13, %rdi\n    cmpq $0, %rdi\n    jne .Lir_lower_alloc\n    movq $1, %rdi\n");
    s = s.write(".Lir_lower_alloc:\n    call __fern_alloc\n");
    s = s.write("    movq %rax, %r14\n    movq %r12, %rsi\n    movq %r14, %rdi\n    movq %r13, %rcx\n");
    s = s.write("    cmpq $0, %rcx\n    je .Lir_lower_box\n");
    s = s.write(".Lir_lower_loop:\n    movzbq (%rsi), %rax\n");
    s = s.write("    cmpq $65, %rax\n    jl .Lir_lower_skip\n    cmpq $90, %rax\n    jg .Lir_lower_skip\n    addq $32, %rax\n");
    s = s.write(".Lir_lower_skip:\n    movb %al, (%rdi)\n    incq %rsi\n    incq %rdi\n    decq %rcx\n    jne .Lir_lower_loop\n");
    s = s.write(".Lir_lower_box:\n    movq $16, %rdi\n    call __fern_alloc\n");
    s = s.write("    movq %r14, (%rax)\n    movq %r13, 8(%rax)\n");
    s = s.write("    popq %r14\n    popq %r13\n    popq %r12\n    leave\n    ret\n");
    return s;
}

// emit_ir_str_repeat appends __fern_str_repeat (s, n) — n copies of `s` in a
// fresh buffer + box, transcribed verbatim from asm.fern. n <= 0 → empty box.
// Heap-dependent (calls __fern_alloc), gated on the str_repeat need. Its own
// function — see emit_ir_str_search re #2720.
function emit_ir_str_repeat(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_str_repeat:\n");
    s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n");
    s = s.write("    movq (%rdi), %r12\n    movq 8(%rdi), %r13\n    movq %rsi, %r14\n");
    s = s.write("    cmpq $0, %r14\n    jg .Lir_rep_compute\n");
    s = s.write("    movq $0, %r13\n    movq $0, %r14\n");
    s = s.write(".Lir_rep_compute:\n");
    s = s.write("    movq %r13, %rax\n    imulq %r14, %rax\n    movq %rax, %r15\n");
    s = s.write("    movq %r15, %rdi\n    cmpq $0, %rdi\n    jne .Lir_rep_alloc\n    movq $1, %rdi\n");
    s = s.write(".Lir_rep_alloc:\n    call __fern_alloc\n");
    s = s.write("    movq %rax, %rdi\n    movq %rax, %r8\n");
    s = s.write("    cmpq $0, %r14\n    je .Lir_rep_box\n");
    s = s.write(".Lir_rep_outer:\n");
    s = s.write("    movq %r12, %rsi\n    movq %r13, %rcx\n    cmpq $0, %rcx\n    je .Lir_rep_next\n");
    s = s.write(".Lir_rep_inner:\n");
    s = s.write("    movzbq (%rsi), %rax\n    movb %al, (%rdi)\n");
    s = s.write("    incq %rsi\n    incq %rdi\n    decq %rcx\n    jne .Lir_rep_inner\n");
    s = s.write(".Lir_rep_next:\n    decq %r14\n    cmpq $0, %r14\n    jne .Lir_rep_outer\n");
    s = s.write(".Lir_rep_box:\n");
    s = s.write("    movq %r8, %r12\n    movq $16, %rdi\n    call __fern_alloc\n");
    s = s.write("    movq %r12, (%rax)\n    movq %r15, 8(%rax)\n");
    s = s.write("    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    leave\n    ret\n");
    return s;
}

// emit_ir_str_trim appends __fern_str_trim(s) — a fresh 16-byte box [data, len]
// pointing into `s`'s data with leading/trailing ASCII whitespace
// (space/tab/'\n'/'\r') skipped (a zero-copy view, transcribed verbatim from
// asm.fern). Heap-dependent (calls __fern_alloc), gated on the str_trim need.
// Its own function — see emit_ir_str_search re #2720.
function emit_ir_str_trim(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_str_trim:\n");
    s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n    pushq %r13\n");
    s = s.write("    movq (%rdi), %r12\n    movq 8(%rdi), %r13\n");
    s = s.write(".Lir_trim_front:\n");
    s = s.write("    cmpq $0, %r13\n    je .Lir_trim_box\n");
    s = s.write("    movzbq (%r12), %rax\n");
    s = s.write("    cmpq $32, %rax\n    je .Lir_trim_front_step\n");
    s = s.write("    cmpq $9, %rax\n    je .Lir_trim_front_step\n");
    s = s.write("    cmpq $10, %rax\n    je .Lir_trim_front_step\n");
    s = s.write("    cmpq $13, %rax\n    je .Lir_trim_front_step\n");
    s = s.write("    jmp .Lir_trim_back\n");
    s = s.write(".Lir_trim_front_step:\n");
    s = s.write("    incq %r12\n    decq %r13\n    jmp .Lir_trim_front\n");
    s = s.write(".Lir_trim_back:\n");
    s = s.write("    cmpq $0, %r13\n    je .Lir_trim_box\n");
    s = s.write("    movq %r12, %rcx\n    addq %r13, %rcx\n    decq %rcx\n");
    s = s.write("    movzbq (%rcx), %rax\n");
    s = s.write("    cmpq $32, %rax\n    je .Lir_trim_back_step\n");
    s = s.write("    cmpq $9, %rax\n    je .Lir_trim_back_step\n");
    s = s.write("    cmpq $10, %rax\n    je .Lir_trim_back_step\n");
    s = s.write("    cmpq $13, %rax\n    je .Lir_trim_back_step\n");
    s = s.write("    jmp .Lir_trim_box\n");
    s = s.write(".Lir_trim_back_step:\n");
    s = s.write("    decq %r13\n    jmp .Lir_trim_back\n");
    s = s.write(".Lir_trim_box:\n");
    s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
    s = s.write("    movq %r12, (%rax)\n    movq %r13, 8(%rax)\n");
    s = s.write("    popq %r13\n    popq %r12\n    leave\n    ret\n");
    return s;
}

// emit_ir_str_reverse appends __fern_str_reverse(s) — a fresh string box with
// `s`'s bytes reversed (a real copy, transcribed verbatim from asm.fern).
// Heap-dependent (calls __fern_alloc), gated on the str_reverse need. Its own
// function — see emit_ir_str_search re #2720.
function emit_ir_str_reverse(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_str_reverse:\n");
    s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n");
    s = s.write("    movq (%rdi), %r12\n    movq 8(%rdi), %r13\n");
    s = s.write("    movq %r13, %rdi\n    call __fern_alloc\n");
    s = s.write("    movq %rax, %r14\n");
    s = s.write("    movq $0, %r15\n");
    s = s.write(".Lir_str_rev_loop:\n");
    s = s.write("    cmpq %r13, %r15\n    jge .Lir_str_rev_done\n");
    s = s.write("    movq %r13, %rcx\n    subq %r15, %rcx\n    decq %rcx\n");
    s = s.write("    movzbq (%r12,%rcx,1), %rax\n");
    s = s.write("    movb %al, (%r14,%r15,1)\n");
    s = s.write("    incq %r15\n    jmp .Lir_str_rev_loop\n");
    s = s.write(".Lir_str_rev_done:\n");
    s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
    s = s.write("    movq %r14, (%rax)\n    movq %r13, 8(%rax)\n");
    s = s.write("    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    leave\n    ret\n");
    return s;
}

// emit_ir_str_replace appends __fern_str_replace(haystack, old, new) — every
// non-overlapping occurrence of `old` replaced by `new` (empty `old` / no match
// → haystack unchanged). Two-pass: count, alloc exact, walk+copy. Transcribed
// verbatim from asm.fern. Heap-dependent, gated on the str_replace need. Its own
// function — see emit_ir_str_search re #2720.
function emit_ir_str_replace(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_str_replace:\n");
    s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n    subq $32, %rsp\n");
    s = s.write("    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n");
    s = s.write("    movq %rdi, -8(%rbp)\n    movq %rsi, -16(%rbp)\n    movq %rdx, -24(%rbp)\n    movq $0, -32(%rbp)\n");
    s = s.write("    movq 8(%rsi), %r14\n    testq %r14, %r14\n    jnz .Lir_repl_count\n");
    s = s.write("    movq %rdi, %rax\n    jmp .Lir_repl_exit\n");
    s = s.write(".Lir_repl_count:\n");
    s = s.write("    movq (%rdi), %r12\n    movq 8(%rdi), %r13\n    movq (%rsi), %rbx\n    movq $0, %r15\n");
    s = s.write(".Lir_repl_cl:\n");
    s = s.write("    movq %r15, %rax\n    addq %r14, %rax\n    cmpq %r13, %rax\n    jg .Lir_repl_count_done\n");
    s = s.write("    movq $0, %r10\n");
    s = s.write(".Lir_repl_clm:\n");
    s = s.write("    cmpq %r14, %r10\n    je .Lir_repl_match\n");
    s = s.write("    movq %r12, %r11\n    addq %r15, %r11\n    addq %r10, %r11\n    movzbq (%r11), %rax\n");
    s = s.write("    movq %rbx, %r11\n    addq %r10, %r11\n    movzbq (%r11), %r11\n");
    s = s.write("    cmpq %r11, %rax\n    jne .Lir_repl_clnomatch\n    incq %r10\n    jmp .Lir_repl_clm\n");
    s = s.write(".Lir_repl_match:\n");
    s = s.write("    incq -32(%rbp)\n    addq %r14, %r15\n    jmp .Lir_repl_cl\n");
    s = s.write(".Lir_repl_clnomatch:\n");
    s = s.write("    incq %r15\n    jmp .Lir_repl_cl\n");
    s = s.write(".Lir_repl_count_done:\n");
    s = s.write("    movq -32(%rbp), %rax\n    testq %rax, %rax\n    jnz .Lir_repl_build\n");
    s = s.write("    movq -8(%rbp), %rax\n    jmp .Lir_repl_exit\n");
    s = s.write(".Lir_repl_build:\n");
    s = s.write("    movq -24(%rbp), %rax\n    movq 8(%rax), %rax\n    subq %r14, %rax\n    imulq -32(%rbp), %rax\n    addq %r13, %rax\n    movq %rax, %r15\n");
    s = s.write("    cmpq $0, %rax\n    jne .Lir_repl_alloc\n    movq $1, %rax\n");
    s = s.write(".Lir_repl_alloc:\n");
    s = s.write("    movq %rax, %rdi\n    call __fern_alloc\n    movq %rax, %rbx\n");
    s = s.write("    movq -8(%rbp), %rax\n    movq (%rax), %r12\n    movq $0, %r10\n    movq %rbx, %r11\n");
    s = s.write(".Lir_repl_walk:\n");
    s = s.write("    movq %r10, %rax\n    addq %r14, %rax\n    cmpq %r13, %rax\n    jg .Lir_repl_tail\n");
    s = s.write("    movq $0, %rcx\n");
    s = s.write(".Lir_repl_chk:\n");
    s = s.write("    cmpq %r14, %rcx\n    je .Lir_repl_writenew\n");
    s = s.write("    movq %r12, %rsi\n    addq %r10, %rsi\n    addq %rcx, %rsi\n    movzbq (%rsi), %rdx\n");
    s = s.write("    movq -16(%rbp), %rsi\n    movq (%rsi), %rsi\n    addq %rcx, %rsi\n    movzbq (%rsi), %rsi\n");
    s = s.write("    cmpq %rsi, %rdx\n    jne .Lir_repl_chknomatch\n    incq %rcx\n    jmp .Lir_repl_chk\n");
    s = s.write(".Lir_repl_writenew:\n");
    s = s.write("    movq -24(%rbp), %rsi\n    movq (%rsi), %rsi\n    movq -24(%rbp), %rcx\n    movq 8(%rcx), %rcx\n");
    s = s.write("    testq %rcx, %rcx\n    jz .Lir_repl_advance\n");
    s = s.write(".Lir_repl_wn_loop:\n");
    s = s.write("    movzbq (%rsi), %rdx\n    movb %dl, (%r11)\n    incq %rsi\n    incq %r11\n    decq %rcx\n    jnz .Lir_repl_wn_loop\n");
    s = s.write(".Lir_repl_advance:\n");
    s = s.write("    addq %r14, %r10\n    jmp .Lir_repl_walk\n");
    s = s.write(".Lir_repl_chknomatch:\n");
    s = s.write("    movq %r12, %rsi\n    addq %r10, %rsi\n    movzbq (%rsi), %rax\n    movb %al, (%r11)\n    incq %r10\n    incq %r11\n    jmp .Lir_repl_walk\n");
    s = s.write(".Lir_repl_tail:\n");
    s = s.write("    cmpq %r13, %r10\n    je .Lir_repl_box\n");
    s = s.write("    movq %r12, %rsi\n    addq %r10, %rsi\n    movzbq (%rsi), %rax\n    movb %al, (%r11)\n    incq %r10\n    incq %r11\n    jmp .Lir_repl_tail\n");
    s = s.write(".Lir_repl_box:\n");
    s = s.write("    movq $16, %rdi\n    call __fern_alloc\n    movq %rbx, (%rax)\n    movq %r15, 8(%rax)\n");
    s = s.write(".Lir_repl_exit:\n");
    s = s.write("    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    leave\n    ret\n");
    return s;
}

// emit_ir_str_chars appends __fern_str_chars(s) — a fresh string[] whose i-th
// element is a 1-char string box [data = s.data + i, len = 1] (a zero-copy view
// into the source bytes). Transcribed verbatim from asm.fern. Heap-dependent
// (calls __fern_arr_box / __fern_alloc), gated on the str_chars need. Its own
// function — see emit_ir_str_search re #2720.
function emit_ir_str_chars(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_str_chars:\n");
    s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n");
    s = s.write("    subq $16, %rsp\n");
    s = s.write("    movq %rdi, %r12\n    movq (%r12), %r13\n    movq 8(%r12), %r14\n");
    s = s.write("    movq %r14, %rdi\n    call __fern_arr_box\n    movq %rax, %r15\n");
    s = s.write("    movq $0, -40(%rbp)\n");
    s = s.write(".Lir_chars_loop:\n");
    s = s.write("    movq -40(%rbp), %rcx\n    cmpq %r14, %rcx\n    jge .Lir_chars_done\n");
    s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
    s = s.write("    movq -40(%rbp), %rcx\n    movq %r13, %rdx\n    addq %rcx, %rdx\n    movq %rdx, (%rax)\n");
    s = s.write("    movq $1, 8(%rax)\n");
    s = s.write("    movq -40(%rbp), %rcx\n    incq %rcx\n    movq %rax, (%r15,%rcx,8)\n");
    s = s.write("    incq -40(%rbp)\n    jmp .Lir_chars_loop\n");
    s = s.write(".Lir_chars_done:\n");
    s = s.write("    movq %r15, %rax\n    addq $16, %rsp\n");
    s = s.write("    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    leave\n    ret\n");
    return s;
}

// emit_ir_str_lines appends __fern_str_lines(s) — split s on '\n' then drop a
// trailing empty segment when s is empty or ends with '\n' (so "a\nb\n".lines()
// is 2, matching the AST path / Rust / Python). Builds a "\n" delim box (two
// allocs, no static data) and calls __fern_str_split, then decrements the result
// array's len word by the trim flag. Heap + str_split dependent; gated on the
// str_lines need. Its own function — see emit_ir_str_search re #2720.
function emit_ir_str_lines(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_str_lines:\n");
    s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n    pushq %r13\n");
    s = s.write("    movq %rdi, %r12\n");
    s = s.write("    movq 8(%rdi), %rcx\n    movq $1, %r13\n");
    s = s.write("    testq %rcx, %rcx\n    jz .Lir_lines_box\n");
    s = s.write("    movq (%rdi), %rdx\n    decq %rcx\n    movzbq (%rdx,%rcx,1), %rcx\n");
    s = s.write("    cmpq $10, %rcx\n    sete %r13b\n    movzbq %r13b, %r13\n");
    s = s.write(".Lir_lines_box:\n");
    s = s.write("    movq $1, %rdi\n    call __fern_alloc\n    movb $10, (%rax)\n");
    s = s.write("    pushq %rax\n");
    s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
    s = s.write("    popq %rcx\n    movq %rcx, (%rax)\n    movq $1, 8(%rax)\n");
    s = s.write("    movq %rax, %rsi\n    movq %r12, %rdi\n    call __fern_str_split\n");
    s = s.write("    subq %r13, (%rax)\n");
    s = s.write("    popq %r13\n    popq %r12\n    leave\n    ret\n");
    return s;
}

// emit_ir_random_i32 appends the __fern_random_i32() helper. Kept OUT of
// emit_ir_runtime (which is heap-gated) because random_i32 allocates nothing —
// a program that only calls random_i32 uses no heap, so its helper must still
// emit. getrandom(buf, 4, 0) into a 16-byte stack slot, reload as i32. (No
// asm.fern counterpart — legacy x86-64 lacked random_i32; new for the IR path,
// mirroring the Go backend.)
function emit_ir_random_i32(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_random_i32:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");        // 4-byte landing buffer (aligned)
    s = s.write("    leaq -16(%rbp), %rdi\n");  // getrandom(buf, 4, 0)
    s = s.write("    movq $4, %rsi\n");
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $318, %rax\n");
    s = s.write("    syscall\n");
    s = s.write("    movl -16(%rbp), %eax\n");  // 4 random bytes -> i32 (zero-extends)
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_monotonic_ns / emit_ir_now_unix_ms append the clock-reading helpers,
// transcribed verbatim from asm.fern's emit_runtime so the IR path is a
// byte-compatible drop-in for the AST path's clock builtins. Kept OUT of
// emit_ir_runtime (heap-gated) — a pure-scalar program that only times
// something allocates nothing, so its helper must still emit. clock_gettime is
// x86-64 syscall 228; the kernel writes a `struct timespec { i64 tv_sec; i64
// tv_nsec }`. Errno is ignored (fixed clock id + stack buffer we control).
function emit_ir_monotonic_ns(s: asmcore.EmitState): asmcore.EmitState {
    // monotonic_ns: CLOCK_MONOTONIC=1 → tv_sec*1e9 + tv_nsec.
    s = s.write("__fern_monotonic_ns:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $1, %rdi\n");           // CLOCK_MONOTONIC
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %rax\n");       // tv_sec
    s = s.write("    imulq $1000000000, %rax, %rax\n"); // sec * 1e9
    s = s.write("    addq 8(%rsp), %rax\n");      // + tv_nsec
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}
function emit_ir_now_unix_ms(s: asmcore.EmitState): asmcore.EmitState {
    // now_unix_ms: CLOCK_REALTIME=0 → tv_sec*1000 + tv_nsec/1e6.
    s = s.write("__fern_now_unix_ms:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $0, %rdi\n");           // CLOCK_REALTIME
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %r10\n");       // tv_sec
    s = s.write("    imulq $1000, %r10, %r10\n"); // sec * 1000
    s = s.write("    movq 8(%rsp), %rax\n");      // tv_nsec
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $1000000, %rcx\n");
    s = s.write("    divq %rcx\n");               // rax = nsec / 1e6
    s = s.write("    addq %r10, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_now_ns appends the __fern_now_ns() helper — wall-clock nanoseconds via
// clock_gettime(CLOCK_REALTIME) → tv_sec*1e9 + tv_nsec (the nanosecond twin of
// now_unix_ms). Allocation-free, gated on the now_ns need like the siblings.
function emit_ir_now_ns(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_now_ns:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $0, %rdi\n");           // CLOCK_REALTIME
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %rax\n");       // tv_sec
    s = s.write("    imulq $1000000000, %rax, %rax\n"); // sec * 1e9
    s = s.write("    addq 8(%rsp), %rax\n");      // + tv_nsec
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_sleep_ms appends the __fern_sleep_ms(%rdi = ms) helper, transcribed
// verbatim from asm.fern's emit_runtime: split ms into a timespec
// {sec=ms/1000, nsec=(ms%1000)*1e6} on the stack and nanosleep (syscall 35);
// ms <= 0 returns immediately. Allocation-free, so emitted independently of the
// heap runtime (gated on the sleep_ms need), like the clock helpers.
function emit_ir_sleep_ms(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_sleep_ms:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $32, %rsp\n");
    s = s.write("    cmpq $0, %rdi\n");
    s = s.write("    jle .Lir_sm_done\n");
    s = s.write("    movq %rdi, %rax\n");
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $1000, %rcx\n");
    s = s.write("    divq %rcx\n");
    s = s.write("    movq %rax, (%rsp)\n");
    s = s.write("    movq $1000000, %rax\n");
    s = s.write("    imulq %rdx, %rax\n");
    s = s.write("    movq %rax, 8(%rsp)\n");
    s = s.write("    movq %rsp, %rdi\n");
    s = s.write("    movq $0, %rsi\n");
    s = s.write("    movq $35, %rax\n");
    s = s.write("    syscall\n");
    s = s.write(".Lir_sm_done:\n");
    s = s.write("    addq $32, %rsp\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_runtime appends the array/RC/heap runtime the IR path needs, using
// asm.fern's OWN array layout + helper bodies (transcribed verbatim from
// asm.fern's emit_runtime) so the IR path is a byte-compatible DROP-IN: the
// 8-byte rc-header box (base = [cap, rc, len, e0..]; data = base+16; cap at
// data-16, rc at data-8, element i at data+(i+1)*8), the size-classed
// __fern_freelist allocator, and the stack-ABI rc helpers
// (__fn___fern_rc_inc / __fn___fern_arr_dec / …). asm.fern imports asm_ir
// (not the reverse), so these bodies are duplicated here rather than shared;
// the two emit paths are mutually exclusive per compile (emit_module vs
// emit_module_ir), so there is no symbol clash. Keep in sync with asm.fern.
function emit_ir_runtime(s: asmcore.EmitState): asmcore.EmitState {
    // .bss: heap bump pointer, the over-release detector, the size-classed
    // freelist (65536 classes * 8 bytes), and a 1 GiB zero-page heap.
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_heap_ptr: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_rc_underflow: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_freelist: .skip 524288\n");
    // The multi-GiB `__fern_heap: .skip` is emitted LAST in emit_ir_runtime
    // (just before `return s;`) so __fern_heap is the final .bss symbol — its
    // base lives above 2 GiB and is reached via 64-bit-absolute `movabs
    // $__fern_heap`, keeping its R_X86_64_PC32 relocations from truncating.
    // Mirrors asm.fern's AST path. Keep in sync with asm.fern.
    s = s.write("    .section .text\n");
    // __fern_alloc(%rdi = bytes) -> %rax = block. Size-classed freelist reuse
    // (class = bytes/8 < 65536) then bump; OOM traps with exit 137.
    s = s.write("__fern_alloc:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    addq $7, %rdi\n");
    s = s.write("    andq $-8, %rdi\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    pushq %rdx\n");
    s = s.write("    movq %rdi, %rcx\n");
    s = s.write("    shrq $3, %rcx\n");
    s = s.write("    cmpq $65536, %rcx\n");
    s = s.write("    jae .Lalloc_nofl\n");
    s = s.write("    leaq __fern_freelist(%rip), %rdx\n");
    s = s.write("    movq (%rdx,%rcx,8), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lalloc_nofl\n");
    s = s.write("    movq (%rax), %rdi\n");
    s = s.write("    movq %rdi, (%rdx,%rcx,8)\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_nofl:\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jne .Lalloc_inited\n");
    s = s.write("    movabs $__fern_heap, %rax\n");
    s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
    s = s.write(".Lalloc_inited:\n");
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
    s = s.write("    addq %rax, %rdi\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    pushq %rdx\n");
    s = s.write("    movabs $__fern_heap, %rcx\n");
    s = s.write("    movabs $4160749568, %rdx\n"); // 0xF8000000 (3.875 GiB) heap_size > imm32, so movabs not addq imm
    s = s.write("    addq %rdx, %rcx\n");           // %rcx = heap_base + heap_size (END)
    s = s.write("    cmpq %rcx, %rdi\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    ja .Lalloc_oom\n");
    s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_oom:\n");
    s = s.write("    movq $60, %rax\n");
    s = s.write("    movq $137, %rdi\n");
    s = s.write("    syscall\n");
    // __fern_arr_box(%rdi = cap element count) -> %rax = data ptr (base+16).
    // base = [cap, rc=1, len=cap, e0..]; element i at data+(i+1)*8.
    s = s.write("__fern_arr_box:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rdi\n");
    s = s.write("    addq $3, %rdi\n");
    s = s.write("    shlq $3, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq -8(%rbp), %rdi\n");
    s = s.write("    movq %rdi, (%rax)\n");
