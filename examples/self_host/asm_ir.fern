        s = s.write("    jge .Largs_done\n");
        s = s.write("    movq %r14, %rdi\n");
        s = s.write("    call __fern_arg_at\n");
        s = s.write("    movq %r14, %rcx\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    movq %rax, (%r13,%rcx,8)\n");
        s = s.write("    incq %r14\n");
        s = s.write("    jmp .Largs_loop\n");
        s = s.write(".Largs_done:\n");
        s = s.write("    movq %r13, %rax\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // __fern_eprint_str and __fern_putchar are Fern runtime functions (#2649):
    // asmcore.rt_src_eprint_str / rt_src_putchar, lowered through the IR pipeline
    // via emit_ir_runtime_fern_fn in the entry block. Both write their one scratch
