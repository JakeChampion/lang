// examples/self_host/asm_ir.fern — the x86-64 backend
// (docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md §3). emit_module_ir lowers each
// function AST -> stack IR -> asm and instruction-selects it: `__fn_<name>:`
// label, rbp frame + leave/ret, and a machine-stack operand discipline where
// every value is `pushq`-ed and consumers `popq`.
//
// This is the only x86-64 emitter — the AST one it grew up beside was deleted
// (#5972). emit_module_ir handles a module only when EVERY function is
// eligible (all_eligible); otherwise it REFUSES, and that refusal is a
// diagnostic naming the bail site under FERN_STRICT_IR=1, not a route to some
// other emitter. Comments below that describe a body as "transcribed verbatim
// from asm.fern" are recording where it came from, not a file you can go read.

import "./lexer";
import "./parser";
import "./asmcore";
import "./util";
import "./ir";
import "./irlower";

// ir_eligible reports whether a function is in the IR path's current subset:
// i32 functions with params, direct calls, and arrays (heap alloc / index /
// write / len + Perceus RC, including borrowed array params and array returns
// via move-on-return) — but no methods. Cross-function arrays are sound here
// because the IR path only fires when the WHOLE module is eligible
// (all_eligible), so every function — caller and callee — uses irlower's
// array layout; nothing crosses an IR/AST boundary.
pub function ir_eligible(fd: parser.FuncDecl, mod: parser.Module): boolean {
    // Methods (receiver functions) are lowered too — lower_func binds the
    // receiver as slot 0 and bails for non-scalar-struct receivers.
    //
    // The eligibility probe lowers fd with the SAME registries
    // emit_function_via_ir (and the wasm emit_function_ir) use, so "eligible"
    // means exactly "lowers". Threading the array registries matters for ok/bail,
    // not just op selection: `var a = mk()` (an array-returning call) is tracked
    // as an array only when `mk` is in arr_ret_fns, and a later `for x in a`
    // bails when its slot isn't array-typed; str_ret_fns likewise decides whether
    // `for b in greet()` (a string-returning-call iterable) types as a string and
    // lowers via the byte-foreach path (#2822). An empty registry here would
    // under-approximate and refuse modules that do in fact lower.
    var r: irlower.LowerResult = irlower.lower_func_for(fd, array_ret_fns(mod), mod.structs, mod.funcs);
    if (!r.ok) { return false; }
    return true;
}

// is_array_type reports whether a type string denotes an array (ends "[]").
function is_array_type(t: string): boolean {
    var n: i32 = t.len();
    if (n < 2) { return false; }
    return t[n - 2 : n] == "[]";
}

// array_ret_fns collects the names of functions whose return type is an array,
// so move-on-return / move-from-call fire (mirrors irlower.lower_module).
pub function array_ret_fns(mod: parser.Module): string[] {
    return array_ret_fns_of(mod.funcs);
}

// array_ret_fns_of is array_ret_fns over an explicit funcs array, so it can be
// derived over the WHOLE-PROGRAM function set (#3454) rather than one module's.
pub function array_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (is_array_type(funcs[i].ret_type)) { out = out.append(funcs[i].name); }
        // A lifted if-/match-expression `__lam_` whose branch is an array literal
        // carries a default i32 ret_type, so `var xs = if (c) { [..] } else { .. }`
        // was mis-treated as a scalar. Register it (a fresh owned-array move, like
        // any array-returning fn) so the binding tracks as an array (#3224).
        else if (funcs[i].name.len() >= 6 && funcs[i].name[0:6] == "__lam_" && irlower.lam_leaf_array_elem(funcs[i], funcs, 0) != "") { out = out.append(funcs[i].name); }
        i = i + 1;
    }
    return out;
}

// is_fern_helper reports whether a call_direct callee is one of the IR
// runtime helpers the emitter actually provides (emit_ir_runtime). These now
// use asm.fern's OWN stack-arg ABI + symbols (so the IR path is a drop-in for
// asm.fern's array RC) — see ir_helper_symbol for the name map. The whitelist
// is exact: any OTHER __fern_* / __rc_* call is NOT provided here, so
// calls_only_known refuses the module rather than emitting a call with no body.
pub function is_fern_helper(name: string): boolean {
    return name == "__fern_rc_inc"
        || name == "__fern_rc_dec"
        // #4873 grow-bracket share helpers: the backend-selectable rc touch
        // around a surviving ident arg at a may-grow param position. Register
        // backends alias them to the plain rc inc / rc-guarded arr dec (their
        // arrays carry an rc header at base-4, and __fern_arr_push's
        // uniqueness gate reads it); wasm_ir intercepts BOTH as no-ops — wasm
        // arrays have no rc header ([len@0, cap@4, elems@8]), so an rc touch
        // at base-4 would corrupt the neighbouring allocation.
        || name == "__fern_arr_share_inc"
        || name == "__fern_arr_share_dec"
        // string RC reclaim (#2649): frees a fresh, non-escaping heap string's
        // data buffer + 16-byte box. Default ir_helper_symbol maps it to
        // __fn___fern_str_free; body in emit_ir_runtime. Never user-callable —
        // only the irlower reclaim sites emit the call.
        || name == "__fern_str_free"
        // string[] ELEMENT reclaim (#4355): the element-walking sibling of the
        // shallow array dec — at rc==1 it __fern_str_free's every element box,
        // then frees the buffer; rc>1 decs; rc<0 (immortal) skips; rc==0 ticks
        // the underflow detector. Default ir_helper_symbol maps it to
        // __fn___fern_str_arr_free (body in emit_ir_runtime); wasm_helper_symbol
        // routes it to $__fern_arr_dec_ptr (the wasm AST path's pointer-element
        // walk — wasm strings are single inline rc-headered blocks, so the plain
        // per-element $__fern_arr_dec IS the wasm string free). Never
        // user-callable — only the irlower exit sweep emits it.
        || name == "__fern_str_arr_free"
        // arr-of-arr reclaim (#4355 slice 9): __fern_arrarr_free walks a fresh
        // arr-of-arr's elements (each a scalar-element inner buffer, one
        // rc-guarded __fern_arr_dec apiece) then frees the outer buffer;
        // __fern_strarrarr_free is the string[][] sibling (each element a
        // string[] released fully by __fern_str_arr_free). Only the irlower
        // exit sweep / rebind emits them.
        || name == "__fern_arrarr_free"
        || name == "__fern_strarrarr_free"
        || name == "__fern_optarrarr_free"
        // map reclaim (Perceus map-local slice): frees a fresh, non-escaping map
        // local's keys + values buffers AND the raw 16-byte mapbox. Default
        // ir_helper_symbol maps it to __fn___fern_map_free; wasm_helper_symbol
        // routes it to $__fern_map_release (which additionally deep-drops string
        // K/V). Never user-callable — only irlower's emit_map_buffers_free emits it.
        || name == "__fern_map_free"
        // #4353: string-VALUE-column deep-release variant — frees the vals
        // column via __fern_str_arr_free (each fresh value box + the buffer)
        // instead of the shallow arr_dec; keys still shallow. Register-only;
        // wasm_helper_symbol routes it to the already-deep $__fern_map_release.
        || name == "__fern_map_free_vs"
        // #4353: the KEY-column and both-column deep-release variants (siblings of
        // _vs; free the keys column, resp. both, via __fern_str_arr_free).
        || name == "__fern_map_free_ks"
        || name == "__fern_map_free_kvs"
        || name == "__fern_rc_is_unique"
        // FBIP reuse-degrade primitive (#4350): hands a dead donor's block back
        // when its cap matches, else freelists it and allocs fresh — so a reuse
        // site guarded by __fern_rc_is_unique degrades instead of corrupting.
        // Never user-callable — only irlower's reuse emitters emit it.
        || name == "__fern_alloc_reuse"
        || name == "__fern_rc_underflow_get"
        // i32.to_string()'s decimal-text helper (emit_ir_runtime provides the
        // stack-arg body under __fn___fern_i32_to_string).
        || name == "__fern_i32_to_string"
        // u32.to_string()'s UNSIGNED decimal-text helper (#2649). Emitted as a
        // Fern runtime fn under __fn___fern_u32_to_string; the ir_helper_symbol
        // default (__fn_ + name) targets it. Heap-dep.
        || name == "__fern_u32_to_string"
        // wide-int stringifiers (#5826): the i64/u64 siblings, backed by
        // asmcore.rt_src_i64_to_string / rt_src_u64_to_string via
        // emit_ir_runtime_fern_fn, exactly as the 32-bit pair is.
        || name == "__fern_i64_to_string"
        || name == "__fern_u64_to_string"
        // str_to_i32(s)'s decimal-parse helper (allocation-free stack-arg body
        // under __fn___fern_str_to_i32, also from emit_ir_runtime).
        || name == "__fern_str_to_i32"
        // chr(n)'s 1-char-string-box helper (stack-arg body under
        // __fn___fern_chr; allocates, so it needs the heap runtime).
        || name == "__fern_chr"
        // i32[] sum / product (#3457): `xs.sum()` / `xs.product()` lower to calls
        // to these Fern helpers. Without them here, calls_only_known treats the
        // target as an unknown USER function and bails the module to AST.
        || name == "__fern_arr_i32_sum"
        || name == "__fern_arr_i32_product"
        || name == "__fern_i32_pow"
        // n.gcd(m) / n.lcm(m) (#2649) — pure-scalar Fern helpers, like pow.
        // lcm's own body calls gcd, so both must be recognised here: without
        // the gcd entry, calls_only_known reads lcm's inner call as an unknown
        // USER function and bails the module to AST.
        || name == "__fern_i32_gcd"
        || name == "__fern_i32_lcm"
        || name == "__fern_arr_i32_index_of"
        // The string[] index_of / contains scan (#3457) — content equality via
        // str_eq, so it cannot share the i32 helper's pointer compare. Unlike
        // i32_lcm → i32_gcd this needs no second entry: its `xs[i] == target`
        // lowers to op_str_eq (kind 99, which emits the call itself), not to a
        // call_direct calls_only_known would have to recognise. The str_eq
        // runtime NEED is still required, and mark_arr_str_index_of declares it.
        || name == "__fern_arr_str_index_of"
        // xs.min() / xs.max() (#3457): the Option-returning extremum helpers —
        // the guard and the box live in their Fern bodies, so the call site is
        // an ordinary call_direct like sum/product.
        || name == "__fern_arr_i32_min_opt"
        || name == "__fern_arr_i32_max_opt"
        // xs.join(sep)'s array-of-strings concatenator (#5328): a real Fern
        // runtime function (asmcore.rt_src_arr_str_join) built with `+`, so it
        // needs the heap + str_concat runtime. Body under __fn___fern_arr_str_join,
        // emitted in emit_ir_runtime (x86) / asm_arm64.emit_runtime (arm64). Only
        // irlower's lower_arr_str_join emits the call. wasm emits a matching
        // $__fern_arr_str_join shim over the hand-written $__fern_str_join WAT
        // (wasm.arr_str_join_helper).
        || name == "__fern_arr_str_join"
        // snapshot-param consume-rebind reclaim (#3456 slice 2): frees the
        // superseded old box (rc-guarded shallow free) unless it is `new` or the
        // caller's snapshot; passes `new` back through. Body in emit_ir_runtime.
        || name == "__fern_snapshot_dec"
        // per-type field-level move tracking (#3457): __field_reclaim_<T> frees
        // the REPLACED array-field buffers of the superseded old box (cow + snap
        // guarded) before freeing the box. All three backends emit a real per-type
        // body (x86 emit_ir_field_reclaims, arm64 emit_arm64_field_reclaim_one, wasm
        // emit_wasm_field_reclaim_body).
        || is_field_reclaim_name(name)
        // per-type deep struct-drop (#3457): __struct_drop_<T> deep-drops the
        // rc-array FIELDS of a reclaimable struct box at scope exit (a scalar
        // field's buffer; a struct/enum-array field's elements + buffer; an acyclic
        // nested-struct field, recursively). All three backends emit a real per-type
        // body (x86 emit_ir_struct_drops, arm64 emit_arm64_struct_drop_one, wasm
        // emit_wasm_struct_drop_body). The per-type helper replaces the former inline
        // field-drop so the broad struct reclaim fits #3452.
        || is_struct_drop_name(name);
}

// is_struct_drop_name reports whether a call_direct callee is a per-type
// __struct_drop_<T> helper (the suffix is the struct type name).
pub function is_struct_drop_name(name: string): boolean {
    return name.len() > 14 && name[0:14] == "__struct_drop_";
}

// struct_drop_type returns the struct type T from a "__struct_drop_<T>" name.
pub function struct_drop_type(name: string): string {
    return name[14 : name.len()] + "";
}

// is_field_reclaim_name reports whether a call_direct callee is a per-type
// __field_reclaim_<T> helper (the suffix is the struct type name).
pub function is_field_reclaim_name(name: string): boolean {
    return name.len() > 16 && name[0:16] == "__field_reclaim_";
}

// field_reclaim_type returns the struct type T from a "__field_reclaim_<T>" name.
pub function field_reclaim_type(name: string): string {
    return name[16 : name.len()] + "";
}

// is_c_call reports whether a call_direct callee is an FFI shim of the
// `__c_call<n>` family — `__c_call0`..`__c_call4` with an optional `_f32` /
// `_f64` return-type suffix (#4375). The family calls a C-ABI (System V /
// AAPCS64) function pointer with up to four integer/pointer args; the shim
// bodies are emitted by emit_ir_runtime (x86) / emit_arm64_ir_runtime (arm64),
// so a module using them stays IR-eligible instead of bailing to the AST path
// (which never had a body → undefined `__fn___c_call0` link failure). Wasm has
// no C-ABI, so wasm_ir_deferrals_ok subtracts the family (native parity: native
// wasm has no __c_call either).
pub function is_c_call(name: string): boolean {
    if (name.len() < 9) { return false; }
    if (name[0:8] != "__c_call") { return false; }
    var d: str = name[8:9];
    if (d != "0" && d != "1" && d != "2" && d != "3" && d != "4") { return false; }
    var rest: str = name[9 : name.len()];
    return rest == "" || rest == "_f32" || rest == "_f64";
}

// c_call_arity returns the integer-arg count n (0..4) of a `__c_call<n>...`
// callee name (the digit at index 8). The shim body depends only on n, not on
// the return-type suffix.
pub function c_call_arity(name: string): i32 {
    var d: str = name[8:9];
    if (d == "1") { return 1; }
    if (d == "2") { return 2; }
    if (d == "3") { return 3; }
    if (d == "4") { return 4; }
    return 0;
}

// ir_helper_symbol maps an IR runtime-helper name to the asm.fern symbol the
// IR path calls (stack-arg ABI). The exit-sweep / reassign release
// (__fern_rc_dec) maps to __fn___fern_arr_dec — the array release that frees
// at rc==1 via the size-class freelist — so the IR path reclaims exactly as
// asm.fern's AST path does.
pub function ir_helper_symbol(name: string): string {
    if (name == "__fern_rc_inc") { return "__fn___fern_rc_inc"; }
    if (name == "__fern_rc_dec") { return "__fn___fern_arr_dec"; }
    // #4873 grow-bracket share helpers: same runtime symbols as the plain rc
    // pair on the register backends (zero new runtime); the distinct NAMES
    // exist so wasm_ir can intercept them as no-ops (wasm arrays carry no rc
    // header).
    if (name == "__fern_arr_share_inc") { return "__fn___fern_rc_inc"; }
    if (name == "__fern_arr_share_dec") { return "__fn___fern_arr_dec"; }
    if (name == "__fern_rc_is_unique") { return "__fn___fern_rc_is_unique"; }
    if (name == "__fern_rc_underflow_get") { return "__fn___fern_rc_underflow_count"; }
    // __field_reclaim_<T> -> __fn___field_reclaim_<sanitized T> (#3457). Sanitised
    // so a monomorphised / bracketed type name yields a valid asm label, matching
    // the body label emit_ir_field_reclaims writes.
    if (is_field_reclaim_name(name)) { return "__fn___field_reclaim_" + asmcore.sanitize_label(field_reclaim_type(name)); }
    // __struct_drop_<T> -> __fn___struct_drop_<sanitized T> (#3457), matching the
    // body label emit_ir_struct_drops writes.
    if (is_struct_drop_name(name)) { return "__fn___struct_drop_" + asmcore.sanitize_label(struct_drop_type(name)); }
    return "__fn_" + name;
}

// (The hand-written emit_ir_str_search was removed in #2649: the
// __fern_str_starts_with / _ends_with / _index_of predicates are now Fern
// runtime functions, emitted via emit_ir_runtime_fern_fn(asmcore.rt_src_str_search)
// in emit_module_ir_unit's entry block.)

// __fern_str_to_upper / _to_lower were hand-written here through #2649; they are
// now Fern runtime functions (asmcore.rt_src_str_to_upper/_lower) lowered through
// the IR pipeline via emit_ir_runtime_fern_fn in the entry block — each copies `s`
// case-flipping ASCII letters via the raw-memory intrinsics. Heap-dependent;
// gated on the str_case need.

// __fern_str_repeat was hand-written here through #2649; it is now a Fern
// runtime function (asmcore.rt_src_str_repeat) lowered through the IR pipeline
// via emit_ir_runtime_fern_fn in emit_module_ir_unit's entry block — n copies of
// `s` in a fresh buffer + box via the raw-memory intrinsics. Heap-dependent,
// gated on the str_repeat need. The op_str_repeat handler now calls the
// stack-arg __fn___fern_str_repeat symbol.

// __fern_str_trim was hand-written here through #2649; it is now a Fern runtime
// function (asmcore.rt_src_str_trim) lowered through the IR pipeline via
// emit_ir_runtime_fern_fn in emit_module_ir_unit's entry block — a zero-copy
// slice (s[start:end]) skipping leading/trailing ASCII whitespace. Heap-dependent
// (the slice box allocates), gated on the str_trim need.

// __fern_str_reverse was hand-written here through #2649; it is now a Fern
// runtime function (asmcore.rt_src_str_reverse) lowered through the IR pipeline
// via emit_ir_runtime_fern_fn in emit_module_ir_unit's entry block — a fresh box
// with `s`'s bytes reversed via the raw-memory intrinsics. Heap-dependent, gated
// on the str_reverse need. The op_str_reverse handler now calls the stack-arg
// __fn___fern_str_reverse symbol.

// __fern_str_replace was hand-written here through #2649; it is now a Fern
// runtime function (asmcore.rt_src_str_replace) lowered through the IR pipeline
// via emit_ir_runtime_fern_fn in emit_module_ir_unit's entry block — two-pass
// count + build via the raw-memory intrinsics. Heap-dependent, gated on the
// str_replace need. The op_str_replace handler now calls the stack-arg
// __fn___fern_str_replace symbol.

// __fern_str_chars was hand-written here through #2649; it is now a Fern runtime
// function (asmcore.rt_src_str_chars) lowered through the IR pipeline via
// emit_ir_runtime_fern_fn in emit_module_ir_unit's entry block — it appends each
// 1-char slice s[i:i+1] (arr_push). Heap + arr_push dependent; gated on the
// str_chars need.

// __fern_str_lines was hand-written here through #2649; it is now a Fern runtime
// function (asmcore.rt_src_str_lines) lowered through the IR pipeline via
// emit_ir_runtime_fern_fn in emit_module_ir_unit's entry block — it splits on
// '\n' (str_split) and drops the trailing empty entry with an array slice
// (arr_slice). Heap + str_split + arr_slice dependent; gated on the str_lines need.

// emit_ir_random_i32 appends the __fern_random_i32() helper. Kept OUT of
// emit_ir_runtime (which is heap-gated) because random_i32 allocates nothing —
// a program that only calls random_i32 uses no heap, so its helper must still
// emit. getrandom(buf, 4, 0) into a 16-byte stack slot, reload as i32. (No
// asm.fern counterpart — legacy x86-64 lacked random_i32; new for the IR path,
// mirroring the Go backend.)
function emit_ir_random_i32(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_random_i32:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");        // 4-byte landing buffer (aligned)
    s = s.write("    leaq -16(%rbp), %rdi\n");  // getrandom(buf, 4, 0)
    s = s.write("    movq $4, %rsi\n");
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $318, %rax\n");
    s = s.write("    syscall\n");
    s = s.write("    movl -16(%rbp), %eax\n");  // 4 random bytes -> i32 (zero-extends)
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// The clock helpers (__fern_monotonic_ns / _now_unix_ms / _now_ns) are now Fern
// runtime functions (#2649): asmcore.rt_src_monotonic_ns / _now_unix_ms / _now_ns,
// lowered through the IR pipeline via emit_ir_runtime_fern_fn in the entry block
// (need-gated). They read clock_gettime (syscall 228) into the fixed static
// __fern_scratch buffer via the __syscall3 / __raw_scratch / __load_i64 floor,
// then do i64 math — no heap, no per-call leak. arm64/AST keep their hand-asm.

// emit_ir_poll appends __fern_poll(%rdi = i32[] box ptr, %rsi = timeout_ms) ->
// i32 index of the first POLLIN-ready fd, or -1. Mirrors the native poll(2)
// helper but reads the SELF-HOST array layout: len at [ptr+0] (8-byte), element
// i (the fd, low 32 bits) at [ptr + (i+1)*8]. Allocates an nfds*8 pollfd[]
// scratch via __fern_alloc; an empty set returns -1 without a syscall.
function emit_ir_poll(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_poll:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");                 // nfds
    s = s.write("    pushq %r12\n");                 // fds box ptr
    s = s.write("    pushq %r13\n");                 // pollfd buffer
    s = s.write("    pushq %r14\n");                 // timeout_ms
    s = s.write("    pushq %r15\n");                 // loop index
    s = s.write("    movq %rdi, %r12\n");            // fds box ptr
    s = s.write("    movq %rsi, %r14\n");            // timeout_ms
    s = s.write("    movq (%r12), %rbx\n");          // nfds = len at [ptr+0]
    s = s.write("    testq %rbx, %rbx\n");
    s = s.write("    jle .Lirpoll_none\n");
    s = s.write("    movq %rbx, %rdi\n");            // buf = alloc(nfds*8)
    s = s.write("    shlq $3, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq %rax, %r13\n");
    s = s.write("    xorq %r15, %r15\n");            // fill pollfd[i]
    s = s.write(".Lirpoll_fill:\n");
    s = s.write("    cmpq %rbx, %r15\n");
    s = s.write("    jge .Lirpoll_filled\n");
    s = s.write("    leaq 1(%r15), %rcx\n");          // i+1 (skip len slot)
    s = s.write("    movl (%r12,%rcx,8), %eax\n");    // fd = low32 of element i
    s = s.write("    movl %eax, (%r13,%r15,8)\n");    // pollfd.fd
    s = s.write("    movw $1, 4(%r13,%r15,8)\n");     // .events = POLLIN
    s = s.write("    movw $0, 6(%r13,%r15,8)\n");     // .revents
    s = s.write("    incq %r15\n");
    s = s.write("    jmp .Lirpoll_fill\n");
    s = s.write(".Lirpoll_filled:\n");
    s = s.write("    movq %r13, %rdi\n");            // poll(buf, nfds, timeout)
    s = s.write("    movl %ebx, %esi\n");
    s = s.write("    movl %r14d, %edx\n");
    s = s.write("    movq $7, %rax\n");              // SYS_poll
    s = s.write("    syscall\n");
    s = s.write("    xorq %r15, %r15\n");            // scan revents
    s = s.write(".Lirpoll_scan:\n");
    s = s.write("    cmpq %rbx, %r15\n");
    s = s.write("    jge .Lirpoll_none\n");
    s = s.write("    movzwl 6(%r13,%r15,8), %eax\n"); // revents
    s = s.write("    testl $1, %eax\n");              // POLLIN
    s = s.write("    jnz .Lirpoll_found\n");
    s = s.write("    incq %r15\n");
    s = s.write("    jmp .Lirpoll_scan\n");
    s = s.write(".Lirpoll_found:\n");
    s = s.write("    movq %r15, %rax\n");
    s = s.write("    jmp .Lirpoll_ret\n");
    s = s.write(".Lirpoll_none:\n");
    s = s.write("    movq $-1, %rax\n");
    s = s.write(".Lirpoll_ret:\n");
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_timer_fd appends __fern_timer_fd(%rdi = ms) -> a CLOCK_MONOTONIC
// one-shot timerfd fd, readable after `ms` ms (or -errno), in %rax. The mirror
// of the native helper: timerfd_create(CLOCK_MONOTONIC, 0) [#283], then
// timerfd_settime(fd, 0, &{it_interval=0, it_value={sec, nsec}}, NULL) [#286].
// Allocation-free (32-byte stack itimerspec), gated on the timer_fd need.
function emit_ir_timer_fd(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_timer_fd:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");                 // ms
    s = s.write("    pushq %r12\n");                 // fd
    s = s.write("    subq $32, %rsp\n");             // struct itimerspec
    s = s.write("    movq %rdi, %rbx\n");            // ms
    s = s.write("    movq $1, %rdi\n");              // CLOCK_MONOTONIC
    s = s.write("    xorq %rsi, %rsi\n");
    s = s.write("    movq $283, %rax\n");            // timerfd_create
    s = s.write("    syscall\n");
    s = s.write("    movq %rax, %r12\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    js .Lir_tfd_ret\n");            // create failed -> -errno
    s = s.write("    xorq %rax, %rax\n");            // it_interval = {0,0}
    s = s.write("    movq %rax, (%rsp)\n");
    s = s.write("    movq %rax, 8(%rsp)\n");
    s = s.write("    movq %rbx, %rax\n");            // it_value = {ms/1000, (ms%1000)*1e6}
    s = s.write("    xorq %rdx, %rdx\n");
    s = s.write("    movq $1000, %rcx\n");
    s = s.write("    divq %rcx\n");                  // rax=sec, rdx=rem ms
    s = s.write("    movq %rax, 16(%rsp)\n");
    s = s.write("    movq $1000000, %rax\n");
    s = s.write("    imulq %rdx, %rax\n");           // nsec
    s = s.write("    movq %rax, 24(%rsp)\n");
    s = s.write("    movl %r12d, %edi\n");           // timerfd_settime(fd, 0, &its, NULL)
    s = s.write("    xorq %rsi, %rsi\n");
    s = s.write("    movq %rsp, %rdx\n");
    s = s.write("    xorq %r10, %r10\n");
    s = s.write("    movq $286, %rax\n");            // timerfd_settime
    s = s.write("    syscall\n");
    s = s.write("    movq %r12, %rax\n");            // return fd
    s = s.write(".Lir_tfd_ret:\n");
    s = s.write("    addq $32, %rsp\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_wasm_timer_pollable appends __fern_wasm_timer_pollable(ns) -> -1: on
// native there's no pollable (a deadline rides poll(2)'s timeout arg), so it
// returns -1 (an fd poll(2) ignores). Portability shim for with_deadline.
function emit_ir_wasm_timer_pollable(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_wasm_timer_pollable:\n");
    s = s.write("    movq $-1, %rax\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_wasm_pollable_drop appends __fern_wasm_pollable_drop(p) -> 0: on
// native a pollable is just an fd (closed via tcp_close), so there's nothing to
// drop. Portability shim so std/async's fetch_future drops the wasm pollable
// portably.
function emit_ir_wasm_pollable_drop(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_wasm_pollable_drop:\n");
    s = s.write("    xorq %rax, %rax\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_wasm_block appends __fern_wasm_block(p) -> 0: on native there's no
// pollable to wait on (a deadline rides poll(2)'s timeout arg — wasm_timer_pollable
// returned -1), so blocking is a 0 no-op. On wasm this is a real
// wasi:io/poll.[method]pollable.block. Portability shim for the reactor's
// with_deadline.
function emit_ir_wasm_block(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_wasm_block:\n");
    s = s.write("    xorq %rax, %rax\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_wasm_poll appends __fern_wasm_poll(pollables) -> -1: on native there
// are no real pollables (readiness rides poll(2) directly), so it returns -1
// (nothing ready), ignoring its array arg. On wasm this is the real
// wasi:io/poll.poll(list<pollable>) multiplexer.
function emit_ir_wasm_poll(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_wasm_poll:\n");
    s = s.write("    movq $-1, %rax\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_tcp_connect appends __fern_tcp_connect(%rdi = host_be, %rsi = port) ->
// the connected fd (or -errno) in %rax. Mirrors the native helper: socket(AF_INET
// =2, SOCK_STREAM=1, 0) [#41], build a 16-byte sockaddr_in {family=2,
// port=htons(port), addr=host_be (already network order), zero}, connect(fd, sa,
// 16) [#42]. host_be is the IPv4 packed in network byte order. ABI-agnostic
// (no string box), gated on the tcp_connect need.
function emit_ir_tcp_connect(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_tcp_connect:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");                 // fd
    s = s.write("    pushq %r12\n");                 // port
    s = s.write("    pushq %r13\n");                 // host_be
    s = s.write("    subq $16, %rsp\n");             // sockaddr_in
    s = s.write("    movl %edi, %r13d\n");           // host_be
    s = s.write("    movl %esi, %r12d\n");           // port
    s = s.write("    movq $2, %rdi\n");              // AF_INET
    s = s.write("    movq $1, %rsi\n");              // SOCK_STREAM
    s = s.write("    xorq %rdx, %rdx\n");
    s = s.write("    movq $41, %rax\n");             // socket
    s = s.write("    syscall\n");
    s = s.write("    testl %eax, %eax\n");
    s = s.write("    js .Lir_tcon_done\n");          // socket failed -> -errno
    s = s.write("    movl %eax, %ebx\n");            // fd
    s = s.write("    movw $2, (%rsp)\n");            // sin_family = AF_INET
    s = s.write("    movl %r12d, %eax\n");
    s = s.write("    xchgb %al, %ah\n");             // htons(port)
    s = s.write("    movw %ax, 2(%rsp)\n");          // sin_port
    s = s.write("    movl %r13d, 4(%rsp)\n");        // sin_addr (network order)
    s = s.write("    movq $0, 8(%rsp)\n");           // sin_zero
    s = s.write("    movl %ebx, %edi\n");            // connect(fd, sa, 16)
    s = s.write("    movq %rsp, %rsi\n");
    s = s.write("    movq $16, %rdx\n");
    s = s.write("    movq $42, %rax\n");             // connect
    s = s.write("    syscall\n");
    s = s.write("    testl %eax, %eax\n");
    s = s.write("    js .Lir_tcon_done\n");          // connect failed -> -errno
    s = s.write("    movl %ebx, %eax\n");            // return fd
    s = s.write(".Lir_tcon_done:\n");
    s = s.write("    addq $16, %rsp\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_tcp_pollable appends __fern_tcp_pollable(%rdi = fd) -> fd: on native a
// socket's readiness token IS its fd (poll(2) takes fds directly), so identity.
function emit_ir_tcp_pollable(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_tcp_pollable:\n");
    s = s.write("    movl %edi, %eax\n");            // return the fd unchanged
    s = s.write("    ret\n");
    return s;
}

// emit_ir_tcp_close appends __fern_tcp_close(%rdi = fd) -> 0 / -errno: close(2).
function emit_ir_tcp_close(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_tcp_close:\n");
    s = s.write("    movq $3, %rax\n");              // close (fd in %rdi)
    s = s.write("    syscall\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_tcp_recv appends __fern_tcp_recv(%rdi = fd, %rsi = max) -> a self-host
// string box {data@0, len@8} of up to `max` bytes read. Mirrors the self-host
// arm64 body (the SELF-HOST string ABI, NOT native's len-prefix): alloc max,
// read() into it, clamp -errno/EOF to len 0, then a 16-byte box [data, len].
// Allocates, so gated on heap + tcp_recv.
function emit_ir_tcp_recv(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_tcp_recv:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");                 // fd
    s = s.write("    pushq %r12\n");                 // max
    s = s.write("    pushq %r13\n");                 // data buf
    s = s.write("    pushq %r14\n");                 // len
    s = s.write("    movl %edi, %ebx\n");            // fd
    s = s.write("    movq %rsi, %r12\n");            // max
    s = s.write("    movq %r12, %rdi\n");            // buf = alloc(max)
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq %rax, %r13\n");
    s = s.write("    movl %ebx, %edi\n");            // read(fd, buf, max)
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    movq %r12, %rdx\n");
    s = s.write("    movq $0, %rax\n");              // read
    s = s.write("    syscall\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jns .Lir_trecv_ok\n");
    s = s.write("    xorq %rax, %rax\n");            // -errno/EOF -> len 0
    s = s.write(".Lir_trecv_ok:\n");
    s = s.write("    movq %rax, %r14\n");            // len
    s = s.write("    movq $16, %rdi\n");             // box = alloc(16)
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq %r13, (%rax)\n");          // data@0
    s = s.write("    movq %r14, 8(%rax)\n");         // len@8
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_tcp_send appends __fern_tcp_send(%rdi = fd, %rsi = string box) -> bytes
// written / -errno. Reads the self-host string box [data@0, len@8] and write()s
// those bytes. Leaf (no frame, no alloc).
function emit_ir_tcp_send(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_tcp_send:\n");
    s = s.write("    movq (%rsi), %r9\n");           // data = box[0]
    s = s.write("    movq 8(%rsi), %rdx\n");         // len = box[8]
    s = s.write("    movq %r9, %rsi\n");             // %rsi = data ptr
    s = s.write("    movq $1, %rax\n");              // write (fd in %rdi)
    s = s.write("    syscall\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_tcp_listen appends __fern_tcp_listen(%rdi = port) -> the listener fd
// (or -errno) in %rax. The server-half sibling of __fern_tcp_connect (#4371):
// socket(AF_INET=2, SOCK_STREAM=1, 0) [#41], build a 16-byte sockaddr_in
// {family=2, port=htons(port), addr=INADDR_ANY=0, zero}, bind(fd, sa, 16) [#49],
// listen(fd, 128) [#50]. On any failing syscall %rax already holds -errno and we
// fall through to the return. ABI-agnostic (no string box).
function emit_ir_tcp_listen(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_tcp_listen:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");                 // listener fd
    s = s.write("    pushq %r12\n");                 // port
    s = s.write("    subq $16, %rsp\n");             // sockaddr_in (keeps %rsp 16-aligned)
    s = s.write("    movl %edi, %r12d\n");           // port
    s = s.write("    movq $2, %rdi\n");              // AF_INET
    s = s.write("    movq $1, %rsi\n");              // SOCK_STREAM
    s = s.write("    xorq %rdx, %rdx\n");
    s = s.write("    movq $41, %rax\n");             // socket
    s = s.write("    syscall\n");
    s = s.write("    testl %eax, %eax\n");
    s = s.write("    js .Lir_tlst_done\n");          // socket failed -> -errno
    s = s.write("    movl %eax, %ebx\n");            // listener fd
    s = s.write("    movw $2, (%rsp)\n");            // sin_family = AF_INET
    s = s.write("    movl %r12d, %eax\n");
    s = s.write("    xchgb %al, %ah\n");             // htons(port)
    s = s.write("    movw %ax, 2(%rsp)\n");          // sin_port
    s = s.write("    movl $0, 4(%rsp)\n");           // sin_addr = INADDR_ANY
    s = s.write("    movq $0, 8(%rsp)\n");           // sin_zero
    s = s.write("    movl %ebx, %edi\n");            // bind(fd, sa, 16)
    s = s.write("    movq %rsp, %rsi\n");
    s = s.write("    movq $16, %rdx\n");
    s = s.write("    movq $49, %rax\n");             // bind
    s = s.write("    syscall\n");
    s = s.write("    testl %eax, %eax\n");
    s = s.write("    js .Lir_tlst_done\n");          // bind failed -> -errno
    s = s.write("    movl %ebx, %edi\n");            // listen(fd, 128)
    s = s.write("    movq $128, %rsi\n");
    s = s.write("    movq $50, %rax\n");             // listen
    s = s.write("    syscall\n");
    s = s.write("    testl %eax, %eax\n");
    s = s.write("    js .Lir_tlst_done\n");          // listen failed -> -errno
    s = s.write("    movl %ebx, %eax\n");            // return listener fd
    s = s.write(".Lir_tlst_done:\n");
    s = s.write("    addq $16, %rsp\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_tcp_accept appends __fern_tcp_accept(%rdi = listener fd) -> the accepted
// connection fd (or -errno) in %rax. accept(2) [#43] with NULL/NULL addr/addrlen;
// the listener fd is already in %rdi. Leaf (no frame, no alloc).
function emit_ir_tcp_accept(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_tcp_accept:\n");
    s = s.write("    xorq %rsi, %rsi\n");            // addr = NULL
    s = s.write("    xorq %rdx, %rdx\n");            // addrlen = NULL
    s = s.write("    movq $43, %rax\n");             // accept
    s = s.write("    syscall\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_open_fd appends __fern_open_fd(%rdi = path string box, %rsi = openat
// flags, %rdx = mode) -> the opened fd (or -errno) in %rax. The file half of the
// streaming Reader/Writer surface (#4372): NUL-terminate the path (copy the box's
// [data@0, len@8] bytes into a len+1 __fern_alloc buffer, append a 0), then
// openat(AT_FDCWD=-100, pathz, flags, mode)=257 and return the raw fd. Mirrors
// __fern_write_file's path prologue but returns the fd instead of write+close.
// Gated on the open_file need; calls __fern_alloc.
function emit_ir_open_fd(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_open_fd:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");                 // path data ptr
    s = s.write("    pushq %r12\n");                 // path len
    s = s.write("    pushq %r13\n");                 // flags
    s = s.write("    pushq %r14\n");                 // mode
    s = s.write("    pushq %r15\n");                 // NUL-term buffer ptr
    s = s.write("    subq $8, %rsp\n");              // keep %rsp 16-aligned for the call
    s = s.write("    movq %rsi, %r13\n");            // flags
    s = s.write("    movq %rdx, %r14\n");            // mode
    s = s.write("    movq (%rdi), %rbx\n");          // path data
    s = s.write("    movq 8(%rdi), %r12\n");         // path len
    s = s.write("    leaq 1(%r12), %rdi\n");         // len + 1
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq %rax, %r15\n");            // buffer
    s = s.write("    movq $0, %rcx\n");
    s = s.write(".Lof_copy:\n");
    s = s.write("    cmpq %r12, %rcx\n");
    s = s.write("    jge .Lof_copydone\n");
    s = s.write("    movb (%rbx,%rcx,1), %dl\n");
    s = s.write("    movb %dl, (%r15,%rcx,1)\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lof_copy\n");
    s = s.write(".Lof_copydone:\n");
    s = s.write("    movb $0, (%r15,%r12,1)\n");     // NUL terminator
    s = s.write("    movq $-100, %rdi\n");           // AT_FDCWD
    s = s.write("    movq %r15, %rsi\n");            // pathz
    s = s.write("    movq %r13, %rdx\n");            // flags
    s = s.write("    movq %r14, %r10\n");            // mode
    s = s.write("    movq $257, %rax\n");            // openat
    s = s.write("    syscall\n");                    // %rax = fd / -errno
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_sleep_ms appends the __fern_sleep_ms(%rdi = ms) helper, transcribed
// verbatim from asm.fern's emit_runtime: split ms into a timespec
// {sec=ms/1000, nsec=(ms%1000)*1e6} on the stack and nanosleep (syscall 35);
// ms <= 0 returns immediately. Allocation-free, so emitted independently of the
// heap runtime (gated on the sleep_ms need), like the clock helpers.
function emit_ir_sleep_ms(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_sleep_ms:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $32, %rsp\n");
    s = s.write("    cmpq $0, %rdi\n");
    s = s.write("    jle .Lir_sm_done\n");
    s = s.write("    movq %rdi, %rax\n");
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $1000, %rcx\n");
    s = s.write("    divq %rcx\n");
    s = s.write("    movq %rax, (%rsp)\n");
    s = s.write("    movq $1000000, %rax\n");
    s = s.write("    imulq %rdx, %rax\n");
    s = s.write("    movq %rax, 8(%rsp)\n");
    s = s.write("    movq %rsp, %rdi\n");
    s = s.write("    movq $0, %rsi\n");
    s = s.write("    movq $35, %rax\n");
    s = s.write("    syscall\n");
    s = s.write(".Lir_sm_done:\n");
    s = s.write("    addq $32, %rsp\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_proc_fork appends __fern_proc_fork() -> i32 — a bare fork(2)
// (syscall 57, no args) whose return shape IS the builtin's contract: 0 in the
// child, the child's pid in the parent, -errno on failure. Transcribed from the
// native x86-64 backend's emitProcForkRuntime. Allocation-free, so emitted
// independently of the heap runtime (gated on the proc_fork need), like
// __fern_random_i32 (#5686).
pub function emit_ir_proc_fork(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_proc_fork:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    movq $57, %rax\n");
    s = s.write("    syscall\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_proc_exec appends __fern_proc_exec(%rdi = path box, %rsi = args box)
// -> i32 — execve(2) (syscall 59). Only returns on FAILURE, with -errno, since
// on success the process image is gone; that IS the builtin's contract, the same
// way proc_fork's kernel return is.
//
// argv is [path, args[0], ..., NULL]: the callee's argv[0] is the program path,
// so callers pass only real arguments. envp comes from the __fern_envp global
// (hence the `env` need), so the child inherits the environment.
//
// Fern strings are (data, len) boxes and not NUL-terminated, so the path and
// every argument are copied into fresh NUL-terminated buffers via __fern_alloc
// (hence the `heap` need). Those are never freed: on success the address space
// is replaced, on failure the caller is about to report an error. The argv-build
// loops are the same shape as __fern_subprocess's, minus the pipes and fork.
pub function emit_ir_proc_exec(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_proc_exec:\n    pushq %rbp\n    movq %rsp, %rbp\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n    subq $32, %rsp\n    movq %rdi, %r12\n    movq %rsi, %r13\n    movq 8(%r12), %r15\n    leaq 1(%r15), %rdi\n    call __fern_alloc\n    movq %rax, -64(%rbp)\n    movq (%r12), %rcx\n    movq $0, %r8\n.Lpx_ccmd:\n    cmpq %r15, %r8\n    jge .Lpx_ccmd_d\n    movb (%rcx, %r8, 1), %al\n    movq -64(%rbp), %r9\n    movb %al, (%r9, %r8, 1)\n    incq %r8\n    jmp .Lpx_ccmd\n.Lpx_ccmd_d:\n    movq -64(%rbp), %r9\n    movb $0, (%r9, %r15, 1)\n    movq (%r13), %r15\n    leaq 2(%r15), %rdi\n    shlq $3, %rdi\n    call __fern_alloc\n    movq %rax, -56(%rbp)\n    movq -64(%rbp), %rcx\n    movq -56(%rbp), %r9\n    movq %rcx, (%r9)\n    movq $0, %rbx\n.Lpx_arg:\n    cmpq %r15, %rbx\n    jge .Lpx_arg_d\n    leaq 1(%rbx), %rcx\n    movq (%r13, %rcx, 8), %r10\n    movq 8(%r10), %rsi\n    leaq 1(%rsi), %rdi\n    pushq %r10\n    pushq %rsi\n    call __fern_alloc\n    popq %rsi\n    popq %r10\n    movq (%r10), %rcx\n    movq $0, %r8\n.Lpx_acopy:\n    cmpq %rsi, %r8\n    jge .Lpx_acopy_d\n    movb (%rcx, %r8, 1), %dl\n    movb %dl, (%rax, %r8, 1)\n    incq %r8\n    jmp .Lpx_acopy\n.Lpx_acopy_d:\n    movb $0, (%rax, %rsi, 1)\n    movq -56(%rbp), %r9\n    leaq 1(%rbx), %rcx\n    movq %rax, (%r9, %rcx, 8)\n    incq %rbx\n    jmp .Lpx_arg\n.Lpx_arg_d:\n    movq -56(%rbp), %r9\n    leaq 1(%r15), %rcx\n    movq $0, (%r9, %rcx, 8)\n    movq -64(%rbp), %rdi\n    movq -56(%rbp), %rsi\n    movq __fern_envp(%rip), %rdx\n    movq $59, %rax\n    syscall\n    addq $32, %rsp\n    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n    popq %rbp\n    ret\n");
    return s;
}

// emit_ir_proc_waitpid appends __fern_proc_waitpid(%rdi = pid) -> i32: a
// blocking wait4(2) (syscall 61 — pid, &status, options=0, rusage=NULL, status
// in a stack slot) plus the status-word decode both native backends use,
//
//     WIFEXITED ((status & 0x7f) == 0) -> (status >> 8) & 0xff
//     else (signal death)              -> 128 + (status & 0x7f)
//
// the shell convention, so a bounds-trapping worker surfaces as 134. A negative
// syscall return (-errno, e.g. -ECHILD) passes through untouched. Transcribed
// from the native x86-64 emitProcWaitpidRuntime; allocation-free (#5686).
pub function emit_ir_proc_waitpid(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_proc_waitpid:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // status slot (16 keeps rsp aligned)
    s = s.write("    movslq %edi, %rdi\n");       // pid
    s = s.write("    movq %rsp, %rsi\n");         // &status
    s = s.write("    xorl %edx, %edx\n");         // options = 0
    s = s.write("    xorl %r10d, %r10d\n");       // rusage = NULL
    s = s.write("    movq $61, %rax\n");
    s = s.write("    syscall\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    js .Lir_pw_done\n");         // -errno -> return as-is
    s = s.write("    movl (%rsp), %ecx\n");       // status word
    s = s.write("    movl %ecx, %eax\n");
    s = s.write("    andl $127, %eax\n");
    s = s.write("    jnz .Lir_pw_sig\n");
    s = s.write("    movl %ecx, %eax\n");
    s = s.write("    shrl $8, %eax\n");
    s = s.write("    andl $255, %eax\n");
    s = s.write("    jmp .Lir_pw_done\n");
    s = s.write(".Lir_pw_sig:\n");
    s = s.write("    addl $128, %eax\n");
    s = s.write(".Lir_pw_done:\n");
    s = s.write("    movq %rbp, %rsp\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_runtime appends the array/RC/heap runtime the IR path needs, using
// asm.fern's OWN array layout + helper bodies (transcribed verbatim from
// asm.fern's emit_runtime) so the IR path is a byte-compatible DROP-IN: the
// 8-byte rc-header box (base = [cap, rc, len, e0..]; data = base+16; cap at
// data-16, rc at data-8, element i at data+(i+1)*8), the size-classed
// __fern_freelist allocator, and the stack-ABI rc helpers
// (__fn___fern_rc_inc / __fn___fern_arr_dec / …). asm.fern imports asm_ir
// (not the reverse), so these bodies are duplicated here rather than shared;
// the two emit paths are mutually exclusive per compile (emit_module vs
// emit_module_ir), so there is no symbol clash.
// emit_ccall_shim1 emits one `__fn___c_call<n>[suffix]` FFI shim (#4375). The
// shim is entered like any stack-ABI callee — the generic call_direct emit
// reversed the args so arg0 (fn) sits on top, i.e. param0 @ 16(%rbp), a_i @
// (24 + 8i)(%rbp). It marshals fn into %r11 and a0..a{n-1} into the System V
// integer-arg registers (%rdi/%rsi/%rdx/%rcx), 16-byte-aligns %rsp for the C
// ABI, and `call *%r11`s the pointer; the callee's result lands in %rax (or
// %xmm0 for the _f32/_f64 variants) and flows straight back. Mirrors native's
// emitCCallRuntime, adapted from the register-arg to the stack-arg ABI.
function emit_ccall_shim1(s: asmcore.EmitState, variant: string, n: i32): asmcore.EmitState {
    s = s.write("\n__fn_" + variant + ":\n");
    s = s.write("    pushq %rbp\n    movq %rsp, %rbp\n");
    s = s.write("    movq 16(%rbp), %r11\n");
    if (n >= 1) { s = s.write("    movq 24(%rbp), %rdi\n"); }
    if (n >= 2) { s = s.write("    movq 32(%rbp), %rsi\n"); }
    if (n >= 3) { s = s.write("    movq 40(%rbp), %rdx\n"); }
    if (n >= 4) { s = s.write("    movq 48(%rbp), %rcx\n"); }
    s = s.write("    andq $-16, %rsp\n");
    s = s.write("    call *%r11\n");
    s = s.write("    movq %rbp, %rsp\n    popq %rbp\n    ret\n");
    return s;
}

// emit_ccall_shims emits every __c_call variant the module referenced (each
// registered as `need("ccall:<name>")` by the generic call_direct emit). The
// body depends only on the arity n; the _f32/_f64 suffixes share it verbatim.
function emit_ccall_shims(s: asmcore.EmitState): asmcore.EmitState {
    var arity: i32 = 0;
    while (arity <= 4) {
        var base: string = "__c_call" + util.i32_to_string(arity);
        if (s.has_need("ccall:" + base)) { s = emit_ccall_shim1(s, base, arity); }
        if (s.has_need("ccall:" + base + "_f32")) { s = emit_ccall_shim1(s, base + "_f32", arity); }
        if (s.has_need("ccall:" + base + "_f64")) { s = emit_ccall_shim1(s, base + "_f64", arity); }
        arity = arity + 1;
    }
    return s;
}

// any_ccall_need reports whether the module referenced any __c_call variant, so
// the emit dispatch knows to switch to .text and emit the shim block.
function any_ccall_need(s: asmcore.EmitState): boolean {
    var arity: i32 = 0;
    while (arity <= 4) {
        var base: string = "__c_call" + util.i32_to_string(arity);
        if (s.has_need("ccall:" + base)) { return true; }
        if (s.has_need("ccall:" + base + "_f32")) { return true; }
        if (s.has_need("ccall:" + base + "_f64")) { return true; }
        arity = arity + 1;
    }
    return false;
}

// rc_trace_on reports whether FERN_RC_TRACE is set — the self-host port of
// ast.RcTrace (#6068). Every heap event becomes self-describing: one stderr
// line per alloc/free, `rctrace <a|f> <ptr> <size> <site>`, three fixed-width
// 16-hex numbers. Pair the `a` lines against the `f` lines by POINTER and what
// is left is a leak, attributed to the code that asked for the memory.
//
// The native backend has had this since #6076; the self-host runtime had only
// the over-release detector (__fern_rc_underflow), so it could see a block
// freed twice but not one never freed at all. That asymmetry mattered: the
// remaining goal-2 deltas (docs/SELFHOST-PERCEUS-REUSE.md §3 Delta B — reuse
// admission for rc-element-array struct fields) are an ALLOCATION-VOLUME
// difference against native, and volume is the one thing no gate covered.
// With both compilers tracing, `a` lines the self-host emits that native does
// not name the construction sites where reuse was missed.
function rc_trace_on(): boolean {
    match (env("FERN_RC_TRACE")) {
        Some(_) => { return true; },
        None => { return false; }
    }
}

// leak_check_on reports whether FERN_LEAKCHECK is set — the self-host port of
// ast.LeakCheckEnabled. Counts every alloc and every free (count + bytes) and
// prints one line at exit:
//
//	leakcheck: allocs=<N> frees=<M> live_bytes=<K>
//
// The detector half of the pair above: this says a leak happened, the trace
// says where. Both counters tick in the same __fern_hev_* helpers, off the
// same rounded size, so the trace's own tallies reproduce this line exactly.
function leak_check_on(): boolean {
    match (env("FERN_LEAKCHECK")) {
        Some(_) => { return true; },
        None => { return false; }
    }
}

// hev_on reports whether either heap-event diagnostic is on, i.e. whether the
// __fern_hev_a / __fern_hev_f hooks and their shared writer are emitted at
// all. Every emission site below is gated on it, so a build with both flags
// off is byte-identical to one from a compiler without the feature.
function hev_on(): boolean {
    if (rc_trace_on()) { return true; }
    return leak_check_on();
}

// hev_free emits one heap-FREE event hook: the block at `ptr` is `words`
// 8-byte words. Both operands are pushed, never moved through a scratch
// register, so the hook clobbers nothing the surrounding free site still
// needs — the self-host's free sites are open-coded freelist pushes with 15
// different live-register sets, and a hook that had to pick a scratch at each
// would be 15 chances to corrupt a reclamation path.
//
// `ptr` is a register operand; `words` is a register or an immediate ($2 for
// a 16-byte map box, $3 for a 24-byte string box). The pushes are undone
// before control returns to the site, so a site that later reads its stack
// argument (__fn___fern_alloc_reuse's `8(%rsp)`) is unaffected.
function hev_free(s: asmcore.EmitState, ptr: string, words: string): asmcore.EmitState {
    if (!hev_on()) { return s; }
    s = s.write("    pushq " + words + "\n");
    s = s.write("    pushq " + ptr + "\n");
    s = s.write("    call __fern_hev_f\n");
    s = s.write("    addq $16, %rsp\n");
    return s;
}

// emit_hev_runtime emits the heap-event diagnostics block: the leakcheck
// counters, the fixed report/trace text, the two event entry points, the
// shared stderr writer, and the exit-time summary. Entry-module-only (one
// definition per program) and emitted whenever either flag is on, INDEPENDENT
// of the heap runtime — a heap-free program still has an `exit` builtin that
// calls __fern_lc_report, and it must resolve.
//
// Sizes are carried in WORDS, not bytes. The self-host heap is uniformly
// 8-byte-granular (__fern_alloc rounds every request to 8 and classes by
// bytes/8), so words is the unit both sides can state exactly: an alloc's
// (bytes+7)>>3 and a free site's own class index are then the same number for
// the same block, and a block's alloc cancels its free precisely. The large
// tier is the one place the two differ from what was physically consumed —
// alloc BUMPS at a 512-KiB-rounded capacity while both events report the
// logical size — so live_bytes measures demand, not arena footprint. That is
// the same definition __fern_large_push already bins by.
function emit_hev_runtime(s: asmcore.EmitState): asmcore.EmitState {
    if (!hev_on()) { return s; }
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_lc_alloc_count: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_lc_alloc_bytes: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_lc_free_count: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_lc_free_bytes: .quad 0\n");
    s = s.write("    .align 8\n");
    // Site override, set by the box shims (hev_shim_site) and consumed by the
    // next __fern_hev_a. 0 = no claim, so __fern_alloc's own caller is used.
    s = s.write("__fern_hev_site: .quad 0\n");
    s = s.write("    .section .rodata\n");
    // The writer passes exact lengths, so no NUL is ever emitted; .ascii
    // rather than .asciz keeps that explicit.
    s = s.write(".Lhev_sp:\n    .ascii \" \"\n");
    s = s.write(".Lhev_nl:\n    .ascii \"\\n\"\n");
    if (rc_trace_on()) {
        s = s.write(".Lhev_pre:\n    .ascii \"rctrace \"\n");
    }
    if (leak_check_on()) {
        s = s.write(".Llc_a:\n    .ascii \"leakcheck: allocs=\"\n");
        s = s.write(".Llc_f:\n    .ascii \" frees=\"\n");
        s = s.write(".Llc_l:\n    .ascii \" live_bytes=\"\n");
    }
    s = s.write("    .section .text\n");
    // __fern_hev_a(site, ptr, words) — stack args at 8/16/24(%rsp), pushed by
    // __fern_alloc's wrapper. The site is passed EXPLICITLY here because the
    // wrapper knows it (its own return address) while this helper's [rsp]
    // would only name the wrapper.
    //
    // .globl on both entry points: the map_get_or shell free is emitted into
    // ORDINARY generated code, which under -per-module-emit-all lands in a
    // different unit from this block (the entry's).
    s = s.write("    .globl __fern_hev_a\n");
    s = s.write("__fern_hev_a:\n");
    s = hev_save(s);
    s = s.write("    movq 112(%rsp), %r14\n");   // site (explicit arg)
    s = s.write("    movq 120(%rsp), %r12\n");   // ptr
    s = s.write("    movq 128(%rsp), %r13\n");   // words
    s = s.write("    shlq $3, %r13\n");          // bytes = words * 8
    s = s.write("    movq $97, %rbx\n");         // 'a'
    // A box shim's claim outranks __fern_alloc's own caller: it names the code
    // that wanted the box rather than the shim that built it. Consume it, so
    // the next allocation starts from no claim.
    s = s.write("    movq __fern_hev_site(%rip), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    je .Lhev_a_nosite\n");
    s = s.write("    movq %rax, %r14\n");
    s = s.write("    movq $0, %rax\n");
    s = s.write("    movq %rax, __fern_hev_site(%rip)\n");
    s = s.write(".Lhev_a_nosite:\n");
    if (leak_check_on()) {
        s = s.write("    movq __fern_lc_alloc_count(%rip), %rax\n");
        s = s.write("    addq $1, %rax\n");
        s = s.write("    movq %rax, __fern_lc_alloc_count(%rip)\n");
        s = s.write("    movq __fern_lc_alloc_bytes(%rip), %rax\n");
        s = s.write("    addq %r13, %rax\n");
        s = s.write("    movq %rax, __fern_lc_alloc_bytes(%rip)\n");
    }
    s = s.write("    jmp .Lhev_emit\n");
    // __fern_hev_f(ptr, words) — stack args at 8/16(%rsp). The site is this
    // helper's OWN return address, i.e. the instruction after the call inside
    // the freeing helper. That is exactly as informative as the native f-site
    // and costs the free sites nothing: every release funnels through a
    // handful of shared drop helpers, so an `f` line names __fern_arr_dec
    // rather than user code either way. The ALLOC site is what locates a leak.
    s = s.write("    .globl __fern_hev_f\n");
    s = s.write("__fern_hev_f:\n");
    s = hev_save(s);
    s = s.write("    movq 104(%rsp), %r14\n");   // site = return address
    s = s.write("    movq 112(%rsp), %r12\n");   // ptr
    s = s.write("    movq 120(%rsp), %r13\n");   // words
    s = s.write("    shlq $3, %r13\n");
    s = s.write("    movq $102, %rbx\n");        // 'f'
    if (leak_check_on()) {
        s = s.write("    movq __fern_lc_free_count(%rip), %rax\n");
        s = s.write("    addq $1, %rax\n");
        s = s.write("    movq %rax, __fern_lc_free_count(%rip)\n");
        s = s.write("    movq __fern_lc_free_bytes(%rip), %rax\n");
        s = s.write("    addq %r13, %rax\n");
        s = s.write("    movq %rax, __fern_lc_free_bytes(%rip)\n");
    }
    s = s.write(".Lhev_emit:\n");
    if (rc_trace_on()) {
        s = s.write("    leaq .Lhev_pre(%rip), %rsi\n");
        s = s.write("    movq $8, %rdx\n");
        s = s.write("    call .Lhev_w\n");
        // The kind is a value, not a literal, so it needs a byte of memory to
        // point write(2) at: borrow 16 bytes of stack and write the low byte
        // of the 8-byte store (little-endian).
        s = s.write("    subq $16, %rsp\n");
        s = s.write("    movq %rbx, (%rsp)\n");
        s = s.write("    movq %rsp, %rsi\n");
        s = s.write("    movq $1, %rdx\n");
        s = s.write("    call .Lhev_w\n");
        s = s.write("    addq $16, %rsp\n");
        s = hev_field(s, "%r12");
        s = hev_field(s, "%r13");
        s = hev_field(s, "%r14");
        s = s.write("    leaq .Lhev_nl(%rip), %rsi\n");
        s = s.write("    movq $1, %rdx\n");
        s = s.write("    call .Lhev_w\n");
    }
    s = hev_restore(s);
    s = s.write("    ret\n");
    // .Lhev_w(%rsi = buf, %rdx = len): one write(2) to stderr. Shared by the
    // tracer and the leakcheck report, so it is emitted whenever either is on.
    // `syscall` clobbers %rcx and %r11; both are saved by hev_save, which is
    // why the three trace values live in %r12/%r13/%r14 rather than being
    // re-read from argument registers between writes.
    s = s.write(".Lhev_w:\n");
    s = s.write("    movq $2, %rdi\n");
    s = s.write("    movq $1, %rax\n");
    s = s.write("    syscall\n");
    s = s.write("    ret\n");
    if (rc_trace_on()) {
        // .Lhev_hex(%rdi = value): 16 hex digits, most-significant first, built
        // backwards into a stack buffer then written in one write(2). Fixed
        // width, so no leading-zero suppression and no length bookkeeping —
        // the consumer is a pairing script, and a uniform record needs no
        // field-splitting to match an `a` line to its `f` line by pointer.
        s = s.write(".Lhev_hex:\n");
        s = s.write("    subq $32, %rsp\n");
        s = s.write("    movq %rsp, %rsi\n");
        s = s.write("    addq $16, %rsi\n");     // one past the digit field
        s = s.write("    movq %rdi, %rax\n");
        s = s.write("    movq $16, %rcx\n");
        s = s.write(".Lhev_hexloop:\n");
        s = s.write("    movq %rax, %rdx\n");
        s = s.write("    andq $15, %rdx\n");
        s = s.write("    cmpq $10, %rdx\n");
        s = s.write("    jb .Lhev_hexdig\n");
        s = s.write("    addq $39, %rdx\n");     // 'a'-'0'-10: skip ':'..'`'
        s = s.write(".Lhev_hexdig:\n");
        s = s.write("    addq $48, %rdx\n");     // -> ASCII
        s = s.write("    subq $1, %rsi\n");
        s = s.write("    movb %dl, (%rsi)\n");
        s = s.write("    shrq $4, %rax\n");
        s = s.write("    subq $1, %rcx\n");
        s = s.write("    testq %rcx, %rcx\n");
        s = s.write("    jne .Lhev_hexloop\n");
        s = s.write("    movq %rsp, %rsi\n");
        s = s.write("    movq $16, %rdx\n");
        s = s.write("    call .Lhev_w\n");
        s = s.write("    addq $32, %rsp\n");
        s = s.write("    ret\n");
    }
    if (leak_check_on()) {
        // __fern_lc_report() — the exit-time summary, called from `_start`'s
        // epilogue and from the `exit` builtin (which bypasses it). Both call
        // sites protect their live exit code with a push/pop across the call,
        // so this helper is free to clobber. .globl: the `exit` builtin is
        // lowered in ANY module, this block only in the entry.
        s = s.write("    .globl __fern_lc_report\n");
        s = s.write("__fern_lc_report:\n");
        s = s.write("    leaq .Llc_a(%rip), %rsi\n");
        s = s.write("    movq $18, %rdx\n");
        s = s.write("    call .Lhev_w\n");
        s = s.write("    movq __fern_lc_alloc_count(%rip), %rdi\n");
        s = s.write("    call .Llc_num\n");
        s = s.write("    leaq .Llc_f(%rip), %rsi\n");
        s = s.write("    movq $7, %rdx\n");
        s = s.write("    call .Lhev_w\n");
        s = s.write("    movq __fern_lc_free_count(%rip), %rdi\n");
        s = s.write("    call .Llc_num\n");
        s = s.write("    leaq .Llc_l(%rip), %rsi\n");
        s = s.write("    movq $12, %rdx\n");
        s = s.write("    call .Lhev_w\n");
        // live_bytes is SIGNED: an over-free shows negative rather than
        // wrapping to a number that reads like a colossal leak.
        s = s.write("    movq __fern_lc_alloc_bytes(%rip), %rdi\n");
        s = s.write("    movq __fern_lc_free_bytes(%rip), %rax\n");
        s = s.write("    subq %rax, %rdi\n");
        s = s.write("    call .Llc_num\n");
        s = s.write("    leaq .Lhev_nl(%rip), %rsi\n");
        s = s.write("    movq $1, %rdx\n");
        s = s.write("    call .Lhev_w\n");
        s = s.write("    ret\n");
        // .Llc_num(%rdi = signed i64): decimal itoa, digits built backwards
        // from the end of a stack buffer (an i64 is at most 19 digits + sign),
        // then one write(2).
        s = s.write(".Llc_num:\n");
        s = s.write("    subq $48, %rsp\n");
        s = s.write("    movq %rsp, %rcx\n");
        s = s.write("    addq $32, %rcx\n");
        s = s.write("    movq $0, %r9\n");       // sign flag
        s = s.write("    movq %rdi, %rax\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jns .Llc_numloop\n");
        s = s.write("    negq %rax\n");
        s = s.write("    movq $1, %r9\n");
        s = s.write(".Llc_numloop:\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rsi\n");
        s = s.write("    divq %rsi\n");
        s = s.write("    addq $48, %rdx\n");     // remainder -> ASCII digit
        s = s.write("    subq $1, %rcx\n");
        s = s.write("    movb %dl, (%rcx)\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Llc_numloop\n");
        s = s.write("    testq %r9, %r9\n");
        s = s.write("    je .Llc_numemit\n");
        s = s.write("    subq $1, %rcx\n");
        s = s.write("    movq $45, %rdx\n");     // '-'
        s = s.write("    movb %dl, (%rcx)\n");
        s = s.write(".Llc_numemit:\n");
        s = s.write("    movq %rsp, %rdx\n");
        s = s.write("    addq $32, %rdx\n");
        s = s.write("    subq %rcx, %rdx\n");    // len
        s = s.write("    movq %rcx, %rsi\n");
        s = s.write("    call .Lhev_w\n");
        s = s.write("    addq $48, %rsp\n");
        s = s.write("    ret\n");
    }
    return s;
}

// hev_shim_site emits a box shim's site prologue: record OUR caller as the
// site the next allocation should be attributed to, unless an outer shim
// already claimed it.
//
// Without this the tracer is much weaker on the self-host than on native.
// The native backend's generated code calls __fern_alloc directly, so the
// immediate caller IS the construction site; the self-host routes nearly all
// boxing through __fern_arr_box / __fern_str_box, so every array and string in
// the program reported the same two addresses and the trace could not
// distinguish one construction site from another — the one thing it exists to
// do. Measured on a three-array retain probe: every unpaired alloc attributed
// to `__fern_arr_box + 18`.
//
// First writer wins, so a nested shim chain (struct_copy -> arr_box -> alloc)
// reports the OUTERMOST caller, which is the one in user code.
// __fern_hev_a consumes the slot and clears it, so a stale value cannot leak
// into a later unrelated allocation: every shim here calls __fern_alloc
// unconditionally, so a set is always followed by exactly one consume.
// Single-threaded by construction, like the rest of the runtime.
//
// That unconditionality is why the claim is limited to these three. A helper
// that allocates only SOMETIMES — __fern_arr_push, whose grow path allocates
// and whose in-place path does not — cannot claim at its entry without
// leaving a stale site behind on the fast path, to be consumed by the next
// unrelated allocation and reported as a confident lie. Making that safe
// needs a save/restore protocol around each call rather than a single slot,
// which is more invariant than the case warrants: append-growth attribution
// already has an answer that needs no flag at all (break on the counter bump
// in __fern_arr_push_grow and read the return address — see
// docs/TEST-GATES.md). So a block grown by an append reports
// `__fern_arr_push`, and the construction sites — where a leak is actually
// born — report user code.
//
// %rax is the scratch: it is dead at the entry of all three shims (each
// RETURNS in %rax and reads nothing from it), and the prologue sits ahead of
// every push so `(%rsp)` is still the return address.
function hev_shim_site(s: asmcore.EmitState, tag: string): asmcore.EmitState {
    if (!hev_on()) { return s; }
    s = s.write("    movq __fern_hev_site(%rip), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jne .L" + tag + "_hs\n");
    s = s.write("    movq (%rsp), %rax\n");
    s = s.write("    movq %rax, __fern_hev_site(%rip)\n");
    s = s.write(".L" + tag + "_hs:\n");
    return s;
}

// hev_field emits one " <16 hex digits>" field of a trace line.
function hev_field(s: asmcore.EmitState, reg: string): asmcore.EmitState {
    s = s.write("    leaq .Lhev_sp(%rip), %rsi\n");
    s = s.write("    movq $1, %rdx\n");
    s = s.write("    call .Lhev_w\n");
    s = s.write("    movq " + reg + ", %rdi\n");
    s = s.write("    call .Lhev_hex\n");
    return s;
}

// hev_save / hev_restore bracket an event helper's body. EVERY register the
// helper can touch is saved, callee- and caller-saved alike: the hooks are
// injected mid-flow into reclamation paths that have live values in whatever
// the surrounding helper happened to be using, so the only safe contract is
// "clobbers nothing". 13 pushes = 104 bytes, which is what fixes the stack
// offsets the two entry points read their arguments at.
function hev_save(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("    pushq %rax\n    pushq %rcx\n    pushq %rdx\n    pushq %rsi\n");
    s = s.write("    pushq %rdi\n    pushq %r8\n    pushq %r9\n    pushq %r10\n");
    s = s.write("    pushq %r11\n    pushq %rbx\n    pushq %r12\n    pushq %r13\n");
    s = s.write("    pushq %r14\n");
    return s;
}

function hev_restore(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n");
    s = s.write("    popq %r11\n    popq %r10\n    popq %r9\n    popq %r8\n");
    s = s.write("    popq %rdi\n    popq %rsi\n    popq %rdx\n    popq %rcx\n");
    s = s.write("    popq %rax\n");
    return s;
}

function emit_ir_runtime(s: asmcore.EmitState): asmcore.EmitState {
    // .bss: heap bump pointer + arena end, the over-release detector, and the
    // size-classed freelist (65536 classes * 8 bytes). The heap arena itself is
    // mmap'd lazily at runtime (see __fern_alloc below) rather than reserved as
    // a multi-GiB `.bss` block, so the emitted binary makes no assumption about
    // the linker's .bss layout — bfd / lld / mold all work (issue #4081).
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
    // .globl on the cursor + end pair for the reason spelled out on
    // __fern_arr_push_shared below: __heap_bump_bytes lowers to an INLINE read of
    // BOTH (`movq __fern_heap_ptr(%rip)` / `movq __fern_heap_end(%rip)`, kind_tag
    // 80), never a call through a global accessor, so a file-local symbol is
    // unreachable from any unit but the one holding the runtime.
    s = s.write("    .globl __fern_heap_ptr\n");
    s = s.write("__fern_heap_ptr: .quad 0\n");       // bump cursor (0 until first mmap)
    s = s.write("    .align 8\n");
    s = s.write("    .globl __fern_heap_end\n");
    s = s.write("__fern_heap_end: .quad 0\n");        // arena end (base + heap_size), set at mmap time
    s = s.write("    .align 8\n");
    // arena BASE (the mmap return), set once at first alloc. Bounds the freeable
    // heap range [base, end) so __fern_str_free can free a heap string's data
    // buffer but skip a static string LITERAL's .rodata data pointer (which sits
    // below the arena) — the heap-vs-literal test the header-less asm string box
    // otherwise can't make. Used only by __fern_str_free (#2649 string RC).
    s = s.write("__fern_heap_base: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_rc_underflow: .quad 0\n");
    s = s.write("    .align 8\n");
    // The rc==1 append cliff counter (#6023): appends that copied a buffer which
    // still had spare capacity, so the copy was bought by an extra reference
    // rather than a full buffer. Bumped on the un-share path in __fern_arr_push,
    // read by __arr_push_shared_count. 0 on a healthy run.
    //
    // .globl because __arr_push_shared_count lowers to an INLINE read of this
    // word (`movq __fern_arr_push_shared(%rip)`), unlike its sibling
    // __rc_underflow_count which lowers to a CALL to the global
    // __fn___fern_rc_underflow_count that reads its word from inside this same
    // unit. An inline read cannot reach a file-local symbol in another unit, so
    // under -per-module-emit-all — which does no cross-module DCE, and so emits
    // every function whether or not the bundle calls it — a caller landing in
    // any unit but this one failed to link with "undefined reference to
    // __fern_arr_push_shared". Whole-program builds never saw it: one unit, one
    // file, local resolution. See #6058.
    //
    // These two — the cliff counter and the heap cursor/end pair above — are the
    // ONLY .bss words an op lowering reads inline; every other reference
    // (__fern_rc_underflow, __fern_freelist, __fern_envp, __fern_strbuf_*,
    // __fern_heap_base) is emitted inside a runtime helper, which lands in this
    // same unit. That is why __fern_heap_base stays local: only __fern_str_free
    // reads it.
    s = s.write("    .globl __fern_arr_push_shared\n");
    s = s.write("__fern_arr_push_shared: .quad 0\n");
    s = s.write("    .align 8\n");
    // The same crossings WEIGHTED by the bytes they copied (len * 8 — the
    // self-host array model is uniform 8-byte slots), read by
    // __arr_push_shared_bytes. The count says whether the cliff was crossed;
    // this says whether it cost anything, and the two readings differ by three
    // orders of magnitude on real runs. .globl for exactly the reason the
    // counter above is: its reader lowers to an INLINE read of this word, which
    // cannot reach a file-local symbol in another unit under
    // -per-module-emit-all (#6058, #6066).
    s = s.write("    .globl __fern_arr_push_copied\n");
    s = s.write("__fern_arr_push_copied: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_freelist: .skip 524288\n");
    s = s.write("    .align 8\n");
    // Large-tier segregated freelist (#3425): the 65536-word __fern_freelist above
    // recycles blocks <512 KiB exactly; blocks >=512 KiB previously LEAKED (no class),
    // so a long-running emit that frees big per-function analysis arrays exhausted the
    // arena (exit 137) — the self-host runtime lagging the native two-tier design. This
    // array is the large tier: LINEAR 512-KiB classes, class = round_up(size, 512 KiB)
    // >> 19 (1..2048 for 512 KiB..1 GiB), so 2049 slots suffice (2560 for headroom).
    // A power-of-two/log2 binning is deliberately AVOIDED: the self-host x86_gas
    // assembler (used by the capstone self-assembly test) has no `bsr` and only
    // immediate-count shifts, so the linear scheme uses only leaq/andq/shrq-$imm.
    // Each large ALLOC rounds the request up to its class capacity (a 512-KiB multiple)
    // and bumps at THAT — so every block in a class has one capacity and any freed block
    // satisfies any same-class request; each large FREE re-derives the class from the
    // logical size via the same round-up and pushes the block (successor pointer in its
    // first 8 bytes; 0 = empty). >1 GiB is never freelisted (bump/leak only).
    s = s.write("__fern_large_freelist: .skip 20480\n");
    s = s.write("    .section .text\n");
    // __fern_alloc(%rdi = bytes) -> %rax = block. Size-classed freelist reuse
    // (class = bytes/8 < 65536) then bump; OOM traps with exit 137.
    //
    // Under a heap-event build the body becomes __fern_alloc_inner and this is
    // a wrapper around it, so ONE hook covers all three allocation exits (the
    // small-class freelist pop, the large-class pop, and the bump) instead of
    // three hooks at three different live-register states. The wrapper is also
    // where the reported site is naturally correct: [rsp] on entry is the
    // caller's return address, i.e. the code that ASKED for the memory, not
    // the exit path that happened to satisfy it.
    //
    // Callers see the same contract either way — %rax is the block, %rdi is
    // clobbered, everything else preserved (%rsi is saved and restored around
    // the hook; __fern_hev_a itself clobbers nothing).
    //
    // Note the site is the IMMEDIATE caller. Allocations routed through the
    // box shims (__fern_arr_box / __fern_str_box) therefore report the shim,
    // not the code that wanted the box — the same limitation the native hook
    // has, and the reason an `a` line naming a shim needs one gdb frame walk
    // to attribute.
    if (hev_on()) {
        s = s.write("__fern_alloc:\n");
        s = s.write("    pushq %rdi\n");             // requested bytes
        s = s.write("    call __fern_alloc_inner\n");
        s = s.write("    popq %rdi\n");
        s = s.write("    pushq %rsi\n");
        s = s.write("    movq 8(%rsp), %rsi\n");     // site = our caller's return address
        s = s.write("    addq $7, %rdi\n");          // the rounding __fern_alloc_inner applies
        s = s.write("    shrq $3, %rdi\n");          // words
        s = s.write("    pushq %rdi\n");
        s = s.write("    pushq %rax\n");
        s = s.write("    pushq %rsi\n");
        s = s.write("    call __fern_hev_a\n");
        s = s.write("    addq $24, %rsp\n");
        s = s.write("    popq %rsi\n");
        s = s.write("    ret\n");
        s = s.write("__fern_alloc_inner:\n");
    } else {
        s = s.write("__fern_alloc:\n");
    }
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    addq $7, %rdi\n");
    s = s.write("    andq $-8, %rdi\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    pushq %rdx\n");
    s = s.write("    movq %rdi, %rcx\n");
    s = s.write("    shrq $3, %rcx\n");
    s = s.write("    cmpq $65536, %rcx\n");
    s = s.write("    jae .Lalloc_large\n");
    s = s.write("    leaq __fern_freelist(%rip), %rdx\n");
    s = s.write("    movq (%rdx,%rcx,8), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lalloc_nofl\n");
    s = s.write("    movq (%rax), %rdi\n");
    s = s.write("    movq %rdi, (%rdx,%rcx,8)\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    // Large tier (#3425): a >=512 KiB request. Round the byte size UP to a 512-KiB
    // multiple (the class capacity — bump AT it so every block in a class has one
    // size, so any freed block satisfies any same-class request), derive class =
    // cap >> 19, and pop the large freelist; empty falls through to the bump with
    // %rdi = capacity. >1 GiB is bump-only. Linear (no bsr / no %cl shift) so the
    // self-host x86_gas assembler can encode it. %rcx/%rdx are already saved.
    s = s.write(".Lalloc_large:\n");
    s = s.write("    cmpq $0x40000000, %rdi\n");        // > 1 GiB: bump exact, no freelist
    s = s.write("    ja .Lalloc_nofl\n");
    s = s.write("    leaq 524287(%rdi), %rax\n");       // size + (512 KiB - 1)
    s = s.write("    andq $-524288, %rax\n");           // cap = round_up(size, 512 KiB)
    s = s.write("    movq %rax, %rdi\n");               // %rdi = cap = bytes to bump
    s = s.write("    shrq $19, %rax\n");                // class = cap >> 19  (1..2048)
    s = s.write("    leaq __fern_large_freelist(%rip), %rdx\n");
    s = s.write("    movq (%rdx,%rax,8), %rcx\n");      // head
    s = s.write("    testq %rcx, %rcx\n");
    s = s.write("    jz .Lalloc_nofl\n");               // empty class: bump at cap (%rdi)
    s = s.write("    movq (%rcx), %rdi\n");             // head.next
    s = s.write("    movq %rdi, (%rdx,%rax,8)\n");      // heads[class] = next
    s = s.write("    movq %rcx, %rax\n");               // return reused block
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_nofl:\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jne .Lalloc_inited\n");
    // First allocation: lazily mmap the arena at hint 0x10000000
    // (MAP_PRIVATE | MAP_ANONYMOUS, R+W). Runs once. The kernel hands back
    // the base, so the heap address is NOT derived from the linker's .bss
    // layout (issue #4081). %rdi (rounded size) is live; every register but
    // %rax/%rdi (the clobber contract) is saved across the syscall.
    s = s.write("    pushq %rdi\n");
    s = s.write("    pushq %rsi\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    pushq %rdx\n");
    s = s.write("    pushq %r8\n");
    s = s.write("    pushq %r9\n");
    s = s.write("    pushq %r10\n");
    s = s.write("    pushq %r11\n");
    s = s.write("    movl $0x10000000, %edi\n");          // addr hint
    s = s.write("    movabs $17179869184, %rsi\n");        // length = 0x400000000, 16 GiB (64-bit imm; lockstep with asm_arm64_ir.fern + native x86-64)
    s = s.write("    movl $3, %edx\n");                   // PROT_READ | PROT_WRITE
    s = s.write("    movl $0x4022, %r10d\n");             // MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE (exempt from overcommit accounting; lockstep with asm.fern + the native x86-64 backend)
    s = s.write("    movq $-1, %r8\n");                   // fd
    s = s.write("    xorl %r9d, %r9d\n");                 // offset
    s = s.write("    movl $9, %eax\n");                   // __NR_mmap
    s = s.write("    syscall\n");
    s = s.write("    cmpq $0, %rax\n");                   // mmap returns -errno on failure
    s = s.write("    jl .Lalloc_oom\n");
    s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
    s = s.write("    movq %rax, __fern_heap_base(%rip)\n"); // record arena base (freeable-range lower bound)
    s = s.write("    movabs $17179869184, %rcx\n");        // heap_size (64-bit imm)
    s = s.write("    addq %rax, %rcx\n");                 // %rcx = base + heap_size (END)
    s = s.write("    movq %rcx, __fern_heap_end(%rip)\n");
    s = s.write("    popq %r11\n");
    s = s.write("    popq %r10\n");
    s = s.write("    popq %r9\n");
    s = s.write("    popq %r8\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    popq %rsi\n");
    s = s.write("    popq %rdi\n");
    s = s.write(".Lalloc_inited:\n");
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
    s = s.write("    addq %rax, %rdi\n");
    s = s.write("    cmpq __fern_heap_end(%rip), %rdi\n"); // arena end recorded at mmap time
    s = s.write("    ja .Lalloc_oom\n");
    s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_oom:\n");
    s = s.write("    movq $60, %rax\n");
    // 125, not 137: 137 is 128+9, what a shell reports for SIGKILL, so an arena
    // trap could not be told apart from the kernel OOM-killer. Opposite causes,
    // opposite fixes. Lockstep with the native backends' ExitArenaExhausted.
    s = s.write("    movq $125, %rdi\n");
    s = s.write("    syscall\n");
    // __fern_oob_abort — shared out-of-bounds trap for arr_get / arr_set.
    // Aborts with exit 134, matching the native backends + docs/ARRAY-BOUNDS.md
    // ("an out-of-bounds index aborts before producing a value; never returns a
    // garbage value"). A single shared routine keeps the per-access check to a
    // compare + a jae to here, with no per-site label churn.
    s = s.write("__fern_oob_abort:\n");
    s = s.write("    movq $60, %rax\n");
    s = s.write("    movq $134, %rdi\n");
    s = s.write("    syscall\n");
    // __fern_arr_box(%rdi = cap element count) -> %rax = data ptr (base+16).
    // base = [cap, rc=1, len=cap, e0..]; element i at data+(i+1)*8.
    s = s.write("__fern_arr_box:\n");
    s = hev_shim_site(s, "arrbox");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rdi\n");
    s = s.write("    addq $3, %rdi\n");
    s = s.write("    shlq $3, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq -8(%rbp), %rdi\n");
    s = s.write("    movq %rdi, (%rax)\n");
    s = s.write("    movq $1, 8(%rax)\n");
    s = s.write("    movq %rdi, 16(%rax)\n");
    s = s.write("    addq $16, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
