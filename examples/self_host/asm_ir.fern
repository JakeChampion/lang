        s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n");
        s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
        s = s.write("    testq %rcx, %rcx\n    jns " + s_from_ok + "\n    xorq %rcx, %rcx\n");
        s = s.write(s_from_ok + ":\n    movq (%rdx), %r9\n");
