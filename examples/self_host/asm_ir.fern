        var clo2: asmcore.LabelOut = asmcore.fresh_label(clo.state);
        var c_flag: string = clo2.name;
        var clo3: asmcore.LabelOut = asmcore.fresh_label(clo2.state);
        var c_done: string = clo3.name;
        s = clo3.state;
        s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n");
        s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
        s = s.write("    xorq %r9, %r9\n    testq %rcx, %rcx\n    sete %r9b\n");
        s = s.write("    xorq %r11, %r11\n    xorq %rcx, %rcx\n    movq (%rdx), %rsi\n");
        s = s.write(c_loop + ":\n");
        s = s.write("    cmpq %r8, %rcx\n    jge " + c_done + "\n");
        s = s.write("    movzbq (%rax,%rcx), %r10\n");
        s = s.write("    movq $1, %rdi\n");
        s = s.write("    cmpq %rsi, %r10\n    jae " + c_flag + "\n");
        s = s.write("    cmpq $0, 8(%rdx,%r10,8)\n    sete %dil\n");
        s = s.write(c_flag + ":\n");
        s = s.write("    cmpq %r9, %rdi\n    adcq $0, %r11\n    movq %rdi, %r9\n");
        s = s.write("    addq $1, %rcx\n    jmp " + c_loop + "\n");
        s = s.write(c_done + ":\n    pushq %r11\n");
        return s;
    }
    if (o.kind_tag == 253) {  // sum_bytes
        // operand stack [box] -> every byte of the string added into a
