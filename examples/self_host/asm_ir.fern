        // poison-and-decline every other free path applies.
        s = s.write("    movl $" + rc_poison() + ", -8(%rax)\n");
    } else {
    s = freelist_push(s, "%rcx", "%rdx", "%rsi");
    }
    s = s.write(".Lsarelo_fresh:\n");
    s = s.write("    movq 8(%rsp), %rdi\n");         // slots = arr_box cap
    // TAIL-jump (not call): arr_box returns straight to OUR caller with the
    // fresh data ptr in %rax. Besides saving a frame, this keeps the emitted
    // text free of an extra `call __fern_arr_box` line — the reuse contract
    // tests count that exact string in the whole asm, and the helper body
    // must not inflate every program's static count by one.
    s = s.write("    jmp __fern_arr_box\n");
    s = s.write(".Lsarelo_ret:\n");
    s = s.write("    ret\n");
