    s = s.write("    jz .Larrdec_ret\n");
    s = s.write("    cmpq $0x10000, %rax\n");
    s = s.write("    jb .Larrdec_ret\n");
    s = s.write("    movl -8(%rax), %ecx\n");
    s = s.write(san_poison_check("%ecx"));
    s = s.write("    testl %ecx, %ecx\n");
    s = s.write("    js .Larrdec_ret\n");
    s = s.write("    cmpl $1, %ecx\n");
