    // immortal/sentinel marker (skip); rc>1 decrements without freeing (the box is
    // still shared — once inc-on-alias is wired in A2, an aliased string survives);
    // rc==1 frees the data buffer + the box; rc==0 is a double-free, caught by the
    // underflow counter (matching __fn___fern_arr_dec) rather than corrupting the heap.
    s = s.write("    movl -8(%rax), %ecx\n");       // rc
    s = s.write("    testl %ecx, %ecx\n");
