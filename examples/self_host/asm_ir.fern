    if (o.kind_tag == 322) {  // scale_f64
        // operand stack [xs, k bits] -> the data pointer of a fresh f64
        // array of xs's length whose element i is xs[i] * k.
        //
        // SSE2 (§3.4 step 3): mulpd over two lanes, with the scalar loop as
        // the tail for an odd length. Elementwise, so the lanes reassociate
        // nothing (ARRAY-ALGEBRA.md §3, AA-02). Two lanes, not the four the
        // native x86-64 emitter gets: this assembler has no VEX surface, and
        // an xmm is 128 bits.
