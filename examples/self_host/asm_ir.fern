    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    }

    // __fern_arr_push_owned — the sole-owner self-append (irlower's !aliased
    // `a = a.append(v)`). Identical to __fern_arr_push but reclaims the old buffer
    // when the push GREW (reallocated): a thin wrapper that saves the old ptr,
    // calls __fern_arr_push, and — iff the result differs (grow) — pushes the old
    // box onto its size class (the arr_dec free path). Sound only because the
    // emitting site proved the slot unaliased (sole owner), so the superseded old
    // buffer has no surviving reference. This is the safe, gated form of the free
    // the shared __fern_arr_push must NOT do (see .Larr_push_grow). Closes the
    // dominant per-module self-compile leak (#3452 / #3425). Depends on
    // __fern_arr_push, so it shares arr_push's emit gate — the op handler marks the
    // arr_push need alongside arr_push_owned, so the two are always co-present, and
    // the per-module entry (which emits __fern_arr_push) gets this wrapper too
    // without threading a separate need through the union.
    if (s.has_need("arr_push") || s.has_need("maps")) {
        s = s.write("__fern_arr_push_owned:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");            // align stack to 16 for the call
        s = s.write("    movq %rdi, %r12\n");        // save old arr ptr
        s = s.write("    call __fern_arr_push\n");   // %rax = new (grew) or old (in place)
        s = s.write("    cmpq %rax, %r12\n");
        s = s.write("    je .Lapo_ret\n");            // in place — nothing freed
        s = s.write("    cmpq $0x10000, %r12\n");     // grew: free the dead old box %r12
        s = s.write("    jb .Lapo_ret\n");            // low-addr / SSO sentinel
        s = s.write("    movl -8(%r12), %ecx\n");     // old rc
        s = s.write("    testl %ecx, %ecx\n");
        s = s.write("    js .Lapo_ret\n");            // static sentinel (rc<0)
        s = s.write("    cmpl $1, %ecx\n");
        s = s.write("    jne .Lapo_ret\n");           // not sole owner — leave (defensive)
        s = s.write("    movl -16(%r12), %ecx\n");    // old cap
        s = s.write("    addq $3, %rcx\n");           // words = cap + 3 (header)
        s = s.write("    cmpq $65536, %rcx\n");
        s = s.write("    jae .Lapo_large\n");         // large tier -> recycle via __fern_large_push
        s = s.write("    movl $0, -8(%r12)\n");       // mark freed
        s = s.write("    leaq -16(%r12), %rdx\n");    // old box base
        s = hev_free(s, "%rdx", "%rcx");
        s = s.write("    leaq __fern_freelist(%rip), %r8\n");
        s = s.write("    movq (%r8,%rcx,8), %rdi\n");
        s = s.write("    movq %rdi, (%rdx)\n");       // node.next = head
        s = s.write("    movq %rdx, (%r8,%rcx,8)\n"); // head = node
        s = s.write(".Lapo_ret:\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
        // Large tier (#3425): recycle the >=512 KiB superseded old buffer (base =
        // old-16, bytes = words*8) instead of leaking. %rax holds the return value
        // `new` and __fern_large_push clobbers it, so preserve it across the call;
        // %r12 is callee-saved.
        s = s.write(".Lapo_large:\n");
        s = s.write("    movl $0, -8(%r12)\n");       // mark freed
        s = s.write("    leaq -16(%r12), %r8\n");     // base = old - 16
        s = s.write("    leaq 0(,%rcx,8), %rsi\n");   // bytes = words*8
        s = s.write("    pushq %rax\n");              // preserve return value (new)
        s = s.write("    call __fern_large_push\n");
        s = s.write("    popq %rax\n");
        s = s.write("    jmp .Lapo_ret\n");
    }

    // Map runtime (transcribed from asm.fern) — only for map-using modules, so a
    // non-map heap program doesn't pull in map_set's __fern_str_eq dependency.
    if (s.has_need("maps")) {
    // __fern_map_new (transcribed from asm.fern for the IR map path).
    s = s.write(".globl __fern_map_new\n");
    s = s.write(".type __fern_map_new, @function\n");
    s = s.write("__fern_map_new:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    subq $8, %rsp\n");
    s = s.write("    movq $16, %rdi\n");
    s = s.write("    call __fern_alloc\n");        // mapbox
    s = s.write("    movq %rax, %rbx\n");
    s = s.write("    movq $0, %rdi\n");
    s = s.write("    call __fern_alloc_u8\n");      // empty keys
    s = s.write("    movq %rax, (%rbx)\n");
    s = s.write("    movq $0, %rdi\n");
    s = s.write("    call __fern_alloc_u8\n");      // empty values
    s = s.write("    movq %rax, 8(%rbx)\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_new, .-__fern_map_new\n");

    // __fern_map_snapshot_col(%rdi = column buffer) -> %rax = fresh rc=1 copy.
    // #4353 scalar keys()/values() snapshot: allocates a fresh __fern_arr_box
    // of the column's length (cap = len, rc = 1, len at data+0 — the same
    // layout arr_slice / array literals build), copies the len elements
    // (slots 1..len), and returns the copy. Kinds 131/132 call it for a
    // scalar (i32) column so the read result is an OWNED array: the exit
    // sweep's arr_dec reclaims the copy, and map_set's owned grow can free
    // the superseded live buffer without dangling the read. Elements are
    // copied bit-for-bit and NOT rc-inc'd — scalar columns only; the
    // string-column snapshot (element inc + deep free) is slice 3.
    s = s.write(".globl __fern_map_snapshot_col\n");
    s = s.write(".type __fern_map_snapshot_col, @function\n");
    s = s.write("__fern_map_snapshot_col:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq %rdi, %rbx\n");           // src column
    s = s.write("    movq (%rbx), %r12\n");         // len
    s = s.write("    movq %r12, %rdi\n");
    s = s.write("    call __fern_arr_box\n");       // -> data ptr (cap=len, rc=1, len=cap)
    s = s.write("    movq %r12, (%rax)\n");         // len = src len (cap == len already)
    s = s.write("    movq $1, %rcx\n");             // slot index 1..len
    s = s.write(".Lmsc_copy:\n");
    s = s.write("    cmpq %r12, %rcx\n");
    s = s.write("    jg .Lmsc_done\n");
    s = s.write("    movq (%rbx,%rcx,8), %rdx\n");
    s = s.write("    movq %rdx, (%rax,%rcx,8)\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lmsc_copy\n");
    s = s.write(".Lmsc_done:\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_snapshot_col, .-__fern_map_snapshot_col\n");

    // __fern_map_snapshot_col_str(%rdi = column buffer) -> %rax = fresh rc=1
    // copy with each STRING element retained (#4353 slice 3). Same box shape
    // as __fern_map_snapshot_col; after the bit copy, each element is
    // __fn___fern_rc_inc'd (its guards skip NULL / SSO-tagged / low-address /
    // static-literal values), so the snapshot co-owns every string and the
    // deep __fern_str_arr_free release (rc-aware per-element __fern_str_free,
    // dec each element, then the buffer) balances exactly. The map keeps its
    // own references — it stays a co-owner, exactly like an element read
    // through m.get() that gets stored.
    s = s.write(".globl __fern_map_snapshot_col_str\n");
    s = s.write(".type __fern_map_snapshot_col_str, @function\n");
    s = s.write("__fern_map_snapshot_col_str:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");                // dest (callee-saved across inc calls)
    s = s.write("    subq $8, %rsp\n");             // 16-byte align pad (rbp+3 pushes = odd)
    s = s.write("    movq %rdi, %rbx\n");           // src column
    s = s.write("    movq (%rbx), %r12\n");         // len
    s = s.write("    movq %r12, %rdi\n");
    s = s.write("    call __fern_arr_box\n");       // -> data ptr (cap=len, rc=1)
    s = s.write("    movq %r12, (%rax)\n");         // len = src len
    s = s.write("    movq %rax, %r13\n");           // dest
    s = s.write("    movq $1, %rcx\n");             // slot index 1..len
    s = s.write(".Lmscs_copy:\n");
    s = s.write("    cmpq %r12, %rcx\n");
    s = s.write("    jg .Lmscs_done\n");
    s = s.write("    movq (%rbx,%rcx,8), %rdx\n");
    s = s.write("    movq %rdx, (%r13,%rcx,8)\n");
    s = s.write("    pushq %rcx\n");                // save index across the call
    s = s.write("    pushq %rdx\n");                // stack arg for __fn___fern_rc_inc (arg at 8(%rsp)); rsp aligned
    s = s.write("    call __fn___fern_rc_inc\n");   // retain element (guards skip literals/SSO/null)
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lmscs_copy\n");
    s = s.write(".Lmscs_done:\n");
    s = s.write("    movq %r13, %rax\n");           // return dest
    s = s.write("    addq $8, %rsp\n");             // drop align pad
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_snapshot_col_str, .-__fern_map_snapshot_col_str\n");

    // __fern_map_set (transcribed from asm.fern for the IR map path).
    s = s.write(".globl __fern_map_set\n");
    s = s.write(".type __fern_map_set, @function\n");
    s = s.write("__fern_map_set:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r14\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    pushq %r8\n");                 // saved struct eq fn ptr @ -48(%rbp), or 0
    // %r9 = per-insert flag bits (bit 0 = kconsume: the incoming KEY is a
    // fresh, sole-owned string temp, from irlower's is_fresh_str_temp; bit 1 =
    // owncols: i32/string-column map whose keys()/values() reads ALL snapshot,
    // so the map solely owns its column buffers — #4353/#5335). Saved to the frame
    // because the probe loop's __fern_str_eq / eq-fn calls clobber caller-saved
    // %r9; bit 0 is reloaded at .Lms_found to free the DISCARDED new key on an
    // overwrite (the register twin of the wasm #4876 fix — a recurring computed
    // key, e.g. word-count `m.set(word, n)`, otherwise leaks one key box per
    // overwrite); bit 1 is reloaded at .Lms_append to pick the reclaim-on-grow
    // __fern_arr_push_owned over the leak-only __fern_arr_push.
    // The extra pad keeps the frame 16-byte aligned for the inner calls.
    s = s.write("    pushq %r9\n");                 // saved flag bits @ -56(%rbp)
    s = s.write("    pushq %r9\n");                 // 16-byte align pad @ -64(%rbp)
    s = s.write("    movq %rdi, %r12\n");          // mapbox
    s = s.write("    movq %rsi, %r13\n");          // key
    s = s.write("    movq %rdx, %r14\n");          // val
    s = s.write("    movq (%r12), %r15\n");        // keys arr
    s = s.write("    movq $0, %rbx\n");            // i
    s = s.write("    testq %r8, %r8\n");            // struct/enum key? (eq fn present)
    s = s.write("    jnz .Lms_loop_struct\n");
    s = s.write("    testq %rcx, %rcx\n");          // keykind (1 = i32)
    s = s.write("    jnz .Lms_loop_i32\n");
    s = s.write("    jmp .Lms_loop\n");            // string case skips the struct loop below
    s = s.write(".Lms_loop_struct:\n");            // struct/enum-key loop: derived eq via call *
    s = s.write("    movq (%r15), %rax\n");        // keys.len
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lms_append\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rcx\n");  // keys[i+1] = self
    s = s.write("    pushq %r13\n");               // arg1 = other (lookup key); stack ABI
    s = s.write("    pushq %rcx\n");               // arg0 = self (on top, at 16(%rbp))
    s = s.write("    call *-48(%rbp)\n");          // __fn_<K>__eq(self, other) -> bool
    s = s.write("    addq $16, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lms_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lms_loop_struct\n");
    s = s.write(".Lms_loop:\n");                    // string-key loop
    s = s.write("    movq (%r15), %rax\n");        // keys.len
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lms_append\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdi\n");  // keys[i+1]
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_eq\n    addq $16, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lms_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lms_loop\n");
    s = s.write(".Lms_loop_i32:\n");                // i32-key loop
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lms_append\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rax\n");   // keys[i+1]
    s = s.write("    cmpq %r13, %rax\n");
    s = s.write("    je .Lms_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lms_loop_i32\n");
    s = s.write(".Lms_found:\n");
    s = s.write("    movq 8(%r12), %rax\n");        // values arr
    s = s.write("    movq %rbx, %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq %r14, (%rax,%rdx,8)\n");  // values[i+1] = val
    // Overwrite keeps the EXISTING key; the incoming key %r13 is discarded. When
    // it is a fresh sole-owned temp (kconsume), free it via the rc-aware
    // __fern_str_free (a literal's .rodata data / an aliased rc>1 key are handled
    // safely by str_free's guards) so a recurring computed key doesn't leak. An
    // aliased key (kconsume 0) is left untouched — its source local's sweep owns
    // it. str_free preserves %r12/%r13, so the mapbox return is intact.
    s = s.write("    movq -56(%rbp), %rax\n");      // reload flag bits
    s = s.write("    testq $1, %rax\n");            // bit 0 = kconsume
    s = s.write("    jz .Lms_found_nokf\n");
    s = s.write("    pushq %r13\n");                // discarded fresh key
    s = s.write("    call __fn___fern_str_free\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write(".Lms_found_nokf:\n");
    s = s.write("    jmp .Lms_ret\n");
    s = s.write(".Lms_append:\n");
    // owncols (flag bit 1, #4353/#5335): a map whose columns ALL snapshot on
    // read — i32 columns via __fern_map_snapshot_col (kinds 131/132 flag 0),
    // string columns via __fern_map_snapshot_col_str (flag 2) — is the sole
    // owner of its column buffers, so route the appends through the
    // reclaim-on-grow __fern_arr_push_owned (frees the superseded rc==1
    // buffer, closing the cap-0 grow-leak #4877). Flag-1 alias columns
    // (i64/f64/struct/generic view) keep the LEAK-ONLY __fern_arr_push: their
    // keys()/values() still return the RAW keys@0 / vals@8 buffer (an
    // uncounted alias), and arr_push_owned would free the buffer a live
    // `var vs = m.values()` still points to (use-after-free).
    s = s.write("    movq -56(%rbp), %rax\n");      // reload flag bits
    s = s.write("    testq $2, %rax\n");            // bit 1 = owncols
    s = s.write("    jnz .Lms_append_owned\n");
    s = s.write("    movq (%r12), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    call __fern_arr_push\n");      // keys.append(key)
    s = s.write("    movq %rax, (%r12)\n");
    s = s.write("    movq 8(%r12), %rdi\n");
    s = s.write("    movq %r14, %rsi\n");
    s = s.write("    call __fern_arr_push\n");      // values.append(val)
    s = s.write("    movq %rax, 8(%r12)\n");
    s = s.write("    jmp .Lms_ret\n");
    s = s.write(".Lms_append_owned:\n");
    s = s.write("    movq (%r12), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    call __fern_arr_push_owned\n"); // keys.append(key), frees old buffer on grow
    s = s.write("    movq %rax, (%r12)\n");
    s = s.write("    movq 8(%r12), %rdi\n");
    s = s.write("    movq %r14, %rsi\n");
    s = s.write("    call __fern_arr_push_owned\n"); // values.append(val), frees old buffer on grow
    s = s.write("    movq %rax, 8(%r12)\n");
    s = s.write(".Lms_ret:\n");
    s = s.write("    movq %r12, %rax\n");
    s = s.write("    addq $24, %rsp\n");            // discard align pad + saved kconsume + eq fn ptr
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_set, .-__fern_map_set\n");
    // __fern_map_get + __fern_map_has (transcribed from asm.fern).
    s = s.write(".globl __fern_map_get\n");
    s = s.write(".type __fern_map_get, @function\n");
    s = s.write("__fern_map_get:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    pushq %r8\n");                 // saved struct eq fn ptr @ -40(%rbp), or 0
    s = s.write("    movq %rdi, %r12\n");          // mapbox
    s = s.write("    movq %rsi, %r13\n");          // key
    s = s.write("    movq (%r12), %r15\n");        // keys arr
    s = s.write("    movq $0, %rbx\n");
    s = s.write("    testq %r8, %r8\n");            // struct/enum key? (eq fn present)
    s = s.write("    jnz .Lmg_loop_struct\n");
    s = s.write("    testq %rdx, %rdx\n");          // keykind (1 = i32)
    s = s.write("    jnz .Lmg_loop_i32\n");
    s = s.write("    jmp .Lmg_loop\n");            // string case skips the struct loop below
    s = s.write(".Lmg_loop_struct:\n");            // struct/enum-key loop: derived eq via call *
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmg_none\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rcx\n");  // keys[i+1] = self
    s = s.write("    pushq %r13\n");               // arg1 = other (lookup key); stack ABI
    s = s.write("    pushq %rcx\n");               // arg0 = self (on top, at 16(%rbp))
    s = s.write("    call *-40(%rbp)\n");          // __fn_<K>__eq(self, other) -> bool
    s = s.write("    addq $16, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lmg_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmg_loop_struct\n");
    s = s.write(".Lmg_loop:\n");                    // string-key loop
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmg_none\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_eq\n    addq $16, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lmg_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmg_loop\n");
    s = s.write(".Lmg_loop_i32:\n");                // i32-key loop
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmg_none\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rax\n");
    s = s.write("    cmpq %r13, %rax\n");
    s = s.write("    je .Lmg_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmg_loop_i32\n");
    s = s.write(".Lmg_found:\n");
    s = s.write("    movq 8(%r12), %rax\n");        // values arr
    s = s.write("    movq %rbx, %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq (%rax,%rdx,8), %r13\n");   // values[i+1]
    s = s.write("    movq $16, %rdi\n");
    s = s.write("    call __fern_alloc\n");          // Some box
    s = s.write("    movq $0, (%rax)\n");
    s = s.write("    movq %r13, 8(%rax)\n");
    s = s.write("    jmp .Lmg_ret\n");
    s = s.write(".Lmg_none:\n");
    s = s.write("    movq $16, %rdi\n");
    s = s.write("    call __fern_alloc\n");          // None box
    s = s.write("    movq $1, (%rax)\n");
    s = s.write(".Lmg_ret:\n");
    s = s.write("    addq $8, %rsp\n");             // discard saved eq fn ptr
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_get, .-__fern_map_get\n");
    s = s.write(".globl __fern_map_has\n");
    s = s.write(".type __fern_map_has, @function\n");
    s = s.write("__fern_map_has:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    pushq %r8\n");                 // saved struct eq fn ptr @ -40(%rbp), or 0
    s = s.write("    movq %rdi, %r12\n");
    s = s.write("    movq %rsi, %r13\n");
    s = s.write("    movq (%r12), %r15\n");
    s = s.write("    movq $0, %rbx\n");
    s = s.write("    testq %r8, %r8\n");            // struct/enum key? (eq fn present)
    s = s.write("    jnz .Lmh_loop_struct\n");
    s = s.write("    testq %rdx, %rdx\n");          // keykind (1 = i32)
    s = s.write("    jnz .Lmh_loop_i32\n");
    s = s.write("    jmp .Lmh_loop\n");            // string case skips the struct loop below
    s = s.write(".Lmh_loop_struct:\n");            // struct/enum-key loop: derived eq via call *
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmh_no\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rcx\n");  // keys[i+1] = self
    s = s.write("    pushq %r13\n");               // arg1 = other (lookup key); stack ABI
    s = s.write("    pushq %rcx\n");               // arg0 = self (on top, at 16(%rbp))
    s = s.write("    call *-40(%rbp)\n");          // __fn_<K>__eq(self, other) -> bool
    s = s.write("    addq $16, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lmh_yes\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmh_loop_struct\n");
    s = s.write(".Lmh_loop:\n");                    // string-key loop
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmh_no\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_eq\n    addq $16, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lmh_yes\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmh_loop\n");
    s = s.write(".Lmh_loop_i32:\n");                // i32-key loop
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmh_no\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rax\n");
    s = s.write("    cmpq %r13, %rax\n");
    s = s.write("    je .Lmh_yes\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmh_loop_i32\n");
    s = s.write(".Lmh_yes:\n");
    s = s.write("    movq $1, %rax\n");
    s = s.write("    jmp .Lmh_ret\n");
    s = s.write(".Lmh_no:\n");
    s = s.write("    movq $0, %rax\n");
    s = s.write(".Lmh_ret:\n");
    s = s.write("    addq $8, %rsp\n");             // discard saved eq fn ptr
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_has, .-__fern_map_has\n");
    // __fern_map_delete (transcribed from asm.fern) — `m.without(k)`. Mutates the
    // parallel keys[]/values[] in place (order-preserving left-shift over the hit
    // slot, both lengths decremented) and returns a 2-slot tuple [mapbox, existed].
    s = s.write(".globl __fern_map_delete\n");
    s = s.write(".type __fern_map_delete, @function\n");
    s = s.write("__fern_map_delete:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r14\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    pushq %r8\n");                 // saved struct eq fn ptr @ -48(%rbp), or 0
    s = s.write("    movq %rdi, %r12\n");
    s = s.write("    movq %rsi, %r13\n");
    s = s.write("    movq %rdx, %r14\n");
    s = s.write("    movq (%r12), %r15\n");
    s = s.write("    movq $0, %rbx\n");
    s = s.write("    testq %r8, %r8\n");            // struct/enum key? (eq fn present)
    s = s.write("    jnz .Lmd_loop_struct\n");
    s = s.write("    testq %r14, %r14\n");
    s = s.write("    jnz .Lmd_loop_i32\n");
    s = s.write("    jmp .Lmd_loop\n");            // string case skips the struct loop below
    s = s.write(".Lmd_loop_struct:\n");            // struct/enum-key loop: derived eq via call *
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmd_notfound\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rcx\n");  // keys[i+1] = self
    s = s.write("    pushq %r13\n");               // arg1 = other (lookup key); stack ABI
    s = s.write("    pushq %rcx\n");               // arg0 = self (on top, at 16(%rbp))
    s = s.write("    call *-48(%rbp)\n");          // __fn_<K>__eq(self, other) -> bool
    s = s.write("    addq $16, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lmd_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmd_loop_struct\n");
    s = s.write(".Lmd_loop:\n");
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmd_notfound\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_eq\n    addq $16, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lmd_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmd_loop\n");
    s = s.write(".Lmd_loop_i32:\n");
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmd_notfound\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rax\n");
    s = s.write("    cmpq %r13, %rax\n");
    s = s.write("    je .Lmd_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmd_loop_i32\n");
    s = s.write(".Lmd_found:\n");
    s = s.write("    movq (%r12), %r15\n");
    s = s.write("    movq (%r15), %r14\n");
    s = s.write("    movq %rbx, %rcx\n");
    s = s.write(".Lmd_kshift:\n");
    s = s.write("    movq %r14, %rax\n");
    s = s.write("    decq %rax\n");
    s = s.write("    cmpq %rax, %rcx\n");
    s = s.write("    jge .Lmd_kdone\n");
    s = s.write("    movq %rcx, %rax\n");
    s = s.write("    addq $2, %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdx\n");
    s = s.write("    movq %rcx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq %rdx, (%r15,%rax,8)\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lmd_kshift\n");
    s = s.write(".Lmd_kdone:\n");
    s = s.write("    movq %r14, %rax\n");
    s = s.write("    decq %rax\n");
    s = s.write("    movq %rax, (%r15)\n");
    s = s.write("    movq 8(%r12), %r15\n");
    s = s.write("    movq %rbx, %rcx\n");
    s = s.write(".Lmd_vshift:\n");
    s = s.write("    movq %r14, %rax\n");
    s = s.write("    decq %rax\n");
    s = s.write("    cmpq %rax, %rcx\n");
    s = s.write("    jge .Lmd_vdone\n");
    s = s.write("    movq %rcx, %rax\n");
    s = s.write("    addq $2, %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdx\n");
    s = s.write("    movq %rcx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq %rdx, (%r15,%rax,8)\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lmd_vshift\n");
    s = s.write(".Lmd_vdone:\n");
    s = s.write("    movq %r14, %rax\n");
    s = s.write("    decq %rax\n");
    s = s.write("    movq %rax, (%r15)\n");
    s = s.write("    movq $1, %r13\n");
    s = s.write("    jmp .Lmd_build\n");
    s = s.write(".Lmd_notfound:\n");
    s = s.write("    movq $0, %r13\n");
    s = s.write(".Lmd_build:\n");
    s = s.write("    movq $16, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq %r12, (%rax)\n");
    s = s.write("    movq %r13, 8(%rax)\n");
    s = s.write("    addq $8, %rsp\n");             // discard saved eq fn ptr
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_delete, .-__fern_map_delete\n");
    }

    // __fern_i32_to_string is now a Fern runtime function (#2649): emitted
    // entry-only via emit_ir_runtime_fern_fn (lowered through the IR pipeline as
    // __fn___fern_i32_to_string, using the raw-memory intrinsics), not a
    // hand-written body here. See the emit_ir_runtime_fern_fn call in
    // emit_module_ir_unit's entry block.

    // __fern_str_to_i32 is now a Fern runtime function (#2649): emitted entry-
    // only via emit_ir_runtime_fern_fn (lowered through the IR pipeline as
    // __fn___fern_str_to_i32), not a hand-written stack-arg wrapper here. See
    // the emit_ir_runtime_fern_fn call in emit_module_ir_unit's entry block.

    // __fern_chr is now a Fern runtime function (#2649): see asmcore.rt_src_chr,
    // lowered through the IR pipeline via emit_ir_runtime_fern_fn in the entry
    // block (using the raw-memory intrinsics). No longer hand-rolled here.

    // No static `.bss` heap reservation: the arena is mmap'd lazily on the
    // first __fern_alloc call (see the .bss block + __fern_alloc above), so
    // the binary is linker-agnostic (issue #4081). Mirrors what the retired x86 AST emitter did.
    return s;
}

// all_eligible reports whether every function in the module is IR-eligible
// AND every direct call targets a function defined in the module (or an IR
// runtime helper). A call to a BUILTIN (read_int / print_int / chr /
// i32_to_string / ...) lowers to call_direct but has no `__fn_<name>` body —
// the IR path can't emit it, so such a module is REFUSED. There is no fallback
// emitter behind this — a bail is a diagnostic, not a routing decision — so a
// builtin reaching here is a gap to close in lowering.
// eligible_core is the target-independent eligibility check: a non-empty module
// with a `main` where every function is ir_eligible, every direct call targets a
// known function, and every function-VALUE reference (const_func) names a real
// module function. It ALLOWS plain function values (const_func / call_indirect) —
// the wasm backend lowers them (a funcref table). all_eligible adds the
// register-backend restriction on top (they don't emit the closure ops yet).
pub function eligible_core(mod: parser.Module): boolean {
    var none: string[] = [];
    return eligible_core_known(mod, none);
}

// eligible_core_known is eligible_core threaded with the program-wide
// known-symbol set (`known`) — the per-module-compilation foundation
// (#3451 step 1 / #3453). `known` is the set of function symbols defined
// SOMEWHERE in the loaded import graph (every module's `__fn_*`), distinct from
// "defined in THIS module" (module_has_func). Per-module, a call from module A
// to an imported function in B targets `B__foo`, which is not in A's own
// `mod.funcs` but IS in the program-wide set; eligibility must accept it as an
// extern (resolved at link) instead of bailing the module to AST. Passing an
// empty `known` recovers the whole-program merged behaviour exactly (every
// cross-module call is already local in the merged module), so the merged path
// is byte-for-byte unchanged.
pub function eligible_core_known(mod: parser.Module, known: string[]): boolean {
    return eligible_core_known_impl(mod, known);
}

// all_eligible_lib_known is the per-module LIBRARY eligibility check (#3456): a
// non-entry unit legitimately has no `main` (it exposes only its `__fn_*`
// definitions; the entry owns `_start`/`__fn_main`). It is now IDENTICAL to
// eligible_core_known: the former require_main gate is gone, because the entry
// emitter handles a main-less module by exiting 0 from `_start` instead of
// calling a __fn_main that does not exist. Kept as a named alias because the
// per-module call sites read better for it, and because "is this unit a library?"
// may well need to mean something again.
pub function all_eligible_lib_known(mod: parser.Module, known: string[]): boolean {
    return eligible_core_known_impl(mod, known);
}

// all_eligible_lib_known_view is all_eligible_lib_known with the WHOLE-PROGRAM
// func/struct view threaded in (#3451): a per-module library unit whose
// functions touch a sibling module's struct layout lowers in the gate exactly as
// emit_module_funcs lowers it (against all_structs), instead of bailing because
// the imported struct is absent from `mod.structs`. Use this — not the bare
// all_eligible_lib_known — to gate a per-module emit driven off
// flatten.bundle_per_module.
pub function all_eligible_lib_known_view(mod: parser.Module, known: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[]): boolean {
    return eligible_core_known_view_impl(mod, known, all_funcs, all_structs);
}

// eligible_core_known_impl is the shared body. It used to take a `require_main`
// flag — true for the whole-program / entry path, false for a per-module library
// unit — but the distinction is gone: emit_module_ir_unit's `_start` exits 0 for a
// main-less module instead of calling a __fn_main that does not exist, so BOTH
// callers want the same answer. The flag and its two `has_main` checks are
// deleted rather than left inert (#3457 slice 5).
pub function eligible_core_known_impl(mod: parser.Module, known: string[]): boolean {
    if (mod.funcs.len() == 0) { return false; }
    // The 512-function module-size budget is GONE (#3457). It existed because
    // emit_module_ir's per-function ir.Op lists grow past the runtime's 2048 B
    // "large" freelist tier, and that tier did not recycle — so a merged
    // ~1000-function bundle leaked enough to march the bump heap into exit-137
    // (#3425). Its own comment said "until the native large-tier freelist is
    // fixed"; that is done (ported to the self-host runtime, x86 #5609 / arm64
    // #5614, with the per-module fixpoint green), so the precondition is met.
    //
    // Removing it is not just cleanup. Since #5972 deleted the AST emitters the
    // budget stopped being a FALLBACK and became a WALL: a >512-function
    // whole-program module was simply uncompilable on the register backends
    // ("module is not IR-eligible; the AST emitter is no longer reachable"). It
    // is also the last thing keeping the merged whole-compiler bundle off the IR
    // path, which is what the wasm AST emitter's retirement needs.
    // Per-function eligibility lowers fd ONCE and runs all three checks (body
    // lowers / calls-only-known / const-funcs-only-known) on that single
    // LowerResult, rather than re-lowering it three times (ir_eligible +
    // calls_only_known + const_funcs_only_known each lowered independently). On a
    // large all-eligible module the per-function `LowerResult.ops` is retained
    // (the native catch-all dec only decrements, never frees — #3425), so three
    // lowerings per function held ~3x the ops; this single pass + emit_module_ir's
    // own pass keeps the eligibility-check + emit live set to ~2x instead of ~4x.
    // Derived ONCE here and threaded into every func_eligible. Deriving them per
    // call (as calling lower_func_for would) makes this loop O(n^2): on the
    // large self-host modules that quadratic allocation churned the bump heap
    // hard enough to corrupt it, crashing the self-host-emitted compiler during
    // its OWN eligibility pass (#3425). Once is byte-identical, at O(n).
    var sg: irlower.FnSigs = irlower.fn_sigs_without_ownership(
        irlower.fn_sigs_of(mod.funcs, mod.structs, array_ret_fns(mod)));
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (!func_eligible(mod.funcs[i], mod, mod.structs, known, sg)) {
            if (strict_ir_on()) { strict_ir_refuse(mod.funcs[i].name); }
            return false;
        }
        i = i + 1;
    }
    return true;
}

// strict_ir_on reports whether FERN_STRICT_IR is set (#5646). The IR lowerer's
// bail-to-AST path is only SAFE when the AST emitter can express the construct;
// when it cannot, the fallback emits wrong code rather than failing, and nothing
// notices until a differential test disagrees at a runtime exit code — #5642 cost
// 46 failing subtests that looked like several unrelated bugs but were one
// unlowerable operator handed to a backend that does not know it. With this set,
// a bail is a hard error naming what bailed instead of a silent fall-through, so
// a newly-unsupported construct fails AT the bail. Off by default: the fallback is
// still legitimate for constructs the AST emitter genuinely handles.
function strict_ir_on(): boolean {
    match (env("FERN_STRICT_IR")) {
        Some(_) => { return true; },
        None => { return false; }
    }
}

// strict_ir_refuse reports an IR bail as a hard error and exits. Called only when
// strict_ir_on(); `what` names the function (or module-level gate) that bailed.
function strict_ir_refuse(what: string): i32 {
    eprint("FERN_STRICT_IR: " + what + " — the IR path bailed to the AST emitter; strict mode refuses the silent fall-through (#5646)\n");
    exit(3);
    return 0;
}

// eligible_core_known_main_view is the per-module twin of
// eligible_core_known_main (#3451 — retiring the AST fallback for the bootstrap
// self-compile). Where eligible_core_known_main derives its lowering side-tables
// and struct layouts from the module's OWN funcs/structs — correct for the
// merged whole-program path, where `mod` already holds every decl — a per-module
// LIBRARY unit's `mod` is one module of the program. A function in it that calls
// a sibling module's function (resolved via `known`, an extern at link) OR
// touches a sibling module's STRUCT layout must lower in the gate exactly as it
// does in emit_module_funcs, which lowers every function against the WHOLE-
// PROGRAM `all_funcs` / `all_structs` view (#3454). So this variant mirrors
// emit_module_funcs's derivation precisely: the fourteen return-type side-tables
// + interprocedural borrowability come from `all_funcs`, struct layouts from
// `all_structs`. Without it, every module touching an imported struct (parser →
// lexer.Token, asm → ir.Op, …) fails the gate and bails to AST even though the
// emit would succeed — the central blocker to routing the bootstrap per-module.
//
// Passing all_funcs == mod.funcs and all_structs == mod.structs reproduces
// eligible_core_known_main, modulo the merged path's historical use of
// array_ret_fns / borrowable_params_of (vs the _of / _interproc forms emit
// uses); this variant tracks emit, not that legacy gate, by design.
pub function eligible_core_known_view_impl(mod: parser.Module, known: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[]): boolean {
    if (mod.funcs.len() == 0) { return false; }
    // No 512-function size budget here: a per-module unit is a SINGLE module
    // (the largest, irlower, is ~350 funcs), so the merged-bundle OOM the budget
    // guards against (eligible_core_known_impl) can't arise — each module is
    // emitted in its own process, holding only its own ops live.
    // Side-tables + struct layouts from the WHOLE-PROGRAM view, exactly as
    // emit_module_funcs derives them (array_ret_fns_of / borrowable_params_interproc
    // / *_of from all_funcs, struct_ret_fns_of against all_structs).
    var arf: string[] = array_ret_fns_of(all_funcs);
    var bparams: string[] = irlower.borrowable_params_interproc(all_funcs);
    var sg: irlower.FnSigs = irlower.FnSigs {
        ...irlower.fn_sigs_without_ownership(irlower.fn_sigs_of(all_funcs, all_structs, arf)),
        borrowable_params: bparams,
        // These two stay scoped to THIS module rather than the whole program.
        fn_names: irlower.fn_names_of(mod.funcs),
        closurearr_ret_fns: irlower.closurearr_ret_fns_of(mod.funcs, mod.structs),
    };
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (!func_eligible(mod.funcs[i], mod, all_structs, known, sg)) {
            if (strict_ir_on()) { strict_ir_refuse(mod.funcs[i].name); }
            return false;
        }
        i = i + 1;
    }
    return true;
}

// known_includes reports whether `name` is in the program-wide known-symbol
// set — a function defined SOMEWHERE in the loaded import graph (any module),
// not necessarily in the current one. It is the cross-module twin of
// module_has_func: together they let per-module eligibility admit a call whose
// target is a sibling module's `__fn_*` symbol (resolved at link) while still
// bailing on a truly-unknown / builtin-only name.
function known_includes(known: string[], name: string): boolean {
    var i: i32 = 0;
    while (i < known.len()) {
        if (known[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// func_eligible is eligible_core's per-function check, folded into ONE lowering:
// the body must lower (r.ok), every direct call must target a module function or
// an IR runtime helper (calls_only_known), and every function-value reference
// must name a module function (const_funcs_only_known). Lowering once with the
// real return-type registries (lower_func_for, as ir_eligible does) is at least
// as accurate as the prior noret scan for call / const_func detection — those op
// kinds carry the callee name regardless of return-type tagging — so the module
// verdict is unchanged, at a third of the lowering cost. `arf` (array_ret_fns) is
// hoisted by the caller so it is derived once per module, not once per function —
// as are `clarf` (closurearr_ret_fns_of, a body-walking fixpoint over every
// function) and `fn_names`, for the reason #6011 records: derived HERE they made
// the gate quadratic over body size, and arm64 — whose emit_module_or_error runs
// this gate as a separate pass rather than fusing it into emit like x86's
// emit_module_ir_gated — needed 8.5 GB to compile an empty main importing
// std/array, against x86's 1.5 GB.
function func_eligible(fd: parser.FuncDecl, mod: parser.Module, sview: parser.StructDecl[], known: string[], sg: irlower.FnSigs): boolean {
    // lower_func with the hoisted side-tables (the same set lower_func_for would
    // derive, but computed once by eligible_core — see the hoist note there).
    // `sview` is the struct-decl view lowering resolves field layouts against:
    // the module's own structs for the merged/whole-program path, the WHOLE-
    // PROGRAM struct union for a per-module unit (so a function touching an
    // imported struct's layout lowers in the gate exactly as it does in
    // emit_module_funcs, which already lowers against all_structs).
    var r: irlower.LowerResult = irlower.lower_func(fd, sview, sg, false);
    if (!r.ok) { return false; }
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind_tag == 149) {  // call_direct
            if (!is_fern_helper(o.str) && !is_c_call(o.str) && !module_has_func(mod, o.str) && !known_includes(known, o.str)) { return false; }
        } else if (o.kind_tag == 6) {  // const_func
            if (!module_has_func(mod, o.str) && !known_includes(known, o.str)) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// all_eligible is the module eligibility gate for every backend now: it is
// eligible_core. Plain function values (const_func / call_indirect) lower on all
// three IR backends — wasm through a funcref table, the register backends through
// the function's code address (no table needed). (Capturing lambdas are a later
// slice and still bail via lower_func.)
pub function all_eligible(mod: parser.Module): boolean {
    return eligible_core(mod);
}

// all_eligible_known is all_eligible with the program-wide known-symbol set
// threaded in (#3451 step 1): a module whose only "unknown" direct calls /
// function values target functions defined in a SIBLING module of the loaded
// import set is eligible (those become externs at link), where the bare
// all_eligible would bail it to AST. An empty `known` is identical to
// all_eligible.
pub function all_eligible_known(mod: parser.Module, known: string[]): boolean {
    return eligible_core_known(mod, known);
}

// all_eligible_known_view is all_eligible_known with the WHOLE-PROGRAM
// func/struct view threaded in (#3451): the entry-unit twin of
// all_eligible_lib_known_view (require_main=true — the entry emits `_start` →
// `call __fn_main`). Gates a per-module ENTRY emit against the same all_funcs /
// all_structs view emit_module_ir_unit lowers it with.
pub function all_eligible_known_view(mod: parser.Module, known: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[]): boolean {
    return eligible_core_known_view_impl(mod, known, all_funcs, all_structs);
}

// eligibility_report returns a per-function IR-eligibility breakdown for `mod`:
// one line per function — "<name>: ir" when it lowers AND its direct calls /
// function-value references all resolve, or "<name>: BAIL <reasons>" naming
// which gate(s) failed (`lower` = lower_func bailed the body; `call` = a direct
// call targets a builtin / unknown function; `const_func` = a function-value
// names an unknown function). The final line is the module verdict
// ("module: IR" / "module: AST"), including the no-main / empty-module cases
// all_eligible rejects.
//
// Read-only: it runs exactly the checks eligible_core / all_eligible route on,
// so it observes the real IR-vs-AST frontier the driver uses — without touching
// any emit path. It makes that frontier OBSERVABLE per function, so widening the
// IR subset (goal 1) can see WHICH function, and which category, forces a module
// to the AST fallback, and prove a construct moved onto the IR path.
pub function eligibility_report(mod: parser.Module): string {
    var none: string[] = [];
    return eligibility_report_known(mod, none);
}

// eligibility_report_known is eligibility_report with the program-wide
// known-symbol set threaded in (#3451 step 1): a direct call / function value
// to a sibling module's function reports `ir` (extern, resolved at link)
// instead of `BAIL call` / `BAIL const_func`, and the module verdict reflects
// all_eligible_known. An empty `known` reproduces eligibility_report exactly.
pub function eligibility_report_known(mod: parser.Module, known: string[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        out = out + eligibility_line(mod.funcs[i], mod, known);
        i = i + 1;
    }
    var verdict: string = "module: AST";
    if (all_eligible_known(mod, known)) { verdict = "module: IR"; }
    return out + verdict + "\n";
}

// eligibility_line is the single-function verdict line ("<name>: ir\n" or
// "<name>: BAIL <reasons>\n") shared by eligibility_report and its sharded
// twin. A receiver method is reported as "<Type>.<method>".
function eligibility_line(fd: parser.FuncDecl, mod: parser.Module, known: string[]): string {
    var name: string = fd.name;
    if (fd.receiver_type.len() > 0) { name = util.base_type_name(fd.receiver_type) + "." + fd.name; }
    var lower_ok: boolean = ir_eligible(fd, mod);
    var calls_ok: boolean = calls_only_known(fd, mod, known);
    var cfns_ok: boolean = const_funcs_only_known(fd, mod, known);
    if (lower_ok && calls_ok && cfns_ok) {
        return name + ": ir\n";
    }
    var reasons: string = "";
    if (!lower_ok) { reasons = reasons + " lower"; }
    if (!calls_ok) { reasons = reasons + " call"; }
    if (!cfns_ok) { reasons = reasons + " const_func"; }
    return name + ": BAIL" + reasons + "\n";
}

// eligibility_report_range is the sharded form of eligibility_report: it reports
// only functions [start, start+count) of `mod`, one verdict line each, with NO
// "module:" verdict (that requires re-lowering every function via all_eligible).
// The whole-module report lowers every function up-front and accumulates the ops
// in the bump heap, which exhausts it on the large self-host modules
// (parser / checker / irlower); auditing a slice per process invocation keeps
// each run's live set bounded, so the frontier of those modules stays
// observable. The first shard (start == 0) prefixes a "funcs: <N>\n" header so a
// caller can discover the function count and drive the sharding loop. A start
// past the end yields just that header (or nothing); count <= 0 reports to the
// module end.
pub function eligibility_report_range(mod: parser.Module, start: i32, count: i32): string {
    var out: string = "";
    if (start <= 0) { out = "funcs: " + util.i32_to_string(mod.funcs.len()) + "\n"; }
    var lo: i32 = start;
    if (lo < 0) { lo = 0; }
    var hi: i32 = mod.funcs.len();
    if (count > 0 && lo + count < hi) { hi = lo + count; }
    var i: i32 = lo;
    var none: string[] = [];
    while (i < hi) {
        out = out + eligibility_line(mod.funcs[i], mod, none);
        i = i + 1;
    }
    return out;
}

// const_funcs_only_known reports whether every function-value reference
// (const_func) in fd names a function defined in the module — the function-value
// twin of calls_only_known. A const_func to an unknown name can't resolve to a
// funcref table slot, so such modules fall back to AST.
function const_funcs_only_known(fd: parser.FuncDecl, mod: parser.Module, known: string[]): boolean {
    var r: irlower.LowerResult = irlower.lower_func_for_noret(fd, mod.structs, mod.funcs);
    var i: i32 = 0;
    while (i < r.ops.len()) {
        if (r.ops[i].kind_tag == 6 && !module_has_func(mod, r.ops[i].str) && !known_includes(known, r.ops[i].str)) { return false; }  // const_func
        i = i + 1;
    }
    return true;
}

// module_has_func reports whether `name` is a function defined in the module.
function module_has_func(mod: parser.Module, name: string): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].name == name) { return true; }
        // Method-call form "<Type>.<method>": a receiver function whose base
        // receiver type + name compose to `name` (the irlower dispatch label).
        if (mod.funcs[i].receiver_type.len() > 0) {
            if (util.base_type_name(mod.funcs[i].receiver_type) + "." + mod.funcs[i].name == name) { return true; }
        }
        i = i + 1;
    }
    return false;
}

// calls_only_known reports whether every direct call in fd targets a module
// function or an IR runtime helper (not a builtin).
function calls_only_known(fd: parser.FuncDecl, mod: parser.Module, known: string[]): boolean {
    var r: irlower.LowerResult = irlower.lower_func_for_noret(fd, mod.structs, mod.funcs);
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind_tag == 149) {  // call_direct
            if (!is_fern_helper(o.str) && !is_c_call(o.str) && !module_has_func(mod, o.str) && !known_includes(known, o.str)) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// ir_bin_asm renders the asm for one IR binary op (lhs in %rax, rhs in %rcx,
// result in %rax) — mirroring asm.fern's own ExprBinary sequences (64-bit,
// signed i32 div/cmp) so the two paths agree exactly.
function ir_bin_asm(tag: i32, width: i32): string {
    if (tag == 21) { return "    addq %rcx, %rax\n"; }
    if (tag == 22) { return "    subq %rcx, %rax\n"; }
    if (tag == 23) { return "    imulq %rcx, %rax\n"; }
    // div_s / rem_s / div_u / rem_u are NOT handled here — the op loop routes
    // them through ir_div_guarded (below) so a divide-by-zero / INT_MIN/-1 does
    // not raise #DE. The language contract is total, never-trapping (#4329).
    if (tag == 28) { return "    andq %rcx, %rax\n"; }
    if (tag == 29) { return "    orq %rcx, %rax\n"; }
    if (tag == 30) { return "    xorq %rcx, %rax\n"; }
    // Shift counts mask to the operand width: mod 64 for i64 (the q-form masks
    // %cl to 6 bits in hardware), mod 32 for i32/u32. A 32-bit i32 shift used
    // to emit the q-form, so a count >= 32 wrapped mod 64 instead of mod 32
    // (#4330). Fix by masking the count to 5 bits BUT keeping the 64-bit shift
    // instruction, so the operand's slot extension is preserved: a u32 value is
    // zero-extended (bit 63 = 0) and an i32 value sign-extended (bit 63 = bit
    // 31), and `sarq`/`shrq`/`shlq` on the full register does the right thing for
    // both. (A 32-bit `sarl` would fill from bit 31, corrupting a u32 `>>` —
    // which lowers through shr_s — whose bit 31 is a data bit, not a sign bit.)
    if (width == 64) {
        if (tag == 31) { return "    shlq %cl, %rax\n"; }
        if (tag == 32) { return "    sarq %cl, %rax\n"; }
        if (tag == 33) { return "    shrq %cl, %rax\n"; }
    }
    if (tag == 31) { return "    andl $31, %ecx\n    shlq %cl, %rax\n"; }
    if (tag == 32) { return "    andl $31, %ecx\n    sarq %cl, %rax\n"; }
    if (tag == 33) { return "    andl $31, %ecx\n    shrq %cl, %rax\n"; }
    if (tag == 35) { return "    cmpq %rcx, %rax\n    sete %al\n    movzbq %al, %rax\n"; }
    if (tag == 36) { return "    cmpq %rcx, %rax\n    setne %al\n    movzbq %al, %rax\n"; }
    if (tag == 37) { return "    cmpq %rcx, %rax\n    setl %al\n    movzbq %al, %rax\n"; }
    if (tag == 38) { return "    cmpq %rcx, %rax\n    setle %al\n    movzbq %al, %rax\n"; }
    if (tag == 39) { return "    cmpq %rcx, %rax\n    setg %al\n    movzbq %al, %rax\n"; }
    if (tag == 40) { return "    cmpq %rcx, %rax\n    setge %al\n    movzbq %al, %rax\n"; }
    // Unsigned 64-bit compares (u64, #2904): same cmpq, but the below/above
    // setcc family reads CF instead of SF/OF — correct once bit 63 is set.
    if (tag == 41) { return "    cmpq %rcx, %rax\n    setb %al\n    movzbq %al, %rax\n"; }
    if (tag == 42) { return "    cmpq %rcx, %rax\n    setbe %al\n    movzbq %al, %rax\n"; }
    if (tag == 43) { return "    cmpq %rcx, %rax\n    seta %al\n    movzbq %al, %rax\n"; }
    if (tag == 44) { return "    cmpq %rcx, %rax\n    setae %al\n    movzbq %al, %rax\n"; }
    return "    # ir: unsupported bin " + ir.kind_name(tag) + "\n";
}

// ir_div_guarded renders a non-trapping i32/i64 signed/unsigned div or rem
// (dividend in %rax, divisor in %rcx, result in %rax). x86 idivq/divq raise
// #DE (SIGFPE) on a zero divisor and on INT_MIN/-1 overflow, but the language
// contract (docs/INTEGER-SEMANTICS.md) is total: x/0 = 0, x%0 = x,
// INT_MIN/-1 = INT_MIN, INT_MIN%-1 = 0. Guard both faults inline, mirroring
// native codegen (internal/codegen/x86_64 emitFloatToIntSat's div sibling).
// `lb` is a per-op-unique label base (loop prefix + op index). (#4329)
function ir_div_guarded(tag: i32, width: i32, lb: string): string {
    var sext: boolean = (width != 64);
    if (tag == 25 || tag == 27) {
        // Unsigned (u32/u64, #2904): only the divide-by-zero fault to guard —
        // unsigned division has no overflow case.
        var u: string = "    testq %rcx, %rcx\n";
        if (tag == 25) {
            u = u + "    jz " + lb + "_dz\n";
            u = u + "    xorl %edx, %edx\n    divq %rcx\n";
            u = u + "    jmp " + lb + "_dn\n";
            u = u + lb + "_dz:\n    xorl %eax, %eax\n";
            u = u + lb + "_dn:\n";
        } else {
            u = u + "    jz " + lb + "_dn\n";      // divisor 0 -> rem = dividend (rax)
            u = u + "    xorl %edx, %edx\n    divq %rcx\n    movq %rdx, %rax\n";
            u = u + lb + "_dn:\n";
        }
        return u;
    }
    // Signed. Sign-extend i32 operands so dirty upper bits don't skew idivq.
    var s: string = "";
    if (sext) { s = s + "    movslq %eax, %rax\n    movslq %ecx, %rcx\n"; }
    s = s + "    testq %rcx, %rcx\n";
    if (tag == 24) {
        s = s + "    jz " + lb + "_dz\n";                          // /0 -> 0
        s = s + "    cmpq $-1, %rcx\n    je " + lb + "_ng\n";      // /-1 -> -dividend (wraps at INT_MIN)
        s = s + "    cqto\n    idivq %rcx\n";
        s = s + "    jmp " + lb + "_dn\n";
        s = s + lb + "_ng:\n    negq %rax\n    jmp " + lb + "_dn\n";
        s = s + lb + "_dz:\n    xorl %eax, %eax\n";
        s = s + lb + "_dn:\n";
    } else {
        s = s + "    jz " + lb + "_dn\n";                          // %0 -> dividend (rax)
        s = s + "    cmpq $-1, %rcx\n    je " + lb + "_z0\n";      // %-1 -> 0
        s = s + "    cqto\n    idivq %rcx\n    movq %rdx, %rax\n";
        s = s + "    jmp " + lb + "_dn\n";
        s = s + lb + "_z0:\n    xorl %eax, %eax\n";
        s = s + lb + "_dn:\n";
    }
    // Renormalise an i32 result to its width (sign-extend low 32) so
    // INT32_MIN/-1 reads as INT32_MIN, not +2^31, across a slot boundary.
    if (sext) { s = s + "    movslq %eax, %rax\n"; }
    return s;
}

// ir_f2i_sat renders a saturating f64 -> signed integer truncation (operand
// bits on the rt-stack, result on the rt-stack). x86 cvttsd2si is NOT
// saturating — it returns the 0x8000.. "integer indefinite" on NaN/overflow
// and otherwise wraps — but the contract (docs/FLOAT-SEMANTICS.md) is total:
// NaN -> 0, +overflow -> INT_MAX, -overflow -> INT_MIN. Mirror native
// emitFloatToIntSat. `lb` is a per-op-unique label base. width is 32 or 64. (#4332)
function ir_f2i_sat(width: i32, lb: string): string {
    if (width != 64) {
        // i32: clamp the DOUBLE into [INT32_MIN, INT32_MAX] (as f64 bit
        // patterns) so cvttsd2si never hits its sentinel, after an explicit
        // NaN -> 0. minsd/maxsd here are safe because NaN is already handled.
        var s: string = "    popq %rax\n    movq %rax, %xmm0\n";
        s = s + "    ucomisd %xmm0, %xmm0\n    jp " + lb + "_nan\n";
        s = s + "    movabsq $0x41dfffffffc00000, %rcx\n    movq %rcx, %xmm1\n    minsd %xmm1, %xmm0\n";   // INT32_MAX as f64
        s = s + "    movabsq $0xc1e0000000000000, %rcx\n    movq %rcx, %xmm1\n    maxsd %xmm1, %xmm0\n";   // INT32_MIN as f64
        s = s + "    cvttsd2si %xmm0, %eax\n    movslq %eax, %rax\n    jmp " + lb + "_done\n";
        s = s + lb + "_nan:\n    xorl %eax, %eax\n";
        s = s + lb + "_done:\n    pushq %rax\n";
        return s;
    }
    // i64: cvttsd2si is exact for in-range values; only NaN and |x| >= 2^63
    // yield the INT64_MIN sentinel. On the sentinel, disambiguate via x:
    // NaN -> 0, x > 0 -> INT64_MAX, else keep INT64_MIN (also the correct
    // answer for the exact -2^63 input).
    var s64: string = "    popq %rax\n    movq %rax, %xmm0\n    cvttsd2si %xmm0, %rax\n";
    s64 = s64 + "    movabsq $0x8000000000000000, %rcx\n    cmpq %rcx, %rax\n    jne " + lb + "_done\n";
    s64 = s64 + "    ucomisd %xmm0, %xmm0\n    jp " + lb + "_nan\n";
    s64 = s64 + "    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm0\n    jbe " + lb + "_done\n";
    s64 = s64 + "    movabsq $0x7fffffffffffffff, %rax\n    jmp " + lb + "_done\n";
    s64 = s64 + lb + "_nan:\n    xorl %eax, %eax\n";
    s64 = s64 + lb + "_done:\n    pushq %rax\n";
    return s64;
}

// ir_f2u_sat renders a saturating f64 -> UNSIGNED integer truncation (#4332)
// — the unsigned sibling of ir_f2i_sat, mirroring native emitFloatToIntSat's
// unsigned shapes: NaN / x < 0 -> 0, x >= 2^width -> all-ones. `lb` is a
// per-op-unique label base. width is 32 or 64.
function ir_f2u_sat(width: i32, lb: string): string {
    if (width != 64) {
        // u32: convert with 64-bit headroom (rax covers the whole u32 range
        // exactly), then clamp against the ORIGINAL float: x < 0 / NaN -> 0
        // (ucomisd sets CF on less-than AND on unordered, so one jb catches
        // both), x >= 2^32 -> u32::MAX.
        var s: string = "    popq %rax\n    movq %rax, %xmm0\n    cvttsd2si %xmm0, %rax\n";
        s = s + "    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm0\n    jb " + lb + "_zero\n";
        s = s + "    movabsq $0x41f0000000000000, %rcx\n    movq %rcx, %xmm1\n";   // 2^32 as f64
        s = s + "    ucomisd %xmm1, %xmm0\n    jae " + lb + "_max\n    jmp " + lb + "_done\n";
        s = s + lb + "_zero:\n    xorl %eax, %eax\n    jmp " + lb + "_done\n";
        s = s + lb + "_max:\n    movl $0xffffffff, %eax\n";                        // zero-extends into rax
        s = s + lb + "_done:\n    pushq %rax\n";
        return s;
    }
    // u64: cvttsd2si only covers [0, 2^63); for x >= 2^63 convert x - 2^63 and
    // set bit 63 back. The original x is saved in xmm2 (the subtraction
    // mutates xmm0) and the edge clamps compare against it: x < 0 / NaN -> 0,
    // x >= 2^64 -> u64::MAX.
    var u: string = "    popq %rax\n    movq %rax, %xmm0\n    movaps %xmm0, %xmm2\n";
    u = u + "    movabsq $0x43e0000000000000, %rcx\n    movq %rcx, %xmm1\n";       // 2^63 as f64
    u = u + "    ucomisd %xmm1, %xmm0\n    jae " + lb + "_big\n";
    u = u + "    cvttsd2si %xmm0, %rax\n    jmp " + lb + "_sat\n";
    u = u + lb + "_big:\n    subsd %xmm1, %xmm0\n    cvttsd2si %xmm0, %rax\n";
    u = u + "    movabsq $0x8000000000000000, %rcx\n    xorq %rcx, %rax\n";
    u = u + lb + "_sat:\n    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm2\n    jb " + lb + "_zero\n";
    u = u + "    movabsq $0x43f0000000000000, %rcx\n    movq %rcx, %xmm1\n";       // 2^64 as f64
    u = u + "    ucomisd %xmm1, %xmm2\n    jae " + lb + "_umax\n    jmp " + lb + "_done\n";
    u = u + lb + "_zero:\n    xorl %eax, %eax\n    jmp " + lb + "_done\n";
    u = u + lb + "_umax:\n    movq $-1, %rax\n";
    u = u + lb + "_done:\n    pushq %rax\n";
    return u;
}

// br_target resolves a `br d` / `br_if d` at op index `i` to its label: a
// loop scope -> its header label (the loop op's index); a block/if scope ->
// the label at its matching `end`. Uses irlower's nesting scanners — no
// threaded scope-stack state (a self-host-robust formulation; the earlier
// grow-and-overwrite string[] scope arrays mis-ran under the self-hosted
// compiler).
pub function br_target(ops: ir.Op[], lp: string, i: i32, d: i32): string {
    var op: i32 = irlower.enclosing_opener(ops, i, d);
    // No enclosing opener at depth `d` (an unbalanced op stream): resolve to the
    // function-boundary label rather than indexing ops[-1] (an OOB read whose
    // garbage `kind` would fabricate a bogus, possibly-dangling target). The
    // boundary label is defined at the epilogue (see emit_function_via_ir).
    if (op < 0) { return lp + util.i32_to_string(ops.len()); }
    if (ops[op].kind_tag == 153) { return lp + util.i32_to_string(op); }  // loop
    return lp + util.i32_to_string(irlower.find_matching_end(ops, op + 1));
}

// emit_str_op emits one string operand-stack op (the bodies factored out of
// emit_function_via_ir's dispatch — see ir.is_str_op_kind). Each pops its box
// operand(s), calls the matching __fern_str_* runtime, and pushes the result;
// the mark_* needs pull in the helper bodies (emit_ir_runtime / emit_ir_str_search).
// str_lit_label builds the `.rodata` label for string-literal `idx`, honouring
// the per-module namespace (`s.str_ns`): empty → `.S<idx>` (byte-identical to
// the whole-program emitter), non-empty → `.S<ns>_<idx>` so separately-emitted
// modules' string pools don't collide at link (#3451 step 3 / #3455). The SAME
// label is used at the definition site (.rodata) and every `leaq` reference, so
// the box's data pointer resolves within the module.
pub function str_lit_label(s: asmcore.EmitState, idx: i32): string {
    if (s.str_ns.len() == 0) { return ".S" + util.i32_to_string(idx); }
    return ".S" + s.str_ns + "_" + util.i32_to_string(idx);
}

// emit_const_agg_data flushes the unit's static aggregate constants (#6149) as
// GAS `.data` blocks — shared verbatim by the x86-64 and arm64 emitters, which
// have identical box layouts (`[shape_ptr@0, f0@8, …]`, cap at data-16, rc at
// data-8) and identical directives here.
//
// Each block reproduces exactly what `__fern_arr_box(nf+1)` plus the field
// stores would have produced, with ONE difference: the rc word is -1, the
// immortal sentinel every rc entry point already skips. `__fern_rc_inc` and
// `__fern_arr_dec` return early on a negative rc, `__fern_str_free` likewise,
// and `__fern_rc_is_unique` answers 0 — so a shared constant is never freed,
// never refcounted, and never reused in place. The cap word is still written so
// nothing that reads a block's size off data-16 sees garbage, even though the
// sentinel means no free path can reach it.
pub function emit_const_agg_data(s: asmcore.EmitState): asmcore.EmitState {
    return emit_const_agg_data_from(s, 0);
}

// emit_const_agg_data_from writes only the blocks from `first` on — the
// incremental form the runtime-helper emit needs, whose constants are interned
// after the main pool has already been written.
pub function emit_const_agg_data_from(s: asmcore.EmitState, first: i32): asmcore.EmitState {
    if (s.const_aggs.len() <= first) { return s; }
    var st: asmcore.EmitState = s.write("    .section .data\n    .align 8\n");
    var i: i32 = first;
    while (i < st.const_aggs.len()) {
        var e: string = st.const_aggs[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != 124) { bar = bar + 1; }   // 124 = '|'
        var shp: string = e[0 : bar] + "";
        var vals: string[] = ir.const_struct_values(e);
        st = st.write("    .quad " + util.i32_to_string(vals.len() + 1) + "\n");   // cap @ data-16
        st = st.write("    .quad -1\n");                                            // rc  @ data-8 (immortal)
        st = st.write(asmcore.const_agg_label(st, i) + ":\n");
        st = st.write("    .quad " + shp + "\n");
        var vi: i32 = 0;
        while (vi < vals.len()) {
            st = st.write("    .quad " + vals[vi] + "\n");
            vi = vi + 1;
        }
        i = i + 1;
    }
    return st;
}

// ShapeRefOut carries the updated state + the label a shape pointer leaqs.
pub struct ShapeRefOut { state: asmcore.EmitState, label: string }

// shape_ref resolves the label for an enum/struct SHAPE pointer (struct_make /
// variant_is / struct_set_shape / dyn dispatch / downcast). On the whole-program
// path (str_ns == "") a shape is interned as an ordinary string literal — the
// pre-per-module behaviour, byte-identical. Per-module (str_ns != ""), a shape is
// a `.weak` global symbol (shape_sym): the SAME shape referenced in two units
// resolves to ONE linker-merged address, so the pointer-equality shape compare
// (a token constructed in the lexer unit, matched in the parser unit) holds
// across the module boundary. Without this every cross-module enum `match` (e.g.
// the parser matching lexer's token variants) silently fails — the self-build
// miscompile #3451's per-module bootstrap hit.
pub function shape_ref(s: asmcore.EmitState, name: string): ShapeRefOut {
    if (s.str_ns.len() == 0) {
        var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, name);
        return ShapeRefOut { state: lo.state, label: str_lit_label(lo.state, lo.idx) };
    }
    return ShapeRefOut { state: asmcore.add_shape_lit(s, name), label: asmcore.shape_sym(name) };
}

// emit_runtime_globls exports the shared `__fern_*` / `__fn___fern_*` runtime
// entry points `.globl` so a library module's `call __fern_alloc` (etc.) — an
// unresolved extern in that module — links against the single copy the entry
// module emits (#3451 step 3 / #3455). Only the entry calls this (it owns the
// runtime). A `.globl` for a symbol the entry doesn't actually define (its need
// wasn't present) is a harmless UND entry as long as nothing references it; a
// symbol the entry DOES define is exported. This is emitted only in per-module
// mode (globl_defs) — the whole-program emitter never calls it, so its output
// is unchanged.
pub function emit_runtime_globls(s: asmcore.EmitState): asmcore.EmitState {
    var names: string[] = [
        "__fern_alloc", "__fern_alloc_u8", "__fern_arr_box", "__fern_str_box", "__fern_arr_push",
        // array bounds trap (#5410): every unit's arr_get/arr_set emits a
        // `jae __fern_oob_abort`; the entry owns the single definition
        // (emit_ir_runtime's heap block), so export it like the other
        // shared helpers or every library unit dangles at the per-module link.
        "__fern_oob_abort",
        "__fern_arr_push_owned",
        "__fern_arr_slice",
        // xs.reverse() / xs.concat(ys) (#3457): a LIBRARY module's call resolves
        // against the entry module's single definition, exactly like arr_slice.
        "__fern_arr_reverse", "__fern_arr_concat",
        "__fn___fern_str_concat", "__fn___fern_str_eq",
        "__fn___fern_string_from_bytes", "__fn___fern_str_bytes", "__fn___fern_str_chars",
        "__fn___fern_str_lines", "__fn___fern_str_split", "__fn___fern_str_repeat",
        "__fn___fern_str_replace", "__fn___fern_str_reverse", "__fn___fern_str_trim",
        "__fn___fern_str_to_lower", "__fn___fern_str_to_upper", "__fn___fern_str_starts_with",
        "__fn___fern_str_ends_with", "__fn___fern_str_index_of", "__fern_print_str",
        "__fern_print_int", "__fern_eprint_str", "__fern_putchar",
        "__fern_read_int", "__fern_read_line", "__fern_read_file", "__fn___fern_read_file",
        "__fern_reader_read_chunk", "__fern_reader_close", "__fern_write_file", "__fn___fern_write_file",
        "__fern_remove_dir_all", "__fn___fern_remove_dir_all", "__fern_temp_dir", "__fn___fern_temp_dir", "__fern_read_dir", "__fn___fern_read_dir", "__fern_remove_file", "__fn___fern_remove_file",
        "__fern_env", "__fn___fern_env", "__fern_stat", "__fn___fern_stat", "__fern_subprocess",
        "__fern_args", "__fern_arg_at", "__fern_arg_at_rc", "__fern_strbuf_append",
        // #5623: the IR path's whole-stdin reader, emitted in the entry module's
        // runtime — .globl so a per-module sibling's `call` resolves against it.
        "__fern_read_all_stdin",
        "__fern_strbuf_reset", "__fern_strbuf_take", "__fern_random_i32",
        // crash-only supervision (#5686): the entry owns fork / wait4.
        "__fern_proc_fork", "__fern_proc_waitpid", "__fern_proc_exec",
        // __fern_random_bytes: register-ABI symbol kept for the arm64 / AST
        // backends (still hand-asm); the x86-64 IR path defines the Fern-compiled
        // __fn___fern_random_bytes (#2649). Both listed during the transition —
        // a .globl of an undefined symbol is a harmless no-op per backend.
        "__fern_random_bytes", "__fn___fern_random_bytes",
        // clocks (#2649): register-ABI symbols kept for arm64/AST (hand-asm); the
        // x86-64 IR path defines the Fern-compiled __fn___fern_*_ns. Both listed
        // during the transition (a .globl of an undefined symbol is a no-op).
        // (__fern_now_unix_ms is already listed below.)
        "__fern_monotonic_ns", "__fern_now_ns",
        "__fn___fern_monotonic_ns", "__fn___fern_now_ns", "__fn___fern_now_unix_ms",
        "__fern_poll",
        "__fern_timer_fd", "__fern_wasm_timer_pollable", "__fern_wasm_pollable_drop",
        "__fern_wasm_block", "__fern_wasm_poll",
        "__fern_tcp_connect", "__fern_tcp_pollable", "__fern_tcp_close",
        "__fern_tcp_recv", "__fern_tcp_send", "__fern_tcp_listen", "__fern_tcp_accept",
        "__fern_open_fd",
        "__fern_now_unix_ms", "__fern_sleep_ms", "__fern_map_new",
        "__fern_map_set", "__fern_map_get", "__fern_map_has", "__fern_map_delete",
        // scalar / string keys()/values() snapshots (#4353): a library
        // module's kind 131/132 flag-0/flag-2 read calls these; the entry
        // owns the definitions.
        "__fern_map_snapshot_col", "__fern_map_snapshot_col_str",
        "__fn___fern_rc_inc", "__fn___fern_arr_dec", "__fn___fern_rc_is_unique",
        "__fn___fern_alloc_reuse",
        "__fn___fern_rc_underflow_count", "__fn___fern_i32_to_string", "__fn___fern_u32_to_string",
        "__fn___fern_i64_to_string", "__fn___fern_u64_to_string",
        "__fn___fern_str_to_i32", "__fn___fern_str_cmp", "__fn___fern_chr", "__fn___fern_snapshot_dec",
        // string RC reclaim (#2649): a LIBRARY module that reclaims a fresh string
        // (`var b = a + a` → __fern_str_free) references this symbol; the entry
        // owns the single definition (emit_ir_runtime), so export it for the
        // per-module link like every other shared runtime helper.
        "__fn___fern_str_free",
        // string[] ELEMENT reclaim (#4355): a library module whose exit sweep
        // frees a fresh-element string[] references this symbol; the entry owns
        // the single definition (emit_ir_runtime).
        "__fn___fern_str_arr_free",
        // arr-of-arr reclaim (#4355 slice 9): the exit sweep of a module with a
        // fresh arr-of-arr local references these; the entry owns the bodies.
        "__fn___fern_arrarr_free", "__fn___fern_strarrarr_free", "__fn___fern_optarrarr_free",
        // compact base copy (#4650): a LIBRARY module doing `T { ...base, f: v }`
        // on a struct_copy_eligible T emits `call __fn___fern_struct_copy`; the
        // entry owns the single definition (emit_ir_runtime's heap block). Every
        // eligible spread used to sit in the entry, so this went unnoticed until
        // asmcore.synth_script_main spread a `parser.Module` — whose fields are
        // ALL arrays, making it eligible where the string-carrying EmitState /
        // FuncDecl spreads take the inline per-field path and never call out.
        "__fn___fern_struct_copy",
        // i32[] sum / product (#3457): a LIBRARY module calling xs.sum() emits
        // `call __fn___fern_arr_i32_sum`; the entry owns the definition. A
        // registered NEED root is not the same as an exported SYMBOL.
        "__fn___fern_arr_i32_sum", "__fn___fern_arr_i32_product", "__fn___fern_i32_pow",
        "__fn___fern_i32_gcd", "__fn___fern_i32_lcm",
        "__fn___fern_arr_i32_index_of", "__fn___fern_arr_str_index_of",
        "__fn___fern_arr_i32_min_opt", "__fn___fern_arr_i32_max_opt"
    ];
    var i: i32 = 0;
    while (i < names.len()) {
        s = s.write(".globl " + names[i] + "\n");
        i = i + 1;
    }
    return s;
}

function emit_str_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind_tag == 97) {  // str_len
        // pop string box; length is at box+8.
        s = s.write("    popq %rax\n    movq 8(%rax), %rax\n    pushq %rax\n"); return s;
    }
    if (o.kind_tag == 101) {  // str_index
        // pop index (top), string box; box = [data@0, len@8], so the byte is
        // at [data + i]; zero-extend to an i32.
        s = s.write("    popq %rcx\n    popq %rax\n    movq (%rax), %rax\n    movzbl (%rax,%rcx), %eax\n    pushq %rax\n"); return s;
    }
    if (o.kind_tag == 102) {  // str_slice
        // operand stack [src box, start, end] (end on top). Zero-copy view, but now
        // rc-HEADERED with an IMMORTAL sentinel (#2649): a 24-byte box
        // [rc=-1@base, data=src.data+start@base+8, len=end-start@base+16], box=base+8
        // so data@box+0 / len@box+8 are unchanged. The bytes are still SHARED with
        // the source (no copy), so the box must never free them — hence rc=-1, which
        // __fn___fern_str_free skips (immortal) and __fn___fern_rc_inc skips too
        // (`js`/high-bit sentinel). This closes the LAST header-less string producer
        // on the asm IR path: box-8 is now always a valid rc word, so incing a
        // string field that happens to be a slice/trim VIEW (e.g. the struct
        // string-field alias-inc) is a safe no-op instead of clobbering the previous
        // heap block. r12/r13/r14 (callee-saved) hold end/start/src across alloc.
        // Construction-time bounds check (#5419): trap unless
        // 0 <= start <= end <= src len (two unsigned compares) — an oversized
        // `end` otherwise built a view whose bytes extend past the source.
        s = s.write("    popq %r8\n    popq %rcx\n    popq %rdx\n");
        s = s.write("    pushq %r12\n    pushq %r13\n    pushq %r14\n");
        s = s.write("    movq %r8, %r12\n    movq %rcx, %r13\n    movq %rdx, %r14\n");
        s = s.write("    cmpq 8(%r14), %r12\n");   // end > src len (unsigned) → abort
        s = s.write("    ja __fern_oob_abort\n");
        s = s.write("    cmpq %r12, %r13\n");      // start > end (unsigned) → abort
        s = s.write("    ja __fern_oob_abort\n");
        s = s.write("    movq $24, %rdi\n    call __fern_alloc\n");
        s = s.write("    movq $-1, (%rax)\n");
        s = s.write("    movq (%r14), %rcx\n    addq %r13, %rcx\n    movq %rcx, 8(%rax)\n");
        s = s.write("    movq %r12, %rcx\n    subq %r13, %rcx\n    movq %rcx, 16(%rax)\n");
        s = s.write("    addq $8, %rax\n");
        s = s.write("    popq %r14\n    popq %r13\n    popq %r12\n    pushq %rax\n"); return s;
    }
    if (o.kind_tag == 104) {  // str_bytes
        // operand stack [str box]; __fern_str_bytes is a Fern runtime function now
        // (#2649): the box on the stack IS param[0] (at +16 after the call), so call
        // directly, pop the arg, push the result i32[]. mark_str_bytes pulls in
        // arr_push + heap.
        s = s.write("    call __fn___fern_str_bytes\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.mark_str_bytes(); return s;
    }
    if (o.kind_tag == 105) {  // str_split
        // operand stack [haystack box, sep box] (sep on top). Call the
        // Fern-compiled __fn___fern_str_split via the stack ABI: param[0]=haystack
        // on top (+16), param[1]=sep (+24). -> fresh string[] in %rax.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_split\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.mark_str_split(); return s;
    }
    if (o.kind_tag == 106 || o.kind_tag == 107) {  // str_to_upper, str_to_lower
        // operand stack [s box]; __fern_str_to_upper/_lower are Fern runtime
        // functions now (#2649): __fn_ stack convention — s already on the stack IS
        // param[0] (at +16), so call directly, pop the arg, push the result.
        var cfn: string = "__fn___fern_str_to_upper";
        if (o.kind_tag == 107) { cfn = "__fn___fern_str_to_lower"; }  // str_to_lower
        s = s.write("    call " + cfn + "\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.mark_str_case(); return s;
    }
    if (o.kind_tag == 108) {  // str_repeat
        // operand stack [s box, n] (n on top). Call the Fern-compiled
        // __fn___fern_str_repeat via the stack ABI: param[0]=s on top (+16),
        // param[1]=n below (+24). -> fresh string box in %rax.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_repeat\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.mark_str_repeat(); return s;
    }
    if (o.kind_tag == 109) {  // str_trim
        // operand stack [s box]; __fern_str_trim is a Fern runtime function now
        // (#2649): the s box already on the operand stack IS param[0] (at +16
        // after the call), so call directly, pop the arg, push the result.
        s = s.write("    call __fn___fern_str_trim\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.mark_str_trim(); return s;
    }
    if (o.kind_tag == 110) {  // str_reverse
        // operand stack [s box] — the arg IS param[0] (+16). Call the
        // Fern-compiled __fn___fern_str_reverse via the stack ABI -> fresh
        // reversed string box in %rax.
        s = s.write("    call __fn___fern_str_reverse\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.mark_str_reverse(); return s;
    }
    if (o.kind_tag == 111) {  // str_replace
        // operand stack [haystack, old, new] (new on top). Call the Fern-compiled
        // __fn___fern_str_replace via the stack ABI: param[0]=haystack on top
        // (+16), param[1]=old (+24), param[2]=new (+32). -> fresh string box in %rax.
        s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_replace\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.mark_str_replace(); return s;
    }
    if (o.kind_tag == 112) {  // str_chars
        // operand stack [s box]; __fern_str_chars is a Fern runtime function now
        // (#2649): the box on the stack IS param[0] (at +16 after the call), so call
        // directly, pop the arg, push the result string[]. mark_str_chars pulls in
        // arr_push + heap.
        s = s.write("    call __fn___fern_str_chars\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.mark_str_chars(); return s;
    }
    if (o.kind_tag == 113) {  // str_lines
        // operand stack [s box]; __fern_str_lines is a Fern runtime function now
        // (#2649): the s box already on the stack IS param[0] (at +16 after the
        // call), so call directly, pop the arg, push the result string[].
        // mark_str_lines pulls in its str_split + arr_slice + heap deps.
        s = s.write("    call __fn___fern_str_lines\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.mark_str_lines(); return s;
    }
    if (o.kind_tag == 114 || o.kind_tag == 115 || o.kind_tag == 116) {  // str_starts_with, str_ends_with, str_index_of
        // operand stack [s box, p box] (p on top); the str_search predicates are
        // now Fern runtime functions (#2649) called via the __fn_ stack
        // convention — re-push so s=param[0] at +16 and p=param[1] at +24.
        var pfn: string = "__fn___fern_str_starts_with";
        if (o.kind_tag == 115) { pfn = "__fn___fern_str_ends_with"; }  // str_ends_with
        if (o.kind_tag == 116) { pfn = "__fn___fern_str_index_of"; }  // str_index_of
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n    call " + pfn + "\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.mark_str_search(); return s;
    }
    if (o.kind_tag == 98) {  // str_concat
        // operand stack: [box A, box B] (B on top). __fern_str_concat is a Fern
        // runtime function now (#2649): __fn_ stack convention — re-push so A is
        // param[0] at +16 and B is param[1] at +24.
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_concat\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.mark_str_concat(); return s;
    }
    if (o.kind_tag == 99) {  // str_eq
        // operand stack: [box A, box B] (B on top); __fern_str_eq is now a Fern
        // runtime function (#2649) called via the __fn_ stack convention —
        // re-push so A=a is param[0] at +16 and B=b is param[1] at +24.
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_eq\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.mark_str_eq(); return s;
    }
    // str_cmp: operand stack [box A, box B] (B on top); __fern_str_cmp is now a
    // Fern runtime function (#2649) called via the __fn_ stack convention —
    // re-push so A=a is param[0] at +16 and B=b is param[1] at +24.
    s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_cmp\n    addq $16, %rsp\n    pushq %rax\n");
    s = s.mark_str_cmp(); return s;
}

// emit_function_via_ir emits one IR-eligible function via the stack IR,
// writing through the global strbuf (same as asm.fern's emitters).
// arr_ret_fns drives move-on-return / move-from-call for array values.
function emit_function_via_ir(fd: parser.FuncDecl, s: asmcore.EmitState, sg: irlower.FnSigs): asmcore.EmitState {
    var r: irlower.LowerResult = irlower.lower_func(fd, s.struct_decls, sg, false);
    return emit_function_via_ir_pre(r, fd, s);
}

// emit_function_via_ir_pre is the emit half of emit_function_via_ir, split out at
// the lower_func boundary so a caller that has ALREADY lowered `fd` can emit from
// that LowerResult without lowering it a second time (#4394 lever 3 — the fused
// eligible-and-emit path, emit_module_ir_gated, lowers each function once, checks
// eligibility on that `r`, then emits from the same one, replacing the driver's
// former lower-twice: all_eligible_known's gate pass re-lowered every function,
// then emit_module_ir re-lowered every function again). Everything from the
// runtime-need detection onward reads only r / fd / s (none of the eighteen
// side-tables lower_func consumes), so this split is byte-identical to the
// inlined body.
function emit_function_via_ir_pre(r: irlower.LowerResult, fd: parser.FuncDecl, s: asmcore.EmitState): asmcore.EmitState {
    // Runtime-need detection, folded into the per-function lowering the emit loop
    // ALREADY performs. The tail used to re-derive these by re-lowering the WHOLE
    // module twice (module_uses_maps / module_uses_heap, each a full second/third
    // lower_func_for_noret pass over all funcs) — on a large module (the whole
    // self-host compiler, ~1000 funcs) those redundant passes blew the bump heap
    // (#3425: each retained pass's per-function ops pushed peak live set past the
    // ~3.875 GiB ceiling and OOM'd the self-compile). Marking the needs here off
    // the ops we just lowered keeps it to a SINGLE lowering pass; the tail reads
    // the accumulated needs (has_need) instead of re-lowering. Byte-identical
    // output: the runtime is still emitted at the tail gated on the same needs.
    //
    // Read `.kind` off the bound Op struct INLINE rather than via a `var dk:
    // string = ...kind` local: a named string local aliasing a struct field and
    // dec'd at each loop-iteration boundary rides arm64's deferred native heap-
    // string reclamation path (RC-PERCEUS slice 5g), which over-releases under
    // allocation pressure and crashed the arm64-compiled driver. The inline read
    // (matching the op-emission loop below, which never binds `.kind` to its own
    // local) keeps the string a transient the comparison consumes immediately.
    var dop: i32 = 0;
    while (dop < r.ops.len()) {
        var dopop: ir.Op = r.ops[dop];
        if (dopop.kind_tag == 124 || dopop.kind_tag == 125 || dopop.kind_tag == 126) { s = s.need("maps"); }  // map_new, map_set, map_len
        // map_keys / map_values with a SCALAR column (i32_imm 0, #4353) call
        // __fern_map_snapshot_col, which lives in the maps runtime block; a
        // pointer-column read (i32_imm 1) is a raw load and needs nothing.
        if ((dopop.kind_tag == 131 || dopop.kind_tag == 132) && dopop.i32_imm != 1) { s = s.need("maps"); }
        if (ir.op_allocates(dopop.kind_tag)) { s = s.need("heap"); }
        dop = dop + 1;
    }

    // Methods get the receiver-type-qualified label `__fn_<Type>.<name>` (matching
    // asm.fern + irlower's dispatch); free functions stay `__fn_<name>`.
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) { label_name = util.base_type_name(fd.receiver_type) + "." + fd.name; }
    s = s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    var frame: i32 = r.n_locals * 8;
    if (frame % 16 != 0) { frame = frame + 8; }
    if (frame > 0) { s = s.write("    subq $" + util.i32_to_string(frame) + ", %rsp\n"); }

    // Zero-init the body-local slots (Perceus exit-sweep safety, matching
    // asm.fern): a `var` decl skipped on an untaken branch leaves its slot
    // readable by the release sweep, which must see NULL (arr_dec no-ops)
    // rather than stack garbage. Body locals are slots [n_params, n_locals);
    // slot i is at -8*(i+1)(%rbp), so the range's lowest address is
    // -8*n_locals(%rbp) and it holds (n_locals - n_params) quadwords. rep
    // stosq clobbers rax/rcx/rdi, dead here (before the param copy).
    var nbody: i32 = r.n_locals - r.n_params;
    if (nbody > 0) {
        s = s.write("    leaq " + util.i32_to_string(0 - r.n_locals * 8) + "(%rbp), %rdi\n");
        s = s.write("    movq $" + util.i32_to_string(nbody) + ", %rcx\n");
        s = s.write("    xorq %rax, %rax\n");
        s = s.write("    cld\n");
        s = s.write("    rep stosq\n");
    }

    // Copy params from the caller stack into their local slots, exactly as
    // emit_function does: param[i] sits at +(16 + i*8)(%rbp); the IR's
    // load_local i reads -8*(i+1)(%rbp). r.n_params counts the receiver (slot 0)
    // for a method, so the receiver — which the caller passes as arg 0 at
    // +16(%rbp) — copies into slot 0 uniformly with the rest of the params.
    var pidx: i32 = 0;
    while (pidx < r.n_params) {
        s = s.write("    movq " + util.i32_to_string(16 + pidx * 8) + "(%rbp), %rax\n");
        s = s.write("    movq %rax, " + util.i32_to_string(0 - 8 * (pidx + 1)) + "(%rbp)\n");
        pidx = pidx + 1;
    }

    // Structured control flow -> flat labels, derived from OP-STREAM INDICES
    // (no threaded scope stack): the label at op index `j` is `lp<j>`. An `if`
    // jumps to its matching `else` (or `end`); `else`/`loop`/`end` define the
    // label at their own index; `br`/`br_if` resolve via br_target. Branch
    // matching reuses irlower's nesting scanners.
    var lp: string = ".Lir_" + asmcore.sanitize_label(label_name) + "_";
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind_tag == 1) {  // const_i32
            // Zero materialises as `xorl %eax, %eax` (2 bytes) rather than
            // `movq $0, %rax` (7: REX.W + C7 /0 + imm32). Literal zero is
            // everywhere — every source `0`, zero-init and implicit `return 0`
            // — so the 5 bytes compound. Mirrors the native x86-64 backend's
            // OpConstI32 zero case (#4380 lever 2).
            //
            // `xor` clobbers FLAGS where `mov` does not, which is only safe
            // because FLAGS are never live across an IR-op boundary here: each
            // comparison op emits its own cmp + setcc together, so a const
            // materialisation can never sit between a flag-setter and its
            // reader. Do not weaken that invariant without revisiting this.
            if (o.i32_imm == 0) {
                s = s.write("    xorl %eax, %eax\n    pushq %rax\n");
            } else {
                s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rax\n    pushq %rax\n");
            }
        } else if (o.kind_tag == 2) {  // const_i32_text
            // Integer literal source text spliced into a 32-bit immediate (hex /
            // full u32 range) — byte-identical to asm.fern's ExprNumber.
            s = s.write("    movq $" + o.str + ", %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 3) {  // const_i64
            // 64-bit immediate (source text): movabsq handles the full range.
            // i64 add/sub/mul/cmp/bitwise then reuse the existing 64-bit-register
            // bin ops unchanged — only the load differs from i32.
            s = s.write("    movabsq $" + o.str + ", %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 7 || o.kind_tag == 8) {  // int_extend, int_wrap
            // i32<->i64 in 64-bit slots: signed -> sign-extend low 32 (movslq),
            // unsigned -> zero-extend low 32 (movl). Same sequence either way.
            s = s.write("    popq %rax\n");
            if (o.unsigned) { s = s.write("    movl %eax, %eax\n"); }
            else { s = s.write("    movslq %eax, %rax\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind_tag == 10) {  // u32_wrap
            // Reduce to the u32 range (zero-extend low 32) — wraps a u32 arith
            // result at 2^32 on this 64-bit-register backend.
            s = s.write("    popq %rax\n    movl %eax, %eax\n    pushq %rax\n");
        } else if (o.kind_tag == 9) {  // int_cast
            // `x as <ty>` int→int width mask/extend — byte-identical to asm.fern.
            s = s.write("    popq %rax\n");
            if (o.str == "u8") { s = s.write("    andq $255, %rax\n"); }
            else if (o.str == "u32") { s = s.write("    movl %eax, %eax\n"); }
            else if (o.str == "i32") { s = s.write("    movslq %eax, %rax\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind_tag == 92 || o.kind_tag == 94 || o.kind_tag == 95) {  // arr_push, arr_push_i64, arr_push_f64
            // [arr, val] -> grown array. __fern_arr_push(%rdi=arr, %rsi=val). Every
            // array slot is 8 bytes here, so the i64/u64/f64 element rides the SAME
            // helper (the popped operand-stack slot already holds the full 8-byte
            // value); only wasm needs a distinct 8-byte-stride push.
            s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_arr_push\n    pushq %rax\n");
            s = s.mark_arr_push();
        } else if (o.kind_tag == 93) {  // arr_push_owned
            // Sole-owner self-append (irlower's !aliased `a = a.append(v)`):
            // __fern_arr_push_owned reclaims the old buffer on a grow-realloc.
            s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_arr_push_owned\n    pushq %rax\n");
            s = s.mark_arr_push(); s = s.need("arr_push_owned");
        } else if (o.kind_tag == 77) {  // alloc_u8
            // [n] -> fresh n-element array. __fern_alloc_u8(%rdi=n).
            s = s.write("    popq %rdi\n    call __fern_alloc_u8\n    pushq %rax\n");
            s = s.need("heap"); s = s.need("alloc_u8");
        } else if (o.kind_tag == 76) {  // alloc
            // [n] -> bump-alloc n raw bytes, push the usize pointer (core/map's
            // __alloc). __fern_alloc(%rdi=n) is the bare-pointer allocator.
            s = s.write("    popq %rdi\n    call __fern_alloc\n    pushq %rax\n");
            s = s.need("heap");
        } else if (o.kind_tag == 79) {  // ptr_width
            // () -> heap-pointer width in bytes. 8 on x86-64.
            s = s.write("    pushq $8\n");
        } else if (o.kind_tag == 103) {  // str_from_bytes
            // [arr] -> string box packing each slot's low byte. The arg IS
            // param[0] (+16); call the Fern-compiled __fn___fern_string_from_bytes
            // via the stack ABI.
            s = s.write("    call __fn___fern_string_from_bytes\n    addq $8, %rsp\n    pushq %rax\n");
            s = s.need("heap"); s = s.need("str_from_bytes");
        } else if (o.kind_tag == 74) {  // memcpy
            // [dst, src, n] -> copy n bytes src->dst (rep movsb), push dummy 0.
            // n is on top, then src, then dst (the lowering order). Mirrors the
            // AST __memcpy emitter in asm.fern.
            s = s.write("    popq %rcx\n    popq %rsi\n    popq %rdi\n    rep movsb\n    pushq $0\n");
        } else if (o.kind_tag == 75) {  // memset
            // [dst, byte, n] -> fill n bytes at dst with byte's low byte (rep
            // stosb, AL), push dummy 0. n on top, then byte, then dst.
            s = s.write("    popq %rcx\n    popq %rax\n    popq %rdi\n    cld\n    rep stosb\n    pushq $0\n");
        } else if (o.kind_tag == 78) {  // free
            // [ptr, size] -> no-op under the bump/leak heap; drop both, push dummy 0.
            s = s.write("    popq %rax\n    popq %rax\n    pushq $0\n");
        } else if (o.kind_tag == 69) {  // load_i32
            // [addr] -> sign-extended 4-byte load (matches __fn___load_i32).
            s = s.write("    popq %rax\n    movslq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 70 || o.kind_tag == 71) {  // load_i64, load_ptr
            // [addr] -> 8-byte load (ptr is heap-pointer width = 8 on x86-64).
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 72) {  // store_i32
            // [addr, val] -> store low 4 bytes; push dummy 0 (val on top).
            s = s.write("    popq %rcx\n    popq %rax\n    movl %ecx, (%rax)\n    pushq $0\n");
        } else if (o.kind_tag == 73 || o.kind_tag == 199) {  // store_ptr, store_i64
            // [addr, val] -> store 8 bytes; push dummy 0. i64 and heap-pointer
            // are both 8-byte stores on x86-64 (movq), so they share this arm.
            s = s.write("    popq %rcx\n    popq %rax\n    movq %rcx, (%rax)\n    pushq $0\n");
        } else if (o.kind_tag == 18) {  // load_local
            s = s.write("    pushq " + util.i32_to_string(0 - 8 * (o.i32_imm + 1)) + "(%rbp)\n");
        } else if (o.kind_tag == 19) {  // store_local
            s = s.write("    popq %rax\n    movq %rax, " + util.i32_to_string(0 - 8 * (o.i32_imm + 1)) + "(%rbp)\n");
        } else if (o.kind_tag == 34) {  // not
            s = s.write("    popq %rax\n    testq %rax, %rax\n    setz %al\n    movzbq %al, %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 160) {  // return
            s = s.write("    popq %rax\n    leave\n    ret\n");
        } else if (o.kind_tag == 154) {  // if
            // jump to the matching else (if any) or end when the cond is false.
            var elseidx: i32 = irlower.find_matching_else(r.ops, i + 1);
            var tgt: string = "";
            if (elseidx >= 0) { tgt = lp + util.i32_to_string(elseidx); }
            else { tgt = lp + util.i32_to_string(irlower.find_matching_end(r.ops, i + 1)); }
            s = s.write("    popq %rax\n    testq %rax, %rax\n    jz " + tgt + "\n");
        } else if (o.kind_tag == 155) {  // else
            // end of the then-arm jumps past the else; land the false path here.
            s = s.write("    jmp " + lp + util.i32_to_string(irlower.find_matching_end(r.ops, i + 1)) + "\n");
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else if (o.kind_tag == 152) {  // block
            // forward scope: its exit label is defined at the matching `end`.
        } else if (o.kind_tag == 153) {  // loop
            // backward scope: header label, branched to by `br`.
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else if (o.kind_tag == 157) {  // br
            s = s.write("    jmp " + br_target(r.ops, lp, i, o.i32_imm) + "\n");
        } else if (o.kind_tag == 158) {  // brif
            s = s.write("    popq %rax\n    testq %rax, %rax\n    jnz " + br_target(r.ops, lp, i, o.i32_imm) + "\n");
        } else if (o.kind_tag == 87) {  // arr_make
            // n element values on the operand stack (element n-1 on top).
            // asm.fern 8-byte layout via __fern_arr_box: data = base+16, rc=1,
            // len=n, element i at data+(i+1)*8. Pop top-down (element n-1 →
            // slot n .. element 0 → slot 1); base stays live in %rax across the
            // pops (they only touch the operand stack), then push it.
            var n: i32 = o.i32_imm;
            s = s.write("    movq $" + util.i32_to_string(n) + ", %rdi\n");
            s = s.write("    call __fern_arr_box\n");
            var em: i32 = n - 1;
            while (em >= 0) {
                s = s.write("    popq %rcx\n    movq %rcx, " + util.i32_to_string((em + 1) * 8) + "(%rax)\n");
                em = em - 1;
            }
            s = s.write("    pushq %rax\n");
        } else if (o.kind_tag == 88) {  // arr_get
            // pop idx (top), base; element at data+(idx+1)*8. Bounds check first
            // (docs/ARRAY-BOUNDS.md): idx vs the length prefix at data[0]. The
            // UNSIGNED compare catches both idx >= len and a negative idx (which
            // reads as a huge unsigned) with one branch to the shared abort —
            // which lives in the heap runtime block, so mark the need (a module
            // whose only array touch is a read must still pull the block in).
            // Bounds-check elision (#4380 lever 3): i32_imm == 1 (op_arr_get_nc,
            // the foreach counted reads) drops the cmp + jae — the `idx < arr_len`
            // guard ran immediately before, so the read is provably in bounds. The
            // existing checked path already relies on i32 indices being upper-bits
            // clean (its cmpq compares the full %rcx), so the elided form is
            // equally safe without a separate zero-extend.
            s = s.need("heap");
            if (o.i32_imm == 1) {
                s = s.write("    popq %rcx\n    popq %rax\n    incq %rcx\n    movq (%rax,%rcx,8), %rax\n    pushq %rax\n");
            } else {
                s = s.write("    popq %rcx\n    popq %rax\n    cmpq (%rax), %rcx\n    jae __fern_oob_abort\n    incq %rcx\n    movq (%rax,%rcx,8), %rax\n    pushq %rax\n");
            }
        } else if (o.kind_tag == 89) {  // arr_set
            // pop val (top), idx, base; store at data+(idx+1)*8. Same bounds
            // check as arr_get: an out-of-range write aborts, never corrupts.
            s = s.need("heap");
            s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n    cmpq (%rax), %rcx\n    jae __fern_oob_abort\n    incq %rcx\n    movq %rdx, (%rax,%rcx,8)\n");
        } else if (o.kind_tag == 90) {  // arr_len
            // pop base; length header at data+0.
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 91) {  // arr_rc
            // pop base; 32-bit refcount field at data-8.
            s = s.write("    popq %rax\n    movl -8(%rax), %eax\n    pushq %rax\n");
        } else if (o.kind_tag == 81) {  // raw_alloc
            // Tier-2 floor (#2649): pop n → %rdi, call __fern_alloc, push ptr.
            s = s.write("    popq %rdi\n    call __fern_alloc\n    pushq %rax\n");
            s = s.mark_heap();
        } else if (o.kind_tag == 82) {  // raw_store8
            // pop v (top), off, ptr; store low byte of v at [ptr+off]; push v back
            // (keeps the one-value-per-expr invariant; statement position drops it).
            s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n    addq %rcx, %rax\n    movb %dl, (%rax)\n    pushq %rdx\n");
        } else if (o.kind_tag == 83) {  // raw_load8
            // pop off (top), ptr; zero-extended byte at [ptr+off].
            s = s.write("    popq %rcx\n    popq %rax\n    addq %rcx, %rax\n    movzbl (%rax), %eax\n    pushq %rax\n");
        } else if (o.kind_tag == 84) {  // raw_store_ptr
            // pop v (top), off, ptr; store word slot at [ptr+off*8]; push v back.
            s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n    movq %rdx, (%rax,%rcx,8)\n    pushq %rdx\n");
        } else if (o.kind_tag == 85) {  // raw_load_ptr
            // pop off (top), ptr; word slot at [ptr+off*8].
            s = s.write("    popq %rcx\n    popq %rax\n    movq (%rax,%rcx,8), %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 86) {  // raw_string
            // pop [data, len] (len on top); build an rc-headered box via __fern_str_box
            // (#2649 Option A). len -> %rsi, data -> %rdi, call, push the box.
            s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_box\n    pushq %rax\n");
            s = s.mark_heap();
        } else if (o.kind_tag == 204) {  // syscall3
            // Syscall sub-floor (#2649): operand stack [nr, a1, a2, a3] (a3 on
            // top). System V syscall convention — nr→%rax, a1→%rdi, a2→%rsi,
            // a3→%rdx, `syscall`, result in %rax. No runtime symbol.
            s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    popq %rax\n    syscall\n    pushq %rax\n");
        } else if (o.kind_tag == 206) {  // syscall4
            // 4-arg syscall (#2649): operand stack [nr, a1, a2, a3, a4] (a4 on
            // top). a4→%r10 (the syscall 4th-arg register), else like syscall3.
            s = s.write("    popq %r10\n    popq %rdx\n    popq %rsi\n    popq %rdi\n    popq %rax\n    syscall\n    pushq %rax\n");
        } else if (o.kind_tag == 207) {  // raw_environ
            // env sub-floor (#2649): push the saved process envp pointer. No args.
            s = s.write("    movq __fern_envp(%rip), %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 205) {  // raw_scratch
            // [n] → the fixed static scratch buffer's address (#2649). n is a
            // hint; discard it and push &__fern_scratch (reused, never freed).
            s = s.write("    popq %rax\n    leaq __fern_scratch(%rip), %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 5) {  // const_str
            // String literal: intern the bytes in .rodata, build an rc-headered box
            // via __fern_str_box (#2649 Option A) — data = .rodata label, len = byte
            // count. box = [rc=1][data][len]; data@box+0 / len@box+8 unchanged, so
            // __fern_str_concat / _eq see the same layout. The rc header lets a fresh
            // literal box (e.g. an accumulator's initial "") be reclaimed at rc==1.
            var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, o.str);
            s = lo.state;
            s = s.write("    leaq " + str_lit_label(s, lo.idx) + "(%rip), %rdi\n");
            s = s.write("    movq $" + util.i32_to_string(o.str.len()) + ", %rsi\n");
            s = s.write("    call __fern_str_box\n");
            s = s.write("    pushq %rax\n");
