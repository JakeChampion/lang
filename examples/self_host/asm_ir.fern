        // element; the tail picks up the odd one.
        s = s.write("    movq (%rsi), %r10\n    andq $-2, %r10\n");
        s = s.write(sf_vec + ":\n");
        s = s.write("    cmpq %r10, %rdx\n    jge " + sf_loop + "\n");
        s = s.write("    leaq 8(%rsi,%rdx,8), %r8\n    movupd (%r8), %xmm0\n    mulpd %xmm1, %xmm0\n");
        s = s.write("    leaq 8(%rax,%rdx,8), %r9\n    movupd %xmm0, (%r9)\n");
        s = s.write("    addq $2, %rdx\n    jmp " + sf_vec + "\n");
        s = s.write(sf_loop + ":\n");
        s = s.write("    cmpq (%rsi), %rdx\n    jge " + sf_done + "\n");
        s = s.write("    leaq 8(%rsi,%rdx,8), %r8\n    movsd (%r8), %xmm0\n    mulsd %xmm1, %xmm0\n");
        s = s.write("    leaq 8(%rax,%rdx,8), %r9\n    movsd %xmm0, (%r9)\n");
        s = s.write("    addq $1, %rdx\n    jmp " + sf_loop + "\n");
        s = s.write(sf_done + ":\n    pushq %rax\n");
        s = s.need("heap");
        return s;
    }
    if (o.kind_tag == 324) {  // scan_set
        // operand stack [box, from, set] (set on top) -> the index of the
        // first byte at or after `from` whose set entry is nonzero, or the
        // LENGTH. Scalar: the table read per byte is the kernel. The set's
        // length is at (set) and its byte i in the 8-byte slot 8 + i*8;
        // a byte past that length is not in the set, and a set with an
        // entry for every byte value takes the loop with no length check.
        var slo: asmcore.LabelOut = asmcore.fresh_label(s);
        var s_loop: string = slo.name;
        var slo2: asmcore.LabelOut = asmcore.fresh_label(slo.state);
        var s_short: string = slo2.name;
        var slo3: asmcore.LabelOut = asmcore.fresh_label(slo2.state);
        var s_short_next: string = slo3.name;
        var slo4: asmcore.LabelOut = asmcore.fresh_label(slo3.state);
        var s_hit: string = slo4.name;
        var slo5: asmcore.LabelOut = asmcore.fresh_label(slo4.state);
        var s_end: string = slo5.name;
        var slo6: asmcore.LabelOut = asmcore.fresh_label(slo5.state);
        var s_done: string = slo6.name;
        var slo7: asmcore.LabelOut = asmcore.fresh_label(slo6.state);
        var s_from_ok: string = slo7.name;
        var slo8: asmcore.LabelOut = asmcore.fresh_label(slo7.state);
        var s_one: string = slo8.name;
        var hits: string[] = [];
