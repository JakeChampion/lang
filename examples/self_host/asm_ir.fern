        s = s.write("    movzbl (%rax,%rdx), %r9d\n    addl %r9d, %r10d\n");
        s = s.write("    addq $1, %rdx\n    jmp " + sb_loop + "\n");
        s = s.write(sb_done + ":\n    pushq %r10\n");
        return s;
