        var a_clamped: string = alo.name;
        var alo2: asmcore.LabelOut = asmcore.fresh_label(alo.state);
        var a_vec: string = alo2.name;
        var alo3: asmcore.LabelOut = asmcore.fresh_label(alo2.state);
        var a_hit: string = alo3.name;
        var alo4: asmcore.LabelOut = asmcore.fresh_label(alo3.state);
        var a_tail: string = alo4.name;
        var alo5: asmcore.LabelOut = asmcore.fresh_label(alo4.state);
        var a_none: string = alo5.name;
        var alo6: asmcore.LabelOut = asmcore.fresh_label(alo5.state);
        var a_done: string = alo6.name;
        var alo7: asmcore.LabelOut = asmcore.fresh_label(alo6.state);
        var a_avx: string = alo7.name;
        var alo8: asmcore.LabelOut = asmcore.fresh_label(alo7.state);
        var a_hit32: string = alo8.name;
        var alo9: asmcore.LabelOut = asmcore.fresh_label(alo8.state);
        var a_avx_done: string = alo9.name;
        s = alo9.state;
        s = s.write("    popq %rdx\n    popq %rax\n");
        s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
        // from clamps at 0.
        s = s.write("    cmpq $0, %rdx\n    jge " + a_clamped + "\n    xorq %rdx, %rdx\n");
