    s = s.write("    addq %rax, %rdi\n");
    s = s.write("    cmpq __fern_heap_end(%rip), %rdi\n"); // arena end recorded at mmap time
    s = s.write("    ja .Lalloc_oom\n");
    s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_oom:\n");
    s = s.write("    movq $60, %rax\n");
