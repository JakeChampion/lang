    s = s.write("    movq %r8, (%rax,%rdx,8)\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    jmp .Lfern_scp_loop\n");
    s = s.write(".Lfern_scp_done:\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
