    //   z = r*r; p = C1+z*(C2+…+z*C6); hz = z/2; w = 1-hz
    //   cos = w + (((1-w) - hz) + z*(z*p))
    // The (1-w)-hz rewrite recovers the bits 1-hz threw away; computing
    // 1 - hz + z*z*p directly loses them and costs ~2 ulp.
    s = s.write("__fern_kcos:\n");
    s = s.write("    movsd %xmm0, %xmm1\n    mulsd %xmm0, %xmm1\n");   // z
    s = s.write(fc_ld("%xmm3", ".Lfc_c6"));
    s = s.write(fc_horner("%xmm3", "%xmm1", "%xmm2", ".Lfc_c5"));
    s = s.write(fc_horner("%xmm3", "%xmm1", "%xmm2", ".Lfc_c4"));
    s = s.write(fc_horner("%xmm3", "%xmm1", "%xmm2", ".Lfc_c3"));
    s = s.write(fc_horner("%xmm3", "%xmm1", "%xmm2", ".Lfc_c2"));
    s = s.write(fc_horner("%xmm3", "%xmm1", "%xmm2", ".Lfc_c1"));
    s = s.write("    mulsd %xmm1, %xmm3\n    mulsd %xmm1, %xmm3\n");   // z*(z*p)
    s = s.write("    movsd %xmm1, %xmm4\n" + fc_ld("%xmm2", ".Lfc_half") + "    mulsd %xmm2, %xmm4\n"); // hz
    s = s.write(fc_ld("%xmm5", ".Lfc_one") + "    subsd %xmm4, %xmm5\n");   // w = 1-hz
    s = s.write(fc_ld("%xmm6", ".Lfc_one") + "    subsd %xmm5, %xmm6\n");   // 1-w
    s = s.write("    subsd %xmm4, %xmm6\n");                                // (1-w)-hz
    s = s.write("    addsd %xmm3, %xmm6\n");                                // + z*z*p
    s = s.write("    movsd %xmm5, %xmm0\n    addsd %xmm6, %xmm0\n    ret\n");

    // __fern_sin_f64: quadrant 0..3 -> sin r, cos r, -sin r, -cos r. The odd
    // quadrant picks the cos kernel and quadrant >= 2 flips the sign, so exactly
    // one kernel runs.
    s = s.write(".globl __fern_sin_f64\n");
    s = s.write(".type __fern_sin_f64, @function\n");
    s = s.write("__fern_sin_f64:\n");
    s = s.write(fc_trig_guard(".Lfsin_ret", ".Lfsin_nan"));
    s = s.write(fc_pio2_reduce("fsin"));
    s = s.write("    testq $1, %rax\n    jnz .Lfsin_usecos\n");
    s = s.write("    call __fern_ksin\n    jmp .Lfsin_neg\n");
    s = s.write(".Lfsin_usecos:\n    call __fern_kcos\n");
    s = s.write(".Lfsin_neg:\n    cmpq $2, %rax\n    jb .Lfsin_ret\n");
    s = s.write(fc_negate("%xmm1"));
    s = s.write(".Lfsin_ret:\n    ret\n");
    s = s.write(".Lfsin_nan:\n" + fc_retbits("0x7ff8000000000000"));
    s = s.write(".size __fern_sin_f64, .-__fern_sin_f64\n");

    // __fern_cos_f64: quadrant 0..3 -> cos r, -sin r, -cos r, sin r. The even
    // quadrant picks the cos kernel; quadrants 1 and 2 flip the sign.
    s = s.write(".globl __fern_cos_f64\n");
    s = s.write(".type __fern_cos_f64, @function\n");
    s = s.write("__fern_cos_f64:\n");
    s = s.write(fc_trig_guard(".Lfcos_ret", ".Lfcos_nan"));
    s = s.write(fc_pio2_reduce("fcos"));
    s = s.write("    testq $1, %rax\n    jnz .Lfcos_usesin\n");
    s = s.write("    call __fern_kcos\n    jmp .Lfcos_chk\n");
    s = s.write(".Lfcos_usesin:\n    call __fern_ksin\n");
    s = s.write(".Lfcos_chk:\n    cmpq $1, %rax\n    jb .Lfcos_ret\n");   // q0 -> +cos
    s = s.write("    cmpq $2, %rax\n    ja .Lfcos_ret\n");                // q3 -> +sin
    s = s.write(fc_negate("%xmm1"));
    s = s.write(".Lfcos_ret:\n    ret\n");
    s = s.write(".Lfcos_nan:\n" + fc_retbits("0x7ff8000000000000"));
    s = s.write(".size __fern_cos_f64, .-__fern_cos_f64\n");

    // __fern_exp_f64(%xmm0 = x) -> e^x.
    //   k = round(x/ln2); hi = x - k*ln2_hi; lo = k*ln2_lo; r = hi - lo
    //   c = r - t*(P1+t*(P2+…)), t = r*r
    //   e^r = 1 - ((lo - (r*c)/(2-c)) - hi);  e^x = e^r * 2^k
    // +Inf trips the overflow branch and -Inf the underflow one, so only NaN
    // needs its own test.
    s = s.write(".globl __fern_exp_f64\n");
    s = s.write(".type __fern_exp_f64, @function\n");
    s = s.write("__fern_exp_f64:\n");
    s = s.write("    ucomisd %xmm0, %xmm0\n    jp .Lfexp_ret\n");
    s = s.write(fc_ld("%xmm1", ".Lfc_expovf") + "    ucomisd %xmm1, %xmm0\n    ja .Lfexp_inf\n");
    s = s.write(fc_ld("%xmm1", ".Lfc_expunf") + "    ucomisd %xmm1, %xmm0\n    jb .Lfexp_zero\n");
    s = s.write(fc_ld("%xmm1", ".Lfc_invln2") + "    mulsd %xmm0, %xmm1\n");
    s = s.write("    roundsd $0, %xmm1, %xmm1\n    cvttsd2si %xmm1, %rax\n");  // k
    s = s.write("    movsd %xmm1, %xmm2\n" + fc_ld("%xmm7", ".Lfc_ln2hi") + "    mulsd %xmm7, %xmm2\n");
    s = s.write("    movsd %xmm0, %xmm3\n    subsd %xmm2, %xmm3\n");           // hi
    s = s.write(fc_ld("%xmm7", ".Lfc_ln2lo") + "    mulsd %xmm7, %xmm1\n");    // lo
    s = s.write("    movsd %xmm3, %xmm0\n    subsd %xmm1, %xmm0\n");           // r
    s = s.write("    movsd %xmm0, %xmm4\n    mulsd %xmm0, %xmm4\n");           // t
    s = s.write(fc_ld("%xmm5", ".Lfc_p5"));
    s = s.write(fc_horner("%xmm5", "%xmm4", "%xmm7", ".Lfc_p4"));
    s = s.write(fc_horner("%xmm5", "%xmm4", "%xmm7", ".Lfc_p3"));
    s = s.write(fc_horner("%xmm5", "%xmm4", "%xmm7", ".Lfc_p2"));
    s = s.write(fc_horner("%xmm5", "%xmm4", "%xmm7", ".Lfc_p1"));
    s = s.write("    mulsd %xmm4, %xmm5\n");                                   // t*(…)
    s = s.write("    movsd %xmm0, %xmm6\n    subsd %xmm5, %xmm6\n");           // c
    s = s.write("    movsd %xmm0, %xmm7\n    mulsd %xmm6, %xmm7\n");           // r*c
    s = s.write(fc_ld("%xmm2", ".Lfc_two") + "    subsd %xmm6, %xmm2\n");      // 2-c
    s = s.write("    divsd %xmm2, %xmm7\n");
    s = s.write("    movsd %xmm1, %xmm2\n    subsd %xmm7, %xmm2\n");           // lo - …
    s = s.write("    subsd %xmm3, %xmm2\n");                                   // - hi
    s = s.write(fc_ld("%xmm0", ".Lfc_one") + "    subsd %xmm2, %xmm0\n");
    // 2^k as two half-scales; one exponent field cannot hold the subnormal
    // band, where the low bits of k land in the sign bit.
    s = s.write("    movq %rax, %rcx\n    sarq $1, %rcx\n    subq %rcx, %rax\n");
    s = s.write("    addq $1023, %rcx\n    shlq $52, %rcx\n    movq %rcx, %xmm1\n");
    s = s.write("    addq $1023, %rax\n    shlq $52, %rax\n    movq %rax, %xmm2\n");
    s = s.write("    mulsd %xmm1, %xmm0\n    mulsd %xmm2, %xmm0\n");
    s = s.write(".Lfexp_ret:\n    ret\n");
    s = s.write(".Lfexp_inf:\n" + fc_retbits("0x7ff0000000000000"));
    s = s.write(".Lfexp_zero:\n    xorpd %xmm0, %xmm0\n    ret\n");
    s = s.write(".size __fern_exp_f64, .-__fern_exp_f64\n");

    // __fern_log_f64(%xmm0 = x) -> ln x. x = 2^k·m, m normalised to
    // [sqrt2/2, sqrt2); f = m-1; s = f/(2+f).
    //   R = t1+t2 over two INDEPENDENT chains in w = z², z = s², so they issue
    //   in parallel instead of as one 7-deep Horner.
    //   ln x = k·ln2_hi - ((hfsq - (s·(hfsq+R) + k·ln2_lo)) - f)
    // The bit-twiddling below extracts an exponent from 0 or +Inf and
    // carries on, so without the guards log(0) returned -709.09 and log(+Inf)
    // 709.78 — finite garbage. log(-0) == log(0) == -Inf, which the equality
    // branch covers.
    s = s.write(".globl __fern_log_f64\n");
    s = s.write(".type __fern_log_f64, @function\n");
    s = s.write("__fern_log_f64:\n");
    s = s.write("    ucomisd %xmm0, %xmm0\n    jp .Lflog_ret\n");
    s = s.write("    xorpd %xmm1, %xmm1\n    ucomisd %xmm1, %xmm0\n");
    s = s.write("    jb .Lflog_nan\n");                                        // x < 0
    s = s.write("    je .Lflog_neginf\n");                                     // x == ±0
    s = s.write("    movabsq $0x7ff0000000000000, %rax\n    movq %rax, %xmm1\n");
    s = s.write("    ucomisd %xmm1, %xmm0\n    je .Lflog_ret\n");              // +Inf -> itself
    // Subnormal prescale; %rdx carries the k adjustment, dead until the
    // mantissa mask below.
    s = s.write("    xorq %rdx, %rdx\n");
    s = s.write(fc_ld("%xmm1", ".Lfc_minnorm") + "    ucomisd %xmm1, %xmm0\n    jae .Lflog_noscale\n");
    s = s.write(fc_ld("%xmm1", ".Lfc_two54") + "    mulsd %xmm1, %xmm0\n    movq $54, %rdx\n");
    s = s.write(".Lflog_noscale:\n");
    s = s.write("    movq %xmm0, %rax\n    movq %rax, %rcx\n");
    s = s.write("    shrq $52, %rcx\n    andq $0x7ff, %rcx\n    subq $1023, %rcx\n    subq %rdx, %rcx\n");  // k
    s = s.write("    movabsq $0xfffffffffffff, %rdx\n    andq %rdx, %rax\n");
    s = s.write("    movabsq $0x3ff0000000000000, %rdx\n    orq %rdx, %rax\n");
    s = s.write("    movq %rax, %xmm1\n");                                     // m in [1,2)
    s = s.write(fc_ld("%xmm2", ".Lfc_sqrt2") + "    ucomisd %xmm2, %xmm1\n    jb .Lflog_noadj\n");
    s = s.write(fc_ld("%xmm2", ".Lfc_half") + "    mulsd %xmm2, %xmm1\n    addq $1, %rcx\n");
    s = s.write(".Lflog_noadj:\n");
    s = s.write(fc_ld("%xmm2", ".Lfc_one") + "    subsd %xmm2, %xmm1\n");      // f
    s = s.write(fc_ld("%xmm2", ".Lfc_two") + "    addsd %xmm1, %xmm2\n");      // 2+f
    s = s.write("    movsd %xmm1, %xmm3\n    divsd %xmm2, %xmm3\n");           // s
    s = s.write("    movsd %xmm3, %xmm4\n    mulsd %xmm3, %xmm4\n");           // z
    s = s.write("    movsd %xmm4, %xmm5\n    mulsd %xmm4, %xmm5\n");           // w
    s = s.write(fc_ld("%xmm6", ".Lfc_lg6"));
    s = s.write(fc_horner("%xmm6", "%xmm5", "%xmm2", ".Lfc_lg4"));
    s = s.write(fc_horner("%xmm6", "%xmm5", "%xmm2", ".Lfc_lg2"));
    s = s.write("    mulsd %xmm5, %xmm6\n");                                   // t1
    s = s.write(fc_ld("%xmm7", ".Lfc_lg7"));
    s = s.write(fc_horner("%xmm7", "%xmm5", "%xmm2", ".Lfc_lg5"));
    s = s.write(fc_horner("%xmm7", "%xmm5", "%xmm2", ".Lfc_lg3"));
    s = s.write(fc_horner("%xmm7", "%xmm5", "%xmm2", ".Lfc_lg1"));
    s = s.write("    mulsd %xmm4, %xmm7\n");                                   // t2
    s = s.write("    addsd %xmm7, %xmm6\n");                                   // R
    s = s.write("    movsd %xmm1, %xmm2\n    mulsd %xmm1, %xmm2\n");
    s = s.write(fc_ld("%xmm7", ".Lfc_half") + "    mulsd %xmm7, %xmm2\n");     // hfsq
    s = s.write("    cvtsi2sd %rcx, %xmm0\n");                                 // kf
    s = s.write("    movsd %xmm0, %xmm5\n" + fc_ld("%xmm7", ".Lfc_ln2lo") + "    mulsd %xmm7, %xmm5\n");
    s = s.write("    addsd %xmm2, %xmm6\n");                                   // hfsq+R
    s = s.write("    mulsd %xmm3, %xmm6\n");                                   // s*(hfsq+R)
    s = s.write("    addsd %xmm5, %xmm6\n");
    s = s.write("    subsd %xmm6, %xmm2\n    subsd %xmm1, %xmm2\n");           // hfsq - (…) - f
    s = s.write(fc_ld("%xmm7", ".Lfc_ln2hi") + "    mulsd %xmm7, %xmm0\n");
    s = s.write("    subsd %xmm2, %xmm0\n");
    s = s.write(".Lflog_ret:\n    ret\n");
    s = s.write(".Lflog_nan:\n" + fc_retbits("0x7ff8000000000000"));
    s = s.write(".Lflog_neginf:\n" + fc_retbits("0xfff0000000000000"));
    s = s.write(".size __fern_log_f64, .-__fern_log_f64\n");

    // __fern_pow_f64(%xmm0 = x, %xmm1 = y) -> x^y.
    //
    // Integer-exponent fast path. exp(y·ln x) CANNOT return exactly 9 for
    // pow(3,2): a 1-ulp error in ln 3 is amplified by the exponential to ~4e-15
    // on a result of 9, so it lands just under and `as i32` truncates to 8.
    // Repeated squaring is exact wherever the result is representable, and
    // cheaper than two transcendental calls for small |n|.
    //
    // Integrality is tested by an i64 round-trip rather than a compare against
    // trunc(y), so a NaN or out-of-range y falls out as a huge |n| and the range
    // check catches it instead of needing a parity branch.
    s = s.write(".globl __fern_pow_f64\n");
    s = s.write(".type __fern_pow_f64, @function\n");
    s = s.write("__fern_pow_f64:\n");
    s = s.write("    cvttsd2si %xmm1, %rax\n    cvtsi2sd %rax, %xmm2\n");
    s = s.write("    ucomisd %xmm1, %xmm2\n    jne .Lfpow_general\n");
    // |n|, branch-free: (n ^ (n>>63)) - (n>>63). Re-entered once with a
    // reciprocated base and a negated n; see the overflow retry below.
    s = s.write(".Lfpow_retry:\n");
    s = s.write("    movq %rax, %rcx\n    movq %rax, %rdx\n    sarq $63, %rdx\n");
    s = s.write("    xorq %rdx, %rcx\n    subq %rdx, %rcx\n");
    s = s.write("    cmpq $1074, %rcx\n    ja .Lfpow_general\n");
    s = s.write(fc_ld("%xmm3", ".Lfc_one") + "    movsd %xmm0, %xmm4\n");
    s = s.write(".Lfpow_loop:\n    testq $1, %rcx\n    jz .Lfpow_skip\n");
    s = s.write("    mulsd %xmm4, %xmm3\n");
    s = s.write(".Lfpow_skip:\n    mulsd %xmm4, %xmm4\n    shrq $1, %rcx\n    jnz .Lfpow_loop\n");
    s = s.write("    testq %rax, %rax\n    jns .Lfpow_done\n");
    s = s.write(fc_ld("%xmm5", ".Lfc_one") + "    divsd %xmm3, %xmm5\n");
    // 1/acc is zero only when acc reached an infinity, so the magnitude
    // overflowed on the way to a result that may itself be representable.
    // Redo on 1/x; negating n makes the second pass return the accumulator
    // directly, so the retry runs at most once and needs no flag.
    s = s.write("    xorpd %xmm6, %xmm6\n    ucomisd %xmm6, %xmm5\n");
    s = s.write("    jne .Lfpow_recip\n    jp .Lfpow_recip\n");
    s = s.write(fc_ld("%xmm5", ".Lfc_one") + "    divsd %xmm0, %xmm5\n    movsd %xmm5, %xmm0\n");
    s = s.write("    negq %rax\n    jmp .Lfpow_retry\n");
    s = s.write(".Lfpow_recip:\n    movsd %xmm5, %xmm3\n");
    s = s.write(".Lfpow_done:\n    movsd %xmm3, %xmm0\n    ret\n");
    // General case: x^y = sign · exp(y·ln|x|). ln is defined only for x > 0, so
    // a negative base is split into a sign and |x| first: for an integral y the
    // sign is (-1)^y, and a non-integral y makes the result NaN. Every |y| >= 2^53
    // is an even integer, which is what leaves pow(x<0, ±Inf) a magnitude rather
    // than a NaN.
    //
    // The only non-leaf helper: SysV has no callee-saved xmm registers, so y and
    // the sign multiplier are stashed on the stack across the log call, where
    // arm64 can use callee-saved d8.
    s = s.write(".Lfpow_general:\n    subq $16, %rsp\n    movsd %xmm1, (%rsp)\n");
    s = s.write(fc_ld("%xmm2", ".Lfc_one") + "    movsd %xmm2, 8(%rsp)\n");     // sign of the result
    s = s.write("    movq %xmm0, %rax\n    testq %rax, %rax\n    jns .Lfpow_mag\n");  // +0 or a positive base
    s = s.write("    movabsq $0x7fffffffffffffff, %rcx\n    andq %rcx, %rax\n");
    s = s.write("    movq %rax, %xmm0\n");                                      // |x|
    s = s.write("    movq %xmm1, %rdx\n    andq %rcx, %rdx\n");                 // |y|
    s = s.write("    movabsq $0x4340000000000000, %rcx\n    cmpq %rcx, %rdx\n    jb .Lfpow_parity\n");
    s = s.write("    movabsq $0x7ff0000000000000, %rcx\n    cmpq %rcx, %rdx\n    jbe .Lfpow_mag\n");  // |y| >= 2^53, finite or ±Inf: an even integer
    s = s.write("    jmp .Lfpow_nan\n");                                        // y is NaN
    s = s.write(".Lfpow_parity:\n    cvttsd2si %xmm1, %rdx\n    cvtsi2sd %rdx, %xmm2\n");
    s = s.write("    ucomisd %xmm1, %xmm2\n    jne .Lfpow_nan\n");              // y is not an integer
    s = s.write("    testq $1, %rdx\n    jz .Lfpow_mag\n");                     // even exponent
    s = s.write("    movabsq $0xbff0000000000000, %rcx\n    movq %rcx, %xmm2\n    movsd %xmm2, 8(%rsp)\n");
    // |x| == 1 is 1 for every y, including the NaN and ±Inf that exp(y·ln|x|)
    // would turn into NaN through y·0.
    s = s.write(".Lfpow_mag:\n    movq %xmm0, %rax\n");
    s = s.write("    movabsq $0x3ff0000000000000, %rcx\n    cmpq %rcx, %rax\n    je .Lfpow_sign\n");
    s = s.write("    call __fern_log_f64\n");
    s = s.write("    movsd (%rsp), %xmm1\n    mulsd %xmm1, %xmm0\n");
    s = s.write("    call __fern_exp_f64\n");
    s = s.write(".Lfpow_sign:\n    mulsd 8(%rsp), %xmm0\n");
    s = s.write("    addq $16, %rsp\n    ret\n");
    s = s.write(".Lfpow_nan:\n    addq $16, %rsp\n" + fc_retbits("0x7ff8000000000000"));
    s = s.write(".size __fern_pow_f64, .-__fern_pow_f64\n");
    return s;
}

// needs_fs_runtime is the gate on the io_error call-graph bundle: every
// need whose generated Fern body is emitted from that block. The filesystem
// is all of it bar the two process ops, which are there because they classify an
// errno the same way and so shares the same call graph.
function needs_fs_runtime(s: asmcore.EmitState): boolean {
    return s.any_need([
        "stat", "lstat", "statfs", "access", "read_file",
        "read_file_bytes", "remove_file", "create_dir_all", "create_dir",
        "remove_dir", "create_link", "create_symlink", "rename", "chmod", "chmod_at",
        "truncate", "mknod", "chown_at", "window_size", "set_window_size", "termios_get", "termios_set", "set_file_times",
        "read_link", "chdir", "chroot", "setuid", "setgid", "setgroups", "fd_fsync", "fd_fdatasync", "fd_syncfs", "sync",
        "umask", "write_file", "write_file_exec", "temp_dir", "read_dir", "read_dir_all",
        "remove_dir_all", "open_file", "open_with", "writer_write", "write_some",
        "reader", "signal_send", "set_process_group", "set_priority"
    ]);
}

// needs_heap_runtime gates the allocator and the RC runtime. `heap` is the
// need an allocating op marks; the rest are the helpers whose own bodies
// allocate, so a program that never allocates directly still pulls the
// runtime in through one of them.
function needs_heap_runtime(s: asmcore.EmitState): boolean {
    return s.any_need([
        "heap", "i32_to_string", "u32_to_string", "chr",
        "read_all_stdin", "str_read_line", "strbuf", "buf", "reader",
        "write_file", "write_file_exec", "remove_dir_all", "temp_dir",
        "read_dir", "read_dir_all", "remove_file", "create_dir_all", "create_dir",
        "remove_dir", "create_link", "create_symlink", "rename", "chmod", "chmod_at",
        "truncate", "mknod", "chown_at", "window_size", "set_window_size", "termios_get", "termios_set", "set_file_times",
        "read_link", "chdir", "chroot", "setuid", "setgid", "setgroups",
        "umask", "env", "environ", "raw_environ", "getgroups", "stat", "lstat", "statfs",
        "access", "fd_fsync", "fd_fdatasync", "fd_syncfs", "subprocess",
        "signal_send", "set_process_group", "set_priority"
    ]);
}

// emit_runtime_memcpy emits `__fern_memcpy(%rdi = dst, %rsi = src, %rdx = n)`
// for the builders' copies, the same size classes as native's: `rep movsb` is
// nearly all start-up at the few bytes a line push copies. Each class covers
// its range with two overlapping accesses; the regions must not overlap.
// Clobbers %rax, %rsi, %rdi, %r8, %r9, %xmm0 and %xmm1.
function emit_runtime_memcpy(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_memcpy:\n");
    s = s.write("    movq %rdi, %rax\n");
    s = s.write("    cmpq $8, %rdx\n");
    s = s.write("    jb .Lmcp_lt8\n");
    s = s.write("    cmpq $16, %rdx\n");
    s = s.write("    jb .Lmcp_8_15\n");
    s = s.write("    cmpq $32, %rdx\n");
    s = s.write("    jbe .Lmcp_16_32\n");
    s = s.write("    leaq -32(%rdi,%rdx), %r8\n");
    s = s.write("    leaq -32(%rsi,%rdx), %r9\n");
    s = s.write(".Lmcp_bulk:\n");
    s = s.write("    movdqu (%rsi), %xmm0\n");
    s = s.write("    movdqu 16(%rsi), %xmm1\n");
    s = s.write("    movdqu %xmm0, (%rdi)\n");
    s = s.write("    movdqu %xmm1, 16(%rdi)\n");
    s = s.write("    addq $32, %rsi\n");
    s = s.write("    addq $32, %rdi\n");
    s = s.write("    cmpq %r8, %rdi\n");
    s = s.write("    jb .Lmcp_bulk\n");
    s = s.write("    movdqu (%r9), %xmm0\n");
    s = s.write("    movdqu 16(%r9), %xmm1\n");
    s = s.write("    movdqu %xmm0, (%r8)\n");
    s = s.write("    movdqu %xmm1, 16(%r8)\n");
    s = s.write("    ret\n");
    s = s.write(".Lmcp_16_32:\n");
    s = s.write("    movdqu (%rsi), %xmm0\n");
    s = s.write("    movdqu -16(%rsi,%rdx), %xmm1\n");
    s = s.write("    movdqu %xmm0, (%rdi)\n");
    s = s.write("    movdqu %xmm1, -16(%rdi,%rdx)\n");
    s = s.write("    ret\n");
    s = s.write(".Lmcp_8_15:\n");
    s = s.write("    movq (%rsi), %r8\n");
    s = s.write("    movq -8(%rsi,%rdx), %r9\n");
    s = s.write("    movq %r8, (%rdi)\n");
    s = s.write("    movq %r9, -8(%rdi,%rdx)\n");
    s = s.write("    ret\n");
    s = s.write(".Lmcp_lt8:\n");
    s = s.write("    cmpq $4, %rdx\n");
    s = s.write("    jb .Lmcp_lt4\n");
    s = s.write("    movl (%rsi), %r8d\n");
    s = s.write("    movl -4(%rsi,%rdx), %r9d\n");
    s = s.write("    movl %r8d, (%rdi)\n");
    s = s.write("    movl %r9d, -4(%rdi,%rdx)\n");
    s = s.write("    ret\n");
    s = s.write(".Lmcp_lt4:\n");
    s = s.write("    testq %rdx, %rdx\n");
    s = s.write("    je .Lmcp_done\n");
    s = s.write("    movzbq (%rsi), %r8\n");
    s = s.write("    movzbq -1(%rsi,%rdx), %r9\n");
    s = s.write("    movb %r8b, (%rdi)\n");
    s = s.write("    movb %r9b, -1(%rdi,%rdx)\n");
    s = s.write("    cmpq $3, %rdx\n");
    s = s.write("    jb .Lmcp_done\n");
    s = s.write("    movzbq 1(%rsi), %r8\n");
    s = s.write("    movb %r8b, 1(%rdi)\n");
    s = s.write(".Lmcp_done:\n");
    return s.write("    ret\n");
}

function emit_ir_runtime(s: asmcore.EmitState): asmcore.EmitState {
    // .bss: heap bump pointer + arena end, the over-release detector, and the
    // size-classed freelist (65536 classes * 8 bytes). The heap arena itself is
    // mmap'd lazily at runtime (see __fern_alloc below) rather than reserved as
    // a multi-GiB `.bss` block, so the emitted binary makes no assumption about
    // the linker's .bss layout — bfd / lld / mold all work (issue #4081).
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
    // .globl on the cursor + end pair for the reason spelled out on
    // __fern_arr_push_shared below: __heap_bump_bytes lowers to an INLINE read of
    // BOTH (`movq __fern_heap_ptr(%rip)` / `movq __fern_heap_end(%rip)`, kind_tag
    // 80), never a call through a global accessor, so a file-local symbol is
    // unreachable from any unit but the one holding the runtime.
    s = s.write("    .globl __fern_heap_ptr\n");
    s = s.write("__fern_heap_ptr: .quad 0\n");       // bump cursor (0 until first mmap)
    s = s.write("    .align 8\n");
    s = s.write("    .globl __fern_heap_end\n");
    s = s.write("__fern_heap_end: .quad 0\n");        // arena end (base + heap_size), set at mmap time
    s = s.write("    .align 8\n");
    // arena BASE (the mmap return), set once at first alloc. Bounds the freeable
    // heap range [base, end) so __fern_str_free can free a heap string's data
    // buffer but skip a static string LITERAL's .rodata data pointer (which sits
    // below the arena) — the heap-vs-literal test the header-less asm string box
    // otherwise can't make. Used only by __fern_str_free (#2649 string RC).
    s = s.write("__fern_heap_base: .quad 0\n");
    s = s.write("    .align 8\n");
    if (s.has_need("alloc_count")) {
        // The allocator's call count (#9596), read inline by kind_tag 315 —
        // .globl for the same reason as the cursor pair above, since the read
        // is an inline `movq` from whichever unit asked for it.
        s = s.write("    .globl __fern_alloc_count\n");
        s = s.write("__fern_alloc_count: .quad 0\n");
        s = s.write("    .align 8\n");
    }
    s = s.write("__fern_rc_underflow: .quad 0\n");
    s = s.write("    .align 8\n");
    // core/map's per-process string-hash seed (#6194). Read and filled only
    // by __fern_map_hash_seed, which lives in this same unit, so it needs no
    // .globl (unlike the cliff counter below, which ops read inline).
    s = s.write("__fern_map_seed: .quad 0\n");
    s = s.write("    .align 8\n");
    // The rc==1 append cliff counter (#6023): appends that copied a buffer which
    // still had spare capacity, so the copy was bought by an extra reference
    // rather than a full buffer. Bumped on the un-share path in __fern_arr_push,
    // read by __arr_push_shared_count. 0 on a healthy run.
    //
    // .globl because __arr_push_shared_count lowers to an INLINE read of this
    // word (`movq __fern_arr_push_shared(%rip)`), unlike its sibling
    // __rc_underflow_count which lowers to a CALL to the global
    // __fn___fern_rc_underflow_count that reads its word from inside this same
    // unit. An inline read cannot reach a file-local symbol in another unit, so
    // under -per-module-emit-all — which does no cross-module DCE, and so emits
    // every function whether or not the bundle calls it — a caller landing in
    // any unit but this one failed to link with "undefined reference to
    // __fern_arr_push_shared". Whole-program builds never saw it: one unit, one
    // file, local resolution. See #6058.
    //
    // These two — the cliff counter and the heap cursor/end pair above — are the
    // ONLY .bss words an op lowering reads inline; every other reference
    // (__fern_rc_underflow, __fern_freelist, __fern_envp, __fern_strbuf_*,
    // __fern_heap_base) is emitted inside a runtime helper, which lands in this
    // same unit. That is why __fern_heap_base stays local: only __fern_str_free
    // reads it.
    s = s.write("    .globl __fern_arr_push_shared\n");
    s = s.write("__fern_arr_push_shared: .quad 0\n");
    s = s.write("    .align 8\n");
    // The same crossings WEIGHTED by the bytes they copied (len * 8 — the
    // self-host array model is uniform 8-byte slots), read by
    // __arr_push_shared_bytes. The count says whether the cliff was crossed;
    // this says whether it cost anything, and the two readings differ by three
    // orders of magnitude on real runs. .globl for exactly the reason the
    // counter above is: its reader lowers to an INLINE read of this word, which
    // cannot reach a file-local symbol in another unit under
    // -per-module-emit-all (#6058, #6066).
    s = s.write("    .globl __fern_arr_push_copied\n");
    s = s.write("__fern_arr_push_copied: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_freelist: .skip 524288\n");
    s = s.write("    .align 8\n");
    // Large-tier segregated freelist (#3425): the 65536-word __fern_freelist above
    // recycles blocks <512 KiB exactly; blocks >=512 KiB previously LEAKED (no class),
    // so a long-running emit that frees big per-function analysis arrays exhausted the
    // arena (exit 137) — the self-host runtime lagging the native two-tier design. This
    // array is the large tier: LINEAR 512-KiB classes, class = round_up(size, 512 KiB)
    // >> 19 (1..2048 for 512 KiB..1 GiB), so 2049 slots suffice (2560 for headroom).
    // Linear costs two things against native's 3-significant-bit tier: a 513-KiB
    // request occupies 1 MiB, and an accumulator grown in place copies every
    // 512 KiB rather than every ~12.5%, so growing one stays O(n^2) where
    // native's is amortised linear (#9077). Geometric binning was once
    // impossible here — the x86_gas assembler had no `bsr` and no `%cl` shift —
    // but both are supported now: x86_gas_bitscan_op maps bsrl/bsrq and
    // x86_gas_shift_family takes a `%cl` count, so native's class function
    // ports across and the constraint no longer applies.
    // Each large ALLOC rounds the request up to its class capacity (a 512-KiB multiple)
    // and bumps at THAT — so every block in a class has one capacity and any freed block
    // satisfies any same-class request; each large FREE re-derives the class from the
    // logical size via the same round-up and pushes the block (successor pointer in its
    // first 8 bytes; 0 = empty). >1 GiB is never freelisted (bump/leak only).
    s = s.write("__fern_large_freelist: .skip 20480\n");
    // Shadows for the arena checkpoint (#6728): __heap_mark copies both head
    // tables here, __heap_release_to copies them back. .bss, so they cost image
    // size nothing and are zero-filled — a release with no preceding mark
    // restores all-empty heads, which is a bounded leak rather than corruption.
    s = s.write("    .align 8\n");
    s = s.write("__fern_freelist_shadow: .skip 524288\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_large_freelist_shadow: .skip 20480\n");
    s = s.write("    .section .text\n");
    // __fern_alloc(%rdi = bytes) -> %rax = block. Size-classed freelist reuse
    // (class = __fern_capw(words) below 65536 words) then bump; OOM traps with
    // exit 125.
    //
    // Under a heap-event build the body becomes __fern_alloc_inner and this is
    // a wrapper around it, so ONE hook covers all three allocation exits (the
    // small-class freelist pop, the large-class pop, and the bump) instead of
    // three hooks at three different live-register states. The wrapper is also
    // where the reported site is naturally correct: [rsp] on entry is the
    // caller's return address, i.e. the code that ASKED for the memory, not
    // the exit path that happened to satisfy it.
    //
    // Callers see the same contract either way — %rax is the block, %rdi is
    // clobbered, everything else preserved (%rsi is saved and restored around
    // the hook; __fern_hev_a itself clobbers nothing).
    //
    // Note the site is the IMMEDIATE caller. Allocations routed through the
    // box shims (__fern_arr_box / __fern_str_box) therefore report the shim,
    // not the code that wanted the box — the same limitation the native hook
    // has, and the reason an `a` line naming a shim needs one gdb frame walk
    // to attribute.
    if (hev_on()) {
        s = s.write("__fern_alloc:\n");
        if (s.has_need("alloc_count")) { s = s.write("    incq __fern_alloc_count(%rip)\n"); }
        s = s.write("    pushq %rdi\n");             // requested bytes
        s = s.write("    call __fern_alloc_inner\n");
        s = s.write("    popq %rdi\n");
        s = s.write("    pushq %rsi\n");
        s = s.write("    movq 8(%rsp), %rsi\n");     // site = our caller's return address
        s = s.write("    addq $7, %rdi\n");          // the rounding __fern_alloc_inner applies
        s = s.write("    shrq $3, %rdi\n");          // words
        s = s.write("    pushq %rdi\n");
        s = s.write("    pushq %rax\n");
        s = s.write("    pushq %rsi\n");
        s = s.write("    call __fern_hev_a\n");
        s = s.write("    addq $24, %rsp\n");
        s = s.write("    popq %rsi\n");
        s = s.write("    ret\n");
        s = s.write("__fern_alloc_inner:\n");
    } else {
        s = s.write("__fern_alloc:\n");
        // Ahead of every exit — the two freelist pops and the bump — so a
        // recycled block is counted exactly like a bumped one. Under a
        // heap-event build the wrapper above counts instead, so the inner
        // body must not count again.
        if (s.has_need("alloc_count")) { s = s.write("    incq __fern_alloc_count(%rip)\n"); }
    }
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    addq $7, %rdi\n");
    s = s.write("    andq $-8, %rdi\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    pushq %rdx\n");
    s = s.write("    movq %rdi, %rcx\n");
    s = s.write("    shrq $3, %rcx\n");
    s = s.write("    cmpq $65536, %rcx\n");
    s = s.write("    jae .Lalloc_large\n");
    // The small tier bumps a block at its class's capacity, so any freed block
    // of the class satisfies any request that rounds to it.
    s = s.write("    pushq %rcx\n");
    s = s.write("    call __fern_capw\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    leaq 0(,%rcx,8), %rdi\n");
    s = s.write("    leaq __fern_freelist(%rip), %rdx\n");
    s = s.write("    movq (%rdx,%rcx,8), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lalloc_nofl\n");
    s = s.write("    movq (%rax), %rdi\n");
    s = s.write("    movq %rdi, (%rdx,%rcx,8)\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    // Large tier (#3425): a >=512 KiB request. Round the byte size UP to a 512-KiB
    // multiple (the class capacity — bump AT it so every block in a class has one
    // size, so any freed block satisfies any same-class request), derive class =
    // cap >> 19, and pop the large freelist; empty falls through to the bump with
    // %rdi = capacity. >1 GiB is bump-only. Linear rather than geometric; see
    // the note on __fern_large_freelist above for what that costs and why it is
    // no longer forced. %rcx/%rdx are already saved.
    s = s.write(".Lalloc_large:\n");
    s = s.write("    cmpq $0x40000000, %rdi\n");        // > 1 GiB: bump exact, no freelist
    s = s.write("    ja .Lalloc_nofl\n");
    s = s.write("    leaq 524287(%rdi), %rax\n");       // size + (512 KiB - 1)
    s = s.write("    andq $-524288, %rax\n");           // cap = round_up(size, 512 KiB)
    s = s.write("    movq %rax, %rdi\n");               // %rdi = cap = bytes to bump
    s = s.write("    shrq $19, %rax\n");                // class = cap >> 19  (1..2048)
    s = s.write("    leaq __fern_large_freelist(%rip), %rdx\n");
    s = s.write("    movq (%rdx,%rax,8), %rcx\n");      // head
    s = s.write("    testq %rcx, %rcx\n");
    s = s.write("    jz .Lalloc_nofl\n");               // empty class: bump at cap (%rdi)
    s = s.write("    movq (%rcx), %rdi\n");             // head.next
    s = s.write("    movq %rdi, (%rdx,%rax,8)\n");      // heads[class] = next
    s = s.write("    movq %rcx, %rax\n");               // return reused block
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_nofl:\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jne .Lalloc_inited\n");
