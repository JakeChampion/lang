            // bump high-water mark = (__fern_heap_ptr == 0) ? 0 : ptr − base.
            // The arena is mmap'd lazily; its base is recoverable from the
            // recorded end (__fern_heap_end = base + heap_size), so base =
            // end − heap_size. The cursor is 0 until the first alloc, so guard
            // that case to report 0 (matching native's __fern_heap_bump_bytes).
            s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");   // cursor (0 if uninit)
            s = s.write("    movq __fern_heap_end(%rip), %rcx\n");   // arena end = base + heap_size (0 if uninit)
            s = s.write("    movabs $17179869184, %rdx\n");           // heap_size (0x400000000, 16 GiB)
            s = s.write("    subq %rdx, %rcx\n");                    // %rcx = base = end − heap_size
            s = s.write("    movq %rax, %rdx\n");
