    // __fern_str_concat is now a Fern runtime function (#2649): emitted entry-only
    // via emit_ir_runtime_fern_fn (lowered through the IR pipeline as
    // __fn___fern_str_concat, using the raw-memory intrinsics), not a hand-written
    // register-ABI body here. See the emit_ir_runtime_fern_fn call in
    // emit_module_ir_unit's entry block.
    // __fern_str_eq is hand-written (#8192) but not here: it takes the __fn_
    // stack convention rather than this section's register ABI, so its body is
    // rt_x86_str_eq, emitted entry-only from emit_module_ir_unit's entry block.
    // __fern_str_cmp is now a Fern runtime function (#2649): emitted entry-only
    // via emit_ir_runtime_fern_fn (lowered through the IR pipeline as
    // __fn___fern_str_cmp), not a hand-written register-ABI body here. See the
    // emit_ir_runtime_fern_fn call in emit_module_ir_unit's entry block.
    // __fern_arr_slice is a Fern runtime function now (#2649):
    // asmcore.rt_src_arr_slice, emitted
    // need-gated in the migrated-helpers section over the __raw_arr_box +
    // __raw_array pair. One source replaces the two hand-asm copies (this
    // one and asm_arm64_ir's) — they were raw slot copies with nothing
    // target-specific in them, which is what made them worth moving. arr_slice
    // came last because its bounds check (#5419) traps: it spells the trap with
    // the __syscall3 sub-floor (exit 134), which is why it alone takes a target.
    // __fern_random_bytes is now a Fern runtime function (#2649): emitted via
    // emit_ir_runtime_fern_fn in emit_module_ir_unit's entry block (need-gated on
    // random_bytes) — it fills n scratch bytes from getrandom via the __syscall3
    // sub-floor, then spreads them one-per-slot into a fresh u8[] box
    // (__raw_arr_box). The op_random_bytes handler calls the stack-arg
    // __fn___fern_random_bytes symbol.
    // __fern_str_bytes was hand-written here through #2649; it is now a Fern
    // runtime function (asmcore.rt_src_str_bytes) lowered through the IR pipeline
    // via emit_ir_runtime_fern_fn in emit_module_ir_unit's entry block — it builds
    // the byte i32[] by appending each byte (arr_push). Heap + arr_push dependent;
    // gated on the str_bytes need.
    // __fern_str_split is now a Fern runtime function (#2649): emitted via
    // emit_ir_runtime_fern_fn in emit_module_ir_unit's entry block (need-gated on
    // str_split), like the string builders — scans for `sep` and appends each
    // segment slice (.append() -> arr_push_owned) via the raw-memory intrinsics.
    // The op_str_split handler calls the stack-arg __fn___fern_str_split symbol.
    // __fern_string_from_bytes is now a Fern runtime function (#2649): emitted
    // via emit_ir_runtime_fern_fn in emit_module_ir_unit's entry block (need-gated
    // on str_from_bytes), like the string builders — packs each 8-byte slot's low
    // byte into a fresh string box via the raw-memory intrinsics. The op_str_from_
    // bytes handler calls the stack-arg __fn___fern_string_from_bytes symbol.
    // __fern_alloc_u8 — the `__alloc_u8(n)` byte-buffer builtin (std/crypto et
    // al.) and the map runtime use it. Gated on its own need OR maps.
    if (s.has_need("alloc_u8") || s.has_need("maps")) {
    // __fern_alloc_u8 (transcribed from asm.fern for the IR map path).
    s = s.write(".globl __fern_alloc_u8\n");
    s = s.write(".type __fern_alloc_u8, @function\n");
    s = s.write("__fern_alloc_u8:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq %rdi, %r12\n");        // n
    s = s.write("    movq %r12, %rdi\n");        // cap = n
    s = s.write("    call __fern_arr_box\n");    // -> data ptr in %rax (cap + len written)
