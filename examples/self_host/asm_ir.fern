// examples/self_host/asm_ir.fern — the IR code path for the production
// x86-64 backend, the first integration of the native-shaped stack IR
// (ir.fern / irlower.fern) into asm.fern's world (docs/RC-PERCEUS-SELF-HOST-
// IR-REBUILD.md §3). emit_module_ir lowers each function AST -> stack IR ->
// asm and instruction-selects it into asm.fern's OWN dialect: same
// `__fn_<name>:` label, same rbp frame + leave/ret, same machine-stack
// operand discipline (every value `pushq`-ed, consumers `popq`), so an
// IR-emitted function is ABI-identical to an AST-emitted one — and the two
// must produce identical behaviour (the differential gate).
//
// SCOPE (slice 16): pure i32 functions — no params, no user calls, no arrays
// — proving the seam end-to-end. asm.fern itself is UNCHANGED (this module is
// imported only by asm_run via its `-ir` flag), so the byte-identical
// self-bootstrap and every asm.fern-based harness are unaffected. emit_module_ir
// only handles modules where EVERY function is eligible (all_eligible); the
// driver falls back to asm.emit_module otherwise. As the eligible subset
// widens, this folds back into asm.fern's emit_module behind a flag.

import "./parser";
import "./asmcore";
import "./util";
import "./ir";
import "./irlower";

// ir_eligible reports whether a function is in the IR path's current subset:
// i32 functions with params, direct calls, and arrays (heap alloc / index /
// write / len + Perceus RC, including borrowed array params and array returns
// via move-on-return) — but no methods. Cross-function arrays are sound here
// because the IR path only fires when the WHOLE module is eligible
// (all_eligible), so every function — caller and callee — uses irlower's
// array layout; nothing crosses an IR/AST boundary.
pub function ir_eligible(fd: parser.FuncDecl, structs: parser.StructDecl[], opt_ret_fns: string[], i64_ret_fns: string[], struct_ret_fns: string[], tuple_ret_fns: string[]): boolean {
    // Methods (receiver functions) are lowered too — lower_func binds the
    // receiver as slot 0 and bails for non-scalar-struct receivers.
    var noret: string[] = [];
    // struct_ret_fns and tuple_ret_fns BOTH affect ok/bail: a caller's `p.x` on
    // a struct-returning-call result (or a struct element destructured from a
    // tuple-returning call) bails unless p is struct-typed, so the eligibility
    // probe threads the real registries. (str/strarr/arr are emit-only — they
    // change op selection, not whether a function lowers — so they stay empty.)
    var r: irlower.LowerResult = irlower.lower_func(fd, noret, structs, noret, noret, opt_ret_fns, i64_ret_fns, tuple_ret_fns, struct_ret_fns, noret, noret, noret);
    if (!r.ok) { return false; }
    return true;
}

// is_array_type reports whether a type string denotes an array (ends "[]").
function is_array_type(t: string): boolean {
    var n: i32 = t.len();
    if (n < 2) { return false; }
    return t[n - 2 : n] == "[]";
}

// array_ret_fns collects the names of functions whose return type is an array,
// so move-on-return / move-from-call fire (mirrors irlower.lower_module).
pub function array_ret_fns(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (is_array_type(mod.funcs[i].ret_type)) { out = out.append(mod.funcs[i].name); }
        i = i + 1;
    }
    return out;
}

// is_fern_helper reports whether a call_direct callee is one of the IR
// runtime helpers the emitter actually provides (emit_ir_runtime). These now
// use asm.fern's OWN stack-arg ABI + symbols (so the IR path is a drop-in for
// asm.fern's array RC) — see ir_helper_symbol for the name map. The whitelist
// is exact: any OTHER __fern_* / __rc_* call is NOT provided here, so
// calls_only_known disqualifies the module from the IR path and it falls back
// to the AST emitter. (__fern_heap_used has no asm.fern equivalent, so a
// program using it now routes through the AST path.)
pub function is_fern_helper(name: string): boolean {
    return name == "__fern_rc_inc"
        || name == "__fern_rc_dec"
        || name == "__fern_rc_underflow_get";
}

// ir_helper_symbol maps an IR runtime-helper name to the asm.fern symbol the
// IR path calls (stack-arg ABI). The exit-sweep / reassign release
// (__fern_rc_dec) maps to __fn___fern_arr_dec — the array release that frees
// at rc==1 via the size-class freelist — so the IR path reclaims exactly as
// asm.fern's AST path does.
pub function ir_helper_symbol(name: string): string {
    if (name == "__fern_rc_inc") { return "__fn___fern_rc_inc"; }
    if (name == "__fern_rc_dec") { return "__fn___fern_arr_dec"; }
    if (name == "__fern_rc_underflow_get") { return "__fn___fern_rc_underflow_count"; }
    return "__fn_" + name;
}

// module_uses_heap reports whether any function allocates (so the runtime +
// heap need emitting).
// module_uses_maps reports whether any function uses a map op (so the map
// runtime + its __fern_str_eq / __fern_arr_push deps need emitting).
function module_uses_maps(mod: parser.Module): boolean {
    var noret: string[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var r: irlower.LowerResult = irlower.lower_func(mod.funcs[fi], noret, mod.structs, noret, noret, irlower.opt_ret_fns_of(mod.funcs), irlower.i64_ret_fns_of(mod.funcs), irlower.tuple_ret_fns_of(mod.funcs), irlower.struct_ret_fns_of(mod.funcs, mod.structs), irlower.f64_ret_fns_of(mod.funcs), irlower.f64arr_ret_fns_of(mod.funcs), irlower.i64arr_ret_fns_of(mod.funcs));
        var i: i32 = 0;
        while (i < r.ops.len()) {
            var k: string = r.ops[i].kind;
            if (k == "map_new" || k == "map_set" || k == "map_len") { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

function module_uses_heap(mod: parser.Module): boolean {
    var noret: string[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var r: irlower.LowerResult = irlower.lower_func(mod.funcs[fi], noret, mod.structs, noret, noret, irlower.opt_ret_fns_of(mod.funcs), irlower.i64_ret_fns_of(mod.funcs), irlower.tuple_ret_fns_of(mod.funcs), irlower.struct_ret_fns_of(mod.funcs, mod.structs), irlower.f64_ret_fns_of(mod.funcs), irlower.f64arr_ret_fns_of(mod.funcs), irlower.i64arr_ret_fns_of(mod.funcs));
        var i: i32 = 0;
        while (i < r.ops.len()) {
            // arr_make (array literal) is the allocating op now; `alloc` is
            // kept for any low-level allocation path. String literals and concat
            // also allocate (the 16-byte box + concat buffer), and struct_make
            // allocates the struct box — all pull in the heap/allocator runtime.
            if (r.ops[i].kind == "alloc" || r.ops[i].kind == "arr_make") { return true; }
            if (r.ops[i].kind == "const_str" || r.ops[i].kind == "str_concat") { return true; }
            if (r.ops[i].kind == "str_slice") { return true; }
            if (r.ops[i].kind == "struct_make") { return true; }
            if (r.ops[i].kind == "opt_make" || r.ops[i].kind == "opt_none") { return true; }
            if (r.ops[i].kind == "map_new" || r.ops[i].kind == "map_set") { return true; }
            if (r.ops[i].kind == "tuple_make") { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// emit_ir_runtime appends the array/RC/heap runtime the IR path needs, using
// asm.fern's OWN array layout + helper bodies (transcribed verbatim from
// asm.fern's emit_runtime) so the IR path is a byte-compatible DROP-IN: the
// 8-byte rc-header box (base = [cap, rc, len, e0..]; data = base+16; cap at
// data-16, rc at data-8, element i at data+(i+1)*8), the size-classed
// __fern_freelist allocator, and the stack-ABI rc helpers
// (__fn___fern_rc_inc / __fn___fern_arr_dec / …). asm.fern imports asm_ir
// (not the reverse), so these bodies are duplicated here rather than shared;
// the two emit paths are mutually exclusive per compile (emit_module vs
// emit_module_ir), so there is no symbol clash. Keep in sync with asm.fern.
function emit_ir_runtime(s: asmcore.EmitState): asmcore.EmitState {
    // .bss: heap bump pointer, the over-release detector, the size-classed
    // freelist (65536 classes * 8 bytes), and a 1 GiB zero-page heap.
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_heap_ptr: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_rc_underflow: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_freelist: .skip 524288\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_heap: .skip 1073741824\n");
    s = s.write("    .section .text\n");
    // __fern_alloc(%rdi = bytes) -> %rax = block. Size-classed freelist reuse
    // (class = bytes/8 < 65536) then bump; OOM traps with exit 137.
    s = s.write("__fern_alloc:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    addq $7, %rdi\n");
    s = s.write("    andq $-8, %rdi\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    pushq %rdx\n");
    s = s.write("    movq %rdi, %rcx\n");
    s = s.write("    shrq $3, %rcx\n");
    s = s.write("    cmpq $65536, %rcx\n");
    s = s.write("    jae .Lalloc_nofl\n");
    s = s.write("    leaq __fern_freelist(%rip), %rdx\n");
    s = s.write("    movq (%rdx,%rcx,8), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lalloc_nofl\n");
    s = s.write("    movq (%rax), %rdi\n");
    s = s.write("    movq %rdi, (%rdx,%rcx,8)\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_nofl:\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jne .Lalloc_inited\n");
    s = s.write("    leaq __fern_heap(%rip), %rax\n");
    s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
    s = s.write(".Lalloc_inited:\n");
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
    s = s.write("    addq %rax, %rdi\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    leaq __fern_heap(%rip), %rcx\n");
    s = s.write("    addq $1073741824, %rcx\n");
    s = s.write("    cmpq %rcx, %rdi\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    ja .Lalloc_oom\n");
    s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_oom:\n");
    s = s.write("    movq $60, %rax\n");
    s = s.write("    movq $137, %rdi\n");
    s = s.write("    syscall\n");
    // __fern_arr_box(%rdi = cap element count) -> %rax = data ptr (base+16).
    // base = [cap, rc=1, len=cap, e0..]; element i at data+(i+1)*8.
    s = s.write("__fern_arr_box:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rdi\n");
    s = s.write("    addq $3, %rdi\n");
    s = s.write("    shlq $3, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq -8(%rbp), %rdi\n");
    s = s.write("    movq %rdi, (%rax)\n");
    s = s.write("    movq $1, 8(%rax)\n");
    s = s.write("    movq %rdi, 16(%rax)\n");
    s = s.write("    addq $16, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    // RC helpers — stack-arg ABI (arg at 8(%rsp)); rc is the 32-bit field at
    // data-8. Guard chain: null / SSO inline tag / low-address / static
    // sentinel. __fn___fern_arr_dec frees (size-class freelist) at rc==1.
    s = s.write("__fn___fern_rc_inc:\n");
    s = s.write("    movq 8(%rsp), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lshrcinc_ret\n");
    s = s.write("    testb $1, %al\n");
    s = s.write("    jnz .Lshrcinc_ret\n");
    s = s.write("    cmpq $0x10000, %rax\n");
    s = s.write("    jb .Lshrcinc_ret\n");
    s = s.write("    movl -8(%rax), %ecx\n");
    s = s.write("    testl %ecx, %ecx\n");
    s = s.write("    js .Lshrcinc_ret\n");
    s = s.write("    addl $1, %ecx\n");
    s = s.write("    movl %ecx, -8(%rax)\n");
    s = s.write(".Lshrcinc_ret:\n");
    s = s.write("    ret\n");
    s = s.write("__fn___fern_rc_underflow_count:\n");
    s = s.write("    movl __fern_rc_underflow(%rip), %eax\n");
    s = s.write("    ret\n");
    s = s.write("__fn___fern_arr_dec:\n");
    s = s.write("    movq 8(%rsp), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Larrdec_ret\n");
    s = s.write("    cmpq $0x10000, %rax\n");
    s = s.write("    jb .Larrdec_ret\n");
    s = s.write("    movl -8(%rax), %ecx\n");
    s = s.write("    testl %ecx, %ecx\n");
    s = s.write("    js .Larrdec_ret\n");
    s = s.write("    cmpl $1, %ecx\n");
    s = s.write("    je .Larrdec_free\n");
    s = s.write("    jg .Larrdec_dec\n");
    s = s.write("    incl __fern_rc_underflow(%rip)\n");
    s = s.write("    jmp .Larrdec_ret\n");
    s = s.write(".Larrdec_dec:\n");
    s = s.write("    subl $1, %ecx\n");
    s = s.write("    movl %ecx, -8(%rax)\n");
    s = s.write("    jmp .Larrdec_ret\n");
    s = s.write(".Larrdec_free:\n");
    s = s.write("    movl $0, -8(%rax)\n");
    s = s.write("    movl -16(%rax), %ecx\n");
    s = s.write("    addq $3, %rcx\n");
    s = s.write("    cmpq $65536, %rcx\n");
    s = s.write("    jae .Larrdec_ret\n");
    s = s.write("    leaq -16(%rax), %rdx\n");
    s = s.write("    leaq __fern_freelist(%rip), %r8\n");
    s = s.write("    movq (%r8,%rcx,8), %rdi\n");
    s = s.write("    movq %rdi, (%rdx)\n");
    s = s.write("    movq %rdx, (%r8,%rcx,8)\n");
    s = s.write(".Larrdec_ret:\n");
    s = s.write("    ret\n");
    // String helpers — register-arg ABI (%rdi = box A, %rsi = box B), transcribed
    // verbatim from asm.fern's emit_runtime so the IR path's str_concat / str_eq
    // call the identical bodies. Gated on the needs the op handlers marked.
    if (s.has_need("str_concat")) {
        // __fern_str_concat: alloc lenA+lenB bytes, copy A then B, wrap in a
        // 16-byte box `[data@0, len@8]`. Returns box ptr in %rax.
        s = s.write("__fern_str_concat:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    pushq %rbx\n");
        s = s.write("    subq $8, %rsp\n");
        s = s.write("    movq %rdi, %r12\n");
        s = s.write("    movq %rsi, %r13\n");
        s = s.write("    movq 8(%r12), %r14\n");
        s = s.write("    movq 8(%r13), %r15\n");
        s = s.write("    movq %r14, %rdi\n");
        s = s.write("    addq %r15, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %rbx\n");
        s = s.write("    movq (%r12), %rsi\n");
        s = s.write("    movq %rbx, %rdi\n");
        s = s.write("    movq %r14, %rcx\n");
        s = s.write("    cmpq $0, %rcx\n");
        s = s.write("    je .Lstrconcat_b\n");
        s = s.write(".Lstrconcat_a_loop:\n");
        s = s.write("    movzbq (%rsi), %rax\n");
        s = s.write("    movb %al, (%rdi)\n");
        s = s.write("    incq %rsi\n");
        s = s.write("    incq %rdi\n");
        s = s.write("    decq %rcx\n");
        s = s.write("    jne .Lstrconcat_a_loop\n");
        s = s.write(".Lstrconcat_b:\n");
        s = s.write("    movq (%r13), %rsi\n");
        s = s.write("    movq %r15, %rcx\n");
        s = s.write("    cmpq $0, %rcx\n");
        s = s.write("    je .Lstrconcat_box\n");
        s = s.write(".Lstrconcat_b_loop:\n");
        s = s.write("    movzbq (%rsi), %rax\n");
        s = s.write("    movb %al, (%rdi)\n");
        s = s.write("    incq %rsi\n");
        s = s.write("    incq %rdi\n");
        s = s.write("    decq %rcx\n");
        s = s.write("    jne .Lstrconcat_b_loop\n");
        s = s.write(".Lstrconcat_box:\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rbx, (%rax)\n");
        s = s.write("    movq %r14, %rcx\n");
        s = s.write("    addq %r15, %rcx\n");
        s = s.write("    movq %rcx, 8(%rax)\n");
        s = s.write("    addq $8, %rsp\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    if (s.has_need("str_eq")) {
        // __fern_str_eq: 1 in %rax if both boxes have equal length and bytes.
        s = s.write("__fern_str_eq:\n");
        s = s.write("    movq 8(%rdi), %rcx\n");
        s = s.write("    cmpq 8(%rsi), %rcx\n");
        s = s.write("    jne .Lstreq_no\n");
        s = s.write("    movq (%rdi), %rdi\n");
        s = s.write("    movq (%rsi), %rsi\n");
        s = s.write("    cmpq $0, %rcx\n");
        s = s.write("    je .Lstreq_yes\n");
        s = s.write(".Lstreq_loop:\n");
        s = s.write("    movzbq (%rdi), %rax\n");
        s = s.write("    movzbq (%rsi), %rdx\n");
        s = s.write("    cmpq %rdx, %rax\n");
        s = s.write("    jne .Lstreq_no\n");
        s = s.write("    incq %rdi\n");
        s = s.write("    incq %rsi\n");
        s = s.write("    decq %rcx\n");
        s = s.write("    jne .Lstreq_loop\n");
        s = s.write(".Lstreq_yes:\n");
        s = s.write("    movq $1, %rax\n");
        s = s.write("    ret\n");
        s = s.write(".Lstreq_no:\n");
        s = s.write("    movq $0, %rax\n");
        s = s.write("    ret\n");
    }
    // __fern_str_cmp (transcribed verbatim from asm.fern): %rdi = box A, %rsi =
    // box B → signed in %rax (<0 A<B, 0 equal, >0 A>B); lexicographic byte
    // compare with length tiebreak. Drives string ordering (< <= > >=).
    if (s.has_need("str_cmp")) {
        s = s.write("__fern_str_cmp:\n");
        s = s.write("    movq 8(%rdi), %rcx\n");    // lenA
        s = s.write("    movq 8(%rsi), %rdx\n");    // lenB
        s = s.write("    movq %rcx, %r8\n");
        s = s.write("    cmpq %rdx, %r8\n");
        s = s.write("    jle .Lstrcmp_min\n");
        s = s.write("    movq %rdx, %r8\n");
        s = s.write(".Lstrcmp_min:\n");
        s = s.write("    movq (%rdi), %rdi\n");
        s = s.write("    movq (%rsi), %rsi\n");
        s = s.write("    cmpq $0, %r8\n");
        s = s.write("    je .Lstrcmp_len\n");
        s = s.write(".Lstrcmp_loop:\n");
        s = s.write("    movzbq (%rdi), %rax\n");
        s = s.write("    movzbq (%rsi), %r9\n");
        s = s.write("    cmpq %r9, %rax\n");
        s = s.write("    jne .Lstrcmp_byte_diff\n");
        s = s.write("    incq %rdi\n");
        s = s.write("    incq %rsi\n");
        s = s.write("    decq %r8\n");
        s = s.write("    jne .Lstrcmp_loop\n");
        s = s.write(".Lstrcmp_len:\n");
        s = s.write("    movq %rcx, %rax\n");
        s = s.write("    subq %rdx, %rax\n");
        s = s.write("    ret\n");
        s = s.write(".Lstrcmp_byte_diff:\n");
        s = s.write("    subq %r9, %rax\n");
        s = s.write("    ret\n");
    }
    // __fern_arr_slice (transcribed verbatim from asm.fern): %rdi = src arr,
    // %rsi = start, %rdx = end → a fresh array holding src[start:end] (copies the
    // 8-byte element payloads via __fern_arr_box). Drives array `a[start:end]`.
    if (s.has_need("arr_slice")) {
        s = s.write("__fern_arr_slice:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    pushq %r15\n");
        s = s.write("    movq %rdi, %r12\n");
        s = s.write("    movq %rsi, %r13\n");
        s = s.write("    movq %rdx, %r14\n");
        s = s.write("    movq %r14, %r15\n");
        s = s.write("    subq %r13, %r15\n");
        s = s.write("    movq %r15, %rdi\n");
        s = s.write("    call __fern_arr_box\n");
        s = s.write("    movq $0, %rcx\n");
        s = s.write(".Larr_slice_loop:\n");
        s = s.write("    cmpq %r15, %rcx\n");
        s = s.write("    jge .Larr_slice_done\n");
        s = s.write("    movq %r13, %rdx\n");
        s = s.write("    addq %rcx, %rdx\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    movq (%r12,%rdx,8), %rdi\n");
        s = s.write("    movq %rcx, %rdx\n");
        s = s.write("    incq %rdx\n");
        s = s.write("    movq %rdi, (%rax,%rdx,8)\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Larr_slice_loop\n");
        s = s.write(".Larr_slice_done:\n");
        s = s.write("    popq %r15\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }
    // Map runtime (transcribed from asm.fern) — only for map-using modules, so a
    // non-map heap program doesn't pull in map_set's __fern_str_eq dependency.
    if (s.has_need("maps")) {
    // __fern_alloc_u8 (transcribed from asm.fern for the IR map path).
    s = s.write(".globl __fern_alloc_u8\n");
    s = s.write(".type __fern_alloc_u8, @function\n");
    s = s.write("__fern_alloc_u8:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq %rdi, %r12\n");        // n
    s = s.write("    movq %r12, %rdi\n");        // cap = n
    s = s.write("    call __fern_arr_box\n");    // -> data ptr in %rax (cap + len written)
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_alloc_u8, .-__fern_alloc_u8\n");

    // __fern_arr_push (transcribed from asm.fern for the IR map path).
    s = s.write("__fern_arr_push:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r14\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    movq %rdi, %r12\n");        // arr ptr
    s = s.write("    movq %rsi, %r13\n");        // value
    s = s.write("    movq (%r12), %r14\n");      // len
    s = s.write("    movq -16(%r12), %r15\n");   // cap (hidden at -16; rc at -8)
    s = s.write("    cmpq %r15, %r14\n");
    s = s.write("    jge .Larr_push_grow\n");    // len >= cap → grow
    s = s.write("    movq %r14, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq %r13, (%r12,%rcx,8)\n");
    s = s.write("    incq %r14\n");
    s = s.write("    movq %r14, (%r12)\n");
    s = s.write("    movq %r12, %rax\n");
    s = s.write("    jmp .Larr_push_ret\n");
    s = s.write(".Larr_push_grow:\n");
    s = s.write("    movq %r15, %rcx\n");
    s = s.write("    cmpq $0, %rcx\n");
    s = s.write("    jne .Larr_push_dbl\n");
    s = s.write("    movq $4, %rcx\n");
    s = s.write("    jmp .Larr_push_cap\n");
    s = s.write(".Larr_push_dbl:\n");
    s = s.write("    shlq $1, %rcx\n");
    s = s.write(".Larr_push_cap:\n");
    s = s.write("    movq %rcx, %r15\n");        // r15 = newcap
    s = s.write("    movq %r15, %rdi\n");        // cap = newcap
    s = s.write("    call __fern_arr_box\n");    // -> data ptr in %rax (cap + len=cap written)
    s = s.write("    movq %r14, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq %rcx, (%rax)\n");      // new len = old+1 (overwrite helper's len)
    s = s.write("    movq $1, %rcx\n");
    s = s.write(".Larr_push_copy:\n");
    s = s.write("    cmpq %r14, %rcx\n");
    s = s.write("    jg .Larr_push_copy_done\n");
    s = s.write("    movq (%r12,%rcx,8), %rdx\n");
    s = s.write("    movq %rdx, (%rax,%rcx,8)\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Larr_push_copy\n");
    s = s.write(".Larr_push_copy_done:\n");
    s = s.write("    movq %r14, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq %r13, (%rax,%rcx,8)\n");
    s = s.write(".Larr_push_ret:\n");
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");

    // __fern_map_new (transcribed from asm.fern for the IR map path).
    s = s.write(".globl __fern_map_new\n");
    s = s.write(".type __fern_map_new, @function\n");
    s = s.write("__fern_map_new:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    subq $8, %rsp\n");
    s = s.write("    movq $16, %rdi\n");
    s = s.write("    call __fern_alloc\n");        // mapbox
    s = s.write("    movq %rax, %rbx\n");
    s = s.write("    movq $0, %rdi\n");
    s = s.write("    call __fern_alloc_u8\n");      // empty keys
    s = s.write("    movq %rax, (%rbx)\n");
    s = s.write("    movq $0, %rdi\n");
    s = s.write("    call __fern_alloc_u8\n");      // empty values
    s = s.write("    movq %rax, 8(%rbx)\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_new, .-__fern_map_new\n");

    // __fern_map_set (transcribed from asm.fern for the IR map path).
    s = s.write(".globl __fern_map_set\n");
    s = s.write(".type __fern_map_set, @function\n");
    s = s.write("__fern_map_set:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r14\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    movq %rdi, %r12\n");          // mapbox
    s = s.write("    movq %rsi, %r13\n");          // key
    s = s.write("    movq %rdx, %r14\n");          // val
    s = s.write("    movq (%r12), %r15\n");        // keys arr
    s = s.write("    movq $0, %rbx\n");            // i
    s = s.write("    testq %rcx, %rcx\n");          // keykind (1 = i32)
    s = s.write("    jnz .Lms_loop_i32\n");
    s = s.write(".Lms_loop:\n");                    // string-key loop
    s = s.write("    movq (%r15), %rax\n");        // keys.len
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lms_append\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdi\n");  // keys[i+1]
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    call __fern_str_eq\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lms_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lms_loop\n");
    s = s.write(".Lms_loop_i32:\n");                // i32-key loop
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lms_append\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rax\n");   // keys[i+1]
    s = s.write("    cmpq %r13, %rax\n");
    s = s.write("    je .Lms_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lms_loop_i32\n");
    s = s.write(".Lms_found:\n");
    s = s.write("    movq 8(%r12), %rax\n");        // values arr
    s = s.write("    movq %rbx, %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq %r14, (%rax,%rdx,8)\n");  // values[i+1] = val
    s = s.write("    jmp .Lms_ret\n");
    s = s.write(".Lms_append:\n");
    s = s.write("    movq (%r12), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    call __fern_arr_push\n");      // keys.append(key)
    s = s.write("    movq %rax, (%r12)\n");
    s = s.write("    movq 8(%r12), %rdi\n");
    s = s.write("    movq %r14, %rsi\n");
    s = s.write("    call __fern_arr_push\n");      // values.append(val)
    s = s.write("    movq %rax, 8(%r12)\n");
    s = s.write(".Lms_ret:\n");
    s = s.write("    movq %r12, %rax\n");
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_set, .-__fern_map_set\n");
    // __fern_map_get + __fern_map_has (transcribed from asm.fern).
    s = s.write(".globl __fern_map_get\n");
    s = s.write(".type __fern_map_get, @function\n");
    s = s.write("__fern_map_get:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    movq %rdi, %r12\n");          // mapbox
    s = s.write("    movq %rsi, %r13\n");          // key
    s = s.write("    movq (%r12), %r15\n");        // keys arr
    s = s.write("    movq $0, %rbx\n");
    s = s.write("    testq %rdx, %rdx\n");          // keykind (1 = i32)
    s = s.write("    jnz .Lmg_loop_i32\n");
    s = s.write(".Lmg_loop:\n");                    // string-key loop
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmg_none\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    call __fern_str_eq\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lmg_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmg_loop\n");
    s = s.write(".Lmg_loop_i32:\n");                // i32-key loop
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmg_none\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rax\n");
    s = s.write("    cmpq %r13, %rax\n");
    s = s.write("    je .Lmg_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmg_loop_i32\n");
    s = s.write(".Lmg_found:\n");
    s = s.write("    movq 8(%r12), %rax\n");        // values arr
    s = s.write("    movq %rbx, %rdx\n");
    s = s.write("    incq %rdx\n");
    s = s.write("    movq (%rax,%rdx,8), %r13\n");   // values[i+1]
    s = s.write("    movq $16, %rdi\n");
    s = s.write("    call __fern_alloc\n");          // Some box
    s = s.write("    movq $0, (%rax)\n");
    s = s.write("    movq %r13, 8(%rax)\n");
    s = s.write("    jmp .Lmg_ret\n");
    s = s.write(".Lmg_none:\n");
    s = s.write("    movq $16, %rdi\n");
    s = s.write("    call __fern_alloc\n");          // None box
    s = s.write("    movq $1, (%rax)\n");
    s = s.write(".Lmg_ret:\n");
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_get, .-__fern_map_get\n");
    s = s.write(".globl __fern_map_has\n");
    s = s.write(".type __fern_map_has, @function\n");
    s = s.write("__fern_map_has:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    movq %rdi, %r12\n");
    s = s.write("    movq %rsi, %r13\n");
    s = s.write("    movq (%r12), %r15\n");
    s = s.write("    movq $0, %rbx\n");
    s = s.write("    testq %rdx, %rdx\n");          // keykind (1 = i32)
    s = s.write("    jnz .Lmh_loop_i32\n");
    s = s.write(".Lmh_loop:\n");                    // string-key loop
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmh_no\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    call __fern_str_eq\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lmh_yes\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmh_loop\n");
    s = s.write(".Lmh_loop_i32:\n");                // i32-key loop
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmh_no\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rax\n");
    s = s.write("    cmpq %r13, %rax\n");
    s = s.write("    je .Lmh_yes\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmh_loop_i32\n");
    s = s.write(".Lmh_yes:\n");
