        // owns one) and the control block. A builder is not refcounted and has
        // no drop, so a handle that is never freed leaks, exactly as an fd that
        // is never closed does.
        s = s.write("__fern_buf_free:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    movq %rdi, %rbx\n");
        s = s.write("    testq %rbx, %rbx\n");
        s = s.write("    jz .Lbuffree_ret\n");
        s = s.write("    movq (%rbx), %rcx\n");
        s = s.write("    testq %rcx, %rcx\n");
        s = s.write("    jz .Lbuffree_ctl\n");
        s = s.write("    movq 16(%rbx), %rdx\n");
        s = s.write("    addq $7, %rdx\n");
        s = s.write("    shrq $3, %rdx\n");
        s = buf_block_free(s, "%rcx", "%rdx", "Lbuffree_data");
        s = s.write(".Lbuffree_ctl:\n");
        s = s.write("    movq %rbx, %rcx\n");
        s = s.write("    movq $4, %rdx\n");                    // 32 bytes = 4 words
        s = buf_block_free(s, "%rcx", "%rdx", "Lbuffree_ctlblk");
        s = s.write(".Lbuffree_ret:\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
