        s = s.write(s_one + ":\n    cmpq %r11, %r10\n    jae " + s_end + "\n");
        s = s.write("    movzbq (%r10), %r9\n");
        s = s.write("    cmpq $0, 8(%rdx,%r9,8)\n    jne " + hits[0] + "\n");
        s = s.write("    addq $1, %r10\n    jmp " + s_one + "\n");
        s = s.write(hits[3] + ":\n    addq $1, %r10\n");
        s = s.write(hits[2] + ":\n    addq $1, %r10\n");
        s = s.write(hits[1] + ":\n    addq $1, %r10\n");
        s = s.write(hits[0] + ":\n    subq %rax, %r10\n    pushq %r10\n    jmp " + s_done + "\n");
        s = s.write(s_short + ":\n");
        s = s.write("    cmpq %r8, %rcx\n    jge " + s_end + "\n");
        s = s.write("    movzbq (%rax,%rcx), %r10\n");
        s = s.write("    cmpq %r9, %r10\n    jae " + s_short_next + "\n");
        s = s.write("    cmpq $0, 8(%rdx,%r10,8)\n    jne " + s_hit + "\n");
        s = s.write(s_short_next + ":\n    addq $1, %rcx\n    jmp " + s_short + "\n");
        s = s.write(s_hit + ":\n    pushq %rcx\n    jmp " + s_done + "\n");
        s = s.write(s_end + ":\n    pushq %r8\n");
        s = s.write(s_done + ":\n");
        return s;
