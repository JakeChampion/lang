        s = s.write(a_avx + ":\n");
        s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
        s = s.write("    cmpq $32, %r9\n    jl " + a_avx_done + "\n");
        s = s.write("    vmovdqu (%rax,%rdx), %ymm0\n");
        s = s.write("    vpmovmskb %ymm0, %r9d\n    testl %r9d, %r9d\n    jnz " + a_hit32 + "\n");
        s = s.write("    addq $32, %rdx\n    jmp " + a_avx + "\n");
        s = s.write(a_hit32 + ":\n    vzeroupper\n    bsfl %r9d, %r9d\n    addq %r9, %rdx\n    jmp " + a_done + "\n");
        s = s.write(a_avx_done + ":\n    vzeroupper\n");
        s = s.write(a_vec + ":\n");
        s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
        s = s.write("    cmpq $16, %r9\n    jl " + a_tail + "\n");
        s = s.write("    movdqu (%rax,%rdx), %xmm0\n");
        s = s.write("    pmovmskb %xmm0, %r9d\n    testl %r9d, %r9d\n    jnz " + a_hit + "\n");
        s = s.write("    addq $16, %rdx\n    jmp " + a_vec + "\n");
        s = s.write(a_hit + ":\n    bsfl %r9d, %r9d\n    addq %r9, %rdx\n    jmp " + a_done + "\n");
        // Scalar tail: the final 0..15 bytes, and the whole algorithm for a
        // string shorter than one block.
        s = s.write(a_tail + ":\n");
        s = s.write("    cmpq %r8, %rdx\n    jge " + a_none + "\n");
        s = s.write("    movzbq (%rax,%rdx), %r9\n");
        // Zero-extended, so bit 7 is the high bit.
        s = s.write("    testq $128, %r9\n    jnz " + a_done + "\n");
        s = s.write("    addq $1, %rdx\n    jmp " + a_tail + "\n");
        // The miss value is the LENGTH, not -1 — the branch-free-skip
        // contract this op keeps everywhere.
        s = s.write(a_none + ":\n    movq %r8, %rdx\n");
        s = s.write(a_done + ":\n    pushq %rdx\n");
        return s;
    }
    if (o.kind_tag == 245) {  // mismatch
        return emit_mismatch_x86(s);
    }
    if (o.kind_tag == 104) {  // str_bytes
        // operand stack [str box]; __fern_str_bytes is a Fern runtime function now
        // (#2649): the box on the stack IS param[0] (at +16 after the call), so call
        // directly, pop the arg, push the result i32[]. mark_str_bytes pulls in
        // heap for the helper's pre-sized box.
        s = s.write("    call __fn___fern_str_bytes\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.mark_str_bytes(); return s;
    }
    if (o.kind_tag == 105) {  // str_split
        // operand stack [haystack box, sep box] (sep on top). Call the
        // Fern-compiled __fn___fern_str_split via the stack ABI: param[0]=haystack
        // on top (+16), param[1]=sep (+24). -> fresh string[] in %rax.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_split\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.mark_str_split(); return s;
    }
    if (o.kind_tag == 106 || o.kind_tag == 107) {  // str_to_upper, str_to_lower
        // operand stack [s box]; __fern_str_to_upper/_lower are Fern runtime
        // functions now (#2649): __fn_ stack convention — s already on the stack IS
        // param[0] (at +16), so call directly, pop the arg, push the result.
        var cfn: string = "__fn___fern_str_to_upper";
        if (o.kind_tag == 107) { cfn = "__fn___fern_str_to_lower"; }  // str_to_lower
        s = s.write("    call " + cfn + "\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.mark_str_case(); return s;
    }
    if (o.kind_tag == 108) {  // str_repeat
        // operand stack [s box, n] (n on top). Call the Fern-compiled
        // __fn___fern_str_repeat via the stack ABI: param[0]=s on top (+16),
        // param[1]=n below (+24). -> fresh string box in %rax.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_repeat\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.mark_str_repeat(); return s;
    }
    if (o.kind_tag == 109) {  // str_trim
        // operand stack [s box]; __fern_str_trim is a Fern runtime function now
        // (#2649): the s box already on the operand stack IS param[0] (at +16
        // after the call), so call directly, pop the arg, push the result.
        s = s.write("    call __fn___fern_str_trim\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.mark_str_trim(); return s;
    }
    if (o.kind_tag == 111) {  // str_replace
        // operand stack [haystack, old, new] (new on top). Call the Fern-compiled
        // __fn___fern_str_replace via the stack ABI: param[0]=haystack on top
        // (+16), param[1]=old (+24), param[2]=new (+32). -> fresh string box in %rax.
        s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_str_replace\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.mark_str_replace(); return s;
    }
    if (o.kind_tag == 113) {  // str_lines
        // operand stack [s box]; __fern_str_lines is a Fern runtime function now
        // (#2649): the s box already on the stack IS param[0] (at +16 after the
        // call), so call directly, pop the arg, push the result string[].
        // mark_str_lines pulls in its arr_push + heap deps.
        s = s.write("    call __fn___fern_str_lines\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.mark_str_lines(); return s;
    }
    // Guarded, so this tail is unreachable rather than a catch-all (#6917).
    // str_cmp used to sit here unguarded, which meant a tag added to
    // ir.is_str_op_kind without a branch here emitted a __fern_str_cmp call for
    // it — wrong code that looks plausible, the same failure class as the
    // comment fallback in ir_bin_asm.
    ircore.unsupported_op_refuse(o.kind_tag, "x86-64");
    return s;
}

// ---- The SSA backend: one function at a time, on the stack ABI -----------
//
// `-backend ssa` (docs/SELFHOST-SSA-BACKEND.md), the x86-64 twin of the emitter
// in asm_arm64_ir.fern and the only emitter on this ISA. Every lowered function
// is lifted by ssa_lift.lift_from_ir_prod and emitted from SSA form, its
// values in the linear-scan allocator's registers or in frame slots. The rbp
// frame, the caller-stack argument convention (param i at 16 + 8*i(%rbp),
// result in %rax) and every runtime symbol are the ones the stack machine
// this replaced used, so the runtime helpers and the flat-op arms it still
// runs are unchanged.
//
// Registers: %rax, %rsi, %rdi, %r8, %r9 and %r10 are the caller-saved pool;
// %rbx and %r12-%r15 are the callee-saved pool a value live across a call
// takes, saved once per function. %r11, %rcx and %rdx are scratch. A spilled
// value lives below the save area by its allocator slot (ssa_slot).

// Pool index 0 is %rax, the register the ABI returns a call's result in, so a
// call result allocated there needs no move.
function ssa_reg(k: i32): string {
    if (k == 0) { return "%rax"; }
    if (k == 1) { return "%rsi"; }
    if (k == 2) { return "%rdi"; }
    if (k == 3) { return "%r8"; }
    if (k == 4) { return "%r9"; }
    if (k == 5) { return "%r10"; }
    if (k == 6) { return "%rbx"; }
    return "%r" + util.i32_to_string(12 + k - 7);
}
function ssa_nregs(): i32 { return 6; }
function ssa_nsaved(): i32 { return 5; }
// A slot sits below the callee-saved registers' save area of `save` bytes.
function ssa_slot(v: i32, save: i32): string { return util.i32_to_string(0 - 8 * (v + 1) - save) + "(%rbp)"; }

// ssa_saved_regs is the callee-saved registers a function's allocation uses,
// lowest first; each takes one 8-byte push.
function ssa_saved_regs(reg_of: i32[]): i32[] {
    var used: i32[] = [];
    var k: i32 = ssa_nregs();
    while (k < ssa_nregs() + ssa_nsaved()) {
        var found: boolean = false;
        for h in reg_of { if (h == k) { found = true; } }
        if (found) { used = used.append(k); }
        k = k + 1;
    }
    return used;
}
function ssa_save_asm(saved: i32[]): string {
    var out: string = "";
    for k in saved { out = out + "    pushq " + ssa_reg(k) + "\n"; }
    return out;
}
// ssa_epilogue_for cuts %rsp back to the save area, pops the saved registers
// in reverse, and returns as the stack machine does.
function ssa_epilogue_for(saved: i32[]): string {
    if (saved.len() == 0) { return ssa_epilogue(); }
    var out: string = "    .cfi_remember_state\n    leaq -" + util.i32_to_string(8 * saved.len()) + "(%rbp), %rsp\n";
    var i: i32 = saved.len() - 1;
    while (i >= 0) { out = out + "    popq " + ssa_reg(saved[i]) + "\n"; i = i - 1; }
    return out + "    popq %rbp\n    .cfi_def_cfa %rsp, 8\n    ret\n    .cfi_restore_state\n";
}

// ssa_load puts value v in `reg`; ssa_store writes `reg` to value v's home.
function ssa_load(reg_of: i32[], v: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
    if (reg == "%r11") {
        if (s.ssa_x0 == v) { return s; }
        s = asmcore.EmitState { ...s, ssa_x0: v };
    }
    if (reg_of[v] < 0) { return s.write("    movq " + ssa_slot(ssa.spill_slot(reg_of[v]), s.ssa_save) + ", " + reg + "\n"); }
    var home: string = ssa_reg(reg_of[v]);
    if (home == reg) { return s; }
    return s.write("    movq " + home + ", " + reg + "\n");
}
// ssa_x0_forget marks %rax as holding no tracked value: at a label, and
// before a sequence that writes %rax on its own.
function ssa_x0_forget(s: asmcore.EmitState): asmcore.EmitState { return asmcore.EmitState { ...s, ssa_x0: 0 - 1 }; }
function ssa_store(reg_of: i32[], v: i32, reg: string, s: asmcore.EmitState): asmcore.EmitState {
    if (reg == "%r11") { s = asmcore.EmitState { ...s, ssa_x0: v }; }
    if (reg_of[v] == 0 - 1) { return s; }
    if (reg_of[v] < 0) { return s.write("    movq " + reg + ", " + ssa_slot(ssa.spill_slot(reg_of[v]), s.ssa_save) + "\n"); }
    var home: string = ssa_reg(reg_of[v]);
    if (home == reg) { return s; }
    return s.write("    movq " + reg + ", " + home + "\n");
}

// ssa_dst is where an instruction this emitter selects itself writes its
// result: the value's register home, or %rax for a value in a frame slot,
// which ssa_store then spills. ssa_src is where an operand is read from: its
// register home, or `scratch` once ssa_load has filled it. An instruction's
// result shares a register with an operand only when it is a phi or one of
// the two-operand integer ops, whose operand is read before the result is
// written; the allocator frees any other operand's register only after the
// instruction that last reads it.
function ssa_dst(reg_of: i32[], v: i32): string {
    if (reg_of[v] >= 0) { return ssa_reg(reg_of[v]); }
    return "%r11";
}
function ssa_src(reg_of: i32[], v: i32, scratch: string): string {
    if (reg_of[v] >= 0) { return ssa_reg(reg_of[v]); }
    return scratch;
}
// ssa_read brings a spilled operand into `scratch`, so ssa_src names where it
// is; a register-homed operand is read from its home and needs nothing.
function ssa_read(reg_of: i32[], v: i32, scratch: string, s: asmcore.EmitState): asmcore.EmitState {
    if (reg_of[v] >= 0) { return s; }
    return ssa_load(reg_of, v, scratch, s);
}
// The integer ops with a two-operand form `op src, dst`: they compute into the
// result's home with the left operand moved there first. Division works in
// %rdx:%rax and a shift's count in %cl, so those keep the scratch path.
function ssa_direct_bin(tag: i32): boolean {
    return tag == 21 || tag == 22 || tag == 23 || tag == 28 || tag == 29 || tag == 30 || ircore.is_int_cmp_kind(tag);
}
// A shift computes in the destination too, but only with the count known: the
// variable-count form reads %cl, which is not where an operand lives.
function ssa_shift_tag(tag: i32): boolean { return tag == 31 || tag == 32 || tag == 33; }
function ssa_commutative(tag: i32): boolean {
    return tag == 21 || tag == 23 || tag == 28 || tag == 29 || tag == 30 || tag == 35 || tag == 36;
}
// The ops whose right operand, or whose left operand when it can be turned
// round, may be an imm32 rather than a register: the two-operand forms and
// the compares. A shift count is %cl and a division's divisor a register.
function ssa_imm_right(): string[] { return ["add", "sub", "mul", "and", "or", "xor", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u", "shl", "shr_s", "shr_u", "div_s", "div_u", "rem_s", "rem_u"]; }
function ssa_imm_left(): string[] { return ["add", "mul", "and", "or", "xor", "eq", "ne", "lt_s", "le_s", "gt_s", "ge_s", "lt_u", "le_u", "gt_u", "ge_u"]; }
// ssa_rhs is a right operand as the instruction reads it: the immediate for a
// constant that has none, otherwise its home or the scratch; ssa_read_rhs
// fills the scratch only when there is a spilled value to fill it with.
function ssa_rhs(fr: SsaFrame, reg_of: i32[], v: i32, scratch: string): string {
    if (fr.imm.is_imm[v]) { return "$" + util.i64_to_string(fr.imm.value[v]); }
    return ssa_src(reg_of, v, scratch);
}
function ssa_read_rhs(fr: SsaFrame, reg_of: i32[], v: i32, scratch: string, s: asmcore.EmitState): asmcore.EmitState {
    if (fr.imm.is_imm[v]) { return s; }
    return ssa_read(reg_of, v, scratch, s);
}
// ssa_bin_in_place emits a two-operand integer op into the result's home,
// each operand read from its own: the left operand is moved into the
// destination and the op reads the right one where it lives, or as an
// immediate. A right operand that lives in the destination would be
// overwritten by that move, so the operands swap for a commutative op or a
// flipped comparison; a subtraction in that shape computes in the scratch
// and is stored after. A constant on the left is only ever one the op can
// take on the right, so it swaps the same way.
function ssa_bin_in_place(ins: ssa.SInst, reg_of: i32[], fr: SsaFrame, s: asmcore.EmitState): asmcore.EmitState {
    var tag: i32 = ir.kind_id(ins.str);
    var a: i32 = ins.args[0];
    var b: i32 = ins.args[1];
    var dh: string = ssa_dst(reg_of, ins.result);
    var swap: boolean = fr.imm.is_imm[a] && !ssa_shift_tag(tag);
    if (!swap && !fr.imm.is_imm[b] && ssa_src(reg_of, b, "%rcx") == dh) {
        if (ssa_commutative(tag) || ircore.flip_int_cmp_kind(tag) != tag) { swap = true; } else { dh = "%r11"; }
    }
    if (swap) {
        tag = ircore.flip_int_cmp_kind(tag);
        var t: i32 = a;
        a = b;
        b = t;
    }
    s = ssa_read_rhs(fr, reg_of, b, "%rcx", s);
    s = ssa_load(reg_of, a, dh, s);
    if (ssa_shift_tag(tag)) { s = s.write(shift_imm_asm(tag, ins.imm, fr.imm.value[b], dh)); }
    else { s = s.write(ir_bin_asm(tag, ins.imm, dh, ssa_rhs(fr, reg_of, b, "%rcx"))); }
    return ssa_store(reg_of, ins.result, dh, s);
}
// ssa_r32 and ssa_r8 are the 32-bit and 8-bit names of a 64-bit register.
function ssa_r32(r: string): string {
    if (r == "%rbx") { return "%ebx"; }
    if (r == "%rax") { return "%eax"; }
    if (r == "%rcx") { return "%ecx"; }
    if (r == "%rdx") { return "%edx"; }
    if (r == "%rsi") { return "%esi"; }
    if (r == "%rdi") { return "%edi"; }
    return r + "d";
}
function ssa_r8(r: string): string {
    if (r == "%rbx") { return "%bl"; }
    if (r == "%rax") { return "%al"; }
    if (r == "%rcx") { return "%cl"; }
    if (r == "%rdx") { return "%dl"; }
    if (r == "%rsi") { return "%sil"; }
    if (r == "%rdi") { return "%dil"; }
    return r + "b";
}
// ssa_const_reg materialises an integer literal in `d`: the zeroing xor, the
// narrow movl for a value in [0, 2^32) (five bytes, zero-extending), the
// imm32 movq for a negative one, movabsq for an i64 literal past 32 bits.
function ssa_const_reg(text: string, wide64: boolean, d: string, s: asmcore.EmitState): asmcore.EmitState {
    if (!const_text_u32(text)) {
        var wide: string = "movq";
        if (wide64) { wide = "movabsq"; }
        return s.write("    " + wide + " $" + text + ", " + d + "\n");
    }
    if (util.lit_to_i64(text) == 0i64) { return s.write("    xorl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n"); }
    return s.write("    movl $" + text + ", " + ssa_r32(d) + "\n");
}

// ssa_unary_known is the unary vocabulary lift_from_ir_prod produces.
function ssa_unary_known(what: string): boolean {
    if (what == "!" || what == "int_extend" || what == "int_wrap" || what == "u32_wrap" || what == "load_i32") { return true; }
    return util.str_has_prefix(what, "int_cast:") || ssa_funary_known(what) || ssa_bits_asm(what, "%rax") != "";
}

// ssa_funary_known is the f64 unary vocabulary lift_float_prod produces.
function ssa_funary_known(what: string): boolean {
    var un: string[] = ["fsqrt", "ffloor", "fceil", "ftrunc", "fabs", "fround", "fneg", "f64_to_i32", "f64_to_i64", "f32_bits", "f32_from_bits"];
    for x in un { if (x == what) { return true; } }
    return util.str_has_prefix(what, "i32_to_f64:");
}

function ssa_inst_known(ins: ssa.SInst): boolean {
    var k: i32 = ins.kind_tag;
    if (k == 10) { return ssa_unary_known(ins.str); }
    if (k >= 40 && k <= 60) { return true; }
    return k == 1 || k == 3 || k == 4 || k == 6 || k == 7 || k == 8 || k == 9 || k == 11;
}

// ssa_unsupported names the first instruction this emitter has no selection
// for, "" when it can emit the whole function.
function ssa_unsupported(f: ssa.SFunc): string {
    for blk in f.blocks {
        for ins in blk.insts {
            if (!ssa_inst_known(ins)) { return "ssa " + ssa.kind_name(ins.kind_tag) + " " + ins.str; }
        }
        if (blk.term.kind_tag > 3) { return "ssa terminator " + ssa.term_name(blk.term.kind_tag); }
    }
    return "";
}

// ssa_block_index maps a block id to its position in f.blocks (-1 for an id
// no block carries), built once per function; ssa_block_at reads it. The
// search this replaces ran once per edge.
function ssa_block_index(f: ssa.SFunc): i32[] {
    var most: i32 = 0;
    for blk in f.blocks { if (blk.id > most) { most = blk.id; } }
    var out: i32[] = [];
    var i: i32 = 0;
    while (i <= most) { out = out.append(0 - 1); i = i + 1; }
    var pos: i32 = 0;
    while (pos < f.blocks.len()) { out = out.with(f.blocks[pos].id, pos); pos = pos + 1; }
    return out;
}
function ssa_block_at(fr: SsaFrame, id: i32): i32 {
    if (id < 0 || id >= fr.blk_pos.len()) { return 0 - 1; }
    return fr.blk_pos[id];
}

function ssa_has_phis(f: ssa.SFunc, fr: SsaFrame, id: i32): boolean {
    var ti: i32 = ssa_block_at(fr, id);
    if (ti < 0) { return false; }
    for ins in f.blocks[ti].insts { if (ins.kind_tag == 8) { return true; } }
    return false;
}

// ssa_unary_asm is the stack machine's selection for the width ops, `not`
// and the f64 unaries, on %rax. A cast to a type none of the arms name moves
// nothing there either. `lb` is a per-op-unique label base for the saturating
// conversions and fround.
function ssa_unary_asm(what: string, unsigned: boolean, lb: string, d: string): string {
    var f: string = ssa_fmath_asm(what, d);
    if (f == "") { f = ssa_fconv_asm(what, unsigned, lb, d); }
    if (f == "") { f = ssa_bits_asm(what, d); }
    if (f != "") { return f; }
    if (what == "load_i32") { return "    movslq (" + d + "), " + d + "\n"; }
    if (what == "!") { return "    testq " + d + ", " + d + "\n    setz " + ssa_r8(d) + "\n    movzbq " + ssa_r8(d) + ", " + d + "\n"; }
    if (what == "u32_wrap" || what == "int_cast:u32") { return "    movl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n"; }
    if (what == "int_cast:u8") { return "    andq $255, " + d + "\n"; }
    if (what == "int_cast:i32") { return "    movslq " + ssa_r32(d) + ", " + d + "\n"; }
    if (what == "int_extend" || what == "int_wrap") {
        if (unsigned) { return "    movl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n"; }
        return "    movslq " + ssa_r32(d) + ", " + d + "\n";
    }
    return "";
}

// ssa_bits_asm is the bit counts on %rax at the width the name carries, as
// the stack machine's arms select them; "" for any other op.
function ssa_bits_asm(what: string, d: string): string {
    if (what == "clz:64") { return "    lzcntq " + d + ", " + d + "\n"; }
    if (what == "clz:32") { return "    lzcntl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n"; }
    if (what == "ctz:64") { return "    tzcntq " + d + ", " + d + "\n"; }
    if (what == "ctz:32") { return "    tzcntl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n"; }
    if (what == "popcount:64") { return "    popcntq " + d + ", " + d + "\n"; }
    if (what == "popcount:32") { return "    popcntl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n"; }
    return "";
}

// ssa_fmath_asm is the single-instruction f64 math on the pattern in %rax,
// as the stack machine's arms select it; "" for any other op.
function ssa_fmath_asm(what: string, d: string): string {
    var xmm: string = "";
    if (what == "fsqrt") { xmm = "    sqrtsd %xmm0, %xmm0\n"; }
    else if (what == "ffloor") { xmm = "    roundsd $1, %xmm0, %xmm0\n"; }
    else if (what == "fceil") { xmm = "    roundsd $2, %xmm0, %xmm0\n"; }
    else if (what == "ftrunc") { xmm = "    roundsd $3, %xmm0, %xmm0\n"; }
    if (xmm != "") { return "    movq " + d + ", %xmm0\n" + xmm + "    movq %xmm0, " + d + "\n"; }
    if (what == "fabs") { return "    movabsq $0x7fffffffffffffff, %rcx\n    andq %rcx, " + d + "\n"; }
    if (what == "fneg") { return "    movabsq $0x8000000000000000, %rcx\n    xorq %rcx, " + d + "\n"; }
    return "";
}

// ssa_fconv_asm is the f64 conversions and reinterprets on %rax, the
// saturating and rounding ones through the same cores the stack machine's
// arms wrap; "" for any other op.
function ssa_fconv_asm(what: string, unsigned: boolean, lb: string, d: string): string {
    if (what == "fround") { return ir_fround_rax(lb, d); }
    if (what == "f64_to_i32" || what == "f64_to_i64") {
        var w: i32 = 32;
        if (what == "f64_to_i64") { w = 64; }
        if (unsigned) { return ir_f2u_sat_rax(w, lb, d); }
        return ir_f2i_sat_rax(w, lb, d);
    }
    if (what == "i32_to_f64:64") { return ir_i2f_rax(64, unsigned, lb, d); }
    if (what == "i32_to_f64:32") { return ir_i2f_rax(32, unsigned, lb, d); }
    if (what == "f32_bits") { return "    movq " + d + ", %xmm0\n    cvtsd2ss %xmm0, %xmm0\n    movd %xmm0, " + ssa_r32(d) + "\n    movsxd " + ssa_r32(d) + ", " + d + "\n"; }
    if (what == "f32_from_bits") { return "    movd " + ssa_r32(d) + ", %xmm0\n    cvtss2sd %xmm0, %xmm0\n    movq %xmm0, " + d + "\n"; }
    return "";
}

// ssa_fbin_asm is one f64 binary with the patterns in %rax (lhs) and %rcx
// (rhs), the result pattern or 0/1 in %rax; "" for an integer op. The
// compares are the stack machine's NaN-correct ucomisd forms.
function ssa_fbin_asm(what: string, d: string): string {
    var ld: string = "    movq " + d + ", %xmm0\n    movq %rcx, %xmm1\n";
    var arith: string = "";
    if (what == "fadd") { arith = "addsd"; } else if (what == "fsub") { arith = "subsd"; }
    else if (what == "fmul") { arith = "mulsd"; } else if (what == "fdiv") { arith = "divsd"; }
    if (arith != "") { return ld + "    " + arith + " %xmm1, %xmm0\n    movq %xmm0, " + d + "\n"; }
    var cc: string = "";
    if (what == "flt") { cc = "    setb " + ssa_r8(d) + "\n    setnp %dl\n    andb %dl, " + ssa_r8(d) + "\n"; }
    else if (what == "fle") { cc = "    setbe " + ssa_r8(d) + "\n    setnp %dl\n    andb %dl, " + ssa_r8(d) + "\n"; }
    else if (what == "fgt") { cc = "    seta " + ssa_r8(d) + "\n"; }
    else if (what == "fge") { cc = "    setae " + ssa_r8(d) + "\n"; }
    else if (what == "feq") { cc = "    sete " + ssa_r8(d) + "\n    setnp %dl\n    andb %dl, " + ssa_r8(d) + "\n"; }
    else if (what == "fne") { cc = "    setne " + ssa_r8(d) + "\n    setp %dl\n    orb %dl, " + ssa_r8(d) + "\n"; }
    if (cc == "") { return ""; }
    return ld + "    ucomisd %xmm1, %xmm0\n    movq $0, " + d + "\n" + cc + "    movzbq " + ssa_r8(d) + ", " + d + "\n";
}

// ssa_fcall_sym is the runtime helper for a transcendental, "" otherwise.
function ssa_fcall_sym(what: string): string {
    if (what == "fsin") { return "__fern_sin_f64"; }
    if (what == "fcos") { return "__fern_cos_f64"; }
    if (what == "fexp") { return "__fern_exp_f64"; }
    if (what == "flog") { return "__fern_log_f64"; }
    if (what == "fpow") { return "__fern_pow_f64"; }
    return "";
}

// ssa_fcall calls a transcendental helper: the operand patterns in %xmm0 (and
// %xmm1 for fpow), the result pattern back from %xmm0.
function ssa_fcall(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    s = s.need("float_transcendentals");
    s = ssa_load(reg_of, ins.args[0], "%r11", s);
    if (ins.args.len() > 1) {
        s = ssa_load(reg_of, ins.args[1], "%rcx", s);
        s = s.write("    movq %rcx, %xmm1\n");
    }
    s = s.write("    movq %r11, %xmm0\n    call " + ssa_fcall_sym(ins.str) + "\n    movq %xmm0, %rax\n");
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}
// ssa_bin_work is the register a binary computes in: %rax for the four
// guarded divisions, which idiv fixes there, and the register path's own
// scratch for everything else.
function ssa_bin_work(op: string): string {
    var tag: i32 = ir.kind_id(op);
    if (tag == 24 || tag == 25 || tag == 26 || tag == 27) { return "%rax"; }
    return "%r11";
}

// ssa_binary is one binary op with the operands in %rax and %rcx: for the
// four div/rem kinds the literal-divisor forms when the divisor is a constant
// (ir_div_const, which reads nothing but %rax) and the guarded division
// otherwise (a per-op-unique label base), the f64 forms, ir_bin_asm for the
// rest.
function ssa_binary(ins: ssa.SInst, fr: SsaFrame, lp: string, d: string, s: asmcore.EmitState): asmcore.EmitState {
    var fb: string = ssa_fbin_asm(ins.str, d);
    if (fb != "") { return s.write(fb); }
    var tag: i32 = ir.kind_id(ins.str);
    if (tag == 24 || tag == 25 || tag == 26 || tag == 27) {
        var b: i32 = ins.args[1];
        if (fr.imm.konst[b]) { return s.write(ir_div_const(tag, ins.imm, fr.imm.value[b])); }
        return s.write(ir_div_guarded(tag, ins.imm, lp + "d" + util.i32_to_string(ins.result)));
    }
    return s.write(ir_bin_asm(tag, ins.imm, d, "%rcx"));
}
// With %rax an allocatable home, an arm that fills the ABI's argument
// registers in order can destroy a later argument. ssa_load_abi_args loads
// the argument homed in %rax first, into its own target, so nothing is read
// after it is written.
function ssa_load_abi_args(reg_of: i32[], args: i32[], regs: string[], s: asmcore.EmitState): asmcore.EmitState {
    var first: i32 = 0 - 1;
    var i: i32 = 1;
    while (i < args.len() && i < regs.len()) {
        if (reg_of[args[i]] == 0) { first = i; }
        i = i + 1;
    }
    if (first >= 0) { s = ssa_load(reg_of, args[first], regs[first], s); }
    i = 0;
    while (i < args.len() && i < regs.len()) {
        if (i != first) { s = ssa_load(reg_of, args[i], regs[i], s); }
        i = i + 1;
    }
    return s;
}

// ssa_push_operand stages one call argument: a push of the value's home,
// which is what the stack machine emits too. A spilled value pushes its slot
// directly, since the frame addresses from %rbp and the pushes do not move it,
// so an argument costs one instruction rather than a load and a push.
function ssa_push_operand(reg_of: i32[], v: i32, s: asmcore.EmitState): asmcore.EmitState {
    if (reg_of[v] < 0) { return s.write("    pushq " + ssa_slot(ssa.spill_slot(reg_of[v]), s.ssa_save) + "\n"); }
    return s.write("    pushq " + ssa_reg(reg_of[v]) + "\n");
}

// ssa_rc_prim renders one rc primitive inline, in the instructions its stub
// uses. Both skip a tagged pointer and anything below the heap floor, which
// is also every null. is_unique needs no test for a static sentinel's
// negative count, since a negative count never compares equal to one; rc_inc
// needs one, because it would otherwise increment it.
//
// The count is compared in memory, or read into %rdx first when the sanitizer
// checks it; the 0/1 is built in %rcx. Neither register is ever a home, so both
// survive a destination that IS the operand's register —
// the usual case once a result and its operand share one — and the
// destination is written after the last read of the operand.
//
// Every read of the count carries the sanitizer's poison check, as its stub's
// does — the uniqueness test no less than the retain. A stale reference that
// lands on the test rather than the retain would otherwise answer "not
// unique" and go unreported (#9889).
function ssa_rc_prim(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
    s = helper_call_needs(ins.str, s);
    s = ssa_read(reg_of, ins.args[0], "%r11", s);
    var p: string = ssa_src(reg_of, ins.args[0], "%r11");
    var done: string = lp + "rcinc" + util.i32_to_string(ins.result);
    if (ins.str == "__fern_rc_is_unique") { done = lp + "rcuniq" + util.i32_to_string(ins.result); }
    var rc: string = "-8(" + p + ")";
    var guard: string = "    testb $1, " + ssa_r8(p) + "\n    jnz " + done + "\n"
        + "    cmpq $0x10000, " + p + "\n    jb " + done + "\n";
    if (ins.str == "__fern_rc_is_unique") {
        var d: string = ssa_dst(reg_of, ins.result);
        s = s.write("    xorl %ecx, %ecx\n" + guard);
        s = s.write(ssa_rc_is_one(rc));
        s = s.write("    jne " + done + "\n");
        s = s.write("    movl $1, %ecx\n" + done + ":\n");
        s = s.write("    movq %rcx, " + d + "\n");
        return ssa_store(reg_of, ins.result, d, s);
    }
    s = s.write(guard);
    if (rc_free_debug_on()) {
        s = s.write("    movl " + rc + ", %ecx\n" + san_poison_check("%ecx"));
        s = s.write("    testl %ecx, %ecx\n    js " + done + "\n");
        s = s.write("    addl $1, %ecx\n    movl %ecx, " + rc + "\n");
    } else {
        s = s.write("    cmpl $0, " + rc + "\n    js " + done + "\n    addl $1, " + rc + "\n");
    }
    s = s.write(done + ":\n");
    // rc_inc hands the pointer back; a result with no home stores nothing.
    return ssa_store(reg_of, ins.result, p, s);
}

// ssa_helper_call calls a runtime helper through its register entry.
function ssa_helper_call(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = helper_call_needs(ins.str, s);
    var hsrc: i32[] = [];
    var hdst: i32[] = [];
    var ha: i32 = 0;
    while (ha < ins.args.len()) { hsrc = hsrc.append(reg_of[ins.args[ha]]); hdst = hdst.append(ha); ha = ha + 1; }
    s = ssa_parallel_moves(hsrc, hdst, s);
    s = s.write("    call " + ircore.ir_helper_symbol(ins.str) + ".r\n");
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_rc_dec renders an array or string release inline where the count
// survives it: below the heap floor (every null), an inline string's tag bit,
// a static box's negative count, and a count above one, which is decremented
// in memory. A count of one (the free) or zero (the underflow the helper
// reports) calls the helper. Either way the pointer is the result, as the
// helper leaves it in %rax.
function ssa_rc_dec(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
    s = helper_call_needs(ins.str, s);
    s = ssa_read(reg_of, ins.args[0], "%r11", s);
    var p: string = ssa_src(reg_of, ins.args[0], "%r11");
    var id: string = util.i32_to_string(ins.result);
    var dec: string = lp + "rcdecd" + id;
    var kept: string = lp + "rcdeck" + id;
    var done: string = lp + "rcdece" + id;
    var rc: string = "-8(" + p + ")";
    if (ins.str == "__fern_str_free") { s = s.write("    testb $1, " + ssa_r8(p) + "\n    jnz " + kept + "\n"); }
    s = s.write("    cmpq $0x10000, " + p + "\n    jb " + kept + "\n");
    s = s.write("    cmpl $1, " + rc + "\n    jg " + dec + "\n");
    s = s.write("    cmpl $0, " + rc + "\n    js " + kept + "\n");
    s = ssa_helper_call(ins, reg_of, s);
    s = s.write("    jmp " + done + "\n" + dec + ":\n    subl $1, " + rc + "\n" + kept + ":\n");
    s = ssa_store(reg_of, ins.result, p, s);
    return s.write(done + ":\n");
}

// ssa_call emits one call as the stack machine leaves it: the arguments pushed
// in IR order for a runtime helper and reversed for a user function (arg0 on
// top), the callee, the caller-side pop, and %rax stored.
function ssa_call(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
    if (ssa.rc_inlined(ins)) { return ssa_rc_prim(ins, reg_of, lp, s); }
    s = ssa_x0_forget(s);
    if ((ins.str == "__fern_rc_dec" || ins.str == "__fern_str_free") && ins.args.len() == 1 && !rc_free_debug_on()) { return ssa_rc_dec(ins, reg_of, lp, s); }
    if (ircore.is_fern_helper(ins.str) && ssa_reg_helper(ircore.ir_helper_symbol(ins.str), ins.args.len())) {
        return ssa_helper_call(ins, reg_of, s);
    }
    if (ssa_reg_call(ins, s)) {
        // Only this call's own arguments can be in the pool's registers here:
        // anything live across it is callee-saved or in a slot.
        var srcs: i32[] = [];
        var dsts: i32[] = [];
        var a: i32 = 0;
        while (a < ins.args.len()) { srcs = srcs.append(reg_of[ins.args[a]]); dsts = dsts.append(a); a = a + 1; }
        s = ssa_parallel_moves(srcs, dsts, s);
        s = s.write("    call __fn_" + asmcore.sanitize_label(ins.str) + ".r\n");
        return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
    }
    var argc: i32 = ins.args.len();
    var helper: boolean = ircore.is_fern_helper(ins.str);
    if (helper) { s = helper_call_needs(ins.str, s); }
    else if (ircore.is_c_call(ins.str)) { s = s.need("ccall:" + ins.str); }
    var i: i32 = 0;
    while (i < argc) {
        var a: i32 = i;
        if (!helper) { a = argc - 1 - i; }
        s = ssa_push_operand(reg_of, ins.args[a], s);
        i = i + 1;
    }
    if (helper) { s = s.write("    call " + ircore.ir_helper_symbol(ins.str) + "\n"); }
    else { s = s.write("    call __fn_" + asmcore.sanitize_label(ins.str) + "\n"); }
    if (argc > 0) { s = s.write("    addq $" + util.i32_to_string(argc * 8) + ", %rsp\n"); }
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}


// ssa_mem_inst selects the production lift's memory kinds (ssa.fern 40..44)
// with the instructions the stack machine's own arms use, operands in
// %rax/%rcx/%rdx.
function ssa_mem_inst(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    var k: i32 = ins.kind_tag;
    var a: string = ssa_src(reg_of, ins.args[0], "%r11");
    s = ssa_load(reg_of, ins.args[0], a, s);
    var d: string = ssa_dst(reg_of, ins.result);
    if (k == 40) {
        s = s.write("    movq " + util.i32_to_string(ins.imm) + "(" + a + "), " + d + "\n");
        return ssa_store(reg_of, ins.result, d, s);
    }
    var b: string = ssa_src(reg_of, ins.args[1], "%rcx");
    s = ssa_load(reg_of, ins.args[1], b, s);
    if (k == 41 && ins.str == "i32") { return s.write("    movl " + ssa_r32(b) + ", (" + a + ")\n"); }
    if (k == 41) { return s.write("    movq " + b + ", " + util.i32_to_string(ins.imm) + "(" + a + ")\n"); }
    if (k == 42) {
        s = s.need("heap");
        if (ins.imm != 1) { s = s.write("    cmpq (" + a + "), " + b + "\n    jae __fern_oob_abort\n"); }
        s = s.write("    movq 8(" + a + "," + b + ",8), " + d + "\n");
        return ssa_store(reg_of, ins.result, d, s);
    }
    if (k == 44) {
        s = s.need("heap");
        if (ins.imm != 1) { s = s.write("    cmpq 8(" + a + "), " + b + "\n    jae __fern_oob_abort\n"); }
        s = s.write("    movq (" + a + "), %rdx\n    movzbl (%rdx," + b + "), " + ssa_r32(d) + "\n");
        return ssa_store(reg_of, ins.result, d, s);
    }
    var c: string = ssa_src(reg_of, ins.args[2], "%rdx");
    s = ssa_load(reg_of, ins.args[2], c, s);
    s = s.need("heap");
    return s.write("    cmpq (" + a + "), " + b + "\n    jae __fern_oob_abort\n    movq " + c + ", 8(" + a + "," + b + ",8)\n");
}

// ssa_str_call is the stack machine's call of a Fern-compiled runtime helper
// for a string or slice op: arguments pushed with the first on top, the
// helper's need marked as the flat arm marks it.
function ssa_str_call(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    s = ssa_str_marks(ins.str, s);
    var argc: i32 = ins.args.len();
    var i: i32 = argc - 1;
    while (i >= 0) {
        s = ssa_push_operand(reg_of, ins.args[i], s);
        i = i - 1;
    }
    s = s.write("    call __fn___fern_" + ssa_str_target(ins.str) + "\n");
    if (argc > 0) { s = s.write("    addq $" + util.i32_to_string(argc * 8) + ", %rsp\n"); }
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

function ssa_str_target(op: string): string {
    if (op == "str_from_bytes") { return "string_from_bytes"; }
    if (op == "read_chunk") { return "reader_read_chunk"; }
    return op;
}

// ssa_host_need is the need a host helper on the stack ABI carries besides
// the heap, "" for an op that is not one; the three that need no heap are
// named by ssa_host_bare.
function ssa_host_need(op: string): string {
    var fs: string[] = ["read_file", "read_file_bytes", "write_file", "write_file_exec", "remove_dir_all", "remove_file",
        "create_dir_all", "read_dir", "read_dir_all", "env", "stat", "lstat", "subprocess", "writer_write"];
    for x in fs { if (x == op) { return op; } }
    if (op == "read_line") { return "str_read_line"; }
    if (op == "read_chunk" || op == "reader_close") { return "reader"; }
    return "";
}
function ssa_host_bare(op: string): boolean {
    return op == "putchar" || op == "monotonic_ns" || op == "now_unix_ms";
}

function ssa_str_marks(op: string, s: asmcore.EmitState): asmcore.EmitState {
    if (op == "temp_dir") { return s.need("heap").need("monotonic_ns").need("temp_dir"); }
    if (ssa_host_need(op) != "") { return s.need("heap").need(ssa_host_need(op)); }
    if (ssa_host_bare(op)) { return s.need(op); }
    if (op == "str_concat") { return s.mark_str_concat(); }
    if (op == "str_eq") { return s.mark_str_eq(); }
    if (op == "str_cmp") { return s.mark_str_cmp(); }
    if (op == "arr_slice") { return s.mark_arr_slice(); }
    if (op == "print_str") { return s.need("str_print"); }
    if (op == "eprint_str") { return s.need("eprint"); }
    s = s.need("heap");
    return s.need("str_from_bytes");
}

// ssa_host_kind names the register-ABI ops ssa_host_call selects: the raw
// syscalls, exit, the string box stamp and the string builder.
function ssa_host_kind(op: string): boolean {
    return util.str_has_prefix(op, "syscall") || op == "exit" || op == "raw_string" || util.str_has_prefix(op, "strbuf_");
}

// ssa_host_call emits the host-floor ops as the stack machine's arms do. A
// syscall pushes its operands and then runs the flat arm's pop sequence, so
// no allocatable register is written before every operand has been read.
function ssa_host_call(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    if (util.str_has_prefix(ins.str, "syscall")) {
        var i: i32 = 0;
        while (i < ins.args.len()) {
            s = ssa_push_operand(reg_of, ins.args[i], s);
            i = i + 1;
        }
        var regs: string[] = ["%rdi", "%rsi", "%rdx", "%r10", "%r8", "%r9"];
        var a: i32 = ins.args.len() - 2;
        while (a >= 0) { s = s.write("    popq " + regs[a] + "\n"); a = a - 1; }
        s = s.write("    popq %rax\n    syscall\n");
        return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
    }
    if (ins.str == "exit") {
        s = ssa_load(reg_of, ins.args[0], "%r11", s);
        if (leak_check_on()) { s = s.write("    pushq %r11\n    call __fern_lc_report\n    popq %r11\n"); }
        s = s.write("    movq %r11, %rdi\n    movq $60, %rax\n    syscall\n    xorl %eax, %eax\n");
        return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
    }
    s = s.need("heap");
    if (ins.str == "raw_string") {
        s = ssa_load(reg_of, ins.args[0], "%r11", s);
        s = ssa_load(reg_of, ins.args[1], "%rcx", s);
        s = s.write("    movq %r11, %rdi\n    movq %rcx, %rsi\n    call __fern_str_box_hdr\n");
        return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
    }
    s = s.need("strbuf");
    if (ins.args.len() > 0) { s = ssa_load(reg_of, ins.args[0], "%r11", s); s = s.write("    movq %r11, %rdi\n"); }
    s = s.write("    call __fern_" + ins.str + "\n");
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

function ir_memcpy_asm(): string { return "    popq %rcx\n    popq %rsi\n    popq %rdi\n    rep movsb\n    pushq $0\n"; }
function ir_memset_asm(): string { return "    popq %rcx\n    popq %rax\n    popq %rdi\n    cld\n    rep stosb\n    pushq $0\n"; }

// ssa_dyn_dispatch runs the dyn dispatch chain on the register path, each
// argument read from its home. %rax is the chain's own scratch, so a value
// living there moves to %r11 first; the allocator counts the instruction
// as a call, so nothing live across it is in a caller-saved register.
function ssa_dyn_dispatch(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    var args: asmcore.DynArg[] = [];
    var moved: boolean = false;
    for v in ins.args {
        if (reg_of[v] >= 0) {
            var home: string = ssa_reg(reg_of[v]);
            if (home == "%rax") {
                if (!moved) { s = s.write("    movq %rax, %r11\n"); moved = true; }
                home = "%r11";
            }
            args = args.append(asmcore.DynArg { reg: home, off: 0 });
        } else {
            args = args.append(asmcore.DynArg { reg: "", off: 0 - 8 * (ssa.spill_slot(reg_of[v]) + 1) - s.ssa_save });
        }
    }
    s = emit_dyn_dispatch_chain(ins.str, args, ins.imm, lp, s);
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_flat_op runs the stack machine's own arm for the op at index `ins.imm`
// between a push of the operands and a pop of the result. The allocator
// treats the op as a call, so the registers the arm writes hold nothing live;
// its labels take the op's index under the SSA function's prefix.
function ssa_flat_op(ins: ssa.SInst, reg_of: i32[], lp: string, r: irlower.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
    if (asmcore.buf_helper(r.ops[ins.imm].kind_tag) != "") { return ssa_buf_call(ins, reg_of, asmcore.buf_helper(r.ops[ins.imm].kind_tag), s); }
    s = ssa_x0_forget(s);
    var outer: usize = s.capture;
    var h: usize = buf_new(256);
    s = emit_stack_op(r.ops[ins.imm], ins.imm, lp, r, asmcore.EmitState { ...s, capture: h });
    var arm: string = buf_take(h);
    s = asmcore.EmitState { ...s, capture: outer };
    var pops: string[] = ssa_leading_pops(arm, ins.args.len());
    var moves: SsaArgMoves = ssa_arg_moves(ins, reg_of, pops, s);
    if (!moves.ok) { pops = []; moves = ssa_arg_moves(ins, reg_of, pops, s); }
    var i: i32 = 0;
    while (i < ins.args.len() - pops.len()) {
        s = ssa_push_operand(reg_of, ins.args[i], s);
        i = i + 1;
    }
    for m in moves.text { s = s.write(m); }
    var body: string = slice_unchecked(arm, ssa_pops_len(pops), arm.len()) + "";
    var result: string = ssa_trailing_push(body);
    if (result != "") {
        s = s.write(slice_unchecked(body, 0, body.len() - ssa_push_line(result).len()) + "");
        return ssa_store(reg_of, ins.result, result, ssa_x0_forget(s));
    }
    s = s.write(body + "    popq %rax\n");
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// An arm starts by popping its operands, the last operand first. The register
// path loads those operands into the registers the pops name instead, and
// runs the rest of the arm; operands the arm does not pop that way are pushed
// as before, beneath where the pops would have read.
function ssa_pop_line(reg: string): string { return "    popq " + reg + "\n"; }
function ssa_push_line(reg: string): string { return "    pushq " + reg + "\n"; }

function ssa_pops_len(pops: string[]): i32 {
    var n: i32 = 0;
    for p in pops { n = n + ssa_pop_line(p).len(); }
    return n;
}

// ssa_leading_pops lists the registers the arm's first lines pop into, at
// most `limit` of them.
function ssa_leading_pops(arm: string, limit: i32): string[] {
    var out: string[] = [];
    var at: i32 = 0;
    while (out.len() < limit) {
        var reg: string = ssa_line_reg(arm, at, "    popq %");
        if (reg == "") { return out; }
        out = out.append(reg);
        at = at + ssa_pop_line(reg).len();
    }
    return out;
}

// ssa_trailing_push is the register a body's last line pushes, "" when its
// last line is anything else.
function ssa_trailing_push(body: string): string {
    var at: i32 = body.len() - 1;
    if (at < 0 || body[at] != 10) { return ""; }
    at = at - 1;
    while (at >= 0 && body[at] != 10) { at = at - 1; }
    var reg: string = ssa_line_reg(body, at + 1, "    pushq %");
    if (reg == "" || at + 1 + ssa_push_line(reg).len() != body.len()) { return ""; }
    return reg;
}

// ssa_line_reg reads `%reg` from a line at `at` that is `prefix` then one
// register name and a newline, or "".
function ssa_line_reg(text: string, at: i32, prefix: string): string {
    if (at + prefix.len() > text.len()) { return ""; }
    if (slice_unchecked(text, at, at + prefix.len()) != prefix) { return ""; }
    var end: i32 = at + prefix.len();
    while (end < text.len() && text[end] != 10) {
        var c: i32 = text[end] as i32;
        if (!(c >= 97 && c <= 122 || c >= 48 && c <= 57)) { return ""; }
        end = end + 1;
    }
    if (end >= text.len() || end == at + prefix.len()) { return ""; }
    return slice_unchecked(text, at + prefix.len() - 1, end) + "";
}

struct SsaArgMoves { ok: boolean, text: string[] }

// ssa_arg_moves loads the popped operands into their registers as one
// parallel move: a load goes once no pending load still reads its register.
// A cycle is refused, and the arm then takes every operand from the stack.
function ssa_arg_moves(ins: ssa.SInst, reg_of: i32[], pops: string[], s: asmcore.EmitState): SsaArgMoves {
    var srcs: string[] = [];
    var dsts: string[] = [];
    var k: i32 = 0;
    while (k < pops.len()) {
        var v: i32 = ins.args[ins.args.len() - 1 - k];
        var src: string = ssa_home_name(reg_of, v);
        if (src == "") { src = ssa_slot(ssa.spill_slot(reg_of[v]), s.ssa_save); }
        if (src != pops[k]) { srcs = srcs.append(src); dsts = dsts.append(pops[k]); }
        k = k + 1;
    }
    var done: boolean[] = [];
    for d in dsts { done = done.append(false); }
    var out: string[] = [];
    var left: i32 = dsts.len();
    while (left > 0) {
        var progressed: boolean = false;
        var i: i32 = 0;
        while (i < dsts.len()) {
            if (!done[i] && !ssa_still_read(srcs, done, dsts[i], i)) {
                out = out.append("    movq " + srcs[i] + ", " + dsts[i] + "\n");
                done = done.with(i, true);
                left = left - 1;
                progressed = true;
            }
            i = i + 1;
        }
        if (!progressed) { return SsaArgMoves { ok: false, text: [] }; }
    }
    return SsaArgMoves { ok: true, text: out };
}

function ssa_still_read(srcs: string[], done: boolean[], reg: string, self: i32): boolean {
    var j: i32 = 0;
    while (j < srcs.len()) {
        if (j != self && !done[j] && srcs[j] == reg) { return true; }
        j = j + 1;
    }
    return false;
}

function ssa_arg_regs(): string[] { return ["%rdi", "%rsi", "%rdx", "%rcx"]; }

// ssa_buf_call calls a builder helper with its operands loaded straight into
// the argument registers. %rdx and %rcx are never a home, so they load first;
// the %rdi / %rsi pair then goes in whichever order reads each source before
// it is written, or swaps.
function ssa_buf_call(ins: ssa.SInst, reg_of: i32[], sym: string, s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    var i: i32 = 2;
    while (i < ins.args.len()) {
        s = ssa_load(reg_of, ins.args[i], ssa_arg_regs()[i], s);
        i = i + 1;
    }
    if (ins.args.len() == 1) { s = ssa_load(reg_of, ins.args[0], "%rdi", s); }
    if (ins.args.len() >= 2) {
        var h0: string = ssa_home_name(reg_of, ins.args[0]);
        var h1: string = ssa_home_name(reg_of, ins.args[1]);
        if (h0 == "%rsi" && h1 == "%rdi") {
            s = s.write("    xchgq %rdi, %rsi\n");
        } else if (h1 == "%rdi") {
            s = ssa_load(reg_of, ins.args[1], "%rsi", s);
            s = ssa_load(reg_of, ins.args[0], "%rdi", s);
        } else {
            s = ssa_load(reg_of, ins.args[0], "%rdi", s);
            s = ssa_load(reg_of, ins.args[1], "%rsi", s);
        }
    }
    s = s.write("    call " + sym + "\n");
    s = s.need("heap");
    s = s.need("buf");
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_home_name is a value's register, or "" for a frame slot.
function ssa_home_name(reg_of: i32[], v: i32): string {
    if (reg_of[v] < 0) { return ""; }
    return ssa_reg(reg_of[v]);
}

// The need whose gate defines a floor symbol, so an address taken outside the
// helpers that already mark it still links.
function sym_addr_need(sym: string): string {
    if (sym == "__fern_scratch") { return "raw_scratch"; }
    if (sym == "__fern_envp") { return "raw_environ"; }
    if (sym == "__fern_splice_pipe") { return "raw_splice_pipe"; }
    return "";
}

// ssa_sym_addr is a static symbol's address, or the word at it (imm 1).
function ssa_sym_addr(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    if (util.str_has_prefix(ins.str, "__fern_arr_push_")) { s = s.need("heap"); }
    if (sym_addr_need(ins.str) != "") { s = s.need(sym_addr_need(ins.str)); }
    var d: string = ssa_dst(reg_of, ins.result);
    if (ins.imm == 1) { s = s.write("    movq " + ins.str + "(%rip), " + d + "\n"); }
    else { s = s.write("    leaq " + ins.str + "(%rip), " + d + "\n"); }
    return ssa_store(reg_of, ins.result, d, s);
}

// ssa_rt_call is the stack machine's call of a runtime routine on the register
// ABI: the arguments in %rdi, %rsi, the result in %rax.
function ssa_rt_call(ins: ssa.SInst, reg_of: i32[], lp: string, s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    s = s.need("heap");
    var sym: string = "__fern_alloc";
    if (ins.str == "alloc_u8") { s = s.need("alloc_u8"); sym = "__fern_alloc_u8"; }
    else if (ins.str == "struct_copy") { sym = "__fn___fern_struct_copy"; }
    else if (ins.str == "raw_arr_box") { sym = "__fern_arr_box"; }
    else if (ins.str == "map_new") { s = s.need("maps"); sym = "__fern_map_new"; }
    else if (ins.str == "args") { s = s.need("args"); sym = "__fern_args"; }
    else if (ins.str == "map_hash_seed") { s = s.need("random_i32").need("map_hash_seed"); sym = "__fern_map_hash_seed"; }
    else if (util.str_has_prefix(ins.str, "arr_push_owned")) { s = s.mark_arr_push(); s = s.need("arr_push_owned"); sym = "__fern_arr_push_owned"; }
    else if (util.str_has_prefix(ins.str, "arr_push")) { s = s.mark_arr_push(); sym = "__fern_arr_push"; }
    var srcs: i32[] = [];
    var dsts: i32[] = [];
    var a: i32 = 0;
    while (a < ins.args.len() && a < 2) { srcs = srcs.append(reg_of[ins.args[a]]); dsts = dsts.append(ssa_rt_arg_reg(a)); a = a + 1; }
    s = ssa_parallel_moves(srcs, dsts, s);
    // raw_alloc asks for 24 bytes more and hands back the pointer past them,
    // the string box header a buffer may later grow (#7351).
    if (ins.str == "raw_alloc") {
        s = s.write("    testl %edi, %edi\n    js __fern_alloc_size_abort\n");
        s = s.write("    addq $24, %rdi\n");
    }
    if (util.str_has_prefix(ins.str, "arr_push") && ins.result >= 0 && !rc_free_debug_on()) { s = s.write(arr_push_inline(sym, lp + "apush" + util.i32_to_string(ins.result))); }
    else { s = s.write("    call " + sym + "\n"); }
    if (ins.str == "raw_alloc") { s = s.write("    addq $24, %rax\n"); }
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// arr_push_inline is arr_push_fast at the call site, calling `sym` only when
// the receiver has no free slot or is shared.
function arr_push_inline(sym: string, l: string): string {
    return "    movq (%rdi), %rdx\n    cmpq -16(%rdi), %rdx\n    jge " + l + "s\n"
        + "    movq -8(%rdi), %rcx\n    cmpq $1, %rcx\n    je " + l + "o\n"
        + "    btq $31, %rcx\n    jnc " + l + "s\n"
        + l + "o:\n    movq %rsi, 8(%rdi,%rdx,8)\n    incq %rdx\n    movq %rdx, (%rdi)\n"
        + "    movq %rdi, %rax\n    jmp " + l + "e\n"
        + l + "s:\n    call " + sym + "\n" + l + "e:\n";
}

// ssa_is_rt_call is a kind-50 call that ssa_rt_call emits: neither a
// transcendental nor a host call, which stage their own arguments.
function ssa_is_rt_call(ins: ssa.SInst): boolean {
    return ins.kind_tag == 50 && ssa_fcall_sym(ins.str) == "" && !ssa_host_kind(ins.str);
}

// ssa_rt_arg_reg is the allocator index of argument `a`'s register.
function ssa_rt_arg_reg(a: i32): i32 { if (a == 0) { return 2; } return 1; }

// ssa_view_slots gives each frame-resident string view (kind 51, imm 1) the
// index of its three frame words, in instruction order, and -1 to every other
// value; ssa_view_count is how many there are. The words sit after the spill
// slots.
function ssa_view_slots(f: ssa.SFunc): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < f.nvals) { out = out.append(0 - 1); i = i + 1; }
    var n: i32 = 0;
    for blk in f.blocks {
        for ins in blk.insts {
            if (ins.kind_tag == 51 && ins.imm == 1) { out = out.with(ins.result, n); n = n + 1; }
        }
    }
    return out;
}
function ssa_view_count(views: i32[]): i32 {
    var n: i32 = 0;
    for v in views { if (v >= 0) { n = n + 1; } }
    return n;
}

// ssa_str_view is the string slice kernel of emit_ir_str_op with register
// operands: the two bounds checks, then the {rc -1, data + lo, hi - lo} box
// either in the frame words this site owns or freshly allocated. The operands
// are read before the allocation and carried across it on the machine stack,
// since the call clobbers every register they could live in.
function ssa_str_view(ins: ssa.SInst, reg_of: i32[], base_off: i32, s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    s = s.need("heap");
    s = ssa_load(reg_of, ins.args[0], "%rdx", s);
    s = ssa_load(reg_of, ins.args[1], "%rcx", s);
    s = ssa_load(reg_of, ins.args[2], "%rax", s);
    s = s.write("    cmpq 8(%rdx), %rax\n    ja __fern_oob_abort\n    cmpq %rax, %rcx\n    ja __fern_oob_abort\n");
    s = s.write("    subq %rcx, %rax\n    addq (%rdx), %rcx\n");
    if (ins.imm == 1) {
        s = s.write("    leaq " + util.i32_to_string(base_off) + "(%rbp), %rdx\n");
    } else {
        s = s.write("    pushq %rcx\n    pushq %rax\n    movq $24, %rdi\n    call __fern_alloc\n    movq %rax, %rdx\n    popq %rax\n    popq %rcx\n");
    }
    s = s.write("    movq $-1, (%rdx)\n    movq %rcx, 8(%rdx)\n    movq %rax, 16(%rdx)\n    addq $8, %rdx\n");
    // The result leaves in %rdx, so the store does not re-assert what %rax
    // holds, and the bound loaded into it above has been overwritten.
    return ssa_store(reg_of, ins.result, "%rdx", ssa_x0_forget(s));
}

// SsaFrame is the frame below the values: three words per frame-resident
// string view after the values. ssa_view_off is the offset of a view's lowest
// word, the base the view kernel writes at.
struct SsaFrame { nspill: i32, views: i32[], blk_pos: i32[], uses: i32[], nsave: i32, epilogue: string, imm: ssa.Imms }

// SsaFuse is a block's compare consumed as flags by its branch: `n` trailing
// instructions (the compare, and the `not` between it and the branch when
// `inverted`) are not materialised; the branch tests the condition of
// compare `tag` on operands `a` and `b` instead. A `not` of a plain boolean
// fuses too: `tag` is 0, the branch tests `a` for zero and takes the true
// edge when it is. An inline uniqueness test of `a` fuses as `unique`: its
// guards leave the flags an equality compare would. n is 0 when the block
// ends some other way.
struct SsaFuse { n: i32, tag: i32, inverted: boolean, a: i32, b: i32, unique: boolean }

function ssa_no_fuse(): SsaFuse { return SsaFuse { n: 0, tag: 0, inverted: false, a: 0, b: 0, unique: false }; }

// ssa_fuse finds the compare a block's brif can read as flags: the block's
// last instruction is an integer compare read only by the branch, or a `not`
// read only by the branch whose operand is such a compare read only by it. A
// `not` over anything else is the value test with the edges swapped.
function ssa_fuse(fr: SsaFrame, blk: ssa.SBlock): SsaFuse {
    var t: ssa.STerm = blk.term;
    if (t.kind_tag != 3 || t.t == t.f || blk.insts.len() == 0) { return ssa_no_fuse(); }
    var last: ssa.SInst = blk.insts[blk.insts.len() - 1];
    if (last.result != t.cond || fr.uses[last.result] != 1) { return ssa_no_fuse(); }
    var cmp: ssa.SInst = last;
    var n: i32 = 1;
    var inverted: boolean = false;
    if (last.kind_tag == 10 && last.str == "!") {
        var value_test: SsaFuse = SsaFuse { n: 1, tag: 0, inverted: true, a: last.args[0], b: 0, unique: false };
        if (blk.insts.len() < 2) { return value_test; }
        cmp = blk.insts[blk.insts.len() - 2];
        if (cmp.result != last.args[0] || fr.uses[cmp.result] != 1) { return value_test; }
        if (!ssa_unique_test(cmp) && (cmp.kind_tag != 9 || !ircore.is_int_cmp_kind(ir.kind_id(cmp.str)))) { return value_test; }
        n = 2;
        inverted = true;
    }
    if (ssa_unique_test(cmp)) { return SsaFuse { n: n, tag: ir.kind_id("eq"), inverted: inverted, a: cmp.args[0], b: 0, unique: true }; }
    if (cmp.kind_tag != 9 || !ircore.is_int_cmp_kind(ir.kind_id(cmp.str))) { return ssa_no_fuse(); }
    if (fr.imm.is_imm[cmp.args[0]]) {
        return SsaFuse { n: n, tag: ircore.flip_int_cmp_kind(ir.kind_id(cmp.str)), inverted: inverted, a: cmp.args[1], b: cmp.args[0], unique: false };
    }
    return SsaFuse { n: n, tag: ir.kind_id(cmp.str), inverted: inverted, a: cmp.args[0], b: cmp.args[1], unique: false };
}

// ssa_join is the label a block's fused test joins at; a rotated latch
// re-runs its header's test under its own.
function ssa_join(lp: string, blk: i32): string { return lp + "uq" + util.i32_to_string(blk); }

function ssa_unique_test(ins: ssa.SInst): boolean {
    return ssa.rc_inlined(ins) && ins.str == "__fern_rc_is_unique";
}

function ssa_view_off(fr: SsaFrame, v: i32): i32 {
    var first: i32 = fr.nspill + 3 * fr.views[v];
    return 0 - 8 * (first + 3) - fr.nsave;
}

// ssa_raw_inst selects the raw memory floor (52..55): unchecked 8-byte and
// byte loads and stores at base + idx.
function ssa_raw_inst(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    var k: i32 = ins.kind_tag;
    var a: string = ssa_src(reg_of, ins.args[0], "%r11");
    s = ssa_load(reg_of, ins.args[0], a, s);
    var b: string = ssa_src(reg_of, ins.args[1], "%rcx");
    s = ssa_load(reg_of, ins.args[1], b, s);
    var d: string = ssa_dst(reg_of, ins.result);
    if (k == 52) { s = s.write("    movq (" + a + "," + b + ",8), " + d + "\n"); return ssa_store(reg_of, ins.result, d, s); }
    if (k == 54) { s = s.write("    movzbl (" + a + "," + b + "), " + ssa_r32(d) + "\n"); return ssa_store(reg_of, ins.result, d, s); }
    var c: string = ssa_src(reg_of, ins.args[2], "%rdx");
    s = ssa_load(reg_of, ins.args[2], c, s);
    if (k == 53) { return s.write("    movq " + c + ", (" + a + "," + b + ",8)\n"); }
    return s.write("    movb " + ssa_r8(c) + ", (" + a + "," + b + ")\n");
}

// ssa_call_ind is the stack machine's call through a function value: the
// arguments pushed with the first on top, the target in %r11, which nothing
// live can occupy at a call.
function ssa_call_ind(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    var argc: i32 = ins.args.len() - 1;
    var i: i32 = argc;
    while (i >= 1) {
        s = ssa_push_operand(reg_of, ins.args[i], s);
        i = i - 1;
    }
    s = ssa_load(reg_of, ins.args[0], "%r11", s);
    s = s.write("    call *%r11\n");
    if (argc > 0) { s = s.write("    addq $" + util.i32_to_string(argc * 8) + ", %rsp\n"); }
    return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
}

// ssa_agg_lit is the address of a static record, variant or capture-free
// function-value box the lowering folded whole (ir.const_struct_* /
// ir.const_closure), interned as the flat arm interns it.
function ssa_agg_lit(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    var pk: asmcore.ConstAggPack = asmcore.const_agg_pack(s, ins.str);
    s = pk.state;
    var kout: asmcore.ConstAggOut = asmcore.add_const_agg(s, pk.text);
    s = kout.state;
    var d: string = ssa_dst(reg_of, ins.result);
    s = s.write("    leaq " + asmcore.const_agg_label(s, kout.idx) + "(%rip), " + d + "\n");
    return ssa_store(reg_of, ins.result, d, s);
}

// ssa_addr_inst selects the label addresses and the box allocation (45..48).
function ssa_addr_inst(ins: ssa.SInst, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    var k: i32 = ins.kind_tag;
    var label: string = "";
    if (k == 45) { label = "__fn_" + asmcore.sanitize_label(ins.str); }
    else if (k == 46) {
        var sh: asmcore.ShapeRefOut = asmcore.shape_ref(s, ins.str);
        s = sh.state;
        label = sh.label;
    } else if (k == 47) {
        var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, ins.str);
        s = lo.state;
        label = asmcore.str_box_label(s, lo.idx);
    } else {
        s = s.need("heap");
        s = s.write("    movq $" + util.i32_to_string(ins.imm) + ", %rdi\n    call __fern_arr_box\n");
        return ssa_store(reg_of, ins.result, "%rax", ssa_x0_forget(s));
    }
    var d: string = ssa_dst(reg_of, ins.result);
    s = s.write("    leaq " + label + "(%rip), " + d + "\n");
    return ssa_store(reg_of, ins.result, d, s);
}

function ssa_inst(ins: ssa.SInst, reg_of: i32[], lp: string, fr: SsaFrame, r: irlower.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
    var k: i32 = ins.kind_tag;
    if (k == 11) { return ssa_call(ins, reg_of, lp, s); }
    if (k == 59) { return ssa_flat_op(ins, reg_of, lp, r, s); }
    if (k == 60) { return ssa_dyn_dispatch(ins, reg_of, lp, s); }
    if (k == 51) { return ssa_str_view(ins, reg_of, ssa_view_off(fr, ins.result), s); }
    if (k >= 40 && k <= 44) { return ssa_mem_inst(ins, reg_of, s); }
    if (k >= 45 && k <= 48) { return ssa_addr_inst(ins, reg_of, s); }
    if (k == 49) { return ssa_str_call(ins, reg_of, s); }
    if (k == 50 && ssa_fcall_sym(ins.str) != "") { return ssa_fcall(ins, reg_of, s); }
    if (k == 50 && ssa_host_kind(ins.str)) { return ssa_host_call(ins, reg_of, s); }
    if (ssa_is_rt_call(ins)) { return ssa_rt_call(ins, reg_of, lp, s); }
    if (k == 58) { return ssa_sym_addr(ins, reg_of, s); }
    if (k >= 52 && k <= 55) { return ssa_raw_inst(ins, reg_of, s); }
    if (k == 56) { return ssa_call_ind(ins, reg_of, s); }
    if (k == 57) { return ssa_agg_lit(ins, reg_of, s); }
    if ((k == 1 || k == 3) && fr.imm.is_imm[ins.result]) { return s; }
    var d: string = ssa_dst(reg_of, ins.result);
    if (k == 1) { s = ssa_const_reg(util.i32_to_string(ins.imm), false, d, s); }
    else if (k == 3) { s = ssa_const_reg(ins.str, ins.imm == 64, d, s); }
    else if (k == 4) { s = s.write("    movabsq $" + ins.str + ", " + d + "\n"); }
    else if (k == 7) { s = ssa_load(reg_of, ins.args[0], d, s); }
    else if (k == 9 && ssa_direct_bin(ir.kind_id(ins.str))) { return ssa_bin_in_place(ins, reg_of, fr, s); }
    else if (k == 9 && ssa_shift_tag(ir.kind_id(ins.str)) && fr.imm.is_imm[ins.args[1]]) { return ssa_bin_in_place(ins, reg_of, fr, s); }
    else if (k == 9) {
        // idiv is hardwired to %rdx:%rax, so the guarded divisions work there
        // and the allocator is told they clobber it; everything else works in
        // the register path's own scratch.
        d = ssa_bin_work(ins.str);
        // The right operand goes first: a division works in %rax, which is an
        // allocatable home, so loading the left operand there would overwrite
        // a right operand that lives in it. %rcx is never a home, so the
        // reverse cannot happen. A constant divisor read as an immediate has
        // no home to load; ir_div_const takes its value from the table.
        if (!fr.imm.is_imm[ins.args[1]]) { s = ssa_load(reg_of, ins.args[1], "%rcx", s); }
        s = ssa_load(reg_of, ins.args[0], d, s);
        s = ssa_binary(ins, fr, lp, d, s);
    } else {
        s = ssa_load(reg_of, ins.args[0], d, s);
        s = s.write(ssa_unary_asm(ins.str, ins.imm == 1, lp + "u" + util.i32_to_string(ins.result), d));
    }
    return ssa_store(reg_of, ins.result, d, s);
}

// ssa_phi_moves emits the copies of the edge from block `pred` into block
// `succ`: each of succ's phis takes its operand for pred. A phi whose operand
// already sits in its home, or which nothing reads, moves nothing.
function ssa_phi_moves(f: ssa.SFunc, fr: SsaFrame, reg_of: i32[], pred: i32, succ: i32, s: asmcore.EmitState): asmcore.EmitState {
    s = ssa_x0_forget(s);
    var ti: i32 = ssa_block_at(fr, succ);
    if (ti < 0) { return s; }
    var tb: ssa.SBlock = f.blocks[ti];
    var sl: i32 = ssa.pred_slot(tb, pred);
    var srcs: i32[] = [];
    var dsts: i32[] = [];
    for ins in tb.insts {
        if (ins.kind_tag == 8 && reg_of[ins.result] != 0 - 1 && reg_of[ins.args[sl]] != reg_of[ins.result]) {
            srcs = srcs.append(reg_of[ins.args[sl]]);
            dsts = dsts.append(reg_of[ins.result]);
        }
    }
    return ssa_parallel_moves(srcs, dsts, s);
}

// ssa_parallel_moves emits moves between locations (a register index or a
// spill code, as reg_of holds them) that happen at once: every source is read
// before any destination it names is written. They are a phi edge's copies, a
// register call's arguments and a register entry's parameters. A move whose
// destination no pending move still reads goes first, in one instruction when
// either side is a register, or two through %rcx between two slots. When
// every pending destination is still read, the moves form a cycle: one source
// is parked in %r11 and every move reading it takes it from there, which
// frees that location to be written.
function ssa_parallel_moves(srcs: i32[], dsts: i32[], s: asmcore.EmitState): asmcore.EmitState {
    var done: boolean[] = [];
    for src in srcs { done = done.append(false); }
    var parking: boolean = false;
    var parked: i32 = 0;
    var left: i32 = srcs.len();
    while (left > 0) {
        var progressed: boolean = false;
        var i: i32 = 0;
        while (i < srcs.len()) {
            if (!done[i] && !ssa_move_blocked(srcs, dsts, done, i, parking, parked)) {
                if (parking && srcs[i] == parked) { s = s.write("    movq %r11, " + ssa_loc(dsts[i], s) + "\n"); }
                else { s = ssa_move(srcs[i], dsts[i], s); }
                done = done.with(i, true);
                left = left - 1;
                progressed = true;
            }
            i = i + 1;
        }
        if (!progressed) {
            var j: i32 = 0;
            while (done[j]) { j = j + 1; }
            s = s.write("    movq " + ssa_loc(srcs[j], s) + ", %r11\n");
            parking = true;
            parked = srcs[j];
        }
    }
    return ssa_x0_forget(s);
}
// A move is blocked while another pending move still reads its destination
// from that location rather than from the parked copy.
function ssa_move_blocked(srcs: i32[], dsts: i32[], done: boolean[], i: i32, parking: boolean, parked: i32): boolean {
    var k: i32 = 0;
    while (k < srcs.len()) {
        if (k != i && !done[k] && srcs[k] == dsts[i] && !(parking && srcs[k] == parked)) { return true; }
        k = k + 1;
    }
    return false;
}
function ssa_move(src: i32, dst: i32, s: asmcore.EmitState): asmcore.EmitState {
    if (src == dst) { return s; }
    if (src >= 0 || dst >= 0) { return s.write("    movq " + ssa_loc(src, s) + ", " + ssa_loc(dst, s) + "\n"); }
    return s.write("    movq " + ssa_loc(src, s) + ", %rcx\n    movq %rcx, " + ssa_loc(dst, s) + "\n");
}
// ssa_loc spells a location: its register, or its frame slot.
function ssa_loc(loc: i32, s: asmcore.EmitState): string {
    if (loc >= 0) { return ssa_reg(loc); }
    return ssa_slot(ssa.spill_slot(loc), s.ssa_save);
}

function ssa_epilogue(): string {
    return "    .cfi_remember_state\n    leave\n    .cfi_def_cfa %rsp, 8\n    ret\n    .cfi_restore_state\n";
}

// ssa_jump is the branch to block `to`, or nothing when `to` is the block
// emitted next and control falls into it.
function ssa_jump(lp: string, to: i32, next: i32, s: asmcore.EmitState): asmcore.EmitState {
    if (to == next) { return s; }
    return s.write("    jmp " + lp + util.i32_to_string(to) + "\n");
}

// ssa_brif branches on a value, or on the flags a fused compare left (fu.n
// above 0), in which case the false edge is the compare's inverse; a fused
// `not` (fu.tag 0) is the value test with the edges swapped. An edge
// whose target has phis lands on a stub carrying that edge's moves, since
// the moves of the two edges differ.
function ssa_brif(f: ssa.SFunc, fr: SsaFrame, blk: ssa.SBlock, reg_of: i32[], lp: string, next: i32, fu: SsaFuse, s: asmcore.EmitState): asmcore.EmitState {
    var t: ssa.STerm = blk.term;
    // A value test reads the value where it lives, through %r11 only when spilled.
    var tv: i32 = t.cond;
    if (fu.n > 0) { tv = fu.a; }
    if (fu.n == 0) { s = ssa_read(reg_of, t.cond, "%r11", s); }
    var tr: string = ssa_src(reg_of, tv, "%r11");
    if (t.t == t.f) {
        s = ssa_phi_moves(f, fr, reg_of, blk.id, t.t, s);
        return ssa_jump(lp, t.t, next, s);
    }
    var fl: string = lp + util.i32_to_string(t.f);
    var stub: boolean = ssa_has_phis(f, fr, t.f);
    if (stub) { fl = lp + "e" + util.i32_to_string(blk.id) + "_" + util.i32_to_string(t.f); }
    // When the false target is the next block and neither edge carries phi
    // moves, branch on the condition itself and fall through.
    if (!stub && t.f == next && !ssa_has_phis(f, fr, t.t)) {
        var tl: string = lp + util.i32_to_string(t.t);
        if (fu.n > 0 && fu.tag == 0) { return s.write("    testq " + tr + ", " + tr + "\n    jz " + tl + "\n"); }
        if (fu.n > 0) { return s.write("    " + ir_cmp_jcc(fu.tag, !fu.inverted) + " " + tl + "\n"); }
        return s.write("    testq " + tr + ", " + tr + "\n    jnz " + tl + "\n");
    }
    if (fu.n > 0 && fu.tag == 0) {
        s = s.write("    testq " + tr + ", " + tr + "\n    jnz " + fl + "\n");
    } else if (fu.n > 0) {
        s = s.write("    " + ir_cmp_jcc(fu.tag, fu.inverted) + " " + fl + "\n");
    } else {
        s = s.write("    testq " + tr + ", " + tr + "\n    jz " + fl + "\n");
    }
    s = ssa_phi_moves(f, fr, reg_of, blk.id, t.t, s);
    if (stub) {
        s = s.write("    jmp " + lp + util.i32_to_string(t.t) + "\n");
        s = ssa_x0_forget(s);
        s = s.write(fl + ":\n");
        s = ssa_phi_moves(f, fr, reg_of, blk.id, t.f, s);
        return ssa_jump(lp, t.f, next, s);
    }
    return ssa_jump(lp, t.t, next, s);
}

// ssa_fused_test sets the flags a block's fused compare leaves for its branch
// (or brings a fused `not`'s operand into a register, for the value test).
// `join` names the label a fused uniqueness test's guards meet at.
function ssa_fused_test(fr: SsaFrame, reg_of: i32[], fu: SsaFuse, join: string, s: asmcore.EmitState): asmcore.EmitState {
    if (fu.n > 0 && fu.tag == 0) { return ssa_read(reg_of, fu.a, "%r11", s); }
    if (fu.n == 0) { return s; }
    if (fu.unique) { return ssa_unique_flags(reg_of, fu.a, join, s); }
    s = ssa_read(reg_of, fu.a, "%r11", s);
    s = ssa_read_rhs(fr, reg_of, fu.b, "%rcx", s);
    return s.write("    cmpq " + ssa_rhs(fr, reg_of, fu.b, "%rcx") + ", " + ssa_src(reg_of, fu.a, "%r11") + "\n");
}

// ssa_unique_flags is ssa_rc_prim's uniqueness test as flags: ZF is set only
// when the count is exactly one. Each guard's early exit already leaves ZF
// clear (a set tag bit; a pointer below, so unequal to, the floor).
function ssa_unique_flags(reg_of: i32[], v: i32, join: string, s: asmcore.EmitState): asmcore.EmitState {
    s = helper_call_needs("__fern_rc_is_unique", s);
    s = ssa_read(reg_of, v, "%r11", s);
    var p: string = ssa_src(reg_of, v, "%r11");
    s = s.write("    testb $1, " + ssa_r8(p) + "\n    jnz " + join + "\n    cmpq $0x10000, " + p + "\n    jb " + join + "\n");
    s = s.write(ssa_rc_is_one("-8(" + p + ")") + join + ":\n");
    return s;
}

// ssa_rc_is_one compares the count at `rc` with one, through %edx when the
// sanitizer must see the loaded value first.
function ssa_rc_is_one(rc: string): string {
    if (rc_free_debug_on()) { return "    movl " + rc + ", %edx\n" + san_poison_check("%edx") + "    cmpl $1, %edx\n"; }
    return "    cmpl $1, " + rc + "\n";
}

// ssa_rotates reports whether a branch from the block at position `from` to
// block `to` can re-run `to`'s test in place of jumping to it: `to` is at or
// before `from` (a back edge), holds nothing but phis and the test (and the
// immediates it reads), and
// neither of its successors has phis, so its branch carries no moves of its
// own. A loop then costs one branch per iteration rather than two.
function ssa_rotates(f: ssa.SFunc, fr: SsaFrame, from: i32, to: i32): boolean {
    var ti: i32 = ssa_block_at(fr, to);
    if (ti < 0 || ti > from) { return false; }
    var h: ssa.SBlock = f.blocks[ti];
    if (h.term.kind_tag != 3 || h.term.t == h.term.f) { return false; }
    if (ssa_has_phis(f, fr, h.term.t) || ssa_has_phis(f, fr, h.term.f)) { return false; }
    var n: i32 = 0;
    for ins in h.insts {
        // A constant the test reads as an immediate is never materialised.
        var imm: boolean = (ins.kind_tag == 1 || ins.kind_tag == 3) && fr.imm.is_imm[ins.result];
        if (ins.kind_tag != 8 && !imm) { n = n + 1; }
    }
    return n == ssa_fuse(fr, h).n;
}

function ssa_term(f: ssa.SFunc, fr: SsaFrame, blk: ssa.SBlock, reg_of: i32[], lp: string, next: i32, fu: SsaFuse, s: asmcore.EmitState): asmcore.EmitState {
    var t: ssa.STerm = blk.term;
    if (t.kind_tag == 1) {
        s = ssa_load(reg_of, t.value, "%rax", s);
        return s.write(fr.epilogue);
    }
    if (t.kind_tag == 2) {
        s = ssa_phi_moves(f, fr, reg_of, blk.id, t.target, s);
        if (ssa_rotates(f, fr, ssa_block_at(fr, blk.id), t.target)) {
            var h: ssa.SBlock = f.blocks[ssa_block_at(fr, t.target)];
            var hfu: SsaFuse = ssa_fuse(fr, h);
            return ssa_brif(f, fr, h, reg_of, lp, next, hfu, ssa_fused_test(fr, reg_of, hfu, ssa_join(lp, blk.id), s));
        }
        return ssa_jump(lp, t.target, next, s);
    }
    if (t.kind_tag == 3) { return ssa_brif(f, fr, blk, reg_of, lp, next, fu, s); }
    // A block the lift left unterminated is one nothing reaches; the stack
    // machine's fallback return keeps the text well formed here too.
    return s.write("    xorl %eax, %eax\n" + fr.epilogue);
}

// ssa_load_params moves each parameter to its home; value p is parameter p.
// The first ssa_nregs() arrive in the pool's registers, in order (a stack
// caller's are loaded there by the entry shim); the rest stay in the caller's
// slots. The register moves go first, since a later parameter's home may be a
// register still holding an earlier one.
function ssa_load_params(f: ssa.SFunc, reg_of: i32[], s: asmcore.EmitState): asmcore.EmitState {
    var k: i32 = ssa_reg_params(f);
    var srcs: i32[] = [];
    var dsts: i32[] = [];
    var p: i32 = 0;
    while (p < k) {
        if (reg_of[p] != 0 - 1) { srcs = srcs.append(p); dsts = dsts.append(reg_of[p]); }
        p = p + 1;
    }
    s = ssa_parallel_moves(srcs, dsts, s);
    while (p < f.nparams) {
        // Straight into the home: %rax is an allocatable home now, so staging
        // every parameter through it overwrote whichever parameter had it.
        var d: string = ssa_dst(reg_of, p);
        s = s.write("    movq " + util.i32_to_string(16 + p * 8) + "(%rbp), " + d + "\n");
        s = ssa_store(reg_of, p, d, s);
        p = p + 1;
    }
    return s;
}

// ssa_reg_params is how many of f's parameters arrive in registers.
function ssa_reg_params(f: ssa.SFunc): i32 {
    if (f.nparams < ssa_nregs()) { return f.nparams; }
    return ssa_nregs();
}

// ssa_entry_shim is a function's two entries. `__fn_<name>`, the stack-ABI
// entry every caller outside this unit's direct calls uses, loads the first
// ssa_reg_params() arguments from the caller's stack into the pool registers
// and falls through into `__fn_<name>.r`, where a register-ABI caller enters
// with them already there. A function with no parameters has one entry.
function ssa_entry_shim(f: ssa.SFunc, name: string): string {
    var k: i32 = ssa_reg_params(f);
    if (k == 0) { return ""; }
    var out: string = "";
    var p: i32 = 0;
    while (p < k) {
        out = out + "    movq " + util.i32_to_string(8 + 8 * p) + "(%rsp), " + ssa_reg(p) + "\n";
        p = p + 1;
    }
    return out + "__fn_" + name + ".r:\n";
}

// ssa_reg_helper names the hand-written runtime helpers with a register
// entry, by argument count: their stack entry loads the arguments into the
// pool's first registers, which is where the `.r` entry reads them.
function ssa_reg_helper(sym: string, argc: i32): boolean {
    if (argc == 2) { return sym == "__fn___fern_str_eq"; }
    return argc == 1 && (sym == "__fn___fern_arr_dec" || sym == "__fn___fern_str_free" || sym == "__fn___fern_arr_inc_elems");
}

// ssa_reg_call reports whether a direct call passes its arguments in
// registers: the callee has a register entry in this unit and takes between
// one and ssa_nregs() arguments.
function ssa_reg_call(ins: ssa.SInst, s: asmcore.EmitState): boolean {
    var argc: i32 = ins.args.len();
    if (ins.kind_tag != 11 || argc == 0 || argc > ssa_nregs() || ssa.rc_inlined(ins)) { return false; }
    if (ircore.is_fern_helper(ins.str) || ircore.is_c_call(ins.str)) { return false; }
    return irlower.sig_reg_has_exact(s.reg_entries, asmcore.sanitize_label(ins.str));
}

// ssa_arg_prefs asks the allocator for the register each parameter arrives in
// and each register call's argument leaves in, so neither needs a move when
// the value has nowhere better to be.
function ssa_arg_prefs(f: ssa.SFunc, s: asmcore.EmitState): i32[] {
    var pref: i32[] = [];
    var i: i32 = 0;
    while (i < f.nvals) { pref = pref.append(0 - 1); i = i + 1; }
    var p: i32 = 0;
    while (p < ssa_reg_params(f)) { pref = pref.with(p, p); p = p + 1; }
    for blk in f.blocks {
        for ins in blk.insts {
            var rt: boolean = ssa_is_rt_call(ins);
            if (!rt && !ssa_reg_call(ins, s)) { continue; }
            var a: i32 = 0;
            while (a < ins.args.len() && (!rt || a < 2)) {
                var v: i32 = ins.args[a];
                var r: i32 = a;
                if (rt) { r = ssa_rt_arg_reg(a); }
                if (v >= 0 && v < pref.len() && pref[v] < 0) { pref = pref.with(v, r); }
                a = a + 1;
            }
        }
    }
    return pref;
}

// emit_ssa_function_x86 emits one lifted function: the stack machine's frame,
// the parameters loaded from the caller's slots into their homes, and each
// block behind its label. prune_dead first takes out the zeros the lift gives
// every declared local and the loop phis nothing reads.
function emit_ssa_function_x86(lifted: ssa.SFunc, label_name: string, r: irlower.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
    var f: ssa.SFunc = ssa.thread_forwarding(ssa.prune_dead(ssa.prune_trivial_phis(lifted)));
    var imm: ssa.Imms = ssa.imm_operands(f, 0i64 - 2147483648i64, 2147483647i64, ssa_imm_right(), ssa_imm_left());
    var reg_of: i32[] = ssa.regalloc_linear(f, ssa_nregs(), ssa_nsaved(), 0, true, imm.is_imm, ssa_arg_prefs(f, s));
    var lp: string = ".Lssa_" + asmcore.sanitize_label(label_name) + "_";
    s = s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n    .cfi_startproc\n");
    s = s.write(ssa_entry_shim(f, asmcore.sanitize_label(label_name)));
    s = s.write("    pushq %rbp\n    .cfi_def_cfa_offset 16\n    .cfi_offset %rbp, -16\n    movq %rsp, %rbp\n    .cfi_def_cfa_register %rbp\n");
    var saved: i32[] = ssa_saved_regs(reg_of);
    var save: i32 = 8 * saved.len();
    s = s.write(ssa_save_asm(saved));
    var views: i32[] = ssa_view_slots(f);
    var fr: SsaFrame = SsaFrame { nspill: ssa.spill_count(reg_of), views: views, blk_pos: ssa_block_index(f), uses: ssa.use_counts(f), nsave: save, epilogue: ssa_epilogue_for(saved), imm: imm };
    var frame: i32 = (fr.nspill + 3 * ssa_view_count(views)) * 8;
    // %rsp is 16-byte aligned at a call when the pushes and the frame together
    // are a multiple of 16.
    if ((frame + save) % 16 != 0) { frame = frame + 8; }
    if (frame > 0) { s = s.write("    subq $" + util.i32_to_string(frame) + ", %rsp\n"); }
    s = asmcore.EmitState { ...s, ssa_save: save };
    s = ssa_load_params(f, reg_of, s);
    var bi: i32 = 0;
    while (bi < f.blocks.len()) {
        var blk: ssa.SBlock = f.blocks[bi];
        var next: i32 = 0 - 1;
        if (bi + 1 < f.blocks.len()) { next = f.blocks[bi + 1].id; }
        s = ssa_x0_forget(s);
        s = s.write(lp + util.i32_to_string(blk.id) + ":\n");
        var fu: SsaFuse = ssa_fuse(fr, blk);
        var ii: i32 = 0;
        while (ii < blk.insts.len() - fu.n) {
            var ins: ssa.SInst = blk.insts[ii];
            if (ins.kind_tag != 6 && ins.kind_tag != 8) { s = ssa_inst(ins, reg_of, lp, fr, r, s); }
            ii = ii + 1;
        }
        s = ssa_fused_test(fr, reg_of, fu, ssa_join(lp, blk.id), s);
        s = ssa_term(f, fr, blk, reg_of, lp, next, fu, s);
        bi = bi + 1;
    }
    s = asmcore.EmitState { ...s, ssa_save: 0 };
    return s.write("    .cfi_endproc\n");
}

// emit_ssa_function emits one lowered function through the register path,
// which is the only emitter: a function the lift or the emitter cannot take
// is refused naming the op (ircore.ssa_refuse). Every op the lowering
// produces has an arm, so a refusal here is a compiler bug, not a program
// the backend does not cover.
function emit_ssa_function(r: irlower.LowerResult, label_name: string, s: asmcore.EmitState): asmcore.EmitState {
    var t_lift: i64 = monotonic_ns();
    var lifted: ssa_lift.LResult = ssa_lift.lift_from_ir_prod(label_name, r.n_params, r.n_locals, r.ops);
    var why: string = lifted.bail;
    if (lifted.ok) {
        var collision: i32 = ssa.repeated_block_id(lifted.func);
        if (collision >= 0) { ircore.ssa_block_id_collision(label_name, collision); }
        why = ssa_unsupported(lifted.func);
    }
    if (why != "") { ircore.ssa_refuse(label_name, why); }
    var lift_ms: i64 = (monotonic_ns() - t_lift) / 1000000i64;
    var t_emit: i64 = monotonic_ns();
    s = emit_ssa_function_x86(ssa.inline_leaves(lifted.func, s.leaves), label_name, r, s);
    // Under the report, a function whose lift or emit took over 200 ms is
    // named with both times: the whole-compiler build is where a phase's
    // cost shows, and this is how a slow one is found.
    var emit_ms: i64 = (monotonic_ns() - t_emit) / 1000000i64;
    if (ircore.ssa_report_on() && lift_ms + emit_ms > 200i64) {
        eprint("FERN_SSA: time " + label_name + ": lift " + util.i32_to_string((lift_ms as i32)) + " ms, emit " + util.i32_to_string((emit_ms as i32)) + " ms, " + util.i32_to_string(r.ops.len()) + " ops, " + util.i32_to_string(r.n_locals) + " slots\n");
    }
    return s;
}

// emit_function_via_ir lowers one function to the stack IR and emits it
// through the register path, writing through the global strbuf.
function emit_function_via_ir(fd: parser.FuncDecl, s: asmcore.EmitState, sg: irlower.FnSigs, vsigs: irverify.NameIndex): asmcore.EmitState {
    var r: irlower.LowerResult = irlower.lower_func(fd, s.struct_decls, sg, false);
    return emit_function_via_ir_pre(r, fd, s, vsigs);
}

// emit_function_via_ir_pre is the emit half of emit_function_via_ir, split out at
// the lower_func boundary so a caller that has ALREADY lowered `fd` can emit from
// that LowerResult without lowering it a second time (#4394 lever 3 — the fused
// eligible-and-emit path, emit_module_ir_gated, lowers each function once, checks
// eligibility on that `r`, then emits from the same one, replacing the driver's
// former lower-twice: all_eligible_known's gate pass re-lowered every function,
// then emit_module_ir re-lowered every function again). Everything from the
// runtime-need detection onward reads only r / fd / s (none of the eighteen
// side-tables lower_func consumes), so this split is byte-identical to the
// inlined body.
function emit_function_via_ir_pre(r: irlower.LowerResult, fd: parser.FuncDecl, s: asmcore.EmitState, vsigs: irverify.NameIndex): asmcore.EmitState {
    // Methods get the receiver-type-qualified label `__fn_<Type>.<name>` (matching
    // asm.fern + irlower's dispatch); free functions stay `__fn_<name>`.
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) { label_name = util.base_type_name(fd.receiver_type) + "." + fd.name; }
    return emit_function_via_ir_named(r, label_name, false, s, vsigs);
}

// emit_function_via_ir_named is the body of emit_function_via_ir_pre with the
// label supplied rather than read from a declaration, so a lowering that has no
// FuncDecl — a body the semantic pipeline produced, which carries its own name —
// emits through exactly the same path. `weak` marks the definition co-linkable,
// the way the per-type __struct_drop_<T> bodies are: several per-module units may
// each emit an identical copy and the linker keeps one.
function emit_function_via_ir_named(r: irlower.LowerResult, label_name: string, weak: boolean, s: asmcore.EmitState, vsigs: irverify.NameIndex): asmcore.EmitState {
    if (weak) { s = s.write(".weak __fn_" + asmcore.sanitize_label(label_name) + "\n"); }
    ircore.lower_failed_refuse(label_name, r);
    // Runtime-need detection is marked off the ops of this one lowering; the
    // runtime tail reads the accumulated needs (has_need) rather than lowering
    // the module again to inspect it.
    //
    // Read `.kind` off the bound Op struct INLINE rather than via a `var dk:
    // string = ...kind` local: a named string local aliasing a struct field and
    // dec'd at each loop-iteration boundary takes arm64's deferred native heap-
    // string reclamation path (RC-PERCEUS slice 5g), which over-releases under
    // allocation pressure and crashed the arm64-compiled driver. The inline read
    // (matching the op-emission loop below, which never binds `.kind` to its own
    // local) keeps the string a transient the comparison consumes immediately.
    var dop: i32 = 0;
    while (dop < r.ops.len()) {
        var dopop: ir.Op = r.ops[dop];
        // Every map op EXCEPT keys/values needs the maps runtime block: tags
        // 124..130 are map_new, map_set, map_len, map_get, map_has, map_get_or,
        // map_delete, and each emits a call into it. A range rather than the
        // list this used to spell out — the list named 124/125/126 only, so a
        // program whose only map op was `.has()` emitted `call __fern_map_has`
        // and never defined it, and the link failed (#6177). Naming tags one at
        // a time is what let four of them go missing; the range cannot.
        if (dopop.kind_tag >= 124 && dopop.kind_tag <= 130) { s = s.need("maps"); }
        // map_keys / map_values with a SCALAR column (i32_imm 0, #4353) call
        // __fern_map_snapshot_col, which lives in the maps runtime block; a
        // pointer-column read (i32_imm 1) is a raw load and needs nothing.
        if ((dopop.kind_tag == 131 || dopop.kind_tag == 132) && dopop.i32_imm != 1) { s = s.need("maps"); }
        if (ir.op_needs_heap(dopop)) { s = s.need("heap"); }
        dop = dop + 1;
    }

    irverifygate.verify_or_refuse(label_name, r.ops, r.n_params, r.n_locals, vsigs);
    return emit_ssa_function(r, label_name, s);
}

// emit_stack_op emits one op on the machine stack: it pops the op's operands
// and pushes its result. The register path runs it, between a push of the
// operands and a pop of the result (ssa_flat_op), for every op the lift has
// no instruction of its own — the OS floor, the map ops, the byte kernels,
// the byte-buffer builder. An op the lift lowers itself has no arm here.
// fern-lint: allow cyclomatic-complexity
// One guard per IR op and no multi-line body left to move: the op table itself.
function emit_stack_op(o: ir.Op, i: i32, lp: string, r: irlower.LowerResult, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind_tag == 79) {  // ptr_width
        // () -> heap-pointer width in bytes. 8 on x86-64.
        s = s.write("    pushq $8\n");
    } else if (o.kind_tag == 74) {  // memcpy
        // [dst, src, n] -> copy n bytes src->dst (rep movsb), push dummy 0.
        // n is on top, then src, then dst (the lowering order). Mirrors the
        // AST __memcpy emitter in asm.fern.
        s = s.write(ir_memcpy_asm());
    } else if (o.kind_tag == 75) {  // memset
        // [dst, byte, n] -> fill n bytes at dst with byte's low byte (rep
        // stosb, AL), push dummy 0. n on top, then byte, then dst.
        s = s.write(ir_memset_asm());
    } else if (o.kind_tag == 78) {  // free
        // [ptr, size] -> return the raw block to its size class; push dummy 0.
        s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_raw_free\n    pushq $0\n");
        s = s.need("heap");
    } else if (o.kind_tag == 91) {  // arr_rc
        // pop base; 32-bit refcount field at data-8.
        s = s.write("    popq %rax\n    movl -8(%rax), %eax\n    pushq %rax\n");
    } else if (ir.is_str_op_kind(o.kind_tag)) {
        // All string operand-stack ops (len/index/slice/bytes/split/
        // predicates/concat/eq/cmp) are emitted by emit_str_op — factored out
        // to keep this dispatch under the oversized-function threshold (#2720).
        s = emit_str_op(o, s);
    } else if (o.kind_tag == 185) {  // random_bytes
        // [n] IS param[0] (+16); call the Fern-compiled __fn___fern_random_bytes
        // (asmcore.rt_src_random_bytes, #2649) via the stack ABI. Mirrors the
        // str_from_bytes / str_split handlers.
        s = s.write("    call __fn___fern_random_bytes\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("random_bytes");
    } else if (o.kind_tag == 186) {  // random_i32
        // no operands; the Fern-compiled __fn___fern_random_i32() -> i32 in
        // %rax. Zero args, so the stack ABI needs no push and no cleanup.
        s = s.write("    call __fn___fern_random_i32\n    pushq %rax\n");
        s = s.need("random_i32");
    } else if (o.kind_tag == 211) {  // proc_fork
        // no operands; __fern_proc_fork() -> i32 in %rax (0 child / pid
        // parent / -errno).
        s = s.write("    call __fn___fern_proc_fork\n    pushq %rax\n");
        s = s.need("proc_fork");
    } else if (o.kind_tag == 212) {  // proc_waitpid
        // [pid] -> __fern_proc_waitpid(%rdi = pid) -> decoded status in %rax.
        // [pid] IS param[0] already; the stack ABI needs no marshalling.
        s = s.write("    call __fn___fern_proc_waitpid\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("proc_waitpid");
    } else if (o.kind_tag == 286) {  // proc_waitpid_nohang
        // [pid] -> __fern_proc_waitpid_nohang(%rdi = pid) -> the
        // decoded status, -1 when the child is still running, or
        // -errno.
        s = s.write("    call __fn___fern_proc_waitpid_nohang\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("proc_waitpid_nohang");
    } else if (o.kind_tag == 213) {  // proc_exec
        // Only returns on failure (-errno), so the push is the failure value.
        // [pathbox, argsbox] with args on top; the stack ABI wants param[0]
        // (path) lowest, so pop and re-push swapped. `env` stays marked: the
        // helper reads __raw_environ(), whose .bss slot and _start save are
        // gated on it.
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_proc_exec\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("env"); s = s.need("proc_exec");
    } else if (o.kind_tag == 280) {  // proc_exec_as
        // [pathbox, argvbox, envpbox] with envp on top; the stack ABI wants
        // param[0] (path) lowest, so pop all three and re-push reversed.
        // No `env` need: the environment is an operand, not __raw_environ().
        s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_proc_exec_as\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("proc_exec_as");
    } else if (o.kind_tag == 183) {  // now_ns
        // no operands; Fern-compiled __fn___fern_now_ns() -> i64 in %rax (#2649).
        s = s.write("    call __fn___fern_now_ns\n    pushq %rax\n");
        s = s.need("now_ns");
    } else if (o.kind_tag == 187) {  // poll
        // operand stack [fds, timeout] with timeout ON TOP, but the stack
        // ABI wants param[0] (fds) at the lowest address — so the two are
        // popped and re-pushed swapped rather than called in place.
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_poll\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("poll");
    } else if (o.kind_tag == 188) {  // timer_fd
        // [ms]; __fern_timer_fd(%rdi=ms) -> a CLOCK_MONOTONIC timerfd fd
        // (readable after ms), or -errno, in %rax.
        // [ms] IS param[0] already; the stack ABI needs no marshalling.
        s = s.write("    call __fn___fern_timer_fd\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("timer_fd");
    } else if (o.kind_tag == 312) {  // termios_get
        // [fd]; __fern_termios_get(fd) -> Result[i64[], IoError].
        // [fd] IS param[0] already; the stack ABI needs no marshalling.
        s = s.write("    call __fn___fern_termios_get\n    addq $8, %rsp\n    pushq %rax\n");
        // The runtime body builds its answer with `out.append(...)` on an
        // i64[], so the array push it lowers to has to be emitted too.
        s = s.need("heap"); s = s.need("termios_get"); s = s.need("arr_push_owned");
    } else if (o.kind_tag == 313) {  // termios_set
        // [fd][when][words] with the words on top; the stack ABI wants
        // param[0] (fd) LOWEST, so pop all three and re-push reversed, as
        // proc_exec_as does. Without it the fd arrives where the array
        // belongs and reading its length faults.
        s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_termios_set\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("termios_set");
    } else if (o.kind_tag == 314) {  // set_window_size
        // [fd][rows][cols] with cols on top; the same three-operand
        // marshalling termios_set needs — param[0] (fd) LOWEST.
        s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_set_window_size\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("set_window_size");
    } else if (o.kind_tag == 276) {  // window_size
        // [fd]; __fern_window_size(fd) -> Result[WinSize, IoError].
        // [fd] IS param[0] already; the stack ABI needs no marshalling.
        s = s.write("    call __fn___fern_window_size\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("window_size");
    } else if (o.kind_tag == 232) {  // isatty
        // [fd]; __fern_isatty(%rdi=fd) -> 1 when fd is a terminal, else 0.
        // [fd] IS param[0] already; the stack ABI needs no marshalling.
        s = s.write("    call __fn___fern_isatty\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("isatty");
    } else if (o.kind_tag == 271) {  // process_alive
        // [pid]; __fern_process_alive(pid) -> 1 when a process with that
        // pid exists, else 0. [pid] IS param[0] already; the stack ABI
        // needs no marshalling.
        s = s.write("    call __fn___fern_process_alive\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("process_alive");
    } else if (o.kind_tag == 285) {  // signal_send
        // [pid][sig] (sig on top) -> Result[void, IoError]. Two operands
        // in param order but on the wrong end of the stack, so pop both
        // and re-push with param[0] (pid) on top.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_signal_send\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("signal_send");
    } else if (o.kind_tag == 284) {  // set_process_group
        // [pid][pgid] (pgid on top) -> Result[void, IoError]. The same
        // two-operand marshalling signal_send needs: pop both and
        // re-push with param[0] (pid) on top.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_set_process_group\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("set_process_group");
    } else if (o.kind_tag == 282) {  // priority
        // no args -> __fern_priority() -> this process's nice value in
        // %rax. Nothing is boxed, so no heap need.
        s = s.write("    call __fn___fern_priority\n    pushq %rax\n");
        s = s.need("priority");
    } else if (o.kind_tag == 283) {  // set_priority
        // [nice] IS param[0] (+16) -> Result[void, IoError].
        s = s.write("    call __fn___fern_set_priority\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("set_priority");
    } else if (o.kind_tag == 272) {  // rlimit_nofile
        // no args -> __fern_rlimit_nofile() -> the soft RLIMIT_NOFILE as a
        // full-width i64 in %rax.
        s = s.write("    call __fn___fern_rlimit_nofile\n    pushq %rax\n");
        s = s.need("rlimit_nofile");
    } else if (o.kind_tag == 243 || o.kind_tag == 244) {  // signal_ignore / signal_default
        // [sig]; __fern_signal_{ignore,default}(%rdi=sig) -> the sigaction
        // return, pushed so the statement-level drop balances. [sig] IS
        // param[0] already; the stack ABI needs no marshalling.
        var sig_fn: string = "signal_ignore";
        if (o.kind_tag == 244) { sig_fn = "signal_default"; }
        s = s.write("    call __fn___fern_" + sig_fn + "\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need(sig_fn);
    } else if (o.kind_tag == 237) {  // access
        // [pathbox][mode] (mode on top) -> Result[void, IoError]. Same
        // two-operand shuffle write_file does: the stack ABI wants
        // param[0] on top, so re-push the popped pair in reverse.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_access\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("access");
    } else if (o.kind_tag == 240) {  // hostname
        // no args -> the Fern-compiled __fn___fern_hostname: the node name
        // in ONE fresh rc-headered string box, pushed in %rax.
        s = s.write("    call __fn___fern_hostname\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("hostname");
    } else if (o.kind_tag == 250) {  // uname_field
        // [index] -> __fn___fern_uname_field: one utsname field in ONE
        // fresh rc-headered string box, pushed in %rax.
        s = s.write("    call __fn___fern_uname_field\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("uname_field");
    } else if (o.kind_tag == 251) {  // getcwd
        s = s.write("    call __fn___fern_getcwd\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("getcwd");
    } else if (o.kind_tag == 252) {  // cpu_count
        s = s.write("    call __fn___fern_cpu_count\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("cpu_count");
    } else if (o.kind_tag == 238) {  // geteuid
        s = s.write("    call __fn___fern_geteuid\n    pushq %rax\n");
        s = s.need("geteuid");
    } else if (o.kind_tag == 239) {  // getegid
        s = s.write("    call __fn___fern_getegid\n    pushq %rax\n");
        s = s.need("getegid");
    } else if (o.kind_tag == 246) {  // getuid
        s = s.write("    call __fn___fern_getuid\n    pushq %rax\n");
        s = s.need("getuid");
    } else if (o.kind_tag == 247) {  // getgid
        s = s.write("    call __fn___fern_getgid\n    pushq %rax\n");
        s = s.need("getgid");
    } else if (o.kind_tag == 248) {  // getgroups
        // no args -> the Fern-compiled __fn___fern_getgroups: a fresh i64[]
        // of the supplementary group set, pushed in %rax.
        s = s.write("    call __fn___fern_getgroups\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("getgroups");
    } else if (o.kind_tag == 249) {  // environ
        // no args -> the Fern-compiled __fn___fern_environ: a fresh string[]
        // of the whole environment. Reads the same __fern_envp global env
        // does, which is why the envp need below covers this op too.
        s = s.write("    call __fn___fern_environ\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("environ");
    } else if (o.kind_tag == 189) {  // wasm_timer_pollable
        // [ns]; __fern_wasm_timer_pollable(%rdi=ns) -> -1 on native (no
        // pollable; the deadline comes from poll(2)'s timeout). Portability
        // shim for std/async's with_deadline.
        s = s.write("    popq %rdi\n    call __fern_wasm_timer_pollable\n    pushq %rax\n");
        s = s.need("wasm_timer_pollable");
    } else if (o.kind_tag == 161) {  // wasm_pollable_drop
        // [p]; __fern_wasm_pollable_drop(%rdi=p) -> 0 on native (a pollable
        // is just an fd; nothing to drop). Portability shim.
        s = s.write("    popq %rdi\n    call __fern_wasm_pollable_drop\n    pushq %rax\n");
        s = s.need("wasm_pollable_drop");
    } else if (o.kind_tag == 162) {  // wasm_block
        // [p]; __fern_wasm_block(%rdi=p) -> 0 on native (no pollable to wait
        // on; a deadline uses poll(2)). Push the 0 result.
        s = s.write("    popq %rdi\n    call __fern_wasm_block\n    pushq %rax\n");
        s = s.need("wasm_block");
    } else if (o.kind_tag == 167) {  // wasm_poll
        // [pollables ptr]; __fern_wasm_poll(%rdi=ptr) -> -1 on native (no real
        // pollables; readiness uses poll(2)). Push the -1 result.
        s = s.write("    popq %rdi\n    call __fern_wasm_poll\n    pushq %rax\n");
        s = s.need("wasm_poll");
    } else if (o.kind_tag == 110) {  // tcp_connect
        // [host_be, port]; __fern_tcp_connect(%rdi=host_be, %rsi=port) -> fd
        // (or -errno) in %rax.
        // [host_be, port] with port on top; the stack ABI wants param[0]
        // (host_be) lowest, so pop and re-push swapped.
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_tcp_connect\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("tcp_connect");
    } else if (o.kind_tag == 114) {  // tcp_send
        // [fd, str box] with the box on top; the stack ABI wants param[0]
        // (fd) lowest, so pop and re-push swapped.
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_tcp_send\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("tcp_send");
    } else if (o.kind_tag == 208) {  // udp_send
        // [host, port, data] with data on top; the stack ABI wants param[0]
        // (host) lowest, so pop and re-push reversed. Before #6917 this op had
        // no case at all and fell through to the comment fallback, which
        // dropped the call.
        s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_udp_send\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.need("udp_send");
    } else if (o.kind_tag == 115) {  // tcp_recv
        // [fd, max] with max on top; the stack ABI wants param[0] (fd)
        // lowest, so pop and re-push swapped.
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_tcp_recv\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("tcp_recv");
    } else if (o.kind_tag == 116) {  // tcp_close
        // [fd] IS param[0] already, so the stack ABI needs no marshalling:
        // call, drop the arg slot, push the result. 0 / -errno.
        s = s.write("    call __fn___fern_tcp_close\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("tcp_close");
    } else if (o.kind_tag == 112) {  // tcp_pollable
        // [fd]; __fern_tcp_pollable(%rdi=fd) -> the fd unchanged (native's
        // readiness token IS the fd).
        s = s.write("    popq %rdi\n    call __fern_tcp_pollable\n    pushq %rax\n");
        s = s.need("tcp_pollable");
    } else if (o.kind_tag == 200) {  // tcp_listen (#4371)
        // [port]; __fern_tcp_listen(%rdi=port) -> listener fd / -errno in %rax.
        // [port] IS param[0] already; the stack ABI needs no marshalling.
        s = s.write("    call __fn___fern_tcp_listen\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("tcp_listen");
    } else if (o.kind_tag == 201) {  // tcp_accept (#4371)
        // [listener fd] IS param[0] already. -> connection fd / -errno.
        s = s.write("    call __fn___fern_tcp_accept\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("tcp_accept");
    } else if (o.kind_tag == 320) {  // tcp_local_port
        // [fd] IS param[0] already. -> the bound port / -errno.
        s = s.write("    call __fn___fern_tcp_local_port\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("tcp_local_port");
    } else if (o.kind_tag == 308) {  // write_some (#9231)
        // [fd, str box], marshalled exactly as writer_write's are; the
        // Fern __fn___fern_writer_write_some(fd, s) pushes a fresh
        // Result[i64, IoError] box, so heap + its own need.
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_writer_write_some\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("write_some");
    } else if (o.kind_tag == 203) {  // open_file (#4372)
        // [path box]; the Fern __fn___fern_open_res(path, flags(imm), mode)
        // -> a fresh Result[Reader|Writer, IoError] box via the stack ABI:
        // args pushed 3rd-first, so param[0] lands at the lowest address.
        // Allocates the NUL-term buffer + the Result box, so heap +
        // open_file needs.
        //
        // 0600 for the EXCLUSIVE opener, 0666 for the rest: its callers are
        // creating a file only they should hold (gnulib's create_temp_file
        // is 0600 for the same reason), and a spool of piped input must not
        // be world-readable while it exists. The imm is the canonical
        // x86-64 flag word — asmcore's helper translates it per target — so
        // 193 identifies the exclusive opener on every one.
        var open_mode: i32 = 438;
        if (o.i32_imm == 193) { open_mode = 384; }
        s = s.write("    popq %rdi\n    movq $" + util.i32_to_string(o.i32_imm) + ", %rsi\n    movq $" + util.i32_to_string(open_mode) + ", %rdx\n");
        s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_open_res\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("open_file");
    } else if (o.kind_tag == 304 || o.kind_tag == 305) {  // open_reader_with / open_writer_with
        // [path box, flags]; __fn___fern_open_with(path, flags, write) ->
        // a fresh Result[Reader|Writer, IoError] box, through open_res,
        // so both needs.
        var open_write: i32 = 0;
        if (o.kind_tag == 305) { open_write = 1; }
        s = s.write("    popq %rsi\n    popq %rdi\n    movq $" + util.i32_to_string(open_write) + ", %rdx\n");
        s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_open_with\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("open_file"); s = s.need("open_with");
    } else if (o.kind_tag == 80) {  // heap_bump_bytes
        s = emit_ir_op_heap_bump_bytes(o, s);
    } else if (o.kind_tag == 315) {  // heap_alloc_count
        s = emit_ir_op_heap_alloc_count(o, s);
    } else if (o.kind_tag == 229) {  // heap_mark
        s = emit_ir_op_heap_mark(o, s);
    } else if (o.kind_tag == 230) {  // heap_release_to
        s = emit_ir_op_heap_release_to(o, s);
    } else if (o.kind_tag == 209) {  // read_all_stdin
        // no args -> call the Fern-compiled __fn___fern_read_all_stdin (#2649):
        // fd 0 to EOF in ONE fresh string box, pushed as a value op. Allocates,
        // so it pulls in the heap runtime.
        s = s.write("    call __fn___fern_read_all_stdin\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("read_all_stdin");
    } else if (o.kind_tag == 260) {  // create_dir
        // [pathbox][mode] (mode on top) -> Result[void, IoError]. The
        // same two-operand shuffle `access` does: the stack ABI wants
        // param[0] on top, so re-push the popped pair in reverse.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_create_dir\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("create_dir");
    } else if (o.kind_tag == 261) {  // remove_dir
        // [pathbox] IS param[0] (+16) — one rmdir(2), ENOTEMPTY included.
        s = s.write("    call __fn___fern_remove_dir\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("remove_dir");
    } else if (o.kind_tag == 277) {  // chdir
        // [pathbox] IS param[0] (+16) — one chdir(2).
        s = s.write("    call __fn___fern_chdir\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("chdir");
    } else if (o.kind_tag == 316) {  // chroot
        // [pathbox] IS param[0] (+16) — one chroot(2), same shape.
        s = s.write("    call __fn___fern_chroot\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("chroot");
    } else if (o.kind_tag == 317) {  // setuid
        // [id] IS param[0]; the helper range-checks before the syscall.
        s = s.write("    call __fn___fern_setuid\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("setuid");
    } else if (o.kind_tag == 318) {  // setgid
        s = s.write("    call __fn___fern_setgid\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("setgid");
    } else if (o.kind_tag == 319) {  // setgroups
        // [gidsbox] IS param[0]; the helper packs it to 32-bit gids.
        s = s.write("    call __fn___fern_setgroups\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("setgroups");
    } else if (o.kind_tag == 278) {  // signal_mask
        // [how][mask] with mask on top; the stack ABI wants param[0]
        // (how) on top, so re-push the popped pair in reverse.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_signal_mask\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("signal_mask");
    } else if (o.kind_tag == 279) {  // signal_disposition
        // [sig] IS param[0] already; the stack ABI needs no marshalling.
        s = s.write("    call __fn___fern_signal_disposition\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("signal_disposition");
    } else if (o.kind_tag == 262) {  // create_link
        // [targetbox][pathbox] (path on top) -> Result[void, IoError].
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_create_link\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("create_link");
    } else if (o.kind_tag == 267) {  // rename
        // [oldbox][newbox] (new on top) -> Result[void, IoError].
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_rename\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("rename");
    } else if (o.kind_tag == 263) {  // create_symlink
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_create_symlink\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("create_symlink");
    } else if (o.kind_tag == 264) {  // read_link
        // [pathbox] IS param[0] (+16) — pushes a fresh
        // Result[string, IoError] holding the link's target.
        s = s.write("    call __fn___fern_read_link\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("read_link");
    } else if (o.kind_tag == 268) {  // chmod
        // [pathbox][mode] (mode on top) -> Result[void, IoError]. The
        // operands are in param order but on the wrong end of the stack,
        // so pop both and re-push with param[0] (path) on top.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_chmod\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("chmod");
    } else if (o.kind_tag == 274) {  // mknod
        // [pathbox][mode][major][minor] (minor on top) ->
        // Result[void, IoError]. Four operands in param order but on
        // the wrong end of the stack, so pop all four and re-push with
        // param[0] (path) on top.
        s = s.write("    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rcx\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_mknod\n    addq $32, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("mknod");
    } else if (o.kind_tag == 275) {  // chown_at
        // [pathbox][uid][gid][follow] (follow on top) -> Result[void,
        // IoError]. Four operands, reversed the same way as mknod's.
        s = s.write("    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rcx\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_chown_at\n    addq $32, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("chown_at");
    } else if (o.kind_tag == 321) {  // chmod_at
        // [pathbox][mode][follow] (follow on top) -> Result[void,
        // IoError]. Three operands, reversed the way set_window_size's
        // are: param[0] (path) lowest.
        s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_chmod_at\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("chmod_at");
    } else if (o.kind_tag == 273) {  // truncate
        // [pathbox][length] (length on top) -> Result[void, IoError].
        // Same reversal as chmod; the length is a full 64-bit word.
        s = s.write("    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rsi\n    pushq %rdi\n    call __fn___fern_truncate\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("truncate");
    } else if (o.kind_tag == 269) {  // set_file_times
        // [pathbox][asec][ansec][msec][mnsec][flags] (flags on top) ->
        // Result[void, IoError]. Six operands, reversed the same way.
        s = s.write("    popq %r9\n    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %r9\n    pushq %r8\n    pushq %rcx\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_set_file_times\n    addq $48, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("set_file_times");
    } else if (o.kind_tag == 265) {  // umask
        // [mask] IS param[0] (+16) — one syscall, the previous mask
        // in %rax. Nothing is boxed, so no heap need.
        s = s.write("    call __fn___fern_umask\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("umask");
    } else if (o.kind_tag == 270) {  // statfs
        // [pathbox] IS param[0]; same stack ABI as stat, pushing a fresh
        // Result[FsStat, IoError]. The FsStat shape label is pre-interned
        // in the literal pool below, as FileStat's is.
        s = s.write("    call __fn___fern_statfs\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("statfs");
    } else if (o.kind_tag == 299) {  // fd_fsync
        // [fd] IS param[0]; __fn___fern_fd_fsync pushes a fresh
        // Option[IoError], None once the write-back is scheduled.
        s = s.write("    call __fn___fern_fd_fsync\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_fsync");
    } else if (o.kind_tag == 300) {  // fd_fdatasync
        s = s.write("    call __fn___fern_fd_fdatasync\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_fdatasync");
    } else if (o.kind_tag == 301) {  // fd_syncfs
        s = s.write("    call __fn___fern_fd_syncfs\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_syncfs");
    } else if (o.kind_tag == 298) {  // sync
        // No operands. sync(2) cannot fail, but its return is pushed for
        // the statement-position drop, as sleep_ns's is.
        s = s.write("    call __fn___fern_sync\n    pushq %rax\n");
        s = s.need("sync");
    } else if (o.kind_tag == 241) {  // fd_stat
        // [fd] IS param[0]; the Fern-compiled __fn___fern_fd_stat pushes a
        // fresh Result[FileStat, IoError], the FileStat shape pre-interned
        // with stat's.
        s = s.write("    call __fn___fern_fd_stat\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_stat");
    } else if (o.kind_tag == 311) {  // fd_dup_onto
        // [fd][newfd]; the Fern __fn___fern_fd_dup_onto(fd, newfd) pushes
        // a fresh Option[IoError]. newfd is on top but param[0] is fd, so
        // swap before the call, as writer_truncate does.
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_fd_dup_onto\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_dup_onto");
    } else if (o.kind_tag == 307) {  // fd_flags
        // [fd] IS param[0], like fd_stat; the Fern-compiled
        // __fn___fern_fd_flags pushes a fresh Result[i64, IoError].
        s = s.write("    call __fn___fern_fd_flags\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("reader"); s = s.need("fd_flags");
    } else if (o.kind_tag == 242) {  // reader_seek
        // [fd][offset][whence] (whence on top) -> Result[i64, IoError]. The
        // operands are in param order but on the wrong end: pop all three
        // and re-push with param[0] (fd) on top, as subprocess does.
        s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_reader_seek\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("reader"); s = s.need("reader_seek");
    } else if (o.kind_tag == 330) {  // reader_splice
        // [fd][out_fd][max] (max on top) -> Result[i64, IoError], re-pushed
        // with param[0] (fd) on top as reader_seek is.
        s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
        s = s.write("    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    call __fn___fern_reader_splice\n    addq $24, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("reader"); s = s.need("reader_splice");
    } else if (o.kind_tag == 281) {  // writer_truncate
        // [fd][length]; the Fern __fn___fern_writer_truncate(fd, length)
        // pushes a fresh Option[IoError]. The length is on top but param[0]
        // is fd, so swap before the call, as writer_write does.
        s = s.write("    popq %rsi\n    popq %rdi\n    pushq %rsi\n    pushq %rdi\n");
        s = s.write("    call __fn___fern_writer_truncate\n    addq $16, %rsp\n    pushq %rax\n");
        s = s.need("heap"); s = s.need("reader"); s = s.need("writer_truncate");
    } else if ((o.kind_tag >= 291 && o.kind_tag <= 297) || o.kind_tag == 306 || o.kind_tag == 325 || o.kind_tag == 326 || o.kind_tag == 328) {  // the buf_* builder
        s = emit_ir_op_buf(o, s);
    } else if (o.kind_tag == 181) {  // sleep_ms
        // [ms] -> nanosleep(ms). Push the syscall return so the
        // statement-level drop balances (sleep_ms is void).
        s = s.write("    call __fn___fern_sleep_ms\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("sleep_ms");
    } else if (o.kind_tag == 266) {  // sleep_ns
        // [ns] -> nanosleep(ns) at full resolution. Same stack ABI as
        // sleep_ms — one word in, the syscall return pushed for the drop.
        s = s.write("    call __fn___fern_sleep_ns\n    addq $8, %rsp\n    pushq %rax\n");
        s = s.need("sleep_ns");
    } else if (o.kind_tag >= 125 && o.kind_tag <= 137) {  // the map ops
        s = emit_ir_op_map(o, i, lp, s);
    } else if (o.kind_tag == 146) {  // dyn_box
        s = emit_ir_op_dyn_box(o, s);
    } else if (o.kind_tag == 148) {  // dyn_downcast
        s = emit_ir_op_dyn_downcast(o, i, lp, s);
    } else {
        ircore.flat_arm_missing(o);
    }
    return s;
}

// emit_ir_op_buf emits the capacity-carrying string builder's seven ops
// (#8773). All of them take the register ABI the __fern_buf_* bundle is written
// in, so the operands pop straight into the argument registers with none of the
// re-push a stack-ABI __fn___fern_* helper needs. Each arm pushes %rax: the
// handle, the length or the string box for the value ops, and the helper's
// return as the dummy a statement-level drop takes for the rest.
function emit_ir_op_buf(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    var k: i32 = asmcore.buf_arity(o.kind_tag);
    while (k > 0) {
        k = k - 1;
        s = s.write("    popq " + ssa_arg_regs()[k] + "\n");
    }
    s = s.write("    call " + asmcore.buf_helper(o.kind_tag) + "\n    pushq %rax\n");
    s = s.need("heap");
    return s.need("buf");
}

// const_text_u32 reports whether an integer literal's SOURCE TEXT spells a
// value in [0, 2^32) that `movl $TEXT, %eax` loads exactly as `movq` (or
// `movabsq`) would: a plain decimal of at most ten digits within the range,
// or `0x` and at most eight hex digits. Anything else — a leading `-`, a
// binary literal, a wider value — keeps the 64-bit form, whose sign
// extension or full width the narrow write could not reproduce.
function const_text_u32(t: string): boolean {
    if (t.len() > 2 && t[0] == 48 && (t[1] == 120 || t[1] == 88)) {
        return t.len() <= 10 && hex_digits(t, 2);
    }
    if (!util.is_all_digits(t) || t.len() > 10) { return false; }
    return util.digits_to_i64(t) <= 4294967295i64;
}

// hex_digits reports whether t[from:] is one or more hex digits.
function hex_digits(t: string, from: i32): boolean {
    if (from >= t.len()) { return false; }
    var i: i32 = from;
    while (i < t.len()) {
        var c: i32 = t[i] as i32;
        var ok: boolean = (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70);
        if (!ok) { return false; }
        i = i + 1;
    }
    return true;
}

function emit_ir_op_heap_bump_bytes(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // bump high-water mark = (__fern_heap_ptr == 0) ? 0 : ptr − base.
    // The arena is mmap'd lazily; its base is recoverable from the
    // recorded end (__fern_heap_end = base + heap_size), so base =
    // end − heap_size. The cursor is 0 until the first alloc, so guard
    // that case to report 0 (matching native's __fern_heap_bump_bytes).
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");   // cursor (0 if uninit)
    s = s.write("    movq __fern_heap_end(%rip), %rcx\n");   // arena end = base + heap_size (0 if uninit)
    s = s.write("    movabs $17179869184, %rdx\n");           // heap_size (0x400000000, 16 GiB)
    s = s.write("    subq %rdx, %rcx\n");                    // %rcx = base = end − heap_size
    s = s.write("    movq %rax, %rdx\n");
    s = s.write("    subq %rcx, %rdx\n");                    // ptr − base
    s = s.write("    xorq %rcx, %rcx\n");
    s = s.write("    testq %rax, %rax\n");                   // ptr == 0 ?
    s = s.write("    cmovneq %rdx, %rcx\n");                 // 0 if uninit, else ptr−base
    s = s.write("    pushq %rcx\n");
    s = s.need("heap");

    return s;
}

// emit_ir_op_heap_alloc_count reads the allocator's call count (#9596),
// ticked at __fern_alloc's entry so the freelist-pop path is counted exactly
// like the bump path. An inline read of the word for heap_bump_bytes's reason:
// a call would only add an ABI. `alloc_count` is the need that puts the
// counter — and the tick — into the runtime, so a program that never asks
// for the number emits neither.
function emit_ir_op_heap_alloc_count(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("    movq __fern_alloc_count(%rip), %rax\n");
    s = s.write("    pushq %rax\n");
    s = s.need("heap");
    s = s.need("alloc_count");

    return s;
}

function emit_ir_op_heap_mark(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // The arena checkpoint: the cursor, plus a snapshot of BOTH freelist
    // head tables into their .bss shadows. The heads are snapshotted
    // rather than cleared because a block allocated AND freed inside the
    // window leaves a head pointing above the mark — after the rewind, a
    // pop and a bump would both hand out that address. Restoring the
    // pre-mark heads drops exactly those entries and keeps the older ones
    // reusable. One live mark at a time: the shadow is a single buffer,
    // so marks do not nest. rep movsq clobbers rcx/rsi/rdi, and the
    // operand stack around an inline op may hold live values in them, so
    // save and restore rather than lean on a caller-saved rule this
    // backend does not otherwise rely on.
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
    s = s.write("    pushq %rcx\n    pushq %rsi\n    pushq %rdi\n");
    s = s.write("    leaq __fern_freelist(%rip), %rsi\n");
    s = s.write("    leaq __fern_freelist_shadow(%rip), %rdi\n");
    s = s.write("    movl $65536, %ecx\n    rep movsq\n");
    s = s.write("    leaq __fern_large_freelist(%rip), %rsi\n");
    s = s.write("    leaq __fern_large_freelist_shadow(%rip), %rdi\n");
    s = s.write("    movl $2560, %ecx\n    rep movsq\n");
    s = s.write("    popq %rdi\n    popq %rsi\n    popq %rcx\n");
    s = s.write("    pushq %rax\n");
    s = s.need("heap");

    return s;
}

function emit_ir_op_heap_release_to(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // Rewind to the mark and restore both head tables. mark == 0 means
    // "taken before the first allocation seeded the cursor", i.e. no
    // checkpoint — leave the cursor alone rather than zero it and hand
    // out the arena base. Releasing is sound only when nothing allocated
    // after the mark is still reachable; the caller owns that invariant,
    // exactly as it owns malloc/free pairing.
    var hrlo: asmcore.LabelOut = asmcore.fresh_label(s);
    var hrl_done: string = hrlo.name;
    s = hrlo.state;
    s = s.write("    popq %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz " + hrl_done + "\n");
    s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
    s = s.write("    pushq %rcx\n    pushq %rsi\n    pushq %rdi\n");
    s = s.write("    leaq __fern_freelist_shadow(%rip), %rsi\n");
    s = s.write("    leaq __fern_freelist(%rip), %rdi\n");
    s = s.write("    movl $65536, %ecx\n    rep movsq\n");
    s = s.write("    leaq __fern_large_freelist_shadow(%rip), %rsi\n");
    s = s.write("    leaq __fern_large_freelist(%rip), %rdi\n");
    s = s.write("    movl $2560, %ecx\n    rep movsq\n");
    s = s.write("    popq %rdi\n    popq %rsi\n    popq %rcx\n");
    s = s.write(hrl_done + ":\n");
    // Push the mark back — the one-value-per-expression invariant the
    // whole op stream keeps (raw_store8 does the same); statement
    // position drops it. Without this the statement's drop pops a value
    // nothing pushed, and the next allocation runs on a corrupt frame.
    // %rax survives both paths: rep movsq clobbers only rcx/rsi/rdi.
    s = s.write("    pushq %rax\n");
    s = s.need("heap");

    return s;
}

// emit_ir_op_map and emit_ir_op_map_read select the map ops, the writes
// and lookups first, the reads and the iterator in the second.
function emit_ir_op_map(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind_tag == 125) {  // map_set
        s = emit_ir_op_map_set(o, s);
    } else if (o.kind_tag == 126) {  // map_len
        s = s.write("    popq %rax\n    movq (%rax), %rax\n    movq (%rax), %rax\n    pushq %rax\n");
    } else if (o.kind_tag == 127) {  // map_get
        s = s.write("    popq %rsi\n    popq %rdi\n");
        if (o.str != "") { s = s.write("    leaq __fn_" + asmcore.sanitize_label(o.str) + "(%rip), %r8\n"); } else { s = s.write("    xorq %r8, %r8\n"); }
        s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rdx\n    call __fern_map_get\n    pushq %rax\n");
    } else if (o.kind_tag == 128) {  // map_has
        s = s.write("    popq %rsi\n    popq %rdi\n");
        if (o.str != "") { s = s.write("    leaq __fn_" + asmcore.sanitize_label(o.str) + "(%rip), %r8\n"); } else { s = s.write("    xorq %r8, %r8\n"); }
        s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rdx\n    call __fern_map_has\n    pushq %rax\n");
    } else if (o.kind_tag == 130) {  // map_delete
        s = emit_ir_op_map_delete(o, s);
    } else if (o.kind_tag == 129) {  // map_get_or
        s = emit_ir_op_map_get_or(o, i, lp, s);
    }
    return emit_ir_op_map_read(o, i, lp, s);
}

// [map, key] -> __fn___fern_map_delete(map, key, keykind, eqfn) -> the
// (map, existed) tuple box. The helper is Fern (#2649), so this is the stack
// ABI: arguments pushed in REVERSE, leaving arg0 (the map) on top, and the
// caller drops every slot after. A delete that releases what it removes
// (#9970) takes __fern_map_delete_rel instead, with the key-free flag, the
// value kind and the two releases behind the four — the key's and the value's
// as ir.map_op_symbols splits them, 0 where the op names none.
function emit_ir_op_map_delete(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    var syms: string[] = ir.map_op_symbols(o);
    var rel: boolean = ir.map_delete_releases(o);
    s = s.need("map_delete");
    if (rel) { s = s.need("map_delete_rel"); }
    s = s.write("    popq %rsi\n    popq %rdi\n");
    var argc: i32 = 4;
    if (rel) {
        argc = 8;
        s = map_fn_address_rax(s, syms[1]);
        s = s.write("    pushq %rax\n");
        if (o.i32_imm == 2) { s = map_fn_address_rax(s, syms[2]); } else { s = s.write("    xorq %rax, %rax\n"); }
        s = s.write("    pushq %rax\n");
        s = s.write("    movq $" + util.i32_to_string((o.width / 16) % 4) + ", %rax\n    pushq %rax\n");
        s = s.write("    movq $" + util.i32_to_string((o.width / 2) % 2) + ", %rax\n    pushq %rax\n");
    }
    if (o.i32_imm == 2) { s = map_fn_address_rax(s, syms[0]); } else { s = s.write("    xorq %rax, %rax\n"); }
    s = s.write("    pushq %rax\n");
    s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rax\n    pushq %rax\n");
    s = s.write("    pushq %rsi\n    pushq %rdi\n");
    if (rel) { s = s.write("    call __fn___fern_map_delete_rel\n"); } else { s = s.write("    call __fn___fern_map_delete\n"); }
    return s.write("    addq $" + util.i32_to_string(argc * 8) + ", %rsp\n    pushq %rax\n");
}

// map_fn_address_rax loads the address of the Fern function `name` spells
// into %rax, or 0 when it spells none.
function map_fn_address_rax(s: asmcore.EmitState, name: string): asmcore.EmitState {
    if (name == "") { return s.write("    xorq %rax, %rax\n"); }
    return s.write("    leaq __fn_" + asmcore.sanitize_label(name) + "(%rip), %rax\n");
}

function emit_ir_op_map_read(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind_tag == 131) {  // map_keys
        s = emit_ir_op_map_keys(o, s);
    } else if (o.kind_tag == 132) {  // map_values
        // parallel-array map: values[] pointer at box+8. Same scalar-column
        // snapshot / string-column retain-snapshot / pointer-column alias
        // split as map_keys above.
        if (o.i32_imm == 0) {
            s = s.write("    popq %rdi\n    movq 8(%rdi), %rdi\n    call __fern_map_snapshot_col\n    pushq %rax\n");
        } else if (o.i32_imm == 2) {
            s = s.write("    popq %rdi\n    movq 8(%rdi), %rdi\n    call __fern_map_snapshot_col_str\n    pushq %rax\n");
        } else {
            s = s.write("    popq %rax\n    movq 8(%rax), %rax\n    pushq %rax\n");
        }
    } else if (o.kind_tag == 133) {  // map_iter
        // m.iter() -> a two-slot array box [map_ptr@8, cursor@16] off the data
        // pointer, so it carries an rc header and the typed lowering's release
        // (__fern_arr_dec) frees it.
        s = s.write("    movq $2, %rdi\n    call __fern_arr_box\n");
        s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    movq $0, 16(%rax)\n    pushq %rax\n");
    } else if (o.kind_tag == 134) {  // mapiter_has_next
        // cursor < keys.len: keys[] at map@0, len at keys@0 (asm.fern:1269).
        s = s.write("    popq %rax\n    movq 16(%rax), %rcx\n    movq 8(%rax), %rdx\n");
        s = s.write("    movq (%rdx), %rdx\n    movq (%rdx), %rdx\n");
        s = s.write("    cmpq %rdx, %rcx\n    movq $0, %rax\n    setl %al\n    movzbq %al, %rax\n    pushq %rax\n");
    } else if (o.kind_tag == 135) {  // mapiter_key
        // keys[cursor]: keys[] at map@0, element[cursor] at (keys, cursor+1, 8).
        s = s.write("    popq %rax\n    movq 16(%rax), %rcx\n    movq 8(%rax), %rdx\n    movq (%rdx), %rdx\n");
        s = s.write("    incq %rcx\n    movq (%rdx,%rcx,8), %rax\n    pushq %rax\n");
    } else if (o.kind_tag == 136) {  // mapiter_value
        // values[cursor]: values[] at map@8, element[cursor] at (values, cursor+1, 8).
        s = s.write("    popq %rax\n    movq 16(%rax), %rcx\n    movq 8(%rax), %rdx\n    movq 8(%rdx), %rdx\n");
        s = s.write("    incq %rcx\n    movq (%rdx,%rcx,8), %rax\n    pushq %rax\n");
    } else if (o.kind_tag == 137) {  // mapiter_advance
        // bump the stored cursor; push a dummy result for the statement drop.
        s = s.write("    popq %rax\n    movq 16(%rax), %rcx\n    incq %rcx\n    movq %rcx, 16(%rax)\n    pushq $0\n");
    }
    return s;
}

function emit_ir_op_map_set(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // vretain (o.width bit 3, #6880): the VALUE is an aliased array and
    // this runtime stores the pointer with no rc-inc, so the store owes
    // it a retain — the exit dec-sweep releases every array slot, and
    // without this the map's column is left naming a freed block.
    // Emitted before the pops, off the stack top, so the value's own
    // slot is untouched; __fn___fern_rc_inc is a leaf clobbering only
    // %rax/%rcx (dead here — this backend keeps values on the stack).
    if ((o.width / 8) % 2 == 1) {
        s = s.write("    movq (%rsp), %rax\n    pushq %rax\n    call __fn___fern_rc_inc\n    addq $8, %rsp\n");
    }
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
    // %r8 = derived eq fn for a struct/enum key ("K.eq"), or 0 for a
    // scalar/string key. __fern_map_set dispatches struct keys through it
    // (call *) instead of i32/string compare. #2671.
    // %r10 = the value release for a column of boxes (vkind 3), which the
    // overwrite calls on the value it supersedes; %r11 = the key release of a
    // keyed column, which the overwrite calls on a consumed key it discards
    // (#9962); 0 where the op names none. ir.map_op_symbols splits the three.
    var syms: string[] = ir.map_op_symbols(o);
    if (o.i32_imm == 2 && syms[0] != "") { s = s.write("    leaq __fn_" + asmcore.sanitize_label(syms[0]) + "(%rip), %r8\n"); } else { s = s.write("    xorq %r8, %r8\n"); }
    if (syms[1] != "") { s = s.write("    leaq __fn_" + asmcore.sanitize_label(syms[1]) + "(%rip), %r10\n"); } else { s = s.write("    xorq %r10, %r10\n"); }
    if (o.i32_imm == 2 && syms[2] != "") { s = s.write("    leaq __fn_" + asmcore.sanitize_label(syms[2]) + "(%rip), %r11\n"); } else { s = s.write("    xorq %r11, %r11\n"); }
    // %r9 = per-insert flag bits:
    //   bit 0 = kconsume: the KEY arg is a fresh sole-owned string temp
    //     (o.width bit 1, set by irlower's is_fresh_str_temp). map_set
    //     frees the discarded key on an overwrite so a recurring computed
    //     key doesn't leak (the register twin of wasm #4876).
    //   bit 1 = owncols (o.width bit 2, #4353/#5335): every column of the
    //     map snapshots on read (i32 → kinds 131/132 flag 0, string →
    //     flag 2), so the map solely owns its column buffers and the grow
    //     path may free the superseded buffer (__fern_arr_push_owned).
    // A map with an i64/f64/struct/generic column has owncols clear →
    // %r9 bit 1 = 0 → old leak-only grow (its reads raw-alias the
    // buffer), and an i32/interned key is never fresh → bit 0 = 0 → no
    // overwrite key free: exactly the historical behaviour.
    //   bits 2/3 = vkind (o.width bits 4/5, #9300): the value column owns one
    //     unit per live entry, so the superseded value on an overwrite is
    //     released — 1 through __fern_str_free, 2 through __fern_str_arr_free,
    //     3 through the function in %r10.
    //     0 keeps the historical behaviour, which is what the AST path passes.
    var r9bits: i32 = 0;
    if ((o.width / 2) % 2 == 1) { r9bits = r9bits + 1; }
    if ((o.width / 4) % 2 == 1) { r9bits = r9bits + 2; }
    if ((o.width / 16) % 2 == 1) { r9bits = r9bits + 4; }
    if ((o.width / 32) % 2 == 1) { r9bits = r9bits + 8; }
    if (r9bits >= 4) { s = s.need("map_vfree"); }
    if (r9bits != 0) { s = s.write("    movq $" + util.i32_to_string(r9bits) + ", %r9\n"); } else { s = s.write("    xorq %r9, %r9\n"); }
    s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rcx\n    call __fern_map_set\n    pushq %rax\n");

    return s;
}

function emit_ir_op_map_get_or(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    // [map, k, default] -> __fern_map_get, then Some payload or default.
    // The Option box __fern_map_get allocates is consumed RIGHT HERE —
    // tag + payload extracted, nothing else ever sees it — so it is
    // released here. Without this every get_or leaked one box (#4357's
    // dominant residual map leak on this path: ~16 B/call, unbounded in
    // a loop). The payload was retained separately (__map_retain_val
    // inside the helper's Fern twin; the asm helper hands out the raw
    // value), so releasing the shell never touches the value.
    var golbl: string = lp + "go" + util.i32_to_string(i);
    s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n");
    if (o.str != "") { s = s.write("    leaq __fn_" + asmcore.sanitize_label(o.str) + "(%rip), %r8\n"); } else { s = s.write("    xorq %r8, %r8\n"); }
    s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rdx\n    call __fern_map_get\n    popq %rdx\n");
    s = s.write("    movq (%rax), %rcx\n    movq 8(%rax), %rsi\n");
    // The box carries an rc header, so the release has to go through
    // __fern_arr_dec rather than a raw freelist push: a headered block
    // threaded straight onto the freelist corrupts it.
    s = s.write("    pushq %rdx\n    pushq %rcx\n    pushq %rsi\n    pushq %rax\n    call __fn___fern_arr_dec\n    addq $8, %rsp\n    popq %rsi\n    popq %rcx\n    popq %rdx\n");
    s = s.write("    testq %rcx, %rcx\n    jnz " + golbl + "_d\n");
    s = s.write("    movq %rsi, %rax\n    jmp " + golbl + "_e\n");
    s = s.write(golbl + "_d:\n    movq %rdx, %rax\n" + golbl + "_e:\n    pushq %rax\n");

    return s;
}

function emit_ir_op_map_keys(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // parallel-array map: keys[] pointer at box+0. Scalar column
    // (i32_imm 0, #4353): SNAPSHOT it into a fresh rc=1 copy via
    // __fern_map_snapshot_col so the result is an owned array (the
    // exit sweep reclaims the copy, not the map's live buffer) and a
    // later growing m.set can free the superseded buffer without
    // dangling this read. i64/f64/struct/generic column (i32_imm 1):
    // keep the historical raw-buffer alias (and owncols stays clear).
    if (o.i32_imm == 0) {
        s = s.write("    popq %rdi\n    movq (%rdi), %rdi\n    call __fern_map_snapshot_col\n    pushq %rax\n");
    } else if (o.i32_imm == 2) {
        // String column (#4353 slice 3): snapshot + per-element
        // rc-inc, so the read owns its strings; the SARR post-loop
        // release deep-frees the copy via __fern_str_arr_free.
        s = s.write("    popq %rdi\n    movq (%rdi), %rdi\n    call __fern_map_snapshot_col_str\n    pushq %rax\n");
    } else {
        s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
    }

    return s;
}

// helper_call_needs marks the runtime bodies a call to the helper `name`
// requires, for both emits of a call_direct: the stack machine's and the
// SSA backend's. A call_direct does not imply a need, so without these a
// call site is emitted against a body the runtime never writes.
function helper_call_needs(name: string, s: asmcore.EmitState): asmcore.EmitState {
    if (name == "__fern_i32_to_string") { s = s.need("heap"); s = s.need("i32_to_string"); }
    // __fern_u32_to_string likewise allocates its result box (#2649).
    if (name == "__fern_u32_to_string") { s = s.need("heap"); s = s.need("u32_to_string"); }
    // The WIDE siblings (#5826) — same shape: each allocates its result
    // box, so each needs the heap runtime plus its own body.
    if (name == "__fern_i64_to_string") { s = s.need("heap"); s = s.need("i64_to_string"); }
    if (name == "__fern_u64_to_string") { s = s.need("heap"); s = s.need("u64_to_string"); }
    // __fern_map_find's body is emitted with the maps bundle; a call to it from
    // __fern_map_delete's Fern body must pull that bundle in, since call_direct
    // does not imply a need.
    if (name == "__fern_map_find") { s = s.need("maps"); }
    // chr allocates its 1-char box, so pull in the heap runtime too.
    if (name == "__fern_chr") { s = s.need("heap"); s = s.need("chr"); }
    // arr.join(sep) needs its own body + the heap runtime it fills its
    // exact-size block from (mark_arr_str_join sets both). #5328.
    if (name == "__fern_arr_str_join") { s = s.mark_arr_str_join(); }
    // arr-of-arr reclaim helpers (#4355 slice 9): bodies gated on these
    // needs in emit_ir_runtime — a binary with no arr-of-arr reclaim
    // must not carry them, since the strarrarr body's inner
    // `call __fn___fern_str_arr_free` text would trip the negative
    // asm-grep contracts (e.g. strarr-elem-alias-excluded). Both free
    // through the freelist, so they need the heap runtime.
    if (name == "__fern_arrarr_free") { s = s.need("heap"); s = s.need("arrarr_free"); }
    if (name == "__fern_arr_inc_elems") { s = s.need("arr_inc_elems"); }
    // The VIEW-aware string[] element walk (#6544) is gated the same way
    // and for the same reason: its body's inner
    // `call __fn___fern_str_view_free` must not appear in a binary that
    // never reclaims a builtin string[]. Frees through the freelist, so
    // it needs the heap runtime.
    // The box-VALUE-column map frees (#4353 item 3) free that column
    // through __fern_arrarr_free, so they pull in its body as well as
    // their own.
    if (name == "__fern_map_free_va" || name == "__fern_map_free_ksva") {
        s = s.need("heap"); s = s.need("arrarr_free"); s = s.need("map_free_va");
    }
    // The string[]-VALUE-column pair frees that column through
    // __fern_strarrarr_free, so they pull in its body as well as their own.
    if (name == "__fern_map_free_vsa" || name == "__fern_map_free_ksvsa") {
        s = s.need("heap"); s = s.need("strarrarr_free"); s = s.need("map_free_vsa");
    }
    // The box-KEY members (#9966) each free the key column through
    // __fern_arrarr_free, so they pull in its body as well as their own; _kavsa
    // frees its value column through __fern_strarrarr_free on top of that.
    if (name == "__fern_map_free_ka") {
        s = s.need("heap"); s = s.need("maps"); s = s.need("arrarr_free"); s = s.need("map_free_ka");
    }
    if (name == "__fern_map_free_kavs") {
        s = s.need("heap"); s = s.need("maps"); s = s.need("arrarr_free"); s = s.need("map_free_kavs");
    }
    if (name == "__fern_map_free_kava") {
        s = s.need("heap"); s = s.need("maps"); s = s.need("arrarr_free"); s = s.need("map_free_kava");
    }
    if (name == "__fern_map_free_kavsa") {
        s = s.need("heap"); s = s.need("maps"); s = s.need("arrarr_free"); s = s.need("strarrarr_free"); s = s.need("map_free_kavsa");
    }
    if (name == "__fern_map_free_vf" || name == "__fern_map_free_ksvf") {
        s = s.need("heap"); s = s.need("maps"); s = s.need("map_free_vf");
    }
    // The keyed-column members (#9962), each its own body; _kfvsa frees its
    // value column through __fern_strarrarr_free on top of its own walk.
    if (name == "__fern_map_free_kf") {
        s = s.need("heap"); s = s.need("maps"); s = s.need("map_free_kf");
    }
    if (name == "__fern_map_free_kfvs") {
        s = s.need("heap"); s = s.need("maps"); s = s.need("map_free_kfvs");
    }
    if (name == "__fern_map_free_kfvsa") {
        s = s.need("heap"); s = s.need("maps"); s = s.need("strarrarr_free"); s = s.need("map_free_kfvsa");
    }
    if (name == "__fern_map_free_kfvf") {
        s = s.need("heap"); s = s.need("maps"); s = s.need("map_free_kfvf");
    }
    // The shallow and string-column frees are emitted with the maps bundle, and
    // a release reached without a map_new in the same unit — a produced
    // callee's, or a drop helper's — has to pull that bundle in.
    if (name == "__fern_map_free" || name == "__fern_map_free_vs" || name == "__fern_map_free_ks" || name == "__fern_map_free_kvs") {
        s = s.need("heap"); s = s.need("maps");
    }
    if (name == "__fern_strarrarr_free") { s = s.need("heap"); s = s.need("strarrarr_free"); }
    if (name == "__fern_optarrarr_free") { s = s.need("heap"); s = s.need("optarrarr_free"); }
    // __map_vals_struct_drop_<T>: the struct-VALUE column walk a reclaimable
    // map takes before __fern_map_free_va; its body pulls in the element walk.
    if (ircore.is_map_vals_struct_drop_name(name)) { s = s.need("heap"); s = s.need("map_vals_struct_drop:" + ircore.map_vals_struct_drop_type(name)); }
    // __field_reclaim_<T> (#3457): record the type so emit_ir_field_reclaims
    // emits exactly the per-type bodies actually called; needs the heap
    // runtime (the freelist + __fn___fern_arr_dec it frees through).
    if (ircore.is_field_reclaim_name(name)) { s = s.need("heap"); s = s.need("field_reclaim:" + ircore.field_reclaim_type(name)); }
    // __struct_drop_<T> (#3457): record the type so emit_ir_struct_drops
    // emits exactly the per-type bodies actually called; needs the heap
    // runtime (the freelist + __fn___fern_arr_dec it frees through).
    if (ircore.is_struct_drop_name(name)) { s = s.need("heap"); s = s.need("struct_drop:" + ircore.struct_drop_type(name)); }
    return s;
}

// dyn_arg_operand is the operand a `dyn Trait` call's argument is read
// from: its register, or its frame slot relative to %rbp.
function dyn_arg_operand(a: asmcore.DynArg): string {
    if (a.reg.len() > 0) { return a.reg; }
    return util.i32_to_string(a.off) + "(%rbp)";
}

// emit_dyn_dispatch_chain is a `dyn Trait` method call: it reads the
// receiver's shape pointer and dispatches to the matching `<Type>.<method>`
// through a compare-branch chain over every module method named `method`
// with a struct receiver, mirroring asm.fern's dyn dispatch. Each matched
// arm pushes the arguments (arg0/receiver on top, asm.fern's ABI) from
// where `args` says they are, calls, and leaves the result in %rax. %rcx
// and %rdx are scratch.
function emit_dyn_dispatch_chain(method: string, args: asmcore.DynArg[], i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    var dargc: i32 = args.len();
    s = s.write("    movq " + dyn_arg_operand(args[0]) + ", %rax\n");
    s = s.write("    movq (%rax), %rcx\n");
    var dend: string = lp + "dynend" + util.i32_to_string(i);
    var dfi: i32 = 0;
    var darmn: i32 = 0;
    while (dfi < s.funcs.len()) {
        var dfd: parser.FuncDecl = s.funcs[dfi];
        var ddbn: string = util.base_type_name(dfd.receiver_type);
        // Dispatch arms: every method named `method` whose receiver is a
        // struct (value carries its shape) OR a primitive/string (value
        // is heap-boxed at coercion — docs/DYN-TRAITS.md §4.2.3). A
        // primitive arm UNBOXES: the receiver holds the box pointer, so
        // arg0 is reloaded from box+8, not pushed directly.
        var dprim: boolean = dfd.receiver_type.len() > 0 && asmcore.is_prim_recv_name(ddbn, s);
        if (irlower.dyn_arm_matches(dfd, method, s.funcs) && dfd.receiver_type.len() > 0
                && (asmcore.is_struct_decl_name(ddbn, s) || dprim)) {
            var dbn: string = ddbn;
            var dlit: asmcore.ShapeRefOut = asmcore.shape_ref(s, dbn);
            s = dlit.state;
            var dnext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
            s = s.write("    leaq " + dlit.label + "(%rip), %rdx\n");
            s = s.write("    cmpq %rdx, %rcx\n");
            s = s.write("    jne " + dnext + "\n");
            var dk: i32 = dargc - 1;
            while (dk >= 0) {
                if (dk == 0 && dprim) {
                    // arg0 is the receiver: unbox the value from box+8.
                    s = s.write("    movq " + dyn_arg_operand(args[0]) + ", %rax\n");
                    s = s.write("    pushq 8(%rax)\n");
                } else {
                    s = s.write("    pushq " + dyn_arg_operand(args[dk]) + "\n");
                }
                dk = dk - 1;
            }
            s = s.write("    call __fn_" + asmcore.sanitize_label(dbn + "." + dfd.name) + "\n");
            s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
            s = s.write("    jmp " + dend + "\n");
            s = s.write(dnext + ":\n");
            darmn = darmn + 1;
        }
        // ENUM-receiver arm (`impl Trait for <Enum>`, #4785): an enum
        // value's offset-0 shape is its VARIANT's interned shape
        // (struct_make with the variant name — the same identity
        // op_variant_is reads), never the enum name itself, so the
        // struct-arm compare above can never identify it. Match the
        // receiver against EVERY variant of the enum; on any hit call
        // `<Enum>.<method>` with the variant box as the receiver (its
        // body's `match (self)` re-reads the variant). Keyed
        // per-variant — not a blanket last-arm fallback like the AST
        // backend's — so two enums implementing the same trait
        // dispatch to their own impls. recv_is_array excludes an
        // array method's `T[]` receiver (base_type_name strips the
        // `[]`, which would otherwise mis-read as an enum — #2766).
        if (irlower.dyn_arm_matches(dfd, method, s.funcs) && dfd.receiver_type.len() > 0
                && !asmcore.recv_is_array(dfd.receiver_type)
                && irlower.decl_is_enum(s.struct_decls, ddbn)) {
            var dehit: string = lp + "dynehit" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
            var denext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
            var dvi: i32 = 0;
            while (dvi < s.struct_decls.decls.len()) {
                if (s.struct_decls.decls[dvi].enum_owner == ddbn) {
                    var vlit: asmcore.ShapeRefOut = asmcore.shape_ref(s, s.struct_decls.decls[dvi].name);
                    s = vlit.state;
                    s = s.write("    leaq " + vlit.label + "(%rip), %rdx\n");
                    s = s.write("    cmpq %rdx, %rcx\n");
                    s = s.write("    je " + dehit + "\n");
                }
                dvi = dvi + 1;
            }
            s = s.write("    jmp " + denext + "\n");
            s = s.write(dehit + ":\n");
            var dek: i32 = dargc - 1;
            while (dek >= 0) {
                s = s.write("    pushq " + dyn_arg_operand(args[dek]) + "\n");
                dek = dek - 1;
            }
            s = s.write("    call __fn_" + asmcore.sanitize_label(ddbn + "." + dfd.name) + "\n");
            s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
            s = s.write("    jmp " + dend + "\n");
            s = s.write(denext + ":\n");
            darmn = darmn + 1;
        }
        dfi = dfi + 1;
    }
    // No arm matched. Unreachable for a well-typed dyn value, so abort
    // (exit 134, like __fern_oob_abort) rather than answer 0.
    s = s.write("    movq $60, %rax\n    movq $134, %rdi\n    syscall\n");
    s = s.write(dend + ":\n");
    return s;
}

function emit_ir_op_dyn_box(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    // Heap-box a primitive/string value coerced into a `dyn Trait` slot
    // (docs/DYN-TRAITS.md §4.2.3). Cell = [shape@0, value@8], 2 words;
    // shape = the interned primitive type name (the SAME .S label struct
    // shapes use), so op_dyn_dispatch's offset-0 compare matches. The
    // cell is rc-HEADERED via __fern_arr_box(cap=2) — exactly like
    // opt_make — so a fresh, non-escaping prim/string dyn local can be
    // freed by the exit sweep's __fern_rc_dec (#4351; the former raw
    // __fern_alloc cell had no header, so it could never be reclaimed).
    // Offsets unchanged (arr_box's len@0 is overwritten by the shape;
    // cap@data-16 drives the free size). The value (one word — an
    // i32/i64/f64 scalar OR a string box pointer) is on the operand
    // stack; alloc first (it survives on the machine stack, like
    // opt_make), then store shape + value, push the cell pointer.
    var dbl: asmcore.ShapeRefOut = asmcore.shape_ref(s, o.str);
    s = dbl.state;
    s = s.write("    movq $2, %rdi\n    call __fern_arr_box\n");
    s = s.write("    leaq " + dbl.label + "(%rip), %rcx\n");
    s = s.write("    movq %rcx, (%rax)\n");
    s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");

    return s;
}

function emit_ir_op_dyn_downcast(o: ir.Op, i: i32, lp: string, s: asmcore.EmitState): asmcore.EmitState {
    // `e as? T` downcast (docs/DYN-TRAITS.md §9). The `dyn` value (a heap
    // pointer carrying its concrete shape @0) is on top of the operand
    // (machine) stack. Read its shape and compare to T's interned shape
    // (the SAME .S label struct_make / dyn_dispatch use, so pointer
    // identity holds): equal → Some(value) box [tag0@0, payload@8]; else
    // → None box [tag1@0, 0@8] — the ordinary Option box `match` reads.
    // The dyn value is held on the machine stack across __fern_alloc (like
    // opt_make/dyn_box), so the hit path reuses it as the Some payload.
    var dcl: asmcore.ShapeRefOut = asmcore.shape_ref(s, o.str);
    s = dcl.state;
    var dcmiss: string = lp + "dcmiss" + util.i32_to_string(i);
    var dcend: string = lp + "dcend" + util.i32_to_string(i);
    s = s.write("    movq (%rsp), %rax\n");        // peek dyn ptr (left on stack)
    s = s.write("    movq (%rax), %rcx\n");        // shape @0
    s = s.write("    leaq " + dcl.label + "(%rip), %rdx\n");
    s = s.write("    cmpq %rdx, %rcx\n    jne " + dcmiss + "\n");
    // hit: Some(value) — pop the dyn ptr as payload.
    s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
    s = s.write("    movq $0, (%rax)\n");
    s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");
    s = s.write("    jmp " + dcend + "\n");
    // miss: None — discard the dyn ptr, build a payloadless tag-1 box.
    s = s.write(dcmiss + ":\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
    s = s.write("    movq $1, (%rax)\n    movq $0, 8(%rax)\n    pushq %rax\n");
    s = s.write(dcend + ":\n");

    return s;
}

// ir_i2f_rax converts the integer in %rax to an f64 pattern in %rax, selected
// by width and signedness. x86 has only the SIGNED cvtsi2sd, so a u32 is
// zero-extended into the 64-bit source first (its value fits i64, so the
// signed convert is then exact), and a u64 with bit 63 set, which a bare
// cvtsi2sd reads as negative (#6051), goes through the round-to-odd halving
// `y = (x >> 1) | (x & 1)`, converts that, and doubles; native's
// emitFConvertI64 sequence. `lb` is a per-op-unique label base.
function ir_i2f_rax(width: i32, unsigned: boolean, lb: string, d: string): string {
    if (width == 64 && unsigned) {
        var u: string = "    testq " + d + ", " + d + "\n    js " + lb + "_big\n";
        u = u + "    cvtsi2sd " + d + ", %xmm0\n    jmp " + lb + "_done\n";
        u = u + lb + "_big:\n";
        u = u + "    movq " + d + ", %rcx\n    shrq $1, %rcx\n    andl $1, " + ssa_r32(d) + "\n    orq " + d + ", %rcx\n";
        u = u + "    cvtsi2sd %rcx, %xmm0\n    addsd %xmm0, %xmm0\n";
        u = u + lb + "_done:\n    movq %xmm0, " + d + "\n";
        return u;
    }
    if (unsigned) { return "    movl " + ssa_r32(d) + ", " + ssa_r32(d) + "\n    cvtsi2sd " + d + ", %xmm0\n    movq %xmm0, " + d + "\n"; }
    return "    cvtsi2sd " + d + ", %xmm0\n    movq %xmm0, " + d + "\n";
}

// emit_module_ir emits a full all-i32-eligible module via the IR path. The
// program is self-contained (pure i32 uses no runtime helpers): every
// function via the IR, then a `_start` that calls __fn_main and exits with
// its result. Caller must ensure all_eligible(mod).
// emit_module_funcs derives the per-module side-tables ONCE and emits every
// function through the IR (asm into the strbuf), marking each function's runtime
// needs (the maps/heap op-scan + the str_*/print mark_* calls all live inside
// emit_function_via_ir). globl_defs marks each `__fn_<label>` `.globl` for
// per-module linking. Shared by emit_module_ir_unit (which then writes _start /
// .rodata / the runtime) and module_runtime_needs (which discards the asm and
// reads the accumulated `needed`). Factoring it out keeps the two callers from
// drifting on which functions / side-tables drive need detection.
// all_funcs / all_structs are the WHOLE-PROGRAM signature view (#3451 step 2 /
// #3454): the union of every loaded module's functions and structs. The
// return-type / signature side-tables are derived over them so a cross-module
// call to an imported function whose return type is non-i32 (string / struct /
// i64 / array / …) is tagged by the CALLEE's real signature — the callee lives
// in a sibling module and would otherwise be invisible, mis-tagging the call as
// i32 and miscompiling a chained method on its result. Only `mod.funcs` are
// EMITTED; all_funcs/all_structs drive analysis only. For the whole-program
// single-unit path all_funcs==mod.funcs / all_structs==mod.structs, so the
// derived tables — and the emitted asm — are byte-identical.
// emit_ir_field_reclaims emits the per-type __field_reclaim_<T> helper bodies
// this module's lowering marked (#3457 field-level move tracking). Each `T` was
// recorded as a "field_reclaim:<T>" need at the call site. Emitted as `.weak`
// (like the shape symbols) so two per-module translation units that both use
// `__field_reclaim_<T>` co-link to one definition. The body calls the shared,
// entry-exported __fn___fern_arr_dec (per-field buffer free) and
// __fn___fern_snapshot_dec (the box free), so a LIBRARY module's body references
// only those .globl externs — never the .bss freelist directly — and resolves
// against the entry's single runtime copy.
function emit_ir_field_reclaims(s: asmcore.EmitState): asmcore.EmitState {
    var ni: i32 = 0;
    while (ni < s.needed.len()) {
        var nd: string = s.needed[ni];
        if (nd.len() > 14 && slice_unchecked(nd, 0, 14) == "field_reclaim:") {
            s = emit_ir_field_reclaim_one(s, slice_unchecked(nd, 14, nd.len()));
        }
        ni = ni + 1;
    }
    return s;
}

// emit_ir_field_reclaim_one emits one __field_reclaim_<sty> body. Stack-arg ABI:
// 24(%rsp)=new, 16=old, 8=snap. For each rc-tracked ARRAY field (offset (k+1)*8
// off the struct box's data pointer) it frees old.field[k] via __fn___fern_arr_dec
// (rc-guarded SHALLOW dec/free — a struct/enum-array field first walks the
// uniquely-owned buffer dec'ing each element box, as __struct_drop does) iff
// old.field[k] differs from new.field[k] (cow)
// AND, when snap != 0, from snap.field[k] (the caller's original). It then frees
// the old box itself via __fn___fern_snapshot_dec(new, old, snap) and returns
// `new` in %rax. r9/r10/r11 hold snap/old/new across the field loop —
// __fn___fern_arr_dec clobbers only rax/rcx/rdx/rsi/rdi/r8, so they survive.
// The uniq arm's __fn___fern_rc_is_unique touches only rax/rcx/rdx, so it keeps
// %rsi (the field value) too.
function emit_ir_field_reclaim_one(s: asmcore.EmitState, sty: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(sty);
    s = s.write(".weak __fn___field_reclaim_" + san + "\n");
    s = s.write("__fn___field_reclaim_" + san + ":\n");
    s = s.write("    movq 24(%rsp), %r11\n");      // new
    s = s.write("    movq 16(%rsp), %r10\n");      // old
    s = s.write("    movq 8(%rsp), %r9\n");        // snap
    s = s.write("    cmpq $0x10000, %r10\n");      // old null / low-addr -> skip fields
    s = s.write("    jb .Lfr_" + san + "_box\n");
    // The SAME box in old and new — a rebind whose callee reused it in place —
    // replaced nothing, and the carried-field arm below releases without the
    // cow compare, so it would dec the only reference to a nested box.
    s = s.write("    cmpq %r10, %r11\n");
    s = s.write("    je .Lfr_" + san + "_box\n");
    var ops: asmcore.RcOp[] = asmcore.field_reclaim_field_ops(s, sty);
    var oi: i32 = 0;
    while (oi < ops.len()) {
        var op: asmcore.RcOp = ops[oi];
        var off: string = util.i32_to_string((op.idx + 1) * 8);
        var ks: string = util.i32_to_string(op.idx);
        s = s.write("    movq " + off + "(%r10), %rsi\n");      // old.field_k
        if (op.cow) {
            s = s.write("    cmpq " + off + "(%r11), %rsi\n");  // == new.field_k? (cow)
            s = s.write("    je .Lfr_" + san + "_skip" + ks + "\n");
        } else if (op.uniq) {
            // Carried nested struct / enum: released, because the base copy's
            // inc left it at rc>=2 and the old box's claim dies here. Unless it
            // is UNIQUE — then no inc was taken and the pointers coincide for
            // another reason (#8198: the callee reused the field's box in place
            // and handed it back), so this dec would free the new binding's box.
            s = s.write("    cmpq " + off + "(%r11), %rsi\n");  // == new.field_k?
            s = s.write("    jne .Lfr_" + san + "_ne" + ks + "\n");
            s = s.write("    pushq %rsi\n");
            s = s.write("    call __fn___fern_rc_is_unique\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    testq %rax, %rax\n");
            s = s.write("    jnz .Lfr_" + san + "_skip" + ks + "\n");
            s = s.write(".Lfr_" + san + "_ne" + ks + ":\n");
        }
        s = s.write("    testq %r9, %r9\n");                    // snap == 0 (local)?
        s = s.write("    jz .Lfr_" + san + "_dec" + ks + "\n");
        s = s.write("    cmpq " + off + "(%r9), %rsi\n");       // == snap.field_k? (caller's)
        s = s.write("    je .Lfr_" + san + "_skip" + ks + "\n");
        s = s.write(".Lfr_" + san + "_dec" + ks + ":\n");
        if (op.kind == "arrarr_free" || op.kind == "arrarr_free_enum") {
            if (op.ty.len() > 0) {
                var esan: string = asmcore.sanitize_label(op.ty);
                var ewalk: string = "struct_arr_elems_drop";
                if (op.kind == "arrarr_free_enum") { ewalk = "enum_arr_elems_drop"; }
                s = s.need(ewalk + ":" + op.ty);
                s = s.write("    pushq %rsi\n");                  // buffer
                s = s.write("    call __fn___" + ewalk + "_" + esan + "\n");
                s = s.write("    addq $8, %rsp\n");
                s = s.write("    movq 24(%rsp), %r11\n");         // reload new
                s = s.write("    movq 16(%rsp), %r10\n");         // reload old
                s = s.write("    movq 8(%rsp), %r9\n");           // reload snap
                s = s.write("    movq " + off + "(%r10), %rsi\n");// reload buffer
            }
            s = s.need("arrarr_free");
            s = s.write("    pushq %rsi\n");                    // old.field_k (buffer)
            s = s.write("    call __fn___fern_arrarr_free\n");  // element walk at rc==1, then the buffer
            s = s.write("    addq $8, %rsp\n");
        } else {
            if (op.kind == "deep_enum_dec") {
                // A DIRECT enum field's live-variant rc payloads, before the box
                // dec below frees the box holding them (#8567). __enum_drop_
                // applies the rc==1 gate itself, so a SHARED enum box keeps its
                // payloads for its other owner. Its inner __fern_arr_dec clobbers
                // %rsi on the large-block path, so reload the frame and the field
                // exactly as the nested-struct arm below does.
                var edsan: string = asmcore.sanitize_label(op.ty);
                s = s.need("enum_drop:" + op.ty);
                s = s.write("    pushq %rsi\n");
                s = s.write("    call __fn___enum_drop_" + edsan + "\n");
                s = s.write("    addq $8, %rsp\n");
                s = s.write("    movq 24(%rsp), %r11\n");          // reload new
                s = s.write("    movq 16(%rsp), %r10\n");          // reload old
                s = s.write("    movq 8(%rsp), %r9\n");            // reload snap
                s = s.write("    movq " + off + "(%r10), %rsi\n"); // reload old.field_k
            }
            if (op.kind == "deep_struct_dec") {
                // The nested struct's OWN rc children, before the box dec below
                // frees the box holding them (#8538). Gated on rc==1: a SHARED
                // inner keeps its fields for its other owner, the same gate
                // __struct_drop_<T>'s deep_struct_drop arm applies.
                // __fern_rc_is_unique leaves %rsi alone; __struct_drop_<ty>
                // clobbers %r9/%r10/%r11, so reload from the stable frame.
                var dsan: string = asmcore.sanitize_label(op.ty);
                s = s.need("struct_drop:" + op.ty);
                s = s.write("    pushq %rsi\n");
                s = s.write("    call __fn___fern_rc_is_unique\n");
                s = s.write("    addq $8, %rsp\n");
                s = s.write("    testq %rax, %rax\n");
                s = s.write("    jz .Lfr_" + san + "_nodeep" + ks + "\n");
                s = s.write("    pushq %rsi\n");
                s = s.write("    call __fn___struct_drop_" + dsan + "\n");
                s = s.write("    addq $8, %rsp\n");
                s = s.write("    movq 24(%rsp), %r11\n");          // reload new
                s = s.write("    movq 16(%rsp), %r10\n");          // reload old
                s = s.write("    movq 8(%rsp), %r9\n");            // reload snap
                s = s.write("    movq " + off + "(%r10), %rsi\n"); // reload old.field_k
                s = s.write(".Lfr_" + san + "_nodeep" + ks + ":\n");
            }
            s = s.write("    pushq %rsi\n");
            if (op.kind == "str_free") {
                s = s.write("    call __fn___fern_str_free\n");     // rc-aware string free (data buffer + box)
            } else if (op.kind == "str_arr_free") {
                s = s.write("    call __fn___fern_str_arr_free\n"); // deep string[] free (rc-guarded)
            } else {
                s = s.write("    call __fn___fern_arr_dec\n");      // shallow dec/free the dead buffer
            }
            s = s.write("    addq $8, %rsp\n");
        }
        s = s.write(".Lfr_" + san + "_skip" + ks + ":\n");
        oi = oi + 1;
    }
    s = s.write(".Lfr_" + san + "_box:\n");
    s = s.write("    pushq %r11\n");                // new
    s = s.write("    pushq %r10\n");                // old
    s = s.write("    pushq %r9\n");                 // snap
    s = s.write("    call __fn___fern_snapshot_dec\n");   // free old box (cow + snap guarded); -> %rax = new
    s = s.write("    addq $24, %rsp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_struct_drops emits the per-type __struct_drop_<T> helper bodies this
// module's lowering marked (#3457 — the deep struct-drop, formerly emitted inline
// by emit_struct_field_drops). Each `T` was recorded as a "struct_drop:<T>" need
// at the call site. `.weak` (like __field_reclaim) so two per-module units that
// both sweep a `T` co-link to one definition; the body references only the shared
// .globl externs __fn___fern_arr_dec / __fn___fern_rc_is_unique.
function emit_ir_struct_drops(s: asmcore.EmitState): asmcore.EmitState {
    var ni: i32 = 0;
    while (ni < s.needed.len()) {
        var nd: string = s.needed[ni];
        // struct_arr_elems_drop: must be checked BEFORE struct_drop: (the former is not
        // a prefix of the latter, but both start distinctly — order is not required,
        // yet keep the more specific longer key first for clarity). Each emitter records
        // its own transitive needs (arr_elems -> struct_drop), absorbed by this index-
        // driven loop.
        if (nd.len() > 22 && slice_unchecked(nd, 0, 22) == "struct_arr_elems_drop:") {
            s = emit_ir_struct_arr_elems_drop_one(s, slice_unchecked(nd, 22, nd.len()));
        } else if (nd.len() > 20 && slice_unchecked(nd, 0, 20) == "enum_arr_elems_drop:") {
            s = emit_ir_enum_arr_elems_drop_one(s, slice_unchecked(nd, 20, nd.len()));
        } else if (nd.len() > 10 && slice_unchecked(nd, 0, 10) == "enum_drop:") {
            s = emit_ir_enum_drop_one(s, slice_unchecked(nd, 10, nd.len()));
        } else if (nd.len() > 21 && slice_unchecked(nd, 0, 21) == "map_vals_struct_drop:") {
            s = emit_ir_map_vals_struct_drop_one(s, slice_unchecked(nd, 21, nd.len()));
        } else if (nd.len() > 12 && slice_unchecked(nd, 0, 12) == "struct_drop:") {
            s = emit_ir_struct_drop_one(s, slice_unchecked(nd, 12, nd.len()));
        }
        ni = ni + 1;
    }
    return s;
}

// emit_ir_map_vals_struct_drop_one emits __map_vals_struct_drop_<T>(box) -> box:
// the VALUE column of a reclaimable struct-valued map walked through
// __struct_arr_elems_drop_<T>, so every sole-owned value box releases its own rc
// fields before __fern_map_free_va's one-dec walk frees the boxes. The asm map
// box is the raw {keys@0, vals@8} pair; the element walk clobbers r11, so the
// box comes back from the stack arg.
function emit_ir_map_vals_struct_drop_one(s: asmcore.EmitState, sty: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(sty);
    s = s.need("struct_arr_elems_drop:" + sty);
    s = s.write(".weak __fn___map_vals_struct_drop_" + san + "\n");
    s = s.write("__fn___map_vals_struct_drop_" + san + ":\n");
    s = s.write("    movq 8(%rsp), %rax\n");          // box
    s = s.write("    cmpq $0x10000, %rax\n");         // null / low-addr -> nothing to walk
    s = s.write("    jb .Lmvsd_" + san + "_ret\n");
    s = s.write("    movq 8(%rax), %rdi\n");          // vals = box[8]
    s = s.write("    pushq %rdi\n");
    s = s.write("    call __fn___struct_arr_elems_drop_" + san + "\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    movq 8(%rsp), %rax\n");          // return box (caller drops)
    s = s.write(".Lmvsd_" + san + "_ret:\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_struct_drop_one emits one __struct_drop_<sty>(box) -> box body. Stack-
// arg ABI: 8(%rsp)=box. For each rc-tracked ARRAY field (offset (k+1)*8 off the
// box's data pointer) it releases the field BUFFER via __fn___fern_arr_dec (rc-
// guarded SHALLOW dec/free). For a struct/enum-array field __fn___fern_arrarr_free
// does the same one level deeper: the element boxes when the buffer is uniquely
// owned, then the buffer.
// Returns `box` in %rax (the call site drops it). %r11 holds box across the field
// loop — the released-through helpers preserve it (__fern_arr_dec, __fern_str_free
// and __fern_arrarr_free clobber only rax/rcx/rdx/rsi/rdi/r8 and the callee-saved
// set they restore), and the two that do not (__struct_drop_*,
// __struct_arr_elems_drop_*) reload it from the stack arg.
// Mirrors the IR ops the inline emit_struct_field_drops used to write.
function emit_ir_struct_drop_one(s: asmcore.EmitState, sty: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(sty);
    s = s.write(".weak __fn___struct_drop_" + san + "\n");
    s = s.write("__fn___struct_drop_" + san + ":\n");
    s = s.write("    movq 8(%rsp), %r11\n");       // box
    s = s.write("    movq %r11, %rax\n");          // return box (caller drops)
    s = s.write("    cmpq $0x10000, %r11\n");      // box null / low-addr -> skip fields
    s = s.write("    jb .Lstd_" + san + "_ret\n");
    // Which arm each field takes is asmcore.struct_drop_field_ops' call (#7736);
    // this loop is only the x86 selection for each directive it hands back.
    var ops: asmcore.RcOp[] = asmcore.struct_drop_field_ops(s, sty);
    var oi: i32 = 0;
    while (oi < ops.len()) {
        var op: asmcore.RcOp = ops[oi];
        var off: string = util.i32_to_string((op.idx + 1) * 8);
        var ks: string = util.i32_to_string(op.idx);
        if (op.kind == "elems_drop_struct") {
            // MULTI-LEVEL array-element deep-drop (#2649): release each element's
            // OWN rc fields before the element/buffer decs below free the boxes.
            // The helper calls __struct_drop_X, clobbering r9/r10/r11, so reload
            // box from the frameless stack arg 8(%rsp) afterwards.
            var esan: string = asmcore.sanitize_label(op.ty);
            s = s.need("struct_arr_elems_drop:" + op.ty);
            s = s.write("    movq " + off + "(%r11), %rdi\n");      // buffer
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___struct_arr_elems_drop_" + esan + "\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    movq 8(%rsp), %r11\n");                // reload box (helper clobbered r11)
        } else if (op.kind == "elems_drop_enum") {
            // The ENUM-array sibling: shape-dispatch each element and dec its
            // leak-safe-array payloads before the box decs below.
            var easan: string = asmcore.sanitize_label(op.ty);
            s = s.need("enum_arr_elems_drop:" + op.ty);
            s = s.write("    movq " + off + "(%r11), %rdi\n");      // buffer
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___enum_arr_elems_drop_" + easan + "\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    movq 8(%rsp), %r11\n");                // reload box (helper clobbered r11)
        } else if (op.kind == "box_walk_dec") {
            // __fern_arrarr_free IS this directive: sole-owner gate, one
            // __fern_arr_dec per element, then the buffer freed by arr_dec's own
            // rc==1 path. Its immortal / shared / underflow arms answer exactly
            // as the open-coded walk's rc_is_unique + trailing arr_dec did.
            s = s.need("arrarr_free");
            s = s.write("    movq " + off + "(%r11), %rdi\n");          // box.field_k (buffer)
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___fern_arrarr_free\n");          // element walk at rc==1, then the buffer
            s = s.write("    addq $8, %rsp\n");
        } else if (op.kind == "deep_struct_drop") {
            // DEEP nested-struct field drop (Perceus slice 3 deep-drop): when the
            // inner box is UNIQUELY owned, __struct_drop_<ty> releases the inner's
            // OWN rc-array buffers; the arr_dec directive that follows frees the
            // inner box. The type is deep-drop-ok (acyclic), so the emitted call
            // graph is a DAG. __fern_arr_dec / __fern_rc_is_unique preserve %r11,
            // but __struct_drop_<ty> CLOBBERS it, so reload box from the stable
            // stack arg 8(%rsp) after the call.
            var fsan: string = asmcore.sanitize_label(op.ty);
            s = s.need("struct_drop:" + op.ty);
            s = s.write("    movq " + off + "(%r11), %rax\n");          // inner = box.field_k
            s = s.write("    cmpq $0x10000, %rax\n");                   // null / low -> skip field-release
            s = s.write("    jb .Lstd_" + san + "_sdf" + ks + "\n");
            s = s.write("    pushq %rax\n");
            s = s.write("    call __fn___fern_rc_is_unique\n");         // shared (rc>1) -> skip field-release
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    testq %rax, %rax\n");
            s = s.write("    jz .Lstd_" + san + "_sdf" + ks + "\n");
            s = s.write("    movq " + off + "(%r11), %rax\n");          // reload inner (r11 valid here)
            s = s.write("    pushq %rax\n");
            s = s.write("    call __fn___struct_drop_" + fsan + "\n");  // release inner's rc fields (clobbers r11)
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    movq 8(%rsp), %r11\n");                    // reload box (struct_drop clobbered r11)
            s = s.write(".Lstd_" + san + "_sdf" + ks + ":\n");
        } else if (op.kind == "deep_enum_drop") {
            // A direct enum field's live-variant rc payloads; __enum_drop_ applies
            // the rc==1 gate and the null guard itself, and the arr_dec directive
            // that follows frees the enum box. It clobbers %r11, so reload the box.
            var edsan: string = asmcore.sanitize_label(op.ty);
            s = s.need("enum_drop:" + op.ty);
            s = s.write("    movq " + off + "(%r11), %rax\n");          // enum box = box.field_k
            s = s.write("    pushq %rax\n");
            s = s.write("    call __fn___enum_drop_" + edsan + "\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    movq 8(%rsp), %r11\n");                    // reload box
        } else if (op.kind == "str_free") {
            s = s.write("    movq " + off + "(%r11), %rdi\n");          // box.field_k string box
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___fern_str_free\n");             // rc-aware: free rc==1, dec rc>1, skip view/literal rc<0
            s = s.write("    addq $8, %rsp\n");
        } else if (op.kind == "str_arr_free") {
            s = s.write("    movq " + off + "(%r11), %rdi\n");          // box.field_k string[] buffer
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___fern_str_arr_free\n");         // deep at rc==1 (elements + buffer); shared -> dec; null skipped
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    movq 8(%rsp), %r11\n");                    // reload box (helper may clobber r11)
        } else if (op.kind == "arr_dec") {
            s = s.write("    movq " + off + "(%r11), %rdi\n");          // box.field_k buffer / nested box / enum box / closure box / fn-ptr array buffer (shallow, no element walk)
            s = s.write("    pushq %rdi\n");
            s = s.write("    call __fn___fern_arr_dec\n");
            s = s.write("    addq $8, %rsp\n");
        }
        oi = oi + 1;
    }
    s = s.write(".Lstd_" + san + "_ret:\n");
    // Return the BOX (the documented contract): the field-release calls above
    // (__fern_arr_dec / __fern_str_free / nested __struct_drop_*) all return in
    // %rax, so the entry-time copy is clobbered by the time we get here — the
    // enum-payload deep-drop (emit_enum_variant_drops) CONSUMES this return for
    // its payload-box free, and the clobber made it dec the LAST-FREED FIELD a
    // second time (rc-underflow tick per consume; heap corruption for a string
    // field via the wrong-size-class free) while the payload box itself leaked.
    s = s.write("    movq 8(%rsp), %rax\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_struct_arr_elems_drop_one emits __struct_arr_elems_drop_<E>(buffer) -> buffer,
// the per-element-type deep-drop for a struct-ARRAY field (#2649 multi-level). It walks
// a uniquely-owned buffer and, for each uniquely-owned element box, calls
// __struct_drop_<E> to release the element's OWN rc fields — the level the shallow k_box
// walk leaked. It does NOT free the element boxes or the buffer; the caller's existing
// element/buffer arr_dec does that. Stack-arg ABI: 8(%rsp)=buffer (frame-relative 24 after
// the two callee-saved pushes). rbx=buffer, r12=index are callee-saved so they survive the
// nested __struct_drop_<E> call (which clobbers r9/r10/r11) and the arr_dec/is_unique calls
// (which clobber only rax/rcx/rdx/rsi/rdi/r8). Buffer + each element are is_unique-gated:
// a shared buffer (aliased array) or a shared element (aliased out) skips the field
// release, exactly as the direct-field deep-drop does. `.weak`, per-unit, needs
// __struct_drop_<E> so its body co-emits.
function emit_ir_struct_arr_elems_drop_one(s: asmcore.EmitState, ety: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(ety);
    s = s.need("struct_drop:" + ety);
    s = s.write(".weak __fn___struct_arr_elems_drop_" + san + "\n");
    s = s.write("__fn___struct_arr_elems_drop_" + san + ":\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq 24(%rsp), %rbx\n");                    // buffer (arg 8 + 16 for two pushes)
    s = s.write("    cmpq $0x10000, %rbx\n");                    // null / low -> nothing to walk
    s = s.write("    jb .Lsaed_" + san + "_ret\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    call __fn___fern_rc_is_unique\n");          // shared buffer -> elements shared -> skip
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lsaed_" + san + "_ret\n");
    s = s.write("    xorq %r12, %r12\n");                        // i = 0
    s = s.write(".Lsaed_" + san + "_loop:\n");
    s = s.write("    movq (%rbx), %rax\n");                      // len = buffer[0]
    s = s.write("    cmpq %rax, %r12\n");
    s = s.write("    jge .Lsaed_" + san + "_ret\n");             // i >= len -> done
    s = s.write("    movq %r12, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq (%rbx,%rcx,8), %rdi\n");               // elem = buffer[(i+1)*8]
    s = s.write("    cmpq $0x10000, %rdi\n");                    // null / low -> skip
    s = s.write("    jb .Lsaed_" + san + "_next\n");
    s = s.write("    pushq %rdi\n");
    s = s.write("    call __fn___fern_rc_is_unique\n");          // shared element (aliased out) -> skip field release
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lsaed_" + san + "_next\n");
    s = s.write("    movq %r12, %rcx\n");                        // recompute elem (rcx clobbered by call)
    s = s.write("    incq %rcx\n");
    s = s.write("    movq (%rbx,%rcx,8), %rdi\n");
    s = s.write("    pushq %rdi\n");
    s = s.write("    call __fn___struct_drop_" + san + "\n");    // release elem's OWN rc fields (clobbers r9/r10/r11)
    s = s.write("    addq $8, %rsp\n");
    s = s.write(".Lsaed_" + san + "_next:\n");
    s = s.write("    incq %r12\n");
    s = s.write("    jmp .Lsaed_" + san + "_loop\n");
    s = s.write(".Lsaed_" + san + "_ret:\n");
    s = s.write("    movq %rbx, %rax\n");                        // return buffer (caller dec's it)
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_enum_arr_elems_drop_one emits one __enum_arr_elems_drop_<E>(buffer)
// body — the enum-array sibling of the struct element walk above: for each
// uniquely-owned element, dispatch on the variant SHAPE pointer (box@0, the
// same interned .S label struct_make writes and variant_is compares) and dec
// the matched variant's leak-safe-array payload fields ((k+1)*8) via the
// rc-guarded __fern_arr_dec. Admission (enum_arr_elems_walk_ok, checked at
// the call site) keeps every other payload kind out, so each dec is balanced
// by the ctor's counting: a fresh literal payload is sole-owned (freed), a
// bare-ident payload was dup'd at construction (dec'd back). The element and
// buffer boxes themselves are still freed by the caller's existing walk.
// %rbx=buffer, %r12=index, %r13=element survive the calls (callees clobber
// only rax/rcx/rdx/rsi/rdi/r8).
// emit_ir_enum_variant_payload_decs writes the tag dispatch that releases enum
// `ety`'s rc payloads for the box held in `reg`, jumping to `done` once a
// matching variant's payloads are released. `lp` prefixes the per-variant
// labels. `reg` must survive a call — the callees clobber only
// rax/rcx/rdx/rsi/rdi/r8.
//
// Shared by the array element walk and the single-box __enum_drop_ below, so a
// direct enum field and an enum array element release identically (#8567).
function emit_ir_enum_variant_payload_decs(s: asmcore.EmitState, ety: string, reg: string, lp: string, done: string): asmcore.EmitState {
    var vi: i32 = 0;
    var vlabel: i32 = 0;
    while (vi < s.struct_decls.decls.len()) {
        if (s.struct_decls.decls[vi].enum_owner == ety) {
            var offs: i32[] = irlower.enum_walk_payload_offsets(s.struct_decls, s.struct_decls.decls[vi].name);
            if (offs.len() > 0) {
                var vlo: asmcore.ShapeRefOut = asmcore.shape_ref(s, s.struct_decls.decls[vi].name);
                s = vlo.state;
                var vls: string = util.i32_to_string(vlabel);
                s = s.write("    movq (" + reg + "), %rax\n");    // shape ptr @0
                s = s.write("    leaq " + vlo.label + "(%rip), %rcx\n");
                s = s.write("    cmpq %rcx, %rax\n");
                s = s.write("    jne " + lp + "_v" + vls + "\n");
                var oi: i32 = 0;
                while (oi < offs.len()) {
                    s = s.write("    movq " + util.i32_to_string(offs[oi]) + "(" + reg + "), %rdi\n");
                    s = s.write("    pushq %rdi\n");
                    s = s.write("    call __fn___fern_arr_dec\n");
                    s = s.write("    addq $8, %rsp\n");
                    oi = oi + 1;
                }
                s = s.write("    jmp " + done + "\n");
                s = s.write(lp + "_v" + vls + ":\n");
                vlabel = vlabel + 1;
            }
        }
        vi = vi + 1;
    }
    return s;
}

// emit_ir_enum_drop_one emits __enum_drop_<E>(box) -> box: release the live
// variant's rc payloads of ONE enum box, leaving the box itself to the caller's
// dec — the enum sibling of __struct_drop_<T>. Sole-ownership gated, so a box a
// second owner still names keeps its payloads (and that owner's own release
// frees them).
//
// %rbx survives the calls; the low-address test doubles as the null guard.
function emit_ir_enum_drop_one(s: asmcore.EmitState, ety: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(ety);
    s = s.write(".weak __fn___enum_drop_" + san + "\n");
    s = s.write("__fn___enum_drop_" + san + ":\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    movq 16(%rsp), %rbx\n");                   // box (arg 8 + 8 for the push)
    s = s.write("    cmpq $0x10000, %rbx\n");
    s = s.write("    jb .Led_" + san + "_ret\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    call __fn___fern_rc_is_unique\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Led_" + san + "_ret\n");
    s = emit_ir_enum_variant_payload_decs(s, ety, "%rbx", ".Led_" + san, ".Led_" + san + "_ret");
    s = s.write(".Led_" + san + "_ret:\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    ret\n");
    return s;
}

function emit_ir_enum_arr_elems_drop_one(s: asmcore.EmitState, ety: string): asmcore.EmitState {
    var san: string = asmcore.sanitize_label(ety);
    s = s.write(".weak __fn___enum_arr_elems_drop_" + san + "\n");
    s = s.write("__fn___enum_arr_elems_drop_" + san + ":\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    movq 32(%rsp), %rbx\n");                    // buffer (arg 8 + 24 for three pushes)
    s = s.write("    cmpq $0x10000, %rbx\n");
    s = s.write("    jb .Leaed_" + san + "_ret\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    call __fn___fern_rc_is_unique\n");          // shared buffer -> elements shared -> skip
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Leaed_" + san + "_ret\n");
    s = s.write("    xorq %r12, %r12\n");                        // i = 0
    s = s.write(".Leaed_" + san + "_loop:\n");
    s = s.write("    movq (%rbx), %rax\n");                      // len = buffer[0]
    s = s.write("    cmpq %rax, %r12\n");
    s = s.write("    jge .Leaed_" + san + "_ret\n");
    s = s.write("    movq %r12, %rcx\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    movq (%rbx,%rcx,8), %r13\n");               // elem = buffer[(i+1)*8]
    s = s.write("    cmpq $0x10000, %r13\n");
    s = s.write("    jb .Leaed_" + san + "_next\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    call __fn___fern_rc_is_unique\n");          // shared element (aliased out) -> skip payload release
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Leaed_" + san + "_next\n");
    s = emit_ir_enum_variant_payload_decs(s, ety, "%r13", ".Leaed_" + san, ".Leaed_" + san + "_next");
    s = s.write(".Leaed_" + san + "_next:\n");
    s = s.write("    incq %r12\n");
    s = s.write("    jmp .Leaed_" + san + "_loop\n");
    s = s.write(".Leaed_" + san + "_ret:\n");
    s = s.write("    movq %rbx, %rax\n");                        // return buffer (caller decs it)
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    ret\n");
    return s;
}

// runtime_ast_bodies is the AST lowering of a runtime helper's functions, with
// side tables computed over the helper alone. They read its own functions as
// the whole program, so a read-only string or array parameter is borrowed and
// takes no release that would free the caller's value.
function runtime_ast_bodies(fns: parser.FuncDecl[], all_structs: irlower.StructTab, s: asmcore.EmitState): irlower.LowerResult[] {
    var bparams: string[] = irlower.borrowable_params_interproc(fns, all_structs);
    var sg: irlower.FnSigs = irlower.FnSigs {
        ...irlower.fn_sigs_for_borrow(fns, all_structs, ircore.array_ret_fns_of(fns), bparams),
        consume_safe_params: irlower.consume_safe_params_interproc(fns, bparams),
        // These two resolve against the EmitState's struct view, not all_structs.
        opt_fresh_ret_fns: irlower.sig_reg_of(irlower.opt_fresh_ret_fns_of(fns, s.struct_decls, irlower.str_fresh_ret_fns_of(fns))),
        strfld_ok_types: irlower.strfld_reclaim_ok_types_of(fns, s.struct_decls, bparams),
    };
    var out: irlower.LowerResult[] = [];
    for fd in fns { out = out.append(irlower.lower_func(fd, s.struct_decls, sg, false)); }
    return out;
}

// emit_ir_runtime_fern_fn lowers a runtime helper WRITTEN IN FERN through the
// IR pipeline (issue #2649) — the IR-path analog of asm.fern's
// emit_runtime_fern_fn. The helper emits as __fn_<name> exactly like a user
// function (so the IR call site's `call __fn___fern_<name>` resolves to it),
// replacing a hand-written stack-arg wrapper in emit_ir_runtime.
//
// The typed lowering (EmitState.rt_lower) produces the bodies when it takes
// every function in the source; otherwise the AST lowering does. Emitted
// entry-only and gated on the helper's need by the caller; emit_runtime_globls
// already `.globl`s the symbol so the per-module link resolves it.
function emit_ir_runtime_fern_fn(src: string, all_structs: irlower.StructTab, s: asmcore.EmitState): asmcore.EmitState {
    var m: parser.Module = parser.infer_ret_types_module(parser.parse_module(lexer.tokenize(src)));
    var fns: parser.FuncDecl[] = m.funcs;
    // String literals the helper body interns (e.g. "\n" in str_lines's
    // s.split("\n")) land in string_lits AFTER the main .rodata pool was emitted
    // (this runs in the entry block, past the pool), so flush any NEW ones here in
    // their own .rodata block then return to .text. A literal-free helper (the
    // str_eq / str_cmp / str_trim bodies) adds none, so
    // this is a no-op for them. Mirrors the AST emit_runtime_fern_fn flush.
    var vsigs: irverify.NameIndex = irlower.fn_sig_index(fns);
    var lit0: i32 = s.string_lits.len();
    var agg0: i32 = s.const_aggs.len();
    var sh0: i32 = s.shape_lits.len();
    var bodies: irlower.LowerResult[] = s.rt_lower(src);
    if (bodies.len() < fns.len()) { bodies = runtime_ast_bodies(fns, all_structs, s); }
    var i: i32 = 0;
    while (i < fns.len()) {
        s = emit_function_via_ir_pre(bodies[i], fns[i], s, vsigs);
        i = i + 1;
    }
    // Past the declarations: the drop helpers the typed lowering defines.
    s = emit_named_bodies(bodies, fns.len(), s, vsigs);
    if (s.shape_lits.len() > sh0) {
        s = asmcore.emit_shape_lits_from(s, sh0);
        s = s.write("    .text\n");
    }
    if (s.string_lits.len() > lit0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = lit0;
        while (li < s.string_lits.len()) {
            s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
        s = asmcore.emit_str_box_data_from(s, lit0);
        s = s.write("    .text\n");
    }
    // The same applies to a static aggregate constant the helper body interns: the
    // main .data pool was written before this runs, so flush the new blocks here
    // and return to .text. No helper currently builds one, so this is a no-op
    // today — present so a future Fern-written helper that does is not silently
    // left with a dangling .K label.
    if (s.const_aggs.len() > agg0) {
        s = asmcore.emit_const_agg_data_from(s, agg0);
        s = s.write("    .text\n");
    }
    return s;
}

// emit_module_funcs emits mod's function bodies in the index window [lo, hi).
// A full window (lo=0, hi=mod.funcs.len(), or hi<0 as a "to the end" sentinel)
// reproduces the whole-module emit byte-for-byte; a partial window emits only
// that slice's `__fn_*` defs (its own string pool, its weak field-reclaims /
// struct-drops), so an oversized module (irlower, 511 funcs — #3425) can be
// sharded across separate process invocations to keep each emit's peak heap
// under the leak-mode ceiling. The side-table bases (b_*) are ALWAYS computed
// over the WHOLE all_funcs (never windowed) so cross-window call tagging is
// identical to the unsharded emit; only the emit loop is windowed.
// `check_claims` is false for module_runtime_needs, which runs this whole loop
// only to read the need-set off the EmitState and discards the text. A probe
// must answer, so it does not get to refuse the module (#9655).
function emit_module_funcs(mod: parser.Module, all_funcs: parser.FuncDecl[], all_structs: irlower.StructTab, s: asmcore.EmitState, globl_defs: boolean, lo: i32, hi: i32, cache: irlower.LowerResult[], base: irlower.FnSigs, check_claims: boolean): asmcore.EmitState {
    var stab: irlower.StructTab = irlower.struct_tab(mod.structs);
    // #4394 lever 3: when `cache` is non-empty the caller (emit_module_ir_gated)
    // has ALREADY lowered every function — into cache[i], indexed by mod.funcs
    // position — during its fused eligibility scan, so emit reuses that lowering
    // (via emit_function_via_ir_pre) instead of lowering it a second time.
    //
    // `base` is the whole-program registry the caller derived once (wp_fn_sigs);
    // only the per-module tails — this module's trait_reqs folded in, and the two
    // module-scoped registries — are applied here, and they are cheap.
    var sg: irlower.FnSigs = irlower.FnSigs {
        ...irlower.fn_sigs_with_dyn(base, mod.trait_reqs),
        closurearr_ret_fns: irlower.closurearr_ret_fns_of(mod.funcs),
        fn_names: irlower.sig_reg_of(irlower.fn_names_of(mod.funcs)),
    };
    // The IR verify gate's callee-arity index, derived ONCE over the
    // whole-program all_funcs for the reason the registries above are: a
    // per-function rebuild would be O(n^2) on the compiler's own sources.
    var vsigs: irverify.NameIndex = irlower.fn_sig_index(all_funcs);
    // hi<0 is the "to the end" sentinel; an over-large hi is clamped so a shard
    // window that overshoots the module length can't index past mod.funcs.
    var hh: i32 = hi;
    if (hh < 0 || hh > mod.funcs.len()) { hh = mod.funcs.len(); }
    if (check_claims) { ircore.check_fip_claims(mod.funcs, lo, hh, cache, s.struct_decls, sg, false); }
    s = asmcore.EmitState { ...s, reg_entries: irlower.sig_reg_of(asmcore.unit_labels(mod, lo, hh, cache)), leaves: asmcore.unit_leaves(mod, lo, hh, cache) };
    var fi: i32 = lo;
    while (fi < hh) {
        // A template the substitution superseded has no body: its instances
        // are on the cache tail (emit_named_bodies).
        if (cache.len() > 0 && cache[fi].superseded) { fi = fi + 1; continue; }
        // Per-module: mark the definition `.globl` so a sibling module's
        // `call __fn_<label>` (an unresolved extern in that module) links
        // against it. The label is computed exactly as emit_function_via_ir
        // writes it below (receiver-qualified for methods).
        if (globl_defs) {
            var gname: string = mod.funcs[fi].name;
            if (mod.funcs[fi].receiver_type.len() > 0) { gname = util.base_type_name(mod.funcs[fi].receiver_type) + "." + mod.funcs[fi].name; }
            s = s.write(".globl __fn_" + asmcore.sanitize_label(gname) + "\n");
        }
        if (cache.len() == 0) {
            s = emit_function_via_ir(mod.funcs[fi], s, sg, vsigs);
        } else {
            s = emit_function_via_ir_pre(cache[fi], mod.funcs[fi], s, vsigs);
        }
        fi = fi + 1;
    }
    // Cache entries past the declarations are bodies with no FuncDecl, each
    // naming the symbol it defines. `.weak`, so a shard window or a sibling
    // unit that emits the same body co-links to one definition.
    return emit_named_bodies(cache, mod.funcs.len(), s, vsigs);
}

function emit_named_bodies(cache: irlower.LowerResult[], from: i32, s: asmcore.EmitState, vsigs: irverify.NameIndex): asmcore.EmitState {
    var xi: i32 = from;
    while (xi < cache.len()) {
        if (!s.has_named(cache[xi].name)) {
            s = emit_function_via_ir_named(cache[xi], cache[xi].name, true, s, vsigs).with_named(cache[xi].name);
        }
        xi = xi + 1;
    }
    return s;
}

// module_runtime_needs returns the runtime helpers a module requires (the
// closed need-set: "heap", "maps", "str_concat", …), for whole-program runtime
// aggregation in per-module emit (#3451 step 3 / #3455). The entry module emits
// the single shared runtime, but on its OWN it only knows its own needs — a
// library module that uses a helper the entry doesn't (e.g. str_concat) would
// reference an undefined symbol at link. The driver unions module_runtime_needs
// across every loaded module and passes the result as emit_module_ir_unit's
// extra_needs, so the entry's runtime covers every module. It runs the same
// per-function emit as the real path (so the need-set is exact) but discards
// the asm (strbuf_reset) and reads `needed`.
pub function module_runtime_needs(mod: parser.Module): string[] {
    var stab: irlower.StructTab = irlower.struct_tab(mod.structs);
    mod = parser.infer_ret_types_module(mod);
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    s = asmcore.EmitState { ...s, struct_decls: stab, funcs: mod.funcs };
    // Needs depend only on this module's own ops, so the single-module
    // signature view suffices (a cross-module call's NEED set is the callee's,
    // aggregated separately via module_runtime_needs over each module). Extract
    // the bases into locals here (once) and pass them as individual params.
    s = emit_module_funcs(mod, mod.funcs, stab, s, false, 0, 0 - 1, [], ircore.wp_fn_sigs(mod.funcs, stab), false);
    s = s.close_needs();
    strbuf_reset();
    return s.needed;
}

pub function emit_module_ir(mod: parser.Module): string {
    // Infer return types BEFORE snapshotting all_funcs: the side-tables are
    // derived over all_funcs, so they must see the inferred (unannotated)
    // return types — otherwise a function with an inferred string/struct/…
    // return is mis-tagged i32 and a chained method on its result miscompiles.
    // emit_module_ir_unit re-infers `mod` (idempotent), keeping the emitted
    // module and the analysis set consistent.
    var im: parser.Module = parser.infer_ret_types_module(mod);
    return emit_module_ir_unit(im, true, false, "", [], im.funcs, irlower.struct_tab(im.structs), 0, 0 - 1, []);
}

// emit_module_ir_gated is the FUSED eligibility-gate + whole-program emit (#4394
// lever 3): it replaces the driver's two-call `if (all_eligible_known(m, known))
// { emit_module_ir(m) }` — which lowered every function TWICE (once in the gate's
// per-function eligibility scan, once in emit) — with a single lowering pass. It
// lowers each function ONCE into a cache while checking eligibility on that same
// LowerResult, then, if every function is eligible, emits from the cache (no
// re-lowering); otherwise it returns "" to signal the caller that the module is
// ineligible. The eligibility verdict is identical to all_eligible_known's:
// r.ok plus a call_direct/const_func scan whose only rejections are USER function
// names (RC-inserted __struct_drop_/__field_reclaim_/__fern_* helper calls all
// pass is_fern_helper), and those user calls come from the AST — unaffected by
// the fuller emit-side RC side-tables this path lowers with. So a module that
// routed IR before still routes IR (byte-identically), one that was declined is
// still declined — just at half the lowering cost.
//
// emit_module_or_error is the non-AST half of asm.emit_module (#3457 slice 3):
// the same parse-error / type-check / lambda-lift prologue, then the IR gate —
// but a module the gate declines is a hard ERROR here rather than a silent
// fall-through to the legacy AST emitter.
//
// It exists so the single-module drivers can stop importing `asm.fern` at all,
// which is what makes the AST emitter deletable (slice 5). The declines are
// diagnosable rather than mysterious: FERN_STRICT_IR=1 makes the gate exit(3)
// naming the bail site, so a regression here says WHICH construct left the
// subset, not merely that one did.
//
// The prologue is ordered check-then-emit for the reason #4327 records: the
// fused gate+emit used to return ahead of the type check, so every IR-eligible
// module skipped it and an ill-typed one miscompiled silently.
pub function emit_module_or_error(mod: parser.Module): string {
    return emit_module_or_error_sub(mod, ircore.no_sub());
}

// The `_sub` sibling of the above: see emit_module_ir_gated_sub.
pub function emit_module_or_error_sub(mod: parser.Module, sub: ircore.Sub): string {
    var parse_errs: util.Diag[] = asmcore.parse_unknown_errors_module(mod);
    if (parse_errs.len() > 0) {
        eprint(util.format_diags(parse_errs));
        exit(1);
        return "";
    }
    // The checked boundary first: a raw driver's module reaches here without
    // the annotate pass, and asmcore's Display gate has to read the module the
    // checker rewrote (`print(q)` to `q.to_string()`, docs/TRAITS.md §3a) or
    // it refuses every non-string argument.
    var tm: parser.Module = checker.ensure_annotated(mod);
    var chk: asmcore.EmitState = asmcore.new_state();
    chk = asmcore.EmitState { ...chk, struct_decls: irlower.struct_tab(tm.structs), funcs: tm.funcs };
    var check_errs: util.Diag[] = asmcore.check_module(tm, chk);
    if (check_errs.len() > 0) {
        eprint(util.format_diags(check_errs));
        exit(1);
        return "";
    }
    var lm: parser.Module = ircore.lift_lambdas(tm);
    var g: string = emit_module_ir_gated_sub(lm, [], sub);
    if (g != "") { return g; }
    ircore.eprint_ir_ineligible();
    exit(1);
    return "";
}

// "" is an unambiguous "ineligible" sentinel: an eligible module always emits at
// least `.globl _start\n    .text\n…`, never the empty string.
pub function emit_module_ir_gated(mod: parser.Module, known: string[]): string {
    return emit_module_ir_gated_sub(mod, known, ircore.no_sub());
}

// emit_module_ir_gated_sub is the same gate with a caller-supplied semantic
// lowering substituted into it (ircore.Sub): the `fern` CLI's semantic
// lowering, or ir_const_numeric_run's rebuilt one. ircore.no_sub() is this
// function behaving exactly as it did before the seam existed.
pub function emit_module_ir_gated_sub(mod: parser.Module, known: string[], sub: ircore.Sub): string {
    var sm: parser.Module = ircore.script_normalized(mod);
    // The merged-bundle SIZE budget that stood here is gone with its twin in
    // eligible_core_known_impl — see the note there for why (#3425's large-tier
    // freelist is fixed, and since #5972 the budget was a refusal rather than a
    // fallback). So is the function-less refusal, for the reason given there.
    //
    // A main-less module is admitted now: emit_module_ir_unit's `_start` exits 0
    // instead of calling a __fn_main that does not exist (see its has_main branch).
    // Was a blanket refusal, which is what kept the bootstrap smoke test's
    // main-less compiler sources on the AST emitter.
    // Infer ret types BEFORE lowering the cache so the side-tables see inferred
    // return types (emit_module_ir_unit re-infers idempotently, keeping the cache
    // indices aligned with the module it emits).
    var im: parser.Module = parser.infer_ret_types_module(sm);
    // Derive the emit-side side-tables ONCE (over im.funcs/im.structs — the whole-
    // program view, all_funcs == im.funcs here) exactly as emit_module_funcs does,
    // so the cached lowering is byte-identical to what emit would produce.
    // The whole-program registry set is the most expensive thing this driver
    // computes (both interprocedural fixpoints plus fn_sigs_for_borrow); it is
    // built once here and handed to the unit emitter, which folds the
    // per-module tails onto it itself (#8199).
    var imtab: irlower.StructTab = irlower.struct_tab(im.structs);
    var base: irlower.FnSigs = ircore.wp_fn_sigs(im.funcs, imtab);
    base = ircore.sub_sigs(sub, base);
    var g: ircore.Lowered = ircore.lower_gated(im, imtab, irlower.fn_sigs_with_dyn(base, im.trait_reqs), known, false, sub);
    if (!g.ok) { return ""; }
    // Every function eligible — emit from the cache (no second lowering).
    return emit_unit_flat_with(im, true, false, "", [], im.funcs, imtab, 0, 0 - 1, ircore.inline_tiny_leaves(im, ircore.sub_cache(sub, g.cache)), base, sub.rt_lower);
}

pub function emit_module_ir_unit(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irlower.StructTab, lo: i32, hi: i32, cache: irlower.LowerResult[]): string {
    return emit_module_ir_unit_flat(mod, is_entry, globl_defs, str_ns, extra_needs, all_funcs, all_structs, lo, hi, cache, ircore.wp_fn_sigs(all_funcs, all_structs));
}

pub function emit_module_ir_unit_flat(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irlower.StructTab, lo: i32, hi: i32, cache: irlower.LowerResult[], b: irlower.FnSigs): string {
    return emit_unit_flat_with(mod, is_entry, globl_defs, str_ns, extra_needs, all_funcs, all_structs, lo, hi, cache, b, asmcore.no_rt_lower);
}

// `rt` lowers the runtime helpers this unit appends (asmcore.EmitState.rt_lower).
function emit_unit_flat_with(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: irlower.StructTab, lo: i32, hi: i32, cache: irlower.LowerResult[], b: irlower.FnSigs, rt: (string) => irlower.LowerResult[]): string {
    // Infer return types for unannotated functions so the IR path's
    // ret-type-keyed call tagging (str_ret_fns_of / opt_ret_fns_of / …)
    // matches what module_with_builtins supplies.
    // (#4394 lever 3: `cache`, when non-empty, is the caller's pre-lowered
    // per-function LowerResult set — indexed by mod.funcs position — reused by
    // emit_module_funcs instead of re-lowering. The caller must have inferred
    // ret types before lowering; infer_ret_types_module is idempotent, so this
    // re-infer is a no-op there and the cache indices stay aligned.)
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    // struct_decls is the WHOLE-PROGRAM struct set so a function emitting an
    // imported struct's layout (field offsets / sizes) resolves it.
    s = asmcore.EmitState { ...s, struct_decls: all_structs, funcs: mod.funcs, str_ns: str_ns, rt_lower: rt };
    // A unit never passes emit_module_or_error's check, so the Display gate
    // runs here: a `print(xs)` nothing gives a `to_string` would otherwise hand
    // the string-only runtime helper a raw pointer (#9945).
    var derrs: util.Diag[] = asmcore.display_errs_module(mod, s);
    if (derrs.len() > 0) {
        eprint(util.format_diags(derrs));
        exit(1);
        return "";
    }
    if (is_entry) { s = s.write("    .globl _start\n"); }
    s = s.write("    .text\n");
    // Per-module: the entry exports its shared runtime entry points so sibling
    // library modules can link their `call __fern_*` externs against them.
    if (is_entry && globl_defs) { s = asmcore.emit_runtime_globls(s); }
    // The side-table bases arrive as INDIVIDUAL params (b_*), threaded straight to
    // emit_module_funcs. The strfldok need seeding below recomputes its column
    // directly (all_funcs is in scope) rather than re-reading a base that was
    // just passed as an arg.
    s = emit_module_funcs(mod, all_funcs, all_structs, s, globl_defs, lo, hi, cache, b, true);
    // #4355: admit the replaced-STRING-field arm per type, from the
    // WHOLE-PROGRAM read scan (a unit-local func list would under-count the
    // reads and re-open the UAF the scan exists to prevent; see
    // irlower.strfld_reclaim_ok_types_of). Seeded as "strfldok:<T>" needs so
    // emit_ir_field_reclaim_one can gate its string arm; every unit sees the
    // same verdict, so the weak-deduped bodies agree.
    //
    // b.strfld_ok_types IS that verdict, over the same all_funcs/all_structs,
    // computed once by the wp_fn_sigs the caller built outside its per-unit loop
    // — and it is the one the LOWERING routed on, which is what keeps the
    // construction retain and this arm's free paired. Recomputing it here ran
    // the scan (three whole-program passes) once per emitted unit, and it is
    // already the most-repeated analysis in a compile: 7 runs per compile
    // against the nested-struct scan's 1.
    var sfok: string[] = b.strfld_ok_types;
    var sfoi: i32 = 0;
    while (sfoi < sfok.len()) {
        s = s.need("strfldok:" + sfok[sfoi]);
        sfoi = sfoi + 1;
    }
    // #6127: the DIRECT nested-struct / nested-enum field arm, from the same
    // WHOLE-PROGRAM scan discipline — a unit-local func list would under-count
    // the reads and re-open the use-after-free #6148 was reverted for.
    // b.borrowable_params is the SAME whole-program verdict the caller already
    // ran borrowable_params_interproc for. Recomputing it here cost 5.8x on the
    // per-module emit-all's gen0 (129 s -> 745 s): an interproc fixpoint is ~9
    // passes over every function, and this runs once per emitted unit.
    var nfok: string[] = irlower.structfld_reclaim_ok_types_of(all_funcs, all_structs, b.borrowable_params);
    var nfoi: i32 = 0;
    while (nfoi < nfok.len()) {
        s = s.need("structfldok:" + nfok[nfoi]);
        nfoi = nfoi + 1;
    }
    // Per-type __field_reclaim_<T> bodies (#3457), in .text alongside the module
    // funcs — emitted by EVERY unit that uses one (weak-deduped at link), so a
    // library module's call resolves locally rather than relying on the entry's
    // need-set covering a per-type symbol the fixed all_runtime_need_roots can't.
    s = emit_ir_field_reclaims(s);
    // Per-type __struct_drop_<T> bodies (#3457) — same weak-deduped per-unit
    // emission as the field-reclaims; replaces the former inline field-drop.
    s = emit_ir_struct_drops(s);
    // Fold the whole-program extra_needs (sibling modules' needs, for the entry's
    // single shared runtime) into the need set BEFORE _start, so _start's
    // need-gated argc/argv save below fires even when only a LIBRARY module
    // (not the entry itself) calls args(). For the single-unit path extra_needs
    // is empty, so this is inert there.
    var en: i32 = 0;
    while (en < extra_needs.len()) {
        s = s.need(extra_needs[en]);
        en = en + 1;
    }
    // _start belongs only to the entry module (one program entry point). A
    // non-entry library module exposes its `__fn_*` definitions and nothing else.
    if (is_entry) {
        s = s.write("_start:\n");
        // args() reads __fern_argc / __fern_argv; save them from the initial stack
        // (the kernel puts argc at the top of the stack on entry) BEFORE any push.
        // Matches asm.fern's _start. Gated on the args need so a non-args program
        // is byte-identical.
        if (s.has_need("args")) {
            s = s.write("    movq (%rsp), %rax\n");
            s = s.write("    movq %rax, __fern_argc(%rip)\n");
            s = s.write("    leaq 8(%rsp), %rax\n");
            s = s.write("    movq %rax, __fern_argv(%rip)\n");
        }
        // env() reads __fern_envp; save it from the initial stack BEFORE any push.
        // envp follows argv's NULL terminator: envp = rsp + 16 + argc*8 (argc at
        // [rsp], argv at rsp+8 with argc+1 slots incl. the NULL). Gated on the env /
        // subprocess needs (not heap, unlike asm.fern) so other programs stay
        // byte-identical. Both __fern_env and __fern_subprocess (execve) read it.
        if (s.any_need(["env", "subprocess", "environ", "raw_environ"])) {
            s = s.write("    movq (%rsp), %rax\n");
            s = s.write("    leaq 16(%rsp,%rax,8), %rax\n");
            s = s.write("    movq %rax, __fern_envp(%rip)\n");
        }
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        // A MAIN-LESS module (a library compiled standalone — util.fern et al.
        // under the bootstrap self-compile) has no __fn_main to call, so `_start`
        // exits 0 directly. Mirrors the retired x86 AST emitter's own no-main branch, minus the
        // top-level statements: a script-shaped source has already been rewritten
        // into `function main()` by asmcore.synth_script_main upstream, so
        // anything still main-less here is a library with functions only.
        //
        // Emitting the call unconditionally is what forced the gate to refuse such
        // a module (`require_main`), which is why the bootstrap smoke test — it
        // pipes each compiler SOURCE through this driver, and 7 of 9 are
        // main-less — depended on the AST emitter.
        if (asmcore.has_main(mod)) {
            s = s.write("    call __fn_main\n");
            // Leak summary before the exit syscall (#6068). main's return value
            // is the exit code and is still in %rax, so it is held on the stack
            // across the call rather than relying on a register contract.
            if (leak_check_on()) {
                s = s.write("    pushq %rax\n");
                s = s.write("    call __fern_lc_report\n");
                s = s.write("    popq %rax\n");
            }
            s = s.write("    movq %rax, %rdi\n");
        } else {
            if (leak_check_on()) { s = s.write("    call __fern_lc_report\n"); }
            s = s.write("    movq $0, %rdi\n");
        }
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    }
    // Pre-intern "FileStat" so the __fern_stat runtime helper (emitted after this
    // literal pool, inside the heap/stat block) can reference its shape label. The
    // helper's own shape_ref dedups to this slot; without the early intern the label
    // would be undefined (the runtime emits AFTER the pool). Mirrors the
    // retired AST emitters' FileStat pre-intern. Gated on the stat need.
    if (s.has_need("stat") || s.has_need("lstat") || s.has_need("access") || s.has_need("fd_stat")) {
        var fsPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "FileStat");
        s = fsPre.state;
    }
    // Pre-intern "FsStat" for __fern_statfs's shape label, same reasoning as
    // FileStat above. Its own gate: a stat-only program has no FsStat to build.
    if (s.has_need("statfs")) {
        var fvPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "FsStat");
        s = fvPre.state;
    }
    // Pre-intern "WinSize" for __fern_window_size's shape label, same
    // reasoning as FsStat above.
    if (s.has_need("window_size")) {
        var wsPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "WinSize");
        s = wsPre.state;
    }
    // Pre-intern "ProcessResult" for the __fern_subprocess runtime's shape label
    // (same reasoning as FileStat above). Gated on the subprocess need.
    if (s.has_need("subprocess")) {
        var prPre: asmcore.ShapeRefOut = asmcore.shape_ref(s, "ProcessResult");
        s = prPre.state;
    }
    // .rodata: each interned string literal as a labelled `.ascii` directive
    // (GAS interprets the escapes), matching asm.fern's emit_module so the box's
    // .S<idx> data pointer resolves. string_lits was populated by const_str.
    if (s.string_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < s.string_lits.len()) {
            s = s.write(asmcore.str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
        s = asmcore.emit_str_box_data_from(s, 0);
    }
    // .data: one block per static aggregate constant (#6149). After the string
    // pool, because a block's first word is a shape POINTER into it.
    s = asmcore.emit_const_agg_data(s);
    // Per-module shape pointers: emit each distinct shape name once as a `.weak`
    // global symbol (shape_sym) carrying its name bytes. Every unit referencing the
    // same shape emits the same weak symbol, so the linker merges them to ONE
    // address — pointer-equality shape discrimination then holds across the module
    // boundary (a token constructed in the lexer unit matches in the parser unit).
    // Only populated on the per-module path (shape_ref interns shapes as ordinary
    // string literals when str_ns == "", so the whole-program emit is unchanged).
    s = asmcore.emit_shape_lits_from(s, 0);
    // The "maps" / "heap" needs were marked per-function during the emit loop
    // above (off the ops each lower_func already produced), so there is no need to
    // re-lower the module here. The whole-program extra_needs (sibling modules'
    // needs, for the entry's single shared runtime) were folded in above, BEFORE
    // _start (so its argc/argv save sees a sibling's args need) and hence before
    // close_needs, so their declared deps resolve too. close_needs() pulls in
    // maps' declared deps (str_eq, arr_push, heap) so the runtime links.
    s = s.close_needs();
    // The shared `__fern_*` runtime is emitted ONCE, by the entry module — a
    // non-entry library module references these helpers as externs (resolved at
    // link against the entry's copy), so emitting them again would duplicate-
    // define the symbols. (Until runtime needs are aggregated whole-program,
    // the entry only knows its OWN needs; a non-entry module that itself
    // allocates relies on the entry having pulled the heap runtime in.)
    if (is_entry) { s = emit_entry_runtime_settled(s, all_structs); }
    return strbuf_take();
}

// A typed runtime body can call a need-gated runtime block emitted before it,
// so the runtime is emitted into a capture and emitted again, from the state
// before it, with the needs it added, until they stop growing.
function emit_entry_runtime_settled(s0: asmcore.EmitState, all_structs: irlower.StructTab): asmcore.EmitState {
    var s: asmcore.EmitState = s0;
    var settled: boolean = false;
    var out: asmcore.EmitState = s0;
    while (!settled) {
        s = s.close_needs();
        var h: usize = buf_new(65536);
        var t: asmcore.EmitState = emit_entry_runtime(asmcore.EmitState { ...s, capture: h }, all_structs);
        var text: string = buf_take(h);
        if (t.needed.len() == s.needed.len()) {
            settled = true;
            var back: asmcore.EmitState = asmcore.EmitState { ...t, capture: s0.capture };
            out = back.write(text);
        } else {
            s = asmcore.EmitState { ...s0, needed: t.needed };
        }
    }
    return out;
}

// The shared `__fern_*` runtime the entry module emits.
function emit_entry_runtime(s: asmcore.EmitState, all_structs: irlower.StructTab): asmcore.EmitState {
    // __fern_str_cmp (#2649): string-ordering helper, hosted on the IR path
    // as a Fern function. Self-contained (two borrowed strings, byte compare, no
    // alloc / no other helper call), so emit_ir_runtime_fern_fn's singleton
    // side-tables are complete. Same .text + need-gated, entry-only emission.
    if (s.has_need("str_cmp")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_cmp(), all_structs, s);
    }
    // The freestanding allocator + RC runtime, only when the program allocates.
    // i32.to_string() allocates its box even in an otherwise heap-free program,
    // so its emit-time need pulls the runtime in too (its body calls __fern_alloc).
    if (needs_heap_runtime(s)) { s = emit_ir_runtime(s); }
    // The f64 transcendental bundle (sin/cos/exp/log/pow). Deliberately NOT
    // inside the heap gate above: a program that only does float maths
    // allocates nothing, and would otherwise `call __fern_sin_f64` with no
    // definition anywhere in the link.
    if (s.has_need("float_transcendentals")) {
        s = emit_rt_float_transcendentals(s);
    }
    // The CRC fold. Its own gate rather than the heap one: a program that
    // hashes a borrowed string allocates nothing, and would otherwise
    // `call __fern_crc32_cksum` with no definition anywhere in the link.
    if (s.has_need("crc32_cksum")) {
        s = emit_rt_crc32_cksum(s);
    }
    // Heap-event diagnostics (#6068): the __fern_hev_* hooks the runtime above
    // calls, plus the leakcheck counters and exit-time report. Deliberately NOT
    // inside the heap gate — a heap-free program still lowers `exit`, which
    // calls __fern_lc_report, and it must resolve. When neither flag is set
    // this emits nothing at all.
    if (hev_on()) {
        s = s.write("    .text\n");
        s = emit_hev_runtime(s);
    }
    // The UAF quarantine's fatal report. Self-contained — its own write(2) +
    // exit(124) rather than the hev writer — so FERN_RC_FREE_DEBUG works
    // standalone, without leakcheck. Entry-only, like the hev block above.
    if (rc_free_debug_on()) {
        s = s.write("    .text\n");
        s = emit_san_uaf_abort(s);
    }
    // FFI __c_call<n> shims (#4375): allocation-free register-marshal + `call
    // *fn`, so independent of the heap runtime above. Emitted in .text when the
    // module referenced any variant (emit_ir_runtime, when it ran, left .bss).
    if (any_ccall_need(s)) {
        s = s.write("    .text\n");
        s = emit_ccall_shims(s);
    }
    // __fern_str_eq (#2649): string equality, also called by the map / arr_str
    // helpers (the map_set→str_eq edge that motivated the issue). Hand-written
    // rather than a Fern body — see rt_x86_str_eq for why. Gated on str_eq
    // (maps pulls it in via close_needs).
    if (s.has_need("str_eq")) {
        s = s.write("    .text\n");
        s = s.write(rt_x86_str_eq());
    }
    // __fern_map_find (#2649): the map runtime's shared key search. One Fern
    // body where map_set, map_get and map_has each carried a string, an i32 and
    // a struct/enum copy of the same loop in hand-asm, and __fern_map_delete a
    // fourth in Fern.
    //
    // Gated on `maps` rather than a need of its own, unlike map_delete: all
    // three hand-asm bodies in the maps bundle call it, so a program that has
    // the bundle always reaches it. `maps` already declares str_eq for the
    // string arm.
    if (s.has_need("maps")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_map_find(), all_structs, s);
    }
    // __fern_map_delete (#2649): `m.without(k)`. A Fern helper rather than
    // hand-asm — the last of the map ops to move. Gated on its OWN need, not on
    // `maps`: the Fern body is markedly larger than the hand-asm it replaces,
    // and most map programs never delete. (The hand-asm rode the whole maps
    // bundle, so this also stops emitting it for programs that never call
    // `.without`.) Its declared dep on `maps` carries str_eq for the string arm.
    // map_delete_rel's source carries it when that is needed too.
    if (s.has_need("map_delete") && !s.has_need("map_delete_rel")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_map_delete(), all_structs, s);
    }
    // The releasing delete (#9970) on its own need: only a map that owns its
    // columns calls it, and its body names the string-array free.
    if (s.has_need("map_delete_rel")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_map_delete_rel(), all_structs, s);
    }
    // ASCII case transforms (to_upper / to_lower) — heap-dependent, so the heap
    // runtime is already present; emitted on their own str_case need.
    // str_to_upper / _lower — now Fern runtime functions (#2649), lowered through
    // the IR pipeline: copy each byte case-flipped if alpha. Heap-dependent.
    if (s.has_need("str_case")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_upper(), all_structs, s);
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_to_lower(), all_structs, s);
    }
    // String repeat — now a Fern runtime function (#2649), lowered through the
    // IR pipeline: n copies of `s` in a fresh buffer via the raw-memory
    // intrinsics. Heap-dependent (present above).
    if (s.has_need("str_repeat")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_repeat(), all_structs, s);
    }
    // String trim — now a Fern runtime function (#2649), lowered through the IR
    // pipeline (zero-copy slice; the slice box allocates, so the heap runtime
    // above is present). .text since the heap runtime left us in .bss.
    if (s.has_need("str_trim")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_trim(), all_structs, s);
    }
    // String replace — now a Fern runtime function (#2649), lowered through the
    // IR pipeline: two-pass count + build via the raw-memory intrinsics.
    // Heap-dependent (present above).
    if (s.has_need("str_replace")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_replace(), all_structs, s);
    }
    // string_from_bytes_unchecked — now a Fern runtime function (#2649), lowered through the
    // IR pipeline: pack each array element's low byte into a fresh string box via
    // the raw-memory intrinsics. Heap-dependent (present above).
    if (s.has_need("str_from_bytes")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_string_from_bytes(), all_structs, s);
    }
    // random_bytes — now a Fern runtime function (#2649), lowered through the IR
    // pipeline: fill n scratch bytes from getrandom via the __syscall3 sub-floor,
    // spread them into a fresh u8[] box (__raw_arr_box). Heap-dependent (present
    // above). The source is shared with arm64 (asm_arm64_ir passes its own
    // target); asmcore.sysno picks 318.
    if (s.has_need("random_bytes")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_random_bytes("x86_64"), all_structs, s);
    }
    // a[start:end] — a Fern runtime function (#2649) over the __raw_arr_box +
    // __raw_array pair: allocate the fresh box, copy the 8-byte slots, hand it
    // back. Heap-dependent (present above). It takes a target, because its
    // bounds trap is exit(134) through __syscall3 and the exit number is
    // per-target (asmcore.sysno picks 60 here).
    if (s.has_need("arr_slice")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_slice("x86_64"), all_structs, s);
    }
    // str_split — now a Fern runtime function (#2649), lowered through the IR
    // pipeline: scan for `sep`, append each segment slice (.append() ->
    // arr_push_owned, present via its str_split need deps). Heap-dependent (above).
    if (s.has_need("str_split")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_split(), all_structs, s);
    }
    // String lines — now a Fern runtime function (#2649), lowered through the IR
    // pipeline: splits on '\n' (str_split) + drops the trailing empty via an array
    // slice (arr_slice); both deps are present (heap runtime above + their own
    // need-gated blocks). .text since the heap runtime left us in .bss.
    if (s.has_need("str_lines")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_lines(), all_structs, s);
    }
    // String bytes — now a Fern runtime function (#2649), lowered through the IR
    // pipeline: builds the byte i32[] by appending each byte (arr_push, present via
    // its own need-gated block + the heap runtime above). .text since the heap
    // runtime left us in .bss.
    if (s.has_need("str_bytes")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_bytes(), all_structs, s);
    }
    // chr — first Tier-2 helper via the raw-memory intrinsics (#2649): alloc 1
    // byte, store b, box it. Lowered through the IR pipeline; the heap runtime
    // above is present (mark_chr pulls heap).
    if (s.has_need("chr")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_chr(), all_structs, s);
    }
    // str_concat — backs `+` on strings, now Tier-2 via the intrinsics (#2649):
    // alloc lenA+lenB, copy A then B byte-by-byte, box it. Heap-dependent (present
    // above). .text since the heap runtime left us in .bss.
    if (s.has_need("str_concat")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_str_concat(), all_structs, s);
    }
    // arr.join(sep) — a Fern runtime function (#5328) lowered through the IR
    // pipeline: two passes over an exact-size block, summing the lengths and
    // then memcpy'ing each piece in. Heap-dependent (present above). .text
    // since the heap runtime left us in .bss.
    if (s.has_need("arr_str_join")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_arr_str_join(), all_structs, s);
    }
    // i32_to_string — backs (n).to_string(), Tier-2 via the intrinsics (#2649):
    // digit-buffer build. Heap-dependent (present above).
    if (s.has_need("i32_to_string")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_i32_to_string(), all_structs, s);
    }
    // u32_to_string — UNSIGNED sibling for (u32).to_string() (#2649). Heap-dep.
    if (s.has_need("u32_to_string")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_u32_to_string(), all_structs, s);
    }
    // i64_to_string / u64_to_string — the WIDE siblings (#5826). Heap-dep. The
    // unsigned one is not optional: __fern_i64_to_string renders a u64 with bit
    // 63 set as negative.
    if (s.has_need("i64_to_string")) {
        s = s.write("    .text\n");
        s = emit_ir_runtime_fern_fn(asmcore.rt_src_i64_to_string(), all_structs, s);
    }
    if (s.has_need("u64_to_string")) {
        s = s.write("    .text\n");
