            s = s.write("    popq %rdi\n    call __fern_tcp_close\n    pushq %rax\n");
            s = s.need("tcp_close");
        } else if (o.kind_tag == 197) {  // tcp_pollable
            // [fd]; __fern_tcp_pollable(%rdi=fd) -> the fd unchanged (native's
            // readiness token IS the fd).
            s = s.write("    popq %rdi\n    call __fern_tcp_pollable\n    pushq %rax\n");
            s = s.need("tcp_pollable");
        } else if (o.kind_tag == 200) {  // tcp_listen (#4371)
            // [port]; __fern_tcp_listen(%rdi=port) -> listener fd / -errno in %rax.
            s = s.write("    popq %rdi\n    call __fern_tcp_listen\n    pushq %rax\n");
            s = s.need("tcp_listen");
        } else if (o.kind_tag == 201) {  // tcp_accept (#4371)
            // [listener fd]; __fern_tcp_accept(%rdi=fd) -> connection fd / -errno.
            s = s.write("    popq %rdi\n    call __fern_tcp_accept\n    pushq %rax\n");
            s = s.need("tcp_accept");
        } else if (o.kind_tag == 202) {  // writer_write (#4372)
            // [fd, str box]; write(2) the box's bytes to the fd -> i32 bytes /
            // -errno. Inline (no runtime helper): read data=box[0], len=box[8].
            s = s.write("    popq %rsi\n    popq %rdi\n    movq 8(%rsi), %rdx\n    movq (%rsi), %rsi\n    movq $1, %rax\n    syscall\n    pushq %rax\n");
        } else if (o.kind_tag == 203) {  // open_file (#4372)
            // [path box]; __fern_open_fd(%rdi=path, %rsi=flags(imm), %rdx=0644) ->
            // fd / -errno. Allocates the NUL-term buffer, so heap + open_file needs.
            s = s.write("    popq %rdi\n    movq $" + util.i32_to_string(o.i32_imm) + ", %rsi\n    movq $420, %rdx\n    call __fern_open_fd\n    pushq %rax\n");
            s = s.need("heap"); s = s.need("open_file");
        } else if (o.kind_tag == 80) {  // heap_bump_bytes
            // bump high-water mark = (__fern_heap_ptr == 0) ? 0 : ptr − base.
            // The arena is mmap'd lazily; its base is recoverable from the
            // recorded end (__fern_heap_end = base + heap_size), so base =
            // end − heap_size. The cursor is 0 until the first alloc, so guard
            // that case to report 0 (matching native's __fern_heap_bump_bytes).
            s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");   // cursor (0 if uninit)
            s = s.write("    movq __fern_heap_end(%rip), %rcx\n");   // arena end = base + heap_size (0 if uninit)
            s = s.write("    movabs $8589934592, %rdx\n");           // heap_size (0x200000000)
            s = s.write("    subq %rdx, %rcx\n");                    // %rcx = base = end − heap_size
            s = s.write("    movq %rax, %rdx\n");
            s = s.write("    subq %rcx, %rdx\n");                    // ptr − base
            s = s.write("    xorq %rcx, %rcx\n");
            s = s.write("    testq %rax, %rax\n");                   // ptr == 0 ?
            s = s.write("    cmovneq %rdx, %rcx\n");                 // 0 if uninit, else ptr−base
            s = s.write("    pushq %rcx\n");
