            // is one leaq. The block is laid out by emit_const_agg_data below to
            // be byte-identical to what __fern_arr_box + the stores would have
            // produced, except for the rc word, which is the immortal sentinel.
            var kshp: ShapeRefOut = shape_ref(s, ir.const_struct_type(o.str));
            s = kshp.state;
            var kpack: string = kshp.label + "|";
            var kvals: string[] = ir.const_struct_values(o.str);
            var kv: i32 = 0;
            while (kv < kvals.len()) {
                if (kv > 0) { kpack = kpack + ","; }
                kpack = kpack + kvals[kv];
                kv = kv + 1;
