    if (s.has_need("arr_inc_elems")) {
    s = s.write("__fn___fern_arr_inc_elems:\n");
    s = s.write("    movq 8(%rsp), %rax\n");        // arr (also the result)
    s = s.write("__fn___fern_arr_inc_elems.r:\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Laie_ret\n");
    s = s.write("    cmpq $0x10000, %rax\n");
    s = s.write("    jb .Laie_ret\n");
    s = s.write("    movl -8(%rax), %ecx\n");       // rc
    s = s.write(san_poison_check("%ecx"));
    s = s.write("    testl %ecx, %ecx\n");
    s = s.write("    js .Laie_ret\n");              // immortal buffer: its elements are too
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    movq %rax, %rbx\n");           // arr
    s = s.write("    movq (%rbx), %r12\n");         // len @ [arr]
    s = s.write("    movq $0, %r13\n");             // i
    s = s.write(".Laie_loop:\n");
    s = s.write("    cmpq %r12, %r13\n");
    s = s.write("    jge .Laie_done\n");
    s = s.write("    movq 8(%rbx,%r13,8), %rax\n"); // element i @ [arr+8+i*8]
    s = s.write("    pushq %rax\n");
    s = s.write("    call __fn___fern_rc_inc\n");
    s = s.write("    addq $8, %rsp\n");
    s = s.write("    incq %r13\n");
    s = s.write("    jmp .Laie_loop\n");
    s = s.write(".Laie_done:\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write(".Laie_ret:\n");
    s = s.write("    ret\n");
    }
    // __fern_alloc_reuse(token@16(%rsp), slots@8(%rsp)) -> %rax = data — the
    // FBIP reuse-degrade primitive (#4350), the self-host twin of native's
    // __fern_alloc_reuse adapted to the arr-box layout (cap@data-16, rc@data-8):
    // null token -> fresh __fern_arr_box(cap); cap match -> hand the SAME block
    // back (rc stays 1 — the caller's __fern_rc_is_unique gate guaranteed sole
    // ownership; len@data+0 is stale but every reuse caller overwrites slot 0
    // with the shape/tag before any read); cap mismatch -> push the donor block
    // onto its size-class freelist and alloc fresh — a mispaired reuse is only
    // ever slower, never unsound. Clobbers rax/rcx/rdx/rsi/rdi/r8 (the same
    // contract as the other __fn_ rc helpers).
    s = s.write("__fn___fern_alloc_reuse:\n");
    s = s.write("    movq 16(%rsp), %rax\n");        // token (donor data ptr, or 0)
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lsarelo_fresh\n");
    s = s.write("    movq 8(%rsp), %rcx\n");         // slots (total payload words: struct nf+1 incl. shape, tuple arity)
    s = s.write("    cmpq %rcx, -16(%rax)\n");       // donor cap == wanted slots?
    s = s.write("    je .Lsarelo_ret\n");            // reuse: return token
    // Mismatch: return the donor block ((cap+3) words at data-16) to its
    // freelist class, mirroring __fn___fern_arr_dec's free path; an oversize
    // block (>= 65536 words, outside the freelist range) is left to leak,
    // matching __fern_alloc's own no-freelist policy for that range.
    s = s.write("    movq -16(%rax), %rdx\n");       // donor cap
    s = s.write("    addq $3, %rdx\n");              // block words = cap + 3
    s = s.write("    leaq -16(%rax), %rcx\n");       // block base
    s = s.write("    cmpq $65536, %rdx\n");
    s = s.write("    jae .Lsarelo_fresh\n");
    s = hev_free(s, "%rcx", "%rdx");
