        // args() array need the header too: one the program reads out is a value
        // the rc pass incs and decs, and on a headerless box laid back to back with
        // its neighbours that inc lands on the previous argument's length word.
        s = s.write("__fern_arg_at:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    movq __fern_argv(%rip), %rax\n");
        s = s.write("    movq (%rax,%rdi,8), %r12\n");
        s = s.write("    movq %r12, %rcx\n");
        s = s.write("    movq $0, %r13\n");
        s = s.write(".Larg_strlen:\n");
        s = s.write("    movzbq (%rcx), %rax\n");
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    je .Larg_done\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    incq %r13\n");
        s = s.write("    jmp .Larg_strlen\n");
        s = s.write(".Larg_done:\n");
        s = s.write("    movq %r12, %rdi\n");
        s = s.write("    movq %r13, %rsi\n");
        s = s.write("    call __fern_str_box\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
        s = s.write("__fern_args:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
