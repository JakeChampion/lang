    s = s.write("__fn___fern_arrarr_free:\n");
    s = s.write("    movq 8(%rsp), %rax\n");        // arr
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Laaf_ret\n");
    s = s.write("    cmpq $0x10000, %rax\n");       // low-addr guard
    s = s.write("    jb .Laaf_ret\n");
    s = s.write("    movl -8(%rax), %ecx\n");       // rc
    s = s.write("    testl %ecx, %ecx\n");
    s = s.write("    js .Laaf_ret\n");              // negative = immortal -> skip
    s = s.write("    cmpl $1, %ecx\n");
    s = s.write("    jg .Laaf_dec\n");              // rc>1 -> dec, keep
    s = s.write("    jl .Laaf_uf\n");               // rc==0 -> underflow (double free)
