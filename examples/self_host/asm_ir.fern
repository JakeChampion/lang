}

// all_eligible reports whether every function in the module is IR-eligible
// AND every direct call targets a function defined in the module (or an IR
// runtime helper). A call to a BUILTIN (read_int / print_int / chr /
// i32_to_string / ...) lowers to call_direct but has no `__fn_<name>` body —
// the IR path can't emit it, so such modules fall back to the AST emitter
// (which handles builtins in emit_expr). The whole module goes one way or the
// other, so a single builtin call disqualifies the IR path for the module.
// eligible_core is the target-independent eligibility check: a non-empty module
// with a `main` where every function is ir_eligible, every direct call targets a
// known function, and every function-VALUE reference (const_func) names a real
// module function. It ALLOWS plain function values (const_func / call_indirect) —
// the wasm backend lowers them (a funcref table). all_eligible adds the
// register-backend restriction on top (they don't emit the closure ops yet).
pub function eligible_core(mod: parser.Module): boolean {
    if (mod.funcs.len() == 0) { return false; }
    // emit_module_ir is a WHOLE-PROGRAM emitter: it writes a `_start` that
    // calls `__fn_main` and exits with its return. A module with no `main`
    // (a library compiled standalone, e.g. util.fern under the bootstrap
    // self-compile) has no `__fn_main`, so routing it through the IR path
    // would emit a dangling reference. Such modules stay on the AST emitter,
    // which handles the no-main case (top-level stmts + fallback exit).
    if (!asmcore.has_main(mod)) { return false; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (!ir_eligible(mod.funcs[i], mod)) { return false; }
        if (!calls_only_known(mod.funcs[i], mod)) { return false; }
        if (!const_funcs_only_known(mod.funcs[i], mod)) { return false; }
        i = i + 1;
    }
    return true;
}

// all_eligible is the module eligibility gate for every backend now: it is
// eligible_core. Plain function values (const_func / call_indirect) lower on all
// three IR backends — wasm through a funcref table, the register backends through
// the function's code address (no table needed). (Capturing lambdas are a later
// slice and still bail via lower_func.)
pub function all_eligible(mod: parser.Module): boolean {
    return eligible_core(mod);
}

// const_funcs_only_known reports whether every function-value reference
// (const_func) in fd names a function defined in the module — the function-value
// twin of calls_only_known. A const_func to an unknown name can't resolve to a
// funcref table slot, so such modules fall back to AST.
function const_funcs_only_known(fd: parser.FuncDecl, mod: parser.Module): boolean {
    var noret: string[] = [];
    var r: irlower.LowerResult = irlower.lower_func(fd, noret, mod.structs, noret, noret, irlower.opt_ret_fns_of(mod.funcs), irlower.i64_ret_fns_of(mod.funcs), irlower.tuple_ret_fns_of(mod.funcs), irlower.struct_ret_fns_of(mod.funcs, mod.structs), irlower.f64_ret_fns_of(mod.funcs), irlower.f64arr_ret_fns_of(mod.funcs), irlower.i64arr_ret_fns_of(mod.funcs), irlower.fn_param_sigs_of(mod.funcs), irlower.closure_ret_fns_of(mod.funcs));
    var i: i32 = 0;
    while (i < r.ops.len()) {
        if (r.ops[i].kind == "const_func" && !module_has_func(mod, r.ops[i].str)) { return false; }
        i = i + 1;
    }
    return true;
}

// module_has_func reports whether `name` is a function defined in the module.
function module_has_func(mod: parser.Module, name: string): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].name == name) { return true; }
        // Method-call form "<Type>.<method>": a receiver function whose base
        // receiver type + name compose to `name` (the irlower dispatch label).
        if (mod.funcs[i].receiver_type.len() > 0) {
            if (util.base_type_name(mod.funcs[i].receiver_type) + "." + mod.funcs[i].name == name) { return true; }
        }
        i = i + 1;
    }
    return false;
}

// calls_only_known reports whether every direct call in fd targets a module
// function or an IR runtime helper (not a builtin).
function calls_only_known(fd: parser.FuncDecl, mod: parser.Module): boolean {
    var noret: string[] = [];
    var r: irlower.LowerResult = irlower.lower_func(fd, noret, mod.structs, noret, noret, irlower.opt_ret_fns_of(mod.funcs), irlower.i64_ret_fns_of(mod.funcs), irlower.tuple_ret_fns_of(mod.funcs), irlower.struct_ret_fns_of(mod.funcs, mod.structs), irlower.f64_ret_fns_of(mod.funcs), irlower.f64arr_ret_fns_of(mod.funcs), irlower.i64arr_ret_fns_of(mod.funcs), irlower.fn_param_sigs_of(mod.funcs), irlower.closure_ret_fns_of(mod.funcs));
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind == "call_direct") {
            if (!is_fern_helper(o.str) && !module_has_func(mod, o.str)) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// ir_bin_asm renders the asm for one IR binary op (lhs in %rax, rhs in %rcx,
// result in %rax) — mirroring asm.fern's own ExprBinary sequences (64-bit,
// signed i32 div/cmp) so the two paths agree exactly.
function ir_bin_asm(kind: string, width: i32): string {
    if (kind == "add") { return "    addq %rcx, %rax\n"; }
    if (kind == "sub") { return "    subq %rcx, %rax\n"; }
    if (kind == "mul") { return "    imulq %rcx, %rax\n"; }
    // i64 div/rem operate on the full 64-bit operands (no movslq truncation);
    // i32 div/rem sign-extend the low 32 first so dirty upper bits don't skew
    // the 64-bit idivq.
    if (kind == "div_s" && width == 64) { return "    cqto\n    idivq %rcx\n"; }
    if (kind == "rem_s" && width == 64) { return "    cqto\n    idivq %rcx\n    movq %rdx, %rax\n"; }
    if (kind == "div_s") { return "    movslq %eax, %rax\n    movslq %ecx, %rcx\n    cqto\n    idivq %rcx\n"; }
    if (kind == "rem_s") { return "    movslq %eax, %rax\n    movslq %ecx, %rcx\n    cqto\n    idivq %rcx\n    movq %rdx, %rax\n"; }
    // Unsigned 64-bit div/rem (u64, #2904): zero RDX, divq (no sign-extend). The
    // operands are full 64-bit u64 values, so no movslq truncation.
    if (kind == "div_u") { return "    xorl %edx, %edx\n    divq %rcx\n"; }
    if (kind == "rem_u") { return "    xorl %edx, %edx\n    divq %rcx\n    movq %rdx, %rax\n"; }
    if (kind == "and") { return "    andq %rcx, %rax\n"; }
    if (kind == "or") { return "    orq %rcx, %rax\n"; }
    if (kind == "xor") { return "    xorq %rcx, %rax\n"; }
    if (kind == "shl") { return "    shlq %cl, %rax\n"; }
    if (kind == "shr_s") { return "    sarq %cl, %rax\n"; }
    if (kind == "shr_u") { return "    shrq %cl, %rax\n"; }
    if (kind == "eq") { return "    cmpq %rcx, %rax\n    sete %al\n    movzbq %al, %rax\n"; }
    if (kind == "ne") { return "    cmpq %rcx, %rax\n    setne %al\n    movzbq %al, %rax\n"; }
    if (kind == "lt_s") { return "    cmpq %rcx, %rax\n    setl %al\n    movzbq %al, %rax\n"; }
    if (kind == "le_s") { return "    cmpq %rcx, %rax\n    setle %al\n    movzbq %al, %rax\n"; }
    if (kind == "gt_s") { return "    cmpq %rcx, %rax\n    setg %al\n    movzbq %al, %rax\n"; }
    if (kind == "ge_s") { return "    cmpq %rcx, %rax\n    setge %al\n    movzbq %al, %rax\n"; }
    // Unsigned 64-bit compares (u64, #2904): same cmpq, but the below/above
    // setcc family reads CF instead of SF/OF — correct once bit 63 is set.
    if (kind == "lt_u") { return "    cmpq %rcx, %rax\n    setb %al\n    movzbq %al, %rax\n"; }
    if (kind == "le_u") { return "    cmpq %rcx, %rax\n    setbe %al\n    movzbq %al, %rax\n"; }
    if (kind == "gt_u") { return "    cmpq %rcx, %rax\n    seta %al\n    movzbq %al, %rax\n"; }
    if (kind == "ge_u") { return "    cmpq %rcx, %rax\n    setae %al\n    movzbq %al, %rax\n"; }
    return "    # ir: unsupported bin " + kind + "\n";
}

// br_target resolves a `br d` / `br_if d` at op index `i` to its label: a
// loop scope -> its header label (the loop op's index); a block/if scope ->
// the label at its matching `end`. Uses irlower's nesting scanners — no
// threaded scope-stack state (a self-host-robust formulation; the earlier
// grow-and-overwrite string[] scope arrays mis-ran under the self-hosted
// compiler).
pub function br_target(ops: ir.Op[], lp: string, i: i32, d: i32): string {
    var op: i32 = irlower.enclosing_opener(ops, i, d);
    if (ops[op].kind == "loop") { return lp + util.i32_to_string(op); }
    return lp + util.i32_to_string(irlower.find_matching_end(ops, op + 1));
}

// is_str_op_kind reports whether `k` is one of the string operand-stack ops
// emit_str_op handles. Pulled out of emit_function_via_ir's giant op-dispatch
// chain so that 500-line function stays under the self-host backend's
// oversized-function miscompile threshold (#2720).
function is_str_op_kind(k: string): boolean {
    return k == "str_len" || k == "str_index" || k == "str_slice"
        || k == "str_bytes" || k == "str_split" || k == "str_starts_with"
        || k == "str_ends_with" || k == "str_index_of" || k == "str_concat"
        || k == "str_eq" || k == "str_cmp";
}

// emit_str_op emits one string operand-stack op (the bodies factored out of
// emit_function_via_ir's dispatch — see is_str_op_kind). Each pops its box
// operand(s), calls the matching __fern_str_* runtime, and pushes the result;
// the mark_* needs pull in the helper bodies (emit_ir_runtime / emit_ir_str_search).
function emit_str_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind == "str_len") {
        // pop string box; length is at box+8.
        return s.write("    popq %rax\n    movq 8(%rax), %rax\n    pushq %rax\n");
    }
    if (o.kind == "str_index") {
        // pop index (top), string box; box = [data@0, len@8], so the byte is
        // at [data + i]; zero-extend to an i32.
        return s.write("    popq %rcx\n    popq %rax\n    movq (%rax), %rax\n    movzbl (%rax,%rcx), %eax\n    pushq %rax\n");
    }
    if (o.kind == "str_slice") {
        // operand stack [src box, start, end] (end on top). Zero-copy view:
        // a fresh 16-byte box [data = src.data + start, len = end - start]
        // sharing the source bytes. r12/r13/r14 (callee-saved) hold end/start/
        // src across __fern_alloc (transcribed from asm.fern's ExprSlice).
        s = s.write("    popq %r8\n    popq %rcx\n    popq %rdx\n");
        s = s.write("    pushq %r12\n    pushq %r13\n    pushq %r14\n");
        s = s.write("    movq %r8, %r12\n    movq %rcx, %r13\n    movq %rdx, %r14\n");
        s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
        s = s.write("    movq (%r14), %rcx\n    addq %r13, %rcx\n    movq %rcx, (%rax)\n");
        s = s.write("    movq %r12, %rcx\n    subq %r13, %rcx\n    movq %rcx, 8(%rax)\n");
        return s.write("    popq %r14\n    popq %r13\n    popq %r12\n    pushq %rax\n");
    }
    if (o.kind == "str_bytes") {
        // operand stack [str box]; __fern_str_bytes(%rdi=box) -> fresh u8[] in %rax.
        s = s.write("    popq %rdi\n    call __fern_str_bytes\n    pushq %rax\n");
        return s.mark_str_bytes();
    }
    if (o.kind == "str_split") {
        // operand stack [haystack box, sep box] (sep on top);
        // __fern_str_split(%rdi=haystack, %rsi=sep) -> fresh string[] in %rax.
        s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_split\n    pushq %rax\n");
        return s.mark_str_split();
    }
    if (o.kind == "str_starts_with" || o.kind == "str_ends_with" || o.kind == "str_index_of") {
        // operand stack [s box, p box] (p on top); __fern_str_<pred>(%rdi=s,
        // %rsi=p) -> 0/1 (starts/ends) or first index / -1 (index_of) in %rax.
        // Allocation-free str_search predicates (helpers in emit_ir_str_search).
        var pfn: string = "__fern_str_starts_with";
        if (o.kind == "str_ends_with") { pfn = "__fern_str_ends_with"; }
        if (o.kind == "str_index_of") { pfn = "__fern_str_index_of"; }
        s = s.write("    popq %rsi\n    popq %rdi\n    call " + pfn + "\n    pushq %rax\n");
        return s.mark_str_search();
    }
    if (o.kind == "str_concat") {
        // operand stack: [box A, box B] (B on top). __fern_str_concat takes
        // %rdi = A, %rsi = B and returns the fresh box in %rax.
        s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_concat\n    pushq %rax\n");
        return s.mark_str_concat();
    }
    if (o.kind == "str_eq") {
        // operand stack: [box A, box B]; __fern_str_eq(%rdi=A, %rsi=B) -> 0/1.
        s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_eq\n    pushq %rax\n");
        return s.mark_str_eq();
    }
    // str_cmp: operand stack [box A, box B]; __fern_str_cmp(%rdi=A, %rsi=B) ->
    // signed -/0/+ in %rax (lexicographic, length tiebreak).
    s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_cmp\n    pushq %rax\n");
    return s.mark_str_cmp();
}

// emit_function_via_ir emits one IR-eligible function via the stack IR,
// writing through the global strbuf (same as asm.fern's emitters).
// arr_ret_fns drives move-on-return / move-from-call for array values.
function emit_function_via_ir(fd: parser.FuncDecl, arr_ret_fns: string[], s: asmcore.EmitState): asmcore.EmitState {
    var r: irlower.LowerResult = irlower.lower_func(fd, arr_ret_fns, s.struct_decls, irlower.str_ret_fns_of(s.funcs), irlower.strarr_ret_fns_of(s.funcs), irlower.opt_ret_fns_of(s.funcs), irlower.i64_ret_fns_of(s.funcs), irlower.tuple_ret_fns_of(s.funcs), irlower.struct_ret_fns_of(s.funcs, s.struct_decls), irlower.f64_ret_fns_of(s.funcs), irlower.f64arr_ret_fns_of(s.funcs), irlower.i64arr_ret_fns_of(s.funcs), irlower.fn_param_sigs_of(s.funcs), irlower.closure_ret_fns_of(s.funcs));

    // Methods get the receiver-type-qualified label `__fn_<Type>.<name>` (matching
    // asm.fern + irlower's dispatch); free functions stay `__fn_<name>`.
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) { label_name = util.base_type_name(fd.receiver_type) + "." + fd.name; }
    s = s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    var frame: i32 = r.n_locals * 8;
    if (frame % 16 != 0) { frame = frame + 8; }
    if (frame > 0) { s = s.write("    subq $" + util.i32_to_string(frame) + ", %rsp\n"); }

    // Zero-init the body-local slots (Perceus exit-sweep safety, matching
    // asm.fern): a `var` decl skipped on an untaken branch leaves its slot
    // readable by the release sweep, which must see NULL (arr_dec no-ops)
    // rather than stack garbage. Body locals are slots [n_params, n_locals);
    // slot i is at -8*(i+1)(%rbp), so the range's lowest address is
    // -8*n_locals(%rbp) and it holds (n_locals - n_params) quadwords. rep
    // stosq clobbers rax/rcx/rdi, dead here (before the param copy).
    var nbody: i32 = r.n_locals - r.n_params;
    if (nbody > 0) {
        s = s.write("    leaq " + util.i32_to_string(0 - r.n_locals * 8) + "(%rbp), %rdi\n");
        s = s.write("    movq $" + util.i32_to_string(nbody) + ", %rcx\n");
        s = s.write("    xorq %rax, %rax\n");
        s = s.write("    cld\n");
        s = s.write("    rep stosq\n");
    }

    // Copy params from the caller stack into their local slots, exactly as
    // emit_function does: param[i] sits at +(16 + i*8)(%rbp); the IR's
    // load_local i reads -8*(i+1)(%rbp). r.n_params counts the receiver (slot 0)
    // for a method, so the receiver — which the caller passes as arg 0 at
    // +16(%rbp) — copies into slot 0 uniformly with the rest of the params.
    var pidx: i32 = 0;
    while (pidx < r.n_params) {
        s = s.write("    movq " + util.i32_to_string(16 + pidx * 8) + "(%rbp), %rax\n");
        s = s.write("    movq %rax, " + util.i32_to_string(0 - 8 * (pidx + 1)) + "(%rbp)\n");
        pidx = pidx + 1;
    }

    // Structured control flow -> flat labels, derived from OP-STREAM INDICES
    // (no threaded scope stack): the label at op index `j` is `lp<j>`. An `if`
    // jumps to its matching `else` (or `end`); `else`/`loop`/`end` define the
    // label at their own index; `br`/`br_if` resolve via br_target. Branch
    // matching reuses irlower's nesting scanners.
    var lp: string = ".Lir_" + asmcore.sanitize_label(label_name) + "_";
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind == "const_i32") {
            s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rax\n    pushq %rax\n");
        } else if (o.kind == "const_i32_text") {
            // Integer literal source text spliced into a 32-bit immediate (hex /
            // full u32 range) — byte-identical to asm.fern's ExprNumber.
            s = s.write("    movq $" + o.str + ", %rax\n    pushq %rax\n");
        } else if (o.kind == "const_i64") {
            // 64-bit immediate (source text): movabsq handles the full range.
            // i64 add/sub/mul/cmp/bitwise then reuse the existing 64-bit-register
            // bin ops unchanged — only the load differs from i32.
            s = s.write("    movabsq $" + o.str + ", %rax\n    pushq %rax\n");
        } else if (o.kind == "int_extend" || o.kind == "int_wrap") {
            // i32<->i64 in 64-bit slots: signed -> sign-extend low 32 (movslq),
            // unsigned -> zero-extend low 32 (movl). Same sequence either way.
            s = s.write("    popq %rax\n");
            if (o.unsigned) { s = s.write("    movl %eax, %eax\n"); }
            else { s = s.write("    movslq %eax, %rax\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "u32_wrap") {
            // Reduce to the u32 range (zero-extend low 32) — wraps a u32 arith
            // result at 2^32 on this 64-bit-register backend.
            s = s.write("    popq %rax\n    movl %eax, %eax\n    pushq %rax\n");
        } else if (o.kind == "int_cast") {
            // `x as <ty>` int→int width mask/extend — byte-identical to asm.fern.
            s = s.write("    popq %rax\n");
            if (o.str == "u8") { s = s.write("    andq $255, %rax\n"); }
            else if (o.str == "u16") { s = s.write("    andq $65535, %rax\n"); }
            else if (o.str == "u32") { s = s.write("    movl %eax, %eax\n"); }
            else if (o.str == "i8") { s = s.write("    movsbq %al, %rax\n"); }
            else if (o.str == "i16") { s = s.write("    movswq %ax, %rax\n"); }
            else if (o.str == "i32") { s = s.write("    movslq %eax, %rax\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "arr_push") {
            // [arr, val] -> grown array. __fern_arr_push(%rdi=arr, %rsi=val).
            s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_arr_push\n    pushq %rax\n");
            s = s.mark_arr_push();
        } else if (o.kind == "alloc_u8") {
            // [n] -> fresh n-element array. __fern_alloc_u8(%rdi=n).
            s = s.write("    popq %rdi\n    call __fern_alloc_u8\n    pushq %rax\n");
            s = s.need("heap").need("alloc_u8");
        } else if (o.kind == "str_from_bytes") {
            // [arr] -> string box packing each slot's low byte.
            s = s.write("    popq %rdi\n    call __fern_string_from_bytes\n    pushq %rax\n");
            s = s.need("heap").need("str_from_bytes");
        } else if (o.kind == "load_local") {
            s = s.write("    pushq " + util.i32_to_string(0 - 8 * (o.i32_imm + 1)) + "(%rbp)\n");
        } else if (o.kind == "store_local") {
            s = s.write("    popq %rax\n    movq %rax, " + util.i32_to_string(0 - 8 * (o.i32_imm + 1)) + "(%rbp)\n");
        } else if (o.kind == "not") {
            s = s.write("    popq %rax\n    testq %rax, %rax\n    setz %al\n    movzbq %al, %rax\n    pushq %rax\n");
        } else if (o.kind == "return") {
            s = s.write("    popq %rax\n    leave\n    ret\n");
        } else if (o.kind == "if") {
            // jump to the matching else (if any) or end when the cond is false.
            var elseidx: i32 = irlower.find_matching_else(r.ops, i + 1);
            var tgt: string = "";
            if (elseidx >= 0) { tgt = lp + util.i32_to_string(elseidx); }
            else { tgt = lp + util.i32_to_string(irlower.find_matching_end(r.ops, i + 1)); }
            s = s.write("    popq %rax\n    testq %rax, %rax\n    jz " + tgt + "\n");
        } else if (o.kind == "else") {
            // end of the then-arm jumps past the else; land the false path here.
            s = s.write("    jmp " + lp + util.i32_to_string(irlower.find_matching_end(r.ops, i + 1)) + "\n");
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else if (o.kind == "block") {
            // forward scope: its exit label is defined at the matching `end`.
        } else if (o.kind == "loop") {
            // backward scope: header label, branched to by `br`.
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else if (o.kind == "br") {
            s = s.write("    jmp " + br_target(r.ops, lp, i, o.i32_imm) + "\n");
        } else if (o.kind == "brif") {
            s = s.write("    popq %rax\n    testq %rax, %rax\n    jnz " + br_target(r.ops, lp, i, o.i32_imm) + "\n");
        } else if (o.kind == "arr_make") {
            // n element values on the operand stack (element n-1 on top).
            // asm.fern 8-byte layout via __fern_arr_box: data = base+16, rc=1,
            // len=n, element i at data+(i+1)*8. Pop top-down (element n-1 →
            // slot n .. element 0 → slot 1); base stays live in %rax across the
            // pops (they only touch the operand stack), then push it.
            var n: i32 = o.i32_imm;
            s = s.write("    movq $" + util.i32_to_string(n) + ", %rdi\n");
            s = s.write("    call __fern_arr_box\n");
            var em: i32 = n - 1;
            while (em >= 0) {
                s = s.write("    popq %rcx\n    movq %rcx, " + util.i32_to_string((em + 1) * 8) + "(%rax)\n");
                em = em - 1;
            }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "arr_get") {
            // pop idx (top), base; element at data+(idx+1)*8.
            s = s.write("    popq %rcx\n    popq %rax\n    incq %rcx\n    movq (%rax,%rcx,8), %rax\n    pushq %rax\n");
        } else if (o.kind == "arr_set") {
            // pop val (top), idx, base; store at data+(idx+1)*8.
            s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n    incq %rcx\n    movq %rdx, (%rax,%rcx,8)\n");
        } else if (o.kind == "arr_len") {
            // pop base; length header at data+0.
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "arr_rc") {
            // pop base; 32-bit refcount field at data-8.
            s = s.write("    popq %rax\n    movl -8(%rax), %eax\n    pushq %rax\n");
        } else if (o.kind == "const_str") {
            // String literal: intern the bytes in .rodata, allocate a 16-byte
            // box `[data_ptr@0, len@8]`, push the box ptr — byte-identical to
            // asm.fern's ExprString so __fern_str_concat / _eq see the same
            // layout. Strings are not RC'd (no header), so they leak (matching
            // the AST path; fine for short-lived programs).
            var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, o.str);
            s = lo.state;
            s = s.write("    movq $16, %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.write("    leaq .S" + util.i32_to_string(lo.idx) + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            s = s.write("    movq $" + util.i32_to_string(o.str.len()) + ", %rcx\n");
            s = s.write("    movq %rcx, 8(%rax)\n");
            s = s.write("    pushq %rax\n");
        } else if (is_str_op_kind(o.kind)) {
            // All string operand-stack ops (len/index/slice/bytes/split/
            // predicates/concat/eq/cmp) are emitted by emit_str_op — factored out
            // to keep this dispatch under the oversized-function threshold (#2720).
            s = emit_str_op(o, s);
        } else if (o.kind == "arr_slice") {
            // operand stack [arr, start, end]; __fern_arr_slice(%rdi=arr,
            // %rsi=start, %rdx=end) -> fresh array in %rax (copies elements).
            s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    call __fern_arr_slice\n    pushq %rax\n");
            s = s.mark_arr_slice();
        } else if (o.kind == "random_bytes") {
            // operand stack [n]; __fern_random_bytes(%rdi=n) -> string box in %rax.
            s = s.write("    popq %rdi\n    call __fern_random_bytes\n    pushq %rax\n");
            s = s.need("heap").need("random_bytes");
        } else if (o.kind == "random_i32") {
            // no operands; __fern_random_i32() -> i32 in %rax.
            s = s.write("    call __fern_random_i32\n    pushq %rax\n");
            s = s.need("random_i32");
        } else if (o.kind == "monotonic_ns") {
            // no operands; __fern_monotonic_ns() -> i64 in %rax.
            s = s.write("    call __fern_monotonic_ns\n    pushq %rax\n");
            s = s.need("monotonic_ns");
        } else if (o.kind == "now_unix_ms") {
            // no operands; __fern_now_unix_ms() -> i64 in %rax.
            s = s.write("    call __fern_now_unix_ms\n    pushq %rax\n");
            s = s.need("now_unix_ms");
        } else if (o.kind == "now_ns") {
            // no operands; __fern_now_ns() -> i64 in %rax.
            s = s.write("    call __fern_now_ns\n    pushq %rax\n");
            s = s.need("now_ns");
        } else if (o.kind == "struct_make") {
            // nf field values on the operand stack (field nf-1 on top, decl
            // order). Box = [shape_ptr@0, f0@8, f1@16, …], (nf+1)*8 bytes; shape
            // = the interned struct-name string (asm.fern's layout). Pop fields
            // top-down (field nf-1 → slot nf .. field 0 → slot 1); %rax (box)
            // stays live across the pops (they touch only the operand stack).
            var nf: i32 = o.i32_imm;
            var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, o.str);
            s = lo.state;
            s = s.write("    movq $" + util.i32_to_string((nf + 1) * 8) + ", %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.write("    leaq .S" + util.i32_to_string(lo.idx) + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            var em: i32 = nf - 1;
            while (em >= 0) {
                s = s.write("    popq %rcx\n    movq %rcx, " + util.i32_to_string((em + 1) * 8) + "(%rax)\n");
                em = em - 1;
            }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "opt_make") {
            // Option/Result box [tag@0, payload@8], 16 bytes. Payload is on the
            // operand stack; alloc first (it survives on the machine stack, like
            // struct_make), then store tag + payload.
            s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
            s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", (%rax)\n");
            s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");
        } else if (o.kind == "opt_none") {
            // Payloadless box with tag 1 (None).
            s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
            s = s.write("    movq $1, (%rax)\n    movq $0, 8(%rax)\n    pushq %rax\n");
        } else if (o.kind == "opt_tag") {
            // pop box; tag is the i32 at offset 0.
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "opt_payload") {
            // pop box; payload is at offset 8.
            s = s.write("    popq %rax\n    movq 8(%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "map_new") {
            s = s.write("    popq %rdi\n    call __fern_map_new\n    pushq %rax\n");
        } else if (o.kind == "print_int") {
            // [n] -> write n's decimal text to stdout (the AST path's helper +
            // symbol). Push the syscall return so the statement-level drop balances.
            s = s.write("    popq %rdi\n    call __fern_print_int\n    pushq %rax\n");
            s = s.need("print_int");
        } else if (o.kind == "print_str") {
            // [strbox] -> write its bytes to stdout (the AST path's __fern_print_str).
            // Push the syscall return so the statement-level drop balances.
            s = s.write("    popq %rdi\n    call __fern_print_str\n    pushq %rax\n");
            s = s.need("str_print");
        } else if (o.kind == "read_int") {
            // no args -> read an i32 from stdin (the AST path's __fern_read_int),
            // push the result (a value op).
            s = s.write("    call __fern_read_int\n    pushq %rax\n");
            s = s.need("read_int");
        } else if (o.kind == "read_line") {
            // no args -> read one line from stdin into a fresh string box (the AST
            // path's __fern_read_line, which allocates), push the box (a value op).
            s = s.write("    call __fern_read_line\n    pushq %rax\n");
            s = s.need("heap").need("str_read_line");
        } else if (o.kind == "eprint_str") {
            // [strbox] -> write its bytes to stderr (the AST path's __fern_eprint_str).
            // Push the syscall return so the statement-level drop balances.
            s = s.write("    popq %rdi\n    call __fern_eprint_str\n    pushq %rax\n");
            s = s.need("eprint");
        } else if (o.kind == "exit") {
            // [n] -> sys_exit(n). Never returns; the pushed dummy keeps the
            // operand-stack shape for the statement-level drop.
            s = s.write("    popq %rdi\n    movq $60, %rax\n    syscall\n    pushq $0\n");
        } else if (o.kind == "putchar") {
            // [byte] -> write the low byte to stdout (write(1,&byte,1)). Push the
            // syscall return so the statement-level drop balances.
            s = s.write("    popq %rdi\n    call __fern_putchar\n    pushq %rax\n");
            s = s.need("putchar");
        } else if (o.kind == "sleep_ms") {
            // [ms] -> nanosleep(ms). Push the syscall return so the
            // statement-level drop balances (sleep_ms is void).
            s = s.write("    popq %rdi\n    call __fern_sleep_ms\n    pushq %rax\n");
            s = s.need("sleep_ms");
        } else if (o.kind == "map_set") {
            s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
            s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rcx\n    call __fern_map_set\n    pushq %rax\n");
        } else if (o.kind == "map_len") {
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "map_get") {
            s = s.write("    popq %rsi\n    popq %rdi\n    movq $" + util.i32_to_string(o.i32_imm) + ", %rdx\n    call __fern_map_get\n    pushq %rax\n");
        } else if (o.kind == "map_has") {
            s = s.write("    popq %rsi\n    popq %rdi\n    movq $" + util.i32_to_string(o.i32_imm) + ", %rdx\n    call __fern_map_has\n    pushq %rax\n");
        } else if (o.kind == "map_get_or") {
            // [map, k, default] -> __fern_map_get, then Some payload or default.
            var golbl: string = lp + "go" + util.i32_to_string(i);
            s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n");
            s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rdx\n    call __fern_map_get\n    popq %rdx\n");
            s = s.write("    movq (%rax), %rcx\n    testq %rcx, %rcx\n    jnz " + golbl + "_d\n");
            s = s.write("    movq 8(%rax), %rax\n    jmp " + golbl + "_e\n");
            s = s.write(golbl + "_d:\n    movq %rdx, %rax\n" + golbl + "_e:\n    pushq %rax\n");
        } else if (o.kind == "map_keys") {
            // parallel-array map: keys[] pointer at box+0.
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "map_values") {
            // parallel-array map: values[] pointer at box+8.
            s = s.write("    popq %rax\n    movq 8(%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "struct_get") {
            // pop struct box; field at (index+1)*8.
            s = s.write("    popq %rax\n    movq " + util.i32_to_string((o.i32_imm + 1) * 8) + "(%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "struct_set") {
            // pop val (top), box; store val at field (index+1)*8.
            s = s.write("    popq %rcx\n    popq %rax\n    movq %rcx, " + util.i32_to_string((o.i32_imm + 1) * 8) + "(%rax)\n");
        } else if (o.kind == "variant_is") {
            // pop variant box; shape ptr @0; compare to the interned variant name
            // (same .S label struct_make stores, so pointer equality identifies
            // the variant). Push 1 if equal, else 0.
            var vlo: asmcore.StringLitOut = asmcore.add_string_lit(s, o.str);
            s = vlo.state;
            s = s.write("    popq %rax\n    movq (%rax), %rax\n");
            s = s.write("    leaq .S" + util.i32_to_string(vlo.idx) + "(%rip), %rcx\n");
            s = s.write("    cmpq %rcx, %rax\n    sete %al\n    movzbq %al, %rax\n    pushq %rax\n");
        } else if (o.kind == "tuple_make") {
            // n element values on the operand stack (element n-1 on top). Box =
            // [e0@0, e1@8, …], n*8 bytes, NO shape slot (numeric `.i` access).
            // Pop top-down; %rax (box) stays live across the pops.
            var tn: i32 = o.i32_imm;
            s = s.write("    movq $" + util.i32_to_string(tn * 8) + ", %rdi\n    call __fern_alloc\n");
            var tem: i32 = tn - 1;
            while (tem >= 0) {
                s = s.write("    popq %rcx\n    movq %rcx, " + util.i32_to_string(tem * 8) + "(%rax)\n");
                tem = tem - 1;
            }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "tuple_get") {
            // pop tuple box; element at index*8.
            s = s.write("    popq %rax\n    movq " + util.i32_to_string(o.i32_imm * 8) + "(%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "drop") {
            s = s.write("    addq $8, %rsp\n");
        } else if (o.kind == "call_direct" && is_fern_helper(o.str)) {
            // Runtime RC helper — asm.fern's stack-arg ABI + symbols (drop-in):
            // the arg(s) are already on the operand stack (the helper reads
            // 8(%rsp)); call, caller-clean the args, push the result. The
            // helpers return the ptr (rc_inc / arr_dec) or the count
            // (underflow_count) in %rax.
            // __fern_i32_to_string allocates its result box, so it needs the
            // heap runtime + its own body (gated on this need in emit_ir_runtime).
            if (o.str == "__fern_i32_to_string") { s = s.need("heap").need("i32_to_string"); }
            s = s.write("    call " + ir_helper_symbol(o.str) + "\n");
            if (o.i32_imm > 0) { s = s.write("    addq $" + util.i32_to_string(o.i32_imm * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "call_direct") {
            // User call: the IR pushes args left-to-right (arg0 deepest);
            // asm.fern's stack ABI wants arg0 on TOP (param[i] at +16+i*8(%rbp)).
            // Reverse the argc on-stack slots, call, pop the args, push %rax.
            var argc: i32 = o.i32_imm;
            var h: i32 = 0;
            while (h < argc / 2) {
                var lo: i32 = h * 8;
                var hi: i32 = (argc - 1 - h) * 8;
                s = s.write("    movq " + util.i32_to_string(lo) + "(%rsp), %rax\n");
                s = s.write("    movq " + util.i32_to_string(hi) + "(%rsp), %rcx\n");
                s = s.write("    movq %rax, " + util.i32_to_string(hi) + "(%rsp)\n");
                s = s.write("    movq %rcx, " + util.i32_to_string(lo) + "(%rsp)\n");
                h = h + 1;
            }
            s = s.write("    call __fn_" + asmcore.sanitize_label(o.str) + "\n");
            if (argc > 0) { s = s.write("    addq $" + util.i32_to_string(argc * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "dyn_dispatch") {
            // `dyn Trait` method call. Receiver (arg0) + args are spilled in argc
            // consecutive locals from base_slot. Read the receiver's shape pointer
            // and dispatch to the matching `<Type>.<method>` — a compare-branch
            // chain over every module method named o.str with a struct receiver,
            // mirroring asm.fern's dyn dispatch. Each matched arm pushes the argc
            // locals (arg0/receiver on top, asm.fern's ABI) and calls.
            var dbase: i32 = o.i32_imm;
            var dargc: i32 = o.width;
            s = s.write("    movq " + util.i32_to_string(0 - 8 * (dbase + 1)) + "(%rbp), %rax\n");
            s = s.write("    movq (%rax), %rcx\n");
            var dend: string = lp + "dynend" + util.i32_to_string(i);
            var dfi: i32 = 0;
            var darmn: i32 = 0;
            while (dfi < s.funcs.len()) {
                var dfd: parser.FuncDecl = s.funcs[dfi];
                if (dfd.name == o.str && dfd.receiver_type.len() > 0
                        && asmcore.is_struct_decl_name(util.base_type_name(dfd.receiver_type), s)) {
                    var dbn: string = util.base_type_name(dfd.receiver_type);
                    var dlit: asmcore.StringLitOut = asmcore.add_string_lit(s, dbn);
                    s = dlit.state;
                    var dnext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
                    s = s.write("    leaq .S" + util.i32_to_string(dlit.idx) + "(%rip), %rdx\n");
                    s = s.write("    cmpq %rdx, %rcx\n");
                    s = s.write("    jne " + dnext + "\n");
                    var dk: i32 = dargc - 1;
                    while (dk >= 0) {
                        s = s.write("    pushq " + util.i32_to_string(0 - 8 * (dbase + dk + 1)) + "(%rbp)\n");
                        dk = dk - 1;
                    }
                    s = s.write("    call __fn_" + asmcore.sanitize_label(dbn + "." + dfd.name) + "\n");
                    s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
                    s = s.write("    pushq %rax\n");
                    s = s.write("    jmp " + dend + "\n");
                    s = s.write(dnext + ":\n");
                    darmn = darmn + 1;
                }
                dfi = dfi + 1;
            }
            s = s.write("    pushq $0\n");   // fallback (unreachable for a valid dyn value)
            s = s.write(dend + ":\n");
        } else if (o.kind == "const_func") {
            // A function VALUE is the function's code address — push it. Register
            // backends need no funcref table (unlike wasm's table index): the
            // address is the value, dispatched directly by call_indirect.
            s = s.write("    leaq __fn_" + asmcore.sanitize_label(o.str) + "(%rip), %rax\n    pushq %rax\n");
        } else if (o.kind == "call_indirect") {
            // Indirect call through a function value: the stack holds
            // [arg0(deepest) … argN-1, fn_addr(top)]. Pop the target into a
            // scratch reg, reverse the args so arg0 is on TOP (the stack-arg ABI
            // the callee reads at +16+i*8(%rbp)), call through the pointer, pop
            // the args, push the result. Same arg discipline as call_direct.
            var icargc: i32 = o.i32_imm;
            s = s.write("    popq %r11\n");
            var ih: i32 = 0;
            while (ih < icargc / 2) {
                var ilo: i32 = ih * 8;
                var ihi: i32 = (icargc - 1 - ih) * 8;
                s = s.write("    movq " + util.i32_to_string(ilo) + "(%rsp), %rax\n");
                s = s.write("    movq " + util.i32_to_string(ihi) + "(%rsp), %rcx\n");
                s = s.write("    movq %rax, " + util.i32_to_string(ihi) + "(%rsp)\n");
                s = s.write("    movq %rcx, " + util.i32_to_string(ilo) + "(%rsp)\n");
                ih = ih + 1;
            }
            s = s.write("    call *%r11\n");
            if (icargc > 0) { s = s.write("    addq $" + util.i32_to_string(icargc * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "const_f64") {
            // Float literal: GAS assembles the source text to an IEEE double in
            // .rodata; load its bits and push them (floats flow on the rt-stack
            // as their 8-byte bit pattern, like i64). Mirrors asm.fern.
            var flb: asmcore.LabelOut = asmcore.fresh_label(s);
            s = flb.state;
            s = s.write("    .section .rodata\n" + flb.name + ": .double " + o.str + "\n    .text\n");
            s = s.write("    movsd " + flb.name + "(%rip), %xmm0\n    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "i32_to_f64") {
            // signed i32 -> f64 (cvtsi2sd); value rides the stack as bits.
            s = s.write("    popq %rax\n    cvtsi2sd %rax, %xmm0\n    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "f64_to_i32") {
            // f64 -> signed i32, truncating toward zero (cvttsd2si).
            s = s.write("    popq %rax\n    movq %rax, %xmm0\n    cvttsd2si %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "fadd" || o.kind == "fsub" || o.kind == "fmul" || o.kind == "fdiv") {
            // f64 arithmetic: pop rhs/lhs bits into xmm1/xmm0, op, push result.
            s = s.write("    popq %rax\n    movq %rax, %xmm1\n    popq %rax\n    movq %rax, %xmm0\n");
            if (o.kind == "fadd") { s = s.write("    addsd %xmm1, %xmm0\n"); }
            else if (o.kind == "fsub") { s = s.write("    subsd %xmm1, %xmm0\n"); }
            else if (o.kind == "fmul") { s = s.write("    mulsd %xmm1, %xmm0\n"); }
            else { s = s.write("    divsd %xmm1, %xmm0\n"); }
            s = s.write("    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "flt" || o.kind == "fle" || o.kind == "fgt" || o.kind == "fge" || o.kind == "feq" || o.kind == "fne") {
            // f64 compare → i32 0/1, NaN-correct (mirrors asm.fern): ucomisd sets
            // CF=ZF=PF=1 when unordered, so `<`/`<=`/`==` mask with setnp and
            // `!=` accepts unordered via setp; `>`/`>=` use seta/setae (CF=0).
            s = s.write("    popq %rax\n    movq %rax, %xmm1\n    popq %rax\n    movq %rax, %xmm0\n");
            s = s.write("    ucomisd %xmm1, %xmm0\n    movq $0, %rax\n");
            if (o.kind == "flt") { s = s.write("    setb %al\n    setnp %dl\n    andb %dl, %al\n"); }
            else if (o.kind == "fle") { s = s.write("    setbe %al\n    setnp %dl\n    andb %dl, %al\n"); }
            else if (o.kind == "fgt") { s = s.write("    seta %al\n"); }
            else if (o.kind == "fge") { s = s.write("    setae %al\n"); }
            else if (o.kind == "feq") { s = s.write("    sete %al\n    setnp %dl\n    andb %dl, %al\n"); }
            else { s = s.write("    setne %al\n    setp %dl\n    orb %dl, %al\n"); }
            s = s.write("    movzbq %al, %rax\n    pushq %rax\n");
        } else if (o.kind == "end") {
            // Define the label at this end's index — the target of the if/else
            // that opened it (no-else if's jz, else's jmp) or a block's br.
            // A loop's closing end is unused (harmless).
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else {
            // binary op: pop rhs (rcx), lhs (rax), combine, push.
            s = s.write("    popq %rcx\n    popq %rax\n");
            s = s.write(ir_bin_asm(o.kind, o.width));
            s = s.write("    pushq %rax\n");
        }
        i = i + 1;
    }

    // Fallback (subset functions always end in `return`).
    s = s.write("    movq $0, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// lift_lambdas re-exports irlower's lambda-lift pre-pass so the dispatch sites
// (asm.emit_module / asm_ir_run) can hoist no-capture lambda arguments before
// the eligibility check + emit without importing irlower directly.
pub function lift_lambdas(mod: parser.Module): parser.Module {
    return irlower.lift_lambdas(mod);
}

// emit_module_ir emits a full all-i32-eligible module via the IR path. The
// program is self-contained (pure i32 uses no runtime helpers): every
// function via the IR, then a `_start` that calls __fn_main and exits with
// its result. Caller must ensure all_eligible(mod).
pub function emit_module_ir(mod: parser.Module): string {
    // Infer return types for unannotated functions so the IR path's
    // ret-type-keyed call tagging (str_ret_fns_of / opt_ret_fns_of / …)
    // matches the AST path, which gets the same via module_with_builtins.
    mod = parser.infer_ret_types_module(mod);
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    s = asmcore.EmitState { ...s, struct_decls: mod.structs, funcs: mod.funcs };
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    var arf: string[] = array_ret_fns(mod);
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        s = emit_function_via_ir(mod.funcs[fi], arf, s);
        fi = fi + 1;
    }
    s = s.write("_start:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    call __fn_main\n");
    s = s.write("    movq %rax, %rdi\n");
    s = s.write("    movq $60, %rax\n");
    s = s.write("    syscall\n");
    // .rodata: each interned string literal as a labelled `.ascii` directive
    // (GAS interprets the escapes), matching asm.fern's emit_module so the box's
    // .S<idx> data pointer resolves. string_lits was populated by const_str.
    if (s.string_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < s.string_lits.len()) {
            s = s.write(".S" + util.i32_to_string(li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
    }
    // A map-using module marks the top-level "maps" need; close_needs() pulls in
    // its declared deps (str_eq, arr_push) so the runtime links — no hand-marking.
    if (module_uses_maps(mod)) { s = s.need("maps"); }
    s = s.close_needs();
    // The freestanding allocator + RC runtime, only when the program allocates.
    // i32.to_string() allocates its box even in an otherwise heap-free program,
    // so its emit-time need pulls the runtime in too (its body calls __fern_alloc).
    if (module_uses_heap(mod) || s.has_need("i32_to_string") || s.has_need("print_int") || s.has_need("read_int") || s.has_need("str_read_line") || s.has_need("putchar")) { s = emit_ir_runtime(s); }
    // String search predicates (starts_with / ends_with / index_of) are
    // allocation-free + self-contained, so they're emitted in their own helper
    // — kept OUT of emit_ir_runtime, whose size is near the self-host's
    // oversized-function miscompile threshold (#2720).
    if (s.has_need("str_search")) { s = emit_ir_str_search(s); }
    // random_i32 allocates nothing, so its helper is emitted independently of
    // the heap runtime (a random_i32-only program is heap-free).
    if (s.has_need("random_i32")) { s = emit_ir_random_i32(s); }
    // Clock helpers: allocation-free, so emitted independently of the heap
    // runtime (a clock-only program is heap-free), like random_i32.
    if (s.has_need("monotonic_ns")) { s = emit_ir_monotonic_ns(s); }
    if (s.has_need("now_unix_ms")) { s = emit_ir_now_unix_ms(s); }
    if (s.has_need("now_ns")) { s = emit_ir_now_ns(s); }
    if (s.has_need("sleep_ms")) { s = emit_ir_sleep_ms(s); }
    return strbuf_take();
}
