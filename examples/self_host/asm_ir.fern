        // accumulated bytes, sized to them, so the block frees at the class
        // it was bumped at (#9179); the builder keeps its buffer at full
        // width with nothing in it. An empty build answers a box over a null
        // buffer — __fn___fern_str_free's heap guard skips it.
        s = s.write("__fern_buf_take:\n");
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %rbx\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    pushq %r14\n");
        s = s.write("    movq %rdi, %rbx\n");
        s = s.write("    movq 8(%rbx), %r12\n");               // len
        s = s.write("    testq %r12, %r12\n");
        s = s.write("    jz .Lbuftake_empty\n");
        s = s.write("    movq %r12, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r13\n");                  // the copy
        s = s.write("    movq (%rbx), %rsi\n");                // data
        s = s.write("    movq %r13, %rdx\n");
        s = s.write("    movq %r12, %rcx\n");
        s = s.write("    movq %rdx, %rdi\n");
        s = s.write("    movq %rcx, %rdx\n");
        s = s.write("    call __fern_memcpy\n");
        s = s.write("    movq $0, 8(%rbx)\n");
        s = s.write("    movq %r13, %rdi\n");
        s = s.write("    movq %r12, %rsi\n");
        s = s.write("    call __fern_str_box\n");
        s = s.write("    jmp .Lbuftake_ret\n");
        s = s.write(".Lbuftake_empty:\n");
        s = s.write("    movq $0, %rdi\n");
        s = s.write("    movq $0, %rsi\n");
        s = s.write("    call __fern_str_box\n");
        s = s.write(".Lbuftake_ret:\n");
        s = s.write("    popq %r14\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    popq %rbx\n");
        s = s.write("    popq %rbp\n");
        s = s.write("    ret\n");
