    s = s.write("    movl -16(%rax), %ecx\n");
    s = s.write("    addq $3, %rcx\n");
    s = s.write("    cmpq $65536, %rcx\n");
    s = s.write("    jae .Larrdec_large\n");
    s = s.write("    leaq -16(%rax), %rdx\n");
    s = hev_free(s, "%rdx", "%rcx");
    s = s.write("    leaq __fern_freelist(%rip), %r8\n");
    s = s.write("    movq (%r8,%rcx,8), %rdi\n");
    s = s.write("    movq %rdi, (%rdx)\n");
    s = s.write("    movq %rdx, (%r8,%rcx,8)\n");
    s = s.write(".Larrdec_ret:\n");
    s = s.write("    ret\n");
