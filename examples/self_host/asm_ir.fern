    s = s.write("    movq $1, %rax\n");
    s = s.write("    jmp .Lmh_ret\n");
    s = s.write(".Lmh_no:\n");
    s = s.write("    movq $0, %rax\n");
    s = s.write(".Lmh_ret:\n");
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_has, .-__fern_map_has\n");
    // __fern_map_delete (transcribed from asm.fern) — `m.without(k)`. Mutates the
    // parallel keys[]/values[] in place (order-preserving left-shift over the hit
    // slot, both lengths decremented) and returns a 2-slot tuple [mapbox, existed].
    s = s.write(".globl __fern_map_delete\n");
    s = s.write(".type __fern_map_delete, @function\n");
    s = s.write("__fern_map_delete:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rbx\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    pushq %r13\n");
    s = s.write("    pushq %r14\n");
    s = s.write("    pushq %r15\n");
    s = s.write("    movq %rdi, %r12\n");
    s = s.write("    movq %rsi, %r13\n");
    s = s.write("    movq %rdx, %r14\n");
    s = s.write("    movq (%r12), %r15\n");
    s = s.write("    movq $0, %rbx\n");
    s = s.write("    testq %r14, %r14\n");
    s = s.write("    jnz .Lmd_loop_i32\n");
    s = s.write(".Lmd_loop:\n");
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmd_notfound\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdi\n");
    s = s.write("    movq %r13, %rsi\n");
    s = s.write("    call __fern_str_eq\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jnz .Lmd_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmd_loop\n");
    s = s.write(".Lmd_loop_i32:\n");
    s = s.write("    movq (%r15), %rax\n");
    s = s.write("    cmpq %rax, %rbx\n");
    s = s.write("    jge .Lmd_notfound\n");
    s = s.write("    movq %rbx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rax\n");
    s = s.write("    cmpq %r13, %rax\n");
    s = s.write("    je .Lmd_found\n");
    s = s.write("    incq %rbx\n");
    s = s.write("    jmp .Lmd_loop_i32\n");
    s = s.write(".Lmd_found:\n");
    s = s.write("    movq (%r12), %r15\n");
    s = s.write("    movq (%r15), %r14\n");
    s = s.write("    movq %rbx, %rcx\n");
    s = s.write(".Lmd_kshift:\n");
    s = s.write("    movq %r14, %rax\n");
    s = s.write("    decq %rax\n");
    s = s.write("    cmpq %rax, %rcx\n");
    s = s.write("    jge .Lmd_kdone\n");
    s = s.write("    movq %rcx, %rax\n");
    s = s.write("    addq $2, %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdx\n");
    s = s.write("    movq %rcx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq %rdx, (%r15,%rax,8)\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lmd_kshift\n");
    s = s.write(".Lmd_kdone:\n");
    s = s.write("    movq %r14, %rax\n");
    s = s.write("    decq %rax\n");
    s = s.write("    movq %rax, (%r15)\n");
    s = s.write("    movq 8(%r12), %r15\n");
    s = s.write("    movq %rbx, %rcx\n");
    s = s.write(".Lmd_vshift:\n");
    s = s.write("    movq %r14, %rax\n");
    s = s.write("    decq %rax\n");
    s = s.write("    cmpq %rax, %rcx\n");
    s = s.write("    jge .Lmd_vdone\n");
    s = s.write("    movq %rcx, %rax\n");
    s = s.write("    addq $2, %rax\n");
    s = s.write("    movq (%r15,%rax,8), %rdx\n");
    s = s.write("    movq %rcx, %rax\n");
    s = s.write("    incq %rax\n");
    s = s.write("    movq %rdx, (%r15,%rax,8)\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lmd_vshift\n");
    s = s.write(".Lmd_vdone:\n");
    s = s.write("    movq %r14, %rax\n");
    s = s.write("    decq %rax\n");
    s = s.write("    movq %rax, (%r15)\n");
    s = s.write("    movq $1, %r13\n");
    s = s.write("    jmp .Lmd_build\n");
    s = s.write(".Lmd_notfound:\n");
    s = s.write("    movq $0, %r13\n");
    s = s.write(".Lmd_build:\n");
    s = s.write("    movq $16, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq %r12, (%rax)\n");
    s = s.write("    movq %r13, 8(%rax)\n");
    s = s.write("    popq %r15\n");
    s = s.write("    popq %r14\n");
    s = s.write("    popq %r13\n");
    s = s.write("    popq %r12\n");
    s = s.write("    popq %rbx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".size __fern_map_delete, .-__fern_map_delete\n");
    }

    // __fern_i32_to_string — STACK-arg ABI for the IR path (the i32 value sits
    // at 8(%rsp), below the call's return address). Loads it into %rdi, then runs
    // asm.fern's register-ABI body verbatim (%rdi in → 16-byte string box in
    // %rax). Allocates a 32-byte scratch buffer, writes decimal digits MSB-first
    // (handling 0 / negative with a leading '-'), then a 16-byte box {data,len}.
    if (s.has_need("i32_to_string")) {
        s = s.write("__fn___fern_i32_to_string:\n");
        s = s.write("    movq 8(%rsp), %rdi\n");      // stack arg -> %rdi
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    movq %rdi, %r13\n");          // save value
        s = s.write("    movq $32, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r12\n");          // buf ptr
        s = s.write("    movq %r13, %rax\n");
        s = s.write("    movq $0, %r10\n");            // sign flag
        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jge .Liri2s_pos\n");
        s = s.write("    negq %rax\n");
        s = s.write("    movq $1, %r10\n");
        s = s.write(".Liri2s_pos:\n");
        s = s.write("    leaq 31(%r12), %rsi\n");      // cursor (writes backwards)
        s = s.write("    movq $0, %r8\n");             // digit count
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Liri2s_div\n");
        s = s.write("    movb $48, (%rsi)\n");
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write("    jmp .Liri2s_sign\n");
        s = s.write(".Liri2s_div:\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rcx\n");
        s = s.write("    divq %rcx\n");
        s = s.write("    addq $48, %rdx\n");
        s = s.write("    movb %dl, (%rsi)\n");
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Liri2s_div\n");
        s = s.write(".Liri2s_sign:\n");
        s = s.write("    cmpq $0, %r10\n");
        s = s.write("    je .Liri2s_no_neg\n");
        s = s.write("    movb $45, (%rsi)\n");
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write(".Liri2s_no_neg:\n");
        s = s.write("    incq %rsi\n");                // first char ptr
        s = s.write("    pushq %rsi\n");
        s = s.write("    pushq %r8\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    popq %r8\n");
        s = s.write("    popq %rsi\n");
        s = s.write("    movq %rsi, (%rax)\n");
        s = s.write("    movq %r8, 8(%rax)\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }

    // __fern_str_to_i32 — STACK-arg ABI for the IR path (the string box sits at
    // 8(%rsp)). Loads it into %rdi, then runs asm.fern's register-ABI body
    // verbatim (%rdi = box → %rax = parsed i32). Optional leading '-', decimal
    // digits, stops at the first non-digit; empty box → 0. Allocation-free (all
    // scratch in caller-saved %rcx/%r8/%r9/%r10/%rdx), so no frame / heap.
    if (s.has_need("str_to_i32")) {
        s = s.write("__fn___fern_str_to_i32:\n");
        s = s.write("    movq 8(%rsp), %rdi\n");      // stack arg -> %rdi (string box)
        s = s.write("    movq (%rdi), %rcx\n");        // data ptr
        s = s.write("    movq 8(%rdi), %r8\n");        // len
        s = s.write("    movq %rcx, %r9\n");
        s = s.write("    addq %r8, %r9\n");            // end ptr
        s = s.write("    movq $0, %rax\n");            // accumulator
        s = s.write("    movq $0, %r10\n");            // neg flag
        s = s.write("    cmpq %rcx, %r9\n");
        s = s.write("    je .Lirs2i_done\n");
        s = s.write("    movzbq (%rcx), %rdx\n");
        s = s.write("    cmpq $45, %rdx\n");           // '-'
        s = s.write("    jne .Lirs2i_loop\n");
        s = s.write("    movq $1, %r10\n");
        s = s.write("    incq %rcx\n");
        s = s.write(".Lirs2i_loop:\n");
        s = s.write("    cmpq %rcx, %r9\n");
        s = s.write("    je .Lirs2i_done\n");
        s = s.write("    movzbq (%rcx), %rdx\n");
        s = s.write("    subq $48, %rdx\n");
        s = s.write("    cmpq $0, %rdx\n");
        s = s.write("    jl .Lirs2i_done\n");
        s = s.write("    cmpq $9, %rdx\n");
        s = s.write("    jg .Lirs2i_done\n");
        s = s.write("    imulq $10, %rax\n");
        s = s.write("    addq %rdx, %rax\n");
        s = s.write("    incq %rcx\n");
        s = s.write("    jmp .Lirs2i_loop\n");
        s = s.write(".Lirs2i_done:\n");
        s = s.write("    cmpq $0, %r10\n");
        s = s.write("    je .Lirs2i_no_neg\n");
        s = s.write("    negq %rax\n");
        s = s.write(".Lirs2i_no_neg:\n");
        s = s.write("    ret\n");
    }

    // __fern_chr — STACK-arg ABI for the IR path (the i32 byte value sits at
    // 8(%rsp)). Loads it into %rdi, then runs asm.fern's register-ABI body
    // verbatim: alloc 1 byte for the char data + a 16-byte box, store the low
    // byte + length 1, return the box in %rax. Self-contained (only __fern_alloc
    // from the heap runtime), so no dependency on asm.fern's str_search bundle.
    if (s.has_need("chr")) {
        s = s.write("__fn___fern_chr:\n");
        s = s.write("    movq 8(%rsp), %rdi\n");      // stack arg -> %rdi (byte value)
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    pushq %r12\n");
        s = s.write("    pushq %r13\n");
        s = s.write("    movq %rdi, %r13\n");          // save value
        s = s.write("    movq $1, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %rax, %r12\n");          // buf ptr
        s = s.write("    movb %r13b, (%r12)\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    movq %r12, (%rax)\n");
        s = s.write("    movq $1, 8(%rax)\n");
        s = s.write("    popq %r13\n");
        s = s.write("    popq %r12\n");
        s = s.write("    leave\n");
        s = s.write("    ret\n");
    }

    // Emit the multi-GiB heap reservation LAST so __fern_heap is the final
    // symbol in .bss (the IR path emits no other .bss symbols, but this keeps
    // it byte-identical-in-structure to asm.fern and robust to future ones).
    // Addressed 64-bit-absolute (movabs) so heap_base + heap_size > 2 GiB.
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_heap: .skip 4160749568\n");   // 0xF8000000 (3.875 GiB) — matches asm.fern + the native x86-64 backend
    s = s.write("    .section .text\n");

    return s;
}

// all_eligible reports whether every function in the module is IR-eligible
// AND every direct call targets a function defined in the module (or an IR
// runtime helper). A call to a BUILTIN (read_int / print_int / chr /
// i32_to_string / ...) lowers to call_direct but has no `__fn_<name>` body —
// the IR path can't emit it, so such modules fall back to the AST emitter
// (which handles builtins in emit_expr). The whole module goes one way or the
// other, so a single builtin call disqualifies the IR path for the module.
// eligible_core is the target-independent eligibility check: a non-empty module
// with a `main` where every function is ir_eligible, every direct call targets a
// known function, and every function-VALUE reference (const_func) names a real
// module function. It ALLOWS plain function values (const_func / call_indirect) —
// the wasm backend lowers them (a funcref table). all_eligible adds the
// register-backend restriction on top (they don't emit the closure ops yet).
pub function eligible_core(mod: parser.Module): boolean {
    var none: string[] = [];
    return eligible_core_known(mod, none);
}

// eligible_core_known is eligible_core threaded with the program-wide
// known-symbol set (`known`) — the per-module-compilation foundation
// (#3451 step 1 / #3453). `known` is the set of function symbols defined
// SOMEWHERE in the loaded import graph (every module's `__fn_*`), distinct from
// "defined in THIS module" (module_has_func). Per-module, a call from module A
// to an imported function in B targets `B__foo`, which is not in A's own
// `mod.funcs` but IS in the program-wide set; eligibility must accept it as an
// extern (resolved at link) instead of bailing the module to AST. Passing an
// empty `known` recovers the whole-program merged behaviour exactly (every
// cross-module call is already local in the merged module), so the merged path
// is byte-for-byte unchanged.
pub function eligible_core_known(mod: parser.Module, known: string[]): boolean {
    return eligible_core_known_main(mod, known, true);
}

// all_eligible_lib_known is the per-module LIBRARY eligibility check (#3456): a
// non-entry unit legitimately has no `main` (it exposes only its `__fn_*`
// definitions; the entry owns `_start`/`__fn_main`), so the require_main gate is
// dropped. Otherwise identical to all_eligible_known — every function lowers and
// every call/function-value resolves against the program-wide known set.
pub function all_eligible_lib_known(mod: parser.Module, known: string[]): boolean {
    return eligible_core_known_main(mod, known, false);
}

// all_eligible_lib_known_view is all_eligible_lib_known with the WHOLE-PROGRAM
// func/struct view threaded in (#3451): a per-module library unit whose
// functions touch a sibling module's struct layout lowers in the gate exactly as
// emit_module_funcs lowers it (against all_structs), instead of bailing because
// the imported struct is absent from `mod.structs`. Use this — not the bare
// all_eligible_lib_known — to gate a per-module emit driven off
// flatten.bundle_per_module.
pub function all_eligible_lib_known_view(mod: parser.Module, known: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[]): boolean {
    return eligible_core_known_main_view(mod, known, false, all_funcs, all_structs);
}

// eligible_core_known_main is eligible_core_known with the `main`-required gate
// made optional: require_main=true is the whole-program / entry path (emits
// `_start` → `call __fn_main`, so a module with no main would dangle);
// require_main=false is a per-module library unit, which has no main by design.
pub function eligible_core_known_main(mod: parser.Module, known: string[], require_main: boolean): boolean {
    if (mod.funcs.len() == 0) { return false; }
    // Module-size budget. emit_module_ir lowers every function into ir.Op
    // lists built by repeated `.append`, which grow past the native runtime's
    // 2048 B "large" freelist tier — and that tier currently does NOT recycle
    // (a freed large block never returns to its size class), so each large
    // buffer leaks for the duration of the emit. On a small module that waste
    // is bounded and harmless, but the WHOLE self-host compiler, merged into
    // one ~1000-function module (asm_*_run.fern's flatten.bundle feeds a single
    // emit_module call), leaks enough to march the bump heap past its 3.875 GiB
    // ceiling and exit-137 (#3425). Until the native large-tier freelist is
    // fixed, cap IR routing at a function count that comfortably holds the
    // largest real module (irlower, ~350) yet rejects the merged whole-compiler
    // bundle, so a normal program / module compiles through IR while the
    // bootstrap self-compile of the merged compiler stays on the AST emitter.
    if (mod.funcs.len() > 512) { return false; }
    // emit_module_ir is a WHOLE-PROGRAM emitter: it writes a `_start` that
    // calls `__fn_main` and exits with its return. A module with no `main`
    // (a library compiled standalone, e.g. util.fern under the bootstrap
    // self-compile) has no `__fn_main`, so routing it through the IR path
    // would emit a dangling reference. Such modules stay on the AST emitter,
    // which handles the no-main case (top-level stmts + fallback exit). A
    // per-module library unit (require_main=false) has no main by design.
    if (require_main && !asmcore.has_main(mod)) { return false; }
    // Per-function eligibility lowers fd ONCE and runs all three checks (body
    // lowers / calls-only-known / const-funcs-only-known) on that single
    // LowerResult, rather than re-lowering it three times (ir_eligible +
    // calls_only_known + const_funcs_only_known each lowered independently). On a
    // large all-eligible module the per-function `LowerResult.ops` is retained
    // (the native catch-all dec only decrements, never frees — #3425), so three
    // lowerings per function held ~3x the ops; this single pass + emit_module_ir's
    // own pass keeps the eligibility-check + emit live set to ~2x instead of ~4x.
    var arf: string[] = array_ret_fns(mod);
    // The fourteen return-type / signature side-tables lower_func consults are
    // derived ONCE here and threaded into every func_eligible — mirroring
    // emit_module_ir's #3422 hoist. Previously func_eligible called
    // lower_func_for, which re-derives all fourteen (each an O(n) scan of
    // mod.funcs) on EVERY call, so eligible_core's per-function loop was
    // O(n^2) side-table derivation. On the large self-host modules (parser,
    // ~300 funcs; the flattened compiler, ~1000) that quadratic allocation
    // churned the bump heap hard enough to corrupt it (a freed block reused
    // while still referenced), crashing the self-host-emitted compiler in
    // __fern_str_eq under decl_is_leaksafe during its OWN eligibility pass
    // (#3425). Deriving them once keeps the verdict byte-identical at O(n).
    var bparams: string[] = irlower.borrowable_params_of(mod.funcs);
    var srf: string[] = irlower.str_ret_fns_of(mod.funcs);
    var sarf: string[] = irlower.strarr_ret_fns_of(mod.funcs);
    var amf: string[] = irlower.arr_method_fns_of(mod.funcs);
    var orf: string[] = irlower.opt_ret_fns_of(mod.funcs);
    var irf: string[] = irlower.i64_ret_fns_of(mod.funcs);
    var trf: string[] = irlower.tuple_ret_fns_of(mod.funcs);
    var srtf: string[] = irlower.struct_ret_fns_of(mod.funcs, mod.structs);
    var mrtf: string[] = irlower.map_ret_fns_of(mod.funcs);
    var frf: string[] = irlower.f64_ret_fns_of(mod.funcs);
    var farf: string[] = irlower.f64arr_ret_fns_of(mod.funcs);
    var iarf: string[] = irlower.i64arr_ret_fns_of(mod.funcs);
    var fps: string[] = irlower.fn_param_sigs_of(mod.funcs);
    var cfs: string[] = irlower.closure_ret_fns_of(mod.funcs);
    var cnf: string[] = irlower.const_fns_of(mod.funcs);
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (!func_eligible(mod.funcs[i], mod, mod.structs, known, arf, bparams, srf, sarf, amf, orf, irf, trf, srtf, mrtf, frf, farf, iarf, fps, cfs, cnf)) { return false; }
        i = i + 1;
    }
    return true;
}

// eligible_core_known_main_view is the per-module twin of
// eligible_core_known_main (#3451 — retiring the AST fallback for the bootstrap
// self-compile). Where eligible_core_known_main derives its lowering side-tables
// and struct layouts from the module's OWN funcs/structs — correct for the
// merged whole-program path, where `mod` already holds every decl — a per-module
// LIBRARY unit's `mod` is one module of the program. A function in it that calls
// a sibling module's function (resolved via `known`, an extern at link) OR
// touches a sibling module's STRUCT layout must lower in the gate exactly as it
// does in emit_module_funcs, which lowers every function against the WHOLE-
// PROGRAM `all_funcs` / `all_structs` view (#3454). So this variant mirrors
// emit_module_funcs's derivation precisely: the fourteen return-type side-tables
// + interprocedural borrowability come from `all_funcs`, struct layouts from
// `all_structs`. Without it, every module touching an imported struct (parser →
// lexer.Token, asm → ir.Op, …) fails the gate and bails to AST even though the
// emit would succeed — the central blocker to routing the bootstrap per-module.
//
// Passing all_funcs == mod.funcs and all_structs == mod.structs reproduces
// eligible_core_known_main, modulo the merged path's historical use of
// array_ret_fns / borrowable_params_of (vs the _of / _interproc forms emit
// uses); this variant tracks emit, not that legacy gate, by design.
pub function eligible_core_known_main_view(mod: parser.Module, known: string[], require_main: boolean, all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[]): boolean {
    if (mod.funcs.len() == 0) { return false; }
    // No 512-function size budget here: a per-module unit is a SINGLE module
    // (the largest, irlower, is ~350 funcs), so the merged-bundle OOM the budget
    // guards against (eligible_core_known_main) can't arise — each module is
    // emitted in its own process, holding only its own ops live.
    if (require_main && !asmcore.has_main(mod)) { return false; }
    // Side-tables + struct layouts from the WHOLE-PROGRAM view, exactly as
    // emit_module_funcs derives them (array_ret_fns_of / borrowable_params_interproc
    // / *_of from all_funcs, struct_ret_fns_of against all_structs).
    var arf: string[] = array_ret_fns_of(all_funcs);
    var bparams: string[] = irlower.borrowable_params_interproc(all_funcs);
    var srf: string[] = irlower.str_ret_fns_of(all_funcs);
    var sarf: string[] = irlower.strarr_ret_fns_of(all_funcs);
    var amf: string[] = irlower.arr_method_fns_of(all_funcs);
    var orf: string[] = irlower.opt_ret_fns_of(all_funcs);
    var irf: string[] = irlower.i64_ret_fns_of(all_funcs);
    var trf: string[] = irlower.tuple_ret_fns_of(all_funcs);
    var srtf: string[] = irlower.struct_ret_fns_of(all_funcs, all_structs);
    var mrtf: string[] = irlower.map_ret_fns_of(all_funcs);
    var frf: string[] = irlower.f64_ret_fns_of(all_funcs);
    var farf: string[] = irlower.f64arr_ret_fns_of(all_funcs);
    var iarf: string[] = irlower.i64arr_ret_fns_of(all_funcs);
    var fps: string[] = irlower.fn_param_sigs_of(all_funcs);
    var cfs: string[] = irlower.closure_ret_fns_of(all_funcs);
    var cnf: string[] = irlower.const_fns_of(all_funcs);
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (!func_eligible(mod.funcs[i], mod, all_structs, known, arf, bparams, srf, sarf, amf, orf, irf, trf, srtf, mrtf, frf, farf, iarf, fps, cfs, cnf)) { return false; }
        i = i + 1;
    }
    return true;
}

// known_includes reports whether `name` is in the program-wide known-symbol
// set — a function defined SOMEWHERE in the loaded import graph (any module),
// not necessarily in the current one. It is the cross-module twin of
// module_has_func: together they let per-module eligibility admit a call whose
// target is a sibling module's `__fn_*` symbol (resolved at link) while still
// bailing on a truly-unknown / builtin-only name.
function known_includes(known: string[], name: string): boolean {
    var i: i32 = 0;
    while (i < known.len()) {
        if (known[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// func_eligible is eligible_core's per-function check, folded into ONE lowering:
// the body must lower (r.ok), every direct call must target a module function or
// an IR runtime helper (calls_only_known), and every function-value reference
// must name a module function (const_funcs_only_known). Lowering once with the
// real return-type registries (lower_func_for, as ir_eligible does) is at least
// as accurate as the prior noret scan for call / const_func detection — those op
// kinds carry the callee name regardless of return-type tagging — so the module
// verdict is unchanged, at a third of the lowering cost. `arf` (array_ret_fns) is
// hoisted by the caller so it is derived once per module, not once per function.
function func_eligible(fd: parser.FuncDecl, mod: parser.Module, sview: parser.StructDecl[], known: string[], arf: string[], bparams: string[], srf: string[], sarf: string[], amf: string[], orf: string[], irf: string[], trf: string[], srtf: string[], mrtf: string[], frf: string[], farf: string[], iarf: string[], fps: string[], cfs: string[], cnf: string[]): boolean {
    // lower_func with the hoisted side-tables (the same set lower_func_for would
    // derive, but computed once by eligible_core — see the hoist note there).
    // `sview` is the struct-decl view lowering resolves field layouts against:
    // the module's own structs for the merged/whole-program path, the WHOLE-
    // PROGRAM struct union for a per-module unit (so a function touching an
    // imported struct's layout lowers in the gate exactly as it does in
    // emit_module_funcs, which already lowers against all_structs).
    var r: irlower.LowerResult = irlower.lower_func(fd, arf, sview, srf, sarf, amf, orf, irf, trf, srtf, mrtf, frf, farf, iarf, fps, cfs, cnf, bparams);
    if (!r.ok) { return false; }
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind == "call_direct") {
            if (!is_fern_helper(o.str) && !module_has_func(mod, o.str) && !known_includes(known, o.str)) { return false; }
        } else if (o.kind == "const_func") {
            if (!module_has_func(mod, o.str) && !known_includes(known, o.str)) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// all_eligible is the module eligibility gate for every backend now: it is
// eligible_core. Plain function values (const_func / call_indirect) lower on all
// three IR backends — wasm through a funcref table, the register backends through
// the function's code address (no table needed). (Capturing lambdas are a later
// slice and still bail via lower_func.)
pub function all_eligible(mod: parser.Module): boolean {
    return eligible_core(mod);
}

// all_eligible_known is all_eligible with the program-wide known-symbol set
// threaded in (#3451 step 1): a module whose only "unknown" direct calls /
// function values target functions defined in a SIBLING module of the loaded
// import set is eligible (those become externs at link), where the bare
// all_eligible would bail it to AST. An empty `known` is identical to
// all_eligible.
pub function all_eligible_known(mod: parser.Module, known: string[]): boolean {
    return eligible_core_known(mod, known);
}

// all_eligible_known_view is all_eligible_known with the WHOLE-PROGRAM
// func/struct view threaded in (#3451): the entry-unit twin of
// all_eligible_lib_known_view (require_main=true — the entry emits `_start` →
// `call __fn_main`). Gates a per-module ENTRY emit against the same all_funcs /
// all_structs view emit_module_ir_unit lowers it with.
pub function all_eligible_known_view(mod: parser.Module, known: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[]): boolean {
    return eligible_core_known_main_view(mod, known, true, all_funcs, all_structs);
}

// eligibility_report returns a per-function IR-eligibility breakdown for `mod`:
// one line per function — "<name>: ir" when it lowers AND its direct calls /
// function-value references all resolve, or "<name>: BAIL <reasons>" naming
// which gate(s) failed (`lower` = lower_func bailed the body; `call` = a direct
// call targets a builtin / unknown function; `const_func` = a function-value
// names an unknown function). The final line is the module verdict
// ("module: IR" / "module: AST"), including the no-main / empty-module cases
// all_eligible rejects.
//
// Read-only: it runs exactly the checks eligible_core / all_eligible route on,
// so it observes the real IR-vs-AST frontier the driver uses — without touching
// any emit path. It makes that frontier OBSERVABLE per function, so widening the
// IR subset (goal 1) can see WHICH function, and which category, forces a module
// to the AST fallback, and prove a construct moved onto the IR path.
pub function eligibility_report(mod: parser.Module): string {
    var none: string[] = [];
    return eligibility_report_known(mod, none);
}

// eligibility_report_known is eligibility_report with the program-wide
// known-symbol set threaded in (#3451 step 1): a direct call / function value
// to a sibling module's function reports `ir` (extern, resolved at link)
// instead of `BAIL call` / `BAIL const_func`, and the module verdict reflects
// all_eligible_known. An empty `known` reproduces eligibility_report exactly.
pub function eligibility_report_known(mod: parser.Module, known: string[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        out = out + eligibility_line(mod.funcs[i], mod, known);
        i = i + 1;
    }
    var verdict: string = "module: AST";
    if (all_eligible_known(mod, known)) { verdict = "module: IR"; }
    return out + verdict + "\n";
}

// eligibility_line is the single-function verdict line ("<name>: ir\n" or
// "<name>: BAIL <reasons>\n") shared by eligibility_report and its sharded
// twin. A receiver method is reported as "<Type>.<method>".
function eligibility_line(fd: parser.FuncDecl, mod: parser.Module, known: string[]): string {
    var name: string = fd.name;
    if (fd.receiver_type.len() > 0) { name = util.base_type_name(fd.receiver_type) + "." + fd.name; }
    var lower_ok: boolean = ir_eligible(fd, mod);
    var calls_ok: boolean = calls_only_known(fd, mod, known);
    var cfns_ok: boolean = const_funcs_only_known(fd, mod, known);
    if (lower_ok && calls_ok && cfns_ok) {
        return name + ": ir\n";
    }
    var reasons: string = "";
    if (!lower_ok) { reasons = reasons + " lower"; }
    if (!calls_ok) { reasons = reasons + " call"; }
    if (!cfns_ok) { reasons = reasons + " const_func"; }
    return name + ": BAIL" + reasons + "\n";
}

// eligibility_report_range is the sharded form of eligibility_report: it reports
// only functions [start, start+count) of `mod`, one verdict line each, with NO
// "module:" verdict (that requires re-lowering every function via all_eligible).
// The whole-module report lowers every function up-front and accumulates the ops
// in the bump heap, which exhausts it on the large self-host modules
// (parser / checker / irlower); auditing a slice per process invocation keeps
// each run's live set bounded, so the frontier of those modules stays
// observable. The first shard (start == 0) prefixes a "funcs: <N>\n" header so a
// caller can discover the function count and drive the sharding loop. A start
// past the end yields just that header (or nothing); count <= 0 reports to the
// module end.
pub function eligibility_report_range(mod: parser.Module, start: i32, count: i32): string {
    var out: string = "";
    if (start <= 0) { out = "funcs: " + util.i32_to_string(mod.funcs.len()) + "\n"; }
    var lo: i32 = start;
    if (lo < 0) { lo = 0; }
    var hi: i32 = mod.funcs.len();
    if (count > 0 && lo + count < hi) { hi = lo + count; }
    var i: i32 = lo;
    var none: string[] = [];
    while (i < hi) {
        out = out + eligibility_line(mod.funcs[i], mod, none);
        i = i + 1;
    }
    return out;
}

// const_funcs_only_known reports whether every function-value reference
// (const_func) in fd names a function defined in the module — the function-value
// twin of calls_only_known. A const_func to an unknown name can't resolve to a
// funcref table slot, so such modules fall back to AST.
function const_funcs_only_known(fd: parser.FuncDecl, mod: parser.Module, known: string[]): boolean {
    var r: irlower.LowerResult = irlower.lower_func_for_noret(fd, mod.structs, mod.funcs);
    var i: i32 = 0;
    while (i < r.ops.len()) {
        if (r.ops[i].kind == "const_func" && !module_has_func(mod, r.ops[i].str) && !known_includes(known, r.ops[i].str)) { return false; }
        i = i + 1;
    }
    return true;
}

// module_has_func reports whether `name` is a function defined in the module.
function module_has_func(mod: parser.Module, name: string): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].name == name) { return true; }
        // Method-call form "<Type>.<method>": a receiver function whose base
        // receiver type + name compose to `name` (the irlower dispatch label).
        if (mod.funcs[i].receiver_type.len() > 0) {
            if (util.base_type_name(mod.funcs[i].receiver_type) + "." + mod.funcs[i].name == name) { return true; }
        }
        i = i + 1;
    }
    return false;
}

// calls_only_known reports whether every direct call in fd targets a module
// function or an IR runtime helper (not a builtin).
function calls_only_known(fd: parser.FuncDecl, mod: parser.Module, known: string[]): boolean {
    var r: irlower.LowerResult = irlower.lower_func_for_noret(fd, mod.structs, mod.funcs);
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind == "call_direct") {
            if (!is_fern_helper(o.str) && !module_has_func(mod, o.str) && !known_includes(known, o.str)) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// ir_bin_asm renders the asm for one IR binary op (lhs in %rax, rhs in %rcx,
// result in %rax) — mirroring asm.fern's own ExprBinary sequences (64-bit,
// signed i32 div/cmp) so the two paths agree exactly.
function ir_bin_asm(kind: string, width: i32): string {
    if (kind == "add") { return "    addq %rcx, %rax\n"; }
    if (kind == "sub") { return "    subq %rcx, %rax\n"; }
    if (kind == "mul") { return "    imulq %rcx, %rax\n"; }
    // i64 div/rem operate on the full 64-bit operands (no movslq truncation);
    // i32 div/rem sign-extend the low 32 first so dirty upper bits don't skew
    // the 64-bit idivq.
    if (kind == "div_s" && width == 64) { return "    cqto\n    idivq %rcx\n"; }
    if (kind == "rem_s" && width == 64) { return "    cqto\n    idivq %rcx\n    movq %rdx, %rax\n"; }
    if (kind == "div_s") { return "    movslq %eax, %rax\n    movslq %ecx, %rcx\n    cqto\n    idivq %rcx\n"; }
    if (kind == "rem_s") { return "    movslq %eax, %rax\n    movslq %ecx, %rcx\n    cqto\n    idivq %rcx\n    movq %rdx, %rax\n"; }
    // Unsigned 64-bit div/rem (u64, #2904): zero RDX, divq (no sign-extend). The
    // operands are full 64-bit u64 values, so no movslq truncation.
    if (kind == "div_u") { return "    xorl %edx, %edx\n    divq %rcx\n"; }
    if (kind == "rem_u") { return "    xorl %edx, %edx\n    divq %rcx\n    movq %rdx, %rax\n"; }
    if (kind == "and") { return "    andq %rcx, %rax\n"; }
    if (kind == "or") { return "    orq %rcx, %rax\n"; }
    if (kind == "xor") { return "    xorq %rcx, %rax\n"; }
    if (kind == "shl") { return "    shlq %cl, %rax\n"; }
    if (kind == "shr_s") { return "    sarq %cl, %rax\n"; }
    if (kind == "shr_u") { return "    shrq %cl, %rax\n"; }
    if (kind == "eq") { return "    cmpq %rcx, %rax\n    sete %al\n    movzbq %al, %rax\n"; }
    if (kind == "ne") { return "    cmpq %rcx, %rax\n    setne %al\n    movzbq %al, %rax\n"; }
    if (kind == "lt_s") { return "    cmpq %rcx, %rax\n    setl %al\n    movzbq %al, %rax\n"; }
    if (kind == "le_s") { return "    cmpq %rcx, %rax\n    setle %al\n    movzbq %al, %rax\n"; }
    if (kind == "gt_s") { return "    cmpq %rcx, %rax\n    setg %al\n    movzbq %al, %rax\n"; }
    if (kind == "ge_s") { return "    cmpq %rcx, %rax\n    setge %al\n    movzbq %al, %rax\n"; }
    // Unsigned 64-bit compares (u64, #2904): same cmpq, but the below/above
    // setcc family reads CF instead of SF/OF — correct once bit 63 is set.
    if (kind == "lt_u") { return "    cmpq %rcx, %rax\n    setb %al\n    movzbq %al, %rax\n"; }
    if (kind == "le_u") { return "    cmpq %rcx, %rax\n    setbe %al\n    movzbq %al, %rax\n"; }
    if (kind == "gt_u") { return "    cmpq %rcx, %rax\n    seta %al\n    movzbq %al, %rax\n"; }
    if (kind == "ge_u") { return "    cmpq %rcx, %rax\n    setae %al\n    movzbq %al, %rax\n"; }
    return "    # ir: unsupported bin " + kind + "\n";
}

// br_target resolves a `br d` / `br_if d` at op index `i` to its label: a
// loop scope -> its header label (the loop op's index); a block/if scope ->
// the label at its matching `end`. Uses irlower's nesting scanners — no
// threaded scope-stack state (a self-host-robust formulation; the earlier
// grow-and-overwrite string[] scope arrays mis-ran under the self-hosted
// compiler).
pub function br_target(ops: ir.Op[], lp: string, i: i32, d: i32): string {
    var op: i32 = irlower.enclosing_opener(ops, i, d);
    if (ops[op].kind == "loop") { return lp + util.i32_to_string(op); }
    return lp + util.i32_to_string(irlower.find_matching_end(ops, op + 1));
}

// emit_str_op emits one string operand-stack op (the bodies factored out of
// emit_function_via_ir's dispatch — see ir.is_str_op_kind). Each pops its box
// operand(s), calls the matching __fern_str_* runtime, and pushes the result;
// the mark_* needs pull in the helper bodies (emit_ir_runtime / emit_ir_str_search).
// str_lit_label builds the `.rodata` label for string-literal `idx`, honouring
// the per-module namespace (`s.str_ns`): empty → `.S<idx>` (byte-identical to
// the whole-program emitter), non-empty → `.S<ns>_<idx>` so separately-emitted
// modules' string pools don't collide at link (#3451 step 3 / #3455). The SAME
// label is used at the definition site (.rodata) and every `leaq` reference, so
// the box's data pointer resolves within the module.
pub function str_lit_label(s: asmcore.EmitState, idx: i32): string {
    if (s.str_ns.len() == 0) { return ".S" + util.i32_to_string(idx); }
    return ".S" + s.str_ns + "_" + util.i32_to_string(idx);
}

// ShapeRefOut carries the updated state + the label a shape pointer leaqs.
pub struct ShapeRefOut { state: asmcore.EmitState, label: string }

// shape_ref resolves the label for an enum/struct SHAPE pointer (struct_make /
// variant_is / struct_set_shape / dyn dispatch / downcast). On the whole-program
// path (str_ns == "") a shape is interned as an ordinary string literal — the
// pre-per-module behaviour, byte-identical. Per-module (str_ns != ""), a shape is
// a `.weak` global symbol (shape_sym): the SAME shape referenced in two units
// resolves to ONE linker-merged address, so the pointer-equality shape compare
// (a token constructed in the lexer unit, matched in the parser unit) holds
// across the module boundary. Without this every cross-module enum `match` (e.g.
// the parser matching lexer's token variants) silently fails — the self-build
// miscompile #3451's per-module bootstrap hit.
pub function shape_ref(s: asmcore.EmitState, name: string): ShapeRefOut {
    if (s.str_ns.len() == 0) {
        var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, name);
        return ShapeRefOut { state: lo.state, label: str_lit_label(lo.state, lo.idx) };
    }
    return ShapeRefOut { state: asmcore.add_shape_lit(s, name), label: asmcore.shape_sym(name) };
}

// emit_runtime_globls exports the shared `__fern_*` / `__fn___fern_*` runtime
// entry points `.globl` so a library module's `call __fern_alloc` (etc.) — an
// unresolved extern in that module — links against the single copy the entry
// module emits (#3451 step 3 / #3455). Only the entry calls this (it owns the
// runtime). A `.globl` for a symbol the entry doesn't actually define (its need
// wasn't present) is a harmless UND entry as long as nothing references it; a
// symbol the entry DOES define is exported. This is emitted only in per-module
// mode (globl_defs) — the whole-program emitter never calls it, so its output
// is unchanged.
pub function emit_runtime_globls(s: asmcore.EmitState): asmcore.EmitState {
    var names: string[] = [
        "__fern_alloc", "__fern_alloc_u8", "__fern_arr_box", "__fern_arr_push",
        "__fern_arr_slice", "__fern_str_concat", "__fern_str_eq", "__fern_str_cmp",
        "__fern_string_from_bytes", "__fern_str_bytes", "__fern_str_chars",
        "__fern_str_lines", "__fern_str_split", "__fern_str_repeat",
        "__fern_str_replace", "__fern_str_reverse", "__fern_str_trim",
        "__fern_str_to_lower", "__fern_str_to_upper", "__fern_str_starts_with",
        "__fern_str_ends_with", "__fern_str_index_of", "__fern_print_str",
        "__fern_print_int", "__fern_eprint_str", "__fern_putchar",
        "__fern_read_int", "__fern_read_line", "__fern_read_file",
        "__fern_args", "__fern_arg_at", "__fern_strbuf_append",
        "__fern_strbuf_reset", "__fern_strbuf_take", "__fern_random_i32",
        "__fern_random_bytes", "__fern_monotonic_ns", "__fern_now_ns",
        "__fern_now_unix_ms", "__fern_sleep_ms", "__fern_map_new",
        "__fern_map_set", "__fern_map_get", "__fern_map_has", "__fern_map_delete",
        "__fn___fern_rc_inc", "__fn___fern_arr_dec", "__fn___fern_rc_is_unique",
        "__fn___fern_rc_underflow_count", "__fn___fern_i32_to_string",
        "__fn___fern_str_to_i32", "__fn___fern_chr"
    ];
    var i: i32 = 0;
    while (i < names.len()) {
        s = s.write(".globl " + names[i] + "\n");
        i = i + 1;
    }
    return s;
}

function emit_str_op(o: ir.Op, s: asmcore.EmitState): asmcore.EmitState {
    if (o.kind == "str_len") {
        // pop string box; length is at box+8.
        return s.write("    popq %rax\n    movq 8(%rax), %rax\n    pushq %rax\n");
    }
    if (o.kind == "str_index") {
        // pop index (top), string box; box = [data@0, len@8], so the byte is
        // at [data + i]; zero-extend to an i32.
        return s.write("    popq %rcx\n    popq %rax\n    movq (%rax), %rax\n    movzbl (%rax,%rcx), %eax\n    pushq %rax\n");
    }
    if (o.kind == "str_slice") {
        // operand stack [src box, start, end] (end on top). Zero-copy view:
        // a fresh 16-byte box [data = src.data + start, len = end - start]
        // sharing the source bytes. r12/r13/r14 (callee-saved) hold end/start/
        // src across __fern_alloc (transcribed from asm.fern's ExprSlice).
        s = s.write("    popq %r8\n    popq %rcx\n    popq %rdx\n");
        s = s.write("    pushq %r12\n    pushq %r13\n    pushq %r14\n");
        s = s.write("    movq %r8, %r12\n    movq %rcx, %r13\n    movq %rdx, %r14\n");
        s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
        s = s.write("    movq (%r14), %rcx\n    addq %r13, %rcx\n    movq %rcx, (%rax)\n");
        s = s.write("    movq %r12, %rcx\n    subq %r13, %rcx\n    movq %rcx, 8(%rax)\n");
        return s.write("    popq %r14\n    popq %r13\n    popq %r12\n    pushq %rax\n");
    }
    if (o.kind == "str_bytes") {
        // operand stack [str box]; __fern_str_bytes(%rdi=box) -> fresh u8[] in %rax.
        s = s.write("    popq %rdi\n    call __fern_str_bytes\n    pushq %rax\n");
        return s.mark_str_bytes();
    }
    if (o.kind == "str_split") {
        // operand stack [haystack box, sep box] (sep on top);
        // __fern_str_split(%rdi=haystack, %rsi=sep) -> fresh string[] in %rax.
        s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_split\n    pushq %rax\n");
        return s.mark_str_split();
    }
    if (o.kind == "str_to_upper" || o.kind == "str_to_lower") {
        // operand stack [s box]; __fern_str_to_upper/_lower(%rdi=s) -> fresh
        // cased string box in %rax (emit_ir_str_case provides the bodies).
        var cfn: string = "__fern_str_to_upper";
        if (o.kind == "str_to_lower") { cfn = "__fern_str_to_lower"; }
        s = s.write("    popq %rdi\n    call " + cfn + "\n    pushq %rax\n");
        return s.mark_str_case();
    }
    if (o.kind == "str_repeat") {
        // operand stack [s box, n] (n on top); __fern_str_repeat(%rdi=s, %rsi=n)
        // -> fresh string box in %rax (emit_ir_str_repeat provides the body).
        s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_repeat\n    pushq %rax\n");
        return s.mark_str_repeat();
    }
    if (o.kind == "str_trim") {
        // operand stack [s box]; __fern_str_trim(%rdi=s) -> fresh string box in
        // %rax (emit_ir_str_trim provides the body).
        s = s.write("    popq %rdi\n    call __fern_str_trim\n    pushq %rax\n");
        return s.mark_str_trim();
    }
    if (o.kind == "str_reverse") {
        // operand stack [s box]; __fern_str_reverse(%rdi=s) -> fresh reversed
        // string box in %rax (emit_ir_str_reverse provides the body).
        s = s.write("    popq %rdi\n    call __fern_str_reverse\n    pushq %rax\n");
        return s.mark_str_reverse();
    }
    if (o.kind == "str_replace") {
        // operand stack [haystack, old, new] (new on top); __fern_str_replace(
        // %rdi=haystack, %rsi=old, %rdx=new) -> fresh string box in %rax
        // (emit_ir_str_replace provides the body).
        s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    call __fern_str_replace\n    pushq %rax\n");
        return s.mark_str_replace();
    }
    if (o.kind == "str_chars") {
        // operand stack [s box]; __fern_str_chars(%rdi=s) -> fresh string[] in
        // %rax (emit_ir_str_chars provides the body).
        s = s.write("    popq %rdi\n    call __fern_str_chars\n    pushq %rax\n");
        return s.mark_str_chars();
    }
    if (o.kind == "str_lines") {
        // operand stack [s box]; __fern_str_lines(%rdi=s) -> fresh string[] in
        // %rax. The helper calls __fern_str_split, so pull in str_split too.
        s = s.write("    popq %rdi\n    call __fern_str_lines\n    pushq %rax\n");
        return s.mark_str_lines().mark_str_split();
    }
    if (o.kind == "str_starts_with" || o.kind == "str_ends_with" || o.kind == "str_index_of") {
        // operand stack [s box, p box] (p on top); __fern_str_<pred>(%rdi=s,
        // %rsi=p) -> 0/1 (starts/ends) or first index / -1 (index_of) in %rax.
        // Allocation-free str_search predicates (helpers in emit_ir_str_search).
        var pfn: string = "__fern_str_starts_with";
        if (o.kind == "str_ends_with") { pfn = "__fern_str_ends_with"; }
        if (o.kind == "str_index_of") { pfn = "__fern_str_index_of"; }
        s = s.write("    popq %rsi\n    popq %rdi\n    call " + pfn + "\n    pushq %rax\n");
        return s.mark_str_search();
    }
    if (o.kind == "str_concat") {
        // operand stack: [box A, box B] (B on top). __fern_str_concat takes
        // %rdi = A, %rsi = B and returns the fresh box in %rax.
        s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_concat\n    pushq %rax\n");
        return s.mark_str_concat();
    }
    if (o.kind == "str_eq") {
        // operand stack: [box A, box B]; __fern_str_eq(%rdi=A, %rsi=B) -> 0/1.
        s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_eq\n    pushq %rax\n");
        return s.mark_str_eq();
    }
    // str_cmp: operand stack [box A, box B]; __fern_str_cmp(%rdi=A, %rsi=B) ->
    // signed -/0/+ in %rax (lexicographic, length tiebreak).
    s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_str_cmp\n    pushq %rax\n");
    return s.mark_str_cmp();
}

// emit_function_via_ir emits one IR-eligible function via the stack IR,
// writing through the global strbuf (same as asm.fern's emitters).
// arr_ret_fns drives move-on-return / move-from-call for array values.
function emit_function_via_ir(fd: parser.FuncDecl, arr_ret_fns: string[], s: asmcore.EmitState, borrowable_params: string[], str_ret_fns: string[], strarr_ret_fns: string[], arr_method_fns: string[], opt_ret_fns: string[], i64_ret_fns: string[], tuple_ret_fns: string[], struct_ret_fns: string[], map_ret_fns: string[], f64_ret_fns: string[], f64arr_ret_fns: string[], i64arr_ret_fns: string[], fn_param_sigs: string[], closure_fns: string[], const_fns: string[]): asmcore.EmitState {
    var r: irlower.LowerResult = irlower.lower_func(fd, arr_ret_fns, s.struct_decls, str_ret_fns, strarr_ret_fns, arr_method_fns, opt_ret_fns, i64_ret_fns, tuple_ret_fns, struct_ret_fns, map_ret_fns, f64_ret_fns, f64arr_ret_fns, i64arr_ret_fns, fn_param_sigs, closure_fns, const_fns, borrowable_params);

    // Runtime-need detection, folded into the per-function lowering the emit loop
    // ALREADY performs. The tail used to re-derive these by re-lowering the WHOLE
    // module twice (module_uses_maps / module_uses_heap, each a full second/third
    // lower_func_for_noret pass over all funcs) — on a large module (the whole
    // self-host compiler, ~1000 funcs) those redundant passes blew the bump heap
    // (#3425: each retained pass's per-function ops pushed peak live set past the
    // ~3.875 GiB ceiling and OOM'd the self-compile). Marking the needs here off
    // the ops we just lowered keeps it to a SINGLE lowering pass; the tail reads
    // the accumulated needs (has_need) instead of re-lowering. Byte-identical
    // output: the runtime is still emitted at the tail gated on the same needs.
    //
    // Read `.kind` off the bound Op struct INLINE rather than via a `var dk:
    // string = ...kind` local: a named string local aliasing a struct field and
    // dec'd at each loop-iteration boundary rides arm64's deferred native heap-
    // string reclamation path (RC-PERCEUS slice 5g), which over-releases under
    // allocation pressure and crashed the arm64-compiled driver. The inline read
    // (matching the op-emission loop below, which never binds `.kind` to its own
    // local) keeps the string a transient the comparison consumes immediately.
    var dop: i32 = 0;
    while (dop < r.ops.len()) {
        var dopop: ir.Op = r.ops[dop];
        if (dopop.kind == "map_new" || dopop.kind == "map_set" || dopop.kind == "map_len") { s = s.need("maps"); }
        if (ir.op_allocates(dopop.kind)) { s = s.need("heap"); }
        dop = dop + 1;
    }

    // Methods get the receiver-type-qualified label `__fn_<Type>.<name>` (matching
    // asm.fern + irlower's dispatch); free functions stay `__fn_<name>`.
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) { label_name = util.base_type_name(fd.receiver_type) + "." + fd.name; }
    s = s.write("__fn_" + asmcore.sanitize_label(label_name) + ":\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    var frame: i32 = r.n_locals * 8;
    if (frame % 16 != 0) { frame = frame + 8; }
    if (frame > 0) { s = s.write("    subq $" + util.i32_to_string(frame) + ", %rsp\n"); }

    // Zero-init the body-local slots (Perceus exit-sweep safety, matching
    // asm.fern): a `var` decl skipped on an untaken branch leaves its slot
    // readable by the release sweep, which must see NULL (arr_dec no-ops)
    // rather than stack garbage. Body locals are slots [n_params, n_locals);
    // slot i is at -8*(i+1)(%rbp), so the range's lowest address is
    // -8*n_locals(%rbp) and it holds (n_locals - n_params) quadwords. rep
    // stosq clobbers rax/rcx/rdi, dead here (before the param copy).
    var nbody: i32 = r.n_locals - r.n_params;
    if (nbody > 0) {
        s = s.write("    leaq " + util.i32_to_string(0 - r.n_locals * 8) + "(%rbp), %rdi\n");
        s = s.write("    movq $" + util.i32_to_string(nbody) + ", %rcx\n");
        s = s.write("    xorq %rax, %rax\n");
        s = s.write("    cld\n");
        s = s.write("    rep stosq\n");
    }

    // Copy params from the caller stack into their local slots, exactly as
    // emit_function does: param[i] sits at +(16 + i*8)(%rbp); the IR's
    // load_local i reads -8*(i+1)(%rbp). r.n_params counts the receiver (slot 0)
    // for a method, so the receiver — which the caller passes as arg 0 at
    // +16(%rbp) — copies into slot 0 uniformly with the rest of the params.
    var pidx: i32 = 0;
    while (pidx < r.n_params) {
        s = s.write("    movq " + util.i32_to_string(16 + pidx * 8) + "(%rbp), %rax\n");
        s = s.write("    movq %rax, " + util.i32_to_string(0 - 8 * (pidx + 1)) + "(%rbp)\n");
        pidx = pidx + 1;
    }

    // Structured control flow -> flat labels, derived from OP-STREAM INDICES
    // (no threaded scope stack): the label at op index `j` is `lp<j>`. An `if`
    // jumps to its matching `else` (or `end`); `else`/`loop`/`end` define the
    // label at their own index; `br`/`br_if` resolve via br_target. Branch
    // matching reuses irlower's nesting scanners.
    var lp: string = ".Lir_" + asmcore.sanitize_label(label_name) + "_";
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind == "const_i32") {
            s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rax\n    pushq %rax\n");
        } else if (o.kind == "const_i32_text") {
            // Integer literal source text spliced into a 32-bit immediate (hex /
            // full u32 range) — byte-identical to asm.fern's ExprNumber.
            s = s.write("    movq $" + o.str + ", %rax\n    pushq %rax\n");
        } else if (o.kind == "const_i64") {
            // 64-bit immediate (source text): movabsq handles the full range.
            // i64 add/sub/mul/cmp/bitwise then reuse the existing 64-bit-register
            // bin ops unchanged — only the load differs from i32.
            s = s.write("    movabsq $" + o.str + ", %rax\n    pushq %rax\n");
        } else if (o.kind == "int_extend" || o.kind == "int_wrap") {
            // i32<->i64 in 64-bit slots: signed -> sign-extend low 32 (movslq),
            // unsigned -> zero-extend low 32 (movl). Same sequence either way.
            s = s.write("    popq %rax\n");
            if (o.unsigned) { s = s.write("    movl %eax, %eax\n"); }
            else { s = s.write("    movslq %eax, %rax\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "u32_wrap") {
            // Reduce to the u32 range (zero-extend low 32) — wraps a u32 arith
            // result at 2^32 on this 64-bit-register backend.
            s = s.write("    popq %rax\n    movl %eax, %eax\n    pushq %rax\n");
        } else if (o.kind == "int_cast") {
            // `x as <ty>` int→int width mask/extend — byte-identical to asm.fern.
            s = s.write("    popq %rax\n");
            if (o.str == "u8") { s = s.write("    andq $255, %rax\n"); }
            else if (o.str == "u16") { s = s.write("    andq $65535, %rax\n"); }
            else if (o.str == "u32") { s = s.write("    movl %eax, %eax\n"); }
            else if (o.str == "i8") { s = s.write("    movsbq %al, %rax\n"); }
            else if (o.str == "i16") { s = s.write("    movswq %ax, %rax\n"); }
            else if (o.str == "i32") { s = s.write("    movslq %eax, %rax\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "arr_push" || o.kind == "arr_push_i64" || o.kind == "arr_push_f64") {
            // [arr, val] -> grown array. __fern_arr_push(%rdi=arr, %rsi=val). Every
            // array slot is 8 bytes here, so the i64/u64/f64 element rides the SAME
            // helper (the popped operand-stack slot already holds the full 8-byte
            // value); only wasm needs a distinct 8-byte-stride push.
            s = s.write("    popq %rsi\n    popq %rdi\n    call __fern_arr_push\n    pushq %rax\n");
            s = s.mark_arr_push();
        } else if (o.kind == "alloc_u8") {
            // [n] -> fresh n-element array. __fern_alloc_u8(%rdi=n).
            s = s.write("    popq %rdi\n    call __fern_alloc_u8\n    pushq %rax\n");
            s = s.need("heap").need("alloc_u8");
        } else if (o.kind == "str_from_bytes") {
            // [arr] -> string box packing each slot's low byte.
            s = s.write("    popq %rdi\n    call __fern_string_from_bytes\n    pushq %rax\n");
            s = s.need("heap").need("str_from_bytes");
        } else if (o.kind == "memcpy") {
            // [dst, src, n] -> copy n bytes src->dst (rep movsb), push dummy 0.
            // n is on top, then src, then dst (the lowering order). Mirrors the
            // AST __memcpy emitter in asm.fern.
            s = s.write("    popq %rcx\n    popq %rsi\n    popq %rdi\n    rep movsb\n    pushq $0\n");
        } else if (o.kind == "load_i32") {
            // [addr] -> sign-extended 4-byte load (matches __fn___load_i32).
            s = s.write("    popq %rax\n    movslq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "load_i64" || o.kind == "load_ptr") {
            // [addr] -> 8-byte load (ptr is heap-pointer width = 8 on x86-64).
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "store_i32") {
            // [addr, val] -> store low 4 bytes; push dummy 0 (val on top).
            s = s.write("    popq %rcx\n    popq %rax\n    movl %ecx, (%rax)\n    pushq $0\n");
        } else if (o.kind == "store_ptr") {
            // [addr, val] -> store 8 bytes; push dummy 0.
            s = s.write("    popq %rcx\n    popq %rax\n    movq %rcx, (%rax)\n    pushq $0\n");
        } else if (o.kind == "load_local") {
            s = s.write("    pushq " + util.i32_to_string(0 - 8 * (o.i32_imm + 1)) + "(%rbp)\n");
        } else if (o.kind == "store_local") {
            s = s.write("    popq %rax\n    movq %rax, " + util.i32_to_string(0 - 8 * (o.i32_imm + 1)) + "(%rbp)\n");
        } else if (o.kind == "not") {
            s = s.write("    popq %rax\n    testq %rax, %rax\n    setz %al\n    movzbq %al, %rax\n    pushq %rax\n");
        } else if (o.kind == "return") {
            s = s.write("    popq %rax\n    leave\n    ret\n");
        } else if (o.kind == "if") {
            // jump to the matching else (if any) or end when the cond is false.
            var elseidx: i32 = irlower.find_matching_else(r.ops, i + 1);
            var tgt: string = "";
            if (elseidx >= 0) { tgt = lp + util.i32_to_string(elseidx); }
            else { tgt = lp + util.i32_to_string(irlower.find_matching_end(r.ops, i + 1)); }
            s = s.write("    popq %rax\n    testq %rax, %rax\n    jz " + tgt + "\n");
        } else if (o.kind == "else") {
            // end of the then-arm jumps past the else; land the false path here.
            s = s.write("    jmp " + lp + util.i32_to_string(irlower.find_matching_end(r.ops, i + 1)) + "\n");
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else if (o.kind == "block") {
            // forward scope: its exit label is defined at the matching `end`.
        } else if (o.kind == "loop") {
            // backward scope: header label, branched to by `br`.
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else if (o.kind == "br") {
            s = s.write("    jmp " + br_target(r.ops, lp, i, o.i32_imm) + "\n");
        } else if (o.kind == "brif") {
            s = s.write("    popq %rax\n    testq %rax, %rax\n    jnz " + br_target(r.ops, lp, i, o.i32_imm) + "\n");
        } else if (o.kind == "arr_make") {
            // n element values on the operand stack (element n-1 on top).
            // asm.fern 8-byte layout via __fern_arr_box: data = base+16, rc=1,
            // len=n, element i at data+(i+1)*8. Pop top-down (element n-1 →
            // slot n .. element 0 → slot 1); base stays live in %rax across the
            // pops (they only touch the operand stack), then push it.
            var n: i32 = o.i32_imm;
            s = s.write("    movq $" + util.i32_to_string(n) + ", %rdi\n");
            s = s.write("    call __fern_arr_box\n");
            var em: i32 = n - 1;
            while (em >= 0) {
                s = s.write("    popq %rcx\n    movq %rcx, " + util.i32_to_string((em + 1) * 8) + "(%rax)\n");
                em = em - 1;
            }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "arr_get") {
            // pop idx (top), base; element at data+(idx+1)*8.
            s = s.write("    popq %rcx\n    popq %rax\n    incq %rcx\n    movq (%rax,%rcx,8), %rax\n    pushq %rax\n");
        } else if (o.kind == "arr_set") {
            // pop val (top), idx, base; store at data+(idx+1)*8.
            s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n    incq %rcx\n    movq %rdx, (%rax,%rcx,8)\n");
        } else if (o.kind == "arr_len") {
            // pop base; length header at data+0.
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "arr_rc") {
            // pop base; 32-bit refcount field at data-8.
            s = s.write("    popq %rax\n    movl -8(%rax), %eax\n    pushq %rax\n");
        } else if (o.kind == "const_str") {
            // String literal: intern the bytes in .rodata, allocate a 16-byte
            // box `[data_ptr@0, len@8]`, push the box ptr — byte-identical to
            // asm.fern's ExprString so __fern_str_concat / _eq see the same
            // layout. Strings are not RC'd (no header), so they leak (matching
            // the AST path; fine for short-lived programs).
            var lo: asmcore.StringLitOut = asmcore.add_string_lit(s, o.str);
            s = lo.state;
            s = s.write("    movq $16, %rdi\n");
            s = s.write("    call __fern_alloc\n");
            s = s.write("    leaq " + str_lit_label(s, lo.idx) + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            s = s.write("    movq $" + util.i32_to_string(o.str.len()) + ", %rcx\n");
            s = s.write("    movq %rcx, 8(%rax)\n");
            s = s.write("    pushq %rax\n");
        } else if (ir.is_str_op_kind(o.kind)) {
            // All string operand-stack ops (len/index/slice/bytes/split/
            // predicates/concat/eq/cmp) are emitted by emit_str_op — factored out
            // to keep this dispatch under the oversized-function threshold (#2720).
            s = emit_str_op(o, s);
        } else if (o.kind == "arr_slice") {
            // operand stack [arr, start, end]; __fern_arr_slice(%rdi=arr,
            // %rsi=start, %rdx=end) -> fresh array in %rax (copies elements).
            s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    call __fern_arr_slice\n    pushq %rax\n");
            s = s.mark_arr_slice();
        } else if (o.kind == "random_bytes") {
            // operand stack [n]; __fern_random_bytes(%rdi=n) -> string box in %rax.
            s = s.write("    popq %rdi\n    call __fern_random_bytes\n    pushq %rax\n");
            s = s.need("heap").need("random_bytes");
        } else if (o.kind == "random_i32") {
            // no operands; __fern_random_i32() -> i32 in %rax.
            s = s.write("    call __fern_random_i32\n    pushq %rax\n");
            s = s.need("random_i32");
        } else if (o.kind == "monotonic_ns") {
            // no operands; __fern_monotonic_ns() -> i64 in %rax.
            s = s.write("    call __fern_monotonic_ns\n    pushq %rax\n");
            s = s.need("monotonic_ns");
        } else if (o.kind == "now_unix_ms") {
            // no operands; __fern_now_unix_ms() -> i64 in %rax.
            s = s.write("    call __fern_now_unix_ms\n    pushq %rax\n");
            s = s.need("now_unix_ms");
        } else if (o.kind == "now_ns") {
            // no operands; __fern_now_ns() -> i64 in %rax.
            s = s.write("    call __fern_now_ns\n    pushq %rax\n");
            s = s.need("now_ns");
        } else if (o.kind == "struct_make") {
            // nf field values on the operand stack (field nf-1 on top, decl
            // order). Box = [shape_ptr@0, f0@8, f1@16, …]; shape = the interned
            // struct-name string (asm.fern's layout). The box is rc-HEADERED so
            // the exit dec-sweep (__fern_rc_dec → __fn___fern_arr_dec) can
            // refcount AND free it at the right size: allocate via __fern_arr_box
            // with cap=(nf+1) words, which returns data=base+16 with rc=1 at
            // data-8 and the block size (cap+3 words) recoverable from cap at
            // data-16 — exactly the array layout __fern_arr_dec frees. The
            // returned pointer's slot offsets are unchanged (data+0=shape,
            // data+(i+1)*8=field i), so every struct/enum reader (struct_get/_set,
            // variant_is, dyn dispatch's shape@0) stays byte-for-byte correct.
            // __fern_arr_box writes len=cap at data+0; we overwrite it with the
            // shape pointer, leaving cap@data-16 (the free-size word) intact.
            var nf: i32 = o.i32_imm;
            var smshp: ShapeRefOut = shape_ref(s, o.str);
            s = smshp.state;
            s = s.write("    movq $" + util.i32_to_string(nf + 1) + ", %rdi\n");
            s = s.write("    call __fern_arr_box\n");
            s = s.write("    leaq " + smshp.label + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            var em: i32 = nf - 1;
            while (em >= 0) {
                s = s.write("    popq %rcx\n    movq %rcx, " + util.i32_to_string((em + 1) * 8) + "(%rax)\n");
                em = em - 1;
            }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "opt_make") {
            // Option/Result box [tag@0, payload@8], 16 bytes. Payload is on the
            // operand stack; alloc first (it survives on the machine stack, like
            // struct_make), then store tag + payload.
            s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
            s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", (%rax)\n");
            s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");
        } else if (o.kind == "opt_none") {
            // Payloadless box with tag 1 (None).
            s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
            s = s.write("    movq $1, (%rax)\n    movq $0, 8(%rax)\n    pushq %rax\n");
        } else if (o.kind == "opt_tag") {
            // pop box; tag is the i32 at offset 0.
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "opt_payload") {
            // pop box; payload is at offset 8.
            s = s.write("    popq %rax\n    movq 8(%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "map_new") {
            s = s.write("    popq %rdi\n    call __fern_map_new\n    pushq %rax\n");
        } else if (o.kind == "print_int") {
            // [n] -> write n's decimal text to stdout (the AST path's helper +
            // symbol). Push the syscall return so the statement-level drop balances.
            s = s.write("    popq %rdi\n    call __fern_print_int\n    pushq %rax\n");
            s = s.need("print_int");
        } else if (o.kind == "print_str") {
            // [strbox] -> write its bytes to stdout (the AST path's __fern_print_str).
            // Push the syscall return so the statement-level drop balances.
            s = s.write("    popq %rdi\n    call __fern_print_str\n    pushq %rax\n");
            s = s.need("str_print");
        } else if (o.kind == "read_int") {
            // no args -> read an i32 from stdin (the AST path's __fern_read_int),
            // push the result (a value op).
            s = s.write("    call __fern_read_int\n    pushq %rax\n");
            s = s.need("read_int");
        } else if (o.kind == "read_line") {
            // no args -> read one line from stdin into a fresh string box (the AST
            // path's __fern_read_line, which allocates), push the box (a value op).
            s = s.write("    call __fern_read_line\n    pushq %rax\n");
            s = s.need("heap").need("str_read_line");
        } else if (o.kind == "read_file") {
            // [pathbox] -> read the whole named file, push a fresh Result[string,
            // IoError] box (the AST path's __fern_read_file, which allocates). The
            // path string box is the popped %rdi arg.
            s = s.write("    popq %rdi\n    call __fern_read_file\n    pushq %rax\n");
            s = s.need("heap").need("read_file");
        } else if (o.kind == "args") {
            // no args -> build a fresh string[] of the command-line arguments (the
            // AST path's __fern_args, which allocates). The args need also makes the
            // entry's _start save argc/argv from the initial stack.
            s = s.write("    call __fern_args\n    pushq %rax\n");
            s = s.need("heap").need("args");
        } else if (o.kind == "eprint_str") {
            // [strbox] -> write its bytes to stderr (the AST path's __fern_eprint_str).
            // Push the syscall return so the statement-level drop balances.
            s = s.write("    popq %rdi\n    call __fern_eprint_str\n    pushq %rax\n");
            s = s.need("eprint");
        } else if (o.kind == "exit") {
            // [n] -> sys_exit(n). Never returns; the pushed dummy keeps the
            // operand-stack shape for the statement-level drop.
            s = s.write("    popq %rdi\n    movq $60, %rax\n    syscall\n    pushq $0\n");
        } else if (o.kind == "putchar") {
            // [byte] -> write the low byte to stdout (write(1,&byte,1)). Push the
            // syscall return so the statement-level drop balances.
            s = s.write("    popq %rdi\n    call __fern_putchar\n    pushq %rax\n");
            s = s.need("putchar");
        } else if (o.kind == "strbuf_reset") {
            // no args -> clear the global string-builder length. Push a dummy so
            // the statement-level drop balances (same shape as putchar).
            s = s.write("    call __fern_strbuf_reset\n    pushq %rax\n");
            s = s.need("strbuf");
        } else if (o.kind == "strbuf_append") {
            // [strbox] -> copy its bytes onto the global string-builder. Push the
            // helper's return so the statement-level drop balances.
            s = s.write("    popq %rdi\n    call __fern_strbuf_append\n    pushq %rax\n");
            s = s.need("strbuf");
        } else if (o.kind == "strbuf_take") {
            // no args -> snapshot the builder into a fresh string box and reset it
            // (a value op, allocates). The string runtime + heap back the helper.
            s = s.write("    call __fern_strbuf_take\n    pushq %rax\n");
            s = s.need("heap").need("strbuf");
        } else if (o.kind == "sleep_ms") {
            // [ms] -> nanosleep(ms). Push the syscall return so the
            // statement-level drop balances (sleep_ms is void).
            s = s.write("    popq %rdi\n    call __fern_sleep_ms\n    pushq %rax\n");
            s = s.need("sleep_ms");
        } else if (o.kind == "map_set") {
            s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n");
            s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rcx\n    call __fern_map_set\n    pushq %rax\n");
        } else if (o.kind == "map_len") {
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "map_get") {
            s = s.write("    popq %rsi\n    popq %rdi\n    movq $" + util.i32_to_string(o.i32_imm) + ", %rdx\n    call __fern_map_get\n    pushq %rax\n");
        } else if (o.kind == "map_has") {
            s = s.write("    popq %rsi\n    popq %rdi\n    movq $" + util.i32_to_string(o.i32_imm) + ", %rdx\n    call __fern_map_has\n    pushq %rax\n");
        } else if (o.kind == "map_delete") {
            // [map, key] -> __fern_map_delete(rdi=map, rsi=key, rdx=keykind) -> map.
            s = s.write("    popq %rsi\n    popq %rdi\n    movq $" + util.i32_to_string(o.i32_imm) + ", %rdx\n    call __fern_map_delete\n    pushq %rax\n");
        } else if (o.kind == "map_get_or") {
            // [map, k, default] -> __fern_map_get, then Some payload or default.
            var golbl: string = lp + "go" + util.i32_to_string(i);
            s = s.write("    popq %rdx\n    popq %rsi\n    popq %rdi\n    pushq %rdx\n");
            s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rdx\n    call __fern_map_get\n    popq %rdx\n");
            s = s.write("    movq (%rax), %rcx\n    testq %rcx, %rcx\n    jnz " + golbl + "_d\n");
            s = s.write("    movq 8(%rax), %rax\n    jmp " + golbl + "_e\n");
            s = s.write(golbl + "_d:\n    movq %rdx, %rax\n" + golbl + "_e:\n    pushq %rax\n");
        } else if (o.kind == "map_keys") {
            // parallel-array map: keys[] pointer at box+0.
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "map_values") {
            // parallel-array map: values[] pointer at box+8.
            s = s.write("    popq %rax\n    movq 8(%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "struct_get") {
            // pop struct box; field at (index+1)*8.
            s = s.write("    popq %rax\n    movq " + util.i32_to_string((o.i32_imm + 1) * 8) + "(%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "struct_set") {
            // pop val (top), box; store val at field (index+1)*8.
            s = s.write("    popq %rcx\n    popq %rax\n    movq %rcx, " + util.i32_to_string((o.i32_imm + 1) * 8) + "(%rax)\n");
        } else if (o.kind == "struct_set_shape") {
            // peek box (top of stack); write o.str's interned shape pointer (the
            // SAME .S label struct_make writes / variant_is compares) at offset 0.
            // Leaves the box on the stack. Used by the enum-donor in-place reuse to
            // re-shape a dead scalar-enum box as a same-size struct.
            var sslo: ShapeRefOut = shape_ref(s, o.str);
            s = sslo.state;
            s = s.write("    movq (%rsp), %rax\n");
            s = s.write("    leaq " + sslo.label + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
        } else if (o.kind == "variant_is") {
            // pop variant box; shape ptr @0; compare to the interned variant name
            // (same .S label struct_make stores, so pointer equality identifies
            // the variant). Push 1 if equal, else 0.
            var vlo: ShapeRefOut = shape_ref(s, o.str);
            s = vlo.state;
            s = s.write("    popq %rax\n    movq (%rax), %rax\n");
            s = s.write("    leaq " + vlo.label + "(%rip), %rcx\n");
            s = s.write("    cmpq %rcx, %rax\n    sete %al\n    movzbq %al, %rax\n    pushq %rax\n");
        } else if (o.kind == "tuple_make") {
            // n element values on the operand stack (element n-1 on top). Box =
            // [e0@0, e1@8, …], n*8 bytes, NO shape slot (numeric `.i` access).
            // Pop top-down; %rax (box) stays live across the pops.
            var tn: i32 = o.i32_imm;
            s = s.write("    movq $" + util.i32_to_string(tn * 8) + ", %rdi\n    call __fern_alloc\n");
            var tem: i32 = tn - 1;
            while (tem >= 0) {
                s = s.write("    popq %rcx\n    movq %rcx, " + util.i32_to_string(tem * 8) + "(%rax)\n");
                tem = tem - 1;
            }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "tuple_get") {
            // pop tuple box; element at index*8.
            s = s.write("    popq %rax\n    movq " + util.i32_to_string(o.i32_imm * 8) + "(%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "drop") {
            s = s.write("    addq $8, %rsp\n");
        } else if (o.kind == "call_direct" && is_fern_helper(o.str)) {
            // Runtime RC helper — asm.fern's stack-arg ABI + symbols (drop-in):
            // the arg(s) are already on the operand stack (the helper reads
            // 8(%rsp)); call, caller-clean the args, push the result. The
            // helpers return the ptr (rc_inc / arr_dec) or the count
            // (underflow_count) in %rax.
            // __fern_i32_to_string allocates its result box, so it needs the
            // heap runtime + its own body (gated on this need in emit_ir_runtime).
            if (o.str == "__fern_i32_to_string") { s = s.need("heap").need("i32_to_string"); }
            // str_to_i32 is allocation-free (parses in registers), so it needs
            // only its own body — not the heap runtime.
            if (o.str == "__fern_str_to_i32") { s = s.need("str_to_i32"); }
            // chr allocates its 1-char box, so pull in the heap runtime too.
            if (o.str == "__fern_chr") { s = s.need("heap").need("chr"); }
            s = s.write("    call " + ir_helper_symbol(o.str) + "\n");
            if (o.i32_imm > 0) { s = s.write("    addq $" + util.i32_to_string(o.i32_imm * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "call_direct") {
            // User call: the IR pushes args left-to-right (arg0 deepest);
            // asm.fern's stack ABI wants arg0 on TOP (param[i] at +16+i*8(%rbp)).
            // Reverse the argc on-stack slots, call, pop the args, push %rax.
            var argc: i32 = o.i32_imm;
            var h: i32 = 0;
            while (h < argc / 2) {
                var lo: i32 = h * 8;
                var hi: i32 = (argc - 1 - h) * 8;
                s = s.write("    movq " + util.i32_to_string(lo) + "(%rsp), %rax\n");
                s = s.write("    movq " + util.i32_to_string(hi) + "(%rsp), %rcx\n");
                s = s.write("    movq %rax, " + util.i32_to_string(hi) + "(%rsp)\n");
                s = s.write("    movq %rcx, " + util.i32_to_string(lo) + "(%rsp)\n");
                h = h + 1;
            }
            s = s.write("    call __fn_" + asmcore.sanitize_label(o.str) + "\n");
            if (argc > 0) { s = s.write("    addq $" + util.i32_to_string(argc * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "dyn_dispatch") {
            // `dyn Trait` method call. Receiver (arg0) + args are spilled in argc
            // consecutive locals from base_slot. Read the receiver's shape pointer
            // and dispatch to the matching `<Type>.<method>` — a compare-branch
            // chain over every module method named o.str with a struct receiver,
            // mirroring asm.fern's dyn dispatch. Each matched arm pushes the argc
            // locals (arg0/receiver on top, asm.fern's ABI) and calls.
            var dbase: i32 = o.i32_imm;
            var dargc: i32 = o.width;
            s = s.write("    movq " + util.i32_to_string(0 - 8 * (dbase + 1)) + "(%rbp), %rax\n");
            s = s.write("    movq (%rax), %rcx\n");
            var dend: string = lp + "dynend" + util.i32_to_string(i);
            var dfi: i32 = 0;
            var darmn: i32 = 0;
            while (dfi < s.funcs.len()) {
                var dfd: parser.FuncDecl = s.funcs[dfi];
                var ddbn: string = util.base_type_name(dfd.receiver_type);
                // Dispatch arms: every method named o.str whose receiver is a
                // struct (value carries its shape) OR a primitive/string (value
                // is heap-boxed at coercion — docs/DYN-TRAITS.md §4.2.3). A
                // primitive arm UNBOXES: the receiver local holds the box pointer,
                // so arg0 is reloaded from box+8, not pushed directly.
                var dprim: boolean = dfd.receiver_type.len() > 0 && asmcore.is_prim_recv_name(ddbn, s);
                if (dfd.name == o.str && dfd.receiver_type.len() > 0
                        && (asmcore.is_struct_decl_name(ddbn, s) || dprim)) {
                    var dbn: string = ddbn;
                    var dlit: ShapeRefOut = shape_ref(s, dbn);
                    s = dlit.state;
                    var dnext: string = lp + "dynnext" + util.i32_to_string(i) + "_" + util.i32_to_string(darmn);
                    s = s.write("    leaq " + dlit.label + "(%rip), %rdx\n");
                    s = s.write("    cmpq %rdx, %rcx\n");
                    s = s.write("    jne " + dnext + "\n");
                    var dk: i32 = dargc - 1;
                    while (dk >= 0) {
                        if (dk == 0 && dprim) {
                            // arg0 is the receiver: unbox the value from box+8.
                            s = s.write("    movq " + util.i32_to_string(0 - 8 * (dbase + 1)) + "(%rbp), %rax\n");
                            s = s.write("    pushq 8(%rax)\n");
                        } else {
                            s = s.write("    pushq " + util.i32_to_string(0 - 8 * (dbase + dk + 1)) + "(%rbp)\n");
                        }
                        dk = dk - 1;
                    }
                    s = s.write("    call __fn_" + asmcore.sanitize_label(dbn + "." + dfd.name) + "\n");
                    s = s.write("    addq $" + util.i32_to_string(dargc * 8) + ", %rsp\n");
                    s = s.write("    pushq %rax\n");
                    s = s.write("    jmp " + dend + "\n");
                    s = s.write(dnext + ":\n");
                    darmn = darmn + 1;
                }
                dfi = dfi + 1;
            }
            s = s.write("    pushq $0\n");   // fallback (unreachable for a valid dyn value)
            s = s.write(dend + ":\n");
        } else if (o.kind == "dyn_box") {
            // Heap-box a primitive/string value coerced into a `dyn Trait` slot
            // (docs/DYN-TRAITS.md §4.2.3). Cell = [shape@0, value@8], 16 bytes;
            // shape = the interned primitive type name (the SAME .S label struct
            // shapes use), so op_dyn_dispatch's offset-0 compare matches. The
            // value (one word — an i32/i64/f64 scalar OR a string box pointer) is
            // on the operand stack; alloc first (it survives on the machine stack,
            // like opt_make), then store shape + value, push the cell pointer.
            var dbl: ShapeRefOut = shape_ref(s, o.str);
            s = dbl.state;
            s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
            s = s.write("    leaq " + dbl.label + "(%rip), %rcx\n");
            s = s.write("    movq %rcx, (%rax)\n");
            s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");
        } else if (o.kind == "dyn_downcast") {
            // `e as? T` downcast (docs/DYN-TRAITS.md §9). The `dyn` value (a heap
            // pointer carrying its concrete shape @0) is on top of the operand
            // (machine) stack. Read its shape and compare to T's interned shape
            // (the SAME .S label struct_make / dyn_dispatch use, so pointer
            // identity holds): equal → Some(value) box [tag0@0, payload@8]; else
            // → None box [tag1@0, 0@8] — the ordinary Option box `match` reads.
            // The dyn value rides the machine stack across __fern_alloc (like
            // opt_make/dyn_box), so the hit path reuses it as the Some payload.
            var dcl: ShapeRefOut = shape_ref(s, o.str);
            s = dcl.state;
            var dcmiss: string = lp + "dcmiss" + util.i32_to_string(i);
            var dcend: string = lp + "dcend" + util.i32_to_string(i);
            s = s.write("    movq (%rsp), %rax\n");        // peek dyn ptr (left on stack)
            s = s.write("    movq (%rax), %rcx\n");        // shape @0
            s = s.write("    leaq " + dcl.label + "(%rip), %rdx\n");
            s = s.write("    cmpq %rdx, %rcx\n    jne " + dcmiss + "\n");
            // hit: Some(value) — pop the dyn ptr as payload.
            s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
            s = s.write("    movq $0, (%rax)\n");
            s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");
            s = s.write("    jmp " + dcend + "\n");
            // miss: None — discard the dyn ptr, build a payloadless tag-1 box.
            s = s.write(dcmiss + ":\n");
            s = s.write("    addq $8, %rsp\n");
            s = s.write("    movq $16, %rdi\n    call __fern_alloc\n");
            s = s.write("    movq $1, (%rax)\n    movq $0, 8(%rax)\n    pushq %rax\n");
            s = s.write(dcend + ":\n");
        } else if (o.kind == "const_func") {
            // A function VALUE is the function's code address — push it. Register
            // backends need no funcref table (unlike wasm's table index): the
            // address is the value, dispatched directly by call_indirect.
            s = s.write("    leaq __fn_" + asmcore.sanitize_label(o.str) + "(%rip), %rax\n    pushq %rax\n");
        } else if (o.kind == "call_indirect") {
            // Indirect call through a function value: the stack holds
            // [arg0(deepest) … argN-1, fn_addr(top)]. Pop the target into a
            // scratch reg, reverse the args so arg0 is on TOP (the stack-arg ABI
            // the callee reads at +16+i*8(%rbp)), call through the pointer, pop
            // the args, push the result. Same arg discipline as call_direct.
            var icargc: i32 = o.i32_imm;
            s = s.write("    popq %r11\n");
            var ih: i32 = 0;
            while (ih < icargc / 2) {
                var ilo: i32 = ih * 8;
                var ihi: i32 = (icargc - 1 - ih) * 8;
                s = s.write("    movq " + util.i32_to_string(ilo) + "(%rsp), %rax\n");
                s = s.write("    movq " + util.i32_to_string(ihi) + "(%rsp), %rcx\n");
                s = s.write("    movq %rax, " + util.i32_to_string(ihi) + "(%rsp)\n");
                s = s.write("    movq %rcx, " + util.i32_to_string(ilo) + "(%rsp)\n");
                ih = ih + 1;
            }
            s = s.write("    call *%r11\n");
            if (icargc > 0) { s = s.write("    addq $" + util.i32_to_string(icargc * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "const_f64") {
            // Float literal: GAS assembles the source text to an IEEE double in
            // .rodata; load its bits and push them (floats flow on the rt-stack
            // as their 8-byte bit pattern, like i64). Mirrors asm.fern.
            var flb: asmcore.LabelOut = asmcore.fresh_label(s);
            s = flb.state;
            s = s.write("    .section .rodata\n" + flb.name + ": .double " + o.str + "\n    .text\n");
            s = s.write("    movsd " + flb.name + "(%rip), %xmm0\n    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "i32_to_f64") {
            // signed i32 -> f64 (cvtsi2sd); value rides the stack as bits.
            s = s.write("    popq %rax\n    cvtsi2sd %rax, %xmm0\n    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "f64_to_i32") {
            // f64 -> signed i32, truncating toward zero (cvttsd2si).
            s = s.write("    popq %rax\n    movq %rax, %xmm0\n    cvttsd2si %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "f64_to_i64") {
            // f64 -> signed i64, truncating toward zero. cvttsd2si already
            // writes the full 64-bit %rax, so it is the same instruction as
            // f64_to_i32 (which only keeps the low 32 bits).
            s = s.write("    popq %rax\n    movq %rax, %xmm0\n    cvttsd2si %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "fadd" || o.kind == "fsub" || o.kind == "fmul" || o.kind == "fdiv") {
            // f64 arithmetic: pop rhs/lhs bits into xmm1/xmm0, op, push result.
            s = s.write("    popq %rax\n    movq %rax, %xmm1\n    popq %rax\n    movq %rax, %xmm0\n");
            if (o.kind == "fadd") { s = s.write("    addsd %xmm1, %xmm0\n"); }
            else if (o.kind == "fsub") { s = s.write("    subsd %xmm1, %xmm0\n"); }
            else if (o.kind == "fmul") { s = s.write("    mulsd %xmm1, %xmm0\n"); }
            else { s = s.write("    divsd %xmm1, %xmm0\n"); }
            s = s.write("    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "fsqrt" || o.kind == "ffloor" || o.kind == "fceil" || o.kind == "ftrunc") {
            // f64 unary math (op_funary): pop the operand bits into xmm0, apply the
            // single SSE instruction, push. roundsd needs SSE4.1 (universal on
            // x86-64); $1/$2/$3 select floor / ceil / trunc. Mirrors asm.fern.
            s = s.write("    popq %rax\n    movq %rax, %xmm0\n");
            if (o.kind == "fsqrt") { s = s.write("    sqrtsd %xmm0, %xmm0\n"); }
            else if (o.kind == "ffloor") { s = s.write("    roundsd $1, %xmm0, %xmm0\n"); }
            else if (o.kind == "fceil") { s = s.write("    roundsd $2, %xmm0, %xmm0\n"); }
            else { s = s.write("    roundsd $3, %xmm0, %xmm0\n"); }
            s = s.write("    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "fabs") {
            // |x| clears the f64 sign bit — a plain mask on the bits in %rax, no
            // xmm needed (mirrors asm.fern's __abs_f64).
            s = s.write("    popq %rax\n    movabsq $0x7fffffffffffffff, %rcx\n    andq %rcx, %rax\n    pushq %rax\n");
        } else if (o.kind == "fround") {
            // round-half-away-from-zero (Go's math.Round): roundsd only offers
            // ties-to-even / floor / ceil / trunc, so emulate via
            // trunc(x + copysign(0.5, x)). Build copysign(0.5, x) by OR-ing x's
            // sign bit into the 0.5 bit pattern (0x3fe0000000000000), add, trunc
            // ($3). Mirrors asm.fern's __round_f64.
            s = s.write("    popq %rax\n    movq %rax, %rcx\n");
            s = s.write("    movabsq $0x8000000000000000, %rdx\n    andq %rdx, %rcx\n");
            s = s.write("    movabsq $0x3fe0000000000000, %rdx\n    orq %rdx, %rcx\n");
            s = s.write("    movq %rcx, %xmm1\n    movq %rax, %xmm0\n");
            s = s.write("    addsd %xmm1, %xmm0\n    roundsd $3, %xmm0, %xmm0\n");
            s = s.write("    movq %xmm0, %rax\n    pushq %rax\n");
        } else if (o.kind == "flt" || o.kind == "fle" || o.kind == "fgt" || o.kind == "fge" || o.kind == "feq" || o.kind == "fne") {
            // f64 compare → i32 0/1, NaN-correct (mirrors asm.fern): ucomisd sets
            // CF=ZF=PF=1 when unordered, so `<`/`<=`/`==` mask with setnp and
            // `!=` accepts unordered via setp; `>`/`>=` use seta/setae (CF=0).
            s = s.write("    popq %rax\n    movq %rax, %xmm1\n    popq %rax\n    movq %rax, %xmm0\n");
            s = s.write("    ucomisd %xmm1, %xmm0\n    movq $0, %rax\n");
            if (o.kind == "flt") { s = s.write("    setb %al\n    setnp %dl\n    andb %dl, %al\n"); }
            else if (o.kind == "fle") { s = s.write("    setbe %al\n    setnp %dl\n    andb %dl, %al\n"); }
            else if (o.kind == "fgt") { s = s.write("    seta %al\n"); }
            else if (o.kind == "fge") { s = s.write("    setae %al\n"); }
            else if (o.kind == "feq") { s = s.write("    sete %al\n    setnp %dl\n    andb %dl, %al\n"); }
            else { s = s.write("    setne %al\n    setp %dl\n    orb %dl, %al\n"); }
            s = s.write("    movzbq %al, %rax\n    pushq %rax\n");
        } else if (o.kind == "end") {
            // Define the label at this end's index — the target of the if/else
            // that opened it (no-else if's jz, else's jmp) or a block's br.
            // A loop's closing end is unused (harmless).
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else {
            // binary op: pop rhs (rcx), lhs (rax), combine, push.
            s = s.write("    popq %rcx\n    popq %rax\n");
            s = s.write(ir_bin_asm(o.kind, o.width));
            s = s.write("    pushq %rax\n");
        }
        i = i + 1;
    }

    // Fallback (subset functions always end in `return`).
    s = s.write("    movq $0, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// lift_lambdas re-exports irlower's lambda-lift pre-pass so the dispatch sites
// (asm.emit_module / asm_ir_run) can hoist no-capture lambda arguments before
// the eligibility check + emit without importing irlower directly. It also
// injects the built-in struct/enum declarations (FileStat / HeaderMap /
// JsonValue / the std/time types / …) into the module's struct table — the AST
// path gets these via parser.module_with_builtins, but the IR path (probe +
// emit_module_ir) both funnel through here, so this is the single point that
// keeps the IR path's struct visibility in sync with the AST path's. Without
// it the IR path can't resolve built-in struct layouts (e.g. std/time's Date)
// and bails every function that uses one.
pub function lift_lambdas(mod: parser.Module): parser.Module {
    var lifted: parser.Module = irlower.lift_lambdas(mod);
    return parser.Module { funcs: lifted.funcs, structs: parser.inject_builtin_enums(lifted.structs), aliases: lifted.aliases, imports: lifted.imports, top_stmts: lifted.top_stmts, enums: lifted.enums, resources: lifted.resources, exports: lifted.exports };
}

// emit_module_ir emits a full all-i32-eligible module via the IR path. The
// program is self-contained (pure i32 uses no runtime helpers): every
// function via the IR, then a `_start` that calls __fn_main and exits with
// its result. Caller must ensure all_eligible(mod).
// emit_module_funcs derives the per-module side-tables ONCE and emits every
// function through the IR (asm into the strbuf), marking each function's runtime
// needs (the maps/heap op-scan + the str_*/print mark_* calls all live inside
// emit_function_via_ir). globl_defs marks each `__fn_<label>` `.globl` for
// per-module linking. Shared by emit_module_ir_unit (which then writes _start /
// .rodata / the runtime) and module_runtime_needs (which discards the asm and
// reads the accumulated `needed`). Factoring it out keeps the two callers from
// drifting on which functions / side-tables drive need detection.
// all_funcs / all_structs are the WHOLE-PROGRAM signature view (#3451 step 2 /
// #3454): the union of every loaded module's functions and structs. The
// return-type / signature side-tables are derived over them so a cross-module
// call to an imported function whose return type is non-i32 (string / struct /
// i64 / array / …) is tagged by the CALLEE's real signature — the callee lives
// in a sibling module and would otherwise be invisible, mis-tagging the call as
// i32 and miscompiling a chained method on its result. Only `mod.funcs` are
// EMITTED; all_funcs/all_structs drive analysis only. For the whole-program
// single-unit path all_funcs==mod.funcs / all_structs==mod.structs, so the
// derived tables — and the emitted asm — are byte-identical.
function emit_module_funcs(mod: parser.Module, all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[], s: asmcore.EmitState, globl_defs: boolean): asmcore.EmitState {
    var arf: string[] = array_ret_fns_of(all_funcs);
    // Inter-procedural borrowability computed ONCE per module (not per function —
    // that OOMs the arm64 self-compile); threaded into every emit_function_via_ir.
    var bparams: string[] = irlower.borrowable_params_interproc(all_funcs);
    // The fourteen return-type / signature side-tables lower_func consults are
    // derived ONCE here (each scans all of all_funcs — the WHOLE-PROGRAM
    // signature view, #3454), then threaded into every emit_function_via_ir —
    // recomputing them per function is O(n^2) and OOMs the bump heap on a large
    // module (parser, ~300 funcs). This mirrors bparams above and the wasm
    // backend's emit_module, which already hoists them.
    var srf: string[] = irlower.str_ret_fns_of(all_funcs);
    var sarf: string[] = irlower.strarr_ret_fns_of(all_funcs);
    var amf: string[] = irlower.arr_method_fns_of(all_funcs);
    var orf: string[] = irlower.opt_ret_fns_of(all_funcs);
    var irf: string[] = irlower.i64_ret_fns_of(all_funcs);
    var trf: string[] = irlower.tuple_ret_fns_of(all_funcs);
    var srtf: string[] = irlower.struct_ret_fns_of(all_funcs, all_structs);
    var mrtf: string[] = irlower.map_ret_fns_of(all_funcs);
    var frf: string[] = irlower.f64_ret_fns_of(all_funcs);
    var farf: string[] = irlower.f64arr_ret_fns_of(all_funcs);
    var iarf: string[] = irlower.i64arr_ret_fns_of(all_funcs);
    var fps: string[] = irlower.fn_param_sigs_of(all_funcs);
    var cfs: string[] = irlower.closure_ret_fns_of(all_funcs);
    var cnf: string[] = irlower.const_fns_of(all_funcs);
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        // Per-module: mark the definition `.globl` so a sibling module's
        // `call __fn_<label>` (an unresolved extern in that module) links
        // against it. The label is computed exactly as emit_function_via_ir
        // writes it below (receiver-qualified for methods).
        if (globl_defs) {
            var gname: string = mod.funcs[fi].name;
            if (mod.funcs[fi].receiver_type.len() > 0) { gname = util.base_type_name(mod.funcs[fi].receiver_type) + "." + mod.funcs[fi].name; }
            s = s.write(".globl __fn_" + asmcore.sanitize_label(gname) + "\n");
        }
        s = emit_function_via_ir(mod.funcs[fi], arf, s, bparams, srf, sarf, amf, orf, irf, trf, srtf, mrtf, frf, farf, iarf, fps, cfs, cnf);
        fi = fi + 1;
    }
    return s;
}

// module_runtime_needs returns the runtime helpers a module requires (the
// closed need-set: "heap", "maps", "str_concat", …), for whole-program runtime
// aggregation in per-module emit (#3451 step 3 / #3455). The entry module emits
// the single shared runtime, but on its OWN it only knows its own needs — a
// library module that uses a helper the entry doesn't (e.g. str_concat) would
// reference an undefined symbol at link. The driver unions module_runtime_needs
// across every loaded module and passes the result as emit_module_ir_unit's
// extra_needs, so the entry's runtime covers every module. It runs the same
// per-function emit as the real path (so the need-set is exact) but discards
// the asm (strbuf_reset) and reads `needed`.
pub function module_runtime_needs(mod: parser.Module): string[] {
    mod = parser.infer_ret_types_module(mod);
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    s = asmcore.EmitState { ...s, struct_decls: mod.structs, funcs: mod.funcs };
    // Needs depend only on this module's own ops, so the single-module
    // signature view suffices (a cross-module call's NEED set is the callee's,
    // aggregated separately via module_runtime_needs over each module).
    s = emit_module_funcs(mod, mod.funcs, mod.structs, s, false);
    s = s.close_needs();
    strbuf_reset();
    return s.needed;
}

pub function emit_module_ir(mod: parser.Module): string {
    // Infer return types BEFORE snapshotting all_funcs: the side-tables are
    // derived over all_funcs, so they must see the inferred (unannotated)
    // return types — otherwise a function with an inferred string/struct/…
    // return is mis-tagged i32 and a chained method on its result miscompiles.
    // emit_module_ir_unit re-infers `mod` (idempotent), keeping the emitted
    // module and the analysis set consistent.
    var im: parser.Module = parser.infer_ret_types_module(mod);
    return emit_module_ir_unit(im, true, false, "", [], im.funcs, im.structs);
}

// emit_module_ir_unit is emit_module_ir parameterised for per-module
// translation units (the per-module-compilation epic, #3451 — step 1's emit
// side / #3453, step 3 / #3455). Two knobs:
//
//   is_entry   — the entry module emits `_start` (→ call __fn_main + exit) AND
//                the single shared `__fern_*` runtime. Non-entry (library)
//                modules omit both: they expose only their `__fn_*` definitions
//                and reference the runtime helpers / sibling `__fn_*` symbols as
//                externs, resolved at link. (Aggregating runtime "needs" across
//                ALL modules so the entry's single runtime covers every helper
//                any module uses is the remaining step-3 piece; until then a
//                non-entry module that itself allocates must be linked with an
//                entry that pulls the heap runtime in.)
//   globl_defs — mark each emitted `__fn_<label>` `.globl` so a sibling module
//                can `call` into it across the translation-unit boundary.
//
// emit_module_ir delegates with is_entry=true, globl_defs=false, which
// reproduces the whole-program merged output byte-for-byte (no per-function
// `.globl`, the `_start` + runtime present, `str_ns` empty so string labels
// stay `.S<idx>`), so the existing single-unit path is unchanged.
//
//   str_ns — per-module namespace for string-literal `.rodata` labels. Empty
//            keeps `.S<idx>`; a non-empty ns makes each module's pool
//            `.S<ns>_<idx>`, so two STRING-using modules co-link without
//            label collision. A string-free module emits no `.rodata` either
//            way, so a "" ns there is harmless.
//   extra_needs — additional runtime needs to fold into the entry's single
//            runtime (the whole-program union of every module's
//            module_runtime_needs), so the entry emits the helpers a sibling
//            library uses even when the entry itself doesn't. Empty for the
//            whole-program path and for non-entry units.
//   all_funcs / all_structs — the WHOLE-PROGRAM signature view (#3454): the
//            union of every loaded module's functions / structs, over which the
//            return-type side-tables + struct layouts are derived so a
//            cross-module call is tagged by the callee's real signature. Only
//            `mod.funcs` are emitted. For the single-unit path pass mod.funcs /
//            mod.structs (byte-identical).
pub function emit_module_ir_unit(mod: parser.Module, is_entry: boolean, globl_defs: boolean, str_ns: string, extra_needs: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[]): string {
    // Infer return types for unannotated functions so the IR path's
    // ret-type-keyed call tagging (str_ret_fns_of / opt_ret_fns_of / …)
    // matches the AST path, which gets the same via module_with_builtins.
    mod = parser.infer_ret_types_module(mod);
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    // struct_decls is the WHOLE-PROGRAM struct set so a function emitting an
    // imported struct's layout (field offsets / sizes) resolves it.
    s = asmcore.EmitState { ...s, struct_decls: all_structs, funcs: mod.funcs, str_ns: str_ns };
    if (is_entry) { s = s.write("    .globl _start\n"); }
    s = s.write("    .text\n");
    // Per-module: the entry exports its shared runtime entry points so sibling
    // library modules can link their `call __fern_*` externs against them.
    if (is_entry && globl_defs) { s = emit_runtime_globls(s); }
    s = emit_module_funcs(mod, all_funcs, all_structs, s, globl_defs);
    // Fold the whole-program extra_needs (sibling modules' needs, for the entry's
    // single shared runtime) into the need set BEFORE _start, so _start's
    // need-gated argc/argv save below fires even when only a LIBRARY module
    // (not the entry itself) calls args(). For the single-unit path extra_needs
    // is empty, so this is inert there.
    var en: i32 = 0;
    while (en < extra_needs.len()) {
        s = s.need(extra_needs[en]);
        en = en + 1;
    }
    // _start belongs only to the entry module (one program entry point). A
    // non-entry library module exposes its `__fn_*` definitions and nothing else.
    if (is_entry) {
        s = s.write("_start:\n");
        // args() reads __fern_argc / __fern_argv; save them from the initial stack
        // (the kernel puts argc at the top of the stack on entry) BEFORE any push.
        // Matches asm.fern's _start. Gated on the args need so a non-args program
        // is byte-identical.
        if (s.has_need("args")) {
            s = s.write("    movq (%rsp), %rax\n");
            s = s.write("    movq %rax, __fern_argc(%rip)\n");
            s = s.write("    leaq 8(%rsp), %rax\n");
            s = s.write("    movq %rax, __fern_argv(%rip)\n");
        }
        s = s.write("    pushq %rbp\n");
        s = s.write("    movq %rsp, %rbp\n");
        s = s.write("    call __fn_main\n");
        s = s.write("    movq %rax, %rdi\n");
        s = s.write("    movq $60, %rax\n");
        s = s.write("    syscall\n");
    }
    // .rodata: each interned string literal as a labelled `.ascii` directive
    // (GAS interprets the escapes), matching asm.fern's emit_module so the box's
    // .S<idx> data pointer resolves. string_lits was populated by const_str.
    if (s.string_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < s.string_lits.len()) {
            s = s.write(str_lit_label(s, li) + ": .ascii \"" + asmcore.escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
    }
    // Per-module shape pointers: emit each distinct shape name once as a `.weak`
    // global symbol (shape_sym) carrying its name bytes. Every unit referencing the
    // same shape emits the same weak symbol, so the linker merges them to ONE
    // address — pointer-equality shape discrimination then holds across the module
    // boundary (a token constructed in the lexer unit matches in the parser unit).
    // Only populated on the per-module path (shape_ref interns shapes as ordinary
    // string literals when str_ns == "", so the whole-program emit is unchanged).
    if (s.shape_lits.len() > 0) {
        s = s.write("    .section .rodata\n");
        var shi: i32 = 0;
        while (shi < s.shape_lits.len()) {
            var shsym: string = asmcore.shape_sym(s.shape_lits[shi]);
            s = s.write(".weak " + shsym + "\n");
            s = s.write(shsym + ": .ascii \"" + asmcore.escape_for_ascii(s.shape_lits[shi]) + "\"\n");
            shi = shi + 1;
        }
    }
    // The "maps" / "heap" needs were marked per-function during the emit loop
    // above (off the ops each lower_func already produced), so there is no need to
    // re-lower the module here. The whole-program extra_needs (sibling modules'
    // needs, for the entry's single shared runtime) were folded in above, BEFORE
    // _start (so its argc/argv save sees a sibling's args need) and hence before
    // close_needs, so their declared deps resolve too. close_needs() pulls in
    // maps' declared deps (str_eq, arr_push, heap) so the runtime links.
    s = s.close_needs();
    // The shared `__fern_*` runtime is emitted ONCE, by the entry module — a
    // non-entry library module references these helpers as externs (resolved at
    // link against the entry's copy), so emitting them again would duplicate-
    // define the symbols. (Until runtime needs are aggregated whole-program,
    // the entry only knows its OWN needs; a non-entry module that itself
    // allocates relies on the entry having pulled the heap runtime in.)
    if (is_entry) {
    // The freestanding allocator + RC runtime, only when the program allocates.
    // i32.to_string() allocates its box even in an otherwise heap-free program,
    // so its emit-time need pulls the runtime in too (its body calls __fern_alloc).
    if (s.has_need("heap") || s.has_need("i32_to_string") || s.has_need("str_to_i32") || s.has_need("chr") || s.has_need("print_int") || s.has_need("read_int") || s.has_need("str_read_line") || s.has_need("putchar") || s.has_need("strbuf")) { s = emit_ir_runtime(s); }
    // String search predicates (starts_with / ends_with / index_of) are
    // allocation-free + self-contained, so they're emitted in their own helper
    // — kept OUT of emit_ir_runtime, whose size is near the self-host's
    // oversized-function miscompile threshold (#2720).
    if (s.has_need("str_search")) { s = emit_ir_str_search(s); }
    // ASCII case transforms (to_upper / to_lower) — heap-dependent, so the heap
    // runtime is already present; emitted on their own str_case need.
    if (s.has_need("str_case")) { s = emit_ir_str_case(s); }
    // String repeat — heap-dependent, gated on its str_repeat need.
    if (s.has_need("str_repeat")) { s = emit_ir_str_repeat(s); }
    // String trim — heap-dependent, gated on its str_trim need.
    if (s.has_need("str_trim")) { s = emit_ir_str_trim(s); }
    // String reverse — heap-dependent, gated on its str_reverse need.
    if (s.has_need("str_reverse")) { s = emit_ir_str_reverse(s); }
    // String replace — heap-dependent, gated on its str_replace need.
    if (s.has_need("str_replace")) { s = emit_ir_str_replace(s); }
    // String chars — heap-dependent, gated on its str_chars need.
    if (s.has_need("str_chars")) { s = emit_ir_str_chars(s); }
    // String lines — heap + str_split dependent, gated on its str_lines need.
    if (s.has_need("str_lines")) { s = emit_ir_str_lines(s); }
    // random_i32 allocates nothing, so its helper is emitted independently of
    // the heap runtime (a random_i32-only program is heap-free).
    if (s.has_need("random_i32")) { s = emit_ir_random_i32(s); }
    // Clock helpers: allocation-free, so emitted independently of the heap
    // runtime (a clock-only program is heap-free), like random_i32.
    if (s.has_need("monotonic_ns")) { s = emit_ir_monotonic_ns(s); }
    if (s.has_need("now_unix_ms")) { s = emit_ir_now_unix_ms(s); }
    if (s.has_need("now_ns")) { s = emit_ir_now_ns(s); }
    if (s.has_need("sleep_ms")) { s = emit_ir_sleep_ms(s); }
    }
    return strbuf_take();
}
