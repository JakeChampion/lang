        // one at a time. A hit at byte k of the four steps the cursor k times
        // before its offset is read.
        s = s.write("    cmpq %r8, %rcx\n    jge " + s_end + "\n");
        s = s.write("    leaq (%rax,%rcx), %r10\n    leaq (%rax,%r8), %r11\n    leaq -4(%r11), %rcx\n");
        s = s.write(s_loop + ":\n    cmpq %rcx, %r10\n    ja " + s_one + "\n");
        var k: i32 = 0;
        while (k < 4) {
            s = s.write("    movzbq " + util.i32_to_string(k) + "(%r10), %r9\n");
            s = s.write("    cmpq $0, 8(%rdx,%r9,8)\n    jne " + hits[k] + "\n");
            k = k + 1;
