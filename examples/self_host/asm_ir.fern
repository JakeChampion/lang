    // a shallow word-for-word copy of src (shape@0 + nf field slots). Allocates via
    // __fern_arr_box(cap = nf+1) so the copy has a fresh rc=1 header + the same free
    // size, byte-identical to struct_make's box; then copies nf+1 words src -> dst
    // (field pointers shared, matching the inline base-copy path). The compact base
    // copy of `T { ...base, f: v }` (#4650): one call instead of nf struct_get/store.
    s = s.write("__fn___fern_struct_copy:\n");
    s = hev_shim_site(s, "scopy");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rdi\n");                 // save src            [-8(%rbp)]
    s = s.write("    pushq %rsi\n");                 // save nf             [-16(%rbp)]
    s = s.write("    leaq 1(%rsi), %rdi\n");         // cap = nf+1 words
    s = s.write("    call __fern_arr_box\n");        // %rax = dst data (rc=1)
    s = s.write("    movq -8(%rbp), %rsi\n");        // src
    s = s.write("    movq -16(%rbp), %rcx\n");       // nf
    s = s.write("    incq %rcx\n");                  // nf+1 words (shape + fields)
    s = s.write("    xorq %rdx, %rdx\n");            // i = 0
