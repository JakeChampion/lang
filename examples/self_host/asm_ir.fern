        // No cursor to clamp: both degenerate answers are accurate counts
        // rather than sentinels.
        var clo: asmcore.LabelOut = asmcore.fresh_label(s);
        var c_vec: string = clo.name;
        var clo2: asmcore.LabelOut = asmcore.fresh_label(clo.state);
        var c_tail: string = clo2.name;
        var clo3: asmcore.LabelOut = asmcore.fresh_label(clo2.state);
        var c_next: string = clo3.name;
        var clo4: asmcore.LabelOut = asmcore.fresh_label(clo3.state);
        var c_done: string = clo4.name;
        var clo5: asmcore.LabelOut = asmcore.fresh_label(clo4.state);
        var c_avx: string = clo5.name;
        var clo6: asmcore.LabelOut = asmcore.fresh_label(clo5.state);
        var c_avx_done: string = clo6.name;
        s = clo6.state;
        s = s.write("    popq %rcx\n    popq %rax\n");
        s = s.write("    movq 8(%rax), %r8\n    movq (%rax), %rax\n");
        s = s.write("    xorq %rdx, %rdx\n    xorq %r10, %r10\n");
        // A byte outside 0..255 can never match. One UNSIGNED compare covers
        // both ends, checked once so neither loop needs a per-iteration guard,
        // and so the splat below is exact rather than truncating.
        s = s.write("    cmpq $255, %rcx\n    ja " + c_done + "\n");
        s = s.write("    movd %ecx, %xmm1\n    punpcklbw %xmm1, %xmm1\n");
        s = s.write("    punpcklwd %xmm1, %xmm1\n    pshufd $0, %xmm1, %xmm1\n");
        s = s.write("    vpbroadcastb %xmm1, %ymm1\n");
        s = s.write(c_avx + ":\n");
        s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
        s = s.write("    cmpq $32, %r9\n    jl " + c_avx_done + "\n");
        s = s.write("    vmovdqu (%rax,%rdx), %ymm0\n    vpcmpeqb %ymm1, %ymm0, %ymm0\n");
        s = s.write("    vpmovmskb %ymm0, %r9d\n    popcntl %r9d, %r9d\n");
        s = s.write("    addq %r9, %r10\n    addq $32, %rdx\n    jmp " + c_avx + "\n");
        s = s.write(c_avx_done + ":\n    vzeroupper\n");
        s = s.write(c_vec + ":\n");
        s = s.write("    movq %r8, %r9\n    subq %rdx, %r9\n");
        s = s.write("    cmpq $16, %r9\n    jl " + c_tail + "\n");
        s = s.write("    movdqu (%rax,%rdx), %xmm0\n    pcmpeqb %xmm1, %xmm0\n");
        s = s.write("    pmovmskb %xmm0, %r9d\n    popcntl %r9d, %r9d\n");
        s = s.write("    addq %r9, %r10\n    addq $16, %rdx\n    jmp " + c_vec + "\n");
        // Scalar tail: the final 0..15 bytes, and the whole algorithm for a
        // string shorter than one block.
        s = s.write(c_tail + ":\n");
        s = s.write("    cmpq %r8, %rdx\n    jge " + c_done + "\n");
        s = s.write("    movzbq (%rax,%rdx), %r9\n");
        s = s.write("    cmpq %rcx, %r9\n    jne " + c_next + "\n");
        s = s.write("    addq $1, %r10\n");
        s = s.write(c_next + ":\n    addq $1, %rdx\n    jmp " + c_tail + "\n");
        s = s.write(c_done + ":\n    pushq %r10\n");
