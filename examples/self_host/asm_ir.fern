        // The assembler owed nothing here, unlike the SIMD surface the string
        // kernels had to add. x86_gas_sse_fp_op already carried mulpd and
        // unpcklpd, and movupd was already in the mov10 family in both
        // directions — the packed-DOUBLE domain arrived with the scalar float
        // table rather than with a kernel. §3.4's rule is to read the whole
        // table before pricing the work, not the entries a kernel expects.
        //
        // unpcklpd splats the factor: it interleaves the low halves of its two
        // operands, so against itself it copies lane 0 into lane 1. xmm1 then
        // serves the vector body and the tail both, since the tail reads only
        // lane 0.
        //
        // Both bodies multiply the ELEMENT by the factor, in that operand
        // order, so the two cannot disagree about which NaN a NaN times a NaN
        // yields.
        //
        // The result comes from __fern_arr_box(n), which writes the rc
        // header and len = n; this backend's arrays keep len at [arr] and
        // element i at [arr + 8 + i*8]. Both operands are spilled around
        // that call, since it clobbers the caller-saved set. The float
        // arrives as its bit pattern and moves into %xmm1 with movq.
        var flo: asmcore.LabelOut = asmcore.fresh_label(s);
        var sf_loop: string = flo.name;
        var flo2: asmcore.LabelOut = asmcore.fresh_label(flo.state);
        var sf_done: string = flo2.name;
        var flo3: asmcore.LabelOut = asmcore.fresh_label(flo2.state);
        var sf_vec: string = flo3.name;
        s = flo3.state;
        s = s.write("    popq %rcx\n    popq %rax\n");
        s = s.write("    pushq %rax\n    pushq %rcx\n");
        s = s.write("    movq (%rax), %rdi\n    call __fern_arr_box\n");
        s = s.write("    popq %rcx\n    popq %rsi\n");
        s = s.write("    movq %rcx, %xmm1\n    unpcklpd %xmm1, %xmm1\n    xorq %rdx, %rdx\n");
