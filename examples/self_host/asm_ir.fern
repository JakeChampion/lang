// examples/self_host/asm_ir.fern — the IR code path for the production
// x86-64 backend, the first integration of the native-shaped stack IR
// (ir.fern / irlower.fern) into asm.fern's world (docs/RC-PERCEUS-SELF-HOST-
// IR-REBUILD.md §3). emit_module_ir lowers each function AST -> stack IR ->
// asm and instruction-selects it into asm.fern's OWN dialect: same
// `__fn_<name>:` label, same rbp frame + leave/ret, same machine-stack
// operand discipline (every value `pushq`-ed, consumers `popq`), so an
// IR-emitted function is ABI-identical to an AST-emitted one — and the two
// must produce identical behaviour (the differential gate).
//
// SCOPE (slice 16): pure i32 functions — no params, no user calls, no arrays
// — proving the seam end-to-end. asm.fern itself is UNCHANGED (this module is
// imported only by asm_run via its `-ir` flag), so the byte-identical
// self-bootstrap and every asm.fern-based harness are unaffected. emit_module_ir
// only handles modules where EVERY function is eligible (all_eligible); the
// driver falls back to asm.emit_module otherwise. As the eligible subset
// widens, this folds back into asm.fern's emit_module behind a flag.

import "./parser";
import "./asmcore";
import "./util";
import "./ir";
import "./irlower";

// ir_eligible reports whether a function is in the IR path's current subset:
// i32 functions with params, direct calls, and arrays (heap alloc / index /
// write / len + Perceus RC, including borrowed array params and array returns
// via move-on-return) — but no methods. Cross-function arrays are sound here
// because the IR path only fires when the WHOLE module is eligible
// (all_eligible), so every function — caller and callee — uses irlower's
// array layout; nothing crosses an IR/AST boundary.
pub function ir_eligible(fd: parser.FuncDecl, mod: parser.Module): boolean {
    // Methods (receiver functions) are lowered too — lower_func binds the
    // receiver as slot 0 and bails for non-scalar-struct receivers.
    //
    // The eligibility probe lowers fd with the SAME registries
    // emit_function_via_ir (and the wasm emit_function_ir) use, so "eligible"
    // means exactly "lowers". Threading the array registries matters for ok/bail,
    // not just op selection: `var a = mk()` (an array-returning call) is tracked
    // as an array only when `mk` is in arr_ret_fns, and a later `for x in a`
    // bails when its slot isn't array-typed; str_ret_fns likewise decides whether
    // `for b in greet()` (a string-returning-call iterable) types as a string and
    // lowers via the byte-foreach path (#2822). An empty registry here
    // under-approximates, routing such modules to the AST path even though they
    // lower; all three backends now thread the real registries through emission
    // too, so the gate and the emitter agree.
    var r: irlower.LowerResult = irlower.lower_func(fd, array_ret_fns(mod), mod.structs, irlower.str_ret_fns_of(mod.funcs), irlower.strarr_ret_fns_of(mod.funcs), irlower.opt_ret_fns_of(mod.funcs), irlower.i64_ret_fns_of(mod.funcs), irlower.tuple_ret_fns_of(mod.funcs), irlower.struct_ret_fns_of(mod.funcs, mod.structs), irlower.f64_ret_fns_of(mod.funcs), irlower.f64arr_ret_fns_of(mod.funcs), irlower.i64arr_ret_fns_of(mod.funcs), irlower.fn_param_sigs_of(mod.funcs), irlower.closure_ret_fns_of(mod.funcs));
    if (!r.ok) { return false; }
    return true;
}

// is_array_type reports whether a type string denotes an array (ends "[]").
function is_array_type(t: string): boolean {
    var n: i32 = t.len();
    if (n < 2) { return false; }
    return t[n - 2 : n] == "[]";
}

// array_ret_fns collects the names of functions whose return type is an array,
// so move-on-return / move-from-call fire (mirrors irlower.lower_module).
pub function array_ret_fns(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (is_array_type(mod.funcs[i].ret_type)) { out = out.append(mod.funcs[i].name); }
        i = i + 1;
    }
    return out;
}

// is_fern_helper reports whether a call_direct callee is one of the IR
// runtime helpers the emitter actually provides (emit_ir_runtime). These now
// use asm.fern's OWN stack-arg ABI + symbols (so the IR path is a drop-in for
// asm.fern's array RC) — see ir_helper_symbol for the name map. The whitelist
// is exact: any OTHER __fern_* / __rc_* call is NOT provided here, so
// calls_only_known disqualifies the module from the IR path and it falls back
// to the AST emitter. (__fern_heap_used has no asm.fern equivalent, so a
// program using it now routes through the AST path.)
pub function is_fern_helper(name: string): boolean {
    return name == "__fern_rc_inc"
        || name == "__fern_rc_dec"
        || name == "__fern_rc_underflow_get"
        // i32.to_string()'s decimal-text helper (emit_ir_runtime provides the
        // stack-arg body under __fn___fern_i32_to_string).
        || name == "__fern_i32_to_string";
}

// ir_helper_symbol maps an IR runtime-helper name to the asm.fern symbol the
// IR path calls (stack-arg ABI). The exit-sweep / reassign release
// (__fern_rc_dec) maps to __fn___fern_arr_dec — the array release that frees
// at rc==1 via the size-class freelist — so the IR path reclaims exactly as
// asm.fern's AST path does.
pub function ir_helper_symbol(name: string): string {
    if (name == "__fern_rc_inc") { return "__fn___fern_rc_inc"; }
    if (name == "__fern_rc_dec") { return "__fn___fern_arr_dec"; }
    if (name == "__fern_rc_underflow_get") { return "__fn___fern_rc_underflow_count"; }
    return "__fn_" + name;
}

// module_uses_heap reports whether any function allocates (so the runtime +
// heap need emitting).
// module_uses_maps reports whether any function uses a map op (so the map
// runtime + its __fern_str_eq / __fern_arr_push deps need emitting).
function module_uses_maps(mod: parser.Module): boolean {
    var noret: string[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var r: irlower.LowerResult = irlower.lower_func(mod.funcs[fi], noret, mod.structs, noret, noret, irlower.opt_ret_fns_of(mod.funcs), irlower.i64_ret_fns_of(mod.funcs), irlower.tuple_ret_fns_of(mod.funcs), irlower.struct_ret_fns_of(mod.funcs, mod.structs), irlower.f64_ret_fns_of(mod.funcs), irlower.f64arr_ret_fns_of(mod.funcs), irlower.i64arr_ret_fns_of(mod.funcs), irlower.fn_param_sigs_of(mod.funcs), irlower.closure_ret_fns_of(mod.funcs));
        var i: i32 = 0;
        while (i < r.ops.len()) {
            var k: string = r.ops[i].kind;
            if (k == "map_new" || k == "map_set" || k == "map_len") { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

function module_uses_heap(mod: parser.Module): boolean {
    var noret: string[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var r: irlower.LowerResult = irlower.lower_func(mod.funcs[fi], noret, mod.structs, noret, noret, irlower.opt_ret_fns_of(mod.funcs), irlower.i64_ret_fns_of(mod.funcs), irlower.tuple_ret_fns_of(mod.funcs), irlower.struct_ret_fns_of(mod.funcs, mod.structs), irlower.f64_ret_fns_of(mod.funcs), irlower.f64arr_ret_fns_of(mod.funcs), irlower.i64arr_ret_fns_of(mod.funcs), irlower.fn_param_sigs_of(mod.funcs), irlower.closure_ret_fns_of(mod.funcs));
        var i: i32 = 0;
        while (i < r.ops.len()) {
            // arr_make (array literal) is the allocating op now; `alloc` is
            // kept for any low-level allocation path. String literals and concat
            // also allocate (the 16-byte box + concat buffer), and struct_make
            // allocates the struct box — all pull in the heap/allocator runtime.
            if (r.ops[i].kind == "alloc" || r.ops[i].kind == "arr_make") { return true; }
            if (r.ops[i].kind == "const_str" || r.ops[i].kind == "str_concat") { return true; }
            if (r.ops[i].kind == "str_slice") { return true; }
            if (r.ops[i].kind == "struct_make") { return true; }
            if (r.ops[i].kind == "opt_make" || r.ops[i].kind == "opt_none") { return true; }
            if (r.ops[i].kind == "map_new" || r.ops[i].kind == "map_set") { return true; }
            if (r.ops[i].kind == "tuple_make") { return true; }
            // random_bytes allocates the byte buffer + string box; str_bytes
            // allocates the result u8[] (both via __fern_alloc / __fern_arr_box).
            if (r.ops[i].kind == "random_bytes" || r.ops[i].kind == "str_bytes") { return true; }
            // str_split allocates the result string[] + each segment box.
            if (r.ops[i].kind == "str_split") { return true; }
            // alloc_u8 / arr_push / str_from_bytes all allocate (via
            // __fern_alloc / __fern_arr_box) — pull in the heap runtime even for a
            // program whose ONLY allocation is `__alloc_u8(n)` (no array literal).
            if (r.ops[i].kind == "alloc_u8" || r.ops[i].kind == "arr_push" || r.ops[i].kind == "str_from_bytes") { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// emit_ir_str_search appends the scalar string search predicates
// (__fern_str_starts_with / _ends_with / _index_of), transcribed verbatim from
// asm.fern's str_search block. All three only read the two string boxes — no
// allocation, no calls — so they're emitted independently of the heap runtime
// (a predicate-only program is heap-free) and kept in their OWN function: folding
// them into emit_ir_runtime pushed it past the self-host's oversized-function
// miscompile threshold (#2720 — the stage-2 self-compile crashed with signal 9).
function emit_ir_str_search(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_str_starts_with:\n");
    s = s.write("    movq 8(%rsi), %rcx\n");
    s = s.write("    movq 8(%rdi), %rax\n");
    s = s.write("    cmpq %rcx, %rax\n");
    s = s.write("    jl .Lir_sw_no\n");
    s = s.write("    movq (%rdi), %rdi\n");
    s = s.write("    movq (%rsi), %rsi\n");
    s = s.write("    cmpq $0, %rcx\n");
    s = s.write("    je .Lir_sw_yes\n");
    s = s.write(".Lir_sw_loop:\n");
    s = s.write("    movzbq (%rdi), %rax\n");
    s = s.write("    movzbq (%rsi), %rdx\n");
    s = s.write("    cmpq %rdx, %rax\n");
    s = s.write("    jne .Lir_sw_no\n");
    s = s.write("    incq %rdi\n");
    s = s.write("    incq %rsi\n");
    s = s.write("    decq %rcx\n");
    s = s.write("    jne .Lir_sw_loop\n");
    s = s.write(".Lir_sw_yes:\n");
    s = s.write("    movq $1, %rax\n");
    s = s.write("    ret\n");
    s = s.write(".Lir_sw_no:\n");
    s = s.write("    movq $0, %rax\n");
    s = s.write("    ret\n");
    s = s.write("__fern_str_ends_with:\n");
    s = s.write("    movq 8(%rsi), %rcx\n");
    s = s.write("    movq 8(%rdi), %rax\n");
    s = s.write("    cmpq %rcx, %rax\n");
    s = s.write("    jl .Lir_ew_no\n");
    s = s.write("    subq %rcx, %rax\n");
    s = s.write("    movq (%rdi), %rdi\n");
    s = s.write("    addq %rax, %rdi\n");
    s = s.write("    movq (%rsi), %rsi\n");
    s = s.write("    cmpq $0, %rcx\n");
    s = s.write("    je .Lir_ew_yes\n");
    s = s.write(".Lir_ew_loop:\n");
    s = s.write("    movzbq (%rdi), %rax\n");
    s = s.write("    movzbq (%rsi), %rdx\n");
    s = s.write("    cmpq %rdx, %rax\n");
    s = s.write("    jne .Lir_ew_no\n");
    s = s.write("    incq %rdi\n");
    s = s.write("    incq %rsi\n");
    s = s.write("    decq %rcx\n");
    s = s.write("    jne .Lir_ew_loop\n");
    s = s.write(".Lir_ew_yes:\n");
    s = s.write("    movq $1, %rax\n");
    s = s.write("    ret\n");
    s = s.write(".Lir_ew_no:\n");
    s = s.write("    movq $0, %rax\n");
    s = s.write("    ret\n");
    s = s.write("__fern_str_index_of:\n");
    s = s.write("    movq 8(%rdi), %r8\n");
    s = s.write("    movq 8(%rsi), %r9\n");
    s = s.write("    cmpq $0, %r9\n");
    s = s.write("    je .Lir_idx_zero\n");
    s = s.write("    movq %r8, %r10\n");
    s = s.write("    subq %r9, %r10\n");
    s = s.write("    cmpq $0, %r10\n");
    s = s.write("    jl .Lir_idx_no\n");
    s = s.write("    movq (%rdi), %r11\n");
    s = s.write("    movq (%rsi), %rdi\n");
    s = s.write("    movq $0, %rcx\n");
    s = s.write(".Lir_idx_outer:\n");
    s = s.write("    cmpq %r10, %rcx\n");
    s = s.write("    jg .Lir_idx_no\n");
    s = s.write("    movq %rcx, %rdx\n");
    s = s.write("    movq $0, %r12\n");
    s = s.write("    pushq %r12\n");
    s = s.write("    movq $0, %r12\n");
    s = s.write(".Lir_idx_inner:\n");
    s = s.write("    cmpq %r9, %r12\n");
    s = s.write("    je .Lir_idx_match\n");
    s = s.write("    movq %r11, %rax\n");
    s = s.write("    addq %rcx, %rax\n");
    s = s.write("    addq %r12, %rax\n");
    s = s.write("    movzbq (%rax), %rdx\n");
    s = s.write("    movq %rdi, %rax\n");
    s = s.write("    addq %r12, %rax\n");
    s = s.write("    movzbq (%rax), %rax\n");
    s = s.write("    cmpq %rax, %rdx\n");
    s = s.write("    jne .Lir_idx_skip\n");
    s = s.write("    incq %r12\n");
    s = s.write("    jmp .Lir_idx_inner\n");
    s = s.write(".Lir_idx_skip:\n");
    s = s.write("    popq %r12\n");
    s = s.write("    incq %rcx\n");
    s = s.write("    jmp .Lir_idx_outer\n");
    s = s.write(".Lir_idx_match:\n");
    s = s.write("    popq %r12\n");
    s = s.write("    movq %rcx, %rax\n");
    s = s.write("    ret\n");
    s = s.write(".Lir_idx_zero:\n");
    s = s.write("    movq $0, %rax\n");
    s = s.write("    ret\n");
    s = s.write(".Lir_idx_no:\n");
    s = s.write("    movq $-1, %rax\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_random_i32 appends the __fern_random_i32() helper. Kept OUT of
// emit_ir_runtime (which is heap-gated) because random_i32 allocates nothing —
// a program that only calls random_i32 uses no heap, so its helper must still
// emit. getrandom(buf, 4, 0) into a 16-byte stack slot, reload as i32. (No
// asm.fern counterpart — legacy x86-64 lacked random_i32; new for the IR path,
// mirroring the Go backend.)
function emit_ir_random_i32(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_random_i32:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");        // 4-byte landing buffer (aligned)
    s = s.write("    leaq -16(%rbp), %rdi\n");  // getrandom(buf, 4, 0)
    s = s.write("    movq $4, %rsi\n");
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $318, %rax\n");
    s = s.write("    syscall\n");
    s = s.write("    movl -16(%rbp), %eax\n");  // 4 random bytes -> i32 (zero-extends)
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_monotonic_ns / emit_ir_now_unix_ms append the clock-reading helpers,
// transcribed verbatim from asm.fern's emit_runtime so the IR path is a
// byte-compatible drop-in for the AST path's clock builtins. Kept OUT of
// emit_ir_runtime (heap-gated) — a pure-scalar program that only times
// something allocates nothing, so its helper must still emit. clock_gettime is
// x86-64 syscall 228; the kernel writes a `struct timespec { i64 tv_sec; i64
// tv_nsec }`. Errno is ignored (fixed clock id + stack buffer we control).
function emit_ir_monotonic_ns(s: asmcore.EmitState): asmcore.EmitState {
    // monotonic_ns: CLOCK_MONOTONIC=1 → tv_sec*1e9 + tv_nsec.
    s = s.write("__fern_monotonic_ns:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $1, %rdi\n");           // CLOCK_MONOTONIC
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %rax\n");       // tv_sec
    s = s.write("    imulq $1000000000, %rax, %rax\n"); // sec * 1e9
    s = s.write("    addq 8(%rsp), %rax\n");      // + tv_nsec
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}
function emit_ir_now_unix_ms(s: asmcore.EmitState): asmcore.EmitState {
    // now_unix_ms: CLOCK_REALTIME=0 → tv_sec*1000 + tv_nsec/1e6.
    s = s.write("__fern_now_unix_ms:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $0, %rdi\n");           // CLOCK_REALTIME
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %r10\n");       // tv_sec
    s = s.write("    imulq $1000, %r10, %r10\n"); // sec * 1000
    s = s.write("    movq 8(%rsp), %rax\n");      // tv_nsec
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $1000000, %rcx\n");
    s = s.write("    divq %rcx\n");               // rax = nsec / 1e6
    s = s.write("    addq %r10, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_now_ns appends the __fern_now_ns() helper — wall-clock nanoseconds via
// clock_gettime(CLOCK_REALTIME) → tv_sec*1e9 + tv_nsec (the nanosecond twin of
// now_unix_ms). Allocation-free, gated on the now_ns need like the siblings.
function emit_ir_now_ns(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_now_ns:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $16, %rsp\n");          // timespec
    s = s.write("    movq $0, %rdi\n");           // CLOCK_REALTIME
    s = s.write("    movq %rsp, %rsi\n");         // &timespec
    s = s.write("    movq $228, %rax\n");         // clock_gettime
    s = s.write("    syscall\n");
    s = s.write("    movq (%rsp), %rax\n");       // tv_sec
    s = s.write("    imulq $1000000000, %rax, %rax\n"); // sec * 1e9
    s = s.write("    addq 8(%rsp), %rax\n");      // + tv_nsec
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_sleep_ms appends the __fern_sleep_ms(%rdi = ms) helper, transcribed
// verbatim from asm.fern's emit_runtime: split ms into a timespec
// {sec=ms/1000, nsec=(ms%1000)*1e6} on the stack and nanosleep (syscall 35);
// ms <= 0 returns immediately. Allocation-free, so emitted independently of the
// heap runtime (gated on the sleep_ms need), like the clock helpers.
function emit_ir_sleep_ms(s: asmcore.EmitState): asmcore.EmitState {
    s = s.write("__fern_sleep_ms:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    subq $32, %rsp\n");
    s = s.write("    cmpq $0, %rdi\n");
    s = s.write("    jle .Lir_sm_done\n");
    s = s.write("    movq %rdi, %rax\n");
    s = s.write("    movq $0, %rdx\n");
    s = s.write("    movq $1000, %rcx\n");
    s = s.write("    divq %rcx\n");
    s = s.write("    movq %rax, (%rsp)\n");
    s = s.write("    movq $1000000, %rax\n");
    s = s.write("    imulq %rdx, %rax\n");
    s = s.write("    movq %rax, 8(%rsp)\n");
    s = s.write("    movq %rsp, %rdi\n");
    s = s.write("    movq $0, %rsi\n");
    s = s.write("    movq $35, %rax\n");
    s = s.write("    syscall\n");
    s = s.write(".Lir_sm_done:\n");
    s = s.write("    addq $32, %rsp\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    return s;
}

// emit_ir_runtime appends the array/RC/heap runtime the IR path needs, using
// asm.fern's OWN array layout + helper bodies (transcribed verbatim from
// asm.fern's emit_runtime) so the IR path is a byte-compatible DROP-IN: the
// 8-byte rc-header box (base = [cap, rc, len, e0..]; data = base+16; cap at
// data-16, rc at data-8, element i at data+(i+1)*8), the size-classed
// __fern_freelist allocator, and the stack-ABI rc helpers
// (__fn___fern_rc_inc / __fn___fern_arr_dec / …). asm.fern imports asm_ir
// (not the reverse), so these bodies are duplicated here rather than shared;
// the two emit paths are mutually exclusive per compile (emit_module vs
// emit_module_ir), so there is no symbol clash. Keep in sync with asm.fern.
function emit_ir_runtime(s: asmcore.EmitState): asmcore.EmitState {
    // .bss: heap bump pointer, the over-release detector, the size-classed
    // freelist (65536 classes * 8 bytes), and a 1 GiB zero-page heap.
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
