// examples/self_host/asm_ir.fern — the IR code path for the production
// x86-64 backend, the first integration of the native-shaped stack IR
// (ir.fern / irlower.fern) into asm.fern's world (docs/RC-PERCEUS-SELF-HOST-
// IR-REBUILD.md §3). emit_module_ir lowers each function AST -> stack IR ->
// asm and instruction-selects it into asm.fern's OWN dialect: same
// `__fn_<name>:` label, same rbp frame + leave/ret, same machine-stack
// operand discipline (every value `pushq`-ed, consumers `popq`), so an
// IR-emitted function is ABI-identical to an AST-emitted one — and the two
// must produce identical behaviour (the differential gate).
//
// SCOPE (slice 16): pure i32 functions — no params, no user calls, no arrays
// — proving the seam end-to-end. asm.fern itself is UNCHANGED (this module is
// imported only by asm_run via its `-ir` flag), so the byte-identical
// self-bootstrap and every asm.fern-based harness are unaffected. emit_module_ir
// only handles modules where EVERY function is eligible (all_eligible); the
// driver falls back to asm.emit_module otherwise. As the eligible subset
// widens, this folds back into asm.fern's emit_module behind a flag.

import "./parser";
import "./asmcore";
import "./util";
import "./ir";
import "./irlower";

// ir_eligible reports whether a function is in the IR path's current subset:
// i32 functions with params, direct calls, and arrays (heap alloc / index /
// write / len + Perceus RC, including borrowed array params and array returns
// via move-on-return) — but no methods. Cross-function arrays are sound here
// because the IR path only fires when the WHOLE module is eligible
// (all_eligible), so every function — caller and callee — uses irlower's
// array layout; nothing crosses an IR/AST boundary.
pub function ir_eligible(fd: parser.FuncDecl): boolean {
    if (fd.receiver_name.len() > 0) { return false; }
    var noret: string[] = [];
    var r: irlower.LowerResult = irlower.lower_func(fd, noret);
    if (!r.ok) { return false; }
    return true;
}

// is_array_type reports whether a type string denotes an array (ends "[]").
function is_array_type(t: string): boolean {
    var n: i32 = t.len();
    if (n < 2) { return false; }
    return t[n - 2 : n] == "[]";
}

// array_ret_fns collects the names of functions whose return type is an array,
// so move-on-return / move-from-call fire (mirrors irlower.lower_module).
pub function array_ret_fns(mod: parser.Module): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (is_array_type(mod.funcs[i].ret_type)) { out = out.append(mod.funcs[i].name); }
        i = i + 1;
    }
    return out;
}

// is_fern_helper reports whether a call_direct callee is one of the IR
// runtime helpers the emitter actually provides (emit_ir_runtime). These now
// use asm.fern's OWN stack-arg ABI + symbols (so the IR path is a drop-in for
// asm.fern's array RC) — see ir_helper_symbol for the name map. The whitelist
// is exact: any OTHER __fern_* / __rc_* call is NOT provided here, so
// calls_only_known disqualifies the module from the IR path and it falls back
// to the AST emitter. (__fern_heap_used has no asm.fern equivalent, so a
// program using it now routes through the AST path.)
pub function is_fern_helper(name: string): boolean {
    return name == "__fern_rc_inc"
        || name == "__fern_rc_dec"
        || name == "__fern_rc_underflow_get";
}

// ir_helper_symbol maps an IR runtime-helper name to the asm.fern symbol the
// IR path calls (stack-arg ABI). The exit-sweep / reassign release
// (__fern_rc_dec) maps to __fn___fern_arr_dec — the array release that frees
// at rc==1 via the size-class freelist — so the IR path reclaims exactly as
// asm.fern's AST path does.
pub function ir_helper_symbol(name: string): string {
    if (name == "__fern_rc_inc") { return "__fn___fern_rc_inc"; }
    if (name == "__fern_rc_dec") { return "__fn___fern_arr_dec"; }
    if (name == "__fern_rc_underflow_get") { return "__fn___fern_rc_underflow_count"; }
    return "__fn_" + name;
}

// module_uses_heap reports whether any function allocates (so the runtime +
// heap need emitting).
function module_uses_heap(mod: parser.Module): boolean {
    var noret: string[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var r: irlower.LowerResult = irlower.lower_func(mod.funcs[fi], noret);
        var i: i32 = 0;
        while (i < r.ops.len()) {
            // arr_make (array literal) is the allocating op now; `alloc` is
            // kept for any low-level allocation path.
            if (r.ops[i].kind == "alloc" || r.ops[i].kind == "arr_make") { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// emit_ir_runtime appends the array/RC/heap runtime the IR path needs, using
// asm.fern's OWN array layout + helper bodies (transcribed verbatim from
// asm.fern's emit_runtime) so the IR path is a byte-compatible DROP-IN: the
// 8-byte rc-header box (base = [cap, rc, len, e0..]; data = base+16; cap at
// data-16, rc at data-8, element i at data+(i+1)*8), the size-classed
// __fern_freelist allocator, and the stack-ABI rc helpers
// (__fn___fern_rc_inc / __fn___fern_arr_dec / …). asm.fern imports asm_ir
// (not the reverse), so these bodies are duplicated here rather than shared;
// the two emit paths are mutually exclusive per compile (emit_module vs
// emit_module_ir), so there is no symbol clash. Keep in sync with asm.fern.
function emit_ir_runtime(s: asmcore.EmitState): asmcore.EmitState {
    // .bss: heap bump pointer, the over-release detector, the size-classed
    // freelist (65536 classes * 8 bytes), and a 1 GiB zero-page heap.
    s = s.write("    .section .bss\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_heap_ptr: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_rc_underflow: .quad 0\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_freelist: .skip 524288\n");
    s = s.write("    .align 8\n");
    s = s.write("__fern_heap: .skip 1073741824\n");
    s = s.write("    .section .text\n");
    // __fern_alloc(%rdi = bytes) -> %rax = block. Size-classed freelist reuse
    // (class = bytes/8 < 65536) then bump; OOM traps with exit 137.
    s = s.write("__fern_alloc:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    addq $7, %rdi\n");
    s = s.write("    andq $-8, %rdi\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    pushq %rdx\n");
    s = s.write("    movq %rdi, %rcx\n");
    s = s.write("    shrq $3, %rcx\n");
    s = s.write("    cmpq $65536, %rcx\n");
    s = s.write("    jae .Lalloc_nofl\n");
    s = s.write("    leaq __fern_freelist(%rip), %rdx\n");
    s = s.write("    movq (%rdx,%rcx,8), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lalloc_nofl\n");
    s = s.write("    movq (%rax), %rdi\n");
    s = s.write("    movq %rdi, (%rdx,%rcx,8)\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_nofl:\n");
    s = s.write("    popq %rdx\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jne .Lalloc_inited\n");
    s = s.write("    leaq __fern_heap(%rip), %rax\n");
    s = s.write("    movq %rax, __fern_heap_ptr(%rip)\n");
    s = s.write(".Lalloc_inited:\n");
    s = s.write("    movq __fern_heap_ptr(%rip), %rax\n");
    s = s.write("    addq %rax, %rdi\n");
    s = s.write("    pushq %rcx\n");
    s = s.write("    leaq __fern_heap(%rip), %rcx\n");
    s = s.write("    addq $1073741824, %rcx\n");
    s = s.write("    cmpq %rcx, %rdi\n");
    s = s.write("    popq %rcx\n");
    s = s.write("    ja .Lalloc_oom\n");
    s = s.write("    movq %rdi, __fern_heap_ptr(%rip)\n");
    s = s.write("    popq %rbp\n");
    s = s.write("    ret\n");
    s = s.write(".Lalloc_oom:\n");
    s = s.write("    movq $60, %rax\n");
    s = s.write("    movq $137, %rdi\n");
    s = s.write("    syscall\n");
    // __fern_arr_box(%rdi = cap element count) -> %rax = data ptr (base+16).
    // base = [cap, rc=1, len=cap, e0..]; element i at data+(i+1)*8.
    s = s.write("__fern_arr_box:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    pushq %rdi\n");
    s = s.write("    addq $3, %rdi\n");
    s = s.write("    shlq $3, %rdi\n");
    s = s.write("    call __fern_alloc\n");
    s = s.write("    movq -8(%rbp), %rdi\n");
    s = s.write("    movq %rdi, (%rax)\n");
    s = s.write("    movq $1, 8(%rax)\n");
    s = s.write("    movq %rdi, 16(%rax)\n");
    s = s.write("    addq $16, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    // RC helpers — stack-arg ABI (arg at 8(%rsp)); rc is the 32-bit field at
    // data-8. Guard chain: null / SSO inline tag / low-address / static
    // sentinel. __fn___fern_arr_dec frees (size-class freelist) at rc==1.
    s = s.write("__fn___fern_rc_inc:\n");
    s = s.write("    movq 8(%rsp), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Lshrcinc_ret\n");
    s = s.write("    testb $1, %al\n");
    s = s.write("    jnz .Lshrcinc_ret\n");
    s = s.write("    cmpq $0x10000, %rax\n");
    s = s.write("    jb .Lshrcinc_ret\n");
    s = s.write("    movl -8(%rax), %ecx\n");
    s = s.write("    testl %ecx, %ecx\n");
    s = s.write("    js .Lshrcinc_ret\n");
    s = s.write("    addl $1, %ecx\n");
    s = s.write("    movl %ecx, -8(%rax)\n");
    s = s.write(".Lshrcinc_ret:\n");
    s = s.write("    ret\n");
    s = s.write("__fn___fern_rc_underflow_count:\n");
    s = s.write("    movl __fern_rc_underflow(%rip), %eax\n");
    s = s.write("    ret\n");
    s = s.write("__fn___fern_arr_dec:\n");
    s = s.write("    movq 8(%rsp), %rax\n");
    s = s.write("    testq %rax, %rax\n");
    s = s.write("    jz .Larrdec_ret\n");
    s = s.write("    cmpq $0x10000, %rax\n");
    s = s.write("    jb .Larrdec_ret\n");
    s = s.write("    movl -8(%rax), %ecx\n");
    s = s.write("    testl %ecx, %ecx\n");
    s = s.write("    js .Larrdec_ret\n");
    s = s.write("    cmpl $1, %ecx\n");
    s = s.write("    je .Larrdec_free\n");
    s = s.write("    jg .Larrdec_dec\n");
    s = s.write("    incl __fern_rc_underflow(%rip)\n");
    s = s.write("    jmp .Larrdec_ret\n");
    s = s.write(".Larrdec_dec:\n");
    s = s.write("    subl $1, %ecx\n");
    s = s.write("    movl %ecx, -8(%rax)\n");
    s = s.write("    jmp .Larrdec_ret\n");
    s = s.write(".Larrdec_free:\n");
    s = s.write("    movl $0, -8(%rax)\n");
    s = s.write("    movl -16(%rax), %ecx\n");
    s = s.write("    addq $3, %rcx\n");
    s = s.write("    cmpq $65536, %rcx\n");
    s = s.write("    jae .Larrdec_ret\n");
    s = s.write("    leaq -16(%rax), %rdx\n");
    s = s.write("    leaq __fern_freelist(%rip), %r8\n");
    s = s.write("    movq (%r8,%rcx,8), %rdi\n");
    s = s.write("    movq %rdi, (%rdx)\n");
    s = s.write("    movq %rdx, (%r8,%rcx,8)\n");
    s = s.write(".Larrdec_ret:\n");
    s = s.write("    ret\n");
    return s;
}

// all_eligible reports whether every function in the module is IR-eligible
// AND every direct call targets a function defined in the module (or an IR
// runtime helper). A call to a BUILTIN (read_int / print_int / chr /
// i32_to_string / ...) lowers to call_direct but has no `__fn_<name>` body —
// the IR path can't emit it, so such modules fall back to the AST emitter
// (which handles builtins in emit_expr). The whole module goes one way or the
// other, so a single builtin call disqualifies the IR path for the module.
pub function all_eligible(mod: parser.Module): boolean {
    if (mod.funcs.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (!ir_eligible(mod.funcs[i])) { return false; }
        if (!calls_only_known(mod.funcs[i], mod)) { return false; }
        i = i + 1;
    }
    return true;
}

// module_has_func reports whether `name` is a function defined in the module.
function module_has_func(mod: parser.Module, name: string): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].name == name) { return true; }
        i = i + 1;
    }
    return false;
}

// calls_only_known reports whether every direct call in fd targets a module
// function or an IR runtime helper (not a builtin).
function calls_only_known(fd: parser.FuncDecl, mod: parser.Module): boolean {
    var noret: string[] = [];
    var r: irlower.LowerResult = irlower.lower_func(fd, noret);
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind == "call_direct") {
            if (!is_fern_helper(o.str) && !module_has_func(mod, o.str)) { return false; }
        }
        i = i + 1;
    }
    return true;
}

// ir_bin_asm renders the asm for one IR binary op (lhs in %rax, rhs in %rcx,
// result in %rax) — mirroring asm.fern's own ExprBinary sequences (64-bit,
// signed i32 div/cmp) so the two paths agree exactly.
function ir_bin_asm(kind: string): string {
    if (kind == "add") { return "    addq %rcx, %rax\n"; }
    if (kind == "sub") { return "    subq %rcx, %rax\n"; }
    if (kind == "mul") { return "    imulq %rcx, %rax\n"; }
    if (kind == "div_s") { return "    movslq %eax, %rax\n    movslq %ecx, %rcx\n    cqto\n    idivq %rcx\n"; }
    if (kind == "rem_s") { return "    movslq %eax, %rax\n    movslq %ecx, %rcx\n    cqto\n    idivq %rcx\n    movq %rdx, %rax\n"; }
    if (kind == "and") { return "    andq %rcx, %rax\n"; }
    if (kind == "or") { return "    orq %rcx, %rax\n"; }
    if (kind == "xor") { return "    xorq %rcx, %rax\n"; }
    if (kind == "shl") { return "    shlq %cl, %rax\n"; }
    if (kind == "shr_s") { return "    sarq %cl, %rax\n"; }
    if (kind == "eq") { return "    cmpq %rcx, %rax\n    sete %al\n    movzbq %al, %rax\n"; }
    if (kind == "ne") { return "    cmpq %rcx, %rax\n    setne %al\n    movzbq %al, %rax\n"; }
    if (kind == "lt_s") { return "    cmpq %rcx, %rax\n    setl %al\n    movzbq %al, %rax\n"; }
    if (kind == "le_s") { return "    cmpq %rcx, %rax\n    setle %al\n    movzbq %al, %rax\n"; }
    if (kind == "gt_s") { return "    cmpq %rcx, %rax\n    setg %al\n    movzbq %al, %rax\n"; }
    if (kind == "ge_s") { return "    cmpq %rcx, %rax\n    setge %al\n    movzbq %al, %rax\n"; }
    return "    # ir: unsupported bin " + kind + "\n";
}

// br_target resolves a `br d` / `br_if d` at op index `i` to its label: a
// loop scope -> its header label (the loop op's index); a block/if scope ->
// the label at its matching `end`. Uses irlower's nesting scanners — no
// threaded scope-stack state (a self-host-robust formulation; the earlier
// grow-and-overwrite string[] scope arrays mis-ran under the self-hosted
// compiler).
pub function br_target(ops: ir.Op[], lp: string, i: i32, d: i32): string {
    var op: i32 = irlower.enclosing_opener(ops, i, d);
    if (ops[op].kind == "loop") { return lp + util.i32_to_string(op); }
    return lp + util.i32_to_string(irlower.find_matching_end(ops, op + 1));
}

// emit_function_via_ir emits one IR-eligible function via the stack IR,
// writing through the global strbuf (same as asm.fern's emitters).
// arr_ret_fns drives move-on-return / move-from-call for array values.
function emit_function_via_ir(fd: parser.FuncDecl, arr_ret_fns: string[], s: asmcore.EmitState): asmcore.EmitState {
    var r: irlower.LowerResult = irlower.lower_func(fd, arr_ret_fns);

    s = s.write("__fn_" + asmcore.sanitize_label(fd.name) + ":\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    var frame: i32 = r.n_locals * 8;
    if (frame % 16 != 0) { frame = frame + 8; }
    if (frame > 0) { s = s.write("    subq $" + util.i32_to_string(frame) + ", %rsp\n"); }

    // Zero-init the body-local slots (Perceus exit-sweep safety, matching
    // asm.fern): a `var` decl skipped on an untaken branch leaves its slot
    // readable by the release sweep, which must see NULL (arr_dec no-ops)
    // rather than stack garbage. Body locals are slots [n_params, n_locals);
    // slot i is at -8*(i+1)(%rbp), so the range's lowest address is
    // -8*n_locals(%rbp) and it holds (n_locals - n_params) quadwords. rep
    // stosq clobbers rax/rcx/rdi, dead here (before the param copy).
    var nbody: i32 = r.n_locals - r.n_params;
    if (nbody > 0) {
        s = s.write("    leaq " + util.i32_to_string(0 - r.n_locals * 8) + "(%rbp), %rdi\n");
        s = s.write("    movq $" + util.i32_to_string(nbody) + ", %rcx\n");
        s = s.write("    xorq %rax, %rax\n");
        s = s.write("    cld\n");
        s = s.write("    rep stosq\n");
    }

    // Copy params from the caller stack into their local slots, exactly as
    // emit_function does: param[i] sits at +(16 + i*8)(%rbp); the IR's
    // load_local i reads -8*(i+1)(%rbp). (No receiver — methods are excluded.)
    var pidx: i32 = 0;
    while (pidx < fd.params.len()) {
        s = s.write("    movq " + util.i32_to_string(16 + pidx * 8) + "(%rbp), %rax\n");
        s = s.write("    movq %rax, " + util.i32_to_string(0 - 8 * (pidx + 1)) + "(%rbp)\n");
        pidx = pidx + 1;
    }

    // Structured control flow -> flat labels, derived from OP-STREAM INDICES
    // (no threaded scope stack): the label at op index `j` is `lp<j>`. An `if`
    // jumps to its matching `else` (or `end`); `else`/`loop`/`end` define the
    // label at their own index; `br`/`br_if` resolve via br_target. Branch
    // matching reuses irlower's nesting scanners.
    var lp: string = ".Lir_" + asmcore.sanitize_label(fd.name) + "_";
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind == "const_i32") {
            s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", %rax\n    pushq %rax\n");
        } else if (o.kind == "load_local") {
            s = s.write("    pushq " + util.i32_to_string(0 - 8 * (o.i32_imm + 1)) + "(%rbp)\n");
        } else if (o.kind == "store_local") {
            s = s.write("    popq %rax\n    movq %rax, " + util.i32_to_string(0 - 8 * (o.i32_imm + 1)) + "(%rbp)\n");
        } else if (o.kind == "not") {
            s = s.write("    popq %rax\n    testq %rax, %rax\n    setz %al\n    movzbq %al, %rax\n    pushq %rax\n");
        } else if (o.kind == "return") {
            s = s.write("    popq %rax\n    leave\n    ret\n");
        } else if (o.kind == "if") {
            // jump to the matching else (if any) or end when the cond is false.
            var elseidx: i32 = irlower.find_matching_else(r.ops, i + 1);
            var tgt: string = "";
            if (elseidx >= 0) { tgt = lp + util.i32_to_string(elseidx); }
            else { tgt = lp + util.i32_to_string(irlower.find_matching_end(r.ops, i + 1)); }
            s = s.write("    popq %rax\n    testq %rax, %rax\n    jz " + tgt + "\n");
        } else if (o.kind == "else") {
            // end of the then-arm jumps past the else; land the false path here.
            s = s.write("    jmp " + lp + util.i32_to_string(irlower.find_matching_end(r.ops, i + 1)) + "\n");
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else if (o.kind == "block") {
            // forward scope: its exit label is defined at the matching `end`.
        } else if (o.kind == "loop") {
            // backward scope: header label, branched to by `br`.
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else if (o.kind == "br") {
            s = s.write("    jmp " + br_target(r.ops, lp, i, o.i32_imm) + "\n");
        } else if (o.kind == "brif") {
            s = s.write("    popq %rax\n    testq %rax, %rax\n    jnz " + br_target(r.ops, lp, i, o.i32_imm) + "\n");
        } else if (o.kind == "arr_make") {
            // n element values on the operand stack (element n-1 on top).
            // asm.fern 8-byte layout via __fern_arr_box: data = base+16, rc=1,
            // len=n, element i at data+(i+1)*8. Pop top-down (element n-1 →
            // slot n .. element 0 → slot 1); base stays live in %rax across the
            // pops (they only touch the operand stack), then push it.
            var n: i32 = o.i32_imm;
            s = s.write("    movq $" + util.i32_to_string(n) + ", %rdi\n");
            s = s.write("    call __fern_arr_box\n");
            var em: i32 = n - 1;
            while (em >= 0) {
                s = s.write("    popq %rcx\n    movq %rcx, " + util.i32_to_string((em + 1) * 8) + "(%rax)\n");
                em = em - 1;
            }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "arr_get") {
            // pop idx (top), base; element at data+(idx+1)*8.
            s = s.write("    popq %rcx\n    popq %rax\n    incq %rcx\n    movq (%rax,%rcx,8), %rax\n    pushq %rax\n");
        } else if (o.kind == "arr_set") {
            // pop val (top), idx, base; store at data+(idx+1)*8.
            s = s.write("    popq %rdx\n    popq %rcx\n    popq %rax\n    incq %rcx\n    movq %rdx, (%rax,%rcx,8)\n");
        } else if (o.kind == "arr_len") {
            // pop base; length header at data+0.
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind == "arr_rc") {
            // pop base; 32-bit refcount field at data-8.
            s = s.write("    popq %rax\n    movl -8(%rax), %eax\n    pushq %rax\n");
        } else if (o.kind == "drop") {
            s = s.write("    addq $8, %rsp\n");
        } else if (o.kind == "call_direct" && is_fern_helper(o.str)) {
            // Runtime RC helper — asm.fern's stack-arg ABI + symbols (drop-in):
            // the arg(s) are already on the operand stack (the helper reads
            // 8(%rsp)); call, caller-clean the args, push the result. The
            // helpers return the ptr (rc_inc / arr_dec) or the count
            // (underflow_count) in %rax.
            s = s.write("    call " + ir_helper_symbol(o.str) + "\n");
            if (o.i32_imm > 0) { s = s.write("    addq $" + util.i32_to_string(o.i32_imm * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "call_direct") {
            // User call: the IR pushes args left-to-right (arg0 deepest);
            // asm.fern's stack ABI wants arg0 on TOP (param[i] at +16+i*8(%rbp)).
            // Reverse the argc on-stack slots, call, pop the args, push %rax.
            var argc: i32 = o.i32_imm;
            var h: i32 = 0;
            while (h < argc / 2) {
                var lo: i32 = h * 8;
                var hi: i32 = (argc - 1 - h) * 8;
                s = s.write("    movq " + util.i32_to_string(lo) + "(%rsp), %rax\n");
                s = s.write("    movq " + util.i32_to_string(hi) + "(%rsp), %rcx\n");
                s = s.write("    movq %rax, " + util.i32_to_string(hi) + "(%rsp)\n");
                s = s.write("    movq %rcx, " + util.i32_to_string(lo) + "(%rsp)\n");
                h = h + 1;
            }
            s = s.write("    call __fn_" + asmcore.sanitize_label(o.str) + "\n");
            if (argc > 0) { s = s.write("    addq $" + util.i32_to_string(argc * 8) + ", %rsp\n"); }
            s = s.write("    pushq %rax\n");
        } else if (o.kind == "end") {
            // Define the label at this end's index — the target of the if/else
            // that opened it (no-else if's jz, else's jmp) or a block's br.
            // A loop's closing end is unused (harmless).
            s = s.write(lp + util.i32_to_string(i) + ":\n");
        } else {
            // binary op: pop rhs (rcx), lhs (rax), combine, push.
            s = s.write("    popq %rcx\n    popq %rax\n");
            s = s.write(ir_bin_asm(o.kind));
            s = s.write("    pushq %rax\n");
        }
        i = i + 1;
    }

    // Fallback (subset functions always end in `return`).
    s = s.write("    movq $0, %rax\n");
    s = s.write("    leave\n");
    s = s.write("    ret\n");
    return s;
}

// emit_module_ir emits a full all-i32-eligible module via the IR path. The
// program is self-contained (pure i32 uses no runtime helpers): every
// function via the IR, then a `_start` that calls __fn_main and exits with
// its result. Caller must ensure all_eligible(mod).
pub function emit_module_ir(mod: parser.Module): string {
    strbuf_reset();
    var s: asmcore.EmitState = asmcore.new_state();
    s = asmcore.EmitState { ...s, struct_decls: mod.structs, funcs: mod.funcs };
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    var arf: string[] = array_ret_fns(mod);
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        s = emit_function_via_ir(mod.funcs[fi], arf, s);
        fi = fi + 1;
    }
    s = s.write("_start:\n");
    s = s.write("    pushq %rbp\n");
    s = s.write("    movq %rsp, %rbp\n");
    s = s.write("    call __fn_main\n");
    s = s.write("    movq %rax, %rdi\n");
    s = s.write("    movq $60, %rax\n");
    s = s.write("    syscall\n");
    // The freestanding allocator + RC runtime, only when the program allocates.
    if (module_uses_heap(mod)) { s = emit_ir_runtime(s); }
    return strbuf_take();
}
