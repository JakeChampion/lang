    s = s.write("    leaq __fern_freelist(%rip), %r8\n");
    s = s.write("    movq (%r8,%rdx,8), %rsi\n");   // old head of class `words`
    s = s.write("    movq %rsi, (%rcx)\n");         // *data = old head
    s = s.write("    movq %rcx, (%r8,%rdx,8)\n");   // freelist[words] = data
    s = s.write(".Lstrfree_box:\n");
