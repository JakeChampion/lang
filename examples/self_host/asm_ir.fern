    s = s.write("    movq $2, %rdi\n");
    s = s.write("    leaq .Lalloc_size_msg(%rip), %rsi\n");
    s = s.write("    movq $35, %rdx\n");
    s = s.write("    syscall\n");
    s = s.write("    movq $60, %rax\n");
