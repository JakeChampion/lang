    s = s.write("    leaq -8(%rax), %rdx\n");       // base = box-8
    s = hev_free(s, "%rdx", "$3");
    s = s.write("    leaq __fern_freelist(%rip), %r8\n");
    s = s.write("    movq 24(%r8), %rsi\n");        // freelist[3] (24-byte block = 3 words)
    s = s.write("    movq %rsi, (%rdx)\n");         // *base = old head
