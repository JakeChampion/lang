        s = s.write("    cmpq $0, %rax\n");
        s = s.write("    jge .Liri2s_pos\n");
        s = s.write("    negq %rax\n");
        s = s.write("    movq $1, %r10\n");
        s = s.write(".Liri2s_pos:\n");
        s = s.write("    leaq 31(%r12), %rsi\n");      // cursor (writes backwards)
        s = s.write("    movq $0, %r8\n");             // digit count
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Liri2s_div\n");
        s = s.write("    movb $48, (%rsi)\n");
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write("    jmp .Liri2s_sign\n");
        s = s.write(".Liri2s_div:\n");
        s = s.write("    movq $0, %rdx\n");
        s = s.write("    movq $10, %rcx\n");
        s = s.write("    divq %rcx\n");
        s = s.write("    addq $48, %rdx\n");
        s = s.write("    movb %dl, (%rsi)\n");
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write("    testq %rax, %rax\n");
        s = s.write("    jne .Liri2s_div\n");
        s = s.write(".Liri2s_sign:\n");
        s = s.write("    cmpq $0, %r10\n");
        s = s.write("    je .Liri2s_no_neg\n");
        s = s.write("    movb $45, (%rsi)\n");
        s = s.write("    decq %rsi\n");
        s = s.write("    incq %r8\n");
        s = s.write(".Liri2s_no_neg:\n");
        s = s.write("    incq %rsi\n");                // first char ptr
        s = s.write("    pushq %rsi\n");
        s = s.write("    pushq %r8\n");
        s = s.write("    movq $16, %rdi\n");
        s = s.write("    call __fern_alloc\n");
        s = s.write("    popq %r8\n");
        s = s.write("    popq %rsi\n");
        s = s.write("    movq %rsi, (%rax)\n");
