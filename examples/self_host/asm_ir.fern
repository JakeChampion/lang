            // Option/Result box [tag@0, payload@8], 2 words. rc-HEADERED via
            // __fern_arr_box(cap=2) — exactly like struct_make/tuple_make — so a
            // fresh, single-owner, dead-after-match scalar Option local can be freed
            // (__fern_rc_dec) after its consuming match. Offsets unchanged (arr_box's
            // len@0 word is overwritten by the tag; cap@data-16 drives the free size).
            // Payload is on the operand stack; alloc first (it survives on the
            // machine stack, like struct_make), then store tag + payload.
            s = s.write("    movq $2, %rdi\n    call __fern_arr_box\n");
            s = s.write("    movq $" + util.i32_to_string(o.i32_imm) + ", (%rax)\n");
            s = s.write("    popq %rcx\n    movq %rcx, 8(%rax)\n    pushq %rax\n");
        } else if (o.kind_tag == 121) {  // opt_none
            // Payloadless box with tag 1 (None), rc-headered (arr_box cap=2).
            s = s.write("    movq $2, %rdi\n    call __fern_arr_box\n");
            s = s.write("    movq $1, (%rax)\n    movq $0, 8(%rax)\n    pushq %rax\n");
        } else if (o.kind_tag == 122) {  // opt_tag
            // pop box; tag is the i32 at offset 0.
            s = s.write("    popq %rax\n    movq (%rax), %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 123) {  // opt_payload
            // pop box; payload is at offset 8.
            s = s.write("    popq %rax\n    movq 8(%rax), %rax\n    pushq %rax\n");
        } else if (o.kind_tag == 124) {  // map_new
            s = s.write("    popq %rdi\n    call __fern_map_new\n    pushq %rax\n");
        } else if (o.kind_tag == 161) {  // print_int
            // [n] -> write n's decimal text to stdout (the AST path's helper +
            // symbol). Push the syscall return so the statement-level drop balances.
            s = s.write("    popq %rdi\n    call __fern_print_int\n    pushq %rax\n");
            s = s.need("print_int");
        } else if (o.kind_tag == 163) {  // print_str
            // [strbox] -> write its bytes to stdout (the AST path's __fern_print_str).
            // Push the syscall return so the statement-level drop balances.
