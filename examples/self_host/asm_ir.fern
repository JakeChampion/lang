    s = s.write("    leaq 0(,%rdx,8), %rsi\n");      // bytes = words*8
    s = s.write("    pushq %rax\n");                 // preserve box across the call
    s = s.write("    call __fern_large_push\n");
    s = s.write("    popq %rax\n");
    s = s.write("    jmp .Lstrfree_box\n");
    s = s.write(".Lstrfree_dec:\n");
    s = s.write("    subl $1, %ecx\n");
    s = s.write("    movl %ecx, -8(%rax)\n");
    s = s.write("    jmp .Lstrfree_ret\n");
    s = s.write(".Lstrfree_uf:\n");
    s = s.write("    incl __fern_rc_underflow(%rip)\n");
    s = s.write(".Lstrfree_ret:\n");
    s = s.write("    ret\n");
