// count_locals walks a stmt body recursively (into if / while
// bodies) to determine the total number of `var` decls. The
// result feeds the prologue's `sub sp, sp, #<N*8>` so the
// frame has enough room for every local that might be live.
// Conservative: counts every var even if branches make them
// mutually exclusive at runtime — fine for stack allocation.
function count_locals(body: parser.Stmt[]): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < body.len()) {
        n = n + count_locals_in_stmt(body[i]);
        i = i + 1;
    }
    return n;
}

function count_locals_in_stmt(stmt: parser.Stmt): i32 {
    match (stmt) {
        parser.StmtVar(_) => { return 1; },
        parser.StmtIf(ifs) => { return count_locals(ifs.then_body) + count_locals(ifs.else_body); },
        parser.StmtWhile(w) => { return count_locals(w.body); },
        parser.StmtMatch(m) => {
            // +1 for the synthetic scrutinee local + one per
            // non-empty PatVariant binding + the recursive body
            // counts. Wildcard arms add no binding.
            var n: i32 = 1;
            var i: i32 = 0;
            while (i < m.arms.len()) {
                match (m.arms[i].pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.binding.len() > 0 && pv.binding != "_") { n = n + 1; }
                    },
                    parser.PatWildcard(_) => { }
                }
                n = n + count_locals(m.arms[i].body);
                i = i + 1;
            }
            return n;
        },
        parser.StmtFor(f) => {
            // +1 for the synthetic array-pointer slot, +1 for
            // the loop counter, +1 for the bound element var,
            // + body locals.
            return 3 + count_locals(f.body);
        },
        _ => { return 0; }
    }
    return 0;
}

// add_string_lit appends the literal to the pool and returns
// its index, used by the caller to emit `adrp + add` for the
// literal's address. The pool is materialised in .rodata at
// end-of-module.
struct StringLitOut { state: EmitState, idx: i32 }
function add_string_lit(s: EmitState, v: string): StringLitOut {
    // Dedup: load-bearing for shape-pointer dispatch in
    // ExprFieldAccess + StmtMatch. See asm.lang for rationale.
    var i: i32 = 0;
    while (i < s.string_lits.len()) {
        if (s.string_lits[i] == v) {
            return StringLitOut { state: s, idx: i };
