// examples/self_host/asm_arm64.lang — sibling of asm.lang for
// the ARM64 / aarch64 Linux target. Walks a parser.Module and
// emits GAS-flavoured aarch64 assembly text. The emitted asm
// uses Linux syscall conventions (sys_exit = 93) and is
// assemble-able with `aarch64-linux-gnu-gcc -nostdlib`.
//
// Scope:
//   - i32 literals
//   - i32 arithmetic: + - * / %
//   - Comparisons: < <= > >= == != → 0/1 i32 via cmp + cset
//   - Bool literals (false=0, true=1 on the rt-stack)
//   - Unary `-`
//   - Control flow: if/else and while (forward-branch patching
//     via unique generated labels)
//   - Statement-level: `return <expr>;` lowers to sys_exit
//
// Lowering shape — a textual stack machine on the architectural
// stack (sp). Each expr leaves its result on the rt-stack via:
//   literal n:  ldr x0, =n; str x0, [sp, #-16]!
//   bin l op r: <emit l>; <emit r>;
//               ldr x1, [sp], #16; ldr x0, [sp], #16;
//               <op>; str x0, [sp, #-16]!
// Statement `return <expr>;` pops into x0 and issues sys_exit
// (syscall number in x8, args in x0..x7).
//
// 16-byte stack alignment requirement on ARM64 means we use
// `[sp, #-16]!` even though each value is 8 bytes — wastes 8
// bytes per push but keeps sp 16-aligned for any nested
// syscalls / function calls that follow.

import "core/no_prelude";
import "./lexer";
import "./parser";

// =================== TEXT HELPERS ====================

function i32_to_string(n: i32): string {
    if (n == 0) { return "0"; }
    var neg: boolean = false;
    if (n < 0) { neg = true; n = 0 - n; }
    var out: string = "";
    while (n > 0) {
        var d: i32 = n % 10;
        var c: string = "";
        if (d == 0) { c = "0"; } else if (d == 1) { c = "1"; }
        else if (d == 2) { c = "2"; } else if (d == 3) { c = "3"; }
        else if (d == 4) { c = "4"; } else if (d == 5) { c = "5"; }
        else if (d == 6) { c = "6"; } else if (d == 7) { c = "7"; }
        else if (d == 8) { c = "8"; } else { c = "9"; }
        out = c + out;
        n = n / 10;
    }
    if (neg) { out = "-" + out; }
    return out;
}

// =================== EMIT STATE ====================

// EmitState carries the running output text plus a monotonic
// label counter. Threaded by value through every emit_* call;
// receiver method `(s) write(text)` makes call sites concise.
pub struct EmitState { out: string, label_n: i32 }

function new_state(): EmitState {
    return EmitState { out: "", label_n: 0 };
}

function (s: EmitState) write(text: string): EmitState {
    return EmitState { out: s.out + text, label_n: s.label_n };
}

struct LabelOut { state: EmitState, name: string }
function fresh_label(s: EmitState): LabelOut {
    var name: string = ".L" + i32_to_string(s.label_n);
    var ns: EmitState = EmitState { out: s.out, label_n: s.label_n + 1 };
    return LabelOut { state: ns, name: name };
}

// =================== ASM EMITTER ====================

function emit_expr(e: parser.Expr, s: EmitState): EmitState {
    match (e) {
        parser.ExprNumber(n) => {
            // `ldr x0, =N` puts N in a literal pool; works for
            // any 64-bit value, including ones that don't fit
            // mov's 16-bit immediate field.
            s = s.write("    ldr x0, =" + n.text + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprBinary(b) => {
            s = emit_expr(b.left, s);
            s = emit_expr(b.right, s);
            s = s.write("    ldr x1, [sp], #16\n");   // rhs
            s = s.write("    ldr x0, [sp], #16\n");   // lhs
            if (b.op == "+") {
                s = s.write("    add x0, x0, x1\n");
            } else if (b.op == "-") {
                s = s.write("    sub x0, x0, x1\n");
            } else if (b.op == "*") {
                s = s.write("    mul x0, x0, x1\n");
            } else if (b.op == "/") {
                s = s.write("    sdiv x0, x0, x1\n");
            } else if (b.op == "%") {
                // ARM64 has no native modulo. Compute via
                // remainder = lhs - (lhs/rhs)*rhs.
                // msub x_d, x_n, x_m, x_a → x_d = x_a - x_n*x_m
                s = s.write("    sdiv x2, x0, x1\n");
                s = s.write("    msub x0, x2, x1, x0\n");
            } else if (b.op == "<" || b.op == "<=" || b.op == ">"
                    || b.op == ">=" || b.op == "==" || b.op == "!=") {
                // Comparison: `cmp lhs, rhs` sets the condition
                // flags; `cset` materialises the bool (0/1) into
                // x0 based on the chosen cc.
                s = s.write("    cmp x0, x1\n");
                var cc: string = "";
                if (b.op == "<") { cc = "lt"; }
                else if (b.op == "<=") { cc = "le"; }
                else if (b.op == ">") { cc = "gt"; }
                else if (b.op == ">=") { cc = "ge"; }
                else if (b.op == "==") { cc = "eq"; }
                else { cc = "ne"; }
                s = s.write("    cset x0, " + cc + "\n");
            } else {
                s = s.write("    // unsupported binop: " + b.op + "\n");
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    neg x0, x0\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = s.write("    // unsupported unary: " + u.op + "\n");
            return s;
        },
        parser.ExprBool(b) => {
            // Bool literal — 1 for true, 0 for false on the
            // rt-stack so it can flow through comparison-style
            // consumers (e.g. an if cond branching on `true`).
            var v: i32 = 0;
            if (b.value) { v = 1; }
            s = s.write("    mov x0, #" + i32_to_string(v) + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprIdent(_) => {
            s = s.write("    // unsupported: ident (no locals yet)\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprString(_) => {
            s = s.write("    // unsupported: string\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprCall(_) => {
            s = s.write("    // unsupported: call\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprArray(_) => {
            s = s.write("    // unsupported: array\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprIndex(_) => {
            s = s.write("    // unsupported: index\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprSlice(_) => {
            s = s.write("    // unsupported: slice\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprUnknown(_) => {
            s = s.write("    // parser-side unknown\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        }
    }
    return s;
}

function emit_block(body: parser.Stmt[], s: EmitState): EmitState {
    var i: i32 = 0;
    while (i < len(body)) {
        s = emit_stmt(body[i], s);
        i = i + 1;
    }
    return s;
}

function emit_stmt(stmt: parser.Stmt, s: EmitState): EmitState {
    match (stmt) {
        parser.StmtReturn(r) => {
            s = emit_expr(r.value, s);
            s = s.write("    ldr x0, [sp], #16\n");  // exit code
            s = s.write("    mov x8, #93\n");        // sys_exit
            s = s.write("    svc #0\n");
            return s;
        },
        parser.StmtIf(ifs) => {
            // if/else lowers to:
            //   <cond>; ldr x0, [sp], #16; cbz x0, <else_lbl>
            //   <then-body>; b <end_lbl>
            //   <else_lbl>: <else-body>; <end_lbl>:
            // No-else uses a single label = end of then.
            s = emit_expr(ifs.cond, s);
            s = s.write("    ldr x0, [sp], #16\n");
            var else_l: LabelOut = fresh_label(s);
            s = else_l.state;
            s = s.write("    cbz x0, " + else_l.name + "\n");
            s = emit_block(ifs.then_body, s);
            if (len(ifs.else_body) > 0) {
                var end_l: LabelOut = fresh_label(s);
                s = end_l.state;
                s = s.write("    b " + end_l.name + "\n");
                s = s.write(else_l.name + ":\n");
                s = emit_block(ifs.else_body, s);
                s = s.write(end_l.name + ":\n");
            } else {
                s = s.write(else_l.name + ":\n");
            }
            return s;
        },
        parser.StmtWhile(w) => {
            // while lowers to:
            // <top_lbl>: <cond>; ldr x0, [sp], #16; cbz x0, <exit_lbl>
            //            <body>; b <top_lbl>
            // <exit_lbl>:
            var top_l: LabelOut = fresh_label(s);
            s = top_l.state;
            var exit_l: LabelOut = fresh_label(s);
            s = exit_l.state;
            s = s.write(top_l.name + ":\n");
            s = emit_expr(w.cond, s);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.write("    cbz x0, " + exit_l.name + "\n");
            s = emit_block(w.body, s);
            s = s.write("    b " + top_l.name + "\n");
            s = s.write(exit_l.name + ":\n");
            return s;
        },
        parser.StmtVar(_) => { return s.write("    // unsupported: StmtVar\n"); },
        parser.StmtExpr(_) => { return s.write("    // unsupported: StmtExpr\n"); },
        parser.StmtAssign(_) => { return s.write("    // unsupported: StmtAssign\n"); },
        parser.StmtUnknown(_) => { return s.write("    // unsupported: StmtUnknown\n"); }
    }
    return s;
}

pub function emit_module(mod: parser.Module): string {
    var s: EmitState = new_state();
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    s = s.write("_start:\n");
    var i: i32 = 0;
    while (i < len(mod.top_stmts)) {
        s = emit_stmt(mod.top_stmts[i], s);
        i = i + 1;
    }
    // Fallback exit in case there's no return.
    s = s.write("    mov x0, #0\n");
    s = s.write("    mov x8, #93\n");
    s = s.write("    svc #0\n");
    return s.out;
}

// =================== VALIDATION ====================

function contains(haystack: string, needle: string): boolean {
    if (len(needle) == 0) { return true; }
    if (len(haystack) < len(needle)) { return false; }
    var i: i32 = 0;
    while (i <= len(haystack) - len(needle)) {
        if (haystack[i:i + len(needle)] == needle) { return true; }
        i = i + 1;
    }
    return false;
}

function emit_source(src: string): string {
    return emit_module(parser.parse_module(lexer.tokenize(src)));
}

function main(): i32 {
    // Minimal: `return 42;` should produce asm with the literal,
    // the rt-stack push, exit code load, sys_exit syscall.
    var a1: string = emit_source("return 42;");
    if (!contains(a1, "ldr x0, =42")) { return 10; }
    if (!contains(a1, "str x0, [sp, #-16]!")) { return 11; }
    if (!contains(a1, "ldr x0, [sp], #16")) { return 12; }
    if (!contains(a1, "mov x8, #93")) { return 13; }
    if (!contains(a1, "svc #0")) { return 14; }
    if (!contains(a1, ".globl _start")) { return 15; }

    // Arithmetic: + emits add.
    var a2: string = emit_source("return 2 + 3;");
    if (!contains(a2, "add x0, x0, x1")) { return 20; }

    // Subtraction.
    var a3: string = emit_source("return 7 - 4;");
    if (!contains(a3, "sub x0, x0, x1")) { return 30; }

    // Multiplication.
    var a4: string = emit_source("return 6 * 7;");
    if (!contains(a4, "mul x0, x0, x1")) { return 40; }

    // Division: ARM64 sdiv.
    var a5: string = emit_source("return 20 / 4;");
    if (!contains(a5, "sdiv x0, x0, x1")) { return 50; }

    // Modulo: sdiv + msub (no native mod on ARM64).
    var a6: string = emit_source("return 23 % 5;");
    if (!contains(a6, "sdiv x2, x0, x1")) { return 60; }
    if (!contains(a6, "msub x0, x2, x1, x0")) { return 61; }

    // Unary negation.
    var a7: string = emit_source("return -5;");
    if (!contains(a7, "neg x0, x0")) { return 70; }

    // Nested expressions: `return (2 + 3) * 4;` emits add before mul.
    var a8: string = emit_source("return (2 + 3) * 4;");
    if (!contains(a8, "add x0, x0, x1")) { return 80; }
    if (!contains(a8, "mul x0, x0, x1")) { return 81; }

    // Comparisons: cmp + cset with the matching cc.
    var a9: string = emit_source("return 5 < 10;");
    if (!contains(a9, "cmp x0, x1")) { return 90; }
    if (!contains(a9, "cset x0, lt")) { return 91; }

    var a10: string = emit_source("return 5 <= 5;");
    if (!contains(a10, "cset x0, le")) { return 100; }

    var a11: string = emit_source("return 7 > 3;");
    if (!contains(a11, "cset x0, gt")) { return 110; }

    var a12: string = emit_source("return 7 >= 7;");
    if (!contains(a12, "cset x0, ge")) { return 120; }

    var a13: string = emit_source("return 4 == 4;");
    if (!contains(a13, "cset x0, eq")) { return 130; }

    var a14: string = emit_source("return 4 != 5;");
    if (!contains(a14, "cset x0, ne")) { return 140; }

    // If/else: emits cbz to else label, body, b to end label,
    // else label, else-body, end label.
    var a15: string = emit_source("if (true) { return 1; } else { return 2; }");
    if (!contains(a15, "cbz x0, .L")) { return 150; }
    if (!contains(a15, "b .L")) { return 151; }
    if (!contains(a15, ".L0:")) { return 152; }
    if (!contains(a15, ".L1:")) { return 153; }
    if (!contains(a15, "mov x0, #1")) { return 154; }  // true literal

    // No-else if.
    var a16: string = emit_source("if (true) { return 1; } return 0;");
    if (!contains(a16, "cbz x0, .L")) { return 160; }

    // While.
    var a17: string = emit_source("while (1 < 2) { return 0; }");
    if (!contains(a17, "cbz x0, .L")) { return 170; }
    if (!contains(a17, "b .L")) { return 171; }

    return 0;
}
