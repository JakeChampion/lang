// examples/self_host/asm_arm64.lang — sibling of asm.lang for
// the ARM64 / aarch64 Linux target. Walks a parser.Module and
// emits GAS-flavoured aarch64 assembly text. The emitted asm
// uses Linux syscall conventions (sys_exit = 93) and is
// assemble-able with `aarch64-linux-gnu-gcc -nostdlib`.
//
// Scope:
//   - i32 literals
//   - i32 arithmetic: + - * / %
//   - Comparisons: < <= > >= == != → 0/1 i32 via cmp + cset
//   - Bool literals (false=0, true=1 on the rt-stack)
//   - Unary `-`
//   - Control flow: if/else and while (forward-branch patching
//     via unique generated labels)
//   - Statement-level: `return <expr>;` lowers to sys_exit
//
// Lowering shape — a textual stack machine on the architectural
// stack (sp). Each expr leaves its result on the rt-stack via:
//   literal n:  ldr x0, =n; str x0, [sp, #-16]!
//   bin l op r: <emit l>; <emit r>;
//               ldr x1, [sp], #16; ldr x0, [sp], #16;
//               <op>; str x0, [sp, #-16]!
// Statement `return <expr>;` pops into x0 and issues sys_exit
// (syscall number in x8, args in x0..x7).
//
// 16-byte stack alignment requirement on ARM64 means we use
// `[sp, #-16]!` even though each value is 8 bytes — wastes 8
// bytes per push but keeps sp 16-aligned for any nested
// syscalls / function calls that follow.

import "core/no_prelude";
import "./lexer";
import "./parser";

// =================== TEXT HELPERS ====================

// sanitize_label rewrites `.` to `__` so qualified-name
// function labels (e.g. `parser.parse_module`) survive GNU
// as's label parsing. Same shape as the x86-64 backend.
function sanitize_label(name: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < len(name)) {
        var b: i32 = name[i];
        if (b == 46) { out = out + "__"; }
        else { out = out + name[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

function i32_to_string(n: i32): string {
    if (n == 0) { return "0"; }
    var neg: boolean = false;
    if (n < 0) { neg = true; n = 0 - n; }
    var out: string = "";
    while (n > 0) {
        var d: i32 = n % 10;
        var c: string = "";
        if (d == 0) { c = "0"; } else if (d == 1) { c = "1"; }
        else if (d == 2) { c = "2"; } else if (d == 3) { c = "3"; }
        else if (d == 4) { c = "4"; } else if (d == 5) { c = "5"; }
        else if (d == 6) { c = "6"; } else if (d == 7) { c = "7"; }
        else if (d == 8) { c = "8"; } else { c = "9"; }
        out = c + out;
        n = n / 10;
    }
    if (neg) { out = "-" + out; }
    return out;
}

// digits_to_i32 parses a decimal integer literal (optional
// leading `-`). Stops at the first non-digit byte. Mirrors
// the x86-64 backend helper of the same name.
function digits_to_i32(s: string): i32 {
    if (len(s) == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == 45) { neg = true; start = 1; }
    var acc: i32 = 0;
    var i: i32 = start;
    while (i < len(s)) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) {
            if (neg) { return 0 - acc; }
            return acc;
        }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    if (neg) { return 0 - acc; }
    return acc;
}

// is_all_digits returns true iff `s` is non-empty and every
// byte is an ASCII digit. Used by ExprFieldAccess to detect
// tuple-style numeric field names versus struct field names.
function is_all_digits(s: string): boolean {
    if (len(s) == 0) { return false; }
    var i: i32 = 0;
    while (i < len(s)) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return false; }
        i = i + 1;
    }
    return true;
}

// =================== EMIT STATE ====================

// EmitState carries the running output text, a monotonic label
// counter, the active locals table, and a flag for whether the
// current emit position is inside a function body (so
// StmtReturn knows to use ldp+ret instead of sys_exit).
// local_names is parallel-array shape: index i → offset
// -8*(i+1) off x29.
pub struct EmitState {
    out: string,
    label_n: i32,
    local_names: string[],
    in_function: boolean,
    string_lits: string[],
    needs_print_int: boolean,
    needs_read_int: boolean,
    needs_heap: boolean,
    struct_decls: parser.StructDecl[],
    // loop_exit_labels / loop_cont_labels: see asm.lang for
    // semantics. break / continue use the top of each stack.
    loop_exit_labels: string[],
    loop_cont_labels: string[]
}

function new_state(): EmitState {
    var ns: string[] = [];
    var sl: string[] = [];
    var lex: string[] = [];
    var lcn: string[] = [];
    return EmitState {
        out: "",
        label_n: 0,
        local_names: ns,
        in_function: false,
        string_lits: sl,
        needs_print_int: false,
        needs_read_int: false,
        needs_heap: false,
        struct_decls: [],
        loop_exit_labels: lex,
        loop_cont_labels: lcn
    };
}

function (s: EmitState) write(text: string): EmitState {
    return EmitState {
        out: s.out + text,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
}

function (s: EmitState) bind_local(name: string): EmitState {
    var ln: string[] = s.local_names.push(name);
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: ln,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
}

function (s: EmitState) reset_locals(): EmitState {
    var ln: string[] = [];
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: ln,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
}

function (s: EmitState) enter_function(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: true,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
}

function (s: EmitState) push_loop_labels(exit_lbl: string, cont_lbl: string): EmitState {
    var nex: string[] = s.loop_exit_labels.push(exit_lbl);
    var ncn: string[] = s.loop_cont_labels.push(cont_lbl);
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: nex,
        loop_cont_labels: ncn
    };
}

function (s: EmitState) pop_loop_labels(): EmitState {
    var nex: string[] = [];
    var ncn: string[] = [];
    var i: i32 = 0;
    while (i < len(s.loop_exit_labels) - 1) {
        nex = nex.push(s.loop_exit_labels[i]);
        ncn = ncn.push(s.loop_cont_labels[i]);
        i = i + 1;
    }
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: nex,
        loop_cont_labels: ncn
    };
}

function (s: EmitState) top_loop_exit(): string {
    if (len(s.loop_exit_labels) == 0) { return ""; }
    return s.loop_exit_labels[len(s.loop_exit_labels) - 1];
}

function (s: EmitState) top_loop_cont(): string {
    if (len(s.loop_cont_labels) == 0) { return ""; }
    return s.loop_cont_labels[len(s.loop_cont_labels) - 1];
}

function (s: EmitState) leave_function(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: false,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
}

function (s: EmitState) lookup_local(name: string): i32 {
    var i: i32 = len(s.local_names) - 1;
    while (i >= 0) {
        if (s.local_names[i] == name) {
            return 0 - 8 * (i + 1);
        }
        i = i - 1;
    }
    return 0;
}

function (s: EmitState) has_local(name: string): boolean {
    var i: i32 = 0;
    while (i < len(s.local_names)) {
        if (s.local_names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

struct LabelOut { state: EmitState, name: string }
function fresh_label(s: EmitState): LabelOut {
    var name: string = ".L" + i32_to_string(s.label_n);
    var ns: EmitState = EmitState {
        out: s.out,
        label_n: s.label_n + 1,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
    return LabelOut { state: ns, name: name };
}

// count_locals walks a stmt body recursively (into if / while
// bodies) to determine the total number of `var` decls. The
// result feeds the prologue's `sub sp, sp, #<N*8>` so the
// frame has enough room for every local that might be live.
// Conservative: counts every var even if branches make them
// mutually exclusive at runtime — fine for stack allocation.
function count_locals(body: parser.Stmt[]): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < len(body)) {
        n = n + count_locals_in_stmt(body[i]);
        i = i + 1;
    }
    return n;
}

function count_locals_in_stmt(stmt: parser.Stmt): i32 {
    match (stmt) {
        parser.StmtVar(_) => { return 1; },
        parser.StmtIf(ifs) => { return count_locals(ifs.then_body) + count_locals(ifs.else_body); },
        parser.StmtWhile(w) => { return count_locals(w.body); },
        parser.StmtMatch(m) => {
            // +1 for the synthetic scrutinee local + one per
            // non-empty PatVariant binding + the recursive body
            // counts. Wildcard arms add no binding.
            var n: i32 = 1;
            var i: i32 = 0;
            while (i < len(m.arms)) {
                match (m.arms[i].pattern) {
                    parser.PatVariant(pv) => {
                        if (len(pv.binding) > 0 && pv.binding != "_") { n = n + 1; }
                    },
                    parser.PatWildcard(_) => { }
                }
                n = n + count_locals(m.arms[i].body);
                i = i + 1;
            }
            return n;
        },
        parser.StmtFor(f) => {
            // +1 for the synthetic array-pointer slot, +1 for
            // the loop counter, +1 for the bound element var,
            // + body locals.
            return 3 + count_locals(f.body);
        },
        _ => { return 0; }
    }
    return 0;
}

// add_string_lit appends the literal to the pool and returns
// its index, used by the caller to emit `adrp + add` for the
// literal's address. The pool is materialised in .rodata at
// end-of-module.
struct StringLitOut { state: EmitState, idx: i32 }
function add_string_lit(s: EmitState, v: string): StringLitOut {
    // Dedup: load-bearing for shape-pointer dispatch in
    // ExprFieldAccess + StmtMatch. See asm.lang for rationale.
    var i: i32 = 0;
    while (i < len(s.string_lits)) {
        if (s.string_lits[i] == v) {
            return StringLitOut { state: s, idx: i };
        }
        i = i + 1;
    }
    var idx: i32 = len(s.string_lits);
    var sl: string[] = s.string_lits.push(v);
    var ns: EmitState = EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: sl,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
    return StringLitOut { state: ns, idx: idx };
}

function (s: EmitState) mark_print_int(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: true,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
}

function (s: EmitState) mark_heap(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: true,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
}

function (s: EmitState) mark_read_int(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: true,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
}

// escape_for_ascii rewrites a string for `.ascii "…"` syntax:
// quotes get backslashed, backslashes doubled, common
// whitespace bytes become GAS escape sequences so a `\n` byte
// in the source string lands as a single LF byte in .rodata.
function escape_for_ascii(s: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < len(s)) {
        var b: i32 = s[i];
        if (b == 34) { out = out + "\\\""; }
        else if (b == 92) { out = out + "\\\\"; }
        else if (b == 10) { out = out + "\\n"; }
        else if (b == 9) { out = out + "\\t"; }
        else if (b == 13) { out = out + "\\r"; }
        else { out = out + s[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

// =================== ASM EMITTER ====================

function emit_expr(e: parser.Expr, s: EmitState): EmitState {
    match (e) {
        parser.ExprNumber(n) => {
            // `ldr x0, =N` puts N in a literal pool; works for
            // any 64-bit value, including ones that don't fit
            // mov's 16-bit immediate field.
            s = s.write("    ldr x0, =" + n.text + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprBinary(b) => {
            s = emit_expr(b.left, s);
            s = emit_expr(b.right, s);
            s = s.write("    ldr x1, [sp], #16\n");   // rhs
            s = s.write("    ldr x0, [sp], #16\n");   // lhs
            if (b.op == "+") {
                s = s.write("    add x0, x0, x1\n");
            } else if (b.op == "-") {
                s = s.write("    sub x0, x0, x1\n");
            } else if (b.op == "*") {
                s = s.write("    mul x0, x0, x1\n");
            } else if (b.op == "/") {
                s = s.write("    sdiv x0, x0, x1\n");
            } else if (b.op == "%") {
                // ARM64 has no native modulo. Compute via
                // remainder = lhs - (lhs/rhs)*rhs.
                // msub x_d, x_n, x_m, x_a → x_d = x_a - x_n*x_m
                s = s.write("    sdiv x2, x0, x1\n");
                s = s.write("    msub x0, x2, x1, x0\n");
            } else if (b.op == "<" || b.op == "<=" || b.op == ">"
                    || b.op == ">=" || b.op == "==" || b.op == "!=") {
                // Comparison: `cmp lhs, rhs` sets the condition
                // flags; `cset` materialises the bool (0/1) into
                // x0 based on the chosen cc.
                s = s.write("    cmp x0, x1\n");
                var cc: string = "";
                if (b.op == "<") { cc = "lt"; }
                else if (b.op == "<=") { cc = "le"; }
                else if (b.op == ">") { cc = "gt"; }
                else if (b.op == ">=") { cc = "ge"; }
                else if (b.op == "==") { cc = "eq"; }
                else { cc = "ne"; }
                s = s.write("    cset x0, " + cc + "\n");
            } else {
                s = s.write("    // unsupported binop: " + b.op + "\n");
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    neg x0, x0\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = s.write("    // unsupported unary: " + u.op + "\n");
            return s;
        },
        parser.ExprBool(b) => {
            // Bool literal — 1 for true, 0 for false on the
            // rt-stack so it can flow through comparison-style
            // consumers (e.g. an if cond branching on `true`).
            var v: i32 = 0;
            if (b.value) { v = 1; }
            s = s.write("    mov x0, #" + i32_to_string(v) + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprIdent(id) => {
            if (s.has_local(id.name)) {
                var off: i32 = s.lookup_local(id.name);
                s = s.write("    ldr x0, [x29, #" + i32_to_string(off) + "]\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = s.write("    // unresolved ident: " + id.name + "\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprString(_) => {
            s = s.write("    // unsupported: string\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprCall(c) => {
            var name: string = "";
            match (c.callee) {
                parser.ExprIdent(id) => { name = id.name; },
                _ => {
                    s = s.write("    // call target not ident\n");
                    s = s.write("    mov x0, #0\n");
                    s = s.write("    str x0, [sp, #-16]!\n");
                    return s;
                }
            }
            // print(str_literal) — builtin lowering to write(1,
            // ptr, len). Compile-time we already know the
            // literal's bytes, so we intern it in `.rodata`,
            // load its address via adrp+add, set the length, and
            // syscall directly.
            // len(arr) — load the length prefix at offset 0.
            // Same semantics as the x86-64 backend.
            if (name == "len" && len(c.args) == 1) {
                s = emit_expr(c.args[0], s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    ldr x0, [x0]\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            if (name == "print" && len(c.args) == 1) {
                var arg: parser.Expr = c.args[0];
                match (arg) {
                    parser.ExprString(sv) => {
                        var lo: StringLitOut = add_string_lit(s, sv.value);
                        s = lo.state;
                        var lbl: string = ".S" + i32_to_string(lo.idx);
                        s = s.write("    mov x0, #1\n");     // fd
                        s = s.write("    adrp x1, " + lbl + "\n");
                        s = s.write("    add x1, x1, :lo12:" + lbl + "\n");
                        s = s.write("    mov x2, #" + i32_to_string(len(sv.value)) + "\n");
                        s = s.write("    mov x8, #64\n");    // sys_write
                        s = s.write("    svc #0\n");
                        s = s.write("    mov x0, #0\n");
                        s = s.write("    str x0, [sp, #-16]!\n");
                        return s;
                    },
                    _ => { }
                }
            }
            // print_int(i32_expr) — builtin lowering to a call into
            // a runtime helper that converts the value to decimal
            // text and writes it to stdout.
            if (name == "print_int" && len(c.args) == 1) {
                s = emit_expr(c.args[0], s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    bl __lang_print_int\n");
                s = s.write("    mov x0, #0\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                s = s.mark_print_int();
                return s;
            }
            // read_int() — builtin no-arg call to the read_int
            // helper. Returns the value in x0; push to rt-stack.
            if (name == "read_int" && len(c.args) == 0) {
                s = s.write("    bl __lang_read_int\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                s = s.mark_read_int();
                return s;
            }
            var i: i32 = len(c.args) - 1;
            while (i >= 0) {
                s = emit_expr(c.args[i], s);
                i = i - 1;
            }
            s = s.write("    bl __fn_" + sanitize_label(name) + "\n");
            // Caller cleans up stack args.
            if (len(c.args) > 0) {
                s = s.write("    add sp, sp, #" + i32_to_string(len(c.args) * 16) + "\n");
            }
            // Result in x0 — push for the surrounding expr's
            // stack-machine semantics.
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprTuple(t) => {
            // Layout: [val0, val1, …, val_(N-1)] — no shape
            // pointer, same as the x86-64 backend; tuple field
            // access uses numeric `.0` / `.1` / … spellings and
            // resolves to a direct offset at the access site.
            var n_elems: i32 = len(t.elements);
            var ti: i32 = 0;
            while (ti < n_elems) {
                s = emit_expr(t.elements[ti], s);
                ti = ti + 1;
            }
            var t_bytes: i32 = n_elems * 8;
            if (n_elems == 0) { t_bytes = 8; }
            s = s.write("    mov x0, #" + i32_to_string(t_bytes) + "\n");
            s = s.write("    bl __lang_alloc\n");
            s = s.mark_heap();
            var tj: i32 = n_elems - 1;
            while (tj >= 0) {
                s = s.write("    ldr x1, [sp], #16\n");
                s = s.write("    str x1, [x0, #" + i32_to_string(tj * 8) + "]\n");
                tj = tj - 1;
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprArray(a) => {
            // Layout: [len: 8 bytes, val0, val1, …, val_(N-1)].
            // Same shape as the x86-64 backend; see asm.lang
            // for the rationale.
            var n_elems: i32 = len(a.elements);
            var ai: i32 = 0;
            while (ai < n_elems) {
                s = emit_expr(a.elements[ai], s);
                ai = ai + 1;
            }
            var a_bytes: i32 = (n_elems + 1) * 8;
            s = s.write("    mov x0, #" + i32_to_string(a_bytes) + "\n");
            s = s.write("    bl __lang_alloc\n");
            s = s.mark_heap();
            s = s.write("    mov x1, #" + i32_to_string(n_elems) + "\n");
            s = s.write("    str x1, [x0]\n");
            var aj: i32 = n_elems - 1;
            while (aj >= 0) {
                s = s.write("    ldr x1, [sp], #16\n");
                s = s.write("    str x1, [x0, #" + i32_to_string((aj + 1) * 8) + "]\n");
                aj = aj - 1;
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprIndex(x) => {
            // Compile array → push ptr; compile index → push i32;
            // pop both into registers, load at offset (idx+1)*8.
            s = emit_expr(x.array, s);
            s = emit_expr(x.index, s);
            s = s.write("    ldr x1, [sp], #16\n");
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.write("    add x1, x1, #1\n");
            s = s.write("    ldr x0, [x0, x1, lsl #3]\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprSlice(_) => {
            s = s.write("    // unsupported: slice\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprStructLit(sl) => {
            // Layout: [shape_ptr, val0, val1, …, val_(N-1)].
            // Same shape as the x86-64 backend; see asm.lang
            // for the rationale.
            var n_fields: i32 = len(sl.field_values);
            var i: i32 = 0;
            while (i < n_fields) {
                s = emit_expr(sl.field_values[i], s);
                i = i + 1;
            }
            var slot_bytes: i32 = (n_fields + 1) * 8;
            s = s.write("    mov x0, #" + i32_to_string(slot_bytes) + "\n");
            s = s.write("    bl __lang_alloc\n");
            s = s.mark_heap();
            // x0 now holds the struct pointer.
            var nameLit: StringLitOut = add_string_lit(s, sl.type_name);
            s = nameLit.state;
            s = s.write("    adrp x1, .S" + i32_to_string(nameLit.idx) + "\n");
            s = s.write("    add x1, x1, :lo12:.S" + i32_to_string(nameLit.idx) + "\n");
            s = s.write("    str x1, [x0]\n");
            // Pop field values into [x0 + (j+1)*8].
            var j: i32 = n_fields - 1;
            while (j >= 0) {
                s = s.write("    ldr x1, [sp], #16\n");
                s = s.write("    str x1, [x0, #" + i32_to_string((j + 1) * 8) + "]\n");
                j = j - 1;
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprFieldAccess(fa) => {
            // Numeric field name → tuple access (offset idx*8,
            // no shape dispatch). See asm.lang for rationale.
            if (is_all_digits(fa.field)) {
                var tup_idx: i32 = digits_to_i32(fa.field);
                s = emit_expr(fa.obj, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    ldr x0, [x0, #" + i32_to_string(tup_idx * 8) + "]\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = emit_expr(fa.obj, s);
            s = s.write("    ldr x0, [sp], #16\n");
            var end_lbl: i32 = s.label_n;
            s = EmitState {
                out: s.out,
                label_n: s.label_n + 1,
                local_names: s.local_names,
                in_function: s.in_function,
                string_lits: s.string_lits,
                needs_print_int: s.needs_print_int,
                needs_read_int: s.needs_read_int,
                needs_heap: s.needs_heap,
                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels
            };
            var di: i32 = 0;
            while (di < len(s.struct_decls)) {
                var sd: parser.StructDecl = s.struct_decls[di];
                var fi: i32 = 0;
                var found_idx: i32 = 0 - 1;
                while (fi < len(sd.fields)) {
                    if (sd.fields[fi].name == fa.field) { found_idx = fi; }
                    fi = fi + 1;
                }
                if (found_idx >= 0) {
                    var arm_lit: StringLitOut = add_string_lit(s, sd.name);
                    s = arm_lit.state;
                    s = s.write("    ldr x1, [x0]\n");
                    s = s.write("    adrp x2, .S" + i32_to_string(arm_lit.idx) + "\n");
                    s = s.write("    add x2, x2, :lo12:.S" + i32_to_string(arm_lit.idx) + "\n");
                    s = s.write("    cmp x1, x2\n");
                    s = s.write("    b.ne .Lfa_next_" + i32_to_string(s.label_n) + "\n");
                    s = s.write("    ldr x0, [x0, #" + i32_to_string((found_idx + 1) * 8) + "]\n");
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.write("    b .Lfa_end_" + i32_to_string(end_lbl) + "\n");
                    s = s.write(".Lfa_next_" + i32_to_string(s.label_n) + ":\n");
                    s = EmitState {
                        out: s.out,
                        label_n: s.label_n + 1,
                        local_names: s.local_names,
                        in_function: s.in_function,
                        string_lits: s.string_lits,
                        needs_print_int: s.needs_print_int,
                        needs_read_int: s.needs_read_int,
                        needs_heap: s.needs_heap,
                        struct_decls: s.struct_decls,
                        loop_exit_labels: s.loop_exit_labels,
                        loop_cont_labels: s.loop_cont_labels
                    };
                }
                di = di + 1;
            }
            s = s.write("    mov x0, #-1\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            s = s.write(".Lfa_end_" + i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.ExprLambda(_) => {
            s = s.write("    // unsupported: lambda\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprUnknown(_) => {
            s = s.write("    // parser-side unknown\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        }
    }
    return s;
}

function emit_block(body: parser.Stmt[], s: EmitState): EmitState {
    var i: i32 = 0;
    while (i < len(body)) {
        s = emit_stmt(body[i], s);
        i = i + 1;
    }
    return s;
}

function emit_stmt(stmt: parser.Stmt, s: EmitState): EmitState {
    match (stmt) {
        parser.StmtReturn(r) => {
            s = emit_expr(r.value, s);
            if (s.in_function) {
                // Function return: pop value to x0, restore
                // x29/x30 from the saved pair, ret to caller.
                // `mov sp, x29` undoes whatever sub sp the
                // prologue did; ldp post-indexes sp by 16.
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    mov sp, x29\n");
                s = s.write("    ldp x29, x30, [sp], #16\n");
                s = s.write("    ret\n");
            } else {
                // Top-level return: sys_exit syscall.
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    mov x8, #93\n");
                s = s.write("    svc #0\n");
            }
            return s;
        },
        parser.StmtIf(ifs) => {
            // if/else lowers to:
            //   <cond>; ldr x0, [sp], #16; cbz x0, <else_lbl>
            //   <then-body>; b <end_lbl>
            //   <else_lbl>: <else-body>; <end_lbl>:
            // No-else uses a single label = end of then.
            s = emit_expr(ifs.cond, s);
            s = s.write("    ldr x0, [sp], #16\n");
            var else_l: LabelOut = fresh_label(s);
            s = else_l.state;
            s = s.write("    cbz x0, " + else_l.name + "\n");
            s = emit_block(ifs.then_body, s);
            if (len(ifs.else_body) > 0) {
                var end_l: LabelOut = fresh_label(s);
                s = end_l.state;
                s = s.write("    b " + end_l.name + "\n");
                s = s.write(else_l.name + ":\n");
                s = emit_block(ifs.else_body, s);
                s = s.write(end_l.name + ":\n");
            } else {
                s = s.write(else_l.name + ":\n");
            }
            return s;
        },
        parser.StmtWhile(w) => {
            // while lowers to:
            // <top_lbl>: <cond>; ldr x0, [sp], #16; cbz x0, <exit_lbl>
            //            <body>; b <top_lbl>
            // <exit_lbl>:
            //
            // break → <exit_lbl>; continue → <top_lbl>.
            var top_l: LabelOut = fresh_label(s);
            s = top_l.state;
            var exit_l: LabelOut = fresh_label(s);
            s = exit_l.state;
            s = s.write(top_l.name + ":\n");
            s = emit_expr(w.cond, s);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.write("    cbz x0, " + exit_l.name + "\n");
            s = s.push_loop_labels(exit_l.name, top_l.name);
            s = emit_block(w.body, s);
            s = s.pop_loop_labels();
            s = s.write("    b " + top_l.name + "\n");
            s = s.write(exit_l.name + ":\n");
            return s;
        },
        parser.StmtVar(v) => {
            // Compile init, then pop to the new local's slot.
            // bind_local first so lookup_local resolves to the
            // correct offset.
            s = emit_expr(v.init, s);
            s = s.bind_local(v.name);
            var off: i32 = s.lookup_local(v.name);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.write("    str x0, [x29, #" + i32_to_string(off) + "]\n");
            return s;
        },
        parser.StmtAssign(a) => {
            if (!s.has_local(a.target)) {
                s = s.write("    // unresolved assign: " + a.target + "\n");
                return s;
            }
            s = emit_expr(a.value, s);
            var off: i32 = s.lookup_local(a.target);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.write("    str x0, [x29, #" + i32_to_string(off) + "]\n");
            return s;
        },
        parser.StmtExpr(x) => {
            s = emit_expr(x.value, s);
            s = s.write("    ldr x0, [sp], #16\n");  // drop result
            return s;
        },
        parser.StmtMatch(m) => {
            // Mirror of the x86-64 lowering in asm.lang. Eval
            // scrutinee, save into a fresh local slot, then for
            // each arm:
            //   PatVariant: load shape ptr from [scrut], cmp
            //   against the interned struct name, b.ne next arm;
            //   on match, bind `binding` to the scrutinee and
            //   emit the body.
            //   PatWildcard: always match.
            s = emit_expr(m.scrutinee, s);
            var scrut_name: string = "__match_scrut_" + i32_to_string(s.label_n);
            s = s.bind_local(scrut_name);
            var scrut_off: i32 = s.lookup_local(scrut_name);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.write("    str x0, [x29, #" + i32_to_string(scrut_off) + "]\n");
            var end_lbl: i32 = s.label_n;
            s = EmitState {
                out: s.out,
                label_n: s.label_n + 1,
                local_names: s.local_names,
                in_function: s.in_function,
                string_lits: s.string_lits,
                needs_print_int: s.needs_print_int,
                needs_read_int: s.needs_read_int,
                needs_heap: s.needs_heap,
                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels
            };
            var ai: i32 = 0;
            while (ai < len(m.arms)) {
                var arm: parser.MatchArm = m.arms[ai];
                var next_lbl: i32 = s.label_n;
                s = EmitState {
                    out: s.out,
                    label_n: s.label_n + 1,
                    local_names: s.local_names,
                    in_function: s.in_function,
                    string_lits: s.string_lits,
                    needs_print_int: s.needs_print_int,
                    needs_read_int: s.needs_read_int,
                    needs_heap: s.needs_heap,
                    struct_decls: s.struct_decls,
                    loop_exit_labels: s.loop_exit_labels,
                    loop_cont_labels: s.loop_cont_labels
                };
                match (arm.pattern) {
                    parser.PatVariant(pv) => {
                        s = s.write("    ldr x0, [x29, #" + i32_to_string(scrut_off) + "]\n");
                        s = s.write("    ldr x1, [x0]\n");
                        var nameLit: StringLitOut = add_string_lit(s, pv.type_name);
                        s = nameLit.state;
                        s = s.write("    adrp x2, .S" + i32_to_string(nameLit.idx) + "\n");
                        s = s.write("    add x2, x2, :lo12:.S" + i32_to_string(nameLit.idx) + "\n");
                        s = s.write("    cmp x1, x2\n");
                        s = s.write("    b.ne .Lmatch_next_" + i32_to_string(next_lbl) + "\n");
                        if (len(pv.binding) > 0 && pv.binding != "_") {
                            s = s.bind_local(pv.binding);
                            var bind_off: i32 = s.lookup_local(pv.binding);
                            s = s.write("    str x0, [x29, #" + i32_to_string(bind_off) + "]\n");
                        }
                    },
                    parser.PatWildcard(_) => { }
                }
                var bi: i32 = 0;
                while (bi < len(arm.body)) {
                    s = emit_stmt(arm.body[bi], s);
                    bi = bi + 1;
                }
                s = s.write("    b .Lmatch_end_" + i32_to_string(end_lbl) + "\n");
                s = s.write(".Lmatch_next_" + i32_to_string(next_lbl) + ":\n");
                ai = ai + 1;
            }
            s = s.write(".Lmatch_end_" + i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtFor(f) => {
            // Mirror of the x86-64 StmtFor lowering in asm.lang.
            // Desugar: `for x in arr { body }` →
            //   __for_arr_N = arr; __for_i_N = 0;
            //   while (__for_i_N < len(__for_arr_N)) {
            //       x = __for_arr_N[__for_i_N]; body;
            //       __for_i_N = __for_i_N + 1;
            //   }
            s = emit_expr(f.iter, s);
            var arr_name: string = "__for_arr_" + i32_to_string(s.label_n);
            s = s.bind_local(arr_name);
            var arr_off: i32 = s.lookup_local(arr_name);
            s = s.write("    ldr x0, [sp], #16\n");
            s = s.write("    str x0, [x29, #" + i32_to_string(arr_off) + "]\n");
            var idx_name: string = "__for_i_" + i32_to_string(s.label_n);
            s = s.bind_local(idx_name);
            var idx_off: i32 = s.lookup_local(idx_name);
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [x29, #" + i32_to_string(idx_off) + "]\n");
            s = s.bind_local(f.var_name);
            var elem_off: i32 = s.lookup_local(f.var_name);
            var top_lbl: i32 = s.label_n;
            var cont_lbl: i32 = s.label_n + 1;
            var end_lbl: i32 = s.label_n + 2;
            s = EmitState {
                out: s.out,
                label_n: s.label_n + 3,
                local_names: s.local_names,
                in_function: s.in_function,
                string_lits: s.string_lits,
                needs_print_int: s.needs_print_int,
                needs_read_int: s.needs_read_int,
                needs_heap: s.needs_heap,
                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels
            };
            s = s.write(".Lfor_top_" + i32_to_string(top_lbl) + ":\n");
            // Condition.
            s = s.write("    ldr x0, [x29, #" + i32_to_string(arr_off) + "]\n");
            s = s.write("    ldr x1, [x0]\n");
            s = s.write("    ldr x2, [x29, #" + i32_to_string(idx_off) + "]\n");
            s = s.write("    cmp x2, x1\n");
            s = s.write("    b.ge .Lfor_end_" + i32_to_string(end_lbl) + "\n");
            // Bind element.
            s = s.write("    ldr x0, [x29, #" + i32_to_string(arr_off) + "]\n");
            s = s.write("    ldr x1, [x29, #" + i32_to_string(idx_off) + "]\n");
            s = s.write("    add x1, x1, #1\n");
            s = s.write("    ldr x0, [x0, x1, lsl #3]\n");
            s = s.write("    str x0, [x29, #" + i32_to_string(elem_off) + "]\n");
            // Body — break → .Lfor_end; continue → .Lfor_cont.
            s = s.push_loop_labels(".Lfor_end_" + i32_to_string(end_lbl), ".Lfor_cont_" + i32_to_string(cont_lbl));
            var bi: i32 = 0;
            while (bi < len(f.body)) {
                s = emit_stmt(f.body[bi], s);
                bi = bi + 1;
            }
            s = s.pop_loop_labels();
            // i = i + 1; jump to top.
            s = s.write(".Lfor_cont_" + i32_to_string(cont_lbl) + ":\n");
            s = s.write("    ldr x0, [x29, #" + i32_to_string(idx_off) + "]\n");
            s = s.write("    add x0, x0, #1\n");
            s = s.write("    str x0, [x29, #" + i32_to_string(idx_off) + "]\n");
            s = s.write("    b .Lfor_top_" + i32_to_string(top_lbl) + "\n");
            s = s.write(".Lfor_end_" + i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtBreak(_) => {
            var lbl: string = s.top_loop_exit();
            if (len(lbl) == 0) { return s.write("    // break outside loop\n"); }
            return s.write("    b " + lbl + "\n");
        },
        parser.StmtContinue(_) => {
            var lbl: string = s.top_loop_cont();
            if (len(lbl) == 0) { return s.write("    // continue outside loop\n"); }
            return s.write("    b " + lbl + "\n");
        },
        parser.StmtUnknown(_) => { return s.write("    // unsupported: StmtUnknown\n"); }
    }
    return s;
}

// emit_function emits a single FuncDecl as a `__fn_<name>:`
// label with prologue, arg-copy, body, and (fallback) epilogue.
// Args arrive on the stack at [x29, #16], [x29, #32], … (caller
// pushed right-to-left, so arg 0 is closest to the saved pair).
// Each arg takes 16 bytes because the rt-stack pushes/pops with
// 16-byte alignment. The prologue copies each arg into its
// local slot at [x29, #-8*(i+1)] so the body reads them
// uniformly.
function emit_function(fd: parser.FuncDecl, s: EmitState): EmitState {
    s = s.write("__fn_" + sanitize_label(fd.name) + ":\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    var argc: i32 = len(fd.params);
    var n_body_locals: i32 = count_locals(fd.body);
    var total_locals: i32 = argc + n_body_locals;
    if (total_locals > 0) {
        var bytes: i32 = total_locals * 8;
        if (bytes % 16 != 0) { bytes = bytes + 8; }
        s = s.write("    sub sp, sp, #" + i32_to_string(bytes) + "\n");
    }
    s = s.reset_locals();
    s = s.enter_function();
    var i: i32 = 0;
    while (i < argc) {
        s = s.bind_local(fd.params[i].name);
        var local_off: i32 = s.lookup_local(fd.params[i].name);
        var arg_off: i32 = 16 + i * 16;
        s = s.write("    ldr x0, [x29, #" + i32_to_string(arg_off) + "]   // param " + fd.params[i].name + "\n");
        s = s.write("    str x0, [x29, #" + i32_to_string(local_off) + "]\n");
        i = i + 1;
    }
    var bi: i32 = 0;
    while (bi < len(fd.body)) {
        s = emit_stmt(fd.body[bi], s);
        bi = bi + 1;
    }
    // Fallback: implicit `return 0;` so falling off the end
    // doesn't run into the next function's label.
    s = s.write("    mov x0, #0\n");
    s = s.write("    mov sp, x29\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.leave_function();
    s = s.reset_locals();
    return s;
}

function has_main(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < len(mod.funcs)) {
        if (mod.funcs[i].name == "main") { return true; }
        i = i + 1;
    }
    return false;
}

pub function emit_module(mod: parser.Module): string {
    var s: EmitState = new_state();
    // Seed the struct-decl table for ExprStructLit /
    // ExprFieldAccess.
    s = EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: mod.structs,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels
    };
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    // Emit each function body first. Each gets its own
    // __fn_<name>: label; _start dispatches into main() if it
    // exists.
    var fi: i32 = 0;
    while (fi < len(mod.funcs)) {
        s = emit_function(mod.funcs[fi], s);
        fi = fi + 1;
    }
    s = s.write("_start:\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    if (has_main(mod)) {
        s = s.write("    bl __fn_main\n");
        s = s.write("    mov x8, #93\n");
        s = s.write("    svc #0\n");
    } else {
        var n_locals: i32 = count_locals(mod.top_stmts);
        if (n_locals > 0) {
            var bytes: i32 = n_locals * 8;
            if (bytes % 16 != 0) { bytes = bytes + 8; }
            s = s.write("    sub sp, sp, #" + i32_to_string(bytes) + "\n");
        }
        var i: i32 = 0;
        while (i < len(mod.top_stmts)) {
            s = emit_stmt(mod.top_stmts[i], s);
            i = i + 1;
        }
        // Fallback exit.
        s = s.write("    mov x0, #0\n");
        s = s.write("    mov x8, #93\n");
        s = s.write("    svc #0\n");
    }
    // __lang_print_int helper: converts the i64 in x0 to
    // decimal text in a stack buffer and writes to stdout.
    if (s.needs_print_int) {
        s = s.write("__lang_print_int:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    sub sp, sp, #32\n");
        s = s.write("    mov x9, x0\n");
        s = s.write("    mov x10, #0\n");
        s = s.write("    cmp x9, #0\n");
        s = s.write("    bge .Lpi_pos\n");
        s = s.write("    neg x9, x9\n");
        s = s.write("    mov x10, #1\n");
        s = s.write(".Lpi_pos:\n");
        s = s.write("    sub x11, x29, #1\n");
        s = s.write("    cbnz x9, .Lpi_loop\n");
        s = s.write("    mov w12, #48\n");           // '0'
        s = s.write("    strb w12, [x11]\n");
        s = s.write("    sub x11, x11, #1\n");       // match loop's post-decrement
        s = s.write("    mov x12, #1\n");
        s = s.write("    b .Lpi_maybe_neg\n");
        s = s.write(".Lpi_loop:\n");
        s = s.write("    mov x12, #0\n");
        s = s.write(".Lpi_div:\n");
        s = s.write("    mov x13, #10\n");
        s = s.write("    sdiv x14, x9, x13\n");
        s = s.write("    msub x15, x14, x13, x9\n");
        s = s.write("    add x15, x15, #48\n");
        s = s.write("    strb w15, [x11]\n");
        s = s.write("    sub x11, x11, #1\n");
        s = s.write("    add x12, x12, #1\n");
        s = s.write("    mov x9, x14\n");
        s = s.write("    cbnz x9, .Lpi_div\n");
        s = s.write(".Lpi_maybe_neg:\n");
        s = s.write("    cmp x10, #0\n");
        s = s.write("    beq .Lpi_no_neg\n");
        s = s.write("    mov w15, #45\n");           // '-'
        s = s.write("    strb w15, [x11]\n");
        s = s.write("    sub x11, x11, #1\n");
        s = s.write("    add x12, x12, #1\n");
        s = s.write(".Lpi_no_neg:\n");
        s = s.write("    add x11, x11, #1\n");
        s = s.write("    mov x1, x11\n");
        s = s.write("    mov x2, x12\n");
        s = s.write("    mov x0, #1\n");
        s = s.write("    mov x8, #64\n");            // sys_write
        s = s.write("    svc #0\n");
        s = s.write("    mov sp, x29\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // __lang_read_int helper: reads up to 16 bytes from stdin
    // into a stack buffer, parses an optional leading `-`
    // followed by decimal digits, returns the value in x0.
    if (s.needs_read_int) {
        s = s.write("__lang_read_int:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    sub sp, sp, #32\n");
        s = s.write("    mov x0, #0\n");             // fd 0
        s = s.write("    sub x1, x29, #16\n");
        s = s.write("    mov x2, #16\n");
        s = s.write("    mov x8, #63\n");            // sys_read
        s = s.write("    svc #0\n");
        s = s.write("    sub x9, x29, #16\n");       // cursor
        s = s.write("    sub x10, x29, #16\n");
        s = s.write("    add x10, x10, x0\n");       // end ptr
        s = s.write("    mov x11, #0\n");            // accumulator
        s = s.write("    mov x12, #0\n");            // neg flag
        s = s.write("    cmp x9, x10\n");
        s = s.write("    beq .Lri_done\n");
        s = s.write("    ldrb w0, [x9]\n");
        s = s.write("    cmp w0, #45\n");            // '-'
        s = s.write("    bne .Lri_loop\n");
        s = s.write("    mov x12, #1\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write(".Lri_loop:\n");
        s = s.write("    cmp x9, x10\n");
        s = s.write("    beq .Lri_done\n");
        s = s.write("    ldrb w0, [x9]\n");
        s = s.write("    sub x0, x0, #48\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    blt .Lri_done\n");
        s = s.write("    cmp x0, #9\n");
        s = s.write("    bgt .Lri_done\n");
        s = s.write("    mov x13, #10\n");
        s = s.write("    mul x11, x11, x13\n");
        s = s.write("    add x11, x11, x0\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lri_loop\n");
        s = s.write(".Lri_done:\n");
        s = s.write("    cmp x12, #0\n");
        s = s.write("    beq .Lri_no_neg\n");
        s = s.write("    neg x11, x11\n");
        s = s.write(".Lri_no_neg:\n");
        s = s.write("    mov x0, x11\n");
        s = s.write("    mov sp, x29\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // .rodata: emit each interned string literal as a
    // labelled `.ascii` directive. GAS interprets the escape
    // sequences in the quoted string, so a `\n` byte in the
    // source string lands as a single LF in the resulting
    // .rodata bytes.
    if (len(s.string_lits) > 0) {
        s = s.write("    .section .rodata\n");
        var li: i32 = 0;
        while (li < len(s.string_lits)) {
            s = s.write(".S" + i32_to_string(li) + ": .ascii \"" + escape_for_ascii(s.string_lits[li]) + "\"\n");
            li = li + 1;
        }
    }
    // Heap allocator (arm64): 1 MiB .bss buffer + bump pointer.
    // Same shape as the x86-64 backend; instructions translated
    // to aarch64. Sets x0 = old ptr (return), advances the
    // ptr by x0 (the size arg).
    if (s.needs_heap) {
        s = s.write("    .bss\n");
        s = s.write("    .align 3\n");
        s = s.write("__lang_heap_ptr: .quad 0\n");
        s = s.write("    .align 3\n");
        s = s.write("__lang_heap: .skip 1048576\n");
        s = s.write("    .text\n");
        s = s.write(".globl __lang_alloc\n");
        s = s.write(".type __lang_alloc, %function\n");
        s = s.write("__lang_alloc:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    adrp x1, __lang_heap_ptr\n");
        s = s.write("    add x1, x1, :lo12:__lang_heap_ptr\n");
        s = s.write("    ldr x2, [x1]\n");
        s = s.write("    cbnz x2, .Lalloc_inited\n");
        s = s.write("    adrp x2, __lang_heap\n");
        s = s.write("    add x2, x2, :lo12:__lang_heap\n");
        s = s.write("    str x2, [x1]\n");
        s = s.write(".Lalloc_inited:\n");
        s = s.write("    ldr x2, [x1]\n");
        s = s.write("    add x3, x2, x0\n");
        s = s.write("    str x3, [x1]\n");
        s = s.write("    mov x0, x2\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
        s = s.write(".size __lang_alloc, .-__lang_alloc\n");
    }
    return s.out;
}

// =================== VALIDATION ====================

function contains(haystack: string, needle: string): boolean {
    if (len(needle) == 0) { return true; }
    if (len(haystack) < len(needle)) { return false; }
    var i: i32 = 0;
    while (i <= len(haystack) - len(needle)) {
        if (haystack[i:i + len(needle)] == needle) { return true; }
        i = i + 1;
    }
    return false;
}

function emit_source(src: string): string {
    return emit_module(parser.parse_module(lexer.tokenize(src)));
}

function main(): i32 {
    // Minimal: `return 42;` should produce asm with the literal,
    // the rt-stack push, exit code load, sys_exit syscall.
    var a1: string = emit_source("return 42;");
    if (!contains(a1, "ldr x0, =42")) { return 10; }
    if (!contains(a1, "str x0, [sp, #-16]!")) { return 11; }
    if (!contains(a1, "ldr x0, [sp], #16")) { return 12; }
    if (!contains(a1, "mov x8, #93")) { return 13; }
    if (!contains(a1, "svc #0")) { return 14; }
    if (!contains(a1, ".globl _start")) { return 15; }

    // Arithmetic: + emits add.
    var a2: string = emit_source("return 2 + 3;");
    if (!contains(a2, "add x0, x0, x1")) { return 20; }

    // Subtraction.
    var a3: string = emit_source("return 7 - 4;");
    if (!contains(a3, "sub x0, x0, x1")) { return 30; }

    // Multiplication.
    var a4: string = emit_source("return 6 * 7;");
    if (!contains(a4, "mul x0, x0, x1")) { return 40; }

    // Division: ARM64 sdiv.
    var a5: string = emit_source("return 20 / 4;");
    if (!contains(a5, "sdiv x0, x0, x1")) { return 50; }

    // Modulo: sdiv + msub (no native mod on ARM64).
    var a6: string = emit_source("return 23 % 5;");
    if (!contains(a6, "sdiv x2, x0, x1")) { return 60; }
    if (!contains(a6, "msub x0, x2, x1, x0")) { return 61; }

    // Unary negation.
    var a7: string = emit_source("return -5;");
    if (!contains(a7, "neg x0, x0")) { return 70; }

    // Nested expressions: `return (2 + 3) * 4;` emits add before mul.
    var a8: string = emit_source("return (2 + 3) * 4;");
    if (!contains(a8, "add x0, x0, x1")) { return 80; }
    if (!contains(a8, "mul x0, x0, x1")) { return 81; }

    // Comparisons: cmp + cset with the matching cc.
    var a9: string = emit_source("return 5 < 10;");
    if (!contains(a9, "cmp x0, x1")) { return 90; }
    if (!contains(a9, "cset x0, lt")) { return 91; }

    var a10: string = emit_source("return 5 <= 5;");
    if (!contains(a10, "cset x0, le")) { return 100; }

    var a11: string = emit_source("return 7 > 3;");
    if (!contains(a11, "cset x0, gt")) { return 110; }

    var a12: string = emit_source("return 7 >= 7;");
    if (!contains(a12, "cset x0, ge")) { return 120; }

    var a13: string = emit_source("return 4 == 4;");
    if (!contains(a13, "cset x0, eq")) { return 130; }

    var a14: string = emit_source("return 4 != 5;");
    if (!contains(a14, "cset x0, ne")) { return 140; }

    // If/else: emits cbz to else label, body, b to end label,
    // else label, else-body, end label.
    var a15: string = emit_source("if (true) { return 1; } else { return 2; }");
    if (!contains(a15, "cbz x0, .L")) { return 150; }
    if (!contains(a15, "b .L")) { return 151; }
    if (!contains(a15, ".L0:")) { return 152; }
    if (!contains(a15, ".L1:")) { return 153; }
    if (!contains(a15, "mov x0, #1")) { return 154; }  // true literal

    // No-else if.
    var a16: string = emit_source("if (true) { return 1; } return 0;");
    if (!contains(a16, "cbz x0, .L")) { return 160; }

    // While.
    var a17: string = emit_source("while (1 < 2) { return 0; }");
    if (!contains(a17, "cbz x0, .L")) { return 170; }
    if (!contains(a17, "b .L")) { return 171; }

    // Locals: frame prologue + slot store + slot load.
    var a18: string = emit_source("var x = 5; return x;");
    if (!contains(a18, "stp x29, x30, [sp, #-16]!")) { return 180; }
    if (!contains(a18, "mov x29, sp")) { return 181; }
    if (!contains(a18, "sub sp, sp, #")) { return 182; }
    if (!contains(a18, "str x0, [x29, #-8]")) { return 183; }
    if (!contains(a18, "ldr x0, [x29, #-8]")) { return 184; }

    // Multiple locals at -8, -16, -24.
    var a19: string = emit_source("var a = 1; var b = 2; var c = 3; return c;");
    if (!contains(a19, "str x0, [x29, #-8]")) { return 190; }
    if (!contains(a19, "str x0, [x29, #-16]")) { return 191; }
    if (!contains(a19, "str x0, [x29, #-24]")) { return 192; }
    if (!contains(a19, "ldr x0, [x29, #-24]")) { return 193; }

    // Re-assignment via assign.
    var a20: string = emit_source("var x = 5; x = x + 1; return x;");
    if (!contains(a20, "ldr x0, [x29, #-8]")) { return 200; }
    if (!contains(a20, "str x0, [x29, #-8]")) { return 201; }
    if (!contains(a20, "add x0, x0, x1")) { return 202; }

    // Function decl + call.
    var a21: string = emit_source(
        "function add(x: i32, y: i32): i32 { return x + y; }"
        + " function main(): i32 { return add(2, 3); }"
    );
    if (!contains(a21, "__fn_add:")) { return 210; }
    if (!contains(a21, "__fn_main:")) { return 211; }
    if (!contains(a21, "bl __fn_add")) { return 212; }
    if (!contains(a21, "bl __fn_main")) { return 213; }
    if (!contains(a21, "ldp x29, x30, [sp], #16")) { return 214; }
    if (!contains(a21, "ret\n")) { return 215; }

    // print("...") emits adrp + add for the literal address,
    // mov fd/len, sys_write syscall, and .rodata at end.
    var a22: string = emit_source("print(\"hi\\n\"); return 0;");
    if (!contains(a22, "adrp x1, .S0")) { return 220; }
    if (!contains(a22, "add x1, x1, :lo12:.S0")) { return 221; }
    if (!contains(a22, "mov x8, #64")) { return 222; }  // sys_write
    if (!contains(a22, ".section .rodata")) { return 223; }
    if (!contains(a22, ".S0: .ascii")) { return 224; }
    if (!contains(a22, "hi")) { return 225; }

    // print_int(N) emits a call to __lang_print_int + the
    // helper appended once at end of .text.
    var a23: string = emit_source("print_int(42); return 0;");
    if (!contains(a23, "bl __lang_print_int")) { return 230; }
    if (!contains(a23, "__lang_print_int:")) { return 231; }
    if (!contains(a23, ".Lpi_div:")) { return 232; }

    // read_int() emits a call to __lang_read_int + the helper.
    var a24: string = emit_source("return read_int();");
    if (!contains(a24, "bl __lang_read_int")) { return 240; }
    if (!contains(a24, "__lang_read_int:")) { return 241; }
    if (!contains(a24, ".Lri_loop:")) { return 242; }

    return 0;
}
