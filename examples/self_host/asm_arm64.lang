                struct_decls: s.struct_decls,
                loop_exit_labels: s.loop_exit_labels,
                loop_cont_labels: s.loop_cont_labels,
                funcs: s.funcs,
                local_types: s.local_types,
                needs_str_concat: s.needs_str_concat,
                needs_str_eq: s.needs_str_eq,
                needs_str_print: s.needs_str_print,
                needs_str_cmp: s.needs_str_cmp,
                needs_str_read_line: s.needs_str_read_line,
                needs_i32_to_string: s.needs_i32_to_string,
                needs_str_to_i32: s.needs_str_to_i32,
                needs_eprint: s.needs_eprint,
                needs_str_search: s.needs_str_search,
                needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
            };
            s = s.write(".Lfor_top_" + i32_to_string(top_lbl) + ":\n");
            // Condition.
            s = s.write("    ldr x0, [x29, #" + i32_to_string(arr_off) + "]\n");
            s = s.write("    ldr x1, [x0]\n");
            s = s.write("    ldr x2, [x29, #" + i32_to_string(idx_off) + "]\n");
            s = s.write("    cmp x2, x1\n");
            s = s.write("    b.ge .Lfor_end_" + i32_to_string(end_lbl) + "\n");
            // Bind element.
            s = s.write("    ldr x0, [x29, #" + i32_to_string(arr_off) + "]\n");
            s = s.write("    ldr x1, [x29, #" + i32_to_string(idx_off) + "]\n");
            s = s.write("    add x1, x1, #1\n");
            s = s.write("    ldr x0, [x0, x1, lsl #3]\n");
            s = s.write("    str x0, [x29, #" + i32_to_string(elem_off) + "]\n");
            // Body — break → .Lfor_end; continue → .Lfor_cont.
            s = s.push_loop_labels(".Lfor_end_" + i32_to_string(end_lbl), ".Lfor_cont_" + i32_to_string(cont_lbl));
            var bi: i32 = 0;
            while (bi < f.body.len()) {
                s = emit_stmt(f.body[bi], s);
                bi = bi + 1;
            }
            s = s.pop_loop_labels();
            // i = i + 1; jump to top.
            s = s.write(".Lfor_cont_" + i32_to_string(cont_lbl) + ":\n");
            s = s.write("    ldr x0, [x29, #" + i32_to_string(idx_off) + "]\n");
            s = s.write("    add x0, x0, #1\n");
            s = s.write("    str x0, [x29, #" + i32_to_string(idx_off) + "]\n");
            s = s.write("    b .Lfor_top_" + i32_to_string(top_lbl) + "\n");
            s = s.write(".Lfor_end_" + i32_to_string(end_lbl) + ":\n");
            return s;
        },
        parser.StmtBreak(_) => {
            var lbl: string = s.top_loop_exit();
            if (lbl.len() == 0) { return s.write("    // break outside loop\n"); }
            return s.write("    b " + lbl + "\n");
        },
        parser.StmtContinue(_) => {
            var lbl: string = s.top_loop_cont();
            if (lbl.len() == 0) { return s.write("    // continue outside loop\n"); }
            return s.write("    b " + lbl + "\n");
        },
        parser.StmtUnknown(_) => { return s.write("    // unsupported: StmtUnknown\n"); }
    }
    return s;
}

// emit_function emits a single FuncDecl as a `__fn_<name>:`
// label with prologue, arg-copy, body, and (fallback) epilogue.
// Args arrive on the stack at [x29, #16], [x29, #32], … (caller
// pushed right-to-left, so arg 0 is closest to the saved pair).
// Each arg takes 16 bytes because the rt-stack pushes/pops with
// 16-byte alignment. The prologue copies each arg into its
// local slot at [x29, #-8*(i+1)] so the body reads them
// uniformly.
function emit_function(fd: parser.FuncDecl, s: EmitState): EmitState {
    var label_name: string = fd.name;
    if (fd.receiver_type.len() > 0) {
        label_name = fd.receiver_type + "." + fd.name;
    }
    s = s.write("__fn_" + sanitize_label(label_name) + ":\n");
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    var has_recv: boolean = fd.receiver_name.len() > 0;
    var argc: i32 = fd.params.len();
    if (has_recv) { argc = argc + 1; }
    var n_body_locals: i32 = count_locals(fd.body);
    var total_locals: i32 = argc + n_body_locals;
    if (total_locals > 0) {
        var bytes: i32 = total_locals * 8;
        if (bytes % 16 != 0) { bytes = bytes + 8; }
        s = s.write("    sub sp, sp, #" + i32_to_string(bytes) + "\n");
    }
    s = s.reset_locals();
    s = s.enter_function();
    // For methods: receiver sits at +16(x29), params at
    // +32, +48, … (caller pushed args right-to-left then the
    // receiver, so receiver is closest to the saved fp).
    if (has_recv) {
        s = s.bind_local_typed(fd.receiver_name, ret_tag_of(fd.receiver_type));
        var recv_off: i32 = s.lookup_local(fd.receiver_name);
        s = s.write("    ldr x0, [x29, #16]   // recv " + fd.receiver_name + "\n");
        s = s.write("    str x0, [x29, #" + i32_to_string(recv_off) + "]\n");
    }
    var recv_shift: i32 = 0;
    if (has_recv) { recv_shift = 1; }
    var n_params: i32 = fd.params.len();
    var i: i32 = 0;
    while (i < n_params) {
        s = s.bind_local_typed(fd.params[i].name, ret_tag_of(fd.params[i].type_name));
        var local_off: i32 = s.lookup_local(fd.params[i].name);
        var arg_off: i32 = 16 + (i + recv_shift) * 16;
        s = s.write("    ldr x0, [x29, #" + i32_to_string(arg_off) + "]   // param " + fd.params[i].name + "\n");
        s = s.write("    str x0, [x29, #" + i32_to_string(local_off) + "]\n");
        i = i + 1;
    }
    var bi: i32 = 0;
    while (bi < fd.body.len()) {
        s = emit_stmt(fd.body[bi], s);
        bi = bi + 1;
    }
    // Fallback: implicit `return 0;` so falling off the end
    // doesn't run into the next function's label.
    s = s.write("    mov x0, #0\n");
    s = s.write("    mov sp, x29\n");
    s = s.write("    ldp x29, x30, [sp], #16\n");
    s = s.write("    ret\n");
    s = s.leave_function();
    s = s.reset_locals();
    return s;
}

function has_main(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].name == "main") { return true; }
        i = i + 1;
    }
    return false;
}

pub function emit_module(mod: parser.Module): string {
    var s: EmitState = new_state();
    // Seed the struct-decl table for ExprStructLit /
    // ExprFieldAccess.
    s = EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: s.needs_read_int,
        needs_heap: s.needs_heap,
        struct_decls: mod.structs,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: mod.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
    s = s.write("    .globl _start\n");
    s = s.write("    .text\n");
    // Emit each function body first. Each gets its own
    // __fn_<name>: label; _start dispatches into main() if it
    // exists.
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        s = emit_function(mod.funcs[fi], s);
        fi = fi + 1;
    }
    s = s.write("_start:\n");
    // Save argc + argv from initial stack BEFORE the frame push.
    if (s.needs_args) {
        s = s.write("    ldr x0, [sp]\n");
        s = s.write("    adrp x1, __lang_argc\n");
        s = s.write("    add x1, x1, :lo12:__lang_argc\n");
        s = s.write("    str x0, [x1]\n");
        s = s.write("    add x0, sp, #8\n");
        s = s.write("    adrp x1, __lang_argv\n");
        s = s.write("    add x1, x1, :lo12:__lang_argv\n");
        s = s.write("    str x0, [x1]\n");
    }
    s = s.write("    stp x29, x30, [sp, #-16]!\n");
    s = s.write("    mov x29, sp\n");
    if (has_main(mod)) {
        s = s.write("    bl __fn_main\n");
        s = s.write("    mov x8, #93\n");
        s = s.write("    svc #0\n");
    } else {
        var n_locals: i32 = count_locals(mod.top_stmts);
        if (n_locals > 0) {
            var bytes: i32 = n_locals * 8;
            if (bytes % 16 != 0) { bytes = bytes + 8; }
            s = s.write("    sub sp, sp, #" + i32_to_string(bytes) + "\n");
        }
        var i: i32 = 0;
        while (i < mod.top_stmts.len()) {
            s = emit_stmt(mod.top_stmts[i], s);
            i = i + 1;
        }
        // Fallback exit.
        s = s.write("    mov x0, #0\n");
        s = s.write("    mov x8, #93\n");
        s = s.write("    svc #0\n");
    }
    // __lang_print_int helper: converts the i64 in x0 to
    // decimal text in a stack buffer and writes to stdout.
    if (s.needs_print_int) {
        s = s.write("__lang_print_int:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    sub sp, sp, #32\n");
        s = s.write("    mov x9, x0\n");
        s = s.write("    mov x10, #0\n");
        s = s.write("    cmp x9, #0\n");
        s = s.write("    bge .Lpi_pos\n");
        s = s.write("    neg x9, x9\n");
        s = s.write("    mov x10, #1\n");
        s = s.write(".Lpi_pos:\n");
        s = s.write("    sub x11, x29, #1\n");
        s = s.write("    cbnz x9, .Lpi_loop\n");
        s = s.write("    mov w12, #48\n");           // '0'
        s = s.write("    strb w12, [x11]\n");
        s = s.write("    sub x11, x11, #1\n");       // match loop's post-decrement
        s = s.write("    mov x12, #1\n");
        s = s.write("    b .Lpi_maybe_neg\n");
        s = s.write(".Lpi_loop:\n");
        s = s.write("    mov x12, #0\n");
        s = s.write(".Lpi_div:\n");
        s = s.write("    mov x13, #10\n");
        s = s.write("    sdiv x14, x9, x13\n");
        s = s.write("    msub x15, x14, x13, x9\n");
        s = s.write("    add x15, x15, #48\n");
        s = s.write("    strb w15, [x11]\n");
        s = s.write("    sub x11, x11, #1\n");
        s = s.write("    add x12, x12, #1\n");
        s = s.write("    mov x9, x14\n");
        s = s.write("    cbnz x9, .Lpi_div\n");
        s = s.write(".Lpi_maybe_neg:\n");
        s = s.write("    cmp x10, #0\n");
        s = s.write("    beq .Lpi_no_neg\n");
        s = s.write("    mov w15, #45\n");           // '-'
        s = s.write("    strb w15, [x11]\n");
        s = s.write("    sub x11, x11, #1\n");
        s = s.write("    add x12, x12, #1\n");
        s = s.write(".Lpi_no_neg:\n");
        s = s.write("    add x11, x11, #1\n");
        s = s.write("    mov x1, x11\n");
        s = s.write("    mov x2, x12\n");
        s = s.write("    mov x0, #1\n");
        s = s.write("    mov x8, #64\n");            // sys_write
        s = s.write("    svc #0\n");
        s = s.write("    mov sp, x29\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // __lang_read_int helper: reads up to 16 bytes from stdin
    // into a stack buffer, parses an optional leading `-`
    // followed by decimal digits, returns the value in x0.
    if (s.needs_read_int) {
        s = s.write("__lang_read_int:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    sub sp, sp, #32\n");
        s = s.write("    mov x0, #0\n");             // fd 0
        s = s.write("    sub x1, x29, #16\n");
        s = s.write("    mov x2, #16\n");
        s = s.write("    mov x8, #63\n");            // sys_read
        s = s.write("    svc #0\n");
        s = s.write("    sub x9, x29, #16\n");       // cursor
        s = s.write("    sub x10, x29, #16\n");
        s = s.write("    add x10, x10, x0\n");       // end ptr
        s = s.write("    mov x11, #0\n");            // accumulator
        s = s.write("    mov x12, #0\n");            // neg flag
        s = s.write("    cmp x9, x10\n");
        s = s.write("    beq .Lri_done\n");
        s = s.write("    ldrb w0, [x9]\n");
        s = s.write("    cmp w0, #45\n");            // '-'
        s = s.write("    bne .Lri_loop\n");
        s = s.write("    mov x12, #1\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write(".Lri_loop:\n");
        s = s.write("    cmp x9, x10\n");
        s = s.write("    beq .Lri_done\n");
        s = s.write("    ldrb w0, [x9]\n");
        s = s.write("    sub x0, x0, #48\n");
        s = s.write("    cmp x0, #0\n");
        s = s.write("    blt .Lri_done\n");
        s = s.write("    cmp x0, #9\n");
        s = s.write("    bgt .Lri_done\n");
        s = s.write("    mov x13, #10\n");
        s = s.write("    mul x11, x11, x13\n");
        s = s.write("    add x11, x11, x0\n");
        s = s.write("    add x9, x9, #1\n");
        s = s.write("    b .Lri_loop\n");
        s = s.write(".Lri_done:\n");
        s = s.write("    cmp x12, #0\n");
        s = s.write("    beq .Lri_no_neg\n");
        s = s.write("    neg x11, x11\n");
        s = s.write(".Lri_no_neg:\n");
        s = s.write("    mov x0, x11\n");
        s = s.write("    mov sp, x29\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // __lang_print_str: x0 = box ptr. write(1, box.data, box.len).
    if (s.needs_str_print) {
        s = s.write("__lang_print_str:\n");
        s = s.write("    ldr x1, [x0]\n");      // data ptr
        s = s.write("    ldr x2, [x0, #8]\n");  // len
        s = s.write("    mov x0, #1\n");        // fd
        s = s.write("    mov x8, #64\n");       // sys_write
        s = s.write("    svc #0\n");
        s = s.write("    ret\n");
    }
    // __lang_str_concat: x0 = box A, x1 = box B → x0 = new box.
    if (s.needs_str_concat) {
        s = s.write("__lang_str_concat:\n");
        s = s.write("    stp x29, x30, [sp, #-16]!\n");
        s = s.write("    mov x29, sp\n");
        s = s.write("    stp x19, x20, [sp, #-16]!\n");
        s = s.write("    stp x21, x22, [sp, #-16]!\n");
        s = s.write("    stp x23, x24, [sp, #-16]!\n");
        s = s.write("    mov x19, x0\n");           // box A
        s = s.write("    mov x20, x1\n");           // box B
        s = s.write("    ldr x21, [x19, #8]\n");    // lenA
        s = s.write("    ldr x22, [x20, #8]\n");    // lenB
        // alloc lenA + lenB bytes.
        s = s.write("    add x0, x21, x22\n");
        s = s.write("    bl __lang_alloc\n");
        s = s.write("    mov x23, x0\n");           // data ptr
        // Copy A bytes.
        s = s.write("    ldr x1, [x19]\n");
        s = s.write("    mov x2, x23\n");
        s = s.write("    mov x3, x21\n");
        s = s.write("    cbz x3, .Lstrconcat_b\n");
        s = s.write(".Lstrconcat_a_loop:\n");
        s = s.write("    ldrb w4, [x1], #1\n");
        s = s.write("    strb w4, [x2], #1\n");
        s = s.write("    subs x3, x3, #1\n");
        s = s.write("    b.ne .Lstrconcat_a_loop\n");
        s = s.write(".Lstrconcat_b:\n");
        // Copy B bytes.
        s = s.write("    ldr x1, [x20]\n");
        s = s.write("    mov x3, x22\n");
        s = s.write("    cbz x3, .Lstrconcat_box\n");
        s = s.write(".Lstrconcat_b_loop:\n");
        s = s.write("    ldrb w4, [x1], #1\n");
        s = s.write("    strb w4, [x2], #1\n");
        s = s.write("    subs x3, x3, #1\n");
        s = s.write("    b.ne .Lstrconcat_b_loop\n");
        s = s.write(".Lstrconcat_box:\n");
        // Allocate 16-byte box.
        s = s.write("    mov x0, #16\n");
        s = s.write("    bl __lang_alloc\n");
        s = s.write("    str x23, [x0]\n");
        s = s.write("    add x1, x21, x22\n");
        s = s.write("    str x1, [x0, #8]\n");
        s = s.write("    ldp x23, x24, [sp], #16\n");
        s = s.write("    ldp x21, x22, [sp], #16\n");
        s = s.write("    ldp x19, x20, [sp], #16\n");
        s = s.write("    ldp x29, x30, [sp], #16\n");
        s = s.write("    ret\n");
    }
    // __lang_str_eq: x0 = box A, x1 = box B → x0 = 1 / 0.
    if (s.needs_str_eq) {
        s = s.write("__lang_str_eq:\n");
        s = s.write("    ldr x2, [x0, #8]\n");
        s = s.write("    ldr x3, [x1, #8]\n");
        s = s.write("    cmp x2, x3\n");
        s = s.write("    b.ne .Lstreq_no\n");
        s = s.write("    ldr x0, [x0]\n");
        s = s.write("    ldr x1, [x1]\n");
        s = s.write("    cbz x2, .Lstreq_yes\n");
        s = s.write(".Lstreq_loop:\n");
        s = s.write("    ldrb w3, [x0], #1\n");
        s = s.write("    ldrb w4, [x1], #1\n");
        s = s.write("    cmp w3, w4\n");
        s = s.write("    b.ne .Lstreq_no\n");
        s = s.write("    subs x2, x2, #1\n");
        s = s.write("    b.ne .Lstreq_loop\n");
        s = s.write(".Lstreq_yes:\n");
        s = s.write("    mov x0, #1\n");
        s = s.write("    ret\n");
        s = s.write(".Lstreq_no:\n");
        s = s.write("    mov x0, #0\n");
        s = s.write("    ret\n");
    }
    // __lang_str_cmp: x0 = box A, x1 = box B → x0 = signed
    // lexicographic compare (<0 / 0 / >0).
    if (s.needs_str_cmp) {
        s = s.write("__lang_str_cmp:\n");
        s = s.write("    ldr x2, [x0, #8]\n");   // lenA
        s = s.write("    ldr x3, [x1, #8]\n");   // lenB
        // min(lenA, lenB) → x4
        s = s.write("    mov x4, x2\n");
        s = s.write("    cmp x4, x3\n");
        s = s.write("    b.le .Lstrcmp_min\n");
        s = s.write("    mov x4, x3\n");
        s = s.write(".Lstrcmp_min:\n");
        s = s.write("    ldr x0, [x0]\n");
        s = s.write("    ldr x1, [x1]\n");
        s = s.write("    cbz x4, .Lstrcmp_len\n");
