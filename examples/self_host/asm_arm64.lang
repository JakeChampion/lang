                // `mov sp, x29` undoes whatever sub sp the
                // prologue did; ldp post-indexes sp by 16.
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    mov sp, x29\n");
                s = s.write("    ldp x29, x30, [sp], #16\n");
                s = s.write("    ret\n");
