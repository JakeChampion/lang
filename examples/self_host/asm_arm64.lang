        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

function (s: EmitState) mark_read_int(): EmitState {
    return EmitState {
        out: s.out,
        label_n: s.label_n,
        local_names: s.local_names,
        in_function: s.in_function,
        string_lits: s.string_lits,
        needs_print_int: s.needs_print_int,
        needs_read_int: true,
        needs_heap: s.needs_heap,
        struct_decls: s.struct_decls,
        loop_exit_labels: s.loop_exit_labels,
        loop_cont_labels: s.loop_cont_labels,
        funcs: s.funcs,
        local_types: s.local_types,
        needs_str_concat: s.needs_str_concat,
        needs_str_eq: s.needs_str_eq,
        needs_str_print: s.needs_str_print,
        needs_str_cmp: s.needs_str_cmp,
        needs_str_read_line: s.needs_str_read_line,
        needs_i32_to_string: s.needs_i32_to_string,
        needs_str_to_i32: s.needs_str_to_i32,
        needs_eprint: s.needs_eprint,
        needs_str_search: s.needs_str_search,
        needs_args: s.needs_args,
        needs_arr_push: s.needs_arr_push,
        needs_arr_slice: s.needs_arr_slice,
        needs_arr_i32_index_of: s.needs_arr_i32_index_of,
        needs_arr_reverse: s.needs_arr_reverse,
        needs_arr_concat: s.needs_arr_concat,
        needs_arr_str_index_of: s.needs_arr_str_index_of,
        needs_arr_str_join: s.needs_arr_str_join,
        needs_arr_i32_sum: s.needs_arr_i32_sum,
        needs_arr_i32_min_max: s.needs_arr_i32_min_max,
        needs_arr_i32_product: s.needs_arr_i32_product,
        needs_str_chars: s.needs_str_chars,
        needs_str_bytes: s.needs_str_bytes,
        needs_str_reverse: s.needs_str_reverse,
        needs_i32_pow: s.needs_i32_pow
    };
}

// escape_for_ascii rewrites a string for `.ascii "…"` syntax:
// quotes get backslashed, backslashes doubled, common
// whitespace bytes become GAS escape sequences so a `\n` byte
// in the source string lands as a single LF byte in .rodata.
function escape_for_ascii(s: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b == 34) { out = out + "\\\""; }
        else if (b == 92) { out = out + "\\\\"; }
        else if (b == 10) { out = out + "\\n"; }
        else if (b == 9) { out = out + "\\t"; }
        else if (b == 13) { out = out + "\\r"; }
        else { out = out + s[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

// =================== ASM EMITTER ====================

function emit_expr(e: parser.Expr, s: EmitState): EmitState {
    match (e) {
        parser.ExprNumber(n) => {
            // `ldr x0, =N` puts N in a literal pool; works for
            // any 64-bit value, including ones that don't fit
            // mov's 16-bit immediate field.
            s = s.write("    ldr x0, =" + n.text + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprBinary(b) => {
            if (b.op == "+") {
                var lt: string = infer_expr_type(b.left, s);
                var rt: string = infer_expr_type(b.right, s);
                if (lt == "string" || rt == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    ldr x1, [sp], #16\n");
                    s = s.write("    ldr x0, [sp], #16\n");
                    s = s.write("    bl __lang_str_concat\n");
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.mark_str_concat();
                    return s;
                }
            }
            if (b.op == "==" || b.op == "!=") {
                var elt: string = infer_expr_type(b.left, s);
                var ert: string = infer_expr_type(b.right, s);
                if (elt == "string" || ert == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    ldr x1, [sp], #16\n");
                    s = s.write("    ldr x0, [sp], #16\n");
                    s = s.write("    bl __lang_str_eq\n");
                    if (b.op == "!=") {
                        s = s.write("    eor x0, x0, #1\n");
                    }
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.mark_str_eq();
                    return s;
                }
            }
            // String ordering: < / <= / > / >= → __lang_str_cmp
            // and compare its signed result against zero.
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                var olt: string = infer_expr_type(b.left, s);
                var ort: string = infer_expr_type(b.right, s);
                if (olt == "string" || ort == "string") {
                    s = emit_expr(b.left, s);
                    s = emit_expr(b.right, s);
                    s = s.write("    ldr x1, [sp], #16\n");
                    s = s.write("    ldr x0, [sp], #16\n");
                    s = s.write("    bl __lang_str_cmp\n");
                    s = s.write("    cmp x0, #0\n");
                    if (b.op == "<") { s = s.write("    cset x0, lt\n"); }
                    else if (b.op == "<=") { s = s.write("    cset x0, le\n"); }
                    else if (b.op == ">") { s = s.write("    cset x0, gt\n"); }
                    else { s = s.write("    cset x0, ge\n"); }
                    s = s.write("    str x0, [sp, #-16]!\n");
                    s = s.mark_str_cmp();
                    return s;
                }
            }
            // Short-circuit boolean ops. Can't naively
            // emit both sides — the right operand's side
            // effects must not run when the left already
            // decides the result. `&&` short-circuits on
            // false (left == 0 ⇒ result = 0); `||` short-
            // circuits on true (left != 0 ⇒ result = 1).
            // Otherwise the right operand becomes the result.
            if (b.op == "&&" || b.op == "||") {
                s = emit_expr(b.left, s);
                s = s.write("    ldr x0, [sp], #16\n");
                var short_l: LabelOut = fresh_label(s);
                s = short_l.state;
                var end_l: LabelOut = fresh_label(s);
                s = end_l.state;
                if (b.op == "&&") {
                    s = s.write("    cbz x0, " + short_l.name + "\n");
                } else {
                    s = s.write("    cbnz x0, " + short_l.name + "\n");
                }
                s = emit_expr(b.right, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    b " + end_l.name + "\n");
                s = s.write(short_l.name + ":\n");
                if (b.op == "&&") {
                    s = s.write("    mov x0, #0\n");
                } else {
                    s = s.write("    mov x0, #1\n");
                }
                s = s.write(end_l.name + ":\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = emit_expr(b.left, s);
            s = emit_expr(b.right, s);
            s = s.write("    ldr x1, [sp], #16\n");   // rhs
            s = s.write("    ldr x0, [sp], #16\n");   // lhs
            if (b.op == "+") {
                s = s.write("    add x0, x0, x1\n");
            } else if (b.op == "-") {
                s = s.write("    sub x0, x0, x1\n");
            } else if (b.op == "*") {
                s = s.write("    mul x0, x0, x1\n");
            } else if (b.op == "/") {
                s = s.write("    sdiv x0, x0, x1\n");
            } else if (b.op == "%") {
                // ARM64 has no native modulo. Compute via
                // remainder = lhs - (lhs/rhs)*rhs.
                // msub x_d, x_n, x_m, x_a → x_d = x_a - x_n*x_m
                s = s.write("    sdiv x2, x0, x1\n");
                s = s.write("    msub x0, x2, x1, x0\n");
            } else if (b.op == "<" || b.op == "<=" || b.op == ">"
                    || b.op == ">=" || b.op == "==" || b.op == "!=") {
                // Comparison: `cmp lhs, rhs` sets the condition
                // flags; `cset` materialises the bool (0/1) into
                // x0 based on the chosen cc.
                s = s.write("    cmp x0, x1\n");
                var cc: string = "";
                if (b.op == "<") { cc = "lt"; }
                else if (b.op == "<=") { cc = "le"; }
                else if (b.op == ">") { cc = "gt"; }
                else if (b.op == ">=") { cc = "ge"; }
                else if (b.op == "==") { cc = "eq"; }
                else { cc = "ne"; }
                s = s.write("    cset x0, " + cc + "\n");
            } else {
                s = s.write("    // unsupported binop: " + b.op + "\n");
            }
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    neg x0, x0\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            if (u.op == "!") {
                // Boolean negation. Operand is in the
                // `{0, 1}` normal form maintained by every
                // bool-producing path (literal, comparison,
                // short-circuit, str_*), so XOR with 1 flips
                // it without needing to widen first.
                s = emit_expr(u.operand, s);
                s = s.write("    ldr x0, [sp], #16\n");
                s = s.write("    eor x0, x0, #1\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = s.write("    // unsupported unary: " + u.op + "\n");
            return s;
        },
        parser.ExprBool(b) => {
            // Bool literal — 1 for true, 0 for false on the
            // rt-stack so it can flow through comparison-style
            // consumers (e.g. an if cond branching on `true`).
            var v: i32 = 0;
            if (b.value) { v = 1; }
            s = s.write("    mov x0, #" + i32_to_string(v) + "\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprIdent(id) => {
            if (s.has_local(id.name)) {
                var off: i32 = s.lookup_local(id.name);
                s = s.write("    ldr x0, [x29, #" + i32_to_string(off) + "]\n");
                s = s.write("    str x0, [sp, #-16]!\n");
                return s;
            }
            s = s.write("    // unresolved ident: " + id.name + "\n");
            s = s.write("    mov x0, #0\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprString(sv) => {
            // String literal: intern bytes in .rodata, allocate
            // 16-byte heap box [data_ptr, len], push box ptr.
            var lo: StringLitOut = add_string_lit(s, sv.value);
            s = lo.state;
            s = s.write("    mov x0, #16\n");
            s = s.write("    bl __lang_alloc\n");
            s = s.mark_heap();
            s = s.write("    adrp x1, .S" + i32_to_string(lo.idx) + "\n");
            s = s.write("    add x1, x1, :lo12:.S" + i32_to_string(lo.idx) + "\n");
            s = s.write("    str x1, [x0]\n");
            s = s.write("    mov x1, #" + i32_to_string(sv.value.len()) + "\n");
            s = s.write("    str x1, [x0, #8]\n");
            s = s.write("    str x0, [sp, #-16]!\n");
            return s;
        },
        parser.ExprCall(c) => {
            var name: string = "";
            match (c.callee) {
                parser.ExprIdent(id) => { name = id.name; },
                parser.ExprFieldAccess(fa) => {
                    // Primitive-receiver fast path: see
                    // asm.lang for rationale.
                    var prim_recv: string = infer_expr_type(fa.obj, s);
                    // Built-in `.to_string()` on i32 and string —
                    // i32 routes to the existing runtime helper,
                    // string returns the receiver unchanged. The
                    // generic path below would chase a
                    // `__fn_i32.to_string` symbol that no FuncDecl
                    // emits, producing a link error.
                    if (fa.field == "to_string" && c.args.len() == 0
                            && (prim_recv == "i32" || prim_recv == "string")) {
                        s = emit_expr(fa.obj, s);
                        if (prim_recv == "i32") {
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    bl __lang_i32_to_string\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            s = s.mark_i32_to_string();
                        }
                        return s;
                    }
                    // Built-in `.len()` / `.is_empty()` on
                    // strings and arrays. Inline — they read
                    // the length word directly.
                    if (fa.field == "len" && c.args.len() == 0
                            && (prim_recv == "string"
                                || prim_recv == "array_i32"
                                || prim_recv == "array_string"
                                || prim_recv == "array")) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    ldr x0, [sp], #16\n");
                        if (prim_recv == "string") {
                            s = s.write("    ldr x0, [x0, #8]\n");
                        } else {
                            s = s.write("    ldr x0, [x0]\n");
                        }
                        s = s.write("    str x0, [sp, #-16]!\n");
                        return s;
                    }
                    if (fa.field == "is_empty" && c.args.len() == 0
                            && (prim_recv == "string"
                                || prim_recv == "array_i32"
                                || prim_recv == "array_string"
                                || prim_recv == "array")) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    ldr x0, [sp], #16\n");
                        if (prim_recv == "string") {
                            s = s.write("    ldr x0, [x0, #8]\n");
                        } else {
                            s = s.write("    ldr x0, [x0]\n");
                        }
                        s = s.write("    cmp x0, #0\n");
                        s = s.write("    cset x0, eq\n");
                        s = s.write("    str x0, [sp, #-16]!\n");
                        return s;
                    }
                    // Built-in i32 numeric methods. Inline — no
                    // runtime helper needed.
                    if (prim_recv == "i32") {
                        if (fa.field == "abs" && c.args.len() == 0) {
                            s = emit_expr(fa.obj, s);
                            s = s.write("    ldr x0, [sp], #16\n");
                            // cneg: conditional negate. If x0 < 0
                            // set x0 = -x0, else keep.
                            s = s.write("    cmp x0, #0\n");
                            s = s.write("    cneg x0, x0, lt\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                        if (fa.field == "min" && c.args.len() == 1) {
                            s = emit_expr(fa.obj, s);
                            s = emit_expr(c.args[0], s);
                            s = s.write("    ldr x1, [sp], #16\n");
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    cmp x0, x1\n");
                            s = s.write("    csel x0, x0, x1, lt\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                        if (fa.field == "max" && c.args.len() == 1) {
                            s = emit_expr(fa.obj, s);
                            s = emit_expr(c.args[0], s);
                            s = s.write("    ldr x1, [sp], #16\n");
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    cmp x0, x1\n");
                            s = s.write("    csel x0, x0, x1, gt\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                        if (fa.field == "clamp" && c.args.len() == 2) {
                            s = emit_expr(fa.obj, s);
                            s = emit_expr(c.args[0], s);
                            s = emit_expr(c.args[1], s);
                            s = s.write("    ldr x2, [sp], #16\n");   // hi
                            s = s.write("    ldr x1, [sp], #16\n");   // lo
                            s = s.write("    ldr x0, [sp], #16\n");   // n
                            // n = max(n, lo) — keep n if n > lo, else lo
                            s = s.write("    cmp x0, x1\n");
                            s = s.write("    csel x0, x0, x1, gt\n");
                            // n = min(n, hi) — keep n if n < hi, else hi
                            s = s.write("    cmp x0, x2\n");
                            s = s.write("    csel x0, x0, x2, lt\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                        if (fa.field == "pow" && c.args.len() == 1) {
                            s = emit_expr(fa.obj, s);
                            s = emit_expr(c.args[0], s);
                            s = s.write("    ldr x1, [sp], #16\n");
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    bl __lang_i32_pow\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            s = s.mark_i32_pow();
                            return s;
                        }
                        if (fa.field == "sign" && c.args.len() == 0) {
                            // sign(n) = 1 if n>0, -1 if n<0, 0 if 0.
                            // Computed as `(n>0) - (n<0)`.
                            s = emit_expr(fa.obj, s);
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    cmp x0, #0\n");
                            s = s.write("    cset x1, gt\n");
                            s = s.write("    cset x2, lt\n");
                            s = s.write("    sub x0, x1, x2\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                        if (fa.field == "is_even" && c.args.len() == 0) {
                            s = emit_expr(fa.obj, s);
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    and x0, x0, #1\n");
                            s = s.write("    eor x0, x0, #1\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                        if (fa.field == "is_odd" && c.args.len() == 0) {
                            s = emit_expr(fa.obj, s);
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    and x0, x0, #1\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                        if (fa.field == "is_zero" && c.args.len() == 0) {
                            s = emit_expr(fa.obj, s);
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    cmp x0, #0\n");
                            s = s.write("    cset x0, eq\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                        if (fa.field == "is_positive" && c.args.len() == 0) {
                            s = emit_expr(fa.obj, s);
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    cmp x0, #0\n");
                            s = s.write("    cset x0, gt\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                        if (fa.field == "is_negative" && c.args.len() == 0) {
                            s = emit_expr(fa.obj, s);
                            s = s.write("    ldr x0, [sp], #16\n");
                            s = s.write("    cmp x0, #0\n");
                            s = s.write("    cset x0, lt\n");
                            s = s.write("    str x0, [sp, #-16]!\n");
                            return s;
                        }
                    }
                    // Built-in `.push(x)` on arrays — append a
                    // single 8-byte payload (i32 or string-box
                    // ptr; both are 8 bytes in the operand-stack
                    // representation). Returns a fresh array.
                    if (fa.field == "push" && c.args.len() == 1
                            && (prim_recv == "array_i32" || prim_recv == "array_string" || prim_recv == "array")) {
                        s = emit_expr(fa.obj, s);
                        s = emit_expr(c.args[0], s);
                        s = s.write("    ldr x1, [sp], #16\n");
                        s = s.write("    ldr x0, [sp], #16\n");
                        s = s.write("    bl __lang_arr_push\n");
                        s = s.write("    str x0, [sp, #-16]!\n");
                        s = s.mark_arr_push();
                        return s;
                    }
                    // Built-in `.reverse()` on arrays — returns
                    // a fresh array with elements in opposite
                    // order. Same 8-byte payload assumption as
                    // `.push` / `.slice`; works for both i32[]
                    // and string[].
                    if (fa.field == "reverse" && c.args.len() == 0
                            && (prim_recv == "array_i32" || prim_recv == "array_string" || prim_recv == "array")) {
                        s = emit_expr(fa.obj, s);
                        s = s.write("    ldr x0, [sp], #16\n");
                        s = s.write("    bl __lang_arr_reverse\n");
                        s = s.write("    str x0, [sp, #-16]!\n");
                        s = s.mark_arr_reverse();
                        return s;
                    }
                    // Built-in `.concat(other)` on arrays — fresh
                    // array of length `a.len + b.len`. Caller is
                    // responsible for both arrays being the same
                    // element type (the helper just copies 8-byte
                    // payloads, so layout-compatible types — i32[]
                    // and string[] — both work).
                    if (fa.field == "concat" && c.args.len() == 1
                            && (prim_recv == "array_i32" || prim_recv == "array_string" || prim_recv == "array")) {
                        s = emit_expr(fa.obj, s);
                        s = emit_expr(c.args[0], s);
                        s = s.write("    ldr x1, [sp], #16\n");
                        s = s.write("    ldr x0, [sp], #16\n");
                        s = s.write("    bl __lang_arr_concat\n");
                        s = s.write("    str x0, [sp, #-16]!\n");
                        s = s.mark_arr_concat();
                        return s;
                    }
                    // Built-in `.first()` / `.last()` on arrays —
                    // O(1) element access. UB on empty arrays.
                    if (fa.field == "first" && c.args.len() == 0
