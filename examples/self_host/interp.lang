// examples/self_host/interp.lang — fourth concrete step of the
// self-host port. Imports lexer + parser and evaluates the
// Stmt[] tree directly, producing a runtime value rather than a
// static type or compiled artifact. Completes the
// lexer → parser → interpreter vertical slice in lang —
// the lang-port pipeline can now actually run lang code, end to
// end, from a thin self-validating driver.
//
// Scope (matches the parser's): i32 / bool / string runtime
// values, var binding through a flat scope, arithmetic /
// comparison / logical / string-concat ops over the same op
// set the checker (#619) handles. The return value of the first
// `return` statement is what main() surfaces — anything past it
// is dead code.
//
// Out of scope (next iteration): function decls + calls, control
// flow (`if` / `while` / `for`), structs / unions, generics. The
// parser stub doesn't emit those yet either.

import "core/no_prelude";
import "./lexer";
import "./parser";

// =================== VALUES ====================

pub struct VInt { v: i32 }
pub struct VBool { v: boolean }
pub struct VString { v: string }
// VFloat carries a 64-bit IEEE 754 float. Literals tagged
// `is_float = true` by the parser produce a VFloat; arithmetic
// + comparison operators on two VFloats stay in float-land.
// Mixed i32/f64 isn't supported — explicit cast at the source
// level would route through a future numeric coercion pass.
pub struct VFloat { v: f64 }
pub struct VArr { elements: Value[] }
// VTuple holds an immutable fixed-arity sequence of values.
// Each slot's runtime type stays whatever the source emitted;
// `.0` / `.1` / … indices read positionally.
pub struct VTuple { elements: Value[] }
// VStruct holds a user-defined struct value. Parallel arrays
// for field names and corresponding evaluated values.
// type_name is the struct's declared name — useful for
// diagnostics and (later) for struct-aware equality.
pub struct VStruct { type_name: string, field_names: string[], field_values: Value[] }
pub struct VErr { msg: string }

// VErr is the bottom of the value lattice — it propagates
// silently through every operator that touches it so the first
// error wins. Mirrors how the checker's TypeUnknown works.

pub type Value = VInt | VBool | VString | VFloat | VArr | VTuple | VStruct | VErr;

function v_int(n: i32): Value { return VInt { v: n }; }
function v_bool(b: boolean): Value { return VBool { v: b }; }
function v_string(s: string): Value { return VString { v: s }; }
function v_float(n: f64): Value { return VFloat { v: n }; }
function v_arr(elements: Value[]): Value { return VArr { elements: elements }; }
function v_tuple(elements: Value[]): Value { return VTuple { elements: elements }; }
function v_struct(type_name: string, names: string[], values: Value[]): Value {
    return VStruct { type_name: type_name, field_names: names, field_values: values };
}
function v_err(msg: string): Value { return VErr { msg: msg }; }

function is_err(v: Value): boolean {
    match (v) {
        VErr(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// =================== SCOPE ====================

// Same shape as the checker's Scope but the parallel slot is
// Value rather than Type. Linear scan, newest binding wins —
// matches `let` semantics for the limited stmt set we handle.
// Env carries both the value scope and the immutable function
// table (so ExprCall can dispatch from anywhere a value lives in
// scope). bind / update / trim preserve `funcs` unchanged.
pub struct Env { names: string[], values: Value[], funcs: parser.FuncDecl[] }

function new_env(): Env {
    var ns: string[] = [];
    var vs: Value[] = [];
    var fs: parser.FuncDecl[] = [];
    return Env { names: ns, values: vs, funcs: fs };
}

function new_env_with_funcs(fs: parser.FuncDecl[]): Env {
    var ns: string[] = [];
    var vs: Value[] = [];
    return Env { names: ns, values: vs, funcs: fs };
}

function (e: Env) bind(name: string, v: Value): Env {
    var ns: string[] = e.names.push(name);
    var vs: Value[] = e.values.push(v);
    return Env { names: ns, values: vs, funcs: e.funcs };
}

function (e: Env) lookup(name: string): Value {
    var i: i32 = len(e.names) - 1;
    while (i >= 0) {
        if (e.names[i] == name) { return e.values[i]; }
        i = i - 1;
    }
    return v_err("undefined identifier: " + name);
}

// update mutates the slot for an existing name. Linear back-to-
// front scan so the most-recent shadowing binding wins (matches
// lookup). Returns a fresh Env — the parallel-array shape is
// rebuilt with the slot replaced because the underlying arrays
// are value-typed (push returns a new array). Returns the
// original env unchanged when the name isn't bound; the checker
// is supposed to surface that as a type error, but the interp
// guards against it via VErr-on-read at the call site.
function (e: Env) update(name: string, v: Value): Env {
    var n: i32 = len(e.names);
    var ns: string[] = [];
    var vs: Value[] = [];
    var found: boolean = false;
    var i: i32 = n - 1;
    // Walk from the end forward, recording which index to
    // replace. Then rebuild forward to keep declaration order.
    var hit_idx: i32 = 0 - 1;
    while (i >= 0) {
        if (!found && e.names[i] == name) {
            hit_idx = i;
            found = true;
        }
        i = i - 1;
    }
    if (!found) { return e; }
    var j: i32 = 0;
    while (j < n) {
        ns = ns.push(e.names[j]);
        if (j == hit_idx) {
            vs = vs.push(v);
        } else {
            vs = vs.push(e.values[j]);
        }
        j = j + 1;
    }
    return Env { names: ns, values: vs, funcs: e.funcs };
}

// =================== INTEGER PARSE ====================

// The parser hands us a TokNumber whose text is the original
// digit run. Turn that into an i32. No suffix handling here —
// we lump everything into i32 at this layer, mirroring the
// checker's TypeI32-only stance for the first cut.
function str_to_i32(s: string): i32 {
    var n: i32 = len(s);
    var acc: i32 = 0;
    var i: i32 = 0;
    while (i < n) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return acc; }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    return acc;
}

// str_to_f64 parses a decimal float literal: an optional `-`,
// integer digits, optional `.` + fractional digits. No
// exponents in this cut — the parser's float literals are
// "%d.%d" shaped. Walks the integer part first, then the
// fractional part with a 1/10**k divisor.
function str_to_f64(s: string): f64 {
    var n: i32 = len(s);
    var neg: boolean = false;
    var i: i32 = 0;
    if (n > 0 && s[0] == 45) { neg = true; i = 1; }  // '-' = 0x2D
    var int_part: f64 = 0.0;
    var frac_part: f64 = 0.0;
    var divisor: f64 = 1.0;
    var seen_dot: boolean = false;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 46) { seen_dot = true; i = i + 1; continue; }  // '.' = 0x2E
        if (b < 48 || b > 57) { break; }
        var d: i32 = b - 48;
        var df: f64 = (d as f64);
        if (seen_dot) {
            divisor = divisor * 10.0;
            frac_part = frac_part + (df / divisor);
        } else {
            int_part = int_part * 10.0 + df;
        }
        i = i + 1;
    }
    var v: f64 = int_part + frac_part;
    if (neg) { v = 0.0 - v; }
    return v;
}

// =================== EVAL ====================

// eval_expr: a depth-first walk of the parser's Expr tree.
// Errors propagate via VErr — the moment any sub-expression
// errors, the surrounding op returns the same VErr. This keeps
// the early-return pattern out of the body and matches the
// checker's TypeUnknown threading.
function eval_expr(e: parser.Expr, env: Env): Value {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) { return v_float(str_to_f64(n.text)); }
            return v_int(str_to_i32(n.text));
        },
        parser.ExprBool(b) => { return v_bool(b.value); },
        parser.ExprString(s) => { return v_string(s.value); },
        parser.ExprIdent(id) => { return env.lookup(id.name); },
        parser.ExprBinary(b) => {
            var lv: Value = eval_expr(b.left, env);
            if (is_err(lv)) { return lv; }
            var rv: Value = eval_expr(b.right, env);
            if (is_err(rv)) { return rv; }
            // `+` overloads i32 (arithmetic) and string (concat).
            if (b.op == "+") {
                match (lv) {
                    VInt(li) => {
                        match (rv) {
                            VInt(ri) => { return v_int(li.v + ri.v); },
                            _ => { return v_err("`+` rhs not i32"); }
                        }
                    },
                    VString(ls) => {
                        match (rv) {
                            VString(rs) => { return v_string(ls.v + rs.v); },
                            _ => { return v_err("`+` rhs not string"); }
                        }
                    },
                    VFloat(lf) => {
                        match (rv) {
                            VFloat(rf) => { return v_float(lf.v + rf.v); },
                            _ => { return v_err("`+` rhs not f64"); }
                        }
                    },
                    _ => { return v_err("`+` lhs not i32, string, or f64"); }
                }
            }
            if (b.op == "-" || b.op == "*" || b.op == "/" || b.op == "%") {
                match (lv) {
                    VInt(li) => {
                        match (rv) {
                            VInt(ri) => {
                                if (b.op == "-") { return v_int(li.v - ri.v); }
                                if (b.op == "*") { return v_int(li.v * ri.v); }
                                if (b.op == "/") {
                                    if (ri.v == 0) { return v_err("division by zero"); }
                                    return v_int(li.v / ri.v);
                                }
                                if (ri.v == 0) { return v_err("modulo by zero"); }
                                return v_int(li.v % ri.v);
                            },
                            _ => { return v_err("arithmetic rhs not i32"); }
                        }
                    },
                    VFloat(lf) => {
                        match (rv) {
                            VFloat(rf) => {
                                if (b.op == "-") { return v_float(lf.v - rf.v); }
                                if (b.op == "*") { return v_float(lf.v * rf.v); }
                                if (b.op == "/") {
                                    if (rf.v == 0.0) { return v_err("float division by zero"); }
                                    return v_float(lf.v / rf.v);
                                }
                                // `%` on floats isn't supported — the
                                // semantics differ across languages
                                // and the parser side doesn't yet
                                // distinguish.
                                return v_err("`%` on f64 is unsupported");
                            },
                            _ => { return v_err("arithmetic rhs not f64"); }
                        }
                    },
                    _ => { return v_err("arithmetic lhs not i32 or f64"); }
                }
            }
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                match (lv) {
                    VInt(li) => {
                        match (rv) {
                            VInt(ri) => {
                                if (b.op == "<") { return v_bool(li.v < ri.v); }
                                if (b.op == "<=") { return v_bool(li.v <= ri.v); }
                                if (b.op == ">") { return v_bool(li.v > ri.v); }
                                return v_bool(li.v >= ri.v);
                            },
                            _ => { return v_err("comparison rhs not i32"); }
                        }
                    },
                    VFloat(lf) => {
                        match (rv) {
                            VFloat(rf) => {
                                if (b.op == "<") { return v_bool(lf.v < rf.v); }
                                if (b.op == "<=") { return v_bool(lf.v <= rf.v); }
                                if (b.op == ">") { return v_bool(lf.v > rf.v); }
                                return v_bool(lf.v >= rf.v);
                            },
                            _ => { return v_err("comparison rhs not f64"); }
                        }
                    },
                    _ => { return v_err("comparison lhs not i32 or f64"); }
                }
            }
            if (b.op == "==" || b.op == "!=") {
                var eq: boolean = value_eq(lv, rv);
                if (b.op == "==") { return v_bool(eq); }
                return v_bool(!eq);
            }
            if (b.op == "&&" || b.op == "||") {
                match (lv) {
                    VBool(lb) => {
                        match (rv) {
                            VBool(rb) => {
                                if (b.op == "&&") { return v_bool(lb.v && rb.v); }
                                return v_bool(lb.v || rb.v);
                            },
                            _ => { return v_err("logical rhs not bool"); }
                        }
                    },
                    _ => { return v_err("logical lhs not bool"); }
                }
            }
            return v_err("unknown binary op: " + b.op);
        },
        parser.ExprUnary(u) => {
            var ov: Value = eval_expr(u.operand, env);
            if (is_err(ov)) { return ov; }
            if (u.op == "-") {
                match (ov) {
                    VInt(i) => { return v_int(0 - i.v); },
                    VFloat(f) => { return v_float(0.0 - f.v); },
                    _ => { return v_err("unary `-` operand not i32 or f64"); }
                }
            }
            if (u.op == "!") {
                match (ov) {
                    VBool(b) => { return v_bool(!b.v); },
                    _ => { return v_err("unary `!` operand not bool"); }
                }
            }
            return v_err("unknown unary op: " + u.op);
        },
        parser.ExprCall(c) => {
            // Bare-ident callee → plain function call.
            // FieldAccess callee → method call: evaluate the
            // receiver, dispatch on its struct type_name.
            var name: string = "";
            var is_method: boolean = false;
            var recv: Value = v_err("__noreceiver__");
            match (c.callee) {
                parser.ExprIdent(id) => { name = id.name; },
                parser.ExprFieldAccess(fa) => {
                    name = fa.field;
                    is_method = true;
                    recv = eval_expr(fa.obj, env);
                    if (is_err(recv)) { return recv; }
                },
                _ => { return v_err("call target is not an identifier"); }
            }
            // Evaluate args in order, propagating the first VErr.
            var arg_vals: Value[] = [];
            var i: i32 = 0;
            while (i < len(c.args)) {
                var av: Value = eval_expr(c.args[i], env);
                if (is_err(av)) { return av; }
                arg_vals = arg_vals.push(av);
                i = i + 1;
            }
            if (is_method) {
                return call_method(recv, name, arg_vals, env.funcs);
            }
            return call_func(name, arg_vals, env.funcs);
        },
        parser.ExprTuple(t) => {
            var elems: Value[] = [];
            var i: i32 = 0;
            while (i < len(t.elements)) {
                var ev: Value = eval_expr(t.elements[i], env);
                if (is_err(ev)) { return ev; }
                elems = elems.push(ev);
                i = i + 1;
            }
            return v_tuple(elems);
        },
        parser.ExprArray(a) => {
            var elems: Value[] = [];
            var i: i32 = 0;
            while (i < len(a.elements)) {
                var ev: Value = eval_expr(a.elements[i], env);
                if (is_err(ev)) { return ev; }
                elems = elems.push(ev);
                i = i + 1;
            }
            return v_arr(elems);
        },
        parser.ExprIndex(x) => {
            var av: Value = eval_expr(x.array, env);
            if (is_err(av)) { return av; }
            var iv: Value = eval_expr(x.index, env);
            if (is_err(iv)) { return iv; }
            match (av) {
                VArr(arr) => {
                    match (iv) {
                        VInt(ii) => {
                            if (ii.v < 0 || ii.v >= len(arr.elements)) {
                                return v_err("array index out of range");
                            }
                            return arr.elements[ii.v];
                        },
                        _ => { return v_err("array index must be i32"); }
                    }
                },
                VString(s) => {
                    // String indexing returns the byte at the
                    // given position as i32 — matches the lang
                    // semantics in the Go pipeline. Useful for
                    // any text-processing code (the lexer's
                    // own implementation reads bytes this way).
                    match (iv) {
                        VInt(ii) => {
                            if (ii.v < 0 || ii.v >= len(s.v)) {
                                return v_err("string index out of range");
                            }
                            return v_int(s.v[ii.v]);
                        },
                        _ => { return v_err("string index must be i32"); }
                    }
                },
                _ => { return v_err("can only index into an array or string"); }
            }
            return v_err("unreachable index arm");
        },
        parser.ExprSlice(sl) => {
            var av: Value = eval_expr(sl.array, env);
            if (is_err(av)) { return av; }
            var sv: Value = eval_expr(sl.start, env);
            if (is_err(sv)) { return sv; }
            var ev: Value = eval_expr(sl.end, env);
            if (is_err(ev)) { return ev; }
            var sb: i32 = 0;
            var eb: i32 = 0;
            match (sv) {
                VInt(i) => { sb = i.v; },
                _ => { return v_err("slice start must be i32"); }
            }
            match (ev) {
                VInt(i) => { eb = i.v; },
                _ => { return v_err("slice end must be i32"); }
            }
            match (av) {
                VString(s) => {
                    if (sb < 0 || eb > len(s.v) || sb > eb) {
                        return v_err("string slice out of range");
                    }
                    return v_string(s.v[sb:eb]);
                },
                VArr(a) => {
                    if (sb < 0 || eb > len(a.elements) || sb > eb) {
                        return v_err("array slice out of range");
                    }
                    var out: Value[] = [];
                    var i: i32 = sb;
                    while (i < eb) { out = out.push(a.elements[i]); i = i + 1; }
                    return v_arr(out);
                },
                _ => { return v_err("can only slice array or string"); }
            }
            return v_err("unreachable slice arm");
        },
        parser.ExprStructLit(sl) => {
            // Evaluate each field's value in declaration order,
            // propagating the first VErr. Field names are
            // copied as-is from the parser; the runtime treats
            // them as opaque strings for lookup.
            var fvs: Value[] = [];
            var i: i32 = 0;
            while (i < len(sl.field_values)) {
                var fv: Value = eval_expr(sl.field_values[i], env);
                if (is_err(fv)) { return fv; }
                fvs = fvs.push(fv);
                i = i + 1;
            }
            return v_struct(sl.type_name, sl.field_names, fvs);
        },
        parser.ExprFieldAccess(fa) => {
            // Evaluate the object. Field can be:
            //   * struct field name (linear scan)
            //   * tuple index `0` / `1` / … (string-of-digits)
            // The parser stores both shapes as a bare string;
            // we disambiguate on the receiver's runtime type.
            var ov: Value = eval_expr(fa.obj, env);
            if (is_err(ov)) { return ov; }
            match (ov) {
                VStruct(sv) => {
                    var i: i32 = 0;
                    while (i < len(sv.field_names)) {
                        if (sv.field_names[i] == fa.field) {
                            return sv.field_values[i];
                        }
                        i = i + 1;
                    }
                    return v_err("struct " + sv.type_name + " has no field `" + fa.field + "`");
                },
                VTuple(tv) => {
                    var idx: i32 = str_to_i32(fa.field);
                    if (idx < 0 || idx >= len(tv.elements)) {
                        return v_err("tuple index `" + fa.field + "` out of range");
                    }
                    return tv.elements[idx];
                },
                _ => { return v_err("can only field-access a struct or tuple"); }
            }
            return v_err("unreachable field-access arm");
        },
        parser.ExprUnknown(u) => { return v_err("parser-side unknown: " + u.kind); }
    }
    return v_err("unhandled Expr variant");
}

// call_func looks up `name` in the function table, binds args
// to params in a fresh env that shares the same funcs table, and
// evals the body. A missing function or arity mismatch surfaces
// as VErr. The callee runs with its own scope — caller bindings
// are NOT visible (no closures yet).
// call_method dispatches on the receiver's struct type_name.
// Searches funcs for a method-shaped FuncDecl whose name and
// receiver_type both match — VStruct receivers nominate
// receiver_type by exact name (so a method declared on
// `(c: Circle)` matches a VStruct whose type_name is "Circle").
// The receiver is bound to `receiver_name` first, then the
// remaining args follow in declaration order.
function call_method(recv: Value, name: string, args: Value[], funcs: parser.FuncDecl[]): Value {
    var recv_type: string = "";
    match (recv) {
        VStruct(sv) => { recv_type = sv.type_name; },
        _ => { return v_err("method dispatch: receiver not a struct value"); }
    }
    var i: i32 = 0;
    while (i < len(funcs)) {
        var fd: parser.FuncDecl = funcs[i];
        if (fd.name == name && len(fd.receiver_name) > 0 && fd.receiver_type == recv_type) {
            if (len(args) != len(fd.params)) {
                return v_err("arity mismatch calling method `" + name + "`");
            }
            var env: Env = new_env_with_funcs(funcs);
            env = env.bind(fd.receiver_name, recv);
            var j: i32 = 0;
            while (j < len(fd.params)) {
                env = env.bind(fd.params[j].name, args[j]);
                j = j + 1;
            }
            var step: StepResult = eval_block(fd.body, env);
            if (is_noreturn(step.ret)) {
                return v_err("method `" + name + "` reached end without `return`");
            }
            return step.ret;
        }
        i = i + 1;
    }
    return v_err("undefined method `" + name + "` on `" + recv_type + "`");
}

function call_func(name: string, args: Value[], funcs: parser.FuncDecl[]): Value {
    // Builtin: `len(a)` on an array → i32. Special-cased here
    // because the parser doesn't model builtins separately and
    // the interp has no Go-side host functions yet.
    if (name == "len") {
        if (len(args) != 1) { return v_err("len takes exactly 1 argument"); }
        match (args[0]) {
            VArr(a) => { return v_int(len(a.elements)); },
            VString(s) => { return v_int(len(s.v)); },
            _ => { return v_err("len: argument must be array or string"); }
        }
    }
    var i: i32 = 0;
    while (i < len(funcs)) {
        // Skip receiver methods — they're dispatched via
        // call_method only. A plain function call must match
        // a non-method (receiver_name empty) of the same name.
        if (funcs[i].name == name && len(funcs[i].receiver_name) == 0) {
            var fd: parser.FuncDecl = funcs[i];
            if (len(args) != len(fd.params)) {
                return v_err("arity mismatch calling `" + name + "`");
            }
            var env: Env = new_env_with_funcs(funcs);
            var j: i32 = 0;
            while (j < len(fd.params)) {
                env = env.bind(fd.params[j].name, args[j]);
                j = j + 1;
            }
            var step: StepResult = eval_block(fd.body, env);
            if (is_noreturn(step.ret)) {
                return v_err("function `" + name + "` reached end without `return`");
            }
            return step.ret;
        }
        i = i + 1;
    }
    return v_err("undefined function: " + name);
}

// value_eq: structural equality on Value. Two values of the
// same shape compare by payload; everything else is false.
// VErr never equals anything (including itself) — equality on
// error is itself an error in spirit, but we surface it as
// `false` so the caller branches consistently.
function value_eq(a: Value, b: Value): boolean {
    match (a) {
        VInt(ai) => {
            match (b) {
                VInt(bi) => { return ai.v == bi.v; },
                _ => { return false; }
            }
        },
        VBool(ab) => {
            match (b) {
                VBool(bb) => { return ab.v == bb.v; },
                _ => { return false; }
            }
        },
        VString(av) => {
            match (b) {
                VString(bs) => { return av.v == bs.v; },
                _ => { return false; }
            }
        },
        VFloat(af) => {
            match (b) {
                VFloat(bf) => { return af.v == bf.v; },
                _ => { return false; }
            }
        },
        VArr(_) => {
            // Array equality isn't well-defined for the
            // checker / interp's first cut. Surface as false so
            // `==` on arrays never short-circuits incorrectly;
            // the checker rules out `arr == arr` ahead of time
            // by requiring matching types in `==` (both sides
            // would resolve to TypeArray, which is rejected by
            // the equality op anyway).
            return false;
        },
        VStruct(_) => {
            // Struct equality not implemented yet — same
            // rationale as arrays.
            return false;
        },
        VTuple(_) => {
            // Tuple equality not implemented yet either; the
            // checker rules out direct tuple == tuple in the
            // first cut anyway.
            return false;
        },
        VErr(_) => { return false; }
    }
    return false;
}

// eval_stmt returns the (new env, optional return value). The
// returned env carries `var x = …;` bindings forward; the value
// is non-VErr only for StmtReturn — every other shape leaves it
// VErr("__noreturn__") which the driver loop reads as "keep
// going". Using VErr for the sentinel keeps everything in the
// same union type without growing it for a one-off Option.
pub struct StepResult { env: Env, ret: Value }

function eval_stmt(st: parser.Stmt, env: Env): StepResult {
    match (st) {
        parser.StmtVar(v) => {
            var val: Value = eval_expr(v.init, env);
            var env2: Env = env.bind(v.name, val);
            return StepResult { env: env2, ret: v_err("__noreturn__") };
        },
        parser.StmtReturn(r) => {
            var val: Value = eval_expr(r.value, env);
            return StepResult { env: env, ret: val };
        },
        parser.StmtExpr(x) => {
            var val: Value = eval_expr(x.value, env);
            // Drop the value — expression-statements have side
            // effects only (none in this scope; placeholder for
            // when we grow call statements).
            return StepResult { env: env, ret: v_err("__noreturn__") };
        },
        parser.StmtIf(ifs) => {
            var cv: Value = eval_expr(ifs.cond, env);
            if (is_err(cv)) { return StepResult { env: env, ret: cv }; }
            match (cv) {
                VBool(b) => {
                    var body: parser.Stmt[] = ifs.else_body;
                    if (b.v) { body = ifs.then_body; }
                    // Branch-local `var`s don't escape: trim the
                    // env back to the entry length. Assignments
                    // to outer-scoped names sit at index < base
                    // and survive the trim (update() rewrites
                    // slots in place).
                    var base: i32 = len(env.names);
                    var step: StepResult = eval_block(body, env);
                    return StepResult { env: trim_env(step.env, base), ret: step.ret };
                },
                _ => { return StepResult { env: env, ret: v_err("if cond not bool") }; }
            }
            return StepResult { env: env, ret: v_err("unreachable if-arm") };
        },
        parser.StmtWhile(w) => {
            // Loop until cond is false or the body returns.
            // Assignments inside the body need to outlive each
            // iteration — eval_block's "drop branch-local
            // bindings" stance is wrong here, so we step the body
            // ourselves and thread `cur` forward. `var` declared
            // inside the body still doesn't leak past the loop:
            // we snapshot the names-length at entry and trim back
            // on each iteration boundary, simulating block scope.
            //
            // Concretely: the names array grows only by `var`
            // inside the body; truncating to entry-length on each
            // iteration discards those bindings before the next
            // iteration starts, but keeps any updates to
            // outer-scoped names (those slots sit at index < base
            // and update() rewrites them in place). The trim also
            // applies on loop exit so the outer scope sees the
            // env it started with, plus assignment updates.
            var cur: Env = env;
            var base: i32 = len(env.names);
            while (true) {
                var cv: Value = eval_expr(w.cond, cur);
                if (is_err(cv)) { return StepResult { env: env, ret: cv }; }
                match (cv) {
                    VBool(b) => {
                        if (!b.v) { return StepResult { env: cur, ret: v_err("__noreturn__") }; }
                    },
                    _ => { return StepResult { env: env, ret: v_err("while cond not bool") }; }
                }
                var step: StepResult = eval_block(w.body, cur);
                if (!is_noreturn(step.ret)) {
                    // A return inside the loop short-circuits all
                    // remaining iterations.
                    return step;
                }
                cur = trim_env(step.env, base);
            }
            return StepResult { env: cur, ret: v_err("__noreturn__") };
        },
        parser.StmtAssign(a) => {
            var av: Value = eval_expr(a.value, env);
            if (is_err(av)) { return StepResult { env: env, ret: av }; }
            // update silently no-ops on undefined names; surface
            // the error explicitly so a mistake is observable in
            // tests.
            var i: i32 = len(env.names) - 1;
            var found: boolean = false;
            while (i >= 0 && !found) {
                if (env.names[i] == a.target) { found = true; }
                i = i - 1;
            }
            if (!found) {
                return StepResult { env: env, ret: v_err("assign to undefined `" + a.target + "`") };
            }
            return StepResult { env: env.update(a.target, av), ret: v_err("__noreturn__") };
        },
        parser.StmtMatch(m) => {
            // Evaluate the scrutinee. An error in the scrutinee
            // propagates without running any arm.
            var sv: Value = eval_expr(m.scrutinee, env);
            if (is_err(sv)) { return StepResult { env: env, ret: sv }; }
            // Walk arms top-to-bottom and run the first that
            // matches. Variant patterns require a VStruct
            // scrutinee whose type_name matches the pattern's
            // type_name; PatWildcard always matches.
            var i: i32 = 0;
            while (i < len(m.arms)) {
                var arm: parser.MatchArm = m.arms[i];
                var matched: boolean = false;
                var bind_name: string = "";
                match (arm.pattern) {
                    parser.PatWildcard(_) => { matched = true; },
                    parser.PatVariant(pv) => {
                        match (sv) {
                            VStruct(vs) => {
                                if (vs.type_name == pv.type_name) {
                                    matched = true;
                                    // Bare `Foo` and explicit
                                    // `Foo(_)` both leave binding
                                    // empty for the body env;
                                    // only a named binding ends
                                    // up in scope.
                                    if (len(pv.binding) > 0 && pv.binding != "_") {
                                        bind_name = pv.binding;
                                    }
                                }
                            },
                            _ => { }
                        }
                    }
                }
                if (matched) {
                    // Arm-local bindings die at the close of the
                    // arm body, same as branch-local `var`s in
                    // StmtIf. Trim env back to the entry length
                    // before returning so the surrounding scope
                    // doesn't see the binding (or any nested
                    // `var`s) leak out.
                    var base: i32 = len(env.names);
                    var bodyEnv: Env = env;
                    if (len(bind_name) > 0) { bodyEnv = bodyEnv.bind(bind_name, sv); }
                    var step: StepResult = eval_block(arm.body, bodyEnv);
                    return StepResult { env: trim_env(step.env, base), ret: step.ret };
                }
                i = i + 1;
            }
            return StepResult { env: env, ret: v_err("non-exhaustive match") };
        },
        parser.StmtBreak(_) => { return StepResult { env: env, ret: v_err("__break__") }; },
        parser.StmtContinue(_) => { return StepResult { env: env, ret: v_err("__continue__") }; },
        parser.StmtFor(f) => {
            // Evaluate the iter expression — must be a VArr.
            var iv: Value = eval_expr(f.iter, env);
            if (is_err(iv)) { return StepResult { env: env, ret: iv }; }
            var elems: Value[] = [];
            match (iv) {
                VArr(a) => { elems = a.elements; },
                _ => { return StepResult { env: env, ret: v_err("for-in iter not an array") }; }
            }
            // Each iteration binds f.var_name to the current
            // element, walks the body, then trims back to the
            // pre-loop env length. An in-body return short-
            // circuits the rest of the iterations.
            var base: i32 = len(env.names);
            var cur: Env = env;
            var i: i32 = 0;
            while (i < len(elems)) {
                var iter_env: Env = cur.bind(f.var_name, elems[i]);
                var step: StepResult = eval_block(f.body, iter_env);
                if (!is_noreturn(step.ret)) { return step; }
                cur = trim_env(step.env, base);
                i = i + 1;
            }
            return StepResult { env: cur, ret: v_err("__noreturn__") };
        },
        parser.StmtUnknown(u) => { return StepResult { env: env, ret: v_err("parser-side unknown stmt: " + u.kind) }; }
    }
    return StepResult { env: env, ret: v_err("unhandled Stmt variant") };
}

// trim_env drops bindings past index `base`. Used by the while
// loop to discard body-local `var`s between iterations while
// preserving any update()s to outer-scoped names (those sit at
// index < base and aren't touched).
function trim_env(e: Env, base: i32): Env {
    if (len(e.names) <= base) { return e; }
    var ns: string[] = [];
    var vs: Value[] = [];
    var i: i32 = 0;
    while (i < base) {
        ns = ns.push(e.names[i]);
        vs = vs.push(e.values[i]);
        i = i + 1;
    }
    return Env { names: ns, values: vs, funcs: e.funcs };
}

// eval_block walks a body, threading env forward through every
// stmt. Returns the threaded env so the caller can decide how
// much of it to keep — the StmtIf path trims back to the entry
// length (branch-local `var`s die), while StmtWhile uses the
// same trim per iteration but keeps it. Both rely on the fact
// that update() rewrites slots in place, so reassignments to
// outer-scoped names sit at index < base and survive the trim.
// First non-__noreturn ret short-circuits the walk.
function eval_block(body: parser.Stmt[], env: Env): StepResult {
    var cur: Env = env;
    var i: i32 = 0;
    while (i < len(body)) {
        var r: StepResult = eval_stmt(body[i], cur);
        cur = r.env;
        if (!is_noreturn(r.ret)) {
            return StepResult { env: cur, ret: r.ret };
        }
        i = i + 1;
    }
    return StepResult { env: cur, ret: v_err("__noreturn__") };
}

function is_noreturn(v: Value): boolean {
    match (v) {
        VErr(e) => { return e.msg == "__noreturn__"; },
        _ => { return false; }
    }
    return false;
}

// eval_program drives the stmt list. Stops at the first return
// (or end of stmts). Returns the return-value or VErr if no
// explicit return was seen.
function eval_program(prog: parser.Stmt[]): Value {
    var env: Env = new_env();
    var i: i32 = 0;
    while (i < len(prog)) {
        var r: StepResult = eval_stmt(prog[i], env);
        env = r.env;
        if (!is_noreturn(r.ret)) { return r.ret; }
        i = i + 1;
    }
    return v_err("program reached end without `return`");
}

// eval_module is the main entry for sources that declare
// functions. If `main` exists, call it with no args. Otherwise
// fall back to running the top-level stmts in a fresh env that
// still has access to the function table.
pub function eval_module(mod: parser.Module): Value {
    var i: i32 = 0;
    while (i < len(mod.funcs)) {
        if (mod.funcs[i].name == "main") {
            var empty_args: Value[] = [];
            return call_func("main", empty_args, mod.funcs);
        }
        i = i + 1;
    }
    var env: Env = new_env_with_funcs(mod.funcs);
    var j: i32 = 0;
    while (j < len(mod.top_stmts)) {
        var r: StepResult = eval_stmt(mod.top_stmts[j], env);
        env = r.env;
        if (!is_noreturn(r.ret)) { return r.ret; }
        j = j + 1;
    }
    return v_err("module has no `main` and no top-level `return`");
}

// =================== VALIDATION ====================

function run_source(src: string): Value {
    var toks: lexer.Token[] = lexer.tokenize(src);
    var stmts: parser.Stmt[] = parser.parse_program(toks);
    return eval_program(stmts);
}

function run_module(src: string): Value {
    var toks: lexer.Token[] = lexer.tokenize(src);
    var mod: parser.Module = parser.parse_module(toks);
    return eval_module(mod);
}

function main(): i32 {
    // Arithmetic + ident lookup. var x = 7; var y = 9; return x + y.
    var r1: Value = run_source("var x = 1 + 2 * 3; var y = (1 + 2) * 3; return x + y;");
    match (r1) {
        VInt(i) => { if (i.v != 16) { return 10; } },
        _ => { return 11; }
    }

    // String concat.
    var r2: Value = run_source("var a = \"hi \" + \"there\"; return 0 - 1;");
    match (r2) {
        VInt(i) => { if (i.v != 0 - 1) { return 20; } },
        _ => { return 21; }
    }

    // Logical + equality. var b = 5 < 10; return b && (1 == 1).
    // Can't `return bool` directly — surface as i32 via a
    // separate var + a ternary-shaped return.
    var r3: Value = run_source("var b = 5 < 10; var c = b && (1 == 1); return 42;");
    match (r3) {
        VInt(i) => { if (i.v != 42) { return 30; } },
        _ => { return 31; }
    }

    // Unary minus.
    var r4: Value = run_source("var n = 0 - 5; return n;");
    match (r4) {
        VInt(i) => { if (i.v != 0 - 5) { return 40; } },
        _ => { return 41; }
    }

    // Division.
    var r5: Value = run_source("return 20 / 4;");
    match (r5) {
        VInt(i) => { if (i.v != 5) { return 50; } },
        _ => { return 51; }
    }

    // Division by zero → VErr.
    var r6: Value = run_source("return 1 / 0;");
    match (r6) {
        VErr(_) => { },
        _ => { return 60; }
    }

    // Undefined identifier → VErr.
    var r7: Value = run_source("return missing;");
    match (r7) {
        VErr(_) => { },
        _ => { return 70; }
    }

    // If/else, then-branch taken: `var x = 5; if (x < 10) { return 1; } else { return 2; }`
    var r8: Value = run_source("var x = 5; if (x < 10) { return 1; } else { return 2; }");
    match (r8) {
        VInt(i) => { if (i.v != 1) { return 80; } },
        _ => { return 81; }
    }

    // Else-branch taken.
    var r9: Value = run_source("var x = 20; if (x < 10) { return 1; } else { return 2; }");
    match (r9) {
        VInt(i) => { if (i.v != 2) { return 90; } },
        _ => { return 91; }
    }

    // No else, condition false: control falls past the if to the
    // trailing return.
    var r10: Value = run_source("if (false) { return 7; } return 11;");
    match (r10) {
        VInt(i) => { if (i.v != 11) { return 100; } },
        _ => { return 101; }
    }

    // Chained else-if: branches through the second arm.
    var r11: Value = run_source("var k = 2; if (k == 1) { return 10; } else if (k == 2) { return 20; } else { return 30; }");
    match (r11) {
        VInt(i) => { if (i.v != 20) { return 110; } },
        _ => { return 111; }
    }

    // Plain assignment: declared, reassigned, returned.
    var r12: Value = run_source("var n = 1; n = 7; return n;");
    match (r12) {
        VInt(i) => { if (i.v != 7) { return 120; } },
        _ => { return 121; }
    }

    // While loop, counter. Sum of 1..=5 == 15.
    var r13: Value = run_source(
        "var i = 1; var s = 0; while (i <= 5) { s = s + i; i = i + 1; } return s;"
    );
    match (r13) {
        VInt(i) => { if (i.v != 15) { return 130; } },
        _ => { return 131; }
    }

    // Early `return` inside while short-circuits the loop.
    var r14: Value = run_source(
        "var i = 0; while (i < 10) { if (i == 3) { return i; } i = i + 1; } return 0 - 1;"
    );
    match (r14) {
        VInt(i) => { if (i.v != 3) { return 140; } },
        _ => { return 141; }
    }

    // While with always-false cond: body never runs.
    var r15: Value = run_source("var x = 5; while (false) { x = 99; } return x;");
    match (r15) {
        VInt(i) => { if (i.v != 5) { return 150; } },
        _ => { return 151; }
    }

    // Function decl + call: `add(2, 3)` via `main` → 5.
    var r16: Value = run_module(
        "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(2, 3); }"
    );
    match (r16) {
        VInt(i) => { if (i.v != 5) { return 160; } },
        _ => { return 161; }
    }

    // Recursive factorial: fact(5) = 120.
    var r17: Value = run_module(
        "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); } function main(): i32 { return fact(5); }"
    );
    match (r17) {
        VInt(i) => { if (i.v != 120) { return 170; } },
        _ => { return 171; }
    }

    // Mutual recursion: is_even(4) → true (encoded as 1).
    var r18: Value = run_module(
        "function is_even(n: i32): i32 { if (n == 0) { return 1; } return is_odd(n - 1); }"
        + " function is_odd(n: i32): i32 { if (n == 0) { return 0; } return is_even(n - 1); }"
        + " function main(): i32 { return is_even(4); }"
    );
    match (r18) {
        VInt(i) => { if (i.v != 1) { return 180; } },
        _ => { return 181; }
    }

    // Undefined function call → VErr.
    var r19: Value = run_module(
        "function main(): i32 { return missing(1); }"
    );
    match (r19) {
        VErr(_) => { },
        _ => { return 190; }
    }

    // Arity mismatch → VErr.
    var r20: Value = run_module(
        "function add(x: i32, y: i32): i32 { return x + y; } function main(): i32 { return add(1); }"
    );
    match (r20) {
        VErr(_) => { },
        _ => { return 200; }
    }

    // Array literal + indexing: `a[0] == 10`, `a[2] == 30`.
    var r21: Value = run_source(
        "var a = [10, 20, 30]; return a[2];"
    );
    match (r21) {
        VInt(i) => { if (i.v != 30) { return 210; } },
        _ => { return 211; }
    }

    // len() builtin on array.
    var r22: Value = run_source("var a = [1, 2, 3, 4]; return len(a);");
    match (r22) {
        VInt(i) => { if (i.v != 4) { return 220; } },
        _ => { return 221; }
    }

    // Sum-an-array via while loop. Sum of [3, 5, 7, 9] = 24.
    var r23: Value = run_source(
        "var a = [3, 5, 7, 9]; var i = 0; var s = 0; while (i < len(a)) { s = s + a[i]; i = i + 1; } return s;"
    );
    match (r23) {
        VInt(i) => { if (i.v != 24) { return 230; } },
        _ => { return 231; }
    }

    // Out-of-range index → VErr.
    var r24: Value = run_source("var a = [1, 2]; return a[5];");
    match (r24) {
        VErr(_) => { },
        _ => { return 240; }
    }

    // Empty array literal: len → 0.
    var r25: Value = run_source("var a = []; return len(a);");
    match (r25) {
        VInt(i) => { if (i.v != 0) { return 250; } },
        _ => { return 251; }
    }

    // String indexing returns the byte at position as i32.
    // ASCII 'h' is 104.
    var r26: Value = run_source("var s = \"hello\"; return s[0];");
    match (r26) {
        VInt(i) => { if (i.v != 104) { return 260; } },
        _ => { return 261; }
    }

    // String indexing + arithmetic: "ABC" → 'A' + 'B' + 'C' = 65 + 66 + 67 = 198.
    var r27: Value = run_source("var s = \"ABC\"; return s[0] + s[1] + s[2];");
    match (r27) {
        VInt(i) => { if (i.v != 198) { return 270; } },
        _ => { return 271; }
    }

    // Out-of-range string index → VErr.
    var r28: Value = run_source("var s = \"hi\"; return s[5];");
    match (r28) {
        VErr(_) => { },
        _ => { return 280; }
    }

    // String slicing: `"hello"[1:4]` → "ell". We can't directly
    // return a string as exit code, so cross-check via len.
    var r29: Value = run_source("var s = \"hello\"; var t = s[1:4]; return len(t);");
    match (r29) {
        VInt(i) => { if (i.v != 3) { return 290; } },
        _ => { return 291; }
    }

    // Slice + indexing: `"hello"[1:4][1]` → 'l' = 108.
    var r30: Value = run_source("var s = \"hello\"; return s[1:4][1];");
    match (r30) {
        VInt(i) => { if (i.v != 108) { return 300; } },
        _ => { return 301; }
    }

    // Array slicing: `[10,20,30,40,50][1:4]` → length 3, first
    // element 20.
    var r31: Value = run_source("var a = [10, 20, 30, 40, 50]; var b = a[1:4]; return b[0];");
    match (r31) {
        VInt(i) => { if (i.v != 20) { return 310; } },
        _ => { return 311; }
    }

    // Out-of-range slice → VErr. (Surface the VErr through
    // len() so it reaches the program's return rather than
    // getting silently stored in a var.)
    var r32: Value = run_source("var s = \"hi\"; return len(s[0:99]);");
    match (r32) {
        VErr(_) => { },
        _ => { return 320; }
    }

    // Compound assignment lowers to plain assign at parse time —
    // `x += 1` is `x = x + 1` by the time the interp sees it.
    // Sum 1..=10 via `+=` in the body: 55.
    var r33: Value = run_source(
        "var i = 1; var s = 0; while (i <= 10) { s += i; i += 1; } return s;"
    );
    match (r33) {
        VInt(i) => { if (i.v != 55) { return 330; } },
        _ => { return 331; }
    }

    // `*=` desugar: `x *= 2; x *= 3; return x;` → 6 from start 1.
    var r34: Value = run_source("var x = 1; x *= 2; x *= 3; return x;");
    match (r34) {
        VInt(i) => { if (i.v != 6) { return 340; } },
        _ => { return 341; }
    }

    // Struct literal + field access: `Point { x: 3, y: 4 }.x` → 3.
    var r35: Value = run_source("return Point { x: 3, y: 4 }.x;");
    match (r35) {
        VInt(i) => { if (i.v != 3) { return 350; } },
        _ => { return 351; }
    }

    // Struct value bound to a var then field-accessed via the
    // ident → recovers the original field.
    var r36: Value = run_source(
        "var p = Point { x: 7, y: 11 }; return p.x + p.y;"
    );
    match (r36) {
        VInt(i) => { if (i.v != 18) { return 360; } },
        _ => { return 361; }
    }

    // Nested struct: `Box { inner: Point { x: 5, y: 0 } }.inner.x`
    // exercises field access on a struct-valued field.
    var r37: Value = run_source(
        "var b = Box { inner: Point { x: 5, y: 0 } }; return b.inner.x;"
    );
    match (r37) {
        VInt(i) => { if (i.v != 5) { return 370; } },
        _ => { return 371; }
    }

    // Missing field → VErr.
    var r38: Value = run_source("return Point { x: 1, y: 2 }.z;");
    match (r38) {
        VErr(_) => { },
        _ => { return 380; }
    }

    // StmtMatch — variant pattern binds the scrutinee and the
    // body reads a field off it.
