    if (kconsume) { w = w + 2; }
    if (owncols) { w = w + 4; }
    var vw: i64 = 0;
    if (widekind == 1) { vw = 1; }
    if (widekind == 2) { vw = 2; }
    return Op { kind_tag: 125, i32_imm: keykind, i64_imm: vw, f64_imm: 0.0, width: w, unsigned: valptr, str: eqfn };
}
