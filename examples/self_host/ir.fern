// examples/self_host/ir.fern — the stack-machine IR for the self-hosted
// compiler, mirroring native's internal/ir (`ir.Op` / `[]Op`). This is the
// layer the native PRODUCTION backends (arm64 / x86-64 / wasmbin) consume,
// and the layer where Perceus reference counting lives (alias-inc, the
// exit dec sweep, drop specialization, reuse tokens are all emitted here as
// `call_direct` to `__fern_rc_*` helpers during AST -> IR lowering).
//
// The self-host previously had NO equivalent of this layer — it lowered
// AST -> asm directly in each backend, so every RC emission had to be
// hand-written three times. This module is slice 0 of the IR rebuild
// (docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md): once the backends emit from
// `Op[]` instead of the AST, RC is lowered to IR ONCE and each backend just
// instruction-selects an opcode. (The existing ssa.fern mirrors the
// DOWNSTREAM optimiser `internal/ssa`, which native lifts FROM this IR; it
// is a different, higher layer.)
//
// Representation (mirrors internal/ir/ir.go, but pointer-free — the
// self-host's value-semantics style, matching ssa.fern: a function body is
// an `Op[]` flat stack-machine stream; structured control flow is the
// block/loop/if/end/br/brif scope discipline, exactly as native and wasm).
// Kinds are string-tagged (like ssa.fern's SInst) rather than an int enum:
// printable, diff-friendly, and the native `OpKind` names map 1:1 to these
// tags ("const_i32", "add", "call_direct", ...).
//
import "./util";

// SCOPE (slice 0): the `Op` value + its constructor helpers for a
// representative spine of opcodes — constants, local load/store, integer
// arithmetic / comparison, memory load/store, alloc, the call forms,
// structured control flow, drop, and return. AST -> IR lowering
// (mirroring the native `builder`), the AST-referencing fields
// (Sig / ArgTypes / Pos), and the backend IR consumers land in later
// slices. Nothing imports this yet, so it is additive and bootstrap-inert.

// ---- Op ----------------------------------------------------------------

// Op is one stack-machine instruction. Field meanings mirror native's
// `ir.Op` (internal/ir/ir.go:515):
//   kind     — the opcode tag (see the constructors below).
//   i32      — the immediate for "const_i32"; the local index for
//              load_local / store_local / tee_local; the block-type for
//              block / loop / if; the relative depth for br / brif; the
//              arg count for call_direct / call_indirect / call_closure;
//              the table index for const_func.
//   i64      — the immediate for "const_i64".
//   f64      — the immediate for "const_f64" (f32 reuses this until the
//              self-host grows a distinct f32 slot).
//   width    — operand bit-width for ops that exist in multiple widths
//              (add/sub/.../eq/.../load/store). 0 means 32; 64 selects i64;
//              -1 is WidthPtr, the backend-resolved pointer width (4 on
//              wasm32, 8 on arm64) — the same sentinel native uses so
//              arm64's >4 GiB heap pointers round-trip.
//   unsigned — selects the `_u` variant of div / rem / shr / comparisons.
//   str      — "const_str"'s value and "call_direct"'s callee name.
pub struct Op {
    kind: string,
    i32_imm: i32,
    i64_imm: i64,
    f64_imm: f64,
    width: i32,
    unsigned: boolean,
    str: string,
}

// WidthPtr is the backend-resolved pointer-width sentinel (native's
// ir.WidthPtr). Stored in Op.width for load / store of heap-pointer-typed
// values; each backend resolves it (wasm32 -> 4, arm64 -> 8).
pub function width_ptr(): i32 { return 0 - 1; }

// ---- constructors ------------------------------------------------------
//
// One helper per opcode, mirroring the names native gives its OpKind
// constants. Every field the opcode does not use is zeroed, so an Op is
// always fully initialised (the value-semantics discipline ssa.fern uses).

function op0(kind: string): Op {
    return Op { kind: kind, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

// constants
pub function op_const_i32(v: i32): Op {
    return Op { kind: "const_i32", i32_imm: v, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_const_i64(v: i64): Op {
    return Op { kind: "const_i64", i32_imm: 0, i64_imm: v, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
// int_extend widens an i32 to i64 (`as i64` / `as u64`); int_wrap narrows an
// i64 to i32 (`as i32` / `as u32`). `unsigned` picks zero- vs sign-extension on
// the register backends (wasm uses i64.extend_i32_s/u and i32.wrap_i64).
pub function op_int_extend(unsigned: boolean): Op { return Op { kind: "int_extend", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: unsigned, str: "" }; }
pub function op_int_wrap(unsigned: boolean): Op { return Op { kind: "int_wrap", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: unsigned, str: "" }; }
// op_const_i64_text carries the literal's SOURCE TEXT (in `str`) rather than a
// parsed i64, so the backends can splice it straight into a 64-bit immediate
// (`movabsq $TEXT` / `ldr x0, =TEXT` / `i64.const TEXT`) without an i64
// parse+format round-trip. width=64 marks it an i64 value.
pub function op_const_i64_text(t: string): Op {
    return Op { kind: "const_i64", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: false, str: t };
}
pub function op_const_f64(v: f64): Op {
    return Op { kind: "const_f64", i32_imm: 0, i64_imm: 0, f64_imm: v, width: 0, unsigned: false, str: "" };
}
pub function op_const_str(s: string): Op {
    return Op { kind: "const_str", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: s };
}
pub function op_const_func(table_idx: i32): Op {
    return Op { kind: "const_func", i32_imm: table_idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

// locals
pub function op_load_local(idx: i32): Op {
    return Op { kind: "load_local", i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_store_local(idx: i32): Op {
    return Op { kind: "store_local", i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_tee_local(idx: i32): Op {
    return Op { kind: "tee_local", i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

// integer arithmetic / comparison (width selects i32 vs i64)
pub function op_bin(kind: string, width: i32, unsigned: boolean): Op {
    return Op { kind: kind, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: unsigned, str: "" };
}

// f64 arithmetic / comparison. `kind` is the float opcode ("fadd"/"fsub"/
// "fmul"/"fdiv" or a float compare "flt"/"fgt"/"fle"/"fge"/"feq"/"fne"); the
// operands flow on the rt-stack as their 8-byte IEEE bit pattern (like i64), so
// only the op differs from the integer path — the backend pops into float
// registers (xmm / d-regs / wasm f64). Arithmetic yields an f64; a compare
// yields an i32 0/1.
pub function op_fbin(kind: string): Op {
    return Op { kind: kind, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: false, str: "" };
}

// f64 <-> i32 conversions. i32_to_f64 widens a signed i32 to f64 (cvtsi2sd /
// scvtf / f64.convert_i32_s); f64_to_i32 truncates an f64 toward zero to a
// signed i32 (cvttsd2si / fcvtzs / i32.trunc_f64_s). The value rides the stack
// as bits on the register backends; wasm's typed stack flips i32<->f64 here.
pub function op_i32_to_f64(): Op { return op0("i32_to_f64"); }
pub function op_f64_to_i32(): Op { return op0("f64_to_i32"); }

// op_const_f64_text carries the float literal's SOURCE TEXT (in `str`) so the
// backends can hand it straight to the assembler (`.double TEXT` in .rodata /
// `f64.const TEXT`) without a float parse+format round-trip — mirroring
// op_const_i64_text. width=64 marks it a 64-bit (float) value.
pub function op_const_f64_text(t: string): Op {
    return Op { kind: "const_f64", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: false, str: t };
}

// memory: width carries 8/16/32/64 or width_ptr() for pointer-typed slots
pub function op_load(width: i32): Op {
    return Op { kind: "load", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}
pub function op_store(width: i32): Op {
    return Op { kind: "store", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}
pub function op_alloc(): Op { return op0("alloc"); }

// high-level array ops — layout-agnostic. The IR carries array SEMANTICS
// (make / index / index-store / length / refcount read), not a byte layout;
// each backend instruction-selects them into its OWN array memory layout
// (the standalone ir_x86 backend's 4-byte freestanding header, asm.fern's
// 8-byte `__fern_arr_box` rc/cap/len header, …). This is what lets the
// production IR path emit asm.fern-compatible arrays without irlower baking
// a single layout into the op stream (the target-agnostic-IR discipline:
// layout lives in the backend, not the IR). `arr_make`'s i32_imm is the
// element count; it pops that many i32 values (element 0 deepest) and pushes
// the new array's data pointer. `arr_get` pops [base, idx] → element;
// `arr_set` pops [base, idx, val]; `arr_len` / `arr_rc` pop [base] → len / rc.
// `arr_make`'s `width` is the element slot width: 32 for i32 / wasm32-pointer
// elements (4-byte wasm stride) or 64 for f64 elements (8-byte wasm stride,
// f64.load/store). The register backends already use 8-byte slots regardless,
// so width only steers the wasm backend; `arr_get` / `arr_set` carry the same
// element width so they select the matching load/store on wasm.
pub function op_arr_make(n: i32, width: i32): Op {
    return Op { kind: "arr_make", i32_imm: n, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}
pub function op_arr_get(width: i32): Op { return Op { kind: "arr_get", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" }; }
pub function op_arr_set(width: i32): Op { return Op { kind: "arr_set", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" }; }
pub function op_arr_len(): Op { return op0("arr_len"); }
pub function op_arr_rc(): Op { return op0("arr_rc"); }

// high-level string ops — layout-agnostic, like the array ops. The IR carries
// string SEMANTICS (length read, concat, equality); each backend selects its
// own string box layout (asm.fern's 16-byte `[data@0, len@8]` heap box, wasm's
// `[len@0, bytes@4]` data-section block). `const_str` (see op_const_str) pushes
// a string value; `str_len` pops [str] → length; `str_concat` pops [a, b] → the
// concatenated string (a fresh box); `str_eq` pops [a, b] → 1 if byte-equal
// else 0. Strings are NOT reference-counted (they leak, matching asm.fern's AST
// path — fine for short-lived CLI / edge programs), so no RC ops accompany them.
pub function op_str_len(): Op { return op0("str_len"); }
pub function op_str_concat(): Op { return op0("str_concat"); }
pub function op_str_eq(): Op { return op0("str_eq"); }
// `str_cmp` pops [a, b] → a signed i32: <0 if a<b, 0 if equal, >0 if a>b
// (lexicographic byte compare, length tiebreak). Ordering compares (< <= > >=)
// lower to str_cmp followed by the relational op against 0.
pub function op_str_cmp(): Op { return op0("str_cmp"); }
// `str_index` pops [str, i] → the i32 byte value at index i (`s[i]`). Each
// backend reads the byte from its own string layout (x86/arm64 16-byte box
// [data@0,len@8] → byte at [data+i]; wasm data-section [len@0,bytes@4] → byte at
// [s+4+i]). No bounds check (matches the AST path).
pub function op_str_index(): Op { return op0("str_index"); }
// `str_slice` pops [str, start, end] → a fresh string for `s[start:end]`. On
// x86/arm64 this is a zero-copy VIEW: a new 16-byte box [data = src.data+start,
// len = end-start] sharing the source bytes. On wasm, strings are inline blocks
// (no separate data pointer), so it COPIES via $__fern_substr. No bounds check.
pub function op_str_slice(): Op { return op0("str_slice"); }
// `arr_slice` pops [arr, start, end] → a fresh array holding arr[start:end]
// (end exclusive), COPYING the 8-byte (x86/arm64) / 4-byte (wasm) element
// payloads via __fern_arr_slice. No bounds check (matches the AST path).
// `arr_slice`'s `width` is the element width (32 for i32 / wasm32-pointer
// elements, 64 for f64): the wasm backend selects the 4-byte or 8-byte copy
// helper. The register backends copy 8-byte slots regardless and ignore it.
pub function op_arr_slice(width: i32): Op { return Op { kind: "arr_slice", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" }; }

// Built-in Option / Result ops. The value is a heap box [tag@0, payload@8]
// (Some/Ok = tag 0, None/Err = tag 1) — distinct from user enums/structs, which
// carry a shape pointer at offset 0. `opt_make` pops [payload] and builds the
// box with `i32_imm` as the tag (Some/Ok=0, Err=1); `opt_none` builds a
// payloadless box with tag 1; `opt_tag` pops [box] → the i32 tag at offset 0
// (drives Some/None/Ok/Err discrimination in match).
pub function op_opt_make(tag: i32): Op { return Op { kind: "opt_make", i32_imm: tag, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" }; }
pub function op_opt_none(): Op { return op0("opt_none"); }
pub function op_opt_tag(): Op { return op0("opt_tag"); }
// `opt_payload` pops [box] → the payload at offset 8 (x86/arm64) / 4 (wasm);
// used to bind a Some/Ok/Err pattern's payload.
pub function op_opt_payload(): Op { return op0("opt_payload"); }
pub function op_map_new(keykind: i32): Op { return Op { kind: "map_new", i32_imm: keykind, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" }; }
pub function op_map_set(keykind: i32): Op { return Op { kind: "map_set", i32_imm: keykind, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" }; }
pub function op_map_len(): Op { return op0("map_len"); }
// `map_get` pops [map, key] → an Option box [tag@0, payload@8] (Some(value) on a
// hit, None on a miss) — the SAME layout as opt_make, so it plugs into the
// built-in Option match. `map_has` pops [map, key] → i32 0/1. Both carry the key
// kind in i32_imm.
pub function op_map_get(keykind: i32): Op { return Op { kind: "map_get", i32_imm: keykind, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" }; }
pub function op_map_has(keykind: i32): Op { return Op { kind: "map_has", i32_imm: keykind, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" }; }
// `map_get_or` pops [map, key, default] → the value at key, or default on a miss.
pub function op_map_get_or(keykind: i32): Op { return Op { kind: "map_get_or", i32_imm: keykind, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" }; }
// `map_keys` / `map_values` pop [map] → the array of live keys / values. On the
// parallel-array backends (x86-64 / arm64) this is the map's internal keys[] /
// values[] pointer (box @0 / @8); on wasm it snapshots the hash map into a fresh
// array. Order is backend-defined, so consumers must be order-independent.
pub function op_map_keys(): Op { return op0("map_keys"); }
pub function op_map_values(): Op { return op0("map_values"); }

// high-level struct ops — layout-agnostic, like the array/string ops. `str`
// carries the struct's type name, `i32_imm` the field count (struct_make) or
// the field index in DECL order (struct_get). `struct_make` pops `i32_imm`
// field values (field 0 deepest, already reordered by irlower into decl order)
// and pushes the new struct box; each backend selects its own layout
// (x86/arm64: `[shape_ptr, f0, f1, …]` 8-byte slots, field i at (i+1)*8; wasm:
// `[type_id, f0@4, f1@8, …]` 4-byte slots + an rc header). `struct_get` pops
// [struct] and pushes field `i32_imm`. This first slice covers scalar-field
// (i32/boolean) structs only and is leak-only (no RC / drop) — exit-code-
// equivalent to every backend's AST path since the value is read before any
// free; rc-tracked fields + drop specialization are later slices.
pub function op_struct_make(type_name: string, nfields: i32): Op {
    return Op { kind: "struct_make", i32_imm: nfields, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: type_name };
}
// width selects the field's load/store size on width-typed backends (wasm): 64
// for an f64 field, 0 (i32-shaped) otherwise. The register backends use 8-byte
// slots for every field and ignore it.
pub function op_struct_get(field_index: i32, width: i32): Op {
    return Op { kind: "struct_get", i32_imm: field_index, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}

// struct_set pops [struct, value] and stores value into field `field_index`
// (the in-place `p.x = v` mutation). Scalar fields only (leak-only structs);
// the box is shared by reference, so aliases observe the write — matching the
// AST path. Layout-agnostic: each backend writes at its own field offset.
pub function op_struct_set(field_index: i32, width: i32): Op {
    return Op { kind: "struct_set", i32_imm: field_index, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}

// high-level tuple ops — layout-agnostic, like the struct ops, but a tuple box
// has NO shape/type-id slot (field access is the numeric `.0` / `.1` spelling,
// resolved at the access site): element i sits at the box's slot i. `tuple_make`
// pops `i32_imm` element values (element 0 deepest) and pushes the new box;
// `tuple_get` pops [tuple] and pushes element `i32_imm`. Scalar elements only
// (leak-only), so no RC.
pub function op_tuple_make(n: i32): Op {
    return Op { kind: "tuple_make", i32_imm: n, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_tuple_get(idx: i32): Op {
    return Op { kind: "tuple_get", i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

// variant_is pops an enum-variant box and pushes 1 if it is the variant named
// `str`, else 0 — the discriminant test that drives `match` arm dispatch. A
// variant box is built by struct_make (the variant struct's name is its shape /
// type id, its payload is field 0), so the test reads the box's slot-0 tag and
// compares it to the named variant's identity: the interned shape-name pointer
// on x86/arm64, the struct type id on wasm. Layout-agnostic, like the other
// high-level ops — each backend resolves the identity for its own layout.
pub function op_variant_is(name: string): Op {
    return Op { kind: "variant_is", i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: name };
}

// calls — i32_imm is the arg count; str is the callee for call_direct
pub function op_call_direct(callee: string, argc: i32): Op {
    return Op { kind: "call_direct", i32_imm: argc, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: callee };
}
pub function op_call_indirect(argc: i32): Op {
    return Op { kind: "call_indirect", i32_imm: argc, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_call_closure(argc: i32): Op {
    return Op { kind: "call_closure_direct", i32_imm: argc, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

// structured control flow — i32_imm is the block-type (block/loop/if) or
// the relative branch depth (br/brif), mirroring native exactly.
pub function op_block(blocktype: i32): Op {
    return Op { kind: "block", i32_imm: blocktype, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_loop(blocktype: i32): Op {
    return Op { kind: "loop", i32_imm: blocktype, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_if(blocktype: i32): Op {
    return Op { kind: "if", i32_imm: blocktype, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_else(): Op { return op0("else"); }
pub function op_end(): Op { return op0("end"); }
pub function op_br(depth: i32): Op {
    return Op { kind: "br", i32_imm: depth, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_brif(depth: i32): Op {
    return Op { kind: "brif", i32_imm: depth, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

pub function op_drop(): Op { return op0("drop"); }
pub function op_return(): Op { return op0("return"); }

// ---- printing ----------------------------------------------------------
//
// render_op gives a stable one-line textual form (the basis for a future
// IR golden / disassembly test, mirroring ssa.fern's printer). Only the
// fields an opcode uses are shown.
pub function render_op(o: Op): string {
    if (o.kind == "const_i32") { return "const_i32 " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "const_i64") { return "const_i64 " + o.str; }
    if (o.kind == "int_extend") { return "int_extend"; }
    if (o.kind == "int_wrap") { return "int_wrap"; }
    if (o.kind == "const_str") { return "const_str " + o.str; }
    if (o.kind == "load_local") { return "load_local " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "store_local") { return "store_local " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "tee_local") { return "tee_local " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "call_direct") { return "call_direct " + o.str + "/" + util.i32_to_string(o.i32_imm); }
    if (o.kind == "br") { return "br " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "brif") { return "brif " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "load") { return "load w" + util.i32_to_string(o.width); }
    if (o.kind == "store") { return "store w" + util.i32_to_string(o.width); }
    if (o.kind == "arr_make") { return "arr_make " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "str_len") { return "str_len"; }
    if (o.kind == "str_concat") { return "str_concat"; }
    if (o.kind == "str_eq") { return "str_eq"; }
    if (o.kind == "str_cmp") { return "str_cmp"; }
    if (o.kind == "str_index") { return "str_index"; }
    if (o.kind == "str_slice") { return "str_slice"; }
    if (o.kind == "arr_slice") { return "arr_slice"; }
    if (o.kind == "opt_make") { return "opt_make " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "opt_none") { return "opt_none"; }
    if (o.kind == "opt_tag") { return "opt_tag"; }
    if (o.kind == "opt_payload") { return "opt_payload"; }
    if (o.kind == "map_new") { return "map_new " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "map_set") { return "map_set " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "map_len") { return "map_len"; }
    if (o.kind == "map_get") { return "map_get " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "map_has") { return "map_has " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "map_get_or") { return "map_get_or " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "map_keys") { return "map_keys"; }
    if (o.kind == "map_values") { return "map_values"; }
    if (o.kind == "struct_make") { return "struct_make " + o.str + "/" + util.i32_to_string(o.i32_imm); }
    if (o.kind == "struct_get") { return "struct_get " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "struct_set") { return "struct_set " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "variant_is") { return "variant_is " + o.str; }
    if (o.kind == "tuple_make") { return "tuple_make " + util.i32_to_string(o.i32_imm); }
    if (o.kind == "tuple_get") { return "tuple_get " + util.i32_to_string(o.i32_imm); }
    return o.kind;
}
