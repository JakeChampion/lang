// the 8-byte element via $__fern_mapiter_value_w64 (i64 result). f64 never reaches
// it (its map_iter defers). The register backends ignore it. #5253.
pub function op_mapiter_value(valwide: boolean): Op {
    var vw: i64 = 0;
    if (valwide) { vw = 1; }
    return Op { kind_tag: 136, i32_imm: 0, i64_imm: vw, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_mapiter_advance(): Op { return op0("mapiter_advance"); }

// high-level struct ops — layout-agnostic, like the array/string ops. `str`
// carries the struct's type name, `i32_imm` the field count (struct_make) or
// the field index in DECL order (struct_get). `struct_make` pops `i32_imm`
// field values (field 0 deepest, already reordered by irlower into decl order)
// and pushes the new struct box; each backend selects its own layout
// (x86/arm64: `[shape_ptr, f0, f1, …]` 8-byte slots, field i at (i+1)*8; wasm:
// `[type_id, f0@4, f1@8, …]` 4-byte slots + an rc header). `struct_get` pops
// [struct] and pushes field `i32_imm`. This first slice covers scalar-field
// (i32/boolean) structs only and is leak-only (no RC / drop) — exit-code-
// equivalent to every backend's AST path since the value is read before any
// free; rc-tracked fields + drop specialization are later slices.
pub function op_struct_make(type_name: string, nfields: i32): Op {
    return Op { kind_tag: 138, i32_imm: nfields, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: type_name };
}
// const_struct is struct_make's compile-time twin: an aggregate literal whose
// every field is a scalar LITERAL (`TypeI32 { is_char: false, width: 32,
// unsigned: false }`) is a compile-time constant, so the backends place it in
// STATIC DATA and push its address instead of allocating and storing a box per
// evaluation (#6149 — the checker's nullary type constructors were ~21% of the
// compiler's own allocations, one leaked box per call). Nothing is on the
// operand stack: the values ride in `str` as
// `<type_name>|<v0>,<v1>,…` (i32-width field values in decl order, the same
// pipe-then-comma packing the reuse-site registries use), and `i32_imm` is the
// field count so a reader that only needs the arity never parses.
//
// The static box carries a NEGATIVE rc word, which every rc entry point already
// reads as the immortal sentinel and skips — `__fern_rc_inc` / `__fern_arr_dec`
// / `__fern_str_free` return early, and `__fern_rc_is_unique` returns 0, so a
// record update or an FBIP reuse targeting a shared constant degrades to a fresh
// allocation rather than writing through it. With E048 forbidding field
// assignment, a shared constant box cannot be observed to change.
pub function op_const_struct(type_name: string, nfields: i32, values: string): Op {
    return Op { kind_tag: 218, i32_imm: nfields, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: type_name + "|" + values };
}

// const_struct_type / const_struct_values split an op_const_struct's packed
// `str` back into its two halves. One splitter, so the three backends cannot
// disagree about the encoding.
//
// The values come back as SOURCE TEXT, not integers — the same contract
// op_const_i32_text carries, for the same reason: the assembler / WAT parser
// handles the base and the unsigned range, where a Fern-side decimal parse
// would zero every hex literal.
pub function const_struct_type(packed: string): string {
    var i: i32 = 0;
    while (i < packed.len() && packed[i] != 124) { i = i + 1; }   // 124 = '|'
    return packed[0 : i] + "";
}

pub function const_struct_values(packed: string): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < packed.len() && packed[i] != 124) { i = i + 1; }
    i = i + 1;
    var start: i32 = i;
    while (i < packed.len()) {
        if (packed[i] == 44) {                                    // 44 = ','
            out = out.append(packed[start : i] + "");
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < packed.len()) { out = out.append(packed[start : packed.len()] + ""); }
    return out;
}
// struct_copy pops [src box] and pushes a FRESH box that is a shallow, word-for-
// word copy of src (the same shape ptr @0 + all `nfields` field slots). It is the
// compact lowering of a functional struct-update's base copy: `T { ...base, f: v }`
// becomes struct_copy(base) then one struct_set per overridden field, so the copy
// of the N unchanged fields is a single O(1) `call __fn___fern_struct_copy` instead of N
// inline struct_get/store pairs per update site (#4650 — the self-host compiler's
// working set on the x86_encode/x86_gas encoders, ~90 update sites on an 8-field
// struct, otherwise scales ~1.75x the compact __set_field form and OOMs the wasm
// driver). The copy shares every field pointer (arrays / strings / nested boxes)
// exactly as the inline base-copy path does — same heap topology, same absence of
// per-field rc-inc — so it is gated to structs whose base copy emits no retain
// (struct_copy_eligible): the fresh box's rc header is 1 (from __fern_arr_box),
// matching struct_make. Layout-agnostic: the helper copies `nfields`+1 words.
pub function op_struct_copy(nfields: i32): Op {
    return Op { kind_tag: 198, i32_imm: nfields, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
// width selects the field's load/store size on width-typed backends (wasm): 64
// for an f64 field, 0 (i32-shaped) otherwise. The register backends use 8-byte
// slots for every field and ignore it.
pub function op_struct_get(field_index: i32, width: i32): Op {
    return Op { kind_tag: 139, i32_imm: field_index, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}

// struct_set pops [struct, value] and stores value into field `field_index`
// (the in-place `p.x = v` mutation). Scalar fields only (leak-only structs);
// the box is shared by reference, so aliases observe the write — matching the
// AST path. Layout-agnostic: each backend writes at its own field offset.
pub function op_struct_set(field_index: i32, width: i32): Op {
    return Op { kind_tag: 140, i32_imm: field_index, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}
// i64-field struct ops: an 8-byte field like f64, but the wasm backend uses
// i64.load / i64.store (an INTEGER 8-byte slot). The `unsigned` flag carries the
// "8-byte field is i64, not f64" distinction (width 64 + unsigned => i64). The
// register backends use 8-byte slots for every field and ignore it.
pub function op_struct_get_i64(field_index: i32): Op {
    return Op { kind_tag: 139, i32_imm: field_index, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: true, str: "" };
}
pub function op_struct_set_i64(field_index: i32): Op {
    return Op { kind_tag: 140, i32_imm: field_index, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: true, str: "" };
}

// struct_set_shape pops [box] and writes `type_name`'s interned shape (the SAME
// .S<idx> label / numeric type-id struct_make stores at offset 0, that variant_is
// / dyn_dispatch compare pointer/id-equal against), then pushes [box] back. Used
// by the enum-donor cross-reuse: a dead scalar-enum box is overwritten IN PLACE
// as a different same-size shape (a struct W of equal field count), so its slot 0
// must change from the donor variant's shape to W's. Layout-agnostic — each
// backend writes its own offset-0 identity (.S label on x86/arm64, type-id i32 on
// wasm), reusing exactly the struct_make shape-write.
pub function op_struct_set_shape(type_name: string): Op {
    return Op { kind_tag: 141, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: type_name };
}

// high-level tuple ops — layout-agnostic, like the struct ops, but a tuple box
// has NO shape/type-id slot (field access is the numeric `.0` / `.1` spelling,
// resolved at the access site): element i sits at the box's slot i. `tuple_make`
// pops `i32_imm` element values (element 0 deepest) and pushes the new box;
// `tuple_get` pops [tuple] and pushes element `i32_imm`. Scalar elements only
// (leak-only), so no RC.
pub function op_tuple_make(n: i32): Op {
    return Op { kind_tag: 142, i32_imm: n, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
// op_tuple_make_k carries the comma-joined element KINDS (e.g. "i32,i64,f64") in
// `str` so the wasm backend uses a uniform 8-byte slot per element and stores
// each with the matching instruction (i64.store for "i64", f64.store for "f64",
// else i32.store). The register backends already use 8-byte slots and ignore it.
pub function op_tuple_make_k(n: i32, kinds: string): Op {
    return Op { kind_tag: 142, i32_imm: n, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: kinds };
}
pub function op_tuple_get(idx: i32): Op {
    return Op { kind_tag: 143, i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
// `tuple_set` pops [tuple, value] and stores value into element `i32_imm` at
// offset idx*8 (tuples have NO shape slot — element i lives at data+i*8, unlike
// struct_set's (i+1)*8). Used only by the tuple constructor-reuse path
// (emit_cross_tuple_reuse) to write a new tuple's elements into a reused dead
// donor box in place. Tuples are otherwise immutable, so this is the sole writer.
// Width 0 is the i32 / pointer (string / struct / array / Option / …) case:
// wasm i32.store; the register backends use a uniform 8-byte movq / str slot for
// EVERY element kind (element values ride the operand stack as 8 bytes), so they
// ignore width — only wasm distinguishes it.
pub function op_tuple_set(idx: i32): Op {
    return Op { kind_tag: 144, i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
// 8-byte tuple element writes (the write mirror of op_tuple_get_w): width 64
// selects an 8-byte wasm store; `unsigned` picks i64.store (set) vs f64.store
// (clear). The register backends store 8 bytes for every element and ignore it.
pub function op_tuple_set_w(idx: i32, width: i32, is_i64: boolean): Op {
    return Op { kind_tag: 144, i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: is_i64, str: "" };
}
// 8-byte tuple element reads: width 64 selects an 8-byte load; `unsigned` picks
// i64.load (set) vs f64.load (clear). Offsets are a uniform 8-byte stride.
pub function op_tuple_get_w(idx: i32, width: i32, is_i64: boolean): Op {
    return Op { kind_tag: 143, i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: is_i64, str: "" };
}

// variant_is pops an enum-variant box and pushes 1 if it is the variant named
// `str`, else 0 — the discriminant test that drives `match` arm dispatch. A
// variant box is built by struct_make (the variant struct's name is its shape /
// type id, its payload is field 0), so the test reads the box's slot-0 tag and
// compares it to the named variant's identity: the interned shape-name pointer
// on x86/arm64, the struct type id on wasm. Layout-agnostic, like the other
// high-level ops — each backend resolves the identity for its own layout.
pub function op_variant_is(name: string): Op {
    return Op { kind_tag: 145, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: name };
}

// calls — i32_imm is the arg count; str is the callee for call_direct
pub function op_call_direct(callee: string, argc: i32): Op {
    return Op { kind_tag: 149, i32_imm: argc, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: callee };
}
// op_dyn_dispatch is a `dyn Trait` method call. The receiver (arg 0) + args
// have been spilled into argc CONSECUTIVE local slots starting at `base_slot`
// (so every backend can reload them per dispatch arm — wasm can't index a deep
// operand-stack slot). The backend reads the receiver's runtime shape pointer
// and dispatches to the matching `<ConcreteType>.<method>` — a compare-branch
// chain over the trait's impl types, mirroring the AST emitter. `str` is the
// method name; `i32_imm` is base_slot; `width` is argc (1 + nargs).
pub function op_dyn_dispatch(method: string, base_slot: i32, argc: i32): Op {
    return Op { kind_tag: 147, i32_imm: base_slot, i64_imm: 0, f64_imm: 0.0, width: argc, unsigned: false, str: method };
}
// op_dyn_box heap-boxes a PRIMITIVE/string value coerced into a `dyn Trait`
// slot (docs/DYN-TRAITS.md §4.2.3). A struct/enum value already carries its
// shape at offset 0, so it is the `dyn` fat pointer directly and needs no box;
// a primitive value has no shape pointer, so it is boxed into a cell
// `[shape@0, value@8]` whose offset-0 shape is the concrete type's interned
// type-name (the SAME `.S<idx>` / type-id mechanism struct shapes use, keyed by
// the primitive type name e.g. "i32"/"string"). The boxed value (one word — an
// i32/i64/f64 scalar OR a `string`'s heap-box pointer) is stored at offset 8.
// The value is on top of the operand stack; the op leaves the cell pointer.
// `str` is the primitive type name. Dispatch (op_dyn_dispatch) reads offset 0,
// matches a primitive arm, and reloads the value from offset 8 (UNBOX).
pub function op_dyn_box(type_name: string): Op {
    return Op { kind_tag: 146, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: type_name };
}
// op_dyn_downcast is the `e as? T` fallible downcast (docs/DYN-TRAITS.md §9).
// The `dyn Trait` value (a heap pointer carrying its concrete shape at offset 0)
// is on top of the operand stack. The op reads that offset-0 shape and compares
// it to T's interned shape (the SAME `.S<idx>` label / numeric type-id the
// op_dyn_dispatch arms and struct_make use, so pointer/id identity holds) — on
// an exact match it builds `Some(value)` (the value IS the concrete `T`
// pointer), else `None`, leaving an ordinary Option box (tag@0, payload@) a
// downstream `match` reads with the same opt_tag/opt_payload it reads any
// Option with. `str` is the target concrete type name T. No new shape metadata:
// the downcast is a single shape read + compare, mirroring the dispatch chain.
pub function op_dyn_downcast(target: string): Op {
    return Op { kind_tag: 148, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: target };
}
pub function op_call_indirect(argc: i32): Op {
    return Op { kind_tag: 150, i32_imm: argc, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
// op_call_indirect_sig is op_call_indirect carrying the funcref SIGNATURE the
// call dispatches through ("wl_w" — one width char per parameter, then '_',
// then the result char). wasm needs it because a funcref type is structural:
// the arity alone cannot distinguish `(i64) => boolean` from `(i32) => i32`,
// and dispatching the first through the second is a module that will not load
// (#6282). The register backends read only `i32_imm`, so the tag rides the
// otherwise-unused `str` and costs them nothing. An empty `sig` is exactly
// op_call_indirect — every all-i32 and every erased-generic call site keeps
// its previous op, byte for byte.
pub function op_call_indirect_sig(argc: i32, sig: string): Op {
    return Op { kind_tag: 150, i32_imm: argc, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: sig };
}
pub function op_call_closure(argc: i32): Op {
    return Op { kind_tag: 151, i32_imm: argc, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

// structured control flow — i32_imm is the block-type (block/loop/if) or
// the relative branch depth (br/brif), mirroring native exactly.
pub function op_block(blocktype: i32): Op {
    return Op { kind_tag: 152, i32_imm: blocktype, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_loop(blocktype: i32): Op {
    return Op { kind_tag: 153, i32_imm: blocktype, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_if(blocktype: i32): Op {
    return Op { kind_tag: 154, i32_imm: blocktype, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_else(): Op { return op0("else"); }
pub function op_end(): Op { return op0("end"); }
pub function op_br(depth: i32): Op {
    return Op { kind_tag: 157, i32_imm: depth, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_brif(depth: i32): Op {
    return Op { kind_tag: 158, i32_imm: depth, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

pub function op_drop(): Op { return op0("drop"); }
pub function op_return(): Op { return op0("return"); }

// ---- integer op-kind registry (issue #4394 lever 2) --------------------
//
// The canonical string<->int op-kind mapping, mirroring native's `ir.OpKind`
// enum + its `String()` / `intOp` (internal/ir/ir.go:44, :344, :13652). Native
// dispatches every backend op on an INT `OpKind` (an O(1) compare); the
// self-host still tags each `Op.kind` with a STRING, so every backend dispatch
// (asm_ir / asm_arm64_ir / wasm_ir / irlower) runs an O(len) string
// compare inside its triple-nested emit loop, and each string tag fattens the
// persistent Op box (the residual pinned on `Op.str` in
// docs/IR-SELFCOMPILE-OOM-FINDINGS.md).
//
// This is slice 1 of that conversion: the canonical id<->name bijection + the
// int-keyed classifier predicates, landed additively (nothing consumes them
// yet, exactly like ir.fern slice 0). A later slice stamps `kind_id(op.kind)`
// into an int field on `Op` at construction and rewrites the backend dispatch
// ladders to compare ints, at which point the string `kind` becomes debug-only
// (rendered via `kind_name`). Ids are stable and 1-based; 0 is KIND_INVALID (an
// unknown / not-yet-registered tag), mirroring native's `OpInvalid = iota`.
//
// kind_id and kind_name are generated from ONE ordered vocabulary, so they are
// mutual inverses by construction; ir_kind_run.fern asserts the round-trip over
// the whole table as a regression backstop (a new op kind must be added here).
//
// Both directions are split into ~40-branch chunks: a single ~197-branch
// dispatch is an oversized function the self-host backend miscompiles (#2720),
// and ir.fern is compiled by that backend under the arm64 fixpoint self-compile
// (asm_arm64.fern imports ./ir). Each chunk stays near render_op's proven-safe
// size.

// kind_count is the number of registered op kinds (ids 1..kind_count()).
pub function kind_count(): i32 { return 197; }

function kind_id_0(name: string): i32 {
    if (name == "const_i32") { return 1; }
    if (name == "const_i32_text") { return 2; }
    if (name == "const_i64") { return 3; }
    if (name == "const_f64") { return 4; }
    if (name == "const_str") { return 5; }
    if (name == "const_func") { return 6; }
    if (name == "int_extend") { return 7; }
    if (name == "int_wrap") { return 8; }
    if (name == "int_cast") { return 9; }
    if (name == "u32_wrap") { return 10; }
    if (name == "i32_to_f64") { return 11; }
    if (name == "f64_to_i32") { return 12; }
    if (name == "f64_to_i64") { return 13; }
    if (name == "f32_bits") { return 14; }
    if (name == "f32_from_bits") { return 15; }
    if (name == "f64_bits") { return 16; }
    if (name == "f64_from_bits") { return 17; }
    if (name == "load_local") { return 18; }
    if (name == "store_local") { return 19; }
    if (name == "tee_local") { return 20; }
    if (name == "add") { return 21; }
    if (name == "sub") { return 22; }
    if (name == "mul") { return 23; }
    if (name == "div_s") { return 24; }
    if (name == "div_u") { return 25; }
    if (name == "rem_s") { return 26; }
    if (name == "rem_u") { return 27; }
    if (name == "and") { return 28; }
    if (name == "or") { return 29; }
    if (name == "xor") { return 30; }
    if (name == "shl") { return 31; }
    if (name == "shr_s") { return 32; }
    if (name == "shr_u") { return 33; }
    if (name == "not") { return 34; }
    if (name == "eq") { return 35; }
    if (name == "ne") { return 36; }
    if (name == "lt_s") { return 37; }
    if (name == "le_s") { return 38; }
    if (name == "gt_s") { return 39; }
    if (name == "ge_s") { return 40; }
    return 0;
}
