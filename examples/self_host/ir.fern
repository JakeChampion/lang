// kind_name maps an integer id back to its op-kind tag ("invalid" for an
// out-of-range / KIND_INVALID id). The inverse of kind_id. A cheap range
// check routes to the owning chunk; everything past 160 — including the
// extension tags beyond kind_count() (struct_copy=198 … create_dir_all=231)
// — lives in kind_name_4, whose fallthrough is the "invalid" sentinel.
pub function kind_name(id: i32): string {
    if (id <= 40) { return kind_name_0(id); }
    if (id <= 80) { return kind_name_1(id); }
    if (id <= 120) { return kind_name_2(id); }
    if (id <= 160) { return kind_name_3(id); }
    return kind_name_4(id);
}

// ---- int-keyed classifier predicates -----------------------------------
//
// The forward-looking, int-keyed twins of native's `isConstOp` /
// `isTerminator` / `isFoldableBinary` (internal/ir/constprop.go:313,
// dce.go:110, fold.go:281). They take a `kind_id` so that once `Op` carries
// its int tag the backend passes / optimisation gates become int compares with
// no string traffic. Written against `kind_id("...")` rather than raw literal
// ids so they stay correct if the vocabulary is reordered — the ids are an
// implementation detail, the tags are the contract.

// is_const_kind reports whether `id` is one of the constant-producing ops
// (the arm a constant-propagation / fold pass keys its value table on).
pub function is_const_kind(id: i32): boolean {
    return id == kind_id("const_i32") || id == kind_id("const_i32_text")
        || id == kind_id("const_i64") || id == kind_id("const_f64")
        || id == kind_id("const_str") || id == kind_id("const_func");
}

// is_terminator_kind reports whether `id` ends a basic block with no
// fall-through: `return` (leaves the function), unconditional `br`, and `exit`
// (terminates the process, never returns). `brif` is conditional, so it is NOT
// a terminator. Mirrors native's isTerminator (OpReturn / OpBr / …).
pub function is_terminator_kind(id: i32): boolean {
    return id == kind_id("return") || id == kind_id("br") || id == kind_id("exit");
}

// is_foldable_binary_kind reports whether `id` is an i32 binary op a constant
// folder can evaluate at compile time (pop r, pop l, push apply) — the int-id
// twin of irlower.is_bin_kind and native's isFoldableBinary. Division /
// remainder are included (the folder models the total, never-trapping
// x/0 = 0 semantics).
pub function is_foldable_binary_kind(id: i32): boolean {
    return id == kind_id("add") || id == kind_id("sub") || id == kind_id("mul")
        || id == kind_id("div_s") || id == kind_id("rem_s")
        || id == kind_id("and") || id == kind_id("or") || id == kind_id("xor")
        || id == kind_id("shl") || id == kind_id("shr_s")
        || id == kind_id("eq") || id == kind_id("ne")
        || id == kind_id("lt_s") || id == kind_id("le_s")
        || id == kind_id("gt_s") || id == kind_id("ge_s");
}

// fold_const_binaries collapses `const_i32 a; const_i32 b; <foldable bin>`
// into a single `const_i32 (a OP b)`, repeatedly, until the op list stops
// shrinking.
//
// is_foldable_binary_kind has existed since the registry landed and had no
// consumer but its own registry test — this is that consumer. Without it the
// stack-machine lowering emits the whole dance for a literal: `0 - 8` in a
// helper's `__raw_addr(p, 0 - 8)` costs a const, a const, two pops, a sub and
// a push, none of which survive folding.
//
// It runs on EVERY build, not just -O. constfold.fold_module is the AST-level
// sibling and is gated behind -O (fern.fern), so a default build had no
// constant folding at all; this one is a pure op-list rewrite with no source
// shape to preserve, so there is nothing for a diagnostic to lose by it.
//
// Width and signedness ride from the BINARY op, not the operands: a folded
// `const` inherits the width the binary was going to produce. Only i32-width
// signed arithmetic folds — is_foldable_binary_kind excludes the float ops and
// the unsigned compares, and this skips anything whose operands carry source
// TEXT (op_const_i32_text), because that text is what the wide-literal path
// splices into a 64-bit immediate and folding would discard it.
//
// Division and remainder by zero are NOT folded, and deliberately: Fern's
// division is total (`x / 0 == 0`, docs/INTEGER-SEMANTICS.md) but the fold
// would have to reproduce that exactly, and getting it wrong is a silent
// wrong answer rather than a crash. Leaving them to the backend keeps one
// implementation of the rule.
pub function fold_const_binaries(ops: Op[]): Op[] {
    var cur: Op[] = ops;
    var changed: boolean = true;
    while (changed) {
        changed = false;
        var out: Op[] = [];
        var i: i32 = 0;
        while (i < cur.len()) {
            if (i + 2 < cur.len()) {
                var a: Op = cur[i];
                var b: Op = cur[i + 1];
                var o: Op = cur[i + 2];
                if (const_i32_readable(a) && const_i32_readable(b)
                    && is_foldable_binary_kind(o.kind_tag) && o.width != 64 && !o.unsigned
                    && !fold_would_divide_by_zero(o.kind_tag, const_i32_value(b))) {
                    out = out.append(op_const_i32(fold_binary_i32(o.kind_tag, const_i32_value(a), const_i32_value(b))));
                    i = i + 3;
                    changed = true;
                } else {
                    out = out.append(cur[i]);
                    i = i + 1;
                }
            } else {
                out = out.append(cur[i]);
                i = i + 1;
            }
        }
        cur = out;
    }
    return cur;
}

// const_i32_readable reports whether `o` is an i32 constant a peephole may
// read — shared by the fold and strength passes here and by the backends'
// constant-shift-count selection.
//
// Two shapes qualify. op_const_i32 (tag 1) carries its value in i32_imm and is
// unconditionally fine. op_const_i32_text (tag 2) is what a SOURCE LITERAL
// lowers to — it carries the literal's text so the wide / hex paths can splice
// it verbatim — and only qualifies when that text is a plain decimal i32.
//
// The round-trip is the test: digits_to_i32 stops at the first non-digit and
// accumulates without overflow checks, so it answers 0 for "0x10" and wraps
// silently on anything too wide. Re-rendering and comparing rejects exactly the
// cases where its answer is not the literal — hex, a suffix, a leading zero, an
// overflow — without this pass having to know which forms exist.
pub function const_i32_readable(o: Op): boolean {
    if (o.kind_tag == 1) { return o.str.len() == 0; }
    if (o.kind_tag != 2) { return false; }
    if (o.str.len() == 0) { return false; }
    return util.i32_to_string(util.digits_to_i32(o.str)) == o.str;
}

// const_i32_value reads the value out of whichever of the two shapes it is.
// Only call it on an Op that const_i32_readable accepted.
pub function const_i32_value(o: Op): i32 {
    if (o.kind_tag == 1) { return o.i32_imm; }
    return util.digits_to_i32(o.str);
}

// fold_would_divide_by_zero guards the two ops whose zero divisor has a
// defined-but-easy-to-get-wrong answer. See fold_const_binaries.
function fold_would_divide_by_zero(k: i32, rhs: i32): boolean {
    if (rhs != 0) { return false; }
    return k == kind_id("div_s") || k == kind_id("rem_s");
}

// fold_binary_i32 evaluates one foldable i32 binary. The comparisons yield
// 1 / 0, matching what the backends materialise for a boolean.
function fold_binary_i32(k: i32, a: i32, b: i32): i32 {
    if (k == kind_id("add")) { return a + b; }
    if (k == kind_id("sub")) { return a - b; }
    if (k == kind_id("mul")) { return a * b; }
    if (k == kind_id("div_s")) { return a / b; }
    if (k == kind_id("rem_s")) { return a % b; }
    if (k == kind_id("and")) { return a & b; }
    if (k == kind_id("or")) { return a | b; }
    if (k == kind_id("xor")) { return a ^ b; }
    if (k == kind_id("shl")) { return a << b; }
    if (k == kind_id("shr_s")) { return a >> b; }
    if (k == kind_id("eq")) { if (a == b) { return 1; } return 0; }
    if (k == kind_id("ne")) { if (a != b) { return 1; } return 0; }
    if (k == kind_id("lt_s")) { if (a < b) { return 1; } return 0; }
    if (k == kind_id("le_s")) { if (a <= b) { return 1; } return 0; }
    if (k == kind_id("gt_s")) { if (a > b) { return 1; } return 0; }
    if (k == kind_id("ge_s")) { if (a >= b) { return 1; } return 0; }
    return 0;
}

// ---- strength reduction ------------------------------------------------
//
// reduce_strength rewrites the `<expr> ; const K ; <binop>` adjacency into a
// cheaper equivalent — the op-list twin of native's internal/ir/strength.go.
// No dataflow is needed: the constant sits immediately before the binary that
// consumes it, so one linear walk finds every site.
//
//   x * 1, x + 0, x - 0, x | 0, x ^ 0, x << 0, x >> 0,
//   x & -1, x / 1                     -> both ops vanish
//   x * 0, x & 0, x % 1               -> drop ; const_i32 0
//   x * 2^n                           -> const_i32 n ; shl
//   x /u 2^n                          -> const_i32 n ; shr_u
//   x %u 2^n                          -> const_i32 2^n-1 ; and
//
// Deleting `const K ; binop` is sound whatever precedes it: the binary pops
// the constant and one value beneath it, so removing both leaves exactly that
// value on the stack. The `drop` in the zero-result rewrites is what preserves
// a side effect the discarded operand carried (a call in operand position).
//
// SIGNED division and remainder by 2^n are deliberately left alone. `div_s`
// rounds toward zero (`-1 / 2 == 0`) where `shr_s` rounds toward negative
// infinity (`-1 >> 1 == -1`), and `rem_s` keeps the dividend's sign where the
// low-bit mask does not. Only the divisor-1 forms (exact for either sign) and
// the unsigned variants are rewritten.
//
// Scope is i32 width, like fold_const_binaries: the replacement constants are
// op_const_i32, and splicing one beside a 64-bit or pointer-width op would
// hand the backend a mismatched-width operand.

// StrengthResult is what reduce_strength_ex returns: the rewritten op list
// plus whether any site fired, so optimize_ops can stop at a fixpoint without
// diffing two op lists.
pub struct StrengthResult {
    ops: Op[],
    changed: boolean,
}

// StrengthRewrite is one site's verdict. `ops` replaces the `const K ; binop`
// pair and is empty for the identities, where both ops simply vanish.
struct StrengthRewrite {
    ok: boolean,
    ops: Op[],
}

function strength_none(): StrengthRewrite { return StrengthRewrite { ok: false, ops: [] }; }
function strength_del(): StrengthRewrite { return StrengthRewrite { ok: true, ops: [] }; }
function strength_drop0(): StrengthRewrite {
    var o: Op[] = [op_drop(), op_const_i32(0)];
    return StrengthRewrite { ok: true, ops: o };
}
function strength_pair(a: Op, b: Op): StrengthRewrite {
    var o: Op[] = [a, b];
    return StrengthRewrite { ok: true, ops: o };
}

// log2_i32 gives the base-2 log of `n` when n is a positive power of two, and
// -1 otherwise (zero, negative, or not a power of two).
function log2_i32(n: i32): i32 {
    if (n <= 0) { return 0 - 1; }
    if ((n & (n - 1)) != 0) { return 0 - 1; }
    var r: i32 = 0;
    var v: i32 = n;
    while (v > 1) { r = r + 1; v = v >> 1; }
    return r;
}

// strength_rewrite decides what replaces `const k ; bop`.
function strength_rewrite(k: i32, bop: Op): StrengthRewrite {
    var t: i32 = bop.kind_tag;
    if (t == kind_id("mul")) {
        if (k == 1) { return strength_del(); }
        if (k == 0) { return strength_drop0(); }
        var n: i32 = log2_i32(k);
        if (n > 0) { return strength_pair(op_const_i32(n), op_bin("shl", 0, false)); }
        return strength_none();
    }
    if (t == kind_id("add") || t == kind_id("sub") || t == kind_id("or")
        || t == kind_id("xor") || t == kind_id("shl")
        || t == kind_id("shr_s") || t == kind_id("shr_u")) {
        if (k == 0) { return strength_del(); }
        return strength_none();
    }
    if (t == kind_id("and")) {
        if (k == 0) { return strength_drop0(); }
        if (k == 0 - 1) { return strength_del(); }
        return strength_none();
    }
    if (t == kind_id("div_s")) {
        if (k == 1) { return strength_del(); }
        return strength_none();
    }
    if (t == kind_id("div_u")) {
        if (k == 1) { return strength_del(); }
        var nd: i32 = log2_i32(k);
        if (nd > 0) { return strength_pair(op_const_i32(nd), op_bin("shr_u", 0, false)); }
        return strength_none();
    }
    if (t == kind_id("rem_s")) {
        if (k == 1) { return strength_drop0(); }
        return strength_none();
    }
    if (t == kind_id("rem_u")) {
        if (k == 1) { return strength_drop0(); }
        var nr: i32 = log2_i32(k);
        if (nr > 0) { return strength_pair(op_const_i32(k - 1), op_bin("and", 0, false)); }
        return strength_none();
    }
    return strength_none();
}

// reduce_strength_ex is reduce_strength plus the changed flag optimize_ops
// needs. A single forward walk suffices even for a chain (`x * 4 * 2`): a
// rewrite's output is appended, never rescanned, but the REMAINING input is,
// so the second site is found in the same pass.
pub function reduce_strength_ex(ops: Op[]): StrengthResult {
    var out: Op[] = [];
    var changed: boolean = false;
    var i: i32 = 0;
    while (i < ops.len()) {
        if (i + 1 < ops.len() && const_i32_readable(ops[i]) && ops[i + 1].width == 0) {
            var repl: StrengthRewrite = strength_rewrite(const_i32_value(ops[i]), ops[i + 1]);
            if (repl.ok) {
                var r: i32 = 0;
                while (r < repl.ops.len()) { out = out.append(repl.ops[r]); r = r + 1; }
                changed = true;
                i = i + 2;
                continue;
            }
        }
        out = out.append(ops[i]);
        i = i + 1;
    }
    return StrengthResult { ops: out, changed: changed };
}

// reduce_strength is the plain-op-list form, for callers that don't need the
// fixpoint signal.
pub function reduce_strength(ops: Op[]): Op[] {
    return reduce_strength_ex(ops).ops;
}

// ---- dead-code elimination (#6638, native internal/ir/dce.go) -----------
//
// An op list routinely carries stretches that cannot be reached because an
// earlier op in the same scope already left it. The commonest shape is the
// lowering's own: a match arm ends `return ; br 1`, and the `br` is dead the
// moment the `return` is emitted. Every one of those ops is emitted, assembled
// and linked today.
//
// The walk is linear, tracks scope depth, and drops everything between a
// terminator and the next merge:
//
//   terminators — `return` (leaves the function) and `br` (leaves its target
//     scope, so nothing after it in THIS scope can fall through).
//   merges — `end` at the depth the terminator sat at (the dead region's
//     scope closes) and `else` at that depth (the other arm starts fresh).
//
// `brif` is conditional and terminates nothing. A scope OPENED inside a dead
// region is depth-tracked so its `end` lines up, but its body goes with it.
//
// `exit` is deliberately NOT a terminator here, though is_terminator_kind
// counts it: the process does not come back, but the operand stack is not
// polymorphic after it. Every backend emits `exit` as a call plus a dummy
// result that the following `drop` consumes, so dropping the ops after it
// would leave the enclosing scope one slot high — a wasm module that fails
// validation rather than a smaller one.
pub function eliminate_dead_code(ops: Op[]): Op[] {
    var out: Op[] = [];
    var depth: i32 = 0;
    var dead: boolean = false;
    var dead_depth: i32 = 0;
    var k_block: i32 = kind_id("block");
    var k_loop: i32 = kind_id("loop");
    var k_if: i32 = kind_id("if");
    var k_else: i32 = kind_id("else");
    var k_end: i32 = kind_id("end");
    var k_br: i32 = kind_id("br");
    var k_return: i32 = kind_id("return");
    var i: i32 = 0;
    while (i < ops.len()) {
        var t: i32 = ops[i].kind_tag;
        if (t == k_block || t == k_loop || t == k_if) {
            if (!dead) { out = out.append(ops[i]); }
            depth = depth + 1;
        } else if (t == k_end) {
            if (dead && depth == dead_depth) { dead = false; }
            if (!dead) { out = out.append(ops[i]); }
            depth = depth - 1;
        } else if (t == k_else) {
            if (dead && depth == dead_depth) { dead = false; }
            if (!dead) { out = out.append(ops[i]); }
        } else if (!dead) {
            out = out.append(ops[i]);
            if (t == k_return || t == k_br) {
                dead = true;
                dead_depth = depth;
            }
        }
        i = i + 1;
    }
    return out;
}

// optimize_ops runs the op-list peepholes to a fixpoint, then drops what the
// result cannot reach. The first two feed each other: folding makes a constant
// adjacent to the op that consumes it, and a strength rewrite's
// `drop ; const_i32 0` puts a fresh constant next to whatever constant
// follows. fold_const_binaries already self-iterates, so a strength pass that
// rewrote nothing is the fixpoint; the round cap is defensive.
//
// Dead-code elimination runs LAST and once: it only removes ops, so it can
// neither create a foldable adjacency (the ops it drops are unreachable, and
// the ops around the hole were never adjacent in any executed path) nor
// benefit from another round of itself — it is idempotent by construction.
pub function optimize_ops(ops: Op[]): Op[] {
    var cur: Op[] = fold_const_binaries(ops);
    var rounds: i32 = 0;
    while (rounds < 8) {
        var r: StrengthResult = reduce_strength_ex(cur);
        if (!r.changed) { return fold_const_binaries(propagate_copies(const_propagate(fuse_tee(eliminate_dead_code(cur))))); }
        cur = fold_const_binaries(r.ops);
        rounds = rounds + 1;
    }
    return fold_const_binaries(propagate_copies(const_propagate(fuse_tee(eliminate_dead_code(cur)))));
}

// ---- tee fusion --------------------------------------------------------
//
// fuse_tee collapses the `store_local X ; load_local X` adjacency into a single
// `tee_local X` — the op-list twin of native's internal/ir/tee.go (#6638).
//
// The pattern arrives from the closure inliner's arg-bind round trip, from a
// `var x = …` immediately read, and from the assignment-as-expression lowering.
// wasm is what the pass is FOR: `local.tee` is a byte and a load cheaper than
// `local.set $X ; local.get $X`. The register backends peek the operand-stack top
// instead of popping and re-pushing it, which is a wash — native's own header
// calls the pass "effectively WASM-only in payoff".
//
// Fires ONLY on an immediate adjacency addressing the same slot. Anything
// between the two — even an op that cannot touch the slot — leaves the pair
// alone; widening that is copy propagation's job, not a peephole's. Runs LAST,
// after dead-code elimination, so a pair the DCE walk exposes is still caught.
// Idempotent: a tee_local matches neither arm, so a second run is a no-op.
// propagate_copies drops a `tee_local X` whose slot NOTHING else touches — the
// op-list half of native's internal/ir/copyprop.go (#6638).
//
// A tee writes the slot and keeps the value on the operand stack. When no other
// op in the function reads, stores or tees that slot, the write is dead and the
// tee reduces to "pop, push" — identity. The shape comes straight out of
// fuse_tee: the inliner binds a single-use argument to a fresh slot, the bind
// round-trip fuses to a tee, and then nothing references the slot at all.
// Native's worked example, which this reproduces:
//
//	inline     const 7 ; store ; load ; const 2 ; mul ; return
//	fuse_tee   const 7 ; tee   ;        const 2 ; mul ; return
//	this pass  const 7 ;                const 2 ; mul ; return
//	fold       const 14 ;                                return
//
// The last line is why optimize_ops folds once more after this runs — without
// it the exposed const/const/binary triple has nothing to collapse it.
//
// SAFE because the RC exit sweeps are IN this op stream: a swept local is read
// by a `load_local` before its dec, so its slot is never "untouched" and its tee
// is never dropped. optimize_ops runs over the COMPLETE lowering, sweeps
// included, which is what makes the whole-function count trustworthy.
//
// DELIBERATELY NOT PORTED: native's other half, rewriting a dead `store_local`
// to a `drop`. It needs SLOT TYPES, which this pass does not have — native's
// version takes the whole `*Func` for exactly that reason (slotIsTwoWord).
//
// Tried and reverted, so the reason is measured rather than assumed. The STRING
// representation is a red herring: the self-host's wasm string really is a single
// pointer to a `[len@0][bytes@4]` block, so strings alone would make one `drop`
// exact. `dyn Trait` is the shape that breaks it — an inline [data, vtable] pair,
// TWO operand-stack values, which is the second arm of native's slotIsTwoWord.
// Rewriting that store to a single drop strands one value: wasmtime rejects the
// module ("values remaining on stack at end of block") and the register backends
// SEGFAULT, because the imbalance shifts everything the frame reads afterwards.
//
// So this wants a slot-type source at the op-list layer first. Note also that the
// naive carrier — threading `fn` through the walk the way native does — is the
// shape #6704 withdrew for costing +50% emit-all, so it needs something cheaper
// than a parameter on a recursive walk.
// const_propagate replaces a `load_local X` with the constant last stored to X —
// the straight-line core of native's internal/ir/constprop.go (#6638). It catches
// what fuse_tee and propagate_copies structurally cannot: a store and load that
// are NOT adjacent.
//
//	const 7 ; store 0 ; <other ops> ; load 0 ; const 3 ; add
//
// fuse_tee needs the pair adjacent, so the load survives; this rewrites it to
// `const 7` and the fold then collapses the triple to `const 10`.
//
// Bindings survive control flow, which is what makes it worth more than a
// peephole: the merge rule is below, and SCALARS ONLY is the one restriction that
// still narrows this inside native's version.
//
// # The merge rule: kill what the scope could have written
//
// Native carries a snapshot of the slot table into every scope and intersects it
// at the merge point — then-end against else-end, a block's linear end against
// the state at every br that targeted it. This pass reaches the same answer
// without the snapshots, from one observation: a slot the scope never writes
// still holds what it held at entry, so only WRITTEN slots need reconciling.
// Tracking the op index of each slot's last write makes "written inside this
// scope" a comparison against the index the scope opened at.
//
// So a scope's end kills every slot written inside it, and that is exactly
// native's `pre` ∩ `written` without a `pre` to carry. An `else` kills the same
// set, which restores the entry state for the second arm. The rule is uniform
// and one-directional — a binding is only ever dropped — so the pass cannot
// invent a value on a path that never produced one, which is the miscompile this
// area invites: inline a constant live on one path only and the other path reads
// a slot that was never written.
//
// Two refinements on top, one per direction:
//
//   - A `block` nothing branches to runs straight through, so its end keeps the
//     bindings made inside it. A branch to the scope is what makes the writes
//     conditional, so a br or brif targeting a scope downgrades it to the kill.
//     An `if` arm is conditional whether or not anything branches to it.
//   - A `loop` kills its body's writes at ENTRY as well, because the back-edge
//     re-enters with what the body left rather than what the entry left. The
//     written set comes from scanning the body, so a binding the body cannot
//     change is still assumed inside it — where native, which clears the whole
//     table at a loop, assumes nothing. That is the one place this is the more
//     precise of the two.
//
// Deliberately NOT taken from native: a slot both arms of an if bind to the SAME
// constant survives there and dies here, because agreeing on the value needs the
// two snapshots this rule exists to avoid. It is the rarer half of the payoff.
//
// SCALARS ONLY, via the SHARED `const_i32_readable` predicate — so this pass
// admits exactly what the fold and strength peepholes admit, by construction
// rather than by coincidence. That covers both constant shapes (`const_i32` and
// the source-text `const_i32_text`, the one a literal actually lowers to) and
// inherits the guard that a text constant must round-trip as decimal. Strings and
// function values are excluded on purpose: a `const_str` is not a pure constant in
// this compiler, since it allocates a fresh box on every evaluation (#2649 Option
// A), so duplicating one where a load used to be changes both the allocation count
// and the RC identity the reclaim analyses reason about. An i32 is copied, so
// replacing a load with it changes nothing but the instruction.
// cp_max_slot is the highest slot index any load / store / tee names, or -1 when
// the op list touches no slot at all — the early-out that keeps this pass off
// functions it cannot rewrite. Sizing the tables once up front rather than growing
// them at each store is what lets the scope walk index them without a bounds
// dance; propagate_copies computes the same bound the same way.
function cp_max_slot(ops: Op[]): i32 {
    var k_load: i32 = kind_id("load_local");
    var k_store: i32 = kind_id("store_local");
    var k_tee: i32 = kind_id("tee_local");
    var maxs: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < ops.len()) {
        var kt: i32 = ops[i].kind_tag;
        if (kt == k_load || kt == k_store || kt == k_tee) {
            if (ops[i].i32_imm > maxs) { maxs = ops[i].i32_imm; }
        }
        i = i + 1;
    }
    return maxs;
}

// cp_kill_after unbinds every slot whose last write is later than `at`, which for
// `at` = the index a scope opened at is exactly the set that scope could have
// written. Called at an `else` to restore the entry state for the second arm, and
// at an `end` to reconcile the scope.
function cp_kill_after(has: boolean[], wrote: i32[], at: i32): boolean[] {
    var s: i32 = 0;
    while (s < has.len()) {
        if (has[s] && wrote[s] > at) { has = has.with(s, false); }
        s = s + 1;
    }
    return has;
}

// cp_loop_body_kill unbinds every slot the loop body opened at `at` writes. A
// loop's entry needs this where a block's and an if's do not: the back-edge
// re-enters the body with what the previous iteration left, so a binding the body
// can change is not assumable inside it. Scanning for the writes rather than
// dropping the whole table keeps the bindings the body cannot touch.
function cp_loop_body_kill(ops: Op[], at: i32, has: boolean[]): boolean[] {
    var k_store: i32 = kind_id("store_local");
    var k_tee: i32 = kind_id("tee_local");
    var k_block: i32 = kind_id("block");
    var k_loop: i32 = kind_id("loop");
    var k_if: i32 = kind_id("if");
    var k_end: i32 = kind_id("end");
    var k_str_slice: i32 = kind_id("str_slice");
    var d: i32 = 0;
    var j: i32 = at + 1;
    while (j < ops.len()) {
        var t: i32 = ops[j].kind_tag;
        if (t == k_block || t == k_loop || t == k_if) {
            d = d + 1;
        } else if (t == k_end) {
            if (d == 0) { return has; }
            d = d - 1;
        } else if (t == k_store || t == k_tee) {
            var sl: i32 = ops[j].i32_imm;
            if (sl >= 0 && sl < has.len()) { has = has.with(sl, false); }
        } else if (t == k_str_slice && ops[j].i32_imm > 0) {
            // The same three frame slots the main walk unbinds, on the same
            // reasoning: this scan is the loop's half of the write model, and a
            // write it cannot see is a binding assumed across a back-edge.
            var fb: i32 = ops[j].i32_imm - 1;
            var fk: i32 = 0;
            while (fk < 3) {
                if (fb + fk >= 0 && fb + fk < has.len()) { has = has.with(fb + fk, false); }
                fk = fk + 1;
            }
        }
        j = j + 1;
    }
    return has;
}

pub function const_propagate(ops: Op[]): Op[] {
    var maxs: i32 = cp_max_slot(ops);
    if (maxs < 0) { return ops; }
    var nslots: i32 = maxs + 1;

    var k_load: i32 = kind_id("load_local");
    var k_store: i32 = kind_id("store_local");
    var k_tee: i32 = kind_id("tee_local");
    var k_block: i32 = kind_id("block");
    var k_loop: i32 = kind_id("loop");
    var k_if: i32 = kind_id("if");
    var k_else: i32 = kind_id("else");
    var k_end: i32 = kind_id("end");
    var k_br: i32 = kind_id("br");
    var k_brif: i32 = kind_id("brif");
    var k_str_slice: i32 = kind_id("str_slice");

    // known[slot] holds the tracked constant OP, re-emitted verbatim at a load;
    // has[slot] says whether it is live. Carrying the op rather than a value keeps
    // both constant shapes on one path and cannot invent a spelling the backends
    // have not seen. wrote[slot] is the op index of the slot's last write, which
    // is how a scope's end names the slots it could have written.
    var known: Op[] = [];
    var has: boolean[] = [];
    var wrote: i32[] = [];
    var z: i32 = 0;
    while (z < nslots) {
        known = known.append(op_const_i32(0));
        has = has.append(false);
        wrote = wrote.append(0 - 1);
        z = z + 1;
    }

    // The open-scope stack, in the parallel-array form irverifystack.fern uses: a
    // pop is a decrement, so it stays O(1) on the compiler's own long functions.
    // fr_at is the op index the scope opened at, fr_wc the write count then (an
    // end whose count still matches wrote nothing, so it can skip the kill scan),
    // fr_br whether a branch targets it.
    var fr_kind: i32[] = [];
    var fr_at: i32[] = [];
    var fr_wc: i32[] = [];
    var fr_br: boolean[] = [];
    var depth: i32 = 0;
    var wc: i32 = 0;

    var out: Op[] = [];
    var i: i32 = 0;
    while (i < ops.len()) {
        var o: Op = ops[i];
        var kt: i32 = o.kind_tag;
        if (kt == k_block || kt == k_loop || kt == k_if) {
            if (depth < fr_kind.len()) {
                fr_kind = fr_kind.with(depth, kt);
                fr_at = fr_at.with(depth, i);
                fr_wc = fr_wc.with(depth, wc);
                fr_br = fr_br.with(depth, false);
            } else {
                fr_kind = fr_kind.append(kt);
                fr_at = fr_at.append(i);
                fr_wc = fr_wc.append(wc);
                fr_br = fr_br.append(false);
            }
            depth = depth + 1;
            if (kt == k_loop) { has = cp_loop_body_kill(ops, i, has); }
            out = out.append(o);
        } else if (kt == k_else) {
            // The then-arm's bindings do not reach the else-arm; dropping what the
            // arm wrote leaves exactly the state the if opened with.
            if (depth > 0 && fr_kind[depth - 1] == k_if && wc != fr_wc[depth - 1]) {
                has = cp_kill_after(has, wrote, fr_at[depth - 1]);
            }
            out = out.append(o);
        } else if (kt == k_end) {
            if (depth > 0) {
                // A block nothing branches to runs straight through, so what it
                // wrote still holds after it. Every other scope is conditional.
                var straight: boolean = fr_kind[depth - 1] == k_block && !fr_br[depth - 1];
                if (!straight && wc != fr_wc[depth - 1]) {
                    has = cp_kill_after(has, wrote, fr_at[depth - 1]);
                }
                depth = depth - 1;
            }
            out = out.append(o);
        } else if (kt == k_br || kt == k_brif) {
            // A branch makes its target scope's writes conditional. Depth is
            // relative and 0 is the innermost open scope; a depth past the stack
            // leaves the function, where there is no scope end to reconcile.
            var tgt: i32 = depth - 1 - o.i32_imm;
            if (o.i32_imm >= 0 && tgt >= 0) { fr_br = fr_br.with(tgt, true); }
            out = out.append(o);
        } else if (kt == k_str_slice && o.i32_imm > 0) {
            // str_slice_frame is the ONE op that writes locals without being a
            // store: the frame form builds its box in three consecutive slots at
            // `i32_imm - 1` (the heap form, immediate 0, writes none). Nothing can
            // bind those slots today — irlower names them `!view!`, which no source
            // identifier can spell, so slot_of never hands one to a store — but that
            // makes this pass sound by a convention in another file rather than by
            // its own reasoning. Modelling the write costs three unbinds and keeps
            // the next frame-form op from arriving into a silent stale binding.
            var fb: i32 = o.i32_imm - 1;
            var fk: i32 = 0;
            while (fk < 3) {
                var fs: i32 = fb + fk;
                if (fs >= 0 && fs < nslots) {
                    wrote = wrote.with(fs, i);
                    wc = wc + 1;
                    if (has[fs]) { has = has.with(fs, false); }
                }
                fk = fk + 1;
            }
            out = out.append(o);
        } else if (kt == k_store || kt == k_tee) {
            // A store binds the slot to the constant that produced it, read off the
            // REWRITTEN list so a load this pass just replaced counts as a constant
            // source — that is what carries a value through `var b = a`.
            var sl: i32 = o.i32_imm;
            if (sl >= 0 && sl < nslots) {
                wrote = wrote.with(sl, i);
                wc = wc + 1;
                if (out.len() > 0 && const_i32_readable(out[out.len() - 1])) {
                    known = known.with(sl, out[out.len() - 1]);
                    has = has.with(sl, true);
                } else if (has[sl]) {
                    has = has.with(sl, false);
                }
            }
            out = out.append(o);
        } else if (kt == k_load && o.i32_imm >= 0 && o.i32_imm < nslots && has[o.i32_imm]) {
            out = out.append(known[o.i32_imm]);
        } else {
            out = out.append(o);
        }
        i = i + 1;
    }
    return out;
}

pub function propagate_copies(ops: Op[]): Op[] {
    var k_load: i32 = kind_id("load_local");
    var k_store: i32 = kind_id("store_local");
    var k_tee: i32 = kind_id("tee_local");
    var maxs: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < ops.len()) {
        var kt: i32 = ops[i].kind_tag;
        if (kt == k_load || kt == k_store || kt == k_tee) {
            if (ops[i].i32_imm > maxs) { maxs = ops[i].i32_imm; }
        }
        i = i + 1;
    }
    if (maxs < 0) { return ops; }
    var reads: i32[] = [];
    var stores: i32[] = [];
    var tees: i32[] = [];
    var z: i32 = 0;
    while (z <= maxs) { reads = reads.append(0); stores = stores.append(0); tees = tees.append(0); z = z + 1; }
    i = 0;
    while (i < ops.len()) {
        var kt2: i32 = ops[i].kind_tag;
        var sl: i32 = ops[i].i32_imm;
        if (sl >= 0 && sl <= maxs) {
            if (kt2 == k_load) { reads = reads.with(sl, reads[sl] + 1); }
            else if (kt2 == k_store) { stores = stores.with(sl, stores[sl] + 1); }
            else if (kt2 == k_tee) { tees = tees.with(sl, tees[sl] + 1); }
        }
        i = i + 1;
    }
    var out: Op[] = [];
    i = 0;
    while (i < ops.len()) {
        var o: Op = ops[i];
        var dead_tee: boolean = false;
        if (o.kind_tag == k_tee && o.i32_imm >= 0 && o.i32_imm <= maxs) {
            if (reads[o.i32_imm] == 0 && stores[o.i32_imm] == 0 && tees[o.i32_imm] == 1) { dead_tee = true; }
        }
        if (!dead_tee) { out = out.append(o); }
        i = i + 1;
    }
    return out;
}

pub function fuse_tee(ops: Op[]): Op[] {
    var k_store: i32 = kind_id("store_local");
    var k_load: i32 = kind_id("load_local");
    var out: Op[] = [];
    var i: i32 = 0;
    while (i < ops.len()) {
        if (i + 1 < ops.len()
                && ops[i].kind_tag == k_store
                && ops[i + 1].kind_tag == k_load
                && ops[i].i32_imm == ops[i + 1].i32_imm) {
            out = out.append(op_tee_local(ops[i].i32_imm));
            i = i + 2;
        } else {
            out = out.append(ops[i]);
            i = i + 1;
        }
    }
    return out;
}

// is_commutative_kind reports whether `id` is an integer binary op whose
// operands can be swapped without changing the result (so a peephole may
// canonicalise operand order / fold a constant to either side). Subtraction,
// shifts, division, and the ordered compares are NOT commutative.
pub function is_commutative_kind(id: i32): boolean {
    return id == kind_id("add") || id == kind_id("mul")
        || id == kind_id("and") || id == kind_id("or") || id == kind_id("xor")
        || id == kind_id("eq") || id == kind_id("ne");
}

// ---- printing ----------------------------------------------------------
//
// render_op gives a stable one-line textual form (the basis for a future
// IR golden / disassembly test, mirroring ssa.fern's printer). Only the
// fields an opcode uses are shown.
pub function render_op(o: Op): string {
    if (o.kind_tag == 1) { return "const_i32 " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 2) { return "const_i32_text " + o.str; }
    if (o.kind_tag == 3) { return "const_i64 " + o.str; }
    if (o.kind_tag == 7) { return "int_extend"; }
    if (o.kind_tag == 8) { return "int_wrap"; }
    if (o.kind_tag == 5) { return "const_str " + o.str; }
    if (o.kind_tag == 18) { return "load_local " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 19) { return "store_local " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 20) { return "tee_local " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 149) { return "call_direct " + o.str + "/" + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 157) { return "br " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 158) { return "brif " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 67) { return "load w" + util.i32_to_string(o.width); }
    if (o.kind_tag == 68) { return "store w" + util.i32_to_string(o.width); }
    if (o.kind_tag == 87) { return "arr_make " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 97) { return "str_len"; }
    if (o.kind_tag == 98) { return "str_concat"; }
    if (o.kind_tag == 99) { return "str_eq"; }
    if (o.kind_tag == 100) { return "str_cmp"; }
    if (o.kind_tag == 101) { return "str_index"; }
    if (o.kind_tag == 102) {
        if (o.i32_imm > 0) { return "str_slice frame:" + util.i32_to_string(o.i32_imm - 1); }
        return "str_slice";
    }
    if (o.kind_tag == 96) { return "arr_slice"; }
    if (o.kind_tag == 120) { return "opt_make " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 121) { return "opt_none"; }
    if (o.kind_tag == 122) { return "opt_tag"; }
    if (o.kind_tag == 123) { return "opt_payload"; }
    if (o.kind_tag == 124) { return "map_new " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 125) { return "map_set " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 126) { return "map_len"; }
    if (o.kind_tag == 127) { return "map_get " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 128) { return "map_has " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 129) { return "map_get_or " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 130) { return "map_delete " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 131) { return "map_keys"; }
    if (o.kind_tag == 132) { return "map_values"; }
    if (o.kind_tag == 138) { return "struct_make " + o.str + "/" + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 139) { return "struct_get " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 140) { return "struct_set " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 198) { return "struct_copy " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 145) { return "variant_is " + o.str; }
    if (o.kind_tag == 142) { return "tuple_make " + util.i32_to_string(o.i32_imm); }
    if (o.kind_tag == 143) { return "tuple_get " + util.i32_to_string(o.i32_imm); }
    return kind_name(o.kind_tag);
}

// op_allocates reports whether an op of `kind` allocates on the heap (a box via
// __fern_alloc / __fern_arr_box / __fern_str_box, or one of the string helpers
// that builds a fresh box). It is the single source of truth for the
// "does this module need the heap + RC runtime?" gate that each backend runs
// over the lowered op stream: the x86 IR path (asm_ir.emit_module_ir) marks the
// "heap" need per-function off the ops it already lowered, and wasm_ir's
// module_allocates walks the stream the same way. Keeping the list here means a
// newly-added allocating op is taught to every backend's heap gate at once,
// rather than silently routing modules to the AST fallback because one backend's
// hand-maintained copy of the list fell behind.
//
// (wasm_ir.module_allocates additionally ORs in module_uses_strings for the
// non-allocating string ops — str_len/str_eq/str_cmp/str_index — that still
// pull the heap in via $__fern_strcat; the const_str/str_concat/str_slice
// members below are a subset of that, so listing them here does not change its
// result.)
pub function op_allocates(tag: i32): boolean {
    // const_struct (#6149) allocates NOTHING — its box is static data — but the
    // value still flows through the rc runtime: a dec at scope exit, an
    // is_unique + alloc_reuse on a record update whose base is the constant. It
    // is admitted here for the same reason heap_bump_bytes and the cliff
    // counters are: this gate is "needs the heap + RC runtime", not "calls the
    // allocator". Without it, a module whose every aggregate is constant loses
    // its only claimant and the link breaks on an undefined
    // __fn___fern_arr_dec / __fn___fern_rc_is_unique / __fn___fern_alloc_reuse.
    if (tag == 218) { return true; }
    // Low-level + literal allocations.
    if (tag == 76 || tag == 77 || tag == 87 || tag == 92 || tag == 94 || tag == 95) { return true; }
    if (tag == 5 || tag == 98 || tag == 102 || tag == 103) { return true; }
    // Composite boxes. struct_copy (198) allocates the fresh box a functional
    // update copies its base into (`__fn___fern_struct_copy`), so it needs the
    // heap runtime exactly as struct_make does. It was absent here and got away
    // with it only because a module containing an update always ALSO contained a
    // struct_make that claimed the need; #6149's static aggregate constants took
    // that struct_make away and the link broke on an undefined
    // __fn___fern_struct_copy / __fn___fern_arr_dec.
    if (tag == 138 || tag == 142 || tag == 198) { return true; }
    if (tag == 120 || tag == 121) { return true; }
    if (tag == 124 || tag == 125) { return true; }
    // map_iter allocates the 16-byte iterator box via __fern_alloc; the other
    // mapiter ops are pure loads / a cursor store (no allocation).
    if (tag == 133) { return true; }
    // map_keys / map_values allocate on wasm (hash-map snapshot) and — for a
    // scalar column (i32_imm 0, #4353) — on the register backends too
    // (__fern_map_snapshot_col builds a fresh rc=1 copy via __fern_arr_box).
    if (tag == 131 || tag == 132) { return true; }
    // Byte/string builders that materialise a fresh box.
    if (tag == 185 || tag == 104 || tag == 105) { return true; }
    // arr_reverse / arr_concat build a fresh array via __fern_arr_box, so they
    // need the heap runtime like arr_slice (96, in the low-level group above).
    if (tag == 214 || tag == 215) { return true; }
    // args() materialises a fresh string[] (the arr box + a string block per
    // argv entry), so it needs the heap runtime like any other allocator.
    // arg_at(i) boxes the one entry it reads, so it needs it too.
    if (tag == 180 || tag == 210) { return true; }
    // read_file boxes the file contents + a Result wrapper; write_file boxes its
    // Result[(), IoError] result — both via __fern_str_box, so they need the heap.
    if (tag == 169 || tag == 170) { return true; }
    // remove_dir_all boxes its Result[(), IoError] result and heap-builds child path
    // strings while recursing, so it needs the heap runtime.
    if (tag == 172) { return true; }
    // remove_file boxes its Result[(), IoError] result, so it needs the heap runtime.
    if (tag == 173) { return true; }
    // temp_dir boxes the path string + a Result wrapper, so it needs the heap.
    if (tag == 174) { return true; }
    // create_dir_all boxes its Result[(), IoError] result and heap-builds the
    // NUL-terminated path it walks, so it needs the heap runtime.
    if (tag == 231) { return true; }
    // read_dir boxes a fresh string[] (the arr box + a string block per entry),
    // so it needs the heap runtime.
    if (tag == 171) { return true; }
    // env boxes the looked-up value into a fresh string block (+ the Option
    // wrapper), so it needs the heap runtime.
    if (tag == 176) { return true; }
    // stat boxes a fresh FileStat struct + a Result wrapper, so it needs the heap.
    if (tag == 175) { return true; }
    // subprocess boxes a fresh ProcessResult struct + its two stdout/stderr
    // string blocks, so it needs the heap runtime.
    if (tag == 177) { return true; }
    // read_line boxes the line into a fresh string block, so it needs the heap.
    // (read_int is NOT here: it parses into scratch + returns a bare i32, like
    // the register backends, so a read_int-only module needs no heap runtime.)
    if (tag == 168) { return true; }
    // read_all_stdin allocates the whole-input buffer plus its string box.
    if (tag == 209) { return true; }
    if (tag == 106 || tag == 107) { return true; }
    if (tag == 108 || tag == 109 || tag == 110) { return true; }
    if (tag == 111 || tag == 112 || tag == 113) { return true; }
    // dyn_box allocates the 16-byte primitive `dyn` cell; dyn_downcast allocates
    // the Some/None Option box (docs/DYN-TRAITS.md §4.2.3, §9).
    if (tag == 146 || tag == 148) { return true; }
    // heap_bump_bytes does NOT allocate, but it reads the heap runtime's cursor
    // + base, so it needs that runtime emitted — fold it into the same gate
    // (the predicate's contract per the doc above is "needs the heap runtime").
    if (tag == 80) { return true; }
    // heap_mark / heap_release_to read and REWRITE that same cursor (plus the
    // freelist heads), so they need the heap runtime for the same reason (#6728).
    if (tag == 229 || tag == 230) { return true; }
    // arr_push_shared_count does not allocate either, but it reads the counter
    // __fern_arr_push bumps, which only exists when the heap runtime is emitted.
    // Same gate, same reason as heap_bump_bytes above — and the same for its
    // byte-weighted sibling, which reads the accumulator beside that counter.
    if (tag == 216 || tag == 217) { return true; }
    // map_hash_seed does not allocate, but it reads (and lazily fills) a
    // runtime word that only exists alongside the heap runtime. Same gate,
    // same reason as the two counters above.
    if (tag == 222) { return true; }
    return false;
}

// is_str_op_kind reports whether `k` is one of the string operand-stack ops
// that each native backend dispatches to a __fern_str_* runtime helper (rather
// than inline instruction selection). The asm + arm64 IR backends both factor
// these out of their giant op-dispatch chain into an emit_str_op helper, gated
// on this predicate (keeping that dispatch under the self-host backend's
// oversized-function miscompile threshold, #2720). The membership is a property
// of the IR op set — not of any one target — so it lives here and both backends
// share it; a new string op is taught to every backend's dispatch at once.
pub function is_str_op_kind(tag: i32): boolean {
    return tag == 97 || tag == 101 || tag == 102
        || tag == 104 || tag == 105 || tag == 106
        || tag == 107 || tag == 108 || tag == 109
        || tag == 110 || tag == 111 || tag == 112 || tag == 113
        || tag == 114
        || tag == 115 || tag == 116 || tag == 98
        || tag == 99 || tag == 100 || tag == 225 || tag == 227;
}
