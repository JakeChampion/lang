// examples/self_host/ir.fern — the stack-machine IR for the self-hosted
// compiler, mirroring native's internal/ir (`ir.Op` / `[]Op`). This is the
// layer the native PRODUCTION backends (arm64 / x86-64 / wasmbin) consume,
// and the layer where Perceus reference counting lives (alias-inc, the
// exit dec sweep, drop specialization, reuse tokens are all emitted here as
// `call_direct` to `__fern_rc_*` helpers during AST -> IR lowering).
//
// RC is lowered to IR once here and each backend instruction-selects an
// opcode, rather than every backend hand-writing its own RC emission.
// (ssa.fern mirrors the DOWNSTREAM optimiser `internal/ssa`, which native
// lifts FROM this IR; it is a different, higher layer.)
//
// Representation (mirrors internal/ir/ir.go, but pointer-free — the
// self-host's value-semantics style, matching ssa.fern: a function body is
// an `Op[]` flat stack-machine stream; structured control flow is the
// block/loop/if/end/br/brif scope discipline, exactly as native and wasm).
// Kinds are stable 1-based integer ids (0 = KIND_INVALID), with `kind_id` /
// `kind_name` converting to and from the printable tag the native `OpKind`
// names map 1:1 onto ("const_i32", "add", "call_direct", ...).
//
import "./util";

// SCOPE: the `Op` value and its constructor helpers. AST -> IR lowering
// lives in irlower.fern (mirroring the native `builder`); the backends
// consume the resulting `Op[]` from their asm_*_ir modules.

// ---- Op ----------------------------------------------------------------

// Op is one stack-machine instruction. Field meanings mirror native's
// `ir.Op` (internal/ir/ir.go:515):
//   kind_tag — the opcode id (see kind_id and the constructors below).
//   i32      — the immediate for "const_i32"; the local index for
//              load_local / store_local / tee_local; the block-type for
//              block / loop / if; the relative depth for br / brif; the
//              arg count for call_direct / call_indirect / call_closure;
//              the table index for const_func.
//   i64      — the immediate for "const_i64".
//   f64      — the immediate for "const_f64" (f32 reuses this until the
//              self-host grows a distinct f32 slot).
//   width    — operand bit-width for ops that exist in multiple widths
//              (add/sub/.../eq/.../load/store). 0 means 32; 64 selects i64;
//              -1 is WidthPtr, the backend-resolved pointer width (4 on
//              wasm32, 8 on arm64) — the same sentinel native uses so
//              arm64's >4 GiB heap pointers round-trip.
//   unsigned — selects the `_u` variant of div / rem / shr / comparisons.
//   str      — "const_str"'s value and "call_direct"'s callee name.
pub struct Op {
    kind_tag: i32,
    i32_imm: i32,
    i64_imm: i64,
    f64_imm: f64,
    width: i32,
    unsigned: boolean,
    str: string,
}

// WidthPtr is the backend-resolved pointer-width sentinel (native's
// ir.WidthPtr). Stored in Op.width for load / store of heap-pointer-typed
// values; each backend resolves it (wasm32 -> 4, arm64 -> 8).
pub function width_ptr(): i32 { return 0 - 1; }

// ---- constructors ------------------------------------------------------
//
// One helper per opcode, mirroring the names native gives its OpKind
// constants. Every field the opcode does not use is zeroed, so an Op is
// always fully initialised (the value-semantics discipline ssa.fern uses).

function op0(kind: string): Op {
    return Op { kind_tag: kind_id(kind), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

// constants
pub function op_const_i32(v: i32): Op {
    return Op { kind_tag: 1, i32_imm: v, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
// op_const_i32_text carries an integer literal's SOURCE TEXT (in `str`) so the
// backends splice it straight into a 32-bit immediate (`movq $TEXT` /
// `ldr x0, =TEXT` / `i32.const TEXT`) without a Fern-side parse — exactly as the
// AST backends do for `ExprNumber`. This is how HEX literals (`0x61626380`) and
// full-u32-range values (`0xffffffff`) load correctly: the assembler / wasm
// text parser handles the base and the unsigned range, where the IR's prior
// `util.digits_to_i32` (decimal-only) zeroed every hex literal.
pub function op_const_i32_text(t: string): Op {
    return Op { kind_tag: 2, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: t };
}
pub function op_const_i64(v: i64): Op {
    return Op { kind_tag: 3, i32_imm: 0, i64_imm: v, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
// int_extend widens an i32 to i64 (`as i64` / `as u64`); int_wrap narrows an
// i64 to i32 (`as i32` / `as u32`). `unsigned` picks zero- vs sign-extension on
// the register backends (wasm uses i64.extend_i32_s/u and i32.wrap_i64).
pub function op_int_extend(unsigned: boolean): Op { return Op { kind_tag: 7, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: unsigned, str: "" }; }
pub function op_int_wrap(unsigned: boolean): Op { return Op { kind_tag: 8, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: unsigned, str: "" }; }
// op_const_i64_text carries the literal's SOURCE TEXT (in `str`) rather than a
// parsed i64, so the backends can splice it straight into a 64-bit immediate
// (`movabsq $TEXT` / `ldr x0, =TEXT` / `i64.const TEXT`) without an i64
// parse+format round-trip. width=64 marks it an i64 value.
pub function op_const_i64_text(t: string): Op {
    return Op { kind_tag: 3, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: false, str: t };
}
pub function op_const_f64(v: f64): Op {
    return Op { kind_tag: 4, i32_imm: 0, i64_imm: 0, f64_imm: v, width: 0, unsigned: false, str: "" };
}
pub function op_const_str(s: string): Op {
    return Op { kind_tag: 5, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: s };
}
// op_const_func pushes a plain (capture-free) function VALUE — a function
// pointer. `str` carries the function's name; `i32_imm` is a table-index slot
// the backend fills (wasm resolves the name to its funcref-table index at emit
// time, so irlower can pass 0 here). The value is consumed by op_call_indirect.
pub function op_const_func(table_idx: i32, name: string): Op {
    return Op { kind_tag: 6, i32_imm: table_idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: name };
}

// locals
pub function op_load_local(idx: i32): Op {
    return Op { kind_tag: 18, i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_store_local(idx: i32): Op {
    return Op { kind_tag: 19, i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
pub function op_tee_local(idx: i32): Op {
    return Op { kind_tag: 20, i32_imm: idx, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}

// integer arithmetic / comparison (width selects i32 vs i64)
pub function op_bin(kind: string, width: i32, unsigned: boolean): Op {
    return Op { kind_tag: kind_id(kind), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: unsigned, str: "" };
}

// f64 arithmetic / comparison. `kind` is the float opcode ("fadd"/"fsub"/
// "fmul"/"fdiv" or a float compare "flt"/"fgt"/"fle"/"fge"/"feq"/"fne"); the
// operands flow on the rt-stack as their 8-byte IEEE bit pattern (like i64), so
// only the op differs from the integer path — the backend pops into float
// registers (xmm / d-regs / wasm f64). Arithmetic yields an f64; a compare
// yields an i32 0/1.
pub function op_fbin(kind: string): Op {
    return Op { kind_tag: kind_id(kind), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: false, str: "" };
}

// f64 unary math intrinsic. `kind` is the float opcode ("fsqrt"/"ffloor"/
// "fceil"/"ftrunc"/"fabs") for std/float's single-operand __*_f64 builtins.
// Like op_fbin the operand + result are f64 (one value popped, one pushed); each
// backend selects the single hardware instruction (sqrtsd / roundsd / and-mask
// on x86, fsqrt / frint* / fabs on arm64, f64.sqrt / floor / ceil / trunc / abs
// on wasm). Round-half-away (__round_f64) and the libm transcendentals
// (log/exp/sin/cos/pow) need multi-instruction emulation / external calls and
// stay on the AST path for now.
pub function op_funary(kind: string): Op {
    return Op { kind_tag: kind_id(kind), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: false, str: "" };
}

// f64 <-> i32 conversions. i32_to_f64 widens a signed i32 to f64 (cvtsi2sd /
// scvtf / f64.convert_i32_s); f64_to_i32 truncates an f64 toward zero to a
// signed i32 (cvttsd2si / fcvtzs / i32.trunc_f64_s). The value rides the stack
// as bits on the register backends; wasm's typed stack flips i32<->f64 here.
pub function op_i32_to_f64(): Op { return op0("i32_to_f64"); }
// int_to_f64 is op_i32_to_f64 carrying the operand's WIDTH and SIGNEDNESS, the
// pair EVERY backend needs. wasm's typed stack has four distinct opcodes
// (f64.convert_i{32,64}_{s,u}) and no way to pick between them without this, so
// an unsigned 32-bit value converted as signed (#5992), and a 64-bit one hit
// `f64.convert_i32_s` on an i64 operand and did not even validate. The register
// backends have only the SIGNED conversion of a 64-bit slot (cvtsi2sd %rax /
// scvtf d0, x0), which covers i32 / u32 / i64 — the 32-bit cases ride the slot
// correctly extended — but reads a u64 >= 2^63 as negative, so u64::MAX
// converted to -1.0 (#6051). Mirrors op_f64_to_u32 / op_f64_to_u64, which have
// carried `unsigned` since #4332.
pub function op_int_to_f64(width: i32, unsigned: boolean): Op {
    return Op { kind_tag: kind_id("i32_to_f64"), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: unsigned, str: "" };
}
pub function op_f64_to_i32(): Op { return op0("f64_to_i32"); }
// f64_to_i64 truncates an f64 toward zero to a signed i64 (cvttsd2si to a
// 64-bit reg / fcvtzs x / i64.trunc_f64_s). Distinct from f64_to_i32 only on
// wasm, where i32 and i64 are different value types; the register backends
// emit the same 64-bit-dest instruction for both.
pub function op_f64_to_i64(): Op { return op0("f64_to_i64"); }
// Unsigned truncation variants (#4332): the same kinds with `unsigned` set,
// mirroring native's op.Unsigned. Saturation covers the full unsigned range —
// NaN / negative -> 0, overflow -> u32::MAX / u64::MAX (arm64 fcvtzu, wasm
// i32/i64.trunc_sat_f64_u, x86 the ported compare-and-clamp shape).
pub function op_f64_to_u32(): Op {
    return Op { kind_tag: kind_id("f64_to_i32"), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: true, str: "" };
}
pub function op_f64_to_u64(): Op {
    return Op { kind_tag: kind_id("f64_to_i64"), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: true, str: "" };
}

// f64_bits / f64_from_bits — IEEE-754 bit reinterpret between an f64 and its
// i64 bit pattern. On the register backends the 8-byte rt-stack slot already
// holds the bits, so both are no-ops; wasm's typed stack needs a real
// `i64.reinterpret_f64` / `f64.reinterpret_i64`. f32_bits / f32_from_bits are
// the 32-bit pair: they additionally narrow (f64->f32) / widen (f32->f64),
// since the self-host stack carries every float as f64. f64_bits / f32_bits
// produce an integer (i64 / i32); f64_from_bits / f32_from_bits produce an f64.
pub function op_f64_bits(): Op { return op0("f64_bits"); }
pub function op_f64_from_bits(): Op { return op0("f64_from_bits"); }
pub function op_f32_bits(): Op { return op0("f32_bits"); }
pub function op_f32_from_bits(): Op { return op0("f32_from_bits"); }

// op_const_f64_text carries the float literal's SOURCE TEXT (in `str`) so the
// backends can hand it straight to the assembler (`.double TEXT` in .rodata /
// `f64.const TEXT`) without a float parse+format round-trip — mirroring
// op_const_i64_text. width=64 marks it a 64-bit (float) value.
pub function op_const_f64_text(t: string): Op {
    return Op { kind_tag: 4, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: false, str: t };
}

// memory: width carries 8/16/32/64 or width_ptr() for pointer-typed slots
pub function op_load(width: i32): Op {
    return Op { kind_tag: 67, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}
pub function op_store(width: i32): Op {
    return Op { kind_tag: 68, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}
pub function op_alloc(): Op { return op0("alloc"); }
// `ptr_width` pushes the target's heap-pointer width in BYTES — 8 on x86-64 /
// arm64, 4 on wasm32 — a backend-resolved constant (NOT a baked-in literal, which
// would corrupt wasm32 pointer arithmetic). Backs core/map's `__ptr_width()`.
pub function op_ptr_width(): Op { return op0("ptr_width"); }

// high-level array ops — layout-agnostic. The IR carries array SEMANTICS
// (make / index / index-store / length / refcount read), not a byte layout;
// each backend instruction-selects them into its OWN array memory layout
// (e.g. asm.fern's 8-byte `__fern_arr_box` rc/cap/len header vs the wasm
// linear-memory slab). This is what lets the
// production IR path emit asm.fern-compatible arrays without irlower baking
// a single layout into the op stream (the target-agnostic-IR discipline:
// layout lives in the backend, not the IR). `arr_make`'s i32_imm is the
// element count; it pops that many i32 values (element 0 deepest) and pushes
// the new array's data pointer. `arr_get` pops [base, idx] → element;
// `arr_set` pops [base, idx, val]; `arr_len` / `arr_rc` pop [base] → len / rc.
// `arr_make`'s `width` is the element slot width: 32 for i32 / wasm32-pointer
// elements (4-byte wasm stride) or 64 for f64 elements (8-byte wasm stride,
// f64.load/store). The register backends already use 8-byte slots regardless,
// so width only steers the wasm backend; `arr_get` / `arr_set` carry the same
// element width so they select the matching load/store on wasm.
pub function op_arr_make(n: i32, width: i32): Op {
    return Op { kind_tag: 87, i32_imm: n, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}
pub function op_arr_get(width: i32): Op { return Op { kind_tag: 88, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" }; }
// Unchecked `arr_get` (#4380 lever 3, self-host port): i32_imm == 1 flags a read
// the emitter has statically proven in bounds — the foreach counted loops, whose
// `idx < arr_len` guard runs immediately before the read every iteration. The
// x86 backend skips the bounds compare + oob trap for it; arm64 / wasm read only
// kind_tag and keep their checks (a safe no-op there until they honour the flag).
pub function op_arr_get_nc(width: i32): Op { return Op { kind_tag: 88, i32_imm: 1, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" }; }
pub function op_arr_set(width: i32): Op { return Op { kind_tag: 89, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" }; }
// i64-element array ops: an 8-byte stride like f64, but the wasm backend uses
// i64.load / i64.store (an INTEGER 8-byte slot) instead of f64.load/store. The
// `unsigned` flag carries that "8-byte element is i64, not f64" distinction
// (width 64 + unsigned => i64; width 64 + !unsigned => f64). The register
// backends move 8-byte slots regardless and ignore it.
pub function op_arr_make_i64(n: i32): Op {
    return Op { kind_tag: 87, i32_imm: n, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: true, str: "" };
}
pub function op_arr_get_i64(): Op { return Op { kind_tag: 88, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: true, str: "" }; }
// Unchecked 8-byte `arr_get` (i64/u64 element) — the i64 sibling of op_arr_get_nc.
pub function op_arr_get_i64_nc(): Op { return Op { kind_tag: 88, i32_imm: 1, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: true, str: "" }; }
pub function op_arr_set_i64(): Op { return Op { kind_tag: 89, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 64, unsigned: true, str: "" }; }
pub function op_arr_len(): Op { return op0("arr_len"); }
pub function op_arr_rc(): Op { return op0("arr_rc"); }
// `arr_push` pops [arr, val] → a (possibly grown) array with `val` appended via
// __fern_arr_push (the helper the AST `.append` and the map runtime use).
// Lowered from a reassign-self `a = a.append(v)`; the result re-binds the slot.
pub function op_arr_push(): Op { return op0("arr_push"); }

// `arr_push_owned` is `arr_push` for a self-reassign `a = a.append(v)` where the
// target `a` is the SOLE owner of its buffer (not in aliased_names). It lowers to
// __fern_arr_push_owned, which behaves exactly like __fern_arr_push but, when the
// push GROWS (reallocs into a new buffer), reclaims the old buffer instead of
// leaking it. Sound only because the !aliased gate proves no other reference to
// the old buffer survives — a borrow-form append (where the owner keeps the
// buffer) must NOT use this op (see asm_ir.fern's .Larr_push_grow note). Closes
// the dominant self-host-emitted leak that OOMed the per-module self-compile of
// the large modules (#3452 / #3425). Register-backend only difference from
// arr_push is the helper called; element width is unchanged (8-byte slot).
pub function op_arr_push_owned(): Op { return op0("arr_push_owned"); }

// `arr_push_i64` is `arr_push` for an 8-byte-element array (i64[] / u64[]): the
// value is an i64 (i64.store / 8-byte slot). On the register backends every
// array slot is already 8 bytes, so this reuses __fern_arr_push; on wasm32,
// where i32[] packs 4-byte slots, it lowers to the 8-byte-stride
// $__fern_arr_push_i64. Lowered from `a = a.append(v)` on a u64[] / i64[].
pub function op_arr_push_i64(): Op { return op0("arr_push_i64"); }

// `arr_push_f64` is `arr_push` for an f64[] (8-byte float element): the value
// is an f64 (f64.store / 8-byte slot). On the register backends every array
// slot is already 8 bytes and the f64 value rides the value stack as raw 8
// bytes, so this reuses __fern_arr_push exactly like arr_push_i64; on wasm32
// the operand stack is typed, so it lowers to the 8-byte-stride
// $__fern_arr_push_f64. Lowered from `a = a.append(v)` on an f64[].
pub function op_arr_push_f64(): Op { return op0("arr_push_f64"); }
// `alloc_u8` pops [n] → a fresh n-element array (8-byte slots, len = n) via
// __fern_alloc_u8 (the `__alloc_u8(n)` byte-buffer builtin). Contents are NOT
// zeroed (a reused freelist block keeps stale bytes — callers zero explicitly).
pub function op_alloc_u8(): Op { return op0("alloc_u8"); }
// `str_from_bytes` pops [arr] → a fresh string box packing each slot's low byte
// via __fern_string_from_bytes (the `string_from_bytes_unchecked(arr)` builtin).
pub function op_str_from_bytes(): Op { return op0("str_from_bytes"); }
// `memcpy` pops [dst, src, n] (raw usize pointers + a byte count) → copies n
// bytes src→dst and pushes a dummy 0 (the `__memcpy(dst, src, n)` builtin is
// used statement-position, its value discarded). x86-64 emits `rep movsb`,
// arm64 a byte-copy loop, wasm `memory.copy` — matching the AST emitters. This
// is what lets core/int's int_to_string / __int_to_string_u64 (and everything
// transitively calling them) lower on the IR path instead of BAIL call.
pub function op_memcpy(): Op { return op0("memcpy"); }
// `memset` pops a byte-count n, a fill byte, and a usize dest (push order
// dest,byte,n) and fills n bytes at dest with the low byte of `byte`, pushing a
// dummy 0 (statement-position, discarded). Backs core/map's __memset; the IR
// backends select rep stosb / a byte loop / memory.fill.
pub function op_memset(): Op { return op0("memset"); }
// `free` pops a usize ptr and an i32 size (core/map's __free) and does nothing
// under the bump/leak heap, pushing a dummy 0. A stack-balancing no-op.
pub function op_free(): Op { return op0("free"); }
// Raw-memory load/store intrinsics — the `__load_i32` / `__load_i64` /
// `__load_ptr` / `__store_i32` / `__store_ptr` builtins the core/map runtime
// uses to read/write its packed entry buffer. The AST backends emit these as
// __fn___load_* runtime helper CALLS; the IR path inlines them as single
// load/store instructions (the IR sibling of arr_get/arr_set, but at a raw
// usize address rather than an array slot). Loads pop [addr] and push the
// value; stores pop [addr, val] and push a dummy 0 (used statement-position,
// discarded). i32 loads sign-extend (movslq); ptr is heap-pointer-width
// (8 bytes on x86-64/arm64, 4 on wasm32). Unblocks core/map's __map_hash /
// __map_dec_value (and the wider Map subsystem) on the IR path.
pub function op_load_i32(): Op { return op0("load_i32"); }
pub function op_load_i64(): Op { return op0("load_i64"); }
pub function op_load_ptr(): Op { return op0("load_ptr"); }
pub function op_store_i32(): Op { return op0("store_i32"); }
// op_store_i64 writes an 8-byte i64 to a raw usize address (the store sibling
// of op_load_i64). Pops [addr, val] and pushes a dummy 0 (statement-position,
// discarded), like store_i32/store_ptr — but stores the full 64-bit width.
// Backs __store_i64, which was asymmetric with __load_i64 (#4375 item 2).
pub function op_store_i64(): Op { return op0("store_i64"); }
pub function op_store_ptr(): Op { return op0("store_ptr"); }
// `int_cast` masks / extends a 32-bit integer to a narrower int type's range:
// `as u8` (and 255), `as i32` (sign-extend low 32 — movslq), `as u32`
// (zero-extend low 32 — movl).
// The target type name rides `str`. Mirrors the retired x86 AST emitter's `as_<ty>` int→int masking.
pub function op_int_cast(ty: string): Op { return Op { kind_tag: 9, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: ty }; }
// `u32_wrap` reduces a value on the operand stack to its u32 range (zero-extend
// low 32 bits). Emitted after a u32 arithmetic op (add/sub/mul/shl) on the
// 64-bit REGISTER backends so u32 semantics wrap at 2^32 like native (and like
// wasm's native 32-bit i32 ops); on wasm it is a no-op (the value is already a
// 32-bit i32). This is what makes u32-heavy code (std/crypto's SHA-256) correct.
pub function op_u32_wrap(): Op { return op0("u32_wrap"); }

// high-level string ops — layout-agnostic, like the array ops. The IR carries
// string SEMANTICS (length read, concat, equality); each backend selects its
// own string box layout (asm.fern's 16-byte `[data@0, len@8]` heap box, wasm's
// `[len@0, bytes@4]` data-section block). `const_str` (see op_const_str) pushes
// a string value; `str_len` pops [str] → length; `str_concat` pops [a, b] → the
// concatenated string (a fresh box); `str_eq` pops [a, b] → 1 if byte-equal
// else 0. Strings are NOT reference-counted (they leak, matching asm.fern's AST
// path — fine for short-lived CLI / edge programs), so no RC ops accompany them.
pub function op_str_len(): Op { return op0("str_len"); }
pub function op_str_concat(): Op { return op0("str_concat"); }
pub function op_str_eq(): Op { return op0("str_eq"); }
// `str_cmp` pops [a, b] → a signed i32: <0 if a<b, 0 if equal, >0 if a>b
// (lexicographic byte compare, length tiebreak). Ordering compares (< <= > >=)
// lower to str_cmp followed by the relational op against 0.
pub function op_str_cmp(): Op { return op0("str_cmp"); }
// `str_index` pops [str, i] → the i32 byte value at index i (`s[i]`). Each
// backend reads the byte from its own string layout (x86/arm64 16-byte box
// [data@0,len@8] → byte at [data+i]; wasm data-section [len@0,bytes@4] → byte at
// [s+4+i]). No bounds check (matches the AST path).
pub function op_str_index(): Op { return op0("str_index"); }
// `str_slice` pops [str, start, end] → a fresh string for `s[start:end]`. On
// x86/arm64 this is a zero-copy VIEW: a new 16-byte box [data = src.data+start,
// len = end-start] sharing the source bytes. On wasm, strings are inline blocks
// (no separate data pointer), so it COPIES via $__fern_substr. Bounds-checked at
// construction (#5419): traps unless 0 <= start <= end <= len.
pub function op_str_slice(): Op { return op0("str_slice"); }
// op_str_slice_frame is `str_slice` with its 24-byte view box taken from the
// FRAME instead of the heap (#6713): `i32_imm` is `base + 1`, where base is the
// first of three consecutive local slots reserved for the box, so 0 keeps the
// heap form. Same layout, same rc=-1 immortal sentinel, same operands — only the
// storage differs, so every consumer of the pushed box is unchanged. The
// register backends read the immediate; wasm ignores it (its str_slice copies
// into a fresh inline block, so there is no box to place). irlower emits this
// form only for a view whose whole life is inside the frame that made it.
pub function op_str_slice_frame(base: i32): Op {
    return Op { kind_tag: 102, i32_imm: base + 1, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
// `arr_slice` pops [arr, start, end] → a fresh array holding arr[start:end]
// (end exclusive), COPYING the 8-byte (x86/arm64) / 4-byte (wasm) element
// payloads via __fern_arr_slice. Bounds-checked at construction (#5419):
// traps unless 0 <= start <= end <= len.
// `arr_slice`'s `width` is the element width (32 for i32 / wasm32-pointer
// elements, 64 for f64): the wasm backend selects the 4-byte or 8-byte copy
// helper. The register backends copy 8-byte slots regardless and ignore it.
pub function op_arr_slice(width: i32): Op { return Op { kind_tag: 96, i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" }; }

// op_arr_reverse / op_arr_concat back the builtin `xs.reverse()` / `xs.concat(ys)`
// on arrays: a FRESH array with the elements copied (reversed, or A-then-B).
// Both are backed by the same __fern_arr_reverse / __fern_arr_concat runtime
// helpers the AST emitters call, so the IR path produces the identical answer;
// wasm serves them with WAT twins. Modelled on op_arr_slice — the other
// fresh-array-from-elements op — and, like it, the copy is a raw slot move: an
// rc-tracked element is NOT retained, matching arr_slice and both AST emitters.
// f64[] / i64[] receivers are excluded at the lowering, so the copy is always
// the natural pointer/i32 slot width and no width flag is needed.
pub function op_arr_reverse(): Op { return op0("arr_reverse"); }
pub function op_arr_concat(): Op { return op0("arr_concat"); }

// Raw-memory intrinsics (issue #2649, Tier-2 floor — see docs/RUNTIME-INTRINSICS.md).
// Unsafe, unchecked, `__`-prefixed; only the audited Tier-2 runtime helpers use
// them. Each lowers to a SINGLE instruction (or one __fern_alloc call), so they
// add no runtime symbol. Pointers are machine words carried as i32 at the source
// surface; the register backends use the native 8-byte width.
//   raw_alloc   pops [n]            → ptr (call __fern_alloc)
//   raw_store8  pops [ptr, off, v]  → v   (movb low byte of v to [ptr+off])
//   raw_load8   pops [ptr, off]     → zero-extended byte at [ptr+off]
//   raw_store_ptr pops [ptr, off, v]→ v   (store word slot at [ptr+off*W])
//   raw_load_ptr  pops [ptr, off]   → word slot at [ptr+off*W]
//   raw_string  pops [data, len]    → a fresh 16-byte string box {data, len}
// The stores push v back (a value, not void) so the operand stack stays balanced
// with the "every expr pushes one value" invariant; statement position drops it.
pub function op_raw_alloc(): Op { return op0("raw_alloc"); }
pub function op_raw_store8(): Op { return op0("raw_store8"); }
pub function op_raw_load8(): Op { return op0("raw_load8"); }
pub function op_raw_store_ptr(): Op { return op0("raw_store_ptr"); }
pub function op_raw_load_ptr(): Op { return op0("raw_load_ptr"); }
pub function op_raw_string(): Op { return op0("raw_string"); }
// syscall3 (#2649 syscall sub-floor): the raw-memory floor's I/O sibling.
//   syscall3 pops [nr, a1, a2, a3] → the syscall return value.
// Lowers to a single `syscall`/`svc` (nr→%rax/x8, a1..a3→argregs), no runtime
// symbol — the primitive the syscall-leaf helpers (random_bytes, the clocks,
// read_file) are written against so they can move off hand-asm into Fern.
// Unsafe / unchecked / `__`-prefixed, like the `__raw_*` intrinsics.
pub function op_syscall3(): Op { return op0("syscall3"); }
// raw_scratch (#2649 syscall sub-floor, clocks slice): pops [n] → a fixed
// static (.bss) scratch buffer ptr — the buffer the syscall leaves hand the
// kernel to write into (timespec, stat), reused/never-freed so no per-call leak
// (the hand-asm used a stack buffer). `n` is a size hint; the buffer is fixed.
// Non-reentrant: a leaf helper must finish reading it before another runs.
// (The i64 read-back of tv_sec/tv_nsec reuses the existing __load_i64/op_load_i64.)
pub function op_raw_scratch(): Op { return op0("raw_scratch"); }
// syscall4 (#2649 syscall sub-floor): the 4-arg sibling of syscall3, for the
// syscalls whose 4th arg is meaningful (openat's mode with O_CREAT, newfstatat's
// flags). pops [nr, a1, a2, a3, a4] → the syscall return value; a4 → %r10.
pub function op_syscall4(): Op { return op0("syscall4"); }
// raw_environ (#2649 syscall sub-floor, env slice): pops nothing → the process
// envp pointer (the `char **` the kernel handed _start, saved in __fern_envp).
// A single `movq __fern_envp(%rip), %rax`. The env leaf walks the array from it.
pub function op_raw_environ(): Op { return op0("raw_environ"); }
// syscall5 (#2649 syscall sub-floor): the 5-arg sibling. Three helpers need it
// and none can be reached without it — arm64 Linux has no `poll` or `fork`, only
// `ppoll` and `clone`, and XNU has no `nanosleep`, only `select`. All three take
// five arguments. pops [nr, a1..a5] → the syscall return value; a5 → %r8 / x4.
pub function op_syscall5(): Op { return op0("syscall5"); }
// raw_addr (#2649 raw-memory floor): pops [ptr, off] → ptr + off, computed at
// the machine's FULL pointer width. It exists because `p + off` written in the
// helper source does not survive: the surface type of a raw pointer is i32, so
// the arm64 backend sign-extends the sum back to 32 bits (`sxtw x0, w0`) and a
// high heap address comes out truncated. The TWO-ARGUMENT raw load/stores
// (raw_load8 / raw_store8 / raw_load_ptr / raw_store_ptr) dodge this by folding
// their `off` operand into the addressing mode. Everything else needs this op:
// a pointer PASSED somewhere (a syscall buffer arg), and — the trap #6386 fell
// into — the ONE-argument loads, `__load_i32(a)` / `__load_i64(a)` /
// `__load_ptr(a)`, which have no offset operand to fold, so their caller must
// not reach for a bare `a + off`.
pub function op_raw_addr(): Op { return op0("raw_addr"); }
// raw_arr_box (#2649 raw-memory floor): pops [n] → the DATA pointer of a fresh
// n-element array box, with the rc header, length and capacity already written
// (a `call __fern_arr_box`, the one array primitive that stays asm — the same
// role __raw_alloc plays for bytes). Element i lives at [ptr + (i+1)*W], which
// is exactly what __raw_store_ptr / __raw_load_ptr address, so a Fern helper can
// fill it without naming the layout. Its sibling __raw_array(ptr) is type-only
// — the pointer already IS the array value — so it emits no op at all.
pub function op_raw_arr_box(): Op { return op0("raw_arr_box"); }

// memchr (docs/ATLAS-PLATFORM-PLAN.md §3): pops [str, byte, from] → the i32
// index of the first occurrence of `byte` at or after `from`, or -1. Allocates
// nothing and reads only the source bytes.
//
// It is an OP rather than a Fern function for one reason: an op is what a
// backend can SUBSTITUTE. The native backends replace it with a 16-byte-per-
// iteration vector kernel (SSE2 / NEON / v128); the self-host backends serve
// the scalar meaning, which is the §3.4 ordering — the intrinsic becomes
// TOTAL before anything depends on it being fast.
//
// `from` clamps (negative behaves as 0, past-the-end finds nothing) and a
// byte outside 0..255 never matches, matching the interpreter reference.
pub function op_memchr(): Op { return op0("memchr"); }

// ascii_run (docs/ATLAS-PLATFORM-PLAN.md §3, second kernel): pops [str, from]
// → the i32 index of the first byte at or after `from` whose high bit is set,
// or the string's length if the rest is ASCII. Allocates nothing and reads only
// the source bytes.
//
// An op for op_memchr's reason — an op is what a backend can SUBSTITUTE — and
// the substitution here is unusually lopsided, which is why it earns a second
// kernel at all. The vector form needs no splat and, on x86-64 and wasm, no
// compare either: pmovmskb / i8x16.bitmask gather the top bit of each byte,
// which IS the question. arm64 pays for one compare (cmlt … #0) because NEON
// has no bitmask. The self-host backends serve the scalar meaning, per §3.4:
// total before fast.
//
// Note the miss value is the LENGTH, not -1. That breaks with memchr's
// convention deliberately — the caller is a validator advancing a cursor, so
// `i = __ascii_run(s, i)` has to be a branch-free skip.
pub function op_ascii_run(): Op { return op0("ascii_run"); }

// Random / byte-source builtins (issue #2747) — the cross-backend byte source
// uuid (#2682) and a future std/crypto build on. Each lowers to a runtime
// helper the IR backends emit (no `__fn_` body), so the eligibility gate treats
// them as known ops rather than disqualifying call_directs.
//
// `random_bytes` pops [n] → a fresh string of n cryptographic-quality random
// bytes (Linux getrandom / WASI random_get). Result is a string box; the bytes
// have no encoding, so `s[i]` reads a 0..255 value (str_index).
pub function op_random_bytes(): Op { return op0("random_bytes"); }
// `random_i32` takes no operands → a single CSPRNG i32. A 4-byte random read
// reinterpreted as an i32 (cheaper than random_bytes for one small value).
pub function op_random_i32(): Op { return op0("random_i32"); }
// `monotonic_ns` / `now_unix_ms` take no operands → an i64 clock reading.
// monotonic_ns is a monotonically non-decreasing nanosecond counter (elapsed
// timing); now_unix_ms is wall-clock milliseconds since the Unix epoch. Both
// reinterpret a `clock_gettime` timespec; the IR backends emit the
// __fern_monotonic_ns / __fern_now_unix_ms helpers (no allocation).
pub function op_monotonic_ns(): Op { return op0("monotonic_ns"); }
pub function op_now_unix_ms(): Op { return op0("now_unix_ms"); }
// `now_ns` — wall-clock nanoseconds since the Unix epoch (the i64 nanosecond
// twin of now_unix_ms); 0-arg, allocation-free. Lowers to __fern_now_ns.
pub function op_now_ns(): Op { return op0("now_ns"); }
// `poll` takes two operands [fds, timeout_ms] (fds an i32[] box pointer, timeout
// an i32) and pushes the i32 index of the first ready fd, or -1. Lowers to the
// __fern_poll runtime helper (poll(2) over the fd set) — the self-host twin of
// the native `poll` builtin. See docs/ASYNC-SELFHOST-IR.md.
pub function op_poll(): Op { return op0("poll"); }
// `timer_fd` takes one operand [ms] and pushes an i32: a CLOCK_MONOTONIC
// one-shot timerfd readable after `ms` ms (or -errno). Lowers to __fern_timer_fd.
pub function op_timer_fd(): Op { return op0("timer_fd"); }
// `wasm_timer_pollable` takes one operand [ns] and pushes an i32. On native it
// is -1 (no pollable; deadlines ride poll(2)'s timeout arg); on wasm it is a
// real wasi timer pollable. Portability shim for std/async's with_deadline.
pub function op_wasm_timer_pollable(): Op { return op0("wasm_timer_pollable"); }
// `wasm_pollable_drop` takes one operand [p] and pushes an i32 (0 on native — a
// pollable is just an fd, nothing to drop). Portability shim for fetch_future.
pub function op_wasm_pollable_drop(): Op { return op0("wasm_pollable_drop"); }
// `wasm_block` takes one operand [p] and pushes an i32 (always 0). On wasm it
// synchronously waits until the pollable is ready (wasi:io/poll
// [method]pollable.block), the primitive that makes wasm_timer_pollable
// observably block; on native there is no pollable (deadlines ride poll(2)), so
// it is a 0 no-op. Portability shim for the wasm reactor's with_deadline.
pub function op_wasm_block(): Op { return op0("wasm_block"); }
// `wasm_poll` takes one operand [pollables array ptr] and pushes an i32: the
// index of the first ready pollable, or -1 if none. On native there are no real
// pollables (readiness rides poll(2) directly), so it is -1; on wasm it is the
// real wasi:io/poll.poll(list<pollable>) readiness multiplexer. The wasm
// reactor's poll — the pollable-array analog of the native poll(fds).
pub function op_wasm_poll(): Op { return op0("wasm_poll"); }
// tcp_* client primitives (the self-host twins of the native socket builtins).
// `tcp_connect` [host_be, port] -> i32 connected fd (or -errno); host_be is the
// IPv4 in network byte order packed into an i32. `tcp_send` [fd, str box] -> i32
// bytes written (or -errno). `tcp_recv` [fd, max] -> a string box (data, len) of
// up to `max` bytes; allocates. `tcp_close` [fd] -> i32 0/-errno. `tcp_pollable`
// [fd] -> i32: the readiness token (the fd itself on native). All lower to the
// matching __fern_tcp_* runtime helper. See docs/ASYNC-SELFHOST-IR.md.
pub function op_tcp_connect(): Op { return op0("tcp_connect"); }
pub function op_tcp_send(): Op { return op0("tcp_send"); }
pub function op_tcp_recv(): Op { return op0("tcp_recv"); }
pub function op_tcp_close(): Op { return op0("tcp_close"); }
pub function op_udp_send(): Op { return op0("udp_send"); }
pub function op_tcp_pollable(): Op { return op0("tcp_pollable"); }
// `tcp_listen` [port] -> i32 listener fd (or -errno): socket + bind to
// 0.0.0.0:port + listen. `tcp_accept` [fd] -> i32 connection fd (or -errno):
// accept(2) on a listener. The server half of the edge-handler use case
// (#4371); the client ops above are the outbound-fetch half.
pub function op_tcp_listen(): Op { return op0("tcp_listen"); }
pub function op_tcp_accept(): Op { return op0("tcp_accept"); }
// `writer_write` [fd, str box] -> i32 bytes written (or -errno): write(2) of the
// box's bytes to the fd. The write-half streaming primitive (#4372); a Writer is
// a bare fd (like a Reader — see op_read_chunk). `stdout()`/`stderr()` lower to
// the i32 constants 1/2 directly (no op); `Writer.close()` reuses op_reader_close.
pub function op_writer_write(): Op { return op0("writer_write"); }
// `open_file` [path box] -> i32 fd (or -errno): NUL-terminate the path and
// openat(AT_FDCWD, path, flags, 0644). `flags` is baked into the immediate so
// one op covers open_reader (O_RDONLY=0), open_writer (O_WRONLY|O_CREAT|O_TRUNC
// =577) and open_appender (O_WRONLY|O_CREAT|O_APPEND=1089) — the file half of
// the streaming Reader/Writer surface (#4372).
pub function op_open_file(flags: i32): Op {
    return Op { kind_tag: kind_id("open_file"), i32_imm: flags, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" };
}
// `__heap_bump_bytes` takes no operands → an i64: the bump allocator's
// high-water mark (cursor − region base; 0 before the first allocation). It
// reads the heap runtime's cursor + base — so it does NOT allocate, but it
// DOES need the heap runtime present (op_allocates admits it for the gate). The
// register backends compute cursor − base inline (base recovered as
// __fern_heap_end − heap_size on both x86 and arm64, since each mmap's its
// arena and records the end); wasm reads `$heap − heap_base` and zero-extends
// it to the declared i64. Mirrors native's __fern_heap_bump_bytes.
pub function op_heap_bump_bytes(): Op { return op0("heap_bump_bytes"); }
// `__heap_mark` takes no operands -> an i64 arena checkpoint; `__heap_release_to`
// pops that i64 and rewinds the cursor to it (#6728). A one-level checkpoint on a
// bump arena that otherwise never gives memory back — the pair exists for the
// per-module emit, whose per-unit accumulation walks off the end of the arena.
// Both are INLINE on the register backends for heap_bump_bytes's reason: they read
// and write the arena globals directly, so a call would only add an ABI. wasm
// lowers neither — its linear-memory allocator has no room for the freelist
// shadow, and the capability layer refuses `arena` there (E066) before lowering.
pub function op_heap_mark(): Op { return op0("heap_mark"); }
pub function op_heap_release_to(): Op { return op0("heap_release_to"); }
// Bit counting (#6197): one integer operand of `width` (32 or 64) → an i32
// count. clz/ctz of ZERO are defined as the width, matching wasm's semantics
// and the SWAR sequences these replace — that definition is why the x86-64
// lowering cannot use a bare bsr/bsf, whose result is undefined at zero.
pub function op_clz(width: i32): Op {
    return Op { kind_tag: kind_id("clz"), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}
pub function op_ctz(width: i32): Op {
    return Op { kind_tag: kind_id("ctz"), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}
pub function op_popcount(width: i32): Op {
    return Op { kind_tag: kind_id("popcount"), i32_imm: 0, i64_imm: 0, f64_imm: 0.0, width: width, unsigned: false, str: "" };
}
// `__arr_push_shared_count` takes no operands → an i32: the number of appends
// that copied a buffer which still had SPARE CAPACITY, i.e. the copy was bought
// by an extra reference rather than by a full buffer. `__fern_arr_push` mutates
// in place only at rc == 1, so that threshold is a performance-correctness
// boundary with no diagnostic of its own — one stray retain upstream turns a
// threaded accumulator from O(n) into O(n²) while the program stays correct.
// 0 on a healthy run, which is what makes it usable as an assertion. Like
// heap_bump_bytes it reads a runtime store rather than allocating (op_allocates
// admits it so an introspection-only module still emits the heap runtime): the
// register backends read the `__fern_arr_push_shared` word, wasm a fixed
// low-memory slot. Mirrors native's __fern_arr_push_shared_count.
pub function op_arr_push_shared_count(): Op { return op0("arr_push_shared_count"); }
// `__arr_push_shared_bytes` takes no operands → an i64: the same cliff the
// counter above counts, WEIGHTED by the bytes each crossing copied (oldLen *
// stride, summed). The count says whether anything crossed; only the weight
// says whether it mattered, and the two readings differ by three orders of
// magnitude on real runs — a whole-module compile of checker.fern crosses 188
// times and copies 812 bytes doing it (4-byte loop-depth stacks), while one
// threaded accumulator over 20k appends copies 2.3 GB. i64 because the
// quantity is arena-scale. Same runtime-store read as its sibling (op_allocates
// admits it for the heap-runtime gate): the register backends read the
// `__fern_arr_push_copied` word, wasm a fixed low-memory slot. Mirrors
// native's __fern_arr_push_shared_bytes.
pub function op_arr_push_shared_bytes(): Op { return op0("arr_push_shared_bytes"); }
// `__map_hash_seed` takes no operands → an i32: core/map's per-process
// string-hash seed, mixed into its FNV basis so attacker-supplied key strings
// cannot be precomputed into a colliding set offline (#6194). Drawn once from
// the same CSPRNG as random_i32 and cached in a runtime word, so every map
// after the first pays a load rather than a syscall. Never 0 — that is
// core/map's "unseeded" sentinel, and a 0 reaching a map header would leave
// that map unseeded.
//
// The self-host's own `Map[K, V]` lowers to the native `__fern_map_*` runtime
// rather than to core/map's Fern bodies, so this op exists for those bodies to
// COMPILE and LINK (see the `core/map` note in each backend's intrinsic
// section) — the seed it returns is not what a self-host-compiled program's
// maps hash with. Seeding the self-host map runtime is separate work.
pub function op_map_hash_seed(): Op { return op0("map_hash_seed"); }
// `str_bytes` pops [str] → a fresh u8[] (one i32 slot per byte). Backs both
// `s.bytes()` (copying) and `s.as_bytes()` — the self-host's slot-array model
// has no separate zero-copy slice view, so as_bytes returns the same fresh
// array (correct, just not zero-copy; mirrors the AST path).
pub function op_str_bytes(): Op { return op0("str_bytes"); }
// `str_starts_with` / `str_ends_with` pop [s, p] → i32 1/0 (whether `s` begins
// / ends with `p`; empty `p` → 1). `str_index_of` pops [s, sub] → the first
// byte index of `sub` in `s`, or -1 (empty `sub` → 0). All three are scalar,
// allocation-free string predicates backed by the __fern_str_* search runtime;
// `s.contains(sub)` lowers as `str_index_of(...) >= 0` (no dedicated op).
// `str_to_upper` / `str_to_lower` pop [s] → a fresh string box that is `s` with
// each ASCII letter cased up / down (non-letters copied verbatim). They allocate
// the new char buffer + box, so they pull in the heap runtime; leak-only (no RC).
pub function op_str_to_upper(): Op { return op0("str_to_upper"); }
pub function op_str_to_lower(): Op { return op0("str_to_lower"); }
// `str_repeat` pops [s, n] → a fresh string box holding `s` concatenated `n`
// times (n <= 0 → empty). Allocates the n*len buffer + box; leak-only.
pub function op_str_repeat(): Op { return op0("str_repeat"); }
// `str_trim` pops [s] → a fresh string box with leading/trailing ASCII
// whitespace (space / tab / '\n' / '\r') removed. Leak-only.
pub function op_str_trim(): Op { return op0("str_trim"); }
// `str_reverse` pops [s] → a fresh string box with `s`'s bytes in reverse
// order. Leak-only.
pub function op_str_reverse(): Op { return op0("str_reverse"); }
// `str_replace` pops [haystack, old, new] → a fresh string box with every
// (non-overlapping) occurrence of `old` in `haystack` replaced by `new`. An
// empty `old`, or no match, returns `haystack` unchanged. Leak-only.
pub function op_str_replace(): Op { return op0("str_replace"); }
// `str_chars` pops [s] → a fresh string[] whose i-th element is the 1-char
// string s[i:i+1]. Result is is_arr + is_strarr (like str_split). Leak-only.
pub function op_str_chars(): Op { return op0("str_chars"); }
// `str_lines` pops [s] → a fresh string[] of s split on newline, with a
// trailing empty segment dropped when s is empty or ends with a newline (so
// "a\nb\n" is 2 lines, not 3 — matching Rust/Python). is_arr + is_strarr.
pub function op_str_lines(): Op { return op0("str_lines"); }
pub function op_str_starts_with(): Op { return op0("str_starts_with"); }
pub function op_str_ends_with(): Op { return op0("str_ends_with"); }
pub function op_str_index_of(): Op { return op0("str_index_of"); }
// `str_split` pops [haystack, sep] → a fresh string[] of the segments of
// `haystack` split on `sep`. An empty separator yields a single-element
// `[haystack]`. Backs both the `s.split(sep)` method and the `str_split(s, sep)`
// free call. The result array is RC-tracked; the segment string boxes leak
// (mirrors the AST path's __fern_str_split).
pub function op_str_split(): Op { return op0("str_split"); }

// Built-in Option / Result ops. The value is a heap box [tag@0, payload@8]
// (Some/Ok = tag 0, None/Err = tag 1) — distinct from user enums/structs, which
// carry a shape pointer at offset 0. `opt_make` pops [payload] and builds the
// box with `i32_imm` as the tag (Some/Ok=0, Err=1); `opt_none` builds a
// payloadless box with tag 1; `opt_tag` pops [box] → the i32 tag at offset 0
// (drives Some/None/Ok/Err discrimination in match).
pub function op_opt_make(tag: i32): Op { return Op { kind_tag: 120, i32_imm: tag, i64_imm: 0, f64_imm: 0.0, width: 0, unsigned: false, str: "" }; }
