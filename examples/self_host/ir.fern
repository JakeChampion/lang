    if (name == "wasm_poll") { return 192; }
    if (name == "tcp_connect") { return 193; }
    if (name == "tcp_send") { return 194; }
    if (name == "tcp_recv") { return 195; }
    if (name == "tcp_close") { return 196; }
    if (name == "tcp_pollable") { return 197; }
    // Extension tags beyond kind_count() (like struct_copy=198 / store_i64=199):
    // the server-half tcp ops (#4371). Not in the 1..kind_count() bijection
    // sweep (ir_kind_run sweeps them separately by name), but nameable so
    // module_emits_op_cached / the backends see them.
    if (name == "tcp_listen") { return 200; }
    if (name == "tcp_accept") { return 201; }
    if (name == "writer_write") { return 202; }
    if (name == "open_file") { return 203; }
    if (name == "syscall3") { return 204; }
    if (name == "raw_scratch") { return 205; }
    if (name == "syscall4") { return 206; }
    if (name == "raw_environ") { return 207; }
    // udp_send(host, port, data): one-shot fire-and-forget datagram (#4375).
    if (name == "udp_send") { return 208; }
    if (name == "read_all_stdin") { return 209; }
    if (name == "arg_at") { return 210; }
    // Crash-only supervision (#5686): fork / reap.
    if (name == "proc_fork") { return 211; }
    if (name == "proc_waitpid") { return 212; }
    if (name == "proc_exec") { return 213; }
    // Builtin fresh-array builders (#3457): xs.reverse() / xs.concat(ys).
    if (name == "arr_reverse") { return 214; }
    if (name == "arr_concat") { return 215; }
    if (name == "arr_push_shared_count") { return 216; }
    if (name == "arr_push_shared_bytes") { return 217; }
    // Static aggregate constant (#6149) — struct_make with every field a
    // compile-time scalar literal, placed in data rather than allocated.
    if (name == "const_struct") { return 218; }
    // Bit-counting intrinsics (#6197). One op each, `width` (32/64) picking
    // the operand width; every one produces an i32 count.
    if (name == "clz") { return 219; }
    if (name == "ctz") { return 220; }
    if (name == "popcount") { return 221; }
    if (name == "map_hash_seed") { return 222; }
    if (name == "raw_addr") { return 223; }
    if (name == "raw_arr_box") { return 224; }
    if (name == "memchr") { return 225; }
    if (name == "write_file_exec") { return 226; }
    if (name == "ascii_run") { return 227; }
    if (name == "syscall5") { return 228; }
    // NEXT FREE EXTENSION ID: 232 (heap_mark=229, heap_release_to=230 and
    // create_dir_all=231 are taken below / above).
    // ADDING AN EXTENSION TAG: take the next id here AND register it in
    // kind_name + ir_kind_run's two sweep lists, then re-grep the whole tree
    // for the number you took. Two branches that each claim "the next free
    // id" MERGE CLEANLY — memchr and raw_arr_box both landed on 224, and git
    // conflicted only this file and the sweep lists. The three backends
    // auto-merged into two `kind_tag == 224` arms apiece, first-one-wins,
    // which builds and silently aliases the two ops. The registry golden is
    // the only gate that catches it, and only if BOTH names survive the
    // merge. It has now happened TWICE on the same pair of branches:
    // write_file_exec moved 224 -> 225 -> 226 as raw_arr_box then memchr
    // landed underneath it.
    return 0;
}

// kind_id maps an op-kind tag to its stable integer id (0 = KIND_INVALID for
// an unknown tag). The inverse of kind_name. Each chunk returns 0 for "not
// mine", so the first non-zero wins and an unknown tag falls through to 0.
pub function kind_id(name: string): i32 {
    var r: i32 = 0;
    r = kind_id_0(name); if (r != 0) { return r; }
    r = kind_id_1(name); if (r != 0) { return r; }
    r = kind_id_2(name); if (r != 0) { return r; }
    r = kind_id_3(name); if (r != 0) { return r; }
    r = kind_id_4(name); if (r != 0) { return r; }
    return 0;
}

