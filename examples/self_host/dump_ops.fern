import "std/io";
import "./lexer";
import "./parser";
import "./asm_ir";
import "./irlower";
import "./util";

function main(): i32 {
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    var bm: parser.Module = parser.module_with_builtins(mod);
    var lm: parser.Module = asm_ir.lift_lambdas(bm);
    var i: i32 = 0;
    while (i < lm.funcs.len()) {
        var fn: parser.FuncDecl = lm.funcs[i];
        if (fn.name == "main") {
            var r: irlower.LowerResult = irlower.lower_func_for_noret(fn, lm.structs, lm.funcs);
            var ok_str: string = "false";
            if (r.ok) { ok_str = "true"; }
            print("main ok=" + ok_str + " ops=" + util.i32_to_string(r.ops.len()) + "\n");
            var j: i32 = 0;
            while (j < r.ops.len()) {
                print(r.ops[j].kind);
                if (r.ops[j].str.len() > 0) { print("(" + r.ops[j].str + ")"); }
                print("\n");
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}
