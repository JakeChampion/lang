// examples/self_host/emitforms.fern — the output forms the CLI (fern.fern) and
// the playground driver (playground_run.fern) produce the same way.
//
// Two things live here rather than in either driver. The typed semantic
// substitution is produced ahead of whichever emit path runs, so the pipeline
// behind it is linked by the drivers that emit whole programs and not by the
// backend modules themselves: linking it from the three backends cost the
// eight standalone drivers that carry one 6.7-10.2% of their bytes for a flag
// they never read (docs/SELFHOST-SEMANTIC-SOURCE.md). The wasi:cli/run
// component framing chooses a wrapper from the program's WASI usage; a
// playground must build the same component the CLI writes, so the choice is
// made once.

import "./ircore";
import "./irlower";
import "./parser";
import "./semlower";
import "./util";
import "./wasm_ir";
import "./watbin";

// substitution produces the semantic lowering for whichever emit path the
// target selects, against the SAME normalisation that path gates on — the
// register backends' (semlower.gated_module) after the lambda lift, which it
// hands over (Sub.lifted) so their emit entries read it erased rather than
// lifting again, and wasm's own (wasm_ir.route_normalized_typed), which lifts
// inside and takes the unlifted module as its emit entry does. Lifting once
// more before it renames every local of an already-lifted body, so what it
// produced would not be the bodies the emit path lowers. Off (FERN_SEM_IR set
// empty) it produces nothing and costs nothing.
pub function substitution(typed: parser.Module, target: string): ircore.Sub {
    if (!semlower.sem_ir_on()) { return ircore.no_sub(); }
    if (util.str_has_prefix(target, "wasm")) { return substitution_of(wasm_ir.route_normalized_typed(typed)); }
    var lifted: parser.Module = ircore.lift_lambdas_typed(typed);
    return ircore.Sub { ...substitution_of(semlower.gated_module(lifted)), lifted: lifted, has_lifted: true };
}

function substitution_of(im: parser.Module): ircore.Sub {
    // The typed lowering reads im; the AST lowering's tables read its erasure.
    var lowered: parser.Module = parser.erase_str_module(im);
    var stab: irlower.StructTab = irlower.struct_tab(lowered.structs);
    util.arr_push_cliff_report("sem:gated", 0);
    var sub: ircore.Sub = semlower.substitution(im, lowered.funcs, stab, ircore.wp_fn_sigs(lowered.funcs, stab));
    return ircore.Sub { ...sub, rt_lower: semlower.runtime_bodies };
}

// COMPONENT_REFUSED is what a caller prints when wasm_component returns no
// bytes: the program uses WASI imports the component wrapper does not frame.
pub const COMPONENT_REFUSED: string = "fern: -target wasm32-wasi: program uses WASI imports not yet supported by the component wrapper (no-I/O, stdout, and filesystem are wrapped so far); -emit core-module emits the bare module instead\n";

// wasm_component is the wasi:cli/run component for `full`, framed from the
// program's WASI usage: no-I/O (component_full), stdout/exit
// (component_full_io), or filesystem read / write / read+write over stdout
// (component_full_io_fs / _fs_write / _fs_rw), and the single-category and
// fs-paired combinations wasm_ir.component_shape admits. A program using WASI
// the wrapper does not frame yet returns no bytes, so the caller can refuse
// rather than emit a broken component.
pub function wasm_component(full: parser.Module, sub: ircore.Sub): i32[] {
    var shape: i32 = wasm_ir.component_shape(full);
    if (shape < 0) { return []; }
    if (shape == 0) {
        return watbin.component_full(watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error_sub(full, true, false, sub)));
    }
    var core: i32[] = watbin.wat_to_binary(wasm_ir.emit_module_mode_or_error_sub(full, true, true, sub));
    if (shape == 1) { return watbin.component_full_io(core); }
    if (shape == 2) { return watbin.component_full_io_fs(core); }
    if (shape == 3) { return watbin.component_full_io_fs_write(core); }
    if (shape == 4) { return watbin.component_full_io_fs_rw(core); }
    if (shape == 5) { return watbin.component_full_io_random(core); }
    if (shape == 6) { return watbin.component_full_io_env(core); }
    if (shape == 7) { return watbin.component_full_io_args(core); }
    if (shape == 8) { return watbin.component_full_io_clock(core); }
    if (shape == 9) { return watbin.component_full_io_clock_mono(core); }
    if (shape == 10) { return watbin.component_full_io_fs_read_env(core); }
    if (shape == 11) { return watbin.component_full_io_fs_rw_env(core); }
    if (shape == 12) { return watbin.component_full_io_random_write(core); }
    if (shape == 13) { return watbin.component_full_io_eprint(core); }
    if (shape == 14) { return watbin.component_full_io_exit(core); }
    if (shape == 15) { return watbin.component_full_io_fs_args_read(core); }
    return watbin.component_full_io_fs_rw_args(core);
}
