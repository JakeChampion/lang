// examples/self_host/modloader.fern — the self-host compiler's file-based
// module loader, shared by the import-driven drivers (asm_modload_run,
// checker_modload_run, …). Extracted so each driver differs only in what
// it does with the merged module (emit asm / run the checker / probe IR),
// not in how it resolves and bundles modules from disk.
//
// Given an entry file path, it follows the entry's `import` graph to
// sibling `.fern` files (transitively), parses each, and returns them as
// flatten.LoadedModule[] for flatten.bundle. Resolution mirrors the native
// modload closely enough for the compiler's own needs:
//
//   * an import resolves relative to the entry's directory, keeping its
//     sub-path: `import "std/io"` → `<dir>/std/io.fern`, falling back to
//     the flat basename `<dir>/io.fern`;
//   * the module's NAMESPACE is the basename (`std/io` → `io`);
//   * an import that resolves to no readable file is skipped — a compiler
//     intrinsic / not-vendored stdlib module, exactly as the legacy
//     `///MODULE` bundle left them out.
//
// Uses only features the self-hosted emitter supports (read_file → Result,
// match), so it builds with either compiler.

import "./lexer";
import "./parser";
import "./flatten";
import "./fern_toml";

// dirname returns everything up to and including the last '/', or "" when
// the path has no directory part ("a/b/c.fern" → "a/b/", "main.fern" → "").
pub function dirname(path: string): string {
    var cut: i32 = 0;
    var i: i32 = 0;
    while (i < path.len()) {
        if (path[i] == 47) { cut = i + 1; }   // '/'
        i = i + 1;
    }
    return path[0:cut] + "";
}

// base_name strips the directory and the import-relative `./` prefix from
// an import path: "./lexer" → "lexer", "std/io" → "io".
pub function base_name(path: string): string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < path.len()) {
        if (path[i] == 47) { start = i + 1; }   // '/'
        i = i + 1;
    }
    return path[start:path.len()] + "";
}

// contains reports membership of `name` in `xs`.
function contains(xs: string[], name: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// rel_path strips a leading import-relative `./` so the path joins cleanly
// onto the entry directory: "./lexer" → "lexer", "std/io" → "std/io".
function rel_path(path: string): string {
    if (path.len() >= 2 && path[0:2] == "./") { return path[2:path.len()] + ""; }
    return path;
}

// enqueue_imports appends each not-yet-known import PATH of `mod` to
// `queue`. The full path is kept (so a `std/`-prefixed import resolves to
// its sub-directory file) and de-duplicated by basename — the namespace
// the bundler keys on — against names already queued/loaded (`seen`).
function enqueue_imports(queue: string[], seen: string[], mod: parser.Module): string[] {
    var out: string[] = queue;
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        var path: string = mod.imports[i].path;
        var name: string = base_name(path);
        if (!contains(seen, name)) { out = out.append(path); }
        i = i + 1;
    }
    return out;
}

// try_read reads `<dir><rel>.fern`, returning Some(source) or None.
function try_read(dir: string, rel: string): Option[string] {
    match (read_file(dir + rel + ".fern")) {
        Ok(s) => { return Some(s); },
        Err(e) => { return None; },
    }
    return None;
}

// resolve_module_src finds the source for import `path`. It tries the full
// (possibly `std/`-prefixed) path first, then the flat basename in the
// entry directory — so `import "std/io"` resolves to `<dir>/std/io.fern`
// when vendored there, or `<dir>/io.fern` when laid out flat.
pub function resolve_module_src(dir: string, path: string, name: string): Option[string] {
    match (try_read(dir, rel_path(path))) {
        Some(s) => { return Some(s); },
        None => { },
    }
    match (try_read(dir, name)) {
        Some(s) => { return Some(s); },
        None => { },
    }
    // Manifest fallback (mirrors native's resolveImport): path / workspace /
    // versioned(lock) deps, vendored mode, and — since #4949 — url+hash
    // deps resolved from the per-machine content-addressed store via the
    // `env` runtime builtin. Dormant when no fern.toml is present, so a
    // manifest-less build (every current compiler source) is unchanged.
    return try_manifest(dir, name);
}

// try_manifest resolves a DECLARED dependency `name` from `<dir>fern.toml`
// across the disk-resolvable forms. Returns None when there is no
// manifest, `name` is not a declared dep, or the form is not
// disk-resolvable (url).
function try_manifest(dir: string, name: string): Option[string] {
    match (read_file(dir + "fern.toml")) {
        Ok(src) => {
            var m: fern_toml.Manifest = fern_toml.parse(src);
            var kind: string = fern_toml.dep_kind(m, name);
            if (kind.len() == 0) { return None; }   // undeclared / unrecognised form

            // Vendored mode: a declared dep resolves from <vendor-root>/
            // vendor/<name>/ when that tree exists — offline, form-agnostic,
            // taking precedence (mirrors the native vendored-mode rule).
            match (try_vendor(dir, name)) {
                Some(s) => { return Some(s); },
                None => { },
            }

            if (kind == "path") {
                match (fern_toml.dep_path(m, name)) {
                    Some(dp) => { return load_lib(dir + dp + "/"); },
                    None => { return None; },
                }
            }
            if (kind == "workspace") {
                return load_workspace_member(dir, name);
            }
            if (kind == "version") {
                return load_locked(dir, name);
            }
            // url+hash dep (#4949): resolve from the content-addressed
            // store by the manifest's declared hash. Read-only — the
            // store is populated (and sha256-verified) by native
            // `fern -fetch`; the loader trusts it exactly like the
            // native loader does at build time.
            if (kind == "url") {
                match (fern_toml.dep_hash(m, name)) {
                    Some(h) => { return load_from_store(h); },
                    None => { return None; },
                }
            }
            return None;
        },
        Err(e) => { return None; },
    }
    return None;
}

// load_lib reads a dependency directory's own fern.toml for its `lib`
// module (default lib.fern) and loads that file.
function load_lib(depdir: string): Option[string] {
    var deplib: string = "lib.fern";
    match (read_file(depdir + "fern.toml")) {
        Ok(src) => { deplib = fern_toml.parse(src).lib; },
        Err(e) => { },
    }
    return try_read(depdir, strip_fern_ext(deplib));
}

// parent_dir returns `dir` with its last path segment removed (both
// expected to end in '/'): "a/b/c/" → "a/b/", "a/" → "", "" → "".
function parent_dir(dir: string): string {
    if (dir.len() == 0) { return ""; }
    // Drop the trailing '/', then cut back to (and including) the prior '/'.
    var end: i32 = dir.len() - 1;
    var i: i32 = end - 1;
    while (i >= 0) {
        if (dir[i] == 47) { return dir[0:i + 1] + ""; }   // '/'
        i = i - 1;
    }
    return "";
}

// try_vendor resolves `name` from `<vendor-root>/vendor/<name>/` when such
// a tree governs `dir` — either dir's own vendor/ or an ancestor's (a
// workspace member sharing the root vendor/). Walks up reading each level.
function try_vendor(dir: string, name: string): Option[string] {
    var d: string = dir;
    var steps: i32 = 0;
    while (d.len() > 0 && steps < 64) {
        var cand: string = d + "vendor/" + name + "/";
        match (load_lib(cand)) {
            Some(s) => { return Some(s); },
            None => { },
        }
        d = parent_dir(d);
        steps = steps + 1;
    }
    return None;
}

// load_workspace_member finds the enclosing [workspace] root (the nearest
// ancestor fern.toml with a members list) and loads the member whose
// package name == `name`.
function load_workspace_member(dir: string, name: string): Option[string] {
    var d: string = dir;
    var steps: i32 = 0;
    while (d.len() > 0 && steps < 64) {
        match (read_file(d + "fern.toml")) {
            Ok(src) => {
                var wm: fern_toml.Manifest = fern_toml.parse(src);
                if (wm.members.len() > 0) {
                    var mi: i32 = 0;
                    while (mi < wm.members.len()) {
                        var memdir: string = d + wm.members[mi] + "/";
                        if (member_name(memdir) == name) { return load_lib(memdir); }
                        mi = mi + 1;
                    }
                    return None;   // workspace found, no such member
                }
            },
            Err(e) => { },
        }
        d = parent_dir(d);
        steps = steps + 1;
    }
    return None;
}

// member_name returns a package directory's declared [package] name, or ""
// when it has no readable manifest.
function member_name(memdir: string): string {
    match (read_file(memdir + "fern.toml")) {
        Ok(src) => { return fern_toml.parse(src).name; },
        Err(e) => { return ""; },
    }
    return "";
}

// load_locked resolves a versioned dep `name` through `<dir>fern.lock`,
// loading the pinned version's lib when its source is a local `path`. A
// url-sourced lock entry returns None (the store is unreachable here).
function load_locked(dir: string, name: string): Option[string] {
    match (read_file(dir + "fern.lock")) {
        Ok(src) => {
            var entries: fern_toml.LockEntry[] = fern_toml.parse_lock(src);
            match (fern_toml.lock_path_of(entries, name)) {
                Some(p) => { return load_lib(p + "/"); },
                None => { },
            }
            // url-sourced lock entry (#4949): the pinned source lives in
            // the content-addressed store, keyed by the lock's hash.
            match (fern_toml.lock_hash_of(entries, name)) {
                Some(h) => { return load_from_store(h); },
                None => { return None; },
            }
        },
        Err(e) => { return None; },
    }
    return None;
}

// load_from_store resolves a url/hash dependency from the per-machine
// content-addressed store (internal/pkgcache layout: <root>/<hex>/, with
// root = $FERN_CACHE_DIR/pkgs when set, else <user-cache-dir>/fern/pkgs).
// Mirrors native pkgcache.Root(): an explicit $FERN_CACHE_DIR wins and is
// NOT fallen through on a miss; otherwise the user cache dir is
// $XDG_CACHE_HOME, else $HOME/.cache (Linux) — with $HOME/Library/Caches
// tried as the darwin sibling, safe because this path only READS. The
// store is populated + sha256-verified by native `fern -fetch`; the
// loader trusts an already-populated store, exactly like the native
// loader does at build time (#4949 — no build-time network).
function load_from_store(hash: string): Option[string] {
    if (hash.len() < 8 || hash[0:7] != "sha256:") { return None; }
    var hex: string = hash[7:hash.len()] + "";
    match (env("FERN_CACHE_DIR")) {
        Some(d) => { return load_lib(d + "/pkgs/" + hex + "/"); },
        None => { },
    }
    match (env("XDG_CACHE_HOME")) {
        Some(x) => { return load_lib(x + "/fern/pkgs/" + hex + "/"); },
        None => { },
    }
    match (env("HOME")) {
        Some(h) => {
            match (load_lib(h + "/.cache/fern/pkgs/" + hex + "/")) {
                Some(s) => { return Some(s); },
                None => { return load_lib(h + "/Library/Caches/fern/pkgs/" + hex + "/"); },
            }
        },
        None => { return None; },
    }
    return None;
}

// strip_fern_ext removes a trailing ".fern" so the name joins onto
// try_read (which appends ".fern"): "api.fern" → "api", "lib" → "lib".
function strip_fern_ext(s: string): string {
    if (s.len() >= 5 && s[s.len() - 5:s.len()] == ".fern") {
        return s[0:s.len() - 5] + "";
    }
    return s;
}

// append_structs / append_enums concatenate two decl lists (builtin merge).
function append_structs(into: parser.StructDecl[], more: parser.StructDecl[]): parser.StructDecl[] {
    var out: parser.StructDecl[] = into;
    var i: i32 = 0;
    while (i < more.len()) { out = out.append(more[i]); i = i + 1; }
    return out;
}
function append_enums(into: parser.EnumDecl[], more: parser.EnumDecl[]): parser.EnumDecl[] {
    var out: parser.EnumDecl[] = into;
    var i: i32 = 0;
    while (i < more.len()) { out = out.append(more[i]); i = i + 1; }
    return out;
}

// load_imports walks the entry module's import graph breadth-first,
// reading each resolvable sibling `.fern` file and parsing it into a
// flatten.LoadedModule keyed by basename (what `mod.X` references resolve
// to). Unresolvable imports (intrinsics / not-vendored stdlib) are
// silently skipped.
pub function load_imports(dir: string, entry: parser.Module): flatten.LoadedModule[] {
    var loaded: flatten.LoadedModule[] = [];
    var seen: string[] = [];
    var queue: string[] = enqueue_imports([], seen, entry);
    var qi: i32 = 0;
    while (qi < queue.len()) {
        var path: string = queue[qi];
        qi = qi + 1;
        var name: string = base_name(path);
        if (contains(seen, name)) { continue; }
        seen = seen.append(name);
        match (resolve_module_src(dir, path, name)) {
            Some(src) => {
                var m: parser.Module = parser.parse_module(lexer.tokenize(src));
                loaded = loaded.append(flatten.LoadedModule { name: name, mod: m });
                queue = enqueue_imports(queue, seen, m);
            },
            None => { },   // not a local file — intrinsic / not vendored
        }
    }
    return loaded;
}

// merge_builtins reads `<dir>builtins.fern` (the real built-in-type
// module) and appends its struct + enum decls to `merged`, unmangled, so
// the program's references to JsonValue / IoError / FileStat / … resolve.
// When the file is absent the program is returned unchanged and
// module_with_builtins' idempotent synthetic injection fills the types in.
pub function merge_builtins(dir: string, merged: parser.Module): parser.Module {
    match (read_file(dir + "builtins.fern")) {
        Ok(bsrc) => {
            var bmod: parser.Module = parser.parse_module(lexer.tokenize(bsrc));
            return parser.Module {
                funcs: merged.funcs,
                structs: append_structs(merged.structs, bmod.structs),
                aliases: merged.aliases,
                imports: merged.imports,
                top_stmts: merged.top_stmts,
                enums: append_enums(merged.enums, bmod.enums),
                resources: merged.resources,
                exports: merged.exports,
                impls: merged.impls,
                trait_reqs: merged.trait_reqs
            };
        },
        Err(e) => { return merged; },
    }
    return merged;
}
