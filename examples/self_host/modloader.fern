// examples/self_host/modloader.fern — the self-host compiler's file-based
// module loader, shared by the import-driven drivers (asm_modload_run,
// checker_modload_run, …). Extracted so each driver differs only in what
// it does with the merged module (emit asm / run the checker / probe IR),
// not in how it resolves and bundles modules from disk.
//
// Given an entry file path, it follows the entry's `import` graph to
// sibling `.fern` files (transitively), parses each, and returns them as
// flatten.LoadedModule[] for flatten.bundle. Resolution mirrors the native
// modload closely enough for the compiler's own needs:
//
//   * an import resolves relative to the entry's directory, keeping its
//     sub-path: `import "std/io"` → `<dir>/std/io.fern`, falling back to
//     the flat basename `<dir>/io.fern`;
//   * the module's NAMESPACE is the basename (`std/io` → `io`);
//   * an import that resolves to no readable file is skipped — a compiler
//     intrinsic / not-vendored stdlib module, exactly as the legacy
//     `///MODULE` bundle left them out.
//
// Uses only features the self-hosted emitter supports (read_file → Result,
// match), so it builds with either compiler.

import "./lexer";
import "./parser";
import "./flatten";
import "./fern_toml";
import "./util";

// dirname returns everything up to and including the last '/', or "" when
// the path has no directory part ("a/b/c.fern" → "a/b/", "main.fern" → "").
pub function dirname(path: string): string {
    var cut: i32 = 0;
    var i: i32 = 0;
    while (i < path.len()) {
        if (path[i] == 47) { cut = i + 1; }   // '/'
        i = i + 1;
    }
    return path[0:cut] + "";
}

// base_name strips the directory and the import-relative `./` prefix from
// an import path: "./lexer" → "lexer", "std/io" → "io".
pub function base_name(path: string): string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < path.len()) {
        if (path[i] == 47) { start = i + 1; }   // '/'
        i = i + 1;
    }
    return path[start:path.len()] + "";
}

// rel_path strips a leading import-relative `./` so the path joins cleanly
// onto the entry directory: "./lexer" → "lexer", "std/io" → "std/io".
function rel_path(path: string): string {
    if (path.len() >= 2 && path[0:2] == "./") { return path[2:path.len()] + ""; }
    return path;
}

// enqueue_imports appends each not-yet-known import PATH of `mod` to
// `queue`. The full path is kept (so a `std/`-prefixed import resolves to
// its sub-directory file) and de-duplicated by basename — the namespace
// the bundler keys on — against names already queued/loaded (`seen`).
function enqueue_imports(queue: string[], seen: string[], mod: parser.Module): string[] {
    var out: string[] = queue;
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        var path: string = mod.imports[i].path;
        var name: string = base_name(path);
        if (!util.has_str(seen, name)) { out = out.append(path); }
        i = i + 1;
    }
    return out;
}

// fill_dirs appends `n` copies of `dir`, keeping the directory list the same
// length as the import queue it parallels.
function fill_dirs(dirs: string[], dir: string, n: i32): string[] {
    var out: string[] = dirs;
    var i: i32 = 0;
    while (i < n) { out = out.append(dir + ""); i = i + 1; }
    return out;
}

// try_read reads `<dir><rel>.fern`, returning Some(source) or None.
function try_read(dir: string, rel: string): Option[string] {
    match (read_file(dir + rel + ".fern")) {
        Ok(s) => { return Some(s); },
        Err(e) => { return None; },
    }
    return None;
}

// Resolved is a module's source together with the DIRECTORY it was read
// from. The directory is what the module's own imports resolve against —
// a dependency's `import "./util"` names a file beside the dependency, and
// its declared dependencies live in the dependency's manifest, not the
// entry package's.
pub struct Resolved { src: string, dir: string, ok: boolean }

function res_none(): Resolved { return Resolved { src: "", dir: "", ok: false }; }

// res_read reads `<dir><rel>.fern` and reports the ROOT its own imports
// resolve against, which is `dir` — not the sub-directory the file happens to
// sit in. An import path is relative to the package root, so `std/float`
// reaching `<dir>std/float.fern` still writes `import "std/string"` for its
// sibling, and resolving that against `<dir>std/` would look for
// `<dir>std/std/string.fern`. The root changes only when resolution crosses
// into another PACKAGE, which is what the manifest arms return.
function res_read(dir: string, rel: string): Resolved {
    match (try_read(dir, rel)) {
        Some(s) => { return Resolved { src: s, dir: dir, ok: true }; },
        None => { return res_none(); },
    }
    return res_none();
}

// resolve_module_src finds the source for import `path`, discarding the
// directory it was found in. `resolve_module` is the full answer.
pub function resolve_module_src(dir: string, path: string, name: string): Option[string] {
    var r: Resolved = resolve_module(dir, path, name);
    if (!r.ok) { return None; }
    return Some(r.src);
}

// resolve_module finds the source for import `path` and the directory it
// lives in. It tries the full (possibly `std/`-prefixed) path first, then the
// flat basename in `dir` — so `import "std/io"` resolves to `<dir>/std/io.fern`
// when vendored there, or `<dir>/io.fern` when laid out flat.
pub function resolve_module(dir: string, path: string, name: string): Resolved {
    var direct: Resolved = res_read(dir, rel_path(path));
    if (direct.ok) { return direct; }
    var flat: Resolved = res_read(dir, name);
    if (flat.ok) { return flat; }
    // Manifest fallback (mirrors native's resolveImport): path / workspace /
    // versioned(lock) deps, vendored mode, and — since #4949 — url+hash
    // deps resolved from the per-machine content-addressed store via the
    // `env` runtime builtin. Dormant when no fern.toml is present, so a
    // manifest-less build (every current compiler source) is unchanged.
    return try_manifest(dir, name);
}

// try_manifest resolves a DECLARED dependency `name` from `<dir>fern.toml`
// across the disk-resolvable forms. Not-ok when there is no manifest, `name`
// is not a declared dep, or the form is not disk-resolvable.
function try_manifest(dir: string, name: string): Resolved {
    match (read_file(dir + "fern.toml")) {
        Ok(src) => {
            var m: fern_toml.Manifest = fern_toml.parse(src);
            var kind: string = fern_toml.dep_kind(m, name);
            if (kind.len() == 0) { return res_none(); }   // undeclared / unrecognised form

            // Vendored mode: a declared dep resolves from <vendor-root>/
            // vendor/<name>/ when that tree exists — offline, form-agnostic,
            // taking precedence (mirrors the native vendored-mode rule).
            var vend: Resolved = try_vendor(dir, name);
            if (vend.ok) { return vend; }

            if (kind == "path") {
                match (fern_toml.dep_path(m, name)) {
                    Some(dp) => { return load_lib(dir + dp + "/"); },
                    None => { return res_none(); },
                }
            }
            if (kind == "workspace") {
                return load_workspace_member(dir, name);
            }
            if (kind == "version") {
                return load_locked(dir, name);
            }
            // url+hash dep (#4949): resolve from the content-addressed
            // store by the manifest's declared hash. Read-only — the
            // store is populated (and sha256-verified) by native
            // `fern -fetch`; the loader trusts it exactly like the
            // native loader does at build time.
            if (kind == "url") {
                match (fern_toml.dep_hash(m, name)) {
                    Some(h) => { return load_from_store(h); },
                    None => { return res_none(); },
                }
            }
            return res_none();
        },
        Err(e) => { return res_none(); },
    }
    return res_none();
}

// load_lib reads a dependency directory's own fern.toml for its `lib`
// module (default lib.fern) and loads that file.
function load_lib(depdir: string): Resolved {
    var deplib: string = "lib.fern";
    match (read_file(depdir + "fern.toml")) {
        Ok(src) => { deplib = fern_toml.parse(src).lib; },
        Err(e) => { },
    }
    return res_read(depdir, strip_fern_ext(deplib));
}

// parent_dir returns `dir` with its last path segment removed (both
// expected to end in '/'): "a/b/c/" → "a/b/", "a/" → "", "" → "".
function parent_dir(dir: string): string {
    if (dir.len() == 0) { return ""; }
    // Drop the trailing '/', then cut back to (and including) the prior '/'.
    var end: i32 = dir.len() - 1;
    var i: i32 = end - 1;
    while (i >= 0) {
        if (dir[i] == 47) { return dir[0:i + 1] + ""; }   // '/'
        i = i - 1;
    }
    return "";
}

// try_vendor resolves `name` from `<vendor-root>/vendor/<name>/` when such
// a tree governs `dir` — either dir's own vendor/ or an ancestor's (a
// workspace member sharing the root vendor/). Walks up reading each level.
function try_vendor(dir: string, name: string): Resolved {
    var d: string = dir;
    var steps: i32 = 0;
    while (d.len() > 0 && steps < 64) {
        var cand: Resolved = load_lib(d + "vendor/" + name + "/");
        if (cand.ok) { return cand; }
        d = parent_dir(d);
        steps = steps + 1;
    }
    return res_none();
}

// load_workspace_member finds the enclosing [workspace] root (the nearest
// ancestor fern.toml with a members list) and loads the member whose
// package name == `name`.
function load_workspace_member(dir: string, name: string): Resolved {
    var d: string = dir;
    var steps: i32 = 0;
    while (d.len() > 0 && steps < 64) {
        match (read_file(d + "fern.toml")) {
            Ok(src) => {
                var wm: fern_toml.Manifest = fern_toml.parse(src);
                if (wm.members.len() > 0) {
                    var mi: i32 = 0;
                    while (mi < wm.members.len()) {
                        var memdir: string = d + wm.members[mi] + "/";
                        if (member_name(memdir) == name) { return load_lib(memdir); }
                        mi = mi + 1;
                    }
                    return res_none();   // workspace found, no such member
                }
            },
            Err(e) => { },
        }
        d = parent_dir(d);
        steps = steps + 1;
    }
    return res_none();
}

// member_name returns a package directory's declared [package] name, or ""
// when it has no readable manifest.
function member_name(memdir: string): string {
    match (read_file(memdir + "fern.toml")) {
        Ok(src) => { return fern_toml.parse(src).name; },
        Err(e) => { return ""; },
    }
    return "";
}

// load_locked resolves a versioned dep `name` through `<dir>fern.lock`,
// loading the pinned version's lib when its source is a local `path`. A
// url-sourced lock entry resolves through the store.
function load_locked(dir: string, name: string): Resolved {
    match (read_file(dir + "fern.lock")) {
        Ok(src) => {
            var entries: fern_toml.LockEntry[] = fern_toml.parse_lock(src);
            match (fern_toml.lock_path_of(entries, name)) {
                Some(p) => { return load_lib(p + "/"); },
                None => { },
            }
            // url-sourced lock entry (#4949): the pinned source lives in
            // the content-addressed store, keyed by the lock's hash.
            match (fern_toml.lock_hash_of(entries, name)) {
                Some(h) => { return load_from_store(h); },
                None => { return res_none(); },
            }
        },
        Err(e) => { return res_none(); },
    }
    return res_none();
}

// load_from_store resolves a url/hash dependency from the per-machine
// content-addressed store (internal/pkgcache layout: <root>/<hex>/, with
// root = $FERN_CACHE_DIR/pkgs when set, else <user-cache-dir>/fern/pkgs).
// Mirrors native pkgcache.Root(): an explicit $FERN_CACHE_DIR wins and is
// NOT fallen through on a miss; otherwise the user cache dir is
// $XDG_CACHE_HOME, else $HOME/.cache (Linux) — with $HOME/Library/Caches
// tried as the darwin sibling, safe because this path only READS. The
// store is populated + sha256-verified by native `fern -fetch`; the
// loader trusts an already-populated store, exactly like the native
// loader does at build time (#4949 — no build-time network).
function load_from_store(hash: string): Resolved {
    if (hash.len() < 8 || hash[0:7] != "sha256:") { return res_none(); }
    var hex: string = hash[7:hash.len()] + "";
    match (env("FERN_CACHE_DIR")) {
        Some(d) => { return load_lib(d + "/pkgs/" + hex + "/"); },
        None => { },
    }
    match (env("XDG_CACHE_HOME")) {
        Some(x) => { return load_lib(x + "/fern/pkgs/" + hex + "/"); },
        None => { },
    }
    match (env("HOME")) {
        Some(h) => {
            var linux: Resolved = load_lib(h + "/.cache/fern/pkgs/" + hex + "/");
            if (linux.ok) { return linux; }
            return load_lib(h + "/Library/Caches/fern/pkgs/" + hex + "/");
        },
        None => { return res_none(); },
    }
    return res_none();
}

// strip_fern_ext removes a trailing ".fern" so the name joins onto
// try_read (which appends ".fern"): "api.fern" → "api", "lib" → "lib".
function strip_fern_ext(s: string): string {
    if (s.len() >= 5 && s[s.len() - 5:s.len()] == ".fern") {
        return s[0:s.len() - 5] + "";
    }
    return s;
}

// append_structs / append_enums concatenate two decl lists (builtin merge).
function append_structs(into: parser.StructDecl[], more: parser.StructDecl[]): parser.StructDecl[] {
    var out: parser.StructDecl[] = into;
    var i: i32 = 0;
    while (i < more.len()) { out = out.append(more[i]); i = i + 1; }
    return out;
}
function append_enums(into: parser.EnumDecl[], more: parser.EnumDecl[]): parser.EnumDecl[] {
    var out: parser.EnumDecl[] = into;
    var i: i32 = 0;
    while (i < more.len()) { out = out.append(more[i]); i = i + 1; }
    return out;
}

// load_imports walks the entry module's import graph breadth-first,
// reading each resolvable `.fern` file and parsing it into a
// flatten.LoadedModule keyed by basename (what `mod.X` references resolve
// to). Unresolvable imports (intrinsics / not-vendored stdlib) are
// silently skipped.
//
// Each queued import carries the directory it was written IN, and a module
// is resolved against that rather than against the entry's directory: a
// dependency's `import "./util"` names a file beside the dependency, and its
// declared dependencies live in its own manifest. Resolving everything
// against the entry meant a dependency's own dependencies never loaded at
// all — silently, since an unresolvable import is skipped (#6756).
pub function load_imports(dir: string, entry: parser.Module): flatten.LoadedModule[] {
    var loaded: flatten.LoadedModule[] = [];
    var seen: string[] = [];
    var queue: string[] = enqueue_imports([], seen, entry);
    var queue_dirs: string[] = fill_dirs([], dir, queue.len());
    var qi: i32 = 0;
    while (qi < queue.len()) {
        var path: string = queue[qi];
        var from: string = queue_dirs[qi];
        qi = qi + 1;
        var name: string = base_name(path);
        if (util.has_str(seen, name)) { continue; }
        seen = seen.append(name);
        var r: Resolved = resolve_module(from, path, name);
        if (r.ok) {
            var m: parser.Module = parser.parse_module(lexer.tokenize(r.src));
            loaded = loaded.append(flatten.LoadedModule { name: name, mod: m });
            var before: i32 = queue.len();
            queue = enqueue_imports(queue, seen, m);
            // The module's own imports resolve against ITS directory.
            queue_dirs = fill_dirs(queue_dirs, r.dir, queue.len() - before);
        }
    }
    return loaded;
}

// merge_builtins reads `<dir>builtins.fern` (the real built-in-type
// module) and appends its struct + enum decls to `merged`, unmangled, so
// the program's references to JsonValue / IoError / FileStat / … resolve.
// When the file is absent the program is returned unchanged and
// module_with_builtins' idempotent synthetic injection fills the types in.
pub function merge_builtins(dir: string, merged: parser.Module): parser.Module {
    match (read_file(dir + "builtins.fern")) {
        Ok(bsrc) => {
            var bmod: parser.Module = parser.parse_module(lexer.tokenize(bsrc));
            return parser.Module {
                funcs: merged.funcs,
                structs: append_structs(merged.structs, bmod.structs),
                aliases: merged.aliases,
                imports: merged.imports,
                top_stmts: merged.top_stmts,
                enums: append_enums(merged.enums, bmod.enums),
                resources: merged.resources,
                exports: merged.exports,
                impls: merged.impls,
                trait_reqs: merged.trait_reqs, trait_decls: merged.trait_decls
            };
        },
        Err(e) => { return merged; },
    }
    return merged;
}

// ---- incremental-codegen cache keys (#3451 step 6 / #3458, #5331) -----------
// Shared by every per-module driver (asm_modload_run, wasm_modload_run): the
// fingerprints an out-of-process build orchestrator uses to decide which modules
// must be re-emitted and which can be served from an object cache.
//
// These live here rather than in one driver because the RULE they encode is
// subtle and must not drift between backends: a module's key is its own source
// hash folded with the SIGNATURE hash of every module it depends on. src_hash
// makes a body-only edit re-emit that module (its own codegen changed); sig_hash
// makes a signature edit re-emit that module AND its dependents (their call-site
// tagging changed) — while a body-only edit to a dependency leaves dependents
// untouched, since their sig_hash input is unchanged. That asymmetry is the whole
// basis of correct invalidation; keying on source alone would ship stale codegen
// when a depended-on return type changes.
//
// "Depends on" is the TRANSITIVE import closure, not the direct edges. A unit is
// lowered under the whole-program function and struct view, so a module reaches
// declarations it never imported: `main` importing only `mid` can read a field of
// a struct `leaf` declares (field OFFSETS come from leaf) and can call a receiver
// method leaf declares on it (call-site tagging comes from leaf's signature).
// Neither shows up in mid's own signature — `get(): Thing` is unchanged when
// Thing's field list moves — so a direct-edge key leaves main stale.
//
// The closure is a sound over-approximation, not a precise dependency set: a
// signature change low in the graph invalidates everything above it, whether or
// not those units name anything that moved. Narrowing it means computing the
// declarations each unit actually references; correctness comes first.

pub function module_sig_string(mod: parser.Module): string {
    var out: string = "";
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var f: parser.FuncDecl = mod.funcs[fi];
        out = out + "fn " + f.receiver_type + "." + f.name + "(";
        var pi: i32 = 0;
        while (pi < f.params.len()) {
            out = out + f.params[pi].type_name + ",";
            pi = pi + 1;
        }
        out = out + ")" + f.ret_type + ";";
        fi = fi + 1;
    }
    var si: i32 = 0;
    while (si < mod.structs.len()) {
        var sd: parser.StructDecl = mod.structs[si];
        out = out + "st " + sd.name + "{";
        var di: i32 = 0;
        while (di < sd.fields.len()) {
            out = out + sd.fields[di].name + ":" + sd.fields[di].type_name + ",";
            di = di + 1;
        }
        out = out + "}";
        si = si + 1;
    }
    return out;
}

// module_dep_ns joins (comma-separated, in parts order) the namespaces module
// `idx` depends on — the dependency list the incremental cache keys it against.
// A key folds in the SIGNATURE hash of each name here, so a signature change in
// anything it depends on invalidates it.
//
// This is the TRANSITIVE closure, and it is what the manifest reports for a
// reason: the manifest exists so an out-of-process orchestrator can compute the
// keys the driver computes. Reporting direct edges instead would hand it a
// weaker rule than the driver's, so it would reuse a unit the driver would have
// re-emitted — the same stale codegen, one layer out. Only loaded modules are
// listed; an import that resolved to no part contributes no signature.
pub function module_dep_ns(parts: flatten.PerModule[], infmods: parser.Module[], idx: i32): string {
    var deps: string[] = import_closure_ns(parts, infmods, idx);
    var out: string = "";
    var j: i32 = 0;
    while (j < parts.len()) {
        if (util.has_str(deps, parts[j].ns)) {
            if (out.len() > 0) { out = out + ","; }
            out = out + parts[j].ns;
        }
        j = j + 1;
    }
    return out;
}

// module_import_path finds the ORIGINAL import path (e.g. "./sub/leaf",
// "std/io") whose basename is `ns`, by scanning every loaded module's imports.
// The bundler keys modules by basename, but resolving a module's source needs
// its full sub-path — so we recover it from whichever module imported it.
// Returns "" if no import edge names `ns` (i.e. the entry, or a not-found case).
pub function module_import_path(parts: flatten.PerModule[], ns: string): string {
    var j: i32 = 0;
    while (j < parts.len()) {
        var imps: parser.Import[] = parts[j].mod.imports;
        var ii: i32 = 0;
        while (ii < imps.len()) {
            if (base_name(imps[ii].path) == ns) { return imps[ii].path; }
            ii = ii + 1;
        }
        j = j + 1;
    }
    return "";
}

// module_src_hash fingerprints a module's own source. It resolves the module's
// source THROUGH THE LOADER (modloader.resolve_module_src, keyed by the original
// import path recovered via module_import_path) so a sub-directory module
// (`import "std/io"` → <dir>/std/io.fern) is hashed at its real path, not just
// the flat <dir><ns>.fern. The entry reads entry_path. Only a genuinely
// unresolvable source yields "?", which callers MUST treat as always-rebuild:
// sound (never reuses stale codegen), just not incremental for that module.
pub function module_src_hash(dir: string, entry_path: string, parts: flatten.PerModule[], idx: i32): string {
    if (parts[idx].is_entry) {
        match (read_file(entry_path)) {
            Ok(esrc) => { return util.hash_key(esrc); },
            Err(e) => { return "?"; },
        }
    }
    var ip: string = module_import_path(parts, parts[idx].ns);
    if (ip.len() > 0) {
        match (resolve_module_src(dir, ip, parts[idx].ns)) {
            Some(src) => { return util.hash_key(src); },
            None => { },
        }
    }
    // Fallback: flat sibling layout (no import edge found, e.g. a degenerate view).
    match (read_file(dir + parts[idx].ns + ".fern")) {
        Ok(msrc) => { return util.hash_key(msrc); },
        Err(e) => { return "?"; },
    }
    return "?";
}

// import_closure_ns returns the namespaces module `idx` depends on transitively
// — the dependency set the cache key folds signatures over (see the section
// header for why direct edges are not enough). Names that resolve to no loaded
// part are harmless: the fold walks `parts` and asks membership, so an unresolved
// import contributes nothing.
//
// A fixed point over `parts` rather than a worklist: the module count is small
// (tens), and re-scanning is what makes an import CYCLE terminate instead of
// revisiting forever.
pub function import_closure_ns(parts: flatten.PerModule[], infmods: parser.Module[], idx: i32): string[] {
    var seen: string[] = [];
    var grew: boolean = true;
    while (grew) {
        grew = false;
        var j: i32 = 0;
        while (j < parts.len()) {
            if (j == idx || util.has_str(seen, parts[j].ns)) {
                var imps: parser.Import[] = infmods[j].imports;
                var ii: i32 = 0;
                while (ii < imps.len()) {
                    var nm: string = base_name(imps[ii].path);
                    if (!util.has_str(seen, nm)) {
                        seen = seen.append(nm);
                        grew = true;
                    }
                    ii = ii + 1;
                }
            }
            j = j + 1;
        }
    }
    return seen;
}

// module_cache_key builds the content-addressed key for module `idx`: its own
// src_hash, folded with the SIGNATURE hash of every module it depends on
// transitively (walked in parts order, so the key is deterministic without a
// sort). The entry also folds in the runtime-need set it was asked to emit
// (pm_extra), since that set is part of the entry unit's codegen inputs. `ns` is
// included so two modules with byte-identical source but different namespaces
// (hence different mangled output) never share a key. Returns "" when src_hash is
// "?" — the signal to skip the cache and always emit.
pub function module_cache_key(parts: flatten.PerModule[], infmods: parser.Module[], sighashes: string[], idx: i32, src_hash: string, extra: string[]): string {
    if (src_hash == "?") { return ""; }
    var key: string = parts[idx].ns + "|" + src_hash;
    var deps: string[] = import_closure_ns(parts, infmods, idx);
    var j: i32 = 0;
    while (j < parts.len()) {
        if (util.has_str(deps, parts[j].ns)) { key = key + "#" + sighashes[j]; }
        j = j + 1;
    }
    if (parts[idx].is_entry) {
        var ex: string = "";
        var ei: i32 = 0;
        while (ei < extra.len()) { ex = ex + extra[ei] + ","; ei = ei + 1; }
        key = key + "@" + util.hash_key(ex);
    }
    return key;
}

// module_unit_cache_key is module_cache_key for ONE emitted unit: the same key
// with the function window [lo,hi) folded in, so two shards of a module never
// share an entry. `hi < 0` means "to the end", which is how a whole-module emit
// spells its window; a caller that knows the module's function count must
// normalise a full window to -1 or the same bytes get two keys.
//
// Every driver goes through this rather than appending the window itself: the
// window is part of what the cached bytes ARE, so a driver that forgot it would
// serve one shard's asm for another.
pub function module_unit_cache_key(parts: flatten.PerModule[], infmods: parser.Module[], sighashes: string[], idx: i32, src_hash: string, extra: string[], lo: i32, hi: i32): string {
    var key: string = module_cache_key(parts, infmods, sighashes, idx, src_hash, extra);
    if (key.len() == 0) { return ""; }
    return key + "|r" + util.i32_to_string(lo) + ":" + util.i32_to_string(hi);
}

