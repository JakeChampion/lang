// examples/self_host/treeshake.fern — reachability-based dead-code
// elimination for the self-hosted compiler.
//
// Loading a stdlib module (`import "core/cmp"`) pulls in its WHOLE transitive
// closure — core/sort, core/int, char-predicate helpers, generic comparison
// helpers (`min`/`max`/`lt`/…) — most of which a given program never uses.
// That bloats the merged module past asm_ir's 512-function IR budget (and the
// uninstantiated generics individually bail the IR-eligibility gate), so a
// stdlib-importing program could not compile at all. `treeshake`
// prunes `mod.funcs` to the functions REACHABLE from `main` (+ top-level
// statements + WIT exports + Drop finalizers + async entry points), so a
// program that uses only `i32`'s `eq`/`hash` drops the hundreds of unrelated
// stdlib functions and fits the IR path.
//
// SOUNDNESS — the prune must never drop a function the program can reach. It
// over-approximates reachability by NAME: a function is kept if its name
// appears anywhere reachable as
//   * an identifier read (`f(...)`, a function value, a mangled call target),
//   * a field/method name (`x.eq(...)` keeps every `*.eq`),
//   * the trait method an operator desugars to (`a < b` keeps `*.cmp`,
//     `a + b` keeps `*.add`, …) — covering operator overloading even if the
//     `+`→`.add()` rewrite has not run yet,
//   * the method an array-method helper or an interposed collision provider was
//     renamed away from (ts_kept_name), neither of which the syntax spells.
// The collector rides astwalk's fold spine, so it reaches every Expr/Stmt
// form the parser produces, and, unlike astwalk's capture analysis, does NOT
// subtract lambda-local bindings — for reachability, keeping an extra
// same-named function is harmless; dropping a referenced one is not.
// Over-keeping only costs IR budget; it never changes behaviour.

import "./ast";
import "./astwalk";
import "./parser";
import "./util";

// ts_op_method maps a (possibly overloadable) operator to the trait method it
// dispatches to, so `a <op> b` keeps that method even before the operator-
// overload desugar rewrites it to an explicit call. "" for non-overloadable.
function ts_op_method(op: string): string {
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") { return "div"; }
    if (op == "%") { return "rem"; }
    if (op == "==" || op == "!=") { return "eq"; }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") { return "cmp"; }
    return "";
}

// ts_op_is_arithmetic reports whether `op` dispatches to a method that
// ts_arith_kept resolves by receiver, so its root is worth qualifying.
//
// True for the arithmetic operators and false for the comparisons. The
// comparisons are not worth qualifying: measured on a minimal std/string
// program, stubbing the operator roots out entirely leaves every `*.eq` and
// `*.cmp` in place anyway, held by explicit `.eq(...)` / `.cmp(...)` field
// accesses in reachable stdlib code (docs/PERFORMANCE-AUDIT-2026-08.md §4f).
function ts_op_is_arithmetic(op: string): boolean {
    return op == "+" || op == "-" || op == "*" || op == "/" || op == "%";
}

// ts_recv_tag is the type an operator's root is qualified by: the type of the
// OPERAND, which is what ts_arith_kept matches against a method's
// receiver_type. Not the type of the whole expression — those differ exactly
// where a composite operator overload does not return Self, and `a * b` whose
// `mul` returns f64 would look for `f64|mul` while the method that implements
// it is `V.mul`. Every failing case of that shape is a scalar-returning
// overload.
//
// "" for the forms annotate_module does not stamp, and under a driver that
// never runs it at all (asm_load_run, asm_modload_run) — the caller falls back
// to the bare root there, which over-keeps and stays sound.
function ts_recv_tag(e: ast.Expr): string {
    match (e) {
        ast.ExprIdent(id) => { return id.ty; },
        ast.ExprBinary(b) => { return b.ty; },
        ast.ExprUnary(u) => { return u.ty; },
        ast.ExprCall(c) => { return c.ty; },
        ast.ExprIndex(ix) => { return ix.ty; },
        ast.ExprSlice(sl) => { return sl.ty; },
        ast.ExprFieldAccess(fa) => { return fa.ty; },
        ast.ExprStructLit(lit) => { return lit.type_name; },
        _ => { return ""; }
    }
    return "";
}

// ts_qualified_root builds the receiver-qualified root `<type tag>|<method>`.
// The `|` cannot occur in either half — a type tag is a scalar keyword, a
// struct name or a Map spelling, and a method name is an identifier — so a
// qualified root can never collide with the bare names sharing the set.
function ts_qualified_root(tag: string, method: string): string {
    return tag + "|" + method;
}

// ts_arith_method reports whether `name` is one of the six methods the
// arithmetic operators dispatch to — the only names ts_kept_name resolves by
// receiver. Every other function matches exactly as it did before qualification
// existed, which is what bounds this change to what was measured.
function ts_arith_method(name: string): boolean {
    return name == "add" || name == "sub" || name == "mul"
        || name == "div" || name == "rem" || name == "neg";
}

// ts_name_of contributes the names ONE node could reference; astwalk's fold
// supplies the walk, including lambda bodies (their calls are reachable, and
// lambda-local bindings are deliberately not subtracted). Every variant is
// spelled out rather than wildcarded so a new expression kind fails E030 here
// and gets a reachability decision, not a silent empty contribution — the
// soundness property the hand-written walk this replaces had.
function ts_name_of(e: ast.Expr, acc: string[]): string[] {
    match (e) {
        ast.ExprIdent(id) => { return acc.append(id.name); },
        ast.ExprBinary(b) => {
            var m: string = ts_op_method(b.op);
            if (m.len() == 0) { return acc; }
            // Qualified where the tag identifies the impl, bare otherwise.
            if (ts_op_is_arithmetic(b.op)) {
                var bt: string = ts_recv_tag(b.left);
                if (bt.len() > 0) { return acc.append(ts_qualified_root(bt, m)); }
            }
            return acc.append(m);
        },
        ast.ExprUnary(u) => {
            if (u.op != "-") { return acc; }
            var ut: string = ts_recv_tag(u.operand);
            if (ut.len() > 0) { return acc.append(ts_qualified_root(ut, "neg")); }
            return acc.append("neg");
        },
        // A method/field name (`x.eq`) is a reference: keep every function with
        // that simple name. An array-method call `arr.<m>(...)` (`.join` /
        // `.concat` / `.reverse` / `.flat_map` / `.sort_by` / std/array's
        // distinct, mode, …) dispatches to the auto-discovered
        // `__method_Array_<m>` helper, but the syntax names only `<m>` — so
        // without this the helper looks unreachable and gets pruned, bailing
        // the whole module (the IR path then fails on `i32.<m>`).
        // `ts_array_method_name` matches those helpers against this bare `<m>`.
        ast.ExprFieldAccess(fa) => { return acc.append(fa.field); },
        ast.ExprNumber(_) => { return acc; },
        ast.ExprString(_) => { return acc; },
        ast.ExprBool(_) => { return acc; },
        ast.ExprCall(_) => { return acc; },
        ast.ExprArray(_) => { return acc; },
        ast.ExprTuple(_) => { return acc; },
        ast.ExprMapLit(_) => { return acc; },
        ast.ExprFString(_) => { return acc; },
        ast.ExprIndex(_) => { return acc; },
        ast.ExprSlice(_) => { return acc; },
        ast.ExprStructLit(_) => { return acc; },
        ast.ExprLambda(_) => { return acc; },
        ast.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

// ts_names_expr appends every name `e` could REFERENCE (idents, field/method
// names, operator-dispatch methods) to `acc`. Duplicates are fine.
function ts_names_expr(e: ast.Expr, acc: string[]): string[] {
    return astwalk.fold_expr(e, acc, ts_name_of);
}

// ts_names_stmt appends every name `st` could reference to `acc`.
function ts_names_stmt(st: ast.Stmt, acc: string[]): string[] {
    return astwalk.fold_stmt(st, acc, ts_name_of);
}

// ts_func_names appends every name function `fd`'s body references to `acc`.
function ts_func_names(fd: parser.FuncDecl, acc: string[]): string[] {
    var i: i32 = 0;
    while (i < fd.body.len()) { acc = ts_names_stmt(fd.body[i], acc); i = i + 1; }
    return acc;
}

// ts_array_method_name returns the `<m>` of an array-method helper name —
// whatever follows the last `__method_Array_`, past any `<mod>__` mangling
// prefix modload added — or "" if `name` is not such a helper. The method-call
// syntax `arr.<m>(...)` references the helper only by `m`, so treeshake traces
// it by that bare name rather than by the mangled function name, which the
// syntax never spells.
//
// Matching on `<m>` rather than on a reconstructed `__method_Array_<m>` token
// is what lets the walk stay allocation-free: the token had to be BUILT, by a
// string concatenation at every field access in the program, and the bare `<m>`
// the concatenation was appended alongside is already in `refs`.
function ts_array_method_name(name: string): string {
    var marker: string = "__method_Array_";
    if (name.len() < marker.len()) { return ""; }
    var i: i32 = 0;
    while (i <= name.len() - marker.len()) {
        if (slice_unchecked(name, i, i + marker.len()) == marker) { return slice_unchecked(name, i + marker.len(), name.len()) + ""; }
        i = i + 1;
    }
    return "";
}

// ts_interposed_method_name returns the `<m>` of a method name
// parser.claim_method_name INTERPOSED — `B.scale` for a second trait providing
// `scale` for one type, `__entry.add` for a second module providing `add` for
// one type — or "" when `name` carries no interposition.
//
// The interposed name is one every call site is UNABLE to spell: the source
// writes `.scale`, and which of the two definitions that means is settled after
// this pass by dyn_arm_matches / dyn_provider_name. So the walk has to undo the
// rename the way those two do, or it prunes the loser of every collision. An
// ordinary name cannot be mistaken for one: module mangling joins with `__`,
// and a `.` reaches a FuncDecl name only from claim_method_name.
function ts_interposed_method_name(name: string): string {
    var last_dot: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < name.len()) {
        if (name[i] == b'.') { last_dot = i; }
        i = i + 1;
    }
    if (last_dot < 0) { return ""; }
    return slice_unchecked(name, last_dot + 1, name.len()) + "";
}

// ts_arith_kept resolves the six arithmetic methods BY RECEIVER, which is the
// half of the operator over-approximation worth removing: a bare `add` root
// keeps `add` for every type in the program, and on a minimal std/string
// program that is 24 functions — 12 of them core/bigint's `BigInt.add` / `sub`
// / `negate` and the `__bi_*` helpers behind them, reached by nothing the
// program does (§4f).
//
// A receiver spelled as the decl's OWN type parameter is a template no concrete
// tag can name — monomorph instantiates it after this pass — so it is kept
// rather than resolved. `base_type_name` strips the argument list, so
// `impl Add for Box[T]` resolves on `Box`, which is the tag a struct carries.
function ts_arith_kept(fd: parser.FuncDecl, refs: RefSet): boolean {
    if (fd.receiver_type.len() == 0) { return false; }
    var base: string = util.base_type_name(fd.receiver_type);
    if (base.len() == 0) { return false; }
    if (util.has_str(fd.type_params, base)) { return true; }
    return refset_has(refs, ts_qualified_root(base, fd.name));
}

// RefSet is the reachable-name set with a chained hash index over it — the
// irlower.SigReg idiom. The set is probed once per name a kept body spells
// and up to three times per pending function per round, against a set that
// reaches ~12,000 names on the compiler compiling itself, so a miss scanning
// the whole of it was most of this pass. Membership is the only question
// asked, so a chain's order carries no meaning and a new name is pushed at
// the front of its bucket.
struct RefSet { names: string[], head: i32[], next: i32[] }

function ts_buckets(): i32 { return 4093; }

function refset_of(names: string[]): RefSet {
    var head: i32[] = [];
    var b: i32 = 0;
    var nb: i32 = ts_buckets();
    while (b < nb) { head = head.append(0 - 1); b = b + 1; }
    var next: i32[] = [];
    var k: i32 = 0;
    while (k < names.len()) {
        var bk: i32 = util.hash_bucket(names[k], nb);
        next = next.append(head[bk]);
        head = head.with(bk, k);
        k = k + 1;
    }
    return RefSet { names: names, head: head, next: next };
}

function refset_has(rs: RefSet, name: string): boolean {
    var i: i32 = rs.head[util.hash_bucket(name, rs.head.len())];
    while (i >= 0) {
        if (rs.names[i] == name) { return true; }
        i = rs.next[i];
    }
    return false;
}

function refset_add(rs: RefSet, name: string): RefSet {
    var bk: i32 = util.hash_bucket(name, rs.head.len());
    var names: string[] = rs.names.append(name);
    var next: i32[] = rs.next.append(rs.head[bk]);
    var head: i32[] = rs.head.with(bk, names.len() - 1);
    return RefSet { names: names, head: head, next: next };
}

// ts_kept_name reports whether `fd` is reachable: by exact name, by the method
// name an array-method helper dispatches from, by the one an interposed method
// was renamed away from — each a name the syntax spells where the FUNCTION does
// not — or, for an arithmetic method only, by its receiver type.
function ts_kept_name(fd: parser.FuncDecl, refs: RefSet): boolean {
    if (refset_has(refs, fd.name)) { return true; }
    var m: string = ts_array_method_name(fd.name);
    if (m.len() > 0 && refset_has(refs, m)) { return true; }
    var im: string = ts_interposed_method_name(fd.name);
    if (im.len() > 0 && refset_has(refs, im)) { return true; }
    return ts_arith_method(fd.name) && ts_arith_kept(fd, refs);
}

// treeshake returns `mod` with `mod.funcs` pruned to those reachable, by name,
// from the roots (`main`, top-level statements, WIT exports, Drop finalizers,
// body-bearing async functions). Structs / enums / aliases / imports /
// top_stmts / exports are preserved unchanged (only the function list — the
// IR-budget axis — is pruned). Idempotent.
pub function treeshake(mod: parser.Module): parser.Module {
    // Seed the reachable-name set from the roots.
    var refs: string[] = ["main"];
    var ti: i32 = 0;
    while (ti < mod.top_stmts.len()) { refs = ts_names_stmt(mod.top_stmts[ti], refs); ti = ti + 1; }
    var ei: i32 = 0;
    while (ei < mod.exports.len()) { refs = refs.append(mod.exports[ei].func_name); ei = ei + 1; }

    // A Drop finalizer has no call site to reach: its only caller is the
    // `__drop_struct_<C>` glue lowering synthesises after this pass, so the walk
    // would prune it and leave that glue naming a symbol nothing emitted.
    // Rooted whole-program for the reason native's DropImplMethods is — gating
    // it on whether a live function can hold a `C` is type reachability this
    // pass does not compute. `trait_name` is already the simple name here, so
    // `impl mem.Drop for W` matches without demangling.
    var di: i32 = 0;
    while (di < mod.impls.len()) {
        if (mod.impls[di].trait_name == "Drop") {
            var dm: i32 = 0;
            while (dm < mod.impls[di].method_names.len()) {
                refs = refs.append(mod.impls[di].method_names[dm]);
                dm = dm + 1;
            }
        }
        di = di + 1;
    }

    // A `@derive`d method is the same shape as a Drop finalizer: the program
    // never spells it, and its caller is generated after this pass. A struct
    // used as a map KEY has its `hash` called by the map lowering, so
    // `@derive(cmp.Eq, cmp.Hash) struct Sku` lost `Sku.hash` here and the wasm
    // module was rejected for calling a function it never defines
    // (conformance/cases/map_iter_struct_value and two siblings).
    //
    // Rooted by RECEIVER rather than by a list of the derivable method names.
    // The names are `synth_derives`' business and a new derive would not think
    // to update a copy of them here — where the cost of over-keeping is a
    // hand-written method on a derive-carrying struct surviving, and the cost of
    // under-keeping is a dangling symbol at link time.
    var si: i32 = 0;
    while (si < mod.structs.len()) {
        if (mod.structs[si].derives.len() > 0) {
            var fj: i32 = 0;
            while (fj < mod.funcs.len()) {
                if (mod.funcs[fj].receiver_type == mod.structs[si].name) {
                    refs = refs.append(mod.funcs[fj].name);
                }
                fj = fj + 1;
            }
        }
        si = si + 1;
    }

    // An `async function` with a body is an entry point from outside: the
    // component-level export the wasm path lifts it as. A body-less
    // `@import(...) async` declaration is an import instead, and is excluded by
    // the same `import_iface` test native uses.
    var ai: i32 = 0;
    while (ai < mod.funcs.len()) {
        if (mod.funcs[ai].async && mod.funcs[ai].import_iface.len() == 0) {
            refs = refs.append(mod.funcs[ai].name);
        }
        ai = ai + 1;
    }

    // Grow `refs` to a fixpoint: any function whose name is reachable
    // contributes the names ITS body references. Only genuinely NEW names are
    // appended (membership-checked), so `refs` grows monotonically toward a
    // bounded set and the loop terminates.
    //
    // Each function contributes AT MOST ONCE, tracked by carrying the
    // not-yet-contributed indices in `pending` and rebuilding it each round.
    // A body's name set does not change between rounds, so re-walking it can
    // only re-derive what the first walk already appended — which made the
    // whole-body walk and its per-name membership scan cost one round each
    // rather than one in total. On the compiler compiling itself (6,259
    // functions) that was 26 s of the 82 s compile; contributing once takes the
    // pass to under a second and leaves the result identical.
    var pending: i32[] = [];
    var pi0: i32 = 0;
    while (pi0 < mod.funcs.len()) { pending = pending.append(pi0); pi0 = pi0 + 1; }

    var rs: RefSet = refset_of(refs);
    var changed: boolean = true;
    while (changed) {
        changed = false;
        var still: i32[] = [];
        var pi: i32 = 0;
        while (pi < pending.len()) {
            var fi: i32 = pending[pi];
            if (ts_kept_name(mod.funcs[fi], rs)) {
                var body_names: string[] = ts_func_names(mod.funcs[fi], []);
                var bi: i32 = 0;
                while (bi < body_names.len()) {
                    if (!refset_has(rs, body_names[bi])) {
                        rs = refset_add(rs, body_names[bi]);
                        changed = true;
                    }
                    bi = bi + 1;
                }
            } else {
                still = still.append(fi);
            }
            pi = pi + 1;
        }
        pending = still;
    }

    // Keep only the reachable functions.
    var kept: parser.FuncDecl[] = [];
    var ki: i32 = 0;
    while (ki < mod.funcs.len()) {
        if (ts_kept_name(mod.funcs[ki], rs)) { kept = kept.append(mod.funcs[ki]); }
        ki = ki + 1;
    }
    return parser.Module { funcs: kept, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs, trait_decls: mod.trait_decls };
}
