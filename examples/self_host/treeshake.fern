// examples/self_host/treeshake.fern — reachability-based dead-code
// elimination for the self-hosted compiler.
//
// Loading a stdlib module (`import "core/cmp"`) pulls in its WHOLE transitive
// closure — core/sort, core/int, char-predicate helpers, generic comparison
// helpers (`min`/`max`/`lt`/…) — most of which a given program never uses.
// That bloats the merged module past asm_ir's 512-function IR budget (and the
// uninstantiated generics individually bail the IR-eligibility gate), so a
// stdlib-importing program could not compile at all. `treeshake`
// prunes `mod.funcs` to the functions REACHABLE from `main` (+ top-level
// statements + WIT exports), so a program that uses only `i32`'s `eq`/`hash`
// drops the hundreds of unrelated stdlib functions and fits the IR path.
//
// SOUNDNESS — the prune must never drop a function the program can reach. It
// over-approximates reachability by NAME: a function is kept if its name
// appears anywhere reachable as
//   * an identifier read (`f(...)`, a function value, a mangled call target),
//   * a field/method name (`x.eq(...)` keeps every `*.eq`),
//   * the trait method an operator desugars to (`a < b` keeps `*.cmp`,
//     `a + b` keeps `*.add`, …) — covering operator overloading even if the
//     `+`→`.add()` rewrite has not run yet.
// The collector rides astwalk's fold spine, so it reaches every Expr/Stmt
// form the parser produces, and, unlike astwalk's capture analysis, does NOT
// subtract lambda-local bindings — for reachability, keeping an extra
// same-named function is harmless; dropping a referenced one is not.
// Over-keeping only costs IR budget; it never changes behaviour.

import "./ast";
import "./astwalk";
import "./parser";
import "./util";

// ts_op_method maps a (possibly overloadable) operator to the trait method it
// dispatches to, so `a <op> b` keeps that method even before the operator-
// overload desugar rewrites it to an explicit call. "" for non-overloadable.
function ts_op_method(op: string): string {
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") { return "div"; }
    if (op == "%") { return "rem"; }
    if (op == "==" || op == "!=") { return "eq"; }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") { return "cmp"; }
    return "";
}

// ts_name_of contributes the names ONE node could reference; astwalk's fold
// supplies the walk, including lambda bodies (their calls are reachable, and
// lambda-local bindings are deliberately not subtracted). Every variant is
// spelled out rather than wildcarded so a new expression kind fails E030 here
// and gets a reachability decision, not a silent empty contribution — the
// soundness property the hand-written walk this replaces had.
function ts_name_of(e: ast.Expr, acc: string[]): string[] {
    match (e) {
        ast.ExprIdent(id) => { return acc.append(id.name); },
        ast.ExprBinary(b) => {
            var m: string = ts_op_method(b.op);
            if (m.len() > 0) { return acc.append(m); }
            return acc;
        },
        ast.ExprUnary(u) => {
            if (u.op == "-") { return acc.append("neg"); }
            return acc;
        },
        // A method/field name (`x.eq`) is a reference: keep every function with
        // that simple name. An array-method call `arr.<m>(...)` (`.join` /
        // `.concat` / `.reverse` / `.flat_map` / `.sort_by` / std/array's
        // distinct, mode, …) dispatches to the auto-discovered
        // `__method_Array_<m>` helper, but the syntax names only `<m>` — so
        // without this the helper looks unreachable and gets pruned, bailing
        // the whole module (the IR path then fails on `i32.<m>`).
        // Append the helper's canonical token so ts_kept_name retains it.
        ast.ExprFieldAccess(fa) => {
            acc = acc.append(fa.field);
            return acc.append("__method_Array_" + fa.field);
        },
        ast.ExprNumber(_) => { return acc; },
        ast.ExprString(_) => { return acc; },
        ast.ExprBool(_) => { return acc; },
        ast.ExprCall(_) => { return acc; },
        ast.ExprArray(_) => { return acc; },
        ast.ExprTuple(_) => { return acc; },
        ast.ExprMapLit(_) => { return acc; },
        ast.ExprFString(_) => { return acc; },
        ast.ExprIndex(_) => { return acc; },
        ast.ExprSlice(_) => { return acc; },
        ast.ExprStructLit(_) => { return acc; },
        ast.ExprLambda(_) => { return acc; },
        ast.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

// ts_names_expr appends every name `e` could REFERENCE (idents, field/method
// names, operator-dispatch methods) to `acc`. Duplicates are fine.
function ts_names_expr(e: ast.Expr, acc: string[]): string[] {
    return astwalk.fold_expr(e, acc, ts_name_of);
}

// ts_names_stmt appends every name `st` could reference to `acc`.
function ts_names_stmt(st: ast.Stmt, acc: string[]): string[] {
    return astwalk.fold_stmt(st, acc, ts_name_of);
}

// ts_func_names appends every name function `fd`'s body references to `acc`.
function ts_func_names(fd: parser.FuncDecl, acc: string[]): string[] {
    var i: i32 = 0;
    while (i < fd.body.len()) { acc = ts_names_stmt(fd.body[i], acc); i = i + 1; }
    return acc;
}

// ts_array_method_canon returns the canonical `__method_Array_<m>` token of an
// array-method helper name — stripping any `<mod>__` mangling prefix modload
// added — or "" if `name` is not such a helper. The method-call syntax
// `arr.<m>(...)` references the helper only by `m`, so treeshake traces it by
// this token (appended at every `.<m>` field access) rather than by the
// mangled function name, which the syntax never spells.
function ts_array_method_canon(name: string): string {
    var marker: string = "__method_Array_";
    if (name.len() < marker.len()) { return ""; }
    var i: i32 = 0;
    while (i <= name.len() - marker.len()) {
        if (slice_unchecked(name, i, i + marker.len()) == marker) { return slice_unchecked(name, i, name.len()) + ""; }
        i = i + 1;
    }
    return "";
}

// ts_kept_name reports whether function `name` is reachable: by exact name, or
// — for an array-method helper — by its canonical token being in `refs`.
function ts_kept_name(name: string, refs: string[]): boolean {
    if (util.has_str(refs, name)) { return true; }
    var canon: string = ts_array_method_canon(name);
    return canon.len() > 0 && util.has_str(refs, canon);
}

// treeshake returns `mod` with `mod.funcs` pruned to those reachable, by name,
// from the roots (`main`, top-level statements, WIT exports). Structs / enums /
// aliases / imports / top_stmts / exports are preserved unchanged (only the
// function list — the IR-budget axis — is pruned). Idempotent.
pub function treeshake(mod: parser.Module): parser.Module {
    // Seed the reachable-name set from the roots.
    var refs: string[] = ["main"];
    var ti: i32 = 0;
    while (ti < mod.top_stmts.len()) { refs = ts_names_stmt(mod.top_stmts[ti], refs); ti = ti + 1; }
    var ei: i32 = 0;
    while (ei < mod.exports.len()) { refs = refs.append(mod.exports[ei].func_name); ei = ei + 1; }

    // Grow `refs` to a fixpoint: any function whose name is reachable
    // contributes the names ITS body references. Only genuinely NEW names are
    // appended (membership-checked), so `refs` grows monotonically toward a
    // bounded set and the loop terminates.
    var changed: boolean = true;
    while (changed) {
        changed = false;
        var fi: i32 = 0;
        while (fi < mod.funcs.len()) {
            if (ts_kept_name(mod.funcs[fi].name, refs)) {
                var body_names: string[] = ts_func_names(mod.funcs[fi], []);
                var bi: i32 = 0;
                while (bi < body_names.len()) {
                    if (!util.has_str(refs, body_names[bi])) {
                        refs = refs.append(body_names[bi]);
                        changed = true;
                    }
                    bi = bi + 1;
                }
            }
            fi = fi + 1;
        }
    }

    // Keep only the reachable functions.
    var kept: parser.FuncDecl[] = [];
    var ki: i32 = 0;
    while (ki < mod.funcs.len()) {
        if (ts_kept_name(mod.funcs[ki].name, refs)) { kept = kept.append(mod.funcs[ki]); }
        ki = ki + 1;
    }
    return parser.Module { funcs: kept, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs, trait_decls: mod.trait_decls };
}
