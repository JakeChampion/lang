// examples/self_host/ssa_emit_run.fern — driver for the SSA backends.
// Reads a program on stdin, lowers each in-subset function to SSA
// (build_func), optimises it, and prints the emitted assembly to stdout —
// x86-64 by default, or arm64 with `-target arm64`. The companion Go tests
// assemble the output (`gcc -static -nostdlib [-no-pie]`) and run it,
// asserting the process exit code matches the program's value — end-to-end
// proof that AST → SSA → optimise → emit → execute preserves semantics.

import "core/no_prelude";
import "std/io";
import "./lexer";
import "./parser";
import "./ssa";
import "./ssa_x86";
import "./ssa_arm64";

function main(): i32 {
    var av: string[] = args();
    var target: string = "x86-64";
    var use_regalloc: boolean = false;
    var ai: i32 = 1;
    while (ai < av.len()) {
        if (av[ai] == "-target") { ai = ai + 1; if (ai < av.len()) { target = av[ai]; } }
        else if (av[ai] == "-regalloc") { use_regalloc = true; }
        ai = ai + 1;
    }

    var mod: parser.Module = parser.parse_module(lexer.tokenize(io.read_all_stdin()));
    // Several lowerings (build_func) emit calls to injected runtime helper
    // functions (__ssa_*) defined in pure Fern (ssa.ssa_helpers_src) — the map
    // operations and array push. Parse them up front so their pointer-
    // returning signatures join ptr_ret (the handle is an i32[]); each helper
    // body is built + emitted only if a program actually calls it.
    var hmod: parser.Module = parser.parse_module(lexer.tokenize(ssa.ssa_helpers_src()));
    // Names of functions that return a pointer (array / string), so calls to
    // them get a 64-bit result — user functions plus the runtime helpers.
    var ptr_ret: string[] = [];
    var pi: i32 = 0;
    while (pi < mod.funcs.len()) {
        if (ssa.is_ptr_type(mod.funcs[pi].ret_type) || ssa.is_struct_type(mod.funcs[pi].ret_type, mod.structs)) { ptr_ret = ptr_ret.push(mod.funcs[pi].name); }
        pi = pi + 1;
    }
    var hi0: i32 = 0;
    while (hi0 < hmod.funcs.len()) {
        if (ssa.is_ptr_type(hmod.funcs[hi0].ret_type)) { ptr_ret = ptr_ret.push(hmod.funcs[hi0].name); }
        hi0 = hi0 + 1;
    }
    // Lambdas bound as `var f = function(...){...}` are lifted to top-level
    // functions (collect_lambdas); build them like any user function. A
    // pointer-returning lambda joins ptr_ret before the build loop so callers
    // mark its result 64-bit.
    var lifted: parser.FuncDecl[] = ssa.collect_lambdas(mod.funcs);
    var li0: i32 = 0;
    while (li0 < lifted.len()) {
        if (ssa.is_ptr_type(lifted[li0].ret_type) || ssa.is_struct_type(lifted[li0].ret_type, mod.structs)) { ptr_ret = ptr_ret.push(lifted[li0].name); }
        li0 = li0 + 1;
    }
    var funcs: ssa.SFunc[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var r: ssa.BResult = ssa.build_func(mod.funcs[i], mod.structs, mod.funcs);
        if (r.ok) { funcs = funcs.push(ssa.optimize(ssa.mark_ptr_calls(r.func, ptr_ret))); }
        i = i + 1;
    }
    var li: i32 = 0;
    while (li < lifted.len()) {
        var lr: ssa.BResult = ssa.build_func(lifted[li], mod.structs, mod.funcs);
        if (lr.ok) { funcs = funcs.push(ssa.optimize(ssa.mark_ptr_calls(lr.func, ptr_ret))); }
        li = li + 1;
    }
    // Inject each runtime helper body only when the program actually calls it
    // (helpers don't call each other, so a single direct-call check suffices —
    // no transitive closure needed).
    var hi: i32 = 0;
    while (hi < hmod.funcs.len()) {
        if (ssa.calls_func(funcs, hmod.funcs[hi].name)) {
            var hr: ssa.BResult = ssa.build_func(hmod.funcs[hi], mod.structs, mod.funcs);
            if (hr.ok) { funcs = funcs.push(ssa.optimize(ssa.mark_ptr_calls(hr.func, ptr_ret))); }
        }
        hi = hi + 1;
    }
    if (target == "arm64") { write(ssa_arm64.emit_program(funcs, use_regalloc)); }
    else { write(ssa_x86.emit_program(funcs, use_regalloc)); }
    return 0;
}
