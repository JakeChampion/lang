// Checked source to typed semantic values, before any ownership decision.
// Every value carries the checker's resolved type. Source names are places
// that resolve to value identities; no ownership fact is read from syntax.
import "./ast";
import "./parser";
import "./checker";
import "./typeinfo";
import "./semtypes";
import "./ssa";
import "./ssasem";
import "./ssaunits";
import "./util";

pub struct Produced { ok: boolean, why: string, func: ssasem.Func, modes: i32[] }

// Environments are the values of the bindings visible at loop entry, in
// binding order, captured where a body leaves the loop.
struct Exit { block: i32, env: i32[] }
struct Loop { header: i32, exit: i32, entry_count: i32, breaks: Exit[], continues: Exit[] }

struct State {
    ok: boolean,
    why: string,
    blocks: ssa.SBlock[],
    cur: ssa.SBlock,
    // The open block is reachable. After return, break or continue the
    // remaining statements of the body have no block.
    live: boolean,
    next_block: i32,
    values: typeinfo.Type[],
    names: string[],
    vals: i32[],
    scope: checker.Scope,
    result: typeinfo.Type,
    loops: Loop[],
    // Every module function's declared contract, and the ones this body calls.
    contracts: ssasem.Contract[],
    calls: ssasem.Contract[]
}

struct Value { s: State, id: i32 }

function t_i32(): typeinfo.Type { return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false }; }
function t_bool(): typeinfo.Type { return typeinfo.TypeBool { tag: 0 }; }
function t_void(): typeinfo.Type { return typeinfo.TypeVoid { tag: 0 }; }
function is_i32(t: typeinfo.Type): boolean { return semtypes.equal(t, t_i32()); }
function is_bool(t: typeinfo.Type): boolean { return semtypes.equal(t, t_bool()); }
function is_void(t: typeinfo.Type): boolean {
    if let typeinfo.TypeVoid(_) = t { return true; }
    return false;
}

function fail(s: State, why: string): State {
    if (!s.ok) { return s; }
    return State { ...s, ok: false, why: why };
}
function refused(s: State, why: string): Value { return Value { s: fail(s, why), id: 0 - 1 }; }

function prefix(xs: i32[], n: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < n) { out = out.append(xs[i]); i = i + 1; }
    return out;
}
function prefix_names(xs: string[], n: i32): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < n) { out = out.append(xs[i]); i = i + 1; }
    return out;
}

function inst(kind: i32, result: i32, args: i32[], imm: i32, str: string): ssa.SInst {
    return ssa.SInst { kind_tag: kind, result: result, args: args, imm: imm, str: str };
}
function t_ret(value: i32): ssa.STerm { return ssa.STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: value }; }
function t_br(target: i32): ssa.STerm { return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 }; }
function t_brif(cond: i32, t: i32, f: i32): ssa.STerm { return ssa.STerm { kind_tag: 3, cond: cond, target: 0, t: t, f: f, value: 0 }; }
function t_none(): ssa.STerm { return ssa.STerm { kind_tag: 0, cond: 0, target: 0, t: 0, f: 0, value: 0 }; }

// ---- graph construction ---------------------------------------------------

function emit(s: State, ins: ssa.SInst): State {
    return State { ...s, cur: ssa.SBlock { ...s.cur, insts: s.cur.insts.append(ins) } };
}

// A value is its type; identity is the index. Emission follows definition.
function define(s: State, kind: i32, args: i32[], imm: i32, str: string, ty: typeinfo.Type): Value {
    var id: i32 = s.values.len();
    var next: State = State { ...s, values: s.values.append(ty) };
    return Value { s: emit(next, inst(kind, id, args, imm, str)), id: id };
}

function open(s: State, id: i32, preds: i32[]): State {
    return State { ...s, cur: ssa.SBlock { id: id, insts: [], term: t_none(), preds: preds }, live: true };
}

function terminate(s: State, term: ssa.STerm): State {
    if (!s.live) { return s; }
    var closed: ssa.SBlock = ssa.SBlock { ...s.cur, term: term };
    return State { ...s, blocks: s.blocks.append(closed), live: false };
}

// ---- bindings ---------------------------------------------------------------

function lookup(s: State, name: string): i32 {
    var i: i32 = s.names.len() - 1;
    while (i >= 0) {
        if (s.names[i] == name) { return s.vals[i]; }
        i = i - 1;
    }
    return 0 - 1;
}

function bind(s: State, name: string, value: i32): State {
    return State { ...s, names: s.names.append(name), vals: s.vals.append(value) };
}

function replace(s: State, name: string, value: i32): State {
    var i: i32 = s.names.len() - 1;
    while (i >= 0) {
        if (s.names[i] == name) { return State { ...s, vals: s.vals.with(i, value) }; }
        i = i - 1;
    }
    return fail(s, "replacement of an unbound name");
}

function leave(s: State, count: i32, scope: checker.Scope): State {
    return State { ...s, names: prefix_names(s.names, count), vals: prefix(s.vals, count), scope: scope };
}

// Merge one binding across incoming edges. Identical inputs need no phi;
// a phi's arity is the destination's predecessor list.
function merge_binding(s: State, envs: i32[][], at: i32): Value {
    var first: i32 = envs[0][at];
    var same: boolean = true;
    var args: i32[] = [];
    for env in envs {
        if (env[at] != first) { same = false; }
        args = args.append(env[at]);
    }
    if (same) { return Value { s: s, id: first }; }
    return define(s, 8, args, 0, "", s.values[first]);
}

function merge_env(s: State, envs: i32[][], count: i32): State {
    var vals: i32[] = [];
    var at: i32 = 0;
    while (at < count) {
        var merged: Value = merge_binding(s, envs, at);
        s = merged.s;
        vals = vals.append(merged.id);
        at = at + 1;
    }
    return State { ...s, vals: vals };
}

// ---- expressions ------------------------------------------------------------

function checked(e: ast.Expr, s: State): typeinfo.Type { return checker.expr_type(e, s.scope); }

function decimal(text: string): boolean {
    if (text.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < text.len()) {
        if (text[i] < b'0' || text[i] > b'9') { return false; }
        i = i + 1;
    }
    return true;
}

function number(n: ast.ExprNumber, s: State): Value {
    if (parser.is_unit_literal(n) || n.is_float || !decimal(n.text)) { return refused(s, "unsupported literal"); }
    if (n.suffix != "" && n.suffix != "i32") { return refused(s, "unsupported literal width"); }
    return define(s, 1, [], util.lit_to_i32(n.text), "", t_i32());
}

function boolean_value(b: boolean): i32 {
    if (b) { return 1; }
    return 0;
}

function ident(id: ast.ExprIdent, s: State): Value {
    var value: i32 = lookup(s, id.name);
    if (value < 0) { return refused(s, "unbound name is not a semantic value"); }
    return Value { s: s, id: value };
}

function element_type(t: typeinfo.Type): typeinfo.Type {
    if let typeinfo.TypeArray(a) = t { return a.elem; }
    return typeinfo.unchecked();
}

function tuple_element_type(t: typeinfo.Type, at: i32): typeinfo.Type {
    if let typeinfo.TypeTuple(tup) = t { if (at < tup.elements.len()) { return tup.elements[at]; } }
    return typeinfo.unchecked();
}

// An empty literal has no element to name its type; the binding or
// enclosing container it initializes supplies the checked type.
function array(e: ast.Expr, a: ast.ExprArray, s: State, expected: typeinfo.Type): Value {
    var ty: typeinfo.Type = checked(e, s);
    if (!semtypes.concrete(ty, false)) { ty = expected; }
    if (!semtypes.concrete(ty, false)) { return refused(s, "unresolved array literal type"); }
    var elem: typeinfo.Type = element_type(ty);
    var ids: i32[] = [];
    for e in a.elements {
        var v: Value = expr(e, s, elem);
        s = v.s;
        if (!s.ok) { return Value { s: s, id: 0 - 1 }; }
        if (!semtypes.equal(s.values[v.id], elem)) { return refused(s, "array element type"); }
        ids = ids.append(v.id);
    }
    return define(s, ssasem.array_new(), ids, 0, "", ty);
}

function tuple(e: ast.Expr, t: ast.ExprTuple, s: State, expected: typeinfo.Type): Value {
    var ty: typeinfo.Type = checked(e, s);
    if (!semtypes.concrete(ty, false)) { ty = expected; }
    var ids: i32[] = [];
    var types: typeinfo.Type[] = [];
    var at: i32 = 0;
    while (at < t.elements.len()) {
        var v: Value = expr(t.elements[at], s, tuple_element_type(ty, at));
        s = v.s;
        if (!s.ok) { return Value { s: s, id: 0 - 1 }; }
        ids = ids.append(v.id);
        types = types.append(s.values[v.id]);
        at = at + 1;
    }
    var built: typeinfo.Type = typeinfo.TypeTuple { elements: types };
    if (semtypes.concrete(ty, false) && !semtypes.equal(built, ty)) { return refused(s, "tuple element type"); }
    return define(s, ssasem.tuple_new(), ids, 0, "", built);
}

function index(ix: ast.ExprIndex, s: State): Value {
    var container: Value = expr(ix.array, s, typeinfo.unchecked());
    var at: Value = expr(ix.index, container.s, t_i32());
    s = at.s;
    if (!s.ok) { return at; }
    var elem: typeinfo.Type = element_type(s.values[container.id]);
    if (!is_i32(s.values[at.id]) || !semtypes.concrete(elem, false)) { return refused(s, "array projection contract"); }
    return define(s, ssasem.array_get(), [container.id, at.id], 0, "", elem);
}

function field(fa: ast.ExprFieldAccess, s: State): Value {
    if (!decimal(fa.field)) { return refused(s, "unsupported projection"); }
    var container: Value = expr(fa.obj, s, typeinfo.unchecked());
    s = container.s;
    if (!s.ok) { return container; }
    var at: i32 = util.lit_to_i32(fa.field);
    var elem: typeinfo.Type = tuple_element_type(s.values[container.id], at);
    if (!semtypes.concrete(elem, false)) { return refused(s, "tuple projection contract"); }
    return define(s, ssasem.tuple_get(), [container.id], at, "", elem);
}

function binary(b: ast.ExprBinary, s: State): Value {
    if (b.op == "&&" || b.op == "||") { return logical(b, s); }
    var left: Value = expr(b.left, s, typeinfo.unchecked());
    var right: Value = expr(b.right, left.s, typeinfo.unchecked());
    s = right.s;
    if (!s.ok) { return right; }
    var ty: typeinfo.Type = ssasem.binary_result(b.op, s.values[left.id], s.values[right.id]);
    if (!semtypes.concrete(ty, false)) { return refused(s, "operator contract"); }
    return define(s, 9, [left.id, right.id], 0, b.op, ty);
}

function unary(u: ast.ExprUnary, s: State): Value {
    var operand: Value = expr(u.operand, s, typeinfo.unchecked());
    s = operand.s;
    if (!s.ok) { return operand; }
    var ty: typeinfo.Type = ssasem.unary_result(u.op, s.values[operand.id]);
    if (!semtypes.concrete(ty, false)) { return refused(s, "operator contract"); }
    return define(s, 10, [operand.id], 0, u.op, ty);
}

// Short-circuit operators are control flow: the right operand runs on its
// own edge and the result joins as a boolean phi.
function logical(b: ast.ExprBinary, s: State): Value {
    var left: Value = expr(b.left, s, t_bool());
    s = left.s;
    if (!s.ok) { return left; }
    if (!is_bool(s.values[left.id])) { return refused(s, "operator contract"); }
    var pred: i32 = s.cur.id;
    var rhs: i32 = s.next_block;
    var skip: i32 = rhs + 1;
    var join: i32 = rhs + 2;
    s = State { ...s, next_block: join + 1 };
    if (b.op == "&&") { s = terminate(s, t_brif(left.id, rhs, skip)); }
    else { s = terminate(s, t_brif(left.id, skip, rhs)); }
    var right: Value = expr(b.right, open(s, rhs, [pred]), t_bool());
    s = right.s;
    if (!s.ok) { return right; }
    if (!is_bool(s.values[right.id])) { return refused(s, "operator contract"); }
    var rhs_end: i32 = s.cur.id;
    s = terminate(s, t_br(join));
    var short: Value = define(open(s, skip, [pred]), 2, [], boolean_value(b.op == "||"), "", t_bool());
    s = terminate(short.s, t_br(join));
    return define(open(s, join, [rhs_end, skip]), 8, [right.id, short.id], 0, "", t_bool());
}

// A call is verified against the callee's declared contract: exact argument
// types, and a result the callee hands over. Only a module function with a
// contract is a call target; builtins, methods and local function values are
// outside this boundary.
function call(c: ast.ExprCall, s: State): Value {
    var name: string = "";
    if let ast.ExprIdent(id) = c.callee { name = id.name; }
    if (name == "" || lookup(s, name) >= 0) { return refused(s, "unsupported call target"); }
    var at: i32 = ssasem.find_contract(s.contracts, name);
    if (at < 0) { return refused(s, "call target has no semantic contract"); }
    var contract: ssasem.Contract = s.contracts[at];
    if (c.type_argc > 0 || c.args.len() != contract.params.len()) { return refused(s, "call arity"); }
    if (is_void(contract.result)) { return refused(s, "unsupported void call"); }
    var ids: i32[] = [];
    var i: i32 = 0;
    while (i < c.args.len()) {
        var v: Value = expr(c.args[i], s, contract.params[i]);
        s = v.s;
        if (!s.ok) { return v; }
        if (!semtypes.equal(s.values[v.id], contract.params[i])) { return refused(s, "call argument type"); }
        ids = ids.append(v.id);
        i = i + 1;
    }
    if (ssasem.find_contract(s.calls, name) < 0) { s = State { ...s, calls: s.calls.append(contract) }; }
    return define(s, ssasem.call(), ids, 0, name, contract.result);
}

function expr(e: ast.Expr, s: State, expected: typeinfo.Type): Value {
    if (!s.ok) { return Value { s: s, id: 0 - 1 }; }
    match (e) {
        ast.ExprNumber(n) => { return number(n, s); },
        ast.ExprBool(b) => { return define(s, 2, [], boolean_value(b.value), "", t_bool()); },
        ast.ExprIdent(id) => { return ident(id, s); },
        ast.ExprArray(a) => { return array(e, a, s, expected); },
        ast.ExprTuple(t) => { return tuple(e, t, s, expected); },
        ast.ExprIndex(ix) => { return index(ix, s); },
        ast.ExprFieldAccess(fa) => { return field(fa, s); },
        ast.ExprBinary(b) => { return binary(b, s); },
        ast.ExprUnary(u) => { return unary(u, s); },
        ast.ExprCall(c) => { return call(c, s); },
        _ => { return refused(s, "unsupported expression"); }
    }
}

// ---- statements -------------------------------------------------------------

function destructures(v: ast.StmtVar): boolean {
    var i: i32 = 0;
    while (i < v.name.len()) {
        if (v.name[i] == b',') { return true; }
        i = i + 1;
    }
    return parser.is_destr_marker(v.type_name);
}

// The checker's post-declaration scope names the binding's type; the
// initializer's semantic value must carry exactly that type.
function declare(st: ast.Stmt, v: ast.StmtVar, s: State): State {
    if (destructures(v)) { return fail(s, "unsupported destructuring declaration"); }
    var after: checker.Scope = checker.bind_stmt(st, s.scope);
    var ty: typeinfo.Type = checker.scope_type(after, v.name);
    if (!semtypes.concrete(ty, false)) { return fail(s, "unresolved binding type"); }
    var init: Value = expr(v.init, s, ty);
    s = init.s;
    if (!s.ok) { return s; }
    if (!semtypes.equal(s.values[init.id], ty)) { return fail(s, "binding type does not match its semantic value"); }
    return State { ...bind(s, v.name, init.id), scope: after };
}

function assign(a: ast.StmtAssign, s: State): State {
    var old: i32 = lookup(s, a.target);
    if (old < 0) { return fail(s, "replacement of an unbound name"); }
    var value: Value = expr(a.value, s, s.values[old]);
    s = value.s;
    if (!s.ok) { return s; }
    if (!semtypes.equal(s.values[value.id], s.values[old])) { return fail(s, "replacement type does not match its binding"); }
    return replace(s, a.target, value.id);
}

function ret(r: ast.StmtReturn, s: State): State {
    if (parser.is_unit_expr(r.value)) {
        if (!is_void(s.result)) { return fail(s, "missing return value"); }
        return terminate(s, t_ret(0 - 1));
    }
    var value: Value = expr(r.value, s, s.result);
    s = value.s;
    if (!s.ok) { return s; }
    if (!semtypes.equal(s.values[value.id], s.result)) { return fail(s, "return type"); }
    return terminate(s, t_ret(value.id));
}

struct Arm { s: State, live: boolean, end: i32, env: i32[] }

// Each arm starts from the environment at the branch, not from its sibling's.
function arm(body: ast.Stmt[], s: State, entry: i32[], id: i32, pred: i32, join: i32, count: i32, scope: checker.Scope): Arm {
    s = stmts(body, open(State { ...s, vals: entry }, id, [pred]));
    var live: boolean = s.live && s.ok;
    var end: i32 = s.cur.id;
    var env: i32[] = prefix(s.vals, count);
    s = terminate(s, t_br(join));
    return Arm { s: State { ...s, scope: scope }, live: live, end: end, env: env };
}

function branch(f: ast.StmtIf, s: State): State {
    var cond: Value = expr(f.cond, s, t_bool());
    s = cond.s;
    if (!s.ok) { return s; }
    if (!is_bool(s.values[cond.id])) { return fail(s, "condition type"); }
    var pred: i32 = s.cur.id;
    var then_id: i32 = s.next_block;
    var else_id: i32 = then_id + 1;
    var join: i32 = then_id + 2;
    s = State { ...s, next_block: join + 1 };
    var count: i32 = s.names.len();
    var entry: i32[] = s.vals;
    var scope: checker.Scope = s.scope;
    s = terminate(s, t_brif(cond.id, then_id, else_id));
    var t: Arm = arm(f.then_body, s, entry, then_id, pred, join, count, scope);
    var e: Arm = arm(f.else_body, t.s, entry, else_id, pred, join, count, scope);
    s = e.s;
    if (!s.ok) { return s; }
    var preds: i32[] = [];
    var envs: i32[][] = [];
    if (t.live) { preds = preds.append(t.end); envs = envs.append(t.env); }
    if (e.live) { preds = preds.append(e.end); envs = envs.append(e.env); }
    if (preds.len() == 0) { return s; }
    return merge_env(open(s, join, preds), envs, count);
}

function current_loop(s: State): Loop { return s.loops[s.loops.len() - 1]; }

function with_loop(s: State, l: Loop): State {
    return State { ...s, loops: s.loops.with(s.loops.len() - 1, l) };
}

function leave_loop(s: State, label: string, is_break: boolean): State {
    if (s.loops.len() == 0) { return fail(s, "loop exit outside a loop"); }
    if (label != "") { return fail(s, "unsupported labelled loop exit"); }
    var l: Loop = current_loop(s);
    var e: Exit = Exit { block: s.cur.id, env: prefix(s.vals, l.entry_count) };
    if (is_break) { s = with_loop(s, Loop { ...l, breaks: l.breaks.append(e) }); return terminate(s, t_br(l.exit)); }
    s = with_loop(s, Loop { ...l, continues: l.continues.append(e) });
    return terminate(s, t_br(l.header));
}

// Header phis are created before the body is known and completed afterwards
// from the back edges the body actually produced.
function header_phis(s: State, count: i32): State {
    var at: i32 = 0;
    while (at < count) {
        var entry: i32 = s.vals[at];
        var phi: Value = define(s, 8, [entry], 0, "", s.values[entry]);
        s = State { ...phi.s, vals: phi.s.vals.with(at, phi.id) };
        at = at + 1;
    }
    return s;
}

function complete_header(s: State, header: i32, exits: Exit[]): State {
    var i: i32 = 0;
    while (i < s.blocks.len() && s.blocks[i].id != header) { i = i + 1; }
    if (i == s.blocks.len()) { return fail(s, "loop header is still open"); }
    var b: ssa.SBlock = s.blocks[i];
    var preds: i32[] = b.preds;
    var insts: ssa.SInst[] = b.insts;
    for e in exits {
        preds = preds.append(e.block);
        var at: i32 = 0;
        while (at < e.env.len()) {
            var phi: ssa.SInst = insts[at];
            insts = insts.with(at, ssa.SInst { ...phi, args: phi.args.append(e.env[at]) });
            at = at + 1;
        }
    }
    return State { ...s, blocks: s.blocks.with(i, ssa.SBlock { ...b, preds: preds, insts: insts }) };
}

function iterate(w: ast.StmtWhile, s: State): State {
    if (w.label != "") { return fail(s, "unsupported labelled loop"); }
    var pred: i32 = s.cur.id;
    var header: i32 = s.next_block;
    var body: i32 = header + 1;
    var exit_id: i32 = header + 2;
    s = State { ...s, next_block: exit_id + 1 };
    var count: i32 = s.names.len();
    var scope: checker.Scope = s.scope;
    s = terminate(s, t_br(header));
    s = header_phis(open(s, header, [pred]), count);
    var entry_env: i32[] = s.vals;
    s = State { ...s, loops: s.loops.append(Loop { header: header, exit: exit_id, entry_count: count, breaks: [], continues: [] }) };
    var cond: Value = expr(w.cond, s, t_bool());
    s = cond.s;
    if (!s.ok) { return s; }
    if (!is_bool(s.values[cond.id])) { return fail(s, "condition type"); }
    var cond_end: i32 = s.cur.id;
    s = terminate(s, t_brif(cond.id, body, exit_id));
    var latch: Arm = arm(w.body, s, entry_env, body, cond_end, header, count, scope);
    s = latch.s;
    if (!s.ok) { return s; }
    var l: Loop = current_loop(s);
    s = State { ...s, loops: prefix_loops(s.loops, s.loops.len() - 1) };
    var back: Exit[] = l.continues;
    if (latch.live) { back = back.append(Exit { block: latch.end, env: latch.env }); }
    s = complete_header(s, header, back);
    var preds: i32[] = [cond_end];
    var envs: i32[][] = [entry_env];
    for e in l.breaks { preds = preds.append(e.block); envs = envs.append(e.env); }
    return merge_env(open(s, exit_id, preds), envs, count);
}

function prefix_loops(xs: Loop[], n: i32): Loop[] {
    var out: Loop[] = [];
    var i: i32 = 0;
    while (i < n) { out = out.append(xs[i]); i = i + 1; }
    return out;
}

// A discarded call result is a value nothing reads; the unit planner
// releases it at the call.
function discard(e: ast.Expr, s: State): State {
    match (e) {
        ast.ExprCall(c) => { return call(c, s).s; },
        _ => { return fail(s, "unsupported statement"); }
    }
    return s;
}

function stmt(st: ast.Stmt, s: State): State {
    if (!s.ok || !s.live) { return s; }
    match (st) {
        ast.StmtVar(v) => { return declare(st, v, s); },
        ast.StmtExpr(e) => { return discard(e.value, s); },
        ast.StmtAssign(a) => { return assign(a, s); },
        ast.StmtReturn(r) => { return ret(r, s); },
        ast.StmtIf(f) => { return branch(f, s); },
        ast.StmtWhile(w) => { return iterate(w, s); },
        ast.StmtBreak(b) => { return leave_loop(s, b.label, true); },
        ast.StmtContinue(c) => { return leave_loop(s, c.label, false); },
        _ => { return fail(s, "unsupported statement"); }
    }
}

function stmts(body: ast.Stmt[], s: State): State {
    var count: i32 = s.names.len();
    var scope: checker.Scope = s.scope;
    for st in body { s = stmt(st, s); }
    return leave(s, count, scope);
}

// ---- simplification ---------------------------------------------------------

function resolve(map: i32[], v: i32): i32 {
    while (map[v] != v) { v = map[v]; }
    return v;
}

function trivial_source(ins: ssa.SInst, map: i32[]): i32 {
    var source: i32 = 0 - 1;
    for arg in ins.args {
        var v: i32 = resolve(map, arg);
        if (v == ins.result) { continue; }
        if (source >= 0 && v != source) { return 0 - 1; }
        source = v;
    }
    return source;
}

// A phi whose inputs all name one other value is that value. Loop headers
// create one phi per binding before the body is known, so most are trivial.
function trivial_phis(blocks: ssa.SBlock[], nvals: i32): i32[] {
    var map: i32[] = [];
    var i: i32 = 0;
    while (i < nvals) { map = map.append(i); i = i + 1; }
    var changed: boolean = true;
    while (changed) {
        changed = false;
        for b in blocks {
            for ins in b.insts {
                if (ins.kind_tag != 8 || map[ins.result] != ins.result) { continue; }
                var source: i32 = trivial_source(ins, map);
                if (source >= 0) { map = map.with(ins.result, source); changed = true; }
            }
        }
    }
    return map;
}

function mapped_args(args: i32[], map: i32[]): i32[] {
    var out: i32[] = [];
    for a in args { out = out.append(resolve(map, a)); }
    return out;
}

function mapped_term(t: ssa.STerm, map: i32[]): ssa.STerm {
    if (t.kind_tag == 1 && t.value >= 0) { return ssa.STerm { ...t, value: resolve(map, t.value) }; }
    if (t.kind_tag == 3) { return ssa.STerm { ...t, cond: resolve(map, t.cond) }; }
    return t;
}

// Removed phis leave no gaps: surviving definitions are renumbered densely
// in block order, keeping parameters at their declared positions.
function renumber(blocks: ssa.SBlock[], map: i32[], values: typeinfo.Type[]): ssasem.Func {
    var ids: i32[] = [];
    var kept: typeinfo.Type[] = [];
    var i: i32 = 0;
    while (i < map.len()) { ids = ids.append(0 - 1); i = i + 1; }
    for b in blocks {
        for ins in b.insts {
            if (map[ins.result] != ins.result) { continue; }
            ids = ids.with(ins.result, kept.len());
            kept = kept.append(values[ins.result]);
        }
    }
    var out: ssa.SBlock[] = [];
    for b in blocks {
        var insts: ssa.SInst[] = [];
        for ins in b.insts {
            if (map[ins.result] != ins.result) { continue; }
            var args: i32[] = [];
            for a in mapped_args(ins.args, map) { args = args.append(ids[a]); }
            insts = insts.append(ssa.SInst { ...ins, result: ids[ins.result], args: args });
        }
        var term: ssa.STerm = mapped_term(b.term, map);
        if (term.kind_tag == 1 && term.value >= 0) { term = ssa.STerm { ...term, value: ids[term.value] }; }
        if (term.kind_tag == 3) { term = ssa.STerm { ...term, cond: ids[term.cond] }; }
        out = out.append(ssa.SBlock { ...b, insts: insts, term: term });
    }
    var graph: ssa.SFunc = ssa.SFunc { name: "", nparams: 0, nvals: kept.len(), blocks: out, entry: 0, takes_env: false };
    return ssasem.Func { graph: graph, values: kept, params: [], result: t_void(), records: [], calls: [] };
}

// ---- functions --------------------------------------------------------------

function unsupported_declaration(fd: parser.FuncDecl): string {
    if (fd.receiver_type.len() > 0) { return "unsupported receiver method"; }
    if (fd.type_params.len() > 0 || fd.type_param_count > 0) { return "unsupported generic function"; }
    if (fd.import_iface.len() > 0 || fd.async) { return "unsupported external or async function"; }
    for p in fd.params { if (p.has_default) { return "unsupported default argument"; } }
    return "";
}

function reference(t: typeinfo.Type): boolean { return semtypes.needs_anchor(t); }

function mode(p: ast.ParamDecl, t: typeinfo.Type): i32 {
    if (!reference(t)) { return ssaunits.value_mode(); }
    if (p.own) { return ssaunits.counted_mode(); }
    return ssaunits.borrow_mode();
}

function result_type(fd: parser.FuncDecl, scope: checker.Scope): typeinfo.Type {
    if (fd.ret_type.len() == 0) { return t_void(); }
    return scope.ret_type;
}

function parameters(fd: parser.FuncDecl, s: State): State {
    var at: i32 = 0;
    while (at < fd.params.len()) {
        var ty: typeinfo.Type = checker.scope_type(s.scope, fd.params[at].name);
        if (!semtypes.concrete(ty, false)) { return fail(s, "unresolved parameter type"); }
        var p: Value = define(s, 6, [], at, "", ty);
        s = bind(p.s, fd.params[at].name, p.id);
        at = at + 1;
    }
    return s;
}

function refuse(why: string): Produced {
    var graph: ssa.SFunc = ssa.SFunc { name: "", nparams: 0, nvals: 0, blocks: [], entry: 0, takes_env: false };
    return Produced { ok: false, why: why, func: ssasem.Func { graph: graph, values: [], params: [], result: t_void(), records: [], calls: [] }, modes: [] };
}

function initial(fd: parser.FuncDecl, scope: checker.Scope, contracts: ssasem.Contract[]): State {
    var entry: ssa.SBlock = ssa.SBlock { id: 0, insts: [], term: t_none(), preds: [] };
    return State { ok: true, why: "", blocks: [], cur: entry, live: true, next_block: 1, values: [],
        names: [], vals: [], scope: scope, result: result_type(fd, scope), loops: [], contracts: contracts, calls: [] };
}

function complete(fd: parser.FuncDecl, s: State): Produced {
    if (!s.ok) { return refuse(s.why); }
    if (s.live && !is_void(s.result)) { return refuse("value-returning body falls through"); }
    s = terminate(s, t_ret(0 - 1));
    var map: i32[] = trivial_phis(s.blocks, s.values.len());
    var f: ssasem.Func = renumber(s.blocks, map, s.values);
    var params: typeinfo.Type[] = [];
    var modes: i32[] = [];
    var at: i32 = 0;
    while (at < fd.params.len()) {
        params = params.append(f.values[at]);
        modes = modes.append(mode(fd.params[at], f.values[at]));
        at = at + 1;
    }
    var graph: ssa.SFunc = ssa.SFunc { ...f.graph, name: fd.name, nparams: params.len() };
    f = ssasem.Func { ...f, graph: graph, params: params, result: s.result, calls: s.calls };
    var analysis: ssasem.Analysis = ssasem.analyze(f);
    if (!analysis.ok) { return refuse("produced graph fails semantic verification: " + analysis.why); }
    return Produced { ok: true, why: "", func: f, modes: modes };
}

// build produces one function's typed semantic graph from its checked
// declaration, the checker's function scope and the module's call contracts.
// Unsupported constructs are explicit refusals, never a partial graph.
pub function build(fd: parser.FuncDecl, scope: checker.Scope, contracts: ssasem.Contract[]): Produced {
    var why: string = unsupported_declaration(fd);
    if (why != "") { return refuse(why); }
    var s: State = initial(fd, scope, contracts);
    if (!semtypes.concrete(s.result, true)) { return refuse("unresolved result type"); }
    s = parameters(fd, s);
    s = stmts(fd.body, s);
    return complete(fd, s);
}

// A declaration's contract is read from its checked scope and its parameter
// declarations, the same way its own production reads them. A declaration
// this boundary cannot produce has no contract, so no call may target it.
function contract(fd: parser.FuncDecl, scope: checker.Scope): ssasem.Contract {
    var none: ssasem.Contract = ssasem.Contract { name: "", params: [], modes: [], result: t_void() };
    if (unsupported_declaration(fd) != "") { return none; }
    var result: typeinfo.Type = result_type(fd, scope);
    if (!semtypes.concrete(result, true)) { return none; }
    var params: typeinfo.Type[] = [];
    var modes: i32[] = [];
    for p in fd.params {
        var ty: typeinfo.Type = checker.scope_type(scope, p.name);
        if (!semtypes.concrete(ty, false)) { return none; }
        params = params.append(ty);
        modes = modes.append(mode(p, ty));
    }
    return ssasem.Contract { name: fd.name, params: params, modes: modes, result: result };
}

function contracts(mod: parser.Module, scopes: checker.Scope[]): ssasem.Contract[] {
    var out: ssasem.Contract[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var c: ssasem.Contract = contract(mod.funcs[i], scopes[i]);
        if (c.name != "" && ssasem.find_contract(out, c.name) < 0) { out = out.append(c); }
        i = i + 1;
    }
    return out;
}

// A produced function's callees must be produced too: a contract is only
// honoured by a body verified against it, so a refused callee refuses every
// caller, transitively.
function close_module(mod: parser.Module, out: Produced[]): Produced[] {
    var changed: boolean = true;
    while (changed) {
        changed = false;
        var i: i32 = 0;
        while (i < out.len()) {
            if (out[i].ok) {
                for c in out[i].func.calls {
                    var at: i32 = 0;
                    while (at < mod.funcs.len() && mod.funcs[at].name != c.name) { at = at + 1; }
                    if (at < mod.funcs.len() && !out[at].ok && out[i].ok) {
                        out = out.with(i, refuse("call target was refused: " + out[at].why));
                        changed = true;
                    }
                }
            }
            i = i + 1;
        }
    }
    return out;
}

// build_module pairs every function with its checked scope, in declaration
// order. Refusals are per function and propagate to callers.
pub function build_module(mod: parser.Module): Produced[] {
    var scopes: checker.Scope[] = checker.module_scopes(mod);
    var table: ssasem.Contract[] = contracts(mod, scopes);
    var out: Produced[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        out = out.append(build(mod.funcs[i], scopes[i], table));
        i = i + 1;
    }
    return close_module(mod, out);
}
