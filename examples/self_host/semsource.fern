// Checked source to typed semantic values, before any ownership decision.
// Every value carries the checker's resolved type. Source names are places
// that resolve to value identities; no ownership fact is read from syntax.
import "./ast";
import "./astwalk";
import "./parser";
import "./lexical";
import "./checker";
import "./typeinfo";
import "./semtypes";
import "./semrecords";
import "./ssa";
import "./ssabounds";
import "./ssasem";
import "./ssaunits";
import "./ownership";
import "./util";
import "./seminline";
import "./semfuse";
import "./semndarray";
import "./semarrayreport";

// One body's production. A TEMPLATE declaration — one spelling type variables
// — has no body of its own: it is produced once per instantiation its callers
// request, each an instance named by the types bound, and its own entry says
// whether every instance produced. `key` is the template an instance came from.
//
// `bodyless` separates the two ways a template can fail to produce. One its
// instances refused, and that is a refusal. One NOTHING instantiates has no
// body to refuse: a measurement over it says nothing about what this boundary
// admits, and the production pipeline shakes it out before lowering. Both
// answer `ok: false`; only the first is evidence.
// `analysis` is the semantic analysis of `func` as it stands, kept from the
// anchoring that verified it so the planner reads it rather than analysing the
// same graph again: None before that, and again once a rewrite moves the graph.
// view_escape carries a definite typed source escape (1 array, 2 string).
// Other refusals and callers refused transitively leave it at zero.
pub struct Produced { ok: boolean, why: string, func: ssasem.Func, modes: i32[], template: boolean, key: string, requests: Request[], bodyless: boolean, analysis: Option[ssasem.Analysis], view_escape: i32 }

// An instance a produced body asks for: the template's declaration key, the
// instance's symbol, and the type each variable binds.
pub struct Request { key: string, name: string, binding: ssasem.Binding }

// Every declaration in order, then every instance the declarations reached.
// `contracts` is the module's contract table, by declaration key: what a
// caller of a declaration reads, whether or not the declaration produced.
// `dyn_arms` is every implementation a produced body dispatches to through a
// dyn call: the ownership inference leaves their modes as declared, since the
// dispatch lends every operand.
pub struct Built { decls: Produced[], instances: Produced[], contracts: ssasem.Contracts, names: string[], dyn_arms: string[] }

// Environments are the values of the bindings visible at loop entry, in
// binding order, captured where a body leaves the loop.
struct Exit { block: i32, env: i32[] }

struct Loop { label: string, header: i32, exit: i32, entry_count: i32, breaks: Exit[], continues: Exit[] }

struct State {
  ok: boolean,
  why: string,
  blocks: ssa.SBlock[],
  cur: ssa.SBlock,
  // The open block is reachable. After return, break or continue the
  // remaining statements of the body have no block.
  live: boolean,
  next_block: i32,
  values: typeinfo.Type[],
  names: string[],
  vals: i32[],
  scope: checker.Scope,
  result: typeinfo.Type,
  loops: Loop[],
  // Every module function's declared contract, and the ones this body calls.
  contracts: ssasem.Contracts,
  calls: ssasem.Contract[],
  // This declaration spells type VARIABLES, so a bare type-variable name in
  // a type the checker could not resolve is a variable of the template
  // rather than an unresolved spelling; `binding` is the instantiation this
  // body is produced under, and `requests` the instances it asks for.
  template: boolean,
  binding: ssasem.Binding,
  requests: Request[],
  // Values naming storage this frame did not create: a projection of a
  // lifted body's environment record, and a mutated capture's cell arriving
  // as a parameter. Replacing the binding that holds one is a write back
  // through a capture — see `assign`.
  foreign: i32[],
  // The module declarations whose body may hand one of their parameters out,
  // by contract name; `handers` computes it and `lend` consults it.
  handers: util.NameIndex,
  // The builtin names a module declaration takes over (`shadowed_builtins`).
  shadows: string[],
  // What in the module holds a view (`view_types`): declared records and
  // unions by name, function types as `fn <type_key>`.
  views: string[],
  // The symbol this body defines: the declaration's name, or the instance's.
  name: string,
  // Each parameter's declared mode, in order. A parameter's value id is its
  // position, so this doubles as the answer to "is this value a parameter,
  // and does this frame own it?".
  modes: i32[],
  // The module's declarations, which a dyn call's implementations are read
  // from.
  funcs: parser.FuncDecl[],
  // The module's `impl … for …` table, which a dyn type's concretes are read
  // from (`dyn_concretes`).
  impls: parser.ImplInfo[],
  // What a `?` failure edge runs before it returns: the defer desugar's
  // cleanup behind `__dfa_tryall` and `__dfa_tryerr` (parser.lower_defers_body).
  try_cleanup: ast.Stmt[],
  // Whether that cleanup is being lowered. A `?` inside a defer action
  // (E079) would replay it again without end.
  replaying: boolean,
  // The pattern bindings read or written outside the arm that binds them
  // (`escaping_bindings`), and the payload types the arms have shown for
  // them so far, which `build` binds at the top of the body.
  escaping: string[],
  learned: string[],
  learned_types: typeinfo.Type[],
  // Emit a source-position marker ahead of each statement (line_mark), the
  // `-g` build's line table.
  debug_lines: boolean,
  // Under debug_lines, every value a source variable is bound to, in binding
  // order, and that variable's name: the record a debugger's view of a local
  // is built from (#11410).
  dbg_vals: i32[],
  dbg_names: string[],
}

struct Value { s: State, id: i32 }

function t_i32(): typeinfo.Type {
  return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false };
}

function t_u8(): typeinfo.Type {
  return typeinfo.TypeI32 { width: 8, unsigned: true, is_char: false };
}

function t_u32(): typeinfo.Type {
  return typeinfo.TypeI32 { width: 32, unsigned: true, is_char: false };
}

function t_u64(): typeinfo.Type {
  return typeinfo.TypeI32 { width: 64, unsigned: true, is_char: false };
}

function t_i64(): typeinfo.Type {
  return typeinfo.TypeI32 { width: 64, unsigned: false, is_char: false };
}

function t_usize(): typeinfo.Type {
  return typeinfo.TypeI32 { width: typeinfo.width_ptr(), unsigned: true, is_char: false };
}

function t_bool(): typeinfo.Type {
  return typeinfo.TypeBool { tag: 0 };
}

function t_string(): typeinfo.Type {
  return typeinfo.TypeString { tag: 0 };
}

function t_str(): typeinfo.Type {
  return typeinfo.TypeString { tag: 1 };
}

function t_f64(): typeinfo.Type {
  return typeinfo.TypeFloat { width: 64, polymorphic: false };
}

function t_f32(): typeinfo.Type {
  return typeinfo.TypeFloat { width: 32, polymorphic: false };
}

function t_void(): typeinfo.Type {
  return typeinfo.TypeVoid { tag: 0 };
}

function is_i32(t: typeinfo.Type): boolean {
  return semtypes.equal(t, t_i32());
}

function is_bool(t: typeinfo.Type): boolean {
  return semtypes.equal(t, t_bool());
}

function is_void(t: typeinfo.Type): boolean {
  if let typeinfo.TypeVoid(_) = t {
    return true;
  }
  return false;
}

function fail(s: State, why: string): State {
  if (!s.ok) {
    return s;
  }
  return State { ...s, ok: false, why: why };
}

function refused(s: State, why: string): Value {
  return Value { s: fail(s, why), id: 0 - 1 };
}

function prefix(xs: i32[], n: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(xs[i]);
    i = i + 1;
  }
  return out;
}

function prefix_names(xs: string[], n: i32): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(xs[i]);
    i = i + 1;
  }
  return out;
}

function inst(kind: i32, result: i32, args: i32[], imm: i32, str: string): ssa.SInst {
  return ssa.SInst { kind_tag: kind, result: result, args: args, imm: imm, str: str };
}

function t_ret(value: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 1, cond: 0, target: 0, t: 0, f: 0, value: value };
}

function t_br(target: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 2, cond: 0, target: target, t: 0, f: 0, value: 0 };
}

function t_brif(cond: i32, t: i32, f: i32): ssa.STerm {
  return ssa.STerm { kind_tag: 3, cond: cond, target: 0, t: t, f: f, value: 0 };
}

function t_none(): ssa.STerm {
  return ssa.STerm { kind_tag: 0, cond: 0, target: 0, t: 0, f: 0, value: 0 };
}

function t_unreachable(): ssa.STerm {
  return ssa.STerm { kind_tag: 4, cond: 0, target: 0, t: 0, f: 0, value: 0 };
}

// ---- graph construction ---------------------------------------------------

function emit(s: State, ins: ssa.SInst): State {
  return State { ...s, cur: ssa.SBlock { ...s.cur, insts: s.cur.insts.append(ins) } };
}

// A value is its type; identity is the index. Emission follows definition.
function define(s: State, kind: i32, args: i32[], imm: i32, str: string, ty: typeinfo.Type): Value {
  let id: i32 = s.values.len();
  let next: State = State { ...s, values: s.values.append(ty) };
  return Value { s: emit(next, inst(kind, id, args, imm, str)), id: id };
}

function open(s: State, id: i32, preds: i32[]): State {
  return State { ...s, cur: ssa.SBlock { id: id, insts: [], term: t_none(), preds: preds }, live: true };
}

function terminate(s: State, term: ssa.STerm): State {
  if (!s.live) {
    return s;
  }
  let closed: ssa.SBlock = ssa.SBlock { ...s.cur, term: term };
  return State { ...s, blocks: s.blocks.append(closed), live: false };
}

// ---- bindings ---------------------------------------------------------------

function lookup(s: State, name: string): i32 {
  let i: i32 = s.names.len() - 1;
  while (i >= 0) {
    if (s.names[i] == name) {
      return s.vals[i];
    }
    i = i - 1;
  }
  return 0 - 1;
}

function bind(s: State, name: string, value: i32): State {
  return note_binding(State { ...s, names: s.names.append(name), vals: s.vals.append(value) }, name, value);
}

function replace(s: State, name: string, value: i32): State {
  let i: i32 = s.names.len() - 1;
  while (i >= 0) {
    if (s.names[i] == name) {
      return note_binding(State { ...s, vals: s.vals.with(i, value) }, name, value);
    }
    i = i - 1;
  }
  return fail(s, "replacement of an unbound name");
}

// note_binding records, under debug_lines, that `name` now holds `value`. A
// binding the compiler introduced (`for index`) has no source spelling and is
// not recorded.
function note_binding(s: State, name: string, value: i32): State {
  if (!s.debug_lines) {
    return s;
  }
  let src: string = lexical.source_name(name);
  if (!util.is_ident(src)) {
    return s;
  }
  return State { ...s, dbg_vals: s.dbg_vals.append(value), dbg_names: s.dbg_names.append(src) };
}

function leave(s: State, count: i32, scope: checker.Scope): State {
  return State { ...s, names: prefix_names(s.names, count), vals: prefix(s.vals, count), scope: scope };
}

// Merge one binding across incoming edges. Identical inputs need no phi;
// a phi's arity is the destination's predecessor list.
function merge_binding(s: State, envs: i32[][], at: i32): Value {
  let first: i32 = envs[0][at];
  let same: boolean = true;
  let args: i32[] = [];
  for env in envs {
    if (env[at] != first) {
      same = false;
    }
    args = args.append(env[at]);
  }
  if (same) {
    return Value { s: s, id: first };
  }
  return define(s, 8, args, 0, "", s.values[first]);
}

function merge_env(s: State, envs: i32[][], count: i32): State {
  let vals: i32[] = [];
  let at: i32 = 0;
  while (at < count) {
    let merged: Value = merge_binding(s, envs, at);
    s = merged.s;
    if (merged.id != envs[0][at]) {
      s = note_binding(s, s.names[at], merged.id);
    }
    vals = vals.append(merged.id);
    at = at + 1;
  }
  return State { ...s, vals: vals };
}

// ---- erasure ----------------------------------------------------------------

// A declaration that spells type variables is a TEMPLATE. The parser keeps only
// the BOUNDED names in `type_params` and counts the rest, so either field marks
// one — and a HOISTED closure body marks neither: the lift copies the
// type-variable spellings of the generic it came out of and declares no type
// parameter of its own. The spelling is a variable either way, bound by the
// instantiation the body is produced under.
function generic_decl(fd: parser.FuncDecl): boolean {
  if (fd.type_params.len() > 0 || fd.all_type_params.len() > 0) {
    return true;
  }
  if (spelled_typevar(fd.ret_type) || spelled_typevar(fd.ret_fn_ret) || spelled_typevar(fd.ret_fn_param_types)) {
    return true;
  }
  // A function type is spelled `fn`, its slots in the sidecars beside it.
  for p in fd.params {
    if (spelled_typevar(p.type_name) || spelled_typevar(p.fn_ret) || spelled_typevar(p.fn_param_types)) {
      return true;
    }
  }
  return spelled_typevar(fd.receiver_type);
}

// A type variable anywhere in a spelling — bare, an array's element, a
// function type's slot, a receiver's argument — marks the declaration a
// template: a method on `Option[T]` declares no type parameter of its own,
// and the parser's instance of `map[T, U]` at `T = i32` keeps `U` in its
// result for the function argument to bind. The names a `dyn` set lists are
// traits, never variables, so the set is skipped whole.
function spelled_typevar(spelling: string): boolean {
  let i: i32 = 0;
  while (i < spelling.len()) {
    let start: i32 = i;
    i = ident_end(spelling, i);
    if (i > start && slice_unchecked(spelling, start, i) == "dyn") {
      i = dyn_set_end(spelling, i);
    } else if (i > start && parser.looks_type_var(slice_unchecked(spelling, start, i) + "")) {
      return true;
    }
    if (i == start) {
      i = i + 1;
    }
  }
  return false;
}

function ident_end(spelling: string, i: i32): i32 {
  while (i < spelling.len() && (spelling[i] >= b'A' && spelling[i] <= b'Z' || spelling[i] >= b'a' && spelling[i] <= b'z' || spelling[i] >= b'0' && spelling[i] <= b'9' || spelling[i] == b'_')) {
    i = i + 1;
  }
  return i;
}

// Past `dyn`, the end of its `T1 + T2 + …` trait set.
function dyn_set_end(spelling: string, i: i32): i32 {
  while (true) {
    while (i < spelling.len() && spelling[i] == b' ') {
      i = i + 1;
    }
    i = ident_end(spelling, i);
    let j: i32 = i;
    while (j < spelling.len() && spelling[j] == b' ') {
      j = j + 1;
    }
    if (j >= spelling.len() || spelling[j] != b'+') {
      return i;
    }
    i = j + 1;
  }
  return i;
}

// resolved reads a type the checker computed for a body. Inside a template a
// bare type-variable name the checker could not resolve is that variable, and
// the binding the body is produced under says what it is — structurally, so a
// function-typed parameter's own variable slots resolve with it, and a
// consuming slot bound to a scalar drops its `own` as `typeinfo.own_flags`
// says. Every other unknown is left alone and refuses where it stands, and so
// does a variable the binding does not name, which stays a variable.
//
// A record the front end cloned at a variable (`Slot__0_T`, from `Slot[T]`
// inside a generic over T) is one record per binding: its variables become
// its arguments, so each instance builds the record at its own types.
function resolved(t: typeinfo.Type, template: boolean, b: ssasem.Binding, scope: checker.Scope): typeinfo.Type {
  if (!template) {
    return t;
  }
  if let typeinfo.TypeUnknown(u) = t {
    let name: string = checker.typevar_reason_name(u.reason);
    if (parser.looks_type_var(name)) {
      return ssasem.substitute(typeinfo.TypeErased { name: name }, b);
    }
    return t;
  }
  return resolved_within(t, b, scope);
}

function resolved_within(t: typeinfo.Type, b: ssasem.Binding, scope: checker.Scope): typeinfo.Type {
  if let typeinfo.TypeArray(a) = t {
    return typeinfo.TypeArray { elem: resolved(a.elem, true, b, scope), view: a.view };
  }
  if let typeinfo.TypeTuple(tup) = t {
    return typeinfo.TypeTuple { elements: resolved_list(tup.elements, b, scope) };
  }
  if let typeinfo.TypeFunc(fn) = t {
    let params: typeinfo.Type[] = resolved_list(fn.param_types, b, scope);
    return typeinfo.TypeFunc { ...fn, param_types: params, param_own: typeinfo.own_flags(fn.param_own, params), ret_type: resolved(fn.ret_type, true, b, scope) };
  }
  if let typeinfo.TypeMap(m) = t {
    return typeinfo.TypeMap { key: resolved(m.key, true, b, scope), value: resolved(m.value, true, b, scope) };
  }
  if let typeinfo.TypeStruct(r) = t {
    if (r.args.len() == 0) {
      let args: typeinfo.Type[] = [];
      for v in record_variables(r.name, scope, []) {
        args = args.append(ssasem.substitute(typeinfo.TypeErased { name: v }, b));
      }
      return typeinfo.TypeStruct { ...r, args: args };
    }
    return typeinfo.TypeStruct { ...r, args: resolved_list(r.args, b, scope) };
  }
  if let typeinfo.TypeUnion(u) = t {
    return typeinfo.TypeUnion { ...u, args: resolved_list(u.args, b, scope) };
  }
  return t;
}

function resolved_list(ts: typeinfo.Type[], b: ssasem.Binding, scope: checker.Scope): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for t in ts {
    out = out.append(resolved(t, true, b, scope));
  }
  return out;
}

// The variables a record's fields spell, in order of first occurrence, through
// any record cloned at a variable that a field holds. Only a clone, named
// `Base__key`, can hold one: a declared generic has type parameters instead.
// `seen` cuts a recursive one.
function record_variables(name: string, scope: checker.Scope, seen: string[]): string[] {
  if (!util.contains(name, "__")) {
    return [];
  }
  let sig: checker.StructSig = checker.struct_sig(scope, name);
  if (sig.name.len() == 0 || sig.type_params.len() > 0 || sig.enum_owner.len() > 0 || util.index_of_str(seen, name) >= 0) {
    return [];
  }
  let out: string[] = [];
  for ft in sig.field_types {
    out = spelled_variables(ft, scope, seen.append(name), out);
  }
  return out;
}

function spelled_variables(t: typeinfo.Type, scope: checker.Scope, seen: string[], out: string[]): string[] {
  let name: string = "";
  if let typeinfo.TypeUnknown(u) = t {
    name = checker.typevar_reason_name(u.reason);
  }
  if let typeinfo.TypeErased(e) = t {
    name = e.name;
  }
  if (parser.looks_type_var(name)) {
    if (util.index_of_str(out, name) < 0) {
      return out.append(name);
    }
    return out;
  }
  let parts: typeinfo.Type[] = [];
  if let typeinfo.TypeArray(a) = t {
    parts = [a.elem];
  }
  if let typeinfo.TypeTuple(tup) = t {
    parts = tup.elements;
  }
  if let typeinfo.TypeFunc(fn) = t {
    parts = fn.param_types.append(fn.ret_type);
  }
  if let typeinfo.TypeMap(m) = t {
    parts = [m.key, m.value];
  }
  if let typeinfo.TypeUnion(u) = t {
    parts = u.args;
  }
  if let typeinfo.TypeStruct(r) = t {
    if (r.args.len() > 0) {
      parts = r.args;
    } else {
      for v in record_variables(r.name, scope, seen) {
        if (util.index_of_str(out, v) < 0) {
          out = out.append(v);
        }
      }
    }
  }
  for p in parts {
    out = spelled_variables(p, scope, seen, out);
  }
  return out;
}

function bound_type(s: State, name: string, scope: checker.Scope): typeinfo.Type {
  return settled(resolved(checker.scope_type(scope, name), s.template, s.binding, scope));
}

// A float the checker left polymorphic — a literal's binding with no
// annotation, or an expression over one — has settled nowhere else, so it
// settles here at the width the checker carried, which is the f64 an
// unsuffixed literal is. The same holds for one inside a container or a
// variant: `let xs = [1.5]` is an f64[], and `Some(1.5)` an Option[f64].
function settled(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeFloat(f) = t {
    if (f.polymorphic) {
      return typeinfo.TypeFloat { width: f.width, polymorphic: false };
    }
  }
  if let typeinfo.TypeArray(a) = t {
    return typeinfo.TypeArray { ...a, elem: settled(a.elem) };
  }
  if let typeinfo.TypeTuple(tup) = t {
    let els: typeinfo.Type[] = [];
    for el in tup.elements {
      els = els.append(settled(el));
    }
    return typeinfo.TypeTuple { elements: els };
  }
  if let typeinfo.TypeMap(m) = t {
    return typeinfo.TypeMap { key: settled(m.key), value: settled(m.value) };
  }
  if let typeinfo.TypeUnion(u) = t {
    let args: typeinfo.Type[] = [];
    for a in u.args {
      args = args.append(settled_payload(a));
    }
    return typeinfo.TypeUnion { ...u, args: args };
  }
  return t;
}

// A bare `None` names no payload, so as a payload itself (`Some(None)` with no
// annotation) the checker leaves it `Option` alone. Nothing can build its
// `Some` without settling the payload, so the value is only ever None and it
// settles at a void payload, which carries nothing.
function settled_payload(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(u) = t {
    if (u.name == "Option" && u.args.len() == 0) {
      return typeinfo.TypeUnion { ...u, args: [t_void()] };
    }
  }
  return settled(t);
}

function is_none_only(t: typeinfo.Type): boolean {
  if let typeinfo.TypeUnion(u) = t {
    return u.name == "Option" && u.args.len() == 1 && semtypes.equal(u.args[0], t_void());
  }
  return false;
}

// ---- expressions ------------------------------------------------------------

function checked(e: ast.Expr, s: State): typeinfo.Type {
  return settled(resolved(checker.expr_type(e, s.scope), s.template, s.binding, s.scope));
}

function decimal(text: string): boolean {
  if (text.len() == 0) {
    return false;
  }
  let i: i32 = 0;
  while (i < text.len()) {
    if (text[i] < b'0' || text[i] > b'9') {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function hex_digit(b: i32): boolean {
  return b >= 48 && b <= 57 || b >= 97 && b <= 102 || b >= 65 && b <= 70;
}

function hex_digits(text: string, from: i32): boolean {
  if (from >= text.len()) {
    return false;
  }
  let i: i32 = from;
  while (i < text.len()) {
    if (!hex_digit(text[i] as i32)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// The two bases the lexer writes: decimal, and hexadecimal behind an `0x`
// prefix. Digits are never separated, so a well-formed literal is the optional
// prefix and a run of digits. The value is `util.lit_to_i32`'s, the same one
// the production lowering reads, and the checker has already proved it fits
// the type the literal is written at (E047).
function integer_literal(text: string): boolean {
  if (text.len() > 2 && text[0] == b'0' && (text[1] == b'x' || text[1] == b'X')) {
    return hex_digits(text, 2);
  }
  return decimal(text);
}

// A literal's width is the suffix it carries, which a byte literal (`b'x'`)
// has as much as a written `7u8` does. An unsuffixed decimal is an i32 unless
// its destination names another integer type.
//
// `usize` is here although no source can write it: the value-block desugar
// (checker.fern's vb_zero_of) stamps the tag as the suffix of the placeholder
// zero it builds, so an if-expression at the pointer width hands this table a
// `usize`-suffixed literal. Without the arm it typed to unknown and the
// function was refused for a WIDTH that was never the problem.
function literal_type(suffix: string): typeinfo.Type {
  if (suffix == "u8") {
    return t_u8();
  }
  if (suffix == "char") {
    return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: true };
  }
  if (suffix == "u32") {
    return t_u32();
  }
  if (suffix == "i64") {
    return t_i64();
  }
  if (suffix == "u64") {
    return t_u64();
  }
  if (suffix == "usize") {
    return t_usize();
  }
  if (suffix == "" || suffix == "i32") {
    return t_i32();
  }
  return typeinfo.unchecked();
}

// An unsuffixed literal carries no width of its own: it takes the integer type
// the destination names, the way the checker does — `let b: u8 = 65` binds a
// byte, and `65` in an i32 position an i32. A suffix names the type outright.
// Either way the value has to fit what it lands in, which `ssasem` holds the
// constant to.
// A literal with no i32 immediate to hold it — either 64-bit width, or a u32,
// whose range reaches past the immediate's sign bit — carries its SOURCE TEXT
// instead, which is also how the AST lowering hands the same literal to the
// backends, rather than through a parse and re-format.
// A float literal is an f64 unless something names the narrower width: the
// checker types it polymorphic and settles it where it lands, so the literal
// is an f32 where its suffix or its destination says so. It carries its text
// the way a wide integer does; the f32 is rounded where the constant is made.
function float_number(n: ast.ExprNumber, s: State, expected: typeinfo.Type): Value {
  let narrow: boolean = n.suffix == "f32";
  if let typeinfo.TypeFloat(fl) = expected {
    if (fl.width == 32) {
      narrow = true;
    }
  }
  if (narrow) {
    return define(s, 1, [], 0, n.text, t_f32());
  }
  return define(s, 1, [], 0, n.text, t_f64());
}

function number(n: ast.ExprNumber, s: State, expected: typeinfo.Type): Value {
  if (parser.is_unit_literal(n)) {
    return define(s, 1, [], 0, "", t_void());
  }
  // An unsuffixed integer literal takes a float expectation, as the checker
  // settles it beside a float operand.
  if (n.is_float || n.suffix == "" && ssasem.is_float(expected)) {
    return float_number(n, s, expected);
  }
  if (!integer_literal(n.text)) {
    return refused(s, "unsupported literal");
  }
  let ty: typeinfo.Type = literal_type(n.suffix);
  if (n.suffix == "" && ssasem.is_integer(expected)) {
    ty = expected;
  } else if (n.suffix == "" && parser.literal_is_i64(n.text)) {
    // An unsuffixed literal past the i32 range with no destination to settle
    // it is an i64. `4611686018427387904 as i64` names the width through the
    // CAST, whose operand is produced with no expectation at all, so the
    // default width was taken and the value truncated to nothing.
    ty = t_i64();
  }
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "unsupported literal width");
  }
  // An address rides the i32 immediate, which carries every value below
  // 2^31 exactly. Past that the register backends sign-extend the constant
  // and wasm wraps it, and the pointer width has no immediate of its own to
  // fall back on, so the literal is refused for its RANGE rather than for
  // being written at the width at all.
  if (ssasem.is_usize(ty) && parser.literal_is_i64(n.text)) {
    return refused(s, "address literal past the immediate");
  }
  if (ssasem.text_constant(ty)) {
    return define(s, 1, [], 0, decimal_text(n.text), ty);
  }
  return define(s, 1, [], util.lit_to_i32(n.text), "", ty);
}

// decimal_text drops a plain decimal literal's leading zeros. The text reaches
// assemblers that read a leading `0` as octal, where Fern's `010` is ten; a
// radix literal (`0x1F`, `0b101`) keeps its prefix.
function decimal_text(t: string): string {
  if (t.len() < 2 || t[0] != b'0' || t[1] < b'0' || t[1] > b'9') {
    return t;
  }
  let i: i32 = 0;
  while (i + 1 < t.len() && t[i] == b'0') {
    i = i + 1;
  }
  return slice_unchecked(t, i, t.len()) + "";
}

function boolean_value(b: boolean): i32 {
  if (b) {
    return 1;
  }
  return 0;
}

// A bare name that is no binding is a unit variant of the expected enum, or a
// module-level constant: the parser desugars `const` to a zero-parameter
// function and the AST lowering calls one on a bare reference, so it is a call
// here too. A name at a FUNCTION-typed destination is the bare address of a
// declaration, which is not what a function value holds here: the lambda lift
// wraps one into an environment box (`__mkclo$<name>$wrapN()`) before this
// boundary reads the tree, and a call through a value dispatches through that
// box.
function ident(e: ast.Expr, id: ast.ExprIdent, s: State, expected: typeinfo.Type): Value {
  let value: i32 = lookup(s, id.name);
  if (value >= 0) {
    return Value { s: s, id: value };
  }
  let ty: typeinfo.Type = checked(e, s);
  if (ssasem.is_func(ty)) {
    return refused(s, "function address is not a closure value: " + id.name);
  }
  let whole: typeinfo.Type = literal_union(e, s, expected);
  if (names_variant(s, whole, id.name)) {
    return variant(id.name, whole, [], s);
  }
  let at: i32 = ssasem.find_contract(s.contracts, id.name);
  if (at < 0 || s.contracts.list[at].params.len() != 0 || !semtypes.equal(s.contracts.list[at].result, ty)) {
    return refused(s, "unbound name is not a semantic value: " + id.name);
  }
  let contract: ssasem.Contract = s.contracts.list[at];
  if (ssasem.find_contract_in(s.calls, id.name) < 0) {
    s = State { ...s, calls: s.calls.append(contract) };
  }
  return define(s, ssasem.call(), [], 0, id.name, contract.result);
}

function union_name(t: typeinfo.Type): string {
  if let typeinfo.TypeUnion(u) = t {
    return u.name;
  }
  return "";
}

// The variant names of a union: a written enum or struct-union takes them from
// its declaration, an INJECTED enum (IoError, JsonValue) from the struct
// table's enum owner, since the front end injects those variants with no enum
// declaration to list them.
function union_variants(s: State, name: string): string[] {
  let sig: checker.UnionSig = checker.union_sig(s.scope, name);
  if (sig.name.len() > 0 && sig.variants.len() > 0) {
    return sig.variants;
  }
  return checker.owned_variant_names(s.scope, name);
}

// A union's layout, read from the declarations rather than from any use: an
// enum owns its variant declarations, a struct-union names structs declared on
// their own, and the two generic unions the front end supplies own neither —
// their box is a tag and one payload word. A union that mixes the first two
// has no layout here.
function union_layout(s: State, name: string): i32 {
  let variants: string[] = union_variants(s, name);
  if (variants.len() == 0) {
    return builtin_union_layout(name);
  }
  let owned: i32 = 0;
  let plain: i32 = 0;
  for v in variants {
    let vs: checker.StructSig = checker.variant_shape_sig(s.scope, v, name);
    if (vs.name.len() == 0) {
      return 0;
    }
    if (vs.enum_owner == name) {
      owned = owned + 1;
    } else {
      plain = plain + 1;
    }
  }
  if (plain == 0) {
    return semrecords.layout_variant();
  }
  if (owned == 0) {
    return semrecords.layout_member();
  }
  return 0;
}

function builtin_union_layout(name: string): i32 {
  if (name == "Option" || name == "Result") {
    return semrecords.layout_option();
  }
  return 0;
}

// Option and Result carry their payload types as type ARGUMENTS rather than in
// a declaration, so a value of one is only as well defined as its
// instantiation: `Option[string]` owns a string where `Option[i32]` owns
// nothing. Every variant shape here is read off those arguments, and a
// name-only `Option` names no shape at all. The order is the box's tag —
// Some / Ok is 0, None / Err is 1 — which is why it is fixed here rather
// than looked up.
function builtin_variants(t: typeinfo.Type): semrecords.Variant[] {
  if let typeinfo.TypeUnion(u) = t {
    if (u.name == "Option" && u.args.len() == 1) {
      return [payload_variant("Some", u.args[0]), semrecords.Variant { name: "None", fields: [] }];
    }
    if (u.name == "Result" && u.args.len() == 2) {
      return [payload_variant("Ok", u.args[0]), payload_variant("Err", u.args[1])];
    }
  }
  return [];
}

// A `void` payload is no payload: the variant carries nothing, as None does.
function payload_variant(name: string, ty: typeinfo.Type): semrecords.Variant {
  if (is_void(ty)) {
    return semrecords.Variant { name: name, fields: [] };
  }
  return semrecords.Variant { name: name, fields: [semrecords.Field { name: "__ev", ty: ty }] };
}

// The payload types one variant declares, and whether the union has such a
// variant at all. `unit` marks a variant declared with a `void` payload: it
// carries no field, but a pattern still writes the one binding its
// declaration has, and that binding names nothing.
struct Payloads { found: boolean, types: typeinfo.Type[], unit: boolean }

function builtin_payloads(whole: typeinfo.Type, name: string): Payloads {
  for v in builtin_variants(whole) {
    if (v.name == name) {
      let types: typeinfo.Type[] = [];
      for field in v.fields {
        types = types.append(field.ty);
      }
      return Payloads { found: true, types: types, unit: v.fields.len() == 0 && name != "None" };
    }
  }
  return Payloads { found: false, types: [], unit: false };
}

// A pattern reaches a member of either kind of declared union; a literal only
// ever names a variant its enum owns.
function arm_payloads(s: State, whole: typeinfo.Type, name: string, layout: i32): Payloads {
  if (layout == semrecords.layout_option()) {
    return builtin_payloads(whole, name);
  }
  let sig: checker.StructSig = checker.variant_shape_sig(s.scope, name, union_name(whole));
  return Payloads { found: sig.name.len() > 0, types: sig.field_types, unit: false };
}

function literal_payloads(s: State, whole: typeinfo.Type, name: string, layout: i32): Payloads {
  if (layout == semrecords.layout_option()) {
    return builtin_payloads(whole, name);
  }
  let sig: checker.StructSig = checker.variant_sig(s.scope, name, union_name(whole));
  return Payloads { found: sig.name.len() > 0, types: sig.field_types, unit: false };
}

// The union a variant literal builds. The checker types a declared enum's
// literal outright, but it types `Some(x)` by the enum alone — no
// instantiation — so a builtin union's literal takes its type arguments from
// the destination it is written against, which is where they are known.
function literal_union(e: ast.Expr, s: State, expected: typeinfo.Type): typeinfo.Type {
  let ty: typeinfo.Type = checked(e, s);
  if (builtin_union_layout(union_name(ty)) == 0) {
    return ty;
  }
  if (union_name(expected) == union_name(ty)) {
    return expected;
  }
  return ty;
}

// A name is a variant literal when the union it is written against has a
// variant of that name.
function names_variant(s: State, whole: typeinfo.Type, name: string): boolean {
  let owner: string = union_name(whole);
  if (owner == "") {
    return false;
  }
  return literal_payloads(s, whole, name, union_layout(s, owner)).found;
}

function struct_name(t: typeinfo.Type): string {
  if let typeinfo.TypeStruct(r) = t {
    if (r.args.len() == 0) {
      return r.name;
    }
  }
  return "";
}

function element_type(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeArray(a) = t {
    return a.elem;
  }
  return typeinfo.unchecked();
}

function tuple_element_type(t: typeinfo.Type, at: i32): typeinfo.Type {
  if let typeinfo.TypeTuple(tup) = t {
    if (at < tup.elements.len()) {
      return tup.elements[at];
    }
  }
  return typeinfo.unchecked();
}

// An empty literal has no element to name its type; the binding or
// enclosing container it initializes supplies the checked type.
// A literal takes the destination's type when the destination names one:
// a member element widens to the union the destination declares, which the
// checker types the literal by its elements and lets the assignment widen.
function destination_type(e: ast.Expr, s: State, expected: typeinfo.Type): typeinfo.Type {
  if (semtypes.concrete(expected, false)) {
    return expected;
  }
  return checked(e, s);
}

function array(e: ast.Expr, a: ast.ExprArray, s: State, expected: typeinfo.Type): Value {
  let ty: typeinfo.Type = destination_type(e, s, expected);
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "unresolved array literal type");
  }
  let elem: typeinfo.Type = element_type(ty);
  let ids: i32[] = [];
  for e in a.elements {
    let v: Value = expr(e, s, elem);
    s = v.s;
    if (!s.ok) {
      return Value { s: s, id: 0 - 1 };
    }
    if (!semtypes.equal(s.values[v.id], elem)) {
      return refused(s, "array element type: " + typeinfo.spelling(s.values[v.id]) + " in " + typeinfo.spelling(ty));
    }
    v = kept_view(unaliased_view(v));
    s = v.s;
    ids = ids.append(v.id);
  }
  let owned: typeinfo.Type = typeinfo.TypeArray { elem: elem, view: false };
  return widen(define(s, ssasem.array_new(), ids, 0, "", owned), ty);
}

function tuple(e: ast.Expr, t: ast.ExprTuple, s: State, expected: typeinfo.Type): Value {
  let ty: typeinfo.Type = destination_type(e, s, expected);
  if (tuple_arity(ty) != t.elements.len()) {
    ty = checked(e, s);
  }
  let ids: i32[] = [];
  let types: typeinfo.Type[] = [];
  let at: i32 = 0;
  while (at < t.elements.len()) {
    let v: Value = expr(t.elements[at], s, tuple_element_type(ty, at));
    if (!v.s.ok) {
      return Value { s: v.s, id: 0 - 1 };
    }
    v = kept_view(unaliased_view(v));
    s = v.s;
    ids = ids.append(v.id);
    types = types.append(s.values[v.id]);
    at = at + 1;
  }
  let built: typeinfo.Type = typeinfo.TypeTuple { elements: types };
  if (semtypes.concrete(ty, false) && !semtypes.equal(built, ty)) {
    return refused(s, "tuple element type");
  }
  return define(s, ssasem.tuple_new(), ids, 0, "", built);
}

// A capture read out of a closure body's environment: `__env[k]` is the
// record projection of field k, typed by the capture the lift wrote there.
function environment_read(ix: ast.ExprIndex, container: Value, s: State): Value {
  let caps: typeinfo.Type[] = semtypes.env_captures(s.values[container.id]);
  let slot: i32 = 0;
  if let ast.ExprNumber(n) = ix.index {
    if (decimal(n.text)) {
      slot = util.digits_to_i32(n.text);
    }
  }
  if (slot < 1 || slot > caps.len()) {
    return refused(s, "environment projection");
  }
  let v: Value = define(s, ssasem.record_get(), [container.id], slot, "c" + util.i32_to_string(slot), caps[slot - 1]);
  return Value { s: State { ...v.s, foreign: v.s.foreign.append(v.id) }, id: v.id };
}

function index(ix: ast.ExprIndex, s: State): Value {
  let container: Value = expr(ix.array, s, typeinfo.unchecked());
  if (container.s.ok && semtypes.is_env(container.s.values[container.id])) {
    return environment_read(ix, container, container.s);
  }
  let at: Value = expr(ix.index, container.s, t_i32());
  s = at.s;
  if (!s.ok) {
    return at;
  }
  if (!is_i32(s.values[at.id])) {
    return refused(s, "array projection contract");
  }
  // A string's element is one byte, typed u8 the way the checker types it.
  // Nothing is borrowed, so this is a read of the source rather than a
  // projection of it.
  let unchecked: i32 = 0;
  if (ix.unchecked) {
    unchecked = 1;
  }
  if (ssasem.is_text(s.values[container.id])) {
    return define(s, ssasem.str_index(), [container.id, at.id], unchecked, "", t_u8());
  }
  let elem: typeinfo.Type = element_type(s.values[container.id]);
  if (!semtypes.concrete(elem, false)) {
    return refused(s, "array projection contract");
  }
  return define(s, ssasem.array_get(), [container.id, at.id], unchecked, "", elem);
}

// A checked slice's decision tree as it is built: the state, and the blocks
// that have branched away to the `None` sink so far — that sink's predecessor
// list, which it is opened with once the tree is complete.
struct SliceTree { s: State, preds: i32[] }

// Both ends of a checked slice must fall on a codepoint boundary. An end at
// the very start, or at or past the length, is one by construction; anywhere
// else the byte there must not be a continuation byte. The four ways of being
// a boundary converge on the block this returns opened, and the one way of
// not being one leaves for the sink.
function slice_probe(t: SliceTree, src: i32, at: i32, len: i32, sink: i32): SliceTree {
  let s: State = t.s;
  let preds: i32[] = t.preds;
  let interior: i32 = s.cur.id;
  let below: i32 = s.next_block;
  let byte: i32 = below + 1;
  let lead: i32 = byte + 1;
  let ok: i32 = lead + 1;
  s = State { ...s, next_block: ok + 1 };

  let zero: Value = define(s, 1, [], 0, "", t_i32());
  let after_start: Value = define(zero.s, 9, [at, zero.id], 0, ">", t_bool());
  s = terminate(after_start.s, t_brif(after_start.id, below, ok));

  let inside: Value = define(open(s, below, [interior]), 9, [at, len], 0, "<", t_bool());
  s = terminate(inside.s, t_brif(inside.id, byte, ok));

  let b: Value = define(open(s, byte, [below]), ssasem.str_index(), [src, at], 0, "", t_u8());
  let low: Value = define(b.s, 1, [], 128, "", t_u8());
  let ascii: Value = define(low.s, 9, [b.id, low.id], 0, "<", t_bool());
  s = terminate(ascii.s, t_brif(ascii.id, ok, lead));

  let first: Value = define(open(s, lead, [byte]), 1, [], 192, "", t_u8());
  let starts: Value = define(first.s, 9, [b.id, first.id], 0, ">=", t_bool());
  s = terminate(starts.s, t_brif(starts.id, ok, sink));

  return SliceTree { s: open(s, ok, [interior, below, byte, lead]), preds: preds.append(lead) };
}

// One bound test: the tree continues into a fresh block when the predicate
// holds and leaves for the sink when it does not.
function slice_bound(t: SliceTree, left: i32, op: string, right: i32, sink: i32): SliceTree {
  let s: State = t.s;
  let preds: i32[] = t.preds;
  let from: i32 = s.cur.id;
  let next: i32 = s.next_block;
  s = State { ...s, next_block: next + 1 };
  let held: Value = define(s, 9, [left, right], 0, op, t_bool());
  s = terminate(held.s, t_brif(held.id, next, sink));
  return SliceTree { s: open(s, next, [from]), preds: preds.append(from) };
}

// `s[lo:hi]` answers a view of the source's bytes when the window is in
// bounds and both ends fall on a codepoint boundary, and `None` when it does
// not. Every failing test leaves for one `None` block, so the whole check is
// a decision tree with two sinks and the result joins as a single phi. The
// length is read once and each bound evaluated once, before any test runs.
// `xs[lo:hi]` on an array has a view type. Physical lowering still makes a
// fresh copy, bounds-checked by the runtime rather than by a test here (the AST
// lowering traps the same way). The elements are copied as bare words, so a
// counted element type is retained once per copied slot — the copy aliases
// every one of them.
function array_slice(sl: ast.ExprSlice, src: Value, elem: typeinfo.Type, s: State): Value {
  let lo: Value = expr(sl.start, s, t_i32());
  s = lo.s;
  if (!s.ok) {
    return lo;
  }
  let hi: Value = define(s, ssasem.length(), [src.id], 0, "", t_i32());
  if (!sl.open_end) {
    hi = expr(sl.end, s, t_i32());
  }
  s = hi.s;
  if (!s.ok) {
    return hi;
  }
  if (!is_i32(s.values[lo.id]) || !is_i32(s.values[hi.id])) {
    return refused(s, "slice bound type");
  }
  return define(s, ssasem.arr_slice(), [src.id, lo.id, hi.id], 0, "", typeinfo.TypeArray { elem: elem, view: true });
}

function slice_expr(e: ast.Expr, sl: ast.ExprSlice, s: State): Value {
  let src: Value = expr(sl.array, s, typeinfo.unchecked());
  s = src.s;
  if (!s.ok) {
    return src;
  }
  if let typeinfo.TypeArray(a) = s.values[src.id] {
    return array_slice(sl, src, a.elem, s);
  }
  if (!ssasem.is_text(s.values[src.id])) {
    return refused(s, "unsupported slice source: " + typeinfo.spelling(s.values[src.id]));
  }
  let whole: typeinfo.Type = checked(e, s);
  let layout: i32 = union_layout(s, union_name(whole));
  if (layout != semrecords.layout_option()) {
    return refused(s, "unsupported slice result");
  }
  let shape: Payloads = literal_payloads(s, whole, "Some", layout);
  if (!shape.found || shape.types.len() != 1 || !semtypes.equal(shape.types[0], t_str())) {
    return refused(s, "unsupported slice result");
  }
  let len: Value = define(s, ssasem.length(), [src.id], 0, "", t_i32());
  s = len.s;
  let lo: Value = expr(sl.start, s, t_i32());
  s = lo.s;
  if (!s.ok) {
    return lo;
  }
  let hi: i32 = len.id;
  if (!sl.open_end) {
    let end: Value = expr(sl.end, s, t_i32());
    s = end.s;
    if (!s.ok) {
      return end;
    }
    hi = end.id;
  }
  if (!is_i32(s.values[lo.id]) || !is_i32(s.values[hi])) {
    return refused(s, "slice bound type");
  }

  let sink: i32 = s.next_block;
  let join: i32 = sink + 1;
  s = State { ...s, next_block: join + 1 };
  let floor: Value = define(s, 1, [], 0, "", t_i32());
  s = floor.s;

  let t: SliceTree = SliceTree { s: s, preds: [] };
  t = slice_bound(t, floor.id, "<=", lo.id, sink);
  t = slice_bound(t, lo.id, "<=", hi, sink);
  t = slice_bound(t, hi, "<=", len.id, sink);
  t = slice_probe(t, src.id, lo.id, len.id, sink);
  t = slice_probe(t, src.id, hi, len.id, sink);
  s = t.s;
  let sink_preds: i32[] = t.preds;

  let view: Value = define(s, ssasem.slice(), [src.id, lo.id, hi], 0, "", t_str());
  let some: Value = define(view.s, ssasem.variant_new(), [view.id], 0, "Some", whole);
  let from_some: i32 = some.s.cur.id;
  s = terminate(some.s, t_br(join));

  let none: Value = define(open(s, sink, sink_preds), ssasem.variant_new(), [], 0, "None", whole);
  s = terminate(none.s, t_br(join));

  return define(open(s, join, [from_some, sink]), 8, [some.id, none.id], 0, "", whole);
}

function field(e: ast.Expr, fa: ast.ExprFieldAccess, s: State, expected: typeinfo.Type): Value {
  let head: string = type_head(fa.obj, s);
  if (head.len() > 0) {
    return qualified_variant(e, head, fa.field, [], s, expected);
  }
  if (!decimal(fa.field)) {
    return record_field(fa, s);
  }
  let container: Value = expr(fa.obj, s, typeinfo.unchecked());
  s = container.s;
  if (!s.ok) {
    return container;
  }
  let at: i32 = util.lit_to_i32(fa.field);
  let elem: typeinfo.Type = tuple_element_type(s.values[container.id], at);
  if (!semtypes.concrete(elem, true)) {
    return refused(s, "tuple projection contract");
  }
  return define(s, ssasem.tuple_get(), [container.id], at, "", elem);
}

// A record is a declared struct with no type parameters and no enum owner:
// its schema is the declaration's field names and checked field types, in
// declaration order, which is also the order a literal supplies them in.
function record_schema(name: string, s: State): checker.StructSig {
  let sig: checker.StructSig = checker.struct_sig(s.scope, name);
  if (sig.type_params.len() > 0 || sig.enum_owner.len() > 0) {
    return checker.struct_sig(s.scope, "");
  }
  return sig;
}

// The schema of record type `t`: its declaration's, read at the arguments a
// record cloned at a variable carries.
function record_sig(t: typeinfo.Type, s: State): checker.StructSig {
  if let typeinfo.TypeStruct(r) = t {
    let sig: checker.StructSig = record_schema(r.name, s);
    if (sig.name.len() == 0 || r.args.len() == 0) {
      return sig;
    }
    let vars: string[] = record_variables(r.name, s.scope, []);
    if (vars.len() != r.args.len()) {
      return checker.struct_sig(s.scope, "");
    }
    let b: ssasem.Binding = ssasem.Binding { ok: true, why: "", names: vars, types: r.args };
    let fts: typeinfo.Type[] = [];
    for ft in sig.field_types {
      fts = fts.append(resolved(ft, true, b, s.scope));
    }
    return checker.StructSig { ...sig, field_types: fts };
  }
  return checker.struct_sig(s.scope, "");
}

function record_field_index(sig: checker.StructSig, name: string): i32 {
  let i: i32 = 0;
  while (i < sig.field_names.len()) {
    if (sig.field_names[i] == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function record_field(fa: ast.ExprFieldAccess, s: State): Value {
  let container: Value = expr(fa.obj, s, typeinfo.unchecked());
  s = container.s;
  if (!s.ok) {
    return container;
  }
  // `r.fd` on a stream handle: the handle is its descriptor, so the
  // projection is the value itself read as the i32.
  if (fa.field == "fd" && semtypes.is_stream(s.values[container.id])) {
    return define(s, ssasem.cast(), [container.id], 0, "", t_i32());
  }
  let sig: checker.StructSig = record_sig(s.values[container.id], s);
  if (sig.name.len() == 0) {
    return refused(s, "unsupported projection");
  }
  let at: i32 = record_field_index(sig, fa.field);
  if (at < 0 || !semtypes.concrete(sig.field_types[at], false)) {
    return refused(s, "record projection contract");
  }
  return define(s, ssasem.record_get(), [container.id], at, fa.field, sig.field_types[at]);
}

// The values a literal wrote, in written order, with the schema slot each one
// names: `at[i]` is the slot `ids[i]` fills. Written order is the order the
// AST lowering evaluates them in, and the order a side effect between two of
// them would show, so it is the order they are PRODUCED in whatever order
// they end up placed.
struct Written { s: State, ids: i32[], at: i32[] }

function written_fields(sl: ast.ExprStructLit, sig: checker.StructSig, s: State): Written {
  let ids: i32[] = [];
  let at: i32[] = [];
  let i: i32 = 0;
  while (i < sl.field_values.len()) {
    let slot: i32 = field_slot(sig, sl.field_names[i]);
    if (slot < 0 || index_of_i32(at, slot) >= 0) {
      return Written { s: fail(s, "unsupported record literal"), ids: [], at: [] };
    }
    let v: Value = expr(sl.field_values[i], s, sig.field_types[slot]);
    s = v.s;
    if (!s.ok) {
      return Written { s: s, ids: [], at: [] };
    }
    if (!semtypes.equal(s.values[v.id], sig.field_types[slot])) {
      return Written { s: fail(s, "record field type"), ids: [], at: [] };
    }
    v = kept_view(unaliased_view(v));
    s = v.s;
    ids = ids.append(v.id);
    at = at.append(slot);
    i = i + 1;
  }
  return Written { s: s, ids: ids, at: at };
}

// The construction is positional, so the written values are placed into
// declaration order by the slot their NAME selected. A slot the literal did
// not name is read off the base; a plain literal names them all and passes no
// base, so it reaches no such read.
function place_fields(w: Written, sig: checker.StructSig, base: i32): Written {
  if (!w.s.ok) {
    return w;
  }
  let s: State = w.s;
  let ids: i32[] = [];
  let d: i32 = 0;
  while (d < sig.field_names.len()) {
    let found: i32 = index_of_i32(w.at, d);
    if (found >= 0) {
      ids = ids.append(w.ids[found]);
    } else {
      let got: Value = define(s, ssasem.record_get(), [base], d, sig.field_names[d], sig.field_types[d]);
      s = got.s;
      if (!s.ok) {
        return Written { s: s, ids: [], at: [] };
      }
      ids = ids.append(got.id);
    }
    d = d + 1;
  }
  return Written { s: s, ids: ids, at: w.at };
}

function built_record(w: Written, ty: typeinfo.Type, base: i32): Value {
  if (!w.s.ok) {
    return Value { s: w.s, id: 0 - 1 };
  }
  return define(w.s, ssasem.record_new(), w.ids, base, "", ty);
}

// An update names the base first, then the fields it replaces in written
// order, and reads the rest off the base — the order semir.build_record
// lowers this shape in. A projection is a borrow anchored to the base, and
// the construction takes its own unit of every reference field, so the base
// stays live to the construction and is released after it. The construction
// names its base (ssasem.update_base).
function record_update(e: ast.Expr, sl: ast.ExprStructLit, s: State): Value {
  let ty: typeinfo.Type = record_type(sl.type_name, s);
  let sig: checker.StructSig = record_sig(ty, s);
  if (sig.name.len() == 0) {
    return refused(s, "unsupported record literal");
  }
  let base: Value = expr(sl.base, s, ty);
  s = base.s;
  if (!s.ok) {
    return base;
  }
  if (!semtypes.equal(s.values[base.id], ty)) {
    return refused(s, "record base type");
  }
  return built_record(place_fields(written_fields(sl, sig, s), sig, base.id), ty, base.id + 1);
}

function field_slot(sig: checker.StructSig, name: string): i32 {
  let i: i32 = 0;
  while (i < sig.field_names.len()) {
    if (sig.field_names[i] == name) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

function index_of_i32(xs: i32[], v: i32): i32 {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == v) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// A plain literal names every field exactly once, in whatever order the source
// likes — neither checker asks for declaration order, and this compiler's own
// sources do not use it. So the literal is placed by name like an update
// rather than refused for how it was written.
//
// Placement needs no base: the literal supplies as many fields as the schema
// declares, each naming a distinct slot of it, so the written fields cover
// every slot exactly once and no slot is left to read.
function record(e: ast.Expr, sl: ast.ExprStructLit, s: State): Value {
  if (sl.has_base) {
    return record_update(e, sl, s);
  }
  let ty: typeinfo.Type = record_type(sl.type_name, s);
  let sig: checker.StructSig = record_sig(ty, s);
  if (sig.name.len() == 0 || sl.field_values.len() != sig.field_types.len()) {
    return refused(s, "unsupported record literal");
  }
  return built_record(place_fields(written_fields(sl, sig, s), sig, 0 - 1), ty, 0);
}

// A literal's type is the struct it names: record_schema admits only a
// declaration without type parameters, so the name is the whole of it, read
// at the template's binding when the struct was cloned at a variable. The
// checker's reading of the literal is not consulted, since a field holding a
// value block over a template call is one it leaves untyped while every
// field is produced at its declared type here anyway.
function record_type(name: string, s: State): typeinfo.Type {
  return resolved(typeinfo.TypeStruct { name: record_schema(name, s).name, args: [] }, s.template, s.binding, s.scope);
}

// A variant literal supplies its payload fields in declaration order; the
// value is its enum.
function variant(name: string, whole: typeinfo.Type, written: ast.Expr[], s: State): Value {
  let layout: i32 = union_layout(s, union_name(whole));
  if (layout != semrecords.layout_variant() && layout != semrecords.layout_option()) {
    return refused(s, "unsupported variant literal");
  }
  let shape: Payloads = literal_payloads(s, whole, name, layout);
  // A `void` payload's literal writes `Ok(())`: the one argument carries nothing.
  let args: ast.Expr[] = written;
  if (shape.unit && written.len() == 1 && parser.is_unit_expr(written[0])) {
    args = [];
  }
  if (!shape.found || !semtypes.concrete(whole, false) || args.len() != shape.types.len()) {
    return refused(s, "unsupported variant literal");
  }
  let ids: i32[] = [];
  let i: i32 = 0;
  while (i < args.len()) {
    let v: Value = expr(args[i], s, shape.types[i]);
    s = v.s;
    if (!s.ok) {
      return v;
    }
    // A narrower payload widens into a wider field of its signedness, as
    // the checker admits `Ok(n)` for an i32 `n` into `Result[i64, _]`.
    if (widens_to(s.values[v.id], shape.types[i])) {
      v = define(s, ssasem.cast(), [v.id], 0, "", shape.types[i]);
      s = v.s;
    }
    if (!semtypes.equal(s.values[v.id], shape.types[i])) {
      return refused(s, "variant field type");
    }
    v = kept_view(unaliased_view(v));
    s = v.s;
    ids = ids.append(v.id);
    i = i + 1;
  }
  return define(s, ssasem.variant_new(), ids, 0, name, whole);
}

// An unsuffixed integer literal names no width of its own, so it cannot be the
// operand that decides one.
function width_bearing(e: ast.Expr): boolean {
  match (e) {
    ast.ExprNumber(n) => {
      return n.suffix != "";
    },
    _ => {
      return true;
    }
  }
  return true;
}

// A type an operator can run at: one integer type, or the f64.
function operand_type(t: typeinfo.Type): boolean {
  return ssasem.is_integer(t) || ssasem.is_float(t);
}

// The width an operator runs at, decided before either operand is produced so
// that a literal on EITHER side takes it. A tree of unsuffixed literals
// (`0 - 1`) is read at the destination's width, as the checker settles it,
// since the checker types the tree alone at the default width. Otherwise an
// arithmetic result is the width the checker's type for the whole expression
// names; a comparison's is not, so it comes from whichever operand names one.
// A float literal tree (`0.0 - 1.0`) is read at the destination's float width
// the same way.
function operand_width(e: ast.Expr, b: ast.ExprBinary, s: State, expected: typeinfo.Type): typeinfo.Type {
  if (ssasem.checked_arith(b.op)) {
    expected = option_payload(expected);
  }
  if (parser.int_literal_tree(e) && ssasem.is_integer(expected)) {
    return expected;
  }
  if (parser.float_literal_tree(e) && ssasem.is_float(expected)) {
    return expected;
  }
  let addr: typeinfo.Type = address_width(b, s);
  if (ssasem.is_usize(addr)) {
    return addr;
  }
  let whole: typeinfo.Type = checked(e, s);
  if (operand_type(whole)) {
    return whole;
  }
  if (width_bearing(b.left)) {
    let l: typeinfo.Type = checked(b.left, s);
    if (operand_type(l)) {
      return l;
    }
  }
  if (width_bearing(b.right)) {
    let r: typeinfo.Type = checked(b.right, s);
    if (operand_type(r)) {
      return r;
    }
  }
  return typeinfo.unchecked();
}

// The payload an Option expectation names, for the checked operator whose
// operands are what the expectation is an Option of.
function option_payload(t: typeinfo.Type): typeinfo.Type {
  if let typeinfo.TypeUnion(u) = t {
    if (u.name == "Option" && u.args.len() == 1) {
      return u.args[0];
    }
  }
  return typeinfo.unchecked();
}

// An address decides the width of the operator it appears in, on whichever
// side it appears: the checker widens the other operand to the pointer width
// rather than running the operator at the narrower one. A comparison is why
// this is asked of the operands rather than read off the whole expression,
// whose type is the boolean.
function address_width(b: ast.ExprBinary, s: State): typeinfo.Type {
  if (width_bearing(b.left)) {
    let l: typeinfo.Type = checked(b.left, s);
    if (ssasem.is_usize(l)) {
      return l;
    }
  }
  if (width_bearing(b.right)) {
    let r: typeinfo.Type = checked(b.right, s);
    if (ssasem.is_usize(r)) {
      return r;
    }
  }
  return typeinfo.unchecked();
}

// The widening the checker inserts on the narrower side of a pointer-width
// operator, which the tree this producer reads does not carry. It is emitted
// with the operand it converts, since the stack IR's operands are the two
// values on top of it in order.
function address_widen(v: Value, want: typeinfo.Type): Value {
  if (!v.s.ok || !ssasem.is_usize(want)) {
    return v;
  }
  let t: typeinfo.Type = v.s.values[v.id];
  if (ssasem.is_usize(t) || !ssasem.is_integer(t)) {
    return v;
  }
  return define(v.s, ssasem.cast(), [v.id], 0, "", want);
}

function binary(e: ast.Expr, b: ast.ExprBinary, s: State, expected: typeinfo.Type): Value {
  if (b.op == "&&" || b.op == "||") {
    return logical(b, s);
  }
  let want: typeinfo.Type = operand_width(e, b, s, expected);
  // With no width known before either side is produced, a literal side is
  // read at the other side's integer type, as the checker settles it. A
  // literal has no effects, so producing the other side first is safe.
  if (!operand_type(want) && parser.int_literal_tree(b.left) && !parser.int_literal_tree(b.right)) {
    let first: Value = expr(b.right, s, want);
    if (!first.s.ok) {
      return first;
    }
    let wide: typeinfo.Type = first.s.values[first.id];
    if (ssasem.is_integer(wide)) {
      let lit: Value = expr(b.left, first.s, wide);
      if (!lit.s.ok) {
        return lit;
      }
      return arithmetic(b, lit, Value { s: lit.s, id: first.id }, lit.s);
    }
  }
  let left: Value = address_widen(expr(b.left, s, want), want);
  s = left.s;
  if (!s.ok) {
    return left;
  }
  if (!operand_type(want) && parser.int_literal_tree(b.right) && ssasem.is_integer(s.values[left.id]) && !wide_literal(b.right)) {
    want = s.values[left.id];
  }
  if (!operand_type(want) && parser.float_literal_tree(b.right) && ssasem.is_float(s.values[left.id])) {
    want = s.values[left.id];
  }
  // The left operand decides whether this is a composite comparison, and the
  // decision is taken before the RIGHT one is produced: the method call
  // produces it, and producing it here too would give the call two values for
  // one expression.
  let key: string = composite_key(b.op, s.values[left.id], s);
  if (key != "") {
    return composite_compare(b, left, key, s);
  }
  let arith: string = nominal_method_key(ast.operator_method(b.op), s.values[left.id], s);
  if (arith != "") {
    return operator_method(left, [b.right], arith, s);
  }
  if (b.op == "+" && ssasem.is_string(s.values[left.id])) {
    if let Some(c) = builtin_slice(b.right, s) {
      return range_append(left, c, s);
    }
  }
  let right: Value = address_widen(expr(b.right, s, want), want);
  s = right.s;
  if (!s.ok) {
    return right;
  }
  return arithmetic(b, left, right, s);
}

function arithmetic(b: ast.ExprBinary, left: Value, right: Value, s: State): Value {
  right = shift_count(b.op, right, s.values[left.id]);
  s = right.s;
  // A narrower operand meets a wider one of its own signedness at the wider
  // width, as the checker settles it; every other mix is E009.
  if (widens_to(s.values[left.id], s.values[right.id])) {
    left = define(s, ssasem.cast(), [left.id], 0, "", s.values[right.id]);
    s = left.s;
  } else if (widens_to(s.values[right.id], s.values[left.id])) {
    right = define(s, ssasem.cast(), [right.id], 0, "", s.values[left.id]);
    s = right.s;
  }
  let ty: typeinfo.Type = ssasem.binary_result(b.op, s.values[left.id], s.values[right.id]);
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "operator contract: " + typeinfo.spelling(s.values[left.id]) + " " + b.op + " " + typeinfo.spelling(s.values[right.id]));
  }
  return define(s, 9, [left.id, right.id], 0, b.op, ty);
}

// A literal past the i32 range keeps its own i64 width rather than taking a
// narrower operand's, which would truncate it.
function wide_literal(e: ast.Expr): boolean {
  if let ast.ExprNumber(n) = e {
    return !n.is_float && n.suffix == "" && parser.literal_is_i64(n.text);
  }
  return false;
}

function widens_to(from: typeinfo.Type, to: typeinfo.Type): boolean {
  if let typeinfo.TypeI32(a) = from {
    if let typeinfo.TypeI32(b) = to {
      return a.width > 0 && a.width < b.width && a.unsigned == b.unsigned && !a.is_char && !b.is_char;
    }
  }
  return false;
}

// A struct or an enum compares STRUCTURALLY, through the method its `@derive`
// or its own `impl` supplies: `a == b` is `a.eq(b)` and an ordering is
// `a.cmp(b) <op> 0`. Without that the integer dispatch would compare the two
// BOX ADDRESSES, so two equal values would read as different and an ordering
// would read allocation order — the same desugar the native checker applies.
//
// The key is read off the left operand's produced TYPE, so a comparison of
// scalars costs one name test and no lookup. A nominal type with no such
// method falls through to the operator refusal, which names the type rather
// than a contract the program never asked for.
function composite_key(op: string, left: typeinfo.Type, s: State): string {
  return nominal_method_key(comparison_verb(op), left, s);
}

// The contract key of the method `verb` on a struct or enum type, or "" when
// the operand is not nominal or the type supplies no such method.
function nominal_method_key(verb: string, t: typeinfo.Type, s: State): string {
  if (verb == "") {
    return "";
  }
  let owner: string = struct_name(t);
  if (owner == "") {
    owner = union_name(t);
  }
  if (owner == "") {
    return "";
  }
  let key: string = owner + "." + verb;
  if (ssasem.find_contract(s.contracts, key) < 0) {
    return "";
  }
  return key;
}

function operator_method(recv: Value, args: ast.Expr[], key: string, s: State): Value {
  let contract: ssasem.Contract = s.contracts.list[ssasem.find_contract(s.contracts, key)];
  if (args.len() + 1 != contract.params.len()) {
    return refused(s, "call arity");
  }
  return invoke_method(recv, args, contract, s, ssasem.unbound(), ssasem.unbound());
}

// The method a comparison goes through: the two equalities read `eq` and the
// four orderings read `cmp`. Every other operator reads neither.
function comparison_verb(op: string): string {
  if (op == "==" || op == "!=") {
    return "eq";
  }
  if (op == "<" || op == "<=" || op == ">" || op == ">=") {
    return "cmp";
  }
  return "";
}

// The receiver is the value in hand and the right operand is still written, so
// this is `invoke_method`'s shape exactly. `cmp` answers -1, 0 or 1, so the
// ordering the source wrote holds against a zero this emits.
function composite_compare(b: ast.ExprBinary, left: Value, key: string, s: State): Value {
  let contract: ssasem.Contract = s.contracts.list[ssasem.find_contract(s.contracts, key)];
  if (contract.params.len() != 2) {
    return refused(s, "call arity");
  }
  let call: Value = invoke_method(left, [b.right], contract, s, ssasem.unbound(), ssasem.unbound());
  s = call.s;
  if (!s.ok) {
    return call;
  }
  if (comparison_verb(b.op) == "eq") {
    if (!semtypes.equal(s.values[call.id], t_bool())) {
      return refused(s, "operator contract: " + key + " answers " + typeinfo.spelling(s.values[call.id]));
    }
    if (b.op == "==") {
      return call;
    }
    return define(s, 10, [call.id], 0, "!", t_bool());
  }
  if (!ssasem.is_integer(s.values[call.id])) {
    return refused(s, "operator contract: " + key + " answers " + typeinfo.spelling(s.values[call.id]));
  }
  let zero: Value = define(s, 1, [], 0, "", s.values[call.id]);
  return define(zero.s, 9, [call.id, zero.id], 0, b.op, t_bool());
}

// A shift count is masked to the value's width, so a count of another integer
// width reaches the operator through the conversion the source never writes.
function shift_count(op: string, count: Value, value: typeinfo.Type): Value {
  if (op != "<<" && op != ">>") {
    return count;
  }
  let t: typeinfo.Type = count.s.values[count.id];
  if (!ssasem.is_integer(t) || !ssasem.is_integer(value) || semtypes.equal(t, value)) {
    return count;
  }
  return define(count.s, ssasem.cast(), [count.id], 0, "", value);
}

// Negation keeps its operand's type, so a destination width reaches the
// operand through it; a cast names its own destination and passes none on.
function unary(e: ast.Expr, u: ast.ExprUnary, s: State, expected: typeinfo.Type): Value {
  if (u.op == "try_") {
    return try_expr(u, s, expected);
  }
  if (u.op.len() > 4 && slice_unchecked(u.op, 0, 4) == "as?_") {
    return downcast(e, u, s);
  }
  if (parser.is_cast_op(u.op)) {
    return cast(e, u, s);
  }
  let want: typeinfo.Type = typeinfo.unchecked();
  if (u.op == "-") {
    want = expected;
  }
  let operand: Value = expr(u.operand, s, want);
  s = operand.s;
  if (!s.ok) {
    return operand;
  }
  if (u.op == "-") {
    let neg: string = nominal_method_key("neg", s.values[operand.id], s);
    if (neg != "") {
      return operator_method(operand, [], neg, s);
    }
  }
  let ty: typeinfo.Type = ssasem.unary_result(u.op, s.values[operand.id]);
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "operator contract: " + u.op + " " + typeinfo.spelling(s.values[operand.id]));
  }
  return define(s, 10, [operand.id], 0, u.op, ty);
}

// `e?` unwraps a two-variant enum: the success payload continues the
// expression, and the failure leaves the function carrying the same failure,
// rebuilt at the function's own result type. It is control flow rather than an
// operator, so the failure edge RETURNS and nothing joins — the value is the
// payload and the block left open is the success edge.
//
// Success is the first variant declared and failure the second, which is the
// order the tag test relies on (docs/TRY.md). Native's E078 has already
// enforced both the shape and the `@try` opt-in before any of this runs, so
// this re-derives only what the lowering needs rather than re-policing them.
function try_expr(u: ast.ExprUnary, s: State, expected: typeinfo.Type): Value {
  // The checker refuses this shape; a pipeline that lowers without checking
  // first (asm_modload_run) reaches it.
  if (s.replaying) {
    return refused(s, "`?` inside a defer action (E079)");
  }
  // `Some(lit)?` reads its literal at the width the `?` is read at.
  let want: typeinfo.Type = typeinfo.unchecked();
  if let ast.ExprCall(c) = u.operand {
    if let ast.ExprIdent(cn) = c.callee {
      if (cn.name == "Some" && semtypes.concrete(expected, false)) {
        want = typeinfo.TypeUnion { name: "Option", args: [expected] };
      }
    }
  }
  let v: Value = expr(u.operand, s, want);
  s = v.s;
  if (!s.ok) {
    return v;
  }
  let from: typeinfo.Type = s.values[v.id];
  let flayout: i32 = union_layout(s, union_name(from));
  let rlayout: i32 = union_layout(s, union_name(s.result));
  if (!try_layout(flayout)) {
    return refused(s, "try of a value that is not a union");
  }
  if (!try_layout(rlayout)) {
    return refused(s, "try in a body whose result is not a union");
  }
  let fnames: string[] = variant_names(s, from, flayout);
  let rnames: string[] = variant_names(s, s.result, rlayout);
  if (fnames.len() != 2 || rnames.len() != 2) {
    return refused(s, "try of a union that is not two variants");
  }
  let good_shape: Payloads = arm_payloads(s, from, fnames[0], flayout);
  let gone_shape: Payloads = arm_payloads(s, from, fnames[1], flayout);
  let out_shape: Payloads = literal_payloads(s, s.result, rnames[1], rlayout);
  let unit_good: boolean = good_shape.unit && good_shape.types.len() == 0;
  if (!good_shape.found || good_shape.types.len() != 1 && !unit_good) {
    return refused(s, "try of a success variant that is not one payload");
  }
  if (!gone_shape.found || !out_shape.found) {
    return refused(s, "try failure is not a variant");
  }
  if (gone_shape.types.len() > 1 || gone_shape.types.len() != out_shape.types.len()) {
    return refused(s, "try failure does not match the body's result");
  }
  let convert: string = "";
  if (gone_shape.types.len() == 1 && !semtypes.equal(gone_shape.types[0], out_shape.types[0])) {
    convert = try_conversion(gone_shape.types[0], out_shape.types[0], s);
    if (convert == "") {
      return refused(s, "try failure does not match the body's result");
    }
  }

  let pred: i32 = s.cur.id;
  let good: i32 = s.next_block;
  let leave: i32 = good + 1;
  s = State { ...s, next_block: leave + 1 };
  let test: Value = define(s, ssasem.variant_is(), [v.id], 0, fnames[0], t_bool());
  s = terminate(test.s, t_brif(test.id, good, leave));

  // The cleanup replays deferred assignments on the failure edge only, so
  // the success edge resumes with the bindings the test saw.
  let entry: State = s;
  let gone: State = stmts(s.try_cleanup, open(State { ...s, replaying: true }, leave, [pred]));
  if (!gone.ok) {
    return Value { s: gone, id: 0 };
  }
  let args: i32[] = [];
  if (gone_shape.types.len() == 1) {
    let carried: Value = define(gone, ssasem.variant_get(), [v.id], 0, fnames[1], gone_shape.types[0]);
    if (convert == "dyn") {
      carried = widen(carried, out_shape.types[0]);
    }
    if (convert != "" && convert != "dyn") {
      carried = operator_method(carried, [], convert, carried.s);
    }
    gone = carried.s;
    if (!gone.ok) {
      return carried;
    }
    if (!semtypes.equal(gone.values[carried.id], out_shape.types[0])) {
      return refused(gone, "try failure does not match the body's result");
    }
    args = [carried.id];
  }
  let out: Value = define(gone, ssasem.variant_new(), args, 0, rnames[1], s.result);
  s = terminate(out.s, t_ret(out.id));
  s = State { ...s, names: entry.names, vals: entry.vals, scope: entry.scope, replaying: entry.replaying };

  if (unit_good) {
    return define(open(s, good, [pred]), 1, [], 0, "", t_void());
  }
  return define(open(s, good, [pred]), ssasem.variant_get(), [v.id], 0, fnames[0], good_shape.types[0]);
}

// How a failure payload becomes the body's: a dyn result widens it, and any
// other takes the target's `from` (`Err(E2.from(e))`, docs/TRY.md). The answer
// is "dyn", the `from` contract's key, or "" when neither applies.
function try_conversion(from: typeinfo.Type, to: typeinfo.Type, s: State): string {
  if (ssasem.is_dyn(to)) {
    return "dyn";
  }
  let key: string = nominal_method_key("from", to, s);
  if (key == "") {
    return "";
  }
  let c: ssasem.Contract = s.contracts.list[ssasem.find_contract(s.contracts, key)];
  if (c.params.len() != 1 || !semtypes.equal(c.params[0], from)) {
    return "";
  }
  return key;
}

// `x as? T` is `Some(x)` narrowed to `T` when the dyn box is a `T`, and `None`
// otherwise: a test of the box's shape, and a branch joining the two options.
// The narrowing is the same box, so `Some` holds a unit of it.
function downcast(e: ast.Expr, u: ast.ExprUnary, s: State): Value {
  let v: Value = expr(u.operand, s, typeinfo.unchecked());
  s = v.s;
  if (!s.ok) {
    return v;
  }
  if (!ssasem.is_dyn(s.values[v.id])) {
    return refused(s, "downcast of a value that is not dyn");
  }
  let target: string = slice_unchecked(u.op, 4, u.op.len()) + "";
  let concrete: typeinfo.Type = resolved(s.scope.resolve_type(target), s.template, s.binding, s.scope);
  if (struct_name(concrete) != target && union_name(concrete) != target) {
    return refused(s, "downcast target: " + target);
  }
  if (union_name(concrete) == target && union_layout(s, target) != semrecords.layout_variant() && union_layout(s, target) != semrecords.layout_member()) {
    return refused(s, "downcast to an enum whose box carries no shape: " + target);
  }
  let whole: typeinfo.Type = ssasem.option_of(concrete);
  let layout: i32 = semrecords.layout_option();
  let names: string[] = variant_names(s, whole, layout);
  let some: Payloads = literal_payloads(s, whole, names[0], layout);

  let pred: i32 = s.cur.id;
  let hit: i32 = s.next_block;
  let miss: i32 = hit + 1;
  let join: i32 = hit + 2;
  s = State { ...s, next_block: join + 1 };
  let test: Value = define(s, ssasem.dyn_is(), [v.id], 0, target, t_bool());
  s = terminate(test.s, t_brif(test.id, hit, miss));

  let narrowed: Value = define(open(s, hit, [pred]), ssasem.dyn_as(), [v.id], 0, target, some.types[0]);
  let yes: Value = define(narrowed.s, ssasem.variant_new(), [narrowed.id], 0, names[0], whole);
  let hit_end: i32 = yes.s.cur.id;
  s = terminate(yes.s, t_br(join));

  let no: Value = define(open(s, miss, [pred]), ssasem.variant_new(), [], 0, names[1], whole);
  let miss_end: i32 = no.s.cur.id;
  s = terminate(no.s, t_br(join));
  return define(open(s, join, [hit_end, miss_end]), 8, [yes.id, no.id], 0, "", whole);
}

function try_layout(layout: i32): boolean {
  return layout == semrecords.layout_option() || layout == semrecords.layout_variant();
}

// `e as T` reaches here as a unary whose operator names T. The destination is
// the checker's type for the whole expression rather than the spelling, so a
// cast to an alias or to a type this vocabulary does not admit refuses on what
// the checker resolved instead of on how it was written.
// An unresolved type has no spelling — typeinfo.spelling answers "" for
// TypeUnknown — so a refusal that named one said only that it was unresolved.
// The checker's own reason is the useful half and TypeUnknown carries it.
function type_detail(t: typeinfo.Type): string {
  if let typeinfo.TypeUnknown(u) = t {
    return u.reason;
  }
  return typeinfo.spelling(t);
}

function cast(e: ast.Expr, u: ast.ExprUnary, s: State): Value {
  // An ASCRIPTION names the operand's own type, so it is a destination the
  // way a binding's annotation is: a literal that cannot name its own type
  // takes it from here, and the cast itself lowers to nothing.
  let ty: typeinfo.Type = checked(e, s);
  let ascribes: boolean = semtypes.concrete(ty, false) && ssasem.cast_ascribes(ty);
  let want: typeinfo.Type = typeinfo.unchecked();
  if (ascribes) {
    want = ty;
  }
  let operand: Value = expr(u.operand, s, want);
  s = operand.s;
  if (!s.ok) {
    return operand;
  }
  if (ascribes && semtypes.equal(s.values[operand.id], ty)) {
    return operand;
  }
  if (!ssasem.cast_admits(s.values[operand.id], ty)) {
    return refused(s, "cast contract: " + typeinfo.spelling(s.values[operand.id]) + " as " + typeinfo.spelling(ty));
  }
  return define(s, ssasem.cast(), [operand.id], 0, "", ty);
}

// `e` as control flow, closing the current block: every block it ends in
// branches to `yes` when `e` holds and to `no` when it does not, and `Cond`
// lists them for the two targets' predecessors. `&&`, `||` and `!` become a
// chain of branches rather than a boolean joined in a phi and branched on
// again. A condition binds nothing, so each edge carries the same bindings.
struct Cond { s: State, yes: i32[], no: i32[] }

function cond(e: ast.Expr, s: State, yes: i32, no: i32): Cond {
  if let ast.ExprBinary(b) = e {
    if (b.op == "&&" || b.op == "||") {
      let mid: i32 = s.next_block;
      s = State { ...s, next_block: mid + 1 };
      if (b.op == "&&") {
        let l: Cond = cond(b.left, s, mid, no);
        if (!l.s.ok) {
          return l;
        }
        let r: Cond = cond(b.right, open(l.s, mid, l.yes), yes, no);
        return Cond { s: r.s, yes: r.yes, no: concat_ids(l.no, r.no) };
      }
      let el: Cond = cond(b.left, s, yes, mid);
      if (!el.s.ok) {
        return el;
      }
      let er: Cond = cond(b.right, open(el.s, mid, el.no), yes, no);
      return Cond { s: er.s, yes: concat_ids(el.yes, er.yes), no: er.no };
    }
  }
  if let ast.ExprUnary(u) = e {
    if (u.op == "!") {
      let n: Cond = cond(u.operand, s, no, yes);
      return Cond { s: n.s, yes: n.no, no: n.yes };
    }
  }
  let v: Value = expr(e, s, t_bool());
  s = v.s;
  if (!s.ok) {
    return Cond { s: s, yes: [], no: [] };
  }
  if (!is_bool(s.values[v.id])) {
    return Cond { s: fail(s, "condition type"), yes: [], no: [] };
  }
  let at: i32 = s.cur.id;
  return Cond { s: terminate(s, t_brif(v.id, yes, no)), yes: [at], no: [at] };
}

function concat_ids(a: i32[], b: i32[]): i32[] {
  let out: i32[] = a;
  for x in b {
    out = out.append(x);
  }
  return out;
}

// Short-circuit operators are control flow: the right operand runs on its
// own edge and the result joins as a boolean phi.
function logical(b: ast.ExprBinary, s: State): Value {
  let left: Value = expr(b.left, s, t_bool());
  s = left.s;
  if (!s.ok) {
    return left;
  }
  if (!is_bool(s.values[left.id])) {
    return refused(s, "operator contract");
  }
  let pred: i32 = s.cur.id;
  let rhs: i32 = s.next_block;
  let skip: i32 = rhs + 1;
  let join: i32 = rhs + 2;
  s = State { ...s, next_block: join + 1 };
  if (b.op == "&&") {
    s = terminate(s, t_brif(left.id, rhs, skip));
  } else {
    s = terminate(s, t_brif(left.id, skip, rhs));
  }
  let right: Value = expr(b.right, open(s, rhs, [pred]), t_bool());
  s = right.s;
  if (!s.ok) {
    return right;
  }
  if (!is_bool(s.values[right.id])) {
    return refused(s, "operator contract");
  }
  let rhs_end: i32 = s.cur.id;
  s = terminate(s, t_br(join));
  let short: Value = define(open(s, skip, [pred]), 2, [], boolean_value(b.op == "||"), "", t_bool());
  s = terminate(short.s, t_br(join));
  return define(open(s, join, [rhs_end, skip]), 8, [right.id, short.id], 0, "", t_bool());
}

// `.len` reads a counted array or string and hands back a fresh i32 that owns
// nothing.
function builtin_length(recv: Value, s: State): Value {
  let t: typeinfo.Type = s.values[recv.id];
  let sized: boolean = ssasem.is_text(t);
  if let typeinfo.TypeArray(_) = t {
    sized = true;
  }
  if (!sized) {
    return refused(s, "unsupported call target");
  }
  return define(s, ssasem.length(), [recv.id], 0, "", t_i32());
}

// `.append` hands the receiver's own unit to the runtime and takes back one:
// the same box when the push fits, a fresh one when it grew. The element is a
// value the new array holds; a view element anchors the array to its source
// (ssasem.gathers_views), as a view in an array literal does.
function builtin_append(c: ast.ExprCall, recv: Value, s: State): Value {
  let t: typeinfo.Type = s.values[recv.id];
  let elem: typeinfo.Type = element_type(t);
  if (!semtypes.concrete(elem, false)) {
    return refused(s, "unsupported call target");
  }
  let v: Value = expr(c.args[0], s, elem);
  s = v.s;
  if (!s.ok) {
    return v;
  }
  if (!semtypes.equal(s.values[v.id], elem)) {
    return refused(s, "append element type");
  }
  v = kept_view(unaliased_view(v));
  return define(v.s, ssasem.append(), [recv.id, v.id], 0, "", t);
}

// `.with` hands the receiver's own unit over the way `.append` does and takes
// back the array holding the value at the index, which anchors it as an
// append's element does.
function builtin_with(c: ast.ExprCall, recv: Value, s: State): Value {
  let t: typeinfo.Type = s.values[recv.id];
  let elem: typeinfo.Type = element_type(t);
  if (!semtypes.concrete(elem, false)) {
    return refused(s, "unsupported call target");
  }
  let at: Value = expr(c.args[0], s, t_i32());
  s = at.s;
  if (!s.ok) {
    return at;
  }
  if (!semtypes.equal(s.values[at.id], t_i32())) {
    return refused(s, "with index type");
  }
  let v: Value = expr(c.args[1], s, elem);
  s = v.s;
  if (!s.ok) {
    return v;
  }
  if (!semtypes.equal(s.values[v.id], elem)) {
    return refused(s, "with element type");
  }
  v = kept_view(unaliased_view(v));
  return define(v.s, ssasem.with(), [recv.id, at.id, v.id], 0, "", t);
}

// The join is declared on `string[]` alone, as the AST lowering gates it, so a
// receiver of any other shape falls through to a declared method of that name.
function is_string_array(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(a) = t {
    return ssasem.is_string(a.elem);
  }
  return false;
}

// `xs.join(sep)` reads the array and the separator and answers a fresh string.
// A view is a legal separator — the joined bytes are copied out of it — so the
// element rule an append carries does not apply here.
function builtin_join(c: ast.ExprCall, recv: Value, s: State): Value {
  let sep: Value = expr(c.args[0], s, t_string());
  s = sep.s;
  if (!s.ok) {
    return sep;
  }
  if (!ssasem.is_text(s.values[sep.id])) {
    return refused(s, "join separator type");
  }
  return define(s, ssasem.arr_join(), [recv.id, sep.id], 0, "", t_string());
}

// A cell's methods: `get` hands out a unit of the element, and `set` takes the
// new element's unit and returns nothing, so it stands only as a statement.
function cell_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: Value, s: State, statement: boolean): Value {
  let elem: typeinfo.Type = semtypes.cell_elem(s.values[recv.id]);
  if (fa.field == "get" && c.args.len() == 0) {
    return define(s, ssasem.cell_get(), [recv.id], 0, "", elem);
  }
  if (fa.field != "set" || c.args.len() != 1) {
    return refused(s, "unsupported call target");
  }
  if (!statement) {
    return refused(s, "unsupported void call");
  }
  let v: Value = expr(c.args[0], s, elem);
  s = v.s;
  if (!s.ok) {
    return v;
  }
  if (ssasem.is_view(s.values[v.id])) {
    return refused(s, "view element escapes its source");
  }
  if (!semtypes.equal(s.values[v.id], elem)) {
    return refused(s, "cell element type");
  }
  return define(s, ssasem.cell_set(), [recv.id, v.id], 0, "", t_void());
}

// A map's methods: `insert` (spelled `set` too, as the AST lowering admits
// both) hands over the receiver's unit and the key's and takes the map back;
// `has`, `get_or` and `len` read through borrowed operands and answer a
// scalar; `keys` and `values` snapshot a column into a fresh array; `without`
// hands the map back inside a tuple with whether the key was there, and
// `cleared` builds an empty map of the same shape. The iteration has backend
// ops but no contract here yet.
function map_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: Value, s: State): Value {
  let t: typeinfo.Type = s.values[recv.id];
  if (!ssasem.is_supported_map(t)) {
    return refused(s, "unsupported map shape: " + typeinfo.spelling(t));
  }
  if (fa.field == "len" && c.args.len() == 0) {
    return define(s, ssasem.map_len(), [recv.id], 0, "", t_i32());
  }
  if ((fa.field == "insert" || fa.field == "set") && c.args.len() == 2) {
    return map_write(c, recv, s, t);
  }
  if (fa.field == "has" && c.args.len() == 1) {
    return map_read(c, recv, s, t, ssasem.map_has(), t_bool());
  }
  if (fa.field == "get_or" && c.args.len() == 2) {
    return map_read(c, recv, s, t, ssasem.map_get_or(), ssasem.map_value(t));
  }
  if (fa.field == "get" && c.args.len() == 1) {
    return map_read(c, recv, s, t, ssasem.map_get(), ssasem.option_of(ssasem.map_value(t)));
  }
  if (fa.field == "keys" && c.args.len() == 0) {
    return map_column(s, recv, ssasem.map_keys(), ssasem.map_key(t));
  }
  if (fa.field == "values" && c.args.len() == 0) {
    return map_column(s, recv, ssasem.map_values(), ssasem.map_value(t));
  }
  if (fa.field == "without" && c.args.len() == 1) {
    return map_delete(c, recv, s, t);
  }
  if (fa.field == "cleared" && c.args.len() == 0) {
    return define(s, ssasem.map_cleared(), [], 0, "", t);
  }
  if (fa.field == "iter" && c.args.len() == 0) {
    return map_cursor(s, recv, t);
  }
  return refused(s, "unsupported call target: " + typeinfo.spelling(t) + "." + fa.field);
}

// `m.iter()` — the cursor over m. It is a block of its own, but it holds the
// map's address and an index and nothing else, so it reads the map's storage
// for as long as it lives and the frame neither counts it nor frees it.
function map_cursor(s: State, recv: Value, t: typeinfo.Type): Value {
  let cursor: typeinfo.Type = typeinfo.TypeStruct {
    name: "MapIter",
    args: [ssasem.map_key(t), ssasem.map_value(t)],
  };
  return define(s, ssasem.map_iter(), [recv.id], 0, "", cursor);
}

// The cursor's four. `key` and `value` read the map's own columns at the
// cursor and take no unit of what they answer, so the value is borrowed for
// as long as the map holds it; `advance` moves the cursor in place and
// answers nothing, so it stands only as a statement.
function map_iter_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: Value, s: State, statement: boolean): Value {
  let t: typeinfo.Type = s.values[recv.id];
  if (c.args.len() != 0) {
    return refused(s, "call arity");
  }
  if (fa.field == "has_next") {
    return define(s, ssasem.mapiter_has_next(), [recv.id], 0, "", t_bool());
  }
  if (fa.field == "key") {
    return define(s, ssasem.mapiter_key(), [recv.id], 0, "", semtypes.map_iter_key(t));
  }
  if (fa.field == "value") {
    return define(s, ssasem.mapiter_value(), [recv.id], 0, "", semtypes.map_iter_value(t));
  }
  if (fa.field == "advance") {
    if (!statement) {
      return refused(s, "unsupported void call");
    }
    return define(s, ssasem.mapiter_advance(), [recv.id], 0, "", t_void());
  }
  return refused(s, "unsupported call target: " + typeinfo.spelling(t) + "." + fa.field);
}

// A delete finds the entry by comparing the key — it does not keep it — and
// hands the map back inside a fresh tuple with whether it was there. The
// removal releases the entry's key and value through the releases the
// physical lowering names for the columns, so a column the map owns a unit of
// per entry gives that unit back with the entry (#9970).
function map_delete(c: ast.ExprCall, recv: Value, s: State, t: typeinfo.Type): Value {
  let k: Value = map_key_value(c.args[0], s, t, false);
  s = k.s;
  if (!s.ok) {
    return k;
  }
  return define(s, ssasem.map_delete(), [recv.id, k.id], 0, "", ssasem.delete_result(t));
}

// A column snapshot answers a FRESH array whose ownership follows the column.
// The runtime copies a string column or a column of boxes with a per-element
// retain, so the array owns its elements; a column of i32s or of i64s holds no
// references, so there is nothing to own past the buffer. Every other element type is
// handed back as a raw alias of the map's own elements — the frame would
// release what the map still holds, so it is refused here rather than
// described as owned.
function map_column(s: State, recv: Value, kind: i32, elem: typeinfo.Type): Value {
  if (!ssasem.retained_column(elem)) {
    return refused(s, "aliased column element: " + typeinfo.spelling(elem));
  }
  return define(s, kind, [recv.id], 0, "", typeinfo.TypeArray { elem: elem, view: false });
}

// An INSERT's key joins the map's key column, and `keys` would hand out the
// column's own view box, so a view key is refused there. A READ's key is
// hashed and compared, and `operation_supplies` counts no unit for it, so a view is an
// ordinary lend and takes the same retag a borrowed parameter offers.
function map_key_value(e: ast.Expr, s: State, t: typeinfo.Type, stored: boolean): Value {
  let column: typeinfo.Type = ssasem.map_key(t);
  let k: Value = expr(e, s, column);
  if (!k.s.ok) {
    return k;
  }
  if (!stored) {
    k = lend(k, column, ssaunits.borrow_mode(), false);
  }
  // A `str` key column holds an owned copy of each key: a view's box cannot
  // be counted, and `keys` would otherwise hand out the column's own box. A
  // view stored into a `string` column is refused.
  if (ssasem.is_view(k.s.values[k.id])) {
    if (!ssasem.is_view(column)) {
      return refused(k.s, "view element escapes its source");
    }
    if (stored) {
      k = lend(k, t_string(), ssaunits.borrow_mode(), true);
    }
    return k;
  }
  if (ssasem.is_view(column) && ssasem.is_string(k.s.values[k.id])) {
    return k;
  }
  if (!semtypes.equal(k.s.values[k.id], column)) {
    return refused(k.s, "map key type");
  }
  return k;
}

function map_write(c: ast.ExprCall, recv: Value, s: State, t: typeinfo.Type): Value {
  let k: Value = map_key_value(c.args[0], s, t, true);
  s = k.s;
  if (!s.ok) {
    return k;
  }
  let v: Value = expr(c.args[1], s, ssasem.map_value(t));
  s = v.s;
  if (!s.ok) {
    return v;
  }
  if (!semtypes.equal(s.values[v.id], ssasem.map_value(t))) {
    return refused(s, "map value type");
  }
  v = kept_view(unaliased_view(v));
  return define(v.s, ssasem.map_insert(), [recv.id, k.id, v.id], 0, "", t);
}

// A lookup borrows the map and the key and answers a scalar the map goes on
// owning: `has` takes the key alone, `get_or` a default of the value type.
function map_read(c: ast.ExprCall, recv: Value, s: State, t: typeinfo.Type, kind: i32, result: typeinfo.Type): Value {
  let k: Value = map_key_value(c.args[0], s, t, false);
  s = k.s;
  if (!s.ok) {
    return k;
  }
  let ids: i32[] = [recv.id, k.id];
  if (c.args.len() == 2) {
    let d: Value = expr(c.args[1], s, ssasem.map_value(t));
    s = d.s;
    if (!s.ok) {
      return d;
    }
    if (!semtypes.equal(s.values[d.id], ssasem.map_value(t))) {
      return refused(s, "map value type");
    }
    ids = ids.append(d.id);
  }
  return define(s, kind, ids, 0, "", result);
}

// The same array surface declared the other way round: std/array writes its
// methods as FREE functions named `__method_Array_<field>` with the receiver
// as the first parameter, which the checker resolves for `xs.<field>(...)`.
// The bundler prefixes the module, so the contract's name ENDS with the
// convention name rather than being it — the suffix match the checker's own
// `has_array_method` does, for the same reason.
function array_module_method(contracts: ssasem.Contracts, field: string): i32 {
  let target: string = "__method_Array_" + field;
  let i: i32 = 0;
  while (i < contracts.list.len()) {
    let nm: string = contracts.list[i].name;
    if (nm == target) {
      return i;
    }
    if (nm.len() > target.len() && slice_unchecked(nm, nm.len() - target.len(), nm.len()) == target) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// `xs.first()` where `first` is declared `(xs: T[]) first()`: the registration
// pass folded it into the free generic `__arrm_first[T]`, and this is the call
// to that template with the receiver at argument 0. `__mapm_` is the map
// sibling. The instance is asked for on this call's request, the way any other
// generic call asks, so the method body is produced once per element type.
function folded_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: Value, s: State, statement: boolean): Value {
  if (c.type_args.len() > 0) {
    return refused(s, "unsupported call target");
  }
  let prefix: string = "";
  // Dispatch by the checked surface receiver, before physical view erasure.
  let receiver_type: typeinfo.Type = checked(fa.obj, s);
  if let typeinfo.TypeArray(a) = receiver_type {
    prefix = "__arrm_";
    if (a.view) {
      prefix = "__viewm_";
    }
  }
  if (ssasem.is_map(s.values[recv.id])) {
    prefix = "__mapm_";
  }
  // register_struct_method_generics folds a THIRD shape, a method with its
  // own type variables on a generic-struct receiver, to `__smm_<Base>_<m>`.
  // No arm keys that prefix, so such a call falls to primitive_method and
  // refuses on the contract its receiver's spelling does not name. Keying
  // the prefix is not enough on its own: the fold leaves the method's own
  // variables on the template, and nothing here binds them.
  if (prefix == "") {
    return primitive_method(c, fa, recv, s, statement);
  }
  let at: i32 = ssasem.find_contract(s.contracts, parser.concrete_array_method_name(typeinfo.spelling(receiver_type), fa.field));
  if (at < 0) {
    at = ssasem.find_contract(s.contracts, prefix + fa.field);
  }
  if (at < 0 && prefix == "__arrm_") {
    at = array_module_method(s.contracts, fa.field);
  }
  if (at < 0) {
    return primitive_method(c, fa, recv, s, statement);
  }
  let contract: ssasem.Contract = s.contracts.list[at];
  if (c.args.len() + 1 != contract.params.len()) {
    return refused(s, "call arity");
  }
  if (is_void(contract.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  return invoke_method(recv, c.args, contract, s, written_binding(c, contract, s), ssasem.unbound());
}

// A method declared on a PRIMITIVE receiver — `(n: i32) gcd(m: i32)` — is
// keyed by its receiver's spelling, the way a record's is keyed by its
// declaration: `i32.gcd`. A text receiver reaches its methods through the
// `string` owner above; every other scalar had no owner name at all, so the
// key was never built and the whole of std/i32's surface read as a builtin
// this boundary does not own.
function primitive_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: Value, s: State, statement: boolean): Value {
  // Keyed as decl_key keys the declaration: `(m: Map[string, i32]) f` is `Map.f`.
  let owner: string = parser.receiver_base(typeinfo.spelling(s.values[recv.id]));
  if (owner.len() == 0) {
    return refused(s, "unsupported call target");
  }
  let at: i32 = ssasem.find_contract(s.contracts, owner + "." + fa.field);
  if (at < 0) {
    return refused(s, "unsupported call target");
  }
  let contract: ssasem.Contract = s.contracts.list[at];
  if (c.args.len() + 1 != contract.params.len()) {
    return refused(s, "call arity");
  }
  if (is_void(contract.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  return invoke_method(recv, c.args, contract, s, written_binding(c, contract, s), ssasem.unbound());
}

// The builtin methods with a contract here. Every other builtin, and every
// local function value, is still outside this boundary.
function builtin_call(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: Value, s: State, statement: boolean): Value {
  if (c.type_args.len() > 0) {
    return refused(s, "unsupported call target");
  }
  if (semtypes.is_cell(s.values[recv.id])) {
    return cell_method(c, fa, recv, s, statement);
  }
  if (ssasem.is_map(s.values[recv.id])) {
    return map_method(c, fa, recv, s);
  }
  if (semtypes.is_map_iter(s.values[recv.id])) {
    return map_iter_method(c, fa, recv, s, statement);
  }
  if (fa.field == "len" && c.args.len() == 0) {
    return builtin_length(recv, s);
  }
  if ((fa.field == "bytes" || fa.field == "as_bytes") && c.args.len() == 0 && ssasem.is_text(s.values[recv.id])) {
    if (fa.field == "as_bytes") {
      return define(s, ssasem.str_byte_view(), [recv.id], 0, "", typeinfo.TypeArray { elem: t_u8(), view: true });
    }
    return define(s, ssasem.str_bytes(), [recv.id], 0, "", typeinfo.TypeArray { elem: t_u8(), view: false });
  }
  if (fa.field == "append" && c.args.len() == 1) {
    return builtin_append(c, recv, s);
  }
  if (fa.field == "with" && c.args.len() == 2) {
    return builtin_with(c, recv, s);
  }
  if (fa.field == "join" && c.args.len() == 1 && is_string_array(s.values[recv.id])) {
    return builtin_join(c, recv, s);
  }
  return refused(s, "unsupported call target: " + typeinfo.spelling(s.values[recv.id]) + "." + fa.field);
}

// A call is verified against the callee's declared contract: exact argument
// types, and a result the callee hands over. A method call names its callee
// the way the declaration keyed its contract, and the way every backend labels
// the body: <Type>.<method>. The receiver is argument 0, because the callee
// declared it as parameter 0.
// The element a tuple projection names, or -1 when `field` is not an index
// into a tuple of `n` elements.
function tuple_index(field: string, n: i32): i32 {
  if (field.len() == 0 || field.len() > 4) {
    return 0 - 1;
  }
  let at: i32 = 0;
  let i: i32 = 0;
  while (i < field.len()) {
    let d: i32 = field[i] as i32 - 48;
    if (d < 0 || d > 9) {
      return 0 - 1;
    }
    at = at * 10 + d;
    i = i + 1;
  }
  if (at >= n) {
    return 0 - 1;
  }
  return at;
}

function method_call(c: ast.ExprCall, fa: ast.ExprFieldAccess, s: State, statement: boolean, expected: typeinfo.Type): Value {
  // An insert hands its receiver back, so the receiver's shape is the
  // call's: the head of a literal's `map_new(n).insert(k, v)` chain names no
  // shape of its own and takes the destination's through the chain, or the
  // checker's reading of the whole literal where no destination names one.
  let want: typeinfo.Type = typeinfo.unchecked();
  if (fa.field == "insert" || fa.field == "set") {
    if (ssasem.is_map(expected)) {
      want = expected;
    } else if (ssasem.is_map(checked(c, s))) {
      want = checked(c, s);
    }
  }
  let recv: Value = expr(fa.obj, s, want);
  s = recv.s;
  if (!s.ok) {
    return recv;
  }
  if (ssasem.is_dyn(s.values[recv.id])) {
    return dyn_method(c, fa, recv, s, statement);
  }
  let owner: string = struct_name(s.values[recv.id]);
  if (owner == "") {
    owner = union_name(s.values[recv.id]);
  }
  // A record FIELD of function type is not a method. The contract table keys
  // methods by `Type.name` and holds nothing for a field, so `h.f(0)` is the
  // field read and a call through what it holds. The receiver is already
  // produced, so the read takes its value rather than evaluating the object a
  // second time.
  let fsig: checker.StructSig = record_sig(s.values[recv.id], s);
  if (fsig.name.len() > 0) {
    let fat: i32 = record_field_index(fsig, fa.field);
    if (fat >= 0 && ssasem.is_func(fsig.field_types[fat])) {
      let fv: Value = define(s, ssasem.record_get(), [recv.id], fat, fa.field, fsig.field_types[fat]);
      if (!fv.s.ok) {
        return fv;
      }
      return indirect_call(c, fv.id, fv.s, statement);
    }
  }
  // A tuple ELEMENT of function type is the same shape one container over:
  // `p.0(1)` is the element read and a call through what it holds.
  if let typeinfo.TypeTuple(tup) = s.values[recv.id] {
    let tat: i32 = tuple_index(fa.field, tup.elements.len());
    if (tat >= 0 && ssasem.is_func(tup.elements[tat])) {
      let tv: Value = define(s, ssasem.tuple_get(), [recv.id], tat, "", tup.elements[tat]);
      if (!tv.s.ok) {
        return tv;
      }
      return indirect_call(c, tv.id, tv.s, statement);
    }
  }
  // A builtin's receiver names no declaration this boundary can hold a
  // contract for, so it is matched by shape instead. A string's methods are
  // declared in the standard library on a `string` receiver, and a view
  // reaches them as a lent box; the builtins every text has come first.
  if (owner == "" && (fa.field == "len" || fa.field == "append" || fa.field == "bytes" || fa.field == "as_bytes" || !ssasem.is_text(s.values[recv.id]))) {
    let b: Value = builtin_call(c, fa, recv, s, statement);
    if (b.s.ok) {
      return b;
    }
    // A receiver the builtin vocabulary does not own may still be a method
    // DECLARED on a generic receiver. The builtin is tried first so a
    // shape this boundary lowers itself keeps its op, and the declared
    // method fills the rest; the refused attempt's state is dropped, so
    // the retry produces the arguments once.
    let folded: Value = folded_method(c, fa, recv, s, statement);
    if (folded.s.ok) {
      return folded;
    }
    return b;
  }
  if (owner == "") {
    owner = "string";
  }
  let key: string = owner + "." + fa.field;
  let at: i32 = ssasem.find_contract(s.contracts, key);
  if (at < 0) {
    return refused(s, "call target has no semantic contract: " + key);
  }
  let contract: ssasem.Contract = s.contracts.list[at];
  if (c.args.len() + 1 != contract.params.len()) {
    return refused(s, "call arity");
  }
  if (is_void(contract.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  // A method on a generic receiver is a template the receiver instantiates.
  if (ssasem.contract_variables(contract).len() > 0) {
    return invoke_method(recv, c.args, contract, s, written_binding(c, contract, s), destination_binding(contract, expected));
  }
  // The receiver is produced before its contract is found, so it widens
  // here as an argument does in `expr`: a `str` method takes a `string`.
  recv = lend(widen(recv, contract.params[0]), contract.params[0], contract.modes[0], keeps(s, key));
  s = recv.s;
  if (!semtypes.equal(s.values[recv.id], contract.params[0])) {
    return refused(s, "call receiver type");
  }
  let ids: i32[] = [recv.id];
  let i: i32 = 0;
  while (i < c.args.len()) {
    let v: Value = lend(expr(c.args[i], s, contract.params[i + 1]), contract.params[i + 1], contract.modes[i + 1], keeps(s, key));
    s = v.s;
    if (!s.ok) {
      return v;
    }
    if (!semtypes.equal(s.values[v.id], contract.params[i + 1])) {
      return refused(s, "call argument type");
    }
    ids = ids.append(v.id);
    i = i + 1;
  }
  if (ssasem.find_contract_in(s.calls, key) < 0) {
    s = State { ...s, calls: s.calls.append(contract) };
  }
  return define(s, ssasem.call(), ids, 0, key, contract.result);
}

// `d.m(args)` on a dyn receiver dispatches on the shape of the box it holds to
// one of the implementations `dyn_arms` names. Their shared signature is the
// call's contract, with the dyn type at the receiver: they must agree on every
// other operand and the result, and lend every operand, because the dispatch
// hands each one the same slots. Each operand is copied into a run of
// consecutive values, which is where `ssarc.dyn_site` reads them from.
function dyn_method(c: ast.ExprCall, fa: ast.ExprFieldAccess, recv: Value, s: State, statement: boolean): Value {
  let receiver: typeinfo.Type = s.values[recv.id];
  let traits: string[] = parser.dyn_trait_set(typeinfo.spelling(receiver));
  let arms: string[] = dyn_arms(s.funcs, s.impls, fa.field, traits);
  if (arms.len() == 0 && !any_implementer(s.impls, traits)) {
    // No type implements the trait, so no value of the receiver's type
    // exists and the call cannot execute; native emits the dispatch over
    // an empty vtable. An implementer with no arm for the name is an
    // associated function reached through dyn, which the checker refuses.
    let ty: typeinfo.Type = checked(c, s);
    if (statement) {
      ty = t_void();
    }
    return unreachable_value(terminate(s, t_unreachable()), ty);
  }
  if (arms.len() == 0) {
    return refused(s, "dyn method has no implementation: " + fa.field);
  }
  let shape: ssasem.Contract = ssasem.Contract { name: "", params: [], modes: [], result: t_void() };
  for arm in arms {
    let at: i32 = ssasem.find_contract(s.contracts, arm);
    if (at < 0) {
      return refused(s, "dyn method implementation has no semantic contract: " + arm);
    }
    let why: string = dyn_arm_error(s.contracts.list[at], shape);
    if (why != "") {
      return refused(s, why + ": " + arm);
    }
    if (shape.name == "") {
      shape = s.contracts.list[at];
    }
  }
  if (c.args.len() + 1 != shape.params.len()) {
    return refused(s, "call arity");
  }
  if (is_void(shape.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  let params: typeinfo.Type[] = [receiver];
  let modes: i32[] = [ssaunits.borrow_mode()];
  let i: i32 = 1;
  while (i < shape.params.len()) {
    params = params.append(shape.params[i]);
    modes = modes.append(shape.modes[i]);
    i = i + 1;
  }
  let contract: ssasem.Contract = ssasem.Contract { name: ssasem.dyn_call_name(fa.field, traits, arms), params: params, modes: modes, result: shape.result };
  let ids: i32[] = [recv.id];
  i = 0;
  while (i < c.args.len()) {
    let v: Value = lend(expr(c.args[i], s, params[i + 1]), params[i + 1], modes[i + 1], true);
    s = v.s;
    if (!s.ok) {
      return v;
    }
    if (!semtypes.equal(s.values[v.id], params[i + 1])) {
      return refused(s, "call argument type");
    }
    ids = ids.append(v.id);
    i = i + 1;
  }
  let run: i32[] = [];
  for id in ids {
    let cp: Value = define(s, 7, [id], 0, "", s.values[id]);
    s = cp.s;
    run = run.append(cp.id);
  }
  if (ssasem.find_contract_in(s.calls, contract.name) < 0) {
    s = State { ...s, calls: s.calls.append(contract) };
  }
  return define(s, ssasem.call(), run, 0, contract.name, contract.result);
}

// Why an implementation cannot share a dyn call's contract with `first`, the
// one before it ("" names none yet). The receiver is compared by mode alone,
// since each implementation names its own type there.
function dyn_arm_error(c: ssasem.Contract, first: ssasem.Contract): string {
  if (ssasem.contract_variables(c).len() > 0) {
    return "dyn method implementation is generic";
  }
  if (c.params.len() == 0) {
    return "dyn method implementation takes no receiver";
  }
  for m in c.modes {
    if (m == ssaunits.counted_mode()) {
      return "dyn method implementation consumes an operand";
    }
  }
  if (first.name == "") {
    return "";
  }
  if (c.params.len() != first.params.len() || !semtypes.equal(c.result, first.result)) {
    return "dyn method implementations disagree";
  }
  let i: i32 = 1;
  while (i < c.params.len()) {
    if (!semtypes.equal(c.params[i], first.params[i]) || c.modes[i] != first.modes[i]) {
      return "dyn method implementations disagree";
    }
    i = i + 1;
  }
  return "";
}

// `cell_new(v)` builds the shared one-element box over v's unit. The checker
// types the call as a bare `Cell`, so the element is the argument's type,
// produced at the width the destination names; a view cannot be held, as an
// array cannot hold one.
function cell_construction(c: ast.ExprCall, s: State, expected: typeinfo.Type): Value {
  let v: Value = expr(c.args[0], s, semtypes.cell_elem(expected));
  s = v.s;
  if (!s.ok) {
    return v;
  }
  let elem: typeinfo.Type = s.values[v.id];
  if (!semtypes.concrete(elem, false)) {
    return refused(s, "unresolved cell element type");
  }
  if (ssasem.is_view(elem)) {
    return refused(s, "view element escapes its source");
  }
  return define(s, ssasem.cell_new(), [v.id], 0, "", typeinfo.TypeStruct { name: "Cell", args: [elem] });
}

// `map_new(cap)` builds an empty hash map sized for `cap` entries. The map
// carries no element the call names, so the shape is the destination's — the
// only place it is written — and a call with none is refused rather than
// guessed at.
// A map names no element in its construction, so its shape is the
// destination's; a construction with none, the head of a literal's
// `map_new(n).insert(k, v)` chain, takes the checker's.
function map_construction(e: ast.Expr, c: ast.ExprCall, s: State, expected: typeinfo.Type): Value {
  if (!ssasem.is_map(expected)) {
    expected = checked(e, s);
  }
  if (!ssasem.is_supported_map(expected)) {
    if (!ssasem.is_map(expected)) {
      return refused(s, "unsupported map shape: no destination names one");
    }
    if (typeinfo.spelling(expected).len() == 0) {
      return refused(s, "unsupported map shape: columns unresolved");
    }
    return refused(s, "unsupported map shape: " + typeinfo.spelling(expected));
  }
  let cap: Value = expr(c.args[0], s, t_i32());
  s = cap.s;
  if (!s.ok) {
    return cap;
  }
  if (!is_i32(s.values[cap.id])) {
    return refused(s, "map capacity type");
  }
  return define(s, ssasem.map_new(), [cap.id], 0, "", expected);
}

// `slice_unchecked(s, start, end)` reads a window of a string's bytes. The box
// it hands back is this function's to release; the bytes stay the source's, so
// the result is anchored to it and the source must outlive the view. It is a
// view, as the checker types it, whether the source is owned or a view itself.
function string_slice(c: ast.ExprCall, s: State): Value {
  let p: SliceParts = slice_parts(c, s);
  if (!p.hi.s.ok) {
    return p.hi;
  }
  return define(p.hi.s, ssasem.slice(), [p.src, p.lo, p.hi.id], 0, "", t_str());
}

// SliceParts is a `slice_unchecked` call's source and bounds, produced in
// order; `hi` carries the state, or the refusal.
struct SliceParts { src: i32, lo: i32, hi: Value }

function slice_parts(c: ast.ExprCall, s: State): SliceParts {
  let src: Value = expr(c.args[0], s, typeinfo.unchecked());
  s = src.s;
  if (!s.ok) {
    return SliceParts { src: 0 - 1, lo: 0 - 1, hi: src };
  }
  if (!ssasem.is_text(s.values[src.id])) {
    return SliceParts { src: 0 - 1, lo: 0 - 1, hi: refused(s, "unsupported call target") };
  }
  let lo: Value = expr(c.args[1], s, t_i32());
  s = lo.s;
  if (!s.ok) {
    return SliceParts { src: 0 - 1, lo: 0 - 1, hi: lo };
  }
  let hi: Value = expr(c.args[2], s, t_i32());
  s = hi.s;
  if (!s.ok) {
    return SliceParts { src: 0 - 1, lo: 0 - 1, hi: hi };
  }
  if (!is_i32(s.values[lo.id]) || !is_i32(s.values[hi.id])) {
    return SliceParts { src: 0 - 1, lo: 0 - 1, hi: refused(s, "slice bound type") };
  }
  return SliceParts { src: src.id, lo: lo.id, hi: hi };
}

// `acc + slice_unchecked(s, lo, hi)` on a counted string appends the range
// without building the window (ssasem.append_range).
function range_append(left: Value, c: ast.ExprCall, s: State): Value {
  let p: SliceParts = slice_parts(c, s);
  if (!p.hi.s.ok) {
    return p.hi;
  }
  return define(p.hi.s, ssasem.append_range(), [left.id, p.src, p.lo, p.hi.id], 0, "", t_string());
}

// The builtin `slice_unchecked` call `e` is, unless a local of that name
// shadows it.
function builtin_slice(e: ast.Expr, s: State): Option[ast.ExprCall] {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      if (lookup(s, id.name) < 0 && is_slice_call(id.name, c)) {
        return Some(c);
      }
    }
  }
  return None;
}

// A view where a BORROWED `string` parameter is declared: the callee reads
// the box and hands it back, so the view's bytes are lent the way any
// borrowed argument's are (the checker's view_arg_borrow). A counted parameter
// would take the box as its own, which a view's box is not, so the retag is
// not offered there and the exact-type rule refuses the call.
//
// A callee that may KEEP what it is lent (`kept`: `handers` holds its name) is
// handed an owned copy of the bytes instead. A view's box carries the immortal
// rc sentinel, so the retain such a callee owes for a reference it keeps is a
// no-op, and the bytes belong to the view's source, which the frame that
// sliced it may release before the reference is read (#9328, #9407). The
// copy is a unit of this frame's own, released like any other; what the
// callee keeps is its own counted reference to it.
function lend(v: Value, param: typeinfo.Type, m: i32, kept: boolean): Value {
  let s: State = v.s;
  if (!s.ok || m != ssaunits.borrow_mode()) {
    return v;
  }
  if (!ssasem.is_view(s.values[v.id]) || !ssasem.is_string(param)) {
    return v;
  }
  if (!kept) {
    return define(s, ssasem.str_as(), [v.id], 0, "", param);
  }
  let empty: Value = define(s, 5, [], 0, "", param);
  return define(empty.s, 9, [v.id, empty.id], 0, "+", param);
}

// Whether the declaration a call names may hand one of its arguments out —
// as its result, or stored inside one — which no contract records: a callee
// returning a fresh string (the fixture's `copied()`) is clean, and refusing
// on the signature took it out of production. `handers` is that property,
// read off the bodies once per module.
function keeps(s: State, callee: string): boolean {
  return s.handers.has(callee);
}

// A call of a bound name whose value is a function: the callee is the closure
// box that name holds and its TYPE is the whole contract, since no declaration
// is in hand. Every reference argument is lent except at a slot the type
// spells `own`, which the callee consumes. The result is a unit of this
// function's own, the way a direct call's is, and the box itself is lent: it
// is the environment the body reads its captures out of. No body is in hand
// to ask whether it keeps a lent view, so every view is handed as a copy.
function indirect_call(c: ast.ExprCall, callee: i32, s: State, statement: boolean): Value {
  let params: typeinfo.Type[] = ssasem.func_params(s.values[callee]);
  let result: typeinfo.Type = ssasem.func_result(s.values[callee]);
  if (c.args.len() != params.len()) {
    return refused(s, "call arity");
  }
  if (is_void(result) && !statement) {
    return refused(s, "unsupported void call");
  }
  let ids: i32[] = [callee];
  let i: i32 = 0;
  while (i < c.args.len()) {
    let v: Value = lend(expr(c.args[i], s, params[i]), params[i], ssaunits.borrow_mode(), true);
    s = v.s;
    if (!s.ok) {
      return v;
    }
    if (!semtypes.equal(s.values[v.id], params[i])) {
      return refused(s, "call argument type");
    }
    ids = ids.append(v.id);
    i = i + 1;
  }
  return define(s, ssasem.call_value(), ids, 0, "", result);
}

// A name bound in this body holds a VALUE, not a declaration: a function value
// is called through the address it holds, and nothing else is a callee.
function bound_call(c: ast.ExprCall, bound: i32, s: State, statement: boolean): Value {
  if (ssasem.is_func(s.values[bound])) {
    return indirect_call(c, bound, s, statement);
  }
  return refused(s, "unsupported call target");
}

// ---- value blocks -----------------------------------------------------------

// A value-position `{ … }` block is a zero-argument call of a zero-parameter
// lambda the parser marks with an origin, and every backend INLINES it rather
// than calling one: the statements run in the enclosing function and only the
// last is the block's value. The shape the parser
// desugars an if-EXPRESSION to is one `if` whose arms each `return` that value,
// so it is produced here as a branch whose arms join at a phi rather than at a
// terminator. The match-expression desugars that route their value through a
// LOCAL declare it ahead of the done-flag chain and return it after: the
// leading statements run in the enclosing block, in a scope of their own, and
// the trailing return's value is the block's. A block whose last statement is
// none of these — a comprehension's tail, a bare expression — is refused.
function value_block(e: ast.Expr, c: ast.ExprCall, s: State, expected: typeinfo.Type): Value {
  let ty: typeinfo.Type = block_type(e, c, s, expected);
  let body: ast.Stmt[] = parser.vb_body(c);
  if (body.len() == 0) {
    return refused(s, "unsupported value block: no statements");
  }
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "unsupported value block: type " + typeinfo.spelling(ty));
  }
  let count: i32 = s.names.len();
  let scope: checker.Scope = s.scope;
  let i: i32 = 0;
  while (i < body.len() - 1) {
    s = stmt(body[i], s);
    i = i + 1;
  }
  if (!s.ok) {
    return Value { s: s, id: 0 - 1 };
  }
  if (!s.live) {
    let z: Value = unreachable_value(s, ty);
    return Value { s: leave(z.s, count, scope), id: z.id };
  }
  let last: ast.Stmt = body[body.len() - 1];
  let v: Value = refused(s, "unsupported value block: " + block_stmt_kind(last));
  if let ast.StmtIf(f) = last {
    v = value_if(f, s, ty);
  }
  if let ast.StmtMatch(m) = last {
    v = value_match(m, s, ty);
  }
  if let ast.StmtReturn(_) = last {
    v = arm_value(last, s, ty);
  }
  if (!v.s.ok) {
    return v;
  }
  return Value { s: leave(v.s, count, scope), id: v.id };
}

// The value of a value block no path leaves by its end: the enclosing
// expression goes on in a block nothing branches to, which `complete` prunes.
function unreachable_value(s: State, ty: typeinfo.Type): Value {
  let dead: i32 = s.next_block;
  s = open(State { ...s, next_block: dead + 1 }, dead, []);
  return define(s, ssasem.zero(), [], 0, "", ty);
}

// A value block's type: what its destination expects, where the destination
// names one; else the checker's; else the return type the desugar stamped on
// the block's lambda from the arms (parser.if_expr_rt), which the checker
// declines to type the block from ("typed from its branches, not its
// value"). The destination outranks the checker because the stamp is a
// syntactic guess the checker reads back — `i32` for an arm that is an empty
// array literal — and the binding's own annotation is what the arms are
// checked against. A stamp the arms contradict is caught where the arm's
// value is checked against it.
function block_type(e: ast.Expr, c: ast.ExprCall, s: State, expected: typeinfo.Type): typeinfo.Type {
  if (semtypes.concrete(expected, false)) {
    return expected;
  }
  let ty: typeinfo.Type = checked(e, s);
  if (semtypes.concrete(ty, false)) {
    return ty;
  }
  if let ast.ExprLambda(lam) = c.callee {
    if (lam.ret_type.len() > 0) {
      return resolved(s.scope.resolve_type(lam.ret_type), s.template, s.binding, s.scope);
    }
  }
  return ty;
}

// The statement kind a value block ended on, for the refusal.
function block_stmt_kind(st: ast.Stmt): string {
  match (st) {
    ast.StmtReturn(_) => {
      return "return";
    },
    ast.StmtMatch(_) => {
      return "match";
    },
    ast.StmtVar(_) => {
      return "let";
    },
    ast.StmtExpr(_) => {
      return "expression";
    },
    ast.StmtWhile(_) => {
      return "while";
    },
    ast.StmtFor(_) => {
      return "for";
    },
    _ => {
      return "other";
    }
  }
}

struct VArm { s: State, live: boolean, end: i32, env: i32[], value: i32 }

// The statement that carries an arm's value: its own `return`, or the nested
// if-expression an `else if` chain leaves there.
function arm_value(st: ast.Stmt, s: State, ty: typeinfo.Type): Value {
  if let ast.StmtIf(f) = st {
    return value_if(f, s, ty);
  }
  if let ast.StmtReturn(r) = st {
    if (parser.bare_return(r.value)) {
      return refused(s, "value block arm has no value");
    }
    let v: Value = expr(r.value, s, ty);
    if (!v.s.ok) {
      return v;
    }
    if (!semtypes.equal(v.s.values[v.id], ty)) {
      return refused(v.s, "value block arm type");
    }
    return unaliased_view(v);
  }
  return refused(s, "value block arm has no value");
}

// One arm of an if-expression. Its leading statements run in the arm's own
// block, where a `return` of the ENCLOSING function is what the inlined form
// means it to be; the last statement is the arm's value. An arm the leading
// statements leave with no live edge contributes no edge to the join; its last
// statement is parse_branch_body's unreachable filler and is not produced.
function value_arm(body: ast.Stmt[], s: State, entry: i32[], id: i32, preds: i32[], join: i32, count: i32, scope: checker.Scope, ty: typeinfo.Type): VArm {
  s = open(State { ...s, vals: entry }, id, preds);
  let none: VArm = VArm { s: s, live: false, end: 0, env: [], value: 0 - 1 };
  if (body.len() == 0) {
    return VArm { ...none, s: fail(s, "value block arm has no value") };
  }
  let i: i32 = 0;
  while (i < body.len() - 1) {
    s = stmt(body[i], s);
    i = i + 1;
  }
  if (!s.ok) {
    return VArm { ...none, s: s };
  }
  if (!s.live) {
    return VArm { ...none, s: leave(s, count, scope) };
  }
  let v: Value = arm_value(body[body.len() - 1], s, ty);
  s = v.s;
  if (!s.ok) {
    return VArm { ...none, s: s };
  }
  let end: i32 = s.cur.id;
  let env: i32[] = prefix(s.vals, count);
  s = terminate(s, t_br(join));
  return VArm { s: leave(s, count, scope), live: true, end: end, env: env, value: v.id };
}

// The if-expression itself: the two arms are produced the way a branch's are —
// each from the environment at the test, never from its sibling's — and the
// join merges the bindings and then the value. The value phi is a unit of this
// function's own, supplied on each incoming edge, exactly as a binding's phi is.
function value_if(f: ast.StmtIf, s: State, ty: typeinfo.Type): Value {
  let then_id: i32 = s.next_block;
  let else_id: i32 = then_id + 1;
  let join: i32 = then_id + 2;
  s = State { ...s, next_block: join + 1 };
  let count: i32 = s.names.len();
  let entry: i32[] = s.vals;
  let scope: checker.Scope = s.scope;
  let c: Cond = cond(f.cond, s, then_id, else_id);
  s = c.s;
  if (!s.ok) {
    return Value { s: s, id: 0 - 1 };
  }
  let t: VArm = value_arm(f.then_body, s, entry, then_id, c.yes, join, count, scope, ty);
  if (!t.s.ok) {
    return Value { s: t.s, id: 0 - 1 };
  }
  let el: VArm = value_arm(f.else_body, t.s, entry, else_id, c.no, join, count, scope, ty);
  if (!el.s.ok) {
    return Value { s: el.s, id: 0 - 1 };
  }
  let preds: i32[] = [];
  let envs: i32[][] = [];
  let values: i32[] = [];
  if (t.live) {
    preds = preds.append(t.end);
    envs = envs.append(t.env);
    values = values.append(t.value);
  }
  if (el.live) {
    preds = preds.append(el.end);
    envs = envs.append(el.env);
    values = values.append(el.value);
  }
  if (preds.len() == 0) {
    return unreachable_value(el.s, ty);
  }
  s = merge_env(open(el.s, join, preds), envs, count);
  return define(s, 8, values, 0, "", ty);
}

function is_slice_call(name: string, c: ast.ExprCall): boolean {
  return name == "slice_unchecked" && c.args.len() == 3 && c.type_args.len() == 0;
}

// A closure VALUE: the environment box the lift builds, holding the hoisted
// body's address and the captures that body reads back out of it. The body is
// a declaration like any other, so the box hands out its contract minus the
// environment parameter, and it joins the call table — a refused body refuses
// its constructor the way a refused callee refuses its caller.
//
// The box is a fresh unit of this function's own, and it owns one unit of
// every capture that is a reference: the body's environment record names
// them (`semtypes.is_env`), so the constructor supplies them like a record's
// fields and the box's release walks them by that record's own drop helper,
// matched at run time against the address in slot 0 since a function type
// names no capture.
//
// A counted PARAMETER is a consuming slot, and the type the box hands out
// spells it (`ssasem.closure_type`), so a call through the box and the body's
// own declaration agree on who releases the argument. The ENVIRONMENT
// parameter is the box itself, lent like any receiver and absent from the type
// the box hands out, so a counted one there is a promise nothing can state.
function closure(body: string, c: ast.ExprCall, s: State): Value {
  let at: i32 = ssasem.find_contract(s.contracts, body);
  if (at < 0) {
    return refused(s, "call target has no semantic contract: " + body);
  }
  let contract: ssasem.Contract = s.contracts.list[at];
  if (!ssasem.closure_env(contract)) {
    return refused(s, "closure environment parameter");
  }
  if (contract.modes.len() > 0 && contract.modes[0] == ssaunits.counted_mode()) {
    return refused(s, "function value consumes its environment");
  }
  // A body hoisted out of a template copies its type-variable spellings, so
  // it is an instance under the binding this body is produced under.
  let vars: string[] = ssasem.contract_variables(contract);
  if (vars.len() > 0) {
    if (!ssasem.binds_all(s.binding, vars)) {
      return refused(s, "unbound type variable");
    }
    contract = ssasem.instantiate_contract(contract, s.binding, vars);
    s = request(s, body, contract.name, s.binding);
  }
  let caps: Captured = captures(c, s, ssasem.closure_captures(contract));
  s = caps.s;
  if (!s.ok) {
    return Value { s: s, id: 0 - 1 };
  }
  if (ssasem.find_contract_in(s.calls, contract.name) < 0) {
    s = State { ...s, calls: s.calls.append(contract) };
  }
  return define(s, ssasem.closure_new(), caps.ids, 0, contract.name, ssasem.closure_type(contract));
}

struct Captured { s: State, ids: i32[] }

// Each capture is produced at the type the body's environment declares for
// its slot; the box takes one unit of every reference among them, function
// values included — a box that borrowed one could not describe an escape
// (#9637).
function captures(c: ast.ExprCall, s: State, types: typeinfo.Type[]): Captured {
  if (c.args.len() != types.len()) {
    return Captured { s: fail(s, "closure capture count"), ids: [] };
  }
  let ids: i32[] = [];
  let i: i32 = 0;
  while (i < c.args.len()) {
    let v: Value = expr(c.args[i], s, types[i]);
    s = v.s;
    if (!s.ok) {
      return Captured { s: s, ids: [] };
    }
    if (!semtypes.equal(s.values[v.id], types[i])) {
      return Captured { s: fail(s, "closure capture type"), ids: [] };
    }
    ids = ids.append(v.id);
    i = i + 1;
  }
  return Captured { s: s, ids: ids };
}

// A name with no contract may still be a variant constructor of the enum the
// call is written against.
function variant_call(e: ast.Expr, name: string, c: ast.ExprCall, s: State, expected: typeinfo.Type): Value {
  let whole: typeinfo.Type = settled_union(settled(literal_union(e, s, expected)), name, c.args, s);
  if (names_variant(s, whole, name)) {
    return variant(name, whole, c.args, s);
  }
  if (c.args.len() == 1 && names_member(s, whole, name)) {
    return member_literal(name, whole, c.args[0], s);
  }
  return refused(s, "call target has no semantic contract: " + name);
}

// A name is a member literal when the union of structs it is written against
// (`type Expr = Add | Mul`) has a member of that name.
function names_member(s: State, whole: typeinfo.Type, name: string): boolean {
  let owner: string = union_name(whole);
  if (owner == "" || union_layout(s, owner) != semrecords.layout_member()) {
    return false;
  }
  return checker.variant_shape_sig(s.scope, name, owner).name.len() > 0;
}

// `Add(a)` builds the member from the struct value it is given, as an
// implicit wrap of `a` does.
function member_literal(name: string, whole: typeinfo.Type, written: ast.Expr, s: State): Value {
  let v: Value = expr(written, s, checked(written, s));
  if (!v.s.ok) {
    return v;
  }
  if (struct_name(v.s.values[v.id]) != name) {
    return refused(v.s, "union member literal: " + name + " takes " + name + ", not " + typeinfo.spelling(v.s.values[v.id]));
  }
  return define(v.s, ssasem.variant_up(), [v.id], 0, name, whole);
}

// A destination that names a builtin union but settles nothing in it is no
// more use than none at all: `and[U](other: Result[U, E])` binds U from this
// very argument, so `Result[U, string]` names Ok without saying what Ok holds,
// and the payload is the only thing that can say. Each payload's checked type
// binds the variable its field spells. A `Some` with no destination at all —
// a match scrutinee, a binding with no annotation — is the Option of its
// payload's own type, as the checker infers it for the binding.
function settled_union(whole: typeinfo.Type, name: string, args: ast.Expr[], s: State): typeinfo.Type {
  if (names_variant(s, whole, name) && semtypes.concrete(whole, false)) {
    return whole;
  }
  let pattern: typeinfo.Type = whole;
  if (name == "Some" && !names_variant(s, whole, name)) {
    pattern = typeinfo.TypeUnion { name: "Option", args: [typeinfo.TypeErased { name: "$payload" }] };
  }
  let shape: Payloads = builtin_payloads(pattern, name);
  if (!shape.found || shape.types.len() != args.len()) {
    return whole;
  }
  let b: ssasem.Binding = ssasem.unbound();
  let i: i32 = 0;
  while (i < args.len()) {
    let t: typeinfo.Type = checked(args[i], s);
    if (semtypes.concrete(t, false)) {
      b = ssasem.bind_type(b, shape.types[i], t);
    }
    i = i + 1;
  }
  if (!b.ok) {
    return whole;
  }
  return ssasem.substitute(pattern, b);
}

function direct_call(c: ast.ExprCall, contract: ssasem.Contract, s: State, statement: boolean, expected: typeinfo.Type): Value {
  if (c.args.len() != contract.params.len()) {
    return refused(s, "call arity");
  }
  if (is_void(contract.result) && !statement) {
    return refused(s, "unsupported void call");
  }
  return invoke(c.args, contract, s, written_binding(c, contract, s), destination_binding(contract, expected));
}

// What a written instantiation (`pick[i32]()`) binds: each type argument binds
// the declaration's type parameter at its position. It is the only source for
// a variable no argument spells. A method carries its receiver's parameters
// ahead of its own and may name only its own, so a shorter list binds the
// trailing parameters.
function written_binding(c: ast.ExprCall, contract: ssasem.Contract, s: State): ssasem.Binding {
  let b: ssasem.Binding = ssasem.unbound();
  let tps: string[] = checker.func_type_params(s.scope, contract.name);
  let skip: i32 = tps.len() - c.type_args.len();
  if (c.type_args.len() == 0 || skip < 0) {
    return b;
  }
  let i: i32 = 0;
  while (i < c.type_args.len()) {
    if (c.type_args[i].len() > 0) {
      let t: typeinfo.Type = settled(resolved(checker.spelled_type(s.scope, c.type_args[i]), s.template, s.binding, s.scope));
      if (semtypes.concrete(t, false)) {
        b = ssasem.bind_type(b, typeinfo.TypeErased { name: tps[skip + i] }, t);
      }
    }
    i = i + 1;
  }
  return b;
}

// What the call's destination says a template's variables are: `let m:
// Map[i32, i32] = id(Map {})` names T through the result, and the literal
// argument has no type of its own to bind it from. The arguments still bind
// every variable left to right; this only types an argument whose parameter
// would otherwise be produced at a bare variable, so an argument that names
// its own type is unaffected and a destination the result cannot fit binds
// nothing.
function destination_binding(contract: ssasem.Contract, expected: typeinfo.Type): ssasem.Binding {
  if (!semtypes.concrete(expected, false)) {
    return ssasem.unbound();
  }
  let b: ssasem.Binding = ssasem.bind_type(ssasem.unbound(), contract.result, expected);
  if (!b.ok) {
    return ssasem.unbound();
  }
  return b;
}

// A call in statement position may return nothing: its value is void and
// no name binds it. In expression position a void result is refused, since
// the checker types nothing by it.
function call(e: ast.Expr, c: ast.ExprCall, s: State, statement: boolean, expected: typeinfo.Type): Value {
  if (parser.is_value_block(c)) {
    return value_block(e, c, s, expected);
  }
  if let ast.ExprFieldAccess(mfa) = c.callee {
    let head: string = type_head(mfa.obj, s);
    if (head.len() > 0) {
      return qualified_call(e, head, mfa.field, c, s, statement, expected);
    }
    return method_call(c, mfa, s, statement, expected);
  }
  let name: string = "";
  if let ast.ExprIdent(id) = c.callee {
    name = id.name;
  }
  let bound: i32 = lookup(s, name);
  if (bound >= 0) {
    return bound_call(c, bound, s, statement);
  }
  if (name == "") {
    // A callee that is neither a bare name nor a field is still callable
    // when it EVALUATES to a function value -- an element read out of an
    // array of them. indirect_call dispatches through a value id rather
    // than a name, so producing the callee is the whole of it.
    let cty: typeinfo.Type = checked(c.callee, s);
    if (ssasem.is_func(cty)) {
      let cv: Value = expr(c.callee, s, typeinfo.unchecked());
      if (!cv.s.ok) {
        return cv;
      }
      return indirect_call(c, cv.id, cv.s, statement);
    }
    return refused(s, "unsupported call target: callee is neither a name nor a field");
  }
  return free_call(e, name, c, s, statement, expected);
}

// The head of a path that names a TYPE rather than a value: `E.A(7)` and
// `E.B` name a variant of the enum, `Point.make(3, 4)` the associated function
// an impl declared on the struct, which the contract table keys the way it
// keys a method. A bound name shadows the type.
function type_head(obj: ast.Expr, s: State): string {
  if let ast.ExprIdent(id) = obj {
    if (lookup(s, id.name) >= 0) {
      return "";
    }
    // A VARIANT names a value, not a type. `Shape.Circle(1)` is a
    // qualified path and `Empty.to_string()` is a method call on the
    // payloadless literal; they are the same shape in the tree. A name a
    // plain struct and a variant share is the variant's value here, as
    // native reads a receiver (#9968).
    if (checker.variant_owner_of(s.scope, id.name).len() > 0) {
      return "";
    }
    let sig: checker.StructSig = checker.struct_sig(s.scope, id.name);
    if (sig.name.len() > 0) {
      if (sig.enum_owner.len() > 0) {
        return "";
      }
      return id.name;
    }
    if (union_variants(s, id.name).len() > 0 || builtin_union_layout(id.name) != 0) {
      return id.name;
    }
    // A primitive's impl may declare an associated function
    // (`i32.from_json_value(v)`); the name is never a value.
    if (typeinfo.is_primitive_type_name(id.name)) {
      return id.name;
    }
  }
  return "";
}

function qualified_variant(e: ast.Expr, head: string, name: string, args: ast.Expr[], s: State, expected: typeinfo.Type): Value {
  let whole: typeinfo.Type = literal_union(e, s, expected);
  if (union_name(whole) != head || !names_variant(s, whole, name)) {
    return refused(s, "unsupported qualified path: " + head + "." + name);
  }
  return variant(name, whole, args, s);
}

function qualified_call(e: ast.Expr, head: string, name: string, c: ast.ExprCall, s: State, statement: boolean, expected: typeinfo.Type): Value {
  let whole: typeinfo.Type = literal_union(e, s, expected);
  if (union_name(whole) == head && names_variant(s, whole, name)) {
    return variant(name, whole, c.args, s);
  }
  let at: i32 = ssasem.find_contract(s.contracts, head + "." + name);
  if (at < 0) {
    return refused(s, "call target has no semantic contract: " + head + "." + name);
  }
  return direct_call(c, s.contracts.list[at], s, statement, expected);
}

// A call of a free name: a builtin with a shape of its own, the lambda
// lift's closure constructor, a declaration with a contract, or a variant.
function free_call(e: ast.Expr, name: string, c: ast.ExprCall, s: State, statement: boolean, expected: typeinfo.Type): Value {
  if (is_slice_call(name, c)) {
    return string_slice(c, s);
  }
  if (name == "cell_new" && c.args.len() == 1) {
    return cell_construction(c, s, expected);
  }
  if ((name == "map_new" || name == "__map_new_i32") && c.args.len() == 1) {
    return map_construction(e, c, s, expected);
  }
  // The lambda lift's closure constructor names no declaration of its own:
  // it is the marker left where a capturing inline lambda — or a bare
  // function name at a function-typed argument — was written, carrying the
  // body the lift hoisted.
  let body: string = parser.mkclo_body(name);
  if (body.len() > 0) {
    return closure(body, c, s);
  }
  let at: i32 = ssasem.find_contract(s.contracts, name);
  if (at < 0) {
    return variant_call(e, name, c, s, expected);
  }
  return direct_call(c, s.contracts.list[at], s, statement, expected);
}

// Each argument is produced at the parameter's type and lent by the
// parameter's mode; the callee's contract joins the function's call table
// the first time it is called.
//
// A contract carrying a type VARIABLE is a template, and this call site is
// what instantiates it: each argument binds the variables its parameter
// spells, left to right, so a later parameter — a function value's own
// variable slots among them — is produced and compared at the type already
// bound. A written instantiation binds before any argument does. The instance
// is a body of its own, named by the types bound and produced on this call's
// request, and the call names it rather than the template.
function invoke(args: ast.Expr[], contract: ssasem.Contract, s: State, written: ssasem.Binding, seed: ssasem.Binding): Value {
  if (!written.ok) {
    return refused(s, written.why);
  }
  return invoke_rest([], written, args, 0, contract, s, seed);
}

// A method on a GENERIC RECEIVER is the free generic the registration pass
// folded it into — `(xs: T[]) first()` is `__arrm_first[T](xs)` — so the call
// is that free call with the receiver at argument 0. The receiver is already
// produced here, and producing it a second time would give the call two values
// for one expression, so it is bound and lent from the value in hand and the
// written arguments follow it.
function invoke_method(recv: Value, args: ast.Expr[], contract: ssasem.Contract, s: State, written: ssasem.Binding, seed: ssasem.Binding): Value {
  if (!written.ok) {
    return refused(s, written.why);
  }
  let v: Value = lend(recv, contract.params[0], contract.modes[0], keeps(s, contract.name));
  s = v.s;
  if (!s.ok) {
    return v;
  }
  let bound: ssasem.Binding = ssasem.bind_type(written, contract.params[0], s.values[v.id]);
  if (!bound.ok) {
    return refused(s, bound.why);
  }
  v = widen(v, ssasem.substitute(contract.params[0], bound));
  s = v.s;
  if (!semtypes.equal(ssasem.substitute(contract.params[0], bound), s.values[v.id])) {
    return refused(s, "call receiver type");
  }
  return invoke_rest([v.id], bound, args, 1, contract, s, seed);
}

// The arguments from `base` onward, each produced at its parameter's type
// under the bindings the earlier ones made; a parameter they leave open takes
// what the destination (`seed`) or a later argument binds.
function invoke_rest(ids: i32[], bound: ssasem.Binding, args: ast.Expr[], base: i32, contract: ssasem.Contract, s: State, seed: ssasem.Binding): Value {
  let i: i32 = 0;
  while (i < args.len()) {
    let at: i32 = base + i;
    let want: typeinfo.Type = ssasem.substitute(contract.params[at], bound);
    if (!semtypes.concrete(want, false)) {
      want = ssasem.substitute(want, seed);
    }
    if (!semtypes.concrete(want, false)) {
      want = ssasem.substitute(want, later_binding(bound, args, i + 1, base, contract, s));
    }
    let v: Value = lend(expr(args[i], s, want), want, contract.modes[at], keeps(s, contract.name));
    s = v.s;
    if (!s.ok) {
      return v;
    }
    bound = ssasem.bind_type(bound, contract.params[at], s.values[v.id]);
    if (!bound.ok) {
      return refused(s, bound.why);
    }
    v = widen(v, ssasem.substitute(contract.params[at], bound));
    s = v.s;
    if (!semtypes.equal(ssasem.substitute(contract.params[at], bound), s.values[v.id])) {
      return refused(s, "call argument type");
    }
    ids = ids.append(v.id);
    i = i + 1;
  }
  let callee: ssasem.Contract = contract;
  let vars: string[] = ssasem.contract_variables(contract);
  if (vars.len() > 0) {
    if (!ssasem.binds_all(bound, vars)) {
      return refused(s, "unbound type variable");
    }
    callee = ssasem.instantiate_contract(contract, bound, vars);
    s = request(s, contract.name, callee.name, bound);
  }
  if (ssasem.find_contract_in(s.calls, callee.name) < 0) {
    s = State { ...s, calls: s.calls.append(callee) };
  }
  return define(s, ssasem.call(), ids, 0, callee.name, callee.result);
}

// What the arguments after `from` bind, over `b`: an empty literal ahead of
// the argument that fixes its element (`head2([], [7, 8])`) is produced at the
// type that argument binds. One that would contradict the binding adds
// nothing; the left-to-right pass still checks every argument.
function later_binding(b: ssasem.Binding, args: ast.Expr[], from: i32, base: i32, contract: ssasem.Contract, s: State): ssasem.Binding {
  let i: i32 = from;
  while (i < args.len()) {
    let t: typeinfo.Type = checked(args[i], s);
    if (semtypes.concrete(t, false)) {
      let next: ssasem.Binding = ssasem.bind_type(b, contract.params[base + i], t);
      if (next.ok) {
        b = next;
      }
    }
    i = i + 1;
  }
  return b;
}

// An instance a call or a closure constructor names is asked for once.
function request(s: State, key: string, name: string, b: ssasem.Binding): State {
  for r in s.requests {
    if (r.name == name) {
      return s;
    }
  }
  return State { ...s, requests: s.requests.append(Request { key: key, name: name, binding: b }) };
}

// A union-typed destination accepts any of its members, and a view-typed one
// accepts an owned string or array, whose box it borrows. Each widening is a verified
// operation, not an implicit reinterpretation: the value carries exactly the
// type the destination declared, and every obligation site keeps its
// exact-type rule.
function widen(v: Value, expected: typeinfo.Type): Value {
  let s: State = v.s;
  if (semtypes.equal(s.values[v.id], expected)) {
    return v;
  }
  // An Option with a void payload is only ever None, so it reads as the None
  // of any Option the destination names.
  if (is_none_only(s.values[v.id]) && union_name(expected) == "Option" && semtypes.concrete(expected, false)) {
    return define(s, ssasem.variant_new(), [], 0, "None", expected);
  }
  if (semtypes.lends_array(s.values[v.id], expected)) {
    return define(s, ssasem.array_lend(), [v.id], 0, "", expected);
  }
  if (ssasem.is_view(expected) && ssasem.is_string(s.values[v.id])) {
    return define(s, ssasem.str_as(), [v.id], 0, "", expected);
  }
  if (ssasem.lends_handle(s.values[v.id], expected)) {
    return define(s, ssasem.cast(), [v.id], 0, "", expected);
  }
  // An owned string[] lends to a str[] destination as one string lends to a
  // str: the same retag, over the array (`let gs: str[] = s.graphemes()`).
  if (ssasem.is_view(element_type(expected)) && ssasem.is_string_array(s.values[v.id])) {
    return define(s, ssasem.str_as(), [v.id], 0, "", expected);
  }
  if (ssasem.is_dyn(expected) && (struct_name(s.values[v.id]) != "" || union_name(s.values[v.id]) != "")) {
    return define(s, ssasem.dyn_up(), [v.id], 0, "", expected);
  }
  if (ssasem.is_dyn(expected) && ssasem.boxes_into_dyn(s.values[v.id])) {
    return define(s, ssasem.dyn_box(), [v.id], 0, typeinfo.spelling(s.values[v.id]), expected);
  }
  let owner: string = union_name(expected);
  let member: string = struct_name(s.values[v.id]);
  if (owner == "" || member == "") {
    return v;
  }
  let layout: i32 = union_layout(s, owner);
  if (layout == semrecords.layout_member()) {
    if (checker.variant_shape_sig(s.scope, member, owner).name.len() == 0) {
      return v;
    }
    return define(s, ssasem.variant_up(), [v.id], 0, member, expected);
  }
  // A struct named like an enum's variant whose one payload is that struct
  // is wrapped into the variant, the shape every union alias desugars to.
  // A generic enum's or struct's clone suffixes the name with the
  // instantiation key, so the names are matched up to that suffix.
  if (layout == semrecords.layout_variant()) {
    for vn in union_variants(s, owner) {
      if (clone_base(vn) != clone_base(member)) {
        continue;
      }
      let shape: Payloads = literal_payloads(s, expected, vn, layout);
      if (shape.found && shape.types.len() == 1 && semtypes.equal(shape.types[0], s.values[v.id])) {
        let payload: Value = kept_view(unaliased_view(v));
        return define(payload.s, ssasem.variant_new(), [payload.id], 0, vn, expected);
      }
    }
  }
  return v;
}

// The declared name a monomorphised clone was made from: `Pair__i32` is
// `Pair`'s, and a name with no key is its own.
function clone_base(name: string): string {
  let i: i32 = 1;
  while (i + 1 < name.len()) {
    if (name[i] == b'_' && name[i + 1] == b'_') {
      return slice_unchecked(name, 0, i) + "";
    }
    i = i + 1;
  }
  return name;
}

function expr(e: ast.Expr, s: State, expected: typeinfo.Type): Value {
  if (!s.ok) {
    return Value { s: s, id: 0 - 1 };
  }
  let v: Value = produce(e, s, expected);
  if (!v.s.ok) {
    return v;
  }
  return widen(v, expected);
}

// A zero is the one value this boundary makes without an operand: the frame
// holds it, and at a reference type it is the null word whose release is the
// guard every drop helper carries.
function zero_value(e: ast.Expr, s: State, expected: typeinfo.Type): Value {
  let ty: typeinfo.Type = expected;
  if (!semtypes.concrete(ty, false)) {
    ty = checked(e, s);
  }
  if (!semtypes.concrete(ty, false)) {
    return refused(s, "zero of an unresolved type");
  }
  return define(s, ssasem.zero(), [], 0, "", ty);
}

// A literal's box is `.rodata` under the immortal rc, which is what a view's
// box is too, so the destination's spelling is the only thing a `str` slot
// needs. Producing it as a `string` and letting `widen` retag it leaves the
// literal BORROWED, and a `str` binding that a slice later rebinds is a phi
// with a unit to hand on: the borrowed edge could only supply it by retaining
// a view, which `ssaunits.plan` refuses.
function string_literal(st: ast.ExprString, s: State, expected: typeinfo.Type): Value {
  if (ssasem.is_view(expected)) {
    return define(s, 5, [], 0, st.value, expected);
  }
  return define(s, 5, [], 0, st.value, t_string());
}

function produce(e: ast.Expr, s: State, expected: typeinfo.Type): Value {
  match (e) {
    ast.ExprNumber(n) => {
      return number(n, s, expected);
    },
    ast.ExprBool(b) => {
      return define(s, 2, [], boolean_value(b.value), "", t_bool());
    },
    ast.ExprString(st) => {
      return string_literal(st, s, expected);
    },
    ast.ExprIdent(id) => {
      return ident(e, id, s, expected);
    },
    ast.ExprStructLit(sl) => {
      return record(e, sl, s);
    },
    ast.ExprArray(a) => {
      return array(e, a, s, expected);
    },
    ast.ExprTuple(t) => {
      return tuple(e, t, s, expected);
    },
    ast.ExprIndex(ix) => {
      return index(ix, s);
    },
    ast.ExprSlice(sl) => {
      return slice_expr(e, sl, s);
    },
    ast.ExprFieldAccess(fa) => {
      return field(e, fa, s, expected);
    },
    ast.ExprBinary(b) => {
      return binary(e, b, s, expected);
    },
    ast.ExprUnary(u) => {
      return unary(e, u, s, expected);
    },
    ast.ExprCall(c) => {
      return call(e, c, s, false, expected);
    },
    ast.ExprZero(_) => {
      // The zero a lifted declaration starts at. Its type is the annotation
      // the desugar wrote it from, which the checker resolved, so the value
      // takes what the binding expects rather than the node's spelling.
      return zero_value(e, s, expected);
    },
    _ => {
      return refused(s, "unsupported expression");
    }
  }
}

// ---- statements -------------------------------------------------------------

function destructures(v: ast.StmtVar): boolean {
  let i: i32 = 0;
  while (i < v.name.len()) {
    if (v.name[i] == b',') {
      return true;
    }
    i = i + 1;
  }
  return parser.is_destr_marker(v.type_name);
}

// A destructure binds each name in its pattern to a projection of the one
// initializer value, which stays live under those borrows as any container
// does: a tuple position is a `tuple_get`, a struct field a `record_get`, a
// nested tuple position is projected and destructured again, and the `@`
// binder names the whole value. The checker's post-declaration scope types
// each binding, and it must be the projection's type exactly; a discard is a
// binding no read follows.
function declare_tuple(st: ast.Stmt, v: ast.StmtVar, s: State): State {
  let marker: parser.DestrMarker = parser.destr_marker_split(v.type_name);
  let ty: typeinfo.Type = checked(v.init, s);
  let after: checker.Scope = checker.bind_stmt(st, s.scope);
  let whole: Value = expr(v.init, s, ty);
  s = whole.s;
  if (!s.ok) {
    return s;
  }
  if (!semtypes.equal(s.values[whole.id], ty)) {
    return fail(s, mismatch(v.name, ty, s.values[whole.id]));
  }
  if (marker.at.len() > 0) {
    s = bind_projection(s, marker.at, whole.id, after);
  }
  if (marker.tag.len() > 0) {
    s = destructure_record(v.name, marker.tag, whole.id, s, after);
  } else {
    s = destructure_tuple(v.name, whole.id, s, after);
  }
  if (!s.ok) {
    return s;
  }
  return State { ...s, scope: after };
}

function bind_projection(s: State, name: string, id: i32, after: checker.Scope): State {
  let want: typeinfo.Type = bound_type(s, name, after);
  if (!semtypes.concrete(want, true)) {
    return fail(s, "unresolved type of binding " + name + ": " + type_detail(want));
  }
  if (!semtypes.equal(want, s.values[id])) {
    return fail(s, mismatch(name, want, s.values[id]));
  }
  return bind_var(s, name, id);
}

function destructure_tuple(encoded: string, whole: i32, s: State, after: checker.Scope): State {
  let names: string[] = pattern_names(encoded);
  let ty: typeinfo.Type = s.values[whole];
  if (names.len() == 0 || tuple_arity(ty) != names.len()) {
    return fail(s, "unsupported destructuring declaration");
  }
  let i: i32 = 0;
  while (i < names.len()) {
    let elem: typeinfo.Type = tuple_element_type(ty, i);
    if (!semtypes.concrete(elem, true)) {
      return fail(s, "tuple projection contract");
    }
    let part: Value = define(s, ssasem.tuple_get(), [whole], i, "", elem);
    s = part.s;
    if (names[i].len() > 0 && names[i][0] == b'(') {
      s = destructure_tuple(slice_unchecked(names[i], 1, names[i].len() - 1) + "", part.id, s, after);
    } else {
      s = bind_projection(s, names[i], part.id, after);
    }
    if (!s.ok) {
      return s;
    }
    i = i + 1;
  }
  return s;
}

// The struct form's marker is `@sd:<Struct>:<fields>`, the fields in the
// order the pattern's names bind them.
function destructure_record(encoded: string, tag: string, whole: i32, s: State, after: checker.Scope): State {
  let rest: string = slice_unchecked(tag, 4, tag.len()) + "";
  let colon: i32 = util.index_of_sub(rest, ":");
  if (colon < 0) {
    return fail(s, "unsupported destructuring declaration");
  }
  let names: string[] = pattern_names(encoded);
  let fields: string[] = pattern_names(slice_unchecked(rest, colon + 1, rest.len()) + "");
  let sig: checker.StructSig = record_sig(s.values[whole], s);
  if (sig.name.len() == 0 || sig.name != slice_unchecked(rest, 0, colon) || fields.len() != names.len()) {
    return fail(s, "unsupported destructuring declaration");
  }
  let i: i32 = 0;
  while (i < names.len()) {
    let at: i32 = record_field_index(sig, fields[i]);
    if (at < 0 || !semtypes.concrete(sig.field_types[at], false)) {
      return fail(s, "record projection contract");
    }
    let part: Value = define(s, ssasem.record_get(), [whole], at, fields[i], sig.field_types[at]);
    s = bind_projection(part.s, names[i], part.id, after);
    if (!s.ok) {
      return s;
    }
    i = i + 1;
  }
  return s;
}

function tuple_arity(t: typeinfo.Type): i32 {
  if let typeinfo.TypeTuple(tup) = t {
    return tup.elements.len();
  }
  return 0 - 1;
}

// The parser joins a pattern's names with commas and keeps a nested position
// in its own parentheses, so only a top-level comma separates two names.
function pattern_names(encoded: string): string[] {
  let out: string[] = [];
  let depth: i32 = 0;
  let start: i32 = 0;
  let i: i32 = 0;
  while (i < encoded.len()) {
    if (encoded[i] == b'(') {
      depth = depth + 1;
    }
    if (encoded[i] == b')') {
      depth = depth - 1;
    }
    if (encoded[i] == b',' && depth == 0) {
      out = out.append(slice_unchecked(encoded, start, i) + "");
      start = i + 1;
    }
    i = i + 1;
  }
  return out.append(slice_unchecked(encoded, start, encoded.len()) + "");
}

// A binding whose declared type and initializer's value disagree, named,
// with both spellings: the refusal a reader can act on.
function mismatch(name: string, declared: typeinfo.Type, value: typeinfo.Type): string {
  return "binding " + name + " declared " + typeinfo.spelling(declared) + " holds a semantic value of " + typeinfo.spelling(value);
}

// The checker's post-declaration scope names the binding's type; the
// initializer's semantic value must carry exactly that type.
function declare(st: ast.Stmt, v: ast.StmtVar, s: State): State {
  if (destructures(v)) {
    return declare_tuple(st, v, s);
  }
  let after: checker.Scope = checker.bind_stmt(st, s.scope);
  let ty: typeinfo.Type = bound_type(s, v.name, after);
  if (!semtypes.concrete(ty, true)) {
    let cty: typeinfo.Type = closure_slot_type(v.init, s.contracts.list);
    if (semtypes.concrete(cty, true)) {
      ty = cty;
    }
  }
  // A CALL names its own result, in the contract the call reads to produce
  // itself, so an unannotated binding of one needs no type from the checker:
  // `let m = s.map(f)` on a generic receiver is the shape the checker leaves
  // unsettled, and the instance the call resolves is what settles it. The
  // initializer is produced once either way; this arm produces it with no
  // expectation and takes the value's type as the binding's.
  if (!semtypes.concrete(ty, false) && is_call(v.init)) {
    return declare_from_call(v, s, after);
  }
  // `let o = None;` names no payload either, so the binding settles as a
  // bare None payload does.
  if (!semtypes.concrete(ty, true)) {
    ty = settled_payload(ty);
  }
  if (!semtypes.concrete(ty, true)) {
    return fail(s, "unresolved type of binding " + v.name + ": " + type_detail(ty));
  }
  if (value_local_placeholder(v) && !ssasem.is_integer(ty)) {
    let z: Value = define(s, ssasem.zero(), [], 0, "", ty);
    return State { ...bind_var(z.s, v.name, z.id), scope: after };
  }
  let init: Value = expr(v.init, s, ty);
  s = init.s;
  if (!s.ok) {
    return s;
  }
  if (!semtypes.equal(s.values[init.id], ty)) {
    return fail(s, mismatch(v.name, ty, s.values[init.id]));
  }
  init = unaliased_view(init);
  return State { ...bind_var(init.s, v.name, init.id), scope: after };
}

// An escaping `let` is prebound at the top of the body (learn_body); its
// declaration overwrites that slot, and a probe learns its type here.
function bind_var(s: State, name: string, id: i32): State {
  if (util.index_of_str(s.escaping, name) < 0) {
    return bind(s, name, id);
  }
  if (util.index_of_str(s.names, name) >= 0) {
    return replace(s, name, id);
  }
  if (util.index_of_str(s.learned, name) >= 0 || !semtypes.concrete(s.values[id], false)) {
    return bind(s, name, id);
  }
  return bind(State { ...s, learned: s.learned.append(name), learned_types: s.learned_types.append(s.values[id]) }, name, id);
}

// A view bound under a second name, stored into a container, or yielded by a
// value block's arm, is a fresh view of the same bytes, so the two holders
// share no box. Otherwise a loop that rebinds one name merges the view the
// other still holds into its phi, and a container would take a unit of a view
// that stays live; either supply would retain a view (#9802). A literal and a
// retagged string are counted, and retaining them is sound. A cell store is
// the one container write that takes no fresh view: the checker refuses a
// `Cell[str]` (E057), so no checked program stores a view in a cell.
function unaliased_view(v: Value): Value {
  let s: State = v.s;
  if (!ssasem.is_view(s.values[v.id]) || util.index_of_i32(s.vals, v.id) < 0) {
    return v;
  }
  let kind: i32 = defining_kind(s, v.id);
  if (kind == 5 || kind == ssasem.str_as()) {
    return v;
  }
  return fresh_view(v);
}

// A view parameter is lent (`owned_shape`), so a value that keeps one holds a
// fresh view of the same bytes rather than the caller's box.
function kept_view(v: Value): Value {
  if (!v.s.ok || !ssasem.is_view(v.s.values[v.id]) || defining_kind(v.s, v.id) != ssasem.param()) {
    return v;
  }
  return fresh_view(v);
}

function fresh_view(v: Value): Value {
  let zero: Value = define(v.s, 1, [], 0, "", t_i32());
  let n: Value = define(zero.s, ssasem.length(), [v.id], 0, "", t_i32());
  return define(n.s, ssasem.slice(), [v.id, zero.id, n.id], 0, "", t_str());
}

// The kind of the instruction defining `id` so far (a parameter's is 6), or 0
// when nothing defines it.
function defining_kind(s: State, id: i32): i32 {
  for b in s.blocks {
    for ins in b.insts {
      if (ins.result == id) {
        return ins.kind_tag;
      }
    }
  }
  for ins in s.cur.insts {
    if (ins.result == id) {
      return ins.kind_tag;
    }
  }
  return 0;
}

// The local a value-position match routes its arms through is declared with a
// bare `0` before the arms say what they produce (parser.IfChain.value_local).
// The `0` only zeroes the slot the checker then types, so at a non-integer type
// it is that type's zero, the null word at a reference type.
function value_local_placeholder(v: ast.StmtVar): boolean {
  if (!parser.is_value_local_name(lexical.source_name(v.name))) {
    return false;
  }
  if let ast.ExprNumber(n) = v.init {
    return n.text == "0" && n.suffix.len() == 0 && !n.is_float;
  }
  return false;
}

function is_call(e: ast.Expr): boolean {
  if let ast.ExprCall(_) = e {
    return true;
  }
  return false;
}

function declare_from_call(v: ast.StmtVar, s: State, after: checker.Scope): State {
  let init: Value = expr(v.init, s, typeinfo.unchecked());
  s = init.s;
  if (!s.ok) {
    return s;
  }
  if (!semtypes.concrete(s.values[init.id], false)) {
    return fail(s, "unresolved type of binding " + v.name + ": " + type_detail(s.values[init.id]));
  }
  return State { ...bind_var(s, v.name, init.id), scope: after };
}

// Replacing a binding that holds a value this frame did not create is a write
// back through a CAPTURE read out of the environment, which no frame owns a
// unit of. A mutated capture never reaches here: `capturebox` rewrites it into
// a `Cell[T]` whose write is the cell's `set`.
function assign(a: ast.StmtAssign, s: State): State {
  let old: i32 = lookup(s, a.target);
  if (old < 0) {
    return fail(s, "replacement of an unbound name");
  }
  if (util.index_of_i32(s.foreign, old) >= 0) {
    return fail(s, "replacement of a capture");
  }
  let value: Value = expr(a.value, s, s.values[old]);
  s = value.s;
  if (!s.ok) {
    return s;
  }
  if (!semtypes.equal(s.values[value.id], s.values[old])) {
    return fail(s, "replacement type does not match its binding");
  }
  value = unaliased_view(value);
  return replace(value.s, a.target, value.id);
}

// A bare `return;` carries the parser's `punct:;` sentinel in place of a
// value, as the checker reads it; the unit literal is the other spelling.
function ret(r: ast.StmtReturn, s: State): State {
  if (parser.bare_return(r.value)) {
    if (!is_void(s.result)) {
      return fail(s, "missing return value");
    }
    return terminate(s, t_ret(0 - 1));
  }
  let value: Value = expr(r.value, s, s.result);
  s = value.s;
  if (!s.ok) {
    return s;
  }
  if (!semtypes.equal(s.values[value.id], s.result)) {
    return fail(s, "return type: declared " + typeinfo.spelling(s.result) + ", returns " + typeinfo.spelling(s.values[value.id]));
  }
  value = kept_view(value);
  return terminate(value.s, t_ret(value.id));
}

// `value` is the arm's value in a value block's match (-1 for a statement arm).
struct Arm { s: State, live: boolean, end: i32, env: i32[], value: i32 }

// Each arm starts from the environment at the branch, not from its sibling's.
function arm(body: ast.Stmt[], s: State, entry: i32[], id: i32, preds: i32[], join: i32, count: i32, scope: checker.Scope): Arm {
  return finish_arm(body, open(State { ...s, vals: entry }, id, preds), join, count, scope);
}

function finish_arm(body: ast.Stmt[], s: State, join: i32, count: i32, scope: checker.Scope): Arm {
  s = stmts(body, s);
  let live: boolean = s.live && s.ok;
  let end: i32 = s.cur.id;
  let env: i32[] = prefix(s.vals, count);
  s = terminate(s, t_br(join));
  return Arm { s: leave(s, count, scope), live: live, end: end, env: env, value: 0 - 1 };
}

// A match arm's body: statements, or in a value block's match the leading
// statements and then the arm's value (as an if-expression's arm reads it),
// which the join's phi takes on this arm's edge.
function arm_body(body: ast.Stmt[], s: State, join: i32, count: i32, scope: checker.Scope, ty: typeinfo.Type): Arm {
  if (!semtypes.concrete(ty, false)) {
    return finish_arm(body, s, join, count, scope);
  }
  let dead: Arm = Arm { s: s, live: false, end: 0, env: [], value: 0 - 1 };
  if (body.len() == 0) {
    return Arm { ...dead, s: fail(s, "value block arm has no value") };
  }
  let i: i32 = 0;
  while (i < body.len() - 1) {
    s = stmt(body[i], s);
    i = i + 1;
  }
  if (!s.ok) {
    return Arm { ...dead, s: s };
  }
  if (!s.live) {
    return Arm { ...dead, s: leave(s, count, scope) };
  }
  let v: Value = arm_value(body[body.len() - 1], s, ty);
  s = v.s;
  if (!s.ok) {
    return Arm { ...dead, s: s };
  }
  let end: i32 = s.cur.id;
  let env: i32[] = prefix(s.vals, count);
  s = terminate(s, t_br(join));
  return Arm { s: leave(s, count, scope), live: true, end: end, env: env, value: v.id };
}

function branch(f: ast.StmtIf, s: State): State {
  let then_id: i32 = s.next_block;
  let else_id: i32 = then_id + 1;
  let join: i32 = then_id + 2;
  s = State { ...s, next_block: join + 1 };
  let count: i32 = s.names.len();
  let entry: i32[] = s.vals;
  let scope: checker.Scope = s.scope;
  let c: Cond = cond(f.cond, s, then_id, else_id);
  s = c.s;
  if (!s.ok) {
    return s;
  }
  let t: Arm = arm(f.then_body, s, entry, then_id, c.yes, join, count, scope);
  let e: Arm = arm(f.else_body, t.s, entry, else_id, c.no, join, count, scope);
  s = e.s;
  if (!s.ok) {
    return s;
  }
  let preds: i32[] = [];
  let envs: i32[][] = [];
  if (t.live) {
    preds = preds.append(t.end);
    envs = envs.append(t.env);
  }
  if (e.live) {
    preds = preds.append(e.end);
    envs = envs.append(e.env);
  }
  if (preds.len() == 0) {
    return s;
  }
  return merge_env(open(s, join, preds), envs, count);
}

// ---- match ------------------------------------------------------------------

struct Arms { s: State, preds: i32[], envs: i32[][], values: i32[] }

function collect(arms: Arms, done: Arm): Arms {
  if (!done.live) {
    return Arms { ...arms, s: done.s };
  }
  return Arms { s: done.s, preds: arms.preds.append(done.end), envs: arms.envs.append(done.env), values: arms.values.append(done.value) };
}

function qualified(name: string): boolean {
  let i: i32 = 0;
  while (i < name.len()) {
    if (name[i] == b'.') {
      return true;
    }
    i = i + 1;
  }
  return false;
}

// Nested, struct-field, tuple and literal patterns read a value through no
// operation this boundary has.
function pattern_shape_error(pv: ast.PatVariant): string {
  if (pv.nested.len() > 0 || pv.has_lit_cond) {
    return "unsupported pattern";
  }
  if (pv.tup_kinds.len() > 0 || pv.field_names.len() > 0) {
    return "unsupported pattern";
  }
  if (qualified(pv.type_name)) {
    return "unsupported qualified pattern";
  }
  return "";
}

function pattern_error(a: ast.MatchArm, pv: ast.PatVariant, shape: Payloads, layout: i32): string {
  if (a.alt_cont) {
    return "unsupported match guard";
  }
  let why: string = pattern_shape_error(pv);
  if (why != "") {
    return why;
  }
  if (!shape.found) {
    return "unknown variant";
  }
  // A struct-union member's box IS the value, so its arm binds one name
  // whatever the member's field count; an enum variant binds one name per
  // payload position.
  if (layout == semrecords.layout_member() || shape.unit) {
    if (pv.extra_bindings.len() > 0) {
      return "pattern arity";
    }
    return "";
  }
  if (pv.binding != "" && 1 + pv.extra_bindings.len() != shape.types.len()) {
    return "pattern arity";
  }
  return "";
}

// A struct-union member's box is the value itself, so the arm's binding names
// the scrutinee narrowed to that member rather than a field of it.
// A binding a defer replays outside the arm is prebound; the arm overwrites
// that slot, as payloads does, rather than shadowing it.
function narrowed(pv: ast.PatVariant, scrut: i32, s: State): State {
  if (pv.binding == "" || pv.binding == "_") {
    return s;
  }
  let v: Value = define(s, ssasem.variant_as(), [scrut], 0, pv.type_name, member_type(pv));
  if (util.index_of_str(s.names, pv.binding) >= 0) {
    return replace(v.s, pv.binding, v.id);
  }
  return bind(v.s, pv.binding, v.id);
}

function member_type(pv: ast.PatVariant): typeinfo.Type {
  return typeinfo.TypeStruct { name: pv.type_name, args: [] };
}

// `@` names the complete scrutinee alongside the pattern's own bindings. The
// scrutinee is already a value of the graph, so the name is a second spelling
// of it rather than a projection, and it holds no reference of its own.
function at_bound(pv: ast.PatVariant, scrut: i32, s: State): State {
  if (pv.at_binding == "" || pv.at_binding == "_") {
    return s;
  }
  return bind(s, pv.at_binding, scrut);
}

// Each named payload position is a projection of the scrutinee, bound for
// the arm's body; `_`, an absent payload list and a `void` payload's binding
// bind nothing.
function payloads(pv: ast.PatVariant, scrut: i32, fields: typeinfo.Type[], s: State, layout: i32): State {
  s = at_bound(pv, scrut, s);
  if (layout == semrecords.layout_member()) {
    return narrowed(pv, scrut, s);
  }
  if (pv.binding == "" || fields.len() == 0) {
    return s;
  }
  let names: string[] = [pv.binding];
  for n in pv.extra_bindings {
    names = names.append(n);
  }
  let k: i32 = 0;
  while (k < names.len()) {
    if (names[k] != "_") {
      let v: Value = define(s, ssasem.variant_get(), [scrut], k, pv.type_name, fields[k]);
      if (util.index_of_str(s.names, names[k]) >= 0) {
        s = replace(v.s, names[k], v.id);
      } else {
        s = bind(v.s, names[k], v.id);
      }
    }
    k = k + 1;
  }
  return s;
}

// A guard is read in the arm's block, after the payload bindings it may
// name, and a false guard leaves for the next arm's test; the bindings die
// on that edge as on any other. The arm's body then opens a block of its
// own.
// `from` is the block the guard's branch leaves from, which is the arm's own
// block only when the guard opened no block of its own; -1 without a guard.
struct Gate { s: State, from: i32 }

function guard_gate(a: ast.MatchArm, s: State, next: i32): Gate {
  if (!a.has_guard) {
    return Gate { s: s, from: 0 - 1 };
  }
  let g: Value = expr(a.guard, s, t_bool());
  s = g.s;
  if (!s.ok) {
    return Gate { s: s, from: 0 - 1 };
  }
  if (!is_bool(s.values[g.id])) {
    return Gate { s: fail(s, "match guard type"), from: 0 - 1 };
  }
  let pred: i32 = s.cur.id;
  let body: i32 = s.next_block;
  s = terminate(State { ...s, next_block: body + 1 }, t_brif(g.id, body, next));
  return Gate { s: open(s, body, [pred]), from: pred };
}

// The predecessors of the next arm's test: the failed test, and the failed
// guard when the arm has one.
function next_preds(pred: i32, from: i32): i32[] {
  if (from >= 0) {
    return [pred, from];
  }
  return [pred];
}

// A pattern spelled with the union's own name ahead of the variant names the
// variant; a head naming anything else is refused.
function unqualified(pv: ast.PatVariant, owner: string): ast.PatVariant {
  if (!qualified(pv.type_name)) {
    return pv;
  }
  let dot: i32 = util.index_of_sub(pv.type_name, ".");
  if (slice_unchecked(pv.type_name, 0, dot) != owner) {
    return pv;
  }
  return ast.PatVariant { ...pv, type_name: slice_unchecked(pv.type_name, dot + 1, pv.type_name.len()) + "" };
}

function variant_arm(a: ast.MatchArm, pv: ast.PatVariant, scrut: i32, owner: string, arms: Arms, entry: i32[], join: i32, count: i32, scope: checker.Scope, closing: boolean, ty: typeinfo.Type): Arms {
  let s: State = arms.s;
  pv = unqualified(pv, owner);
  let layout: i32 = union_layout(s, owner);
  let shape: Payloads = arm_payloads(s, s.values[scrut], pv.type_name, layout);
  let why: string = pattern_error(a, pv, shape, layout);
  if (why != "") {
    return Arms { ...arms, s: fail(s, why) };
  }
  if (closing) {
    return closing_arm(a, pv, scrut, shape, arms, entry, join, count, scope, layout, ty);
  }
  let pred: i32 = s.cur.id;
  let id: i32 = s.next_block;
  let next: i32 = id + 1;
  s = State { ...s, next_block: next + 1 };
  let test: Value = define(s, ssasem.variant_is(), [scrut], 0, pv.type_name, t_bool());
  s = terminate(test.s, t_brif(test.id, id, next));
  let opened: State = payloads(pv, scrut, shape.types, open(State { ...s, vals: entry }, id, [pred]), layout);
  opened = State { ...opened, scope: checker.arm_scope(a, scope, opened.values[scrut]) };
  let gate: Gate = guard_gate(a, opened, next);
  if (!gate.s.ok) {
    return Arms { ...arms, s: gate.s };
  }
  let done: Arm = arm_body(a.body, gate.s, join, count, scope, ty);
  done = Arm { ...done, s: open(State { ...done.s, vals: entry }, next, next_preds(pred, gate.from)) };
  return collect(arms, done);
}

// A CLOSING arm is the last of a TOTAL match: every other variant is named by
// an arm before it, so the value is this one and a test of it would be
// constant. Nothing leaves the match but the arms themselves, which is what
// makes a body whose every arm returns a body that does not fall through.
// `ssasem.analyze` verifies this arm's payload projections against the same
// exhaustion the omitted test rests on.
function closing_arm(a: ast.MatchArm, pv: ast.PatVariant, scrut: i32, shape: Payloads, arms: Arms, entry: i32[], join: i32, count: i32, scope: checker.Scope, layout: i32, ty: typeinfo.Type): Arms {
  let s: State = arms.s;
  let pred: i32 = s.cur.id;
  let id: i32 = s.next_block;
  s = terminate(State { ...s, next_block: id + 1 }, t_br(id));
  let opened: State = payloads(pv, scrut, shape.types, open(State { ...s, vals: entry }, id, [pred]), layout);
  opened = State { ...opened, scope: checker.arm_scope(a, scope, opened.values[scrut]) };
  return collect(arms, arm_body(a.body, opened, join, count, scope, ty));
}

// A wildcard closes the chain, so the arms after it are not produced; a
// GUARDED wildcard does not, and its failed guard leaves for the next arm's
// test as a variant arm's does.
function wildcard_arm(a: ast.MatchArm, arms: Arms, entry: i32[], join: i32, count: i32, scope: checker.Scope, ty: typeinfo.Type): Arms {
  let s: State = arms.s;
  let pred: i32 = s.cur.id;
  let id: i32 = s.next_block;
  if (!a.has_guard) {
    s = terminate(State { ...s, next_block: id + 1 }, t_br(id));
    return collect(arms, arm_body(a.body, open(State { ...s, vals: entry }, id, [pred]), join, count, scope, ty));
  }
  let next: i32 = id + 1;
  s = terminate(State { ...s, next_block: next + 1 }, t_br(id));
  let gate: Gate = guard_gate(a, open(State { ...s, vals: entry }, id, [pred]), next);
  if (!gate.s.ok) {
    return Arms { ...arms, s: gate.s };
  }
  let done: Arm = arm_body(a.body, gate.s, join, count, scope, ty);
  done = Arm { ...done, s: open(State { ...done.s, vals: entry }, next, [gate.from]) };
  return collect(arms, done);
}

function match_arm(a: ast.MatchArm, scrut: i32, owner: string, arms: Arms, entry: i32[], join: i32, count: i32, scope: checker.Scope, closing: boolean, ty: typeinfo.Type): Arms {
  match (a.pattern) {
    ast.PatWildcard(_) => {
      return wildcard_arm(a, arms, entry, join, count, scope, ty);
    },
    ast.PatVariant(pv) => {
      return variant_arm(a, pv, scrut, owner, arms, entry, join, count, scope, closing, ty);
    }
  }
  return Arms { ...arms, s: fail(arms.s, "unsupported pattern") };
}

// The variant names a union declares: a builtin union's are its instantiation's
// two, a declared one's come from the declarations.
function variant_names(s: State, whole: typeinfo.Type, layout: i32): string[] {
  if (layout != semrecords.layout_option()) {
    return union_variants(s, union_name(whole));
  }
  let out: string[] = [];
  for v in builtin_variants(whole) {
    out = out.append(v.name);
  }
  return out;
}

function arm_variant_name(a: ast.MatchArm, owner: string): string {
  if (a.has_guard || a.alt_cont) {
    return "";
  }
  if let ast.PatVariant(pv) = a.pattern {
    return unqualified(pv, owner).type_name;
  }
  return "";
}

// A match is TOTAL when its unguarded arms are variant patterns naming
// distinct variants of the scrutinee's union, as many as the union declares,
// and its last arm is one of them. A guarded arm decides nothing about
// coverage: its false edge reaches the arms after it, and an unguarded arm
// for the same variant catches what the guard let through. Nothing can then
// reach the fall-through, so the last arm needs no test.
function total_match(s: State, m: ast.StmtMatch, whole: typeinfo.Type, layout: i32): boolean {
  let declared: string[] = variant_names(s, whole, layout);
  if (declared.len() == 0 || m.arms.len() == 0 || m.arms[m.arms.len() - 1].has_guard) {
    return false;
  }
  let named: string[] = [];
  for a in m.arms {
    if (a.has_guard) {
      continue;
    }
    let name: string = arm_variant_name(a, union_name(whole));
    if (util.index_of_str(declared, name) < 0) {
      return false;
    }
    if (util.index_of_str(named, name) >= 0) {
      return false;
    }
    named = named.append(name);
  }
  return named.len() == declared.len();
}

// Arms are tested in order; each test's false edge enters the next test.
// An arm after a wildcard is unreachable and is not produced. A total match's
// last arm closes the chain, so only an incomplete one falls through to the
// join, and only that one leaves the match live.
function match_stmt(m: ast.StmtMatch, s: State): State {
  let c: Chain = match_chain(m, s, typeinfo.unchecked());
  let arms: Arms = c.arms;
  s = arms.s;
  if (!s.ok) {
    return s;
  }
  if (s.live) {
    arms = Arms { ...arms, preds: arms.preds.append(s.cur.id), envs: arms.envs.append(prefix(s.vals, c.count)) };
    s = terminate(s, t_br(c.join));
  }
  if (arms.preds.len() == 0) {
    return s;
  }
  return merge_env(open(s, c.join, arms.preds), arms.envs, c.count);
}

struct Chain { arms: Arms, join: i32, count: i32 }

// Record the payload type of each escaping binding this match's arms bind.
function learn_escaping(m: ast.StmtMatch, s: State, whole: typeinfo.Type, owner: string): State {
  if (s.escaping.len() == s.learned.len()) {
    return s;
  }
  let layout: i32 = union_layout(s, owner);
  for a in m.arms {
    if let ast.PatVariant(raw) = a.pattern {
      let pv: ast.PatVariant = unqualified(raw, owner);
      let shape: Payloads = arm_payloads(s, whole, pv.type_name, layout);
      // A member arm binds the member itself, as narrowed does, not a
      // field of it.
      if (layout == semrecords.layout_member()) {
        shape = Payloads { ...shape, types: [member_type(pv)] };
      }
      let names: string[] = [pv.binding];
      for n in pv.extra_bindings {
        names = names.append(n);
      }
      let k: i32 = 0;
      while (k < names.len() && k < shape.types.len()) {
        if (util.index_of_str(s.escaping, names[k]) >= 0 && util.index_of_str(s.learned, names[k]) < 0 && semtypes.concrete(shape.types[k], false)) {
          s = State { ...s, learned: s.learned.append(names[k]), learned_types: s.learned_types.append(shape.types[k]) };
        }
        k = k + 1;
      }
    }
  }
  return s;
}

// A match whose arms are all `_` tests nothing about its scrutinee, so it
// needs no union: the parser leaves one on a scalar undesugared, since only a
// literal arm routes a match through its if-chain.
function only_wildcards(m: ast.StmtMatch): boolean {
  for a in m.arms {
    if let ast.PatWildcard(_) = a.pattern {} else {
      return false;
    }
  }
  return m.arms.len() > 0;
}

// The arms of a match, tested in order, each ending on the join; `ty` is the
// value a value block's arms carry to it, unchecked for a statement.
function match_chain(m: ast.StmtMatch, s: State, ty: typeinfo.Type): Chain {
  let none: Chain = Chain { arms: Arms { s: s, preds: [], envs: [], values: [] }, join: 0, count: 0 };
  let scrut: Value = expr(m.scrutinee, s, typeinfo.unchecked());
  s = scrut.s;
  if (!s.ok) {
    return Chain { ...none, arms: Arms { ...none.arms, s: s } };
  }
  let owner: string = union_name(s.values[scrut.id]);
  if ((owner == "" || union_layout(s, owner) == 0) && !only_wildcards(m)) {
    return Chain { ...none, arms: Arms { ...none.arms, s: fail(s, "unsupported match scrutinee") } };
  }
  let closes: i32 = 0 - 1;
  if (total_match(s, m, s.values[scrut.id], union_layout(s, owner))) {
    closes = m.arms.len() - 1;
  }
  s = learn_escaping(m, s, s.values[scrut.id], owner);
  let join: i32 = s.next_block;
  s = State { ...s, next_block: join + 1 };
  let count: i32 = s.names.len();
  let entry: i32[] = s.vals;
  let scope: checker.Scope = s.scope;
  let arms: Arms = Arms { s: s, preds: [], envs: [], values: [] };
  let i: i32 = 0;
  while (i < m.arms.len() && arms.s.ok && arms.s.live) {
    arms = match_arm(m.arms[i], scrut.id, owner, arms, entry, join, count, scope, i == closes, ty);
    i = i + 1;
  }
  return Chain { arms: arms, join: join, count: count };
}

// A match-expression: every arm carries a value to the join, where the
// bindings merge and then the value, as an if-expression's do. A match that
// can fall through has an edge with no value, so it is refused rather than
// joined.
function value_match(m: ast.StmtMatch, s: State, ty: typeinfo.Type): Value {
  let c: Chain = match_chain(m, s, ty);
  s = c.arms.s;
  if (!s.ok) {
    return Value { s: s, id: 0 - 1 };
  }
  if (s.live) {
    return refused(s, "value block match falls through");
  }
  if (c.arms.preds.len() == 0) {
    return unreachable_value(s, ty);
  }
  s = merge_env(open(s, c.join, c.arms.preds), c.arms.envs, c.count);
  return define(s, 8, c.arms.values, 0, "", ty);
}

function current_loop(s: State): Loop {
  return s.loops[s.loops.len() - 1];
}

function with_loop(s: State, l: Loop): State {
  return State { ...s, loops: s.loops.with(s.loops.len() - 1, l) };
}

// A labelled exit leaves the loop the label names and every loop inside it:
// the edge records the environment at that loop's entry, so the bindings the
// inner loops made die on it.
function leave_loop(s: State, label: string, is_break: boolean): State {
  if (s.loops.len() == 0) {
    return fail(s, "loop exit outside a loop");
  }
  let at: i32 = s.loops.len() - 1;
  if (label != "") {
    at = 0 - 1;
    let i: i32 = 0;
    while (i < s.loops.len()) {
      if (s.loops[i].label == label) {
        at = i;
      }
      i = i + 1;
    }
    if (at < 0) {
      return fail(s, "loop exit names no enclosing loop");
    }
  }
  let l: Loop = s.loops[at];
  let e: Exit = Exit { block: s.cur.id, env: prefix(s.vals, l.entry_count) };
  if (is_break) {
    s = with_loop_at(s, at, Loop { ...l, breaks: l.breaks.append(e) });
    return terminate(s, t_br(l.exit));
  }
  s = with_loop_at(s, at, Loop { ...l, continues: l.continues.append(e) });
  return terminate(s, t_br(l.header));
}

function with_loop_at(s: State, at: i32, l: Loop): State {
  return State { ...s, loops: s.loops.with(at, l) };
}

// Header phis are created before the body is known and completed afterwards
// from the back edges the body actually produced.
function header_phis(s: State, count: i32): State {
  let at: i32 = 0;
  while (at < count) {
    let entry: i32 = s.vals[at];
    let phi: Value = define(s, 8, [entry], 0, "", s.values[entry]);
    s = note_binding(State { ...phi.s, vals: phi.s.vals.with(at, phi.id) }, s.names[at], phi.id);
    at = at + 1;
  }
  return s;
}

function complete_header(s: State, header: i32, exits: Exit[]): State {
  let i: i32 = 0;
  while (i < s.blocks.len() && s.blocks[i].id != header) {
    i = i + 1;
  }
  if (i == s.blocks.len()) {
    return fail(s, "loop header is still open");
  }
  let b: ssa.SBlock = s.blocks[i];
  let preds: i32[] = b.preds;
  let insts: ssa.SInst[] = b.insts;
  for e in exits {
    preds = preds.append(e.block);
    let at: i32 = 0;
    while (at < e.env.len()) {
      let phi: ssa.SInst = insts[at];
      insts = insts.with(at, ssa.SInst { ...phi, args: phi.args.append(e.env[at]) });
      at = at + 1;
    }
  }
  return State { ...s, blocks: s.blocks.with(i, ssa.SBlock { ...b, preds: preds, insts: insts }) };
}

function iterate(w: ast.StmtWhile, s: State): State {
  let pred: i32 = s.cur.id;
  let header: i32 = s.next_block;
  let body: i32 = header + 1;
  let exit_id: i32 = header + 2;
  s = State { ...s, next_block: exit_id + 1 };
  let count: i32 = s.names.len();
  let scope: checker.Scope = s.scope;
  s = terminate(s, t_br(header));
  s = header_phis(open(s, header, [pred]), count);
  let entry_env: i32[] = s.vals;
  s = State { ...s, loops: s.loops.append(Loop { label: w.label, header: header, exit: exit_id, entry_count: count, breaks: [], continues: [] }) };
  let c: Cond = cond(w.cond, s, body, exit_id);
  s = c.s;
  if (!s.ok) {
    return s;
  }
  let latch: Arm = arm(w.body, s, entry_env, body, c.yes, header, count, scope);
  s = latch.s;
  if (!s.ok) {
    return s;
  }
  let l: Loop = current_loop(s);
  s = State { ...s, loops: prefix_loops(s.loops, s.loops.len() - 1) };
  let back: Exit[] = l.continues;
  if (latch.live) {
    back = back.append(Exit { block: latch.end, env: latch.env });
  }
  s = complete_header(s, header, back);
  let preds: i32[] = c.no;
  let envs: i32[][] = [];
  for _ in c.no {
    envs = envs.append(entry_env);
  }
  for e in l.breaks {
    preds = preds.append(e.block);
    envs = envs.append(e.env);
  }
  return merge_env(open(s, exit_id, preds), envs, count);
}

// The index binding of a produced `for`. A Fern identifier cannot contain a
// space, so this names a slot no user binding can collide with or read.
function index_name(): string {
  return "for index";
}

// `for x in xs` is an index loop over the array. The iterable is produced ONCE
// before the header. The index starts one before the first element and the
// advance runs at the TOP of the loop, after the header: `continue` branches to
// the header, so an advance at the bottom would be skipped and the loop would
// never terminate. The element is a projection of the container, so it borrows
// and its unit obligations are the container's.
function iterate_array(fo: ast.StmtFor, s: State): State {
  if (fo.var_name == "") {
    return fail(s, "unsupported loop binding");
  }
  let it: Value = expr(fo.iter, s, typeinfo.unchecked());
  s = it.s;
  if (!s.ok) {
    return s;
  }
  let text: boolean = ssasem.is_text(s.values[it.id]);
  let elem: typeinfo.Type = element_type(s.values[it.id]);
  if (text) {
    elem = t_u8();
  }
  // `for (k, v) in m` walks the map's two columns in step: each is
  // snapshotted into a fresh array the frame owns, the key column is what
  // the index runs over, and the value read beside each key is the value
  // column's element at the same index. The runtime hands both columns
  // back in the same order, which is what pairs them.
  let vals: i32 = 0 - 1;
  let vtype: typeinfo.Type = typeinfo.unchecked();
  if (ssasem.is_map(s.values[it.id])) {
    let m: typeinfo.Type = s.values[it.id];
    if (!ssasem.is_supported_map(m)) {
      return fail(s, "unsupported iterable: " + typeinfo.spelling(m));
    }
    let keys: Value = map_column(s, it, ssasem.map_keys(), ssasem.map_key(m));
    if (!keys.s.ok) {
      return keys.s;
    }
    let values: Value = map_column(keys.s, it, ssasem.map_values(), ssasem.map_value(m));
    if (!values.s.ok) {
      return values.s;
    }
    s = values.s;
    it = keys;
    vals = values.id;
    vtype = ssasem.map_value(m);
    elem = ssasem.map_key(m);
  }
  if (!semtypes.concrete(elem, false)) {
    return fail(s, "unsupported iterable: " + typeinfo.spelling(s.values[it.id]));
  }
  let before: i32 = s.names.len();
  let outer: checker.Scope = s.scope;
  let start: Value = define(s, 1, [], 0 - 1, "", t_i32());
  s = bind(start.s, index_name(), start.id);

  let pred: i32 = s.cur.id;
  let header: i32 = s.next_block;
  let body_id: i32 = header + 1;
  let exit_id: i32 = header + 2;
  s = State { ...s, next_block: exit_id + 1 };
  let count: i32 = s.names.len();
  let scope: checker.Scope = s.scope;
  s = terminate(s, t_br(header));
  s = header_phis(open(s, header, [pred]), count);
  s = State { ...s, loops: s.loops.append(Loop { label: fo.label, header: header, exit: exit_id, entry_count: count, breaks: [], continues: [] }) };

  // advance, then test: both live in the header, so a continue re-runs them.
  let one: Value = define(s, 1, [], 1, "", t_i32());
  let step: Value = define(one.s, 9, [lookup(one.s, index_name()), one.id], 0, "+", t_i32());
  s = replace(step.s, index_name(), step.id);
  let n: Value = define(s, ssasem.length(), [it.id], 0, "", t_i32());
  let test: Value = define(n.s, 9, [step.id, n.id], 0, "<", t_bool());
  s = test.s;
  if (!s.ok) {
    return s;
  }
  let cond_end: i32 = s.cur.id;
  // The env the exit and the body both start from is the ADVANCED one, not
  // the header's phis: the header rebinds the index, which a while loop's
  // condition never does.
  let advanced: i32[] = s.vals;
  s = terminate(s, t_brif(test.id, body_id, exit_id));

  let opened: State = open(State { ...s, vals: advanced }, body_id, [cond_end]);
  // The header's `step < n` test is the bounds check, so neither read repeats it.
  let item: Value = define(opened, ssasem.array_get(), [it.id, step.id], 1, "", elem);
  // A string's element is one byte, read rather than projected.
  if (text) {
    item = define(opened, ssasem.str_index(), [it.id, step.id], 1, "", elem);
  }
  // The element is a checker binding for the body's span as well: every type
  // this boundary reads from the checker is read in s.scope. A pattern header
  // destructures the element the way a declaration does.
  let inner: checker.Scope = checker.for_body_scope(fo, scope);
  let body_state: State = bind_var(item.s, fo.var_name, item.id);
  if (vals >= 0) {
    let names: string[] = checker.split_pattern_names(fo.var_name);
    if (names.len() != 2) {
      return fail(s, "unsupported loop binding");
    }
    let vitem: Value = define(item.s, ssasem.array_get(), [vals, step.id], 1, "", vtype);
    body_state = bind_position(bind_position(vitem.s, names[0], item.id, inner), names[1], vitem.id, inner);
  } else if (util.contains(fo.var_name, ",")) {
    body_state = destructure_tuple(fo.var_name, item.id, item.s, inner);
  }
  if (!body_state.ok) {
    return body_state;
  }
  body_state = State { ...body_state, scope: inner };
  let latch: Arm = finish_arm(fo.body, body_state, header, count, scope);
  s = latch.s;
  if (!s.ok) {
    return s;
  }
  let l: Loop = current_loop(s);
  s = State { ...s, loops: prefix_loops(s.loops, s.loops.len() - 1) };
  let back: Exit[] = l.continues;
  if (latch.live) {
    back = back.append(Exit { block: latch.end, env: latch.env });
  }
  s = complete_header(s, header, back);
  let preds: i32[] = [cond_end];
  let envs: i32[][] = [advanced];
  for e in l.breaks {
    preds = preds.append(e.block);
    envs = envs.append(e.env);
  }
  s = merge_env(open(s, exit_id, preds), envs, count);
  return leave(s, before, outer);
}

// A map header's key and value positions are each a name or a nested tuple
// pattern, as a declaration's are.
function bind_position(s: State, name: string, id: i32, after: checker.Scope): State {
  if (name.len() > 0 && name[0] == b'(') {
    return destructure_tuple(slice_unchecked(name, 1, name.len() - 1) + "", id, s, after);
  }
  return bind_var(s, name, id);
}

function prefix_loops(xs: Loop[], n: i32): Loop[] {
  let out: Loop[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(xs[i]);
    i = i + 1;
  }
  return out;
}

// A discarded result is a value nothing reads; the unit planner releases it
// where it is made. Only a call may be void.
function discard(e: ast.Expr, s: State): State {
  if let ast.ExprCall(c) = e {
    return call(e, c, s, true, t_void()).s;
  }
  return expr(e, s, typeinfo.unchecked()).s;
}

function stmt(st: ast.Stmt, s: State): State {
  if (!s.ok || !s.live) {
    return s;
  }
  if (s.debug_lines) {
    s = line_mark(st, s);
  }
  match (st) {
    ast.StmtVar(v) => {
      return declare(st, v, s);
    },
    ast.StmtExpr(e) => {
      return discard(e.value, s);
    },
    ast.StmtAssign(a) => {
      return assign(a, s);
    },
    ast.StmtReturn(r) => {
      return ret(r, s);
    },
    ast.StmtIf(f) => {
      return branch(f, s);
    },
    ast.StmtWhile(w) => {
      return iterate(w, s);
    },
    ast.StmtMatch(m) => {
      return match_stmt(m, s);
    },
    ast.StmtBreak(b) => {
      return leave_loop(s, b.label, true);
    },
    ast.StmtContinue(c) => {
      return leave_loop(s, c.label, false);
    },
    ast.StmtFor(fo) => {
      return iterate_array(fo, s);
    },
    _ => {
      return fail(s, "unsupported statement");
    }
  }
}

// line_mark emits the source-position marker (ssa kind 35) a `-g` build
// carries ahead of each statement: imm the merged module's line, str the
// column, and a void value nothing reads. ssarc hands it on as ir.op_line.
function line_mark(st: ast.Stmt, s: State): State {
  let v: Value = define(s, 35, [], ast.stmt_line(st), util.i32_to_string(stmt_col(st)), t_void());
  return v.s;
}

// stmt_col is a statement's column where the parser records one, else 0.
function stmt_col(st: ast.Stmt): i32 {
  match (st) {
    ast.StmtVar(v) => {
      return v.col;
    },
    ast.StmtReturn(r) => {
      return r.col;
    },
    ast.StmtAssign(a) => {
      return a.col;
    },
    ast.StmtMatch(m) => {
      return m.col;
    },
    ast.StmtBreak(b) => {
      return b.col;
    },
    ast.StmtContinue(c) => {
      return c.col;
    },
    _ => {
      return 0;
    }
  }
}

function stmts(body: ast.Stmt[], s: State): State {
  let count: i32 = s.names.len();
  let scope: checker.Scope = s.scope;
  for st in body {
    s = stmt(st, s);
  }
  return leave(s, count, scope);
}

// ---- simplification ---------------------------------------------------------

function resolve(map: i32[], v: i32): i32 {
  while (map[v] != v) {
    v = map[v];
  }
  return v;
}

function trivial_source(ins: ssa.SInst, map: i32[]): i32 {
  let source: i32 = 0 - 1;
  for arg in ins.args {
    let v: i32 = resolve(map, arg);
    if (v == ins.result) {
      continue;
    }
    if (source >= 0 && v != source) {
      return 0 - 1;
    }
    source = v;
  }
  return source;
}

// A phi whose inputs all name one other value is that value. Loop headers
// create one phi per binding before the body is known, so most are trivial.
function trivial_phis(blocks: ssa.SBlock[], nvals: i32): i32[] {
  let map: i32[] = [];
  let i: i32 = 0;
  while (i < nvals) {
    map = map.append(i);
    i = i + 1;
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for b in blocks {
      for ins in b.insts {
        if (ins.kind_tag != 8 || map[ins.result] != ins.result) {
          continue;
        }
        let source: i32 = trivial_source(ins, map);
        if (source >= 0) {
          map = map.with(ins.result, source);
          changed = true;
        }
      }
    }
  }
  return map;
}

function mapped_args(args: i32[], map: i32[]): i32[] {
  let out: i32[] = [];
  for a in args {
    out = out.append(resolve(map, a));
  }
  return out;
}

function mapped_term(t: ssa.STerm, map: i32[]): ssa.STerm {
  if (t.kind_tag == 1 && t.value >= 0) {
    return ssa.STerm { ...t, value: resolve(map, t.value) };
  }
  if (t.kind_tag == 3) {
    return ssa.STerm { ...t, cond: resolve(map, t.cond) };
  }
  return t;
}

function successors(t: ssa.STerm): i32[] {
  if (t.kind_tag == 2) {
    return [t.target];
  }
  if (t.kind_tag == 3) {
    return [t.t, t.f];
  }
  return [];
}

// Each block's position in `blocks`, indexed by id; -1 for an id with none.
function block_positions(blocks: ssa.SBlock[]): i32[] {
  let at: i32[] = [];
  let i: i32 = 0;
  while (i < blocks.len()) {
    while (at.len() <= blocks[i].id) {
      at = at.append(0 - 1);
    }
    at = at.with(blocks[i].id, i);
    i = i + 1;
  }
  return at;
}

// Whether the entry reaches each block id.
function reached(blocks: ssa.SBlock[], at: i32[]): boolean[] {
  let seen: boolean[] = [];
  for _ in at {
    seen = seen.append(false);
  }
  seen = seen.with(blocks[0].id, true);
  let work: i32[] = [blocks[0].id];
  let head: i32 = 0;
  while (head < work.len()) {
    for next in successors(blocks[at[work[head]]].term) {
      if (next < at.len() && at[next] >= 0 && !seen[next]) {
        seen = seen.with(next, true);
        work = work.append(next);
      }
    }
    head = head + 1;
  }
  return seen;
}

// A reached block keeps only the edges from reached blocks, and each phi the
// inputs those edges supply.
function live_edges(b: ssa.SBlock, seen: boolean[]): ssa.SBlock {
  let keep: i32[] = [];
  let k: i32 = 0;
  while (k < b.preds.len()) {
    if (seen[b.preds[k]]) {
      keep = keep.append(k);
    }
    k = k + 1;
  }
  if (keep.len() == b.preds.len()) {
    return b;
  }
  let preds: i32[] = [];
  for j in keep {
    preds = preds.append(b.preds[j]);
  }
  let insts: ssa.SInst[] = [];
  for ins in b.insts {
    if (ins.kind_tag != 8) {
      insts = insts.append(ins);
      continue;
    }
    let args: i32[] = [];
    for j in keep {
      args = args.append(ins.args[j]);
    }
    insts = insts.append(ssa.SInst { ...ins, args: args });
  }
  return ssa.SBlock { ...b, insts: insts, preds: preds };
}

// The blocks the entry reaches. ssa.fern's thread_forwarding and
// trim_phi_edges do the same trim later; both rely on a phi's args being
// parallel to its preds, and here a phi always has one arg per pred.
function reachable(blocks: ssa.SBlock[]): ssa.SBlock[] {
  let seen: boolean[] = reached(blocks, block_positions(blocks));
  let out: ssa.SBlock[] = [];
  for b in blocks {
    if (seen[b.id]) {
      out = out.append(live_edges(b, seen));
    }
  }
  return out;
}

// Removed phis leave no gaps: surviving definitions are renumbered densely
// in block order, keeping parameters at their declared positions.
function renumber(blocks: ssa.SBlock[], map: i32[], values: typeinfo.Type[], dbg_vals: i32[], dbg_names: string[]): ssasem.Func {
  let ids: i32[] = [];
  let kept: typeinfo.Type[] = [];
  let i: i32 = 0;
  while (i < map.len()) {
    ids = ids.append(0 - 1);
    i = i + 1;
  }
  for b in blocks {
    for ins in b.insts {
      if (map[ins.result] != ins.result) {
        continue;
      }
      ids = ids.with(ins.result, kept.len());
      kept = kept.append(values[ins.result]);
    }
  }
  let out: ssa.SBlock[] = [];
  for b in blocks {
    let insts: ssa.SInst[] = [];
    for ins in b.insts {
      if (map[ins.result] != ins.result) {
        continue;
      }
      let args: i32[] = [];
      for a in mapped_args(ins.args, map) {
        args = args.append(ids[a]);
      }
      insts = insts.append(ssa.SInst { ...ins, result: ids[ins.result], args: args });
    }
    let term: ssa.STerm = mapped_term(b.term, map);
    if (term.kind_tag == 1 && term.value >= 0) {
      term = ssa.STerm { ...term, value: ids[term.value] };
    }
    if (term.kind_tag == 3) {
      term = ssa.STerm { ...term, cond: ids[term.cond] };
    }
    out = out.append(ssa.SBlock { ...b, insts: insts, term: term });
  }
  let graph: ssa.SFunc = ssa.SFunc { name: "", nparams: 0, nvals: kept.len(), blocks: out, entry: 0, takes_env: false };
  let f: ssasem.Func = ssasem.Func { graph: graph, values: kept, params: [], result: t_void(), records: semrecords.no_records(), enums: [], calls: [], envs: [], anchors: [], dyns: [], shadows: [], finalizers: [], map_module: false, dbg_vals: [], dbg_names: [] };
  return renumber_bindings(f, map, ids, dbg_vals, dbg_names);
}

// A recorded binding follows its value through the collapsed phis, and is
// dropped with an unreachable one.
function renumber_bindings(f: ssasem.Func, map: i32[], ids: i32[], dbg_vals: i32[], dbg_names: string[]): ssasem.Func {
  let d: i32 = 0;
  while (d < dbg_vals.len()) {
    let id: i32 = ids[resolve(map, dbg_vals[d])];
    if (id >= 0) {
      f = ssasem.Func { ...f, dbg_vals: f.dbg_vals.append(id), dbg_names: f.dbg_names.append(dbg_names[d]) };
    }
    d = d + 1;
  }
  return f;
}

// ---- functions --------------------------------------------------------------

// An `@import` extern is a declaration with a contract and no body: its
// callers are produced against the signature it declares, and the wasm
// bridge emits the function itself from the declaration.
function external_entry(): Produced {
  return Produced { ...refuse("external declaration"), bodyless: true };
}

function reference(t: typeinfo.Type): boolean {
  return semtypes.needs_anchor(t);
}

// A parameter's mode is its declaration's: a reference is counted when it is
// declared `own` and borrowed otherwise, and a scalar carries no unit. A
// template's variable counts as a reference here, so its declared mode is
// what every instance starts from (`ssasem.instantiate_contract` drops it to
// a value where the variable binds a scalar).
function mode(p: ast.ParamDecl, t: typeinfo.Type): i32 {
  if (!reference(t)) {
    return ssaunits.value_mode();
  }
  if (p.own) {
    return ssaunits.counted_mode();
  }
  return ssaunits.borrow_mode();
}

// Whether a receiver is the declaration's parameter 0. An impl block's
// associated function has a receiver_type and no receiver.
pub function has_receiver(fd: parser.FuncDecl): boolean {
  return fd.receiver_name.len() > 0;
}

// A method's receiver is its parameter 0: the backends already lower it as
// one, and the unit planner needs it in the same list as the declared
// parameters, so every walk over a declaration's parameters starts here.
function decl_param_names(fd: parser.FuncDecl): string[] {
  let out: string[] = [];
  if (has_receiver(fd)) {
    out = out.append(fd.receiver_name);
  }
  for p in fd.params {
    out = out.append(p.name);
  }
  return out;
}

// The receiver borrows. Its `own` modifier is parsed and discarded before it
// reaches FuncDecl, so there is nothing here to read it from; borrowing is
// what every backend already does with a receiver, and it is the direction
// that refuses rather than miscompiles if a body tries to consume one.
function decl_param_mode(fd: parser.FuncDecl, at: i32, t: typeinfo.Type): i32 {
  if (!has_receiver(fd)) {
    return mode(fd.params[at], t);
  }
  if (at > 0) {
    return mode(fd.params[at - 1], t);
  }
  if (!reference(t)) {
    return ssaunits.value_mode();
  }
  return ssaunits.borrow_mode();
}

// coarse_fn_tag_without_contract reports a declaration whose result is the
// coarse callable tag carrying none of the signature that tag drops. The one
// this exists for is synthesised: the IIFE lift.hoist_value_iife declares
// for an if/match-expression whose arms are UNANNOTATED lambdas, which have a
// parameter list to report and no result.
//
// A declaration the SOURCE wrote can match too, at a depth parse_decl_type does
// not recover the pair for — `((i32) => void)[][]` is `fn[][]` with an empty
// sidecar. Admitting it is harmless: the inference either resolves the result
// or does not, and a result that stays unresolved is refused exactly as before.
// So this tests the tag, not who wrote it.
function coarse_fn_tag_without_contract(fd: parser.FuncDecl): boolean {
  return fd.ret_fn_ret.len() == 0 && parser.is_coarse_fn_tag(fd.ret_type);
}

// A declaration that spells no result type is void unless its body returns a
// value: a hoisted lambda carries no annotation, and its result is the type
// the checker gives the first value it returns, read in the scope the
// statements before it built, completed from the other exits when that leaves
// part of it unknown.
function inferred_result(fd: parser.FuncDecl, scope: checker.Scope, b: ssasem.Binding, contracts: ssasem.Contract[]): typeinfo.Type {
  let (returned, at) = checker.first_returned(fd.body, scope);
  if (parser.bare_return(returned)) {
    return t_void();
  }
  if (calls_synthesised(returned)) {
    return called_synthesised_result(returned, contracts, b);
  }
  let constructed: typeinfo.Type = closure_slot_type(returned, contracts);
  if (semtypes.concrete(constructed, false)) {
    return constructed;
  }
  if let ast.ExprIdent(id) = returned {
    let slot: typeinfo.Type = closure_slot_type(slot_init(fd.body, id.name), contracts);
    if (semtypes.concrete(slot, false)) {
      return slot;
    }
  }
  let first: typeinfo.Type = resolved(checker.expr_type(returned, at), generic_decl(fd), b, at);
  if (semtypes.concrete(first, true)) {
    return first;
  }
  // `return Ok(v)` leaves Result's error to another exit, such as a `?`.
  let exits: typeinfo.Type = resolved(checker.exit_result(fd.body, scope), generic_decl(fd), b, scope);
  if (semtypes.concrete(exits, true)) {
    return exits;
  }
  return first;
}

// The type of a slot the lambda lift filled with a closure constructor:
// `let $lamret$0 = __mkclo$<body>(caps)` names the hoisted body, whose
// contract says what the function value hands out. The checker types the
// constructor as nothing, so a slot with no annotation of its own is typed
// here off the body's contract, and is unchecked until that contract lands.
function closure_slot_type(init: ast.Expr, contracts: ssasem.Contract[]): typeinfo.Type {
  if let ast.ExprCall(c) = init {
    if let ast.ExprIdent(id) = c.callee {
      let body: string = parser.mkclo_body(id.name);
      if (body.len() == 0) {
        return typeinfo.unchecked();
      }
      let at: i32 = ssasem.find_contract_in(contracts, body);
      if (at < 0) {
        return typeinfo.unchecked();
      }
      let contract: ssasem.Contract = contracts[at];
      if (!ssasem.closure_env(contract) || ssasem.contract_variables(contract).len() > 0) {
        return typeinfo.unchecked();
      }
      return ssasem.closure_type(contract);
    }
  }
  return typeinfo.unchecked();
}

// The initializer of the binding `name` declares in `body`, at any depth, or
// an unknown expression when no statement declares it.
function slot_init(body: ast.Stmt[], name: string): ast.Expr {
  for st in body {
    if let ast.StmtVar(v) = st {
      if (v.name == name) {
        return v.init;
      }
    }
    if let ast.StmtIf(f) = st {
      let then_init: ast.Expr = slot_init(f.then_body, name);
      if (!is_unknown_expr(then_init)) {
        return then_init;
      }
      let else_init: ast.Expr = slot_init(f.else_body, name);
      if (!is_unknown_expr(else_init)) {
        return else_init;
      }
    }
    if let ast.StmtMatch(m) = st {
      for arm in m.arms {
        let arm_init: ast.Expr = slot_init(arm.body, name);
        if (!is_unknown_expr(arm_init)) {
          return arm_init;
        }
      }
    }
  }
  return parser.e_unknown("no such slot");
}

function is_unknown_expr(e: ast.Expr): boolean {
  if let ast.ExprUnknown(_) = e {
    return true;
  }
  return false;
}

// A closure constructor is not a call of the body it names, though a body
// hoisted out of a `$iife` one carries that spelling.
function calls_synthesised(e: ast.Expr): boolean {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      return synthesised_name(id.name) && parser.mkclo_body(id.name).len() == 0;
    }
  }
  return false;
}

// A synthesised declaration returning the CALL of another — a value-position
// if/match whose arm is itself one — is typed off the callee's CONTRACT, not
// off the checker: the checker types a call from the callee's declaration,
// and a synthesised declaration's tag is the guess this table exists to
// correct, whether it reads as the coarse `fn` or as a concrete `i32`. The
// contract is the callee's body's answer; `contracts` builds the table to a
// fixpoint so the inner declaration's is there when the outer one is read,
// and until it is, the result is UNCHECKED rather than the checker's guess:
// a contract recorded from the guess on the first pass would never be
// revisited, since the fixpoint only fills what is missing. A body lifted
// out of a template spells its variables as the template does, so an instance
// reads the callee's result under its own binding.
function called_synthesised_result(e: ast.Expr, contracts: ssasem.Contract[], b: ssasem.Binding): typeinfo.Type {
  if let ast.ExprCall(c) = e {
    if let ast.ExprIdent(id) = c.callee {
      let at: i32 = ssasem.find_contract_in(contracts, id.name);
      if (at >= 0) {
        return ssasem.substitute(contracts[at].result, b);
      }
    }
  }
  return typeinfo.unchecked();
}

// Whether a declared result the body seems to contradict is an annotation
// the checker verified rather than a guess. A hoisted lambda keeps whatever
// its `ret_type` was, the author's annotation and `if_expr_rt`'s reading
// alike, and the checker refuses an annotation the body contradicts (E002)
// — except for a bare numeric literal, which adapts to the annotation it is
// returned under. So a literal returned under a numeric tag is the one shape
// where the tag stands over the literal's own default type.
function literal_adapts(returned: ast.Expr, declared: typeinfo.Type): boolean {
  if let ast.ExprNumber(_) = returned {
    return ssasem.is_integer(declared) || ssasem.is_float(declared);
  }
  return false;
}

// A declaration the lowering synthesised: a lambda `lift` lifted to a
// `__lam_N` body, or a value-position if/match it hoisted to a `$iife` one.
// Its result tag is `parser.if_expr_rt`'s reading of the first arm's SYNTAX,
// which answers "i32" for any arm it cannot classify — a call, a record
// literal, a nested match — and the checker never verified it, since the
// desugar ran before the check. The tag is a guess; the body is the authority.
function synthesised(fd: parser.FuncDecl): boolean {
  return synthesised_name(fd.name);
}

function synthesised_name(name: string): boolean {
  return util.str_has_prefix(name, "__lam_") || util.contains(name, "$iife");
}

function result_type(fd: parser.FuncDecl, scope: checker.Scope, b: ssasem.Binding, contracts: ssasem.Contract[]): typeinfo.Type {
  if (fd.ret_type.len() == 0) {
    return inferred_result(fd, scope, b, contracts);
  }
  let declared: typeinfo.Type = resolved(scope.ret_type, generic_decl(fd), b, scope);
  if (synthesised(fd)) {
    let (returned, _) = checker.first_returned(fd.body, scope);
    if (!literal_adapts(returned, declared)) {
      let body: typeinfo.Type = inferred_result(fd, scope, b, contracts);
      if (semtypes.concrete(body, true) && !is_void(body)) {
        return body;
      }
      // A body returning a synthesised call has no answer until that
      // callee's contract lands; the tag is not the answer meanwhile.
      if (calls_synthesised(returned)) {
        return body;
      }
    }
  }
  // A coarse fn tag with no contract has nothing for the checker to resolve,
  // so the declaration is refused for an unresolved result type — but the
  // body still says what it returns, and that is the same inference an
  // unannotated declaration above already relies on. The tag itself stays:
  // hoist_value_iife declares it deliberately and closure_ret_fns_of is gated
  // on it, so only the unresolved RESULT is filled in here.
  if (!semtypes.concrete(declared, true) && coarse_fn_tag_without_contract(fd)) {
    return inferred_result(fd, scope, b, contracts);
  }
  return declared;
}

// A closure body's first parameter is the environment the lift hoisted it
// with: `__env`, declared as a bare word array and read at the top of the body
// as `let cap: T = __env[1 + i]`, one capture per slot in slot order. Those
// leading reads name the captures, so the parameter is typed as the
// environment record they describe (`semtypes.is_env`), and a body reading no
// capture keeps the bare array.
function is_closure_body(fd: parser.FuncDecl): boolean {
  return !has_receiver(fd) && fd.params.len() > 0 && fd.params[0].name == "__env";
}

function reads_env_slot(e: ast.Expr, slot: i32): boolean {
  if let ast.ExprIndex(ix) = e {
    if let ast.ExprIdent(id) = ix.array {
      if let ast.ExprNumber(n) = ix.index {
        return id.name == "__env" && n.text == util.i32_to_string(slot);
      }
    }
  }
  return false;
}

function env_captures(fd: parser.FuncDecl, scope: checker.Scope, template: boolean, b: ssasem.Binding): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let at: checker.Scope = scope;
  for st in fd.body {
    let read: boolean = false;
    if let ast.StmtVar(v) = st {
      if (reads_env_slot(v.init, out.len() + 1)) {
        read = true;
        at = checker.bind_stmt(st, at);
        out = out.append(resolved(checker.scope_type(at, v.name), template, b, at));
      }
    }
    if (!read) {
      return out;
    }
  }
  return out;
}

function env_type(fd: parser.FuncDecl, scope: checker.Scope, template: boolean, b: ssasem.Binding, name: string): typeinfo.Type {
  let caps: typeinfo.Type[] = env_captures(fd, scope, template, b);
  if (caps.len() == 0) {
    return typeinfo.TypeArray { elem: t_i32(), view: false };
  }
  return ssasem.env_type(name, caps);
}

function parameters(fd: parser.FuncDecl, s: State): State {
  let names: string[] = decl_param_names(fd);
  let at: i32 = 0;
  while (at < names.len()) {
    let ty: typeinfo.Type = bound_type(s, names[at], s.scope);
    if (at == 0 && is_closure_body(fd)) {
      ty = env_type(fd, s.scope, s.template, s.binding, s.name);
    }
    if (!semtypes.concrete(ty, true)) {
      return fail(s, "unresolved parameter type");
    }
    let m: i32 = decl_param_mode(fd, at, ty);
    let p: Value = define(s, 6, [], at, "", ty);
    s = bind(State { ...p.s, modes: p.s.modes.append(m) }, names[at], p.id);
    at = at + 1;
  }
  return s;
}

function refuse(why: string): Produced {
  let graph: ssa.SFunc = ssa.SFunc { name: "", nparams: 0, nvals: 0, blocks: [], entry: 0, takes_env: false };
  return Produced { ok: false, why: why, func: ssasem.Func { graph: graph, values: [], params: [], result: t_void(), records: semrecords.no_records(), enums: [], calls: [], envs: [], anchors: [], dyns: [], shadows: [], finalizers: [], map_module: false, dbg_vals: [], dbg_names: [] }, modes: [], template: false, key: "", requests: [], bodyless: false, analysis: None, view_escape: 0 };
}

function initial(fd: parser.FuncDecl, scope: checker.Scope, contracts: ssasem.Contracts, binding: ssasem.Binding, name: string, handers: util.NameIndex, shadows: string[], views: string[], funcs: parser.FuncDecl[], impls: parser.ImplInfo[], debug_lines: boolean): State {
  let entry: ssa.SBlock = ssa.SBlock { id: 0, insts: [], term: t_none(), preds: [] };
  return State {
    ok: true, why: "", blocks: [], cur: entry, live: true, next_block: 1, values: [],
    names: [], vals: [], scope: scope, result: result_type(fd, scope, binding, contracts.list), loops: [], contracts: contracts, calls: [],
    template: generic_decl(fd), binding: binding, requests: [], foreign: [], handers: handers, shadows: shadows, views: views,
    name: name, modes: [], funcs: funcs, impls: impls, try_cleanup: try_cleanup(fd.body), replaying: false, escaping: escaping_bindings(fd.body), learned: [], learned_types: [],
    debug_lines: debug_lines, dbg_vals: [], dbg_names: [],
  };
}

// Every read or write of a name, one entry per use.
function name_uses(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtAssign(a) = st {
    return acc.append(a.target);
  }
  return acc;
}

function ident_uses(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprIdent(id) = e {
    return acc.append(id.name);
  }
  return acc;
}

function descend_all(e: ast.Expr): boolean {
  return true;
}

function uses_in(stmts: ast.Stmt[], own acc: string[]): string[] {
  for st in stmts {
    acc = astwalk.fold_stmt_nodes(st, acc, name_uses, ident_uses, descend_all);
  }
  return acc;
}

// Each pattern binding, as `=name`, then one entry per use of it inside the
// arm that binds it.
function arm_local_uses(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtMatch(m) = st {
    for a in m.arms {
      if let ast.PatVariant(pv) = a.pattern {
        let local: string[] = uses_in(a.body, []);
        if (a.has_guard) {
          local = astwalk.fold_expr_nodes(a.guard, local, name_uses, ident_uses, descend_all);
        }
        let names: string[] = [pv.binding];
        for n in pv.extra_bindings {
          names = names.append(n);
        }
        for n in names {
          if (n == "" || n == "_") {
            continue;
          }
          acc = acc.append("=" + n);
          for u in local {
            if (u == n) {
              acc = acc.append(n);
            }
          }
        }
      }
    }
  }
  return acc;
}

// A `for` header's bindings, nested ones included, are local to its body.
function for_local_uses(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtFor(fr) = st {
    let local: string[] = uses_in(fr.body, []);
    for n in header_names(fr.var_name) {
      if (n == "" || n == "_") {
        continue;
      }
      acc = acc.append("=" + n);
      for u in local {
        if (u == n) {
          acc = acc.append(n);
        }
      }
    }
  }
  return acc;
}

function header_names(encoded: string): string[] {
  let out: string[] = [];
  for n in checker.split_pattern_names(encoded) {
    if (n.len() > 1 && n[0] == b'(') {
      for m in header_names(slice_unchecked(n, 1, n.len() - 1) + "") {
        out = out.append(m);
      }
    } else {
      out = out.append(n);
    }
  }
  return out;
}

// A `let` the desugar could not lift (it has no annotation to zero) is local
// to the statements that follow it in its own list.
function var_local_uses(st: ast.Stmt, own acc: string[]): string[] {
  if let ast.StmtIf(f) = st {
    acc = list_var_uses(f.then_body, acc);
    acc = list_var_uses(f.else_body, acc);
  }
  if let ast.StmtWhile(w) = st {
    acc = list_var_uses(w.body, acc);
  }
  if let ast.StmtFor(fr) = st {
    acc = list_var_uses(fr.body, acc);
  }
  if let ast.StmtMatch(m) = st {
    for a in m.arms {
      acc = list_var_uses(a.body, acc);
    }
  }
  return acc;
}

function lambda_var_uses(e: ast.Expr, own acc: string[]): string[] {
  if let ast.ExprLambda(l) = e {
    return list_var_uses(l.body, acc);
  }
  return acc;
}

function list_var_uses(stmts: ast.Stmt[], own acc: string[]): string[] {
  let names: string[] = [];
  for st in stmts {
    if let ast.StmtVar(v) = st {
      if (!destructures(v)) {
        names = names.append(v.name);
      }
    }
  }
  if (names.len() == 0) {
    return acc;
  }
  for n in names {
    acc = acc.append("=" + n);
  }
  // Counting the whole list, not just what follows each `let`, can only add
  // in-list uses, so it never marks a binding escaping; a defer replay's use
  // sits in an enclosing list either way.
  let ix: util.NameIndex = util.name_index(names);
  for u in uses_in(stmts, []) {
    if (ix.has(u)) {
      acc = acc.append(u);
    }
  }
  return acc;
}

function keep_names(e: ast.Expr, own acc: string[]): string[] {
  return acc;
}

// The pattern bindings used outside the arm or loop that binds them, and the
// `let`s used outside the statements that follow them. Lexical resolution gives every
// binding a symbol of its own, so such a use can only be the defer desugar's
// replay of an action the scope armed.
function escaping_bindings(body: ast.Stmt[]): string[] {
  let local: string[] = list_var_uses(body, []);
  for st in body {
    local = astwalk.fold_stmt_nodes(st, local, arm_local_uses, keep_names, descend_all);
    local = astwalk.fold_stmt_nodes(st, local, for_local_uses, keep_names, descend_all);
    local = astwalk.fold_stmt_nodes(st, local, var_local_uses, lambda_var_uses, descend_all);
  }
  if (local.len() == 0) {
    return [];
  }
  let all: string[] = uses_in(body, []);
  let out: string[] = [];
  for d in local {
    if (d.len() < 2 || d[0] != b'=') {
      continue;
    }
    let n: string = slice_unchecked(d, 1, d.len()) + "";
    if (util.index_of_str(out, n) < 0 && count_of(all, n) > count_of(local, n)) {
      out = out.append(n);
    }
  }
  return out;
}

function count_of(xs: string[], name: string): i32 {
  let n: i32 = 0;
  for x in xs {
    if (x == name) {
      n = n + 1;
    }
  }
  return n;
}

// The desugar leaves the cleanup a `?` exit owes behind two always-false
// guards at the top level of the body, plain defers first, then errdefers.
function try_cleanup(body: ast.Stmt[]): ast.Stmt[] {
  let out: ast.Stmt[] = [];
  for st in body {
    if let ast.StmtIf(f) = st {
      if let ast.ExprIdent(id) = f.cond {
        if (id.name == "__dfa_tryall" || id.name == "__dfa_tryerr") {
          for c in f.then_body {
            out = out.append(c);
          }
        }
      }
    }
  }
  return out;
}

// ---- record schemas ---------------------------------------------------------

// The module's declared records and unions whose values hold a `str` view, by
// name, and its function types that do, as `fn <type_key>`, to a fixpoint over
// the declaration tables every scope shares and the contract table. Asked once
// per module; each schema entry then carries its answer, so a value's question
// stops at the first record or enum it meets rather than walking a declaration
// graph again (`ssasem.holds_view`).
function view_types(scope: checker.Scope, impls: parser.ImplInfo[], contracts: ssasem.Contracts): string[] {
  let names: string[] = [];
  // Each closure body's function-type key and captures, which no round of the
  // fixpoint changes.
  let fn_keys: string[] = [];
  let fn_captures: typeinfo.Type[][] = [];
  for c in contracts.list {
    if (c.params.len() == 0 || !semtypes.is_env(c.params[0])) {
      continue;
    }
    fn_keys = fn_keys.append(func_view_key(ssasem.closure_type(c)));
    fn_captures = fn_captures.append(semtypes.env_captures(c.params[0]));
  }
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for sig in scope.structs.structs {
      if (sig.type_params.len() > 0 || util.index_of_str(names, sig.name) >= 0) {
        continue;
      }
      if (types_hold_view(sig.field_types, names, impls)) {
        names = names.append(sig.name);
        changed = true;
      }
    }
    for sig in scope.structs.structs {
      if (sig.enum_owner.len() > 0 && util.index_of_str(names, sig.name) >= 0 && util.index_of_str(names, sig.enum_owner) < 0) {
        names = names.append(sig.enum_owner);
        changed = true;
      }
    }
    // A function type holds a view when a closure of that type captures
    // one, however deep in a captured record: its environment is its
    // contract's first parameter, whose type arguments are the captures.
    let k: i32 = 0;
    while (k < fn_keys.len()) {
      if (util.index_of_str(names, fn_keys[k]) < 0 && types_hold_view(fn_captures[k], names, impls)) {
        names = names.append(fn_keys[k]);
        changed = true;
      }
      k = k + 1;
    }
    for u in scope.unions.unions {
      if (util.index_of_str(names, u.name) >= 0) {
        continue;
      }
      for v in u.variants {
        if (util.index_of_str(names, v) >= 0 && util.index_of_str(names, u.name) < 0) {
          names = names.append(u.name);
          changed = true;
        }
      }
    }
  }
  return names;
}

// A function type's entry in `view_types`' answer, which no declaration name
// can spell. `type_key` is a conservative identity, not an exact one: it
// collapses some leaf types, so distinct function types can share an answer,
// and only ever toward holding a view.
function func_view_key(t: typeinfo.Type): string {
  return "fn " + ssasem.type_key(t);
}

function fields_hold_view(fields: semrecords.Field[], views: string[], impls: parser.ImplInfo[]): boolean {
  for fl in fields {
    if (type_holds_view(fl.ty, views, impls)) {
      return true;
    }
  }
  return false;
}

function types_hold_view(ts: typeinfo.Type[], views: string[], impls: parser.ImplInfo[]): boolean {
  for t in ts {
    if (type_holds_view(t, views, impls)) {
      return true;
    }
  }
  return false;
}

// A type's views through its structure, with a record or union answered by
// name from `views`, a dyn by the types implementing its traits (a generic's by
// its clones, `W__string`), and a function type by whether a closure of that
// type captures one (`view_types`).
function type_holds_view(t: typeinfo.Type, views: string[], impls: parser.ImplInfo[]): boolean {
  if let typeinfo.TypeString(st) = t {
    return st.tag == 1;
  }
  if let typeinfo.TypeArray(a) = t {
    return a.view || type_holds_view(a.elem, views, impls);
  }
  if let typeinfo.TypeTuple(tup) = t {
    return types_hold_view(tup.elements, views, impls);
  }
  if (semtypes.is_cell(t)) {
    return type_holds_view(semtypes.cell_elem(t), views, impls);
  }
  if let typeinfo.TypeMap(m) = t {
    return type_holds_view(m.key, views, impls) || type_holds_view(m.value, views, impls);
  }
  if let typeinfo.TypeStruct(r) = t {
    return util.index_of_str(views, r.name) >= 0 || types_hold_view(r.args, views, impls);
  }
  if let typeinfo.TypeUnion(u) = t {
    return util.index_of_str(views, u.name) >= 0 || types_hold_view(u.args, views, impls);
  }
  if (ssasem.is_func(t)) {
    return util.index_of_str(views, func_view_key(t)) >= 0;
  }
  if (ssasem.is_dyn(t)) {
    for n in dyn_impl_names(t, impls) {
      for v in views {
        if (v == n || util.str_has_prefix(v, n + "__")) {
          return true;
        }
      }
    }
  }
  return false;
}

// SchemaMemo is every record and enum schema the module's functions have
// reached so far. An entry is a property of the type and of the module's
// declarations, not of the function whose walk reached it, so one function's
// walk hands the next its entries and a schema is read off the declarations
// once per module.
struct SchemaMemo { records: semrecords.Record[], record_names: util.NameIndex, enums: semrecords.Enum[] }

function no_memo(): SchemaMemo {
  let none: string[] = [];
  return SchemaMemo { records: [], record_names: util.name_index(none), enums: [] };
}

// `memo` is the module's memo as the walk leaves it. Every entry the walk
// appends is a memo entry, so `seen_r[i]` / `seen_e[i]` say whether memo
// entry `i` is in `records` / `enums`: presence is a bit, not a lookup.
struct Schemas { ok: boolean, why: string, records: semrecords.Record[], enums: semrecords.Enum[], memo: SchemaMemo, seen_r: boolean[], seen_e: boolean[] }

function no_flags(n: i32): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(false);
    i = i + 1;
  }
  return out;
}

// Every record and enum type a function's values, contracts and result name
// gets its declaration's schema, and so does every one a schema's fields
// name, to a fixpoint over the finite declaration table. A type this
// boundary cannot give a schema refuses the function.
function schemas(types: typeinfo.Type[], s: State, memo: SchemaMemo): Schemas {
  let out: Schemas = Schemas { ok: true, why: "", records: [], enums: [], memo: memo, seen_r: no_flags(memo.records.len()), seen_e: no_flags(memo.enums.len()) };
  let pending: typeinfo.Type[] = types;
  let i: i32 = 0;
  while (i < pending.len()) {
    let nr: i32 = out.records.len();
    let ne: i32 = out.enums.len();
    out = schema_of(pending[i], s, out);
    if (!out.ok) {
      return out;
    }
    pending = named_by_schemas(out, nr, ne, pending);
    i = i + 1;
  }
  return out;
}

// named_by_schemas queues the field types of the records and enums added
// since `nr` and `ne` that schema_of can walk into or record; a scalar or a
// string names no schema, and schema_of hands it back unchanged.
function named_by_schemas(out: Schemas, nr: i32, ne: i32, pending: typeinfo.Type[]): typeinfo.Type[] {
  while (nr < out.records.len()) {
    for field in out.records[nr].fields {
      if (names_schema(field.ty)) {
        pending = pending.append(field.ty);
      }
    }
    nr = nr + 1;
  }
  while (ne < out.enums.len()) {
    for v in out.enums[ne].variants {
      for field in v.fields {
        if (names_schema(field.ty)) {
          pending = pending.append(field.ty);
        }
      }
    }
    ne = ne + 1;
  }
  return pending;
}

function names_schema(t: typeinfo.Type): boolean {
  if let typeinfo.TypeArray(_) = t {
    return true;
  }
  if let typeinfo.TypeTuple(_) = t {
    return true;
  }
  if let typeinfo.TypeMap(_) = t {
    return true;
  }
  if let typeinfo.TypeFunc(_) = t {
    return true;
  }
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  if let typeinfo.TypeUnion(_) = t {
    return true;
  }
  return false;
}

// Structural types name records inside them; a nominal type is its own.
function schema_of(t: typeinfo.Type, s: State, out: Schemas): Schemas {
  if let typeinfo.TypeArray(a) = t {
    return schema_of(a.elem, s, out);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for elem in tup.elements {
      out = schema_of(elem, s, out);
      if (!out.ok) {
        return out;
      }
    }
    return out;
  }
  if (semtypes.is_cell(t)) {
    return schema_of(semtypes.cell_elem(t), s, out);
  }
  // A map cursor has no layout of its own to record either — its block is the
  // map's address and an index — but the columns it reads do, so the walk
  // goes through to its key and value.
  if (semtypes.is_map_iter(t)) {
    out = schema_of(semtypes.map_iter_key(t), s, out);
    if (!out.ok) {
      return out;
    }
    return schema_of(semtypes.map_iter_value(t), s, out);
  }
  if let typeinfo.TypeMap(m) = t {
    out = schema_of(m.key, s, out);
    if (!out.ok) {
      return out;
    }
    return schema_of(m.value, s, out);
  }
  // A function value's signature names the records its calls take and hand
  // back, which a record holding one reaches through the field.
  if let typeinfo.TypeFunc(fn) = t {
    for p in fn.param_types {
      out = schema_of(p, s, out);
      if (!out.ok) {
        return out;
      }
    }
    return schema_of(fn.ret_type, s, out);
  }
  if let typeinfo.TypeStruct(r) = t {
    // A stream handle is its descriptor, not a box: it has no layout to
    // record and nothing to walk.
    if (semtypes.is_handle(t)) {
      return out;
    }
    let mr: i32 = semrecords.find_named(out.memo.records, out.memo.record_names, r.name, t);
    if (mr >= 0) {
      if (out.seen_r[mr]) {
        return out;
      }
      return with_known_record(out, mr);
    }
    if (semtypes.is_env(t)) {
      return env_entry(t, s.views, s.impls, out);
    }
    return record_entry(t, r, s, out);
  }
  if let typeinfo.TypeUnion(u) = t {
    let me: i32 = semrecords.find_enum(out.memo.enums, t);
    if (me >= 0) {
      if (out.seen_e[me]) {
        return out;
      }
      return enum_members(out.memo.enums[me], s, with_known_enum(out, me));
    }
    return enum_entry(t, u, s, out);
  }
  return out;
}

// with_known_record is `out` with memo entry `at` appended.
function with_known_record(out: Schemas, at: i32): Schemas {
  return Schemas { ...out, records: out.records.append(out.memo.records[at]), seen_r: out.seen_r.with(at, true) };
}

// with_new_record is `out` with `rec`, just read off its declaration,
// appended and in the memo, at the memo's end, which is where `seen_r`
// grows.
function with_new_record(out: Schemas, rec: semrecords.Record): Schemas {
  let name: string = semrecords.name_of(rec.ty);
  return Schemas { ...out, records: out.records.append(rec), seen_r: out.seen_r.append(true), memo: SchemaMemo { ...out.memo, records: out.memo.records.append(rec), record_names: out.memo.record_names.added(name) } };
}

function with_known_enum(out: Schemas, at: i32): Schemas {
  return Schemas { ...out, enums: out.enums.append(out.memo.enums[at]), seen_e: out.seen_e.with(at, true) };
}

function with_new_enum(out: Schemas, e: semrecords.Enum): Schemas {
  return Schemas { ...out, enums: out.enums.append(e), seen_e: out.seen_e.append(true), memo: SchemaMemo { ...out.memo, enums: out.memo.enums.append(e) } };
}

// A member's box is read through its own record, so the table must carry
// one whether or not any value in this function has the member's type.
function enum_members(e: semrecords.Enum, s: State, out: Schemas): Schemas {
  if (e.layout != semrecords.layout_member()) {
    return out;
  }
  for v in e.variants {
    out = schema_of(typeinfo.TypeStruct { name: v.name, args: [] }, s, out);
    if (!out.ok) {
      return out;
    }
  }
  return out;
}

function fields_resolved(sig: checker.StructSig): boolean {
  for t in sig.field_types {
    if (!semtypes.concrete(t, false)) {
      return false;
    }
  }
  return true;
}

function fields_of(sig: checker.StructSig): semrecords.Field[] {
  let fields: semrecords.Field[] = [];
  let i: i32 = 0;
  while (i < sig.field_names.len()) {
    fields = fields.append(semrecords.Field { name: sig.field_names[i], ty: sig.field_types[i] });
    i = i + 1;
  }
  return fields;
}

// An environment's schema is its type: the address word, then one field per
// capture, named by its slot the way `environment_read` projects it.
function env_entry(t: typeinfo.Type, views: string[], impls: parser.ImplInfo[], out: Schemas): Schemas {
  let fields: semrecords.Field[] = [semrecords.Field { name: "code", ty: t_i32() }];
  let i: i32 = 0;
  for cap in semtypes.env_captures(t) {
    i = i + 1;
    fields = fields.append(semrecords.Field { name: "c" + util.i32_to_string(i), ty: cap });
  }
  return with_new_record(out, semrecords.Record { ty: t, fields: fields, views: fields_hold_view(fields, views, impls) });
}

function record_entry(t: typeinfo.Type, r: typeinfo.TypeStruct, s: State, out: Schemas): Schemas {
  let sig: checker.StructSig = record_sig(t, s);
  if (sig.name.len() == 0) {
    return Schemas { ...out, ok: false, why: "unsupported record type" };
  }
  if (!fields_resolved(sig)) {
    return Schemas { ...out, ok: false, why: "unresolved record field type" };
  }
  return with_new_record(out, semrecords.Record { ty: t, fields: fields_of(sig), views: type_holds_view(t, s.views, s.impls) });
}

// A union is a declared enum, whose variants it owns, or a struct-union, whose
// members are declared on their own. The layout says which, and a mixture has
// no layout this boundary can give.
function enum_entry(t: typeinfo.Type, u: typeinfo.TypeUnion, s: State, out: Schemas): Schemas {
  let layout: i32 = union_layout(s, u.name);
  if (layout == semrecords.layout_option()) {
    return builtin_enum_entry(t, s, out);
  }
  let names: string[] = union_variants(s, u.name);
  if (names.len() == 0 || u.args.len() > 0 || layout == 0) {
    return Schemas { ...out, ok: false, why: "unsupported enum type" };
  }
  let variants: semrecords.Variant[] = [];
  for name in names {
    let vs: checker.StructSig = checker.variant_shape_sig(s.scope, name, u.name);
    if (!fields_resolved(vs)) {
      return Schemas { ...out, ok: false, why: "unresolved variant field type" };
    }
    variants = variants.append(semrecords.Variant { name: name, fields: fields_of(vs) });
  }
  let e: semrecords.Enum = semrecords.Enum { ty: t, variants: variants, layout: layout, views: util.index_of_str(s.views, u.name) >= 0 };
  return enum_members(e, s, with_new_enum(out, e));
}

// A builtin union is its instantiation: `Option` with no argument names no
// payload and so has no schema. A payload wider than the narrow slot rides the
// box's wide form — `op_opt_make_w` / `op_opt_payload_w`, which every backend
// carries and the AST lowering already used — chosen from the payload at each
// site, so a mixed `Result[i64, string]` writes its Ok wide and its Err, a
// pointer, narrow (ssarc.wide_payload).
function builtin_enum_entry(t: typeinfo.Type, s: State, out: Schemas): Schemas {
  let variants: semrecords.Variant[] = builtin_variants(t);
  if (variants.len() == 0) {
    return Schemas { ...out, ok: false, why: "unsupported enum type" };
  }
  for v in variants {
    for field in v.fields {
      if (!semtypes.concrete(field.ty, false)) {
        return Schemas { ...out, ok: false, why: "unresolved variant field type" };
      }
    }
  }
  let views: boolean = false;
  for v in variants {
    if (fields_hold_view(v.fields, s.views, s.impls)) {
      views = true;
    }
  }
  return with_new_enum(out, semrecords.Enum { ty: t, variants: variants, layout: semrecords.layout_option(), views: views });
}

// A frame that merely HOLDS a function value never built the box, so its own
// graph names no environment — yet its release still has to walk the captures.
// ssarc matches a box at run time against the environments this schema table
// names, so every environment a value of this type could carry has to be in
// it. A closure body's contract takes its environment as parameter 0, and
// closure_type spells the function value it presents; a body spelling a
// different function value can never be in the box, so it is left out and the
// run-time match never sees it. A body hoisted out of a generic is a template
// the table holds once; the instance whose closure type is `t` is the one a box
// of that type can carry, whichever frame built it.
function env_rows(named: typeinfo.Type[], envs: ssasem.Contract[]): ssasem.EnvRow[] {
  let out: ssasem.EnvRow[] = [];
  for t in named {
    if (!ssasem.is_func(t)) {
      continue;
    }
    for c in envs {
      let env: typeinfo.Type = env_serving(c, t);
      if (semtypes.is_env(env) && !has_env_row(out, t, env)) {
        out = out.append(ssasem.EnvRow { fn_ty: t, env_ty: env });
      }
    }
  }
  return out;
}

// env_serving is the environment of `c` — or of its instance — that presents
// the function value `t`, or an unchecked type when none does.
function env_serving(c: ssasem.Contract, t: typeinfo.Type): typeinfo.Type {
  if (semtypes.equal(ssasem.closure_type(c), t)) {
    return c.params[0];
  }
  let vars: string[] = ssasem.contract_variables(c);
  if (vars.len() == 0) {
    return typeinfo.unchecked();
  }
  let b: ssasem.Binding = ssasem.bind_type(ssasem.unbound(), ssasem.closure_type(c), t);
  if (!b.ok || !ssasem.binds_all(b, vars)) {
    return typeinfo.unchecked();
  }
  let inst: ssasem.Contract = ssasem.instantiate_contract(c, b, vars);
  if (!semtypes.equal(ssasem.closure_type(inst), t)) {
    return typeinfo.unchecked();
  }
  return inst.params[0];
}

// The rows of every function type the schema table reaches, with the table
// that results. A function type reachable only through a record or enum field
// -- or nested in an array, tuple, Map or Cell one of them holds -- gets its
// rows too, and each row's environment is a record whose captures the walk
// then reaches, so the two close together. The chain a helper walks is a
// property of the type and of the module, not of how the frame emitting the
// helper happens to reach the type: a frame that constructs the closure and
// one that only drops the record holding it emit the same helper (#9804).
// A dyn type reached closes the same way, over the concretes it can hold.
struct Closed { rows: ssasem.EnvRow[], dyns: ssasem.EnvRow[], table: Schemas }

function env_rows_closed(named: typeinfo.Type[], s: State, memo: SchemaMemo): Closed {
  let rows: ssasem.EnvRow[] = [];
  let drows: ssasem.EnvRow[] = [];
  let table: Schemas = schemas(named, s, memo);
  while (table.ok) {
    let reach: typeinfo.Type[] = [];
    let dreach: typeinfo.Type[] = [];
    for t in named_by_schemas(table, 0, 0, named) {
      reach = func_types_in(t, reach);
      dreach = dyn_types_in(t, dreach);
    }
    let grown: boolean = false;
    for row in env_rows(reach, s.contracts.envs) {
      if (has_env_row(rows, row.fn_ty, row.env_ty)) {
        continue;
      }
      rows = rows.append(row);
      named = named.append(row.env_ty);
      grown = true;
    }
    for t in dreach {
      for c in dyn_concretes(t, s) {
        if (has_env_row(drows, t, c)) {
          continue;
        }
        drows = drows.append(ssasem.EnvRow { fn_ty: t, env_ty: c });
        named = named.append(c);
        grown = true;
      }
    }
    if (!grown) {
      break;
    }
    table = schemas(named, s, table.memo);
  }
  return Closed { rows: rows, dyns: drows, table: table };
}

// The dyn types a type carries, itself included, through the containers a
// release walks into.
function dyn_types_in(t: typeinfo.Type, out: typeinfo.Type[]): typeinfo.Type[] {
  if (ssasem.is_dyn(t)) {
    return out.append(t);
  }
  if let typeinfo.TypeArray(a) = t {
    return dyn_types_in(a.elem, out);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      out = dyn_types_in(e, out);
    }
    return out;
  }
  if (semtypes.is_cell(t)) {
    return dyn_types_in(semtypes.cell_elem(t), out);
  }
  if let typeinfo.TypeMap(m) = t {
    return dyn_types_in(m.value, dyn_types_in(m.key, out));
  }
  if let typeinfo.TypeUnion(u) = t {
    for a in u.args {
      out = dyn_types_in(a, out);
    }
  }
  return out;
}

// The records, enums and strings a dyn value of type `t` can be holding: every
// one the module implements each trait of the set for. A scalar's box has no
// children. A generic declaration's instances are the clones monomorphisation
// made of it (`W__string`), which replace it.
function dyn_concretes(t: typeinfo.Type, s: State): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for n in dyn_impl_names(t, s.impls) {
    if (n == "string") {
      out = out.append(t_string());
    } else if (record_schema(n, s).name.len() > 0) {
      out = out.append(typeinfo.TypeStruct { name: n, args: [] });
    } else if (union_layout(s, n) == semrecords.layout_variant()) {
      out = out.append(typeinfo.TypeUnion { name: n, args: [] });
    } else if (erased_generic(n, s)) {
      for c in generic_clones(n, s) {
        out = out.append(c);
      }
    }
  }
  return out;
}

// The base names of every type the module implements each trait of `t`'s set
// for, an impl for `str` named `string` as the receiver it is keyed by.
function dyn_impl_names(t: typeinfo.Type, impls: parser.ImplInfo[]): string[] {
  let out: string[] = [];
  let traits: string[] = parser.dyn_trait_set(typeinfo.spelling(t));
  if (traits.len() == 0) {
    return out;
  }
  for imp in impls {
    let n: string = parser.receiver_base(imp.impl_type);
    if (parser.impl_trait_key(imp) != util.base_type_name(traits[0]) || util.index_of_str(out, n) >= 0) {
      continue;
    }
    if (implements_traits(impls, n, traits)) {
      out = out.append(n);
    }
  }
  return out;
}

// A base that names no declaration once monomorphisation has run: a generic
// struct, or an enum it could key, replaced by its clones. Option and Result
// have a builtin layout, and a union that keeps its variants is declared.
function erased_generic(n: string, s: State): boolean {
  return checker.struct_sig(s.scope, n).name.len() == 0 && union_layout(s, n) == 0 && union_variants(s, n).len() == 0;
}

// The clones monomorphisation made of generic `base`: records and enums named
// `base__…`.
function generic_clones(base: string, s: State): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  let prefix: string = base + "__";
  for sig in s.scope.structs.structs {
    let t: typeinfo.Type = typeinfo.TypeStruct { name: sig.name, args: [] };
    if (util.str_has_prefix(sig.name, prefix) && record_schema(sig.name, s).name.len() > 0 && !has_type(out, t)) {
      out = out.append(t);
    }
  }
  for u in s.scope.unions.unions {
    let t: typeinfo.Type = typeinfo.TypeUnion { name: u.name, args: [] };
    if (util.str_has_prefix(u.name, prefix) && union_layout(s, u.name) == semrecords.layout_variant() && !has_type(out, t)) {
      out = out.append(t);
    }
  }
  return out;
}

// The builtin names a module declaration takes over: any free function, and a
// string method only when std/string is not loaded. std/string's own methods
// are what the runtime helpers stand in for, and native rejects a second
// declaration of one beside them (E006).
// The types an `impl mem.Drop` gives a finalizer. The trait is matched by its
// simple name, as native's hasDropImpl matches it.
function finalized_types(impls: parser.ImplInfo[]): string[] {
  let out: string[] = [];
  for imp in impls {
    if (imp.trait_name == "Drop") {
      out = out.append(util.base_type_name(imp.impl_type));
    }
  }
  return out;
}

function shadowed_builtins(mod: parser.Module): string[] {
  let out: string[] = [];
  let keys: string[] = [];
  let std_string: boolean = false;
  for im in mod.imports {
    if (im.path == "std/string") {
      std_string = true;
    }
  }
  for fd in mod.funcs {
    if (fd.receiver_type.len() == 0) {
      keys = keys.append(fd.name);
    } else if (!std_string && parser.receiver_base(fd.receiver_type) == "string") {
      keys = keys.append(parser.decl_key(fd));
    }
  }
  for b in builtin_contracts() {
    if (util.index_of_str(keys, b.name) >= 0 && util.index_of_str(out, b.name) < 0) {
      out = out.append(b.name);
    }
  }
  return out;
}

// any_implementer reports whether some type implements every trait of a dyn set.
function any_implementer(impls: parser.ImplInfo[], traits: string[]): boolean {
  for imp in impls {
    if (implements_traits(impls, parser.receiver_base(imp.impl_type), traits)) {
      return true;
    }
  }
  return false;
}

function implements_traits(impls: parser.ImplInfo[], n: string, traits: string[]): boolean {
  for tr in traits {
    let found: boolean = false;
    for imp in impls {
      if (implements_trait(imp, tr) && parser.receiver_base(imp.impl_type) == n) {
        found = true;
      }
    }
    if (!found) {
      return false;
    }
  }
  return true;
}

// Whether `imp` implements the trait a dyn set names as `tr`: the same trait,
// the instantiation `tr` pins by position (`Pair[i32, u32]`) if it pins one,
// and the associated type each `Name = Type` entry pins (`Iter[Item = i32]`).
function implements_trait(imp: parser.ImplInfo, tr: string): boolean {
  if (parser.impl_trait_key(imp) != util.base_type_name(tr)) {
    return false;
  }
  let positional: string[] = [];
  for entry in bracket_entries(tr) {
    let eq: i32 = util.index_of_sub(entry, "=");
    if (eq < 0) {
      positional = positional.append(entry);
    } else if (!pins_assoc(imp, util.trim(slice_unchecked(entry, 0, eq) + ""), slice_unchecked(entry, eq + 1, entry.len()) + "")) {
      return false;
    }
  }
  if (positional.len() == 0) {
    return true;
  }
  let args: string[] = bracket_entries(imp.trait_ref);
  if (args.len() != positional.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < args.len()) {
    if (!same_modulo_spaces(args[i], positional[i])) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// Whether `imp` binds associated type `name` to `value`.
function pins_assoc(imp: parser.ImplInfo, name: string, value: string): boolean {
  let i: i32 = util.index_of_str(imp.assoc_names, name);
  return i >= 0 && same_modulo_spaces(imp.assoc_values[i], value);
}

// The top-level entries of a `Base[a, b]` spelling; none without brackets.
function bracket_entries(t: string): string[] {
  let none: string[] = [];
  let lb: i32 = util.index_of_sub(t, "[");
  if (lb < 0 || t[t.len() - 1] != b']') {
    return none;
  }
  return parser.split_top_commas(slice_unchecked(t, lb + 1, t.len() - 1) + "");
}

function same_modulo_spaces(a: string, b: string): boolean {
  let i: i32 = 0;
  let j: i32 = 0;
  while (true) {
    while (i < a.len() && a[i] == b' ') {
      i = i + 1;
    }
    while (j < b.len() && b[j] == b' ') {
      j = j + 1;
    }
    if (i == a.len() || j == b.len()) {
      return i == a.len() && j == b.len();
    }
    if (a[i] != b[j]) {
      return false;
    }
    i = i + 1;
    j = j + 1;
  }
  return false;
}

// The function types a type carries, itself included, through the containers
// a release walks into.
function func_types_in(t: typeinfo.Type, out: typeinfo.Type[]): typeinfo.Type[] {
  if (ssasem.is_func(t)) {
    return out.append(t);
  }
  if let typeinfo.TypeArray(a) = t {
    return func_types_in(a.elem, out);
  }
  if let typeinfo.TypeTuple(tup) = t {
    for e in tup.elements {
      out = func_types_in(e, out);
    }
    return out;
  }
  if (semtypes.is_cell(t)) {
    return func_types_in(semtypes.cell_elem(t), out);
  }
  if let typeinfo.TypeMap(m) = t {
    return func_types_in(m.value, func_types_in(m.key, out));
  }
  return out;
}

function has_type(ts: typeinfo.Type[], t: typeinfo.Type): boolean {
  for u in ts {
    if (semtypes.equal(u, t)) {
      return true;
    }
  }
  return false;
}

function has_env_row(rows: ssasem.EnvRow[], fn_ty: typeinfo.Type, env_ty: typeinfo.Type): boolean {
  for row in rows {
    if (semtypes.equal(row.fn_ty, fn_ty) && semtypes.equal(row.env_ty, env_ty)) {
      return true;
    }
  }
  return false;
}

function contract_types(calls: ssasem.Contract[]): typeinfo.Type[] {
  let out: typeinfo.Type[] = [];
  for c in calls {
    for t in c.params {
      out = out.append(t);
    }
    out = out.append(c.result);
  }
  return out;
}

// A value-returning body whose end is still live is one the checker proved
// never reaches it (E052): the done-flag chain a nested, tuple, struct or
// literal pattern match desugars to reads as falling through here while
// every arm of it returns. That end aborts rather than returning a value it
// does not have.
// Made is one declaration's production and the schema memo as it leaves it.
struct Made { p: Produced, memo: SchemaMemo }

function complete(fd: parser.FuncDecl, s: State, name: string, memo: SchemaMemo): Made {
  if (!s.ok) {
    return Made { p: refuse(s.why), memo: memo };
  }
  if (s.live && !is_void(s.result)) {
    s = terminate(s, t_unreachable());
  }
  s = terminate(s, t_ret(0 - 1));
  let blocks: ssa.SBlock[] = reachable(s.blocks);
  let map: i32[] = trivial_phis(blocks, s.values.len());
  let f: ssasem.Func = renumber(blocks, map, s.values, s.dbg_vals, s.dbg_names);
  let params: typeinfo.Type[] = [];
  let modes: i32[] = s.modes;
  let at: i32 = 0;
  let nparams: i32 = decl_param_names(fd).len();
  while (at < nparams) {
    params = params.append(f.values[at]);
    at = at + 1;
  }
  let named: typeinfo.Type[] = f.values.append(s.result);
  for t in contract_types(s.calls) {
    named = named.append(t);
  }
  let closed: Closed = env_rows_closed(named, s, memo);
  let table: Schemas = closed.table;
  if (!table.ok) {
    return Made { p: refuse(table.why), memo: table.memo };
  }
  let graph: ssa.SFunc = ssa.SFunc { ...f.graph, name: name, nparams: params.len() };
  f = ssasem.Func { ...f, graph: graph, params: params, result: s.result, records: semrecords.records_of(table.records), enums: table.enums, calls: s.calls, envs: closed.rows, dyns: closed.dyns, shadows: s.shadows, finalizers: finalized_types(s.impls), map_module: s.scope.module_imported("core/map") };
  // Before the verifier in anchor_module, so the rewritten graph is the one
  // it checks, and before anything downstream plans ownership over it (#9692).
  f = ssasem.tail_recursion(f, name);
  f = ssabounds.proven_indices(f);
  return Made { p: Produced { ok: true, why: "", func: f, modes: modes, template: false, key: "", requests: s.requests, bodyless: false, analysis: None, view_escape: 0 }, memo: table.memo };
}

// unresolved_result_spelling names what the refusal failed ON. A type that did
// not resolve has no spelling to report, so printing the resolved type alone
// gave an empty message for every cause at once — which is how `if_expr_rt`
// tagging a boolean branch with the non-existent type name `bool` survived 167
// refusals that all read `unresolved result type: `. The DECLARED spelling is
// the one that identifies the cause, so it is what the message carries when the
// resolved type has none.
function unresolved_result_spelling(fd: parser.FuncDecl, s: State): string {
  let resolved: string = typeinfo.spelling(s.result);
  if (resolved.len() > 0) {
    return resolved;
  }
  if (fd.ret_type.len() > 0) {
    return "declared `" + fd.ret_type + "`";
  }
  return "inferred from the first returned value";
}

// build produces one body's typed semantic graph from its checked declaration,
// the checker's function scope, the module's call contracts and — for a
// template — the instantiation to produce it under, named `name`. Unsupported
// constructs are explicit refusals, never a partial graph.
function build(fd: parser.FuncDecl, scope: checker.Scope, contracts: ssasem.Contracts, binding: ssasem.Binding, name: string, handers: util.NameIndex, shadows: string[], views: string[], funcs: parser.FuncDecl[], impls: parser.ImplInfo[], memo: SchemaMemo, debug_lines: boolean): Made {
  if (fd.import_iface.len() > 0) {
    return Made { p: external_entry(), memo: memo };
  }
  let s: State = initial(fd, scope, contracts, binding, name, handers, shadows, views, funcs, impls, debug_lines);
  if (!semtypes.concrete(s.result, true)) {
    return Made { p: refuse("unresolved result type: " + unresolved_result_spelling(fd, s)), memo: memo };
  }
  let body: ast.Stmt[] = parser.elide_len_bounded_body(fd.body);
  s = learn_body(fd, body, s);
  s = stmts(body, prebind(parameters(fd, s)));
  return complete(fd, s, name, memo);
}

// The defer desugar replays an action at every exit the arming scope can
// reach, after the arm or loop body that armed it has closed, and it cannot
// lift a pattern binding the action names as it lifts a `let`: it runs before
// the checker, and the binding has no written type. So the binding is bound here
// instead, at the top of the body and at the zero of its type, as a lifted
// `let` is; the arm or loop replaces the slot. Each probe lowers the body until its first
// refusal, which is past the match that shows the next type.
function learn_body(fd: parser.FuncDecl, body: ast.Stmt[], s: State): State {
  let known: i32 = 0 - 1;
  while (s.learned.len() < s.escaping.len() && s.learned.len() > known) {
    known = s.learned.len();
    let probe: State = stmts(body, prebind(parameters(fd, s)));
    s = State { ...s, learned: probe.learned, learned_types: probe.learned_types };
  }
  return s;
}

function prebind(s: State): State {
  let i: i32 = 0;
  while (i < s.learned.len()) {
    let z: Value = define(s, ssasem.zero(), [], 0, "", s.learned_types[i]);
    s = bind(z.s, s.learned[i], z.id);
    i = i + 1;
  }
  return s;
}

// A declaration's contract is read from its checked scope and its parameter
// declarations, the same way its own production reads them. A declaration
// this boundary cannot produce has no contract, so no call may target it. A
// template's contract keeps its variables, for the call site to bind.
function contract(fd: parser.FuncDecl, scope: checker.Scope, contracts: ssasem.Contract[]): ssasem.Contract {
  let none: ssasem.Contract = ssasem.Contract { name: "", params: [], modes: [], result: t_void() };
  let result: typeinfo.Type = result_type(fd, scope, ssasem.unbound(), contracts);
  if (!semtypes.shaped(result, true)) {
    return none;
  }
  let params: typeinfo.Type[] = [];
  let modes: i32[] = [];
  let names: string[] = decl_param_names(fd);
  let generic: boolean = generic_decl(fd);
  let at: i32 = 0;
  while (at < names.len()) {
    let ty: typeinfo.Type = resolved(checker.scope_type(scope, names[at]), generic, ssasem.unbound(), scope);
    if (at == 0 && is_closure_body(fd)) {
      ty = env_type(fd, scope, generic, ssasem.unbound(), parser.decl_key(fd));
    }
    if (!semtypes.shaped(ty, true)) {
      return none;
    }
    params = params.append(ty);
    modes = modes.append(decl_param_mode(fd, at, ty));
    at = at + 1;
  }
  return ssasem.Contract { name: parser.decl_key(fd), params: params, modes: modes, result: result };
}

// The method name of a contract key, `Type.field` giving `field`, or "" for
// a free function's.
function method_name_of(key: string): string {
  let at: i32 = key.len() - 1;
  while (at >= 0 && key[at] != b'.') {
    at = at - 1;
  }
  if (at < 0) {
    return "";
  }
  return slice_unchecked(key, at + 1, key.len()) + "";
}

// The declarations known to hand an argument out, by contract key, and the
// method names among them, for a callee the receiver's type does not name.
struct Handers { keys: util.NameIndex, methods: util.NameIndex }

function handers_with(h: Handers, key: string): Handers {
  let m: string = method_name_of(key);
  if (m.len() > 0 && !h.methods.has(m)) {
    return Handers { keys: h.keys.added(key), methods: h.methods.added(m) };
  }
  return Handers { ...h, keys: h.keys.added(key) };
}

function return_exprs(st: ast.Stmt, own acc: ast.Expr[]): ast.Expr[] {
  if let ast.StmtReturn(r) = st {
    return acc.append(r.value);
  }
  return acc;
}

// Whether an expression hands the value of one of `names` OUT as itself. A
// bare name does; so does an aggregate that holds it — a struct literal's
// field, an array or tuple element — and so does an argument of a call to a
// declaration already known to hand its arguments out, which is what closes
// the set below. Nothing else does: `s + ""` and `s.len()` read the value and
// build something of their own, which is why `copied()` and `view_len()` keep
// reclaiming the views they are lent.
function escapes_in(e: ast.Expr, names: string[], known: Handers): boolean {
  if let ast.ExprIdent(id) = e {
    return util.index_of_str(names, id.name) >= 0;
  }
  if let ast.ExprStructLit(sl) = e {
    for v in sl.field_values {
      if (escapes_in(v, names, known)) {
        return true;
      }
    }
    return sl.has_base && escapes_in(sl.base, names, known);
  }
  if let ast.ExprArray(a) = e {
    for v in a.elements {
      if (escapes_in(v, names, known)) {
        return true;
      }
    }
    return false;
  }
  if let ast.ExprTuple(t) = e {
    for v in t.elements {
      if (escapes_in(v, names, known)) {
        return true;
      }
    }
    return false;
  }
  if let ast.ExprMapLit(m) = e {
    for v in m.keys {
      if (escapes_in(v, names, known)) {
        return true;
      }
    }
    for v in m.vals {
      if (escapes_in(v, names, known)) {
        return true;
      }
    }
    return false;
  }
  if let ast.ExprCall(c) = e {
    if (!known_callee(c, known)) {
      return false;
    }
    for a in c.args {
      if (escapes_in(a, names, known)) {
        return true;
      }
    }
    if let ast.ExprFieldAccess(fa) = c.callee {
      return escapes_in(fa.obj, names, known);
    }
    return false;
  }
  return false;
}

// The builtin calls that put a reference argument INTO something rather than
// reading it: the container builders, and the union constructors, which the
// parser spells as a call of a capitalised name.
function stores_argument(name: string): boolean {
  if (name.len() == 0) {
    return false;
  }
  if (name[0] >= b'A' && name[0] <= b'Z') {
    return true;
  }
  return name == "append" || name == "with" || name == "insert" || name == "cell_new";
}

// A call that hands its arguments on: one whose target is already in the set —
// by plain name, or, since the receiver's type is not in hand here, by method
// name alone — or one of the builtins that stores what it is given.
function known_callee(c: ast.ExprCall, known: Handers): boolean {
  if let ast.ExprIdent(id) = c.callee {
    return stores_argument(id.name) || known.keys.has(id.name);
  }
  if let ast.ExprFieldAccess(fa) = c.callee {
    return stores_argument(fa.field) || known.methods.has(fa.field);
  }
  return false;
}

// A name a statement binds and the expression it binds it to: a `let`, or an
// assignment to a bare name.
struct Bound { name: string, value: ast.Expr }

function bound_exprs(st: ast.Stmt, own acc: Bound[]): Bound[] {
  if let ast.StmtVar(v) = st {
    return acc.append(Bound { name: v.name, value: v.init });
  }
  if let ast.StmtAssign(a) = st {
    return acc.append(Bound { name: a.target, value: a.value });
  }
  return acc;
}

// A parameter hands out through a local as well as directly: `let st = s;
// st = st.emit(ir.op_call_direct(freefn, 1)); return st;` returns `freefn`
// inside `st`. So the names that carry a parameter close over the body's
// bindings first — a local bound from an expression that hands one of them
// out carries it too — and the returns are read against that set.
function hands_back(fd: parser.FuncDecl, known: Handers): boolean {
  let names: string[] = decl_param_names(fd);
  let binds: Bound[] = [];
  let outs: ast.Expr[] = [];
  for st in fd.body {
    binds = astwalk.fold_stmt_spine(st, binds, bound_exprs);
    outs = astwalk.fold_stmt_spine(st, outs, return_exprs);
  }
  let grew: boolean = true;
  while (grew) {
    grew = false;
    for b in binds {
      if (util.index_of_str(names, b.name) < 0 && escapes_in(b.value, names, known)) {
        names = names.append(b.name);
        grew = true;
      }
    }
  }
  for e in outs {
    if (escapes_in(e, names, known)) {
      return true;
    }
  }
  return false;
}

// The declarations that may hand a caller's argument back out — as the result,
// or inside one — by contract name. `lend` reads it: a caller that lends a
// string VIEW to one of these hands it a copy, since a view's box carries no
// count to keep the other reference safe and its bytes belong to a source
// the caller may release first.
function handers(mod: parser.Module): util.NameIndex {
  let none: string[] = [];
  let found: Handers = Handers { keys: util.name_index(none), methods: util.name_index(none) };
  let changed: boolean = true;
  while (changed) {
    changed = false;
    for fd in mod.funcs {
      let key: string = parser.decl_key(fd);
      if (!found.keys.has(key) && hands_back(fd, found)) {
        found = handers_with(found, key);
        changed = true;
      }
    }
  }
  return found.keys;
}

// To a fixpoint: a synthesised declaration's result may be another's, read
// off this table, and the inner declaration sits after the outer one in the
// module. A declaration whose contract the first pass cannot read gets it on
// the pass after its callee's lands.
function contracts(mod: parser.Module, scopes: checker.Scope[]): ssasem.Contracts {
  let out: ssasem.Contract[] = [];
  let keys: string[] = [];
  for fd in mod.funcs {
    keys = keys.append(parser.decl_key(fd));
  }
  let shared: boolean[] = shared_keys(keys);
  let grown: boolean = true;
  while (grown) {
    grown = false;
    // The table's names as the round starts. Only a key several
    // declarations share can be added twice in one round, so only those
    // also check the round's own additions.
    let have: util.NameIndex = util.name_index(contract_names(out));
    let added: string[] = [];
    let i: i32 = 0;
    while (i < mod.funcs.len()) {
      let present: boolean = have.has(keys[i]);
      if (!present && shared[i]) {
        present = util.has_str(added, keys[i]);
      }
      if (!present) {
        let c: ssasem.Contract = contract(mod.funcs[i], scopes[i], out);
        if (c.name != "") {
          out = out.append(c);
          if (shared[i]) {
            added = added.append(c.name);
          }
          grown = true;
        }
      }
      i = i + 1;
    }
  }
  // A builtin joins unless a declaration or an earlier builtin has its name.
  let declared: util.NameIndex = util.name_index(contract_names(out));
  let builtins: ssasem.Contract[] = builtin_contracts();
  let bnames: string[] = [];
  for b in builtins {
    bnames = bnames.append(b.name);
  }
  let bix: util.NameIndex = util.name_index(bnames);
  let j: i32 = 0;
  while (j < builtins.len()) {
    if (!declared.has(bnames[j]) && bix.find(bnames[j]) == j) {
      out = out.append(builtins[j]);
    }
    j = j + 1;
  }
  return ssasem.contracts_of(out);
}

function contract_names(cs: ssasem.Contract[]): string[] {
  let out: string[] = [];
  for c in cs {
    out = out.append(c.name);
  }
  return out;
}

// shared_keys marks every key that more than one declaration carries.
function shared_keys(keys: string[]): boolean[] {
  let ix: util.NameIndex = util.name_index(keys);
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < keys.len()) {
    out = out.append(false);
    i = i + 1;
  }
  i = 0;
  while (i < keys.len()) {
    let first: i32 = ix.find(keys[i]);
    if (first != i) {
      out = out.with(first, true);
      out = out.with(i, true);
    }
    i = i + 1;
  }
  return out;
}

// The stream HANDLES and what a program does with one. A handle is its bare
// descriptor (semtypes.is_handle), so every one of these is a value: the
// constructors answer a number, the methods are handed one, and nothing here
// takes or releases a unit of the handle itself. The paths and the written
// text are read and copied, so they are lent; each result box is fresh and
// owns whatever it carries.
//
// Result types are native's registerStructMethod / FuncSigs entries — the
// copies name one table so they cannot drift.
//
// The handle metadata surface — stat, flags, seek, the partial write, the
// truncation, the three fd syncs, isatty, dup_onto, splice_to and the window
// size — is
// asked of the bare descriptor like close, and hands back a fresh Result or
// Option box.
function handle_contracts(): ssasem.Contract[] {
  let value: i32[] = [ssaunits.value_mode()];
  let path: i32[] = [ssaunits.borrow_mode()];
  let path_flags: i32[] = [ssaunits.borrow_mode(), ssaunits.value_mode()];
  let reader: typeinfo.Type = t_handle("Reader");
  let writer: typeinfo.Type = t_handle("Writer");
  let io_error: typeinfo.Type = t_option(typeinfo.TypeUnion { name: "IoError", args: [] });
  let out: ssasem.Contract[] = handle_metadata_contracts(reader, writer, io_error);
  let opens: ssasem.Contract[] = [
    ssasem.Contract { name: "stdin", params: [], modes: [], result: reader },
    ssasem.Contract { name: "stdout", params: [], modes: [], result: writer },
    ssasem.Contract { name: "stderr", params: [], modes: [], result: writer },
    ssasem.Contract { name: "open_reader", params: [t_string()], modes: path, result: t_io_result(reader) },
    ssasem.Contract { name: "open_writer", params: [t_string()], modes: path, result: t_io_result(writer) },
    ssasem.Contract { name: "open_appender", params: [t_string()], modes: path, result: t_io_result(writer) },
    ssasem.Contract { name: "open_exclusive", params: [t_string()], modes: path, result: t_io_result(writer) },
    ssasem.Contract { name: "open_reader_with", params: [t_string(), t_i32()], modes: path_flags, result: t_io_result(reader) },
    ssasem.Contract { name: "open_writer_with", params: [t_string(), t_i32()], modes: path_flags, result: t_io_result(writer) },
    ssasem.Contract { name: "Reader.read_line", params: [reader], modes: value, result: t_option(t_string()) },
    ssasem.Contract { name: "Reader.read_chunk", params: [reader, t_i32()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: t_io_result(t_string()) },
    ssasem.Contract { name: "Reader.read_chunk_bytes", params: [reader, t_i32()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: t_io_result(typeinfo.TypeArray { elem: t_u8(), view: false }) },
    ssasem.Contract { name: "Reader.close", params: [reader], modes: value, result: io_error },
    ssasem.Contract { name: "Writer.close", params: [writer], modes: value, result: io_error },
    ssasem.Contract { name: "Writer.write_bytes", params: [writer, typeinfo.TypeArray { elem: t_u8(), view: true }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode()], result: io_error },
    ssasem.Contract { name: "Writer.write_some_bytes", params: [writer, typeinfo.TypeArray { elem: t_u8(), view: true }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode()], result: t_io_result(t_i64()) },
    ssasem.Contract { name: "Writer.write", params: [writer, t_string()], modes: [ssaunits.value_mode(), ssaunits.borrow_mode()], result: io_error },
  ];
  for c in opens {
    out = out.append(c);
  }
  return out;
}

function handle_metadata_contracts(reader: typeinfo.Type, writer: typeinfo.Type, io_error: typeinfo.Type): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let seek: typeinfo.Type[] = [t_i64(), t_i32()];
  let out: ssasem.Contract[] = [];
  let handles: typeinfo.Type[] = [reader, writer];
  let owners: string[] = ["Reader", "Writer"];
  let i: i32 = 0;
  while (i < 2) {
    let h: typeinfo.Type = handles[i];
    let o: string = owners[i];
    out = out.append(ssasem.Contract { name: o + ".stat", params: [h], modes: [v], result: t_io_result(t_file_stat()) });
    out = out.append(ssasem.Contract { name: o + ".flags", params: [h], modes: [v], result: t_io_result(t_i64()) });
    out = out.append(ssasem.Contract { name: o + ".seek", params: [h, seek[0], seek[1]], modes: [v, v, v], result: t_io_result(t_i64()) });
    out = out.append(ssasem.Contract { name: o + ".fsync", params: [h], modes: [v], result: io_error });
    out = out.append(ssasem.Contract { name: o + ".fdatasync", params: [h], modes: [v], result: io_error });
    out = out.append(ssasem.Contract { name: o + ".syncfs", params: [h], modes: [v], result: io_error });
    out = out.append(ssasem.Contract { name: o + ".drop_cache", params: [h, t_i64(), t_i64()], modes: [v, v, v], result: io_error });
    out = out.append(ssasem.Contract { name: o + ".isatty", params: [h], modes: [v], result: t_bool() });
    out = out.append(ssasem.Contract { name: o + ".dup_onto", params: [h, t_i32()], modes: [v, v], result: io_error });
    i = i + 1;
  }
  out = out.append(ssasem.Contract { name: "Reader.splice_to", params: [reader, writer, t_i32()], modes: [v, v, v], result: t_io_result(t_i64()) });
  out = out.append(ssasem.Contract { name: "Reader.window_size", params: [reader], modes: [v], result: t_io_result(typeinfo.TypeStruct { name: "WinSize", args: [] }) });
  // The terminal's own three, Reader-only the way native registers them. The
  // termios record crosses as `i64[]` in the kernel's own words: `termios_get`
  // answers a fresh one the caller owns, and `termios_set` reads its bytes and
  // keeps none, so that array is lent.
  let termios: typeinfo.Type = typeinfo.TypeArray { elem: t_i64(), view: false };
  let done: typeinfo.Type = t_io_result(t_void());
  out = out.append(ssasem.Contract { name: "Reader.set_window_size", params: [reader, t_i32(), t_i32()], modes: [v, v, v], result: done });
  out = out.append(ssasem.Contract { name: "Reader.termios_get", params: [reader], modes: [v], result: t_io_result(termios) });
  out = out.append(ssasem.Contract { name: "Reader.termios_set", params: [reader, t_i32(), termios], modes: [v, v, ssaunits.borrow_mode()], result: done });
  out = out.append(ssasem.Contract { name: "Writer.write_some", params: [writer, t_string()], modes: [v, ssaunits.borrow_mode()], result: t_io_result(t_i64()) });
  return out.append(ssasem.Contract { name: "Writer.truncate", params: [writer, t_i64()], modes: [v, v], result: io_error });
}

// The OS floor the compiler itself never calls: the process and host
// queries, the directory, link and permission ops, the process ops and the
// TCP connect. Every string and array is lent, since each op reads its bytes
// and keeps none; every scalar is a value; a fresh string or array is the
// caller's, and a Result or record box owns every part of itself.
function os_contracts(): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let b: i32 = ssaunits.borrow_mode();
  let done: typeinfo.Type = t_io_result(t_void());
  let strs: typeinfo.Type = typeinfo.TypeArray { elem: t_string(), view: false };
  let out: ssasem.Contract[] = [
    ssasem.Contract { name: "getcwd", params: [], modes: [], result: t_string() },
    ssasem.Contract { name: "hostname", params: [], modes: [], result: t_string() },
    ssasem.Contract { name: "cpu_count", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "geteuid", params: [], modes: [], result: t_u32() },
    ssasem.Contract { name: "getegid", params: [], modes: [], result: t_u32() },
    ssasem.Contract { name: "getuid", params: [], modes: [], result: t_u32() },
    ssasem.Contract { name: "getgid", params: [], modes: [], result: t_u32() },
    ssasem.Contract { name: "environ", params: [], modes: [], result: strs },
    ssasem.Contract { name: "proc_fork", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "isatty", params: [t_i32()], modes: [v], result: t_bool() },
    ssasem.Contract { name: "process_alive", params: [t_i32()], modes: [v], result: t_bool() },
    ssasem.Contract { name: "rlimit_nofile", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "uname_field", params: [t_i32()], modes: [v], result: t_string() },
    ssasem.Contract { name: "umask", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "proc_waitpid", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "proc_waitpid_nohang", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "temp_dir", params: [t_string()], modes: [b], result: t_io_result(t_string()) },
    ssasem.Contract { name: "read_link", params: [t_string()], modes: [b], result: t_io_result(t_string()) },
    ssasem.Contract { name: "remove_dir", params: [t_string()], modes: [b], result: done },
    ssasem.Contract { name: "statfs", params: [t_string()], modes: [b], result: t_io_result(typeinfo.TypeStruct { name: "FsStat", args: [] }) },
  ];
  for c in fs_op_contracts(done, strs) {
    out = out.append(c);
  }
  for c in os_floor_contracts(done, strs) {
    out = out.append(c);
  }
  return out;
}

// The rest of the OS floor: the process, signal, group, socket and clock
// builtins, and the wasm pollables. Every path and array is lent, every
// scalar a value; a fresh array is the caller's and a Result box owns its
// parts. `sync` returns nothing and stands only as a statement.
function os_floor_contracts(done: typeinfo.Type, strs: typeinfo.Type): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let b: i32 = ssaunits.borrow_mode();
  let gids: typeinfo.Type = typeinfo.TypeArray { elem: t_i64(), view: false };
  let bytes: typeinfo.Type = typeinfo.TypeArray { elem: t_u8(), view: false };
  let fds: typeinfo.Type = typeinfo.TypeArray { elem: t_i32(), view: false };
  let win: typeinfo.Type = t_io_result(typeinfo.TypeStruct { name: "WinSize", args: [] });
  return [
    ssasem.Contract { name: "set_file_times", params: [t_string(), t_i64(), t_i64(), t_i64(), t_i64(), t_i32()], modes: [b, v, v, v, v, v], result: done },
    ssasem.Contract { name: "mknod", params: [t_string(), t_i32(), t_i32(), t_i32()], modes: [b, v, v, v], result: done },
    ssasem.Contract { name: "chmod_at", params: [t_string(), t_i32(), t_bool()], modes: [b, v, v], result: done },
    ssasem.Contract { name: "chdir", params: [t_string()], modes: [b], result: done },
    ssasem.Contract { name: "chroot", params: [t_string()], modes: [b], result: done },
    ssasem.Contract { name: "set_process_group", params: [t_i32(), t_i32()], modes: [v, v], result: done },
    ssasem.Contract { name: "setgroups", params: [gids], modes: [b], result: done },
    ssasem.Contract { name: "getgroups", params: [], modes: [], result: gids },
    ssasem.Contract { name: "priority", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "sync", params: [], modes: [], result: t_void() },
    ssasem.Contract { name: "poll", params: [fds, t_i32()], modes: [b, v], result: t_i32() },
    ssasem.Contract { name: "timer_fd", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "tcp_send", params: [t_i32(), t_string()], modes: [v, b], result: t_i32() },
    ssasem.Contract { name: "tcp_send_bytes", params: [t_i32(), bytes], modes: [v, b], result: t_i32() },
    ssasem.Contract { name: "udp_send", params: [t_string(), t_i32(), t_string()], modes: [b, v, b], result: t_i32() },
    ssasem.Contract { name: "udp_send_bytes", params: [t_string(), t_i32(), bytes], modes: [b, v, b], result: t_i32() },
    ssasem.Contract { name: "tcp_recv", params: [t_i32(), t_i32()], modes: [v, v], result: typeinfo.TypeArray { elem: t_u8(), view: false } },
    ssasem.Contract { name: "tcp_pollable", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "tcp_listen_with", params: [bytes, t_i32(), t_i32(), t_bool()], modes: [b, v, v, v], result: t_i32() },
    ssasem.Contract { name: "tcp_socket_ctl", params: [t_i32(), t_i32(), t_i32()], modes: [v, v, v], result: t_i32() },
    ssasem.Contract { name: "tcp_sendfile", params: [t_i32(), t_i32(), t_i32()], modes: [v, v, v], result: t_i32() },
    ssasem.Contract { name: "udp_bind", params: [bytes, t_i32()], modes: [b, v], result: t_i32() },
    ssasem.Contract { name: "udp_connect", params: [t_i32(), bytes, t_i32()], modes: [v, b, v], result: t_i32() },
    ssasem.Contract { name: "udp_sendto", params: [t_i32(), bytes, t_i32(), t_string()], modes: [v, b, v, b], result: t_i32() },
    ssasem.Contract { name: "udp_sendto_bytes", params: [t_i32(), bytes, t_i32(), bytes], modes: [v, b, v, b], result: t_i32() },
    ssasem.Contract { name: "udp_recvfrom", params: [t_i32(), bytes, bytes], modes: [v, b, b], result: t_i32() },
    ssasem.Contract { name: "tcp_connect_with", params: [bytes, t_i32(), t_bool()], modes: [b, v, v], result: t_i32() },
    ssasem.Contract { name: "unix_listen", params: [t_string(), t_i32()], modes: [b, v], result: t_i32() },
    ssasem.Contract { name: "unix_connect", params: [t_string()], modes: [b], result: t_i32() },
    ssasem.Contract { name: "reactor_new", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "reactor_ctl", params: [t_i32(), t_i32(), t_i32(), t_i32()], modes: [v, v, v, v], result: t_i32() },
    ssasem.Contract { name: "reactor_wait", params: [t_i32(), typeinfo.TypeArray { elem: t_i32(), view: false }, t_i32()], modes: [v, b, v], result: t_i32() },
    ssasem.Contract { name: "tcp_recv_into", params: [t_i32(), bytes], modes: [v, b], result: t_i32() },
    ssasem.Contract { name: "signal_ignore", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "signal_default", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "signal_disposition", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "signal_mask", params: [t_i32(), t_i64()], modes: [v, v], result: t_i64() },
    ssasem.Contract { name: "proc_exec", params: [t_string(), strs], modes: [b, b], result: t_i32() },
    ssasem.Contract { name: "proc_exec_as", params: [t_string(), strs, strs], modes: [b, b, b], result: t_i32() },
    ssasem.Contract { name: "wasm_timer_pollable", params: [t_i64()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "wasm_pollable_drop", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "wasm_block", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "wasm_poll", params: [fds], modes: [b], result: t_i32() },
    ssasem.Contract { name: "window_size", params: [t_i32()], modes: [v], result: win },
    ssasem.Contract { name: "set_window_size", params: [t_i32(), t_i32(), t_i32()], modes: [v, v, v], result: done },
    ssasem.Contract { name: "termios_get", params: [t_i32()], modes: [v], result: t_io_result(gids) },
    ssasem.Contract { name: "termios_set", params: [t_i32(), t_i32(), gids], modes: [v, v, b], result: done },
    ssasem.Contract { name: "tcp_close", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "setuid", params: [t_i64()], modes: [v], result: done },
    ssasem.Contract { name: "setgid", params: [t_i64()], modes: [v], result: done },
    ssasem.Contract { name: "set_priority", params: [t_i32()], modes: [v], result: done },
  ];
}

function fs_op_contracts(done: typeinfo.Type, strs: typeinfo.Type): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let b: i32 = ssaunits.borrow_mode();
  return [
    ssasem.Contract { name: "create_dir", params: [t_string(), t_i32()], modes: [b, v], result: done },
    ssasem.Contract { name: "chmod", params: [t_string(), t_i32()], modes: [b, v], result: done },
    ssasem.Contract { name: "access", params: [t_string(), t_i32()], modes: [b, v], result: done },
    ssasem.Contract { name: "rename", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "rename_noreplace", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "getxattr", params: [t_string(), t_string()], modes: [b, b], result: t_io_result(t_string()) },
    ssasem.Contract { name: "getxattr_bytes", params: [t_string(), t_string()], modes: [b, b], result: t_io_result(typeinfo.TypeArray { elem: t_u8(), view: false }) },
    ssasem.Contract { name: "lgetxattr", params: [t_string(), t_string()], modes: [b, b], result: t_io_result(t_string()) },
    ssasem.Contract { name: "lgetxattr_bytes", params: [t_string(), t_string()], modes: [b, b], result: t_io_result(typeinfo.TypeArray { elem: t_u8(), view: false }) },
    ssasem.Contract { name: "setxattr", params: [t_string(), t_string(), t_string()], modes: [b, b, b], result: done },
    ssasem.Contract { name: "setxattr_bytes", params: [t_string(), t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [b, b, b], result: done },
    ssasem.Contract { name: "lsetxattr", params: [t_string(), t_string(), t_string()], modes: [b, b, b], result: done },
    ssasem.Contract { name: "lsetxattr_bytes", params: [t_string(), t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [b, b, b], result: done },
    ssasem.Contract { name: "rename_exchange", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "create_link", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "create_symlink", params: [t_string(), t_string()], modes: [b, b], result: done },
    ssasem.Contract { name: "tcp_connect", params: [t_i32(), t_i32()], modes: [v, v], result: t_i32() },
    ssasem.Contract { name: "tcp_listen", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "tcp_accept", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "tcp_local_port", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "signal_send", params: [t_i32(), t_i32()], modes: [v, v], result: done },
    ssasem.Contract { name: "chown_at", params: [t_string(), t_i32(), t_i32(), t_bool()], modes: [b, v, v, v], result: done },
    ssasem.Contract { name: "truncate", params: [t_string(), t_i64()], modes: [b, v], result: done },
    ssasem.Contract { name: "subprocess", params: [t_string(), strs, t_string()], modes: [b, b, b], result: typeinfo.TypeStruct { name: "ProcessResult", args: [] } },
  ];
}

// A handle's nominal, as the checker resolves the injected declaration.
function t_handle(name: string): typeinfo.Type {
  return typeinfo.TypeStruct { name: name, args: [] };
}

function t_option(payload: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeUnion { name: "Option", args: [payload] };
}

function t_io_result(ok: typeinfo.Type): typeinfo.Type {
  return typeinfo.TypeUnion { name: "Result", args: [ok, typeinfo.TypeUnion { name: "IoError", args: [] }] };
}

// The record `stat` fills in. It is declared in the injected builtin module,
// so its schema is read from the checker's scope the way any record's is.
function t_file_stat(): typeinfo.Type {
  return typeinfo.TypeStruct { name: "FileStat", args: [] };
}

// The runtime builtins with a contract here, each a stack IR op of its own
// rather than a call. What each hands back is the op's own value; a void one
// pushes the dummy every statement op pushes.
function builtin_contracts(): ssasem.Contract[] {
  let out: ssasem.Contract[] = union_result_contracts();
  for c in handle_contracts() {
    out = out.append(c);
  }
  for c in os_contracts() {
    out = out.append(c);
  }
  for c in value_contracts() {
    out = out.append(c);
  }
  for c in string_contracts() {
    out = out.append(c);
  }
  for c in builder_contracts() {
    out = out.append(c);
  }
  for c in intrinsic_contracts() {
    out = out.append(c);
  }
  for c in string_method_contracts() {
    out = out.append(c);
  }
  return out;
}

// The string methods the AST lowering emits an OP for rather than a call —
// `is_str_builtin_method`'s seven. Each is keyed by its receiver the way a
// declared method is, `string.trim`, so a text receiver finds it through the
// owner method_call already derives. contracts() keeps a declaration of one of
// these over the builtin; a user's own is then an ordinary call
// (`shadowed_builtins`), and std/string's lowers to the helper's op.
//
// The receiver is LENT — every one reads its bytes and keeps none of them —
// and the three that answer text hand back a fresh string of the caller's own,
// as `split` hands back a fresh array of fresh strings.
function string_method_contracts(): ssasem.Contract[] {
  let lent: i32[] = [ssaunits.borrow_mode()];
  let two: i32[] = [ssaunits.borrow_mode(), ssaunits.borrow_mode()];
  let fresh: string[] = ["to_ascii_upper", "to_ascii_lower", "trim"];
  let out: ssasem.Contract[] = [];
  for n in fresh {
    out = out.append(ssasem.Contract { name: "string." + n, params: [t_string()], modes: lent, result: t_string() });
  }
  out = out.append(ssasem.Contract { name: "string.lines", params: [t_string()], modes: lent, result: typeinfo.TypeArray { elem: t_string(), view: false } });
  out = out.append(ssasem.Contract { name: "string.split", params: [t_string(), t_string()], modes: two, result: typeinfo.TypeArray { elem: t_string(), view: false } });
  out = out.append(ssasem.Contract { name: "string.repeat", params: [t_string(), t_i32()], modes: [ssaunits.borrow_mode(), ssaunits.value_mode()], result: t_string() });
  return out.append(ssasem.Contract {
    name: "string.replace", params: [t_string(), t_string(), t_string()],
    modes: [ssaunits.borrow_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_string(),
  });
}

// The runtime intrinsics, typed as native's FuncSigs types them. Every one is
// a stack IR op rather than a call — ssarc.intrinsic_site emits it, and an
// intrinsic with no op there would reach the backends as a direct call to a
// symbol no runtime defines. Every argument is a scalar the op reads, except
// the byte scans, which are LENT the string whose bytes they walk and keep
// nothing of it. `__alloc_u8` is the one result the caller owns: a fresh
// zeroed buffer, counted like any other array.
//
// `__alloc_reuse` is absent because the self-host IR does not lower it at all
// — that is a lowering gap behind the name, not a contract gap here.
function intrinsic_contracts(): ssasem.Contract[] {
  let out: ssasem.Contract[] = float_primitive_contracts();
  for c in c_call_contracts() {
    out = out.append(c);
  }
  for c in bit_count_contracts() {
    out = out.append(c);
  }
  for c in memory_contracts() {
    out = out.append(c);
  }
  for c in byte_scan_contracts() {
    out = out.append(c);
  }
  for c in rc_contracts() {
    out = out.append(c);
  }
  for c in raw_floor_contracts() {
    out = out.append(c);
  }
  return out;
}

// The `__c_callN` trampolines, typed by the checker's table: a C function
// pointer and up to four integer arguments, all values, and a scalar result.
// Each is a direct call of the shim the native backends emit for the name.
function c_call_contracts(): ssasem.Contract[] {
  let names: string[] = [
    "__c_call0", "__c_call0_f32", "__c_call0_f64", "__c_call1", "__c_call1_f32", "__c_call1_f64",
    "__c_call2", "__c_call2_f32", "__c_call2_f64", "__c_call3", "__c_call3_f32", "__c_call3_f64",
    "__c_call4", "__c_call4_f32", "__c_call4_f64",
  ];
  let out: ssasem.Contract[] = [];
  for name in names {
    if let typeinfo.TypeFunc(sig) = checker.builtin_sig(name) {
      let modes: i32[] = [];
      for _ in sig.param_types {
        modes = modes.append(ssaunits.value_mode());
      }
      out = out.append(ssasem.Contract { name: name, params: sig.param_types, modes: modes, result: sig.ret_type });
    }
  }
  return out;
}

// The raw floor, typed by the checker's one table. Every operand is a value
// except `__raw_data`'s string and `__raw_arr_ptr`'s array, which are lent:
// the address they answer is read, not kept.
function raw_floor_contracts(): ssasem.Contract[] {
  let out: ssasem.Contract[] = [];
  for sig in checker.raw_floor_sigs() {
    let mode: i32 = ssaunits.value_mode();
    if (sig.name == "__raw_data" || sig.name == "__raw_arr_ptr") {
      mode = ssaunits.borrow_mode();
    }
    let modes: i32[] = [];
    for _ in sig.params {
      modes = modes.append(mode);
    }
    out = out.append(ssasem.Contract { name: sig.name, params: sig.params, modes: modes, result: sig.result });
  }
  return out;
}

// The reference-counting and container helpers `core/map` calls by name. It is
// written against the runtime directly — an inline (SSO) key has no buffer to
// count, a value column's kind decides whether a slot is owned — so the calls
// are in the source rather than inserted by the RC lowering, and the producer
// needs a contract for each the way it does for `__memcpy`.
//
// Signatures are the call sites': `__fern_rc_inc` answers the pointer it was
// given (map.fern:477, 747, 970), `__fern_str_dec` is lent the string and
// gives nothing back (657, 719), `__map_hash_seed` answers the i32 stored in the
// header (342), and the two array drops take a pointer and a stride (727, 730).
function rc_contracts(): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  return [
    ssasem.Contract { name: "__fern_rc_inc", params: [t_usize()], modes: [v], result: t_usize() },
    // Lent, not consumed: core/map calls it on `k as string`, a raw column
    // word the frame holds no counted unit for, and the helper releases
    // the string itself.
    ssasem.Contract { name: "__fern_str_dec", params: [t_string()], modes: [ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "__map_hash_seed", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__fern_drop_arr_ptr", params: [t_usize(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__fern_arr_dec", params: [t_usize(), t_i32()], modes: [v, v], result: t_void() },
    // The handle release in __map_drop_impl: frees the rc'd block at the
    // address minus its header, and answers the address.
    ssasem.Contract { name: "__fern_box_free", params: [t_usize(), t_i32()], modes: [v, v], result: t_usize() },
    // The manual-release and manual-retain test hooks. Each is lent its
    // array: the count it moves is one the plan does not see, which is the
    // point of a hook that exercises the underflow detector. The retain
    // answers the array with the unit it added, which the caller owns.
    ssasem.Contract { name: "__rc_dec", params: [typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "__rc_inc", params: [typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.borrow_mode()], result: typeinfo.TypeArray { elem: t_u8(), view: false } },
    // The detectors a program reads to report on itself: the over-release
    // count and the two shared-append totals, each a read of a runtime word.
    ssasem.Contract { name: "__rc_underflow_count", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__arr_push_shared_count", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__arr_push_shared_bytes", params: [], modes: [], result: t_i64() },
  ];
}

// The ten f64 primitives `std/float` dispatches to, and the one two-operand
// member.
function float_primitive_contracts(): ssasem.Contract[] {
  let names: string[] = [
    "__sqrt_f64", "__floor_f64", "__ceil_f64", "__round_f64", "__trunc_f64",
    "__abs_f64", "__log_f64", "__exp_f64", "__sin_f64", "__cos_f64",
  ];
  let value: i32[] = [ssaunits.value_mode()];
  let out: ssasem.Contract[] = [];
  for n in names {
    out = out.append(ssasem.Contract { name: n, params: [t_f64()], modes: value, result: t_f64() });
  }
  return out.append(ssasem.Contract {
    name: "__pow_f64", params: [t_f64(), t_f64()],
    modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: t_f64(),
  });
}

// One name per operand width, each answering an i32 count.
function bit_count_contracts(): ssasem.Contract[] {
  let narrow: string[] = ["__clz32", "__ctz32", "__popcount32"];
  let wide: string[] = ["__clz64", "__ctz64", "__popcount64"];
  let value: i32[] = [ssaunits.value_mode()];
  let out: ssasem.Contract[] = [];
  for n in narrow {
    out = out.append(ssasem.Contract { name: n, params: [t_u32()], modes: value, result: t_i32() });
  }
  for n in wide {
    out = out.append(ssasem.Contract { name: n, params: [t_u64()], modes: value, result: t_i32() });
  }
  return out;
}

// The raw-memory escape hatches. An address is a `usize`, a value with no unit
// — a block `__alloc` hands back is never freed by this boundary, as a
// builder handle is not, and `__free` gives one back explicitly. `__alloc_u8`'s
// buffer is the exception: it is an ordinary counted array, so the caller owns
// it and drops it.
function memory_contracts(): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let b: i32 = ssaunits.borrow_mode();
  let fds: typeinfo.Type = typeinfo.TypeArray { elem: t_i32(), view: false };
  let out: ssasem.Contract[] = [
    ssasem.Contract { name: "__alloc", params: [t_i32()], modes: [v], result: t_usize() },
    ssasem.Contract { name: "__alloc_u8", params: [t_i32()], modes: [v], result: typeinfo.TypeArray { elem: t_u8(), view: false } },
    ssasem.Contract { name: "__free", params: [t_usize(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__ptr_width", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__heap_bump_bytes", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "__heap_alloc_count", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "__heap_mark", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "__heap_release_to", params: [t_i64()], modes: [v], result: t_void() },
    ssasem.Contract { name: "__task_new", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__task_free", params: [t_i32()], modes: [v], result: t_void() },
    ssasem.Contract { name: "__task_cur", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__task_enter", params: [t_i32(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__task_leave", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "__task_park", params: [fds, t_i32()], modes: [b, v], result: t_i32() },
    ssasem.Contract { name: "__task_wait", params: [t_i32()], modes: [v], result: fds },
    ssasem.Contract { name: "__task_timeout", params: [t_i32()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "__task_set_ready", params: [t_i32(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__task_set_cancelled", params: [t_i32()], modes: [v], result: t_void() },
    ssasem.Contract { name: "__memcpy", params: [t_usize(), t_usize(), t_i32()], modes: [v, v, v], result: t_void() },
    ssasem.Contract { name: "__memset", params: [t_usize(), t_i32(), t_i32()], modes: [v, v, v], result: t_void() },
  ];
  for c in load_store_contracts() {
    out = out.append(c);
  }
  return out;
}

// One peek and one poke per width. A load answers the width its name carries;
// a store takes the address and the value and gives nothing back. The buffer
// `__arr_set_len` shortens and the string `__str_bytes` reads are lent.
function load_store_contracts(): ssasem.Contract[] {
  let v: i32 = ssaunits.value_mode();
  let b: i32 = ssaunits.borrow_mode();
  return [
    ssasem.Contract { name: "__load_u8", params: [t_usize()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "__getpwuid_name", params: [t_u32()], modes: [v], result: t_usize() },
    ssasem.Contract { name: "__load_i32", params: [t_usize()], modes: [v], result: t_i32() },
    ssasem.Contract { name: "__load_i64", params: [t_usize()], modes: [v], result: t_i64() },
    ssasem.Contract { name: "__load_ptr", params: [t_usize()], modes: [v], result: t_usize() },
    ssasem.Contract { name: "__store_u8", params: [t_usize(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__str_bytes", params: [t_string(), t_usize()], modes: [b, v], result: t_usize() },
    ssasem.Contract { name: "__arr_set_len", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32()], modes: [b, v], result: t_void() },
    ssasem.Contract { name: "__store_i32", params: [t_usize(), t_i32()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__store_i64", params: [t_usize(), t_i64()], modes: [v, v], result: t_void() },
    ssasem.Contract { name: "__store_ptr", params: [t_usize(), t_usize()], modes: [v, v], result: t_void() },
  ];
}

// The byte scans: each is LENT the string it walks and answers an index, a
// count or a checksum, so nothing of the source escapes into the result.
// __crc32_cksum is the one whose string is at position 1 rather than 0.
function byte_scan_contracts(): ssasem.Contract[] {
  let lent: i32 = ssaunits.borrow_mode();
  let value: i32 = ssaunits.value_mode();
  return [
    ssasem.Contract { name: "__sum_bytes", params: [t_string()], modes: [lent], result: t_i32() },
    // The one over an ARRAY: the f64[] is lent and a fresh f64[] comes back.
    ssasem.Contract { name: "__scale_f64", params: [typeinfo.TypeArray { elem: t_f64(), view: false }, t_f64()], modes: [lent, value], result: typeinfo.TypeArray { elem: t_f64(), view: false } },
    ssasem.Contract { name: "__crc32_cksum", params: [t_i32(), t_string()], modes: [value, lent], result: t_i32() },
    ssasem.Contract { name: "__crc32_cksum_array", params: [t_i32(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [value, lent], result: t_i32() },
    ssasem.Contract { name: "__ascii_run", params: [t_string(), t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__scan_set", params: [t_string(), t_i32(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [lent, value, lent], result: t_i32() },
    ssasem.Contract { name: "__scan_set_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [lent, value, lent], result: t_i32() },
    ssasem.Contract { name: "__bsd_sum", params: [t_string(), t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__count_runs", params: [t_string(), t_i32(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [lent, value, lent], result: t_i32() },
    ssasem.Contract { name: "__count_runs_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [lent, value, lent], result: t_i32() },
    ssasem.Contract { name: "__count_byte", params: [t_string(), t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__memchr", params: [t_string(), t_i32(), t_i32()], modes: [lent, value, value], result: t_i32() },
    ssasem.Contract { name: "__count_byte_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__sum_bytes_array", params: [typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [lent], result: t_i32() },
    ssasem.Contract { name: "__bsd_sum_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32()], modes: [lent, value], result: t_i32() },
    ssasem.Contract { name: "__memchr_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), t_i32()], modes: [lent, value, value], result: t_i32() },
    ssasem.Contract { name: "__rmemchr_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), t_i32()], modes: [lent, value, value], result: t_i32() },
    ssasem.Contract { name: "__mismatch_bytes", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), t_i32()], modes: [lent, value, lent, value, value], result: t_i32() },
    ssasem.Contract { name: "__rmemchr", params: [t_string(), t_i32(), t_i32()], modes: [lent, value, value], result: t_i32() },
    ssasem.Contract {
      name: "__mismatch", params: [t_string(), t_i32(), t_string(), t_i32(), t_i32()],
      modes: [lent, value, lent, value, value], result: t_i32(),
    },
  ];
}

// The string builder: a handle is the ADDRESS of its control block, a
// `usize`, which is a value with no unit and no drop — a builder that is
// never freed leaks, as a descriptor that is never closed does. The pushes
// read the string they copy; `buf_take` hands the bytes over as a fresh
// string of the caller's own.
function builder_contracts(): ssasem.Contract[] {
  let handle: i32[] = [ssaunits.value_mode()];
  let push: i32[] = [ssaunits.value_mode(), ssaunits.borrow_mode()];
  return [
    ssasem.Contract { name: "buf_new", params: [t_i32()], modes: handle, result: t_usize() },
    ssasem.Contract { name: "buf_push", params: [t_usize(), t_string()], modes: push, result: t_void() },
    ssasem.Contract { name: "buf_push_range", params: [t_usize(), t_string(), t_i32(), t_i32()], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_bytes_range", params: [t_usize(), typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), t_i32()], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_mapped", params: [t_usize(), t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_bytes_mapped", params: [t_usize(), typeinfo.TypeArray { elem: t_u8(), view: false }, typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_filtered", params: [t_usize(), t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_bytes_filtered", params: [t_usize(), typeinfo.TypeArray { elem: t_u8(), view: false }, typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_expanded", params: [t_usize(), t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_bytes_expanded", params: [t_usize(), typeinfo.TypeArray { elem: t_u8(), view: false }, typeinfo.TypeArray { elem: t_u8(), view: false }], modes: [ssaunits.value_mode(), ssaunits.borrow_mode(), ssaunits.borrow_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_byte", params: [t_usize(), t_i32()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: t_void() },
    ssasem.Contract { name: "buf_push_u64", params: [t_usize(), t_u64()], modes: [ssaunits.value_mode(), ssaunits.value_mode()], result: t_void() },
    ssasem.Contract { name: "buf_len", params: [t_usize()], modes: handle, result: t_i32() },
    ssasem.Contract { name: "buf_take", params: [t_usize()], modes: handle, result: t_string() },
    ssasem.Contract { name: "buf_take_bytes", params: [t_usize()], modes: handle, result: typeinfo.TypeArray { elem: t_u8(), view: false } },
    ssasem.Contract { name: "buf_free", params: [t_usize()], modes: handle, result: t_void() },
  ];
}

// The builtins whose result is one of the front end's generic unions. Each
// contract names the INSTANTIATION, because that is what says what the caller
// owns: each reads the string it is lent and copies whatever it keeps, so the
// box owns every part of itself — `env`'s value, `read_line`'s line,
// `read_file`'s contents, `read_file_bytes`'s buffer, `read_dir`'s names,
// `stat`'s record, and the IoError an error arm carries. The writers and the
// two directory walks read their path and contents the same way and hand back
// only the outcome, `Result[void, IoError]`. Nothing here is generic: each
// builtin has exactly one instantiation, so none is a template.
function union_result_contracts(): ssasem.Contract[] {
  let path: i32[] = [ssaunits.borrow_mode()];
  let out: ssasem.Contract[] = [
    ssasem.Contract { name: "env", params: [t_string()], modes: path, result: t_option(t_string()) },
    ssasem.Contract { name: "config_get", params: [t_string()], modes: path, result: t_option(t_string()) },
    ssasem.Contract { name: "read_line", params: [], modes: [], result: t_option(t_string()) },
    ssasem.Contract { name: "read_file", params: [t_string()], modes: path, result: t_io_result(t_string()) },
    ssasem.Contract { name: "read_file_bytes", params: [t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: t_u8(), view: false }) },
    ssasem.Contract { name: "read_dir", params: [t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: t_string(), view: false }) },
    ssasem.Contract { name: "read_dir_all", params: [t_string()], modes: path, result: t_io_result(typeinfo.TypeArray { elem: t_string(), view: false }) },
    ssasem.Contract { name: "stat", params: [t_string()], modes: path, result: t_io_result(t_file_stat()) },
    ssasem.Contract { name: "lstat", params: [t_string()], modes: path, result: t_io_result(t_file_stat()) },
  ];
  for c in outcome_contracts() {
    out = out.append(c);
  }
  return out;
}

function outcome_contracts(): ssasem.Contract[] {
  let path: i32[] = [ssaunits.borrow_mode()];
  let written: i32[] = [ssaunits.borrow_mode(), ssaunits.borrow_mode()];
  let done: typeinfo.Type = t_io_result(t_void());
  return [
    ssasem.Contract { name: "write_file", params: [t_string(), t_string()], modes: written, result: done },
    ssasem.Contract { name: "write_file_bytes", params: [t_string(), typeinfo.TypeArray { elem: t_u8(), view: false }], modes: written, result: done },
    ssasem.Contract { name: "write_file_exec", params: [t_string(), t_string()], modes: written, result: done },
    ssasem.Contract { name: "create_dir_all", params: [t_string()], modes: path, result: done },
    ssasem.Contract { name: "remove_dir_all", params: [t_string()], modes: path, result: done },
    ssasem.Contract { name: "remove_file", params: [t_string()], modes: path, result: done },
  ];
}

// The builtins whose result owns nothing: the process arguments and the
// random buffer are fresh arrays of this function's own, the byte write and
// the two bit reinterprets of the single-precision float are values, the
// three clocks read a host counter, and the two sleeps hand it one. None of
// them is handed a reference, so none of them borrows.
function value_contracts(): ssasem.Contract[] {
  let value: i32[] = [ssaunits.value_mode()];
  return [
    ssasem.Contract { name: "args", params: [], modes: [], result: typeinfo.TypeArray { elem: t_string(), view: false } },
    ssasem.Contract { name: "random_bytes", params: [t_i32()], modes: value, result: typeinfo.TypeArray { elem: t_u8(), view: false } },
    ssasem.Contract { name: "random_i32", params: [], modes: [], result: t_i32() },
    ssasem.Contract { name: "now_unix_ms", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "now_ns", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "monotonic_ns", params: [], modes: [], result: t_i64() },
    ssasem.Contract { name: "sleep_ms", params: [t_i64()], modes: value, result: t_void() },
    ssasem.Contract { name: "sleep_ns", params: [t_i64()], modes: value, result: t_void() },
    ssasem.Contract { name: "putchar", params: [t_i32()], modes: value, result: t_void() },
    ssasem.Contract { name: "f32_bits", params: [t_f32()], modes: value, result: t_i32() },
    ssasem.Contract { name: "f32_from_bits", params: [t_i32()], modes: value, result: t_f32() },
  ];
}

// The two writers and the string builder's append copy the bytes of a string
// they only read, the builder's reset and take own no argument, the byte
// search reads its string, and `chr` answers a fresh one.
function string_contracts(): ssasem.Contract[] {
  let writer: i32[] = [ssaunits.borrow_mode()];
  return [
    ssasem.Contract { name: "print", params: [t_string()], modes: writer, result: t_void() },
    ssasem.Contract { name: "eprint", params: [t_string()], modes: writer, result: t_void() },
    ssasem.Contract { name: "strbuf_append", params: [t_string()], modes: writer, result: t_void() },
    ssasem.Contract { name: "strbuf_reset", params: [], modes: [], result: t_void() },
    ssasem.Contract { name: "strbuf_take", params: [], modes: [], result: t_string() },
    ssasem.Contract { name: "__memchr", params: [t_string(), t_i32(), t_i32()], modes: [ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: t_i32() },
    ssasem.Contract { name: "write", params: [t_string()], modes: writer, result: t_void() },
    ssasem.Contract { name: "exit", params: [t_i32()], modes: [ssaunits.value_mode()], result: t_void() },
    ssasem.Contract { name: "chr", params: [t_i32()], modes: [ssaunits.value_mode()], result: t_string() },
    ssasem.Contract { name: "string_from_bytes_unchecked", params: [typeinfo.TypeArray { elem: t_u8(), view: false }], modes: writer, result: t_string() },
    ssasem.Contract { name: "string_from_bytes_range_unchecked", params: [typeinfo.TypeArray { elem: t_u8(), view: false }, t_i32(), t_i32()], modes: [ssaunits.borrow_mode(), ssaunits.value_mode(), ssaunits.value_mode()], result: t_string() },
    ssasem.Contract { name: "f64_bits", params: [t_f64()], modes: [ssaunits.value_mode()], result: t_i64() },
    ssasem.Contract { name: "f64_from_bits", params: [t_i64()], modes: [ssaunits.value_mode()], result: t_f64() },
  ];
}

// A produced body's callees must be produced too: a contract is only honoured
// by a body verified against it, so a refused callee refuses every caller,
// transitively. A body-less callee is the exception — an `@import` extern's
// contract is honoured by the bridge's wrapper, emitted from the same
// declaration. `names` is the symbol each entry defines: a declaration's key,
// or an instance's name.
function close_module(all: Produced[], names: util.NameIndex): Produced[] {
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let i: i32 = 0;
    while (i < all.len()) {
      if (all[i].ok) {
        for c in all[i].func.calls {
          let at: i32 = names.find(c.name);
          if (at >= 0 && !all[at].ok && !all[at].bodyless && all[i].ok) {
            all = all.with(i, Produced { ...refuse("call target was refused: " + all[at].why), key: all[i].key });
            changed = true;
          }
        }
      }
      i = i + 1;
    }
  }
  return all;
}

// A result that holds views reads parameters' bytes, so its caller keeps those
// arguments alive while the result lives: the result is anchored to every
// parameter a returned view reads (`ssasem.result_anchor`), to a fixpoint
// because an anchor can pass through a callee's. A plain view result that
// reads storage other than a parameter's returns copies instead; any other
// result holding such a view escapes its source, and is refused along with its
// callers.
// Every body then carries the whole table, which is what anchors a call's
// result in the caller's graph, and is verified only then: unanchored, a call
// result is its own root, which a loop phi it flows back into cannot depend on.
// The copy helpers the merge copies call (ssasem.copy_helper_func) follow the
// rows, each named in `names`.
struct Anchored { all: Produced[], names: string[] }

function anchor_module(all: Produced[], names: string[], verify: boolean): Anchored {
  let anchors: ssasem.Anchor[] = [];
  let copied: boolean = true;
  while (copied) {
    let changed: boolean = true;
    while (changed) {
      changed = false;
      let i: i32 = 0;
      while (i < all.len()) {
        if (all[i].ok && ssasem.holds_view(all[i].func, all[i].func.result) && !ssasem.anchored(anchors, names[i])) {
          let k: ssasem.ResultAnchor = ssasem.result_anchor(all[i].func, anchors, names);
          if (!k.escapes && !k.pending) {
            anchors = anchors.append(ssasem.Anchor { name: names[i], params: k.params });
            changed = true;
          }
        }
        i = i + 1;
      }
    }
    // A plain view result that escapes returns a copy of each view:
    // a counted string retagged, which anchors nothing. Its callers then
    // settle on the next round.
    copied = false;
    let j: i32 = 0;
    while (j < all.len()) {
      let p: Produced = all[j];
      if (p.ok && ssasem.is_view(p.func.result) && !ssasem.anchored(anchors, names[j])
        && ssasem.result_anchor(p.func, anchors, names).escapes) {
        all = all.with(j, Produced { ...p, func: copy_returned_views(p.func) });
        anchors = anchors.append(ssasem.Anchor { name: names[j], params: [] });
        copied = true;
      }
      j = j + 1;
    }
  }
  let out: Produced[] = [];
  let helpers: CopyHelpers = CopyHelpers { types: [], from: [] };
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    if (p.ok && ssasem.holds_view(p.func, p.func.result) && !ssasem.anchored(anchors, names[i])) {
      let source: ssasem.ResultAnchor = ssasem.result_anchor(p.func, anchors, names);
      p = Produced { ...refuse("view result escapes its source"), key: p.key, view_escape: source.escape_kind };
    }
    if (verify && p.ok && !p.template) {
      p = Produced { ...p, func: ssasem.Func { ...p.func, anchors: anchors } };
      let plan: ssasem.MergePlan = ssasem.merge_copies(p.func);
      if (plan.why != "") {
        p = Produced { ...refuse(plan.why), key: p.key };
      } else {
        if (plan.copies.len() > 0) {
          p = Produced { ...p, func: ssasem.with_merge_copies(p.func, plan.copies) };
          helpers = with_copy_helpers(helpers, p.func);
          anchors = helper_anchors(anchors, helpers);
          p = Produced { ...p, func: ssasem.Func { ...p.func, anchors: anchors } };
        }
        let analysis: ssasem.Analysis = ssasem.analyze(p.func);
        if (!analysis.ok) {
          p = Produced { ...refuse("produced graph fails semantic verification: " + analysis.why), key: p.key };
        } else {
          p = Produced { ...p, analysis: Some(analysis) };
        }
      }
    }
    out = out.append(p);
    i = i + 1;
  }
  return helper_rows(out, names, helpers, anchors);
}

// The rows of the copy helpers, after the module's own. A helper's body can
// call another helper, so the list grows as it is read.
function helper_rows(out: Produced[], names: string[], helpers: CopyHelpers, anchors: ssasem.Anchor[]): Anchored {
  let h: i32 = 0;
  while (h < helpers.types.len()) {
    let f: ssasem.Func = ssasem.copy_helper_func(helpers.from[h], helpers.types[h]);
    helpers = with_copy_helpers(helpers, f);
    anchors = helper_anchors(anchors, helpers);
    f = ssasem.Func { ...f, anchors: anchors };
    let p: Produced = Produced { ...refuse(""), ok: true, func: f, modes: [ssaunits.borrow_mode()] };
    let analysis: ssasem.Analysis = ssasem.analyze(f);
    if (!analysis.ok) {
      p = refuse("copy helper fails semantic verification: " + analysis.why);
    } else {
      p = Produced { ...p, analysis: Some(analysis) };
    }
    out = out.append(p);
    names = names.append(ssasem.copy_helper(helpers.types[h]));
    h = h + 1;
  }
  return Anchored { all: close_module(out, util.name_index(names)), names: names };
}

// The copy helpers a module's merge copies call, each with the body whose
// schemas it is built over.
struct CopyHelpers { types: typeinfo.Type[], from: ssasem.Func[] }

function with_copy_helpers(h: CopyHelpers, f: ssasem.Func): CopyHelpers {
  for t in ssasem.copy_helpers_called(f) {
    let known: boolean = false;
    for x in h.types {
      if (semtypes.equal(x, t)) {
        known = true;
      }
    }
    if (!known) {
      h = CopyHelpers { types: h.types.append(t), from: h.from.append(f) };
    }
  }
  return h;
}

// A helper's result is a fresh copy: it anchors nothing.
function helper_anchors(anchors: ssasem.Anchor[], h: CopyHelpers): ssasem.Anchor[] {
  for t in h.types {
    if (!ssasem.anchored(anchors, ssasem.copy_helper(t))) {
      anchors = anchors.append(ssasem.Anchor { name: ssasem.copy_helper(t), params: [] });
    }
  }
  return anchors;
}

// Each `return v` of a view becomes `return (v + "") as str`.
function copy_returned_views(f: ssasem.Func): ssasem.Func {
  let values: typeinfo.Type[] = f.values;
  let blocks: ssa.SBlock[] = [];
  for b in f.graph.blocks {
    let v: i32 = b.term.value;
    if (b.term.kind_tag == 1 && v >= 0 && ssasem.is_view(values[v])) {
      let first: i32 = values.len();
      for t in ssasem.view_copy_types() {
        values = values.append(t);
      }
      let insts: ssa.SInst[] = b.insts;
      for ci in ssasem.view_copy(first, v) {
        insts = insts.append(ci);
      }
      b = ssa.SBlock { ...b, insts: insts, term: t_ret(first + 2) };
    }
    blocks = blocks.append(b);
  }
  return ssasem.Func { ...f, values: values, graph: ssa.SFunc { ...f.graph, blocks: blocks, nvals: values.len() } };
}

function template_entry(key: string, ok: boolean, why: string, bodyless: boolean): Produced {
  return Produced { ...refuse(why), ok: ok, template: true, key: key, bodyless: bodyless };
}

// A template's entry is the verdict over its instances: it produced when every
// instance a produced body asked for did, and a template no produced body
// reaches has nothing to produce.
function template_verdict(key: string, instances: Produced[]): Produced {
  let seen: boolean = false;
  for p in instances {
    if (p.key == key) {
      seen = true;
      if (!p.ok) {
        return template_entry(key, false, p.why, false);
      }
    }
  }
  if (!seen) {
    return template_entry(key, false, "uninstantiated generic", true);
  }
  return template_entry(key, true, "", false);
}

function queue(pending: Request[], requests: Request[]): Request[] {
  for r in requests {
    let known: boolean = false;
    for p in pending {
      if (p.name == r.name) {
        known = true;
      }
    }
    if (!known) {
      pending = pending.append(r);
    }
  }
  return pending;
}

// A template that instantiates itself at ever-new types has no finite set of
// bodies; the worklist stops here rather than running on.
function instance_limit(): i32 {
  return 16384;
}

// build_module pairs every declaration with its checked scope, in declaration
// order, then produces every instance those bodies request, to a fixpoint over
// the instances' own requests. Refusals are per body and propagate to callers.
struct Inferred { all: Produced[], table: ssasem.Contracts }

function seed_bits(n: i32): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(true);
    i = i + 1;
  }
  return out;
}

function same_bits(a: boolean[], b: boolean[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

// The shapes the inference may hand over: a box this frame can reclaim whole
// and whose deep drop the backends already wire — an enum or a record.
//
// A bare string or array parameter is deliberately NOT one, which is native's
// first rung (`ownedByDefaultShapeIn`) and not an oversight: measured, moving
// those to the counted convention costs 4.9% on `ascii_scan` and 2.5% on
// `utf8_ingest_validated` and wins nothing, because a byte kernel reads its
// argument and hands back an index. Arrays and strings are still reclaimed —
// as the CHILDREN of an admitted box, which is where a vector node's buffer
// sits.
//
// A cell, a map, a handle and a closure environment are excluded for
// the reasons `ssaunits` already gives them: the frame is not their only
// holder, or the box is one nothing can state a mode for.
function owned_shape(t: typeinfo.Type): boolean {
  if (semtypes.is_cell(t) || semtypes.is_handle(t) || semtypes.is_env(t)) {
    return false;
  }
  if (ssasem.is_map(t) || ssasem.is_view(t)) {
    return false;
  }
  if let typeinfo.TypeUnion(_) = t {
    return true;
  }
  if let typeinfo.TypeStruct(_) = t {
    return true;
  }
  return false;
}

// A declared `own` stays counted whatever the analysis says: it carries the
// checker's affine discipline (E050) and a call site may already rely on it.
// Everything else follows the inference — a consumed enum or record parameter
// is counted, a read one borrows.
function inferred_mode(old: i32, t: typeinfo.Type, consumed: boolean): i32 {
  if (!reference(t)) {
    return old;
  }
  if (old == ssaunits.counted_mode()) {
    return old;
  }
  if (consumed && owned_shape(t)) {
    return ssaunits.counted_mode();
  }
  return old;
}

function inferred_contract(c: ssasem.Contract, rows: ownership.Escapes[], ix: ownership.Index): ssasem.Contract {
  let row: i32 = ownership.find(rows, ix, c.name);
  if (row < 0) {
    return c;
  }
  let modes: i32[] = c.modes;
  let i: i32 = 0;
  while (i < modes.len() && i < c.params.len()) {
    modes = modes.with(i, inferred_mode(modes[i], c.params[i], ownership.consumed_at(rows, row, i)));
    i = i + 1;
  }
  return ssasem.Contract { ...c, modes: modes };
}

function inferred_table(table: ssasem.Contracts, rows: ownership.Escapes[], ix: ownership.Index): ssasem.Contracts {
  let out: ssasem.Contract[] = [];
  for c in table.list {
    out = out.append(inferred_contract(c, rows, ix));
  }
  return ssasem.contracts_of(out);
}

// A produced body carries its own modes and a copy of every callee contract it
// calls through; both are rewritten from the same rows, so the definition side
// and the call site read one answer.
function inferred_produced(p: Produced, name: string, rows: ownership.Escapes[], ix: ownership.Index): Produced {
  let calls0: ssasem.Contract[] = [];
  for c in p.func.calls {
    calls0 = calls0.append(inferred_contract(c, rows, ix));
  }
  let row: i32 = ownership.find(rows, ix, name);
  if (row < 0) {
    return Produced { ...p, func: ssasem.Func { ...p.func, calls: calls0 } };
  }
  let modes: i32[] = p.modes;
  let i: i32 = 0;
  while (i < modes.len() && i < p.func.params.len()) {
    modes = modes.with(i, inferred_mode(modes[i], p.func.params[i], ownership.consumed_at(rows, row, i)));
    i = i + 1;
  }
  return Produced { ...p, modes: modes, func: ssasem.Func { ...p.func, calls: calls0 } };
}

// The greatest fixpoint: every reference parameter starts consumed and is
// demoted once a round finds no use that carries it out. Bounded by the bits
// it can clear, since a round only ever removes them — the bound below is a
// belt on that, not the reason it stops.
// A closure BODY keeps every mode it declared. The units its arguments carry
// are read off the function TYPE the box hands out, and `ssasem.closure_type`
// builds that type from these same modes — so inferring one counted rewrites
// the type and every call through the box stops matching it ("closure
// signature", on all 8771 declarations of the compiler's own parser). The
// environment parameter could not be counted in any case: `ssaunits` refuses a
// closure that consumes its environment, since nothing can state that promise.
function closure_body_produced(p: Produced): boolean {
  if (p.func.params.len() == 0) {
    return false;
  }
  return semtypes.is_env(p.func.params[0]);
}

// A builtin consumes exactly the slots its contract counts, and the rounds
// never revise that.
function builtin_row(c: ssasem.Contract): ownership.Escapes {
  let bits: boolean[] = [];
  for m in c.modes {
    bits = bits.append(m == ssaunits.counted_mode());
  }
  return ownership.Escapes { name: c.name, bits: bits, lends: reference(c.result), cycle: 0 - 1 };
}

// The analysis a row is inferred from: the one its anchoring verified, which
// `inline_leaves` keeps only where it left the graph alone. A rewritten row is
// analysed here.
function row_analysis(p: Produced): ssasem.Analysis {
  match (p.analysis) {
    Some(a) => {
      return a;
    },
    None => {
      return ssasem.analyze(p.func);
    }
  }
}

// Each produced row's quiet cycle (`ownership.cycles`): its edges are the
// direct calls between functions whose results hold no reference, including
// the named parameter phis left when tail recursion became a loop.
function quiet_cycles(rows: ownership.Escapes[], ix: ownership.Index, all: Produced[], names: string[]): ownership.Escapes[] {
  let quiet: boolean[] = [];
  let succ: i32[][] = [];
  let i: i32 = 0;
  while (i < rows.len()) {
    quiet = quiet.append(false);
    succ = succ.append([]);
    i = i + 1;
  }
  i = 0;
  while (i < all.len() && i < names.len()) {
    let at: i32 = ownership.find(rows, ix, names[i]);
    if (at >= 0 && !reference(all[i].func.result)) {
      quiet = quiet.with(at, true);
    }
    i = i + 1;
  }
  i = 0;
  while (i < all.len() && i < names.len()) {
    let at: i32 = ownership.find(rows, ix, names[i]);
    if (at >= 0 && quiet[at]) {
      let out: i32[] = [];
      for b in all[i].func.graph.blocks {
        for ins in b.insts {
          if (ins.kind_tag == ssasem.call() || ins.kind_tag == 8 && ins.str != "") {
            let to: i32 = ownership.find(rows, ix, ins.str);
            if (to >= 0 && quiet[to]) {
              out = out.append(to);
            }
          }
        }
      }
      succ = succ.with(at, out);
    }
    i = i + 1;
  }
  let comp: i32[] = ownership.cycles(succ);
  let out_rows: ownership.Escapes[] = [];
  let k: i32 = 0;
  while (k < rows.len()) {
    out_rows = out_rows.append(ownership.Escapes { ...rows[k], cycle: comp[k] });
    k = k + 1;
  }
  return out_rows;
}

function infer_rows(all: Produced[], names: string[], pinned: string[]): ownership.Escapes[] {
  let taken: string[] = pinned;
  let k: i32 = 0;
  while (k < all.len()) {
    if (all[k].ok) {
      taken = ownership.address_taken(all[k].func, taken);
    }
    k = k + 1;
  }
  let rows: ownership.Escapes[] = [];
  let analyses: ssasem.Analysis[] = [];
  let i: i32 = 0;
  while (i < all.len() && i < names.len()) {
    if (all[i].ok && !all[i].template && !closure_body_produced(all[i]) && !ownership.names_has(taken, names[i])) {
      rows = rows.append(ownership.Escapes { name: names[i], bits: seed_bits(all[i].func.params.len()), lends: false, cycle: 0 - 1 });
      analyses = analyses.append(row_analysis(all[i]));
    } else {
      analyses = analyses.append(ssasem.refused_analysis("not produced"));
    }
    i = i + 1;
  }
  let produced: ownership.Index = ownership.index(rows);
  rows = quiet_cycles(rows, produced, all, names);
  let builtins: string[] = [];
  for c in builtin_contracts() {
    if (ownership.find(rows, produced, c.name) < 0 && !ownership.names_has(builtins, c.name)) {
      rows = rows.append(builtin_row(c));
      builtins = builtins.append(c.name);
    }
  }
  // Valid while the rounds only rewrite a row's bits: a row appended below
  // would be invisible to `find`, and its function silently skipped.
  let ix: ownership.Index = ownership.index(rows);
  let own_row: i32[] = [];
  i = 0;
  while (i < all.len() && i < names.len()) {
    own_row = own_row.append(ownership.find(rows, ix, names[i]));
    i = i + 1;
  }
  let changed: boolean = true;
  let round: i32 = 0;
  while (changed && round <= all.len() + 1) {
    changed = false;
    i = 0;
    while (i < own_row.len()) {
      let at: i32 = own_row[i];
      if (all[i].ok && !all[i].template && at >= 0 && !closure_body_produced(all[i])) {
        let next: boolean[] = ownership.escaping(all[i].func, analyses[i], rows, ix);
        let lends: boolean = rows[at].lends || ownership.lends(all[i].func, analyses[i], rows, ix);
        if (!same_bits(rows[at].bits, next) || lends != rows[at].lends) {
          rows = rows.with(at, ownership.Escapes { ...rows[at], bits: next, lends: lends });
          changed = true;
        }
      }
      i = i + 1;
    }
    round = round + 1;
  }
  return rows;
}

function infer_ownership(all: Produced[], names: string[], table: ssasem.Contracts, pinned: string[]): Inferred {
  let rows: ownership.Escapes[] = infer_rows(all, names, pinned);
  let ix: ownership.Index = ownership.index(rows);
  let out: Produced[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let name: string = "";
    if (i < names.len()) {
      name = names[i];
    }
    out = out.append(inferred_produced(all[i], name, rows, ix));
    i = i + 1;
  }
  return Inferred { all: out, table: inferred_table(table, rows, ix) };
}

pub function build_module(mod: parser.Module): Built {
  return produce_module(mod, true, false);
}

// build_module_debug is build_module with the line table's markers in every
// body when `debug_lines`, the `-g` build of an ELF target.
pub function build_module_debug(mod: parser.Module, debug_lines: boolean): Built {
  return produce_module(mod, true, debug_lines);
}

// Source diagnostics need the production view-anchor fixed point, but no
// merge-copy planning, ownership verification, inlining or fusion. Keeping
// those stages out also preserves the source bodies for diagnostic evidence.
pub function check_views(mod: parser.Module): util.Diag[] {
  return view_escape_diags(mod, produce_module(mod, false, false));
}

function produce_module(mod: parser.Module, verify: boolean, debug_lines: boolean): Built {
  let scopes: checker.Scope[] = checker.module_scopes(mod);
  let table: ssasem.Contracts = contracts(mod, scopes);
  let handed_back: util.NameIndex = handers(mod);
  let shadows: string[] = shadowed_builtins(mod);
  let views: string[] = [];
  if (scopes.len() > 0) {
    views = view_types(scopes[0], mod.impls, table);
  }
  let decls: Produced[] = [];
  let names: string[] = [];
  let pending: Request[] = [];
  // The schema memo every production reads and extends, in order.
  let memo: SchemaMemo = no_memo();
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    let fd: parser.FuncDecl = mod.funcs[i];
    let p: Produced = template_entry(parser.decl_key(fd), false, "uninstantiated generic", true);
    if (!generic_decl(fd)) {
      let made: Made = build(fd, scopes[i], table, ssasem.unbound(), fd.name, handed_back, shadows, views, mod.funcs, mod.impls, memo, debug_lines);
      p = made.p;
      memo = made.memo;
    }
    pending = queue(pending, p.requests);
    decls = decls.append(p);
    names = names.append(parser.decl_key(fd));
    i = i + 1;
  }
  let instances: Produced[] = [];
  let at: i32 = 0;
  while (at < pending.len()) {
    let r: Request = pending[at];
    let di: i32 = util.index_of_str(names, r.key);
    let p: Produced = refuse("unbounded instantiation");
    if (at < instance_limit()) {
      let made: Made = build(mod.funcs[di], scopes[di], table, r.binding, r.name, handed_back, shadows, views, mod.funcs, mod.impls, memo, debug_lines);
      p = made.p;
      memo = made.memo;
    }
    pending = queue(pending, p.requests);
    instances = instances.append(Produced { ...p, key: r.key });
    names = names.append(r.name);
    at = at + 1;
  }
  let anchored: Anchored = anchor_module(close_module(util.append_all(decls, instances), util.name_index(names)), names, verify);
  let all: Produced[] = anchored.all;
  names = anchored.names;
  if (verify) {
    all = scale_ndarray_maps(fuse_pipelines(inline_leaves(all, names, mod.funcs), names), names, mod);
  }
  decls = [];
  instances = [];
  i = 0;
  while (i < all.len()) {
    if (i < mod.funcs.len()) {
      decls = decls.append(all[i]);
    } else {
      instances = instances.append(all[i]);
    }
    i = i + 1;
  }
  i = 0;
  while (i < decls.len()) {
    if (decls[i].template) {
      decls = decls.with(i, template_verdict(names[i], instances));
    }
    i = i + 1;
  }
  return Built { decls: decls, instances: instances, contracts: table, names: names, dyn_arms: dispatched_arms(util.append_all(decls, instances)) };
}

// Translate proven source escapes while the original declaration still
// supplies its location. Instances name their template's declaration; one
// bad instantiation reports it once, without diagnostics on refused callers.
pub function view_escape_diags(mod: parser.Module, built: Built): util.Diag[] {
  let kinds: i32[] = [];
  let names: string[] = [];
  let i: i32 = 0;
  while (i < mod.funcs.len()) {
    kinds = kinds.append(built.decls[i].view_escape);
    names = names.append(parser.decl_key(mod.funcs[i]));
    i = i + 1;
  }
  for p in built.instances {
    let at: i32 = util.index_of_str(names, p.key);
    if (p.view_escape > 0 && at >= 0 && kinds[at] == 0) {
      kinds = kinds.with(at, p.view_escape);
    }
  }
  let out: util.Diag[] = [];
  i = 0;
  while (i < kinds.len()) {
    if (kinds[i] > 0) {
      let code: string = "E063";
      if (kinds[i] == 2) {
        code = "E065";
      }
      let fd: parser.FuncDecl = mod.funcs[i];
      // Annotation can already have expanded a generic into concrete
      // declarations. Those clones keep the source declaration's position.
      let reported: boolean = false;
      for d in out {
        if (fd.line > 0 && d.code == code && d.line == fd.line && d.col == fd.col) {
          reported = true;
        }
      }
      if (!reported) {
        out = out.append(util.Diag {
          code: code,
          message: "the returned view's source cannot be kept alive beyond this function: return owned storage or a view of a parameter instead",
          line: fd.line, col: fd.col,
        });
      }
    }
    i = i + 1;
  }
  return out;
}

// Tiny scalar leaves spliced into their callers (seminline). A declaration
// marked @noinline stays a call, and so does every instance. `FERN_SEM_INLINE=`
// (set but empty) turns the pass off, for comparing a build against itself.
function inline_leaves(all: Produced[], names: string[], decls: parser.FuncDecl[]): Produced[] {
  if (!inline_on()) {
    return all;
  }
  let funcs: ssasem.Func[] = [];
  let inlinable: boolean[] = [];
  let rewrite: boolean[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    let usable: boolean = p.ok && !p.template && !p.bodyless;
    funcs = funcs.append(p.func);
    rewrite = rewrite.append(usable);
    inlinable = inlinable.append(usable && i < decls.len() && !decls[i].no_inline);
    i = i + 1;
  }
  let out: seminline.Inlined = seminline.inline_leaves(funcs, names, inlinable, rewrite);
  let result: Produced[] = [];
  i = 0;
  while (i < all.len()) {
    let p: Produced = Produced { ...all[i], func: out.funcs[i] };
    if (out.rewritten[i]) {
      p = Produced { ...p, analysis: None };
    }
    result = result.append(p);
    i = i + 1;
  }
  return result;
}

function inline_on(): boolean {
  match (env("FERN_SEM_INLINE")) {
    Some(v) => {
      return v.len() > 0;
    },
    None => {
      return true;
    }
  }
}

// std/array combinator chains fused into one loop (semfuse).
// `FERN_NO_ARRAY_FUSION=1` turns the pass off, as it does native's.
function fuse_pipelines(all: Produced[], names: string[]): Produced[] {
  let enabled: boolean = fusion_on();
  let report: boolean = semarrayreport.enabled();
  if (!enabled && !report) {
    return all;
  }
  let funcs: ssasem.Func[] = [];
  let usable: boolean[] = [];
  for p in all {
    funcs = funcs.append(p.func);
    usable = usable.append(p.ok && !p.template && !p.bodyless);
  }
  let out: semfuse.Fused = semfuse.fuse_pipelines(funcs, names, usable, enabled, report);
  if (report) {
    eprint(semarrayreport.render(out.sites));
  }
  let result: Produced[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    if (out.rewritten[i]) {
      p = Produced { ...p, func: out.funcs[i], analysis: None };
    }
    result = result.append(p);
    i = i + 1;
  }
  return result;
}

function scale_ndarray_maps(all: Produced[], names: string[], mod: parser.Module): Produced[] {
  if (!util.has_str(names, "__smm_ndarray__NdArray_map__f64__f64")) {
    return all;
  }
  match (env("FERN_NO_SCALE_KERNEL")) {
    Some(v) => {
      if (v == "1") {
        return all;
      }
    },
    None => {}
  }
  let funcs: ssasem.Func[] = [];
  let usable: boolean[] = [];
  for p in all {
    funcs = funcs.append(p.func);
    usable = usable.append(p.ok && !p.template && !p.bodyless);
  }
  let open: boolean[] = ndarray_open(all, names, mod, funcs);
  let out: semndarray.Scaled = semndarray.scale_maps(funcs, names, usable, open);
  let result: Produced[] = [];
  let i: i32 = 0;
  while (i < all.len()) {
    let p: Produced = all[i];
    if (out.rewritten[i]) {
      p = Produced { ...p, func: out.funcs[i], analysis: None };
    }
    result = result.append(p);
    i = i + 1;
  }
  return result;
}

function ndarray_open(all: Produced[], names: string[], mod: parser.Module, funcs: ssasem.Func[]): boolean[] {
  // A direct-call census does not account for exported functions, methods
  // invoked through dyn dispatch, or closure entry points. Keep their
  // parameters unknown even when their visible callers all pass packed data.
  let roots: string[] = ["main"];
  for fd in mod.funcs {
    // Flattening makes every declaration public inside the merged module.
    // Source visibility is not an external entry point; mod.exports is.
    if (fd.receiver_type != "") {
      roots = roots.append(parser.decl_key(fd));
    }
  }
  for ex in mod.exports {
    roots = roots.append(ex.func_name);
  }
  for f in funcs {
    roots = ownership.address_taken(f, roots);
  }
  let root_index: util.NameIndex = util.name_index(roots);
  let open: boolean[] = [];
  let j: i32 = 0;
  while (j < all.len()) {
    open = open.append(root_index.find(names[j]) >= 0 || root_index.find(all[j].key) >= 0 || closure_body_produced(all[j]));
    j = j + 1;
  }
  return open;
}

function fusion_on(): boolean {
  match (env("FERN_NO_ARRAY_FUSION")) {
    Some(v) => {
      return v != "1";
    },
    None => {
      return true;
    }
  }
}

// The implementations a dyn call on `method` over `traits` reaches: the
// methods `parser.dyn_arm_matches` picks, less an array method's `T[]`
// receiver, which no chain takes. The call's name carries them to the
// backends, whose dispatch chains run over exactly these arms.
// A method is an arm only on a type that implements the whole trait set: a
// type with a same-named method of its own is never inside the dyn. A
// monomorphised clone `base__…` implements what its generic base does. The
// receiver is keyed by parser.receiver_base, as implements_traits keys the
// impl list and decl_key names the arm, so a `str` receiver is `string`.
pub function dyn_arms(funcs: parser.FuncDecl[], impls: parser.ImplInfo[], method: string, traits: string[]): string[] {
  let out: string[] = [];
  for fd in funcs {
    let n: i32 = fd.receiver_type.len();
    if (n == 0 || n >= 2 && slice_unchecked(fd.receiver_type, n - 2, n) == "[]") {
      continue;
    }
    if (!arm_receiver_implements(impls, parser.receiver_base(fd.receiver_type), traits)) {
      continue;
    }
    if (parser.dyn_arm_matches(fd, traits, method)) {
      out = out.append(parser.decl_key(fd));
    }
  }
  return out;
}

function arm_receiver_implements(impls: parser.ImplInfo[], n: string, traits: string[]): boolean {
  if (implements_traits(impls, n, traits)) {
    return true;
  }
  let at: i32 = 1;
  while (at + 1 < n.len() && !(n[at] == b'_' && n[at + 1] == b'_')) {
    at = at + 1;
  }
  return at + 1 < n.len() && implements_traits(impls, slice_unchecked(n, 0, at) + "", traits);
}

function dispatched_arms(all: Produced[]): string[] {
  let out: string[] = [];
  for p in all {
    if (!p.ok) {
      continue;
    }
    for b in p.func.graph.blocks {
      for ins in b.insts {
        if (ins.kind_tag != ssasem.call() || !ssasem.is_dyn_call(ins.str)) {
          continue;
        }
        for arm in ssasem.dyn_call_arms(ins.str) {
          if (util.index_of_str(out, arm) < 0) {
            out = out.append(arm);
          }
        }
      }
    }
  }
  return out;
}

// The same module with every consumed parameter counted. Kept OUT of
// `build_module` because only the caller knows whether the inference is safe
// to use: a mode inferred here is invisible to the AST lowering, so it holds
// only where the typed pipeline lowers every body of the module. `semlower`
// is the layer that knows that — it is what `prune` decides — so it asks for
// this and checks the answer still lowers whole before keeping it.
pub function with_inferred_modes(b: Built): Built {
  let all: Produced[] = util.append_all(b.decls, b.instances);
  let inferred: Inferred = infer_ownership(all, b.names, b.contracts, b.dyn_arms);
  let decls: Produced[] = [];
  let instances: Produced[] = [];
  let i: i32 = 0;
  while (i < inferred.all.len()) {
    if (i < b.decls.len()) {
      decls = decls.append(inferred.all[i]);
    } else {
      instances = instances.append(inferred.all[i]);
    }
    i = i + 1;
  }
  return Built { decls: decls, instances: instances, contracts: inferred.table, names: b.names, dyn_arms: b.dyn_arms };
}

// Which rows the inference moved, in the order `semlower.rows_planned` walks
// them: every declaration, then every instance. All false means no parameter
// changed hands and the inferred modes would produce the same bodies throughout.
//
// Per row rather than per module, because a row the inference did not move
// keeps its body: `ssaunits.plan` reads a declaration's own modes and the
// contracts of what it calls, so a row where both are identical plans and
// lowers identically. Answering only "somewhere" made the caller re-lower
// everywhere (#9969).
pub function changed_rows(a: Built, b: Built): boolean[] {
  let out: boolean[] = [];
  let i: i32 = 0;
  while (i < a.decls.len() && i < b.decls.len()) {
    out = out.append(produced_moved(a.decls[i], b.decls[i]));
    i = i + 1;
  }
  i = 0;
  while (i < a.instances.len() && i < b.instances.len()) {
    out = out.append(produced_moved(a.instances[i], b.instances[i]));
    i = i + 1;
  }
  return out;
}

// Whether the inference moved anything at all, which is what decides between
// the declared module and the widened one. Lives here rather than in each
// caller because `semlower` and the census both ask it of the same array.
pub function any_row_changed(changed: boolean[]): boolean {
  for c in changed {
    if (c) {
      return true;
    }
  }
  return false;
}

// A row moved when its own modes changed, or when any contract it calls did:
// `inferred_produced` rewrites every row's `func.calls` whether or not that
// row's own parameters moved, and a caller's brackets read the callee's modes.
function produced_moved(a: Produced, b: Produced): boolean {
  if (!same_bits_i32(a.modes, b.modes)) {
    return true;
  }
  return !same_call_modes(a.func.calls, b.func.calls);
}

function same_call_modes(a: ssasem.Contract[], b: ssasem.Contract[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i].name != b[i].name) {
      return false;
    }
    if (!same_bits_i32(a[i].modes, b[i].modes)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function same_bits_i32(a: i32[], b: i32[]): boolean {
  if (a.len() != b.len()) {
    return false;
  }
  let i: i32 = 0;
  while (i < a.len()) {
    if (a[i] != b[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}
