import "std/io";
import "./lexer";
import "./parser";
import "./asm_ir";
import "./util";

function main(): i32 {
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    var bm: parser.Module = parser.module_with_builtins(mod);
    var lm: parser.Module = asm_ir.lift_lambdas(bm);
    var i: i32 = 0;
    while (i < lm.funcs.len()) {
        var fn: parser.FuncDecl = lm.funcs[i];
        print("fn name=" + fn.name + " recv_name=" + fn.receiver_name + " recv_type=" + fn.receiver_type + " ret=" + fn.ret_type + "\n");
        i = i + 1;
    }
    var si: i32 = 0;
    while (si < lm.structs.len()) {
        print("struct name=" + lm.structs[si].name + " enum_owner=" + lm.structs[si].enum_owner + "\n");
        si = si + 1;
    }
    return 0;
}
