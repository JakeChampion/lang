// Verified semantic ownership to the production stack IR. No AST ownership
// facts or alternate backend ABI enter this boundary.
import "./ir";
import "./irlower";
import "./ssa";
import "./ssadeps";
import "./ssasem";
import "./ssalayout";
import "./ssaunits";
import "./semrecords";
import "./typeinfo";

function empty(why: string): irlower.LowerResult {
    return irlower.LowerResult { ok: false, why: why, ops: [], n_locals: 0,
        n_params: 0, erased_wide: false, arr_slots: [], i64_slots: [],
        f64_slots: [], str_slots: [], alias_incs: [], name: "", result_kind: irlower.result_i32() };
}

// This physical boundary refuses types whose stack representation is not
// implemented here, even when the unit planner knows their abstract
// ownership: wide scalars, string views, and a record with no schema or with
// type arguments (its box is named by the bare declaration).
function supported_tuple(tup: typeinfo.TypeTuple, f: ssasem.Func): boolean {
    for elem in tup.elements { if (!supported(elem, f)) { return false; } }
    return true;
}
function supported(t: typeinfo.Type, f: ssasem.Func): boolean {
    if let typeinfo.TypeI32(i) = t { return i.width == 32; }
    if let typeinfo.TypeBool(_) = t { return true; }
    if let typeinfo.TypeVoid(_) = t { return true; }
    if let typeinfo.TypeString(_) = t { return ssasem.is_string(t); }
    if let typeinfo.TypeArray(a) = t { return supported(a.elem, f); }
    if let typeinfo.TypeTuple(tup) = t { return supported_tuple(tup, f); }
    if let typeinfo.TypeStruct(r) = t { return r.args.len() == 0 && semrecords.find(f.records, t) >= 0; }
    if let typeinfo.TypeUnion(u) = t { return u.args.len() == 0 && semrecords.find_enum(f.enums, t) >= 0; }
    return false;
}

function reference(t: typeinfo.Type): boolean {
    if let typeinfo.TypeString(_) = t { return true; }
    if let typeinfo.TypeArray(_) = t { return true; }
    if let typeinfo.TypeTuple(_) = t { return true; }
    if let typeinfo.TypeStruct(_) = t { return true; }
    if let typeinfo.TypeUnion(_) = t { return true; }
    return false;
}

function record_name(t: typeinfo.Type): string {
    if let typeinfo.TypeStruct(r) = t { return r.name; }
    return "";
}

function record_fields(t: typeinfo.Type, f: ssasem.Func): semrecords.Field[] {
    return f.records[semrecords.find(f.records, t)].fields;
}

function variants_of(t: typeinfo.Type, f: ssasem.Func): semrecords.Variant[] {
    return f.enums[semrecords.find_enum(f.enums, t)].variants;
}

function fields_have_children(fields: semrecords.Field[]): boolean {
    for field in fields { if (reference(field.ty)) { return true; } }
    return false;
}

// A string box is released by its own helper: its block starts before the
// value, where an array's starts before the data words.
// A string slice's box is this function's, but its bytes belong to the source.
// __fern_str_view_free frees the box alone when the rc is the immortal view
// sentinel and takes the ordinary path otherwise, which is what makes one
// release symbol correct on both the register backends and wasm (whose slices
// copy, so the result is an ordinary counted box).
function release_name(t: typeinfo.Type, view: boolean): string {
    if let typeinfo.TypeString(_) = t {
        if (view) { return "__fern_str_view_free"; }
        return "__fern_str_free";
    }
    return "__fern_rc_dec";
}

// Whether `value` is the result of a slice, and so holds a borrowed-byte box.
function slice_result(f: ssasem.Func, value: i32): boolean {
    for b in f.graph.blocks {
        for ins in b.insts { if (ins.result == value && ins.kind_tag == ssasem.slice()) { return true; } }
    }
    return false;
}

function emit(r: irlower.LowerResult, op: ir.Op): irlower.LowerResult {
    return irlower.LowerResult { ...r, ops: r.ops.append(op) };
}

function helper(r: irlower.LowerResult, slot: i32, name: string): irlower.LowerResult {
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_call_direct(name, 1));
    return emit(r, ir.op_drop());
}

function supplies(r: irlower.LowerResult, step: ssaunits.Step): irlower.LowerResult {
    for supply in step.supplies {
        if (supply.mode == ssaunits.retain_unit()) { r = helper(r, supply.value, "__fern_rc_inc"); }
    }
    // A move transfers the existing unit. Value locals are never implicitly
    // swept, so neither a runtime decrement nor a clear is needed for a move.
    return r;
}

// Scratch storage is shared by successive drops and distinct within recursion.
function reserve(r: irlower.LowerResult, end: i32): irlower.LowerResult {
    if (end > r.n_locals) { return irlower.LowerResult { ...r, n_locals: end }; }
    return r;
}

// A parent owns one unit per reference field. Shared parents release only
// their own unit; the final parent release walks children before its box.
// Array/tuple/struct opcodes preserve the production native/Wasm layouts.
function has_children(t: typeinfo.Type, f: ssasem.Func): boolean {
    if let typeinfo.TypeArray(a) = t { return reference(a.elem); }
    if let typeinfo.TypeTuple(tup) = t {
        for elem in tup.elements { if (reference(elem)) { return true; } }
    }
    if let typeinfo.TypeStruct(_) = t { return fields_have_children(record_fields(t, f)); }
    if let typeinfo.TypeUnion(_) = t {
        for v in variants_of(t, f) { if (fields_have_children(v.fields)) { return true; } }
    }
    return false;
}

function drop_value(r: irlower.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irlower.LowerResult {
    if (has_children(t, f)) {
        r = emit(r, ir.op_load_local(slot));
        r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
        r = emit(r, ir.op_if(0));
        if let typeinfo.TypeArray(a) = t { r = drop_elements(r, slot, a.elem, scratch, f); }
        if let typeinfo.TypeTuple(tup) = t { r = drop_tuple_fields(r, slot, tup, scratch, f); }
        if (named(t) != "") { r = helper(r, slot, drop_helper_name(t)); }
        r = emit(r, ir.op_end());
    }
    return helper(r, slot, release_name(t, slice_result(f, slot)));
}

// A variant box carries only its own variant's fields, so the walk selects
// them by the box's runtime variant.
function drop_variant_fields(r: irlower.LowerResult, slot: i32, variants: semrecords.Variant[], scratch: i32, f: ssasem.Func): irlower.LowerResult {
    for v in variants {
        if (fields_have_children(v.fields)) {
            r = emit(r, ir.op_load_local(slot));
            r = emit(r, ir.op_variant_is(v.name));
            r = emit(r, ir.op_if(0));
            r = drop_record_fields(r, slot, v.fields, scratch, f);
            r = emit(r, ir.op_end());
        }
    }
    return r;
}

function drop_elements(r: irlower.LowerResult, slot: i32, elem: typeinfo.Type, scratch: i32, f: ssasem.Func): irlower.LowerResult {
    var index: i32 = scratch;
    var child: i32 = index + 1;
    r = reserve(r, child + 1);
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_store_local(index));
    r = emit(r, ir.op_block(0));
    r = emit(r, ir.op_loop(0));
    r = emit(r, ir.op_load_local(index));
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_arr_len());
    r = emit(r, ir.op_bin("ge_s", 0, false));
    r = emit(r, ir.op_brif(1));
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_load_local(index));
    r = emit(r, ir.op_arr_get_nc(32));
    r = emit(r, ir.op_store_local(child));
    r = drop_value(r, child, elem, child + 1, f);
    r = emit(r, ir.op_load_local(index));
    r = emit(r, ir.op_const_i32(1));
    r = emit(r, ir.op_bin("add", 0, false));
    r = emit(r, ir.op_store_local(index));
    r = emit(r, ir.op_br(0));
    r = emit(r, ir.op_end());
    return emit(r, ir.op_end());
}

function drop_tuple_fields(r: irlower.LowerResult, slot: i32, tup: typeinfo.TypeTuple, scratch: i32, f: ssasem.Func): irlower.LowerResult {
    var child: i32 = scratch;
    r = reserve(r, child + 1);
    var i: i32 = 0;
    while (i < tup.elements.len()) {
        if (reference(tup.elements[i])) {
            r = emit(r, ir.op_load_local(slot));
            r = emit(r, ir.op_tuple_get(i));
            r = emit(r, ir.op_store_local(child));
            r = drop_value(r, child, tup.elements[i], child + 1, f);
        }
        i = i + 1;
    }
    return r;
}

function drop_record_fields(r: irlower.LowerResult, slot: i32, fields: semrecords.Field[], scratch: i32, f: ssasem.Func): irlower.LowerResult {
    var child: i32 = scratch;
    r = reserve(r, child + 1);
    var i: i32 = 0;
    while (i < fields.len()) {
        if (reference(fields[i].ty)) {
            r = emit(r, ir.op_load_local(slot));
            r = emit(r, ir.op_struct_get(i, 0));
            r = emit(r, ir.op_store_local(child));
            r = drop_value(r, child, fields[i].ty, child + 1, f);
        }
        i = i + 1;
    }
    return r;
}

function drops(r: irlower.LowerResult, step: ssaunits.Step, f: ssasem.Func): irlower.LowerResult {
    for value in step.drops { r = drop_value(r, value, f.values[value], f.graph.nvals, f); }
    return r;
}

function at(p: ssaunits.Plan, block: i32, point: i32, target: i32): ssaunits.Step {
    for step in p.steps {
        if (step.block == block && step.point == point && step.target == target) { return step; }
    }
    // Unreachable after verification of the complete plan.
    return ssaunits.Step { block: 0 - 1, point: point, target: 0 - 1, supplies: [], drops: [] };
}

function block_index(f: ssa.SFunc, id: i32): i32 {
    var i: i32 = 0;
    while (i < f.blocks.len()) { if (f.blocks[i].id == id) { return i; } i = i + 1; }
    return 0 - 1;
}

function successors(t: ssa.STerm): i32[] {
    if (t.kind_tag == 2) { return [t.target]; }
    if (t.kind_tag == 3) {
        if (t.t == t.f) { return [t.t]; }
        return [t.t, t.f];
    }
    return [];
}

function edge(r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, from: i32, target: i32): irlower.LowerResult {
    var step: ssaunits.Step = at(p, from, ssaunits.edge_point(), target);
    r = supplies(r, step);
    var dest: ssa.SBlock = f.graph.blocks[block_index(f.graph, target)];
    var pi: i32 = 0;
    while (dest.preds[pi] != from) { pi = pi + 1; }
    // All phi sources remain on the operand stack while old edge units are
    // released. Assign in reverse stack order, after every source was read.
    // Drop helpers and their nested scopes preserve the existing stack prefix.
    for ins in dest.insts {
        if (ins.kind_tag == 8) { r = emit(r, ir.op_load_local(ins.args[pi])); }
    }
    r = drops(r, step, f);
    var i: i32 = dest.insts.len() - 1;
    while (i >= 0) {
        var ins: ssa.SInst = dest.insts[i];
        if (ins.kind_tag == 8) { r = emit(r, ir.op_store_local(ins.result)); }
        i = i - 1;
    }
    return r;
}

function walkable_tuple(tup: typeinfo.TypeTuple, f: ssasem.Func): boolean {
    for elem in tup.elements { if (!walkable(elem, f)) { return false; } }
    return true;
}

// What a schema field has to satisfy is weaker than what a value has to: the
// walk visits only the REFERENCE fields, so a scalar one needs no vocabulary
// here at all, and an array or tuple of scalars needs only its own box
// released. Asking `supported` of every field instead refuses a function for
// a field it never reads.
function walkable(t: typeinfo.Type, f: ssasem.Func): boolean {
    if let typeinfo.TypeArray(a) = t { return walkable(a.elem, f); }
    if let typeinfo.TypeTuple(tup) = t { return walkable_tuple(tup, f); }
    if (reference(t)) { return supported(t, f); }
    if let typeinfo.TypeI32(_) = t { return true; }
    if let typeinfo.TypeBool(_) = t { return true; }
    if let typeinfo.TypeFloat(fl) = t { return fl.width == 32 || fl.width == 64; }
    return false;
}

function schema_types_error(f: ssasem.Func): string {
    for record in f.records {
        for field in record.fields { if (!walkable(field.ty, f)) { return "unsupported physical RC record field type"; } }
    }
    for e in f.enums {
        for v in e.variants {
            for field in v.fields { if (!walkable(field.ty, f)) { return "unsupported physical RC variant field type"; } }
        }
    }
    return "";
}

function named(t: typeinfo.Type): string {
    if let typeinfo.TypeStruct(r) = t { return r.name; }
    if let typeinfo.TypeUnion(u) = t { return u.name; }
    return "";
}

// A nominal type's children are released by its own helper rather than by an
// inline expansion. The descent that would close a cycle is a call, so a type
// that reaches itself still has a finite lowering. The helper releases the
// box's CHILDREN ONLY: its caller has already proved __fern_rc_is_unique(box)
// and releases the box itself once the helper returns.
//
// Distinct from the AST path's __struct_drop_<T>, which guards each nested
// field itself and hands back the box. The two are not interchangeable.
pub function drop_helper_name(t: typeinfo.Type): string { return "__sem_drop_" + named(t); }

// n_locals starts at n_params: `reserve` only grows it, and a body whose frame
// is smaller than its parameters puts the prologue's parameter copy below the
// allocated frame.
function one_helper(t: typeinfo.Type, f: ssasem.Func): irlower.LowerResult {
    var r: irlower.LowerResult = irlower.LowerResult { ...empty(""), ok: true,
        n_params: 1, n_locals: 1, name: drop_helper_name(t) };
    if let typeinfo.TypeStruct(_) = t { r = drop_record_fields(r, 0, record_fields(t, f), 1, f); }
    if let typeinfo.TypeUnion(_) = t { r = drop_variant_fields(r, 0, variants_of(t, f), 1, f); }
    // The one value the caller's `drop` after the call discards.
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_return());
    var optimized: ir.OptimizedOps = ir.optimize_ops(r.ops, 1, r.n_locals);
    return irlower.LowerResult { ...r, ops: optimized.ops, n_locals: optimized.n_locals };
}

// One helper per nominal schema the walk can call, gated on has_children —
// the same predicate that decides whether drop_value emits the call, so every
// call this function's lowering makes has a body here. A schema the function
// mentions but never drops yields a body nothing reaches, which the weak
// linkage discards; the reverse, a call with no body, is what the shared gate
// rules out. A function's schema set is closed under field reachability, so
// iterating it also reaches the types the bodies themselves call.
pub function drop_helpers(f: ssasem.Func): irlower.LowerResult[] {
    var out: irlower.LowerResult[] = [];
    for rec in f.records { if (has_children(rec.ty, f)) { out = out.append(one_helper(rec.ty, f)); } }
    for e in f.enums { if (has_children(e.ty, f)) { out = out.append(one_helper(e.ty, f)); } }
    return out;
}

function named_index(rows: irlower.LowerResult[], name: string): i32 {
    var i: i32 = 0;
    while (i < rows.len()) { if (rows[i].name == name) { return i; } i = i + 1; }
    return 0 - 1;
}

function replaced(rows: irlower.LowerResult[], at: i32, row: irlower.LowerResult): irlower.LowerResult[] {
    var out: irlower.LowerResult[] = [];
    var i: i32 = 0;
    while (i < rows.len()) {
        if (i == at) { out = out.append(row); } else { out = out.append(rows[i]); }
        i = i + 1;
    }
    return out;
}

// Two functions that both mention a type each produce a helper for it, so the
// tail is merged by symbol. A body lowered from a declaration carries no name,
// so scanning the whole cache cannot collide with one.
//
// The bodies are built from a schema table the whole module shares, so they
// agree. A disagreement would be a miscompile rather than a preference, and
// the .weak linkage that lets duplicates co-link would pick one silently — so
// it becomes a refusal the emit path stops on instead.
pub function merge_helpers(cache: irlower.LowerResult[], helpers: irlower.LowerResult[]): irlower.LowerResult[] {
    var out: irlower.LowerResult[] = cache;
    for h in helpers {
        var at: i32 = named_index(out, h.name);
        if (at < 0) { out = out.append(h); }
        else if (!ir.ops_equal(out[at].ops, h.ops) || out[at].n_params != h.n_params
                || out[at].n_locals != h.n_locals) {
            out = replaced(out, at, irlower.LowerResult { ...h, ok: false,
                why: "conflicting drop helper for " + h.name });
        }
    }
    return out;
}

function types_error(f: ssasem.Func): string {
    var why: string = schema_types_error(f);
    if (why != "") { return why; }
    for t in f.values { if (!supported(t, f)) { return "unsupported physical RC value type"; } }
    if (!supported(f.result, f)) { return "unsupported physical RC result type"; }
    for c in f.calls {
        for t in c.params { if (!supported(t, f)) { return "unsupported physical RC call parameter type"; } }
        if (!supported(c.result, f)) { return "unsupported physical RC call result type"; }
    }
    return "";
}

function validate(f: ssasem.Func, modes: i32[], p: ssaunits.Plan): string {
    var why: string = ssaunits.verify(f, modes, p);
    if (why != "") { return why; }
    why = types_error(f);
    if (why != "") { return why; }
    // Keep this physical vocabulary closed when semantic analysis grows new
    // operations. Verification of a new operation does not implement its ABI.
    for b in f.graph.blocks {
        for ins in b.insts {
            if (!supported_op(ins.kind_tag)) { return "unsupported physical RC operation"; }
        }
    }
    return "";
}

function scalar_op(k: i32): boolean {
    return k == 1 || k == 2 || k == 5 || k == 6 || k == 7 || k == 8 || k == 9 || k == 10 || k == ssasem.call();
}

function container_op(k: i32): boolean {
    return k == ssasem.array_new() || k == ssasem.tuple_new() || k == ssasem.record_new()
        || k == ssasem.array_get() || k == ssasem.tuple_get() || k == ssasem.record_get()
        || k == ssasem.length() || k == ssasem.append() || k == ssasem.slice()
        || k == ssasem.str_index() || variant_op(k);
}

function variant_op(k: i32): boolean {
    return k == ssasem.variant_new() || k == ssasem.variant_is() || k == ssasem.variant_get()
        || identity_op(k);
}

// A struct-union's member is its own box, so widening and narrowing move no
// bytes: the operand is already on the stack and the store below takes it.
function identity_op(k: i32): boolean {
    return k == ssasem.variant_up() || k == ssasem.variant_as();
}

function supported_op(k: i32): boolean { return scalar_op(k) || container_op(k); }

function frame(f: ssasem.Func): irlower.LowerResult {
    var r: irlower.LowerResult = empty("");
    r = irlower.LowerResult { ...r, ok: true, n_params: f.params.len(), n_locals: f.graph.nvals };
    var vi: i32 = 0;
    while (vi < f.values.len()) {
        if let typeinfo.TypeArray(_) = f.values[vi] { r = irlower.LowerResult { ...r, arr_slots: r.arr_slots.append(vi) }; }
        if let typeinfo.TypeString(_) = f.values[vi] { r = irlower.LowerResult { ...r, str_slots: r.str_slots.append(vi) }; }
        vi = vi + 1;
    }
    return r;
}

function binary_kind(op: string): string {
    if (op == "+") { return "add"; }
    if (op == "/") { return "div_s"; }
    if (op == "%") { return "rem_s"; }
    if (op == "&") { return "and"; }
    if (op == "|") { return "or"; }
    if (op == "^") { return "xor"; }
    if (op == "<<") { return "shl"; }
    if (op == ">>") { return "shr_s"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "<") { return "lt_s"; }
    if (op == "<=") { return "le_s"; }
    if (op == ">") { return "gt_s"; }
    if (op == ">=") { return "ge_s"; }
    if (op == "==") { return "eq"; }
    return "ne";
}

// `+`, `-`, `*` and `<<` are the operators whose result can leave the range its
// type names; every other one lands inside a range its operands are already in,
// and a comparison lands in a boolean.
function wraps(op: string): boolean {
    return op == "+" || op == "-" || op == "*" || op == "<<";
}

// Scalar operators are verified i32/boolean contracts; negation is the
// stack IR's zero-minus form. A string `+` is the runtime's concatenation,
// a fresh box; string equality reads both operands. The verifier admits no
// other string operator (ssasem.string_result), so a string binary that is
// not `+` is `==` or `!=`.
//
// The stack IR runs the integer operators in a register WIDER than the type
// they are written at, so a result that can exceed the width is masked back to
// it explicitly. The AST lowering has emitted that step since #3581 and this
// boundary did not, which made a produced `2147483647 + 1` the wide 2147483648
// instead of INT_MIN.
function scalar(r: irlower.LowerResult, ins: ssa.SInst, strings: boolean): irlower.LowerResult {
    if (ins.kind_tag == 9 && strings) {
        if (ins.str == "+") { return emit(r, ir.op_str_concat()); }
        r = emit(r, ir.op_str_eq());
        if (ins.str == "!=") { r = emit(r, ir.op_bin("not", 0, false)); }
        return r;
    }
    if (ins.kind_tag == 10 && ins.str == "!") { return emit(r, ir.op_bin("not", 0, false)); }
    if (ins.kind_tag == 9) { r = emit(r, ir.op_bin(binary_kind(ins.str), 0, false)); }
    else { r = emit(r, ir.op_bin("sub", 0, false)); }
    if (!wraps(ins.str)) { return r; }
    return emit(r, ir.op_int_cast("i32"));
}

// A record box is named by its declaration, a variant box by its variant. The
// -1 declaration index withholds the per-field store width, which only a
// construction needs and only wasm reads; every value this vocabulary admits
// is one i32-shaped word, so nothing built here needs a wider store. A schema
// may name a wider field, but a walk only READS it, at an offset the backends
// take from the field index alone.
function container(r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    if (variant_op(ins.kind_tag)) { return variant(r, ins); }
    if (ins.kind_tag == ssasem.array_new()) { return emit(r, ir.op_arr_make(ins.args.len(), 32)); }
    if (ins.kind_tag == ssasem.tuple_new()) { return emit(r, ir.op_tuple_make(ins.args.len())); }
    if (ins.kind_tag == ssasem.record_new()) { return emit(r, ir.op_struct_make(record_name(f.values[ins.result]), ins.args.len(), 0 - 1)); }
    if (ins.kind_tag == ssasem.length()) {
        if (ssasem.is_string(f.values[ins.args[0]])) { return emit(r, ir.op_str_len()); }
        return emit(r, ir.op_arr_len());
    }
    // The unit planner admits an append only where the receiver's unit is
    // moved, which is exactly the sole-ownership the reclaim-on-grow form needs.
    if (ins.kind_tag == ssasem.append()) { return emit(r, ir.op_arr_push_owned()); }
    if (ins.kind_tag == ssasem.slice()) { return emit(r, ir.op_str_slice()); }
    if (ins.kind_tag == ssasem.str_index()) { return emit(r, ir.op_str_index()); }
    if (ins.kind_tag == ssasem.array_get()) { return emit(r, ir.op_arr_get(32)); }
    if (ins.kind_tag == ssasem.tuple_get()) { return emit(r, ir.op_tuple_get(ins.imm)); }
    return emit(r, ir.op_struct_get(ins.imm, 0));
}

function variant(r: irlower.LowerResult, ins: ssa.SInst): irlower.LowerResult {
    if (identity_op(ins.kind_tag)) { return r; }
    if (ins.kind_tag == ssasem.variant_new()) { return emit(r, ir.op_struct_make(ins.str, ins.args.len(), 0 - 1)); }
    if (ins.kind_tag == ssasem.variant_is()) { return emit(r, ir.op_variant_is(ins.str)); }
    return emit(r, ir.op_struct_get(ins.imm, 0));
}

function instruction(r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    if (ins.kind_tag == 10 && ins.str == "-") { r = emit(r, ir.op_const_i32(0)); }
    for arg in ins.args { r = emit(r, ir.op_load_local(arg)); }
    if (ins.kind_tag == 1 || ins.kind_tag == 2) { r = emit(r, ir.op_const_i32(ins.imm)); }
    if (ins.kind_tag == 5) { r = emit(r, ir.op_const_str(ins.str)); }
    if (ins.kind_tag == 9 || ins.kind_tag == 10) { r = scalar(r, ins, ssasem.is_string(f.values[ins.args[0]])); }
    if (container_op(ins.kind_tag)) { r = container(r, f, ins); }
    // A call's counted parameters were supplied before its operands were
    // loaded; its result is the unit the callee returns.
    if (ins.kind_tag == ssasem.call()) { r = emit(r, ir.op_call_direct(ins.str, ins.args.len())); }
    // A verified copy already has its single operand on the stack.
    return emit(r, ir.op_store_local(ins.result));
}

function block_body(r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, b: ssa.SBlock): irlower.LowerResult {
    r = drops(r, at(p, b.id, ssaunits.entry_point(), 0 - 1), f);
    var pos: i32 = 0;
    for ins in b.insts {
        if (ins.kind_tag != 6 && ins.kind_tag != 8) {
            var step: ssaunits.Step = at(p, b.id, pos, 0 - 1);
            r = supplies(r, step);
            r = instruction(r, f, ins);
            r = drops(r, step, f);
        }
        pos = pos + 1;
    }
    return r;
}

// Open stack-IR labels, innermost last. A label is the layout index control
// reaches by branching to it: a `block` ends before that index, a `loop`
// starts at it. An `if` arm is a label of its own that no branch targets.
struct Emit { r: irlower.LowerResult, labels: i32[], why: string }

function label_if(): i32 { return 0 - 1; }

function push(e: Emit, op: ir.Op, label: i32): Emit {
    return Emit { ...e, r: emit(e.r, op), labels: e.labels.append(label) };
}

function pop(e: Emit): Emit {
    var labels: i32[] = [];
    var i: i32 = 0;
    while (i < e.labels.len() - 1) { labels = labels.append(e.labels[i]); i = i + 1; }
    return Emit { ...e, r: emit(e.r, ir.op_end()), labels: labels };
}

// A branch target without an open label is a layout defect; refuse the
// function rather than emit a depth the backends would fault on.
function depth(e: Emit, target: i32): i32 {
    var i: i32 = e.labels.len() - 1;
    while (i >= 0 && e.labels[i] != target) { i = i - 1; }
    if (i < 0) { return 0 - 1; }
    return e.labels.len() - 1 - i;
}

function rank(f: ssa.SFunc, order: i32[], id: i32): i32 {
    var i: i32 = 0;
    while (i < order.len()) { if (f.blocks[order[i]].id == id) { return i; } i = i + 1; }
    return 0 - 1;
}

function jump(e: Emit, f: ssasem.Func, p: ssaunits.Plan, order: i32[], position: i32, target: i32): Emit {
    var r: irlower.LowerResult = edge(e.r, f, p, f.graph.blocks[order[position]].id, target);
    var dest: i32 = rank(f.graph, order, target);
    if (dest == position + 1) { return Emit { ...e, r: r }; }
    var d: i32 = depth(e, dest);
    if (d < 0) { return Emit { ...e, why: "branch target has no open label" }; }
    return Emit { ...e, r: emit(r, ir.op_br(d)) };
}

function terminator(e: Emit, f: ssasem.Func, p: ssaunits.Plan, order: i32[], position: i32): Emit {
    var b: ssa.SBlock = f.graph.blocks[order[position]];
    if (b.term.kind_tag == 1) {
        var ret: ssaunits.Step = at(p, b.id, ssaunits.return_point(), 0 - 1);
        var r: irlower.LowerResult = supplies(e.r, ret);
        r = drops(r, ret, f);
        if (b.term.value >= 0) { r = emit(r, ir.op_load_local(b.term.value)); }
        else { r = emit(r, ir.op_const_i32(0)); }
        return Emit { ...e, r: emit(r, ir.op_return()) };
    }
    if (b.term.kind_tag == 2) { return jump(e, f, p, order, position, b.term.target); }
    if (b.term.t == b.term.f) { return jump(e, f, p, order, position, b.term.t); }
    e = Emit { ...e, r: emit(e.r, ir.op_load_local(b.term.cond)) };
    e = push(e, ir.op_if(0), label_if());
    e = jump(e, f, p, order, position, b.term.t);
    e = Emit { ...e, r: emit(e.r, ir.op_else()) };
    e = jump(e, f, p, order, position, b.term.f);
    return pop(e);
}

// Blocks inside an inner loop get their labels when that loop is entered,
// so a label never crosses the loop's own scope.
function inner(l: ssalayout.Layout, first: i32, last: i32, looping: boolean, at: i32): boolean {
    var i: i32 = first + 1;
    if (!looping) { i = first; }
    while (i <= last) {
        if (l.loop_end[i] >= 0 && at > i && at <= l.loop_end[i]) { return true; }
        if (l.loop_end[i] >= 0) { i = l.loop_end[i] + 1; } else { i = i + 1; }
    }
    return false;
}

// Emit layout indices first..last. A looping region is one natural loop:
// its `loop` label opens first, then a `block` per position inside that no
// nested loop owns, each closed just before its position is reached.
function region(e: Emit, f: ssasem.Func, p: ssaunits.Plan, l: ssalayout.Layout, first: i32, last: i32, looping: boolean): Emit {
    if (looping) { e = push(e, ir.op_loop(0), first); }
    var target: i32 = last;
    while (target > first) {
        if (!inner(l, first, last, looping, target)) { e = push(e, ir.op_block(0), target); }
        target = target - 1;
    }
    var position: i32 = first;
    while (position <= last) {
        if (position > first) { e = pop(e); }
        if (l.loop_end[position] >= 0 && (position > first || !looping)) {
            e = region(e, f, p, l, position, l.loop_end[position], true);
            position = l.loop_end[position] + 1;
        } else {
            var r: irlower.LowerResult = block_body(e.r, f, p, f.graph.blocks[l.order[position]]);
            e = terminator(Emit { ...e, r: r }, f, p, l.order, position);
            position = position + 1;
        }
    }
    if (looping) { e = pop(e); }
    return e;
}

// An AST caller releases a produced callee's result by the contract this
// lowering honours, in the AST registries' own vocabulary: one counted
// reference whose container owns its children. Rows the caller's reading of
// the callee's syntax recorded for the same result are replaced. Only the
// shapes those registries can release get a row: a tuple's scalar-element
// array positions ("ARRF:") and a scalar-element array result ("ARROWN:");
// every other position keeps the AST caller's leak-mode floor.
pub function caller_sigs(sg: irlower.FnSigs, name: string, f: ssasem.Func): irlower.FnSigs {
    var tuples: string[] = without_rows(sg.tuple_fresh_ret_fns, name, ["", "ARRF:", "MAPF:"]);
    // Every row an AST reader could have written for this result is erased,
    // including the bare name. A row says the caller may release something;
    // once this function is lowered here, a row the AST inferred from syntax
    // describes a body the AST no longer lowered. Erasing one it should have
    // kept leaks; keeping one this boundary cannot honour double-frees, so the
    // list errs wide.
    //
    // The list mirrors irlower's readers by hand, and nothing ties the two
    // together: a reader prefix added there without a row here would let an
    // AST caller release a result this boundary lowered. The readers are the
    // `index_of_str(...return_fresh_struct_ret_fns, "<prefix>" + name)` sites
    // in irlower; grep that shape when adding one.
    var arrays: string[] = without_rows(sg.return_fresh_struct_ret_fns, name,
        ["", "ARR:", "ARROWN:", "SARRC:", "STRARR:", "ENUM:", "STRFLDF:",
         "FRESHSELF:", "ARRTUPF:", "ARRSTRUCTF:", "STRUCTARRF:", "ARENUMF:"]);
    if let typeinfo.TypeTuple(tup) = f.result {
        tuples = tuples.append(name);
        var flags: string = tuple_flags(tup);
        if (flags != "") { tuples = tuples.append("ARRF:" + name + "|" + flags); }
    }
    if (scalar_array(f.result)) { arrays = arrays.append("ARROWN:" + name); }
    if (box_only_result(f)) { arrays = arrays.append(name); }
    return irlower.FnSigs { ...sg, tuple_fresh_ret_fns: tuples, return_fresh_struct_ret_fns: arrays };
}

// A nominal struct result whose release is the box and nothing else.
//
// This is the one nominal shape the bare-name row can carry. That row asserts
// the caller SOLE-owns the result, which this boundary does not promise: a
// return supplies one counted unit, and a value the function did not build —
// a projection of a borrowed parameter — is supplied by a retain over a box
// its caller still owns. The row's exit sweep then runs __struct_drop_<T>
// with no uniqueness guard, freeing a field buffer the other owner still
// reads.
//
// A schema with no reference field has no field walk for that sweep to run,
// so the release is the rc-guarded box dec alone and a shared result stays
// balanced. Every other nominal result keeps the leak floor until it can
// prove the box is the caller's only one.
function box_only_result(f: ssasem.Func): boolean {
    if let typeinfo.TypeStruct(_) = f.result { return !has_children(f.result, f); }
    return false;
}

function scalar_array(t: typeinfo.Type): boolean {
    if let typeinfo.TypeArray(a) = t { return !reference(a.elem); }
    return false;
}

function tuple_flags(tup: typeinfo.TypeTuple): string {
    var flags: string = "";
    for elem in tup.elements {
        if (scalar_array(elem)) { flags = flags + "1"; } else { flags = flags + "0"; }
    }
    return flags;
}

// A row keyed "<prefix><name>" or "<prefix><name>|<flags>".
function keyed_row(row: string, prefix: string, name: string): boolean {
    var key: string = prefix + name;
    if (row == key) { return true; }
    return row.len() > key.len() && slice_unchecked(row, 0, key.len()) == key && row[key.len()] == b'|';
}

function without_rows(rows: string[], name: string, prefixes: string[]): string[] {
    var out: string[] = [];
    for row in rows {
        var drop: boolean = false;
        for prefix in prefixes { if (keyed_row(row, prefix, name)) { drop = true; } }
        if (!drop) { out = out.append(row); }
    }
    return out;
}

pub function lower(f: ssasem.Func, modes: i32[], p: ssaunits.Plan): irlower.LowerResult {
    var why: string = validate(f, modes, p);
    if (why != "") { return empty(why); }
    var layout: ssalayout.Layout = ssalayout.compute(f.graph);
    if (!layout.ok) { return empty("physical RC needs reducible graph"); }
    var e: Emit = region(Emit { r: frame(f), labels: [], why: "" }, f, p, layout, 0, layout.order.len() - 1, false);
    if (e.why != "") { return empty(e.why); }
    var optimized: ir.OptimizedOps = ir.optimize_ops(e.r.ops, e.r.n_params, e.r.n_locals);
    return irlower.LowerResult { ...e.r, ops: optimized.ops, n_locals: optimized.n_locals };
}
