// Verified semantic ownership to the production stack IR. No AST ownership
// facts or alternate backend ABI enter this boundary.
import "./ir";
import "./irlower";
import "./ssa";
import "./ssadeps";
import "./ssasem";
import "./ssalayout";
import "./ssaunits";
import "./semrecords";
import "./semtypes";
import "./typeinfo";
import "./util";

function empty(why: string): irlower.LowerResult {
    return irlower.LowerResult { ok: false, why: why, ops: [], n_locals: 0,
        n_params: 0, erased_wide: false, superseded: false, arr_slots: [], i64_slots: [],
        f64_slots: [], str_slots: [], alias_incs: [], name: "", result_kind: irlower.result_i32() };
}

// This physical boundary refuses types whose stack representation is not
// implemented here, even when the unit planner knows their abstract
// ownership: the 32-bit float, and a record with no schema or with type
// arguments (its box is named by the bare declaration). The byte occupies the
// same i32-shaped slot as an i32, narrowed by the wrap below; the 64-bit
// integer and the f64 each get a slot of their own, which is a VALUE here, a
// declared field and an array element, but never a tuple element
// (narrow_slot). A string view is a value here, and an element only of a
// `str[]`: a container's drop frees its elements with the owned string's
// helper, which is not a view's, and a `str[]` the typed path builds holds
// only immortal literals, on which that helper does nothing.
function supported_tuple(tup: typeinfo.TypeTuple, f: ssasem.Func): boolean {
    for elem in tup.elements { if (!element_supported(elem, f)) { return false; } }
    return true;
}
function supported_integer(i: typeinfo.TypeI32): boolean {
    return i.width == 32 || (i.width == 8 && i.unsigned) || i.width == 64 || (i.width == typeinfo.width_ptr() && i.unsigned);
}

// A value that fits the ONE i32-shaped word an undeclared construction writes
// per operand. An array's element ops each carry their own width, a record or
// variant field stores at the width its declaration names, and a tuple
// construction names its element kinds (`op_tuple_make_k`), so none of the
// three has to narrow — a closure box still does.
function narrow_slot(t: typeinfo.Type): boolean { return !ssasem.is_wide(t) && !ssasem.is_float(t); }

function element_supported(t: typeinfo.Type, f: ssasem.Func): boolean {
    return !ssasem.is_view(t) && supported(t, f);
}

// The slot width an array's element ops carry: eight bytes for a 64-bit
// scalar, one i32-shaped word for everything else. Only wasm packs the narrow
// slot; the register backends give every element eight bytes and ignore the
// width. The `_i64` forms name the SLOT, not the sign, so an i64 and a u64 take
// the same ones; a float shares the width and differs in the load and store
// wasm selects, the f32 occupying the f64's slot.
function elem_width(t: typeinfo.Type): i32 {
    if (ssasem.is_wide(t) || ssasem.is_float(t)) { return 64; }
    return 32;
}

function elem_type(t: typeinfo.Type): typeinfo.Type {
    if let typeinfo.TypeArray(a) = t { return a.elem; }
    return typeinfo.unchecked();
}

function arr_make_op(elem: typeinfo.Type, n: i32): ir.Op {
    if (ssasem.is_wide(elem)) { return ir.op_arr_make_i64(n); }
    return ir.op_arr_make(n, elem_width(elem));
}

function arr_get_op(elem: typeinfo.Type, unchecked: boolean): ir.Op {
    if (ssasem.is_wide(elem) && unchecked) { return ir.op_arr_get_i64_nc(); }
    if (ssasem.is_wide(elem)) { return ir.op_arr_get_i64(); }
    if (unchecked) { return ir.op_arr_get_nc(elem_width(elem)); }
    return ir.op_arr_get(elem_width(elem));
}

function arr_set_op(elem: typeinfo.Type): ir.Op {
    if (ssasem.is_wide(elem)) { return ir.op_arr_set_i64(); }
    return ir.op_arr_set(elem_width(elem));
}

// The sole-owner push, which reclaims the superseded buffer when it grows.
function arr_push_op(elem: typeinfo.Type): ir.Op {
    if (ssasem.is_wide(elem)) { return ir.op_arr_push_owned_i64(); }
    if (ssasem.is_float(elem)) { return ir.op_arr_push_owned_f64(); }
    return ir.op_arr_push_owned();
}

// The push that does NOT consume its receiver, for the one case where the
// frame has not taken a unit yet: `deferred_retain` holds the receiver's
// retain back so the buffer can grow in place, and a consuming push would then
// free a buffer the caller still points at on a realloc.
function arr_push_borrowed_op(elem: typeinfo.Type): ir.Op {
    if (ssasem.is_wide(elem)) { return ir.op_arr_push_i64(); }
    if (ssasem.is_float(elem)) { return ir.op_arr_push_f64(); }
    return ir.op_arr_push();
}
// The types whose stack representation needs no declaration looked up: a
// boolean and a void occupy one word, a string is its own box, a function
// value is the env box its captures are stored in, and a stream handle is the
// descriptor word. The handle is read here rather than under the nominal
// ladder below, which would look for a schema no handle has.
function supported_leaf(t: typeinfo.Type): boolean {
    if let typeinfo.TypeBool(_) = t { return true; }
    if let typeinfo.TypeVoid(_) = t { return true; }
    if let typeinfo.TypeString(_) = t { return true; }
    if let typeinfo.TypeFunc(_) = t { return true; }
    if let typeinfo.TypeDyn(_) = t { return true; }
    return semtypes.is_handle(t);
}
// A nominal box is named by a declaration this function's schema table carries,
// except a cell's: no declaration names it, and what it holds is one slot of
// its element.
function supported_nominal(t: typeinfo.Type, f: ssasem.Func): boolean {
    if (semtypes.is_cell(t)) { return walkable(semtypes.cell_elem(t), f); }
    // A map cursor has no record layout to find: its block is the map's address
    // and an index, and what it answers is the map's columns, so the two
    // element types are what has to be emittable.
    if (semtypes.is_map_iter(t)) {
        return walkable(semtypes.map_iter_key(t), f) && walkable(semtypes.map_iter_value(t), f);
    }
    if let typeinfo.TypeStruct(r) = t { return (r.args.len() == 0 || semtypes.is_env(t)) && semrecords.find(f.records, t) >= 0; }
    if let typeinfo.TypeUnion(_) = t { return semrecords.find_enum(f.enums, t) >= 0; }
    return false;
}
function supported(t: typeinfo.Type, f: ssasem.Func): boolean {
    if (supported_leaf(t)) { return true; }
    if let typeinfo.TypeI32(i) = t { return supported_integer(i); }
    if let typeinfo.TypeFloat(_) = t { return ssasem.is_float(t); }
    if let typeinfo.TypeArray(a) = t { return ssasem.is_view(a.elem) || element_supported(a.elem, f); }
    if let typeinfo.TypeTuple(tup) = t { return supported_tuple(tup, f); }
    if (ssasem.is_map(t)) { return ssasem.is_supported_map(t); }
    return supported_nominal(t, f);
}

function record_name(t: typeinfo.Type): string {
    if let typeinfo.TypeStruct(r) = t { return r.name; }
    return "";
}

function record_fields(t: typeinfo.Type, f: ssasem.Func): semrecords.Field[] {
    return f.records[semrecords.find(f.records, t)].fields;
}

function variants_of(t: typeinfo.Type, f: ssasem.Func): semrecords.Variant[] {
    return f.enums[semrecords.find_enum(f.enums, t)].variants;
}

function fields_have_children(fields: semrecords.Field[]): boolean {
    for field in fields { if (walked(field.ty)) { return true; } }
    return false;
}

// The field types a record's release walks — every reference, a function value
// included. That works from a frame that never built the box because
// `semsource.env_rows` pairs every environment a value of that type could
// carry with the type itself, and drop_captures matches on the body address at
// run time. A closure box's own captures are no exception since #9637: it
// takes a unit of each (ssaunits.taken), so walking them is what balances it.
function walked(t: typeinfo.Type): boolean {
    return ssasem.reference(t);
}

// A string box is released by its own helper: its block starts before the
// value, where an array's starts before the data words.
// A view's box is this function's, but its bytes belong to the source.
// __fern_str_view_free frees the box alone when the rc is the immortal view
// sentinel and takes the ordinary path otherwise, which is what makes one
// release symbol correct on both the register backends and wasm (whose slices
// copy, so the result is an ordinary counted box).
// A map's helper releases one unit of a counted box: a decrement while the
// box is shared, and the columns and the block for the last unit.
function release_name(t: typeinfo.Type): string {
    if (ssasem.is_view(t)) { return "__fern_str_view_free"; }
    if (ssasem.is_string(t)) { return "__fern_str_free"; }
    if (ssasem.is_map(t)) { return map_release_name(t); }
    return "__fern_rc_dec";
}

// A string key column takes a `_ks` member, which walks the keys through the
// string dec; a keyed column a `_kf` member, which walks them through the
// key's release, passed as the second argument; an integer one is freed
// whole. Which member of any depends on the value column, whose entries the
// map owns when they are counted. The string and string-array members are the
// AST path's, so the deep frees they reach are the ones the runtime already
// provides; the `_vf` members take the value's release as a further argument
// and call it on every entry.
function map_release_name(t: typeinfo.Type): string {
    var v: typeinfo.Type = ssasem.map_value(t);
    var ks: boolean = ssasem.is_string(ssasem.map_key(t));
    var kf: boolean = ssasem.keyed_map_key(ssasem.map_key(t));
    if (ssasem.is_string(v)) {
        if (kf) { return "__fern_map_free_kfvs"; }
        if (ks) { return "__fern_map_free_kvs"; }
        return "__fern_map_free_vs";
    }
    if (ssasem.is_string_array(v)) {
        if (kf) { return "__fern_map_free_kfvsa"; }
        if (ks) { return "__fern_map_free_ksvsa"; }
        return "__fern_map_free_vsa";
    }
    if (ssasem.boxed_map_value(v)) {
        if (kf) { return "__fern_map_free_kfvf"; }
        if (ks) { return "__fern_map_free_ksvf"; }
        return "__fern_map_free_vf";
    }
    if (kf) { return "__fern_map_free_kf"; }
    if (ks) { return "__fern_map_free_ks"; }
    return "__fern_map_free";
}

// The one release of a unit in `slot`. A map with a keyed column hands its
// release the function that releases one key, and a map of boxes the one
// that releases one value — the key's first, the value's on top — so the
// runtime can walk a column whose shape it does not know.
function release(own r: irlower.LowerResult, slot: i32, t: typeinfo.Type): irlower.LowerResult {
    var fns: string[] = map_release_fns(t);
    if (fns.len() == 0) { return helper(r, slot, release_name(t)); }
    r = emit(r, ir.op_load_local(slot));
    for fn in fns { r = emit(r, ir.op_const_func(0, fn)); }
    r = emit(r, ir.op_call_direct(release_name(t), fns.len() + 1));
    return emit(r, ir.op_drop());
}

// The per-type releases a map's free is handed after the box: the key's for
// a keyed column, then the value's for a column of boxes.
function map_release_fns(t: typeinfo.Type): string[] {
    var out: string[] = [];
    if (!ssasem.is_map(t)) { return out; }
    if (ssasem.keyed_map_key(ssasem.map_key(t))) { out = out.append(release_helper_name(ssasem.map_key(t))); }
    if (ssasem.boxed_map_value(ssasem.map_value(t))) { out = out.append(release_helper_name(ssasem.map_value(t))); }
    return out;
}

// The runtime's key kind: 0 a string column, whose unit the insert hands over
// for the column to hold, 1 an integer column, which holds no unit, and 2 a
// keyed column of boxes, hashed and compared through the key type's derived
// methods and owning one unit per entry as a string column does.
function map_key_kind(t: typeinfo.Type): i32 {
    if (ssasem.is_string(ssasem.map_key(t))) { return 0; }
    if (ssasem.keyed_map_key(ssasem.map_key(t))) { return 2; }
    return 1;
}

// The derived equality a keyed column's probes compare through, named as the
// AST lowering names it — the receiver method `K.eq`, which the backends
// spell `__fn_K__eq` — and "" for any other key.
function map_key_eq(t: typeinfo.Type): string {
    if (!ssasem.keyed_map_key(ssasem.map_key(t))) { return ""; }
    return ssasem.keyed_map_key_name(ssasem.map_key(t)) + ".eq";
}

// The pair a keyed map's construction carries, `K.hash|K.eq`: wasm stores
// their table slots on the box and dispatches every probe through them.
function map_key_fns(t: typeinfo.Type): string {
    if (!ssasem.keyed_map_key(ssasem.map_key(t))) { return ""; }
    var k: string = ssasem.keyed_map_key_name(ssasem.map_key(t));
    return k + ".hash|" + k + ".eq";
}

// The runtime's value-column kind: 0 the map owns nothing in it, 1 a string
// column, 2 a column of string arrays, 3 a column of boxes released through
// the function the insert names. It is what tells map_set which release the
// value it supersedes on an overwrite is owed (#9300).
function map_value_kind(t: typeinfo.Type): i32 {
    var v: typeinfo.Type = ssasem.map_value(t);
    if (ssasem.is_string(v)) { return 1; }
    if (ssasem.is_string_array(v)) { return 2; }
    if (ssasem.boxed_map_value(v)) { return 3; }
    return 0;
}

function emit(own r: irlower.LowerResult, op: ir.Op): irlower.LowerResult {
    return irlower.LowerResult { ...r, ops: r.ops.append(op) };
}

function helper(own r: irlower.LowerResult, slot: i32, name: string): irlower.LowerResult {
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_call_direct(name, 1));
    return emit(r, ir.op_drop());
}

// `defer0` holds an append's or a with's receiver's retain back, so the
// operation's own rc gate reads the box rather than this supply — see `deferred_retain` for why the
// order is the whole of it.
function supplies(own r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, step: ssaunits.Step, defer0: boolean): irlower.LowerResult {
    var j: i32 = 0;
    for supply in step.supplies {
        // A string literal's retain is the immortal guard's no-op.
        if (supply.mode == ssaunits.retain_unit() && !(defer0 && supply.slot == 0) && !p.literal[supply.value]) {
            r = helper(r, supply.value, "__fern_rc_inc");
        }
        if (supply.mode == ssaunits.steal_unit()) {
            r = steal(r, f, supply.value, scratch_base(f) + j);
            j = j + 1;
        }
    }
    // A move transfers the existing unit. Value locals are never implicitly
    // swept, so neither a runtime decrement nor a clear is needed for a move.
    return r;
}

// The instruction that defines `v`.
function definition(f: ssasem.Func, v: i32): ssa.SInst {
    for b in f.graph.blocks {
        for ins in b.insts { if (ins.result == v) { return ins; } }
    }
    return f.graph.blocks[0].insts[0];
}

// A stolen unit: when the box the value projects has no other holder, the
// slot is nulled and the value's unit is the taker's; otherwise the value is
// retained, as `append_field` does around its push. A record's field and an
// enum's payload are the same slot to this, since both read through
// `op_struct_get`. The scratch slot holds the box's answer; nothing reads it
// past this point.
function steal(own r: irlower.LowerResult, f: ssasem.Func, v: i32, unique: i32): irlower.LowerResult {
    var get: ssa.SInst = definition(f, v);
    r = reserve(r, unique + 1);
    r = emit(r, ir.op_load_local(get.args[0]));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_store_local(unique));
    r = emit(r, ir.op_load_local(unique));
    r = emit(r, ir.op_if(0));
    r = emit(r, ir.op_load_local(get.args[0]));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_struct_set(get.imm, 0));
    r = emit(r, ir.op_end());
    return unless_unique(r, unique, v, "__fern_rc_inc");
}

// An in-place update whose receiver this frame does not own: its unit arrives
// as a RETAIN because the frame has to hold one while the operation runs, and
// emitting that retain BEFORE `__fern_rc_is_unique` makes the test answer for
// its own supply rather than for the box. It then says "shared" about a box
// nobody else holds, every push takes the un-share copy, and a loop appending
// through a borrowed parameter copies the whole buffer per element — 23 s and
// 8.9 GB for 40,000 pushes where the AST lowering takes 2 ms (#9365).
//
// A receiver the frame DOES own keeps its retain up front: there it is the
// same-frame bracket, held because the binding outlives the update and the
// copy is what keeps the old value whole.
//
// The cross-frame bracket is `bracketed`, and it is what makes deferring safe
// — so the deferral reaches exactly as far as that bracket does: a PARAMETER
// this frame borrows, which its caller either bracketed or is done reading,
// and a record FIELD the plan admitted (ssaunits.field_grow_root), where the
// bracket is on the field and the record's own count answers for any holder
// no caller names. An array reached any other way the frame does not own —
// an element of a borrowed array of arrays, say — has no bracket standing
// behind it, and growing it in place would rewrite what the container still
// holds. A with has no non-consuming helper to fall back on, so it defers
// only where the plan admitted the field.
//
// A map mutation never defers. Its receiver's retain is what makes a map
// the frame still reads count as shared, and `unshared_map` then copies:
// `var n = m.insert(k, v)` leaves `m` as it was, which is the value the
// checker's E055 promises for every collection operation.
function deferred_retain(f: ssasem.Func, p: ssaunits.Plan, step: ssaunits.Step, ins: ssa.SInst): boolean {
    if (ins.kind_tag != ssasem.append() && ins.kind_tag != ssasem.with()) { return false; }
    if (p.grows[ins.result] < 0 && (ins.kind_tag == ssasem.with() || ins.args[0] >= f.graph.nparams)) { return false; }
    if (ins.args[0] < p.owned.len() && p.owned[ins.args[0]]) { return false; }
    for supply in step.supplies {
        if (supply.slot == 0 && supply.mode == ssaunits.retain_unit()) { return true; }
    }
    return false;
}

// The arguments of a direct call this frame has to hold a second count on
// across it. A callee handed a BORROWED array may grow or overwrite it in
// place when it is the box's only reader, and it cannot see the caller's
// binding to know whether it is — so the caller says so, by holding a count
// while the call runs. A value this step DROPS is not one the caller reads
// again, so it needs no bracket and the callee is free to work in place; nor
// is a buffer the plan HANDS on (ssaunits.hands) — a borrowed parameter, or
// a field of a record, this frame reads no further.
//
// Conservative on purpose for arrays: no interprocedural may-grow set is
// consulted, since the cost is one retain and one release on an argument the
// frame keeps.
//
// ARRAYS only. A text box is never updated in place — a concatenation builds
// its own — so a bracket buys nothing there, and a `string` that is really a
// view at run time carries the immortal count, where the retain is a no-op and
// the paired reclaim would free a box the frame still reads (#9328).
//
// A RECORD argument is bracketed field by field, and only at the fields the
// callee's own plan says it may grow (`grows`, from ssaunits.grow_rows):
// retaining the record's box would answer for the wrong box, since the buffer
// the callee's push tests is the field's, at its own count. Each held buffer
// is captured in a scratch local, so the release after the call decrements
// the buffer that was retained rather than re-reading a field the callee may
// have replaced.
//
// A field HANDED on (ssaunits.hands) is gated rather than bracketed: the
// record's own count says whether a holder this frame cannot see still names
// it, and a shared record holds a second count on the field across the call,
// as `append_field` does around its push. A whole record handed on is gated
// the same way at every field the callee may grow (`gated_records` /
// `gated_fields`); bracketing those fields would make the callee's first
// append copy a buffer nobody else reads, once per call up the chain of
// wrappers that lend a record on.
struct Held { arrays: i32[], records: i32[], fields: i32[], gated: i32[], gated_roots: i32[], gated_records: i32[], gated_fields: i32[] }

function bracketed(f: ssasem.Func, step: ssaunits.Step, ins: ssa.SInst, grows: ssaunits.GrowRow[]): Held {
    var out: Held = Held { arrays: [], records: [], fields: [], gated: [], gated_roots: [], gated_records: [], gated_fields: [] };
    if (ins.kind_tag != ssasem.call()) { return out; }
    var modes: i32[] = ssaunits.callee_modes(f, ins);
    var i: i32 = 0;
    while (i < ins.args.len() && i < modes.len()) {
        var v: i32 = ins.args[i];
        if (modes[i] == ssaunits.borrow_mode() && util.index_of_i32(step.drops, v) < 0) {
            var handed: boolean = i < step.hand_roots.len() && step.hand_roots[i] >= 0;
            if (bracketable(f.values[v]) && !handed && util.index_of_i32(out.arrays, v) < 0) {
                out = Held { ...out, arrays: out.arrays.append(v) };
            }
            if (handed && step.hand_fields[i] >= 0) {
                out = Held { ...out, gated: out.gated.append(v), gated_roots: out.gated_roots.append(step.hand_roots[i]) };
            }
            if (record_bracketable(f.values[v])) {
                for field in ssaunits.grow_fields_of(grows, ins.str, i) {
                    if (handed) {
                        out = Held { ...out, gated_records: out.gated_records.append(v), gated_fields: out.gated_fields.append(field) };
                    } else if (!holds_field(out, v, field)) {
                        out = Held { ...out, records: out.records.append(v), fields: out.fields.append(field) };
                    }
                }
            }
        }
        i = i + 1;
    }
    return out;
}

function holds_field(h: Held, rec: i32, field: i32): boolean {
    var k: i32 = 0;
    while (k < h.records.len()) {
        if (h.records[k] == rec && h.fields[k] == field) { return true; }
        k = k + 1;
    }
    return false;
}

function bracketable(t: typeinfo.Type): boolean {
    if (ssasem.is_text(t)) { return false; }
    if let typeinfo.TypeArray(_) = t { return ssasem.reference(t); }
    return false;
}

function record_bracketable(t: typeinfo.Type): boolean {
    if (semtypes.is_env(t)) { return false; }
    if let typeinfo.TypeStruct(_) = t { return true; }
    return false;
}

// The scratch locals sit above the value ids; a call's own lowering reserves
// none, so the held buffers keep theirs from the take to the give.
function bracket_take(own r: irlower.LowerResult, f: ssasem.Func, held: Held): irlower.LowerResult {
    for v in held.arrays { r = helper(r, v, "__fern_rc_inc"); }
    var k: i32 = 0;
    while (k < held.records.len()) {
        var slot: i32 = scratch_base(f) + k;
        r = reserve(r, slot + 1);
        r = emit(r, ir.op_load_local(held.records[k]));
        r = emit(r, ir.op_struct_get(held.fields[k], 0));
        r = emit(r, ir.op_store_local(slot));
        r = helper(r, slot, "__fern_arr_share_inc");
        k = k + 1;
    }
    var j: i32 = 0;
    while (j < held.gated.len()) {
        var unique: i32 = scratch_base(f) + held.records.len() + j;
        r = reserve(r, unique + 1);
        r = emit(r, ir.op_load_local(held.gated_roots[j]));
        r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
        r = emit(r, ir.op_store_local(unique));
        r = unless_unique(r, unique, held.gated[j], "__fern_arr_share_inc");
        j = j + 1;
    }
    // A gated field takes two scratch slots: the buffer, captured before the
    // call for the reason a bracketed field's is, and the record's answer.
    var g: i32 = 0;
    while (g < held.gated_records.len()) {
        var slot: i32 = gated_field_slot(f, held, g);
        r = reserve(r, slot + 2);
        r = emit(r, ir.op_load_local(held.gated_records[g]));
        r = emit(r, ir.op_struct_get(held.gated_fields[g], 0));
        r = emit(r, ir.op_store_local(slot));
        r = emit(r, ir.op_load_local(held.gated_records[g]));
        r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
        r = emit(r, ir.op_store_local(slot + 1));
        r = unless_unique(r, slot + 1, slot, "__fern_arr_share_inc");
        g = g + 1;
    }
    return r;
}

function gated_field_slot(f: ssasem.Func, held: Held, g: i32): i32 {
    return scratch_base(f) + held.records.len() + held.gated.len() + 2 * g;
}

function bracket_give(own r: irlower.LowerResult, f: ssasem.Func, held: Held): irlower.LowerResult {
    for v in held.arrays { r = release(r, v, f.values[v]); }
    var k: i32 = 0;
    while (k < held.records.len()) {
        r = helper(r, scratch_base(f) + k, "__fern_arr_share_dec");
        k = k + 1;
    }
    var j: i32 = 0;
    while (j < held.gated.len()) {
        r = unless_unique(r, scratch_base(f) + held.records.len() + j, held.gated[j], "__fern_arr_share_dec");
        j = j + 1;
    }
    var g: i32 = 0;
    while (g < held.gated_records.len()) {
        var slot: i32 = gated_field_slot(f, held, g);
        r = unless_unique(r, slot + 1, slot, "__fern_arr_share_dec");
        g = g + 1;
    }
    return r;
}

// Scratch storage is shared by successive drops and distinct within recursion.
function reserve(own r: irlower.LowerResult, end: i32): irlower.LowerResult {
    if (end > r.n_locals) { return irlower.LowerResult { ...r, n_locals: end }; }
    return r;
}

// A value's SSA id is its local slot, so the slots above `nvals` are the
// frame's scratch. The lowest belongs to the reuse pairing and is the only one
// that lives ACROSS instructions: a token is taken where a value dies and
// spent at a construction further down the block. Everything else is scratch
// within one instruction, so it starts above it.
function token_slot(f: ssasem.Func): i32 { return f.graph.nvals; }
function scratch_base(f: ssasem.Func): i32 { return f.graph.nvals + 1; }

// A parent owns one unit per reference field. Shared parents release only
// their own unit; the final parent release walks children before its box.
// Array/tuple/struct opcodes preserve the production native/Wasm layouts.
function has_children(t: typeinfo.Type, f: ssasem.Func): boolean {
    // A stream handle has no box, so there is nothing under it to walk — and
    // no schema either, which is what the record arm below would go looking
    // for. `caller_sigs` asks this of every parameter type, so a handle
    // reaches here on any program that opens one.
    if (semtypes.is_handle(t)) { return false; }
    if let typeinfo.TypeFunc(_) = t { return env_records(f, t).len() > 0; }
    if (ssasem.is_dyn(t)) {
        for c in dyn_concretes(f, t) { if (ssasem.is_string(c) || has_children(c, f)) { return true; } }
        return false;
    }
    if let typeinfo.TypeArray(a) = t { return ssasem.reference(a.elem); }
    if let typeinfo.TypeTuple(tup) = t {
        for elem in tup.elements { if (ssasem.reference(elem)) { return true; } }
    }
    if (semtypes.is_cell(t)) { return ssasem.reference(semtypes.cell_elem(t)); }
    // A map's own release reads the count and walks its columns, so no guard
    // is emitted around it here.
    if (ssasem.is_map(t)) { return false; }
    if let typeinfo.TypeStruct(_) = t { return fields_have_children(record_fields(t, f)); }
    if let typeinfo.TypeUnion(_) = t {
        for v in variants_of(t, f) { if (fields_have_children(v.fields)) { return true; } }
    }
    return false;
}

// The environments a function value of type `fn_ty` may be carrying, whose
// captures own a unit: the boxes releasing one has to be able to walk.
//
// Keyed on `fn_ty` and ordered by body name, and both halves are the same
// requirement. A drop helper is emitted by EVERY function that mentions its
// type and `merge_helpers` refuses two copies that disagree, so the chain
// `drop_captures` emits must not vary with the frame emitting it. `f.envs`
// supplies the pairing, read off the module's whole contract table; a schema
// table on its own is the producing function's own values in the producing
// function's own order, which varies with both.
//
// `semsource.env_rows_closed` closes the rows over the schema table, so a
// frame that holds the type only indirectly — as a field of a record it never
// names — lists the same environments as the frame that built the closure.
function env_records(f: ssasem.Func, fn_ty: typeinfo.Type): semrecords.Record[] {
    var out: semrecords.Record[] = [];
    for rec in f.records {
        if (!semtypes.is_env(rec.ty) || !fields_have_children(rec.fields)) { continue; }
        if (!serves(f.envs, fn_ty, rec.ty)) { continue; }
        var at: i32 = 0;
        while (at < out.len() && semtypes.env_body(out[at].ty) < semtypes.env_body(rec.ty)) { at = at + 1; }
        out = inserted_record(out, at, rec);
    }
    return out;
}

function serves(rows: ssasem.EnvRow[], fn_ty: typeinfo.Type, env_ty: typeinfo.Type): boolean {
    for row in rows {
        if (semtypes.equal(row.fn_ty, fn_ty) && semtypes.equal(row.env_ty, env_ty)) { return true; }
    }
    return false;
}

function inserted_record(recs: semrecords.Record[], at: i32, rec: semrecords.Record): semrecords.Record[] {
    var out: semrecords.Record[] = [];
    var i: i32 = 0;
    while (i < recs.len()) {
        if (i == at) { out = out.append(rec); }
        out = out.append(recs[i]);
        i = i + 1;
    }
    if (at >= recs.len()) { out = out.append(rec); }
    return out;
}

// A function value's static type names no captures, so its box is matched at
// run time: slot 0 holds the body's address, and each environment a value of
// that type could be carrying is tried against it. A box whose captures own
// nothing matches none and is released alone. The box need not have been built
// in this frame — that is the point of matching on the body address rather
// than on what the frame knows it made.
function drop_captures(own r: irlower.LowerResult, slot: i32, fn_ty: typeinfo.Type, f: ssasem.Func): irlower.LowerResult {
    for rec in env_records(f, fn_ty) {
        r = emit(r, ir.op_load_local(slot));
        r = emit(r, ir.op_const_i32(0));
        r = emit(r, ir.op_arr_get(32));
        r = emit(r, ir.op_const_func(0, semtypes.env_body(rec.ty)));
        r = emit(r, ir.op_bin("eq", 0, false));
        r = emit(r, ir.op_if(0));
        r = helper(r, slot, drop_helper_name(rec.ty));
        r = emit(r, ir.op_end());
    }
    return r;
}

// A dyn value's box is one of the concretes its type can hold, matched at run
// time by the shape the box carries at offset 0: a record's is its own, a
// boxed string's is `string`, and an enum's helper tests its variants itself,
// so it is called unguarded. The value need not have been widened in this
// frame, which is why the set is the type's (`ssasem.Func.dyns`) rather than
// what the frame saw built.
function drop_dyn(own r: irlower.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irlower.LowerResult {
    for c in dyn_concretes(f, t) {
        if (ssasem.is_string(c)) {
            r = reserve(r, scratch + 1);
            r = emit(r, ir.op_load_local(slot));
            r = emit(r, ir.op_variant_is("string"));
            r = emit(r, ir.op_if(0));
            r = emit(r, ir.op_load_local(slot));
            r = emit(r, ir.op_struct_get(0, 0));
            r = emit(r, ir.op_store_local(scratch));
            r = drop_value(r, scratch, c, scratch + 1, f);
            r = emit(r, ir.op_end());
            continue;
        }
        if (!has_children(c, f)) { continue; }
        if let typeinfo.TypeStruct(rs) = c {
            r = emit(r, ir.op_load_local(slot));
            r = emit(r, ir.op_variant_is(rs.name));
            r = emit(r, ir.op_if(0));
            r = helper(r, slot, drop_helper_name(c));
            r = emit(r, ir.op_end());
        } else {
            r = helper(r, slot, drop_helper_name(c));
        }
    }
    return r;
}

function dyn_concretes(f: ssasem.Func, t: typeinfo.Type): typeinfo.Type[] {
    var out: typeinfo.Type[] = [];
    for row in f.dyns { if (semtypes.equal(row.fn_ty, t)) { out = out.append(row.env_ty); } }
    return out;
}

// The units a box owns, released without releasing the box. The caller has
// already emitted the uniqueness test this belongs under: `drop_value` before
// it releases the box, `reuse_token` before it hands the box on.
function drop_children(own r: irlower.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irlower.LowerResult {
    if let typeinfo.TypeFunc(_) = t { r = drop_captures(r, slot, t, f); }
    if (ssasem.is_dyn(t)) { r = drop_dyn(r, slot, t, scratch, f); }
    if let typeinfo.TypeArray(a) = t { r = drop_elements(r, slot, a.elem, scratch, f); }
    if (semtypes.is_cell(t)) { r = drop_elements(r, slot, semtypes.cell_elem(t), scratch, f); }
    if let typeinfo.TypeTuple(tup) = t { r = drop_tuple_fields(r, slot, tup, scratch, f); }
    if (named(t) != "") { r = helper(r, slot, drop_helper_name(t)); }
    return r;
}

function drop_value(own r: irlower.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irlower.LowerResult {
    if (has_children(t, f)) {
        r = emit(r, ir.op_load_local(slot));
        r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
        r = emit(r, ir.op_if(0));
        r = drop_children(r, slot, t, scratch, f);
        r = emit(r, ir.op_end());
    }
    return release(r, slot, t);
}

// A builtin union's box carries no shape pointer, so the walk selects its one
// payload by the tag the box stores rather than by a variant shape.
function drop_payload(own r: irlower.LowerResult, slot: i32, e: semrecords.Enum, scratch: i32, f: ssasem.Func): irlower.LowerResult {
    var child: i32 = scratch;
    r = reserve(r, child + 1);
    var tag: i32 = 0;
    while (tag < e.variants.len()) {
        var fields: semrecords.Field[] = e.variants[tag].fields;
        if (fields.len() == 1 && ssasem.reference(fields[0].ty)) {
            r = emit(r, ir.op_load_local(slot));
            r = emit(r, ir.op_opt_tag());
            r = emit(r, ir.op_const_i32(tag));
            r = emit(r, ir.op_bin("eq", 0, false));
            r = emit(r, ir.op_if(0));
            r = emit(r, ir.op_load_local(slot));
            r = emit(r, ir.op_opt_payload());
            r = emit(r, ir.op_store_local(child));
            r = drop_value(r, child, fields[0].ty, child + 1, f);
            r = emit(r, ir.op_end());
        }
        tag = tag + 1;
    }
    return r;
}

// A variant box carries only its own variant's fields, so the walk selects
// them by the box's runtime variant.
function drop_variant_fields(own r: irlower.LowerResult, slot: i32, t: typeinfo.Type, scratch: i32, f: ssasem.Func): irlower.LowerResult {
    var e: semrecords.Enum = f.enums[semrecords.find_enum(f.enums, t)];
    if (e.layout == semrecords.layout_option()) { return drop_payload(r, slot, e, scratch, f); }
    for v in e.variants {
        if (fields_have_children(v.fields)) {
            r = emit(r, ir.op_load_local(slot));
            r = emit(r, ir.op_variant_is(v.name));
            r = emit(r, ir.op_if(0));
            r = drop_record_fields(r, slot, v.fields, scratch, f, false);
            r = emit(r, ir.op_end());
        }
    }
    return r;
}

// self_tail_field: the index of the variant's last field of the enum's own
// type, or -1.
function self_tail_field(v: semrecords.Variant, t: typeinfo.Type): i32 {
    var at: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < v.fields.len()) {
        if (semtypes.equal(v.fields[i].ty, t)) { at = i; }
        i = i + 1;
    }
    return at;
}

function self_tail_enum(t: typeinfo.Type, f: ssasem.Func): boolean {
    var e: semrecords.Enum = f.enums[semrecords.find_enum(f.enums, t)];
    if (e.layout == semrecords.layout_option()) { return false; }
    for v in e.variants { if (self_tail_field(v, t) >= 0) { return true; } }
    return false;
}

// drop_variant_chain is drop_variant_fields for an enum whose variants reach
// the enum itself (a list's tail): that one field is not a recursive drop but
// the next node of a loop, so the helper's stack stays constant however long
// the chain is (#9046). Each node after the first is released here once its
// children are, exactly as drop_value would release it; a shared next node is
// released without its children, and the walk stops. Slots: 1 the node, 2
// whether it is the caller's box, 3 the next node, 4 up scratch.
function drop_variant_chain(own r: irlower.LowerResult, t: typeinfo.Type, f: ssasem.Func): irlower.LowerResult {
    var e: semrecords.Enum = f.enums[semrecords.find_enum(f.enums, t)];
    var node: i32 = 1;
    var first: i32 = 2;
    var next: i32 = 3;
    r = reserve(r, 5);
    r = emit(r, ir.op_load_local(0));
    r = emit(r, ir.op_store_local(node));
    r = emit(r, ir.op_const_i32(1));
    r = emit(r, ir.op_store_local(first));
    r = emit(r, ir.op_block(0));
    r = emit(r, ir.op_loop(0));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_store_local(next));
    for v in e.variants {
        if (!fields_have_children(v.fields)) { continue; }
        var tail: i32 = self_tail_field(v, t);
        r = emit(r, ir.op_load_local(node));
        r = emit(r, ir.op_variant_is(v.name));
        r = emit(r, ir.op_if(0));
        var i: i32 = 0;
        while (i < v.fields.len()) {
            if (walked(v.fields[i].ty)) {
                r = emit(r, ir.op_load_local(node));
                r = emit(r, ir.op_struct_get(i, 0));
                if (i == tail) { r = emit(r, ir.op_store_local(next)); }
                else {
                    r = emit(r, ir.op_store_local(4));
                    r = drop_value(r, 4, v.fields[i].ty, 5, f);
                }
            }
            i = i + 1;
        }
        r = emit(r, ir.op_end());
    }
    r = emit(r, ir.op_load_local(first));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_bin("eq", 0, false));
    r = emit(r, ir.op_if(0));
    r = release(r, node, t);
    r = emit(r, ir.op_end());
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_store_local(first));
    // No next node: done. A shared one: release it and stop.
    r = emit(r, ir.op_load_local(next));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_bin("eq", ir.width_ptr(), false));
    r = emit(r, ir.op_brif(1));
    r = emit(r, ir.op_load_local(next));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_if(0));
    r = emit(r, ir.op_else());
    r = release(r, next, t);
    r = emit(r, ir.op_br(2));
    r = emit(r, ir.op_end());
    r = emit(r, ir.op_load_local(next));
    r = emit(r, ir.op_store_local(node));
    r = emit(r, ir.op_br(0));
    r = emit(r, ir.op_end());
    return emit(r, ir.op_end());
}

function drop_elements(own r: irlower.LowerResult, slot: i32, elem: typeinfo.Type, scratch: i32, f: ssasem.Func): irlower.LowerResult {
    var index: i32 = scratch;
    var child: i32 = index + 1;
    r = reserve(r, child + 1);
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_store_local(index));
    r = emit(r, ir.op_block(0));
    r = emit(r, ir.op_loop(0));
    r = emit(r, ir.op_load_local(index));
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_arr_len());
    r = emit(r, ir.op_bin("ge_s", 0, false));
    r = emit(r, ir.op_brif(1));
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_load_local(index));
    r = emit(r, ir.op_arr_get_nc(32));
    r = emit(r, ir.op_store_local(child));
    r = drop_value(r, child, elem, child + 1, f);
    r = emit(r, ir.op_load_local(index));
    r = emit(r, ir.op_const_i32(1));
    r = emit(r, ir.op_bin("add", 0, false));
    r = emit(r, ir.op_store_local(index));
    r = emit(r, ir.op_br(0));
    r = emit(r, ir.op_end());
    return emit(r, ir.op_end());
}

function drop_tuple_fields(own r: irlower.LowerResult, slot: i32, tup: typeinfo.TypeTuple, scratch: i32, f: ssasem.Func): irlower.LowerResult {
    var child: i32 = scratch;
    r = reserve(r, child + 1);
    var i: i32 = 0;
    while (i < tup.elements.len()) {
        if (ssasem.reference(tup.elements[i])) {
            r = emit(r, ir.op_load_local(slot));
            r = emit(r, ir.op_tuple_get(i));
            r = emit(r, ir.op_store_local(child));
            r = drop_value(r, child, tup.elements[i], child + 1, f);
        }
        i = i + 1;
    }
    return r;
}

// `env` selects the box LAYOUT, not what is walked: an environment addresses
// its captures as array slots and a record its fields as struct ones.
function drop_record_fields(own r: irlower.LowerResult, slot: i32, fields: semrecords.Field[], scratch: i32, f: ssasem.Func, env: boolean): irlower.LowerResult {
    var child: i32 = scratch;
    r = reserve(r, child + 1);
    var i: i32 = 0;
    while (i < fields.len()) {
        if (walked(fields[i].ty)) {
            r = emit(r, ir.op_load_local(slot));
            if (env) { r = emit(r, ir.op_const_i32(i)); r = emit(r, ir.op_arr_get(32)); }
            else { r = emit(r, ir.op_struct_get(i, 0)); }
            r = emit(r, ir.op_store_local(child));
            r = drop_value(r, child, fields[i].ty, child + 1, f);
        }
        i = i + 1;
    }
    return r;
}

function drops(own r: irlower.LowerResult, step: ssaunits.Step, f: ssasem.Func): irlower.LowerResult {
    for value in step.drops { r = drop_value(r, value, f.values[value], scratch_base(f), f); }
    return r;
}

// The drops of a step less the one a construction took as its box: that value's
// storage became the result's, so releasing it here would free a live box.
// `shell` is a box whose payload this step took without emptying its slot
// (`ssaunits.shell_root`), so its drop releases the box alone.
function drops_less(own r: irlower.LowerResult, step: ssaunits.Step, f: ssasem.Func, taken: i32, took: i32, shell: i32): irlower.LowerResult {
    for value in step.drops {
        if (value == shell) { r = release(r, value, f.values[value]); }
        else if (value != taken && value != took) { r = drop_value(r, value, f.values[value], scratch_base(f), f); }
    }
    return r;
}

// Where a block's constructions can build in a box already dying in it.
//
// Perceus places a drop at a value's last use, so the record a `with`-style
// update supersedes dies BEFORE the record replacing it is built. Reuse is the
// pairing of that drop with that later construction: instead of returning the
// box to the allocator and taking another of the same shape, the drop keeps it
// as a token and the construction builds in it. This is Koka's ParcReuse
// applied to the plan's dying set rather than to syntax.
//
// `tokens[i]` is the value whose drop at instruction i becomes a token, and
// `builds[i]` the token an instruction i construction builds in; -1 for
// neither. One pairing is live at a time, so one token slot serves the block —
// a second candidate while one is pending is simply left to drop normally.
//
// The donor and the recipient need not share a TYPE, and the pairing does not
// ask: a box is storage, and what separates two of them is the number of
// SLOTS. `reuse_slots` is that number, matched against what the construction
// claims. Measured over the compiler's own sources, pairing on shape alone —
// any dying record, union or tuple to any construction — admits 839 sites of
// which only 229 have counts the runtime can honour; pairing on the count
// admits 390, all of them spendable, once the donor is held for whichever
// construction claims it (`block_claims`, below) rather than taken first-come.
// `selfs[i]` is a value dying AT instruction i whose box that same
// instruction's construction builds in — the update chain's shape, where the
// box a `T { ...a, f: v }` supersedes dies as the update consumes it rather
// than at some earlier instruction. Its token is taken before the construction
// instead of after, which is the only thing that separates it from the pairing
// above; it is the same donor, the same runtime test and the same box.
//
// Measured over the compiler's own sources, 795 constructions have a
// matching-slot value dying at their own instruction, against 390 pairings
// from earlier drops. Most of them are the two native assemblers, which are
// nothing but update chains.
struct ReusePairs { tokens: i32[], builds: i32[], selfs: i32[] }

// The slots a value's box has, or -1 where this frame cannot say. This is the
// number `__fern_alloc_reuse` compares, and comparing it HERE is what makes a
// pairing worth emitting: the runtime's own test is sound either way, but the
// arm it takes when the counts disagree returns the donor block to its
// freelist and allocates anyway, so the pairing has bought a uniqueness test
// and a branch and changed nothing, at 25 lines of emitted text apiece.
// Measured over the compiler's own sources, 610 of 839 pairings admitted on
// shape alone were of that kind.
//
// A record's box is its shape word and one word per field, a tuple's one word
// per element and no shape word. An environment is excluded: its fields are
// addressed as array slots rather than struct ones, and its box is the
// closure's. So is an array: its cap is a CAPACITY rather than its length, so
// the slots the block has are not the slots its type names.
function reuse_slots(t: typeinfo.Type, f: ssasem.Func): i32 {
    if (semtypes.is_env(t) || semtypes.is_cell(t)) { return 0 - 1; }
    if let typeinfo.TypeTuple(tup) = t { return tup.elements.len(); }
    if let typeinfo.TypeStruct(_) = t {
        if (semrecords.find(f.records, t) < 0) { return 0 - 1; }
        return record_fields(t, f).len() + 1;
    }
    if let typeinfo.TypeUnion(_) = t { return union_slots(t, f); }
    return 0 - 1;
}

// A declared enum's box is the LIVE variant's, so its count is this frame's to
// know only where every variant agrees — native's own enum reuse asks the same
// question (`enum_all_variants_same_field_count`).
//
// A BUILTIN union's box has no count this boundary can state, and that is a
// target fact rather than a conservatism. One lowering feeds all three
// backends: the register ones build every Option/Result as `__fern_arr_box(2)`,
// while wasm sizes the box by the payload AT THE SITE — eight bytes for a
// narrow one and sixteen for an i64 or an f64 — so a `Result[i64, string]`
// box is two slots built as Ok and one built as Err. There is no single answer
// to give, and a wrong one is the pairing that emits its machinery and then
// declines.
function union_slots(t: typeinfo.Type, f: ssasem.Func): i32 {
    var at: i32 = semrecords.find_enum(f.enums, t);
    if (at < 0) { return 0 - 1; }
    if (f.enums[at].layout == semrecords.layout_option()) { return 0 - 1; }
    var n: i32 = 0 - 1;
    for v in f.enums[at].variants {
        if (n < 0) { n = v.fields.len(); }
        else if (n != v.fields.len()) { return 0 - 1; }
    }
    if (n < 0) { return 0 - 1; }
    return n + 1;
}

// The slots a construction claims, or -1 where it is not one a token can be
// spent at. An array construction is excluded for the reason a dying array is:
// what it asks the allocator for is a capacity.
function recipient_slots(f: ssasem.Func, ins: ssa.SInst): i32 {
    if (ins.kind_tag == ssasem.tuple_new()) { return tuple_elements(f.values[ins.result]).len(); }
    if (ins.kind_tag == ssasem.record_new()) { return reuse_slots(f.values[ins.result], f); }
    return 0 - 1;
}

// The last position in the block at which a construction claims each slot
// count. A donor is worth holding while some construction still ahead of it
// claims the count its box has, which this answers in one lookup where a scan
// forward would cost a pass per candidate.
//
// Holding it for the NEXT construction alone is the version that looks right
// and is not: a donor the next one cannot take is dropped, and the one two
// instructions further down that could have taken it allocates. Measured over
// the compiler's own sources, that reading pairs 287 where this one pairs 390.
struct Claims { counts: i32[], last: i32[] }

function block_claims(f: ssasem.Func, b: ssa.SBlock): Claims {
    var counts: i32[] = [];
    var last: i32[] = [];
    var pos: i32 = 0;
    while (pos < b.insts.len()) {
        var c: i32 = recipient_slots(f, b.insts[pos]);
        if (c >= 0) {
            var at: i32 = util.index_of_i32(counts, c);
            if (at < 0) { counts = counts.append(c); last = last.append(pos); }
            else { last = last.with(at, pos); }
        }
        pos = pos + 1;
    }
    return Claims { counts: counts, last: last };
}

function claimed_after(c: Claims, slots: i32, pos: i32): boolean {
    var at: i32 = util.index_of_i32(c.counts, slots);
    return at >= 0 && c.last[at] > pos;
}

function reuse_pairs(f: ssasem.Func, p: ssaunits.Plan, idx: i32[][], b: ssa.SBlock): ReusePairs {
    var tokens: i32[] = [];
    var builds: i32[] = [];
    var selfs: i32[] = [];
    // The #4350 §6.5 differential switch, which the AST path's reuse layer
    // answers too: with it set every construction allocates, so a program's
    // observable behaviour can be compared against its own reusing build.
    var off: boolean = irlower.reuse_layer_disabled();
    var claims_tab: Claims = block_claims(f, b);
    var pending: i32 = 0 - 1;
    var pending_at: i32 = 0 - 1;
    var pos: i32 = 0;
    while (pos < b.insts.len()) {
        tokens = tokens.append(0 - 1);
        builds = builds.append(0 - 1);
        selfs = selfs.append(0 - 1);
        var ins: ssa.SInst = b.insts[pos];
        if (ins.kind_tag != 6 && ins.kind_tag != 8) {
            var step: ssaunits.Step = at(p, idx, b.id, pos, 0 - 1);
            var claims: i32 = recipient_slots(f, ins);
            if (off) { pending = 0 - 1; }
            else {
                if (claims >= 0 && pending >= 0
                        && claims == reuse_slots(f.values[pending], f)
                        && util.index_of_i32(ins.args, pending) < 0) {
                    builds = builds.with(pos, pending);
                    tokens = tokens.with(pending_at, pending);
                    pending = 0 - 1;
                    pending_at = 0 - 1;
                } else if (pending < 0 && claims >= 0) {
                    // Nothing earlier serves this construction, so the box it
                    // supersedes may: a value dying HERE, of the count this
                    // construction claims, that the construction does not read.
                    // Not reading it is what makes it safe to hand on — the
                    // projections that carried its fields over are earlier
                    // instructions, and the plan has already proved it dead.
                    //
                    // `d != ins.result` excludes the degenerate donor: a
                    // construction whose value is never read has its drop at its
                    // own step, so the value dying here IS the result. Pairing it
                    // with itself reads a token slot for a value that does not
                    // exist yet, which always declines — and it costs the
                    // module its last allocating op, so the heap runtime block
                    // stopped being emitted and the link broke on an undefined
                    // `__fn___fern_arr_dec`.
                    //
                    // `pending < 0` is a soundness condition, not a preference:
                    // the frame has ONE token slot, so a self pairing emitted
                    // while a donor is held for a later construction overwrites
                    // that donor's box with its own — which this construction
                    // has already built into and is returning live.
                    for d in step.drops {
                        if (selfs[pos] < 0 && d != ins.result
                                && reuse_slots(f.values[d], f) == claims
                                && util.index_of_i32(ins.args, d) < 0) { selfs = selfs.with(pos, d); }
                    }
                }
                // A construction this pending cannot serve leaves it HELD
                // rather than dropped, the one it is waiting for being further
                // down the block. A value dying AT a construction was offered
                // to that construction above and is not taken as a pending
                // here: the shape that reading was worth — a dying box refilling
                // the slot the construction just emptied — is the same-instruction
                // pairing, which spends it on the spot rather than saving it.
                if (pending < 0 && claims < 0) {
                    for d in step.drops {
                        var sl: i32 = reuse_slots(f.values[d], f);
                        if (pending < 0 && sl >= 0 && claimed_after(claims_tab, sl, pos)) { pending = d; pending_at = pos; }
                    }
                }
            }
        }
        pos = pos + 1;
    }
    return ReusePairs { tokens: tokens, builds: builds, selfs: selfs };
}

// The donor's box when this frame holds its only count, and null otherwise —
// the token recipe of docs/SELFHOST-PERCEUS-REUSE.md §6.2, emitted in place of
// the drop. The runtime helper is pure: it hands a token back when the size
// class matches and allocates when the token is null, so the shared arm
// releases the donor's count here and passes null. The static plan already
// proved the donor dead; the count test makes a hole in that proof degrade to a
// fresh box rather than corrupt one another holder still reads (#4350).
//
// A donor owning references gives up its children here, through the same
// helper `drop_value` calls under the same uniqueness gate — the box arrives
// at the construction as storage and nothing else. The helper releases the
// CHILDREN ONLY, which is what makes it the one to call: the box itself is not
// freed but handed on, and the runtime's mismatch path frees a donor block
// shallowly, so its children are owed here either way.
function reuse_token(own r: irlower.LowerResult, f: ssasem.Func, donor: i32): irlower.LowerResult {
    var token: i32 = token_slot(f);
    r = reserve(r, scratch_base(f));
    r = emit(r, ir.op_load_local(donor));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_if(0));
    if (has_children(f.values[donor], f)) { r = drop_children(r, donor, f.values[donor], scratch_base(f), f); }
    r = emit(r, ir.op_load_local(donor));
    r = emit(r, ir.op_store_local(token));
    r = emit(r, ir.op_else());
    r = release(r, donor, f.values[donor]);
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_store_local(token));
    r = emit(r, ir.op_end());
    // Dead from here: the box is the construction's, and nothing may reach it
    // through the name it arrived under.
    r = emit(r, ir.op_const_i32(0));
    return emit(r, ir.op_store_local(donor));
}

function reuse_construct(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    if (ins.kind_tag == ssasem.tuple_new()) { return reuse_tuple(r, f, ins); }
    var fields: semrecords.Field[] = record_fields(f.values[ins.result], f);
    r = emit(r, ir.op_load_local(token_slot(f)));
    r = emit(r, ir.op_const_i32(fields.len() + 1));
    r = emit(r, ir.op_call_direct("__fern_alloc_reuse", 2));
    r = emit(r, ir.op_store_local(ins.result));
    // The box's first word identifies its type, and `struct_make` is what
    // normally writes it. A construction building through a token never runs
    // that op, and neither box that reaches it carries the right word: the
    // donor's is the DONOR's, and the fresh one holds the length `__fern_arr_box`
    // wrote. So the recipient writes its own, which is also what lets a donor of
    // another type serve it.
    r = emit(r, ir.op_load_local(ins.result));
    r = emit(r, ir.op_struct_set_shape(record_name(f.values[ins.result])));
    r = emit(r, ir.op_drop());
    var i: i32 = 0;
    while (i < ins.args.len() && i < fields.len()) {
        r = emit(r, ir.op_load_local(ins.result));
        r = emit(r, ir.op_load_local(ins.args[i]));
        if (ssasem.is_wide(fields[i].ty)) { r = emit(r, ir.op_struct_set_i64(i)); }
        else { r = emit(r, ir.op_struct_set(i, load_width(fields[i].ty))); }
        i = i + 1;
    }
    return r;
}

// A tuple box has no shape word: element i is slot i, so the box is one word
// per element and there is nothing at slot 0 to identify. The element stores
// carry their own width, as `op_tuple_make_k` does on the fresh path, or wasm
// writes the low half of an eight-byte slot and the read back is garbage.
function reuse_tuple(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    var elems: typeinfo.Type[] = tuple_elements(f.values[ins.result]);
    r = emit(r, ir.op_load_local(token_slot(f)));
    r = emit(r, ir.op_const_i32(elems.len()));
    r = emit(r, ir.op_call_direct("__fern_alloc_reuse", 2));
    r = emit(r, ir.op_store_local(ins.result));
    var i: i32 = 0;
    while (i < ins.args.len() && i < elems.len()) {
        r = emit(r, ir.op_load_local(ins.result));
        r = emit(r, ir.op_load_local(ins.args[i]));
        var kind: string = tuple_kind(elems[i]);
        if (kind == "i64") { r = emit(r, ir.op_tuple_set_w(i, 64, true)); }
        else if (kind == "f64") { r = emit(r, ir.op_tuple_set_w(i, 64, false)); }
        else { r = emit(r, ir.op_tuple_set(i)); }
        i = i + 1;
    }
    return r;
}

function tuple_elements(t: typeinfo.Type): typeinfo.Type[] {
    if let typeinfo.TypeTuple(tup) = t { return tup.elements; }
    return [];
}

function at(p: ssaunits.Plan, idx: i32[][], block: i32, point: i32, target: i32): ssaunits.Step {
    var i: i32 = ssaunits.step_at(p, idx, block, point, target);
    if (i >= 0) { return p.steps[i]; }
    // Unreachable after verification of the complete plan.
    return ssaunits.Step { block: 0 - 1, point: point, target: 0 - 1, supplies: [], drops: [], hand_roots: [], hand_fields: [] };
}

function block_index(f: ssa.SFunc, id: i32): i32 {
    var i: i32 = 0;
    while (i < f.blocks.len()) { if (f.blocks[i].id == id) { return i; } i = i + 1; }
    return 0 - 1;
}

function successors(t: ssa.STerm): i32[] {
    if (t.kind_tag == 2) { return [t.target]; }
    if (t.kind_tag == 3) {
        if (t.t == t.f) { return [t.t]; }
        return [t.t, t.f];
    }
    return [];
}

function edge(own r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, idx: i32[][], from: i32, target: i32): irlower.LowerResult {
    var step: ssaunits.Step = at(p, idx, from, ssaunits.edge_point(), target);
    r = supplies(r, f, p, step, false);
    var dest: ssa.SBlock = f.graph.blocks[block_index(f.graph, target)];
    var pi: i32 = 0;
    while (dest.preds[pi] != from) { pi = pi + 1; }
    // All phi sources remain on the operand stack while old edge units are
    // released. Assign in reverse stack order, after every source was read.
    // Drop helpers and their nested scopes preserve the existing stack prefix.
    for ins in dest.insts {
        if (ins.kind_tag == 8) { r = emit(r, ir.op_load_local(ins.args[pi])); }
    }
    r = drops(r, step, f);
    var i: i32 = dest.insts.len() - 1;
    while (i >= 0) {
        var ins: ssa.SInst = dest.insts[i];
        if (ins.kind_tag == 8) { r = emit(r, ir.op_store_local(ins.result)); }
        i = i - 1;
    }
    return r;
}

function walkable_tuple(tup: typeinfo.TypeTuple, f: ssasem.Func): boolean {
    for elem in tup.elements { if (!walkable(elem, f)) { return false; } }
    return true;
}

// What a schema field has to satisfy is weaker than what a value has to: the
// walk visits only the REFERENCE fields, so a scalar one needs no vocabulary
// here at all, and an array or tuple of scalars needs only its own box
// released. Asking `supported` of every field instead refuses a function for
// a field it never reads.
// An array's element store carries its own width, so a 64-bit element has a
// form there. A tuple construction and a closure box write one i32-shaped word
// per operand and have none. A record or variant stores each field at the
// width its declaration names, which is what `op_struct_make` carries as the
// declaration index; a wide field of a construction whose declaration is not
// in the table has no store width to carry.
function construction_error(f: ssasem.Func, ins: ssa.SInst, structs: irlower.StructTab): string {
    var declared: boolean = ins.kind_tag == ssasem.record_new() || ins.kind_tag == ssasem.variant_new();
    // A builtin union names no declaration and needs none: its box carries the
    // payload's width in the op (`op_opt_make_w`) rather than reading it from a
    // field table.
    if (ins.kind_tag == ssasem.variant_new() && enum_layout(f, f.values[ins.result]) == semrecords.layout_option()) { return ""; }
    for arg in ins.args {
        if (narrow_slot(f.values[arg])) { continue; }
        if (!declared) { if (!wide_element_site(ins.kind_tag)) { return "unsupported physical RC construction element"; } }
        else if (decl_of(f, ins, structs) < 0) { return "unsupported physical RC construction without declaration"; }
    }
    return "";
}

// The undeclared constructions that carry their own element width: the array
// ops, of which a cell's slot is one, and the tuple construction through the
// kinds `tuple_kinds` names.
// A dyn box stores its primitive at the width the primitive's name gives.
function wide_element_site(k: i32): boolean {
    return kind_in([ssasem.array_new(), ssasem.tuple_new(), ssasem.append(), ssasem.with(),
        ssasem.cell_new(), ssasem.cell_set(), ssasem.dyn_box()], k);
}

// The declaration a record or variant construction stores its fields
// through: a record's by its name, a variant's by its name within its enum,
// since two enums may declare one variant name with differently sized
// payloads. -1 when the table holds no such declaration.
function decl_of(f: ssasem.Func, ins: ssa.SInst, structs: irlower.StructTab): i32 {
    if (ins.kind_tag == ssasem.record_new()) { return irlower.decl_index_of(structs, record_name(f.values[ins.result])); }
    return irlower.variant_decl_index(structs, ins.str, enum_name(f.values[ins.result]));
}

function enum_name(t: typeinfo.Type): string {
    if let typeinfo.TypeUnion(u) = t { return u.name; }
    return "";
}

function walkable(t: typeinfo.Type, f: ssasem.Func): boolean {
    if let typeinfo.TypeArray(a) = t { return walkable(a.elem, f); }
    if let typeinfo.TypeTuple(tup) = t { return walkable_tuple(tup, f); }
    if (ssasem.reference(t)) { return supported(t, f); }
    // A stream handle stores as the descriptor word and its release walks
    // nothing, so a field or payload of one is walkable without a schema.
    if (semtypes.is_handle(t)) { return true; }
    if let typeinfo.TypeI32(_) = t { return true; }
    if let typeinfo.TypeBool(_) = t { return true; }
    if let typeinfo.TypeFloat(fl) = t { return fl.width == 32 || fl.width == 64; }
    return false;
}

function schema_types_error(f: ssasem.Func): string {
    for record in f.records {
        for field in record.fields { if (!walkable(field.ty, f)) { return "unsupported physical RC record field type"; } }
    }
    for e in f.enums {
        for v in e.variants {
            for field in v.fields { if (!walkable(field.ty, f)) { return "unsupported physical RC variant field type"; } }
        }
    }
    return "";
}

function named(t: typeinfo.Type): string {
    if (semtypes.is_cell(t)) { return ""; }
    if let typeinfo.TypeStruct(r) = t { return r.name; }
    if let typeinfo.TypeUnion(u) = t { return u.name; }
    return "";
}

// A nominal type's children are released by its own helper rather than by an
// inline expansion. The descent that would close a cycle is a call, so a type
// that reaches itself still has a finite lowering. The helper releases the
// box's CHILDREN ONLY: its caller has already proved __fern_rc_is_unique(box)
// and releases the box itself once the helper returns.
//
// Distinct from the AST path's __struct_drop_<T>, which guards each nested
// field itself and hands back the box. The two are not interchangeable.
pub function drop_helper_name(t: typeinfo.Type): string { return "__sem_drop_" + ssasem.type_key(t); }

// The release of ONE value of a map's column of boxes, called by the runtime
// on the entry an insert supersedes and on every entry the map's release
// walks: the same drop a frame gives a unit of the type it holds.
pub function release_helper_name(t: typeinfo.Type): string { return "__sem_release_" + ssasem.type_key(t); }

function release_helper(t: typeinfo.Type, f: ssasem.Func): irlower.LowerResult {
    var r: irlower.LowerResult = irlower.LowerResult { ...empty(""), ok: true,
        n_params: 1, n_locals: 1, name: release_helper_name(t) };
    r = drop_value(r, 0, t, 1, f);
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_return());
    return r;
}

// The element types of the columns of boxes this function's values and schema
// fields name — a keyed key column's and a boxed value column's — each once.
function boxed_columns(f: ssasem.Func): typeinfo.Type[] {
    var out: typeinfo.Type[] = [];
    var names: string[] = [];
    var all: typeinfo.Type[] = f.values;
    for rec in f.records { for field in rec.fields { all = all.append(field.ty); } }
    for e in f.enums { for v in e.variants { for field in v.fields { all = all.append(field.ty); } } }
    for t in all {
        if (!ssasem.is_map(t)) { continue; }
        var cols: typeinfo.Type[] = [];
        if (ssasem.keyed_map_key(ssasem.map_key(t))) { cols = cols.append(ssasem.map_key(t)); }
        if (ssasem.boxed_map_value(ssasem.map_value(t))) { cols = cols.append(ssasem.map_value(t)); }
        for v in cols {
            var name: string = release_helper_name(v);
            if (util.index_of_str(names, name) >= 0) { continue; }
            names = names.append(name);
            out = out.append(v);
        }
    }
    return out;
}

// n_locals starts at n_params: `reserve` only grows it, and a body whose frame
// is smaller than its parameters puts the prologue's parameter copy below the
// allocated frame. The body is the raw op sequence: every function that
// mentions the type produces one, and `merge_helpers` runs the peephole once
// per symbol it keeps rather than once per producer.
function one_helper(t: typeinfo.Type, f: ssasem.Func): irlower.LowerResult {
    var r: irlower.LowerResult = irlower.LowerResult { ...empty(""), ok: true,
        n_params: 1, n_locals: 1, name: drop_helper_name(t) };
    if let typeinfo.TypeStruct(_) = t { r = drop_record_fields(r, 0, record_fields(t, f), 1, f, semtypes.is_env(t)); }
    if let typeinfo.TypeUnion(_) = t {
        if (self_tail_enum(t, f)) { r = drop_variant_chain(r, t, f); }
        else { r = drop_variant_fields(r, 0, t, 1, f); }
    }
    // The one value the caller's `drop` after the call discards.
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_return());
    return r;
}

function optimized_helper(h: irlower.LowerResult): irlower.LowerResult {
    var optimized: ir.OptimizedOps = ir.optimize_ops(h.ops, 1, h.n_locals);
    return irlower.LowerResult { ...h, ops: optimized.ops, n_locals: optimized.n_locals };
}

// One helper per nominal schema the walk can call, gated on has_children —
// the same predicate that decides whether drop_value emits the call, so every
// call this function's lowering makes has a body here. A schema the function
// mentions but never drops yields a body nothing reaches, which the weak
// linkage discards; the reverse, a call with no body, is what the shared gate
// rules out. A function's schema set is closed under field reachability, so
// iterating it also reaches the types the bodies themselves call.
pub function drop_helpers(f: ssasem.Func): irlower.LowerResult[] {
    var out: irlower.LowerResult[] = [];
    for rec in f.records { if (has_children(rec.ty, f)) { out = out.append(one_helper(rec.ty, f)); } }
    for e in f.enums { if (has_children(e.ty, f)) { out = out.append(one_helper(e.ty, f)); } }
    for v in boxed_columns(f) { out = out.append(release_helper(v, f)); }
    return out;
}

function named_index(rows: irlower.LowerResult[], name: string): i32 {
    var i: i32 = 0;
    while (i < rows.len()) { if (rows[i].name == name) { return i; } i = i + 1; }
    return 0 - 1;
}

function replaced(rows: irlower.LowerResult[], at: i32, row: irlower.LowerResult): irlower.LowerResult[] {
    var out: irlower.LowerResult[] = [];
    var i: i32 = 0;
    while (i < rows.len()) {
        if (i == at) { out = out.append(row); } else { out = out.append(rows[i]); }
        i = i + 1;
    }
    return out;
}

// Two functions that both mention a type each produce a helper for it, so the
// tail is merged by symbol. A body lowered from a declaration carries no name,
// so scanning the whole cache cannot collide with one.
//
// The bodies are built from a schema table the whole module shares, so they
// agree. A disagreement would be a miscompile rather than a preference, and
// the .weak linkage that lets duplicates co-link would pick one silently — so
// it becomes a refusal the emit path stops on instead.
pub function merge_helpers(cache: irlower.LowerResult[], helpers: irlower.LowerResult[]): irlower.LowerResult[] {
    var out: irlower.LowerResult[] = cache;
    var raw: irlower.LowerResult[] = [];
    for h in helpers {
        var at: i32 = named_index(raw, h.name);
        if (at < 0) { raw = raw.append(h); }
        else if (!ir.ops_equal(raw[at].ops, h.ops) || raw[at].n_params != h.n_params
                || raw[at].n_locals != h.n_locals) {
            raw = replaced(raw, at, irlower.LowerResult { ...h, ok: false,
                why: "conflicting drop helper for " + h.name });
        }
    }
    for h in raw {
        if (named_index(out, h.name) >= 0) { continue; }
        if (h.ok) { out = out.append(optimized_helper(h)); } else { out = out.append(h); }
    }
    return out;
}

function types_error(f: ssasem.Func): string {
    var why: string = schema_types_error(f);
    if (why != "") { return why; }
    for t in f.values { if (!supported(t, f)) { return "unsupported physical RC value type"; } }
    if (!supported(f.result, f)) { return "unsupported physical RC result type"; }
    for c in f.calls {
        for t in c.params { if (!supported(t, f)) { return "unsupported physical RC call parameter type"; } }
        if (!supported(c.result, f)) { return "unsupported physical RC call result type"; }
    }
    return "";
}

function validate(f: ssasem.Func, modes: i32[], p: ssaunits.Plan, structs: irlower.StructTab): string {
    var why: string = ssaunits.verify(f, modes, p);
    if (why != "") { return why; }
    why = types_error(f);
    if (why != "") { return why; }
    // Keep this physical vocabulary closed when semantic analysis grows new
    // operations. Verification of a new operation does not implement its ABI.
    for b in f.graph.blocks {
        for ins in b.insts {
            if (!supported_op(ins.kind_tag)) { return "unsupported physical RC operation"; }
            if (dyn_call(ins) && !consecutive(ins.args)) { return "dyn call operands are not consecutive slots"; }
            if (builds(ins.kind_tag)) {
                why = construction_error(f, ins, structs);
                if (why != "") { return why; }
            }
        }
    }
    return "";
}

// The operations that write a value into a container's slot. A closure box is
// one: its captures occupy the same i32-shaped words an array element does.
function builds(k: i32): boolean {
    return kind_in([ssasem.array_new(), ssasem.tuple_new(), ssasem.record_new(), ssasem.variant_new(),
        ssasem.append(), ssasem.with(), ssasem.closure_new(), ssasem.cell_new(), ssasem.cell_set(), ssasem.dyn_box()], k);
}

function kind_in(kinds: i32[], k: i32): boolean {
    for kind in kinds { if (kind == k) { return true; } }
    return false;
}

// Everything that is not a container operation: the constants and a type's
// zero, a parameter, a copy, a phi, the scalar operators, a call, a closure
// value and the call through one.
function value_op(k: i32): boolean {
    return kind_in([1, 2, 5, 6, 7, 8, ssasem.zero(), ssasem.call()], k) || ssasem.scalar_op(k) || ssasem.is_function_op(k);
}

function container_op(k: i32): boolean {
    return kind_in([ssasem.array_new(), ssasem.tuple_new(), ssasem.record_new(), ssasem.dyn_box(),
        ssasem.array_get(), ssasem.tuple_get(), ssasem.record_get(),
        ssasem.length(), ssasem.append(), ssasem.with(), ssasem.slice(), ssasem.str_index(),
        ssasem.str_bytes(), ssasem.arr_sum(), ssasem.arr_product(), ssasem.arr_join(), ssasem.arr_slice()], k)
        || variant_op(k) || ssasem.is_cell_op(k) || ssasem.is_map_op(k) || ssasem.is_map_iter_op(k);
}

function variant_op(k: i32): boolean {
    return kind_in([ssasem.variant_new(), ssasem.variant_is(), ssasem.variant_get()], k) || identity_op(k);
}

// A struct-union's member is its own box, a view and the string it borrows
// are one box, and a dyn value is the box it was widened from, so widening,
// narrowing and a string retag move no bytes: the operand is already on the
// stack and the store below takes it.
function identity_op(k: i32): boolean {
    return kind_in([ssasem.variant_up(), ssasem.variant_as(), ssasem.str_as(), ssasem.dyn_up()], k);
}

function supported_op(k: i32): boolean { return value_op(k) || container_op(k); }

// A value's SSA id is its local slot, so the slot lists are a walk of the
// value types. Only wasm reads them: it spells each local and the result in
// the function's type, where the register backends give every value the same
// 64-bit slot and ignore the distinction.
function result_kind(t: typeinfo.Type): i32 {
    if (ssasem.is_wide(t)) { return irlower.result_i64(); }
    if (ssasem.is_float(t)) { return irlower.result_f64(); }
    return irlower.result_i32();
}

function frame(f: ssasem.Func): irlower.LowerResult {
    var r: irlower.LowerResult = empty("");
    r = irlower.LowerResult { ...r, ok: true, n_params: f.params.len(), n_locals: f.graph.nvals,
        name: f.graph.name, result_kind: result_kind(f.result) };
    var vi: i32 = 0;
    while (vi < f.values.len()) {
        if let typeinfo.TypeArray(_) = f.values[vi] { r = irlower.LowerResult { ...r, arr_slots: r.arr_slots.append(vi) }; }
        if let typeinfo.TypeString(_) = f.values[vi] { r = irlower.LowerResult { ...r, str_slots: r.str_slots.append(vi) }; }
        if (ssasem.is_wide(f.values[vi])) { r = irlower.LowerResult { ...r, i64_slots: r.i64_slots.append(vi) }; }
        if (ssasem.is_float(f.values[vi])) { r = irlower.LowerResult { ...r, f64_slots: r.f64_slots.append(vi) }; }
        vi = vi + 1;
    }
    return r;
}

// The stack IR's name for each integer operator, the signed form where the
// IR distinguishes one.
function binary_kind(op: string): string {
    var ops: string[] = ["+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>", "<", "<=", ">", ">=", "=="];
    var kinds: string[] = ["add", "sub", "mul", "div_s", "rem_s", "and", "or", "xor", "shl", "shr_s", "lt_s", "le_s", "gt_s", "ge_s", "eq"];
    var i: i32 = 0;
    while (i < ops.len()) {
        if (ops[i] == op) { return kinds[i]; }
        i = i + 1;
    }
    return "ne";
}

// `+`, `-`, `*` and `<<` are the operators whose result can leave the range its
// type names; every other one lands inside a range its operands are already in,
// and a comparison lands in a boolean.
function wraps(op: string): boolean {
    return op == "+" || op == "-" || op == "*" || op == "<<";
}

// The stack IR runs the integer operators in a register wider than any of these
// types, so a result that can exceed the type's width is masked back to it
// explicitly — the same step the AST lowering emits, and what the interpreter's
// per-width arithmetic does (`2147483647 + 1` is INT_MIN, `255u8 + 1` is 0).
function wrap_kind(t: typeinfo.Type): string {
    if (ssasem.is_u8(t)) { return "u8"; }
    if (ssasem.is_u32(t)) { return "u32"; }
    return "i32";
}

// The stack IR's name for an integer operator at its operands' own
// signedness. The orderings, the right shift and div/rem read the slot's sign
// bit, which an unsigned operand does not have; the verifier gives both
// operands the same type, so one of them names the form.
function integer_kind(op: string, operand: typeinfo.Type): string {
    if (ssasem.is_unsigned_int(operand)) { return irlower.to_unsigned_kind(binary_kind(op)); }
    return binary_kind(op);
}

// The width the operator RUNS at, which a comparison's boolean result does not
// name — its operands do.
function operand_width(f: ssasem.Func, ins: ssa.SInst): i32 {
    if (ssasem.is_wide(f.values[ins.args[0]])) { return 64; }
    return 0;
}

// A string `+` is the runtime's concatenation, a fresh box; equality reads
// both operands, and an ordering is `str_cmp` — which hands back a signed i32
// under, at or over zero — against a zero constant. The verifier admits no
// other string operator (ssasem.string_result).
function string_binary(own r: irlower.LowerResult, ins: ssa.SInst): irlower.LowerResult {
    if (ins.str == "+") { return emit(r, ir.op_str_concat()); }
    if (ins.str != "==" && ins.str != "!=") {
        r = emit(r, ir.op_str_cmp());
        r = emit(r, ir.op_const_i32(0));
        return emit(r, ir.op_bin(binary_kind(ins.str), 0, false));
    }
    r = emit(r, ir.op_str_eq());
    if (ins.str == "!=") { return emit(r, ir.op_bin("not", 0, false)); }
    return r;
}

// The float operators are the stack IR's own f64 opcodes: arithmetic hands
// back an f64, rounded to single precision where the result is an f32, a
// comparison the i32 the boolean occupies, and negation flips the sign bit.
// Nothing wraps.
function float_scalar(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    if (ins.kind_tag == 10) { return emit(r, ir.op_funary("fneg")); }
    r = emit(r, ir.op_fbin(irlower.map_fbinop(ins.str)));
    if (ssasem.is_f32(f.values[ins.result])) { return round_f32(r); }
    return r;
}

// An f32 is the f64 on the stack rounded to single precision, which the
// demote-and-promote pair applies.
function round_f32(own r: irlower.LowerResult): irlower.LowerResult {
    r = emit(r, ir.op_f32_bits());
    return emit(r, ir.op_f32_from_bits());
}

// Into a float: an integer converts at its width and signedness, the other
// float width is already the f64, and an f32 destination rounds.
function into_float(own r: irlower.LowerResult, from: typeinfo.Type, to: typeinfo.Type): irlower.LowerResult {
    if (!ssasem.is_float(from)) {
        var bits: i32 = 32;
        if (ssasem.is_wide(from)) { bits = 64; }
        r = emit(r, ir.op_int_to_f64(bits, ssasem.is_unsigned_int(from)));
    }
    if (ssasem.is_f32(to)) { return round_f32(r); }
    return r;
}

// A saturating or checked operator is the AST lowering's own shape
// (irlower.sat_binary_ops / chk_binary_ops) over this function's slots: the
// operands are values, so they are already in slots, the result's slot holds
// the shape's outcome, and an intermediate the shape reads twice is
// recomputed from the operands rather than spilled, so it takes no scratch.
function overflow_binary(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    var t: typeinfo.Type = f.values[ins.args[0]];
    var wide: boolean = ssasem.is_wide(t);
    var ops: ir.Op[] = [];
    if (ssasem.saturating(ins.str)) {
        ops = irlower.sat_binary_ops(ins.str, overflow_kind(t), wide, ins.args[0], ins.args[1], ins.result, 0 - 1, 0 - 1);
    } else {
        ops = irlower.chk_binary_ops(ins.str, overflow_kind(t), wide, ins.args[0], ins.args[1], 0 - 1, ins.result);
    }
    for op in ops { r = emit(r, op); }
    return r;
}

// The width-and-signedness name the shape is written against.
function overflow_kind(t: typeinfo.Type): string {
    if (ssasem.is_u8(t)) { return "u8"; }
    if (ssasem.is_u32(t)) { return "u32"; }
    if (ssasem.is_i64(t)) { return "i64"; }
    if (ssasem.is_u64(t)) { return "u64"; }
    return "i32";
}

function scalar(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    if (ins.kind_tag == ssasem.cast()) { return cast(r, f, ins); }
    if (ins.kind_tag == 9 && ssasem.is_text(f.values[ins.args[0]])) { return string_binary(r, ins); }
    if (ins.kind_tag == 10 && ins.str == "!") { return emit(r, ir.op_bin("not", 0, false)); }
    if (ssasem.is_float(f.values[ins.args[0]])) { return float_scalar(r, f, ins); }
    var w: i32 = operand_width(f, ins);
    if (ins.kind_tag == 9) { r = emit(r, ir.op_bin(integer_kind(ins.str, f.values[ins.args[0]]), w, false)); }
    else { r = emit(r, ir.op_bin("sub", w, false)); }
    // The 64-bit operators are already full-width, so only a narrower result
    // can leave the range its type names.
    if (!wraps(ins.str) || ssasem.is_wide(f.values[ins.result])) { return r; }
    return emit(r, ir.op_int_cast(wrap_kind(f.values[ins.result])));
}

// The mask a NARROW destination applies to a narrow operand: the byte's 255,
// the u32's zero-extension of the low word, the i32's sign-extension of it.
// "" where the operand's own type already keeps its value inside the
// destination's range — a byte is inside every wider narrow type, and a
// conversion to the type the value already has moves no bits.
function narrow_mask(from: typeinfo.Type, to: typeinfo.Type): string {
    if (semtypes.equal(from, to)) { return ""; }
    if (ssasem.is_u8(to)) { return "u8"; }
    if (ssasem.is_u8(from)) { return ""; }
    if (ssasem.is_u32(to)) { return "u32"; }
    return "i32";
}

// Out of a float: the truncation, and then the u8 mask. The conversions below
// answer at 32 or 64 bits, so a u8 destination needs the narrowing the integer
// wrap applies for the same destination — without it `300.7 as u8` keeps 300
// where the AST lowering and native both answer 44.
function out_of_float(own r: irlower.LowerResult, to: typeinfo.Type): irlower.LowerResult {
    r = emit(r, from_f64(to));
    if (!ssasem.is_u8(to)) { return r; }
    return emit(r, ir.op_int_cast("u8"));
}

// Out of the f64: a truncation toward zero at the destination's width and
// signedness. The signed forms clamp at the signed maximum, and at the signed
// MINIMUM out of a negative, which is the wrong answer for a destination that
// has no sign bit: out_of_float's u8 mask then reads that clamp's low byte,
// so `-1.0 as u8` answered 255 rather than native's 0 (#9912).
//
// Signedness comes from the destination, not from its width — the narrow
// unsigned types share the u32's conversion, exactly as native picks
// `Unsigned: !dstInt.IsSigned()` and then canonicalises to the destination's
// representation.
function from_f64(to: typeinfo.Type): ir.Op {
    if (ssasem.is_u64(to)) { return ir.op_f64_to_u64(); }
    if (ssasem.is_wide(to)) { return ir.op_f64_to_i64(); }
    if (ssasem.is_unsigned_int(to)) { return ir.op_f64_to_u32(); }
    return ir.op_f64_to_i32();
}

// A conversion between the integer types, in the two domains the stack IR
// separates. Crossing the 64-bit boundary is an explicit extend or wrap, and
// the SOURCE's signedness is what an extension extends by: only the signed
// 32-bit width fills the high half from a sign bit. Inside the narrow domain
// the conversion is the destination's own mask. Into and out of a float is a
// real conversion: the convert at the operand's width and signedness, and the
// truncation toward zero at the result's; into the f32 the value is rounded
// to single precision, and out of it to the f64 it is already the f64.
function cast(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    var from: typeinfo.Type = f.values[ins.args[0]];
    var to: typeinfo.Type = f.values[ins.result];
    // An address and the box it names share a slot, so neither direction of the
    // reinterpretation moves anything. Both have to answer before the width
    // arms below, which would read the reference as a narrow integer and emit a
    // wrap for it.
    if (ssasem.is_usize(from) && ssasem.reference(to)) { return r; }
    if (ssasem.reference(from) && ssasem.is_usize(to)) { return r; }
    if (ssasem.is_float(to)) { return into_float(r, from, to); }
    if (ssasem.is_float(from)) { return out_of_float(r, to); }
    if (ssasem.is_usize(from)) { return from_address(r, to); }
    if (ssasem.is_usize(to)) { return into_address(r, from); }
    if (ssasem.is_wide(to)) {
        if (ssasem.is_wide(from)) { return r; }
        return emit(r, ir.op_int_extend(ssasem.is_unsigned_int(from)));
    }
    if (ssasem.is_wide(from)) {
        r = emit(r, ir.op_int_wrap(ssasem.is_unsigned_int(to)));
        if (!ssasem.is_u8(to)) { return r; }
        return emit(r, ir.op_int_cast("u8"));
    }
    var mask: string = narrow_mask(from, to);
    if (mask == "") { return r; }
    return emit(r, ir.op_int_cast(mask));
}

// The pointer width is the whole slot on a register backend and the i32 on
// wasm, so neither direction of an address conversion is one opcode. Each is
// written as the pair that is a no-op on whichever of the two the address
// already matches: the address is taken to the 64-bit domain and wrapped back
// down to the destination, and a narrow source is extended to 64 bits before
// being wrapped to the address. On a register backend the pointer-width half
// moves nothing and the 64-bit half does the extension; on wasm the two halves
// cancel for a 32-bit destination and the 64-bit half is the real conversion.
function from_address(own r: irlower.LowerResult, to: typeinfo.Type): irlower.LowerResult {
    if (ssasem.is_usize(to)) { return r; }
    r = emit(r, ir.op_int_extend_ptr());
    if (ssasem.is_wide(to)) { return r; }
    r = emit(r, ir.op_int_wrap(ssasem.is_unsigned_int(to)));
    if (!ssasem.is_u8(to)) { return r; }
    return emit(r, ir.op_int_cast("u8"));
}

function into_address(own r: irlower.LowerResult, from: typeinfo.Type): irlower.LowerResult {
    if (!ssasem.is_wide(from)) { r = emit(r, ir.op_int_extend(ssasem.is_unsigned_int(from))); }
    return emit(r, ir.op_int_wrap_ptr());
}

// A tuple's slots are a uniform eight bytes on every backend; only wasm picks
// the store instruction per element, and it reads the choice out of the kinds
// string `op_tuple_make_k` carries. The READ side has named its width all
// along (`op_tuple_get_w`), which is why this was the only half missing. An
// f32 occupies the f64's slot, as it does in an array.
function tuple_kind(t: typeinfo.Type): string {
    if (ssasem.is_float(t)) { return "f64"; }
    if (ssasem.is_wide(t)) { return "i64"; }
    return "i32";
}

function tuple_kinds(t: typeinfo.Type): string {
    var out: string = "";
    if let typeinfo.TypeTuple(tup) = t {
        var i: i32 = 0;
        while (i < tup.elements.len()) {
            if (i > 0) { out = out + ","; }
            out = out + tuple_kind(tup.elements[i]);
            i = i + 1;
        }
    }
    return out;
}

// The window copy the runtime hands back aliases every element pointer it
// copied, so a counted element is retained once per slot — the same retain
// `sole_owned_base` makes over the same copy.
function arr_slice(own r: irlower.LowerResult, elem: typeinfo.Type): irlower.LowerResult {
    r = emit(r, ir.op_arr_slice(elem_width(elem)));
    if (!ssasem.reference(elem)) { return r; }
    return emit(r, ir.op_call_direct("__fern_arr_inc_elems", 1));
}

// A record box is named by its declaration, a variant box by its variant. The
// declaration index is where wasm reads each field's store width; the register
// backends store every field as 8 bytes, and every read takes its offset from
// the field index alone.
function container(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst, structs: irlower.StructTab): irlower.LowerResult {
    if (variant_op(ins.kind_tag)) { return variant(r, f, ins, structs); }
    if (ins.kind_tag == ssasem.array_new()) { return emit(r, arr_make_op(elem_type(f.values[ins.result]), ins.args.len())); }
    if (ins.kind_tag == ssasem.tuple_new()) { return emit(r, ir.op_tuple_make_k(ins.args.len(), tuple_kinds(f.values[ins.result]))); }
    if (ins.kind_tag == ssasem.record_new()) { return emit(r, ir.op_struct_make(record_name(f.values[ins.result]), ins.args.len(), decl_of(f, ins, structs))); }
    if (ins.kind_tag == ssasem.dyn_box()) { return emit(r, ir.op_dyn_box(ins.str)); }
    if (ins.kind_tag == ssasem.length()) {
        if (ssasem.is_text(f.values[ins.args[0]])) { return emit(r, ir.op_str_len()); }
        return emit(r, ir.op_arr_len());
    }
    if (ins.kind_tag == ssasem.slice()) { return emit(r, ir.op_str_slice()); }
    if (ins.kind_tag == ssasem.arr_slice()) { return arr_slice(r, elem_type(f.values[ins.result])); }
    if (ins.kind_tag == ssasem.str_bytes()) { return emit(r, ir.op_str_bytes()); }
    if (ins.kind_tag == ssasem.arr_sum()) { return emit(r, ir.op_call_direct("__fern_arr_i32_sum", 1)); }
    if (ins.kind_tag == ssasem.arr_product()) { return emit(r, ir.op_call_direct("__fern_arr_i32_product", 1)); }
    if (ins.kind_tag == ssasem.str_index() && ins.imm == 1) { return emit(r, ir.op_str_index_nc()); }
    if (ins.kind_tag == ssasem.str_index()) { return emit(r, ir.op_str_index()); }
    if (ssasem.is_map_op(ins.kind_tag)) { return map_op(r, ins, f); }
    if (ins.kind_tag == ssasem.array_get()) { return emit(r, arr_get_op(f.values[ins.result], ins.imm == 1)); }
    if (ins.kind_tag == ssasem.tuple_get()) { return emit(r, ir.op_tuple_get_w(ins.imm, load_width(f.values[ins.result]), ssasem.is_wide(f.values[ins.result]))); }
    return field_get(r, f, ins);
}

// The map ops at the shapes this boundary admits: a string, integer or keyed
// key column (keykind 0, 1 or 2 — the keyed one probed through the key's
// derived equality) over a narrow scalar or a counted value column, both
// narrow in the runtime's width sense (widekind 0). An insert is handed a
// counted key's unit, which `kconsume` tells the runtime to hold rather than
// retain and to release when an overwrite supersedes it — through the key's
// own release for a keyed column, which the op names beside the value's — and
// the value's unit too when the column is counted: `valptr` + `vconsume` for
// the store, and `vkind` for the release an overwrite owes what it supersedes.
// `owncols` makes the map the sole owner of both column buffers, so a grow
// frees the buffer it replaced instead of leaking it.
//
// A read of a counted column RETAINS what it answers. The plan gives the
// result a unit of its own because the value may be the column's or the
// caller's default, and only a retain gives one owner to both.
function map_op(own r: irlower.LowerResult, ins: ssa.SInst, f: ssasem.Func): irlower.LowerResult {
    if (ins.kind_tag == ssasem.map_new()) { return emit(r, ir.op_map_new(map_key_kind(f.values[ins.result]), map_key_fns(f.values[ins.result]))); }
    if (ins.kind_tag == ssasem.map_len()) { return emit(r, ir.op_map_len()); }
    // A clear reads nothing from the receiver — this runtime's map box is the
    // two columns and no capacity beside them, so an empty box of the same key
    // kind is what clearing produces. The capacity the construction op pops is
    // a hint every backend discards.
    if (ins.kind_tag == ssasem.map_cleared()) {
        r = emit(r, ir.op_const_i32(8));
        return emit(r, ir.op_map_new(map_key_kind(f.values[ins.result]), map_key_fns(f.values[ins.result])));
    }
    var t: typeinfo.Type = f.values[ins.args[0]];
    var kkind: i32 = map_key_kind(t);
    var vkind: i32 = map_value_kind(t);
    var eq: string = map_key_eq(t);
    var vrel: string = "";
    var krel: string = "";
    if (vkind == 3) { vrel = release_helper_name(ssasem.map_value(t)); }
    if (kkind == 2) { krel = release_helper_name(ssasem.map_key(t)); }
    if (ins.kind_tag == ssasem.map_insert()) {
        return emit(r, ir.op_map_set(kkind, vkind != 0, vkind != 0, kkind != 1, true, false, ir.map_op_packed(eq, vrel, krel), 0, vkind));
    }
    if (ins.kind_tag == ssasem.map_has()) { return emit(r, ir.op_map_has(kkind, eq)); }
    if (ins.kind_tag == ssasem.map_get()) { return map_get(r, ins, kkind, eq, vkind != 0); }
    if (ins.kind_tag == ssasem.map_keys()) { return emit(r, ir.op_map_keys(column_flag(ssasem.map_key(t)))); }
    if (ins.kind_tag == ssasem.map_values()) { return emit(r, ir.op_map_values(column_flag(ssasem.map_value(t)), 0)); }
    if (ins.kind_tag == ssasem.map_delete()) {
        return emit(r, ir.op_map_delete(kkind, ir.map_op_packed(eq, vrel, krel), kkind != 1, vkind));
    }
    r = emit(r, ir.op_map_get_or(kkind, eq, 0));
    if (vkind == 0) { return r; }
    return emit(r, ir.op_call_direct("__fern_rc_inc", 1));
}

// The runtime's column-snapshot flag: 2 copies a column of references — a
// string column, a keyed column, a column of boxes — with a per-element
// retain, 0 a column of i32 that holds no references. The raw alias (1) every
// other element type would take is unreachable — semsource refuses those
// columns rather than hand the frame elements the map still owns — so the
// widekind that would go with a wide column is 0 here too.
function column_flag(elem: typeinfo.Type): i32 {
    if (ssasem.reference(elem)) { return 2; }
    return 0;
}

// A get answers an Option box of the frame's own whose payload the runtime
// copies out of the column without a retain, so a hit on a counted column
// retains the payload here: the box then owns one unit of it, as any Option
// this frame drops is expected to.
function map_get(own r: irlower.LowerResult, ins: ssa.SInst, kkind: i32, eq: string, counted: boolean): irlower.LowerResult {
    r = emit(r, ir.op_map_get(kkind, eq, 0));
    if (!counted) { return r; }
    r = emit(r, ir.op_store_local(ins.result));
    r = emit(r, ir.op_load_local(ins.result));
    r = emit(r, ir.op_opt_tag());
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_bin("eq", 0, false));
    r = emit(r, ir.op_if(0));
    r = emit(r, ir.op_load_local(ins.result));
    r = emit(r, ir.op_opt_payload());
    r = emit(r, ir.op_call_direct("__fern_rc_inc", 1));
    r = emit(r, ir.op_drop());
    r = emit(r, ir.op_end());
    return emit(r, ir.op_load_local(ins.result));
}

// A field read at the width its type names. Every slot is 8 bytes on every
// backend, so the offset is the index alone; only wasm's typed load needs to
// know that the slot holds an i64 or an f64 rather than a pointer in its low
// half, and the schema this boundary verified the projection against is what
// says so.
function load_width(t: typeinfo.Type): i32 {
    if (ssasem.is_wide(t) || ssasem.is_float(t)) { return 64; }
    return 0;
}
// An environment record is the closure box, physically the word array the
// lift builds: its field k is the box's slot k, read with the array op, since
// only the register backends give a record's fields and an array's elements
// the same stride.
function field_get(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    var t: typeinfo.Type = f.values[ins.result];
    if (semtypes.is_env(f.values[ins.args[0]])) {
        r = emit(r, ir.op_const_i32(ins.imm));
        return emit(r, ir.op_arr_get(32));
    }
    if (ssasem.is_wide(t)) { return emit(r, ir.op_struct_get_i64(ins.imm)); }
    return emit(r, ir.op_struct_get(ins.imm, load_width(t)));
}

function variant(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst, structs: irlower.StructTab): irlower.LowerResult {
    if (identity_op(ins.kind_tag)) { return r; }
    var whole: typeinfo.Type = variant_union(f, ins);
    if (enum_layout(f, whole) == semrecords.layout_option()) { return option_site(r, f, ins, whole); }
    if (ins.kind_tag == ssasem.variant_new()) { return emit(r, ir.op_struct_make(ins.str, ins.args.len(), decl_of(f, ins, structs))); }
    if (ins.kind_tag == ssasem.variant_is()) { return emit(r, ir.op_variant_is(ins.str)); }
    return field_get(r, f, ins);
}

// The union a variant instruction works on: a construction produces one, and
// a test or a projection reads one.
function variant_union(f: ssasem.Func, ins: ssa.SInst): typeinfo.Type {
    if (ins.kind_tag == ssasem.variant_new()) { return f.values[ins.result]; }
    return f.values[ins.args[0]];
}

function enum_layout(f: ssasem.Func, t: typeinfo.Type): i32 {
    var at: i32 = semrecords.find_enum(f.enums, t);
    if (at < 0) { return 0; }
    return f.enums[at].layout;
}

function variant_tag(f: ssasem.Func, t: typeinfo.Type, name: string): i32 {
    return semrecords.find_variant(f.enums[semrecords.find_enum(f.enums, t)], name);
}

// A payload wider than the narrow slot rides the box's wide form, chosen from
// the payload AT THIS SITE rather than from the union: a mixed
// `Result[i64, string]` writes its Ok through the wide form and its Err — a
// pointer — through the narrow one, which is what each arm reads back. Making
// the whole union wide instead pushes the pointer into an i64 slot, and wasm
// refuses the module for it.
//
// An f32 takes the same 8-byte slot as an f64 rather than a narrow one of its
// own (#7756); `is_float` covers both, and the flag says integer or float
// rather than which width.
function wide_payload(t: typeinfo.Type): boolean {
    return ssasem.is_wide(t) || ssasem.is_float(t);
}

// A builtin union's box is a tag word and one payload word: the tag IS the
// variant's position in the schema, so a test compares it and a projection
// reads the single payload without a field index. `op_opt_none` writes the
// tag at position 1 itself; an Ok carrying `void` is the box at position 0
// with a zero payload word, as the writers hand it back.
function option_site(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst, whole: typeinfo.Type): irlower.LowerResult {
    var tag: i32 = variant_tag(f, whole, ins.str);
    if (ins.kind_tag == ssasem.variant_new()) {
        if (ins.args.len() == 0 && tag == 1) { return emit(r, ir.op_opt_none()); }
        if (ins.args.len() == 0) { r = emit(r, ir.op_const_i32(0)); return emit(r, ir.op_opt_make(tag)); }
        var pay: typeinfo.Type = f.values[ins.args[0]];
        if (wide_payload(pay)) { return emit(r, ir.op_opt_make_w(tag, 64, !ssasem.is_float(pay))); }
        return emit(r, ir.op_opt_make(tag));
    }
    if (ins.kind_tag == ssasem.variant_is()) {
        r = emit(r, ir.op_opt_tag());
        r = emit(r, ir.op_const_i32(tag));
        return emit(r, ir.op_bin("eq", 0, false));
    }
    var got: typeinfo.Type = f.values[ins.result];
    if (wide_payload(got)) { return emit(r, ir.op_opt_payload_w(64, !ssasem.is_float(got))); }
    return emit(r, ir.op_opt_payload());
}

// Zero at a given width: a 64-bit literal reaches the backends as source text,
// which they splice into a 64-bit immediate, and nothing narrower needs one. A
// float slot takes a float zero — the negation caller guards floats out, so it
// is the zero VALUE that needs this arm.
function zero(t: typeinfo.Type): ir.Op {
    if (ssasem.is_float(t)) { return ir.op_const_f64_text("0"); }
    if (ssasem.is_wide(t)) { return ir.op_const_i64_text("0"); }
    return ir.op_const_i32(0);
}

// A constant the verifier gave literal text to reaches the backends as that
// text, spliced into an immediate of its own width (ssasem.text_constant);
// every other integer constant is carried in the instruction's i32 immediate.
function constant(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    if (ins.kind_tag == 1 && ssasem.is_wide(f.values[ins.result])) { return emit(r, ir.op_const_i64_text(ins.str)); }
    if (ins.kind_tag == 1 && ssasem.is_u32(f.values[ins.result])) { return emit(r, ir.op_const_i32_text(ins.str)); }
    if (ins.kind_tag == 1 && ssasem.is_f64(f.values[ins.result])) { return emit(r, ir.op_const_f64_text(ins.str)); }
    if (ins.kind_tag == 1 && ssasem.is_f32(f.values[ins.result])) { r = emit(r, ir.op_const_f64_text(ins.str)); return round_f32(r); }
    if (ins.kind_tag == 5) { return emit(r, ir.op_const_str(ins.str)); }
    if (ins.kind_tag == ssasem.zero()) {
        var t: typeinfo.Type = f.values[ins.result];
        r = emit(r, zero(t));
        if (ssasem.is_f32(t)) { return round_f32(r); }
        return r;
    }
    return emit(r, ir.op_const_i32(ins.imm));
}

// Integer negation is a zero-minus, so the zero is pushed under the operand at
// the operand's own width or the two sides of the subtraction disagree; a
// float has its own sign-flip opcode and pushes nothing.
function negation_zero(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    if (ins.kind_tag == 10 && ins.str == "-" && !ssasem.is_float(f.values[ins.args[0]])) { return emit(r, zero(f.values[ins.args[0]])); }
    return r;
}

function constant_op(k: i32): boolean { return k == 1 || k == 2 || k == 5 || k == ssasem.zero(); }

function instruction(own r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst, structs: irlower.StructTab, defer0: boolean): irlower.LowerResult {
    r = negation_zero(r, f, ins);
    if (ins.kind_tag == ssasem.with()) { r = with_update(r, f, p, ins, defer0); return emit(r, ir.op_store_local(ins.result)); }
    if (ssasem.is_cell_op(ins.kind_tag)) { return cell_site(r, f, ins); }
    if (ssasem.is_map_iter_op(ins.kind_tag)) { return map_iter_site(r, f, ins); }
    if (ssasem.is_function_op(ins.kind_tag)) { r = function_site(r, f, ins); return emit(r, ir.op_store_local(ins.result)); }
    if (ins.kind_tag == ssasem.map_insert() || ins.kind_tag == ssasem.map_delete()) { r = map_mutation(r, f, ins); return emit(r, ir.op_store_local(ins.result)); }
    if (ins.kind_tag == ssasem.arr_join()) { r = join_call(r, ins); return emit(r, ir.op_store_local(ins.result)); }
    if (ins.kind_tag == ssasem.append()) { r = append_push(r, f, p, ins, defer0); return emit(r, ir.op_store_local(ins.result)); }
    if (ins.kind_tag == 9 && (ssasem.saturating(ins.str) || ssasem.checked_arith(ins.str))) { r = overflow_binary(r, f, ins); return emit(r, ir.op_store_local(ins.result)); }
    if (dyn_call(ins)) { r = dyn_site(r, ins); return emit(r, ir.op_store_local(ins.result)); }
    for arg in ins.args { r = emit(r, ir.op_load_local(arg)); }
    if (constant_op(ins.kind_tag)) { r = constant(r, f, ins); }
    if (ssasem.scalar_op(ins.kind_tag)) { r = scalar(r, f, ins); }
    if (container_op(ins.kind_tag)) { r = container(r, f, ins, structs); }
    // A call's counted parameters were supplied before its operands were
    // loaded; its result is the unit the callee returns. A runtime builtin
    // is its own op, pushing the value its contract names or the dummy a
    // statement op pushes, so the store below takes either.
    if (ins.kind_tag == ssasem.call()) { r = call_site(r, ins); }
    // A verified copy already has its single operand on the stack.
    r = emit(r, ir.op_store_local(ins.result));
    r = took(r, p, ins);
    r = took_payload(r, f, p, ins);
    return held(r, p, ins);
}

// An element read the plan HOLDS retains what it read: the unit is the frame's
// own from here (ssaunits.held_elements).
function held(own r: irlower.LowerResult, p: ssaunits.Plan, ins: ssa.SInst): irlower.LowerResult {
    if (ins.result >= p.held.len() || !p.held[ins.result]) { return r; }
    return helper(r, ins.result, "__fern_rc_inc");
}

// A tuple read the plan admitted as a TAKE nulls the slot it read. The source
// dies at this instruction, so its drop runs in this same step, after this —
// and the release helpers are null-guarded, so the walk goes past the slot the
// frame now owns rather than freeing it twice (ssaunits.tuple_take_field).
// __fern_arr_str_join reads the array as parameter 0, and a direct call takes
// its last parameter from the top of the stack, so the separator is pushed
// first. The instruction spells the receiver first, as every other operation
// here does, which is why this loads the two in reverse rather than leaving
// them to the generic push.
function join_call(own r: irlower.LowerResult, ins: ssa.SInst): irlower.LowerResult {
    r = emit(r, ir.op_load_local(ins.args[1]));
    r = emit(r, ir.op_load_local(ins.args[0]));
    return emit(r, ir.op_call_direct("__fern_arr_str_join", 2));
}

function took(own r: irlower.LowerResult, p: ssaunits.Plan, ins: ssa.SInst): irlower.LowerResult {
    if (ins.result >= p.takes.len() || p.takes[ins.result] < 0) { return r; }
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_const_i32(0));
    return emit(r, ir.op_tuple_set(p.takes[ins.result]));
}

// A variant read the plan admitted as a payload TAKE moves the payload out of
// the box when nobody else holds the box, and retains it as a borrow did when
// somebody does: `steal`'s shape at the READ rather than at a call's supply,
// so every consuming use downstream sees a unit of the frame's own. The box
// dies at this read, so its own drop runs in this same step — walking past
// the slot the take emptied, then releasing the box itself
// (ssaunits.payload_root).
function took_payload(own r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): irlower.LowerResult {
    if (ins.result >= p.payloads.len() || !p.payloads[ins.result]) { return r; }
    if (ssaunits.shell_root(f, p, ins) >= 0) { return r; }
    return steal(r, f, ins.result, scratch_base(f));
}

// The received unit's box when it is the only one and a fresh sole-owned copy
// otherwise, left in `scratch`. The unit is one the frame has already taken —
// moved in, or retained up front — so the unique arm keeps it and the shared
// arm releases it, the copy having replaced it. The copy duplicated every
// element pointer, so a counted element type retains them all. Either way
// exactly one unit goes in and `scratch` holds one nobody else shares.
//
// A receiver whose retain was DEFERRED never arrives here: `append_push` sends
// it to `append_borrowed` or `append_field` instead, and `with_update` sends
// one whose field the plan admitted to `with_field`.
function sole_owned_base(own r: irlower.LowerResult, f: ssasem.Func, base: i32, scratch: i32): irlower.LowerResult {
    var elem: typeinfo.Type = elem_type(f.values[base]);
    r = emit(r, ir.op_load_local(base));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_if(0));
    r = emit(r, ir.op_load_local(base));
    r = emit(r, ir.op_store_local(scratch));
    r = emit(r, ir.op_else());
    r = release(r, base, f.values[base]);
    r = emit(r, ir.op_load_local(base));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_load_local(base));
    r = emit(r, ir.op_arr_len());
    r = emit(r, ir.op_arr_slice(elem_width(elem)));
    if (ssasem.reference(elem)) { r = emit(r, ir.op_call_direct("__fern_arr_inc_elems", 1)); }
    r = emit(r, ir.op_store_local(scratch));
    return emit(r, ir.op_end());
}

// One element pushed onto the sole-owned box above, so the push grows a buffer
// no one else can read and the reclaim-on-grow form may reuse it. The runtime's
// push consumes the receiver's unit only when it is the box's only one — it
// leaves a shared receiver's count alone and hands back an un-share copy — so
// the release that makes the operation take exactly one unit at every count
// belongs here rather than in the shared helper the AST lowering also calls.
function append_push(own r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst, defer0: boolean): irlower.LowerResult {
    if (defer0 && p.grows[ins.result] >= 0) { return append_field(r, f, p, ins); }
    if (defer0) { return append_borrowed(r, f, ins); }
    var elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
    var res: i32 = scratch_base(f);
    r = reserve(r, res + 1);
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_if(0));
    // The box's only unit is the one this frame holds, so the consuming push
    // grows it in place and reclaims it on a realloc.
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_load_local(ins.args[1]));
    r = emit(r, arr_push_op(elem));
    r = emit(r, ir.op_store_local(res));
    r = emit(r, ir.op_else());
    // Shared: the NON-consuming push un-shares, which is the same copy
    // `sole_owned_base` would make here and a memcpy rather than a per-element
    // loop through `__fern_arr_slice` (#9526). It frees nothing, so this
    // frame's unit on the receiver is released after, and the counted elements
    // the fresh box now aliases are retained over the receiver exactly as
    // `append_borrowed` retains them.
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_load_local(ins.args[1]));
    r = emit(r, arr_push_borrowed_op(elem));
    r = emit(r, ir.op_store_local(res));
    if (ssasem.reference(elem)) { r = helper(r, ins.args[0], "__fern_arr_inc_elems"); }
    r = release(r, ins.args[0], f.values[ins.args[0]]);
    r = emit(r, ir.op_end());
    return emit(r, ir.op_load_local(res));
}

// The push onto a receiver the frame holds no unit of. The non-consuming push
// decides for itself: it grows the buffer in place when it is the box's only
// reader — which `bracketed` makes true only when the caller keeps no
// binding — and un-shares otherwise, never freeing what it was handed. So
// the unit this operation owes is a retain of the result exactly when the
// result IS the receiver's box.
//
// The other case is where this gets its second half. `__fern_arr_push` FREES
// NOTHING on any path: it allocates a fresh box, memcpy's the element pointers
// into it WITHOUT retaining them, and abandons the old buffer. The two then
// share one count per element, which the AST lowering settles by never
// releasing the old buffer — the LOAD-BEARING LEAK comment in asm_ir.fern, and
// why the AST build leaks 524 KB on #9365's reproducer. This frame's caller
// does release it, because the plan balances every unit, so the aliased
// elements have to be counted for: `__fern_arr_inc_elems` over the RECEIVER
// names exactly the boxes the fresh one aliases, since the receiver is
// untouched and the element just pushed is not among them. O(n) per grow, so
// amortised O(1) against the doubling, and the same shape `sole_owned_base`
// already uses on its copy arm.
function append_borrowed(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    var elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
    var scratch: i32 = scratch_base(f);
    r = reserve(r, scratch + 1);
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_load_local(ins.args[1]));
    r = emit(r, arr_push_borrowed_op(elem));
    r = emit(r, ir.op_store_local(scratch));
    r = emit(r, ir.op_load_local(scratch));
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_bin("eq", 0, false));
    r = emit(r, ir.op_if(0));
    r = helper(r, scratch, "__fern_rc_inc");
    if (ssasem.reference(elem)) {
        r = emit(r, ir.op_else());
        r = helper(r, ins.args[0], "__fern_arr_inc_elems");
    }
    r = emit(r, ir.op_end());
    return emit(r, ir.op_load_local(scratch));
}

// The push onto a FIELD buffer of a record this frame reads no further
// through that field (ssaunits.field_grow_root): the semantic form of
// irlower.lower_field_append_inplace. The record's own count says whether
// another holder can still reach the buffer. A shared record holds a second
// count on the field across the push, so the push copies and the field stays
// in place; a sole-owned record lets it grow in place, and the identity arm
// then MOVES the buffer out of the field — nulled, so the record's release
// finds nothing there — the result being its only remaining name. A grow
// that reallocated, or a copy, leaves the old buffer in the field for the
// record's release, its elements now aliased by the result and counted for
// exactly as `append_borrowed` counts them.
function append_field(own r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): irlower.LowerResult {
    var elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
    var root: i32 = p.grows[ins.result];
    var unique: i32 = scratch_base(f);
    var res: i32 = unique + 1;
    r = reserve(r, res + 1);
    r = emit(r, ir.op_load_local(root));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_store_local(unique));
    r = unless_unique(r, unique, ins.args[0], "__fern_arr_share_inc");
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_load_local(ins.args[1]));
    r = emit(r, arr_push_borrowed_op(elem));
    r = emit(r, ir.op_store_local(res));
    r = unless_unique(r, unique, ins.args[0], "__fern_arr_share_dec");
    r = emit(r, ir.op_load_local(res));
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_bin("eq", 0, false));
    r = emit(r, ir.op_if(0));
    r = emit(r, ir.op_load_local(root));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_struct_set(p.grow_fields[ins.result], 0));
    if (ssasem.reference(elem)) {
        r = emit(r, ir.op_else());
        r = helper(r, ins.args[0], "__fern_arr_inc_elems");
    }
    r = emit(r, ir.op_end());
    return emit(r, ir.op_load_local(res));
}

// `if (!unique) { fn(value) }`: one half of the share bracket a shared record
// holds on its field across the push.
function unless_unique(own r: irlower.LowerResult, unique: i32, value: i32, fn: string): irlower.LowerResult {
    r = emit(r, ir.op_load_local(unique));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_bin("eq", 0, false));
    r = emit(r, ir.op_if(0));
    r = helper(r, value, fn);
    return emit(r, ir.op_end());
}

// The element the store replaces gives back the one count it held.
function drop_replaced(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst, scratch: i32, elem: typeinfo.Type): irlower.LowerResult {
    var old: i32 = scratch + 1;
    r = reserve(r, old + 1);
    r = emit(r, ir.op_load_local(scratch));
    r = emit(r, ir.op_load_local(ins.args[1]));
    r = emit(r, arr_get_op(elem, false));
    r = emit(r, ir.op_store_local(old));
    return drop_value(r, old, elem, old + 1, f);
}

// One element replaced in the sole-owned box above: in place when the received
// unit was the box's only one and in a fresh copy otherwise, the AST lowering's
// two forms chosen here by the count at run time rather than by the receiver's
// syntax.
function with_update(own r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst, defer0: boolean): irlower.LowerResult {
    if (defer0 && p.grows[ins.result] >= 0) { return with_field(r, f, p, ins); }
    var elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
    var scratch: i32 = scratch_base(f);
    r = reserve(r, scratch + 1);
    r = sole_owned_base(r, f, ins.args[0], scratch);
    if (ssasem.reference(elem)) { r = drop_replaced(r, f, ins, scratch, elem); }
    r = emit(r, ir.op_load_local(scratch));
    r = emit(r, ir.op_load_local(ins.args[1]));
    r = emit(r, ir.op_load_local(ins.args[2]));
    r = emit(r, arr_set_op(elem));
    return emit(r, ir.op_load_local(scratch));
}

// One element replaced in a record FIELD the plan admitted (grows): written
// in place when the record and its buffer are each sole-held, with the field
// nulled so the record's release skips the buffer the result now owns, and
// in a fresh copy otherwise, which leaves the record whole for its other
// holders. The receiver's retain was held back (deferred_retain), so the two
// count tests read the boxes rather than this frame's supply, as the field
// append's do.
function with_field(own r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, ins: ssa.SInst): irlower.LowerResult {
    var elem: typeinfo.Type = elem_type(f.values[ins.args[0]]);
    var root: i32 = p.grows[ins.result];
    var unique: i32 = scratch_base(f);
    var res: i32 = unique + 1;
    r = reserve(r, res + 1);
    r = emit(r, ir.op_load_local(root));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_if(0));
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_store_local(unique));
    r = emit(r, ir.op_else());
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_store_local(unique));
    r = emit(r, ir.op_end());
    r = emit(r, ir.op_load_local(unique));
    r = emit(r, ir.op_if(0));
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_store_local(res));
    r = emit(r, ir.op_load_local(root));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_struct_set(p.grow_fields[ins.result], 0));
    r = emit(r, ir.op_else());
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_arr_len());
    r = emit(r, ir.op_arr_slice(elem_width(elem)));
    if (ssasem.reference(elem)) { r = emit(r, ir.op_call_direct("__fern_arr_inc_elems", 1)); }
    r = emit(r, ir.op_store_local(res));
    r = emit(r, ir.op_end());
    if (ssasem.reference(elem)) { r = drop_replaced(r, f, ins, res, elem); }
    r = emit(r, ir.op_load_local(res));
    r = emit(r, ir.op_load_local(ins.args[1]));
    r = emit(r, ir.op_load_local(ins.args[2]));
    r = emit(r, arr_set_op(elem));
    return emit(r, ir.op_load_local(res));
}

// The cursor cluster. `map_iter` is the only allocation of the five: a bare
// block holding the map's address and an index, which is why nothing here
// retains or releases. `key` and `value` load the map's own column element at
// the cursor, so the value is the map's and stays borrowed. `advance` moves
// the index in place and leaves the dummy the statement stores.
//
// Both width flags are 0 here, and neither is a narrowing choice: an admitted
// map's value column is never 8 bytes. `ssasem.narrow_map_value` takes an
// integer only when it is NOT wide, and `counted_map_value`'s three shapes
// (a string, a string array, a box) are none of them wide either, so the
// i64 widekind `op_map_iter` spells is as unreachable as the float one, and
// `op_mapiter_value`'s wide flag with it. The wasm accessors are the only
// readers of either.
function map_iter_site(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    r = emit(r, ir.op_load_local(ins.args[0]));
    if (ins.kind_tag == ssasem.map_iter()) {
        r = emit(r, ir.op_map_iter(0));
    } else if (ins.kind_tag == ssasem.mapiter_has_next()) {
        r = emit(r, ir.op_mapiter_has_next());
    } else if (ins.kind_tag == ssasem.mapiter_key()) {
        r = emit(r, ir.op_mapiter_key());
    } else if (ins.kind_tag == ssasem.mapiter_value()) {
        r = emit(r, ir.op_mapiter_value(false));
    } else {
        r = emit(r, ir.op_mapiter_advance());
    }
    return emit(r, ir.op_store_local(ins.result));
}

// A cell is a one-element array box shared by every holder, built over the
// one element it takes.
function cell_site(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    if (ins.kind_tag == ssasem.cell_get()) { return cell_read(r, f, ins); }
    if (ins.kind_tag == ssasem.cell_set()) { return cell_write(r, f, ins); }
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, arr_make_op(semtypes.cell_elem(f.values[ins.result]), 1));
    return emit(r, ir.op_store_local(ins.result));
}

// A read hands out a unit of the element: the slot is loaded and, for a
// reference, retained, since a later write may release what the slot held
// while the value read is still in hand.
function cell_read(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    var elem: typeinfo.Type = f.values[ins.result];
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, arr_get_op(elem, true));
    r = emit(r, ir.op_store_local(ins.result));
    if (ssasem.reference(elem)) { r = helper(r, ins.result, "__fern_rc_inc"); }
    return r;
}

// A write releases what the slot held, stores the unit it was supplied and
// leaves the dummy a statement op leaves for the store of its void result.
function cell_write(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    var elem: typeinfo.Type = f.values[ins.args[1]];
    if (ssasem.reference(elem)) {
        var old: i32 = scratch_base(f);
        r = reserve(r, old + 1);
        r = emit(r, ir.op_load_local(ins.args[0]));
        r = emit(r, ir.op_const_i32(0));
        r = emit(r, arr_get_op(elem, true));
        r = emit(r, ir.op_store_local(old));
        r = drop_value(r, old, elem, old + 1, f);
    }
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_load_local(ins.args[1]));
    r = emit(r, arr_set_op(elem));
    r = emit(r, ir.op_const_i32(0));
    return emit(r, ir.op_store_local(ins.result));
}

// A closure value and the call through one. The value is the env box the
// lambda lift builds: the body's address in slot 0, then the captures, which
// is the layout `irlower.lower_call_named` gives the same `__mkclo$` marker.
// The call is environment-first — the box, the written arguments, then the
// address out of slot 0, which is the order call_indirect pops them in — so a
// body reaches its captures through the parameter it was hoisted with. The
// call carries the signature tag the value's type spells, so wasm dispatches
// a wide or float slot through the funcref type the body was declared with.
function function_site(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    if (ins.kind_tag == ssasem.closure_new()) {
        // Capturing nothing, every word of the box is known at compile time, so
        // it is one static block rather than a fresh box per evaluation (#9839).
        if (ins.args.len() == 0) { return emit(r, ir.op_const_closure(ins.str)); }
        r = emit(r, ir.op_const_func(0, ins.str));
        for capture in ins.args { r = emit(r, ir.op_load_local(capture)); }
        return emit(r, ir.op_arr_make(ins.args.len() + 1, 32));
    }
    for operand in ins.args { r = emit(r, ir.op_load_local(operand)); }
    r = emit(r, ir.op_load_local(ins.args[0]));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_arr_get(32));
    return emit(r, ir.op_call_indirect_sig(ins.args.len(), signature_tag(f.values[ins.args[0]])));
}

// The funcref signature tag a call through a value dispatches by: one width
// char per slot, the environment word first, then `_` and the result — the
// spelling irlower's call sites carry, so both name one funcref type on wasm.
// An all-narrow signature carries no tag, as those sites carry none.
function signature_tag(sig: typeinfo.Type): string {
    var tag: string = "w";
    for p in ssasem.func_params(sig) { tag = tag + width_char(p); }
    tag = tag + "_" + width_char(ssasem.func_result(sig));
    var i: i32 = 0;
    while (i < tag.len()) {
        if (tag[i] != b'w' && tag[i] != b'_') { return tag; }
        i = i + 1;
    }
    return "";
}

function width_char(t: typeinfo.Type): string {
    if (ssasem.is_wide(t)) { return "l"; }
    if (ssasem.is_float(t)) { return "d"; }
    return "w";
}

// A consuming map mutation — an insert or a `without` — runs on a box this
// frame is the only holder of. A map's unit is counted, so the receiver's box
// may be shared with another binding or frame, and a mutation in place would
// show through every holder; when it is shared, the frame takes a fresh box
// with the same entries first, the copy-on-write native's runtime makes.
// The copy is `map_new` and one insert per entry over plain snapshots of the
// two columns, supplying each entry's units as the typed insert takes them —
// a string key's and a counted value's — since the register runtimes retain
// nothing on an insert. The snapshots hold no units and are released
// shallow; the shared box loses this frame's unit, which cannot be its last.
function map_mutation(own r: irlower.LowerResult, f: ssasem.Func, ins: ssa.SInst): irlower.LowerResult {
    var box: i32 = scratch_base(f);
    r = reserve(r, box + 1);
    r = unshared_map(r, f, ins.args[0], box);
    r = emit(r, ir.op_load_local(box));
    var i: i32 = 1;
    while (i < ins.args.len()) {
        r = emit(r, ir.op_load_local(ins.args[i]));
        i = i + 1;
    }
    return map_op(r, ins, f);
}

function unshared_map(own r: irlower.LowerResult, f: ssasem.Func, slot: i32, box: i32): irlower.LowerResult {
    var t: typeinfo.Type = f.values[slot];
    var kkind: i32 = map_key_kind(t);
    var vkind: i32 = map_value_kind(t);
    var keys: i32 = box + 1;
    var vals: i32 = box + 2;
    var index: i32 = box + 3;
    var key: i32 = box + 4;
    var value: i32 = box + 5;
    r = reserve(r, value + 1);
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_call_direct("__fern_rc_is_unique", 1));
    r = emit(r, ir.op_if(0));
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_store_local(box));
    r = emit(r, ir.op_else());
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_map_len());
    r = emit(r, ir.op_map_new(kkind, map_key_fns(t)));
    r = emit(r, ir.op_store_local(box));
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_map_keys(0));
    r = emit(r, ir.op_store_local(keys));
    r = emit(r, ir.op_load_local(slot));
    r = emit(r, ir.op_map_values(0, 0));
    r = emit(r, ir.op_store_local(vals));
    r = emit(r, ir.op_const_i32(0));
    r = emit(r, ir.op_store_local(index));
    r = emit(r, ir.op_block(0));
    r = emit(r, ir.op_loop(0));
    r = emit(r, ir.op_load_local(index));
    r = emit(r, ir.op_load_local(keys));
    r = emit(r, ir.op_arr_len());
    r = emit(r, ir.op_bin("ge_s", 0, false));
    r = emit(r, ir.op_brif(1));
    r = emit(r, ir.op_load_local(keys));
    r = emit(r, ir.op_load_local(index));
    r = emit(r, ir.op_arr_get_nc(32));
    r = emit(r, ir.op_store_local(key));
    r = emit(r, ir.op_load_local(vals));
    r = emit(r, ir.op_load_local(index));
    r = emit(r, ir.op_arr_get_nc(32));
    r = emit(r, ir.op_store_local(value));
    if (kkind != 1) { r = helper(r, key, "__fern_rc_inc"); }
    if (vkind != 0) { r = helper(r, value, "__fern_rc_inc"); }
    r = emit(r, ir.op_load_local(box));
    r = emit(r, ir.op_load_local(key));
    r = emit(r, ir.op_load_local(value));
    // map_op reads the receiver's type off args[0] and nothing else of the
    // instruction, so the result slot is a placeholder.
    r = map_op(r, ssa.SInst { kind_tag: ssasem.map_insert(), result: 0 - 1, args: [slot, key, value], imm: 0, str: "" }, f);
    r = emit(r, ir.op_store_local(box));
    r = emit(r, ir.op_load_local(index));
    r = emit(r, ir.op_const_i32(1));
    r = emit(r, ir.op_bin("add", 0, false));
    r = emit(r, ir.op_store_local(index));
    r = emit(r, ir.op_br(0));
    r = emit(r, ir.op_end());
    r = emit(r, ir.op_end());
    r = helper(r, keys, "__fern_rc_dec");
    r = helper(r, vals, "__fern_rc_dec");
    r = helper(r, slot, "__fern_rc_dec");
    return emit(r, ir.op_end());
}

// A dyn method call dispatches on the receiver's shape, and every arm reloads
// the operands, so the dispatch reads them from a run of consecutive slots
// rather than the stack. semsource defines the operands as a run of copies,
// which makes their value ids, and so their slots, that run. Every operand is
// lent, so there is nothing to supply and nothing taken.
function dyn_call(ins: ssa.SInst): boolean { return ins.kind_tag == ssasem.call() && ssasem.is_dyn_call(ins.str); }

function consecutive(args: i32[]): boolean {
    var i: i32 = 1;
    while (i < args.len()) {
        if (args[i] != args[0] + i) { return false; }
        i = i + 1;
    }
    return args.len() > 0;
}

function dyn_site(own r: irlower.LowerResult, ins: ssa.SInst): irlower.LowerResult {
    return emit(r, ir.op_dyn_dispatch(ssasem.dyn_call_method(ins.str), ssasem.dyn_call_traits(ins.str), ins.args[0], ins.args.len()));
}

function call_site(own r: irlower.LowerResult, ins: ssa.SInst): irlower.LowerResult {
    if (ins.str == "print") {
        // The payload, then the newline, as the AST lowering writes it.
        r = emit(r, ir.op_print_str());
        r = emit(r, ir.op_drop());
        r = emit(r, ir.op_const_str("\n"));
        return emit(r, ir.op_print_str());
    }
    if (ins.str == "eprint") { return emit(r, ir.op_eprint_str()); }
    if (ins.str == "strbuf_append") { return emit(r, ir.op_strbuf_append()); }
    if (ins.str == "strbuf_reset") { return emit(r, ir.op_strbuf_reset()); }
    if (ins.str == "strbuf_take") { return emit(r, ir.op_strbuf_take()); }
    if (ins.str == "__memchr") { return emit(r, ir.op_memchr()); }
    if (ins.str == "write") { return emit(r, ir.op_print_str()); }
    if (ins.str == "exit") { return emit(r, ir.op_exit()); }
    if (ins.str == "string_from_bytes_unchecked") { return emit(r, ir.op_str_from_bytes()); }
    if (ins.str == "f64_bits") { return emit(r, ir.op_f64_bits()); }
    if (ins.str == "f64_from_bits") { return emit(r, ir.op_f64_from_bits()); }
    return builtin_site(r, ins);
}

// One half of the builtin dispatch below: the result with that builtin's op
// emitted, or the result untouched when the name is not one of this half's.
struct Lowered { found: boolean, r: irlower.LowerResult }

// The builtins whose result is an instantiated builtin union: each is the
// stack IR op the AST lowering emits for the same call. `read_line` reads a FD
// operand and the bare builtin names none, so its lowering pushes the zero the
// AST path pushes.
// The stream handles: a handle IS its descriptor, so the three standard ones
// are constants and every method is the free op with the receiver as its
// first operand — which is how the AST lowering emits them too
// (irlower.lower_call_method). Writer.close shares Reader.close's op.
function handle_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "stdin") { return Lowered { found: true, r: emit(r, ir.op_const_i32(0)) }; }
    if (ins.str == "stdout") { return Lowered { found: true, r: emit(r, ir.op_const_i32(1)) }; }
    if (ins.str == "stderr") { return Lowered { found: true, r: emit(r, ir.op_const_i32(2)) }; }
    if (ins.str == "open_reader") { return Lowered { found: true, r: emit(r, ir.op_open_file(0)) }; }
    if (ins.str == "open_writer") { return Lowered { found: true, r: emit(r, ir.op_open_file(577)) }; }
    if (ins.str == "open_appender") { return Lowered { found: true, r: emit(r, ir.op_open_file(1089)) }; }
    if (ins.str == "open_exclusive") { return Lowered { found: true, r: emit(r, ir.op_open_file(193)) }; }
    if (ins.str == "open_reader_with") { return Lowered { found: true, r: emit(r, ir.op_open_reader_with()) }; }
    if (ins.str == "open_writer_with") { return Lowered { found: true, r: emit(r, ir.op_open_writer_with()) }; }
    if (ins.str == "Reader.read_line") { return Lowered { found: true, r: emit(r, ir.op_read_line()) }; }
    if (ins.str == "Reader.read_chunk") { return Lowered { found: true, r: emit(r, ir.op_read_chunk()) }; }
    if (ins.str == "Reader.close" || ins.str == "Writer.close") { return Lowered { found: true, r: emit(r, ir.op_reader_close()) }; }
    if (ins.str == "Writer.write") { return Lowered { found: true, r: emit(r, ir.op_writer_write()) }; }
    if (ins.str == "Writer.write_some") { return Lowered { found: true, r: emit(r, ir.op_write_some()) }; }
    if (ins.str == "Reader.splice_to") { return Lowered { found: true, r: emit(r, ir.op_reader_splice()) }; }
    if (ins.str == "Writer.truncate") { return Lowered { found: true, r: emit(r, ir.op_writer_truncate()) }; }
    return handle_metadata_site(r, ins);
}

// The handle metadata ops, each asked of the bare descriptor like close and
// shared by the two handle types.
function handle_metadata_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    var op: string = handle_method(ins.str);
    if (op == "stat") { return Lowered { found: true, r: emit(r, ir.op_fd_stat()) }; }
    if (op == "flags") { return Lowered { found: true, r: emit(r, ir.op_fd_flags()) }; }
    if (op == "seek") { return Lowered { found: true, r: emit(r, ir.op_reader_seek()) }; }
    if (op == "fsync") { return Lowered { found: true, r: emit(r, ir.op_fd_fsync()) }; }
    if (op == "fdatasync") { return Lowered { found: true, r: emit(r, ir.op_fd_fdatasync()) }; }
    if (op == "syncfs") { return Lowered { found: true, r: emit(r, ir.op_fd_syncfs()) }; }
    // A handle is its descriptor, so these are the free ops with the receiver
    // as the first operand, as the AST lowering emits them.
    if (op == "isatty") { return Lowered { found: true, r: emit(r, ir.op_isatty()) }; }
    if (op == "dup_onto") { return Lowered { found: true, r: emit(r, ir.op_fd_dup_onto()) }; }
    if (op == "window_size") { return Lowered { found: true, r: emit(r, ir.op_window_size()) }; }
    if (op == "set_window_size") { return Lowered { found: true, r: emit(r, ir.op_set_window_size()) }; }
    if (op == "termios_get") { return Lowered { found: true, r: emit(r, ir.op_termios_get()) }; }
    if (op == "termios_set") { return Lowered { found: true, r: emit(r, ir.op_termios_set()) }; }
    return Lowered { found: false, r: r };
}

// handle_method is the method half of a `Reader.` or `Writer.` metadata
// contract name, "" for any other name.
function handle_method(name: string): string {
    var methods: string[] = ["stat", "flags", "seek", "fsync", "fdatasync", "syncfs", "isatty", "dup_onto", "window_size",
        "set_window_size", "termios_get", "termios_set"];
    for m in methods { if (name == "Reader." + m || name == "Writer." + m) { return m; } }
    return "";
}

function union_builtin_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "env") { return Lowered { found: true, r: emit(r, ir.op_env()) }; }
    if (ins.str == "read_file") { return Lowered { found: true, r: emit(r, ir.op_read_file()) }; }
    if (ins.str == "read_file_bytes") { return Lowered { found: true, r: emit(r, ir.op_read_file_bytes()) }; }
    if (ins.str == "read_dir") { return Lowered { found: true, r: emit(r, ir.op_read_dir()) }; }
    if (ins.str == "read_dir_all") { return Lowered { found: true, r: emit(r, ir.op_read_dir_all()) }; }
    if (ins.str == "stat") { return Lowered { found: true, r: emit(r, ir.op_stat()) }; }
    if (ins.str == "lstat") { return Lowered { found: true, r: emit(r, ir.op_lstat()) }; }
    if (ins.str == "read_line") { r = emit(r, ir.op_const_i32(0)); return Lowered { found: true, r: emit(r, ir.op_read_line()) }; }
    return outcome_builtin_site(r, ins);
}

// The builtins whose result is the outcome of a write: `Result[void, IoError]`.
function outcome_builtin_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "write_file") { return Lowered { found: true, r: emit(r, ir.op_write_file()) }; }
    if (ins.str == "write_file_exec") { return Lowered { found: true, r: emit(r, ir.op_write_file_exec()) }; }
    if (ins.str == "create_dir_all") { return Lowered { found: true, r: emit(r, ir.op_create_dir_all()) }; }
    if (ins.str == "remove_dir_all") { return Lowered { found: true, r: emit(r, ir.op_remove_dir_all()) }; }
    if (ins.str == "remove_file") { return Lowered { found: true, r: emit(r, ir.op_remove_file()) }; }
    return Lowered { found: false, r: r };
}

// The builtins whose result owns nothing. The over-release counter and the two
// shared-append totals read a runtime word; the first of them is a runtime
// call rather than an op.
function value_builtin_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "args") { return Lowered { found: true, r: emit(r, ir.op_args()) }; }
    if (ins.str == "putchar") { return Lowered { found: true, r: emit(r, ir.op_putchar()) }; }
    if (ins.str == "f32_bits") { return Lowered { found: true, r: emit(r, ir.op_f32_bits()) }; }
    if (ins.str == "f32_from_bits") { return Lowered { found: true, r: emit(r, ir.op_f32_from_bits()) }; }
    if (ins.str == "__rc_underflow_count") { return Lowered { found: true, r: emit(r, ir.op_call_direct("__fern_rc_underflow_get", 0)) }; }
    if (ins.str == "__arr_push_shared_count") { return Lowered { found: true, r: emit(r, ir.op_arr_push_shared_count()) }; }
    if (ins.str == "__arr_push_shared_bytes") { return Lowered { found: true, r: emit(r, ir.op_arr_push_shared_bytes()) }; }
    return host_builtin_site(r, ins);
}

// The host itself: three clocks, the kernel's randomness, and the two sleeps.
// Each is an op of its own rather than a call, the way the AST lowering emits
// it — a contract alone would reach the backends as a call to a symbol no
// runtime defines.
function host_builtin_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "random_bytes") { return Lowered { found: true, r: emit(r, ir.op_random_bytes()) }; }
    if (ins.str == "random_i32") { return Lowered { found: true, r: emit(r, ir.op_random_i32()) }; }
    if (ins.str == "monotonic_ns") { return Lowered { found: true, r: emit(r, ir.op_monotonic_ns()) }; }
    if (ins.str == "now_unix_ms") { return Lowered { found: true, r: emit(r, ir.op_now_unix_ms()) }; }
    if (ins.str == "now_ns") { return Lowered { found: true, r: emit(r, ir.op_now_ns()) }; }
    if (ins.str == "sleep_ms") { return Lowered { found: true, r: emit(r, ir.op_sleep_ms()) }; }
    if (ins.str == "sleep_ns") { return Lowered { found: true, r: emit(r, ir.op_sleep_ns()) }; }
    return os_query_site(r, ins);
}

// The process and host queries: each is the op the AST lowering emits, with
// no operand but the ones the call names.
function os_query_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "getcwd") { return Lowered { found: true, r: emit(r, ir.op_getcwd()) }; }
    if (ins.str == "hostname") { return Lowered { found: true, r: emit(r, ir.op_hostname()) }; }
    if (ins.str == "cpu_count") { return Lowered { found: true, r: emit(r, ir.op_cpu_count()) }; }
    if (ins.str == "geteuid") { return Lowered { found: true, r: emit(r, ir.op_geteuid()) }; }
    if (ins.str == "getegid") { return Lowered { found: true, r: emit(r, ir.op_getegid()) }; }
    if (ins.str == "getuid") { return Lowered { found: true, r: emit(r, ir.op_getuid()) }; }
    if (ins.str == "getgid") { return Lowered { found: true, r: emit(r, ir.op_getgid()) }; }
    if (ins.str == "environ") { return Lowered { found: true, r: emit(r, ir.op_environ()) }; }
    if (ins.str == "proc_fork") { return Lowered { found: true, r: emit(r, ir.op_proc_fork()) }; }
    if (ins.str == "isatty") { return Lowered { found: true, r: emit(r, ir.op_isatty()) }; }
    if (ins.str == "uname_field") { return Lowered { found: true, r: emit(r, ir.op_uname_field()) }; }
    if (ins.str == "umask") { return Lowered { found: true, r: emit(r, ir.op_umask()) }; }
    if (ins.str == "proc_waitpid") { return Lowered { found: true, r: emit(r, ir.op_proc_waitpid()) }; }
    if (ins.str == "proc_waitpid_nohang") { return Lowered { found: true, r: emit(r, ir.op_proc_waitpid_nohang()) }; }
    if (ins.str == "tcp_connect") { return Lowered { found: true, r: emit(r, ir.op_tcp_connect()) }; }
    if (ins.str == "tcp_listen") { return Lowered { found: true, r: emit(r, ir.op_tcp_listen()) }; }
    if (ins.str == "tcp_accept") { return Lowered { found: true, r: emit(r, ir.op_tcp_accept()) }; }
    if (ins.str == "tcp_local_port") { return Lowered { found: true, r: emit(r, ir.op_tcp_local_port()) }; }
    if (ins.str == "signal_send") { return Lowered { found: true, r: emit(r, ir.op_signal_send()) }; }
    if (ins.str == "subprocess") { return Lowered { found: true, r: emit(r, ir.op_subprocess()) }; }
    return fs_op_site(r, ins);
}

// The directory, link and permission ops, each the op the AST lowering emits.
function fs_op_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "temp_dir") { return Lowered { found: true, r: emit(r, ir.op_temp_dir()) }; }
    if (ins.str == "read_link") { return Lowered { found: true, r: emit(r, ir.op_read_link()) }; }
    if (ins.str == "remove_dir") { return Lowered { found: true, r: emit(r, ir.op_remove_dir()) }; }
    if (ins.str == "statfs") { return Lowered { found: true, r: emit(r, ir.op_statfs()) }; }
    if (ins.str == "create_dir") { return Lowered { found: true, r: emit(r, ir.op_create_dir()) }; }
    if (ins.str == "chmod") { return Lowered { found: true, r: emit(r, ir.op_chmod()) }; }
    if (ins.str == "access") { return Lowered { found: true, r: emit(r, ir.op_access()) }; }
    if (ins.str == "rename") { return Lowered { found: true, r: emit(r, ir.op_rename()) }; }
    if (ins.str == "create_link") { return Lowered { found: true, r: emit(r, ir.op_create_link()) }; }
    if (ins.str == "create_symlink") { return Lowered { found: true, r: emit(r, ir.op_create_symlink()) }; }
    if (ins.str == "chown_at") { return Lowered { found: true, r: emit(r, ir.op_chown_at()) }; }
    if (ins.str == "truncate") { return Lowered { found: true, r: emit(r, ir.op_truncate()) }; }
    return os_floor_site(r, ins);
}

// The rest of the OS floor (semsource.os_floor_contracts), each the op the
// AST lowering emits; `sync` pushes the dummy every statement op pushes.
function os_floor_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "set_file_times") { return Lowered { found: true, r: emit(r, ir.op_set_file_times()) }; }
    if (ins.str == "mknod") { return Lowered { found: true, r: emit(r, ir.op_mknod()) }; }
    if (ins.str == "chmod_at") { return Lowered { found: true, r: emit(r, ir.op_chmod_at()) }; }
    if (ins.str == "chdir") { return Lowered { found: true, r: emit(r, ir.op_chdir()) }; }
    if (ins.str == "chroot") { return Lowered { found: true, r: emit(r, ir.op_chroot()) }; }
    if (ins.str == "set_process_group") { return Lowered { found: true, r: emit(r, ir.op_set_process_group()) }; }
    if (ins.str == "setgroups") { return Lowered { found: true, r: emit(r, ir.op_setgroups()) }; }
    if (ins.str == "getgroups") { return Lowered { found: true, r: emit(r, ir.op_getgroups()) }; }
    if (ins.str == "priority") { return Lowered { found: true, r: emit(r, ir.op_priority()) }; }
    if (ins.str == "sync") { return Lowered { found: true, r: emit(r, ir.op_sync()) }; }
    if (ins.str == "poll") { return Lowered { found: true, r: emit(r, ir.op_poll()) }; }
    if (ins.str == "timer_fd") { return Lowered { found: true, r: emit(r, ir.op_timer_fd()) }; }
    if (ins.str == "window_size") { return Lowered { found: true, r: emit(r, ir.op_window_size()) }; }
    if (ins.str == "set_window_size") { return Lowered { found: true, r: emit(r, ir.op_set_window_size()) }; }
    if (ins.str == "termios_get") { return Lowered { found: true, r: emit(r, ir.op_termios_get()) }; }
    if (ins.str == "termios_set") { return Lowered { found: true, r: emit(r, ir.op_termios_set()) }; }
    return os_floor_process_site(r, ins);
}

function os_floor_process_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "tcp_send") { return Lowered { found: true, r: emit(r, ir.op_tcp_send()) }; }
    if (ins.str == "tcp_recv") { return Lowered { found: true, r: emit(r, ir.op_tcp_recv()) }; }
    if (ins.str == "tcp_pollable") { return Lowered { found: true, r: emit(r, ir.op_tcp_pollable()) }; }
    if (ins.str == "tcp_close") { return Lowered { found: true, r: emit(r, ir.op_tcp_close()) }; }
    if (ins.str == "setuid") { return Lowered { found: true, r: emit(r, ir.op_setuid()) }; }
    if (ins.str == "setgid") { return Lowered { found: true, r: emit(r, ir.op_setgid()) }; }
    if (ins.str == "set_priority") { return Lowered { found: true, r: emit(r, ir.op_set_priority()) }; }
    if (ins.str == "signal_ignore") { return Lowered { found: true, r: emit(r, ir.op_signal_ignore()) }; }
    if (ins.str == "signal_default") { return Lowered { found: true, r: emit(r, ir.op_signal_default()) }; }
    if (ins.str == "signal_disposition") { return Lowered { found: true, r: emit(r, ir.op_signal_disposition()) }; }
    if (ins.str == "signal_mask") { return Lowered { found: true, r: emit(r, ir.op_signal_mask()) }; }
    if (ins.str == "proc_exec") { return Lowered { found: true, r: emit(r, ir.op_proc_exec()) }; }
    if (ins.str == "proc_exec_as") { return Lowered { found: true, r: emit(r, ir.op_proc_exec_as()) }; }
    if (ins.str == "wasm_timer_pollable") { return Lowered { found: true, r: emit(r, ir.op_wasm_timer_pollable()) }; }
    if (ins.str == "wasm_pollable_drop") { return Lowered { found: true, r: emit(r, ir.op_wasm_pollable_drop()) }; }
    return builder_builtin_site(r, ins);
}

// The string builder's ops: a handle is a value, and the statement ops push
// the dummy a statement op pushes.
function builder_builtin_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "buf_new") { return Lowered { found: true, r: emit(r, ir.op_buf_new()) }; }
    if (ins.str == "buf_push") { return Lowered { found: true, r: emit(r, ir.op_buf_push()) }; }
    if (ins.str == "buf_push_range") { return Lowered { found: true, r: emit(r, ir.op_buf_push_range()) }; }
    if (ins.str == "buf_push_mapped") { return Lowered { found: true, r: emit(r, ir.op_buf_push_mapped()) }; }
    if (ins.str == "buf_push_filtered") { return Lowered { found: true, r: emit(r, ir.op_buf_push_filtered()) }; }
    if (ins.str == "buf_push_expanded") { return Lowered { found: true, r: emit(r, ir.op_buf_push_expanded()) }; }
    if (ins.str == "buf_push_byte") { return Lowered { found: true, r: emit(r, ir.op_buf_push_byte()) }; }
    if (ins.str == "buf_push_u64") { return Lowered { found: true, r: emit(r, ir.op_buf_push_u64()) }; }
    if (ins.str == "buf_len") { return Lowered { found: true, r: emit(r, ir.op_buf_len()) }; }
    if (ins.str == "buf_take") { return Lowered { found: true, r: emit(r, ir.op_buf_take()) }; }
    if (ins.str == "buf_free") { return Lowered { found: true, r: emit(r, ir.op_buf_free()) }; }
    return Lowered { found: false, r: r };
}

// The runtime intrinsics: each is the stack IR op the AST lowering emits for
// the same call, so a contract here is only half the work — without the op the
// name reaches the backends as a direct call to a symbol no runtime defines.
function intrinsic_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    var kind: string = irlower.f64_math_builtin_kind(ins.str);
    if (kind != "") { return Lowered { found: true, r: emit(r, ir.op_funary(kind)) }; }
    if (ins.str == "__pow_f64") { return Lowered { found: true, r: emit(r, ir.op_fbin("fpow")) }; }
    var bits: Lowered = bit_count_site(r, ins);
    if (bits.found) { return bits; }
    r = bits.r;
    var mem: Lowered = raw_memory_site(r, ins);
    if (mem.found) { return mem; }
    r = mem.r;
    return byte_scan_site(r, ins);
}

// One op per operand width, the width carried by the op rather than the name.
function bit_count_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "__clz32") { return Lowered { found: true, r: emit(r, ir.op_clz(32)) }; }
    if (ins.str == "__ctz32") { return Lowered { found: true, r: emit(r, ir.op_ctz(32)) }; }
    if (ins.str == "__popcount32") { return Lowered { found: true, r: emit(r, ir.op_popcount(32)) }; }
    if (ins.str == "__clz64") { return Lowered { found: true, r: emit(r, ir.op_clz(64)) }; }
    if (ins.str == "__ctz64") { return Lowered { found: true, r: emit(r, ir.op_ctz(64)) }; }
    if (ins.str == "__popcount64") { return Lowered { found: true, r: emit(r, ir.op_popcount(64)) }; }
    return Lowered { found: false, r: r };
}

// The raw-memory escape hatches. The byte load has no op of its own: it is the
// two-operand raw load at a constant zero offset, which is also what keeps the
// address at full pointer width.
function raw_memory_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "__alloc") { return Lowered { found: true, r: emit(r, ir.op_alloc()) }; }
    if (ins.str == "__alloc_u8") { return Lowered { found: true, r: emit(r, ir.op_alloc_u8()) }; }
    if (ins.str == "__free") { return Lowered { found: true, r: emit(r, ir.op_free()) }; }
    if (ins.str == "__ptr_width") { return Lowered { found: true, r: emit(r, ir.op_ptr_width()) }; }
    if (ins.str == "__heap_bump_bytes") { return Lowered { found: true, r: emit(r, ir.op_heap_bump_bytes()) }; }
    if (ins.str == "__heap_alloc_count") { return Lowered { found: true, r: emit(r, ir.op_heap_alloc_count()) }; }
    if (ins.str == "__heap_mark") { return Lowered { found: true, r: emit(r, ir.op_heap_mark()) }; }
    if (ins.str == "__heap_release_to") { return Lowered { found: true, r: emit(r, ir.op_heap_release_to()) }; }
    if (ins.str == "__memcpy") { return Lowered { found: true, r: emit(r, ir.op_memcpy()) }; }
    if (ins.str == "__memset") { return Lowered { found: true, r: emit(r, ir.op_memset()) }; }
    if (ins.str == "__load_u8") { r = emit(r, ir.op_const_i32(0)); return Lowered { found: true, r: emit(r, ir.op_raw_load8()) }; }
    if (ins.str == "__load_i32") { return Lowered { found: true, r: emit(r, ir.op_load_i32()) }; }
    if (ins.str == "__load_i64") { return Lowered { found: true, r: emit(r, ir.op_load_i64()) }; }
    if (ins.str == "__load_ptr") { return Lowered { found: true, r: emit(r, ir.op_load_ptr()) }; }
    if (ins.str == "__store_i32") { return Lowered { found: true, r: emit(r, ir.op_store_i32()) }; }
    if (ins.str == "__store_i64") { return Lowered { found: true, r: emit(r, ir.op_store_i64()) }; }
    if (ins.str == "__store_ptr") { return Lowered { found: true, r: emit(r, ir.op_store_ptr()) }; }
    return Lowered { found: false, r: r };
}

// The byte scans over a lent string.
function byte_scan_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "__sum_bytes") { return Lowered { found: true, r: emit(r, ir.op_sum_bytes()) }; }
    if (ins.str == "__scale_f64") { return Lowered { found: true, r: emit(r, ir.op_scale_f64()) }; }
    if (ins.str == "__crc32_cksum") { return Lowered { found: true, r: emit(r, ir.op_crc32_cksum()) }; }
    if (ins.str == "__ascii_run") { return Lowered { found: true, r: emit(r, ir.op_ascii_run()) }; }
    if (ins.str == "__scan_set") { return Lowered { found: true, r: emit(r, ir.op_scan_set()) }; }
    if (ins.str == "__count_runs") { return Lowered { found: true, r: emit(r, ir.op_count_runs()) }; }
    if (ins.str == "__bsd_sum") { return Lowered { found: true, r: emit(r, ir.op_bsd_sum()) }; }
    if (ins.str == "__count_byte") { return Lowered { found: true, r: emit(r, ir.op_count_byte()) }; }
    if (ins.str == "__rmemchr") { return Lowered { found: true, r: emit(r, ir.op_rmemchr()) }; }
    if (ins.str == "__mismatch") { return Lowered { found: true, r: emit(r, ir.op_mismatch()) }; }
    return Lowered { found: false, r: r };
}

// The string methods the AST lowering emits an op for, keyed by receiver the
// way their contracts are.
function string_method_site(own r: irlower.LowerResult, ins: ssa.SInst): Lowered {
    if (ins.str == "string.to_ascii_upper") { return Lowered { found: true, r: emit(r, ir.op_str_to_upper()) }; }
    if (ins.str == "string.to_ascii_lower") { return Lowered { found: true, r: emit(r, ir.op_str_to_lower()) }; }
    if (ins.str == "string.trim") { return Lowered { found: true, r: emit(r, ir.op_str_trim()) }; }
    if (ins.str == "string.reverse") { return Lowered { found: true, r: emit(r, ir.op_str_reverse()) }; }
    if (ins.str == "string.lines") { return Lowered { found: true, r: emit(r, ir.op_str_lines()) }; }
    if (ins.str == "string.split") { return Lowered { found: true, r: emit(r, ir.op_str_split()) }; }
    if (ins.str == "string.repeat") { return Lowered { found: true, r: emit(r, ir.op_str_repeat()) }; }
    if (ins.str == "string.replace") { return Lowered { found: true, r: emit(r, ir.op_str_replace()) }; }
    return Lowered { found: false, r: r };
}

// A name no half owns is a runtime helper with a symbol of its own, which a
// direct call reaches.
function builtin_site(own r: irlower.LowerResult, ins: ssa.SInst): irlower.LowerResult {
    var done: Lowered = handle_site(r, ins);
    if (!done.found) { r = done.r; done = union_builtin_site(r, ins); }
    if (!done.found) { r = done.r; done = value_builtin_site(r, ins); }
    if (!done.found) { r = done.r; done = intrinsic_site(r, ins); }
    if (!done.found) { r = done.r; done = string_method_site(r, ins); }
    if (done.found) { return done.r; }
    r = done.r;
    return emit(r, ir.op_call_direct(ins.str, ins.args.len()));
}

function block_body(own r: irlower.LowerResult, f: ssasem.Func, p: ssaunits.Plan, idx: i32[][], b: ssa.SBlock, structs: irlower.StructTab, grows: ssaunits.GrowRow[]): irlower.LowerResult {
    r = drops(r, at(p, idx, b.id, ssaunits.entry_point(), 0 - 1), f);
    var pos: i32 = 0;
    var pairs: ReusePairs = reuse_pairs(f, p, idx, b);
    for ins in b.insts {
        if (ins.kind_tag != 6 && ins.kind_tag != 8) {
            var step: ssaunits.Step = at(p, idx, b.id, pos, 0 - 1);
            var held: Held = bracketed(f, step, ins, grows);
            // One answer for both: the retain `supplies` holds back is the one
            // `instruction` then takes, and two calls could drift apart with
            // nothing to catch it.
            var defer0: boolean = deferred_retain(f, p, step, ins);
            r = supplies(r, f, p, step, defer0);
            r = bracket_take(r, f, held);
            // A box superseded by the construction at this same instruction is
            // taken BEFORE it, where an earlier drop's token was taken at the
            // drop and is already in the slot. Either way `reuse_construct`
            // reads one token slot and the runtime decides.
            if (pairs.selfs[pos] >= 0) { r = reuse_token(r, f, pairs.selfs[pos]); }
            if (pairs.builds[pos] >= 0 || pairs.selfs[pos] >= 0) { r = reuse_construct(r, f, ins); }
            else { r = instruction(r, f, p, ins, structs, defer0); }
            r = bracket_give(r, f, held);
            if (pairs.tokens[pos] >= 0) { r = reuse_token(r, f, pairs.tokens[pos]); }
            r = drops_less(r, step, f, pairs.tokens[pos], pairs.selfs[pos], ssaunits.shell_root(f, p, ins));
        }
        pos = pos + 1;
    }
    return r;
}

// Open stack-IR labels, innermost last. A label is the layout index control
// reaches by branching to it: a `block` ends before that index, a `loop`
// starts at it. An `if` arm is a label of its own that no branch targets.
// `steps` is the plan's step index (ssaunits.step_index).
struct Emit { r: irlower.LowerResult, labels: i32[], why: string, steps: i32[][] }

function label_if(): i32 { return 0 - 1; }

function push(own e: Emit, op: ir.Op, label: i32): Emit {
    return Emit { ...e, r: emit(e.r, op), labels: e.labels.append(label) };
}

function pop(own e: Emit): Emit {
    var labels: i32[] = [];
    var i: i32 = 0;
    while (i < e.labels.len() - 1) { labels = labels.append(e.labels[i]); i = i + 1; }
    return Emit { ...e, r: emit(e.r, ir.op_end()), labels: labels };
}

// A branch target without an open label is a layout defect; refuse the
// function rather than emit a depth the backends would fault on.
function depth(e: Emit, target: i32): i32 {
    var i: i32 = e.labels.len() - 1;
    while (i >= 0 && e.labels[i] != target) { i = i - 1; }
    if (i < 0) { return 0 - 1; }
    return e.labels.len() - 1 - i;
}

function rank(f: ssa.SFunc, order: i32[], id: i32): i32 {
    var i: i32 = 0;
    while (i < order.len()) { if (f.blocks[order[i]].id == id) { return i; } i = i + 1; }
    return 0 - 1;
}

function jump(own e: Emit, f: ssasem.Func, p: ssaunits.Plan, order: i32[], position: i32, target: i32): Emit {
    e = Emit { ...e, r: edge(e.r, f, p, e.steps, f.graph.blocks[order[position]].id, target) };
    var dest: i32 = rank(f.graph, order, target);
    if (dest == position + 1) { return e; }
    var d: i32 = depth(e, dest);
    if (d < 0) { return Emit { ...e, why: "branch target has no open label" }; }
    return Emit { ...e, r: emit(e.r, ir.op_br(d)) };
}

function terminator(own e: Emit, f: ssasem.Func, p: ssaunits.Plan, order: i32[], position: i32): Emit {
    var b: ssa.SBlock = f.graph.blocks[order[position]];
    if (b.term.kind_tag == 1 || b.term.kind_tag == 4) {
        var ret: ssaunits.Step = at(p, e.steps, b.id, ssaunits.return_point(), 0 - 1);
        e = Emit { ...e, r: supplies(e.r, f, p, ret, false) };
        e = Emit { ...e, r: drops(e.r, ret, f) };
        // The unreachable end aborts as a failed bounds check does, then
        // returns a zero the abort never lets the stack shape reach.
        if (b.term.kind_tag == 4) {
            e = Emit { ...e, r: emit(e.r, ir.op_const_i32(134)) };
            e = Emit { ...e, r: emit(e.r, ir.op_exit()) };
        }
        if (b.term.kind_tag == 1 && b.term.value >= 0) { e = Emit { ...e, r: emit(e.r, ir.op_load_local(b.term.value)) }; }
        else { e = Emit { ...e, r: emit(e.r, ir.op_const_i32(0)) }; }
        return Emit { ...e, r: emit(e.r, ir.op_return()) };
    }
    if (b.term.kind_tag == 2) { return jump(e, f, p, order, position, b.term.target); }
    if (b.term.t == b.term.f) { return jump(e, f, p, order, position, b.term.t); }
    e = Emit { ...e, r: emit(e.r, ir.op_load_local(b.term.cond)) };
    e = push(e, ir.op_if(0), label_if());
    e = jump(e, f, p, order, position, b.term.t);
    e = Emit { ...e, r: emit(e.r, ir.op_else()) };
    e = jump(e, f, p, order, position, b.term.f);
    return pop(e);
}

// Blocks inside an inner loop get their labels when that loop is entered,
// so a label never crosses the loop's own scope.
function inner(l: ssalayout.Layout, first: i32, last: i32, looping: boolean, at: i32): boolean {
    var i: i32 = first + 1;
    if (!looping) { i = first; }
    while (i <= last) {
        if (l.loop_end[i] >= 0 && at > i && at <= l.loop_end[i]) { return true; }
        if (l.loop_end[i] >= 0) { i = l.loop_end[i] + 1; } else { i = i + 1; }
    }
    return false;
}

// Emit layout indices first..last. A looping region is one natural loop:
// its `loop` label opens first, then a `block` per position inside that no
// nested loop owns, each closed just before its position is reached.
function region(own e: Emit, f: ssasem.Func, p: ssaunits.Plan, l: ssalayout.Layout, first: i32, last: i32, looping: boolean, structs: irlower.StructTab, grows: ssaunits.GrowRow[]): Emit {
    if (looping) { e = push(e, ir.op_loop(0), first); }
    var target: i32 = last;
    while (target > first) {
        if (!inner(l, first, last, looping, target)) { e = push(e, ir.op_block(0), target); }
        target = target - 1;
    }
    var position: i32 = first;
    while (position <= last) {
        if (position > first) { e = pop(e); }
        if (l.loop_end[position] >= 0 && (position > first || !looping)) {
            e = region(e, f, p, l, position, l.loop_end[position], true, structs, grows);
            position = l.loop_end[position] + 1;
        } else {
            e = Emit { ...e, r: block_body(e.r, f, p, e.steps, f.graph.blocks[l.order[position]], structs, grows) };
            e = terminator(e, f, p, l.order, position);
            position = position + 1;
        }
    }
    if (looping) { e = pop(e); }
    return e;
}

// An AST caller releases a produced callee's result by the contract this
// lowering honours, in the AST registries' own vocabulary: one counted
// reference whose container owns its children. Rows the caller's reading of
// the callee's syntax recorded for the same result are replaced. Only the
// shapes those registries can release get a row: a tuple's scalar-element
// array positions ("ARRF:"), an array result ("ARROWN:", whose shallow release
// is exact for a retained buffer and at worst strands a fresh one's pointer
// elements, #9187) and a box with no reference field or payload; every other
// position keeps the AST caller's leak-mode floor.
// The AST registries' spelling of what ssaunits.grow_rows found for `callee`,
// for the callers the AST lowering still emits: irlower.grow_param_flags_of's
// mask — one token per position, the receiver's first and then one per
// parameter — "0", "1" for an array parameter's own buffer, or "F:<field>,…"
// naming a record parameter's fields. A free function's receiver position
// carries "0".
pub function grow_mask(callee: string, f: ssasem.Func, rows: ssaunits.GrowRow[], method: boolean): string {
    var mask: string = "";
    if (!method) { mask = "0"; }
    var i: i32 = 0;
    while (i < f.params.len()) {
        var tok: string = "0";
        for row in rows {
            if (row.callee == callee && row.param == i && row.field < 0) { tok = "1"; }
        }
        var grown: i32[] = ssaunits.grow_fields_of(rows, callee, i);
        if (tok == "0" && grown.len() > 0) {
            var fields: semrecords.Field[] = record_fields(f.params[i], f);
            for field in grown {
                if (tok == "0") { tok = "F:" + fields[field].name; } else { tok = tok + "," + fields[field].name; }
            }
        }
        if (mask.len() == 0) { mask = tok; } else { mask = mask + ";" + tok; }
        i = i + 1;
    }
    return mask;
}

// The `own` array positions of a produced free function, as irlower's
// own_consumed_positions spells them: a counted array parameter is one the
// body consumes — a push that supersedes the buffer reclaims it, and the
// exit releases what is left — where the AST lowering's pointer-element
// protocol leaves the superseded buffer for the caller's rebind to release.
// Its AST callers transfer their reference instead (#9407).
pub function consumed_array_rows(key: string, f: ssasem.Func, modes: i32[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < f.params.len() && i < modes.len()) {
        if (modes[i] == ssaunits.counted_mode()) {
            if let typeinfo.TypeArray(_) = f.params[i] { out = out.append(key + "|" + util.i32_to_string(i)); }
        }
        i = i + 1;
    }
    return out;
}

pub function caller_sigs(sg: irlower.FnSigs, name: string, f: ssasem.Func, modes: i32[], plan: ssaunits.Plan): irlower.FnSigs {
    var tuples: string[] = without_rows(sg.tuple_fresh_ret_fns, name, ["", "ARRF:", "MAPF:"]);
    // Every row an AST reader could have written for this result is erased,
    // including the bare name. A row says the caller may release something;
    // once this function is lowered here, a row the AST inferred from syntax
    // describes a body the AST no longer lowered. Erasing one it should have
    // kept leaks; keeping one this boundary cannot honour double-frees, so the
    // list errs wide.
    //
    // The list mirrors irlower's readers by hand, and nothing ties the two
    // together: a reader prefix added there without a row here would let an
    // AST caller release a result this boundary lowered. The readers are the
    // `index_of_str(...return_fresh_struct_ret_fns, "<prefix>" + name)` sites
    // in irlower; grep that shape when adding one.
    var arrays: string[] = without_rows(sg.return_fresh_struct_ret_fns, name,
        ["", "ARR:", "ARROWN:", "SARRC:", "STRARR:", "ENUM:", "STRFLDF:",
         "CNTRET:", "ARRTUPF:", "ARRSTRUCTF:", "STRUCTARRF:", "ARENUMF:"]);
    if let typeinfo.TypeTuple(tup) = f.result {
        tuples = tuples.append(name);
        var flags: string = tuple_flags(tup);
        if (flags != "") { tuples = tuples.append("ARRF:" + name + "|" + flags); }
    }
    if let typeinfo.TypeArray(_) = f.result { arrays = arrays.append("ARROWN:" + name); }
    if (box_only_result(f)) { arrays = arrays.append(name); }
    if (box_only_union_result(f)) { arrays = arrays.append("ENUM:" + name); }
    // The counted-return class ("CNTRET:") is read through two more fields of
    // its own, so erasing the prefixed row alone would leave the caller still
    // told the result carries a count: cnt_struct_ret_fns names the callee and
    // cnt_handback_params its bare-returned positions. A result this boundary
    // lowered carries the contract above instead — one counted reference whose
    // release is the caller's — and an AST caller that ALSO gave back a
    // handback's extra count would release twice. Both go with the row.
    var tiers: string[] = counted_tiers(f, modes);
    var borrows: string[] = borrow_rows(sg.borrowable_params, name, tiers, bare_flags(f, modes, plan));
    return irlower.FnSigs { ...sg, tuple_fresh_ret_fns: tuples, return_fresh_struct_ret_fns: arrays,
        cnt_struct_ret_fns: without_rows(sg.cnt_struct_ret_fns, name, [""]),
        cnt_handback_params: without_rows(sg.cnt_handback_params, name, [""]),
        param_counted: counted_rows(sg.param_counted, name, tiers),
        borrowable_params: borrows, borrow_bare: irlower.borrow_reg_bare_index(borrows) };
}

// The AST caller's release of an argument it built follows the callee's
// parameter rows, which its readers took from the callee's SYNTAX: a borrowed
// parameter handed on to a counted one reads as consumed there, and an
// argument the rows call neither borrowed nor counted is taken to be the
// callee's, so the caller never releases it. The contract decides here: a
// borrowed reference parameter is only ever read or retained, which is the
// counted-tier row — every reference the callee keeps was retained, so
// exactly one release stays with the caller — and never the bare row, which
// promises the callee keeps no reference at all. A counted parameter takes
// the one count the caller hands over, which is the row-less reading already.
// The tier is the parameter's type, as the AST readers key it; the result
// needs no test, since a returned parameter is a retained one here.
function counted_tier(t: typeinfo.Type): string {
    if let typeinfo.TypeArray(a) = t {
        if (!ssasem.reference(a.elem) || ssasem.is_string(a.elem)) { return "ACNT:"; }
        if (named(a.elem) != "") { return "DCNT:"; }
        return "";
    }
    if (ssasem.is_string(t)) { return "SCNT:"; }
    if let typeinfo.TypeStruct(_) = t { return "PCNT:"; }
    if let typeinfo.TypeUnion(_) = t { return "ECNT:"; }
    if let typeinfo.TypeTuple(_) = t { return "TCNT:"; }
    return "";
}

function counted_tiers(f: ssasem.Func, modes: i32[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < modes.len()) {
        if (modes[i] == ssaunits.borrow_mode()) { out = out.append(counted_tier(f.params[i])); } else { out = out.append(""); }
        i = i + 1;
    }
    return out;
}

function tier_flags(tiers: string[], prefix: string): string {
    var flags: string = "";
    var any: boolean = false;
    for tier in tiers {
        if (tier == prefix || (prefix == "CNT:" && tier != "")) { flags = flags + "1"; any = true; } else { flags = flags + "0"; }
    }
    if (!any) { return ""; }
    return flags;
}

function tier_prefixes(): string[] { return ["ACNT:", "SCNT:", "ECNT:", "DCNT:", "TCNT:", "PCNT:"]; }

function counted_rows(rows: string[], name: string, tiers: string[]): string[] {
    var out: string[] = [];
    for row in rows {
        var mine: boolean = false;
        for prefix in tier_prefixes() { if (util.str_has_prefix(row, prefix + name + "|")) { mine = true; } }
        if (!mine) { out = out.append(row); }
    }
    for prefix in tier_prefixes() {
        var flags: string = tier_flags(tiers, prefix);
        if (flags != "") { out = out.append(prefix + name + "|" + flags); }
    }
    return out;
}

function borrow_rows(reg: string[], name: string, tiers: string[], bare_row: string): string[] {
    var bare: string[] = irlower.borrow_reg_set(reg, name, bare_row);
    return irlower.borrow_reg_set(bare, "CNT:" + name, tier_flags(tiers, "CNT:"));
}

// The bare row promises the callee keeps no reference to the argument once
// it returns, which an AST caller's element sweep relies on to free what the
// argument holds. A borrowed parameter keeps nothing when no unit of it, or of
// anything projected from it, is retained, and nothing projected from it is
// handed to a call other than a dyn dispatch, which lends its operands.
function bare_flags(f: ssasem.Func, modes: i32[], plan: ssaunits.Plan): string {
    if (!plan.ok) { return ""; }
    var borrows: boolean = false;
    for m in modes { if (m == ssaunits.borrow_mode()) { borrows = true; } }
    if (!borrows) { return ""; }
    var a: ssasem.Analysis = ssasem.analyze(f);
    if (!a.ok) { return ""; }
    var flags: string = "";
    var any: boolean = false;
    var i: i32 = 0;
    while (i < modes.len()) {
        var v: i32 = param_value(f, i);
        if (v >= 0 && modes[i] == ssaunits.borrow_mode() && keeps_nothing(f, plan, a, v)) { flags = flags + "1"; any = true; }
        else { flags = flags + "0"; }
        i = i + 1;
    }
    if (!any) { return ""; }
    return flags;
}

function param_value(f: ssasem.Func, index: i32): i32 {
    for b in f.graph.blocks {
        for ins in b.insts { if (ins.kind_tag == 6 && ins.imm == index) { return ins.result; } }
    }
    return 0 - 1;
}

function keeps_nothing(f: ssasem.Func, plan: ssaunits.Plan, a: ssasem.Analysis, param: i32): boolean {
    for step in plan.steps {
        for item in step.supplies {
            if (item.mode == ssaunits.retain_unit() && derives(a, item.value, param)) { return false; }
        }
    }
    for b in f.graph.blocks {
        for ins in b.insts {
            var handed: boolean = ins.kind_tag == ssasem.call_value() || (ins.kind_tag == ssasem.call() && !ssasem.is_dyn_call(ins.str));
            if (!handed) { continue; }
            for arg in ins.args { if (derives(a, arg, param)) { return false; } }
        }
    }
    return true;
}

function derives(a: ssasem.Analysis, v: i32, root: i32): boolean {
    if (v == root) { return true; }
    for dep in a.dependencies[v] { if (dep == root) { return true; } }
    return false;
}

// A nominal struct result whose release is the box and nothing else.
//
// This is the one nominal shape the bare-name row can carry. That row asserts
// the caller SOLE-owns the result, which this boundary does not promise: a
// return supplies one counted unit, and a value the function did not build —
// a projection of a borrowed parameter — is supplied by a retain over a box
// its caller still owns. The row's exit sweep then runs __struct_drop_<T>
// with no uniqueness guard, freeing a field buffer the other owner still
// reads.
//
// A schema with no reference field has no field walk for that sweep to run,
// so the release is the rc-guarded box dec alone and a shared result stays
// balanced. Every other nominal result keeps the leak floor until it can
// prove the box is the caller's only one.
function box_only_result(f: ssasem.Func): boolean {
    if let typeinfo.TypeStruct(_) = f.result { return !has_children(f.result, f); }
    return false;
}

// The union half of box_only_result, read through "ENUM:": a variant box with
// no reference payload is released by the rc-guarded box dec alone, so a
// shared result stays balanced (#9187).
function box_only_union_result(f: ssasem.Func): boolean {
    if let typeinfo.TypeUnion(_) = f.result { return !has_children(f.result, f); }
    return false;
}

function scalar_array(t: typeinfo.Type): boolean {
    if let typeinfo.TypeArray(a) = t { return !ssasem.reference(a.elem); }
    return false;
}

function tuple_flags(tup: typeinfo.TypeTuple): string {
    var flags: string = "";
    for elem in tup.elements {
        if (scalar_array(elem)) { flags = flags + "1"; } else { flags = flags + "0"; }
    }
    return flags;
}

// A row keyed "<prefix><name>" or "<prefix><name>|<flags>".
function keyed_row(row: string, prefix: string, name: string): boolean {
    var key: string = prefix + name;
    if (row == key) { return true; }
    return row.len() > key.len() && slice_unchecked(row, 0, key.len()) == key && row[key.len()] == b'|';
}

function without_rows(rows: string[], name: string, prefixes: string[]): string[] {
    var out: string[] = [];
    for row in rows {
        var drop: boolean = false;
        for prefix in prefixes { if (keyed_row(row, prefix, name)) { drop = true; } }
        if (!drop) { out = out.append(row); }
    }
    return out;
}

// `structs` is the declaration table the backends read a construction's field
// store widths from; the physical lowering names a declaration by index, as
// the AST lowering does.
//
// `grows` is the module's table of callee positions whose buffers a produced
// callee may grow in place (ssaunits.grow_rows over every produced plan), read
// by the caller-side bracket.
pub function lower(f: ssasem.Func, modes: i32[], p: ssaunits.Plan, structs: irlower.StructTab, grows: ssaunits.GrowRow[]): irlower.LowerResult {
    var why: string = validate(f, modes, p, structs);
    if (why != "") { return empty(why); }
    var layout: ssalayout.Layout = ssalayout.compute(f.graph);
    if (!layout.ok) { return empty("physical RC needs reducible graph"); }
    var e: Emit = region(Emit { r: frame(f), labels: [], why: "", steps: ssaunits.step_index(p) }, f, p, layout, 0, layout.order.len() - 1, false, structs, grows);
    if (e.why != "") { return empty(e.why); }
    var optimized: ir.OptimizedOps = ir.optimize_ops(e.r.ops, e.r.n_params, e.r.n_locals);
    return irlower.LowerResult { ...e.r, ops: optimized.ops, n_locals: optimized.n_locals };
}
