// examples/self_host/pipeline.lang — tenth concrete step of
// the self-host port and the first "everything composes" demo.
// Imports lexer + parser + constfold + checker + vm and drives
// a single non-trivial source program through every layer:
//
//   source text
//     → lexer.tokenize     (bytes → Token[])
//     → parser.parse_module(Token[] → Module)
//     → constfold.fold_module        (Module → Module)
//     → checker.check_module         (Module → ModuleTypes)
//     → vm.compile_program           (Module → CompiledProgram)
//     → vm.exec_program              (CompiledProgram → Value)
//
// Each layer was already exercised individually by its own
// `main()` — this file glues them together and asserts the
// composed pipeline produces the right answer for a realistic
// program. Catches mis-wired imports, accidentally-broken
// signatures, and "I changed one layer and forgot to re-test
// the chain" classes of bugs.
//
// The source under test computes 5! via mutual recursion +
// folds in a constant `2 + 3` (so we observe constfold doing
// real work along the way):
//
//   function fact(n: i32): i32 {
//       if (n <= 1) { return 1; }
//       return n * fact(n - 1);
//   }
//   function main(): i32 {
//       var c = 2 + 3;            // const-folds to 5
//       return fact(c);            // → 120
//   }

import "core/no_prelude";
import "./lexer";
import "./parser";
import "./constfold";
import "./checker";
import "./vm";

// run_pipeline glues the layers together. Returns a Value
// (vm.Value) so the caller can match on the variant — VInt for
// success, VErr if anything along the way refused.
function run_pipeline(src: string): vm.Value {
    var toks: lexer.Token[] = lexer.tokenize(src);
    var mod: parser.Module = parser.parse_module(toks);
    // constfold runs ahead of checker / vm so they see the
    // smaller, more concrete tree. Idempotent — running it
    // twice would produce the same result.
    var folded: parser.Module = constfold.fold_module(mod);
    var mt: checker.ModuleTypes = checker.check_module(folded);
    if (!mt.all_well_typed) {
        return vm.VErr { msg: "pipeline: program does not type-check" };
    }
    var prog: vm.CompiledProgram = vm.compile_program(folded);
    return vm.exec_program(prog);
}

function main(): i32 {
    // Realistic program: mutual recursion + constfold opportunity
    // + branch + arithmetic — exercises every layer non-trivially.
    var src: string =
        "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); }"
        + " function main(): i32 { var c = 2 + 3; return fact(c); }";
    var r1: vm.Value = run_pipeline(src);
    match (r1) {
        vm.VInt(i) => { if (i.v != 120) { return 10; } },
        vm.VErr(e) => { return 11; },
        _ => { return 12; }
    }

    // Constfold should observe `2 + 3` before the checker sees
    // the call site. Confirm by inspecting the folded module
    // separately — c's initializer should be a single number
    // literal after folding.
    var toks2: lexer.Token[] = lexer.tokenize(src);
    var mod2: parser.Module = parser.parse_module(toks2);
    var folded2: parser.Module = constfold.fold_module(mod2);
    // fact + main funcs; main's first stmt is `var c = …`
    // whose init should be a single ExprNumber after folding.
    if (len(folded2.funcs) != 2) { return 20; }
    match (folded2.funcs[1].body[0]) {
        parser.StmtVar(v) => {
            match (v.init) {
                parser.ExprNumber(n) => { if (n.text != "5") { return 21; } },
                _ => { return 22; }
            }
        },
        _ => { return 23; }
    }

    // Negative path: ill-typed program. Checker says it
    // doesn't type-check, run_pipeline surfaces VErr without
    // ever calling the VM.
    var bad: string = "function f(): i32 { return \"oops\"; } function main(): i32 { return f() + 1; }";
    var r3: vm.Value = run_pipeline(bad);
    match (r3) {
        vm.VErr(_) => { },
        _ => { return 30; }
    }

    // Array path: array literal + indexing flows through the
    // VM too. Sum of [3, 5, 7, 9] = 24 via while loop.
    var arr_src: string =
        "function main(): i32 {"
        + " var a = [3, 5, 7, 9];"
        + " var i = 0; var s = 0;"
        + " while (i < len(a)) { s = s + a[i]; i = i + 1; }"
        + " return s; }";
    var r4: vm.Value = run_pipeline(arr_src);
    match (r4) {
        vm.VInt(i) => { if (i.v != 24) { return 40; } },
        _ => { return 41; }
    }

    // No-function path: a top-level-stmts-only program still
    // composes — there's no `main` to call, so vm runs the
    // top_stmts in the implicit entry.
    var top_src: string = "var x = 7; var y = 11; return x + y;";
    var r5: vm.Value = run_pipeline(top_src);
    match (r5) {
        vm.VInt(i) => { if (i.v != 18) { return 50; } },
        _ => { return 51; }
    }

    return 0;
}
