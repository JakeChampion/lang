// examples/self_host/vm.lang — seventh concrete step of the
// self-host port and the first "lower-level representation"
// layer. Compiles a parser.Module's top-level stmts into a
// linear bytecode stream, then executes it on a tiny stack
// machine.
//
// Two demos in one file:
//   - compile_module(mod) → Op[]: AST → bytecode lowering.
//     Mirrors the shape of an IR builder: a recursive walk
//     over Expr / Stmt that emits ops with patched jump
//     targets. Demonstrates label-patching for forward jumps
//     (if-else / while).
//   - exec(ops): Value — stack-machine VM. Same Value union
//     the interp uses, plus a stack[] and locals[] vector
//     keyed by local-variable index (compile_module assigns
//     indices as it sees each `var`).
//
// Scope (intentionally narrow):
//   - i32 / bool / string values
//   - var declarations (assigned a local index in declaration
//     order)
//   - reassignment via `=`
//   - return (halts the VM with the top-of-stack value)
//   - if/else (forward jumps patched after the then/else
//     bodies are emitted)
//   - while (back-edge to the cond, forward jump out of the
//     body)
//   - binary / unary ops, comparisons, logical && ||
//   - println-style side-effect-free expr stmts
//
// Out of scope (next iteration): function decls + calls (would
// need a call frame stack + return address mechanism), arrays
// + indexing (need separate VArr handling in stack ops),
// constfold integration.

import "core/no_prelude";
import "./lexer";
import "./parser";

// =================== VALUE ====================

pub struct VInt { v: i32 }
pub struct VBool { v: boolean }
pub struct VString { v: string }
pub struct VFloat { v: f64 }
pub struct VArr { elements: Value[] }
pub struct VTuple { elements: Value[] }
pub struct VStruct { type_name: string, field_names: string[], field_values: Value[] }
// VFunc represents a callable value (closure). `entry` is the
// op index where the body begins; `locals_count` is the size
// of the body's locals vector. `captures` holds the values
// closed over at the point the closure was made — empty for
// lambdas without free vars and for top-level FuncDecl
// dispatch (which routes through OpCall, not OpCallClosure).
pub struct VFunc { entry: i32, locals_count: i32, captures: Value[] }
// VMap mirrors interp's parallel-array storage. Linear-scan
// lookup via value_eq_vm.
pub struct VMap { keys: Value[], values: Value[] }
pub struct VErr { msg: string }

pub type Value = VInt | VBool | VString | VFloat | VArr | VTuple | VStruct | VFunc | VMap | VErr;

function v_int(n: i32): Value { return VInt { v: n }; }
function v_bool(b: boolean): Value { return VBool { v: b }; }
function v_string(s: string): Value { return VString { v: s }; }
function v_float(n: f64): Value { return VFloat { v: n }; }
function v_arr(elements: Value[]): Value { return VArr { elements: elements }; }
function v_tuple(elements: Value[]): Value { return VTuple { elements: elements }; }
function v_map_new(): Value {
    var ks: Value[] = [];
    var vs: Value[] = [];
    return VMap { keys: ks, values: vs };
}

// VMapMethodResult is the (stack, handled) pair returned by
// vm_map_method. `handled` is false when the method name isn't
// one of the built-in VMap operations — the caller falls back
// to the FuncTable lookup in that case.
pub struct VMapMethodResult { stack: Value[], handled: boolean }

// vm_map_method dispatches the built-in VMap methods. The
// receiver sits at stack[recv_idx]; args sit at recv_idx+1
// .. recv_idx+argc. On a handled method, returns a new stack
// with the receiver + args trimmed and the result pushed.
function vm_map_method(m: VMap, name: string, argc: i32, stack: Value[], recv_idx: i32): VMapMethodResult {
    var result: Value = v_err("__pending__");
    var did_handle: boolean = false;
    if (name == "set" && argc == 2) {
        var sk: Value = stack[recv_idx + 1];
        var sv: Value = stack[recv_idx + 2];
        var found_i: i32 = 0 - 1;
        var fi: i32 = 0;
        while (fi < m.keys.len()) {
            if (value_eq_vm(m.keys[fi], sk)) { found_i = fi; }
            fi = fi + 1;
        }
        if (found_i >= 0) {
            var nvs: Value[] = [];
            var nj: i32 = 0;
            while (nj < m.values.len()) {
                if (nj == found_i) { nvs = nvs.push(sv); }
                else { nvs = nvs.push(m.values[nj]); }
                nj = nj + 1;
            }
            result = VMap { keys: m.keys, values: nvs };
        } else {
            result = VMap { keys: m.keys.push(sk), values: m.values.push(sv) };
        }
        did_handle = true;
    }
    if (name == "get_or" && argc == 2) {
        var gk: Value = stack[recv_idx + 1];
        var gd: Value = stack[recv_idx + 2];
        var got: Value = gd;
        var gi: i32 = 0;
        while (gi < m.keys.len()) {
            if (value_eq_vm(m.keys[gi], gk)) { got = m.values[gi]; }
            gi = gi + 1;
        }
        result = got;
        did_handle = true;
    }
    if (name == "has" && argc == 1) {
        var hk: Value = stack[recv_idx + 1];
        var h: boolean = false;
        var hi: i32 = 0;
        while (hi < m.keys.len()) {
            if (value_eq_vm(m.keys[hi], hk)) { h = true; }
            hi = hi + 1;
        }
        result = v_bool(h);
        did_handle = true;
    }
    if (name == "len" && argc == 0) {
        result = v_int(m.keys.len());
        did_handle = true;
    }
    if (!did_handle) {
        return VMapMethodResult { stack: stack, handled: false };
    }
    var ns: Value[] = [];
    var nsi: i32 = 0;
    while (nsi < recv_idx) { ns = ns.push(stack[nsi]); nsi = nsi + 1; }
    ns = ns.push(result);
    return VMapMethodResult { stack: ns, handled: true };
}
function v_struct(type_name: string, names: string[], values: Value[]): Value {
    return VStruct { type_name: type_name, field_names: names, field_values: values };
}
function v_err(msg: string): Value { return VErr { msg: msg }; }

function is_err(v: Value): boolean {
    match (v) {
        VErr(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// =================== OPCODES ====================

// Each Op is a struct with (op-kind, payload). The union keeps
// the bytecode array homogeneous so the VM can fetch ops via
// `ops[ip]`. Op-kinds carry their immediate operand inline
// (push immediates, local index, jump target) so the VM
// doesn't need to interleave operand bytes between ops.

pub struct OpPushInt { v: i32 }
pub struct OpPushBool { v: boolean }
pub struct OpPushStr { v: string }
pub struct OpPushFloat { v: f64 }
pub struct OpLoadLocal { idx: i32 }
pub struct OpStoreLocal { idx: i32 }
pub struct OpBinary { op: string }
pub struct OpUnary { op: string }
pub struct OpJump { target: i32 }
pub struct OpJumpIfFalse { target: i32 }
pub struct OpPop { tag: i32 }
// OpCall invokes a function by name. The VM looks the name up in
// the program's FuncTable at exec time, pops `argc` args off the
// operand stack, allocates a fresh locals vector sized to the
// function's body needs, and jumps to the entry IP. OpReturn
// from the callee restores the caller's frame and pushes the
// return value.
pub struct OpCall { name: string, argc: i32 }
// OpCallMethod dispatches `recv.name(args)` — pops `argc + 1`
// values (receiver underneath the args), matches the receiver's
// VStruct.type_name against the FuncTable's receiver_types
// column, and transfers into the matching method body. Receiver
// becomes locals[0]; args follow in declaration order. Falling
// back to a plain function is NOT performed — methods and plain
// funcs occupy distinct slots in the FuncTable.
pub struct OpCallMethod { name: string, argc: i32 }
// OpMakeFunc pushes a VFunc with the given body entry-ip and
// locals_count. Emitted by compile_expr for ExprLambda when the
// lambda body has no free vars — the body sits inline in the
// parent's bytecode with a JUMP-skip over it, and OpMakeFunc
// captures the body's entry index.
pub struct OpMakeFunc { entry: i32, locals_count: i32 }
// OpMakeClosure is the capture-bearing variant: pops
// `capture_count` values off the stack (in source order — the
// LAST capture pushed sits on top of the stack), bundles them
// with entry + locals_count into a VFunc.captures, pushes the
// VFunc. The compile arm for ExprLambda emits OpLoadLocal for
// each captured outer var then this op.
pub struct OpMakeClosure { entry: i32, locals_count: i32, capture_count: i32 }
// OpLoadCapture reads the current frame's captures[idx] and
// pushes it. Emitted by compile_expr for an ExprIdent that
// resolves to a captured name in the surrounding lambda.
pub struct OpLoadCapture { idx: i32 }
// OpCallClosure pops `argc + 1` values (callee VFunc on the
// bottom, args on top). Allocates a new locals vector, threads
// the VFunc's captures into the new frame, jumps to the
// VFunc's entry ip. The body's prologue does the descending
// OpStoreLocal pop just like a regular function.
pub struct OpCallClosure { argc: i32 }
// OpMakeArray pops `n` values off the stack and pushes a single
// VArr holding them in source order — the LAST element pushed
// sits at index n-1 (so we walk the stack top-to-bottom and
// prepend, or bottom-to-top after a length-bounded slurp).
pub struct OpMakeArray { n: i32 }
// OpIndex pops (index, array) and pushes array[index].
// VErrs on out-of-range, non-i32 index, non-array receiver.
pub struct OpIndex { tag: i32 }
// OpLen pops a VArr or VString and pushes its length as a VInt.
pub struct OpLen { tag: i32 }
// OpSlice pops (end, start, container) and pushes the sub-view.
// Same semantics as ExprSlice — works on both VArr and VString.
pub struct OpSlice { tag: i32 }
// OpMakeTuple pops `n` values off the stack (in source order)
// and pushes a single VTuple. Mirrors OpMakeArray but the
// resulting Value uses VTuple, so field access via OpFieldGet
// dispatches on tuple semantics.
pub struct OpMakeTuple { n: i32 }
// OpMakeStruct pops `len(field_names)` values from the stack
// (in source order — first pushed = field 0) and pushes a
// VStruct with the carried type_name + field_names.
pub struct OpMakeStruct { type_name: string, field_names: string[] }
// OpFieldGet pops a VStruct, looks up the named field, pushes
// its value. Missing field → VErr.
pub struct OpFieldGet { field_name: string }
// OpDup peeks the top of the operand stack and pushes a copy.
// Used by the StmtMatch lowering to test the scrutinee against
// multiple arm patterns without recomputing the expression.
pub struct OpDup { tag: i32 }
// OpTypeNameEq pops a Value and pushes VBool(true) iff it's a
// VStruct whose type_name matches the carried string. Other
// Value variants always push VBool(false). Used as the arm-
// guard in the StmtMatch lowering.
pub struct OpTypeNameEq { type_name: string }
pub struct OpReturn { tag: i32 }

pub type Op = OpPushInt | OpPushBool | OpPushStr | OpPushFloat
            | OpLoadLocal | OpStoreLocal
            | OpBinary | OpUnary
            | OpJump | OpJumpIfFalse
            | OpPop | OpCall | OpCallMethod
            | OpMakeFunc | OpMakeClosure | OpLoadCapture | OpCallClosure
            | OpMakeArray | OpMakeTuple | OpIndex | OpLen | OpSlice
            | OpMakeStruct | OpFieldGet
            | OpDup | OpTypeNameEq
            | OpReturn;

function op_push_int(n: i32): Op { return OpPushInt { v: n }; }
function op_push_bool(b: boolean): Op { return OpPushBool { v: b }; }
function op_push_str(s: string): Op { return OpPushStr { v: s }; }
function op_push_float(n: f64): Op { return OpPushFloat { v: n }; }
function op_load(i: i32): Op { return OpLoadLocal { idx: i }; }
function op_store(i: i32): Op { return OpStoreLocal { idx: i }; }
function op_binary(op: string): Op { return OpBinary { op: op }; }
function op_unary(op: string): Op { return OpUnary { op: op }; }
function op_jump(t: i32): Op { return OpJump { target: t }; }
function op_jump_if_false(t: i32): Op { return OpJumpIfFalse { target: t }; }
function op_pop(): Op { return OpPop { tag: 0 }; }
function op_call(name: string, argc: i32): Op { return OpCall { name: name, argc: argc }; }
function op_call_method(name: string, argc: i32): Op { return OpCallMethod { name: name, argc: argc }; }
function op_make_func(entry: i32, locals_count: i32): Op { return OpMakeFunc { entry: entry, locals_count: locals_count }; }
function op_make_closure(entry: i32, locals_count: i32, capture_count: i32): Op {
    return OpMakeClosure { entry: entry, locals_count: locals_count, capture_count: capture_count };
}
function op_load_capture(idx: i32): Op { return OpLoadCapture { idx: idx }; }
function op_call_closure(argc: i32): Op { return OpCallClosure { argc: argc }; }
function op_make_array(n: i32): Op { return OpMakeArray { n: n }; }
function op_make_tuple(n: i32): Op { return OpMakeTuple { n: n }; }
function op_index(): Op { return OpIndex { tag: 0 }; }
function op_len(): Op { return OpLen { tag: 0 }; }
function op_slice(): Op { return OpSlice { tag: 0 }; }
function op_make_struct(type_name: string, field_names: string[]): Op {
    return OpMakeStruct { type_name: type_name, field_names: field_names };
}
function op_field_get(field_name: string): Op { return OpFieldGet { field_name: field_name }; }
function op_dup(): Op { return OpDup { tag: 0 }; }
function op_type_name_eq(type_name: string): Op { return OpTypeNameEq { type_name: type_name }; }
function op_return(): Op { return OpReturn { tag: 0 }; }

// =================== COMPILER ====================

// Locals table: name → index (parallel arrays). Used by the
// compiler to translate var refs / assigns to local-index
// load/store ops. The same indices are reused by the VM's
// `locals[]` vector at exec time.
//
// `captures` is parallel: the inner lt of a lambda body carries
// the names captured from the outer scope so compile_expr for
// ExprIdent emits OpLoadCapture(idx) instead of OpLoadLocal.
// Top-level / non-lambda lts have an empty captures list.
pub struct LocalsTable { names: string[], captures: string[] }

function new_locals(): LocalsTable {
    var ns: string[] = [];
    var cs: string[] = [];
    return LocalsTable { names: ns, captures: cs };
}

function (lt: LocalsTable) idx_of(name: string): i32 {
    var i: i32 = 0;
    while (i < lt.names.len()) {
        if (lt.names[i] == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function (lt: LocalsTable) capture_idx_of(name: string): i32 {
    var i: i32 = 0;
    while (i < lt.captures.len()) {
        if (lt.captures[i] == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function (lt: LocalsTable) bind(name: string): LocalsTable {
    var ns: string[] = lt.names.push(name);
    return LocalsTable { names: ns, captures: lt.captures };
}

function (lt: LocalsTable) bind_capture(name: string): LocalsTable {
    var cs: string[] = lt.captures.push(name);
    return LocalsTable { names: lt.names, captures: cs };
}

// digits_to_i32: same helper the interp uses. Strips a leading
// `-` so synthetic negative-literal nodes (produced by the
// constfold pass on `0 - 5`) round-trip cleanly.
// i32_to_string: small inline helper used by the StmtFor
// lowering to mint unique synthetic-local names for nested
// loops. Matches the digit-by-digit pattern used elsewhere.
function i32_to_string(n: i32): string {
    if (n == 0) { return "0"; }
    var neg: boolean = false;
    if (n < 0) { neg = true; n = 0 - n; }
    var out: string = "";
    while (n > 0) {
        var d: i32 = n % 10;
        var c: string = "";
        if (d == 0) { c = "0"; } else if (d == 1) { c = "1"; }
        else if (d == 2) { c = "2"; } else if (d == 3) { c = "3"; }
        else if (d == 4) { c = "4"; } else if (d == 5) { c = "5"; }
        else if (d == 6) { c = "6"; } else if (d == 7) { c = "7"; }
        else if (d == 8) { c = "8"; } else { c = "9"; }
        out = c + out;
        n = n / 10;
    }
    if (neg) { out = "-" + out; }
    return out;
}

function digits_to_i32(s: string): i32 {
    if (s.len() == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == 45) { neg = true; start = 1; }
    var acc: i32 = 0;
    var i: i32 = start;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) {
            if (neg) { return 0 - acc; }
            return acc;
        }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    if (neg) { return 0 - acc; }
    return acc;
}

// digits_to_f64 parses a decimal float literal (`[-]d[.d]`).
// Mirrors interp.str_to_f64; the bytecode constant pool stores
// the parsed f64 directly so the runtime push is constant-time.
function digits_to_f64(s: string): f64 {
    var n: i32 = s.len();
    var neg: boolean = false;
    var i: i32 = 0;
    if (n > 0 && s[0] == 45) { neg = true; i = 1; }
    var int_part: f64 = 0.0;
    var frac_part: f64 = 0.0;
    var divisor: f64 = 1.0;
    var seen_dot: boolean = false;
    while (i < n) {
        var b: i32 = s[i];
        if (b == 46) { seen_dot = true; i = i + 1; continue; }
        if (b < 48 || b > 57) { break; }
        var d: i32 = b - 48;
        var df: f64 = (d as f64);
        if (seen_dot) {
            divisor = divisor * 10.0;
            frac_part = frac_part + (df / divisor);
        } else {
            int_part = int_part * 10.0 + df;
        }
        i = i + 1;
    }
    var v: f64 = int_part + frac_part;
    if (neg) { v = 0.0 - v; }
    return v;
}

// CompileResult bundles the ops and the threaded LocalsTable so
// the caller can sequence multiple compile_* calls. The
// threading mirrors the interp's StepResult shape: input state
// plus output, returned as a value rather than mutated through
// a shared frame.
pub struct CompileResult { ops: Op[], lt: LocalsTable }

// =================== FREE-VAR WALKER ====================

// collect_idents_expr appends every ident READ in `e` to `acc`.
// Used by the ExprLambda compile arm to find names that may
// need to be captured. Assignment targets (StmtAssign.target,
// pattern bindings, var-decl LHS) are collected separately by
// the stmt walker — they're not reads.
function collect_idents_expr(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprIdent(id) => { return acc.push(id.name); },
        parser.ExprNumber(_) => { return acc; },
        parser.ExprString(_) => { return acc; },
        parser.ExprBool(_) => { return acc; },
        parser.ExprBinary(b) => {
            acc = collect_idents_expr(b.left, acc);
            return collect_idents_expr(b.right, acc);
        },
        parser.ExprUnary(u) => { return collect_idents_expr(u.operand, acc); },
        parser.ExprCall(c) => {
            acc = collect_idents_expr(c.callee, acc);
            var i: i32 = 0;
            while (i < c.args.len()) {
                acc = collect_idents_expr(c.args[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                acc = collect_idents_expr(a.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                acc = collect_idents_expr(t.elements[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprIndex(x) => {
            acc = collect_idents_expr(x.array, acc);
            return collect_idents_expr(x.index, acc);
        },
        parser.ExprSlice(sl) => {
            acc = collect_idents_expr(sl.array, acc);
            acc = collect_idents_expr(sl.start, acc);
            return collect_idents_expr(sl.end, acc);
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                acc = collect_idents_expr(sl.field_values[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprFieldAccess(fa) => { return collect_idents_expr(fa.obj, acc); },
        parser.ExprLambda(lm) => {
            // Nested lambda: its free vars in the OUTER scope
            // are exactly the names it reads that aren't bound
            // by its own params or body. We collect everything
            // it references (params will be filtered out by the
            // outer lambda's own local-binding subtraction).
            var i: i32 = 0;
            while (i < lm.body.len()) {
                acc = collect_idents_stmt(lm.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.ExprUnknown(_) => { return acc; }
    }
    return acc;
}

function collect_idents_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        parser.StmtVar(v) => { return collect_idents_expr(v.init, acc); },
        parser.StmtReturn(r) => { return collect_idents_expr(r.value, acc); },
        parser.StmtExpr(e) => { return collect_idents_expr(e.value, acc); },
        parser.StmtIf(i) => {
            acc = collect_idents_expr(i.cond, acc);
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_idents_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_idents_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            acc = collect_idents_expr(w.cond, acc);
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_idents_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(a) => {
            // Targets are writes — but the assignment's `value`
            // is a read. The target itself isn't collected; if
            // the surrounding scope captures it as a write, the
            // current cut doesn't model that (captures are
            // read-only).
            return collect_idents_expr(a.value, acc);
        },
        parser.StmtMatch(m) => {
            acc = collect_idents_expr(m.scrutinee, acc);
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_idents_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = collect_idents_expr(f.iter, acc);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_idents_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// collect_bound_stmt walks `st` collecting every name introduced
// by a StmtVar / StmtFor / StmtMatch binding. Used to subtract
// inner-scope names from the free-var candidate set.
function collect_bound_stmt(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        parser.StmtVar(v) => { return acc.push(v.name); },
        parser.StmtReturn(_) => { return acc; },
        parser.StmtExpr(_) => { return acc; },
        parser.StmtIf(i) => {
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                acc = collect_bound_stmt(i.then_body[ti], acc);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                acc = collect_bound_stmt(i.else_body[ei], acc);
                ei = ei + 1;
            }
            return acc;
        },
        parser.StmtWhile(w) => {
            var i: i32 = 0;
            while (i < w.body.len()) {
                acc = collect_bound_stmt(w.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtAssign(_) => { return acc; },
        parser.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                match (m.arms[ai].pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.binding.len() > 0) { acc = acc.push(pv.binding); }
                    },
                    parser.PatWildcard(_) => { }
                }
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    acc = collect_bound_stmt(m.arms[ai].body[bi], acc);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return acc;
        },
        parser.StmtFor(f) => {
            acc = acc.push(f.var_name);
            var i: i32 = 0;
            while (i < f.body.len()) {
                acc = collect_bound_stmt(f.body[i], acc);
                i = i + 1;
            }
            return acc;
        },
        parser.StmtBreak(_) => { return acc; },
        parser.StmtContinue(_) => { return acc; },
        parser.StmtUnknown(_) => { return acc; }
    }
    return acc;
}

// has_str: linear-scan membership for the small subtract steps
// in the free-var pipeline.
function has_str(xs: string[], s: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == s) { return true; }
        i = i + 1;
    }
    return false;
}

function compile_expr(e: parser.Expr, ops: Op[], lt: LocalsTable): CompileResult {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) {
                ops = ops.push(op_push_float(digits_to_f64(n.text)));
            } else {
                ops = ops.push(op_push_int(digits_to_i32(n.text)));
            }
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprBool(b) => {
            ops = ops.push(op_push_bool(b.value));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprString(s) => {
            ops = ops.push(op_push_str(s.value));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprIdent(id) => {
            // Locals shadow captures (the inner-lt only contains
            // params + body-bound vars, so a name appearing in
            // both means a body-local re-binding). Captures fall
            // through to the outer-scope read.
            var li: i32 = lt.idx_of(id.name);
            if (li >= 0) {
                ops = ops.push(op_load(li));
                return CompileResult { ops: ops, lt: lt };
            }
            var ci: i32 = lt.capture_idx_of(id.name);
            if (ci >= 0) {
                ops = ops.push(op_load_capture(ci));
                return CompileResult { ops: ops, lt: lt };
            }
            // Emit a sentinel push that the VM turns into a
            // VErr at runtime. Lower-cost than a separate
            // "compile error" channel.
            ops = ops.push(op_push_str("__undef:" + id.name));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprBinary(b) => {
            var lr: CompileResult = compile_expr(b.left, ops, lt);
            ops = lr.ops; lt = lr.lt;
            var rr: CompileResult = compile_expr(b.right, ops, lt);
            ops = rr.ops; lt = rr.lt;
            ops = ops.push(op_binary(b.op));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprUnary(u) => {
            var orr: CompileResult = compile_expr(u.operand, ops, lt);
            ops = orr.ops; lt = orr.lt;
            ops = ops.push(op_unary(u.op));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprCall(c) => {
            // ExprIdent callee → plain function call OR closure
            // call (when the ident is a local var holding a
            // VFunc). ExprFieldAccess callee → method call.
            // Any other expression → eval as value, treat as
            // VFunc (catches IIFE forms).
            match (c.callee) {
                parser.ExprIdent(id) => {
                    // Builtin: `len(x)` lowers to OpLen.
                    if (id.name == "len" && c.args.len() == 1) {
                        var lar: CompileResult = compile_expr(c.args[0], ops, lt);
                        ops = lar.ops; lt = lar.lt;
                        ops = ops.push(op_len());
                        return CompileResult { ops: ops, lt: lt };
                    }
                    // If the ident is a local var (idx_of >= 0)
                    // OR a captured outer var, treat as a closure
                    // call: load the value (VFunc), then args,
                    // then OpCallClosure.
                    if (lt.idx_of(id.name) >= 0) {
                        ops = ops.push(op_load(lt.idx_of(id.name)));
                        var cai: i32 = 0;
                        while (cai < c.args.len()) {
                            var car: CompileResult = compile_expr(c.args[cai], ops, lt);
                            ops = car.ops; lt = car.lt;
                            cai = cai + 1;
                        }
                        ops = ops.push(op_call_closure(c.args.len()));
                        return CompileResult { ops: ops, lt: lt };
                    }
                    if (lt.capture_idx_of(id.name) >= 0) {
                        ops = ops.push(op_load_capture(lt.capture_idx_of(id.name)));
                        var cpai: i32 = 0;
                        while (cpai < c.args.len()) {
                            var cpar: CompileResult = compile_expr(c.args[cpai], ops, lt);
                            ops = cpar.ops; lt = cpar.lt;
                            cpai = cpai + 1;
                        }
                        ops = ops.push(op_call_closure(c.args.len()));
                        return CompileResult { ops: ops, lt: lt };
                    }
                    var ai: i32 = 0;
                    while (ai < c.args.len()) {
                        var ar: CompileResult = compile_expr(c.args[ai], ops, lt);
                        ops = ar.ops; lt = ar.lt;
                        ai = ai + 1;
                    }
                    ops = ops.push(op_call(id.name, c.args.len()));
                    return CompileResult { ops: ops, lt: lt };
                },
                parser.ExprFieldAccess(fa) => {
                    // Detect qualified-name call: `Ns.func(…)`
                    // where Ns is a bare ident. If the runtime
                    // FuncTable has `Ns.func`, dispatch as a
                    // plain call; otherwise fall through to
                    // method semantics. We can't disambiguate
                    // at compile time (no type info), so we
                    // emit OpCall for the qualified shape and
                    // let the runtime route either path.
                    var ns_hint: string = "";
                    match (fa.obj) {
                        parser.ExprIdent(ns_id) => { ns_hint = ns_id.name; },
                        _ => { }
                    }
                    if (ns_hint.len() > 0 && lt.idx_of(ns_hint) < 0 && lt.capture_idx_of(ns_hint) < 0) {
                        // Bare ident that isn't a local OR a
                        // capture — likely a namespace prefix.
                        // Emit args + a plain OpCall("ns.field",
                        // argc).
                        var qcai: i32 = 0;
                        while (qcai < c.args.len()) {
                            var qcar: CompileResult = compile_expr(c.args[qcai], ops, lt);
                            ops = qcar.ops; lt = qcar.lt;
                            qcai = qcai + 1;
                        }
                        ops = ops.push(op_call(ns_hint + "." + fa.field, c.args.len()));
                        return CompileResult { ops: ops, lt: lt };
                    }
                    // Receiver onto stack first, then args.
                    var rr: CompileResult = compile_expr(fa.obj, ops, lt);
                    ops = rr.ops; lt = rr.lt;
                    var mi: i32 = 0;
                    while (mi < c.args.len()) {
                        var mr: CompileResult = compile_expr(c.args[mi], ops, lt);
                        ops = mr.ops; lt = mr.lt;
                        mi = mi + 1;
                    }
                    ops = ops.push(op_call_method(fa.field, c.args.len()));
                    return CompileResult { ops: ops, lt: lt };
                },
                _ => {
                    // Any-expr callee — compile it, then args,
                    // then OpCallClosure. The runtime checks
                    // it's a VFunc.
                    var ccr: CompileResult = compile_expr(c.callee, ops, lt);
                    ops = ccr.ops; lt = ccr.lt;
                    var cai2: i32 = 0;
                    while (cai2 < c.args.len()) {
                        var car2: CompileResult = compile_expr(c.args[cai2], ops, lt);
                        ops = car2.ops; lt = car2.lt;
                        cai2 = cai2 + 1;
                    }
                    ops = ops.push(op_call_closure(c.args.len()));
                    return CompileResult { ops: ops, lt: lt };
                }
            }
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprTuple(t) => {
            var ti: i32 = 0;
            while (ti < t.elements.len()) {
                var tr: CompileResult = compile_expr(t.elements[ti], ops, lt);
                ops = tr.ops; lt = tr.lt;
                ti = ti + 1;
            }
            ops = ops.push(op_make_tuple(t.elements.len()));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                var er: CompileResult = compile_expr(a.elements[i], ops, lt);
                ops = er.ops; lt = er.lt;
                i = i + 1;
            }
            ops = ops.push(op_make_array(a.elements.len()));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprIndex(x) => {
            var ar: CompileResult = compile_expr(x.array, ops, lt);
            ops = ar.ops; lt = ar.lt;
            var ir: CompileResult = compile_expr(x.index, ops, lt);
            ops = ir.ops; lt = ir.lt;
            ops = ops.push(op_index());
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprSlice(sl) => {
            // Push container, start, end — OpSlice pops them in
            // reverse so we keep this natural source order.
            var ar: CompileResult = compile_expr(sl.array, ops, lt);
            ops = ar.ops; lt = ar.lt;
            var sr: CompileResult = compile_expr(sl.start, ops, lt);
            ops = sr.ops; lt = sr.lt;
            var er: CompileResult = compile_expr(sl.end, ops, lt);
            ops = er.ops; lt = er.lt;
            ops = ops.push(op_slice());
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprStructLit(sl) => {
            // Compile each field value (in source order); the
            // VM's OpMakeStruct pops them and assembles a
            // VStruct with the carried type_name + field_names.
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                var fr: CompileResult = compile_expr(sl.field_values[i], ops, lt);
                ops = fr.ops; lt = fr.lt;
                i = i + 1;
            }
            ops = ops.push(op_make_struct(sl.type_name, sl.field_names));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprFieldAccess(fa) => {
            var or: CompileResult = compile_expr(fa.obj, ops, lt);
            ops = or.ops; lt = or.lt;
            ops = ops.push(op_field_get(fa.field));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprLambda(lm) => {
            // Lowering: free-var sweep → emit a JUMP over the
            // body → lay the body inline → patch the JUMP →
            // load each captured outer local onto the stack →
            // OpMakeClosure (or OpMakeFunc when no captures).
            //
            // Free-var rule: a name is captured iff it's READ
            // in the body, is NOT a param, is NOT bound by an
            // inner `var` / `for` / match-pattern, AND exists
            // as a name in the outer LocalsTable (either as a
            // local or — in the nested-lambda case — as a
            // capture). Top-level function calls (idents whose
            // ExprCall arm routes through OpCall) appear in
            // the referenced set but won't show up in the
            // outer lt, so they're correctly skipped.
            var refs: string[] = [];
            var bri: i32 = 0;
            while (bri < lm.body.len()) {
                refs = collect_idents_stmt(lm.body[bri], refs);
                bri = bri + 1;
            }
            var bound: string[] = [];
            var bpi: i32 = 0;
            while (bpi < lm.params.len()) {
                bound = bound.push(lm.params[bpi].name);
                bpi = bpi + 1;
            }
            var bsi: i32 = 0;
            while (bsi < lm.body.len()) {
                bound = collect_bound_stmt(lm.body[bsi], bound);
                bsi = bsi + 1;
            }
            // Build capture list: dedup, keep insertion order,
            // skip locally-bound names, require presence in
            // outer lt (as local OR capture).
            var captures: string[] = [];
            var rri: i32 = 0;
            while (rri < refs.len()) {
                var nm: string = refs[rri];
                if (!has_str(bound, nm) && !has_str(captures, nm)) {
                    if (lt.idx_of(nm) >= 0 || lt.capture_idx_of(nm) >= 0) {
                        captures = captures.push(nm);
                    }
                }
                rri = rri + 1;
            }
            // Emit JUMP-skip + body.
            var skip_idx: i32 = ops.len();
            ops = ops.push(op_jump(0 - 1));
            var entry: i32 = ops.len();
            // Build inner lt: empty locals + the capture list.
            // Params + inner var-decls bind into `names` via the
            // existing compile_block path.
            var ltc: LocalsTable = new_locals();
            var cbi: i32 = 0;
            while (cbi < captures.len()) {
                ltc = ltc.bind_capture(captures[cbi]);
                cbi = cbi + 1;
            }
            var bi: i32 = 0;
            while (bi < lm.params.len()) {
                ltc = ltc.bind(lm.params[bi].name);
                bi = bi + 1;
            }
            var bj: i32 = lm.params.len() - 1;
            while (bj >= 0) {
                ops = ops.push(op_store(bj));
                bj = bj - 1;
            }
            var br: CompileResult = compile_block(lm.body, ops, ltc);
            ops = br.ops;
            // Implicit return-0 if the body falls off the end.
            ops = ops.push(op_push_int(0));
            ops = ops.push(op_return());
            var body_locals: i32 = br.lt.names.len();
            ops = patch_jump(ops, skip_idx, ops.len());
            // After the body, push captures (resolved against
            // the OUTER lt — could be locals or, when this
            // lambda is itself nested, captures of the parent).
            if (captures.len() == 0) {
                ops = ops.push(op_make_func(entry, body_locals));
                return CompileResult { ops: ops, lt: lt };
            }
            var cpi: i32 = 0;
            while (cpi < captures.len()) {
                var oi: i32 = lt.idx_of(captures[cpi]);
                if (oi >= 0) {
                    ops = ops.push(op_load(oi));
                } else {
                    ops = ops.push(op_load_capture(lt.capture_idx_of(captures[cpi])));
                }
                cpi = cpi + 1;
            }
            ops = ops.push(op_make_closure(entry, body_locals, captures.len()));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprUnknown(_) => {
            ops = ops.push(op_push_str("__exprunknown__"));
            return CompileResult { ops: ops, lt: lt };
        }
    }
    return CompileResult { ops: ops, lt: lt };
}

// patch_jump rewrites the target field of the op at `idx` to
// the current end-of-ops position. Used after emitting an
// if-then body to patch the OpJumpIfFalse over to the else
// arm, etc.
function patch_jump(ops: Op[], idx: i32, target: i32): Op[] {
    var out: Op[] = [];
    var i: i32 = 0;
    while (i < ops.len()) {
        if (i == idx) {
            match (ops[i]) {
                OpJump(_) => { out = out.push(op_jump(target)); },
                OpJumpIfFalse(_) => { out = out.push(op_jump_if_false(target)); },
                _ => { out = out.push(ops[i]); }
            }
        } else {
            out = out.push(ops[i]);
        }
        i = i + 1;
    }
    return out;
}

// patch_loop_sentinels replaces break / continue sentinels
// (OpJump(-1001) / OpJump(-1002)) emitted in ops[start..end]
// with concrete jump targets. Called by the enclosing loop's
// compile arm after its body finishes.
function patch_loop_sentinels(ops: Op[], start: i32, exit_target: i32, continue_target: i32): Op[] {
    var out: Op[] = [];
    var i: i32 = 0;
    while (i < ops.len()) {
        if (i >= start) {
            match (ops[i]) {
                OpJump(o) => {
                    if (o.target == 0 - 1001) {
                        out = out.push(op_jump(exit_target));
                    } else if (o.target == 0 - 1002) {
                        out = out.push(op_jump(continue_target));
                    } else {
                        out = out.push(ops[i]);
                    }
                },
                _ => { out = out.push(ops[i]); }
            }
        } else {
            out = out.push(ops[i]);
        }
        i = i + 1;
    }
    return out;
}

function compile_stmt(st: parser.Stmt, ops: Op[], lt: LocalsTable): CompileResult {
    match (st) {
        parser.StmtVar(v) => {
            var ir: CompileResult = compile_expr(v.init, ops, lt);
            ops = ir.ops; lt = ir.lt;
            lt = lt.bind(v.name);
            // The just-bound local sits at index len(lt.names) - 1.
            ops = ops.push(op_store(lt.names.len() - 1));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtReturn(r) => {
            var ir: CompileResult = compile_expr(r.value, ops, lt);
            ops = ir.ops; lt = ir.lt;
            ops = ops.push(op_return());
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtExpr(x) => {
            var ir: CompileResult = compile_expr(x.value, ops, lt);
            ops = ir.ops; lt = ir.lt;
            ops = ops.push(op_pop());
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtAssign(a) => {
            var i: i32 = lt.idx_of(a.target);
            if (i < 0) {
                ops = ops.push(op_push_str("__assign-undef:" + a.target));
                ops = ops.push(op_return());
                return CompileResult { ops: ops, lt: lt };
            }
            var ir: CompileResult = compile_expr(a.value, ops, lt);
            ops = ir.ops; lt = ir.lt;
            ops = ops.push(op_store(i));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtIf(ifs) => {
            // Emit:  cond; JUMP_IF_FALSE else_lbl; then_body; JUMP end_lbl; else_lbl: else_body; end_lbl:
            var cr: CompileResult = compile_expr(ifs.cond, ops, lt);
            ops = cr.ops; lt = cr.lt;
            var jif_idx: i32 = ops.len();
            ops = ops.push(op_jump_if_false(0 - 1));
            // then body
            var tr: CompileResult = compile_block(ifs.then_body, ops, lt);
            ops = tr.ops; lt = tr.lt;
            if (ifs.else_body.len() > 0) {
                var jump_end_idx: i32 = ops.len();
                ops = ops.push(op_jump(0 - 1));
                var else_target: i32 = ops.len();
                ops = patch_jump(ops, jif_idx, else_target);
                var er: CompileResult = compile_block(ifs.else_body, ops, lt);
                ops = er.ops; lt = er.lt;
                ops = patch_jump(ops, jump_end_idx, ops.len());
            } else {
                ops = patch_jump(ops, jif_idx, ops.len());
            }
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtWhile(w) => {
            var loop_top: i32 = ops.len();
            var cr: CompileResult = compile_expr(w.cond, ops, lt);
            ops = cr.ops; lt = cr.lt;
            var exit_idx: i32 = ops.len();
            ops = ops.push(op_jump_if_false(0 - 1));
            // Record where the body starts so patch_loop_
            // sentinels only touches ops emitted by THIS loop.
            var body_start: i32 = ops.len();
            var br: CompileResult = compile_block(w.body, ops, lt);
            ops = br.ops; lt = br.lt;
            ops = ops.push(op_jump(loop_top));
            ops = patch_jump(ops, exit_idx, ops.len());
            // Patch break / continue sentinels emitted in the
            // body: break → exit (current len(ops)), continue
            // → loop_top.
            ops = patch_loop_sentinels(ops, body_start, ops.len(), loop_top);
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtMatch(m) => {
            // Lowering: compile scrutinee, then for each arm
            // emit a guard (OpDup; OpTypeNameEq T; OpJumpIfFalse
            // next), a binding (OpStoreLocal idx) or a discard
            // (OpPop), the arm body, and an unconditional OpJump
            // to end. Wildcard arms skip the guard. After all
            // arms, an extra OpPop handles the no-match-and-no-
            // wildcard fall-through so the scrutinee doesn't
            // leak onto the rest of the stack.
            var cr: CompileResult = compile_expr(m.scrutinee, ops, lt);
            ops = cr.ops; lt = cr.lt;
            var end_idxs: i32[] = [];
            var i: i32 = 0;
            while (i < m.arms.len()) {
                var arm: parser.MatchArm = m.arms[i];
                var jif_idx: i32 = 0 - 1;
                match (arm.pattern) {
                    parser.PatVariant(pv) => {
                        ops = ops.push(op_dup());
                        ops = ops.push(op_type_name_eq(pv.type_name));
                        jif_idx = ops.len();
                        ops = ops.push(op_jump_if_false(0 - 1));
                        if (pv.binding.len() > 0 && pv.binding != "_") {
                            lt = lt.bind(pv.binding);
                            var bidx: i32 = lt.idx_of(pv.binding);
                            ops = ops.push(op_store(bidx));
                        } else {
                            ops = ops.push(op_pop());
                        }
                    },
                    parser.PatWildcard(_) => {
                        ops = ops.push(op_pop());
                    }
                }
                var br: CompileResult = compile_block(arm.body, ops, lt);
                ops = br.ops; lt = br.lt;
                var je_idx: i32 = ops.len();
                ops = ops.push(op_jump(0 - 1));
                end_idxs = end_idxs.push(je_idx);
                if (jif_idx >= 0) {
                    ops = patch_jump(ops, jif_idx, ops.len());
                }
                i = i + 1;
            }
            // Fall-through cleanup — only reached if no PatVariant
            // arm matched AND no wildcard caught.
            ops = ops.push(op_pop());
            // Patch every arm's `jump to end` to land here.
            var e: i32 = 0;
            while (e < end_idxs.len()) {
                ops = patch_jump(ops, end_idxs[e], ops.len());
                e = e + 1;
            }
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtBreak(_) => {
            // Emit an OpJump with a sentinel target; the
            // enclosing loop's compile arm sweeps body ops
            // after the fact and patches both sentinels:
            //   -1001 → loop exit  (break)
            //   -1002 → loop top   (continue)
            // Nested loops resolve correctly because the
            // inner loop's sweep patches its own break /
            // continue first, leaving outer-loop sentinels
            // for the outer sweep to find.
            ops = ops.push(op_jump(0 - 1001));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtContinue(_) => {
            ops = ops.push(op_jump(0 - 1002));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtFor(f) => {
            // Lowering: evaluate the iter expression into a
            // synthetic local, init an index local to 0, then
            // loop: index < len; load array[index]; store as
            // var_name; body; index += 1; jump back. Iter must
            // be a VArr at runtime — OpIndex returns VErr on
            // anything else.
            //
            // Synthetic locals get a `__for_iter_<N>` /
            // `__for_idx_<N>` name suffixed with len(lt.names)
            // so nested loops don't collide.
            var slot_suffix: string = i32_to_string(lt.names.len());
            var iter_name: string = "__for_iter_" + slot_suffix;
            var idx_name: string = "__for_idx_" + slot_suffix;

            // Compile iter onto stack, store into iter slot.
            var cr: CompileResult = compile_expr(f.iter, ops, lt);
            ops = cr.ops; lt = cr.lt;
            lt = lt.bind(iter_name);
            var iter_idx: i32 = lt.idx_of(iter_name);
            ops = ops.push(op_store(iter_idx));

            // Index = 0.
            ops = ops.push(op_push_int(0));
            lt = lt.bind(idx_name);
            var idx_local: i32 = lt.idx_of(idx_name);
            ops = ops.push(op_store(idx_local));

            // Allocate var_name as a real local (post-loop the
            // binding stays in scope; OK because loop var is
            // overwritten each iter, and the surrounding scope
            // typically doesn't reference it after).
            lt = lt.bind(f.var_name);
            var var_idx: i32 = lt.idx_of(f.var_name);

            // Loop top:
            var loop_top: i32 = ops.len();

            // index < len(iter): load index, load iter, OpLen,
            // OpBinary("<"), OpJumpIfFalse to exit.
            ops = ops.push(op_load(idx_local));
            ops = ops.push(op_load(iter_idx));
            ops = ops.push(op_len());
            ops = ops.push(op_binary("<"));
            var exit_idx: i32 = ops.len();
            ops = ops.push(op_jump_if_false(0 - 1));

            // var_name = iter[index].
            ops = ops.push(op_load(iter_idx));
            ops = ops.push(op_load(idx_local));
            ops = ops.push(op_index());
            ops = ops.push(op_store(var_idx));

            // Body. Track body_start so loop-sentinel patching
            // only touches break/continue from this loop's body
            // (not from a surrounding outer loop, if any).
            var body_start: i32 = ops.len();
            var br: CompileResult = compile_block(f.body, ops, lt);
            ops = br.ops; lt = br.lt;

            // Continue target: increment step. break sentinels
            // skip ahead to past the back-jump, where the loop's
            // exit lives.
            var continue_target: i32 = ops.len();
            // index = index + 1.
            ops = ops.push(op_load(idx_local));
            ops = ops.push(op_push_int(1));
            ops = ops.push(op_binary("+"));
            ops = ops.push(op_store(idx_local));

            // Jump back to top, patch exit to here.
            ops = ops.push(op_jump(loop_top));
            ops = patch_jump(ops, exit_idx, ops.len());
            ops = patch_loop_sentinels(ops, body_start, ops.len(), continue_target);
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtUnknown(_) => { return CompileResult { ops: ops, lt: lt }; }
    }
    return CompileResult { ops: ops, lt: lt };
}

function compile_block(body: parser.Stmt[], ops: Op[], lt: LocalsTable): CompileResult {
    var i: i32 = 0;
    while (i < body.len()) {
        var r: CompileResult = compile_stmt(body[i], ops, lt);
        ops = r.ops; lt = r.lt;
        i = i + 1;
    }
    return CompileResult { ops: ops, lt: lt };
}

// FuncTable: parallel arrays describing each function in the
// module. `entries[i]` is the IP of the first op of function i's
// body; `locals_counts[i]` is the size of the locals vector the
// callee's frame needs (params count + body var count). The
// VM's OpCall arm looks the name up here at exec time.
pub struct FuncTable {
    names: string[],
    entries: i32[],
    locals_counts: i32[],
    // Parallel to `names`: receiver_types[i] is the declared
    // receiver type for a method, or "" for a plain function.
    // OpCall looks up by name + empty receiver; OpCallMethod
    // looks up by name + the receiver value's type_name.
    receiver_types: string[]
}

// CompiledProgram bundles ops + funcs so callers can pass both
// into exec(). The top-level entry point (where execution
// starts) is always op 0, which the compiler emits as a JUMP
// over the function bodies straight into top-level stmts.
// `aliases` carries the module's union type-alias decls so
// OpCallMethod can dispatch a method declared on a union
// when the receiver is a variant struct.
pub struct CompiledProgram { ops: Op[], funcs: FuncTable, aliases: parser.TypeAlias[] }

// compile_func compiles one FuncDecl into a self-contained
// Op[] suffix. Params bind to locals 0..argc-1; the rest of the
// LocalsTable grows as `var` declarations appear. Returns the
// new ops + locals_count so compile_module can stamp the func
// entry into the table.
function compile_func(fd: parser.FuncDecl, ops: Op[]): CompileResult {
    var lt: LocalsTable = new_locals();
    // Method receiver — if present — becomes locals[0]. Params
    // follow it. The caller pushes receiver first, then args, so
    // the receiver sits deepest and the last arg is on top.
    var has_recv: boolean = fd.receiver_name.len() > 0;
    if (has_recv) { lt = lt.bind(fd.receiver_name); }
    var i: i32 = 0;
    while (i < fd.params.len()) {
        lt = lt.bind(fd.params[i].name);
        i = i + 1;
    }
    // Total slot count drives the store sequence — descend from
    // the highest index so the last-pushed value (top of stack)
    // lands in the highest local.
    var total: i32 = fd.params.len();
    if (has_recv) { total = total + 1; }
    var j: i32 = total - 1;
    while (j >= 0) {
        ops = ops.push(op_store(j));
        j = j - 1;
    }
    var r: CompileResult = compile_block(fd.body, ops, lt);
    // Implicit return-0 in case the body falls off the end.
    ops = r.ops;
    ops = ops.push(op_push_int(0));
    ops = ops.push(op_return());
    return CompileResult { ops: ops, lt: r.lt };
}

pub function compile_program(mod: parser.Module): CompiledProgram {
    var ops: Op[] = [];
    // First op: a jump over the function bodies. We patch the
    // target after we know where top-level stmts start.
    var jump_idx: i32 = ops.len();
    ops = ops.push(op_jump(0 - 1));
    // Emit each function body and record its entry IP.
    var fn_names: string[] = [];
    var fn_entries: i32[] = [];
    var fn_locals: i32[] = [];
    var fn_recv_types: string[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        var fd: parser.FuncDecl = mod.funcs[i];
        fn_names = fn_names.push(fd.name);
        fn_entries = fn_entries.push(ops.len());
        fn_recv_types = fn_recv_types.push(fd.receiver_type);
        var fr: CompileResult = compile_func(fd, ops);
        ops = fr.ops;
        fn_locals = fn_locals.push(fr.lt.names.len());
        i = i + 1;
    }
    // Patch the leading JUMP to point at where top-level
    // execution starts.
    ops = patch_jump(ops, jump_idx, ops.len());
    // Compile top-level stmts.
    var top_lt: LocalsTable = new_locals();
    var tr: CompileResult = compile_block(mod.top_stmts, ops, top_lt);
    ops = tr.ops;
    // If the module declares `main` but has no top-level stmts,
    // emit an implicit `main()` call as the entry point. Mirrors
    // the interp's eval_module behavior so a Go-style
    //   function main(): i32 { … }
    // program produces its main's return value as the program
    // result.
    if (mod.top_stmts.len() == 0) {
        var has_main: boolean = false;
        var mi: i32 = 0;
        while (mi < fn_names.len()) {
            if (fn_names[mi] == "main") { has_main = true; }
            mi = mi + 1;
        }
        if (has_main) {
            ops = ops.push(op_call("main", 0));
            ops = ops.push(op_return());
        }
    }
    // Trailing return-0 so falling off top-level halts cleanly.
    ops = ops.push(op_push_int(0));
    ops = ops.push(op_return());
    return CompiledProgram {
        ops: ops,
        funcs: FuncTable { names: fn_names, entries: fn_entries, locals_counts: fn_locals, receiver_types: fn_recv_types },
        aliases: mod.aliases
    };
}

// Back-compat: keep the original compile_module shape (Op[]
// only) for callers (the disassembler, the standalone run-
// source helper) that don't yet need the FuncTable.
pub function compile_module(mod: parser.Module): Op[] {
    return compile_program(mod).ops;
}

// =================== VM ====================

// Locals storage: parallel to LocalsTable.names but holding
// Value. Indexed by the same i32 the compiler stamped on
// OpLoadLocal / OpStoreLocal. Initial value VErr to make
// "uninitialised read" observable.
struct VMLocals { values: Value[] }

function new_vm_locals(n: i32): VMLocals {
    var vs: Value[] = [];
    var i: i32 = 0;
    while (i < n) { vs = vs.push(v_err("__uninit__")); i = i + 1; }
    return VMLocals { values: vs };
}

function (l: VMLocals) get(i: i32): Value {
    if (i < 0 || i >= l.values.len()) { return v_err("local index oob"); }
    return l.values[i];
}

function (l: VMLocals) set(i: i32, v: Value): VMLocals {
    if (i < 0 || i >= l.values.len()) { return l; }
    var vs: Value[] = [];
    var j: i32 = 0;
    while (j < l.values.len()) {
        if (j == i) { vs = vs.push(v); } else { vs = vs.push(l.values[j]); }
        j = j + 1;
    }
    return VMLocals { values: vs };
}

// max_local_idx scans the bytecode for the highest local index
// touched so the VM can size its locals vector once at startup.
// Avoids an "expand on access" path inside the inner loop.
function max_local_idx(ops: Op[]): i32 {
    var m: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < ops.len()) {
        match (ops[i]) {
            OpLoadLocal(o) => { if (o.idx > m) { m = o.idx; } },
            OpStoreLocal(o) => { if (o.idx > m) { m = o.idx; } },
            _ => { }
        }
        i = i + 1;
    }
    return m;
}

// Binary op evaluation on the value stack. Pops rhs then lhs,
// pushes result. Mirrors the interp's eval_expr binary arm so
// the VM and the tree-walker agree on semantics.
// value_eq_vm: structural equality across Value variants.
// Primitives compare by raw value. VTuple compares pairwise on
// elements (same arity required). VArr / VStruct still return
// false in this cut — array / struct equality semantics aren't
// modeled. Mixed-variant pairs return false.
function value_eq_vm(a: Value, b: Value): boolean {
    match (a) {
        VInt(ai) => {
            match (b) {
                VInt(bi) => { return ai.v == bi.v; },
                _ => { return false; }
            }
        },
        VBool(ab) => {
            match (b) {
                VBool(bb) => { return ab.v == bb.v; },
                _ => { return false; }
            }
        },
        VString(av) => {
            match (b) {
                VString(bv) => { return av.v == bv.v; },
                _ => { return false; }
            }
        },
        VFloat(af) => {
            match (b) {
                VFloat(bf) => { return af.v == bf.v; },
                _ => { return false; }
            }
        },
        VTuple(at) => {
            match (b) {
                VTuple(bt) => {
                    if (at.elements.len() != bt.elements.len()) { return false; }
                    var ti: i32 = 0;
                    while (ti < at.elements.len()) {
                        if (!value_eq_vm(at.elements[ti], bt.elements[ti])) { return false; }
                        ti = ti + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        VArr(aa) => {
            match (b) {
                VArr(ba) => {
                    if (aa.elements.len() != ba.elements.len()) { return false; }
                    var ai: i32 = 0;
                    while (ai < aa.elements.len()) {
                        if (!value_eq_vm(aa.elements[ai], ba.elements[ai])) { return false; }
                        ai = ai + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        VFunc(_) => { return false; },
        VMap(_) => { return false; },
        VStruct(asv) => {
            match (b) {
                VStruct(bsv) => {
                    if (asv.type_name != bsv.type_name) { return false; }
                    if (asv.field_values.len() != bsv.field_values.len()) { return false; }
                    var si: i32 = 0;
                    while (si < asv.field_values.len()) {
                        if (!value_eq_vm(asv.field_values[si], bsv.field_values[si])) { return false; }
                        si = si + 1;
                    }
                    return true;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

function apply_binary(op: string, lhs: Value, rhs: Value): Value {
    if (is_err(lhs)) { return lhs; }
    if (is_err(rhs)) { return rhs; }
    if (op == "+") {
        match (lhs) {
            VInt(li) => {
                match (rhs) {
                    VInt(ri) => { return v_int(li.v + ri.v); },
                    _ => { return v_err("`+` rhs type"); }
                }
            },
            VString(ls) => {
                match (rhs) {
                    VString(rs) => { return v_string(ls.v + rs.v); },
                    _ => { return v_err("`+` rhs type"); }
                }
            },
            VFloat(lf) => {
                match (rhs) {
                    VFloat(rf) => { return v_float(lf.v + rf.v); },
                    _ => { return v_err("`+` rhs type"); }
                }
            },
            _ => { return v_err("`+` lhs type"); }
        }
    }
    if (op == "-" || op == "*" || op == "/" || op == "%") {
        match (lhs) {
            VInt(li) => {
                match (rhs) {
                    VInt(ri) => {
                        if (op == "-") { return v_int(li.v - ri.v); }
                        if (op == "*") { return v_int(li.v * ri.v); }
                        if (op == "/") {
                            if (ri.v == 0) { return v_err("div by 0"); }
                            return v_int(li.v / ri.v);
                        }
                        if (ri.v == 0) { return v_err("mod by 0"); }
                        return v_int(li.v % ri.v);
                    },
                    _ => { return v_err("arith rhs type"); }
                }
            },
            VFloat(lf) => {
                match (rhs) {
                    VFloat(rf) => {
                        if (op == "-") { return v_float(lf.v - rf.v); }
                        if (op == "*") { return v_float(lf.v * rf.v); }
                        if (op == "/") {
                            if (rf.v == 0.0) { return v_err("float div by 0"); }
                            return v_float(lf.v / rf.v);
                        }
                        // `%` on floats isn't supported (matches
                        // the interp behaviour).
                        return v_err("`%` on f64 unsupported");
                    },
                    _ => { return v_err("arith rhs type"); }
                }
            },
            _ => { return v_err("arith lhs type"); }
        }
    }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") {
        match (lhs) {
            VInt(li) => {
                match (rhs) {
                    VInt(ri) => {
                        if (op == "<") { return v_bool(li.v < ri.v); }
                        if (op == "<=") { return v_bool(li.v <= ri.v); }
                        if (op == ">") { return v_bool(li.v > ri.v); }
                        return v_bool(li.v >= ri.v);
                    },
                    _ => { return v_err("cmp rhs type"); }
                }
            },
            VFloat(lf) => {
                match (rhs) {
                    VFloat(rf) => {
                        if (op == "<") { return v_bool(lf.v < rf.v); }
                        if (op == "<=") { return v_bool(lf.v <= rf.v); }
                        if (op == ">") { return v_bool(lf.v > rf.v); }
                        return v_bool(lf.v >= rf.v);
                    },
                    _ => { return v_err("cmp rhs type"); }
                }
            },
            _ => { return v_err("cmp lhs type"); }
        }
    }
    if (op == "==" || op == "!=") {
        var eq: boolean = value_eq_vm(lhs, rhs);
        if (op == "==") { return v_bool(eq); }
        return v_bool(!eq);
    }
    if (op == "&&" || op == "||") {
        match (lhs) {
            VBool(lb) => {
                match (rhs) {
                    VBool(rb) => {
                        if (op == "&&") { return v_bool(lb.v && rb.v); }
                        return v_bool(lb.v || rb.v);
                    },
                    _ => { return v_err("logical rhs type"); }
                }
            },
            _ => { return v_err("logical lhs type"); }
        }
    }
    return v_err("unknown binop: " + op);
}

function apply_unary(op: string, v: Value): Value {
    if (is_err(v)) { return v; }
    if (op == "-") {
        match (v) {
            VInt(i) => { return v_int(0 - i.v); },
            VFloat(f) => { return v_float(0.0 - f.v); },
            _ => { return v_err("unary `-` type"); }
        }
    }
    if (op == "!") {
        match (v) {
            VBool(b) => { return v_bool(!b.v); },
            _ => { return v_err("unary `!` type"); }
        }
    }
    return v_err("unknown unary op: " + op);
}

// Top-of-stack helpers. The stack is a Value[]; push/pop
// rebuild it. Cost is O(n) per op but the validation programs
// are tiny — same trade the rest of the port makes.
function stack_push(stack: Value[], v: Value): Value[] {
    return stack.push(v);
}

struct PopResult { stack: Value[], v: Value }

function stack_pop(stack: Value[]): PopResult {
    if (stack.len() == 0) { return PopResult { stack: stack, v: v_err("stack underflow") }; }
    var top: Value = stack[stack.len() - 1];
    var ns: Value[] = [];
    var i: i32 = 0;
    while (i < stack.len() - 1) { ns = ns.push(stack[i]); i = i + 1; }
    return PopResult { stack: ns, v: top };
}

// exec runs the bytecode until OpReturn or end-of-ops. Returns
// the top-of-stack value at the time of return (or VErr).
// Frame captures the call-state we restore on OpReturn: where
// to resume the caller's ip and what its locals vector looked
// like before the call. Frames live in a stack — multiple
// active calls (recursion) layer them.
// captures is the closure-capture vector active for this frame;
// OpLoadCapture(idx) reads cur_captures[idx]. Plain OpCall and
// OpCallMethod paths leave it empty.
pub struct Frame { saved_ip: i32, saved_locals: VMLocals, saved_captures: Value[] }

// lookup_func returns (entry_ip, locals_count, ok). Linear scan
// of the parallel arrays — the table is tiny (one entry per
// FuncDecl) so a hashmap would be overkill.
struct FuncLookup { entry: i32, locals_count: i32, ok: boolean }

function lookup_func(funcs: FuncTable, name: string): FuncLookup {
    var i: i32 = 0;
    while (i < funcs.names.len()) {
        // Plain function lookup skips method-shaped entries
        // (non-empty receiver_types). Methods live in their
        // own dispatch via lookup_method.
        if (funcs.names[i] == name && funcs.receiver_types[i].len() == 0) {
            return FuncLookup { entry: funcs.entries[i], locals_count: funcs.locals_counts[i], ok: true };
        }
        i = i + 1;
    }
    return FuncLookup { entry: 0, locals_count: 0, ok: false };
}

// lookup_method matches by name + receiver type. The receiver
// type is the runtime VStruct's type_name — exact string
// equality decides the dispatch.
// is_variant_of_alias_vm: walk the alias list looking for
// a union named union_name whose variant list contains
// struct_name. Mirrors the interp's variant-check.
function is_variant_of_alias_vm(struct_name: string, union_name: string, aliases: parser.TypeAlias[]): boolean {
    var i: i32 = 0;
    while (i < aliases.len()) {
        if (aliases[i].name == union_name) {
            var j: i32 = 0;
            while (j < aliases[i].variants.len()) {
                if (aliases[i].variants[j] == struct_name) { return true; }
                j = j + 1;
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

function lookup_method(funcs: FuncTable, name: string, recv_type: string, aliases: parser.TypeAlias[]): FuncLookup {
    var i: i32 = 0;
    while (i < funcs.names.len()) {
        var rt_match: boolean = funcs.receiver_types[i] == recv_type;
        // `bool` / `boolean` interchangeable spellings.
        if (!rt_match && recv_type == "bool" && funcs.receiver_types[i] == "boolean") {
            rt_match = true;
        }
        // Union-receiver methods: receiver_type may be a union
        // and recv_type its variant. Walk the alias list.
        if (!rt_match && is_variant_of_alias_vm(recv_type, funcs.receiver_types[i], aliases)) {
            rt_match = true;
        }
        if (funcs.names[i] == name && rt_match) {
            return FuncLookup { entry: funcs.entries[i], locals_count: funcs.locals_counts[i], ok: true };
        }
        i = i + 1;
    }
    return FuncLookup { entry: 0, locals_count: 0, ok: false };
}

pub function exec_program(prog: CompiledProgram): Value {
    var ops: Op[] = prog.ops;
    var funcs: FuncTable = prog.funcs;
    var aliases: parser.TypeAlias[] = prog.aliases;
    var stack: Value[] = [];
    var locals: VMLocals = new_vm_locals(max_local_idx(ops) + 1);
    var frames: Frame[] = [];
    var cur_captures: Value[] = [];
    var ip: i32 = 0;
    while (ip < ops.len()) {
        var op: Op = ops[ip];
        match (op) {
            OpPushInt(o) => { stack = stack_push(stack, v_int(o.v)); ip = ip + 1; },
            OpPushBool(o) => { stack = stack_push(stack, v_bool(o.v)); ip = ip + 1; },
            OpPushFloat(o) => { stack = stack_push(stack, v_float(o.v)); ip = ip + 1; },
            OpPushStr(o) => {
                // Magic "__undef:..." prefix → surface as VErr.
                if (o.v.len() >= 8 && o.v[0:8] == "__undef:") {
                    stack = stack_push(stack, v_err(o.v));
                } else if (o.v.len() >= 2 && o.v[0:2] == "__") {
                    stack = stack_push(stack, v_err(o.v));
                } else {
                    stack = stack_push(stack, v_string(o.v));
                }
                ip = ip + 1;
            },
            OpLoadLocal(o) => { stack = stack_push(stack, locals.get(o.idx)); ip = ip + 1; },
            OpStoreLocal(o) => {
                var p: PopResult = stack_pop(stack);
                stack = p.stack;
                locals = locals.set(o.idx, p.v);
                ip = ip + 1;
            },
            OpBinary(o) => {
                var pr: PopResult = stack_pop(stack); stack = pr.stack;
                var pl: PopResult = stack_pop(stack); stack = pl.stack;
                stack = stack_push(stack, apply_binary(o.op, pl.v, pr.v));
                ip = ip + 1;
            },
            OpUnary(o) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                stack = stack_push(stack, apply_unary(o.op, p.v));
                ip = ip + 1;
            },
            OpJump(o) => { ip = o.target; },
            OpJumpIfFalse(o) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                var take: boolean = false;
                match (p.v) {
                    VBool(b) => { take = !b.v; },
                    _ => { return v_err("jump_if_false: not bool"); }
                }
                if (take) { ip = o.target; } else { ip = ip + 1; }
            },
            OpPop(_) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                ip = ip + 1;
            },
            OpCall(o) => {
                // Builtin: map_new(cap) — pop the capacity arg
                // (ignored) and push an empty VMap. Pre-empts
                // the FuncTable lookup.
                if (o.name == "map_new") {
                    var pop_i: i32 = 0;
                    while (pop_i < o.argc) {
                        var pp: PopResult = stack_pop(stack); stack = pp.stack;
                        pop_i = pop_i + 1;
                    }
                    stack = stack_push(stack, v_map_new());
                    ip = ip + 1;
                    continue;
                }
                var fl: FuncLookup = lookup_func(funcs, o.name);
                if (!fl.ok) { return v_err("undefined function: " + o.name); }
                // Args sit on top of the stack — last pushed is
                // the deepest in callee-local order (the body's
                // OpStoreLocal sequence at function entry pops
                // them in reverse). Save current frame, allocate
                // a new locals vector sized to the callee.
                frames = frames.push(Frame { saved_ip: ip + 1, saved_locals: locals, saved_captures: cur_captures });
                locals = new_vm_locals(fl.locals_count);
                var empty_caps_c: Value[] = [];
                cur_captures = empty_caps_c;
                ip = fl.entry;
            },
            OpCallMethod(o) => {
                // Receiver sits beneath the args. Peek at depth
                // argc to read it; bail out cleanly if the stack
                // doesn't carry enough slots.
                if (stack.len() < o.argc + 1) {
                    return v_err("call_method: stack underflow");
                }
                var recv_idx: i32 = stack.len() - o.argc - 1;
                var recv: Value = stack[recv_idx];
                // Built-in VMap method dispatch — handled before
                // the FuncTable lookup. Pull the receiver out
                // and delegate to vm_map_method.
                match (recv) {
                    VMap(m) => {
                        var mres: VMapMethodResult = vm_map_method(m, o.name, o.argc, stack, recv_idx);
                        if (mres.handled) {
                            stack = mres.stack;
                            ip = ip + 1;
                            continue;
                        }
                    },
                    _ => { }
                }
                // Derive recv_type from the runtime value tag.
                // VStruct nominates its declared type_name;
                // primitive variants use their keyword spellings
                // so `function (s: string) name()` etc. dispatch.
                var recv_type: string = "";
                match (recv) {
                    VStruct(sv) => { recv_type = sv.type_name; },
                    VString(_) => { recv_type = "string"; },
                    VInt(_) => { recv_type = "i32"; },
                    VBool(_) => { recv_type = "bool"; },
                    VFloat(_) => { recv_type = "f64"; },
                    _ => { return v_err("call_method: receiver not a typed value"); }
                }
                var ml: FuncLookup = lookup_method(funcs, o.name, recv_type, aliases);
                if (!ml.ok) {
                    return v_err("undefined method `" + o.name + "` on `" + recv_type + "`");
                }
                // Stack already holds receiver + args in the
                // shape the callee's prologue expects (descending
                // OpStoreLocal pops the last arg into the highest
                // local index, walking down to the receiver at
                // local 0).
                frames = frames.push(Frame { saved_ip: ip + 1, saved_locals: locals, saved_captures: cur_captures });
                locals = new_vm_locals(ml.locals_count);
                var empty_caps_m: Value[] = [];
                cur_captures = empty_caps_m;
                ip = ml.entry;
            },
            OpMakeFunc(o) => {
                var empty_caps_f: Value[] = [];
                stack = stack_push(stack, VFunc { entry: o.entry, locals_count: o.locals_count, captures: empty_caps_f });
                ip = ip + 1;
            },
            OpMakeClosure(o) => {
                // Pop `capture_count` values (in source/push
                // order — last pushed sits on top) and bundle
                // them into a VFunc.
                if (stack.len() < o.capture_count) {
                    return v_err("make_closure: stack underflow");
                }
                var cap_start: i32 = stack.len() - o.capture_count;
                var caps: Value[] = [];
                var cki: i32 = 0;
                while (cki < o.capture_count) {
                    caps = caps.push(stack[cap_start + cki]);
                    cki = cki + 1;
                }
                var nstk: Value[] = [];
                var nsi2: i32 = 0;
                while (nsi2 < cap_start) { nstk = nstk.push(stack[nsi2]); nsi2 = nsi2 + 1; }
                stack = nstk;
                stack = stack_push(stack, VFunc { entry: o.entry, locals_count: o.locals_count, captures: caps });
                ip = ip + 1;
            },
            OpLoadCapture(o) => {
                if (o.idx < 0 || o.idx >= cur_captures.len()) {
                    return v_err("load_capture: idx out of range");
                }
                stack = stack_push(stack, cur_captures[o.idx]);
                ip = ip + 1;
            },
            OpCallClosure(o) => {
                // VFunc sits beneath the args. Pop in two
                // steps: first the args (kept in place at top
                // of stack so the callee's prologue can pop
                // them with descending OpStoreLocal), then
                // the callee VFunc.
                if (stack.len() < o.argc + 1) {
                    return v_err("call_closure: stack underflow");
                }
                var fn_idx: i32 = stack.len() - o.argc - 1;
                var fn_val: Value = stack[fn_idx];
                var fn_entry: i32 = 0;
                var fn_locals_count: i32 = 0;
                var fn_caps: Value[] = [];
                match (fn_val) {
                    VFunc(fv) => {
                        fn_entry = fv.entry;
                        fn_locals_count = fv.locals_count;
                        fn_caps = fv.captures;
                    },
                    _ => { return v_err("call_closure: callee not a VFunc"); }
                }
                // Splice the VFunc out of the stack, leaving
                // the args behind for the callee prologue.
                var ns: Value[] = [];
                var nsi: i32 = 0;
                while (nsi < fn_idx) { ns = ns.push(stack[nsi]); nsi = nsi + 1; }
                var nsj: i32 = fn_idx + 1;
                while (nsj < stack.len()) { ns = ns.push(stack[nsj]); nsj = nsj + 1; }
                stack = ns;
                frames = frames.push(Frame { saved_ip: ip + 1, saved_locals: locals, saved_captures: cur_captures });
                locals = new_vm_locals(fn_locals_count);
                cur_captures = fn_caps;
                ip = fn_entry;
            },
            OpMakeArray(o) => {
                // Pop `n` values off the stack. They were
                // pushed in source order so the last-pushed
                // sits on top — walk down to build the array
                // bottom-up.
                if (stack.len() < o.n) { return v_err("make_array: stack underflow"); }
                var elems: Value[] = [];
                var start: i32 = stack.len() - o.n;
                var i: i32 = 0;
                while (i < o.n) {
                    elems = elems.push(stack[start + i]);
                    i = i + 1;
                }
                // Trim the popped values off the stack.
                var ns: Value[] = [];
                var j: i32 = 0;
                while (j < start) { ns = ns.push(stack[j]); j = j + 1; }
                stack = ns;
                stack = stack_push(stack, v_arr(elems));
                ip = ip + 1;
            },
            OpMakeTuple(o) => {
                if (stack.len() < o.n) { return v_err("make_tuple: stack underflow"); }
                var elems: Value[] = [];
                var start: i32 = stack.len() - o.n;
                var i: i32 = 0;
                while (i < o.n) {
                    elems = elems.push(stack[start + i]);
                    i = i + 1;
                }
                var ns: Value[] = [];
                var j: i32 = 0;
                while (j < start) { ns = ns.push(stack[j]); j = j + 1; }
                stack = ns;
                stack = stack_push(stack, v_tuple(elems));
                ip = ip + 1;
            },
            OpIndex(_) => {
                var pi: PopResult = stack_pop(stack); stack = pi.stack;
                var pa: PopResult = stack_pop(stack); stack = pa.stack;
                if (is_err(pi.v)) { stack = stack_push(stack, pi.v); ip = ip + 1; continue; }
                if (is_err(pa.v)) { stack = stack_push(stack, pa.v); ip = ip + 1; continue; }
                match (pa.v) {
                    VArr(arr) => {
                        match (pi.v) {
                            VInt(ii) => {
                                if (ii.v < 0 || ii.v >= arr.elements.len()) {
                                    stack = stack_push(stack, v_err("array index out of range"));
                                } else {
                                    stack = stack_push(stack, arr.elements[ii.v]);
                                }
                            },
                            _ => { stack = stack_push(stack, v_err("index: not i32")); }
                        }
                    },
                    VString(s) => {
                        // String indexing — same semantics as the
                        // interp + checker: byte at position
                        // returned as VInt(byte). Parity across
                        // both evaluators.
                        match (pi.v) {
                            VInt(ii) => {
                                if (ii.v < 0 || ii.v >= s.v.len()) {
                                    stack = stack_push(stack, v_err("string index out of range"));
                                } else {
                                    stack = stack_push(stack, v_int(s.v[ii.v]));
                                }
                            },
                            _ => { stack = stack_push(stack, v_err("index: not i32")); }
                        }
                    },
                    _ => { stack = stack_push(stack, v_err("index: receiver not array or string")); }
                }
                ip = ip + 1;
            },
            OpLen(_) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                if (is_err(p.v)) { stack = stack_push(stack, p.v); ip = ip + 1; continue; }
                match (p.v) {
                    VArr(a) => { stack = stack_push(stack, v_int(a.elements.len())); },
                    VString(s) => { stack = stack_push(stack, v_int(s.v.len())); },
                    VMap(m) => { stack = stack_push(stack, v_int(m.keys.len())); },
                    _ => { stack = stack_push(stack, v_err("len: not array / string / map")); }
                }
                ip = ip + 1;
            },
            OpSlice(_) => {
                var pe: PopResult = stack_pop(stack); stack = pe.stack;
                var ps: PopResult = stack_pop(stack); stack = ps.stack;
                var pa: PopResult = stack_pop(stack); stack = pa.stack;
                if (is_err(pe.v)) { stack = stack_push(stack, pe.v); ip = ip + 1; continue; }
                if (is_err(ps.v)) { stack = stack_push(stack, ps.v); ip = ip + 1; continue; }
                if (is_err(pa.v)) { stack = stack_push(stack, pa.v); ip = ip + 1; continue; }
                var sb: i32 = 0;
                var eb: i32 = 0;
                match (ps.v) {
                    VInt(i) => { sb = i.v; },
                    _ => { stack = stack_push(stack, v_err("slice: start not i32")); ip = ip + 1; continue; }
                }
                match (pe.v) {
                    VInt(i) => { eb = i.v; },
                    _ => { stack = stack_push(stack, v_err("slice: end not i32")); ip = ip + 1; continue; }
                }
                match (pa.v) {
                    VArr(arr) => {
                        if (sb < 0 || eb > arr.elements.len() || sb > eb) {
                            stack = stack_push(stack, v_err("array slice out of range"));
                        } else {
                            var out: Value[] = [];
                            var i: i32 = sb;
                            while (i < eb) { out = out.push(arr.elements[i]); i = i + 1; }
                            stack = stack_push(stack, v_arr(out));
                        }
                    },
                    VString(s) => {
                        if (sb < 0 || eb > s.v.len() || sb > eb) {
                            stack = stack_push(stack, v_err("string slice out of range"));
                        } else {
                            stack = stack_push(stack, v_string(s.v[sb:eb]));
                        }
                    },
                    _ => { stack = stack_push(stack, v_err("slice: receiver not array or string")); }
                }
                ip = ip + 1;
            },
            OpMakeStruct(o) => {
                // Pop `len(field_names)` values in reverse so
                // the first field ends up at index 0. Build a
                // VStruct with the carried metadata.
                var nf: i32 = o.field_names.len();
                if (stack.len() < nf) {
                    stack = stack_push(stack, v_err("make_struct: stack underflow"));
                    ip = ip + 1;
                    continue;
                }
                var fvs: Value[] = [];
                var start: i32 = stack.len() - nf;
                var fi: i32 = 0;
                while (fi < nf) {
                    fvs = fvs.push(stack[start + fi]);
                    fi = fi + 1;
                }
                var ns: Value[] = [];
                var sj: i32 = 0;
                while (sj < start) { ns = ns.push(stack[sj]); sj = sj + 1; }
                stack = ns;
                stack = stack_push(stack, v_struct(o.type_name, o.field_names, fvs));
                ip = ip + 1;
            },
            OpFieldGet(o) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                if (is_err(p.v)) { stack = stack_push(stack, p.v); ip = ip + 1; continue; }
                match (p.v) {
                    VStruct(sv) => {
                        var found: boolean = false;
                        var fi: i32 = 0;
                        while (fi < sv.field_names.len() && !found) {
                            if (sv.field_names[fi] == o.field_name) {
                                stack = stack_push(stack, sv.field_values[fi]);
                                found = true;
                            }
                            fi = fi + 1;
                        }
                        if (!found) {
                            stack = stack_push(stack, v_err("struct " + sv.type_name + " has no field `" + o.field_name + "`"));
                        }
                    },
                    VTuple(tv) => {
                        var tidx: i32 = digits_to_i32(o.field_name);
                        if (tidx < 0 || tidx >= tv.elements.len()) {
                            stack = stack_push(stack, v_err("tuple index `" + o.field_name + "` out of range"));
                        } else {
                            stack = stack_push(stack, tv.elements[tidx]);
                        }
                    },
                    _ => { stack = stack_push(stack, v_err("field_get: receiver not a struct or tuple")); }
                }
                ip = ip + 1;
            },
            OpDup(_) => {
                if (stack.len() == 0) {
                    stack = stack_push(stack, v_err("dup: empty stack"));
                } else {
                    stack = stack_push(stack, stack[stack.len() - 1]);
                }
                ip = ip + 1;
            },
            OpTypeNameEq(o) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                var matched: boolean = false;
                match (p.v) {
                    VStruct(sv) => { matched = (sv.type_name == o.type_name); },
                    _ => { matched = false; }
                }
                stack = stack_push(stack, v_bool(matched));
                ip = ip + 1;
            },
            OpReturn(_) => {
                if (stack.len() == 0) { return v_err("return: empty stack"); }
                var ret_val: Value = stack[stack.len() - 1];
                if (frames.len() == 0) {
                    // Top-level return — surface to caller.
                    return ret_val;
                }
                // Pop the active frame, restore caller's locals
                // + ip, leave the return value on the stack so
                // the caller's next op (typically an
                // OpStoreLocal or part of a larger expr) reads
                // it.
                var top_frame: Frame = frames[frames.len() - 1];
                var nf: Frame[] = [];
                var fi: i32 = 0;
                while (fi < frames.len() - 1) { nf = nf.push(frames[fi]); fi = fi + 1; }
                frames = nf;
                // stack: we want to discard everything below
                // the return value that was left behind by the
                // callee (the callee's locals-zone is already
                // gone with the locals swap, but the operand
                // stack may have unused work). For our compiler
                // every body ends with PUSH expr + RETURN, so
                // there's exactly the one return value on top.
                // No cleanup needed.
                locals = top_frame.saved_locals;
                cur_captures = top_frame.saved_captures;
                ip = top_frame.saved_ip;
            }
        }
    }
    return v_err("ran past end of ops");
}

// Back-compat: exec(ops) for callers that don't have function
// decls. Builds an empty FuncTable so OpCall (if it ever
// appears) surfaces an "undefined function" VErr.
pub function exec(ops: Op[]): Value {
    var ns: string[] = [];
    var es: i32[] = [];
    var ls: i32[] = [];
    var rts: string[] = [];
    var al: parser.TypeAlias[] = [];
    return exec_program(CompiledProgram {
        ops: ops,
        funcs: FuncTable { names: ns, entries: es, locals_counts: ls, receiver_types: rts },
        aliases: al
    });
}

// =================== DRIVER + VALIDATION ====================

function run_source(src: string): Value {
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    var ops: Op[] = compile_module(mod);
    return exec(ops);
}

// run_module compiles + executes a source that may declare
// functions. Threads the FuncTable through so OpCall resolves
// correctly. Used by the function-call validation cases below.
function run_module(src: string): Value {
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    return exec_program(compile_program(mod));
}

function main(): i32 {
    // Arithmetic + ident: var x = 7; var y = 9; return x + y;
    var r1: Value = run_source("var x = 1 + 2 * 3; var y = (1 + 2) * 3; return x + y;");
    match (r1) {
        VInt(i) => { if (i.v != 16) { return 10; } },
        _ => { return 11; }
    }

    // String concat: just confirm the program completes with
    // the right return value — the var binding is side-effect-
    // free.
    var r2: Value = run_source("var s = \"a\" + \"b\"; return 42;");
    match (r2) {
        VInt(i) => { if (i.v != 42) { return 20; } },
        _ => { return 21; }
    }

    // Comparison + unary `!`: return !true == false → false;
    // dressing it up: return (!(5 < 10));  → false.
    var r3: Value = run_source("return !(5 < 10);");
    match (r3) {
        VBool(b) => { if (b.v) { return 30; } },
        _ => { return 31; }
    }

    // If/else, then-branch taken.
    var r4: Value = run_source("var x = 5; if (x < 10) { return 1; } else { return 2; }");
    match (r4) {
        VInt(i) => { if (i.v != 1) { return 40; } },
        _ => { return 41; }
    }

    // If/else, else-branch taken.
    var r5: Value = run_source("var x = 20; if (x < 10) { return 1; } else { return 2; }");
    match (r5) {
        VInt(i) => { if (i.v != 2) { return 50; } },
        _ => { return 51; }
    }

    // No-else if: condition false, falls through to next stmt.
    var r6: Value = run_source("if (false) { return 7; } return 11;");
    match (r6) {
        VInt(i) => { if (i.v != 11) { return 60; } },
        _ => { return 61; }
    }

    // While loop counter: sum 1..=5 = 15.
    var r7: Value = run_source(
        "var i = 1; var s = 0; while (i <= 5) { s = s + i; i = i + 1; } return s;"
    );
    match (r7) {
        VInt(i) => { if (i.v != 15) { return 70; } },
        _ => { return 71; }
    }

    // Early return inside while short-circuits the loop.
    var r8: Value = run_source(
        "var i = 0; while (i < 10) { if (i == 3) { return i; } i = i + 1; } return 0 - 1;"
    );
    match (r8) {
        VInt(i) => { if (i.v != 3) { return 80; } },
        _ => { return 81; }
    }

    // Undefined-ident becomes VErr at runtime.
    var r9: Value = run_source("return missing;");
    match (r9) {
        VErr(_) => { },
        _ => { return 90; }
    }

    // Division by zero → VErr.
    var r10: Value = run_source("return 1 / 0;");
    match (r10) {
        VErr(_) => { },
        _ => { return 100; }
    }

    // Function decl + call: `add(2, 3) → 5`.
    var r11: Value = run_module(
        "function add(x: i32, y: i32): i32 { return x + y; } var k = add(2, 3); return k;"
    );
    match (r11) {
        VInt(i) => { if (i.v != 5) { return 110; } },
        _ => { return 111; }
    }

    // Recursive factorial via the VM. fact(5) = 120.
    var r12: Value = run_module(
        "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); } return fact(5);"
    );
    match (r12) {
        VInt(i) => { if (i.v != 120) { return 120; } },
        _ => { return 121; }
    }

    // Mutual recursion: is_even(4) → 1. Same fixture the
    // tree-walking interp validates.
    var r13: Value = run_module(
        "function is_even(n: i32): i32 { if (n == 0) { return 1; } return is_odd(n - 1); }"
        + " function is_odd(n: i32): i32 { if (n == 0) { return 0; } return is_even(n - 1); }"
        + " return is_even(4);"
    );
    match (r13) {
        VInt(i) => { if (i.v != 1) { return 130; } },
        _ => { return 131; }
    }

    // Undefined function call → VErr.
    var r14: Value = run_module("return missing(1);");
    match (r14) {
        VErr(_) => { },
        _ => { return 140; }
    }

    // Array literal + indexing: `a[2] == 30`.
    var r15: Value = run_source("var a = [10, 20, 30]; return a[2];");
    match (r15) {
        VInt(i) => { if (i.v != 30) { return 150; } },
        _ => { return 151; }
    }

    // len() builtin on array → 4.
    var r16: Value = run_source("var a = [1, 2, 3, 4]; return len(a);");
    match (r16) {
        VInt(i) => { if (i.v != 4) { return 160; } },
        _ => { return 161; }
    }

    // Sum an array via while loop: 3 + 5 + 7 + 9 = 24.
    var r17: Value = run_source(
        "var a = [3, 5, 7, 9]; var i = 0; var s = 0; while (i < len(a)) { s = s + a[i]; i = i + 1; } return s;"
    );
    match (r17) {
        VInt(i) => { if (i.v != 24) { return 170; } },
        _ => { return 171; }
    }

    // Out-of-range index → VErr.
    var r18: Value = run_source("var a = [1, 2]; return a[5];");
    match (r18) {
        VErr(_) => { },
        _ => { return 180; }
    }

    // Empty array literal: len → 0.
    var r19: Value = run_source("var a = []; return len(a);");
    match (r19) {
        VInt(i) => { if (i.v != 0) { return 190; } },
        _ => { return 191; }
    }

    // String indexing: `s[0]` returns the byte as i32.
    // ASCII 'h' = 104.
    var r20: Value = run_source("var s = \"hello\"; return s[0];");
    match (r20) {
        VInt(i) => { if (i.v != 104) { return 200; } },
        _ => { return 201; }
    }

    // String slicing: `s[1:4]` of "hello" → "ell". Cross-check
    // via len.
    var r21: Value = run_source("var s = \"hello\"; var t = s[1:4]; return len(t);");
    match (r21) {
        VInt(i) => { if (i.v != 3) { return 210; } },
        _ => { return 211; }
    }

    // Array slicing: `[10,20,30,40,50][1:4]` → first elem 20.
    var r22: Value = run_source("var a = [10, 20, 30, 40, 50]; var b = a[1:4]; return b[0];");
    match (r22) {
        VInt(i) => { if (i.v != 20) { return 220; } },
        _ => { return 221; }
    }

    // Struct literal + field access: `Point { x: 3, y: 4 }.x` → 3.
    var r23: Value = run_source("return Point { x: 3, y: 4 }.x;");
    match (r23) {
        VInt(i) => { if (i.v != 3) { return 230; } },
        _ => { return 231; }
    }

    // Bound struct + chained field access.
    var r24: Value = run_source("var p = Point { x: 7, y: 11 }; return p.x + p.y;");
    match (r24) {
        VInt(i) => { if (i.v != 18) { return 240; } },
        _ => { return 241; }
    }

    // Nested struct field access.
    var r25: Value = run_source("var b = Box { inner: Point { x: 5, y: 0 } }; return b.inner.x;");
    match (r25) {
        VInt(i) => { if (i.v != 5) { return 250; } },
        _ => { return 251; }
    }

    // Missing field → VErr.
    var r26: Value = run_source("return Point { x: 1, y: 2 }.z;");
    match (r26) {
        VErr(_) => { },
        _ => { return 260; }
    }

    // StmtMatch — variant pattern binds the scrutinee, body
    // reads a field via the binding.
    var src27: string = "struct Circle { r: i32 } function main(): i32 { var c = Circle { r: 5 }; match (c) { Circle(x) => { return x.r; }, _ => { return 0 - 1; } } return 0 - 2; }";
    var r27: Value = run_module(src27);
    match (r27) {
        VInt(i) => { if (i.v != 5) { return 270; } },
        _ => { return 271; }
    }

    // StmtMatch — second variant matches, first is skipped.
    var src28: string = "struct Circle { r: i32 } struct Square { s: i32 } function main(): i32 { var q = Square { s: 7 }; match (q) { Circle(_) => { return 1; }, Square(sq) => { return sq.s; }, _ => { return 0 - 1; } } return 0 - 2; }";
    var r28: Value = run_module(src28);
    match (r28) {
        VInt(i) => { if (i.v != 7) { return 280; } },
