// examples/self_host/vm.lang — seventh concrete step of the
// self-host port and the first "lower-level representation"
// layer. Compiles a parser.Module's top-level stmts into a
// linear bytecode stream, then executes it on a tiny stack
// machine.
//
// Two demos in one file:
//   - compile_module(mod) → Op[]: AST → bytecode lowering.
//     Mirrors the shape of an IR builder: a recursive walk
//     over Expr / Stmt that emits ops with patched jump
//     targets. Demonstrates label-patching for forward jumps
//     (if-else / while).
//   - exec(ops): Value — stack-machine VM. Same Value union
//     the interp uses, plus a stack[] and locals[] vector
//     keyed by local-variable index (compile_module assigns
//     indices as it sees each `var`).
//
// Scope (intentionally narrow):
//   - i32 / bool / string values
//   - var declarations (assigned a local index in declaration
//     order)
//   - reassignment via `=`
//   - return (halts the VM with the top-of-stack value)
//   - if/else (forward jumps patched after the then/else
//     bodies are emitted)
//   - while (back-edge to the cond, forward jump out of the
//     body)
//   - binary / unary ops, comparisons, logical && ||
//   - println-style side-effect-free expr stmts
//
// Out of scope (next iteration): function decls + calls (would
// need a call frame stack + return address mechanism), arrays
// + indexing (need separate VArr handling in stack ops),
// constfold integration.

import "core/no_prelude";
import "./lexer";
import "./parser";

// =================== VALUE ====================

pub struct VInt { v: i32 }
pub struct VBool { v: boolean }
pub struct VString { v: string }
pub struct VArr { elements: Value[] }
pub struct VStruct { type_name: string, field_names: string[], field_values: Value[] }
pub struct VErr { msg: string }

pub type Value = VInt | VBool | VString | VArr | VStruct | VErr;

function v_int(n: i32): Value { return VInt { v: n }; }
function v_bool(b: boolean): Value { return VBool { v: b }; }
function v_string(s: string): Value { return VString { v: s }; }
function v_arr(elements: Value[]): Value { return VArr { elements: elements }; }
function v_struct(type_name: string, names: string[], values: Value[]): Value {
    return VStruct { type_name: type_name, field_names: names, field_values: values };
}
function v_err(msg: string): Value { return VErr { msg: msg }; }

function is_err(v: Value): boolean {
    match (v) {
        VErr(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// =================== OPCODES ====================

// Each Op is a struct with (op-kind, payload). The union keeps
// the bytecode array homogeneous so the VM can fetch ops via
// `ops[ip]`. Op-kinds carry their immediate operand inline
// (push immediates, local index, jump target) so the VM
// doesn't need to interleave operand bytes between ops.

pub struct OpPushInt { v: i32 }
pub struct OpPushBool { v: boolean }
pub struct OpPushStr { v: string }
pub struct OpLoadLocal { idx: i32 }
pub struct OpStoreLocal { idx: i32 }
pub struct OpBinary { op: string }
pub struct OpUnary { op: string }
pub struct OpJump { target: i32 }
pub struct OpJumpIfFalse { target: i32 }
pub struct OpPop { tag: i32 }
// OpCall invokes a function by name. The VM looks the name up in
// the program's FuncTable at exec time, pops `argc` args off the
// operand stack, allocates a fresh locals vector sized to the
// function's body needs, and jumps to the entry IP. OpReturn
// from the callee restores the caller's frame and pushes the
// return value.
pub struct OpCall { name: string, argc: i32 }
// OpMakeArray pops `n` values off the stack and pushes a single
// VArr holding them in source order — the LAST element pushed
// sits at index n-1 (so we walk the stack top-to-bottom and
// prepend, or bottom-to-top after a length-bounded slurp).
pub struct OpMakeArray { n: i32 }
// OpIndex pops (index, array) and pushes array[index].
// VErrs on out-of-range, non-i32 index, non-array receiver.
pub struct OpIndex { tag: i32 }
// OpLen pops a VArr or VString and pushes its length as a VInt.
pub struct OpLen { tag: i32 }
// OpSlice pops (end, start, container) and pushes the sub-view.
// Same semantics as ExprSlice — works on both VArr and VString.
pub struct OpSlice { tag: i32 }
// OpMakeStruct pops `len(field_names)` values from the stack
// (in source order — first pushed = field 0) and pushes a
// VStruct with the carried type_name + field_names.
pub struct OpMakeStruct { type_name: string, field_names: string[] }
// OpFieldGet pops a VStruct, looks up the named field, pushes
// its value. Missing field → VErr.
pub struct OpFieldGet { field_name: string }
// OpDup peeks the top of the operand stack and pushes a copy.
// Used by the StmtMatch lowering to test the scrutinee against
// multiple arm patterns without recomputing the expression.
pub struct OpDup { tag: i32 }
// OpTypeNameEq pops a Value and pushes VBool(true) iff it's a
// VStruct whose type_name matches the carried string. Other
// Value variants always push VBool(false). Used as the arm-
// guard in the StmtMatch lowering.
pub struct OpTypeNameEq { type_name: string }
pub struct OpReturn { tag: i32 }

pub type Op = OpPushInt | OpPushBool | OpPushStr
            | OpLoadLocal | OpStoreLocal
            | OpBinary | OpUnary
            | OpJump | OpJumpIfFalse
            | OpPop | OpCall
            | OpMakeArray | OpIndex | OpLen | OpSlice
            | OpMakeStruct | OpFieldGet
            | OpDup | OpTypeNameEq
            | OpReturn;

function op_push_int(n: i32): Op { return OpPushInt { v: n }; }
function op_push_bool(b: boolean): Op { return OpPushBool { v: b }; }
function op_push_str(s: string): Op { return OpPushStr { v: s }; }
function op_load(i: i32): Op { return OpLoadLocal { idx: i }; }
function op_store(i: i32): Op { return OpStoreLocal { idx: i }; }
function op_binary(op: string): Op { return OpBinary { op: op }; }
function op_unary(op: string): Op { return OpUnary { op: op }; }
function op_jump(t: i32): Op { return OpJump { target: t }; }
function op_jump_if_false(t: i32): Op { return OpJumpIfFalse { target: t }; }
function op_pop(): Op { return OpPop { tag: 0 }; }
function op_call(name: string, argc: i32): Op { return OpCall { name: name, argc: argc }; }
function op_make_array(n: i32): Op { return OpMakeArray { n: n }; }
function op_index(): Op { return OpIndex { tag: 0 }; }
function op_len(): Op { return OpLen { tag: 0 }; }
function op_slice(): Op { return OpSlice { tag: 0 }; }
function op_make_struct(type_name: string, field_names: string[]): Op {
    return OpMakeStruct { type_name: type_name, field_names: field_names };
}
function op_field_get(field_name: string): Op { return OpFieldGet { field_name: field_name }; }
function op_dup(): Op { return OpDup { tag: 0 }; }
function op_type_name_eq(type_name: string): Op { return OpTypeNameEq { type_name: type_name }; }
function op_return(): Op { return OpReturn { tag: 0 }; }

// =================== COMPILER ====================

// Locals table: name → index (parallel arrays). Used by the
// compiler to translate var refs / assigns to local-index
// load/store ops. The same indices are reused by the VM's
// `locals[]` vector at exec time.
pub struct LocalsTable { names: string[] }

function new_locals(): LocalsTable {
    var ns: string[] = [];
    return LocalsTable { names: ns };
}

function (lt: LocalsTable) idx_of(name: string): i32 {
    var i: i32 = 0;
    while (i < len(lt.names)) {
        if (lt.names[i] == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function (lt: LocalsTable) bind(name: string): LocalsTable {
    var ns: string[] = lt.names.push(name);
    return LocalsTable { names: ns };
}

// digits_to_i32: same helper the interp uses. Strips a leading
// `-` so synthetic negative-literal nodes (produced by the
// constfold pass on `0 - 5`) round-trip cleanly.
function digits_to_i32(s: string): i32 {
    if (len(s) == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == 45) { neg = true; start = 1; }
    var acc: i32 = 0;
    var i: i32 = start;
    while (i < len(s)) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) {
            if (neg) { return 0 - acc; }
            return acc;
        }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    if (neg) { return 0 - acc; }
    return acc;
}

// CompileResult bundles the ops and the threaded LocalsTable so
// the caller can sequence multiple compile_* calls. The
// threading mirrors the interp's StepResult shape: input state
// plus output, returned as a value rather than mutated through
// a shared frame.
pub struct CompileResult { ops: Op[], lt: LocalsTable }

function compile_expr(e: parser.Expr, ops: Op[], lt: LocalsTable): CompileResult {
    match (e) {
        parser.ExprNumber(n) => {
            ops = ops.push(op_push_int(digits_to_i32(n.text)));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprBool(b) => {
            ops = ops.push(op_push_bool(b.value));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprString(s) => {
            ops = ops.push(op_push_str(s.value));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprIdent(id) => {
            var i: i32 = lt.idx_of(id.name);
            if (i < 0) {
                // Emit a sentinel push that the VM turns into a
                // VErr at runtime. Lower-cost than a separate
                // "compile error" channel.
                ops = ops.push(op_push_str("__undef:" + id.name));
                return CompileResult { ops: ops, lt: lt };
            }
            ops = ops.push(op_load(i));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprBinary(b) => {
            var lr: CompileResult = compile_expr(b.left, ops, lt);
            ops = lr.ops; lt = lr.lt;
            var rr: CompileResult = compile_expr(b.right, ops, lt);
            ops = rr.ops; lt = rr.lt;
            ops = ops.push(op_binary(b.op));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprUnary(u) => {
            var orr: CompileResult = compile_expr(u.operand, ops, lt);
            ops = orr.ops; lt = orr.lt;
            ops = ops.push(op_unary(u.op));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprCall(c) => {
            // Only bare-ident callees are supported, mirroring
            // the interp's stance. Emit each arg in order
            // (left-to-right) so they sit on the stack with the
            // first arg deepest; OpCall pops `argc` of them and
            // stores them as locals 0..argc-1 in the callee.
            var name: string = "";
            match (c.callee) {
                parser.ExprIdent(id) => { name = id.name; },
                _ => {
                    ops = ops.push(op_push_str("__call-target-not-ident__"));
                    return CompileResult { ops: ops, lt: lt };
                }
            }
            // Builtin: `len(x)` lowers to OpLen instead of a
            // function call. Matches the checker / interp's
            // special-case for this name.
            if (name == "len" && len(c.args) == 1) {
                var lar: CompileResult = compile_expr(c.args[0], ops, lt);
                ops = lar.ops; lt = lar.lt;
                ops = ops.push(op_len());
                return CompileResult { ops: ops, lt: lt };
            }
            var i: i32 = 0;
            while (i < len(c.args)) {
                var ar: CompileResult = compile_expr(c.args[i], ops, lt);
                ops = ar.ops; lt = ar.lt;
                i = i + 1;
            }
            ops = ops.push(op_call(name, len(c.args)));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < len(a.elements)) {
                var er: CompileResult = compile_expr(a.elements[i], ops, lt);
                ops = er.ops; lt = er.lt;
                i = i + 1;
            }
            ops = ops.push(op_make_array(len(a.elements)));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprIndex(x) => {
            var ar: CompileResult = compile_expr(x.array, ops, lt);
            ops = ar.ops; lt = ar.lt;
            var ir: CompileResult = compile_expr(x.index, ops, lt);
            ops = ir.ops; lt = ir.lt;
            ops = ops.push(op_index());
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprSlice(sl) => {
            // Push container, start, end — OpSlice pops them in
            // reverse so we keep this natural source order.
            var ar: CompileResult = compile_expr(sl.array, ops, lt);
            ops = ar.ops; lt = ar.lt;
            var sr: CompileResult = compile_expr(sl.start, ops, lt);
            ops = sr.ops; lt = sr.lt;
            var er: CompileResult = compile_expr(sl.end, ops, lt);
            ops = er.ops; lt = er.lt;
            ops = ops.push(op_slice());
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprStructLit(sl) => {
            // Compile each field value (in source order); the
            // VM's OpMakeStruct pops them and assembles a
            // VStruct with the carried type_name + field_names.
            var i: i32 = 0;
            while (i < len(sl.field_values)) {
                var fr: CompileResult = compile_expr(sl.field_values[i], ops, lt);
                ops = fr.ops; lt = fr.lt;
                i = i + 1;
            }
            ops = ops.push(op_make_struct(sl.type_name, sl.field_names));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprFieldAccess(fa) => {
            var or: CompileResult = compile_expr(fa.obj, ops, lt);
            ops = or.ops; lt = or.lt;
            ops = ops.push(op_field_get(fa.field));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.ExprUnknown(_) => {
            ops = ops.push(op_push_str("__exprunknown__"));
            return CompileResult { ops: ops, lt: lt };
        }
    }
    return CompileResult { ops: ops, lt: lt };
}

// patch_jump rewrites the target field of the op at `idx` to
// the current end-of-ops position. Used after emitting an
// if-then body to patch the OpJumpIfFalse over to the else
// arm, etc.
function patch_jump(ops: Op[], idx: i32, target: i32): Op[] {
    var out: Op[] = [];
    var i: i32 = 0;
    while (i < len(ops)) {
        if (i == idx) {
            match (ops[i]) {
                OpJump(_) => { out = out.push(op_jump(target)); },
                OpJumpIfFalse(_) => { out = out.push(op_jump_if_false(target)); },
                _ => { out = out.push(ops[i]); }
            }
        } else {
            out = out.push(ops[i]);
        }
        i = i + 1;
    }
    return out;
}

function compile_stmt(st: parser.Stmt, ops: Op[], lt: LocalsTable): CompileResult {
    match (st) {
        parser.StmtVar(v) => {
            var ir: CompileResult = compile_expr(v.init, ops, lt);
            ops = ir.ops; lt = ir.lt;
            lt = lt.bind(v.name);
            // The just-bound local sits at index len(lt.names) - 1.
            ops = ops.push(op_store(len(lt.names) - 1));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtReturn(r) => {
            var ir: CompileResult = compile_expr(r.value, ops, lt);
            ops = ir.ops; lt = ir.lt;
            ops = ops.push(op_return());
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtExpr(x) => {
            var ir: CompileResult = compile_expr(x.value, ops, lt);
            ops = ir.ops; lt = ir.lt;
            ops = ops.push(op_pop());
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtAssign(a) => {
            var i: i32 = lt.idx_of(a.target);
            if (i < 0) {
                ops = ops.push(op_push_str("__assign-undef:" + a.target));
                ops = ops.push(op_return());
                return CompileResult { ops: ops, lt: lt };
            }
            var ir: CompileResult = compile_expr(a.value, ops, lt);
            ops = ir.ops; lt = ir.lt;
            ops = ops.push(op_store(i));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtIf(ifs) => {
            // Emit:  cond; JUMP_IF_FALSE else_lbl; then_body; JUMP end_lbl; else_lbl: else_body; end_lbl:
            var cr: CompileResult = compile_expr(ifs.cond, ops, lt);
            ops = cr.ops; lt = cr.lt;
            var jif_idx: i32 = len(ops);
            ops = ops.push(op_jump_if_false(0 - 1));
            // then body
            var tr: CompileResult = compile_block(ifs.then_body, ops, lt);
            ops = tr.ops; lt = tr.lt;
            if (len(ifs.else_body) > 0) {
                var jump_end_idx: i32 = len(ops);
                ops = ops.push(op_jump(0 - 1));
                var else_target: i32 = len(ops);
                ops = patch_jump(ops, jif_idx, else_target);
                var er: CompileResult = compile_block(ifs.else_body, ops, lt);
                ops = er.ops; lt = er.lt;
                ops = patch_jump(ops, jump_end_idx, len(ops));
            } else {
                ops = patch_jump(ops, jif_idx, len(ops));
            }
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtWhile(w) => {
            var loop_top: i32 = len(ops);
            var cr: CompileResult = compile_expr(w.cond, ops, lt);
            ops = cr.ops; lt = cr.lt;
            var exit_idx: i32 = len(ops);
            ops = ops.push(op_jump_if_false(0 - 1));
            var br: CompileResult = compile_block(w.body, ops, lt);
            ops = br.ops; lt = br.lt;
            ops = ops.push(op_jump(loop_top));
            ops = patch_jump(ops, exit_idx, len(ops));
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtMatch(m) => {
            // Lowering: compile scrutinee, then for each arm
            // emit a guard (OpDup; OpTypeNameEq T; OpJumpIfFalse
            // next), a binding (OpStoreLocal idx) or a discard
            // (OpPop), the arm body, and an unconditional OpJump
            // to end. Wildcard arms skip the guard. After all
            // arms, an extra OpPop handles the no-match-and-no-
            // wildcard fall-through so the scrutinee doesn't
            // leak onto the rest of the stack.
            var cr: CompileResult = compile_expr(m.scrutinee, ops, lt);
            ops = cr.ops; lt = cr.lt;
            var end_idxs: i32[] = [];
            var i: i32 = 0;
            while (i < len(m.arms)) {
                var arm: parser.MatchArm = m.arms[i];
                var jif_idx: i32 = 0 - 1;
                match (arm.pattern) {
                    parser.PatVariant(pv) => {
                        ops = ops.push(op_dup());
                        ops = ops.push(op_type_name_eq(pv.type_name));
                        jif_idx = len(ops);
                        ops = ops.push(op_jump_if_false(0 - 1));
                        if (len(pv.binding) > 0 && pv.binding != "_") {
                            lt = lt.bind(pv.binding);
                            var bidx: i32 = lt.idx_of(pv.binding);
                            ops = ops.push(op_store(bidx));
                        } else {
                            ops = ops.push(op_pop());
                        }
                    },
                    parser.PatWildcard(_) => {
                        ops = ops.push(op_pop());
                    }
                }
                var br: CompileResult = compile_block(arm.body, ops, lt);
                ops = br.ops; lt = br.lt;
                var je_idx: i32 = len(ops);
                ops = ops.push(op_jump(0 - 1));
                end_idxs = end_idxs.push(je_idx);
                if (jif_idx >= 0) {
                    ops = patch_jump(ops, jif_idx, len(ops));
                }
                i = i + 1;
            }
            // Fall-through cleanup — only reached if no PatVariant
            // arm matched AND no wildcard caught.
            ops = ops.push(op_pop());
            // Patch every arm's `jump to end` to land here.
            var e: i32 = 0;
            while (e < len(end_idxs)) {
                ops = patch_jump(ops, end_idxs[e], len(ops));
                e = e + 1;
            }
            return CompileResult { ops: ops, lt: lt };
        },
        parser.StmtUnknown(_) => { return CompileResult { ops: ops, lt: lt }; }
    }
    return CompileResult { ops: ops, lt: lt };
}

function compile_block(body: parser.Stmt[], ops: Op[], lt: LocalsTable): CompileResult {
    var i: i32 = 0;
    while (i < len(body)) {
        var r: CompileResult = compile_stmt(body[i], ops, lt);
        ops = r.ops; lt = r.lt;
        i = i + 1;
    }
    return CompileResult { ops: ops, lt: lt };
}

// FuncTable: parallel arrays describing each function in the
// module. `entries[i]` is the IP of the first op of function i's
// body; `locals_counts[i]` is the size of the locals vector the
// callee's frame needs (params count + body var count). The
// VM's OpCall arm looks the name up here at exec time.
pub struct FuncTable {
    names: string[],
    entries: i32[],
    locals_counts: i32[]
}

// CompiledProgram bundles ops + funcs so callers can pass both
// into exec(). The top-level entry point (where execution
// starts) is always op 0, which the compiler emits as a JUMP
// over the function bodies straight into top-level stmts.
pub struct CompiledProgram { ops: Op[], funcs: FuncTable }

// compile_func compiles one FuncDecl into a self-contained
// Op[] suffix. Params bind to locals 0..argc-1; the rest of the
// LocalsTable grows as `var` declarations appear. Returns the
// new ops + locals_count so compile_module can stamp the func
// entry into the table.
function compile_func(fd: parser.FuncDecl, ops: Op[]): CompileResult {
    var lt: LocalsTable = new_locals();
    // Params arrive on the stack in source order. Pop them
    // in REVERSE into locals 0..argc-1: the last pushed arg is
    // on top, so it goes into the highest local index. We bind
    // names first so we know which index each param maps to,
    // then emit a sequence of OpStoreLocal in descending order.
    var i: i32 = 0;
    while (i < len(fd.params)) {
        lt = lt.bind(fd.params[i].name);
        i = i + 1;
    }
    var j: i32 = len(fd.params) - 1;
    while (j >= 0) {
        ops = ops.push(op_store(j));
        j = j - 1;
    }
    var r: CompileResult = compile_block(fd.body, ops, lt);
    // Implicit return-0 in case the body falls off the end.
    ops = r.ops;
    ops = ops.push(op_push_int(0));
    ops = ops.push(op_return());
    return CompileResult { ops: ops, lt: r.lt };
}

pub function compile_program(mod: parser.Module): CompiledProgram {
    var ops: Op[] = [];
    // First op: a jump over the function bodies. We patch the
    // target after we know where top-level stmts start.
    var jump_idx: i32 = len(ops);
    ops = ops.push(op_jump(0 - 1));
    // Emit each function body and record its entry IP.
    var fn_names: string[] = [];
    var fn_entries: i32[] = [];
    var fn_locals: i32[] = [];
    var i: i32 = 0;
    while (i < len(mod.funcs)) {
        var fd: parser.FuncDecl = mod.funcs[i];
        fn_names = fn_names.push(fd.name);
        fn_entries = fn_entries.push(len(ops));
        var fr: CompileResult = compile_func(fd, ops);
        ops = fr.ops;
        fn_locals = fn_locals.push(len(fr.lt.names));
        i = i + 1;
    }
    // Patch the leading JUMP to point at where top-level
    // execution starts.
    ops = patch_jump(ops, jump_idx, len(ops));
    // Compile top-level stmts.
    var top_lt: LocalsTable = new_locals();
    var tr: CompileResult = compile_block(mod.top_stmts, ops, top_lt);
    ops = tr.ops;
    // If the module declares `main` but has no top-level stmts,
    // emit an implicit `main()` call as the entry point. Mirrors
    // the interp's eval_module behavior so a Go-style
    //   function main(): i32 { … }
    // program produces its main's return value as the program
    // result.
    if (len(mod.top_stmts) == 0) {
        var has_main: boolean = false;
        var mi: i32 = 0;
        while (mi < len(fn_names)) {
            if (fn_names[mi] == "main") { has_main = true; }
            mi = mi + 1;
        }
        if (has_main) {
            ops = ops.push(op_call("main", 0));
            ops = ops.push(op_return());
        }
    }
    // Trailing return-0 so falling off top-level halts cleanly.
    ops = ops.push(op_push_int(0));
    ops = ops.push(op_return());
    return CompiledProgram {
        ops: ops,
        funcs: FuncTable { names: fn_names, entries: fn_entries, locals_counts: fn_locals }
    };
}

// Back-compat: keep the original compile_module shape (Op[]
// only) for callers (the disassembler, the standalone run-
// source helper) that don't yet need the FuncTable.
pub function compile_module(mod: parser.Module): Op[] {
    return compile_program(mod).ops;
}

// =================== VM ====================

// Locals storage: parallel to LocalsTable.names but holding
// Value. Indexed by the same i32 the compiler stamped on
// OpLoadLocal / OpStoreLocal. Initial value VErr to make
// "uninitialised read" observable.
struct VMLocals { values: Value[] }

function new_vm_locals(n: i32): VMLocals {
    var vs: Value[] = [];
    var i: i32 = 0;
    while (i < n) { vs = vs.push(v_err("__uninit__")); i = i + 1; }
    return VMLocals { values: vs };
}

function (l: VMLocals) get(i: i32): Value {
    if (i < 0 || i >= len(l.values)) { return v_err("local index oob"); }
    return l.values[i];
}

function (l: VMLocals) set(i: i32, v: Value): VMLocals {
    if (i < 0 || i >= len(l.values)) { return l; }
    var vs: Value[] = [];
    var j: i32 = 0;
    while (j < len(l.values)) {
        if (j == i) { vs = vs.push(v); } else { vs = vs.push(l.values[j]); }
        j = j + 1;
    }
    return VMLocals { values: vs };
}

// max_local_idx scans the bytecode for the highest local index
// touched so the VM can size its locals vector once at startup.
// Avoids an "expand on access" path inside the inner loop.
function max_local_idx(ops: Op[]): i32 {
    var m: i32 = 0 - 1;
    var i: i32 = 0;
    while (i < len(ops)) {
        match (ops[i]) {
            OpLoadLocal(o) => { if (o.idx > m) { m = o.idx; } },
            OpStoreLocal(o) => { if (o.idx > m) { m = o.idx; } },
            _ => { }
        }
        i = i + 1;
    }
    return m;
}

// Binary op evaluation on the value stack. Pops rhs then lhs,
// pushes result. Mirrors the interp's eval_expr binary arm so
// the VM and the tree-walker agree on semantics.
function apply_binary(op: string, lhs: Value, rhs: Value): Value {
    if (is_err(lhs)) { return lhs; }
    if (is_err(rhs)) { return rhs; }
    if (op == "+") {
        match (lhs) {
            VInt(li) => {
                match (rhs) {
                    VInt(ri) => { return v_int(li.v + ri.v); },
                    _ => { return v_err("`+` rhs type"); }
                }
            },
            VString(ls) => {
                match (rhs) {
                    VString(rs) => { return v_string(ls.v + rs.v); },
                    _ => { return v_err("`+` rhs type"); }
                }
            },
            _ => { return v_err("`+` lhs type"); }
        }
    }
    if (op == "-" || op == "*" || op == "/" || op == "%") {
        match (lhs) {
            VInt(li) => {
                match (rhs) {
                    VInt(ri) => {
                        if (op == "-") { return v_int(li.v - ri.v); }
                        if (op == "*") { return v_int(li.v * ri.v); }
                        if (op == "/") {
                            if (ri.v == 0) { return v_err("div by 0"); }
                            return v_int(li.v / ri.v);
                        }
                        if (ri.v == 0) { return v_err("mod by 0"); }
                        return v_int(li.v % ri.v);
                    },
                    _ => { return v_err("arith rhs type"); }
                }
            },
            _ => { return v_err("arith lhs type"); }
        }
    }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") {
        match (lhs) {
            VInt(li) => {
                match (rhs) {
                    VInt(ri) => {
                        if (op == "<") { return v_bool(li.v < ri.v); }
                        if (op == "<=") { return v_bool(li.v <= ri.v); }
                        if (op == ">") { return v_bool(li.v > ri.v); }
                        return v_bool(li.v >= ri.v);
                    },
                    _ => { return v_err("cmp rhs type"); }
                }
            },
            _ => { return v_err("cmp lhs type"); }
        }
    }
    if (op == "==" || op == "!=") {
        var eq: boolean = false;
        match (lhs) {
            VInt(li) => {
                match (rhs) {
                    VInt(ri) => { eq = li.v == ri.v; },
                    _ => { }
                }
            },
            VBool(lb) => {
                match (rhs) {
                    VBool(rb) => { eq = lb.v == rb.v; },
                    _ => { }
                }
            },
            VString(ls) => {
                match (rhs) {
                    VString(rs) => { eq = ls.v == rs.v; },
                    _ => { }
                }
            },
            _ => { }
        }
        if (op == "==") { return v_bool(eq); }
        return v_bool(!eq);
    }
    if (op == "&&" || op == "||") {
        match (lhs) {
            VBool(lb) => {
                match (rhs) {
                    VBool(rb) => {
                        if (op == "&&") { return v_bool(lb.v && rb.v); }
                        return v_bool(lb.v || rb.v);
                    },
                    _ => { return v_err("logical rhs type"); }
                }
            },
            _ => { return v_err("logical lhs type"); }
        }
    }
    return v_err("unknown binop: " + op);
}

function apply_unary(op: string, v: Value): Value {
    if (is_err(v)) { return v; }
    if (op == "-") {
        match (v) {
            VInt(i) => { return v_int(0 - i.v); },
            _ => { return v_err("unary `-` type"); }
        }
    }
    if (op == "!") {
        match (v) {
            VBool(b) => { return v_bool(!b.v); },
            _ => { return v_err("unary `!` type"); }
        }
    }
    return v_err("unknown unary op: " + op);
}

// Top-of-stack helpers. The stack is a Value[]; push/pop
// rebuild it. Cost is O(n) per op but the validation programs
// are tiny — same trade the rest of the port makes.
function stack_push(stack: Value[], v: Value): Value[] {
    return stack.push(v);
}

struct PopResult { stack: Value[], v: Value }

function stack_pop(stack: Value[]): PopResult {
    if (len(stack) == 0) { return PopResult { stack: stack, v: v_err("stack underflow") }; }
    var top: Value = stack[len(stack) - 1];
    var ns: Value[] = [];
    var i: i32 = 0;
    while (i < len(stack) - 1) { ns = ns.push(stack[i]); i = i + 1; }
    return PopResult { stack: ns, v: top };
}

// exec runs the bytecode until OpReturn or end-of-ops. Returns
// the top-of-stack value at the time of return (or VErr).
// Frame captures the call-state we restore on OpReturn: where
// to resume the caller's ip and what its locals vector looked
// like before the call. Frames live in a stack — multiple
// active calls (recursion) layer them.
pub struct Frame { saved_ip: i32, saved_locals: VMLocals }

// lookup_func returns (entry_ip, locals_count, ok). Linear scan
// of the parallel arrays — the table is tiny (one entry per
// FuncDecl) so a hashmap would be overkill.
struct FuncLookup { entry: i32, locals_count: i32, ok: boolean }

function lookup_func(funcs: FuncTable, name: string): FuncLookup {
    var i: i32 = 0;
    while (i < len(funcs.names)) {
        if (funcs.names[i] == name) {
            return FuncLookup { entry: funcs.entries[i], locals_count: funcs.locals_counts[i], ok: true };
        }
        i = i + 1;
    }
    return FuncLookup { entry: 0, locals_count: 0, ok: false };
}

pub function exec_program(prog: CompiledProgram): Value {
    var ops: Op[] = prog.ops;
    var funcs: FuncTable = prog.funcs;
    var stack: Value[] = [];
    var locals: VMLocals = new_vm_locals(max_local_idx(ops) + 1);
    var frames: Frame[] = [];
    var ip: i32 = 0;
    while (ip < len(ops)) {
        var op: Op = ops[ip];
        match (op) {
            OpPushInt(o) => { stack = stack_push(stack, v_int(o.v)); ip = ip + 1; },
            OpPushBool(o) => { stack = stack_push(stack, v_bool(o.v)); ip = ip + 1; },
            OpPushStr(o) => {
                // Magic "__undef:..." prefix → surface as VErr.
                if (len(o.v) >= 8 && o.v[0:8] == "__undef:") {
                    stack = stack_push(stack, v_err(o.v));
                } else if (len(o.v) >= 2 && o.v[0:2] == "__") {
                    stack = stack_push(stack, v_err(o.v));
                } else {
                    stack = stack_push(stack, v_string(o.v));
                }
                ip = ip + 1;
            },
            OpLoadLocal(o) => { stack = stack_push(stack, locals.get(o.idx)); ip = ip + 1; },
            OpStoreLocal(o) => {
                var p: PopResult = stack_pop(stack);
                stack = p.stack;
                locals = locals.set(o.idx, p.v);
                ip = ip + 1;
            },
            OpBinary(o) => {
                var pr: PopResult = stack_pop(stack); stack = pr.stack;
                var pl: PopResult = stack_pop(stack); stack = pl.stack;
                stack = stack_push(stack, apply_binary(o.op, pl.v, pr.v));
                ip = ip + 1;
            },
            OpUnary(o) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                stack = stack_push(stack, apply_unary(o.op, p.v));
                ip = ip + 1;
            },
            OpJump(o) => { ip = o.target; },
            OpJumpIfFalse(o) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                var take: boolean = false;
                match (p.v) {
                    VBool(b) => { take = !b.v; },
                    _ => { return v_err("jump_if_false: not bool"); }
                }
                if (take) { ip = o.target; } else { ip = ip + 1; }
            },
            OpPop(_) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                ip = ip + 1;
            },
            OpCall(o) => {
                var fl: FuncLookup = lookup_func(funcs, o.name);
                if (!fl.ok) { return v_err("undefined function: " + o.name); }
                // Args sit on top of the stack — last pushed is
                // the deepest in callee-local order (the body's
                // OpStoreLocal sequence at function entry pops
                // them in reverse). Save current frame, allocate
                // a new locals vector sized to the callee.
                frames = frames.push(Frame { saved_ip: ip + 1, saved_locals: locals });
                locals = new_vm_locals(fl.locals_count);
                ip = fl.entry;
            },
            OpMakeArray(o) => {
                // Pop `n` values off the stack. They were
                // pushed in source order so the last-pushed
                // sits on top — walk down to build the array
                // bottom-up.
                if (len(stack) < o.n) { return v_err("make_array: stack underflow"); }
                var elems: Value[] = [];
                var start: i32 = len(stack) - o.n;
                var i: i32 = 0;
                while (i < o.n) {
                    elems = elems.push(stack[start + i]);
                    i = i + 1;
                }
                // Trim the popped values off the stack.
                var ns: Value[] = [];
                var j: i32 = 0;
                while (j < start) { ns = ns.push(stack[j]); j = j + 1; }
                stack = ns;
                stack = stack_push(stack, v_arr(elems));
                ip = ip + 1;
            },
            OpIndex(_) => {
                var pi: PopResult = stack_pop(stack); stack = pi.stack;
                var pa: PopResult = stack_pop(stack); stack = pa.stack;
                if (is_err(pi.v)) { stack = stack_push(stack, pi.v); ip = ip + 1; continue; }
                if (is_err(pa.v)) { stack = stack_push(stack, pa.v); ip = ip + 1; continue; }
                match (pa.v) {
                    VArr(arr) => {
                        match (pi.v) {
                            VInt(ii) => {
                                if (ii.v < 0 || ii.v >= len(arr.elements)) {
                                    stack = stack_push(stack, v_err("array index out of range"));
                                } else {
                                    stack = stack_push(stack, arr.elements[ii.v]);
                                }
                            },
                            _ => { stack = stack_push(stack, v_err("index: not i32")); }
                        }
                    },
                    VString(s) => {
                        // String indexing — same semantics as the
                        // interp + checker: byte at position
                        // returned as VInt(byte). Parity across
                        // both evaluators.
                        match (pi.v) {
                            VInt(ii) => {
                                if (ii.v < 0 || ii.v >= len(s.v)) {
                                    stack = stack_push(stack, v_err("string index out of range"));
                                } else {
                                    stack = stack_push(stack, v_int(s.v[ii.v]));
                                }
                            },
                            _ => { stack = stack_push(stack, v_err("index: not i32")); }
                        }
                    },
                    _ => { stack = stack_push(stack, v_err("index: receiver not array or string")); }
                }
                ip = ip + 1;
            },
            OpLen(_) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                if (is_err(p.v)) { stack = stack_push(stack, p.v); ip = ip + 1; continue; }
                match (p.v) {
                    VArr(a) => { stack = stack_push(stack, v_int(len(a.elements))); },
                    VString(s) => { stack = stack_push(stack, v_int(len(s.v))); },
                    _ => { stack = stack_push(stack, v_err("len: not array or string")); }
                }
                ip = ip + 1;
            },
            OpSlice(_) => {
                var pe: PopResult = stack_pop(stack); stack = pe.stack;
                var ps: PopResult = stack_pop(stack); stack = ps.stack;
                var pa: PopResult = stack_pop(stack); stack = pa.stack;
                if (is_err(pe.v)) { stack = stack_push(stack, pe.v); ip = ip + 1; continue; }
                if (is_err(ps.v)) { stack = stack_push(stack, ps.v); ip = ip + 1; continue; }
                if (is_err(pa.v)) { stack = stack_push(stack, pa.v); ip = ip + 1; continue; }
                var sb: i32 = 0;
                var eb: i32 = 0;
                match (ps.v) {
                    VInt(i) => { sb = i.v; },
                    _ => { stack = stack_push(stack, v_err("slice: start not i32")); ip = ip + 1; continue; }
                }
                match (pe.v) {
                    VInt(i) => { eb = i.v; },
                    _ => { stack = stack_push(stack, v_err("slice: end not i32")); ip = ip + 1; continue; }
                }
                match (pa.v) {
                    VArr(arr) => {
                        if (sb < 0 || eb > len(arr.elements) || sb > eb) {
                            stack = stack_push(stack, v_err("array slice out of range"));
                        } else {
                            var out: Value[] = [];
                            var i: i32 = sb;
                            while (i < eb) { out = out.push(arr.elements[i]); i = i + 1; }
                            stack = stack_push(stack, v_arr(out));
                        }
                    },
                    VString(s) => {
                        if (sb < 0 || eb > len(s.v) || sb > eb) {
                            stack = stack_push(stack, v_err("string slice out of range"));
                        } else {
                            stack = stack_push(stack, v_string(s.v[sb:eb]));
                        }
                    },
                    _ => { stack = stack_push(stack, v_err("slice: receiver not array or string")); }
                }
                ip = ip + 1;
            },
            OpMakeStruct(o) => {
                // Pop `len(field_names)` values in reverse so
                // the first field ends up at index 0. Build a
                // VStruct with the carried metadata.
                var nf: i32 = len(o.field_names);
                if (len(stack) < nf) {
                    stack = stack_push(stack, v_err("make_struct: stack underflow"));
                    ip = ip + 1;
                    continue;
                }
                var fvs: Value[] = [];
                var start: i32 = len(stack) - nf;
                var fi: i32 = 0;
                while (fi < nf) {
                    fvs = fvs.push(stack[start + fi]);
                    fi = fi + 1;
                }
                var ns: Value[] = [];
                var sj: i32 = 0;
                while (sj < start) { ns = ns.push(stack[sj]); sj = sj + 1; }
                stack = ns;
                stack = stack_push(stack, v_struct(o.type_name, o.field_names, fvs));
                ip = ip + 1;
            },
            OpFieldGet(o) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                if (is_err(p.v)) { stack = stack_push(stack, p.v); ip = ip + 1; continue; }
                match (p.v) {
                    VStruct(sv) => {
                        var found: boolean = false;
                        var fi: i32 = 0;
                        while (fi < len(sv.field_names) && !found) {
                            if (sv.field_names[fi] == o.field_name) {
                                stack = stack_push(stack, sv.field_values[fi]);
                                found = true;
                            }
                            fi = fi + 1;
                        }
                        if (!found) {
                            stack = stack_push(stack, v_err("struct " + sv.type_name + " has no field `" + o.field_name + "`"));
                        }
                    },
                    _ => { stack = stack_push(stack, v_err("field_get: receiver not a struct")); }
                }
                ip = ip + 1;
            },
            OpDup(_) => {
                if (len(stack) == 0) {
                    stack = stack_push(stack, v_err("dup: empty stack"));
                } else {
                    stack = stack_push(stack, stack[len(stack) - 1]);
                }
                ip = ip + 1;
            },
            OpTypeNameEq(o) => {
                var p: PopResult = stack_pop(stack); stack = p.stack;
                var matched: boolean = false;
                match (p.v) {
                    VStruct(sv) => { matched = (sv.type_name == o.type_name); },
                    _ => { matched = false; }
                }
                stack = stack_push(stack, v_bool(matched));
                ip = ip + 1;
            },
            OpReturn(_) => {
                if (len(stack) == 0) { return v_err("return: empty stack"); }
                var ret_val: Value = stack[len(stack) - 1];
                if (len(frames) == 0) {
                    // Top-level return — surface to caller.
                    return ret_val;
                }
                // Pop the active frame, restore caller's locals
                // + ip, leave the return value on the stack so
                // the caller's next op (typically an
                // OpStoreLocal or part of a larger expr) reads
                // it.
                var top_frame: Frame = frames[len(frames) - 1];
                var nf: Frame[] = [];
                var fi: i32 = 0;
                while (fi < len(frames) - 1) { nf = nf.push(frames[fi]); fi = fi + 1; }
                frames = nf;
                // stack: we want to discard everything below
                // the return value that was left behind by the
                // callee (the callee's locals-zone is already
                // gone with the locals swap, but the operand
                // stack may have unused work). For our compiler
                // every body ends with PUSH expr + RETURN, so
                // there's exactly the one return value on top.
                // No cleanup needed.
                locals = top_frame.saved_locals;
                ip = top_frame.saved_ip;
            }
        }
    }
    return v_err("ran past end of ops");
}

// Back-compat: exec(ops) for callers that don't have function
// decls. Builds an empty FuncTable so OpCall (if it ever
// appears) surfaces an "undefined function" VErr.
pub function exec(ops: Op[]): Value {
    var ns: string[] = [];
    var es: i32[] = [];
    var ls: i32[] = [];
    return exec_program(CompiledProgram {
        ops: ops,
        funcs: FuncTable { names: ns, entries: es, locals_counts: ls }
    });
}

// =================== DRIVER + VALIDATION ====================

function run_source(src: string): Value {
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    var ops: Op[] = compile_module(mod);
    return exec(ops);
}

// run_module compiles + executes a source that may declare
// functions. Threads the FuncTable through so OpCall resolves
// correctly. Used by the function-call validation cases below.
function run_module(src: string): Value {
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    return exec_program(compile_program(mod));
}

function main(): i32 {
    // Arithmetic + ident: var x = 7; var y = 9; return x + y;
    var r1: Value = run_source("var x = 1 + 2 * 3; var y = (1 + 2) * 3; return x + y;");
    match (r1) {
        VInt(i) => { if (i.v != 16) { return 10; } },
        _ => { return 11; }
    }

    // String concat: just confirm the program completes with
    // the right return value — the var binding is side-effect-
    // free.
    var r2: Value = run_source("var s = \"a\" + \"b\"; return 42;");
    match (r2) {
        VInt(i) => { if (i.v != 42) { return 20; } },
        _ => { return 21; }
    }

    // Comparison + unary `!`: return !true == false → false;
    // dressing it up: return (!(5 < 10));  → false.
    var r3: Value = run_source("return !(5 < 10);");
    match (r3) {
        VBool(b) => { if (b.v) { return 30; } },
        _ => { return 31; }
    }

    // If/else, then-branch taken.
    var r4: Value = run_source("var x = 5; if (x < 10) { return 1; } else { return 2; }");
    match (r4) {
        VInt(i) => { if (i.v != 1) { return 40; } },
        _ => { return 41; }
    }

    // If/else, else-branch taken.
    var r5: Value = run_source("var x = 20; if (x < 10) { return 1; } else { return 2; }");
    match (r5) {
        VInt(i) => { if (i.v != 2) { return 50; } },
        _ => { return 51; }
    }

    // No-else if: condition false, falls through to next stmt.
    var r6: Value = run_source("if (false) { return 7; } return 11;");
    match (r6) {
        VInt(i) => { if (i.v != 11) { return 60; } },
        _ => { return 61; }
    }

    // While loop counter: sum 1..=5 = 15.
    var r7: Value = run_source(
        "var i = 1; var s = 0; while (i <= 5) { s = s + i; i = i + 1; } return s;"
    );
    match (r7) {
        VInt(i) => { if (i.v != 15) { return 70; } },
        _ => { return 71; }
    }

    // Early return inside while short-circuits the loop.
    var r8: Value = run_source(
        "var i = 0; while (i < 10) { if (i == 3) { return i; } i = i + 1; } return 0 - 1;"
    );
    match (r8) {
        VInt(i) => { if (i.v != 3) { return 80; } },
        _ => { return 81; }
    }

    // Undefined-ident becomes VErr at runtime.
    var r9: Value = run_source("return missing;");
    match (r9) {
        VErr(_) => { },
        _ => { return 90; }
    }

    // Division by zero → VErr.
    var r10: Value = run_source("return 1 / 0;");
    match (r10) {
        VErr(_) => { },
        _ => { return 100; }
    }

    // Function decl + call: `add(2, 3) → 5`.
    var r11: Value = run_module(
        "function add(x: i32, y: i32): i32 { return x + y; } var k = add(2, 3); return k;"
    );
    match (r11) {
        VInt(i) => { if (i.v != 5) { return 110; } },
        _ => { return 111; }
    }

    // Recursive factorial via the VM. fact(5) = 120.
    var r12: Value = run_module(
        "function fact(n: i32): i32 { if (n <= 1) { return 1; } return n * fact(n - 1); } return fact(5);"
    );
    match (r12) {
        VInt(i) => { if (i.v != 120) { return 120; } },
        _ => { return 121; }
    }

    // Mutual recursion: is_even(4) → 1. Same fixture the
    // tree-walking interp validates.
    var r13: Value = run_module(
        "function is_even(n: i32): i32 { if (n == 0) { return 1; } return is_odd(n - 1); }"
