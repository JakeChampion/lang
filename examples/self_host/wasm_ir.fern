// str_replace_helper emits the IR-path $__fern_str_replace(h, old, new) — every
// non-overlapping occurrence of `old` in `h` replaced by `new` (empty `old` / no
// match → `h` unchanged). Two-pass (count, then exact-size build into a fresh
// $__fern_str_box), matching the register backends' __fern_str_replace. wasm's
// AST path has no replace, so this is IR-only. Gated on module_uses_str_replace.
pub function str_replace_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_replace (param $h i32) (param $old i32) (param $new i32) (result i32)\n";
    o = o + "    (local $lh i32) (local $lo i32) (local $ln i32) (local $cnt i32) (local $i i32) (local $j i32) (local $match i32) (local $total i32) (local $p i32) (local $w i32)\n";
    o = o + "    (local.set $lo (i32.load (local.get $old)))\n";
    o = o + "    (if (i32.eqz (local.get $lo)) (then (return (local.get $h))))\n";
    o = o + "    (local.set $lh (i32.load (local.get $h)))\n";
    o = o + "    (local.set $ln (i32.load (local.get $new)))\n";
    o = o + "    (local.set $cnt (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
