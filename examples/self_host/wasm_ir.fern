// arr_str_join_helper emits the IR-path $__fern_arr_str_join — the symbol
// irlower's lower_arr_str_join call_direct targets (register backends emit it as
// a Fern runtime fn). It is a thin shim over the shared $__fern_str_join worker
// (str_join_helper): the __fn_ stack ABI pushes param1 (sep) first then param0
// (xs) on top, so wasm's natural param binding lands them as (param0=sep,
// param1=xs); the shim reorders to the worker's (array, sep). Gated on
// @uses_arr_str_join in emit_ir_module_units.
pub function arr_str_join_helper(): string {
    var o: string = str_join_helper();
    o = o + "  (func $__fern_arr_str_join (param $sep i32) (param $xs i32) (result i32)\n";
    o = o + "    (call $__fern_str_join (local.get $xs) (local.get $sep)))\n";
    return o;
}

// arr_str_index_of_helper emits the IR-path $__fern_arr_str_index_of — the
// symbol irlower's string[] index_of / contains intercept targets (the register
// backends compile asmcore.rt_src_arr_str_index_of from Fern source; wasm has no
// such mechanism, hence this WAT twin of arr_i32_helpers' i32 scan). Content
// equality via $__fern_streq, so two distinct string blocks holding the same
// bytes match — the whole reason string arrays cannot reuse the i32 helper's
// pointer compare. Not found is -1, matching the Fern source; `contains` is the
// `>= 0` test irlower emits around the result. Parameter order is (target, xs)
// for the reason arr_i32_helpers documents: irlower pushes the argument first,
// and a wasm `call` binds the first-pushed value to param 0. Gated on
// @uses_arr_str_index_of; $__fern_streq comes from strcat_streq_helpers, which
// module_uses_strings pulls in for exactly this call.
pub function arr_str_index_of_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_str_index_of (param $t i32) (param $a i32) (result i32)\n";
    o = o + "    (local $n i32) (local $i i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $a)))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (if (call $__fern_streq (i32.load (i32.add (local.get $a) (i32.add (i32.const 8) (i32.mul (local.get $i) (i32.const 4))))) (local.get $t))\n";
    o = o + "        (then (return (local.get $i))))\n";
