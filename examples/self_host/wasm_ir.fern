    // above, these come from the module's declarations, not from `needs`.
    if (module_has_extern_composite_result(mod) || export_needs_realloc(mod) || need(needs, "wasm_poll") || need(needs, "tcp_recv") || need(needs, "poll") || need(needs, "tcp_send") || need(needs, "udp_send") || (mode == 2 && (need(needs, "env") || need(needs, "args") || need(needs, "arg_at") || need(needs, "read_file") || need(needs, "write_file")))) { out = out + cabi_realloc_helper(); }
