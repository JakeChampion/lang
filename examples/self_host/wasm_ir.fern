// examples/self_host/wasm_ir.fern — the WebAssembly instruction-selector for
// the target-agnostic stack IR (irlower.fern's Op[]). The wasm sibling of
// asm_ir / asm_arm64_ir: it lowers the SAME lowered op stream to textual WAT.
//
// wasm is the most natural target of the three: the IR is a stack machine with
// structured control flow (block / loop / if / else / end / br / br_if) and
// wasm IS that machine, so the lowering is a near-direct transliteration to
// FLAT WAT instructions — const_i32 -> i32.const, load_local i -> local.get i,
// add -> i32.add, the structured ops keep their names, and `br depth` /
// `br_if depth` carry the SAME relative depth the IR already encodes (no label
// generation). A user `call` needs no arg reversal either: the IR pushes args
// arg0-deepest and wasm's `call` consumes them arg0-deepest.
//
// Arrays use wasm's linear-memory layout (matching wasm.fern's __fern_arr_box:
// a = base+8, so rc@[a-8], len@[a], cap@[a+4], element i @ [a+8+i*4], 4-byte
// stride) and reuse wasm.fern's heap/RC runtime verbatim (heap_alloc_helpers +
// rc_runtime_helpers — the size-class freelist allocator, __fern_arr_box,
// __fern_arr_dec, and the rc inc/dec helpers). The Perceus array RC (alias-inc,
// move-on-return, exit dec-sweep, reassignment retain/cow-release) all comes
// from irlower's shared lowering, so wasm gets it for free — the helper calls
// lower to `call $__fern_rc_inc` / `call $__fern_arr_dec`.
//
// Like asm_ir, this is a SEPARATE module imported only by its differential
// driver (wasm_ir_run) — wasm.fern stays untouched until a later fold/flip.

import "./parser";
import "./util";
import "./ir";
import "./irlower";
import "./asm_ir";
import "./asmcore";

// Linear-memory layout for the no-string array subset, computed exactly as
// wasm.emit_module does for an empty string table (tab.next = 24, heap_extra =
// 0): fl_base = roundup8(24 + 16) = 40, the 65536-class freelist, then the
// bump heap at heap_base. heap_base is also the rc helpers' low-address guard.
pub function fl_base(): i32 { return 40; }
pub function fl_cells(): i32 { return 65536; }
pub function heap_base(): i32 { return 40 + 65536 * 4; }

// wasm_binop renders the wasm instruction for one IR i32 binary op. 64-bit
// values never appear in the i32 subset, so every op is the i32.* form.
function wasm_binop(kind: string): string {
    if (kind == "add") { return "i32.add"; }
    if (kind == "sub") { return "i32.sub"; }
    if (kind == "mul") { return "i32.mul"; }
    // Non-trapping div/rem, matching wasm.fern's AST path: x/0 = 0, x%0 = x,
    // INT_MIN/-1 = INT_MIN (wasm's native i32.div_s / i32.rem_s TRAP on those).
    // The helpers ($__fern_idiv / $__fern_irem) are emitted when the module
    // uses div/rem (module_uses_divrem). As a flat instruction the operands are
    // prior on the stack, so `call` consumes them exactly like the op would.
    if (kind == "div_s") { return "call $__fern_idiv"; }
    if (kind == "rem_s") { return "call $__fern_irem"; }
    if (kind == "and") { return "i32.and"; }
    if (kind == "or") { return "i32.or"; }
    if (kind == "xor") { return "i32.xor"; }
    if (kind == "shl") { return "i32.shl"; }
    if (kind == "shr_s") { return "i32.shr_s"; }
    if (kind == "eq") { return "i32.eq"; }
    if (kind == "ne") { return "i32.ne"; }
    if (kind == "lt_s") { return "i32.lt_s"; }
    if (kind == "le_s") { return "i32.le_s"; }
    if (kind == "gt_s") { return "i32.gt_s"; }
    if (kind == "ge_s") { return "i32.ge_s"; }
    return ";; ir: unsupported bin " + kind + "\n";
}

// wasm_helper_symbol maps an IR runtime-helper name to the wasm.fern symbol the
// IR path calls. The exit-sweep / reassign release (__fern_rc_dec) maps to
// $__fern_arr_dec (the array release that frees at rc==1 via the size-class
// freelist), so the wasm IR path reclaims exactly as wasm.fern's AST path.
function wasm_helper_symbol(name: string): string {
    if (name == "__fern_rc_inc") { return "$__fern_rc_inc"; }
    if (name == "__fern_rc_dec") { return "$__fern_arr_dec"; }
    if (name == "__fern_rc_underflow_get") { return "$__fern_rc_underflow_count"; }
    return "$" + name;
}

// module_allocates reports whether any function uses an array/alloc op (so the
// heap + RC runtime needs emitting).
pub function module_allocates(mod: parser.Module): boolean {
    var noret: string[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var r: irlower.LowerResult = irlower.lower_func(mod.funcs[fi], noret);
        var i: i32 = 0;
        while (i < r.ops.len()) {
            var k: string = r.ops[i].kind;
            if (k == "arr_make" || k == "alloc") { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_divrem reports whether any function uses i32 div/rem (so the
// non-trapping $__fern_idiv / $__fern_irem helpers need emitting).
pub function module_uses_divrem(mod: parser.Module): boolean {
    var noret: string[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var r: irlower.LowerResult = irlower.lower_func(mod.funcs[fi], noret);
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind == "div_s" || r.ops[i].kind == "rem_s") { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// wasm_eligible: the whole module is in the IR's i32 + arrays subset (the same
// backend-independent gate the asm backends use — rejects non-lowerable
// functions and builtin calls). wasm covers everything that gate admits.
pub function wasm_eligible(mod: parser.Module): boolean {
    return asm_ir.all_eligible(mod);
}

// should_use_ir: the use_ir default is on AND the module is eligible — the
// dispatch wasm.emit_module consults to route eligible modules through the IR.
pub function should_use_ir(mod: parser.Module): boolean {
    return asmcore.new_state().use_ir && asm_ir.all_eligible(mod);
}

// emit_function_ir renders one IR-eligible function as a WAT (func ...). Locals
// are numeric: slots 0..n_params-1 the params, n_params..n_locals-1 the body
// locals, plus TWO scratch locals (indices n_locals, n_locals+1) the array ops
// use to hold a base pointer / popped element while reordering the wasm stack.
function emit_function_ir(fd: parser.FuncDecl): string {
    var noret: string[] = [];
    var r: irlower.LowerResult = irlower.lower_func(fd, noret);
    var arrtmp: i32 = r.n_locals;
    var eltmp: i32 = r.n_locals + 1;
    var out: string = "  (func $" + fd.name;
    var p: i32 = 0;
    while (p < r.n_params) {
        out = out + " (param i32)";
        p = p + 1;
    }
    out = out + " (result i32)\n";
    // body locals + 2 array scratch locals
    var nloc: i32 = (r.n_locals - r.n_params) + 2;
    out = out + "    (local";
    var l: i32 = 0;
    while (l < nloc) {
        out = out + " i32";
        l = l + 1;
    }
    out = out + ")\n";
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind == "const_i32") {
            out = out + "    i32.const " + util.i32_to_string(o.i32_imm) + "\n";
        } else if (o.kind == "load_local") {
            out = out + "    local.get " + util.i32_to_string(o.i32_imm) + "\n";
        } else if (o.kind == "store_local") {
            out = out + "    local.set " + util.i32_to_string(o.i32_imm) + "\n";
        } else if (o.kind == "not") {
            out = out + "    i32.eqz\n";
        } else if (o.kind == "return") {
            out = out + "    return\n";
        } else if (o.kind == "if") {
            out = out + "    if\n";
        } else if (o.kind == "else") {
            out = out + "    else\n";
        } else if (o.kind == "block") {
            out = out + "    block\n";
        } else if (o.kind == "loop") {
            out = out + "    loop\n";
        } else if (o.kind == "end") {
            out = out + "    end\n";
        } else if (o.kind == "br") {
            out = out + "    br " + util.i32_to_string(o.i32_imm) + "\n";
        } else if (o.kind == "brif") {
            out = out + "    br_if " + util.i32_to_string(o.i32_imm) + "\n";
        } else if (o.kind == "drop") {
            out = out + "    drop\n";
        } else if (o.kind == "arr_make") {
            // n element values on the wasm stack (element n-1 on top).
            // __fern_arr_box(n*4) -> a; store len@a, cap@a+4, then the
            // elements at a+8+i*4 (top-down, popping each into $eltmp so the
            // i32.store sees [addr, value]). $arrtmp holds a across the pops.
            var n: i32 = o.i32_imm;
            out = out + "    i32.const " + util.i32_to_string(n * 4) + "\n    call $__fern_arr_box\n    local.set " + util.i32_to_string(arrtmp) + "\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(n) + "\n    i32.store\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 4\n    i32.add\n    i32.const " + util.i32_to_string(n) + "\n    i32.store\n";
            var em: i32 = n - 1;
            while (em >= 0) {
                out = out + "    local.set " + util.i32_to_string(eltmp) + "\n";
                out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(8 + em * 4) + "\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n";
                em = em - 1;
            }
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n";
        } else if (o.kind == "arr_get") {
            // stack: base, idx -> i32.load(base + 8 + idx*4)
            out = out + "    i32.const 4\n    i32.mul\n    i32.const 8\n    i32.add\n    i32.add\n    i32.load\n";
        } else if (o.kind == "arr_set") {
            // stack: base, idx, val -> store val at base+8+idx*4
            out = out + "    local.set " + util.i32_to_string(eltmp) + "\n    i32.const 4\n    i32.mul\n    i32.const 8\n    i32.add\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n";
        } else if (o.kind == "arr_len") {
            // stack: base -> i32.load(base)  (len @ a+0)
            out = out + "    i32.load\n";
        } else if (o.kind == "arr_rc") {
            // stack: base -> i32.load(base - 8)  (rc @ a-8)
            out = out + "    i32.const 8\n    i32.sub\n    i32.load\n";
        } else if (o.kind == "call_direct" && asm_ir.is_fern_helper(o.str)) {
            // Runtime RC helper: the arg is already on the wasm stack; the
            // helper takes it as a param and returns the ptr / count.
            out = out + "    call " + wasm_helper_symbol(o.str) + "\n";
        } else if (o.kind == "call_direct") {
            out = out + "    call $" + o.str + "\n";
        } else {
            out = out + "    " + wasm_binop(o.kind) + "\n";
        }
        i = i + 1;
    }
    // Fallthrough result for (result i32). Subset functions end in `return`, so
    // this lands in the unreachable continuation (accepted by wasm's
    // stack-polymorphic typing) and never actually runs.
    out = out + "    i32.const 0)\n";
    return out;
}

// emit_functions renders the user functions of an all-eligible module as WAT
// (func ...) blocks — and ONLY the functions. The module wrapper (imports +
// memory), the heap/RC runtime (heap_alloc_helpers + rc_runtime_helpers, which
// live in wasm.fern), and the `_start` + exports are emitted by the CALLER
// (wasm.emit_module, or the differential driver). Keeping the runtime on the
// caller side lets wasm.fern import this module for the use_ir dispatch without
// a cycle: wasm_ir never imports wasm. Caller must ensure wasm_eligible(mod).
pub function emit_functions(mod: parser.Module): string {
    var out: string = "";
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        out = out + emit_function_ir(mod.funcs[fi]);
        fi = fi + 1;
    }
    return out;
}
