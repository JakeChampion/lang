    // module — op_allocates admits "args"). Emitted when the module reads argv.
    if (mode != 2 && need(needs, "args")) { out = out + args_func(); }
    // $__fern_arg_at(i) copies just argv[i] into a fresh string block, sharing
    // the args imports above. Independent of the args need — a module can read
    // one argument without ever materialising the whole vector.
    if (mode != 2 && need(needs, "arg_at")) { out = out + arg_at_func(); }
    // $__fern_env(name): scan the environ vector for `NAME=`, box an
    // Option[string] (Some(value)/None). Heap-backed (allocates the value +
    // box), so the heap gate above folds env in.
    if (mode != 2 && need(needs, "env")) { out = out + env_func(); }
    // $__fern_build_io_error(errno, path): map a WASI errno to a real
    // IoError variant box, shared by every fs helper's error path (the wasm
    // sibling of native wasmbin's __build_io_error / asm_ir's
    // __fern_io_error). Emit it once whenever any fs op is present so the
    // helpers' Err/Some payloads carry a matchable variant, not a raw errno.
    if (need(needs, "stat") || need(needs, "remove_file") || need(needs, "read_dir") || need(needs, "remove_dir_all") || need(needs, "temp_dir") || need(needs, "read_file") || need(needs, "write_file")) { out = out + build_io_error_func(8); }
    // $__fern_stat(path, fstype): path_filestat_get -> FileStat struct +
    // Result box. Heap-backed (allocates the buffer + boxes), so folded into
    // the heap gate above.
    if (need(needs, "stat")) { out = out + stat_func(); }
    // $__fern_remove_file(path): path_unlink_file -> Result[(), IoError] box.
    // Heap-backed (allocates the box), so folded into the heap gate above.
    if (need(needs, "remove_file")) { out = out + remove_file_func(); }
    // $__fern_read_dir(path): path_open + fd_readdir loop -> Result[string[],
