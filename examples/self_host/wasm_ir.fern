    o = o + "    (local $buf i32) (local $nread i32) (local $len i32) (local $blk i32) (local $i i32) (local $opt i32)\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.const 256)))\n";
    o = o + "    (i32.store (i32.const 0) (local.get $buf))\n";
    o = o + "    (i32.store (i32.const 4) (i32.const 256))\n";
    o = o + "    (drop (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "    (local.set $nread (i32.load (i32.const 8)))\n";
    o = o + "    (if (i32.eqz (local.get $nread)) (then\n";
    o = o + "      (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $opt) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $opt) (i32.const 4)) (i32.const 0))\n";
    o = o + "      (return (local.get $opt))))\n";
    o = o + "    (local.set $len (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $len) (local.get $nread)))\n";
    o = o + "      (br_if $d (i32.eq (i32.load8_u (i32.add (local.get $buf) (local.get $len))) (i32.const 10)))\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (if (i32.lt_u (local.get $len) (local.get $nread)) (then\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))))\n";
    o = o + "    (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $len))\n";
