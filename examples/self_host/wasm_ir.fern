    if (need(needs, "tcp_send")) { out = out + tcp_send_func(); }
    if (need(needs, "tcp_recv")) { out = out + tcp_recv_func(); }
    if (need(needs, "tcp_listen")) { out = out + tcp_listen_func(); }
