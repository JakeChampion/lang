    o = o + "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (local.get $w) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $elem) (i32.const 4)) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
