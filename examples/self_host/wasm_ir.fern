    o = o + "        (br_if $dm (i32.ge_s (local.get $j) (local.get $lo)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $old) (i32.const 4)) (local.get $j)))) (then (local.set $match (i32.const 0)) (br $dm)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cm)))\n";
    o = o + "      (if (local.get $match) (then (local.set $cnt (i32.add (local.get $cnt) (i32.const 1))) (local.set $i (i32.add (local.get $i) (local.get $lo)))) (else (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n";
    o = o + "      (br $cc)))\n";
    o = o + "    (if (i32.eqz (local.get $cnt)) (then (return (local.get $h))))\n";
    o = o + "    (local.set $total (i32.add (local.get $lh) (i32.mul (local.get $cnt) (i32.sub (local.get $ln) (local.get $lo)))))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $total))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $total))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (local.set $w (i32.const 0))\n";
    o = o + "    (block $dw (loop $cw\n";
    o = o + "      (br_if $dw (i32.gt_s (i32.add (local.get $i) (local.get $lo)) (local.get $lh)))\n";
    o = o + "      (local.set $match (i32.const 1))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $dm2 (loop $cm2\n";
    o = o + "        (br_if $dm2 (i32.ge_s (local.get $j) (local.get $lo)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $h) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $old) (i32.const 4)) (local.get $j)))) (then (local.set $match (i32.const 0)) (br $dm2)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cm2)))\n";
    o = o + "      (if (local.get $match) (then\n";
