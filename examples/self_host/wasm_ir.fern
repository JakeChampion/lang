// str_to_i32_helper emits $__fern_str_to_i32: parse a `[len@0][bytes@4]` string
// strbuf_helpers emits the wasm global string-builder runtime (strbuf_reset /
// strbuf_append / strbuf_take) — the wasm sibling of asm_ir's __fern_strbuf_*
// (asm_ir.fern, a .bss buffer). The wasm AST backend never had strbuf, so this
// is authored fresh and the IR path is its only consumer. A growable byte buffer
// lives in the bump heap: $__fern_strbuf_ptr / _len / _cap track it; ensure()
// doubles the capacity (alloc a bigger block + copy, the old one leaks into the
// bump heap, matching the bump-heap norm) when an append would overflow. append
// copies a wasm string's bytes ([s+4 .. s+4+[s]]) onto the buffer; take snapshots
// the buffer into a fresh rc-boxed string ($__fern_str_box: [s]=len, bytes@[s+4])
// and resets len to 0. Heap-backed (str_box / alloc), so emitted only with the
// heap runtime (module_uses_strbuf folds into the heap gate).
pub function strbuf_helpers(): string {
    var o: string = "";
    o = o + "  (global $__fern_strbuf_ptr (mut i32) (i32.const 0))\n";
    o = o + "  (global $__fern_strbuf_len (mut i32) (i32.const 0))\n";
    o = o + "  (global $__fern_strbuf_cap (mut i32) (i32.const 0))\n";
    // reset: clear length (the buffer + capacity persist for reuse).
    o = o + "  (func $__fern_strbuf_reset\n";
    o = o + "    (global.set $__fern_strbuf_len (i32.const 0)))\n";
    // ensure(need): grow the buffer to hold at least `need` total bytes.
    o = o + "  (func $__fern_strbuf_ensure (param $need i32)\n";
    o = o + "    (local $ncap i32) (local $np i32) (local $i i32)\n";
    o = o + "    (if (i32.le_u (local.get $need) (global.get $__fern_strbuf_cap)) (then (return)))\n";
    o = o + "    (local.set $ncap (global.get $__fern_strbuf_cap))\n";
    o = o + "    (if (i32.eqz (local.get $ncap)) (then (local.set $ncap (i32.const 256))))\n";
    o = o + "    (block $gd (loop $gl (br_if $gd (i32.ge_u (local.get $ncap) (local.get $need))) (local.set $ncap (i32.mul (local.get $ncap) (i32.const 2))) (br $gl)))\n";
    o = o + "    (local.set $np (call $__fern_alloc (local.get $ncap)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $cd (loop $cl (br_if $cd (i32.ge_u (local.get $i) (global.get $__fern_strbuf_len)))\n";
    o = o + "      (i32.store8 (i32.add (local.get $np) (local.get $i)) (i32.load8_u (i32.add (global.get $__fern_strbuf_ptr) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $cl)))\n";
    o = o + "    (global.set $__fern_strbuf_ptr (local.get $np))\n";
    o = o + "    (global.set $__fern_strbuf_cap (local.get $ncap)))\n";
    // append(s): copy wasm string s's bytes ([s]=len, bytes@[s+4]) onto the buffer.
    o = o + "  (func $__fern_strbuf_append (param $s i32)\n";
    o = o + "    (local $sl i32) (local $i i32) (local $d i32)\n";
    o = o + "    (local.set $sl (i32.load (local.get $s)))\n";
    o = o + "    (call $__fern_strbuf_ensure (i32.add (global.get $__fern_strbuf_len) (local.get $sl)))\n";
    o = o + "    (local.set $d (i32.add (global.get $__fern_strbuf_ptr) (global.get $__fern_strbuf_len)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $ad (loop $al (br_if $ad (i32.ge_u (local.get $i) (local.get $sl)))\n";
    o = o + "      (i32.store8 (i32.add (local.get $d) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $al)))\n";
    o = o + "    (global.set $__fern_strbuf_len (i32.add (global.get $__fern_strbuf_len) (local.get $sl))))\n";
    // take(): snapshot the buffer into a fresh rc-boxed string, reset len to 0.
    o = o + "  (func $__fern_strbuf_take (result i32)\n";
    o = o + "    (local $len i32) (local $box i32) (local $i i32)\n";
    o = o + "    (local.set $len (global.get $__fern_strbuf_len))\n";
    o = o + "    (local.set $box (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $box) (local.get $len))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $td (loop $tl (br_if $td (i32.ge_u (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $box) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (global.get $__fern_strbuf_ptr) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $tl)))\n";
    o = o + "    (global.set $__fern_strbuf_len (i32.const 0))\n";
    o = o + "    (local.get $box))\n";
    return o;
}
// chr_helper emits $__fern_chr: an i32 byte value to a fresh 1-char
// `[len@0][bytes@4]` string block (len 1, the low byte at +4). The wasm
// companion to asm_ir's __fn___fern_chr (the wasm AST backend had no chr, so
// this is authored fresh). Depends on $__fern_alloc (module_allocates is pulled
// in by the chr gate alongside this).
pub function chr_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_chr (param $n i32) (result i32)\n";
    o = o + "    (local $blk i32)\n";
    // rc-header the 1-char block via $__fern_str_box (like every other heap
    // string), so a fresh non-escaping `chr(..)` local is reclaimable through
    // $__fern_arr_dec (#2649). The header is transparent to consumers: the block
    // still exposes [len@0][bytes@4] at the returned pointer.
    o = o + "    (local.set $blk (call $__fern_str_box (i32.const 5)))\n";
    o = o + "    (i32.store (local.get $blk) (i32.const 1))\n";
    o = o + "    (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.get $blk))\n";
    return o;
}

// divrem_helpers returns the WAT for the guarded div/rem helpers. The
// divisor is sanitised to 1 whenever the real divisor would fault (== 0,
// or the signed INT_MIN / -1 overflow): `a / 1 = a = INT_MIN` gives the
// right overflow quotient and `a % 1 = 0` the right overflow remainder.
// A final `select` substitutes the divide-by-zero answer (0 for div, the
// dividend for rem). Mirrors internal/codegen/wasmbin/runtime.go.
pub function divrem_helpers(): string {
    var bad: string =
        "(i32.or (i32.eqz (local.get $b))"
        + " (i32.and (i32.eq (local.get $a) (i32.const -2147483648))"
        + " (i32.eq (local.get $b) (i32.const -1))))";
    var out: string = "";
    out = out + "  (func $__fern_idiv (param $a i32) (param $b i32) (result i32)\n";
    out = out + "    (local $safe i32)\n";
    out = out + "    (local.set $safe (select (i32.const 1) (local.get $b) " + bad + "))\n";
    out = out + "    (select (i32.const 0) (i32.div_s (local.get $a) (local.get $safe)) (i32.eqz (local.get $b))))\n";
    out = out + "  (func $__fern_irem (param $a i32) (param $b i32) (result i32)\n";
    out = out + "    (local $safe i32)\n";
    out = out + "    (local.set $safe (select (i32.const 1) (local.get $b) " + bad + "))\n";
    out = out + "    (select (local.get $a) (i32.rem_s (local.get $a) (local.get $safe)) (i32.eqz (local.get $b))))\n";
    return out;
}
// The integer→string runtime backing `(n).to_string()` (and so an f-string
// interpolant, which desugars to it): format an i32 / i64 / u64 into a fresh
// `[len][bytes]` heap block, rc-headered by $__fern_str_box.
//
// to_string_helpers is the AST emitter's bundle (i32 + i64, emitted together on
// one `.to_string()` gate); the IR path emits each body on its own need
// (@uses_i32_to_string / @uses_i64_to_string / @uses_u64_to_string), so an
// i64-only module carries no dead i32 formatter.
pub function to_string_helpers(): string {
    return i32_to_string_helper() + i64_to_string_helper();
}
pub function i32_to_string_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_i32_to_str (param $n i32) (result i32)\n";
    o = o + "    (local $neg i32) (local $mag i32) (local $len i32) (local $blk i32) (local $p i32)\n";
    o = o + "    (if (i32.eqz (local.get $n)) (then\n";
    // rc-header the "0" block via $__fern_str_box like the general path below, so
    // a fresh `i32_to_string(0)` local is reclaimable through $__fern_arr_dec
    // (#2649) — previously this branch alone returned a header-less block, which
    // a string reclaim would mis-free.
    o = o + "      (local.set $blk (call $__fern_str_box (i32.const 5)))\n";
    o = o + "      (i32.store (local.get $blk) (i32.const 1))\n";
    o = o + "      (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 48))\n";
    o = o + "      (return (local.get $blk))))\n";
    o = o + "    (local.set $neg (i32.lt_s (local.get $n) (i32.const 0)))\n";
    o = o + "    (local.set $mag (local.get $n))\n";
    o = o + "    (if (local.get $neg) (then (local.set $mag (i32.sub (i32.const 0) (local.get $n)))))\n";
    o = o + "    (local.set $len (i32.const 0))\n";
    o = o + "    (local.set $p (local.get $mag))\n";
    o = o + "    (block $cd (loop $cl\n";
    o = o + "      (br_if $cd (i32.eqz (local.get $p)))\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (local.set $p (i32.div_u (local.get $p) (i32.const 10)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (if (local.get $neg) (then (local.set $len (i32.add (local.get $len) (i32.const 1)))))\n";
    o = o + "    (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "    (local.set $p (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $len)))\n";
    o = o + "    (block $fd (loop $fl\n";
    o = o + "      (br_if $fd (i32.eqz (local.get $mag)))\n";
    o = o + "      (local.set $p (i32.sub (local.get $p) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $p) (i32.add (i32.const 48) (i32.rem_u (local.get $mag) (i32.const 10))))\n";
    o = o + "      (local.set $mag (i32.div_u (local.get $mag) (i32.const 10)))\n";
    o = o + "      (br $fl)))\n";
    o = o + "    (if (local.get $neg) (then (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 45))))\n";
    o = o + "    (local.get $blk))\n";
    return o;
}
// i64 variant (mag / digit math in i64; addresses + length stay i32). The
// magnitude runs through i64.div_u / i64.rem_u, so INT64_MIN — whose negation
// overflows back to itself — still renders its exact 9223372036854775808
// digits.
pub function i64_to_string_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_i64_to_str (param $n i64) (result i32)\n";
    o = o + "    (local $neg i32) (local $mag i64) (local $len i32) (local $blk i32) (local $p i32)\n";
    o = o + "    (if (i64.eqz (local.get $n)) (then\n";
    o = o + "      (local.set $blk (call $__fern_str_box (i32.const 5)))\n";
    o = o + "      (i32.store (local.get $blk) (i32.const 1))\n";
    o = o + "      (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 48))\n";
    o = o + "      (return (local.get $blk))))\n";
    o = o + "    (local.set $neg (i64.lt_s (local.get $n) (i64.const 0)))\n";
    o = o + "    (local.set $mag (local.get $n))\n";
    o = o + "    (if (local.get $neg) (then (local.set $mag (i64.sub (i64.const 0) (local.get $n)))))\n";
    o = o + "    (local.set $len (i32.const 0))\n";
    o = o + "    (block $cd (loop $cl\n";
    o = o + "      (br_if $cd (i64.eqz (local.get $mag)))\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (local.set $mag (i64.div_u (local.get $mag) (i64.const 10)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (local.set $mag (local.get $n))\n";
    o = o + "    (if (local.get $neg) (then (local.set $mag (i64.sub (i64.const 0) (local.get $n))) (local.set $len (i32.add (local.get $len) (i32.const 1)))))\n";
    o = o + "    (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "    (local.set $p (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $len)))\n";
    o = o + "    (block $fd (loop $fl\n";
    o = o + "      (br_if $fd (i64.eqz (local.get $mag)))\n";
    o = o + "      (local.set $p (i32.sub (local.get $p) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $p) (i32.wrap_i64 (i64.add (i64.const 48) (i64.rem_u (local.get $mag) (i64.const 10)))))\n";
    o = o + "      (local.set $mag (i64.div_u (local.get $mag) (i64.const 10)))\n";
    o = o + "      (br $fl)))\n";
    o = o + "    (if (local.get $neg) (then (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 45))))\n";
    o = o + "    (local.get $blk))\n";
    return o;
}
// u64 variant: same digit loop with no sign branch, so a value with the high
// bit set renders as its unsigned magnitude (18446744073709551615) rather than
// the -1 the signed formatter would print.
// u32_to_string_helper serves `(u32).to_string()` by zero-extending into the
// u64 formatter. Zero-extension is the whole point: i64.extend_i32_s would make
// a bit-31-set u32 print as a negative number, the same signedness trap that
// made `u32 as f64` wrong (#5992).
pub function u32_to_string_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_u32_to_str (param $n i32) (result i32)\n";
    o = o + "    (call $__fern_u64_to_str (i64.extend_i32_u (local.get $n))))\n";
    return o;
}

pub function u64_to_string_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_u64_to_str (param $n i64) (result i32)\n";
    o = o + "    (local $mag i64) (local $len i32) (local $blk i32) (local $p i32)\n";
    o = o + "    (if (i64.eqz (local.get $n)) (then\n";
    o = o + "      (local.set $blk (call $__fern_str_box (i32.const 5)))\n";
    o = o + "      (i32.store (local.get $blk) (i32.const 1))\n";
    o = o + "      (i32.store8 (i32.add (local.get $blk) (i32.const 4)) (i32.const 48))\n";
    o = o + "      (return (local.get $blk))))\n";
    o = o + "    (local.set $len (i32.const 0))\n";
    o = o + "    (local.set $mag (local.get $n))\n";
    o = o + "    (block $cd (loop $cl\n";
    o = o + "      (br_if $cd (i64.eqz (local.get $mag)))\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (local.set $mag (i64.div_u (local.get $mag) (i64.const 10)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (local.set $mag (local.get $n))\n";
    o = o + "    (local.set $blk (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "    (local.set $p (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $len)))\n";
    o = o + "    (block $fd (loop $fl\n";
    o = o + "      (br_if $fd (i64.eqz (local.get $mag)))\n";
    o = o + "      (local.set $p (i32.sub (local.get $p) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $p) (i32.wrap_i64 (i64.add (i64.const 48) (i64.rem_u (local.get $mag) (i64.const 10)))))\n";
    o = o + "      (local.set $mag (i64.div_u (local.get $mag) (i64.const 10)))\n";
    o = o + "      (br $fl)))\n";
    o = o + "    (local.get $blk))\n";
    return o;
}
// string_from_bytes_helper emits $__fern_string_from_bytes(arr): pack a u8[]
// (an i32[] array block `[len][cap][bytes-as-i32]`) into a fresh `[len][bytes]`
// string block, truncating each i32 element to its low byte via i32.store8.
// Depends on $__fern_alloc from heap_alloc_helpers.
pub function string_from_bytes_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_string_from_bytes (param $arr i32) (result i32)\n";
    o = o + "    (local $n i32) (local $s i32) (local $i i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $arr)))\n";
    o = o + "    (local.set $s (call $__fern_str_box (i32.add (i32.const 4) (local.get $n))))\n";
    o = o + "    (i32.store (local.get $s) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i)) (i32.load (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $s))\n";
    return o;
}
pub function strcat_streq_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_strcat (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $lb i32) (local $p i32) (local $i i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (local.set $lb (i32.load (local.get $b)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (i32.add (local.get $la) (local.get $lb)))))\n";
    o = o + "    (i32.store (local.get $p) (i32.add (local.get $la) (local.get $lb)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $da (loop $ca\n";
    o = o + "      (br_if $da (i32.ge_u (local.get $i) (local.get $la)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $ca)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $db (loop $cb\n";
    o = o + "      (br_if $db (i32.ge_u (local.get $i) (local.get $lb)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $la)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $b) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cb)))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_streq(a, b): 1 if the two string blocks are byte-equal.
    o = o + "  (func $__fern_streq (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $i i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (if (i32.ne (local.get $la) (i32.load (local.get $b))) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $la)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $i))) (i32.load8_u (i32.add (i32.add (local.get $b) (i32.const 4)) (local.get $i)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.const 1))\n";
    return o;
}

// clock_funcs emits the i64 clock builtins. clock_time_get(clockid,
// precision, out) writes an 8-byte nanosecond timestamp at `out`; we
// reuse the 8-byte scratch at addr 16 (write-then-load, no concurrent
// use). now_unix_ms = realtime ns / 1_000_000; monotonic_ns = the raw
// monotonic clock; now_ns = the raw realtime clock.
pub function clock_funcs(): string {
    var o: string = "";
    o = o + "  (func $__fern_now_ns (result i64)\n";
    o = o + "    (drop (call $clock_time_get (i32.const 0) (i64.const 1000) (i32.const 16)))\n";
    o = o + "    (i64.load (i32.const 16)))\n";
    o = o + "  (func $__fern_now_unix_ms (result i64)\n";
    o = o + "    (drop (call $clock_time_get (i32.const 0) (i64.const 1000) (i32.const 16)))\n";
    o = o + "    (i64.div_u (i64.load (i32.const 16)) (i64.const 1000000)))\n";
    o = o + "  (func $__fern_monotonic_ns (result i64)\n";
    o = o + "    (drop (call $clock_time_get (i32.const 1) (i64.const 1000) (i32.const 16)))\n";
    o = o + "    (i64.load (i32.const 16)))\n";
    return o;
}
// env_helpers emits the wasi environ imports + $__fern_env(name): the
// preview-1 two-call environ pattern (sizes_get then get) into bump-heap
// scratch, a linear scan for a `NAME=` entry, and an Option[string] tag
// box result (Some(value) / None). Value bytes are copied into a fresh
// string block. Uses the iovec scratch (addr 0 / 4) for the two sizes —
// safe because env() completes before any write/print reuses them.
pub function env_helpers(): string {
    var o: string = "";
    o = o + "  (import \"wasi_snapshot_preview1\" \"environ_sizes_get\" (func $environ_sizes_get (param i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"environ_get\" (func $environ_get (param i32 i32) (result i32)))\n";
    return o;
}
// env_func emits the $__fern_env body (separate from env_helpers so the
// imports can be placed in the import section, before functions).
pub function env_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_env (param $np i32) (result i32)\n";
    o = o + "    (local $count i32) (local $bufsz i32) (local $ptrs i32) (local $buf i32)\n";
    o = o + "    (local $nlen i32) (local $i i32) (local $e i32) (local $j i32) (local $ok i32)\n";
    o = o + "    (local $vstart i32) (local $vlen i32) (local $res i32) (local $tmp i32)\n";
    o = o + "    (local.set $nlen (i32.load (local.get $np)))\n";
    o = o + "    (drop (call $environ_sizes_get (i32.const 0) (i32.const 4)))\n";
    o = o + "    (local.set $count (i32.load (i32.const 0)))\n";
    o = o + "    (local.set $bufsz (i32.load (i32.const 4)))\n";
    o = o + "    (local.set $ptrs (call $__fern_alloc (i32.mul (local.get $count) (i32.const 4))))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (local.get $bufsz)))\n";
    o = o + "    (drop (call $environ_get (local.get $ptrs) (local.get $buf)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $done (loop $cont\n";
    o = o + "      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))\n";
    o = o + "      (local.set $e (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $ok (i32.const 1))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $md (loop $mc\n";
    o = o + "        (br_if $md (i32.ge_u (local.get $j) (local.get $nlen)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $np) (i32.const 4)) (local.get $j))) (i32.load8_u (i32.add (local.get $e) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $md)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $mc)))\n";
    o = o + "      (if (i32.and (local.get $ok) (i32.eq (i32.load8_u (i32.add (local.get $e) (local.get $nlen))) (i32.const 61))) (then\n";
    o = o + "        (local.set $vstart (i32.add (i32.add (local.get $e) (local.get $nlen)) (i32.const 1)))\n";
    o = o + "        (local.set $vlen (i32.const 0))\n";
    o = o + "        (block $vd (loop $vc\n";
    o = o + "          (br_if $vd (i32.eqz (i32.load8_u (i32.add (local.get $vstart) (local.get $vlen)))))\n";
    o = o + "          (local.set $vlen (i32.add (local.get $vlen) (i32.const 1)))\n";
    o = o + "          (br $vc)))\n";
    o = o + "        (local.set $res (call $__fern_alloc (i32.add (i32.const 4) (local.get $vlen))))\n";
    o = o + "        (i32.store (local.get $res) (local.get $vlen))\n";
    o = o + "        (local.set $j (i32.const 0))\n";
    o = o + "        (block $cd (loop $cc\n";
    o = o + "          (br_if $cd (i32.ge_u (local.get $j) (local.get $vlen)))\n";
    o = o + "          (i32.store8 (i32.add (i32.add (local.get $res) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $vstart) (local.get $j))))\n";
    o = o + "          (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "          (br $cc)))\n";
    o = o + "        (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "        (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "        (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $res))\n";
    o = o + "        (return (local.get $tmp))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cont)))\n";
    o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}
// args_helpers / args_func emit the wasi args imports + $__fern_args():
// the two-call sizes-then-get pattern, building a string[] array whose
// elements are fresh string blocks copied from each NUL-terminated argv
// entry (argv[0] is the program name, matching the native backends).
pub function args_helpers(): string {
    var o: string = "";
    o = o + "  (import \"wasi_snapshot_preview1\" \"args_sizes_get\" (func $args_sizes_get (param i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"args_get\" (func $args_get (param i32 i32) (result i32)))\n";
    return o;
}
pub function args_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_args (result i32)\n";
    o = o + "    (local $argc i32) (local $bufsz i32) (local $ptrs i32) (local $buf i32)\n";
    o = o + "    (local $arr i32) (local $i i32) (local $e i32) (local $len i32) (local $j i32) (local $blk i32)\n";
    o = o + "    (drop (call $args_sizes_get (i32.const 0) (i32.const 4)))\n";
    o = o + "    (local.set $argc (i32.load (i32.const 0)))\n";
    o = o + "    (local.set $bufsz (i32.load (i32.const 4)))\n";
    o = o + "    (local.set $ptrs (call $__fern_alloc (i32.mul (local.get $argc) (i32.const 4))))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (local.get $bufsz)))\n";
    o = o + "    (drop (call $args_get (local.get $ptrs) (local.get $buf)))\n";
    o = o + "    (local.set $arr (call $__fern_arr_box (i32.mul (local.get $argc) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $argc))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $argc))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $argc)))\n";
    o = o + "      (local.set $e (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $len (i32.const 0))\n";
    o = o + "      (block $ld (loop $lc\n";
    o = o + "        (br_if $ld (i32.eqz (i32.load8_u (i32.add (local.get $e) (local.get $len)))))\n";
    o = o + "        (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "        (br $lc)))\n";
    o = o + "      (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "      (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $cd (loop $cc\n";
    o = o + "        (br_if $cd (i32.ge_u (local.get $j) (local.get $len)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $e) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cc)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (local.get $blk))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}
// arg_at_func emits $__fern_arg_at(i): the single-element sibling of
// $__fern_args. Same sizes-then-get pattern, but it copies only argv[i] into
// one fresh [len][bytes] block instead of building the whole string[] — the
// point of arg_at being a real op rather than an `args()[i]` desugar, which
// would rebuild all of argv per call. An out-of-range index yields the empty
// string, matching what the register backends' bounds-free load would read
// past argv only if the caller ignored args_count(); returning empty is the
// safe answer here because wasi hands us argc directly.
pub function arg_at_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_arg_at (param $idx i32) (result i32)\n";
    o = o + "    (local $argc i32) (local $bufsz i32) (local $ptrs i32) (local $buf i32)\n";
    o = o + "    (local $e i32) (local $len i32) (local $j i32) (local $blk i32)\n";
    o = o + "    (drop (call $args_sizes_get (i32.const 0) (i32.const 4)))\n";
    o = o + "    (local.set $argc (i32.load (i32.const 0)))\n";
    o = o + "    (local.set $bufsz (i32.load (i32.const 4)))\n";
    o = o + "    (if (i32.ge_u (local.get $idx) (local.get $argc)) (then\n";
    o = o + "      (local.set $blk (call $__fern_alloc (i32.const 4)))\n";
    o = o + "      (i32.store (local.get $blk) (i32.const 0))\n";
    o = o + "      (return (local.get $blk))))\n";
    o = o + "    (local.set $ptrs (call $__fern_alloc (i32.mul (local.get $argc) (i32.const 4))))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (local.get $bufsz)))\n";
    o = o + "    (drop (call $args_get (local.get $ptrs) (local.get $buf)))\n";
    o = o + "    (local.set $e (i32.load (i32.add (local.get $ptrs) (i32.mul (local.get $idx) (i32.const 4)))))\n";
    o = o + "    (local.set $len (i32.const 0))\n";
    o = o + "    (block $ld (loop $lc\n";
    o = o + "      (br_if $ld (i32.eqz (i32.load8_u (i32.add (local.get $e) (local.get $len)))))\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (br $lc)))\n";
    o = o + "    (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $cd (loop $cc\n";
    o = o + "      (br_if $cd (i32.ge_u (local.get $j) (local.get $len)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (local.get $e) (local.get $j))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $cc)))\n";
    o = o + "    (local.get $blk))\n";
    return o;
}

// file_imports emits the wasi imports shared by read_file / write_file
// (path_open's rights args are i64 — fine in hand-authored WAT). fd_read
// is unused by write-only programs but harmless (wasi satisfies it).
pub function file_imports(): string {
    var o: string = "";
    o = o + "  (import \"wasi_snapshot_preview1\" \"path_open\" (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"fd_read\" (func $fd_read (param i32 i32 i32 i32) (result i32)))\n";
    o = o + "  (import \"wasi_snapshot_preview1\" \"fd_close\" (func $fd_close (param i32) (result i32)))\n";
    return o;
}
// readfile_helpers / readfile_func emit the wasi file-read imports +
// $__fern_read_file(path): Result[string, IoError]. Opens the path
// relative to preopen fd 3 (a `--dir` / wasi preopen) via path_open,
// reads to EOF into a fresh string block, and returns Ok(block) (tag 0)
// or Err(errno) (tag 1) on open failure. The rights args are i64 — written
// directly in this hand-authored WAT, independent of the i32 value model.
// Read cap is 64 KiB (enough for the compiler-test files; larger files
// truncate — a follow-up can grow the block).
pub function readfile_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_read_file (param $np i32) (result i32)\n";
    o = o + "    (local $err i32) (local $fd i32) (local $blk i32) (local $off i32) (local $n i32) (local $tmp i32) (local $cap i32)\n";
    // rights_base = FD_READ (2) | FD_SEEK (4) — a valid Rights mask
    // (all-ones is rejected: it sets bits outside the defined Rights set).
    o = o + "    (local.set $err (call $path_open (i32.const 3) (i32.const 1) (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (i32.const 0) (i64.const 6) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $np)))\n";
    o = o + "      (return (local.get $tmp))))\n";
    o = o + "    (local.set $fd (i32.load (i32.const 16)))\n";
    // Growable read buffer: a [len][bytes] block whose data capacity starts
    // at 64 KiB and extends by 64 KiB whenever it fills. The bump allocator
    // hands out contiguous bytes and nothing else allocates during the read
    // loop, so each extension lands right after the current buffer. (The old
    // code used a fixed 64 KiB buffer, silently truncating larger files: once
    // off reached 64 KiB the iovec length went to 0, fd_read returned 0, and
    // the loop mistook that for EOF.)
    o = o + "    (local.set $cap (i32.const 65536))\n";
    o = o + "    (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $cap))))\n";
    o = o + "    (local.set $off (i32.const 0))\n";
    o = o + "    (block $rd (loop $rc\n";
    // Ensure room before reading, so a full buffer is never mistaken for EOF.
    o = o + "      (if (i32.ge_u (local.get $off) (local.get $cap)) (then\n";
    o = o + "        (drop (call $__fern_alloc (i32.const 65536)))\n";
    o = o + "        (local.set $cap (i32.add (local.get $cap) (i32.const 65536)))))\n";
    o = o + "      (i32.store (i32.const 0) (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $off)))\n";
    o = o + "      (i32.store (i32.const 4) (i32.sub (local.get $cap) (local.get $off)))\n";
    o = o + "      (drop (call $fd_read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "      (local.set $n (i32.load (i32.const 8)))\n";
    o = o + "      (br_if $rd (i32.eqz (local.get $n)))\n";
    o = o + "      (local.set $off (i32.add (local.get $off) (local.get $n)))\n";
    o = o + "      (br $rc)))\n";
    o = o + "    (drop (call $fd_close (local.get $fd)))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $off))\n";
    o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (local.get $blk))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}
// writefile_func emits $__fern_write_file(path, content): Result[(), IoError]
// — create/truncate the path (oflags O_CREAT|O_TRUNC = 9), write the
// content block's bytes via fd_write, fd_close. Returns Ok(()) (tag 0) on
// success or Err(errno) (tag 1) when path_open fails. rights_base =
// FD_WRITE (64) | FD_SEEK (4) = 68.
pub function writefile_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_write_file (param $np i32) (param $cp i32) (result i32)\n";
    o = o + "    (local $err i32) (local $fd i32) (local $tmp i32)\n";
    o = o + "    (local.set $err (call $path_open (i32.const 3) (i32.const 1) (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (i32.const 9) (i64.const 68) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $tmp) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $tmp) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $np)))\n";
    o = o + "      (return (local.get $tmp))))\n";
    o = o + "    (local.set $fd (i32.load (i32.const 16)))\n";
    o = o + "    (i32.store (i32.const 0) (i32.add (local.get $cp) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.const 4) (i32.load (local.get $cp)))\n";
    o = o + "    (drop (call $fd_write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "    (drop (call $fd_close (local.get $fd)))\n";
    o = o + "    (local.set $tmp (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $tmp) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $tmp) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.get $tmp))\n";
    return o;
}
// open_file_func emits $__fern_open_file(path_box, openat_flags) → fd (>= 0) or
// -errno (#4372 file half): open `path` under preopen fd 3 via path_open, mapping
// the openat flags the register backends pass (0 = O_RDONLY, 577 = O_WRONLY|
// O_CREAT|O_TRUNC, 1089 = O_WRONLY|O_CREAT|O_APPEND) to WASI oflags / rights_base /
// fdflags. The new fd lands at scratch addr 16 (the same slot write_file uses).
pub function open_file_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_open_file (param $np i32) (param $flags i32) (result i32)\n";
    o = o + "    (local $err i32) (local $oflags i32) (local $rights i64) (local $fdflags i32)\n";
    o = o + "    (if (i32.eq (local.get $flags) (i32.const 0)) (then\n";
    o = o + "      (local.set $oflags (i32.const 0)) (local.set $rights (i64.const 6)) (local.set $fdflags (i32.const 0)))\n";
    o = o + "    (else (if (i32.eq (local.get $flags) (i32.const 1089)) (then\n";
    o = o + "      (local.set $oflags (i32.const 1)) (local.set $rights (i64.const 68)) (local.set $fdflags (i32.const 1)))\n";
    o = o + "    (else\n";
    o = o + "      (local.set $oflags (i32.const 9)) (local.set $rights (i64.const 68)) (local.set $fdflags (i32.const 0))))))\n";
    o = o + "    (local.set $err (call $path_open (i32.const 3) (i32.const 1) (i32.add (local.get $np) (i32.const 4)) (i32.load (local.get $np)) (local.get $oflags) (local.get $rights) (i64.const 0) (local.get $fdflags) (i32.const 16)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then (return (i32.sub (i32.const 0) (local.get $err)))))\n";
    o = o + "    (i32.load (i32.const 16)))\n";
    return o;
}
// writer_write_func emits $__fern_writer_write(fd, str_box) → bytes written (>= 0)
// or -errno: build a 1-element iovec [ptr = box+4, len = box[0]] at scratch 0/4 and
// fd_write it; nwritten lands at scratch 8. The Writer/appender fd comes from
// $__fern_open_file. Matches the register backends' write(2) inline (#4372).
pub function writer_write_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_writer_write (param $fd i32) (param $box i32) (result i32)\n";
    o = o + "    (local $err i32)\n";
    o = o + "    (i32.store (i32.const 0) (i32.add (local.get $box) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.const 4) (i32.load (local.get $box)))\n";
    o = o + "    (local.set $err (call $fd_write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then (return (i32.sub (i32.const 0) (local.get $err)))))\n";
    o = o + "    (i32.load (i32.const 8)))\n";
    return o;
}
// read_line_func emits $__fern_read_line (no args -> Option[string]): one line of
// stdin INCLUDING its trailing '\n', Some(line) / None at EOF (#4369 — matches
// native, replacing the old bare-string-stripped block). Reads fd 0 ONE BYTE at
// a time via fd_read (iovec {ptr,len} at addr 0, byte count at addr 8), stopping
// at '\n' (len includes it), boxes [len:i32][bytes], and wraps it in an Option
// box [tag@0, payload@4] via __fern_str_box — the same string + Option layout
// reader_read_chunk_func builds. Heap-gated (op_allocates).
pub function read_line_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_read_line (result i32)\n";
    o = o + "    (local $buf i32) (local $nread i32) (local $len i32) (local $blk i32) (local $i i32) (local $opt i32)\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.const 256)))\n";
    o = o + "    (local.set $len (i32.const 0))\n";
    // One fd_read per byte, stopping at '\n'. The old shape read up to 256 bytes
    // in one call and boxed only as far as the first newline, DISCARDING the
    // rest of the buffer — so a read-until-EOF loop got one line and then a real
    // EOF (#6052). Reading a byte at a time never consumes input this call will
    // not return, which is what native does and what makes the loop terminate on
    // the right line.
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $len) (i32.const 256)))\n";
    o = o + "      (i32.store (i32.const 0) (i32.add (local.get $buf) (local.get $len)))\n";
    o = o + "      (i32.store (i32.const 4) (i32.const 1))\n";
    o = o + "      (drop (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "      (local.set $nread (i32.load (i32.const 8)))\n";
    o = o + "      (br_if $d (i32.eqz (local.get $nread)))\n";
    o = o + "      (local.set $len (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (br_if $d (i32.eq (i32.load8_u (i32.add (local.get $buf) (i32.sub (local.get $len) (i32.const 1)))) (i32.const 10)))\n";
    o = o + "      (br $c)))\n";
    // EOF before any byte -> None. Any bytes at all (even without a trailing
    // newline) -> Some, so a final unterminated line is still returned.
    o = o + "    (if (i32.eqz (local.get $len)) (then\n";
    o = o + "      (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $opt) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $opt) (i32.const 4)) (i32.const 0))\n";
    o = o + "      (return (local.get $opt))))\n";
    o = o + "    (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $len))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $cd (loop $cc\n";
    o = o + "      (br_if $cd (i32.ge_u (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (local.get $buf) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cc)))\n";
    o = o + "    (local.set $opt (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $opt) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $opt) (i32.const 4)) (local.get $blk))\n";
    o = o + "    (local.get $opt))\n";
    return o;
}
// read_all_stdin_func emits $__fern_read_all_stdin (no args -> string): the
// WHOLE of stdin as ONE string block, the wasm sibling of the register
// backends' __fern_read_all_stdin (#5623). Unlike read_line's single 256-byte
// read it loops fd_read until the byte count comes back 0, so it can pull in a
// multi-line source — blank lines and all, which read_line cannot express
// (it can't distinguish a blank line from EOF).
//
// Reads STRAIGHT INTO the result block rather than into a scratch buffer that
// is copied afterwards: a wasm string is [len:i32][bytes], so reserving the
// block up front and filling from blk+4 means the bytes are already in place
// and only the length has to be stored at the end. The reservation matches the
// register backends' 32 MiB; $__fern_alloc grows linear memory to cover it, and
// the unused tail is bump space that is never touched.
pub function read_all_stdin_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_read_all_stdin (result i32)\n";
    o = o + "    (local $blk i32) (local $total i32) (local $nread i32)\n";
    o = o + "    (local.set $blk (call $__fern_alloc (i32.const 33554432)))\n";
    o = o + "    (local.set $total (i32.const 0))\n";
    o = o + "    (block $done (loop $again\n";
    // iovec {ptr,len} at addr 0, byte count at addr 8 — the same scratch idiom
    // read_line / reader_read_chunk use. ptr advances with the running total.
    o = o + "      (i32.store (i32.const 0) (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $total)))\n";
    o = o + "      (i32.store (i32.const 4) (i32.const 1048576))\n";
