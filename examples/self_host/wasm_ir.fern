            // region holds whole BLOCKS while the value is the data pointer.
            var kidx: i32 = util.index_of_str(cagg_vals, o.str);
            if (kidx < 0) {
                eprint("wasm-ir: aggregate constant not interned: " + o.str);
                exit(1);
            }
            out = out + "    global.get " + cagg_base_global(ns) + "\n    i32.const "
                + util.i32_to_string(const_agg_rel(cagg_vals, kidx) + 8) + "\n    i32.add\n";
        } else if (o.kind_tag == 139) {  // struct_get
            // stack: struct ptr -> load(ptr + 8 + index*8). An 8-byte field
            // (width 64) reads via i64.load for an i64 field (unsigned) or
            // f64.load for an f64 field; i32 fields the 4-byte path.
            out = out + "    i32.const " + util.i32_to_string(8 + o.i32_imm * 8) + "\n    i32.add\n";
            if (o.width == 64 && o.unsigned) { out = out + "    i64.load\n"; }
            else if (o.width == 64) { out = out + "    f64.load\n"; }
            else { out = out + "    i32.load\n"; }
        } else if (o.kind_tag == 140) {  // struct_set
            // stack: box, val -> store val at box + 8 + index*8. Stash val in the
            // matching scratch (i64tmp for an i64 field, f64tmp for an f64 field,
            // else eltmp), recompute the address, then store.
            var soff: i32 = 8 + o.i32_imm * 8;
            if (o.width == 64 && o.unsigned) {
                out = out + "    local.set " + util.i32_to_string(i64tmp) + "\n    i32.const " + util.i32_to_string(soff) + "\n    i32.add\n    local.get " + util.i32_to_string(i64tmp) + "\n    i64.store\n";
            } else if (o.width == 64) {
                out = out + "    local.set " + util.i32_to_string(f64tmp) + "\n    i32.const " + util.i32_to_string(soff) + "\n    i32.add\n    local.get " + util.i32_to_string(f64tmp) + "\n    f64.store\n";
            } else {
                out = out + "    local.set " + util.i32_to_string(eltmp) + "\n    i32.const " + util.i32_to_string(soff) + "\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n";
            }
        } else if (o.kind_tag == 198) {  // struct_copy
            // stack: src box -> a fresh rc=1 box that is a byte-for-byte copy (the
            // type_id@0 + nf 8-byte field slots, total 8+nf*8 bytes, matching
            // struct_make). Alloc via $__fern_str_box(size) then memory.copy the whole
            // box (field pointers shared, exactly like the inline base-copy). The
            // compact base copy of `T { ...base, f: v }` (#4650). $eltmp holds src,
            // $arrtmp the dst, across the alloc.
            var scpsz: i32 = 8 + o.i32_imm * 8;
            out = out + "    local.set " + util.i32_to_string(eltmp) + "\n";
            out = out + "    i32.const " + util.i32_to_string(scpsz) + "\n    call $__fern_str_box\n    local.set " + util.i32_to_string(arrtmp) + "\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.const " + util.i32_to_string(scpsz) + "\n    memory.copy\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n";
        } else if (o.kind_tag == 144) {  // tuple_set
            // stack: box, val -> store val at box + index*8 (tuples have NO shape
            // slot, unlike struct_set's box+8+index*8). Uniform 8-byte slots; the
            // store instruction matches the element KIND (width 64 + unsigned =>
            // i64.store; width 64 => f64.store; else i32.store for i32 / pointer),
            // mirroring tuple_make. The tuple constructor-reuse writer.
            var toff: i32 = o.i32_imm * 8;
            if (o.width == 64 && o.unsigned) {
                out = out + "    local.set " + util.i32_to_string(i64tmp) + "\n    i32.const " + util.i32_to_string(toff) + "\n    i32.add\n    local.get " + util.i32_to_string(i64tmp) + "\n    i64.store\n";
            } else if (o.width == 64) {
                out = out + "    local.set " + util.i32_to_string(f64tmp) + "\n    i32.const " + util.i32_to_string(toff) + "\n    i32.add\n    local.get " + util.i32_to_string(f64tmp) + "\n    f64.store\n";
            } else {
                out = out + "    local.set " + util.i32_to_string(eltmp) + "\n    i32.const " + util.i32_to_string(toff) + "\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n";
            }
        } else if (o.kind_tag == 141) {  // struct_set_shape
            // stack: box (kept). Write o.str's type-id (the SAME id struct_make
            // stores at offset 0 / variant_is compares) at box+0, leaving the box
            // on the stack. Used by the enum-donor in-place reuse to re-shape a
            // dead scalar-enum box as a same-size struct.
            out = out + "    local.tee " + util.i32_to_string(arrtmp) + "\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n" + tid_get(o.str) + "    i32.store\n";
        } else if (o.kind_tag == 145) {  // variant_is
            // stack: variant box -> i32.load (type_id @0) == struct_type_id(name)
            out = out + "    i32.load\n" + tid_get(o.str) + "    i32.eq\n";
        } else if (o.kind_tag == 142) {  // tuple_make
            // n elements on the stack (element n-1 on top). Box = [e0@0, e1@8, …]
            // via $__fern_str_box (rc-headered), n*8 bytes (uniform 8-byte slots,
            // matching the register backends so an i64/f64 element fits), no
            // type-id slot. Each element stores with the instruction its KIND
            // (o.str = "k0,k1,…") selects: i64.store / f64.store / i32.store.
            var tn: i32 = o.i32_imm;
            out = out + "    i32.const " + util.i32_to_string(tn * 8) + "\n    call $__fern_str_box\n    local.set " + util.i32_to_string(arrtmp) + "\n";
            var tem: i32 = tn - 1;
            while (tem >= 0) {
                var tk: string = irlower.csv_nth(o.str, tem);
                if (tk == "i64") {
                    out = out + "    local.set " + util.i32_to_string(i64tmp) + "\n";
                    out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(tem * 8) + "\n    i32.add\n    local.get " + util.i32_to_string(i64tmp) + "\n    i64.store\n";
                } else if (tk == "f64") {
                    out = out + "    local.set " + util.i32_to_string(f64tmp) + "\n";
                    out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(tem * 8) + "\n    i32.add\n    local.get " + util.i32_to_string(f64tmp) + "\n    f64.store\n";
                } else {
                    out = out + "    local.set " + util.i32_to_string(eltmp) + "\n";
                    out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const " + util.i32_to_string(tem * 8) + "\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n";
                }
                tem = tem - 1;
            }
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n";
        } else if (o.kind_tag == 143) {  // tuple_get
            // stack: tuple box -> load(box + index*8). An 8-byte element (width 64)
            // reads via i64.load (unsigned) or f64.load; i32 elements i32.load.
            out = out + "    i32.const " + util.i32_to_string(o.i32_imm * 8) + "\n    i32.add\n";
            if (o.width == 64 && o.unsigned) { out = out + "    i64.load\n"; }
            else if (o.width == 64) { out = out + "    f64.load\n"; }
            else { out = out + "    i32.load\n"; }
        } else if (o.kind_tag == 149 && o.str == "__fern_arr_share_inc") {  // call_direct
            // #4873/#5325 grow-bracket: retain the survivor across a may-grow
            // call. Wasm-IR arrays ARE rc-headered ($__fern_arr_box block
            // [rc@0][bsz@4][len@8][cap@12], data = base+8 → rc@[a-8] — the
            // same [data-8] convention as the register backends), so the
            // bracket maps to the exact pair the register backends alias:
            // inc = the plain retain, dec = the freeing $__fern_arr_dec
            // (frees at rc==1, defensively gated on null/low/tagged/immortal
            // — matching __fn___fern_arr_dec on x86/arm64). The gated
            // $__fern_arr_push (arr_push_helper) reads the raised rc and
            // copies instead of mutating the shared buffer in place. Both
            // helpers live in heap_alloc_helpers, gated on module_allocates —
            // co-resident with $__fern_arr_box wherever an append (and hence
            // a bracket) can appear. The op sequence is load → call → drop;
            // the helpers return the pointer, so the stack stays balanced.
            out = out + "    call $__fern_rc_inc\n";
        } else if (o.kind_tag == 149 && o.str == "__fern_arr_share_dec") {  // call_direct
            out = out + "    call $__fern_arr_dec\n";
        } else if (o.kind_tag == 149 && asm_ir.is_fern_helper(o.str)) {  // call_direct
            // Runtime RC helper: the arg is already on the wasm stack; the
            // helper takes it as a param and returns the ptr / count.
            out = out + "    call " + wasm_helper_symbol(o.str) + "\n";
        } else if (o.kind_tag == 149) {  // call_direct
            out = out + "    call $" + o.str + "\n";
        } else if (o.kind_tag == 147) {  // dyn_dispatch
            // `dyn Trait` method call. Receiver (arg0) + args are in argc
            // consecutive locals from base_slot. Read the receiver's type id
            // (i32.load @0) and dispatch via a nested if/else chain over every
            // module method named o.str with a struct receiver, each arm
            // reloading the argc locals and calling. Mirrors the register
            // backends' compare-branch chain; the result flows as the if result.
            var dbase: i32 = o.i32_imm;
            var dargc: i32 = o.width;
            var drt: string = "i32";
            var nimpl: i32 = 0;
            var df0: i32 = 0;
            while (df0 < funcs.len()) {
                var dbn0: string = util.base_type_name(funcs[df0].receiver_type);
                // Count struct receivers, primitive/string receivers (heap-boxed
                // at coercion — docs/DYN-TRAITS.md §4.2.3), AND enum receivers
                // (#4785 — matched per-variant below): each is an `if` arm
                // needing a matching `end`.
                if (funcs[df0].name == o.str && funcs[df0].receiver_type.len() > 0
                        && (irlower.decl_is_struct(structs, dbn0) || irlower.decl_is_prim_recv(structs, dbn0)
                            || (!asmcore.recv_is_array(funcs[df0].receiver_type) && irlower.decl_is_enum(structs, dbn0)))) {
                    if (nimpl == 0) {
                        if (funcs[df0].ret_type == "i64" || funcs[df0].ret_type == "u64") { drt = "i64"; }
                        else if (irlower.is_f64_scalar_type_name(funcs[df0].ret_type)) { drt = "f64"; }
                    }
                    nimpl = nimpl + 1;
                }
                df0 = df0 + 1;
            }
            var dfi: i32 = 0;
            while (dfi < funcs.len()) {
                var dbn: string = util.base_type_name(funcs[dfi].receiver_type);
                var dprim: boolean = funcs[dfi].receiver_type.len() > 0 && irlower.decl_is_prim_recv(structs, dbn);
                if (funcs[dfi].name == o.str && funcs[dfi].receiver_type.len() > 0
                        && (irlower.decl_is_struct(structs, dbn) || dprim)) {
                    // Shape compare: a struct value carries its type id @0; a
                    // primitive `dyn` box stores prim_type_id @0 (op_dyn_box).
                    out = out + "    local.get " + util.i32_to_string(dbase) + "\n    i32.load\n" + tid_get(dbn) + "    i32.eq\n";
                    out = out + "    if (result " + drt + ")\n";
                    var dk: i32 = 0;
                    while (dk < dargc) {
                        if (dk == 0 && dprim) {
                            // arg0 is the receiver: UNBOX the value from box+8.
                            out = out + "    local.get " + util.i32_to_string(dbase) + "\n    i32.const 8\n    i32.add\n    i32.load\n";
                        } else {
                            out = out + "    local.get " + util.i32_to_string(dbase + dk) + "\n";
                        }
                        dk = dk + 1;
                    }
                    out = out + "    call $" + dbn + "." + funcs[dfi].name + "\n";
                    out = out + "    else\n";
                }
                // ENUM-receiver arm (`impl Trait for <Enum>`, #4785): an enum
                // value's type id @0 is its VARIANT's struct_type_id (the same
                // identity op_variant_is / op_enum_new use), never an id for
                // the enum name itself, so the struct-arm compare above can
                // never identify it. Match the receiver id against EVERY
                // variant of the enum (OR-chain); on a hit call
                // `<Enum>.<method>` with the variant box as the receiver (its
                // body's `match (self)` re-reads the variant). Keyed
                // per-variant so two enums implementing the same trait
                // dispatch to their own impls. recv_is_array excludes an
                // array method's `T[]` receiver (base_type_name strips the
                // `[]`, which would otherwise mis-read as an enum — #2766).
                if (funcs[dfi].name == o.str && funcs[dfi].receiver_type.len() > 0
                        && !asmcore.recv_is_array(funcs[dfi].receiver_type)
                        && irlower.decl_is_enum(structs, dbn)
                        && !(irlower.decl_is_struct(structs, dbn) || dprim)) {
                    var denvn: i32 = 0;
                    var dvi: i32 = 0;
                    while (dvi < structs.len()) {
                        if (structs[dvi].enum_owner == dbn) {
                            out = out + "    local.get " + util.i32_to_string(dbase) + "\n    i32.load\n    i32.const " + util.i32_to_string(dvi) + "\n    i32.eq\n";
                            if (denvn > 0) { out = out + "    i32.or\n"; }
                            denvn = denvn + 1;
                        }
                        dvi = dvi + 1;
                    }
                    out = out + "    if (result " + drt + ")\n";
                    var dek: i32 = 0;
                    while (dek < dargc) {
                        out = out + "    local.get " + util.i32_to_string(dbase + dek) + "\n";
                        dek = dek + 1;
                    }
                    out = out + "    call $" + dbn + "." + funcs[dfi].name + "\n";
                    out = out + "    else\n";
                }
                dfi = dfi + 1;
            }
            if (drt == "i64") { out = out + "    i64.const 0\n"; }
            else if (drt == "f64") { out = out + "    f64.const 0\n"; }
            else { out = out + "    i32.const 0\n"; }
            var de: i32 = 0;
            while (de < nimpl) { out = out + "    end\n"; de = de + 1; }
        } else if (o.kind_tag == 146) {  // dyn_box
            // Heap-box a primitive/string value coerced into a `dyn Trait` slot
            // (docs/DYN-TRAITS.md §4.2.3). Cell = [shape@0, value@8] via
            // $__fern_str_box (rc-headered, like struct_make), 16 bytes; shape =
            // the primitive type id (prim_type_id, never colliding with a struct
            // id). The value (one i32 word — an i32 OR a string box pointer) is on
            // the operand stack: stash it in $eltmp, alloc into $arrtmp, store
            // id@0 + value@8, push the cell pointer. op_dyn_dispatch reads @0 and
            // unboxes @8.
            out = out + "    local.set " + util.i32_to_string(eltmp) + "\n";
            out = out + "    i32.const 16\n    call $__fern_str_box\n    local.set " + util.i32_to_string(arrtmp) + "\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n" + tid_get(o.str) + "    i32.store\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 8\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n";
        } else if (o.kind_tag == 148) {  // dyn_downcast
            // `e as? T` downcast (docs/DYN-TRAITS.md §9). The `dyn` value (a heap
            // pointer carrying its concrete type id @0) is on the stack. Stash it,
            // read the id @0 and compare to T's struct_type_id (the SAME id
            // struct_make stores / dyn_dispatch compares): equal → Some(value)
            // box [tag0@0, payload@4]; else → None box [tag1@0, 0@4] — the 8-byte
            // i32-payload Option box (matching opt_make/opt_none) a downstream
            // `match` reads with opt_tag/opt_payload.
            out = out + "    local.set " + util.i32_to_string(eltmp) + "\n";
            out = out + "    local.get " + util.i32_to_string(eltmp) + "\n    i32.load\n" + tid_get(o.str) + "    i32.eq\n";
            out = out + "    if (result i32)\n";
            // hit: Some(value) — 8-byte box [tag0@0, payload(dyn ptr)@4].
            out = out + "    i32.const 8\n    call $__fern_str_box\n    local.set " + util.i32_to_string(arrtmp) + "\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 0\n    i32.store\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 4\n    i32.add\n    local.get " + util.i32_to_string(eltmp) + "\n    i32.store\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n";
            out = out + "    else\n";
            // miss: None — 8-byte box [tag1@0, 0@4].
            out = out + "    i32.const 8\n    call $__fern_str_box\n    local.set " + util.i32_to_string(arrtmp) + "\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 1\n    i32.store\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n    i32.const 4\n    i32.add\n    i32.const 0\n    i32.store\n";
            out = out + "    local.get " + util.i32_to_string(arrtmp) + "\n";
            out = out + "    end\n";
        } else if (o.kind_tag == 6) {  // const_func
            // A function VALUE is its slot index in the module's funcref table
            // (fn_table). The table is built over the address-taken functions in
            // first-seen order (fn_value_table), so the index here matches the
            // elem segment fn_support_section emits.
            out = out + "    global.get " + fn_base_global(ns) + "\n    i32.const " + util.i32_to_string(util.index_of_str(fn_table, o.str) - fn_table_base()) + "\n    i32.add\n";
        } else if (o.kind_tag == 150) {  // call_indirect
            // Indirect call: args + the table index are already on the stack
            // (the index pushed last, on top). Dispatch through the signature the
            // funcref actually has — `$fn<tag>` when irlower recovered the declared
            // widths, else the all-i32 `$fn<argc>`. A funcref type is structural in
            // wasm, so the arity alone cannot tell `(i64) => boolean` from
            // `(i32) => i32` and dispatching one through the other is rejected at
            // load (#6282).
            out = out + "    call_indirect (type " + fn_type_name(o) + ")\n";
        } else if (o.kind_tag == 66) {  // fpow
            // x^y: the one binary transcendental. Both f64 operands are on the
            // stack (x pushed first, y on top — irlower's op_fbin order), matching
            // $__fern_pow_f64(param x, param y). wasm has no pow instruction, so
            // call the runtime (= exp(y·ln x)); the arm64 backend lowers fpow the
            // same way (bl __fern_pow_f64).
            out = out + "    call $__fern_pow_f64\n";
        } else {
            out = out + "    " + wasm_binop_w(o.kind_tag, o.width) + "\n";
        }
        i = i + 1;
    }
    // Fallthrough result. Subset functions end in `return`, so this lands in the
    // unreachable continuation — but a concrete value pushed there must still
    // type-match the declared result when the implicit end pops it (wasm's
    // stack-polymorphic typing accepts an underflow, not a wrong-typed top), so
    // the default's type tracks the result: i64 / f64 / i32.
    if (fd.ret_type == "i64" || fd.ret_type == "u64") { out = out + "    i64.const 0)\n"; }
    else if (irlower.is_f64_scalar_type_name(fd.ret_type)) { out = out + "    f64.const 0)\n"; }
    // A bare-typevar (erased-generic) return is typed i64 on wasm (#5464), so its
    // fallthrough filler must be i64.const 0 to match the (result i64) signature.
    else if (irlower.erased_passthrough_safe(fd, structs)) { out = out + "    i64.const 0)\n"; }
    else { out = out + "    i32.const 0)\n"; }
    return out;
}

// emit_functions renders the user functions of an all-eligible module as WAT
// (func ...) blocks — and ONLY the functions. The module wrapper (imports +
// memory), the heap/RC runtime (heap_alloc_helpers + rc_runtime_helpers, which
// live in wasm.fern), and the `_start` + exports are emitted by the CALLER
// (wasm.emit_module, or the differential driver). Keeping the runtime on the
// caller side lets wasm.fern import this module for the use_ir dispatch without
// a cycle: wasm_ir never imports wasm. Caller must ensure wasm_eligible(mod).
// emit_functions emits a unit's function bodies. `ns` namespaces the base
// globals the bodies reference (see str_base_global); "" is whole-program emit.
// emit_functions_view emits ONE unit's function bodies against a WHOLE-PROGRAM
// view of the program's functions and structs (#5331 step 4b).
//
// The split matters and is easy to get wrong:
//
//   - The SIDE TABLES (ret-type tagging, borrowability, closure/fn-ptr sets,
//     struct layouts) derive from all_funcs / all_structs. A unit calls into its
//     sibling modules, and a call is tagged by its CALLEE's return type — derive
//     these from the unit's own functions and every cross-module call is
//     mis-tagged. This is why asm_ir.emit_module_ir_unit takes the same two
//     views.
//   - The EMIT LOOP and the string / funcref tables stay unit-local. Those are
//     what make a unit's offsets relative to its own $__str_base / $__fn_base,
//     which is the whole point of steps 1 and 2.
//
// Whole-program emit passes all_funcs = mod.funcs and all_structs = mod.structs,
// so it is unchanged.
pub function emit_functions_view(ns: string, mod: parser.Module, cache: irlower.LowerResult[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[]): string {
    // Infer return types for unannotated functions so the IR path's
    // ret-type-keyed call tagging matches the AST path (parity with the
    // x86 IR path in asm_ir.emit_module_ir).
    mod = parser.infer_ret_types_module(mod);
    // Emit from the PRE-LOWERED `cache` (cache[fi] <-> mod.funcs[fi], both in
    // mod.funcs order): no second lowering, so the emitted bodies match the
    // metadata by construction. The dozen ret-fn / borrow side-tables that only
    // fed the old per-function re-lowering are gone with it.
    var str_vals: string[] = str_values(cache);
    var cagg_vals: string[] = const_agg_values(cache);
    var ft: string[] = fn_value_table(cache);
    var out: string = "";
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        // An `@import` extern is a DECLARATION, not a definition: its body-less
        // signature is bound to a WIT import, and the callable `$name` is the
        // canonical-ABI wrapper extern_wrappers emits (return-area alloc, raw
        // import call, lift). Lowering it here emitted a stub returning
        // `i32.const 0` under the SAME name — which is both wrong on its own (an
        // extern call silently yielded 0) and a `duplicate func identifier` once
        // the real wrapper is emitted alongside it.
        //
        // Skipping it is the other half of bringing the extern bridge onto the IR
        // path: the bridge supplies the definition, so the lowering must not.
        if (mod.funcs[fi].import_iface.len() == 0) {
            out = out + emit_function_ir(ns, cache[fi], mod.funcs[fi], str_vals, cagg_vals, all_structs, ft, all_funcs);
        }
        fi = fi + 1;
    }
    return out;
}

// emit_functions_ns is the single-unit case: the unit IS the whole program.
pub function emit_functions_ns(ns: string, mod: parser.Module, cache: irlower.LowerResult[]): string {
    var im: parser.Module = parser.infer_ret_types_module(mod);
    return emit_functions_view(ns, im, cache, im.funcs, im.structs);
}

// emit_functions is whole-program emit: one unit, so the bases are unnamespaced.
pub function emit_functions(mod: parser.Module, cache: irlower.LowerResult[]): string {
    return emit_functions_ns("", mod, cache);
}

// struct_type_id returns a struct's runtime type id = its index in the module's
// struct table. (For scalar-field structs with static field access it is never
// read, but it occupies the 8-byte header slot so fields land at 8 + i*8.)
function struct_type_id(structs: parser.StructDecl[], name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return i; }
        i = i + 1;
    }
    return 0;
}

// build_io_error_func emits $__fern_build_io_error(errno, path) -> IoError enum
// box — the self-host wasm sibling of native wasmbin's __build_io_error and the
// register backends' __fern_io_error (asm_ir). Maps a small set of WASI
// preview-1 errnos to the matching IoError variant, carrying the offending path
// string on the single-string variants; everything else lands in
// Other(path, ""). The variant ids are baked from the module's struct table
// (same table the match arms read, so ids agree). errno→variant matches native
// wasmbin: ENOENT(44) → NotFound(path), EACCES(2) → PermissionDenied(path),
// EEXIST(20) → AlreadyExists(path), EINTR(27) → Interrupted, ENOTSUP(58) →
// Unsupported.
//
// `slot` is the CONSUMER's variant-box slot width. Both consumers lay a box out
// the same way — the variant id in slot 0, field i in slot 1+i, so field i sits
// at slot*(1+i) and an n-field box is slot*(1+n) bytes — but at different
// widths: the IR consumer (op_enum_new / the IR match dispatch) slots 8, while
// the legacy AST emitter slots 4 (wasm.struct_field_off(i) = 4 + i*4, boxed as
// 4 + nfields*4). Emitting the IR layout for both is what made an AST-path
// `NotFound(p)` read its path out of the upper half of the id slot, and the
// two-field default arm `Other(path, msg)` — where every unmapped errno lands —
// wrong in both fields (#5795). Boxes via $__fern_str_box, the same rc-headered
// allocation both emitters build variants with. A string field is a single
// [len][bytes] block pointer, so the caller's path block is stored directly.
// build_io_error_p2_func emits $__fern_build_io_error_p2(code, path): the
// PREVIEW2 sibling of $__fern_build_io_error below. It does not duplicate the
// variant boxing — it translates a `wasi:filesystem/types.error-code`
// discriminant into the preview1 errno the existing boxer understands, then
// delegates, so the IoError variant shapes stay defined in exactly one place.
//
// The translation mirrors the native backend's appendErrnoFromErrorCode
// (internal/codegen/wasmbin/wasi_fs.go), the oracle: default ENOENT (so an
// unrecognised failure reads as NotFound, not Other), plus access(0) -> EACCES,
// exist(7) -> EEXIST, interrupted(11) -> EINTR, unsupported(27) -> ENOTSUP.
// The discriminant indices are positional in the enum as vendored at
// cmd/fern/wit/deps/filesystem/types.wit.
pub function build_io_error_p2_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_build_io_error_p2 (param $code i32) (param $path i32) (result i32)\n";
    o = o + "    (local $errno i32)\n";
    o = o + "    (local.set $errno (i32.const 44))\n";
    o = o + "    (if (i32.eq (local.get $code) (i32.const 0)) (then (local.set $errno (i32.const 2))))\n";
    o = o + "    (if (i32.eq (local.get $code) (i32.const 7)) (then (local.set $errno (i32.const 20))))\n";
    o = o + "    (if (i32.eq (local.get $code) (i32.const 11)) (then (local.set $errno (i32.const 27))))\n";
    o = o + "    (if (i32.eq (local.get $code) (i32.const 27)) (then (local.set $errno (i32.const 58))))\n";
    o = o + "    (call $__fern_build_io_error (local.get $errno) (local.get $path)))\n";
    return o;
}

// io_err_box_bytes is the size of an n-field IoError variant box, and
// io_err_field_off the byte offset of its field i, for a consumer whose boxes
// are `slot` bytes per slot. See build_io_error_func for the layout.
function io_err_box_bytes(nfields: i32, slot: i32): string {
    return util.i32_to_string(slot * (1 + nfields));
}
function io_err_field_off(i: i32, slot: i32): string {
    return util.i32_to_string(slot * (1 + i));
}

pub function build_io_error_func(slot: i32): string {
    var o: string = "";
    o = o + "  (func $__fern_build_io_error (param $errno i32) (param $path i32) (result i32)\n";
    o = o + "    (local $r i32) (local $e i32)\n";
    // ENOENT(44) -> NotFound(path)
    o = o + "    (if (i32.eq (local.get $errno) (i32.const 44)) (then\n";
    o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1, slot) + ")))\n";
    o = o + "      (i32.store (local.get $r) (global.get " + tid_global("NotFound") + "))\n";
    o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0, slot) + ")) (local.get $path))\n";
    o = o + "      (return (local.get $r))))\n";
    // EACCES(2) -> PermissionDenied(path)
    o = o + "    (if (i32.eq (local.get $errno) (i32.const 2)) (then\n";
    o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1, slot) + ")))\n";
    o = o + "      (i32.store (local.get $r) (global.get " + tid_global("PermissionDenied") + "))\n";
    o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0, slot) + ")) (local.get $path))\n";
    o = o + "      (return (local.get $r))))\n";
    // EEXIST(20) -> AlreadyExists(path)
    o = o + "    (if (i32.eq (local.get $errno) (i32.const 20)) (then\n";
    o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(1, slot) + ")))\n";
    o = o + "      (i32.store (local.get $r) (global.get " + tid_global("AlreadyExists") + "))\n";
    o = o + "      (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0, slot) + ")) (local.get $path))\n";
    o = o + "      (return (local.get $r))))\n";
    // EINTR(27) -> Interrupted (payloadless)
    o = o + "    (if (i32.eq (local.get $errno) (i32.const 27)) (then\n";
    o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(0, slot) + ")))\n";
    o = o + "      (i32.store (local.get $r) (global.get " + tid_global("Interrupted") + "))\n";
    o = o + "      (return (local.get $r))))\n";
    // ENOTSUP(58) -> Unsupported (payloadless)
    o = o + "    (if (i32.eq (local.get $errno) (i32.const 58)) (then\n";
    o = o + "      (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(0, slot) + ")))\n";
    o = o + "      (i32.store (local.get $r) (global.get " + tid_global("Unsupported") + "))\n";
    o = o + "      (return (local.get $r))))\n";
    // default -> Other(path, "") — the empty message is a valid [len=0] block.
    o = o + "    (local.set $e (call $__fern_alloc (i32.const 4)))\n";
    o = o + "    (i32.store (local.get $e) (i32.const 0))\n";
    o = o + "    (local.set $r (call $__fern_str_box (i32.const " + io_err_box_bytes(2, slot) + ")))\n";
    o = o + "    (i32.store (local.get $r) (global.get " + tid_global("Other") + "))\n";
    o = o + "    (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(0, slot) + ")) (local.get $path))\n";
    o = o + "    (i32.store (i32.add (local.get $r) (i32.const " + io_err_field_off(1, slot) + ")) (local.get $e))\n";
    o = o + "    (local.get $r))\n";
    return o;
}

// ---- moved verbatim from wasm.fern (#3457 slice 4 untangle) ----
// The transcendental f64-math WAT helpers are IR-path-only (emitted only by
// emit_ir_module_units) and self-contained (pure WAT, no imports/heap/AST), so
// they live here in the IR emitter, not in the AST emitter wasm.fern that #3457
// deletes. wasm_ir.fern already references them by name in comments.
// The f64 transcendental WAT helpers. These are fdlibm's kernels, kept in
// lockstep with internal/codegen/arm64 and examples/self_host/asm_arm64_ir.fern
// — same constants, same order. They replace polynomials that measured 3.2e10
// ulp for sin, 4.5e7 for exp and 9844 for log while their comments claimed
// otherwise.
//
// wasm needs no rounding-mode note: f64.nearest is ties-to-EVEN, which is
// exactly what arm64's `frintn` and x86's `roundsd …, 0` now do, so all three
// backends pick the same k. (This comment used to explain a mismatch against
// arm64's `frinta`; that mismatch no longer exists.)
//
// Two corrections rather than refinements:
//
//   - pi/2 is carried as THREE 33-bit chunks (~99 bits). Two is not enough
//     near a zero of sine, where the reduced argument IS the answer, so the
//     reduction's absolute error becomes the result's relative error.
//   - Every function guards its domain. Without that exp(1000) returned
//     -6.1e-183 rather than +Inf — 2^k is built as (k+1023)<<52 and k=1443
//     overflows the exponent field into the SIGN bit — and log(0) returned
//     -709.09 rather than -Inf. Infinities are spelled via
//     f64.reinterpret_i64 of their bit patterns, which is the idiom already
//     used here for 2^k, rather than relying on an `inf` literal.
pub function exp_func(): string {
    var o: string = "";    o = o + "  (func $__fern_exp_f64 (param $x f64) (result f64)\n";
    o = o + "    (local $kf f64) (local $ki i64) (local $r f64) (local $hi f64) (local $lo f64) (local $t f64) (local $c f64) (local $p f64)\n";
    o = o + "    (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))\n";
    o = o + "    (if (f64.gt (local.get $x) (f64.const 709.782712893383973096)) (then (return (f64.reinterpret_i64 (i64.const 9218868437227405312)))))\n";
    o = o + "    (if (f64.lt (local.get $x) (f64.const -745.133219101941108420)) (then (return (f64.const 0.0))))\n";
    o = o + "    (local.set $kf (f64.nearest (f64.mul (local.get $x) (f64.const 1.44269504088896338700))))\n";
    o = o + "    (local.set $ki (i64.trunc_f64_s (local.get $kf)))\n";
    o = o + "    (local.set $hi (f64.sub (local.get $x) (f64.mul (local.get $kf) (f64.const 0.693147180369123816490))))\n";
    o = o + "    (local.set $lo (f64.mul (local.get $kf) (f64.const 1.90821492927058770002e-10)))\n";
    o = o + "    (local.set $r (f64.sub (local.get $hi) (local.get $lo)))\n";
    o = o + "    (local.set $t (f64.mul (local.get $r) (local.get $r)))\n";
    o = o + "    (local.set $p (f64.const 4.13813679705723846039e-08))\n";
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $t)) (f64.const -1.65339022054652515390e-06)))\n";
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $t)) (f64.const 6.61375632143793436117e-05)))\n";
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $t)) (f64.const -2.77777777770155933842e-03)))\n";
    o = o + "    (local.set $p (f64.add (f64.mul (local.get $p) (local.get $t)) (f64.const 1.66666666666666019037e-01)))\n";
    o = o + "    (local.set $c (f64.sub (local.get $r) (f64.mul (local.get $p) (local.get $t))))\n";
    o = o + "    (local.set $p (f64.sub (f64.const 1.0) (f64.sub (f64.sub (local.get $lo) (f64.div (f64.mul (local.get $r) (local.get $c)) (f64.sub (f64.const 2.0) (local.get $c)))) (local.get $hi))))\n";
    o = o + "    (f64.mul (local.get $p) (f64.reinterpret_i64 (i64.shl (i64.add (local.get $ki) (i64.const 1023)) (i64.const 52)))))\n";
    return o;
}

// log_func emits $__fern_log_f64(x) -> ln x. x = 2^k*m with m normalised to
// [sqrt2/2, sqrt2); f = m-1; s = f/(2+f). R is two INDEPENDENT chains in
// w = z^2, so they evaluate in parallel rather than as one 7-deep Horner.
pub function log_func(): string {
    var o: string = "";    o = o + "  (func $__fern_log_f64 (param $x f64) (result f64)\n";
    o = o + "    (local $k i64) (local $bits i64) (local $m f64) (local $f f64) (local $s f64) (local $z f64) (local $w f64) (local $t1 f64) (local $t2 f64) (local $hfsq f64) (local $kf f64)\n";
    o = o + "    (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))\n";
    o = o + "    (if (f64.lt (local.get $x) (f64.const 0.0)) (then (return (f64.reinterpret_i64 (i64.const 9221120237041090560)))))\n";
    o = o + "    (if (f64.eq (local.get $x) (f64.const 0.0)) (then (return (f64.reinterpret_i64 (i64.const -4503599627370496)))))\n";
    o = o + "    (if (f64.eq (local.get $x) (f64.reinterpret_i64 (i64.const 9218868437227405312))) (then (return (local.get $x))))\n";
    o = o + "    (local.set $bits (i64.reinterpret_f64 (local.get $x)))\n";
    o = o + "    (local.set $k (i64.sub (i64.and (i64.shr_u (local.get $bits) (i64.const 52)) (i64.const 2047)) (i64.const 1023)))\n";
    o = o + "    (local.set $m (f64.reinterpret_i64 (i64.or (i64.and (local.get $bits) (i64.const 4503599627370495)) (i64.const 4607182418800017408))))\n";
    o = o + "    (if (f64.ge (local.get $m) (f64.const 1.4142135623730951)) (then (local.set $m (f64.mul (local.get $m) (f64.const 0.5))) (local.set $k (i64.add (local.get $k) (i64.const 1)))))\n";
    o = o + "    (local.set $f (f64.sub (local.get $m) (f64.const 1.0)))\n";
    o = o + "    (local.set $s (f64.div (local.get $f) (f64.add (f64.const 2.0) (local.get $f))))\n";
    o = o + "    (local.set $z (f64.mul (local.get $s) (local.get $s)))\n";
    o = o + "    (local.set $w (f64.mul (local.get $z) (local.get $z)))\n";
    o = o + "    (local.set $t1 (f64.const 0.1531383769920937332))\n";
    o = o + "    (local.set $t1 (f64.add (f64.mul (local.get $t1) (local.get $w)) (f64.const 0.2222219843214978396)))\n";
    o = o + "    (local.set $t1 (f64.add (f64.mul (local.get $t1) (local.get $w)) (f64.const 0.3999999999940941908)))\n";
    o = o + "    (local.set $t1 (f64.mul (local.get $t1) (local.get $w)))\n";
    o = o + "    (local.set $t2 (f64.const 0.1479819860511658591))\n";
    o = o + "    (local.set $t2 (f64.add (f64.mul (local.get $t2) (local.get $w)) (f64.const 0.1818357216161805012)))\n";
    o = o + "    (local.set $t2 (f64.add (f64.mul (local.get $t2) (local.get $w)) (f64.const 0.2857142874366239149)))\n";
    o = o + "    (local.set $t2 (f64.add (f64.mul (local.get $t2) (local.get $w)) (f64.const 0.6666666666666735130)))\n";
    o = o + "    (local.set $t2 (f64.mul (local.get $t2) (local.get $z)))\n";
    o = o + "    (local.set $t1 (f64.add (local.get $t1) (local.get $t2)))\n";
    o = o + "    (local.set $hfsq (f64.mul (f64.const 0.5) (f64.mul (local.get $f) (local.get $f))))\n";
    o = o + "    (local.set $kf (f64.convert_i64_s (local.get $k)))\n";
    o = o + "    (f64.sub (f64.mul (local.get $kf) (f64.const 0.693147180369123816490)) (f64.sub (f64.sub (local.get $hfsq) (f64.add (f64.mul (local.get $s) (f64.add (local.get $hfsq) (local.get $t1))) (f64.mul (local.get $kf) (f64.const 1.90821492927058770002e-10)))) (local.get $f))))\n";
    return o;
}

// pow_func emits $__fern_pow_f64(x, y). The integer-exponent fast path is not
// an optimisation: exp(y*ln x) CANNOT return exactly 9 for pow(3,2), because a
// 1-ulp error in ln 3 amplified by the exponential lands just under, and
// `as i32` truncated it to 8. Repeated squaring is exact wherever the result
// is representable. Integrality is an i64 round-trip, so a NaN or out-of-range
// y falls out as a huge |n| that the range check rejects.
pub function pow_func(): string {
    var o: string = "";    o = o + "  (func $__fern_pow_f64 (param $x f64) (param $y f64) (result f64)\n";
    o = o + "    (local $n i64) (local $an i64) (local $acc f64) (local $base f64)\n";
    o = o + "    (local.set $n (i64.trunc_f64_s (local.get $y)))\n";
    o = o + "    (if (f64.eq (f64.convert_i64_s (local.get $n)) (local.get $y)) (then\n";
    o = o + "      (local.set $an (local.get $n))\n";
    o = o + "      (if (i64.lt_s (local.get $an) (i64.const 0)) (then (local.set $an (i64.sub (i64.const 0) (local.get $an)))))\n";
    o = o + "      (if (i64.le_s (local.get $an) (i64.const 64)) (then\n";
    o = o + "        (local.set $acc (f64.const 1.0))\n";
    o = o + "        (local.set $base (local.get $x))\n";
    o = o + "        (block $done (loop $lp\n";
    o = o + "          (if (i64.eq (i64.and (local.get $an) (i64.const 1)) (i64.const 1)) (then (local.set $acc (f64.mul (local.get $acc) (local.get $base)))))\n";
    o = o + "          (local.set $base (f64.mul (local.get $base) (local.get $base)))\n";
    o = o + "          (local.set $an (i64.shr_u (local.get $an) (i64.const 1)))\n";
    o = o + "          (br_if $done (i64.eqz (local.get $an)))\n";
    o = o + "          (br $lp)))\n";
    o = o + "        (if (i64.lt_s (local.get $n) (i64.const 0)) (then (local.set $acc (f64.div (f64.const 1.0) (local.get $acc)))))\n";
    o = o + "        (return (local.get $acc))))))\n";
    o = o + "    (call $__fern_exp_f64 (f64.mul (local.get $y) (call $__fern_log_f64 (local.get $x)))))\n";
    return o;
}

// trig_reduce_and_polys emits the shared reduction plus sin(r)/cos(r) for
// $__fern_sin_f64 / $__fern_cos_f64. Locals are declared by the caller.
// The cos form's (1-w)-hz step recovers the bits 1-hz discards; computing
// 1 - hz + z*z*p directly costs ~2 ulp.
function trig_reduce_and_polys(): string {
    var o: string = "";    o = o + "    (local.set $k (f64.nearest (f64.mul (local.get $x) (f64.const 0.636619772367581382433))))\n";
    o = o + "    (local.set $q (i64.and (i64.trunc_f64_s (local.get $k)) (i64.const 3)))\n";
    o = o + "    (local.set $r (f64.sub (f64.sub (f64.sub (local.get $x) (f64.mul (local.get $k) (f64.const 1.57079632673412561417))) (f64.mul (local.get $k) (f64.const 6.07710050630396597660e-11))) (f64.mul (local.get $k) (f64.const 2.02226624879595063154e-21))))\n";
    o = o + "    (local.set $r2 (f64.mul (local.get $r) (local.get $r)))\n";
    o = o + "    (local.set $sinr (f64.const 1.58969099521155010221e-10))\n";
    o = o + "    (local.set $sinr (f64.add (f64.mul (local.get $sinr) (local.get $r2)) (f64.const -2.50507602534068634195e-08)))\n";
    o = o + "    (local.set $sinr (f64.add (f64.mul (local.get $sinr) (local.get $r2)) (f64.const 2.75573137070700676789e-06)))\n";
    o = o + "    (local.set $sinr (f64.add (f64.mul (local.get $sinr) (local.get $r2)) (f64.const -1.98412698298579493134e-04)))\n";
    o = o + "    (local.set $sinr (f64.add (f64.mul (local.get $sinr) (local.get $r2)) (f64.const 8.33333333332248946124e-03)))\n";
    o = o + "    (local.set $sinr (f64.add (f64.mul (local.get $sinr) (local.get $r2)) (f64.const -1.66666666666666324348e-01)))\n";
    o = o + "    (local.set $sinr (f64.add (local.get $r) (f64.mul (local.get $sinr) (f64.mul (local.get $r2) (local.get $r)))))\n";
    o = o + "    (local.set $cosr (f64.const -1.13596475577881948265e-11))\n";
    o = o + "    (local.set $cosr (f64.add (f64.mul (local.get $cosr) (local.get $r2)) (f64.const 2.08757232129817482790e-09)))\n";
    o = o + "    (local.set $cosr (f64.add (f64.mul (local.get $cosr) (local.get $r2)) (f64.const -2.75573143513906633035e-07)))\n";
    o = o + "    (local.set $cosr (f64.add (f64.mul (local.get $cosr) (local.get $r2)) (f64.const 2.48015872894767294178e-05)))\n";
    o = o + "    (local.set $cosr (f64.add (f64.mul (local.get $cosr) (local.get $r2)) (f64.const -1.38888888888741095749e-03)))\n";
    o = o + "    (local.set $cosr (f64.add (f64.mul (local.get $cosr) (local.get $r2)) (f64.const 4.16666666666666019037e-02)))\n";
    o = o + "    (local.set $hz (f64.mul (f64.const 0.5) (local.get $r2)))\n";
    o = o + "    (local.set $cw (f64.sub (f64.const 1.0) (local.get $hz)))\n";
    o = o + "    (local.set $cosr (f64.add (local.get $cw) (f64.add (f64.sub (f64.sub (f64.const 1.0) (local.get $cw)) (local.get $hz)) (f64.mul (local.get $r2) (f64.mul (local.get $r2) (local.get $cosr))))))\n";
    return o;
}

// sin_func emits $__fern_sin_f64(x). NaN returns itself and +-Inf becomes NaN: there
// is no meaningful reduction of an infinite argument.
pub function sin_func(): string {
    var o: string = "";    o = o + "  (func $__fern_sin_f64 (param $x f64) (result f64)\n";
    o = o + "    (local $k f64) (local $q i64) (local $r f64) (local $r2 f64) (local $sinr f64) (local $cosr f64) (local $hz f64) (local $cw f64)\n";
    o = o + "    (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))\n";
    o = o + "    (if (f64.eq (f64.abs (local.get $x)) (f64.reinterpret_i64 (i64.const 9218868437227405312))) (then (return (f64.reinterpret_i64 (i64.const 9221120237041090560)))))\n";
    o = o + trig_reduce_and_polys();
    o = o + "    (if (i64.eq (local.get $q) (i64.const 0)) (then (return (local.get $sinr))))\n";
    o = o + "    (if (i64.eq (local.get $q) (i64.const 1)) (then (return (local.get $cosr))))\n";
    o = o + "    (if (i64.eq (local.get $q) (i64.const 2)) (then (return (f64.neg (local.get $sinr)))))\n";
    o = o + "    (f64.neg (local.get $cosr)))\n";
    return o;
}

// cos_func emits $__fern_cos_f64(x). NaN returns itself and +-Inf becomes NaN: there
// is no meaningful reduction of an infinite argument.
pub function cos_func(): string {
    var o: string = "";    o = o + "  (func $__fern_cos_f64 (param $x f64) (result f64)\n";
    o = o + "    (local $k f64) (local $q i64) (local $r f64) (local $r2 f64) (local $sinr f64) (local $cosr f64) (local $hz f64) (local $cw f64)\n";
    o = o + "    (if (f64.ne (local.get $x) (local.get $x)) (then (return (local.get $x))))\n";
    o = o + "    (if (f64.eq (f64.abs (local.get $x)) (f64.reinterpret_i64 (i64.const 9218868437227405312))) (then (return (f64.reinterpret_i64 (i64.const 9221120237041090560)))))\n";
    o = o + trig_reduce_and_polys();
    o = o + "    (if (i64.eq (local.get $q) (i64.const 0)) (then (return (local.get $cosr))))\n";
    o = o + "    (if (i64.eq (local.get $q) (i64.const 1)) (then (return (f64.neg (local.get $sinr)))))\n";
    o = o + "    (if (i64.eq (local.get $q) (i64.const 2)) (then (return (f64.neg (local.get $cosr)))))\n";
    o = o + "    (local.get $sinr))\n";
    return o;
}

// ---- moved verbatim from wasm.fern (#3457 slice 4 untangle) ----
// The wasi preview1 (import ...) declarations are IR-path-only (emitted only by
// emit_ir_module_units, one gated call each) and pure WAT strings with no deps,
// so they live here in the IR emitter, not the AST emitter wasm.fern #3457 deletes.
// random_get_import / random_bytes_ir_func / random_i32_func / str_bytes_func
// are the IR-path byte-source helpers (issue #2747). They are kept SEPARATE
// from random_helpers / random_func (the AST path's bundle, whose
// $__fern_random_bytes returns a u8[] array) because the IR path types
// random_bytes as a string: random_bytes_ir_func builds a `[len][bytes]` string
// block so str_index / str_len read it correctly, matching the register
// backends. The wasm_ir_run driver emits these gated by module_emits_op; a
// single compile picks one path, so the shared $__fern_random_* symbols never
// clash.
pub function random_get_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"random_get\" (func $random_get (param i32 i32) (result i32)))\n";
}
// stat_import emits the preview1 path_filestat_get import (separate from
// file_imports, which read_file/write_file own, so a stat-only module doesn't
// pull path_open/fd_read).
pub function stat_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"path_filestat_get\" (func $path_filestat_get (param i32 i32 i32 i32 i32) (result i32)))\n";
}
// remove_file_import emits the preview1 path_unlink_file import (separate from
// file_imports, so a remove_file-only module doesn't pull in path_open/fd_read).
pub function remove_file_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"path_unlink_file\" (func $path_unlink_file (param i32 i32 i32) (result i32)))\n";
}
// readdir_fd_import emits the preview1 fd_readdir import that $__fern_read_dir
// uses. path_open / fd_close come from file_imports (emitted once for any module
// doing path-based file I/O OR read_dir — an unused fd_read import there is valid
// wasm), so this adds only the fd_readdir entry, avoiding a double import.
pub function readdir_fd_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"fd_readdir\" (func $fd_readdir (param i32 i32 i32 i64 i32) (result i32)))\n";
}
// remove_dir_import emits the preview1 path_remove_directory import that
// $__fern_remove_dir_all uses to rmdir a now-empty directory. path_open /
// fd_close (file_imports), fd_readdir (readdir_fd_import) and path_unlink_file
// (remove_file_import) are shared with the other fs ops; the caller emits each of
// those bundles once across the union of ops that need them, so this adds only the
// path_remove_directory entry.
pub function remove_dir_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"path_remove_directory\" (func $path_remove_directory (param i32 i32 i32) (result i32)))\n";
}
// temp_dir_import emits the preview1 path_create_directory import that
// $__fern_temp_dir uses to mkdir the unique directory under the preopen.
pub function temp_dir_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"path_create_directory\" (func $path_create_directory (param i32 i32 i32) (result i32)))\n";
}
// sleep_ms_import emits the preview1 poll_oneoff import that $__fern_sleep_ms
// uses to block on a monotonic-clock timeout.
pub function sleep_ms_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"poll_oneoff\" (func $poll_oneoff (param i32 i32 i32 i32) (result i32)))\n";
}
// stdin_fd_read_import emits the standalone wasi fd_read import that read_line /
// read_int use to read stdin (fd 0). file_imports ALSO imports fd_read for
// read_file, so the caller (wasm_ir_run) must emit only one of the two — this
// one when the module reads stdin but does NOT do path-based file I/O.
pub function stdin_fd_read_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"fd_read\" (func $fd_read (param i32 i32 i32 i32) (result i32)))\n";
}
// reader_fd_close_import emits the standalone wasi fd_close import that
// $__fern_reader_close uses. file_imports ALSO imports fd_close (for path I/O),
// so the caller (wasm_ir_run) emits this one ONLY when a reader-closing module
// does NOT do path-based file I/O — otherwise fd_close would be imported twice.
pub function reader_fd_close_import(): string {
    return "  (import \"wasi_snapshot_preview1\" \"fd_close\" (func $fd_close (param i32) (result i32)))\n";
}

// $__fern_random_bytes(n) -> a fresh `[len][bytes]` string block of n CSPRNG
// bytes. Allocates 4+n bytes via $__fern_str_box, stores len@0, fills bytes@4
// from random_get.
pub function random_bytes_ir_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_random_bytes (param $n i32) (result i32)\n";
    o = o + "    (local $s i32)\n";
    o = o + "    (local.set $s (call $__fern_str_box (i32.add (i32.const 4) (local.get $n))))\n";
    o = o + "    (i32.store (local.get $s) (local.get $n))\n";
    o = o + "    (drop (call $random_get (i32.add (local.get $s) (i32.const 4)) (local.get $n)))\n";
    o = o + "    (local.get $s))\n";
    return o;
}

// $__fern_random_i32() -> one CSPRNG i32: fill 4 bytes at the low-memory scratch
// (addr 16, inside the reserved 24-byte scratch region) and load them.
pub function random_i32_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_random_i32 (result i32)\n";
    o = o + "    (drop (call $random_get (i32.const 16) (i32.const 4)))\n";
    o = o + "    (i32.load (i32.const 16)))\n";
    return o;
}

// $__fern_str_bytes(s) -> a fresh u8[] (`[len][cap][i32 elems]`) holding the
// bytes of string block `s`. Backs both bytes() and as_bytes() (the slot-array
// model has no zero-copy slice view). Reads bytes from s+4+i (the [len][bytes]
// layout), stores each zero-extended into the array's 4-byte slot at arr+8+i*4.
pub function str_bytes_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_bytes (param $s i32) (result i32)\n";
    o = o + "    (local $n i32) (local $arr i32) (local $i i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $s)))\n";
    o = o + "    (local.set $arr (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}

// stat_func emits $__fern_stat(path, fstype) -> Result[FileStat, IoError] box.
// path_filestat_get(preopen fd 3, symlink_follow, path bytes @path+4 / len @[path],
// into a 64-byte heap buffer); on error push Result.Err [tag1, payload0] (the same
// null-IoError the register backends use). On success read filetype@buf+16 (WASI:
// 3=directory, 4=regular_file) + size@buf+32 (i64 -> low i32), build the FileStat
// struct box [type_id@0, is_file@8, is_dir@16, size@24] (the IR struct layout; the
// type-id is the module-specific struct_type_id passed in by the op handler), and
// wrap it Result.Ok [tag0, payload=structptr]. Boxes via $__fern_str_box (the same
// rc-boxed [tag@0,payload@4] / struct shapes opt_make / struct_make build).
pub function stat_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_stat (param $path i32) (param $fstype i32) (result i32)\n";
    o = o + "    (local $err i32) (local $buf i32) (local $ft i32) (local $sz i64) (local $fs i32) (local $res i32)\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.const 64)))\n";
    o = o + "    (local.set $err (call $path_filestat_get (i32.const 3) (i32.const 1) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path)) (local.get $buf)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $res) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
    o = o + "      (return (local.get $res))))\n";
    o = o + "    (local.set $ft (i32.load8_u (i32.add (local.get $buf) (i32.const 16))))\n";
    // WASI filestat size is an i64 at buf+32; FileStat.size is i64, so load the
    // full 8 bytes and i64.store it into the size@24 slot (a >2 GiB file would
    // truncate under the old low-32-bit i32 load/store).
    o = o + "    (local.set $sz (i64.load (i32.add (local.get $buf) (i32.const 32))))\n";
    o = o + "    (local.set $fs (call $__fern_str_box (i32.const 32)))\n";
    o = o + "    (i32.store (local.get $fs) (local.get $fstype))\n";
    o = o + "    (i32.store (i32.add (local.get $fs) (i32.const 8)) (i32.eq (local.get $ft) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.add (local.get $fs) (i32.const 16)) (i32.eq (local.get $ft) (i32.const 3)))\n";
    o = o + "    (i64.store (i32.add (local.get $fs) (i32.const 24)) (local.get $sz))\n";
    o = o + "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $res) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $res) (i32.const 4)) (local.get $fs))\n";
    o = o + "    (local.get $res))\n";
    return o;
}
// remove_file_func emits $__fern_remove_file(path) -> Result[(), IoError] box.
// path_unlink_file(preopen fd 3, path bytes @path+4 / len @[path]) unlinks the
// file; on success (errno 0) push Result.Ok [tag0, unit payload 0], else push
// Result.Err(IoError) [tag1, payload]. Result's tag convention matches the
// register backends: Ok=0, Err=1. Boxes via $__fern_str_box (the rc-boxed
// [tag@0,payload@4] shape).
pub function remove_file_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_remove_file (param $path i32) (result i32)\n";
    o = o + "    (local $err i32) (local $res i32)\n";
    o = o + "    (local.set $err (call $path_unlink_file (i32.const 3) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path))))\n";
    o = o + "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (if (i32.eq (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (i32.store (local.get $res) (i32.const 0))\n";
    o = o + "      (i32.store (i32.add (local.get $res) (i32.const 4)) (i32.const 0))\n";
    o = o + "      (return (local.get $res))))\n";
    o = o + "    (i32.store (local.get $res) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
    o = o + "    (local.get $res))\n";
    return o;
}
// read_dir_func emits $__fern_read_dir(path) -> Result[string[], IoError] box.
// path_open(preopen fd 3, FD_READDIR right) the directory, then loop fd_readdir
// over the WASI dirent stream (dirent header is 24 bytes: d_next u64 @0, d_ino
// u64 @8, d_namlen u32 @16, d_type u8 @20; the name's d_namlen bytes follow),
// skipping "." / "..", building a string[] via $__fern_arr_push (each entry a
// fresh [len][bytes] block). The cookie loop pages through large directories and
// resumes from the last COMPLETE entry when fd_readdir truncates the trailing
// name (bufused == buflen). On path_open failure push Result.Err [tag1, errno];
// otherwise Result.Ok [tag0, arrayptr]. The readdir buffer is alloc'd once before
// the loop, so the name/array allocations that follow it never overlap the bytes
// a later fd_readdir page overwrites. Needs the heap runtime + $__fern_arr_push.
pub function read_dir_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_read_dir (param $path i32) (result i32)\n";
    o = o + "    (local $err i32) (local $fd i32) (local $arr i32) (local $buf i32)\n";
    o = o + "    (local $cookie i64) (local $lastnext i64) (local $used i32) (local $pos i32)\n";
    o = o + "    (local $namlen i32) (local $nameptr i32) (local $blk i32) (local $i i32) (local $skip i32) (local $res i32)\n";
    // path_open: dirflags = symlink_follow (1), oflags = 0, rights_base =
    // FD_READDIR (1<<14 = 16384). fd written to scratch addr 16.
    o = o + "    (local.set $err (call $path_open (i32.const 3) (i32.const 1) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path)) (i32.const 0) (i64.const 16384) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $res) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $path)))\n";
    o = o + "      (return (local.get $res))))\n";
    o = o + "    (local.set $fd (i32.load (i32.const 16)))\n";
    // Empty string[] (len = cap = 0); $__fern_arr_push grows it.
    o = o + "    (local.set $arr (call $__fern_arr_box (i32.const 0)))\n";
    o = o + "    (i32.store (local.get $arr) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.const 4096)))\n";
    o = o + "    (local.set $cookie (i64.const 0))\n";
    o = o + "    (block $rdone (loop $rloop\n";
    o = o + "      (drop (call $fd_readdir (local.get $fd) (local.get $buf) (i32.const 4096) (local.get $cookie) (i32.const 8)))\n";
    o = o + "      (local.set $used (i32.load (i32.const 8)))\n";
    o = o + "      (br_if $rdone (i32.eqz (local.get $used)))\n";
    o = o + "      (local.set $pos (i32.const 0))\n";
    o = o + "      (local.set $lastnext (local.get $cookie))\n";
    o = o + "      (block $pdone (loop $ploop\n";
    // Need a full 24-byte dirent header.
    o = o + "        (br_if $pdone (i32.gt_u (i32.add (local.get $pos) (i32.const 24)) (local.get $used)))\n";
    o = o + "        (local.set $lastnext (i64.load (i32.add (local.get $buf) (local.get $pos))))\n";
    o = o + "        (local.set $namlen (i32.load (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 16)))))\n";
    // Name must be fully present, else fd_readdir truncated it — stop and resume.
    o = o + "        (br_if $pdone (i32.gt_u (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)) (local.get $used)))\n";
    o = o + "        (local.set $nameptr (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 24))))\n";
    // Skip "." and "..".
    o = o + "        (local.set $skip (i32.const 0))\n";
    o = o + "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 1)) (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46))) (then (local.set $skip (i32.const 1))))\n";
    o = o + "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 2)) (i32.and (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46)) (i32.eq (i32.load8_u (i32.add (local.get $nameptr) (i32.const 1))) (i32.const 46)))) (then (local.set $skip (i32.const 1))))\n";
    o = o + "        (if (i32.eqz (local.get $skip)) (then\n";
    o = o + "          (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $namlen))))\n";
    o = o + "          (i32.store (local.get $blk) (local.get $namlen))\n";
    o = o + "          (local.set $i (i32.const 0))\n";
    o = o + "          (block $cd (loop $cc\n";
    o = o + "            (br_if $cd (i32.ge_u (local.get $i) (local.get $namlen)))\n";
    o = o + "            (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (local.get $nameptr) (local.get $i))))\n";
    o = o + "            (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "            (br $cc)))\n";
    o = o + "          (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $blk)))))\n";
    o = o + "        (local.set $pos (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)))\n";
    o = o + "        (br $ploop)))\n";
    // bufused < buflen => the whole directory fit; otherwise resume from the last
    // complete entry's cookie.
    o = o + "      (br_if $rdone (i32.lt_u (local.get $used) (i32.const 4096)))\n";
    o = o + "      (local.set $cookie (local.get $lastnext))\n";
    o = o + "      (br $rloop)))\n";
    o = o + "    (drop (call $fd_close (local.get $fd)))\n";
    o = o + "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $res) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $res) (i32.const 4)) (local.get $arr))\n";
    o = o + "    (local.get $res))\n";
    return o;
}
// remove_dir_func emits $__fern_remove_dir_all(path) -> Result[(), IoError] box — a
// recursive rm -rf, the wasm sibling of asm_ir's __fern_remove_dir_all. It first
// path_open(oflags = O_DIRECTORY 2, FD_READDIR right)s the path: success => it's a
// directory; ENOTDIR (54) => it's a file, path_unlink_file it; ENOENT (44) => it
// is already gone (Ok — rm -rf ignores a missing path); any other errno => Err.
// For a directory it enumerates ALL child base names via an fd_readdir cookie loop
// (skipping . / ..) into a string[] FIRST and fd_closes — so the directory is not
// mutated while it is being iterated — then for each child builds `path + "/" +
// name` and RECURSES (the recursion classifies file vs dir itself), and finally
// path_remove_directorys the now-empty path. Child / rmdir results are best-effort
// (ignored), matching the register backends. Recursion is scratch-safe: the addr-8
// (bufused) and addr-16 (fd) scratch are only live during this frame's enumeration
// phase, which finishes before any recursive call. Two tiny $__rda_ok /
// $__rda_err helpers build the Result box (Ok = tag0, Err = tag1, matching
// remove_file). Needs the heap runtime + $__fern_arr_push.
pub function remove_dir_func(): string {
    var o: string = "";
    // Result-box constructors (shared by every return site).
    o = o + "  (func $__rda_ok (result i32)\n";
    o = o + "    (local $r i32)\n";
    o = o + "    (local.set $r (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $r) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $r) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.get $r))\n";
    o = o + "  (func $__rda_err (param $e i32) (result i32)\n";
    o = o + "    (local $r i32)\n";
    o = o + "    (local.set $r (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $r) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $r) (i32.const 4)) (local.get $e))\n";
    o = o + "    (local.get $r))\n";
    o = o + "  (func $__fern_remove_dir_all (param $path i32) (result i32)\n";
    o = o + "    (local $err i32) (local $fd i32) (local $names i32) (local $buf i32)\n";
    o = o + "    (local $cookie i64) (local $lastnext i64) (local $used i32) (local $pos i32)\n";
    o = o + "    (local $namlen i32) (local $nameptr i32) (local $blk i32) (local $i i32) (local $skip i32)\n";
    o = o + "    (local $plen i32) (local $nm i32) (local $child i32) (local $j i32)\n";
    // Try to open as a directory (oflags = O_DIRECTORY = 2, rights = FD_READDIR).
    o = o + "    (local.set $err (call $path_open (i32.const 3) (i32.const 1) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path)) (i32.const 2) (i64.const 16384) (i64.const 0) (i32.const 0) (i32.const 16)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (if (i32.eq (local.get $err) (i32.const 44)) (then (return (call $__rda_ok))))\n";
    o = o + "      (if (i32.eq (local.get $err) (i32.const 54)) (then\n";
    o = o + "        (drop (call $path_unlink_file (i32.const 3) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path))))\n";
    o = o + "        (return (call $__rda_ok))))\n";
    o = o + "      (return (call $__rda_err (call $__fern_build_io_error (local.get $err) (local.get $path))))))\n";
    o = o + "    (local.set $fd (i32.load (i32.const 16)))\n";
    // Enumerate all child names into a string[] (empty to grow).
    o = o + "    (local.set $names (call $__fern_arr_box (i32.const 0)))\n";
    o = o + "    (i32.store (local.get $names) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $names) (i32.const 4)) (i32.const 0))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.const 4096)))\n";
    o = o + "    (local.set $cookie (i64.const 0))\n";
    o = o + "    (block $rdone (loop $rloop\n";
    o = o + "      (drop (call $fd_readdir (local.get $fd) (local.get $buf) (i32.const 4096) (local.get $cookie) (i32.const 8)))\n";
    o = o + "      (local.set $used (i32.load (i32.const 8)))\n";
    o = o + "      (br_if $rdone (i32.eqz (local.get $used)))\n";
    o = o + "      (local.set $pos (i32.const 0))\n";
    o = o + "      (local.set $lastnext (local.get $cookie))\n";
    o = o + "      (block $pdone (loop $ploop\n";
    o = o + "        (br_if $pdone (i32.gt_u (i32.add (local.get $pos) (i32.const 24)) (local.get $used)))\n";
    o = o + "        (local.set $lastnext (i64.load (i32.add (local.get $buf) (local.get $pos))))\n";
    o = o + "        (local.set $namlen (i32.load (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 16)))))\n";
    o = o + "        (br_if $pdone (i32.gt_u (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)) (local.get $used)))\n";
    o = o + "        (local.set $nameptr (i32.add (local.get $buf) (i32.add (local.get $pos) (i32.const 24))))\n";
    o = o + "        (local.set $skip (i32.const 0))\n";
    o = o + "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 1)) (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46))) (then (local.set $skip (i32.const 1))))\n";
    o = o + "        (if (i32.and (i32.eq (local.get $namlen) (i32.const 2)) (i32.and (i32.eq (i32.load8_u (local.get $nameptr)) (i32.const 46)) (i32.eq (i32.load8_u (i32.add (local.get $nameptr) (i32.const 1))) (i32.const 46)))) (then (local.set $skip (i32.const 1))))\n";
    o = o + "        (if (i32.eqz (local.get $skip)) (then\n";
    o = o + "          (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $namlen))))\n";
    o = o + "          (i32.store (local.get $blk) (local.get $namlen))\n";
    o = o + "          (local.set $i (i32.const 0))\n";
    o = o + "          (block $cd (loop $cc\n";
    o = o + "            (br_if $cd (i32.ge_u (local.get $i) (local.get $namlen)))\n";
    o = o + "            (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (local.get $nameptr) (local.get $i))))\n";
    o = o + "            (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "            (br $cc)))\n";
    o = o + "          (local.set $names (call $__fern_arr_push (local.get $names) (local.get $blk)))))\n";
    o = o + "        (local.set $pos (i32.add (i32.add (local.get $pos) (i32.const 24)) (local.get $namlen)))\n";
    o = o + "        (br $ploop)))\n";
    o = o + "      (br_if $rdone (i32.lt_u (local.get $used) (i32.const 4096)))\n";
    o = o + "      (local.set $cookie (local.get $lastnext))\n";
    o = o + "      (br $rloop)))\n";
    o = o + "    (drop (call $fd_close (local.get $fd)))\n";
    // Remove each child: build `path + "/" + name`, recurse (file -> unlink, dir
    // -> recurse), ignoring the per-child result (best effort).
    o = o + "    (local.set $plen (i32.load (local.get $path)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dd (loop $dc\n";
    o = o + "      (br_if $dd (i32.ge_s (local.get $i) (i32.load (local.get $names))))\n";
    o = o + "      (local.set $nm (i32.load (i32.add (i32.add (local.get $names) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $namlen (i32.load (local.get $nm)))\n";
    o = o + "      (local.set $child (call $__fern_alloc (i32.add (i32.const 4) (i32.add (i32.add (local.get $plen) (i32.const 1)) (local.get $namlen)))))\n";
    o = o + "      (i32.store (local.get $child) (i32.add (i32.add (local.get $plen) (i32.const 1)) (local.get $namlen)))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $p1d (loop $p1c\n";
    o = o + "        (br_if $p1d (i32.ge_u (local.get $j) (local.get $plen)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $child) (i32.const 4)) (local.get $j)) (i32.load8_u (i32.add (i32.add (local.get $path) (i32.const 4)) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $p1c)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $child) (i32.const 4)) (local.get $plen)) (i32.const 47))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $p2d (loop $p2c\n";
    o = o + "        (br_if $p2d (i32.ge_u (local.get $j) (local.get $namlen)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (i32.add (local.get $child) (i32.const 4)) (i32.add (local.get $plen) (i32.const 1))) (local.get $j)) (i32.load8_u (i32.add (i32.add (local.get $nm) (i32.const 4)) (local.get $j))))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $p2c)))\n";
    o = o + "      (drop (call $__fern_remove_dir_all (local.get $child)))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $dc)))\n";
    o = o + "    (drop (call $path_remove_directory (i32.const 3) (i32.add (local.get $path) (i32.const 4)) (i32.load (local.get $path))))\n";
    o = o + "    (call $__rda_ok))\n";
    return o;
}
// map_iter_helpers emits the wasm IR map-iterator runtime: $__fern_map_iter +
// the four accessors $__fern_mapiter_has_next / _key / _value / _advance. The
// register backends (x86-64 / arm64) iterate their PARALLEL-ARRAY maps lazily
// (cursor straight into the live keys[]/vals[]); a wasm map is a HASH map with
// gaps, so instead the iterator MATERIALIZES the live entries up front via the
// existing $__fern_map_keys / $__fern_map_values (which $__fern_map_snapshot
// compacts in matching slot order, so keys[j] pairs with values[j]). The
// iterator box is [keys@0, vals@4, cursor@8] (12 bytes); has_next compares the
// cursor to keys.len (len @ keys+0), key/value index the snapshot arrays (elems
// @ arr+8, 4-byte slots — i32 or string pointer alike), and advance bumps the
// stored cursor in place (the box is re-read each loop turn). Reuses map_helpers
// (emitted for any map module), so it pulls in no new structural runtime.
pub function map_iter_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_map_iter (param $map i32) (result i32)\n";
    o = o + "    (local $box i32)\n";
    o = o + "    (local.set $box (call $__fern_alloc (i32.const 12)))\n";
    o = o + "    (i32.store (local.get $box) (call $__fern_map_keys (local.get $map)))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 4)) (call $__fern_map_values (local.get $map)))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 8)) (i32.const 0))\n";
    o = o + "    (local.get $box))\n";
    // has_next: cursor (box@8) < keys.len (len @ keys+0, keys = box@0)
    o = o + "  (func $__fern_mapiter_has_next (param $box i32) (result i32)\n";
    o = o + "    (i32.lt_s (i32.load (i32.add (local.get $box) (i32.const 8))) (i32.load (i32.load (local.get $box)))))\n";
    // key: keys[cursor] — keys = box@0, element at keys + 8 + cursor*4
    o = o + "  (func $__fern_mapiter_key (param $box i32) (result i32)\n";
    o = o + "    (i32.load (i32.add (i32.add (i32.load (local.get $box)) (i32.const 8)) (i32.mul (i32.load (i32.add (local.get $box) (i32.const 8))) (i32.const 4)))))\n";
    // value: values[cursor] — values = box@4
    o = o + "  (func $__fern_mapiter_value (param $box i32) (result i32)\n";
    o = o + "    (i32.load (i32.add (i32.add (i32.load (i32.add (local.get $box) (i32.const 4))) (i32.const 8)) (i32.mul (i32.load (i32.add (local.get $box) (i32.const 8))) (i32.const 4)))))\n";
    // advance: box@8 += 1; push a dummy (the statement drops it)
    o = o + "  (func $__fern_mapiter_advance (param $box i32) (result i32)\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 8)) (i32.add (i32.load (i32.add (local.get $box) (i32.const 8))) (i32.const 1)))\n";
    o = o + "    (i32.const 0))\n";
    return o;
}
// sleep_ms_func emits $__fern_sleep_ms(ms) -> i32 (a dummy the statement drops,
// mirroring the x86 push). Where the register backends nanosleep a timespec, wasm
// preview1 has no sleep syscall — but a bare timed block needs only poll_oneoff
// with a SINGLE monotonic-clock subscription (NOT the wasi:io/poll multiplexer the
// reactor needs). ms <= 0 returns immediately. Builds one preview1 `subscription`
// in a fresh heap buffer (userdata u64 @0, eventtype tag u8 @8 = 0/clock, then the
// subscription_clock at @16: clockid u32 @16 = 1/monotonic, timeout u64 @24 =
// ms·1e6 ns, precision u64 @32 = 0, subclockflags u16 @40 = 0/RELATIVE), with the
// 32-byte event-out at @48 and the nevents slot at @80, and poll_oneoff blocks for
// the timeout. Heap-backed (the buffer), so gated into the heap runtime.
pub function sleep_ms_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_sleep_ms (param $ms i32) (result i32)\n";
    o = o + "    (local $buf i32)\n";
    o = o + "    (if (i32.gt_s (local.get $ms) (i32.const 0)) (then\n";
    o = o + "      (local.set $buf (call $__fern_alloc (i32.const 88)))\n";
    o = o + "      (i64.store (local.get $buf) (i64.const 0))\n";
    o = o + "      (i32.store8 (i32.add (local.get $buf) (i32.const 8)) (i32.const 0))\n";
    o = o + "      (i32.store (i32.add (local.get $buf) (i32.const 16)) (i32.const 1))\n";
    o = o + "      (i64.store (i32.add (local.get $buf) (i32.const 24)) (i64.mul (i64.extend_i32_s (local.get $ms)) (i64.const 1000000)))\n";
    o = o + "      (i64.store (i32.add (local.get $buf) (i32.const 32)) (i64.const 0))\n";
    o = o + "      (i32.store16 (i32.add (local.get $buf) (i32.const 40)) (i32.const 0))\n";
    o = o + "      (drop (call $poll_oneoff (local.get $buf) (i32.add (local.get $buf) (i32.const 48)) (i32.const 1) (i32.add (local.get $buf) (i32.const 80))))))\n";
    o = o + "    (i32.const 0))\n";
    return o;
}
// temp_dir_func emits $__fern_temp_dir(prefix) -> Result[string, IoError] box.
// Builds a unique name `<prefix>-<monotonic_ns>` and path_create_directorys it
// under the preopen (fd 3), returning Ok(name) / Err(IoError). Mirrors asm_ir's
// __fern_temp_dir EXCEPT it drops the absolute "/tmp/" prefix: wasm has no global
// /tmp, only the preopen, so the returned path is preopen-RELATIVE — exactly the
// model every other wasm fs op (stat / read_dir / remove_file / remove_dir_all)
// already uses, so the name round-trips through those ops within the sandbox. The
// ns suffix is converted to decimal inline (count digits, then write right-to-
// left). Needs the heap runtime ($__fern_str_box / $__fern_alloc), the clock
// runtime ($__fern_monotonic_ns) and path_create_directory.
pub function temp_dir_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_temp_dir (param $prefix i32) (result i32)\n";
    o = o + "    (local $ns i64) (local $tmp i64) (local $nd i32) (local $plen i32) (local $tot i32)\n";
    o = o + "    (local $blk i32) (local $base i32) (local $i i32) (local $err i32) (local $res i32)\n";
    o = o + "    (local.set $ns (call $__fern_monotonic_ns))\n";
    o = o + "    (local.set $plen (i32.load (local.get $prefix)))\n";
    // Count decimal digits of ns (>= 1).
    o = o + "    (local.set $tmp (local.get $ns))\n";
    o = o + "    (local.set $nd (i32.const 1))\n";
    o = o + "    (block $cd (loop $cl\n";
    o = o + "      (local.set $tmp (i64.div_u (local.get $tmp) (i64.const 10)))\n";
    o = o + "      (br_if $cd (i64.eqz (local.get $tmp)))\n";
    o = o + "      (local.set $nd (i32.add (local.get $nd) (i32.const 1)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (local.set $tot (i32.add (i32.add (local.get $plen) (i32.const 1)) (local.get $nd)))\n";
    // String block [len][bytes].
    o = o + "    (local.set $blk (call $__fern_alloc (i32.add (i32.const 4) (local.get $tot))))\n";
    o = o + "    (i32.store (local.get $blk) (local.get $tot))\n";
    // Copy prefix bytes.
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $pd (loop $pl\n";
    o = o + "      (br_if $pd (i32.ge_u (local.get $i) (local.get $plen)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $prefix) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $pl)))\n";
    // Separator '-'.
    o = o + "    (i32.store8 (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $plen)) (i32.const 45))\n";
    // ns decimal digits, written right-to-left into [base .. base+nd).
    o = o + "    (local.set $base (i32.add (i32.add (i32.add (local.get $blk) (i32.const 4)) (local.get $plen)) (i32.const 1)))\n";
    o = o + "    (local.set $tmp (local.get $ns))\n";
    o = o + "    (local.set $i (local.get $nd))\n";
    o = o + "    (block $wd (loop $wl\n";
    o = o + "      (br_if $wd (i32.eqz (local.get $i)))\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (i32.add (local.get $base) (local.get $i)) (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $tmp) (i64.const 10)))))\n";
    o = o + "      (local.set $tmp (i64.div_u (local.get $tmp) (i64.const 10)))\n";
    o = o + "      (br $wl)))\n";
    // mkdir under the preopen.
    o = o + "    (local.set $err (call $path_create_directory (i32.const 3) (i32.add (local.get $blk) (i32.const 4)) (local.get $tot)))\n";
    o = o + "    (if (i32.ne (local.get $err) (i32.const 0)) (then\n";
    o = o + "      (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "      (i32.store (local.get $res) (i32.const 1))\n";
    o = o + "      (i32.store (i32.add (local.get $res) (i32.const 4)) (call $__fern_build_io_error (local.get $err) (local.get $blk)))\n";
    o = o + "      (return (local.get $res))))\n";
    // Ok(path).
    o = o + "    (local.set $res (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $res) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $res) (i32.const 4)) (local.get $blk))\n";
    o = o + "    (local.get $res))\n";
    return o;
}

// strcat_streq_helpers emits ONLY $__fern_strcat + $__fern_streq — the two
// string helpers the IR path's str_concat / str_eq need. The full
// strcat_helpers bundle (below) also emits strcmp / split / predicate / case
// helpers that pull in array helpers ($__fern_arr_push) the IR runtime does not
// provide, so the IR path emits this narrow subset instead.
// substr_helper emits just $__fern_substr(s, start, end) -> a fresh block with
// s[start:end) copied. Used by the IR path's str_slice op (the full AST runtime
// gets it via strcat_helpers; the IR path emits the narrow strcat_streq_helpers,
// so it pulls substr in separately). Depends only on $__fern_str_box, which the
// heap runtime provides for string programs (module_allocates).
pub function substr_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_substr (param $s i32) (param $start i32) (param $end i32) (result i32)\n";
    o = o + "    (local $len i32) (local $p i32) (local $i i32)\n";
    o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $s))) (then (unreachable)))\n";
    o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (unreachable)))\n";
    o = o + "    (local.set $len (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $len))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $len))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $start) (local.get $i)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}
// memchr_helper emits $__fern_memchr(s, byte, from) -> the index of the first
// `byte` at or after `from`, or -1 (ATLAS-PLATFORM-PLAN §3).
//
// SCALAR, and that is the plan's ordering rather than an oversight: §3.4 makes
// the intrinsic total in every backend before making it fast in any, so no
// caller can be written against a lowering that does not exist yet. The native
// wasm backend serves the same meaning with a v128 kernel
// (i8x16.eq / i8x16.bitmask / i32.ctz); substituting one here is a later slice
// and changes nothing above this function.
//
// Reads only the source block ([len@0][bytes@4]) — no allocation, no calls, so
// it needs no runtime beyond itself.
pub function memchr_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_memchr (param $s i32) (param $byte i32) (param $from i32) (result i32)\n";
    o = o + "    (local $len i32) (local $i i32)\n";
    // A byte outside 0..255 can never appear in the haystack. Checked first so
    // the scan needs no per-iteration guard.
    o = o + "    (if (i32.or (i32.lt_s (local.get $byte) (i32.const 0)) (i32.gt_s (local.get $byte) (i32.const 255))) (then (return (i32.const -1))))\n";
    o = o + "    (local.set $len (i32.load (local.get $s)))\n";
    // `from` clamps rather than traps: negative behaves as 0.
    o = o + "    (local.set $i (local.get $from))\n";
    o = o + "    (if (i32.lt_s (local.get $i) (i32.const 0)) (then (local.set $i (i32.const 0))))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (if (i32.eq (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))) (local.get $byte)) (then (return (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.const -1))\n";
    return o;
}
// ascii_run_helper emits $__fern_ascii_run(s, from) -> the index of the first
// byte at or after `from` with its high bit set, or the LENGTH if the rest is
// ASCII (ATLAS-PLATFORM-PLAN §3, second kernel).
//
// SCALAR for memchr_helper's reason — §3.4 makes the intrinsic total in every
// backend before making it fast in any. The native wasm backend serves the same
// meaning with a v128 kernel, and that one is the cheapest of all six vector
// forms: i8x16.bitmask gathers the top bit of each byte, which IS this test, so
// it needs neither a splat nor a compare.
//
// `>= 128` rather than a sign test, because i32.load8_u zero-extends.
//
// Reads only the source block ([len@0][bytes@4]) — no allocation, no calls.
pub function ascii_run_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_ascii_run (param $s i32) (param $from i32) (result i32)\n";
    o = o + "    (local $len i32) (local $i i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $s)))\n";
    // `from` clamps rather than traps: negative behaves as 0.
    o = o + "    (local.set $i (local.get $from))\n";
    o = o + "    (if (i32.lt_s (local.get $i) (i32.const 0)) (then (local.set $i (i32.const 0))))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (if (i32.ge_u (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))) (i32.const 128)) (then (return (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    // The miss value is the LENGTH, not -1.
    o = o + "    (local.get $len))\n";
    return o;
}

// str_predicate_helpers emits the IR-path scalar string search predicates —
// $__fern_str_startswith / _endswith / _indexof — transcribed verbatim from the
// strcat_helpers bundle. All three only read the two string boxes (no
// allocation, no calls), so they're self-contained; the IR path emits them
// gated on module_emits_op(mod, "str_starts_with"|…) rather than pulling in the
// whole AST bundle. `s.contains(sub)` lowers to `(indexof … >= 0)` at the IR
// layer, so it needs only $__fern_str_indexof here.
pub function str_predicate_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_startswith (param $s i32) (param $p i32) (result i32)\n";
    o = o + "    (local $lp i32) (local $j i32)\n";
    o = o + "    (local.set $lp (i32.load (local.get $p)))\n";
    o = o + "    (if (i32.gt_u (local.get $lp) (i32.load (local.get $s))) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $j) (local.get $lp)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $j))) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $j)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.const 1))\n";
    o = o + "  (func $__fern_str_endswith (param $s i32) (param $p i32) (result i32)\n";
    o = o + "    (local $ls i32) (local $lp i32) (local $off i32) (local $j i32)\n";
    o = o + "    (local.set $ls (i32.load (local.get $s)))\n";
    o = o + "    (local.set $lp (i32.load (local.get $p)))\n";
    o = o + "    (if (i32.gt_u (local.get $lp) (local.get $ls)) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $off (i32.sub (local.get $ls) (local.get $lp)))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d3 (loop $c3\n";
    o = o + "      (br_if $d3 (i32.ge_u (local.get $j) (local.get $lp)))\n";
    o = o + "      (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $off) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $j)))) (then (return (i32.const 0))))\n";
    o = o + "      (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "      (br $c3)))\n";
    o = o + "    (i32.const 1))\n";
    o = o + "  (func $__fern_str_indexof (param $s i32) (param $sub i32) (result i32)\n";
    o = o + "    (local $ls i32) (local $lsub i32) (local $i i32) (local $j i32) (local $ok i32)\n";
    o = o + "    (local.set $ls (i32.load (local.get $s)))\n";
    o = o + "    (local.set $lsub (i32.load (local.get $sub)))\n";
    o = o + "    (if (i32.eqz (local.get $lsub)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.gt_u (local.get $lsub) (local.get $ls)) (then (return (i32.const -1))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $od (loop $oc\n";
    o = o + "      (br_if $od (i32.gt_u (local.get $i) (i32.sub (local.get $ls) (local.get $lsub))))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (local.set $ok (i32.const 1))\n";
    o = o + "      (block $id (loop $ic\n";
    o = o + "        (br_if $id (i32.ge_u (local.get $j) (local.get $lsub)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sub) (i32.const 4)) (local.get $j)))) (then (local.set $ok (i32.const 0)) (br $id)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $ic)))\n";
    o = o + "      (if (local.get $ok) (then (return (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $oc)))\n";
    o = o + "    (i32.const -1))\n";
    return o;
}
// str_case_helpers emits the IR-path ASCII case transforms — $__fern_str_upper /
// _lower, transcribed verbatim from the strcat_helpers bundle. Each allocates a
// fresh block via $__fern_str_box and copies `s` case-flipping ASCII letters; no
// other deps, so they're self-contained. Gated on module_uses_str_case. (The wasm
// runtime symbols are $__fern_str_upper / _lower, distinct from the register
// backends' __fern_str_to_upper / _to_lower.)
pub function str_case_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_upper (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $p i32) (local $i i32) (local $ch i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $l))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.and (i32.ge_u (local.get $ch) (i32.const 97)) (i32.le_u (local.get $ch) (i32.const 122))) (then (local.set $ch (i32.sub (local.get $ch) (i32.const 32)))))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (local.get $ch))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    o = o + "  (func $__fern_str_lower (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $p i32) (local $i i32) (local $ch i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $l))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dl (loop $cl\n";
    o = o + "      (br_if $dl (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.and (i32.ge_u (local.get $ch) (i32.const 65)) (i32.le_u (local.get $ch) (i32.const 90))) (then (local.set $ch (i32.add (local.get $ch) (i32.const 32)))))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (local.get $ch))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cl)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}
// str_repeat_helper emits the IR-path $__fern_str_repeat(s, n) — n copies of `s`
// in a fresh block via $__fern_str_box, transcribed verbatim from the
// strcat_helpers bundle so the IR and AST paths agree byte-for-byte. Gated on
// module_uses_str_repeat.
pub function str_repeat_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_repeat (param $s i32) (param $n i32) (result i32)\n";
    o = o + "    (local $l i32) (local $total i32) (local $p i32) (local $k i32) (local $i i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $total (i32.mul (local.get $l) (local.get $n)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $total))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $total))\n";
    o = o + "    (local.set $k (i32.const 0))\n";
    o = o + "    (block $dk (loop $ck\n";
    o = o + "      (br_if $dk (i32.ge_s (local.get $k) (local.get $n)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $di (loop $ci\n";
    o = o + "        (br_if $di (i32.ge_u (local.get $i) (local.get $l)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (i32.add (i32.mul (local.get $k) (local.get $l)) (local.get $i))) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $ci)))\n";
    o = o + "      (local.set $k (i32.add (local.get $k) (i32.const 1)))\n";
    o = o + "      (br $ck)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}
// str_trim_helper emits the IR-path $__fern_str_trim(s) — a fresh block with `s`
// stripped of leading/trailing ASCII whitespace (space / tab / '\n' / '\r').
// wasm strings are inline blocks (no zero-copy view like the register backends'
// __fern_str_trim), so it COPIES the trimmed range into a fresh $__fern_str_box;
// the result (content + length) matches the register backends. wasm's AST path
// has no trim, so this is IR-only. Gated on module_uses_str_trim.
pub function str_trim_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_trim (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $start i32) (local $end i32) (local $nl i32) (local $p i32) (local $i i32) (local $ch i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $start (i32.const 0))\n";
    o = o + "    (block $df (loop $cf\n";
    o = o + "      (br_if $df (i32.ge_s (local.get $start) (local.get $l)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $start))))\n";
    o = o + "      (br_if $df (i32.eqz (i32.or (i32.or (i32.eq (local.get $ch) (i32.const 32)) (i32.eq (local.get $ch) (i32.const 9))) (i32.or (i32.eq (local.get $ch) (i32.const 10)) (i32.eq (local.get $ch) (i32.const 13))))))\n";
    o = o + "      (local.set $start (i32.add (local.get $start) (i32.const 1)))\n";
    o = o + "      (br $cf)))\n";
    o = o + "    (local.set $end (local.get $l))\n";
    o = o + "    (block $db (loop $cb\n";
    o = o + "      (br_if $db (i32.le_s (local.get $end) (local.get $start)))\n";
    o = o + "      (local.set $ch (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.sub (local.get $end) (i32.const 1)))))\n";
    o = o + "      (br_if $db (i32.eqz (i32.or (i32.or (i32.eq (local.get $ch) (i32.const 32)) (i32.eq (local.get $ch) (i32.const 9))) (i32.or (i32.eq (local.get $ch) (i32.const 10)) (i32.eq (local.get $ch) (i32.const 13))))))\n";
    o = o + "      (local.set $end (i32.sub (local.get $end) (i32.const 1)))\n";
    o = o + "      (br $cb)))\n";
    o = o + "    (local.set $nl (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $nl))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $nl))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dc (loop $cc\n";
    o = o + "      (br_if $dc (i32.ge_s (local.get $i) (local.get $nl)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $start) (local.get $i)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cc)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}
// str_reverse_helper emits the IR-path $__fern_str_reverse(s) — a fresh block
// with `s`'s bytes in reverse order, copied via $__fern_str_box. wasm's AST path
// has no reverse, so this is IR-only. Gated on module_uses_str_reverse.
pub function str_reverse_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_reverse (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $p i32) (local $i i32)\n";
    o = o + "    (local.set $l (i32.load (local.get $s)))\n";
    o = o + "    (local.set $p (call $__fern_str_box (i32.add (i32.const 4) (local.get $l))))\n";
    o = o + "    (i32.store (local.get $p) (local.get $l))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $l)))\n";
    o = o + "      (i32.store8 (i32.add (i32.add (local.get $p) (i32.const 4)) (local.get $i)) (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.sub (i32.sub (local.get $l) (local.get $i)) (i32.const 1)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    return o;
}
// str_lines_helper emits the IR-path $__fern_str_lines(s) — split s on '\n' then
// drop a trailing empty segment when s is empty or ends with '\n' (so "a\nb\n"
// is 2 lines). Builds a "\n" delim block, calls $__fern_str_split, then
// decrements the result array's len by the trim flag. Depends on
// $__fern_str_split (so the IR runtime also emits str_split_helper + substr_helper
// when lines is used) + $__fern_str_box. wasm AST has no lines, so IR-only. Gated
// on module_uses_str_lines.
pub function str_lines_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_lines (param $s i32) (result i32)\n";
    o = o + "    (local $l i32) (local $trim i32) (local $delim i32) (local $arr i32)\n";
