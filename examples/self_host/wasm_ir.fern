    o = o + "      (local.set $elem (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $el (i32.load (local.get $elem)))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
