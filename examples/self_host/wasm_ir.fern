    // exp(y·ln x)) reuses it, so its gate folds fpow in (emitted once).
    if (need(needs, "fexp") || need(needs, "fpow")) { out = out + exp_func(); }
    // $__fern_log_f64: ln x via a polynomial (same — self-contained f64 math).
    // fpow reuses it too, so its gate folds fpow in.
    if (need(needs, "flog") || need(needs, "fpow")) { out = out + log_func(); }
    // $__fern_pow_f64: x^y = exp(y·ln x) — composes the two helpers above.
    if (need(needs, "fpow")) { out = out + pow_func(); }
    // $__fern_sin_f64 / $__fern_cos_f64: trig via argument reduction + Taylor
    // polynomials (no transcendental wasm instruction). Self-contained f64 math.
    if (need(needs, "fsin")) { out = out + sin_func(); }
    if (need(needs, "fcos")) { out = out + cos_func(); }
    // $__fern_strcat + $__fern_streq (concat / equality); references
    // $__fern_str_box from heap_alloc_helpers, which module_allocates pulls
    // in for any string program.
    if (need(needs, "@uses_strings") || need(needs, "@uses_maps")) { out = out + strcat_streq_helpers(); }
    // $__fern_i32_to_str / _i64_to_str / _u64_to_str back `.to_string()` on an
