// strcmp_helper emits ONLY $__fern_strcmp (lexicographic -1/0/1). It is
// self-contained — it reads the two string boxes and calls nothing — so the IR
// path can pull in string ordering without the full strcat_helpers bundle
// (whose split/predicate helpers reference $__fern_arr_push and friends).
pub function strcmp_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_strcmp (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $la i32) (local $lb i32) (local $n i32) (local $i i32) (local $ca i32) (local $cb i32)\n";
    o = o + "    (local.set $la (i32.load (local.get $a)))\n";
    o = o + "    (local.set $lb (i32.load (local.get $b)))\n";
    o = o + "    (local.set $n (local.get $la))\n";
    o = o + "    (if (i32.lt_u (local.get $lb) (local.get $la)) (then (local.set $n (local.get $lb))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d2 (loop $c2\n";
    o = o + "      (br_if $d2 (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $ca (i32.load8_u (i32.add (i32.add (local.get $a) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (local.set $cb (i32.load8_u (i32.add (i32.add (local.get $b) (i32.const 4)) (local.get $i))))\n";
    o = o + "      (if (i32.lt_u (local.get $ca) (local.get $cb)) (then (return (i32.const -1))))\n";
    o = o + "      (if (i32.gt_u (local.get $ca) (local.get $cb)) (then (return (i32.const 1))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c2)))\n";
    o = o + "    (if (i32.lt_u (local.get $la) (local.get $lb)) (then (return (i32.const -1))))\n";
    o = o + "    (if (i32.gt_u (local.get $la) (local.get $lb)) (then (return (i32.const 1))))\n";
    o = o + "    (i32.const 0))\n";
    return o;
}

// arr_push_helper emits $__fern_arr_push: append a 4-byte slot (i32 OR a
// pointer — strings are one word on wasm32) to an array, growing the backing
// box (doubling cap) when full. It is the helper the IR `.append` (op
// "arr_push") lowers to, and str_split_helper builds its result array with it.
// The full AST-path arr_helpers bundle is not on the IR path, so this narrow
// helper stands alone there. Depends only on $__fern_arr_box (module_allocates).
pub function arr_push_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_push (param $a i32) (param $v i32) (result i32)\n";
    o = o + "    (local $len i32) (local $cap i32) (local $na i32) (local $ncap i32) (local $i i32) (local $rc i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $a)))\n";
    o = o + "    (local.set $cap (i32.load (i32.add (local.get $a) (i32.const 4))))\n";
    // #4873/#5325 containment gate (the wasm mirror of asm_ir's
    // .Larr_push_rc_ok): in-place append only for a SOLE-OWNER (rc == 1) or
    // immortal (bit-31, rc < 0 signed) receiver with spare capacity. A shared
    // (rc >= 2) receiver — the caller-side grow bracket inc'd it, or a counted
    // alias exists — takes the copy path even when capacity fits, leaving the
    // shared buffer untouched. Wasm-IR arrays are rc-headered via
    // $__fern_arr_box ([rc@0][bsz@4][len@8][cap@12], data = base+8), so the
    // rc word sits at [a-8]. An unheadered/garbage rc word fails the test and
    // merely takes the copy path — safe, never an in-place mutation.
    o = o + "    (local.set $rc (i32.load (i32.sub (local.get $a) (i32.const 8))))\n";
    o = o + "    (if (i32.and (i32.or (i32.eq (local.get $rc) (i32.const 1)) (i32.lt_s (local.get $rc) (i32.const 0))) (i32.lt_s (local.get $len) (local.get $cap))) (then\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (i32.const 4))) (local.get $v))\n";
    o = o + "      (i32.store (local.get $a) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (return (local.get $a))))\n";
    // Copy path: a shared receiver with spare capacity (len < cap) is an
    // UN-SHARE copy — keep the SAME cap instead of doubling (the #3425
    // arena-footprint lesson from the register port). True growth
    // (len >= cap) doubles (or starts at 4).
    o = o + "    (local.set $ncap (local.get $cap))\n";
    // Reaching the copy path with len < cap means the receiver was SHARED (the
    // in-place branch above already took every sole-owner-with-room case), so
    // this copy was bought by an extra reference rather than a full buffer:
    // the rc==1 cliff. Count it at arr_push_shared_addr — off the fast path,
    // one add on a run already about to copy the whole buffer.
    o = o + "    (if (i32.lt_s (local.get $len) (local.get $cap)) (then\n";
    o = o + "      (i32.store (i32.const " + util.i32_to_string(arr_push_shared_addr()) + ") (i32.add (i32.load (i32.const " + util.i32_to_string(arr_push_shared_addr()) + ")) (i32.const 1)))\n";
    // Weight the crossing by the len * 4 bytes the copy below is about to
    // move, accumulated as an i64 at arr_push_copied_addr.
    o = o + "      (i64.store (i32.const " + util.i32_to_string(arr_push_copied_addr()) + ") (i64.add (i64.load (i32.const " + util.i32_to_string(arr_push_copied_addr()) + ")) (i64.extend_i32_u (i32.mul (local.get $len) (i32.const 4)))))))\n";
    o = o + "    (if (i32.ge_s (local.get $len) (local.get $cap)) (then\n";
    o = o + "      (local.set $ncap (i32.const 4))\n";
    o = o + "      (if (i32.gt_s (local.get $cap) (i32.const 0)) (then (local.set $ncap (i32.mul (local.get $cap) (i32.const 2)))))))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $ncap) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $na) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $ncap))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $len) (i32.const 4))) (local.get $v))\n";
    o = o + "    (local.get $na))\n";
    return o;
}
// str_split_helper emits the IR-path string→string[] runtime: a private
// $__fern_arr_push (via arr_push_helper) plus $__fern_str_split, which builds
// the result array with that push and slices each segment via $__fern_substr
// (the IR runtime emits substr_helper alongside this). It is SELF-CONTAINED so
// callers need only gate on str_split; a program that ALSO uses `.append` must
// therefore emit the standalone arr_push_helper only when str_split is absent
// (otherwise $__fern_arr_push would be defined twice). Depends only on
// $__fern_str_box / $__fern_arr_box from the heap runtime (module_allocates).
// The split body is transcribed verbatim from the strcat_helpers bundle's
// $__fern_str_split.
pub function str_split_helper(): string {
    var o: string = arr_push_helper();
    o = o + "  (func $__fern_str_split (param $s i32) (param $sep i32) (result i32)\n";
    o = o + "    (local $sl i32) (local $sepl i32) (local $i i32) (local $start i32) (local $arr i32) (local $piece i32) (local $j i32) (local $match i32)\n";
    o = o + "    (local.set $sl (i32.load (local.get $s)))\n";
    o = o + "    (local.set $sepl (i32.load (local.get $sep)))\n";
    o = o + "    (local.set $arr (call $__fern_alloc (i32.const 8)))\n";
    o = o + "    (i32.store (local.get $arr) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (i32.const 0))\n";
    // Empty separator char-splits, matching std/string's `split` and the
    // interp ("abc" -> ["a","b","c"], "" -> []).
    o = o + "    (if (i32.eqz (local.get $sepl)) (then\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $d0 (loop $c0\n";
    o = o + "        (br_if $d0 (i32.ge_s (local.get $i) (local.get $sl)))\n";
    o = o + "        (local.set $piece (call $__fern_substr (local.get $s) (local.get $i) (i32.add (local.get $i) (i32.const 1))))\n";
    o = o + "        (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $c0)))\n";
    o = o + "      (return (local.get $arr))))\n";
    o = o + "    (local.set $start (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.gt_s (local.get $i) (i32.sub (local.get $sl) (local.get $sepl))))\n";
    o = o + "      (local.set $match (i32.const 1))\n";
    o = o + "      (local.set $j (i32.const 0))\n";
    o = o + "      (block $dm (loop $cm\n";
    o = o + "        (br_if $dm (i32.ge_s (local.get $j) (local.get $sepl)))\n";
    o = o + "        (if (i32.ne (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (i32.add (local.get $i) (local.get $j)))) (i32.load8_u (i32.add (i32.add (local.get $sep) (i32.const 4)) (local.get $j)))) (then (local.set $match (i32.const 0)) (br $dm)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))\n";
    o = o + "        (br $cm)))\n";
    o = o + "      (if (local.get $match) (then\n";
    o = o + "        (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $i)))\n";
    o = o + "        (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (local.get $sepl)))\n";
    o = o + "        (local.set $start (local.get $i)))\n";
    o = o + "      (else (local.set $i (i32.add (local.get $i) (i32.const 1)))))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.set $piece (call $__fern_substr (local.get $s) (local.get $start) (local.get $sl)))\n";
    o = o + "    (local.set $arr (call $__fern_arr_push (local.get $arr) (local.get $piece)))\n";
    o = o + "    (local.get $arr))\n";
    return o;
}
// str_join_helper emits ONLY $__fern_str_join(array, sep) — the shared worker,
// used directly by the AST path (strcat_helpers) and via the arr_str_join_helper
// shim on the IR path. It calls only $__fern_str_box (heap), which
// module_allocates already pulls in for any string+array module.
pub function str_join_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_join (param $a i32) (param $sep i32) (result i32)\n";
    o = o + "    (local $n i32) (local $sl i32) (local $total i32) (local $i i32) (local $p i32) (local $w i32) (local $elem i32) (local $el i32) (local $j i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $a)))\n";
    o = o + "    (local.set $sl (i32.load (local.get $sep)))\n";
    o = o + "    (local.set $total (i32.const 0))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $dt (loop $ct\n";
