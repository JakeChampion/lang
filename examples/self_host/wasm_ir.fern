    // its body). One gate each, so a module formatting only one width carries
    // only that formatter.
    if (need(needs, "@uses_i32_to_string")) { out = out + i32_to_string_helper(); }
    if (need(needs, "@uses_i64_to_string")) { out = out + i64_to_string_helper(); }
    if (need(needs, "@uses_u64_to_string")) { out = out + u64_to_string_helper(); }
    if (need(needs, "@uses_u32_to_string")) { out = out + u32_to_string_helper(); }
    // $__fern_now_ns / $__fern_now_unix_ms / $__fern_monotonic_ns back the
    // clock builtins (each result i64), reading the preview1 clock_time_get
    // import into the 8-byte scratch at addr 16 — emitted as a trio (the AST
    // path does the same) when the module reads any clock.
    if (mode != 2 && (need(needs, "monotonic_ns") || need(needs, "now_unix_ms") || need(needs, "now_ns") || need(needs, "temp_dir"))) { out = out + clock_funcs(); }
    // $__fern_args builds the argv string[] via the wasi args_get import +
