    o = o + "        (local.set $keys (i32.load (i32.add (local.get $box) (i32.const 8))))\n";
    o = o + "        (local.set $used (i32.load (i32.add (local.get $box) (i32.const 16))))\n";
    o = o + "        (local.set $i (i32.const 0))\n";
    o = o + "        (block $mkd (loop $mkl\n";
    o = o + "          (br_if $mkd (i32.ge_u (local.get $i) (local.get $cap)))\n";
    o = o + "          (if (i32.eq (i32.load (i32.add (local.get $used) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 1)) (then\n";
    o = o + "            (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $keys) (i32.mul (local.get $i) (i32.const 4))))))))\n";
    o = o + "          (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "          (br $mkl))))) \n";
    // String-valued map (vis@[box+28]==1): release each occupied slot's value
    // (construction-inc'd on insert) before freeing the vals buffer. Mirrors
    // the key loop + native __drop_map_str_values.
    o = o + "      (if (i32.load (i32.add (local.get $box) (i32.const 28))) (then\n";
    o = o + "        (local.set $cap (i32.load (i32.add (local.get $box) (i32.const 4))))\n";
    o = o + "        (local.set $vals (i32.load (i32.add (local.get $box) (i32.const 12))))\n";
    o = o + "        (local.set $used (i32.load (i32.add (local.get $box) (i32.const 16))))\n";
    o = o + "        (local.set $i (i32.const 0))\n";
    o = o + "        (block $mvd (loop $mvl\n";
    o = o + "          (br_if $mvd (i32.ge_u (local.get $i) (local.get $cap)))\n";
    o = o + "          (if (i32.eq (i32.load (i32.add (local.get $used) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 1)) (then\n";
    o = o + "            (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $vals) (i32.mul (local.get $i) (i32.const 4))))))))\n";
    o = o + "          (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "          (br $mvl))))) \n";
    o = o + "      (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $box) (i32.const 8)))))\n";
    o = o + "      (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $box) (i32.const 12)))))\n";
    o = o + "      (drop (call $__fern_arr_dec (i32.load (i32.add (local.get $box) (i32.const 16)))))))\n";
    o = o + "    (call $__fern_arr_dec (local.get $box)))\n";
    return o;
}

// divrem64_helpers mirrors divrem_helpers for 64-bit operands: the
// guarded `$__fern_idiv64` / `$__fern_irem64` used by i64 `/` and `%`.
// Same sanitise-divisor-to-1 + select-substitute scheme, with the i64
// INT_MIN sentinel (-9223372036854775808).
pub function divrem64_helpers(): string {
    var bad: string =
        "(i32.or (i64.eqz (local.get $b))"
        + " (i32.and (i64.eq (local.get $a) (i64.const -9223372036854775808))"
        + " (i64.eq (local.get $b) (i64.const -1))))";
    var out: string = "";
    out = out + "  (func $__fern_idiv64 (param $a i64) (param $b i64) (result i64)\n";
    out = out + "    (local $safe i64)\n";
    out = out + "    (local.set $safe (select (i64.const 1) (local.get $b) " + bad + "))\n";
    out = out + "    (select (i64.const 0) (i64.div_s (local.get $a) (local.get $safe)) (i64.eqz (local.get $b))))\n";
    out = out + "  (func $__fern_irem64 (param $a i64) (param $b i64) (result i64)\n";
    out = out + "    (local $safe i64)\n";
    out = out + "    (local.set $safe (select (i64.const 1) (local.get $b) " + bad + "))\n";
    out = out + "    (select (local.get $a) (i64.rem_s (local.get $a) (local.get $safe)) (i64.eqz (local.get $b))))\n";
    return out;
}
// print_int64_helper mirrors print_int_helper for i64 values, formatting
// into a 24-byte scratch buffer at `buf` (i64's widest decimal is 20
// chars incl. sign). No trailing newline.
pub function print_int64_helper(buf: i32): string {
    var b: string = util.i32_to_string(buf);
    var be: string = util.i32_to_string(buf + 24);
    var o: string = "";
    o = o + "  (func $__fern_print_int64 (param $n i64)\n";
    o = o + "    (local $i i32)\n";
    o = o + "    (local $neg i32)\n";
    o = o + "    (if (i64.eqz (local.get $n)) (then\n";
    o = o + "      (i32.store8 (i32.const " + b + ") (i32.const 48))\n";
    o = o + "      (i32.store (i32.const 0) (i32.const " + b + "))\n";
    o = o + "      (i32.store (i32.const 4) (i32.const 1))\n";
    o = o + "      (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "      (return)))\n";
    o = o + "    (local.set $neg (i64.lt_s (local.get $n) (i64.const 0)))\n";
    o = o + "    (if (local.get $neg) (then (local.set $n (i64.sub (i64.const 0) (local.get $n)))))\n";
    o = o + "    (local.set $i (i32.const " + be + "))\n";
    o = o + "    (block $done (loop $lp\n";
    o = o + "      (br_if $done (i64.eqz (local.get $n)))\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $i) (i32.wrap_i64 (i64.add (i64.const 48) (i64.rem_u (local.get $n) (i64.const 10)))))\n";
    o = o + "      (local.set $n (i64.div_u (local.get $n) (i64.const 10)))\n";
    o = o + "      (br $lp)))\n";
    o = o + "    (if (local.get $neg) (then\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $i) (i32.const 45))))\n";
    o = o + "    (i32.store (i32.const 0) (local.get $i))\n";
    o = o + "    (i32.store (i32.const 4) (i32.sub (i32.const " + be + ") (local.get $i)))\n";
    o = o + "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
    return o;
}
// print_int_helper emits the `$__fern_print_int` runtime: format an i32
// as decimal into a 16-byte scratch buffer at `buf` (placed above all
// string data) and fd_write it. Digits are written backwards from the
// buffer end; negatives get a leading '-'. The magnitude is taken with
// unsigned div/rem after a (possibly overflowing) negation, which yields
// the correct digits even for INT_MIN (0 - INT_MIN = INT_MIN, whose
// unsigned value is exactly 2147483648). No trailing newline — matching
// the native print_int.
pub function print_int_helper(buf: i32): string {
    var b: string = util.i32_to_string(buf);
    var be: string = util.i32_to_string(buf + 16);
    var o: string = "";
    o = o + "  (func $__fern_print_int (param $n i32)\n";
    o = o + "    (local $i i32)\n";
    o = o + "    (local $neg i32)\n";
    o = o + "    (if (i32.eqz (local.get $n)) (then\n";
    o = o + "      (i32.store8 (i32.const " + b + ") (i32.const 48))\n";
    o = o + "      (i32.store (i32.const 0) (i32.const " + b + "))\n";
    o = o + "      (i32.store (i32.const 4) (i32.const 1))\n";
    o = o + "      (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "      (return)))\n";
    o = o + "    (local.set $neg (i32.lt_s (local.get $n) (i32.const 0)))\n";
    o = o + "    (if (local.get $neg) (then (local.set $n (i32.sub (i32.const 0) (local.get $n)))))\n";
    o = o + "    (local.set $i (i32.const " + be + "))\n";
    o = o + "    (block $done (loop $lp\n";
    o = o + "      (br_if $done (i32.eqz (local.get $n)))\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $i) (i32.add (i32.const 48) (i32.rem_u (local.get $n) (i32.const 10))))\n";
    o = o + "      (local.set $n (i32.div_u (local.get $n) (i32.const 10)))\n";
    o = o + "      (br $lp)))\n";
    o = o + "    (if (local.get $neg) (then\n";
    o = o + "      (local.set $i (i32.sub (local.get $i) (i32.const 1)))\n";
    o = o + "      (i32.store8 (local.get $i) (i32.const 45))))\n";
    o = o + "    (i32.store (i32.const 0) (local.get $i))\n";
    o = o + "    (i32.store (i32.const 4) (i32.sub (i32.const " + be + ") (local.get $i)))\n";
    o = o + "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
    return o;
}
// heap_alloc_helpers emits the bump allocator: a `$heap` global starting
// at `heap_base` (above all static data) and `$__fern_alloc` which bumps
// it. Shared by string concat and array allocation.
pub function heap_alloc_helpers(heap_base: i32, fl_base: i32, fl_cells: i32): string {
    var hb: string = util.i32_to_string(heap_base);
    var flb: string = util.i32_to_string(fl_base);
    var flc: string = util.i32_to_string(fl_cells);
    var o: string = "";
    // The over-release detector global lives here (before $__fern_arr_dec,
    // which bumps it, and before rc_runtime_helpers, which also reads it).
    o = o + "  (global $__fern_rc_underflow (mut i32) (i32.const 0))\n";
    o = o + "  (global $heap (mut i32) (i32.const " + hb + "))\n";
    // Perceus size-class freelist: a per-class head pointer array at
    // [fl_base .. fl_base + fl_cells*4), zero-initialised (empty lists) by
    // wasm's zeroed linear memory. Class = roundup8(blocksize)/8. A freed
    // block (rc reaching 0 in $__fern_arr_dec) is pushed onto its class;
    // $__fern_alloc pops a same-class block before bumping. Blocks larger
    // than fl_cells*8 bytes are bump-only (never recycled).
    o = o + "  (func $__fern_alloc (param $n i32) (result i32)\n";
    o = o + "    (local $p i32) (local $cls i32) (local $head i32)\n";
    o = o + "    (local.set $n (i32.and (i32.add (local.get $n) (i32.const 7)) (i32.const -8)))\n";
    o = o + "    (local.set $cls (i32.shr_u (local.get $n) (i32.const 3)))\n";
    o = o + "    (if (i32.lt_u (local.get $cls) (i32.const " + flc + ")) (then\n";
    o = o + "      (local.set $head (i32.load (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4)))))\n";
    o = o + "      (if (local.get $head) (then\n";
    o = o + "        (i32.store (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4))) (i32.load (i32.add (local.get $head) (i32.const 4))))\n";
    o = o + "        (return (local.get $head))))))\n";
    o = o + "    (local.set $p (global.get $heap))\n";
    o = o + "    (global.set $heap (i32.add (global.get $heap) (local.get $n)))\n";
    // Grow linear memory when the bump pointer passes the current capacity
    // (memory.size pages * 64KiB). Without this the bump allocator traps
    // once a program allocates past the initial pages.
    o = o + "    (if (i32.gt_u (global.get $heap) (i32.mul (memory.size) (i32.const 65536)))\n";
    o = o + "      (then (drop (memory.grow (i32.div_u (i32.add (i32.sub (global.get $heap) (i32.mul (memory.size) (i32.const 65536))) (i32.const 65535)) (i32.const 65536))))))\n";
    o = o + "    (local.get $p))\n";
    // $__fern_arr_box(eb) -> a: allocate an rc-headered array block and
    // return the DATA pointer `a`. Block layout: [rc@0][bsz@4][len@8]
    // [cap@12][elems@16..]; a = base+8, so the rc word sits at [a-8]
    // (matching the asm backends' [data-8] convention) while len@[a],
    // cap@[a+4], elems@[a+8] keep every a-relative array access unchanged.
    // rc starts at 1 (the fresh owner). bsz (at [base+4] = [a-4]) records
    // the rounded block size so $__fern_arr_dec can pick the freelist class
    // without knowing the element width.
    o = o + "  (func $__fern_arr_box (param $eb i32) (result i32)\n";
    o = o + "    (local $base i32) (local $n i32)\n";
    o = o + "    (local.set $n (i32.and (i32.add (i32.add (i32.const 16) (local.get $eb)) (i32.const 7)) (i32.const -8)))\n";
    o = o + "    (local.set $base (call $__fern_alloc (local.get $n)))\n";
    o = o + "    (i32.store (local.get $base) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $n))\n";
    o = o + "    (i32.add (local.get $base) (i32.const 8)))\n";
    // $__fern_str_box(p) -> s: rc-header a heap STRING block. `p` is the
    // string payload size (4-byte len word + bytes); the 8-byte rc+bsz
    // header is prepended and s = base+8 is returned, so [s] = len,
    // [s+4..] = bytes keep every s-relative string access unchanged while
    // the rc word sits at [s-8] and the block size at [s-4]. Static string
    // literals live in the data section (below heap_base) and are left
    // unboxed — the rc helpers' address guard treats them as immortal.
    // Frees through the shared $__fern_arr_dec (size-class freelist), since
    // a string is flat (no rc-tracked children). Foundation: heap strings
    // are now rc-boxed; counting + release ride on this in later slices.
    o = o + "  (func $__fern_str_box (param $p i32) (result i32)\n";
    o = o + "    (local $base i32) (local $n i32)\n";
    o = o + "    (local.set $n (i32.and (i32.add (i32.add (i32.const 8) (local.get $p)) (i32.const 7)) (i32.const -8)))\n";
    o = o + "    (local.set $base (call $__fern_alloc (local.get $n)))\n";
    o = o + "    (i32.store (local.get $base) (i32.const 1))\n";
    o = o + "    (i32.store (i32.add (local.get $base) (i32.const 4)) (local.get $n))\n";
    o = o + "    (i32.add (local.get $base) (i32.const 8)))\n";
    // $__fern_alloc_reuse(token, slots) -> box (#4350): the FBIP reuse-
    // degrade primitive, wasm twin of the asm __fn___fern_alloc_reuse, adapted
    // to the str_box layout (rc@box-8, bsz@box-4). A struct box for nf fields
    // is $__fern_str_box(slots*8) — slots counts every payload word (a struct's
    // type-id slot + fields = nf+1, a tuple's elements = arity) — i.e. block
    // size 8 + slots*8 (8-byte header; already 8-aligned). null token -> fresh box; size
    // match -> hand the SAME block back (rc stays 1 — the caller's
    // $__fern_rc_is_unique gate guaranteed sole ownership; the caller
    // overwrites the type-id slot before any read); mismatch -> free the donor
    // block exactly as $__fern_arr_dec's rc==1 path does (rc=0, next parked in
    // the bsz slot, pushed onto its size class) and alloc fresh — a mispaired
    // reuse is only ever slower, never unsound.
    o = o + "  (func $__fern_alloc_reuse (param $t i32) (param $nf i32) (result i32)\n";
    o = o + "    (local $want i32) (local $base i32) (local $cls i32)\n";
    o = o + "    (local.set $want (i32.add (i32.const 8) (i32.mul (local.get $nf) (i32.const 8))))\n";
    o = o + "    (if (i32.eqz (local.get $t)) (then\n";
    o = o + "      (return (call $__fern_str_box (i32.mul (local.get $nf) (i32.const 8))))))\n";
    o = o + "    (local.set $base (i32.sub (local.get $t) (i32.const 8)))\n";
    o = o + "    (if (i32.eq (i32.load (i32.add (local.get $base) (i32.const 4))) (local.get $want)) (then\n";
    o = o + "      (return (local.get $t))))\n";
    o = o + "    (local.set $cls (i32.shr_u (i32.load (i32.add (local.get $base) (i32.const 4))) (i32.const 3)))\n";
    o = o + "    (i32.store (local.get $base) (i32.const 0))\n";
    o = o + "    (if (i32.lt_u (local.get $cls) (i32.const " + flc + ")) (then\n";
    o = o + "      (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4)))))\n";
    o = o + "      (i32.store (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4))) (local.get $base))))\n";
    o = o + "    (call $__fern_str_box (i32.mul (local.get $nf) (i32.const 8))))\n";
    // $__fern_arr_dec(a) -> a: Perceus array release. Same guard chain as
    // the rc helpers (null / SSO low-bit / low-addr / sentinel). rc > 1:
    // decrement. rc <= 0: over-release (detector++), no free. rc == 1:
    // FREE — clear rc to 0 (a double-free then reads 0 and ticks the
    // detector instead of corrupting) and push the block onto its size
    // class (the next pointer is parked in the bsz slot at base+4, which
    // $__fern_arr_box rewrites on reuse, so rc stays 0 while free).
    o = o + "  (func $__fern_arr_dec (param $a i32) (result i32)\n";
    o = o + "    (local $base i32) (local $rc i32) (local $cls i32)\n";
    o = o + "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + hb + ")) (then (return (local.get $a))))\n";
    o = o + "    (local.set $base (i32.sub (local.get $a) (i32.const 8)))\n";
    o = o + "    (local.set $rc (i32.load (local.get $base)))\n";
    o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.gt_s (local.get $rc) (i32.const 1)) (then\n";
    o = o + "      (i32.store (local.get $base) (i32.sub (local.get $rc) (i32.const 1)))\n";
    o = o + "      (return (local.get $a))))\n";
    o = o + "    (if (i32.le_s (local.get $rc) (i32.const 0)) (then\n";
    o = o + "      (global.set $__fern_rc_underflow (i32.add (global.get $__fern_rc_underflow) (i32.const 1)))\n";
    o = o + "      (return (local.get $a))))\n";
    o = o + "    (local.set $cls (i32.shr_u (i32.load (i32.add (local.get $base) (i32.const 4))) (i32.const 3)))\n";
    o = o + "    (i32.store (local.get $base) (i32.const 0))\n";
    o = o + "    (if (i32.lt_u (local.get $cls) (i32.const " + flc + ")) (then\n";
    o = o + "      (i32.store (i32.add (local.get $base) (i32.const 4)) (i32.load (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4)))))\n";
    o = o + "      (i32.store (i32.add (i32.const " + flb + ") (i32.mul (local.get $cls) (i32.const 4))) (local.get $base))))\n";
    o = o + "    (local.get $a))\n";
    // $__fern_arr_dec_ptr(a) -> a: Perceus release of an array whose ELEMENTS
    // are rc-boxed pointers (string[] / struct[] / array-of-array / tuple[]).
    // When `a` is the LAST owner (rc word at [a-8] == 1, i.e. about to be
    // freed) first release every element (a 4-byte i32 slot at [a+8 + i*4],
    // for i in 0..len at [a]) via the shared $__fern_arr_dec, THEN free the
    // buffer itself. The rc==1 guard ensures elements are released exactly
    // once, on the final free (an aliased array at rc>1 just decrements the
    // buffer, elements untouched — they live on through the other owner). One
    // level: an element's OWN rc-tracked children leak (a sound known gap,
    // matching the struct/tuple one-level release). Same null / low-bit /
    // low-addr guards as $__fern_arr_dec so a non-heap or null array is a
    // no-op.
    o = o + "  (func $__fern_arr_dec_ptr (param $a i32) (result i32)\n";
    o = o + "    (local $i i32) (local $n i32)\n";
    o = o + "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + hb + ")) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
    o = o + "      (local.set $n (i32.load (local.get $a)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $adp_done (loop $adp_lp\n";
    o = o + "        (br_if $adp_done (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "        (drop (call $__fern_arr_dec (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $adp_lp))))) \n";
    o = o + "    (call $__fern_arr_dec (local.get $a)))\n";
    return o;
}
pub function arr_dec_ptr2_func(heap_base: i32): string {
    var hb: string = util.i32_to_string(heap_base);
    var o: string = "";
    o = o + "  (func $__fern_arr_dec_ptr2 (param $a i32) (result i32)\n";
    o = o + "    (local $i i32) (local $n i32)\n";
    o = o + "    (if (i32.eqz (local.get $a)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.and (local.get $a) (i32.const 1)) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.lt_u (local.get $a) (i32.const " + hb + ")) (then (return (local.get $a))))\n";
    o = o + "    (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
    o = o + "      (local.set $n (i32.load (local.get $a)))\n";
    o = o + "      (local.set $i (i32.const 0))\n";
    o = o + "      (block $adp2_done (loop $adp2_lp\n";
    o = o + "        (br_if $adp2_done (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "        (drop (call $__fern_arr_dec_ptr (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $adp2_lp))))) \n";
    o = o + "    (call $__fern_arr_dec (local.get $a)))\n";
    return o;
}
// rc_runtime_helpers emits the Perceus reference-counting runtime for the
// wasm backend — the wasm32 mirror of the x86-64 / arm64 helpers
// (asm.fern `__fn___fern_rc_*`). The rc word is an i32 at [ptr-8]; the
// "data pointer" handed to these helpers is base+8 (so the rc precedes
// the payload). Guard chain matches the asm backends: null → SSO inline
// low-bit tag → low-address → static sentinel (rc high bit / negative as
// signed i32, marking an immortal data-section literal). Unlike the asm
// backends (heap mmap'd high, so a fixed `< 0x10000` guard works), wasm
// linear memory starts low and the bump heap sits just above the static
// data, so the low-address threshold is `heap_base` itself: any pointer
// below it is static data (sentinel-guarded) or a non-pointer small int,
// and every real heap object is >= heap_base. An over-release (dec at
// rc <= 0) bumps the `$__fern_rc_underflow` detector rather than
// corrupting the count, surfaced by __fern_rc_underflow_count(). The
// low-level memory pokes (__alloc / __load_i32 / __store_i32) are the
// wasm counterparts of the x86 `__fn___alloc` / `__fn___load_i32` /
// `__fn___store_i32` runtime funcs: __alloc forwards to the bump heap so
// the rc tests (and any `core/map` raw-memory source that links) resolve.
// This is the additive Phase-0c foundation for wasm RC — the array
// layout migration + inc/dec call sites ride on it in later slices,
// exactly as on the asm backends.
pub function rc_runtime_helpers(heap_base: i32): string {
    var lo: string = util.i32_to_string(heap_base);
    var o: string = "";
    // ($__fern_rc_underflow is defined in heap_alloc_helpers, emitted first.)
    // __alloc(n) -> ptr: forward to the bump allocator.
    o = o + "  (func $__alloc (param $n i32) (result i32)\n";
    o = o + "    (call $__fern_alloc (local.get $n)))\n";
    // __free(p): no-op (bump heap; reclamation is the freelist's job).
    o = o + "  (func $__free (param $p i32) (result i32)\n";
    o = o + "    (local.get $p))\n";
    // __load_i32(a) -> i32.
    o = o + "  (func $__load_i32 (param $a i32) (result i32)\n";
    o = o + "    (i32.load (local.get $a)))\n";
    // __store_i32(a, v) -> a (value-producing so the StmtExpr drop balances).
    o = o + "  (func $__store_i32 (param $a i32) (param $v i32) (result i32)\n";
    o = o + "    (i32.store (local.get $a) (local.get $v))\n";
    o = o + "    (local.get $a))\n";
    // __fern_rc_inc(p) -> p: retain.
    o = o + "  (func $__fern_rc_inc (param $p i32) (result i32)\n";
    o = o + "    (local $rc i32)\n";
    o = o + "    (if (i32.eqz (local.get $p)) (then (return (local.get $p))))\n";
    o = o + "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (local.get $p))))\n";
    o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (local.get $p))))\n";
    o = o + "    (local.set $rc (i32.load (i32.sub (local.get $p) (i32.const 8))))\n";
    o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $p))))\n";
    o = o + "    (i32.store (i32.sub (local.get $p) (i32.const 8)) (i32.add (local.get $rc) (i32.const 1)))\n";
    o = o + "    (local.get $p))\n";
    // __fern_rc_dec(p) -> p: release; over-release bumps the detector.
    o = o + "  (func $__fern_rc_dec (param $p i32) (result i32)\n";
    o = o + "    (local $rc i32)\n";
    o = o + "    (if (i32.eqz (local.get $p)) (then (return (local.get $p))))\n";
    o = o + "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (local.get $p))))\n";
    o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (local.get $p))))\n";
    o = o + "    (local.set $rc (i32.load (i32.sub (local.get $p) (i32.const 8))))\n";
    o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (local.get $p))))\n";
    o = o + "    (if (i32.le_s (local.get $rc) (i32.const 0))\n";
    o = o + "      (then (global.set $__fern_rc_underflow (i32.add (global.get $__fern_rc_underflow) (i32.const 1)))))\n";
    o = o + "    (i32.store (i32.sub (local.get $p) (i32.const 8)) (i32.sub (local.get $rc) (i32.const 1)))\n";
    o = o + "    (local.get $p))\n";
    // __fern_rc_is_unique(p) -> 1 iff a live heap object with rc == 1.
    o = o + "  (func $__fern_rc_is_unique (param $p i32) (result i32)\n";
    o = o + "    (local $rc i32)\n";
    o = o + "    (if (i32.eqz (local.get $p)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.and (local.get $p) (i32.const 1)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.lt_u (local.get $p) (i32.const " + lo + ")) (then (return (i32.const 0))))\n";
    o = o + "    (local.set $rc (i32.load (i32.sub (local.get $p) (i32.const 8))))\n";
    o = o + "    (if (i32.lt_s (local.get $rc) (i32.const 0)) (then (return (i32.const 0))))\n";
    o = o + "    (if (i32.eq (local.get $rc) (i32.const 1)) (then (return (i32.const 1))))\n";
    o = o + "    (i32.const 0))\n";
    // __fern_rc_underflow_count() -> i32: the over-release detector.
    o = o + "  (func $__fern_rc_underflow_count (result i32)\n";
    o = o + "    (global.get $__fern_rc_underflow))\n";
    // __fern_snapshot_dec(new, old, snap) -> new (#3456 slice 2). REAL now
    // (Perceus self-host slice 1d): the snapshot-param consume-rebind reclaim.
    // Frees `old` (the superseded intermediate box) only when it is UNIQUELY
    // owned (rc == 1) AND differs from BOTH `new` (cow — the rebind kept it) and
    // `snap` (the caller's borrowed original — never freed). A shared box
    // (rc > 1) is LEFT untouched, NOT decremented: the snapshot param is borrowed,
    // so we hold no count to release — matching the x86 body's `cmpl $1 / jne`
    // (free iff rc==1, else leave). The free reuses $__fern_arr_dec's rc==1 branch
    // (freelist push by size class) — guarding rc==1 here first means arr_dec only
    // ever sees the uniquely-owned case, so it frees rather than decrements.
    // Returns `new`. ($__fern_arr_dec is emitted alongside, in heap_alloc_helpers.)
    o = o + "  (func $__fern_snapshot_dec (param $new i32) (param $old i32) (param $snap i32) (result i32)\n";
    o = o + "    (if (i32.eq (local.get $old) (local.get $new)) (then (return (local.get $new))))\n";
    o = o + "    (if (i32.eq (local.get $old) (local.get $snap)) (then (return (local.get $new))))\n";
    o = o + "    (if (i32.eqz (local.get $old)) (then (return (local.get $new))))\n";
    o = o + "    (if (i32.and (local.get $old) (i32.const 1)) (then (return (local.get $new))))\n";
    o = o + "    (if (i32.lt_u (local.get $old) (i32.const " + lo + ")) (then (return (local.get $new))))\n";
    o = o + "    (if (i32.ne (i32.load (i32.sub (local.get $old) (i32.const 8))) (i32.const 1)) (then (return (local.get $new))))\n";
    o = o + "    (drop (call $__fern_arr_dec (local.get $old)))\n";
    o = o + "    (local.get $new))\n";
    return o;
}
// arr_slice8_helper emits ONLY $__fern_arr_slice8 (a fresh array holding
// a[start:end), 8-byte f64/i64 elements — a raw i64 byte-move). Self-contained
// apart from $__fern_arr_box, so the IR path can pull in f64[] slicing without
// the rest of arr_helpers (the wide push variants etc.).
pub function arr_slice8_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_slice8 (param $a i32) (param $start i32) (param $end i32) (result i32)\n";
    o = o + "    (local $n i32) (local $na i32) (local $i i32)\n";
    o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (unreachable)))\n";
    o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (unreachable)))\n";
    o = o + "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 8))))\n";
    o = o + "    (i32.store (local.get $na) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (i64.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8))) (i64.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.add (local.get $start) (local.get $i)) (i32.const 8)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $na))\n";
    return o;
}
// map_w64_helpers emits the wasm IR runtime for i64/u64-VALUED maps (#5253).
// The i32-celled value column can't hold an 8-byte value inline, so a wide value
// is boxed into a fresh 8-byte rc cell and the cell's i32 pointer is stored in the
// column as an rc-managed value (vis=1, so $__fern_map_release frees the cell like
// a string value; vconsume=1, so the map takes the fresh cell's sole ref). Reads
// dereference the cell: $__fern_map_get_or_w64 for a single value,
// $__fern_map_get_w64 for an Option[i64], $__fern_map_values_w64 for the whole
// column (into a fresh i64[]), and $__fern_map_iter_w64 / $__fern_mapiter_value_w64
// for iteration (an i64[] value snapshot + an 8-byte accessor). Depends on
// $__fern_map_set / $__fern_map_find / $__fern_map_keys / $__fern_str_box /
// $__fern_arr_box / $__fern_alloc (map_helpers + heap, co-present with maps).
pub function map_w64_helpers(): string {
    var o: string = "";
    // $__fern_map_set_w64(box, k, v, kcons) → box: box v into an 8-byte cell and
    // store the cell pointer as a vis-managed value the map takes ownership of.
    o = o + "  (func $__fern_map_set_w64 (param $box i32) (param $k i32) (param $v i64) (param $kcons i32) (result i32)\n";
    o = o + "    (local $cell i32)\n";
    o = o + "    (local.set $cell (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (i64.store (local.get $cell) (local.get $v))\n";
    o = o + "    (return (call $__fern_map_set (local.get $box) (local.get $k) (local.get $cell) (i32.const 1) (i32.const 1) (local.get $kcons))))\n";
    // $__fern_map_get_or_w64(box, k, d) → the 8-byte value at k, or default d on a
    // miss. vals[idx] holds the cell pointer; deref it with i64.load.
    o = o + "  (func $__fern_map_get_or_w64 (param $box i32) (param $k i32) (param $d i64) (result i64)\n";
    o = o + "    (local $idx i32)\n";
    o = o + "    (local.set $idx (call $__fern_map_find (local.get $box) (local.get $k)))\n";
    o = o + "    (if (i32.lt_s (local.get $idx) (i32.const 0)) (then (return (local.get $d))))\n";
    o = o + "    (i64.load (i32.load (i32.add (i32.load (i32.add (local.get $box) (i32.const 12))) (i32.mul (local.get $idx) (i32.const 4))))))\n";
    // $__fern_map_get_or_w64's Option sibling: $__fern_map_get_w64(box, k) → a
    // 16-byte Option[i64] box [tag@0][payload@8] (Some=0, None=1) — the same shape
    // opt_make/opt_payload use for an 8-byte payload — dereferencing the cell into
    // payload@8 on a hit.
    o = o + "  (func $__fern_map_get_w64 (param $box i32) (param $k i32) (result i32)\n";
    o = o + "    (local $idx i32) (local $bx i32)\n";
    o = o + "    (local.set $idx (call $__fern_map_find (local.get $box) (local.get $k)))\n";
    o = o + "    (local.set $bx (call $__fern_str_box (i32.const 16)))\n";
    o = o + "    (if (i32.lt_s (local.get $idx) (i32.const 0)) (then\n";
    o = o + "      (i32.store (local.get $bx) (i32.const 1))\n";
    o = o + "      (i64.store (i32.add (local.get $bx) (i32.const 8)) (i64.const 0))\n";
    o = o + "      (return (local.get $bx))))\n";
    o = o + "    (i32.store (local.get $bx) (i32.const 0))\n";
    o = o + "    (i64.store (i32.add (local.get $bx) (i32.const 8)) (i64.load (i32.load (i32.add (i32.load (i32.add (local.get $box) (i32.const 12))) (i32.mul (local.get $idx) (i32.const 4))))))\n";
    o = o + "    (local.get $bx))\n";
    // $__fern_map_values_w64(box) → a fresh i64[] of the live values in probe
    // order: snapshot the value column (cell pointers) and dereference each cell
    // into an 8-byte element ([len@0][cap@4][elems@8], 8-byte stride).
    o = o + "  (func $__fern_map_values_w64 (param $box i32) (result i32)\n";
    o = o + "    (local $n i32) (local $arr i32) (local $cap i32) (local $used i32) (local $vals i32) (local $i i32) (local $j i32) (local $cell i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $box)))\n";
    o = o + "    (local.set $arr (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 8))))\n";
    o = o + "    (i32.store (local.get $arr) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $arr) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $cap (i32.load (i32.add (local.get $box) (i32.const 4))))\n";
    o = o + "    (local.set $used (i32.load (i32.add (local.get $box) (i32.const 16))))\n";
    o = o + "    (local.set $vals (i32.load (i32.add (local.get $box) (i32.const 12))))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (local.set $j (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $cap)))\n";
    o = o + "      (if (i32.eq (i32.load (i32.add (local.get $used) (i32.mul (local.get $i) (i32.const 4)))) (i32.const 1)) (then\n";
    o = o + "        (local.set $cell (i32.load (i32.add (local.get $vals) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "        (i64.store (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $j) (i32.const 8))) (i64.load (local.get $cell)))\n";
    o = o + "        (local.set $j (i32.add (local.get $j) (i32.const 1)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $arr))\n";
    // $__fern_map_iter_w64(map) → a MapIter box [keys@0][values@4][cursor@8] whose
    // VALUE snapshot is a fresh i64[] (values dereferenced from the cells). Mirrors
    // $__fern_map_iter but swaps $__fern_map_values → $__fern_map_values_w64.
    o = o + "  (func $__fern_map_iter_w64 (param $map i32) (result i32)\n";
    o = o + "    (local $box i32)\n";
    o = o + "    (local.set $box (call $__fern_alloc (i32.const 12)))\n";
    o = o + "    (i32.store (local.get $box) (call $__fern_map_keys (local.get $map)))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 4)) (call $__fern_map_values_w64 (local.get $map)))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 8)) (i32.const 0))\n";
    o = o + "    (local.get $box))\n";
    // $__fern_mapiter_value_w64(box) → values[cursor] as an 8-byte i64 (values =
    // box@4 is an i64[]; element at values + 8 + cursor*8).
    o = o + "  (func $__fern_mapiter_value_w64 (param $box i32) (result i64)\n";
    o = o + "    (i64.load (i32.add (i32.add (i32.load (i32.add (local.get $box) (i32.const 4))) (i32.const 8)) (i32.mul (i32.load (i32.add (local.get $box) (i32.const 8))) (i32.const 8)))))\n";
    return o;
}
// block into an i32. Optional leading '-', then decimal digits, stops at the
// first non-digit; empty block → 0. Allocation-free (no heap dependency) — the
// wasm companion to asm_ir's __fn___fern_str_to_i32 (the wasm AST backend had no
// str_to_i32, so this is authored fresh; the IR path is its only consumer).
pub function str_to_i32_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_str_to_i32 (param $s i32) (result i32)\n";
    o = o + "    (local $len i32) (local $i i32) (local $acc i32) (local $neg i32) (local $c i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $s)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (local.set $acc (i32.const 0))\n";
    o = o + "    (local.set $neg (i32.const 0))\n";
    // optional leading '-' (45): only when there is at least one byte.
    o = o + "    (if (i32.and (i32.gt_s (local.get $len) (i32.const 0)) (i32.eq (i32.load8_u (i32.add (local.get $s) (i32.const 4))) (i32.const 45))) (then\n";
    o = o + "      (local.set $neg (i32.const 1)) (local.set $i (i32.const 1))))\n";
    o = o + "    (block $d (loop $l\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (local.set $c (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    // stop at the first non-digit (< '0'(48) or > '9'(57)).
    o = o + "      (br_if $d (i32.lt_s (local.get $c) (i32.const 48)))\n";
    o = o + "      (br_if $d (i32.gt_s (local.get $c) (i32.const 57)))\n";
    o = o + "      (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 10)) (i32.sub (local.get $c) (i32.const 48))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $l)))\n";
    o = o + "    (if (local.get $neg) (then (local.set $acc (i32.sub (i32.const 0) (local.get $acc)))))\n";
    o = o + "    (local.get $acc))\n";
    return o;
}
// arr_push_owned_helper emits $__fern_arr_push_owned: the sole-owner self-append
// (irlower's !aliased `a = a.append(v)`). Wraps $__fern_arr_push and, iff the push
// GREW (reallocated, result != old), frees the dead old buffer via the shared
// $__fern_arr_dec — which at rc==1 (sole owner) returns the block to its size-class
// freelist, and is a no-op on null / low-addr / SSO / static-sentinel / rc!=1, so
// the owned helper inherits all the defensive gating. Sound only because the emit
// site proved the slot unaliased (no surviving reference to the superseded buffer).
// wasm analog of asm_ir's __fern_arr_push_owned. Depends on $__fern_arr_push +
// $__fern_arr_dec, both co-present whenever arr_push_owned is (module_allocates).
pub function arr_push_owned_helper(heap_base: i32): string {
    var hb: string = util.i32_to_string(heap_base);
    var o: string = "";
    o = o + "  (func $__fern_arr_push_owned (param $a i32) (param $v i32) (result i32)\n";
    o = o + "    (local $na i32) (local $rc i32)\n";
    o = o + "    (local.set $na (call $__fern_arr_push (local.get $a) (local.get $v)))\n";
    // Superseded-old release, REGISTER PARITY (#5325): free the dead old
    // buffer ONLY when it was the sole owner (rc == 1) — and no-op for any
    // shared (rc >= 2) old, exactly like asm_ir's .Lapo_ret "not sole owner —
    // leave (defensive)" gate. Delegating unconditionally to $__fern_arr_dec
    // DECREMENTED a shared old, eating the caller-side grow bracket's +1: the
    // bracket's own $__fern_arr_dec then freed the caller's still-referenced
    // buffer (the WIT-codec SIGABRT that blocked #5138 — outer's
    // `out = out.append(k)` on a bracketed param, chained tx shape). At
    // rc == 1 the shared $__fern_arr_dec takes its free path, so the sole-
    // owner behaviour is unchanged; guards (null/tagged/low/immortal) ride
    // along inside it.
    o = o + "    (if (i32.and (i32.ne (local.get $na) (local.get $a)) (i32.and (i32.ge_u (local.get $a) (i32.const " + hb + ")) (i32.eqz (i32.and (local.get $a) (i32.const 1))))) (then\n";
    o = o + "      (if (i32.eq (i32.load (i32.sub (local.get $a) (i32.const 8))) (i32.const 1)) (then\n";
    o = o + "        (drop (call $__fern_arr_dec (local.get $a)))))))\n";
    o = o + "    (local.get $na))\n";
    return o;
}

// digits_to_i32 now lives in util.fern (imported as `util`). See SH-020.
pub function hex_digit(d: i32): string {
    if (d == 0) { return "0"; } else if (d == 1) { return "1"; }
    else if (d == 2) { return "2"; } else if (d == 3) { return "3"; }
    else if (d == 4) { return "4"; } else if (d == 5) { return "5"; }
    else if (d == 6) { return "6"; } else if (d == 7) { return "7"; }
    else if (d == 8) { return "8"; } else if (d == 9) { return "9"; }
    else if (d == 10) { return "a"; } else if (d == 11) { return "b"; }
    else if (d == 12) { return "c"; } else if (d == 13) { return "d"; }
    else if (d == 14) { return "e"; } else { return "f"; }
}
// wat_escape renders a string's bytes for a WAT `(data …)` payload:
// printable ASCII passes through (except `"` and `\`), everything else
// becomes a `\HH` hex escape — so embedded newlines / quotes survive.
pub function wat_escape(s: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i] as i32;
        if (b >= 32 && b <= 126 && b != 34 && b != 92) {
            out = out + s[i:i + 1];
        } else {
            out = out + "\\" + hex_digit(b / 16) + hex_digit(b % 16);
        }
        i = i + 1;
    }
    return out;
}
// le32_escape renders an i32 as four little-endian bytes in WAT `\HH` escape
// form — the length prefix of a string block, and every word of an aggregate
// constant's block. Shifting and masking rather than dividing: a string length
// is never negative, but an rc sentinel and a negative field constant are, and
// `-1 / 256 % 256` does not name a byte.
pub function le32_escape(n: i32): string {
    var out: string = "";
    var b: i32 = 0;
    while (b < 4) {
        var v: i32 = (n >> (b * 8)) & 255;
        out = out + "\\" + hex_digit(v / 16) + hex_digit(v % 16);
        b = b + 1;
    }
    return out;
}

// const_agg_data lays out the aggregate constants (#6149) as data segments, one
// whole BLOCK each: the [rc][bsz] header $__fern_str_box would have written,
// then the [type_id@0, f_i@8+i*8] payload struct_make would have stored — so a
// constant is byte-identical to the box it replaces, except that its rc word is
// the immortal sentinel rather than 1.
//
// Fields are written as full 8-byte slots (sign-extended) even though the
// admission is i32-width and struct_get reads only the low four: the slot IS
// eight bytes, and leaving the high half unwritten would be the one difference
// between a constant and an allocated box that a future wide-field read could
// see.
function const_agg_data(sv: string[], cv: string[], structs: parser.StructDecl[]): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < cv.len()) {
        var vals: string[] = ir.const_struct_values(cv[i]);
        var body: string = le32_escape(0 - 1) + le32_escape(const_agg_block_bytes(cv[i]))
            + le32_escape(struct_type_id(structs, ir.const_struct_type(cv[i]))) + le32_escape(0);
        var vi: i32 = 0;
        while (vi < vals.len()) {
            var w: i32 = util.lit_to_i32(vals[vi]);
            body = body + le32_escape(w);
            if (w < 0) { body = body + le32_escape(0 - 1); } else { body = body + le32_escape(0); }
            vi = vi + 1;
        }
        out = out + "  (data (i32.const " + util.i32_to_string(const_agg_offset(sv, cv, i)) + ") \"" + body + "\")\n";
        i = i + 1;
    }
    return out;
}
// arr_push_wide emits a geometric-growth push for an 8-byte-slot array.
// `vty` is the wasm value type of the appended element (i64 / f64);
// `sop` its store op. Existing elements are copied with a raw i64 move
// (8 bytes, element-type-agnostic).
// arr_push_i64_helper emits $__fern_arr_push_i64 standalone for the IR path
// (the AST path gets it bundled inside arr_helpers). 8-byte-slot geometric-
// growth push — the i64[] / u64[] companion to arr_push_helper's 4-byte
// $__fern_arr_push. Depends only on $__fern_arr_box (module_allocates).
pub function arr_push_i64_helper(): string {
    return arr_push_wide("i64", "i64");
}
// arr_push_f64_helper emits $__fern_arr_push_f64 — the f64[] companion to
// arr_push_i64_helper. Same 8-byte-slot geometric-growth push, but the value
// param + final store are f64 (the existing-element copy loop stays i64.load /
// i64.store, which is bit-preserving for the raw 8-byte slots). Lowered from
// `a = a.append(v)` on an f64[].
pub function arr_push_f64_helper(): string {
    return arr_push_wide("f64", "f64");
}
pub function arr_push_wide(vty: string, sop: string): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_push_" + vty + " (param $a i32) (param $v " + vty + ") (result i32)\n";
    o = o + "    (local $len i32) (local $cap i32) (local $na i32) (local $ncap i32) (local $i i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $a)))\n";
    o = o + "    (local.set $cap (i32.load (i32.add (local.get $a) (i32.const 4))))\n";
    o = o + "    (if (i32.lt_s (local.get $len) (local.get $cap)) (then\n";
    o = o + "      (" + sop + ".store (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $len) (i32.const 8))) (local.get $v))\n";
    o = o + "      (i32.store (local.get $a) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "      (return (local.get $a))))\n";
    o = o + "    (local.set $ncap (i32.const 4))\n";
    o = o + "    (if (i32.gt_s (local.get $cap) (i32.const 0)) (then (local.set $ncap (i32.mul (local.get $cap) (i32.const 2)))))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $ncap) (i32.const 8))))\n";
    o = o + "    (i32.store (local.get $na) (i32.add (local.get $len) (i32.const 1)))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $ncap))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $len)))\n";
    o = o + "      (i64.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8))) (i64.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 8)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (" + sop + ".store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $len) (i32.const 8))) (local.get $v))\n";
    o = o + "    (local.get $na))\n";
    return o;
}

// preview1_imports emits the wasi_snapshot_preview1 import section of the
// COMMAND core: proc_exit (which _start calls) plus one import per WASI op the
// module actually lowers. Split out of emit_ir_module_units so the component
// modes — which import nothing at all (no-I/O) or the preview2 stdout/stderr/
// exit trio instead — skip the whole section wholesale rather than threading a
// mode flag through sixty individual gates.
function preview1_imports(needs: string[]): string {
    var out: string = "";
    out = out + "  (import \"wasi_snapshot_preview1\" \"proc_exit\" (func $proc_exit (param i32)))\n";
    // wasi random_get import (issue #2747) — must precede the function
    // section. Emitted when the module uses random_bytes / random_i32.
    if (need(needs, "@uses_random")) { out = out + random_get_import(); }
    // print_int / print_str / eprint_str / putchar write via WASI fd_write
    // — import it only when the module writes to stdout or stderr.
    if (need(needs, "print_int") || need(needs, "print_i64") || need(needs, "print_str") || need(needs, "eprint_str") || need(needs, "putchar") || need(needs, "write_file") || need(needs, "writer_write")) {
        out = out + "  (import \"wasi_snapshot_preview1\" \"fd_write\" (func $fd_write (param i32 i32 i32 i32) (result i32)))\n";
    }
    // read_file / write_file open paths under preopen fd 3: path_open +
    // fd_read + fd_close (write_file also uses the fd_write import above).
    // read_dir ALSO needs path_open + fd_close, so it shares this bundle (an
    // unused fd_read import for a read_dir-only module is valid wasm) and adds
    // only fd_readdir below — avoiding a double path_open / fd_close import.
    // These imports must precede the function section.
    // remove_dir_all ALSO needs path_open + fd_close (+ fd_readdir below), so
    // it joins this union too.
    if (need(needs, "read_file") || need(needs, "write_file") || need(needs, "read_dir") || need(needs, "remove_dir_all") || need(needs, "open_file")) { out = out + file_imports(); }
    // read_dir / remove_dir_all list a directory via fd_readdir (path_open /
    // fd_close come from file_imports above) — emit the standalone fd_readdir
    // import once across both.
    if (need(needs, "read_dir") || need(needs, "remove_dir_all")) { out = out + readdir_fd_import(); }
    // read_line / read_int / read_chunk read stdin (fd 0) via fd_read.
    // file_imports above already imports fd_read for path-based file I/O, so
    // emit the standalone fd_read import ONLY when the module reads stdin but
    // does NOT do file I/O — otherwise fd_read would be imported twice (an
    // invalid module).
    if ((need(needs, "read_line") || need(needs, "read_int") || need(needs, "read_chunk") || need(needs, "read_all_stdin")) && !(need(needs, "read_file") || need(needs, "write_file") || need(needs, "read_dir") || need(needs, "remove_dir_all") || need(needs, "open_file"))) {
        out = out + stdin_fd_read_import();
    }
    // reader_close calls preview1 fd_close. file_imports supplies fd_close for
    // path I/O, so emit the standalone fd_close import ONLY for a reader that
    // does no file I/O — otherwise fd_close would be imported twice.
    if (need(needs, "reader_close") && !(need(needs, "read_file") || need(needs, "write_file") || need(needs, "read_dir") || need(needs, "remove_dir_all") || need(needs, "open_file"))) {
        out = out + reader_fd_close_import();
    }
    // The clock builtins (monotonic_ns / now_unix_ms / now_ns) wrap the
    // preview1 wasi clock_time_get import — emitted (before the function
    // section, like the other imports) when the module reads any clock.
    if (need(needs, "monotonic_ns") || need(needs, "now_unix_ms") || need(needs, "now_ns") || need(needs, "temp_dir")) {
        out = out + "  (import \"wasi_snapshot_preview1\" \"clock_time_get\" (func $clock_time_get (param i32 i64 i32) (result i32)))\n";
    }
    // args() / arg_at(i) read the wasi argv vector — the shared args_sizes_get /
    // args_get imports must precede the function section, emitted once when the
    // module reads argv by either route.
    if (need(needs, "args") || need(needs, "arg_at")) { out = out + args_helpers(); }
    // env(name) scans the wasi environ vector — its environ_sizes_get /
    // environ_get imports must precede the function section, emitted when the
    // module reads an env var.
    if (need(needs, "env")) { out = out + env_helpers(); }
    // stat(path) uses the preview1 path_filestat_get import (must precede the
    // function section), emitted when the module stats a file.
    if (need(needs, "stat")) { out = out + stat_import(); }
    // remove_file / remove_dir_all use the preview1 path_unlink_file import
    // (remove_dir_all unlinks the regular files it finds) — emit it once across
    // both (must precede the function section).
    if (need(needs, "remove_file") || need(needs, "remove_dir_all")) { out = out + remove_file_import(); }
    // remove_dir_all also rmdirs each emptied directory via path_remove_directory.
    if (need(needs, "remove_dir_all")) { out = out + remove_dir_import(); }
    // temp_dir(prefix) mkdirs a unique dir under the preopen via
    // path_create_directory (must precede the function section).
    if (need(needs, "temp_dir")) { out = out + temp_dir_import(); }
    // sleep_ms blocks on a monotonic-clock timeout via poll_oneoff.
    if (need(needs, "sleep_ms")) { out = out + sleep_ms_import(); }
    // Preview-2 timer-pollable ops (#4317): direct component-model imports.
    // A module using them composes to a component (see wasm_ir helpers).
    if (need(needs, "wasm_timer_pollable")) { out = out + wasi_subscribe_duration_import(); }
    if (need(needs, "wasm_pollable_drop")) { out = out + wasi_pollable_drop_import(); }
    if (need(needs, "wasm_block")) { out = out + wasi_pollable_block_import(); }
    // tcp_connect / tcp_close (#4318): the wasi:sockets + stream-drop imports.
    // connect also BLOCKS on the socket's pollable to wait for the connection
    // to establish, so it needs pollable.block / [resource-drop]pollable — but
    // only when the module has not already imported them for wasm_block /
    // wasm_pollable_drop, since a duplicate import is an invalid module.
    // instance-network is shared by the tcp set and udp_send; one gate so it
    // is emitted exactly once (a duplicate import is an invalid module).
    if (need(needs, "tcp_connect") || need(needs, "tcp_close") || need(needs, "tcp_listen") || need(needs, "tcp_accept") || need(needs, "tcp_pollable") || need(needs, "udp_send")) { out = out + wasi_instance_network_import(); }
    if (need(needs, "tcp_connect") || need(needs, "tcp_close") || need(needs, "tcp_listen") || need(needs, "tcp_accept") || need(needs, "tcp_pollable")) { out = out + wasi_sockets_imports(); }
    // tcp_send / tcp_recv need the stream read/write imports (#4318 slice 2).
    if (need(needs, "tcp_send") || need(needs, "tcp_recv")) { out = out + wasi_stream_io_imports(); }
    // tcp_listen / tcp_accept add bind + listen + accept; tcp_pollable and
    // tcp_accept both need the sockets base set (subscribe + the drops).
    if (need(needs, "tcp_listen") || need(needs, "tcp_accept")) { out = out + wasi_sockets_server_imports(); }
    // udp_send pulls the wasi:sockets/udp set plus the pollable block/drop it
    // uses for the send-permit wait (#4375). The network handle is shared
    // with the tcp ops; the pollable imports are gated so they are not
    // emitted twice when a tcp op already brought them in.
    if (need(needs, "udp_send")) { out = out + wasi_udp_imports(); }
    if (need(needs, "udp_send") && !need(needs, "wasm_block") && !need(needs, "tcp_connect") && !need(needs, "tcp_accept")) { out = out + wasi_pollable_block_import(); }
    if (need(needs, "udp_send") && !need(needs, "wasm_pollable_drop") && !need(needs, "tcp_connect") && !need(needs, "tcp_accept") && !need(needs, "poll")) { out = out + wasi_pollable_drop_import(); }
    if ((need(needs, "tcp_connect") || need(needs, "tcp_accept")) && !need(needs, "wasm_block")) { out = out + wasi_pollable_block_import(); }
    if ((need(needs, "tcp_connect") || need(needs, "tcp_accept")) && !need(needs, "wasm_pollable_drop")) { out = out + wasi_pollable_drop_import(); }
    // wasm_poll: the LIST-typed wasi:io/poll.poll multiplexer (#4316). Its
    // helper is heap-backed (it allocates the 8-byte canonical return area), so
    // the heap gate below folds it in.
    if (need(needs, "wasm_poll") || need(needs, "poll")) { out = out + wasi_poll_import(); }
    // poll(fds, timeout) expresses its timeout as a monotonic-clock timer
    // added to the polled set, so it needs subscribe-duration + the pollable
    // drop — each only when the module has not already imported it for the
    // op that owns it, since a duplicate import is invalid.
    if (need(needs, "poll") && !need(needs, "wasm_timer_pollable")) { out = out + wasi_subscribe_duration_import(); }
    if (need(needs, "poll") && !need(needs, "wasm_pollable_drop") && !need(needs, "tcp_connect") && !need(needs, "tcp_accept")) { out = out + wasi_pollable_drop_import(); }
    return out;
}

// emit_ir_module_units links N per-module units into one core module (#5331
// step 4b). It owns everything a unit does NOT: the imports, the memory, the
// base/type-id globals, the data section, the runtime helper bodies, the funcref
// table, and _start. A unit (wasm_ir.emit_functions_ns) owns only its function
// bodies, emitted against `$__str_base<ns>` / `$__fn_base<ns>` — which this
// function defines, and which is what makes a unit cacheable independently of
// its siblings.
//
// The per-unit inputs are flat parallel arrays rather than nested ones: `nss`
// holds each unit's namespace, `unit_texts` its emitted bodies, and
// (all_strs, str_counts) / (all_fns, fn_counts) the concatenation of the
// per-unit literal and address-taken-function tables with their lengths. Unit i
// therefore owns [sum(counts[0..i]), +counts[i]) in each, which is exactly the
// relative numbering its bodies were emitted against.
//
// Laying the literals out contiguously in that flat order means str_offset over
// the flat list already yields every literal's absolute address, so the data section
// and heap-base arithmetic are unchanged from whole-program emit — only their
// input differs.
//
// `mod` supplies the struct table (type ids must agree across all units, hence
// step 3's by-name globals) and `ir_cache` the combined lowering that gates
// which runtime helpers are needed. Both are whole-program views; keeping the
// gating exact here preserves the byte-identity invariant for the single-unit
// case. Deciding the helper set WITHOUT a combined cache is the out-of-process
// driver's problem (step 4c), where the asm side's precedent is a sound
// over-approximation (asm_ir.all_runtime_need_roots) rather than an exact union,
// because the exact aggregation re-lowers every module and OOMs (#3425).
//
// It is also the SINGLE source of truth for wasm IR-path module emission. The
// body used to be two hand-maintained copies — one inside wasm.emit_module_mode
// and a near-identical one inlined in the differential wasm_ir_run.fern driver
// — which silently drifted: the emit_module_mode copy never grew the WASI env /
// args / clock / write_file / stat / read_dir / temp_dir / sleep_ms / stdin-
// reader surface, nor map_iter / str_bytes / the f64 transcendentals, that the
// driver copy had. A module using any of them emitted a `call $__fern_env`
// (etc.) with no matching definition or import, and wasmtime rejected it with
// `unknown func: failed to find name $__fern_env` (#4801). Every caller now
// shares this one body — including the component modes, via the _mode sibling
// below — so the drift cannot recur.
pub function emit_ir_module_units(nss: string[], unit_texts: string[], all_strs: string[], str_counts: i32[], all_caggs: string[], cagg_counts: i32[], all_fns: string[], fn_counts: i32[], mod: parser.Module, needs: string[], fn_sigs: string[], rc_bodies: string): string {
    return emit_ir_module_units_mode(nss, unit_texts, all_strs, str_counts, all_caggs, cagg_counts, all_fns, fn_counts, mod, needs, fn_sigs, rc_bodies, 0);
}

// emit_ir_module_units_mode is emit_ir_module_units parameterised by the wasm
// EMIT MODE, the one axis on which the three cores differ:
//
//   0 — preview1 command core: the wasi_snapshot_preview1 imports and a
//       `_start` that proc_exits main()'s result.
//   1 — Component-Model run core, no I/O: import-free, exporting `main` and
//       `_lang_run` (0 = ok) for watbin.component_full to lift.
//   2 — Component-Model run core with stdout: mode 1 plus the preview2
//       stdout/stderr/exit imports and the $fd_write / $proc_exit shims over
//       them, so every call site the IR already emits works unchanged.
//
// Everything between the imports and the entry — memory, literals, type-id
// globals, the heap + RC runtime, every helper body, the funcref table — is
// mode-independent, which is why the component leg is a fork at two points
// rather than a second emitter (wasm.fern's AST component path is a full
// parallel copy; this is not).
pub function emit_ir_module_units_mode(nss: string[], unit_texts: string[], all_strs: string[], str_counts: i32[], all_caggs: string[], cagg_counts: i32[], all_fns: string[], fn_counts: i32[], mod: parser.Module, needs: string[], fn_sigs: string[], rc_bodies: string, mode: i32): string {
    var out: string = "(module\n";
    if (mode == 0) { out = out + preview1_imports(needs); }
    if (mode == 2) { out = out + component_io_imports(needs); }
    // WIT `@import` externs. Emitted for EVERY mode: an extern is a declaration
    // in the source, not a property of the framing, and a module that calls one
    // without importing it fails at load with `unknown func`. This is half of
    // what the AST emitter did and the IR path did not.
    out = out + extern_imports(mod, xslot_ir());
    out = out + "  (memory (export \"memory\") 16)\n";
    // String literals -> data-section blocks `[len:i32 LE][bytes]`. Emitted
    // caller-side (wasm owns le32_escape/wat_escape); wasm_ir supplies the
    // distinct values + their offsets so the data + const_str ptrs agree.
    var sv: string[] = all_strs;
    // $__str_base: the base of this unit's string-literal region. const_str
    // emits `global.get $__str_base` + a RELATIVE offset rather than baking the
    // absolute one, so a unit's emitted code no longer depends on where its
    // literals land in the whole-program data section (#5331 step 1).
    //
    // Why that matters: str_offset sums over every literal in the program, so
    // growing ONE literal shifts every later literal's offset (measured: a
    // second literal moves 31 -> 48 when the first grows) and the heap/freelist
    // bases with it. Under the per-module object cache planned for wasm, a
    // body-only edit to one module would therefore invalidate the emitted code
    // of every module after it — exactly the invalidation module_sig_string's
    // body exclusion prevents on the asm side. Routing literal references
    // through a base the link step assigns is the wasm analogue of an asm
    // label: the reference is relative, and only the base moves.
    //
    // Whole-program emit (this path) is a single unit, so the base is just the
    // region start and every emitted address is unchanged.
    if (sv.len() > 0) {
        // One base per unit, at the absolute offset of that unit's first
        // literal. The single-unit case yields str_region_base() and the
        // historical unnamespaced name, so its output is unchanged.
        var sbi: i32 = 0;
        var sbstart: i32 = 0;
        while (sbi < nss.len()) {
            out = out + "  (global " + str_base_global(nss[sbi]) + " i32 (i32.const "
                + util.i32_to_string(str_offset(sv, sbstart)) + "))\n";
            sbstart = sbstart + str_counts[sbi];
            sbi = sbi + 1;
        }
    }
    // Type-id globals (#5331 step 3): every construction / comparison site names
    // its type and reads the id from here, rather than baking the positional
    // index. See tid_globals_section for why type ids, unlike string
    // offsets and funcref indices, must stay globally agreed rather than
    // unit-relative.
    out = out + tid_globals_section(mod.structs);
    var di: i32 = 0;
    while (di < sv.len()) {
        out = out + "  (data (i32.const " + util.i32_to_string(str_offset(sv, di)) + ") \""
            + le32_escape(sv[di].len()) + wat_escape(sv[di]) + "\")\n";
        di = di + 1;
    }
    // Static aggregate constants (#6149), the region above the string literals.
    // $__cagg_base<ns> is the sibling of $__str_base<ns>: one base per unit at
    // that unit's first block, with the unit's code emitting relative offsets.
    var cv: string[] = all_caggs;
    if (cv.len() > 0) {
        var kbi: i32 = 0;
        var kbstart: i32 = 0;
        while (kbi < nss.len()) {
            out = out + "  (global " + cagg_base_global(nss[kbi]) + " i32 (i32.const "
                + util.i32_to_string(const_agg_offset(sv, cv, kbstart)) + "))\n";
            kbstart = kbstart + cagg_counts[kbi];
            kbi = kbi + 1;
        }
    }
    out = out + const_agg_data(sv, cv, mod.structs);
    // mode 2 folds into the heap gate: the $fd_write shim allocates its
    // canonical-ABI return area through $__fern_alloc, so a component-io core
    // needs the heap even when the program itself never allocates.
    //
    // The extern/export bridge folds in for the same reason, and it is not
    // visible in `needs`: those are derived from the LOWERED ops, and the bridge
    // is emitted from the module's declarations. A program whose only allocation
    // is a wrapper's return area / lifted string block (module_extern_needs_heap)
    // would otherwise emit `call $__fern_alloc` against nothing.
    if (mode == 2 || module_extern_needs_heap(mod) || need(needs, "@allocates") || need(needs, "@uses_arr_i32_helpers") || need(needs, "@uses_i32_to_string") || need(needs, "@uses_i64_to_string") || need(needs, "@uses_u64_to_string") || need(needs, "@uses_u32_to_string") || need(needs, "@uses_chr") || need(needs, "@uses_strbuf") || need(needs, "env") || need(needs, "stat") || need(needs, "remove_file") || need(needs, "read_dir") || need(needs, "remove_dir_all") || need(needs, "temp_dir") || need(needs, "sleep_ms") || need(needs, "read_chunk") || need(needs, "reader_close") || need(needs, "wasm_poll") || need(needs, "tcp_connect") || need(needs, "tcp_send") || need(needs, "tcp_recv") || need(needs, "tcp_listen") || need(needs, "tcp_accept") || need(needs, "udp_send") || need(needs, "poll")) {
        out = out + heap_alloc_helpers(heap_base_for_strs(sv, cv), fl_base_for_strs(sv, cv), fl_cells());
        out = out + rc_runtime_helpers(heap_base_for_strs(sv, cv));
    }
    // The preview2 shims stand in for the preview1 imports mode 0 supplies, so
    // every $fd_write / $proc_exit call site the IR emits links unchanged.
    // Placed after the heap runtime they call into (as the AST path does).
    if (mode == 2) { out = out + component_io_shims(needs); }
    // $__fern_arr_dec_ptr2 (string[][] deep reclaim, #4355 slice 9): only
    // when the module lowers a __fern_strarrarr_free call — see
    // arr_dec_ptr2_func for why it must not ride along unconditionally.
    if (need(needs, "@calls_strarrarr_free")) { out = out + arr_dec_ptr2_func(heap_base_for_strs(sv, cv)); }
    if (need(needs, "@calls_optarrarr_free")) { out = out + optarrarr_free_func(heap_base_for_strs(sv, cv)); }
    // $__fern_strbuf_* (global string-builder): a growable bump-heap buffer +
    // reset/append/take. Heap-backed (str_box / alloc), emitted above.
    if (need(needs, "@uses_strbuf")) { out = out + strbuf_helpers(); }
    // Per-type $__field_reclaim_<T> + $__struct_drop_<T> RC helper bodies
    // (#3457, Perceus slices 1c/1d + slice-3 nested deep-drop). emit_module's
    // own IR orchestration emits these; this differential driver assembles the
    // helper section itself, so it MUST emit them too — otherwise a struct
    // program whose deep-drop lowering inserts a `call $__struct_drop_<T>`
    // links against an undefined function and traps under wasmtime
    // (`unknown func $__struct_drop_<T>`). Returns "" for modules with no rc
    // fields, so non-struct programs are unchanged.
    out = out + rc_bodies;
    // The canonical-ABI wrappers a string/list-returning `@import` resolves to
    // (return-area alloc, raw import call, lift). Gated the same way the AST
    // emitter gates them, so a module with no such extern is unchanged.
    if (module_needs_extern_wrappers(mod, xslot_ir())) { out = out + extern_wrappers(mod, xslot_ir()); }
    if (need(needs, "@uses_divrem")) { out = out + divrem_helpers(); }
    if (need(needs, "@uses_i64_divrem")) { out = out + divrem64_helpers(); }
    // $__fern_exp_f64: e^x via a polynomial (no transcendental wasm
