    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (i32.add (local.get $an) (local.get $bn)) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $na) (i32.add (local.get $an) (local.get $bn)))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (i32.add (local.get $an) (local.get $bn)))\n";
    o = o + "    (block $da (loop $ca\n";
    o = o + "      (br_if $da (i32.ge_s (local.get $i) (local.get $an)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $ca)))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $db (loop $cb\n";
    o = o + "      (br_if $db (i32.ge_s (local.get $i) (local.get $bn)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (i32.add (local.get $an) (local.get $i)) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $b) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $cb)))\n";
    o = o + "    (local.get $na))\n";
