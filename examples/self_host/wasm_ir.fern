// examples/self_host/wasm_ir.fern — the WebAssembly instruction-selector for
// the target-agnostic stack IR (irlower.fern's Op[]). The wasm sibling of
// asm_ir / asm_arm64_ir: it lowers the SAME lowered op stream to textual WAT.
//
// wasm is the most natural target of the three: the IR is a stack machine with
// structured control flow (block / loop / if / else / end / br / br_if) and
// wasm IS that machine, so the lowering is a near-direct transliteration to
// FLAT WAT instructions — const_i32 -> i32.const, load_local i -> local.get i,
// add -> i32.add, the structured ops keep their names, and `br depth` /
// `br_if depth` carry the SAME relative depth the IR already encodes (no label
// generation). A user `call` needs no arg reversal either: the IR pushes args
// arg0-deepest and wasm's `call` consumes them arg0-deepest.
//
// Arrays use wasm's linear-memory layout (matching wasm.fern's __fern_arr_box:
// a = base+8, so rc@[a-8], len@[a], cap@[a+4], element i @ [a+8+i*4], 4-byte
// stride) and reuse wasm.fern's heap/RC runtime verbatim (heap_alloc_helpers +
// rc_runtime_helpers — the size-class freelist allocator, __fern_arr_box,
// __fern_arr_dec, and the rc inc/dec helpers). The Perceus array RC (alias-inc,
// move-on-return, exit dec-sweep, reassignment retain/cow-release) all comes
// from irlower's shared lowering, so wasm gets it for free — the helper calls
// lower to `call $__fern_rc_inc` / `call $__fern_arr_dec`.
//
// Like asm_ir, this is a SEPARATE module imported only by its differential
// driver (wasm_ir_run) — wasm.fern stays untouched until a later fold/flip.

import "./parser";
import "./util";
import "./ir";
import "./irlower";
import "./asm_ir";
import "./asmcore";

// Linear-memory layout for the no-string array subset, computed exactly as
// wasm.emit_module does for an empty string table (tab.next = 24, heap_extra =
// 0): fl_base = roundup8(24 + 16) = 40, the 65536-class freelist, then the
// bump heap at heap_base. heap_base is also the rc helpers' low-address guard.
pub function fl_base(): i32 { return 40; }
pub function fl_cells(): i32 { return 65536; }
pub function heap_base(): i32 { return 40 + 65536 * 4; }

// ---- string literals (data section) -----------------------------------------
// In the IR subset, string literals live in the data section exactly as
// wasm.fern's StrTable lays them out: one `[len:i32 LE][bytes]` block per
// distinct literal, the first at offset 24, each `4 + len` bytes. A string
// VALUE is a pointer to its block; `.len()` reads the i32 at offset 0. Literals
// are static (no heap) — only str_concat allocates (via $__fern_str_box). The
// blocks sit below the freelist/heap, so any literal shifts fl_base/heap_base
// off the empty-table defaults: fl_base_for / heap_base_for recompute them (and
// equal fl_base() / heap_base() when there are no literals). The data section
// and the $__fern_strcat / $__fern_streq helpers are emitted CALLER-side (in
// wasm.fern, which owns le32_escape / wat_escape / strcat_helpers) because
// wasm_ir cannot import wasm without a cycle — same split as the heap runtime.

// lower_all_for lowers EVERY function of `mod` to its IR ops ONCE, returning the
// per-function LowerResult list in mod.funcs order. It is the cache the wasm IR
// emit path threads through its two dozen collect / gate passes (str_values,
// module_uses_*, module_emits_op_cached, field_reclaim_types, fn_value_table, …)
// so a module is lowered a single time instead of once per pass — killing the
// O(functions²) × O(passes) re-lowering that OOMed the self-host wasm compile of
// large / many-function modules (#4652).
//
// Each element is byte-identical to irlower.lower_func_for(fn, …): the ~20
// `*_of(funcs)` side-tables are pure functions of mod.funcs / mod.structs, so
// hoisting them out of the per-function loop (computed once here, not once per
// call) yields the same ops, and the argument vector otherwise mirrors
// lower_func_for's exactly (including the empty consume_safe_params — the query
// passes deliberately use the per-function borrowability, NOT the interprocedural
// fixpoint the emit path threads through emit_function_ir).
pub function lower_all_for(mod: parser.Module): irlower.LowerResult[] {
    var arf: string[] = asm_ir.array_ret_fns(mod);
    var srf: string[] = irlower.append_dyn_str_ret_fns(irlower.str_ret_fns_of(mod.funcs), mod.trait_reqs);
    var sarf: string[] = irlower.append_dyn_arr_ret_fns(irlower.strarr_ret_fns_of(mod.funcs), mod.trait_reqs, "string[]");
    var amf: string[] = irlower.arr_method_fns_of(mod.funcs);
    var orf: string[] = irlower.opt_ret_fns_of(mod.funcs);
    var irf: string[] = irlower.append_dyn_i64_ret_fns(irlower.i64_ret_fns_of(mod.funcs), mod.trait_reqs);
    var trf: string[] = irlower.tuple_ret_fns_of(mod.funcs);
    var srtf: string[] = irlower.struct_ret_fns_of(mod.funcs, mod.structs);
    var mrtf: string[] = irlower.map_ret_fns_of(mod.funcs);
    var frf: string[] = irlower.append_dyn_f64_ret_fns(irlower.f64_ret_fns_of(mod.funcs), mod.trait_reqs);
    var farf: string[] = irlower.append_dyn_arr_ret_fns(irlower.f64arr_ret_fns_of(mod.funcs), mod.trait_reqs, "f64[]");
    var iarf: string[] = irlower.i64arr_ret_fns_of(mod.funcs);
    var fps: string[] = irlower.fn_param_sigs_of(mod.funcs);
    var cfs: string[] = irlower.closure_ret_fns_of(mod.funcs);
    var cnf: string[] = irlower.const_fns_of(mod.funcs);
    var bp: string[] = irlower.borrowable_params_of(mod.funcs);
    var fnames: string[] = irlower.fn_names_of(mod.funcs);
    var frsf: string[] = irlower.fresh_struct_ret_fns_of(mod.funcs, mod.structs);
    var rfrsf: string[] = irlower.return_fresh_struct_ret_fns_of(mod.funcs, mod.structs);
    var sfrf: string[] = irlower.str_fresh_ret_fns_of(mod.funcs);
    var ofrf: string[] = irlower.opt_fresh_ret_fns_of(mod.funcs, mod.structs);
    var sfot: string[] = irlower.strfld_reclaim_ok_types_of(mod.funcs, mod.structs);
    var tfrf: string[] = irlower.tuple_fresh_ret_fns_of(mod.funcs);
    var out: irlower.LowerResult[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        out = out.append(irlower.lower_func(mod.funcs[fi], arf, mod.structs, srf, sarf, amf, orf, irf, trf, srtf, mrtf, frf, farf, iarf, fps, cfs, irlower.closurearr_ret_fns_of(mod.funcs), cnf, bp, fnames, frsf, [], rfrsf, sfrf, ofrf, sfot, tfrf));
        fi = fi + 1;
    }
    return out;
}

// str_values collects the module's distinct string literals (first-seen order,
// deduped) from the lowered IR. Both the caller's data-section emission and the
// per-function const_str offset lookup walk this same list, so offsets agree.
pub function str_values(cache: irlower.LowerResult[]): string[] {
    var vals: string[] = [];
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 5) {  // const_str
                var v: string = r.ops[i].str;
                var seen: boolean = false;
                var k: i32 = 0;
                while (k < vals.len()) {
                    if (vals[k] == v) { seen = true; }
                    k = k + 1;
                }
                if (!seen) { vals = vals.append(v); }
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return vals;
}

// str_offset returns the data-section offset of literal index `idx`: 24 + the
// summed block sizes (4 + len) of all prior literals.
pub function str_offset(vals: string[], idx: i32): i32 {
    var off: i32 = 24;
    var i: i32 = 0;
    while (i < idx) {
        off = off + 4 + vals[i].len();
        i = i + 1;
    }
    return off;
}

// offset_of_value returns the data-section offset of literal value `v`.
function offset_of_value(vals: string[], v: string): i32 {
    var i: i32 = 0;
    while (i < vals.len()) {
        if (vals[i] == v) { return str_offset(vals, i); }
        i = i + 1;
    }
    return 24;
}

// fl_base_for / heap_base_for recompute the freelist + heap bases including the
// literal blocks (heap_extra = 0 in the IR subset — no i64 / print buffers).
pub function fl_base_for(cache: irlower.LowerResult[]): i32 {
    return (str_offset(str_values(cache), str_values(cache).len()) + 16 + 7) / 8 * 8;
}
pub function heap_base_for(cache: irlower.LowerResult[]): i32 {
    return fl_base_for(cache) + fl_cells() * 4;
}

// module_uses_strings reports whether any function uses a string op (literal,
// len, concat, eq) — gates the data section + strcat/streq helper emission.
pub function module_uses_strings(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            var kt: i32 = r.ops[i].kind_tag;
            if (kt == 5 || kt == 97 || kt == 98 || kt == 99 || kt == 100) { return true; }  // const_str, str_len, str_concat, str_eq, str_cmp
            if (kt == 101 || kt == 102) { return true; }  // str_index, str_slice
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_str_cmp reports whether any function emits a str_cmp op (string
// ordering < <= > >=). Such modules need the FULL string-helper bundle, which
// includes $__fern_strcmp (the narrow strcat_streq bundle omits it).
pub function module_uses_str_cmp(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 100) { return true; }  // str_cmp
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_str_slice reports whether any function uses `s[start:end]` (the
// str_slice op), gating emission of the $__fern_substr copy helper.
pub function module_uses_maps(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 124 || r.ops[i].kind_tag == 125 || r.ops[i].kind_tag == 126) { return true; }  // map_new, map_set, map_len
            // map_keys / map_values call $__fern_map_keys / $__fern_map_values
            // (the wasm snapshot helpers), so they need the map runtime even in
            // a module that never constructs a map (e.g. a keys() read on a
            // map param). #4353.
            if (r.ops[i].kind_tag == 131 || r.ops[i].kind_tag == 132) { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

pub function module_uses_str_slice(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 102) { return true; }  // str_slice
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// wasm_binop renders the wasm instruction for one IR i32 binary op. 64-bit
// values never appear in the i32 subset, so every op is the i32.* form.
function wasm_binop(tag: i32): string {
    if (tag == 21) { return "i32.add"; }
    if (tag == 22) { return "i32.sub"; }
    if (tag == 23) { return "i32.mul"; }
    // Non-trapping div/rem, matching wasm.fern's AST path: x/0 = 0, x%0 = x,
    // INT_MIN/-1 = INT_MIN (wasm's native i32.div_s / i32.rem_s TRAP on those).
    // The helpers ($__fern_idiv / $__fern_irem) are emitted when the module
    // uses div/rem (module_uses_divrem). As a flat instruction the operands are
    // prior on the stack, so `call` consumes them exactly like the op would.
    if (tag == 24) { return "call $__fern_idiv"; }
    if (tag == 26) { return "call $__fern_irem"; }
    if (tag == 28) { return "i32.and"; }
    if (tag == 29) { return "i32.or"; }
    if (tag == 30) { return "i32.xor"; }
    if (tag == 31) { return "i32.shl"; }
    if (tag == 32) { return "i32.shr_s"; }
    if (tag == 33) { return "i32.shr_u"; }
    // Unsigned u32 div/rem (#3204+): wasm's native i32.div_u/rem_u — irlower
    // remaps div_s/rem_s -> div_u/rem_u when an operand is u32, so a u32
    // numerator >= 2^31 divides as unsigned (signed div gave the wrong answer).
    if (tag == 25) { return "i32.div_u"; }
    if (tag == 27) { return "i32.rem_u"; }
    if (tag == 35) { return "i32.eq"; }
    if (tag == 36) { return "i32.ne"; }
    if (tag == 37) { return "i32.lt_s"; }
    if (tag == 38) { return "i32.le_s"; }
    if (tag == 39) { return "i32.gt_s"; }
    if (tag == 40) { return "i32.ge_s"; }
    // Unsigned u32 compares (#2917): a u32 >= 2^31 is a signed-negative i32, so
    // lt_s/gt_s give wrong answers — irlower remaps the kind via to_unsigned_kind
    // (the same mechanism u64 uses). Mirrors the i64.*_u forms in wasm_binop_w.
    if (tag == 41) { return "i32.lt_u"; }
    if (tag == 42) { return "i32.le_u"; }
    if (tag == 43) { return "i32.gt_u"; }
    if (tag == 44) { return "i32.ge_u"; }
    return ";; ir: unsupported bin " + ir.kind_name(tag) + "\n";
}

// wasm_binop_w selects the i64 instruction variant when the operand width is 64
// (i64 div/rem is bailed in irlower, so no i64 div/rem helper is needed). A
// comparison still pushes an i32 result — only the operands are i64.
function wasm_binop_w(tag: i32, width: i32): string {
    if (width != 64) { return wasm_binop(tag); }
    if (tag == 21) { return "i64.add"; }
    if (tag == 22) { return "i64.sub"; }
    if (tag == 23) { return "i64.mul"; }
    // Non-trapping i64 div/rem (x/0=0, x%0=x, INT64_MIN/-1=INT64_MIN), matching
    // wasm.fern's AST path; emitted by divrem_helpers (module_uses_divrem).
    if (tag == 24) { return "call $__fern_idiv64"; }
    if (tag == 26) { return "call $__fern_irem64"; }
    // Unsigned 64-bit div/rem (u64, #2904): wasm's native i64.div_u/rem_u (they
    // trap only on divide-by-zero — the signed INT64_MIN/-1 overflow that the
    // $__fern_*64 helpers neutralise can't arise unsigned).
    if (tag == 25) { return "i64.div_u"; }
    if (tag == 27) { return "i64.rem_u"; }
    if (tag == 28) { return "i64.and"; }
    if (tag == 29) { return "i64.or"; }
    if (tag == 30) { return "i64.xor"; }
    if (tag == 31) { return "i64.shl"; }
    if (tag == 32) { return "i64.shr_s"; }
    if (tag == 33) { return "i64.shr_u"; }
    if (tag == 35) { return "i64.eq"; }
    if (tag == 36) { return "i64.ne"; }
    if (tag == 37) { return "i64.lt_s"; }
    if (tag == 38) { return "i64.le_s"; }
    if (tag == 39) { return "i64.gt_s"; }
    if (tag == 40) { return "i64.ge_s"; }
    // Unsigned 64-bit compares (u64, #2904) — push an i32 bool like the signed
    // forms, but read the value as unsigned.
    if (tag == 41) { return "i64.lt_u"; }
    if (tag == 42) { return "i64.le_u"; }
    if (tag == 43) { return "i64.gt_u"; }
    if (tag == 44) { return "i64.ge_u"; }
    // f64 arithmetic / comparison (op_fbin carries width 64). wasm's f64
    // compares are natively NaN-correct (return 0 for unordered) and yield i32.
    if (tag == 45) { return "f64.add"; }
    if (tag == 46) { return "f64.sub"; }
    if (tag == 47) { return "f64.mul"; }
    if (tag == 48) { return "f64.div"; }
    // f64 unary math intrinsics (op_funary) — single wasm instructions.
    if (tag == 57) { return "f64.sqrt"; }
    if (tag == 59) { return "f64.floor"; }
    if (tag == 58) { return "f64.ceil"; }
    if (tag == 60) { return "f64.trunc"; }
    if (tag == 56) { return "f64.abs"; }
    if (tag == 55) { return "f64.neg"; }
    if (tag == 49) { return "f64.eq"; }
    if (tag == 50) { return "f64.ne"; }
    if (tag == 51) { return "f64.lt"; }
    if (tag == 52) { return "f64.le"; }
    if (tag == 53) { return "f64.gt"; }
    if (tag == 54) { return "f64.ge"; }
    return ";; ir: unsupported i64 bin " + ir.kind_name(tag) + "\n";
}

// slot_in_list reports membership of slot x in an i32 list (the LowerResult's
// i64_slots / arr_slots are sorted-but-membership is all we need).
function slot_in_list(list: i32[], x: i32): boolean {
    var i: i32 = 0;
    while (i < list.len()) {
        if (list[i] == x) { return true; }
        i = i + 1;
    }
    return false;
}

// wasm_helper_symbol maps an IR runtime-helper name to the wasm.fern symbol the
// IR path calls. The exit-sweep / reassign release (__fern_rc_dec) maps to
// $__fern_arr_dec (the array release that frees at rc==1 via the size-class
// freelist), so the wasm IR path reclaims exactly as wasm.fern's AST path.
function wasm_helper_symbol(name: string): string {
    if (name == "__fern_rc_inc") { return "$__fern_rc_inc"; }
    if (name == "__fern_rc_dec") { return "$__fern_arr_dec"; }
    // string RC reclaim (#2649): unlike the header-less asm string boxes (which
    // need the dedicated __fern_str_free box+buffer release), a wasm heap string
    // is a single rc-headered INLINE block ($__fern_str_box: [rc][bsz][len][bytes])
    // — so a plain $__fern_arr_dec frees it at rc==1 by size class, and a literal
    // (data-section, below heap_base) is a guarded no-op. Double frees are caught
    // by the rc-underflow detector, unlike the asm path.
    if (name == "__fern_str_free") { return "$__fern_arr_dec"; }
    // string[] ELEMENT reclaim (#4355): route to $__fern_arr_dec_ptr, the wasm
    // AST path's pointer-element walk (heap_alloc_helpers, always emitted with
    // the heap runtime): at rc==1 it $__fern_arr_dec's every element — which IS
    // the wasm string free (a wasm heap string is a single inline rc-headered
    // block) — then frees the buffer; a shared array just decs; literals /
    // immortal views are guarded no-ops inside the per-element dec.
    if (name == "__fern_str_arr_free") { return "$__fern_arr_dec_ptr"; }
    // arr-of-arr reclaim (#4355 slice 9): a SCALAR-element inner buffer is
    // fully freed by one per-element dec, so the outer walk is exactly
    // $__fern_arr_dec_ptr; a STRING-element inner (string[][]) needs the
    // two-level $__fern_arr_dec_ptr2 (per-element arr_dec_ptr — the inner's
    // string blocks then its buffer — then the outer).
    if (name == "__fern_arrarr_free") { return "$__fern_arr_dec_ptr"; }
    if (name == "__fern_strarrarr_free") { return "$__fern_arr_dec_ptr2"; }
    if (name == "__fern_optarrarr_free") { return "$__fern_optarrarr_free"; }
    // map reclaim (Perceus map-local slice): route to $__fern_map_release, the
    // wasm AST path's full map free — it null-guards, rc-guards (frees only at
    // rc==1), DEEP-releases string keys + string values (a level the asm
    // __fern_map_free leaks), and frees the keys/vals/used buffers + the box. The
    // 40-byte wasm map box layout differs entirely from asm's raw 16-byte box, so
    // routing to the wasm-native release (rather than a shared IR sequence) is
    // what makes map reclaim correct on wasm. Always present when the module uses
    // maps (map_helpers is gated on module_uses_maps).
    if (name == "__fern_map_free") { return "$__fern_map_release"; }
    // #4353: the string-value deep-release variant is register-only; on wasm
    // $__fern_map_release ALREADY deep-releases string K/V, so it routes to the
    // same helper (the MAPVS credit is a no-op distinction here).
    if (name == "__fern_map_free_vs") { return "$__fern_map_release"; }
    if (name == "__fern_map_free_ks") { return "$__fern_map_release"; }
    if (name == "__fern_map_free_kvs") { return "$__fern_map_release"; }
    if (name == "__fern_rc_underflow_get") { return "$__fern_rc_underflow_count"; }
    // i32.to_string()'s decimal helper — wasm.fern's to_string_helpers emits it
    // as $__fern_i32_to_str (param i32 -> i32 box), gated on module_uses_tostring
    // (an AST walk, so it fires on the IR path too).
    if (name == "__fern_i32_to_string") { return "$__fern_i32_to_str"; }
    return "$" + name;
}

// module_allocates reports whether any function uses an array/alloc op (so the
// heap + RC runtime needs emitting).
pub function module_allocates(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            // Any allocating op needs the heap + RC runtime. ir.op_allocates is
            // the shared list (see ir.fern), identical to asm_ir's heap gate.
            if (ir.op_allocates(r.ops[i].kind_tag)) { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    // String programs need the heap too: $__fern_strcat allocates via
    // $__fern_str_box, and strcat_helpers references it even for a str_eq-only
    // program, so $__fern_str_box (in heap_alloc_helpers) must be present. This
    // also covers the str_len/str_eq/str_cmp/str_index ops that don't allocate
    // themselves but still pull the heap in via $__fern_strcat.
    return module_uses_strings(cache);
}

// field_reclaim_types returns the distinct struct types `T` for which a
// __field_reclaim_<T> helper is called anywhere in the lowered module (#3457).
// wasm emits a per-type REAL reclaim body for each (emit_wasm_field_reclaim_body
// frees the superseded rc-array field buffer on a consume-rebind via
// __fern_snapshot_dec — see wasm.fern:emit_ir_rc_bodies + TestSelfHostFieldReclaimWasm);
// collected by scanning lowered call_direct ops rather than a need-set, matching
// wasm's module_calls-style gating.
pub function field_reclaim_types(cache: irlower.LowerResult[]): string[] {
    var out: string[] = [];
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && asm_ir.is_field_reclaim_name(r.ops[i].str)) {  // call_direct
                var t: string = asm_ir.field_reclaim_type(r.ops[i].str);
                if (util.index_of_str(out, t) < 0) { out = out.append(t); }
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return out;
}

// struct_drop_types returns the distinct struct types `T` for which a
// __struct_drop_<T> helper is called anywhere in the lowered module (#3457 — the
// deep struct-drop, formerly inline). wasm emits a REAL per-type body for each
// (emit_wasm_struct_drop_body — the sibling of the register backends' bodies,
// deep-dropping rc-array + acyclic nested-struct fields); collected by scanning
// lowered call_direct ops (the same gating field_reclaim_types uses) plus the
// transitive nested-struct closure below.
pub function struct_drop_types(cache: irlower.LowerResult[], structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && asm_ir.is_struct_drop_name(r.ops[i].str)) {  // call_direct
                var t: string = asm_ir.struct_drop_type(r.ops[i].str);
                if (util.index_of_str(out, t) < 0) { out = out.append(t); }
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    // Transitive deep-drop closure (Perceus slice 3 deep-drop): emit_wasm_struct_drop_body
    // emits a recursive $__struct_drop_<Inner> call for each nested-struct field that is
    // deep-drop-ok. That recursive call is a backend instruction, not a lowered IR op, so
    // it is invisible to the call_direct scan above — add those inner types here so their
    // bodies are emitted too. nested_field_deep_drop_ok now admits ARBITRARY acyclic depth
    // (not just leaves), so the closure can be multi-level; the index-driven loop re-reads
    // out.len() as it appends, so each newly added inner is itself expanded (the ACYCLIC
    // guarantee bounds this — a type cannot re-appear, so the walk terminates).
    var di: i32 = 0;
    while (di < out.len()) {
        var dt: string = out[di];
        var fc: i32 = irlower.decl_field_count(structs, dt);
        var k: i32 = 0;
        while (k < fc) {
            var ft: string = irlower.decl_field_type_at(structs, dt, k);
            if (irlower.decl_is_struct(structs, ft) && irlower.nested_field_deep_drop_ok(structs, ft)) {
                if (util.index_of_str(out, ft) < 0) { out = out.append(ft); }
            }
            // A struct-ARRAY field `X[]` whose element X is deep-drop-ok: the array-element
            // deep-drop helper ($__struct_arr_elems_drop_X) calls $__struct_drop_X, so X
            // must be a struct_drop type too. Add it here (the index-driven loop then
            // expands X's own reclaimable fields transitively).
            if (irlower.is_struct_array_field_type(structs, ft)) {
                var aelem: str = ft[0 : ft.len() - 2];
                if (irlower.nested_field_deep_drop_ok(structs, aelem)) {
                    if (util.index_of_str(out, aelem) < 0) { out = out.append(aelem); }
                }
            }
            k = k + 1;
        }
        di = di + 1;
    }
    return out;
}

// struct_arr_elems_drop_types returns the distinct struct-array ELEMENT types E for
// which a $__struct_arr_elems_drop_<E> helper must be emitted (#2649): every struct-
// array field `E[]` with a deep-drop-ok element E, reachable from a struct_drop type.
// struct_drop_types already includes each such E as a struct_drop type (so the
// $__struct_drop_<E> the helper calls exists), so this walk over that closure finds
// every needed helper.
pub function struct_arr_elems_drop_types(cache: irlower.LowerResult[], structs: parser.StructDecl[]): string[] {
    var sdt: string[] = struct_drop_types(cache, structs);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < sdt.len()) {
        var fc: i32 = irlower.decl_field_count(structs, sdt[i]);
        var k: i32 = 0;
        while (k < fc) {
            var ft: string = irlower.decl_field_type_at(structs, sdt[i], k);
            if (irlower.is_struct_array_field_type(structs, ft)) {
                var elem: str = ft[0 : ft.len() - 2];
                if (irlower.nested_field_deep_drop_ok(structs, elem) && util.index_of_str(out, elem) < 0) {
                    out = out.append(elem);
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return out;
}

// module_emits_op_cached reports whether any lowered function emits an op of
// `kind` — the shared scanner the random/byte-source helper gates use (issue
// #2747). It reads the pre-lowered cache (lower_all_for) rather than re-lowering
// the module: the emit drivers call it dozens of times per compile, so scanning
// the shared cache once (not re-lowering every function per call) is what makes
// the wasm self-host compile linear (#4652). The op-kind arrives by string;
// resolve it to the integer tag once so the inner scan is an int compare.
// module_uses_c_call reports whether any function calls an FFI `__c_call<n>`
// shim (a call_direct, kind 149, whose callee is is_c_call). Wasm has no C-ABI,
// so such a module stays off the wasm IR path — native parity: native wasm has
// no __c_call either (#4375). module_emits_op_cached can't express this (it
// matches by op KIND; __c_call is an ordinary direct call), so scan by name.
function module_uses_c_call(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && asm_ir.is_c_call(r.ops[i].str)) { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

pub function module_emits_op_cached(cache: irlower.LowerResult[], kind: string): boolean {
    var ktag: i32 = ir.kind_id(kind);
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == ktag) { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_str_predicate reports whether any function emits a scalar string
// search predicate op (starts_with / ends_with / index_of, the latter also
// backing `contains`), so wasm.str_predicate_helpers is emitted for the IR path.
pub function module_uses_str_predicate(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_starts_with")
        || module_emits_op_cached(cache, "str_ends_with")
        || module_emits_op_cached(cache, "str_index_of");
}

// module_uses_str_case reports whether any function emits an ASCII case-transform
// op (to_upper / to_lower), so wasm.str_case_helpers is emitted for the IR path.
pub function module_uses_str_case(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_to_upper") || module_emits_op_cached(cache, "str_to_lower");
}

// module_uses_str_repeat reports whether any function emits the str_repeat op, so
// wasm.str_repeat_helper is emitted for the IR path.
pub function module_uses_str_repeat(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_repeat");
}

// module_uses_str_trim reports whether any function emits the str_trim op, so
// wasm.str_trim_helper is emitted for the IR path. (wasm's AST path has no trim,
// so this is IR-only — no AST counterpart to differential-test against.)
pub function module_uses_str_trim(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_trim");
}

// module_uses_str_reverse reports whether any function emits the str_reverse op,
// so wasm.str_reverse_helper is emitted for the IR path. (IR-only, like trim.)
pub function module_uses_str_reverse(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_reverse");
}

// module_uses_str_replace reports whether any function emits the str_replace op,
// so wasm.str_replace_helper is emitted for the IR path. (IR-only, like trim.)
pub function module_uses_str_replace(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_replace");
}

// module_uses_str_chars reports whether any function emits the str_chars op, so
// wasm.str_chars_helper is emitted for the IR path. (IR-only, like trim.)
pub function module_uses_str_chars(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_chars");
}

// module_uses_str_lines reports whether any function emits the str_lines op, so
// wasm.str_lines_helper (and the str_split/substr it depends on) are emitted.
pub function module_uses_str_lines(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_lines");
}

// module_uses_i32_to_string reports whether any function emits the i32.to_string()
// runtime call (a call_direct to __fern_i32_to_string) — so the heap allocator +
// $__fern_i32_to_str helper (wasm.to_string_helpers) are emitted, even for an
// otherwise alloc-free module. (module_emits_op keys on op.kind, not the
// call_direct symbol, so this needs its own scan.)
pub function module_uses_i32_to_string(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_i32_to_string") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_str_to_i32 reports whether any function emits the str_to_i32(s)
// runtime call (a call_direct to __fern_str_to_i32) — so wasm.str_to_i32_helper
// is emitted. Allocation-free, so it has no heap dependency. (module_emits_op
// keys on op.kind, not the call_direct symbol, so this needs its own scan.)
pub function module_uses_str_to_i32(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_str_to_i32") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_strbuf reports whether any function emits a global string-builder
// op (strbuf_reset / strbuf_append / strbuf_take) — so wasm.strbuf_helpers + the
// heap allocator are emitted. strbuf_take boxes its result via $__fern_str_box,
// so the strbuf gate also pulls the heap in (folds into the heap gate alongside
// module_allocates / module_uses_i32_to_string / module_uses_chr).
pub function module_uses_strbuf(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "strbuf_reset") || module_emits_op_cached(cache, "strbuf_append")
        || module_emits_op_cached(cache, "strbuf_take");
}

// module_uses_chr reports whether any function emits the chr(n) runtime call (a
// call_direct to __fern_chr) — so wasm.chr_helper + the heap allocator are
// emitted. chr allocates its 1-char box, so the chr gate also pulls the heap in.
pub function module_uses_chr(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_chr") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_calls_strarrarr_free reports whether any function lowers a
// __fern_strarrarr_free call (string[][] whole-structure reclaim, #4355
// slice 9) — so wasm.arr_dec_ptr2_func is emitted. Kept OUT of
// heap_alloc_helpers: the $__fern_arr_dec_ptr2 body contains a
// `call $__fern_arr_dec_ptr`, which would trip the negative WAT-grep
// contracts (strarr-elem-alias-excluded) in every allocating module.
// module_calls_optarrarr_free: any function lowers a __fern_optarrarr_free
// call (#4365 Option[<arr>][] reclaim) — gates the $__fern_optarrarr_free WAT
// body emission, same pattern as module_calls_strarrarr_free below.
pub function module_calls_optarrarr_free(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_optarrarr_free") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

pub function module_calls_strarrarr_free(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_strarrarr_free") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_random reports whether the module calls random_bytes or random_i32
// (so the wasi random_get import is emitted).
pub function module_uses_random(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "random_bytes") || module_emits_op_cached(cache, "random_i32");
}

// module_uses_divrem reports whether any function uses i32 div/rem (so the
// non-trapping $__fern_idiv / $__fern_irem helpers need emitting).
pub function module_uses_divrem(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 24 || r.ops[i].kind_tag == 26) { return true; }  // div_s, rem_s
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_i64_divrem reports whether any div/rem op runs at 64-bit width, so
// the $__fern_idiv64 / $__fern_irem64 helpers (divrem64_helpers) need emitting.
// module_uses_arr_slice reports whether any function emits a 4-byte-element
// arr_slice op (width 32), so the $__fern_arr_slice helper needs emitting.
pub function module_uses_arr_slice(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 96 && r.ops[i].width != 64) { return true; }  // arr_slice
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}
// module_uses_arr_slice8 reports whether any function emits an 8-byte-element
// arr_slice op (width 64, f64[]), so the $__fern_arr_slice8 helper needs
// emitting. Distinct from module_uses_arr_slice so a program slicing only one
// element width pulls in only the helper it calls.
pub function module_uses_arr_slice8(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 96 && r.ops[i].width == 64) { return true; }  // arr_slice
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

pub function module_uses_i64_divrem(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if ((r.ops[i].kind_tag == 24 || r.ops[i].kind_tag == 26) && r.ops[i].width == 64) { return true; }  // div_s, rem_s
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// wasm_eligible: the whole module is in the IR's i32 + arrays subset (the same
// backend-independent gate the asm backends use — rejects non-lowerable
// functions and builtin calls). wasm covers everything that gate admits.
// wasm_eligible is the WASM eligibility gate — eligible_core, the same gate the
// register backends now use (all_eligible). Plain function values (const_func /
// call_indirect) are admitted on every backend; wasm lowers them through a
// funcref table (fn_support_section), the register backends through the
// function's code address.
pub function wasm_eligible(mod: parser.Module): boolean {
    // read_line / read_int / args / read_file / write_file all lower on the wasm
    // IR path now: wasm_ir emits `call $__fern_<op>` and wasm_ir_run pulls in the
    // matching wasi imports + helpers when the module uses them. read_line /
    // read_int read stdin (fd 0) via fd_read — read_line boxes the line (newline
    // stripped), read_int parses a leading integer; args() reads argv (wasmtime
    // supplies it, argv[0] = program name); read_file / write_file open paths
    // under preopen fd 3 (run with `--dir`), returning Result[string, IoError] /
    // Option[IoError]. read_chunk / reader_close (the streaming reader API) now
    // lower on the wasm IR path too: wasm_ir emits `call $__fern_reader_read_chunk`
    // / `call $__fern_reader_close`, and wasm_ir_run pulls in the preview1 fd_read
    // / fd_close imports + the reader helpers when the module uses them. A Reader is
    // just its fd (stdin() = fd 0), so read_chunk reads stdin the same way read_line
    // does; this backs the std/io read_all_stdin loop on wasm.
    // The clock builtins (monotonic_ns / now_unix_ms / now_ns) DO lower on the
    // wasm IR path now: wasm_ir emits `call $__fern_<clock>` for each op and
    // wasm_ir_run pulls in the preview1 wasi clock_time_get import + the
    // clock_funcs helpers (the same runtime the AST path uses) when the module
    // calls any clock builtin (#3893 follow-up). sleep_ms still has no wasm
    // runtime (a WASI poll-based sleep is the deferred #2843 item), so a sleep
    // module stays off the wasm IR path.
    // `m.without(k)` (map_delete) now lowers via the IR: wasm's
    // $__fern_map_delete returns a [map, existed] tuple box (the wasm tuple ABI,
    // element i at offset i*4) matching the register backends, so the IR
    // tuple-destructure reads it correctly (#2933 — previously it returned just
    // the box, a different ABI, so a delete module was pinned to the AST path).
    // The global string-builder ops (strbuf_reset / strbuf_append / strbuf_take)
    // now lower on the wasm IR path too: wasm_ir emits `call $__fern_strbuf_<op>`
    // and the runtime (wasm.strbuf_helpers — a growable bump-heap buffer) is pulled
    // in by module_uses_strbuf, which also folds into the heap gate. The wasm AST
    // backend never had strbuf, so this is the only wasm strbuf path.
    // The libm transcendentals (sin / cos / exp / log / pow) lower through the IR
    // on every backend: x86 (x87 FPU), arm64 (polynomial-approx runtime helpers),
    // and wasm via the polynomial-approx WAT helpers (wasm.exp_func / log_func /
    // pow_func / …) that wasm_ir_run pulls in when a module calls one — see the
    // fexp/flog/fsin/fcos/fpow arms below (kind_tag 62+), which emit
    // `call $__fern_<op>_f64`. They are NOT in the deferral list.
    if (!asm_ir.eligible_core(mod)) { return false; }
    return wasm_ir_deferrals_ok(lower_all_for(mod));
}

// wasm_ir_deferrals_ok is the non-eligible_core half of wasm_eligible evaluated
// over a pre-lowered cache: the set of ops that DON'T yet lower on the wasm IR
// backend (poll / timer_fd / the tcp_* socket set / subprocess / wasm_poll — the
// component-model / socket runtime the bare core-wasm+preview1 backend doesn't
// wire). Split out of wasm_eligible so the emit dispatch can build the cache
// ONCE — after the cheap eligible_core AST gate passes — and reuse it for both
// this deferral gate AND emit, instead of re-lowering the whole module ~10× via
// the mod-taking module_emits_op. Byte-identical to the old inline chain (#4652).
// module_erased_wide: any lowered function passes a 64-bit / f64 value
// through a bare-typevar (erased-generic) param (LowerResult.erased_wide).
// The wasm backend types erased param locals i32, so such a module must stay
// on the AST path — previously an f64-through-erased call emitted
// type-invalid WAT the wasmtime loader rejects, and (post the register-side
// widening) an i64 would truncate.
function module_erased_wide(cache: irlower.LowerResult[]): boolean {
    var i: i32 = 0;
    while (i < cache.len()) {
        if (cache[i].erased_wide) { return true; }
        i = i + 1;
    }
    return false;
}

pub function wasm_ir_deferrals_ok(cache: irlower.LowerResult[]): boolean {
    return true
        && !module_erased_wide(cache)
        // poll has no wasm IR runtime: real readiness on wasm needs the
        // component-model wasi:io/poll multiplexer (list<pollable>), which the
        // self-host wasm backend doesn't wire (it is bare core-wasm + WASI
        // preview1). x86-64 (poll(2)) and arm64 (ppoll(2)) lower it via the IR;
        // a poll module stays on the wasm AST path. (sleep_ms, by contrast, needs
        // only a single-clock poll_oneoff and DOES lower on the wasm IR path — see
        // $__fern_sleep_ms; it is no longer deferred.)
        && !module_emits_op_cached(cache, "poll")
        // timer_fd is the native timerfd (fd-based); it has no direct wasm
        // preview2 analog (the wasm reactor uses wasm_timer_pollable instead), so
        // a timer_fd module stays on the wasm AST path for now.
        && !module_emits_op_cached(cache, "timer_fd")
        // wasm_timer_pollable / wasm_pollable_drop / wasm_block DO lower on the
        // wasm IR path now (#3457 / #4317): wasm_ir emits direct preview2 calls
        // (wasi:clocks/monotonic-clock.subscribe-duration, wasi:io/poll
        // [method]pollable.block, [resource-drop]pollable) and wasm_ir_run adds the
        // matching component imports; the module composes to a component via
        // `wasm-tools component new`. wasm_block makes a wasm_timer_pollable timer
        // observably block (subscribe → block → the duration elapses).
        // wasm_poll (the wasi:io/poll.poll list<pollable> -> list<u32> readiness
        // multiplexer) does NOT lower on the wasm IR path yet (#4316): its LIST
        // params/results need component-type metadata (encoded WIT in a custom
        // section) for `wasm-tools component new` to synthesise the canonical-ABI
        // adapters — the scalar pollable ops above compose without it, but a
        // list-typed import cannot. That metadata-emission subsystem (the shared
        // prerequisite for poll AND the tcp stream/resource imports) is the next
        // slice. wasm_poll DOES lower on every other backend (native x86-64/arm64
        // + interp + the self-host register IR paths) as a -1 portability shim.
        && !module_emits_op_cached(cache, "wasm_poll")
        // tcp_* client primitives: native lowers them via the IR (socket
        // syscalls + the self-host string ABI for recv/send), but the
        // self-host wasm backend has no socket runtime (wasm sockets need the
        // component-model wasi:sockets interfaces), so a tcp module stays on the
        // wasm AST path. Same deferral as poll/timer_fd.
        && !module_emits_op_cached(cache, "tcp_connect")
        && !module_emits_op_cached(cache, "tcp_send")
        && !module_emits_op_cached(cache, "tcp_recv")
        && !module_emits_op_cached(cache, "tcp_close")
        && !module_emits_op_cached(cache, "tcp_pollable")
        && !module_emits_op_cached(cache, "tcp_listen")
        && !module_emits_op_cached(cache, "tcp_accept")
        && !module_emits_op_cached(cache, "writer_write")
        && !module_emits_op_cached(cache, "open_file")
        && !module_emits_op_cached(cache, "subprocess")
        // FFI __c_call<n> has no wasm C-ABI meaning (#4375) — native wasm has no
        // __c_call, so a module using it stays on the wasm AST path here.
        && !module_uses_c_call(cache);
}

// should_use_ir_core is the CHEAP gate the emit dispatch (wasm.emit_module)
// consults to route a module through the IR: the use_ir default is on AND the
// module passes the AST-only eligible_core gate, WITHOUT the module_emits_op
// deferral checks (those need the lowered cache). The dispatch calls this first;
// only if it passes does it build the LowerResult cache (lower_all_for) ONCE and
// finish the gate with wasm_ir_deferrals_ok(cache) — so an IR-eligible module is
// lowered a single time for gate+emit instead of the old ~10× (deferral scan) +
// ~20× (emit collect passes). eligible_core is a pure AST walk, so bailing here
// keeps the ineligible-module bootstrap path from ever lowering (#4652). Uses
// eligible_core (not all_eligible) so function-value modules lower on wasm.
pub function should_use_ir_core(mod: parser.Module): boolean {
    return asmcore.new_state().use_ir && asm_ir.eligible_core(mod);
}

// Preview-2 component-model imports for the wasm reactor's timer-pollable ops
// (#3457 / #4317). Emitted into the module header (caller-side, wasm_ir_run) when
// the module uses the op, exactly like the preview1 import helpers — but these
// name a *component* interface, so the emitted core module must be composed with
// `wasm-tools component new` before it runs (wasmtime can't resolve a preview2
// interface for a bare core module). wasm_timer_pollable subscribes a
// monotonic-clock timer; wasm_pollable_drop drops the resulting pollable
// resource. Both are the SAME wasi:io/poll pollable a socket subscribe yields.
pub function wasi_subscribe_duration_import(): string {
    return "  (import \"wasi:clocks/monotonic-clock@0.2.0\" \"subscribe-duration\" (func $__fern_wasi_subscribe_duration (param i64) (result i32)))\n";
}
pub function wasi_pollable_drop_import(): string {
    return "  (import \"wasi:io/poll@0.2.0\" \"[resource-drop]pollable\" (func $__fern_wasi_pollable_drop (param i32)))\n";
}
// wasm_block: [method]pollable.block synchronously waits (param i32 self, no
// result) until the pollable is ready. The primitive that makes
// wasm_timer_pollable observably block. Same wasi:io/poll interface as the drop.
pub function wasi_pollable_block_import(): string {
    return "  (import \"wasi:io/poll@0.2.0\" \"[method]pollable.block\" (func $__fern_wasi_pollable_block (param i32)))\n";
}

// lift_lambdas re-exports irlower's lambda-lift pre-pass (closures slice 2a) so
// the wasm dispatch sites can hoist no-capture lambda arguments before the
// eligibility check + emit. A lambda-free module is returned unchanged.
pub function lift_lambdas(mod: parser.Module): parser.Module {
    return irlower.lift_lambdas(mod);
}

// fn_value_table collects the module's address-taken functions (the targets of
// const_func ops) in first-seen, deduped order. The position of a name here is
// its funcref-table slot index — both the const_func `i32.const <idx>` and the
// elem segment in fn_support_section index into this list, so they agree.
// pipe_before / pipe_after split op_map_new's packed struct "hash|eq" fns.
pub function pipe_before(s: string): string {
    var i: i32 = 0;
    while (i < s.len() && s[i] != 124) { i = i + 1; }   // '|'
    return s[0:i] + "";
}
pub function pipe_after(s: string): string {
    var i: i32 = 0;
    while (i < s.len() && s[i] != 124) { i = i + 1; }
    if (i >= s.len()) { return ""; }
    return s[i + 1 : s.len()] + "";
}

pub function fn_value_table(cache: irlower.LowerResult[]): string[] {
    var out: string[] = [];
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 6 && util.index_of_str(out, r.ops[i].str) < 0) {  // const_func
                out = out.append(r.ops[i].str);
            }
            // A struct/enum-keyed map (op_map_new kind 2) takes the derived
            // hash/eq via call_indirect, so they are address-taken too — add
            // them to the funcref table so map_new can store their slot indices
            // in the box. #2671.
            if (r.ops[i].kind_tag == 124 && r.ops[i].i32_imm == 2 && r.ops[i].str.len() > 0) {  // map_new
                var hf: string = pipe_before(r.ops[i].str);
                var ef: string = pipe_after(r.ops[i].str);
                if (util.index_of_str(out, hf) < 0) { out = out.append(hf); }
                if (util.index_of_str(out, ef) < 0) { out = out.append(ef); }
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return out;
}

// indirect_arities collects the distinct argument counts used by call_indirect
// ops across the module (deduped), so fn_support_section declares one
// `$fn<argc>` signature type per arity actually dispatched.
function indirect_arities(cache: irlower.LowerResult[]): i32[] {
    var out: i32[] = [];
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 150 && !slot_in_list(out, r.ops[i].i32_imm)) {  // call_indirect
                out = out.append(r.ops[i].i32_imm);
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    // map_helpers' hk/keq reference (type $fn1) (derived hash) and (type $fn2)
    // (derived eq) via call_indirect for struct/enum keys — and that wat is
    // emitted whenever ANY map is used, not just a struct-keyed one. So both
    // signature types must exist for every map-using module or the (dead, for
    // i32/string keys) call_indirect fails validation. #2671.
    if (module_uses_maps(cache)) {
        if (!slot_in_list(out, 1)) { out = out.append(1); }
        if (!slot_in_list(out, 2)) { out = out.append(2); }
    }
    return out;
}

// fn_support_section emits the WAT module items that back plain function values:
// one `(type $fn<N> (func (param i32)×N (result i32)))` per dispatched arity, a
// `(table <M> funcref)` sized to the address-taken set, and an `(elem (i32.const
// 0) $f0 $f1 …)` filling it in fn_value_table order. Empty string when the
// module has no function values, so non-closure modules are byte-unchanged.
pub function fn_support_section(cache: irlower.LowerResult[]): string {
    var ft: string[] = fn_value_table(cache);
    var arities: i32[] = indirect_arities(cache);
    if (ft.len() == 0 && arities.len() == 0) { return ""; }
    var out: string = "";
    var ai: i32 = 0;
    while (ai < arities.len()) {
        out = out + "  (type $fn" + util.i32_to_string(arities[ai]) + " (func";
        var pj: i32 = 0;
        while (pj < arities[ai]) { out = out + " (param i32)"; pj = pj + 1; }
        out = out + " (result i32)))\n";
        ai = ai + 1;
    }
    // The table must exist for any call_indirect to validate — including the
    // map's struct-key hk/keq, which is emitted (but dead) even when no
    // function VALUE is taken. Size it to the funcref set, or a minimal 1 slot
    // when the only indirect calls are the (dead-for-i32/string) map ones.
    var tsize: i32 = ft.len();
    if (tsize == 0) { tsize = 1; }
    out = out + "  (table " + util.i32_to_string(tsize) + " funcref)\n";
    if (ft.len() > 0) {
        out = out + "  (elem (i32.const 0)";
        var ei: i32 = 0;
        while (ei < ft.len()) {
            out = out + " $" + ft[ei];
            ei = ei + 1;
        }
        out = out + ")\n";
    }
    return out;
}

// emit_function_ir renders one IR-eligible function as a WAT (func ...). Locals
// are numeric: slots 0..n_params-1 the params, n_params..n_locals-1 the body
// locals, plus TWO scratch locals (indices n_locals, n_locals+1) the array ops
// use to hold a base pointer / popped element while reordering the wasm stack.
function emit_function_ir(fd: parser.FuncDecl, str_vals: string[], structs: parser.StructDecl[], arr_ret: string[], str_ret: string[], strarr_ret: string[], opt_ret: string[], i64_ret: string[], tuple_ret: string[], struct_ret: string[], map_ret: string[], f64_ret: string[], f64arr_ret: string[], i64arr_ret: string[], fn_table: string[], fn_param_sigs: string[], closure_fns: string[], funcs: parser.FuncDecl[], borrowable_params: string[], consume_safe_params: string[]): string {
    var r: irlower.LowerResult = irlower.lower_func(fd, arr_ret, structs, str_ret, strarr_ret, irlower.arr_method_fns_of(funcs), opt_ret, i64_ret, tuple_ret, struct_ret, map_ret, f64_ret, f64arr_ret, i64arr_ret, fn_param_sigs, closure_fns, irlower.closurearr_ret_fns_of(funcs), irlower.const_fns_of(funcs), borrowable_params, irlower.fn_names_of(funcs), irlower.fresh_struct_ret_fns_of(funcs, structs), consume_safe_params, irlower.return_fresh_struct_ret_fns_of(funcs, structs), irlower.str_fresh_ret_fns_of(funcs), irlower.opt_fresh_ret_fns_of(funcs, structs), irlower.strfld_reclaim_ok_types_of(funcs, structs), irlower.tuple_fresh_ret_fns_of(funcs));
    var arrtmp: i32 = r.n_locals;
    var eltmp: i32 = r.n_locals + 1;
    // f64tmp: an f64-typed scratch local for reordering 64-bit struct field
    // values (struct_make / struct_set) through the typed wasm stack — the i32
    // eltmp can't hold an f64.
    var f64tmp: i32 = r.n_locals + 2;
    // i64tmp: an i64-typed scratch local for reordering 8-byte INTEGER array
    // elements (i64[] arr_make / arr_set) through the typed wasm stack — the i32
    // eltmp can't hold an i64, and f64tmp is float-typed.
    var i64tmp: i32 = r.n_locals + 3;
    // Methods get the receiver-type-qualified name `$<Type>.<name>` (matching
    // irlower's call_direct dispatch); free functions stay `$<name>`. WAT idents
    // allow `.`. r.n_params already counts the receiver as the first param.
    var fn_name: string = fd.name;
    if (fd.receiver_type.len() > 0) { fn_name = util.base_type_name(fd.receiver_type) + "." + fd.name; }
    var out: string = "  (func $" + fn_name;
    var p: i32 = 0;
    while (p < r.n_params) {
        // An i64 param is in r.i64_slots, an f64 param in r.f64_slots (lower_func
        // marks them); the receiver slot 0 of a method never is.
        if (slot_in_list(r.i64_slots, p)) { out = out + " (param i64)"; }
        else if (slot_in_list(r.f64_slots, p)) { out = out + " (param f64)"; }
        else { out = out + " (param i32)"; }
        p = p + 1;
    }
    // u64 returns ride the i64 result type (8-byte; only signedness of the
    // value's own ops differs, handled at the producing expression) (#2904).
    if (fd.ret_type == "i64" || fd.ret_type == "u64") { out = out + " (result i64)\n"; }
    else if (irlower.is_f64_scalar_type_name(fd.ret_type)) { out = out + " (result f64)\n"; }
    else { out = out + " (result i32)\n"; }
    // body locals + 4 scratch locals. A body local in r.i64_slots is declared
    // (local i64), one in r.f64_slots (local f64); the trailing scratch locals
    // are two i32 (arrtmp/eltmp), one f64 (f64tmp), one i64 (i64tmp).
    var nbody: i32 = r.n_locals - r.n_params;
    var nloc: i32 = nbody + 4;
    out = out + "    (local";
    var l: i32 = 0;
    while (l < nloc) {
        if (l == nbody + 2) {
            out = out + " f64";
        } else if (l == nbody + 3) {
            out = out + " i64";
        } else if (l < nbody && slot_in_list(r.i64_slots, r.n_params + l)) {
            out = out + " i64";
        } else if (l < nbody && slot_in_list(r.f64_slots, r.n_params + l)) {
            out = out + " f64";
        } else {
            out = out + " i32";
        }
        l = l + 1;
    }
    out = out + ")\n";
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind_tag == 1) {  // const_i32
            out = out + "    i32.const " + util.i32_to_string(o.i32_imm) + "\n";
        } else if (o.kind_tag == 2) {  // const_i32_text
            // Integer literal source text — the wasm text parser handles the base
            // (hex `0x..`) and the full i32/u32 immediate range.
            out = out + "    i32.const " + o.str + "\n";
        } else if (o.kind_tag == 3) {  // const_i64
            // 64-bit immediate (source text). load_local / store_local on i64
            // slots use the same local.get/local.set — the local's declared i64
            // type carries the stack type.
            out = out + "    i64.const " + o.str + "\n";
        } else if (o.kind_tag == 4) {  // const_f64
            // Float literal: wasm assembles the source text directly. f64 locals
            // are declared (local f64), so local.get/set carry the stack type.
            out = out + "    f64.const " + o.str + "\n";
        } else if (o.kind_tag == 11) {  // i32_to_f64
            out = out + "    f64.convert_i32_s\n";
        } else if (o.kind_tag == 12) {  // f64_to_i32
            // Saturating truncation: NaN -> 0, overflow -> clamp (#4332). The
            // non-saturating i32.trunc_f64_s TRAPS on NaN/overflow, aborting the
            // module; the contract (docs/FLOAT-SEMANTICS.md) is total-saturating.
            // Unsigned (`f64 as u32`) saturates over the full u32 range.
            if (o.unsigned) { out = out + "    i32.trunc_sat_f64_u\n"; }
            else { out = out + "    i32.trunc_sat_f64_s\n"; }
        } else if (o.kind_tag == 13) {  // f64_to_i64
            if (o.unsigned) { out = out + "    i64.trunc_sat_f64_u\n"; }
            else { out = out + "    i64.trunc_sat_f64_s\n"; }
        } else if (o.kind_tag == 16) {  // f64_bits
            // f64 -> i64 bit reinterpret (typed stack flips f64 -> i64).
            out = out + "    i64.reinterpret_f64\n";
        } else if (o.kind_tag == 17) {  // f64_from_bits
            // i64 -> f64 bit reinterpret (typed stack flips i64 -> f64).
            out = out + "    f64.reinterpret_i64\n";
        } else if (o.kind_tag == 14) {  // f32_bits
            // f64 -> f32 (demote), reinterpret to its i32 bit pattern.
            out = out + "    f32.demote_f64\n    i32.reinterpret_f32\n";
        } else if (o.kind_tag == 15) {  // f32_from_bits
            // reinterpret the i32 bits as an f32, promote to f64.
            out = out + "    f32.reinterpret_i32\n    f64.promote_f32\n";
        } else if (o.kind_tag == 61) {  // fround
            // round-half-away-from-zero (Go's math.Round). wasm's f64.nearest is
            // ties-to-EVEN, so emulate via trunc(x + copysign(0.5, x)): stash x in
            // the f64 scratch local, then add copysign(0.5, x) and truncate. (The
            // other op_funary kinds are single instructions routed via wasm_binop_w;
            // this one needs the scratch to reuse x twice.)
            out = out + "    local.set " + util.i32_to_string(f64tmp) + "\n";
            out = out + "    local.get " + util.i32_to_string(f64tmp) + "\n";
            out = out + "    f64.const 0.5\n";
            out = out + "    local.get " + util.i32_to_string(f64tmp) + "\n    f64.copysign\n";
            out = out + "    f64.add\n    f64.trunc\n";
        } else if (o.kind_tag == 62) {  // fexp
            // e^x: wasm has no transcendental instruction, so call the polynomial
            // runtime $__fern_exp_f64 (emitted caller-side in wasm_ir_run). The f64
            // operand is already on the stack; the call consumes it and pushes e^x.
            // The arm64 backend lowers fexp the same way (bl __fern_exp_f64); this
            // is the wasm sibling of that polynomial helper.
            out = out + "    call $__fern_exp_f64\n";
        } else if (o.kind_tag == 63) {  // flog
            // ln(x): wasm has no transcendental instruction, so call the polynomial
            // runtime $__fern_log_f64 (emitted caller-side in wasm_ir_run). The f64
            // operand is already on the stack; the call consumes it and pushes ln(x).
            // The arm64 backend lowers flog the same way (bl __fern_log_f64); this is
            // the wasm sibling of that polynomial helper.
            out = out + "    call $__fern_log_f64\n";
        } else if (o.kind_tag == 64) {  // fsin
            // sin(x): no wasm instruction -> call the polynomial runtime
            // $__fern_sin_f64 (emitted caller-side in wasm_ir_run). f64 operand on
            // the stack; the call consumes it and pushes sin(x). arm64 lowers fsin
            // the same way (bl __fern_sin_f64).
            out = out + "    call $__fern_sin_f64\n";
        } else if (o.kind_tag == 65) {  // fcos
            // cos(x): same as fsin, calling $__fern_cos_f64.
            out = out + "    call $__fern_cos_f64\n";
        } else if (o.kind_tag == 178) {  // read_chunk
            // r.read_chunk(n) -> Option[string]. A Reader is just its fd (stdin =
            // fd 0), so fd + n are on the stack; $__fern_reader_read_chunk reads up
            // to n bytes via preview1 fd_read and boxes Some(chunk) / None at EOF.
            // Emitted caller-side in wasm_ir_run. Mirrors asm_ir's read_chunk op.
            out = out + "    call $__fern_reader_read_chunk\n";
        } else if (o.kind_tag == 179) {  // reader_close
            // r.close() -> Option[IoError] (always None). fd on the stack;
            // $__fern_reader_close calls preview1 fd_close and boxes None. Emitted
            // caller-side in wasm_ir_run. Mirrors asm_ir's reader_close op.
            out = out + "    call $__fern_reader_close\n";
        } else if (o.kind_tag == 133) {  // map_iter
            // m.iter() -> a 12-byte iterator box [keys@0, vals@4, cursor@8].
            // $__fern_map_iter materializes the live keys/values (map snapshots)
            // and boxes them; emitted caller-side in wasm_ir_run with map_helpers.
            out = out + "    call $__fern_map_iter\n";
        } else if (o.kind_tag == 134) {  // mapiter_has_next
            out = out + "    call $__fern_mapiter_has_next\n";
        } else if (o.kind_tag == 135) {  // mapiter_key
            out = out + "    call $__fern_mapiter_key\n";
        } else if (o.kind_tag == 136) {  // mapiter_value
            out = out + "    call $__fern_mapiter_value\n";
        } else if (o.kind_tag == 137) {  // mapiter_advance
            // bumps the box's cursor in place; pushes a dummy the statement drops.
            out = out + "    call $__fern_mapiter_advance\n";
        } else if (o.kind_tag == 181) {  // sleep_ms
            // sleep_ms(ms): block for ms milliseconds, then push a dummy i32 the
            // statement drops (sleep_ms is void). wasm has no sleep syscall, so the
            // runtime $__fern_sleep_ms uses preview1 poll_oneoff with a single
            // monotonic-clock subscription (emitted caller-side in wasm_ir_run).
            // Standalone, not the reactor's wasi:io/poll path.
            out = out + "    call $__fern_sleep_ms\n";
        } else if (o.kind_tag == 189) {  // wasm_timer_pollable
            // wasm_timer_pollable(dur_ns: i64) -> pollable handle. The wasm
            // reactor's timer primitive: subscribe a monotonic-clock timer and
            // push the wasi:io/poll pollable handle (an i32). Preview-2 direct
            // import (#3457 / #4317) — wasi:clocks/monotonic-clock.subscribe-
            // duration — so a module using it composes to a component via
            // `wasm-tools component new` (a bare core module can't resolve the
            // preview2 interface). The i64 duration is already on the stack.
            out = out + "    call $__fern_wasi_subscribe_duration\n";
        } else if (o.kind_tag == 190) {  // wasm_pollable_drop
            // wasm_pollable_drop(p: i32) -> i32. Drop the wasi:io/poll pollable
            // resource (wasi:io/poll.[resource-drop]pollable), then push 0 for the
            // op's i32 result. Preview-2 direct import, same component path.
            out = out + "    call $__fern_wasi_pollable_drop\n";
            out = out + "    i32.const 0\n";
        } else if (o.kind_tag == 191) {  // wasm_block
            // wasm_block(p: i32) -> i32. Synchronously wait until the pollable is
            // ready (wasi:io/poll.[method]pollable.block), then push 0 for the op's
            // i32 result. This is what makes wasm_timer_pollable observably block:
            // subscribe a timer, block on its pollable, and control returns after
            // the duration elapses. Preview-2 direct import, same component path as
            // the other pollable ops. The pollable handle is already on the stack.
            out = out + "    call $__fern_wasi_pollable_block\n";
            out = out + "    i32.const 0\n";
        } else if (o.kind_tag == 174) {  // temp_dir
            // temp_dir(prefix) -> create a unique `<prefix>-<ns>` directory under
            // the preopen, push a Result[string, IoError] box. $__fern_temp_dir
            // (param i32 prefix, result i32) wraps preview1 path_create_directory +
            // $__fern_monotonic_ns; emitted caller-side in wasm_ir_run. The returned
            // path is preopen-relative (wasm has no absolute /tmp), matching the
            // other wasm fs ops.
            out = out + "    call $__fern_temp_dir\n";
        } else if (o.kind_tag == 7) {  // int_extend
            // i32 -> i64: distinct wasm types, so an explicit widen.
            if (o.unsigned) { out = out + "    i64.extend_i32_u\n"; }
            else { out = out + "    i64.extend_i32_s\n"; }
        } else if (o.kind_tag == 8) {  // int_wrap
            // i64 -> i32: drop the high 32 bits.
            out = out + "    i32.wrap_i64\n";
        } else if (o.kind_tag == 10) {  // u32_wrap
            // No-op: wasm i32 ops are natively 32-bit (already wrap at 2^32), so
            // a u32 arithmetic result needs no extra mask here (unlike the 64-bit
            // register backends). The op exists so the IR is backend-uniform.
        } else if (o.kind_tag == 9) {  // int_cast
            // `x as <ty>` int→int width mask. u32/i32 are identity (the
            // i32 value's bit pattern is already the result); the narrowing
            // cast uses `and`.
            if (o.str == "u8") { out = out + "    i32.const 255\n    i32.and\n"; }
            // u32 / i32: no-op (value already a 32-bit i32).
        } else if (o.kind_tag == 92) {  // arr_push
            // stack: arr, val -> $__fern_arr_push(arr, val) -> grown array.
            out = out + "    call $__fern_arr_push\n";
        } else if (o.kind_tag == 93) {  // arr_push_owned
            // The sole-owner self-append (irlower's !aliased `a = a.append(v)`):
            // reclaims the old buffer on a grow-realloc via $__fern_arr_push_owned
            // (wasm.fern's arr_push_owned_helper — wraps $__fern_arr_push + frees
            // the dead old box through $__fern_arr_dec). Sound: the emit site
            // proved the slot unaliased.
            out = out + "    call $__fern_arr_push_owned\n";
        } else if (o.kind_tag == 94) {  // arr_push_i64
            // stack: arr, i64 val -> the 8-byte-stride push (wasm32 packs i32[] at
            // 4-byte but i64[]/u64[] at 8-byte, so this needs its own helper).
            out = out + "    call $__fern_arr_push_i64\n";
        } else if (o.kind_tag == 95) {  // arr_push_f64
            // stack: arr, f64 val -> the 8-byte-stride push for an f64[] (its own
            // helper takes an f64-typed value, mirroring f64.store in arr_set).
