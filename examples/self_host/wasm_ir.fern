    o = o + "      (br $c)))\n";
    o = o + "    (i32.const -1))\n";
    return o;
}

// print_str_helper emits the `$__fern_print_str` runtime: given a string-block
// pointer `[len@0][bytes@4]`, set the iovec (buf = ptr+4, len = load(ptr)) in the
// low-24 scratch (memory 0/4, nwritten at 8) and fd_write it to stdout (fd 1).
pub function print_str_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_print_str (param $p i32)\n";
    o = o + "    (i32.store (i32.const 0) (i32.add (local.get $p) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.const 4) (i32.load (local.get $p)))\n";
    o = o + "    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
    return o;
}
// eprint_str_helper is print_str_helper to STDERR (fd 2): the IR path's eprint.
// `eprint` is the stderr line-printer — it appends a trailing newline (mirroring
// `print` and the Go-backend / interp / AST-path `eprint`). The newline byte is
// materialised at scratch addr 12 and flushed as a second 1-byte fd_write.
pub function eprint_str_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_eprint_str (param $p i32)\n";
    o = o + "    (i32.store (i32.const 0) (i32.add (local.get $p) (i32.const 4)))\n";
    o = o + "    (i32.store (i32.const 4) (i32.load (local.get $p)))\n";
    o = o + "    (drop (call $fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8)))\n";
    o = o + "    (i32.store8 (i32.const 12) (i32.const 10))\n";
    o = o + "    (i32.store (i32.const 0) (i32.const 12))\n";
    o = o + "    (i32.store (i32.const 4) (i32.const 1))\n";
    o = o + "    (drop (call $fd_write (i32.const 2) (i32.const 0) (i32.const 1) (i32.const 8))))\n";
    return o;
}
// arr_helpers emits the array runtime: $__fern_arr_push appends v to the
// array, growing geometrically (cap 0 → 4, else ×2) into a fresh block
// and copying the elements when full. Returns the (possibly new) pointer,
// matching `xs = xs.append(v)`. Depends on $__fern_alloc.
// arr_slice_helper emits ONLY $__fern_arr_slice (a fresh array holding
// a[start:end), 4-byte i32 elements). Self-contained apart from $__fern_arr_box
// (always emitted with the heap runtime), so the IR path can pull in array
// slicing without the rest of arr_helpers (push / wide variants).
pub function arr_slice_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_slice (param $a i32) (param $start i32) (param $end i32) (result i32)\n";
    o = o + "    (local $n i32) (local $na i32) (local $i i32)\n";
    o = o + "    (if (i32.gt_u (local.get $end) (i32.load (local.get $a))) (then (unreachable)))\n";
    o = o + "    (if (i32.gt_u (local.get $start) (local.get $end)) (then (unreachable)))\n";
    o = o + "    (local.set $n (i32.sub (local.get $end) (local.get $start)))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $na) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $n))\n";
    o = o + "    (local.set $i (i32.const 0))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.add (local.get $start) (local.get $i)) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $na))\n";
    return o;
}

// arr_reverse_helper / arr_concat_helper emit $__fern_arr_reverse and
// $__fern_arr_concat — the WAT twins of the register backends' hand-asm helpers
// of the same name, which back the builtin `xs.reverse()` / `xs.concat(ys)`
// (op_arr_reverse / op_arr_concat). Same array layout and same 4-byte element
// stride as arr_slice_helper above ([len@0][cap@4][elems@8]), and like it the
// copy is a raw slot move — an rc-tracked element is not retained, matching
// every other backend. 8-byte-element arrays never reach here: the lowering
// excludes f64[] / i64[] receivers, so no `*8` variant is needed (contrast
// arr_slice, whose width flag selects $__fern_arr_slice8).
pub function arr_reverse_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_reverse (param $a i32) (result i32)\n";
    o = o + "    (local $n i32) (local $na i32) (local $i i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $a)))\n";
    o = o + "    (local.set $na (call $__fern_arr_box (i32.mul (local.get $n) (i32.const 4))))\n";
    o = o + "    (i32.store (local.get $na) (local.get $n))\n";
    o = o + "    (i32.store (i32.add (local.get $na) (i32.const 4)) (local.get $n))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (i32.store (i32.add (i32.add (local.get $na) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4))) (i32.load (i32.add (i32.add (local.get $a) (i32.const 8)) (i32.mul (i32.sub (i32.sub (local.get $n) (local.get $i)) (i32.const 1)) (i32.const 4)))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $na))\n";
    return o;
}
pub function arr_concat_helper(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_concat (param $a i32) (param $b i32) (result i32)\n";
    o = o + "    (local $an i32) (local $bn i32) (local $na i32) (local $i i32)\n";
    o = o + "    (local.set $an (i32.load (local.get $a)))\n";
