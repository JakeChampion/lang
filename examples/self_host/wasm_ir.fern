// examples/self_host/wasm_ir.fern — the WebAssembly instruction-selector for
// the target-agnostic stack IR (irlower.fern's Op[]). The wasm sibling of
// asm_ir / asm_arm64_ir: it lowers the SAME lowered op stream to textual WAT.
//
// wasm is the most natural target of the three: the IR is a stack machine with
// structured control flow (block / loop / if / else / end / br / br_if) and
// wasm IS that machine, so the lowering is a near-direct transliteration to
// FLAT WAT instructions — const_i32 -> i32.const, load_local i -> local.get i,
// add -> i32.add, the structured ops keep their names, and `br depth` /
// `br_if depth` carry the SAME relative depth the IR already encodes (no label
// generation). A user `call` needs no arg reversal either: the IR pushes args
// arg0-deepest and wasm's `call` consumes them arg0-deepest.
//
// Arrays use wasm's linear-memory layout (matching wasm.fern's __fern_arr_box:
// a = base+8, so rc@[a-8], len@[a], cap@[a+4], element i @ [a+8+i*4], 4-byte
// stride) and reuse wasm.fern's heap/RC runtime verbatim (heap_alloc_helpers +
// rc_runtime_helpers — the size-class freelist allocator, __fern_arr_box,
// __fern_arr_dec, and the rc inc/dec helpers). The Perceus array RC (alias-inc,
// move-on-return, exit dec-sweep, reassignment retain/cow-release) all comes
// from irlower's shared lowering, so wasm gets it for free — the helper calls
// lower to `call $__fern_rc_inc` / `call $__fern_arr_dec`.
//
// Like asm_ir, this is a SEPARATE module imported only by its differential
// driver (wasm_ir_run) — wasm.fern stays untouched until a later fold/flip.

import "./parser";
import "./util";
import "./ir";
import "./irlower";
import "./asm_ir";
import "./asmcore";
import "./astwalk";

// Linear-memory layout for the no-string array subset, computed exactly as
// wasm.emit_module does for an empty string table (tab.next = 24, heap_extra =
// 0): fl_base = roundup8(24 + 16) = 40, the 65536-class freelist, then the
// bump heap at heap_base. heap_base is also the rc helpers' low-address guard.
pub function fl_base(): i32 { return 40; }
pub function fl_cells(): i32 { return 65536; }
pub function heap_base(): i32 { return 40 + 65536 * 4; }

// ---- string literals (data section) -----------------------------------------
// In the IR subset, string literals live in the data section exactly as
// wasm.fern's StrTable lays them out: one `[len:i32 LE][bytes]` block per
// distinct literal, the first at offset 24, each `4 + len` bytes. A string
// VALUE is a pointer to its block; `.len()` reads the i32 at offset 0. Literals
// are static (no heap) — only str_concat allocates (via $__fern_str_box). The
// blocks sit below the freelist/heap, so any literal shifts fl_base/heap_base
// off the empty-table defaults: fl_base_for / heap_base_for recompute them (and
// equal fl_base() / heap_base() when there are no literals). The data section
// and the $__fern_strcat / $__fern_streq helpers are emitted CALLER-side (in
// wasm.fern, which owns le32_escape / wat_escape / strcat_helpers) because
// wasm_ir cannot import wasm without a cycle — same split as the heap runtime.

// lower_all_for lowers EVERY function of `mod` to its IR ops ONCE, returning the
// per-function LowerResult list in mod.funcs order. It is the cache the wasm IR
// emit path threads through its two dozen collect / gate passes (str_values,
// module_uses_*, module_emits_op_cached, field_reclaim_types, fn_value_table, …)
// so a module is lowered a single time instead of once per pass — killing the
// O(functions²) × O(passes) re-lowering that OOMed the self-host wasm compile of
// large / many-function modules (#4652).
//
// Each element is byte-identical to irlower.lower_func_for(fn, …): the ~20
// `*_of(funcs)` side-tables are pure functions of mod.funcs / mod.structs, so
// hoisting them out of the per-function loop (computed once here, not once per
// call) yields the same ops, and the argument vector otherwise mirrors
// lower_func_for's exactly (including the empty consume_safe_params — the query
// passes deliberately use the per-function borrowability, NOT the interprocedural
// fixpoint the emit path threads through emit_function_ir).
// lower_all_for_view lowers ONE unit's functions against a WHOLE-PROGRAM view
// (#5331 step 4b). Same split as emit_functions_view, one layer down: the side
// tables must see every function in the program (a call is lowered by its
// CALLEE's shape, and a unit calls into its siblings), while the loop lowers
// only this unit's functions.
pub function lower_all_for_view(mod: parser.Module, all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[]): irlower.LowerResult[] {
    var arf: string[] = asm_ir.array_ret_fns_of(all_funcs);
    var srf: string[] = irlower.append_dyn_str_ret_fns(irlower.str_ret_fns_of(all_funcs), mod.trait_reqs);
    var sarf: string[] = irlower.append_dyn_arr_ret_fns(irlower.strarr_ret_fns_of(all_funcs), mod.trait_reqs, "string[]");
    var amf: string[] = irlower.arr_method_fns_of(all_funcs);
    var orf: string[] = irlower.opt_ret_fns_of(all_funcs);
    var irf: string[] = irlower.append_dyn_i64_ret_fns(irlower.i64_ret_fns_of(all_funcs), mod.trait_reqs);
    var trf: string[] = irlower.tuple_ret_fns_of(all_funcs);
    var srtf: string[] = irlower.struct_ret_fns_of(all_funcs, all_structs);
    var mrtf: string[] = irlower.map_ret_fns_of(all_funcs);
    var frf: string[] = irlower.append_dyn_f64_ret_fns(irlower.f64_ret_fns_of(all_funcs), mod.trait_reqs);
    var farf: string[] = irlower.append_dyn_arr_ret_fns(irlower.f64arr_ret_fns_of(all_funcs), mod.trait_reqs, "f64[]");
    var iarf: string[] = irlower.i64arr_ret_fns_of(all_funcs);
    var fps: string[] = irlower.fn_param_sigs_of(all_funcs, all_structs);
    var cfs: string[] = irlower.closure_and_fnptr_fns_of(all_funcs, all_structs);
    var cnf: string[] = irlower.const_fns_of(all_funcs);
    // The emit path (emit_functions_view) lowers each function with the
    // INTERPROCEDURAL borrowability + consume-safe fixpoint. RC drop/reclaim
    // insertion is gated on those, so the metadata this cache feeds
    // (field_reclaim_types / struct_drop_types / …) only matches the emitted
    // text when this lowering uses the SAME analysis. Using per-function
    // borrowability + an empty consume-safe set here (as an earlier version did)
    // makes the collectors UNDER-report the drops emit actually generates, so a
    // per-module link references a `$__field_reclaim_<T>` / `$__struct_drop_<T>`
    // body the RC-body emission never produced — the flatten__RewriteCtx /
    // parser__StructDecl gap the whole-compiler wasm link surfaced (#5508). A
    // whole-program program with the same consume-rebind shape hit it too; the
    // big never-before-wasm-emitted modules were just the first to.
    var bp: string[] = irlower.borrowable_params_interproc(all_funcs);
    var csp: string[] = irlower.consume_safe_params_interproc(all_funcs, bp);
    var fnames: string[] = irlower.fn_names_of(all_funcs);
    var frsf: string[] = irlower.fresh_struct_ret_fns_of(all_funcs, all_structs);
    var rfrsf: string[] = irlower.return_fresh_struct_ret_fns_of(all_funcs, all_structs);
    var sfrf: string[] = irlower.str_fresh_ret_fns_of(all_funcs);
    var ofrf: string[] = irlower.opt_fresh_ret_fns_of(all_funcs, all_structs);
    var sfot: string[] = irlower.strfld_reclaim_ok_types_of(all_funcs, all_structs);
    var tfrf: string[] = irlower.tuple_fresh_ret_fns_of(all_funcs);
    var out: irlower.LowerResult[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        out = out.append(irlower.lower_func(mod.funcs[fi], arf, all_structs, srf, sarf, amf, orf, irf, trf, srtf, mrtf, frf, farf, iarf, fps, cfs, irlower.closurearr_ret_fns_of(all_funcs, all_structs), cnf, bp, fnames, frsf, csp, rfrsf, sfrf, ofrf, sfot, tfrf, true));
        fi = fi + 1;
    }
    return out;
}

// lower_all_for is the single-unit case: the unit IS the whole program.
pub function lower_all_for(mod: parser.Module): irlower.LowerResult[] {
    return lower_all_for_view(mod, mod.funcs, mod.structs);
}

// str_values collects the module's distinct string literals (first-seen order,
// deduped) from the lowered IR. Both the caller's data-section emission and the
// per-function const_str offset lookup walk this same list, so offsets agree.
pub function str_values(cache: irlower.LowerResult[]): string[] {
    var vals: string[] = [];
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 5) {  // const_str
                var v: string = r.ops[i].str;
                var seen: boolean = false;
                var k: i32 = 0;
                while (k < vals.len()) {
                    if (vals[k] == v) { seen = true; }
                    k = k + 1;
                }
                if (!seen) { vals = vals.append(v); }
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return vals;
}

// str_offset returns the data-section offset of literal index `idx`: 24 + the
// summed block sizes (4 + len) of all prior literals.
// str_region_base is where a unit's string-literal region starts: the 24-byte
// low scratch (fd_write iovec at 0/4/8, the newline byte at 12) sits below it.
// Named rather than inlined because const_str now emits offsets RELATIVE to it
// (#5331 step 1), so the two must agree by construction.
pub function str_region_base(): i32 { return 24; }

// fn_table_base is where a unit's funcref-table region starts. The elem
// segment is emitted at index 0 today, so whole-program emit uses 0 — but
// const_func and the map hash/eq slots now emit indices RELATIVE to it
// (#5331 step 2), the same treatment string literals get from
// str_region_base. fn_value_table is whole-program, so without this a
// module's function-VALUE indices depend on every other module's
// address-taken functions, and the per-module cache would invalidate on any
// change to that set.
pub function fn_table_base(): i32 { return 0; }

// ---- unit needs (#5331) -----------------------------------------------------
// Which runtime helpers a module requires. The link step must emit the UNION of
// its units' needs, but computing that from a combined ir_cache would mean
// re-lowering every module — the exact cost the per-module object cache exists
// to avoid.
//
// So a unit records its needs as METADATA at emit time, when its cache is
// already in hand, and link merges the recorded sets instead. Cheap, and exact:
// the asm side over-approximates with a fixed root set
// (asm_ir.all_runtime_need_roots) precisely because it has no such per-unit
// record, and pays for it in dead runtime code.
//
// Op needs are stored under their op name; the boolean predicates are stored
// under an "@"-prefixed name so the two namespaces cannot collide.
pub function need(needs: string[], name: string): boolean {
    return util.index_of_str(needs, name) >= 0;
}

// needs_of records every predicate emit_ir_module_units gates on. It MUST stay
// exhaustive: a missing entry silently drops a runtime helper, which surfaces as
// an undefined-function link failure rather than a wrong answer. The
// byte-identity invariant is what pins it — whole-program emit routes through
// this same set, so an omission changes the emitted module and fails the suite.
pub function needs_of(cache: irlower.LowerResult[]): string[] {
    var out: string[] = [];
    if (module_emits_op_cached(cache, "arg_at")) { out = out.append("arg_at"); }
    if (module_emits_op_cached(cache, "args")) { out = out.append("args"); }
    if (module_emits_op_cached(cache, "arr_push")) { out = out.append("arr_push"); }
    if (module_emits_op_cached(cache, "arr_push_f64")) { out = out.append("arr_push_f64"); }
    if (module_emits_op_cached(cache, "arr_push_i64")) { out = out.append("arr_push_i64"); }
    if (module_emits_op_cached(cache, "arr_push_owned")) { out = out.append("arr_push_owned"); }
    if (module_emits_op_cached(cache, "env")) { out = out.append("env"); }
    if (module_emits_op_cached(cache, "eprint_str")) { out = out.append("eprint_str"); }
    if (module_emits_op_cached(cache, "fcos")) { out = out.append("fcos"); }
    if (module_emits_op_cached(cache, "fexp")) { out = out.append("fexp"); }
    if (module_emits_op_cached(cache, "flog")) { out = out.append("flog"); }
    if (module_emits_op_cached(cache, "fpow")) { out = out.append("fpow"); }
    if (module_emits_op_cached(cache, "fsin")) { out = out.append("fsin"); }
    if (module_emits_op_cached(cache, "map_iter")) { out = out.append("map_iter"); }
    if (module_emits_op_cached(cache, "monotonic_ns")) { out = out.append("monotonic_ns"); }
    if (module_emits_op_cached(cache, "now_ns")) { out = out.append("now_ns"); }
    if (module_emits_op_cached(cache, "now_unix_ms")) { out = out.append("now_unix_ms"); }
    if (module_emits_op_cached(cache, "poll")) { out = out.append("poll"); }
    if (module_emits_op_cached(cache, "print_i64")) { out = out.append("print_i64"); }
    if (module_emits_op_cached(cache, "print_int")) { out = out.append("print_int"); }
    if (module_emits_op_cached(cache, "print_str")) { out = out.append("print_str"); }
    if (module_emits_op_cached(cache, "putchar")) { out = out.append("putchar"); }
    if (module_emits_op_cached(cache, "random_bytes")) { out = out.append("random_bytes"); }
    if (module_emits_op_cached(cache, "random_i32")) { out = out.append("random_i32"); }
    if (module_emits_op_cached(cache, "read_chunk")) { out = out.append("read_chunk"); }
    if (module_emits_op_cached(cache, "read_dir")) { out = out.append("read_dir"); }
    if (module_emits_op_cached(cache, "read_file")) { out = out.append("read_file"); }
    if (module_emits_op_cached(cache, "read_int")) { out = out.append("read_int"); }
    if (module_emits_op_cached(cache, "read_line")) { out = out.append("read_line"); }
    if (module_emits_op_cached(cache, "read_all_stdin")) { out = out.append("read_all_stdin"); }
    if (module_emits_op_cached(cache, "reader_close")) { out = out.append("reader_close"); }
    if (module_emits_op_cached(cache, "remove_dir_all")) { out = out.append("remove_dir_all"); }
    if (module_emits_op_cached(cache, "remove_file")) { out = out.append("remove_file"); }
    if (module_emits_op_cached(cache, "sleep_ms")) { out = out.append("sleep_ms"); }
    if (module_emits_op_cached(cache, "stat")) { out = out.append("stat"); }
    if (module_emits_op_cached(cache, "str_bytes")) { out = out.append("str_bytes"); }
    if (module_emits_op_cached(cache, "str_from_bytes")) { out = out.append("str_from_bytes"); }
    if (module_emits_op_cached(cache, "str_split")) { out = out.append("str_split"); }
    if (module_emits_op_cached(cache, "tcp_accept")) { out = out.append("tcp_accept"); }
    if (module_emits_op_cached(cache, "tcp_close")) { out = out.append("tcp_close"); }
    if (module_emits_op_cached(cache, "tcp_connect")) { out = out.append("tcp_connect"); }
    if (module_emits_op_cached(cache, "tcp_listen")) { out = out.append("tcp_listen"); }
    if (module_emits_op_cached(cache, "tcp_pollable")) { out = out.append("tcp_pollable"); }
    if (module_emits_op_cached(cache, "tcp_recv")) { out = out.append("tcp_recv"); }
    if (module_emits_op_cached(cache, "tcp_send")) { out = out.append("tcp_send"); }
    if (module_emits_op_cached(cache, "temp_dir")) { out = out.append("temp_dir"); }
    if (module_emits_op_cached(cache, "udp_send")) { out = out.append("udp_send"); }
    if (module_emits_op_cached(cache, "wasm_block")) { out = out.append("wasm_block"); }
    if (module_emits_op_cached(cache, "wasm_poll")) { out = out.append("wasm_poll"); }
    if (module_emits_op_cached(cache, "wasm_pollable_drop")) { out = out.append("wasm_pollable_drop"); }
    if (module_emits_op_cached(cache, "wasm_timer_pollable")) { out = out.append("wasm_timer_pollable"); }
    if (module_emits_op_cached(cache, "write_file")) { out = out.append("write_file"); }
    if (module_emits_op_cached(cache, "open_file")) { out = out.append("open_file"); }
    if (module_emits_op_cached(cache, "writer_write")) { out = out.append("writer_write"); }
    if (module_allocates(cache)) { out = out.append("@allocates"); }
    if (module_calls_optarrarr_free(cache)) { out = out.append("@calls_optarrarr_free"); }
    if (module_calls_strarrarr_free(cache)) { out = out.append("@calls_strarrarr_free"); }
    if (module_uses_arr_slice(cache)) { out = out.append("@uses_arr_slice"); }
    if (module_uses_arr_slice8(cache)) { out = out.append("@uses_arr_slice8"); }
    if (module_calls_arr_str_join(cache)) { out = out.append("@uses_arr_str_join"); }
    if (module_calls_arr_i32_helper(cache)) { out = out.append("@uses_arr_i32_helpers"); }
    if (module_uses_chr(cache)) { out = out.append("@uses_chr"); }
    if (module_uses_divrem(cache)) { out = out.append("@uses_divrem"); }
    if (module_uses_i32_to_string(cache)) { out = out.append("@uses_i32_to_string"); }
    if (module_uses_i64_divrem(cache)) { out = out.append("@uses_i64_divrem"); }
    if (module_uses_maps(cache)) { out = out.append("@uses_maps"); }
    if (module_uses_map_w64(cache)) { out = out.append("@uses_map_w64"); }
    if (module_uses_random(cache)) { out = out.append("@uses_random"); }
    if (module_uses_str_case(cache)) { out = out.append("@uses_str_case"); }
    if (module_uses_str_chars(cache)) { out = out.append("@uses_str_chars"); }
    if (module_uses_str_cmp(cache)) { out = out.append("@uses_str_cmp"); }
    if (module_uses_str_lines(cache)) { out = out.append("@uses_str_lines"); }
    if (module_uses_str_predicate(cache)) { out = out.append("@uses_str_predicate"); }
    if (module_uses_str_repeat(cache)) { out = out.append("@uses_str_repeat"); }
    if (module_uses_str_replace(cache)) { out = out.append("@uses_str_replace"); }
    if (module_uses_str_reverse(cache)) { out = out.append("@uses_str_reverse"); }
    if (module_uses_str_slice(cache)) { out = out.append("@uses_str_slice"); }
    if (module_uses_str_to_i32(cache)) { out = out.append("@uses_str_to_i32"); }
    if (module_uses_str_trim(cache)) { out = out.append("@uses_str_trim"); }
    if (module_uses_strbuf(cache)) { out = out.append("@uses_strbuf"); }
    if (module_uses_strings(cache)) { out = out.append("@uses_strings"); }
    return out;
}

// union_strs unions two string sets, order-preserving. Link folds its units
// together with it: the need sets, and equally the per-type RC helper lists,
// which are the same shape of metadata.
pub function union_strs(a: string[], b: string[]): string[] {
    var out: string[] = a;
    var k: i32 = 0;
    while (k < b.len()) {
        if (util.index_of_str(out, b[k]) < 0) { out = out.append(b[k]); }
        k = k + 1;
    }
    return out;
}


// str_base_global / fn_base_global name a UNIT's base globals (#5331 step 4a).
// Whole-program emit passes ns = "" and gets the historical `$__str_base` /
// `$__fn_base`, so its output is byte-identical; a per-module unit passes its
// namespace and gets `$__str_base$<ns>`, which the link step defines as the
// absolute start of that module's region.
//
// Only the NAME varies. The offsets themselves are already unit-relative: a
// unit emits against its OWN str_values / fn_value_table, so subtracting
// str_region_base() / fn_table_base() yields an offset within the unit's own
// region either way. That is the whole point of steps 1 and 2 — this step just
// stops every unit from claiming the same global.
pub function str_base_global(ns: string): string { return "$__str_base" + ns; }
pub function fn_base_global(ns: string): string { return "$__fn_base" + ns; }

// ---- type ids (#5331 step 3) ------------------------------------------------
// A struct/enum-variant value carries its TYPE ID at offset 0: struct_make and
// dyn_box store it, variant_is / dyn_dispatch / dyn_downcast compare against it.
// The id is positional — struct_type_id is an index into the struct table, and
// prim_type_id is `structs.len() + i` — so it is a WHOLE-PROGRAM value in the
// strongest sense: adding one struct to any module shifts the ids of every
// later struct AND of every primitive dyn-box in the program.
//
// That is fatal for the per-module object cache (#5331): the id must be
// IDENTICAL at the construction site and the test site, which may live in
// different modules, so it cannot be made unit-relative the way string offsets
// (str_region_base) and funcref indices (fn_table_base) were in steps 1 and 2.
// Instead every site names the type and reads its id from a global the link
// step defines — the same indirection, but keyed by NAME rather than by a base
// offset, which is what a globally-agreed namespace needs.
//
// Whole-program emit defines those globals with exactly the positional ids, so
// every value is unchanged; only the reference form differs.
pub function tid_global(name: string): string { return "$__tid$" + name; }

// tid_get emits a type id as an operand: `global.get $__tid$<name>`.
pub function tid_get(name: string): string { return "    global.get " + tid_global(name) + "\n"; }

// tid_named collects the type names referenced by LITERAL string in the emitter
// (rather than via a struct-table walk), so their globals exist even in a module
// that never declares them. struct_type_id falls back to 0 for an unknown name,
// and build_io_error_func / the stat op reference these unconditionally once a
// module does file I/O — without this the emitted WAT would name an undeclared
// global and fail to parse.
pub function tid_named(): string[] {
    return ["FileStat", "NotFound", "PermissionDenied", "AlreadyExists", "Interrupted", "Unsupported", "Other"];
}

// tid_globals_section declares one immutable global per type id: every struct in
// the program, every primitive dyn-box shape (prim_type_id), and the literal
// names above. Emitted once per module by wasm.emit_ir_module.
pub function tid_globals_section(structs: parser.StructDecl[]): string {
    var out: string = "";
    var seen: string[] = [];
    var i: i32 = 0;
    while (i < structs.len()) {
        if (util.index_of_str(seen, structs[i].name) < 0) {
            seen = seen.append(structs[i].name);
            out = out + "  (global " + tid_global(structs[i].name) + " i32 (i32.const " + util.i32_to_string(struct_type_id(structs, structs[i].name)) + "))\n";
        }
        i = i + 1;
    }
    var prims: string[] = irlower.prim_type_ids();
    var p: i32 = 0;
    while (p < prims.len()) {
        if (util.index_of_str(seen, prims[p]) < 0) {
            seen = seen.append(prims[p]);
            out = out + "  (global " + tid_global(prims[p]) + " i32 (i32.const " + util.i32_to_string(irlower.prim_type_id(structs, prims[p])) + "))\n";
        }
        p = p + 1;
    }
    var named: string[] = tid_named();
    var n: i32 = 0;
    while (n < named.len()) {
        if (util.index_of_str(seen, named[n]) < 0) {
            seen = seen.append(named[n]);
            out = out + "  (global " + tid_global(named[n]) + " i32 (i32.const " + util.i32_to_string(struct_type_id(structs, named[n])) + "))\n";
        }
        n = n + 1;
    }
    return out;
}

pub function str_offset(vals: string[], idx: i32): i32 {
    var off: i32 = 24;
    var i: i32 = 0;
    while (i < idx) {
        off = off + 4 + vals[i].len();
        i = i + 1;
    }
    return off;
}

// offset_of_value returns the data-section offset of literal value `v`.
// A miss means the literal escaped the collection pre-pass — a compiler
// bug; returning the scratch base (24) silently pointed the emitted code
// at the iovec scratch area (SH-008's wasm-IR sibling), so fail loudly.
function offset_of_value(vals: string[], v: string): i32 {
    var i: i32 = 0;
    while (i < vals.len()) {
        if (vals[i] == v) { return str_offset(vals, i); }
        i = i + 1;
    }
    eprint("wasm-ir: string literal not interned: " + v);
    exit(1);
    return 0 - 1;
}

// fl_base_for / heap_base_for recompute the freelist + heap bases including the
// literal blocks (heap_extra = 0 in the IR subset — no i64 / print buffers).
// The *_for_strs variants take the literal list directly rather than deriving it
// from a cache (#5331 step 4b). A linked multi-unit module lays every unit's
// literals out contiguously in one flat list, so there is no single cache to
// derive them from — but the arithmetic is identical, since a flat list's own
// str_offset already yields each literal's absolute address.
pub function fl_base_for_strs(sv: string[]): i32 {
    return (str_offset(sv, sv.len()) + 16 + 7) / 8 * 8;
}
pub function heap_base_for_strs(sv: string[]): i32 {
    return fl_base_for_strs(sv) + fl_cells() * 4;
}
pub function fl_base_for(cache: irlower.LowerResult[]): i32 {
    return fl_base_for_strs(str_values(cache));
}
pub function heap_base_for(cache: irlower.LowerResult[]): i32 {
    return fl_base_for(cache) + fl_cells() * 4;
}

// module_uses_strings reports whether any function uses a string op (literal,
// len, concat, eq) — gates the data section + strcat/streq helper emission.
pub function module_uses_strings(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            var kt: i32 = r.ops[i].kind_tag;
            if (kt == 5 || kt == 97 || kt == 98 || kt == 99 || kt == 100) { return true; }  // const_str, str_len, str_concat, str_eq, str_cmp
            if (kt == 101 || kt == 102) { return true; }  // str_index, str_slice
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_str_cmp reports whether any function emits a str_cmp op (string
// ordering < <= > >=). Such modules need the FULL string-helper bundle, which
// includes $__fern_strcmp (the narrow strcat_streq bundle omits it).
pub function module_uses_str_cmp(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 100) { return true; }  // str_cmp
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_str_slice reports whether any function uses `s[start:end]` (the
// str_slice op), gating emission of the $__fern_substr copy helper.
pub function module_uses_maps(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 124 || r.ops[i].kind_tag == 125 || r.ops[i].kind_tag == 126) { return true; }  // map_new, map_set, map_len
            // map_keys / map_values call $__fern_map_keys / $__fern_map_values
            // (the wasm snapshot helpers), so they need the map runtime even in
            // a module that never constructs a map (e.g. a keys() read on a
            // map param). #4353.
            if (r.ops[i].kind_tag == 131 || r.ops[i].kind_tag == 132) { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

pub function module_uses_str_slice(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 102) { return true; }  // str_slice
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// wasm_binop renders the wasm instruction for one IR i32 binary op. 64-bit
// values never appear in the i32 subset, so every op is the i32.* form.
function wasm_binop(tag: i32): string {
    if (tag == 21) { return "i32.add"; }
    if (tag == 22) { return "i32.sub"; }
    if (tag == 23) { return "i32.mul"; }
    // Non-trapping div/rem, matching wasm.fern's AST path: x/0 = 0, x%0 = x,
    // INT_MIN/-1 = INT_MIN (wasm's native i32.div_s / i32.rem_s TRAP on those).
    // The helpers ($__fern_idiv / $__fern_irem) are emitted when the module
    // uses div/rem (module_uses_divrem). As a flat instruction the operands are
    // prior on the stack, so `call` consumes them exactly like the op would.
    if (tag == 24) { return "call $__fern_idiv"; }
    if (tag == 26) { return "call $__fern_irem"; }
    if (tag == 28) { return "i32.and"; }
    if (tag == 29) { return "i32.or"; }
    if (tag == 30) { return "i32.xor"; }
    if (tag == 31) { return "i32.shl"; }
    if (tag == 32) { return "i32.shr_s"; }
    if (tag == 33) { return "i32.shr_u"; }
    // Unsigned u32 div/rem (#3204+): wasm's native i32.div_u/rem_u — irlower
    // remaps div_s/rem_s -> div_u/rem_u when an operand is u32, so a u32
    // numerator >= 2^31 divides as unsigned (signed div gave the wrong answer).
    if (tag == 25) { return "i32.div_u"; }
    if (tag == 27) { return "i32.rem_u"; }
    if (tag == 35) { return "i32.eq"; }
    if (tag == 36) { return "i32.ne"; }
    if (tag == 37) { return "i32.lt_s"; }
    if (tag == 38) { return "i32.le_s"; }
    if (tag == 39) { return "i32.gt_s"; }
    if (tag == 40) { return "i32.ge_s"; }
    // Unsigned u32 compares (#2917): a u32 >= 2^31 is a signed-negative i32, so
    // lt_s/gt_s give wrong answers — irlower remaps the kind via to_unsigned_kind
    // (the same mechanism u64 uses). Mirrors the i64.*_u forms in wasm_binop_w.
    if (tag == 41) { return "i32.lt_u"; }
    if (tag == 42) { return "i32.le_u"; }
    if (tag == 43) { return "i32.gt_u"; }
    if (tag == 44) { return "i32.ge_u"; }
    return ";; ir: unsupported bin " + ir.kind_name(tag) + "\n";
}

// wasm_binop_w selects the i64 instruction variant when the operand width is 64
// (i64 div/rem is bailed in irlower, so no i64 div/rem helper is needed). A
// comparison still pushes an i32 result — only the operands are i64.
function wasm_binop_w(tag: i32, width: i32): string {
    if (width != 64) { return wasm_binop(tag); }
    if (tag == 21) { return "i64.add"; }
    if (tag == 22) { return "i64.sub"; }
    if (tag == 23) { return "i64.mul"; }
    // Non-trapping i64 div/rem (x/0=0, x%0=x, INT64_MIN/-1=INT64_MIN), matching
    // wasm.fern's AST path; emitted by divrem_helpers (module_uses_divrem).
    if (tag == 24) { return "call $__fern_idiv64"; }
    if (tag == 26) { return "call $__fern_irem64"; }
    // Unsigned 64-bit div/rem (u64, #2904): wasm's native i64.div_u/rem_u (they
    // trap only on divide-by-zero — the signed INT64_MIN/-1 overflow that the
    // $__fern_*64 helpers neutralise can't arise unsigned).
    if (tag == 25) { return "i64.div_u"; }
    if (tag == 27) { return "i64.rem_u"; }
    if (tag == 28) { return "i64.and"; }
    if (tag == 29) { return "i64.or"; }
    if (tag == 30) { return "i64.xor"; }
    if (tag == 31) { return "i64.shl"; }
    if (tag == 32) { return "i64.shr_s"; }
    if (tag == 33) { return "i64.shr_u"; }
    if (tag == 35) { return "i64.eq"; }
    if (tag == 36) { return "i64.ne"; }
    if (tag == 37) { return "i64.lt_s"; }
    if (tag == 38) { return "i64.le_s"; }
    if (tag == 39) { return "i64.gt_s"; }
    if (tag == 40) { return "i64.ge_s"; }
    // Unsigned 64-bit compares (u64, #2904) — push an i32 bool like the signed
    // forms, but read the value as unsigned.
    if (tag == 41) { return "i64.lt_u"; }
    if (tag == 42) { return "i64.le_u"; }
    if (tag == 43) { return "i64.gt_u"; }
    if (tag == 44) { return "i64.ge_u"; }
    // f64 arithmetic / comparison (op_fbin carries width 64). wasm's f64
    // compares are natively NaN-correct (return 0 for unordered) and yield i32.
    if (tag == 45) { return "f64.add"; }
    if (tag == 46) { return "f64.sub"; }
    if (tag == 47) { return "f64.mul"; }
    if (tag == 48) { return "f64.div"; }
    // f64 unary math intrinsics (op_funary) — single wasm instructions.
    if (tag == 57) { return "f64.sqrt"; }
    if (tag == 59) { return "f64.floor"; }
    if (tag == 58) { return "f64.ceil"; }
    if (tag == 60) { return "f64.trunc"; }
    if (tag == 56) { return "f64.abs"; }
    if (tag == 55) { return "f64.neg"; }
    if (tag == 49) { return "f64.eq"; }
    if (tag == 50) { return "f64.ne"; }
    if (tag == 51) { return "f64.lt"; }
    if (tag == 52) { return "f64.le"; }
    if (tag == 53) { return "f64.gt"; }
    if (tag == 54) { return "f64.ge"; }
    return ";; ir: unsupported i64 bin " + ir.kind_name(tag) + "\n";
}

// slot_in_list reports membership of slot x in an i32 list (the LowerResult's
// i64_slots / arr_slots are sorted-but-membership is all we need).
function slot_in_list(list: i32[], x: i32): boolean {
    var i: i32 = 0;
    while (i < list.len()) {
        if (list[i] == x) { return true; }
        i = i + 1;
    }
    return false;
}

// wasm_helper_symbol maps an IR runtime-helper name to the wasm.fern symbol the
// IR path calls. The exit-sweep / reassign release (__fern_rc_dec) maps to
// $__fern_arr_dec (the array release that frees at rc==1 via the size-class
// freelist), so the wasm IR path reclaims exactly as wasm.fern's AST path.
function wasm_helper_symbol(name: string): string {
    if (name == "__fern_rc_inc") { return "$__fern_rc_inc"; }
    if (name == "__fern_rc_dec") { return "$__fern_arr_dec"; }
    // string RC reclaim (#2649): unlike the header-less asm string boxes (which
    // need the dedicated __fern_str_free box+buffer release), a wasm heap string
    // is a single rc-headered INLINE block ($__fern_str_box: [rc][bsz][len][bytes])
    // — so a plain $__fern_arr_dec frees it at rc==1 by size class, and a literal
    // (data-section, below heap_base) is a guarded no-op. Double frees are caught
    // by the rc-underflow detector, unlike the asm path.
    if (name == "__fern_str_free") { return "$__fern_arr_dec"; }
    // string[] ELEMENT reclaim (#4355): route to $__fern_arr_dec_ptr, the wasm
    // AST path's pointer-element walk (heap_alloc_helpers, always emitted with
    // the heap runtime): at rc==1 it $__fern_arr_dec's every element — which IS
    // the wasm string free (a wasm heap string is a single inline rc-headered
    // block) — then frees the buffer; a shared array just decs; literals /
    // immortal views are guarded no-ops inside the per-element dec.
    if (name == "__fern_str_arr_free") { return "$__fern_arr_dec_ptr"; }
    // arr-of-arr reclaim (#4355 slice 9): a SCALAR-element inner buffer is
    // fully freed by one per-element dec, so the outer walk is exactly
    // $__fern_arr_dec_ptr; a STRING-element inner (string[][]) needs the
    // two-level $__fern_arr_dec_ptr2 (per-element arr_dec_ptr — the inner's
    // string blocks then its buffer — then the outer).
    if (name == "__fern_arrarr_free") { return "$__fern_arr_dec_ptr"; }
    if (name == "__fern_strarrarr_free") { return "$__fern_arr_dec_ptr2"; }
    if (name == "__fern_optarrarr_free") { return "$__fern_optarrarr_free"; }
    // map reclaim (Perceus map-local slice): route to $__fern_map_release, the
    // wasm AST path's full map free — it null-guards, rc-guards (frees only at
    // rc==1), DEEP-releases string keys + string values (a level the asm
    // __fern_map_free leaks), and frees the keys/vals/used buffers + the box. The
    // 40-byte wasm map box layout differs entirely from asm's raw 16-byte box, so
    // routing to the wasm-native release (rather than a shared IR sequence) is
    // what makes map reclaim correct on wasm. Always present when the module uses
    // maps (map_helpers is gated on module_uses_maps).
    if (name == "__fern_map_free") { return "$__fern_map_release"; }
    // #4353: the string-value deep-release variant is register-only; on wasm
    // $__fern_map_release ALREADY deep-releases string K/V, so it routes to the
    // same helper (the MAPVS credit is a no-op distinction here).
    if (name == "__fern_map_free_vs") { return "$__fern_map_release"; }
    if (name == "__fern_map_free_ks") { return "$__fern_map_release"; }
    if (name == "__fern_map_free_kvs") { return "$__fern_map_release"; }
    if (name == "__fern_rc_underflow_get") { return "$__fern_rc_underflow_count"; }
    // i32.to_string()'s decimal helper — wasm.fern's to_string_helpers emits it
    // as $__fern_i32_to_str (param i32 -> i32 box), gated on module_uses_tostring
    // (an AST walk, so it fires on the IR path too).
    if (name == "__fern_i32_to_string") { return "$__fern_i32_to_str"; }
    return "$" + name;
}

// module_allocates reports whether any function uses an array/alloc op (so the
// heap + RC runtime needs emitting).
pub function module_allocates(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            // Any allocating op needs the heap + RC runtime. ir.op_allocates is
            // the shared list (see ir.fern), identical to asm_ir's heap gate.
            if (ir.op_allocates(r.ops[i].kind_tag)) { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    // String programs need the heap too: $__fern_strcat allocates via
    // $__fern_str_box, and strcat_helpers references it even for a str_eq-only
    // program, so $__fern_str_box (in heap_alloc_helpers) must be present. This
    // also covers the str_len/str_eq/str_cmp/str_index ops that don't allocate
    // themselves but still pull the heap in via $__fern_strcat.
    return module_uses_strings(cache);
}

// field_reclaim_types returns the distinct struct types `T` for which a
// __field_reclaim_<T> helper is called anywhere in the lowered module (#3457).
// wasm emits a per-type REAL reclaim body for each (emit_wasm_field_reclaim_body
// frees the superseded rc-array field buffer on a consume-rebind via
// __fern_snapshot_dec — see wasm.fern:emit_ir_rc_bodies + TestSelfHostFieldReclaimWasm);
// collected by scanning lowered call_direct ops rather than a need-set, matching
// wasm's module_calls-style gating.
pub function field_reclaim_types(cache: irlower.LowerResult[]): string[] {
    var out: string[] = [];
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && asm_ir.is_field_reclaim_name(r.ops[i].str)) {  // call_direct
                var t: string = asm_ir.field_reclaim_type(r.ops[i].str);
                if (util.index_of_str(out, t) < 0) { out = out.append(t); }
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return out;
}

// struct_drop_types returns the distinct struct types `T` for which a
// __struct_drop_<T> helper is called anywhere in the lowered module (#3457 — the
// deep struct-drop, formerly inline). wasm emits a REAL per-type body for each
// (emit_wasm_struct_drop_body — the sibling of the register backends' bodies,
// deep-dropping rc-array + acyclic nested-struct fields); collected by scanning
// lowered call_direct ops (the same gating field_reclaim_types uses) plus the
// transitive nested-struct closure below.
pub function struct_drop_types(cache: irlower.LowerResult[], structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && asm_ir.is_struct_drop_name(r.ops[i].str)) {  // call_direct
                var t: string = asm_ir.struct_drop_type(r.ops[i].str);
                if (util.index_of_str(out, t) < 0) { out = out.append(t); }
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    // Transitive deep-drop closure (Perceus slice 3 deep-drop): emit_wasm_struct_drop_body
    // emits a recursive $__struct_drop_<Inner> call for each nested-struct field that is
    // deep-drop-ok. That recursive call is a backend instruction, not a lowered IR op, so
    // it is invisible to the call_direct scan above — add those inner types here so their
    // bodies are emitted too. nested_field_deep_drop_ok now admits ARBITRARY acyclic depth
    // (not just leaves), so the closure can be multi-level; the index-driven loop re-reads
    // out.len() as it appends, so each newly added inner is itself expanded (the ACYCLIC
    // guarantee bounds this — a type cannot re-appear, so the walk terminates).
    var di: i32 = 0;
    while (di < out.len()) {
        var dt: string = out[di];
        var fc: i32 = irlower.decl_field_count(structs, dt);
        var k: i32 = 0;
        while (k < fc) {
            var ft: string = irlower.decl_field_type_at(structs, dt, k);
            if (irlower.decl_is_struct(structs, ft) && irlower.nested_field_deep_drop_ok(structs, ft)) {
                if (util.index_of_str(out, ft) < 0) { out = out.append(ft); }
            }
            // A struct-ARRAY field `X[]` whose element X is deep-drop-ok: the array-element
            // deep-drop helper ($__struct_arr_elems_drop_X) calls $__struct_drop_X, so X
            // must be a struct_drop type too. Add it here (the index-driven loop then
            // expands X's own reclaimable fields transitively).
            if (irlower.is_struct_array_field_type(structs, ft)) {
                var aelem: str = ft[0 : ft.len() - 2];
                if (irlower.nested_field_deep_drop_ok(structs, aelem)) {
                    if (util.index_of_str(out, aelem) < 0) { out = out.append(aelem); }
                }
            }
            k = k + 1;
        }
        di = di + 1;
    }
    return out;
}

// struct_arr_elems_drop_types returns the distinct struct-array ELEMENT types E for
// which a $__struct_arr_elems_drop_<E> helper must be emitted (#2649): every struct-
// array field `E[]` with a deep-drop-ok element E, reachable from a struct_drop type.
// struct_drop_types already includes each such E as a struct_drop type (so the
// $__struct_drop_<E> the helper calls exists), so this walk over that closure finds
// every needed helper.
pub function struct_arr_elems_drop_types(cache: irlower.LowerResult[], structs: parser.StructDecl[]): string[] {
    var sdt: string[] = struct_drop_types(cache, structs);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < sdt.len()) {
        var fc: i32 = irlower.decl_field_count(structs, sdt[i]);
        var k: i32 = 0;
        while (k < fc) {
            var ft: string = irlower.decl_field_type_at(structs, sdt[i], k);
            if (irlower.is_struct_array_field_type(structs, ft)) {
                var elem: str = ft[0 : ft.len() - 2];
                if (irlower.nested_field_deep_drop_ok(structs, elem) && util.index_of_str(out, elem) < 0) {
                    out = out.append(elem);
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return out;
}

// arr_i32_fern_helper reports whether a call_direct callee is one of the i32
// builtin helpers irlower lowers for every backend — xs.sum() / .product() /
// .index_of() / .contains(), n.pow(k), xs.min() / .max() (#3457). On the
// register backends their bodies are compiled from Fern source
// (asmcore.rt_src_*) by asm_ir.emit_ir_runtime / asm_arm64.emit_runtime; wasm
// has no such mechanism, so arr_i32_helpers below emits hand-written WAT
// equivalents, gated on this scan. They were briefly DEFERRED to the wasm AST
// path instead — which was never a real fallback, since that path does not
// implement them either (it emits `i32.const 0` for xs.sum()).
//
// PARAMETER ORDER on the two-argument helpers is the reverse of the register
// signature. irlower pushes the ARGUMENT first and the receiver second (the
// register callees bind params in reverse push order, #5666), and a wasm `call`
// binds the first-pushed value to param 0 — so the WAT signatures are
// (target, xs) and (exp, base). wasm.arr_str_join_helper's `(param $sep i32)
// (param $xs i32)` is the same convention.
function arr_i32_fern_helper(name: string): boolean {
    return name == "__fern_arr_i32_sum"
        || name == "__fern_arr_i32_product"
        || name == "__fern_i32_pow"
        || name == "__fern_arr_i32_index_of"
        || name == "__fern_arr_i32_min_opt"
        || name == "__fern_arr_i32_max_opt";
}

// arr_i32_helpers is the WAT for that set. Array layout is $__fern_arr_box's —
// [len@0][cap@4][elems@8], 4-byte i32 stride (see wasm.args_func, which builds
// one) — and min/max return the same i32-payload Option box opt_make emits:
// $__fern_str_box(8) with [tag@0][payload@4], tag 0 = Some, 1 = None. Emitted
// as one block gated on @uses_arr_i32_helpers, mirroring the other helper
// bundles; the cost of the unused members is a few hundred bytes of WAT in a
// module that already uses one of them.
pub function arr_i32_helpers(): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_i32_sum (param $a i32) (result i32)\n";
    o = o + "    (local $n i32) (local $i i32) (local $s i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $a)))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $s (i32.add (local.get $s) (i32.load (i32.add (local.get $a) (i32.add (i32.const 8) (i32.mul (local.get $i) (i32.const 4)))))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $s))\n";
    o = o + "  (func $__fern_arr_i32_product (param $a i32) (result i32)\n";
    o = o + "    (local $n i32) (local $i i32) (local $p i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $a)))\n";
    o = o + "    (local.set $p (i32.const 1))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $p (i32.mul (local.get $p) (i32.load (i32.add (local.get $a) (i32.add (i32.const 8) (i32.mul (local.get $i) (i32.const 4)))))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $p))\n";
    // Not found is -1, matching asmcore.rt_src_arr_i32_index_of; `contains` is
    // the `>= 0` test irlower emits around the result.
    o = o + "  (func $__fern_arr_i32_index_of (param $t i32) (param $a i32) (result i32)\n";
    o = o + "    (local $n i32) (local $i i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $a)))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (if (i32.eq (local.get $t) (i32.load (i32.add (local.get $a) (i32.add (i32.const 8) (i32.mul (local.get $i) (i32.const 4))))))\n";
    o = o + "        (then (return (local.get $i))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.const -1))\n";
    // pow: exponent first (see the parameter-order note above). A negative
    // exponent yields 0 and 0^0 yields 1, matching asmcore.rt_src_i32_pow.
    o = o + "  (func $__fern_i32_pow (param $e i32) (param $b i32) (result i32)\n";
    o = o + "    (local $r i32) (local $i i32)\n";
    o = o + "    (local.set $r (i32.const 1))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $e)))\n";
    o = o + "      (local.set $r (i32.mul (local.get $r) (local.get $b)))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (local.get $r))\n";
    o = o + arr_i32_extremum_helper("min", "i32.lt_s");
    o = o + arr_i32_extremum_helper("max", "i32.gt_s");
    return o;
}

// arr_i32_extremum_helper is the shared min/max body: the empty-array guard and
// the Option box live INSIDE the helper, exactly as they do in the Fern source
// the register backends compile (asmcore.rt_src_arr_i32_min_max_opt), so the
// call site is an unconditional call on every backend.
function arr_i32_extremum_helper(which: string, cmp: string): string {
    var o: string = "";
    o = o + "  (func $__fern_arr_i32_" + which + "_opt (param $a i32) (result i32)\n";
    o = o + "    (local $n i32) (local $i i32) (local $m i32) (local $e i32) (local $box i32)\n";
    o = o + "    (local.set $n (i32.load (local.get $a)))\n";
    o = o + "    (local.set $box (call $__fern_str_box (i32.const 8)))\n";
    o = o + "    (if (i32.eqz (local.get $n))\n";
    o = o + "      (then\n";
    o = o + "        (i32.store (local.get $box) (i32.const 1))\n";
    o = o + "        (i32.store (i32.add (local.get $box) (i32.const 4)) (i32.const 0))\n";
    o = o + "        (return (local.get $box))))\n";
    o = o + "    (local.set $m (i32.load (i32.add (local.get $a) (i32.const 8))))\n";
    o = o + "    (local.set $i (i32.const 1))\n";
    o = o + "    (block $d (loop $c\n";
    o = o + "      (br_if $d (i32.ge_s (local.get $i) (local.get $n)))\n";
    o = o + "      (local.set $e (i32.load (i32.add (local.get $a) (i32.add (i32.const 8) (i32.mul (local.get $i) (i32.const 4))))))\n";
    o = o + "      (if (" + cmp + " (local.get $e) (local.get $m)) (then (local.set $m (local.get $e))))\n";
    o = o + "      (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "      (br $c)))\n";
    o = o + "    (i32.store (local.get $box) (i32.const 0))\n";
    o = o + "    (i32.store (i32.add (local.get $box) (i32.const 4)) (local.get $m))\n";
    o = o + "    (local.get $box))\n";
    return o;
}

// module_calls_arr_i32_helper scans the lowered cache for a call to any of those
// helpers — a callee-NAME scan rather than an op-kind one, so it cannot ride
// module_emits_op_cached. Drives the @uses_arr_i32_helpers need.
pub function module_calls_arr_i32_helper(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && arr_i32_fern_helper(r.ops[i].str)) { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_emits_op_cached reports whether any lowered function emits an op of
// `kind` — the shared scanner the random/byte-source helper gates use (issue
// #2747). It reads the pre-lowered cache (lower_all_for) rather than re-lowering
// the module: the emit drivers call it dozens of times per compile, so scanning
// the shared cache once (not re-lowering every function per call) is what makes
// the wasm self-host compile linear (#4652). The op-kind arrives by string;
// resolve it to the integer tag once so the inner scan is an int compare.

pub function module_emits_op_cached(cache: irlower.LowerResult[], kind: string): boolean {
    var ktag: i32 = ir.kind_id(kind);
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == ktag) { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_map_w64 reports whether any function emits an 8-byte-VALUED map op
// the wasm IR path handles via the cell helpers (map_set 125, map_get_or 129,
// map_values 132, map_get 127, or map_iter 133 with widekind 1 = i64/u64 or 2 =
// f64), so emit_ir_module_units emits map_w64_helpers. #5253.
pub function module_uses_map_w64(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            var o: ir.Op = r.ops[i];
            if ((o.kind_tag == 125 || o.kind_tag == 129 || o.kind_tag == 132 || o.kind_tag == 127 || o.kind_tag == 133) && o.i64_imm != 0) { return true; }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_str_predicate reports whether any function emits a scalar string
// search predicate op (starts_with / ends_with / index_of, the latter also
// backing `contains`), so wasm.str_predicate_helpers is emitted for the IR path.
pub function module_uses_str_predicate(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_starts_with")
        || module_emits_op_cached(cache, "str_ends_with")
        || module_emits_op_cached(cache, "str_index_of");
}

// module_uses_str_case reports whether any function emits an ASCII case-transform
// op (to_upper / to_lower), so wasm.str_case_helpers is emitted for the IR path.
pub function module_uses_str_case(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_to_upper") || module_emits_op_cached(cache, "str_to_lower");
}

// module_uses_str_repeat reports whether any function emits the str_repeat op, so
// wasm.str_repeat_helper is emitted for the IR path.
pub function module_uses_str_repeat(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_repeat");
}

// module_uses_str_trim reports whether any function emits the str_trim op, so
// wasm.str_trim_helper is emitted for the IR path. (wasm's AST path has no trim,
// so this is IR-only — no AST counterpart to differential-test against.)
pub function module_uses_str_trim(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_trim");
}

// module_uses_str_reverse reports whether any function emits the str_reverse op,
// so wasm.str_reverse_helper is emitted for the IR path. (IR-only, like trim.)
pub function module_uses_str_reverse(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_reverse");
}

// module_uses_str_replace reports whether any function emits the str_replace op,
// so wasm.str_replace_helper is emitted for the IR path. (IR-only, like trim.)
pub function module_uses_str_replace(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_replace");
}

// module_uses_str_chars reports whether any function emits the str_chars op, so
// wasm.str_chars_helper is emitted for the IR path. (IR-only, like trim.)
pub function module_uses_str_chars(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_chars");
}

// module_uses_str_lines reports whether any function emits the str_lines op, so
// wasm.str_lines_helper (and the str_split/substr it depends on) are emitted.
pub function module_uses_str_lines(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "str_lines");
}

// module_uses_i32_to_string reports whether any function emits the i32.to_string()
// runtime call (a call_direct to __fern_i32_to_string) — so the heap allocator +
// $__fern_i32_to_str helper (wasm.to_string_helpers) are emitted, even for an
// otherwise alloc-free module. (module_emits_op keys on op.kind, not the
// call_direct symbol, so this needs its own scan.)
pub function module_uses_i32_to_string(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_i32_to_string") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_calls_arr_str_join reports whether any function emits the xs.join(sep)
// runtime call (a call_direct to __fern_arr_str_join, #5328) — so needs_of can
// pull in the $__fern_str_join WAT helper (@uses_arr_str_join). (module_emits_op
// keys on op.kind, not the call_direct symbol, so this needs its own scan.)
pub function module_calls_arr_str_join(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_arr_str_join") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_str_to_i32 reports whether any function emits the str_to_i32(s)
// runtime call (a call_direct to __fern_str_to_i32) — so wasm.str_to_i32_helper
// is emitted. Allocation-free, so it has no heap dependency. (module_emits_op
// keys on op.kind, not the call_direct symbol, so this needs its own scan.)
pub function module_uses_str_to_i32(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_str_to_i32") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_strbuf reports whether any function emits a global string-builder
// op (strbuf_reset / strbuf_append / strbuf_take) — so wasm.strbuf_helpers + the
// heap allocator are emitted. strbuf_take boxes its result via $__fern_str_box,
// so the strbuf gate also pulls the heap in (folds into the heap gate alongside
// module_allocates / module_uses_i32_to_string / module_uses_chr).
pub function module_uses_strbuf(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "strbuf_reset") || module_emits_op_cached(cache, "strbuf_append")
        || module_emits_op_cached(cache, "strbuf_take");
}

// module_uses_chr reports whether any function emits the chr(n) runtime call (a
// call_direct to __fern_chr) — so wasm.chr_helper + the heap allocator are
// emitted. chr allocates its 1-char box, so the chr gate also pulls the heap in.
pub function module_uses_chr(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_chr") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_calls_strarrarr_free reports whether any function lowers a
// __fern_strarrarr_free call (string[][] whole-structure reclaim, #4355
// slice 9) — so wasm.arr_dec_ptr2_func is emitted. Kept OUT of
// heap_alloc_helpers: the $__fern_arr_dec_ptr2 body contains a
// `call $__fern_arr_dec_ptr`, which would trip the negative WAT-grep
// contracts (strarr-elem-alias-excluded) in every allocating module.
// module_calls_optarrarr_free: any function lowers a __fern_optarrarr_free
// call (#4365 Option[<arr>][] reclaim) — gates the $__fern_optarrarr_free WAT
// body emission, same pattern as module_calls_strarrarr_free below.
pub function module_calls_optarrarr_free(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_optarrarr_free") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

pub function module_calls_strarrarr_free(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 149 && r.ops[i].str == "__fern_strarrarr_free") { return true; }  // call_direct
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_random reports whether the module calls random_bytes or random_i32
// (so the wasi random_get import is emitted).
pub function module_uses_random(cache: irlower.LowerResult[]): boolean {
    return module_emits_op_cached(cache, "random_bytes") || module_emits_op_cached(cache, "random_i32");
}

// module_uses_divrem reports whether any function uses i32 div/rem (so the
// non-trapping $__fern_idiv / $__fern_irem helpers need emitting).
pub function module_uses_divrem(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 24 || r.ops[i].kind_tag == 26) { return true; }  // div_s, rem_s
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// module_uses_i64_divrem reports whether any div/rem op runs at 64-bit width, so
// the $__fern_idiv64 / $__fern_irem64 helpers (divrem64_helpers) need emitting.
// module_uses_arr_slice reports whether any function emits a 4-byte-element
// arr_slice op (width 32), so the $__fern_arr_slice helper needs emitting.
pub function module_uses_arr_slice(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 96 && r.ops[i].width != 64) { return true; }  // arr_slice
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}
// module_uses_arr_slice8 reports whether any function emits an 8-byte-element
// arr_slice op (width 64, f64[]), so the $__fern_arr_slice8 helper needs
// emitting. Distinct from module_uses_arr_slice so a program slicing only one
// element width pulls in only the helper it calls.
pub function module_uses_arr_slice8(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 96 && r.ops[i].width == 64) { return true; }  // arr_slice
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

pub function module_uses_i64_divrem(cache: irlower.LowerResult[]): boolean {
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if ((r.ops[i].kind_tag == 24 || r.ops[i].kind_tag == 26) && r.ops[i].width == 64) { return true; }  // div_s, rem_s
            i = i + 1;
        }
        fi = fi + 1;
    }
    return false;
}

// wasm_eligible: the whole module is in the IR's i32 + arrays subset (the same
// backend-independent gate the asm backends use — rejects non-lowerable
// functions and builtin calls). wasm covers everything that gate admits.
// wasm_eligible is the WASM eligibility gate — eligible_core, the same gate the
// register backends now use (all_eligible). Plain function values (const_func /
// call_indirect) are admitted on every backend; wasm lowers them through a
// funcref table (fn_support_section), the register backends through the
// function's code address.
pub function wasm_eligible(mod: parser.Module): boolean {
    // read_line / read_int / args / read_file / write_file all lower on the wasm
    // IR path now: wasm_ir emits `call $__fern_<op>` and wasm_ir_run pulls in the
    // matching wasi imports + helpers when the module uses them. read_line /
    // read_int read stdin (fd 0) via fd_read — read_line boxes the line (newline
    // stripped), read_int parses a leading integer; args() reads argv (wasmtime
    // supplies it, argv[0] = program name); read_file / write_file open paths
    // under preopen fd 3 (run with `--dir`), returning Result[string, IoError] /
    // Option[IoError]. read_chunk / reader_close (the streaming reader API) now
    // lower on the wasm IR path too: wasm_ir emits `call $__fern_reader_read_chunk`
    // / `call $__fern_reader_close`, and wasm_ir_run pulls in the preview1 fd_read
    // / fd_close imports + the reader helpers when the module uses them. A Reader is
    // just its fd (stdin() = fd 0), so read_chunk reads stdin the same way read_line
    // does; this backs the std/io read_all_stdin loop on wasm.
    // The clock builtins (monotonic_ns / now_unix_ms / now_ns) DO lower on the
    // wasm IR path now: wasm_ir emits `call $__fern_<clock>` for each op and
    // wasm_ir_run pulls in the preview1 wasi clock_time_get import + the
    // clock_funcs helpers (the same runtime the AST path uses) when the module
    // calls any clock builtin (#3893 follow-up). sleep_ms still has no wasm
    // runtime (a WASI poll-based sleep is the deferred #2843 item), so a sleep
    // module stays off the wasm IR path.
    // `m.without(k)` (map_delete) now lowers via the IR: wasm's
    // $__fern_map_delete returns a [map, existed] tuple box (the wasm tuple ABI,
    // element i at offset i*4) matching the register backends, so the IR
    // tuple-destructure reads it correctly (#2933 — previously it returned just
    // the box, a different ABI, so a delete module was pinned to the AST path).
    // The global string-builder ops (strbuf_reset / strbuf_append / strbuf_take)
    // now lower on the wasm IR path too: wasm_ir emits `call $__fern_strbuf_<op>`
    // and the runtime (wasm.strbuf_helpers — a growable bump-heap buffer) is pulled
    // in by module_uses_strbuf, which also folds into the heap gate. The wasm AST
    // backend never had strbuf, so this is the only wasm strbuf path.
    // The libm transcendentals (sin / cos / exp / log / pow) lower through the IR
    // on every backend: x86 (x87 FPU), arm64 (polynomial-approx runtime helpers),
    // and wasm via the polynomial-approx WAT helpers (wasm.exp_func / log_func /
    // pow_func / …) that wasm_ir_run pulls in when a module calls one — see the
    // fexp/flog/fsin/fcos/fpow arms below (kind_tag 62+), which emit
    // `call $__fern_<op>_f64`. They are NOT in the deferral list.
    if (!asm_ir.eligible_core(mod)) { return false; }
    return wasm_ir_deferrals_ok(lower_all_for(mod));
}

// wasm_ir_deferrals_ok is the non-eligible_core half of wasm_eligible evaluated
// over a pre-lowered cache: the set of ops that DON'T yet lower on the wasm IR
// backend (poll / timer_fd / the tcp_* socket set / wasm_poll — the
// component-model / socket runtime the bare core-wasm+preview1 backend doesn't
// wire). Split out of wasm_eligible so the emit dispatch can build the cache
// ONCE — after the cheap eligible_core AST gate passes — and reuse it for both
// this deferral gate AND emit, instead of re-lowering the whole module ~10× via
// the mod-taking module_emits_op. Byte-identical to the old inline chain (#4652).
// module_erased_wide: any lowered function passes a 64-bit / f64 value
// through a bare-typevar (erased-generic) param (LowerResult.erased_wide).
// The wasm backend types erased param locals i32, so such a module must stay
// on the AST path — previously an f64-through-erased call emitted
// type-invalid WAT the wasmtime loader rejects, and (post the register-side
// widening) an i64 would truncate.
function module_erased_wide(cache: irlower.LowerResult[]): boolean {
    var i: i32 = 0;
    while (i < cache.len()) {
        if (cache[i].erased_wide) { return true; }
        i = i + 1;
    }
    return false;
}

// all_lowered_ok reports whether EVERY function in the module lowered
// successfully (LowerResult.ok). The rest of the deferral gate is a hand-
// maintained BLOCKLIST — one `!module_emits_op_cached(cache, "<op>")` per op the
// wasm backend can't lower — that must be kept exhaustive by hand, or a function
// that bails for an un-listed reason still passes the gate and reaches emit,
// where its empty/truncated `ops` produce a body the wasm loader rejects
// ("values remaining on stack"). This derives the backstop from the lowering
// ITSELF: any bail (LowerResult.ok == false) routes the whole module to the AST
// path cleanly, so the blocklist no longer has to be perfect (fragility #6 —
// eligibility drift from what actually lowers). The register IR path already
// gates on `r.ok` this way (asm_ir.func_eligible); this brings wasm to parity.
// Byte-identity-safe: an all-ok module (every current IR-eligible one, since it
// emits valid wasm today) is unaffected; the gate only ever moves a
// silently-bailing module off the IR path.
function all_lowered_ok(cache: irlower.LowerResult[]): boolean {
    var i: i32 = 0;
    while (i < cache.len()) {
        if (!cache[i].ok) { return false; }
        i = i + 1;
    }
    return true;
}

// wasm_unsupported_builtin returns the name of the first builtin the module
// calls that has NO wasm meaning at all, or "" when there is none. These are
// error endpoints, not deferrals: routing them to the AST emitter produces a
// module that references a runtime symbol nothing defines, so the failure lands
// as an opaque `unknown func: failed to find name $X` from the wasm loader
// instead of a diagnostic naming the unsupported feature.
//
//   - subprocess — child-process spawning, unsupportable on wasm/WASI (#4320).
//   - timer_fd — the native fd-based CLOCK_MONOTONIC timerfd. wasm has no file
//     descriptors to poll, and its analog already exists and lowers:
//     wasm_timer_pollable, which returns a wasi:io/poll pollable instead of an
//     fd (#4317). Before this, a timer_fd module fell to the AST path and
//     emitted `call $timer_fd` against nothing.
//
// Detection is syntactic: the bare callee ident as collected by astwalk (a
// call's callee IS collected; a `.name` field access is not), the same pre-emit
// gate shape check_call_arity uses.
pub function wasm_unsupported_builtin(mod: parser.Module): string {
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var ids: string[] = [];
        var si: i32 = 0;
        while (si < mod.funcs[fi].body.len()) {
            ids = astwalk.collect_idents_stmt(mod.funcs[fi].body[si], ids);
            si = si + 1;
        }
        if (util.index_of_str(ids, "subprocess") >= 0) { return "subprocess"; }
        if (util.index_of_str(ids, "timer_fd") >= 0) { return "timer_fd"; }
        // proc_fork / proc_waitpid (#5686) — the crash-only supervision pair.
        // A wasm component is a single instance with no process model: there is
        // nothing to fork and no child to reap. Same endpoint treatment as
        // subprocess rather than a deferral, so the diagnostic names the
        // feature instead of the loader reporting `unknown func: $proc_fork`.
        if (util.index_of_str(ids, "proc_fork") >= 0) { return "proc_fork"; }
        if (util.index_of_str(ids, "proc_waitpid") >= 0) { return "proc_waitpid"; }
        // FFI __c_call<n>(...) (#4375) is written directly as a builtin call, so
        // its callee ident is collected here. Wasm has no C ABI — there is no
        // __c_call runtime on any wasm path — so reject it with a clean diagnostic
        // (before this it deferred to the AST emitter, which also has no __c_call
        // and emitted a call to an undefined $__c_call<n>).
        var ci: i32 = 0;
        while (ci < ids.len()) {
            if (asm_ir.is_c_call(ids[ci])) { return ids[ci]; }
            ci = ci + 1;
        }
        fi = fi + 1;
    }
    return "";
}

// wasm_unsupported_message is the diagnostic both wasm drivers print for an
// unsupported builtin, so the wording cannot drift between them. timer_fd gets
// a pointer at its wasm analog; there is no analog to suggest for subprocess.
pub function wasm_unsupported_message(name: string): string {
    if (name == "timer_fd") {
        return "error: timer_fd is not supported on the wasm target (wasm has no pollable file descriptors); use wasm_timer_pollable, which returns a wasi:io/poll pollable\n";
    }
    if (asm_ir.is_c_call(name)) {
        return "error: " + name + " (C FFI) is not supported on the wasm target (wasm has no C ABI)\n";
    }
    if (name == "proc_fork" || name == "proc_waitpid") {
        return "error: " + name + " is not supported on the wasm target (a component has no process model to fork or reap)\n";
    }
    return "error: " + name + " is not supported on the wasm target\n";
}

pub function wasm_ir_deferrals_ok(cache: irlower.LowerResult[]): boolean {
    return true
        // Total backstop: any function that failed to lower routes the module to
        // the AST path, so the op-blocklist below need not be exhaustive (#6).
        && all_lowered_ok(cache)
        && !module_erased_wide(cache)
        // The i32 builtin helpers (sum / product / pow / index_of / contains /
        // min / max) are NO LONGER deferred: wasm_ir.arr_i32_helpers emits WAT
        // bodies for them, gated on @uses_arr_i32_helpers. Deferring them was
        // never a real fallback anyway — the AST path does not implement them
        // either (xs.sum() emits `i32.const 0` there).
        // xs.join(sep) NOW lowers on the wasm IR path (#5328): the register
        // backends' __fern_arr_str_join runtime call is served by a matching
        // $__fern_arr_str_join shim over the $__fern_str_join WAT worker
        // (wasm.arr_str_join_helper, gated on @uses_arr_str_join) — no exclusion here.
        // 8-byte-VALUE maps (i64/u64 AND f64) NOW lower fully on the wasm IR path
        // (#5253): set / get_or / values / get / iter box the 8-byte value into an
        // rc cell whose pointer rides the i32 value column (map_w64_helpers, the
        // *_w64 helpers). The cell stores raw 8 bytes, so f64 rides the same helpers
        // as i64/u64 with an f64<->i64 reinterpret at the scalar sites. No exclusion
        // here — the former module_has_wide_map_val_cached gate is retired.
        // poll has no wasm IR runtime: real readiness on wasm needs the
        // component-model wasi:io/poll multiplexer (list<pollable>), which the
        // self-host wasm backend doesn't wire (it is bare core-wasm + WASI
        // preview1). x86-64 (poll(2)) and arm64 (ppoll(2)) lower it via the IR;
        // a poll module stays on the wasm AST path. (sleep_ms, by contrast, needs
        // only a single-clock poll_oneoff and DOES lower on the wasm IR path — see
        // $__fern_sleep_ms; it is no longer deferred.)
        // timer_fd is NOT deferred to the AST path — it is an error endpoint on
        // wasm, rejected before emit by wasm_unsupported_builtin (#4317). It is
        // the native fd-based timerfd, and wasm has no pollable file descriptors;
        // its analog wasm_timer_pollable already lowers. Deferring it only moved
        // the failure to the wasm loader, which reported the unhelpful
        // `unknown func: failed to find name $timer_fd`. No exclusion here.
        // wasm_timer_pollable / wasm_pollable_drop / wasm_block DO lower on the
        // wasm IR path now (#3457 / #4317): wasm_ir emits direct preview2 calls
        // (wasi:clocks/monotonic-clock.subscribe-duration, wasi:io/poll
        // [method]pollable.block, [resource-drop]pollable) and wasm_ir_run adds the
        // matching component imports; the module composes to a component via
        // `wasm-tools component new`. wasm_block makes a wasm_timer_pollable timer
        // observably block (subscribe → block → the duration elapses).
        // wasm_poll (the wasi:io/poll.poll list<pollable> -> list<u32> readiness
        // multiplexer) NOW lowers on the wasm IR path (#4316) — no exclusion
        // here. It is the first LIST-typed component import the self-host
        // emits, which is why it needed more than an import line: a list-typed
        // import cannot be inferred from the core signature alone, so the
        // module carries component-type metadata (the `wasm-tools component
        // embed` step in the compose pipeline) and cmd/fern/wit/deps/io/
        // poll.wit had to declare the function — it was a subset carrying only
        // pollable.block. See wasi_poll_import / wasm_poll_func.
        //
        // NOTE when reading the native backend for guidance on the REST of this
        // surface (the tcp set below): it does NOT take this route. Native never
        // invokes wasm-tools, composing in Go instead (component.ClassifyCore ->
        // component.Compose) and hand-writing the canonical-ABI adapters, which
        // is why native resolves these imports against the same subset WIT that
        // blocks the self-host — and why its array layout differs too (see
        // wasm_poll_func).
        // tcp_* client/server primitives NOW lower on the wasm IR path (#4318,
        // closed): wasm_ir emits the wasi:sockets component calls and the vendored
        // WIT subset (cmd/fern/wit/deps/sockets/*.wit — the `network` resource +
        // the `ip-socket-address` variant used by start-bind) carries the world
        // payload `component new` resolves. No tcp exclusion here — same route as
        // wasm_poll (#4316) proved.
        // open_file (open_reader/open_writer/open_appender) + writer_write NOW lower
        // on the wasm IR path (#4372): $__fern_open_file does path_open under preopen
        // fd 3 (openat-flags -> WASI oflags/rights/fdflags) and $__fern_writer_write
        // fd_writes the bytes — reusing file_imports' path_open + the fd_write import.
        // subprocess (#4320) and FFI __c_call<n> (#4375) are NOT deferred — both
        // are unsupportable on wasm (no process spawn, no C ABI), so the driver
        // rejects them with a clean diagnostic before emit (wasm_unsupported_builtin,
        // wasm_unsupported_message). No exclusion here.
        ;
}

// should_use_ir_core is the CHEAP gate the emit dispatch (wasm.emit_module)
// consults to route a module through the IR: the use_ir default is on AND the
// module passes the AST-only eligible_core gate, WITHOUT the module_emits_op
// deferral checks (those need the lowered cache). The dispatch calls this first;
// only if it passes does it build the LowerResult cache (lower_all_for) ONCE and
// finish the gate with wasm_ir_deferrals_ok(cache) — so an IR-eligible module is
// lowered a single time for gate+emit instead of the old ~10× (deferral scan) +
// ~20× (emit collect passes). eligible_core is a pure AST walk, so bailing here
// keeps the ineligible-module bootstrap path from ever lowering (#4652). Uses
// eligible_core (not all_eligible) so function-value modules lower on wasm.
pub function should_use_ir_core(mod: parser.Module): boolean {
    return asmcore.new_state().use_ir && asm_ir.eligible_core(mod);
}

// Preview-2 component-model imports for the wasm reactor's timer-pollable ops
// (#3457 / #4317). Emitted into the module header (caller-side, wasm_ir_run) when
// the module uses the op, exactly like the preview1 import helpers — but these
// name a *component* interface, so the emitted core module must be composed with
// `wasm-tools component new` before it runs (wasmtime can't resolve a preview2
// interface for a bare core module). wasm_timer_pollable subscribes a
// monotonic-clock timer; wasm_pollable_drop drops the resulting pollable
// resource. Both are the SAME wasi:io/poll pollable a socket subscribe yields.
pub function wasi_subscribe_duration_import(): string {
    return "  (import \"wasi:clocks/monotonic-clock@0.2.0\" \"subscribe-duration\" (func $__fern_wasi_subscribe_duration (param i64) (result i32)))\n";
}
pub function wasi_pollable_drop_import(): string {
    return "  (import \"wasi:io/poll@0.2.0\" \"[resource-drop]pollable\" (func $__fern_wasi_pollable_drop (param i32)))\n";
}
// wasm_block: [method]pollable.block synchronously waits (param i32 self, no
// result) until the pollable is ready. The primitive that makes
// wasm_timer_pollable observably block. Same wasi:io/poll interface as the drop.
pub function wasi_pollable_block_import(): string {
    return "  (import \"wasi:io/poll@0.2.0\" \"[method]pollable.block\" (func $__fern_wasi_pollable_block (param i32)))\n";
}
// wasm_poll: the wasi:io/poll.poll readiness multiplexer (#4316). Unlike the
// scalar pollable ops above, this one is LIST-typed —
// `poll: func(in: list<borrow<pollable>>) -> list<u32>` — so at the canonical
// ABI it takes (data-ptr, len) and writes its returned list into an 8-byte
// return area: data ptr @ +0, count @ +4. A list-typed import cannot be
// inferred from the core signature alone, so the module must carry
// component-type metadata (the `wasm-tools component embed` step) and the
// vendored cmd/fern/wit/deps/io/poll.wit must declare the function.
pub function wasi_poll_import(): string {
    return "  (import \"wasi:io/poll@0.2.0\" \"poll\" (func $__fern_wasi_poll (param i32 i32 i32)))\n";
}
// $__fern_wasm_poll(pollables: i32[]) -> i32: behaviourally the sibling of
// native's buildWasmPollBody (internal/codegen/wasmbin/wasi.go) — call
// wasi:io/poll.poll over the pollable handles and return the FIRST ready index,
// or -1 when the ready list came back empty.
//
// The ARRAY LAYOUT differs from native's, so do not copy that body verbatim.
// A self-host wasm array pointer `p` (from $__fern_arr_box, which returns
// base+8 of a 16-byte rc-headered block) has its element COUNT at p+0 and its
// elements starting at p+8 — not native's "count at p-4, elements at p+0".
// Reading it native-style makes poll see a garbage length and return
// immediately without blocking.
//
// Elements are contiguous i32 from p+8, which is exactly the canonical
// list<borrow<pollable>> data pointer, so no copy is needed. The returned
// list<u32> is written into an 8-byte return area: data ptr @ +0, count @ +4.
// --- TCP outbound client (#4318 slice 1) -------------------------------------
//
// A Fern tcp "fd" is a POINTER to a 12-byte heap struct, the same shape native
// uses (internal/codegen/wasmbin/wasi_tcp.go) so the two stay swappable:
//
//     [0..3]  tcp-socket handle
//     [4..7]  input-stream handle   (0 for listening sockets)
//     [8..11] output-stream handle  (0 for listening sockets)
//
// wasm has no file descriptors, so the i32 the language hands back is this
// pointer; a negative value is -errno.
// The wasi:sockets network handle import. Split out of the tcp bundle because
// udp_send needs it too, and a duplicate import is an invalid module — so it
// gets one gate covering every socket op rather than living inside one of them.
pub function wasi_instance_network_import(): string {
    return "  (import \"wasi:sockets/instance-network@0.2.0\" \"instance-network\" (func $__fern_wasi_instance_network (result i32)))\n";
}

pub function wasi_sockets_imports(): string {
    var o: string = "";
    o = o + "  (import \"wasi:sockets/tcp-create-socket@0.2.0\" \"create-tcp-socket\" (func $__fern_wasi_create_tcp_socket (param i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/tcp@0.2.0\" \"[method]tcp-socket.start-connect\" (func $__fern_wasi_tcp_start_connect (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/tcp@0.2.0\" \"[method]tcp-socket.finish-connect\" (func $__fern_wasi_tcp_finish_connect (param i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/tcp@0.2.0\" \"[method]tcp-socket.subscribe\" (func $__fern_wasi_tcp_subscribe (param i32) (result i32)))\n";
    o = o + "  (import \"wasi:sockets/tcp@0.2.0\" \"[resource-drop]tcp-socket\" (func $__fern_wasi_tcp_socket_drop (param i32)))\n";
    o = o + "  (import \"wasi:io/streams@0.2.0\" \"[resource-drop]input-stream\" (func $__fern_wasi_input_stream_drop (param i32)))\n";
    o = o + "  (import \"wasi:io/streams@0.2.0\" \"[resource-drop]output-stream\" (func $__fern_wasi_output_stream_drop (param i32)))\n";
    return o;
}

// $__fern_network_handle(): the wasi:sockets/instance-network handle, fetched
// once and cached in a global. A resource handle is an opaque int where 0 is a
// legitimate value, so the cache needs its own init flag rather than a
// 0-sentinel on the handle itself (same reasoning as native's
// networkHandleInitAddr).
pub function network_handle_func(): string {
    var o: string = "";
    o = o + "  (global $__fern_net (mut i32) (i32.const 0))\n";
    o = o + "  (global $__fern_net_init (mut i32) (i32.const 0))\n";
    o = o + "  (func $__fern_network_handle (result i32)\n";
    o = o + "    (if (i32.eqz (global.get $__fern_net_init)) (then\n";
    o = o + "      (global.set $__fern_net (call $__fern_wasi_instance_network))\n";
    o = o + "      (global.set $__fern_net_init (i32.const 1))))\n";
    o = o + "    (global.get $__fern_net))\n";
    return o;
}

// $__fern_tcp_connect(host_be, port) -> i32. The outbound client:
// create-tcp-socket -> start-connect -> subscribe -> block (wait for the
// connection to establish) -> drop the pollable -> finish-connect, yielding the
// 12-byte struct above, or -errno.
//
// host_be packs the IPv4 address a | b<<8 | c<<16 | d<<24 (the std/fetch `ipv4`
// convention), unpacked here into the four octets of the ip-socket-address
// ipv4 arm. start-connect's canonical flattening is 15 i32: self, network,
// variant disc (0 = ipv4), then 11 payload slots of which ipv4 uses 5 (port +
// 4 octets) and pads the rest for the larger ipv6 arm, then the retptr.
//
// Every step's result<> puts its discriminant byte at retptr+0 and, on the Err
// arm, the error-code at retptr+4 — hence the repeated "if disc then return
// -errno" guard.
pub function tcp_connect_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_tcp_connect (param $host i32) (param $port i32) (result i32)\n";
    o = o + "    (local $sock i32) (local $ret i32) (local $st i32) (local $p i32)\n";
    o = o + "    (local.set $ret (call $__fern_alloc (i32.const 16)))\n";
    o = o + "    (call $__fern_wasi_create_tcp_socket (i32.const 0) (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (local.set $sock (i32.load offset=4 (local.get $ret)))\n";
    o = o + "    (call $__fern_wasi_tcp_start_connect (local.get $sock) (call $__fern_network_handle)\n";
    o = o + "      (i32.const 0) (local.get $port)\n";
    o = o + "      (i32.and (local.get $host) (i32.const 255))\n";
    o = o + "      (i32.and (i32.shr_u (local.get $host) (i32.const 8)) (i32.const 255))\n";
    o = o + "      (i32.and (i32.shr_u (local.get $host) (i32.const 16)) (i32.const 255))\n";
    o = o + "      (i32.and (i32.shr_u (local.get $host) (i32.const 24)) (i32.const 255))\n";
    o = o + "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n";
    o = o + "      (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (local.set $p (call $__fern_wasi_tcp_subscribe (local.get $sock)))\n";
    o = o + "    (call $__fern_wasi_pollable_block (local.get $p))\n";
    o = o + "    (call $__fern_wasi_pollable_drop (local.get $p))\n";
    o = o + "    (call $__fern_wasi_tcp_finish_connect (local.get $sock) (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (local.set $st (call $__fern_alloc (i32.const 12)))\n";
    o = o + "    (i32.store (local.get $st) (local.get $sock))\n";
    o = o + "    (i32.store offset=4 (local.get $st) (i32.load offset=4 (local.get $ret)))\n";
    o = o + "    (i32.store offset=8 (local.get $st) (i32.load offset=8 (local.get $ret)))\n";
    o = o + "    (local.get $st))\n";
    return o;
}

// Server-half imports (#4318 slice 3): bind + listen. accept / subscribe /
// the drops already come in via wasi_sockets_imports.
pub function wasi_sockets_server_imports(): string {
    var o: string = "";
    o = o + "  (import \"wasi:sockets/tcp@0.2.0\" \"[method]tcp-socket.start-bind\" (func $__fern_wasi_tcp_start_bind (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/tcp@0.2.0\" \"[method]tcp-socket.finish-bind\" (func $__fern_wasi_tcp_finish_bind (param i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/tcp@0.2.0\" \"[method]tcp-socket.start-listen\" (func $__fern_wasi_tcp_start_listen (param i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/tcp@0.2.0\" \"[method]tcp-socket.finish-listen\" (func $__fern_wasi_tcp_finish_listen (param i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/tcp@0.2.0\" \"[method]tcp-socket.accept\" (func $__fern_wasi_tcp_accept (param i32 i32)))\n";
    return o;
}

// $__fern_tcp_listen(port) -> 12-byte LISTENER struct pointer, or -errno.
//
// create-tcp-socket -> start-bind + finish-bind(0.0.0.0:port) -> start-listen +
// finish-listen. start-bind takes the same 15-i32 flattening of
// ip-socket-address that start-connect does (disc + 11 payload slots, of which
// ipv4 uses port + 4 octets), here bound to 0.0.0.0.
//
// The struct's STREAM SLOTS STAY ZERO: a listener has no input/output stream
// until it accepts. tcp_close already guards each drop on a non-zero handle for
// exactly this case — passing 0 to a resource-drop import traps host-side.
pub function tcp_listen_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_tcp_listen (param $port i32) (result i32)\n";
    o = o + "    (local $sock i32) (local $ret i32) (local $st i32)\n";
    o = o + "    (local.set $ret (call $__fern_alloc (i32.const 16)))\n";
    o = o + "    (call $__fern_wasi_create_tcp_socket (i32.const 0) (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (local.set $sock (i32.load offset=4 (local.get $ret)))\n";
    o = o + "    (call $__fern_wasi_tcp_start_bind (local.get $sock) (call $__fern_network_handle)\n";
    o = o + "      (i32.const 0) (local.get $port)\n";
    o = o + "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n";
    o = o + "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n";
    o = o + "      (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (call $__fern_wasi_tcp_finish_bind (local.get $sock) (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (call $__fern_wasi_tcp_start_listen (local.get $sock) (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (call $__fern_wasi_tcp_finish_listen (local.get $sock) (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (local.set $st (call $__fern_alloc (i32.const 12)))\n";
    o = o + "    (i32.store (local.get $st) (local.get $sock))\n";
    o = o + "    (i32.store offset=4 (local.get $st) (i32.const 0))\n";
    o = o + "    (i32.store offset=8 (local.get $st) (i32.const 0))\n";
    o = o + "    (local.get $st))\n";
    return o;
}

// $__fern_tcp_accept(listener) -> a fresh 12-byte CONNECTION struct, or -errno.
//
// subscribe + block FIRST: accept is non-blocking on wasi:sockets, so calling it
// straight away just yields would-block.
//
// accept's result is the widest in this file —
// `result<tuple<tcp-socket, input-stream, output-stream>, error-code>` — laid
// out as disc@+0, 3 pad, then the three handles at +4 / +8 / +12. Hence the
// 16-byte retptr, where connect's tuple of two needed only the low 12.
pub function tcp_accept_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_tcp_accept (param $l i32) (result i32)\n";
    o = o + "    (local $sock i32) (local $p i32) (local $ret i32) (local $st i32)\n";
    o = o + "    (local.set $sock (i32.load (local.get $l)))\n";
    o = o + "    (local.set $p (call $__fern_wasi_tcp_subscribe (local.get $sock)))\n";
    o = o + "    (call $__fern_wasi_pollable_block (local.get $p))\n";
    o = o + "    (call $__fern_wasi_pollable_drop (local.get $p))\n";
    o = o + "    (local.set $ret (call $__fern_alloc (i32.const 16)))\n";
    o = o + "    (call $__fern_wasi_tcp_accept (local.get $sock) (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (local.set $st (call $__fern_alloc (i32.const 12)))\n";
    o = o + "    (i32.store (local.get $st) (i32.load offset=4 (local.get $ret)))\n";
    o = o + "    (i32.store offset=4 (local.get $st) (i32.load offset=8 (local.get $ret)))\n";
    o = o + "    (i32.store offset=8 (local.get $st) (i32.load offset=12 (local.get $ret)))\n";
    o = o + "    (local.get $st))\n";
    return o;
}

// $__fern_tcp_pollable(conn) -> a wasi:io/poll pollable for the connection's
// tcp-socket (mem[conn+0]). This is the handle std/async feeds to wasm_poll for
// overlapped fan-out, so it composes directly with the multiplexer from #4316.
pub function tcp_pollable_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_tcp_pollable (param $c i32) (result i32)\n";
    o = o + "    (call $__fern_wasi_tcp_subscribe (i32.load (local.get $c))))\n";
    return o;
}

// --- UDP send (#4375 item 3) --------------------------------------------------
//
// udp_send(host, port, data) is one-shot fire-and-forget: bind an ephemeral
// local port, connect a stream to host:port, wait for a send permit, send one
// datagram, tear everything down. Send-only / IPv4-literal, matching native.
pub function wasi_udp_imports(): string {
    var o: string = "";
    o = o + "  (import \"wasi:sockets/udp-create-socket@0.2.0\" \"create-udp-socket\" (func $__fern_wasi_create_udp_socket (param i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/udp@0.2.0\" \"[method]udp-socket.start-bind\" (func $__fern_wasi_udp_start_bind (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/udp@0.2.0\" \"[method]udp-socket.finish-bind\" (func $__fern_wasi_udp_finish_bind (param i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/udp@0.2.0\" \"[method]udp-socket.stream\" (func $__fern_wasi_udp_stream (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/udp@0.2.0\" \"[method]outgoing-datagram-stream.check-send\" (func $__fern_wasi_udp_check_send (param i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/udp@0.2.0\" \"[method]outgoing-datagram-stream.subscribe\" (func $__fern_wasi_udp_subscribe (param i32) (result i32)))\n";
    o = o + "  (import \"wasi:sockets/udp@0.2.0\" \"[method]outgoing-datagram-stream.send\" (func $__fern_wasi_udp_send_dgram (param i32 i32 i32 i32)))\n";
    o = o + "  (import \"wasi:sockets/udp@0.2.0\" \"[resource-drop]udp-socket\" (func $__fern_wasi_udp_socket_drop (param i32)))\n";
    o = o + "  (import \"wasi:sockets/udp@0.2.0\" \"[resource-drop]incoming-datagram-stream\" (func $__fern_wasi_udp_in_drop (param i32)))\n";
    o = o + "  (import \"wasi:sockets/udp@0.2.0\" \"[resource-drop]outgoing-datagram-stream\" (func $__fern_wasi_udp_out_drop (param i32)))\n";
    return o;
}

// $__fern_ipv4_parse(s) -> i32: parse a dotted-quad "a.b.c.d" string block into
// the four octets packed a | b<<8 | c<<16 | d<<24, or -1 on a malformed host.
//
// Native does this inline in __fern_udp_send and has to normalise the string
// first (its SSO form may not be contiguous); a self-host string block is
// always `[len@+0][bytes@+4]`, so the bytes are already contiguous and the
// parse reads them directly. Split out as its own function because it is the
// one piece here with real branching, and it is far easier to reason about (and
// to reuse, should udp_recv or a host-literal tcp_connect want it) on its own.
pub function ipv4_parse_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_ipv4_parse (param $s i32) (result i32)\n";
    o = o + "    (local $len i32) (local $i i32) (local $b i32) (local $acc i32) (local $n i32) (local $out i32) (local $digits i32)\n";
    o = o + "    (local.set $len (i32.load (local.get $s)))\n";
    o = o + "    (block $done\n";
    o = o + "      (loop $more\n";
    o = o + "        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))\n";
    o = o + "        (local.set $b (i32.load8_u (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $i))))\n";
    o = o + "        (if (i32.eq (local.get $b) (i32.const 46))\n";
    o = o + "          (then\n";
    o = o + "            (if (i32.eqz (local.get $digits)) (then (return (i32.const -1))))\n";
    o = o + "            (if (i32.ge_u (local.get $n) (i32.const 3)) (then (return (i32.const -1))))\n";
    o = o + "            (local.set $out (i32.or (local.get $out) (i32.shl (local.get $acc) (i32.mul (local.get $n) (i32.const 8)))))\n";
    o = o + "            (local.set $n (i32.add (local.get $n) (i32.const 1)))\n";
    o = o + "            (local.set $acc (i32.const 0))\n";
    o = o + "            (local.set $digits (i32.const 0)))\n";
    o = o + "          (else\n";
    o = o + "            (if (i32.or (i32.lt_u (local.get $b) (i32.const 48)) (i32.gt_u (local.get $b) (i32.const 57)))\n";
    o = o + "              (then (return (i32.const -1))))\n";
    o = o + "            (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 10)) (i32.sub (local.get $b) (i32.const 48))))\n";
    o = o + "            (if (i32.gt_u (local.get $acc) (i32.const 255)) (then (return (i32.const -1))))\n";
    o = o + "            (local.set $digits (i32.add (local.get $digits) (i32.const 1)))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $more)))\n";
    o = o + "    (if (i32.or (i32.ne (local.get $n) (i32.const 3)) (i32.eqz (local.get $digits)))\n";
    o = o + "      (then (return (i32.const -1))))\n";
    o = o + "    (i32.or (local.get $out) (i32.shl (local.get $acc) (i32.const 24))))\n";
    return o;
}

// $__fern_udp_send(host, port, data) -> bytes accepted by the host, or -errno
// (or -1 on a malformed host literal).
//
// Pipeline, mirroring native's wasi_udp.go:
//   create-udp-socket -> start-bind + finish-bind(0.0.0.0:0)
//   -> stream(Some(host:port))            [connects the outgoing stream]
//   -> { check-send; if no permit, subscribe + block; retry }
//   -> send([{data, remote-address: none}])
//   -> drop incoming + outgoing streams, then the socket.
//
// Connecting via stream(Some(remote)) is what keeps this tractable: the
// destination rides the 15-i32 ip-socket-address flattening (the same one tcp
// start-bind / start-connect use), so the outgoing-datagram carries
// remote-address: NONE and only its data ptr/len and the option discriminant
// need writing — no hand-marshalling of the address variant into the record.
// The record is 60 bytes: data (ptr@+0, len@+4), option disc 0 @ +8.
pub function udp_send_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_udp_send (param $host i32) (param $port i32) (param $data i32) (result i32)\n";
    o = o + "    (local $ip i32) (local $sock i32) (local $ret i32) (local $in i32) (local $out i32) (local $p i32) (local $dg i32) (local $sent i32)\n";
    o = o + "    (local.set $ip (call $__fern_ipv4_parse (local.get $host)))\n";
    o = o + "    (if (i32.lt_s (local.get $ip) (i32.const 0)) (then (return (i32.const -1))))\n";
    o = o + "    (local.set $ret (call $__fern_alloc (i32.const 16)))\n";
    o = o + "    (call $__fern_wasi_create_udp_socket (i32.const 0) (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (local.set $sock (i32.load offset=4 (local.get $ret)))\n";
    // bind 0.0.0.0:0 — ephemeral local port.
    o = o + "    (call $__fern_wasi_udp_start_bind (local.get $sock) (call $__fern_network_handle)\n";
    o = o + "      (i32.const 0) (i32.const 0)\n";
    o = o + "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n";
    o = o + "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n";
    o = o + "      (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (call $__fern_wasi_udp_finish_bind (local.get $sock) (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    // stream(Some(host:port)): option disc 1, then the ip-socket-address
    // flattening (disc 0 = ipv4, port, 4 octets, 6 pad).
    o = o + "    (call $__fern_wasi_udp_stream (local.get $sock)\n";
    o = o + "      (i32.const 1) (i32.const 0) (local.get $port)\n";
    o = o + "      (i32.and (local.get $ip) (i32.const 255))\n";
    o = o + "      (i32.and (i32.shr_u (local.get $ip) (i32.const 8)) (i32.const 255))\n";
    o = o + "      (i32.and (i32.shr_u (local.get $ip) (i32.const 16)) (i32.const 255))\n";
    o = o + "      (i32.and (i32.shr_u (local.get $ip) (i32.const 24)) (i32.const 255))\n";
    o = o + "      (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)\n";
    o = o + "      (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (return (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))))\n";
    o = o + "    (local.set $in (i32.load offset=4 (local.get $ret)))\n";
    o = o + "    (local.set $out (i32.load offset=8 (local.get $ret)))\n";
    // The 1-element list<outgoing-datagram>: 60-byte record, remote none.
    o = o + "    (local.set $dg (call $__fern_alloc (i32.const 64)))\n";
    o = o + "    (i32.store (local.get $dg) (i32.add (local.get $data) (i32.const 4)))\n";
    o = o + "    (i32.store offset=4 (local.get $dg) (i32.load (local.get $data)))\n";
    o = o + "    (i32.store offset=8 (local.get $dg) (i32.const 0))\n";
    // Permit wait + send. wasmtime >=45 rejects a send that exceeds the
    // permit, and a 0-datagram accept means try again, so both are loops.
    o = o + "    (block $done\n";
    o = o + "      (loop $again\n";
    o = o + "        (call $__fern_wasi_udp_check_send (local.get $out) (local.get $ret))\n";
    o = o + "        (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "          (local.set $sent (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))\n";
    o = o + "          (br $done)))\n";
    o = o + "        (if (i64.eqz (i64.load offset=8 (local.get $ret)))\n";
    o = o + "          (then\n";
    o = o + "            (local.set $p (call $__fern_wasi_udp_subscribe (local.get $out)))\n";
    o = o + "            (call $__fern_wasi_pollable_block (local.get $p))\n";
    o = o + "            (call $__fern_wasi_pollable_drop (local.get $p))\n";
    o = o + "            (br $again)))\n";
    o = o + "        (call $__fern_wasi_udp_send_dgram (local.get $out) (local.get $dg) (i32.const 1) (local.get $ret))\n";
    o = o + "        (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "          (local.set $sent (i32.sub (i32.const 0) (i32.load8_u offset=4 (local.get $ret))))\n";
    o = o + "          (br $done)))\n";
    o = o + "        (if (i64.eqz (i64.load offset=8 (local.get $ret))) (then (br $again)))\n";
    o = o + "        (local.set $sent (i32.load (local.get $data)))\n";
    o = o + "        (br $done)))\n";
    o = o + "    (call $__fern_wasi_udp_in_drop (local.get $in))\n";
    o = o + "    (call $__fern_wasi_udp_out_drop (local.get $out))\n";
    o = o + "    (call $__fern_wasi_udp_socket_drop (local.get $sock))\n";
    o = o + "    (local.get $sent))\n";
    return o;
}

// Stream imports for tcp_send / tcp_recv (#4318 slice 2). Both are already in
// the vendored cmd/fern/wit/deps/io/streams.wit, so unlike connect this slice
// needs no WIT change.
pub function wasi_stream_io_imports(): string {
    var o: string = "";
    o = o + "  (import \"wasi:io/streams@0.2.0\" \"[method]output-stream.blocking-write-and-flush\" (func $__fern_wasi_stream_write (param i32 i32 i32 i32)))\n";
    o = o + "  (import \"wasi:io/streams@0.2.0\" \"[method]input-stream.blocking-read\" (func $__fern_wasi_stream_read (param i32 i64 i32)))\n";
    return o;
}

// $__fern_tcp_send(conn, s) -> i32: bytes written, or -1 on a stream error.
//
// A self-host string block is `[len@+0][bytes@+4]` — ONE pointer, not native's
// (ptr, len) pair, and no SSO form to normalise. That difference is the whole
// reason this helper is not a transcription of native's buildTcpSendBody.
//
// The output-stream is mem[conn+8]. wasmtime caps blocking-write-and-flush at
// 4 KiB per call, so anything longer drains through a chunked loop; a stream
// error mid-flight short-circuits to -1 (preview-2 stream errors carry no errno
// through the variant we use, so -1 is the only sensible negative sentinel).
pub function tcp_send_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_tcp_send (param $c i32) (param $s i32) (result i32)\n";
    o = o + "    (local $st i32) (local $ret i32) (local $len i32) (local $off i32) (local $n i32)\n";
    o = o + "    (local.set $st (i32.load offset=8 (local.get $c)))\n";
    o = o + "    (local.set $len (i32.load (local.get $s)))\n";
    o = o + "    (local.set $ret (call $__fern_alloc (i32.const 12)))\n";
    o = o + "    (block $done\n";
    o = o + "      (loop $more\n";
    o = o + "        (br_if $done (i32.ge_u (local.get $off) (local.get $len)))\n";
    o = o + "        (local.set $n (i32.sub (local.get $len) (local.get $off)))\n";
    o = o + "        (if (i32.gt_u (local.get $n) (i32.const 4096))\n";
    o = o + "          (then (local.set $n (i32.const 4096))))\n";
    o = o + "        (call $__fern_wasi_stream_write (local.get $st)\n";
    o = o + "          (i32.add (i32.add (local.get $s) (i32.const 4)) (local.get $off))\n";
    o = o + "          (local.get $n) (local.get $ret))\n";
    o = o + "        (if (i32.load8_u (local.get $ret)) (then (return (i32.const -1))))\n";
    o = o + "        (local.set $off (i32.add (local.get $off) (local.get $n)))\n";
    o = o + "        (br $more)))\n";
    o = o + "    (local.get $len))\n";
    return o;
}

// $__fern_tcp_recv(conn, max) -> string: up to `max` bytes as a fresh string
// block, or the EMPTY string on a stream error / clean EOF.
//
// The input-stream is mem[conn+4]. blocking-read's retptr is 12 bytes: disc@+0,
// then the returned list as data-ptr@+4 and length@+8. The bytes are copied
// into a `[len][bytes]` block rather than aliased, because the host buffer is
// only valid until the next canonical-ABI call. The copy is a byte loop — the
// self-host wasm backend does not emit bulk-memory (`memory.copy`), so using it
// here would silently raise the module's required feature set.
pub function tcp_recv_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_tcp_recv (param $c i32) (param $max i32) (result i32)\n";
    o = o + "    (local $st i32) (local $ret i32) (local $n i32) (local $src i32) (local $box i32) (local $i i32)\n";
    o = o + "    (local.set $st (i32.load offset=4 (local.get $c)))\n";
    o = o + "    (local.set $ret (call $__fern_alloc (i32.const 12)))\n";
    o = o + "    (call $__fern_wasi_stream_read (local.get $st)\n";
    o = o + "      (i64.extend_i32_u (local.get $max)) (local.get $ret))\n";
    o = o + "    (if (i32.load8_u (local.get $ret)) (then\n";
    o = o + "      (local.set $box (call $__fern_str_box (i32.const 0)))\n";
    o = o + "      (i32.store (local.get $box) (i32.const 0))\n";
    o = o + "      (return (local.get $box))))\n";
    o = o + "    (local.set $src (i32.load offset=4 (local.get $ret)))\n";
    o = o + "    (local.set $n (i32.load offset=8 (local.get $ret)))\n";
    o = o + "    (local.set $box (call $__fern_str_box (local.get $n)))\n";
    o = o + "    (i32.store (local.get $box) (local.get $n))\n";
    o = o + "    (block $done\n";
    o = o + "      (loop $more\n";
    o = o + "        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "        (i32.store8 (i32.add (i32.add (local.get $box) (i32.const 4)) (local.get $i))\n";
    o = o + "          (i32.load8_u (i32.add (local.get $src) (local.get $i))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $more)))\n";
    o = o + "    (local.get $box))\n";
    return o;
}

// $__fern_tcp_close(conn) -> i32 (always 0; resource drops are infallible at
// the canonical-ABI layer, and the i32 return keeps the tcp_* surface uniform).
//
// Drop order matters: the streams are CHILDREN of the tcp-socket, and the
// canonical ABI rejects a parent drop while children live. The stream slots are
// 0 for listener structs, and passing 0 to a resource-drop import traps host-
// side, so each drop is guarded on a non-zero handle.
pub function tcp_close_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_tcp_close (param $c i32) (result i32)\n";
    o = o + "    (local $h i32)\n";
    o = o + "    (local.set $h (i32.load offset=4 (local.get $c)))\n";
    o = o + "    (if (local.get $h) (then (call $__fern_wasi_input_stream_drop (local.get $h))))\n";
    o = o + "    (local.set $h (i32.load offset=8 (local.get $c)))\n";
    o = o + "    (if (local.get $h) (then (call $__fern_wasi_output_stream_drop (local.get $h))))\n";
    o = o + "    (local.set $h (i32.load (local.get $c)))\n";
    o = o + "    (if (local.get $h) (then (call $__fern_wasi_tcp_socket_drop (local.get $h))))\n";
    o = o + "    (i32.const 0))\n";
    return o;
}

// $__fern_poll(ps: i32[], timeout_ms) -> i32: the POSIX-shaped readiness
// multiplexer — the index of the first ready element, or -1 on TIMEOUT. A
// negative timeout blocks indefinitely; 0 polls without waiting.
//
// On wasm the elements are wasi:io/poll pollable handles (what tcp_pollable and
// wasm_timer_pollable hand back) — wasm has no file descriptors, so a pollable
// IS the fd analog. That makes the indefinite case exactly $__fern_wasm_poll,
// which this delegates to rather than duplicating.
//
// The timeout is expressed the only way wasi:io/poll can express one: subscribe
// a monotonic-clock timer for `timeout_ms` and add it to the polled set as one
// extra entry. If the winning index is that trailing entry (== the caller's
// length), the wait timed out and the result is -1; otherwise the winner is a
// caller pollable and its index is already correct, since the timer was
// appended AFTER them. #4316 follow-up.
pub function poll_fds_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_poll (param $arr i32) (param $ms i32) (result i32)\n";
    o = o + "    (local $n i32) (local $buf i32) (local $t i32) (local $ret i32) (local $i i32) (local $idx i32)\n";
    o = o + "    (if (i32.lt_s (local.get $ms) (i32.const 0)) (then\n";
    o = o + "      (return (call $__fern_wasm_poll (local.get $arr)))))\n";
    o = o + "    (local.set $n (i32.load (local.get $arr)))\n";
    o = o + "    (local.set $buf (call $__fern_alloc (i32.mul (i32.add (local.get $n) (i32.const 1)) (i32.const 4))))\n";
    o = o + "    (block $copied\n";
    o = o + "      (loop $more\n";
    o = o + "        (br_if $copied (i32.ge_u (local.get $i) (local.get $n)))\n";
    o = o + "        (i32.store (i32.add (local.get $buf) (i32.mul (local.get $i) (i32.const 4)))\n";
    o = o + "          (i32.load (i32.add (i32.add (local.get $arr) (i32.const 8)) (i32.mul (local.get $i) (i32.const 4)))))\n";
    o = o + "        (local.set $i (i32.add (local.get $i) (i32.const 1)))\n";
    o = o + "        (br $more)))\n";
    o = o + "    (local.set $t (call $__fern_wasi_subscribe_duration\n";
    o = o + "      (i64.mul (i64.extend_i32_s (local.get $ms)) (i64.const 1000000))))\n";
    o = o + "    (i32.store (i32.add (local.get $buf) (i32.mul (local.get $n) (i32.const 4))) (local.get $t))\n";
    o = o + "    (local.set $ret (call $__fern_alloc (i32.const 8)))\n";
    o = o + "    (call $__fern_wasi_poll (local.get $buf) (i32.add (local.get $n) (i32.const 1)) (local.get $ret))\n";
    o = o + "    (local.set $idx (i32.const -1))\n";
    o = o + "    (if (i32.load offset=4 (local.get $ret)) (then\n";
    o = o + "      (local.set $idx (i32.load (i32.load (local.get $ret))))))\n";
    o = o + "    (call $__fern_wasi_pollable_drop (local.get $t))\n";
    o = o + "    (if (i32.ge_u (local.get $idx) (local.get $n)) (then (return (i32.const -1))))\n";
    o = o + "    (local.get $idx))\n";
    return o;
}

pub function wasm_poll_func(): string {
    var o: string = "";
    o = o + "  (func $__fern_wasm_poll (param $arr i32) (result i32)\n";
    o = o + "    (local $retptr i32)\n";
    o = o + "    (local.set $retptr (call $__fern_alloc (i32.const 8)))\n";
    o = o + "    (call $__fern_wasi_poll (i32.add (local.get $arr) (i32.const 8))\n";
    o = o + "      (i32.load (local.get $arr))\n";
    o = o + "      (local.get $retptr))\n";
    o = o + "    (if (result i32) (i32.load offset=4 (local.get $retptr))\n";
    o = o + "      (then (i32.load (i32.load (local.get $retptr))))\n";
    o = o + "      (else (i32.const -1))))\n";
    return o;
}

// lift_lambdas re-exports irlower's lambda-lift pre-pass (closures slice 2a) so
// the wasm dispatch sites can hoist no-capture lambda arguments before the
// eligibility check + emit. A lambda-free module is returned unchanged.
pub function lift_lambdas(mod: parser.Module): parser.Module {
    return irlower.lift_lambdas(mod);
}

// fn_value_table collects the module's address-taken functions (the targets of
// const_func ops) in first-seen, deduped order. The position of a name here is
// its funcref-table slot index — both the const_func `i32.const <idx>` and the
// elem segment in fn_support_section index into this list, so they agree.
// pipe_before / pipe_after split op_map_new's packed struct "hash|eq" fns.
pub function pipe_before(s: string): string {
    var i: i32 = 0;
    while (i < s.len() && s[i] != 124) { i = i + 1; }   // '|'
    return s[0:i] + "";
}
pub function pipe_after(s: string): string {
    var i: i32 = 0;
    while (i < s.len() && s[i] != 124) { i = i + 1; }
    if (i >= s.len()) { return ""; }
    return s[i + 1 : s.len()] + "";
}

pub function fn_value_table(cache: irlower.LowerResult[]): string[] {
    var out: string[] = [];
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 6 && util.index_of_str(out, r.ops[i].str) < 0) {  // const_func
                out = out.append(r.ops[i].str);
            }
            // A struct/enum-keyed map (op_map_new kind 2) takes the derived
            // hash/eq via call_indirect, so they are address-taken too — add
            // them to the funcref table so map_new can store their slot indices
            // in the box. #2671.
            if (r.ops[i].kind_tag == 124 && r.ops[i].i32_imm == 2 && r.ops[i].str.len() > 0) {  // map_new
                var hf: string = pipe_before(r.ops[i].str);
                var ef: string = pipe_after(r.ops[i].str);
                if (util.index_of_str(out, hf) < 0) { out = out.append(hf); }
                if (util.index_of_str(out, ef) < 0) { out = out.append(ef); }
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    return out;
}

// indirect_arities collects the distinct argument counts used by call_indirect
// ops across the module (deduped), so fn_support_section declares one
// `$fn<argc>` signature type per arity actually dispatched.
pub function indirect_arities(cache: irlower.LowerResult[]): i32[] {
    var out: i32[] = [];
    var fi: i32 = 0;
    while (fi < cache.len()) {
        var r: irlower.LowerResult = cache[fi];
        var i: i32 = 0;
        while (i < r.ops.len()) {
            if (r.ops[i].kind_tag == 150 && !slot_in_list(out, r.ops[i].i32_imm)) {  // call_indirect
                out = out.append(r.ops[i].i32_imm);
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    // map_helpers' hk/keq reference (type $fn1) (derived hash) and (type $fn2)
    // (derived eq) via call_indirect for struct/enum keys — and that wat is
    // emitted whenever ANY map is used, not just a struct-keyed one. So both
    // signature types must exist for every map-using module or the (dead, for
    // i32/string keys) call_indirect fails validation. #2671.
    if (module_uses_maps(cache)) {
        if (!slot_in_list(out, 1)) { out = out.append(1); }
        if (!slot_in_list(out, 2)) { out = out.append(2); }
    }
    return out;
}

// fn_support_section emits the WAT module items that back plain function values:
// one `(type $fn<N> (func (param i32)×N (result i32)))` per dispatched arity, a
// `(table <M> funcref)` sized to the address-taken set, and an `(elem (i32.const
// 0) $f0 $f1 …)` filling it in fn_value_table order. Empty string when the
// module has no function values, so non-closure modules are byte-unchanged.
// fn_support_section_units is the multi-unit form (#5331 step 4b): one table and
// one elem segment covering every unit's address-taken functions, plus one
// $__fn_base<ns> global per unit holding that unit's start index. `all_fns` is
// the flat concatenation of the per-unit tables and `counts` their lengths, so
// unit i occupies [sum(counts[0..i]), +counts[i]) — exactly the relative indices
// its bodies were emitted against.
//
// The single-unit call below passes nss = [""] and the whole table, which
// reproduces the historical output byte for byte.
pub function fn_support_section_units(nss: string[], all_fns: string[], counts: i32[], arities: i32[]): string {
    if (all_fns.len() == 0 && arities.len() == 0) { return ""; }
    var out: string = "";
    var ai: i32 = 0;
    while (ai < arities.len()) {
        out = out + "  (type $fn" + util.i32_to_string(arities[ai]) + " (func";
        var pj: i32 = 0;
        while (pj < arities[ai]) { out = out + " (param i32)"; pj = pj + 1; }
        out = out + " (result i32)))\n";
        ai = ai + 1;
    }
    var tsize: i32 = all_fns.len();
    if (tsize == 0) { tsize = 1; }
    var base: i32 = 0;
    var ni: i32 = 0;
    while (ni < nss.len()) {
        out = out + "  (global " + fn_base_global(nss[ni]) + " i32 (i32.const " + util.i32_to_string(base) + "))\n";
        base = base + counts[ni];
        ni = ni + 1;
    }
    out = out + "  (table " + util.i32_to_string(tsize) + " funcref)\n";
    if (all_fns.len() > 0) {
        out = out + "  (elem (i32.const 0)";
        var ei: i32 = 0;
        while (ei < all_fns.len()) {
            out = out + " $" + all_fns[ei];
            ei = ei + 1;
        }
        out = out + ")\n";
    }
    return out;
}

// fn_support_section is whole-program emit: a single unit, so the table needs
// exactly one base at 0. The table must exist for any call_indirect to validate
// — including the map's struct-key hk/keq, which is emitted (but dead) even when
// no function VALUE is taken — so the units form sizes an empty set to 1 slot.
pub function fn_support_section(cache: irlower.LowerResult[]): string {
    var ft: string[] = fn_value_table(cache);
    return fn_support_section_units([""], ft, [ft.len()], indirect_arities(cache));
}

// wasm_arr_bounds_check emits the array index bounds check shared by arr_get /
// arr_set (docs/ARRAY-BOUNDS.md). Precondition: the index has already been
// popped into idx_local and the base pointer is on top of the wasm stack.
// It compares idx against the length prefix (len @ base+0) with a single
// unsigned compare — `len <= idx` catches both a negative index (which reads
// as a huge unsigned) and `idx >= len` — and traps (`unreachable`, which
// wasmtime surfaces as exit 134) when out of range. On the in-range path it
// leaves `base, idx` back on the stack for the caller's load/store sequence.
function wasm_arr_bounds_check(base_local: i32, idx_local: i32): string {
    var s: string = "";
    s = s + "    local.tee " + util.i32_to_string(base_local) + "\n";
    s = s + "    i32.load\n";
    s = s + "    local.get " + util.i32_to_string(idx_local) + "\n";
    s = s + "    i32.le_u\n";
    s = s + "    if\n      unreachable\n    end\n";
    s = s + "    local.get " + util.i32_to_string(base_local) + "\n";
    s = s + "    local.get " + util.i32_to_string(idx_local) + "\n";
    return s;
}

// emit_function_ir renders one IR-eligible function as a WAT (func ...). Locals
// are numeric: slots 0..n_params-1 the params, n_params..n_locals-1 the body
// locals, plus TWO scratch locals (indices n_locals, n_locals+1) the array ops
// use to hold a base pointer / popped element while reordering the wasm stack.
// emit_function_ir emits one function's WAT bodies from its PRE-LOWERED result
// `r` (#5510 refactor / the wasm port of asm's #4394 lever 3). Previously it
// re-lowered `fd` here — a SECOND lowering that had to be kept byte-identical to
// the metadata lowering (lower_all_for_view) by hand, the divergence that caused
// the RC-consistency bug (#5509). Consuming the cached `r` makes it one lowering
// by construction. `fd` supplies the func wrapper (name / receiver / ret); the
// ~13 ret-fn / borrow side-tables that only fed lower_func are gone.
function emit_function_ir(ns: string, r: irlower.LowerResult, fd: parser.FuncDecl, str_vals: string[], structs: parser.StructDecl[], fn_table: string[], funcs: parser.FuncDecl[]): string {
    var arrtmp: i32 = r.n_locals;
    var eltmp: i32 = r.n_locals + 1;
    // f64tmp: an f64-typed scratch local for reordering 64-bit struct field
    // values (struct_make / struct_set) through the typed wasm stack — the i32
    // eltmp can't hold an f64.
    var f64tmp: i32 = r.n_locals + 2;
    // i64tmp: an i64-typed scratch local for reordering 8-byte INTEGER array
    // elements (i64[] arr_make / arr_set) through the typed wasm stack — the i32
    // eltmp can't hold an i64, and f64tmp is float-typed.
    var i64tmp: i32 = r.n_locals + 3;
    // bctmp: an i32 scratch holding the index across the arr_get / arr_set bounds
    // check (arrtmp holds the base). Needed as a fifth scratch because arr_set's
    // i32 path already parks the value in eltmp, so the index needs its own home.
    var bctmp: i32 = r.n_locals + 4;
    // Methods get the receiver-type-qualified name `$<Type>.<name>` (matching
    // irlower's call_direct dispatch); free functions stay `$<name>`. WAT idents
    // allow `.`. r.n_params already counts the receiver as the first param.
    var fn_name: string = fd.name;
    if (fd.receiver_type.len() > 0) { fn_name = util.base_type_name(fd.receiver_type) + "." + fd.name; }
    var out: string = "  (func $" + fn_name;
    var p: i32 = 0;
    while (p < r.n_params) {
        // An i64 param is in r.i64_slots, an f64 param in r.f64_slots (lower_func
        // marks them); the receiver slot 0 of a method never is.
        if (slot_in_list(r.i64_slots, p)) { out = out + " (param i64)"; }
        else if (slot_in_list(r.f64_slots, p)) { out = out + " (param f64)"; }
        else { out = out + " (param i32)"; }
        p = p + 1;
    }
    // u64 returns ride the i64 result type (8-byte; only signedness of the
    // value's own ops differs, handled at the producing expression) (#2904).
    if (fd.ret_type == "i64" || fd.ret_type == "u64") { out = out + " (result i64)\n"; }
    else if (irlower.is_f64_scalar_type_name(fd.ret_type)) { out = out + " (result f64)\n"; }
    // A bare-typevar (erased-generic) return is typed i64 on wasm — the uniform
    // 8-byte slot the register backends give every value — so a wide value
    // survives pass-through; the caller coerces the i64 result to the concrete
    // type at the call boundary (#5464). Free functions only.
    else if (irlower.erased_passthrough_safe(fd, structs)) { out = out + " (result i64)\n"; }
    else { out = out + " (result i32)\n"; }
    // body locals + 5 scratch locals. A body local in r.i64_slots is declared
    // (local i64), one in r.f64_slots (local f64); the trailing scratch locals
    // are two i32 (arrtmp/eltmp), one f64 (f64tmp), one i64 (i64tmp), one i32
    // (bctmp, the bounds-check index holder).
    var nbody: i32 = r.n_locals - r.n_params;
    var nloc: i32 = nbody + 5;
    out = out + "    (local";
    var l: i32 = 0;
    while (l < nloc) {
        if (l == nbody + 2) {
            out = out + " f64";
        } else if (l == nbody + 3) {
            out = out + " i64";
        } else if (l < nbody && slot_in_list(r.i64_slots, r.n_params + l)) {
            out = out + " i64";
        } else if (l < nbody && slot_in_list(r.f64_slots, r.n_params + l)) {
            out = out + " f64";
        } else {
            out = out + " i32";
        }
        l = l + 1;
    }
    out = out + ")\n";
    var i: i32 = 0;
    while (i < r.ops.len()) {
        var o: ir.Op = r.ops[i];
        if (o.kind_tag == 1) {  // const_i32
            out = out + "    i32.const " + util.i32_to_string(o.i32_imm) + "\n";
        } else if (o.kind_tag == 2) {  // const_i32_text
            // Integer literal source text — the wasm text parser handles the base
            // (hex `0x..`) and the full i32/u32 immediate range.
            out = out + "    i32.const " + o.str + "\n";
        } else if (o.kind_tag == 3) {  // const_i64
            // 64-bit immediate (source text). load_local / store_local on i64
            // slots use the same local.get/local.set — the local's declared i64
            // type carries the stack type.
            out = out + "    i64.const " + o.str + "\n";
        } else if (o.kind_tag == 4) {  // const_f64
            // Float literal: wasm assembles the source text directly. f64 locals
            // are declared (local f64), so local.get/set carry the stack type.
            out = out + "    f64.const " + o.str + "\n";
        } else if (o.kind_tag == 11) {  // i32_to_f64
            out = out + "    f64.convert_i32_s\n";
        } else if (o.kind_tag == 12) {  // f64_to_i32
            // Saturating truncation: NaN -> 0, overflow -> clamp (#4332). The
            // non-saturating i32.trunc_f64_s TRAPS on NaN/overflow, aborting the
            // module; the contract (docs/FLOAT-SEMANTICS.md) is total-saturating.
            // Unsigned (`f64 as u32`) saturates over the full u32 range.
            if (o.unsigned) { out = out + "    i32.trunc_sat_f64_u\n"; }
            else { out = out + "    i32.trunc_sat_f64_s\n"; }
        } else if (o.kind_tag == 13) {  // f64_to_i64
            if (o.unsigned) { out = out + "    i64.trunc_sat_f64_u\n"; }
            else { out = out + "    i64.trunc_sat_f64_s\n"; }
        } else if (o.kind_tag == 16) {  // f64_bits
            // f64 -> i64 bit reinterpret (typed stack flips f64 -> i64).
            out = out + "    i64.reinterpret_f64\n";
        } else if (o.kind_tag == 17) {  // f64_from_bits
            // i64 -> f64 bit reinterpret (typed stack flips i64 -> f64).
            out = out + "    f64.reinterpret_i64\n";
        } else if (o.kind_tag == 14) {  // f32_bits
            // f64 -> f32 (demote), reinterpret to its i32 bit pattern.
            out = out + "    f32.demote_f64\n    i32.reinterpret_f32\n";
        } else if (o.kind_tag == 15) {  // f32_from_bits
            // reinterpret the i32 bits as an f32, promote to f64.
            out = out + "    f32.reinterpret_i32\n    f64.promote_f32\n";
        } else if (o.kind_tag == 61) {  // fround
            // round-half-away-from-zero (Go's math.Round). wasm's f64.nearest is
            // ties-to-EVEN, so emulate via trunc(x + copysign(0.5, x)): stash x in
            // the f64 scratch local, then add copysign(0.5, x) and truncate. (The
            // other op_funary kinds are single instructions routed via wasm_binop_w;
            // this one needs the scratch to reuse x twice.)
            out = out + "    local.set " + util.i32_to_string(f64tmp) + "\n";
            out = out + "    local.get " + util.i32_to_string(f64tmp) + "\n";
            out = out + "    f64.const 0.5\n";
            out = out + "    local.get " + util.i32_to_string(f64tmp) + "\n    f64.copysign\n";
            out = out + "    f64.add\n    f64.trunc\n";
        } else if (o.kind_tag == 62) {  // fexp
            // e^x: wasm has no transcendental instruction, so call the polynomial
            // runtime $__fern_exp_f64 (emitted caller-side in wasm_ir_run). The f64
            // operand is already on the stack; the call consumes it and pushes e^x.
            // The arm64 backend lowers fexp the same way (bl __fern_exp_f64); this
            // is the wasm sibling of that polynomial helper.
            out = out + "    call $__fern_exp_f64\n";
        } else if (o.kind_tag == 63) {  // flog
            // ln(x): wasm has no transcendental instruction, so call the polynomial
            // runtime $__fern_log_f64 (emitted caller-side in wasm_ir_run). The f64
            // operand is already on the stack; the call consumes it and pushes ln(x).
            // The arm64 backend lowers flog the same way (bl __fern_log_f64); this is
            // the wasm sibling of that polynomial helper.
            out = out + "    call $__fern_log_f64\n";
        } else if (o.kind_tag == 64) {  // fsin
            // sin(x): no wasm instruction -> call the polynomial runtime
            // $__fern_sin_f64 (emitted caller-side in wasm_ir_run). f64 operand on
            // the stack; the call consumes it and pushes sin(x). arm64 lowers fsin
            // the same way (bl __fern_sin_f64).
            out = out + "    call $__fern_sin_f64\n";
        } else if (o.kind_tag == 65) {  // fcos
            // cos(x): same as fsin, calling $__fern_cos_f64.
            out = out + "    call $__fern_cos_f64\n";
        } else if (o.kind_tag == 178) {  // read_chunk
            // r.read_chunk(n) -> Option[string]. A Reader is just its fd (stdin =
            // fd 0), so fd + n are on the stack; $__fern_reader_read_chunk reads up
            // to n bytes via preview1 fd_read and boxes Some(chunk) / None at EOF.
            // Emitted caller-side in wasm_ir_run. Mirrors asm_ir's read_chunk op.
            out = out + "    call $__fern_reader_read_chunk\n";
        } else if (o.kind_tag == 179) {  // reader_close
            // r.close() -> Option[IoError] (always None). fd on the stack;
            // $__fern_reader_close calls preview1 fd_close and boxes None. Emitted
            // caller-side in wasm_ir_run. Mirrors asm_ir's reader_close op.
            out = out + "    call $__fern_reader_close\n";
        } else if (o.kind_tag == 133) {  // map_iter
            // m.iter() -> a 12-byte iterator box [keys@0, vals@4, cursor@8].
            // $__fern_map_iter materializes the live keys/values (map snapshots)
            // and boxes them. An 8-byte VALUE column (i64_imm != 0, #5253) snapshots
            // the raw 8-byte values via $__fern_map_iter_w64 (serving i64/u64 AND
            // f64 — mapiter_value reinterprets f64). Otherwise the narrow snapshot.
            if (o.i64_imm != 0) {
                out = out + "    call $__fern_map_iter_w64\n";
            } else {
                out = out + "    call $__fern_map_iter\n";
            }
        } else if (o.kind_tag == 134) {  // mapiter_has_next
            out = out + "    call $__fern_mapiter_has_next\n";
        } else if (o.kind_tag == 135) {  // mapiter_key
            out = out + "    call $__fern_mapiter_key\n";
        } else if (o.kind_tag == 136) {  // mapiter_value
            // An 8-byte VALUE column (i64_imm != 0, #5253) reads the 8-byte element
            // from the value snapshot via $__fern_mapiter_value_w64 (i64 result).
            // i64/u64 (i64_imm 1) use it directly; f64 (i64_imm 2) reinterprets the
            // i64 bits back to f64.
            if (o.i64_imm == 2) {
                out = out + "    call $__fern_mapiter_value_w64\n    f64.reinterpret_i64\n";
