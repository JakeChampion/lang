    if (need(needs, "print_int")) { out = out + print_int_helper(str_offset(sv, sv.len())); }
    if (need(needs, "print_i64")) { out = out + print_int64_helper(str_offset(sv, sv.len()) + 16); }
    if (need(needs, "print_str")) { out = out + print_str_helper(); }
    if (need(needs, "eprint_str")) { out = out + eprint_str_helper(); }
    if (need(needs, "str_bytes")) { out = out + str_bytes_func(); }
    // string_from_bytes_unchecked(arr) packs a u8[] into a string block via
