// examples/self_host/ssa.fern — a static-single-assignment IR for the
// self-hosted compiler, plus an AST → SSA builder and an SSA interpreter
// that validates the builder end-to-end. This is the foundation of the
// self-hosted optimiser: the Go compiler lowers AST → SSA (internal/ssa)
// and runs ~29 passes before codegen; this file ports the IR + builder so
// the self-hosted backends can eventually emit from SSA (and gain the same
// optimisation passes) instead of straight from the AST.
//
// Representation (mirrors internal/ssa/ssa.go, but pointer-free — values
// and blocks are referenced by integer id / array index, matching the
// self-host's value-semantics style):
//   - an SSA Value is an i32 id; an instruction (SInst) DEFINES the value
//     whose id is its `result`, and references operands by their ids in
//     `args`;
//   - a block (SBlock) is a list of instructions ending in a terminator;
//   - a function (SFunc) is a list of blocks with an entry index.
//
// SCOPE (slice 2): straight-line bodies PLUS `if` / `else` — control flow
// now lowers to multiple blocks joined by a merge block whose phi nodes
// reconcile values that differ between the arms. `while` (loop phi /
// back-edge) lands in the next slice; build_func returns ok=false for any
// construct outside this subset so callers can fall back to the AST path.

import "core/no_prelude";
import "./parser";

// digits_to_i32 parses a decimal literal's text (non-negative; unary minus
// is a separate ExprUnary). Mirrors the private helper in the emitters.
function digits_to_i32(s: string): i32 {
    var acc: i32 = 0;
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i];
        if (b < 48 || b > 57) { return acc; }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    return acc;
}

// ---- IR ----------------------------------------------------------------

// SInst kinds (string-tagged to stay simple and printable):
//   "const_int"  imm = value                      result = i32 const
//   "const_bool" imm = 0/1                         result = bool const
//   "binary"     str = op ("+","-","==",…) args=[l,r]
//   "unary"      str = op ("-","!")        args=[x]
//   "call"       str = callee name         args=[…]
//   "param"      imm = param index                 result = the param value
//   "copy"       args=[x]                          result aliases x (var read)
//   "phi"        args parallel to the block's Preds; result = the merged
//                value (operand i flows in when control arrives from Preds[i])
pub struct SInst { kind: string, result: i32, args: i32[], imm: i32, str: string }

// STerm kinds: "ret" (value), "br" (target), "brif" (cond, t, f).
pub struct STerm { kind: string, cond: i32, target: i32, t: i32, f: i32, value: i32 }

pub struct SBlock { id: i32, insts: SInst[], term: STerm, preds: i32[] }

// SFunc: nparams params occupy value ids 0..nparams-1; nvals is the next
// fresh value id; blocks[entry] is the entry block.
pub struct SFunc { name: string, nparams: i32, nvals: i32, blocks: SBlock[], entry: i32 }

function t_ret(value: i32): STerm { return STerm { kind: "ret", cond: 0, target: 0, t: 0, f: 0, value: value }; }
function t_br(target: i32): STerm { return STerm { kind: "br", cond: 0, target: target, t: 0, f: 0, value: 0 }; }
function t_brif(cond: i32, t: i32, f: i32): STerm { return STerm { kind: "brif", cond: cond, target: 0, t: t, f: f, value: 0 }; }
function t_none(): STerm { return STerm { kind: "", cond: 0, target: 0, t: 0, f: 0, value: 0 }; }

// ---- builder state -----------------------------------------------------
// BState threads the in-progress function plus the variable→value
// environment (parallel name/value arrays — the var counts are small).
// `cur` is the block currently being built; finished blocks accumulate in
// `blocks`. `next_blk` is the block-id allocator.

pub struct BState {
    name: string,
    nparams: i32,
    nvals: i32,
    next_blk: i32,
    blocks: SBlock[],
    cur: SBlock,
    var_names: string[],
    var_vals: i32[],
    ok: boolean
}

function mk_bs(name: string, nparams: i32, nvals: i32, next_blk: i32, blocks: SBlock[], cur: SBlock, vn: string[], vv: i32[], ok: boolean): BState {
    return BState { name: name, nparams: nparams, nvals: nvals, next_blk: next_blk, blocks: blocks, cur: cur, var_names: vn, var_vals: vv, ok: ok };
}

// fresh allocates a new value id (read it back with cur_id()).
function (s: BState) fresh(): BState {
    return mk_bs(s.name, s.nparams, s.nvals + 1, s.next_blk, s.blocks, s.cur, s.var_names, s.var_vals, s.ok);
}
function (s: BState) cur_id(): i32 { return s.nvals - 1; }

// emit appends an instruction to the current block.
function (s: BState) emit(inst: SInst): BState {
    var nc: SBlock = SBlock { id: s.cur.id, insts: s.cur.insts.push(inst), term: s.cur.term, preds: s.cur.preds };
    return mk_bs(s.name, s.nparams, s.nvals, s.next_blk, s.blocks, nc, s.var_names, s.var_vals, s.ok);
}

// set_term sets the current block's terminator (does not close it).
function (s: BState) set_term(term: STerm): BState {
    var nc: SBlock = SBlock { id: s.cur.id, insts: s.cur.insts, term: term, preds: s.cur.preds };
    return mk_bs(s.name, s.nparams, s.nvals, s.next_blk, s.blocks, nc, s.var_names, s.var_vals, s.ok);
}

// close_cur pushes the current block into the finished list.
function (s: BState) close_cur(): BState {
    return mk_bs(s.name, s.nparams, s.nvals, s.next_blk, s.blocks.push(s.cur), s.cur, s.var_names, s.var_vals, s.ok);
}

// open_block makes a fresh empty block (with the given preds) current.
function (s: BState) open_block(id: i32, preds: i32[]): BState {
    var nb: SBlock = SBlock { id: id, insts: [], term: t_none(), preds: preds };
    return mk_bs(s.name, s.nparams, s.nvals, s.next_blk, s.blocks, nb, s.var_names, s.var_vals, s.ok);
}

function (s: BState) terminated(): boolean { return s.cur.term.kind != ""; }

function (s: BState) set_var(name: string, val: i32): BState {
    var i: i32 = 0;
    while (i < s.var_names.len()) {
        if (s.var_names[i] == name) {
            var nv: i32[] = [];
            var j: i32 = 0;
            while (j < s.var_vals.len()) {
                if (j == i) { nv = nv.push(val); } else { nv = nv.push(s.var_vals[j]); }
                j = j + 1;
            }
            return mk_bs(s.name, s.nparams, s.nvals, s.next_blk, s.blocks, s.cur, s.var_names, nv, s.ok);
        }
        i = i + 1;
    }
    return mk_bs(s.name, s.nparams, s.nvals, s.next_blk, s.blocks, s.cur, s.var_names.push(name), s.var_vals.push(val), s.ok);
}
function (s: BState) get_var(name: string): i32 {
    var i: i32 = 0;
    while (i < s.var_names.len()) {
        if (s.var_names[i] == name) { return s.var_vals[i]; }
        i = i + 1;
    }
    return 0 - 1;
}
// set_env replaces the whole variable environment (used to restore a
// snapshot or install a branch's outgoing env at a merge).
function (s: BState) set_env(vn: string[], vv: i32[]): BState {
    return mk_bs(s.name, s.nparams, s.nvals, s.next_blk, s.blocks, s.cur, vn, vv, s.ok);
}
function (s: BState) bump_blk(n: i32): BState {
    return mk_bs(s.name, s.nparams, s.nvals, s.next_blk + n, s.blocks, s.cur, s.var_names, s.var_vals, s.ok);
}
function (s: BState) fail(): BState {
    return mk_bs(s.name, s.nparams, s.nvals, s.next_blk, s.blocks, s.cur, s.var_names, s.var_vals, false);
}

// ---- expression lowering ----------------------------------------------

function build_expr(e: parser.Expr, s: BState): BState {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) { return s.fail(); }
            s = s.fresh();
            var args0: i32[] = [];
            return s.emit(SInst { kind: "const_int", result: s.cur_id(), args: args0, imm: digits_to_i32(n.text), str: "" });
        },
        parser.ExprBool(b) => {
            s = s.fresh();
            var iv: i32 = 0;
            if (b.value) { iv = 1; }
            var args0: i32[] = [];
            return s.emit(SInst { kind: "const_bool", result: s.cur_id(), args: args0, imm: iv, str: "" });
        },
        parser.ExprIdent(id) => {
            var v: i32 = s.get_var(id.name);
            if (v < 0) { return s.fail(); }
            s = s.fresh();
            var a1: i32[] = [v];
            return s.emit(SInst { kind: "copy", result: s.cur_id(), args: a1, imm: 0, str: "" });
        },
        parser.ExprBinary(b) => {
            s = build_expr(b.left, s);
            if (!s.ok) { return s; }
            var lv: i32 = s.cur_id();
            s = build_expr(b.right, s);
            if (!s.ok) { return s; }
            var rv: i32 = s.cur_id();
            s = s.fresh();
            var a2: i32[] = [lv, rv];
            return s.emit(SInst { kind: "binary", result: s.cur_id(), args: a2, imm: 0, str: b.op });
        },
        parser.ExprUnary(u) => {
            s = build_expr(u.operand, s);
            if (!s.ok) { return s; }
            var xv: i32 = s.cur_id();
            s = s.fresh();
            var a1: i32[] = [xv];
            return s.emit(SInst { kind: "unary", result: s.cur_id(), args: a1, imm: 0, str: u.op });
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    var argvals: i32[] = [];
                    var i: i32 = 0;
                    while (i < c.args.len()) {
                        s = build_expr(c.args[i], s);
                        if (!s.ok) { return s; }
                        argvals = argvals.push(s.cur_id());
                        i = i + 1;
                    }
                    s = s.fresh();
                    return s.emit(SInst { kind: "call", result: s.cur_id(), args: argvals, imm: 0, str: cid.name });
                },
                _ => { return s.fail(); }
            }
        },
        _ => { return s.fail(); }
    }
}

// ---- statement lowering ------------------------------------------------

function build_stmt(st: parser.Stmt, s: BState): BState {
    // Dead code after a terminator (e.g. statements following a return in
    // the same block) is dropped — the block is already closed.
    if (s.terminated()) { return s; }
    match (st) {
        parser.StmtVar(v) => {
            s = build_expr(v.init, s);
            if (!s.ok) { return s; }
            return s.set_var(v.name, s.cur_id());
        },
        parser.StmtAssign(a) => {
            s = build_expr(a.value, s);
            if (!s.ok) { return s; }
            return s.set_var(a.target, s.cur_id());
        },
        parser.StmtExpr(x) => {
            return build_expr(x.value, s);
        },
        parser.StmtReturn(r) => {
            s = build_expr(r.value, s);
            if (!s.ok) { return s; }
            return s.set_term(t_ret(s.cur_id()));
        },
        parser.StmtIf(f) => {
            return build_if(f, s);
        },
        parser.StmtWhile(w) => {
            return build_while(w, s);
        },
        _ => { return s.fail(); }
    }
}

function build_stmts(body: parser.Stmt[], s: BState): BState {
    var i: i32 = 0;
    while (i < body.len()) {
        s = build_stmt(body[i], s);
        if (!s.ok) { return s; }
        i = i + 1;
    }
    return s;
}

// build_if lowers `if (cond) { then } else { else }` into a diamond:
//   pred ──brif──► then ──┐
//        └────────► else ─┴──► merge
// The merge block carries a phi for every pre-existing variable whose value
// differs between the arms that reach it. A branch that ends in `return`
// does not reach the merge and contributes no phi operand.
function build_if(f: parser.StmtIf, s: BState): BState {
    s = build_expr(f.cond, s);
    if (!s.ok) { return s; }
    var cond_val: i32 = s.cur_id();
    var pred_id: i32 = s.cur.id;

    var has_else: boolean = f.else_body.len() > 0;

    var then_id: i32 = s.next_blk;
    var else_id: i32 = s.next_blk + 1;
    var merge_id: i32 = s.next_blk + 2;
    s = s.bump_blk(3);

    // Snapshot the entering environment so each arm starts from it.
    var n0: i32 = s.var_names.len();
    var env0_names: string[] = s.var_names;
    var env0_vals: i32[] = s.var_vals;

    // Terminate the predecessor with the conditional branch.
    var false_target: i32 = merge_id;
    if (has_else) { false_target = else_id; }
    s = s.set_term(t_brif(cond_val, then_id, false_target));
    s = s.close_cur();

    // ---- then arm ----
    var then_preds: i32[] = [pred_id];
    s = s.open_block(then_id, then_preds);
    s = s.set_env(env0_names, env0_vals);
    s = build_stmts(f.then_body, s);
    if (!s.ok) { return s; }
    var then_reaches: boolean = !s.terminated();
    var then_exit_id: i32 = s.cur.id;
    var then_names: string[] = s.var_names;
    var then_vals: i32[] = s.var_vals;
    if (then_reaches) { s = s.set_term(t_br(merge_id)); }
    s = s.close_cur();

    // ---- else arm ----
    var else_reaches: boolean = true;
    var else_exit_id: i32 = pred_id;     // no-else: false edge is pred→merge
    var else_names: string[] = env0_names;
    var else_vals: i32[] = env0_vals;
    if (has_else) {
        var else_preds: i32[] = [pred_id];
        s = s.open_block(else_id, else_preds);
        s = s.set_env(env0_names, env0_vals);
        s = build_stmts(f.else_body, s);
        if (!s.ok) { return s; }
        else_reaches = !s.terminated();
        else_exit_id = s.cur.id;
        else_names = s.var_names;
        else_vals = s.var_vals;
        if (else_reaches) { s = s.set_term(t_br(merge_id)); }
        s = s.close_cur();
    }

    // ---- merge ----
    var mpreds: i32[] = [];
    if (then_reaches) { mpreds = mpreds.push(then_exit_id); }
    if (else_reaches) { mpreds = mpreds.push(else_exit_id); }
    s = s.open_block(merge_id, mpreds);

    // Reconcile the environment with phi nodes. Iterate the pre-existing
    // variables (indices 0..n0); arm-local vars (appended at higher
    // indices) are out of scope past the branch.
    var merge_names: string[] = env0_names;
    var merge_vals: i32[] = env0_vals;
    var vi: i32 = 0;
    while (vi < n0) {
        var tv: i32 = then_vals[vi];
        var ev: i32 = else_vals[vi];
        if (then_reaches && else_reaches) {
            if (tv != ev) {
                s = s.fresh();
                var pa: i32[] = [tv, ev];
                s = s.emit(SInst { kind: "phi", result: s.cur_id(), args: pa, imm: 0, str: "" });
                merge_vals = env_set_at(merge_vals, vi, s.cur_id());
            }
        } else if (then_reaches) {
            merge_vals = env_set_at(merge_vals, vi, tv);
        } else if (else_reaches) {
            merge_vals = env_set_at(merge_vals, vi, ev);
        }
        vi = vi + 1;
    }
    s = s.set_env(merge_names, merge_vals);
    return s;
}

// env_set_at returns vals with index i replaced by v.
function env_set_at(vals: i32[], i: i32, v: i32): i32[] {
    var out: i32[] = [];
    var k: i32 = 0;
    while (k < vals.len()) {
        if (k == i) { out = out.push(v); } else { out = out.push(vals[k]); }
        k = k + 1;
    }
    return out;
}

function contains_str(xs: string[], n: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == n) { return true; }
        i = i + 1;
    }
    return false;
}
function index_of_i32(xs: i32[], n: i32): i32 {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == n) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// collect_assigned returns the set of variable names targeted by an
// assignment anywhere in `body` (recursing through nested if / while) —
// these are the loop-carried variables that need a header phi.
function collect_assigned(body: parser.Stmt[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < body.len()) {
        out = collect_assigned_stmt(body[i], out);
        i = i + 1;
    }
    return out;
}
function collect_assigned_stmt(st: parser.Stmt, out: string[]): string[] {
    match (st) {
        parser.StmtAssign(a) => {
            if (!contains_str(out, a.target)) { out = out.push(a.target); }
            return out;
        },
        parser.StmtIf(f) => {
            out = merge_names(out, collect_assigned(f.then_body));
            out = merge_names(out, collect_assigned(f.else_body));
            return out;
        },
        parser.StmtWhile(w) => {
            return merge_names(out, collect_assigned(w.body));
        },
        _ => { return out; }
    }
}
function merge_names(a: string[], b: string[]): string[] {
    var i: i32 = 0;
    while (i < b.len()) {
        if (!contains_str(a, b[i])) { a = a.push(b[i]); }
        i = i + 1;
    }
    return a;
}

// patch_loop_header completes a loop header once the body's exit is known:
// it appends the back-edge value to each header phi (parallel to the new
// pred) and adds body_exit_id to the header's pred list. The header was
// closed with a single (pre-edge) operand per phi; this supplies the
// second.
function patch_loop_header(s: BState, header_id: i32, phi_results: i32[], back_vals: i32[], body_exit_id: i32): BState {
    var nb: SBlock[] = [];
    var i: i32 = 0;
    while (i < s.blocks.len()) {
        var blk: SBlock = s.blocks[i];
        if (blk.id == header_id) {
            var ninsts: SInst[] = [];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: SInst = blk.insts[k];
                if (ins.kind == "phi") {
                    var pj: i32 = index_of_i32(phi_results, ins.result);
                    if (pj >= 0) {
                        ins = SInst { kind: "phi", result: ins.result, args: ins.args.push(back_vals[pj]), imm: 0, str: "" };
                    }
                }
                ninsts = ninsts.push(ins);
                k = k + 1;
            }
            blk = SBlock { id: blk.id, insts: ninsts, term: blk.term, preds: blk.preds.push(body_exit_id) };
        }
        nb = nb.push(blk);
        i = i + 1;
    }
    return mk_bs(s.name, s.nparams, s.nvals, s.next_blk, nb, s.cur, s.var_names, s.var_vals, s.ok);
}

// build_while lowers `while (cond) { body }` to a loop:
//   pre ──► header ──brif──► body ──┐
//          ▲   │  └──────► exit     │
//          └───┴──────(back edge)───┘
// The header carries a phi for each loop-carried variable: phi(pre_value,
// back_edge_value). The back-edge operand isn't known until the body is
// built, so the phis are emitted with just the pre operand and patched
// afterward (patch_loop_header). On loop exit the live values are the
// header phis (the merged values when the guard last evaluated false).
function build_while(w: parser.StmtWhile, s: BState): BState {
    var n0: i32 = s.var_names.len();
    var pre_names: string[] = s.var_names;
    var pre_vals: i32[] = s.var_vals;
    var assigned: string[] = collect_assigned(w.body);

    var header_id: i32 = s.next_blk;
    var body_id: i32 = s.next_blk + 1;
    var exit_id: i32 = s.next_blk + 2;
    s = s.bump_blk(3);

    // pre → header
    s = s.set_term(t_br(header_id));
    var pre_id: i32 = s.cur.id;
    s = s.close_cur();

    // header: phis for loop-carried vars, then the guard.
    var hpreds: i32[] = [pre_id];
    s = s.open_block(header_id, hpreds);
    var phi_vars: i32[] = [];
    var phi_results: i32[] = [];
    var header_vals: i32[] = pre_vals;
    var vi: i32 = 0;
    while (vi < n0) {
        if (contains_str(assigned, pre_names[vi])) {
            s = s.fresh();
            var pa: i32[] = [pre_vals[vi]];
            s = s.emit(SInst { kind: "phi", result: s.cur_id(), args: pa, imm: 0, str: "" });
            phi_vars = phi_vars.push(vi);
            phi_results = phi_results.push(s.cur_id());
            header_vals = env_set_at(header_vals, vi, s.cur_id());
        }
        vi = vi + 1;
    }
    s = s.set_env(pre_names, header_vals);
    s = build_expr(w.cond, s);
    if (!s.ok) { return s; }
    var cond_val: i32 = s.cur_id();
    s = s.set_term(t_brif(cond_val, body_id, exit_id));
    s = s.close_cur();

    // body
    var bpreds: i32[] = [header_id];
    s = s.open_block(body_id, bpreds);
    s = s.set_env(pre_names, header_vals);
    s = build_stmts(w.body, s);
    if (!s.ok) { return s; }
    // A body that never falls through to the back edge (always returns) is
    // outside the subset.
    if (s.terminated()) { return s.fail(); }
    var body_exit_id: i32 = s.cur.id;
    var body_vals: i32[] = s.var_vals;
    s = s.set_term(t_br(header_id));
    s = s.close_cur();

    // Patch the header phis with the back-edge values.
    var back_vals: i32[] = [];
    var pk: i32 = 0;
    while (pk < phi_vars.len()) {
        back_vals = back_vals.push(body_vals[phi_vars[pk]]);
        pk = pk + 1;
    }
    s = patch_loop_header(s, header_id, phi_results, back_vals, body_exit_id);

    // exit: continue with the header phi values.
    var epreds: i32[] = [header_id];
    s = s.open_block(exit_id, epreds);
    s = s.set_env(pre_names, header_vals);
    return s;
}

pub struct BResult { func: SFunc, ok: boolean }

pub function build_func(fd: parser.FuncDecl): BResult {
    // Params occupy value ids 0..nparams-1, defined by "param" insts in
    // the entry block (block id 0).
    var pnames: string[] = [];
    var pvals: i32[] = [];
    var insts0: SInst[] = [];
    var i: i32 = 0;
    while (i < fd.params.len()) {
        var noargs: i32[] = [];
        insts0 = insts0.push(SInst { kind: "param", result: i, args: noargs, imm: i, str: "" });
        pnames = pnames.push(fd.params[i].name);
        pvals = pvals.push(i);
        i = i + 1;
    }
    var nparams: i32 = fd.params.len();
    var entryblk: SBlock = SBlock { id: 0, insts: insts0, term: t_none(), preds: [] };
    var f0: SFunc = SFunc { name: fd.name, nparams: nparams, nvals: nparams, blocks: [], entry: 0 };
    var s: BState = mk_bs(fd.name, nparams, nparams, 1, [], entryblk, pnames, pvals, true);

    s = build_stmts(fd.body, s);
    if (!s.ok) { return BResult { func: f0, ok: false }; }
    // The current block must end in a return (slice requires every path to
    // terminate explicitly; an un-returned fall-through bails).
    if (!s.terminated()) { return BResult { func: f0, ok: false }; }
    s = s.close_cur();
    var fout: SFunc = SFunc { name: s.name, nparams: s.nparams, nvals: s.nvals, blocks: s.blocks, entry: 0 };
    return BResult { func: fout, ok: true };
}

// ---- optimisation passes -----------------------------------------------
// optimize runs the SSA cleanup pipeline: copy-propagation removes the
// alias `copy` nodes the builder emits for every variable read; constant
// folding collapses arithmetic on known constants; dead-code elimination
// drops instructions whose results are never used. Each pass takes an
// SFunc and returns a semantically equivalent SFunc — verified by the
// interpreter producing the same result before and after (the e2e test
// runs every program with and without -opt and asserts identical output).

pub function optimize(f: SFunc): SFunc {
    // Run the pass pipeline to a fixpoint: branch_simplify can fold a
    // constant `brif` to a `br` and prune the dead arm, which turns the
    // merge phi trivial (→ a copy) and exposes fresh constants;
    // merge_blocks then threads the empty br-only blocks that leaves
    // behind into their successors. We loop until the IR size (instruction
    // count + block count) stops shrinking — block merging registers as
    // progress even when it doesn't change the instruction total.
    var prev: i32 = 0 - 1;
    var rounds: i32 = 0;
    while (rounds < 1000) {
        var size: i32 = count_insts(f) + f.blocks.len();
        if (size == prev) { return f; }
        prev = size;
        f = copy_propagate(f);
        f = const_fold(f);
        f = branch_simplify(f);
        f = merge_blocks(f);
        f = dead_code_elim(f);
        rounds = rounds + 1;
    }
    return f;
}

// zeros returns an n-long i32 array of 0s (scratch flag/value tables).
function zeros(n: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < n) { out = out.push(0); i = i + 1; }
    return out;
}

function rewrite_args(ins: SInst, resolved: i32[]): SInst {
    var na: i32[] = [];
    var i: i32 = 0;
    while (i < ins.args.len()) { na = na.push(resolved[ins.args[i]]); i = i + 1; }
    return SInst { kind: ins.kind, result: ins.result, args: na, imm: ins.imm, str: ins.str };
}
function rewrite_term(t: STerm, resolved: i32[]): STerm {
    if (t.kind == "ret") { return t_ret(resolved[t.value]); }
    if (t.kind == "brif") { return t_brif(resolved[t.cond], t.t, t.f); }
    return t;
}

// copy_propagate threads every operand through the chain of `copy`
// aliases to its real definition, then deletes the copy instructions.
function copy_propagate(f: SFunc): SFunc {
    // ct[i] = the value a `copy` at id i aliases, or -1 if id i is not a copy.
    var ct: i32[] = [];
    var i: i32 = 0;
    while (i < f.nvals) { ct = ct.push(0 - 1); i = i + 1; }
    var bi: i32 = 0;
    while (bi < f.blocks.len()) {
        var blk: SBlock = f.blocks[bi];
        var k: i32 = 0;
        while (k < blk.insts.len()) {
            var ins: SInst = blk.insts[k];
            if (ins.kind == "copy") { ct = env_set_at(ct, ins.result, ins.args[0]); }
            k = k + 1;
        }
        bi = bi + 1;
    }
    // resolved[i] = chase ct until a non-copy definition.
    var resolved: i32[] = [];
    i = 0;
    while (i < f.nvals) {
        var v: i32 = i;
        var guard: i32 = 0;
        while (ct[v] >= 0 && guard < 1000000) { v = ct[v]; guard = guard + 1; }
        resolved = resolved.push(v);
        i = i + 1;
    }
    // Rewrite operands through `resolved` and drop the copy nodes.
    var nblocks: SBlock[] = [];
    bi = 0;
    while (bi < f.blocks.len()) {
        var blk: SBlock = f.blocks[bi];
        var ninsts: SInst[] = [];
        var k: i32 = 0;
        while (k < blk.insts.len()) {
            var ins: SInst = blk.insts[k];
            if (ins.kind != "copy") { ninsts = ninsts.push(rewrite_args(ins, resolved)); }
            k = k + 1;
        }
        nblocks = nblocks.push(SBlock { id: blk.id, insts: ninsts, term: rewrite_term(blk.term, resolved), preds: blk.preds });
        bi = bi + 1;
    }
    return SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry };
}

// is_div_by_zero guards the folder against evaluating a /0 or %0 at
// compile time (which would crash the compiler) — such ops are left alone.
function is_div_by_zero(op: string, rhs: i32): boolean {
    if (rhs != 0) { return false; }
    return op == "/" || op == "%";
}

// const_fold collapses binary / unary instructions whose operands are
// known constants into a single const_int, iterating to a fixpoint so
// folded results feed further folding.
function const_fold(f: SFunc): SFunc {
    var changed: boolean = true;
    var rounds: i32 = 0;
    while (changed && rounds < 100000) {
        changed = false;
        rounds = rounds + 1;
        var cset: i32[] = zeros(f.nvals);
        var cval: i32[] = zeros(f.nvals);
        // Record current constants.
        var bi: i32 = 0;
        while (bi < f.blocks.len()) {
            var blk: SBlock = f.blocks[bi];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: SInst = blk.insts[k];
                if (ins.kind == "const_int" || ins.kind == "const_bool") {
                    cset = env_set_at(cset, ins.result, 1);
                    cval = env_set_at(cval, ins.result, ins.imm);
                }
                k = k + 1;
            }
            bi = bi + 1;
        }
        // Fold const-operand arithmetic.
        var nblocks: SBlock[] = [];
        bi = 0;
        while (bi < f.blocks.len()) {
            var blk: SBlock = f.blocks[bi];
            var ninsts: SInst[] = [];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: SInst = blk.insts[k];
                var folded: SInst = ins;
                if (ins.kind == "binary" && cset[ins.args[0]] == 1 && cset[ins.args[1]] == 1) {
                    var l: i32 = cval[ins.args[0]];
                    var r: i32 = cval[ins.args[1]];
                    if (!is_div_by_zero(ins.str, r)) {
                        var noargs: i32[] = [];
                        folded = SInst { kind: "const_int", result: ins.result, args: noargs, imm: eval_binary(ins.str, l, r), str: "" };
                        changed = true;
                    }
                } else if (ins.kind == "unary" && cset[ins.args[0]] == 1) {
                    var x: i32 = cval[ins.args[0]];
                    var nv: i32 = 0;
                    if (ins.str == "-") { nv = 0 - x; } else { if (x == 0) { nv = 1; } else { nv = 0; } }
                    var noargs2: i32[] = [];
                    folded = SInst { kind: "const_int", result: ins.result, args: noargs2, imm: nv, str: "" };
                    changed = true;
                }
                ninsts = ninsts.push(folded);
                k = k + 1;
            }
            nblocks = nblocks.push(SBlock { id: blk.id, insts: ninsts, term: blk.term, preds: blk.preds });
            bi = bi + 1;
        }
        f = SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry };
    }
    return f;
}

// term_targets reports whether a terminator branches to block id `to`.
function term_targets(t: STerm, to: i32): boolean {
    if (t.kind == "br") { return t.target == to; }
    if (t.kind == "brif") { return t.t == to || t.f == to; }
    return false;
}

// reachable_ids returns the block ids reachable from the entry by
// following terminators (a CFG walk; ret has no successors).
function reachable_ids(f: SFunc): i32[] {
    var seen: i32[] = [f.blocks[f.entry].id];
    var work: i32[] = [f.blocks[f.entry].id];
    var guard: i32 = 0;
    while (work.len() > 0 && guard < 1000000) {
        guard = guard + 1;
        var id: i32 = work[work.len() - 1];
        var nw: i32[] = [];
        var w: i32 = 0;
        while (w < work.len() - 1) { nw = nw.push(work[w]); w = w + 1; }
        work = nw;
        var bi: i32 = block_index(f, id);
        if (bi >= 0) {
            var t: STerm = f.blocks[bi].term;
            if (t.kind == "br") { if (index_of_i32(seen, t.target) < 0) { seen = seen.push(t.target); work = work.push(t.target); } }
            else if (t.kind == "brif") {
                if (index_of_i32(seen, t.t) < 0) { seen = seen.push(t.t); work = work.push(t.t); }
                if (index_of_i32(seen, t.f) < 0) { seen = seen.push(t.f); work = work.push(t.f); }
            }
        }
    }
    return seen;
}

// branch_simplify folds a `brif` on a constant condition into an
// unconditional `br`, then prunes blocks no longer reachable from the
// entry. Removing a predecessor edge drops the matching operand from each
// successor phi (operands stay parallel to preds); a phi left with a
// single operand becomes a `copy` (which copy-propagation then removes).
function branch_simplify(f: SFunc): SFunc {
    var changed: boolean = true;
    var rounds: i32 = 0;
    while (changed && rounds < 100000) {
        changed = false;
        rounds = rounds + 1;

        // 1. Fold constant `brif` → `br`.
        var cset: i32[] = zeros(f.nvals);
        var cval: i32[] = zeros(f.nvals);
        var bi: i32 = 0;
        while (bi < f.blocks.len()) {
            var blk: SBlock = f.blocks[bi];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: SInst = blk.insts[k];
                if (ins.kind == "const_int" || ins.kind == "const_bool") {
                    cset = env_set_at(cset, ins.result, 1);
                    cval = env_set_at(cval, ins.result, ins.imm);
                }
                k = k + 1;
            }
            bi = bi + 1;
        }
        var folded_blocks: SBlock[] = [];
        bi = 0;
        while (bi < f.blocks.len()) {
            var blk: SBlock = f.blocks[bi];
            var t: STerm = blk.term;
            if (t.kind == "brif" && cset[t.cond] == 1) {
                var taken: i32 = t.f;
                if (cval[t.cond] != 0) { taken = t.t; }
                t = t_br(taken);
                changed = true;
            }
            folded_blocks = folded_blocks.push(SBlock { id: blk.id, insts: blk.insts, term: t, preds: blk.preds });
            bi = bi + 1;
        }
        f = SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: folded_blocks, entry: f.entry };

        // 2. Drop unreachable blocks and fix up survivor preds + phis.
        var reach: i32[] = reachable_ids(f);
        var nblocks: SBlock[] = [];
        bi = 0;
        while (bi < f.blocks.len()) {
            var blk: SBlock = f.blocks[bi];
            if (index_of_i32(reach, blk.id) < 0) { changed = true; bi = bi + 1; continue; }
            // Which pred edges still exist (reachable source that still
            // targets this block)? Keep those indices, drop the rest.
            var keep: i32[] = [];
            var pi: i32 = 0;
            while (pi < blk.preds.len()) {
                var p: i32 = blk.preds[pi];
                var psrc: i32 = block_index(f, p);
                var alive: boolean = index_of_i32(reach, p) >= 0 && psrc >= 0 && term_targets(f.blocks[psrc].term, blk.id);
                if (alive) { keep = keep.push(pi); }
                pi = pi + 1;
            }
            if (keep.len() != blk.preds.len()) { changed = true; }
            var npreds: i32[] = [];
            var ki: i32 = 0;
            while (ki < keep.len()) { npreds = npreds.push(blk.preds[keep[ki]]); ki = ki + 1; }
            // Prune phi operands to the surviving preds.
            var ninsts: SInst[] = [];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: SInst = blk.insts[k];
                if (ins.kind == "phi") {
                    var nargs: i32[] = [];
                    var ai: i32 = 0;
                    while (ai < keep.len()) { nargs = nargs.push(ins.args[keep[ai]]); ai = ai + 1; }
                    if (nargs.len() == 1) {
                        ins = SInst { kind: "copy", result: ins.result, args: nargs, imm: 0, str: "" };
                        changed = true;
                    } else {
                        ins = SInst { kind: "phi", result: ins.result, args: nargs, imm: ins.imm, str: ins.str };
                    }
                }
                ninsts = ninsts.push(ins);
                k = k + 1;
            }
            nblocks = nblocks.push(SBlock { id: blk.id, insts: ninsts, term: blk.term, preds: npreds });
            bi = bi + 1;
        }
        f = SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry };
    }
    return f;
}

// merge_blocks threads straight-line block pairs together: when a block B
// ends in `br T` and T's only predecessor is B, T's instructions and
// terminator are appended to B and T is deleted. This collapses the empty
// br-only blocks that branch_simplify leaves behind (and any other linear
// chain) into a single block. Because T has exactly one predecessor it
// carries no real phis (branch_simplify already turned any single-operand
// phi into a copy), so no phi rewiring is needed on the merge itself;
// blocks that branched to T have that pred relabelled to B.
function merge_blocks(f: SFunc): SFunc {
    var changed: boolean = true;
    var rounds: i32 = 0;
    while (changed && rounds < 100000) {
        changed = false;
        rounds = rounds + 1;
        // Find a mergeable pair B → T (B ends in `br T`, T != B, and T's
        // sole predecessor is B).
        var found: i32 = 0 - 1;
        var tid: i32 = 0 - 1;
        var bi: i32 = 0;
        while (bi < f.blocks.len()) {
            var b: SBlock = f.blocks[bi];
            if (b.term.kind == "br" && b.term.target != b.id) {
                var ti: i32 = block_index(f, b.term.target);
                if (ti >= 0) {
                    var tt: SBlock = f.blocks[ti];
                    if (tt.preds.len() == 1 && tt.preds[0] == b.id) {
                        found = bi;
                        tid = b.term.target;
                        bi = f.blocks.len();   // break
                    }
                }
            }
            bi = bi + 1;
        }
        if (found < 0) { return f; }

        var bb: SBlock = f.blocks[found];
        var tti: i32 = block_index(f, tid);
        var tb: SBlock = f.blocks[tti];
        // Append T's instructions to B; B inherits T's terminator.
        var merged_insts: SInst[] = bb.insts;
        var ii: i32 = 0;
        while (ii < tb.insts.len()) { merged_insts = merged_insts.push(tb.insts[ii]); ii = ii + 1; }
        var merged: SBlock = SBlock { id: bb.id, insts: merged_insts, term: tb.term, preds: bb.preds };

        // Rebuild: replace B with the merged block, drop T, and relabel any
        // pred reference to T (T's successors) over to B.
        var nblocks: SBlock[] = [];
        var k: i32 = 0;
        while (k < f.blocks.len()) {
            var blk: SBlock = f.blocks[k];
            if (blk.id == tid) { k = k + 1; continue; }   // drop T
            if (blk.id == bb.id) { blk = merged; }
            var np: i32[] = [];
            var p: i32 = 0;
            while (p < blk.preds.len()) {
                if (blk.preds[p] == tid) { np = np.push(bb.id); } else { np = np.push(blk.preds[p]); }
                p = p + 1;
            }
            nblocks = nblocks.push(SBlock { id: blk.id, insts: blk.insts, term: blk.term, preds: np });
            k = k + 1;
        }
        f = SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry };
        changed = true;
    }
    return f;
}

// count_blocks returns the number of blocks (tests assert block merging).
pub function count_blocks(f: SFunc): i32 { return f.blocks.len(); }

// dead_code_elim drops pure instructions (const / binary / unary / phi)
// whose result is never used, iterating to a fixpoint. Params and calls
// are always kept (calls may have side effects).
function dead_code_elim(f: SFunc): SFunc {
    var changed: boolean = true;
    var rounds: i32 = 0;
    while (changed && rounds < 100000) {
        changed = false;
        rounds = rounds + 1;
        // Mark every value referenced by a (currently present) instruction
        // operand or terminator.
        var used: i32[] = zeros(f.nvals);
        var bi: i32 = 0;
        while (bi < f.blocks.len()) {
            var blk: SBlock = f.blocks[bi];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: SInst = blk.insts[k];
                var ai: i32 = 0;
                while (ai < ins.args.len()) { used = env_set_at(used, ins.args[ai], 1); ai = ai + 1; }
                k = k + 1;
            }
            if (blk.term.kind == "ret") { used = env_set_at(used, blk.term.value, 1); }
            else if (blk.term.kind == "brif") { used = env_set_at(used, blk.term.cond, 1); }
            bi = bi + 1;
        }
        // Drop unused pure instructions.
        var nblocks: SBlock[] = [];
        bi = 0;
        while (bi < f.blocks.len()) {
            var blk: SBlock = f.blocks[bi];
            var ninsts: SInst[] = [];
            var k: i32 = 0;
            while (k < blk.insts.len()) {
                var ins: SInst = blk.insts[k];
                var keep: boolean = ins.kind == "param" || ins.kind == "call" || used[ins.result] == 1;
                if (keep) { ninsts = ninsts.push(ins); } else { changed = true; }
                k = k + 1;
            }
            nblocks = nblocks.push(SBlock { id: blk.id, insts: ninsts, term: blk.term, preds: blk.preds });
            bi = bi + 1;
        }
        f = SFunc { name: f.name, nparams: f.nparams, nvals: f.nvals, blocks: nblocks, entry: f.entry };
    }
    return f;
}

// count_insts totals the instructions across all blocks (used by tests to
// confirm the optimiser actually shrinks the IR).
pub function count_insts(f: SFunc): i32 {
    var n: i32 = 0;
    var bi: i32 = 0;
    while (bi < f.blocks.len()) {
        n = n + f.blocks[bi].insts.len();
        bi = bi + 1;
    }
    return n;
}

// ---- interpreter -------------------------------------------------------
// It walks the CFG block by block, resolving phi nodes against the block we
// arrived from (operand i of a phi flows in when control came from
// block.preds[i]). A shared value table (id → i32) persists across blocks.

function vtab_set(tab: i32[], id: i32, v: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < tab.len()) {
        if (i == id) { out = out.push(v); } else { out = out.push(tab[i]); }
        i = i + 1;
    }
    return out;
}

function block_index(f: SFunc, id: i32): i32 {
    var i: i32 = 0;
    while (i < f.blocks.len()) {
        if (f.blocks[i].id == id) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function pred_slot(blk: SBlock, prev: i32): i32 {
    var i: i32 = 0;
    while (i < blk.preds.len()) {
        if (blk.preds[i] == prev) { return i; }
        i = i + 1;
    }
    return 0;
}

function eval_binary(op: string, l: i32, r: i32): i32 {
    if (op == "+") { return l + r; }
    if (op == "-") { return l - r; }
    if (op == "*") { return l * r; }
    if (op == "/") { return l / r; }
    if (op == "%") { return l % r; }
    if (op == "==") { if (l == r) { return 1; } return 0; }
    if (op == "!=") { if (l != r) { return 1; } return 0; }
    if (op == "<") { if (l < r) { return 1; } return 0; }
    if (op == "<=") { if (l <= r) { return 1; } return 0; }
    if (op == ">") { if (l > r) { return 1; } return 0; }
    if (op == ">=") { if (l >= r) { return 1; } return 0; }
    if (op == "&&") { if (l != 0 && r != 0) { return 1; } return 0; }
    if (op == "||") { if (l != 0 || r != 0) { return 1; } return 0; }
    if (op == "&") { return l & r; }
    if (op == "|") { return l | r; }
    if (op == "^") { return l ^ r; }
    if (op == "<<") { return l << r; }
    if (op == ">>") { return l >> r; }
    return 0;
}

pub function eval_func(f: SFunc, args: i32[]): i32 {
    var tab: i32[] = [];
    var i: i32 = 0;
    while (i < f.nvals) { tab = tab.push(0); i = i + 1; }

    var cur_id: i32 = f.blocks[f.entry].id;
    var prev_id: i32 = 0 - 1;
    var guard: i32 = 0;
    while (guard < 1000000) {
        guard = guard + 1;
        var bi: i32 = block_index(f, cur_id);
        if (bi < 0) { return 0; }
        var blk: SBlock = f.blocks[bi];
        var slot: i32 = pred_slot(blk, prev_id);
        var k: i32 = 0;
        while (k < blk.insts.len()) {
            var inst: SInst = blk.insts[k];
            if (inst.kind == "param") {
                var pv: i32 = 0;
                if (inst.imm < args.len()) { pv = args[inst.imm]; }
                tab = vtab_set(tab, inst.result, pv);
            } else if (inst.kind == "const_int" || inst.kind == "const_bool") {
                tab = vtab_set(tab, inst.result, inst.imm);
            } else if (inst.kind == "copy") {
                tab = vtab_set(tab, inst.result, tab[inst.args[0]]);
            } else if (inst.kind == "phi") {
                tab = vtab_set(tab, inst.result, tab[inst.args[slot]]);
            } else if (inst.kind == "binary") {
                tab = vtab_set(tab, inst.result, eval_binary(inst.str, tab[inst.args[0]], tab[inst.args[1]]));
            } else if (inst.kind == "unary") {
                var x: i32 = tab[inst.args[0]];
                if (inst.str == "-") { tab = vtab_set(tab, inst.result, 0 - x); }
                else { if (x == 0) { tab = vtab_set(tab, inst.result, 1); } else { tab = vtab_set(tab, inst.result, 0); } }
            }
            k = k + 1;
        }
        if (blk.term.kind == "ret") { return tab[blk.term.value]; }
        if (blk.term.kind == "br") { prev_id = cur_id; cur_id = blk.term.target; }
        else if (blk.term.kind == "brif") {
            prev_id = cur_id;
            if (tab[blk.term.cond] != 0) { cur_id = blk.term.t; } else { cur_id = blk.term.f; }
        } else {
            return 0;   // no terminator (shouldn't happen for ok funcs)
        }
    }
    return 0;
}

// ---- text printer (for golden tests / debugging) -----------------------

function int_str(n: i32): string {
    if (n == 0) { return "0"; }
    var neg: boolean = false;
    var x: i32 = n;
    if (x < 0) { neg = true; x = 0 - x; }
    var digits: string = "0123456789";
    var s: string = "";
    while (x > 0) { s = digits[x % 10 : x % 10 + 1] + s; x = x / 10; }
    if (neg) { return "-" + s; }
    return s;
}

pub function print_func(f: SFunc): string {
    var out: string = "func " + f.name + " {\n";
    var bi: i32 = 0;
    while (bi < f.blocks.len()) {
        var blk: SBlock = f.blocks[bi];
        out = out + "  b" + int_str(blk.id) + ":\n";
        var k: i32 = 0;
        while (k < blk.insts.len()) {
            var ins: SInst = blk.insts[k];
            out = out + "    v" + int_str(ins.result) + " = " + ins.kind;
            if (ins.kind == "const_int" || ins.kind == "const_bool" || ins.kind == "param") {
                out = out + " " + int_str(ins.imm);
            }
            if (ins.kind == "binary" || ins.kind == "unary" || ins.kind == "call") {
                out = out + " " + ins.str;
            }
            var ai: i32 = 0;
            while (ai < ins.args.len()) {
                out = out + " v" + int_str(ins.args[ai]);
                ai = ai + 1;
            }
            out = out + "\n";
            k = k + 1;
        }
        if (blk.term.kind == "ret") { out = out + "    ret v" + int_str(blk.term.value) + "\n"; }
        else if (blk.term.kind == "br") { out = out + "    br b" + int_str(blk.term.target) + "\n"; }
        else if (blk.term.kind == "brif") { out = out + "    brif v" + int_str(blk.term.cond) + " b" + int_str(blk.term.t) + " b" + int_str(blk.term.f) + "\n"; }
        bi = bi + 1;
    }
    return out + "}\n";
}
