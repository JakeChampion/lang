// Typed semantic values before RC. Reuse SSA's graph, never lift ownership
// facts from physical load/store/alloc or runtime helper names.
import "./ssa";
import "./util";
import "./ssalive";
import "./ssadeps";
import "./semtypes";
import "./semrecords";
import "./typeinfo";

pub struct Func {
    graph: ssa.SFunc,
    values: typeinfo.Type[],
    params: typeinfo.Type[],
    result: typeinfo.Type,
    records: semrecords.Record[],
    enums: semrecords.Enum[],
    calls: Contract[],
    envs: EnvRow[],
    anchors: Anchor[],
    // (dyn type, concrete) for every record and enum implementing the type's
    // whole trait set; a dyn release dispatches on its box's shape over these.
    dyns: EnvRow[],
    // The dyn types one of whose implementations is generic: its instances
    // are not enumerated, so a release could not find their children.
    open_dyns: typeinfo.Type[]
}

// The parameter whose storage a callee's result reads, so a caller keeps that
// argument alive while the result lives: the callee returns a view of it, or
// something holding one. `param` is -1 for a result whose views read nothing
// the caller passed. Read off the whole module (`semsource.anchor_module`).
pub struct Anchor { name: string, param: i32 }

// The anchor of the callee named `name`, -1 for none, or -2 when it has no row.
pub function anchor_of(anchors: Anchor[], name: string): i32 {
    for a in anchors { if (a.name == name) { return a.param; } }
    return 0 - 2;
}

// Which environments a function value of a given type can be carrying. A
// function value's static type names no captures, so releasing one matches the
// box against these at run time — and the set has to be a property of the TYPE
// rather than of whichever frame is doing the releasing, because the drop
// helper for a record holding a function value is emitted by every function
// that mentions that record and the copies must agree byte for byte
// (ssarc.merge_helpers refuses a disagreement). Read off the module's whole
// contract table, and closed over the frame's schema table, so a frame that
// reaches the type only through a record field, or nested in a container a
// field holds, lists the same environments as one that names it.
pub struct EnvRow { fn_ty: typeinfo.Type, env_ty: typeinfo.Type }

// A callee's declared signature as this function sees it: exact parameter
// and result types, and one mode per parameter (the unit planner's value,
// borrow or counted). A call is verified against its contract alone; the
// callee's body is never consulted.
pub struct Contract { name: string, params: typeinfo.Type[], modes: i32[], result: typeinfo.Type }

pub function find_contract(calls: Contract[], name: string): i32 {
    var i: i32 = 0;
    while (i < calls.len()) {
        if (calls[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

pub struct Analysis {
    ok: boolean,
    why: string,
    dependencies: i32[][],
    flow: ssalive.Flow
}

// Negative tags belong to this semantic phase. Physical SSA consumers do not
// implement them. Existing parameter, copy, phi and scalar tags are reused.
pub function array_new(): i32 { return 0 - 1; }
pub function tuple_new(): i32 { return 0 - 2; }
pub function array_get(): i32 { return 0 - 3; }
pub function tuple_get(): i32 { return 0 - 4; }
pub function record_new(): i32 { return 0 - 5; }
pub function record_get(): i32 { return 0 - 6; }
pub function call(): i32 { return 0 - 7; }
pub function variant_new(): i32 { return 0 - 8; }
pub function variant_is(): i32 { return 0 - 9; }
pub function variant_get(): i32 { return 0 - 10; }
pub function variant_up(): i32 { return 0 - 11; }
pub function variant_as(): i32 { return 0 - 12; }
pub function length(): i32 { return 0 - 13; }
pub function append(): i32 { return 0 - 14; }
pub function slice(): i32 { return 0 - 15; }
pub function str_index(): i32 { return 0 - 16; }
pub function cast(): i32 { return 0 - 17; }
pub function str_as(): i32 { return 0 - 18; }
pub function with(): i32 { return 0 - 19; }
pub function closure_new(): i32 { return 0 - 20; }
pub function call_value(): i32 { return 0 - 21; }
pub function cell_new(): i32 { return 0 - 22; }
pub function cell_get(): i32 { return 0 - 23; }
pub function cell_set(): i32 { return 0 - 24; }
pub function map_new(): i32 { return 0 - 25; }
pub function map_insert(): i32 { return 0 - 26; }
pub function map_has(): i32 { return 0 - 27; }
pub function map_get_or(): i32 { return 0 - 28; }
pub function map_len(): i32 { return 0 - 29; }
pub function map_get(): i32 { return 0 - 30; }
// A COLUMN SNAPSHOT: `keys` answers the key column as an array, `values` the
// value column. The array is fresh, but whether it OWNS its elements is the
// column's business — the runtime copies a string column with a per-element
// retain, an i32 column holds no references at all, and every other element
// type is handed back as a raw ALIAS of the map's own elements. semsource
// admits only the first two, so a result of these is owned whole.
pub function map_keys(): i32 { return 0 - 31; }
pub function map_values(): i32 { return 0 - 32; }
// `without` removes one entry and answers the map paired with whether the key
// was there; `cleared` answers a fresh empty map of the same shape, reading
// nothing from the receiver.
pub function map_delete(): i32 { return 0 - 33; }
pub function map_cleared(): i32 { return 0 - 34; }

// The zero of a type: what a declaration the defer desugar lifted to the top
// of its scope starts at, before the assignment left behind at the declaration
// site runs. A reference type's zero is the null word — it allocates nothing,
// and the frame's release of it is the null guard every drop helper already
// carries — so the lift costs a slot rather than a box.
pub function zero(): i32 { return 0 - 35; }
// `s.bytes()` / `s.as_bytes()`: one text operand's bytes as a FRESH `u8[]`, a
// slot per byte. Not a window — the slot-array model has no zero-copy view, so
// the AST lowering allocates here too (ir.op_str_bytes) and the result is a
// unit of this frame like any other fresh container.
pub function str_bytes(): i32 { return 0 - 36; }
// `xs.sum()` / `xs.product()` over an `i32[]`: the array is read and the answer
// is a fresh i32 that owns nothing. `xs.join(sep)` over a `string[]` reads both
// operands and answers a fresh string. Each is one runtime helper, the same one
// the AST lowering calls.
pub function arr_sum(): i32 { return 0 - 37; }
pub function arr_product(): i32 { return 0 - 38; }
pub function arr_join(): i32 { return 0 - 39; }
// `xs[lo:hi]` on an array of scalars: a fresh array holding a copy of the
// window, bounds-checked by the runtime. An array whose elements own something
// is not admitted, since the runtime copies the words without a retain.
pub function arr_slice(): i32 { return 0 - 40; }

// Map iteration. `map_iter` hands back the cursor: a bare 16-byte block
// (`__fern_alloc`, no rc header) holding the map's address and an index, so it
// is an address the frame never counts and never releases, and every read
// through it reads the map's own columns. The other four take that cursor —
// `mapiter_has_next` answers the bound, `mapiter_key` and `mapiter_value` load
// the element at the cursor WITHOUT retaining it, and `mapiter_advance` bumps
// the stored index in place and answers void.
pub function map_iter(): i32 { return 0 - 41; }
pub function mapiter_has_next(): i32 { return 0 - 42; }
pub function mapiter_key(): i32 { return 0 - 43; }
pub function mapiter_value(): i32 { return 0 - 44; }
pub function mapiter_advance(): i32 { return 0 - 45; }
// A `dyn Trait` value is the struct or enum box it was widened from, whose
// shape at offset 0 is what a dispatch reads. The widening is a projection of
// that box, so a holder of the result owns the box's unit, and its release
// dispatches on the shape to the concrete's drop (`Func.dyns`).
pub function dyn_up(): i32 { return 0 - 46; }
// A scalar or string widened to dyn has no shape of its own, so it is boxed:
// a fresh cell laid out as a one-field record, whose shape is the primitive's
// name (`str`) and whose field holds the value, owning a unit of a string.
pub function dyn_box(): i32 { return 0 - 47; }
pub function is_map_iter_op(kind: i32): boolean {
    return kind == map_iter() || kind == mapiter_has_next() || kind == mapiter_key()
        || kind == mapiter_value() || kind == mapiter_advance();
}

// A refused analysis, for a caller holding one slot per function and none to
// put where a body was never produced.
pub function refused_analysis(why: string): Analysis { return failed(why); }

function failed(why: string): Analysis {
    return Analysis { ok: false, why: why, dependencies: [], flow: ssalive.Flow { ok: false, why: why, words: 0, live_in: [], live_out: [], at: [] } };
}

function empty_dependencies(n: i32): i32[][] {
    var out: i32[][] = [];
    var i: i32 = 0;
    while (i < n) { out = out.append([]); i = i + 1; }
    return out;
}

pub function is_i32(t: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(i) = t { return i.width == 32 && !i.unsigned && !i.is_char; }
    return false;
}

// One unsigned byte. It occupies an i32-shaped slot on every backend, so it costs
// no new physical representation; what distinguishes it is the range, which
// each operator whose result can leave it wraps back.
pub function is_u8(t: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(i) = t { return i.width == 8 && i.unsigned && !i.is_char; }
    return false;
}

// The unsigned 32-bit integer. Like the byte it occupies an i32-shaped slot, but
// over the whole 32-bit range, so a value past 2^31 fills the slot's sign bit
// and every operator that reads one takes its unsigned form.
pub function is_u32(t: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(i) = t { return i.width == 32 && i.unsigned && !i.is_char; }
    return false;
}

// A signed 64-bit integer. Unlike the byte it needs a slot of its own, which
// only wasm spells out; the register backends already give every value a
// 64-bit one.
pub function is_i64(t: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(i) = t { return i.width == 64 && !i.unsigned && !i.is_char; }
    return false;
}

// The unsigned 64-bit integer: the i64's slot, read without a sign bit.
pub function is_u64(t: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(i) = t { return i.width == 64 && i.unsigned && !i.is_char; }
    return false;
}

// The types that need a 64-bit slot of their own, which only wasm spells out.
pub function is_wide(t: typeinfo.Type): boolean { return is_i64(t) || is_u64(t); }

// The pointer-width unsigned integer: an address, occupying the narrow slot,
// which is the address's own width on every backend — 32 bits on wasm, the
// whole 64-bit slot on the register backends. It converts to and from the
// 64-bit integers and nothing else: an operator at it would run at the i32's
// width on a register backend, which is not the address's.
pub function is_usize(t: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(i) = t { return i.width == typeinfo.width_ptr() && i.unsigned && !i.is_char; }
    return false;
}

// The integer types read without a sign bit. It is what a widening extends by
// and which form of the sign-reading operators — the orderings, the right
// shift, division and remainder — the operand takes.
pub function is_unsigned_int(t: typeinfo.Type): boolean { return is_u8(t) || is_u32(t) || is_u64(t) || is_usize(t); }

// The 64-bit float. Like the i64 it occupies a slot of its own that only wasm
// spells out; its operators are the float opcodes, which never wrap.
pub function is_f64(t: typeinfo.Type): boolean {
    if let typeinfo.TypeFloat(fl) = t { return fl.width == 64 && !fl.polymorphic; }
    return false;
}

// The 32-bit float occupies the f64's slot at single precision: every value of
// the type is an f64 the f32 round-trip has already rounded, so the width is
// a rounding applied wherever a value of the type is made — a constant, a
// conversion, an operator's result — rather than a slot of its own.
pub function is_f32(t: typeinfo.Type): boolean {
    if let typeinfo.TypeFloat(fl) = t { return fl.width == 32 && !fl.polymorphic; }
    return false;
}

pub function is_float(t: typeinfo.Type): boolean { return is_f64(t) || is_f32(t); }

// The integer types this vocabulary admits. An operator is written for one of
// them at a time: both operands carry the same type and so does the result.
// The checker auto-widens the narrower side of a mixed-width operator and the
// tree this producer reads is not rewritten with that conversion, so the
// producer inserts it: at the pointer width, where the checker's own arm
// widens whichever side is narrower. Every other mixed pair is refused here
// rather than guessed at.
pub function is_integer(t: typeinfo.Type): boolean {
    return is_i32(t) || is_u8(t) || is_u32(t) || is_i64(t) || is_u64(t) || is_usize(t);
}

// The types whose value is a POINTER: a box this vocabulary counts, or a view
// of one. It is the address's counterpart — the two occupy the same slot on
// every backend, which is what makes a cast between them a reinterpretation
// rather than a conversion — and it is also the list whose counted layout the
// ownership planner defines, so ssaunits reads it from here rather than
// keeping a second copy.
pub function reference(t: typeinfo.Type): boolean {
    // A stream handle wears a record's nominal but holds a descriptor, so it
    // occupies a scalar slot and there is no address to count.
    if (semtypes.is_handle(t)) { return false; }
    // A map cursor wears one too and IS an address, but its block carries no rc
    // header, so there is no count either: it is lent for the map's lifetime and
    // the frame neither takes a unit of it nor gives one back.
    if (semtypes.is_map_iter(t)) { return false; }
    if let typeinfo.TypeString(_) = t { return true; }
    if let typeinfo.TypeArray(_) = t { return true; }
    if let typeinfo.TypeTuple(_) = t { return true; }
    if let typeinfo.TypeStruct(_) = t { return true; }
    if let typeinfo.TypeUnion(_) = t { return true; }
    if let typeinfo.TypeFunc(_) = t { return true; }
    if let typeinfo.TypeMap(_) = t { return true; }
    if let typeinfo.TypeDyn(_) = t { return true; }
    return false;
}

// A constant whose value has no i32 immediate to fit in carries the literal's
// SOURCE TEXT instead, which the backends splice into an immediate of the
// right width. The 64-bit types do not fit the immediate at all, and neither
// does a u32 past 2^31 — so the u32 takes the text form at every value rather
// than at some of them.
pub function text_constant(t: typeinfo.Type): boolean { return is_wide(t) || is_u32(t); }

function is_bool(t: typeinfo.Type): boolean {
    if let typeinfo.TypeBool(_) = t { return true; }
    return false;
}

function is_void(t: typeinfo.Type): boolean {
    if let typeinfo.TypeVoid(_) = t { return true; }
    return false;
}

// An owned string, whose box holds its bytes.
pub function is_string(t: typeinfo.Type): boolean {
    if let typeinfo.TypeString(s) = t { return s.tag == 0; }
    return false;
}

// A string view (the checker's `str`): a box of its own over ANOTHER string's
// bytes, so it is released by the helper that frees the box alone.
pub function is_view(t: typeinfo.Type): boolean {
    if let typeinfo.TypeString(s) = t { return s.tag == 1; }
    return false;
}

// Either string type. A read of the bytes — the length, a byte, a window, an
// operator — is blind to which box holds them.
pub function is_text(t: typeinfo.Type): boolean { return is_string(t) || is_view(t); }

// A unicode scalar. Every integer predicate here excludes it, so without a key
// of its own it spells what the fall-through leaf does.
pub function is_char(t: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(i) = t { return i.is_char; }
    return false;
}

// A function value: the env box a closure is carried in.
pub function is_dyn(t: typeinfo.Type): boolean {
    if let typeinfo.TypeDyn(_) = t { return true; }
    return false;
}

// A method call on a dyn receiver names its contract `dyn <method>|<traits>`,
// a spelling no declaration can take, whose tail is the tag `ir.op_dyn_dispatch`
// carries. The contract is the implementations' shared signature with the dyn
// type at the receiver.
pub function dyn_call_name(method: string, traits: string[]): string {
    var out: string = "dyn " + method;
    var i: i32 = 0;
    while (i < traits.len()) {
        if (i == 0) { out = out + "|"; } else { out = out + ","; }
        out = out + traits[i];
        i = i + 1;
    }
    return out;
}
pub function is_dyn_call(name: string): boolean { return name.len() > 4 && slice_unchecked(name, 0, 4) == "dyn "; }

function dyn_call_bar(name: string): i32 {
    var i: i32 = 4;
    while (i < name.len() && name[i] != b'|') { i = i + 1; }
    return i;
}

pub function dyn_call_method(name: string): string { return slice_unchecked(name, 4, dyn_call_bar(name)) + ""; }

pub function dyn_call_traits(name: string): string[] {
    var out: string[] = [];
    var start: i32 = dyn_call_bar(name) + 1;
    var k: i32 = start;
    while (k <= name.len()) {
        if (k == name.len() || name[k] == b',') {
            if (k > start) { out = out.append(slice_unchecked(name, start, k) + ""); }
            start = k + 1;
        }
        k = k + 1;
    }
    return out;
}

pub function is_func(t: typeinfo.Type): boolean {
    if let typeinfo.TypeFunc(_) = t { return true; }
    return false;
}

pub function is_map(t: typeinfo.Type): boolean {
    if let typeinfo.TypeMap(_) = t { return true; }
    return false;
}

pub function map_key(t: typeinfo.Type): typeinfo.Type {
    if let typeinfo.TypeMap(m) = t { return m.key; }
    return typeinfo.unchecked();
}

pub function map_value(t: typeinfo.Type): typeinfo.Type {
    if let typeinfo.TypeMap(m) = t { return m.value; }
    return typeinfo.unchecked();
}

// The map shapes this boundary admits: a string, narrow integer or keyed KEY
// column over a value column the runtime's free family releases — a narrow
// scalar column freed whole, or a counted column walked entry by entry. A
// string key column is walked through the string dec, a keyed one through the
// function the physical lowering names for the key type; an integer one is
// freed whole.
pub function is_supported_map(t: typeinfo.Type): boolean {
    if (!is_map(t)) { return false; }
    if (!is_string(map_key(t)) && !narrow_map_value(map_key(t)) && !keyed_map_key(map_key(t))) { return false; }
    return narrow_map_value(map_value(t)) || counted_map_value(map_value(t));
}

// A key column of boxes: a record or a union the runtime hashes and compares
// through the key type's derived `hash` and `eq` — the checker admits no
// other nominal as a map key — and owns one unit of per entry. A generic
// instance is spelled with its arguments, which the derived methods are not
// named by here, so only an argument-free nominal is admitted.
pub function keyed_map_key(k: typeinfo.Type): boolean {
    if (semtypes.is_handle(k) || semtypes.is_map_iter(k) || semtypes.is_env(k) || semtypes.is_cell(k)) { return false; }
    if let typeinfo.TypeStruct(r) = k { return r.args.len() == 0; }
    if let typeinfo.TypeUnion(u) = k { return u.args.len() == 0; }
    return false;
}

// The nominal a keyed column's derived methods hang off: `K.hash` and `K.eq`
// are the receiver methods `@derive(cmp.Eq, cmp.Hash)` synthesises on it.
pub function keyed_map_key_name(k: typeinfo.Type): string {
    if let typeinfo.TypeStruct(r) = k { return r.name; }
    if let typeinfo.TypeUnion(u) = k { return u.name; }
    return "";
}

// A column whose snapshot is a fresh array owning one unit of every element:
// a string column and a column of boxes are copied with a per-element retain,
// and a column of narrow scalars — `i32`, `u8`, `u32`, `bool`, each an
// i32-shaped cell — holds no references. Every other element — a wide scalar,
// a function value, a map — would come back aliasing the map's own.
pub function retained_column(elem: typeinfo.Type): boolean {
    return is_string(elem) || narrow_column(elem) || keyed_map_key(elem) || counted_map_value(elem);
}

function narrow_column(t: typeinfo.Type): boolean {
    return is_i32(t) || is_u8(t) || is_u32(t) || is_bool(t);
}

// A value column the map releases by freeing the buffer alone.
pub function narrow_map_value(v: typeinfo.Type): boolean {
    return is_bool(v) || (is_integer(v) && !is_wide(v));
}

// A value column the map owns a unit of per entry, released with the map: a
// string column and a column of string arrays, which the runtime frees
// deeply itself, and a column of boxes, which it releases by calling the
// function the physical lowering names for the value type.
pub function counted_map_value(v: typeinfo.Type): boolean {
    return is_string(v) || is_string_array(v) || boxed_map_value(v);
}

pub function is_string_array(v: typeinfo.Type): boolean {
    if let typeinfo.TypeArray(a) = v { return is_string(a.elem); }
    return false;
}

// A value column whose entries are boxes of a shape the runtime does not
// know: a record, a union, an array of anything but strings, a tuple. A
// function value is lent everywhere here and owned nowhere, so a column of
// them has no unit to release; a map's box carries no count on the register
// backends, so a read of a column of them has nothing to retain. Both stay
// refused.
pub function boxed_map_value(v: typeinfo.Type): boolean {
    return reference(v) && !is_string(v) && !is_string_array(v) && !is_func(v) && !is_map(v);
}

pub function func_params(t: typeinfo.Type): typeinfo.Type[] {
    if let typeinfo.TypeFunc(fn) = t { return fn.param_types; }
    return [];
}

// The CONSUMING slots a function type spells. A caller hands its unit over at
// one of them and takes back nothing to release; every other reference
// argument of a function value is lent.
pub function func_param_own(t: typeinfo.Type, i: i32): boolean {
    if let typeinfo.TypeFunc(fn) = t { return typeinfo.fn_own_at(fn, i); }
    return false;
}

pub function func_result(t: typeinfo.Type): typeinfo.Type {
    if let typeinfo.TypeFunc(fn) = t { return fn.ret_type; }
    return typeinfo.unchecked();
}

// A closure body's first parameter is the environment it reads its captures
// out of: the box itself — a bare array of i32-shaped words when the body
// captures nothing, and otherwise the environment record naming the captures
// (`semtypes.is_env`).
pub function closure_env(c: Contract): boolean {
    if (c.params.len() == 0) { return false; }
    if let typeinfo.TypeArray(a) = c.params[0] { return semtypes.equal(a.elem, env_word()); }
    return semtypes.is_env(c.params[0]);
}

pub function env_type(body: string, captures: typeinfo.Type[]): typeinfo.Type {
    return typeinfo.TypeStruct { name: semtypes.env_prefix() + body, args: captures };
}

// The captures a body's environment holds, in slot order after the address.
pub function closure_captures(c: Contract): typeinfo.Type[] {
    if (c.params.len() == 0) { return []; }
    return semtypes.env_captures(c.params[0]);
}

function env_word(): typeinfo.Type { return typeinfo.TypeI32 { width: 32, unsigned: false, is_char: false }; }

// The type a closure over `c` hands out: what its body promises minus the
// environment parameter, which the box supplies rather than the caller.
pub function closure_type(c: Contract): typeinfo.Type {
    var params: typeinfo.Type[] = [];
    var owns: boolean[] = [];
    var i: i32 = 1;
    while (i < c.params.len()) {
        params = params.append(c.params[i]);
        owns = owns.append(consuming_mode(c.modes, i, c.params[i]));
        i = i + 1;
    }
    return typeinfo.TypeFunc { param_types: params, param_own: typeinfo.own_flags(owns, params), ret_type: c.result, params_known: true };
}

// The unit planner's three modes. ssaunits reads this module, so the constants
// are spelled here and that pass's own accessors return them.
pub function value_mode(): i32 { return 1; }
pub function borrow_mode(): i32 { return 2; }
pub function counted_mode(): i32 { return 3; }

// A body's declared mode says what the box it is wrapped in promises: a counted
// parameter is a CONSUMING slot, and the function type the box hands out has to
// spell it or the two sides disagree about who releases the argument. A scalar
// carries no unit, so `typeinfo.own_flags` drops the flag there whichever side
// built it.
function consuming_mode(modes: i32[], i: i32, t: typeinfo.Type): boolean {
    if (i >= modes.len()) { return false; }
    return modes[i] == counted_mode() && typeinfo.ownable(t);
}

function parameter_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 0 || ins.result != ins.imm || !semtypes.equal(result, f.params[ins.imm])) { return "parameter type or identity"; }
    return "";
}

function copy_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if ((ins.kind_tag == 7 && ins.args.len() != 1) || (ins.kind_tag == 8 && ins.args.len() == 0)) { return "copy or phi arity"; }
    for arg in ins.args { if (!semtypes.equal(result, f.values[arg])) { return "copy or phi type"; } }
    return "";
}

// A narrow signed integer constant carries its value in the instruction's i32
// immediate, and the physical form pushes it with no mask, so its type's range
// has to hold HERE rather than be wrapped later. A constant with no such
// immediate to fit in (text_constant) carries the literal's SOURCE TEXT instead
// — the form the backends splice straight into an immediate of its own width,
// and the one the AST lowering already uses for the same literal.
function integer_constant_error(ins: ssa.SInst, result: typeinfo.Type): string {
    if (!is_integer(result) && !is_char(result)) { return "integer constant type"; }
    if (text_constant(result)) {
        if (ins.str == "" || ins.imm != 0) { return "constant needs its literal text"; }
        return "";
    }
    if (ins.str != "") { return "narrow constant carries text"; }
    if (is_u8(result) && (ins.imm < 0 || ins.imm > 255)) { return "integer constant range"; }
    return "";
}

// A float constant is a literal the backends splice as its source text, so
// like a wide integer it carries the text and no immediate.
function float_constant_error(ins: ssa.SInst): string {
    if (ins.str == "" || ins.imm != 0) { return "float constant needs its literal text"; }
    return "";
}

function constant_error(ins: ssa.SInst, result: typeinfo.Type): string {
    if (ins.args.len() != 0) { return "constant arity"; }
    if (ins.kind_tag == 1 && is_float(result)) { return float_constant_error(ins); }
    if (ins.kind_tag == 1) { return integer_constant_error(ins, result); }
    if (ins.kind_tag == 2 && (!is_bool(result) || (ins.imm != 0 && ins.imm != 1))) { return "boolean constant type or value"; }
    if (ins.kind_tag == 5 && !is_text(result)) { return "string constant type"; }
    return "";
}

function array_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if let typeinfo.TypeArray(a) = result {
        for arg in ins.args { if (!semtypes.equal(a.elem, f.values[arg])) { return "array element type"; } }
        return "";
    }
    return "array construction type";
}

function tuple_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if let typeinfo.TypeTuple(tup) = result {
        if (ins.args.len() != tup.elements.len()) { return "tuple construction arity"; }
        var i: i32 = 0;
        while (i < ins.args.len()) {
            if (!semtypes.equal(tup.elements[i], f.values[ins.args[i]])) { return "tuple element type"; }
            i = i + 1;
        }
        return "";
    }
    return "tuple construction type";
}

function array_projection_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 2) { return "array projection arity"; }
    if (!is_i32(f.values[ins.args[1]])) { return "array index type"; }
    if let typeinfo.TypeArray(a) = f.values[ins.args[0]] {
        if (!semtypes.equal(a.elem, result)) { return "array projection type"; }
        return "";
    }
    return "array container type";
}

function tuple_projection_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "tuple projection arity"; }
    if let typeinfo.TypeTuple(tup) = f.values[ins.args[0]] {
        if (ins.imm < 0 || ins.imm >= tup.elements.len()) { return "tuple projection index"; }
        if (!semtypes.equal(tup.elements[ins.imm], result)) { return "tuple projection type"; }
        return "";
    }
    return "tuple container type";
}

function record_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    var at: i32 = semrecords.find(f.records, result);
    if (at < 0) { return "missing record construction schema"; }
    var fields: semrecords.Field[] = f.records[at].fields;
    if (ins.args.len() != fields.len()) { return "record construction arity"; }
    var i: i32 = 0;
    while (i < fields.len()) {
        if (!semtypes.equal(fields[i].ty, f.values[ins.args[i]])) { return "record field type"; }
        i = i + 1;
    }
    return "";
}

// One element pushed onto a counted array. The array the caller gets back is
// the receiver's box when its unit was the only one and a fresh copy
// otherwise, so the receiver's unit is handed over rather than read.
function append_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 2) { return "append arity"; }
    var recv: typeinfo.Type = f.values[ins.args[0]];
    if (!semtypes.equal(recv, result)) { return "append result type"; }
    if let typeinfo.TypeArray(a) = recv {
        if (!semtypes.equal(a.elem, f.values[ins.args[1]])) { return "append element type"; }
        return "";
    }
    return "append container type";
}

// One element of a counted array replaced. The array handed back is the
// receiver's own box when its unit was the only one and a fresh copy
// otherwise, so the receiver's unit is handed over as an append's is; the
// index is read, and the value is held by the array handed back.
function with_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 3) { return "with arity"; }
    var recv: typeinfo.Type = f.values[ins.args[0]];
    if (!semtypes.equal(recv, result)) { return "with result type"; }
    if (!is_i32(f.values[ins.args[1]])) { return "with index type"; }
    if let typeinfo.TypeArray(a) = recv {
        if (!semtypes.equal(a.elem, f.values[ins.args[2]])) { return "with element type"; }
        return "";
    }
    return "with container type";
}

// A counted container's element count. The receiver is read, not consumed,
// and the i32 it hands back anchors nothing.
function length_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "length arity"; }
    if (!is_i32(result)) { return "length result type"; }
    var recv: typeinfo.Type = f.values[ins.args[0]];
    if let typeinfo.TypeArray(_) = recv { return ""; }
    if (is_text(recv)) { return ""; }
    return "length container type";
}

function record_projection_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "record projection arity"; }
    var at: i32 = semrecords.find(f.records, f.values[ins.args[0]]);
    if (at < 0) { return "missing record projection schema"; }
    var fields: semrecords.Field[] = f.records[at].fields;
    if (ins.imm < 0 || ins.imm >= fields.len()) { return "record projection index"; }
    if (ins.str != fields[ins.imm].name) { return "record projection field identity"; }
    if (!semtypes.equal(fields[ins.imm].ty, result)) { return "record projection type"; }
    return "";
}

function variant_fields(f: Func, t: typeinfo.Type, name: string): semrecords.Field[] {
    var at: i32 = semrecords.find_enum(f.enums, t);
    if (at < 0) { return []; }
    var v: i32 = semrecords.find_variant(f.enums[at], name);
    if (v < 0) { return []; }
    return f.enums[at].variants[v].fields;
}

function variant_known(f: Func, t: typeinfo.Type, name: string): string {
    var at: i32 = semrecords.find_enum(f.enums, t);
    if (at < 0) { return "missing variant schema"; }
    if (semrecords.find_variant(f.enums[at], name) < 0) { return "unknown variant"; }
    return "";
}

function variant_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    var why: string = variant_known(f, result, ins.str);
    if (why != "") { return why; }
    var fields: semrecords.Field[] = variant_fields(f, result, ins.str);
    if (ins.args.len() != fields.len()) { return "variant construction arity"; }
    var i: i32 = 0;
    while (i < fields.len()) {
        if (!semtypes.equal(fields[i].ty, f.values[ins.args[i]])) { return "variant field type"; }
        i = i + 1;
    }
    return "";
}

function variant_test_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "variant test arity"; }
    if (!is_bool(result)) { return "variant test type"; }
    return variant_known(f, f.values[ins.args[0]], ins.str);
}

function variant_projection_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "variant projection arity"; }
    var why: string = variant_known(f, f.values[ins.args[0]], ins.str);
    if (why != "") { return why; }
    var fields: semrecords.Field[] = variant_fields(f, f.values[ins.args[0]], ins.str);
    if (ins.imm < 0 || ins.imm >= fields.len()) { return "variant projection index"; }
    if (!semtypes.equal(fields[ins.imm].ty, result)) { return "variant projection type"; }
    return "";
}

// A struct-union's member is its own box, so widening and narrowing are
// identities between the member's type and the union's. An enum boxes its
// payload behind the variant's own shape and has neither operation.
function member_layout(f: Func, t: typeinfo.Type): boolean {
    var at: i32 = semrecords.find_enum(f.enums, t);
    return at >= 0 && f.enums[at].layout == semrecords.layout_member();
}

function member_named(t: typeinfo.Type, name: string): boolean {
    if let typeinfo.TypeStruct(r) = t { return r.args.len() == 0 && r.name == name; }
    return false;
}

function widening_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "variant widening arity"; }
    if (!member_layout(f, result)) { return "variant widening layout"; }
    var why: string = variant_known(f, result, ins.str);
    if (why != "") { return why; }
    if (!member_named(f.values[ins.args[0]], ins.str)) { return "variant widening type"; }
    return "";
}

// A widening to dyn keeps the box, whose shape the dispatch reads, so the
// operand is a record or an enum value.
function dyn_widening_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "dyn widening arity"; }
    if (!is_dyn(result)) { return "dyn widening type"; }
    var from: typeinfo.Type = f.values[ins.args[0]];
    if let typeinfo.TypeStruct(_) = from { return ""; }
    if let typeinfo.TypeUnion(_) = from { return ""; }
    return "dyn widening operand";
}

function dyn_box_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "dyn box arity"; }
    if (!is_dyn(result)) { return "dyn box type"; }
    var from: typeinfo.Type = f.values[ins.args[0]];
    if (!boxes_into_dyn(from) || typeinfo.spelling(from) != ins.str) { return "dyn box operand"; }
    return "";
}

// The primitives a dyn box holds: an integer, a boolean or an f64, stored at
// its own width, or a string.
pub function boxes_into_dyn(t: typeinfo.Type): boolean {
    if let typeinfo.TypeI32(_) = t { return true; }
    if let typeinfo.TypeBool(_) = t { return true; }
    if let typeinfo.TypeFloat(fl) = t { return fl.width != 32; }
    return is_string(t);
}

function narrowing_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "variant narrowing arity"; }
    var whole: typeinfo.Type = f.values[ins.args[0]];
    if (!member_layout(f, whole)) { return "variant narrowing layout"; }
    var why: string = variant_known(f, whole, ins.str);
    if (why != "") { return why; }
    if (!member_named(result, ins.str)) { return "variant narrowing type"; }
    return "";
}

// A retag between the two string types hands back the same box, so like a
// widening it borrows its operand. Owned to view is a borrow of the source's
// bytes anywhere a view is declared; view to owned is a borrow the producer
// hands only to a borrowed parameter, which this verifier cannot see, so its
// rule is the type pair alone.
function retag_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "string retag arity"; }
    var from: typeinfo.Type = f.values[ins.args[0]];
    if (!is_text(from) || !is_text(result) || semtypes.equal(from, result)) { return "string retag type"; }
    return "";
}

// A closure value is one box: the address of the body this function holds a
// contract for, then the captures. The type it hands out is that contract
// minus the environment parameter the body reads the captures through.
//
// Every capture is a VALUE. The box is released by one decrement with no walk
// of its slots — there is no per-closure drop helper, and a function type
// names no capture for one to be derived from — so a reference in a slot
// would be a unit nothing here owns. The capture COUNT is not checked: the
// contract records the body's signature, not how many words it reads out of
// its environment, and the two sides are written by one lift.
function closure_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (!is_func(result)) { return "closure value type"; }
    var at: i32 = find_contract(f.calls, ins.str);
    if (at < 0) { return "missing closure body contract"; }
    var c: Contract = f.calls[at];
    if (!closure_env(c)) { return "closure environment parameter"; }
    if (!semtypes.equal(closure_type(c), result)) { return "closure signature"; }
    var caps: typeinfo.Type[] = closure_captures(c);
    if (ins.args.len() != caps.len()) { return "closure capture count"; }
    var i: i32 = 0;
    while (i < caps.len()) {
        if (!semtypes.equal(f.values[ins.args[i]], caps[i])) { return "closure capture type"; }
        i = i + 1;
    }
    return "";
}

// A call through a function value. The callee is operand 0 and its TYPE is the
// whole contract: no declaration is in hand, so the signature the value
// carries is what the arguments and the result are held to. The box it names
// is lent to the body as the environment, never consumed.
function call_value_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() == 0) { return "indirect call arity"; }
    var sig: typeinfo.Type = f.values[ins.args[0]];
    if (!is_func(sig)) { return "indirect call target type"; }
    var params: typeinfo.Type[] = func_params(sig);
    if (ins.args.len() != params.len() + 1) { return "indirect call arity"; }
    var i: i32 = 0;
    while (i < params.len()) {
        if (!semtypes.equal(params[i], f.values[ins.args[i + 1]])) { return "indirect call argument type"; }
        i = i + 1;
    }
    if (!semtypes.equal(func_result(sig), result)) { return "indirect call result type"; }
    return "";
}

pub function is_function_op(kind: i32): boolean { return kind == closure_new() || kind == call_value(); }

function function_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.kind_tag == closure_new()) { return closure_error(ins, f, result); }
    return call_value_error(ins, f, result);
}

function variant_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.kind_tag == variant_new()) { return variant_construction_error(ins, f, result); }
    if (ins.kind_tag == variant_is()) { return variant_test_error(ins, f, result); }
    if (ins.kind_tag == variant_up()) { return widening_error(ins, f, result); }
    if (ins.kind_tag == dyn_up()) { return dyn_widening_error(ins, f, result); }
    if (ins.kind_tag == dyn_box()) { return dyn_box_error(ins, f, result); }
    if (ins.kind_tag == str_as()) { return retag_error(ins, f, result); }
    if (ins.kind_tag == variant_as()) { return narrowing_error(ins, f, result); }
    return variant_projection_error(ins, f, result);
}

// A window onto a string's bytes. The register backends hand back a box of
// their own over the SOURCE's bytes, so the result owns a box and borrows the
// data — it is anchored to its source like any projection, and released by the
// helper that frees a view's box without touching the bytes. Its type says so:
// a slice is a view, of an owned string or of another view.
function slice_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 3) { return "slice arity"; }
    if (!is_view(result) || !is_text(f.values[ins.args[0]])) { return "slice container type"; }
    if (!is_i32(f.values[ins.args[1]]) || !is_i32(f.values[ins.args[2]])) { return "slice bound type"; }
    return "";
}

// A copy of a window of an array of scalars, the same type as its source and
// owned whole: no element of it is a reference, so the raw word copy the
// runtime makes owes nothing to the source.
function arr_slice_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 3) { return "slice arity"; }
    var src: typeinfo.Type = f.values[ins.args[0]];
    if (!semtypes.equal(src, result)) { return "slice container type"; }
    if let typeinfo.TypeArray(_) = src {} else { return "slice container type"; }
    if (!is_i32(f.values[ins.args[1]]) || !is_i32(f.values[ins.args[2]])) { return "slice bound type"; }
    return "";
}

// One byte of a string, handed back as a u8 — the type the checker gives the
// expression, so a binding or an operator over it needs no reconciliation. The
// receiver is read the way a length's is, and the result owns nothing and
// anchors nothing — so unlike a slice this is not a projection, and no rule
// here has to keep the source alive for it.
function str_index_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 2) { return "string index arity"; }
    if (!is_u8(result)) { return "string index result type"; }
    if (!is_text(f.values[ins.args[0]])) { return "string index container type"; }
    if (!is_i32(f.values[ins.args[1]])) { return "string index type"; }
    return "";
}

// The builtins this vocabulary admits: a container's length, one element
// pushed onto an array or replaced in it, a window onto a string, one of its
// bytes, and the cell and map vocabularies.
function is_builtin_op(kind: i32): boolean {
    return kind == length() || kind == append() || kind == with() || kind == slice() || kind == str_index()
        || kind == str_bytes() || kind == arr_slice() || is_arr_helper_op(kind) || is_cell_op(kind) || is_map_op(kind)
        || is_map_iter_op(kind);
}

pub function is_arr_helper_op(kind: i32): boolean {
    return kind == arr_sum() || kind == arr_product() || kind == arr_join();
}

pub function is_cell_op(kind: i32): boolean { return kind == cell_new() || kind == cell_get() || kind == cell_set(); }

pub function is_map_op(kind: i32): boolean {
    return kind == map_new() || kind == map_insert() || kind == map_has() || kind == map_get_or() || kind == map_len() || kind == map_get()
        || kind == map_keys() || kind == map_values() || kind == map_delete() || kind == map_cleared();
}

// A view reaches the bytes the same way a string does, so either box is a legal
// receiver; the result is the fresh byte array, never a window onto the source.
function str_bytes_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "str bytes arity"; }
    if (!is_text(f.values[ins.args[0]])) { return "str bytes receiver"; }
    if let typeinfo.TypeArray(a) = result {
        if (is_u8(a.elem)) { return ""; }
    }
    return "str bytes result";
}

// The reductions read an `i32[]` and answer a plain i32; the join reads a
// `string[]` and a separator and answers a fresh string. None of the three
// keeps an operand, so the receiver is borrowed as a length's is.
function arr_reduce_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "array reduce arity"; }
    if (!is_i32(result)) { return "array reduce result"; }
    if let typeinfo.TypeArray(a) = f.values[ins.args[0]] {
        if (is_i32(a.elem)) { return ""; }
    }
    return "array reduce receiver";
}

function arr_join_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 2) { return "array join arity"; }
    if (!is_string(result)) { return "array join result"; }
    if (!is_text(f.values[ins.args[1]])) { return "array join separator"; }
    if let typeinfo.TypeArray(a) = f.values[ins.args[0]] {
        if (is_string(a.elem)) { return ""; }
    }
    return "array join receiver";
}

function builtin_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.kind_tag == arr_join()) { return arr_join_error(ins, f, result); }
    if (ins.kind_tag == arr_sum() || ins.kind_tag == arr_product()) { return arr_reduce_error(ins, f, result); }
    if (ins.kind_tag == length()) { return length_error(ins, f, result); }
    if (ins.kind_tag == slice()) { return slice_error(ins, f, result); }
    if (ins.kind_tag == arr_slice()) { return arr_slice_error(ins, f, result); }
    if (ins.kind_tag == str_index()) { return str_index_error(ins, f, result); }
    if (ins.kind_tag == str_bytes()) { return str_bytes_error(ins, f, result); }
    if (ins.kind_tag == with()) { return with_error(ins, f, result); }
    if (is_cell_op(ins.kind_tag)) { return cell_error(ins, f, result); }
    if (is_map_op(ins.kind_tag)) { return map_error(ins, f, result); }
    if (is_map_iter_op(ins.kind_tag)) { return map_iter_error(ins, f, result); }
    return append_error(ins, f, result);
}

// A cell is the shared one-element box (docs/CELL-TYPE-PLAN.md). Its
// construction takes the element's unit; a read hands out a unit of the
// element rather than borrowing the slot, since a write may release what the
// slot held while the value read is still in hand; a write takes the new
// element's unit and gives nothing back, so it stands only as a statement.
function cell_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.kind_tag == cell_new()) { return cell_construction_error(ins, f, result); }
    if (ins.kind_tag == cell_get()) { return cell_read_error(ins, f, result); }
    return cell_write_error(ins, f, result);
}

// A map cursor. `map_iter` takes the map and answers the cursor typed by its
// key and value; the other four take the cursor. `has_next` answers a boolean,
// `key` and `value` answer the columns' element types, and `advance` answers
// void, so it stands only as a statement.
function map_iter_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "map cursor arity"; }
    var recv: typeinfo.Type = f.values[ins.args[0]];
    if (ins.kind_tag == map_iter()) {
        if (!is_supported_map(recv)) { return "unsupported map shape: " + typeinfo.spelling(recv); }
        if (!semtypes.is_map_iter(result)) { return "map cursor type"; }
        if (!semtypes.equal(semtypes.map_iter_key(result), map_key(recv))) { return "map cursor key type"; }
        if (!semtypes.equal(semtypes.map_iter_value(result), map_value(recv))) { return "map cursor value type"; }
        return "";
    }
    if (!semtypes.is_map_iter(recv)) { return "map cursor receiver type"; }
    if (ins.kind_tag == mapiter_has_next()) {
        if (!is_bool(result)) { return "map cursor bound type"; }
        return "";
    }
    if (ins.kind_tag == mapiter_key()) {
        if (!semtypes.equal(semtypes.map_iter_key(recv), result)) { return "map cursor key type"; }
        return "";
    }
    if (ins.kind_tag == mapiter_value()) {
        if (!semtypes.equal(semtypes.map_iter_value(recv), result)) { return "map cursor value type"; }
        return "";
    }
    if (!is_void(result)) { return "map cursor advance type"; }
    return "";
}

function cell_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "cell construction arity"; }
    if (!semtypes.is_cell(result)) { return "cell construction type"; }
    if (!semtypes.equal(semtypes.cell_elem(result), f.values[ins.args[0]])) { return "cell element type"; }
    return "";
}

function cell_read_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "cell read arity"; }
    var cell: typeinfo.Type = f.values[ins.args[0]];
    if (!semtypes.is_cell(cell)) { return "cell read type"; }
    if (!semtypes.equal(semtypes.cell_elem(cell), result)) { return "cell element type"; }
    return "";
}

function cell_write_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 2) { return "cell write arity"; }
    var cell: typeinfo.Type = f.values[ins.args[0]];
    if (!semtypes.is_cell(cell)) { return "cell write type"; }
    if (!semtypes.equal(semtypes.cell_elem(cell), f.values[ins.args[1]])) { return "cell element type"; }
    if (!is_void(result)) { return "cell write result"; }
    return "";
}

// The map is the runtime hash map at the shapes is_supported_map admits.
// Construction is fresh; an insert takes a unit of the map and of the key,
// which the key column owns until the map is released, and of the value when
// that column is counted too, and hands the map back so the caller holds one
// owner at a time; a lookup borrows the map and the key and answers the value,
// which it retains when the column is counted; the length borrows the map.
function map_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.kind_tag == map_new()) { return map_construction_error(ins, f, result); }
    if (ins.kind_tag == map_insert()) { return map_insert_error(ins, f, result); }
    if (ins.kind_tag == map_has()) { return map_has_error(ins, f, result); }
    if (ins.kind_tag == map_len()) { return map_len_error(ins, f, result); }
    if (ins.kind_tag == map_get()) { return map_get_error(ins, f, result); }
    if (ins.kind_tag == map_keys()) { return map_column_error(ins, f, result, true); }
    if (ins.kind_tag == map_values()) { return map_column_error(ins, f, result, false); }
    if (ins.kind_tag == map_delete()) { return map_delete_error(ins, f, result); }
    if (ins.kind_tag == map_cleared()) { return map_cleared_error(ins, f, result); }
    return map_get_or_error(ins, f, result);
}

// A delete borrows the key to find the entry and hands the map back inside a
// tuple with whether it was there. The runtime removes the entry by moving the
// last one into the hole and shrinking both columns, and releasing the
// removed entry's key and value through the columns' releases, so every
// supported map shape is admitted.
function map_delete_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 2) { return "map delete arity"; }
    var m: typeinfo.Type = f.values[ins.args[0]];
    if (!is_supported_map(m)) { return "map delete type"; }
    if (!semtypes.equal(delete_result(m), result)) { return "map delete result"; }
    return map_operand_error(m, f.values[ins.args[1]], map_value(m));
}

pub function delete_result(m: typeinfo.Type): typeinfo.Type {
    return typeinfo.TypeTuple { elements: [m, typeinfo.TypeBool { tag: 0 }] };
}

// A clear is a CONSTRUCTION: this runtime's map box is the two columns with no
// capacity beside them, so an empty box of the same shape is what clearing
// produces. It reads nothing from the receiver, which keeps its own unit and
// is released wherever its last use falls.
function map_cleared_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 0) { return "map cleared arity"; }
    if (!is_supported_map(result)) { return "map cleared type"; }
    return "";
}

// A column snapshot borrows the map and answers an array of that column's
// element type. Only a column `retained_column` names is admitted: every
// other element type comes back aliasing the map's own, which no result type
// here can say.
function map_column_error(ins: ssa.SInst, f: Func, result: typeinfo.Type, keys: boolean): string {
    if (ins.args.len() != 1) { return "map column arity"; }
    var m: typeinfo.Type = f.values[ins.args[0]];
    if (!is_supported_map(m)) { return "map column type"; }
    var elem: typeinfo.Type = map_value(m);
    if (keys) { elem = map_key(m); }
    if (!retained_column(elem)) { return "map column element"; }
    if (!semtypes.equal(typeinfo.TypeArray { elem: elem, view: false }, result)) { return "map column result"; }
    return "";
}

// A get answers an Option of the value column in a box of its own, which
// owns one unit of a counted payload.
function map_get_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 2) { return "map get arity"; }
    var m: typeinfo.Type = f.values[ins.args[0]];
    if (!is_supported_map(m)) { return "map get type"; }
    if (!semtypes.equal(option_of(map_value(m)), result)) { return "map get result"; }
    return map_operand_error(m, f.values[ins.args[1]], map_value(m));
}

pub function option_of(v: typeinfo.Type): typeinfo.Type { return typeinfo.TypeUnion { name: "Option", args: [v] }; }

function map_len_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "map len arity"; }
    if (!is_supported_map(f.values[ins.args[0]])) { return "map len type"; }
    if (!is_i32(result)) { return "map len result"; }
    return "";
}

function map_construction_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "map construction arity"; }
    if (!is_supported_map(result)) { return "map construction type"; }
    if (!is_i32(f.values[ins.args[0]])) { return "map capacity type"; }
    return "";
}

function map_insert_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 3) { return "map insert arity"; }
    var m: typeinfo.Type = f.values[ins.args[0]];
    if (!is_supported_map(m)) { return "map insert type"; }
    if (!semtypes.equal(m, result)) { return "map insert result"; }
    return map_operand_error(m, f.values[ins.args[1]], f.values[ins.args[2]]);
}

function map_has_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 2) { return "map has arity"; }
    var m: typeinfo.Type = f.values[ins.args[0]];
    if (!is_supported_map(m)) { return "map has type"; }
    if (!is_bool(result)) { return "map has result"; }
    return map_operand_error(m, f.values[ins.args[1]], map_value(m));
}

function map_get_or_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 3) { return "map get_or arity"; }
    var m: typeinfo.Type = f.values[ins.args[0]];
    if (!is_supported_map(m)) { return "map get_or type"; }
    if (!semtypes.equal(map_value(m), result)) { return "map get_or result"; }
    return map_operand_error(m, f.values[ins.args[1]], f.values[ins.args[2]]);
}

function map_operand_error(m: typeinfo.Type, key: typeinfo.Type, value: typeinfo.Type): string {
    if (!semtypes.equal(map_key(m), key)) { return "map key type"; }
    if (!semtypes.equal(map_value(m), value)) { return "map value type"; }
    return "";
}

function is_variant_op(kind: i32): boolean {
    return kind == variant_new() || kind == variant_is() || kind == variant_get()
        || kind == variant_up() || kind == variant_as() || kind == str_as() || kind == dyn_up() || kind == dyn_box();
}

// A variant's field, and a narrowing to a variant, exist only while the value
// is that variant.
function needs_guard(kind: i32): boolean { return kind == variant_get() || kind == variant_as(); }

// A contract carrying a type VARIABLE (`typeinfo.TypeErased`) is a TEMPLATE,
// and the call site is what instantiates it. Binding runs left to right over
// the arguments and is structural, so a function-typed parameter's own
// variable slots bind through it; one variable binds one type for the whole
// contract, and a second position naming it must carry that same type. The
// instance is a body of its own, produced under the binding and named by it.
pub struct Binding { ok: boolean, why: string, names: string[], types: typeinfo.Type[] }

pub function unbound(): Binding { return Binding { ok: true, why: "", names: [], types: [] }; }
function unbindable(why: string): Binding { return Binding { ok: false, why: why, names: [], types: [] }; }

function bound_at(b: Binding, name: string): i32 {
    var i: i32 = 0;
    while (i < b.names.len()) { if (b.names[i] == name) { return i; } i = i + 1; }
    return 0 - 1;
}

pub function bind_type(b: Binding, want: typeinfo.Type, got: typeinfo.Type): Binding {
    if (semtypes.erased(want)) { return bind_variable(b, variable_name(want), got); }
    if (semtypes.erased(got)) { return unbindable("type variable at a concrete parameter"); }
    return bind_within(b, want, got);
}

function variable_name(t: typeinfo.Type): string {
    if let typeinfo.TypeErased(e) = t { return e.name; }
    return "";
}

// A variable binds a concrete type: the instance is produced at exactly that
// type, so a void, an unknown or another template's variable binds nothing.
function bind_variable(b: Binding, name: string, got: typeinfo.Type): Binding {
    if (!semtypes.concrete(got, false)) { return unbindable("type variable binds no concrete type"); }
    var at: i32 = bound_at(b, name);
    if (at >= 0) {
        if (!semtypes.equal(b.types[at], got)) { return unbindable("erased variable binds two types"); }
        return b;
    }
    return Binding { ...b, names: b.names.append(name), types: b.types.append(got) };
}

// Binding is structural: a variable inside a function type, a container or a
// nominal type's arguments binds through it, against the same shape on the
// argument's side.
function bind_within(b: Binding, want: typeinfo.Type, got: typeinfo.Type): Binding {
    if let typeinfo.TypeFunc(x) = want {
        if let typeinfo.TypeFunc(y) = got { return bind_callable(b, x, y); }
        return mismatch();
    }
    if let typeinfo.TypeArray(x) = want {
        if let typeinfo.TypeArray(y) = got { return bind_type(b, x.elem, y.elem); }
        return mismatch();
    }
    if let typeinfo.TypeTuple(x) = want {
        if let typeinfo.TypeTuple(y) = got { return bind_list(b, x.elements, y.elements); }
        return mismatch();
    }
    if let typeinfo.TypeMap(x) = want {
        if let typeinfo.TypeMap(y) = got { return bind_type(bind_type(b, x.key, y.key), x.value, y.value); }
        return mismatch();
    }
    return bind_nominal(b, want, got);
}

function mismatch(): Binding { return unbindable("call argument type"); }

function bind_nominal(b: Binding, want: typeinfo.Type, got: typeinfo.Type): Binding {
    if let typeinfo.TypeStruct(x) = want {
        if let typeinfo.TypeStruct(y) = got { if (x.name == y.name) { return bind_list(b, x.args, y.args); } }
        return mismatch();
    }
    if let typeinfo.TypeUnion(x) = want {
        if let typeinfo.TypeUnion(y) = got { if (x.name == y.name) { return bind_list(b, x.args, y.args); } }
        return mismatch();
    }
    if (!semtypes.equal(want, got)) { return mismatch(); }
    return b;
}

// The consuming flags must agree, read against the slot the ARGUMENT actually
// carries: `own T` at a variable this call binds to a scalar is vacuous, and
// the scalar body spells no `own` there. At a reference the two must still
// agree.
function bind_callable(b: Binding, x: typeinfo.TypeFunc, y: typeinfo.TypeFunc): Binding {
    if (x.params_known != y.params_known || x.param_types.len() != y.param_types.len()) { return mismatch(); }
    var i: i32 = 0;
    while (i < x.param_types.len()) {
        if (typeinfo.fn_own_at(x, i) && typeinfo.ownable(y.param_types[i]) != typeinfo.fn_own_at(y, i)) { return mismatch(); }
        if (!typeinfo.fn_own_at(x, i) && typeinfo.fn_own_at(y, i)) { return mismatch(); }
        b = bind_type(b, x.param_types[i], y.param_types[i]);
        if (!b.ok) { return b; }
        i = i + 1;
    }
    return bind_type(b, x.ret_type, y.ret_type);
}

function bind_list(b: Binding, want: typeinfo.Type[], got: typeinfo.Type[]): Binding {
    if (want.len() != got.len()) { return mismatch(); }
    var i: i32 = 0;
    while (i < want.len()) {
        b = bind_type(b, want[i], got[i]);
        if (!b.ok) { return b; }
        i = i + 1;
    }
    return b;
}

pub function substitute(t: typeinfo.Type, b: Binding): typeinfo.Type {
    if (semtypes.erased(t)) {
        var at: i32 = bound_at(b, variable_name(t));
        if (at >= 0) { return b.types[at]; }
        return t;
    }
    if let typeinfo.TypeFunc(fn) = t {
        var params: typeinfo.Type[] = substitute_list(fn.param_types, b);
        // The mask is renormalised against the SUBSTITUTED types: a variable
        // bound to a scalar carries no unit there, so the slot stops being a
        // consuming one and the instantiated type matches the callable a
        // scalar body hands out.
        return typeinfo.TypeFunc { ...fn, param_types: params, param_own: typeinfo.own_flags(fn.param_own, params), ret_type: substitute(fn.ret_type, b) };
    }
    if let typeinfo.TypeArray(a) = t { return typeinfo.TypeArray { elem: substitute(a.elem, b), view: a.view }; }
    if let typeinfo.TypeTuple(tup) = t { return typeinfo.TypeTuple { elements: substitute_list(tup.elements, b) }; }
    if let typeinfo.TypeMap(m) = t { return typeinfo.TypeMap { key: substitute(m.key, b), value: substitute(m.value, b) }; }
    if let typeinfo.TypeStruct(r) = t { return typeinfo.TypeStruct { ...r, args: substitute_list(r.args, b) }; }
    if let typeinfo.TypeUnion(u) = t { return typeinfo.TypeUnion { ...u, args: substitute_list(u.args, b) }; }
    return t;
}

function substitute_list(ts: typeinfo.Type[], b: Binding): typeinfo.Type[] {
    var out: typeinfo.Type[] = [];
    for t in ts { out = out.append(substitute(t, b)); }
    return out;
}

// The variables a template's contract spells, in order of first occurrence
// over its parameters and then its result: the order an instance's name lists
// their bindings in.
pub function contract_variables(c: Contract): string[] {
    var out: string[] = [];
    for p in c.params { out = variables(p, out); }
    return variables(c.result, out);
}

function variables(t: typeinfo.Type, out: string[]): string[] {
    if (semtypes.erased(t)) {
        var name: string = variable_name(t);
        for seen in out { if (seen == name) { return out; } }
        return out.append(name);
    }
    if let typeinfo.TypeArray(a) = t { return variables(a.elem, out); }
    if let typeinfo.TypeTuple(tup) = t { return variables_of(tup.elements, out); }
    if let typeinfo.TypeFunc(fn) = t { return variables(fn.ret_type, variables_of(fn.param_types, out)); }
    if let typeinfo.TypeMap(m) = t { return variables(m.value, variables(m.key, out)); }
    if let typeinfo.TypeStruct(r) = t { return variables_of(r.args, out); }
    if let typeinfo.TypeUnion(u) = t { return variables_of(u.args, out); }
    return out;
}

function variables_of(ts: typeinfo.Type[], out: string[]): string[] {
    for t in ts { out = variables(t, out); }
    return out;
}

pub function binds_all(b: Binding, vars: string[]): boolean {
    for v in vars { if (bound_at(b, v) < 0) { return false; } }
    return true;
}

// An instance's symbol: the template's key, then the type each variable binds
// in the contract's own order, `$`-separated the way a lifted lambda's is.
pub function instance_name(key: string, b: Binding, vars: string[]): string {
    var out: string = key;
    for v in vars { out = out + "$" + type_key(b.types[bound_at(b, v)]); }
    return out;
}

// The contract an instance honours: every variable substituted, and a
// parameter whose variable bound a scalar carrying no unit, so its declared
// mode drops to a value's.
pub function instantiate_contract(c: Contract, b: Binding, vars: string[]): Contract {
    var name: string = instance_name(c.name, b, vars);
    var params: typeinfo.Type[] = [];
    var modes: i32[] = [];
    var i: i32 = 0;
    while (i < c.params.len()) {
        var t: typeinfo.Type = substitute(c.params[i], b);
        // An instance's environment names the instance, whose address the
        // box's slot 0 holds.
        if (i == 0 && semtypes.is_env(t)) { t = env_type(name, semtypes.env_captures(t)); }
        params = params.append(t);
        if (semtypes.needs_anchor(t)) { modes = modes.append(c.modes[i]); } else { modes = modes.append(value_mode()); }
        i = i + 1;
    }
    return Contract { name: name, params: params, modes: modes, result: substitute(c.result, b) };
}

// A symbol-safe spelling of a type, distinguishing the INSTANTIATIONS of one
// nominal name: `Option[string]` releases a string where `Option[i32]`
// releases nothing, so the two cannot share a drop helper, and a template's
// instances are told apart by it. `$` separates the arguments, as it does in
// a lifted lambda's symbol. A structural type's key starts with one, which no
// declared name can, so an array of strings and a struct named `arr`
// instantiated at a string never share a key.
pub function type_key(t: typeinfo.Type): string {
    if let typeinfo.TypeUnion(u) = t { return key_args(u.name, u.args); }
    if let typeinfo.TypeStruct(r) = t { return key_args(r.name, r.args); }
    if let typeinfo.TypeArray(a) = t { return "$arr$" + type_key(a.elem); }
    if let typeinfo.TypeTuple(tup) = t { return key_args("$tup", tup.elements); }
    if let typeinfo.TypeFunc(fn) = t { return key_args("$fn", fn.param_types.append(fn.ret_type)); }
    if let typeinfo.TypeMap(m) = t { return key_args("$map", [m.key, m.value]); }
    return leaf_key(t);
}

function key_args(name: string, args: typeinfo.Type[]): string {
    var out: string = name;
    for a in args { out = out + "$" + type_key(a); }
    return out;
}

function leaf_key(t: typeinfo.Type): string {
    if (is_void(t)) { return "void"; }
    if (is_view(t)) { return "str"; }
    if (is_string(t)) { return "string"; }
    if (is_i64(t)) { return "i64"; }
    if (is_u64(t)) { return "u64"; }
    if (is_u8(t)) { return "u8"; }
    if (is_u32(t)) { return "u32"; }
    if (is_usize(t)) { return "usize"; }
    if (is_f64(t)) { return "f64"; }
    if (is_f32(t)) { return "f32"; }
    if (is_char(t)) { return "char"; }
    if (is_integer(t)) { return "i32"; }
    return "bool";
}

// A produced graph's contracts are instances: every parameter and the result
// are exact types, and a call is held to them.
function call_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    var at: i32 = find_contract(f.calls, ins.str);
    if (at < 0) { return "missing call contract"; }
    var c: Contract = f.calls[at];
    if (ins.args.len() != c.params.len()) { return "call arity"; }
    if (is_dyn_call(ins.str) && (c.params.len() == 0 || !is_dyn(c.params[0]))) { return "dyn call receiver type"; }
    var i: i32 = 0;
    while (i < ins.args.len()) {
        if (!semtypes.equal(c.params[i], f.values[ins.args[i]])) { return "call argument type"; }
        i = i + 1;
    }
    if (!semtypes.equal(c.result, result)) { return "call result type"; }
    if (ins.imm != 0) { return "call immediate"; }
    return "";
}

// The integer operators this vocabulary produces, all of them total: Fern
// pins every edge rather than trapping (docs/INTEGER-SEMANTICS.md) — `x / 0`
// is 0, `x % 0` is x, `INT_MIN / -1` wraps, and a shift count is masked to
// the operand width — so none of these needs a guard or a branch, and each
// is one machine operation on a value that owns nothing.
function integer_op(op: string): boolean {
    if (op == "+" || op == "-" || op == "*") { return true; }
    if (op == "/" || op == "%") { return true; }
    if (op == "&" || op == "|" || op == "^") { return true; }
    return op == "<<" || op == ">>";
}
function comparison(op: string): boolean {
    return op == "<" || op == "<=" || op == ">" || op == ">=" || op == "==" || op == "!=";
}
// The float operators: IEEE arithmetic, which never wraps and never traps.
// `%` has no float opcode in the stack IR, and the bitwise three and the shifts
// have no float meaning.
function float_op(op: string): boolean {
    return op == "+" || op == "-" || op == "*" || op == "/";
}

// The integer operators and orderings at one width, equality on booleans;
// string concatenation, a fresh string, and the string comparisons. An
// operator whose operands carry different integer types has no contract here:
// the conversion is a cast the source has to write. Operator overloads have
// none either.
pub function binary_result(op: string, left: typeinfo.Type, right: typeinfo.Type): typeinfo.Type {
    if (is_usize(left) && semtypes.equal(left, right)) { return address_result(op, left); }
    if (is_integer(left) && semtypes.equal(left, right)) { return integer_result(op, left); }
    if (is_float(left) && semtypes.equal(left, right)) { return float_result(op, left); }
    if (is_bool(left) && is_bool(right) && (op == "==" || op == "!=")) { return typeinfo.TypeBool { tag: 0 }; }
    // A codepoint is compared, never ordered or added: native answers E009 to
    // every operator on char but the two equalities.
    if (is_char(left) && is_char(right) && (op == "==" || op == "!=")) { return typeinfo.TypeBool { tag: 0 }; }
    if (is_text(left) && is_text(right)) { return string_result(op); }
    return typeinfo.unchecked();
}

// An address supports the operators whose lowering does not read the operand
// WIDTH, since the stack IR carries no binary at the pointer width: the
// backends run add/sub/mul and the bitwise three on the whole register, and a
// comparison on the whole register too. The shifts mask their count to the
// operand width and div/rem select their register pair from it, so at the
// narrow width both would truncate an address — those stay refused until a
// pointer-width binary exists for the backends to resolve. The saturating and
// checked operators clamp at a width the type names, which the native checker
// refuses for an address (E009) and this boundary refuses with it.
function address_result(op: string, t: typeinfo.Type): typeinfo.Type {
    if (op == "/" || op == "%" || op == "<<" || op == ">>") { return typeinfo.unchecked(); }
    if (saturating(op) || checked_arith(op)) { return typeinfo.unchecked(); }
    return integer_result(op, t);
}

// A saturating operator clamps to its operand type and a checked one answers
// an Option of it; both are integer-only (checker E009).
pub function saturating(op: string): boolean {
    return op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}
pub function checked_arith(op: string): boolean {
    return op == "+?" || op == "-?" || op == "*?" || op == "/?" || op == "%?" || op == "<<?" || op == ">>?";
}

function integer_result(op: string, t: typeinfo.Type): typeinfo.Type {
    if (integer_op(op) || saturating(op)) { return t; }
    if (checked_arith(op)) { return typeinfo.TypeUnion { name: "Option", args: [t] }; }
    if (comparison(op)) { return typeinfo.TypeBool { tag: 0 }; }
    return typeinfo.unchecked();
}

function float_result(op: string, t: typeinfo.Type): typeinfo.Type {
    if (float_op(op)) { return t; }
    if (comparison(op)) { return typeinfo.TypeBool { tag: 0 }; }
    return typeinfo.unchecked();
}

// A string `+` is concatenation; every comparison is the runtime's byte-order
// compare, which orders the two boxes' bytes and is blind to which box holds
// them.
function string_result(op: string): typeinfo.Type {
    if (op == "+") { return typeinfo.TypeString { tag: 0 }; }
    if (comparison(op)) { return typeinfo.TypeBool { tag: 0 }; }
    return typeinfo.unchecked();
}

// Negation keeps its operand's type, at either signed width. An unsigned
// operand has no negation here: the result of one leaves the range the type
// names, and what the source would mean by it is not the wrap this boundary
// would emit.
pub function unary_result(op: string, operand: typeinfo.Type): typeinfo.Type {
    if (op == "-" && (is_i32(operand) || is_i64(operand) || is_float(operand))) { return operand; }
    if (op == "!" && is_bool(operand)) { return typeinfo.TypeBool { tag: 0 }; }
    return typeinfo.unchecked();
}

function binary_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 2) { return "binary operator arity"; }
    var want: typeinfo.Type = binary_result(ins.str, f.values[ins.args[0]], f.values[ins.args[1]]);
    if (!semtypes.concrete(want, false) || !semtypes.equal(want, result)) { return "binary operator contract"; }
    return "";
}

// A conversion between the integer types, between one of the four 32- and
// 64-bit ones and a float, or between the two float widths. An integer
// conversion is the destination's own mask or extension, which every width
// here has. A float conversion is a real instruction either way — a convert
// into the float, a truncation toward zero out of it, a rounding to single
// precision — so it is not a reinterpretation of the slot, and only the
// widths the backends have an opcode for are admitted: the byte has none, and
// reaches the float through the i32 the source writes.
// A codepoint converts exactly where an i32 does. char is an integer width
// carrying a range restriction, and the restriction is the checker's to
// enforce at the literal rather than the conversion's to refuse; native takes
// the same line, admitting char to every integer width and to none of the
// floats (E033).
function converts_as_integer(t: typeinfo.Type): boolean { return is_integer(t) || is_char(t); }

// Reading an address back as the box it names is a REINTERPRETATION: the two
// are the same slot on every backend — the whole register where an address is
// 64 bits, the i32 on wasm — so the value crosses unchanged and nothing is
// emitted for it. `k as string`, which core/map's key column hashes and
// compares, is this direction, and the AST lowering treats it as an ascription
// for the same reason.
//
// The other direction hands out a second name for storage this frame still
// owns, so the address ANCHORS its source (borrows_storage): without that the
// planner would drop the box at `s as usize`, its last typed use, while the
// address went on naming it. An address that leaves the frame outlives the
// anchor, which is why core/map carries an explicit `__fern_rc_inc` on the one
// it returns; the anchor covers every read inside the frame.
function reinterprets(from: typeinfo.Type, to: typeinfo.Type): boolean {
    return (is_usize(from) && reference(to)) || (reference(from) && is_usize(to));
}

// The address converts to and from every integer width, as native admits it
// to. Neither direction is one opcode: the pointer width is the whole slot on
// a register backend and the i32 on wasm, so the conversion is written as the
// pair that is a no-op on whichever of the two the address already matches —
// the 64-bit extend or wrap for the narrow width, the pointer-width extend or
// wrap for the address. The floats are not here: the address reaches one
// through the 64-bit integer the source writes, and a direct conversion would
// need the same pairing again in the float domain.
// Whether `e as T` names a DESTINATION rather than a conversion. The
// conversion vocabulary converts to an integer, a char or a float and to
// nothing else, so any other target is the operand's own type written down —
// an ascription, which is the identity.
pub function cast_ascribes(to: typeinfo.Type): boolean {
    return !converts_as_integer(to) && !is_float(to);
}

pub function cast_admits(from: typeinfo.Type, to: typeinfo.Type): boolean {
    if (reinterprets(from, to)) { return true; }
    if (is_usize(from)) { return converts_as_integer(to); }
    if (is_usize(to)) { return converts_as_integer(from); }
    if (converts_as_integer(from) && converts_as_integer(to)) { return true; }
    if (is_float(from) && is_float(to)) { return true; }
    if (is_float(to)) { return is_integer(from); }
    if (is_float(from)) { return is_integer(to); }
    return false;
}

function cast_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "cast arity"; }
    if (!converts_as_integer(result) && !is_float(result) && !reference(result)) { return "cast result type"; }
    if (!cast_admits(f.values[ins.args[0]], result)) { return "cast operand type"; }
    return "";
}

function unary_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.args.len() != 1) { return "unary operator arity"; }
    var want: typeinfo.Type = unary_result(ins.str, f.values[ins.args[0]]);
    if (!semtypes.concrete(want, false) || !semtypes.equal(want, result)) { return "unary operator contract"; }
    return "";
}

// The operators over one scalar slot: the two written ones, and the conversion
// between the integer types.
pub function scalar_op(kind: i32): boolean { return kind == 9 || kind == 10 || kind == cast(); }

function scalar_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    if (ins.kind_tag == 9) { return binary_error(ins, f, result); }
    if (ins.kind_tag == 10) { return unary_error(ins, f, result); }
    return cast_error(ins, f, result);
}

// Constructions, projections and calls: the operations whose contract is a
// container's shape rather than a scalar's type.
// An array, a tuple and a record: the containers whose contract is a shape
// spelled out beside the value rather than in a declaration table.
function is_aggregate_op(kind: i32): boolean {
    return kind == array_new() || kind == tuple_new() || kind == array_get()
        || kind == tuple_get() || kind == record_new() || kind == record_get();
}

function aggregate_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    var kind: i32 = ins.kind_tag;
    if (kind == array_new()) { return array_construction_error(ins, f, result); }
    if (kind == tuple_new()) { return tuple_construction_error(ins, f, result); }
    if (kind == array_get()) { return array_projection_error(ins, f, result); }
    if (kind == tuple_get()) { return tuple_projection_error(ins, f, result); }
    if (kind == record_new()) { return record_construction_error(ins, f, result); }
    return record_projection_error(ins, f, result);
}

function composite_error(ins: ssa.SInst, f: Func, result: typeinfo.Type): string {
    var kind: i32 = ins.kind_tag;
    if (kind == zero()) { return zero_error(ins, result); }
    if (is_aggregate_op(kind)) { return aggregate_error(ins, f, result); }
    if (kind == call()) { return call_error(ins, f, result); }
    if (is_function_op(kind)) { return function_error(ins, f, result); }
    if (is_builtin_op(kind)) { return builtin_error(ins, f, result); }
    if (is_variant_op(kind)) { return variant_error(ins, f, result); }
    return "unsupported semantic operation";
}

// A zero names its type and nothing else: arity 0, and a result the layout
// tables can size, since the frame holds it in a slot and releases it.
function zero_error(ins: ssa.SInst, result: typeinfo.Type): string {
    if (ins.args.len() != 0) { return "zero arity"; }
    if (!semtypes.concrete(result, false)) { return "zero type"; }
    return "";
}

function instruction_error(ins: ssa.SInst, f: Func): string {
    if (ins.result < 0) { return "semantic operation needs a result"; }
    var result: typeinfo.Type = f.values[ins.result];
    var kind: i32 = ins.kind_tag;
    if (kind == 6) { return parameter_error(ins, f, result); }
    if (kind == 7 || kind == 8) { return copy_error(ins, f, result); }
    if (kind == 1 || kind == 2 || kind == 5) { return constant_error(ins, result); }
    if (scalar_op(kind)) { return scalar_error(ins, f, result); }
    return composite_error(ins, f, result);
}

// A function type is one word of code address, and the call through one
// carries the signature it dispatches by (`ssarc.signature_tag`), so a slot
// may be any width. A function type inside another is one word too, the
// environment box every function value is, so a parameter or result of
// function type is a slot when its own signature is (#10024). A void result is a word like any other: every backend hands one back from
// a void body, so the call stands in statement position like any void call.
function func_shape_error(fn: typeinfo.TypeFunc): string {
    if (!fn.params_known) { return "function type without a signature"; }
    for p in fn.param_types { if (!signature_slot(p)) { return "function signature slot"; } }
    if (!is_void(fn.ret_type) && !signature_slot(fn.ret_type)) { return "function signature slot"; }
    return "";
}

function signature_slot(t: typeinfo.Type): boolean {
    if let typeinfo.TypeFunc(inner) = t { return func_shape_error(inner) == ""; }
    if (nests_func(t)) { return false; }
    return semtypes.concrete(t, false);
}

// Where a function value may NOT sit: nested in a Map's key or value, or in
// an array of arrays, tuples or maps of them -- slots no release walk reaches
// yet. An array element and a tuple element are admitted: `ssarc.drop_elements`
// and `drop_tuple_fields` walk each through `drop_value`, which dispatches a
// function type to `drop_captures`, and `ssasem.reference` counts a function
// value, so the container knows it has children to walk. A Cell is not on the
// list because the checker refuses a Cell of any composite type (E057), so
// one never holds a function value.
function nests_func(t: typeinfo.Type): boolean {
    if let typeinfo.TypeArray(a) = t { return nests_func(a.elem); }
    if let typeinfo.TypeTuple(tup) = t {
        for e in tup.elements { if (nests_func(e)) { return true; } }
    }
    if let typeinfo.TypeMap(m) = t { return holds_func(m.key) || holds_func(m.value); }
    return false;
}

function holds_func(t: typeinfo.Type): boolean { return is_func(t) || nests_func(t); }

function type_placement_error(t: typeinfo.Type): string {
    if let typeinfo.TypeFunc(fn) = t { return func_shape_error(fn); }
    if (nests_func(t)) { return "function value is not an element"; }
    return "";
}

function field_placement_error(f: Func): string {
    for record in f.records {
        var env: boolean = semtypes.is_env(record.ty);
        for field in record.fields {
            if (!holds_func(field.ty)) { continue; }
            // A function value is a field like any other: the holder takes a
            // unit of it and its release walks it, which `semsource.env_rows`
            // makes possible from a frame that never built the box. A closure
            // box's own captures are no longer the exception they were — it
            // takes a unit of each since #9637, and its release walks them.
            // What stays refused is a function value NESTED in a field — an
            // array or tuple of them — which holds_func also answers to.
            if (is_func(field.ty)) { continue; }
            return "function value is not a field";
        }
    }
    // A variant's field is released by the same walk (`ssarc.drop_variant_fields`
    // selects the variant and drops its fields as a record's), so it holds a
    // function value under the same rule: directly, never nested.
    for e in f.enums {
        for v in e.variants {
            for field in v.fields { if (holds_func(field.ty) && !is_func(field.ty)) { return "function value is not a field"; } }
        }
    }
    return "";
}

function placement_error(f: Func): string {
    var named: typeinfo.Type[] = f.values.append(f.result);
    for c in f.calls {
        for t in c.params { named = named.append(t); }
        named = named.append(c.result);
    }
    for t in named {
        var why: string = type_placement_error(t);
        if (why != "") { return why; }
    }
    return field_placement_error(f);
}

// The graph's own dimensions, before any type is read off it: one type per
// value, one per declared parameter, and no closure environment, whose
// contract this vocabulary has no form for.
function dimension_error(f: Func): string {
    if (f.graph.nvals < 0 || f.values.len() != f.graph.nvals || f.params.len() != f.graph.nparams) { return "semantic type dimensions"; }
    if (f.graph.takes_env) { return "closure contract not available"; }
    return "";
}

function schema_error(f: Func): string {
    var why: string = dimension_error(f);
    if (why != "") { return why; }
    why = ssadeps.verify(f.graph, empty_dependencies(f.graph.nvals));
    if (why != "") { return why; }
    if (!semtypes.concrete(f.result, true)) { return "unresolved result type"; }
    // A void value is what a call to a void contract defines, and nothing
    // reads it: every operator and container contract asks for a concrete
    // operand, so a read refuses there.
    for t in f.values { if (!semtypes.concrete(t, true)) { return "unresolved value type"; } }
    for t in f.params { if (!semtypes.concrete(t, false)) { return "unresolved parameter type"; } }
    why = contracts_error(f.calls);
    if (why != "") { return why; }
    why = placement_error(f);
    if (why != "") { return why; }
    return semrecords.verify(f.records, f.enums);
}

// Contracts are a finite table keyed by callee name. A void result is the
// only void a contract may carry; parameters are values.
function contracts_error(calls: Contract[]): string {
    var i: i32 = 0;
    while (i < calls.len()) {
        var c: Contract = calls[i];
        if (c.name == "") { return "empty call contract name"; }
        if (find_contract(calls, c.name) != i) { return "duplicate call contract"; }
        if (c.modes.len() != c.params.len()) { return "call contract mode dimensions"; }
        for t in c.params { if (!semtypes.concrete(t, false)) { return "unresolved call parameter type"; } }
        if (!semtypes.concrete(c.result, true)) { return "unresolved call result type"; }
        i = i + 1;
    }
    return "";
}

function terminator_error(b: ssa.SBlock, f: Func): string {
    if (b.term.kind_tag == 1) {
        if (b.term.value < 0) {
            if (!is_void(f.result)) { return "missing return value"; }
        } else if (!semtypes.equal(f.result, f.values[b.term.value])) { return "return type"; }
    }
    if (b.term.kind_tag == 3 && !is_bool(f.values[b.term.cond])) { return "condition type"; }
    return "";
}

function operations_error(f: Func): string {
    var seen_params: i32 = 0;
    for b in f.graph.blocks {
        for ins in b.insts {
            var why: string = instruction_error(ins, f);
            if (why != "") { return why; }
            if (ins.kind_tag == 6) { seen_params = seen_params + 1; }
        }
        var why: string = terminator_error(b, f);
        if (why != "") { return why; }
    }
    // Result == parameter index plus unique SSA definitions rules out repeated
    // parameter indices; exact cardinality therefore proves full coverage.
    if (seen_params != f.params.len()) { return "missing parameter definition"; }
    return guard_error(f);
}

// The parameters whose storage the views a value holds read, following each
// view to the storage it projects whatever that storage's type. A literal's
// bytes are static and read none. Storage of anything else escapes, and so
// does a call to a callee outside the module; a module callee whose anchor is
// not known yet leaves the answer pending.
struct ViewSources { params: i32[], escapes: boolean, pending: boolean, seen: boolean[] }

function view_sources(f: Func, defs: ssa.SInst[], anchors: Anchor[], names: string[], v: i32, acc: ViewSources): ViewSources {
    if (v < 0 || v >= defs.len() || acc.escapes || acc.seen[v]) { return acc; }
    var out: ViewSources = ViewSources { ...acc, seen: acc.seen.with(v, true) };
    var d: ssa.SInst = defs[v];
    if (d.kind_tag == 6) {
        if (util.index_of_i32(out.params, d.imm) < 0) { out = ViewSources { ...out, params: out.params.append(d.imm) }; }
        return out;
    }
    if (d.kind_tag == 5) { return out; }
    if (d.kind_tag == 8) {
        for a in d.args { out = view_sources(f, defs, anchors, names, a, out); }
        return out;
    }
    if (d.kind_tag == tuple_new() || d.kind_tag == record_new() || d.kind_tag == variant_new() || d.kind_tag == array_new()) {
        for a in d.args { if (a >= 0 && semtypes.holds_view(f.values[a])) { out = view_sources(f, defs, anchors, names, a, out); } }
        return out;
    }
    if (projects(d.kind_tag)) { return view_sources(f, defs, anchors, names, d.args[0], out); }
    if (d.kind_tag == call()) {
        var k: i32 = anchor_of(anchors, d.str);
        if (k == 0 - 2) {
            if (util.index_of_str(names, d.str) >= 0) { return ViewSources { ...out, pending: true }; }
            return ViewSources { ...out, escapes: true };
        }
        if (k < 0 || k >= d.args.len()) { return out; }
        return view_sources(f, defs, anchors, names, d.args[k], out);
    }
    return ViewSources { ...out, escapes: true };
}

// The anchor a function's result carries: the one parameter every returned
// view reads, -1 when no returned view reads a parameter, -2 when one escapes
// its source, and -3 while a callee's anchor is still unknown.
pub function result_anchor(f: Func, anchors: Anchor[], names: string[]): i32 {
    var defs: ssa.SInst[] = definitions(f);
    var seen: boolean[] = [];
    var i: i32 = 0;
    while (i < defs.len()) { seen = seen.append(false); i = i + 1; }
    var acc: ViewSources = ViewSources { params: [], escapes: false, pending: false, seen: seen };
    for b in f.graph.blocks {
        if (b.term.kind_tag == 1 && b.term.value >= 0) { acc = view_sources(f, defs, anchors, names, b.term.value, acc); }
    }
    if (acc.escapes || acc.params.len() > 1) { return 0 - 2; }
    if (acc.pending) { return 0 - 3; }
    if (acc.params.len() == 0) { return 0 - 1; }
    return acc.params[0];
}

// Every value's defining instruction, indexed by value id; a value no
// instruction defines keeps the empty sentinel.
function definitions(f: Func): ssa.SInst[] {
    var none: ssa.SInst = ssa.SInst { kind_tag: 0, result: 0 - 1, args: [], imm: 0, str: "" };
    var out: ssa.SInst[] = [];
    var i: i32 = 0;
    while (i < f.values.len()) { out = out.append(none); i = i + 1; }
    for b in f.graph.blocks {
        for ins in b.insts { if (ins.result >= 0 && ins.result < out.len()) { out = out.with(ins.result, ins); } }
    }
    return out;
}

// The index of the block `target` names, when the edge from `from` is its
// only way in.
function sole_successor(f: Func, target: i32, from: i32): i32 {
    var i: i32 = 0;
    while (i < f.graph.blocks.len() && f.graph.blocks[i].id != target) { i = i + 1; }
    if (i == f.graph.blocks.len()) { return 0 - 1; }
    var succ: ssa.SBlock = f.graph.blocks[i];
    if (succ.preds.len() != 1 || succ.preds[0] != from) { return 0 - 1; }
    return i;
}

// held: the variants a test proved the value IS on every way into the block.
// gone: those a test proved it is NOT.
struct Known { held: string[], gone: string[] }

// What the tests of `value` have settled on every way into block `bi`. An
// edge settles nothing unless it is its successor's only way in, and unless
// that successor dominates `bi`.
function settled(f: Func, value: i32, bi: i32, dom: ssadeps.Dom, defs: ssa.SInst[]): Known {
    var held: string[] = [];
    var gone: string[] = [];
    var n: i32 = f.graph.blocks.len();
    var pi: i32 = 0;
    while (pi < n) {
        var b: ssa.SBlock = f.graph.blocks[pi];
        if (b.term.kind_tag == 3 && b.term.t != b.term.f && b.term.cond >= 0 && b.term.cond < defs.len()) {
            var test: ssa.SInst = defs[b.term.cond];
            if (test.kind_tag == variant_is() && test.args[0] == value) {
                var ti: i32 = sole_successor(f, b.term.t, b.id);
                if (ti >= 0 && ssadeps.dom_holds(dom, bi, ti)) { held = held.append(test.str); }
                var fi: i32 = sole_successor(f, b.term.f, b.id);
                if (fi >= 0 && ssadeps.dom_holds(dom, bi, fi)) { gone = gone.append(test.str); }
            }
        }
        pi = pi + 1;
    }
    return Known { held: held, gone: gone };
}

function names_has(names: string[], name: string): boolean {
    for n in names { if (n == name) { return true; } }
    return false;
}

// A variant is known outright when a test held for it, and by exclusion when
// every OTHER variant its enum declares has been refuted, since a value is
// one of them. The second is what a total match's last arm rests on: it
// carries no test of its own.
function guarded(f: Func, ins: ssa.SInst, bi: i32, dom: ssadeps.Dom, defs: ssa.SInst[]): boolean {
    var value: i32 = ins.args[0];
    var known: Known = settled(f, value, bi, dom, defs);
    if (names_has(known.held, ins.str)) { return true; }
    var at: i32 = semrecords.find_enum(f.enums, f.values[value]);
    if (at < 0) { return false; }
    for v in f.enums[at].variants {
        if (v.name != ins.str && !names_has(known.gone, v.name)) { return false; }
    }
    return true;
}

// A variant's field exists only while the value is that variant, so a
// projection must sit where that is known. A value never changes variant, so
// what a test settled holds for every later use of the value.
function guard_error(f: Func): string {
    var reachable: boolean[] = ssadeps.reachable_blocks(f.graph);
    var dom: ssadeps.Dom = ssadeps.dominates(f.graph);
    var defs: ssa.SInst[] = definitions(f);
    var bi: i32 = 0;
    while (bi < f.graph.blocks.len()) {
        if (reachable[bi]) {
            for ins in f.graph.blocks[bi].insts {
                if (needs_guard(ins.kind_tag) && !guarded(f, ins, bi, dom, defs)) { return "unguarded variant projection"; }
            }
        }
        bi = bi + 1;
    }
    return "";
}

// The operations whose result reads its source's storage, so each borrows that
// source exactly as a projection does. A widening, a narrowing and a string
// retag hand back the same box. A map cursor is its own block, but it holds the
// map's address and nothing else, so a read through it is a read of the map;
// its key and value reads are in turn projections of the cursor, which anchors
// them to the map through it.
function projects(kind: i32): boolean {
    return kind == 7 || kind == array_get() || kind == tuple_get() || kind == record_get()
        || kind == variant_get() || kind == variant_up() || kind == variant_as()
        || kind == slice() || kind == str_as() || kind == dyn_up()
        || kind == map_iter() || kind == mapiter_key() || kind == mapiter_value();
}

// An address is the box's own slot read as an integer: it owns nothing and
// converts nothing, so its type says it anchors nothing while every read
// through it reads the source's storage.
function borrows_storage(ins: ssa.SInst, f: Func): boolean {
    if (ins.kind_tag != cast()) { return false; }
    return reference(f.values[ins.args[0]]) && is_usize(f.values[ins.result]);
}

// The value holding the bytes a value's views read: a view is followed to its
// source, and a construction or a phi to the one source its operands share. -1
// when it reads none (a literal, a payload-less variant), -2 when it reads two.
function bytes_root(f: Func, defs: ssa.SInst[], v: i32, seen: boolean[]): i32 {
    if (v < 0 || v >= defs.len() || seen[v]) { return 0 - 1; }
    var d: ssa.SInst = defs[v];
    var next: boolean[] = seen.with(v, true);
    // A retag is the same box, whichever way it goes.
    if (d.kind_tag == str_as() && d.args.len() == 1) { return bytes_root(f, defs, d.args[0], next); }
    if (!semtypes.holds_view(f.values[v])) { return v; }
    if (d.kind_tag == 5) { return 0 - 1; }
    if (projects(d.kind_tag) && d.args.len() > 0) { return bytes_root(f, defs, d.args[0], next); }
    if (d.kind_tag == call()) {
        var k: i32 = anchor_of(f.anchors, d.str);
        if (k == 0 - 1) { return 0 - 1; }
        if (k >= 0 && k < d.args.len()) { return bytes_root(f, defs, d.args[k], next); }
        return v;
    }
    if (!gathers_views(d.kind_tag)) { return v; }
    var root: i32 = 0 - 1;
    for a in d.args {
        if (a < 0 || (d.kind_tag != 8 && !semtypes.holds_view(f.values[a]))) { continue; }
        if (counted_view(f, defs, a, next)) { continue; }
        var r: i32 = bytes_root(f, defs, a, next);
        if (r == 0 - 2) { return r; }
        if (r >= 0) {
            if (root < 0) { root = r; } else if (root != r) { return 0 - 2; }
        }
    }
    return root;
}

// A view whose box is a counted string's own — a string retagged, a literal,
// or a phi of those — carries its bytes in the unit its holder takes, so it
// anchors nothing.
function counted_view(f: Func, defs: ssa.SInst[], v: i32, seen: boolean[]): boolean {
    if (v < 0 || v >= defs.len() || seen[v]) { return true; }
    var d: ssa.SInst = defs[v];
    if (d.kind_tag == 5) { return true; }
    if (d.kind_tag == str_as() && d.args.len() == 1) { return !is_view(f.values[d.args[0]]); }
    if (d.kind_tag != 8) { return false; }
    var next: boolean[] = seen.with(v, true);
    for a in d.args { if (!counted_view(f, defs, a, next)) { return false; } }
    return true;
}

// A phi or a construction: a value made of its operands, whose views it holds.
function gathers_views(kind: i32): boolean {
    return kind == 8 || kind == tuple_new() || kind == record_new() || kind == variant_new() || kind == array_new();
}

// A value that gathers views is anchored to the bytes they read, which its own
// operands' anchors stop short of once it holds them.
function view_roots(f: Func, parents: i32[]): i32[] {
    var defs: ssa.SInst[] = definitions(f);
    var none: boolean[] = [];
    var i: i32 = 0;
    while (i < f.graph.nvals) { none = none.append(false); i = i + 1; }
    var out: i32[] = parents;
    for b in f.graph.blocks {
        for ins in b.insts {
            if (ins.result < 0 || !gathers_views(ins.kind_tag) || !semtypes.holds_view(f.values[ins.result])) { continue; }
            var root: i32 = bytes_root(f, defs, ins.result, none);
            if (root == 0 - 2) { return []; }
            if (root >= 0 && root != ins.result) { out = out.with(ins.result, root); }
        }
    }
    return out;
}

function borrow_parents(f: Func): i32[] {
    var parents: i32[] = [];
    var i: i32 = 0;
    while (i < f.graph.nvals) { parents = parents.append(0 - 1); i = i + 1; }
    for b in f.graph.blocks {
        for ins in b.insts {
            var anchors: boolean = projects(ins.kind_tag) && semtypes.needs_anchor(f.values[ins.result]);
            if (anchors || borrows_storage(ins, f)) {
                parents = parents.with(ins.result, ins.args[0]);
            }
            if (ins.kind_tag == call()) {
                var k: i32 = anchor_of(f.anchors, ins.str);
                if (k >= 0 && k < ins.args.len()) { parents = parents.with(ins.result, ins.args[k]); }
            }
        }
    }
    return view_roots(f, parents);
}

function analyze_parents(f: Func, parents: i32[]): Analysis {
    var derived: i32[][] = [];
    var i: i32 = 0;
    while (i < f.graph.nvals) {
        var chain: i32[] = [];
        var at: i32 = parents[i];
        while (at >= 0) {
            // Unreachable blocks have no dominance obligation, so reject their
            // possible parent cycles explicitly rather than looping forever.
            if (at == i || chain.len() >= f.graph.nvals) { return failed("cyclic semantic projection"); }
            chain = chain.append(at);
            at = parents[at];
        }
        derived = derived.append(chain);
        i = i + 1;
    }
    var flow: ssalive.Flow = ssadeps.analyze(f.graph, derived);
    if (!flow.ok) { return failed(flow.why); }
    return Analysis { ok: true, why: "", dependencies: derived, flow: flow };
}

// Dependencies are derived from typed operations, not accepted as a sidecar
// assertion. Copies preserve a borrow's source identity; managed projections
// borrow their actual container. Construction and phis have no parent anchor:
// their independent counted supplies are obligations of the later unit pass.
// The callee names this graph names in a call instruction.
//
// `ssarc.bracketed` reads the module's grow table only under these names, so
// they are the whole of what a body's lowering depends on outside its own
// graph, plan and modes — which is what `semlower` tests before keeping a body
// across a second lowering.
pub function called_names(f: Func): string[] {
    var out: string[] = [];
    for b in f.graph.blocks {
        for ins in b.insts {
            if (ins.kind_tag == call() && ins.str != "" && !name_seen(out, ins.str)) { out = out.append(ins.str); }
        }
    }
    return out;
}

function name_seen(names: string[], name: string): boolean {
    for n in names { if (n == name) { return true; } }
    return false;
}

pub function analyze(f: Func): Analysis {
    var why: string = schema_error(f);
    if (why != "") { return failed(why); }
    why = operations_error(f);
    if (why != "") { return failed(why); }
    var parents: i32[] = borrow_parents(f);
    if (parents.len() != f.graph.nvals) { return failed("a value holds views of two sources"); }
    return analyze_parents(f, parents);
}

// ---- self-tail recursion ----------------------------------------------------

// A self-recursive call in tail position reuses its own activation on the AST
// lowering, which gets `irlower.tco_self_tail` out of `lower_func`. A produced
// body never reaches `lower_func`, so until now it grew the stack once per
// iteration and a deep enough recursion took the program's stack out (#9692).
//
// The rewrite is on the GRAPH, before the unit planner and the RC lowering see
// it, and that placement is the point rather than a convenience: a tail call
// HANDS ITS ARGUMENTS OVER and a jump does not. Only the planner knows which
// arguments carry a unit, so a rewrite applied after it has planned would
// leave a transfer planned for a call that is no longer there. Rewritten
// first, the loop is an ordinary loop and the planner brackets it as one.
//
// The shape: the entry block is SPLIT. It keeps its id and its index, because
// the lowering reads `blocks[0]` as the entry, and becomes an empty block
// branching to a new HEADER that holds everything it had. The header takes one
// phi per parameter, merging the incoming argument with the one each tail call
// passes, and every use of a parameter becomes a use of its phi. Each tail
// call drops its call instruction and branches to the header.
pub function tail_recursion(own f: Func, name: string): Func {
    if (name.len() == 0 || f.graph.blocks.len() == 0) { return f; }
    if (f.graph.blocks[0].preds.len() > 0) { return f; }
    var nparams: i32 = f.graph.nparams;
    if (f.values.len() < nparams) { return f; }
    var parents: i32[] = borrow_parents(f);
    if (parents.len() != f.graph.nvals) { return f; }
    var tails: i32[] = tail_blocks(f, name, nparams, parents);
    if (tails.len() == 0) { return f; }
    return spliced(f, tails, nparams);
}

// A view PARAMETER's phi merges the incoming argument with what each tail
// call passes, and a call passing a view of anything is declined per block
// below (`borrowed_arg`), so every operand is a parameter passed whole: all
// borrowed, and the planner leaves such a phi unowned (#9802). Before that
// rule the planner owned every reference-typed phi, the entry edge retained
// the view with a no-op and the exit released it with a free, and this pass
// declined any function with a view parameter to stay out of it.
// The blocks whose last instruction is a self-call the terminator returns.
// Nothing follows such a call, so its result has no other reader: the block
// ends there. A void body spells the same shape with a statement call and a
// valueless return.
function tail_blocks(f: Func, name: string, nparams: i32, parents: i32[]): i32[] {
    var out: i32[] = [];
    var bi: i32 = 0;
    while (bi < f.graph.blocks.len()) {
        if (is_self_tail(f, f.graph.blocks[bi], name, nparams, parents)) { out = out.append(bi); }
        bi = bi + 1;
    }
    return out;
}

// An argument that is a VIEW of something cannot travel a jump. The call kept
// its anchor alive: the anchor is this frame's, and the frame stands until the
// callee returns. A jump re-enters the loop, where the anchor is a parameter
// the phi has just replaced or a local the iteration has just finished with —
// either way dead, and the view left pointing into a buffer the next release
// frees. `irlower.rc_consumed_drop_wired` is the shape: it recurses on
// `slice_unchecked(t, 0, t.len() - 2)`, a view of the very parameter the
// argument replaces, and rewriting it corrupted the heap of every compiler
// built through this path (#9692).
//
// Nothing here is a view's fault — a tail call with a fresh argument, or one
// that passes a parameter along whole, has no anchor to lose and still
// rewrites. This declines the ONE block, not the function: a call that stays a
// call keeps holding what it holds.
function borrowed_arg(args: i32[], parents: i32[]): boolean {
    for a in args { if (a >= 0 && a < parents.len() && parents[a] >= 0) { return true; } }
    return false;
}

function is_self_tail(f: Func, b: ssa.SBlock, name: string, nparams: i32, parents: i32[]): boolean {
    if (b.term.kind_tag != 1 || b.insts.len() == 0) { return false; }
    var last: ssa.SInst = b.insts[b.insts.len() - 1];
    if (last.kind_tag != call() || last.str != name || last.args.len() != nparams) { return false; }
    if (borrowed_arg(last.args, parents)) { return false; }
    if (b.term.value == last.result) { return true; }
    return b.term.value < 0 && is_void(f.result);
}

// The arguments each tail call passes, read BEFORE the parameter uses are
// rewritten and mapped afterwards, so an argument that is a parameter itself
// (`return f(n - 1, acc)`) carries the phi the loop is re-entered with rather
// than the value the function was first called on.
function tail_args(f: Func, tails: i32[]): i32[][] {
    var out: i32[][] = [];
    for bi in tails {
        var insts: ssa.SInst[] = f.graph.blocks[bi].insts;
        out = out.append(insts[insts.len() - 1].args);
    }
    return out;
}

function fresh_block_id(f: Func): i32 {
    var top: i32 = 0;
    for b in f.graph.blocks { if (b.id > top) { top = b.id; } }
    return top + 1;
}

// param_phis maps parameter i to the phi that replaces it. The map is over
// EVERY value, so a rewrite of an instruction's operands is one lookup rather
// than a search.
function phi_map(f: Func, nparams: i32): i32[] {
    var map: i32[] = [];
    var v: i32 = 0;
    while (v < f.graph.nvals) {
        if (v < nparams) { map = map.append(f.graph.nvals + v); } else { map = map.append(v); }
        v = v + 1;
    }
    return map;
}

function mapped(map: i32[], v: i32): i32 {
    if (v < 0 || v >= map.len()) { return v; }
    return map[v];
}

function mapped_list(map: i32[], vs: i32[]): i32[] {
    var out: i32[] = [];
    for v in vs { out = out.append(mapped(map, v)); }
    return out;
}

function mapped_inst(map: i32[], ins: ssa.SInst): ssa.SInst {
    return ssa.SInst { ...ins, args: mapped_list(map, ins.args) };
}

function mapped_ret_term(map: i32[], t: ssa.STerm): ssa.STerm {
    if (t.kind_tag == 1) { return ssa.STerm { ...t, value: mapped(map, t.value) }; }
    if (t.kind_tag == 3) { return ssa.STerm { ...t, cond: mapped(map, t.cond) }; }
    return t;
}

// spliced performs the rewrite: it is one pass over the blocks with the
// parameter map applied, then the header assembled from what block 0 held.
//
// The entry block can BE a tail block — an unconditional self-call, which is
// how a parameterless event loop is written. Everything it holds moves to the
// header anyway, so what changes is that the header keeps the branch instead
// of the return, and the edge that tail contributes comes from the header
// rather than from the entry.
function spliced(own f: Func, tails: i32[], nparams: i32): Func {
    var args: i32[][] = tail_args(f, tails);
    var map: i32[] = phi_map(f, nparams);
    var header: i32 = fresh_block_id(f);
    var entry: ssa.SBlock = f.graph.blocks[0];
    var loops: boolean = util.index_of_i32(tails, 0) >= 0;
    var preds: i32[] = [entry.id];
    for bi in tails { if (bi == 0) { preds = preds.append(header); } else { preds = preds.append(f.graph.blocks[bi].id); } }

    // The parameter definitions STAY in the entry block: ssadeps.verify reads a
    // `param` instruction anywhere else as a malformed graph, and they are also
    // what the entry edge's phi operands name.
    var blocks: ssa.SBlock[] = [ssa.SBlock { id: entry.id, insts: kind_6(entry.insts), term: ssa.STerm { kind_tag: 2, cond: 0, target: header, t: 0, f: 0, value: 0 }, preds: [] }];
    var head_insts: ssa.SInst[] = phis(f, map, args, nparams);
    for ins in rewritten(map, not_kind_6(without_tail_call(entry.insts, loops))) { head_insts = head_insts.append(ins); }
    var head_term: ssa.STerm = mapped_ret_term(map, entry.term);
    if (loops) { head_term = ssa.STerm { kind_tag: 2, cond: 0, target: header, t: 0, f: 0, value: 0 }; }
    blocks = blocks.append(ssa.SBlock { id: header, insts: head_insts, term: head_term, preds: preds });
    var bi: i32 = 1;
    while (bi < f.graph.blocks.len()) {
        blocks = blocks.append(rewritten_block(f.graph.blocks[bi], map, header, entry.id, util.index_of_i32(tails, bi) >= 0));
        bi = bi + 1;
    }

    var values: typeinfo.Type[] = f.values;
    var p: i32 = 0;
    while (p < nparams) { values = values.append(f.values[p]); p = p + 1; }
    var graph: ssa.SFunc = ssa.SFunc { ...f.graph, nvals: f.graph.nvals + nparams, blocks: blocks };
    return Func { ...f, graph: graph, values: values };
}

// A tail block loses its call and branches to the header; every other block
// keeps its own terminator. Every block reached FROM the entry is now reached
// from the header instead, so the entry's id leaves their predecessor lists in
// the same slot the header takes — the slot is what a phi's operands are
// parallel to, so it has to be the same one.
function rewritten_block(b: ssa.SBlock, map: i32[], header: i32, entry: i32, tail: boolean): ssa.SBlock {
    var preds: i32[] = repointed(b.preds, entry, header);
    if (!tail) { return ssa.SBlock { ...b, insts: rewritten(map, b.insts), term: mapped_ret_term(map, b.term), preds: preds }; }
    var kept: ssa.SInst[] = [];
    var i: i32 = 0;
    while (i + 1 < b.insts.len()) { kept = kept.append(mapped_inst(map, b.insts[i])); i = i + 1; }
    return ssa.SBlock { ...b, insts: kept, term: ssa.STerm { kind_tag: 2, cond: 0, target: header, t: 0, f: 0, value: 0 }, preds: preds };
}

function repointed(preds: i32[], from: i32, to: i32): i32[] {
    var out: i32[] = [];
    for p in preds { if (p == from) { out = out.append(to); } else { out = out.append(p); } }
    return out;
}

// The block's instructions without the self-call that ended it.
function without_tail_call(insts: ssa.SInst[], drop: boolean): ssa.SInst[] {
    if (!drop) { return insts; }
    var out: ssa.SInst[] = [];
    var i: i32 = 0;
    while (i + 1 < insts.len()) { out = out.append(insts[i]); i = i + 1; }
    return out;
}

// The parameter definitions, and everything else, in their original order.
function kind_6(insts: ssa.SInst[]): ssa.SInst[] {
    var out: ssa.SInst[] = [];
    for ins in insts { if (ins.kind_tag == 6) { out = out.append(ins); } }
    return out;
}

function not_kind_6(insts: ssa.SInst[]): ssa.SInst[] {
    var out: ssa.SInst[] = [];
    for ins in insts { if (ins.kind_tag != 6) { out = out.append(ins); } }
    return out;
}

function rewritten(map: i32[], insts: ssa.SInst[]): ssa.SInst[] {
    var out: ssa.SInst[] = [];
    for ins in insts { out = out.append(mapped_inst(map, ins)); }
    return out;
}

// One phi per parameter, its operands parallel to the header's predecessors:
// the entry edge carries the parameter itself, each tail edge the argument
// that call passed.
function phis(f: Func, map: i32[], args: i32[][], nparams: i32): ssa.SInst[] {
    var out: ssa.SInst[] = [];
    var p: i32 = 0;
    while (p < nparams) {
        var ops: i32[] = [p];
        for a in args { ops = ops.append(mapped(map, a[p])); }
        out = out.append(ssa.SInst { kind_tag: 8, result: map[p], args: ops, imm: 0, str: "" });
        p = p + 1;
    }
    return out;
}
