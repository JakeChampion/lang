// examples/self_host/watbin.fern — the self-hosted WAT->binary wasm
// assembler as a single importable module: the canonical home for the
// LEB128 encoders, the WAT lexer/parser, and the binary opcode/section
// encoder. It is ONE module on purpose — cross-module references need
// qualification (`mod.Name`), but a single module keeps every internal
// reference bare, which is also what the encoder's stdin-concatenation
// unit tests rely on. The lone public entry is wat_to_binary(); the rest
// is module-internal. The per-stage sections below (LEB128 / wat_lex /
// wat_parse / wat_encode / wat_emit_bin) keep their original headers.

// examples/self_host/leb128.fern — LEB128 byte encoders for the
// self-hosted *binary* wasm emitter (the first slice of the binary
// backend; the WAT-text emitter lives in wasm.fern).
//
// LEB128 is the variable-length integer encoding the wasm binary format
// uses for every count, size, index, and `*.const` operand: 7 payload
// bits per byte, the high bit (0x80) marking "more bytes follow".
// Unsigned values (counts / sizes / indices) use `leb_u32`; signed
// operands (`i32.const` / `i64.const`) use `leb_i32` / `leb_i64`.
//
// Design notes:
//   * A byte buffer is an `i32[]` of values in 0..255; each function
//     appends to it and returns the (possibly grown) buffer, matching the
//     `buf = leb_u32(buf, v)` idiom.
//   * This module is intentionally **import-free** so (a) the binary
//     encoder can `import "./leb128"` and (b) the unit test can
//     concatenate this file with a driver `main()` and feed the whole
//     thing to the single-module wasm_run driver.
//   * Fern's `>>` is an arithmetic (sign-preserving) shift. `leb_u32`
//     therefore masks off the sign-extended top bits after each shift so
//     it is correct for the full unsigned 32-bit range (not just small
//     non-negative values); `leb_i32` / `leb_i64` rely on the arithmetic
//     shift, which is exactly what signed LEB128 needs.

// MASK25 = (1 << 25) - 1 keeps bits 0..24, clearing the 7 bits a `>> 7`
// may have sign-extended — turning the arithmetic shift into a logical
// one for the unsigned encoder.
function leb128_mask25(): i32 {
  return 33554431;
}

// leb_u32 appends the unsigned LEB128 encoding of `value` (interpreted as
// a 32-bit unsigned integer) to `buf`.
pub function leb_u32(buf: i32[], value: i32): i32[] {
  let v: i32 = value;
  let more: boolean = true;
  while (more) {
    let b: i32 = v & 127;
    v = v >> 7 & leb128_mask25();
    if (v == 0) {
      more = false;
    } else {
      b = b | 128;
    }
    buf = buf.append(b);
  }
  return buf;
}

// leb_i32 appends the signed LEB128 encoding of `value` to `buf`.
pub function leb_i32(buf: i32[], value: i32): i32[] {
  let v: i32 = value;
  let more: boolean = true;
  while (more) {
    let b: i32 = v & 127;
    v = v >> 7;
    let sign: i32 = b & 64;
    if (v == 0 && sign == 0 || v == 0 - 1 && sign != 0) {
      more = false;
    } else {
      b = b | 128;
    }
    buf = buf.append(b);
  }
  return buf;
}

// leb_i64 appends the signed LEB128 encoding of a 64-bit `value` to `buf`.
function leb_i64(buf: i32[], value: i64): i32[] {
  let v: i64 = value;
  let more: boolean = true;
  while (more) {
    let b: i32 = (v & 127) as i32;
    v = v >> 7;
    let sign: i32 = b & 64;
    if (v == 0 && sign == 0 || v == 0 - 1 && sign != 0) {
      more = false;
    } else {
      b = b | 128;
    }
    buf = buf.append(b);
  }
  return buf;
}

// examples/self_host/wat_lex.fern — tokenizer for the folded-S-expression
// WAT text that wasm.fern's emit_module produces. Slice 2 of the
// self-hosted *binary* wasm backend: the binary emitter assembles that
// already-tested WAT rather than re-deriving lowering from the AST, so it
// depends on the proven text emitter and only does the mechanical
// text -> bytes mapping. This module turns the WAT string into a flat
// token stream; a later slice parses the tokens into module structure and
// encodes it with leb128.fern.
//
// WAT lexical grammar (the regular subset emit_module emits):
//   * `(` and `)`            — list delimiters
//   * "…"                    — a string literal (only in `(data … "…")`);
//                              may contain `\NN` hex and `\"` / `\\` escapes
//   * everything else        — an atom: instruction names (`i32.add`),
//                              keywords (`module`, `func`, `param`, `mut`,
//                              …), `$identifiers`, types (`i32`), numbers
// Whitespace (space / tab / CR / LF) separates tokens and is discarded.
//
// Import-free on purpose (like leb128.fern): the assembler can
// `import "./wat_lex"`, and the unit test can concatenate this file with a
// driver (the single-module wasm_run driver doesn't resolve imports).

// WatTok.kind: 0 = "(", 1 = ")", 2 = atom, 3 = string. For a string token
// `text` is the raw content between the quotes, escapes left verbatim
// (`\0a` stays `\0a`) — they are resolved when the data section is encoded.
pub struct WatTok { kind: i32, text: string }

// wat_is_space reports the ASCII whitespace bytes WAT uses.
function wat_is_space(c: i32): boolean {
  return c == 32 || c == 9 || c == 10 || c == 13;
}

// wat_tokenize splits WAT source into its token stream.
function wat_tokenize(src: string): WatTok[] {
  let toks: WatTok[] = [];
  let i: i32 = 0;
  let n: i32 = src.len();
  while (i < n) {
    let c: i32 = src[i] as i32;
    if (wat_is_space(c)) {
      i = i + 1;
    } else if (c == 40) {
      toks = toks.append(WatTok { kind: 0, text: "(" });
      i = i + 1;
    } else if (c == 41) {
      toks = toks.append(WatTok { kind: 1, text: ")" });
      i = i + 1;
    } else if (c == 34) {
      // String literal. Find the closing quote, skipping any escaped
      // byte after a backslash so an escaped `\"` doesn't end it. The
      // raw content (escapes intact) is captured; the encoder resolves
      // `\NN` later.
      let start: i32 = i + 1;
      let j: i32 = start;
      while (j < n && src[j] != b'"') {
        if (src[j] == b'\\') {
          j = j + 2;
        } else {
          j = j + 1;
        }
      }
      toks = toks.append(WatTok { kind: 3, text: slice_unchecked(src, start, j) + "" });
      i = j + 1;
    } else {
      // Atom: run up to the next whitespace, paren, or quote.
      let astart: i32 = i;
      while (i < n) {
        let ch: i32 = src[i] as i32;
        if (wat_is_space(ch) || ch == 40 || ch == 41 || ch == 34) {
          break;
        }
        i = i + 1;
      }
      toks = toks.append(WatTok { kind: 2, text: slice_unchecked(src, astart, i) + "" });
    }
  }
  return toks;
}

// examples/self_host/wat_parse.fern — S-expression parser for the WAT
// token stream produced by wat_lex.fern. Slice 3 of the self-hosted
// *binary* wasm backend: tokenize (wat_lex) -> parse to a tree (here) ->
// encode the tree to bytes with leb128.fern (a later slice).
//
// The grammar is just nested lists of atoms / strings:
//   sexpr := atom | string | "(" sexpr* ")"
// so a recursive-descent parse over the flat token array builds a tree of
// SExpr nodes. Parsing one node returns the node plus the index of the
// token after it (ParseOne), so the caller can continue scanning siblings.
//
// Depends on WatTok (from wat_lex.fern) but is otherwise import-free, so
// the encoder can `import` both and the unit test can concatenate
// wat_lex.fern + this file + a driver (the single-module wasm_run driver
// doesn't resolve imports).

// SExpr.kind: 0 = list (children in `items`, `text` empty), 2 = atom,
// 3 = string (token text in `text`, `items` empty).
pub struct SExpr { kind: i32, text: string, items: SExpr[] }

// ParseOne carries a parsed node plus the index just past it.
pub struct ParseOne { node: SExpr, pos: i32 }

// wat_parse_one parses the single S-expr starting at toks[i].
function wat_parse_one(toks: WatTok[], i: i32): ParseOne {
  let t: WatTok = toks[i];
  if (t.kind != 0) {
    // Leaf: atom (kind 2) or string (kind 3).
    return ParseOne { node: SExpr { kind: t.kind, text: t.text, items: [] }, pos: i + 1 };
  }
  // List: consume children until the matching ")".
  let children: SExpr[] = [];
  let j: i32 = i + 1;
  while (j < toks.len() && toks[j].kind != 1) {
    let r: ParseOne = wat_parse_one(toks, j);
    children = children.append(r.node);
    j = r.pos;
  }
  // Skip the closing ")".
  return ParseOne { node: SExpr { kind: 0, text: "", items: children }, pos: j + 1 };
}

// wat_parse parses the whole token stream into its top-level S-expr (the
// `(module …)` form emit_module produces).
function wat_parse(toks: WatTok[]): SExpr {
  let r: ParseOne = wat_parse_one(toks, 0);
  return r.node;
}

// examples/self_host/wat_encode.fern — byte-emission primitives for the
// self-hosted *binary* wasm backend. Slice 4a: the low-level building
// blocks the module-walker (a later slice) uses to turn a parsed WAT
// SExpr tree into a wasm binary module. Pipeline:
//   tokenize (wat_lex) -> parse (wat_parse) -> ENCODE (wat_encode) -> .wasm
//
// A byte buffer is an `i32[]` of 0..255 values, matching leb128.fern's
// `buf = f(buf, …)` idiom. These helpers wrap the wasm binary format's
// recurring shapes:
//   * a *vec(T)* is `LEB_u32(count)` followed by the elements' bytes;
//   * a *name* is a vec of its UTF-8 bytes (`LEB_u32(len)` + bytes);
//   * a *section* is `id` + `LEB_u32(byte_len)` + contents.
//
// Depends on leb128.fern's leb_u32 / leb_i32 but is otherwise import-free,
// so the encoder can `import` both and the unit test can concatenate
// leb128.fern + this file + a driver (wasm_run doesn't resolve imports).

// wcat appends every byte of `src` to `buf`.
pub function wcat(buf: i32[], src: i32[]): i32[] {
  let i: i32 = 0;
  while (i < src.len()) {
    buf = buf.append(src[i]);
    i = i + 1;
  }
  return buf;
}

// wstr_bytes appends the raw bytes of `s` (each char is one byte in the
// self-host string representation).
function wstr_bytes(buf: i32[], s: string): i32[] {
  let i: i32 = 0;
  while (i < s.len()) {
    buf = buf.append(s[i] as i32);
    i = i + 1;
  }
  return buf;
}

// wname appends a wasm `name`: LEB_u32(len) then the UTF-8 bytes.
pub function wname(buf: i32[], s: string): i32[] {
  buf = leb_u32(buf, s.len());
  return wstr_bytes(buf, s);
}

// wsection wraps `contents` as a top-level section: the id byte, the
// LEB_u32 byte length, then the contents.
pub function wsection(id: i32, contents: i32[]): i32[] {
  let o: i32[] = [];
  o = o.append(id);
  o = leb_u32(o, contents.len());
  return wcat(o, contents);
}

// wvec builds a `vec`: LEB_u32(count) then the already-encoded element
// bytes.
function wvec(count: i32, elems: i32[]): i32[] {
  let o: i32[] = [];
  o = leb_u32(o, count);
  return wcat(o, elems);
}

// valtype_byte maps a WAT value-type spelling to its wasm binary code.
// global_valtype names the declared type of a `(global $n (mut T) init)` or
// `(global $n T init)` node, defaulting to i32 for a shape neither matches —
// the assumption this function replaced, kept as the fallback so a malformed
// node degrades exactly as it used to rather than into a different valtype.
function global_valtype(gn: SExpr): string {
  if (gn.items.len() < 3) {
    return "i32";
  }
  let ty: SExpr = gn.items[2];
  if (ty.kind == 2) {
    return ty.text;
  }
  if (node_head(ty) == "mut" && ty.items.len() > 1 && ty.items[1].kind == 2) {
    return ty.items[1].text;
  }
  return "i32";
}

function valtype_byte(t: string): i32 {
  if (t == "i32") {  // 0x7f
    return 127;
  }
  if (t == "i64") {  // 0x7e
    return 126;
  }
  if (t == "f32") {  // 0x7d
    return 125;
  }
  if (t == "f64") {  // 0x7c
    return 124;
  }
  if (t == "funcref") {  // 0x70
    return 112;
  }
  if (t == "v128") {  // 0x7b — the vector kernels' local type
    return 123;
  }
  return 127;
}

// wmagic emits the 8-byte module preamble: "\0asm" + version 1.
function wmagic(): i32[] {
  let o: i32[] = [];
  o = o.append(0);
  o = o.append(97);
  o = o.append(115);
  o = o.append(109);
  o = o.append(1);
  o = o.append(0);
  o = o.append(0);
  o = o.append(0);
  return o;
}

// examples/self_host/wat_emit_bin.fern — the module-walker + opcode
// encoder: the back end of the self-hosted *binary* wasm emitter. Walks
// the parsed WAT SExpr tree (from wat_parse.fern) and emits a wasm binary
// module via the leb128 + wat_encode primitives. Pipeline:
//   tokenize (wat_lex) -> parse (wat_parse) -> ENCODE (this) -> .wasm
//
// Coverage: integer / control-flow / i32+i64+f64 / struct / string / map
// / closure programs — i.e. the full core-module shape emit_module
// produces. Sections are emitted in binary id order (type, import, func,
// table, memory, global, export, elem, code, data). The type section
// holds the named `(type $c …)` declarations first (referenced by
// call_indirect), then one functype per function (imports first; no
// dedup — valid, just slightly larger), so a function's type index is
// offset by the named-type count. Folded instructions encode post-order
// (operands then operator) with per-instruction immediate handling, and a
// control-frame stack resolves br / br_if label depths.
//
// Depends on leb128.fern, wat_lex.fern (WatTok) and wat_parse.fern (SExpr)
// but is otherwise import-free, so the encoder driver imports all of them
// and the unit test concatenates the sources + a driver.

// ---- small helpers -------------------------------------------------------

// index_of_str returns the index of `n` in `xs`, or -1. (A local copy so
// this module stays usable on its own / concatenated.)
function index_of_str(xs: string[], n: string): i32 {
  let i: i32 = 0;
  while (i < xs.len()) {
    if (xs[i] == n) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// name_idx resolves a `$name` reference, refusing one nothing defines: its
// index would encode as 2^32-1, which wasmtime reports only as an
// out-of-bounds index in an unnamed function.
function name_idx(names: string[], n: string): i32 {
  let k: i32 = index_of_str(names, n);
  if (k < 0) {
    eprint("watbin: reference to undefined " + n);
    exit(1);
  }
  return k;
}

// node_head returns the head-atom text of a list node ("" if not a list
// or the head isn't an atom).
function node_head(n: SExpr): string {
  if (n.kind == 0 && n.items.len() > 0 && n.items[0].kind == 2) {
    return n.items[0].text;
  }
  return "";
}

// Parse WAT integer immediates, including signed hexadecimal spellings.
// Keep the historical names because decimal indices use the same helpers.
function parse_dec(s: string): i32 {
  let neg: boolean = false;
  let i: i32 = 0;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  } else if (s.len() > 0 && s[0] == b'+') {
    i = 1;
  }
  let base: i32 = 10;
  if (s.len() > i + 2 && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
    base = 16;
    i = i + 2;
  }
  let v: i32 = 0;
  while (i < s.len()) {
    if (s[i] != b'_') {
      v = v * base + hexval(s[i] as i32);
    }
    i = i + 1;
  }
  if (neg) {
    return 0 - v;
  }
  return v;
}

// The i64 counterpart preserves the full immediate before LEB encoding.
function parse_dec_i64(s: string): i64 {
  let neg: boolean = false;
  let i: i32 = 0;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  } else if (s.len() > 0 && s[0] == b'+') {
    i = 1;
  }
  let base: i64 = 10;
  if (s.len() > i + 2 && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
    base = 16;
    i = i + 2;
  }
  let v: i64 = 0;
  while (i < s.len()) {
    if (s[i] != b'_') {
      v = v * base + hexval(s[i] as i32) as i64;
    }
    i = i + 1;
  }
  let z: i64 = 0;
  if (neg) {
    return z - v;
  }
  return v;
}

// parse_f64 parses a decimal float literal (sign, integer part, optional
// fraction, optional e±exponent) into the NEAREST f64 — round-to-nearest,
// ties-to-even, bit-exact with a correctly-rounding strtod (SH-004). The
// old digit-by-digit accumulation was within ~1 ULP but not exact, so the
// in-process assemble of a 17-digit round-trip spelling (e.g. the
// compiler's own libm constant tables) could differ from the GNU-as path
// by an ULP.
//
// Method — the classic exact decimal-shift algorithm (a digit buffer with
// a movable decimal point, halved/doubled in grade-school decimal, as in
// Go's strconv/decimal.go): collect the significant digits D so the value
// is 0.D × 10^dp; binary-normalize into [0.5, 1) by exact ÷2/×2 counting
// the binary exponent; pull the mantissa bits by repeated ×2 (the carry
// out of the integer place is the next bit); round on the next bit + a
// sticky flag (buffer remainder, or digits truncated at parse). Assemble-
// time only, so the O(digits × exponent) shifting cost is irrelevant.
// Keep in sync with x86_gas_parse_f64 (x86_native.fern) and arm64_parse_f64
// (arm64_native.fern) — the three assemblers are deliberately import-free,
// so the algorithm is mirrored, not shared.
pub function parse_f64(s: string): f64 {
  return f64_from_bits(parse_f64_bits(s));
}

// pf64_div2 halves the fraction buffer 0.B (grade-school left-to-right),
// returning the new buffer. May append one digit; drops a leading zero by
// signalling via the first element sentinel — the caller adjusts dp, so
// this returns the raw halved digits INCLUDING a possible leading zero.
function pf64_div2(b: i32[]): i32[] {
  let out: i32[] = [];
  let r: i32 = 0;
  let i: i32 = 0;
  while (i < b.len()) {
    let cur: i32 = r * 10 + b[i];
    out = out.append(cur / 2);
    r = cur % 2;
    i = i + 1;
  }
  if (r != 0) {
    out = out.append(5);
  }
  return out;
}

// pf64_mul2 doubles the fraction buffer 0.B (right-to-left with carry).
// A carry out of the front means the value reached [1, 2): the caller
// consumes it as the next binary digit. Returns carry * 1000000 + ... no —
// Fern has no multi-return here; the carry is prepended as a FIRST element
// (0 or 1) and the caller splits it off.
function pf64_mul2(b: i32[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < b.len()) {
    out = out.append(0);
    i = i + 1;
  }
  let carry: i32 = 0;
  let j: i32 = b.len() - 1;
  while (j >= 0) {
    let cur: i32 = b[j] * 2 + carry;
    out = out.with(j, cur % 10);
    carry = cur / 10;
    j = j - 1;
  }
  let res: i32[] = [carry];
  let k: i32 = 0;
  while (k < out.len()) {
    res = res.append(out[k]);
    k = k + 1;
  }
  return res;
}

// pf64_sub returns b[from : upto) as a fresh array (slices are a distinct
// type here, so buffer trims copy).
function pf64_sub(b: i32[], from: i32, upto: i32): i32[] {
  let out: i32[] = [];
  let i: i32 = from;
  while (i < upto) {
    out = out.append(b[i]);
    i = i + 1;
  }
  return out;
}

// pf64_all_zero reports whether every digit in b is zero.
function pf64_all_zero(b: i32[]): boolean {
  let i: i32 = 0;
  while (i < b.len()) {
    if (b[i] != 0) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

function parse_f64_bits(s: string): i64 {
  let i: i32 = 0;
  let neg: boolean = false;
  if (s.len() > 0 && s[0] == b'-') {
    neg = true;
    i = 1;
  } else if (s.len() > 0 && s[0] == b'+') {
    i = 1;
  }
  let signbit: i64 = 0;
  if (neg) {
    let one: i64 = 1;
    signbit = one << 63;
  }
  // Collect significant digits and the decimal point position:
  // value = 0.digits × 10^dp. The 800-digit cap is what makes dropping the
  // rest into a sticky bit safe: an exact ULP tie needs at most 751
  // significant decimal digits anywhere in the binary64 range (the smallest,
  // 2^-1075, is 5^1075 / 10^1075), so an input with a non-zero digit past
  // 800 cannot be a tie and rounding up off the round bit is correct.
  let digits: i32[] = [];
  let dp: i32 = 0;
  let sticky: boolean = false;
  let started: boolean = false;
  while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
    let d: i32 = s[i] as i32 - 48;
    if (started || d != 0) {
      started = true;
      if (digits.len() < 800) {
        digits = digits.append(d);
      } else {
        if (d != 0) {
          sticky = true;
        }
      }
      dp = dp + 1;
    }
    i = i + 1;
  }
  if (i < s.len() && s[i] == b'.') {
    i = i + 1;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      let fd: i32 = s[i] as i32 - 48;
      if (started || fd != 0) {
        started = true;
        if (digits.len() < 800) {
          digits = digits.append(fd);
        } else {
          if (fd != 0) {
            sticky = true;
          }
        }
      } else {
        dp = dp - 1;  // leading fraction zero shifts the point
      }
      i = i + 1;
    }
  }
  if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
    i = i + 1;
    let eneg: boolean = false;
    if (i < s.len() && s[i] == b'-') {
      eneg = true;
      i = i + 1;
    } else if (i < s.len() && s[i] == b'+') {
      i = i + 1;
    }
    let exp: i32 = 0;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
      if (exp < 100000) {
        exp = exp * 10 + (s[i] as i32 - 48);
      }
      i = i + 1;
    }
    if (eneg) {
      dp = dp - exp;
    } else {
      dp = dp + exp;
    }
  }
  // Trailing zeros in the significand carry no information; trimming
  // keeps the sticky/remainder tests correct.
  while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
    digits = pf64_sub(digits, 0, digits.len() - 1);
  }
  if (digits.len() == 0) {  // ±0.0
    return signbit;
  }
  // Decimal-magnitude clamps keep the shift loops bounded: |value| is in
  // [10^(dp-1), 10^dp), so dp > 310 overflows every double and dp < -350
  // underflows below half the minimum subnormal.
  if (dp > 310) {
    let inf: i64 = 2047;
    return signbit | inf << 52;
  }
  if (dp < 0 - 350) {
    return signbit;
  }
  // Binary-normalize 0.digits × 10^dp into v × 2^bexp with v in [0.5, 1).
  // While the decimal point is right of the front (value >= 1), halve;
  // while the value is below 0.5, double. dp reaches 0 first, then the
  // leading-digit test finishes the job.
  let bexp: i32 = 0;
  while (dp > 0) {
    let hb: i32[] = pf64_div2(digits);
    if (hb.len() > 0 && hb[0] == 0) {
      digits = pf64_sub(hb, 1, hb.len());
      dp = dp - 1;
    } else {
      digits = hb;
    }
    bexp = bexp + 1;
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
      digits = pf64_sub(digits, 0, digits.len() - 1);
    }
  }
  while (dp < 0 || digits.len() > 0 && digits[0] < 5) {
    let db: i32[] = pf64_mul2(digits);
    if (db[0] != 0) {
      // Carry out of the fraction: 2×0.D >= 1, i.e. C.D' × 10^dp.
      // Renormalize as 0.(C D') × 10^(dp+1) — the carry becomes the
      // new leading digit and the point advances. (Only reachable
      // while dp < 0: at dp == 0 the loop only runs when the lead
      // digit is < 5, so doubling cannot carry.)
      digits = db;
      dp = dp + 1;
    } else {
      digits = pf64_sub(db, 1, db.len());
    }
    bexp = bexp - 1;
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
      digits = pf64_sub(digits, 0, digits.len() - 1);
    }
    if (digits.len() == 0) {
      return signbit;
    }
  }
  // v in [0.5, 1), value = v × 2^bexp = 1.f × 2^(bexp-1): biased exponent
  // E = bexp + 1022. E >= 2047 overflows; E <= 0 goes subnormal with
  // 52 + E mantissa bits; below -1 it is under half the minimum
  // subnormal and rounds to zero.
  let e: i32 = bexp + 1022;
  if (e >= 2047) {
    let inf2: i64 = 2047;
    return signbit | inf2 << 52;
  }
  let nbits: i32 = 53;
  if (e <= 0) {
    nbits = 52 + e;
  }
  if (nbits < 0) {
    return signbit;
  }
  let mant: i64 = 0;
  let k2: i32 = 0;
  while (k2 < nbits) {
    let mb: i32[] = pf64_mul2(digits);
    mant = mant * 2 + mb[0] as i64;
    digits = pf64_sub(mb, 1, mb.len());
    k2 = k2 + 1;
  }
  // Round to nearest, ties to even: round bit is the next binary digit;
  // sticky is any remainder (or parse-time truncation).
  let rb: i32[] = pf64_mul2(digits);
  let roundbit: i32 = rb[0];
  let rest: i32[] = pf64_sub(rb, 1, rb.len());
  let st: boolean = sticky || !pf64_all_zero(rest);
  if (roundbit == 1 && (st || (mant & 1) == 1)) {
    mant = mant + 1;
  }
  if (e <= 0) {
    // Subnormal: the E field is 0 and `bits = mant` — and a subnormal
    // that rounded up to 2^52 IS the smallest normal (E=1, f=0), which
    // this encoding produces arithmetically.
    return signbit | mant;
  }
  let full: i64 = 1;
  full = full << 53;
  if (mant == full) {
    // 1.111…1 rounded up to 10.00…0: renormalize.
    mant = mant / 2;
    e = e + 1;
    if (e >= 2047) {
      let inf3: i64 = 2047;
      return signbit | inf3 << 52;
    }
  }
  let hidden: i64 = 1;
  hidden = hidden << 52;
  return signbit | e as i64 << 52 | mant - hidden;
}

// hexval maps an ASCII hex digit to its value.
function hexval(c: i32): i32 {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 97 + 10;
  }
  if (c >= 65 && c <= 70) {
    return c - 65 + 10;
  }
  return 0;
}

// data_bytes resolves a WAT data string's escapes (`\NN` hex, `\\`, `\"`,
// `\n`, `\t`) to raw bytes.
function data_bytes(s: string): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    let c: i32 = s[i] as i32;
    if (c == 92 && i + 1 < s.len()) {
      let n: i32 = s[i + 1] as i32;
      if (n == 110) {
        out = out.append(10);
        i = i + 2;
      } else if (n == 116) {
        out = out.append(9);
        i = i + 2;
      } else if (n == 92) {
        out = out.append(92);
        i = i + 2;
      } else if (n == 34) {
        out = out.append(34);
        i = i + 2;
      } else if (i + 2 < s.len()) {
        out = out.append(hexval(n) * 16 + hexval(s[i + 2] as i32));
        i = i + 3;
      } else {
        out = out.append(c);
        i = i + 1;
      }
    } else {
      out = out.append(c);
      i = i + 1;
    }
  }
  return out;
}

// ---- function inventory --------------------------------------------------

// func_node returns the actual `(func …)` node for a module child: the
// child itself for a defined func, or the inner func of an import.
function func_node(child: SExpr): SExpr {
  if (node_head(child) == "import") {
    return child.items[child.items.len() - 1];
  }
  return child;
}

// func_name returns a func node's `$name`.
function func_name(fnode: SExpr): string {
  return fnode.items[1].text;
}

// collect_func_names lists every function name in index order: import
// funcs first (in source order), then defined funcs.
function collect_func_names(mod: SExpr): string[] {
  let names: string[] = [];
  let i: i32 = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "import") {
      names = names.append(func_name(func_node(mod.items[i])));
    }
    i = i + 1;
  }
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "func") {
      names = names.append(func_name(mod.items[i]));
    }
    i = i + 1;
  }
  return names;
}

// func_header_end returns the index of a `(func …)` node's FIRST body item:
// the `(param …)` / `(result …)` / `(local …)` declarations are a PREFIX, and
// everything from here on is an instruction.
//
// It has to be a prefix scan rather than a filter over the whole node. In FLAT
// (unfolded) WAT a value-producing `if (result i32)` — what emit_dyn_dispatch
// writes — leaves a `(result …)` node sitting in the instruction stream at the
// func's top level. A filter counted that as a SECOND function result and, in
// body_instrs, dropped it from the body, so the `if` encoded with the empty
// blocktype 0x40: the function's declared type gained a phantom result and the
// arms' values had nowhere to go ("values remaining on stack at end of block").
// The WAT itself was valid the whole time — only this encoder disagreed with it
// (#6906).
//
// The scan starts at 2 so a leading `$name` atom is never mistaken for a body
// item; the signature readers below tolerate index 1 for the unnamed
// `(func …)` inside a `(type $c (func …))` declaration, which has no body.
function func_header_end(fnode: SExpr): i32 {
  let i: i32 = 2;
  while (i < fnode.items.len()) {
    let h: string = node_head(fnode.items[i]);
    if (h != "param" && h != "result" && h != "local") {
      return i;
    }
    i = i + 1;
  }
  return fnode.items.len();
}

// func_param_types / func_result_types read a func node's signature.
// They scan from items[1] (skipping a leading `$name` atom if present, so
// they also work on the unnamed `(func …)` inside a `(type $c (func …))`
// declaration). A `(param …)` is either named-single (`(param $n i32)`) or
// a run of bare types (`(param i32 i32 …)`, the import / type-decl form).
function func_param_types(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop: i32 = func_header_end(fnode);
  let i: i32 = 1;
  while (i < stop) {
    let c: SExpr = fnode.items[i];
    if (node_head(c) == "param") {
      if (c.items.len() >= 2 && c.items[1].text[0] == b'$') {
        // `(param $name type)` — named single.
        out = out.append(c.items[2].text);
      } else {
        let j: i32 = 1;
        while (j < c.items.len()) {
          out = out.append(c.items[j].text);
          j = j + 1;
        }
      }
    }
    i = i + 1;
  }
  return out;
}

function func_result_types(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop: i32 = func_header_end(fnode);
  let i: i32 = 1;
  while (i < stop) {
    let c: SExpr = fnode.items[i];
    if (node_head(c) == "result") {
      let j: i32 = 1;
      while (j < c.items.len()) {
        out = out.append(c.items[j].text);
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return out;
}

// local_names lists a defined func's local index space: params first
// (named), then `(local $name type)` decls.
function local_names(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop: i32 = func_header_end(fnode);
  let i: i32 = 2;
  while (i < stop) {
    let c: SExpr = fnode.items[i];
    if (node_head(c) == "param") {
      if (c.items.len() >= 2 && c.items[1].text[0] == b'$') {
        out = out.append(c.items[1].text);
      }
    }
    i = i + 1;
  }
  i = 2;
  while (i < stop) {
    let c2: SExpr = fnode.items[i];
    // Only NAMED locals (`(local $name type)`) enter the name space; the
    // abbreviated unnamed form is referenced by numeric index (the flat
    // encoder uses the index directly, never the name table).
    if (node_head(c2) == "local" && c2.items.len() >= 2 && c2.items[1].text.len() > 0 && c2.items[1].text[0] == b'$') {
      out = out.append(c2.items[1].text);
    }
    i = i + 1;
  }
  return out;
}

// local_decl_types lists the types of the `(local …)` decls (for the code
// section's locals vec). Handles both WAT forms: `(local $name type)` — one
// named local — and the abbreviated `(local type type …)` — N unnamed locals
// in one node (the stack-IR emitter's form, which uses numeric local indices).
function local_decl_types(fnode: SExpr): string[] {
  let out: string[] = [];
  let stop: i32 = func_header_end(fnode);
  let i: i32 = 2;
  while (i < stop) {
    let c: SExpr = fnode.items[i];
    if (node_head(c) == "local") {
      if (c.items.len() >= 3 && c.items[1].text.len() > 0 && c.items[1].text[0] == b'$') {
        out = out.append(c.items[2].text);  // (local $name type)
      } else {
        let k: i32 = 1;
        while (k < c.items.len()) {  // (local type type …)
          out = out.append(c.items[k].text);
          k = k + 1;
        }
      }
    }
    i = i + 1;
  }
  return out;
}

// ---- instruction encoding ------------------------------------------------

// arith_opcode maps a binary/unary arithmetic / comparison / conversion op to
// its wasm byte (0 if not one of them). Binary ops take two stack operands;
// the unary ones (eqz, clz/ctz/popcnt, every conversion) take one.
function arith_opcode(op: string): i32 {
  if (op == "i32.add") {  // 0x6a
    return 106;
  }
  if (op == "i32.sub") {
    return 107;
  }
  if (op == "i32.mul") {
    return 108;
  }
  if (op == "i32.div_s") {
    return 109;
  }
  if (op == "i32.div_u") {
    return 110;
  }
  if (op == "i32.rem_s") {
    return 111;
  }
  if (op == "i32.rem_u") {
    return 112;
  }
  if (op == "i32.and") {
    return 113;
  }
  if (op == "i32.or") {
    return 114;
  }
  if (op == "i32.xor") {
    return 115;
  }
  if (op == "i32.shl") {  // 0x74
    return 116;
  }
  if (op == "i32.shr_s") {  // 0x75
    return 117;
  }
  if (op == "i32.shr_u") {  // 0x76
    return 118;
  }
  if (op == "i32.rotl") {
    return 119;
  }
  if (op == "i32.rotr") {
    return 120;
  }
  if (op == "i32.eq") {  // 0x46
    return 70;
  }
  if (op == "i32.ne") {
    return 71;
  }
  if (op == "i32.lt_s") {
    return 72;
  }
  if (op == "i32.lt_u") {
    return 73;
  }
  if (op == "i32.gt_s") {
    return 74;
  }
  if (op == "i32.gt_u") {
    return 75;
  }
  if (op == "i32.le_s") {
    return 76;
  }
  if (op == "i32.le_u") {
    return 77;
  }
  if (op == "i32.ge_s") {
    return 78;
  }
  if (op == "i32.ge_u") {  // 0x4f
    return 79;
  }
  if (op == "i32.eqz") {  // 0x45
    return 69;
  }
  if (op == "i32.clz") {  // 0x67
    return 103;
  }
  if (op == "i32.ctz") {  // 0x68
    return 104;
  }
  if (op == "i32.popcnt") {  // 0x69
    return 105;
  }
  // i64 arithmetic / comparison (binary; i64.eqz is unary).
  if (op == "i64.add") {  // 0x7c
    return 124;
  }
  if (op == "i64.sub") {
    return 125;
  }
  if (op == "i64.mul") {
    return 126;
  }
  if (op == "i64.div_s") {
    return 127;
  }
  if (op == "i64.div_u") {
    return 128;
  }
  if (op == "i64.rem_s") {
    return 129;
  }
  if (op == "i64.rem_u") {
    return 130;
  }
  if (op == "i64.and") {
    return 131;
  }
  if (op == "i64.or") {
    return 132;
  }
  if (op == "i64.xor") {
    return 133;
  }
  if (op == "i64.shl") {
    return 134;
  }
  if (op == "i64.shr_s") {
    return 135;
  }
  if (op == "i64.shr_u") {
    return 136;
  }
  if (op == "i64.rotl") {
    return 137;
  }
  if (op == "i64.rotr") {
    return 138;
  }
  if (op == "i64.eqz") {  // 0x50
    return 80;
  }
  if (op == "i64.eq") {
    return 81;
  }
  if (op == "i64.ne") {
    return 82;
  }
  if (op == "i64.lt_s") {
    return 83;
  }
  if (op == "i64.lt_u") {
    return 84;
  }
  if (op == "i64.gt_s") {
    return 85;
  }
  if (op == "i64.gt_u") {
    return 86;
  }
  if (op == "i64.le_s") {
    return 87;
  }
  if (op == "i64.le_u") {
    return 88;
  }
  if (op == "i64.ge_s") {
    return 89;
  }
  if (op == "i64.ge_u") {  // 0x5a
    return 90;
  }
  if (op == "i64.clz") {  // 0x79
    return 121;
  }
  if (op == "i64.ctz") {  // 0x7a
    return 122;
  }
  if (op == "i64.popcnt") {  // 0x7b
    return 123;
  }
  // Numeric conversions (all unary — one stack operand).
  if (op == "i32.wrap_i64") {  // 0xa7
    return 167;
  }
  if (op == "i64.extend_i32_s") {  // 0xac
    return 172;
  }
  if (op == "i64.extend_i32_u") {  // 0xad
    return 173;
  }
  if (op == "i32.trunc_f64_s") {  // 0xaa
    return 170;
  }
  if (op == "i32.trunc_f64_u") {  // 0xab
    return 171;
  }
  if (op == "i64.trunc_f64_s") {  // 0xb0
    return 176;
  }
  if (op == "i64.trunc_f64_u") {  // 0xb1
    return 177;
  }
  if (op == "f64.convert_i32_s") {  // 0xb7
    return 183;
  }
  if (op == "f64.convert_i32_u") {  // 0xb8
    return 184;
  }
  if (op == "f64.convert_i64_s") {  // 0xb9
    return 185;
  }
  if (op == "f64.convert_i64_u") {  // 0xba
    return 186;
  }
  if (op == "f32.demote_f64") {  // 0xb6
    return 182;
  }
  if (op == "f64.promote_f32") {  // 0xbb
    return 187;
  }
  // Bit reinterprets — no conversion, the same bits under a different type.
  // `f64_bits` / `f64_from_bits` reach these, and `to_string` on any numeric
  // type reaches them through the decimal formatter, so a program that merely
  // prints a number needs 0xbf.
  if (op == "i32.reinterpret_f32") {  // 0xbc
    return 188;
  }
  if (op == "i64.reinterpret_f64") {  // 0xbd
    return 189;
  }
  if (op == "f32.reinterpret_i32") {  // 0xbe
    return 190;
  }
  if (op == "f64.reinterpret_i64") {  // 0xbf
    return 191;
  }
  // f64 comparison (binary) + arithmetic (binary, except the unary math
  // ops abs/neg/ceil/floor/trunc/nearest/sqrt).
  if (op == "f64.eq") {  // 0x61
    return 97;
  }
  if (op == "f64.ne") {
    return 98;
  }
  if (op == "f64.lt") {
    return 99;
  }
  if (op == "f64.gt") {
    return 100;
  }
  if (op == "f64.le") {
    return 101;
  }
  if (op == "f64.ge") {  // 0x66
    return 102;
  }
  if (op == "f64.abs") {  // 0x99
    return 153;
  }
  if (op == "f64.neg") {
    return 154;
  }
  if (op == "f64.ceil") {
    return 155;
  }
  if (op == "f64.floor") {
    return 156;
  }
  if (op == "f64.trunc") {
    return 157;
  }
  if (op == "f64.nearest") {
    return 158;
  }
  if (op == "f64.sqrt") {  // 0x9f
    return 159;
  }
  if (op == "f64.add") {  // 0xa0
    return 160;
  }
  if (op == "f64.sub") {
    return 161;
  }
  if (op == "f64.mul") {
    return 162;
  }
  if (op == "f64.div") {
    return 163;
  }
  if (op == "f64.min") {
    return 164;
  }
  if (op == "f64.max") {
    return 165;
  }
  if (op == "f64.copysign") {  // 0xa6
    return 166;
  }
  return 0;
}

// labels_push returns a FRESH frame stack = `labels` + `x`. A copy is
// required because `arr.push` mutates in place when the backing array has
// spare capacity — pushing onto the caller's stack directly would corrupt
// the enclosing frame's stack for its later siblings (turning a deeper
// `br` depth into a wrong one).
function labels_push(labels: string[], x: string): string[] {
  let out: string[] = [];
  let i: i32 = 0;
  while (i < labels.len()) {
    out = out.append(labels[i]);
    i = i + 1;
  }
  out = out.append(x);
  return out;
}

// label_depth resolves a WAT `$label` to the relative depth wasm `br` /
// `br_if` use: 0 = innermost enclosing frame. `labels` is the frame stack
// (block / loop / if), innermost last; the most recent match wins.
function label_depth(labels: string[], name: string): i32 {
  let i: i32 = labels.len() - 1;
  while (i >= 0) {
    if (labels[i] == name) {
      return labels.len() - 1 - i;
    }
    i = i - 1;
  }
  return 0;
}

// sat_trunc_opcode maps a saturating float->int truncation to its 0xFC-prefixed
// sub-opcode index (0..7), or -1 for anything else. These are the two-byte
// `0xFC idx` (LEB) form the stack-IR backend emits for `as i32` / `as i64` float
// casts — the *saturating* truncations, distinct from the single-byte trapping
// 0xaa-family (`i32.trunc_f64_s` = 170) that arith_opcode already covers. Without
// this the IR emitter's `i32.trunc_sat_f64_s` fell through both enc paths and
// emitted NOTHING, leaving an f64 on the stack where an i32 was expected (every
// f64 program's `as i32` failed wasm validation with a type mismatch).
function sat_trunc_opcode(op: string): i32 {
  if (op == "i32.trunc_sat_f32_s") {
    return 0;
  }
  if (op == "i32.trunc_sat_f32_u") {
    return 1;
  }
  if (op == "i32.trunc_sat_f64_s") {
    return 2;
  }
  if (op == "i32.trunc_sat_f64_u") {
    return 3;
  }
  if (op == "i64.trunc_sat_f32_s") {
    return 4;
  }
  if (op == "i64.trunc_sat_f32_u") {
    return 5;
  }
  if (op == "i64.trunc_sat_f64_s") {
    return 6;
  }
  if (op == "i64.trunc_sat_f64_u") {
    return 7;
  }
  return 0 - 1;
}

// simd_opcode maps a fixed-width-SIMD op to its 0xFD-prefixed sub-opcode, or -1.
// These are what the fused vector kernels of ATLAS-PLATFORM-PLAN §3 need, and
// §3.3a's rule is why they are pinned against wasm-tools rather than typed from
// a table: the sub-opcode space is DENSE uleb128, so a wrong byte is very often
// another VALID instruction. Encode i16x8.bitmask (132) as a raw byte and
// 0x84's continuation bit makes the decoder swallow the next instruction's
// first byte too — a malformed module on most streams, and on some one that
// validates, runs, and computes nonsense. That stopped being hypothetical when
// the scale_f64 kernel added f64x2.mul at 242: every other entry below is
// under 128 and so writes as one byte, and it is the first that does not.
// Which is why simd_opcode returns the INDEX and leb_u32 writes it, rather
// than the table storing bytes.
//
// v128.load and v128.store are the ones carrying a memarg. Its natural
// alignment is 4
// (16 bytes), but a kernel cursor is arbitrary, and an alignment hint LARGER
// than the access is a VALIDATION error where a smaller one is always legal —
// so simd_load_align answers 0 rather than reusing memarg_align's natural one.
function simd_opcode(op: string): i32 {
  if (op == "v128.load") {
    return 0;
  }
  if (op == "v128.store") {
    return 11;
  }
  if (op == "i8x16.splat") {
    return 15;
  }
  if (op == "f64x2.splat") {
    return 20;
  }
  if (op == "i8x16.eq") {
    return 35;
  }
  if (op == "i8x16.bitmask") {
    return 100;
  }
  if (op == "f64x2.mul") {
    return 242;
  }
  return 0 - 1;
}

// simd_has_memarg says whether a SIMD op carries the (align, offset) pair
// after its sub-opcode. Only the plain load and store do among the ops here.
function simd_has_memarg(op: string): boolean {
  return op == "v128.load" || op == "v128.store";
}

// simd_arity gives how many stack operands a SIMD op takes, so enc_instr can
// encode them post-order without a per-op branch.
function simd_arity(op: string): i32 {
  // v128.store takes the address then the value, like the scalar stores.
  if (op == "i8x16.eq" || op == "f64x2.mul" || op == "v128.store") {
    return 2;
  }
  return 1;
}

// bulk_mem_opcode maps a bulk-memory op to its 0xFC-prefixed sub-opcode index,
// or -1 for anything else. Both take three stack operands and trailing memory
// indexes: `memory.copy` two (dest, src), `memory.fill` one. The IR emitter
// selects them for `__memcpy` / `__memset` — `string.bytes()` and core/map's
// bucket init — so a program taking a string's bytes reaches them.
function bulk_mem_opcode(op: string): i32 {
  if (op == "memory.copy") {
    return 10;
  }
  if (op == "memory.fill") {
    return 11;
  }
  return 0 - 1;
}

// bulk_mem_tail appends everything after the 0xFC prefix: the LEB sub-opcode,
// then the memory indexes — two for `memory.copy` (dest then src), one for
// `memory.fill`.
function bulk_mem_tail(out: i32[], idx: i32): i32[] {
  let o: i32[] = leb_u32(out, idx);
  o = o.append(0);
  if (idx == 10) {
    o = o.append(0);
  }
  return o;
}

// is_offset_atom reports whether an SExpr child is a folded `offset=N` memarg
// atom (a leaf token whose text begins "offset="). offset_atom_value parses the
// N. wasm.fern's folded field loads/stores carry these for non-zero slots.
function is_offset_atom(n: SExpr): boolean {
  if (n.kind == 0) {
    return false;
  }
  if (n.text.len() < 7) {
    return false;
  }
  return slice_unchecked(n.text, 0, 7) == "offset=";
}

function offset_atom_value(n: SExpr): i32 {
  return parse_dec(slice_unchecked(n.text, 7, n.text.len()));
}

// memarg_align gives the natural alignment (log2 of access size) for a
// memory op; the self-host emits bare loads/stores, so natural alignment +
// offset 0.
function memarg_align(op: string): i32 {
  if (op == "i32.load8_u" || op == "i32.load8_s" || op == "i32.store8") {
    return 0;
  }
  if (op == "i32.load16_u" || op == "i32.load16_s" || op == "i32.store16") {
    return 1;
  }
  if (op == "i64.load" || op == "f64.load" || op == "i64.store" || op == "f64.store") {
    return 3;
  }
  return 2;
}

// mem_load_opcode / mem_store_opcode: the byte for a memory op (0 if not).
function mem_load_opcode(op: string): i32 {
  if (op == "i32.load") {
    return 40;
  }
  if (op == "i64.load") {
    return 41;
  }
  if (op == "f64.load") {
    return 43;
  }
  if (op == "i32.load8_u") {
    return 45;
  }
  if (op == "i32.load8_s") {
    return 44;
  }
  if (op == "i32.load16_s") {
    return 46;
  }
  if (op == "i32.load16_u") {
    return 47;
  }
  return 0;
}

function mem_store_opcode(op: string): i32 {
  if (op == "i32.store") {
    return 54;
  }
  if (op == "i64.store") {
    return 55;
  }
  if (op == "f64.store") {
    return 57;
  }
  if (op == "i32.store8") {
    return 58;
  }
  if (op == "i32.store16") {
    return 59;
  }
  return 0;
}

// enc_instr encodes one folded instruction node post-order. `labels` is
// the enclosing control-frame stack (for br / br_if depth resolution).
function enc_instr(node: SExpr, lnames: string[], fnames: string[], gnames: string[], labels: string[], tnames: string[]): i32[] {
  let out: i32[] = [];
  let op: string = node.items[0].text;
  if (op == "i32.const") {
    out = out.append(65);
    return leb_i32(out, parse_dec(node.items[1].text));
  }
  if (op == "i64.const") {
    out = out.append(66);
    return leb_i64(out, parse_dec_i64(node.items[1].text));
  }
  if (op == "f64.const") {
    // 0x44 then the 8-byte little-endian IEEE-754 double. The value's
    // bits come from f64_bits() on the parsed literal.
    out = out.append(68);
    let bits: i64 = f64_bits(parse_f64(node.items[1].text));
    let k: i32 = 0;
    while (k < 8) {
      out = out.append((bits >> k * 8 & 255) as i32);
      k = k + 1;
    }
    return out;
  }
  // A local operand is a `$name` or, as the export wrappers write their
  // unnamed params, a numeric index — the same two forms the flat encoder
  // takes (flat_idx).
  if (op == "local.get") {
    out = out.append(32);
    return leb_u32(out, flat_idx(node.items[1].text, lnames));
  }
  if (op == "local.set") {
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(33);
    return leb_u32(out, flat_idx(node.items[1].text, lnames));
  }
  if (op == "local.tee") {
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(34);
    return leb_u32(out, flat_idx(node.items[1].text, lnames));
  }
  if (op == "global.get") {
    out = out.append(35);
    return leb_u32(out, name_idx(gnames, node.items[1].text));
  }
  if (op == "global.set") {
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(36);
    return leb_u32(out, name_idx(gnames, node.items[1].text));
  }
  if (op == "unreachable") {
    out = out.append(0);  // 0x00 unreachable
    return out;
  }
  if (op == "return") {
    if (node.items.len() > 1) {
      out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    }
    out = out.append(15);
    return out;
  }
  if (op == "drop") {
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = out.append(26);
    return out;
  }
  if (op == "call") {
    let k: i32 = 2;
    while (k < node.items.len()) {
      out = wcat(out, enc_instr(node.items[k], lnames, fnames, gnames, labels, tnames));
      k = k + 1;
    }
    out = out.append(16);
    return leb_u32(out, name_idx(fnames, node.items[1].text));
  }
  if (op == "call_indirect") {
    // (call_indirect (type $c) <args…> <funcptr>) — the type ref is
    // items[1]; the last operand is the table index (function pointer
    // on the stack top), the rest are call args. Args are pushed first,
    // then the table index, then 0x11 typeidx tableidx(0).
    let lasti: i32 = node.items.len() - 1;
    let k: i32 = 2;
    while (k < lasti) {
      out = wcat(out, enc_instr(node.items[k], lnames, fnames, gnames, labels, tnames));
      k = k + 1;
    }
    out = wcat(out, enc_instr(node.items[lasti], lnames, fnames, gnames, labels, tnames));
    out = out.append(17);  // 0x11
    out = leb_u32(out, name_idx(tnames, node.items[1].items[1].text));
    return leb_u32(out, 0);  // table index 0
  }
  if (op == "memory.size") {
    out = out.append(63);  // 0x3f
    return out.append(0);  // reserved memory index
  }
  if (op == "memory.grow") {
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = out.append(64);  // 0x40
    return out.append(0);  // reserved memory index
  }
  if (op == "br") {
    out = out.append(12);
    return leb_u32(out, label_depth(labels, node.items[1].text));
  }
  if (op == "br_if") {
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = out.append(13);
    return leb_u32(out, label_depth(labels, node.items[1].text));
  }
  if (op == "block" || op == "loop") {
    let bi: i32 = 1;
    let label: string = "";
    if (node.items[1].kind == 2 && node.items[1].text[0] == b'$') {
      label = node.items[1].text;
      bi = 2;
    }
    let bt: i32 = 64;
    if (bi < node.items.len() && node_head(node.items[bi]) == "result") {
      bt = valtype_byte(node.items[bi].items[1].text);
      bi = bi + 1;
    }
    if (op == "block") {
      out = out.append(2);
    } else {
      out = out.append(3);
    }
    out = out.append(bt);
    let inner: string[] = labels_push(labels, label);
    while (bi < node.items.len()) {
      out = wcat(out, enc_instr(node.items[bi], lnames, fnames, gnames, inner, tnames));
      bi = bi + 1;
    }
    out = out.append(11);  // end
    return out;
  }
  if (op == "if") {
    let ci: i32 = 1;
    let ibt: i32 = 64;
    if (node_head(node.items[1]) == "result") {
      ibt = valtype_byte(node.items[1].items[1].text);
      ci = 2;
    }
    // condition (stack operand) first
    out = wcat(out, enc_instr(node.items[ci], lnames, fnames, gnames, labels, tnames));
    out = out.append(4);  // if
    out = out.append(ibt);
    let iinner: string[] = labels_push(labels, "");
    let thenN: SExpr = node.items[ci + 1];
    let tk: i32 = 1;
    while (tk < thenN.items.len()) {
      out = wcat(out, enc_instr(thenN.items[tk], lnames, fnames, gnames, iinner, tnames));
      tk = tk + 1;
    }
    if (node.items.len() > ci + 2 && node_head(node.items[ci + 2]) == "else") {
      out = out.append(5);  // else
      let elseN: SExpr = node.items[ci + 2];
      let ek: i32 = 1;
      while (ek < elseN.items.len()) {
        out = wcat(out, enc_instr(elseN.items[ek], lnames, fnames, gnames, iinner, tnames));
        ek = ek + 1;
      }
    }
    out = out.append(11);  // end
    return out;
  }
  let ml: i32 = mem_load_opcode(op);
  if (ml != 0) {
    // An optional `offset=N` memarg atom appears between the op and the address
    // operand — wasm.fern's folded struct-drop / field helpers use it to read
    // a non-zero field slot (`(i32.load offset=8 (local.get $box))`). Parsing
    // it fixes both the emitted offset (was hardcoded 0) AND the operand index:
    // without it, enc_instr recursed into the `offset=8` ATOM (its `items` is
    // null) and SIGSEGV'd on any struct with a pointer field (#4801).
    let loff: i32 = 0;
    let lopnd: i32 = 1;
    if (node.items.len() > 2 && is_offset_atom(node.items[1])) {
      loff = offset_atom_value(node.items[1]);
      lopnd = 2;
    }
    out = wcat(out, enc_instr(node.items[lopnd], lnames, fnames, gnames, labels, tnames));
    out = out.append(ml);
    out = leb_u32(out, memarg_align(op));
    out = leb_u32(out, loff);
    return out;
  }
  let ms: i32 = mem_store_opcode(op);
  if (ms != 0) {
    let soff: i32 = 0;
    let sbase: i32 = 1;
    if (node.items.len() > 3 && is_offset_atom(node.items[1])) {
      soff = offset_atom_value(node.items[1]);
      sbase = 2;
    }
    out = wcat(out, enc_instr(node.items[sbase], lnames, fnames, gnames, labels, tnames));
    out = wcat(out, enc_instr(node.items[sbase + 1], lnames, fnames, gnames, labels, tnames));
    out = out.append(ms);
    out = leb_u32(out, memarg_align(op));
    out = leb_u32(out, soff);
    return out;
  }
  if (op == "select") {
    // (select a b cond) — three stack operands, then 0x1b.
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = wcat(out, enc_instr(node.items[3], lnames, fnames, gnames, labels, tnames));
    out = out.append(27);  // 0x1b
    return out;
  }
  let stf: i32 = sat_trunc_opcode(op);
  if (stf >= 0) {
    // Saturating float->int truncation: encode the single operand, then the
    // two-byte `0xFC idx` (LEB) form.
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = out.append(252);  // 0xFC
    return leb_u32(out, stf);
  }
  let sop: i32 = simd_opcode(op);
  if (sop >= 0) {
    let sa: i32 = simd_arity(op);
    let sk: i32 = 1;
    while (sk <= sa) {
      out = wcat(out, enc_instr(node.items[sk], lnames, fnames, gnames, labels, tnames));
      sk = sk + 1;
    }
    out = out.append(253);  // 0xFD
    out = leb_u32(out, sop);
    if (simd_has_memarg(op)) {
      out = leb_u32(out, 0);  // align: see simd_opcode's note
      out = leb_u32(out, 0);  // offset
    }
    return out;
  }
  let blk: i32 = bulk_mem_opcode(op);
  if (blk >= 0) {
    // Bulk memory: three operands, then `0xFC idx` and the memory indexes.
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    out = wcat(out, enc_instr(node.items[3], lnames, fnames, gnames, labels, tnames));
    out = out.append(252);  // 0xFC
    return bulk_mem_tail(out, blk);
  }
  let ao: i32 = arith_opcode(op);
  if (ao != 0) {
    // Arity comes from the node: a unary op (eqz, clz/ctz/popcnt, the
    // conversions) is written with one child, a binary op with two.
    out = wcat(out, enc_instr(node.items[1], lnames, fnames, gnames, labels, tnames));
    if (op != "i32.eqz" && node.items.len() > 2) {
      out = wcat(out, enc_instr(node.items[2], lnames, fnames, gnames, labels, tnames));
    }
    out = out.append(ao);
    return out;
  }
  // No handler claimed the node: an unknown instruction here was silently
  // DROPPED (SH-003) — the module encoded with the operation missing, so
  // it either failed validation with a baffling type mismatch or ran with
  // wrong values (the sat_trunc note above records a real instance). A
  // named op that reaches this point is an encoder gap: fail loudly.
  if (op.len() > 0) {
    eprint("watbin: unknown instruction: " + op);
    exit(1);
  }
  return out;
}

// ---- section builders ----------------------------------------------------

// flat_idx resolves a local index operand: a numeric index (the IR emitter's
// form) is used directly; a `$name` resolves through lnames.
function flat_idx(text: string, names: string[]): i32 {
  if (text.len() > 0 && text[0] == b'$') {
    return name_idx(names, text);
  }
  return parse_dec(text);
}

// enc_flat_body encodes a FLAT instruction body — a linear sequence of bare
// instruction atoms (the stack-IR emitter's output: `i32.const 5`, `local.get
// 0`, `i32.add`, `block`, `br_if 1`, …) — as opposed to enc_instr's folded
// S-expression form. This is the natural match for the wasm binary format,
// which is itself flat post-order: each instruction emits ONLY its opcode +
// immediates (operands are prior instructions on the implicit operand stack,
// NOT nested), numeric local indices and numeric `br` depths go straight to
// LEB (no name/label resolution), and block/loop/if use the empty blocktype
// (0x40). Reuses watbin's opcode tables (mem_*_opcode / arith_opcode) so the
// two paths agree byte-for-byte. The caller still appends the function-level
// `end` (0x0b).
function enc_flat_body(instrs: SExpr[], lnames: string[], fnames: string[], gnames: string[], tnames: string[]): i32[] {
  let out: i32[] = [];
  let i: i32 = 0;
  while (i < instrs.len()) {
    let op: string = instrs[i].text;
    if (op == "i32.const") {
      out = out.append(65);
      out = leb_i32(out, parse_dec(instrs[i + 1].text));
      i = i + 2;
    } else if (op == "i64.const") {
      out = out.append(66);
      out = leb_i64(out, parse_dec_i64(instrs[i + 1].text));
      i = i + 2;
    } else if (op == "f64.const") {
      // 0x44 then the 8-byte little-endian IEEE-754 double, exactly as
      // enc_instr encodes the folded form. Without this case the flat
      // encoder silently DROPPED f64.const (and its literal atom read as
      // a second unknown), mis-encoding any float-bearing flat body —
      // surfaced by the #4342 exponent-literal case.
      out = out.append(68);
      let fbits: i64 = f64_bits(parse_f64(instrs[i + 1].text));
      let fk: i32 = 0;
      while (fk < 8) {
        out = out.append((fbits >> fk * 8 & 255) as i32);
        fk = fk + 1;
      }
      i = i + 2;
    } else if (op == "local.get") {
      out = out.append(32);
      out = leb_u32(out, flat_idx(instrs[i + 1].text, lnames));
      i = i + 2;
    } else if (op == "local.set") {
      out = out.append(33);
      out = leb_u32(out, flat_idx(instrs[i + 1].text, lnames));
      i = i + 2;
    } else if (op == "local.tee") {
      out = out.append(34);
      out = leb_u32(out, flat_idx(instrs[i + 1].text, lnames));
      i = i + 2;
    } else if (op == "global.get") {
      out = out.append(35);
      out = leb_u32(out, name_idx(gnames, instrs[i + 1].text));
      i = i + 2;
    } else if (op == "global.set") {
      out = out.append(36);
      out = leb_u32(out, name_idx(gnames, instrs[i + 1].text));
      i = i + 2;
    } else if (op == "call") {
      out = out.append(16);
      out = leb_u32(out, name_idx(fnames, instrs[i + 1].text));
      i = i + 2;
    } else if (op == "call_indirect") {
      // `call_indirect (type $c)` — the `(type $c)` node is the next flat
      // item; the args + the table index are already on the stack from the
      // prior flat instructions. Emit 0x11 typeidx tableidx(0). Without this
      // the flat emitter's closure `call_indirect` (every `return`ed / arg
      // closure) was DROPPED — the module validated but the indirect call
      // vanished and the result was garbage (#4801).
      out = out.append(17);  // 0x11
      out = leb_u32(out, name_idx(tnames, instrs[i + 1].items[1].text));
      out = leb_u32(out, 0);  // table index 0
      i = i + 2;
    } else if (op == "br") {
      out = out.append(12);
      out = leb_u32(out, parse_dec(instrs[i + 1].text));  // numeric depth, used directly
      i = i + 2;
    } else if (op == "br_if") {
      out = out.append(13);
      out = leb_u32(out, parse_dec(instrs[i + 1].text));
      i = i + 2;
    } else if (op == "block" || op == "loop" || op == "if") {
      // A flat block carries its own blocktype as the NEXT item when it
      // produces a value: `if (result i32)` (emit_dyn_dispatch's
      // value-producing dispatch). Encoding the empty 0x40 there instead
      // left the arms' values stranded at the block's end (#6906).
      if (op == "block") {
        out = out.append(2);
      } else if (op == "loop") {
        out = out.append(3);
      } else {
        out = out.append(4);
      }
      let bt: i32 = 64;  // 0x40 empty blocktype
      if (i + 1 < instrs.len() && node_head(instrs[i + 1]) == "result") {
        bt = valtype_byte(instrs[i + 1].items[1].text);
        i = i + 1;
      }
      out = out.append(bt);
      i = i + 1;
    } else if (op == "else") {
      out = out.append(5);
      i = i + 1;
    } else if (op == "end") {
      out = out.append(11);
      i = i + 1;
    } else if (op == "unreachable") {
      out = out.append(0);  // 0x00 unreachable
      i = i + 1;
    } else if (op == "return") {
      out = out.append(15);
      i = i + 1;
    } else if (op == "drop") {
      out = out.append(26);
      i = i + 1;
    } else {
      let ml: i32 = mem_load_opcode(op);
      let ms: i32 = mem_store_opcode(op);
      let ao: i32 = arith_opcode(op);
      let stf: i32 = sat_trunc_opcode(op);
      let blk: i32 = bulk_mem_opcode(op);
      let sop: i32 = simd_opcode(op);
      if (ml != 0) {
        out = out.append(ml);
        out = leb_u32(out, memarg_align(op));
        out = leb_u32(out, 0);  // offset 0
      } else if (ms != 0) {
        out = out.append(ms);
        out = leb_u32(out, memarg_align(op));
        out = leb_u32(out, 0);
      } else if (sop >= 0) {
        // Fixed-width SIMD: `0xFD idx` (operands already on the stack in
        // the flat form), plus the load/store memarg.
        out = out.append(253);  // 0xFD
        out = leb_u32(out, sop);
        if (simd_has_memarg(op)) {
          out = leb_u32(out, 0);
          out = leb_u32(out, 0);
        }
      } else if (stf >= 0) {
        // Saturating float->int truncation: two-byte `0xFC idx` (operand
        // already on the stack in the flat form).
        out = out.append(252);  // 0xFC
        out = leb_u32(out, stf);
      } else if (blk >= 0) {
        // Bulk memory: `0xFC idx` + memory indexes (the three operands
        // are already on the stack in the flat form).
        out = out.append(252);  // 0xFC
        out = bulk_mem_tail(out, blk);
      } else if (ao != 0) {
        out = out.append(ao);  // arithmetic / comparison (no immediate)
      } else if (op.len() > 0) {
        // Unknown flat-form instruction: previously skipped silently
        // (SH-003), leaving the operation out of the encoded module.
        eprint("watbin: unknown instruction: " + op);
        exit(1);
      }
      i = i + 1;
    }
  }
  return out;
}

// enc_locals_vec compresses a func's `(local …)` types into runs of
// (count, valtype), the code section's locals encoding.
function enc_locals_vec(types: string[]): i32[] {
  // count distinct runs
  let runs: i32 = 0;
  let i: i32 = 0;
  while (i < types.len()) {
    if (i == 0 || types[i] != types[i - 1]) {
      runs = runs + 1;
    }
    i = i + 1;
  }
  let body: i32[] = [];
  i = 0;
  while (i < types.len()) {
    let n: i32 = 1;
    while (i + n < types.len() && types[i + n] == types[i]) {
      n = n + 1;
    }
    body = leb_u32(body, n);
    body = body.append(valtype_byte(types[i]));
    i = i + n;
  }
  return wvec(runs, body);
}

// enc_functype emits `0x60 vec(params) vec(results)`.
function enc_functype(params: string[], results: string[]): i32[] {
  let o: i32[] = [];
  o = o.append(96);
  let pb: i32[] = [];
  let i: i32 = 0;
  while (i < params.len()) {
    pb = pb.append(valtype_byte(params[i]));
    i = i + 1;
  }
  o = wcat(o, wvec(params.len(), pb));
  let rb: i32[] = [];
  i = 0;
  while (i < results.len()) {
    rb = rb.append(valtype_byte(results[i]));
    i = i + 1;
  }
  o = wcat(o, wvec(results.len(), rb));
  return o;
}

// body_instrs returns a defined func's body instruction nodes — everything
// after the param/result/local declaration PREFIX (func_header_end). A
// `(result …)` inside the body is a flat block's own blocktype and belongs to
// the instruction stream, so it is kept rather than filtered out.
function body_instrs(fnode: SExpr): SExpr[] {
  let out: SExpr[] = [];
  let i: i32 = func_header_end(fnode);
  while (i < fnode.items.len()) {
    out = out.append(fnode.items[i]);
    i = i + 1;
  }
  return out;
}

// emit_binary walks the `(module …)` tree and returns the wasm binary.
function emit_binary(mod: SExpr): i32[] {
  let fnames: string[] = collect_func_names(mod);
  let gnames: string[] = [];
  let gi: i32 = 0;
  while (gi < mod.items.len()) {
    if (node_head(mod.items[gi]) == "global") {
      gnames = gnames.append(mod.items[gi].items[1].text);
    }
    gi = gi + 1;
  }

  // Func nodes in index order: imports first, then defined.
  let importNodes: SExpr[] = [];
  let definedNodes: SExpr[] = [];
  let i: i32 = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "import") {
      importNodes = importNodes.append(mod.items[i]);
    }
    if (node_head(mod.items[i]) == "func") {
      definedNodes = definedNodes.append(mod.items[i]);
    }
    i = i + 1;
  }

  // Named `(type $c (func …))` declarations (for call_indirect, used by
  // closures). They occupy the first type-section indices, in source
  // order; `tnames` maps each name to its index.
  let tnames: string[] = [];
  let namedTypeBody: i32[] = [];
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "type") {
      let tn: SExpr = mod.items[i];
      tnames = tnames.append(tn.items[1].text);
      let tf: SExpr = tn.items[2];  // the inner (func …)
      namedTypeBody = wcat(namedTypeBody, enc_functype(func_param_types(tf), func_result_types(tf)));
    }
    i = i + 1;
  }
  let ntypes: i32 = tnames.len();

  // --- type section: named types first, then one functype per function
  // (imports, then defined). A function's type index is offset by ntypes.
  let nfuncs: i32 = importNodes.len() + definedNodes.len();
  let typeBody: i32[] = namedTypeBody;
  i = 0;
  while (i < importNodes.len()) {
    let fn: SExpr = func_node(importNodes[i]);
    typeBody = wcat(typeBody, enc_functype(func_param_types(fn), func_result_types(fn)));
    i = i + 1;
  }
  i = 0;
  while (i < definedNodes.len()) {
    typeBody = wcat(typeBody, enc_functype(func_param_types(definedNodes[i]), func_result_types(definedNodes[i])));
    i = i + 1;
  }

  // --- import section. ---
  let impBody: i32[] = [];
  i = 0;
  while (i < importNodes.len()) {
    let imp: SExpr = importNodes[i];
    impBody = wname(impBody, imp.items[1].text);
    impBody = wname(impBody, imp.items[2].text);
    impBody = impBody.append(0);  // import kind: func
    impBody = leb_u32(impBody, ntypes + i);  // type index (after named types)
    i = i + 1;
  }

  // --- function section: defined funcs' type indices. ---
  let funcBody: i32[] = [];
  i = 0;
  while (i < definedNodes.len()) {
    funcBody = leb_u32(funcBody, ntypes + importNodes.len() + i);
    i = i + 1;
  }

  // --- memory section: limits {min}. ---
  let memBody: i32[] = [];
  let memCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "memory") {
      let mn: SExpr = mod.items[i];
      // min is the last atom child (after an optional (export …)).
      let minv: i32 = parse_dec(mn.items[mn.items.len() - 1].text);
      memBody = memBody.append(0);
      memBody = leb_u32(memBody, minv);
      memCount = memCount + 1;
    }
    i = i + 1;
  }

  // --- global section. ---
  let globBody: i32[] = [];
  let globCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "global") {
      let gn: SExpr = mod.items[i];
      // (global $name (mut T) (T.const N)) — T read from the node rather
      // than assumed i32: an i64 global (the leak census's counters, and
      // the allocation count of #9596) encoded as i32 gives a binary
      // whose global type disagrees with its own init expression, which
      // the module-level validator rejects with "expected i32, found
      // i64" long before anything runs. The text form was always right,
      // so `wasm-tools validate` on the .wat passed while the .wasm this
      // assembler wrote did not (#9597).
      globBody = globBody.append(valtype_byte(global_valtype(gn)));
      globBody = globBody.append(1);  // mutable
      globBody = wcat(globBody, enc_instr(gn.items[gn.items.len() - 1], [], fnames, gnames, [], []));
      globBody = globBody.append(11);  // end
      globCount = globCount + 1;
    }
    i = i + 1;
  }

  // --- export section: any inline memory export + the (export …) decls. ---
  let expBody: i32[] = [];
  let expCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "memory") {
      // (memory (export "memory") N) — inline export of mem 0.
      let mm: SExpr = mod.items[i];
      let j: i32 = 1;
      while (j < mm.items.len()) {
        if (node_head(mm.items[j]) == "export") {
          expBody = wname(expBody, mm.items[j].items[1].text);
          expBody = expBody.append(2);  // mem
          expBody = leb_u32(expBody, 0);
          expCount = expCount + 1;
        }
        j = j + 1;
      }
    }
    if (node_head(mod.items[i]) == "export") {
      let ex: SExpr = mod.items[i];
      expBody = wname(expBody, ex.items[1].text);
      expBody = expBody.append(0);  // func
      expBody = leb_u32(expBody, name_idx(fnames, ex.items[2].items[1].text));
      expCount = expCount + 1;
    }
    i = i + 1;
  }

  // --- code section. ---
  let codeBody: i32[] = [];
  i = 0;
  while (i < definedNodes.len()) {
    let fnode: SExpr = definedNodes[i];
    let lnames: string[] = local_names(fnode);
    let fbody: i32[] = enc_locals_vec(local_decl_types(fnode));
    let instrs: SExpr[] = body_instrs(fnode);
    if (instrs.len() > 0 && instrs[0].kind != 0) {
      // FLAT body: a linear sequence of bare instruction atoms (the
      // stack-IR emitter's output). Encode it directly — flat WAT is the
      // natural shape of the wasm binary format.
      fbody = wcat(fbody, enc_flat_body(instrs, lnames, fnames, gnames, tnames));
    } else {
      // FOLDED body: nested S-expression instructions (the AST emitter's
      // output), encoded post-order.
      let k: i32 = 0;
      while (k < instrs.len()) {
        fbody = wcat(fbody, enc_instr(instrs[k], lnames, fnames, gnames, [], tnames));
        k = k + 1;
      }
    }
    fbody = fbody.append(11);  // end
    codeBody = leb_u32(codeBody, fbody.len());
    codeBody = wcat(codeBody, fbody);
    i = i + 1;
  }

  // --- data section. ---
  let dataBody: i32[] = [];
  let dataCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "data") {
      let dn: SExpr = mod.items[i];
      dataBody = dataBody.append(0);  // active, memory 0
      dataBody = wcat(dataBody, enc_instr(dn.items[1], [], fnames, gnames, [], []));  // offset (i32.const N)
      dataBody = dataBody.append(11);  // end
      let bytes: i32[] = data_bytes(dn.items[2].text);
      dataBody = leb_u32(dataBody, bytes.len());
      dataBody = wcat(dataBody, bytes);
      dataCount = dataCount + 1;
    }
    i = i + 1;
  }

  // --- table section: `(table N funcref)` → funcref limits {min N}. ---
  let tableBody: i32[] = [];
  let tableCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "table") {
      let tbn: SExpr = mod.items[i];
      tableBody = tableBody.append(112);  // 0x70 funcref
      tableBody = tableBody.append(0);  // limits: no max
      tableBody = leb_u32(tableBody, parse_dec(tbn.items[1].text));
      tableCount = tableCount + 1;
    }
    i = i + 1;
  }

  // --- elem section: `(elem (i32.const N) $f …)` → active segment on
  // table 0 with an offset expr + a vec of function indices. ---
  let elemBody: i32[] = [];
  let elemCount: i32 = 0;
  i = 0;
  while (i < mod.items.len()) {
    if (node_head(mod.items[i]) == "elem") {
      let en: SExpr = mod.items[i];
      elemBody = elemBody.append(0);  // flags: active, table 0
      elemBody = wcat(elemBody, enc_instr(en.items[1], [], fnames, gnames, [], []));
      elemBody = elemBody.append(11);  // end
      let fb: i32[] = [];
      let ei: i32 = 2;
      while (ei < en.items.len()) {
        fb = leb_u32(fb, name_idx(fnames, en.items[ei].text));
        ei = ei + 1;
      }
      elemBody = wcat(elemBody, wvec(en.items.len() - 2, fb));
      elemCount = elemCount + 1;
    }
    i = i + 1;
  }

  // --- assemble the module (sections in binary id order). ---
  let out: i32[] = wmagic();
  out = wcat(out, wsection(1, wvec(ntypes + nfuncs, typeBody)));
  out = wcat(out, wsection(2, wvec(importNodes.len(), impBody)));
  out = wcat(out, wsection(3, wvec(definedNodes.len(), funcBody)));
  if (tableCount > 0) {
    out = wcat(out, wsection(4, wvec(tableCount, tableBody)));
  }
  if (memCount > 0) {
    out = wcat(out, wsection(5, wvec(memCount, memBody)));
  }
  if (globCount > 0) {
    out = wcat(out, wsection(6, wvec(globCount, globBody)));
  }
  if (expCount > 0) {
    out = wcat(out, wsection(7, wvec(expCount, expBody)));
  }
  if (elemCount > 0) {
    out = wcat(out, wsection(9, wvec(elemCount, elemBody)));
  }
  out = wcat(out, wsection(10, wvec(definedNodes.len(), codeBody)));
  if (dataCount > 0) {
    out = wcat(out, wsection(11, wvec(dataCount, dataBody)));
  }
  return out;
}

// func_sig spells a func node's signature, for comparing two imports.
function func_sig(fn: SExpr): string {
  let o: string = "";
  let ps: string[] = func_param_types(fn);
  let i: i32 = 0;
  while (i < ps.len()) {
    o = o + ps[i] + ",";
    i = i + 1;
  }
  o = o + "->";
  let rs: string[] = func_result_types(fn);
  i = 0;
  while (i < rs.len()) {
    o = o + rs[i] + ",";
    i = i + 1;
  }
  return o;
}

// rename_atoms returns `n` with every atom in `from` respelled as the
// `to` at the same index.
function rename_atoms(n: SExpr, from: string[], to: string[]): SExpr {
  if (n.kind == 2) {
    let k: i32 = index_of_str(from, n.text);
    if (k >= 0) {
      return SExpr { kind: 2, text: to[k], items: [] };
    }
    return n;
  }
  if (n.kind != 0) {
    return n;
  }
  let out: SExpr[] = [];
  let i: i32 = 0;
  while (i < n.items.len()) {
    out = out.append(rename_atoms(n.items[i], from, to));
    i = i + 1;
  }
  return SExpr { kind: 0, text: n.text, items: out };
}

// merge_duplicate_imports keeps one declaration of a function import the
// module declares twice with the same type, renaming the later name's
// references to the first. A core module may import the same host function
// under two names; a component may not ("duplicate import name" from the
// component step), and the emitter's runtime and an `@import` extern can each
// name the same one — the stdout path and a wasi:io stream write both import
// blocking-write-and-flush. Two declarations of different types are left as
// they are: that conflict is the component step's to report.
function merge_duplicate_imports(mod: SExpr): SExpr {
  let keep: SExpr[] = [];
  let seen_key: string[] = [];
  let seen_name: string[] = [];
  let from: string[] = [];
  let to: string[] = [];
  let i: i32 = 0;
  while (i < mod.items.len()) {
    let it: SExpr = mod.items[i];
    if (node_head(it) == "import" && it.items.len() == 4 && node_head(it.items[3]) == "func") {
      let fn: SExpr = func_node(it);
      let key: string = it.items[1].text + "\n" + it.items[2].text + "\n" + func_sig(fn);
      let k: i32 = index_of_str(seen_key, key);
      if (k >= 0) {
        from = from.append(func_name(fn));
        to = to.append(seen_name[k]);
        i = i + 1;
        continue;
      }
      seen_key = seen_key.append(key);
      seen_name = seen_name.append(func_name(fn));
    }
    keep = keep.append(it);
    i = i + 1;
  }
  if (from.len() == 0) {
    return mod;
  }
  return rename_atoms(SExpr { kind: mod.kind, text: mod.text, items: keep }, from, to);
}

// wat_to_binary is the public pipeline entry: WAT text -> wasm binary
// bytes (an i32[] of 0..255). Used by the fern CLI's -target wasm32-wasi -emit core-module.
pub function wat_to_binary(wat: string): i32[] {
  return emit_binary(merge_duplicate_imports(wat_parse(wat_tokenize(wat))));
}

// === component framing (merged from wat_component.fern) ===
// examples/self_host/wat_component.fern — Component-Model wrapping for the
// self-hosted binary wasm backend. The core-module encoder (wat_emit_bin)
// produces a WASI-preview1 core module; this wraps it in the binary
// Component-Model envelope. First slice: the component preamble + embedding
// the core module as a component core-module section, which `wasm-tools`
// validates as a `(component (core module …))`.
//
// A component's preamble is the wasm magic followed by `0d 00 01 00`
// (version 13, layer 1) — distinct from a core module's `01 00 00 00` —
// and its sections use the component section ids (1 = an embedded core
// module, whose body is that module's own bytes).
//
// Later slices add the core-instance, the `canon lift`, and the
// `wasi:cli/run` instance export. Depends on leb128.fern + wat_encode.fern
// (wcat / wsection) but is otherwise import-free.

// component_preamble: "\0asm" + component version (13) / layer (1).
pub function component_preamble(): i32[] {
  let o: i32[] = [];
  o = o.append(0);
  o = o.append(97);
  o = o.append(115);
  o = o.append(109);
  o = o.append(13);
  o = o.append(0);
  o = o.append(1);
  o = o.append(0);
  return o;
}

// component_wrap embeds a core module's bytes in a component as a
// core-module section (component section id 1), returning the component
// binary. This is the structural envelope the canon / wasi layers build on.
function component_wrap(core: i32[]): i32[] {
  let o: i32[] = component_preamble();
  return wcat(o, wsection(1, core));
}

// component_full wraps a core module that exports `_lang_run` (the
// component entry: `() -> i32`, 0 = ok) into a complete `wasi:cli/run@0.2.0`
// component. Beyond the embedded core (section 1) the framing is constant
// for this fixed shape, so the six trailing sections are emitted verbatim
// (decoded from the reference component):
//   2  core-instance   — instantiate module 0, no args
//   6  alias           — core-instance 0 export "_lang_run" as a core func
//   7  component type  — `(result)` and `(func (result 0))`
//   8  canon           — lift core func 0 to the component func, type 1
//   5  instance        — an instance exporting "run" = func 0
//  11  export          — that instance as "wasi:cli/run@0.2.0"
pub function component_full(core: i32[]): i32[] {
  let o: i32[] = component_preamble();
  o = wcat(o, wsection(1, core));

  // 2 core-instance: vec(1)[ instantiate(0x00) module 0, 0 args ]
  o = wcat(o, wsection(2, [1, 0, 0, 0]));

  // 6 alias: vec(1)[ core(0) func(0) core-export(1) instance 0, name ]
  let al: i32[] = [1, 0, 0, 1, 0];
  al = wname(al, "_lang_run");
  o = wcat(o, wsection(6, al));

  // 7 component type: the two types `run` lifts to.
  o = wcat(o, wsection(7, [2, 106, 0, 0, 64, 0, 0, 0]));

  // 8 canon: vec(1)[ lift core func 0, no opts, type 1 ]
  o = wcat(o, wsection(8, [1, 0, 0, 0, 0, 1]));

  // 5 instance: vec(1)[ inline exports: "run" = func 0 ]
  let inst: i32[] = [1, 1, 1, 0];
  inst = wname(inst, "run");
  inst = inst.append(1);
  inst = inst.append(0);
  o = wcat(o, wsection(5, inst));

  // 11 export: vec(1)[ name "wasi:cli/run@0.2.0" = instance 0 ]
  let ex: i32[] = [1, 0];
  ex = wname(ex, "wasi:cli/run@0.2.0");
  ex = ex.append(5);
  ex = ex.append(0);
  ex = ex.append(0);
  o = wcat(o, wsection(11, ex));

  return o;
}

// ---- I/O (stdout) component framing -------------------------------------
//
// component_full_io wraps a core module that uses the preview2 stdout
// imports (wasi:cli/stdout/get-stdout + wasi:io/streams/
// [method]output-stream.blocking-write-and-flush) and exports `_lang_run`
// into a full wasi:cli/run component. The wasi type imports, the two
// canon-lower shim core modules, and the canon-lift/instance/export
// framing are constant for this fixed stdout shape, so — like the native
// compiler's precomputed component-type blob — they are embedded verbatim
// (as \xNN byte strings) around the core, which is spliced into the
// core-module section slot. (stdout only; file I/O would need more
// framing.)

// ---- per-interface component type-import blocks --------------------------
//
// Phase 1 of the generative component builder (docs/WASM-COMPONENT-GENERATOR.md):
// the I/O component prefix decomposes into one constant block per wasi
// interface, emitted in canonical order. Because canonical order fixes each
// block's type/instance indices, these blocks are reusable across shapes
// (e.g. tb_io_error is byte-identical at the head of every prefix). The
// component preamble is component_preamble(); these are the post-preamble
// type/import/alias sections.

// tb_io_error: the wasi:io/error interface (the `error` resource). Always the
// first type import (io/streams depends on it).
function tb_io_error(): string {
  return "\x07\r\x01B\x01\x04\x00\x05error\x03\x01\n\x18\x01\x00\x13wasi:io/error@0.2.0\x05\x00\x06\n\x01\x03\x00\x00\x05error";
}

// tb_io_streams_out: the wasi:io/streams interface exposing output-stream +
// blocking-write-and-flush + the stream-error variant (the output-only shape;
// the fs-read shapes additionally define input-stream).
function tb_io_streams_out(): string {
  return "\x07\xb2\x01\x01B\x0b\x04\x00\routput-stream\x03\x01\x02\x03\x02\x01\x01\x04\x00\x05error\x03\x00\x01\x01i\x02\x01q\x02\x15last-operation-failed\x01\x03\x00\x06closed\x00\x00\x04\x00\x0cstream-error\x03\x00\x04\x01h\x00\x01p}\x01j\x00\x01\x05\x01@\x02\x04self\x06\x08contents\x07\x00\x08\x04\x00.[method]output-stream.blocking-write-and-flush\x01\t\n\x1a\x01\x00\x15wasi:io/streams@0.2.0\x05\x02\x06\x12\x01\x03\x00\x01\routput-stream";
}

// tb_io_streams_inout: the wasi:io/streams interface exposing BOTH output- and
// input-stream (+ blocking-write-and-flush / the stream-error variant) -- the
// shape the fs-read prefixes use (vs tb_io_streams_out for write/stdout only).
function tb_io_streams_inout(): string {
  return "\x07\x83\x02\x01B\x10\x04\x00\routput-stream\x03\x01\x04\x00\x0cinput-stream\x03\x01\x02\x03\x02\x01\x01\x04\x00\x05error\x03\x00\x02\x01i\x03\x01q\x02\x15last-operation-failed\x01\x04\x00\x06closed\x00\x00\x04\x00\x0cstream-error\x03\x00\x05\x01h\x00\x01h\x01\x01p}\x01j\x00\x01\x06\x01j\x01\t\x01\x06\x01@\x02\x04self\x07\x08contents\t\x00\n\x04\x00.[method]output-stream.blocking-write-and-flush\x01\x0c\x01@\x02\x04self\x08\x03lenw\x00\x0b\x04\x00\"[method]input-stream.blocking-read\x01\r\n\x1a\x01\x00\x15wasi:io/streams@0.2.0\x05\x02\x06\x12\x01\x03\x00\x01\routput-stream\x06\x11\x01\x03\x00\x01\x0cinput-stream";
}

// fs prefix tails: the filesystem/types + filesystem/preopens + cli/stdout
// blocks specific to each fs shape (index-shifted, so per-shape), appended to
// the shared io/error + io/streams head.
function fs_read_tail(): string {
  return "\x07\xc8\x06\x01B\x14\x04\x00\ndescriptor\x03\x01\x02\x03\x02\x01\x04\x04\x00\x0cinput-stream\x03\x00\x01\x01m%\x06access\x0bwould-block\x07already\x0ebad-descriptor\x04busy\x08deadlock\x05quota\x05exist\x0efile-too-large\x15illegal-byte-sequence\x0bin-progress\x0binterrupted\x07invalid\x02io\x0cis-directory\x04loop\x0etoo-many-links\x0cmessage-size\rname-too-long\tno-device\x08no-entry\x07no-lock\x13insufficient-memory\x12insufficient-space\rnot-directory\tnot-empty\x0fnot-recoverable\x0bunsupported\x06no-tty\x0eno-such-device\x08overflow\rnot-permitted\x04pipe\tread-only\x0cinvalid-seek\x0etext-file-busy\x0ccross-device\x04\x00\nerror-code\x03\x00\x03\x01n\x01\x0esymlink-follow\x04\x00\npath-flags\x03\x00\x05\x01n\x04\x06create\tdirectory\texclusive\x08truncate\x04\x00\nopen-flags\x03\x00\x07\x01n\x06\x04read\x05write\x13file-integrity-sync\x13data-integrity-sync\x14requested-write-sync\x10mutate-directory\x04\x00\x10descriptor-flags\x03\x00\t\x01i\x00\x01i\x02\x01h\x00\x01j\x01\x0b\x01\x04\x01j\x01\x0c\x01\x04\x01@\x05\x04self\r\npath-flags\x06\x04paths\nopen-flags\x08\x05flags\n\x00\x0e\x04\x00\x1a[method]descriptor.open-at\x01\x10\x01@\x02\x04self\r\x06offsetw\x00\x0f\x04\x00\"[method]descriptor.read-via-stream\x01\x11\n \x01\x00\x1bwasi:filesystem/types@0.2.0\x05\x05\x06\x0f\x01\x03\x00\x02\ndescriptor\x07<\x01B\x07\x02\x03\x02\x01\x06\x04\x00\ndescriptor\x03\x00\x00\x01i\x01\x01o\x02\x02s\x01p\x03\x01@\x00\x00\x04\x04\x00\x0fget-directories\x01\x05\n#\x01\x00\x1ewasi:filesystem/preopens@0.2.0\x05\x07\x072\x01B\x05\x02\x03\x02\x01\x03\x04\x00\routput-stream\x03\x00\x00\x01i\x01\x01@\x00\x00\x02\x04\x00\nget-stdout\x01\x03\n\x1a\x01\x00\x15wasi:cli/stdout@0.2.0\x05\x08";
}

function fs_rw_tail(): string {
  return "\x07\xa4\x07\x01B\x1a\x04\x00\ndescriptor\x03\x01\x02\x03\x02\x01\x04\x04\x00\x0cinput-stream\x03\x00\x01\x02\x03\x02\x01\x03\x04\x00\routput-stream\x03\x00\x03\x01m%\x06access\x0bwould-block\x07already\x0ebad-descriptor\x04busy\x08deadlock\x05quota\x05exist\x0efile-too-large\x15illegal-byte-sequence\x0bin-progress\x0binterrupted\x07invalid\x02io\x0cis-directory\x04loop\x0etoo-many-links\x0cmessage-size\rname-too-long\tno-device\x08no-entry\x07no-lock\x13insufficient-memory\x12insufficient-space\rnot-directory\tnot-empty\x0fnot-recoverable\x0bunsupported\x06no-tty\x0eno-such-device\x08overflow\rnot-permitted\x04pipe\tread-only\x0cinvalid-seek\x0etext-file-busy\x0ccross-device\x04\x00\nerror-code\x03\x00\x05\x01n\x01\x0esymlink-follow\x04\x00\npath-flags\x03\x00\x07\x01n\x04\x06create\tdirectory\texclusive\x08truncate\x04\x00\nopen-flags\x03\x00\t\x01n\x06\x04read\x05write\x13file-integrity-sync\x13data-integrity-sync\x14requested-write-sync\x10mutate-directory\x04\x00\x10descriptor-flags\x03\x00\x0b\x01i\x00\x01i\x02\x01i\x04\x01h\x00\x01j\x01\r\x01\x06\x01j\x01\x0e\x01\x06\x01j\x01\x0f\x01\x06\x01@\x05\x04self\x10\npath-flags\x08\x04paths\nopen-flags\n\x05flags\x0c\x00\x11\x04\x00\x1a[method]descriptor.open-at\x01\x14\x01@\x02\x04self\x10\x06offsetw\x00\x12\x04\x00\"[method]descriptor.read-via-stream\x01\x15\x01@\x02\x04self\x10\x06offsetw\x00\x13\x04\x00#[method]descriptor.write-via-stream\x01\x16\n \x01\x00\x1bwasi:filesystem/types@0.2.0\x05\x05\x06\x0f\x01\x03\x00\x02\ndescriptor\x07<\x01B\x07\x02\x03\x02\x01\x06\x04\x00\ndescriptor\x03\x00\x00\x01i\x01\x01o\x02\x02s\x01p\x03\x01@\x00\x00\x04\x04\x00\x0fget-directories\x01\x05\n#\x01\x00\x1ewasi:filesystem/preopens@0.2.0\x05\x07\x072\x01B\x05\x02\x03\x02\x01\x03\x04\x00\routput-stream\x03\x00\x00\x01i\x01\x01@\x00\x00\x02\x04\x00\nget-stdout\x01\x03\n\x1a\x01\x00\x15wasi:cli/stdout@0.2.0\x05\x08";
}

function fs_write_tail(): string {
  return "\x07\xca\x06\x01B\x14\x04\x00\ndescriptor\x03\x01\x02\x03\x02\x01\x03\x04\x00\routput-stream\x03\x00\x01\x01m%\x06access\x0bwould-block\x07already\x0ebad-descriptor\x04busy\x08deadlock\x05quota\x05exist\x0efile-too-large\x15illegal-byte-sequence\x0bin-progress\x0binterrupted\x07invalid\x02io\x0cis-directory\x04loop\x0etoo-many-links\x0cmessage-size\rname-too-long\tno-device\x08no-entry\x07no-lock\x13insufficient-memory\x12insufficient-space\rnot-directory\tnot-empty\x0fnot-recoverable\x0bunsupported\x06no-tty\x0eno-such-device\x08overflow\rnot-permitted\x04pipe\tread-only\x0cinvalid-seek\x0etext-file-busy\x0ccross-device\x04\x00\nerror-code\x03\x00\x03\x01n\x01\x0esymlink-follow\x04\x00\npath-flags\x03\x00\x05\x01n\x04\x06create\tdirectory\texclusive\x08truncate\x04\x00\nopen-flags\x03\x00\x07\x01n\x06\x04read\x05write\x13file-integrity-sync\x13data-integrity-sync\x14requested-write-sync\x10mutate-directory\x04\x00\x10descriptor-flags\x03\x00\t\x01i\x00\x01i\x02\x01h\x00\x01j\x01\x0b\x01\x04\x01j\x01\x0c\x01\x04\x01@\x05\x04self\r\npath-flags\x06\x04paths\nopen-flags\x08\x05flags\n\x00\x0e\x04\x00\x1a[method]descriptor.open-at\x01\x10\x01@\x02\x04self\r\x06offsetw\x00\x0f\x04\x00#[method]descriptor.write-via-stream\x01\x11\n \x01\x00\x1bwasi:filesystem/types@0.2.0\x05\x04\x06\x0f\x01\x03\x00\x02\ndescriptor\x07<\x01B\x07\x02\x03\x02\x01\x05\x04\x00\ndescriptor\x03\x00\x00\x01i\x01\x01o\x02\x02s\x01p\x03\x01@\x00\x00\x04\x04\x00\x0fget-directories\x01\x05\n#\x01\x00\x1ewasi:filesystem/preopens@0.2.0\x05\x06\x072\x01B\x05\x02\x03\x02\x01\x03\x04\x00\routput-stream\x03\x00\x00\x01i\x01\x01@\x00\x00\x02\x04\x00\nget-stdout\x01\x03\n\x1a\x01\x00\x15wasi:cli/stdout@0.2.0\x05\x07";
}

// Composed fs prefixes (preamble + io/error + io/streams + fs tail), replacing
// the former io_fs_*_prefix blobs.
function io_fs_read_head(): i32[] {
  let o: i32[] = component_preamble();
  o = wcat(o, blob_to_bytes(tb_io_error()));
  o = wcat(o, blob_to_bytes(tb_io_streams_inout()));
  return wcat(o, blob_to_bytes(fs_read_tail()));
}

function io_fs_rw_head(): i32[] {
  let o: i32[] = component_preamble();
  o = wcat(o, blob_to_bytes(tb_io_error()));
  o = wcat(o, blob_to_bytes(tb_io_streams_inout()));
  return wcat(o, blob_to_bytes(fs_rw_tail()));
}

function io_fs_write_head(): i32[] {
  let o: i32[] = component_preamble();
  o = wcat(o, blob_to_bytes(tb_io_error()));
  o = wcat(o, blob_to_bytes(tb_io_streams_out()));
  return wcat(o, blob_to_bytes(fs_write_tail()));
}

// tb_cli_stdout: the wasi:cli/stdout interface (get-stdout).
function tb_cli_stdout(): string {
  return "\x072\x01B\x05\x02\x03\x02\x01\x03\x04\x00\routput-stream\x03\x00\x00\x01i\x01\x01@\x00\x00\x02\x04\x00\nget-stdout\x01\x03\n\x1a\x01\x00\x15wasi:cli/stdout@0.2.0\x05\x04";
}

// io_stdout_head: preamble + io/error + io/streams(out) + cli/stdout -- the
// component prefix shared by every stdout-writing single-import shape, composed
// from the per-interface type blocks.
function io_stdout_head(): i32[] {
  let o: i32[] = component_preamble();
  o = wcat(o, blob_to_bytes(tb_io_error()));
  o = wcat(o, blob_to_bytes(tb_io_streams_out()));
  return wcat(o, blob_to_bytes(tb_cli_stdout()));
}

// Per-interface type blocks appended after the stdout head (canonical order).
function tb_random(): string {
  return "\x07\x1b\x01B\x02\x01@\x00\x00w\x04\x00\x0eget-random-u64\x01\x00\n\x1d\x01\x00\x18wasi:random/random@0.2.0\x05\x05";
}

function tb_cli_environment_env(): string {
  return "\x07$\x01B\x04\x01o\x02ss\x01p\x00\x01@\x00\x00\x01\x04\x00\x0fget-environment\x01\x02\n\x1f\x01\x00\x1awasi:cli/environment@0.2.0\x05\x05";
}

function tb_cli_environment_args(): string {
  return "\x07\x1d\x01B\x03\x01ps\x01@\x00\x00\x00\x04\x00\rget-arguments\x01\x01\n\x1f\x01\x00\x1awasi:cli/environment@0.2.0\x05\x05";
}

function tb_wall_clock(): string {
  return "\x077\x01B\x04\x01r\x02\x07secondsw\x0bnanosecondsy\x04\x00\x08datetime\x03\x00\x00\x01@\x00\x00\x01\x04\x00\x03now\x01\x02\n!\x01\x00\x1cwasi:clocks/wall-clock@0.2.0\x05\x05";
}

function tb_monotonic_clock(): string {
  return "\x07\x10\x01B\x02\x01@\x00\x00w\x04\x00\x03now\x01\x00\n&\x01\x00!wasi:clocks/monotonic-clock@0.2.0\x05\x05";
}

function tb_cli_exit(): string {
  return "\x07\x1d\x01B\x03\x01j\x00\x00\x01@\x01\x06status\x00\x01\x00\x04\x00\x04exit\x01\x01\n\x18\x01\x00\x13wasi:cli/exit@0.2.0\x05\x05";
}

// tb_cli_stderr: the wasi:cli/stderr interface (get-stderr); in the type
// section it follows cli/stdout (independent of the stderr-first function order).
function tb_cli_stderr(): string {
  return "\x072\x01B\x05\x02\x03\x02\x01\x03\x04\x00\routput-stream\x03\x00\x00\x01i\x01\x01@\x00\x00\x02\x04\x00\nget-stderr\x01\x03\n\x1a\x01\x00\x15wasi:cli/stderr@0.2.0\x05\x05";
}

// Combination tails: the trailing interface block in fs context (index-
// shifted from the stdout-family tails, so distinct), appended to a base fs
// prefix to form a combination prefix.
function tb_fsread_env_tail(): string {
  return "\x07$\x01B\x04\x01o\x02ss\x01p\x00\x01@\x00\x00\x01\x04\x00\x0fget-environment\x01\x02\n\x1f\x01\x00\x1awasi:cli/environment@0.2.0\x05\t";
}

function tb_fsread_args_tail(): string {
  return "\x07\x1d\x01B\x03\x01ps\x01@\x00\x00\x00\x04\x00\rget-arguments\x01\x01\n\x1f\x01\x00\x1awasi:cli/environment@0.2.0\x05\t";
}

function tb_fsrw_env_tail(): string {
  return "\x07$\x01B\x04\x01o\x02ss\x01p\x00\x01@\x00\x00\x01\x04\x00\x0fget-environment\x01\x02\n\x1f\x01\x00\x1awasi:cli/environment@0.2.0\x05\t";
}

function tb_fswrite_random_tail(): string {
  return "\x07\x1b\x01B\x02\x01@\x00\x00w\x04\x00\x0eget-random-u64\x01\x00\n\x1d\x01\x00\x18wasi:random/random@0.2.0\x05\x08";
}

// blob_to_bytes unpacks an embedded byte-string into an i32[] buffer.
pub function blob_to_bytes(s: string): i32[] {
  let o: i32[] = [];
  let i: i32 = 0;
  while (i < s.len()) {
    o = o.append(s[i] as i32);
    i = i + 1;
  }
  return o;
}

pub function component_full_io(core: i32[]): i32[] {
  // The stdout prefix, composed from the per-interface type blocks in
  // canonical order (preamble, io/error, io/streams, cli/stdout) rather than
  // one opaque blob — byte-identical to the old io_prefix, and the first step
  // of the generative builder (the blocks are reused by other shapes).
  let o: i32[] = io_stdout_head();
  o = wcat(o, wsection(1, core));
  // The suffix (shim cores + lower/finish wiring) is now generated from the
  // import list rather than emitted as one opaque blob.
  return wcat(o, component_suffix_stdout());
}

// ---- file-I/O (read_file + stdout) component framing --------------------
//
// component_full_io_fs wraps a core that uses the preview2 stdout + read
// filesystem imports (get-stdout, blocking-write-and-flush, get-directories,
// descriptor.open-at, descriptor.read-via-stream, input-stream.blocking-read)
// and exports `_lang_run` + `cabi_realloc` into a wasi:cli/run component.
// As with component_full_io the framing (wasi type imports, the canon-lower
// shim cores, canon-lift/instance/export) is constant for this fixed shape,
// so it is embedded verbatim as \xNN blobs around the core.

pub function component_full_io_fs(core: i32[]): i32[] {
  let o: i32[] = io_fs_read_head();
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_fs_read());
}

// ---- file-I/O (write_file + stdout) component framing -------------------
//
// component_full_io_fs_write wraps a core that uses the preview2 stdout +
// write filesystem imports (get-stdout, blocking-write-and-flush,
// get-directories, descriptor.open-at, descriptor.write-via-stream) and
// exports `_lang_run` + `cabi_realloc` into a wasi:cli/run component. The
// import set differs from the read shape (write-via-stream replaces
// read-via-stream + blocking-read), so it carries its own constant framing
// blobs around the core.

pub function component_full_io_fs_write(core: i32[]): i32[] {
  let o: i32[] = io_fs_write_head();
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_fs_write());
}

// ---- file-I/O (read_file + write_file + stdout) component framing -------
//
// component_full_io_fs_rw wraps a core that uses BOTH the preview2 read and
// write filesystem imports plus stdout (get-stdout, blocking-write-and-flush,
// get-directories, descriptor.open-at, descriptor.read-via-stream,
// input-stream.blocking-read, descriptor.write-via-stream). This is the
// import set emit_module_run_io_fs produces when a program calls both
// read_file and write_file; the framing differs from the read-only and
// write-only shapes (it lowers all of read-via + blocking-read + write-via),
// so it carries its own constant \xNN blobs.

pub function component_full_io_fs_rw(core: i32[]): i32[] {
  let o: i32[] = io_fs_rw_head();
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_fs_rw());
}

// ---- random + stdout component framing ----------------------------------
//
// component_full_io_random wraps a core that uses the preview2 stdout imports
// plus wasi:random/random's get-random-u64 (get-stdout,
// blocking-write-and-flush, get-random-u64) and exports `_lang_run` into a
// wasi:cli/run component. get-random-u64 returns a scalar (no list), so unlike
// the file shapes this framing needs no cabi_realloc. Constant for the shape,
// so embedded as \xNN blobs around the core.

pub function component_full_io_random(core: i32[]): i32[] {
  let o: i32[] = io_stdout_head();
  o = wcat(o, blob_to_bytes(tb_random()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_random());
}

// ---- env + stdout component framing -------------------------------------
//
// component_full_io_env wraps a core that uses the preview2 stdout imports
// plus wasi:cli/environment's get-environment (get-stdout,
// blocking-write-and-flush, get-environment) and exports `_lang_run` +
// `cabi_realloc` (get-environment returns a host-allocated list) into a
// wasi:cli/run component. Constant for the shape, so embedded as \xNN blobs.

pub function component_full_io_env(core: i32[]): i32[] {
  let o: i32[] = io_stdout_head();
  o = wcat(o, blob_to_bytes(tb_cli_environment_env()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_env());
}

// ---- args + stdout component framing ------------------------------------
//
// component_full_io_args wraps a core that uses the preview2 stdout imports
// plus wasi:cli/environment's get-arguments (get-stdout,
// blocking-write-and-flush, get-arguments) and exports `_lang_run` +
// `cabi_realloc` (get-arguments returns a host-allocated list) into a
// wasi:cli/run component. Constant for the shape, embedded as \xNN blobs.

pub function component_full_io_args(core: i32[]): i32[] {
  let o: i32[] = io_stdout_head();
  o = wcat(o, blob_to_bytes(tb_cli_environment_args()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_args());
}

// ---- clock (wall-clock) + stdout component framing ----------------------
//
// component_full_io_clock wraps a core that uses the preview2 stdout imports
// plus wasi:clocks/wall-clock's now (get-stdout, blocking-write-and-flush,
// now) and exports `_lang_run` into a wasi:cli/run component. wall-clock now
// returns a fixed datetime record (no list), so no cabi_realloc. Backs the
// now_unix_ms / now_ns builtins. Constant for the shape, embedded as \xNN
// blobs.

pub function component_full_io_clock(core: i32[]): i32[] {
  let o: i32[] = io_stdout_head();
  o = wcat(o, blob_to_bytes(tb_wall_clock()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_clock());
}

// ---- monotonic-clock + stdout component framing -------------------------
//
// component_full_io_clock_mono wraps a core that uses the preview2 stdout
// imports plus wasi:clocks/monotonic-clock's now (get-stdout,
// blocking-write-and-flush, now) and exports `_lang_run` into a wasi:cli/run
// component. monotonic-clock now returns a u64 instant directly (no record,
// no list -> no cabi_realloc). Backs the monotonic_ns builtin. Constant for
// the shape, embedded as \xNN blobs.

pub function component_full_io_clock_mono(core: i32[]): i32[] {
  let o: i32[] = io_stdout_head();
  o = wcat(o, blob_to_bytes(tb_monotonic_clock()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_clock_mono());
}

// ---- read_file + env + stdout component framing -------------------------
//
// component_full_io_fs_read_env wraps a core that uses the preview2 stdout
// imports plus env (get-environment) and the filesystem read chain
// (get-directories, descriptor.open-at, descriptor.read-via-stream,
// input-stream.blocking-read) -- the canonical edge-handler shape: read a
// config file + read env secrets + respond. The self-host emits imports in
// the native compiler's canonical order (stdout, bwf, get-environment, then
// the fs read chain), so this combined framing wires up byte-identically to
// native. Exports `_lang_run` + `cabi_realloc` (env + fs lists).

pub function component_full_io_fs_read_env(core: i32[]): i32[] {
  let o: i32[] = io_fs_read_head();
  o = wcat(o, blob_to_bytes(tb_fsread_env_tail()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_fs_read_env());
}

// ---- read_file + write_file + env + stdout component framing ------------
//
// component_full_io_fs_rw_env wraps a core that uses the preview2 stdout
// imports plus env (get-environment) and the full filesystem read+write chain
// (get-directories, open-at, read-via-stream, blocking-read, write-via-stream)
// -- the richest realistic edge-handler shape: read a config file, read env
// secrets, write an output/log file, respond. The self-host emits imports in
// the native compiler's canonical order, so this combined framing wires up
// byte-identically to native. Exports `_lang_run` + `cabi_realloc`.

pub function component_full_io_fs_rw_env(core: i32[]): i32[] {
  let o: i32[] = io_fs_rw_head();
  o = wcat(o, blob_to_bytes(tb_fsrw_env_tail()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_fs_rw_env());
}

// ---- random + write_file + stdout component framing ---------------------
//
// component_full_io_random_write wraps a core that uses the preview2 stdout
// imports plus random (get-random-u64) and the filesystem write chain
// (get-directories, open-at, write-via-stream) -- the token-generating
// handler shape: draw a random id, persist it, respond. random is mem-free
// (lowered without memory) while the fs imports are mem-dependent, so this
// mixes both lowering kinds; canonical import order keeps it byte-identical
// to native. Exports `_lang_run` + `cabi_realloc` (fs lists).

pub function component_full_io_random_write(core: i32[]): i32[] {
  let o: i32[] = io_fs_write_head();
  o = wcat(o, blob_to_bytes(tb_fswrite_random_tail()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_random_write());
}

// ---- eprint (stderr) + stdout component framing -------------------------
//
// component_full_io_eprint wraps a core that uses eprint -- the preview2
// stderr import (wasi:cli/stderr's get-stderr) plus the shared stdout pair
// (get-stderr, blocking-write-and-flush, get-stdout). The native compiler
// orders stderr before stdout, which the self-host mirrors; stdout is always
// present on the io path, so this single framing covers both eprint+stdout
// and eprint-only programs (the latter just leaves the stdout import unused).
// Exports `_lang_run`; no list results, so no cabi_realloc.

pub function component_full_io_eprint(core: i32[]): i32[] {
  let o: i32[] = io_stdout_head();
  o = wcat(o, blob_to_bytes(tb_cli_stderr()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_eprint());
}

// ---- exit + stdout component framing ------------------------------------
//
// component_full_io_exit wraps a core that uses exit -- the preview2
// wasi:cli/exit import (its `exit` takes a result discriminant: 0 = ok -> exit
// 0, 1 = err -> exit 1) plus the stdout pair (get-stdout,
// blocking-write-and-flush, exit). exit sits right after the stdout pair in
// the native compiler's canonical order. No list results, so no cabi_realloc.

pub function component_full_io_exit(core: i32[]): i32[] {
  let o: i32[] = io_stdout_head();
  o = wcat(o, blob_to_bytes(tb_cli_exit()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_exit());
}

// Assertions report on stderr before exiting. Import both interfaces over
// the stdout prefix; the exit interface is type 6 after stderr's type 5.
pub function component_full_io_eprint_exit(core: i32[]): i32[] {
  let o: i32[] = io_stdout_head();
  o = wcat(o, blob_to_bytes(tb_cli_stderr()));
  o = wcat(o, blob_to_bytes("\x07\x1d\x01B\x03\x01j\x00\x00\x01@\x01\x06status\x00\x01\x00\x04\x00\x04exit\x01\x01\n\x18\x01\x00\x13wasi:cli/exit@0.2.0\x05\x06"));
  o = wcat(o, wsection(1, core));
  let none: i32[] = [];
  return wcat(o, component_suffix_io(
    ["wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0", "wasi:cli/stderr@0.2.0", "wasi:cli/exit@0.2.0"],
    [blocking_write_name(), "get-stdout", "get-stderr", "exit"],
    [1, 0, 0, 0],
    [1, 2, 3, 4],
    [[127, 127, 127, 127], none, none, none],
    [0, 0, 0, 0],
    7, 5, 0, "_lang_run",
  ));
}

// ---- args + read_file + stdout component framing ------------------------
//
// component_full_io_fs_args_read wraps a core that uses the preview2 stdout
// imports plus args (get-arguments) and the filesystem read chain
// (get-directories, open-at, read-via-stream, blocking-read) -- the canonical
// CLI-tool shape: read a filename from argv, read that file, print it (like
// `cat $1`). Canonical import order keeps it byte-identical to native.
// Exports `_lang_run` + `cabi_realloc` (args + fs lists).

pub function component_full_io_fs_args_read(core: i32[]): i32[] {
  let o: i32[] = io_fs_read_head();
  o = wcat(o, blob_to_bytes(tb_fsread_args_tail()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_fs_args_read());
}

// ---- args + read_file + write_file + stdout component framing -----------
//
// component_full_io_fs_rw_args wraps a core for the file-transform CLI shape
// (read a file named in argv, write another) -- the read+write fs imports plus
// args. Its prefix is io_fs_rw_head() + a small args tail (demonstrating the
// phase-3 prefix composition); the suffix is captured (per the design doc, the
// suffix wiring is not yet generative).

function tb_fsrw_args_tail(): string {
  return "\x07\x1d\x01B\x03\x01ps\x01@\x00\x00\x00\x04\x00\rget-arguments\x01\x01\n\x1f\x01\x00\x1awasi:cli/environment@0.2.0\x05\t";
}

pub function component_full_io_fs_rw_args(core: i32[]): i32[] {
  let o: i32[] = io_fs_rw_head();
  o = wcat(o, blob_to_bytes(tb_fsrw_args_tail()));
  o = wcat(o, wsection(1, core));
  return wcat(o, component_suffix_fs_rw_args());
}

// ---- generative suffix builder: shim cores ------------------------------
//
// Phase of docs/WASM-COMPONENT-GENERATOR.md's suffix work. A memory-dependent
// import (one taking/returning a list, lowered with (memory)) is wired through
// the wit-component "$imports" table trampoline. Two tiny core modules per such
// import, both parameterised by the import's lowered core signature:
//   - shim_trampoline_core: exports func "0" (forwards its params, then
//     call_indirect through table slot 0) + the "$imports" funcref table.
//   - shim_tablefill_core: imports func "0" + the "$imports" table, and an
//     elem writes func 0 into slot 0.
// These reproduce the native compiler's shim cores byte-for-byte (validated by
// TestSelfHostWasmShimCore against the stdout blocking-write-and-flush shape).

// functype emits a core wasm functype: 0x60, vec(params), vec(results), where
// each param/result is a valtype byte (i32=0x7f, i64=0x7e, f32=0x7d, f64=0x7c).
function functype(params: i32[], results: i32[]): i32[] {
  let t: i32[] = [96];
  t = leb_u32(t, params.len());
  t = wcat(t, params);
  t = leb_u32(t, results.len());
  return wcat(t, results);
}

function shim_trampoline_core(params: i32[], results: i32[]): i32[] {
  let o: i32[] = [0, 97, 115, 109, 1, 0, 0, 0];
  o = wcat(o, wsection(1, wvec(1, functype(params, results))));
  o = wcat(o, wsection(3, [1, 0]));
  o = wcat(o, wsection(4, [1, 112, 1, 1, 1]));
  let ex: i32[] = [2];
  ex = wname(ex, "0");
  ex = ex.append(0);
  ex = ex.append(0);
  ex = wname(ex, "$imports");
  ex = ex.append(1);
  ex = ex.append(0);
  o = wcat(o, wsection(7, ex));
  let body: i32[] = [0];
  let k: i32 = 0;
  while (k < params.len()) {
    body = body.append(32);
    body = body.append(k);
    k = k + 1;
  }
  body = body.append(65);
  body = body.append(0);
  body = body.append(17);
  body = body.append(0);
  body = body.append(0);
  body = body.append(11);
  let fe: i32[] = [];
  fe = leb_u32(fe, body.len());
  fe = wcat(fe, body);
  return wcat(o, wsection(10, wvec(1, fe)));
}

function shim_tablefill_core(params: i32[], results: i32[]): i32[] {
  let o: i32[] = [0, 97, 115, 109, 1, 0, 0, 0];
  o = wcat(o, wsection(1, wvec(1, functype(params, results))));
  let im: i32[] = [2];
  im = im.append(0);
  im = wname(im, "0");
  im = im.append(0);
  im = im.append(0);
  im = im.append(0);
  im = wname(im, "$imports");
  im = im.append(1);
  im = im.append(112);
  im = im.append(1);
  im = im.append(1);
  im = im.append(1);
  o = wcat(o, wsection(2, im));
  return wcat(o, wsection(9, [1, 0, 65, 0, 11, 1, 0]));
}

// ---- generative suffix builder: component-section encoders --------------
//
// Ports of internal/wasm/component/component.go's Put* primitives that the
// native composer's lower() (Phases B-H) + finish() emit. Each wraps a body
// in a component section (wsection = native wrapSection; wname = putName).
// Together with the shim cores above they regenerate a CLI component's whole
// suffix from the import list. The component section ids: 1 core-module,
// 2 core-instance, 5 instance, 6 alias, 7 type, 8 canon, 11 export.

pub function comp_core_module_section(mod: i32[]): i32[] {
  return wsection(1, mod);
}

// core-instance "instantiate" with no args (a self-contained module).
function comp_core_instance_instantiate(modidx: i32): i32[] {
  let b: i32[] = [1, 0];
  b = leb_u32(b, modidx);
  b = b.append(0);
  return wsection(2, b);
}

// core-instance "instantiate" passing N instance args (name -> instance idx).
function comp_core_instance_instantiate_args(modidx: i32, names: string[], insts: i32[]): i32[] {
  let b: i32[] = [1, 0];
  b = leb_u32(b, modidx);
  b = leb_u32(b, names.len());
  let i: i32 = 0;
  while (i < names.len()) {
    b = wname(b, names[i]);
    b = b.append(18);
    b = leb_u32(b, insts[i]);
    i = i + 1;
  }
  return wsection(2, b);
}

// core-instance "from-exports": package N (name, core-sort, idx) entries.
function comp_core_instance_from_exports(names: string[], sorts: i32[], idxs: i32[]): i32[] {
  let b: i32[] = [1, 1];
  b = leb_u32(b, names.len());
  let i: i32 = 0;
  while (i < names.len()) {
    b = wname(b, names[i]);
    b = b.append(sorts[i]);
    b = leb_u32(b, idxs[i]);
    i = i + 1;
  }
  return wsection(2, b);
}

// alias a func exported by a component instance -> top-level component func.
function comp_alias_inst_func(inst: i32, name: string): i32[] {
  let b: i32[] = [1, 1, 0];
  b = leb_u32(b, inst);
  b = wname(b, name);
  return wsection(6, b);
}

// alias a func exported by a CORE instance -> top-level core func.
function comp_alias_core_func(coreinst: i32, name: string): i32[] {
  let b: i32[] = [1, 0, 0, 1];
  b = leb_u32(b, coreinst);
  b = wname(b, name);
  return wsection(6, b);
}

// alias a core-instance export of any sort (memory=2 / table=1 / func=0).
function comp_alias_core_export(coresort: i32, coreinst: i32, name: string): i32[] {
  let b: i32[] = [1, 0, coresort, 1];
  b = leb_u32(b, coreinst);
  b = wname(b, name);
  return wsection(6, b);
}

// canon lower a component func with no opts.
function comp_canon_lower_noopts(funcidx: i32): i32[] {
  let b: i32[] = [1, 1, 0];
  b = leb_u32(b, funcidx);
  b = b.append(0);
  return wsection(8, b);
}

// canon lower carrying a single `memory` option.
function comp_canon_lower_mem(funcidx: i32, memidx: i32): i32[] {
  let b: i32[] = [1, 1, 0];
  b = leb_u32(b, funcidx);
  b = b.append(1);
  b = b.append(3);
  b = leb_u32(b, memidx);
  return wsection(8, b);
}

// canon lift a core func into a component func of the given type, no opts.
function comp_canon_lift_noopts(corefunc: i32, typeidx: i32): i32[] {
  let b: i32[] = [1, 0, 0];
  b = leb_u32(b, corefunc);
  b = b.append(0);
  b = leb_u32(b, typeidx);
  return wsection(8, b);
}

// two component types: result<_,_> at `rt`, then func() -> result<rt> at rt+1.
function comp_type_result_unit(rt: i32): i32[] {
  let b: i32[] = [2, 106, 0, 0, 64, 0, 0];
  b = leb_u32(b, rt);
  return wsection(7, b);
}

// component instance packaging one func under `name`.
function comp_instance_one_func(name: string, funcidx: i32): i32[] {
  let b: i32[] = [1, 1, 1, 0];
  b = wname(b, name);
  b = b.append(1);
  b = leb_u32(b, funcidx);
  return wsection(5, b);
}

// export a component instance under a WASI interface name.
function comp_export_one_instance(name: string, inst: i32): i32[] {
  let b: i32[] = [1, 0];
  b = wname(b, name);
  b = b.append(5);
  b = leb_u32(b, inst);
  b = b.append(0);
  return wsection(11, b);
}

// alias a type exported by a component instance -> top-level component type
// (a resource surfaced out of an imported interface, for a canon resource.drop
// or an own<> handle type).
pub function comp_alias_inst_type(inst: i32, name: string): i32[] {
  let b: i32[] = [1, 3, 0];
  b = leb_u32(b, inst);
  b = wname(b, name);
  return wsection(6, b);
}

// component type own<rt>.
function comp_type_own(rt: i32): i32[] {
  let b: i32[] = [1, 105];
  b = leb_u32(b, rt);
  return wsection(7, b);
}

// component func type `handle: func(request: own_req, response-out: own_out)`
// — wasi:http/incoming-handler's one export, no result.
function comp_type_handle_func(own_req: i32, own_out: i32): i32[] {
  let b: i32[] = [1, 64, 2];
  b = wname(b, "request");
  b = leb_u32(b, own_req);
  b = wname(b, "response-out");
  b = leb_u32(b, own_out);
  b = b.append(1);
  b = b.append(0);
  return wsection(7, b);
}

// canon resource.drop: a core func that drops a handle of resourceT.
function comp_canon_resource_drop(rt: i32): i32[] {
  let b: i32[] = [1, 3];
  b = leb_u32(b, rt);
  return wsection(8, b);
}

// canon lower carrying both `memory` and `realloc` options (for imports whose
// canonical-ABI shape returns a heap-allocated list/string).
function comp_canon_lower_mem_realloc(funcidx: i32, memidx: i32, realloc: i32): i32[] {
  let b: i32[] = [1, 1, 0];
  b = leb_u32(b, funcidx);
  b = b.append(2);
  b = b.append(3);
  b = leb_u32(b, memidx);
  b = b.append(4);
  b = leb_u32(b, realloc);
  return wsection(8, b);
}

// AsyncLift is one async-lifted export: the component func `name` (kebab
// case), its parameters as component valtype bytes and its result's (-1 for
// none). The core module exports its entry as `[async-lift]CORE_NAME` and
// imports its task.return as `[task-return]CORE_NAME` from `[export]$root`.
pub struct AsyncLift { name: string, core_name: string, param_names: string[], param_types: i32[], result: i32 }

// comp_resultlist appends a func type's results: one anonymous valtype, or
// none when `vt` is -1.
function comp_resultlist(b: i32[], vt: i32): i32[] {
  if (vt < 0) {
    b = b.append(1);
    return b.append(0);
  }
  b = b.append(0);
  return b.append(vt);
}

// canon task.return: a core func taking the result `vt` (nothing when -1).
function comp_canon_task_return(vt: i32): i32[] {
  let b: i32[] = [1, 9];
  b = comp_resultlist(b, vt);
  b = b.append(0);
  return wsection(8, b);
}

// component type `async func(params) -> result` for an async export.
function comp_type_async_func(l: AsyncLift): i32[] {
  let b: i32[] = [1, 67];
  b = leb_u32(b, l.param_types.len());
  let i: i32 = 0;
  while (i < l.param_types.len()) {
    b = wname(b, l.param_names[i]);
    b = b.append(l.param_types[i]);
    i = i + 1;
  }
  b = comp_resultlist(b, l.result);
  return wsection(7, b);
}

// canon lift a core func with the `async` option and no callback: the
// stackful lift, whose core func returns once task.return has run.
function comp_canon_lift_async(corefunc: i32, typeidx: i32): i32[] {
  let b: i32[] = [1, 0, 0];
  b = leb_u32(b, corefunc);
  b = b.append(1);
  b = b.append(6);
  b = leb_u32(b, typeidx);
  return wsection(8, b);
}

// comp_canon_typed is the canon built-in an import of kind 3 or 4 lowers to:
// a resource.drop of resource type `typeop`, or a task.return of result
// valtype `typeop`.
function comp_canon_typed(kind: i32, typeop: i32): i32[] {
  if (kind == 3) {
    return comp_canon_resource_drop(typeop);
  }
  return comp_canon_task_return(typeop);
}

// export a component func at the top level under `name`.
function comp_export_one_func(name: string, funcidx: i32): i32[] {
  let b: i32[] = [1, 0];
  b = wname(b, name);
  b = b.append(1);
  b = leb_u32(b, funcidx);
  b = b.append(0);
  return wsection(11, b);
}

// suffix_group_find returns the index of `iface` in `order`, or -1.
function suffix_group_find(order: string[], iface: string): i32 {
  let i: i32 = 0;
  while (i < order.len()) {
    if (order[i] == iface) {
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

// component_suffix is the data-driven CLI-component suffix generator: a port
// of the native composer's gComposer.lower() Phases B-H + finish()'s cli/run
// tail (internal/wasm/component/compose_general.go). Given the program's
// preview-2 import list and the index state Phase A + the user core module
// leave behind, it regenerates the whole suffix from scratch.
//
// Imports are passed as parallel arrays (length = number of imports):
//   imp_iface     wasi:X interface the user module imports the func from
//   imp_name      method / func / [resource-drop] name
//   imp_kind      0 no-opt, 1 memory trampoline, 2 memory+realloc, 3 resource.drop,
//                 4 an async export's task.return
//   imp_inst      component-instance index of imp_iface (from Phase A)
//   imp_params    lowered core signature the trampoline mirrors (kinds 1/2)
//   imp_typeop    surfaced resource type index (kind 3); the result
//                 valtype, -1 for none (kind 4)
// n_type0 / n_inst0 are the component type / instance counts after Phase A;
// user_mod is the user core module index; core_export is the lifted entry.
// SuffixWired is the composed suffix up to (not including) its export tail:
// the sections so far and the index counters the tail continues from.
struct SuffixWired { o: i32[], n_cfunc: i32, n_corefunc: i32, n_inst: i32, user_inst: i32 }

// component_suffix_wired runs phases B..H of the suffix — the trampolines,
// lowerings, the user module's instantiation and its memory / realloc /
// table plumbing — leaving the export tail to the caller: component_suffix
// lifts a wasi:cli/run entry, component_suffix_http an incoming-handler.
function component_suffix_wired(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_results: i32[][], imp_typeop: i32[], n_inst0: i32, user_mod: i32): SuffixWired {
  let n: i32 = imp_iface.len();
  let o: i32[] = [];
  let none: i32[] = [];
  // per-import scratch (filled as the phases run).
  let tramp_mod: i32[] = [];
  let fixup_mod: i32[] = [];
  let tramp_inst: i32[] = [];
  let tbl: i32[] = [];
  let coref: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    tramp_mod = tramp_mod.append(0);
    fixup_mod = fixup_mod.append(0);
    tramp_inst = tramp_inst.append(0);
    tbl = tbl.append(0);
    coref = coref.append(0);
    i = i + 1;
  }
  let n_mod: i32 = user_mod + 1;
  let n_cfunc: i32 = 0;
  let n_corefunc: i32 = 0;
  let n_coreinst: i32 = 0;
  let n_coretab: i32 = 0;
  let n_inst: i32 = n_inst0;
  // Phase B: trampoline + table-fill cores per memory import.
  i = 0;
  while (i < n) {
    if (imp_kind[i] == 1 || imp_kind[i] == 2) {
      tramp_mod = tramp_mod.with(i, n_mod);
      n_mod = n_mod + 1;
      o = wcat(o, comp_core_module_section(shim_trampoline_core(imp_params[i], imp_results[i])));
      fixup_mod = fixup_mod.with(i, n_mod);
      n_mod = n_mod + 1;
      o = wcat(o, comp_core_module_section(shim_tablefill_core(imp_params[i], imp_results[i])));
    }
    i = i + 1;
  }
  // Phase C: instantiate the trampolines.
  i = 0;
  while (i < n) {
    if (imp_kind[i] == 1 || imp_kind[i] == 2) {
      tramp_inst = tramp_inst.with(i, n_coreinst);
      n_coreinst = n_coreinst + 1;
      o = wcat(o, comp_core_instance_instantiate(tramp_mod[i]));
    }
    i = i + 1;
  }
  // Phase D: no-opt lowers / resource.drops / mem placeholders, grouped by
  // import interface (first-occurrence order).
  let order: string[] = [];
  let group_names: string[][] = [];
  let group_idxs: i32[][] = [];
  i = 0;
  while (i < n) {
    let k: i32 = imp_kind[i];
    let idx: i32 = 0;
    if (k == 0) {
      o = wcat(o, comp_alias_inst_func(imp_inst[i], imp_name[i]));
      let cf: i32 = n_cfunc;
      n_cfunc = n_cfunc + 1;
      idx = n_corefunc;
      o = wcat(o, comp_canon_lower_noopts(cf));
      n_corefunc = n_corefunc + 1;
    } else if (k >= 3) {
      idx = n_corefunc;
      o = wcat(o, comp_canon_typed(k, imp_typeop[i]));
      n_corefunc = n_corefunc + 1;
    } else {
      idx = n_corefunc;
      o = wcat(o, comp_alias_core_func(tramp_inst[i], "0"));
      n_corefunc = n_corefunc + 1;
    }
    let gi: i32 = suffix_group_find(order, imp_iface[i]);
    if (gi < 0) {
      order = order.append(imp_iface[i]);
      group_names = group_names.append([imp_name[i]]);
      group_idxs = group_idxs.append([idx]);
    } else {
      group_names = group_names.with(gi, group_names[gi].append(imp_name[i]));
      group_idxs = group_idxs.with(gi, group_idxs[gi].append(idx));
    }
    i = i + 1;
  }
  // package each interface's lowered funcs into a core instance.
  let arg_insts: i32[] = [];
  let g: i32 = 0;
  while (g < order.len()) {
    let gn: string[] = group_names[g];
    let gx: i32[] = group_idxs[g];
    let sorts: i32[] = [];
    let s: i32 = 0;
    while (s < gn.len()) {
      sorts = sorts.append(0);
      s = s + 1;
    }
    o = wcat(o, comp_core_instance_from_exports(gn, sorts, gx));
    arg_insts = arg_insts.append(n_coreinst);
    n_coreinst = n_coreinst + 1;
    g = g + 1;
  }
  // Phase E: instantiate the user module with the per-interface args.
  let user_inst: i32 = n_coreinst;
  o = wcat(o, comp_core_instance_instantiate_args(user_mod, order, arg_insts));
  n_coreinst = n_coreinst + 1;
  // Phase F: memory + realloc + trampoline tables.
  let need_mem: boolean = false;
  let need_realloc: boolean = false;
  i = 0;
  while (i < n) {
    if (imp_kind[i] == 1) {
      need_mem = true;
    }
    if (imp_kind[i] == 2) {
      need_mem = true;
      need_realloc = true;
    }
    i = i + 1;
  }
  if (need_mem) {
    o = wcat(o, comp_alias_core_export(2, user_inst, "memory"));
  }
  let realloc_f: i32 = 0;
  if (need_realloc) {
    realloc_f = n_corefunc;
    o = wcat(o, comp_alias_core_export(0, user_inst, "cabi_realloc"));
    n_corefunc = n_corefunc + 1;
  }
  i = 0;
  while (i < n) {
    if (imp_kind[i] == 1 || imp_kind[i] == 2) {
      tbl = tbl.with(i, n_coretab);
      n_coretab = n_coretab + 1;
      o = wcat(o, comp_alias_core_export(1, tramp_inst[i], "$imports"));
    }
    i = i + 1;
  }
  // Phase G: memory lowers.
  i = 0;
  while (i < n) {
    if (imp_kind[i] == 1) {
      o = wcat(o, comp_alias_inst_func(imp_inst[i], imp_name[i]));
      let cfg: i32 = n_cfunc;
      n_cfunc = n_cfunc + 1;
      coref = coref.with(i, n_corefunc);
      o = wcat(o, comp_canon_lower_mem(cfg, 0));
      n_corefunc = n_corefunc + 1;
    } else if (imp_kind[i] == 2) {
      o = wcat(o, comp_alias_inst_func(imp_inst[i], imp_name[i]));
      let cfr: i32 = n_cfunc;
      n_cfunc = n_cfunc + 1;
      coref = coref.with(i, n_corefunc);
      o = wcat(o, comp_canon_lower_mem_realloc(cfr, 0, realloc_f));
      n_corefunc = n_corefunc + 1;
    }
    i = i + 1;
  }
  // Phase H: fill each trampoline table with its lowered func, instantiate fixup.
  i = 0;
  while (i < n) {
    if (imp_kind[i] == 1 || imp_kind[i] == 2) {
      let arg: i32 = n_coreinst;
      o = wcat(o, comp_core_instance_from_exports(["$imports", "0"], [1, 0], [tbl[i], coref[i]]));
      n_coreinst = n_coreinst + 1;
      o = wcat(o, comp_core_instance_instantiate_args(fixup_mod[i], [""], [arg]));
      n_coreinst = n_coreinst + 1;
    }
    i = i + 1;
  }
  return SuffixWired { o: o, n_cfunc: n_cfunc, n_corefunc: n_corefunc, n_inst: n_inst, user_inst: user_inst };
}

// component_suffix wires the imports and lifts `core_export` (the user
// module's `() -> i32` run entry) as wasi:cli/run.
pub function component_suffix(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_results: i32[][], imp_typeop: i32[], n_type0: i32, n_inst0: i32, user_mod: i32, core_export: string, lifts: AsyncLift[]): i32[] {
  let w: SuffixWired = component_suffix_wired(imp_iface, imp_name, imp_kind, imp_inst, imp_params, imp_results, imp_typeop, n_inst0, user_mod);
  let o: i32[] = w.o;
  let run_core_f: i32 = w.n_corefunc;
  o = wcat(o, comp_alias_core_func(w.user_inst, core_export));
  o = wcat(o, comp_type_result_unit(n_type0));
  let lifted: i32 = w.n_cfunc;
  o = wcat(o, comp_canon_lift_noopts(run_core_f, n_type0 + 1));
  let run_inst: i32 = w.n_inst;
  o = wcat(o, comp_instance_one_func("run", lifted));
  o = wcat(o, comp_export_one_instance("wasi:cli/run@0.2.0", run_inst));
  // Each async export: alias its core entry, give it an async func type, lift
  // it with the async option and export it. The export is itself a new
  // component func, so each lift takes two func indices.
  let i: i32 = 0;
  while (i < lifts.len()) {
    o = wcat(o, comp_alias_core_func(w.user_inst, "[async-lift]" + lifts[i].core_name));
    o = wcat(o, comp_type_async_func(lifts[i]));
    o = wcat(o, comp_canon_lift_async(run_core_f + 1 + i, n_type0 + 2 + i));
    o = wcat(o, comp_export_one_func(lifts[i].name, lifted + 1 + 2 * i));
    i = i + 1;
  }
  return o;
}

// component_suffix_http wires the imports and lifts the user module's core
// export `wasi:http/incoming-handler@0.2.0#handle` — core signature
// (i32, i32) -> (), the two owned resource handles — as the interface's
// `handle: func(request: own<incoming-request>, response-out:
// own<response-outparam>)`, exported as wasi:http/incoming-handler@0.2.0.
// req_t / out_t are the component type indices of the two resources,
// surfaced from the imported wasi:http/types instance ahead of the suffix
// (comp_alias_inst_type); the own<> wrappers and the func type are types
// n_type0 .. n_type0 + 2.
pub function component_suffix_http(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_results: i32[][], imp_typeop: i32[], n_type0: i32, n_inst0: i32, user_mod: i32, req_t: i32, out_t: i32): i32[] {
  let w: SuffixWired = component_suffix_wired(imp_iface, imp_name, imp_kind, imp_inst, imp_params, imp_results, imp_typeop, n_inst0, user_mod);
  let o: i32[] = w.o;
  let handle_core_f: i32 = w.n_corefunc;
  o = wcat(o, comp_alias_core_func(w.user_inst, "wasi:http/incoming-handler@0.2.0#handle"));
  o = wcat(o, comp_type_own(req_t));
  o = wcat(o, comp_type_own(out_t));
  o = wcat(o, comp_type_handle_func(n_type0, n_type0 + 1));
  let lifted: i32 = w.n_cfunc;
  o = wcat(o, comp_canon_lift_noopts(handle_core_f, n_type0 + 2));
  let handler_inst: i32 = w.n_inst;
  o = wcat(o, comp_instance_one_func("handle", lifted));
  return wcat(o, comp_export_one_instance("wasi:http/incoming-handler@0.2.0", handler_inst));
}

// no_results is the result list of `n` imports that all return through a
// return area: the framed shapes' WASI imports.
function no_results(n: i32): i32[][] {
  let out: i32[][] = [];
  let none: i32[] = [];
  let i: i32 = 0;
  while (i < n) {
    out = out.append(none);
    i = i + 1;
  }
  return out;
}

// component_suffix_io is component_suffix for a CLI shape whose core can
// drop a failed stream call's wasi:io/error (type 1 in the fixed prefixes).
// The drop is lowered right after the last wasi:io/streams entry, where
// native's composer puts it.
function component_suffix_io(imp_iface: string[], imp_name: string[], imp_kind: i32[], imp_inst: i32[], imp_params: i32[][], imp_typeop: i32[], n_type0: i32, n_inst0: i32, user_mod: i32, core_export: string): i32[] {
  let at: i32 = 0;
  let i: i32 = 0;
  while (i < imp_iface.len()) {
    if (imp_iface[i] == "wasi:io/streams@0.2.0") {
      at = i + 1;
    }
    i = i + 1;
  }
  let none: i32[] = [];
  let iface: string[] = [];
  let name: string[] = [];
  let kind: i32[] = [];
  let inst: i32[] = [];
  let params: i32[][] = [];
  let res: i32[] = [];
  i = 0;
  while (i <= imp_iface.len()) {
    if (i == at) {
      iface = iface.append("wasi:io/error@0.2.0");
      name = name.append("[resource-drop]error");
      kind = kind.append(3);
      inst = inst.append(0);
      params = params.append(none);
      res = res.append(1);
    }
    if (i < imp_iface.len()) {
      iface = iface.append(imp_iface[i]);
      name = name.append(imp_name[i]);
      kind = kind.append(imp_kind[i]);
      inst = inst.append(imp_inst[i]);
      params = params.append(imp_params[i]);
      res = res.append(imp_typeop[i]);
    }
    i = i + 1;
  }
  return component_suffix(iface, name, kind, inst, params, no_results(params.len()), res, n_type0, n_inst0, user_mod, core_export, []);
}

// blocking_write_name / write_sig: the one memory import every write-shape
// shares (output-stream.blocking-write-and-flush, lowered (i32 i32 i32 i32)).
function blocking_write_name(): string {
  return "[method]output-stream.blocking-write-and-flush";
}

// component_suffix_stdout: write-to-stdout. Imports [blocking-write-and-flush
// (mem, streams=1), get-stdout (no-opt, cli/stdout=2)]; Phase A leaves
// component types=5, instances=3.
function component_suffix_stdout(): i32[] {
  let none: i32[] = [];
  return component_suffix_io(
    ["wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0"],
    [blocking_write_name(), "get-stdout"],
    [1, 0],
    [1, 2],
    [[127, 127, 127, 127], none],
    [0, 0],
    5, 3, 0, "_lang_run",
  );
}

// component_suffix_eprint: stdout + an extra get-stderr no-opt import.
// Phase A leaves component types=6, instances=4.
function component_suffix_eprint(): i32[] {
  let none: i32[] = [];
  return component_suffix_io(
    ["wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0", "wasi:cli/stderr@0.2.0"],
    [blocking_write_name(), "get-stdout", "get-stderr"],
    [1, 0, 0],
    [1, 2, 3],
    [[127, 127, 127, 127], none, none],
    [0, 0, 0],
    6, 4, 0, "_lang_run",
  );
}

// component_suffix_exit: stdout + an extra exit no-opt import (cli/exit).
// Phase A leaves component types=6, instances=4.
function component_suffix_exit(): i32[] {
  let none: i32[] = [];
  return component_suffix_io(
    ["wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0", "wasi:cli/exit@0.2.0"],
    [blocking_write_name(), "get-stdout", "exit"],
    [1, 0, 0],
    [1, 2, 3],
    [[127, 127, 127, 127], none, none],
    [0, 0, 0],
    6, 4, 0, "_lang_run",
  );
}

// component_suffix_fs_read: read_file + stdout. Imports (in canonical order)
// get-directories (mem+realloc, preopens=3), descriptor.open-at (mem,
// fstypes=2), descriptor.read-via-stream (mem, fstypes=2),
// [resource-drop]descriptor (drop, fstypes=2, resource type 6),
// output-stream.blocking-write-and-flush (mem, streams=1),
// input-stream.blocking-read (mem+realloc, streams=1),
// [resource-drop]input-stream (drop, streams=1, resource type 4), get-stdout
// (no-opt, stdout=4). Exercises the engine's interface grouping (fstypes +
// streams each carry two methods and a drop) and the realloc path. A drop
// closes its interface's group, which is where the composer puts it. Phase A
// leaves component types=9, instances=5.
function component_suffix_fs_read(): i32[] {
  let none: i32[] = [];
  return component_suffix_io(
    ["wasi:filesystem/preopens@0.2.0", "wasi:filesystem/types@0.2.0", "wasi:filesystem/types@0.2.0", "wasi:filesystem/types@0.2.0", "wasi:io/streams@0.2.0", "wasi:io/streams@0.2.0", "wasi:io/streams@0.2.0", "wasi:cli/stdout@0.2.0"],
    ["get-directories", "[method]descriptor.open-at", "[method]descriptor.read-via-stream", "[resource-drop]descriptor", blocking_write_name(), "[method]input-stream.blocking-read", "[resource-drop]input-stream", "get-stdout"],
    [2, 1, 1, 3, 1, 2, 3, 0],
    [3, 2, 2, 2, 1, 1, 1, 4],
    [[127], [127, 127, 127, 127, 127, 127, 127], [127, 126, 127], none, [127, 127, 127, 127], [127, 126, 127], none, none],
    [0, 0, 0, 6, 0, 0, 4, 0],
    9, 5, 0, "_lang_run",
  );
}

