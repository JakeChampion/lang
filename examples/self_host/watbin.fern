// Composed fs prefixes (preamble + io/error + io/streams + fs tail), replacing
// the former io_fs_*_prefix blobs.
function io_fs_read_head(): i32[] {
    var o: i32[] = component_preamble();
    o = wcat(o, blob_to_bytes(tb_io_error()));
    o = wcat(o, blob_to_bytes(tb_io_streams_inout()));
    return wcat(o, blob_to_bytes(fs_read_tail()));
}
function io_fs_rw_head(): i32[] {
    var o: i32[] = component_preamble();
    o = wcat(o, blob_to_bytes(tb_io_error()));
    o = wcat(o, blob_to_bytes(tb_io_streams_inout()));
    return wcat(o, blob_to_bytes(fs_rw_tail()));
}
function io_fs_write_head(): i32[] {
    var o: i32[] = component_preamble();
    o = wcat(o, blob_to_bytes(tb_io_error()));
    o = wcat(o, blob_to_bytes(tb_io_streams_out()));
    return wcat(o, blob_to_bytes(fs_write_tail()));
}

