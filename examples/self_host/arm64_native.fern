    var word: i64 = 0x0e000800 | (((size & 3) as i64) << 22) | (((rm & 31) as i64) << 16)
        | (((opc & 7) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (q) { word = word | 0x40000000; }
