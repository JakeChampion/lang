// END GENERATED ARM64 VCMPZERO_ENTRY TABLE

// BEGIN GENERATED ARM64 V2MISC_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
// Two-register unary integer ops. mvn is an alias of not.
function arm64_v2misc_entry(mnem: string): i32 {
    if (mnem == "neg") { return arm64_vec_entry(true, 11, 15); }
    if (mnem == "abs") { return arm64_vec_entry(false, 11, 15); }
    if (mnem == "not") { return arm64_vec_entry(true, 5, 1); }
    if (mnem == "mvn") { return arm64_vec_entry(true, 5, 1); }
    if (mnem == "cnt") { return arm64_vec_entry(false, 5, 1); }
