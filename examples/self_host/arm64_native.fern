    match (mnem) {
        "addv" => { return arm64_vec_entry(false, 27, 0); },
        "smaxv" => { return arm64_vec_entry(false, 10, 0); },
        "sminv" => { return arm64_vec_entry(false, 26, 0); },
        "umaxv" => { return arm64_vec_entry(true, 10, 0); },
        "uminv" => { return arm64_vec_entry(true, 26, 0); },
        "saddlv" => { return arm64_vec_entry(false, 3, 1); },
