// arm64_gas_is_fixed: no operands.
function arm64_gas_is_fixed(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_fixed(); }
// arm64_gas_is_sys: an imm16 exception class.
function arm64_gas_is_sys(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_sys(); }
// arm64_gas_is_indirect: branch to a register.
function arm64_gas_is_indirect(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_indirect(); }
// arm64_gas_is_branch: a label.
function arm64_gas_is_branch(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_branch(); }
// arm64_gas_is_cbranch: compare a register against zero and branch.
function arm64_gas_is_cbranch(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_cbranch(); }
// arm64_gas_is_tbranch: test a bit and branch.
function arm64_gas_is_tbranch(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_tbranch(); }
// arm64_gas_is_movwide: mov and the move-wide trio.
function arm64_gas_is_movwide(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_movwide(); }
// arm64_gas_is_symaddr: PC-relative address of a symbol.
function arm64_gas_is_symaddr(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_symaddr(); }
// arm64_gas_is_addsub: add/sub in every operand class, and the cmp/cmn aliases.
function arm64_gas_is_addsub(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_addsub(); }
// arm64_gas_is_neg: sub from the zero register.
function arm64_gas_is_neg(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_neg(); }
// arm64_gas_is_logical3: the logical ops with an immediate form.
function arm64_gas_is_logical3(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_logical3(); }
// arm64_gas_is_logical2: flag-setting and negated logicals, with the tst/mvn aliases.
function arm64_gas_is_logical2(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_logical2(); }
// arm64_logical2_base maps a mnemonic to its base word (every register field zero); -1 = not one.
function arm64_logical2_base(mnem: string): i64 {
    match (mnem) {
        "ands" => { return 0xea000000; },
        "bic" => { return 0x8a200000; },
        "bics" => { return 0xea200000; },
        "orn" => { return 0xaa200000; },
        "eon" => { return 0xca200000; },
        "tst" => { return 0xea000000; },
        "mvn" => { return 0xaa200000; },
        _ => { return 0 - 1; }
    }
}
// arm64_gas_is_carry: add/sub with carry; ngc/ngcs are the Rn=XZR aliases.
function arm64_gas_is_carry(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_carry(); }
// arm64_carry_base maps a mnemonic to its base word (every register field zero); -1 = not one.
function arm64_carry_base(mnem: string): i64 {
    match (mnem) {
        "adc" => { return 0x9a000000; },
        "adcs" => { return 0xba000000; },
        "sbc" => { return 0xda000000; },
        "sbcs" => { return 0xfa000000; },
        "ngc" => { return 0xda000000; },
        "ngcs" => { return 0xfa000000; },
        _ => { return 0 - 1; }
    }
}
// arm64_gas_is_mulwide: the high-half and widening multiplies, and madd.
function arm64_gas_is_mulwide(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_mulwide(); }
// arm64_mulwide_base maps a mnemonic to its base word (every register field zero); -1 = not one.
function arm64_mulwide_base(mnem: string): i64 {
    match (mnem) {
        "umulh" => { return 0x9bc07c00; },
        "smulh" => { return 0x9b407c00; },
        "madd" => { return 0x9b000000; },
        "smull" => { return 0x9b200000; },
        "umull" => { return 0x9ba00000; },
        "smaddl" => { return 0x9b200000; },
        "umaddl" => { return 0x9ba00000; },
        "smsubl" => { return 0x9b208000; },
        "umsubl" => { return 0x9ba08000; },
        _ => { return 0 - 1; }
    }
}
// arm64_gas_is_muldiv: mul, the divides, and msub.
function arm64_gas_is_muldiv(mnem: string): boolean { return arm64_gas_family(mnem) == arm64_fam_muldiv(); }
