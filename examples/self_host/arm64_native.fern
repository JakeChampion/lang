function arm64_gas_scalar_reg(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    if (t.len() < 2) { return 0 - 1; }
    var n: i32 = 0;
    var i: i32 = 1;
    while (i < t.len()) {
        var c: i32 = t[i] as i32;
        if (c < 48 || c > 57) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if (n > 31) { return 0 - 1; }
    return n;
