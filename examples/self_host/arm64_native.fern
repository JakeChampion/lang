// examples/self_host/arm64_native.fern — the arm64-darwin native-binary
// backend as a single module: the AArch64 machine-code encoder + named-
// label assembler (was arm64_encode.fern), the GAS-text assembler + data/
// symbol relocation (was arm64_gas.fern), and the ad-hoc-signed Mach-O
// writer + SHA-256 (was macho.fern). Merged into one module so the unified
// fern CLI can `import "./arm64_native"` and drive emit -> assemble ->
// Mach-O without cross-module bare references. The pieces stay logically
// separable; the section banners below mark the former file boundaries.

// ============================================================
// PART 1 — AArch64 encoder + named-label assembler
// ============================================================

// examples/self_host/arm64_encode.fern — a self-hosted AArch64 (arm64)
// machine-code encoder: one function per instruction form, each appending
// the 4-byte fixed-width little-endian encoding to an `i32[]` byte buffer.
// It is the arm64 counterpart of x86_native.fern PART 1 and the assembler half of
// the arm64-darwin native-binary path (the container half is macho.fern),
// mirroring the Go reference internal/native/arm64/arm64.go.
//
// AArch64 instructions are all exactly 32 bits, little-endian. Each
// encoder is pinned byte-for-byte against the Go reference (itself pinned
// against `llvm-mc -triple=aarch64 --show-encoding`). This is a tiny
// starting subset — enough to assemble an `exit(N)` program end-to-end
// (MOVZ + SVC) and small integer arithmetic — so the Mach-O writer and the
// encode -> wrap -> run pipeline can be proven before the full instruction
// surface lands.
//
// Conventions (matching x86_native.fern / elf.fern):
//   * A byte buffer is an `i32[]` of values in 0..255; each encoder appends
//     to it and returns the (possibly grown) buffer (`buf = f(buf, …)`).
//   * Instruction *word* helpers (`arm64_*_word`) return the 32-bit
//     encoding in an i64 (so the 0xD2…/0xF2…/0xAA… bases stay positive);
//     the append wrappers thread the byte buffer.
//   * This module is import-free so the native emitter can `import
//     "./arm64_encode"` and the unit test can concatenate it with a driver.

// ---- register name helpers (5-bit register numbers) ----
function arm64_x0(): i32 { return 0; }
function arm64_x1(): i32 { return 1; }
function arm64_x2(): i32 { return 2; }
function arm64_x16(): i32 { return 16; }
function arm64_lr(): i32 { return 30; } // x30, the link register
function arm64_xzr(): i32 { return 31; }

// ---- byte emitter ----

// arm64_le32 appends a 32-bit instruction word (held in an i64),
// little-endian.
function arm64_le32(buf: i32[], v: i64): i32[] {
    buf = buf.append((v & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 24) & 255) as i32);
    return buf;
}

// ---- move-wide family ----

// arm64_movz_word encodes `movz Xd, #imm16, lsl #shift` (move-wide-zero):
// load imm16 into the given 16-bit slot of Xd, zeroing the rest. shift
// must be one of 0, 16, 32, 48.
//   sf=1 opc=10 100101 hw(2) imm16(16) Rd(5) -> 0xD2800000 | hw<<21 | imm16<<5 | Rd
function arm64_movz_word(rd: i32, imm16: i32, shift: i32): i64 {
    var hw: i64 = ((shift / 16) & 3) as i64;
    return 0xd2800000 | (hw << 21) | (((imm16 & 0xffff) as i64) << 5) | ((rd & 31) as i64);
}

// arm64_movk_word encodes `movk Xd, #imm16, lsl #shift` (move-wide-keep):
// write imm16 into one 16-bit slot of Xd, leaving the rest unchanged.
//   sf=1 opc=11 -> base 0xF2800000.
function arm64_movk_word(rd: i32, imm16: i32, shift: i32): i64 {
    var hw: i64 = ((shift / 16) & 3) as i64;
    return 0xf2800000 | (hw << 21) | (((imm16 & 0xffff) as i64) << 5) | ((rd & 31) as i64);
}

// arm64_movn_word encodes `movn Xd, #imm16, lsl #shift` (move-wide-not):
// load the bitwise complement of (imm16 << shift) into Xd.
//   sf=1 opc=00 -> base 0x92800000.
function arm64_movn_word(rd: i32, imm16: i32, shift: i32): i64 {
    var hw: i64 = ((shift / 16) & 3) as i64;
    return 0x92800000 | (hw << 21) | (((imm16 & 0xffff) as i64) << 5) | ((rd & 31) as i64);
}

// The `w` flag selects the 32-bit form. AArch64 encodes operand width in the
// instruction, not the register name, and arm64_gas_reg deliberately maps w0 and
// x0 to the same number — so every site that can see a `w` operand must pass the
// flag or the assembler silently widens the operation (#6054).
function arm64_movz(buf: i32[], rd: i32, imm16: i32, shift: i32, w: boolean): i32[] {
    var word: i64 = arm64_movz_word(rd, imm16, shift);
    if (w) { word = word & 0x7fffffff; }   // sf=0: 0xd2800000 -> 0x52800000
    return arm64_le32(buf, word);
}
function arm64_movk(buf: i32[], rd: i32, imm16: i32, shift: i32): i32[] {
    return arm64_le32(buf, arm64_movk_word(rd, imm16, shift));
}
// `w` clears sf: 0x92800000 -> 0x12800000. Verified vs clang:
// mov x0,#-100 = 0x92800c60 (movn x0,#99), mov w0,#-100 = 0x12800c60,
// mov x1,#-1 = 0x92800001 (movn x1,#0).
function arm64_movn(buf: i32[], rd: i32, imm16: i32, shift: i32, w: boolean): i32[] {
    var word: i64 = arm64_movn_word(rd, imm16, shift);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}

// ---- add / sub (immediate) ----

// arm64_addimm_word encodes `add Xd, Xn, #imm12` (64-bit, no lsl #12).
//   sf=1 op=0 S=0 100010 sh=0 imm12 Rn Rd -> 0x91000000 | imm12<<10 | Rn<<5 | Rd
function arm64_addimm_word(rd: i32, rn: i32, imm12: i32): i64 {
    return 0x91000000 | (((imm12 & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
}

// arm64_subimm_word encodes `sub Xd, Xn, #imm12` (64-bit) — base 0xD1000000.
function arm64_subimm_word(rd: i32, rn: i32, imm12: i32): i64 {
    return 0xd1000000 | (((imm12 & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
}

// `w` clears sf: add 0x91000000 -> 0x11000000, sub 0xd1000000 -> 0x51000000.
function arm64_addimm(buf: i32[], rd: i32, rn: i32, imm12: i32, w: boolean): i32[] {
    var word: i64 = arm64_addimm_word(rd, rn, imm12);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}
function arm64_subimm(buf: i32[], rd: i32, rn: i32, imm12: i32, w: boolean): i32[] {
    var word: i64 = arm64_subimm_word(rd, rn, imm12);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}

// ---- add / sub / mov (register) ----

// SP is not addressable as Rn in the shifted-register form — there Rn=31 means
// XZR — so `add x0, sp, x0` assembled as a shifted-register add computes
// `x0 = 0 + x0` and silently DROPS THE STACK BASE (#6060). GAS uses the
// extended-register form (option=011 UXTX, imm3=0) when an operand is SP.
// Verified vs clang: add x0,sp,x0 = 0x8b2063e0, add x3,sp,x4 = 0x8b2463e3,
// sub x0,sp,x1 = 0xcb2163e0.
function arm64_addsub_ext_word(is_sub: boolean, rd: i32, rn: i32, rm: i32, option: i32, amount: i32): i64 {
    var base: i64 = 0x8b200000;
    if (is_sub) { base = 0xcb200000; }
    return base | (((rm & 31) as i64) << 16) | (((option & 7) as i64) << 13)
        | (((amount & 7) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
}
function arm64_addsub_ext(buf: i32[], is_sub: boolean, rd: i32, rn: i32, rm: i32, option: i32, amount: i32): i32[] {
    return arm64_le32(buf, arm64_addsub_ext_word(is_sub, rd, rn, rm, option, amount));
}
function arm64_addsub_ext_sp_word(is_sub: boolean, rd: i32, rn: i32, rm: i32): i64 {
    return arm64_addsub_ext_word(is_sub, rd, rn, rm, 3, 0);   // UXTX, no shift
}
function arm64_addsub_ext_sp(buf: i32[], is_sub: boolean, rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, arm64_addsub_ext_sp_word(is_sub, rd, rn, rm));
}

// arm64_addsubreg_shift_word encodes `add/sub Xd, Xn, Xm, <shift> #amount`:
// shift type in bits 23:22 (0=LSL, 1=LSR, 2=ASR) and the 6-bit amount in
// bits 15:10. The backend scales an array index by its element size with
// `add Xd, Xn, Xm, lsl #N`, so dropping the shift corrupts every element
// past [0] (verified vs llvm-mc: add x0,x1,x0,lsl #2 = 0x8b000820,
// sub x3,x4,x5,lsl #3 = 0xcb050c83).
function arm64_addsubreg_shift_word(is_sub: boolean, rd: i32, rn: i32, rm: i32, st: i32, amount: i32): i64 {
    var base: i64 = 0x8b000000;
    if (is_sub) { base = 0xcb000000; }
    return base | (((st & 3) as i64) << 22) | (((rm & 31) as i64) << 16)
        | (((amount & 63) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
}
function arm64_addsubreg_shift(buf: i32[], is_sub: boolean, rd: i32, rn: i32, rm: i32, st: i32, amount: i32, w: boolean): i32[] {
    var word: i64 = arm64_addsubreg_shift_word(is_sub, rd, rn, rm, st, amount);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}

// arm64_addreg_word encodes `add Xd, Xn, Xm` (shifted-register, zero shift).
//   sf=1 op=0 S=0 01011 -> 0x8B000000 | Rm<<16 | Rn<<5 | Rd
function arm64_addreg_word(rd: i32, rn: i32, rm: i32): i64 {
    return 0x8b000000 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
}

// arm64_subreg_word encodes `sub Xd, Xn, Xm` -> base 0xCB000000.
function arm64_subreg_word(rd: i32, rn: i32, rm: i32): i64 {
    return 0xcb000000 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
}

// arm64_movreg_word encodes `mov Xd, Xm` — AArch64 spells it
// `orr Xd, XZR, Xm` -> 0xAA000000 | Rm<<16 | 31<<5 | Rd.
function arm64_movreg_word(rd: i32, rm: i32): i64 {
    return 0xaa000000 | (((rm & 31) as i64) << 16) | (31 << 5) | ((rd & 31) as i64);
}

function arm64_addreg(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, arm64_addreg_word(rd, rn, rm));
}
function arm64_subreg(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, arm64_subreg_word(rd, rn, rm));
}
function arm64_movreg(buf: i32[], rd: i32, rm: i32, w: boolean): i32[] {
    var word: i64 = arm64_movreg_word(rd, rm);
    if (w) { word = word & 0x7fffffff; }   // orr 0xaa.. -> 0x2a..
    return arm64_le32(buf, word);
}

// ---- system / control ----

// arm64_svc_word encodes `svc #imm16` -> 0xD4000001 | imm16<<5.
// The Darwin syscall trap is `svc #0x80`.
function arm64_svc_word(imm16: i32): i64 {
    return 0xd4000001 | (((imm16 & 0xffff) as i64) << 5);
}

// arm64_ret_word encodes `ret Xn` (default x30) -> 0xD65F0000 | Rn<<5.
function arm64_ret_word(rn: i32): i64 {
    return 0xd65f0000 | (((rn & 31) as i64) << 5);
}

function arm64_svc(buf: i32[], imm16: i32): i32[] {
    return arm64_le32(buf, arm64_svc_word(imm16));
}
function arm64_ret(buf: i32[], rn: i32): i32[] {
    return arm64_le32(buf, arm64_ret_word(rn));
}

// arm64_blr_word encodes `blr Xn` (branch-with-link to register — the
// indirect call a closure / function-pointer call lowers to) ->
// 0xD63F0000 | Rn<<5.
function arm64_blr_word(rn: i32): i64 {
    return 0xd63f0000 | (((rn & 31) as i64) << 5);
}
function arm64_blr(buf: i32[], rn: i32): i32[] {
    return arm64_le32(buf, arm64_blr_word(rn));
}

// ---- compare (subs to XZR) ----

// arm64_cmpreg_word encodes `cmp Xn, Xm` — AArch64 spells it
// `subs XZR, Xn, Xm` (shifted-register, zero shift) -> sets NZCV.
//   0xEB000000 | Rm<<16 | Rn<<5 | 31
function arm64_cmpreg_word(rn: i32, rm: i32): i64 {
    return 0xeb000000 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | 31;
}

// arm64_cmpimm_word encodes `cmp Xn, #imm12` — `subs XZR, Xn, #imm12`.
//   0xF1000000 | imm12<<10 | Rn<<5 | 31
function arm64_cmpimm_word(rn: i32, imm12: i32): i64 {
    return 0xf1000000 | (((imm12 & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | 31;
}

// `w` clears sf: cmp-reg 0xeb.. -> 0x6b.., cmp-imm 0xf1.. -> 0x71... A 64-bit
// compare of a value produced by 32-bit arithmetic reads the neighbouring bytes
// as part of the operand, which is why this matters even when the low half is
// correct (#6054).
function arm64_cmpreg(buf: i32[], rn: i32, rm: i32, w: boolean): i32[] {
    var word: i64 = arm64_cmpreg_word(rn, rm);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}
function arm64_cmpimm(buf: i32[], rn: i32, imm12: i32, w: boolean): i32[] {
    var word: i64 = arm64_cmpimm_word(rn, imm12);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}

// ---- condition codes (the 4-bit cond field of B.cond) ----
function arm64_eq(): i32 { return 0; }   // ==
function arm64_ne(): i32 { return 1; }   // !=
function arm64_ge(): i32 { return 10; }  // >= (signed)
function arm64_lt(): i32 { return 11; }  // <  (signed)
function arm64_gt(): i32 { return 12; }  // >  (signed)
function arm64_le(): i32 { return 13; }  // <= (signed)

// ---- branches ----
//
// Branch targets are PC-relative byte deltas (target - branch_site),
// always a multiple of 4; the encoders divide by 4 to form the immediate.
// A *backward* branch (the bottom of a loop) knows its target offset when
// it is emitted, so the byte delta is `target_off - buf.len()`; forward
// branches await the label/fixup pass (a later slice).

// arm64_b_word encodes `b <rel>` -> 0x14000000 | imm26, imm26 = rel/4
// as a signed 26-bit field.
function arm64_b_word(rel: i32): i64 {
    return 0x14000000 | (((rel >> 2) & 0x3ffffff) as i64);
}

// arm64_bcond_word encodes `b.<cond> <rel>` -> 0x54000000 | imm19<<5 |
// cond, imm19 = rel/4 as a signed 19-bit field.
function arm64_bcond_word(cond: i32, rel: i32): i64 {
    return 0x54000000 | ((((rel >> 2) & 0x7ffff) as i64) << 5) | ((cond & 15) as i64);
}

// arm64_cbz_word / arm64_cbnz_word encode `cbz/cbnz Xt, <rel>` (compare
// the register against zero and branch) -> 0xB4000000 / 0xB5000000 |
// imm19<<5 | Rt. No flags needed (they test the register directly).
function arm64_cbz_word(rt: i32, rel: i32): i64 {
    return 0xb4000000 | ((((rel >> 2) & 0x7ffff) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_cbnz_word(rt: i32, rel: i32): i64 {
    return 0xb5000000 | ((((rel >> 2) & 0x7ffff) as i64) << 5) | ((rt & 31) as i64);
}

function arm64_b(buf: i32[], rel: i32): i32[] {
    return arm64_le32(buf, arm64_b_word(rel));
}
function arm64_bcond(buf: i32[], cond: i32, rel: i32): i32[] {
    return arm64_le32(buf, arm64_bcond_word(cond, rel));
}
// `w` clears sf: cbz 0xb4.. -> 0x34.., cbnz 0xb5.. -> 0x35... The 64-bit form
// tests all 64 bits, so a `cbz w0` assembled as `cbz x0` takes the branch on a
// different condition whenever the upper half is dirty.
function arm64_cbz(buf: i32[], rt: i32, rel: i32, w: boolean): i32[] {
    var word: i64 = arm64_cbz_word(rt, rel);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}
function arm64_cbnz(buf: i32[], rt: i32, rel: i32, w: boolean): i32[] {
    var word: i64 = arm64_cbnz_word(rt, rel);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}

// ---- forward references (placeholder + patch) ----
//
// A forward branch is emitted with a zero displacement (a placeholder),
// its byte offset recorded; once the target label's offset is known, the
// immediate field is spliced in with a patch helper. Unlike the backward
// case there is no label table yet — the driver tracks the one offset it
// needs. arm64 branch displacements are relative to the branch instruction
// itself, so the byte delta is simply `target_off - branch_off`.

// arm64_rel returns the PC-relative byte delta from a branch at branch_off
// to target_off.
function arm64_rel(target_off: i32, branch_off: i32): i32 {
    return target_off - branch_off;
}

// arm64_read_word reads the little-endian 32-bit instruction word at byte
// offset `at` (held in an i64 so the top bit stays positive).
function arm64_read_word(buf: i32[], at: i32): i64 {
    return (buf[at] as i64)
        | ((buf[at + 1] as i64) << 8)
        | ((buf[at + 2] as i64) << 16)
        | ((buf[at + 3] as i64) << 24);
}

// arm64_write_word overwrites the 4 little-endian bytes of the instruction
// word at byte offset `at`.
//
// `own buf` is what makes the patch path linear rather than O(code_len^2).
// A BORROWED array parameter forces every `.with` down the copy-on-write
// path — the callee cannot know the caller has no other reader — so each
// patched word cloned the whole .text buffer. Consuming the buffer lets the
// rc check see a unique owner and overwrite in place. The whole patch family
// below threads it the same way, and so must every caller: an owned argument
// has to be a fresh value, another `own` parameter, or a self-reassign
// `code = arm64_patch_x(code, …)` (E051).
function arm64_write_word(own buf: i32[], at: i32, w: i64): i32[] {
    buf = buf.with(at, (w & 255) as i32);
    buf = buf.with(at + 1, ((w >> 8) & 255) as i32);
    buf = buf.with(at + 2, ((w >> 16) & 255) as i32);
    buf = buf.with(at + 3, ((w >> 24) & 255) as i32);
    return buf;
}

// arm64_patch_b splices a rel into the imm26 field of a `b` placeholder at
// byte offset `at`, preserving the top 6 opcode bits.
function arm64_patch_b(own buf: i32[], at: i32, rel: i32): i32[] {
    var w: i64 = (arm64_read_word(buf, at) & 0xfc000000) | (((rel >> 2) & 0x3ffffff) as i64);
    return arm64_write_word(buf, at, w);
}

// arm64_patch_b19 splices a rel into the imm19 field (bits 23:5) of a
// `b.cond` / `cbz` / `cbnz` placeholder at byte offset `at`, preserving
// the opcode plus the cond/Rt bits (the masked-out 0xff00001f).
function arm64_patch_b19(own buf: i32[], at: i32, rel: i32): i32[] {
    var w: i64 = (arm64_read_word(buf, at) & 0xff00001f) | ((((rel >> 2) & 0x7ffff) as i64) << 5);
    return arm64_write_word(buf, at, w);
}

// ---- bl (branch-with-link, the call instruction) ----

// arm64_bl_word encodes `bl <rel>` -> 0x94000000 | imm26 (rel/4). It sets
// x30 = address of the following instruction; `ret` returns through x30.
function arm64_bl_word(rel: i32): i64 {
    return 0x94000000 | (((rel >> 2) & 0x3ffffff) as i64);
}
function arm64_bl(buf: i32[], rel: i32): i32[] {
    return arm64_le32(buf, arm64_bl_word(rel));
}

// ============================================================
// named-label assembler
// ============================================================
//
// Arm64Asm threads the code buffer plus a label table (name -> byte
// offset) and a fixup queue for branches whose target is not yet placed.
// It is the arm64 counterpart of X86Asm in x86_native.fern. Branch
// displacements are PC-relative to the branch instruction itself, so a
// fixup records the instruction's byte offset and resolve patches with
// rel = target_off - instr_off. fix_kinds distinguishes the immediate
// field: 0 = imm26 (b / bl), 1 = imm19 (b.cond / cbz / cbnz).

pub struct Arm64Asm {
    code: i32[],
    lab_names: string[],
    lab_offs: i32[],
    fix_offs: i32[],
    fix_names: string[],
    fix_kinds: i32[],
    // Branch targets arm64_asm_resolve could not find. Collected there rather
    // than rescanned afterwards: resolve already looks every fixup name up, and
    // a second pass over both tables would be quadratic on a real program.
    unres: string[],
    oor: string[],       // branches whose displacement overflows its field (see arm64_rel_fits)
}

// arm64_asm_new returns an empty assembler state.
function arm64_asm_new(): Arm64Asm {
    return Arm64Asm { code: [], lab_names: [], lab_offs: [], fix_offs: [], fix_names: [], fix_kinds: [], unres: [], oor: [] };
}

// arm64_asm_label records `name` at the current code offset.
function arm64_asm_label(own a: Arm64Asm, name: string): Arm64Asm {
    a = Arm64Asm { ...a, lab_names: a.lab_names.append(name) };
    a = Arm64Asm { ...a, lab_offs: a.lab_offs.append(a.code.len()) };
    return a;
}

// arm64_asm_label_off returns the byte offset of label `name`, or -1 if it
// has not been placed yet.
pub function arm64_asm_label_off(a: Arm64Asm, name: string): i32 {
    var i: i32 = 0;
    while (i < a.lab_names.len()) {
        if (a.lab_names[i] == name) {
            return a.lab_offs[i];
        }
        i = i + 1;
    }
    return 0 - 1;
}

// ---- branch reach ----
//
// The three patchers below MASK the displacement into its immediate field, so
// an overflow does not fail — it wraps into a different, valid-looking branch.
// Nothing downstream can tell: the assembler reports success, the binary links,
// and it jumps somewhere arbitrary at run time. That is the same silence the
// undefined-label case used to produce, and it is reachable here: clang refuses
// to link the self-host compiler's own text because its `bl __fern_*` calls
// exceed imm26's ±128 MB, and this assembler links that text without comment.
//
// The native assembler checks (internal/native/arm64/asm.go, "outside the
// signed %d-bit range") and inserts veneers for imm26 (veneer.go). This is the
// refuse-first half of that parity: a diagnostic instead of a wrong branch.

// arm64_branch_field_bits is the immediate width a fixup kind patches: imm26
// for b/bl, imm19 for b.cond/cbz/cbnz, imm14 for tbz/tbnz.
function arm64_branch_field_bits(kind: i32): i32 {
    if (kind == 1) { return 19; }
    if (kind == 2) { return 14; }
    return 26;
}

// arm64_rel_fits reports whether a byte displacement is encodable in a signed
// `bits`-wide instruction-count field. AArch64 scales branch offsets by 4, so
// the field holds rel/4 and the reach is +/- (1 << (bits + 1)) bytes: 128 MB
// for imm26, 1 MB for imm19, 32 KB for imm14. A displacement that is not
// 4-aligned is unencodable at any width.
function arm64_rel_fits(rel: i32, bits: i32): boolean {
    if ((rel & 3) != 0) { return false; }
    var half: i32 = 1;
    var k: i32 = 0;
    while (k < bits - 1) { half = half * 2; k = k + 1; }
    var insns: i32 = rel / 4;
    return insns >= (0 - half) && insns < half;
}

// arm64_oor_note describes an over-range branch for the refusal list.
function arm64_oor_note(name: string, rel: i32, bits: i32): string {
    return name + " (" + arm64_gas_dec(rel) + " bytes, imm" + arm64_gas_dec(bits) + ")";
}

// arm64_asm_fixup_or_patch handles a branch placeholder just emitted into
// a.code (its instruction word at a.code.len()-4). `kind` selects the
// immediate field. If the target label is already placed, patch now;
// otherwise queue a fixup for arm64_asm_resolve.
function arm64_asm_fixup_or_patch(own a: Arm64Asm, name: string, kind: i32): Arm64Asm {
    var at: i32 = a.code.len() - 4;
    var target: i32 = arm64_asm_label_off(a, name);
    if (target >= 0) {
        // Take the buffer OUT of the struct before patching. `a.code` read
        // while `a` still holds it is a second reference, which sends the
        // `.with` inside the patch helpers down the copy path — one full
        // .text clone per backward branch. Owning `a` lets the field be
        // emptied first, so the local below is the only reference.
        var bits: i32 = arm64_branch_field_bits(kind);
        if (!arm64_rel_fits(target - at, bits)) {
            return Arm64Asm { ...a, oor: a.oor.append(arm64_oor_note(name, target - at, bits)) };
        }
        var code: i32[] = a.code;
        a = Arm64Asm { ...a, code: [] };
        if (kind == 1) {
            code = arm64_patch_b19(code, at, target - at);
        } else if (kind == 2) {
            code = arm64_patch_b14(code, at, target - at);
        } else {
            code = arm64_patch_b(code, at, target - at);
        }
        a = Arm64Asm { ...a, code: code };
    } else {
        a = Arm64Asm { ...a, fix_offs: a.fix_offs.append(at) };
        a = Arm64Asm { ...a, fix_names: a.fix_names.append(name) };
        a = Arm64Asm { ...a, fix_kinds: a.fix_kinds.append(kind) };
    }
    return a;
}

// arm64_asm_b / arm64_asm_bl emit an unconditional branch / call to a
// (possibly forward) label.
function arm64_asm_b(own a: Arm64Asm, name: string): Arm64Asm {
    a = Arm64Asm { ...a, code: arm64_b(a.code, 0) };
    return arm64_asm_fixup_or_patch(a, name, 0);
}
function arm64_asm_bl(own a: Arm64Asm, name: string): Arm64Asm {
    a = Arm64Asm { ...a, code: arm64_bl(a.code, 0) };
    return arm64_asm_fixup_or_patch(a, name, 0);
}

// arm64_asm_bcond / arm64_asm_cbz / arm64_asm_cbnz emit a conditional
// branch to a (possibly forward) label.
function arm64_asm_bcond(own a: Arm64Asm, cond: i32, name: string): Arm64Asm {
    a = Arm64Asm { ...a, code: arm64_bcond(a.code, cond, 0) };
    return arm64_asm_fixup_or_patch(a, name, 1);
}
function arm64_asm_cbz(own a: Arm64Asm, rt: i32, name: string, w: boolean): Arm64Asm {
    a = Arm64Asm { ...a, code: arm64_cbz(a.code, rt, 0, w) };
    return arm64_asm_fixup_or_patch(a, name, 1);
}
function arm64_asm_cbnz(own a: Arm64Asm, rt: i32, name: string, w: boolean): Arm64Asm {
    a = Arm64Asm { ...a, code: arm64_cbnz(a.code, rt, 0, w) };
    return arm64_asm_fixup_or_patch(a, name, 1);
}

// arm64_asm_resolve patches every queued (forward) fixup now that all
// labels are placed. Call once after emitting the whole program;
// afterwards a.code is the final .text.
// The buffer is pulled out of the struct ONCE and threaded through the whole
// fixup loop as a uniquely-owned local, then folded back. Patching it in
// place inside the struct — `a = Arm64Asm { ...a, code: arm64_patch_b(a.code,
// …) }` — cloned the entire .text per fixup, which is the largest of the
// three quadratic patch loops in this assembler (#6011).
function arm64_asm_resolve(own a: Arm64Asm): Arm64Asm {
    var code: i32[] = a.code;
    a = Arm64Asm { ...a, code: [] };
    var i: i32 = 0;
    while (i < a.fix_offs.len()) {
        var at: i32 = a.fix_offs[i];
        var target: i32 = arm64_asm_label_off(a, a.fix_names[i]);
        if (target < 0) {
            // A target that was never defined used to be patched as if the -1
            // sentinel were an offset, producing a well-formed binary that
            // branched to `-1 - here` — inside the ELF header, where the word is
            // zero, which is UDF #0. That silence is what let #6045 read as a
            // codegen mystery for as long as it did. Record the name and leave
            // the placeholder alone; arm64_gas_program folds these into the
            // refusal list, so the CLI reports the label instead of emitting a
            // binary that traps.
            a = Arm64Asm { ...a, unres: a.unres.append(a.fix_names[i]) };
            i = i + 1;
            continue;
        }
        var rbits: i32 = arm64_branch_field_bits(a.fix_kinds[i]);
        if (!arm64_rel_fits(target - at, rbits)) {
            a = Arm64Asm { ...a, oor: a.oor.append(arm64_oor_note(a.fix_names[i], target - at, rbits)) };
            i = i + 1;
            continue;
        }
        if (a.fix_kinds[i] == 1) {
            code = arm64_patch_b19(code, at, target - at);
        } else if (a.fix_kinds[i] == 2) {
            code = arm64_patch_b14(code, at, target - at);
        } else {
            code = arm64_patch_b(code, at, target - at);
        }
        i = i + 1;
    }
    return Arm64Asm { ...a, code: code };
}

// ---- load / store (64-bit, unsigned scaled immediate) ----
//
// The base+offset forms `ldr/str Xt, [Xn, #off]`. The 12-bit immediate is
// scaled by 8 (the access size), so `off` must be a multiple of 8 in
// 0..32760. Register 31 names SP here (the stack pointer), not XZR — used
// for spills to the stack frame.
//   str: (3<<30)|0x39000000              = 0xF9000000
//   ldr: 0xF9000000 | 0x00400000          = 0xF9400000
//        | (off/8)<<10 | Rn<<5 | Rt

function arm64_sp(): i32 { return 31; } // SP in load/store + add/sub-imm context

function arm64_str_word(rt: i32, rn: i32, off: i32): i64 {
    return 0xf9000000 | ((((off / 8) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_ldr_word(rt: i32, rn: i32, off: i32): i64 {
    return 0xf9400000 | ((((off / 8) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}

// The 32-bit forms are NOT a cleared sf bit: the width lives in the size field
// (bits 31:30), 11 -> 10, and the scaled immediate is divided by the ACCESS SIZE,
// so a 32-bit offset scales by 4 where the 64-bit one scales by 8. Getting only
// the base right would keep the width bug and add an addressing bug.
// Verified vs clang: str w0,[x1] = 0xb9000020, str w2,[x0,#8] = 0xb9000802,
// ldr w0,[sp,#8] = 0xb9400be0, ldr w3,[x4,#4] = 0xb9400483.
function arm64_str_word_w(rt: i32, rn: i32, off: i32): i64 {
    return 0xb9000000 | ((((off / 4) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_ldr_word_w(rt: i32, rn: i32, off: i32): i64 {
    return 0xb9400000 | ((((off / 4) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_str(buf: i32[], rt: i32, rn: i32, off: i32, w: boolean): i32[] {
    if (w) { return arm64_le32(buf, arm64_str_word_w(rt, rn, off)); }
    return arm64_le32(buf, arm64_str_word(rt, rn, off));
}
function arm64_ldr(buf: i32[], rt: i32, rn: i32, off: i32, w: boolean): i32[] {
    if (w) { return arm64_le32(buf, arm64_ldr_word_w(rt, rn, off)); }
    return arm64_le32(buf, arm64_ldr_word(rt, rn, off));
}
// 64-bit SIMD&FP load/store `ldr/str Dt, [Xn{, #off}]` — the float path
// loads f64 constants from rodata into a d-register. Scaled unsigned imm12
// (off/8), like the GP 64-bit form but base 0xfd400000 (ldr) / 0xfd000000
// (str). Verified vs llvm-mc: ldr d0,[x0,#8] = 0xfd400400.
function arm64_ldr_fp(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0xfd400000 | ((((off / 8) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_str_fp(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0xfd000000 | ((((off / 8) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
// The scaled unsigned forms above cannot express a NEGATIVE offset or a
// writeback, and the float path emits both — `str d8, [sp, #-16]!` on entry and
// `ldr d8, [sp], #16` on exit. Routing those through the scaled encoder wrapped
// -16 into a +8184 offset and dropped the writeback entirely: a stack store to
// the wrong address with sp never adjusted (#6060). imm9 is signed and unscaled
// in all three. Verified vs clang: str d8,[sp,#-16]! = 0xfc1f0fe8,
// ldr d8,[sp],#16 = 0xfc4107e8, stur d0,[x12,#-8] = 0xfc1f8180.
function arm64_stur_fp(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0xfc000000 | (((off & 0x1ff) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_ldur_fp(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0xfc400000 | (((off & 0x1ff) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_str_fp_pre(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0xfc000c00 | (((off & 0x1ff) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_ldr_fp_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0xfc400400 | (((off & 0x1ff) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}

// ---- PC-relative page addressing (@PAGE / @PAGEOFF) ----
//
// A 64-bit constant in __DATA is addressed in two steps, exactly as ld64's
// @PAGE / @PAGEOFF relocations resolve:
//   adrp Xn, sym@PAGE      ; Xn = (PC & ~0xFFF) + (page_delta << 12)
//   ldr  Xt, [Xn, #off]    ; off = sym & 0xFFF  (the @PAGEOFF)
// page_delta is the signed 4 KiB-page distance between the symbol and the
// adrp instruction, computed from the fixed addresses macho.fern lays the
// image out at (macho_text_vaddr / macho_data_vaddr — the SegmentAddrs
// parity). Because both segments share the 16 KiB Mach-O page alignment,
// @PAGEOFF is always 4 KiB-aligned here, but the math is general.

// arm64_page_delta returns the 4 KiB-page delta from the adrp instruction
// at `adrp_addr` to the target at `target_addr` (the adrp immediate).
function arm64_page_delta(target_addr: i64, adrp_addr: i64): i32 {
    return ((target_addr >> 12) - (adrp_addr >> 12)) as i32;
}

// arm64_page_off returns the in-page byte offset of `addr` (the @PAGEOFF).
function arm64_page_off(addr: i64): i32 {
    return (addr & 0xfff) as i32;
}

// arm64_adrp_word encodes `adrp Xd, #page_delta` -> 0x90000000 |
// immlo<<29 | immhi<<5 | Rd, where the 21-bit page delta splits into
// immlo (bits 1:0) and immhi (bits 20:2).
function arm64_adrp_word(rd: i32, page_delta: i32): i64 {
    var immlo: i64 = (page_delta & 3) as i64;
    var immhi: i64 = ((page_delta >> 2) & 0x7ffff) as i64;
    return 0x90000000 | (immlo << 29) | (immhi << 5) | ((rd & 31) as i64);
}
function arm64_adrp(buf: i32[], rd: i32, page_delta: i32): i32[] {
    return arm64_le32(buf, arm64_adrp_word(rd, page_delta));
}

// arm64_patch_adrp splices a page_delta into an `adrp` placeholder at byte
// offset `at`, preserving the opcode + Rd (masked-out 0x9f00001f).
function arm64_patch_adrp(own buf: i32[], at: i32, page_delta: i32): i32[] {
    var immlo: i64 = (page_delta & 3) as i64;
    var immhi: i64 = ((page_delta >> 2) & 0x7ffff) as i64;
    var w: i64 = (arm64_read_word(buf, at) & 0x9f00001f) | (immlo << 29) | (immhi << 5);
    return arm64_write_word(buf, at, w);
}

// arm64_patch_ldr_off splices a (scaled) byte offset into the imm12 field
// (bits 21:10) of an `ldr` placeholder at byte offset `at`, preserving the
// opcode + Rt/Rn (masked-out 0xffc003ff).
function arm64_patch_ldr_off(own buf: i32[], at: i32, off: i32): i32[] {
    var w: i64 = (arm64_read_word(buf, at) & 0xffc003ff) | ((((off / 8) & 0xfff) as i64) << 10);
    return arm64_write_word(buf, at, w);
}

// ---- PC-relative literal load (`ldr Xt, =N` + `.ltorg` pool) ----
//
// asm_arm64 loads any 64-bit immediate via `ldr Xt, =N` and flushes the
// constants into an in-.text literal pool at each `.ltorg` (after every
// function). The LDR (literal) form (64-bit, opc=01) is
//   0x58000000 | imm19<<5 | Rt
// where imm19 = (pool_addr - ldr_addr) / 4 (signed, the label is PC-
// relative from the ldr). Verified vs llvm-mc: a ldr to PC+8 = 0x58000040.
function arm64_ldr_lit_word(rt: i32, imm19: i32): i64 {
    return 0x58000000 | (((imm19 & 0x7ffff) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_ldr_lit(buf: i32[], rt: i32, imm19: i32): i32[] {
    return arm64_le32(buf, arm64_ldr_lit_word(rt, imm19));
}
// arm64_patch_ldr_lit splices imm19 (bits 23:5) into an LDR-literal
// placeholder at byte offset `at`, preserving the opcode + Rt (0xff00001f).
function arm64_patch_ldr_lit(own buf: i32[], at: i32, imm19: i32): i32[] {
    var w: i64 = (arm64_read_word(buf, at) & 0xff00001f) | (((imm19 & 0x7ffff) as i64) << 5);
    return arm64_write_word(buf, at, w);
}

// ---- frame pair load/store (the prologue/epilogue idiom) ----
//
// stp/ldp with writeback: `stp Xt, Xt2, [Xn, #off]!` (pre-index) saves the
// callee-saved pair while bumping SP; `ldp Xt, Xt2, [Xn], #off`
// (post-index) restores them and unwinds. off is a signed multiple of 8,
// scaled to the 7-bit immediate. (64-bit forms; verified vs llvm-mc.)

function arm64_stp_pre_word(rt: i32, rt2: i32, rn: i32, off: i32): i64 {
    var imm7: i64 = ((off / 8) & 0x7f) as i64;
    return 0xa9800000 | (imm7 << 15) | (((rt2 & 31) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_ldp_post_word(rt: i32, rt2: i32, rn: i32, off: i32): i64 {
    var imm7: i64 = ((off / 8) & 0x7f) as i64;
    return 0xa8c00000 | (imm7 << 15) | (((rt2 & 31) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_stp_pre(buf: i32[], rt: i32, rt2: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, arm64_stp_pre_word(rt, rt2, rn, off));
}
function arm64_ldp_post(buf: i32[], rt: i32, rt2: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, arm64_ldp_post_word(rt, rt2, rn, off));
}

// Signed-offset (no-writeback) pair forms: `stp Xt, Xt2, [Xn, #off]` and
// `ldp Xt, Xt2, [Xn, #off]`. asm_arm64 emits these for large frames whose
// callee-saved registers are spilled/reloaded at fixed offsets after a
// single `sub sp, sp, #N` / `add sp, sp, #N` (rather than a chain of
// pre/post-index pushes). Same imm7 = off/8 scaling; only the index bits
// differ from the writeback forms. (64-bit; verified vs llvm-mc:
// `stp x27,x28,[sp,#80]` = 0xa90573fb, `ldp x27,x28,[sp,#80]` = 0xa94573fb.)
function arm64_stp_off_word(rt: i32, rt2: i32, rn: i32, off: i32): i64 {
    var imm7: i64 = ((off / 8) & 0x7f) as i64;
    return 0xa9000000 | (imm7 << 15) | (((rt2 & 31) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_ldp_off_word(rt: i32, rt2: i32, rn: i32, off: i32): i64 {
    var imm7: i64 = ((off / 8) & 0x7f) as i64;
    return 0xa9400000 | (imm7 << 15) | (((rt2 & 31) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_stp_off(buf: i32[], rt: i32, rt2: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, arm64_stp_off_word(rt, rt2, rn, off));
}
function arm64_ldp_off(buf: i32[], rt: i32, rt2: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, arm64_ldp_off_word(rt, rt2, rn, off));
}

// ---- single load/store with writeback (signed 9-bit unscaled imm9) ----
//
// `str Xt, [Xn, #off]!` (pre) / `ldr Xt, [Xn], #off` (post) and the two
// mirror forms — the bare push/pop idiom. imm9 is a signed byte offset
// (NOT scaled). Index bits 11:10: pre = 0b11, post = 0b01.
//   base: (3<<30)|0x38000000 | (load?0x00400000)

function arm64_str_pre_word(rt: i32, rn: i32, off: i32): i64 {
    return 0xf8000000 | (((off & 0x1ff) as i64) << 12) | 0xc00 | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_str_post_word(rt: i32, rn: i32, off: i32): i64 {
    return 0xf8000000 | (((off & 0x1ff) as i64) << 12) | 0x400 | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_ldr_pre_word(rt: i32, rn: i32, off: i32): i64 {
    return 0xf8400000 | (((off & 0x1ff) as i64) << 12) | 0xc00 | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_ldr_post_word(rt: i32, rn: i32, off: i32): i64 {
    return 0xf8400000 | (((off & 0x1ff) as i64) << 12) | 0x400 | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_str_pre(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, arm64_str_pre_word(rt, rn, off));
}
function arm64_str_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, arm64_str_post_word(rt, rn, off));
}
function arm64_ldr_pre(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, arm64_ldr_pre_word(rt, rn, off));
}
function arm64_ldr_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, arm64_ldr_post_word(rt, rn, off));
}

// arm64_patch_addimm_off splices an unscaled 12-bit immediate into the
// imm12 field (bits 21:10) of an `add` (immediate) placeholder — used for
// `add Xd, Xn, sym@PAGEOFF`, preserving the opcode + Rd/Rn (0xffc003ff).
function arm64_patch_addimm_off(own buf: i32[], at: i32, off: i32): i32[] {
    var w: i64 = (arm64_read_word(buf, at) & 0xffc003ff) | (((off & 0xfff) as i64) << 10);
    return arm64_write_word(buf, at, w);
}

// ---- bitfield extract + negate + test-bit branch ----

// arm64_ubfx_word encodes `ubfx Xd, Xn, #lsb, #width` (unsigned bitfield
// extract) — the UBFM alias with immr=lsb, imms=lsb+width-1.
//   0xD3400000 | immr<<16 | imms<<10 | Rn<<5 | Rd
function arm64_ubfx_word(rd: i32, rn: i32, lsb: i32, width: i32): i64 {
    var immr: i64 = (lsb & 63) as i64;
    var imms: i64 = ((lsb + width - 1) & 63) as i64;
    return 0xd3400000 | (immr << 16) | (imms << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
}
function arm64_ubfx(buf: i32[], rd: i32, rn: i32, lsb: i32, width: i32): i32[] {
    return arm64_le32(buf, arm64_ubfx_word(rd, rn, lsb, width));
}

// arm64_sbfiz_word encodes `sbfiz Xd, Xn, #lsb, #width` — signed bitfield
// insert in zeros (sign-extend `width` low bits of Xn, then shift left by
// `lsb`). The SSA arm64 backend emits it for scaled-index addressing of an
// i32 value (`sbfiz xD, xN, #3, #32` = (i32)xN * 8). SBFM-64 alias:
// immr=(-lsb) mod 64, imms=width-1, N=1. (Verified vs llvm-mc:
// sbfiz x1,x2,#3,#29 = 0x937d7041.)
function arm64_sbfiz_word(rd: i32, rn: i32, lsb: i32, width: i32): i64 {
    var immr: i64 = ((64 - lsb) & 63) as i64;
    var imms: i64 = ((width - 1) & 63) as i64;
    return 0x93400000 | (immr << 16) | (imms << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
}
function arm64_sbfiz(buf: i32[], rd: i32, rn: i32, lsb: i32, width: i32): i32[] {
    return arm64_le32(buf, arm64_sbfiz_word(rd, rn, lsb, width));
}

// arm64_sxtw_word encodes `sxtw Xd, Wn` — sign-extend a 32-bit word to
// 64 bits. It's the SBFM-64 alias `sbfm Xd, Xn, #0, #31` (N=1, immr=0,
// imms=31). asm_arm64 emits it widening an i32 to i64 before 64-bit math.
//   0x93407c00 | Rn<<5 | Rd  (verified vs llvm-mc: sxtw x9,w9 = 0x93407d29)
function arm64_sxtw_word(rd: i32, rn: i32): i64 {
    return 0x93407c00 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
}
function arm64_sxtw(buf: i32[], rd: i32, rn: i32): i32[] {
    return arm64_le32(buf, arm64_sxtw_word(rd, rn));
}

// arm64_neg emits `neg Xd, Xm` — the `sub Xd, XZR, Xm` alias.
function arm64_neg(buf: i32[], rd: i32, rm: i32): i32[] {
    return arm64_le32(buf, arm64_subreg_word(rd, 31, rm));
}

// arm64_tbz_word / arm64_tbnz_word encode `tbz/tbnz Xt, #bit, <rel>` —
// test bit `bit` and branch if zero / nonzero. rel is a PC-relative byte
// delta (÷4 -> signed imm14 at bits 18:5). The tested bit splits into b5
// (bit 31) and b40 (bits 23:19).
//   tbz base 0x36000000, tbnz base 0x37000000.
function arm64_tbz_word(rt: i32, bit: i32, rel: i32): i64 {
    var b5: i64 = ((bit >> 5) & 1) as i64;
    var b40: i64 = (bit & 31) as i64;
    return 0x36000000 | (b5 << 31) | (b40 << 19) | ((((rel >> 2) & 0x3fff) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_tbnz_word(rt: i32, bit: i32, rel: i32): i64 {
    var b5: i64 = ((bit >> 5) & 1) as i64;
    var b40: i64 = (bit & 31) as i64;
    return 0x37000000 | (b5 << 31) | (b40 << 19) | ((((rel >> 2) & 0x3fff) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_tbz(buf: i32[], rt: i32, bit: i32, rel: i32): i32[] {
    return arm64_le32(buf, arm64_tbz_word(rt, bit, rel));
}
// tbz/tbnz put the bit index's high bit in position 31 (b5), so a 32-bit test
// simply has b5 = 0 — which arm64_tbnz_word already produces for bit < 32. The
// `w` flag is accepted for symmetry with the other forms and asserts nothing:
// clearing bit 31 for a bit index >= 32 would silently test the WRONG BIT, so
// the width comes from the index, not from the register spelling. Verified vs
// clang: tbnz w2,#31 = 0x37f800a2 (same word the 64-bit builder emits for
// bit 31).
function arm64_tbnz(buf: i32[], rt: i32, bit: i32, rel: i32): i32[] {
    return arm64_le32(buf, arm64_tbnz_word(rt, bit, rel));
}

// arm64_patch_b14 splices a rel into the imm14 field (bits 18:5) of a
// `tbz`/`tbnz` placeholder, preserving the opcode + b5/b40/Rt (mask
// 0xfff8001f).
function arm64_patch_b14(own buf: i32[], at: i32, rel: i32): i32[] {
    var w: i64 = (arm64_read_word(buf, at) & 0xfff8001f) | ((((rel >> 2) & 0x3fff) as i64) << 5);
    return arm64_write_word(buf, at, w);
}

// arm64_asm_tbz / arm64_asm_tbnz emit a test-bit branch to a (possibly
// forward) label (fixup kind 2 = imm14).
function arm64_asm_tbz(own a: Arm64Asm, rt: i32, bit: i32, name: string): Arm64Asm {
    a = Arm64Asm { ...a, code: arm64_tbz(a.code, rt, bit, 0) };
    return arm64_asm_fixup_or_patch(a, name, 2);
}
function arm64_asm_tbnz(own a: Arm64Asm, rt: i32, bit: i32, name: string): Arm64Asm {
    a = Arm64Asm { ...a, code: arm64_tbnz(a.code, rt, bit, 0) };
    return arm64_asm_fixup_or_patch(a, name, 2);
}

// ---- multiply, unscaled load/store, conditional-set ----

// arm64_mul encodes `mul Xd, Xn, Xm` — the `madd Xd, Xn, Xm, XZR` alias.
//   0x9B000000 | Rm<<16 | (31<<10 = Ra=XZR) | Rn<<5 | Rd
function arm64_mul(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    var w: i64 = 0x9b000000 | (((rm & 31) as i64) << 16) | (31 << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    return arm64_le32(buf, w);
}

// arm64_ldr_reg / arm64_str_reg encode the register-offset forms
// `ldr/str Xt, [Xn, Xm{, lsl #3}]` — the array-indexing idiom (base + index
// * 8). 64-bit: ldr base 0xf8600000, str base 0xf8200000; option=LSL/UXTX
// (011), bits[11:10]=10. The scale bit S (bit 12) is set for `lsl #3` and
// clear for the bare `[Xn, Xm]` form (0x7800 vs 0x6800). Verified vs llvm-mc:
// ldr x0,[x0,x1,lsl #3] = 0xf8617800; ldr x0,[x1,x2] = 0xf8626820.
function arm64_ldr_str_reg_word(is_load: boolean, rt: i32, rn: i32, rm: i32, shifted: boolean): i64 {
    var base: i64 = 0xf8200000;
    if (is_load) { base = 0xf8600000; }
    var optbits: i64 = 0x6800;
    if (shifted) { optbits = 0x7800; }
    return base | (((rm & 31) as i64) << 16) | optbits | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
}
function arm64_ldr_str_reg(buf: i32[], is_load: boolean, rt: i32, rn: i32, rm: i32, shifted: boolean): i32[] {
    return arm64_le32(buf, arm64_ldr_str_reg_word(is_load, rt, rn, rm, shifted));
}

// arm64_ldrb_strb_reg encodes the REGISTER-offset byte forms
// `ldrb/strb Wt, [Xn, Xm]` — the size=00 siblings of arm64_ldr_str_reg above,
// same option bits (0x6800 = UXTX / LSL #0; a byte has nothing to scale, so
// there is no shifted variant). ldrb base 0x38600000, strb base 0x38200000.
// Verified vs clang --target=aarch64-linux-gnu: ldrb w0,[x0,x1] = 0x38616800,
// strb w2,[x3,x4] = 0x38246862, ldrb w5,[x6,x7] = 0x386768c5,
// strb w0,[x1,x2] = 0x38226820.
//
// This form is what the string-copy loops emit (`ldrb w0, [x0, x1]` — base +
// index). Its absence was #6047: arm64_gas_mem read the index REGISTER as an
// immediate, so `[x0, x1]` assembled as `[x0, #1]` and every iteration reloaded
// the string's second byte — printed output came out the right length with the
// wrong bytes ("Hello, Fern!" -> "eeeeeeeeeeeeF").
function arm64_ldrb_strb_reg(buf: i32[], is_load: boolean, rt: i32, rn: i32, rm: i32): i32[] {
    var base: i64 = 0x38200000;
    if (is_load) { base = 0x38600000; }
    var w: i64 = base | (((rm & 31) as i64) << 16) | 0x6800 | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
    return arm64_le32(buf, w);
}

// arm64_ldur / arm64_stur encode `ldur/stur Xt, [Xn, #off]` — the unscaled
// signed-imm9 load/store (no writeback, no scaling), the form the backend
// uses for frame-slot access. 0xF8400000 / 0xF8000000 | imm9<<12 | Rn<<5 | Rt.
// Unscaled (imm9), so unlike ldr/str above only the size field changes:
// 0xf8400000 -> 0xb8400000 and 0xf8000000 -> 0xb8000000. Verified vs clang:
// ldur w1,[x0,#-8] = 0xb85f8001, stur w1,[x0,#-16] = 0xb81f0001.
function arm64_ldur(buf: i32[], rt: i32, rn: i32, off: i32, w32: boolean): i32[] {
    var base: i64 = 0xf8400000;
    if (w32) { base = 0xb8400000; }
    var w: i64 = base | (((off & 0x1ff) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
    return arm64_le32(buf, w);
}
function arm64_stur(buf: i32[], rt: i32, rn: i32, off: i32, w32: boolean): i32[] {
    var base: i64 = 0xf8000000;
    if (w32) { base = 0xb8000000; }
    var w: i64 = base | (((off & 0x1ff) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
    return arm64_le32(buf, w);
}

// arm64_cset encodes `cset Xd/Wd, <cond>` — `csinc Xd, XZR, XZR, invert(cond)`.
// The destination width lives in the sf bit, like every other ALU form: 0x9a..
// for X, 0x1a.. for W. It was hardcoded to the X form, so `cset w0, mi`
// assembled as `cset x0, mi` — 73 times in one fixture, found by the
// whole-program alignment #6062 asked for. Behaviourally invisible (cset writes
// 0 or 1, so the top half is zero either way), which is why nothing caught it,
// but it is the wrong instruction and the #6054 width class exactly.
// Verified vs GNU as: cset w0,mi = 0x1a9f57e0, cset x0,ge = 0x9a9fb7e0,
// cset w3,eq = 0x1a9f17e3.
// (set Xd to 1 if cond holds, else 0). The condition is inverted (cond^1).
//   0x9A800400 | (31<<16) | invcond<<12 | (31<<5) | Rd
function arm64_cset(buf: i32[], rd: i32, cond: i32, w32: boolean): i32[] {
    var base: i64 = 0x9a800400;
    if (w32) { base = 0x1a800400; }
    var w: i64 = base | (31 << 16) | ((((cond ^ 1) & 15) as i64) << 12) | (31 << 5) | ((rd & 31) as i64);
    return arm64_le32(buf, w);
}

// ---- shifts (immediate), cmn, csel, and ----

// arm64_lsl_imm / arm64_lsr_imm encode `lsl/lsr Rd, Rn, #sh` — the UBFM
// aliases. `w` selects the 32-bit form (sf=0, base 0x53000000); else the
// 64-bit form (base 0xD3400000, N=1 folded in). lsl uses immr=(width-sh),
// imms=(width-1-sh); lsr uses immr=sh, imms=width-1.
function arm64_lsl_imm(buf: i32[], rd: i32, rn: i32, sh: i32, w: boolean): i32[] {
    var width: i32 = 64;
    var base: i64 = 0xd3400000;
    if (w) { width = 32; base = 0x53000000; }
    var immr: i64 = ((width - sh) & (width - 1)) as i64;
    var imms: i64 = ((width - 1 - sh) & 63) as i64;
    return arm64_le32(buf, base | (immr << 16) | (imms << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
function arm64_lsr_imm(buf: i32[], rd: i32, rn: i32, sh: i32, w: boolean): i32[] {
    var width: i32 = 64;
    var base: i64 = 0xd3400000;
    if (w) { width = 32; base = 0x53000000; }
    var immr: i64 = (sh & (width - 1)) as i64;
    var imms: i64 = ((width - 1) & 63) as i64;
    return arm64_le32(buf, base | (immr << 16) | (imms << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
// asr's immediate form is SBFM (the SIGNED sibling of lsr's UBFM): same
// immr=sh / imms=width-1 fields, base 0x93400000 (64-bit) / 0x13000000 (32-bit).
// Verified vs clang --target=aarch64-linux-gnu: asr x0,x1,#4 = 0x9344fc20,
// asr x3,x4,#1 = 0x9341fc83, asr x5,x6,#63 = 0x937ffcc5.
//
// The dispatcher previously sent `asr Xd, Xn, #k` down the REGISTER path on the
// grounds that the emitter only produces the variable form. That was true and
// still is, but the fallback was silent and wrong: arm64_gas_reg("#4") is -1,
// masked to 31, so it assembled as `asrv Xd, Xn, xzr` — a shift by ZERO. The
// same silent-wrong-encoding shape as #6047, found by the encoding differential
// added with that fix, so it is closed here rather than left as a trap for
// whoever teaches the emitter a signed constant shift.
function arm64_asr_imm(buf: i32[], rd: i32, rn: i32, sh: i32, w: boolean): i32[] {
    var width: i32 = 64;
    var base: i64 = 0x93400000;
    if (w) { width = 32; base = 0x13000000; }
    var immr: i64 = (sh & (width - 1)) as i64;
    var imms: i64 = ((width - 1) & 63) as i64;
    return arm64_le32(buf, base | (immr << 16) | (imms << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}

// Variable (register) shift forms — the LSLV / LSRV / ASRV data-processing
// 2-source instructions `lsl/lsr/asr Rd, Rn, Rm`. asm_arm64 emits these
// when the shift amount is a runtime value (`x << y`, signed `x >> y`).
// 64-bit base 0x9ac02000/2400/2800; `w` clears sf for the 32-bit form
// (0x1ac0...). (Verified vs llvm-mc: lsl x0,x1,x2 = 0x9ac22020,
// asr x0,x1,x2 = 0x9ac22820, asr w0,w1,w2 = 0x1ac22820.)
function arm64_shiftreg(buf: i32[], base64: i64, rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
    var base: i64 = base64;
    if (w) { base = base64 & 0x7fffffff; }
    return arm64_le32(buf, base | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
function arm64_lslv(buf: i32[], rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
    return arm64_shiftreg(buf, 0x9ac02000, rd, rn, rm, w);
}
function arm64_lsrv(buf: i32[], rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
    return arm64_shiftreg(buf, 0x9ac02400, rd, rn, rm, w);
}
function arm64_asrv(buf: i32[], rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
    return arm64_shiftreg(buf, 0x9ac02800, rd, rn, rm, w);
}

// arm64_cmn_imm encodes `cmn Xn, #imm12` — `adds XZR, Xn, #imm12`.
function arm64_cmn_imm(buf: i32[], rn: i32, imm12: i32): i32[] {
    return arm64_le32(buf, 0xb1000000 | (((imm12 & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | 31);
}

// arm64_csel encodes `csel Xd, Xn, Xm, <cond>`.
//   0x9A800000 | Rm<<16 | cond<<12 | Rn<<5 | Rd
function arm64_csel(buf: i32[], rd: i32, rn: i32, rm: i32, cond: i32): i32[] {
    return arm64_le32(buf, 0x9a800000 | (((rm & 31) as i64) << 16) | (((cond & 15) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}

// arm64_andreg encodes `and Xd, Xn, Xm` (logical shifted-register, zero shift).
function arm64_andreg(buf: i32[], rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
    var word: i64 = 0x8a000000 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (w) { word = word & 0x7fffffff; }   // 0x8a.. -> 0x0a..
    return arm64_le32(buf, word);
}

// ---- AArch64 bitmask (logical) immediate encoder ----
//
// A port of the Go reference's encodeBitmask (internal/native/arm64), for
// the 64-bit `and/orr/eor Xd, Xn, #imm` immediate forms. Returns the
// (N, immr, imms) fields and whether `imm` is a legal bitmask immediate.
// Pinned vs llvm-mc. The few i64 bit-twiddles Fern lacks natively are
// provided below (logical shift right, ctz, clz) — `>>` is arithmetic, so
// logical shifts mask off the sign-extended high bits.

struct Arm64Bm {
    n: i32,
    immr: i32,
    imms: i32,
    ok: boolean,
}

// arm64_bm_lowmask returns the low-k-bits-set mask (k in 0..64).
function arm64_bm_lowmask(k: i32): i64 {
    if (k <= 0) { return 0; }
    if (k >= 64) { return 0 - 1; }
    return ((1 as i64) << k) - 1;
}

// arm64_bm_lsr is a logical (unsigned) shift right of a 64-bit value.
function arm64_bm_lsr(x: i64, n: i32): i64 {
    if (n <= 0) { return x; }
    if (n >= 64) { return 0; }
    return (x >> n) & arm64_bm_lowmask(64 - n);
}

// arm64_bm_ctz / arm64_bm_clz count trailing / leading zero bits of a
// nonzero 64-bit value (64 if zero). Bit i is `(x >> i) & 1` — masking the
// low bit is correct regardless of the shift's sign behaviour.
function arm64_bm_ctz(x: i64): i32 {
    var i: i32 = 0;
    while (i < 64) {
        if (((x >> i) & 1) == 1) { return i; }
        i = i + 1;
    }
    return 64;
}
function arm64_bm_clz(x: i64): i32 {
    var i: i32 = 0;
    while (i < 64) {
        if (((x >> (63 - i)) & 1) == 1) { return i; }
        i = i + 1;
    }
    return 64;
}

// arm64_bm_isshifted is true when v is a contiguous run of low ones
// (v != 0 and v+1 is a power of two): ((v-1)|v)+1 has no bits in common
// with ((v-1)|v).
function arm64_bm_isshifted(v: i64): boolean {
    if (v == 0) { return false; }
    var m: i64 = (v - 1) | v;
    return ((m + 1) & m) == 0;
}

// arm64_encode_bitmask encodes a 64-bit `imm` as an AArch64 logical
// immediate (N, immr, imms). ok=false if imm is not a legal bitmask value.
function arm64_encode_bitmask(imm: i64): Arm64Bm {
    if (imm == 0 || imm == (0 - 1)) {
        return Arm64Bm { n: 0, immr: 0, imms: 0, ok: false };
    }
    var size: i32 = 64;
    var done: boolean = false;
    while (!done) {
        size = size / 2;
        var m: i64 = arm64_bm_lowmask(size);
        if ((imm & m) != (arm64_bm_lsr(imm, size) & m)) {
            size = size * 2;
            done = true;
        } else if (size <= 2) {
            done = true;
        }
    }
    var allones: i64 = 0 - 1;
    var mask: i64 = arm64_bm_lsr(allones, 64 - size);
    imm = imm & mask;
    var i: i32 = 0;
    var cto: i32 = 0;
    if (arm64_bm_isshifted(imm)) {
        i = arm64_bm_ctz(imm);
        cto = arm64_bm_ctz(arm64_bm_lsr(imm, i) ^ allones);
    } else {
        imm = imm | (mask ^ allones);
        if (!arm64_bm_isshifted(imm ^ allones)) {
            return Arm64Bm { n: 0, immr: 0, imms: 0, ok: false };
        }
        var clo: i32 = arm64_bm_clz(imm ^ allones);
        i = 64 - clo;
        cto = clo + arm64_bm_ctz(imm ^ allones) - (64 - size);
    }
    var immr: i32 = (size - i) & (size - 1);
    var nimms: i32 = ((size - 1) ^ (0 - 1)) << 1;
    nimms = nimms | (cto - 1);
    var nbit: i32 = ((nimms >> 6) & 1) ^ 1;
    var imms: i32 = nimms & 0x3f;
    return Arm64Bm { n: nbit, immr: immr, imms: imms, ok: true };
}

// arm64_and_imm_ok reports whether `imm` (sign-extended from the parsed
// i32) is a legal `and` bitmask immediate.
function arm64_and_imm_ok(imm: i32): boolean {
    return arm64_encode_bitmask(imm as i64).ok;
}

// arm64_and_imm encodes `and Xd, Xn, #imm` / `and Wd, Wn, #imm` (logical
// immediate). Callers must check arm64_and_imm_ok(imm) — and, for the 32-bit
// form, arm64_logical_imm_w_ok(imm) — first.
//
// The 32-bit form is base 0x12000000 with **N = 0**: a 32-bit logical immediate
// has no 64-bit element size to select, so the N bit is not merely the sf bit
// moved. immr/imms carry over unchanged for a single contiguous run, which is
// every mask this emitter produces (1, 31, 127, 255). Verified vs clang:
// and w10,w9,#255 = 0x12001d2a, and w9,w9,#1 = 0x12000129,
// and w0,w1,#31 = 0x12001020, and x10,x9,#255 = 0x92401d2a.
function arm64_and_imm(buf: i32[], rd: i32, rn: i32, imm: i32, w: boolean): i32[] {
    var bm: Arm64Bm = arm64_encode_bitmask(imm as i64);
    var base: i64 = 0x92000000;
    var nbit: i64 = bm.n as i64;
    if (w) { base = 0x12000000; nbit = 0; }
    return arm64_le32(buf, base | (nbit << 22) | ((bm.immr as i64) << 16) | ((bm.imms as i64) << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}

// arm64_logical_imm_w_ok reports whether `imm` can be re-encoded as a 32-bit
// logical immediate by dropping the N bit — i.e. it fits in 32 bits and the
// 64-bit encoding is the single-run (N=1) shape whose immr/imms transfer
// unchanged. Anything else (a mask that needs a 64-bit element size, or one
// wider than 32 bits) is REFUSED by the caller rather than encoded on a guess:
// silently emitting the wrong mask is the #6047 / #6054 failure mode.
function arm64_logical_imm_w_ok(imm: i32): boolean {
    if (imm < 0) { return false; }
    var bm: Arm64Bm = arm64_encode_bitmask(imm as i64);
    if (!bm.ok) { return false; }
    return bm.n == 1;
}

// eor (exclusive-or). asm_arm64 emits the register form `eor Rd, Rn, Rm`
// (e.g. XOR of two values) and the immediate form `eor Xd, Xn, #imm` (the
// boolean-not idiom `x ^ 1`). Register: 64-bit base 0xca000000, 32-bit
// 0x4a000000 (w clears sf). Immediate: 0xd2000000 + the logical-bitmask
// (N,immr,imms), same encoder + validity check as `and #imm`. (Verified vs
// llvm-mc: eor x0,x0,x1 = 0xca010000, eor w9,w9,w10 = 0x4a0a0129,
// eor x0,x1,#1 = 0xd2400020.)
function arm64_eor(buf: i32[], rd: i32, rn: i32, rm: i32, w: boolean): i32[] {
    var base: i64 = 0xca000000;
    if (w) { base = 0x4a000000; }
    return arm64_le32(buf, base | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
function arm64_eor_imm_ok(imm: i32): boolean {
    return arm64_encode_bitmask(imm as i64).ok;
}
// 32-bit form: base 0x52000000, N=0 — same rule as arm64_and_imm above.
// Verified vs clang: eor w9,w9,#1 = 0x52000129.
function arm64_eor_imm(buf: i32[], rd: i32, rn: i32, imm: i32, w: boolean): i32[] {
    var bm: Arm64Bm = arm64_encode_bitmask(imm as i64);
    var base: i64 = 0xd2000000;
    var nbit: i64 = bm.n as i64;
    if (w) { base = 0x52000000; nbit = 0; }
    return arm64_le32(buf, base | (nbit << 22) | ((bm.immr as i64) << 16) | ((bm.imms as i64) << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}

// ---- orr / subs / divide / multiply-subtract / rev16 ----
//
// The integer-runtime ops the self-host asm_arm64 emitter uses beyond the
// arithmetic above (verified vs llvm-mc).

function arm64_orr(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, 0xaa000000 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
// subs Xd, Xn, Xm (flag-setting subtract) -> 0xEB000000.
function arm64_subsreg(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, 0xeb000000 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
// subs Xd, Xn, #imm12 -> 0xF1000000 (cmp is the Rd=31 special case).
function arm64_subsimm(buf: i32[], rd: i32, rn: i32, imm12: i32): i32[] {
    return arm64_le32(buf, 0xf1000000 | (((imm12 & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
// udiv / sdiv Xd, Xn, Xm -> 0x9AC00800 / 0x9AC00C00.
function arm64_udiv(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, 0x9ac00800 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
function arm64_sdiv(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, 0x9ac00c00 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
// msub Xd, Xn, Xm, Xa = Xa - Xn*Xm -> 0x9B008000 | Rm<<16 | Ra<<10 | Rn<<5 | Rd.
function arm64_msub(buf: i32[], rd: i32, rn: i32, rm: i32, ra: i32): i32[] {
    return arm64_le32(buf, 0x9b008000 | (((rm & 31) as i64) << 16) | (((ra & 31) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
// rev16 Xd, Xn -> 0xDAC00400 | Rn<<5 | Rd.
// `w` clears sf: 0xdac00400 -> 0x5ac00400. rev16 on a 32-bit value byte-swaps
// two halfwords; the 64-bit form swaps four, so the width is the operation.
function arm64_rev16(buf: i32[], rd: i32, rn: i32, w: boolean): i32[] {
    var word: i64 = 0xdac00400 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}
// clz Xd, Xn -> 0xDAC01000 | Rn<<5 | Rd (same DP-1-source family as rev16;
// the Go arm64 backend emits it for the freelist size-class log2).
//
// The `w` flag clears the sf bit for the 32-bit form, exactly as rev16 above
// does. It used to be absent, so `clz w0, w0` silently encoded the X-form and
// counted over 64 bits -- `__clz32(1)` returned 63 instead of 31, and the
// clz-derived ctz returned a NEGATIVE number (31 - 60), which surfaced as exit
// code 227 (-29 truncated to a byte) rather than as anything resembling a
// bit count. Every caller before #6197 happened to want the 64-bit form, which
// is why the missing flag went unnoticed.
function arm64_clz(buf: i32[], rd: i32, rn: i32, w: boolean): i32[] {
    var word: i64 = 0xdac01000 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}
// rbit Xd, Xn -> 0xDAC00000 | Rn<<5 | Rd. Third member of the same DP-1-source
// family as rev16/clz, and the ctz idiom's first half: `rbit` then `clz`
// counts trailing zeros, inheriting clz's width-at-zero (reversing zero
// leaves zero). The `w` flag clears sf exactly as clz's does -- without it a
// 32-bit ctz would reverse over 64 bits and count the empty upper half.
function arm64_rbit(buf: i32[], rd: i32, rn: i32, w: boolean): i32[] {
    var word: i64 = 0xdac00000 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (w) { word = word & 0x7fffffff; }
    return arm64_le32(buf, word);
}
// cnt Vd.8b, Vn.8b -> 0x0E205800 | Q<<30 | Rn<<5 | Rd -- per-BYTE population
// count, the only popcount AArch64 has (there is no scalar form, which is why
// a popcount lowering routes its value through a v-register).
function arm64_cnt(buf: i32[], rd: i32, rn: i32, q: boolean): i32[] {
    var word: i64 = 0x0e205800 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (q) { word = word | 0x40000000; }
    return arm64_le32(buf, word);
}
// addv Bd, Vn.8b -> 0x0E31B800 | Q<<30 | Rn<<5 | Rd -- horizontal sum across
// the byte lanes into the destination's low byte. Paired with `cnt` it
// completes a popcount; the sum tops out at 64, so the byte-wide destination
// cannot overflow. Only the byte arrangements (size=00) are encoded.
function arm64_addv(buf: i32[], rd: i32, rn: i32, q: boolean): i32[] {
    var word: i64 = 0x0e31b800 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (q) { word = word | 0x40000000; }
    return arm64_le32(buf, word);
}

// ---- byte/halfword/sign-extending load/store (unsigned scaled imm) ----
// ldrb/strb size 0 (no scale); ldrh/strh size 1 (÷2); ldrsw size 2 (÷4).
function arm64_ldrb(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x39400000 | (((off & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_strb(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x39000000 | (((off & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
// Post-index byte load/store `ldrb/strb Wt, [Xn], #imm9` — the byte-copy
// loop idiom (__fern_str_concat). imm9 is a signed unscaled offset in
// bits 20:12, index bits 11:10 = 01. ldrb base 0x38400000, strb 0x38000000.
// Verified vs llvm-mc: ldrb w4,[x1],#1 = 0x38401424.
function arm64_ldrb_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x38400400 | (((off & 0x1ff) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_strb_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x38000400 | (((off & 0x1ff) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_ldrh(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x79400000 | ((((off / 2) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_strh(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x79000000 | ((((off / 2) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_ldrsw(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0xb9800000 | ((((off / 4) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}

// ---- mrs (read system register) ----
// arm64_mrs_base returns the encoded base word for a supported system
// register name (the full mrs word minus Rt), or -1 if unknown.
function arm64_mrs_base(name: string): i64 {
    if (name == "cntvct_el0") { return 0xd53be040; }
    if (name == "cntfrq_el0") { return 0xd53be000; }
    return 0 - 1;
}
function arm64_mrs(buf: i32[], rt: i32, name: string): i32[] {
    return arm64_le32(buf, arm64_mrs_base(name) | ((rt & 31) as i64));
}

// ---- f64 (scalar double) instructions ----
//
// The float runtime the self-host asm_arm64 emitter always emits. d-regs
// and x-regs share the 5-bit field; the opcode picks the bank. (Verified vs
// llvm-mc.)

function arm64_fadd(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, 0x1e602800 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
function arm64_fsub(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, 0x1e603800 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
function arm64_fmul(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, 0x1e600800 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
function arm64_fdiv(buf: i32[], rd: i32, rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, 0x1e601800 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
// The double-precision unary FP family — fneg / fabs / fsqrt and the four
// frint rounding modes — shares one encoding shape `<op> Dd, Dn`: a base
// opcode with Rn at bit 5 and Rd at bit 0. Only the base differs.
// (Verified against internal/native/arm64's FNEG / FABS / FSQRT / FRINT*.)
function arm64_funary_d_base(mnem: string): i64 {
    if (mnem == "fneg") { return 0x1e614000; }
    if (mnem == "fabs") { return 0x1e60c000; }
    if (mnem == "fsqrt") { return 0x1e61c000; }
    if (mnem == "frintm") { return 0x1e654000; } // floor
    if (mnem == "frintp") { return 0x1e64c000; } // ceil
    if (mnem == "frintz") { return 0x1e65c000; } // trunc
    if (mnem == "frinta") { return 0x1e664000; } // round half away from zero
    if (mnem == "frintn") { return 0x1e644000; } // round half to EVEN (x86 roundsd mode 0)
    return 0 - 1;
}
function arm64_funary_d(buf: i32[], base: i64, rd: i32, rn: i32): i32[] {
    return arm64_le32(buf, base | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
// fcmp Dn, Dm (Rd field = 0).
function arm64_fcmp(buf: i32[], rn: i32, rm: i32): i32[] {
    return arm64_le32(buf, 0x1e602000 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5));
}
// fmov Dd, Dn (fp->fp).
function arm64_fmov_dd(buf: i32[], rd: i32, rn: i32): i32[] {
    return arm64_le32(buf, 0x1e604000 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
// fmov Dd, Xn (gpr->fp).
function arm64_fmov_from_gpr(buf: i32[], rd_fp: i32, rn_gpr: i32): i32[] {
    return arm64_le32(buf, 0x9e670000 | (((rn_gpr & 31) as i64) << 5) | ((rd_fp & 31) as i64));
}
// fmov Xd, Dn (fp->gpr).
function arm64_fmov_to_gpr(buf: i32[], rd_gpr: i32, rn_fp: i32): i32[] {
    return arm64_le32(buf, 0x9e660000 | (((rn_fp & 31) as i64) << 5) | ((rd_gpr & 31) as i64));
}
// The SINGLE-precision siblings, `fmov Sd, Wn` and `fmov Wd, Sn` — the f32
// bit-reinterpret pair the float path emits either side of an fcvt. Verified vs
// clang: fmov s0,w0 = 0x1e270000, fmov w0,s0 = 0x1e260000.
function arm64_fmov_s_from_gpr(buf: i32[], rd_fp: i32, rn_gpr: i32): i32[] {
    return arm64_le32(buf, 0x1e270000 | (((rn_gpr & 31) as i64) << 5) | ((rd_fp & 31) as i64));
}
function arm64_fmov_s_to_gpr(buf: i32[], rd_gpr: i32, rn_fp: i32): i32[] {
    return arm64_le32(buf, 0x1e260000 | (((rn_fp & 31) as i64) << 5) | ((rd_gpr & 31) as i64));
}
// fcvt Sd, Dn (double -> single) and fcvt Dd, Sn (single -> double) — the
// FP-to-FP precision conversions. Same one-source shape as the funary family:
// base | Rn<<5 | Rd. Verified vs clang --target=aarch64-linux-gnu:
// fcvt s0,d0 = 0x1e624000, fcvt s3,d4 = 0x1e624083, fcvt d0,s0 = 0x1e22c000,
// fcvt d5,s6 = 0x1e22c0c5.
//
// This was the single largest hole in the assembler: 605 of these in six
// fixtures' emitted asm, and no encoder at all, so `-target arm64-linux` refused any
// program whose runtime helpers touch floats — 64 corpus fixtures, most of them
// (fizzbuzz, empty_array, map_keys) with no float in their source (#6044).
function arm64_fcvt_s_d(buf: i32[], rd: i32, rn: i32): i32[] {
    return arm64_le32(buf, 0x1e624000 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
function arm64_fcvt_d_s(buf: i32[], rd: i32, rn: i32): i32[] {
    return arm64_le32(buf, 0x1e22c000 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}

// fcvtzs Xd, Dn / fcvtzs Wd, Dn (double -> signed int, round toward zero).
// The GP destination's width is in the sf bit: 0x9e780000 for X, 0x1e780000 for
// W. It was hardcoded to the X form, so `fcvtzs w5, d6` sign-extended into the
// full 64-bit register — the #6054 width class again, on the FP boundary.
// Verified vs clang: fcvtzs x0,d0 = 0x9e780000, fcvtzs w5,d6 = 0x1e7800c5.
// fcvtzu Xd, Dn / fcvtzu Wd, Dn is the UNSIGNED twin (opcode 001 instead of
// 000): 0x9e790000 / 0x1e790000. It had no encoder either, so `f64 as u32` /
// `as u64` — which the emitter lowers to fcvtzu, the saturating unsigned
// truncation — was refused by -target arm64-linux the same way ucvtf was.
// Verified vs clang: fcvtzu x0,d1 = 0x9e790020, fcvtzu w5,d6 = 0x1e7900c5.
function arm64_fcvtz_int(buf: i32[], rd_gpr: i32, rn_fp: i32, w: boolean, unsigned: boolean): i32[] {
    var base: i64 = 0x9e780000;
    if (unsigned) { base = 0x9e790000; }
    if (w) {
        base = 0x1e780000;
        if (unsigned) { base = 0x1e790000; }
    }
    return arm64_le32(buf, base | (((rn_fp & 31) as i64) << 5) | ((rd_gpr & 31) as i64));
}
// scvtf Dd, Xn / Dd, Wn (signed int -> double) and ucvtf Dd, Xn / Dd, Wn
// (unsigned int -> double). Same encoding but for the opcode field — 010 for
// signed, 011 for unsigned — and, as with fcvtzs, the GP SOURCE's width lives
// in the sf bit: 0x9e6.0000 for X, 0x1e6.0000 for W. ucvtf was missing
// entirely, so `u64 as f64` (which needs it — a signed convert reads a value
// >= 2^63 as negative, #6051) was refused by the in-process assembler.
// Verified vs clang: scvtf d0,x1 = 0x9e620020, ucvtf d0,x1 = 0x9e630020,
// ucvtf d0,w1 = 0x1e630020.
function arm64_cvtf(buf: i32[], rd_fp: i32, rn_gpr: i32, w: boolean, unsigned: boolean): i32[] {
    var base: i64 = 0x9e620000;
    if (unsigned) { base = 0x9e630000; }
    if (w) {
        base = 0x1e620000;
        if (unsigned) { base = 0x1e630000; }
    }
    return arm64_le32(buf, base | (((rn_gpr & 31) as i64) << 5) | ((rd_fp & 31) as i64));
}

// ============================================================
// PART 2 — GAS-text assembler + data/symbol relocation
// ============================================================

// examples/self_host/arm64_gas.fern — a self-hosted AArch64 GAS-text
// assembler: it parses an assembly-text subset into machine-code bytes via
// the arm64_encode.fern encoders + named-label assembler (Arm64Asm). It is
// the arm64 counterpart of x86_native.fern PART 2 and the text->bytes step that lets
// the arm64-darwin native path turn `asm_arm64`-style assembly into a
// runnable Mach-O (via macho.fern) with no external `as`/`clang`.
//
// This module `import`s nothing but depends on the names defined in
// arm64_encode.fern (the encoders + Arm64Asm), so a build / test
// concatenates the two (plus macho.fern) the same way the x86 gas slices
// concatenate x86_native.fern.
//
// Supported subset (the canonical AArch64 GAS spellings):
//   mov Xd, #imm | mov Xd, Xm | movz/movk Xd, #imm{, lsl #s}
//   add/sub Xd, Xn, #imm | add/sub Xd, Xn, Xm
//   cmp Xn, #imm | cmp Xn, Xm
//   ldr/str Xt, [Xn{, #off}]
//   b/bl <label> | b.<cond> <label> | cbz/cbnz Xt, <label>
//   svc #imm | ret
// Directives: .text (others ignored); `name:` labels; `//` line comments.

// ---- text helpers ----

// ---- portable substring helpers ----
//
// The Go reference checker has no string index_of/contains/starts_with/
// split *methods* (they are self-host-wasm-only builtins; the Go-compiled
// self-host modules avoid them). Since the unified `fern` CLI compiles this
// module through the Go front-end, provide them over the portable surface
// (.len(), s[i], s[a:b], concat, array .append).

function arm64_str_indexof(s: string, sub: string): i32 {
    var n: i32 = s.len();
    var m: i32 = sub.len();
    if (m == 0) { return 0; }
    if (m > n) { return 0 - 1; }
    var i: i32 = 0;
    while (i <= n - m) {
        var j: i32 = 0;
        var ok: boolean = true;
        while (j < m) {
            if (s[i + j] != sub[j]) { ok = false; j = m; }
            else { j = j + 1; }
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function arm64_str_starts_with(s: string, pre: string): boolean {
    var m: i32 = pre.len();
    if (m > s.len()) { return false; }
    var i: i32 = 0;
    while (i < m) {
        if (s[i] != pre[i]) { return false; }
        i = i + 1;
    }
    return true;
}

function arm64_str_contains(s: string, sub: string): boolean {
    return arm64_str_indexof(s, sub) >= 0;
}

function arm64_str_split(s: string, sep: string): string[] {
    var out: string[] = [];
    var m: i32 = sep.len();
    if (m == 0) { out = out.append(s); return out; }
    var n: i32 = s.len();
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= n - m) {
        var hit: boolean = true;
        var j: i32 = 0;
        while (j < m) {
            if (s[i + j] != sep[j]) { hit = false; j = m; }
            else { j = j + 1; }
        }
        if (hit) {
            out = out.append(s[start:i]);
            i = i + m;
            start = i;
        } else {
            i = i + 1;
        }
    }
    out = out.append(s[start:n]);
    return out;
}

// arm64_gas_trim strips leading/trailing ASCII spaces and tabs.
function arm64_gas_trim(s: string): string {
    var i: i32 = 0;
    while (i < s.len() && (s[i] == 32 || s[i] == 9)) {
        i = i + 1;
    }
    var j: i32 = s.len();
    while (j > i && (s[j - 1] == 32 || s[j - 1] == 9)) {
        j = j - 1;
    }
    return s[i:j] + "";
}

// arm64_gas_atoi parses a signed integer token: optional '-', decimal or
// `0x…` hex. Two's-complement wrap gives the right bits for negatives.
function arm64_gas_atoi(tok: string): i32 {
    var s: string = tok;
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == 45) { // '-'
        neg = true;
        i = 1;
    }
    var v: i32 = 0;
    if (i + 1 < s.len() && s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)) { // 0x
        i = i + 2;
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            var d: i32 = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else { if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else { if (c >= 65 && c <= 70) { d = c - 65 + 10; } } }
            if (d >= 0) { v = v * 16 + d; }
            i = i + 1;
        }
    } else {
        while (i < s.len()) {
            var c2: i32 = s[i] as i32;
            if (c2 >= 48 && c2 <= 57) { v = v * 10 + (c2 - 48); }
            i = i + 1;
        }
    }
    if (neg) {
        return 0 - v;
    }
    return v;
}

// arm64_gas_imm parses an immediate operand `#N` (decimal or 0x hex,
// optional '-'); the leading '#' is dropped.
function arm64_gas_imm(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (s.len() > 0 && s[0] == 35) { // '#'
        s = s[1:s.len()] + "";
    }
    return arm64_gas_atoi(s);
}

// arm64_gas_reg parses a register token: x0..x30 / w0..w30 (same number),
// d0..d31 / s0..s31 (FP), plus the aliases sp / lr / xzr / wzr. Returns
// -1 for anything else — a STRICT digit parse, so `x1a` (previously 1 via
// the lenient atoi), an out-of-range `x99`, or an unrecognised token
// (previously x0) can no longer decode to a wrong register and silently
// miscompile (SH-006). The line loop's register-shaped-operand check
// records offenders on p.unknown, so the driver refuses the output before
// a -1 ever reaches an executed encoding.
function arm64_gas_reg(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (s == "sp") { return 31; }
    if (s == "xzr" || s == "wzr") { return 31; }
    if (s == "lr") { return 30; }
    if (s.len() >= 2 && (s[0] == 120 || s[0] == 119 || s[0] == 100 || s[0] == 115)) { // x/w/d/s
        var n: i32 = 0;
        var i: i32 = 1;
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            if (c < 48 || c > 57) { return 0 - 1; }
            n = n * 10 + (c - 48);
            i = i + 1;
        }
        var lim: i32 = 30;
        if (s[0] == 100 || s[0] == 115) { lim = 31; }   // d0..d31 / s0..s31
        if (n > lim) { return 0 - 1; }
        return n;
    }
    return 0 - 1;
}

// arm64_gas_bad_reg_token scans an operand string for a REGISTER-SHAPED
// token that fails the strict decode: a piece (top-level operand, or a
// comma piece inside a `[...]` memory operand) whose first char is
// x/w/d/s followed by a digit must parse as a register — trailing junk
// (`x1a`) or an out-of-range number (`x31`, `d40`) returns that token so
// the caller can record it on p.unknown. Pieces not shaped like registers
// (immediates, labels, shift specs, sysregs) are ignored. Returns "" when
// everything register-shaped decodes.
function arm64_gas_bad_reg_token(rest: string): string {
    var ops: string[] = arm64_gas_operands(rest);
    var i: i32 = 0;
    while (i < ops.len()) {
        var t: string = ops[i];
        if (t.len() > 0 && t[0] == 91) {           // '[' — memory operand
            var rb: i32 = arm64_str_indexof(t, "]");
            if (rb > 1) {
                var inner: string[] = arm64_gas_operands(t[1:rb]);
                var k: i32 = 0;
                while (k < inner.len()) {
                    var it: string = arm64_gas_trim(inner[k]);
                    if (it.len() >= 2 && (it[0] == 120 || it[0] == 119 || it[0] == 100 || it[0] == 115)
                        && it[1] >= 48 && it[1] <= 57 && arm64_gas_reg(it) < 0) { return it; }
                    k = k + 1;
                }
            }
        } else {
            var tt: string = arm64_gas_trim(t);
            if (tt.len() >= 2 && (tt[0] == 120 || tt[0] == 119 || tt[0] == 100 || tt[0] == 115)
                && tt[1] >= 48 && tt[1] <= 57 && arm64_gas_reg(tt) < 0) { return tt; }
        }
        i = i + 1;
    }
    return "";
}

// arm64_gas_cond maps a condition suffix (the `eq` in `b.eq`) to its 4-bit
// code, matching arm64_encode's arm64_eq/ne/ge/lt/gt/le.
function arm64_gas_cond(s: string): i32 {
    if (s == "eq") { return 0; }
    if (s == "ne") { return 1; }
    if (s == "cs" || s == "hs") { return 2; }  // carry set / unsigned >=
    if (s == "cc" || s == "lo") { return 3; }  // carry clear / unsigned <
    if (s == "mi") { return 4; }               // negative
    if (s == "pl") { return 5; }               // non-negative
    if (s == "vs") { return 6; }               // overflow set
    if (s == "vc") { return 7; }               // overflow clear
    if (s == "hi") { return 8; }               // unsigned >
    if (s == "ls") { return 9; }               // unsigned <=
    if (s == "ge") { return 10; }
    if (s == "lt") { return 11; }
    if (s == "gt") { return 12; }
    if (s == "le") { return 13; }
    if (s == "al") { return 14; }              // always
    return 0;
}

// arm64_gas_is_cond reports whether a 2-letter suffix is a condition code
// (so `b<cc>` no-dot aliases like bhi/blt/bne can be told from b/bl/br).
function arm64_gas_is_cond(s: string): boolean {
    return s == "eq" || s == "ne" || s == "cs" || s == "hs" || s == "cc" || s == "lo"
        || s == "mi" || s == "pl" || s == "vs" || s == "vc" || s == "hi" || s == "ls"
        || s == "ge" || s == "lt" || s == "gt" || s == "le" || s == "al";
}

// arm64_gas_is_w reports whether a register token names a 32-bit w-register.
function arm64_gas_is_w(tok: string): boolean {
    var s: string = arm64_gas_trim(tok);
    return s.len() >= 1 && s[0] == 119; // 'w'
}

// arm64_gas_is_d reports whether a register token names a 64-bit FP (d) register.
function arm64_gas_is_d(tok: string): boolean {
    var s: string = arm64_gas_trim(tok);
    return s.len() >= 1 && s[0] == 100; // 'd'
}

// arm64_gas_is_s distinguishes a SINGLE-precision FP register from the
// double-precision `d` and the general-purpose `w`/`x`. Without it the fmov
// dispatch could not tell `fmov s0, w0` from `fmov x0, d0` and encoded the
// latter — the wrong register file at the wrong width, 121 times in one
// float-heavy fixture (#6044).
function arm64_gas_is_s(tok: string): boolean {
    var t: string = arm64_gas_trim(tok);
    return t.len() >= 1 && t[0] == 115; // 's'
}

// arm64_gas_vreg_arr decodes an ARRANGED vector operand (`v0.8b` / `v1.16b`)
// to its register number, or -1. Only the byte arrangements are accepted: the
// cnt/addv encoders set size=00, so a wider element size would assemble as a
// DIFFERENT instruction on the same bytes rather than fail.
function arm64_gas_vreg_arr(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    var dot: i32 = arm64_str_indexof(s, ".");
    if (s.len() < 4 || s[0] != 118 || dot < 2) { return 0 - 1; }  // 'v'
    var n: i32 = 0;
    var i: i32 = 1;
    while (i < dot) {
        var c: i32 = s[i] as i32;
        if (c < 48 || c > 57) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if (n > 31) { return 0 - 1; }
    var arr: string = s[dot:s.len()] + "";
    if (arr == ".8b" || arr == ".16b") { return n; }
    return 0 - 1;
}

// arm64_gas_vreg_arr_q reports the 128-bit (Q) arrangement.
function arm64_gas_vreg_arr_q(tok: string): boolean {
    var s: string = arm64_gas_trim(tok);
    var dot: i32 = arm64_str_indexof(s, ".");
    if (dot < 0) { return false; }
    return (s[dot:s.len()] + "") == ".16b";
}

// arm64_gas_breg decodes a `bN` scalar byte register — the destination shape
// of an `addv` over a byte arrangement — to its number, or -1.
function arm64_gas_breg(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (s.len() < 2 || s[0] != 98) { return 0 - 1; }  // 'b'
    var n: i32 = 0;
    var i: i32 = 1;
    while (i < s.len()) {
        var c: i32 = s[i] as i32;
        if (c < 48 || c > 57) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if (n > 31) { return 0 - 1; }
    return n;
}

// arm64_gas_bad_vec_token guards cnt/addv's SIMD operands the way
// arm64_gas_bad_reg_token guards the general-purpose ones: a shape the byte-
// lane encoders cannot express is returned so the caller records it on
// p.unknown and refuses the output, rather than letting a -1 sentinel fold
// into the register field.
function arm64_gas_bad_vec_token(mnem: string, rest: string): string {
    if (mnem != "cnt" && mnem != "addv") { return ""; }
    var ops: string[] = arm64_gas_operands(rest);
    if (ops.len() != 2) { return mnem + ":arity"; }
    if (arm64_gas_vreg_arr(ops[1]) < 0) { return arm64_gas_trim(ops[1]); }
    if (mnem == "addv") {
        if (arm64_gas_breg(ops[0]) < 0) { return arm64_gas_trim(ops[0]); }
        return "";
    }
    if (arm64_gas_vreg_arr(ops[0]) < 0) { return arm64_gas_trim(ops[0]); }
    if (arm64_gas_vreg_arr_q(ops[0]) != arm64_gas_vreg_arr_q(ops[1])) { return arm64_gas_trim(ops[1]); }
    return "";
}

// arm64_gas_operands splits an operand list on top-level commas, ignoring
// commas inside `[ … ]` (so a memory operand stays one token).
function arm64_gas_operands(rest: string): string[] {
    var out: string[] = [];
    var depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < rest.len()) {
        var c: i32 = rest[i] as i32;
        if (c == 91) { depth = depth + 1; }        // '['
        else if (c == 93) { depth = depth - 1; }   // ']'
        else if (c == 44 && depth == 0) {           // ','
            out = out.append(arm64_gas_trim(rest[start:i]));
            start = i + 1;
        }
        i = i + 1;
    }
    var last: string = arm64_gas_trim(rest[start:rest.len()]);
    if (last.len() > 0) {
        out = out.append(last);
    }
    return out;
}

// Arm64Mem is a parsed `[Xn{, #off}]` memory operand.
struct Arm64Mem {
    base: i32,
    off: i32,
    // Register in the OFFSET position (`[Xn, Xm]`), or -1 when the offset is an
    // immediate. Callers that cannot encode a register offset must refuse the
    // line (arm64_gas_regoff_unsupported records it on p.unknown) rather than
    // fall back to `off`, which is 0 for this shape and would silently encode
    // `[Xn]`.
    off_reg: i32,
}

// arm64_gas_mem parses `[Xn]`, `[Xn, #off]` or `[Xn, Xm]`, tolerating a trailing
// `!` (pre-index writeback marker — detect it separately with
// arm64_gas_has_bang).
//
// The offset position is a REGISTER or an immediate, and the two must be told
// apart: this read `arm64_gas_imm(parts[1])` unconditionally, so `[x0, x1]` came
// back as offset 1 — the digit lifted out of the register name — and assembled
// as `[x0, #1]`. That is #6047, and it was silent, because 1 is a perfectly
// legal immediate. The strict-register work (SH-006) had already established
// that a register token which does not decode must refuse the line rather than
// encode garbage; a register in the wrong POSITION needs the same treatment.
function arm64_gas_mem(op: string): Arm64Mem {
    var s: string = arm64_gas_trim(op);
    var lb: i32 = arm64_str_indexof(s, "[");
    var rb: i32 = arm64_str_indexof(s, "]");
    var inner: string = s;
    if (lb >= 0 && rb > lb) {
        inner = s[lb + 1:rb] + "";
    }
    var parts: string[] = arm64_gas_operands(inner);
    var base: i32 = arm64_gas_reg(parts[0]);
    var off: i32 = 0;
    var off_reg: i32 = 0 - 1;
    if (parts.len() > 1) {
        var p1: string = arm64_gas_trim(parts[1]);
        var r: i32 = arm64_gas_reg(p1);
        if (arm64_str_indexof(p1, "#") < 0 && r >= 0) {
            off_reg = r;
        } else {
            off = arm64_gas_imm(p1);
        }
    }
    return Arm64Mem { base: base, off: off, off_reg: off_reg };
}

// arm64_movwide_hw finds the single nonzero 16-bit chunk of `v` and returns its
// shift (0/16/32/48), or -1 when more than one chunk is set.
//
// GAS accepts `mov x9, #0x10000` and encodes it `movz x9, #1, lsl #16` — the
// immediate names a value, and the assembler picks the chunk. This assembler
// masked the value into imm16 instead, so `mov x9, #0x10000` LOADED ZERO. That
// is 20 sites in one hello-world build, one of them the freelist size-class cap
// (#6060).
function arm64_movwide_hw(v: i64): i32 {
    if (v == 0) { return 0; }
    var sh: i32 = 0;
    var found: i32 = 0 - 1;
    while (sh < 64) {
        var chunk: i64 = (v >> sh) & 0xffff;
        if (chunk != 0) {
            if (found >= 0) { return 0 - 1; }   // more than one chunk: needs movz+movk
            found = sh;
        }
        sh = sh + 16;
    }
    return found;
}

// arm64_gas_movwide_out_of_range reports whether a mov/movz/movn immediate needs
// MORE THAN ONE mov-wide instruction (two or more nonzero 16-bit chunks), which
// this one-instruction-per-line assembler cannot emit. Anything expressible as a
// single chunk plus a shift is encoded, not refused. The emitter builds wider
// constants through the literal pool (`ldr Xt, =N`).
function arm64_gas_movwide_out_of_range(mnem: string, rest: string): boolean {
    if (mnem != "mov" && mnem != "movz" && mnem != "movn") { return false; }
    var ops: string[] = arm64_gas_operands(rest);
    if (ops.len() < 2) { return false; }
    if (ops[1].len() == 0 || ops[1][0] != 35) { return false; }   // register form
    if (ops.len() > 2 && arm64_gas_lsl_amount(ops[2]) != 0) { return false; }  // explicit shift
    var v: i64 = arm64_gas_imm(ops[1]) as i64;
    if (v < 0) { v = (0 - v) - 1; }
    return arm64_movwide_hw(v) < 0;
}

// arm64_gas_regoff_unsupported reports whether `rest` puts a REGISTER in the
// offset position of a memory operand that `mnem`'s encoder cannot express.
// The register-offset forms the assembler implements are the 64-bit
// `ldr/str Xt, [Xn, Xm]` (arm64_ldr_str_reg) and the byte
// `ldrb/strb Wt, [Xn, Xm]` (arm64_ldrb_strb_reg); everything else — ldrh, strh,
// ldrsw, ldur, stur, the FP forms — has only an immediate-offset encoder, and
// must refuse rather than quietly drop the index register.
function arm64_gas_regoff_unsupported(mnem: string, rest: string): boolean {
    if (mnem == "ldr" || mnem == "str" || mnem == "ldrb" || mnem == "strb") { return false; }
    if (mnem != "ldrh" && mnem != "strh" && mnem != "ldrsw" && mnem != "ldur" && mnem != "stur") { return false; }
    var ops: string[] = arm64_gas_operands(rest);
    var i: i32 = 0;
    while (i < ops.len()) {
        if (arm64_str_indexof(ops[i], "[") >= 0 && arm64_gas_mem(ops[i]).off_reg >= 0) { return true; }
        i = i + 1;
    }
    return false;
}

// arm64_gas_has_bang reports whether an operand carries the `!` pre-index
// writeback marker.
function arm64_gas_has_bang(op: string): boolean {
    return arm64_str_indexof(op, "!") >= 0;
}

// arm64_gas_writeback_unsupported reports whether `rest` asks for a `!`
// pre-index WRITEBACK on a mnemonic whose only encoder here is the plain
// unsigned-offset form. `ldr` / `str` / `ldp` / `stp` implement it (that is the
// operand stack's whole idiom); the byte / half-word / sign-extending forms do
// not, and arm64_gas_mem drops the `!` silently — so the base register was left
// UNCHANGED while the emitted code went on to undo a decrement that never
// happened. #6083: `__fern_eprint_str` claimed its newline scratch with
// `strb w1, [sp, #-16]!` and released it with `add sp, sp, #16`, so every
// eprint raised sp by 16 and the next call ran on a corrupted frame — a SEGV
// arbitrarily later, with eprint's own output looking perfectly fine.
function arm64_gas_writeback_unsupported(mnem: string, rest: string): boolean {
    if (mnem != "ldrb" && mnem != "strb" && mnem != "ldrh" && mnem != "strh" && mnem != "ldrsw" && mnem != "ldur" && mnem != "stur") { return false; }
    var ops: string[] = arm64_gas_operands(rest);
    var i: i32 = 0;
    while (i < ops.len()) {
        if (arm64_str_indexof(ops[i], "[") >= 0 && arm64_gas_has_bang(ops[i])) { return true; }
        i = i + 1;
    }
    return false;
}

// arm64_gas_lsl_amount parses a `lsl #N` shift operand (the `lsl #16` of a
// movk); returns 0 if it is not recognised.
function arm64_gas_lsl_amount(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    var h: i32 = arm64_str_indexof(s, "#");
    if (h < 0) {
        return 0;
    }
    return arm64_gas_atoi(arm64_gas_trim(s[h + 1:s.len()]));
}

// arm64_gas_shift_type maps the shift keyword of a `<shift> #N` operand to
// its 2-bit selector, or -1 when the token names no shift.
function arm64_gas_shift_type(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (arm64_str_indexof(s, "lsl") == 0) { return 0; }
    if (arm64_str_indexof(s, "lsr") == 0) { return 1; }
    if (arm64_str_indexof(s, "asr") == 0) { return 2; }
    if (arm64_str_indexof(s, "ror") == 0) { return 3; }
    return 0 - 1;
}

// arm64_gas_extend_option maps the extend keyword of a `<extend> {#N}` operand
// to its 3-bit selector, or -1 when the token names no extend. `sxt` is tested
// before `uxt` only for symmetry; the two prefixes are disjoint.
function arm64_gas_extend_option(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (arm64_str_indexof(s, "uxtb") == 0) { return 0; }
    if (arm64_str_indexof(s, "uxth") == 0) { return 1; }
    if (arm64_str_indexof(s, "uxtw") == 0) { return 2; }
    if (arm64_str_indexof(s, "uxtx") == 0) { return 3; }
    if (arm64_str_indexof(s, "sxtb") == 0) { return 4; }
    if (arm64_str_indexof(s, "sxth") == 0) { return 5; }
    if (arm64_str_indexof(s, "sxtw") == 0) { return 6; }
    if (arm64_str_indexof(s, "sxtx") == 0) { return 7; }
    return 0 - 1;
}

// arm64_gas_addsub_operand_unsupported reports whether an add/sub carries a
// fourth operand this assembler cannot encode. The shifted and extended forms
// below cover what the backend emits; anything else must refuse the line
// rather than drop the operand, which is what made `add x0, x1, x0, lsl #2`
// read element [0] for every index (#6849).
function arm64_gas_addsub_operand_unsupported(mnem: string, rest: string): boolean {
    if (mnem != "add" && mnem != "sub") { return false; }
    var ops: string[] = arm64_gas_operands(rest);
    if (ops.len() < 4) { return false; }
    if (arm64_gas_shift_type(ops[3]) >= 0) { return false; }
    if (arm64_gas_extend_option(ops[3]) >= 0) { return false; }
    return true;
}

// ---- instruction dispatch ----

// arm64_gas_is_bcond reports whether `mnem` is a conditional branch, in
// either GAS spelling: the dotted `b.lt` form or the no-dot `blt` alias.
// arm64_gas_bcond_suffix returns the condition part of such a mnemonic.
function arm64_gas_is_bcond(mnem: string): boolean {
    if (mnem.len() >= 3 && mnem[0] == 98 && mnem[1] == 46) { return true; } // 'b' '.'
    return mnem.len() == 3 && mnem[0] == 98 && arm64_gas_is_cond(mnem[1:3]);
}
function arm64_gas_bcond_suffix(mnem: string): str {
    if (mnem.len() >= 3 && mnem[0] == 98 && mnem[1] == 46) {
        return mnem[2:mnem.len()];
    }
    return mnem[1:3];
}

// arm64_gas_emit assembles one mnemonic + operand string into a.code (or
// queues a label fixup). Unknown mnemonics are ignored.
function arm64_gas_emit(a: Arm64Asm, mnem: string, rest: string): Arm64Asm {
    if (mnem == "ret") {
        a = Arm64Asm { ...a, code: arm64_ret(a.code, arm64_lr()) };
        return a;
    }
    var ops: string[] = arm64_gas_operands(rest);
    if (mnem == "svc") {
        a = Arm64Asm { ...a, code: arm64_svc(a.code, arm64_gas_imm(ops[0])) };
        return a;
    }
    if (mnem == "blr") {
        a = Arm64Asm { ...a, code: arm64_blr(a.code, arm64_gas_reg(ops[0])) };
        return a;
    }
    if (mnem == "mov" || mnem == "movz") {
        var rd: i32 = arm64_gas_reg(ops[0]);
        if (ops[1].len() > 0 && ops[1][0] == 35) { // '#'
            // The `lsl #N` operand is part of the VALUE, not decoration: movk
            // below already parsed it, this path passed 0, and
            // `movz x5, #0x400, lsl #16` therefore loaded 0x400 instead of
            // 0x4000000 (#6060).
            var mvsh: i32 = 0;
            if (ops.len() > 2) { mvsh = arm64_gas_lsl_amount(ops[2]); }
            var mvimm: i32 = arm64_gas_imm(ops[1]);
            // No explicit `lsl`: the immediate names the whole value, so pick the
            // chunk it lives in (GAS does the same). Without this `mov x9,
            // #0x10000` masked to imm16 = 0 and loaded ZERO.
            if (mvsh == 0) {
                var mvmag: i64 = mvimm as i64;
                if (mvmag < 0) { mvmag = (0 - mvmag) - 1; }
                var hw: i32 = arm64_movwide_hw(mvmag);
                if (hw > 0) {
                    mvsh = hw;
                    var shifted: i64 = mvmag >> hw;
                    if (mvimm < 0) { mvimm = 0 - (((shifted as i32)) + 1); } else { mvimm = shifted as i32; }
                }
            }
            if (mvimm < 0) {
                // A negative immediate needs MOVN, which loads the COMPLEMENT:
                // `mov x0, #-100` is `movn x0, #99`. Encoding it as MOVZ of the
                // truncated low half loaded 65436 (#6060). The line loop's
                // range guard has already refused anything whose complement
                // does not fit in imm16.
                a = Arm64Asm { ...a, code: arm64_movn(a.code, rd, (0 - mvimm) - 1, mvsh, arm64_gas_is_w(ops[0])) };
            } else {
                a = Arm64Asm { ...a, code: arm64_movz(a.code, rd, mvimm, mvsh, arm64_gas_is_w(ops[0])) };
            }
        } else if (arm64_gas_trim(ops[0]) == "sp" || arm64_gas_trim(ops[1]) == "sp") {
            // `mov Xd, sp` / `mov sp, Xn` is the `add Xd, Xn, #0` alias
            // (ORR can't name SP).
            a = Arm64Asm { ...a, code: arm64_addimm(a.code, rd, arm64_gas_reg(ops[1]), 0, arm64_gas_is_w(ops[0])) };
        } else {
            a = Arm64Asm { ...a, code: arm64_movreg(a.code, rd, arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        }
        return a;
    }
    if (mnem == "movk") {
        var sh: i32 = 0;
        if (ops.len() > 2) {
            sh = arm64_gas_lsl_amount(ops[2]);
        }
        a = Arm64Asm { ...a, code: arm64_movk(a.code, arm64_gas_reg(ops[0]), arm64_gas_imm(ops[1]), sh) };
        return a;
    }
    // `movn Rd, #imm{, lsl #N}` written out explicitly. arm64_gas_known has
    // always claimed movn was handled, but there was no branch for it: the
    // mnemonic fell through to the end of this function and emitted NOTHING,
    // with nothing recorded on p.unknown either — a silently dropped
    // instruction. The emitter only reaches MOVN through `mov Rd, #-imm`
    // today, which is why it went unnoticed.
    if (mnem == "movn") {
        var nsh: i32 = 0;
        if (ops.len() > 2) {
            nsh = arm64_gas_lsl_amount(ops[2]);
        }
        a = Arm64Asm { ...a, code: arm64_movn(a.code, arm64_gas_reg(ops[0]), arm64_gas_imm(ops[1]), nsh, arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "add" || mnem == "sub") {
        var is_sub: boolean = (mnem == "sub");
        var ad: i32 = arm64_gas_reg(ops[0]);
        var an: i32 = arm64_gas_reg(ops[1]);
        if (ops[2].len() > 0 && ops[2][0] == 35) {
            if (is_sub) {
                a = Arm64Asm { ...a, code: arm64_subimm(a.code, ad, an, arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
            } else {
                a = Arm64Asm { ...a, code: arm64_addimm(a.code, ad, an, arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
            }
            return a;
        }
        var am: i32 = arm64_gas_reg(ops[2]);
        // A fourth operand is a shift or an extend applied to Xm, and it is
        // part of the VALUE: `add Xd, Xn, Xm, lsl #2` scales an array index by
        // the element size. arm64_gas_addsub_operand_unsupported refuses any
        // other spelling, so nothing reaches here silently unshifted.
        if (ops.len() >= 4) {
            var ext: i32 = arm64_gas_extend_option(ops[3]);
            if (ext >= 0) {
                a = Arm64Asm { ...a, code: arm64_addsub_ext(a.code, is_sub, ad, an, am, ext, arm64_gas_lsl_amount(ops[3])) };
                return a;
            }
            a = Arm64Asm { ...a, code: arm64_addsubreg_shift(a.code, is_sub, ad, an, am,
                arm64_gas_shift_type(ops[3]), arm64_gas_lsl_amount(ops[3]), arm64_gas_is_w(ops[0])) };
            return a;
        }
        if (arm64_gas_trim(ops[1]) == "sp") {
            a = Arm64Asm { ...a, code: arm64_addsub_ext_sp(a.code, is_sub, ad, an, am) };
        } else if (is_sub) {
            a = Arm64Asm { ...a, code: arm64_subreg(a.code, ad, an, am) };
        } else {
            a = Arm64Asm { ...a, code: arm64_addreg(a.code, ad, an, am) };
        }
        return a;
    }
    if (mnem == "cmp") {
        var cn: i32 = arm64_gas_reg(ops[0]);
        if (ops[1].len() > 0 && ops[1][0] == 35) {
            a = Arm64Asm { ...a, code: arm64_cmpimm(a.code, cn, arm64_gas_imm(ops[1]), arm64_gas_is_w(ops[0])) };
        } else {
            a = Arm64Asm { ...a, code: arm64_cmpreg(a.code, cn, arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        }
        return a;
    }
    if (mnem == "ldr" || mnem == "str") {
        var rt: i32 = arm64_gas_reg(ops[0]);
        // SIMD&FP `ldr/str Dt, [Xn{, #off}]` — d-register dest (the f64
        // constant-load path). Scalar [Xn] / [Xn, #off] only.
        if (ops[0].len() > 0 && ops[0][0] == 100) { // 'd'
            // Post-index `ldr Dt, [Xn], #off` arrives as three operands, exactly
            // like the GP form below.
            if (ops.len() >= 3) {
                var fpb: i32 = arm64_gas_mem(ops[1]).base;
                var fpo: i32 = arm64_gas_imm(ops[2]);
                if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldr_fp_post(a.code, rt, fpb, fpo) }; }
                return Arm64Asm { ...a, code: arm64_str_fp_pre(a.code, rt, fpb, fpo) };
            }
            var fm: Arm64Mem = arm64_gas_mem(ops[1]);
            if (arm64_gas_has_bang(ops[1])) {
                // pre-index with writeback `[Xn, #off]!`
                if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldur_fp(a.code, rt, fm.base, fm.off) }; }
                return Arm64Asm { ...a, code: arm64_str_fp_pre(a.code, rt, fm.base, fm.off) };
            }
            // A negative offset cannot use the scaled unsigned form (it wrapped
            // to a large POSITIVE offset); use the unscaled signed imm9.
            if (fm.off < 0 || (fm.off & 7) != 0) {
                if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldur_fp(a.code, rt, fm.base, fm.off) }; }
                return Arm64Asm { ...a, code: arm64_stur_fp(a.code, rt, fm.base, fm.off) };
            }
            if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldr_fp(a.code, rt, fm.base, fm.off) }; }
            return Arm64Asm { ...a, code: arm64_str_fp(a.code, rt, fm.base, fm.off) };
        }
        if (ops.len() >= 3) {
            // post-index: `ldr Xt, [Xn], #off` (ops[1]="[Xn]", ops[2]="#off")
            var pb: i32 = arm64_gas_mem(ops[1]).base;
            var po: i32 = arm64_gas_imm(ops[2]);
            if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldr_post(a.code, rt, pb, po) }; }
            return Arm64Asm { ...a, code: arm64_str_post(a.code, rt, pb, po) };
        }
        // register-offset form `[Xn, Xm{, lsl #3}]` (array indexing): the
        // bracket has a second *register* operand. Detect it before the
        // scalar [Xn, #imm] path.
        var lb0: i32 = arm64_str_indexof(ops[1], "[");
        var rb0: i32 = arm64_str_indexof(ops[1], "]");
        if (lb0 >= 0 && rb0 > lb0) {
            var mparts: string[] = arm64_gas_operands(ops[1][lb0 + 1:rb0]);
            if (mparts.len() >= 2 && mparts[1].len() > 0 && (mparts[1][0] == 120 || mparts[1][0] == 119)) { // 'x'/'w'
                var shifted: boolean = (mparts.len() >= 3 && arm64_str_indexof(mparts[2], "lsl") >= 0);
                return Arm64Asm { ...a, code: arm64_ldr_str_reg(a.code, mnem == "ldr", rt, arm64_gas_reg(mparts[0]), arm64_gas_reg(mparts[1]), shifted) };
            }
        }
        var m: Arm64Mem = arm64_gas_mem(ops[1]);
        if (arm64_gas_has_bang(ops[1])) {
            // pre-index writeback: `[Xn, #off]!`
            if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldr_pre(a.code, rt, m.base, m.off) }; }
            return Arm64Asm { ...a, code: arm64_str_pre(a.code, rt, m.base, m.off) };
        }
        // A negative or misaligned offset can't use the scaled unsigned form
        // (imm12 is unsigned, scaled by the ACCESS SIZE); fall back to the
        // unscaled signed-imm9 ldur/stur, exactly as GAS does. asm_arm64 stores
        // frame locals at `[x29, #-N]`, so this is the common case.
        //
        // The alignment the scaled form requires is the access width, so a
        // 32-bit load/store needs 4, not 8 — `ldr w3, [x4, #4]` is a legal
        // scaled encoding. Testing 8 unconditionally sent every 4-aligned W
        // access down the unscaled path: correct code, but not the encoding GAS
        // picks, which the encoding differential reports as a divergence.
        var align: i32 = 7;
        if (arm64_gas_is_w(ops[0])) { align = 3; }
        if (m.off < 0 || (m.off & align) != 0) {
            if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldur(a.code, rt, m.base, m.off, arm64_gas_is_w(ops[0])) }; }
            return Arm64Asm { ...a, code: arm64_stur(a.code, rt, m.base, m.off, arm64_gas_is_w(ops[0])) };
        }
        if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldr(a.code, rt, m.base, m.off, arm64_gas_is_w(ops[0])) }; }
        return Arm64Asm { ...a, code: arm64_str(a.code, rt, m.base, m.off, arm64_gas_is_w(ops[0])) };
    }
    if (mnem == "stp") {
        var sm: Arm64Mem = arm64_gas_mem(ops[2]);
        if (arm64_gas_has_bang(ops[2])) {
            // prologue form: `stp Xt, Xt2, [Xn, #off]!` (pre-index writeback)
            a = Arm64Asm { ...a, code: arm64_stp_pre(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), sm.base, sm.off) };
        } else {
            // large-frame form: `stp Xt, Xt2, [Xn, #off]` (signed offset, no writeback)
            a = Arm64Asm { ...a, code: arm64_stp_off(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), sm.base, sm.off) };
        }
        return a;
    }
    if (mnem == "ldp") {
        if (ops.len() >= 4) {
            // epilogue form: `ldp Xt, Xt2, [Xn], #off` (post-index)
            var lb: i32 = arm64_gas_mem(ops[2]).base;
            var lo: i32 = arm64_gas_imm(ops[3]);
            a = Arm64Asm { ...a, code: arm64_ldp_post(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), lb, lo) };
        } else {
            // large-frame form: `ldp Xt, Xt2, [Xn, #off]` (signed offset, no writeback)
            var lm: Arm64Mem = arm64_gas_mem(ops[2]);
            a = Arm64Asm { ...a, code: arm64_ldp_off(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), lm.base, lm.off) };
        }
        return a;
    }
    if (mnem == "neg") {
        a = Arm64Asm { ...a, code: arm64_neg(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) };
        return a;
    }
    if (mnem == "ubfx") {
        a = Arm64Asm { ...a, code: arm64_ubfx(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_imm(ops[3])) };
        return a;
    }
    if (mnem == "sxtw") {
        a = Arm64Asm { ...a, code: arm64_sxtw(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) };
        return a;
    }
    if (mnem == "sbfiz") {
        a = Arm64Asm { ...a, code: arm64_sbfiz(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_imm(ops[3])) };
        return a;
    }
    if (mnem == "mul") {
        a = Arm64Asm { ...a, code: arm64_mul(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2])) };
        return a;
    }
    if (mnem == "ldur") {
        var um: Arm64Mem = arm64_gas_mem(ops[1]);
        // A d-register destination is SIMD&FP, a different opcode space (V=1).
        // The explicit ldur/stur spelling used to fall straight through to the
        // GP encoder, so `stur d1, [x2, #-16]` assembled as the integer STUR of
        // x1 — the right shape, the wrong register file, silently. The
        // ldr/str spelling above already routed d-registers correctly; only
        // this pair did not, which is why the differential caught it the moment
        // #6075 taught the oracle these forms.
        if (arm64_gas_is_d(ops[0])) {
            a = Arm64Asm { ...a, code: arm64_ldur_fp(a.code, arm64_gas_reg(ops[0]), um.base, um.off) };
            return a;
        }
        a = Arm64Asm { ...a, code: arm64_ldur(a.code, arm64_gas_reg(ops[0]), um.base, um.off, arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "stur") {
        var sm2: Arm64Mem = arm64_gas_mem(ops[1]);
        if (arm64_gas_is_d(ops[0])) {
            a = Arm64Asm { ...a, code: arm64_stur_fp(a.code, arm64_gas_reg(ops[0]), sm2.base, sm2.off) };
            return a;
        }
        a = Arm64Asm { ...a, code: arm64_stur(a.code, arm64_gas_reg(ops[0]), sm2.base, sm2.off, arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "cset") {
        a = Arm64Asm { ...a, code: arm64_cset(a.code, arm64_gas_reg(ops[0]), arm64_gas_cond(ops[1]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "lsl") {
        if (ops[2].len() > 0 && ops[2][0] == 35) { // '#' → immediate form
            a = Arm64Asm { ...a, code: arm64_lsl_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
        } else { // register form → LSLV
            a = Arm64Asm { ...a, code: arm64_lslv(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_w(ops[0])) };
        }
        return a;
    }
    if (mnem == "lsr") {
        if (ops[2].len() > 0 && ops[2][0] == 35) { // '#' → immediate form
            a = Arm64Asm { ...a, code: arm64_lsr_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
        } else { // register form → LSRV
            a = Arm64Asm { ...a, code: arm64_lsrv(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_w(ops[0])) };
        }
        return a;
    }
    if (mnem == "asr") {
        // Same immediate/register split as lsl and lsr above. The emitter only
        // produces the register (ASRV) form today, but the immediate one used to
        // fall through to it and encode a shift by xzr — i.e. by ZERO.
        if (ops[2].len() > 0 && ops[2][0] == 35) { // '#' → immediate form (SBFM)
            a = Arm64Asm { ...a, code: arm64_asr_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
        } else {
            a = Arm64Asm { ...a, code: arm64_asrv(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_w(ops[0])) };
        }
        return a;
    }
    if (mnem == "cmn") {
        a = Arm64Asm { ...a, code: arm64_cmn_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_imm(ops[1])) };
        return a;
    }
    if (mnem == "csel") {
        a = Arm64Asm { ...a, code: arm64_csel(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_cond(ops[3])) };
        return a;
    }
    if (mnem == "and") {
        // register form only here; `and Xd, Xn, #imm` is handled in the
        // program loop (it needs the unknown-immediate guard).
        a = Arm64Asm { ...a, code: arm64_andreg(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "orr") {
        a = Arm64Asm { ...a, code: arm64_orr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2])) };
        return a;
    }
    if (mnem == "eor") {
        // register form only here; `eor Xd, Xn, #imm` is handled in the
        // program loop (it needs the bitmask-immediate guard).
        a = Arm64Asm { ...a, code: arm64_eor(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "subs") {
        if (ops[2].len() > 0 && ops[2][0] == 35) { // '#'
            a = Arm64Asm { ...a, code: arm64_subsimm(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2])) };
        } else {
            a = Arm64Asm { ...a, code: arm64_subsreg(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2])) };
        }
        return a;
    }
    if (mnem == "udiv") {
        a = Arm64Asm { ...a, code: arm64_udiv(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2])) };
        return a;
    }
    if (mnem == "sdiv") {
        a = Arm64Asm { ...a, code: arm64_sdiv(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2])) };
        return a;
    }
    if (mnem == "msub") {
        a = Arm64Asm { ...a, code: arm64_msub(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_reg(ops[3])) };
        return a;
    }
    if (mnem == "rev16") {
        a = Arm64Asm { ...a, code: arm64_rev16(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "clz") {
        a = Arm64Asm { ...a, code: arm64_clz(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "rbit") {
        a = Arm64Asm { ...a, code: arm64_rbit(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "cnt") {
        a = Arm64Asm { ...a, code: arm64_cnt(a.code, arm64_gas_vreg_arr(ops[0]), arm64_gas_vreg_arr(ops[1]), arm64_gas_vreg_arr_q(ops[0])) };
        return a;
    }
    if (mnem == "addv") {
        a = Arm64Asm { ...a, code: arm64_addv(a.code, arm64_gas_breg(ops[0]), arm64_gas_vreg_arr(ops[1]), arm64_gas_vreg_arr_q(ops[1])) };
        return a;
    }
    if (mnem == "ldrb" || mnem == "strb" || mnem == "ldrh" || mnem == "strh" || mnem == "ldrsw") {
        // post-index `ldrb/strb Wt, [Xn], #imm` (the byte-copy loop): 3
        // operands, ops[1]="[Xn]", ops[2]="#imm".
        if ((mnem == "ldrb" || mnem == "strb") && ops.len() >= 3) {
            var pbb: i32 = arm64_gas_mem(ops[1]).base;
            var poo: i32 = arm64_gas_imm(ops[2]);
            if (mnem == "ldrb") { return Arm64Asm { ...a, code: arm64_ldrb_post(a.code, arm64_gas_reg(ops[0]), pbb, poo) }; }
            return Arm64Asm { ...a, code: arm64_strb_post(a.code, arm64_gas_reg(ops[0]), pbb, poo) };
        }
        var bm: Arm64Mem = arm64_gas_mem(ops[1]);
        // `ldrb/strb Wt, [Xn, Xm]` — base + index, what every string-copy loop
        // emits. #6047: this fell through to the immediate encoder below with
        // bm.off carrying the digit from the index register's NAME.
        if (bm.off_reg >= 0 && (mnem == "ldrb" || mnem == "strb")) {
            return Arm64Asm { ...a, code: arm64_ldrb_strb_reg(a.code, mnem == "ldrb", arm64_gas_reg(ops[0]), bm.base, bm.off_reg) };
        }
        if (mnem == "ldrb") { a = Arm64Asm { ...a, code: arm64_ldrb(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off) }; }
        else if (mnem == "strb") { a = Arm64Asm { ...a, code: arm64_strb(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off) }; }
        else if (mnem == "ldrh") { a = Arm64Asm { ...a, code: arm64_ldrh(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off) }; }
        else if (mnem == "strh") { a = Arm64Asm { ...a, code: arm64_strh(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off) }; }
        else { a = Arm64Asm { ...a, code: arm64_ldrsw(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off) }; }
        return a;
    }
    if (mnem == "fadd" || mnem == "fsub" || mnem == "fmul" || mnem == "fdiv") {
        var fd: i32 = arm64_gas_reg(ops[0]);
        var fn: i32 = arm64_gas_reg(ops[1]);
        var fm: i32 = arm64_gas_reg(ops[2]);
        if (mnem == "fadd") { a = Arm64Asm { ...a, code: arm64_fadd(a.code, fd, fn, fm) }; }
        else if (mnem == "fsub") { a = Arm64Asm { ...a, code: arm64_fsub(a.code, fd, fn, fm) }; }
        else if (mnem == "fmul") { a = Arm64Asm { ...a, code: arm64_fmul(a.code, fd, fn, fm) }; }
        else { a = Arm64Asm { ...a, code: arm64_fdiv(a.code, fd, fn, fm) }; }
        return a;
    }
    if (arm64_funary_d_base(mnem) >= 0) {
        a = Arm64Asm { ...a, code: arm64_funary_d(a.code, arm64_funary_d_base(mnem), arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) };
        return a;
    }
    if (mnem == "fcmp") {
        a = Arm64Asm { ...a, code: arm64_fcmp(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) };
        return a;
    }
    if (mnem == "fcvtzs" || mnem == "fcvtzu") { // Xd/Wd, Dn (double -> int)
        a = Arm64Asm { ...a, code: arm64_fcvtz_int(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0]), mnem == "fcvtzu") };
        return a;
    }
    if (mnem == "fcvt") { // Sd, Dn (narrow) or Dd, Sn (widen)
        if (arm64_gas_is_d(ops[0])) {
            a = Arm64Asm { ...a, code: arm64_fcvt_d_s(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) };
        } else {
            a = Arm64Asm { ...a, code: arm64_fcvt_s_d(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) };
        }
        return a;
    }
    if (mnem == "scvtf" || mnem == "ucvtf") { // Dd, Xn/Wn (int -> double)
        a = Arm64Asm { ...a, code: arm64_cvtf(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[1]), mnem == "ucvtf") };
        return a;
    }
    if (mnem == "fmov") {
        var d0: boolean = arm64_gas_is_d(ops[0]);
        var d1: boolean = arm64_gas_is_d(ops[1]);
        // Single-precision first: `fmov Sd, Wn` / `fmov Wd, Sn` are neither
        // d-registers, so they used to fall into the `Xd, Dn` arm below and
        // encode a 64-bit fp->gpr move instead (#6044).
        if (arm64_gas_is_s(ops[0])) { return Arm64Asm { ...a, code: arm64_fmov_s_from_gpr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) }; }
        if (arm64_gas_is_s(ops[1])) { return Arm64Asm { ...a, code: arm64_fmov_s_to_gpr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) }; }
        if (d0 && d1) { a = Arm64Asm { ...a, code: arm64_fmov_dd(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) }; }
        else if (d0) { a = Arm64Asm { ...a, code: arm64_fmov_from_gpr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) }; } // Dd, Xn
        else { a = Arm64Asm { ...a, code: arm64_fmov_to_gpr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) }; } // Xd, Dn
        return a;
    }
    return a; // unknown mnemonic — ignored
}

// ============================================================
// data section + named-symbol (@PAGE/@PAGEOFF) relocation
// ============================================================
//
// Arm64GasProg extends the text assembler (Arm64Asm) with a `__DATA`/
// `__const` blob, a data-symbol table (name -> offset within the blob),
// and a queue of page fixups: adrp `sym@PAGE` and ldr/add `sym@PAGEOFF`
// references whose immediates can only be resolved once the final segment
// addresses are known (macho.fern lays __TEXT and __DATA at separate
// page-aligned vaddrs). arm64_gas_program parses; arm64_gas_link patches.

pub struct Arm64GasProg {
    asm: Arm64Asm,
    data: i32[],
    dlab_names: string[],
    dlab_offs: i32[],
    pf_sites: i32[],    // byte offset of the instruction to patch in .text
    pf_syms: string[],  // target data symbol
    pf_kinds: i32[],    // 0 = adrp@PAGE, 1 = ldr@PAGEOFF, 2 = add@PAGEOFF
    lit_sites: i32[],   // byte offset of a pending `ldr Xd, =N` (LDR-literal) to patch
    lit_vals: i64[],    // the value each pending literal loads
    // Data-word relocations: a `.quad <symbol>` inside a data section, i.e. a
    // data word holding another symbol's ABSOLUTE address. dref_offs[i] is the
    // byte offset of the 8-byte slot within `data`, dref_syms[i] the target.
    // Without these a symbolic `.quad` operand ran through arm64_gas_atoi64 and
    // assembled to ZERO (#6149) — silently, so a static struct constant's shape
    // pointer came out null and every `match` on it fell through.
    dref_offs: i32[],
    dref_syms: string[],
    bss_size: i32,      // total zero-init .bss bytes (ELF memsz beyond filesz; e.g. the heap)
    bss_names: string[],// .bss symbol names
    bss_offs: i32[],    // each .bss symbol's offset within the bss region
    unknown: string[],  // mnemonics the assembler did not recognise
}

function arm64_gas_prog_new(): Arm64GasProg {
    return Arm64GasProg {
        asm: arm64_asm_new(), data: [],
        dlab_names: [], dlab_offs: [],
        pf_sites: [], pf_syms: [], pf_kinds: [],
        lit_sites: [], lit_vals: [],
        dref_offs: [], dref_syms: [],
        bss_size: 0, bss_names: [], bss_offs: [],
        unknown: [],
    };
}

// arm64_gas_known reports whether a mnemonic is handled by the assembler
// (so the program loop can record anything silently dropped). adrp / and
// the @PAGEOFF forms of ldr / add are handled in the program loop itself.
function arm64_gas_known(mnem: string): boolean {
    if (mnem == "mov" || mnem == "movz" || mnem == "movk" || mnem == "movn") { return true; }
    if (mnem == "add" || mnem == "sub" || mnem == "cmp" || mnem == "neg" || mnem == "mul") { return true; }
    if (mnem == "ldr" || mnem == "str" || mnem == "ldur" || mnem == "stur") { return true; }
    if (mnem == "stp" || mnem == "ldp") { return true; }
    if (mnem == "b" || mnem == "bl" || mnem == "blr" || mnem == "ret" || mnem == "svc") { return true; }
    if (mnem == "cbz" || mnem == "cbnz" || mnem == "tbz" || mnem == "tbnz") { return true; }
    if (mnem == "ubfx" || mnem == "cset" || mnem == "adrp" || mnem == "sxtw" || mnem == "sbfiz") { return true; }
    if (mnem == "lsl" || mnem == "lsr" || mnem == "asr" || mnem == "cmn" || mnem == "csel" || mnem == "and") { return true; }
    if (mnem == "orr" || mnem == "eor" || mnem == "subs" || mnem == "udiv" || mnem == "sdiv" || mnem == "msub" || mnem == "rev16" || mnem == "clz") { return true; }
    if (mnem == "rbit" || mnem == "cnt" || mnem == "addv") { return true; }  // ctz = rbit+clz; popcount = cnt+addv
    if (mnem == "ldrb" || mnem == "strb" || mnem == "ldrh" || mnem == "strh" || mnem == "ldrsw") { return true; }
    if (mnem == "mrs") { return true; } // sysreg validity checked in the program loop
    if (mnem == "fadd" || mnem == "fsub" || mnem == "fmul" || mnem == "fdiv" || mnem == "fcmp" || mnem == "fmov" || mnem == "fcvtzs" || mnem == "fcvtzu" || mnem == "scvtf" || mnem == "ucvtf") { return true; }
    // This list and the dispatch in arm64_gas_emit must agree, and they have
    // drifted in BOTH directions: movn was listed here with no branch to
    // assemble it (silently emitted nothing, #6060), while the unary FP family
    // below had a branch and encoders but was missing from this list — so the
    // program loop refused instructions the assembler could already encode
    // perfectly (#6044). Add to both places, or to neither.
    if (mnem == "fcvt" || mnem == "fneg" || mnem == "fabs" || mnem == "fsqrt") { return true; }
    if (mnem == "frinta" || mnem == "frintm" || mnem == "frintp" || mnem == "frintz" || mnem == "frintn") { return true; }
    if (arm64_funary_d_base(mnem) >= 0) { return true; }
    if (mnem.len() >= 3 && mnem[0] == 98 && mnem[1] == 46) { return true; } // b.<cond>
    if (mnem.len() == 3 && mnem[0] == 98 && arm64_gas_is_cond(mnem[1:3])) { return true; } // b<cond>
    return false;
}

// arm64_gas_atoi64 is arm64_gas_atoi with a 64-bit accumulator, for the
// operands that are genuinely 64 bits wide: a `.quad` and a literal-pool `ldr
// Xt, =N`. Both used to parse through the i32 version and then widen, so every
// constant that did not fit 32 bits arrived WRAPPED — `ldr x0, =1234567890123`
// loaded 1912767691. That is why the arm64 leg failed i64_max_to_string,
// to_string_round_trip, divmod_inline and the u64 half of int_byte_swap while
// their u32/i32 siblings in the same fixture passed: the emitter routes
// anything wider than a mov-wide immediate through the literal pool, so the
// truncation tracked the CONSTANT's width, not the operation's.
// arm64_gas_numeric_tok reports whether a data-directive operand is a NUMBER
// rather than a symbol reference. Decimal, signed decimal and hex all begin
// with a digit or a sign; every symbol this assembler sees begins with `.`
// (a local label like `.S0` / `.K0`) or with a letter / underscore (a global
// like `__fern_shp_Foo`). Needed because arm64_gas_atoi64 answers 0 for both a
// real zero and an unparseable symbol, so the value alone cannot tell them
// apart — which is exactly how `.quad .S0` came out null.
function arm64_gas_numeric_tok(tok: string): boolean {
    if (tok.len() == 0) { return false; }
    var c: i32 = tok[0] as i32;
    if (c == 45 || c == 43) { return true; }        // '-' / '+'
    return c >= 48 && c <= 57;                       // '0'..'9'
}

function arm64_gas_atoi64(tok: string): i64 {
    var s: string = tok;
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == 45) { // '-'
        neg = true;
        i = 1;
    }
    var v: i64 = 0;
    if (i + 1 < s.len() && s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)) { // 0x
        i = i + 2;
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            var d: i32 = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else { if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else { if (c >= 65 && c <= 70) { d = c - 65 + 10; } } }
            if (d >= 0) { v = v * 16 + (d as i64); }
            i = i + 1;
        }
    } else {
        while (i < s.len()) {
            var c2: i32 = s[i] as i32;
            if (c2 >= 48 && c2 <= 57) { v = v * 10 + ((c2 - 48) as i64); }
            i = i + 1;
        }
    }
    if (neg) {
        return 0 - v;
    }
    return v;
}

// ---- GAS numeric local labels (`1:` … `b.lo 1f`) ----
//
// The arm64 emitter writes every bounds check as
//   cmp x1, x2 / b.lo 1f / b __fern_oob_abort / 1: …
// which is GAS's numeric local label: `1:` may be defined any number of times,
// and `1f` / `1b` name the NEXT / PREVIOUS definition rather than a unique
// symbol. This assembler had no notion of them. `1:` was recorded as a label
// literally named "1", so arm64_asm_label_off returned the FIRST definition in
// the program for all of them; `1f` was looked up verbatim and matched nothing,
// coming back as the -1 "not placed" sentinel, which arm64_asm_resolve then
// patched as if it were an offset. Every array index and string slice therefore
// branched to `-1 - here` — a word inside the ELF header, which is zero, which
// is UDF #0. That is #6045: 129 of 317 corpus fixtures died on SIGILL before
// printing a byte, and the survivors were the programs that never indexed
// anything.
//
// Definitions are renamed `<n>#<k>`, k counting definitions of n so far. `#`
// opens an immediate in GAS, so no real symbol can collide with the mangled
// name. A reference resolves against the same counter — `<n>f` is definition k
// (not yet placed, so it queues a forward fixup), `<n>b` is definition k-1.
function arm64_gas_is_digits(s: string): boolean {
    if (s.len() == 0) {
        return false;
    }
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i] < 48 || s[i] > 57) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// arm64_gas_numref_dir returns 1 for a forward numeric reference (`1f`), 0 for
// a backward one (`1b`), and -1 when the token is an ordinary symbol.
function arm64_gas_numref_dir(s: string): i32 {
    if (s.len() < 2) {
        return 0 - 1;
    }
    var last: i32 = s[s.len() - 1] as i32;
    if (last != 102 && last != 98) { // 'f' / 'b'
        return 0 - 1;
    }
    if (!arm64_gas_is_digits(s[0:s.len() - 1] + "")) {
        return 0 - 1;
    }
    if (last == 102) {
        return 1;
    }
    return 0;
}

// arm64_gas_dec renders a non-negative i32 in decimal. The module is
// deliberately import-free (the native emitter imports it), so it carries its
// own rather than reaching for core/int.
function arm64_gas_dec(n: i32): string {
    if (n <= 0) {
        return "0";
    }
    var out: string = "";
    var v: i32 = n;
    while (v > 0) {
        var d: i32 = v % 10;
        out = ("0123456789"[d:d + 1] + "") + out;
        v = v / 10;
    }
    return out;
}

// arm64_gas_nl_name is the mangled name of definition `k` of numeric label `n`.
// Both the definition and reference sides go through it, so a padded spelling
// (`01:` against `1f`) cannot split them into two symbols.
function arm64_gas_nl_name(n: i32, k: i32): string {
    return arm64_gas_dec(n) + "#" + arm64_gas_dec(k);
}

// arm64_gas_nl_grow widens the per-number definition counter table so index `n`
// is addressable.
function arm64_gas_nl_grow(c: i32[], n: i32): i32[] {
    var out: i32[] = c;
    while (out.len() <= n) {
        out = out.append(0);
    }
    return out;
}

// arm64_gas_nl_ref maps a branch's label operand through the numeric-local
// rules, leaving an ordinary symbol untouched.
function arm64_gas_nl_ref(cnt: i32[], tok: string): string {
    var s: string = arm64_gas_trim(tok);
    var dir: i32 = arm64_gas_numref_dir(s);
    if (dir < 0) {
        return s;
    }
    var n: i32 = arm64_gas_atoi(s[0:s.len() - 1] + "");
    var k: i32 = 0;
    if (n < cnt.len()) {
        k = cnt[n];
    }
    if (dir == 0) {
        k = k - 1; // `<n>b` — the most recent definition, already placed
        if (k < 0) {
            // `1b` with no `1:` anywhere before it. GAS rejects that outright,
            // and so must this: naming definition 0 would aim the branch at a
            // label defined LATER in the file, which is a silently wrong target
            // of exactly the kind the rest of this change exists to stop. The
            // name below cannot be produced by arm64_gas_nl_name, so it is
            // never placed and the fixup pass refuses it.
            return arm64_gas_dec(n) + "#none";
        }
    }
    return arm64_gas_nl_name(n, k);
}

// arm64_gas_dlabel_off returns the data-blob offset of a data symbol, or
// -1 if it is not defined.
function arm64_gas_dlabel_off(p: Arm64GasProg, name: string): i32 {
    var i: i32 = 0;
    while (i < p.dlab_names.len()) {
        if (p.dlab_names[i] == name) {
            return p.dlab_offs[i];
        }
        i = i + 1;
    }
    return 0 - 1;
}

// arm64_gas_strip_at returns the symbol portion of a `sym@PAGE` /
// `sym@PAGEOFF` operand (everything before the '@'), trimmed.
function arm64_gas_strip_at(tok: string): string {
    var s: string = arm64_gas_trim(tok);
    var at: i32 = arm64_str_indexof(s, "@");
    if (at >= 0) {
        s = s[0:at] + "";
    }
    return arm64_gas_trim(s);
}

// arm64_gas_strip_lo12 returns the symbol portion of a `:lo12:sym` operand
// (the Linux/ELF low-12-bits relocation, the GAS spelling of darwin's
// `sym@PAGEOFF`). Everything after `:lo12:`, trimmed.
function arm64_gas_strip_lo12(tok: string): string {
    var s: string = arm64_gas_trim(tok);
    var at: i32 = arm64_str_indexof(s, ":lo12:");
    if (at >= 0) {
        s = s[at + 6 : s.len()] + "";
    }
    return arm64_gas_trim(s);
}

// arm64_gas_data_le appends `n` little-endian bytes of `v` to the data blob.
function arm64_gas_data_le(own p: Arm64GasProg, v: i64, n: i32): Arm64GasProg {
    var i: i32 = 0;
    while (i < n) {
        p = Arm64GasProg { ...p, data: p.data.append(((v >> (i * 8)) & 255) as i32) };
        i = i + 1;
    }
    return p;
}

// arm64_gas_data_asciz appends a `.asciz "…"` string + NUL to the data
// blob, decoding the common \n \t \0 \\ escapes.
function arm64_gas_data_asciz(own p: Arm64GasProg, line: string): Arm64GasProg {
    var q1: i32 = arm64_str_indexof(line, "\"");
    if (q1 < 0) {
        p = Arm64GasProg { ...p, data: p.data.append(0) };
        return p;
    }
    var i: i32 = q1 + 1;
    while (i < line.len() && line[i] != 34) { // until closing '"'
        var c: i32 = line[i] as i32;
        if (c == 92 && i + 1 < line.len()) { // '\'
            var e: i32 = line[i + 1] as i32;
            if (e == 110) { c = 10; }       // \n
            else if (e == 116) { c = 9; }   // \t
            else if (e == 48) { c = 0; }    // \0
            else { c = e; }                 // \\ , \"
            i = i + 1;
        }
        p = Arm64GasProg { ...p, data: p.data.append(c) };
        i = i + 1;
    }
    p = Arm64GasProg { ...p, data: p.data.append(0) }; // .asciz NUL terminator
    return p;
}

// arm64_gas_strip_comment removes a `//` line comment, but only where the `//`
// is OUTSIDE a double-quoted string. The old unconditional
// `indexof(raw, "//")` truncated any line whose STRING CONTENT contained `//`,
// and the emitter escapes `"` / `\` / control bytes but not `/` — so
// `.ascii "http://h.com"` became `.ascii "http:`, silently shortening that
// literal and shifting every constant after it in .rodata. #6082: a program
// slicing a URL read whatever landed at the shifted offset, which is why the
// symptom presented as unrelated string constants spliced together. Escapes are
// honoured (`\"` does not close the string) so an escaped quote cannot desync
// the scan. Only arm64 has this class of bug: `//` is a line comment in the
// aarch64 GAS dialect, and this parser is the only assembler on that path.
function arm64_gas_strip_comment(raw: string): string {
    var n: i32 = raw.len();
    var i: i32 = 0;
    var inq: boolean = false;
    while (i < n) {
        var c: i32 = raw[i] as i32;
        if (inq) {
            if (c == 92) { i = i + 2; }              // '\' — skip the escaped byte
            else {
                if (c == 34) { inq = false; }        // closing '"'
                i = i + 1;
            }
        } else if (c == 34) { inq = true; i = i + 1; }
        else if (c == 47 && i + 1 < n && raw[i + 1] == 47) { return raw[0:i] + ""; }
        else { i = i + 1; }
    }
    return raw;
}

// arm64_gas_data_ascii appends a `.ascii "…"` string (NO trailing NUL) to
// the data blob, decoding the same escapes as .asciz. asm_arm64 emits string
// literals as `.ascii` (the length is tracked separately, so no terminator).
// An UNTERMINATED quoted string is refused rather than silently truncated
// (#6082): a short literal shifts every later constant in .rodata, and the
// resulting garbage is unattributable at runtime. The refusal makes any future
// escaping gap a named assembler error instead.
function arm64_gas_data_ascii(own p: Arm64GasProg, line: string): Arm64GasProg {
    var q1: i32 = arm64_str_indexof(line, "\"");
    if (q1 < 0) { return p; }
    var closed: boolean = false;
    var k: i32 = q1 + 1;
    while (k < line.len()) {
        if (line[k] == 92) { k = k + 2; }
        else {
            if (line[k] == 34) { closed = true; }
            k = k + 1;
            if (closed) { break; }
        }
    }
    if (!closed) { return Arm64GasProg { ...p, unknown: p.unknown.append("ascii:unterminated") }; }
    var i: i32 = q1 + 1;
    while (i < line.len() && line[i] != 34) {
        var c: i32 = line[i] as i32;
        if (c == 92 && i + 1 < line.len()) {
            var e: i32 = line[i + 1] as i32;
            if (e == 110) { c = 10; }
            else if (e == 116) { c = 9; }
            else if (e == 114) { c = 13; }
            else if (e == 48) { c = 0; }
            else { c = e; }
            i = i + 1;
        }
        p = Arm64GasProg { ...p, data: p.data.append(c & 255) };
        i = i + 1;
    }
    return p;
}

// Correctly-rounding decimal -> f64 (SH-004): round-to-nearest, ties to
// even, bit-exact with strtod / the GNU-as path. Mirrored VERBATIM from
// watbin.fern's parse_f64 machinery (pf64_*) — the assemblers are
// deliberately import-free, so the algorithm is kept in sync by hand,
// like the emit layers. See watbin.fern for the algorithm commentary.
// pf64_div2 halves the fraction buffer 0.B (grade-school left-to-right),
// returning the new buffer. May append one digit; drops a leading zero by
// signalling via the first element sentinel — the caller adjusts dp, so
// this returns the raw halved digits INCLUDING a possible leading zero.
function pf64_div2(b: i32[]): i32[] {
    var out: i32[] = [];
    var r: i32 = 0;
    var i: i32 = 0;
    while (i < b.len()) {
        var cur: i32 = r * 10 + b[i];
        out = out.append(cur / 2);
        r = cur % 2;
        i = i + 1;
    }
    if (r != 0) { out = out.append(5); }
    return out;
}

// pf64_mul2 doubles the fraction buffer 0.B (right-to-left with carry).
// A carry out of the front means the value reached [1, 2): the caller
// consumes it as the next binary digit. Returns carry * 1000000 + ... no —
// Fern has no multi-return here; the carry is prepended as a FIRST element
// (0 or 1) and the caller splits it off.
function pf64_mul2(b: i32[]): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < b.len()) { out = out.append(0); i = i + 1; }
    var carry: i32 = 0;
    var j: i32 = b.len() - 1;
    while (j >= 0) {
        var cur: i32 = b[j] * 2 + carry;
        out = out.with(j, cur % 10);
        carry = cur / 10;
        j = j - 1;
    }
    var res: i32[] = [carry];
    var k: i32 = 0;
    while (k < out.len()) { res = res.append(out[k]); k = k + 1; }
    return res;
}

// pf64_sub returns b[from : upto) as a fresh array (slices are a distinct
// type here, so buffer trims copy).
function pf64_sub(b: i32[], from: i32, upto: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = from;
    while (i < upto) { out = out.append(b[i]); i = i + 1; }
    return out;
}

// pf64_all_zero reports whether every digit in b is zero.
function pf64_all_zero(b: i32[]): boolean {
    var i: i32 = 0;
    while (i < b.len()) {
        if (b[i] != 0) { return false; }
        i = i + 1;
    }
    return true;
}

function parse_f64_bits(s: string): i64 {
    var i: i32 = 0;
    var neg: boolean = false;
    if (s.len() > 0 && s[0] == 45) { neg = true; i = 1; }
    else if (s.len() > 0 && s[0] == 43) { i = 1; }
    var signbit: i64 = 0;
    if (neg) { var one: i64 = 1; signbit = one << 63; }
    // Collect significant digits and the decimal point position:
    // value = 0.digits × 10^dp. The 800-digit cap is what makes dropping the
    // rest into a sticky bit safe: an exact ULP tie needs at most 751
    // significant decimal digits anywhere in the binary64 range (the smallest,
    // 2^-1075, is 5^1075 / 10^1075), so an input with a non-zero digit past
    // 800 cannot be a tie and rounding up off the round bit is correct.
    var digits: i32[] = [];
    var dp: i32 = 0;
    var sticky: boolean = false;
    var started: boolean = false;
    while (i < s.len() && s[i] >= 48 && s[i] <= 57) {
        var d: i32 = (s[i] as i32) - 48;
        if (started || d != 0) {
            started = true;
            if (digits.len() < 800) { digits = digits.append(d); }
            else { if (d != 0) { sticky = true; } }
            dp = dp + 1;
        }
        i = i + 1;
    }
    if (i < s.len() && s[i] == 46) {        // '.'
        i = i + 1;
        while (i < s.len() && s[i] >= 48 && s[i] <= 57) {
            var fd: i32 = (s[i] as i32) - 48;
            if (started || fd != 0) {
                started = true;
                if (digits.len() < 800) { digits = digits.append(fd); }
                else { if (fd != 0) { sticky = true; } }
            } else {
                dp = dp - 1;                // leading fraction zero shifts the point
            }
            i = i + 1;
        }
    }
    if (i < s.len() && (s[i] == 101 || s[i] == 69)) {   // 'e' / 'E'
        i = i + 1;
        var eneg: boolean = false;
        if (i < s.len() && s[i] == 45) { eneg = true; i = i + 1; }
        else if (i < s.len() && s[i] == 43) { i = i + 1; }
        var exp: i32 = 0;
        while (i < s.len() && s[i] >= 48 && s[i] <= 57) {
            if (exp < 100000) { exp = exp * 10 + ((s[i] as i32) - 48); }
            i = i + 1;
        }
        if (eneg) { dp = dp - exp; } else { dp = dp + exp; }
    }
    // Trailing zeros in the significand carry no information; trimming
    // keeps the sticky/remainder tests honest.
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
        digits = pf64_sub(digits, 0, digits.len() - 1);
    }
    if (digits.len() == 0) { return signbit; }          // ±0.0
    // Decimal-magnitude clamps keep the shift loops bounded: |value| is in
    // [10^(dp-1), 10^dp), so dp > 310 overflows every double and dp < -350
    // underflows below half the minimum subnormal.
    if (dp > 310) { var inf: i64 = 2047; return signbit | (inf << 52); }
    if (dp < 0 - 350) { return signbit; }
    // Binary-normalize 0.digits × 10^dp into v × 2^bexp with v in [0.5, 1).
    // While the decimal point is right of the front (value >= 1), halve;
    // while the value is below 0.5, double. dp reaches 0 first, then the
    // leading-digit test finishes the job.
    var bexp: i32 = 0;
    while (dp > 0) {
        var hb: i32[] = pf64_div2(digits);
        if (hb.len() > 0 && hb[0] == 0) {
            digits = pf64_sub(hb, 1, hb.len());
            dp = dp - 1;
        } else {
            digits = hb;
        }
        bexp = bexp + 1;
        while (digits.len() > 0 && digits[digits.len() - 1] == 0) { digits = pf64_sub(digits, 0, digits.len() - 1); }
    }
    while (dp < 0 || (digits.len() > 0 && digits[0] < 5)) {
        var db: i32[] = pf64_mul2(digits);
        if (db[0] != 0) {
            // Carry out of the fraction: 2×0.D >= 1, i.e. C.D' × 10^dp.
            // Renormalize as 0.(C D') × 10^(dp+1) — the carry becomes the
            // new leading digit and the point advances. (Only reachable
            // while dp < 0: at dp == 0 the loop only runs when the lead
            // digit is < 5, so doubling cannot carry.)
            digits = db;
            dp = dp + 1;
        } else {
            digits = pf64_sub(db, 1, db.len());
        }
        bexp = bexp - 1;
        while (digits.len() > 0 && digits[digits.len() - 1] == 0) { digits = pf64_sub(digits, 0, digits.len() - 1); }
        if (digits.len() == 0) { return signbit; }
    }
    // v in [0.5, 1), value = v × 2^bexp = 1.f × 2^(bexp-1): biased exponent
    // E = bexp + 1022. E >= 2047 overflows; E <= 0 goes subnormal with
    // 52 + E mantissa bits; below -1 it is under half the minimum
    // subnormal and rounds to zero.
    var e: i32 = bexp + 1022;
    if (e >= 2047) { var inf2: i64 = 2047; return signbit | (inf2 << 52); }
    var nbits: i32 = 53;
    if (e <= 0) { nbits = 52 + e; }
    if (nbits < 0) { return signbit; }
    var mant: i64 = 0;
    var k2: i32 = 0;
    while (k2 < nbits) {
        var mb: i32[] = pf64_mul2(digits);
        mant = mant * 2 + (mb[0] as i64);
        digits = pf64_sub(mb, 1, mb.len());
        k2 = k2 + 1;
    }
    // Round to nearest, ties to even: round bit is the next binary digit;
    // sticky is any remainder (or parse-time truncation).
    var rb: i32[] = pf64_mul2(digits);
    var roundbit: i32 = rb[0];
    var rest: i32[] = pf64_sub(rb, 1, rb.len());
    var st: boolean = sticky || !pf64_all_zero(rest);
    if (roundbit == 1 && (st || (mant & 1) == 1)) { mant = mant + 1; }
    if (e <= 0) {
        // Subnormal: the E field is 0 and `bits = mant` — and a subnormal
        // that rounded up to 2^52 IS the smallest normal (E=1, f=0), which
        // this encoding produces arithmetically.
        return signbit | mant;
    }
    var full: i64 = 1;
    full = full << 53;
    if (mant == full) {
        // 1.111…1 rounded up to 10.00…0: renormalize.
        mant = mant / 2;
        e = e + 1;
        if (e >= 2047) { var inf3: i64 = 2047; return signbit | (inf3 << 52); }
    }
    var hidden: i64 = 1;
    hidden = hidden << 52;
    return signbit | ((e as i64) << 52) | (mant - hidden);
}

// arm64_parse_f64 parses a `.double` operand into the nearest f64.
function arm64_parse_f64(s: string): f64 {
    return f64_from_bits(parse_f64_bits(s));
}

// arm64_gas_data_align pads the data blob to a 2^n byte boundary.
function arm64_gas_data_align(own p: Arm64GasProg, n: i32): Arm64GasProg {
    var a: i32 = 1;
    var k: i32 = 0;
    while (k < n) { a = a * 2; k = k + 1; }
    while ((p.data.len() % a) != 0) {
        p = Arm64GasProg { ...p, data: p.data.append(0) };
    }
    return p;
}

// arm64_gas_bss_directive reserves zero-init space in the .bss region for a
// directive (no file bytes — it only grows bss_size, the ELF memsz tail).
// `.skip`/`.zero`/`.space N`, `.quad`/`.word`/`.byte` (zero-init slots), and
// `.align` are the forms asm_arm64 emits for the heap globals + the 1 GiB
// `__fern_heap: .skip` reservation.
function arm64_gas_bss_directive(own p: Arm64GasProg, line: string): Arm64GasProg {
    if (arm64_str_starts_with(line, ".skip") || arm64_str_starts_with(line, ".zero") || arm64_str_starts_with(line, ".space")) {
        var sp: i32 = arm64_str_indexof(line, " ");
        if (sp >= 0) {
            return Arm64GasProg { ...p, bss_size: p.bss_size + arm64_gas_atoi(arm64_gas_trim(line[sp + 1:line.len()])) };
        }
        return p;
    }
    if (arm64_str_starts_with(line, ".quad")) { return Arm64GasProg { ...p, bss_size: p.bss_size + 8 }; }
    if (arm64_str_starts_with(line, ".4byte") || arm64_str_starts_with(line, ".word")) { return Arm64GasProg { ...p, bss_size: p.bss_size + 4 }; }
    if (arm64_str_starts_with(line, ".byte")) { return Arm64GasProg { ...p, bss_size: p.bss_size + 1 }; }
    if (arm64_str_starts_with(line, ".align") || arm64_str_starts_with(line, ".p2align") || arm64_str_starts_with(line, ".balign")) {
        var sp2: i32 = arm64_str_indexof(line, " ");
        if (sp2 >= 0) {
            var n: i32 = arm64_gas_atoi(arm64_gas_trim(line[sp2 + 1:line.len()]));
            var a: i32 = 1;
            var k: i32 = 0;
            while (k < n) { a = a * 2; k = k + 1; }
            var bs: i32 = p.bss_size;
            while ((bs % a) != 0) { bs = bs + 1; }
            return Arm64GasProg { ...p, bss_size: bs };
        }
        return p;
    }
    return p;
}

// arm64_gas_bss_off returns a .bss symbol's offset within the bss region, or
// -1 if it is not a bss symbol.
function arm64_gas_bss_off(p: Arm64GasProg, name: string): i32 {
    var i: i32 = 0;
    while (i < p.bss_names.len()) {
        if (p.bss_names[i] == name) { return p.bss_offs[i]; }
        i = i + 1;
    }
    return 0 - 1;
}

// arm64_gas_data_directive handles a `.`-directive inside a data section.
function arm64_gas_data_directive(own p: Arm64GasProg, line: string): Arm64GasProg {
    if (arm64_str_starts_with(line, ".quad")) {
        var qtok: string = arm64_gas_trim(line[5:line.len()]);
        // A SYMBOLIC operand (`.quad .S0`) is another symbol's absolute address,
        // not a number: reserve the 8-byte slot and queue a relocation for
        // arm64_gas_link, which is the only point the segment addresses exist.
        // arm64_gas_atoi64 would have returned 0 here, indistinguishable from a
        // real `.quad 0`.
        if (!arm64_gas_numeric_tok(qtok)) {
            p = Arm64GasProg { ...p,
                dref_offs: p.dref_offs.append(p.data.len()),
                dref_syms: p.dref_syms.append(qtok) };
            return arm64_gas_data_le(p, 0, 8);
        }
        return arm64_gas_data_le(p, arm64_gas_atoi64(qtok), 8);
    }
    if (arm64_str_starts_with(line, ".4byte") || arm64_str_starts_with(line, ".word")) {
        var off: i32 = 6;
        if (arm64_str_starts_with(line, ".word")) { off = 5; }
        return arm64_gas_data_le(p, arm64_gas_atoi64(arm64_gas_trim(line[off:line.len()])), 4);
    }
    if (arm64_str_starts_with(line, ".long")) {
        // `.long a, b, …`: each comma-separated value as 4 little-endian bytes.
        // The IR emitters lay an f64 constant down as two `.long` halves (exact
        // bits, assembler-independent — see const_f64). Ignoring it (the
        // pre-#5434 behaviour) silently dropped the 8 rodata bytes.
        var lrest: string = arm64_gas_trim(line[5:line.len()]);
        var ltok: string = "";
        var lci: i32 = 0;
        var lp: Arm64GasProg = p;
        while (lci < lrest.len()) {
            if (lrest[lci] == 44) {   // ','
                lp = arm64_gas_data_le(lp, arm64_gas_atoi64(arm64_gas_trim(ltok)), 4);
                ltok = "";
            } else {
                ltok = ltok + lrest[lci:lci + 1];
            }
            lci = lci + 1;
        }
        if (arm64_gas_trim(ltok).len() > 0) {
            lp = arm64_gas_data_le(lp, arm64_gas_atoi64(arm64_gas_trim(ltok)), 4);
        }
        return lp;
    }
    if (arm64_str_starts_with(line, ".byte")) {
        return arm64_gas_data_le(p, arm64_gas_atoi64(arm64_gas_trim(line[5:line.len()])), 1);
    }
    if (arm64_str_starts_with(line, ".asciz") || arm64_str_starts_with(line, ".string")) {
        return arm64_gas_data_asciz(p, line);
    }
    if (arm64_str_starts_with(line, ".ascii")) {
        return arm64_gas_data_ascii(p, line);
    }
    if (arm64_str_starts_with(line, ".double")) {
        return arm64_gas_data_le(p, f64_bits(arm64_parse_f64(arm64_gas_trim(line[7:line.len()]))), 8);
    }
    if (arm64_str_starts_with(line, ".align") || arm64_str_starts_with(line, ".p2align") || arm64_str_starts_with(line, ".balign")) {
        var sp: i32 = arm64_str_indexof(line, " ");
        if (sp >= 0) {
            return arm64_gas_data_align(p, arm64_gas_atoi(arm64_gas_trim(line[sp + 1:line.len()])));
        }
    }
    return p; // other directives ignored
}

// arm64_lit_le64 appends the 8 little-endian bytes of a 64-bit literal-pool
// value to a code buffer (low word then high word).
function arm64_lit_le64(buf: i32[], v: i64): i32[] {
    buf = arm64_le32(buf, v);
    buf = arm64_le32(buf, v >> 32);
    return buf;
}

// arm64_lit_reach is the LDR-literal forward reach in bytes: imm19 is a
// signed word count, so +262143 words.
function arm64_lit_reach(): i32 { return 1048572; }

// arm64_lit_pool_far returns the byte distance of the FARTHEST pending
// `ldr Xd, =N` site from a pool about to be placed at `code_len`, or 0 when
// nothing is pending. The pool always follows its sites, so only the forward
// distance matters. arm64_patch_ldr_lit masks imm19 to 19 bits, so a distance
// past arm64_lit_reach() would wrap into a load from the wrong address instead
// of failing — a silent miscompile, which is what let a self-host `-target
// arm64` build of the checker driver produce a "successful" binary that then
// exhausted the arena on its first input. Callers record an over-range flush
// on p.unknown so the driver refuses the output, matching the REFUSE-rather-
// than-mis-encode contract of the register and immediate decoders.
function arm64_lit_pool_far(p: Arm64GasProg, code_len: i32): i32 {
    var worst: i32 = 0;
    var i: i32 = 0;
    while (i < p.lit_sites.len()) {
        var d: i32 = code_len - p.lit_sites[i];
        if (d > worst) { worst = d; }
        i = i + 1;
    }
    return worst;
}

// arm64_gas_ltorg flushes the pending `ldr Xd, =N` literal pool into .text
// at the current offset: 8-align, then for each pending load patch its
// LDR-literal imm19 to the (PC-relative) pool slot and append the value's 8
// bytes. asm_arm64_ir emits a `.ltorg` after every function so the pool stays
// within the ±1 MiB LDR-literal reach; the pool sits after the function's
// `ret`, so it is never executed.
// It takes the assembler state as an argument and hands it back rather than
// reading p.asm, so the buffer is uniquely owned here too — see
// arm64_gas_program's note on why an alias makes every append copy. It
// consumes that state (`own`) so the .text buffer can be lifted out of the
// struct for the patch loop; clearing the pending lists is the caller's job.
function arm64_gas_ltorg(p: Arm64GasProg, own aw: Arm64Asm): Arm64Asm {
    if (p.lit_sites.len() == 0) { return aw; }
    var code: i32[] = aw.code;
    aw = Arm64Asm { ...aw, code: [] };
    while ((code.len() & 7) != 0) {
        code = code.append(0);
    }
    var i: i32 = 0;
    while (i < p.lit_sites.len()) {
        var site: i32 = p.lit_sites[i];
        var imm19: i32 = (code.len() - site) / 4;
        code = arm64_patch_ldr_lit(code, site, imm19);
        code = arm64_lit_le64(code, p.lit_vals[i]);
        i = i + 1;
    }
    return Arm64Asm { ...aw, code: code };
}

// ---- the assemble loop ----

// arm64_gas_program parses a GAS-text program (one statement per line)
// into an Arm64GasProg: .text code (forward branches resolved), a data
// blob, a data-symbol table, and a queue of @PAGE/@PAGEOFF fixups (left
// for arm64_gas_link). The first .text label must sit at offset 0, since
// macho.fern enters at the first text byte.
pub function arm64_gas_program(src: string): Arm64GasProg {
    var p: Arm64GasProg = arm64_gas_prog_new();
    // The .text buffer is threaded through the loop as `a`, a UNIQUELY-owned
    // local, and only folded back into p on return. Reading it out of p.asm per
    // instruction — `arm64_gas_emit(p.asm, …)`, or the `var xas: Arm64Asm =
    // p.asm; …; p = { ...p, asm: xas }` shape the special cases used — left the
    // code array reachable through BOTH p and the local, so every append inside
    // saw a shared array and copied the whole buffer instead of extending it:
    // one full copy per emitted instruction, i.e. O(code_len^2) arena traffic.
    // That is #6011 — the self-host arm64 CLI needed 8.5 GB (arena exhausted,
    // exit 137) to compile an empty `main` importing std/array, where x86-64
    // did it in 1.5 GB. The emitters were never at fault; only this assembler
    // is on the arm64 CLI path, and x86-64's stops at `.s` text. Held uniquely,
    // Perceus reuse extends the buffer in place and the cost is linear.
    var a: Arm64Asm = p.asm;
    p = Arm64GasProg { ...p, asm: arm64_asm_new() };
    var section: i32 = 0; // 0 = .text, 1 = data (__const / __data)
    var nl_cnt: i32[] = []; // definitions seen per numeric local label
    var lines: string[] = arm64_str_split(src, "\n");
    var li: i32 = 0;
    while (li < lines.len()) {
        var raw: string = lines[li];
        li = li + 1;
        raw = arm64_gas_strip_comment(raw);
        var line: string = arm64_gas_trim(raw);
        if (line.len() == 0) {
            continue;
        }
        // label prefix `name:`
        var colon: i32 = arm64_str_indexof(line, ":");
        if (colon > 0) {
            var before: str = line[0:colon];
            if (arm64_str_indexof(before, " ") < 0 && arm64_str_indexof(before, ",") < 0) {
                if (section == 1) {
                    p = Arm64GasProg { ...p, dlab_names: p.dlab_names.append(before) };
                    p = Arm64GasProg { ...p, dlab_offs: p.dlab_offs.append(p.data.len()) };
                } else if (section == 2) {
                    p = Arm64GasProg { ...p, bss_names: p.bss_names.append(before) };
                    p = Arm64GasProg { ...p, bss_offs: p.bss_offs.append(p.bss_size) };
                } else if (arm64_gas_is_digits(before + "")) {
                    var nv: i32 = arm64_gas_atoi(before + "");
                    nl_cnt = arm64_gas_nl_grow(nl_cnt, nv);
                    a = arm64_asm_label(a, arm64_gas_nl_name(nv, nl_cnt[nv]));
                    nl_cnt = nl_cnt.with(nv, nl_cnt[nv] + 1);
                } else {
                    a = arm64_asm_label(a, before);
                }
                line = arm64_gas_trim(line[colon + 1:line.len()]);
                if (line.len() == 0) {
                    continue;
                }
            }
        }
        // directives
        if (line[0] == 46) { // '.'
            if (line == ".ltorg") {
                if (arm64_lit_pool_far(p, a.code.len()) > arm64_lit_reach()) {
                    p = Arm64GasProg { ...p, unknown: p.unknown.append("ltorg:range") };
                }
                a = arm64_gas_ltorg(p, a);
                p = Arm64GasProg { ...p, lit_sites: [], lit_vals: [] };
            } else if (line == ".text") {
                section = 0;
            } else if (line == ".bss") {
                section = 2;
            } else if (arm64_str_starts_with(line, ".section")) {
                if (arm64_str_contains(line, "__bss") || arm64_str_contains(line, ".bss")) {
                    section = 2;
                } else if (arm64_str_contains(line, "__const") || arm64_str_contains(line, "__DATA") || arm64_str_contains(line, ".data") || arm64_str_contains(line, ".rodata")) {
                    section = 1;
                } else {
                    section = 0;
                }
            } else if (arm64_str_starts_with(line, ".data")) {
                section = 1;
            } else if (section == 2) {
                p = arm64_gas_bss_directive(p, line);
            } else if (section == 1) {
                p = arm64_gas_data_directive(p, line);
            }
            continue;
        }
        // mnemonic + operands
        var sp: i32 = arm64_str_indexof(line, " ");
        var mnem: string = line;
        var rest: string = "";
        if (sp >= 0) {
            mnem = line[0:sp] + "";
            rest = arm64_gas_trim(line[sp + 1:line.len()]);
        }
        // A register-shaped operand that fails the strict decode (SH-006 —
        // `x1a`, `x31`, `d40`) is recorded like an unknown mnemonic: the
        // encoders below would otherwise fold the -1 sentinel into garbage
        // bits, and the p.unknown gate refuses the output instead.
        var badreg: string = arm64_gas_bad_reg_token(rest);
        if (badreg.len() > 0) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":" + badreg) };
        }
        // Same discipline for cnt/addv's SIMD operands: the byte-lane encoders
        // cannot express a wider arrangement, and folding a -1 into the
        // register field would emit a plausible instruction on the wrong
        // register.
        var badvec: string = arm64_gas_bad_vec_token(mnem, rest);
        if (badvec.len() > 0) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":" + badvec) };
        }
        // Same discipline for a register in the OFFSET position of a form whose
        // only encoder takes an immediate: refuse the line instead of silently
        // dropping the index. #6047 was exactly this hole, on ldrb/strb, which
        // now encode the register form properly.
        if (arm64_gas_regoff_unsupported(mnem, rest)) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":regoff") };
        }
        // Same discipline for a `!` pre-index writeback on a form that has only
        // the unsigned-offset encoder: dropping the writeback leaves the base
        // register un-updated, and any paired release then moves it the wrong
        // way (#6083). Refuse the line.
        if (arm64_gas_writeback_unsupported(mnem, rest)) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":writeback") };
        }
        // Same discipline for an add/sub shift or extend operand this
        // assembler has no encoder for: dropping it emits a plausible
        // instruction that computes the wrong address (#6849).
        if (arm64_gas_addsub_operand_unsupported(mnem, rest)) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":shift") };
        }
        // A mov-wide immediate that does not fit imm16 (or whose complement does
        // not, for the MOVN path) would be silently TRUNCATED into a different
        // constant. Refuse it: the emitter builds anything wider through the
        // literal pool (`ldr Xt, =N`), so this only ever fires on a form the
        // assembler genuinely cannot express.
        if (arm64_gas_movwide_out_of_range(mnem, rest)) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":imm16") };
        }
        // `ldr Xd, =N` (literal-pool load): emit an LDR-literal placeholder
        // and queue the 64-bit value; `.ltorg` (or end of program) flushes
        // the pool into .text and patches the imm19.
        if (mnem == "ldr" && arm64_str_indexof(rest, "=") >= 0) {
            var rops: string[] = arm64_gas_operands(rest);
            var litok: string = arm64_gas_trim(rops[1]);
            var nval: i64 = arm64_gas_atoi64(arm64_gas_trim(litok[1:litok.len()]));
            a = Arm64Asm { ...a, code: arm64_ldr_lit(a.code, arm64_gas_reg(rops[0]), 0) };
            p = Arm64GasProg { ...p, lit_sites: p.lit_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, lit_vals: p.lit_vals.append(nval) };
            continue;
        }
        // @PAGE / @PAGEOFF symbol references queue a fixup; everything else
        // assembles directly into .text.
        if (mnem == "adrp") {
            var aops: string[] = arm64_gas_operands(rest);
            a = Arm64Asm { ...a, code: arm64_adrp(a.code, arm64_gas_reg(aops[0]), 0) };
            p = Arm64GasProg { ...p, pf_sites: p.pf_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, pf_syms: p.pf_syms.append(arm64_gas_strip_at(aops[1])) };
            p = Arm64GasProg { ...p, pf_kinds: p.pf_kinds.append(0) };
            continue;
        }
        if (mnem == "ldr" && arm64_str_indexof(rest, "@PAGEOFF") >= 0) {
            var lops: string[] = arm64_gas_operands(rest);
            var lm: Arm64Mem = arm64_gas_mem(lops[1]); // base reg; off symbolic
            // symbol is the bracket's second operand, before '@'
            var linner: string = lops[1];
            var lb: i32 = arm64_str_indexof(linner, "[");
            var rb: i32 = arm64_str_indexof(linner, "]");
            var lparts: string[] = arm64_gas_operands(linner[lb + 1:rb]);
            a = Arm64Asm { ...a, code: arm64_ldr(a.code, arm64_gas_reg(lops[0]), lm.base, 0, arm64_gas_is_w(lops[0])) };
            p = Arm64GasProg { ...p, pf_sites: p.pf_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, pf_syms: p.pf_syms.append(arm64_gas_strip_at(lparts[1])) };
            p = Arm64GasProg { ...p, pf_kinds: p.pf_kinds.append(1) };
            continue;
        }
        if (mnem == "add" && arm64_str_indexof(rest, "@PAGEOFF") >= 0) {
            var dops: string[] = arm64_gas_operands(rest);
            a = Arm64Asm { ...a, code: arm64_addimm(a.code, arm64_gas_reg(dops[0]), arm64_gas_reg(dops[1]), 0, false) };
            p = Arm64GasProg { ...p, pf_sites: p.pf_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, pf_syms: p.pf_syms.append(arm64_gas_strip_at(dops[2])) };
            p = Arm64GasProg { ...p, pf_kinds: p.pf_kinds.append(2) };
            continue;
        }
        // Linux/ELF low-12-bits add: `add Xd, Xn, :lo12:sym` — the GAS
        // spelling of darwin's `add Xd, Xn, sym@PAGEOFF` (same kind-2 fixup;
        // arm64_gas_link resolves both to target & 0xfff). The matching
        // `adrp Xd, sym` is handled by the adrp branch above (bare symbol).
        if (mnem == "add" && arm64_str_indexof(rest, ":lo12:") >= 0) {
            var lops: string[] = arm64_gas_operands(rest);
            a = Arm64Asm { ...a, code: arm64_addimm(a.code, arm64_gas_reg(lops[0]), arm64_gas_reg(lops[1]), 0, false) };
            p = Arm64GasProg { ...p, pf_sites: p.pf_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, pf_syms: p.pf_syms.append(arm64_gas_strip_lo12(lops[2])) };
            p = Arm64GasProg { ...p, pf_kinds: p.pf_kinds.append(2) };
            continue;
        }
        // `and Xd, Xn, #imm` (logical immediate) needs a verified bitmask
        // encoding; an unsupported immediate is recorded (never silently
        // mis-encoded). Register-form `and` falls through to emit.
        if (mnem == "and" && arm64_str_indexof(rest, "#") >= 0) {
            var nops: string[] = arm64_gas_operands(rest);
            var nimm: i32 = arm64_gas_imm(nops[2]);
            var nw: boolean = arm64_gas_is_w(nops[0]);
            if (arm64_and_imm_ok(nimm) && (!nw || arm64_logical_imm_w_ok(nimm))) {
                a = Arm64Asm { ...a, code: arm64_and_imm(a.code, arm64_gas_reg(nops[0]), arm64_gas_reg(nops[1]), nimm, nw) };
            } else {
                p = Arm64GasProg { ...p, unknown: p.unknown.append("and#") };
            }
            continue;
        }
        // `eor Xd, Xn, #imm` (logical immediate) — same verified-bitmask path
        // as `and #imm`. Register-form `eor` falls through to emit.
        if (mnem == "eor" && arm64_str_indexof(rest, "#") >= 0) {
            var eops: string[] = arm64_gas_operands(rest);
            var eimm: i32 = arm64_gas_imm(eops[2]);
            var ew: boolean = arm64_gas_is_w(eops[0]);
            if (arm64_eor_imm_ok(eimm) && (!ew || arm64_logical_imm_w_ok(eimm))) {
                a = Arm64Asm { ...a, code: arm64_eor_imm(a.code, arm64_gas_reg(eops[0]), arm64_gas_reg(eops[1]), eimm, ew) };
            } else {
                p = Arm64GasProg { ...p, unknown: p.unknown.append("eor#") };
            }
            continue;
        }
        // `mrs Xt, <sysreg>` — only the system registers the runtime reads
        // are encoded; an unknown sysreg is recorded (never mis-encoded).
        if (mnem == "mrs") {
            var sops: string[] = arm64_gas_operands(rest);
            var sysn: string = arm64_gas_trim(sops[1]);
            if (arm64_mrs_base(sysn) >= 0) {
                a = Arm64Asm { ...a, code: arm64_mrs(a.code, arm64_gas_reg(sops[0]), sysn) };
            } else {
                p = Arm64GasProg { ...p, unknown: p.unknown.append("mrs:" + sysn) };
            }
            continue;
        }
        if (!arm64_gas_known(mnem)) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem) };
        }
        // Label-relative branches are dispatched HERE rather than inside
        // arm64_gas_emit so the transfer of `a` is a self-reassign of a LOCAL.
        // Threaded through gas_emit instead, the transfer sits early in a
        // 60-branch if-chain with `a` mentioned in every later branch, so it is
        // not the parameter's last use and the compiler has to RETAIN across
        // it — which leaves the .text buffer shared and sends every
        // backward-branch patch down the copy path (the last of #6011's
        // quadratic loops). Here the callee is the sole owner and patches in
        // place.
        if (mnem == "b" || mnem == "bl" || mnem == "cbz" || mnem == "cbnz"
            || mnem == "tbz" || mnem == "tbnz" || arm64_gas_is_bcond(mnem)) {
            var bops: string[] = arm64_gas_operands(rest);
            if (mnem == "b") {
                a = arm64_asm_b(a, arm64_gas_nl_ref(nl_cnt, bops[0]));
            } else if (mnem == "bl") {
                a = arm64_asm_bl(a, arm64_gas_nl_ref(nl_cnt, bops[0]));
            } else if (mnem == "cbz") {
                a = arm64_asm_cbz(a, arm64_gas_reg(bops[0]), arm64_gas_nl_ref(nl_cnt, bops[1]), arm64_gas_is_w(bops[0]));
            } else if (mnem == "cbnz") {
                a = arm64_asm_cbnz(a, arm64_gas_reg(bops[0]), arm64_gas_nl_ref(nl_cnt, bops[1]), arm64_gas_is_w(bops[0]));
            } else if (mnem == "tbz") {
                a = arm64_asm_tbz(a, arm64_gas_reg(bops[0]), arm64_gas_imm(bops[1]), arm64_gas_nl_ref(nl_cnt, bops[2]));
            } else if (mnem == "tbnz") {
                a = arm64_asm_tbnz(a, arm64_gas_reg(bops[0]), arm64_gas_imm(bops[1]), arm64_gas_nl_ref(nl_cnt, bops[2]));
            } else {
                a = arm64_asm_bcond(a, arm64_gas_cond(arm64_gas_bcond_suffix(mnem)), arm64_gas_nl_ref(nl_cnt, bops[0]));
            }
            continue;
        }
        a = arm64_gas_emit(a, mnem, rest);
    }
    if (arm64_lit_pool_far(p, a.code.len()) > arm64_lit_reach()) {
        p = Arm64GasProg { ...p, unknown: p.unknown.append("ltorg:range") };
    }
    a = arm64_gas_ltorg(p, a); // flush any literals after the final `.ltorg`
    p = Arm64GasProg { ...p, lit_sites: [], lit_vals: [] };
    // 8-align the data blob so the .bss region that follows it in memory
    // (data_vaddr + data.len()) starts 8-aligned for the heap globals.
    while ((p.data.len() & 7) != 0) {
        p = Arm64GasProg { ...p, data: p.data.append(0) };
    }
    a = arm64_asm_resolve(a);
    var ui: i32 = 0;
    while (ui < a.unres.len()) {
        p = Arm64GasProg { ...p, unknown: p.unknown.append("label:" + a.unres[ui]) };
        ui = ui + 1;
    }
    var oi: i32 = 0;
    while (oi < a.oor.len()) {
        p = Arm64GasProg { ...p, unknown: p.unknown.append("branch out of range: " + a.oor[oi]) };
        oi = oi + 1;
    }
    return Arm64GasProg { ...p, asm: a };
}

// Arm64SymAddr / arm64_gas_sym_addr resolve a symbol to its final address at
// link time. A symbol lives in one of THREE places: the rodata/data blob
// (dlab), the zero-init .bss region laid out immediately after the data in
// memory (data_vaddr + data.len() + bss_off), or — for a function VALUE, which
// the emitter takes as `adrp x0, fn` + `add x0, x0, :lo12:fn` — .text.
//
// ONE lookup, shared by the instruction fixups and the data-word relocations,
// because getting it wrong is expensive and silent: the .text arm was once
// missing and the .bss arm did not check it had found anything, so every
// function value resolved to a data address one byte inside the wrong segment
// and calling one was a SEGV on `blr` (the second half of #6045). `found` is
// returned rather than inferred from the address so a caller cannot repeat that
// mistake by testing a sentinel.
struct Arm64SymAddr { found: boolean, addr: i64 }

// `data_len` is passed rather than read off `p`: the data-word loop lifts the
// blob out of the struct to patch it in place, so `p.data.len()` is 0 there and
// the .bss base would silently come out wrong.
function arm64_gas_sym_addr(p: Arm64GasProg, aw: Arm64Asm, name: string, text_vaddr: i64, data_vaddr: i64, data_len: i32): Arm64SymAddr {
    var doff: i32 = arm64_gas_dlabel_off(p, name);
    if (doff >= 0) { return Arm64SymAddr { found: true, addr: data_vaddr + (doff as i64) }; }
    var boff: i32 = arm64_gas_bss_off(p, name);
    if (boff >= 0) { return Arm64SymAddr { found: true, addr: data_vaddr + (data_len as i64) + (boff as i64) }; }
    var toff: i32 = arm64_asm_label_off(aw, name);
    if (toff >= 0) { return Arm64SymAddr { found: true, addr: text_vaddr + (toff as i64) }; }
    return Arm64SymAddr { found: false, addr: 0 };
}

// arm64_gas_rebase_offs returns the offsets, within the data blob, of every
// 8-byte slot arm64_gas_link filled with an ABSOLUTE address (`.quad <symbol>`
// — today only a static aggregate constant's shape pointer, #6149). A Mach-O
// main executable on Apple Silicon must be PIE, so dyld slides the image and
// every one of those needs the slide added: macho_executable turns these into
// LC_DYLD_INFO_ONLY rebase opcodes. Everything else the arm64 emitter produces
// is PC-relative (adrp/@PAGEOFF, b/bl), which is why this is the whole list.
//
// Miss a slot here and the image loads fine, then reads a pointer that is stale
// by the slide — which presents as a codegen bug, not a container one. #6259
// was exactly that: every `match` on a static constant fell through both arms
// and the program returned 0.
pub function arm64_gas_rebase_offs(p: Arm64GasProg): i32[] {
    return p.dref_offs;
}

// arm64_gas_link resolves the queued @PAGE/@PAGEOFF fixups now that the
// final __TEXT / __DATA segment addresses are known (the caller supplies
// them from macho.fern's macho_text_vaddr / macho_data_vaddr). After this,
// p.asm.code + p.data are the final sections.
// It consumes the prog (`own`) so the .text buffer can be lifted clear of both
// enclosing structs before the loop: patched in place inside them, each fixup
// cloned the whole .text.
pub function arm64_gas_link(own p: Arm64GasProg, text_vaddr: i64, data_vaddr: i64): Arm64GasProg {
    var aw: Arm64Asm = p.asm;
    p = Arm64GasProg { ...p, asm: arm64_asm_new() };
    var code: i32[] = aw.code;
    aw = Arm64Asm { ...aw, code: [] };
    var i: i32 = 0;
    while (i < p.pf_sites.len()) {
        var site: i32 = p.pf_sites[i];
        // A symbol lives in one of THREE places: the rodata/data blob (dlab),
        // the zero-init .bss region laid out immediately after the data in
        // memory (data_vaddr + data.len() + bss_off), or — for a function
        // VALUE, which the emitter takes as `adrp x0, fn` + `add x0, x0,
        // :lo12:fn` — .text.
        //
        // The .text arm was missing, and the .bss arm did not check that it had
        // actually found anything: a text symbol fell through to bss_off's -1
        // "not found" sentinel and resolved to `data_vaddr + data.len() - 1`.
        // So every function value was a data address one byte inside the wrong
        // segment, and calling one was a SEGV on `blr`. That is the second half
        // of #6045 — invisible until the numeric-local-label fix above stopped
        // the program dying on SIGILL before it ever reached an indirect call.
        var res: Arm64SymAddr = arm64_gas_sym_addr(p, aw, p.pf_syms[i], text_vaddr, data_vaddr, p.data.len());
        if (!res.found) { p = Arm64GasProg { ...p, unknown: p.unknown.append("symbol:" + p.pf_syms[i]) }; }
        var target: i64 = res.addr;
        var kind: i32 = p.pf_kinds[i];
        if (kind == 0) {
            var adrp_addr: i64 = text_vaddr + (site as i64);
            code = arm64_patch_adrp(code, site, arm64_page_delta(target, adrp_addr));
        } else if (kind == 1) {
            code = arm64_patch_ldr_off(code, site, arm64_page_off(target));
        } else {
            code = arm64_patch_addimm_off(code, site, arm64_page_off(target));
        }
        i = i + 1;
    }
    // Data-word relocations (#6149): write each queued symbol's absolute address
    // into its reserved 8-byte slot, little-endian. Same three-place lookup as
    // the instruction fixups above — a static struct constant's shape word
    // points at a rodata label, but nothing stops a data word naming a .text or
    // .bss symbol, and getting that lookup wrong is exactly what #6045 was.
    var data_len: i32 = p.data.len();
    var dat: i32[] = p.data;
    p = Arm64GasProg { ...p, data: [] };
    var di: i32 = 0;
    while (di < p.dref_offs.len()) {
        var dres: Arm64SymAddr = arm64_gas_sym_addr(p, aw, p.dref_syms[di], text_vaddr, data_vaddr, data_len);
        if (!dres.found) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append("symbol:" + p.dref_syms[di]) };
        } else {
            var off: i32 = p.dref_offs[di];
            var v: i64 = dres.addr;
            var b: i32 = 0;
            while (b < 8) {
                dat = dat.with(off + b, ((v >> (b * 8)) & 255) as i32);
                b = b + 1;
            }
        }
        di = di + 1;
    }
    p = Arm64GasProg { ...p, data: dat };
    aw = Arm64Asm { ...aw, code: code };
    p = Arm64GasProg { ...p, asm: aw };
    return p;
}


// arm64_gas_assemble parses a text-only program (no data section / symbol
// relocation) and returns the resolved .text — the back-compat entry the
// earlier slices use.
function arm64_gas_assemble(src: string): Arm64Asm {
    return arm64_gas_program(src).asm;
}

// ============================================================
// PART 3 — Mach-O writer + ad-hoc SHA-256 signature
// ============================================================

// examples/self_host/macho.fern — a minimal ad-hoc-signed arm64 Mach-O
// executable writer for the self-hosted *native* backend. This is
// the Darwin counterpart of elf.fern (Linux): the container half of the
// native-binary path that aims to remove the external `clang` / `ld64`
// link step the self-host currently shells out to for arm64-darwin
// (mirroring the Go reference internal/native/macho/*.go).
//
// The image is a PIE, dyld-loaded executable: __PAGEZERO, an r-x __TEXT
// segment holding the Mach-O header + load commands + machine code, an
// optional r/w __DATA segment (rodata + writable globals, merged), and a
// __LINKEDIT segment carrying an ad-hoc code signature.
//
// # What Apple Silicon requires
//
// This writer emitted a static, dyld-free, non-PIE LC_UNIXTHREAD image
// until #6042. Every such binary is SIGKILLed at exec on Apple Silicon:
// no crash report, nothing in the system log, exit 137 — indistinguishable
// from an OOM kill, which is how the same container cost the native writer
// (#6000) a diagnosis too. Raw `svc #0x80` syscalls are fine; it is the
// dyld-free CONTAINER the kernel rejects. The requirements, in the order
// they bite:
//
//   * MH_PIE. Without it the kernel refuses the image before dyld runs.
//   * LC_LOAD_DYLINKER + LC_LOAD_DYLIB + LC_MAIN. Every arm64 main
//     executable is dyld-loaded, so execution starts at LC_MAIN's FILE
//     offset (dyld adds the slid load address) rather than at an
//     LC_UNIXTHREAD thread-state pc.
//   * LC_SYMTAB whenever LC_DYSYMTAB is present, else dyld aborts with
//     "LC_DYSYMTAB but no LC_SYMTAB load command". Both are emitted with
//     zero counts: nothing here is exported or imported.
//   * LC_BUILD_VERSION, naming the platform.
//   * An ad-hoc LC_CODE_SIGNATURE — no CMS/certificate, the
//     CodeDirectory's SHA-256 page hashes are the identity.
//
// PIE means dyld slides the image, so an absolute address baked into
// __DATA arrives stale unless the image asks for it to be rebased.
// LC_DYLD_INFO_ONLY carries that request as a rebase opcode stream over the
// assembler's `.quad <symbol>` slots (macho_rebase_opcodes, fed from
// arm64_gas_rebase_offs). Everything else the arm64 emitter computes is
// PC-relative (adrp/@PAGEOFF, b/bl), so those slots are the whole list.
// Emit a `.quad <symbol>` without its rebase opcode and the image loads
// fine, then reads through a pointer stale by the slide — which presents as
// a codegen bug rather than a container one (#6259: the shape pointer of
// every static aggregate constant, so every `match` on one fell through).
//
// Conventions (matching elf.fern):
//   * A byte buffer is an `i32[]` of values in 0..255; each helper appends
//     to it and returns the (possibly grown) buffer (`buf = f(buf, …)`).
//   * This module is intentionally **import-free** so (a) the native
//     emitter can `import "./macho"` and (b) the unit test can concatenate
//     this file with a driver `main()` and feed the whole thing to the
//     single-module wasm_run driver.
//   * Mach-O headers/load-commands are little-endian (arm64 host); the
//     code-signing blobs are big-endian. Both emitters live here.
//
// References: Apple's loader.h / cs_blobs.h, and FIPS 180-4 (SHA-256).

// ============================================================
// SHA-256 (FIPS 180-4)
// ============================================================
//
// The ad-hoc code signature hashes each 4 KiB page of the image with
// SHA-256. We have no stdlib here, so a self-contained implementation
// lives in this module. Words are carried in i64 values kept in the range
// [0, 2^32); every arithmetic result is masked back with `& 0xffffffff`,
// so the signed-i64 `>>` (arithmetic) shift acts as a logical shift on the
// always-positive words.

// sha256_rotr rotates a 32-bit word right by n (1..31) bits.
function sha256_rotr(x: i64, n: i32): i64 {
    return ((x >> n) | (x << (32 - n))) & 0xffffffff;
}

// sha256_shr is a logical right shift of a 32-bit word by n bits.
function sha256_shr(x: i64, n: i32): i64 {
    return (x >> n) & 0xffffffff;
}

function sha256_ssig0(x: i64): i64 {
    return (sha256_rotr(x, 7) ^ sha256_rotr(x, 18) ^ sha256_shr(x, 3)) & 0xffffffff;
}

function sha256_ssig1(x: i64): i64 {
    return (sha256_rotr(x, 17) ^ sha256_rotr(x, 19) ^ sha256_shr(x, 10)) & 0xffffffff;
}

function sha256_bsig0(x: i64): i64 {
    return (sha256_rotr(x, 2) ^ sha256_rotr(x, 13) ^ sha256_rotr(x, 22)) & 0xffffffff;
}

function sha256_bsig1(x: i64): i64 {
    return (sha256_rotr(x, 6) ^ sha256_rotr(x, 11) ^ sha256_rotr(x, 25)) & 0xffffffff;
}

// sha256_ch is the choose function: (x & y) ^ (~x & z).
function sha256_ch(x: i64, y: i64, z: i64): i64 {
    return ((x & y) ^ ((x ^ 0xffffffff) & z)) & 0xffffffff;
}

// sha256_maj is the majority function: (x & y) ^ (x & z) ^ (y & z).
function sha256_maj(x: i64, y: i64, z: i64): i64 {
    return ((x & y) ^ (x & z) ^ (y & z)) & 0xffffffff;
}

// sha256_k returns the 64 round constants K (the first 32 bits of the
// fractional parts of the cube roots of the first 64 primes).
function sha256_k(): i64[] {
    var k: i64[] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ];
    return k;
}

// macho_be32_word appends a 32-bit word (held in an i64) big-endian.
function macho_be32_word(buf: i32[], v: i64): i32[] {
    buf = buf.append(((v >> 24) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append((v & 255) as i32);
    return buf;
}

// sha256_bytes returns the 32-byte SHA-256 digest of data[start:start+n]
// as an i32[] of bytes.
function sha256_bytes(data: i32[], start: i32, n: i32): i32[] {
    // ---- pre-processing: pad to a multiple of 64 bytes ----
    var m: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        m = m.append(data[start + i]);
        i = i + 1;
    }
    m = m.append(128); // the single 0x80 bit
    while ((m.len() % 64) != 56) {
        m = m.append(0);
    }
    // 64-bit big-endian message length in bits.
    var bits: i64 = (n as i64) * 8;
    var bb: i32 = 7;
    while (bb >= 0) {
        m = m.append(((bits >> (bb * 8)) & 255) as i32);
        bb = bb - 1;
    }

    var k: i64[] = sha256_k();

    // ---- initial hash value (fractional cube... square roots of primes) ----
    var h0: i64 = 0x6a09e667;
    var h1: i64 = 0xbb67ae85;
    var h2: i64 = 0x3c6ef372;
    var h3: i64 = 0xa54ff53a;
    var h4: i64 = 0x510e527f;
    var h5: i64 = 0x9b05688c;
    var h6: i64 = 0x1f83d9ab;
    var h7: i64 = 0x5be0cd19;

    var blocks: i32 = m.len() / 64;
    var blk: i32 = 0;
    while (blk < blocks) {
        var base: i32 = blk * 64;

        // ---- message schedule W[0..63] ----
        var w: i64[] = [];
        var t: i32 = 0;
        while (t < 16) {
            var p: i32 = base + t * 4;
            var word: i64 = ((m[p] as i64) << 24)
                | ((m[p + 1] as i64) << 16)
                | ((m[p + 2] as i64) << 8)
                | (m[p + 3] as i64);
            w = w.append(word & 0xffffffff);
            t = t + 1;
        }
        while (t < 64) {
            var s0: i64 = sha256_ssig0(w[t - 15]);
            var s1: i64 = sha256_ssig1(w[t - 2]);
            var wt: i64 = (s1 + w[t - 7] + s0 + w[t - 16]) & 0xffffffff;
            w = w.append(wt);
            t = t + 1;
        }

        // ---- compression ----
        var a: i64 = h0;
        var b: i64 = h1;
        var c: i64 = h2;
        var d: i64 = h3;
        var e: i64 = h4;
        var f: i64 = h5;
        var g: i64 = h6;
        var hh: i64 = h7;

        var r: i32 = 0;
        while (r < 64) {
            var t1: i64 = (hh + sha256_bsig1(e) + sha256_ch(e, f, g) + k[r] + w[r]) & 0xffffffff;
            var t2: i64 = (sha256_bsig0(a) + sha256_maj(a, b, c)) & 0xffffffff;
            hh = g;
            g = f;
            f = e;
            e = (d + t1) & 0xffffffff;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) & 0xffffffff;
            r = r + 1;
        }

        h0 = (h0 + a) & 0xffffffff;
        h1 = (h1 + b) & 0xffffffff;
        h2 = (h2 + c) & 0xffffffff;
        h3 = (h3 + d) & 0xffffffff;
        h4 = (h4 + e) & 0xffffffff;
        h5 = (h5 + f) & 0xffffffff;
        h6 = (h6 + g) & 0xffffffff;
        h7 = (h7 + hh) & 0xffffffff;

        blk = blk + 1;
    }

    var out: i32[] = [];
    out = macho_be32_word(out, h0);
    out = macho_be32_word(out, h1);
    out = macho_be32_word(out, h2);
    out = macho_be32_word(out, h3);
    out = macho_be32_word(out, h4);
    out = macho_be32_word(out, h5);
    out = macho_be32_word(out, h6);
    out = macho_be32_word(out, h7);
    return out;
}

// ============================================================
// byte emitters + buffer helpers
// ============================================================

// macho_le32 appends the low 4 bytes of `v`, little-endian.
function macho_le32(buf: i32[], v: i32): i32[] {
    buf = buf.append(v & 255);
    buf = buf.append((v >> 8) & 255);
    buf = buf.append((v >> 16) & 255);
    buf = buf.append((v >> 24) & 255);
    return buf;
}

// macho_le64 appends the 8 bytes of a 64-bit `v`, little-endian.
function macho_le64(buf: i32[], v: i64): i32[] {
    var b: i32 = 0;
    while (b < 8) {
        buf = buf.append(((v >> (b * 8)) & 255) as i32);
        b = b + 1;
    }
    return buf;
}

// macho_be32 appends the low 4 bytes of `v`, big-endian (for code-signing
// blobs, which are big-endian on disk).
function macho_be32(buf: i32[], v: i32): i32[] {
    buf = buf.append((v >> 24) & 255);
    buf = buf.append((v >> 16) & 255);
    buf = buf.append((v >> 8) & 255);
    buf = buf.append(v & 255);
    return buf;
}

// macho_le32w / macho_be32w take the value as i64, for the magic / flag
// constants that exceed the signed-i32 range (e.g. 0xfeedfacf) — the Go
// front-end rejects an out-of-range i32 literal.
function macho_le32w(buf: i32[], v: i64): i32[] {
    buf = buf.append((v & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 24) & 255) as i32);
    return buf;
}
function macho_be32w(buf: i32[], v: i64): i32[] {
    buf = buf.append(((v >> 24) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append((v & 255) as i32);
    return buf;
}

// macho_be64 appends the 8 bytes of a 64-bit `v`, big-endian.
function macho_be64(buf: i32[], v: i64): i32[] {
    var b: i32 = 7;
    while (b >= 0) {
        buf = buf.append(((v >> (b * 8)) & 255) as i32);
        b = b - 1;
    }
    return buf;
}

// macho_name16 writes a 16-byte, NUL-padded segment/section name.
function macho_name16(buf: i32[], s: string): i32[] {
    var i: i32 = 0;
    while (i < s.len()) {
        buf = buf.append((s[i] as i32));
        i = i + 1;
    }
    while (i < 16) {
        buf = buf.append(0);
        i = i + 1;
    }
    return buf;
}

// macho_zeros appends `n` zero bytes.
function macho_zeros(buf: i32[], n: i32): i32[] {
    var i: i32 = 0;
    while (i < n) {
        buf = buf.append(0);
        i = i + 1;
    }
    return buf;
}

// macho_cat appends every byte of `src` to `buf`.
function macho_cat(buf: i32[], src: i32[]): i32[] {
    var i: i32 = 0;
    while (i < src.len()) {
        buf = buf.append(src[i]);
        i = i + 1;
    }
    return buf;
}

// macho_pad_to appends zero bytes until the buffer length reaches `n`.
function macho_pad_to(buf: i32[], n: i32): i32[] {
    while (buf.len() < n) {
        buf = buf.append(0);
    }
    return buf;
}

// ============================================================
// fixed-layout constants
// ============================================================

// macho_page_size is the 16 KiB Mach-O segment alignment on arm64.
function macho_page_size(): i32 { return 16384; }

// macho_base_vaddr is the __TEXT load address (just past __PAGEZERO).
function macho_base_vaddr(): i64 { return 0x100000000; }

// macho_align_up rounds n up to a multiple of the power-of-two a.
function macho_align_up(n: i32, a: i32): i32 {
    return (n + a - 1) & (0 - a);
}

// macho_dylinker_path is the dynamic linker every arm64 main executable
// must name, and macho_libsystem_path the one dylib it loads.
function macho_dylinker_path(): string { return "/usr/lib/dyld"; }
function macho_libsystem_path(): string { return "/usr/lib/libSystem.B.dylib"; }

// macho_lcstr_fixed_len is the size of an lc_str command's fixed part,
// before the path: LC_LOAD_DYLIB carries a timestamp + two versions after
// the name offset, LC_LOAD_DYLINKER carries nothing.
function macho_lcstr_fixed_len(cmd: i32): i32 {
    if (cmd == 12) { return 24; }   // LC_LOAD_DYLIB
    return 12;                      // LC_LOAD_DYLINKER
}

// macho_lcstr_cmd_len is the padded size of an lc_str command carrying
// `path`: the fixed part plus the NUL-terminated path, rounded up to 8.
function macho_lcstr_cmd_len(cmd: i32, path: string): i32 {
    return macho_align_up(macho_lcstr_fixed_len(cmd) + path.len() + 1, 8);
}

// macho_load_cmds_len is the total size of all load commands: __PAGEZERO
// + __TEXT (1 section) + optional __DATA (1 section) + __LINKEDIT +
// LC_DYLD_INFO_ONLY + LC_SYMTAB + LC_DYSYMTAB + LC_BUILD_VERSION +
// LC_LOAD_DYLINKER + LC_LOAD_DYLIB + LC_MAIN + LC_CODE_SIGNATURE.
// (segCmd=72, section=80, dyldInfo=48, symtab=24, dysymtab=80,
// buildVersion=24, main=24, codeSig=16.)
//
// The trailing `+ 48` is 48 bytes of zero slack between the last load
// command and the first code byte: the native writer's loadCommandsLen
// counts dyldInfoCmdLen twice, and this figure is what fixes text_off
// (hence every address), so the two writers agree on layout only if this
// one does too. Removing it belongs in a change that moves both.
function macho_load_cmds_len(has_data: boolean): i32 {
    var n: i32 = 72 + (72 + 80) + 72; // PAGEZERO + TEXT(1 sect) + LINKEDIT
    if (has_data) {
        n = n + (72 + 80); // DATA(1 sect)
    }
    n = n + 48 + 24 + 80 + 24;  // DYLD_INFO_ONLY + SYMTAB + DYSYMTAB + BUILD_VERSION
    n = n + macho_lcstr_cmd_len(14, macho_dylinker_path());
    n = n + macho_lcstr_cmd_len(12, macho_libsystem_path());
    n = n + 24 + 16;            // LC_MAIN + LC_CODE_SIGNATURE
    n = n + 48;                 // slack — see the comment above
    return n;
}

// macho_text_off is the file offset of code within __TEXT (after the
// Mach-O header + load commands). A native assembler needs this to
// resolve @PAGE / @PAGEOFF references before the same blobs are laid out
// here at the same address.
function macho_text_off(has_data: boolean): i32 {
    return 32 + macho_load_cmds_len(has_data);
}

// macho_text_vaddr returns the address of the first code byte (== entry)
// for the given code/data sizes.
pub function macho_text_vaddr(text_len: i32, data_len: i32): i64 {
    var has_data: boolean = data_len > 0;
    return macho_base_vaddr() + (macho_text_off(has_data) as i64);
}

// macho_data_vaddr returns the __DATA segment base for the given
// code/data sizes (0 if there is no data).
pub function macho_data_vaddr(text_len: i32, data_len: i32): i64 {
    if (data_len <= 0) {
        return 0;
    }
    var has_data: boolean = true;
    var text_off: i32 = macho_text_off(has_data);
    var text_vmsize: i32 = macho_align_up(text_off + text_len, macho_page_size());
    return macho_base_vaddr() + (text_vmsize as i64);
}

// ============================================================
// load-command writers
// ============================================================

// macho_seg writes an LC_SEGMENT_64 command header for nsects sections.
function macho_seg(buf: i32[], name: string, vmaddr: i64, vmsize: i64, fileoff: i64, filesize: i64, maxprot: i32, initprot: i32, nsects: i32): i32[] {
    buf = macho_le32(buf, 25); // LC_SEGMENT_64 = 0x19
    buf = macho_le32(buf, 72 + nsects * 80);
    buf = macho_name16(buf, name);
    buf = macho_le64(buf, vmaddr);
    buf = macho_le64(buf, vmsize);
    buf = macho_le64(buf, fileoff);
    buf = macho_le64(buf, filesize);
    buf = macho_le32(buf, maxprot);
    buf = macho_le32(buf, initprot);
    buf = macho_le32(buf, nsects);
    buf = macho_le32(buf, 0); // flags
    return buf;
}

// macho_sect writes a section_64 record.
function macho_sect(buf: i32[], sect: string, seg: string, addr: i64, size: i32, offset: i32, align: i32, flags: i64): i32[] {
    buf = macho_name16(buf, sect);
    buf = macho_name16(buf, seg);
    buf = macho_le64(buf, addr);
    buf = macho_le64(buf, size as i64);
    buf = macho_le32(buf, offset);
    buf = macho_le32(buf, align);
    buf = macho_le32(buf, 0); // reloff
    buf = macho_le32(buf, 0); // nreloc
    buf = macho_le32w(buf, flags);
    buf = macho_le32(buf, 0); // reserved1
    buf = macho_le32(buf, 0); // reserved2
    buf = macho_le32(buf, 0); // reserved3
    return buf;
}

// macho_lcstr writes an lc_str load command (LC_LOAD_DYLINKER /
// LC_LOAD_DYLIB): the command, its padded size, a uint32 offset from the
// start of the command to the NUL-terminated path, then the path itself
// zero-padded out to that size.
function macho_lcstr(buf: i32[], cmd: i32, path: string): i32[] {
    var size: i32 = macho_lcstr_cmd_len(cmd, path);
    var fixed: i32 = macho_lcstr_fixed_len(cmd);
    buf = macho_le32(buf, cmd);
    buf = macho_le32(buf, size);
    buf = macho_le32(buf, fixed);
    if (cmd == 12) {
        buf = macho_le32(buf, 0); // timestamp
        buf = macho_le32(buf, 0); // current_version
        buf = macho_le32(buf, 0); // compatibility_version
    }
    var i: i32 = 0;
    while (i < path.len()) {
        buf = buf.append((path[i] as i32));
        i = i + 1;
    }
    return macho_zeros(buf, size - fixed - path.len());
}

// macho_dyld_info writes LC_DYLD_INFO_ONLY. Only the rebase stream is ever
// populated — the image imports, exports and binds nothing — so every other
// off/size pair is zero.
function macho_dyld_info(buf: i32[], rebase_off: i32, rebase_size: i32): i32[] {
    buf = macho_le32w(buf, 0x80000022); // LC_DYLD_INFO_ONLY | LC_REQ_DYLD
    buf = macho_le32(buf, 48);
    buf = macho_le32(buf, rebase_off);
    buf = macho_le32(buf, rebase_size);
    return macho_zeros(buf, 32); // bind, weak_bind, lazy_bind, export
}

// macho_uleb appends `v` as an unsigned LEB128 (the encoding every operand in
// a dyld opcode stream uses).
function macho_uleb(buf: i32[], v: i32): i32[] {
    var n: i32 = v;
    while (n >= 128) {
        buf = buf.append((n & 127) | 128);
        n = n >> 7;
    }
    return buf.append(n & 127);
}

// macho_rebase_opcodes builds the LC_DYLD_INFO_ONLY rebase stream: the program
// that tells dyld which words to add the image slide to. `seg_idx` is the
// segment the offsets are relative to (2 = __DATA: __PAGEZERO 0, __TEXT 1) and
// `offs` their byte offsets within it.
//
// Three opcodes suffice. SET_TYPE_IMM once (every slot is a plain pointer),
// then per slot SET_SEGMENT_AND_OFFSET_ULEB + DO_REBASE_IMM_TIMES(1). Naming
// the segment and offset again for each slot costs a few bytes over a run-based
// encoding and makes the stream order-independent, so a caller need not sort.
// The stream is padded to a multiple of 8 like every other __LINKEDIT blob.
function macho_rebase_opcodes(seg_idx: i32, offs: i32[]): i32[] {
    if (offs.len() == 0) { return []; }
    var buf: i32[] = [0x10 | 1];        // REBASE_OPCODE_SET_TYPE_IMM | REBASE_TYPE_POINTER
    var i: i32 = 0;
    while (i < offs.len()) {
        buf = buf.append(0x20 | seg_idx); // REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB
        buf = macho_uleb(buf, offs[i]);
        buf = buf.append(0x50 | 1);      // REBASE_OPCODE_DO_REBASE_IMM_TIMES, count 1
        i = i + 1;
    }
    buf = buf.append(0);               // REBASE_OPCODE_DONE
    while ((buf.len() % 8) != 0) {
        buf = buf.append(0);
    }
    return buf;
}

// macho_symtab writes an LC_SYMTAB, and macho_dysymtab an LC_DYSYMTAB with
// every index and count zero. dyld requires LC_DYSYMTAB on a two-level
// image and refuses one that carries it without an LC_SYMTAB, so both are
// present and degenerate: this writer emits no symbols.
function macho_symtab(buf: i32[], symoff: i32, nsyms: i32, stroff: i32, strsize: i32): i32[] {
    buf = macho_le32(buf, 2);  // LC_SYMTAB
    buf = macho_le32(buf, 24);
    buf = macho_le32(buf, symoff);
    buf = macho_le32(buf, nsyms);
    buf = macho_le32(buf, stroff);
    return macho_le32(buf, strsize);
}

function macho_dysymtab(buf: i32[]): i32[] {
    buf = macho_le32(buf, 11); // LC_DYSYMTAB
    buf = macho_le32(buf, 80);
    return macho_zeros(buf, 72); // 18 index/count uint32 pairs
}

// macho_build_version writes LC_BUILD_VERSION declaring the image as
// macOS. Apple Silicon's kernel SIGKILLs an arm64 main executable that
// names no platform — a valid ad-hoc signature is not sufficient on its
// own. minos / sdk are nibble-encoded XXXX.YY.ZZ; 11.0.0 is the first
// macOS with Apple Silicon, the floor for an arm64 executable. ntools is
// 0: the tool-version list is informational.
function macho_build_version(buf: i32[]): i32[] {
    buf = macho_le32(buf, 50); // LC_BUILD_VERSION = 0x32
    buf = macho_le32(buf, 24);
    buf = macho_le32(buf, 1);         // PLATFORM_MACOS
    buf = macho_le32(buf, 0x000b0000); // minos 11.0.0
    buf = macho_le32(buf, 0x000b0000); // sdk 11.0.0
    return macho_le32(buf, 0);        // ntools
}

// macho_main writes LC_MAIN. entryoff is a FILE offset from the start of
// the mach header, not a VM address — dyld adds the image's load address
// itself, which is what makes the entry survive a slide.
function macho_main(buf: i32[], entryoff: i32): i32[] {
    buf = macho_le32w(buf, 0x80000028); // LC_MAIN | LC_REQ_DYLD
    buf = macho_le32(buf, 24);
    buf = macho_le64(buf, entryoff as i64);
    return macho_le64(buf, 0); // stacksize: 0 = system default
}

// ============================================================
// code signature
// ============================================================

// macho_sig_len computes the signature length analytically (it depends
// only on code_limit and the identifier length, not on the content), so
// the LC_CODE_SIGNATURE command + __LINKEDIT sizing can be emitted before
// the hashes are known.
function macho_sig_len(code_limit: i32, ident_len: i32): i32 {
    var id_len: i32 = ident_len + 1; // + NUL terminator
    var hash_off: i32 = 88 + id_len; // cdHeaderLen + identifier
    var n_slots: i32 = (code_limit + 4095) / 4096;
    var cd_len: i32 = hash_off + n_slots * 32;
    return 20 + cd_len; // SuperBlob header (12) + 1 BlobIndex (8) + CD
}

// macho_code_signature builds an ad-hoc CSMAGIC_EMBEDDED_SIGNATURE
// SuperBlob containing one CodeDirectory whose code-slot hashes are
// SHA-256 of each 4 KiB page of content[0:code_limit]. exec_seg_limit is
// the size of the executable (__TEXT) segment.
function macho_code_signature(content: i32[], code_limit: i32, exec_seg_limit: i32, ident: string): i32[] {
    var id_len: i32 = ident.len() + 1;
    var hash_off: i32 = 88 + id_len;
    var n_slots: i32 = (code_limit + 4095) / 4096;
    var cd_len: i32 = hash_off + n_slots * 32;
    var total: i32 = 20 + cd_len;

    var sb: i32[] = [];
    // ---- SuperBlob header + one BlobIndex ----
    sb = macho_be32w(sb, 0xfade0cc0); // CSMAGIC_EMBEDDED_SIGNATURE
    sb = macho_be32(sb, total);
    sb = macho_be32(sb, 1);          // sub-blob count
    sb = macho_be32(sb, 0);          // CSSLOT_CODEDIRECTORY
    sb = macho_be32(sb, 20);         // offset of the CodeDirectory

    // ---- CodeDirectory ----
    sb = macho_be32w(sb, 0xfade0c02); // CSMAGIC_CODEDIRECTORY
    sb = macho_be32(sb, cd_len);
    sb = macho_be32(sb, 0x20400);    // version (supports execSeg fields)
    sb = macho_be32(sb, 2);          // CS_ADHOC
    sb = macho_be32(sb, hash_off);   // hashOffset
    sb = macho_be32(sb, 88);         // identOffset
    sb = macho_be32(sb, 0);          // nSpecialSlots
    sb = macho_be32(sb, n_slots);    // nCodeSlots
    sb = macho_be32(sb, code_limit); // codeLimit
    sb = sb.append(32);                // hashSize (SHA-256)
    sb = sb.append(2);                 // hashType = SHA-256
    sb = sb.append(0);                 // platform
    sb = sb.append(12);                // log2(pageSize) = 4096
    sb = macho_zeros(sb, 24);        // spare2 / scatter / team / spare3 / codeLimit64
    sb = macho_be64(sb, 0);          // execSegBase
    sb = macho_be64(sb, exec_seg_limit as i64); // execSegLimit
    sb = macho_be64(sb, 1);          // execSegFlags = CS_EXECSEG_MAIN_BINARY

    // identifier + NUL
    var i: i32 = 0;
    while (i < ident.len()) {
        sb = sb.append((ident[i] as i32));
        i = i + 1;
    }
    sb = sb.append(0);

    // page hashes
    var slot: i32 = 0;
    while (slot < n_slots) {
        var pstart: i32 = slot * 4096;
        var pend: i32 = pstart + 4096;
        if (pend > code_limit) {
            pend = code_limit;
        }
        var dig: i32[] = sha256_bytes(content, pstart, pend - pstart);
        var j: i32 = 0;
        while (j < 32) {
            sb = sb.append(dig[j]);
            j = j + 1;
        }
        slot = slot + 1;
    }
    return sb;
}

// ============================================================
// the image writer
// ============================================================

// macho_entry_off resolves the entry offset to pass to macho_executable:
// the `_main` label's offset in the assembled text, or 0 for a hand-built
// snippet that has no such label and whose entry is its first byte.
pub function macho_entry_off(a: Arm64Asm): i32 {
    var off: i32 = arm64_asm_label_off(a, "_main");
    if (off < 0) { return 0; }
    return off;
}

// macho_executable wraps machine code and a data blob into a runnable,
// ad-hoc-signed, dyld-loaded PIE arm64 Mach-O executable. Code occupies
// the r-x __TEXT segment; data (read-only constants + writable globals,
// merged by the assembler) occupies a r/w __DATA segment. `ident` is the
// ad-hoc signing identifier (any short string).
//
// `entry_off` is the entry's offset within `text`, the Mach-O sibling of
// elf_image_entry's parameter and needed for the same reason: the arm64
// emitter writes `_main` AFTER the user's functions, so the first code
// byte is some arbitrary function. Pass 0 only when the entry really is
// the first byte. Getting this wrong does not fail to launch — dyld calls
// whatever function is there, which returns a plausible-looking exit
// code, so a single-function program still "passes" and a multi-function
// one silently runs the wrong body.
//
// `bss` is the zero-init tail past the data bytes — the Mach-O sibling of
// elf_image_entry_bss's parameter. arm64_gas_link resolves a .bss symbol to
// `data_vaddr + data.len() + bss_off`, so __DATA's vmsize must cover it
// while its filesize stays at the bytes actually in the file; the kernel
// zero-fills the difference. Omit it and every symbol past the emitter's
// `.skip` reservations (the 64 MiB strbuf, the freelists) resolves outside
// the mapped segment: reads and writes there fault, and because the
// affected symbols sit at the tail, the failure looks like a bug in
// whatever runtime helper happens to touch one first.
//
// bss is only honoured when there IS data, matching macho_data_vaddr's
// has_data test so the linker and the container agree on the layout. The
// arm64 emitter always emits initialized data (rodata pools + globals)
// alongside its bss, so a bss-only image cannot arise here.
//
// `rebase_offs` names every 8-byte slot in `data` that holds an ABSOLUTE
// address (arm64_gas_rebase_offs — the assembler's `.quad <symbol>` slots).
// dyld slides a PIE image, so each of those needs the slide added; the
// LC_DYLD_INFO_ONLY rebase stream is how the image asks for that. Pass an
// empty array when the data blob holds no absolute addresses.
pub function macho_executable(text: i32[], data: i32[], ident: string, entry_off: i32, bss: i32, rebase_offs: i32[]): i32[] {
    var has_data: boolean = data.len() > 0;
    var text_len: i32 = text.len();
    var data_len: i32 = data.len();
    var text_off: i32 = macho_text_off(has_data);
    var page: i32 = macho_page_size();
    var text_vmsize: i32 = macho_align_up(text_off + text_len, page);
    var data_file_len: i32 = 0;
    var data_vm_len: i32 = 0;
    if (has_data) {
        data_file_len = macho_align_up(data_len, page);
        data_vm_len = macho_align_up(data_len + bss, page);
    }
    // __LINKEDIT holds the rebase stream first, then the code signature. The
    // signed region (code_limit) must cover the stream, so the signature
    // starts at the 16-aligned end of it. With no rebases the stream is empty
    // and sig_off lands exactly where it used to, so those images are
    // byte-identical to before.
    var rebase: i32[] = [];
    if (has_data) {
        rebase = macho_rebase_opcodes(2, rebase_offs);
    }
    var linkedit_off: i32 = text_vmsize + data_file_len;
    var code_limit: i32 = macho_align_up(linkedit_off + rebase.len(), 16);

    var base: i64 = macho_base_vaddr();
    var text_vaddr: i64 = base + (text_off as i64);
    var data_vaddr: i64 = base + (text_vmsize as i64);
    var linkedit_vaddr: i64 = data_vaddr + (data_vm_len as i64);

    var sig_len: i32 = macho_sig_len(code_limit, ident.len());
    var linkedit_file_len: i32 = (code_limit - linkedit_off) + sig_len;
    var linkedit_vmsize: i32 = macho_align_up(linkedit_file_len, page);

    var ncmds: i32 = 11;
    if (has_data) {
        ncmds = 12;
    }
    // sizeofcmds is the size of the commands ACTUALLY written, which is
    // macho_load_cmds_len minus its 48 bytes of layout slack.
    var sizeofcmds: i32 = macho_load_cmds_len(has_data) - 48;

    var buf: i32[] = [];

    // ---- Mach-O header (32 bytes) ----
    buf = macho_le32w(buf, 0xfeedfacf); // MH_MAGIC_64
    buf = macho_le32(buf, 0x0100000c); // CPU_TYPE_ARM64
    buf = macho_le32(buf, 0);          // CPU_SUBTYPE_ARM64_ALL
    buf = macho_le32(buf, 2);          // MH_EXECUTE
    buf = macho_le32(buf, ncmds);
    buf = macho_le32(buf, sizeofcmds);
    // MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE. MH_PIE is the one
    // the kernel checks before dyld runs at all.
    buf = macho_le32(buf, 0x00200085);
    buf = macho_le32(buf, 0);          // reserved

    // ---- __PAGEZERO ----
    buf = macho_seg(buf, "__PAGEZERO", 0, base, 0, 0, 0, 0, 0);

    // ---- __TEXT (r-x), 1 section ----
    buf = macho_seg(buf, "__TEXT", base, text_vmsize as i64, 0, text_vmsize as i64, 5, 5, 1);
    // flags = S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    buf = macho_sect(buf, "__text", "__TEXT", text_vaddr, text_len, text_off, 2, 0x80000400);

    // ---- __DATA (r/w), 1 section (optional) ----
    if (has_data) {
        // vmsize covers the zero-init bss tail; filesize is just the bytes on
        // disk. The __data section stays the initialized part.
        buf = macho_seg(buf, "__DATA", data_vaddr, data_vm_len as i64, text_vmsize as i64, data_file_len as i64, 3, 3, 1);
        buf = macho_sect(buf, "__data", "__DATA", data_vaddr, data_len, text_vmsize, 3, 0);
    }

    // ---- __LINKEDIT (r) ----
    buf = macho_seg(buf, "__LINKEDIT", linkedit_vaddr, linkedit_vmsize as i64, linkedit_off as i64, linkedit_file_len as i64, 1, 1, 0);

    // ---- the dyld command set (see the module comment) ----
    buf = macho_dyld_info(buf, linkedit_off, rebase.len());
    buf = macho_symtab(buf, 0, 0, 0, 0);
    buf = macho_dysymtab(buf);
    buf = macho_build_version(buf);
    buf = macho_lcstr(buf, 14, macho_dylinker_path()); // LC_LOAD_DYLINKER
    buf = macho_lcstr(buf, 12, macho_libsystem_path()); // LC_LOAD_DYLIB
    buf = macho_main(buf, text_off + entry_off);

    // ---- LC_CODE_SIGNATURE ----
    buf = macho_le32(buf, 29);         // LC_CODE_SIGNATURE = 0x1d
    buf = macho_le32(buf, 16);         // cmdsize
    buf = macho_le32(buf, code_limit); // dataoff
    buf = macho_le32(buf, sig_len);    // datasize

    // ---- code + data ----
    // pad_to closes the 48-byte slack macho_load_cmds_len reserves past
    // the last load command, so code starts at text_off.
    buf = macho_pad_to(buf, text_off);
    buf = macho_cat(buf, text);
    buf = macho_pad_to(buf, text_vmsize);
    if (has_data) {
        buf = macho_cat(buf, data);
        buf = macho_pad_to(buf, linkedit_off);
    }
    buf = macho_cat(buf, rebase);
    buf = macho_pad_to(buf, code_limit);
    // buf length is now code_limit; sign it and append the signature.
    var sig: i32[] = macho_code_signature(buf, code_limit, text_vmsize, ident);
    buf = macho_cat(buf, sig);
    return buf;
}
