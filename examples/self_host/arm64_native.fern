// BEGIN GENERATED ARM64 VFP2_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
// arm64_vfp2_entry: two-register lane-wise FP, same szHi convention.
function arm64_vfp2_entry(mnem: string): i32 {
