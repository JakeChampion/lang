// arm64_gas_scalar_class decodes a bN/hN/sN/dN scalar SIMD register to its
// element-size class (0=B, 1=H, 2=S, 3=D), or -1. arm64_gas_scalar_reg gives
// the number.
function arm64_gas_scalar_class(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    if (t.len() < 2) { return 0 - 1; }
    var c: i32 = t[0] as i32;
    var cls: i32 = 0 - 1;
    if (c == 98) { cls = 0; }        // 'b'
    if (c == 104) { cls = 1; }       // 'h'
    if (c == 115) { cls = 2; }       // 's'
    if (c == 100) { cls = 3; }       // 'd'
    if (cls < 0) { return 0 - 1; }
    if (arm64_gas_scalar_reg(tok) < 0) { return 0 - 1; }
    return cls;
