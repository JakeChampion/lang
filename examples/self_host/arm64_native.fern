// arm64_gas_esize is the element width in bits of an arrangement.
function arm64_gas_esize(code: i32): i32 {
    return 8 * arm64_gas_pow2(arm64_gas_arr_size(code));
}

// ---- the lane-move and load-structure classes (#8000 wave 2d) ----
//
// These address ONE LANE rather than a whole arrangement, and every one of
// them says which lane in the same field: imm5 packs the element size and the
// index together as (index<<1 | 1) << size, so the size is recoverable from
// the position of the lowest set bit. Get the size wrong and the index is
// wrong too, on a word that still decodes.

// arm64_gas_lane_size decodes the element letter of a `vN.<Ts>[i]` lane
// operand to 0=B, 1=H, 2=S, 3=D, or -1 when the token is not a lane.
function arm64_gas_lane_size(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    var dot: i32 = arm64_str_indexof(t, ".");
    var ob: i32 = arm64_str_indexof(t, "[");
    if (t.len() < 5 || t[0] != b'v' || dot < 2 || ob < dot || t[t.len() - 1] != b']') { return 0 - 1; }
    if (ob != dot + 2) { return 0 - 1; }
    var c: i32 = t[dot + 1] as i32;
    if (c == 98) { return 0; }    // 'b'
    if (c == 104) { return 1; }   // 'h'
    if (c == 115) { return 2; }   // 's'
    if (c == 100) { return 3; }   // 'd'
    return 0 - 1;
}
function arm64_gas_lane_reg(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    if (arm64_gas_lane_size(tok) < 0) { return 0 - 1; }
    var dot: i32 = arm64_str_indexof(t, ".");
    var n: i32 = 0;
    var i: i32 = 1;
    while (i < dot) {
        var c: i32 = t[i] as i32;
        if (c < 48 || c > 57) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if (n > 31) { return 0 - 1; }
    return n;
}
function arm64_gas_lane_index(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    var size: i32 = arm64_gas_lane_size(tok);
    if (size < 0) { return 0 - 1; }
    var ob: i32 = arm64_str_indexof(t, "[");
    var n: i32 = 0;
    var i: i32 = ob + 1;
    if (i >= t.len() - 1) { return 0 - 1; }
    while (i < t.len() - 1) {
        var c: i32 = t[i] as i32;
        if (c < 48 || c > 57) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    // A lane index runs 0..(16/esize - 1), which is 15>>size.
    if (n > 15 / arm64_gas_pow2(size)) { return 0 - 1; }
    return n;
