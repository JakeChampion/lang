// END GENERATED ARM64 V3INT_ENTRY TABLE

// BEGIN GENERATED ARM64 VLOGICAL_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
// The bitwise three-register ops put the operation in the size field, so they
// exist only in the byte arrangements. The entry carries that operation
// selector in the opcode slot; the real opcode is always 3.
function arm64_vlogical_entry(mnem: string): i32 {
    if (mnem == "and") { return arm64_vec_entry(false, 0, 1); }
    if (mnem == "bic") { return arm64_vec_entry(false, 1, 1); }
    if (mnem == "orr") { return arm64_vec_entry(false, 2, 1); }
    if (mnem == "orn") { return arm64_vec_entry(false, 3, 1); }
    if (mnem == "eor") { return arm64_vec_entry(true, 0, 1); }
    return 0 - 1;
}
// END GENERATED ARM64 VLOGICAL_ENTRY TABLE

// BEGIN GENERATED ARM64 VCMPZERO_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
// Compare against zero. cmle/cmlt exist ONLY in this form — their
// register-operand spellings are the swapped-operand cmge/cmgt.
function arm64_vcmpzero_entry(mnem: string): i32 {
    if (mnem == "cmeq") { return arm64_vec_entry(false, 9, 15); }
    if (mnem == "cmgt") { return arm64_vec_entry(false, 8, 15); }
    if (mnem == "cmge") { return arm64_vec_entry(true, 8, 15); }
    if (mnem == "cmle") { return arm64_vec_entry(true, 9, 15); }
    if (mnem == "cmlt") { return arm64_vec_entry(false, 10, 15); }
