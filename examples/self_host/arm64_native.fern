// BEGIN GENERATED ARM64 VFPCMPZERO_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
// FP compare against zero, whose operand is spelled `#0.0`. szHi is always
// set for this class, so the entry needs no flag. fcmle/fcmlt exist ONLY
// here — their register-operand spellings are the swapped-operand
// fcmge/fcmgt.
function arm64_vfpcmpzero_entry(mnem: string): i32 {
    if (mnem == "fcmeq") { return arm64_vec_entry(false, 13, 0); }
    if (mnem == "fcmgt") { return arm64_vec_entry(false, 12, 0); }
    if (mnem == "fcmge") { return arm64_vec_entry(true, 12, 0); }
    if (mnem == "fcmle") { return arm64_vec_entry(true, 13, 0); }
    if (mnem == "fcmlt") { return arm64_vec_entry(false, 14, 0); }
    return 0 - 1;
}
// END GENERATED ARM64 VFPCMPZERO_ENTRY TABLE

// BEGIN GENERATED ARM64 VSHIFT_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
// Shift by immediate. The size-mask slot carries the direction: 1 = left.
function arm64_vshift_entry(mnem: string): i32 {
    if (mnem == "shl") { return arm64_vec_entry(false, 10, 1); }
    if (mnem == "sli") { return arm64_vec_entry(true, 10, 1); }
    if (mnem == "sshr") { return arm64_vec_entry(false, 0, 0); }
    if (mnem == "ushr") { return arm64_vec_entry(true, 0, 0); }
    if (mnem == "sri") { return arm64_vec_entry(true, 8, 0); }
    return 0 - 1;
}
// END GENERATED ARM64 VSHIFT_ENTRY TABLE

// BEGIN GENERATED ARM64 VPERMUTE_OPC TABLE (cmd/arm64tblgen) — do not edit by hand.
function arm64_vpermute_opc(mnem: string): i32 {
    if (mnem == "zip1") { return 3; }
    if (mnem == "zip2") { return 7; }
    if (mnem == "uzp1") { return 1; }
    if (mnem == "uzp2") { return 5; }
    if (mnem == "trn1") { return 2; }
    if (mnem == "trn2") { return 6; }
    return 0 - 1;
}
// END GENERATED ARM64 VPERMUTE_OPC TABLE

// arm64_gas_esize is the element width in bits of an arrangement.
function arm64_gas_esize(code: i32): i32 {
    return 8 * arm64_gas_pow2(arm64_gas_arr_size(code));
}

// ---- the lane-move and load-structure classes (#8000 wave 2d) ----
//
// These address ONE LANE rather than a whole arrangement, and every one of
// them says which lane in the same field: imm5 packs the element size and the
// index together as (index<<1 | 1) << size, so the size is recoverable from
// the position of the lowest set bit. Get the size wrong and the index is
// wrong too, on a word that still decodes.

// arm64_gas_lane_size decodes the element letter of a `vN.<Ts>[i]` lane
// operand to 0=B, 1=H, 2=S, 3=D, or -1 when the token is not a lane.
function arm64_gas_lane_size(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    var dot: i32 = arm64_str_indexof(t, ".");
    var ob: i32 = arm64_str_indexof(t, "[");
    if (t.len() < 5 || t[0] != b'v' || dot < 2 || ob < dot || t[t.len() - 1] != b']') { return 0 - 1; }
    if (ob != dot + 2) { return 0 - 1; }
    var c: i32 = t[dot + 1] as i32;
    if (c == 98) { return 0; }    // 'b'
    if (c == 104) { return 1; }   // 'h'
    if (c == 115) { return 2; }   // 's'
    if (c == 100) { return 3; }   // 'd'
    return 0 - 1;
}
function arm64_gas_lane_reg(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    if (arm64_gas_lane_size(tok) < 0) { return 0 - 1; }
    var dot: i32 = arm64_str_indexof(t, ".");
    var n: i32 = 0;
    var i: i32 = 1;
    while (i < dot) {
        var c: i32 = t[i] as i32;
        if (c < 48 || c > 57) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if (n > 31) { return 0 - 1; }
    return n;
}
function arm64_gas_lane_index(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    var size: i32 = arm64_gas_lane_size(tok);
    if (size < 0) { return 0 - 1; }
    var ob: i32 = arm64_str_indexof(t, "[");
    var n: i32 = 0;
    var i: i32 = ob + 1;
    if (i >= t.len() - 1) { return 0 - 1; }
    while (i < t.len() - 1) {
        var c: i32 = t[i] as i32;
        if (c < 48 || c > 57) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    // A lane index runs 0..(16/esize - 1), which is 15>>size.
    if (n > 15 / arm64_gas_pow2(size)) { return 0 - 1; }
    return n;
}

// arm64_vec_imm5 packs an element size and lane index into the imm5 field:
// (index<<1 | 1) << size, so the size is the position of the lowest set bit.
function arm64_vec_imm5(size: i32, index: i32): i32 {
    return (index * 2 + 1) * arm64_gas_pow2(size);
}

// umov/smov move one lane to a general register; ins moves a general register
// or another lane INTO one. All four share the imm5 field.
//   umov 0x0E003C00, smov 0x0E002C00, ins-from-GPR 0x4E001C00
//   (ins is always Q=1: it writes into the 128-bit register)
function arm64_vecmovlane(buf: i32[], base: i64, rd: i32, rn: i32, imm5: i32, q: boolean): i32[] {
    var word: i64 = base | (((imm5 & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (q) { word = word | 0x40000000; }
    return arm64_le32(buf, word);
}

// ins Vd.<Ts>[i], Vn.<Ts>[j] — lane to lane. imm4 is the SOURCE index scaled
// by the element size, in a field the GPR form does not have.
//   0x6E000400 | imm5<<16 | imm4<<11 | Rn<<5 | Rd
function arm64_vecinselem(buf: i32[], rd: i32, rn: i32, imm5: i32, imm4: i32): i32[] {
    return arm64_le32(buf, 0x6e000400 | (((imm5 & 31) as i64) << 16) | (((imm4 & 15) as i64) << 11)
        | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}

// dup broadcasts a general register or one lane across every lane.
//   from GPR  0x0E000C00 | Q<<30 | imm5<<16 | Rn<<5 | Rd, imm5 = 1<<size
//   from lane 0x0E000400 | Q<<30 | imm5<<16 | Rn<<5 | Rd
function arm64_vecdup(buf: i32[], base: i64, rd: i32, rn: i32, imm5: i32, q: boolean): i32[] {
    var word: i64 = base | (((imm5 & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (q) { word = word | 0x40000000; }
    return arm64_le32(buf, word);
}

// movi Vd.<T>, #imm8{, lsl #shift} — the modified immediate. cmode says which
// BYTE POSITION of each element the imm8 lands in, so the shift is not a
// shift field: it selects the cmode. The .2d form is different again — each
// bit of imm8 expands to a whole byte of 0x00 or 0xff.
//   0x0F000400 | Q<<30 | op<<29 | abc<<16 | cmode<<12 | defgh<<5 | Rd
function arm64_vecmovi(buf: i32[], rd: i32, imm8: i32, cmode: i32, q: boolean, op: boolean): i32[] {
    var abc: i64 = ((imm8 / 32) & 7) as i64;
    var defgh: i64 = (imm8 & 31) as i64;
    var word: i64 = 0x0f000400 | (abc << 16) | (((cmode & 15) as i64) << 12) | (defgh << 5) | ((rd & 31) as i64);
    if (q) { word = word | 0x40000000; }
    if (op) { word = word | 0x20000000; }
    return arm64_le32(buf, word);
}

// The single-register load/store-structure forms, `[Xn]` with no offset:
//   ld1r 0x0D40C000, ld1 0x0C407000, st1 0x0C007000, each | Q<<30 | size<<10
function arm64_vecldst1(buf: i32[], base: i64, rt: i32, rn: i32, size: i32, q: boolean): i32[] {
    var word: i64 = base | (((size & 3) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64);
    if (q) { word = word | 0x40000000; }
    return arm64_le32(buf, word);
}

// ---- the narrowing / widening / across-lanes classes (#8000 wave 2c) ----

// arm64_vecext encodes `ext Vd.<T>, Vn.<T>, Vm.<T>, #index` — the byte-wise
// extract from a register pair, NEON's sliding window and palignr's
// counterpart. Byte arrangements only; the index counts bytes.
//   0x2E000000 | Q<<30 | Rm<<16 | index<<11 | Rn<<5 | Rd
function arm64_vecext(buf: i32[], rd: i32, rn: i32, rm: i32, index: i32, q: boolean): i32[] {
    var word: i64 = 0x2e000000 | (((rm & 31) as i64) << 16) | (((index & 15) as i64) << 11)
        | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (q) { word = word | 0x40000000; }
    return arm64_le32(buf, word);
}

// arm64_vectbl1 encodes `tbl Vd.<T>, {Vn.16b}, Vm.<T>` — the single-table
// byte shuffle, pshufb's counterpart. The table is always .16b.
//   0x0E000000 | Q<<30 | Rm<<16 | Rn<<5 | Rd
function arm64_vectbl1(buf: i32[], rd: i32, rn: i32, rm: i32, q: boolean): i32[] {
    var word: i64 = 0x0e000000 | (((rm & 31) as i64) << 16)
        | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (q) { word = word | 0x40000000; }
    return arm64_le32(buf, word);
}

// arm64_vecacross encodes the across-lanes reductions: a horizontal fold of
// every lane into a scalar register.
//   0x0E300800 | Q<<30 | U<<29 | size<<22 | opcode<<12 | Rn<<5 | Rd
function arm64_vecacross(buf: i32[], rd: i32, rn: i32, opcode: i32, size: i32, q: boolean, u: boolean): i32[] {
    var word: i64 = 0x0e300800 | (((size & 3) as i64) << 22)
        | (((opcode & 31) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    if (q) { word = word | 0x40000000; }
    if (u) { word = word | 0x20000000; }
    return arm64_le32(buf, word);
}

// BEGIN GENERATED ARM64 ACROSS_ENTRY TABLE (cmd/arm64tblgen) — do not edit by hand.
// arm64_across_entry: the across-lanes table. The size-mask slot carries the
// WIDENING flag — saddlv/uaddlv produce a result one element size up, so
// their scalar destination is a class wider than the arrangement.
function arm64_across_entry(mnem: string): i32 {
    if (mnem == "addv") { return arm64_vec_entry(false, 27, 0); }
    if (mnem == "smaxv") { return arm64_vec_entry(false, 10, 0); }
    if (mnem == "sminv") { return arm64_vec_entry(false, 26, 0); }
    if (mnem == "umaxv") { return arm64_vec_entry(true, 10, 0); }
    if (mnem == "uminv") { return arm64_vec_entry(true, 26, 0); }
    if (mnem == "saddlv") { return arm64_vec_entry(false, 3, 1); }
    if (mnem == "uaddlv") { return arm64_vec_entry(true, 3, 1); }
    return 0 - 1;
}
// END GENERATED ARM64 ACROSS_ENTRY TABLE

// arm64_gas_scalar_class decodes a bN/hN/sN/dN scalar SIMD register to its
// element-size class (0=B, 1=H, 2=S, 3=D), or -1. arm64_gas_scalar_reg gives
// the number.
function arm64_gas_scalar_class(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    if (t.len() < 2) { return 0 - 1; }
    var c: i32 = t[0] as i32;
    var cls: i32 = 0 - 1;
    if (c == 98) { cls = 0; }        // 'b'
    if (c == 104) { cls = 1; }       // 'h'
    if (c == 115) { cls = 2; }       // 's'
    if (c == 100) { cls = 3; }       // 'd'
    if (cls < 0) { return 0 - 1; }
    if (arm64_gas_scalar_reg(tok) < 0) { return 0 - 1; }
    return cls;
}
function arm64_gas_scalar_reg(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    if (t.len() < 2) { return 0 - 1; }
    var n: i32 = 0;
    var i: i32 = 1;
    while (i < t.len()) {
        var c: i32 = t[i] as i32;
        if (c < 48 || c > 57) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if (n > 31) { return 0 - 1; }
    return n;
}

// arm64_gas_vlist_one decodes a `{vN.16b}` single-register list. The braces
// are part of the syntax rather than decoration: accepting a bare `vN.16b`
// would let a typo assemble as a different instruction.
function arm64_gas_vlist_one(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    if (t.len() < 3 || t[0] != b'{' || t[t.len() - 1] != b'}') { return 0 - 1; }
    return arm64_gas_vreg_any(slice_unchecked(t, 1, t.len() - 1) + "");
}
function arm64_gas_vlist_one_arr(tok: string): i32 {
    var t: string = arm64_gas_trim(tok);
    if (t.len() < 3 || t[0] != b'{' || t[t.len() - 1] != b'}') { return 0 - 1; }
    return arm64_gas_vreg_arrof(slice_unchecked(t, 1, t.len() - 1) + "");
}

// arm64_gas_narrow_wide_ok validates the arrangement pair of a narrowing or
// widening op. The NARROW side is the half-width arrangement and its Q bit is
// the `2` suffix — it selects which half of the 128-bit register is touched,
// so it is not free to disagree with the mnemonic. The wide side is always
// full-width and exactly one element size up.
function arm64_gas_narrow_wide_ok(narrow: i32, wide: i32, hi: boolean): boolean {
    if (narrow < 0 || wide < 0) { return false; }
    if (arm64_gas_arr_size(narrow) > 2) { return false; }
    if (arm64_gas_arr_q(narrow) != hi) { return false; }
    if (arm64_gas_arr_size(wide) != arm64_gas_arr_size(narrow) + 1) { return false; }
    return arm64_gas_arr_q(wide);
}

// arm64_gas_shll_kind maps the widening shift mnemonics to a packed
// (unsigned, high-half, alias) triple: bit 0 = unsigned, bit 1 = the `2`
// suffix, bit 2 = an sxtl/uxtl alias, which is the same instruction with the
// shift fixed at zero and no immediate operand. -1 = not one of them.
function arm64_gas_shll_kind(mnem: string): i32 {
    if (mnem == "sshll") { return 0; }
    if (mnem == "sshll2") { return 2; }
    if (mnem == "ushll") { return 1; }
    if (mnem == "ushll2") { return 3; }
    if (mnem == "sxtl") { return 4; }
    if (mnem == "sxtl2") { return 6; }
    if (mnem == "uxtl") { return 5; }
    if (mnem == "uxtl2") { return 7; }
    return 0 - 1;
}

// arm64_gas_vecgen_handles reports whether a mnemonic has a form in one of
// the four general families above.
function arm64_gas_vecgen_handles(mnem: string): boolean {
    return arm64_v3int_entry(mnem) >= 0 || arm64_vlogical_entry(mnem) >= 0
        || arm64_vcmpzero_entry(mnem) >= 0 || arm64_v2misc_entry(mnem) >= 0
        || arm64_vfp3_entry(mnem) >= 0 || arm64_vfp2_entry(mnem) >= 0
        || arm64_vfpcmpzero_entry(mnem) >= 0 || arm64_vshift_entry(mnem) >= 0
        || arm64_vpermute_opc(mnem) >= 0 || arm64_gas_shll_kind(mnem) >= 0
        || mnem == "xtn" || mnem == "xtn2" || mnem == "shrn" || mnem == "shrn2"
        || mnem == "ext" || mnem == "tbl";
}

// arm64_gas_emit_narrowwide encodes the narrowing and widening shifts. Their
// two arrangements differ by one element size, which arm64_gas_bad_narrowwide
// has already checked, so the encoders read only the one that names the
// instruction's own element size: the NARROW side for xtn/shrn (the result),
// the narrow SOURCE for sshll/uxtl (the input).
function arm64_gas_emit_narrowwide(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (mnem == "xtn" || mnem == "xtn2") {
        if (ops.len() != 2) { return a; }
        var xc: i32 = arm64_gas_vreg_arrof(ops[0]);
        return Arm64Asm { ...a, code: arm64_vec2misc(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            18, arm64_gas_arr_size(xc), arm64_gas_arr_q(xc), false) };
    }
    if (mnem == "shrn" || mnem == "shrn2") {
        if (ops.len() != 3) { return a; }
        var nc: i32 = arm64_gas_vreg_arrof(ops[0]);
        var nes: i32 = arm64_gas_esize(nc);
        return Arm64Asm { ...a, code: arm64_vecshift(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            16, 2 * nes - arm64_gas_imm(ops[2]), arm64_gas_arr_q(nc), false) };
    }
    var kind: i32 = arm64_gas_shll_kind(mnem);
    var alias: boolean = kind >= 4;
    if (ops.len() != 3 && !alias) { return a; }
    if (ops.len() != 2 && alias) { return a; }
    var sc: i32 = arm64_gas_vreg_arrof(ops[1]);
    var amt: i32 = 0;
    if (!alias) { amt = arm64_gas_imm(ops[2]); }
    return Arm64Asm { ...a, code: arm64_vecshift(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
        20, arm64_gas_esize(sc) + amt, (kind % 4) >= 2, kind % 2 == 1) };
}

// arm64_gas_emit_vecgen encodes one of them. Operand shapes are vetted by
// arm64_gas_bad_vecgen before the program loop reaches here, so anything it
// could not express has already been recorded and refused; the arity guards
// are the same belt-and-braces every emitter here carries, because the loop
// still calls through after recording.
function arm64_gas_emit_vecgen(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    var czero: i32 = arm64_vcmpzero_entry(mnem);
    var three: i32 = arm64_v3int_entry(mnem);
    if (czero >= 0 && (three < 0 || (ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#'))) {
        if (ops.len() != 3) { return a; }
        var cc: i32 = arm64_gas_vreg_arrof(ops[0]);
        return Arm64Asm { ...a, code: arm64_vec2misc(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            arm64_vec_entry_op(czero), arm64_gas_arr_size(cc), arm64_gas_arr_q(cc), arm64_vec_entry_u(czero)) };
    }
    if (three >= 0) {
        if (ops.len() != 3) { return a; }
        var tc: i32 = arm64_gas_vreg_arrof(ops[0]);
        return Arm64Asm { ...a, code: arm64_vec3same(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            arm64_gas_vreg_any(ops[2]), arm64_vec_entry_op(three), arm64_gas_arr_size(tc), arm64_gas_arr_q(tc), arm64_vec_entry_u(three)) };
    }
    var logic: i32 = arm64_vlogical_entry(mnem);
    if (logic >= 0) {
        if (ops.len() != 3) { return a; }
        var lc: i32 = arm64_gas_vreg_arrof(ops[0]);
        // The operation lives in the size field here; the opcode is always 3.
        return Arm64Asm { ...a, code: arm64_vec3same(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            arm64_gas_vreg_any(ops[2]), 3, arm64_vec_entry_op(logic), arm64_gas_arr_q(lc), arm64_vec_entry_u(logic)) };
    }
    var misc: i32 = arm64_v2misc_entry(mnem);
    if (misc >= 0) {
        if (ops.len() != 2) { return a; }
        var mc: i32 = arm64_gas_vreg_arrof(ops[0]);
        return Arm64Asm { ...a, code: arm64_vec2misc(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            arm64_vec_entry_op(misc), arm64_gas_arr_size(mc), arm64_gas_arr_q(mc), arm64_vec_entry_u(misc)) };
    }
    var fz: i32 = arm64_vfpcmpzero_entry(mnem);
    var f3: i32 = arm64_vfp3_entry(mnem);
    // fcmeq/fcmge/fcmgt have both forms; the `#0.0` operand tells them apart.
    if (fz >= 0 && (f3 < 0 || (ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#'))) {
        if (ops.len() != 3) { return a; }
        var zc: i32 = arm64_gas_vreg_arrof(ops[0]);
        return Arm64Asm { ...a, code: arm64_vec2misc(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            arm64_vec_entry_op(fz), arm64_gas_fp_size(zc, true), arm64_gas_arr_q(zc), arm64_vec_entry_u(fz)) };
    }
    if (f3 >= 0) {
        if (ops.len() != 3) { return a; }
        var fc: i32 = arm64_gas_vreg_arrof(ops[0]);
        return Arm64Asm { ...a, code: arm64_vec3same(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            arm64_gas_vreg_any(ops[2]), arm64_vec_entry_op(f3),
            arm64_gas_fp_size(fc, arm64_vec_entry_sizes(f3) == 1), arm64_gas_arr_q(fc), arm64_vec_entry_u(f3)) };
    }
    var f2: i32 = arm64_vfp2_entry(mnem);
    if (f2 >= 0) {
        if (ops.len() != 2) { return a; }
        var f2c: i32 = arm64_gas_vreg_arrof(ops[0]);
        return Arm64Asm { ...a, code: arm64_vec2misc(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            arm64_vec_entry_op(f2), arm64_gas_fp_size(f2c, arm64_vec_entry_sizes(f2) == 1),
            arm64_gas_arr_q(f2c), arm64_vec_entry_u(f2)) };
    }
    var sh: i32 = arm64_vshift_entry(mnem);
    if (sh >= 0) {
        if (ops.len() != 3) { return a; }
        var sc: i32 = arm64_gas_vreg_arrof(ops[0]);
        var es: i32 = arm64_gas_esize(sc);
        var amt: i32 = arm64_gas_imm(ops[2]);
        var immhb: i32 = 2 * es - amt;
        if (arm64_vec_entry_sizes(sh) == 1) { immhb = es + amt; }
        return Arm64Asm { ...a, code: arm64_vecshift(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            arm64_vec_entry_op(sh), immhb, arm64_gas_arr_q(sc), arm64_vec_entry_u(sh)) };
    }
    if (arm64_gas_shll_kind(mnem) >= 0 || mnem == "xtn" || mnem == "xtn2"
        || mnem == "shrn" || mnem == "shrn2") {
        return arm64_gas_emit_narrowwide(a, mnem, ops);
    }
    if (mnem == "ext") {
        if (ops.len() != 4) { return a; }
        var ec: i32 = arm64_gas_vreg_arrof(ops[0]);
        return Arm64Asm { ...a, code: arm64_vecext(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
            arm64_gas_vreg_any(ops[2]), arm64_gas_imm(ops[3]), arm64_gas_arr_q(ec)) };
    }
    if (mnem == "tbl") {
        if (ops.len() != 3) { return a; }
        var tc: i32 = arm64_gas_vreg_arrof(ops[0]);
        return Arm64Asm { ...a, code: arm64_vectbl1(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vlist_one(ops[1]),
            arm64_gas_vreg_any(ops[2]), arm64_gas_arr_q(tc)) };
    }
    var pm: i32 = arm64_vpermute_opc(mnem);
    if (pm < 0 || ops.len() != 3) { return a; }
    var pc: i32 = arm64_gas_vreg_arrof(ops[0]);
    return Arm64Asm { ...a, code: arm64_vecpermute(a.code, arm64_gas_vreg_any(ops[0]), arm64_gas_vreg_any(ops[1]),
        arm64_gas_vreg_any(ops[2]), pm, arm64_gas_arr_size(pc), arm64_gas_arr_q(pc)) };
}

// ---- packed NEON (the fused vector kernels of ATLAS-PLATFORM-PLAN §3) ----
//
// The five this assembler was missing for __memchr / __ascii_run. cnt/addv
// above were its whole SIMD surface before them, and they exist for a scalar
// popcount rather than for a vector kernel — §3.3a's rule, which is that the
// assembler for every target a kernel is about to be emitted on needs checking
// separately, and a self-host backend has one of its own.
//
// Advanced SIMD is mandatory in the declared ARMv8-A baseline, so these are
// hard requirements rather than a fast path; there is nothing to detect.


// ---- byte/halfword/sign-extending load/store (unsigned scaled imm) ----
// ldrb/strb size 0 (no scale); ldrh/strh size 1 (÷2); ldrsw size 2 (÷4).
function arm64_ldrb(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x39400000 | (((off & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_strb(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x39000000 | (((off & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
// Post-index byte load/store `ldrb/strb Wt, [Xn], #imm9` — the byte-copy
// loop idiom (__fern_str_concat). imm9 is a signed unscaled offset in
// bits 20:12, index bits 11:10 = 01. ldrb base 0x38400000, strb 0x38000000.
// Verified vs llvm-mc: ldrb w4,[x1],#1 = 0x38401424.
function arm64_ldrb_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x38400400 | (((off & 0x1ff) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_strb_post(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x38000400 | (((off & 0x1ff) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_ldrh(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x79400000 | ((((off / 2) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_strh(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0x79000000 | ((((off / 2) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_ldrsw(buf: i32[], rt: i32, rn: i32, off: i32): i32[] {
    return arm64_le32(buf, 0xb9800000 | ((((off / 4) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
// ldrsb/ldrsh sign-extend into either width, and the DESTINATION width is
// what opc selects: opc=10 for an X target, opc=11 for a W one. So the
// wider `x` form is the one with the SMALLER base word.
// Verified vs gas: ldrsb x0,[x1,#4] = 0x39801020, ldrsb w0,[x1,#4] =
// 0x39c01020, ldrsh x0,[x1,#4] = 0x79800820, ldrsh w3,[x2,#62] = 0x79c07c43.
function arm64_ldrsb(buf: i32[], rt: i32, rn: i32, off: i32, w: boolean): i32[] {
    var base: i64 = 0x39800000;
    if (w) { base = 0x39c00000; }
    return arm64_le32(buf, base | (((off & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}
function arm64_ldrsh(buf: i32[], rt: i32, rn: i32, off: i32, w: boolean): i32[] {
    var base: i64 = 0x79800000;
    if (w) { base = 0x79c00000; }
    return arm64_le32(buf, base | ((((off / 2) & 0xfff) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rt & 31) as i64));
}

// ---- mrs / msr (read / write system register) ----
// arm64_mrs_base returns the encoded base word for a supported system
// register name (the full mrs word minus Rt), or -1 if unknown.
function arm64_mrs_base(name: string): i64 {
    if (name == "cntvct_el0") { return 0xd53be040; }
    if (name == "cntfrq_el0") { return 0xd53be000; }
    if (name == "tpidr_el0") { return 0xd53bd040; }
    if (name == "nzcv") { return 0xd53b4200; }
    if (name == "fpcr") { return 0xd53b4400; }
    if (name == "fpsr") { return 0xd53b4420; }
    if (name == "dczid_el0") { return 0xd53b00e0; }
    return 0 - 1;
}
function arm64_mrs(buf: i32[], rt: i32, name: string): i32[] {
    return arm64_le32(buf, arm64_mrs_base(name) | ((rt & 31) as i64));
}
// arm64_msr_base is the WRITABLE-from-EL0 subset (the mrs word with the
// direction bit clear). dczid_el0 and the counter-timers are read-only:
// their write encoding would exist and trap at runtime, so they are
// absent and the caller refuses.
function arm64_msr_base(name: string): i64 {
    if (name == "tpidr_el0") { return 0xd51bd040; }
    if (name == "nzcv") { return 0xd51b4200; }
    if (name == "fpcr") { return 0xd51b4400; }
    if (name == "fpsr") { return 0xd51b4420; }
    return 0 - 1;
}
function arm64_msr(buf: i32[], rt: i32, name: string): i32[] {
    return arm64_le32(buf, arm64_msr_base(name) | ((rt & 31) as i64));
}

// ---- f64 (scalar double) instructions ----
//
// The float runtime the self-host asm_arm64 emitter always emits. d-regs
// and x-regs share the 5-bit field; the opcode picks the bank. (Verified vs
// llvm-mc.)

// arm64_fp_single turns a double-precision (ftype=01) scalar FP word into
// its single-precision (ftype=00) twin by clearing bit 22.
function arm64_fp_single(word: i64, single: boolean): i64 {
    if (single) { return word & 0xffbfffff; }
    return word;
}

// arm64_fp3_base maps a three-register scalar FP mnemonic to its
// double-precision base; -1 = not one of them. arm64_fp3 appends
// `<op> Vd, Vn, Vm` in either precision.
function arm64_fp3_base(mnem: string): i64 {
    if (mnem == "fadd") { return 0x1e602800; }
    if (mnem == "fsub") { return 0x1e603800; }
    if (mnem == "fmul") { return 0x1e600800; }
    if (mnem == "fdiv") { return 0x1e601800; }
    if (mnem == "fnmul") { return 0x1e608800; }
    if (mnem == "fmin") { return 0x1e605800; }
    if (mnem == "fmax") { return 0x1e604800; }
    if (mnem == "fminnm") { return 0x1e607800; }
    if (mnem == "fmaxnm") { return 0x1e606800; }
    return 0 - 1;
}
function arm64_fp3(buf: i32[], base: i64, rd: i32, rn: i32, rm: i32, single: boolean): i32[] {
    var word: i64 = base | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    return arm64_le32(buf, arm64_fp_single(word, single));
}

// arm64_fp4_base maps a fused multiply-add mnemonic to its base;
// arm64_fp4 appends `<op> Vd, Vn, Vm, Va` (Va ± Vn*Vm, negated for FN*).
function arm64_fp4_base(mnem: string): i64 {
    if (mnem == "fmadd") { return 0x1f400000; }
    if (mnem == "fmsub") { return 0x1f408000; }
    if (mnem == "fnmadd") { return 0x1f600000; }
    if (mnem == "fnmsub") { return 0x1f608000; }
    return 0 - 1;
}
function arm64_fp4(buf: i32[], base: i64, rd: i32, rn: i32, rm: i32, ra: i32, single: boolean): i32[] {
    var word: i64 = base | (((rm & 31) as i64) << 16) | (((ra & 31) as i64) << 10) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    return arm64_le32(buf, arm64_fp_single(word, single));
}

// fcsel Vd, Vn, Vm, <cond> -> 0x1E600C00; fccmp Vn, Vm, #nzcv, <cond> ->
// 0x1E600400 (the nzcv fallback pattern sits in the Rd slot).
function arm64_fcsel(buf: i32[], rd: i32, rn: i32, rm: i32, cond: i32, single: boolean): i32[] {
    var word: i64 = 0x1e600c00 | (((rm & 31) as i64) << 16) | (((cond & 15) as i64) << 12) | (((rn & 31) as i64) << 5) | ((rd & 31) as i64);
    return arm64_le32(buf, arm64_fp_single(word, single));
}
function arm64_fccmp(buf: i32[], rn: i32, rm: i32, nzcv: i32, cond: i32, single: boolean): i32[] {
    var word: i64 = 0x1e600400 | (((rm & 31) as i64) << 16) | (((cond & 15) as i64) << 12) | (((rn & 31) as i64) << 5) | ((nzcv & 15) as i64);
    return arm64_le32(buf, arm64_fp_single(word, single));
}
// The double-precision unary FP family — fneg / fabs / fsqrt and the four
// frint rounding modes — shares one encoding shape `<op> Dd, Dn`: a base
// opcode with Rn at bit 5 and Rd at bit 0. Only the base differs.
// (Verified against internal/native/arm64's FNEG / FABS / FSQRT / FRINT*.)
function arm64_funary_d_base(mnem: string): i64 {
    if (mnem == "fneg") { return 0x1e614000; }
    if (mnem == "fabs") { return 0x1e60c000; }
    if (mnem == "fsqrt") { return 0x1e61c000; }
    if (mnem == "frintm") { return 0x1e654000; } // floor
    if (mnem == "frintp") { return 0x1e64c000; } // ceil
    if (mnem == "frintz") { return 0x1e65c000; } // trunc
    if (mnem == "frinta") { return 0x1e664000; } // round half away from zero
    if (mnem == "frintn") { return 0x1e644000; } // round half to EVEN (x86 roundsd mode 0)
    return 0 - 1;
}
function arm64_funary_d(buf: i32[], base: i64, rd: i32, rn: i32, single: boolean): i32[] {
    return arm64_le32(buf, arm64_fp_single(base | (((rn & 31) as i64) << 5) | ((rd & 31) as i64), single));
}
// fcmp/fcmpe Vn, Vm|#0.0 (Rd field carries the variant): `opc` folds the
// variant bits — 0x10 selects the signalling fcmpe, 0x08 the compare-
// against-zero form, whose #0.0 is part of the opcode, not an immediate.
function arm64_fcmp(buf: i32[], rn: i32, rm: i32, opc: i32, single: boolean): i32[] {
    var word: i64 = 0x1e602000 | (((rm & 31) as i64) << 16) | (((rn & 31) as i64) << 5) | ((opc & 0x18) as i64);
    return arm64_le32(buf, arm64_fp_single(word, single));
}
// fmov Dd, Dn (fp->fp).
function arm64_fmov_dd(buf: i32[], rd: i32, rn: i32): i32[] {
    return arm64_le32(buf, 0x1e604000 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
// fmov Dd, Xn (gpr->fp).
function arm64_fmov_from_gpr(buf: i32[], rd_fp: i32, rn_gpr: i32): i32[] {
    return arm64_le32(buf, 0x9e670000 | (((rn_gpr & 31) as i64) << 5) | ((rd_fp & 31) as i64));
}
// fmov Xd, Dn (fp->gpr).
function arm64_fmov_to_gpr(buf: i32[], rd_gpr: i32, rn_fp: i32): i32[] {
    return arm64_le32(buf, 0x9e660000 | (((rn_fp & 31) as i64) << 5) | ((rd_gpr & 31) as i64));
}
// The SINGLE-precision siblings, `fmov Sd, Wn` and `fmov Wd, Sn` — the f32
// bit-reinterpret pair the float path emits either side of an fcvt. Verified vs
// clang: fmov s0,w0 = 0x1e270000, fmov w0,s0 = 0x1e260000.
function arm64_fmov_s_from_gpr(buf: i32[], rd_fp: i32, rn_gpr: i32): i32[] {
    return arm64_le32(buf, 0x1e270000 | (((rn_gpr & 31) as i64) << 5) | ((rd_fp & 31) as i64));
}
function arm64_fmov_s_to_gpr(buf: i32[], rd_gpr: i32, rn_fp: i32): i32[] {
    return arm64_le32(buf, 0x1e260000 | (((rn_fp & 31) as i64) << 5) | ((rd_gpr & 31) as i64));
}
// fcvt Sd, Dn (double -> single) and fcvt Dd, Sn (single -> double) — the
// FP-to-FP precision conversions. Same one-source shape as the funary family:
// base | Rn<<5 | Rd. Verified vs clang --target=aarch64-linux-gnu:
// fcvt s0,d0 = 0x1e624000, fcvt s3,d4 = 0x1e624083, fcvt d0,s0 = 0x1e22c000,
// fcvt d5,s6 = 0x1e22c0c5.
//
// This was the single largest hole in the assembler: 605 of these in six
// fixtures' emitted asm, and no encoder at all, so `-target arm64-linux` refused any
// program whose runtime helpers touch floats — 64 corpus fixtures, most of them
// (fizzbuzz, empty_array, map_keys) with no float in their source (#6044).
function arm64_fcvt_s_d(buf: i32[], rd: i32, rn: i32): i32[] {
    return arm64_le32(buf, 0x1e624000 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}
function arm64_fcvt_d_s(buf: i32[], rd: i32, rn: i32): i32[] {
    return arm64_le32(buf, 0x1e22c000 | (((rn & 31) as i64) << 5) | ((rd & 31) as i64));
}

// fcvtzs Xd, Dn / fcvtzs Wd, Dn (double -> signed int, round toward zero).
// The GP destination's width is in the sf bit: 0x9e780000 for X, 0x1e780000 for
// W. It was hardcoded to the X form, so `fcvtzs w5, d6` sign-extended into the
// full 64-bit register — the #6054 width class again, on the FP boundary.
// Verified vs clang: fcvtzs x0,d0 = 0x9e780000, fcvtzs w5,d6 = 0x1e7800c5.
// fcvtzu Xd, Dn / fcvtzu Wd, Dn is the UNSIGNED twin (opcode 001 instead of
// 000): 0x9e790000 / 0x1e790000. It had no encoder either, so `f64 as u32` /
// `as u64` — which the emitter lowers to fcvtzu, the saturating unsigned
// truncation — was refused by -target arm64-linux the same way ucvtf was.
// Verified vs clang: fcvtzu x0,d1 = 0x9e790020, fcvtzu w5,d6 = 0x1e7900c5.
function arm64_fcvtz_int(buf: i32[], rd_gpr: i32, rn_fp: i32, w: boolean, unsigned: boolean): i32[] {
    var base: i64 = 0x9e780000;
    if (unsigned) { base = 0x9e790000; }
    if (w) {
        base = 0x1e780000;
        if (unsigned) { base = 0x1e790000; }
    }
    return arm64_le32(buf, base | (((rn_fp & 31) as i64) << 5) | ((rd_gpr & 31) as i64));
}
// scvtf Dd, Xn / Dd, Wn (signed int -> double) and ucvtf Dd, Xn / Dd, Wn
// (unsigned int -> double). Same encoding but for the opcode field — 010 for
// signed, 011 for unsigned — and, as with fcvtzs, the GP SOURCE's width lives
// in the sf bit: 0x9e6.0000 for X, 0x1e6.0000 for W. ucvtf was missing
// entirely, so `u64 as f64` (which needs it — a signed convert reads a value
// >= 2^63 as negative, #6051) was refused by the in-process assembler.
// Verified vs clang: scvtf d0,x1 = 0x9e620020, ucvtf d0,x1 = 0x9e630020,
// ucvtf d0,w1 = 0x1e630020.
function arm64_cvtf(buf: i32[], rd_fp: i32, rn_gpr: i32, w: boolean, unsigned: boolean): i32[] {
    var base: i64 = 0x9e620000;
    if (unsigned) { base = 0x9e630000; }
    if (w) {
        base = 0x1e620000;
        if (unsigned) { base = 0x1e630000; }
    }
    return arm64_le32(buf, base | (((rn_gpr & 31) as i64) << 5) | ((rd_fp & 31) as i64));
}

// ============================================================
// PART 2 — GAS-text assembler + data/symbol relocation
// ============================================================

// examples/self_host/arm64_gas.fern — a self-hosted AArch64 GAS-text
// assembler: it parses an assembly-text subset into machine-code bytes via
// the arm64_encode.fern encoders + named-label assembler (Arm64Asm). It is
// the arm64 counterpart of x86_native.fern PART 2 and the text->bytes step that lets
// the arm64-darwin native path turn `asm_arm64`-style assembly into a
// runnable Mach-O (via macho.fern) with no external `as`/`clang`.
//
// This module `import`s nothing but depends on the names defined in
// arm64_encode.fern (the encoders + Arm64Asm), so a build / test
// concatenates the two (plus macho.fern) the same way the x86 gas slices
// concatenate x86_native.fern.
//
// Supported subset: the canonical AArch64 GAS spellings the emitters and
// runtime helpers produce — arm64_gas_known is the authoritative list.
// Directives: .text/.data/.bss and the data directives; `name:` labels
// (including GAS numeric locals); `//` line comments.

// ---- text helpers ----

// ---- portable substring helpers ----
//
// The Go reference checker has no string index_of/contains/starts_with/
// split *methods* (they are self-host-wasm-only builtins; the Go-compiled
// self-host modules avoid them). Since the unified `fern` CLI compiles this
// module through the Go front-end, provide them over the portable surface
// (.len(), s[i], s[a:b], concat, array .append).

function arm64_str_indexof(s: string, sub: string): i32 {
    var n: i32 = s.len();
    var m: i32 = sub.len();
    if (m == 0) { return 0; }
    if (m > n) { return 0 - 1; }
    var i: i32 = 0;
    while (i <= n - m) {
        var j: i32 = 0;
        var ok: boolean = true;
        while (j < m) {
            if (s[i + j] != sub[j]) { ok = false; j = m; }
            else { j = j + 1; }
        }
        if (ok) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

function arm64_str_starts_with(s: string, pre: string): boolean {
    var m: i32 = pre.len();
    if (m > s.len()) { return false; }
    var i: i32 = 0;
    while (i < m) {
        if (s[i] != pre[i]) { return false; }
        i = i + 1;
    }
    return true;
}

function arm64_str_contains(s: string, sub: string): boolean {
    return arm64_str_indexof(s, sub) >= 0;
}

function arm64_str_split(s: string, sep: string): string[] {
    var out: string[] = [];
    var m: i32 = sep.len();
    if (m == 0) { out = out.append(s); return out; }
    var n: i32 = s.len();
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= n - m) {
        var hit: boolean = true;
        var j: i32 = 0;
        while (j < m) {
            if (s[i + j] != sep[j]) { hit = false; j = m; }
            else { j = j + 1; }
        }
        if (hit) {
            out = out.append(slice_unchecked(s, start, i));
            i = i + m;
            start = i;
        } else {
            i = i + 1;
        }
    }
    out = out.append(slice_unchecked(s, start, n));
    return out;
}

// arm64_gas_trim strips leading/trailing ASCII spaces and tabs.
function arm64_gas_trim(s: string): string {
    var i: i32 = 0;
    while (i < s.len() && (s[i] == b' ' || s[i] == b'\t')) {
        i = i + 1;
    }
    var j: i32 = s.len();
    while (j > i && (s[j - 1] == b' ' || s[j - 1] == b'\t')) {
        j = j - 1;
    }
    return slice_unchecked(s, i, j) + "";
}

// arm64_gas_atoi parses a signed integer token: optional '-', decimal or
// `0x…` hex. Two's-complement wrap gives the right bits for negatives.
function arm64_gas_atoi(tok: string): i32 {
    var s: string = tok;
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == b'-') {
        neg = true;
        i = 1;
    }
    var v: i32 = 0;
    if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
        i = i + 2;
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            var d: i32 = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else { if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else { if (c >= 65 && c <= 70) { d = c - 65 + 10; } } }
            if (d >= 0) { v = v * 16 + d; }
            i = i + 1;
        }
    } else {
        while (i < s.len()) {
            var c2: i32 = s[i] as i32;
            if (c2 >= 48 && c2 <= 57) { v = v * 10 + (c2 - 48); }
            i = i + 1;
        }
    }
    if (neg) {
        return 0 - v;
    }
    return v;
}

// arm64_gas_imm parses an immediate operand `#N` (decimal or 0x hex,
// optional '-'); the leading '#' is dropped.
function arm64_gas_imm(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (s.len() > 0 && s[0] == b'#') {
        s = slice_unchecked(s, 1, s.len()) + "";
    }
    return arm64_gas_atoi(s);
}

// arm64_gas_reg parses a register token: x0..x30 / w0..w30 (same number),
// d0..d31 / s0..s31 (FP), plus the aliases sp / lr / xzr / wzr. Returns
// -1 for anything else — a STRICT digit parse, so `x1a` (previously 1 via
// the lenient atoi), an out-of-range `x99`, or an unrecognised token
// (previously x0) can no longer decode to a wrong register and silently
// miscompile (SH-006). The line loop's register-shaped-operand check
// records offenders on p.unknown, so the driver refuses the output before
// a -1 ever reaches an executed encoding.
function arm64_gas_reg(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (s == "sp") { return 31; }
    if (s == "xzr" || s == "wzr") { return 31; }
    if (s == "lr") { return 30; }
    if (s == "fp") { return 29; }
    if (s.len() >= 2 && (s[0] == b'x' || s[0] == b'w' || s[0] == b'd' || s[0] == b's')) {
        var n: i32 = 0;
        var i: i32 = 1;
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            if (c < 48 || c > 57) { return 0 - 1; }
            n = n * 10 + (c - 48);
            i = i + 1;
        }
        var lim: i32 = 30;
        if (s[0] == b'd' || s[0] == b's') { lim = 31; }   // d0..d31 / s0..s31
        if (n > lim) { return 0 - 1; }
        return n;
    }
    return 0 - 1;
}

// arm64_gas_bad_reg_token scans an operand string for a REGISTER-SHAPED
// token that fails the strict decode: a piece (top-level operand, or a
// comma piece inside a `[...]` memory operand) whose first char is
// x/w/d/s followed by a digit must parse as a register — trailing junk
// (`x1a`) or an out-of-range number (`x31`, `d40`) returns that token so
// the caller can record it on p.unknown. Pieces not shaped like registers
// (immediates, labels, shift specs, sysregs) are ignored. Returns "" when
// everything register-shaped decodes.
function arm64_gas_bad_reg_token(rest: string): string {
    var ops: string[] = arm64_gas_operands(rest);
    var i: i32 = 0;
    while (i < ops.len()) {
        var t: string = ops[i];
        if (t.len() > 0 && t[0] == b'[') {           // memory operand
            var rb: i32 = arm64_str_indexof(t, "]");
            if (rb > 1) {
                var inner: string[] = arm64_gas_operands(slice_unchecked(t, 1, rb));
                var k: i32 = 0;
                while (k < inner.len()) {
                    var it: string = arm64_gas_trim(inner[k]);
                    if (it.len() >= 2 && (it[0] == b'x' || it[0] == b'w' || it[0] == b'd' || it[0] == b's')
                        && it[1] >= b'0' && it[1] <= b'9' && arm64_gas_reg(it) < 0) { return it; }
                    k = k + 1;
                }
            }
        } else {
            var tt: string = arm64_gas_trim(t);
            if (tt.len() >= 2 && (tt[0] == b'x' || tt[0] == b'w' || tt[0] == b'd' || tt[0] == b's')
                && tt[1] >= b'0' && tt[1] <= b'9' && arm64_gas_reg(tt) < 0) { return tt; }
        }
        i = i + 1;
    }
    return "";
}

// arm64_gas_cond maps a condition suffix (the `eq` in `b.eq`) to its 4-bit
// code, matching arm64_encode's arm64_eq/ne/ge/lt/gt/le.
function arm64_gas_cond(s: string): i32 {
    if (s == "eq") { return 0; }
    if (s == "ne") { return 1; }
    if (s == "cs" || s == "hs") { return 2; }  // carry set / unsigned >=
    if (s == "cc" || s == "lo") { return 3; }  // carry clear / unsigned <
    if (s == "mi") { return 4; }               // negative
    if (s == "pl") { return 5; }               // non-negative
    if (s == "vs") { return 6; }               // overflow set
    if (s == "vc") { return 7; }               // overflow clear
    if (s == "hi") { return 8; }               // unsigned >
    if (s == "ls") { return 9; }               // unsigned <=
    if (s == "ge") { return 10; }
    if (s == "lt") { return 11; }
    if (s == "gt") { return 12; }
    if (s == "le") { return 13; }
    if (s == "al") { return 14; }              // always
    if (s == "nv") { return 15; }              // never (encodes as 0b1111)
    return 0 - 1;
}

// arm64_gas_is_cond reports whether a 2-letter suffix is a condition code
// (so `b<cc>` no-dot aliases like bhi/blt/bne can be told from b/bl/br).
function arm64_gas_is_cond(s: string): boolean {
    return s == "eq" || s == "ne" || s == "cs" || s == "hs" || s == "cc" || s == "lo"
        || s == "mi" || s == "pl" || s == "vs" || s == "vc" || s == "hi" || s == "ls"
        || s == "ge" || s == "lt" || s == "gt" || s == "le" || s == "al" || s == "nv";
}

// arm64_gas_is_w reports whether a register token names a 32-bit w-register.
function arm64_gas_is_w(tok: string): boolean {
    var s: string = arm64_gas_trim(tok);
    return s.len() >= 1 && s[0] == b'w';
}

// arm64_gas_is_d reports whether a register token names a 64-bit FP (d) register.
function arm64_gas_is_d(tok: string): boolean {
    var s: string = arm64_gas_trim(tok);
    return s.len() >= 1 && s[0] == b'd';
}

// arm64_gas_is_s distinguishes a SINGLE-precision FP register from the
// double-precision `d` and the general-purpose `w`/`x`. Without it the fmov
// dispatch could not tell `fmov s0, w0` from `fmov x0, d0` and encoded the
// latter — the wrong register file at the wrong width, 121 times in one
// float-heavy fixture (#6044).
function arm64_gas_is_s(tok: string): boolean {
    var t: string = arm64_gas_trim(tok);
    return t.len() >= 1 && t[0] == b's';
}

// arm64_gas_is_sreg is the stricter test — an s-REGISTER (s0..s31), as
// opposed to any token starting with 's' (which "sp" also does).
function arm64_gas_is_sreg(tok: string): boolean {
    var t: string = arm64_gas_trim(tok);
    return t.len() >= 2 && t[0] == b's' && t[1] >= b'0' && t[1] <= b'9';
}





// ---- general vector arrangements (#8000) ----
//
// The byte-only helpers above exist because every encoder that used them
// pinned size=00, so a wider element size would have assembled as a DIFFERENT
// instruction on the same bytes. The families below carry the size in a field
// instead, so they need the whole arrangement set, and refusing what an
// individual op cannot express moves from the parser to a per-op size mask.
//
// An arrangement is packed as size*2 + Q, which is the order the encoding
// itself uses and keeps the two halves one shift apart.

// arm64_gas_arr_code maps an arrangement suffix (no leading dot) to
// size*2 + Q, or -1. `.1d` parses — ld1/st1 have it — and is refused by the
// size masks everywhere else.
function arm64_gas_arr_code(arr: string): i32 {
    if (arr == "8b") { return 0; }
    if (arr == "16b") { return 1; }
    if (arr == "4h") { return 2; }
    if (arr == "8h") { return 3; }
    if (arr == "2s") { return 4; }
    if (arr == "4s") { return 5; }
    if (arr == "1d") { return 6; }
    if (arr == "2d") { return 7; }
    return 0 - 1;
}

function arm64_gas_arr_size(code: i32): i32 { return code / 2; }
function arm64_gas_arr_q(code: i32): boolean { return code % 2 == 1; }

// arm64_gas_vreg_any decodes `vN.<arr>` for ANY arrangement, returning the
// register number, or -1. arm64_gas_vreg_arrof returns the arrangement code
// of the same token.
function arm64_gas_vreg_any(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    var dot: i32 = arm64_str_indexof(s, ".");
    if (s.len() < 4 || s[0] != b'v' || dot < 2) { return 0 - 1; }
    var n: i32 = 0;
    var i: i32 = 1;
    while (i < dot) {
        var c: i32 = s[i] as i32;
        if (c < 48 || c > 57) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if (n > 31) { return 0 - 1; }
    if (arm64_gas_arr_code(slice_unchecked(s, dot + 1, s.len()) + "") < 0) { return 0 - 1; }
    return n;
}

function arm64_gas_vreg_arrof(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    var dot: i32 = arm64_str_indexof(s, ".");
    if (dot < 0 || dot + 1 >= s.len()) { return 0 - 1; }
    return arm64_gas_arr_code(slice_unchecked(s, dot + 1, s.len()) + "");
}

// arm64_gas_is_vecarr reports whether an operand is an arranged vector
// register at all — what routes a dual-form mnemonic (add, mvn, neg, …) to
// its SIMD encoding instead of the scalar one it shares a name with.
function arm64_gas_is_vecarr(tok: string): boolean {
    var s: string = arm64_gas_trim(tok);
    return s.len() > 1 && s[0] == b'v' && s[1] >= b'0' && s[1] <= b'9'
        && arm64_str_indexof(s, ".") > 0;
}

// Element-size masks: bit 0 = byte, 1 = halfword, 2 = single, 3 = double.
function arm64_gas_arr_allowed(sizes: i32, code: i32): boolean {
    var size: i32 = arm64_gas_arr_size(code);
    // 64-bit lanes exist only in the full-width form, so `.1d` is refused
    // across the data-processing classes even where `.2d` is allowed.
    if (size == 3 && !arm64_gas_arr_q(code)) { return false; }
    return (sizes / arm64_gas_pow2(size)) % 2 == 1;
}
function arm64_gas_pow2(n: i32): i32 {
    var v: i32 = 1;
    var i: i32 = 0;
    while (i < n) { v = v * 2; i = i + 1; }
    return v;
}


// arm64_gas_cond_operand reports which operand of a condition-taking mnemonic
// holds the condition, or -1 for a mnemonic that takes none.
function arm64_gas_cond_operand(mnem: string): i32 {
    if (mnem == "cset" || mnem == "csetm") { return 1; }
    if (mnem == "cinc" || mnem == "cinv" || mnem == "cneg") { return 2; }
    if (mnem == "csel" || mnem == "csinc" || mnem == "csinv" || mnem == "csneg"
        || mnem == "ccmp" || mnem == "ccmn"
        || mnem == "fcsel" || mnem == "fccmp") { return 3; }
    return 0 - 1;
}

// arm64_gas_cond_inverts reports the aliases whose encoder uses the INVERSE of
// the written condition — cset is csinc with the condition flipped, and the
// rest follow. GNU as refuses AL and NV on exactly these, because inverting
// "always" or "never" names no useful instruction.
function arm64_gas_cond_inverts(mnem: string): boolean {
    return mnem == "cset" || mnem == "csetm"
        || mnem == "cinc" || mnem == "cinv" || mnem == "cneg";
}

// arm64_gas_bad_cond_token vets the condition operand, under the same
// discipline as the register and SIMD vetting either side of it: a condition
// the encoders cannot express is recorded, never folded into a wrong field.
//
// Without it, arm64_gas_cond's miss value went straight into the 4-bit
// condition field, so an unrecognised suffix assembled as `eq` — a valid
// instruction testing the wrong flag, with nothing reported.
function arm64_gas_bad_cond_token(mnem: string, rest: string): string {
    var idx: i32 = arm64_gas_cond_operand(mnem);
    if (idx < 0) { return ""; }
    var ops: string[] = arm64_gas_operands(rest);
    if (ops.len() <= idx) { return mnem + ":arity"; }
    var c: string = arm64_gas_trim(ops[idx]);
    if (arm64_gas_cond(c) < 0) { return c; }
    if (arm64_gas_cond_inverts(mnem) && (c == "al" || c == "nv")) { return c; }
    return "";
}

// arm64_gas_bad_lane vets the lane-move and load-structure classes. A lane
// operand carries its element size AND index in one field, so a size the
// mnemonic does not have does not widen the instruction — it moves the index
// bits and names a different lane, on a word that still decodes.
//
//   - umov/smov read one lane into a general register, and the register width
//     is fixed by the lane: only .d reads into an X register, and smov has no
//     .d form at all because sign-extending 64 bits to 64 is nothing.
//   - ins writes into the 128-bit register, so it has no half-width form.
//   - ld1/st1/ld1r take a ONE-register list and a bare `[Xn]`: this form has
//     no offset field, so an offset has to be refused rather than dropped.
function arm64_gas_bad_lane(mnem: string, ops: string[]): string {
    if (mnem == "ld1" || mnem == "st1" || mnem == "ld1r") {
        if (ops.len() != 2) { return mnem + ":arity"; }
        if (arm64_gas_vlist_one(ops[0]) < 0) { return arm64_gas_trim(ops[0]); }
        var lc: i32 = arm64_gas_vlist_one_arr(ops[0]);
        if (lc < 0) { return arm64_gas_trim(ops[0]); }
        var m: Arm64Mem = arm64_gas_mem(ops[1]);
        if (m.base < 0 || m.off != 0 || m.off_reg >= 0) { return arm64_gas_trim(ops[1]); }
        return "";
    }
    if (mnem == "umov" || mnem == "smov") {
        if (ops.len() != 2) { return mnem + ":arity"; }
        var usz: i32 = arm64_gas_lane_size(ops[1]);
        if (usz < 0 || arm64_gas_lane_index(ops[1]) < 0) { return arm64_gas_trim(ops[1]); }
        if (arm64_gas_reg(ops[0]) < 0) { return arm64_gas_trim(ops[0]); }
        var uw: boolean = arm64_gas_is_w(ops[0]);
        if (mnem == "umov") {
            // .d reads into X, everything narrower into W.
            if (uw == (usz == 3)) { return mnem + ":dst"; }
            return "";
        }
        if (usz == 3) { return mnem + ":arr"; }
        // smov into W sign-extends a byte or halfword; into X, also a word.
        if (uw && usz > 1) { return mnem + ":dst"; }
        return "";
    }
    if (mnem == "ins") {
        if (ops.len() != 2) { return mnem + ":arity"; }
        var isz: i32 = arm64_gas_lane_size(ops[0]);
        if (isz < 0 || arm64_gas_lane_index(ops[0]) < 0) { return arm64_gas_trim(ops[0]); }
        var ssz: i32 = arm64_gas_lane_size(ops[1]);
        if (ssz >= 0) {
            if (ssz != isz) { return mnem + ":arr"; }
            if (arm64_gas_lane_index(ops[1]) < 0) { return arm64_gas_trim(ops[1]); }
            return "";
        }
        if (arm64_gas_reg(ops[1]) < 0) { return arm64_gas_trim(ops[1]); }
        if (arm64_gas_is_w(ops[1]) == (isz == 3)) { return mnem + ":src"; }
        return "";
    }
    if (mnem == "dup") {
        if (ops.len() != 2) { return mnem + ":arity"; }
        var dc: i32 = arm64_gas_vreg_arrof(ops[0]);
        if (arm64_gas_vreg_any(ops[0]) < 0) { return arm64_gas_trim(ops[0]); }
        if (!arm64_gas_arr_allowed(15, dc)) { return mnem + ":arr"; }
        var dsz: i32 = arm64_gas_arr_size(dc);
        var lsz: i32 = arm64_gas_lane_size(ops[1]);
        if (lsz >= 0) {
            if (lsz != dsz) { return mnem + ":arr"; }
            if (arm64_gas_lane_index(ops[1]) < 0) { return arm64_gas_trim(ops[1]); }
            return "";
        }
        if (arm64_gas_reg(ops[1]) < 0) { return arm64_gas_trim(ops[1]); }
        if (arm64_gas_is_w(ops[1]) == (dsz == 3)) { return mnem + ":src"; }
        return "";
    }
    // movi
    if (ops.len() < 2 || ops.len() > 3) { return mnem + ":arity"; }
    var vc: i32 = arm64_gas_vreg_arrof(ops[0]);
    if (arm64_gas_vreg_any(ops[0]) < 0) { return arm64_gas_trim(ops[0]); }
    if (!arm64_gas_arr_allowed(15, vc)) { return mnem + ":arr"; }
    var vimm: i32 = arm64_gas_imm(ops[1]);
    if (vimm < 0 || vimm > 255) { return mnem + ":imm"; }
    var vsz: i32 = arm64_gas_arr_size(vc);
    // The shift is not a field: it picks the cmode, so only the byte
    // positions the element actually has are encodable.
    var vshift: i32 = 0;
    if (ops.len() == 3) { vshift = arm64_gas_lsl_amount(ops[2]); }
    if (vsz == 3 && ops.len() != 2) { return mnem + ":imm"; }
    if (vsz == 0 && vshift != 0) { return mnem + ":imm"; }
    if (vsz == 1 && vshift != 0 && vshift != 8) { return mnem + ":imm"; }
    if (vsz == 2 && (vshift % 8 != 0 || vshift > 24)) { return mnem + ":imm"; }
    return "";
}

// arm64_gas_bad_vec_token guards the SIMD operands the way
// arm64_gas_bad_reg_token guards the general-purpose ones: a shape the
// encoders cannot express is returned so the caller records it on p.unknown
// and refuses the output, rather than letting a -1 sentinel fold into the
// register field.
function arm64_gas_bad_vec_token(mnem: string, rest: string): string {
    var ops: string[] = arm64_gas_operands(rest);
    if (mnem == "ld1" || mnem == "st1" || mnem == "ld1r" || mnem == "dup"
        || mnem == "movi" || mnem == "umov" || mnem == "smov" || mnem == "ins") {
        return arm64_gas_bad_lane(mnem, ops);
    }
    // The across-lanes reductions come first: their destination is a SCALAR,
    // so routing on ops[0] being an arranged operand would miss them — and
    // then `sminv v0.8h, v9.8h` reaches the encoder with -1 for a register.
    if (arm64_across_entry(mnem) >= 0) { return arm64_gas_bad_across(mnem, ops); }
    if (ops.len() > 0 && arm64_gas_is_vecarr(ops[0])) { return arm64_gas_bad_vecgen(mnem, ops); }
    return "";
}

// arm64_gas_bad_across vets the across-lanes reductions. The destination is a
// SCALAR whose element class must match the arrangement — one size up for the
// widening saddlv/uaddlv — because nothing in the encoding says how wide the
// result is; the mnemonic and the source arrangement decide it together, and a
// mismatched destination would name a register the instruction does not write.
// `.2s` and `.1d`/`.2d` have no across-lanes form at all: there is nothing to
// reduce across two lanes that a pairwise op does not already do.
function arm64_gas_bad_across(mnem: string, ops: string[]): string {
    var e: i32 = arm64_across_entry(mnem);
    if (ops.len() != 2) { return mnem + ":arity"; }
    if (arm64_gas_vreg_any(ops[1]) < 0) { return arm64_gas_trim(ops[1]); }
    var code: i32 = arm64_gas_vreg_arrof(ops[1]);
    var size: i32 = arm64_gas_arr_size(code);
    if (size == 3 || (size == 2 && !arm64_gas_arr_q(code))) { return mnem + ":arr"; }
    var cls: i32 = arm64_gas_scalar_class(ops[0]);
    if (cls < 0) { return arm64_gas_trim(ops[0]); }
    var want: i32 = size;
    if (arm64_vec_entry_sizes(e) == 1) { want = want + 1; }
    if (cls != want) { return mnem + ":dst"; }
    return "";
}

// arm64_gas_bad_vecgen vets the general Advanced SIMD families: the operands
// must share one arrangement, that arrangement must be one the op's encoding
// has, and a compare-against-zero's `#0` must be exactly zero — the immediate
// is part of the opcode, so a non-zero one has no field to go in and would
// assemble as the zero form.
function arm64_gas_bad_vecgen(mnem: string, ops: string[]): string {
    var nwbad: string = arm64_gas_bad_narrowwide(mnem, ops);
    if (nwbad != "-") { return nwbad; }
    var fpbad: string = arm64_gas_bad_vecfp(mnem, ops);
    if (fpbad != "-") { return fpbad; }
    var three: i32 = arm64_v3int_entry(mnem);
    var logic: i32 = arm64_vlogical_entry(mnem);
    var czero: i32 = arm64_vcmpzero_entry(mnem);
    var misc: i32 = arm64_v2misc_entry(mnem);
    // cmeq/cmgt/cmge have both forms; a trailing immediate is what tells them
    // apart. cmle/cmlt exist only against zero.
    var is_czero: boolean = czero >= 0 && (three < 0
        || (ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#'));
    var want: i32 = 3;
    var entry: i32 = three;
    if (is_czero) { want = 3; entry = czero; }
    else { if (three >= 0) { want = 3; entry = three; }
    else { if (logic >= 0) { want = 3; entry = logic; }
    else { if (misc >= 0) { want = 2; entry = misc; }
    else { return ""; } } } }
    if (ops.len() != want) { return mnem + ":arity"; }
    // A compare against zero reads two vector operands and an immediate.
    var nvec: i32 = want;
    if (is_czero) { nvec = 2; }
    var code: i32 = arm64_gas_vreg_arrof(ops[0]);
    var i: i32 = 0;
    while (i < nvec) {
        if (arm64_gas_vreg_any(ops[i]) < 0) { return arm64_gas_trim(ops[i]); }
        if (arm64_gas_vreg_arrof(ops[i]) != code) { return mnem + ":arr"; }
        i = i + 1;
    }
    if (is_czero && arm64_gas_imm(ops[2]) != 0) { return mnem + ":imm"; }
    if (!arm64_gas_arr_allowed(arm64_vec_entry_sizes(entry), code)) { return mnem + ":arr"; }
    return "";
}

// arm64_gas_bad_narrowwide vets the narrowing/widening shifts, ext and tbl,
// answering "-" for anything else so the caller can tell "clean" from "not
// mine".
//
// The arrangement PAIR is what these get wrong when nothing checks it: the two
// operands differ by one element size, and the narrow side's Q bit is the `2`
// suffix rather than a free choice — `xtn2` writes the high half and `xtn` the
// low one, from the same opcode. A mismatched pair is a valid word for a
// different instruction.
function arm64_gas_bad_narrowwide(mnem: string, ops: string[]): string {
    var kind: i32 = arm64_gas_shll_kind(mnem);
    var is_xtn: boolean = mnem == "xtn" || mnem == "xtn2";
    var is_shrn: boolean = mnem == "shrn" || mnem == "shrn2";
    if (kind < 0 && !is_xtn && !is_shrn && mnem != "ext" && mnem != "tbl") { return "-"; }
    if (mnem == "ext") {
        if (ops.len() != 4) { return mnem + ":arity"; }
        var ec: i32 = arm64_gas_vreg_arrof(ops[0]);
        var ei: i32 = 0;
        while (ei < 3) {
            if (arm64_gas_vreg_any(ops[ei]) < 0) { return arm64_gas_trim(ops[ei]); }
            if (arm64_gas_vreg_arrof(ops[ei]) != ec) { return mnem + ":arr"; }
            ei = ei + 1;
        }
        // Byte arrangements only, and the index counts bytes within the
        // concatenated pair: 0..7 for .8b, 0..15 for .16b.
        if (!arm64_gas_arr_allowed(1, ec)) { return mnem + ":arr"; }
        var emax: i32 = 7;
        if (arm64_gas_arr_q(ec)) { emax = 15; }
        var eidx: i32 = arm64_gas_imm(ops[3]);
        if (eidx < 0 || eidx > emax) { return mnem + ":imm"; }
        return "";
    }
    if (mnem == "tbl") {
        if (ops.len() != 3) { return mnem + ":arity"; }
        var tc: i32 = arm64_gas_vreg_arrof(ops[0]);
        if (arm64_gas_vreg_any(ops[0]) < 0) { return arm64_gas_trim(ops[0]); }
        // The table is a one-register list and always .16b; the destination
        // and index share a byte arrangement.
        if (arm64_gas_vlist_one(ops[1]) < 0 || arm64_gas_vlist_one_arr(ops[1]) != 1) { return arm64_gas_trim(ops[1]); }
        if (arm64_gas_vreg_any(ops[2]) < 0) { return arm64_gas_trim(ops[2]); }
        if (arm64_gas_vreg_arrof(ops[2]) != tc) { return mnem + ":arr"; }
        if (!arm64_gas_arr_allowed(1, tc)) { return mnem + ":arr"; }
        return "";
    }
    var want: i32 = 3;
    if (is_xtn || kind >= 4) { want = 2; }
    if (ops.len() != want) { return mnem + ":arity"; }
    if (arm64_gas_vreg_any(ops[0]) < 0) { return arm64_gas_trim(ops[0]); }
    if (arm64_gas_vreg_any(ops[1]) < 0) { return arm64_gas_trim(ops[1]); }
    var d: i32 = arm64_gas_vreg_arrof(ops[0]);
    var n: i32 = arm64_gas_vreg_arrof(ops[1]);
    var hi: boolean = arm64_str_indexof(mnem, "2") == mnem.len() - 1;
    if (is_xtn || is_shrn) {
        // Narrowing: the DESTINATION is the half-width side.
        if (!arm64_gas_narrow_wide_ok(d, n, hi)) { return mnem + ":arr"; }
        if (is_shrn) {
            var nes: i32 = arm64_gas_esize(d);
            var sh: i32 = arm64_gas_imm(ops[2]);
            if (sh < 1 || sh > nes) { return mnem + ":imm"; }
        }
        return "";
    }
    // Widening: the SOURCE is the half-width side.
    if (!arm64_gas_narrow_wide_ok(n, d, hi)) { return mnem + ":arr"; }
    if (kind < 4) {
        var ses: i32 = arm64_gas_esize(n);
        var amt: i32 = arm64_gas_imm(ops[2]);
        if (amt < 0 || amt >= ses) { return mnem + ":imm"; }
    }
    return "";
}

// arm64_gas_bad_vecfp vets the FP, shift-by-immediate and permute families.
// It answers "-" for a mnemonic in none of them, which is what lets
// arm64_gas_bad_vecgen tell "clean" apart from "not mine" — an empty string
// means the operands are fine.
//
// The FP arrangements are fixed at 2s/4s/2d (mask 12), so a byte or halfword
// one is refused rather than folded into a size field that means something
// else entirely here. A shift amount out of range is refused for the sharper
// reason that immh:immb carries the ELEMENT SIZE as well as the amount: an
// over-large value lands in immh and selects a different element size.
function arm64_gas_bad_vecfp(mnem: string, ops: string[]): string {
    var fz: i32 = arm64_vfpcmpzero_entry(mnem);
    var f3: i32 = arm64_vfp3_entry(mnem);
    var f2: i32 = arm64_vfp2_entry(mnem);
    var sh: i32 = arm64_vshift_entry(mnem);
    var pm: i32 = arm64_vpermute_opc(mnem);
    if (fz < 0 && f3 < 0 && f2 < 0 && sh < 0 && pm < 0) { return "-"; }
    var is_fz: boolean = fz >= 0 && (f3 < 0
        || (ops.len() == 3 && ops[2].len() > 0 && ops[2][0] == b'#'));
    // Operand counts: two vectors and an immediate for the compare-against-
    // zero and shift forms, two for the unary FP ones, three otherwise.
    var want: i32 = 3;
    var nvec: i32 = 3;
    if (is_fz || sh >= 0) { nvec = 2; }
    else { if (f3 < 0 && pm < 0 && f2 >= 0) { want = 2; nvec = 2; } }
    if (ops.len() != want) { return mnem + ":arity"; }
    var code: i32 = arm64_gas_vreg_arrof(ops[0]);
    var i: i32 = 0;
    while (i < nvec) {
        if (arm64_gas_vreg_any(ops[i]) < 0) { return arm64_gas_trim(ops[i]); }
        if (arm64_gas_vreg_arrof(ops[i]) != code) { return mnem + ":arr"; }
        i = i + 1;
    }
    if (sh >= 0) {
        if (!arm64_gas_arr_allowed(15, code)) { return mnem + ":arr"; }
        var es: i32 = arm64_gas_esize(code);
        var amt: i32 = arm64_gas_imm(ops[2]);
        if (arm64_vec_entry_sizes(sh) == 1) {
            if (amt < 0 || amt >= es) { return mnem + ":imm"; }
        } else {
            if (amt < 1 || amt > es) { return mnem + ":imm"; }
        }
        return "";
    }
    if (pm >= 0) {
        if (!arm64_gas_arr_allowed(15, code)) { return mnem + ":arr"; }
        return "";
    }
    // 12 = S|D: the lane-wise FP ops exist in 2s/4s/2d and nothing else.
    if (!arm64_gas_arr_allowed(12, code)) { return mnem + ":arr"; }
    if (is_fz) {
        var z: string = arm64_gas_trim(ops[2]);
        if (z != "#0.0" && z != "#0") { return mnem + ":imm"; }
    }
    return "";
}

// arm64_gas_operands splits an operand list on top-level commas, ignoring
// commas inside `[ … ]` (so a memory operand stays one token).
function arm64_gas_operands(rest: string): string[] {
    var out: string[] = [];
    var depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < rest.len()) {
        var c: u8 = rest[i];
        if (c == b'[') { depth = depth + 1; }
        else if (c == b']') { depth = depth - 1; }
        else if (c == b',' && depth == 0) {
            out = out.append(arm64_gas_trim(slice_unchecked(rest, start, i)));
            start = i + 1;
        }
        i = i + 1;
    }
    var last: string = arm64_gas_trim(slice_unchecked(rest, start, rest.len()));
    if (last.len() > 0) {
        out = out.append(last);
    }
    return out;
}

// Arm64Mem is a parsed `[Xn{, #off}]` / `[Xn, Rm{, <ext> {#amt}}]`
// memory operand.
struct Arm64Mem {
    base: i32,
    off: i32,
    // Register in the OFFSET position (`[Xn, Xm]`), or -1 when the offset is an
    // immediate. Callers that cannot encode a register offset must refuse the
    // line (arm64_gas_regoff_unsupported records it on p.unknown) rather than
    // fall back to `off`, which is 0 for this shape and would silently encode
    // `[Xn]`.
    off_reg: i32,
    idx_w: boolean,      // the offset register was spelled wN
    // Extend option on the offset register: UXTW=2, LSL/UXTX=3, SXTW=6,
    // SXTX=7; -1 when a third piece was present but is not a valid extend
    // (callers refuse rather than defaulting to LSL).
    ext_opt: i32,
    ext_amt: i32,
    ext_has_amt: boolean, // explicit #amt (an explicit #0 still sets S on a byte access)
}

// arm64_gas_mem parses `[Xn]`, `[Xn, #off]` or `[Xn, Xm]`, tolerating a trailing
// `!` (pre-index writeback marker — detect it separately with
// arm64_gas_has_bang).
//
// The offset position is a REGISTER or an immediate, and the two must be told
// apart: this read `arm64_gas_imm(parts[1])` unconditionally, so `[x0, x1]` came
// back as offset 1 — the digit lifted out of the register name — and assembled
// as `[x0, #1]`. That is #6047, and it was silent, because 1 is a perfectly
// legal immediate. The strict-register work (SH-006) had already established
// that a register token which does not decode must refuse the line rather than
// encode garbage; a register in the wrong POSITION needs the same treatment.
function arm64_gas_mem(op: string): Arm64Mem {
    var s: string = arm64_gas_trim(op);
    var lb: i32 = arm64_str_indexof(s, "[");
    var rb: i32 = arm64_str_indexof(s, "]");
    var inner: string = s;
    if (lb >= 0 && rb > lb) {
        inner = slice_unchecked(s, lb + 1, rb) + "";
    }
    var parts: string[] = arm64_gas_operands(inner);
    var base: i32 = arm64_gas_reg(parts[0]);
    var off: i32 = 0;
    var off_reg: i32 = 0 - 1;
    var idx_w: boolean = false;
    var ext_opt: i32 = 3;
    var ext_amt: i32 = 0;
    var ext_has_amt: boolean = false;
    if (parts.len() > 1) {
        var p1: string = arm64_gas_trim(parts[1]);
        var r: i32 = arm64_gas_reg(p1);
        if (arm64_str_indexof(p1, "#") < 0 && r >= 0) {
            off_reg = r;
            idx_w = arm64_gas_is_w(p1);
            if (parts.len() > 2) {
                var p2: string = arm64_gas_trim(parts[2]);
                ext_opt = arm64_gas_mem_opt(p2);
                if (arm64_str_indexof(p2, "#") >= 0) {
                    ext_amt = arm64_gas_lsl_amount(p2);
                    ext_has_amt = true;
                }
            }
        } else {
            off = arm64_gas_imm(p1);
        }
    }
    return Arm64Mem { base: base, off: off, off_reg: off_reg,
        idx_w: idx_w, ext_opt: ext_opt, ext_amt: ext_amt, ext_has_amt: ext_has_amt };
}

// arm64_gas_mem_opt maps a memory operand's extend piece to its option
// selector: lsl -> 3 (and REQUIRES an amount, as GNU as does), uxtw -> 2,
// sxtw -> 6, sxtx -> 7. Anything else — including the extends that are
// not valid here, like uxtb — is -1, refused by the caller rather than
// defaulting to LSL.
function arm64_gas_mem_opt(p: string): i32 {
    if (arm64_str_indexof(p, "lsl") == 0) {
        if (arm64_str_indexof(p, "#") < 0) { return 0 - 1; }
        return 3;
    }
    if (arm64_str_indexof(p, "uxtw") == 0) { return 2; }
    if (arm64_str_indexof(p, "sxtw") == 0) { return 6; }
    if (arm64_str_indexof(p, "sxtx") == 0) { return 7; }
    return 0 - 1;
}

// arm64_movwide_hw finds the single nonzero 16-bit chunk of `v` and returns its
// shift (0/16/32/48), or -1 when more than one chunk is set.
//
// GAS accepts `mov x9, #0x10000` and encodes it `movz x9, #1, lsl #16` — the
// immediate names a value, and the assembler picks the chunk. This assembler
// masked the value into imm16 instead, so `mov x9, #0x10000` LOADED ZERO. That
// is 20 sites in one hello-world build, one of them the freelist size-class cap
// (#6060).
function arm64_movwide_hw(v: i64): i32 {
    if (v == 0) { return 0; }
    var sh: i32 = 0;
    var found: i32 = 0 - 1;
    while (sh < 64) {
        var chunk: i64 = (v >> sh) & 0xffff;
        if (chunk != 0) {
            if (found >= 0) { return 0 - 1; }   // more than one chunk: needs movz+movk
            found = sh;
        }
        sh = sh + 16;
    }
    return found;
}

// arm64_gas_movwide_out_of_range reports whether a mov/movz/movn immediate needs
// MORE THAN ONE mov-wide instruction (two or more nonzero 16-bit chunks), which
// this one-instruction-per-line assembler cannot emit. Anything expressible as a
// single chunk plus a shift is encoded, not refused. The emitter builds wider
// constants through the literal pool (`ldr Xt, =N`).
function arm64_gas_movwide_out_of_range(mnem: string, rest: string): boolean {
    if (mnem != "mov" && mnem != "movz" && mnem != "movn") { return false; }
    var ops: string[] = arm64_gas_operands(rest);
    if (ops.len() < 2) { return false; }
    if (ops[1].len() == 0 || ops[1][0] != b'#') { return false; }   // register form
    if (ops.len() > 2 && arm64_gas_lsl_amount(ops[2]) != 0) { return false; }  // explicit shift
    var v: i64 = arm64_gas_imm(ops[1]) as i64;
    if (v < 0) { v = (0 - v) - 1; }
    return arm64_movwide_hw(v) < 0;
}

// arm64_gas_regoff_unsupported reports whether `rest` puts a REGISTER in the
// offset position of a memory operand that `mnem`'s encoder cannot express.
// ldr/str/ldrb/strb/ldrh/strh all encode register (and extended-register)
// offsets through arm64_ldst_regext; the sign-extending loads, ldur and
// stur have only an immediate-offset encoder, and must refuse rather than
// quietly drop the index register.
function arm64_gas_regoff_unsupported(mnem: string, rest: string): boolean {
    if (mnem != "ldrsw" && mnem != "ldrsb" && mnem != "ldrsh" && mnem != "ldur" && mnem != "stur") { return false; }
    var ops: string[] = arm64_gas_operands(rest);
    var i: i32 = 0;
    while (i < ops.len()) {
        if (arm64_str_indexof(ops[i], "[") >= 0 && arm64_gas_mem(ops[i]).off_reg >= 0) { return true; }
        i = i + 1;
    }
    return false;
}

// arm64_gas_has_bang reports whether an operand carries the `!` pre-index
// writeback marker.
function arm64_gas_has_bang(op: string): boolean {
    return arm64_str_indexof(op, "!") >= 0;
}

// arm64_gas_writeback_unsupported reports whether `rest` asks for a `!`
// pre-index WRITEBACK on a mnemonic whose only encoder here is the plain
// unsigned-offset form. `ldr` / `str` / `ldp` / `stp` implement it (that is the
// operand stack's whole idiom); the byte / half-word / sign-extending forms do
// not, and arm64_gas_mem drops the `!` silently — so the base register was left
// UNCHANGED while the emitted code went on to undo a decrement that never
// happened. #6083: `__fern_eprint_str` claimed its newline scratch with
// `strb w1, [sp, #-16]!` and released it with `add sp, sp, #16`, so every
// eprint raised sp by 16 and the next call ran on a corrupted frame — a SEGV
// arbitrarily later, with eprint's own output looking perfectly fine.
function arm64_gas_writeback_unsupported(mnem: string, rest: string): boolean {
    if (mnem != "ldrb" && mnem != "strb" && mnem != "ldrh" && mnem != "strh" && mnem != "ldrsw"
        && mnem != "ldrsb" && mnem != "ldrsh" && mnem != "ldur" && mnem != "stur") { return false; }
    var ops: string[] = arm64_gas_operands(rest);
    var i: i32 = 0;
    while (i < ops.len()) {
        if (arm64_str_indexof(ops[i], "[") >= 0 && arm64_gas_has_bang(ops[i])) { return true; }
        i = i + 1;
    }
    return false;
}

// arm64_gas_lsl_amount parses a `lsl #N` shift operand (the `lsl #16` of a
// movk); returns 0 if it is not recognised.
function arm64_gas_lsl_amount(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    var h: i32 = arm64_str_indexof(s, "#");
    if (h < 0) {
        return 0;
    }
    return arm64_gas_atoi(arm64_gas_trim(slice_unchecked(s, h + 1, s.len())));
}

// arm64_gas_shift_type maps the shift keyword of a `<shift> #N` operand to
// its 2-bit selector, or -1 when the token names no shift.
function arm64_gas_shift_type(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (arm64_str_indexof(s, "lsl") == 0) { return 0; }
    if (arm64_str_indexof(s, "lsr") == 0) { return 1; }
    if (arm64_str_indexof(s, "asr") == 0) { return 2; }
    if (arm64_str_indexof(s, "ror") == 0) { return 3; }
    return 0 - 1;
}

// arm64_gas_extend_option maps the extend keyword of a `<extend> {#N}` operand
// to its 3-bit selector, or -1 when the token names no extend. `sxt` is tested
// before `uxt` only for symmetry; the two prefixes are disjoint.
function arm64_gas_extend_option(tok: string): i32 {
    var s: string = arm64_gas_trim(tok);
    if (arm64_str_indexof(s, "uxtb") == 0) { return 0; }
    if (arm64_str_indexof(s, "uxth") == 0) { return 1; }
    if (arm64_str_indexof(s, "uxtw") == 0) { return 2; }
    if (arm64_str_indexof(s, "uxtx") == 0) { return 3; }
    if (arm64_str_indexof(s, "sxtb") == 0) { return 4; }
    if (arm64_str_indexof(s, "sxth") == 0) { return 5; }
    if (arm64_str_indexof(s, "sxtw") == 0) { return 6; }
    if (arm64_str_indexof(s, "sxtx") == 0) { return 7; }
    return 0 - 1;
}

// arm64_gas_addsub_operand_unsupported reports whether an add/sub carries a
// fourth operand this assembler cannot encode. The shifted and extended forms
// below cover what the backend emits; anything else must refuse the line
// rather than drop the operand, which is what made `add x0, x1, x0, lsl #2`
// read element [0] for every index (#6849).
function arm64_gas_addsub_operand_unsupported(mnem: string, rest: string): boolean {
    if (mnem != "add" && mnem != "sub") { return false; }
    var ops: string[] = arm64_gas_operands(rest);
    if (ops.len() < 4) { return false; }
    if (arm64_gas_shift_type(ops[3]) >= 0) { return false; }
    if (arm64_gas_extend_option(ops[3]) >= 0) { return false; }
    return true;
}

// ---- the #7886 instruction families ----
//
// Each family has a predicate (consulted by BOTH arm64_gas_known and the
// dispatch, so the list and the dispatch cannot drift the way #6060/#6044
// did), a shape guard feeding p.unknown, and an emitter. An emitter may
// be reached after its guard has already recorded a refusal; it returns
// the assembler unchanged on a shape it cannot index safely.

function arm64_gas_is_carry(mnem: string): boolean {
    return mnem == "adc" || mnem == "adcs" || mnem == "sbc" || mnem == "sbcs"
        || mnem == "ngc" || mnem == "ngcs";
}
function arm64_gas_is_mulwide(mnem: string): boolean {
    return mnem == "umulh" || mnem == "smulh" || mnem == "madd" || arm64_gas_is_widening(mnem);
}
function arm64_gas_is_widening(mnem: string): boolean {
    return mnem == "smull" || mnem == "umull" || mnem == "smaddl" || mnem == "umaddl"
        || mnem == "smsubl" || mnem == "umsubl";
}
function arm64_gas_is_logical2(mnem: string): boolean {
    return mnem == "ands" || mnem == "bic" || mnem == "bics" || mnem == "orn"
        || mnem == "eon" || mnem == "tst" || mnem == "mvn" || mnem == "negs";
}
function arm64_gas_is_bitfield(mnem: string): boolean {
    return mnem == "bfi" || mnem == "bfxil" || mnem == "ubfiz" || mnem == "sbfiz";
}
function arm64_gas_is_condsel(mnem: string): boolean {
    return mnem == "ccmp" || mnem == "ccmn" || mnem == "csinc" || mnem == "csinv" || mnem == "csneg"
        || mnem == "cinc" || mnem == "cinv" || mnem == "cneg" || mnem == "csetm";
}
function arm64_gas_is_excl(mnem: string): boolean {
    return arm64_gas_is_excl_ld(mnem) || arm64_gas_is_excl_st(mnem) || arm64_gas_is_acqrel(mnem);
}
function arm64_gas_is_excl_ld(mnem: string): boolean {
    return mnem == "ldxr" || mnem == "ldxrb" || mnem == "ldxrh"
        || mnem == "ldaxr" || mnem == "ldaxrb" || mnem == "ldaxrh";
}
function arm64_gas_is_excl_st(mnem: string): boolean {
    return mnem == "stxr" || mnem == "stxrb" || mnem == "stxrh"
        || mnem == "stlxr" || mnem == "stlxrb" || mnem == "stlxrh";
}
function arm64_gas_is_acqrel(mnem: string): boolean {
    return mnem == "ldar" || mnem == "ldarb" || mnem == "ldarh"
        || mnem == "stlr" || mnem == "stlrb" || mnem == "stlrh";
}
function arm64_gas_is_unscaled2(mnem: string): boolean {
    return mnem == "ldurb" || mnem == "sturb" || mnem == "ldurh" || mnem == "sturh"
        || mnem == "ldursb" || mnem == "ldursh" || mnem == "ldursw";
}

// ---- family guards ----

// arm64_gas_bad_ext_token vets the family operand shapes the way
// arm64_gas_bad_vec_token vets the NEON ones: a shape the encoders cannot
// express comes back non-empty, the program loop records it, and the
// driver refuses the output — never a value folded into a field that does
// not exist. "" = clean, or not one of these families.
function arm64_gas_bad_ext_token(mnem: string, rest: string): string {
    var ops: string[] = arm64_gas_operands(rest);
    // An arranged vector operand routes the mnemonic to its SIMD form, so the
    // scalar family checks do not apply — the dual-form ones (fadd, fmul,
    // fneg, add, …) would reject `v23.4s` as a bad scalar register. The
    // vector shapes are vetted by arm64_gas_bad_vecgen instead.
    if (ops.len() > 0 && arm64_gas_is_vecarr(ops[0])) { return ""; }
    var t: string = arm64_gas_bad_ext_alu(mnem, ops);
    if (t.len() > 0) { return t; }
    t = arm64_gas_bad_ext_mem(mnem, ops);
    if (t.len() > 0) { return t; }
    return arm64_gas_bad_ext_fp(mnem, ops);
}
function arm64_gas_bad_ext_alu(mnem: string, ops: string[]): string {
    if (arm64_gas_is_carry(mnem) || arm64_gas_is_mulwide(mnem)) { return arm64_gas_bad_carrymul(mnem, ops); }
    // adds is register-only here: an immediate would mis-read as a register.
    if (mnem == "adds") {
        if (ops.len() != 3) { return "arity"; }
        if (ops[2].len() > 0 && ops[2][0] == b'#') { return "imm"; }
        return "";
    }
    if (arm64_gas_is_logical2(mnem)) { return arm64_gas_bad_logical2(mnem, ops); }
    if (arm64_gas_is_bitfield(mnem) || mnem == "extr" || mnem == "ror"
        || mnem == "ubfx" || mnem == "sbfx") { return arm64_gas_bad_bitfield(mnem, ops); }
    if (arm64_gas_is_condsel(mnem)) { return arm64_gas_bad_condsel(mnem, ops); }
    if (mnem == "rev" || mnem == "rev32" || mnem == "cls") { return arm64_gas_bad_rev(mnem, ops); }
    if (mnem == "and" || mnem == "orr" || mnem == "eor") { return arm64_gas_bad_shift4(ops); }
    return "";
}
function arm64_gas_bad_ext_mem(mnem: string, ops: string[]): string {
    if (arm64_gas_is_excl(mnem)) { return arm64_gas_bad_excl(mnem, ops); }
    if (mnem == "dmb" || mnem == "dsb" || mnem == "isb") { return arm64_gas_bad_barrier(mnem, ops); }
    if (arm64_gas_is_unscaled2(mnem)) { return arm64_gas_bad_unscaled2(mnem, ops); }
    if (mnem == "stp" || mnem == "ldp") { return arm64_gas_bad_pair(mnem, ops); }
    if (mnem == "ldr" || mnem == "str" || mnem == "ldrb" || mnem == "strb" || mnem == "ldrh" || mnem == "strh") {
        var re: string = arm64_gas_bad_regext(mnem, ops);
        if (re != "") { return re; }
    }
    if (mnem == "ldr" || mnem == "str" || mnem == "ldrb" || mnem == "strb" || mnem == "ldrh" || mnem == "strh"
        || mnem == "ldrsb" || mnem == "ldrsh" || mnem == "ldrsw") {
        return arm64_gas_bad_ldst_off(mnem, ops);
    }
    return "";
}

// An immediate offset must fit ONE of the two encodings: the scaled
// unsigned imm12 (a non-negative multiple of the access size, reaching
// 4095*size) or the unscaled signed imm9 (-256..255, any alignment). An
// offset in neither is not merely unrepresentable — both fields WRAP, so
// emitting one anyway yields a valid instruction addressing somewhere else
// entirely. gas refuses these with "immediate offset out of range".
function arm64_gas_bad_ldst_off(mnem: string, ops: string[]): string {
    if (ops.len() != 2) { return ""; }                        // post-index takes another path
    if (arm64_str_indexof(ops[1], "[") < 0) { return ""; }    // `ldr x0, =literal`
    if (arm64_gas_has_bang(ops[1])) { return ""; }            // pre-index is its own imm9
    if (arm64_gas_is_d(ops[0]) || arm64_gas_is_sreg(ops[0])) { return ""; } // FP scales differ
    var m: Arm64Mem = arm64_gas_mem(ops[1]);
    if (m.off_reg >= 0) { return ""; }
    if (arm64_ldst_scalable(m.off, arm64_gas_ldst_size(mnem, ops[0]))) { return ""; }
    if (m.off >= (0 - 256) && m.off <= 255) { return ""; }
    return "off";
}
function arm64_gas_bad_ext_fp(mnem: string, ops: string[]): string {
    if (mnem == "fcmp" || mnem == "fcmpe") { return arm64_gas_bad_fcmp(ops); }
    if (arm64_funary_d_base(mnem) >= 0) {
        if (ops.len() != 2) { return "arity"; }
        return arm64_gas_bad_fp_mix(ops, 2);
    }
    if (arm64_fp3_base(mnem) >= 0) {
        if (ops.len() != 3) { return "arity"; }
        return arm64_gas_bad_fp_mix(ops, 3);
    }
    if (arm64_fp4_base(mnem) >= 0) {
        if (ops.len() != 4) { return "arity"; }
        return arm64_gas_bad_fp_mix(ops, 4);
    }
    if (mnem == "fcsel") {
        if (ops.len() != 4) { return "arity"; }
        var t: string = arm64_gas_bad_fp_mix(ops, 3);
        if (t.len() > 0) { return t; }
        return "";
    }
    if (mnem == "fccmp") {
        if (ops.len() != 4) { return "arity"; }
        var t2: string = arm64_gas_bad_fp_mix(ops, 2);
        if (t2.len() > 0) { return t2; }
        return arm64_gas_bad_nzcv_cond(ops);
    }
    return "";
}

// The carry ops and multiplies are register-only, and the high/widening
// multiplies have fixed register widths (no sf bit) — a wrong width is
// refused, never reinterpreted.
function arm64_gas_bad_carrymul(mnem: string, ops: string[]): string {
    var want: i32 = 3;
    if (mnem == "ngc" || mnem == "ngcs") { want = 2; }
    if (mnem == "madd" || (arm64_gas_is_widening(mnem) && mnem != "smull" && mnem != "umull")) { want = 4; }
    if (ops.len() != want) { return "arity"; }
    var i: i32 = 0;
    while (i < ops.len()) {
        if (ops[i].len() > 0 && ops[i][0] == b'#') { return "imm"; }
        i = i + 1;
    }
    if (mnem == "umulh" || mnem == "smulh") {
        if (arm64_gas_is_w(ops[0]) || arm64_gas_is_w(ops[1]) || arm64_gas_is_w(ops[2])) { return "w"; }
        return "";
    }
    if (arm64_gas_is_widening(mnem)) { return arm64_gas_bad_widening(ops); }
    return "";
}
// Xd, Wn, Wm{, Xa} — the widths ARE the instruction.
function arm64_gas_bad_widening(ops: string[]): string {
    if (arm64_gas_is_w(ops[0]) || !arm64_gas_is_w(ops[1]) || !arm64_gas_is_w(ops[2])) { return "width"; }
    if (ops.len() == 4 && arm64_gas_is_w(ops[3])) { return "width"; }
    return "";
}

// tst/ands take a bitmask immediate; bic/bics/orn/eon have NO immediate
// encoding (the bitmask class has no invert bit — GAS aliases `bic #v` to
// `and #~v`, refused here so what was encoded is what was written).
function arm64_gas_bad_logical2(mnem: string, ops: string[]): string {
    if (mnem == "negs") {
        if (ops.len() != 2) { return "arity"; }
        return "";
    }
    var base_n: i32 = 3;
    if (mnem == "tst" || mnem == "mvn") { base_n = 2; }
    if (ops.len() < base_n || ops.len() > base_n + 1) { return "arity"; }
    var last: string = ops[base_n - 1];
    if (last.len() > 0 && last[0] == b'#') {
        if (mnem != "tst" && mnem != "ands") { return "imm"; }
        if (ops.len() != base_n) { return "imm"; }   // no shift on the immediate form
        return arm64_gas_bad_bitmask_imm(last, arm64_gas_is_w(ops[0]));
    }
    if (ops.len() == base_n + 1 && arm64_gas_shift_type(ops[base_n]) < 0) { return arm64_gas_trim(ops[base_n]); }
    return "";
}
// The same validity rule the and#/eor# program-loop paths apply.
function arm64_gas_bad_bitmask_imm(tok: string, w: boolean): string {
    var imm: i32 = arm64_gas_imm(tok);
    if (!arm64_and_imm_ok(imm)) { return "imm"; }
    if (w && !arm64_logical_imm_w_ok(imm)) { return "imm"; }
    return "";
}
// arm64_gas_third_is_imm reports whether a logical op's THIRD operand is
// an immediate. The and#/eor# program-loop paths keyed on any '#' in the
// line, which also matched the shift amount of `and x1, x2, x3, lsr #4`
// and encoded the register token as a bitmask.
function arm64_gas_third_is_imm(rest: string): boolean {
    var ops: string[] = arm64_gas_operands(rest);
    return ops.len() > 2 && ops[2].len() > 0 && ops[2][0] == b'#';
}

// and/orr/eor: a fourth operand must be a shift (the immediate forms are
// vetted in the program loop).
function arm64_gas_bad_shift4(ops: string[]): string {
    if (ops.len() < 4) { return ""; }
    if (ops.len() > 4 || arm64_gas_shift_type(ops[3]) < 0) { return "shift"; }
    return "";
}

// extr/ror shifts and the bitfield fields — the insert aliases and the
// extract pair — are range-checked: the encoders mask, so an out-of-range
// value would wrap into a different, valid instruction.
function arm64_gas_bad_bitfield(mnem: string, ops: string[]): string {
    var size: i32 = 64;
    if (ops.len() > 0 && arm64_gas_is_w(ops[0])) { size = 32; }
    if (mnem == "ror") { return arm64_gas_bad_ror(ops, size); }
    if (ops.len() != 4) { return "arity"; }
    if (ops[3].len() == 0 || ops[3][0] != b'#') { return "imm"; }
    if (mnem == "extr") {
        var lsb: i32 = arm64_gas_imm(ops[3]);
        if (lsb < 0 || lsb >= size) { return "range"; }
        return "";
    }
    if (ops[2].len() == 0 || ops[2][0] != b'#') { return "imm"; }
    var flsb: i32 = arm64_gas_imm(ops[2]);
    var fw: i32 = arm64_gas_imm(ops[3]);
    if (flsb < 0 || fw < 1 || flsb + fw > size) { return "range"; }
    return "";
}
function arm64_gas_bad_ror(ops: string[], size: i32): string {
    if (ops.len() != 3) { return "arity"; }
    if (ops[2].len() > 0 && ops[2][0] == b'#') {
        var n: i32 = arm64_gas_imm(ops[2]);
        if (n < 0 || n >= size) { return "range"; }
    }
    return "";
}
// ccmp/ccmn: nzcv is 4 bits, the imm5 form is UNSIGNED 0..31, and the
function arm64_gas_bad_condsel(mnem: string, ops: string[]): string {
    var want: i32 = 4;
    if (mnem == "cinc" || mnem == "cinv" || mnem == "cneg") { want = 3; }
    if (mnem == "csetm") { want = 2; }
    if (ops.len() != want) { return "arity"; }
    if (mnem != "ccmp" && mnem != "ccmn") { return ""; }
    return arm64_gas_bad_nzcv_cond(ops);
}
function arm64_gas_bad_nzcv_cond(ops: string[]): string {
    var nzcv: i32 = arm64_gas_imm(ops[2]);
    if (nzcv < 0 || nzcv > 15) { return "nzcv"; }
    if (ops[1].len() > 0 && ops[1][0] == b'#') {
        var imm5: i32 = arm64_gas_imm(ops[1]);
        if (imm5 < 0 || imm5 > 31) { return "imm5"; }
    }
    return "";
}

function arm64_gas_bad_rev(mnem: string, ops: string[]): string {
    if (ops.len() != 2) { return "arity"; }
    if (mnem == "rev32" && (arm64_gas_is_w(ops[0]) || arm64_gas_is_w(ops[1]))) { return "w"; }
    return "";
}

// The exclusives/ordered accesses take a plain [Xn] (no offset, index or
// writeback), a W status register, and W data for the b/h variants.
function arm64_gas_bad_excl(mnem: string, ops: string[]): string {
    var want: i32 = 2;
    if (arm64_gas_is_excl_st(mnem)) { want = 3; }
    if (ops.len() != want) { return "arity"; }
    if (want == 3 && !arm64_gas_is_w(ops[0])) { return "status"; }
    if (arm64_gas_excl_size(mnem, ops[want - 2]) < 0) { return "w"; }
    var m: Arm64Mem = arm64_gas_mem(ops[want - 1]);
    if (m.off != 0 || m.off_reg >= 0 || arm64_gas_has_bang(ops[want - 1])) { return "mem"; }
    return "";
}
// A b/h suffix fixes the access size (W data only); otherwise the data
// register's width picks word vs doubleword. -1 = invalid width.
function arm64_gas_excl_size(mnem: string, rt: string): i32 {
    var lastc: u8 = mnem[mnem.len() - 1];
    if (lastc == b'b' || lastc == b'h') {
        if (!arm64_gas_is_w(rt)) { return 0 - 1; }
        if (lastc == b'b') { return 0; }
        return 1;
    }
    if (arm64_gas_is_w(rt)) { return 2; }
    return 3;
}

function arm64_gas_bad_barrier(mnem: string, ops: string[]): string {
    if (mnem == "isb") {
        if (ops.len() == 0) { return ""; }
        if (ops.len() == 1 && arm64_gas_trim(ops[0]) == "sy") { return ""; }
        return "opt";
    }
    // GNU as requires the option on dmb/dsb.
    if (ops.len() != 1 || arm64_barrier_opt(arm64_gas_trim(ops[0])) < 0) { return "opt"; }
    return "";
}

// The unscaled b/h and sign-extending forms take a plain [Xn{, #imm9}]
// with imm9 in -256..255; ldursw's destination is X only.
function arm64_gas_bad_unscaled2(mnem: string, ops: string[]): string {
    if (ops.len() != 2) { return "arity"; }
    if (mnem == "ldursw" && arm64_gas_is_w(ops[0])) { return "w"; }
    var m: Arm64Mem = arm64_gas_mem(ops[1]);
    if (m.off_reg >= 0 || arm64_gas_has_bang(ops[1])) { return "mem"; }
    if (m.off < (0 - 256) || m.off > 255) { return "imm9"; }
    return "";
}

// stp/ldp: the register class (X/W/D) picks the offset scale, s-register
// pairs are a loud gap, and the offset is range-checked here — the
// encoder masks it into imm7, so out of range would encode a different,
// valid instruction.
function arm64_gas_bad_pair(mnem: string, ops: string[]): string {
    if (ops.len() < 3 || ops.len() > 4) { return "arity"; }
    if (arm64_gas_is_sreg(ops[0]) || arm64_gas_is_sreg(ops[1])) { return "sreg"; }
    if (arm64_gas_is_w(ops[0]) != arm64_gas_is_w(ops[1])) { return "width"; }
    if (arm64_gas_is_d(ops[0]) != arm64_gas_is_d(ops[1])) { return "width"; }
    var scale: i32 = 8;
    if (arm64_gas_is_w(ops[0])) { scale = 4; }
    var off: i32 = arm64_gas_mem(ops[2]).off;
    if (ops.len() == 4) {
        if (off != 0) { return "mem"; }   // post-index base must be plain [Xn]
        off = arm64_gas_imm(ops[3]);
    }
    if (off % scale != 0 || off < (0 - 64) * scale || off > 63 * scale) { return "range"; }
    return "";
}

// A register-offset memory operand on the plain loads/stores: the extend
// must match the offset register's width — a W index REQUIRES uxtw/sxtw,
// lsl/sxtx take an X index — and the amount must be 0 or log2 of the
// access size. The FP registers have no register-offset encoder here.
function arm64_gas_bad_regext(mnem: string, ops: string[]): string {
    if (ops.len() != 2) { return ""; }   // post-index and `=literal` shapes take other paths
    var m: Arm64Mem = arm64_gas_mem(ops[1]);
    if (m.off_reg < 0) { return ""; }
    if (arm64_gas_is_d(ops[0]) || arm64_gas_is_sreg(ops[0])) { return "regoff"; }
    if (m.ext_opt < 0) { return "ext"; }
    if (m.idx_w != (m.ext_opt == 2 || m.ext_opt == 6)) { return "ext"; }
    if (m.ext_has_amt && m.ext_amt != 0 && m.ext_amt != arm64_gas_ldst_size(mnem, ops[0])) { return "ext"; }
    return "";
}
// Access size (log2) of a plain load/store; ldr/str follow the data
// register's width. The sign-extending loads take their size from the
// mnemonic, NOT the destination: `ldrsb x1, ...` still reads one byte.
function arm64_gas_ldst_size(mnem: string, rt: string): i32 {
    if (mnem == "ldrb" || mnem == "strb" || mnem == "ldrsb") { return 0; }
    if (mnem == "ldrh" || mnem == "strh" || mnem == "ldrsh") { return 1; }
    if (mnem == "ldrsw") { return 2; }
    if (arm64_gas_is_w(rt)) { return 2; }
    return 3;
}

// arm64_ldst_scalable reports whether an immediate offset fits the UNSIGNED
// SCALED imm12 form. When it does not, the signed unscaled imm9 (the ldur
// family) is the only single-instruction encoding, and gas selects between
// them from the offset alone: `ldrb w1, [x2, #-1]` assembles as LDURB, and
// `ldrh w1, [x2, #3]` as LDURH because 3 is not a multiple of 2.
//
// Both spellings are the same source text and both encode to a valid
// instruction, so picking the wrong one does not fail — it addresses a
// different byte. Scaling a negative offset lands it 4096 bytes away.
function arm64_ldst_scalable(off: i32, size: i32): boolean {
    if (off < 0) { return false; }
    var scale: i32 = arm64_gas_pow2(size);
    if ((off & (scale - 1)) != 0) { return false; }
    return (off / scale) <= 4095;
}

// The scalar FP families refuse a precision mix or a non-FP register —
// each would select a different instruction on the same bytes.
function arm64_gas_bad_fp_mix(ops: string[], n: i32): string {
    var s0: boolean = arm64_gas_is_sreg(ops[0]);
    var i: i32 = 0;
    while (i < n) {
        if (!arm64_gas_is_d(ops[i]) && !arm64_gas_is_sreg(ops[i])) { return arm64_gas_trim(ops[i]); }
        if (arm64_gas_is_sreg(ops[i]) != s0) { return "fpwidth"; }
        i = i + 1;
    }
    return "";
}
function arm64_gas_bad_fcmp(ops: string[]): string {
    if (ops.len() != 2) { return "arity"; }
    if (ops[1].len() > 0 && ops[1][0] == b'#') {
        var t: string = arm64_gas_trim(ops[1]);
        // Only the literal zero exists: #0.0 is part of the opcode.
        if (t != "#0.0" && t != "#0") { return "imm"; }
        return "";
    }
    return arm64_gas_bad_fp_mix(ops, 2);
}

// ---- family emitters ----

function arm64_carry_base(mnem: string): i64 {
    if (mnem == "adc") { return 0x9a000000; }
    if (mnem == "adcs") { return 0xba000000; }
    if (mnem == "sbc" || mnem == "ngc") { return 0xda000000; }
    return 0xfa000000; // sbcs / ngcs
}
function arm64_gas_emit_carry(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    var w: boolean = arm64_gas_is_w(ops[0]);
    if (mnem == "ngc" || mnem == "ngcs") {
        if (ops.len() < 2) { return a; }
        return Arm64Asm { ...a, code: arm64_rrr(a.code, arm64_carry_base(mnem), arm64_gas_reg(ops[0]), 31, arm64_gas_reg(ops[1]), w) };
    }
    if (ops.len() < 3) { return a; }
    return Arm64Asm { ...a, code: arm64_rrr(a.code, arm64_carry_base(mnem), arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), w) };
}

function arm64_mulwide_base(mnem: string): i64 {
    if (mnem == "smull" || mnem == "smaddl") { return 0x9b200000; }
    if (mnem == "umull" || mnem == "umaddl") { return 0x9ba00000; }
    if (mnem == "smsubl") { return 0x9b208000; }
    return 0x9ba08000; // umsubl
}
function arm64_gas_emit_mulwide(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (ops.len() < 3) { return a; }
    if (mnem == "umulh" || mnem == "smulh") {
        var hb: i64 = 0x9bc07c00;
        if (mnem == "smulh") { hb = 0x9b407c00; }
        return Arm64Asm { ...a, code: arm64_rrr(a.code, hb, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), false) };
    }
    if (mnem == "madd") {
        if (ops.len() < 4) { return a; }
        return Arm64Asm { ...a, code: arm64_muladd(a.code, 0x9b000000, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_reg(ops[3]), arm64_gas_is_w(ops[0])) };
    }
    var ra: i32 = 31;
    if (ops.len() >= 4) { ra = arm64_gas_reg(ops[3]); }
    return Arm64Asm { ...a, code: arm64_muladd(a.code, arm64_mulwide_base(mnem), arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), ra, false) };
}

function arm64_logical2_base(mnem: string): i64 {
    if (mnem == "ands" || mnem == "tst") { return 0xea000000; }
    if (mnem == "bic") { return 0x8a200000; }
    if (mnem == "bics") { return 0xea200000; }
    if (mnem == "orn" || mnem == "mvn") { return 0xaa200000; }
    return 0xca200000; // eon
}
function arm64_gas_emit_logical2(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    var w: boolean = arm64_gas_is_w(ops[0]);
    if (mnem == "negs") {
        if (ops.len() < 2) { return a; }
        return Arm64Asm { ...a, code: arm64_rrr(a.code, 0xeb000000, arm64_gas_reg(ops[0]), 31, arm64_gas_reg(ops[1]), w) };
    }
    var base_n: i32 = 3;
    if (mnem == "tst" || mnem == "mvn") { base_n = 2; }
    if (ops.len() < base_n) { return a; }
    var rd: i32 = arm64_gas_reg(ops[0]);
    var rn: i32 = rd;
    if (mnem == "tst") { rd = 31; }
    if (mnem == "mvn") { rn = 31; }
    if (base_n == 3) { rn = arm64_gas_reg(ops[1]); }
    var rm_tok: string = ops[base_n - 1];
    if (rm_tok.len() > 0 && rm_tok[0] == b'#') {
        if (mnem != "tst" && mnem != "ands") { return a; }
        return Arm64Asm { ...a, code: arm64_ands_imm(a.code, rd, rn, arm64_gas_imm(rm_tok), w) };
    }
    var st: i32 = 0;
    var amt: i32 = 0;
    if (ops.len() > base_n) {
        st = arm64_gas_shift_type(ops[base_n]);
        amt = arm64_gas_lsl_amount(ops[base_n]);
    }
    return Arm64Asm { ...a, code: arm64_logical_shift(a.code, arm64_logical2_base(mnem), rd, rn, arm64_gas_reg(rm_tok), st, amt, w) };
}

function arm64_bfm_base(mnem: string, w: boolean): i64 {
    if (mnem == "ubfiz") {
        if (w) { return 0x53000000; }
        return 0xd3400000;
    }
    if (mnem == "sbfiz") {
        if (w) { return 0x13000000; }
        return 0x93400000;
    }
    if (w) { return 0x33000000; }
    return 0xb3400000; // bfi / bfxil
}
// bfi/ubfiz/sbfiz place a field AT lsb: immr = (-lsb) mod size, imms =
// width-1. bfxil extracts FROM lsb: immr = lsb, imms = lsb+width-1.
function arm64_gas_emit_bitfield(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (ops.len() < 4) { return a; }
    var w: boolean = arm64_gas_is_w(ops[0]);
    var size: i32 = 64;
    if (w) { size = 32; }
    var lsb: i32 = arm64_gas_imm(ops[2]);
    var width: i32 = arm64_gas_imm(ops[3]);
    if (lsb < 0 || width < 1 || lsb + width > size) { return a; }
    var immr: i32 = (size - lsb) % size;
    var imms: i32 = width - 1;
    if (mnem == "bfxil") { immr = lsb; imms = lsb + width - 1; }
    return Arm64Asm { ...a, code: arm64_bitfield(a.code, arm64_bfm_base(mnem, w), arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), immr, imms) };
}

function arm64_gas_emit_extr_ror(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (mnem == "extr") {
        if (ops.len() < 4) { return a; }
        return Arm64Asm { ...a, code: arm64_extr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_imm(ops[3]), arm64_gas_is_w(ops[0])) };
    }
    if (ops.len() < 3) { return a; }
    if (ops[2].len() > 0 && ops[2][0] == b'#') {   // extr Rd, Rn, Rn, #n alias
        return Arm64Asm { ...a, code: arm64_extr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
    }
    return Arm64Asm { ...a, code: arm64_rrr(a.code, 0x9ac02c00, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_w(ops[0])) };
}

function arm64_condsel_base(mnem: string): i64 {
    if (mnem == "csinc" || mnem == "cinc") { return 0x9a800400; }
    if (mnem == "csinv" || mnem == "cinv" || mnem == "csetm") { return 0xda800000; }
    return 0xda800400; // csneg / cneg
}
// The cinc/cinv/cneg/csetm aliases invert the condition (like cset), so
// the operation applies when it holds.
function arm64_gas_emit_condsel(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (mnem == "ccmp" || mnem == "ccmn") { return arm64_gas_emit_condcmp(a, mnem, ops); }
    var w: boolean = arm64_gas_is_w(ops[0]);
    var rd: i32 = arm64_gas_reg(ops[0]);
    if (mnem == "csetm") {
        if (ops.len() < 2) { return a; }
        return Arm64Asm { ...a, code: arm64_condsel(a.code, 0xda800000, rd, 31, 31, arm64_gas_cond(ops[1]) ^ 1, w) };
    }
    if (mnem == "cinc" || mnem == "cinv" || mnem == "cneg") {
        if (ops.len() < 3) { return a; }
        var rn2: i32 = arm64_gas_reg(ops[1]);
        return Arm64Asm { ...a, code: arm64_condsel(a.code, arm64_condsel_base(mnem), rd, rn2, rn2, arm64_gas_cond(ops[2]) ^ 1, w) };
    }
    if (ops.len() < 4) { return a; }
    return Arm64Asm { ...a, code: arm64_condsel(a.code, arm64_condsel_base(mnem), rd, arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_cond(ops[3]), w) };
}
function arm64_gas_emit_condcmp(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (ops.len() < 4) { return a; }
    var base: i64 = 0xfa400000;
    if (mnem == "ccmn") { base = 0xba400000; }
    var rm5: i32 = 0;
    if (ops[1].len() > 0 && ops[1][0] == b'#') {
        base = base | 0x800;
        rm5 = arm64_gas_imm(ops[1]);
    } else {
        rm5 = arm64_gas_reg(ops[1]);
    }
    return Arm64Asm { ...a, code: arm64_condcmp(a.code, base, arm64_gas_reg(ops[0]), rm5, arm64_gas_imm(ops[2]), arm64_gas_cond(ops[3]), arm64_gas_is_w(ops[0])) };
}

function arm64_gas_emit_rev_cls(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (ops.len() < 2) { return a; }
    var rd: i32 = arm64_gas_reg(ops[0]);
    var rn: i32 = arm64_gas_reg(ops[1]);
    if (mnem == "rev") { return Arm64Asm { ...a, code: arm64_rev(a.code, rd, rn, arm64_gas_is_w(ops[0])) }; }
    if (mnem == "rev32") { return Arm64Asm { ...a, code: arm64_rev32(a.code, rd, rn) }; }
    return Arm64Asm { ...a, code: arm64_cls(a.code, rd, rn, arm64_gas_is_w(ops[0])) };
}

function arm64_gas_emit_excl(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (arm64_gas_is_excl_st(mnem)) {
        if (ops.len() < 3) { return a; }
        return Arm64Asm { ...a, code: arm64_excl_store(a.code, arm64_gas_excl_size(mnem, ops[1]),
            arm64_str_starts_with(mnem, "stl"), arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_mem(ops[2]).base) };
    }
    if (ops.len() < 2) { return a; }
    var size: i32 = arm64_gas_excl_size(mnem, ops[0]);
    var rt: i32 = arm64_gas_reg(ops[0]);
    var rn: i32 = arm64_gas_mem(ops[1]).base;
    if (arm64_gas_is_acqrel(mnem)) {
        return Arm64Asm { ...a, code: arm64_acqrel(a.code, size, arm64_str_starts_with(mnem, "ld"), rt, rn) };
    }
    return Arm64Asm { ...a, code: arm64_excl_load(a.code, size, arm64_str_starts_with(mnem, "lda"), rt, rn) };
}

function arm64_gas_emit_barrier(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (mnem == "isb") { return Arm64Asm { ...a, code: arm64_le32(a.code, 0xd5033fdf) }; }
    if (ops.len() < 1) { return a; }
    return Arm64Asm { ...a, code: arm64_barrier(a.code, mnem == "dsb", arm64_barrier_opt(arm64_gas_trim(ops[0]))) };
}

function arm64_gas_emit_unscaled2(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (ops.len() < 2) { return a; }
    var rt: i32 = arm64_gas_reg(ops[0]);
    var m: Arm64Mem = arm64_gas_mem(ops[1]);
    if (mnem == "ldursb" || mnem == "ldursh" || mnem == "ldursw") {
        var ssz: i32 = 0;
        if (mnem == "ldursh") { ssz = 1; }
        if (mnem == "ldursw") { ssz = 2; }
        return Arm64Asm { ...a, code: arm64_ldst_sun(a.code, ssz, !arm64_gas_is_w(ops[0]), rt, m.base, m.off) };
    }
    var sz: i32 = 0;
    if (mnem == "ldurh" || mnem == "sturh") { sz = 1; }
    return Arm64Asm { ...a, code: arm64_ldst_unscaled(a.code, sz, mnem == "ldurb" || mnem == "ldurh", rt, m.base, m.off) };
}

// stp/ldp for X, W and D pairs in the three addressing modes (offset,
// pre-index `!`, post-index fourth operand). The shape and range were
// vetted by arm64_gas_bad_pair.
function arm64_gas_emit_pair(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (ops.len() < 3) { return a; }
    var base: i64 = 0xa8000000;
    var scale: i32 = 8;
    if (arm64_gas_is_w(ops[0])) { base = 0x28000000; scale = 4; }
    if (arm64_gas_is_d(ops[0])) { base = 0x6c000000; }
    if (mnem == "ldp") { base = base | 0x00400000; }
    var m: Arm64Mem = arm64_gas_mem(ops[2]);
    var off: i32 = m.off;
    var mode: i64 = 0x1000000;   // signed offset (2 << 23)
    if (arm64_gas_has_bang(ops[2])) {
        mode = 0x1800000;        // pre-index (3 << 23)
    } else if (ops.len() >= 4) {
        mode = 0x800000;         // post-index (1 << 23)
        off = arm64_gas_imm(ops[3]);
    }
    return Arm64Asm { ...a, code: arm64_pair(a.code, base | mode, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), m.base, off, scale) };
}

// arm64_gas_emit_ldst_regext encodes the register/extended-register
// offset form. The S bit follows GNU as: a bare extend leaves it clear,
// an explicit amount equal to log2(size) — including the byte access's
// `#0` — sets it.
function arm64_gas_emit_ldst_regext(a: Arm64Asm, load: boolean, size: i32, rt: i32, m: Arm64Mem): Arm64Asm {
    var scaled: boolean = m.ext_has_amt && m.ext_amt == size;
    return Arm64Asm { ...a, code: arm64_ldst_regext(a.code, size, load, rt, m.base, m.off_reg, m.ext_opt, scaled) };
}

// Scalar D/S ldr/str in all four addressing modes; a negative or
// unaligned scaled offset falls back to the unscaled imm9 form exactly as
// GNU as rewrites it.
function arm64_gas_emit_ldst_fp(a: Arm64Asm, load: boolean, rt: i32, ops: string[], single: boolean): Arm64Asm {
    if (ops.len() >= 3) {   // post-index `[Xn], #imm9`
        var pm: Arm64Mem = arm64_gas_mem(ops[1]);
        return Arm64Asm { ...a, code: arm64_ldst_fp_imm9(a.code, load, rt, pm.base, arm64_gas_imm(ops[2]), 0x400, single) };
    }
    var m: Arm64Mem = arm64_gas_mem(ops[1]);
    if (arm64_gas_has_bang(ops[1])) {    // pre-index `[Xn, #imm9]!`
        return Arm64Asm { ...a, code: arm64_ldst_fp_imm9(a.code, load, rt, m.base, m.off, 0xc00, single) };
    }
    var align: i32 = 7;
    if (single) { align = 3; }
    if (m.off < 0 || (m.off & align) != 0) {
        return Arm64Asm { ...a, code: arm64_ldst_fp_imm9(a.code, load, rt, m.base, m.off, 0, single) };
    }
    return Arm64Asm { ...a, code: arm64_ldst_fp_scaled(a.code, load, rt, m.base, m.off, single) };
}

function arm64_gas_emit_fpx(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (ops.len() < 4) { return a; }
    if (arm64_fp4_base(mnem) >= 0) {
        return Arm64Asm { ...a, code: arm64_fp4(a.code, arm64_fp4_base(mnem), arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_reg(ops[3]), arm64_gas_is_sreg(ops[0])) };
    }
    if (mnem == "fcsel") {
        return Arm64Asm { ...a, code: arm64_fcsel(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_cond(ops[3]), arm64_gas_is_sreg(ops[0])) };
    }
    // fccmp
    return Arm64Asm { ...a, code: arm64_fccmp(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_cond(ops[3]), arm64_gas_is_sreg(ops[0])) };
}

function arm64_gas_emit_fcmp(a: Arm64Asm, mnem: string, ops: string[]): Arm64Asm {
    if (ops.len() < 2) { return a; }
    var opc: i32 = 0;
    if (mnem == "fcmpe") { opc = 0x10; }
    var rm: i32 = 0;
    if (ops[1].len() > 0 && ops[1][0] == b'#') { opc = opc | 0x08; }
    else { rm = arm64_gas_reg(ops[1]); }
    return Arm64Asm { ...a, code: arm64_fcmp(a.code, arm64_gas_reg(ops[0]), rm, opc, arm64_gas_is_sreg(ops[0])) };
}

// ---- instruction dispatch ----

// arm64_gas_is_bcond reports whether `mnem` is a conditional branch, in
// either GAS spelling: the dotted `b.lt` form or the no-dot `blt` alias.
// arm64_gas_bcond_suffix returns the condition part of such a mnemonic.
function arm64_gas_is_bcond(mnem: string): boolean {
    if (mnem.len() >= 3 && mnem[0] == b'b' && mnem[1] == b'.') { return true; }
    return mnem.len() == 3 && mnem[0] == b'b' && arm64_gas_is_cond(slice_unchecked(mnem, 1, 3));
}
function arm64_gas_bcond_suffix(mnem: string): str {
    if (mnem.len() >= 3 && mnem[0] == b'b' && mnem[1] == b'.') {
        return slice_unchecked(mnem, 2, mnem.len());
    }
    return slice_unchecked(mnem, 1, 3);
}

// arm64_gas_emit assembles one mnemonic + operand string into a.code (or
// queues a label fixup). Unknown mnemonics are ignored.
function arm64_gas_emit(a: Arm64Asm, mnem: string, rest: string): Arm64Asm {
    if (mnem == "ret") {
        a = Arm64Asm { ...a, code: arm64_ret(a.code, arm64_lr()) };
        return a;
    }
    if (mnem == "nop") {
        a = Arm64Asm { ...a, code: arm64_nop(a.code) };
        return a;
    }
    var ops: string[] = arm64_gas_operands(rest);
    // SIMD forms are recognised by the first operand being an arranged vector
    // register, so the mnemonics that have both — add, sub, mul, and, orr,
    // eor, neg, mvn, cmeq — keep their scalar path on scalar operands.
    if (ops.len() > 0 && arm64_gas_is_vecarr(ops[0]) && arm64_gas_vecgen_handles(mnem)) {
        return arm64_gas_emit_vecgen(a, mnem, ops);
    }
    if (mnem == "svc") {
        a = Arm64Asm { ...a, code: arm64_svc(a.code, arm64_gas_imm(ops[0])) };
        return a;
    }
    if (mnem == "blr") {
        a = Arm64Asm { ...a, code: arm64_blr(a.code, arm64_gas_reg(ops[0])) };
        return a;
    }
    if (mnem == "br") {
        if (ops.len() < 1) { return a; }
        a = Arm64Asm { ...a, code: arm64_br(a.code, arm64_gas_reg(ops[0])) };
        return a;
    }
    // The #7886 families, dispatched through the predicates arm64_gas_known
    // shares. Their operand shapes were vetted by arm64_gas_bad_ext_token.
    if (arm64_gas_is_carry(mnem)) { return arm64_gas_emit_carry(a, mnem, ops); }
    if (arm64_gas_is_mulwide(mnem)) { return arm64_gas_emit_mulwide(a, mnem, ops); }
    if (arm64_gas_is_logical2(mnem)) { return arm64_gas_emit_logical2(a, mnem, ops); }
    if (arm64_gas_is_bitfield(mnem)) { return arm64_gas_emit_bitfield(a, mnem, ops); }
    if (mnem == "extr" || mnem == "ror") { return arm64_gas_emit_extr_ror(a, mnem, ops); }
    if (arm64_gas_is_condsel(mnem)) { return arm64_gas_emit_condsel(a, mnem, ops); }
    if (mnem == "rev" || mnem == "rev32" || mnem == "cls") { return arm64_gas_emit_rev_cls(a, mnem, ops); }
    if (arm64_gas_is_excl(mnem)) { return arm64_gas_emit_excl(a, mnem, ops); }
    if (mnem == "dmb" || mnem == "dsb" || mnem == "isb") { return arm64_gas_emit_barrier(a, mnem, ops); }
    if (arm64_gas_is_unscaled2(mnem)) { return arm64_gas_emit_unscaled2(a, mnem, ops); }
    if (mnem == "stp" || mnem == "ldp") { return arm64_gas_emit_pair(a, mnem, ops); }
    if (arm64_fp3_base(mnem) >= 0) {
        if (ops.len() < 3) { return a; }
        return Arm64Asm { ...a, code: arm64_fp3(a.code, arm64_fp3_base(mnem), arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_sreg(ops[0])) };
    }
    if (arm64_fp4_base(mnem) >= 0 || mnem == "fcsel" || mnem == "fccmp") { return arm64_gas_emit_fpx(a, mnem, ops); }
    if (mnem == "fcmp" || mnem == "fcmpe") { return arm64_gas_emit_fcmp(a, mnem, ops); }
    if (mnem == "mov" || mnem == "movz") {
        var rd: i32 = arm64_gas_reg(ops[0]);
        if (ops[1].len() > 0 && ops[1][0] == b'#') {
            // The `lsl #N` operand is part of the VALUE, not decoration: movk
            // below already parsed it, this path passed 0, and
            // `movz x5, #0x400, lsl #16` therefore loaded 0x400 instead of
            // 0x4000000 (#6060).
            var mvsh: i32 = 0;
            if (ops.len() > 2) { mvsh = arm64_gas_lsl_amount(ops[2]); }
            var mvimm: i32 = arm64_gas_imm(ops[1]);
            // No explicit `lsl`: the immediate names the whole value, so pick the
            // chunk it lives in (GAS does the same). Without this `mov x9,
            // #0x10000` masked to imm16 = 0 and loaded ZERO.
            if (mvsh == 0) {
                var mvmag: i64 = mvimm as i64;
                if (mvmag < 0) { mvmag = (0 - mvmag) - 1; }
                var hw: i32 = arm64_movwide_hw(mvmag);
                if (hw > 0) {
                    mvsh = hw;
                    var shifted: i64 = mvmag >> hw;
                    if (mvimm < 0) { mvimm = 0 - (((shifted as i32)) + 1); } else { mvimm = shifted as i32; }
                }
            }
            if (mvimm < 0) {
                // A negative immediate needs MOVN, which loads the COMPLEMENT:
                // `mov x0, #-100` is `movn x0, #99`. Encoding it as MOVZ of the
                // truncated low half loaded 65436 (#6060). The line loop's
                // range guard has already refused anything whose complement
                // does not fit in imm16.
                a = Arm64Asm { ...a, code: arm64_movn(a.code, rd, (0 - mvimm) - 1, mvsh, arm64_gas_is_w(ops[0])) };
            } else {
                a = Arm64Asm { ...a, code: arm64_movz(a.code, rd, mvimm, mvsh, arm64_gas_is_w(ops[0])) };
            }
        } else if (arm64_gas_trim(ops[0]) == "sp" || arm64_gas_trim(ops[1]) == "sp") {
            // `mov Xd, sp` / `mov sp, Xn` is the `add Xd, Xn, #0` alias
            // (ORR can't name SP).
            a = Arm64Asm { ...a, code: arm64_addimm(a.code, rd, arm64_gas_reg(ops[1]), 0, arm64_gas_is_w(ops[0])) };
        } else {
            a = Arm64Asm { ...a, code: arm64_movreg(a.code, rd, arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        }
        return a;
    }
    if (mnem == "movk") {
        var sh: i32 = 0;
        if (ops.len() > 2) {
            sh = arm64_gas_lsl_amount(ops[2]);
        }
        a = Arm64Asm { ...a, code: arm64_movk(a.code, arm64_gas_reg(ops[0]), arm64_gas_imm(ops[1]), sh, arm64_gas_is_w(ops[0])) };
        return a;
    }
    // `movn Rd, #imm{, lsl #N}` written out explicitly. arm64_gas_known has
    // always claimed movn was handled, but there was no branch for it: the
    // mnemonic fell through to the end of this function and emitted NOTHING,
    // with nothing recorded on p.unknown either — a silently dropped
    // instruction. The emitter only reaches MOVN through `mov Rd, #-imm`
    // today, which is why it went unnoticed.
    if (mnem == "movn") {
        var nsh: i32 = 0;
        if (ops.len() > 2) {
            nsh = arm64_gas_lsl_amount(ops[2]);
        }
        a = Arm64Asm { ...a, code: arm64_movn(a.code, arm64_gas_reg(ops[0]), arm64_gas_imm(ops[1]), nsh, arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "add" || mnem == "sub") {
        var is_sub: boolean = (mnem == "sub");
        var ad: i32 = arm64_gas_reg(ops[0]);
        var an: i32 = arm64_gas_reg(ops[1]);
        if (ops[2].len() > 0 && ops[2][0] == b'#') {
            if (is_sub) {
                a = Arm64Asm { ...a, code: arm64_subimm(a.code, ad, an, arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
            } else {
                a = Arm64Asm { ...a, code: arm64_addimm(a.code, ad, an, arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
            }
            return a;
        }
        var am: i32 = arm64_gas_reg(ops[2]);
        // A fourth operand is a shift or an extend applied to Xm, and it is
        // part of the VALUE: `add Xd, Xn, Xm, lsl #2` scales an array index by
        // the element size. arm64_gas_addsub_operand_unsupported refuses any
        // other spelling, so nothing reaches here silently unshifted.
        if (ops.len() >= 4) {
            var ext: i32 = arm64_gas_extend_option(ops[3]);
            if (ext >= 0) {
                a = Arm64Asm { ...a, code: arm64_addsub_ext(a.code, is_sub, ad, an, am, ext, arm64_gas_lsl_amount(ops[3])) };
                return a;
            }
            a = Arm64Asm { ...a, code: arm64_addsubreg_shift(a.code, is_sub, ad, an, am,
                arm64_gas_shift_type(ops[3]), arm64_gas_lsl_amount(ops[3]), arm64_gas_is_w(ops[0])) };
            return a;
        }
        if (arm64_gas_trim(ops[1]) == "sp") {
            a = Arm64Asm { ...a, code: arm64_addsub_ext_sp(a.code, is_sub, ad, an, am) };
        } else if (is_sub) {
            a = Arm64Asm { ...a, code: arm64_subreg(a.code, ad, an, am) };
        } else {
            a = Arm64Asm { ...a, code: arm64_addreg(a.code, ad, an, am) };
        }
        return a;
    }
    if (mnem == "cmp") {
        var cn: i32 = arm64_gas_reg(ops[0]);
        if (ops[1].len() > 0 && ops[1][0] == b'#') {
            a = Arm64Asm { ...a, code: arm64_cmpimm(a.code, cn, arm64_gas_imm(ops[1]), arm64_gas_is_w(ops[0])) };
        } else {
            a = Arm64Asm { ...a, code: arm64_cmpreg(a.code, cn, arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        }
        return a;
    }
    if (mnem == "ldr" || mnem == "str") {
        var rt: i32 = arm64_gas_reg(ops[0]);
        // SIMD&FP `ldr/str Dt|St, <mem>` — a separate opcode space (V=1).
        if (arm64_gas_is_d(ops[0]) || arm64_gas_is_sreg(ops[0])) {
            return arm64_gas_emit_ldst_fp(a, mnem == "ldr", rt, ops, arm64_gas_is_sreg(ops[0]));
        }
        if (ops.len() >= 3) {
            // post-index: `ldr Xt, [Xn], #off` (ops[1]="[Xn]", ops[2]="#off")
            var pb: i32 = arm64_gas_mem(ops[1]).base;
            var po: i32 = arm64_gas_imm(ops[2]);
            if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldr_post(a.code, rt, pb, po) }; }
            return Arm64Asm { ...a, code: arm64_str_post(a.code, rt, pb, po) };
        }
        var m: Arm64Mem = arm64_gas_mem(ops[1]);
        // register / extended-register offset `[Xn, Rm{, <ext> {#s}}]`
        // (array indexing; the shape was vetted by arm64_gas_bad_regext).
        if (m.off_reg >= 0) {
            return arm64_gas_emit_ldst_regext(a, mnem == "ldr", arm64_gas_ldst_size(mnem, ops[0]), rt, m);
        }
        if (arm64_gas_has_bang(ops[1])) {
            // pre-index writeback: `[Xn, #off]!`
            if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldr_pre(a.code, rt, m.base, m.off) }; }
            return Arm64Asm { ...a, code: arm64_str_pre(a.code, rt, m.base, m.off) };
        }
        // A negative or misaligned offset can't use the scaled unsigned form
        // (imm12 is unsigned, scaled by the ACCESS SIZE); fall back to the
        // unscaled signed-imm9 ldur/stur, exactly as GAS does. asm_arm64 stores
        // frame locals at `[x29, #-N]`, so this is the common case.
        //
        // The alignment the scaled form requires is the access width, so a
        // 32-bit load/store needs 4, not 8 — `ldr w3, [x4, #4]` is a legal
        // scaled encoding. Testing 8 unconditionally sent every 4-aligned W
        // access down the unscaled path: correct code, but not the encoding GAS
        // picks, which the encoding differential reports as a divergence.
        var align: i32 = 7;
        if (arm64_gas_is_w(ops[0])) { align = 3; }
        if (m.off < 0 || (m.off & align) != 0) {
            if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldur(a.code, rt, m.base, m.off, arm64_gas_is_w(ops[0])) }; }
            return Arm64Asm { ...a, code: arm64_stur(a.code, rt, m.base, m.off, arm64_gas_is_w(ops[0])) };
        }
        if (mnem == "ldr") { return Arm64Asm { ...a, code: arm64_ldr(a.code, rt, m.base, m.off, arm64_gas_is_w(ops[0])) }; }
        return Arm64Asm { ...a, code: arm64_str(a.code, rt, m.base, m.off, arm64_gas_is_w(ops[0])) };
    }
    if (mnem == "neg") {
        a = Arm64Asm { ...a, code: arm64_neg(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) };
        return a;
    }
    if (mnem == "ubfx" || mnem == "sbfx") {
        // The program loop records a bad shape and then still calls through
        // here, so every emitter re-checks its own arity — reading ops[3] of a
        // three-operand `ubfx x0, x1, #4` aborts the process.
        if (ops.len() < 4) { return a; }
        var bfw: boolean = arm64_gas_is_w(ops[0]);
        var bfd: i32 = arm64_gas_reg(ops[0]);
        var bfn: i32 = arm64_gas_reg(ops[1]);
        var bfl: i32 = arm64_gas_imm(ops[2]);
        var bfc: i32 = arm64_gas_imm(ops[3]);
        if (mnem == "sbfx") { return Arm64Asm { ...a, code: arm64_sbfx(a.code, bfd, bfn, bfl, bfc, bfw) }; }
        return Arm64Asm { ...a, code: arm64_ubfx(a.code, bfd, bfn, bfl, bfc, bfw) };
    }
    if (mnem == "sxtw") {
        a = Arm64Asm { ...a, code: arm64_sxtw(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) };
        return a;
    }
    if (mnem == "sxtb" || mnem == "sxth" || mnem == "uxtb" || mnem == "uxth") {
        if (ops.len() < 2) { return a; }
        var xsign: boolean = mnem == "sxtb" || mnem == "sxth";
        var xhalf: boolean = mnem == "sxth" || mnem == "uxth";
        a = Arm64Asm { ...a, code: arm64_extend(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), xsign, xhalf, !arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "mul") {
        // The `madd Rd, Rn, Rm, XZR` alias.
        a = Arm64Asm { ...a, code: arm64_muladd(a.code, 0x9b000000, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), 31, arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "ldur" || mnem == "stur") {
        var um: Arm64Mem = arm64_gas_mem(ops[1]);
        // A d- or s-register is SIMD&FP, a different opcode space (V=1).
        // The explicit ldur/stur spelling used to fall straight through to the
        // GP encoder, so `stur d1, [x2, #-16]` assembled as the integer STUR of
        // x1 — the right shape, the wrong register file, silently (#6075).
        if (arm64_gas_is_d(ops[0]) || arm64_gas_is_sreg(ops[0])) {
            a = Arm64Asm { ...a, code: arm64_ldst_fp_imm9(a.code, mnem == "ldur", arm64_gas_reg(ops[0]), um.base, um.off, 0, arm64_gas_is_sreg(ops[0])) };
            return a;
        }
        if (mnem == "ldur") {
            a = Arm64Asm { ...a, code: arm64_ldur(a.code, arm64_gas_reg(ops[0]), um.base, um.off, arm64_gas_is_w(ops[0])) };
            return a;
        }
        a = Arm64Asm { ...a, code: arm64_stur(a.code, arm64_gas_reg(ops[0]), um.base, um.off, arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "cset") {
        a = Arm64Asm { ...a, code: arm64_cset(a.code, arm64_gas_reg(ops[0]), arm64_gas_cond(ops[1]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "lsl") {
        if (ops[2].len() > 0 && ops[2][0] == b'#') { // immediate form
            a = Arm64Asm { ...a, code: arm64_lsl_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
        } else { // register form → LSLV
            a = Arm64Asm { ...a, code: arm64_lslv(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_w(ops[0])) };
        }
        return a;
    }
    if (mnem == "lsr") {
        if (ops[2].len() > 0 && ops[2][0] == b'#') { // immediate form
            a = Arm64Asm { ...a, code: arm64_lsr_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
        } else { // register form → LSRV
            a = Arm64Asm { ...a, code: arm64_lsrv(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_w(ops[0])) };
        }
        return a;
    }
    if (mnem == "asr") {
        // Same immediate/register split as lsl and lsr above. The emitter only
        // produces the register (ASRV) form today, but the immediate one used to
        // fall through to it and encode a shift by xzr — i.e. by ZERO.
        if (ops[2].len() > 0 && ops[2][0] == b'#') { // immediate form (SBFM)
            a = Arm64Asm { ...a, code: arm64_asr_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2]), arm64_gas_is_w(ops[0])) };
        } else {
            a = Arm64Asm { ...a, code: arm64_asrv(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_w(ops[0])) };
        }
        return a;
    }
    if (mnem == "cmn") {
        if (ops[1].len() > 0 && ops[1][0] == b'#') {
            a = Arm64Asm { ...a, code: arm64_cmn_imm(a.code, arm64_gas_reg(ops[0]), arm64_gas_imm(ops[1]), arm64_gas_is_w(ops[0])) };
            return a;
        }
        // register form: `adds XZR, Xn, Xm`.
        a = Arm64Asm { ...a, code: arm64_rrr(a.code, 0xab000000, 31, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "csel") {
        a = Arm64Asm { ...a, code: arm64_condsel(a.code, 0x9a800000, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_cond(ops[3]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "and" || mnem == "orr" || mnem == "eor") {
        // register forms only here; the #imm forms are handled in the
        // program loop (they need the bitmask-immediate guard). A fourth
        // operand is a shift, vetted by arm64_gas_bad_shift4.
        var lb: i64 = 0x8a000000;
        if (mnem == "orr") { lb = 0xaa000000; }
        if (mnem == "eor") { lb = 0xca000000; }
        var lst: i32 = 0;
        var lamt: i32 = 0;
        if (ops.len() >= 4) {
            lst = arm64_gas_shift_type(ops[3]);
            lamt = arm64_gas_lsl_amount(ops[3]);
        }
        a = Arm64Asm { ...a, code: arm64_logical_shift(a.code, lb, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), lst, lamt, arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "subs") {
        if (ops[2].len() > 0 && ops[2][0] == b'#') {
            a = Arm64Asm { ...a, code: arm64_subsimm(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_imm(ops[2])) };
        } else {
            a = Arm64Asm { ...a, code: arm64_subsreg(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2])) };
        }
        return a;
    }
    // adds Xd, Xn, Xm — the flag-setting add whose carry the adc chain
    // consumes (cmn above is its Rd=XZR alias). Register form only; an
    // immediate operand is refused by the vet, never mis-read as a register.
    if (mnem == "adds") {
        a = Arm64Asm { ...a, code: arm64_rrr(a.code, 0xab000000, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "udiv") {
        a = Arm64Asm { ...a, code: arm64_udiv(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2])) };
        return a;
    }
    if (mnem == "sdiv") {
        a = Arm64Asm { ...a, code: arm64_sdiv(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2])) };
        return a;
    }
    if (mnem == "msub") {
        a = Arm64Asm { ...a, code: arm64_muladd(a.code, 0x9b008000, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_reg(ops[2]), arm64_gas_reg(ops[3]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "rev16") {
        a = Arm64Asm { ...a, code: arm64_rev16(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "clz") {
        a = Arm64Asm { ...a, code: arm64_clz(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    if (mnem == "rbit") {
        a = Arm64Asm { ...a, code: arm64_rbit(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0])) };
        return a;
    }
    var acr: i32 = arm64_across_entry(mnem);
    if (acr >= 0) {
        if (ops.len() != 2) { return a; }
        var ac: i32 = arm64_gas_vreg_arrof(ops[1]);
        return Arm64Asm { ...a, code: arm64_vecacross(a.code, arm64_gas_scalar_reg(ops[0]), arm64_gas_vreg_any(ops[1]),
            arm64_vec_entry_op(acr), arm64_gas_arr_size(ac), arm64_gas_arr_q(ac), arm64_vec_entry_u(acr)) };
    }
    // The packed NEON the __memchr / __ascii_run kernels emit. Operand shapes
    // are vetted in arm64_gas_bad_vec_token before reaching here, so a token
    // that cannot be encoded has already been recorded and refused.
    if (mnem == "ld1" || mnem == "st1" || mnem == "ld1r") {
        if (ops.len() != 2) { return a; }
        var lbase: i64 = 0x0c407000;
        if (mnem == "st1") { lbase = 0x0c007000; }
        if (mnem == "ld1r") { lbase = 0x0d40c000; }
        var lc: i32 = arm64_gas_vlist_one_arr(ops[0]);
        return Arm64Asm { ...a, code: arm64_vecldst1(a.code, lbase, arm64_gas_vlist_one(ops[0]),
            arm64_gas_mem(ops[1]).base, arm64_gas_arr_size(lc), arm64_gas_arr_q(lc)) };
    }
    if (mnem == "dup") {
        if (ops.len() != 2) { return a; }
        var dc: i32 = arm64_gas_vreg_arrof(ops[0]);
        var dsz: i32 = arm64_gas_arr_size(dc);
        if (arm64_gas_lane_size(ops[1]) >= 0) {
            return Arm64Asm { ...a, code: arm64_vecdup(a.code, 0x0e000400, arm64_gas_vreg_any(ops[0]),
                arm64_gas_lane_reg(ops[1]), arm64_vec_imm5(dsz, arm64_gas_lane_index(ops[1])), arm64_gas_arr_q(dc)) };
        }
        return Arm64Asm { ...a, code: arm64_vecdup(a.code, 0x0e000c00, arm64_gas_vreg_any(ops[0]),
            arm64_gas_reg(ops[1]), arm64_gas_pow2(dsz), arm64_gas_arr_q(dc)) };
    }
    if (mnem == "movi") {
        if (ops.len() < 2) { return a; }
        var mc: i32 = arm64_gas_vreg_arrof(ops[0]);
        var msz: i32 = arm64_gas_arr_size(mc);
        var mimm: i32 = arm64_gas_imm(ops[1]);
        // The .2d form is the bytemask: each imm8 bit expands to a byte.
        if (msz == 3) {
            return Arm64Asm { ...a, code: arm64_vecmovi(a.code, arm64_gas_vreg_any(ops[0]), mimm, 14, true, true) };
        }
        var mshift: i32 = 0;
        if (ops.len() == 3) { mshift = arm64_gas_lsl_amount(ops[2]); }
        // cmode selects the BYTE POSITION the imm8 lands in, so the shift is
        // not a field of its own.
        var cmode: i32 = 14;
        if (msz == 1) { cmode = 8 + (mshift / 8) * 2; }
        if (msz == 2) { cmode = (mshift / 8) * 2; }
        return Arm64Asm { ...a, code: arm64_vecmovi(a.code, arm64_gas_vreg_any(ops[0]), mimm, cmode, arm64_gas_arr_q(mc), false) };
    }
    if (mnem == "umov" || mnem == "smov") {
        if (ops.len() != 2) { return a; }
        var usz: i32 = arm64_gas_lane_size(ops[1]);
        var ubase: i64 = 0x0e003c00;
        if (mnem == "smov") { ubase = 0x0e002c00; }
        return Arm64Asm { ...a, code: arm64_vecmovlane(a.code, ubase, arm64_gas_reg(ops[0]),
            arm64_gas_lane_reg(ops[1]), arm64_vec_imm5(usz, arm64_gas_lane_index(ops[1])), !arm64_gas_is_w(ops[0])) };
    }
    if (mnem == "ins") {
        if (ops.len() != 2) { return a; }
        var isz: i32 = arm64_gas_lane_size(ops[0]);
        var iimm5: i32 = arm64_vec_imm5(isz, arm64_gas_lane_index(ops[0]));
        if (arm64_gas_lane_size(ops[1]) >= 0) {
            return Arm64Asm { ...a, code: arm64_vecinselem(a.code, arm64_gas_lane_reg(ops[0]), arm64_gas_lane_reg(ops[1]),
                iimm5, arm64_gas_lane_index(ops[1]) * arm64_gas_pow2(isz)) };
        }
        return Arm64Asm { ...a, code: arm64_vecmovlane(a.code, 0x4e001c00, arm64_gas_lane_reg(ops[0]),
            arm64_gas_reg(ops[1]), iimm5, false) };
    }
    if (mnem == "ldrb" || mnem == "strb" || mnem == "ldrh" || mnem == "strh" || mnem == "ldrsw"
        || mnem == "ldrsb" || mnem == "ldrsh") {
        // post-index `ldrb/strb Wt, [Xn], #imm` (the byte-copy loop): 3
        // operands, ops[1]="[Xn]", ops[2]="#imm".
        if ((mnem == "ldrb" || mnem == "strb") && ops.len() >= 3) {
            var pbb: i32 = arm64_gas_mem(ops[1]).base;
            var poo: i32 = arm64_gas_imm(ops[2]);
            if (mnem == "ldrb") { return Arm64Asm { ...a, code: arm64_ldrb_post(a.code, arm64_gas_reg(ops[0]), pbb, poo) }; }
            return Arm64Asm { ...a, code: arm64_strb_post(a.code, arm64_gas_reg(ops[0]), pbb, poo) };
        }
        var bm: Arm64Mem = arm64_gas_mem(ops[1]);
        // `ldrb/strb/ldrh/strh Wt, [Xn, Rm{, <ext> {#s}}]` — base + index,
        // what every string-copy loop emits. #6047: this fell through to the
        // immediate encoder below with bm.off carrying the digit from the
        // index register's NAME. ldrsw stays immediate-only
        // (arm64_gas_regoff_unsupported refuses its register form).
        if (bm.off_reg >= 0 && mnem != "ldrsw" && mnem != "ldrsb" && mnem != "ldrsh") {
            return arm64_gas_emit_ldst_regext(a, mnem == "ldrb" || mnem == "ldrh", arm64_gas_ldst_size(mnem, ops[0]), arm64_gas_reg(ops[0]), bm);
        }
        // An offset the scaled imm12 cannot carry takes the unscaled imm9
        // form, exactly as gas chooses it.
        var lsz: i32 = arm64_gas_ldst_size(mnem, ops[0]);
        if (!arm64_ldst_scalable(bm.off, lsz)) {
            if (mnem == "ldrsb" || mnem == "ldrsh" || mnem == "ldrsw") {
                return Arm64Asm { ...a, code: arm64_ldst_sun(a.code, lsz, !arm64_gas_is_w(ops[0]), arm64_gas_reg(ops[0]), bm.base, bm.off) };
            }
            return Arm64Asm { ...a, code: arm64_ldst_unscaled(a.code, lsz, mnem == "ldrb" || mnem == "ldrh", arm64_gas_reg(ops[0]), bm.base, bm.off) };
        }
        if (mnem == "ldrsb") { return Arm64Asm { ...a, code: arm64_ldrsb(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off, arm64_gas_is_w(ops[0])) }; }
        if (mnem == "ldrsh") { return Arm64Asm { ...a, code: arm64_ldrsh(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off, arm64_gas_is_w(ops[0])) }; }
        if (mnem == "ldrb") { a = Arm64Asm { ...a, code: arm64_ldrb(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off) }; }
        else if (mnem == "strb") { a = Arm64Asm { ...a, code: arm64_strb(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off) }; }
        else if (mnem == "ldrh") { a = Arm64Asm { ...a, code: arm64_ldrh(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off) }; }
        else if (mnem == "strh") { a = Arm64Asm { ...a, code: arm64_strh(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off) }; }
        else { a = Arm64Asm { ...a, code: arm64_ldrsw(a.code, arm64_gas_reg(ops[0]), bm.base, bm.off) }; }
        return a;
    }
    if (arm64_funary_d_base(mnem) >= 0) {
        a = Arm64Asm { ...a, code: arm64_funary_d(a.code, arm64_funary_d_base(mnem), arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_sreg(ops[0])) };
        return a;
    }
    if (mnem == "fcvtzs" || mnem == "fcvtzu") { // Xd/Wd, Dn (double -> int)
        a = Arm64Asm { ...a, code: arm64_fcvtz_int(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[0]), mnem == "fcvtzu") };
        return a;
    }
    if (mnem == "fcvt") { // Sd, Dn (narrow) or Dd, Sn (widen)
        if (arm64_gas_is_d(ops[0])) {
            a = Arm64Asm { ...a, code: arm64_fcvt_d_s(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) };
        } else {
            a = Arm64Asm { ...a, code: arm64_fcvt_s_d(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) };
        }
        return a;
    }
    if (mnem == "scvtf" || mnem == "ucvtf") { // Dd, Xn/Wn (int -> double)
        a = Arm64Asm { ...a, code: arm64_cvtf(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1]), arm64_gas_is_w(ops[1]), mnem == "ucvtf") };
        return a;
    }
    if (mnem == "fmov") {
        var d0: boolean = arm64_gas_is_d(ops[0]);
        var d1: boolean = arm64_gas_is_d(ops[1]);
        // Single-precision first: `fmov Sd, Wn` / `fmov Wd, Sn` are neither
        // d-registers, so they used to fall into the `Xd, Dn` arm below and
        // encode a 64-bit fp->gpr move instead (#6044).
        if (arm64_gas_is_s(ops[0])) { return Arm64Asm { ...a, code: arm64_fmov_s_from_gpr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) }; }
        if (arm64_gas_is_s(ops[1])) { return Arm64Asm { ...a, code: arm64_fmov_s_to_gpr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) }; }
        if (d0 && d1) { a = Arm64Asm { ...a, code: arm64_fmov_dd(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) }; }
        else if (d0) { a = Arm64Asm { ...a, code: arm64_fmov_from_gpr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) }; } // Dd, Xn
        else { a = Arm64Asm { ...a, code: arm64_fmov_to_gpr(a.code, arm64_gas_reg(ops[0]), arm64_gas_reg(ops[1])) }; } // Xd, Dn
        return a;
    }
    return a; // unknown mnemonic — ignored
}

// ============================================================
// data section + named-symbol (@PAGE/@PAGEOFF) relocation
// ============================================================
//
// Arm64GasProg extends the text assembler (Arm64Asm) with a `__DATA`/
// `__const` blob, a data-symbol table (name -> offset within the blob),
// and a queue of page fixups: adrp `sym@PAGE` and ldr/add `sym@PAGEOFF`
// references whose immediates can only be resolved once the final segment
// addresses are known (macho.fern lays __TEXT and __DATA at separate
// page-aligned vaddrs). arm64_gas_program parses; arm64_gas_link patches.

pub struct Arm64GasProg {
    asm: Arm64Asm,
    data: i32[],
    dlab_names: string[],
    dlab_offs: i32[],
    pf_sites: i32[],    // byte offset of the instruction to patch in .text
    pf_syms: string[],  // target data symbol
    pf_kinds: i32[],    // 0 = adrp@PAGE, 1 = ldr@PAGEOFF, 2 = add@PAGEOFF
    lit_sites: i32[],   // byte offset of a pending `ldr Xd, =N` (LDR-literal) to patch
    lit_vals: i64[],    // the value each pending literal loads
    // Data-word relocations: a `.quad <symbol>` inside a data section, i.e. a
    // data word holding another symbol's ABSOLUTE address. dref_offs[i] is the
    // byte offset of the 8-byte slot within `data`, dref_syms[i] the target.
    // Without these a symbolic `.quad` operand ran through arm64_gas_atoi64 and
    // assembled to ZERO (#6149) — silently, so a static struct constant's shape
    // pointer came out null and every `match` on it fell through.
    dref_offs: i32[],
    dref_syms: string[],
    bss_size: i32,      // total zero-init .bss bytes (ELF memsz beyond filesz; e.g. the heap)
    bss_names: string[],// .bss symbol names
    bss_offs: i32[],    // each .bss symbol's offset within the bss region
    unknown: string[],  // mnemonics the assembler did not recognise
}

function arm64_gas_prog_new(): Arm64GasProg {
    return Arm64GasProg {
        asm: arm64_asm_new(), data: [],
        dlab_names: [], dlab_offs: [],
        pf_sites: [], pf_syms: [], pf_kinds: [],
        lit_sites: [], lit_vals: [],
        dref_offs: [], dref_syms: [],
        bss_size: 0, bss_names: [], bss_offs: [],
        unknown: [],
    };
}

// arm64_gas_known reports whether a mnemonic is handled by the assembler
// (so the program loop can record anything silently dropped). adrp / and
// the @PAGEOFF forms of ldr / add are handled in the program loop itself.
function arm64_gas_known(mnem: string): boolean {
    if (mnem == "mov" || mnem == "movz" || mnem == "movk" || mnem == "movn") { return true; }
    if (mnem == "add" || mnem == "sub" || mnem == "cmp" || mnem == "neg" || mnem == "mul") { return true; }
    if (mnem == "ldr" || mnem == "str" || mnem == "ldur" || mnem == "stur") { return true; }
    if (mnem == "stp" || mnem == "ldp") { return true; }
    if (mnem == "b" || mnem == "bl" || mnem == "blr" || mnem == "ret" || mnem == "svc") { return true; }
    if (mnem == "cbz" || mnem == "cbnz" || mnem == "tbz" || mnem == "tbnz") { return true; }
    if (mnem == "ubfx" || mnem == "cset" || mnem == "adrp" || mnem == "sxtw") { return true; }
    if (mnem == "lsl" || mnem == "lsr" || mnem == "asr" || mnem == "cmn" || mnem == "csel" || mnem == "and") { return true; }
    if (mnem == "orr" || mnem == "eor" || mnem == "subs" || mnem == "adds" || mnem == "udiv" || mnem == "sdiv" || mnem == "msub" || mnem == "rev16" || mnem == "clz") { return true; }
    if (mnem == "rbit") { return true; }  // ctz = rbit+clz; popcount = cnt+addv
    if (mnem == "ld1" || mnem == "st1" || mnem == "ld1r" || mnem == "dup"
        || mnem == "movi" || mnem == "umov" || mnem == "smov" || mnem == "ins") { return true; }
    if (arm64_across_entry(mnem) >= 0) { return true; }  // the across-lanes reductions
    if (arm64_gas_vecgen_handles(mnem)) { return true; }  // the general Advanced SIMD families
    if (mnem == "ldrb" || mnem == "strb" || mnem == "ldrh" || mnem == "strh" || mnem == "ldrsw") { return true; }
    if (mnem == "ldrsb" || mnem == "ldrsh") { return true; }
    if (mnem == "sbfx" || mnem == "sxtb" || mnem == "sxth" || mnem == "uxtb" || mnem == "uxth") { return true; }
    if (mnem == "nop" || mnem == "br") { return true; }
    if (mnem == "mrs" || mnem == "msr" || mnem == "adr") { return true; } // sysreg/operand validity checked in the program loop
    if (mnem == "fcmp" || mnem == "fcmpe" || mnem == "fmov" || mnem == "fcvtzs" || mnem == "fcvtzu" || mnem == "scvtf" || mnem == "ucvtf") { return true; }
    // This list and the dispatch in arm64_gas_emit must agree, and they have
    // drifted in BOTH directions: movn was listed here with no branch to
    // assemble it (silently emitted nothing, #6060), while the unary FP family
    // below had a branch and encoders but was missing from this list — so the
    // program loop refused instructions the assembler could already encode
    // perfectly (#6044). Add to both places, or to neither — the #7886
    // families below go through the same predicates the dispatch uses, so
    // for them the two cannot disagree.
    if (mnem == "fcvt") { return true; }
    if (arm64_funary_d_base(mnem) >= 0 || arm64_fp3_base(mnem) >= 0 || arm64_fp4_base(mnem) >= 0) { return true; }
    if (mnem == "fcsel" || mnem == "fccmp") { return true; }
    if (arm64_gas_is_carry(mnem) || arm64_gas_is_mulwide(mnem) || arm64_gas_is_logical2(mnem)) { return true; }
    if (arm64_gas_is_bitfield(mnem) || mnem == "extr" || mnem == "ror") { return true; }
    if (arm64_gas_is_condsel(mnem) || mnem == "rev" || mnem == "rev32" || mnem == "cls") { return true; }
    if (arm64_gas_is_excl(mnem) || mnem == "dmb" || mnem == "dsb" || mnem == "isb") { return true; }
    if (arm64_gas_is_unscaled2(mnem)) { return true; }
    if (mnem.len() >= 3 && mnem[0] == b'b' && mnem[1] == b'.') { return true; } // b.<cond>
    if (mnem.len() == 3 && mnem[0] == b'b' && arm64_gas_is_cond(slice_unchecked(mnem, 1, 3))) { return true; } // b<cond>
    return false;
}

// arm64_gas_atoi64 is arm64_gas_atoi with a 64-bit accumulator, for the
// operands that are genuinely 64 bits wide: a `.quad` and a literal-pool `ldr
// Xt, =N`. Both used to parse through the i32 version and then widen, so every
// constant that did not fit 32 bits arrived WRAPPED — `ldr x0, =1234567890123`
// loaded 1912767691. That is why the arm64 leg failed i64_max_to_string,
// to_string_round_trip, divmod_inline and the u64 half of int_byte_swap while
// their u32/i32 siblings in the same fixture passed: the emitter routes
// anything wider than a mov-wide immediate through the literal pool, so the
// truncation tracked the CONSTANT's width, not the operation's.
// arm64_gas_numeric_tok reports whether a data-directive operand is a NUMBER
// rather than a symbol reference. Decimal, signed decimal and hex all begin
// with a digit or a sign; every symbol this assembler sees begins with `.`
// (a local label like `.S0` / `.K0`) or with a letter / underscore (a global
// like `__fern_shp_Foo`). Needed because arm64_gas_atoi64 answers 0 for both a
// real zero and an unparseable symbol, so the value alone cannot tell them
// apart — which is exactly how `.quad .S0` came out null.
function arm64_gas_numeric_tok(tok: string): boolean {
    if (tok.len() == 0) { return false; }
    var c: i32 = tok[0] as i32;
    if (c == 45 || c == 43) { return true; }        // '-' / '+'
    return c >= 48 && c <= 57;                       // '0'..'9'
}

function arm64_gas_atoi64(tok: string): i64 {
    var s: string = tok;
    var neg: boolean = false;
    var i: i32 = 0;
    if (s.len() > 0 && s[0] == b'-') {
        neg = true;
        i = 1;
    }
    var v: i64 = 0;
    if (i + 1 < s.len() && s[i] == b'0' && (s[i + 1] == b'x' || s[i + 1] == b'X')) {
        i = i + 2;
        while (i < s.len()) {
            var c: i32 = s[i] as i32;
            var d: i32 = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else { if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else { if (c >= 65 && c <= 70) { d = c - 65 + 10; } } }
            if (d >= 0) { v = v * 16 + (d as i64); }
            i = i + 1;
        }
    } else {
        while (i < s.len()) {
            var c2: i32 = s[i] as i32;
            if (c2 >= 48 && c2 <= 57) { v = v * 10 + ((c2 - 48) as i64); }
            i = i + 1;
        }
    }
    if (neg) {
        return 0 - v;
    }
    return v;
}

// ---- GAS numeric local labels (`1:` … `b.lo 1f`) ----
//
// The arm64 emitter writes every bounds check as
//   cmp x1, x2 / b.lo 1f / b __fern_oob_abort / 1: …
// which is GAS's numeric local label: `1:` may be defined any number of times,
// and `1f` / `1b` name the NEXT / PREVIOUS definition rather than a unique
// symbol. This assembler had no notion of them. `1:` was recorded as a label
// literally named "1", so arm64_asm_label_off returned the FIRST definition in
// the program for all of them; `1f` was looked up verbatim and matched nothing,
// coming back as the -1 "not placed" sentinel, which arm64_asm_resolve then
// patched as if it were an offset. Every array index and string slice therefore
// branched to `-1 - here` — a word inside the ELF header, which is zero, which
// is UDF #0. That is #6045: 129 of 317 corpus fixtures died on SIGILL before
// printing a byte, and the survivors were the programs that never indexed
// anything.
//
// Definitions are renamed `<n>#<k>`, k counting definitions of n so far. `#`
// opens an immediate in GAS, so no real symbol can collide with the mangled
// name. A reference resolves against the same counter — `<n>f` is definition k
// (not yet placed, so it queues a forward fixup), `<n>b` is definition k-1.
function arm64_gas_is_digits(s: string): boolean {
    if (s.len() == 0) {
        return false;
    }
    var i: i32 = 0;
    while (i < s.len()) {
        if (s[i] < b'0' || s[i] > b'9') {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// arm64_gas_numref_dir returns 1 for a forward numeric reference (`1f`), 0 for
// a backward one (`1b`), and -1 when the token is an ordinary symbol.
function arm64_gas_numref_dir(s: string): i32 {
    if (s.len() < 2) {
        return 0 - 1;
    }
    var last: i32 = s[s.len() - 1] as i32;
    if (last != 102 && last != 98) { // 'f' / 'b'
        return 0 - 1;
    }
    if (!arm64_gas_is_digits(slice_unchecked(s, 0, s.len() - 1) + "")) {
        return 0 - 1;
    }
    if (last == 102) {
        return 1;
    }
    return 0;
}

// arm64_gas_dec renders a non-negative i32 in decimal. The module is
// deliberately import-free (the native emitter imports it), so it carries its
// own rather than reaching for core/int.
function arm64_gas_dec(n: i32): string {
    if (n <= 0) {
        return "0";
    }
    var out: string = "";
    var v: i32 = n;
    while (v > 0) {
        var d: i32 = v % 10;
        out = (slice_unchecked("0123456789", d, d + 1) + "") + out;
        v = v / 10;
    }
    return out;
}

// arm64_gas_nl_name is the mangled name of definition `k` of numeric label `n`.
// Both the definition and reference sides go through it, so a padded spelling
// (`01:` against `1f`) cannot split them into two symbols.
function arm64_gas_nl_name(n: i32, k: i32): string {
    return arm64_gas_dec(n) + "#" + arm64_gas_dec(k);
}

// arm64_gas_nl_grow widens the per-number definition counter table so index `n`
// is addressable.
function arm64_gas_nl_grow(c: i32[], n: i32): i32[] {
    var out: i32[] = c;
    while (out.len() <= n) {
        out = out.append(0);
    }
    return out;
}

// arm64_gas_nl_ref maps a branch's label operand through the numeric-local
// rules, leaving an ordinary symbol untouched.
function arm64_gas_nl_ref(cnt: i32[], tok: string): string {
    var s: string = arm64_gas_trim(tok);
    var dir: i32 = arm64_gas_numref_dir(s);
    if (dir < 0) {
        return s;
    }
    var n: i32 = arm64_gas_atoi(slice_unchecked(s, 0, s.len() - 1) + "");
    var k: i32 = 0;
    if (n < cnt.len()) {
        k = cnt[n];
    }
    if (dir == 0) {
        k = k - 1; // `<n>b` — the most recent definition, already placed
        if (k < 0) {
            // `1b` with no `1:` anywhere before it. GAS rejects that outright,
            // and so must this: naming definition 0 would aim the branch at a
            // label defined LATER in the file, which is a silently wrong target
            // of exactly the kind the rest of this change exists to stop. The
            // name below cannot be produced by arm64_gas_nl_name, so it is
            // never placed and the fixup pass refuses it.
            return arm64_gas_dec(n) + "#none";
        }
    }
    return arm64_gas_nl_name(n, k);
}

// arm64_gas_dlabel_off returns the data-blob offset of a data symbol, or
// -1 if it is not defined.
function arm64_gas_dlabel_off(p: Arm64GasProg, name: string): i32 {
    var i: i32 = 0;
    while (i < p.dlab_names.len()) {
        if (p.dlab_names[i] == name) {
            return p.dlab_offs[i];
        }
        i = i + 1;
    }
    return 0 - 1;
}

// arm64_gas_strip_at returns the symbol portion of a `sym@PAGE` /
// `sym@PAGEOFF` operand (everything before the '@'), trimmed.
function arm64_gas_strip_at(tok: string): string {
    var s: string = arm64_gas_trim(tok);
    var at: i32 = arm64_str_indexof(s, "@");
    if (at >= 0) {
        s = slice_unchecked(s, 0, at) + "";
    }
    return arm64_gas_trim(s);
}

// arm64_gas_strip_lo12 returns the symbol portion of a `:lo12:sym` operand
// (the Linux/ELF low-12-bits relocation, the GAS spelling of darwin's
// `sym@PAGEOFF`). Everything after `:lo12:`, trimmed.
function arm64_gas_strip_lo12(tok: string): string {
    var s: string = arm64_gas_trim(tok);
    var at: i32 = arm64_str_indexof(s, ":lo12:");
    if (at >= 0) {
        s = slice_unchecked(s, at + 6, s.len()) + "";
    }
    return arm64_gas_trim(s);
}

// arm64_gas_data_le appends `n` little-endian bytes of `v` to the data blob.
function arm64_gas_data_le(own p: Arm64GasProg, v: i64, n: i32): Arm64GasProg {
    var i: i32 = 0;
    while (i < n) {
        p = Arm64GasProg { ...p, data: p.data.append(((v >> (i * 8)) & 255) as i32) };
        i = i + 1;
    }
    return p;
}

// arm64_gas_escape decodes the escape whose backslash is at `line[i]`,
// returning the byte it stands for and how many characters it spans. Mirrored
// verbatim from x86_gas_escape — the assemblers are deliberately import-free,
// so the two are kept in sync by hand.
//
// The octal form is the one that matters: asmcore.escape_for_ascii writes every
// byte below 0x20, and 0x7f, as `\NNN`, and GAS reads `\` followed by one to
// three octal digits. Recognising only `\0` and passing every other digit
// through as itself left two stray characters in the data blob per control byte
// and shifted the rest of the literal.
function arm64_gas_escape(line: string, i: i32): (i32, i32) {
    var e: i32 = line[i + 1] as i32;
    if (e == 110) { return (10, 2); }        // \n
    if (e == 116) { return (9, 2); }         // \t
    if (e == 114) { return (13, 2); }        // \r
    if (e >= 48 && e <= 55) {                // \N, \NN, \NNN — octal
        var v: i32 = e - 48;
        var n: i32 = 2;
        while (n < 4 && i + n < line.len()) {
            var d: i32 = line[i + n] as i32;
            if (d < 48 || d > 55) { break; }
            v = v * 8 + (d - 48);
            n = n + 1;
        }
        return (v & 255, n);
    }
    return (e, 2);                           // \\ , \" and any other
}

// arm64_gas_data_asciz appends a `.asciz "…"` string + NUL to the data
// blob, decoding the escapes arm64_gas_escape decodes.
function arm64_gas_data_asciz(own p: Arm64GasProg, line: string): Arm64GasProg {
    var q1: i32 = arm64_str_indexof(line, "\"");
    if (q1 < 0) {
        p = Arm64GasProg { ...p, data: p.data.append(0) };
        return p;
    }
    var i: i32 = q1 + 1;
    while (i < line.len() && line[i] != b'"') {
        var c: i32 = line[i] as i32;
        if (c == 92 && i + 1 < line.len()) { // '\'
            var (eb, span) = arm64_gas_escape(line, i);
            c = eb;
            i = i + span - 1;
        }
        p = Arm64GasProg { ...p, data: p.data.append(c & 255) };
        i = i + 1;
    }
    p = Arm64GasProg { ...p, data: p.data.append(0) }; // .asciz NUL terminator
    return p;
}

// arm64_gas_strip_comment removes a `//` line comment, but only where the `//`
// is OUTSIDE a double-quoted string. The old unconditional
// `indexof(raw, "//")` truncated any line whose STRING CONTENT contained `//`,
// and the emitter escapes `"` / `\` / control bytes but not `/` — so
// `.ascii "http://h.com"` became `.ascii "http:`, silently shortening that
// literal and shifting every constant after it in .rodata. #6082: a program
// slicing a URL read whatever landed at the shifted offset, which is why the
// symptom presented as unrelated string constants spliced together. Escapes are
// honoured (`\"` does not close the string) so an escaped quote cannot desync
// the scan. Only arm64 has this class of bug: `//` is a line comment in the
// aarch64 GAS dialect, and this parser is the only assembler on that path.
function arm64_gas_strip_comment(raw: string): string {
    var n: i32 = raw.len();
    var i: i32 = 0;
    var inq: boolean = false;
    while (i < n) {
        var c: u8 = raw[i];
        if (inq) {
            if (c == b'\\') { i = i + 2; }   // skip the escaped byte
            else {
                if (c == b'"') { inq = false; }
                i = i + 1;
            }
        } else if (c == b'"') { inq = true; i = i + 1; }
        else if (c == b'/' && i + 1 < n && raw[i + 1] == b'/') { return slice_unchecked(raw, 0, i) + ""; }
        else { i = i + 1; }
    }
    return raw;
}

// arm64_gas_data_ascii appends a `.ascii "…"` string (NO trailing NUL) to
// the data blob, decoding the same escapes as .asciz. asm_arm64 emits string
// literals as `.ascii` (the length is tracked separately, so no terminator).
// An UNTERMINATED quoted string is refused rather than silently truncated
// (#6082): a short literal shifts every later constant in .rodata, and the
// resulting garbage is unattributable at runtime. The refusal makes any future
// escaping gap a named assembler error instead.
function arm64_gas_data_ascii(own p: Arm64GasProg, line: string): Arm64GasProg {
    var q1: i32 = arm64_str_indexof(line, "\"");
    if (q1 < 0) { return p; }
    var closed: boolean = false;
    var k: i32 = q1 + 1;
    while (k < line.len()) {
        if (line[k] == b'\\') { k = k + 2; }
        else {
            if (line[k] == b'"') { closed = true; }
            k = k + 1;
            if (closed) { break; }
        }
    }
    if (!closed) { return Arm64GasProg { ...p, unknown: p.unknown.append("ascii:unterminated") }; }
    var i: i32 = q1 + 1;
    while (i < line.len() && line[i] != b'"') {
        var c: i32 = line[i] as i32;
        if (c == 92 && i + 1 < line.len()) {
            var (eb, span) = arm64_gas_escape(line, i);
            c = eb;
            i = i + span - 1;
        }
        p = Arm64GasProg { ...p, data: p.data.append(c & 255) };
        i = i + 1;
    }
    return p;
}

// Correctly-rounding decimal -> f64 (SH-004): round-to-nearest, ties to
// even, bit-exact with strtod / the GNU-as path. Mirrored VERBATIM from
// watbin.fern's parse_f64 machinery (pf64_*) — the assemblers are
// deliberately import-free, so the algorithm is kept in sync by hand,
// like the emit layers. See watbin.fern for the algorithm commentary.
// pf64_div2 halves the fraction buffer 0.B (grade-school left-to-right),
// returning the new buffer. May append one digit; drops a leading zero by
// signalling via the first element sentinel — the caller adjusts dp, so
// this returns the raw halved digits INCLUDING a possible leading zero.
function pf64_div2(b: i32[]): i32[] {
    var out: i32[] = [];
    var r: i32 = 0;
    var i: i32 = 0;
    while (i < b.len()) {
        var cur: i32 = r * 10 + b[i];
        out = out.append(cur / 2);
        r = cur % 2;
        i = i + 1;
    }
    if (r != 0) { out = out.append(5); }
    return out;
}

// pf64_mul2 doubles the fraction buffer 0.B (right-to-left with carry).
// A carry out of the front means the value reached [1, 2): the caller
// consumes it as the next binary digit. Returns carry * 1000000 + ... no —
// Fern has no multi-return here; the carry is prepended as a FIRST element
// (0 or 1) and the caller splits it off.
function pf64_mul2(b: i32[]): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < b.len()) { out = out.append(0); i = i + 1; }
    var carry: i32 = 0;
    var j: i32 = b.len() - 1;
    while (j >= 0) {
        var cur: i32 = b[j] * 2 + carry;
        out = out.with(j, cur % 10);
        carry = cur / 10;
        j = j - 1;
    }
    var res: i32[] = [carry];
    var k: i32 = 0;
    while (k < out.len()) { res = res.append(out[k]); k = k + 1; }
    return res;
}

// pf64_sub returns b[from : upto) as a fresh array (slices are a distinct
// type here, so buffer trims copy).
function pf64_sub(b: i32[], from: i32, upto: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = from;
    while (i < upto) { out = out.append(b[i]); i = i + 1; }
    return out;
}

// pf64_all_zero reports whether every digit in b is zero.
function pf64_all_zero(b: i32[]): boolean {
    var i: i32 = 0;
    while (i < b.len()) {
        if (b[i] != 0) { return false; }
        i = i + 1;
    }
    return true;
}

function parse_f64_bits(s: string): i64 {
    var i: i32 = 0;
    var neg: boolean = false;
    if (s.len() > 0 && s[0] == b'-') { neg = true; i = 1; }
    else if (s.len() > 0 && s[0] == b'+') { i = 1; }
    var signbit: i64 = 0;
    if (neg) { var one: i64 = 1; signbit = one << 63; }
    // Collect significant digits and the decimal point position:
    // value = 0.digits × 10^dp. The 800-digit cap is what makes dropping the
    // rest into a sticky bit safe: an exact ULP tie needs at most 751
    // significant decimal digits anywhere in the binary64 range (the smallest,
    // 2^-1075, is 5^1075 / 10^1075), so an input with a non-zero digit past
    // 800 cannot be a tie and rounding up off the round bit is correct.
    var digits: i32[] = [];
    var dp: i32 = 0;
    var sticky: boolean = false;
    var started: boolean = false;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
        var d: i32 = (s[i] as i32) - 48;
        if (started || d != 0) {
            started = true;
            if (digits.len() < 800) { digits = digits.append(d); }
            else { if (d != 0) { sticky = true; } }
            dp = dp + 1;
        }
        i = i + 1;
    }
    if (i < s.len() && s[i] == b'.') {
        i = i + 1;
        while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
            var fd: i32 = (s[i] as i32) - 48;
            if (started || fd != 0) {
                started = true;
                if (digits.len() < 800) { digits = digits.append(fd); }
                else { if (fd != 0) { sticky = true; } }
            } else {
                dp = dp - 1;                // leading fraction zero shifts the point
            }
            i = i + 1;
        }
    }
    if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
        i = i + 1;
        var eneg: boolean = false;
        if (i < s.len() && s[i] == b'-') { eneg = true; i = i + 1; }
        else if (i < s.len() && s[i] == b'+') { i = i + 1; }
        var exp: i32 = 0;
        while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
            if (exp < 100000) { exp = exp * 10 + ((s[i] as i32) - 48); }
            i = i + 1;
        }
        if (eneg) { dp = dp - exp; } else { dp = dp + exp; }
    }
    // Trailing zeros in the significand carry no information; trimming
    // keeps the sticky/remainder tests honest.
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
        digits = pf64_sub(digits, 0, digits.len() - 1);
    }
    if (digits.len() == 0) { return signbit; }          // ±0.0
    // Decimal-magnitude clamps keep the shift loops bounded: |value| is in
    // [10^(dp-1), 10^dp), so dp > 310 overflows every double and dp < -350
    // underflows below half the minimum subnormal.
    if (dp > 310) { var inf: i64 = 2047; return signbit | (inf << 52); }
    if (dp < 0 - 350) { return signbit; }
    // Binary-normalize 0.digits × 10^dp into v × 2^bexp with v in [0.5, 1).
    // While the decimal point is right of the front (value >= 1), halve;
    // while the value is below 0.5, double. dp reaches 0 first, then the
    // leading-digit test finishes the job.
    var bexp: i32 = 0;
    while (dp > 0) {
        var hb: i32[] = pf64_div2(digits);
        if (hb.len() > 0 && hb[0] == 0) {
            digits = pf64_sub(hb, 1, hb.len());
            dp = dp - 1;
        } else {
            digits = hb;
        }
        bexp = bexp + 1;
        while (digits.len() > 0 && digits[digits.len() - 1] == 0) { digits = pf64_sub(digits, 0, digits.len() - 1); }
    }
    while (dp < 0 || (digits.len() > 0 && digits[0] < 5)) {
        var db: i32[] = pf64_mul2(digits);
        if (db[0] != 0) {
            // Carry out of the fraction: 2×0.D >= 1, i.e. C.D' × 10^dp.
            // Renormalize as 0.(C D') × 10^(dp+1) — the carry becomes the
            // new leading digit and the point advances. (Only reachable
            // while dp < 0: at dp == 0 the loop only runs when the lead
            // digit is < 5, so doubling cannot carry.)
            digits = db;
            dp = dp + 1;
        } else {
            digits = pf64_sub(db, 1, db.len());
        }
        bexp = bexp - 1;
        while (digits.len() > 0 && digits[digits.len() - 1] == 0) { digits = pf64_sub(digits, 0, digits.len() - 1); }
        if (digits.len() == 0) { return signbit; }
    }
    // v in [0.5, 1), value = v × 2^bexp = 1.f × 2^(bexp-1): biased exponent
    // E = bexp + 1022. E >= 2047 overflows; E <= 0 goes subnormal with
    // 52 + E mantissa bits; below -1 it is under half the minimum
    // subnormal and rounds to zero.
    var e: i32 = bexp + 1022;
    if (e >= 2047) { var inf2: i64 = 2047; return signbit | (inf2 << 52); }
    var nbits: i32 = 53;
    if (e <= 0) { nbits = 52 + e; }
    if (nbits < 0) { return signbit; }
    var mant: i64 = 0;
    var k2: i32 = 0;
    while (k2 < nbits) {
        var mb: i32[] = pf64_mul2(digits);
        mant = mant * 2 + (mb[0] as i64);
        digits = pf64_sub(mb, 1, mb.len());
        k2 = k2 + 1;
    }
    // Round to nearest, ties to even: round bit is the next binary digit;
    // sticky is any remainder (or parse-time truncation).
    var rb: i32[] = pf64_mul2(digits);
    var roundbit: i32 = rb[0];
    var rest: i32[] = pf64_sub(rb, 1, rb.len());
    var st: boolean = sticky || !pf64_all_zero(rest);
    if (roundbit == 1 && (st || (mant & 1) == 1)) { mant = mant + 1; }
    if (e <= 0) {
        // Subnormal: the E field is 0 and `bits = mant` — and a subnormal
        // that rounded up to 2^52 IS the smallest normal (E=1, f=0), which
        // this encoding produces arithmetically.
        return signbit | mant;
    }
    var full: i64 = 1;
    full = full << 53;
    if (mant == full) {
        // 1.111…1 rounded up to 10.00…0: renormalize.
        mant = mant / 2;
        e = e + 1;
        if (e >= 2047) { var inf3: i64 = 2047; return signbit | (inf3 << 52); }
    }
    var hidden: i64 = 1;
    hidden = hidden << 52;
    return signbit | ((e as i64) << 52) | (mant - hidden);
}

// arm64_parse_f64 parses a `.double` operand into the nearest f64.
function arm64_parse_f64(s: string): f64 {
    return f64_from_bits(parse_f64_bits(s));
}

// arm64_gas_data_align pads the data blob to a 2^n byte boundary.
function arm64_gas_data_align(own p: Arm64GasProg, n: i32): Arm64GasProg {
    var a: i32 = 1;
    var k: i32 = 0;
    while (k < n) { a = a * 2; k = k + 1; }
    while ((p.data.len() % a) != 0) {
        p = Arm64GasProg { ...p, data: p.data.append(0) };
    }
    return p;
}

// arm64_gas_bss_directive reserves zero-init space in the .bss region for a
// directive (no file bytes — it only grows bss_size, the ELF memsz tail).
// `.skip`/`.zero`/`.space N`, `.quad`/`.word`/`.byte` (zero-init slots), and
// `.align` are the forms asm_arm64 emits for the heap globals + the 1 GiB
// `__fern_heap: .skip` reservation.
function arm64_gas_bss_directive(own p: Arm64GasProg, line: string): Arm64GasProg {
    if (arm64_str_starts_with(line, ".skip") || arm64_str_starts_with(line, ".zero") || arm64_str_starts_with(line, ".space")) {
        var sp: i32 = arm64_str_indexof(line, " ");
        if (sp >= 0) {
            return Arm64GasProg { ...p, bss_size: p.bss_size + arm64_gas_atoi(arm64_gas_trim(slice_unchecked(line, sp + 1, line.len()))) };
        }
        return p;
    }
    if (arm64_str_starts_with(line, ".quad")) { return Arm64GasProg { ...p, bss_size: p.bss_size + 8 }; }
    if (arm64_str_starts_with(line, ".4byte") || arm64_str_starts_with(line, ".word")) { return Arm64GasProg { ...p, bss_size: p.bss_size + 4 }; }
    if (arm64_str_starts_with(line, ".byte")) { return Arm64GasProg { ...p, bss_size: p.bss_size + 1 }; }
    if (arm64_str_starts_with(line, ".align") || arm64_str_starts_with(line, ".p2align") || arm64_str_starts_with(line, ".balign")) {
        var sp2: i32 = arm64_str_indexof(line, " ");
        if (sp2 >= 0) {
            var n: i32 = arm64_gas_atoi(arm64_gas_trim(slice_unchecked(line, sp2 + 1, line.len())));
            var a: i32 = 1;
            var k: i32 = 0;
            while (k < n) { a = a * 2; k = k + 1; }
            var bs: i32 = p.bss_size;
            while ((bs % a) != 0) { bs = bs + 1; }
            return Arm64GasProg { ...p, bss_size: bs };
        }
        return p;
    }
    return p;
}

// arm64_gas_bss_off returns a .bss symbol's offset within the bss region, or
// -1 if it is not a bss symbol.
function arm64_gas_bss_off(p: Arm64GasProg, name: string): i32 {
    var i: i32 = 0;
    while (i < p.bss_names.len()) {
        if (p.bss_names[i] == name) { return p.bss_offs[i]; }
        i = i + 1;
    }
    return 0 - 1;
}

// arm64_gas_data_directive handles a `.`-directive inside a data section.
function arm64_gas_data_directive(own p: Arm64GasProg, line: string): Arm64GasProg {
    if (arm64_str_starts_with(line, ".quad")) {
        var qtok: string = arm64_gas_trim(slice_unchecked(line, 5, line.len()));
        // A SYMBOLIC operand (`.quad .S0`) is another symbol's absolute address,
        // not a number: reserve the 8-byte slot and queue a relocation for
        // arm64_gas_link, which is the only point the segment addresses exist.
        // arm64_gas_atoi64 would have returned 0 here, indistinguishable from a
        // real `.quad 0`.
        if (!arm64_gas_numeric_tok(qtok)) {
            p = Arm64GasProg { ...p,
                dref_offs: p.dref_offs.append(p.data.len()),
                dref_syms: p.dref_syms.append(qtok) };
            return arm64_gas_data_le(p, 0, 8);
        }
        return arm64_gas_data_le(p, arm64_gas_atoi64(qtok), 8);
    }
    if (arm64_str_starts_with(line, ".4byte") || arm64_str_starts_with(line, ".word")) {
        var off: i32 = 6;
        if (arm64_str_starts_with(line, ".word")) { off = 5; }
        return arm64_gas_data_le(p, arm64_gas_atoi64(arm64_gas_trim(slice_unchecked(line, off, line.len()))), 4);
    }
    if (arm64_str_starts_with(line, ".long")) {
        // `.long a, b, …`: each comma-separated value as 4 little-endian bytes.
        // The IR emitters lay an f64 constant down as two `.long` halves (exact
        // bits, assembler-independent — see const_f64). Ignoring it (the
        // pre-#5434 behaviour) silently dropped the 8 rodata bytes.
        var lrest: string = arm64_gas_trim(slice_unchecked(line, 5, line.len()));
        var ltok: string = "";
        var lci: i32 = 0;
        var lp: Arm64GasProg = p;
        while (lci < lrest.len()) {
            if (lrest[lci] == b',') {
                lp = arm64_gas_data_le(lp, arm64_gas_atoi64(arm64_gas_trim(ltok)), 4);
                ltok = "";
            } else {
                ltok = ltok + slice_unchecked(lrest, lci, lci + 1);
            }
            lci = lci + 1;
        }
        if (arm64_gas_trim(ltok).len() > 0) {
            lp = arm64_gas_data_le(lp, arm64_gas_atoi64(arm64_gas_trim(ltok)), 4);
        }
        return lp;
    }
    if (arm64_str_starts_with(line, ".byte")) {
        return arm64_gas_data_le(p, arm64_gas_atoi64(arm64_gas_trim(slice_unchecked(line, 5, line.len()))), 1);
    }
    if (arm64_str_starts_with(line, ".asciz") || arm64_str_starts_with(line, ".string")) {
        return arm64_gas_data_asciz(p, line);
    }
    if (arm64_str_starts_with(line, ".ascii")) {
        return arm64_gas_data_ascii(p, line);
    }
    if (arm64_str_starts_with(line, ".double")) {
        return arm64_gas_data_le(p, f64_bits(arm64_parse_f64(arm64_gas_trim(slice_unchecked(line, 7, line.len())))), 8);
    }
    if (arm64_str_starts_with(line, ".align") || arm64_str_starts_with(line, ".p2align") || arm64_str_starts_with(line, ".balign")) {
        var sp: i32 = arm64_str_indexof(line, " ");
        if (sp >= 0) {
            return arm64_gas_data_align(p, arm64_gas_atoi(arm64_gas_trim(slice_unchecked(line, sp + 1, line.len()))));
        }
    }
    return p; // other directives ignored
}

// arm64_lit_le64 appends the 8 little-endian bytes of a 64-bit literal-pool
// value to a code buffer (low word then high word).
function arm64_lit_le64(buf: i32[], v: i64): i32[] {
    buf = arm64_le32(buf, v);
    buf = arm64_le32(buf, v >> 32);
    return buf;
}

// arm64_lit_reach is the LDR-literal forward reach in bytes: imm19 is a
// signed word count, so +262143 words.
function arm64_lit_reach(): i32 { return 1048572; }

// arm64_lit_pool_far returns the byte distance of the FARTHEST pending
// `ldr Xd, =N` site from a pool about to be placed at `code_len`, or 0 when
// nothing is pending. The pool always follows its sites, so only the forward
// distance matters. arm64_patch_ldr_lit masks imm19 to 19 bits, so a distance
// past arm64_lit_reach() would wrap into a load from the wrong address instead
// of failing — a silent miscompile, which is what let a self-host `-target
// arm64` build of the checker driver produce a "successful" binary that then
// exhausted the arena on its first input. Callers record an over-range flush
// on p.unknown so the driver refuses the output, matching the REFUSE-rather-
// than-mis-encode contract of the register and immediate decoders.
function arm64_lit_pool_far(p: Arm64GasProg, code_len: i32): i32 {
    var worst: i32 = 0;
    var i: i32 = 0;
    while (i < p.lit_sites.len()) {
        var d: i32 = code_len - p.lit_sites[i];
        if (d > worst) { worst = d; }
        i = i + 1;
    }
    return worst;
}

// arm64_gas_ltorg flushes the pending `ldr Xd, =N` literal pool into .text
// at the current offset: 8-align, then for each pending load patch its
// LDR-literal imm19 to the (PC-relative) pool slot and append the value's 8
// bytes. asm_arm64_ir emits a `.ltorg` after every function so the pool stays
// within the ±1 MiB LDR-literal reach; the pool sits after the function's
// `ret`, so it is never executed.
// It takes the assembler state as an argument and hands it back rather than
// reading p.asm, so the buffer is uniquely owned here too — see
// arm64_gas_program's note on why an alias makes every append copy. It
// consumes that state (`own`) so the .text buffer can be lifted out of the
// struct for the patch loop; clearing the pending lists is the caller's job.
function arm64_gas_ltorg(p: Arm64GasProg, own aw: Arm64Asm): Arm64Asm {
    if (p.lit_sites.len() == 0) { return aw; }
    var code: i32[] = aw.code;
    aw = Arm64Asm { ...aw, code: [] };
    while ((code.len() & 7) != 0) {
        code = code.append(0);
    }
    var i: i32 = 0;
    while (i < p.lit_sites.len()) {
        var site: i32 = p.lit_sites[i];
        var imm19: i32 = (code.len() - site) / 4;
        code = arm64_patch_ldr_lit(code, site, imm19);
        code = arm64_lit_le64(code, p.lit_vals[i]);
        i = i + 1;
    }
    return Arm64Asm { ...aw, code: code };
}

// ---- the assemble loop ----

// arm64_gas_program parses a GAS-text program (one statement per line)
// into an Arm64GasProg: .text code (forward branches resolved), a data
// blob, a data-symbol table, and a queue of @PAGE/@PAGEOFF fixups (left
// for arm64_gas_link). The first .text label must sit at offset 0, since
// macho.fern enters at the first text byte.
pub function arm64_gas_program(src: string): Arm64GasProg {
    var p: Arm64GasProg = arm64_gas_prog_new();
    // The .text buffer is threaded through the loop as `a`, a UNIQUELY-owned
    // local, and only folded back into p on return. Reading it out of p.asm per
    // instruction — `arm64_gas_emit(p.asm, …)`, or the `var xas: Arm64Asm =
    // p.asm; …; p = { ...p, asm: xas }` shape the special cases used — left the
    // code array reachable through BOTH p and the local, so every append inside
    // saw a shared array and copied the whole buffer instead of extending it:
    // one full copy per emitted instruction, i.e. O(code_len^2) arena traffic.
    // That is #6011 — the self-host arm64 CLI needed 8.5 GB (arena exhausted,
    // exit 137) to compile an empty `main` importing std/array, where x86-64
    // did it in 1.5 GB. The emitters were never at fault; only this assembler
    // is on the arm64 CLI path, and x86-64's stops at `.s` text. Held uniquely,
    // Perceus reuse extends the buffer in place and the cost is linear.
    var a: Arm64Asm = p.asm;
    p = Arm64GasProg { ...p, asm: arm64_asm_new() };
    var section: i32 = 0; // 0 = .text, 1 = data (__const / __data)
    var nl_cnt: i32[] = []; // definitions seen per numeric local label
    var lines: string[] = arm64_str_split(src, "\n");
    var li: i32 = 0;
    while (li < lines.len()) {
        var raw: string = lines[li];
        li = li + 1;
        raw = arm64_gas_strip_comment(raw);
        var line: string = arm64_gas_trim(raw);
        if (line.len() == 0) {
            continue;
        }
        // label prefix `name:`
        var colon: i32 = arm64_str_indexof(line, ":");
        if (colon > 0) {
            var before: str = slice_unchecked(line, 0, colon);
            if (arm64_str_indexof(before, " ") < 0 && arm64_str_indexof(before, ",") < 0) {
                if (section == 1) {
                    p = Arm64GasProg { ...p, dlab_names: p.dlab_names.append(before) };
                    p = Arm64GasProg { ...p, dlab_offs: p.dlab_offs.append(p.data.len()) };
                } else if (section == 2) {
                    p = Arm64GasProg { ...p, bss_names: p.bss_names.append(before) };
                    p = Arm64GasProg { ...p, bss_offs: p.bss_offs.append(p.bss_size) };
                } else if (arm64_gas_is_digits(before + "")) {
                    var nv: i32 = arm64_gas_atoi(before + "");
                    nl_cnt = arm64_gas_nl_grow(nl_cnt, nv);
                    a = arm64_asm_label(a, arm64_gas_nl_name(nv, nl_cnt[nv]));
                    nl_cnt = nl_cnt.with(nv, nl_cnt[nv] + 1);
                } else {
                    a = arm64_asm_label(a, before);
                }
                line = arm64_gas_trim(slice_unchecked(line, colon + 1, line.len()));
                if (line.len() == 0) {
                    continue;
                }
            }
        }
        // directives
        if (line[0] == b'.') {
            if (line == ".ltorg") {
                if (arm64_lit_pool_far(p, a.code.len()) > arm64_lit_reach()) {
                    p = Arm64GasProg { ...p, unknown: p.unknown.append("ltorg:range") };
                }
                a = arm64_gas_ltorg(p, a);
                p = Arm64GasProg { ...p, lit_sites: [], lit_vals: [] };
            } else if (line == ".text") {
                section = 0;
            } else if (line == ".bss") {
                section = 2;
            } else if (arm64_str_starts_with(line, ".section")) {
                if (arm64_str_contains(line, "__bss") || arm64_str_contains(line, ".bss")) {
                    section = 2;
                } else if (arm64_str_contains(line, "__const") || arm64_str_contains(line, "__DATA") || arm64_str_contains(line, ".data") || arm64_str_contains(line, ".rodata")) {
                    section = 1;
                } else {
                    section = 0;
                }
            } else if (arm64_str_starts_with(line, ".data")) {
                section = 1;
            } else if (section == 2) {
                p = arm64_gas_bss_directive(p, line);
            } else if (section == 1) {
                p = arm64_gas_data_directive(p, line);
            }
            continue;
        }
        // mnemonic + operands
        var sp: i32 = arm64_str_indexof(line, " ");
        var mnem: string = line;
        var rest: string = "";
        if (sp >= 0) {
            mnem = slice_unchecked(line, 0, sp) + "";
            rest = arm64_gas_trim(slice_unchecked(line, sp + 1, line.len()));
        }
        // A register-shaped operand that fails the strict decode (SH-006 —
        // `x1a`, `x31`, `d40`) is recorded like an unknown mnemonic: the
        // encoders below would otherwise fold the -1 sentinel into garbage
        // bits, and the p.unknown gate refuses the output instead.
        var badreg: string = arm64_gas_bad_reg_token(rest);
        if (badreg.len() > 0) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":" + badreg) };
        }
        // Same discipline for cnt/addv's SIMD operands: the byte-lane encoders
        // cannot express a wider arrangement, and folding a -1 into the
        // register field would emit a plausible instruction on the wrong
        // register.
        var badvec: string = arm64_gas_bad_vec_token(mnem, rest);
        if (badvec.len() > 0) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":" + badvec) };
        }
        // Same discipline for the #7886 families (carry chain, negated
        // logicals, bitfield inserts, conditional compares/selects, pairs,
        // extended-register addressing, exclusives, barriers, the scalar-FP
        // additions): a shape their encoders cannot express is recorded,
        // never folded into a wrong field.
        var badext: string = arm64_gas_bad_ext_token(mnem, rest);
        if (badext.len() > 0) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":" + badext) };
        }
        // Same discipline for the condition operand of the select / conditional
        // compare / cset families.
        var badcond: string = arm64_gas_bad_cond_token(mnem, rest);
        if (badcond.len() > 0) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":" + badcond) };
        }
        // Same discipline for a register in the OFFSET position of a form whose
        // only encoder takes an immediate: refuse the line instead of silently
        // dropping the index. #6047 was exactly this hole, on ldrb/strb, which
        // now encode the register form properly.
        if (arm64_gas_regoff_unsupported(mnem, rest)) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":regoff") };
        }
        // Same discipline for a `!` pre-index writeback on a form that has only
        // the unsigned-offset encoder: dropping the writeback leaves the base
        // register un-updated, and any paired release then moves it the wrong
        // way (#6083). Refuse the line.
        if (arm64_gas_writeback_unsupported(mnem, rest)) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":writeback") };
        }
        // Same discipline for an add/sub shift or extend operand this
        // assembler has no encoder for: dropping it emits a plausible
        // instruction that computes the wrong address (#6849).
        if (arm64_gas_addsub_operand_unsupported(mnem, rest)) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":shift") };
        }
        // A mov-wide immediate that does not fit imm16 (or whose complement does
        // not, for the MOVN path) would be silently TRUNCATED into a different
        // constant. Refuse it: the emitter builds anything wider through the
        // literal pool (`ldr Xt, =N`), so this only ever fires on a form the
        // assembler genuinely cannot express.
        if (arm64_gas_movwide_out_of_range(mnem, rest)) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem + ":imm16") };
        }
        // `ldr Xd, =N` (literal-pool load): emit an LDR-literal placeholder
        // and queue the 64-bit value; `.ltorg` (or end of program) flushes
        // the pool into .text and patches the imm19.
        if (mnem == "ldr" && arm64_str_indexof(rest, "=") >= 0) {
            var rops: string[] = arm64_gas_operands(rest);
            var litok: string = arm64_gas_trim(rops[1]);
            var nval: i64 = arm64_gas_atoi64(arm64_gas_trim(slice_unchecked(litok, 1, litok.len())));
            a = Arm64Asm { ...a, code: arm64_ldr_lit(a.code, arm64_gas_reg(rops[0]), 0) };
            p = Arm64GasProg { ...p, lit_sites: p.lit_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, lit_vals: p.lit_vals.append(nval) };
            continue;
        }
        // @PAGE / @PAGEOFF symbol references queue a fixup; everything else
        // assembles directly into .text.
        if (mnem == "adrp") {
            var aops: string[] = arm64_gas_operands(rest);
            a = Arm64Asm { ...a, code: arm64_adrp(a.code, arm64_gas_reg(aops[0]), 0) };
            p = Arm64GasProg { ...p, pf_sites: p.pf_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, pf_syms: p.pf_syms.append(arm64_gas_strip_at(aops[1])) };
            p = Arm64GasProg { ...p, pf_kinds: p.pf_kinds.append(0) };
            continue;
        }
        // `adr Xd, sym` — PC-relative like adrp but byte-granular (±1 MB),
        // so it is a kind-3 fixup with no companion :lo12: add. There is no
        // W form of the instruction.
        if (mnem == "adr") {
            var drops: string[] = arm64_gas_operands(rest);
            if (drops.len() != 2 || arm64_gas_is_w(drops[0])) {
                p = Arm64GasProg { ...p, unknown: p.unknown.append("adr:operands") };
                continue;
            }
            a = Arm64Asm { ...a, code: arm64_adr(a.code, arm64_gas_reg(drops[0]), 0) };
            p = Arm64GasProg { ...p, pf_sites: p.pf_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, pf_syms: p.pf_syms.append(arm64_gas_trim(drops[1])) };
            p = Arm64GasProg { ...p, pf_kinds: p.pf_kinds.append(3) };
            continue;
        }
        if (mnem == "ldr" && arm64_str_indexof(rest, "@PAGEOFF") >= 0) {
            var lops: string[] = arm64_gas_operands(rest);
            var lm: Arm64Mem = arm64_gas_mem(lops[1]); // base reg; off symbolic
            // symbol is the bracket's second operand, before '@'
            var linner: string = lops[1];
            var lb: i32 = arm64_str_indexof(linner, "[");
            var rb: i32 = arm64_str_indexof(linner, "]");
            var lparts: string[] = arm64_gas_operands(slice_unchecked(linner, lb + 1, rb));
            a = Arm64Asm { ...a, code: arm64_ldr(a.code, arm64_gas_reg(lops[0]), lm.base, 0, arm64_gas_is_w(lops[0])) };
            p = Arm64GasProg { ...p, pf_sites: p.pf_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, pf_syms: p.pf_syms.append(arm64_gas_strip_at(lparts[1])) };
            p = Arm64GasProg { ...p, pf_kinds: p.pf_kinds.append(1) };
            continue;
        }
        if (mnem == "add" && arm64_str_indexof(rest, "@PAGEOFF") >= 0) {
            var dops: string[] = arm64_gas_operands(rest);
            a = Arm64Asm { ...a, code: arm64_addimm(a.code, arm64_gas_reg(dops[0]), arm64_gas_reg(dops[1]), 0, false) };
            p = Arm64GasProg { ...p, pf_sites: p.pf_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, pf_syms: p.pf_syms.append(arm64_gas_strip_at(dops[2])) };
            p = Arm64GasProg { ...p, pf_kinds: p.pf_kinds.append(2) };
            continue;
        }
        // Linux/ELF low-12-bits add: `add Xd, Xn, :lo12:sym` — the GAS
        // spelling of darwin's `add Xd, Xn, sym@PAGEOFF` (same kind-2 fixup;
        // arm64_gas_link resolves both to target & 0xfff). The matching
        // `adrp Xd, sym` is handled by the adrp branch above (bare symbol).
        if (mnem == "add" && arm64_str_indexof(rest, ":lo12:") >= 0) {
            var lops: string[] = arm64_gas_operands(rest);
            a = Arm64Asm { ...a, code: arm64_addimm(a.code, arm64_gas_reg(lops[0]), arm64_gas_reg(lops[1]), 0, false) };
            p = Arm64GasProg { ...p, pf_sites: p.pf_sites.append(a.code.len() - 4) };
            p = Arm64GasProg { ...p, pf_syms: p.pf_syms.append(arm64_gas_strip_lo12(lops[2])) };
            p = Arm64GasProg { ...p, pf_kinds: p.pf_kinds.append(2) };
            continue;
        }
        // `and Xd, Xn, #imm` (logical immediate) needs a verified bitmask
        // encoding; an unsupported immediate is recorded (never silently
        // mis-encoded). Register-form `and` — whose shifted spelling also
        // carries a '#', in the shift amount — falls through to emit.
        if (mnem == "and" && arm64_gas_third_is_imm(rest)) {
            var nops: string[] = arm64_gas_operands(rest);
            var nimm: i32 = arm64_gas_imm(nops[2]);
            var nw: boolean = arm64_gas_is_w(nops[0]);
            if (arm64_and_imm_ok(nimm) && (!nw || arm64_logical_imm_w_ok(nimm))) {
                a = Arm64Asm { ...a, code: arm64_and_imm(a.code, arm64_gas_reg(nops[0]), arm64_gas_reg(nops[1]), nimm, nw) };
            } else {
                p = Arm64GasProg { ...p, unknown: p.unknown.append("and#") };
            }
            continue;
        }
        // `orr Xd, Xn, #imm` (logical immediate) — same verified-bitmask path
        // as `and #imm`. Without this branch the register dispatch read the
        // immediate token as a register, got -1, masked it to XZR, and
        // silently encoded `orr Xd, Xn, xzr` — a no-op wearing the right
        // mnemonic. Register-form `orr` falls through to emit.
        if (mnem == "orr" && arm64_gas_third_is_imm(rest)) {
            var oops: string[] = arm64_gas_operands(rest);
            var oimm: i32 = arm64_gas_imm(oops[2]);
            var ow: boolean = arm64_gas_is_w(oops[0]);
            if (arm64_orr_imm_ok(oimm) && (!ow || arm64_logical_imm_w_ok(oimm))) {
                a = Arm64Asm { ...a, code: arm64_orr_imm(a.code, arm64_gas_reg(oops[0]), arm64_gas_reg(oops[1]), oimm, ow) };
            } else {
                p = Arm64GasProg { ...p, unknown: p.unknown.append("orr#") };
            }
            continue;
        }
        // `eor Xd, Xn, #imm` (logical immediate) — same verified-bitmask path
        // as `and #imm`. Register-form `eor` falls through to emit.
        if (mnem == "eor" && arm64_gas_third_is_imm(rest)) {
            var eops: string[] = arm64_gas_operands(rest);
            var eimm: i32 = arm64_gas_imm(eops[2]);
            var ew: boolean = arm64_gas_is_w(eops[0]);
            if (arm64_eor_imm_ok(eimm) && (!ew || arm64_logical_imm_w_ok(eimm))) {
                a = Arm64Asm { ...a, code: arm64_eor_imm(a.code, arm64_gas_reg(eops[0]), arm64_gas_reg(eops[1]), eimm, ew) };
            } else {
                p = Arm64GasProg { ...p, unknown: p.unknown.append("eor#") };
            }
            continue;
        }
        // `mrs Xt, <sysreg>` / `msr <sysreg>, Xt` — only the listed system
        // registers are encoded, msr only the EL0-writable subset, and the
        // data register must be an X register; anything else is recorded
        // (never mis-encoded — a read-only msr would trap at runtime).
        if (mnem == "mrs") {
            var sops: string[] = arm64_gas_operands(rest);
            if (sops.len() != 2 || arm64_gas_is_w(sops[0]) || arm64_mrs_base(arm64_gas_trim(sops[1])) < 0) {
                p = Arm64GasProg { ...p, unknown: p.unknown.append("mrs:" + rest) };
                continue;
            }
            a = Arm64Asm { ...a, code: arm64_mrs(a.code, arm64_gas_reg(sops[0]), arm64_gas_trim(sops[1])) };
            continue;
        }
        if (mnem == "msr") {
            var wops: string[] = arm64_gas_operands(rest);
            if (wops.len() != 2 || arm64_gas_is_w(wops[1]) || arm64_gas_reg(wops[1]) < 0
                || arm64_msr_base(arm64_gas_trim(wops[0])) < 0) {
                p = Arm64GasProg { ...p, unknown: p.unknown.append("msr:" + rest) };
                continue;
            }
            a = Arm64Asm { ...a, code: arm64_msr(a.code, arm64_gas_reg(wops[1]), arm64_gas_trim(wops[0])) };
            continue;
        }
        if (!arm64_gas_known(mnem)) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append(mnem) };
        }
        // Label-relative branches are dispatched HERE rather than inside
        // arm64_gas_emit so the transfer of `a` is a self-reassign of a LOCAL.
        // Threaded through gas_emit instead, the transfer sits early in a
        // 60-branch if-chain with `a` mentioned in every later branch, so it is
        // not the parameter's last use and the compiler has to RETAIN across
        // it — which leaves the .text buffer shared and sends every
        // backward-branch patch down the copy path (the last of #6011's
        // quadratic loops). Here the callee is the sole owner and patches in
        // place.
        if (mnem == "b" || mnem == "bl" || mnem == "cbz" || mnem == "cbnz"
            || mnem == "tbz" || mnem == "tbnz" || arm64_gas_is_bcond(mnem)) {
            var bops: string[] = arm64_gas_operands(rest);
            if (mnem == "b") {
                a = arm64_asm_b(a, arm64_gas_nl_ref(nl_cnt, bops[0]));
            } else if (mnem == "bl") {
                a = arm64_asm_bl(a, arm64_gas_nl_ref(nl_cnt, bops[0]));
            } else if (mnem == "cbz") {
                a = arm64_asm_cbz(a, arm64_gas_reg(bops[0]), arm64_gas_nl_ref(nl_cnt, bops[1]), arm64_gas_is_w(bops[0]));
            } else if (mnem == "cbnz") {
                a = arm64_asm_cbnz(a, arm64_gas_reg(bops[0]), arm64_gas_nl_ref(nl_cnt, bops[1]), arm64_gas_is_w(bops[0]));
            } else if (mnem == "tbz") {
                a = arm64_asm_tbz(a, arm64_gas_reg(bops[0]), arm64_gas_imm(bops[1]), arm64_gas_nl_ref(nl_cnt, bops[2]));
            } else if (mnem == "tbnz") {
                a = arm64_asm_tbnz(a, arm64_gas_reg(bops[0]), arm64_gas_imm(bops[1]), arm64_gas_nl_ref(nl_cnt, bops[2]));
            } else {
                a = arm64_asm_bcond(a, arm64_gas_cond(arm64_gas_bcond_suffix(mnem)), arm64_gas_nl_ref(nl_cnt, bops[0]));
            }
            continue;
        }
        a = arm64_gas_emit(a, mnem, rest);
    }
    if (arm64_lit_pool_far(p, a.code.len()) > arm64_lit_reach()) {
        p = Arm64GasProg { ...p, unknown: p.unknown.append("ltorg:range") };
    }
    a = arm64_gas_ltorg(p, a); // flush any literals after the final `.ltorg`
    p = Arm64GasProg { ...p, lit_sites: [], lit_vals: [] };
    // 8-align the data blob so the .bss region that follows it in memory
    // (data_vaddr + data.len()) starts 8-aligned for the heap globals.
    while ((p.data.len() & 7) != 0) {
        p = Arm64GasProg { ...p, data: p.data.append(0) };
    }
    a = arm64_asm_resolve(a);
    var ui: i32 = 0;
    while (ui < a.unres.len()) {
        p = Arm64GasProg { ...p, unknown: p.unknown.append("label:" + a.unres[ui]) };
        ui = ui + 1;
    }
    var oi: i32 = 0;
    while (oi < a.oor.len()) {
        p = Arm64GasProg { ...p, unknown: p.unknown.append("branch out of range: " + a.oor[oi]) };
        oi = oi + 1;
    }
    return Arm64GasProg { ...p, asm: a };
}

// Arm64SymAddr / arm64_gas_sym_addr resolve a symbol to its final address at
// link time. A symbol lives in one of THREE places: the rodata/data blob
// (dlab), the zero-init .bss region laid out immediately after the data in
// memory (data_vaddr + data.len() + bss_off), or — for a function VALUE, which
// the emitter takes as `adrp x0, fn` + `add x0, x0, :lo12:fn` — .text.
//
// ONE lookup, shared by the instruction fixups and the data-word relocations,
// because getting it wrong is expensive and silent: the .text arm was once
// missing and the .bss arm did not check it had found anything, so every
// function value resolved to a data address one byte inside the wrong segment
// and calling one was a SEGV on `blr` (the second half of #6045). `found` is
// returned rather than inferred from the address so a caller cannot repeat that
// mistake by testing a sentinel.
struct Arm64SymAddr { found: boolean, addr: i64 }

// `data_len` is passed rather than read off `p`: the data-word loop lifts the
// blob out of the struct to patch it in place, so `p.data.len()` is 0 there and
// the .bss base would silently come out wrong.
function arm64_gas_sym_addr(p: Arm64GasProg, aw: Arm64Asm, name: string, text_vaddr: i64, data_vaddr: i64, data_len: i32): Arm64SymAddr {
    var doff: i32 = arm64_gas_dlabel_off(p, name);
    if (doff >= 0) { return Arm64SymAddr { found: true, addr: data_vaddr + (doff as i64) }; }
    var boff: i32 = arm64_gas_bss_off(p, name);
    if (boff >= 0) { return Arm64SymAddr { found: true, addr: data_vaddr + (data_len as i64) + (boff as i64) }; }
    var toff: i32 = arm64_asm_label_off(aw, name);
    if (toff >= 0) { return Arm64SymAddr { found: true, addr: text_vaddr + (toff as i64) }; }
    return Arm64SymAddr { found: false, addr: 0 };
}

// arm64_gas_rebase_offs returns the offsets, within the data blob, of every
// 8-byte slot arm64_gas_link filled with an ABSOLUTE address (`.quad <symbol>`
// — today only a static aggregate constant's shape pointer, #6149). A Mach-O
// main executable on Apple Silicon must be PIE, so dyld slides the image and
// every one of those needs the slide added: macho_executable turns these into
// LC_DYLD_INFO_ONLY rebase opcodes. Everything else the arm64 emitter produces
// is PC-relative (adrp/@PAGEOFF, b/bl), which is why this is the whole list.
//
// Miss a slot here and the image loads fine, then reads a pointer that is stale
// by the slide — which presents as a codegen bug, not a container one. #6259
// was exactly that: every `match` on a static constant fell through both arms
// and the program returned 0.
pub function arm64_gas_rebase_offs(p: Arm64GasProg): i32[] {
    return p.dref_offs;
}

// arm64_gas_link resolves the queued @PAGE/@PAGEOFF fixups now that the
// final __TEXT / __DATA segment addresses are known (the caller supplies
// them from macho.fern's macho_text_vaddr / macho_data_vaddr). After this,
// p.asm.code + p.data are the final sections.
// It consumes the prog (`own`) so the .text buffer can be lifted clear of both
// enclosing structs before the loop: patched in place inside them, each fixup
// cloned the whole .text.
pub function arm64_gas_link(own p: Arm64GasProg, text_vaddr: i64, data_vaddr: i64): Arm64GasProg {
    var aw: Arm64Asm = p.asm;
    p = Arm64GasProg { ...p, asm: arm64_asm_new() };
    var code: i32[] = aw.code;
    aw = Arm64Asm { ...aw, code: [] };
    var i: i32 = 0;
    while (i < p.pf_sites.len()) {
        var site: i32 = p.pf_sites[i];
        // A symbol lives in one of THREE places: the rodata/data blob (dlab),
        // the zero-init .bss region laid out immediately after the data in
        // memory (data_vaddr + data.len() + bss_off), or — for a function
        // VALUE, which the emitter takes as `adrp x0, fn` + `add x0, x0,
        // :lo12:fn` — .text.
        //
        // The .text arm was missing, and the .bss arm did not check that it had
        // actually found anything: a text symbol fell through to bss_off's -1
        // "not found" sentinel and resolved to `data_vaddr + data.len() - 1`.
        // So every function value was a data address one byte inside the wrong
        // segment, and calling one was a SEGV on `blr`. That is the second half
        // of #6045 — invisible until the numeric-local-label fix above stopped
        // the program dying on SIGILL before it ever reached an indirect call.
        var res: Arm64SymAddr = arm64_gas_sym_addr(p, aw, p.pf_syms[i], text_vaddr, data_vaddr, p.data.len());
        if (!res.found) { p = Arm64GasProg { ...p, unknown: p.unknown.append("symbol:" + p.pf_syms[i]) }; }
        var target: i64 = res.addr;
        var kind: i32 = p.pf_kinds[i];
        if (kind == 0) {
            var adrp_addr: i64 = text_vaddr + (site as i64);
            code = arm64_patch_adrp(code, site, arm64_page_delta(target, adrp_addr));
        } else if (kind == 1) {
            code = arm64_patch_ldr_off(code, site, arm64_page_off(target));
        } else if (kind == 3) {
            // adr: byte-relative. A delta outside the signed 21-bit span is
            // refused — the patch masks, so it would otherwise wrap into a
            // wrong but well-formed address.
            var delta: i64 = target - (text_vaddr + (site as i64));
            if (delta < (0 - 1048576) || delta >= 1048576) {
                p = Arm64GasProg { ...p, unknown: p.unknown.append("adr:range:" + p.pf_syms[i]) };
            }
            code = arm64_patch_adrp(code, site, delta as i32);
        } else {
            code = arm64_patch_addimm_off(code, site, arm64_page_off(target));
        }
        i = i + 1;
    }
    // Data-word relocations (#6149): write each queued symbol's absolute address
    // into its reserved 8-byte slot, little-endian. Same three-place lookup as
    // the instruction fixups above — a static struct constant's shape word
    // points at a rodata label, but nothing stops a data word naming a .text or
    // .bss symbol, and getting that lookup wrong is exactly what #6045 was.
    var data_len: i32 = p.data.len();
    var dat: i32[] = p.data;
    p = Arm64GasProg { ...p, data: [] };
    var di: i32 = 0;
    while (di < p.dref_offs.len()) {
        var dres: Arm64SymAddr = arm64_gas_sym_addr(p, aw, p.dref_syms[di], text_vaddr, data_vaddr, data_len);
        if (!dres.found) {
            p = Arm64GasProg { ...p, unknown: p.unknown.append("symbol:" + p.dref_syms[di]) };
        } else {
            var off: i32 = p.dref_offs[di];
            var v: i64 = dres.addr;
            var b: i32 = 0;
            while (b < 8) {
                dat = dat.with(off + b, ((v >> (b * 8)) & 255) as i32);
                b = b + 1;
            }
        }
        di = di + 1;
    }
    p = Arm64GasProg { ...p, data: dat };
    aw = Arm64Asm { ...aw, code: code };
    p = Arm64GasProg { ...p, asm: aw };
    return p;
}


// arm64_gas_assemble parses a text-only program (no data section / symbol
// relocation) and returns the resolved .text — the back-compat entry the
// earlier slices use.
function arm64_gas_assemble(src: string): Arm64Asm {
    return arm64_gas_program(src).asm;
}

// ============================================================
// PART 3 — Mach-O writer + ad-hoc SHA-256 signature
// ============================================================

// examples/self_host/macho.fern — a minimal ad-hoc-signed arm64 Mach-O
// executable writer for the self-hosted *native* backend. This is
// the Darwin counterpart of elf.fern (Linux): the container half of the
// native-binary path that aims to remove the external `clang` / `ld64`
// link step the self-host currently shells out to for arm64-darwin
// (mirroring the Go reference internal/native/macho/*.go).
//
// The image is a PIE, dyld-loaded executable: __PAGEZERO, an r-x __TEXT
// segment holding the Mach-O header + load commands + machine code, an
// optional r/w __DATA segment (rodata + writable globals, merged), and a
// __LINKEDIT segment carrying an ad-hoc code signature.
//
// # What Apple Silicon requires
//
// This writer emitted a static, dyld-free, non-PIE LC_UNIXTHREAD image
// until #6042. Every such binary is SIGKILLed at exec on Apple Silicon:
// no crash report, nothing in the system log, exit 137 — indistinguishable
// from an OOM kill, which is how the same container cost the native writer
// (#6000) a diagnosis too. Raw `svc #0x80` syscalls are fine; it is the
// dyld-free CONTAINER the kernel rejects. The requirements, in the order
// they bite:
//
//   * MH_PIE. Without it the kernel refuses the image before dyld runs.
//   * LC_LOAD_DYLINKER + LC_LOAD_DYLIB + LC_MAIN. Every arm64 main
//     executable is dyld-loaded, so execution starts at LC_MAIN's FILE
//     offset (dyld adds the slid load address) rather than at an
//     LC_UNIXTHREAD thread-state pc.
//   * LC_SYMTAB whenever LC_DYSYMTAB is present, else dyld aborts with
//     "LC_DYSYMTAB but no LC_SYMTAB load command". Both are emitted with
//     zero counts: nothing here is exported or imported.
//   * LC_BUILD_VERSION, naming the platform.
//   * An ad-hoc LC_CODE_SIGNATURE — no CMS/certificate, the
//     CodeDirectory's SHA-256 page hashes are the identity.
//
// PIE means dyld slides the image, so an absolute address baked into
// __DATA arrives stale unless the image asks for it to be rebased.
// LC_DYLD_INFO_ONLY carries that request as a rebase opcode stream over the
// assembler's `.quad <symbol>` slots (macho_rebase_opcodes, fed from
// arm64_gas_rebase_offs). Everything else the arm64 emitter computes is
// PC-relative (adrp/@PAGEOFF, b/bl), so those slots are the whole list.
// Emit a `.quad <symbol>` without its rebase opcode and the image loads
// fine, then reads through a pointer stale by the slide — which presents as
// a codegen bug rather than a container one (#6259: the shape pointer of
// every static aggregate constant, so every `match` on one fell through).
//
// Conventions (matching elf.fern):
//   * A byte buffer is an `i32[]` of values in 0..255; each helper appends
//     to it and returns the (possibly grown) buffer (`buf = f(buf, …)`).
//   * This module is intentionally **import-free** so (a) the native
//     emitter can `import "./macho"` and (b) the unit test can concatenate
//     this file with a driver `main()` and feed the whole thing to the
//     single-module wasm_run driver.
//   * Mach-O headers/load-commands are little-endian (arm64 host); the
//     code-signing blobs are big-endian. Both emitters live here.
//
// References: Apple's loader.h / cs_blobs.h, and FIPS 180-4 (SHA-256).

// ============================================================
// SHA-256 (FIPS 180-4)
// ============================================================
//
// The ad-hoc code signature hashes each 4 KiB page of the image with
// SHA-256. We have no stdlib here, so a self-contained implementation
// lives in this module. Words are carried in i64 values kept in the range
// [0, 2^32); every arithmetic result is masked back with `& 0xffffffff`,
// so the signed-i64 `>>` (arithmetic) shift acts as a logical shift on the
// always-positive words.

// sha256_rotr rotates a 32-bit word right by n (1..31) bits.
function sha256_rotr(x: i64, n: i32): i64 {
    return ((x >> n) | (x << (32 - n))) & 0xffffffff;
}

// sha256_shr is a logical right shift of a 32-bit word by n bits.
function sha256_shr(x: i64, n: i32): i64 {
    return (x >> n) & 0xffffffff;
}

function sha256_ssig0(x: i64): i64 {
    return (sha256_rotr(x, 7) ^ sha256_rotr(x, 18) ^ sha256_shr(x, 3)) & 0xffffffff;
}

function sha256_ssig1(x: i64): i64 {
    return (sha256_rotr(x, 17) ^ sha256_rotr(x, 19) ^ sha256_shr(x, 10)) & 0xffffffff;
}

function sha256_bsig0(x: i64): i64 {
    return (sha256_rotr(x, 2) ^ sha256_rotr(x, 13) ^ sha256_rotr(x, 22)) & 0xffffffff;
}

function sha256_bsig1(x: i64): i64 {
    return (sha256_rotr(x, 6) ^ sha256_rotr(x, 11) ^ sha256_rotr(x, 25)) & 0xffffffff;
}

// sha256_ch is the choose function: (x & y) ^ (~x & z).
function sha256_ch(x: i64, y: i64, z: i64): i64 {
    return ((x & y) ^ ((x ^ 0xffffffff) & z)) & 0xffffffff;
}

// sha256_maj is the majority function: (x & y) ^ (x & z) ^ (y & z).
function sha256_maj(x: i64, y: i64, z: i64): i64 {
    return ((x & y) ^ (x & z) ^ (y & z)) & 0xffffffff;
}

// sha256_k returns the 64 round constants K (the first 32 bits of the
// fractional parts of the cube roots of the first 64 primes).
function sha256_k(): i64[] {
    var k: i64[] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    ];
    return k;
}

// macho_be32_word appends a 32-bit word (held in an i64) big-endian.
function macho_be32_word(buf: i32[], v: i64): i32[] {
    buf = buf.append(((v >> 24) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append((v & 255) as i32);
    return buf;
}

// sha256_bytes returns the 32-byte SHA-256 digest of data[start:start+n]
// as an i32[] of bytes.
function sha256_bytes(data: i32[], start: i32, n: i32): i32[] {
    // ---- pre-processing: pad to a multiple of 64 bytes ----
    var m: i32[] = [];
    var i: i32 = 0;
    while (i < n) {
        m = m.append(data[start + i]);
        i = i + 1;
    }
    m = m.append(128); // the single 0x80 bit
    while ((m.len() % 64) != 56) {
        m = m.append(0);
    }
    // 64-bit big-endian message length in bits.
    var bits: i64 = (n as i64) * 8;
    var bb: i32 = 7;
    while (bb >= 0) {
        m = m.append(((bits >> (bb * 8)) & 255) as i32);
        bb = bb - 1;
    }

    var k: i64[] = sha256_k();

    // ---- initial hash value (fractional cube... square roots of primes) ----
    var h0: i64 = 0x6a09e667;
    var h1: i64 = 0xbb67ae85;
    var h2: i64 = 0x3c6ef372;
    var h3: i64 = 0xa54ff53a;
    var h4: i64 = 0x510e527f;
    var h5: i64 = 0x9b05688c;
    var h6: i64 = 0x1f83d9ab;
    var h7: i64 = 0x5be0cd19;

    var blocks: i32 = m.len() / 64;
    var blk: i32 = 0;
    while (blk < blocks) {
        var base: i32 = blk * 64;

        // ---- message schedule W[0..63] ----
        var w: i64[] = [];
        var t: i32 = 0;
        while (t < 16) {
            var p: i32 = base + t * 4;
            var word: i64 = ((m[p] as i64) << 24)
                | ((m[p + 1] as i64) << 16)
                | ((m[p + 2] as i64) << 8)
                | (m[p + 3] as i64);
            w = w.append(word & 0xffffffff);
            t = t + 1;
        }
        while (t < 64) {
            var s0: i64 = sha256_ssig0(w[t - 15]);
            var s1: i64 = sha256_ssig1(w[t - 2]);
            var wt: i64 = (s1 + w[t - 7] + s0 + w[t - 16]) & 0xffffffff;
            w = w.append(wt);
            t = t + 1;
        }

        // ---- compression ----
        var a: i64 = h0;
        var b: i64 = h1;
        var c: i64 = h2;
        var d: i64 = h3;
        var e: i64 = h4;
        var f: i64 = h5;
        var g: i64 = h6;
        var hh: i64 = h7;

        var r: i32 = 0;
        while (r < 64) {
            var t1: i64 = (hh + sha256_bsig1(e) + sha256_ch(e, f, g) + k[r] + w[r]) & 0xffffffff;
            var t2: i64 = (sha256_bsig0(a) + sha256_maj(a, b, c)) & 0xffffffff;
            hh = g;
            g = f;
            f = e;
            e = (d + t1) & 0xffffffff;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) & 0xffffffff;
            r = r + 1;
        }

        h0 = (h0 + a) & 0xffffffff;
        h1 = (h1 + b) & 0xffffffff;
        h2 = (h2 + c) & 0xffffffff;
        h3 = (h3 + d) & 0xffffffff;
        h4 = (h4 + e) & 0xffffffff;
        h5 = (h5 + f) & 0xffffffff;
        h6 = (h6 + g) & 0xffffffff;
        h7 = (h7 + hh) & 0xffffffff;

        blk = blk + 1;
    }

    var out: i32[] = [];
    out = macho_be32_word(out, h0);
    out = macho_be32_word(out, h1);
    out = macho_be32_word(out, h2);
    out = macho_be32_word(out, h3);
    out = macho_be32_word(out, h4);
    out = macho_be32_word(out, h5);
    out = macho_be32_word(out, h6);
    out = macho_be32_word(out, h7);
    return out;
}

// ============================================================
// byte emitters + buffer helpers
// ============================================================

// macho_le32 appends the low 4 bytes of `v`, little-endian.
function macho_le32(buf: i32[], v: i32): i32[] {
    buf = buf.append(v & 255);
    buf = buf.append((v >> 8) & 255);
    buf = buf.append((v >> 16) & 255);
    buf = buf.append((v >> 24) & 255);
    return buf;
}

// macho_le64 appends the 8 bytes of a 64-bit `v`, little-endian.
function macho_le64(buf: i32[], v: i64): i32[] {
    var b: i32 = 0;
    while (b < 8) {
        buf = buf.append(((v >> (b * 8)) & 255) as i32);
        b = b + 1;
    }
    return buf;
}

// macho_be32 appends the low 4 bytes of `v`, big-endian (for code-signing
// blobs, which are big-endian on disk).
function macho_be32(buf: i32[], v: i32): i32[] {
    buf = buf.append((v >> 24) & 255);
    buf = buf.append((v >> 16) & 255);
    buf = buf.append((v >> 8) & 255);
    buf = buf.append(v & 255);
    return buf;
}

// macho_le32w / macho_be32w take the value as i64, for the magic / flag
// constants that exceed the signed-i32 range (e.g. 0xfeedfacf) — the Go
// front-end rejects an out-of-range i32 literal.
function macho_le32w(buf: i32[], v: i64): i32[] {
    buf = buf.append((v & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 24) & 255) as i32);
    return buf;
}
function macho_be32w(buf: i32[], v: i64): i32[] {
    buf = buf.append(((v >> 24) & 255) as i32);
    buf = buf.append(((v >> 16) & 255) as i32);
    buf = buf.append(((v >> 8) & 255) as i32);
    buf = buf.append((v & 255) as i32);
    return buf;
}

// macho_be64 appends the 8 bytes of a 64-bit `v`, big-endian.
function macho_be64(buf: i32[], v: i64): i32[] {
    var b: i32 = 7;
    while (b >= 0) {
        buf = buf.append(((v >> (b * 8)) & 255) as i32);
        b = b - 1;
    }
    return buf;
}

// macho_name16 writes a 16-byte, NUL-padded segment/section name.
function macho_name16(buf: i32[], s: string): i32[] {
    var i: i32 = 0;
    while (i < s.len()) {
        buf = buf.append((s[i] as i32));
        i = i + 1;
    }
    while (i < 16) {
        buf = buf.append(0);
        i = i + 1;
    }
    return buf;
}

// macho_zeros appends `n` zero bytes.
function macho_zeros(buf: i32[], n: i32): i32[] {
    var i: i32 = 0;
    while (i < n) {
        buf = buf.append(0);
        i = i + 1;
    }
    return buf;
}

// macho_cat appends every byte of `src` to `buf`.
function macho_cat(buf: i32[], src: i32[]): i32[] {
    var i: i32 = 0;
    while (i < src.len()) {
        buf = buf.append(src[i]);
        i = i + 1;
    }
    return buf;
}

// macho_pad_to appends zero bytes until the buffer length reaches `n`.
function macho_pad_to(buf: i32[], n: i32): i32[] {
    while (buf.len() < n) {
        buf = buf.append(0);
    }
    return buf;
}

// ============================================================
// fixed-layout constants
// ============================================================

// macho_page_size is the 16 KiB Mach-O segment alignment on arm64.
function macho_page_size(): i32 { return 16384; }

// macho_base_vaddr is the __TEXT load address (just past __PAGEZERO).
function macho_base_vaddr(): i64 { return 0x100000000; }

// macho_align_up rounds n up to a multiple of the power-of-two a.
function macho_align_up(n: i32, a: i32): i32 {
    return (n + a - 1) & (0 - a);
}

// macho_dylinker_path is the dynamic linker every arm64 main executable
// must name, and macho_libsystem_path the one dylib it loads.
function macho_dylinker_path(): string { return "/usr/lib/dyld"; }
function macho_libsystem_path(): string { return "/usr/lib/libSystem.B.dylib"; }

// macho_lcstr_fixed_len is the size of an lc_str command's fixed part,
// before the path: LC_LOAD_DYLIB carries a timestamp + two versions after
// the name offset, LC_LOAD_DYLINKER carries nothing.
function macho_lcstr_fixed_len(cmd: i32): i32 {
    if (cmd == 12) { return 24; }   // LC_LOAD_DYLIB
    return 12;                      // LC_LOAD_DYLINKER
}

// macho_lcstr_cmd_len is the padded size of an lc_str command carrying
// `path`: the fixed part plus the NUL-terminated path, rounded up to 8.
function macho_lcstr_cmd_len(cmd: i32, path: string): i32 {
    return macho_align_up(macho_lcstr_fixed_len(cmd) + path.len() + 1, 8);
}

// macho_load_cmds_len is the total size of all load commands: __PAGEZERO
// + __TEXT (1 section) + optional __DATA (1 section) + __LINKEDIT +
// LC_DYLD_INFO_ONLY + LC_SYMTAB + LC_DYSYMTAB + LC_BUILD_VERSION +
// LC_LOAD_DYLINKER + LC_LOAD_DYLIB + LC_MAIN + LC_CODE_SIGNATURE.
// (segCmd=72, section=80, dyldInfo=48, symtab=24, dysymtab=80,
// buildVersion=24, main=24, codeSig=16.)
//
// The trailing `+ 48` is 48 bytes of zero slack between the last load
// command and the first code byte: the native writer's loadCommandsLen
// counts dyldInfoCmdLen twice, and this figure is what fixes text_off
// (hence every address), so the two writers agree on layout only if this
// one does too. Removing it belongs in a change that moves both.
function macho_load_cmds_len(has_data: boolean): i32 {
    var n: i32 = 72 + (72 + 80) + 72; // PAGEZERO + TEXT(1 sect) + LINKEDIT
    if (has_data) {
        n = n + (72 + 80); // DATA(1 sect)
    }
    n = n + 48 + 24 + 80 + 24;  // DYLD_INFO_ONLY + SYMTAB + DYSYMTAB + BUILD_VERSION
    n = n + macho_lcstr_cmd_len(14, macho_dylinker_path());
    n = n + macho_lcstr_cmd_len(12, macho_libsystem_path());
    n = n + 24 + 16;            // LC_MAIN + LC_CODE_SIGNATURE
    n = n + 48;                 // slack — see the comment above
    return n;
}

// macho_text_off is the file offset of code within __TEXT (after the
// Mach-O header + load commands). A native assembler needs this to
// resolve @PAGE / @PAGEOFF references before the same blobs are laid out
// here at the same address.
function macho_text_off(has_data: boolean): i32 {
    return 32 + macho_load_cmds_len(has_data);
}

// macho_needs_data decides whether the image gets a __DATA segment. Zero-init
// bss counts: it needs mapped writable pages just as initialized data does,
// and it is the segment's vmsize rather than its filesize that covers it.
//
// Every layout decision keyed on this must use this one function — the
// address of the first code byte moves with it (a __DATA segment adds its
// load commands ahead of the code), so a caller disagreeing about whether
// there is data disagrees about every address in the image.
function macho_needs_data(data_len: i32, bss: i32): boolean {
    return data_len > 0 || bss > 0;
}

// macho_text_vaddr returns the address of the first code byte (== entry)
// for the given code/data/bss sizes.
pub function macho_text_vaddr(text_len: i32, data_len: i32, bss: i32): i64 {
    return macho_base_vaddr() + (macho_text_off(macho_needs_data(data_len, bss)) as i64);
}

// macho_data_vaddr returns the __DATA segment base for the given
// code/data/bss sizes (0 when the image has neither).
pub function macho_data_vaddr(text_len: i32, data_len: i32, bss: i32): i64 {
    if (!macho_needs_data(data_len, bss)) {
        return 0;
    }
    var text_off: i32 = macho_text_off(true);
    var text_vmsize: i32 = macho_align_up(text_off + text_len, macho_page_size());
    return macho_base_vaddr() + (text_vmsize as i64);
}

// ============================================================
// load-command writers
// ============================================================

// macho_seg writes an LC_SEGMENT_64 command header for nsects sections.
function macho_seg(buf: i32[], name: string, vmaddr: i64, vmsize: i64, fileoff: i64, filesize: i64, maxprot: i32, initprot: i32, nsects: i32): i32[] {
    buf = macho_le32(buf, 25); // LC_SEGMENT_64 = 0x19
    buf = macho_le32(buf, 72 + nsects * 80);
    buf = macho_name16(buf, name);
    buf = macho_le64(buf, vmaddr);
    buf = macho_le64(buf, vmsize);
    buf = macho_le64(buf, fileoff);
    buf = macho_le64(buf, filesize);
    buf = macho_le32(buf, maxprot);
    buf = macho_le32(buf, initprot);
    buf = macho_le32(buf, nsects);
    buf = macho_le32(buf, 0); // flags
    return buf;
}

// macho_sect writes a section_64 record.
function macho_sect(buf: i32[], sect: string, seg: string, addr: i64, size: i32, offset: i32, align: i32, flags: i64): i32[] {
    buf = macho_name16(buf, sect);
    buf = macho_name16(buf, seg);
    buf = macho_le64(buf, addr);
    buf = macho_le64(buf, size as i64);
    buf = macho_le32(buf, offset);
    buf = macho_le32(buf, align);
    buf = macho_le32(buf, 0); // reloff
    buf = macho_le32(buf, 0); // nreloc
    buf = macho_le32w(buf, flags);
    buf = macho_le32(buf, 0); // reserved1
    buf = macho_le32(buf, 0); // reserved2
    buf = macho_le32(buf, 0); // reserved3
    return buf;
}

// macho_lcstr writes an lc_str load command (LC_LOAD_DYLINKER /
// LC_LOAD_DYLIB): the command, its padded size, a uint32 offset from the
// start of the command to the NUL-terminated path, then the path itself
// zero-padded out to that size.
function macho_lcstr(buf: i32[], cmd: i32, path: string): i32[] {
    var size: i32 = macho_lcstr_cmd_len(cmd, path);
    var fixed: i32 = macho_lcstr_fixed_len(cmd);
    buf = macho_le32(buf, cmd);
    buf = macho_le32(buf, size);
    buf = macho_le32(buf, fixed);
    if (cmd == 12) {
        buf = macho_le32(buf, 0); // timestamp
        buf = macho_le32(buf, 0); // current_version
        buf = macho_le32(buf, 0); // compatibility_version
    }
    var i: i32 = 0;
    while (i < path.len()) {
        buf = buf.append((path[i] as i32));
        i = i + 1;
    }
    return macho_zeros(buf, size - fixed - path.len());
}

// macho_dyld_info writes LC_DYLD_INFO_ONLY. Only the rebase stream is ever
// populated — the image imports, exports and binds nothing — so every other
// off/size pair is zero.
function macho_dyld_info(buf: i32[], rebase_off: i32, rebase_size: i32): i32[] {
    buf = macho_le32w(buf, 0x80000022); // LC_DYLD_INFO_ONLY | LC_REQ_DYLD
    buf = macho_le32(buf, 48);
    buf = macho_le32(buf, rebase_off);
    buf = macho_le32(buf, rebase_size);
    return macho_zeros(buf, 32); // bind, weak_bind, lazy_bind, export
}

// macho_uleb appends `v` as an unsigned LEB128 (the encoding every operand in
// a dyld opcode stream uses).
function macho_uleb(buf: i32[], v: i32): i32[] {
    var n: i32 = v;
    while (n >= 128) {
        buf = buf.append((n & 127) | 128);
        n = n >> 7;
    }
    return buf.append(n & 127);
}

// macho_rebase_opcodes builds the LC_DYLD_INFO_ONLY rebase stream: the program
// that tells dyld which words to add the image slide to. `seg_idx` is the
// segment the offsets are relative to (2 = __DATA: __PAGEZERO 0, __TEXT 1) and
// `offs` their byte offsets within it.
//
// Three opcodes suffice. SET_TYPE_IMM once (every slot is a plain pointer),
// then per slot SET_SEGMENT_AND_OFFSET_ULEB + DO_REBASE_IMM_TIMES(1). Naming
// the segment and offset again for each slot costs a few bytes over a run-based
// encoding and makes the stream order-independent, so a caller need not sort.
// The stream is padded to a multiple of 8 like every other __LINKEDIT blob.
function macho_rebase_opcodes(seg_idx: i32, offs: i32[]): i32[] {
    if (offs.len() == 0) { return []; }
    var buf: i32[] = [0x10 | 1];        // REBASE_OPCODE_SET_TYPE_IMM | REBASE_TYPE_POINTER
    var i: i32 = 0;
    while (i < offs.len()) {
        buf = buf.append(0x20 | seg_idx); // REBASE_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB
        buf = macho_uleb(buf, offs[i]);
        buf = buf.append(0x50 | 1);      // REBASE_OPCODE_DO_REBASE_IMM_TIMES, count 1
        i = i + 1;
    }
    buf = buf.append(0);               // REBASE_OPCODE_DONE
    while ((buf.len() % 8) != 0) {
        buf = buf.append(0);
    }
    return buf;
}

// macho_symtab writes an LC_SYMTAB, and macho_dysymtab an LC_DYSYMTAB with
// every index and count zero. dyld requires LC_DYSYMTAB on a two-level
// image and refuses one that carries it without an LC_SYMTAB, so both are
// present and degenerate: this writer emits no symbols.
function macho_symtab(buf: i32[], symoff: i32, nsyms: i32, stroff: i32, strsize: i32): i32[] {
    buf = macho_le32(buf, 2);  // LC_SYMTAB
    buf = macho_le32(buf, 24);
    buf = macho_le32(buf, symoff);
    buf = macho_le32(buf, nsyms);
    buf = macho_le32(buf, stroff);
    return macho_le32(buf, strsize);
}

function macho_dysymtab(buf: i32[]): i32[] {
    buf = macho_le32(buf, 11); // LC_DYSYMTAB
    buf = macho_le32(buf, 80);
    return macho_zeros(buf, 72); // 18 index/count uint32 pairs
}

// macho_build_version writes LC_BUILD_VERSION declaring the image as
// macOS. Apple Silicon's kernel SIGKILLs an arm64 main executable that
// names no platform — a valid ad-hoc signature is not sufficient on its
// own. minos / sdk are nibble-encoded XXXX.YY.ZZ; 11.0.0 is the first
// macOS with Apple Silicon, the floor for an arm64 executable. ntools is
// 0: the tool-version list is informational.
function macho_build_version(buf: i32[]): i32[] {
    buf = macho_le32(buf, 50); // LC_BUILD_VERSION = 0x32
    buf = macho_le32(buf, 24);
    buf = macho_le32(buf, 1);         // PLATFORM_MACOS
    buf = macho_le32(buf, 0x000b0000); // minos 11.0.0
    buf = macho_le32(buf, 0x000b0000); // sdk 11.0.0
    return macho_le32(buf, 0);        // ntools
}

// macho_main writes LC_MAIN. entryoff is a FILE offset from the start of
// the mach header, not a VM address — dyld adds the image's load address
// itself, which is what makes the entry survive a slide.
function macho_main(buf: i32[], entryoff: i32): i32[] {
    buf = macho_le32w(buf, 0x80000028); // LC_MAIN | LC_REQ_DYLD
    buf = macho_le32(buf, 24);
    buf = macho_le64(buf, entryoff as i64);
    return macho_le64(buf, 0); // stacksize: 0 = system default
}

// ============================================================
// code signature
// ============================================================

// macho_sig_len computes the signature length analytically (it depends
// only on code_limit and the identifier length, not on the content), so
// the LC_CODE_SIGNATURE command + __LINKEDIT sizing can be emitted before
// the hashes are known.
function macho_sig_len(code_limit: i32, ident_len: i32): i32 {
    var id_len: i32 = ident_len + 1; // + NUL terminator
    var hash_off: i32 = 88 + id_len; // cdHeaderLen + identifier
    var n_slots: i32 = (code_limit + 4095) / 4096;
    var cd_len: i32 = hash_off + n_slots * 32;
    return 20 + cd_len; // SuperBlob header (12) + 1 BlobIndex (8) + CD
}

// macho_code_signature builds an ad-hoc CSMAGIC_EMBEDDED_SIGNATURE
// SuperBlob containing one CodeDirectory whose code-slot hashes are
// SHA-256 of each 4 KiB page of content[0:code_limit]. exec_seg_limit is
// the size of the executable (__TEXT) segment.
function macho_code_signature(content: i32[], code_limit: i32, exec_seg_limit: i32, ident: string): i32[] {
    var id_len: i32 = ident.len() + 1;
    var hash_off: i32 = 88 + id_len;
    var n_slots: i32 = (code_limit + 4095) / 4096;
    var cd_len: i32 = hash_off + n_slots * 32;
    var total: i32 = 20 + cd_len;

    var sb: i32[] = [];
    // ---- SuperBlob header + one BlobIndex ----
    sb = macho_be32w(sb, 0xfade0cc0); // CSMAGIC_EMBEDDED_SIGNATURE
    sb = macho_be32(sb, total);
    sb = macho_be32(sb, 1);          // sub-blob count
    sb = macho_be32(sb, 0);          // CSSLOT_CODEDIRECTORY
    sb = macho_be32(sb, 20);         // offset of the CodeDirectory

    // ---- CodeDirectory ----
    sb = macho_be32w(sb, 0xfade0c02); // CSMAGIC_CODEDIRECTORY
    sb = macho_be32(sb, cd_len);
    sb = macho_be32(sb, 0x20400);    // version (supports execSeg fields)
    sb = macho_be32(sb, 2);          // CS_ADHOC
    sb = macho_be32(sb, hash_off);   // hashOffset
    sb = macho_be32(sb, 88);         // identOffset
    sb = macho_be32(sb, 0);          // nSpecialSlots
    sb = macho_be32(sb, n_slots);    // nCodeSlots
    sb = macho_be32(sb, code_limit); // codeLimit
    sb = sb.append(32);                // hashSize (SHA-256)
    sb = sb.append(2);                 // hashType = SHA-256
    sb = sb.append(0);                 // platform
    sb = sb.append(12);                // log2(pageSize) = 4096
    sb = macho_zeros(sb, 24);        // spare2 / scatter / team / spare3 / codeLimit64
    sb = macho_be64(sb, 0);          // execSegBase
    sb = macho_be64(sb, exec_seg_limit as i64); // execSegLimit
    sb = macho_be64(sb, 1);          // execSegFlags = CS_EXECSEG_MAIN_BINARY

    // identifier + NUL
    var i: i32 = 0;
    while (i < ident.len()) {
        sb = sb.append((ident[i] as i32));
        i = i + 1;
    }
    sb = sb.append(0);

    // page hashes
    var slot: i32 = 0;
    while (slot < n_slots) {
        var pstart: i32 = slot * 4096;
        var pend: i32 = pstart + 4096;
        if (pend > code_limit) {
            pend = code_limit;
        }
        var dig: i32[] = sha256_bytes(content, pstart, pend - pstart);
        var j: i32 = 0;
        while (j < 32) {
            sb = sb.append(dig[j]);
            j = j + 1;
        }
        slot = slot + 1;
    }
    return sb;
}

// ============================================================
// the image writer
// ============================================================

// macho_entry_off resolves the entry offset to pass to macho_executable:
// the `_main` label's offset in the assembled text, or 0 for a hand-built
// snippet that has no such label and whose entry is its first byte.
pub function macho_entry_off(a: Arm64Asm): i32 {
    var off: i32 = arm64_asm_label_off(a, "_main");
    if (off < 0) { return 0; }
    return off;
}

// macho_executable wraps machine code and a data blob into a runnable,
// ad-hoc-signed, dyld-loaded PIE arm64 Mach-O executable. Code occupies
// the r-x __TEXT segment; data (read-only constants + writable globals,
// merged by the assembler) occupies a r/w __DATA segment. `ident` is the
// ad-hoc signing identifier (any short string).
//
// `entry_off` is the entry's offset within `text`, the Mach-O sibling of
// elf_image_entry's parameter and needed for the same reason: the arm64
// emitter writes `_main` AFTER the user's functions, so the first code
// byte is some arbitrary function. Pass 0 only when the entry really is
// the first byte. Getting this wrong does not fail to launch — dyld calls
// whatever function is there, which returns a plausible-looking exit
// code, so a single-function program still "passes" and a multi-function
// one silently runs the wrong body.
//
// `bss` is the zero-init tail past the data bytes — the Mach-O sibling of
// elf_image_entry_bss's parameter. arm64_gas_link resolves a .bss symbol to
// `data_vaddr + data.len() + bss_off`, so __DATA's vmsize must cover it
// while its filesize stays at the bytes actually in the file; the kernel
// zero-fills the difference. Omit it and every symbol past the emitter's
// `.skip` reservations (the 64 MiB strbuf, the freelists) resolves outside
// the mapped segment: reads and writes there fault, and because the
// affected symbols sit at the tail, the failure looks like a bug in
// whatever runtime helper happens to touch one first.
//
// bss alone is enough to get a __DATA segment (macho_needs_data), and the
// linker uses the same test so the two agree on the layout. A bss-only image
// is reachable: a program that touches __fern_scratch but has no initialized
// data emits one, and while the arm64 emitter's unconditional f64 constant
// pool masked that, gating the pool on its need made it ordinary. Without
// this, such an image gets no writable segment at all and the first write to
// a .bss symbol faults.
//
// `rebase_offs` names every 8-byte slot in `data` that holds an ABSOLUTE
// address (arm64_gas_rebase_offs — the assembler's `.quad <symbol>` slots).
// dyld slides a PIE image, so each of those needs the slide added; the
// LC_DYLD_INFO_ONLY rebase stream is how the image asks for that. Pass an
// empty array when the data blob holds no absolute addresses.
pub function macho_executable(text: i32[], data: i32[], ident: string, entry_off: i32, bss: i32, rebase_offs: i32[]): i32[] {
    var text_len: i32 = text.len();
    var data_len: i32 = data.len();
    var has_data: boolean = macho_needs_data(data_len, bss);
    var text_off: i32 = macho_text_off(has_data);
    var page: i32 = macho_page_size();
    var text_vmsize: i32 = macho_align_up(text_off + text_len, page);
    var data_file_len: i32 = 0;
    var data_vm_len: i32 = 0;
    if (has_data) {
        data_file_len = macho_align_up(data_len, page);
        data_vm_len = macho_align_up(data_len + bss, page);
    }
    // __LINKEDIT holds the rebase stream first, then the code signature. The
    // signed region (code_limit) must cover the stream, so the signature
    // starts at the 16-aligned end of it. With no rebases the stream is empty
    // and sig_off lands exactly where it used to, so those images are
    // byte-identical to before.
    var rebase: i32[] = [];
    if (has_data) {
        rebase = macho_rebase_opcodes(2, rebase_offs);
    }
    var linkedit_off: i32 = text_vmsize + data_file_len;
    var code_limit: i32 = macho_align_up(linkedit_off + rebase.len(), 16);

    var base: i64 = macho_base_vaddr();
    var text_vaddr: i64 = base + (text_off as i64);
    var data_vaddr: i64 = base + (text_vmsize as i64);
    var linkedit_vaddr: i64 = data_vaddr + (data_vm_len as i64);

    var sig_len: i32 = macho_sig_len(code_limit, ident.len());
    var linkedit_file_len: i32 = (code_limit - linkedit_off) + sig_len;
    var linkedit_vmsize: i32 = macho_align_up(linkedit_file_len, page);

    var ncmds: i32 = 11;
    if (has_data) {
        ncmds = 12;
    }
    // sizeofcmds is the size of the commands ACTUALLY written, which is
    // macho_load_cmds_len minus its 48 bytes of layout slack.
    var sizeofcmds: i32 = macho_load_cmds_len(has_data) - 48;

    var buf: i32[] = [];

    // ---- Mach-O header (32 bytes) ----
    buf = macho_le32w(buf, 0xfeedfacf); // MH_MAGIC_64
    buf = macho_le32(buf, 0x0100000c); // CPU_TYPE_ARM64
    buf = macho_le32(buf, 0);          // CPU_SUBTYPE_ARM64_ALL
    buf = macho_le32(buf, 2);          // MH_EXECUTE
    buf = macho_le32(buf, ncmds);
    buf = macho_le32(buf, sizeofcmds);
    // MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE. MH_PIE is the one
    // the kernel checks before dyld runs at all.
    buf = macho_le32(buf, 0x00200085);
    buf = macho_le32(buf, 0);          // reserved

    // ---- __PAGEZERO ----
    buf = macho_seg(buf, "__PAGEZERO", 0, base, 0, 0, 0, 0, 0);

    // ---- __TEXT (r-x), 1 section ----
    buf = macho_seg(buf, "__TEXT", base, text_vmsize as i64, 0, text_vmsize as i64, 5, 5, 1);
    // flags = S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    buf = macho_sect(buf, "__text", "__TEXT", text_vaddr, text_len, text_off, 2, 0x80000400);

    // ---- __DATA (r/w), 1 section (optional) ----
    if (has_data) {
        // vmsize covers the zero-init bss tail; filesize is just the bytes on
        // disk. The __data section stays the initialized part.
        buf = macho_seg(buf, "__DATA", data_vaddr, data_vm_len as i64, text_vmsize as i64, data_file_len as i64, 3, 3, 1);
        buf = macho_sect(buf, "__data", "__DATA", data_vaddr, data_len, text_vmsize, 3, 0);
    }

    // ---- __LINKEDIT (r) ----
    buf = macho_seg(buf, "__LINKEDIT", linkedit_vaddr, linkedit_vmsize as i64, linkedit_off as i64, linkedit_file_len as i64, 1, 1, 0);

    // ---- the dyld command set (see the module comment) ----
    buf = macho_dyld_info(buf, linkedit_off, rebase.len());
    buf = macho_symtab(buf, 0, 0, 0, 0);
    buf = macho_dysymtab(buf);
    buf = macho_build_version(buf);
    buf = macho_lcstr(buf, 14, macho_dylinker_path()); // LC_LOAD_DYLINKER
    buf = macho_lcstr(buf, 12, macho_libsystem_path()); // LC_LOAD_DYLIB
    buf = macho_main(buf, text_off + entry_off);

    // ---- LC_CODE_SIGNATURE ----
    buf = macho_le32(buf, 29);         // LC_CODE_SIGNATURE = 0x1d
    buf = macho_le32(buf, 16);         // cmdsize
    buf = macho_le32(buf, code_limit); // dataoff
    buf = macho_le32(buf, sig_len);    // datasize

    // ---- code + data ----
    // pad_to closes the 48-byte slack macho_load_cmds_len reserves past
    // the last load command, so code starts at text_off.
    buf = macho_pad_to(buf, text_off);
    buf = macho_cat(buf, text);
    buf = macho_pad_to(buf, text_vmsize);
    if (has_data) {
        buf = macho_cat(buf, data);
        buf = macho_pad_to(buf, linkedit_off);
    }
    buf = macho_cat(buf, rebase);
    buf = macho_pad_to(buf, code_limit);
    // buf length is now code_limit; sign it and append the signature.
    var sig: i32[] = macho_code_signature(buf, code_limit, text_vmsize, ident);
    buf = macho_cat(buf, sig);
    return buf;
}
