// examples/self_host/wasm_objfile.fern — the per-module wasm object format
// (#5331).
//
// A cached unit is not just its WAT text. Link needs the unit's METADATA too —
// its string literals, its address-taken functions, its runtime needs, its
// call_indirect signatures. Recomputing any of that means lowering the module, which is exactly
// the cost the cache exists to avoid, so it is all persisted alongside the text.
//
// Format. Every section is `<tag><count>\n` followed by `count` items, and every
// string item is LENGTH-PREFIXED (`<len>\n<raw bytes>`) rather than delimited or
// escaped:
//
//     FERNWU4\n
//     S<n>\n  <len>\n<bytes> ...   string literals
//     K<n>\n  <len>\n<bytes> ...   aggregate constants (ir.op_const_struct payloads)
//     F<n>\n  <len>\n<bytes> ...   address-taken function names
//     N<n>\n  <len>\n<bytes> ...   runtime needs (wasm_ir.needs_of)
//     A<n>\n  <len>\n<bytes> ...   call_indirect signatures ("$fn2|ww_w")
//     U<len>\n<unit WAT text>
//
// Length prefixes rather than escaping because a string literal may contain
// anything at all — newlines, quotes, NUL. An escaping scheme has to be exactly
// inverted by the decoder or literals corrupt silently; a byte count cannot be
// got subtly wrong, it either reads the right span or fails the round-trip test.

import "./util";

pub struct UnitObj {
  strs: string[],
  caggs: string[],
  fns: string[],
  needs: string[],
  fn_sigs: string[],
  text: string,
}

// Cursor threads a decode position alongside its result. The self-host language
// has tuples, but a named struct keeps the two-field returns below readable.
// MaybeUnit is a cache-lookup result: `found` distinguishes a hit from a miss,
// since UnitObj has no natural empty sentinel. Used by the hit-only link path.
pub struct MaybeUnit { found: boolean, obj: UnitObj }

// empty_unit is the placeholder a MaybeUnit carries on a miss; never read when
// found is false.
pub function empty_unit(): UnitObj {
  return UnitObj { strs: [], caggs: [], fns: [], needs: [], fn_sigs: [], text: "" };
}

pub struct StrsAt { items: string[], pos: i32 }

pub struct IntsAt { items: i32[], pos: i32 }

function enc_strs(tag: string, xs: string[]): string {
  let out: string = tag + util.i32_to_string(xs.len()) + "\n";
  let i: i32 = 0;
  while (i < xs.len()) {
    out = out + util.i32_to_string(xs[i].len()) + "\n" + xs[i];
    i = i + 1;
  }
  return out;
}

// magic is the format's version tag. It is BUMPED on any layout change, and
// cache_lookup checks it before decoding: the cache key is a hash of the
// module's sources and signatures, so nothing in the filename would otherwise
// distinguish an object written by an older compiler — decode reads sections
// positionally and a stale file would yield a wrong-but-plausible unit.
pub function magic(): string {
  return "FERNWU4\n";
}

// is_current reports whether `s` was written by this format version.
pub function is_current(s: string): boolean {
  if (s.len() < magic().len()) {
    return false;
  }
  return slice_unchecked(s, 0, magic().len()) + "" == magic();
}

pub function encode(u: UnitObj): string {
  return magic()
    + enc_strs("S", u.strs)
    + enc_strs("K", u.caggs)
    + enc_strs("F", u.fns)
    + enc_strs("N", u.needs)
    + enc_strs("A", u.fn_sigs)
    + "U" + util.i32_to_string(u.text.len()) + "\n" + u.text;
}

// scan_int reads decimal digits from `pos` up to the next newline and returns
// the position just past it. Every count and length in the format is read this
// way, so the decoder never has to search for a delimiter inside payload bytes.
function scan_int(s: string, pos: i32): IntsAt {
  let p: i32 = pos;
  let v: i32 = 0;
  while (p < s.len() && s[p] != b'\n') {
    if (s[p] as i32 >= 48 && s[p] as i32 <= 57) {
      v = v * 10 + (s[p] as i32 - 48);
    }
    p = p + 1;
  }
  return IntsAt { items: [v], pos: p + 1 };
}

// dec_strs reads one length-prefixed string section. `pos` must point at the
// section's count (i.e. just past its tag byte).
function dec_strs(s: string, pos: i32): StrsAt {
  let hdr: IntsAt = scan_int(s, pos);
  let n: i32 = hdr.items[0];
  let p: i32 = hdr.pos;
  let out: string[] = [];
  let i: i32 = 0;
  while (i < n) {
    let lh: IntsAt = scan_int(s, p);
    let len: i32 = lh.items[0];
    out = out.append(slice_unchecked(s, lh.pos, lh.pos + len) + "");
    p = lh.pos + len;
    i = i + 1;
  }
  return StrsAt { items: out, pos: p };
}

// decode inverts encode. Sections are read in the order encode writes them, so
// each tag byte is skipped positionally rather than searched for — a malformed
// or truncated file therefore yields wrong spans rather than a wrong-but-
// plausible unit, which the round-trip test catches.
pub function decode(s: string): UnitObj {
  let p: i32 = magic().len();  // past the magic
  let st: StrsAt = dec_strs(s, p + 1);
  let kg: StrsAt = dec_strs(s, st.pos + 1);
  let fn: StrsAt = dec_strs(s, kg.pos + 1);
  let nd: StrsAt = dec_strs(s, fn.pos + 1);
  let ar: StrsAt = dec_strs(s, nd.pos + 1);
  let tl: IntsAt = scan_int(s, ar.pos + 1);
  return UnitObj {
    strs: st.items,
    caggs: kg.items,
    fns: fn.items,
    needs: nd.items,
    fn_sigs: ar.items,
    text: slice_unchecked(s, tl.pos, tl.pos + tl.items[0]) + "",
  };
}
