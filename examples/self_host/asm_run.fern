// examples/self_host/asm_run.fern — bootstrap-demo driver. Reads
// Fern source from stdin, wires it through lexer +
// parser + asm.emit_module, and prints the resulting AT&T x86_64
// assembly to stdout. The companion Go-side test
// (self_host_asm_run_test.go) pipes a source program in, captures
// the asm, assembles it with gcc -nostdlib, and runs the
// resulting binary — asserting the exit code matches the
// expected value for that source. Multiple sources flow through
// the same driver via a table-driven test.
//
// That's the real bootstrap-style demo: Fern program → native
// binary → correct exit code. End-to-end proof that
// asm.fern produces working executables.

import "std/io";
import "./lexer";
import "./parser";
import "./asm";

function main(): i32 {
    var src: string = io.read_all_stdin();
    var mod: parser.Module = parser.parse_module(lexer.tokenize(src));
    var emitted: string = asm.emit_module(parser.module_with_builtins(mod));
    print(emitted);
    return 0;
}
