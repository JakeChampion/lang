// examples/self_host/wat_component.fern — Component-Model wrapping for the
// self-hosted binary wasm backend. The core-module encoder (wat_emit_bin)
// produces a WASI-preview1 core module; this wraps it in the binary
// Component-Model envelope. First slice: the component preamble + embedding
// the core module as a component core-module section, which `wasm-tools`
// validates as a `(component (core module …))`.
//
// A component's preamble is the wasm magic followed by `0d 00 01 00`
// (version 13, layer 1) — distinct from a core module's `01 00 00 00` —
// and its sections use the component section ids (1 = an embedded core
// module, whose body is that module's own bytes).
//
// Later slices add the core-instance, the `canon lift`, and the
// `wasi:cli/run` instance export. Depends on leb128.fern + wat_encode.fern
// (wcat / wsection) but is otherwise import-free.

// component_preamble: "\0asm" + component version (13) / layer (1).
function component_preamble(): i32[] {
    var o: i32[] = [];
    o = o.push(0);
    o = o.push(97);
    o = o.push(115);
    o = o.push(109);
    o = o.push(13);
    o = o.push(0);
    o = o.push(1);
    o = o.push(0);
    return o;
}

// component_wrap embeds a core module's bytes in a component as a
// core-module section (component section id 1), returning the component
// binary. This is the structural envelope the canon / wasi layers build on.
function component_wrap(core: i32[]): i32[] {
    var o: i32[] = component_preamble();
    return wcat(o, wsection(1, core));
}

// component_full wraps a core module that exports `_lang_run` (the
// component entry: `() -> i32`, 0 = ok) into a complete `wasi:cli/run@0.2.0`
// component. Beyond the embedded core (section 1) the framing is constant
// for this fixed shape, so the six trailing sections are emitted verbatim
// (decoded from the reference component):
//   2  core-instance   — instantiate module 0, no args
//   6  alias           — core-instance 0 export "_lang_run" as a core func
//   7  component type  — `(result)` and `(func (result 0))`
//   8  canon           — lift core func 0 to the component func, type 1
//   5  instance        — an instance exporting "run" = func 0
//  11  export          — that instance as "wasi:cli/run@0.2.0"
function component_full(core: i32[]): i32[] {
    var o: i32[] = component_preamble();
    o = wcat(o, wsection(1, core));

    // 2 core-instance: vec(1)[ instantiate(0x00) module 0, 0 args ]
    o = wcat(o, wsection(2, [1, 0, 0, 0]));

    // 6 alias: vec(1)[ core(0) func(0) core-export(1) instance 0, name ]
    var al: i32[] = [1, 0, 0, 1, 0];
    al = wname(al, "_lang_run");
    o = wcat(o, wsection(6, al));

    // 7 component type: the two types `run` lifts to.
    o = wcat(o, wsection(7, [2, 106, 0, 0, 64, 0, 0, 0]));

    // 8 canon: vec(1)[ lift core func 0, no opts, type 1 ]
    o = wcat(o, wsection(8, [1, 0, 0, 0, 0, 1]));

    // 5 instance: vec(1)[ inline exports: "run" = func 0 ]
    var inst: i32[] = [1, 1, 1, 0];
    inst = wname(inst, "run");
    inst = inst.push(1);
    inst = inst.push(0);
    o = wcat(o, wsection(5, inst));

    // 11 export: vec(1)[ name "wasi:cli/run@0.2.0" = instance 0 ]
    var ex: i32[] = [1, 0];
    ex = wname(ex, "wasi:cli/run@0.2.0");
    ex = ex.push(5);
    ex = ex.push(0);
    ex = ex.push(0);
    o = wcat(o, wsection(11, ex));

    return o;
}

// ---- I/O (stdout) component framing -------------------------------------
//
// component_full_io wraps a core module that uses the preview2 stdout
// imports (wasi:cli/stdout/get-stdout + wasi:io/streams/
// [method]output-stream.blocking-write-and-flush) and exports `_lang_run`
// into a full wasi:cli/run component. The wasi type imports, the two
// canon-lower shim core modules, and the canon-lift/instance/export
// framing are constant for this fixed stdout shape, so — like the native
// compiler's precomputed component-type blob — they are embedded verbatim
// (as \xNN byte strings) around the core, which is spliced into the
// core-module section slot. (stdout only; file I/O would need more
// framing.)

// ---- per-interface component type-import blocks --------------------------
//
// Phase 1 of the generative component builder (docs/WASM-COMPONENT-GENERATOR.md):
// the I/O component prefix decomposes into one constant block per wasi
// interface, emitted in canonical order. Because canonical order fixes each
// block's type/instance indices, these blocks are reusable across shapes
// (e.g. tb_io_error is byte-identical at the head of every prefix). The
// component preamble is component_preamble(); these are the post-preamble
// type/import/alias sections.

// tb_io_error: the wasi:io/error interface (the `error` resource). Always the
// first type import (io/streams depends on it).
function tb_io_error(): string {
    return "\x07\x0d\x01\x42\x01\x04\x00\x05\x65\x72\x72\x6f\x72\x03\x01\x0a\x18\x01\x00\x13\x77\x61\x73\x69\x3a\x69\x6f\x2f\x65\x72\x72\x6f\x72\x40\x30\x2e\x32\x2e\x30\x05\x00\x06\x0a\x01\x03\x00\x00\x05\x65\x72\x72\x6f\x72";
}

// tb_io_streams_out: the wasi:io/streams interface exposing output-stream +
// blocking-write-and-flush + the stream-error variant (the output-only shape;
// the fs-read shapes additionally define input-stream).
function tb_io_streams_out(): string {
    return "\x07\xb2\x01\x01\x42\x0b\x04\x00\x0d\x6f\x75\x74\x70\x75\x74\x2d\x73\x74\x72\x65\x61\x6d\x03\x01\x02\x03\x02\x01\x01\x04\x00\x05\x65\x72\x72\x6f\x72\x03\x00\x01\x01\x69\x02\x01\x71\x02\x15\x6c\x61\x73\x74\x2d\x6f\x70\x65\x72\x61\x74\x69\x6f\x6e\x2d\x66\x61\x69\x6c\x65\x64\x01\x03\x00\x06\x63\x6c\x6f\x73\x65\x64\x00\x00\x04\x00\x0c\x73\x74\x72\x65\x61\x6d\x2d\x65\x72\x72\x6f\x72\x03\x00\x04\x01\x68\x00\x01\x70\x7d\x01\x6a\x00\x01\x05\x01\x40\x02\x04\x73\x65\x6c\x66\x06\x08\x63\x6f\x6e\x74\x65\x6e\x74\x73\x07\x00\x08\x04\x00\x2e\x5b\x6d\x65\x74\x68\x6f\x64\x5d\x6f\x75\x74\x70\x75\x74\x2d\x73\x74\x72\x65\x61\x6d\x2e\x62\x6c\x6f\x63\x6b\x69\x6e\x67\x2d\x77\x72\x69\x74\x65\x2d\x61\x6e\x64\x2d\x66\x6c\x75\x73\x68\x01\x09\x0a\x1a\x01\x00\x15\x77\x61\x73\x69\x3a\x69\x6f\x2f\x73\x74\x72\x65\x61\x6d\x73\x40\x30\x2e\x32\x2e\x30\x05\x02\x06\x12\x01\x03\x00\x01\x0d\x6f\x75\x74\x70\x75\x74\x2d\x73\x74\x72\x65\x61\x6d";
}

// tb_io_streams_inout: the wasi:io/streams interface exposing BOTH output- and
// input-stream (+ blocking-write-and-flush / the stream-error variant) -- the
// shape the fs-read prefixes use (vs tb_io_streams_out for write/stdout only).
function tb_io_streams_inout(): string { return "\x07\x83\x02\x01\x42\x10\x04\x00\x0d\x6f\x75\x74\x70\x75\x74\x2d\x73\x74\x72\x65\x61\x6d\x03\x01\x04\x00\x0c\x69\x6e\x70\x75\x74\x2d\x73\x74\x72\x65\x61\x6d\x03\x01\x02\x03\x02\x01\x01\x04\x00\x05\x65\x72\x72\x6f\x72\x03\x00\x02\x01\x69\x03\x01\x71\x02\x15\x6c\x61\x73\x74\x2d\x6f\x70\x65\x72\x61\x74\x69\x6f\x6e\x2d\x66\x61\x69\x6c\x65\x64\x01\x04\x00\x06\x63\x6c\x6f\x73\x65\x64\x00\x00\x04\x00\x0c\x73\x74\x72\x65\x61\x6d\x2d\x65\x72\x72\x6f\x72\x03\x00\x05\x01\x68\x00\x01\x68\x01\x01\x70\x7d\x01\x6a\x00\x01\x06\x01\x6a\x01\x09\x01\x06\x01\x40\x02\x04\x73\x65\x6c\x66\x07\x08\x63\x6f\x6e\x74\x65\x6e\x74\x73\x09\x00\x0a\x04\x00\x2e\x5b\x6d\x65\x74\x68\x6f\x64\x5d\x6f\x75\x74\x70\x75\x74\x2d\x73\x74\x72\x65\x61\x6d\x2e\x62\x6c\x6f\x63\x6b\x69\x6e\x67\x2d\x77\x72\x69\x74\x65\x2d\x61\x6e\x64\x2d\x66\x6c\x75\x73\x68\x01\x0c\x01\x40\x02\x04\x73\x65\x6c\x66\x08\x03\x6c\x65\x6e\x77\x00\x0b\x04\x00\x22\x5b\x6d\x65\x74\x68\x6f\x64\x5d\x69\x6e\x70\x75\x74\x2d\x73\x74\x72\x65\x61\x6d\x2e\x62\x6c\x6f\x63\x6b\x69\x6e\x67\x2d\x72\x65\x61\x64\x01\x0d\x0a\x1a\x01\x00\x15\x77\x61\x73\x69\x3a\x69\x6f\x2f\x73\x74\x72\x65\x61\x6d\x73\x40\x30\x2e\x32\x2e\x30\x05\x02\x06\x12\x01\x03\x00\x01\x0d\x6f\x75\x74\x70\x75\x74\x2d\x73\x74\x72\x65\x61\x6d\x06\x11\x01\x03\x00\x01\x0c\x69\x6e\x70\x75\x74\x2d\x73\x74\x72\x65\x61\x6d"; }

// fs prefix tails: the filesystem/types + filesystem/preopens + cli/stdout
// blocks specific to each fs shape (index-shifted, so per-shape), appended to
// the shared io/error + io/streams head.
function fs_read_tail(): string { return "\x07\xc8\x06\x01\x42\x14\x04\x00\x0a\x64\x65\x73\x63\x72\x69\x70\x74\x6f\x72\x03\x01\x02\x03\x02\x01\x04\x04\x00\x0c\x69\x6e\x70\x75\x74\x2d\x73\x74\x72\x65\x61\x6d\x03\x00\x01\x01\x6d\x25\x06\x61\x63\x63\x65\x73\x73\x0b\x77\x6f\x75\x6c\x64\x2d\x62\x6c\x6f\x63\x6b\x07\x61\x6c\x72\x65\x61\x64\x79\x0e\x62\x61\x64\x2d\x64\x65\x73\x63\x72\x69\x70\x74\x6f\x72\x04\x62\x75\x73\x79\x08\x64\x65\x61\x64\x6c\x6f\x63\x6b\x05\x71\x75\x6f\x74\x61\x05\x65\x78\x69\x73\x74\x0e\x66\x69\x6c\x65\x2d\x74\x6f\x6f\x2d\x6c\x61\x72\x67\x65\x15\x69\x6c\x6c\x65\x67\x61\x6c\x2d\x62\x79\x74\x65\x2d\x73\x65\x71\x75\x65\x6e\x63\x65\x0b\x69\x6e\x2d\x70\x72\x6f\x67\x72\x65\x73\x73\x0b\x69\x6e\x74\x65\x72\x72\x75\x70\x74\x65\x64\x07\x69\x6e\x76\x61\x6c\x69\x64\x02\x69\x6f\x0c\x69\x73\x2d\x64\x69\x72\x65\x63\x74\x6f\x72\x79\x04\x6c\x6f\x6f\x70\x0e\x74\x6f\x6f\x2d\x6d\x61\x6e\x79\x2d\x6c\x69\x6e\x6b\x73\x0c\x6d\x65\x73\x73\x61\x67\x65\x2d\x73\x69\x7a\x65\x0d\x6e\x61\x6d\x65\x2d\x74\x6f\x6f\x2d\x6c\x6f\x6e\x67\x09\x6e\x6f\x2d\x64\x65\x76\x69\x63\x65\x08\x6e\x6f\x2d\x65\x6e\x74\x72\x79\x07\x6e\x6f\x2d\x6c\x6f\x63\x6b\x13\x69\x6e\x73\x75\x66\x66\x69\x63\x69\x65\x6e\x74\x2d\x6d\x65\x6d\x6f\x72\x79\x12\x69\x6e\x73\x75\x66\x66\x69\x63\x69\x65\x6e\x74\x2d\x73\x70\x61\x63\x65\x0d\x6e\x6f\x74\x2d\x64\x69\x72\x65\x63\x74\x6f\x72\x79\x09\x6e\x6f\x74\x2d\x65\x6d\x70\x74\x79\x0f\x6e\x6f\x74\x2d\x72\x65\x63\x6f\x76\x65\x72\x61\x62\x6c\x65\x0b\x75\x6e\x73\x75\x70\x70\x6f\x72\x74\x65\x64\x06\x6e\x6f\x2d\x74\x74\x79\x0e\x6e\x6f\x2d\x73\x75\x63\x68\x2d\x64\x65\x76\x69\x63\x65\x08\x6f\x76\x65\x72\x66\x6c\x6f\x77\x0d\x6e\x6f\x74\x2d\x70\x65\x72\x6d\x69\x74\x74\x65\x64\x04\x70\x69\x70\x65\x09\x72\x65\x61\x64\x2d\x6f\x6e\x6c\x79\x0c\x69\x6e\x76\x61\x6c\x69\x64\x2d\x73\x65\x65\x6b\x0e\x74\x65\x78\x74\x2d\x66\x69\x6c\x65\x2d\x62\x75\x73\x79\x0c\x63\x72\x6f\x73\x73\x2d\x64\x65\x76\x69\x63\x65\x04\x00\x0a\x65\x72\x72\x6f\x72\x2d\x63\x6f\x64\x65\x03\x00\x03\x01\x6e\x01\x0e\x73\x79\x6d\x