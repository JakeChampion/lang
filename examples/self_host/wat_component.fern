// io_stdout_head: preamble + io/error + io/streams(out) + cli/stdout -- the
// component prefix shared by every stdout-writing single-import shape, composed
// from the per-interface type blocks.
function io_stdout_head(): i32[] {
    var o: i32[] = component_preamble();
    o = wcat(o, blob_to_bytes(tb_io_error()));
