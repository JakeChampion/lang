// examples/self_host/symtab.fern — the symbol intern table (#4394 lever 1,
// foundation slice; see docs/SELFHOST-SYMBOL-INTERNING.md).
//
// SymTab maps a name to a small stable i32 symbol id, storing each distinct name
// exactly once. It is the building block for turning the self-host compiler's
// dominant compare-heavy, churn-heavy identifier / mangled-name string traffic
// (lexer scan_ident, flatten mangle_bare, and the `Op.str` fields that ride the
// persistent op-stream arrays per docs/IR-SELFCOMPILE-OOM-FINDINGS.md) into i32
// ops. This slice adds the table + its round-trip / equality contract; later
// slices thread it through the pipeline and move `Op.str` onto ids.
//
// Representation: a `string[]` (id -> name) with a linear-scan lookup, matching
// how the compiler already models every other symbol-ish set (util.index_of_str
// is used ~100× in irlower alone). A `Map[string, i32]` index is a drop-in
// follow-up behind this exact intern/name_of contract, and since #6993 slice
// four there is nothing left to prove about `core/map` in the compiler's own
// sources — irverify's NameIndex is one. What is still deferred is the
// measurement (docs/SELFHOST-SYMBOL-INTERNING.md): this table is not yet
// consumed by the pipeline, so no profile calls for it.
//
// Threaded functionally like Lex / EmitState: intern returns the (possibly
// extended) table alongside the id, so a caller does `var r = t.intern(n); t =
// r.tab;`.

import "./util";

// SymTab holds the interned names in id order (names[id] == the name for id).
pub struct SymTab { names: string[] }

// InternResult carries the extended table plus the id assigned to the name.
pub struct InternResult { tab: SymTab, id: i32 }

// symtab_new returns an empty table. Ids start at 0 and are dense.
pub function symtab_new(): SymTab {
    return SymTab { names: [] };
}

// lookup returns the id of an already-interned name, or -1 if absent. It never
// inserts — use intern to add.
pub function (t: SymTab) lookup(name: string): i32 {
    return util.index_of_str(t.names, name);
}

// intern returns the id for name, inserting it (stored once) on first sight; a
// repeated name returns its existing id and the table unchanged. The id is stable
// for the life of the table.
pub function (t: SymTab) intern(name: string): InternResult {
    var existing: i32 = util.index_of_str(t.names, name);
    if (existing >= 0) { return InternResult { tab: t, id: existing }; }
    var id: i32 = t.names.len();
    return InternResult { tab: SymTab { names: t.names.append(name) }, id: id };
}

// name_of is the inverse of intern: the stored name for id, or "" if id is out of
// range. name_of(intern(s).id) == s for every s.
pub function (t: SymTab) name_of(id: i32): string {
    if (id < 0 || id >= t.names.len()) { return ""; }
    return t.names[id];
}

// count is the number of distinct interned names.
pub function (t: SymTab) count(): i32 {
    return t.names.len();
}
