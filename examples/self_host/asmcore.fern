        _ => { return false; }
    }
    return false;
}

pub function is_fn(t: Ty): boolean {
    match (t) {
        TyFn(_) => { return true; },
        TyFnAny(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_i32(t: Ty): boolean {
    match (t) {
        TyI32(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_u32(t: Ty): boolean {
    match (t) {
        TyU32(_) => { return true; },
        _ => { return false; }
    }
    return false;
