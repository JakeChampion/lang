import "./lexer";
import "./parser";
import "./astwalk";
import "./util";

// asmcore — the target-independent frontend shared by the x86-64
// (asm.fern) and arm64 (asm_arm64.fern) text emitters: the Ty type
// system, EmitState + its state methods, the free-variable walker,
// type inference (infer_expr_type / match_payload_type / field +
// struct tag resolution) and the pre-codegen checker. The backends
// import this and add only their instruction-selection (emit_*).
// Extracted to end the hand-maintained lockstep between the two
// backends — this code now lives once.

// base_type_name -> util.base_type_name (SH-020).

pub function sanitize_label(name: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < name.len()) {
        var b: i32 = name[i];
        if (b == 46) { out = out + "__"; }
        else { out = out + name[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

// i32_to_string now lives in util.fern (imported as `util`). See SH-020.

// digits_to_i32 now lives in util.fern (imported as `util`). See SH-020.

// is_all_digits now lives in util.fern (imported as `util`). See SH-020.

// has_str -> util.has_str (SH-020).

// collect_idents_expr -> astwalk.collect_idents_expr (SH-022).

// collect_idents_stmt -> astwalk.collect_idents_stmt (SH-022).

// collect_bound_stmt -> astwalk.collect_bound_stmt (SH-022).

pub function lambda_captures(lm: parser.ExprLambda, outer: EmitState): string[] {
    var refs: string[] = [];
    var bi: i32 = 0;
    while (bi < lm.body.len()) {
        refs = astwalk.collect_idents_stmt(lm.body[bi], refs);
        bi = bi + 1;
    }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lm.params.len()) {
        bound = bound.append(lm.params[pi].name);
        pi = pi + 1;
    }
    var si: i32 = 0;
    while (si < lm.body.len()) {
        bound = astwalk.collect_bound_stmt(lm.body[si], bound);
        si = si + 1;
    }
    var caps: string[] = [];
    var ri: i32 = 0;
    while (ri < refs.len()) {
        var nm: string = refs[ri];
        if (!util.has_str(bound, nm) && !util.has_str(caps, nm) && outer.has_local(nm)) {
            caps = caps.append(nm);
        }
        ri = ri + 1;
    }
    return caps;
}

pub struct EmitState {
    out: string,
    label_n: i32,
    local_names: string[],
    in_function: boolean,
    string_lits: string[],
    // needed: the set of runtime-library helpers this module
    // requests, by name. Populated via need() / the mark_*
    // wrappers; emit_module consults has_need() to decide which
    // helper bodies to append. Replaces ~26 parallel needs_*
    // booleans — see asm.fern for the rationale.
    needed: string[],
    struct_decls: parser.StructDecl[],
    // loop_exit_labels / loop_cont_labels: see asm.fern for
    // semantics. break / continue use the top of each stack.
    loop_exit_labels: string[],
    loop_cont_labels: string[],
    // funcs: the module's FuncDecls — used by method dispatch
    // in ExprCall(ExprFieldAccess(...), args).
    funcs: parser.FuncDecl[],
    // local_types: parallel to local_names. See asm.fern.
    local_types: Ty[],
    // n_params: count of leading local_names slots that are the
    // function's receiver + parameters (bound first by emit_function).
    // The Perceus function-exit dec sweep skips these — parameters are
    // BORROWED (the caller still owns them), so the callee must not
    // release them. Set per function after the params are bound.
    n_params: i32,
    // use_ir: when set, emit_module (x86-64) routes a fully-IR-eligible module
    // through the stack-IR code path (asm_ir.emit_module_ir) instead of the
    // AST emitter — the IR rebuild's parallel-path migration
    // (docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md §3). Now DEFAULT ON: the x86-64
    // self-host default emits from the IR (with asm.fern's array layout + full
    // Perceus RC) for the i32 + arrays subset; mixed / out-of-subset modules
    // (strings, structs, methods, …) fall back to the AST emitter, so the
    // compiler itself still compiles via AST and the byte-identical fixpoint
    // holds. Only asm.fern reads this — arm64 / wasm keep their AST paths.
    use_ir: boolean,
    // str_ns: per-module namespace for string-literal `.rodata` labels, for
    // per-module translation-unit emit (#3451 step 3 / #3455). Empty (the
    // default / whole-program case) keeps the label `.S<idx>`; a non-empty ns
    // makes it `.S<ns>_<idx>` so two separately-emitted modules' string pools
    // don't collide at link. The IR backend reads this via str_lit_label.
    str_ns: string,
    // shape_lits: the distinct enum/struct SHAPE names this unit references as a
    // shape pointer (struct_make / variant_is / dyn dispatch). Per-module
    // (str_ns != ""), a shape is emitted as a `.weak` global symbol
    // (`__fern_shp_<sanitized>`) instead of a unit-local `.S<ns>_<idx>` string, so
    // the SAME shape interned in two units resolves to ONE linker-merged address —
    // pointer-equality shape discrimination then works across the module boundary
    // (a token constructed in lexer matches in parser). Empty / unused on the
    // whole-program (str_ns == "") path, which keeps interning shapes as ordinary
    // string literals (byte-identical).
    shape_lits: string[]
}

pub function new_state(): EmitState {
    var ns: string[] = [];
    var sl: string[] = [];
    var lex: string[] = [];
    var lcn: string[] = [];
    var fns: parser.FuncDecl[] = [];
    var lts: Ty[] = [];
    var nd: string[] = [];
    return EmitState {
        out: "",
        label_n: 0,
        local_names: ns,
        in_function: false,
        string_lits: sl,
        needed: nd,
        struct_decls: [],
        loop_exit_labels: lex,
        loop_cont_labels: lcn,
        funcs: fns,
        local_types: lts,
        n_params: 0,
        // Default ON (x86-64): a fully-IR-eligible module (i32 + arrays, full
        // Perceus RC) compiles through asm_ir.emit_module_ir; everything else
        // (strings/structs/methods/maps/floats/closures) falls back to the AST
        // emitter. The IR path now uses asm.fern's OWN array layout + RC
        // helpers (8-byte __fern_arr_box, __fn___fern_rc_inc/__fn___fern_arr_dec)
        // and implements the full array Perceus lifecycle — alias-inc,
        // move-on-return, borrowed params, the exit dec-sweep, and reassignment
        // retain + cow-guarded release — so it is a drop-in for asm.fern's
        // array RC (the self_host_rc_runtime asm patterns match). The compiler
        // is not all_eligible (it is full of strings/structs), so it still
        // compiles via AST and the byte-identical fixpoint holds.
        use_ir: true,
        // Whole-program default: no namespace, so string labels stay `.S<idx>`
        // (byte-identical to the pre-per-module emitter). Per-module unit emit
        // sets this to keep each module's `.rodata` pool collision-free.
        str_ns: "",
        shape_lits: []
    };
}

// add_shape_lit records `name` as a shape this unit references (deduped), for the
// per-module weak-symbol shape emission (#3451). The returned symbol — the SAME
// for `name` in every unit — is what struct_make / variant_is / dyn dispatch leaq
// instead of a unit-local string label; emit_module_ir_unit emits each recorded
// shape once as `.weak __fern_shp_<sanitized>` so the linker merges the copies.
pub function add_shape_lit(s: EmitState, name: string): EmitState {
    var i: i32 = 0;
    while (i < s.shape_lits.len()) {
        if (s.shape_lits[i] == name) { return s; }
        i = i + 1;
    }
    return EmitState { ...s, shape_lits: s.shape_lits.append(name) };
}

// shape_sym is the deterministic global symbol for a shape name (the linker-merged
// weak symbol the per-module path uses for shape pointers). Stable across units so
// two units' references to the same shape resolve to one address.
pub function shape_sym(name: string): string {
    return "__fern_shp_" + sanitize_label(name);
}

pub function (s: EmitState) write(text: string): EmitState {
    // O(N) amortised: route through the global strbuf primitive
    // instead of `s.out + text` (which is O(N²) — fatal for self-
    // hosting). The .out field stays "" through the build; the
    // accumulated bytes live in the strbuf until emit_module's
    // tail calls strbuf_take to materialise the final string.
    // Mirrors the x86-64 backend (asm.fern).
    strbuf_append(text);
    return EmitState { ...s };
}

pub function (s: EmitState) bind_local(name: string): EmitState {
    return s.bind_local_typed(name, ty_unknown());
}

pub function (s: EmitState) bind_local_typed(name: string, ty: Ty): EmitState {
    var ln: string[] = s.local_names.append(name);
    var lts: Ty[] = s.local_types.append(ty);
    return EmitState { ...s, local_names: ln, local_types: lts };
}

pub function (s: EmitState) local_type_of(name: string): Ty {
    var i: i32 = s.local_names.len() - 1;
    while (i >= 0) {
        if (s.local_names[i] == name) { return s.local_types[i]; }
        i = i - 1;
    }
    return ty_unknown();
}

pub function (s: EmitState) mark_str_concat(): EmitState {
    return s.need("heap").need("str_concat");
}

// rt_src_str_concat backs `+` on strings (#2649), via the raw-memory intrinsic
// floor (docs/RUNTIME-INTRINSICS.md). Size lenA+lenB, alloc the buffer, copy A
// then B byte-by-byte (__raw_store8 of a[i]/b[j]), box it (__raw_string). Tier-2
// (builds a fresh buffer); the intrinsics lower to single instructions + one
// __fern_alloc, so heap is its sole dep (mark_str_concat). No string `+` inside,
// so no self-recursion. Empty operands → a 0-length copy loop, correct.
pub function rt_src_str_concat(): string {
    return "function __fern_str_concat(a: string, b: string): string { var la: i32 = a.len(); var lb: i32 = b.len(); var p: i32 = __raw_alloc(la + lb); var i: i32 = 0; while (i < la) { __raw_store8(p, i, a[i]); i = i + 1; } var j: i32 = 0; while (j < lb) { __raw_store8(p, la + j, b[j]); j = j + 1; } return __raw_string(p, la + lb); }";
}

pub function (s: EmitState) mark_str_eq(): EmitState {
    return s.need("str_eq");
}

pub function (s: EmitState) mark_str_print(): EmitState {
    return s.need("str_print");
}

pub function (s: EmitState) mark_str_cmp(): EmitState {
    return s.need("str_cmp");
}

pub function (s: EmitState) mark_str_read_line(): EmitState {
    return s.need("heap").need("str_read_line");
}

pub function (s: EmitState) mark_i32_to_string(): EmitState {
    return s.need("heap").need("i32_to_string");
}

// rt_src_i32_to_string backs (n).to_string() / the i32_to_string free fn (#2649),
// via the raw-memory intrinsic floor (docs/RUNTIME-INTRINSICS.md). Count digits,
// alloc exactly nd(+1 for '-') bytes, fill from the end (units last), prepend '-'
// for negatives. Tier-2 (digit buffer); heap is its sole dep. n==0 → "0".
// (INT_MIN's 0-n overflow matches the hand-asm's negq — no behaviour change.)
pub function rt_src_i32_to_string(): string {
    return "function __fern_i32_to_string(n: i32): string { if (n == 0) { var z: i32 = __raw_alloc(1); __raw_store8(z, 0, 48); return __raw_string(z, 1); } var neg: i32 = 0; var v: i32 = n; if (v < 0) { neg = 1; v = 0 - v; } var nd: i32 = 0; var t: i32 = v; while (t > 0) { nd = nd + 1; t = t / 10; } var total: i32 = nd + neg; var p: i32 = __raw_alloc(total); if (neg == 1) { __raw_store8(p, 0, 45); } var i: i32 = total - 1; while (v > 0) { __raw_store8(p, i, 48 + (v % 10)); v = v / 10; i = i - 1; } return __raw_string(p, total); }";
}

pub function (s: EmitState) mark_u32_to_string(): EmitState {
    return s.need("heap").need("u32_to_string");
}

// rt_src_u32_to_string backs (n).to_string() on a u32 value (#2649). The signed
// __fern_i32_to_string can't format a u32 with bit 31 set (it reads the low 32
// bits as a negative i32), so a u32 receiver routes here instead. The magnitude
// is recovered UNSIGNED as `(n as i64) & 0xFFFFFFFF` — correct no matter how the
// caller extended the 32-bit value into its 8-byte arg slot (sign- or zero-
// extended) — then formatted with i64 digit arithmetic (values up to
// 4294967295 exceed i32). Heap is its sole dep. n==0 → \"0\". Never negative, so
// no sign branch. Import-free: it is a runtime helper, so u32.to_string works
// without `import \"std/u32\"` exactly as the i32 builtin did.
pub function rt_src_u32_to_string(): string {
    return "function __fern_u32_to_string(n: i32): string { var v: i64 = (n as i64) & (4294967295 as i64); if (v == (0 as i64)) { var z: i32 = __raw_alloc(1); __raw_store8(z, 0, 48); return __raw_string(z, 1); } var nd: i32 = 0; var t: i64 = v; while (t > (0 as i64)) { nd = nd + 1; t = t / (10 as i64); } var p: i32 = __raw_alloc(nd); var i: i32 = nd - 1; while (v > (0 as i64)) { __raw_store8(p, i, 48 + ((v % (10 as i64)) as i32)); v = v / (10 as i64); i = i - 1; } return __raw_string(p, nd); }";
}

pub function (s: EmitState) mark_i64_to_string(): EmitState {
    return s.need("heap").need("i64_to_string");
}

// rt_src_i64_to_string backs (n).to_string() on an i64 receiver. The old
// is_int_tag shortcut sent 64-bit receivers to __fern_i32_to_string, which
// reads only the low 32 bits of its arg slot — a wide value silently
// truncated (1234567890123 → 1912276171, its low-32 reading). The magnitude
// is formatted with UNSIGNED u64 digit arithmetic (the divq path), which
// also makes the INT64_MIN negation exact: `(0 as i64) - n` wraps to
// INT64_MIN, whose u64 reading is 2^63 — the true magnitude. The same trick
// core/int's __int_to_string_u64 uses. Heap is its sole dep. Import-free:
// i64.to_string works without `import \"std/i64\"`, as the i32 builtin did.
pub function rt_src_i64_to_string(): string {
    return "function __fern_i64_to_string(n: i64): string { var neg: i32 = 0; var m: i64 = n; if (n < (0 as i64)) { neg = 1; m = (0 as i64) - n; } var v: u64 = m as u64; if (v == (0 as u64)) { var z: i32 = __raw_alloc(1); __raw_store8(z, 0, 48); return __raw_string(z, 1); } var nd: i32 = 0; var t: u64 = v; while (t != (0 as u64)) { nd = nd + 1; t = t / (10 as u64); } var total: i32 = nd + neg; var p: i32 = __raw_alloc(total); if (neg == 1) { __raw_store8(p, 0, 45); } var i: i32 = total - 1; while (v != (0 as u64)) { __raw_store8(p, i, 48 + ((v % (10 as u64)) as i32)); v = v / (10 as u64); i = i - 1; } return __raw_string(p, total); }";
}

pub function (s: EmitState) mark_u64_to_string(): EmitState {
    return s.need("heap").need("u64_to_string");
}

// rt_src_u64_to_string backs (n).to_string() on a u64 receiver — the full
// unsigned 64-bit range, so a value with bit 63 set formats as its true
// magnitude rather than a negative i64 reading. Pure u64 digit loop
// (unsigned divq). Heap is its sole dep; never negative, so no sign
// branch. Import-free like the u32 sibling.
pub function rt_src_u64_to_string(): string {
    return "function __fern_u64_to_string(n: u64): string { var v: u64 = n; if (v == (0 as u64)) { var z: i32 = __raw_alloc(1); __raw_store8(z, 0, 48); return __raw_string(z, 1); } var nd: i32 = 0; var t: u64 = v; while (t != (0 as u64)) { nd = nd + 1; t = t / (10 as u64); } var p: i32 = __raw_alloc(nd); var i: i32 = nd - 1; while (v != (0 as u64)) { __raw_store8(p, i, 48 + ((v % (10 as u64)) as i32)); v = v / (10 as u64); i = i - 1; } return __raw_string(p, nd); }";
}

pub function (s: EmitState) mark_str_to_i32(): EmitState {
    return s.need("str_to_i32");
}

// chr(n): i32 byte -> 1-char string box. Allocates, so pull in the heap.
pub function (s: EmitState) mark_chr(): EmitState {
    return s.need("heap").need("chr");
}

// rt_src_chr backs `chr(b)` (#2649) — the first Tier-2 helper written in Fern via
// the raw-memory intrinsic floor (docs/RUNTIME-INTRINSICS.md). Allocate 1 byte,
// store the low byte of b, box it back into a string. The whole Tier-2 vocabulary
// (alloc, store a byte, box) in one helper — the end-to-end proof the floor works
// through a real runtime helper. The intrinsics lower to single instructions
// (+ one __fern_alloc), so chr's only dep stays `heap` (mark_chr).
pub function rt_src_chr(): string {
    return "function __fern_chr(b: i32): string { var p: i32 = __raw_alloc(1); __raw_store8(p, 0, b); return __raw_string(p, 1); }";
}

// rt_src_random_bytes backs `random_bytes(n)` (#2649) — the first syscall-leaf
// helper written in Fern, over the syscall sub-floor (docs/RUNTIME-INTRINSICS.md
// step 5). Allocate n bytes, fill them from getrandom(buf, n, 0) (x86-64
// syscall 318), box the buffer back into a string. The `__syscall3` result (the
// byte count) is discarded — the audited leaf trusts a blocking getrandom of a
// small n. Only dep is `heap` (mark_random_bytes pulls it). x86-64-only: the
// getrandom syscall number is arch-specific (arm64 = 278) and wasm has no
// generic syscall, so those backends keep their hand-asm/WASI bundle for now.
pub function rt_src_random_bytes(): string {
    return "function __fern_random_bytes(n: i32): string { var p: i32 = __raw_alloc(n); __syscall3(318, p, n, 0); return __raw_string(p, n); }";
}

// rt_src_read_file backs `read_file(path)` (#2649, syscall-leaf) → Result[string,
// IoError]. NUL-terminate the path, openat(AT_FDCWD, path, O_RDONLY=0) (syscall
// 257; mode ignored for O_RDONLY so __syscall3 suffices), lseek-size the file
// (syscall 8), read the whole thing in ONE read into a sized buffer that BECOMES
// the returned string (RC-managed, like random_bytes), close. Err(NotFound(_)) on
// open/read failure — a FRESH string boxed from the raw path copy, not the
// borrowed `path`. Single-read (no offset-into-buffer arithmetic, which the i32
// raw-pointer floor can't do 64-bit-safely on a high heap buffer): correct for
// regular files ≤ 2 GiB read without interruption, which covers the use (the
// compiler reading source). x86-64-only (arch-specific syscall numbers).
pub function rt_src_read_file(): string {
    return "function __fern_read_file(path: string): Result[string, IoError] { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var fd: i32 = __syscall3(257, -100, pathz, 0); if (fd < 0) { return Err(NotFound(__raw_string(pathz, plen))); } var size: i32 = __syscall3(8, fd, 0, 2); __syscall3(8, fd, 0, 0); var buf: i32 = __raw_alloc(size + 1); var got: i32 = __syscall3(0, fd, buf, size); __syscall3(3, fd, 0, 0); if (got < 0) { return Err(NotFound(__raw_string(pathz, plen))); } return Ok(__raw_string(buf, got)); }";
}

// rt_src_clock backs the clock builtins (#2649, syscall-leaf slice 2): `which`
// selects monotonic_ns / now_ns / now_unix_ms. Each reads a `timespec { i64
// tv_sec; i64 tv_nsec }` from clock_gettime (x86-64 syscall 228) into the fixed
// static scratch buffer (no per-call leak — the buffer is reused), then does i64
// math. CLOCK_MONOTONIC = 1, CLOCK_REALTIME = 0. Allocation-free (scratch is
// static, not heap), so these emit independently of the heap runtime. One
// compiler function for the three helpers keeps the merged-bundle self-compile
// under its function budget (#3425). x86-64-only: the clock_gettime syscall
// number is arch-specific (arm64 = 113), so arm64/AST keep their hand-asm; wasm
// has no generic syscall.
pub function rt_src_clock(which: string): string {
    if (which == "monotonic_ns") {
        return "function __fern_monotonic_ns(): i64 { var ts: i32 = __raw_scratch(16); __syscall3(228, 1, ts, 0); var sec: i64 = __load_i64(ts); var nsec: i64 = __load_i64(ts + 8); return sec * (1000000000 as i64) + nsec; }";
    }
    if (which == "now_unix_ms") {
        return "function __fern_now_unix_ms(): i64 { var ts: i32 = __raw_scratch(16); __syscall3(228, 0, ts, 0); var sec: i64 = __load_i64(ts); var nsec: i64 = __load_i64(ts + 8); return sec * (1000 as i64) + nsec / (1000000 as i64); }";
    }
    return "function __fern_now_ns(): i64 { var ts: i32 = __raw_scratch(16); __syscall3(228, 0, ts, 0); var sec: i64 = __load_i64(ts); var nsec: i64 = __load_i64(ts + 8); return sec * (1000000000 as i64) + nsec; }";
}

// rt_src_stat backs `stat(path)` (#2649) — the first syscall leaf returning a
// user-typed Result[FileStat, IoError]. NUL-terminate the path, stat(2) (syscall
// 4, follows symlinks — 2-arg, so __syscall3 suffices) into the fixed static
// scratch buffer, read st_mode (offset 24, 4 bytes) + st_size (offset 48, 8
// bytes) via __load_i32/__load_i64, classify by S_IFMT, and build
// Ok(FileStat{...}) — or, on failure, the IoError variant native's __fern_io_error
// (and the retired hand-asm __fern_stat) map the errno to: ENOENT(2) → NotFound,
// EACCES(13) → PermissionDenied, EEXIST(17) → AlreadyExists, EINTR(4) →
// Interrupted, else → Other(path, ""). This restores the full mapping the initial
// migration (#5243) had flattened to NotFound-only. The path-carrying variants
// box a FRESH string from the raw NUL-term copy (not the borrowed `path`), so the
// Ok path never stores `path` either and it stays a borrowed read-only param —
// no RC double-free. The FileStat struct + Result/variant construction lower
// through the normal IR path (emit_ir_runtime_fern_fn receives all_structs).
// x86-64-only (arch-specific syscall number); arm64/AST keep their hand-asm.
pub function rt_src_stat(): string {
    return "function __fern_stat(path: string): Result[FileStat, IoError] { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var buf: i32 = __raw_scratch(160); var rc: i32 = __syscall3(4, pathz, buf, 0); if (rc < 0) { var e: i32 = 0 - rc; if (e == 4) { return Err(Interrupted); } var ep: string = __raw_string(pathz, plen); if (e == 2) { return Err(NotFound(ep)); } if (e == 13) { return Err(PermissionDenied(ep)); } if (e == 17) { return Err(AlreadyExists(ep)); } return Err(Other(ep, \"\")); } var mode: i32 = __load_i32(buf + 24); var size: i64 = __load_i64(buf + 48); var mfmt: i32 = mode & 61440; var isf: boolean = mfmt == 32768; var isd: boolean = mfmt == 16384; return Ok(FileStat { is_file: isf, is_dir: isd, size: size }); }";
}

