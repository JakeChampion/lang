    return s.need("heap").need("arr_slice");
}

pub function (s: EmitState) mark_arr_i32_index_of(): EmitState {
    return s.need("arr_i32_index_of");
}

pub function (s: EmitState) mark_arr_reverse(): EmitState {
    return s.need("heap").need("arr_reverse");
}

// mark_str_from_bytes gates the Fern __fern_string_from_bytes runtime function
// (#2649) on its own str_from_bytes need. The AST call sites previously only
// marked heap (the hand-asm body rode the always-emitted heap block); the Fern
// body is now emitted in the migrated-helpers section like the string builders.
pub function (s: EmitState) mark_str_from_bytes(): EmitState {
    return s.need("heap").need("str_from_bytes");
}

// rt_src_string_from_bytes backs `string_from_bytes(arr)` (#2649) — pack each
// array element's low byte into a fresh string, via the raw-memory intrinsic
// floor. The parameter is typed i32[] (all self-host arrays use 8-byte element
// slots, so a u8[] argument round-trips identically): a[i] reads the slot,
// __raw_store8 keeps its low byte. Heap is its sole dep. Empty array → "".
pub function rt_src_string_from_bytes(): string {
    return "function __fern_string_from_bytes(a: i32[]): string { var n: i32 = a.len(); var p: i32 = __raw_alloc(n); var i: i32 = 0; while (i < n) { __raw_store8(p, i, a[i]); i = i + 1; } return __raw_string(p, n); }";
}

pub function (s: EmitState) mark_arr_concat(): EmitState {
    return s.need("heap").need("arr_concat");
}

pub function (s: EmitState) mark_arr_str_index_of(): EmitState {
    return s.need("str_eq").need("arr_str_index_of");
}

pub function (s: EmitState) mark_arr_str_join(): EmitState {
    return s.need("heap").need("str_concat").need("arr_str_join");
}

pub function (s: EmitState) mark_arr_i32_sum(): EmitState {
    return s.need("arr_i32_sum");
}

pub function (s: EmitState) mark_arr_i32_min_max(): EmitState {
    return s.need("arr_i32_min_max");
}

pub function (s: EmitState) mark_arr_i32_product(): EmitState {
    return s.need("arr_i32_product");
}

// str_chars's helper builds the result array with `.append()`. On the AST path
// that lowers to __fern_arr_push; on the IR path the ownership analysis sees `r`
// as a sole-owner local being reassigned and uses the reclaim-on-grow variant
// __fern_arr_push_owned, so both symbols must be present. The AST emit path has no
// close_needs, so mark both directly; runtime_need_deps declares the same edges
// for the IR path's close_needs (arr_push_owned → arr_push).
pub function (s: EmitState) mark_str_chars(): EmitState {
    return s.need("heap").need("arr_push").need("arr_push_owned").need("str_chars");
}

// str_lines's helper calls str_split (split on '\n') and arr_slice (drop the
// trailing empty entry). The AST emit path has no close_needs, so mark the
// transitive deps directly — same shape as mark_arr_str_join. runtime_need_deps
// declares the same edges for the IR path's close_needs.
pub function (s: EmitState) mark_str_lines(): EmitState {
    // str_lines calls str_split, which now (a Fern helper) builds its string[]
    // with .append() → arr_push / arr_push_owned. AST has no close_needs, so mark
    // those transitive deps directly (the IR path closes them via runtime_need_deps).
    return s.need("heap").need("str_split").need("arr_push").need("arr_push_owned").need("arr_slice").need("str_lines");
}

// str_bytes's helper builds the result array with `.append()`. On the AST path
// that lowers to __fern_arr_push; on the IR path the ownership analysis uses the
// reclaim-on-grow variant __fern_arr_push_owned (sole-owner local reassigned), so
// both symbols must be present. The AST emit path has no close_needs, so mark both
// directly; runtime_need_deps declares the same edges (arr_push_owned → arr_push).
pub function (s: EmitState) mark_str_bytes(): EmitState {
    return s.need("heap").need("arr_push").need("arr_push_owned").need("str_bytes");
}

// str_split's Fern helper builds the result string[] with .append() (AST:
// __fern_arr_push; IR sole-owner local: __fern_arr_push_owned) — same pairing as
// str_chars. Mark both directly on the AST path; runtime_need_deps declares the
// same edges for the IR close_needs.
pub function (s: EmitState) mark_str_split(): EmitState {
    return s.need("heap").need("arr_push").need("arr_push_owned").need("str_split");
}

pub function (s: EmitState) mark_str_case(): EmitState {
    return s.need("heap").need("str_case");
}

// rt_src_str_to_upper / rt_src_str_to_lower back `s.to_upper()` / `s.to_lower()`
// (#2649), via the raw-memory intrinsic floor (docs/RUNTIME-INTRINSICS.md). Alloc
// len bytes, copy each byte case-flipped if it's an ASCII letter (a-z 97-122 →
// upper by -32; A-Z 65-90 → lower by +32), box it. Tier-2; heap is the sole dep.
// Nested ifs instead of `&&` to stay in the proven subset (cf. rt_src_str_search).
// Both gated on the single str_case need (mark_str_case emits both bodies).
pub function rt_src_str_to_upper(): string {
    return "function __fern_str_to_upper(s: string): string { var n: i32 = s.len(); var p: i32 = __raw_alloc(n); var i: i32 = 0; while (i < n) { var c: i32 = s[i]; if (c >= 97) { if (c <= 122) { c = c - 32; } } __raw_store8(p, i, c); i = i + 1; } return __raw_string(p, n); }";
}

pub function rt_src_str_to_lower(): string {
    return "function __fern_str_to_lower(s: string): string { var n: i32 = s.len(); var p: i32 = __raw_alloc(n); var i: i32 = 0; while (i < n) { var c: i32 = s[i]; if (c >= 65) { if (c <= 90) { c = c + 32; } } __raw_store8(p, i, c); i = i + 1; } return __raw_string(p, n); }";
}

pub function (s: EmitState) mark_str_repeat(): EmitState {
    return s.need("heap").need("str_repeat");
}

// rt_src_str_repeat backs `str_repeat(s, n)` / `s.repeat(n)` (#2649) — n copies
// of `s` in a fresh buffer, via the raw-memory intrinsic floor. Allocates
// slen*count bytes (min 1 so a 0-length result still has a valid box ptr),
// copies `s` byte-by-byte `count` times, boxes it. n <= 0 → empty string. Heap
// is its sole dep. Replaces the hand-written register-ABI body on every backend.
pub function rt_src_str_repeat(): string {
    return "function __fern_str_repeat(s: string, n: i32): string { var slen: i32 = s.len(); var count: i32 = n; if (count < 0) { count = 0; } var total: i32 = slen * count; var cap: i32 = total; if (cap == 0) { cap = 1; } var p: i32 = __raw_alloc(cap); var w: i32 = 0; var k: i32 = 0; while (k < count) { var j: i32 = 0; while (j < slen) { __raw_store8(p, w, s[j]); w = w + 1; j = j + 1; } k = k + 1; } return __raw_string(p, total); }";
}

pub function (s: EmitState) mark_str_trim(): EmitState {
    return s.need("heap").need("str_trim");
}

pub function (s: EmitState) mark_str_reverse(): EmitState {
    return s.need("heap").need("str_reverse");
}

// rt_src_str_reverse backs `s.reverse()` (#2649) — a fresh string box with `s`'s
// bytes in reverse order, via the raw-memory intrinsic floor. Allocates n bytes,
// copies s[n-1-i] into p[i], boxes it. Heap is its sole dep. Replaces the
// hand-written register-ABI body on every backend.
pub function rt_src_str_reverse(): string {
    return "function __fern_str_reverse(s: string): string { var n: i32 = s.len(); var p: i32 = __raw_alloc(n); var i: i32 = 0; while (i < n) { __raw_store8(p, i, s[n - 1 - i]); i = i + 1; } return __raw_string(p, n); }";
}

pub function (s: EmitState) mark_str_replace(): EmitState {
    return s.need("heap").need("str_replace");
}

// rt_src_str_replace backs `s.replace(old, new)` / `str_replace(s, old, new)`
// (#2649) — every non-overlapping occurrence of `o` in `h` replaced by `nw`,
// via the raw-memory intrinsic floor. Empty `o` or no match → the haystack box
// unchanged (no allocation). Otherwise two-pass: count matches, alloc the exact
// target size (lenH + count*(lenN-lenO); min 1 for a valid box ptr), walk `h`
// writing `nw` at each match (advancing lenO) and copying other bytes. Heap is
// its sole dep. Replaces the hand-written register-ABI body on every backend.
pub function rt_src_str_replace(): string {
    return "function __fern_str_replace(h: string, o: string, nw: string): string { var lenH: i32 = h.len(); var lenO: i32 = o.len(); if (lenO == 0) { return h; } var lenN: i32 = nw.len(); var count: i32 = 0; var i: i32 = 0; while (i + lenO <= lenH) { var j: i32 = 0; var m: i32 = 1; while (j < lenO) { if (h[i + j] != o[j]) { m = 0; j = lenO; } else { j = j + 1; } } if (m == 1) { count = count + 1; i = i + lenO; } else { i = i + 1; } } if (count == 0) { return h; } var total: i32 = lenH + count * (lenN - lenO); var cap: i32 = total; if (cap == 0) { cap = 1; } var p: i32 = __raw_alloc(cap); var w: i32 = 0; var k: i32 = 0; while (k < lenH) { var m2: i32 = 0; if (k + lenO <= lenH) { var jj: i32 = 0; m2 = 1; while (jj < lenO) { if (h[k + jj] != o[jj]) { m2 = 0; jj = lenO; } else { jj = jj + 1; } } } if (m2 == 1) { var t: i32 = 0; while (t < lenN) { __raw_store8(p, w, nw[t]); w = w + 1; t = t + 1; } k = k + lenO; } else { __raw_store8(p, w, h[k]); w = w + 1; k = k + 1; } } return __raw_string(p, total); }";
}

pub function (s: EmitState) mark_i32_pow(): EmitState {
    return s.need("i32_pow");
}

pub function (s: EmitState) mark_i32_gcd(): EmitState {
    return s.need("i32_gcd");
}

// lcm's helper calls gcd's. The AST emit path has no close_needs, so the mark
// helper must pull in the transitive dep (i32_gcd) directly — same shape as
// mark_arr_str_index_of marking str_eq. (runtime_need_deps declares the edge too,
// for the IR path's close_needs; both kept in sync.)
pub function (s: EmitState) mark_i32_lcm(): EmitState {
    return s.need("i32_gcd").need("i32_lcm");
}

// rt_src_i32_pow is the Fern source for __fern_i32_pow(base, exp) = base^exp,
// the integer-power runtime helper backing `n.pow(e)`. It is the first runtime
// helper written in Fern instead of a hand-written asm string (issue #2649):
// each backend's emit_runtime_fern_fn parses this and lowers it through the
// normal function emitter, so it links as __fn___fern_i32_pow and is called via
// the ordinary stack convention. Shared here (not per-backend) so the helper
// logic has a single source of truth across x86-64 and arm64. Pure scalar (a
// multiply loop) — Tier 0 in docs/RUNTIME-IN-FERN.md: no helper dependency and
// no circularity (its body uses `*`/`-`/`while`, never `.pow()` itself).
pub function rt_src_i32_pow(): string {
    return "function __fern_i32_pow(base: i32, exp: i32): i32 { var r: i32 = 1; var e: i32 = exp; while (e > 0) { r = r * base; e = e - 1; } return r; }";
}

// rt_src_i32_gcd / rt_src_i32_lcm back `n.gcd(m)` / `n.lcm(m)` (#2649), mirroring
// std/i32.gcd / .lcm. gcd is pure scalar (Euclid on the absolute values — Tier 0,
// no helper deps). lcm calls `.gcd()` (so its helper `call`s __fn___fern_i32_gcd):
// runtime_need_deps maps i32_lcm → i32_gcd so close_needs emits gcd's body too.
// gcd(0,0)=0, gcd(a,0)=|a|; lcm is 0 when either operand is 0, else |n/gcd|*|other|.
pub function rt_src_i32_gcd(): string {
    return "function __fern_i32_gcd(n: i32, other: i32): i32 { var a: i32 = n; if (a < 0) { a = 0 - a; } var b: i32 = other; if (b < 0) { b = 0 - b; } while (b != 0) { var t: i32 = b; b = a % b; a = t; } return a; }";
}

pub function rt_src_i32_lcm(): string {
    return "function __fern_i32_lcm(n: i32, other: i32): i32 { if (n == 0) { return 0; } if (other == 0) { return 0; } var g: i32 = n.gcd(other); var q: i32 = n / g; if (q < 0) { q = 0 - q; } var b: i32 = other; if (b < 0) { b = 0 - b; } return q * b; }";
}

// The i32-array reducers backing `xs.sum()` / `.product()` / `.index_of(x)` /
// `.min()` / `.max()` — runtime helpers written in Fern instead of hand-written
// asm (#2649). Tier 1 in docs/RUNTIME-IN-FERN.md: they take a borrowed array
// param (the exit sweep skips params, so no RC traffic) and bottom out in
// inline-lowered `xs.len()` / `xs[i]` indexing and i32 arithmetic — no helper
// call and no allocation, so they reuse emit_runtime_fern_fn unchanged. (min/max
// return the raw extremum; the call site handles empty→None and the Option box.)
pub function rt_src_arr_i32_sum(): string {
    return "function __fern_arr_i32_sum(xs: i32[]): i32 { var s: i32 = 0; var i: i32 = 0; while (i < xs.len()) { s = s + xs[i]; i = i + 1; } return s; }";
}

pub function rt_src_arr_i32_product(): string {
    return "function __fern_arr_i32_product(xs: i32[]): i32 { var p: i32 = 1; var i: i32 = 0; while (i < xs.len()) { p = p * xs[i]; i = i + 1; } return p; }";
}

pub function rt_src_arr_i32_index_of(): string {
    return "function __fern_arr_i32_index_of(xs: i32[], target: i32): i32 { var i: i32 = 0; while (i < xs.len()) { if (xs[i] == target) { return i; } i = i + 1; } return 0 - 1; }";
}

// rt_src_arr_i32_min / _max back `xs.min()` / `.max()`. The call site handles
// the empty array (→ None) and wraps the result in Option[i32], so these
// helpers take a NON-EMPTY borrowed array and return the extremum i32 — the
// same clean Tier 1 reduce-with-comparison shape as sum/product (#2649).
pub function rt_src_arr_i32_min(): string {
    return "function __fern_arr_i32_min(xs: i32[]): i32 { var m: i32 = xs[0]; var i: i32 = 1; while (i < xs.len()) { if (xs[i] < m) { m = xs[i]; } i = i + 1; } return m; }";
}

// rt_src_str_to_i32 backs `str_to_i32(s)` — parse a borrowed string into an
// i32 (#2649). Written with `for b in s` (string byte iteration + break, both
// IR-eligible) rather than s[i] indexing so it lowers cleanly on the IR path as
// well as the AST path. Optional leading '-', then decimal digits, stopping at
// the first non-digit (empty / non-numeric → 0) — matching the hand-written
// helper it replaces. The string param is read-only (never returned/stored), so
// borrow analysis keeps it borrowed: no RC free of the caller's string.
pub function rt_src_str_to_i32(): string {
    return "function __fern_str_to_i32(s: string): i32 { var acc: i32 = 0; var neg: i32 = 0; var first: i32 = 1; for b in s { if (first == 1 && b == 45) { neg = 1; } else { var d: i32 = b - 48; if (d < 0 || d > 9) { break; } acc = acc * 10 + d; } first = 0; } if (neg == 1) { return 0 - acc; } return acc; }";
}

// rt_src_str_cmp backs string ordering (< <= > >=) → __fern_str_cmp(a, b),
// returning a signed i32: <0 if a<b, 0 if equal, >0 if a>b (#2649). Lexicographic
// byte compare (unsigned bytes, like the asm's movzbq) with a length tiebreak;
// it returns the actual byte/length DIFFERENCE (the operators only use the sign),
// matching the hand-written helper. Both string params are read-only, so borrow
// analysis keeps them borrowed (no RC free). Uses a[i]/b[i] indexing — the
// string byte-load lowers on both the AST and IR paths (parallel two-string
// iteration can't use `for ... in`).
pub function rt_src_str_cmp(): string {
    return "function __fern_str_cmp(a: string, b: string): i32 { var la: i32 = a.len(); var lb: i32 = b.len(); var n: i32 = la; if (lb < n) { n = lb; } var i: i32 = 0; while (i < n) { var ca: i32 = a[i]; var cb: i32 = b[i]; if (ca != cb) { return ca - cb; } i = i + 1; } return la - lb; }";
}

// rt_src_str_eq backs string equality (== / !=) AND is called by the map and
// arr_str helpers (#2649) — the exact map_set→str_eq edge that motivated the
// issue. Returns 1 if a and b have equal length and bytes, else 0. Self-contained
// (byte indexing, no alloc, no other helper call) and read-only params (borrowed).
// Every call site (operator, IR op, and the hand-asm map/arr internals) sets up
// the same a/b operands, so all route to the one Fern body.
pub function rt_src_str_eq(): string {
    return "function __fern_str_eq(a: string, b: string): i32 { var la: i32 = a.len(); if (la != b.len()) { return 0; } var i: i32 = 0; while (i < la) { if (a[i] != b[i]) { return 0; } i = i + 1; } return 1; }";
}

// rt_src_arr_str_index_of backs `xs.index_of(t)` / `.contains(t)` on string
// arrays (#2649). It is the first migrated helper that CALLS another runtime
// helper: `xs[i] == t` lowers to a str_eq call (str_eq is itself a Fern runtime
// function now). The str_eq dependency is declared by mark_arr_str_index_of, so
// str_eq's body is emitted alongside. Returns the first index where an element
// equals the target (content equality), or -1. Both params read-only (borrowed).
pub function rt_src_arr_str_index_of(): string {
    return "function __fern_arr_str_index_of(xs: string[], target: string): i32 { var i: i32 = 0; while (i < xs.len()) { if (xs[i] == target) { return i; } i = i + 1; } return 0 - 1; }";
}

// rt_src_arr_str_join backs `xs.join(sep)` on string arrays (#2649). Builds the
// joined string with the `+` operator (which lowers to __fern_str_concat — a
// declared dep via mark_arr_str_join, so its body is present). Written as an
// always-fresh accumulator (`var r = ""` then concat) rather than aliasing
// xs[0], so the returned string is a normal owned value with clean Perceus RC
// (no borrowed array element escaping as the result). Empty array → "".
pub function rt_src_arr_str_join(): string {
    return "function __fern_arr_str_join(xs: string[], sep: string): string { var n: i32 = xs.len(); var r: string = \"\"; var i: i32 = 0; while (i < n) { if (i > 0) { r = r + sep; } r = r + xs[i]; i = i + 1; } return r; }";
}

// rt_src_str_search backs the string-search predicates (#2649): all three are
// gated by the single `str_search` need, so one source defines all three and
// emit_*_runtime_fern_fn emits each. Self-contained — byte indexing only, no
// alloc, no other helper call — so they reuse the migration primitives as-is.
// __fern_str_starts_with(s, p) / _ends_with(s, p): 1 if s has p as a prefix /
// suffix (empty p → 1), else 0. __fern_str_index_of(s, needle): first byte
// offset where needle occurs (empty needle → 0), or -1. Arg order matches the
// hand-written helpers (s=param0, p/needle=param1); both params read-only →
// borrowed. Semantics validated against the asm bodies they replace.
pub function rt_src_str_search(): string {
    return "function __fern_str_starts_with(s: string, p: string): i32 { var lp: i32 = p.len(); if (lp > s.len()) { return 0; } var i: i32 = 0; while (i < lp) { if (s[i] != p[i]) { return 0; } i = i + 1; } return 1; } function __fern_str_ends_with(s: string, p: string): i32 { var ls: i32 = s.len(); var lp: i32 = p.len(); if (lp > ls) { return 0; } var off: i32 = ls - lp; var i: i32 = 0; while (i < lp) { if (s[off + i] != p[i]) { return 0; } i = i + 1; } return 1; } function __fern_str_index_of(s: string, needle: string): i32 { var ls: i32 = s.len(); var ln: i32 = needle.len(); if (ln == 0) { return 0; } if (ln > ls) { return 0 - 1; } var last: i32 = ls - ln; var i: i32 = 0; while (i <= last) { var j: i32 = 0; var ok: i32 = 1; while (j < ln) { if (s[i + j] != needle[j]) { ok = 0; j = ln; } else { j = j + 1; } } if (ok == 1) { return i; } i = i + 1; } return 0 - 1; }";
}

pub function rt_src_arr_i32_max(): string {
    return "function __fern_arr_i32_max(xs: i32[]): i32 { var m: i32 = xs[0]; var i: i32 = 1; while (i < xs.len()) { if (xs[i] > m) { m = xs[i]; } i = i + 1; } return m; }";
}

// rt_src_str_trim backs `s.trim()` (#2649). str_trim is a ZERO-COPY view: it
// finds the first/last non-whitespace byte (space/tab/'\n'/'\r' = 32/9/10/13)
// and returns the sub-slice `s[start:end]`, which lowers to the str_slice op — a
// fresh 16-byte box reusing s's data, no byte copy. So it's Tier-1 (composite /
// borrowed): it allocates only the slice box (heap dep), needs no string-builder
// primitive, and calls no other helper. Style mirrors rt_src_str_search — sentinel
// `go` flag + nested if/else instead of `&&`/`||` to stay in the proven subset.
// Empty / all-whitespace input → start==end → a zero-length slice, matching the
// hand-asm it replaces.
// rt_src_str_chars backs `s.chars()` (#2649). Returns a string[] of 1-byte
// strings — each a zero-copy slice s[i:i+1] (the str_slice op yields a fresh
// 16-byte box reusing s's data at offset i with length 1, no per-char byte copy).
// Composite / Tier-1: appends each 1-char slice (.append() → __fern_arr_push); the
// only allocations are the slice boxes + the growing array, no new primitive. The
// hand-asm pre-sized the array via __fern_arr_box; the append-loop grows it — same
// string[] result.
pub function rt_src_str_chars(): string {
    return "function __fern_str_chars(s: string): string[] { var n: i32 = s.len(); var r: string[] = []; var i: i32 = 0; while (i < n) { r = r.append(s[i:i + 1]); i = i + 1; } return r; }";
}

// rt_src_str_split backs `str_split(s, sep)` / `s.split(sep)` (#2649) — a string[]
// of the substrings between each non-overlapping occurrence of `sep`. Composite /
// Tier-1: scans for `sep` (inline byte-compare, like str_replace) and appends each
// segment slice s[start:i] (.append() → __fern_arr_push, like str_chars) — no new
// primitive. Semantics match the interp for non-empty `sep` (verified: trailing
// "a,b," → ["a","b",""], leading ",a" → ["","a"], no-match → [s], "" → [""],
// multi-char sep). Empty `sep` returns [s] — preserving the current self-host
// hand-asm's behaviour (the interp diverges to a char-split, but no differential
// test exercises empty-sep; the full-length slice s[0:lenS] keeps the element an
// owned slice, consistent with the matched-segment branch).
pub function rt_src_str_split(): string {
    return "function __fern_str_split(s: string, sep: string): string[] { var lenS: i32 = s.len(); var lenSep: i32 = sep.len(); var out: string[] = []; if (lenSep == 0) { out = out.append(s[0:lenS]); return out; } var start: i32 = 0; var i: i32 = 0; while (i + lenSep <= lenS) { var j: i32 = 0; var m: i32 = 1; while (j < lenSep) { if (s[i + j] != sep[j]) { m = 0; j = lenSep; } else { j = j + 1; } } if (m == 1) { out = out.append(s[start:i]); i = i + lenSep; start = i; } else { i = i + 1; } } out = out.append(s[start:lenS]); return out; }";
}

// rt_src_str_bytes backs `s.bytes()` / `s.as_bytes()` (#2649). Returns an i32[]
// of the string's byte values (each zero-extended into the array's uniform 8-byte
// slot). Composite / Tier-1: builds the result by appending each byte
// (s[i] yields the zero-extended byte as i32) — .append() lowers to __fern_arr_push
// (existing), so no new primitive. The hand-asm it replaces pre-sized the array to
// len via __fern_arr_box; the append-loop grows it instead — same i32[] result
// (logical length + elements), just a different internal capacity.
pub function rt_src_str_bytes(): string {
    return "function __fern_str_bytes(s: string): i32[] { var n: i32 = s.len(); var r: i32[] = []; var i: i32 = 0; while (i < n) { r = r.append(s[i]); i = i + 1; } return r; }";
}

// rt_src_str_lines backs `s.lines()` (#2649). It splits s on '\n' via str_split,
// then drops the single trailing empty entry that a trailing newline (or an empty
// input) produces — so "a\nb\nc\n".lines() is 3 lines, not 4, matching the interp
// and Rust/Python. Composite / Tier-1: calls str_split (existing) and an array
// slice parts[0:keep] (→ __fern_arr_slice, existing) — no new primitive. The
// no-trim case returns `parts` directly to avoid a redundant full-array copy.
// (The hand-asm it replaces trimmed by decrementing the result array's length
// word in place; Fern can't mutate that word, so it slices instead — same lines.)
pub function rt_src_str_lines(): string {
    return "function __fern_str_lines(s: string): string[] { var parts: string[] = s.split(\"\\n\"); var n: i32 = parts.len(); var sl: i32 = s.len(); var keep: i32 = n; if (n > 0) { if (sl == 0) { keep = n - 1; } else { if (s[sl - 1] == 10) { keep = n - 1; } } } if (keep == n) { return parts; } return parts[0:keep]; }";
}

pub function rt_src_str_trim(): string {
    return "function __fern_str_trim(s: string): string { var n: i32 = s.len(); var start: i32 = 0; var go: i32 = 1; while (go == 1) { if (start >= n) { go = 0; } else { var c: i32 = s[start]; if (c == 32) { start = start + 1; } else { if (c == 9) { start = start + 1; } else { if (c == 10) { start = start + 1; } else { if (c == 13) { start = start + 1; } else { go = 0; } } } } } } var end: i32 = n; var go2: i32 = 1; while (go2 == 1) { if (end <= start) { go2 = 0; } else { var c2: i32 = s[end - 1]; if (c2 == 32) { end = end - 1; } else { if (c2 == 9) { end = end - 1; } else { if (c2 == 10) { end = end - 1; } else { if (c2 == 13) { end = end - 1; } else { go2 = 0; } } } } } } return s[start:end]; }";
}

pub function match_payload_type(scrut: parser.Expr, s: EmitState): Ty {
    match (scrut) {
        parser.ExprIdent(id) => {
            // Scrutinee is a local — recover the wrapped payload tag
            // from its declared/inferred type.
            if (s.has_local(id.name)) {
                var lt: Ty = s.local_type_of(id.name);
                if (is_option(lt)) { return option_inner(lt); }
                if (is_result(lt)) { return result_inner(lt); }
            }
            return ty_unknown();
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if ((id.name == "Some" || id.name == "Ok") && c.args.len() == 1) {
                        return infer_expr_type(c.args[0], s);
                    }
                    if (id.name == "read_file" || id.name == "read_all_stdin") { return ty_string(); }
                    if (id.name == "tcp_recv") { return ty_string(); }
                    if (id.name == "temp_dir") { return ty_string(); }
                    if (id.name == "read_dir") { return ty_array_string(); }
                    // Arbitrary free / module function returning
                    // Option[T] or Result[T, …] — see asm.fern.
                    var fi: i32 = 0;
                    while (fi < s.funcs.len()) {
                        if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
                            var rt: string = s.funcs[fi].ret_type;
                            if (rt.len() >= 8 && rt[0:7] == "Option[" && rt[rt.len() - 1] == 93) {
                                return ty_from_name(rt[7 : rt.len() - 1]);
                            }
                            if (rt.len() >= 8 && rt[0:7] == "Result[") {
                                var inner: string = "(" + rt[7 : rt.len() - 1] + ")";
                                return split_tuple_ret(inner).a;
                            }
                            return ty_unknown();
                        }
                        fi = fi + 1;
                    }
                    return ty_unknown();
                },
                parser.ExprFieldAccess(fa) => {
                    if (fa.field == "read_chunk") { return ty_string(); }
                    if (fa.field == "read_line") { return ty_option(ty_string()); }
                    if (fa.field == "write") { return ty_i32(); }
                    if (fa.field == "get") {
                        var rt: Ty = infer_expr_type(fa.obj, s);
                        if (is_map(rt)) { return map_val(rt); }
                    }
                    if (fa.field == "min" || fa.field == "max") {
                        if (ty_is_array_i32(infer_expr_type(fa.obj, s))) { return ty_i32(); }
                    }
                    // Receiver method call. See asm.fern.
                    var rcv: Ty = infer_expr_type(fa.obj, s);
                    if (!ty_is_unknown(rcv)) {
                        var fi: i32 = 0;
                        while (fi < s.funcs.len()) {
                            if (s.funcs[fi].name == fa.field && ty_eq(ty_from_name(s.funcs[fi].receiver_type), rcv)) {
                                var rt: string = s.funcs[fi].ret_type;
                                if (rt.len() >= 8 && rt[0:7] == "Option[" && rt[rt.len() - 1] == 93) {
                                    return ty_from_name(rt[7 : rt.len() - 1]);
                                }
                                if (rt.len() >= 8 && rt[0:7] == "Result[") {
                                    var inner: string = "(" + rt[7 : rt.len() - 1] + ")";
                                    return split_tuple_ret(inner).a;
                                }
                                return ty_unknown();
                            }
                            fi = fi + 1;
                        }
                    }
                    return ty_unknown();
                },
                _ => { return ty_unknown(); }
            }
        },
        _ => { return ty_unknown(); }
    }
    return ty_unknown();
}

pub function is_enum_variant(name: string, s: EmitState): boolean {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == name) {
            var sd: parser.StructDecl = s.struct_decls[di];
            var fi: i32 = 0;
            while (fi < sd.fields.len()) {
                if (sd.fields[fi].name == "__ev") { return true; }
                fi = fi + 1;
            }
            return false;
        }
        di = di + 1;
    }
    return false;
}

pub function is_unit_variant(name: string, s: EmitState): boolean {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == name) {
            return s.struct_decls[di].fields.len() == 0;
        }
        di = di + 1;
    }
    return false;
}

pub function is_struct_decl_name(name: string, s: EmitState): boolean {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == name) { return true; }
        di = di + 1;
    }
    return false;
}

// is_prim_recv_name reports whether a method-receiver type spelling names a
// PRIMITIVE / `string` type (i32/i64/u32/u64/usize/f64/f32/boolean/string) —
// the receivers that `impl Trait for <prim>` can name and that a `dyn` value
// boxes (docs/DYN-TRAITS.md §4.2.3). A primitive has no runtime shape pointer,
// so a `dyn` over it is heap-boxed at coercion; the dispatch chain matches the
// box's offset-0 shape (the interned primitive type name) and unboxes. Distinct
// from is_struct_decl_name (structs) and is_enum_recv (enums); an array
// receiver (recv_is_array) is excluded.
pub function is_prim_recv_name(name: string, s: EmitState): boolean {
    if (recv_is_array(name)) { return false; }
    if (is_struct_decl_name(name, s)) { return false; }
    if (is_int_tag(ty_from_name(name))) { return true; }
    if (name == "string" || name == "bool" || name == "boolean") { return true; }
    if (name == "f64" || name == "f32" || name == "float") { return true; }
    return false;
}

pub function is_enum_recv(name: string, s: EmitState): boolean {
    if (is_struct_decl_name(name, s)) { return false; }
    if (is_int_tag(ty_from_name(name))) { return false; }
    if (name == "string" || name == "bool" || name == "boolean") { return false; }
    if (name == "f64" || name == "f32" || name == "float") { return false; }
    return true;
}

// recv_is_array reports whether a method receiver type spelling is an ARRAY
// (`T[]`, `i32[]`, …). Such a method (e.g. std/json's element-poly
// `(xs: T[]) to_json[T: Json]()`) is NOT a concrete struct/enum dispatch
// candidate — a value's runtime shape pointer never names an array method —
// so the runtime shape-dispatch in the AST backends must skip it. Without this
// the array `to_json`, whose base receiver name `T` (a type parameter) passes
// is_enum_recv's permissive default, would be picked as the enum fallback for
// EVERY `.to_json()` call and corrupt non-array receivers (#2766). Distinct
// from a generic struct receiver like `Box[T]`, which ends in `]` but not `[]`.
pub function recv_is_array(rt: string): boolean {
    var n: i32 = rt.len();
    if (n < 2) { return false; }
    return rt[n - 2 : n] == "[]";
}

// find_array_method_func returns the exact in-scope name of the std/array
// auto-discovered helper backing `a.<field>()` — `__method_Array_<field>` when
// the program imports std/array as a single file, or the `<mod>__`-mangled name
// the bundler produced (which ends in the bare convention name) — or "" when no
// such function is in scope (then `a.<field>()` is a genuine unknown method).
// Only free functions (no receiver) qualify; the `__method_Array_` suffix is
// specific enough that no other decl collides. Shared by both asm backends so
// the array-method-syntax dispatch can't drift between them.
pub function find_array_method_func(field: string, s: EmitState): string {
    var target: string = "__method_Array_" + field;
    var tn: i32 = target.len();
    var i: i32 = 0;
    while (i < s.funcs.len()) {
        var nm: string = s.funcs[i].name;
        if (s.funcs[i].receiver_type.len() == 0) {
            if (nm == target) { return nm; }
            if (nm.len() > tn && nm[nm.len() - tn : nm.len()] == target) { return nm; }
        }
        i = i + 1;
    }
    return "";
}

pub function field_type_tag_in(struct_name: string, field: string, s: EmitState): Ty {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == struct_name) {
            var sd: parser.StructDecl = s.struct_decls[di];
            var fi: i32 = 0;
            while (fi < sd.fields.len()) {
                if (sd.fields[fi].name == field) {
                    return ty_from_name(sd.fields[fi].type_name);
                }
                fi = fi + 1;
            }
            return ty_unknown();
        }
        di = di + 1;
    }
    return ty_unknown();
}

pub function field_type_tag(field: string, s: EmitState): Ty {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        var sd: parser.StructDecl = s.struct_decls[di];
        var fi: i32 = 0;
        while (fi < sd.fields.len()) {
            if (sd.fields[fi].name == field) {
                return ty_from_name(sd.fields[fi].type_name);
            }
            fi = fi + 1;
        }
        di = di + 1;
    }
    return ty_unknown();
}

pub function struct_local_tag(type_name: string, s: EmitState): Ty {
    var bi: i32 = 0;
    while (bi < type_name.len()) {
        if (type_name[bi] == 91) { return ty_from_name(type_name); }
        bi = bi + 1;
    }
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == type_name) { return ty_named(type_name); }
        di = di + 1;
    }
    return ty_from_name(type_name);
}

pub struct TyI32 { tag: i32 }

pub struct TyU32 { tag: i32 }

pub struct TyU64 { tag: i32 }

pub struct TyI64 { tag: i32 }

pub struct TyUsize { tag: i32 }

pub struct TyBool { tag: i32 }

pub struct TyString { tag: i32 }

pub struct TyF64 { tag: i32 }

pub struct TyStruct { tag: i32 }

pub struct TyTuple { tag: i32 }

pub struct TyUnknown { tag: i32 }

pub struct TyArray { tag: i32 }

pub struct TyArrayI32 { tag: i32 }

pub struct TyArrayU32 { tag: i32 }

pub struct TyArrayU64 { tag: i32 }

pub struct TyArrayI64 { tag: i32 }

pub struct TyArrayString { tag: i32 }

pub struct TyFnAny { tag: i32 }

pub struct TyMapAny { tag: i32 }

pub struct TyOption { inner: Ty }

pub struct TyResult { inner: Ty }

pub struct TyFn { ret: Ty }

pub struct TyMapStr { val: Ty }

pub struct TyMapI32 { val: Ty }

pub struct TyMapIter { val: Ty }

// TyCell models Cell[T] (docs/CELL-TYPE-PLAN.md) — a single-slot mutable
// box. v1 holds scalars only (the checker's E057 enforces cycle-free T);
// `val` records the element type for get()'s result + set()'s arg width.
pub struct TyCell { val: Ty }

pub struct TyStructNamed { name: string }

pub type Ty = TyI32 | TyU32 | TyU64 | TyI64 | TyUsize | TyBool
            | TyString | TyF64 | TyStruct | TyTuple | TyUnknown |
            TyArray | TyArrayI32 | TyArrayU32 | TyArrayU64 | TyArrayI64
            | TyArrayString | TyFnAny | TyMapAny | TyOption | TyResult |
            TyFn | TyMapStr | TyMapI32 | TyMapIter | TyCell | TyStructNamed;

pub function ty_named(name: string): Ty { return TyStructNamed { name: name }; }

pub function ty_struct_name(t: Ty): string {
    match (t) {
        TyStructNamed(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}

pub function ty_i32(): Ty { return TyI32 { tag: 0 }; }

pub function ty_u32(): Ty { return TyU32 { tag: 0 }; }

pub function ty_u64(): Ty { return TyU64 { tag: 0 }; }

pub function ty_i64(): Ty { return TyI64 { tag: 0 }; }

pub function ty_usize(): Ty { return TyUsize { tag: 0 }; }

pub function ty_bool(): Ty { return TyBool { tag: 0 }; }

pub function ty_string(): Ty { return TyString { tag: 0 }; }

pub function ty_f64(): Ty { return TyF64 { tag: 0 }; }

pub function ty_struct(): Ty { return TyStruct { tag: 0 }; }

pub function ty_tuple(): Ty { return TyTuple { tag: 0 }; }

pub function ty_unknown(): Ty { return TyUnknown { tag: 0 }; }

pub function ty_array(): Ty { return TyArray { tag: 0 }; }

pub function ty_array_i32(): Ty { return TyArrayI32 { tag: 0 }; }

pub function ty_array_u32(): Ty { return TyArrayU32 { tag: 0 }; }

pub function ty_array_u64(): Ty { return TyArrayU64 { tag: 0 }; }

pub function ty_array_i64(): Ty { return TyArrayI64 { tag: 0 }; }

pub function ty_array_string(): Ty { return TyArrayString { tag: 0 }; }

pub function ty_fn_any(): Ty { return TyFnAny { tag: 0 }; }

pub function ty_map_any(): Ty { return TyMapAny { tag: 0 }; }

pub function ty_option(x: Ty): Ty { return TyOption { inner: x }; }

pub function ty_result(x: Ty): Ty { return TyResult { inner: x }; }

pub function ty_fn(x: Ty): Ty { return TyFn { ret: x }; }

pub function ty_map_str(x: Ty): Ty { return TyMapStr { val: x }; }

pub function ty_map_i32(x: Ty): Ty { return TyMapI32 { val: x }; }

pub function ty_mapiter(x: Ty): Ty { return TyMapIter { val: x }; }

pub function ty_cell(x: Ty): Ty { return TyCell { val: x }; }

// is_cell reports whether t is a Cell[T] (the receiver-type gate for
// cell get()/set() dispatch).
pub function is_cell(t: Ty): boolean {
    match (t) {
        TyCell(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// cell_val returns the element type of a Cell[T] (ty_unknown when t isn't
// a cell), driving get()'s result + set()'s arg load/store width.
pub function cell_val(t: Ty): Ty {
    match (t) {
        TyCell(x) => { return x.val; },
        _ => { return ty_unknown(); }
    }
    return ty_unknown();
}

pub function ty_ord(t: Ty): i32 {
    match (t) {
        TyI32(_) => { return 0; },
        TyU32(_) => { return 1; },
        TyU64(_) => { return 2; },
        TyI64(_) => { return 3; },
        TyUsize(_) => { return 4; },
        TyBool(_) => { return 5; },
        TyString(_) => { return 6; },
        TyF64(_) => { return 7; },
        TyStruct(_) => { return 8; },
        TyTuple(_) => { return 9; },
        TyUnknown(_) => { return 10; },
        TyArray(_) => { return 11; },
        TyArrayI32(_) => { return 12; },
        TyArrayU32(_) => { return 13; },
        TyArrayU64(_) => { return 14; },
        TyArrayI64(_) => { return 15; },
        TyArrayString(_) => { return 16; },
        TyFnAny(_) => { return 17; },
        TyMapAny(_) => { return 18; },
        TyOption(_) => { return 19; },
        TyResult(_) => { return 20; },
        TyFn(_) => { return 21; },
        TyMapStr(_) => { return 22; },
        TyMapI32(_) => { return 23; },
        TyMapIter(_) => { return 24; },
        TyStructNamed(_) => { return 25; },
        TyCell(_) => { return 26; },
        _ => { return -1; }
    }
    return -1;
}

pub function is_int_tag(t: Ty): boolean {
    match (t) {
        TyI32(_) => { return true; },
        TyU32(_) => { return true; },
        TyU64(_) => { return true; },
        TyI64(_) => { return true; },
        TyUsize(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_int_array_tag(t: Ty): boolean {
    match (t) {
        TyArrayI32(_) => { return true; },
        TyArrayU32(_) => { return true; },
        TyArrayU64(_) => { return true; },
        TyArrayI64(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_unsigned_tag(t: Ty): boolean {
    match (t) {
        TyU32(_) => { return true; },
        TyU64(_) => { return true; },
        TyUsize(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_unsigned_int_array_tag(t: Ty): boolean {
    match (t) {
        TyArrayU32(_) => { return true; },
        TyArrayU64(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// ty_is_array_like reports whether t is any array type. All arrays now
// carry the Perceus rc header at [data-8] (see __fern_arr_box in the
// backends), so an alias of one is a reference-creation site that must
// retain (inc) the buffer.
pub function ty_is_array_like(t: Ty): boolean {
    match (t) {
        TyArray(_) => { return true; },
        TyArrayI32(_) => { return true; },
        TyArrayU32(_) => { return true; },
        TyArrayU64(_) => { return true; },
        TyArrayI64(_) => { return true; },
        TyArrayString(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// needs_rc_inc_on_alias reports whether binding/passing `e` creates a
// new reference to an rc-tracked heap value that must be retained
// (the Perceus inc site). Ported from the native compiler's
// needsRcIncOnAlias (internal/ir/ir.go), scoped to arrays for Phase 1d
// — strings / structs / enums / closures / tuples join in Phase 1e.
// Fires for a READ of an array-typed value that already has an owner:
//   - an Ident (var y = x),
//   - a struct field (var y = h.items),
//   - an index load (var y = m[i], m an array of arrays).
// A fresh array literal or a call result is already uniquely owned at
// rc=1 and is NOT re-incremented. A spurious inc on a mis-inferred
// non-array is harmless — the rc-inc helper's null / low-address /
// sentinel guards short-circuit — so this is robust to inference gaps.
pub function needs_rc_inc_on_alias(e: parser.Expr, s: EmitState): boolean {
    match (e) {
        parser.ExprIdent(id) => { return ty_is_array_like(s.local_type_of(id.name)); },
        parser.ExprFieldAccess(_) => { return ty_is_array_like(infer_expr_type(e, s)); },
        parser.ExprIndex(_) => { return ty_is_array_like(infer_expr_type(e, s)); },
        _ => { return false; }
    }
    return false;
}

// move_on_return_idx implements Perceus move-on-return for owned array
// locals. When `return e` returns `e` that is a bare ExprIdent naming an
// array-typed LOCAL whose slot index is >= n_params (i.e. NOT a borrowed
// parameter), the buffer can be MOVED to the caller: the return-retain
// inc and the exit sweep's dec of that one slot are a balanced pair on
// the same value, so eliding BOTH hands the array to the caller at its
// current rc with identical net effect. Returns that local's index for
// the caller to (a) skip the return inc and (b) exclude from the sweep;
// returns -1 when no move applies (non-ident, non-array, or a borrowed
// param). Eliding an inc/dec pair on one slot is net-zero regardless of
// any aliasing of the same buffer through other slots, so this is safe.
pub function (s: EmitState) move_on_return_idx(e: parser.Expr): i32 {
    match (e) {
        parser.ExprIdent(id) => {
            if (!s.has_local(id.name)) { return 0 - 1; }
            if (!ty_is_array_like(s.local_type_of(id.name))) { return 0 - 1; }
            var idx: i32 = (0 - s.lookup_local(id.name)) / 8 - 1;
            if (idx < s.n_params) { return 0 - 1; }
            return idx;
        },
        _ => { return 0 - 1; }
    }
    return 0 - 1;
}

pub function is_map(t: Ty): boolean {
    match (t) {
        TyMapAny(_) => { return true; },
        TyMapStr(_) => { return true; },
        TyMapI32(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_mapiter(t: Ty): boolean {
    match (t) {
        TyMapIter(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function map_key_is_i32(t: Ty): boolean {
    match (t) {
        TyMapI32(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_option(t: Ty): boolean {
    match (t) {
        TyOption(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_result(t: Ty): boolean {
    match (t) {
