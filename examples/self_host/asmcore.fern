import "./lexer";
import "./parser";
import "./astwalk";
import "./util";

// asmcore — the target-independent frontend shared by the x86-64
// (asm.fern) and arm64 (asm_arm64.fern) text emitters: the Ty type
// system, EmitState + its state methods, the free-variable walker,
// type inference (infer_expr_type / match_payload_type / field +
// struct tag resolution) and the pre-codegen checker. The backends
// import this and add only their instruction-selection (emit_*).
// Extracted to end the hand-maintained lockstep between the two
// backends — this code now lives once.

// base_type_name -> util.base_type_name (SH-020).

pub function sanitize_label(name: string): string {
    var out: string = "";
    var i: i32 = 0;
    while (i < name.len()) {
        var b: i32 = name[i] as i32;
        if (b == 46) { out = out + "__"; }
        else { out = out + name[i:i + 1]; }
        i = i + 1;
    }
    return out;
}

// i32_to_string now lives in util.fern (imported as `util`). See SH-020.

// digits_to_i32 now lives in util.fern (imported as `util`). See SH-020.

// is_all_digits now lives in util.fern (imported as `util`). See SH-020.

// has_str -> util.has_str (SH-020).

// collect_idents_expr -> astwalk.collect_idents_expr (SH-022).

// collect_idents_stmt -> astwalk.collect_idents_stmt (SH-022).

// collect_bound_stmt -> astwalk.collect_bound_stmt (SH-022).

pub function lambda_captures(lm: parser.ExprLambda, outer: EmitState): string[] {
    var refs: string[] = [];
    var bi: i32 = 0;
    while (bi < lm.body.len()) {
        refs = astwalk.collect_idents_stmt(lm.body[bi], refs);
        bi = bi + 1;
    }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lm.params.len()) {
        bound = bound.append(lm.params[pi].name);
        pi = pi + 1;
    }
    var si: i32 = 0;
    while (si < lm.body.len()) {
        bound = astwalk.collect_bound_stmt(lm.body[si], bound);
        si = si + 1;
    }
    var caps: string[] = [];
    var ri: i32 = 0;
    while (ri < refs.len()) {
        var nm: string = refs[ri];
        if (!util.has_str(bound, nm) && !util.has_str(caps, nm) && outer.has_local(nm)) {
            caps = caps.append(nm);
        }
        ri = ri + 1;
    }
    return caps;
}

pub struct EmitState {
    out: string,
    label_n: i32,
    local_names: string[],
    in_function: boolean,
    string_lits: string[],
    // needed: the set of runtime-library helpers this module
    // requests, by name. Populated via need() / the mark_*
    // wrappers; emit_module consults has_need() to decide which
    // helper bodies to append. Replaces ~26 parallel needs_*
    // booleans — see asm.fern for the rationale.
    needed: string[],
    struct_decls: parser.StructDecl[],
    // loop_exit_labels / loop_cont_labels: see asm.fern for
    // semantics. break / continue use the top of each stack.
    loop_exit_labels: string[],
    loop_cont_labels: string[],
    // funcs: the module's FuncDecls — used by method dispatch
    // in ExprCall(ExprFieldAccess(...), args).
    funcs: parser.FuncDecl[],
    // local_types: parallel to local_names. See asm.fern.
    local_types: Ty[],
    // n_params: count of leading local_names slots that are the
    // function's receiver + parameters (bound first by emit_function).
    // The Perceus function-exit dec sweep skips these — parameters are
    // BORROWED (the caller still owns them), so the callee must not
    // release them. Set per function after the params are bound.
    n_params: i32,
    // use_ir: the parallel-path migration's IR opt-in
    // (docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md §3), left on. Nothing routes
    // around it any more — the AST emitters are gone and every backend is
    // IR-or-error — so the remaining readers (wasm_ir.should_use_ir_core, the
    // `-ir` drivers) only ever see it set.
    use_ir: boolean,
    // str_ns: per-module namespace for string-literal `.rodata` labels, for
    // per-module translation-unit emit (#3451 step 3 / #3455). Empty (the
    // default / whole-program case) keeps the label `.S<idx>`; a non-empty ns
    // makes it `.S<ns>_<idx>` so two separately-emitted modules' string pools
    // don't collide at link. The IR backend reads this via str_lit_label.
    str_ns: string,
    // shape_lits: the distinct enum/struct SHAPE names this unit references as a
    // shape pointer (struct_make / variant_is / dyn dispatch). Per-module
    // (str_ns != ""), a shape is emitted as a `.weak` global symbol
    // (`__fern_shp_<sanitized>`) instead of a unit-local `.S<ns>_<idx>` string, so
    // the SAME shape interned in two units resolves to ONE linker-merged address —
    // pointer-equality shape discrimination then works across the module boundary
    // (a token constructed in lexer matches in parser). Empty / unused on the
    // whole-program (str_ns == "") path, which keeps interning shapes as ordinary
    // string literals (byte-identical).
    shape_lits: string[],
    // const_aggs: the unit's distinct STATIC AGGREGATE CONSTANTS (#6149), each
    // `<shape label>|<w0>,<w1>,…`. Populated by the const_struct op arm and
    // flushed as one data block per entry alongside the string pool. See
    // add_const_agg.
    const_aggs: string[]
}

pub function new_state(): EmitState {
    var ns: string[] = [];
    var sl: string[] = [];
    var lex: string[] = [];
    var lcn: string[] = [];
    var fns: parser.FuncDecl[] = [];
    var lts: Ty[] = [];
    var nd: string[] = [];
    return EmitState {
        out: "",
        label_n: 0,
        local_names: ns,
        in_function: false,
        string_lits: sl,
        needed: nd,
        struct_decls: [],
        loop_exit_labels: lex,
        loop_cont_labels: lcn,
        funcs: fns,
        local_types: lts,
        n_params: 0,
        // Default ON (x86-64): a fully-IR-eligible module (i32 + arrays, full
        // Perceus RC) compiles through asm_ir.emit_module_ir; everything else
        // (strings/structs/methods/maps/floats/closures) falls back to the AST
        // emitter. The IR path now uses asm.fern's OWN array layout + RC
        // helpers (8-byte __fern_arr_box, __fn___fern_rc_inc/__fn___fern_arr_dec)
        // and implements the full array Perceus lifecycle — alias-inc,
        // move-on-return, borrowed params, the exit dec-sweep, and reassignment
        // retain + cow-guarded release — so it is a drop-in for asm.fern's
        // array RC (the self_host_rc_runtime asm patterns match). The compiler
        // is not all_eligible (it is full of strings/structs), so it still
        // compiles via AST and the byte-identical fixpoint holds.
        use_ir: true,
        // Whole-program default: no namespace, so string labels stay `.S<idx>`
        // (byte-identical to the pre-per-module emitter). Per-module unit emit
        // sets this to keep each module's `.rodata` pool collision-free.
        str_ns: "",
        shape_lits: [],
        const_aggs: []
    };
}

// add_shape_lit records `name` as a shape this unit references (deduped), for the
// per-module weak-symbol shape emission (#3451). The returned symbol — the SAME
// for `name` in every unit — is what struct_make / variant_is / dyn dispatch leaq
// instead of a unit-local string label; emit_module_ir_unit emits each recorded
// shape once as `.weak __fern_shp_<sanitized>` so the linker merges the copies.
pub function add_shape_lit(s: EmitState, name: string): EmitState {
    var i: i32 = 0;
    while (i < s.shape_lits.len()) {
        if (s.shape_lits[i] == name) { return s; }
        i = i + 1;
    }
    return EmitState { ...s, shape_lits: s.shape_lits.append(name) };
}

// shape_sym is the deterministic global symbol for a shape name (the linker-merged
// weak symbol the per-module path uses for shape pointers). Stable across units so
// two units' references to the same shape resolve to one address.
pub function shape_sym(name: string): string {
    return "__fern_shp_" + sanitize_label(name);
}

pub function (s: EmitState) write(text: string): EmitState {
    // O(N) amortised: route through the global strbuf primitive
    // instead of `s.out + text` (which is O(N²) — fatal for self-
    // hosting). The .out field stays "" through the build; the
    // accumulated bytes live in the strbuf until emit_module's
    // tail calls strbuf_take to materialise the final string.
    // Mirrors the x86-64 backend (asm.fern).
    strbuf_append(text);
    // Return the receiver, not a copy of it. `EmitState { ...s }` overrides no
    // field, so the copy was observationally identical to `s` — and it
    // allocated a fresh 30-field box on every write. Attributed with
    // FERN_RC_TRACE, that made this the single largest allocator of BYTES in
    // the compiler (658 allocs / 84 KB on a small compile, 28% of the run).
    // Sound because every one of the 7,355 `.write(…)` call sites in the
    // self-host sources is a same-name self-rebind (`s = s.write(…)`) — there
    // is no site that binds the result to a second name, so handing the
    // receiver back creates no alias that did not already exist.
    return s;
}

pub function (s: EmitState) bind_local(name: string): EmitState {
    return s.bind_local_typed(name, ty_unknown());
}

pub function (s: EmitState) bind_local_typed(name: string, ty: Ty): EmitState {
    var ln: string[] = s.local_names.append(name);
    var lts: Ty[] = s.local_types.append(ty);
    return EmitState { ...s, local_names: ln, local_types: lts };
}

pub function (s: EmitState) local_type_of(name: string): Ty {
    var i: i32 = s.local_names.len() - 1;
    while (i >= 0) {
        if (s.local_names[i] == name) { return s.local_types[i]; }
        i = i - 1;
    }
    return ty_unknown();
}

pub function (s: EmitState) mark_str_concat(): EmitState {
    return s.need("heap").need("str_concat");
}

// rt_src_str_concat backs `+` on strings (#2649), via the raw-memory intrinsic
// floor (docs/RUNTIME-INTRINSICS.md). Size lenA+lenB, alloc the buffer, bulk-copy
// each operand in, box it (__raw_string). Tier-2 (builds a fresh buffer); heap is
// its sole dep (mark_str_concat). No string `+` inside, so no self-recursion.
// Empty operands are a 0-length __memcpy, which every backend treats as a no-op.
//
// The destination half of the second copy needs __raw_addr rather than `p + la`:
// a raw pointer's surface type is i32, so arm64 would narrow the sum back.
pub function rt_src_str_concat(): string {
    return "function __fern_str_concat(a: string, b: string): string { var la: i32 = a.len(); var lb: i32 = b.len(); var p: i32 = __raw_alloc(la + lb); __memcpy(p, __raw_data(a), la); __memcpy(__raw_addr(p, la), __raw_data(b), lb); return __raw_string(p, la + lb); }";
}

pub function (s: EmitState) mark_str_eq(): EmitState {
    return s.need("str_eq");
}

pub function (s: EmitState) mark_str_print(): EmitState {
    return s.need("str_print");
}

pub function (s: EmitState) mark_str_cmp(): EmitState {
    return s.need("str_cmp");
}

pub function (s: EmitState) mark_str_read_line(): EmitState {
    return s.need("heap").need("str_read_line");
}

pub function (s: EmitState) mark_i32_to_string(): EmitState {
    return s.need("heap").need("i32_to_string");
}

// rt_src_i32_to_string backs (n).to_string() / the i32_to_string free fn (#2649),
// via the raw-memory intrinsic floor (docs/RUNTIME-INTRINSICS.md). Count digits,
// alloc exactly nd(+1 for '-') bytes, fill from the end (units last), prepend '-'
// for negatives. Tier-2 (digit buffer); heap is its sole dep. n==0 → "0".
//
// The magnitude is carried UNSIGNED (u32), which is what makes INT_MIN exact:
// `0 - n` wraps back to INT_MIN, whose u32 reading is 2^31 — the true
// magnitude. Formatted as a SIGNED i32 the wrapped value stays negative, so
// `while (v > 0)` never runs and the whole number renders as a bare "-"
// (#6050). Same trick rt_src_i64_to_string uses for INT64_MIN; the wasm
// emitter's WAT sibling has always used div_u/rem_u here, which is why only
// the register backends printed "-".
pub function rt_src_i32_to_string(): string {
    return "function __fern_i32_to_string(n: i32): string { var neg: i32 = 0; var m: i32 = n; if (n < 0) { neg = 1; m = 0 - n; } var v: u32 = m as u32; if (v == (0 as u32)) { var z: i32 = __raw_alloc(1); __raw_store8(z, 0, 48); return __raw_string(z, 1); } var nd: i32 = 0; var t: u32 = v; while (t != (0 as u32)) { nd = nd + 1; t = t / (10 as u32); } var total: i32 = nd + neg; var p: i32 = __raw_alloc(total); if (neg == 1) { __raw_store8(p, 0, 45); } var i: i32 = total - 1; while (v != (0 as u32)) { __raw_store8(p, i, 48 + ((v % (10 as u32)) as i32)); v = v / (10 as u32); i = i - 1; } return __raw_string(p, total); }";
}

pub function (s: EmitState) mark_u32_to_string(): EmitState {
    return s.need("heap").need("u32_to_string");
}

// rt_src_u32_to_string backs (n).to_string() on a u32 value (#2649). The signed
// __fern_i32_to_string can't format a u32 with bit 31 set (it reads the low 32
// bits as a negative i32), so a u32 receiver routes here instead. The magnitude
// is recovered UNSIGNED as `(n as i64) & 0xFFFFFFFF` — correct no matter how the
// caller extended the 32-bit value into its 8-byte arg slot (sign- or zero-
// extended) — then formatted with i64 digit arithmetic (values up to
// 4294967295 exceed i32). Heap is its sole dep. n==0 → \"0\". Never negative, so
// no sign branch. Import-free: it is a runtime helper, so u32.to_string works
// without `import \"std/u32\"` exactly as the i32 builtin did.
pub function rt_src_u32_to_string(): string {
    return "function __fern_u32_to_string(n: i32): string { var v: i64 = (n as i64) & (4294967295 as i64); if (v == (0 as i64)) { var z: i32 = __raw_alloc(1); __raw_store8(z, 0, 48); return __raw_string(z, 1); } var nd: i32 = 0; var t: i64 = v; while (t > (0 as i64)) { nd = nd + 1; t = t / (10 as i64); } var p: i32 = __raw_alloc(nd); var i: i32 = nd - 1; while (v > (0 as i64)) { __raw_store8(p, i, 48 + ((v % (10 as i64)) as i32)); v = v / (10 as i64); i = i - 1; } return __raw_string(p, nd); }";
}

pub function (s: EmitState) mark_i64_to_string(): EmitState {
    return s.need("heap").need("i64_to_string");
}

// rt_src_i64_to_string backs (n).to_string() on an i64 receiver. The old
// is_int_tag shortcut sent 64-bit receivers to __fern_i32_to_string, which
// reads only the low 32 bits of its arg slot — a wide value silently
// truncated (1234567890123 → 1912276171, its low-32 reading). The magnitude
// is formatted with UNSIGNED u64 digit arithmetic (the divq path), which
// also makes the INT64_MIN negation exact: `(0 as i64) - n` wraps to
// INT64_MIN, whose u64 reading is 2^63 — the true magnitude. The same trick
// core/int's __int_to_string_u64 uses. Heap is its sole dep. Import-free:
// i64.to_string works without `import \"std/i64\"`, as the i32 builtin did.
pub function rt_src_i64_to_string(): string {
    return "function __fern_i64_to_string(n: i64): string { var neg: i32 = 0; var m: i64 = n; if (n < (0 as i64)) { neg = 1; m = (0 as i64) - n; } var v: u64 = m as u64; if (v == (0 as u64)) { var z: i32 = __raw_alloc(1); __raw_store8(z, 0, 48); return __raw_string(z, 1); } var nd: i32 = 0; var t: u64 = v; while (t != (0 as u64)) { nd = nd + 1; t = t / (10 as u64); } var total: i32 = nd + neg; var p: i32 = __raw_alloc(total); if (neg == 1) { __raw_store8(p, 0, 45); } var i: i32 = total - 1; while (v != (0 as u64)) { __raw_store8(p, i, 48 + ((v % (10 as u64)) as i32)); v = v / (10 as u64); i = i - 1; } return __raw_string(p, total); }";
}

pub function (s: EmitState) mark_u64_to_string(): EmitState {
    return s.need("heap").need("u64_to_string");
}

// rt_src_u64_to_string backs (n).to_string() on a u64 receiver — the full
// unsigned 64-bit range, so a value with bit 63 set formats as its true
// magnitude rather than a negative i64 reading. Pure u64 digit loop
// (unsigned divq). Heap is its sole dep; never negative, so no sign
// branch. Import-free like the u32 sibling.
pub function rt_src_u64_to_string(): string {
    return "function __fern_u64_to_string(n: u64): string { var v: u64 = n; if (v == (0 as u64)) { var z: i32 = __raw_alloc(1); __raw_store8(z, 0, 48); return __raw_string(z, 1); } var nd: i32 = 0; var t: u64 = v; while (t != (0 as u64)) { nd = nd + 1; t = t / (10 as u64); } var p: i32 = __raw_alloc(nd); var i: i32 = nd - 1; while (v != (0 as u64)) { __raw_store8(p, i, 48 + ((v % (10 as u64)) as i32)); v = v / (10 as u64); i = i - 1; } return __raw_string(p, nd); }";
}

pub function (s: EmitState) mark_str_to_i32(): EmitState {
    return s.need("str_to_i32");
}

// chr(n): i32 byte -> 1-char string box. Allocates, so pull in the heap.
pub function (s: EmitState) mark_chr(): EmitState {
    return s.need("heap").need("chr");
}

// rt_src_chr backs `chr(b)` (#2649) — the first Tier-2 helper written in Fern via
// the raw-memory intrinsic floor (docs/RUNTIME-INTRINSICS.md). Allocate 1 byte,
// store the low byte of b, box it back into a string. The whole Tier-2 vocabulary
// (alloc, store a byte, box) in one helper — the end-to-end proof the floor works
// through a real runtime helper. The intrinsics lower to single instructions
// (+ one __fern_alloc), so chr's only dep stays `heap` (mark_chr).
pub function rt_src_chr(): string {
    return "function __fern_chr(b: i32): string { var p: i32 = __raw_alloc(1); __raw_store8(p, 0, b); return __raw_string(p, 1); }";
}

// sysno is the ONE table of syscall numbers the Fern runtime leaves are
// generated against (#2649). `t` is the emitting backend's target — "x86_64",
// "arm64-linux" or "arm64-darwin" — and the returned decimal string is spliced
// straight into the helper source, so a single rt_src_* body serves all three.
//
// Why the number is baked in rather than translated later: on the Mach-O path
// `darwinize` remaps a syscall by matching a literal `mov x8, #N`, which the
// generic __syscall3 / __syscall4 ops never emit (their number is an operand it
// only sees at runtime). darwinize therefore rewrites only the number register
// and the trap, and the number has to be Darwin's already. Entries are limited
// to syscalls whose ARGUMENT and RESULT shape agree across the three, which is
// why getdirentries64 (a 4th out-param Linux's getdents64 has no equivalent of)
// is absent — a leaf that diverges in shape needs a per-target body, not a
// substituted constant. An unknown name returns "-1", which every kernel here
// rejects with ENOSYS — NOT "0", which is a valid number on two of the three
// targets (x86-64 `read`, Darwin's indirect-syscall trampoline) and would have
// made a typo issue a real syscall instead of failing.
pub function sysno(t: string, name: string): string {
    if (t == "x86_64") {
        if (name == "read") { return "0"; }
        if (name == "write") { return "1"; }
        if (name == "close") { return "3"; }
        if (name == "lseek") { return "8"; }
        if (name == "openat") { return "257"; }
        if (name == "fchmod") { return "91"; }
        if (name == "unlinkat") { return "263"; }
        if (name == "mkdirat") { return "258"; }
        if (name == "fstatat") { return "262"; }
        if (name == "getrandom") { return "318"; }
        if (name == "exit") { return "60"; }
        if (name == "clock_gettime") { return "228"; }
        if (name == "getdents") { return "217"; }
        if (name == "accept") { return "43"; }
        if (name == "nanosleep") { return "35"; }
        if (name == "poll") { return "7"; }
        if (name == "wait4") { return "61"; }
        if (name == "socket") { return "41"; }
        if (name == "bind") { return "49"; }
        if (name == "listen") { return "50"; }
        if (name == "connect") { return "42"; }
    if (name == "execve") { return "59"; }
    if (name == "fork") { return "57"; }
        if (name == "timerfd_create") { return "283"; }
        if (name == "timerfd_settime") { return "286"; }
        if (name == "ioctl") { return "16"; }
        return "-1";
    }
    if (t == "arm64-darwin") {
        if (name == "read") { return "3"; }
        if (name == "write") { return "4"; }
        if (name == "close") { return "6"; }
        if (name == "lseek") { return "199"; }
        if (name == "openat") { return "463"; }
        if (name == "fchmod") { return "124"; }
        if (name == "unlinkat") { return "472"; }
        if (name == "mkdirat") { return "475"; }
        if (name == "fstatat") { return "470"; }
        // Darwin has no getrandom; getentropy(buf, len) takes the same first
        // two args and ignores a third, but caps each call at 256 bytes and
        // returns 0 rather than a count — see rt_src_random_bytes.
        if (name == "getrandom") { return "500"; }
        if (name == "exit") { return "1"; }
        // XNU has no clock_gettime syscall — gettimeofday(&tv, NULL) is the
        // portable stand-in, and it fills a DIFFERENTLY SHAPED struct (see
        // subsec_off / subsec_per_sec). clock_gettime has no row here on
        // purpose: -1 would be issued as a real syscall number.
        if (name == "gettimeofday") { return "116"; }
        // getdirentries64, not getdents64. Same first three arguments, plus a
        // 4th out-param the kernel updates with the new directory position —
        // see rt_src_read_dir for why the shared body issues __syscall4 on
        // every target rather than branching on the arity.
        if (name == "getdents") { return "344"; }
        if (name == "accept") { return "30"; }
        if (name == "select") { return "93"; }
        if (name == "wait4") { return "7"; }
        if (name == "socket") { return "97"; }
        if (name == "bind") { return "104"; }
        if (name == "listen") { return "106"; }
        if (name == "connect") { return "98"; }
        if (name == "execve") { return "59"; }
        if (name == "ioctl") { return "54"; }
        return "-1";
    }
    // arm64 (Linux).
    if (name == "read") { return "63"; }
    if (name == "write") { return "64"; }
    if (name == "close") { return "57"; }
    if (name == "lseek") { return "62"; }
    if (name == "openat") { return "56"; }
    if (name == "fchmod") { return "52"; }
    if (name == "unlinkat") { return "35"; }
    if (name == "mkdirat") { return "34"; }
    if (name == "fstatat") { return "79"; }
    if (name == "getrandom") { return "278"; }
    if (name == "exit") { return "93"; }
    if (name == "clock_gettime") { return "113"; }
    if (name == "getdents") { return "61"; }
    if (name == "accept") { return "202"; }
    if (name == "nanosleep") { return "101"; }
    if (name == "ppoll") { return "73"; }
    if (name == "wait4") { return "260"; }
    if (name == "socket") { return "198"; }
    if (name == "bind") { return "200"; }
    if (name == "listen") { return "201"; }
    if (name == "connect") { return "203"; }
    if (name == "execve") { return "221"; }
    if (name == "clone") { return "220"; }
    if (name == "timerfd_create") { return "85"; }
    if (name == "timerfd_settime") { return "86"; }
    if (name == "ioctl") { return "29"; }
    return "-1";
}

// at_fdcwd is the *at() family's "relative to the current directory" dirfd:
// -100 on Linux, -2 on XNU. It only matters for a relative path (an absolute
// one ignores dirfd), which is exactly the case that broke before #6002.
pub function at_fdcwd(t: string): string {
    if (t == "arm64-darwin") { return "-2"; }
    return "-100";
}

// statoff is the `struct stat` field-offset table — the third per-target axis
// after sysno and oflag, and the one that decides whether a leaf reading kernel
// structs is expressible as ONE source. All three kernels fill a different
// layout: x86-64 Linux has a u32 st_mode at 24, arm64 Linux at 16, and Darwin's
// 64-bit-inode stat a **u16** st_mode at 4 with st_size pushed to 96 by four
// timespecs.
//
// The u16 needs no separate treatment, which is the part that makes this work:
// the only consumer masks with S_IFMT (0xF000), and every bit above 15 —
// Darwin's st_nlink, sharing the word — is discarded by that mask anyway. So a
// plain 32-bit load at the target's offset is correct on all three.
pub function statoff(t: string, name: string): string {
    if (t == "x86_64") {
        if (name == "mode") { return "24"; }
        if (name == "size") { return "48"; }
        return "0";
    }
    if (t == "arm64-darwin") {
        if (name == "mode") { return "4"; }
        if (name == "size") { return "96"; }
        return "0";
    }
    if (name == "mode") { return "16"; }
    if (name == "size") { return "48"; }
    return "0";
}

// oflag is the open(2) flag-set table, the other half of sysno: the numbers
// differ between Linux and XNU even where the syscall does not. O_RDONLY is 0
// everywhere so it needs no entry; the write set is
// O_WRONLY|O_CREAT|O_TRUNC = 1|0x40|0x200 = 577 on Linux and
// 1|0x200|0x400 = 1537 on Darwin, which is exactly the kind of constant that
// silently creates the wrong file rather than failing.
// oflag is the open(2) flag word. Note that unlike every other table here,
// O_DIRECTORY differs between the two LINUX arches as well as on Darwin: it is
// 0o200000 (65536) on x86-64, 0o40000 (16384) on arm64 — an arch-specific
// override of the asm-generic value — and 0x100000 (1048576) on XNU. So this
// one needs a real three-way split, not the usual Darwin-vs-Linux fork.
//
// Every wrong value is a SILENT wrong flag rather than a rejected constant:
// 65536 on arm64 Linux is O_RDONLY|O_DIRECT (EINVAL on /tmp), and 65536 on
// Darwin is O_NDELAY|O_ASYNC (the open succeeds and the first read fails). The
// retired arm64 hand-asm carried this in a comment; it is a table row now.
//
// O_WRONLY|O_CREAT|O_TRUNC is 577 on both Linux arches (O_CREAT and O_TRUNC are
// generic) and 1537 on XNU.
pub function oflag(t: string, name: string): string {
    if (t == "arm64-darwin") {
        if (name == "wr_creat_trunc") { return "1537"; }
        if (name == "wr_creat_append") { return "521"; }
        if (name == "rd_directory") { return "1048576"; }
        return "0";
    }
    if (t == "x86_64") {
        if (name == "wr_creat_trunc") { return "577"; }
        if (name == "wr_creat_append") { return "1089"; }
        if (name == "rd_directory") { return "65536"; }
        return "0";
    }
    // arm64 (Linux).
    if (name == "wr_creat_trunc") { return "577"; }
    if (name == "wr_creat_append") { return "1089"; }
    if (name == "rd_directory") { return "16384"; }
    return "0";
}

// atflag is the *at() family's flag word. AT_REMOVEDIR — "unlink this as a
// directory, not a file" — is 0x200 on Linux and 0x80 on XNU.
pub function atflag(t: string, name: string): string {
    if (t == "arm64-darwin") {
        if (name == "removedir") { return "128"; }
        return "0";
    }
    if (name == "removedir") { return "512"; }
    return "0";
}

// direntoff gives the byte offsets inside one directory record. d_reclen is at
// 16 on both, but the name is not: Linux's linux_dirent64 is
// { u64 d_ino; s64 d_off; u16 d_reclen @16; u8 d_type @18; char d_name[] @19 }
// while XNU's dirent carries a second u16 (d_namlen @18) before d_type, putting
// the name at 21. Getting this wrong reads a directory of names shifted by two
// bytes, which is the kind of bug that looks like corruption rather than an
// offset.
pub function direntoff(t: string, name: string): string {
    if (t == "arm64-darwin") {
        if (name == "name") { return "21"; }
        return "16";
    }
    if (name == "name") { return "19"; }
    return "16";
}

// rt_src_random_bytes backs `random_bytes(n)` (#2649) — the first syscall-leaf
// helper written in Fern, over the syscall sub-floor (docs/RUNTIME-INTRINSICS.md
// step 5). Allocate n scratch bytes, fill them from the CSPRNG in <= 256-byte
// chunks, then spread the bytes one-per-slot into a fresh `u8[]` box (all
// self-host arrays use full element slots). Only dep is `heap`
// (mark_random_bytes).
//
// The three targets agree on the (buf, len, flags) argument shape — Darwin's
// getentropy simply ignores the third arg — but NOT on the result: getrandom
// returns the byte count, getentropy returns 0. So the loop advances by the
// requested chunk, never by the result, and reads the result only to detect
// failure (< 0) — the same contract the hand-asm bodies this replaced held. The
// 256-byte chunking is getentropy's hard per-call limit; on Linux it
// additionally fixes the short-fill the single-shot version had for n > 256,
// where getrandom may return fewer bytes than asked.
// The chunk buffer address is `__raw_addr(p, off)`, not `p + off`: a raw pointer
// is typed i32 on the Fern surface, so the arm64 backend sign-extends the sum of
// an ordinary `+` back to 32 bits and the syscall gets a truncated heap address.
// wasm keeps its WASI `random_get` bundle — it has no generic syscall.
pub function rt_src_random_bytes(t: string): string {
    return "function __fern_random_bytes(n: i32): i32[] { var p: i32 = __raw_alloc(n); var off: i32 = 0; while (off < n) { var want: i32 = n - off; if (want > 256) { want = 256; } var r: i32 = __syscall3(" + sysno(t, "getrandom") + ", __raw_addr(p, off), want, 0); if (r < 0) { off = n; } else { off = off + want; } } var b: i32 = __raw_arr_box(n); var i: i32 = 0; while (i < n) { __raw_store_ptr(b, i + 1, __raw_load8(p, i)); i = i + 1; } return __raw_array(b); }";
}

// rt_src_random_i32 backs a single CSPRNG i32 (#2649, syscall-leaf) — the
// sibling of random_bytes, and core/map's per-process hash seed draws through it.
//
// Four bytes into the fixed static __fern_scratch buffer rather than a fresh
// allocation: this allocates nothing, which is what lets it stay outside the
// heap-gated runtime block (a program whose only runtime call is random_i32
// emits no heap at all). Same reason the clocks use scratch.
//
// The getrandom result is read only to detect failure, matching random_bytes and
// the hand-asm this replaces — on failure the caller gets whatever scratch held,
// which is the contract the stack-slot version had too. wasm keeps its WASI
// `random_get` bundle; it has no generic syscall.
pub function rt_src_random_i32(t: string): string {
    return "function __fern_random_i32(): i32 { var p: i32 = __raw_scratch(4); __syscall3(" + sysno(t, "getrandom") + ", p, 4, 0); return __load_i32(p); }";
}

// rt_src_open_fd backs the file half of the streaming Reader/Writer surface
// (#4372, #2649 syscall-leaf) — one helper for open_reader (flags 0) /
// open_writer / open_appender, returning the raw fd or -errno. NUL-terminate the
// path, openat(AT_FDCWD, pathz, flags, mode).
//
// The flags arrive as a PARAMETER, not a per-target constant, because irlower
// picks them and has no target: the op site passes the Linux value on every
// target. So Darwin translates at run time, exactly as the hand-asm did — XNU's
// O_CREAT/O_TRUNC/O_APPEND (0x200/0x400/0x8) match none of Linux's
// 64/512/1024. Untranslated, open_writer asks XNU for O_CREAT-without-O_TRUNC
// and an overwrite leaves the old file's trailing bytes (#6042). The two live
// combinations are the only ones the op site can produce, and the Linux targets
// get no branches at all.
pub function rt_src_open_fd(t: string): string {
    var xlate: string = "";
    if (t == "arm64-darwin") {
        xlate = "if (f == " + oflag("x86_64", "wr_creat_trunc") + ") { f = " + oflag(t, "wr_creat_trunc") + "; } "
              + "if (f == " + oflag("x86_64", "wr_creat_append") + ") { f = " + oflag(t, "wr_creat_append") + "; } ";
    }
    return "function __fern_open_fd(path: string, flags: i32, mode: i32): i32 { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var f: i32 = flags; " + xlate + "return __syscall4(" + sysno(t, "openat") + ", " + at_fdcwd(t) + ", pathz, f, mode); }";
}

// rt_src_tcp_close / rt_src_tcp_accept are the two socket leaves that take only
// an fd (#2649, syscall-leaf) — close(2) and accept(2) with a NULL addr/addrlen.
pub function rt_src_tcp_close(t: string): string {
    return "function __fern_tcp_close(fd: i32): i32 { return __syscall3(" + sysno(t, "close") + ", fd, 0, 0); }";
}

pub function rt_src_tcp_accept(t: string): string {
    return "function __fern_tcp_accept(fd: i32): i32 { return __syscall3(" + sysno(t, "accept") + ", fd, 0, 0); }";
}

// rt_src_sleep_ms backs `sleep_ms(ms)` (#2649, syscall-leaf) — and is the first
// consumer of __syscall5.
//
// This is the leaf whose two targets genuinely disagree on the CALL, not just
// the number: Linux sleeps with `nanosleep(&timespec, NULL)`, but XNU has no
// nanosleep syscall at all and sleeps with
// `select(0, NULL, NULL, NULL, &timeval)` — five arguments, and a subsecond
// field measured in MICROseconds rather than nanoseconds. Both halves write the
// two-word struct the same way, through __raw_store_ptr's word-sized slots, so
// only the multiplier and the call differ.
//
// A non-positive `ms` returns without a syscall, matching the hand-asm.
pub function rt_src_sleep_ms(t: string): string {
    if (t == "arm64-darwin") {
        return "function __fern_sleep_ms(ms: i32): i32 { if (ms <= 0) { return 0; } var tv: i32 = __raw_scratch(16); __raw_store_ptr(tv, 0, ms / 1000); __raw_store_ptr(tv, 1, (ms % 1000) * 1000); return __syscall5(" + sysno(t, "select") + ", 0, 0, 0, 0, tv); }";
    }
    return "function __fern_sleep_ms(ms: i32): i32 { if (ms <= 0) { return 0; } var ts: i32 = __raw_scratch(16); __raw_store_ptr(ts, 0, ms / 1000); __raw_store_ptr(ts, 1, (ms % 1000) * 1000000); return __syscall3(" + sysno(t, "nanosleep") + ", ts, 0, 0); }";
}

// rt_src_poll backs `poll(fds, timeout_ms)` (#2649, syscall-leaf) → the index of
// the first POLLIN-ready fd, or -1.
//
// It builds a `struct pollfd[]` — {i32 fd; i16 events; i16 revents}, eight bytes
// each — with __raw_store_ptr for the fd slot and __raw_store8 for the two
// half-word fields, since the floor has no 16- or 32-bit store. The four
// byte-stores after each fd are not redundant: __raw_store_ptr writes the whole
// word, so a negative fd would sign-extend into `events`.
//
// The call is where the targets part. x86-64 has poll(2), three arguments.
// arm64 Linux has only ppoll, which takes five and wants a `timespec` rather
// than a millisecond count — so a non-negative timeout is written into
// __fern_scratch and a negative one passes NULL, which is ppoll's "block
// forever". Darwin has neither in a form this reaches, and the hand-asm simply
// answered -1; that is preserved rather than quietly changed.
pub function rt_src_poll(t: string): string {
    var call: string = "";
    if (t == "arm64-darwin") {
        // No poll on this target — the hand-asm returned -1 before doing any
        // work, so nothing below it can run.
        return "function __fern_poll(fds: i32[], timeout_ms: i32): i32 { return 0 - 1; }";
    }
    if (t == "x86_64") {
        call = "__syscall3(" + sysno(t, "poll") + ", buf, n, timeout_ms);";
    } else {
        call = "var tmo: i32 = 0; if (timeout_ms >= 0) { var ts: i32 = __raw_scratch(16); __raw_store_ptr(ts, 0, timeout_ms / 1000); __raw_store_ptr(ts, 1, (timeout_ms % 1000) * 1000000); tmo = ts; } __syscall5(" + sysno(t, "ppoll") + ", buf, n, tmo, 0, 0);";
    }
    return "function __fern_poll(fds: i32[], timeout_ms: i32): i32 { var n: i32 = fds.len(); if (n <= 0) { return 0 - 1; } var buf: i32 = __raw_alloc(n * 8); var i: i32 = 0; while (i < n) { __raw_store_ptr(buf, i, fds[i]); __raw_store8(buf, i * 8 + 4, 1); __raw_store8(buf, i * 8 + 5, 0); __raw_store8(buf, i * 8 + 6, 0); __raw_store8(buf, i * 8 + 7, 0); i = i + 1; } " + call + " var j: i32 = 0; while (j < n) { if ((__raw_load8(buf, j * 8 + 6) & 1) != 0) { return j; } j = j + 1; } return 0 - 1; }";
}

// rt_src_proc_waitpid backs `proc_waitpid(pid)` (#2649, syscall-leaf) — reap a
// child and decode its wait status the way a shell does: the termination signal
// plus 128 if it was killed, otherwise the exit code.
//
// wait4(pid, &status, 0, NULL) is four arguments on every target and only the
// number moves, so unlike sleep_ms and poll this one needs no per-target fork at
// all. The Darwin hand-asm carried a manual carry-flag check to turn +errno into
// -errno; that is dropped rather than ported, because darwinize already wraps
// every __syscall* with exactly that sequence.
//
// The status lands in __fern_scratch, so this joins the scratch gate.
pub function rt_src_proc_waitpid(t: string): string {
    return "function __fern_proc_waitpid(pid: i32): i32 { var st: i32 = __raw_scratch(16); var rc: i32 = __syscall4(" + sysno(t, "wait4") + ", pid, st, 0, 0); if (rc < 0) { return rc; } var w: i32 = __load_i32(st); var sig: i32 = w & 127; if (sig != 0) { return sig + 128; } return (w >> 8) & 255; }";
}

// rt_src_proc_exec backs `proc_exec(path, args)` (#2649) — execve(2). It only
// RETURNS on failure, with -errno; on success the process image is gone, and
// that is the builtin's contract.
//
// argv is [path, args..., NULL]: the callee's argv[0] is the program path, so
// callers pass only real arguments. envp comes from __raw_environ(), so the
// child inherits the environment — which is why the op site still marks the
// `env` need that emits the __fern_envp slot and _start's save.
//
// Fern strings are not NUL-terminated, so the path and every argument are
// copied into fresh terminated buffers. Those are deliberately never freed: on
// success the address space is replaced, and on failure the caller is already
// reporting an error.
pub function rt_src_proc_exec(t: string): string {
    return "function __fern_proc_exec(path: string, args: string[]): i32 { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var n: i32 = args.len(); var argv: i32 = __raw_alloc((n + 2) * 8); __raw_store_ptr(argv, 0, pathz); var k: i32 = 0; while (k < n) { var a: string = args[k]; var al: i32 = a.len(); var ab: i32 = __raw_alloc(al + 1); var j: i32 = 0; while (j < al) { __raw_store8(ab, j, a[j]); j = j + 1; } __raw_store8(ab, al, 0); __raw_store_ptr(argv, k + 1, ab); k = k + 1; } __raw_store_ptr(argv, n + 1, 0); return __syscall3(" + sysno(t, "execve") + ", pathz, argv, __raw_environ()); }";
}

// rt_src_proc_fork backs `proc_fork()` (#2649, syscall-leaf) → 0 in the child,
// the child's pid in the parent, -errno on failure — the crash-only supervision
// primitive (docs/CRASH-ONLY-SERVE.md D2', #5686). The kernel's return shape IS
// the contract, so there is nothing to decode.
//
// The two Linux targets disagree on the CALL, not just the number: x86-64 has a
// bare no-argument fork(2), while arm64 has no fork at all and spells it
// clone(SIGCHLD, 0, 0, 0, 0) — five arguments, hence __syscall5.
//
// NOT called for arm64-darwin. XNU's fork returns the pid in x0 with x1 marking
// the child, and no __syscall* intrinsic can see a second return register, so
// that one target keeps a hand-written body (under the __fn___ name, since a
// zero-arg helper's stack and register conventions coincide).
pub function rt_src_proc_fork(t: string): string {
    if (t == "x86_64") {
        return "function __fern_proc_fork(): i32 { return __syscall3(" + sysno(t, "fork") + ", 0, 0, 0); }";
    }
    return "function __fern_proc_fork(): i32 { return __syscall5(" + sysno(t, "clone") + ", 17, 0, 0, 0, 0); }";
}

// rt_src_timer_fd backs `timer_fd(ms)` (#2649, syscall-leaf) → a CLOCK_MONOTONIC
// timerfd that becomes readable after `ms`, or -errno.
//
// Two syscalls: timerfd_create, then timerfd_settime with a `struct itimerspec`
// — four 8-byte words, {it_interval, it_value}, written through
// __raw_store_ptr's word slots in __fern_scratch. A failed create returns before
// the second call, so the fd is never armed behind an error.
//
// Darwin has no timerfd; its hand-asm answered -1 without a syscall and that is
// kept, the same shape as poll.
pub function rt_src_timer_fd(t: string): string {
    if (t == "arm64-darwin") {
        return "function __fern_timer_fd(ms: i32): i32 { return 0 - 1; }";
    }
    return "function __fern_timer_fd(ms: i32): i32 { var fd: i32 = __syscall3(" + sysno(t, "timerfd_create") + ", 1, 0, 0); if (fd < 0) { return fd; } var its: i32 = __raw_scratch(32); __raw_store_ptr(its, 0, 0); __raw_store_ptr(its, 1, 0); __raw_store_ptr(its, 2, ms / 1000); __raw_store_ptr(its, 3, (ms % 1000) * 1000000); __syscall4(" + sysno(t, "timerfd_settime") + ", fd, 0, its, 0); return fd; }";
}

// rt_src_isatty backs `isatty(fd)` (syscall-leaf) -> 1 when fd is a terminal.
//
// The question is a terminal-attribute ioctl, which only a tty answers. Its
// REQUEST number is the platform difference, not the syscall's shape: Linux
// spells it TCGETS (0x5401 = 21505), XNU TIOCGETA (0x40487413 = 1078490131).
// `fstat` + `S_ISCHR` would be simpler and answers yes for /dev/null.
//
// The 80-byte scratch covers `struct termios` on both (60 on Linux, 72 on
// XNU); nothing reads it back, since success is the whole answer.
pub function rt_src_isatty(t: string): string {
    var req: string = "21505";
    if (t == "arm64-darwin") { req = "1078490131"; }
    return "function __fern_isatty(fd: i32): i32 { var buf: i32 = __raw_scratch(80); if (__syscall3(" + sysno(t, "ioctl") + ", fd, " + req + ", buf) == 0) { return 1; } return 0; }";
}

// sockaddr_head writes the first two bytes of a `sockaddr_in`, which is the one
// place the struct's SHAPE differs rather than a constant in it: Linux starts
// with a u16 `sin_family`, XNU with a u8 `sin_len` (= 16) then a u8
// `sin_family`. Everything after — the big-endian port at 2, the address at 4,
// the eight zero bytes at 8 — is identical.
function sockaddr_head(t: string, buf: string): string {
    if (t == "arm64-darwin") {
        return "__raw_store8(" + buf + ", 0, 16); __raw_store8(" + buf + ", 1, 2);";
    }
    return "__raw_store8(" + buf + ", 0, 2); __raw_store8(" + buf + ", 1, 0);";
}

// rt_src_tcp_listen backs `tcp_listen(port)` (#2649, syscall-leaf) → a listening
// socket fd bound to INADDR_ANY:port, or -errno from whichever step failed.
//
// Three syscalls, all three-argument: socket, bind, listen. The sockaddr_in is
// built a byte at a time in __fern_scratch because the floor has no 16- or
// 32-bit store — and the port has to go in big-endian regardless of the host,
// which is what `htons` means and why it is two explicit byte stores rather
// than an endianness-dependent word write.
pub function rt_src_tcp_listen(t: string): string {
    return "function __fern_tcp_listen(port: i32): i32 { var fd: i32 = __syscall3(" + sysno(t, "socket") + ", 2, 1, 0); if (fd < 0) { return fd; } var sa: i32 = __raw_scratch(16); " + sockaddr_head(t, "sa") + " __raw_store8(sa, 2, (port >> 8) & 255); __raw_store8(sa, 3, port & 255); var z: i32 = 4; while (z < 16) { __raw_store8(sa, z, 0); z = z + 1; } var rb: i32 = __syscall3(" + sysno(t, "bind") + ", fd, sa, 16); if (rb < 0) { return rb; } var rl: i32 = __syscall3(" + sysno(t, "listen") + ", fd, 128, 0); if (rl < 0) { return rl; } return fd; }";
}

// rt_src_tcp_connect backs `tcp_connect(host_be, port)` (#2649, syscall-leaf) →
// a connected socket fd, or -errno. Same sockaddr_in as tcp_listen, with the
// address filled in instead of INADDR_ANY.
//
// `host_be` arrives ALREADY in network order, so its four bytes go out in
// little-endian order — reproducing the 32-bit word store the hand-asm did,
// which is not the same as byte-swapping it again.
//
// Migrating this FIXES arm64-darwin. The hand-asm emitted `mov x8, #203`
// (Linux connect) on both targets and relied on darwinize to remap it, but
// darwin_sysno has no 203 row — so the Mach-O output issued Linux syscall 203
// through the Linux trap. Baking the number per target is exactly the mechanism
// that exists because darwinize cannot remap a number it only sees at runtime.
pub function rt_src_tcp_connect(t: string): string {
    return "function __fern_tcp_connect(host_be: i32, port: i32): i32 { var fd: i32 = __syscall3(" + sysno(t, "socket") + ", 2, 1, 0); if (fd < 0) { return fd; } var sa: i32 = __raw_scratch(16); " + sockaddr_head(t, "sa") + " __raw_store8(sa, 2, (port >> 8) & 255); __raw_store8(sa, 3, port & 255); __raw_store8(sa, 4, host_be & 255); __raw_store8(sa, 5, (host_be >> 8) & 255); __raw_store8(sa, 6, (host_be >> 16) & 255); __raw_store8(sa, 7, (host_be >> 24) & 255); var z: i32 = 8; while (z < 16) { __raw_store8(sa, z, 0); z = z + 1; } var rc: i32 = __syscall3(" + sysno(t, "connect") + ", fd, sa, 16); if (rc < 0) { return rc; } return fd; }";
}

// rt_src_udp_send backs `udp_send(host, port, data)` (#2649, #6917) → the bytes
// written, or -errno from whichever step failed.
//
// This op had NO backend case at all: it reached `ir_bin_asm`'s comment fallback
// and the call was silently dropped on both register backends, while arm64 also
// emitted a hand-written `__fern_udp_send` that nothing branched to. The dead
// body is deleted and the op lowers here.
//
// The hand-asm used `sendto`, whose six arguments are past `__syscall5`. It needs
// none: on a datagram socket `connect` only records the peer, so
// connect-then-write sends exactly the same packet with two three-argument calls.
// That is what keeps this slice free of a `__syscall6` and its kind-registry
// churn. The fd is closed on both paths, so the one-shot leaks no descriptor.
//
// `host` is a dotted-quad LITERAL (irlower passes the string, unlike
// tcp_connect's pre-packed i32), so the quad is parsed here — accumulate each
// octet, store on '.', store the last after the loop.
pub function rt_src_udp_send(t: string): string {
    return "function __fern_udp_send(host: string, port: i32, data: string): i32 { var fd: i32 = __syscall3(" + sysno(t, "socket") + ", 2, 2, 0); if (fd < 0) { return fd; } var sa: i32 = __raw_scratch(16); " + sockaddr_head(t, "sa") + " __raw_store8(sa, 2, (port >> 8) & 255); __raw_store8(sa, 3, port & 255); var oct: i32 = 0; var idx: i32 = 0; var i: i32 = 0; var hn: i32 = host.len(); while (i < hn) { var c: i32 = host[i]; if (c == 46) { __raw_store8(sa, 4 + idx, oct & 255); idx = idx + 1; oct = 0; } else { oct = oct * 10 + (c - 48); } i = i + 1; } __raw_store8(sa, 4 + idx, oct & 255); var z: i32 = 8; while (z < 16) { __raw_store8(sa, z, 0); z = z + 1; } var rc: i32 = __syscall3(" + sysno(t, "connect") + ", fd, sa, 16); if (rc < 0) { __syscall3(" + sysno(t, "close") + ", fd, 0, 0); return rc; } var w: i32 = __syscall3(" + sysno(t, "write") + ", fd, __raw_data(data), data.len()); __syscall3(" + sysno(t, "close") + ", fd, 0, 0); return w; }";
}

// rt_src_tcp_send backs `tcp_send(fd, s)` (#2649, syscall-leaf) → bytes written
// or -errno. A single write(2) straight out of the string's own buffer.
//
// This was the last leaf, and it was held up by a floor addition it turned out
// not to need. The blocker was described as a missing `__raw_data` OP — the
// inverse of __raw_string — with the fallback being a byte-by-byte copy of the
// payload on every send. Neither was necessary: a string value already IS its
// box pointer and the data word is slot 0 of that box, so __raw_data lowers to
// the raw_load_ptr the floor has had all along. No copy, and no new op.
pub function rt_src_tcp_send(t: string): string {
    return "function __fern_tcp_send(fd: i32, s: string): i32 { return __syscall3(" + sysno(t, "write") + ", fd, __raw_data(s), s.len()); }";
}

// rt_src_tcp_recv backs `tcp_recv(fd, max)` (#5714, syscall-leaf) → a fresh
// `u8[]` of up to `max` bytes, spread one-per-slot like rt_src_random_bytes. A
// short read, EOF and -errno all come back as the empty array: the op has no
// error channel, so a negative read result clamps to len 0.
pub function rt_src_tcp_recv(t: string): string {
    return "function __fern_tcp_recv(fd: i32, max: i32): i32[] { var p: i32 = __raw_alloc(max); var n: i32 = __syscall3(" + sysno(t, "read") + ", fd, p, max); if (n < 0) { n = 0; } var b: i32 = __raw_arr_box(n); var i: i32 = 0; while (i < n) { __raw_store_ptr(b, i + 1, __raw_load8(p, i)); i = i + 1; } return __raw_array(b); }";
}

// The stdout/stderr leaves (#2649). All four are plain write(2) calls, so unlike
// the fs family they need no per-target constant beyond the syscall number: the
// fd, the byte count and the buffer are the same three arguments everywhere.
// Each returns write's result, which every op site drops — the value exists only
// so the statement-level drop balances.

// rt_src_print_str backs `print_str(s)` / `write(s)` → the string's bytes on fd 1,
// no newline. `s` is read-only, so the borrow analysis keeps it borrowed and the
// helper copies nothing: __raw_data(s) is slot 0 of the box the caller already
// holds.
pub function rt_src_print_str(t: string): string {
    return "function __fern_print_str(s: string): i32 { return __syscall3(" + sysno(t, "write") + ", 1, __raw_data(s), s.len()); }";
}

// rt_src_eprint_str backs `eprint(s)` → the string's bytes on fd 2 followed by a
// '\n'. eprint is the stderr LINE printer, so the trailing newline is part of the
// contract (native and the interpreter both append it). Two writes rather than one
// buffer build: the payload goes straight out of the caller's box, and the newline
// is one byte of the shared static scratch, so the helper allocates nothing.
pub function rt_src_eprint_str(t: string): string {
    return "function __fern_eprint_str(s: string): i32 { __syscall3(" + sysno(t, "write") + ", 2, __raw_data(s), s.len()); var p: i32 = __raw_scratch(1); __raw_store8(p, 0, 10); return __syscall3(" + sysno(t, "write") + ", 2, p, 1); }";
}

// rt_src_putchar backs `putchar(c)` → c's low byte on fd 1, the byte-level twin of
// print_str. The byte is materialised in the shared static scratch; the hand-asm
// used a stack slot, which is the one thing a Fern helper cannot name.
pub function rt_src_putchar(t: string): string {
    return "function __fern_putchar(c: i32): i32 { var p: i32 = __raw_scratch(1); __raw_store8(p, 0, c & 255); return __syscall3(" + sysno(t, "write") + ", 1, p, 1); }";
}

// rt_src_print_int backs `print_int(n)` → n's decimal text on fd 1, no newline.
//
// It takes an i64 so ONE helper serves both print ops: an i32 arrives in the
// stack slot already sign-extended, so op_print_int and the wider op_print_i64
// both call this. That is also the fix for op_print_i64 having had no register-
// backend handler at all — `print_int` on an i64 emitted `# ir: unsupported bin
// print_i64` and dropped the call, printing nothing.
//
// The magnitude is taken in u64 so INT64_MIN prints: `0 - n` leaves it negative
// in i64, but reinterpreted as u64 it is the right magnitude. Both hand-asm
// bodies got that case wrong — x86-64's `negq` overflowed back to INT64_MIN and
// then divided it unsigned, arm64's `sdiv` produced negative digits. Same trick
// rt_src_i64_to_string uses.
//
// 24 scratch bytes hold the widest output: 20 digits plus a sign.
pub function rt_src_print_int(t: string): string {
    return "function __fern_print_int(n: i64): i32 { var p: i32 = __raw_scratch(24); var neg: i32 = 0; var m: i64 = n; if (n < (0 as i64)) { neg = 1; m = (0 as i64) - n; } var v: u64 = m as u64; if (v == (0 as u64)) { __raw_store8(p, 0, 48); return __syscall3(" + sysno(t, "write") + ", 1, p, 1); } var nd: i32 = 0; var t2: u64 = v; while (t2 != (0 as u64)) { nd = nd + 1; t2 = t2 / (10 as u64); } var total: i32 = nd + neg; if (neg == 1) { __raw_store8(p, 0, 45); } var i: i32 = total - 1; while (v != (0 as u64)) { __raw_store8(p, i, 48 + ((v % (10 as u64)) as i32)); v = v / (10 as u64); i = i - 1; } return __syscall3(" + sysno(t, "write") + ", 1, p, total); }";
}

// The two stdin leaves that return no box (#2649) — a bare integer and a bare
// string — so unlike read_line / reader_read_chunk they carry no Option-layout
// question. Both fix a bug the hand-asm had on every target.

// rt_src_read_int backs `read_int()` → one read(2) of up to 16 bytes from fd 0,
// parsed as an optionally-signed decimal. Bytes past the number (the newline, and
// anything else in that 16-byte window) are consumed and discarded: there is no
// pushback, which is why read_int and read_line cannot be mixed on one stream.
//
// It returns i64 because the hand-asm accumulated in a 64-bit register, and the
// op site pushes a 64-bit slot either way.
//
// The `n < 0` clamp is the fix. The hand-asm computed its end pointer as
// `buf + n` from the RAW read return, so a failed read (fd 0 closed → -EBADF)
// put the end BEHIND the start. The loop tests pointer equality and only ever
// advances, so it could never reach that end: it walked uninitialised stack until
// it happened to hit a non-digit, and a leading '-' in the garbage even flipped
// the sign. Witnessed returning 9999 out of a dead frame rather than 0.
pub function rt_src_read_int(t: string): string {
    return "function __fern_read_int(): i64 { var p: i32 = __raw_scratch(16); var n: i32 = __syscall3(" + sysno(t, "read") + ", 0, p, 16); if (n < 0) { n = 0; } var i: i32 = 0; var neg: i32 = 0; if (n > 0) { if (__raw_load8(p, 0) == 45) { neg = 1; i = 1; } } var acc: i64 = 0 as i64; while (i < n) { var c: i32 = __raw_load8(p, i); if (c < 48) { i = n; } else { if (c > 57) { i = n; } else { acc = acc * (10 as i64) + ((c - 48) as i64); i = i + 1; } } } if (neg == 1) { acc = (0 as i64) - acc; } return acc; }";
}

// rt_src_read_all_stdin backs `read_all_stdin()` → fd 0 drained to EOF into one
// string. `__raw_string` is exactly what the hand-asm did by hand (it called
// __fern_str_box, which is what the op lowers to), so the returned box is
// byte-identical and no consumer sees a change.
//
// The capacity clamp is the fix. The hand-asm's only loop exit was `read <= 0`;
// nothing compared the write cursor against the end of the 32 MiB block, so a
// larger input ran straight past it. That does not fault — the block sits inside
// the 16 GiB MAP_NORESERVE arena, so the writes land in mapped memory and corrupt
// whatever follows, including the str box allocated immediately after the buffer.
// Witnessed: 33 MiB of input reported len=34603008 and exited 0.
//
// Input past the cap is now truncated rather than corrupting the heap. Growing
// the buffer instead would need a copy on every doubling; the bound is what makes
// this safe, and raising it is a separate decision.
pub function rt_src_read_all_stdin(t: string): string {
    return "function __fern_read_all_stdin(): string { var cap: i32 = 33554432; var p: i32 = __raw_alloc(cap); var total: i32 = 0; var go: i32 = 1; while (go == 1) { var want: i32 = 1048576; if (total + want > cap) { want = cap - total; } if (want <= 0) { go = 0; } else { var n: i32 = __syscall3(" + sysno(t, "read") + ", 0, __raw_addr(p, total), want); if (n <= 0) { go = 0; } else { total = total + n; } } } return __raw_string(p, total); }";
}

// The three Option-returning Reader leaves (#2649). Here the migration is the RC
// FIX, not a risk to be managed.
//
// Each hand-asm built its result with bare __fern_alloc, so the boxes carried NO
// refcount header — read_line's inner strbox, and both of read_chunk's boxes plus
// its Option. __fn___fern_str_free / __fn___fern_arr_dec read the refcount at
// box-8, so a dec of one of those reads the last word of the PRECEDING
// allocation; if that word happens to be 1, the block is pushed onto a freelist
// bin chosen from another garbage word. Heap corruption rather than a clean crash.
//
// That never fired only because nothing decs them: the match lowering frees a
// scrutinee box only for a map.get scrutinee, and the optret drop machinery only
// fires for a direct Some(...) ctor or a function in the OPTFRESH registry — an op
// is in neither set, so the boxes simply leak. The nearest miss is std/io's
// `chunks.append(chunk)`: had `chunks` qualified for element reclaim, the exit
// sweep would str_free each headerless element, and it fails to qualify only
// because a bare ident may alias.
//
// Ordinary Some(__raw_string(...)) lowering keeps the payload at offset 8 and the
// tag at 0 exactly where they were, and puts a real rc=1 at box-8. Nothing reads
// that header today; anything that later does now reads a valid one.

// rt_src_reader_read_chunk backs `r.read_chunk(n)` → up to n bytes from fd, or
// None. EOF and -errno both come back as None, as the hand-asm's single `<= 0`
// test did: the op has no error channel to tell them apart.
//
// The buffer is allocated at n and boxed at the SHORT length, so the block is
// wider than the string thinks it is — what the hand-asm did.
pub function rt_src_reader_read_chunk(t: string): string {
    return "function __fern_reader_read_chunk(fd: i32, n: i32): Option[string] { var p: i32 = __raw_alloc(n); var r: i32 = __syscall3(" + sysno(t, "read") + ", fd, p, n); if (r <= 0) { return None; } return Some(__raw_string(p, r)); }";
}

// rt_src_reader_close backs `r.close()` → close(fd), always None. The close
// result is deliberately discarded: the error arm is unused by the std/io drain
// loop, and reporting one now would be a behaviour change rather than a
// migration. `Option[IoError]` needs no classifier — None constructs no payload —
// so this helper stays outside the fs bundle.
pub function rt_src_reader_close(t: string): string {
    return "function __fern_reader_close(fd: i32): Option[IoError] { __syscall3(" + sysno(t, "close") + ", fd, 0, 0); return None; }";
}

// rt_src_read_line backs `read_line()` → one line from fd 0 including its '\n',
// None at EOF with nothing read.
//
// ONE BYTE PER SYSCALL, which is load-bearing and not an oversight (#6052): a
// single read(0, buf, 256) silently discarded every byte past the first newline,
// because only the line was boxed and the rest of the buffer was dropped — a
// read-until-EOF loop saw the first line and then a spurious EOF. Reading one byte
// at a time is correct by construction, since the syscall never consumes a byte
// this call will not return, and it leaves the rest of the stream in the OS for
// the next call or a child process. `__raw_addr` supplies the moving destination.
//
// The 256-byte cap is observable — a longer line comes back truncated, with the
// remainder left on the stream — so it is preserved exactly.
pub function rt_src_read_line(t: string): string {
    return "function __fern_read_line(): Option[string] { var buf: i32 = __raw_alloc(256); var len: i32 = 0; var go: i32 = 1; while (go == 1) { if (len >= 256) { go = 0; } else { var r: i32 = __syscall3(" + sysno(t, "read") + ", 0, __raw_addr(buf, len), 1); if (r < 1) { go = 0; } else { var c: i32 = __raw_load8(buf, len); len = len + 1; if (c == 10) { go = 0; } } } } if (len == 0) { return None; } return Some(__raw_string(buf, len)); }";
}

// rt_src_io_error is the shared errno→IoError classifier the Fern fs helpers CALL
// (#2649) — the single definition of the mapping native's __fern_io_error carries,
// so the fs leaves stop INLINING the five-way branch and just call it. `path` is
// consumed (moved into the path-carrying variant, or dropped by RC on the
// payload-less Interrupted branch), so callers hand it a FRESH string. Emitted
// once and bundled with the fs helpers that call it (each backend's fs-helper
// bundle), so the standard inter-procedural RC analysis threads the call-graph
// edge — this IS the #2649 "dependencies are the call graph" end-state, in
// miniature. Bundled on BOTH register backends now; the arm64 register-ABI
// hand-asm __fern_io_error survives only for the leaves still hand-written there
// (stat / read_dir / remove_dir_all / temp_dir / open_fd).
pub function rt_src_io_error(): string {
    return "function __fern_io_error(e: i32, path: string): IoError { if (e == 2) { return NotFound(path); } if (e == 13) { return PermissionDenied(path); } if (e == 17) { return AlreadyExists(path); } if (e == 4) { return Interrupted; } return Other(path, \"\"); }";
}

// rt_src_utf8_valid is read_file's strict D9 well-formedness scan (#5714),
// bundled with the fs helpers whenever read_file is. Same acceptance as
// std/utf8.is_valid_utf8, in the byte-range formulation: continuation bytes
// are 128..191, leads below 194 reject (stray continuations + overlong
// 2-byte), E0's first continuation needs >= 160 (overlong) and ED's < 160
// (surrogates), F0's needs >= 144 (overlong) and F4's < 144 (> U+10FFFF),
// leads above 244 reject, and every truncated sequence rejects. Pure
// comparisons — no bitwise ops — so it stays inside the runtime
// sub-language's proven surface.
pub function rt_src_utf8_valid(): string {
    return "function __fern_utf8_valid(buf: i32, n: i32): i32 { var i: i32 = 0; while (i < n) { var b0: i32 = __raw_load8(buf, i); if (b0 < 128) { i = i + 1; } else { if (b0 < 194) { return 0; } if (b0 < 224) { if (i + 2 > n) { return 0; } var c1: i32 = __raw_load8(buf, i + 1); if (c1 < 128) { return 0; } if (c1 > 191) { return 0; } i = i + 2; } else { if (b0 < 240) { if (i + 3 > n) { return 0; } var d1: i32 = __raw_load8(buf, i + 1); var d2: i32 = __raw_load8(buf, i + 2); if (d1 < 128) { return 0; } if (d1 > 191) { return 0; } if (d2 < 128) { return 0; } if (d2 > 191) { return 0; } if (b0 == 224) { if (d1 < 160) { return 0; } } if (b0 == 237) { if (d1 > 159) { return 0; } } i = i + 3; } else { if (b0 > 244) { return 0; } if (i + 4 > n) { return 0; } var e1: i32 = __raw_load8(buf, i + 1); var e2: i32 = __raw_load8(buf, i + 2); var e3: i32 = __raw_load8(buf, i + 3); if (e1 < 128) { return 0; } if (e1 > 191) { return 0; } if (e2 < 128) { return 0; } if (e2 > 191) { return 0; } if (e3 < 128) { return 0; } if (e3 > 191) { return 0; } if (b0 == 240) { if (e1 < 144) { return 0; } } if (b0 == 244) { if (e1 > 143) { return 0; } } i = i + 4; } } } } return 1; }";
}

// rt_src_remove_file backs `remove_file(path)` (#2649, syscall-leaf) →
// Result[void, IoError]. NUL-terminate the path, unlinkat(AT_FDCWD, path, 0)
// (3-arg, so __syscall3 suffices), Ok(()) on success / on failure the errno
// classified by the shared __fern_io_error (bundled with this helper) — handed a
// FRESH path string, so the borrowed `path` param is never stored. Same body on
// every native target; only the unlinkat number and AT_FDCWD come from `t`.
pub function rt_src_remove_file(t: string): string {
    return "function __fern_remove_file(path: string): Result[void, IoError] { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var rc: i32 = __syscall3(" + sysno(t, "unlinkat") + ", " + at_fdcwd(t) + ", pathz, 0); if (rc < 0) { return Err(__fern_io_error(0 - rc, __raw_string(pathz, plen))); } return Ok(()); }";
}

// rt_src_create_dir_all backs `create_dir_all(path)` (#2649, syscall-leaf) →
// Result[void, IoError]. NUL-terminate the path, then mkdirat(AT_FDCWD, prefix,
// 0777) at every '/' — the separator is overwritten with a NUL for the call and
// put back after — and finally for the whole path. The intermediate results are
// discarded: a parent that could not be created makes the final mkdirat fail
// with the same errno, so one error path reports for the whole walk. EEXIST (17)
// on the leaf is success, which is what makes an already-present path Ok. Same
// body on every native target; only the mkdirat number and AT_FDCWD come from
// `t`.
pub function rt_src_create_dir_all(t: string): string {
    var mk: string = "__syscall3(" + sysno(t, "mkdirat") + ", " + at_fdcwd(t) + ", pathz, 511)";
    return "function __fern_create_dir_all(path: string): Result[void, IoError] { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var rc: i32 = 0; var j: i32 = 1; while (j < plen) { if (path[j] == 47) { if (path[j - 1] != 47) { __raw_store8(pathz, j, 0); rc = " + mk + "; __raw_store8(pathz, j, 47); } } j = j + 1; } rc = " + mk + "; if (rc < 0) { if (rc != 0 - 17) { return Err(__fern_io_error(0 - rc, __raw_string(pathz, plen))); } } return Ok(()); }";
}

// rt_src_write_file backs `write_file(path, contents)` (#2649, syscall-leaf) →
// Result[void, IoError]. NUL-terminate the path, openat(AT_FDCWD, path,
// O_WRONLY|O_CREAT|O_TRUNC, mode=420=0644) — the mode arg is meaningful, so this
// is the __syscall4 user. Copy the contents bytes into a buffer, write them with
// a short-write loop, close. Ok(()) on success; on openat failure the errno
// classified by the shared __fern_io_error (bundled with this helper), handed a
// FRESH path string. Only the syscall numbers, AT_FDCWD and the open flag-set
// come from `t` — the flag-set genuinely differs (577 Linux / 1537 Darwin).
pub function rt_src_write_file(t: string): string {
    return rt_src_write_file_mode(t, "__fern_write_file", "420", "");
}

// rt_src_write_file_exec backs `write_file_exec` — write_file with the
// executable bit (0755 = 493). A compiler that emits a finished binary has to
// be able to produce a runnable one, and the self-host CLI could not: it wrote
// 0644 where the native CLI writes 0755, and a non-executable binary run under
// qemu exits 1 with no output — indistinguishable from a program that ran and
// returned 1 (#6133).
pub function rt_src_write_file_exec(t: string): string {
    // fchmod AFTER the write, because openat's mode argument only applies when
    // it CREATES the file — recompiling over a stale 0644 output would
    // otherwise leave it unrunnable, which is the whole failure this builtin
    // removes. Plain write_file deliberately does NOT do this: it would force
    // an existing file's mode, where today it preserves it, and that is also
    // what os.WriteFile (the interpreter) does.
    return rt_src_write_file_mode(t, "__fern_write_file_exec", "493",
        "__syscall3(" + sysno(t, "fchmod") + ", fd, 493, 0); ");
}

// rt_src_write_file_mode is the shared body, parameterised by emitted function
// name, creation mode (DECIMAL, as the emitted source is Fern: 420 = 0644,
// 493 = 0755) and an optional statement spliced in before close(2). One body so
// the two cannot drift.
pub function rt_src_write_file_mode(t: string, fname: string, mode: string, fixup: string): string {
    return "function " + fname + "(path: string, contents: string): Result[void, IoError] { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var fd: i32 = __syscall4(" + sysno(t, "openat") + ", " + at_fdcwd(t) + ", pathz, " + oflag(t, "wr_creat_trunc") + ", " + mode + "); if (fd < 0) { return Err(__fern_io_error(0 - fd, __raw_string(pathz, plen))); } var clen: i32 = contents.len(); var cbuf: i32 = __raw_alloc(clen + 1); var j: i32 = 0; while (j < clen) { __raw_store8(cbuf, j, contents[j]); j = j + 1; } var put: i32 = 0; while (put < clen) { var w: i32 = __syscall3(" + sysno(t, "write") + ", fd, __raw_addr(cbuf, put), clen - put); if (w <= 0) { put = clen; } else { put = put + w; } } " + fixup + "__syscall3(" + sysno(t, "close") + ", fd, 0, 0); return Ok(()); }";
}

// rt_src_env backs `env(name)` (#2649) → Option[string]. Walks the process envp
// array (via __raw_environ, the saved __fern_envp) for a "name=value" entry, then
// COPIES the value into a fresh heap string. Unlike the hand-asm (which boxed the
// kernel-immortal bytes in place), it copies because the entry pointer is a high
// stack address the i32 raw-pointer floor can't offset 64-bit-safely as a Fern
// value — but __raw_load8(entry, off) offsets in the emitter, so per-byte reads
// are safe. x86-64-only: it needs no syscall at all, just the __raw_environ op,
// which the arm64 emitter does not implement yet — that is the whole blocker.
pub function rt_src_env(): string {
    return "function __fern_env(name: string): Option[string] { var nlen: i32 = name.len(); var envp: i32 = __raw_environ(); var idx: i32 = 0; var done: i32 = 0; while (done == 0) { var entry: i32 = __raw_load_ptr(envp, idx); if (entry == 0) { done = 1; } else { var m: i32 = 1; var k: i32 = 0; while (k < nlen) { if (__raw_load8(entry, k) != name[k]) { m = 0; k = nlen; } else { k = k + 1; } } if (m == 1) { if (__raw_load8(entry, nlen) == 61) { var vs: i32 = nlen + 1; var vlen: i32 = 0; while (__raw_load8(entry, vs + vlen) != 0) { vlen = vlen + 1; } var vbuf: i32 = __raw_alloc(vlen + 1); var c: i32 = 0; while (c < vlen) { __raw_store8(vbuf, c, __raw_load8(entry, vs + c)); c = c + 1; } return Some(__raw_string(vbuf, vlen)); } } idx = idx + 1; } } return None; }";
}

// rt_src_temp_dir backs `temp_dir(prefix)` (#2649, syscall-leaf) → Result[string,
// IoError]. Builds a uniquely-named /tmp/<prefix>-<monotonic_ns> path with the
// raw-memory intrinsics (inline i64→digits, like the hand-asm — avoids pulling in
// str_concat / i64_to_string helper deps; monotonic_ns is a builtin callee, marked
// by the op handler), mkdirat(AT_FDCWD, path, 0700=448) via __syscall3, returns
// Ok(path) — the built buffer becomes the string — or, on failure, the errno
// classified by the shared __fern_io_error (bundled with this helper), handed a
// FRESH copy of the built path. Same body on every native target: mkdirat is
// number-compatible across all three (258 / 34 / 475), so only the number and
// AT_FDCWD come from `t`. /tmp exists on Linux and XNU alike.
pub function rt_src_temp_dir(t: string): string {
    return "function __fern_temp_dir(prefix: string): Result[string, IoError] { var ns: i64 = monotonic_ns(); var plen: i32 = prefix.len(); var ndig: i32 = 1; var tt: i64 = ns; while (tt >= (10 as i64)) { ndig = ndig + 1; tt = tt / (10 as i64); } var total: i32 = 5 + plen + 1 + ndig; var buf: i32 = __raw_alloc(total + 1); __raw_store8(buf, 0, 47); __raw_store8(buf, 1, 116); __raw_store8(buf, 2, 109); __raw_store8(buf, 3, 112); __raw_store8(buf, 4, 47); var i: i32 = 0; while (i < plen) { __raw_store8(buf, 5 + i, prefix[i]); i = i + 1; } __raw_store8(buf, 5 + plen, 45); var pos: i32 = total - 1; var v: i64 = ns; if (v == (0 as i64)) { __raw_store8(buf, pos, 48); } else { while (v > (0 as i64)) { __raw_store8(buf, pos, 48 + ((v % (10 as i64)) as i32)); v = v / (10 as i64); pos = pos - 1; } } __raw_store8(buf, total, 0); var rc: i32 = __syscall3(" + sysno(t, "mkdirat") + ", " + at_fdcwd(t) + ", buf, 448); if (rc < 0) { return Err(__fern_io_error(0 - rc, __raw_string(buf, total))); } return Ok(__raw_string(buf, total)); }";
}

// rt_src_read_file backs `read_file(path)` (#2649, syscall-leaf) → Result[string,
// IoError]. NUL-terminate the path, openat(AT_FDCWD, path, O_RDONLY=0) (mode is
// ignored without O_CREAT, so __syscall3 suffices), lseek-size the file, read it
// into a sized buffer that BECOMES the returned string (RC-managed), close,
// then the D9 gate (#5714): content that is not well-formed UTF-8 returns
// Err(InvalidUtf8(path)) via __fern_utf8_valid (bundled alongside). On
// open/read failure the errno is classified by the shared __fern_io_error
// (bundled with this helper), handed a FRESH path string, so the borrowed
// `path` param is never stored. Raw reads go through read_file_bytes.
//
// The read is a LOOP now, not the single read this helper shipped with. That
// single read was a workaround for the missing pointer-offset primitive — the
// comment here used to say the i32 raw-pointer floor "can't do 64-bit-safe
// `buf + offset` arithmetic on a high heap buffer", which was true of `+` and is
// what `__raw_addr` exists to fix. The loop matches what every hand-asm
// read_file did, so a short read (a signal, a pipe-backed fd) no longer silently
// truncates the file. Still i32-sized, so > 2 GiB is out of scope either way.
pub function rt_src_read_file(t: string): string {
    return "function __fern_read_file(path: string): Result[string, IoError] { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var fd: i32 = __syscall3(" + sysno(t, "openat") + ", " + at_fdcwd(t) + ", pathz, 0); if (fd < 0) { return Err(__fern_io_error(0 - fd, __raw_string(pathz, plen))); } var size: i32 = __syscall3(" + sysno(t, "lseek") + ", fd, 0, 2); __syscall3(" + sysno(t, "lseek") + ", fd, 0, 0); var buf: i32 = __raw_alloc(size + 1); var got: i32 = 0; var bad: i32 = 0; var done: i32 = 0; while (done == 0) { if (got >= size) { done = 1; } else { var n: i32 = __syscall3(" + sysno(t, "read") + ", fd, __raw_addr(buf, got), size - got); if (n < 0) { bad = n; done = 1; } else { if (n == 0) { done = 1; } else { got = got + n; } } } } __syscall3(" + sysno(t, "close") + ", fd, 0, 0); if (bad < 0) { return Err(__fern_io_error(0 - bad, __raw_string(pathz, plen))); } if (__fern_utf8_valid(buf, got) == 0) { return Err(InvalidUtf8(__raw_string(pathz, plen))); } return Ok(__raw_string(buf, got)); }";
}

// rt_src_read_file_bytes backs `read_file_bytes(path)` (read_file's raw sibling)
// → Result[u8[], IoError]. Same syscall pipeline and error classification as
// rt_src_read_file, but the success path spreads the raw buffer into a fresh
// array box (__raw_arr_box, one byte per slot — the self-host u8[] model, like
// random_bytes). The box is sized to the lseek size, so a file that shrinks
// between the size query and the read leaves trailing zero slots with len still
// the queried size.
pub function rt_src_read_file_bytes(t: string): string {
    return "function __fern_read_file_bytes(path: string): Result[i32[], IoError] { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var fd: i32 = __syscall3(" + sysno(t, "openat") + ", " + at_fdcwd(t) + ", pathz, 0); if (fd < 0) { return Err(__fern_io_error(0 - fd, __raw_string(pathz, plen))); } var size: i32 = __syscall3(" + sysno(t, "lseek") + ", fd, 0, 2); __syscall3(" + sysno(t, "lseek") + ", fd, 0, 0); var buf: i32 = __raw_alloc(size + 1); var got: i32 = 0; var bad: i32 = 0; var done: i32 = 0; while (done == 0) { if (got >= size) { done = 1; } else { var n: i32 = __syscall3(" + sysno(t, "read") + ", fd, __raw_addr(buf, got), size - got); if (n < 0) { bad = n; done = 1; } else { if (n == 0) { done = 1; } else { got = got + n; } } } } __syscall3(" + sysno(t, "close") + ", fd, 0, 0); if (bad < 0) { return Err(__fern_io_error(0 - bad, __raw_string(pathz, plen))); } var b: i32 = __raw_arr_box(size); var j: i32 = 0; while (j < got) { __raw_store_ptr(b, j + 1, __raw_load8(buf, j)); j = j + 1; } while (j < size) { __raw_store_ptr(b, j + 1, 0); j = j + 1; } return Ok(__raw_array(b)); }";
}

// rt_src_read_dir backs `read_dir(path)` (#2649, syscall-leaf) → Result[string[],
// IoError]. NUL-terminate the path, openat(AT_FDCWD, path, O_RDONLY|O_DIRECTORY),
// then DRAIN the directory with a loop of getdents reads into a FRESH 64 KiB
// buffer each iteration — appending each entry's base name (skipping "." / "..")
// to a string[]. The fresh-buffer-per-read shape avoids the `buf + off` pointer
// arithmetic the i32 raw-pointer floor cannot do 64-bit-safely (a directory
// record is never split across calls, so each buffer parses independently); the
// record fields are read via __raw_load8(buf, pos+k), which offsets in the
// emitter. On openat failure the errno is classified by the shared
// __fern_io_error (bundled with this helper), handed a FRESH path string. The
// result string[] is built with .append() (→ __fern_arr_push / arr_push_owned
// for the sole-owner local, like str_split).
//
// This was recorded as needing "a per-target body, not a per-target number",
// on two grounds. Both turn out to be table rows over the existing floor:
//
//   * Darwin's getdirentries64 takes a 4th out-param (the updated directory
//     position) that getdents64 has no equivalent of. __syscall4 is already in
//     the floor, so the body issues FOUR arguments on every target and hands
//     Linux a pointer it ignores — getdents64 reads three. That is deliberate:
//     one arity beats branching, and an ignored register is free. The slot is
//     an ordinary 8-byte __raw_alloc rather than __raw_scratch, because scratch
//     is a single shared buffer and stat / the clocks also want it.
//   * The dirent layouts differ, but only in where the name starts (19 vs 21,
//     XNU carrying a d_namlen the Linux record does not) — direntoff.
//
// What is NOT a table row is O_DIRECTORY: 65536 on Linux, 1048576 on XNU. The
// Linux value on Darwin means O_NDELAY|O_ASYNC, so the open SUCCEEDS and the
// first read fails — see oflag.
pub function rt_src_read_dir(t: string): string {
    var nameoff: string = direntoff(t, "name");
    return "function __fern_read_dir(path: string): Result[string[], IoError] { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var fd: i32 = __syscall3(" + sysno(t, "openat") + ", " + at_fdcwd(t) + ", pathz, " + oflag(t, "rd_directory") + "); if (fd < 0) { return Err(__fern_io_error(0 - fd, __raw_string(pathz, plen))); } var basep: i32 = __raw_alloc(8); var names: string[] = []; var done: i32 = 0; while (done == 0) { var buf: i32 = __raw_alloc(65536); var n: i32 = __syscall4(" + sysno(t, "getdents") + ", fd, buf, 65536, basep); if (n <= 0) { done = 1; } else { var pos: i32 = 0; while (pos < n) { var reclen: i32 = __raw_load8(buf, pos + 16) + __raw_load8(buf, pos + 17) * 256; var nlen: i32 = 0; while (__raw_load8(buf, pos + " + nameoff + " + nlen) != 0) { nlen = nlen + 1; } var skip: i32 = 0; if (nlen == 1) { if (__raw_load8(buf, pos + " + nameoff + ") == 46) { skip = 1; } } if (nlen == 2) { if (__raw_load8(buf, pos + " + nameoff + ") == 46) { if (__raw_load8(buf, pos + " + nameoff + " + 1) == 46) { skip = 1; } } } if (skip == 0) { var nbuf: i32 = __raw_alloc(nlen + 1); var k: i32 = 0; while (k < nlen) { __raw_store8(nbuf, k, __raw_load8(buf, pos + " + nameoff + " + k)); k = k + 1; } names = names.append(__raw_string(nbuf, nlen)); } pos = pos + reclen; } } } __syscall3(" + sysno(t, "close") + ", fd, 0, 0); return Ok(names); }";
}

// rt_src_remove_dir_all backs `remove_dir_all(path)` (#2649, the last fs leaf) →
// Result[void, IoError]. Recursive post-order delete: open the dir, walk it with
// its own getdents loop over a fresh 64 KiB buffer per read (the read_dir shape,
// duplicated rather than shared because this one needs the child path, not the
// name array), recurse into every entry, then rmdir the directory itself.
//
// A missing path is Ok (idempotent delete). ENOTDIR (20 on both Linux and XNU)
// means the path is a plain file, so unlink it and report success — that is what
// makes `remove_dir_all` usable as "delete this, whatever it is".
//
// Recursing on EVERY entry rather than branching on d_type is deliberate: the
// recursive call's own ENOTDIR arm unlinks a file, so one path handles both, and
// d_type is not reliable on every filesystem (DT_UNKNOWN). It costs an extra
// openat per file.
//
// The raw getdents buffer + child-path buffers are __raw_alloc'd (bump-only,
// never freed within the call) — the same trade the rest of the syscall leaves
// make. Target-parameterised on the same rows as read_dir, plus AT_REMOVEDIR
// (512 on Linux, 128 on XNU — atflag).
pub function rt_src_remove_dir_all(t: string): string {
    var nameoff: string = direntoff(t, "name");
    return "function __fern_remove_dir_all(path: string): Result[void, IoError] { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var fd: i32 = __syscall3(" + sysno(t, "openat") + ", " + at_fdcwd(t) + ", pathz, " + oflag(t, "rd_directory") + "); if (fd < 0) { var e: i32 = 0 - fd; if (e == 2) { return Ok(()); } if (e == 20) { __syscall3(" + sysno(t, "unlinkat") + ", " + at_fdcwd(t) + ", pathz, 0); return Ok(()); } return Err(__fern_io_error(e, __raw_string(pathz, plen))); } var basep: i32 = __raw_alloc(8); var done: i32 = 0; while (done == 0) { var buf: i32 = __raw_alloc(65536); var n: i32 = __syscall4(" + sysno(t, "getdents") + ", fd, buf, 65536, basep); if (n <= 0) { done = 1; } else { var pos: i32 = 0; while (pos < n) { var reclen: i32 = __raw_load8(buf, pos + 16) + __raw_load8(buf, pos + 17) * 256; var nl: i32 = 0; while (__raw_load8(buf, pos + " + nameoff + " + nl) != 0) { nl = nl + 1; } var skip: i32 = 0; if (nl == 1) { if (__raw_load8(buf, pos + " + nameoff + ") == 46) { skip = 1; } } if (nl == 2) { if (__raw_load8(buf, pos + " + nameoff + ") == 46) { if (__raw_load8(buf, pos + " + nameoff + " + 1) == 46) { skip = 1; } } } if (skip == 0) { var cl: i32 = plen + 1 + nl; var cb: i32 = __raw_alloc(cl + 1); var a: i32 = 0; while (a < plen) { __raw_store8(cb, a, path[a]); a = a + 1; } __raw_store8(cb, plen, 47); var b: i32 = 0; while (b < nl) { __raw_store8(cb, plen + 1 + b, __raw_load8(buf, pos + " + nameoff + " + b)); b = b + 1; } __raw_store8(cb, cl, 0); match (__fern_remove_dir_all(__raw_string(cb, cl))) { Ok(_) => {}, Err(_) => {} } } pos = pos + reclen; } } } __syscall3(" + sysno(t, "close") + ", fd, 0, 0); __syscall3(" + sysno(t, "unlinkat") + ", " + at_fdcwd(t) + ", pathz, " + atflag(t, "removedir") + "); return Ok(()); }";
}

// clock_read emits the statements that leave `sec` and `sub` bound — the
// seconds and the SUBSECOND count the kernel wrote, whatever unit that is on
// this target. Everything target-specific about the clocks lives here; the
// three helpers below differ only in arithmetic.
//
// Linux takes `clock_gettime(clk_id, &timespec)` and fills
// `{ i64 tv_sec @0; i64 tv_nsec @8 }`. XNU has no clock_gettime syscall, so
// Darwin takes `gettimeofday(&timeval, NULL)` — note the buffer is the FIRST
// argument, not the second — and fills `{ i64 tv_sec @0; i32 tv_usec @8 }`.
// Three things move at once, which is why this is not a sysno row: the number,
// the argument order, and the subsecond field's WIDTH. That last one is load-
// bearing — `tv_usec` is 32 bits with 4 bytes of padding after it, and nothing
// promises the kernel zeroed that padding, so it must be `__load_i32`. Reading
// the slot as an i64 would splice the padding into the high half.
//
// Errno is ignored on both: with a fixed clock id and a buffer we own, the
// realistic failures (EFAULT / EINVAL) cannot fire.
function clock_read(t: string, clk: string): string {
    if (t == "arm64-darwin") {
        return "var ts: i32 = __raw_scratch(16); __syscall3(" + sysno(t, "gettimeofday") + ", ts, 0, 0); var sec: i64 = __load_i64(ts); var sub: i64 = __load_i32(__raw_addr(ts, 8)) as i64;";
    }
    return "var ts: i32 = __raw_scratch(16); __syscall3(" + sysno(t, "clock_gettime") + ", " + clk + ", ts, 0); var sec: i64 = __load_i64(ts); var sub: i64 = __load_i64(__raw_addr(ts, 8));";
}

// subsec_ns / subsec_per_ms convert `sub` for the two arithmetic shapes below:
// how many nanoseconds one subsecond tick is (1 for a nsec timespec, 1000 for a
// usec timeval), and how many ticks make a millisecond.
function subsec_ns(t: string): string {
    if (t == "arm64-darwin") { return "1000"; }
    return "1";
}

function subsec_per_ms(t: string): string {
    if (t == "arm64-darwin") { return "1000"; }
    return "1000000";
}

// rt_src_clock backs the clock builtins (#2649, syscall-leaf slice 2): `which`
// selects monotonic_ns / now_ns / now_unix_ms. Each reads the wall or monotonic
// clock into the fixed static scratch buffer (reused, so no per-call leak) and
// does i64 math. CLOCK_MONOTONIC = 1, CLOCK_REALTIME = 0. Allocation-free
// (scratch is static, not heap), so these emit independently of the heap
// runtime. One compiler function for the three helpers keeps the merged-bundle
// self-compile under its function budget (#3425).
//
// `monotonic_ns` has NO Darwin form here, and that is a real gap rather than an
// omission: XNU's monotonic clock on Apple Silicon is a read of the
// architectural counter (`mrs cntvct_el0`, scaled by `cntfrq_el0`), not a
// syscall, and Fern has no system-register-read intrinsic. asm_arm64_ir keeps
// the hand-asm for that one case. `now_unix_ms` / `now_ns` need no such thing —
// gettimeofday is an ordinary syscall — so they migrate on every native target.
pub function rt_src_clock(which: string, t: string): string {
    if (which == "monotonic_ns") {
        return "function __fern_monotonic_ns(): i64 { " + clock_read(t, "1") + " return sec * (1000000000 as i64) + sub * (" + subsec_ns(t) + " as i64); }";
    }
    if (which == "now_unix_ms") {
        return "function __fern_now_unix_ms(): i64 { " + clock_read(t, "0") + " return sec * (1000 as i64) + sub / (" + subsec_per_ms(t) + " as i64); }";
    }
    return "function __fern_now_ns(): i64 { " + clock_read(t, "0") + " return sec * (1000000000 as i64) + sub * (" + subsec_ns(t) + " as i64); }";
}

// rt_src_stat backs `stat(path)` (#2649) — the first syscall leaf that returned
// a user-typed Result[FileStat, IoError]. NUL-terminate the path, fstatat into
// the fixed static scratch buffer, read st_mode + st_size back with __load_i32 /
// __load_i64, classify by S_IFMT, and build Ok(FileStat{...}) — or, on failure,
// the errno classified by the shared __fern_io_error (bundled with this helper),
// handed a FRESH path string so the borrowed `path` param is never stored.
//
// One body for all three targets, which took unifying on the **4-arg fstatat**
// family: x86-64 newfstatat 262, arm64-linux newfstatat 79, arm64-darwin
// fstatat64 470, all `(dirfd, path, buf, flags)` with flags 0 meaning
// follow-symlinks. This helper used to call x86-64's 2-arg `stat` (4), which
// arm64-linux does not have at all — that asymmetry, plus the differing field
// offsets, is why #6352/#6356 recorded stat as needing a per-target BODY. It
// does not: with fstatat and asmcore.statoff it is the same constant
// substitution as the other leaves. (The u16 st_mode on Darwin needs no special
// read — see statoff.)
//
// The two field reads go through `__raw_addr(buf, off)`, not `buf + off` (#6386).
// `__load_i32` / `__load_i64` take a bare address with no offset operand to fold,
// so a bare `+` is an i32 add: arm64 sign-extends it back to 32 bits and the
// address is truncated. Invisible wherever the image sits below 4 GiB — which is
// every Linux target — but Mach-O's __PAGEZERO puts __fern_scratch above
// 0x100000000, so on arm64-darwin the truncated address landed in the unmapped
// page-zero and `stat` segfaulted on every path that EXISTS (the Err arm returns
// before the loads, which is why only stat_dir / fs_builtins_lifecycle failed).
pub function rt_src_stat(t: string): string {
    return "function __fern_stat(path: string): Result[FileStat, IoError] { var plen: i32 = path.len(); var pathz: i32 = __raw_alloc(plen + 1); var i: i32 = 0; while (i < plen) { __raw_store8(pathz, i, path[i]); i = i + 1; } __raw_store8(pathz, plen, 0); var buf: i32 = __raw_scratch(160); var rc: i32 = __syscall4(" + sysno(t, "fstatat") + ", " + at_fdcwd(t) + ", pathz, buf, 0); if (rc < 0) { return Err(__fern_io_error(0 - rc, __raw_string(pathz, plen))); } var mode: i32 = __load_i32(__raw_addr(buf, " + statoff(t, "mode") + ")); var size: i64 = __load_i64(__raw_addr(buf, " + statoff(t, "size") + ")); var mfmt: i32 = mode & 61440; var isf: boolean = mfmt == 32768; var isd: boolean = mfmt == 16384; return Ok(FileStat { is_file: isf, is_dir: isd, size: size }); }";
}

pub function (s: EmitState) mark_eprint(): EmitState {
    return s.need("eprint");
}

pub function (s: EmitState) mark_str_search(): EmitState {
    return s.need("str_search");
}

pub function (s: EmitState) mark_args(): EmitState {
    return s.need("heap").need("args");
}

pub function (s: EmitState) mark_arr_push(): EmitState {
    return s.need("heap").need("arr_push");
}

pub function (s: EmitState) mark_arr_slice(): EmitState {
    return s.need("heap").need("arr_slice");
}

pub function (s: EmitState) mark_arr_i32_index_of(): EmitState {
    return s.need("arr_i32_index_of");
}

pub function (s: EmitState) mark_arr_reverse(): EmitState {
    return s.need("heap").need("arr_reverse");
}

// mark_str_from_bytes gates the Fern __fern_string_from_bytes runtime function
// (#2649) on its own str_from_bytes need. The AST call sites previously only
// marked heap (the hand-asm body rode the always-emitted heap block); the Fern
// body is now emitted in the migrated-helpers section like the string builders.
pub function (s: EmitState) mark_str_from_bytes(): EmitState {
    return s.need("heap").need("str_from_bytes");
}

// rt_src_string_from_bytes backs `string_from_bytes_unchecked(arr)` (#2649) — pack each
// array element's low byte into a fresh string, via the raw-memory intrinsic
// floor. The parameter is typed i32[] (all self-host arrays use 8-byte element
// slots, so a u8[] argument round-trips identically): a[i] reads the slot,
// __raw_store8 keeps its low byte. Heap is its sole dep. Empty array → "".
pub function rt_src_string_from_bytes(): string {
    return "function __fern_string_from_bytes(a: i32[]): string { var n: i32 = a.len(); var p: i32 = __raw_alloc(n); var i: i32 = 0; while (i < n) { __raw_store8(p, i, a[i]); i = i + 1; } return __raw_string(p, n); }";
}

pub function (s: EmitState) mark_arr_concat(): EmitState {
    return s.need("heap").need("arr_concat");
}

pub function (s: EmitState) mark_arr_str_index_of(): EmitState {
    return s.need("str_eq").need("arr_str_index_of");
}

pub function (s: EmitState) mark_arr_str_join(): EmitState {
    return s.need("heap").need("str_concat").need("arr_str_join");
}

pub function (s: EmitState) mark_arr_i32_sum(): EmitState {
    return s.need("arr_i32_sum");
}

pub function (s: EmitState) mark_arr_i32_min_max(): EmitState {
    return s.need("arr_i32_min_max");
}

pub function (s: EmitState) mark_arr_i32_product(): EmitState {
    return s.need("arr_i32_product");
}

// str_lines's helper builds its string[] with .append() → arr_push /
// arr_push_owned, marked as transitive deps directly — same shape as
// mark_arr_str_join. runtime_need_deps declares the same edges for close_needs.
pub function (s: EmitState) mark_str_lines(): EmitState {
    // str_concat: each line is `slice + ""` since #7230, so the compiled body
    // calls __fern_str_concat — without the dep a program that lines() but
    // never concats itself fails to LINK (undefined __fn___fern_str_concat).
    return s.need("heap").need("arr_push").need("arr_push_owned").need("str_concat").need("str_lines");
}

// str_bytes's helper builds the result array with `.append()`, which the
// ownership analysis lowers to the reclaim-on-grow __fern_arr_push_owned
// (sole-owner local reassigned) rather than plain __fern_arr_push, so both
// symbols must be present. Marked directly here; runtime_need_deps declares the
// same edges (arr_push_owned → arr_push).
pub function (s: EmitState) mark_str_bytes(): EmitState {
    return s.need("heap").need("arr_push").need("arr_push_owned").need("str_bytes");
}

// str_split's Fern helper builds the result string[] with .append()
// (__fern_arr_push_owned for the sole-owner local, __fern_arr_push otherwise) —
// same pairing as str_lines. Marked directly here; runtime_need_deps declares the
// same edges for close_needs.
pub function (s: EmitState) mark_str_split(): EmitState {
    // str_concat: same #7230 owned-segment dep as mark_str_lines.
    return s.need("heap").need("arr_push").need("arr_push_owned").need("str_concat").need("str_split");
}

pub function (s: EmitState) mark_str_case(): EmitState {
    return s.need("heap").need("str_case");
}

// rt_src_str_to_upper / rt_src_str_to_lower back `s.to_upper()` / `s.to_lower()`
// (#2649), via the raw-memory intrinsic floor (docs/RUNTIME-INTRINSICS.md). Alloc
// len bytes, copy each byte case-flipped if it's an ASCII letter (a-z 97-122 →
// upper by -32; A-Z 65-90 → lower by +32), box it. Tier-2; heap is the sole dep.
// Nested ifs instead of `&&` to stay in the proven subset (cf. rt_src_str_search).
// Both gated on the single str_case need (mark_str_case emits both bodies).
pub function rt_src_str_to_upper(): string {
    return "function __fern_str_to_upper(s: string): string { var n: i32 = s.len(); var p: i32 = __raw_alloc(n); var i: i32 = 0; while (i < n) { var c: i32 = s[i]; if (c >= 97) { if (c <= 122) { c = c - 32; } } __raw_store8(p, i, c); i = i + 1; } return __raw_string(p, n); }";
}

pub function rt_src_str_to_lower(): string {
    return "function __fern_str_to_lower(s: string): string { var n: i32 = s.len(); var p: i32 = __raw_alloc(n); var i: i32 = 0; while (i < n) { var c: i32 = s[i]; if (c >= 65) { if (c <= 90) { c = c + 32; } } __raw_store8(p, i, c); i = i + 1; } return __raw_string(p, n); }";
}

pub function (s: EmitState) mark_str_repeat(): EmitState {
    return s.need("heap").need("str_repeat");
}

// rt_src_str_repeat backs `str_repeat(s, n)` / `s.repeat(n)` (#2649) — n copies
// of `s` in a fresh buffer, via the raw-memory intrinsic floor. Allocates
// slen*count bytes (min 1 so a 0-length result still has a valid box ptr),
// copies `s` byte-by-byte `count` times, boxes it. n <= 0 → empty string. Heap
// is its sole dep. Replaces the hand-written register-ABI body on every backend.
pub function rt_src_str_repeat(): string {
    return "function __fern_str_repeat(s: string, n: i32): string { var slen: i32 = s.len(); var count: i32 = n; if (count < 0) { count = 0; } var total: i32 = slen * count; var cap: i32 = total; if (cap == 0) { cap = 1; } var p: i32 = __raw_alloc(cap); var w: i32 = 0; var k: i32 = 0; while (k < count) { var j: i32 = 0; while (j < slen) { __raw_store8(p, w, s[j]); w = w + 1; j = j + 1; } k = k + 1; } return __raw_string(p, total); }";
}

pub function (s: EmitState) mark_str_trim(): EmitState {
    // str_concat: the result is `s[start:end] + ""` since #7393, so the
    // compiled body calls __fern_str_concat — the dep the trim-len link
    // failure proved (a program that trims but never concats itself).
    return s.need("heap").need("str_concat").need("str_trim");
}

pub function (s: EmitState) mark_str_reverse(): EmitState {
    return s.need("heap").need("str_reverse");
}

// rt_src_str_reverse backs `s.reverse()` (#2649) — a fresh string box with `s`'s
// bytes in reverse order, via the raw-memory intrinsic floor. Allocates n bytes,
// copies s[n-1-i] into p[i], boxes it. Heap is its sole dep. Replaces the
// hand-written register-ABI body on every backend.
pub function rt_src_str_reverse(): string {
    return "function __fern_str_reverse(s: string): string { var n: i32 = s.len(); var p: i32 = __raw_alloc(n); var i: i32 = 0; while (i < n) { __raw_store8(p, i, s[n - 1 - i]); i = i + 1; } return __raw_string(p, n); }";
}

pub function (s: EmitState) mark_str_replace(): EmitState {
    return s.need("heap").need("str_replace");
}

// rt_src_str_replace backs `s.replace(old, new)` / `str_replace(s, old, new)`
// (#2649) — every non-overlapping occurrence of `o` in `h` replaced by `nw`,
// via the raw-memory intrinsic floor. Empty `o` or no match → the haystack box
// unchanged (no allocation). Otherwise two-pass: count matches, alloc the exact
// target size (lenH + count*(lenN-lenO); min 1 for a valid box ptr), walk `h`
// writing `nw` at each match (advancing lenO) and copying other bytes. Heap is
// its sole dep. Replaces the hand-written register-ABI body on every backend.
pub function rt_src_str_replace(): string {
    return "function __fern_str_replace(h: string, o: string, nw: string): string { var lenH: i32 = h.len(); var lenO: i32 = o.len(); if (lenO == 0) { return h; } var lenN: i32 = nw.len(); var count: i32 = 0; var i: i32 = 0; while (i + lenO <= lenH) { var j: i32 = 0; var m: i32 = 1; while (j < lenO) { if (h[i + j] != o[j]) { m = 0; j = lenO; } else { j = j + 1; } } if (m == 1) { count = count + 1; i = i + lenO; } else { i = i + 1; } } if (count == 0) { return h; } var total: i32 = lenH + count * (lenN - lenO); var cap: i32 = total; if (cap == 0) { cap = 1; } var p: i32 = __raw_alloc(cap); var w: i32 = 0; var k: i32 = 0; while (k < lenH) { var m2: i32 = 0; if (k + lenO <= lenH) { var jj: i32 = 0; m2 = 1; while (jj < lenO) { if (h[k + jj] != o[jj]) { m2 = 0; jj = lenO; } else { jj = jj + 1; } } } if (m2 == 1) { var t: i32 = 0; while (t < lenN) { __raw_store8(p, w, nw[t]); w = w + 1; t = t + 1; } k = k + lenO; } else { __raw_store8(p, w, h[k]); w = w + 1; k = k + 1; } } return __raw_string(p, total); }";
}

pub function (s: EmitState) mark_i32_pow(): EmitState {
    return s.need("i32_pow");
}

pub function (s: EmitState) mark_i32_gcd(): EmitState {
    return s.need("i32_gcd");
}

// lcm's helper calls gcd's. The AST emit path has no close_needs, so the mark
// helper must pull in the transitive dep (i32_gcd) directly — same shape as
// mark_arr_str_index_of marking str_eq. (runtime_need_deps declares the edge too,
// for the IR path's close_needs; both kept in sync.)
pub function (s: EmitState) mark_i32_lcm(): EmitState {
    return s.need("i32_gcd").need("i32_lcm");
}

// rt_src_arr_reverse / rt_src_arr_concat back `xs.reverse()` / `xs.concat(ys)`
// (#2649) — the first ARRAY-producing helpers written in Fern, over the
// __raw_arr_box + __raw_array pair. Both are raw 8-byte SLOT copies, which is
// why one `i32[]`-typed body serves every element type: a string / struct
// element is a pointer in the same slot, and neither helper inspects it.
//
// That slot copy is also deliberately SHALLOW — no element refcount traffic,
// exactly as the hand-asm they replace did, and typing the parameters `i32[]` is
// what keeps the RC insertion agreeing with that. The parameters are read-only,
// so borrowable_params_interproc marks them borrowed and the caller's array
// survives; the fresh box comes back at rc=1 from __fern_arr_box.
//
// Element i lives at slot i+1 (slot 0 is the length), which is the index
// __raw_store_ptr scales, so the body never names the box layout. Arch-
// independent: one source for x86-64 and arm64 alike, no target parameter.
pub function rt_src_arr_reverse(): string {
    return "function __fern_arr_reverse(a: i32[]): i32[] { var n: i32 = a.len(); var p: i32 = __raw_arr_box(n); var i: i32 = 0; while (i < n) { __raw_store_ptr(p, i + 1, a[n - 1 - i]); i = i + 1; } return __raw_array(p); }";
}

pub function rt_src_arr_concat(): string {
    return "function __fern_arr_concat(a: i32[], b: i32[]): i32[] { var an: i32 = a.len(); var bn: i32 = b.len(); var p: i32 = __raw_arr_box(an + bn); var i: i32 = 0; while (i < an) { __raw_store_ptr(p, i + 1, a[i]); i = i + 1; } var j: i32 = 0; while (j < bn) { __raw_store_ptr(p, an + j + 1, b[j]); j = j + 1; } return __raw_array(p); }";
}

// rt_src_arr_slice backs `a[start:end]` (#2649), the third and last array
// helper to move. Same shallow 8-byte slot copy as its two siblings, over the
// same __raw_arr_box + __raw_array pair.
//
// It came last because its construction-time bounds check (#5419) traps, and
// "abort" is not a Fern expression. It does not need one: the hand-asm's
// __fern_oob_abort is nothing but exit(134), which the existing __syscall3
// floor already says — so the only new surface is an `exit` row in sysno
// (60 / 93 / 1; darwinize's darwin_sysno already maps 93 -> 1). No new
// intrinsic, no new IR op, no new backend code. That is also why this helper
// takes a target where reverse / concat do not.
//
// The hand-asm's two traps were UNSIGNED compares (`ja`), which is how a
// negative bound aborted rather than wrapping the copy loop; Fern's i32
// compares are signed, so the same condition is spelled with the explicit
// `< 0` arms. Four separate ifs rather than a chain of `||`, to keep each
// arm's origin in the hand-asm legible. The trap assigns back into `bad`
// rather than binding a fresh local: exit(134) does not return, so the value
// is never read, and a named local would only invite the reader to look for
// where it is used.
//
// `a[start + i]` pays the ordinary per-access bounds check, which the raw
// hand-asm load did not. That is deliberate and matches reverse / concat: the
// helper reads through the same checked path user code does, and the indices
// are provably in range, so the check is a predictable-branch cost rather than
// a correctness one.
pub function rt_src_arr_slice(t: string): string {
    return "function __fern_arr_slice(a: i32[], start: i32, end: i32): i32[] { var n: i32 = a.len(); var bad: i32 = 0; if (end < 0) { bad = 1; } if (end > n) { bad = 1; } if (start < 0) { bad = 1; } if (start > end) { bad = 1; } if (bad == 1) { bad = __syscall3(" + sysno(t, "exit") + ", 134, 0, 0); } var m: i32 = end - start; var p: i32 = __raw_arr_box(m); var i: i32 = 0; while (i < m) { __raw_store_ptr(p, i + 1, a[start + i]); i = i + 1; } return __raw_array(p); }";
}

// rt_src_i32_pow is the Fern source for __fern_i32_pow(base, exp) = base^exp,
// the integer-power runtime helper backing `n.pow(e)`. It is the first runtime
// helper written in Fern instead of a hand-written asm string (issue #2649):
// each backend's emit_runtime_fern_fn parses this and lowers it through the
// normal function emitter, so it links as __fn___fern_i32_pow and is called via
// the ordinary stack convention. Shared here (not per-backend) so the helper
// logic has a single source of truth across x86-64 and arm64. Pure scalar (a
// multiply loop) — Tier 0 in docs/RUNTIME-IN-FERN.md: no helper dependency and
// no circularity (its body uses `*`/`-`/`while`, never `.pow()` itself).
pub function rt_src_i32_pow(): string {
    return "function __fern_i32_pow(base: i32, exp: i32): i32 { var r: i32 = 1; var e: i32 = exp; while (e > 0) { r = r * base; e = e - 1; } return r; }";
}

// rt_src_i32_gcd / rt_src_i32_lcm back `n.gcd(m)` / `n.lcm(m)` (#2649), mirroring
// std/i32.gcd / .lcm. gcd is pure scalar (Euclid on the absolute values — Tier 0,
// no helper deps). lcm calls `.gcd()` (so its helper `call`s __fn___fern_i32_gcd):
// runtime_need_deps maps i32_lcm → i32_gcd so close_needs emits gcd's body too.
// gcd(0,0)=0, gcd(a,0)=|a|; lcm is 0 when either operand is 0, else |n/gcd|*|other|.
pub function rt_src_i32_gcd(): string {
    return "function __fern_i32_gcd(n: i32, other: i32): i32 { var a: i32 = n; if (a < 0) { a = 0 - a; } var b: i32 = other; if (b < 0) { b = 0 - b; } while (b != 0) { var t: i32 = b; b = a % b; a = t; } return a; }";
}

pub function rt_src_i32_lcm(): string {
    return "function __fern_i32_lcm(n: i32, other: i32): i32 { if (n == 0) { return 0; } if (other == 0) { return 0; } var g: i32 = n.gcd(other); var q: i32 = n / g; if (q < 0) { q = 0 - q; } var b: i32 = other; if (b < 0) { b = 0 - b; } return q * b; }";
}

// The i32-array reducers backing `xs.sum()` / `.product()` / `.index_of(x)` /
// `.min()` / `.max()` — runtime helpers written in Fern instead of hand-written
// asm (#2649). Tier 1 in docs/RUNTIME-IN-FERN.md: they take a borrowed array
// param (the exit sweep skips params, so no RC traffic) and bottom out in
// inline-lowered `xs.len()` / `xs[i]` indexing and i32 arithmetic — no helper
// call and no allocation, so they reuse emit_runtime_fern_fn unchanged. (min/max
// return the raw extremum; the call site handles empty→None and the Option box.)
pub function rt_src_arr_i32_sum(): string {
    return "function __fern_arr_i32_sum(xs: i32[]): i32 { var s: i32 = 0; var i: i32 = 0; while (i < xs.len()) { s = s + xs[i]; i = i + 1; } return s; }";
}

pub function rt_src_arr_i32_product(): string {
    return "function __fern_arr_i32_product(xs: i32[]): i32 { var p: i32 = 1; var i: i32 = 0; while (i < xs.len()) { p = p * xs[i]; i = i + 1; } return p; }";
}

pub function rt_src_arr_i32_index_of(): string {
    return "function __fern_arr_i32_index_of(xs: i32[], target: i32): i32 { var i: i32 = 0; while (i < xs.len()) { if (xs[i] == target) { return i; } i = i + 1; } return 0 - 1; }";
}

// rt_src_arr_i32_min / _max backed `xs.min()` / `.max()` on the AST path. The
// call site handles the empty array (→ None) and wraps the result in
// Option[i32], so these helpers take a NON-EMPTY borrowed array and return the
// extremum i32 — the same clean Tier 1 reduce-with-comparison shape as
// sum/product (#2649).
pub function rt_src_arr_i32_min(): string {
    return "function __fern_arr_i32_min(xs: i32[]): i32 { var m: i32 = xs[0]; var i: i32 = 1; while (i < xs.len()) { if (xs[i] < m) { m = xs[i]; } i = i + 1; } return m; }";
}

// rt_src_arr_i32_min_max_opt is the IR path's pair (#3457): ONE helper per
// extremum that carries the empty-array guard AND the Option box itself, so the
// call site is an unconditional call — the sum/product shape — instead of the
// AST emitter's open-coded `len == 0` branch plus two hand-built 16-byte boxes.
// Keeping the branch in Fern source is what makes these tractable on the IR
// path at all: `emit_ir_runtime_fern_fn` already compiles Option/Result-
// returning helpers (rt_src_read_file), so no Option construction has to be
// hand-emitted as IR ops on three backends. They allocate, so unlike the fold
// helpers their need pulls in the heap runtime.
pub function rt_src_arr_i32_min_max_opt(): string {
    return "function __fern_arr_i32_min_opt(xs: i32[]): Option[i32] { if (xs.len() == 0) { return None; } var m: i32 = xs[0]; var i: i32 = 1; while (i < xs.len()) { if (xs[i] < m) { m = xs[i]; } i = i + 1; } return Some(m); } function __fern_arr_i32_max_opt(xs: i32[]): Option[i32] { if (xs.len() == 0) { return None; } var m: i32 = xs[0]; var i: i32 = 1; while (i < xs.len()) { if (xs[i] > m) { m = xs[i]; } i = i + 1; } return Some(m); }";
}

// rt_src_str_to_i32 backs `str_to_i32(s)` — parse a borrowed string into an
// i32 (#2649). Written with `for b in s` (string byte iteration + break, both
// IR-eligible) rather than s[i] indexing so it lowers cleanly on the IR path. Optional leading '-', then decimal digits, stopping at
// the first non-digit (empty / non-numeric → 0) — matching the hand-written
// helper it replaces. The string param is read-only (never returned/stored), so
// borrow analysis keeps it borrowed: no RC free of the caller's string.
pub function rt_src_str_to_i32(): string {
    return "function __fern_str_to_i32(s: string): i32 { var acc: i32 = 0; var neg: i32 = 0; var first: i32 = 1; for b in s { if (first == 1 && b == 45) { neg = 1; } else { var d: i32 = b - 48; if (d < 0 || d > 9) { break; } acc = acc * 10 + d; } first = 0; } if (neg == 1) { return 0 - acc; } return acc; }";
}

// rt_src_str_cmp backs string ordering (< <= > >=) → __fern_str_cmp(a, b),
// returning a signed i32: <0 if a<b, 0 if equal, >0 if a>b (#2649). Lexicographic
// byte compare (unsigned bytes, like the asm's movzbq) with a length tiebreak;
// it returns the actual byte/length DIFFERENCE (the operators only use the sign),
// matching the hand-written helper. Both string params are read-only, so borrow
// analysis keeps them borrowed (no RC free). Uses a[i]/b[i] indexing — the
// string byte-load lowers on both the AST and IR paths (parallel two-string
// iteration can't use `for ... in`).
pub function rt_src_str_cmp(): string {
    return "function __fern_str_cmp(a: string, b: string): i32 { var la: i32 = a.len(); var lb: i32 = b.len(); var n: i32 = la; if (lb < n) { n = lb; } var i: i32 = 0; while (i < n) { var ca: i32 = a[i]; var cb: i32 = b[i]; if (ca != cb) { return ca - cb; } i = i + 1; } return la - lb; }";
}

// rt_src_str_eq backs string equality (== / !=) AND is called by the map and
// arr_str helpers (#2649) — the exact map_set→str_eq edge that motivated the
// issue. Returns 1 if a and b have equal length and bytes, else 0. Self-contained
// (byte indexing, no alloc, no other helper call) and read-only params (borrowed).
// Every call site (operator, IR op, and the hand-asm map/arr internals) sets up
// the same a/b operands, so all route to the one Fern body.
pub function rt_src_str_eq(): string {
    return "function __fern_str_eq(a: string, b: string): i32 { var la: i32 = a.len(); if (la != b.len()) { return 0; } var i: i32 = 0; while (i < la) { if (a[i] != b[i]) { return 0; } i = i + 1; } return 1; }";
}

// rt_src_arr_str_index_of backs `xs.index_of(t)` / `.contains(t)` on string
// arrays (#2649). It is the first migrated helper that CALLS another runtime
// helper: `xs[i] == t` lowers to a str_eq call (str_eq is itself a Fern runtime
// function now). The str_eq dependency is declared by mark_arr_str_index_of, so
// str_eq's body is emitted alongside. Returns the first index where an element
// equals the target (content equality), or -1. Both params read-only (borrowed).
pub function rt_src_arr_str_index_of(): string {
    return "function __fern_arr_str_index_of(xs: string[], target: string): i32 { var i: i32 = 0; while (i < xs.len()) { if (xs[i] == target) { return i; } i = i + 1; } return 0 - 1; }";
}

// rt_src_arr_str_join backs `xs.join(sep)` on string arrays (#2649). Builds the
// joined string with the `+` operator (which lowers to __fern_str_concat — a
// declared dep via mark_arr_str_join, so its body is present). Written as an
// always-fresh accumulator (`var r = ""` then concat) rather than aliasing
// xs[0], so the returned string is a normal owned value with clean Perceus RC
// (no borrowed array element escaping as the result). Empty array → "".
pub function rt_src_arr_str_join(): string {
    return "function __fern_arr_str_join(xs: string[], sep: string): string { var n: i32 = xs.len(); var r: string = \"\"; var i: i32 = 0; while (i < n) { if (i > 0) { r = r + sep; } r = r + xs[i]; i = i + 1; } return r; }";
}

// rt_src_str_search backs the string-search predicates (#2649): all three are
// gated by the single `str_search` need, so one source defines all three and
// emit_*_runtime_fern_fn emits each. Self-contained — byte indexing only, no
// alloc, no other helper call — so they reuse the migration primitives as-is.
// __fern_str_starts_with(s, p) / _ends_with(s, p): 1 if s has p as a prefix /
// suffix (empty p → 1), else 0. __fern_str_index_of(s, needle): first byte
// offset where needle occurs (empty needle → 0), or -1. Arg order matches the
// hand-written helpers (s=param0, p/needle=param1); both params read-only →
// borrowed. Semantics validated against the asm bodies they replace.
pub function rt_src_str_search(): string {
    return "function __fern_str_starts_with(s: string, p: string): i32 { var lp: i32 = p.len(); if (lp > s.len()) { return 0; } var i: i32 = 0; while (i < lp) { if (s[i] != p[i]) { return 0; } i = i + 1; } return 1; } function __fern_str_ends_with(s: string, p: string): i32 { var ls: i32 = s.len(); var lp: i32 = p.len(); if (lp > ls) { return 0; } var off: i32 = ls - lp; var i: i32 = 0; while (i < lp) { if (s[off + i] != p[i]) { return 0; } i = i + 1; } return 1; } function __fern_str_index_of(s: string, needle: string): i32 { var ls: i32 = s.len(); var ln: i32 = needle.len(); if (ln == 0) { return 0; } if (ln > ls) { return 0 - 1; } var last: i32 = ls - ln; var i: i32 = 0; while (i <= last) { var j: i32 = 0; var ok: i32 = 1; while (j < ln) { if (s[i + j] != needle[j]) { ok = 0; j = ln; } else { j = j + 1; } } if (ok == 1) { return i; } i = i + 1; } return 0 - 1; }";
}

pub function rt_src_arr_i32_max(): string {
    return "function __fern_arr_i32_max(xs: i32[]): i32 { var m: i32 = xs[0]; var i: i32 = 1; while (i < xs.len()) { if (xs[i] > m) { m = xs[i]; } i = i + 1; } return m; }";
}

// rt_src_str_trim backs `s.trim()` (#2649). It finds the first/last
// non-whitespace byte (space/tab/'\n'/'\r' = 32/9/10/13) and returns an OWNED
// COPY of `s[start:end]` — the `+ ""` concat allocates the fresh box, matching
// native and interp, whose trim always copies. It USED to return the bare
// slice: a zero-copy view whose backing buffer the producer's exit sweep frees,
// which was a deterministic wrong-answer UAF whenever the result crossed a
// frame (#7393); the slice temp's 16/24-byte box is the cost of the idiom
// until anonymous slice temps get a view-box reclaim. Style mirrors
// rt_src_str_search — sentinel `go` flag + nested if/else to stay in the
// proven subset. Empty / all-whitespace input → start==end → "".
// rt_src_str_split backs `str_split(s, sep)` / `s.split(sep)` (#2649) — a string[]
// of the substrings between each non-overlapping occurrence of `sep`. Each
// segment is an OWNED COPY (`s[start:i] + ""`, #7230): a bare-slice segment is a
// view whose backing buffer the receiver's release frees, and a split result
// that crossed its frame dangled exactly like #7393's trim. Composite / Tier-1:
// scans for `sep` (inline byte-compare, like str_replace) — no new primitive. Semantics match the interp: trailing "a,b," → ["a","b",""], leading
// ",a" → ["","a"], no-match → [s], "" → [""], multi-char sep.
//
// Empty `sep` char-splits ("abc" → ["a","b","c"]), matching std/string's `split`
// and the interp. It used to return [s] instead, preserving the hand-written
// self-host asm emitter's behaviour on the grounds that no differential test
// exercised empty-sep. Both halves of that rationale are gone: the hand-asm
// emitters were deleted (#3457/#5972), and the empty-sep case is now covered on
// every backend by internal/e2e/string_split_empty_sep_test.go.
pub function rt_src_str_split(): string {
    return "function __fern_str_split(s: string, sep: string): string[] { var lenS: i32 = s.len(); var lenSep: i32 = sep.len(); var out: string[] = []; if (lenSep == 0) { var k: i32 = 0; while (k < lenS) { out = out.append(s[k:k + 1] + \"\"); k = k + 1; } return out; } var start: i32 = 0; var i: i32 = 0; while (i + lenSep <= lenS) { var j: i32 = 0; var m: i32 = 1; while (j < lenSep) { if (s[i + j] != sep[j]) { m = 0; j = lenSep; } else { j = j + 1; } } if (m == 1) { out = out.append(s[start:i] + \"\"); i = i + lenSep; start = i; } else { i = i + 1; } } out = out.append(s[start:lenS] + \"\"); return out; }";
}

// rt_src_str_bytes backs `s.bytes()` / `s.as_bytes()` (#2649). Returns an i32[]
// of the string's byte values (each zero-extended into the array's uniform 8-byte
// slot). Composite / Tier-1: builds the result by appending each byte
// (s[i] yields the zero-extended byte as i32) — .append() lowers to __fern_arr_push
// (existing), so no new primitive. The hand-asm it replaces pre-sized the array to
// len via __fern_arr_box; the append-loop grows it instead — same i32[] result
// (logical length + elements), just a different internal capacity.
pub function rt_src_str_bytes(): string {
    return "function __fern_str_bytes(s: string): i32[] { var n: i32 = s.len(); var r: i32[] = []; var i: i32 = 0; while (i < n) { r = r.append(s[i]); i = i + 1; } return r; }";
}

// rt_src_str_lines backs `s.lines()` (#2649).
// A trailing newline (or an empty input) yields no final entry — so
// "a\nb\nc\n".lines() is 3 lines, not 4, matching the interp and Rust/Python.
// It scans for itself rather than trimming a split result: producing exactly the
// lines wanted means there is never a dropped element to reclaim. Each line is
// an OWNED COPY (`+ ""`, #7230), same reasoning as __fern_str_split's segments. Same arr_push / arr_push_owned
// dependency as __fern_str_split, whose loop this mirrors.
pub function rt_src_str_lines(): string {
    return "function __fern_str_lines(s: string): string[] { var out: string[] = []; var sl: i32 = s.len(); var start: i32 = 0; var i: i32 = 0; while (i < sl) { if (s[i] == 10) { out = out.append(s[start:i] + \"\"); start = i + 1; } i = i + 1; } if (start < sl) { out = out.append(s[start:sl] + \"\"); } return out; }";
}

pub function rt_src_str_trim(): string {
    return "function __fern_str_trim(s: string): string { var n: i32 = s.len(); var start: i32 = 0; var go: i32 = 1; while (go == 1) { if (start >= n) { go = 0; } else { var c: i32 = s[start]; if (c == 32) { start = start + 1; } else { if (c == 9) { start = start + 1; } else { if (c == 10) { start = start + 1; } else { if (c == 13) { start = start + 1; } else { go = 0; } } } } } } var end: i32 = n; var go2: i32 = 1; while (go2 == 1) { if (end <= start) { go2 = 0; } else { var c2: i32 = s[end - 1]; if (c2 == 32) { end = end - 1; } else { if (c2 == 9) { end = end - 1; } else { if (c2 == 10) { end = end - 1; } else { if (c2 == 13) { end = end - 1; } else { go2 = 0; } } } } } } return s[start:end] + \"\"; }";
}

pub function match_payload_type(scrut: parser.Expr, s: EmitState): Ty {
    match (scrut) {
        parser.ExprIdent(id) => {
            // Scrutinee is a local — recover the wrapped payload tag
            // from its declared/inferred type.
            if (s.has_local(id.name)) {
                var lt: Ty = s.local_type_of(id.name);
                if (is_option(lt)) { return option_inner(lt); }
                if (is_result(lt)) { return result_inner(lt); }
            }
            return ty_unknown();
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if ((id.name == "Some" || id.name == "Ok") && c.args.len() == 1) {
                        return infer_expr_type(c.args[0], s);
                    }
                    if (id.name == "read_file" || id.name == "read_all_stdin") { return ty_string(); }
                    if (id.name == "tcp_recv") { return ty_array_i32(); }
                    if (id.name == "temp_dir") { return ty_string(); }
                    if (id.name == "read_dir") { return ty_array_string(); }
                    // Arbitrary free / module function returning
                    // Option[T] or Result[T, …] — see asm.fern.
                    var fi: i32 = 0;
                    while (fi < s.funcs.len()) {
                        if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
                            var rt: string = s.funcs[fi].ret_type;
                            if (rt.len() >= 8 && rt[0:7] == "Option[" && rt[rt.len() - 1] == b']') {
                                return ty_from_name(rt[7 : rt.len() - 1]);
                            }
                            if (rt.len() >= 8 && rt[0:7] == "Result[") {
                                var inner: string = "(" + rt[7 : rt.len() - 1] + ")";
                                return split_tuple_ret(inner).a;
                            }
                            return ty_unknown();
                        }
                        fi = fi + 1;
                    }
                    return ty_unknown();
                },
                parser.ExprFieldAccess(fa) => {
                    if (fa.field == "read_chunk") { return ty_string(); }
                    if (fa.field == "read_line") { return ty_option(ty_string()); }
                    if (fa.field == "write") { return ty_i32(); }
                    if (fa.field == "get") {
                        var rt: Ty = infer_expr_type(fa.obj, s);
                        if (is_map(rt)) { return map_val(rt); }
                    }
                    if (fa.field == "min" || fa.field == "max") {
                        if (ty_is_array_i32(infer_expr_type(fa.obj, s))) { return ty_i32(); }
                    }
                    // Receiver method call. See asm.fern.
                    var rcv: Ty = infer_expr_type(fa.obj, s);
                    if (!ty_is_unknown(rcv)) {
                        var fi: i32 = 0;
                        while (fi < s.funcs.len()) {
                            if (s.funcs[fi].name == fa.field && ty_eq(ty_from_name(s.funcs[fi].receiver_type), rcv)) {
                                var rt: string = s.funcs[fi].ret_type;
                                if (rt.len() >= 8 && rt[0:7] == "Option[" && rt[rt.len() - 1] == b']') {
                                    return ty_from_name(rt[7 : rt.len() - 1]);
                                }
                                if (rt.len() >= 8 && rt[0:7] == "Result[") {
                                    var inner: string = "(" + rt[7 : rt.len() - 1] + ")";
                                    return split_tuple_ret(inner).a;
                                }
                                return ty_unknown();
                            }
                            fi = fi + 1;
                        }
                    }
                    return ty_unknown();
                },
                _ => { return ty_unknown(); }
            }
        },
        _ => { return ty_unknown(); }
    }
    return ty_unknown();
}

pub function is_enum_variant(name: string, s: EmitState): boolean {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == name) {
            var sd: parser.StructDecl = s.struct_decls[di];
            var fi: i32 = 0;
            while (fi < sd.fields.len()) {
                if (sd.fields[fi].name == "__ev") { return true; }
                fi = fi + 1;
            }
            return false;
        }
        di = di + 1;
    }
    return false;
}

pub function is_unit_variant(name: string, s: EmitState): boolean {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == name) {
            return s.struct_decls[di].fields.len() == 0;
        }
        di = di + 1;
    }
    return false;
}

pub function is_struct_decl_name(name: string, s: EmitState): boolean {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == name) { return true; }
        di = di + 1;
    }
    return false;
}

// is_prim_recv_name reports whether a method-receiver type spelling names a
// PRIMITIVE / `string` type (i32/i64/u32/u64/usize/f64/f32/boolean/string) —
// the receivers that `impl Trait for <prim>` can name and that a `dyn` value
// boxes (docs/DYN-TRAITS.md §4.2.3). A primitive has no runtime shape pointer,
// so a `dyn` over it is heap-boxed at coercion; the dispatch chain matches the
// box's offset-0 shape (the interned primitive type name) and unboxes. Distinct
// from is_struct_decl_name (structs) and is_enum_recv (enums); an array
// receiver (recv_is_array) is excluded.
pub function is_prim_recv_name(name: string, s: EmitState): boolean {
    if (recv_is_array(name)) { return false; }
    if (is_struct_decl_name(name, s)) { return false; }
    if (is_int_tag(ty_from_name(name))) { return true; }
    if (name == "string" || name == "bool" || name == "boolean") { return true; }
    if (name == "f64" || name == "f32" || name == "float") { return true; }
    return false;
}

pub function is_enum_recv(name: string, s: EmitState): boolean {
    if (is_struct_decl_name(name, s)) { return false; }
    if (is_int_tag(ty_from_name(name))) { return false; }
    if (name == "string" || name == "bool" || name == "boolean") { return false; }
    if (name == "f64" || name == "f32" || name == "float") { return false; }
    return true;
}

// recv_is_array reports whether a method receiver type spelling is an ARRAY
// (`T[]`, `i32[]`, …). Such a method (e.g. std/json's element-poly
// `(xs: T[]) to_json[T: Json]()`) is NOT a concrete struct/enum dispatch
// candidate — a value's runtime shape pointer never names an array method —
// so the runtime shape-dispatch in the AST backends had to skip it. Without this
// the array `to_json`, whose base receiver name `T` (a type parameter) passes
// is_enum_recv's permissive default, would be picked as the enum fallback for
// EVERY `.to_json()` call and corrupt non-array receivers (#2766). Distinct
// from a generic struct receiver like `Box[T]`, which ends in `]` but not `[]`.
pub function recv_is_array(rt: string): boolean {
    var n: i32 = rt.len();
    if (n < 2) { return false; }
    return rt[n - 2 : n] == "[]";
}

// find_array_method_func returns the exact in-scope name of the std/array
// auto-discovered helper backing `a.<field>()` — `__method_Array_<field>` when
// the program imports std/array as a single file, or the `<mod>__`-mangled name
// the bundler produced (which ends in the bare convention name) — or "" when no
// such function is in scope (then `a.<field>()` is a genuine unknown method).
// Only free functions (no receiver) qualify; the `__method_Array_` suffix is
// specific enough that no other decl collides. Shared by both asm backends so
// the array-method-syntax dispatch can't drift between them.
pub function find_array_method_func(field: string, s: EmitState): string {
    var target: string = "__method_Array_" + field;
    var tn: i32 = target.len();
    var i: i32 = 0;
    while (i < s.funcs.len()) {
        var nm: string = s.funcs[i].name;
        if (s.funcs[i].receiver_type.len() == 0) {
            if (nm == target) { return nm; }
            if (nm.len() > tn && nm[nm.len() - tn : nm.len()] == target) { return nm; }
        }
        i = i + 1;
    }
    return "";
}

pub function field_type_tag_in(struct_name: string, field: string, s: EmitState): Ty {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == struct_name) {
            var sd: parser.StructDecl = s.struct_decls[di];
            var fi: i32 = 0;
            while (fi < sd.fields.len()) {
                if (sd.fields[fi].name == field) {
                    return ty_from_name(sd.fields[fi].type_name);
                }
                fi = fi + 1;
            }
            return ty_unknown();
        }
        di = di + 1;
    }
    return ty_unknown();
}

pub function field_type_tag(field: string, s: EmitState): Ty {
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        var sd: parser.StructDecl = s.struct_decls[di];
        var fi: i32 = 0;
        while (fi < sd.fields.len()) {
            if (sd.fields[fi].name == field) {
                return ty_from_name(sd.fields[fi].type_name);
            }
            fi = fi + 1;
        }
        di = di + 1;
    }
    return ty_unknown();
}

pub function struct_local_tag(type_name: string, s: EmitState): Ty {
    var bi: i32 = 0;
    while (bi < type_name.len()) {
        if (type_name[bi] == b'[') { return ty_from_name(type_name); }
        bi = bi + 1;
    }
    var di: i32 = 0;
    while (di < s.struct_decls.len()) {
        if (s.struct_decls[di].name == type_name) { return ty_named(type_name); }
        di = di + 1;
    }
    return ty_from_name(type_name);
}

pub struct TyI32 { tag: i32 }

pub struct TyU32 { tag: i32 }

pub struct TyU64 { tag: i32 }

pub struct TyI64 { tag: i32 }

pub struct TyU8 { tag: i32 }

pub struct TyUsize { tag: i32 }

pub struct TyBool { tag: i32 }

pub struct TyString { tag: i32 }

pub struct TyF64 { tag: i32 }

pub struct TyStruct { tag: i32 }

pub struct TyTuple { tag: i32 }

pub struct TyUnknown { tag: i32 }

pub struct TyArray { tag: i32 }

pub struct TyArrayI32 { tag: i32 }

pub struct TyArrayU32 { tag: i32 }

pub struct TyArrayU64 { tag: i32 }

pub struct TyArrayI64 { tag: i32 }

pub struct TyArrayString { tag: i32 }

pub struct TyFnAny { tag: i32 }

pub struct TyMapAny { tag: i32 }

pub struct TyOption { inner: Ty }

pub struct TyResult { inner: Ty }

pub struct TyFn { ret: Ty }

pub struct TyMapStr { val: Ty }

pub struct TyMapI32 { val: Ty }

pub struct TyMapIter { val: Ty }

// TyCell models Cell[T] (docs/CELL-TYPE-PLAN.md) — a single-slot mutable
// box. v1 holds scalars only (the checker's E057 enforces cycle-free T);
// `val` records the element type for get()'s result + set()'s arg width.
pub struct TyCell { val: Ty }

pub struct TyStructNamed { name: string }

pub type Ty = TyI32 | TyU8 | TyU32 | TyU64 | TyI64 | TyUsize | TyBool
            | TyString | TyF64 | TyStruct | TyTuple | TyUnknown |
            TyArray | TyArrayI32 | TyArrayU32 | TyArrayU64 | TyArrayI64
            | TyArrayString | TyFnAny | TyMapAny | TyOption | TyResult |
            TyFn | TyMapStr | TyMapI32 | TyMapIter | TyCell | TyStructNamed;

pub function ty_named(name: string): Ty { return TyStructNamed { name: name }; }

pub function ty_struct_name(t: Ty): string {
    match (t) {
        TyStructNamed(x) => { return x.name; },
        _ => { return ""; }
    }
    return "";
}

pub function ty_i32(): Ty { return TyI32 { tag: 0 }; }

pub function ty_u32(): Ty { return TyU32 { tag: 0 }; }

pub function ty_u64(): Ty { return TyU64 { tag: 0 }; }

pub function ty_i64(): Ty { return TyI64 { tag: 0 }; }

pub function ty_u8(): Ty { return TyU8 { tag: 0 }; }

pub function ty_usize(): Ty { return TyUsize { tag: 0 }; }

pub function ty_bool(): Ty { return TyBool { tag: 0 }; }

pub function ty_string(): Ty { return TyString { tag: 0 }; }

pub function ty_f64(): Ty { return TyF64 { tag: 0 }; }

pub function ty_struct(): Ty { return TyStruct { tag: 0 }; }

pub function ty_tuple(): Ty { return TyTuple { tag: 0 }; }

pub function ty_unknown(): Ty { return TyUnknown { tag: 0 }; }

pub function ty_array(): Ty { return TyArray { tag: 0 }; }

pub function ty_array_i32(): Ty { return TyArrayI32 { tag: 0 }; }

pub function ty_array_u32(): Ty { return TyArrayU32 { tag: 0 }; }

pub function ty_array_u64(): Ty { return TyArrayU64 { tag: 0 }; }

pub function ty_array_i64(): Ty { return TyArrayI64 { tag: 0 }; }

pub function ty_array_string(): Ty { return TyArrayString { tag: 0 }; }

pub function ty_fn_any(): Ty { return TyFnAny { tag: 0 }; }

pub function ty_map_any(): Ty { return TyMapAny { tag: 0 }; }

pub function ty_option(x: Ty): Ty { return TyOption { inner: x }; }

pub function ty_result(x: Ty): Ty { return TyResult { inner: x }; }

pub function ty_fn(x: Ty): Ty { return TyFn { ret: x }; }

pub function ty_map_str(x: Ty): Ty { return TyMapStr { val: x }; }

pub function ty_map_i32(x: Ty): Ty { return TyMapI32 { val: x }; }

pub function ty_mapiter(x: Ty): Ty { return TyMapIter { val: x }; }

pub function ty_cell(x: Ty): Ty { return TyCell { val: x }; }

// is_cell reports whether t is a Cell[T] (the receiver-type gate for
// cell get()/set() dispatch).
pub function is_cell(t: Ty): boolean {
    match (t) {
        TyCell(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// cell_val returns the element type of a Cell[T] (ty_unknown when t isn't
// a cell), driving get()'s result + set()'s arg load/store width.
pub function cell_val(t: Ty): Ty {
    match (t) {
        TyCell(x) => { return x.val; },
        _ => { return ty_unknown(); }
    }
    return ty_unknown();
}

pub function ty_ord(t: Ty): i32 {
    match (t) {
        TyI32(_) => { return 0; },
        TyU32(_) => { return 1; },
        TyU64(_) => { return 2; },
        TyI64(_) => { return 3; },
        TyUsize(_) => { return 4; },
        TyBool(_) => { return 5; },
        TyString(_) => { return 6; },
        TyF64(_) => { return 7; },
        TyStruct(_) => { return 8; },
        TyTuple(_) => { return 9; },
        TyUnknown(_) => { return 10; },
        TyArray(_) => { return 11; },
        TyArrayI32(_) => { return 12; },
        TyArrayU32(_) => { return 13; },
        TyArrayU64(_) => { return 14; },
        TyArrayI64(_) => { return 15; },
        TyArrayString(_) => { return 16; },
        TyFnAny(_) => { return 17; },
        TyU8(_) => { return 27; },
        TyMapAny(_) => { return 18; },
        TyOption(_) => { return 19; },
        TyResult(_) => { return 20; },
        TyFn(_) => { return 21; },
        TyMapStr(_) => { return 22; },
        TyMapI32(_) => { return 23; },
        TyMapIter(_) => { return 24; },
        TyStructNamed(_) => { return 25; },
        TyCell(_) => { return 26; },
        _ => { return -1; }
    }
    return -1;
}

pub function is_int_tag(t: Ty): boolean {
    match (t) {
        TyI32(_) => { return true; },
        TyU32(_) => { return true; },
        TyU64(_) => { return true; },
        TyI64(_) => { return true; },
        TyUsize(_) => { return true; },
        TyU8(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_int_array_tag(t: Ty): boolean {
    match (t) {
        TyArrayI32(_) => { return true; },
        TyArrayU32(_) => { return true; },
        TyArrayU64(_) => { return true; },
        TyArrayI64(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_unsigned_tag(t: Ty): boolean {
    match (t) {
        TyU32(_) => { return true; },
        TyU64(_) => { return true; },
        TyUsize(_) => { return true; },
        TyU8(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_unsigned_int_array_tag(t: Ty): boolean {
    match (t) {
        TyArrayU32(_) => { return true; },
        TyArrayU64(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// ty_is_array_like reports whether t is any array type. All arrays now
// carry the Perceus rc header at [data-8] (see __fern_arr_box in the
// backends), so an alias of one is a reference-creation site that must
// retain (inc) the buffer.
pub function ty_is_array_like(t: Ty): boolean {
    match (t) {
        TyArray(_) => { return true; },
        TyArrayI32(_) => { return true; },
        TyArrayU32(_) => { return true; },
        TyArrayU64(_) => { return true; },
        TyArrayI64(_) => { return true; },
        TyArrayString(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

// needs_rc_inc_on_alias reports whether binding/passing `e` creates a
// new reference to an rc-tracked heap value that must be retained
// (the Perceus inc site). Ported from the native compiler's
// needsRcIncOnAlias (internal/ir/ir.go), scoped to arrays for Phase 1d
// — strings / structs / enums / closures / tuples join in Phase 1e.
// Fires for a READ of an array-typed value that already has an owner:
//   - an Ident (var y = x),
//   - a struct field (var y = h.items),
//   - an index load (var y = m[i], m an array of arrays).
// A fresh array literal or a call result is already uniquely owned at
// rc=1 and is NOT re-incremented. A spurious inc on a mis-inferred
// non-array is harmless — the rc-inc helper's null / low-address /
// sentinel guards short-circuit — so this is robust to inference gaps.
pub function needs_rc_inc_on_alias(e: parser.Expr, s: EmitState): boolean {
    match (e) {
        parser.ExprIdent(id) => { return ty_is_array_like(s.local_type_of(id.name)); },
        parser.ExprFieldAccess(_) => { return ty_is_array_like(infer_expr_type(e, s)); },
        parser.ExprIndex(_) => { return ty_is_array_like(infer_expr_type(e, s)); },
        _ => { return false; }
    }
    return false;
}

// move_on_return_idx implements Perceus move-on-return for owned array
// locals. When `return e` returns `e` that is a bare ExprIdent naming an
// array-typed LOCAL whose slot index is >= n_params (i.e. NOT a borrowed
// parameter), the buffer can be MOVED to the caller: the return-retain
// inc and the exit sweep's dec of that one slot are a balanced pair on
// the same value, so eliding BOTH hands the array to the caller at its
// current rc with identical net effect. Returns that local's index for
// the caller to (a) skip the return inc and (b) exclude from the sweep;
// returns -1 when no move applies (non-ident, non-array, or a borrowed
// param). Eliding an inc/dec pair on one slot is net-zero regardless of
// any aliasing of the same buffer through other slots, so this is safe.
pub function (s: EmitState) move_on_return_idx(e: parser.Expr): i32 {
    match (e) {
        parser.ExprIdent(id) => {
            if (!s.has_local(id.name)) { return 0 - 1; }
            if (!ty_is_array_like(s.local_type_of(id.name))) { return 0 - 1; }
            var idx: i32 = (0 - s.lookup_local(id.name)) / 8 - 1;
            if (idx < s.n_params) { return 0 - 1; }
            return idx;
        },
        _ => { return 0 - 1; }
    }
    return 0 - 1;
}

pub function is_map(t: Ty): boolean {
    match (t) {
        TyMapAny(_) => { return true; },
        TyMapStr(_) => { return true; },
        TyMapI32(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_mapiter(t: Ty): boolean {
    match (t) {
        TyMapIter(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function map_key_is_i32(t: Ty): boolean {
    match (t) {
        TyMapI32(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_option(t: Ty): boolean {
    match (t) {
        TyOption(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_result(t: Ty): boolean {
    match (t) {
        TyResult(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function is_fn(t: Ty): boolean {
    match (t) {
        TyFn(_) => { return true; },
        TyFnAny(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_i32(t: Ty): boolean {
    match (t) {
        TyI32(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_u8(t: Ty): boolean {
    match (t) {
        TyU8(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_u32(t: Ty): boolean {
    match (t) {
        TyU32(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_u64(t: Ty): boolean {
    match (t) {
        TyU64(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_i64(t: Ty): boolean {
    match (t) {
        TyI64(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_usize(t: Ty): boolean {
    match (t) {
        TyUsize(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_bool(t: Ty): boolean {
    match (t) {
        TyBool(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_string(t: Ty): boolean {
    match (t) {
        TyString(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_f64(t: Ty): boolean {
    match (t) {
        TyF64(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_struct(t: Ty): boolean {
    match (t) {
        TyStruct(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_tuple(t: Ty): boolean {
    match (t) {
        TyTuple(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_unknown(t: Ty): boolean {
    match (t) {
        TyUnknown(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_array(t: Ty): boolean {
    match (t) {
        TyArray(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

pub function ty_is_array_i32(t: Ty): boolean {
    match (t) {
        TyArrayI32(_) => { return true; },
        _ => { return false; }
    }
    return false;
}

