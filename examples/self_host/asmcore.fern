pub function option_inner(t: Ty): Ty {
    match (t) {
        TyOption(x) => { return x.inner; },
        _ => { return ty_unknown(); }
    }
    return ty_unknown();
}

pub function result_inner(t: Ty): Ty {
    match (t) {
        TyResult(x) => { return x.inner; },
        _ => { return ty_unknown(); }
    }
    return ty_unknown();
}

pub function fn_ret(t: Ty): Ty {
    match (t) {
        TyFn(x) => { return x.ret; },
        _ => { return ty_unknown(); }
    }
    return ty_unknown();
}

pub function mapiter_val(t: Ty): Ty {
    match (t) {
        TyMapIter(x) => { return x.val; },
        _ => { return ty_unknown(); }
    }
    return ty_unknown();
}

pub function map_val(t: Ty): Ty {
    match (t) {
        TyMapStr(x) => { return x.val; },
        TyMapI32(x) => { return x.val; },
        _ => { return ty_unknown(); }
    }
    return ty_unknown();
}

pub function ty_tag(t: Ty): string {
    match (t) {
        TyI32(_) => { return "i32"; },
        TyU32(_) => { return "u32"; },
        TyU64(_) => { return "u64"; },
        TyI64(_) => { return "i64"; },
        TyU8(_) => { return "u8"; },
        TyUsize(_) => { return "usize"; },
        TyBool(_) => { return "bool"; },
        TyString(_) => { return "string"; },
        TyF64(_) => { return "f64"; },
        TyStruct(_) => { return "struct"; },
        TyTuple(_) => { return "tuple"; },
        TyUnknown(_) => { return "unknown"; },
        TyArray(_) => { return "array"; },
        TyArrayI32(_) => { return "array_i32"; },
        TyArrayU32(_) => { return "array_u32"; },
        TyArrayU64(_) => { return "array_u64"; },
        TyArrayI64(_) => { return "array_i64"; },
        TyArrayString(_) => { return "array_string"; },
        TyFnAny(_) => { return "fn"; },
        TyMapAny(_) => { return "map"; },
        TyOption(x) => { return "option:" + ty_tag(x.inner); },
        TyResult(x) => { return "result:" + ty_tag(x.inner); },
        TyFn(x) => { return "fn_" + ty_tag(x.ret); },
        TyMapStr(x) => { return "map:" + ty_tag(x.val); },
        TyMapI32(x) => { return "mapI:" + ty_tag(x.val); },
        TyMapIter(x) => { return "mapiter:" + ty_tag(x.val); },
        TyCell(x) => { return "cell:" + ty_tag(x.val); },
        TyStructNamed(x) => { return x.name; }
    }
    return "unknown";
}

pub function ty_eq(a: Ty, b: Ty): boolean {
    match (a) {
        TyOption(x) => { match (b) { TyOption(y) => { return ty_eq(x.inner, y.inner); }, _ => { return false; } } },
        TyResult(x) => { match (b) { TyResult(y) => { return ty_eq(x.inner, y.inner); }, _ => { return false; } } },
        TyFn(x) => { match (b) { TyFn(y) => { return ty_eq(x.ret, y.ret); }, _ => { return false; } } },
        TyMapStr(x) => { match (b) { TyMapStr(y) => { return ty_eq(x.val, y.val); }, _ => { return false; } } },
        TyMapI32(x) => { match (b) { TyMapI32(y) => { return ty_eq(x.val, y.val); }, _ => { return false; } } },
        TyMapIter(x) => { match (b) { TyMapIter(y) => { return ty_eq(x.val, y.val); }, _ => { return false; } } },
        TyCell(x) => { match (b) { TyCell(y) => { return ty_eq(x.val, y.val); }, _ => { return false; } } },
        TyStructNamed(x) => { match (b) { TyStructNamed(y) => { return x.name == y.name; }, _ => { return false; } } },
        _ => { return ty_ord(a) == ty_ord(b); }
    }
    return false;
}

pub function generic_value_ty(name: string, start: i32): Ty {
    if (name.len() <= start + 1) { return ty_unknown(); }
    var inner: str = name[start : name.len() - 1];
    var i: i32 = 0;
    while (i + 1 < inner.len()) {
        if (inner[i] == b',' && inner[i + 1] == b' ') {
            return ty_from_name(inner[i + 2 : inner.len()]);
        }
        i = i + 1;
    }
    return ty_unknown();
}

pub function generic_key_is_i32(name: string, start: i32): boolean {
    if (name.len() <= start + 1) { return false; }
    var inner: str = name[start : name.len() - 1];
    var i: i32 = 0;
    while (i + 1 < inner.len()) {
        if (inner[i] == b',' && inner[i + 1] == b' ') {
            return ty_is_i32(ty_from_name(inner[0 : i]));
        }
        i = i + 1;
    }
    return false;
}

// ty_from_ref maps a structured TypeRef (parser.parse_type_ref) to the coarse
// asmcore Ty, replacing ty_from_name's hand-rolled byte scan (SH-021 slice 2 —
// docs/SELF-HOST-AUDIT.md T2). It is byte-identical to the former scan across the
// whole type grammar, quirks included: only the exact scalar arrays carry a
// dedicated array Ty (everything else — multi-depth, generic/named/tuple element,
// f64[] — is coarse ty_array); an UNRECOGNISED generic (`Vec[T]`, `Foo[A, B]`)
// is coarse ty_array; a `Map`-prefixed bare name (`Map` / `MapConfig`) is
// ty_map_str(unknown); a single-arg `Result[T]` degrades to ty_result(i32) (the
// old split_tuple_ret no-comma fallback); a bare tuple / name is ty_unknown.
// (The known-fragile "Map"-prefix and single-arg degradations are preserved for
// byte-identity; a later behaviour slice can tighten them now that the shape is
// structured.)
pub function ty_from_ref(t: parser.TypeRef): Ty {
    // Array suffixes. Only a depth-1 array of a scalar with its own array Ty
    // keeps the element type; every other array (multi-depth, generic/named/
    // tuple element, f64[]) collapses to coarse ty_array — exactly ty_from_name,
    // where only the literal "i32[]"/"u32[]"/… strings hit a dedicated array and
    // any other trailing "[]" falls through to ty_array.
    if (t.array_depth == 1 && !t.is_tuple && t.args.len() == 0) {
        if (t.base == "i32" || t.base == "char") { return ty_array_i32(); }
        if (t.base == "u32") { return ty_array_u32(); }
        if (t.base == "u64") { return ty_array_u64(); }
        if (t.base == "i64") { return ty_array_i64(); }
        if (t.base == "string") { return ty_array_string(); }
        if (t.base == "bool" || t.base == "boolean") { return ty_array_i32(); }
    }
    if (t.array_depth >= 1) { return ty_array(); }
    // array_depth == 0 below.
    if (t.is_tuple) { return ty_unknown(); }
    if (t.args.len() > 0) {
        // Generic. Recognised constructors carry their key/value/inner type;
        // MapIter[V] / Map[V] / Result[T] with only ONE arg (no comma in the
        // old scan) degrade exactly as generic_value_ty / split_tuple_ret did.
        if (t.base == "MapIter") {
            if (t.args.len() >= 2) { return ty_mapiter(ty_from_ref(t.args[1])); }
            return ty_mapiter(ty_unknown());
        }
        if (t.base == "Map") {
            if (t.args.len() >= 2 && ty_is_i32(ty_from_ref(t.args[0]))) { return ty_map_i32(ty_from_ref(t.args[1])); }
            if (t.args.len() >= 2) { return ty_map_str(ty_from_ref(t.args[1])); }
            return ty_map_str(ty_unknown());
        }
        if (t.base == "Cell") { return ty_cell(ty_from_ref(t.args[0])); }
        if (t.base == "Option") { return ty_option(ty_from_ref(t.args[0])); }
        if (t.base == "Result") {
            if (t.args.len() >= 2) { return ty_result(ty_from_ref(t.args[0])); }
            return ty_result(ty_i32());
        }
        // Unrecognised generic (Vec[T], Foo[A, B], …) — ty_from_name's
        // "ends in ']' → coarse ty_array".
        return ty_array();
    }
    // array_depth == 0, no args: scalar or bare name.
    if (t.base == "i32") { return ty_i32(); }
    // `char` is a surface type that erases to an i32 slot at the IR choke
    // point (#5629), so codegen sees plain i32 — same treatment the native
    // backends get from ir/erase_surface.go. Without this a `char` receiver
    // or parameter types as ty_unknown and its methods fail to dispatch.
    if (t.base == "char") { return ty_i32(); }
    // `u8` is the BYTE type (#5629): distinct from i32 so a byte receiver
    // dispatches to the u8 method surface rather than i32's. It still occupies
    // an i32-sized slot -- only the dispatch key differs.
    if (t.base == "u8") { return ty_u8(); }
    if (t.base == "u32") { return ty_u32(); }
    if (t.base == "u64") { return ty_u64(); }
    if (t.base == "i64") { return ty_i64(); }
    if (t.base == "usize") { return ty_usize(); }
    if (t.base == "f64" || t.base == "f32" || t.base == "float") { return ty_f64(); }
    if (t.base == "bool" || t.base == "boolean") { return ty_bool(); }
    if (t.base == "string") { return ty_string(); }
    // A bare name beginning with "Map" (Map / MapConfig / …) → coarse
    // ty_map_str(unknown), reproducing ty_from_name's prefix match.
    if (t.base.len() >= 3 && t.base[0:3] == "Map") { return ty_map_str(ty_unknown()); }
    return ty_unknown();
}

pub function ty_from_name(name: string): Ty {
    return ty_from_ref(parser.parse_type_ref(name));
}

pub struct TwoTags { a: Ty, b: Ty }

// split_tuple_ret decodes the OK / first + second tags of a two-element tuple
// spelling `(A, B)` — its only real callers wrap a Result's `[T, E]` in parens
// and read `.a` (the OK type). Migrated onto the structured TypeRef (SH-021
// slice 3): parse once, read the elements as args, rather than hand-scanning for
// the first top-level comma. A non-tuple or a single-element `(A)` (no top-level
// comma) yields {i32, i32}, exactly as the old scan's fallbacks. `.b` is inherently
// a 2-slot result; for the (unreached) 3+ element case it reproduces the old
// "everything after the first comma" `b` by re-joining the trailing elements and
// decoding that as one name (which is `unknown` for a real 3-tuple), keeping the
// verdict byte-identical.
pub function split_tuple_ret(tt: string): TwoTags {
    var t: parser.TypeRef = parser.parse_type_ref(tt);
    if (!t.is_tuple || t.args.len() < 2) { return TwoTags { a: ty_i32(), b: ty_i32() }; }
    if (t.args.len() == 2) { return TwoTags { a: ty_from_ref(t.args[0]), b: ty_from_ref(t.args[1]) }; }
    var rest: string = parser.render_type_ref(t.args[1]);
    var k: i32 = 2;
    while (k < t.args.len()) { rest = rest + ", " + parser.render_type_ref(t.args[k]); k = k + 1; }
    return TwoTags { a: ty_from_ref(t.args[0]), b: ty_from_name(rest) };
}

// The tag of the idx-th component of a tuple-return type string `(t0, t1, …)`.
// Out-of-range (or a non-tuple) falls back to i32. Generalises split_tuple_ret
// to any arity for N-element destructuring; migrated onto the structured TypeRef
// (SH-021 slice 3) — element idx is just args[idx], no top-level-comma scan.
pub function tuple_ret_tag_at(tt: string, idx: i32): Ty {
    var t: parser.TypeRef = parser.parse_type_ref(tt);
    if (!t.is_tuple) { return ty_i32(); }
    if (idx < t.args.len()) { return ty_from_ref(t.args[idx]); }
    return ty_i32();
}

// The tag to bind for the idx-th name of a `var (a, b, …) = init`
// destructure, for any arity. A tuple literal reads element idx
// directly; a tuple-returning free function / method splits its
// declared return type at idx.
pub function tuple_destructure_tag_at(init: parser.Expr, idx: i32, s: EmitState): Ty {
    match (init) {
        parser.ExprTuple(t) => {
            if (idx < t.elements.len()) {
                return infer_expr_type(t.elements[idx], s);
            }
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    var fi: i32 = 0;
                    while (fi < s.funcs.len()) {
                        if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
                            return tuple_ret_tag_at(s.funcs[fi].ret_type, idx);
                        }
                        fi = fi + 1;
                    }
                },
                parser.ExprFieldAccess(fa) => {
                    // The builtin map `without` returns `(Map, bool)`: bind
                    // element 0 to the receiver's own map tag so the resulting
                    // map dispatches its methods correctly (rather than
                    // mis-mangling as `__fn_i32__<method>`); the bool is i32.
                    var rcv: Ty = infer_expr_type(fa.obj, s);
                    if ((fa.field == "without") && is_map(rcv)) {
                        if (idx == 0) { return rcv; }
                        return ty_i32();
                    }
                    if (!ty_is_unknown(rcv)) {
                        var mfi: i32 = 0;
                        while (mfi < s.funcs.len()) {
                            if (s.funcs[mfi].name == fa.field && ty_eq(ty_from_name(s.funcs[mfi].receiver_type), rcv)) {
                                return tuple_ret_tag_at(s.funcs[mfi].ret_type, idx);
                            }
                            mfi = mfi + 1;
                        }
                    }
                },
                _ => { }
            }
        },
        _ => { }
    }
    return ty_i32();
}

pub function ty_friendly(t: Ty): string {
    match (t) {
        TyOption(x) => { return "Option[" + ty_friendly(x.inner) + "]"; },
        TyResult(x) => { return "Result[" + ty_friendly(x.inner) + ", _]"; },
        TyArrayI32(_) => { return "i32[]"; },
        TyArrayU32(_) => { return "u32[]"; },
        TyArrayU64(_) => { return "u64[]"; },
        TyArrayI64(_) => { return "i64[]"; },
        TyArrayString(_) => { return "string[]"; },
        // ty_tag spells the boolean type "bool" as its internal tag. That is not
        // a type name anyone can write, so a message carrying it names nothing.
        TyBool(_) => { return "boolean"; },
        _ => { return ty_tag(t); }
    }
    return ty_tag(t);
}

pub function infer_expr_type(e: parser.Expr, s: EmitState): Ty {
    match (e) {
        parser.ExprNumber(n) => { if (n.is_float) { return ty_f64(); } return ty_i32(); },
        parser.ExprBool(_) => { return ty_bool(); },
        parser.ExprString(_) => { return ty_string(); },
        parser.ExprArray(a) => {
            if (a.elements.len() == 0) { return ty_array(); }
            var et: Ty = infer_expr_type(a.elements[0], s);
            if (ty_is_string(et)) { return ty_array_string(); }
            if (ty_is_i32(et) || ty_is_bool(et)) { return ty_array_i32(); }
            return ty_array();
        },
        parser.ExprTuple(_) => { return ty_tuple(); },
        parser.ExprMapLit(_) => { return ty_map_any(); },
        parser.ExprFString(_) => { return ty_string(); },
        parser.ExprStructLit(_) => { return ty_struct(); },
        parser.ExprLambda(lm) => {
            // Encode the return type in the tag so a later
            // `f()` call site can recover it from the local's
            // recorded type. The closure-box itself is just an
            // 8-byte pointer regardless of return shape, so
            // capture / call machinery is unaffected; this is
            // purely for the type-aware dispatch on the result
            // (e.g. `print(f())` needs to know the result is a
            // string to route through `__fern_print_str`).
            return ty_fn(ty_from_name(lm.ret_type));
        },
        parser.ExprIdent(id) => {
            if (id.name == "None") { return ty_option(ty_unknown()); }
            if (s.has_local(id.name)) { return s.local_type_of(id.name); }
            // A bare ident may name a zero-arg function (a `const`).
            var cfi: i32 = 0;
            while (cfi < s.funcs.len()) {
                if (s.funcs[cfi].name == id.name && s.funcs[cfi].receiver_type.len() == 0 && s.funcs[cfi].params.len() == 0) {
                    return ty_from_name(s.funcs[cfi].ret_type);
                }
                cfi = cfi + 1;
            }
            return s.local_type_of(id.name);
        },
        parser.ExprBinary(b) => {
            if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">="
                    || b.op == "==" || b.op == "!=" || b.op == "&&" || b.op == "||") {
                return ty_bool();
            }
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                var lt: Ty = infer_expr_type(b.left, s);
                var rt: Ty = infer_expr_type(b.right, s);
                if (ty_is_string(lt) || ty_is_string(rt)) { return ty_string(); }
                if (ty_is_f64(lt) || ty_is_f64(rt)) { return ty_f64(); }
                return ty_i32();
            }
            // Saturating arithmetic (#5542) is integer-only, so the
            // result type is just the (already-unified) operand type.
            if (b.op == "+|" || b.op == "-|" || b.op == "*|" || b.op == "<<|") {
                var slt: Ty = infer_expr_type(b.left, s);
                if (ty_is_i32(slt)) { return infer_expr_type(b.right, s); }
                return slt;
            }
            // Checked arithmetic (#5542) wraps the operand type in an
            // Option — `Some(result)` when it fits, `None` on overflow.
            if (b.op == "+?" || b.op == "-?" || b.op == "*?" || b.op == "/?" || b.op == "%?" || b.op == "<<?" || b.op == ">>?") {
                var clt: Ty = infer_expr_type(b.left, s);
                if (ty_is_i32(clt)) { return ty_option(infer_expr_type(b.right, s)); }
                return ty_option(clt);
            }
            return ty_i32();
        },
        parser.ExprUnary(u) => {
            if (u.op == "!") { return ty_bool(); }
            if (u.op == "-") { return infer_expr_type(u.operand, s); }
            if (u.op.len() >= 3 && u.op[0:3] == "as_") {
                var ct: str = u.op[3:u.op.len()];
                if (ct == "f64" || ct == "f32" || ct == "float") { return ty_f64(); }
                // A cast HAS the named type. u32/i64/u64 used to erase to
                // i32 here (all ints ride 64-bit slots, so arithmetic is
                // width-agnostic) — but the TAG drives method dispatch,
                // signed-vs-unsigned compares, and divq/idivq selection, so
                // erasing sent `(3 as u64).checked_sub(10 as u64)` to
                // std/i32's SIGNED method (no underflow at -7) and compared
                // u64 values with setl. Type the cast truthfully; u8/usize
                // stay on the i32 tag (subword/pointer-size — no distinct
                // dispatch surface).
                if (ct == "u8") { return ty_u8(); }
                if (ct == "i32" || ct == "usize" || ct == "char") { return ty_i32(); }
                if (ct == "u32") { return ty_u32(); }
                if (ct == "i64") { return ty_i64(); }
                if (ct == "u64") { return ty_u64(); }
                // `E as T` type ascription (non-numeric T): the value HAS
                // type T. This arm used to return i32 for every non-float
                // target, so `None as Option[i32]` read as i32 and the
                // pre-IR check gate (#4327) rejected valid Option returns.
                return ty_from_name(ct);
            }
            // `expr?` (parsed as unary `try_`) HAS the operand's Ok/Some payload
            // type — a Result[T, E] unwraps to T, an Option[T] to T. Without this
            // the `?` result fell through to i32 below, so `var o: Option[i32] =
            // f()?` (f: Result[Option[i32], i32]) was rejected E003 "initializer
            // has type i32". Only bit the Option/struct payload case — a string /
            // array / scalar payload slipped through the lenient assignable check.
            if (u.op == "try_") {
                var ot: Ty = infer_expr_type(u.operand, s);
                match (ot) {
                    TyResult(_) => { return result_inner(ot); },
                    TyOption(_) => { return option_inner(ot); },
                    _ => { return ty_i32(); }
                }
            }
            return ty_i32();
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (id.name == "Some" && c.args.len() == 1) {
                        return ty_option(infer_expr_type(c.args[0], s));
                    }
                    if (id.name == "Ok" && c.args.len() == 1) {
                        return ty_result(infer_expr_type(c.args[0], s));
                    }
                    if (id.name == "Err" && c.args.len() == 1) { return ty_result(ty_unknown()); }
                    if (id.name == "read_file") { return ty_result(ty_string()); }
                    if (id.name == "read_file_bytes") { return ty_result(ty_array_i32()); }
                    if (id.name == "write_file") { return ty_result(ty_unknown()); }
                    if (id.name == "write_file_exec") { return ty_result(ty_unknown()); }
                    // now_unix_ms / monotonic_ns return i64. The self-host
                    // has no distinct i64 tag — integers live in 64-bit x0
                    // slots and compare via cmp — so "i32" routes them
                    // through the integer path without truncation.
                    if (id.name == "now_unix_ms") { return ty_i32(); }
                    if (id.name == "monotonic_ns") { return ty_i32(); }
                    // poll(fds, timeout_ms) -> i32 (ready index, or -1).
                    if (id.name == "poll") { return ty_i32(); }
                    // timer_fd(ms) -> i32 fd; wasm_timer_pollable(ns) -> i32
                    // (-1 native); wasm_pollable_drop(p) -> i32 (0 native);
                    // wasm_block(p) -> i32 (0 native; on wasm blocks until ready).
                    if (id.name == "timer_fd") { return ty_i32(); }
                    // isatty(fd) -> boolean, which the self-host carries in an
                    // integer slot like every other 0/1 value.
                    if (id.name == "isatty") { return ty_i32(); }
                    if (id.name == "wasm_timer_pollable") { return ty_i32(); }
                    if (id.name == "wasm_pollable_drop") { return ty_i32(); }
                    if (id.name == "wasm_block") { return ty_i32(); }
                    // wasm_poll(pollables: i32[]) -> i32 (first ready index, or -1).
                    if (id.name == "wasm_poll") { return ty_i32(); }
                    // tcp_recv(fd, max) -> u8[] box; the rest -> i32 (fd /
                    // byte count / pollable token / -errno).
                    if (id.name == "tcp_recv") { return ty_array_i32(); }
                    if (id.name == "tcp_connect") { return ty_i32(); }
                    // tcp_listen(port) -> listener fd / -errno; tcp_accept(fd) ->
                    // connection fd / -errno. The server half of the edge-handler
                    // use case (#4371); both are plain i32 like the client ops.
                    if (id.name == "tcp_listen") { return ty_i32(); }
                    if (id.name == "tcp_accept") { return ty_i32(); }
                    if (id.name == "tcp_send") { return ty_i32(); }
                    if (id.name == "tcp_close") { return ty_i32(); }
                    if (id.name == "tcp_pollable") { return ty_i32(); }
                    // See asm.fern for rationale.
                    if (id.name == "sleep_ms") { return ty_i32(); }
                    // proc_fork() → 0 in the child / child pid in the parent /
                    // -errno; proc_waitpid(pid) → the child's exit status
                    // (shell convention: 128 + signal on a signal death).
                    // Both plain i32, matching native's FuncSigs (#5686).
                    if (id.name == "proc_fork") { return ty_i32(); }
                    if (id.name == "proc_waitpid") { return ty_i32(); }
                    // proc_exec(path, args) → i32, but only on FAILURE (-errno):
                    // on success execve has replaced the process image, so there
                    // is nothing left to return to. Matches native's FuncSigs.
                    if (id.name == "proc_exec") { return ty_i32(); }
                    if (id.name == "remove_file") { return ty_option(ty_unknown()); }
                    if (id.name == "create_dir_all") { return ty_option(ty_unknown()); }
                    // subprocess(cmd, args, stdin) → ProcessResult struct.
                    // See asm.fern: returns "unknown" because the struct's
                    // fields resolve through the shape-pointer dispatch path
                    // (parser.inject_builtin_enums injects the decl).
                    if (id.name == "subprocess") { return ty_unknown(); }
                    if (id.name == "temp_dir") { return ty_result(ty_string()); }
                    if (id.name == "read_dir") { return ty_result(ty_array_string()); }
                    if (id.name == "stat") { return ty_result(ty_unknown()); }
                    if (id.name == "remove_dir_all") { return ty_option(ty_unknown()); }
                    if (id.name == "f64_bits" || id.name == "f32_bits") { return ty_i32(); }
                    if (id.name == "f64_from_bits" || id.name == "f32_from_bits") { return ty_f64(); }
                    // env(name): Option[string] — Some(value) if the
                    // variable is set (including empty), None otherwise.
                    if (id.name == "env") { return ty_option(ty_string()); }
                    if (id.name == "len") { return ty_i32(); }
                    if (id.name == "read_int") { return ty_i32(); }
                    // stdout()/stderr() -> Writer (a bare fd i32; fds 1/2). The
                    // write-half sibling of stdin() (#4372); a Writer is just its
                    // fd like a Reader, so `w.write(s)`/`w.close()` dispatch off it.
                    if (id.name == "stdout" || id.name == "stderr") { return ty_i32(); }
                    // open_reader/open_writer/open_appender(path) -> a Reader/Writer
                    // (a bare fd i32) or -errno (#4372 file half). The caller uses
                    // r.read_chunk / w.write / .close off the fd, then checks < 0.
                    if (id.name == "open_reader" || id.name == "open_writer"
                        || id.name == "open_appender") { return ty_i32(); }
                    // read_line() -> Option[string]: line INCLUDING '\n', None at EOF
                    // — matches native (#4369). read_all_stdin stays a plain string.
                    if (id.name == "read_line") { return ty_option(ty_string()); }
                    if (id.name == "read_all_stdin") { return ty_string(); }
                    if (id.name == "i32_to_string") { return ty_string(); }
                    if (id.name == "int__int_to_string") { return ty_string(); }
                    if (id.name == "str_to_i32") { return ty_i32(); }
                    if (id.name == "str_starts_with") { return ty_bool(); }
                    if (id.name == "str_ends_with") { return ty_bool(); }
                    if (id.name == "str_contains") { return ty_bool(); }
                    if (id.name == "str_index_of") { return ty_i32(); }
                    if (id.name == "str_trim") { return ty_string(); }
                    if (id.name == "str_to_upper") { return ty_string(); }
                    if (id.name == "str_to_lower") { return ty_string(); }
                    if (id.name == "str_repeat") { return ty_string(); }
                    if (id.name == "str_replace") { return ty_string(); }
                    if (id.name == "chr") { return ty_string(); }
                    // Raw-memory intrinsics (#2649 Tier-2 floor). Pointers are
                    // machine words carried as i32; __raw_string is the one that
                    // produces a typed string. The stores return i32 (the value
                    // written) so they stay value-expressions, not void.
                    if (id.name == "__raw_alloc") { return ty_i32(); }
                    if (id.name == "__raw_store8") { return ty_i32(); }
                    if (id.name == "__raw_load8") { return ty_i32(); }
                    if (id.name == "__raw_store_ptr") { return ty_i32(); }
                    if (id.name == "__raw_load_ptr") { return ty_i32(); }
                    if (id.name == "__raw_string") { return ty_string(); }
                    // The inverse (#2649): a live string's data pointer, which
                    // is slot 0 of the box the string value already points at.
                    if (id.name == "__raw_data") { return ty_i32(); }
                    // Pointer + offset at full machine width (#2649) — `p + off`
                    // in the source would be narrowed to i32 by arm64.
                    if (id.name == "__raw_addr") { return ty_i32(); }
                    // Fresh array box (#2649): __raw_arr_box hands back the data
                    // pointer as i32, __raw_array retypes it as the array value
                    // it already is — the array sibling of __raw_string.
                    if (id.name == "__raw_arr_box") { return ty_i32(); }
                    if (id.name == "__raw_array") { return ty_array_i32(); }
                    // Syscall sub-floor (#2649): the raw-memory floor's I/O
                    // sibling. Returns the syscall result as i32.
                    if (id.name == "__syscall3") { return ty_i32(); }
                    if (id.name == "__syscall4") { return ty_i32(); }
                    if (id.name == "__syscall5") { return ty_i32(); }
                    if (id.name == "__raw_environ") { return ty_i32(); }
                    // Fixed static scratch buffer for syscall leaves (timespec /
                    // stat) — reused, never freed. Returns the buffer ptr as i32.
                    if (id.name == "__raw_scratch") { return ty_i32(); }
                    // i64-typed raw word load (kernel-written tv_sec / tv_nsec).
                    if (id.name == "__load_i64") { return ty_i64(); }
                    // __heap_bump_bytes(): the bump high-water mark. i64, not
                    // i32 — the arena is 16 GiB, so the mark passes 2^31 on a
                    // long enough run and an i32 result would report it
                    // negative. Matches native's FuncSigs; the wasm backend
                    // zero-extends its i32 cursor difference to suit.
                    if (id.name == "__heap_bump_bytes") { return ty_i64(); }
                    // __heap_mark(): the arena checkpoint, an absolute cursor
                    // value — i64 for the bump mark's reason and then some, since
                    // this is the pointer itself rather than a difference (#6728).
                    if (id.name == "__heap_mark") { return ty_i64(); }
                    // Bit-counting intrinsics (#6197): all six return an i32
                    // COUNT regardless of operand width, so a 64-bit form does
                    // not widen its result.
                    if (id.name == "__clz32" || id.name == "__ctz32" || id.name == "__popcount32"
                        || id.name == "__clz64" || id.name == "__ctz64" || id.name == "__popcount64") { return ty_i32(); }
                    // __arr_push_shared_count(): the rc==1 cliff counter. i32,
                    // unlike the bump mark above — it counts appends, not bytes,
                    // and a healthy run reports 0. Matches native's FuncSigs.
                    if (id.name == "__arr_push_shared_count") { return ty_i32(); }
                    // __arr_push_shared_bytes(): the SAME cliff weighted by the
                    // bytes each crossing copied. i64, like the bump mark and
                    // for the same reason — the quantity is arena-scale, and an
                    // i32 would wrap on exactly the runs it exists to measure.
                    // Matches native's FuncSigs.
                    if (id.name == "__arr_push_shared_bytes") { return ty_i64(); }
                    // __map_hash_seed(): core/map's per-process string-hash
                    // seed (#6194). i32, never 0. Matches native's FuncSigs.
                    if (id.name == "__map_hash_seed") { return ty_i32(); }
                    // __memchr(s, byte, from): the index of the first `byte`
                    // at or after `from`, or -1 (ATLAS-PLATFORM-PLAN §3). i32
                    // for both the index and the not-found sentinel; the
                    // haystack length it searches is an i32 everywhere.
                    if (id.name == "__memchr") { return ty_i32(); }
                    // __ascii_run(s, from): the index of the first byte at or
                    // after `from` with its high bit set, or the LENGTH if the
                    // rest is ASCII (ATLAS-PLATFORM-PLAN §3). i32 either way —
                    // both answers are offsets into an i32-length string, which
                    // is why the miss value can be a real index rather than a
                    // sentinel outside the type.
                    if (id.name == "__ascii_run") { return ty_i32(); }
                    if (id.name == "__load_i32") { return ty_i32(); }
                    if (id.name == "exit") { return ty_i32(); }
                    if (id.name == "args_count") { return ty_i32(); }
                    if (id.name == "arg_at") { return ty_string(); }
                    if (id.name == "args") { return ty_array_string(); }
                    if (id.name == "__alloc_u8") { return ty_array_i32(); }
                    if (id.name == "string_from_bytes_unchecked") { return ty_string(); }
                    if (id.name == "random_bytes") { return ty_array_i32(); }
                    if (id.name == "map_new") { return ty_map_str(ty_unknown()); }
                    if (id.name == "map_new_i32") { return ty_map_i32(ty_unknown()); }
                    if (id.name == "cell_new" && c.args.len() == 1) { return ty_cell(infer_expr_type(c.args[0], s)); }
                    if (id.name == "__abs_f64" || id.name == "__sqrt_f64"
                            || id.name == "__floor_f64" || id.name == "__ceil_f64"
                            || id.name == "__trunc_f64" || id.name == "__round_f64"
                            || id.name == "__sin_f64" || id.name == "__cos_f64"
                            || id.name == "__exp_f64" || id.name == "__log_f64"
                            || id.name == "__pow_f64") {
                        return ty_f64();
                    }
                    if (id.name == "str_split") { return ty_array_string(); }
                    // Local-callee path: when `f()` invokes a
                    // local var that was bound to a lambda, its
                    // recorded type is `fn_<ret>` (see the
                    // ExprLambda match arm above). Strip the
                    // prefix so downstream dispatch (`print(f())`,
                    // string concat, etc.) sees the actual return
                    // type rather than `"unknown"`.
                    if (s.has_local(id.name)) {
                        var lt: Ty = s.local_type_of(id.name);
                        if (is_fn(lt)) { return fn_ret(lt); }
                    }
                    var fi: i32 = 0;
                    while (fi < s.funcs.len()) {
                        if (s.funcs[fi].name == id.name && s.funcs[fi].receiver_type.len() == 0) {
                            return ty_from_name(s.funcs[fi].ret_type);
                        }
                        fi = fi + 1;
                    }
                    return ty_unknown();
                },
                parser.ExprFieldAccess(fa) => {
                    var rt: Ty = infer_expr_type(fa.obj, s);
                    if (fa.field == "read_chunk") { return ty_option(ty_string()); }
                    if (fa.field == "read_line") { return ty_option(ty_string()); }
                    // Writer.write(s) -> i32 bytes written / -errno (#4372). Like
                    // read_chunk above, the real non-struct-receiver gate is applied
                    // at lower time (irlower's resource-method dispatch).
                    if (fa.field == "write") { return ty_i32(); }
                    if (is_cell(rt) && fa.field == "get") { return cell_val(rt); }
                    if (is_map(rt) && fa.field == "get") {
                        return ty_option(map_val(rt));
                    }
                    if (is_map(rt) && fa.field == "get_or") {
                        return map_val(rt);
                    }
                    if (is_map(rt) && (fa.field == "insert")) { return rt; }
                    if (is_map(rt) && fa.field == "has") { return ty_bool(); }
                    if (is_map(rt) && fa.field == "len") { return ty_i32(); }
                    if (is_map(rt) && fa.field == "keys") {
                        if (map_key_is_i32(rt)) { return ty_array_i32(); }
                        return ty_array_string();
                    }
                    if (is_map(rt) && fa.field == "values") {
                        var vt: Ty = map_val(rt);
                        if (ty_is_i32(vt)) { return ty_array_i32(); }
                        if (ty_is_string(vt)) { return ty_array_string(); }
                        return ty_array();
                    }
                    if (is_map(rt) && fa.field == "iter") {
                        return ty_mapiter(map_val(rt));
                    }
                    if (is_mapiter(rt) && fa.field == "has_next") { return ty_bool(); }
                    if (is_mapiter(rt) && fa.field == "key") { return ty_string(); }
                    if (is_mapiter(rt) && fa.field == "value") { return mapiter_val(rt); }
                    if ((is_int_tag(rt) || ty_is_string(rt)) && fa.field == "to_string") {
                        return ty_string();
                    }
                    if (ty_is_f64(rt) && fa.field == "to_string") {
                        return ty_string();
                    }
                    if (ty_is_i32(rt) && (fa.field == "abs" || fa.field == "min" || fa.field == "max" || fa.field == "clamp" || fa.field == "pow" || fa.field == "sign" || fa.field == "gcd" || fa.field == "lcm")) {
                        return ty_i32();
                    }
                    // Byte case folds: u8 receiver, u8 result (a byte fold
                    // yields a byte). digit_value / hex_value stay i32 below --
                    // they convert a byte to a numeric value.
                    if (ty_is_u8(rt) && (fa.field == "to_ascii_lower" || fa.field == "to_ascii_upper")) {
                        return ty_u8();
                    }
                    if (ty_is_u8(rt) && (fa.field == "digit_value" || fa.field == "hex_value")) {
                        return ty_i32();
                    }
                    if (ty_is_u8(rt) && (fa.field == "to_ascii_string" || fa.field == "hex_digit")) {
                        return ty_string();
                    }
                    if (ty_is_i32(rt) && (fa.field == "is_even" || fa.field == "is_odd" || fa.field == "is_zero" || fa.field == "is_positive" || fa.field == "is_negative")) {
                        return ty_bool();
                    }
                    if (ty_is_u8(rt) && (fa.field == "is_ascii_digit" || fa.field == "is_ascii_alpha" || fa.field == "is_ascii_letter" || fa.field == "is_ascii_alnum" || fa.field == "is_ascii_lower" || fa.field == "is_ascii_upper" || fa.field == "is_ascii_hex_digit" || fa.field == "is_ascii" || fa.field == "is_ascii_punct" || fa.field == "is_ascii_white_space" || fa.field == "is_ascii_newline" || fa.field == "is_ascii_vowel" || fa.field == "is_ascii_printable" || fa.field == "is_ascii_control" || fa.field == "matches_any")) {
                        return ty_bool();
                    }
                    if (fa.field == "len"
                            && (ty_is_string(rt) || is_int_array_tag(rt) || ty_is_array_string(rt) || ty_is_array(rt))) {
                        return ty_i32();
                    }
                    if (fa.field == "is_empty"
                            && (ty_is_string(rt) || is_int_array_tag(rt) || ty_is_array_string(rt) || ty_is_array(rt))) {
                        return ty_bool();
                    }
                    // `.append(x)` / `.reverse()` / `.concat(b)` return the same array type.
                    if ((fa.field == "append" || fa.field == "reverse" || fa.field == "concat")
                            && (is_int_array_tag(rt) || ty_is_array_string(rt) || ty_is_array(rt))) {
                        return rt;
                    }
                    // `.first()` / `.last()` return the element type.
                    if ((fa.field == "first" || fa.field == "last")
                            && (is_int_array_tag(rt) || ty_is_array_string(rt))) {
                        if (ty_is_array_i32(rt)) { return ty_i32(); }
                        if (ty_is_array_u32(rt)) { return ty_u32(); }
                        if (ty_is_array_u64(rt)) { return ty_u64(); }
                        if (ty_is_array_i64(rt)) { return ty_i64(); }
                        return ty_string();
                    }
                    // i32/string-array search methods.
                    if (ty_is_array_i32(rt) || ty_is_array_string(rt)) {
                        if (fa.field == "index_of") { return ty_i32(); }
                        if (fa.field == "contains") { return ty_bool(); }
                    }
                    if (ty_is_array_i32(rt)
                            && (fa.field == "sum" || fa.field == "product")) {
                        return ty_i32();
                    }
                    // .min()/.max() on an i32 array → Option[i32] (None on
                    // empty); the Some payload is i32 (match_payload_type).
                    if (ty_is_array_i32(rt) && (fa.field == "min" || fa.field == "max")) {
                        return ty_option(ty_i32());
                    }
                    if (ty_is_array_string(rt) && fa.field == "join") {
                        return ty_string();
                    }
                    // String methods that mirror existing builtins.
                    if (ty_is_string(rt)) {
                        if (fa.field == "split") { return ty_array_string(); }
                        if (fa.field == "lines") { return ty_array_string(); }
                        if (fa.field == "bytes") { return ty_array_i32(); }
                        if (fa.field == "as_bytes") { return ty_array_i32(); }
                        if (fa.field == "reverse") { return ty_string(); }
                        if (fa.field == "first_byte" || fa.field == "last_byte") { return ty_i32(); }
                        if (fa.field == "contains") { return ty_bool(); }
                        if (fa.field == "starts_with") { return ty_bool(); }
                        if (fa.field == "ends_with") { return ty_bool(); }
                        if (fa.field == "index_of") { return ty_i32(); }
                        if (fa.field == "trim") { return ty_string(); }
                        if (fa.field == "to_ascii_upper") { return ty_string(); }
                        if (fa.field == "to_ascii_lower") { return ty_string(); }
                        if (fa.field == "repeat") { return ty_string(); }
                        if (fa.field == "replace") { return ty_string(); }
                    }
                    if (ty_is_string(rt) || ty_is_i32(rt) || ty_is_bool(rt) || ty_is_f64(rt)) {
                        var mi: i32 = 0;
                        while (mi < s.funcs.len()) {
                            if (s.funcs[mi].name == fa.field && ty_eq(ty_from_name(s.funcs[mi].receiver_type), rt)) {
                                return ty_from_name(s.funcs[mi].ret_type);
                            }
                            mi = mi + 1;
                        }
                    }
                    // Method call on a struct receiver: resolve by
                    // method name alone (the coarse "struct" tag loses
                    // the receiver's name).
                    var mj: i32 = 0;
                    while (mj < s.funcs.len()) {
                        if (s.funcs[mj].name == fa.field && s.funcs[mj].receiver_type.len() > 0) {
                            return ty_from_name(s.funcs[mj].ret_type);
                        }
                        mj = mj + 1;
                    }
                    return ty_unknown();
                },
                _ => { return ty_unknown(); }
            }
            return ty_unknown();
        },
        parser.ExprIndex(x) => {
            // Container type drives element type:
            //   string → "u8"  (the byte type, #5629)
            //   array_string → "string"
            //   array_u64 → "u64" (so element compares pick unsigned)
            //   array_u32 → "u32"; array_i64 → "i64"; else → "i32"
            var at: Ty = infer_expr_type(x.array, s);
            if (ty_is_string(at)) { return ty_u8(); }
            if (ty_is_array_string(at)) { return ty_string(); }
            if (ty_is_array_u64(at)) { return ty_u64(); }
            if (ty_is_array_u32(at)) { return ty_u32(); }
            if (ty_is_array_i64(at)) { return ty_i64(); }
            return ty_i32();
        },
        parser.ExprSlice(sl) => { return infer_expr_type(sl.array, s); },
        parser.ExprFieldAccess(fa) => {
            // Resolve within the receiver's struct when its type is a
            // known struct name (match-bound variant payloads); else
            // fall back to the first-match field scan. See asm.fern.
            var frt: Ty = infer_expr_type(fa.obj, s);
            var di: i32 = 0;
            while (di < s.struct_decls.len()) {
                if (s.struct_decls[di].name == ty_struct_name(frt)) {
                    return field_type_tag_in(ty_struct_name(frt), fa.field, s);
                }
                di = di + 1;
            }
            return field_type_tag(fa.field, s);
        },
        parser.ExprUnknown(_) => { return ty_unknown(); }
    }
    return ty_unknown();
}

pub function (s: EmitState) reset_locals(): EmitState {
    var ln: string[] = [];
    var lts: Ty[] = [];
    return EmitState { ...s, local_names: ln, local_types: lts };
}

pub function (s: EmitState) enter_function(): EmitState {
    return EmitState { ...s, in_function: true };
}

// set_n_params records the receiver+parameter slot count so the
// Perceus function-exit dec sweep can skip borrowed params. Called by
// emit_function once the params are bound.
pub function (s: EmitState) set_n_params(n: i32): EmitState {
    return EmitState { ...s, n_params: n };
}

pub function (s: EmitState) push_loop_labels(exit_lbl: string, cont_lbl: string): EmitState {
    var nex: string[] = s.loop_exit_labels.append(exit_lbl);
    var ncn: string[] = s.loop_cont_labels.append(cont_lbl);
    return EmitState { ...s, loop_exit_labels: nex, loop_cont_labels: ncn };
}

pub function (s: EmitState) pop_loop_labels(): EmitState {
    var nex: string[] = [];
    var ncn: string[] = [];
    var i: i32 = 0;
    while (i < s.loop_exit_labels.len() - 1) {
        nex = nex.append(s.loop_exit_labels[i]);
        ncn = ncn.append(s.loop_cont_labels[i]);
        i = i + 1;
    }
    return EmitState { ...s, loop_exit_labels: nex, loop_cont_labels: ncn };
}

pub function (s: EmitState) top_loop_exit(): string {
    if (s.loop_exit_labels.len() == 0) { return ""; }
    return s.loop_exit_labels[s.loop_exit_labels.len() - 1];
}

pub function (s: EmitState) top_loop_cont(): string {
    if (s.loop_cont_labels.len() == 0) { return ""; }
    return s.loop_cont_labels[s.loop_cont_labels.len() - 1];
}

pub function (s: EmitState) leave_function(): EmitState {
    return EmitState { ...s, in_function: false };
}

pub function (s: EmitState) lookup_local(name: string): i32 {
    var i: i32 = s.local_names.len() - 1;
    while (i >= 0) {
        if (s.local_names[i] == name) {
            return 0 - 8 * (i + 1);
        }
        i = i - 1;
    }
    return 0;
}

pub function (s: EmitState) has_local(name: string): boolean {
    var i: i32 = 0;
    while (i < s.local_names.len()) {
        if (s.local_names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

pub struct LabelOut { state: EmitState, name: string }

// fresh_label mints a unit-local assembler label. Like str_lit_label it is
// namespaced by `str_ns` for per-module emit: each unit starts a fresh
// EmitState, so its counter restarts at 0, and the per-module CONCAT path
// (emit_per_module_concat — the over-budget rescue) assembles every unit as
// ONE file, where two units' `.L0` are a duplicate-symbol error. GAS's `.L`
// prefix keeps the symbol out of the symtab; it does not make two definitions
// in one file legal. An f64 literal is the common way to reach here, so a
// program with one in both a library module and its entry (`import
// "std/float"` plus a float literal in main) failed to assemble. Empty ns —
// the whole-program path — keeps `.L<n>` byte-identical.
pub function fresh_label(s: EmitState): LabelOut {
    var name: string = ".L" + util.i32_to_string(s.label_n);
    if (s.str_ns.len() > 0) { name = ".L" + s.str_ns + "_" + util.i32_to_string(s.label_n); }
    var ns: EmitState = EmitState { ...s, label_n: s.label_n + 1 };
    return LabelOut { state: ns, name: name };
}

pub function count_locals(body: parser.Stmt[]): i32 {
    var n: i32 = 0;
    var i: i32 = 0;
    while (i < body.len()) {
        n = n + count_locals_in_stmt(body[i]);
        i = i + 1;
    }
    return n;
}

pub function name_has_comma(name: string): boolean {
    var i: i32 = 0;
    while (i < name.len()) {
        if (name[i] == b',') { return true; }
        i = i + 1;
    }
    return false;
}

pub function count_locals_in_stmt(stmt: parser.Stmt): i32 {
    match (stmt) {
        parser.StmtVar(v) => {
            // `var (a, b, …) = E` destructure binds one frame slot per name;
            // count the comma-joined names (commas + 1) so the prologue
            // reserves enough — undercounting writes a binding below %rsp.
            if (name_has_comma(v.name)) {
                var cnt: i32 = 1;
                var ci: i32 = 0;
                while (ci < v.name.len()) {
                    if (v.name[ci] == b',') { cnt = cnt + 1; }
                    ci = ci + 1;
                }
                return cnt;
            }
            return 1;
        },
        parser.StmtIf(ifs) => { return count_locals(ifs.then_body) + count_locals(ifs.else_body); },
        parser.StmtWhile(w) => { return count_locals(w.body); },
        parser.StmtMatch(m) => {
            // +1 for the synthetic scrutinee local + one per
            // non-empty PatVariant binding + the recursive body
            // counts. Wildcard arms add no binding.
            var n: i32 = 1;
            var i: i32 = 0;
            while (i < m.arms.len()) {
                match (m.arms[i].pattern) {
                    parser.PatVariant(pv) => {
                        if (pv.binding.len() > 0 && pv.binding != "_") { n = n + 1; }
                    },
                    parser.PatWildcard(_) => { }
                }
                n = n + count_locals(m.arms[i].body);
                i = i + 1;
            }
            return n;
        },
        parser.StmtFor(f) => {
            // `for (k,v) in m` binds 4 locals (map ptr, index, k, v);
            // plain `for x in arr` binds 3.
            if (name_has_comma(f.var_name)) { return 4 + count_locals(f.body); }
            return 3 + count_locals(f.body);
        },
        _ => { return 0; }
    }
    return 0;
}

pub struct ConstAggOut { state: EmitState, idx: i32 }

// add_const_agg interns one STATIC AGGREGATE CONSTANT (#6149) and returns its
// index. `packed` is `<shape label>|<w0>,<w1>,…` — the shape's already-resolved
// assembler label followed by the decl-ordered field words as source text. The
// label is resolved by the caller (at op-emit time, through shape_ref) rather
// than stored as a type name, because the data block is written at the END of
// the unit, after shape interning has closed.
//
// Deduped by exact content, like add_string_lit: two `TypeI32 { is_char: false,
// width: 32, unsigned: false }` sites share ONE block, which is the whole point
// — a nullary constructor called 552 times gets one address, not 552 boxes.
// Sharing is safe because the block's rc word is the immortal sentinel (every rc
// helper skips a negative rc, and __fern_rc_is_unique answers 0, so a record
// update or an FBIP reuse degrades to a fresh allocation) and E048 forbids field
// assignment, so no observer can see a constant change.
pub function add_const_agg(s: EmitState, packed: string): ConstAggOut {
    var i: i32 = 0;
    while (i < s.const_aggs.len()) {
        if (s.const_aggs[i] == packed) { return ConstAggOut { state: s, idx: i }; }
        i = i + 1;
    }
    var idx: i32 = s.const_aggs.len();
    return ConstAggOut { state: EmitState { ...s, const_aggs: s.const_aggs.append(packed) }, idx: idx };
}

// const_agg_label names constant `idx`'s data block, namespaced by str_ns on the
// per-module path exactly as str_lit_label is, so two separately-emitted units'
// constant pools cannot collide at link.
pub function const_agg_label(s: EmitState, idx: i32): string {
    if (s.str_ns.len() == 0) { return ".K" + util.i32_to_string(idx); }
    return ".K" + s.str_ns + "_" + util.i32_to_string(idx);
}

pub struct StringLitOut { state: EmitState, idx: i32 }

pub function add_string_lit(s: EmitState, v: string): StringLitOut {
    // Dedup: load-bearing for shape-pointer dispatch in
    // ExprFieldAccess + StmtMatch. See asm.fern for rationale.
    var i: i32 = 0;
    while (i < s.string_lits.len()) {
        if (s.string_lits[i] == v) {
            return StringLitOut { state: s, idx: i };
        }
        i = i + 1;
    }
    var idx: i32 = s.string_lits.len();
    var sl: string[] = s.string_lits.append(v);
    var ns: EmitState = EmitState { ...s, string_lits: sl };
    return StringLitOut { state: ns, idx: idx };
}

pub function (s: EmitState) need(name: string): EmitState {
    if (s.has_need(name)) { return s; }
    return EmitState { ...s, needed: s.needed.append(name) };
}

// runtime_need_deps is the DECLARATIVE dependency table for runtime helpers: the
// direct deps of `name` are the other needs whose helpers `name`'s helper calls
// (links against). This is the single source of truth replacing the old, fragile
// "remember to mark every transitively-needed helper by hand" — a backend marks
// only the top-level need (e.g. "maps") and close_needs() pulls in the rest. Add
// an edge here whenever a helper gains a `call __fern_*` to another helper.
// (End goal: when the runtime moves into Fern — issue #2649 — this table and
// close_needs disappear, replaced by the real call graph + the deadcode pass.)
pub function runtime_need_deps(name: string): string[] {
    // Heap-only deps: the helper's body `call __fern_alloc`s (directly or via
    // __fern_arr_box / a result-box alloc), so marking it pulls in "heap".
    // Note strbuf: the strbuf bundle is emitted as a unit gated on the single
    // "strbuf" need, and __fern_strbuf_take in it allocates the drained string's
    // box via __fern_alloc — so ANY strbuf use (even reset/append-only) needs the
    // heap, even though only take allocates.
    var heap: string[] = ["heap"];
    if (name == "str_concat" || name == "str_read_line" || name == "i32_to_string"
        || name == "u32_to_string" || name == "i64_to_string" || name == "u64_to_string"
        || name == "chr" || name == "args" || name == "read_file" || name == "read_file_bytes"
        || name == "random_bytes"
        || name == "str_from_bytes" || name == "alloc_u8" || name == "strbuf"
        || name == "arr_push" || name == "arr_slice" || name == "arr_reverse"
        || name == "arr_concat"
        || name == "str_case" || name == "str_repeat"
        || name == "str_trim" || name == "str_reverse" || name == "str_replace"
        || name == "poll") {
        // poll's __fern_poll allocates the transient pollfd[] via __fern_alloc.
        return heap;
    }
    if (name == "maps") {
        // __fern_map_set calls __fern_str_eq (string-key path) and __fern_arr_push.
        var d: string[] = ["str_eq", "arr_push", "heap"];
        return d;
    }
    if (name == "arr_push_owned") {
        // The sole-owner reclaim-on-grow append shares __fern_arr_push's grow path.
        var d2: string[] = ["arr_push"];
        return d2;
    }
    if (name == "arr_str_index_of") {
        // Linear scan comparing string elements with __fern_str_eq.
        var d3: string[] = ["str_eq"];
        return d3;
    }
    if (name == "i32_lcm") {
        // __fern_i32_lcm's body calls `.gcd()` → __fn___fern_i32_gcd. Pure
        // scalar, so no heap. (gcd itself has no deps.)
        var dlcm: string[] = ["i32_gcd"];
        return dlcm;
    }
    if (name == "arr_str_join") {
        // Joins with a separator via __fern_str_concat (which itself needs heap).
        var d4: string[] = ["heap", "str_concat"];
        return d4;
    }
    if (name == "str_lines") {
        // __fern_str_lines scans for '\n' itself and appends each line —
        // same arr_push / arr_push_owned pairing as __fern_str_split.
        var d5: string[] = ["heap", "arr_push", "arr_push_owned"];
        return d5;
    }
    if (name == "str_bytes") {
        // __fern_str_bytes builds the byte array with .append() — AST: __fern_arr_push;
        // IR (sole-owner local): __fern_arr_push_owned. Both, plus heap.
        var d6: string[] = ["heap", "arr_push", "arr_push_owned"];
        return d6;
    }
    if (name == "str_split") {
        // __fern_str_split builds the result string[] by appending each s[start:i]
        // slice — same arr_push / arr_push_owned pairing as str_bytes.
        var d8: string[] = ["heap", "arr_push", "arr_push_owned"];
        return d8;
    }
    if (name == "read_dir") {
        // __fern_read_dir (#2649) builds the result string[] with .append() — same
        // arr_push / arr_push_owned pairing as str_split. (Its call to __fern_io_error
        // is not a need: io_error is emitted inside the fs bundle alongside read_dir.)
        var d9: string[] = ["heap", "arr_push", "arr_push_owned"];
        return d9;
    }
    if (name == "remove_dir_all") {
        // __fern_remove_dir_all (#2649) is pure raw-memory (inline getdents64 + raw
        // child-path buffers, no read_dir array — see rt_src_remove_dir_all). Its only
        // dep is heap (__raw_alloc); its io_error call is emitted in the fs bundle.
        var d10: string[] = ["heap"];
        return d10;
    }
    var none: string[] = [];
    return none;
}

// close_needs expands `needed` to its transitive closure over runtime_need_deps,
// so emitting the runtime after this is guaranteed to have every helper a marked
// need links against. Iterates to a fixpoint (the dependency graph is small and
// acyclic). Call it once, right before runtime emission.
pub function (s: EmitState) close_needs(): EmitState {
    var cur: EmitState = s;
    var changed: boolean = true;
    while (changed) {
        changed = false;
        // Iterate cur.needed by index against a captured LENGTH (an i32), NOT a
        // `var snap: string[] = cur.needed` snapshot. That bind aliases the
        // needed buffer into a local WITHOUT an alias-inc, so close_needs's
        // function-exit dec-sweep frees a box cur.needed still references — a
        // use-after-free the arm64 per-module self-build hit in has_need (the
        // freed empty-needs box was reused for a `.rodata` string, so has_need
        // read garbage as the array length; latent on x86, where the freed box
        // isn't immediately reused). need() only ever APPENDS (gated on
        // !has_need), so elements [0, n) stay put across the inner loop.
        var n: i32 = cur.needed.len();
        var i: i32 = 0;
        while (i < n) {
            var deps: string[] = runtime_need_deps(cur.needed[i]);
            var j: i32 = 0;
            while (j < deps.len()) {
                if (!cur.has_need(deps[j])) { cur = cur.need(deps[j]); changed = true; }
                j = j + 1;
            }
            i = i + 1;
        }
    }
    return cur;
}

pub function (s: EmitState) has_need(name: string): boolean {
    var i: i32 = 0;
    while (i < s.needed.len()) {
        if (s.needed[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

pub function (s: EmitState) mark_print_int(): EmitState {
    return s.need("print_int");
}

pub function (s: EmitState) mark_heap(): EmitState {
    return s.need("heap");
}

pub function (s: EmitState) mark_read_int(): EmitState {
    return s.need("read_int");
}

pub function escape_for_ascii(s: string): string {
    // Local growable u8[] accumulation (#4379): the old `out = out + …` appended
    // each escape onto an immutable string, recopying the whole escaped prefix
    // per input byte -- O(literal²). This runs for EVERY string / shape literal
    // on every compile (including the self-host build, whose sources carry long
    // literal helper bodies), so the quadratic was pure compile-time overhead.
    // Every append targets the local `out`, growing it in place (amortized O(1)).
    // Byte-for-byte identical escaping. (`92`='\', `34`='"', `110`='n',
    // `116`='t', `114`='r'; octal digits are `48 + oN`.)
    var out: u8[] = [];
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i] as i32;
        if (b == 34) { out = out.append(92 as u8); out = out.append(34 as u8); }        // \"
        else if (b == 92) { out = out.append(92 as u8); out = out.append(92 as u8); }   // \\
        else if (b == 10) { out = out.append(92 as u8); out = out.append(110 as u8); }  // \n
        else if (b == 9) { out = out.append(92 as u8); out = out.append(116 as u8); }   // \t
        else if (b == 13) { out = out.append(92 as u8); out = out.append(114 as u8); }  // \r
        else if (b < 32 || b == 127) {
            // 3-digit octal: \<o2><o1><o0>.
            var o0: i32 = b % 8;
            var o1: i32 = (b / 8) % 8;
            var o2: i32 = (b / 64) % 8;
            out = out.append(92 as u8);              // '\'
            out = out.append((48 + o2) as u8);
            out = out.append((48 + o1) as u8);
            out = out.append((48 + o0) as u8);
        }
        else { out = out.append(s[i] as u8); }
        i = i + 1;
    }
    return string_from_bytes_unchecked(out);
}

pub function is_value_fn_name(s: EmitState, name: string): boolean {
    var fi: i32 = 0;
    while (fi < s.funcs.len()) {
        if (s.funcs[fi].name == name && s.funcs[fi].receiver_type.len() == 0) { return true; }
        fi = fi + 1;
    }
    return false;
}

pub function callee_param_is_fn(s: EmitState, name: string, idx: i32): boolean {
    // Match receiver methods as well as free functions so
    // `f.bench("…", n, my_workload)` boxes `my_workload` the same way
    // a free-fn call does. See asm.fern.
    var fi: i32 = 0;
    while (fi < s.funcs.len()) {
        if (s.funcs[fi].name == name) {
            if (idx < s.funcs[fi].params.len()
                    && s.funcs[fi].params[idx].type_name == "fn") {
                return true;
            }
        }
        fi = fi + 1;
    }
    return false;
}

pub function arg_fn_value_name(arg: parser.Expr, callee: string, idx: i32, s: EmitState): string {
    match (arg) {
        parser.ExprIdent(id) => {
            if (callee_param_is_fn(s, callee, idx) && is_value_fn_name(s, id.name)) {
                return id.name;
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

pub function has_main(mod: parser.Module): boolean {
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].name == "main") { return true; }
        i = i + 1;
    }
    return false;
}

// is_script_module reports whether `mod` is SCRIPT-shaped: top-level statements
// and no `main` to hang them off. `return 42;` is the smallest example.
pub function is_script_module(mod: parser.Module): boolean {
    if (has_main(mod)) { return false; }
    return mod.top_stmts.len() > 0;
}

// synth_script_main rewrites a script-shaped module into a function-shaped one,
// moving the top-level statements into a synthesized `function main(): i32`.
//
// The IR emitters are whole-program emitters whose `_start` does `call
// __fn_main`, so a script had no entry to lower and the eligibility gate turned
// it away — the legacy AST emitter picked it up and inlined the statements into
// `_start` itself. That made script support a reason the AST emitter could not
// retire (#3457). Desugaring here instead lets the one IR pipeline serve both
// shapes, and it lands in asmcore so every backend's IR path gets it from the
// shared frontend rather than three parallel copies.
//
// A trailing `return 0;` is appended when the script does not already end in a
// return, matching the fallback exit-0 epilogue the AST emitter wrote after the
// inlined statements. Function-shaped modules are returned unchanged, so this is
// inert for every program that already has a `main`.
pub function synth_script_main(mod: parser.Module): parser.Module {
    if (!is_script_module(mod)) { return mod; }
    var body: parser.Stmt[] = mod.top_stmts;
    var ends_in_return: boolean = false;
    match (body[body.len() - 1]) {
        parser.StmtReturn(r) => { ends_in_return = true; },
        _ => { },
    }
    if (!ends_in_return) {
        body = body.append(parser.StmtReturn {
            value: parser.ExprNumber { text: "0", suffix: "", raw: "", is_float: false, line: 0, col: 0 },
            line: 0,
            col: 0,
        });
    }
    var entry: parser.FuncDecl = parser.FuncDecl {
        name: "main", receiver_name: "", receiver_type: "", type_params: [],
        params: [], ret_type: "i32", body: body, line: 0, col: 0,
        import_iface: "", import_wit: "", type_param_count: 0,
        bound_traits: [], fip: false, fbip: false, fip_allowance: 0, ret_str: false, async: false,
        is_pub: true,
    is_const: false };
    return parser.Module { ...mod, funcs: mod.funcs.append(entry), top_stmts: [] };
}

pub struct CheckCtx { st: EmitState, diags: util.Diag[] }

pub function is_wrapper(tag: Ty): boolean {
    return is_option(tag) || is_result(tag);
}

pub function is_concrete(tag: Ty): boolean {
    return is_int_tag(tag) || ty_is_string(tag) || ty_is_bool(tag) || ty_is_f64(tag)
        || is_int_array_tag(tag) || ty_is_array_string(tag) || ty_is_array(tag);
}

pub function assignable(want: Ty, got: Ty): boolean {
    if (ty_eq(want, got)) { return true; }
    if (ty_is_unknown(want) || ty_is_unknown(got)) { return true; }
    var ww: boolean = is_wrapper(want);
    var gw: boolean = is_wrapper(got);
    if (ww && gw) { return true; }
    if (ww || gw) {
        var other: Ty = want;
        if (ww) { other = got; }
        if (is_concrete(other)) { return false; }
        return true;
    }
    return true;
}

function parse_unknown_error(where: string, kind: string): util.Diag {
    // An out-of-range float literal is P002, the numeric-literal code native's
    // parser reports for it, not the generic parser-side-unknown P001 (#6842).
    if (util.is_f64_range_kind(kind)) {
        return util.Diag { code: "P002", message: where + ": " + util.f64_range_message(kind), line: 0, col: 0 };
    }
    return util.Diag { code: "P001", message: where + ": parser-side unknown: " + kind, line: 0, col: 0 };
}

function collect_expr_unknown_errors(e: parser.Expr, where: string, errs: util.Diag[]): util.Diag[] {
    match (e) {
        parser.ExprIdent(_) => { return errs; },
        parser.ExprNumber(_) => { return errs; },
        parser.ExprString(_) => { return errs; },
        parser.ExprBool(_) => { return errs; },
        parser.ExprBinary(b) => {
            errs = collect_expr_unknown_errors(b.left, where, errs);
            return collect_expr_unknown_errors(b.right, where, errs);
        },
        parser.ExprUnary(u) => { return collect_expr_unknown_errors(u.operand, where, errs); },
        parser.ExprCall(c) => {
            errs = collect_expr_unknown_errors(c.callee, where, errs);
            var i: i32 = 0;
            while (i < c.args.len()) {
                errs = collect_expr_unknown_errors(c.args[i], where, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                errs = collect_expr_unknown_errors(a.elements[i], where, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                errs = collect_expr_unknown_errors(t.elements[i], where, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.ExprMapLit(ml) => {
            var i: i32 = 0;
            while (i < ml.keys.len()) {
                errs = collect_expr_unknown_errors(ml.keys[i], where, errs);
                errs = collect_expr_unknown_errors(ml.vals[i], where, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.ExprFString(fs) => {
            var i: i32 = 0;
            while (i < fs.exprs.len()) {
                if (fs.is_expr[i]) { errs = collect_expr_unknown_errors(fs.exprs[i], where, errs); }
                i = i + 1;
            }
            return errs;
        },
        parser.ExprIndex(x) => {
            errs = collect_expr_unknown_errors(x.array, where, errs);
            return collect_expr_unknown_errors(x.index, where, errs);
        },
        parser.ExprSlice(sl) => {
            errs = collect_expr_unknown_errors(sl.array, where, errs);
            errs = collect_expr_unknown_errors(sl.start, where, errs);
            return collect_expr_unknown_errors(sl.end, where, errs);
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base) { errs = collect_expr_unknown_errors(sl.base, where, errs); }
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                errs = collect_expr_unknown_errors(sl.field_values[i], where, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.ExprFieldAccess(fa) => { return collect_expr_unknown_errors(fa.obj, where, errs); },
        parser.ExprLambda(lm) => {
            var i: i32 = 0;
            while (i < lm.body.len()) {
                errs = collect_stmt_unknown_errors(lm.body[i], where, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.ExprUnknown(u) => { return errs.append(parse_unknown_error(where, u.kind)); }
    }
    return errs;
}

function collect_stmt_unknown_errors(st: parser.Stmt, where: string, errs: util.Diag[]): util.Diag[] {
    match (st) {
        parser.StmtVar(v) => { return collect_expr_unknown_errors(v.init, where, errs); },
        parser.StmtReturn(r) => {
            // A bare `return;` is encoded as ExprUnknown("punct:;"). It's a
            // parser sentinel, not a real unknown expression — later checker
            // passes validate whether it is legal in context (void vs non-void).
            match (r.value) {
                parser.ExprUnknown(u) => {
                    if (u.kind == "punct:;") { return errs; }
                },
                _ => {}
            }
            return collect_expr_unknown_errors(r.value, where, errs);
        },
        parser.StmtExpr(e) => { return collect_expr_unknown_errors(e.value, where, errs); },
        parser.StmtIf(i) => {
            errs = collect_expr_unknown_errors(i.cond, where, errs);
            var ti: i32 = 0;
            while (ti < i.then_body.len()) {
                errs = collect_stmt_unknown_errors(i.then_body[ti], where, errs);
                ti = ti + 1;
            }
            var ei: i32 = 0;
            while (ei < i.else_body.len()) {
                errs = collect_stmt_unknown_errors(i.else_body[ei], where, errs);
                ei = ei + 1;
            }
            return errs;
        },
        parser.StmtWhile(w) => {
            errs = collect_expr_unknown_errors(w.cond, where, errs);
            var i: i32 = 0;
            while (i < w.body.len()) {
                errs = collect_stmt_unknown_errors(w.body[i], where, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.StmtAssign(a) => { return collect_expr_unknown_errors(a.value, where, errs); },
        parser.StmtMatch(m) => {
            errs = collect_expr_unknown_errors(m.scrutinee, where, errs);
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                if (m.arms[ai].has_guard) {
                    errs = collect_expr_unknown_errors(m.arms[ai].guard, where, errs);
                }
                var bi: i32 = 0;
                while (bi < m.arms[ai].body.len()) {
                    errs = collect_stmt_unknown_errors(m.arms[ai].body[bi], where, errs);
                    bi = bi + 1;
                }
                ai = ai + 1;
            }
            return errs;
        },
        parser.StmtFor(f) => {
            errs = collect_expr_unknown_errors(f.iter, where, errs);
            var i: i32 = 0;
            while (i < f.body.len()) {
                errs = collect_stmt_unknown_errors(f.body[i], where, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.StmtBreak(_) => { return errs; },
        parser.StmtContinue(_) => { return errs; },
        parser.StmtUnknown(u) => { return errs.append(parse_unknown_error(where, "stmt: " + u.kind)); },
        parser.StmtDefer(d) => { return collect_stmt_unknown_errors(d.action, where, errs); }
    }
    return errs;
}

pub function parse_unknown_errors_module(mod: parser.Module): util.Diag[] {
    var errs: util.Diag[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var where: string = "in fn '" + mod.funcs[fi].name + "'";
        if (mod.funcs[fi].name.len() == 0) {
            errs = errs.append(util.Diag { code: "P001", message: "malformed function declaration",
                line: mod.funcs[fi].line, col: mod.funcs[fi].col });
            where = "in malformed function declaration";
        }
        var bi: i32 = 0;
        while (bi < mod.funcs[fi].body.len()) {
            errs = collect_stmt_unknown_errors(mod.funcs[fi].body[bi], where, errs);
            bi = bi + 1;
        }
        fi = fi + 1;
    }
    var ti: i32 = 0;
    while (ti < mod.top_stmts.len()) {
        errs = collect_stmt_unknown_errors(mod.top_stmts[ti], "at top level", errs);
        ti = ti + 1;
    }
    return errs;
}

// has_to_string reports whether receiver-type name `rt` has a `to_string`
// method declared in this unit. Used by the Display gate below; a bare
// declaration is enough, because irlower dispatches the call by that name.
function has_to_string(rt: string, st: EmitState): boolean {
    if (rt.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < st.funcs.len()) {
        if (st.funcs[i].name == "to_string" && st.funcs[i].receiver_type.len() > 0
                && util.base_type_name(st.funcs[i].receiver_type) == rt) { return true; }
        i = i + 1;
    }
    return false;
}

// display_arg_errs gates the single argument of `print` / `write` /
// `eprint` on its type — the self-host half of native's "Display spine"
// (#2696, the `case "print", "write", "eprint"` block in
// internal/checker/checker.go).
//
// The three builtins accept any `T: Display`, not just `string`: a string
// passes through, anything else is stringified through the type's
// `to_string` (irlower's display_arg does the rewrite), and only a type
// with no `to_string` at all is an error. Without the gate the raw value
// reaches the string-only runtime helper, which reads it as a `(ptr, len)`
// box — a `u8[]` printed nothing and a struct printed its own raw bytes
// with the length read out of a field, both silent wrong answers on
// programs the compiler accepted (#5742).
//
// A type the partial `Ty` union cannot model comes back unknown; those
// are skipped rather than mis-flagged, the same discipline the E038 /
// E003 argument passes already use.
function display_arg_errs(e: parser.Expr, fname: string, st: EmitState): util.Diag[] {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if ((id.name == "print" || id.name == "write" || id.name == "eprint")
                            && c.args.len() == 1) {
                        var at: Ty = infer_expr_type(c.args[0], st);
                        if (ty_is_unknown(at) || ty_is_string(at)) { return []; }
                        var an: string = ty_friendly(at);
                        // Accept only what irlower's display_arg will actually
                        // rewrite: a NAMED STRUCT carrying a `to_string`. This gate
                        // has to stay the narrower of the two — rejecting is loud,
                        // whereas accepting something the lowering then leaves alone
                        // hands the raw value to the string-only helper, which is
                        // the #5742 silent wrong answer.
                        if (ty_struct_name(at).len() > 0 && has_to_string(an, st)) { return []; }
                        if (has_to_string(an, st) && is_prim_recv_name(an, st)) {
                            // A PRIMITIVE receiver's `.to_string()` resolves to the
                            // built-in formatter in irlower, never to a declared
                            // method, so rewriting here would print the builtin's
                            // answer instead of the one the reader wrote. Refuse
                            // loudly rather than stringify the wrong way.
                            return [util.Diag { code: "E038", message: "in fn '" + fname + "': argument 1 to "
                                + id.name + ": " + an + " has a `to_string(): string`, but the"
                                + " self-hosted compiler dispatches `.to_string()` on a primitive to its"
                                + " built-in formatter, so that method would not be called", line: id.line, col: id.col }];
                        }
                        return [util.Diag { code: "E038", message: "in fn '" + fname + "': argument 1 to "
                            + id.name + ": " + util.demangle(an)
                            + " does not implement `Display` (no `to_string(): string` in scope)"
                            + " — give " + util.demangle(an) + " a `to_string(): string` method, or "
                            + util.derive_hint(an, "cmp.Display", "cmp.Display"), line: id.line, col: id.col }];
                    }
                    return [];
                },
                _ => { return []; }
            }
        },
        _ => { return []; }
    }
    return [];
}

pub function check_stmt(st: parser.Stmt, want: Ty, fname: string, ctx: CheckCtx): CheckCtx {
    match (st) {
        parser.StmtExpr(ex) => {
            return CheckCtx { st: ctx.st, diags: util.append_diags(ctx.diags, display_arg_errs(ex.value, fname, ctx.st)) };
        },
        parser.StmtReturn(r) => {
            var got: Ty = infer_expr_type(r.value, ctx.st);
            if (!assignable(want, got)) {
                return CheckCtx {
                    st: ctx.st,
                    diags: ctx.diags.append(util.Diag { code: "E002", message: "in fn '" + fname
                        + "': returns " + ty_friendly(want)
                        + " but expression has type " + ty_friendly(got), line: r.line, col: r.col })
                };
            }
            return ctx;
        },
        parser.StmtVar(v) => {
            // Compiler-synthesized temps (`__defret`, `__dfa<N>`, `__env`, …)
            // are declared as i32-0 by the defer/errdefer/closure desugars and
            // then carry values of the enclosing function's own types (the
            // defer return slot holds the return expression). Bind them
            // unknown so the pre-codegen gate doesn't false-positive on
            // desugared bodies (#4327).
            if (v.name.len() >= 2 && v.name[0:2] == "__") {
                return CheckCtx { st: ctx.st.bind_local_typed(v.name, ty_unknown()), diags: ctx.diags };
            }
            var got: Ty = infer_expr_type(v.init, ctx.st);
            var bind_ty: Ty = got;
            if (v.type_name.len() > 0) {
                var declared: Ty = ty_from_name(v.type_name);
                // Bind through struct_local_tag, which resolves a declared
                // struct name to TyStructNamed where ty_from_name collapses
                // it to unknown — the same tag params already get in
                // check_func. `declared` itself stays ty_from_name so the
                // E003 comparison below is unchanged; only the recorded
                // local type gets sharper, which is what lets the
                // print/write/eprint gate see a struct argument (#5742).
                bind_ty = struct_local_tag(v.type_name, ctx.st);
                if (!assignable(declared, got)) {
                    ctx = CheckCtx {
                        st: ctx.st,
                        diags: ctx.diags.append(util.Diag { code: "E003", message: "in fn '" + fname
                            + "': variable '" + v.name + "' declared "
                            + ty_friendly(declared) + " but initializer has type "
                            + ty_friendly(got), line: v.line, col: v.col })
                    };
                }
            }
            return CheckCtx { st: ctx.st.bind_local_typed(v.name, bind_ty), diags: ctx.diags };
        },
        parser.StmtAssign(a) => {
            var got: Ty = infer_expr_type(a.value, ctx.st);
            var tt: Ty = ctx.st.local_type_of(a.target);
            if (!assignable(tt, got)) {
                // E003, matching native's numbering (assignment / annotated-var
                // type mismatch); native E004 is call arity (#4327 fold-in —
                // this guard used to say E004).
                return CheckCtx {
                    st: ctx.st,
                    diags: ctx.diags.append(util.Diag { code: "E003", message: "in fn '" + fname
                        + "': assignment to '" + a.target + "' of type "
                        + ty_friendly(tt) + " from expression of type "
                        + ty_friendly(got), line: a.line, col: a.col })
                };
            }
            return ctx;
        },
        parser.StmtIf(f) => {
            ctx = check_stmts(f.then_body, want, fname, ctx);
            return check_stmts(f.else_body, want, fname, ctx);
        },
        parser.StmtWhile(w) => {
            return check_stmts(w.body, want, fname, ctx);
        },
        parser.StmtFor(fo) => {
            var it: Ty = infer_expr_type(fo.iter, ctx.st);
            var elem: Ty = ty_unknown();
            if (ty_is_array_i32(it)) { elem = ty_i32(); }
            if (ty_is_array_u32(it)) { elem = ty_u32(); }
            if (ty_is_array_u64(it)) { elem = ty_u64(); }
            if (ty_is_array_i64(it)) { elem = ty_i64(); }
            if (ty_is_array_string(it)) { elem = ty_string(); }
            ctx = CheckCtx { st: ctx.st.bind_local_typed(fo.var_name, elem), diags: ctx.diags };
            return check_stmts(fo.body, want, fname, ctx);
        },
        parser.StmtMatch(m) => {
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var actx: CheckCtx = ctx;
                match (m.arms[ai].pattern) {
                    parser.PatVariant(pv) => {
                        if ((pv.type_name == "Some" || pv.type_name == "Ok")
                                && pv.binding.len() > 0) {
                            actx = CheckCtx {
                                st: ctx.st.bind_local_typed(pv.binding,
                                    match_payload_type(m.scrutinee, ctx.st)),
                                diags: ctx.diags
                            };
                        }
                    },
                    parser.PatWildcard(_) => { }
                }
                actx = check_stmts(m.arms[ai].body, want, fname, actx);
                // Keep accumulated errors; drop arm-local bindings.
                ctx = CheckCtx { st: ctx.st, diags: actx.diags };
                ai = ai + 1;
            }
            return ctx;
        },
        _ => { return ctx; }
    }
    return ctx;
}

pub function check_stmts(stmts: parser.Stmt[], want: Ty, fname: string, ctx: CheckCtx): CheckCtx {
    var i: i32 = 0;
    while (i < stmts.len()) {
        ctx = check_stmt(stmts[i], want, fname, ctx);
        i = i + 1;
    }
    return ctx;
}

pub function check_func(fd: parser.FuncDecl, s: EmitState): util.Diag[] {
    var want: Ty = ty_from_name(fd.ret_type);
    var s2: EmitState = s.reset_locals();
    if (fd.receiver_type.len() > 0) {
        s2 = s2.bind_local_typed(fd.receiver_name, struct_local_tag(fd.receiver_type, s2));
    }
    var pi: i32 = 0;
    while (pi < fd.params.len()) {
        s2 = s2.bind_local_typed(fd.params[pi].name, struct_local_tag(fd.params[pi].type_name, s2));
        pi = pi + 1;
    }
    var ctx: CheckCtx = CheckCtx { st: s2, diags: [] };
    ctx = check_stmts(fd.body, want, fd.name, ctx);
    return ctx.diags;
}

pub function check_module(mod: parser.Module, s: EmitState): util.Diag[] {
    var errs: util.Diag[] = parse_unknown_errors_module(mod);
    if (errs.len() > 0) { return errs; }
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        errs = util.append_diags(errs, check_func(mod.funcs[fi], s));
        fi = fi + 1;
    }
    // Bare-map_new chain gate (native E038/E003 parity): without it the
    // emitters MISCOMPILE the chain instead of rejecting (see
    // check_map_new_chain).
    errs = util.append_diags(errs, check_map_new_chain(mod));
    // Undefined-callee gate (native E001 parity): without it emit_call's
    // generic fall-through emits `call __fn_<name>` against a symbol that
    // does not exist and the compiler exits 0, turning a source-level typo
    // (or a skipped import) into a bare linker error (#5644). Runs on BOTH
    // codegen routes — emit_module gates the IR path with this same check.
    errs = util.append_diags(errs, check_undefined_calls(mod));
    return errs;
}

// ==== bare-map_new chain key-kind gate (the native-E038 miscompile class) ====
//
// `map_new(8).insert(1, 10)` is NATIVE-INVALID (map_new's K/V are generic and
// only a `var m: Map[K, V] = map_new(n)` annotation pins them — native
// rejects the chain with E038 per argument + E003 at the binding). The
// self-host inference instead KEY-KINDS a bare ctor result by its NAME
// (map_new = string-keyed, map_new_i32 = i32-keyed), so a chain whose key
// arguments DISAGREE with the ctor's key kind sailed through check and the
// emitters MISCOMPILED it — an i32 key dispatched through the string-keyed
// map runtime (SIGSEGV at runtime). Reject exactly that mismatch: an
// arg-taking map method (insert / get / get_or / has / without) whose chain
// ROOT is a bare map_new [map_new_i32] call and whose KEY argument is a
// number [string] literal. A KIND-CONSISTENT chain is deliberately admitted
// (narrower than native): the parser's own `Map { … }` literal desugar IS
// such a chain (ctor picked from the first key's form), and consistent
// chains lower correctly here. Non-literal keys are unjudgeable cheaply and
// stay admitted (a wrong-typed ident key still miscompiles — closing that
// needs the full checker's key-type unification).
//
// map_chain_root_ctor descends through chained arg-taking map-method calls
// to the root callee; "" when the root is not a bare map ctor call.
function map_chain_root_ctor(e: parser.Expr): string {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "map_new" || cid.name == "map_new_i32") { return cid.name; }
                    return "";
                },
                parser.ExprFieldAccess(fa) => {
                    if (fa.field == "insert" || fa.field == "get" || fa.field == "get_or"
                            || fa.field == "has" || fa.field == "without") {
                        return map_chain_root_ctor(fa.obj);
                    }
                    return "";
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
}
function map_chain_check_expr(e: parser.Expr, fname: string, errs: util.Diag[]): util.Diag[] {
    var out: util.Diag[] = errs;
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprFieldAccess(fa) => {
                    if ((fa.field == "insert" || fa.field == "get" || fa.field == "get_or"
                            || fa.field == "has" || fa.field == "without") && c.args.len() > 0) {
                        var mroot: string = map_chain_root_ctor(fa.obj);
                        if (mroot.len() > 0) {
                            var mism: boolean = false;
                            match (c.args[0]) {
                                parser.ExprNumber(_) => { if (mroot == "map_new") { mism = true; } },
                                parser.ExprString(_) => { if (mroot == "map_new_i32") { mism = true; } },
                                _ => {}
                            }
                            if (mism) {
                                out = out.append(util.Diag { code: "E038", message: "in fn '" + fname
                                    + "': '" + fa.field + "' key does not match the key kind of the"
                                    + " unannotated " + mroot + "() chain it is called on — the"
                                    + " ctor's key/value types are not inferable through a method"
                                    + " chain; bind it first (var m: Map[K, V] = " + mroot + "(n))", line: 0, col: 0 });
                            }
                        }
                    }
                    out = map_chain_check_expr(fa.obj, fname, out);
                },
                _ => { out = map_chain_check_expr(c.callee, fname, out); }
            }
            var i: i32 = 0;
            while (i < c.args.len()) { out = map_chain_check_expr(c.args[i], fname, out); i = i + 1; }
            return out;
        },
        parser.ExprBinary(b) => { return map_chain_check_expr(b.right, fname, map_chain_check_expr(b.left, fname, out)); },
        parser.ExprUnary(u) => { return map_chain_check_expr(u.operand, fname, out); },
        parser.ExprIndex(ix) => { return map_chain_check_expr(ix.index, fname, map_chain_check_expr(ix.array, fname, out)); },
        parser.ExprSlice(sl) => { return map_chain_check_expr(sl.end, fname, map_chain_check_expr(sl.start, fname, map_chain_check_expr(sl.array, fname, out))); },
        parser.ExprFieldAccess(fa2) => { return map_chain_check_expr(fa2.obj, fname, out); },
        parser.ExprStructLit(sl2) => {
            if (sl2.has_base) { out = map_chain_check_expr(sl2.base, fname, out); }
            var i: i32 = 0;
            while (i < sl2.field_values.len()) { out = map_chain_check_expr(sl2.field_values[i], fname, out); i = i + 1; }
            return out;
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { out = map_chain_check_expr(a.elements[i], fname, out); i = i + 1; }
            return out;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { out = map_chain_check_expr(t.elements[i], fname, out); i = i + 1; }
            return out;
        },
        _ => { return out; }
    }
}
function map_chain_check_stmts(stmts: parser.Stmt[], fname: string, errs: util.Diag[]): util.Diag[] {
    var out: util.Diag[] = errs;
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => { out = map_chain_check_expr(v.init, fname, out); },
            parser.StmtAssign(a) => { out = map_chain_check_expr(a.value, fname, out); },
            parser.StmtExpr(ex) => { out = map_chain_check_expr(ex.value, fname, out); },
            parser.StmtReturn(r) => { out = map_chain_check_expr(r.value, fname, out); },
            parser.StmtIf(iff) => {
                out = map_chain_check_expr(iff.cond, fname, out);
                out = map_chain_check_stmts(iff.then_body, fname, out);
                out = map_chain_check_stmts(iff.else_body, fname, out);
            },
            parser.StmtWhile(w) => {
                out = map_chain_check_expr(w.cond, fname, out);
                out = map_chain_check_stmts(w.body, fname, out);
            },
            parser.StmtFor(fo) => {
                out = map_chain_check_expr(fo.iter, fname, out);
                out = map_chain_check_stmts(fo.body, fname, out);
            },
            parser.StmtMatch(m) => {
                out = map_chain_check_expr(m.scrutinee, fname, out);
                var ai: i32 = 0;
                while (ai < m.arms.len()) {
                    if (m.arms[ai].has_guard) { out = map_chain_check_expr(m.arms[ai].guard, fname, out); }
                    out = map_chain_check_stmts(m.arms[ai].body, fname, out);
                    ai = ai + 1;
                }
            },
            parser.StmtDefer(d) => { out = map_chain_check_stmts([d.action], fname, out); },
            _ => {}
        }
        i = i + 1;
    }
    return out;
}
pub function check_map_new_chain(mod: parser.Module): util.Diag[] {
    var errs: util.Diag[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        errs = map_chain_check_stmts(mod.funcs[fi].body, mod.funcs[fi].name, errs);
        fi = fi + 1;
    }
    return errs;
}

// ==== direct-call gates: E004 arity (#4360) + E001 undefined callee (#5644) ====
//
// Two standalone, false-positive-safe passes over bare-identifier CALL sites,
// sharing one walk:
//
//   * check_call_arity — native E004, for driver paths that run no full
//     checker gate (the wasm drivers), where an arg-count mismatch used to
//     sail through the emitter and miscompile while the Go compiler rejects at
//     check time. Callers pass a fill_default_args_module'd module so omitted
//     defaulted arguments don't read as mismatches.
//   * check_undefined_calls — native E001. A callee naming nothing used to
//     reach emit_call's generic fall-through, which emitted `call __fn_<name>`
//     against a symbol that does not exist and exited 0; the failure surfaced
//     as `undefined reference to __fn_<name>` from the LINKER, with no source
//     position and no indication of which construct caused it. An unresolved
//     import is the same defect one level up — modloader SKIPS an import it
//     cannot read, so every qualified call into it becomes a dangling
//     `__fn_<ns>__<name>` (#5644).
//
// Both rules only fire on a callee that is a bare identifier NOT shadowed by
// any binding in the enclosing function (params, receiver, vars, for/match
// bindings, lambda params — collected function-wide, which can only SKIP a
// check, never invent one). Method calls, fn-value calls, and any construct
// the walk doesn't recognise are skipped.
//
// The undefined rule is checked at the same place the emitters give up, so it
// needs no guesswork about what a builtin is: it admits every name the
// emitters resolve WITHOUT a declaration — the `__` intrinsic namespace (raw-
// memory ops plus every compiler-generated temp), the front-end builtins
// (parser.builtin_function_names), the free-function spellings only the self-
// host emitters intercept (emitter_call_names), every declared function and
// struct (an enum-variant constructor is a struct with enum_owner set) plus
// the injected builtin variants, and Some / None / Ok / Err, which the
// emitters special-case and never declare. What is left cannot link.

// CallGate is the shared walk's parameter block: the free-function arity table
// (`names` / `argc`, parallel arrays), the undefined rule's admit list
// (`known`), and which of the two rules are live.
struct CallGate { names: string[], argc: i32[], known: string[], check_arity: boolean, check_undef: boolean }

function callgate_name_in(names: string[], name: string): boolean {
    var i: i32 = 0;
    while (i < names.len()) {
        if (names[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}


// emitter_call_names are the free-function spellings the self-host emitters
// intercept in try_emit_builtin / lower_expr beyond the front-end builtin set:
// the string helpers (`str_split(s, sep)` is the free form of `s.split(sep)`),
// the i32 stringifier and its one mangled stdlib special case, and the raw
// string writer. Native's checker rejects these bare forms (E001), so they are
// deliberately NOT in parser.builtin_function_names — but the emitters DO
// lower them, so this gate must admit them or valid self-host programs break.
function emitter_call_names(): string[] {
    return [
        "str_contains", "str_ends_with", "str_starts_with", "str_index_of",
        "str_repeat", "str_replace", "str_split", "str_trim",
        "str_to_i32", "str_to_lower", "str_to_upper",
        "i32_to_string", "int__int_to_string", "print_str"
    ];
}

// callgate_known_names builds the undefined rule's admit list. Ordered
// cheapest-first for the common misses: the builtin sets (a `print` /
// `len` call is a miss against the free-function table and lands here),
// then structs and variants, then the receiver methods and top-level
// bindings. Free functions are NOT repeated here — the walk consults the
// arity table first, so a plain user call never reaches this array.
function callgate_known_names(mod: parser.Module): string[] {
    var out: string[] = parser.builtin_function_names();
    var ei: i32 = 0;
    var extra: string[] = emitter_call_names();
    while (ei < extra.len()) { out = out.append(extra[ei]); ei = ei + 1; }
    // Option / Result constructors: special-cased in every emitter, never a
    // declared struct (see parser.inject_builtin_enums' note).
    out = out.append("Some");
    out = out.append("None");
    out = out.append("Ok");
    out = out.append("Err");
    // Declared structs + the built-in variant structs. inject_builtin_enums is
    // idempotent (each entry is guarded by struct_declared), so this covers the
    // drivers that skip module_with_builtins as well as those that don't.
    var sd: parser.StructDecl[] = parser.inject_builtin_enums(mod.structs);
    var si: i32 = 0;
    while (si < sd.len()) { out = out.append(sd[si].name); si = si + 1; }
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        if (mod.funcs[fi].receiver_type.len() > 0) { out = out.append(mod.funcs[fi].name); }
        fi = fi + 1;
    }
    out = astwalk.collect_bound_stmts(mod.top_stmts, out);
    return out;
}

// callgate_module_ns returns the module namespace of a mangled cross-module
// name (`jni__call0` → "jni") when NO other name of that namespace is present
// — the signature of an import that resolved to no file and was skipped,
// rather than one mistyped call. "" when the namespace is populated (so the
// diagnostic blames the name, not the import) or the name is unmangled.
function callgate_module_ns(name: string, names: string[], known: string[]): string {
    var i: i32 = 1;
    while (i + 1 < name.len()) {
        if (name[i] == b'_' && name[i + 1] == b'_') {
            // `+ ""` materialises the slice as a string — a bare slice is the
            // `str` view type (the idiom astwalk's binder split uses).
            var ns: string = name[0:i] + "";
            var pfx: string = ns + "__";
            if (callgate_ns_present(pfx, names) || callgate_ns_present(pfx, known)) { return ""; }
            return ns;
        }
        i = i + 1;
    }
    return "";
}

function callgate_ns_present(pfx: string, names: string[]): boolean {
    var i: i32 = 0;
    while (i < names.len()) {
        var nm: string = names[i];
        if (nm.len() > pfx.len() && nm[0:pfx.len()] == pfx) { return true; }
        i = i + 1;
    }
    return false;
}

function callgate_undefined_error(g: CallGate, where: string, name: string, line: i32, col: i32): util.Diag {
    var out: string = where + ": call to undefined function '" + name + "'";
    var ns: string = callgate_module_ns(name, g.names, g.known);
    if (ns.len() > 0) {
        out = out + " — no module '" + ns + "' was loaded (an import that resolves to no"
            + " file is skipped, so every call into it dangles)";
    }
    return util.Diag { code: "E001", message: out, line: line, col: col };
}

// callgate_expr walks one expression, appending a diagnostic line for each
// direct call the live rules reject. `bound` is the enclosing function's
// shadow set.
function callgate_expr(e: parser.Expr, g: CallGate, where: string, bound: string[], errs: util.Diag[]): util.Diag[] {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => {
                    if (!callgate_name_in(bound, id.name)) {
                        var found: boolean = false;
                        var ti: i32 = 0;
                        while (ti < g.names.len()) {
                            if (g.names[ti] == id.name) {
                                found = true;
                                if (g.check_arity && c.args.len() != g.argc[ti]) {
                                    errs = errs.append(util.Diag { code: "E004", message: "function '" + id.name
                                        + "' expects " + util.i32_to_string(g.argc[ti])
                                        + " argument(s), got " + util.i32_to_string(c.args.len()), line: id.line, col: id.col });
                                }
                                ti = g.names.len();
                            } else { ti = ti + 1; }
                        }
                        if (g.check_undef && !found && !callgate_known_callee(id.name, g.known)) {
                            errs = errs.append(callgate_undefined_error(g, where, id.name, id.line, id.col));
                        }
                    }
                },
                _ => { errs = callgate_expr(c.callee, g, where, bound, errs); }
            }
            var i: i32 = 0;
            while (i < c.args.len()) {
                errs = callgate_expr(c.args[i], g, where, bound, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.ExprBinary(b) => {
            errs = callgate_expr(b.left, g, where, bound, errs);
            return callgate_expr(b.right, g, where, bound, errs);
        },
        parser.ExprUnary(u) => { return callgate_expr(u.operand, g, where, bound, errs); },
        parser.ExprIndex(x) => {
            errs = callgate_expr(x.array, g, where, bound, errs);
            return callgate_expr(x.index, g, where, bound, errs);
        },
        parser.ExprSlice(sl) => {
            errs = callgate_expr(sl.array, g, where, bound, errs);
            errs = callgate_expr(sl.start, g, where, bound, errs);
            return callgate_expr(sl.end, g, where, bound, errs);
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) {
                errs = callgate_expr(a.elements[i], g, where, bound, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) {
                errs = callgate_expr(t.elements[i], g, where, bound, errs);
                i = i + 1;
            }
            return errs;
        },
        parser.ExprStructLit(sl) => {
            var i: i32 = 0;
            while (i < sl.field_values.len()) {
                errs = callgate_expr(sl.field_values[i], g, where, bound, errs);
                i = i + 1;
            }
            if (sl.has_base) { errs = callgate_expr(sl.base, g, where, bound, errs); }
            return errs;
        },
        parser.ExprFieldAccess(fa) => { return callgate_expr(fa.obj, g, where, bound, errs); },
        parser.ExprLambda(lm) => {
            // Lambda params shadow inside its body only; extend a body-local
            // copy of the shadow set.
            var lb: string[] = bound;
            var pi: i32 = 0;
            while (pi < lm.params.len()) {
                lb = lb.append(lm.params[pi].name);
                pi = pi + 1;
            }
            lb = astwalk.collect_bound_stmts(lm.body, lb);
            return callgate_stmts(lm.body, g, where, lb, errs);
        },
        _ => { return errs; }
    }
    return errs;
}

// callgate_known_callee reports whether `name` is a callee the emitters
// resolve without a module declaration — see the admit list above. The `__`
// namespace is tested by prefix rather than by name because it covers every
// raw-memory intrinsic AND every compiler-generated temp (`__lam_…`,
// `__range`, `__env`, …), which no list could track.
function callgate_known_callee(name: string, known: string[]): boolean {
    if (name.len() == 0) { return true; }
    if (name.len() >= 2 && name[0:2] == "__") { return true; }
    return callgate_name_in(known, name);
}

function callgate_stmts(stmts: parser.Stmt[], g: CallGate, where: string, bound: string[], errs: util.Diag[]): util.Diag[] {
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtVar(v) => { errs = callgate_expr(v.init, g, where, bound, errs); },
            parser.StmtReturn(r) => { errs = callgate_expr(r.value, g, where, bound, errs); },
            parser.StmtExpr(x) => { errs = callgate_expr(x.value, g, where, bound, errs); },
            parser.StmtAssign(a) => { errs = callgate_expr(a.value, g, where, bound, errs); },
            parser.StmtIf(f) => {
                errs = callgate_expr(f.cond, g, where, bound, errs);
                errs = callgate_stmts(f.then_body, g, where, bound, errs);
                errs = callgate_stmts(f.else_body, g, where, bound, errs);
            },
            parser.StmtWhile(w) => {
                errs = callgate_expr(w.cond, g, where, bound, errs);
                errs = callgate_stmts(w.body, g, where, bound, errs);
            },
            parser.StmtFor(fo) => {
                errs = callgate_expr(fo.iter, g, where, bound, errs);
                errs = callgate_stmts(fo.body, g, where, bound, errs);
            },
            parser.StmtMatch(m) => {
                errs = callgate_expr(m.scrutinee, g, where, bound, errs);
                var ai: i32 = 0;
                while (ai < m.arms.len()) {
                    if (m.arms[ai].has_guard) { errs = callgate_expr(m.arms[ai].guard, g, where, bound, errs); }
                    errs = callgate_stmts(m.arms[ai].body, g, where, bound, errs);
                    ai = ai + 1;
                }
            },
            parser.StmtDefer(d) => { errs = callgate_stmts([d.action], g, where, bound, errs); },
            _ => {}
        }
        i = i + 1;
    }
    return errs;
}

// callgate_free_names / callgate_free_argc build the free-function arity table
// (receiver methods dispatch by field access, never by bare name — excluded).
function callgate_free_names(mod: parser.Module): string[] {
    var names: string[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        if (mod.funcs[fi].receiver_type.len() == 0) { names = names.append(mod.funcs[fi].name); }
        fi = fi + 1;
    }
    return names;
}

function callgate_free_argc(mod: parser.Module): i32[] {
    var argc: i32[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        if (mod.funcs[fi].receiver_type.len() == 0) { argc = argc.append(mod.funcs[fi].params.len()); }
        fi = fi + 1;
    }
    return argc;
}

// callgate_run walks every function body (and, for the undefined rule, the
// top-level statements) under `g`.
function callgate_run(mod: parser.Module, g: CallGate): util.Diag[] {
    var errs: util.Diag[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        var fd: parser.FuncDecl = mod.funcs[fi];
        var bound: string[] = [];
        if (fd.receiver_type.len() > 0) { bound = bound.append(fd.receiver_name); }
        var pi: i32 = 0;
        while (pi < fd.params.len()) {
            bound = bound.append(fd.params[pi].name);
            pi = pi + 1;
        }
        bound = astwalk.collect_bound_stmts(fd.body, bound);
        errs = callgate_stmts(fd.body, g, "in fn '" + fd.name + "'", bound, errs);
        fi = fi + 1;
    }
    if (g.check_undef) {
        var tb: string[] = astwalk.collect_bound_stmts(mod.top_stmts, []);
        errs = callgate_stmts(mod.top_stmts, g, "at top level", tb, errs);
    }
    return errs;
}

pub function check_call_arity(mod: parser.Module): util.Diag[] {
    return callgate_run(mod, CallGate {
        names: callgate_free_names(mod), argc: callgate_free_argc(mod), known: [],
        check_arity: true, check_undef: false
    });
}

// check_decl_names rejects a module holding a NAMELESS function or struct.
//
// The self-host parser is deliberately permissive — `Par` carries no error
// channel, so a token it cannot use is skipped and the drivers' gates catch the
// consequences. For a declaration NAME that leaves no consequence to catch:
// `peek_member_name` returns "" for a keyword, and parse_func_decl then returns
// a FuncDecl with an empty name. The module parses "successfully" and the
// nameless function is simply carried through the whole pipeline.
//
// That is not hypothetical. `function use()` — `use` is in the lexer's keyword
// set — produced exactly this, and the empty-named function it left behind cost
// two sessions of #3457 a confidently WRONG bisection: probe programs that were
// silently malformed were read as evidence about the IR subset, and the
// conclusion was written into docs/SELFHOST-AST-RETIREMENT.md before anyone
// noticed the eligibility report listing a function called "". The native
// parser rejects the same source properly (`expected "Ident", got "use"`), so
// this is a self-host-only blind spot, and the divergence is what made it
// survive: every native oracle agreed the program was invalid while the
// self-host pipeline reported verdicts about it.
//
// A gate rather than a parser error because the parser has nowhere to put one;
// this is the same shape as check_call_arity / check_undefined_calls, and it
// runs in the same place.
pub function check_decl_names(mod: parser.Module): util.Diag[] {
    var errs: util.Diag[] = [];
    var i: i32 = 0;
    while (i < mod.funcs.len()) {
        if (mod.funcs[i].name.len() == 0) {
            errs = errs.append(util.Diag { code: "P001",
                message: "function declaration has no name (a keyword such as `use` / `type` / `match` cannot be used as one)",
                line: mod.funcs[i].line, col: 0 });
        }
        i = i + 1;
    }
    var si: i32 = 0;
    while (si < mod.structs.len()) {
        if (mod.structs[si].name.len() == 0) {
            errs = errs.append(util.Diag { code: "P001", message: "struct declaration has no name (a keyword cannot be used as one)",
                line: mod.structs[si].line, col: mod.structs[si].col });
        }
        si = si + 1;
    }
    return errs;
}

pub function check_undefined_calls(mod: parser.Module): util.Diag[] {
    // argc is filled even though the arity rule is off: the walk reads
    // `g.argc[ti]` under an `&&` with check_arity, and a parallel table is
    // cheaper than depending on short-circuit evaluation to keep an empty
    // array unindexed.
    return callgate_run(mod, CallGate {
        names: callgate_free_names(mod), argc: callgate_free_argc(mod),
        known: callgate_known_names(mod), check_arity: false, check_undef: true
    });
}

// contains -> util.contains (SH-020).
