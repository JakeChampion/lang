// examples/self_host/asm_modload_run.fern — import-driven self-host
// compiler driver. The successor to two stopgaps:
//
//   * bundle_run.fern, which reads several modules off ONE stdin stream
//     glued together with `///MODULE <name>` marker lines — a hand-packed
//     bundle the Go test harness concatenates, not real module loading.
//   * the synthetic builtin table (parser.inject_builtin_enums), which
//     conjures the built-in TYPES (JsonValue / IoError / FileStat / …) in
//     code instead of reading them from source.
//
// This driver instead does what the native compiler's `modload` does:
// take an ENTRY file path on argv, read it, follow its `import "./x"`
// declarations to sibling `x.fern` files on disk (transitively, via the
// shared ./modloader), merge everything with flatten.bundle, and emit x86-64
// asm over the typed lowering, which takes the built-in types from
// module_with_builtins as the CLI does.
//
//     $ asm_modload_run path/to/main.fern > main.s
//
// Module resolution lives in ./modloader (shared with the other
// import-driven drivers); see that file for the resolution rules. This driver is just the asm-emitting front door (+ an -ir-probe
// mode). Uses only features the self-hosted emitter supports (args,
// read_file → Result, match), so it builds with either compiler.

import "./util";
import "./lexer";
import "./parser";
import "./flatten";
import "./treeshake";
import "./asm_arm64_ir";
import "./asm_ir";
import "./asmcore";
import "./irtables";
import "./fnsigs";
import "./ir";
import "./irverify";
import "./irverifyprovided";
import "./irverifystack";
import "./modloader";
import "./ircore";
import "./constfold";
import "./platforms";
import "./semlower";

// ---- callee resolution (#6639 slice 4) ---------------------------------

// verify_provided_module runs the resolution pass over the whole merged
// program and writes the verdict, then how much of it the operand-stack pass
// models (`irverifystack: modelled M/N`): the compile-path gate skips a body
// the stack pass cannot model without a word, so the sweep is what notices a
// new op the pass does not carry. Returns the process exit code.
//
// This is the driver the sweep has to use: a driver that lowers ONE module
// leaves every imported `Type.method` unresolved by construction — a census
// over the conformance corpus found ~200 of 255 distinct unresolved names were
// stdlib methods reached through an import. The declared set is only complete
// once the bundle is.
function verify_provided_module(merged: parser.Module, target: string): i32 {
  let d: semlower.Driven = semlower.driven(merged, target);
  let names: string[] = [];
  let bodies: ir.Op[][] = [];
  let declared: string[] = [];
  // The bodies the emit reads: the typed lowering's, over the module
  // emit_module_ir_gated_sub gates, and the instances and drop helpers
  // it defines beside the declarations.
  let im: parser.Module = ircore.with_records(parser.infer_ret_types_module(ircore.script_normalized(ircore.sub_lifted(d.sub, d.full))), d.sub);
  let i: i32 = 0;
  while (i < im.funcs.len()) {
    declared = declared.append(fnsigs.grow_fn_key(im.funcs[i]));
    let r: irtables.LowerResult = ircore.produced(d.sub.bodies, i, im.funcs[i]);
    if (!r.superseded) {
      names = names.append(fnsigs.grow_fn_key(im.funcs[i]));
      bodies = bodies.append(r.ops);
    }
    i = i + 1;
  }
  for x in d.sub.extra {
    declared = declared.append(x.name);
    if (x.ok) {
      names = names.append(x.name);
      bodies = bodies.append(x.ops);
    }
  }
  // Every function the WHOLE program declares, keyed the way a call_direct
  // names it. `@import` externs are ordinary FuncDecls, so the host-supplied
  // half needs no separate arm.
  let ix: irverify.NameIndex = irverify.name_index(declared);
  let probs: irverify.Problem[] = [];
  let calls: i32 = 0;
  let cov: irverifystack.Coverage = irverifystack.coverage_new();
  let pops: i32[] = ir.pops_by_kind();
  let k: i32 = 0;
  while (k < names.len()) {
    let r: irverifyprovided.ProvidedResult = irverifyprovided.verify_provided_fn(names[k], bodies[k], ix);
    calls = calls + r.calls;
    for p in r.problems {
      probs = probs.append(p);
    }
    cov = irverifystack.coverage_add(cov, names[k], irverifystack.verify_stack_fn(names[k], bodies[k], pops).bail);
    k = k + 1;
  }
  let checked: i32 = names.len();
  let tally: string = "checked " + util.i32_to_string(checked) + " functions, "
    + util.i32_to_string(calls) + " direct calls";
  let stack: string = "irverifystack: " + irverifystack.coverage_str(cov) + "\n";
  if (probs.len() == 0) {
    write("irverifyprovided: clean (" + tally + ")\n" + stack);
    return 0;
  }
  write("irverifyprovided: " + util.i32_to_string(probs.len()) + " problem(s) (" + tally + ")"
    + irverify.format_problems(probs, 20) + "\n" + stack);
  return 1;
}

// provided_audit checks the verifier's inventory against the EMITTER's own
// predicate, and writes any name the two disagree about.
//
// Only this direction is checkable: `ircore.is_fern_helper` is a predicate, so
// a helper the emitter gained and the inventory did not cannot be enumerated
// out of it. That direction surfaces instead as an unresolved callee in the
// corpus sweep — which is the failure the pass exists to produce, so it is
// covered, just not here. This half catches the other drift: an inventory
// entry naming a helper no backend emits, which would silently excuse a real
// missing body.
function provided_audit(): i32 {
  let names: string[] = irverifyprovided.provided_names();
  let task_runtime: parser.Module = parser.parse_module(lexer.tokenize(asmcore.rt_src_task("x86-64-linux")));
  let task_names: string[] = [];
  for fd in task_runtime.funcs {
    task_names = task_names.append(fd.name);
  }
  let bad: string[] = [];
  let i: i32 = 0;
  while (i < names.len()) {
    // Task helpers use the user ABI. Check the actual runtime declarations:
    // the ABI classifier's __fern_task_ prefix cannot prove a body exists.
    if (!ircore.is_fern_helper(names[i]) && !util.has_str(task_names, names[i])) {
      bad = bad.append(names[i]);
    }
    i = i + 1;
  }
  if (bad.len() == 0) {
    write("provided-audit: all " + util.i32_to_string(names.len())
      + " inventory entries are emitted by the backend\n");
    return 0;
  }
  let out: string = "provided-audit: " + util.i32_to_string(bad.len())
    + " inventory entrie(s) no backend emits:";
  let j: i32 = 0;
  while (j < bad.len()) {
    out = out + "\n    " + bad[j];
    j = j + 1;
  }
  write(out + "\n");
  return 1;
}

// View is what a per-module build emits from: one module per unit and each
// unit's lowering, cut from the typed lowering of the whole program, which has
// already been gated, the whole-program function and struct view every unit
// emits against, and the borrowability rows the unit keys fold.
struct View {
  u: ircore.Units,
  all_funcs: parser.FuncDecl[],
  stab: irtables.StructTab,
  sigs: fnsigs.FnSigs,
  rt: (string) => irtables.LowerResult[],
}

// per_module_view builds the units of `parts`: the typed lowering lowers the
// program the merged emit reads, whole, and cuts it into units. A unit is
// its whole module, so a caller's reach never re-emits a library; the one
// thing a unit leaves out is what has no body on this native target, the
// callers of an `@import` extern (treeshake.without_extern_callers).
function per_module_view(entry: parser.Module, loaded: flatten.LoadedModule[], parts: flatten.PerModule[], target: string): View {
  let d: semlower.Driven = semlower.driven(treeshake.without_extern_callers(merged_program(entry, loaded, target)), target);
  let g: ircore.Gated = semlower.program(d);
  let raw: parser.Module[] = [];
  let entry_at: i32 = 0;
  let k: i32 = 0;
  while (k < parts.len()) {
    raw = raw.append(parts[k].mod);
    if (parts[k].is_entry) {
      entry_at = k;
    }
    k = k + 1;
  }
  return View { u: ircore.split_units(g, raw, entry_at), all_funcs: g.im.funcs, stab: g.stab, sigs: d.sub.sigs, rt: d.sub.rt_lower };
}

// merged_program is the whole program the merged emit reads.
function merged_program(entry: parser.Module, loaded: flatten.LoadedModule[], target: string): parser.Module {
  let merged: parser.Module = flatten.bundle(entry, loaded, target);
  // target_os() / target_arch() are the -target's environment and ISA as
  // string literals, not calls: the compile driver folds them here
  // (fern.fern) and no backend emits a body for either, so a pipeline that
  // skips the fold hands every later pass a call to a symbol nothing
  // defines. The branch the target never takes goes with the fold, so the
  // gates and the merged emit see the program as built for this target; the
  // functions nothing reaches after it are pruned at the merged emit
  // (merged_emitted), not here, since the per-module routing below gates on
  // the raw function count.
  let md: platforms.Descriptor = platforms.for_target(target);
  merged = constfold.fold_target_name(merged, md.environment, md.isa);
  return constfold.prune_literal_branches(merged);
}

// merged_emitted is the merged program as the merged emit reads it: the
// functions nothing reaches pruned, as fern.fern prunes them. A module
// declaring `@import` externs for another target (std/wasi_http) is reached
// only through the branch the fold dropped, and an emitted caller of an
// extern is an undefined symbol at link. The undefined-call gate (E001)
// judges the program whole first, as the CLI's checker does: the emit
// entry's own run of it sees only what the shake keeps.
function merged_emitted(merged: parser.Module): parser.Module {
  let errs: util.Diag[] = asmcore.check_undefined_calls(merged);
  if (errs.len() > 0) {
    eprint(util.format_diags(errs));
    exit(1);
  }
  return treeshake.treeshake(merged);
}

// emit_per_module_concat compiles a program's modules as separate units and
// concatenates them into one linkable asm stream. The units share a
// whole-program function and struct view, so cross-module calls and imported
// struct layouts resolve, and only the entry unit emits `_start` and the shared
// runtime.
function emit_per_module_concat(dir: string, entry_path: string, entry_mod: parser.Module, loaded: flatten.LoadedModule[], target: string, cache_dir: string): string {
  let parts: flatten.PerModule[] = flatten.bundle_per_module(entry_mod, loaded, target);
  let v: View = per_module_view(entry_mod, loaded, parts, target);
  // The entry unit emits the ONE shared runtime; seed it with every root so a
  // library unit's `call __fern_*` resolves (ircore.all_runtime_need_roots —
  // the same superset the batched per-module build feeds it).
  let needs: string[] = ircore.all_runtime_need_roots();
  // Signatures are hashed over the PRUNED modules, so a dependency whose
  // reach changed moves every dependent's key.
  let keys: ircore.UnitKeys = view_keys(v, cache_dir);
  let out: string = "";
  let idx: i32 = 0;
  while (idx < parts.len()) {
    let extra: string[] = [];
    if (parts[idx].is_entry) {
      extra = needs;
    }
    let cachefile: string = "";
    if (cache_dir.len() > 0) {
      let src_hash: string = modloader.module_src_hash(modloader.no_overlay(), dir, entry_path, parts, idx);
      let key: string = ircore.unit_cache_key(parts, v.u, keys, idx, src_hash, extra, 0, 0 - 1);
      if (key.len() > 0) {
        cachefile = cache_dir + "/" + parts[idx].ns + "_c__" + util.hash_key(key + "|kept" + kept_names(v.u.mods[idx])) + ".s";
      }
    }
    let served: boolean = false;
    if (cachefile.len() > 0) {
      match (read_file(cachefile)) {
        Ok(cached) => {
          eprint("cache-hit " + parts[idx].ns);
          out = out + cached;
          served = true;
        },
        Err(e_ch) => {}
      }
    }
    if (!served) {
      let unit: string = emit_unit(v, idx, parts[idx].is_entry, parts[idx].ns, extra, 0, 0 - 1, target);
      if (cachefile.len() > 0) {
        eprint("cache-miss " + parts[idx].ns);
        match (write_file(cachefile, unit)) {
          Err(cerr) => {
            eprint("per-module concat: cache write failed for " + parts[idx].ns);
          },
          Ok(_) => {}
        }
      }
      out = out + unit;
    }
    idx = idx + 1;
  }
  return asmcore.dedupe_weak_defs(out);
}

// kept_names spells the functions a concat unit kept. Its units are pruned to
// the whole program's reach, so an edit anywhere can change what a module
// keeps without touching its source.
function kept_names(m: parser.Module): string {
  let kept: string[] = [];
  for f in m.funcs {
    kept = kept.append(f.receiver_type + "." + f.name + ",");
  }
  return util.hash_key(util.str_join_chunks(kept));
}

// view_keys keys every unit of `v`, or none when the cache is off.
function view_keys(v: View, cache_dir: string): ircore.UnitKeys {
  if (cache_dir.len() == 0) {
    return ircore.no_unit_keys();
  }
  return ircore.unit_keys(v.u, v.stab, v.sigs, true);
}

// emit_unit emits unit `idx`'s [lo, hi) function window for `target`.
function emit_unit(v: View, idx: i32, is_entry: boolean, ns: string, extra: string[], lo: i32, hi: i32, target: string): string {
  if (target == "arm64-linux") {
    return asm_arm64_ir.emit_module_ir_unit_arm64_flat(v.u.mods[idx], is_entry, true, ns, extra, v.all_funcs, v.stab, lo, hi, v.u.caches[idx], v.rt, asmcore.env_switches());
  }
  return asm_ir.emit_module_ir_unit_flat(v.u.mods[idx], is_entry, true, ns, extra, v.all_funcs, v.stab, lo, hi, v.u.caches[idx], v.rt, 0 as usize, asmcore.env_switches());
}

// unit_cache_file returns the object path for ONE emitted unit, or "" when the
// cache is off or the module has no stable key (src_hash "?" — always rebuild).
// The single source of the path both the read and the write use.
function unit_cache_file(cache_dir: string, parts: flatten.PerModule[], v: View, keys: ircore.UnitKeys, src_hash: string, midx: i32, extra: string[], wlo: i32, whi: i32): string {
  if (cache_dir.len() == 0 || src_hash.len() == 0) {
    return "";
  }
  let key: string = ircore.unit_cache_key(parts, v.u, keys, midx, src_hash, extra, wlo, whi);
  if (key.len() == 0) {
    return "";
  }
  let shard_tag: string = "";
  if (wlo > 0) {
    shard_tag = "_s" + util.i32_to_string(wlo);
  }
  return cache_dir + "/" + parts[midx].ns + shard_tag + "__" + util.hash_key(key) + ".s";
}

// emit_unit_to_file emits ONE flat unit and writes it to <out_dir>/unit_*.s.
// Containers are passed with an index rather than as indexed element VALUES so
// the callee reads them in place.
//
// With `cachefile` set the unit is served from disk when it is there — skipping
// codegen, the expensive part — and the cache is populated on a miss. hit/miss
// goes to stderr (one shard-ns per line) so an orchestrator can see the reuse
// set; the unit FILE is written either way, since that is what the caller reads
// back.
function emit_unit_to_file(out_dir: string, unit_spec: string, v: View, parts: flatten.PerModule[], midx: i32, needs: string[], target: string, cachefile: string): boolean {
  let wlo: i32 = nth_field_i32(unit_spec, 1);
  let whi: i32 = nth_field_i32(unit_spec, 2);
  let is_entry: boolean = parts[midx].is_entry;
  let extra: string[] = [];
  if (is_entry) {
    extra = needs;
  }
  let shard_ns: string = parts[midx].ns;
  if (wlo > 0) {
    shard_ns = shard_ns + "_s" + util.i32_to_string(wlo);
  }
  let outpath: string = out_dir + "/" + unit_file_name(unit_spec);
  if (cachefile.len() > 0) {
    match (read_file(cachefile)) {
      Ok(cached) => {
        eprint("cache-hit " + shard_ns);
        match (write_file(outpath, cached)) {
          Err(cwerr) => {
            eprint("per-module: unit write failed: " + outpath);
            return false;
          },
          Ok(_) => {}
        }
        return true;
      },
      Err(e_ch) => {}
    }
  }
  let unit: string = emit_unit(v, midx, is_entry, shard_ns, extra, wlo, whi, target);
  match (write_file(outpath, unit)) {
    Err(werr) => {
      eprint("per-module: unit write failed: " + outpath);
      return false;
    },
    Ok(_) => {}
  }
  if (cachefile.len() > 0) {
    eprint("cache-miss " + shard_ns);
    match (write_file(cachefile, unit)) {
      Err(cerr) => {
        eprint("per-module: cache write failed for " + shard_ns);
      },
      Ok(_) => {}
    }
  }
  return true;
}

// spawn_batch runs ONE batch of units in a child process and returns its exit
// code (or -1 if the fork itself failed).
//
// fork + proc_exec + waitpid rather than a `subprocess` builtin: no compiled
// target lowers subprocess (it is interp-only, and the platform gate pins that
// shut), whereas the crash-only process trio is granted by every native target.
// It also needs no pipes, because the child communicates through the unit FILES
// it writes rather than through stdout.
function spawn_batch(self_exe: string, entry_path: string, tmp: string, lo: i32, hi: i32, target: string, cache_dir: string): i32 {
  let pid: i32 = proc_fork();
  if (pid < 0) {
    return 0 - 1;
  }
  if (pid == 0) {
    // proc_exec supplies argv[0] from self_exe, so only real arguments here.
    let argv: string[] = [
      entry_path, "-per-module-emit-all", "-out-dir", tmp,
      "-unit-range", util.i32_to_string(lo) + ":" + util.i32_to_string(hi),
      "-target", target,
    ];
    if (cache_dir.len() > 0) {
      argv = argv.append("-cache-dir");
      argv = argv.append(cache_dir);
    }
    let rc: i32 = proc_exec(self_exe, argv);
    // Only reached if exec failed; 127 is the shell's convention for it and
    // is distinguishable from any emit failure the child would report.
    exit(127);
  }
  return proc_waitpid(pid);
}

// emit_per_module_spawned is the over-ceiling sibling of emit_per_module_concat:
// it emits the per-module IR units in BATCHES of child processes and streams the
// results to stdout, so a program too big for a single-process concat still takes
// the IR path. This is what removed the whole-compiler self-compile's dependence
// on the legacy AST emitter (#3457 slice 3).
//
// WHY PROCESSES. The per-window emit's net working set (~0.4 GB) is not
// reclaimed within a process, so emitting all ~35 whole-compiler units in one
// accumulates past the 16 GiB bump arena and trips __fern_alloc's bounds check
// (exit 137, which reads like an OOM-kill without being one). A child per batch
// releases the accumulation at exit while still amortising the whole-program
// view (per_module_view) across its batch.
//
// A process boundary is also the only release mechanism that TOLERATES the emit
// path's pre-existing over-releases: __rc_underflow_count() reports ~2443 of
// them on the entry unit's emit alone, identically in the un-spawned
// -per-module-emit-all path, so they predate this code and are latent today.
// Exiting reclaims without reusing anything, so they stay latent; an in-process
// arena rewind (__heap_mark / __heap_release_to) instead hands an over-released
// block out again while a live pointer still refers to it, which is why the
// checkpointed variant of this function crashed and this one does not.
//
// WHY STREAMING, not concatenation. The caller's contract is one asm stream on
// stdout, but `out = out + unit` over the whole compiler's ~500 MB of asm is
// quadratic in a bump arena — it would trade the emit-stage arena exhaustion for
// a reassembly-stage one. Reading one unit at a time and writing it straight out
// holds ~one unit; dedupe_weak_into carries the `.weak` symbol set across those
// chunks so the stream is deduped exactly as a whole-buffer pass would leave it.
//
// `-cache-dir` is forwarded to each batch child, which is what makes the DEFAULT
// build flow incremental (#5330): every child consults and populates the same
// object cache, so a rebuild after a one-module edit re-emits that module and its
// signature-dependents and serves the rest from disk. The cache is keyed on
// program sources and signatures only — not on the compiler that emitted the
// bytes — so the directory belongs to whoever drives the build and must not
// outlive a compiler rebuild.
//
// Return codes, so the caller never has to guess whether stdout was touched:
// 0 = the stream was written; 1 = nothing was written, fall back to the AST
// emitter; 2 = failed mid-stream, so stdout holds a partial unit and a hard
// error is the only sound outcome. Every ordinary failure is detected before the
// first write — hence the presence pre-pass — so 2 needs an I/O race inside our
// own private temp directory.
function emit_per_module_spawned(dir: string, entry_path: string, entry: parser.Module, loaded: flatten.LoadedModule[], target: string, func_budget: i32, batch: i32, self_exe: string, cache_dir: string): i32 {
  if (self_exe.len() == 0) {
    return 1;
  }
  // Only the flat unit LIST is needed here (no codegen); each child derives
  // the same units and emits its slice of them. Over the typed lowering the
  // list still costs a whole-program lowering (about 52 s and 4.4 GB for the
  // compiler), paid here and again in every batch child.
  let parts: flatten.PerModule[] = flatten.bundle_per_module(entry, loaded, target);
  let units: string[] = flat_unit_list(dir, parts, per_module_view(entry, loaded, parts, target).u.mods, func_budget);
  if (units.len() == 0) {
    return 1;
  }
  let tmp: string = "";
  match (temp_dir("fern-pm")) {
    Ok(td) => {
      tmp = td;
    },
    Err(e_td) => {
      eprint("per-module spawned: could not create a unit directory");
      return 1;
    }
  }
  let lo: i32 = 0;
  while (lo < units.len()) {
    let hi: i32 = lo + batch;
    if (hi > units.len()) {
      hi = units.len();
    }
    let rc: i32 = spawn_batch(self_exe, entry_path, tmp, lo, hi, target, cache_dir);
    if (rc != 0) {
      eprint("per-module spawned: unit batch " + util.i32_to_string(lo) + ":" + util.i32_to_string(hi) + " failed (exit " + util.i32_to_string(rc) + "), falling back to the merged IR emit");
      let ce1: i32 = 0;
      match (remove_dir_all(tmp)) {
        Err(rr1) => {
          ce1 = 1;
        },
        Ok(_) => {}
      }
      return 1;
    }
    lo = hi;
  }
  // A missing unit means the batch loop and the unit list disagreed, which
  // would silently drop code from the program. Check the whole set BEFORE
  // writing anything so that stays a clean fallback, not a truncated stream.
  let vi: i32 = 0;
  while (vi < units.len()) {
    let vpath: string = tmp + "/" + unit_file_name(units[vi]);
    let present: boolean = false;
    match (stat(vpath)) {
      Ok(st) => {
        present = true;
      },
      Err(e_st) => {}
    }
    if (!present) {
      eprint("per-module spawned: missing emitted unit " + vpath);
      let ce2: i32 = 0;
      match (remove_dir_all(tmp)) {
        Err(rr2) => {
          ce2 = 1;
        },
        Ok(_) => {}
      }
      return 1;
    }
    vi = vi + 1;
  }
  let seen: string[] = [];
  let ri: i32 = 0;
  while (ri < units.len()) {
    let rpath: string = tmp + "/" + unit_file_name(units[ri]);
    let read_ok: boolean = false;
    match (read_file(rpath)) {
      Ok(text) => {
        strbuf_reset();
        seen = asmcore.dedupe_weak_into(text, seen);
        write(strbuf_take());
        read_ok = true;
      },
      Err(e_ru) => {}
    }
    if (!read_ok) {
      eprint("per-module spawned: unit vanished mid-stream: " + rpath);
      let ce3: i32 = 0;
      match (remove_dir_all(tmp)) {
        Err(rr3) => {
          ce3 = 1;
        },
        Ok(_) => {}
      }
      return 2;
    }
    ri = ri + 1;
  }
  let ce4: i32 = 0;
  match (remove_dir_all(tmp)) {
    Err(rr4) => {
      ce4 = 1;
    },
    Ok(_) => {}
  }
  return 0;
}

// run_per_module drives the per-module build of the loaded program (#3451 step 4
// / #3456), the twin of asm_load_run's per-module driver. One emit per process
// (the native strbuf holds one emit), so the build is driven across invocations:
//   -per-module-count   → print the module count N
//   -per-module-needs   → print the whole-program runtime-need union (one/line)
//   -per-module-emit N [-extra-need X...]
//                       → emit module N's translation unit (the entry folds the
//                         supplied need union into its single shared runtime)
// module_sig_string renders a module's PUBLIC signature surface — the only part
// of a callee an importer's codegen depends on: each function's mangled name,
// parameter types, return type and receiver, plus each struct's field layout
// (name + ordered field types). Bodies are deliberately excluded, so a body-only
// edit to a module does NOT change its signature hash and therefore does NOT
// invalidate the modules that merely call into it. Return types are read off the
// INFERRED module (infer_ret_types_module has already run), so an inferred
// return-type change is caught even when the source left the type implicit.
// emit_window_size returns the [lo,hi) function-window size for a module of
// `funcs` functions and `bytes` source bytes — the in-driver twin of the harness
// emitWindowSize (internal/e2eselfhost/self_host_modload_permodule_test.go), kept
// byte-identical so `-per-module-emit-all` shards each module into the SAME
// windows the per-process fixpoint does. A 100-func budget and a 300 KB
// source-byte budget each set a minimum window count (the byte budget shards
// modules of FEW but GIANT functions, e.g. asm_arm64, that the count alone emits
// whole and inflates the emit's peak); the window is funcs / ceil(max of the two).
// nth_field_i32 reads the n-th ':'-separated field of `s` as an i32 (0-based).
// The flat-unit list encodes each unit as "modIdx:wlo:whi"; digits_to_i32 stops
// at the ':' on its own, so only the field offset has to be found.
function nth_field_i32(s: string, n: i32): i32 {
  let i: i32 = 0;
  let f: i32 = 0;
  while (f < n && i < s.len()) {
    if (s[i] == b':') {
      f = f + 1;
    }
    i = i + 1;
  }
  return util.digits_to_i32(slice_unchecked(s, i, s.len()) + "");
}

// flat_unit_list enumerates the (module × function-window) units a per-module
// emit produces, as "modIdx:wlo:whi" triples in flat-index order — the shared
// spine of `-per-module-emit-all`'s emit loop and the spawned whole-program
// path. One definition means a batch's `-unit-range LO:HI` indices, the flat
// indices an orchestrator batches over, and the `unit_<idx>[_sN].s` names it
// reads back can never disagree.
//
// Analysis only (function counts + source bytes, no codegen), so a caller can
// afford to call it before deciding anything.
function flat_unit_list(dir: string, parts: flatten.PerModule[], infmods: parser.Module[], func_budget: i32): string[] {
  let units: string[] = [];
  let idx: i32 = 0;
  while (idx < parts.len()) {
    let fcount: i32 = infmods[idx].funcs.len();
    let sbytes: i32 = 0;
    match (read_file(dir + parts[idx].ns + ".fern")) {
      Ok(fsrc) => {
        sbytes = fsrc.len();
      },
      Err(e_fu) => {}
    }
    let window: i32 = emit_window_size(fcount, sbytes, func_budget);
    // The entry emits `_start`, the runtime and the declaration-less bodies,
    // which only one unit may.
    if (parts[idx].is_entry && fcount > window) {
      window = fcount;
    }
    let wlo: i32 = 0;
    let more: boolean = true;
    while (more) {
      let whi: i32 = wlo + window;
      if (whi > fcount) {
        whi = fcount;
      }
      units = units.append(util.i32_to_string(idx) + ":" + util.i32_to_string(wlo) + ":" + util.i32_to_string(whi));
      wlo = wlo + window;
      if (wlo >= fcount) {
        more = false;
      }
    }
    idx = idx + 1;
  }
  return units;
}

// unit_file_name maps a flat unit's "modIdx:wlo:whi" triple to the file name
// the per-module emit writes it under: `unit_<modIdx>[_s<wlo>].s`.
function unit_file_name(unit: string): string {
  let idx: i32 = nth_field_i32(unit, 0);
  let wlo: i32 = nth_field_i32(unit, 1);
  let tag: string = "";
  if (wlo > 0) {
    tag = "_s" + util.i32_to_string(wlo);
  }
  return "unit_" + util.i32_to_string(idx) + tag + ".s";
}

function emit_window_size(funcs: i32, bytes: i32, func_budget: i32): i32 {
  let byte_budget: i32 = 300000;
  let nwin: i32 = (funcs + func_budget - 1) / func_budget;
  let bybytes: i32 = (bytes + byte_budget - 1) / byte_budget;
  if (bybytes > nwin) {
    nwin = bybytes;
  }
  if (nwin < 1) {
    nwin = 1;
  }
  let window: i32 = (funcs + nwin - 1) / nwin;
  if (window < 1) {
    window = 1;
  }
  return window;
}

function run_per_module(dir: string, entry_path: string, entry: parser.Module, loaded: flatten.LoadedModule[], pm_mode: string, pm_index: i32, pm_extra: string[], cache_dir: string, pm_lo: i32, pm_hi: i32, target: string, out_dir: string, func_budget: i32, unit_lo: i32, unit_hi: i32): i32 {
  let parts: flatten.PerModule[] = flatten.bundle_per_module(entry, loaded, target);
  if (pm_mode == "count") {
    print(util.i32_to_string(parts.len()) + "\n");
    return 0;
  }
  // The units and the whole-program view they lower against, derived each
  // invocation.
  let v: View = per_module_view(entry, loaded, parts, target);
  let infmods: parser.Module[] = v.u.mods;
  // Planning needs the post-lift counts and their module namespaces, not
  // emission side tables or incremental-cache signature hashes.
  if (pm_mode == "func-counts" || pm_mode == "shape") {
    let fci: i32 = 0;
    while (fci < infmods.len()) {
      let line: string = util.i32_to_string(infmods[fci].funcs.len());
      if (pm_mode == "shape") {
        line = parts[fci].ns + "|" + line;
      }
      print(line + "\n");
      fci = fci + 1;
    }
    return 0;
  }
  if (pm_mode == "emit-all") {
    // Multi-unit-per-process whole-compiler per-module emit (#3457 slice 2).
    // The whole-program view is built ONCE per process (per_module_view)
    // and shared across every unit it emits — collapsing the
    // O(units × all_funcs) re-derivation that dominated the per-process
    // serial emit (~20 s/unit even for a 3-function module). Units are the flat
    // (module × window) list, each module sharded into the SAME [lo,hi)
    // windows the per-process fixpoint uses (emit_window_size), and every unit
    // is written to <out_dir>/unit_<modIdx>[_s<lo>].s.
    //
    // `-unit-range LO:HI` restricts this process to flat unit indices [LO,HI).
    // The per-window emit's net working set (~0.4 GB) is NOT reclaimed within
    // one process, so emitting ALL 35 units in one process OOMs (~16 GB); an
    // orchestrator drives BATCHES of units, each a fresh process that releases
    // the accumulation on exit while still sharing the view across its batch.
    // The entry gets the full runtime-need roots as its extra_needs.
    // -target arm64-linux uses the arm64 emitter unchanged.
    let needs: string[] = ircore.all_runtime_need_roots();
    let units: string[] = flat_unit_list(dir, parts, infmods, func_budget);
    // Incremental object cache (#3451 step 6 / #3458). This is the mode the
    // DEFAULT build flow runs in — emit_per_module_spawned execs a child per
    // batch — so wiring the cache here is what makes an ordinary rebuild
    // incremental rather than just the explicit single-unit mode.
    //
    // Both fingerprint tables are derived once per process and indexed by
    // module, not recomputed per unit: a module sharded into several windows
    // would otherwise re-read and re-hash its source once per shard.
    let srchashes: string[] = [];
    let keys_ea: ircore.UnitKeys = view_keys(v, cache_dir);
    if (cache_dir.len() > 0) {
      let chi: i32 = 0;
      while (chi < parts.len()) {
        srchashes = srchashes.append(modloader.module_src_hash(modloader.no_overlay(), dir, entry_path, parts, chi));
        chi = chi + 1;
      }
    }
    let uidx: i32 = 0;
    while (uidx < units.len()) {
      if (uidx < unit_lo || uidx >= unit_hi) {
        uidx = uidx + 1;
        continue;
      }
      let idx: i32 = nth_field_i32(units[uidx], 0);
      let uextra: string[] = [];
      if (parts[idx].is_entry) {
        uextra = needs;
      }
      let usrc: string = "";
      if (srchashes.len() > 0) {
        usrc = srchashes[idx];
      }
      let ucache: string = unit_cache_file(cache_dir, parts, v, keys_ea, usrc, idx, uextra, nth_field_i32(units[uidx], 1), nth_field_i32(units[uidx], 2));
      if (!emit_unit_to_file(out_dir, units[uidx], v, parts, idx, needs, target, ucache)) {
        return 1;
      }
      uidx = uidx + 1;
    }
    return 0;
  }
  // Per-module signature hashes (aligned with parts) — the cross-module
  // dependency fingerprints the manifest reports and the cache key folds in.
  // Computed ONLY when a caller needs them (the manifest, or a cached emit):
  // a plain `-per-module-emit N` must not pay this extra whole-program string
  // allocation, since the self-host runtime does not yet reclaim it (#3425) and
  // the whole-compiler emit is already at the memory ceiling.
  let sighashes: string[] = [];
  if (pm_mode == "manifest" || pm_mode == "emit" && cache_dir.len() > 0) {
    let shi: i32 = 0;
    while (shi < parts.len()) {
      sighashes = sighashes.append(util.hash_key(modloader.module_sig_string(infmods[shi])));
      shi = shi + 1;
    }
  }
  if (pm_mode == "manifest") {
    // Per-module incremental-codegen manifest (#3451 step 6 / #3458). One line
    // per module — everything an out-of-process build orchestrator needs to
    // decide, correctly, which modules to re-emit and which to reuse:
    //
    //   <ns>|<src_hash>|<sig_hash>|<dep1,dep2,...>
    //
    // A module's cache key is  src_hash(self) folded with sig_hash(m) for every
    // m in the dependency column.  src_hash makes a body-only edit re-emit that
    // module (its own codegen changed); sig_hash makes a signature edit re-emit
    // that module AND everything depending on it (their call-site tagging
    // changed) — while a body-only edit to a dependency leaves dependents
    // untouched (their sig_hash input is unchanged).  This is the
    // correct-invalidation core: keying on source alone would ship stale codegen
    // when a depended-on return type changes.
    //
    // The dependency column is the TRANSITIVE closure rather than the direct
    // import edges, so an orchestrator folding it verbatim computes the same key
    // the driver does; modloader's section header has the shape that makes
    // direct edges unsound.
    //
    // src_hash resolves the module's source through the loader, so a module in a
    // sub-directory is hashed at its real path.  If it cannot be resolved at all,
    // src_hash is "?", which the orchestrator MUST treat as always-rebuild —
    // sound (never reuses stale), just not incremental for that module.
    let mi: i32 = 0;
    while (mi < parts.len()) {
      let src_hash: string = modloader.module_src_hash(modloader.no_overlay(), dir, entry_path, parts, mi);
      print(parts[mi].ns + "|" + src_hash + "|" + sighashes[mi] + "|" + modloader.module_dep_ns(parts, infmods, mi) + "\n");
      mi = mi + 1;
    }
    return 0;
  }
  if (pm_mode == "needs") {
    // Seed the entry's shared runtime with the full root set instead of an
    // exact per-module union (ircore.all_runtime_need_roots): a sound,
    // deterministic over-approximation that avoids re-emitting every module
    // here via module_runtime_needs — that aggregation OOMs a self-host-built
    // driver (#3425), the one thing blocking a self-host per-module self-compile.
    let needs: string[] = ircore.all_runtime_need_roots();
    let no: i32 = 0;
    while (no < needs.len()) {
      print(needs[no] + "\n");
      no = no + 1;
    }
    return 0;
  }
  if (pm_index < 0 || pm_index >= parts.len()) {
    eprint("per-module: emit index out of range");
    return 1;
  }
  let extra: string[] = [];
  if (parts[pm_index].is_entry) {
    extra = pm_extra;
    if (pm_lo > 0 || pm_hi >= 0 && pm_hi < infmods[pm_index].funcs.len()) {
      eprint("per-module: the entry is emitted whole, not in a -func-range window");
      return 1;
    }
  }
  // Incremental object cache (#3451 step 6 / #3458). With -cache-dir set, the
  // driver computes this unit's content-addressed key (its module's source
  // folded with the signatures of everything it depends on, plus the emitted
  // function window — unit_cache_file) and serves the unit from disk when it is
  // there. A hit skips codegen entirely (the expensive part); a miss emits,
  // populates the cache, then writes. This is what makes a rebuild after a
  // one-module edit re-emit only that module and its signature-dependents —
  // every other module's key is unchanged, so its unit is reused byte-for-byte.
  // hit/miss is reported on stderr (ns per line) so an orchestrator can see the
  // reuse set; stdout stays exactly the unit asm. A "?" src_hash yields an empty
  // key, which disables the cache for that module (always emit — sound, see
  // module_src_hash).
  let cachefile: string = "";
  if (cache_dir.len() > 0) {
    let src_hash: string = modloader.module_src_hash(modloader.no_overlay(), dir, entry_path, parts, pm_index);
    cachefile = unit_cache_file(cache_dir, parts, v, view_keys(v, cache_dir), src_hash, pm_index, extra, pm_lo, pm_hi);
    if (cachefile.len() > 0) {
      match (read_file(cachefile)) {
        Ok(cached) => {
          eprint("cache-hit " + parts[pm_index].ns);
          write(cached);
          return 0;
        },
        Err(e) => {}
      }
    }
  }
  // Function-sharding (#3425): emit only the [pm_lo, pm_hi) window of this
  // module's functions. A full window (pm_lo=0, pm_hi<0) is byte-identical to
  // the unsharded emit and keeps the base ns; a partial shard (pm_lo>0) gets a
  // shard-distinct string namespace (base ns + "_s<pm_lo>") so each shard's
  // `.rodata` string labels don't collide at link. The lo=0 shard keeps the
  // base ns, so a full-range emit stays byte-identical (the byte-identity
  // invariant), and disjoint windows have disjoint lo values → distinct ns.
  // -func-range composes with -cache-dir: the window is part of the cache key
  // and of the entry's file name, so two shards of one module never share one.
  let shard_ns: string = parts[pm_index].ns;
  if (pm_lo > 0) {
    shard_ns = shard_ns + "_s" + util.i32_to_string(pm_lo);
  }
  let unit: string = emit_unit(v, pm_index, parts[pm_index].is_entry, shard_ns, extra, pm_lo, pm_hi, target);
  // Emit to stdout first, then populate the cache. Both consume `unit`; doing
  // the file write last keeps the ordering unambiguous and avoids relying on
  // write_file's borrow/consume semantics for the unit box.
  write(unit);
  if (cachefile.len() > 0) {
    eprint("cache-miss " + parts[pm_index].ns);
    match (write_file(cachefile, unit)) {
      Err(werr) => {
        eprint("per-module: cache write failed for " + parts[pm_index].ns);
      },
      Ok(_) => {}
    }
  }
  return 0;
}

// fold_target_calls resolves `target_os()` / `target_arch()` in the entry and
// every loaded module, as fern.fern does before its own check. The lowering answers
// an unfolded call from the pointer width's default target, which names the
// environment correctly on every native target and the ISA only on arm64 — so
// a driver that knows its -target folds rather than taking that default.
function fold_target_calls(entry: parser.Module, loaded: flatten.LoadedModule[], target: string): (parser.Module, flatten.LoadedModule[]) {
  let d: platforms.Descriptor = platforms.for_target(target);
  let e2: parser.Module = constfold.fold_target_name(entry, d.environment, d.isa);
  let out: flatten.LoadedModule[] = [];
  for lm in loaded {
    out = out.append(flatten.LoadedModule { name: lm.name, ident: lm.ident, mod: constfold.fold_target_name(lm.mod, d.environment, d.isa) });
  }
  return (e2, out);
}

function main(): i32 {
  let a: string[] = args();
  // `-ir-probe`: after real import resolution + bundling, report the typed
  // lowering's verdict (semlower.verdict_text) instead of emitting asm.
  // Unlike asm_ir_run's stdin probe, this loads imports off disk, so a
  // function that calls an IMPORTED helper (`s.split_once()`) is checked with
  // its callee present. Point it at an entry sitting at the stdlib root so
  // `import "std/u64"` and its transitive `import "core/int"` both resolve:
  // `asm_modload_run internal/stdlib/_probe.fern -ir-probe`.
  //
  // The per-module flags (-per-module-count / -per-module-needs /
  // -per-module-emit N [-extra-need X...]) drive the builtins-aware per-module
  // build (run_per_module) — routing every module through the IR path instead
  // of the merged AST emit below.
  let probe: boolean = false;
  let vprovided: boolean = false;
  let paudit: boolean = false;
  let entry_path: string = "";
  let pm_mode: string = "";
  let pm_index: i32 = 0 - 1;
  let pm_extra: string[] = [];
  let cache_dir: string = "";
  // Function-index window [pm_lo, pm_hi) for the emitted module (#3425). The
  // default (pm_lo=0, pm_hi=-1) is the full range — inert / byte-identical.
  // `-func-range LO:HI` shards one oversized module's emit across processes.
  let pm_lo: i32 = 0;
  let pm_hi: i32 = 0 - 1;
  // `-target x86_64|arm64` selects the emit backend (#4398 part 1: the fold
  // that retired the asm_arm64_modload_run mirror). Default x86_64 keeps
  // every pre-fold caller byte-identical; module loading, the probe, and the
  // per-module analyses are target-agnostic.
  let target: string = "x86-64-linux";
  // `-per-module-emit-all -out-dir DIR` emits every unit in ONE process (#3457
  // slice 2), sharing the whole-program side-table bases. `-func-budget N` sets
  // the per-window function budget (default 100, matching the harness
  // shardThreshold); `-unit-range LO:HI` restricts a batch process to flat unit
  // indices [LO,HI) (default = every unit) so an orchestrator can batch the emit
  // across processes to bound the per-window accumulation.
  let out_dir: string = "";
  let func_budget: i32 = 100;
  let unit_lo: i32 = 0;
  let unit_hi: i32 = 2000000000;
  // Units per orchestrated batch process (see emit_per_module_spawned). Each
  // process lowers the whole program through the typed lowering before it
  // emits (52 s and 4.4 GB for the compiler), and its units add ~0.2 GB over
  // that, so a batch is large. `-unit-batch N` tunes it.
  let unit_batch: i32 = 64;
  let force_spawned: boolean = false;
  let ai: i32 = 1;
  while (ai < a.len()) {
    if (a[ai] == "-ir-probe") {
      probe = true;
    } else if (a[ai] == "-verifyprovided") {
      vprovided = true;
    } else if (a[ai] == "-provided-audit") {
      paudit = true;
    } else if (a[ai] == "-per-module-count") {
      pm_mode = "count";
    } else if (a[ai] == "-per-module-needs") {
      pm_mode = "needs";
    } else if (a[ai] == "-per-module-func-counts") {
      pm_mode = "func-counts";
    } else if (a[ai] == "-per-module-shape") {
      pm_mode = "shape";
    } else if (a[ai] == "-per-module-manifest") {
      pm_mode = "manifest";
    } else if (a[ai] == "-per-module-emit" && ai + 1 < a.len()) {
      pm_mode = "emit";
      pm_index = util.digits_to_i32(a[ai + 1]);
      ai = ai + 1;
    } else if (a[ai] == "-per-module-emit-all") {
      pm_mode = "emit-all";
    } else if (a[ai] == "-unit-batch" && ai + 1 < a.len()) {
      unit_batch = util.digits_to_i32(a[ai + 1]);
      ai = ai + 1;
    } else if (a[ai] == "-spawned") {
      // Force the spawned whole-program path regardless of function count, so
      // it can be exercised on a small program instead of only on the
      // whole-compiler self-compile.
      force_spawned = true;
    } else if (a[ai] == "-out-dir" && ai + 1 < a.len()) {
      out_dir = a[ai + 1];
      ai = ai + 1;
    } else if (a[ai] == "-func-budget" && ai + 1 < a.len()) {
      func_budget = util.digits_to_i32(a[ai + 1]);
      ai = ai + 1;
    } else if (a[ai] == "-unit-range" && ai + 1 < a.len()) {
      let urng: string = a[ai + 1];
      let uci: i32 = 0;
      while (uci < urng.len() && urng[uci] != b':') {
        uci = uci + 1;
      }
      unit_lo = util.digits_to_i32(urng);
      if (uci + 1 <= urng.len()) {
        unit_hi = util.digits_to_i32(slice_unchecked(urng, uci + 1, urng.len()));
      }
      ai = ai + 1;
    } else if (a[ai] == "-extra-need" && ai + 1 < a.len()) {
      pm_extra = pm_extra.append(a[ai + 1]);
      ai = ai + 1;
    } else if (a[ai] == "-cache-dir" && ai + 1 < a.len()) {
      cache_dir = a[ai + 1];
      ai = ai + 1;
    } else if (a[ai] == "-target" && ai + 1 < a.len()) {
      target = a[ai + 1];
      ai = ai + 1;
    } else if (a[ai] == "-func-range" && ai + 1 < a.len()) {
      // Parse "LO:HI" — digits_to_i32 stops at the ':' for LO; slice past
      // the colon for HI.
      let rng: string = a[ai + 1];
      let ci: i32 = 0;
      while (ci < rng.len() && rng[ci] != b':') {
        ci = ci + 1;
      }
      pm_lo = util.digits_to_i32(rng);
      if (ci + 1 <= rng.len()) {
        pm_hi = util.digits_to_i32(slice_unchecked(rng, ci + 1, rng.len()));
      }
      ai = ai + 1;
    }

    // An unrecognised -target is refused rather than emitted for. This driver
    // dispatches by naming the targets it knows and letting everything else
    // reach the x86-64 branch, so a stale or misspelled name used to come back
    // as a successful emit for the WRONG machine — the arm64 leg of #6710 was
    // handed x86-64 text and surfaced as "unknown mnemonic `movq'" from the
    // aarch64 assembler, which reads as a codegen bug rather than a typo.
    if (target != "x86-64-linux" && target != "arm64-linux") {
      eprint("asm_modload_run: unknown -target: " + target + " (want x86-64-linux, arm64-linux)");
      return 2;
    } else if (entry_path == "") {
      entry_path = a[ai];
    }
    ai = ai + 1;
  }
  // The audit reads only the two records, so it takes no entry file.
  if (paudit) {
    return provided_audit();
  }
  if (entry_path == "") {
    eprint("usage: asm_modload_run <entry.fern> [-verifyprovided | -provided-audit | -ir-probe | -per-module-count | -per-module-needs | -per-module-func-counts | -per-module-shape | -per-module-manifest | -per-module-emit N [-func-range LO:HI] | -per-module-emit-all -out-dir DIR [-func-budget N] [-unit-range LO:HI]] [-cache-dir DIR]");
    return 2;
  }
  let dir: string = modloader.dirname(entry_path);
  match (read_file(entry_path)) {
    Ok(src) => {
      let entry: parser.Module = parser.parse_module(lexer.tokenize(src));
      let (imported, missing) = modloader.load_imports(modloader.no_overlay(), entry_path, entry);
      if (modloader.report_unresolved(missing, "asm_modload_run")) {
        return 1;
      }
      let loaded: flatten.LoadedModule[] = imported;
      let (fentry, floaded) = fold_target_calls(entry, loaded, target);
      entry = fentry;
      loaded = floaded;
      let parsed: parser.Module[] = [entry];
      for lm in loaded {
        parsed = parsed.append(lm.mod);
      }
      if (asmcore.refuse_decl_names(parsed)) {
        return 1;
      }
      if (asmcore.refuse_parse_unknowns(parsed)) {
        return 1;
      }
      if (pm_mode.len() > 0) {
        return run_per_module(dir, entry_path, entry, loaded, pm_mode, pm_index, pm_extra, cache_dir, pm_lo, pm_hi, target, out_dir, func_budget, unit_lo, unit_hi);
      }
      let merged: parser.Module = merged_program(entry, loaded, target);
      if (vprovided) {
        return verify_provided_module(merged, target);
      }
      if (probe) {
        write(semlower.verdict_text(semlower.verdict(merged, target)));
        return 0;
      }
      // Hoisted above the arm64 leg so both targets share ONE
      // single-process ceiling; see the measurement note on the x86
      // route below for why 1500 and why function count is only a
      // cheap pre-emit proxy for the real (arena) limit.
      let single_process_max: i32 = 1500;
      if (target == "arm64-linux") {
        // Same single-process over-budget rescue the x86 leg below has:
        // a merged bundle past the 512-function IR budget but small
        // enough for one process routes per-module (each module is under
        // budget -> IR) instead of failing the whole program. arm64
        // lacked this, so the whole band went AST here while x86 served
        // it via IR — the asymmetry that had to close before the arm64
        // AST emitter could be deleted (#3457 slice 5).
        // Link-verified end to end by TestSelfHostPerModuleConcatArm64;
        // the first attempt (#5937) emitted a dangling __fn_i32__gcd and
        // was reverted, which is why that test asserts through the LINK.
        let anfuncs: i32 = ircore.lift_lambdas(parser.module_with_builtins(merged)).funcs.len();
        if (anfuncs > 512 || force_spawned) {
          if (anfuncs < single_process_max && !force_spawned) {
            write(emit_per_module_concat(dir, entry_path, entry, loaded, "arm64-linux", cache_dir));
            return 0;
          } else {
            // ABOVE the single-process ceiling — the whole-compiler
            // self-compile itself. Was x86-only ("the batched spawned
            // path stays x86-only for now"), which only worked because
            // arm64 still had the AST emitter to drop to; removing that
            // fallback is what makes the batched path required here too.
            // spawn_batch already threads `-target`, and the arm64
            // `-per-module-emit` child is the exact path
            // TestSelfHostModloadPerModuleWholeCompilerArm64 drives, so
            // this reuses a proven leg rather than adding one.
            let asrc: i32 = emit_per_module_spawned(dir, entry_path, entry, loaded, target, func_budget, unit_batch, a[0], cache_dir);
            if (asrc == 0) {
              return 0;
            }
            if (asrc == 2) {
              eprint("asm_modload_run: spawned per-module emit failed after writing output");
              return 1;
            }
          }
        }
        // IR-or-error (#3457 slice 5) — see asm_load_run's arm64 leg.
        let d64: semlower.Driven = semlower.driven(merged_emitted(merged), target);
        write(asm_arm64_ir.emit_module_or_error_sub(d64.full, false, d64.sub, 0 as usize));
        return 0;
      }
      // OVER the merged 512-function IR budget: route per-module (each
      // module is under budget → IR) instead of failing the whole program
      // (#3457 / #5676's rescue, which asm_load_run had and this driver did
      // not). The lower bound is the budget the merged IR path bails at
      // (asm_ir.emit_module_ir_gated_sub: sm.funcs.len() > 512).
      //
      // Above `single_process_max` a single-process concat exhausts the
      // arena, so the emit is orchestrated across BATCHES of child
      // processes instead (emit_per_module_spawned), which falls back to
      // the merged IR-or-error emit below when it cannot start.
      // MEASURED single-process ceiling (2026-07-29). The 21
      // duplicate-symbol errors a >=1500-function concat used to hit are
      // FIXED (the `.weak`-dedup pair), and at 1958 merged funcs — the
      // stage-2 compiler — the concat assembles, links, and self-hosts a
      // `return 7` program with no memory failure at all. What one process
      // cannot do is the WHOLE-COMPILER self-compile: concatenating it
      // exits 137 on __fern_alloc's arena bounds check (not a host
      // OOM-kill). Function count is a poor proxy for that — 1958 fits,
      // ~2040 does not — because what exhausts the arena is the COMPILE
      // WORKLOAD, not the emitted function count; it stays the switch-over
      // point only because it is the one cheap signal available before any
      // emit happens.
      let nfuncs: i32 = ircore.lift_lambdas(parser.module_with_builtins(merged)).funcs.len();
      if (nfuncs > 512 || force_spawned) {
        if (nfuncs < single_process_max && !force_spawned) {
          write(emit_per_module_concat(dir, entry_path, entry, loaded, "x86-64-linux", cache_dir));
          return 0;
        } else {
          let src: i32 = emit_per_module_spawned(dir, entry_path, entry, loaded, target, func_budget, unit_batch, a[0], cache_dir);
          if (src == 0) {
            return 0;
          }
          if (src == 2) {
            eprint("asm_modload_run: spawned per-module emit failed after writing output");
            return 1;
          }
        }
      }
      // Last resort, and no longer a fallback (#3457 slice 5): a module the
      // batched per-module emit above could not take is an ERROR. The
      // whole-compiler merged bundle lands here, which is why the env-gated
      // merged fixpoints retire with this change — their own header says they
      // "go with" asm.fern.
      let d: semlower.Driven = semlower.driven(merged_emitted(merged), target);
      write(asm_ir.emit_module_or_error_sub(d.full, d.sub, 0 as usize));
      return 0;
    },
    Err(e) => {
      eprint("asm_modload_run: could not read entry file");
      return 1;
    }
  }
  return 3;
}
