// examples/self_host/asm_modload_run.fern — import-driven self-host
// compiler driver. The successor to two stopgaps:
//
//   * bundle_run.fern, which reads several modules off ONE stdin stream
//     glued together with `///MODULE <name>` marker lines — a hand-packed
//     bundle the Go test harness concatenates, not real module loading.
//   * the synthetic builtin table (parser.inject_builtin_enums), which
//     conjures the built-in TYPES (JsonValue / IoError / FileStat / …) in
//     code instead of reading them from source.
//
// This driver instead does what the native compiler's `modload` does:
// take an ENTRY file path on argv, read it, follow its `import "./x"`
// declarations to sibling `x.fern` files on disk (transitively), and load
// the built-in types from a real `builtins.fern` module. Everything is
// merged with flatten.bundle and emitted as x86-64 asm.
//
//     $ asm_modload_run path/to/main.fern > main.s
//
// Resolution rules (deliberately small — a foundation, not the whole of
// modload):
//   * the import path resolves relative to the entry's directory, keeping
//     its sub-path: `import "./lexer"` → `<dir>/lexer.fern`, `import
//     "std/io"` → `<dir>/std/io.fern`. If that misses, the flat basename
//     is tried as a fallback (`<dir>/io.fern`), so a tree can vendor its
//     stdlib either under `std/` or flattened next to the entry.
//   * the module's NAMESPACE is the basename (`std/io` → `io`), so an
//     `io.read_all_stdin(...)` call resolves the same way it does natively.
//   * a path that doesn't resolve to a readable file is skipped — it's a
//     compiler intrinsic / not-yet-vendored stdlib module, handled
//     elsewhere (the same way the legacy bundle path left them out).
//   * `<dir>/builtins.fern`, if present, supplies the built-in types;
//     when absent, parser.module_with_builtins' synthetic injection still
//     fills them in (the guards make it idempotent), so this driver also
//     works against a tree without a vendored builtins module.
//
// Uses only features the self-hosted emitter supports (args, read_file →
// Result, match), so it builds with either compiler.

import "./lexer";
import "./parser";
import "./flatten";
import "./asm";
import "./asm_ir";

// dirname returns everything up to and including the last '/', or "" when
// the path has no directory part ("a/b/c.fern" → "a/b/", "main.fern" → "").
function dirname(path: string): string {
    var cut: i32 = 0;
    var i: i32 = 0;
    while (i < path.len()) {
        if (path[i] == 47) { cut = i + 1; }   // '/'
        i = i + 1;
    }
    return path[0:cut];
}

// base_name strips the directory and the import-relative `./` prefix from
// an import path: "./lexer" → "lexer", "std/io" → "io".
function base_name(path: string): string {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i < path.len()) {
        if (path[i] == 47) { start = i + 1; }   // '/'
        i = i + 1;
    }
    return path[start:path.len()];
}

// contains reports membership of `name` in `xs`.
function contains(xs: string[], name: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// rel_path strips a leading import-relative `./` so the path joins cleanly
// onto the entry directory: "./lexer" → "lexer", "std/io" → "std/io".
function rel_path(path: string): string {
    if (path.len() >= 2 && path[0:2] == "./") { return path[2:path.len()]; }
    return path;
}

// enqueue_imports appends each not-yet-known import PATH of `mod` to
// `queue`. The full path is kept (so a `std/`-prefixed import resolves to
// its sub-directory file) and de-duplicated by basename — the namespace
// the bundler keys on — against names already queued/loaded (`seen`).
function enqueue_imports(queue: string[], seen: string[], mod: parser.Module): string[] {
    var out: string[] = queue;
    var i: i32 = 0;
    while (i < mod.imports.len()) {
        var path: string = mod.imports[i].path;
        var name: string = base_name(path);
        if (!contains(seen, name)) { out = out.append(path); }
        i = i + 1;
    }
    return out;
}

// try_read reads `<dir><rel>.fern`, returning Some(source) or None.
function try_read(dir: string, rel: string): Option[string] {
    match (read_file(dir + rel + ".fern")) {
        Ok(s) => { return Some(s); },
        Err(e) => { return None; },
    }
    return None;
}

// resolve_module_src finds the source for import `path`. It tries the full
// (possibly `std/`-prefixed) path first, then the flat basename in the
// entry directory — so `import "std/io"` resolves to `<dir>/std/io.fern`
// when vendored there, or `<dir>/io.fern` when laid out flat.
function resolve_module_src(dir: string, path: string, name: string): Option[string] {
    match (try_read(dir, rel_path(path))) {
        Some(s) => { return Some(s); },
        None => { return try_read(dir, name); },
    }
    return None;
}

// append_structs / append_enums concatenate two decl lists (builtin merge).
function append_structs(into: parser.StructDecl[], more: parser.StructDecl[]): parser.StructDecl[] {
    var out: parser.StructDecl[] = into;
    var i: i32 = 0;
    while (i < more.len()) { out = out.append(more[i]); i = i + 1; }
    return out;
}
function append_enums(into: parser.EnumDecl[], more: parser.EnumDecl[]): parser.EnumDecl[] {
    var out: parser.EnumDecl[] = into;
    var i: i32 = 0;
    while (i < more.len()) { out = out.append(more[i]); i = i + 1; }
    return out;
}

// load_imports walks the entry module's import graph breadth-first,
// reading each resolvable sibling `.fern` file and parsing it into a
// flatten.LoadedModule keyed by basename (what `mod.X` references resolve
// to). Unresolvable imports (intrinsics / not-vendored stdlib) are
// silently skipped.
function load_imports(dir: string, entry: parser.Module): flatten.LoadedModule[] {
    var loaded: flatten.LoadedModule[] = [];
    var seen: string[] = [];
    var queue: string[] = enqueue_imports([], seen, entry);
    var qi: i32 = 0;
    while (qi < queue.len()) {
        var path: string = queue[qi];
        qi = qi + 1;
        var name: string = base_name(path);
        if (contains(seen, name)) { continue; }
        seen = seen.append(name);
        match (resolve_module_src(dir, path, name)) {
            Some(src) => {
                var m: parser.Module = parser.parse_module(lexer.tokenize(src));
                loaded = loaded.append(flatten.LoadedModule { name: name, mod: m });
                queue = enqueue_imports(queue, seen, m);
            },
            None => { },   // not a local file — intrinsic / not vendored
        }
    }
    return loaded;
}

// merge_builtins reads `<dir>builtins.fern` (the real built-in-type
// module) and appends its struct + enum decls to `merged`, unmangled, so
// the program's references to JsonValue / IoError / FileStat / … resolve.
// When the file is absent the program is returned unchanged and
// module_with_builtins' idempotent synthetic injection fills the types in.
function merge_builtins(dir: string, merged: parser.Module): parser.Module {
    match (read_file(dir + "builtins.fern")) {
        Ok(bsrc) => {
            var bmod: parser.Module = parser.parse_module(lexer.tokenize(bsrc));
            return parser.Module {
                funcs: merged.funcs,
                structs: append_structs(merged.structs, bmod.structs),
                aliases: merged.aliases,
                imports: merged.imports,
                top_stmts: merged.top_stmts,
                enums: append_enums(merged.enums, bmod.enums),
                resources: merged.resources,
                exports: merged.exports
            };
        },
        Err(e) => { return merged; },
    }
    return merged;
}

function main(): i32 {
    var a: string[] = args();
    // `-ir-probe`: after real import resolution + bundling, report the IR-
    // eligibility frontier (asm_ir.eligibility_report) instead of emitting asm.
    // Unlike asm_ir_run's stdin probe, this loads imports off disk, so a
    // function that calls an IMPORTED helper (`s.split_once()`,
    // `int.__int_to_string_u64()`) is measured with its callee actually
    // present — the stdin probe reports an artificial bail for those because
    // the import is never loaded. Point it at an entry sitting at the stdlib
    // root so `import "std/u64"` and its transitive `import "core/int"` both
    // resolve: `asm_modload_run internal/stdlib/_probe.fern -ir-probe`.
    var probe: boolean = false;
    var entry_path: string = "";
    var ai: i32 = 1;
    while (ai < a.len()) {
        if (a[ai] == "-ir-probe") { probe = true; }
        else if (entry_path == "") { entry_path = a[ai]; }
        ai = ai + 1;
    }
    if (entry_path == "") {
        eprint("usage: asm_modload_run <entry.fern> [-ir-probe]\n");
        return 2;
    }
    var dir: string = dirname(entry_path);
    match (read_file(entry_path)) {
        Ok(src) => {
            var entry: parser.Module = parser.parse_module(lexer.tokenize(src));
            var loaded: flatten.LoadedModule[] = load_imports(dir, entry);
            var merged: parser.Module = flatten.bundle(entry, loaded);
            merged = merge_builtins(dir, merged);
            if (probe) {
                write(asm_ir.eligibility_report(asm_ir.lift_lambdas(merged)));
                return 0;
            }
            write(asm.emit_module(parser.module_with_builtins(merged)));
            return 0;
        },
        Err(e) => {
            eprint("asm_modload_run: could not read entry file\n");
            return 1;
        },
    }
    return 3;
}
