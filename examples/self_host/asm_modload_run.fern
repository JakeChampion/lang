// examples/self_host/asm_modload_run.fern — import-driven self-host
// compiler driver. The successor to two stopgaps:
//
//   * bundle_run.fern, which reads several modules off ONE stdin stream
//     glued together with `///MODULE <name>` marker lines — a hand-packed
//     bundle the Go test harness concatenates, not real module loading.
//   * the synthetic builtin table (parser.inject_builtin_enums), which
//     conjures the built-in TYPES (JsonValue / IoError / FileStat / …) in
//     code instead of reading them from source.
//
// This driver instead does what the native compiler's `modload` does:
// take an ENTRY file path on argv, read it, follow its `import "./x"`
// declarations to sibling `x.fern` files on disk (transitively, via the
// shared ./modloader), load the built-in types from a real `builtins.fern`
// module, merge everything with flatten.bundle, and emit x86-64 asm.
//
//     $ asm_modload_run path/to/main.fern > main.s
//
// Module resolution + builtin merging live in ./modloader (shared with
// the other import-driven drivers); see that file for the resolution
// rules. This driver is just the asm-emitting front door (+ an -ir-probe
// mode). Uses only features the self-hosted emitter supports (args,
// read_file → Result, match), so it builds with either compiler.

import "./util";
import "./lexer";
import "./parser";
import "./flatten";
import "./asm_arm64_ir";
import "./asm_ir";
import "./irlower";
import "./ir";
import "./irverify";
import "./irverifyprovided";
import "./modloader";
import "./treeshake";

// ---- callee resolution (#6639 slice 4) ---------------------------------

// declared_names is every function the WHOLE program declares, spelled the way
// a call_direct names it: bare for a free function, `Type.method` for a
// receiver method — the same key irlower.lower_module stores on LoweredFn.
//
// Built from the DECLARED functions, not the lowered ones. A function whose
// lowering bailed, and a generic monomorphised under another name, are both
// absent from the lowered set while being perfectly well declared; resolving
// against what lowered would report a missing callee on exactly the functions
// a lowering bug already hid. `@import` externs are ordinary FuncDecls here,
// so the host-supplied half needs no separate arm.
function declared_names(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        if (funcs[i].receiver_type.len() > 0) {
            out = out.append(util.base_type_name(funcs[i].receiver_type) + "." + funcs[i].name);
        } else {
            out = out.append(funcs[i].name);
        }
        i = i + 1;
    }
    return out;
}

// verify_provided_module runs the resolution pass over the whole merged
// program and writes the verdict. Returns the process exit code.
//
// This is the driver the sweep has to use: `irlower_run` lowers ONE module, so
// every imported `Type.method` is unresolved there by construction — a census
// over the conformance corpus found ~200 of 255 distinct unresolved names were
// stdlib methods reached through an import. The declared set is only complete
// once the bundle is.
function verify_provided_module(merged: parser.Module): i32 {
    var vmod: parser.Module = asm_ir.lift_lambdas(parser.module_with_builtins(merged));
    var ix: irverifyprovided.NameIndex = irverifyprovided.name_index(declared_names(vmod.funcs));
    var fns: irlower.LoweredFn[] = irlower.lower_module(vmod.funcs, vmod.structs);
    var probs: irverify.Problem[] = [];
    var calls: i32 = 0;
    var checked: i32 = 0;
    var i: i32 = 0;
    while (i < fns.len()) {
        if (fns[i].ok) {
            checked = checked + 1;
            var r: irverifyprovided.ProvidedResult = irverifyprovided.verify_provided_fn(fns[i].name, fns[i].ops, ix);
            calls = calls + r.calls;
            var k: i32 = 0;
            while (k < r.problems.len()) { probs = probs.append(r.problems[k]); k = k + 1; }
        }
        i = i + 1;
    }
    var tally: string = "checked " + util.i32_to_string(checked) + " functions, "
        + util.i32_to_string(calls) + " direct calls";
    if (probs.len() == 0) {
        write("irverifyprovided: clean (" + tally + ")\n");
        return 0;
    }
    write("irverifyprovided: " + util.i32_to_string(probs.len()) + " problem(s) (" + tally + ")"
        + irverify.format_problems(probs, 20) + "\n");
    return 1;
}

// provided_audit checks the verifier's inventory against the EMITTER's own
// predicate, and writes any name the two disagree about.
//
// Only this direction is checkable: `asm_ir.is_fern_helper` is a predicate, so
// a helper the emitter gained and the inventory did not cannot be enumerated
// out of it. That direction surfaces instead as an unresolved callee in the
// corpus sweep — which is the failure the pass exists to produce, so it is
// covered, just not here. This half catches the other drift: an inventory
// entry naming a helper no backend emits, which would silently excuse a real
// missing body.
function provided_audit(): i32 {
    var names: string[] = irverifyprovided.provided_names();
    var bad: string[] = [];
    var i: i32 = 0;
    while (i < names.len()) {
        if (!asm_ir.is_fern_helper(names[i])) { bad = bad.append(names[i]); }
        i = i + 1;
    }
    if (bad.len() == 0) {
        write("provided-audit: all " + util.i32_to_string(names.len())
            + " inventory entries are emitted by the backend\n");
        return 0;
    }
    var out: string = "provided-audit: " + util.i32_to_string(bad.len())
        + " inventory entrie(s) no backend emits:";
    var j: i32 = 0;
    while (j < bad.len()) { out = out + "\n    " + bad[j]; j = j + 1; }
    write(out + "\n");
    return 1;
}

// builtin_view returns `base` (the union of every per-module unit's structs)
// extended with the built-in TYPE layouts the compiler's own code references:
// builtins.fern's struct + enum-variant decls (read from the entry's dir, the
// same source merge_builtins uses for the AST path), then inject_builtin_enums
// for the globally-injected variants (Option / Result / JsonValue / IoError /
// FileStat / …). The per-module IR emit + eligibility gate look up an imported
// struct's field layout in this WHOLE-PROGRAM struct view, so a compiler function
// touching a built-in type (e.g. a `match` on read_file's Result, an IoError
// field) lowers correctly — without it the per-module-built compiler miscompiles
// every built-in-typed code path (the AST path gets the same via
// module_with_builtins). Enum-variant structs (enum_owner set) live in
// bmod.structs after parse, so appending those covers builtins.fern's own enums.
function builtin_view(dir: string, base: parser.StructDecl[]): parser.StructDecl[] {
    var out: parser.StructDecl[] = base;
    match (read_file(dir + "builtins.fern")) {
        Ok(bsrc) => {
            var bmod: parser.Module = parser.parse_module(lexer.tokenize(bsrc));
            var i: i32 = 0;
            while (i < bmod.structs.len()) { out = out.append(bmod.structs[i]); i = i + 1; }
        },
        Err(e) => { },
    }
    return parser.inject_builtin_enums(out);
}

// The `.weak`-dedup pair (dedupe_weak_into + dedupe_weak_defs) drops repeated
// `.weak` DEFINITIONS from a concatenated unit stream, keeping the first of
// each.
//
// A per-module unit emits four kinds of symbol that are one-per-PROGRAM but that
// any unit needing them emits for itself, each marked `.weak` so the linker
// merges the copies:
//
//   __fern_shp_<T>                     interned struct/enum shape (asmcore.shape_sym)
//   __fn___struct_drop_<T>             per-type deep struct drop (asm_ir.fern)
//   __fn___struct_arr_elems_drop_<T>   its element-walking sibling
//   __fn___field_reclaim_<T>
//
// The weak merge only happens when each unit is its own object file — the
// batched per-module build. Concatenating units into a single assembly stream
// instead hands `as` two definitions of one symbol in one file, which is an
// error (`symbol __fern_shp_HttpRequest is already defined`), not a merge.
// Keeping the first definition and dropping the rest gives every unit's
// REFERENCES one definition to bind to, which is exactly the address the weak
// merge would have produced.
//
// This used to special-case `__fern_shp_` alone and drop exactly ONE following
// line, because a shape definition is the two-line pair `.weak SYM` / `SYM:
// .ascii …`. The three drop/reclaim helpers are multi-line function BODIES, so
// they collided anyway: that is one of the two things behind the per-module
// rescue's `nfuncs < 1500` cap below — a program whose modules share struct
// types (three `parser__` types across the stage-2 compiler's units) hit
// `symbol __fn___struct_drop_parser__ParamDecl is already defined`, which reads
// like a memory wall and is not one. (The cap's OTHER reason IS memory, but for
// a different program: see the bound's own comment.)
//
// So skip the whole definition, whatever its length. After a duplicate
// `.weak SYM` comes the `SYM:` line, then the body: INSTRUCTIONS (indented, and
// never starting with `.`) and `.L…:` local labels. Anything else ends the skip.
//
// "Indented" alone is NOT a safe body test, and getting that wrong is what makes
// this function delicate: the emitter indents its DIRECTIVES too, and a unit's
// prologue is `    .globl _start` / `    .text` (asm_ir.emit_module_ir_unit_flat).
// A duplicate `.weak` at the tail of one unit's shape block sits immediately
// before the next unit's prologue, so a skip that eats indented lines
// indiscriminately swallows that `.globl` + `.text` — which silently drops the
// entry unit's code into the previous unit's `.rodata`, leaving `_start` a LOCAL
// rodata symbol (`nm`: `r _start`), the linker unable to find an entry
// (`cannot find entry symbol _start`), and the built compiler jumping to a
// garbage address (observed: RIP=0x1 with the initial argv/envp stack
// untouched). Hence the "indented AND not a directive" test below.

// dedupe_weak_into is the incremental core: it appends the deduped form of ONE
// already-emitted chunk to the (caller-reset) global strbuf and returns the
// updated `seen` symbol set, so a caller streaming unit-at-a-time carries the
// set across chunks without ever holding the whole program's asm in memory.
//
// Splitting on a chunk boundary is sound because a chunk is a COMPLETE emit: a
// `.weak SYM` definition never straddles two units, so the drop state machine
// always returns to 0 before a chunk ends and has nothing to carry.
function dedupe_weak_into(asm_text: string, seen_in: string[]): string[] {
    var seen: string[] = seen_in;
    var i: i32 = 0;
    var n: i32 = asm_text.len();
    // 0 = emitting, 1 = drop the `SYM:` line of a duplicate, 2 = drop its body.
    var state: i32 = 0;
    while (i < n) {
        var j: i32 = i;
        while (j < n && asm_text[j] != 10) { j = j + 1; }   // 10 = '\n'
        var line: string = asm_text[i:j] + "";
        var drop: boolean = false;
        if (state == 1) { drop = true; state = 2; }
        else if (state == 2) {
            // First non-blank column, so a directive is recognised whether or
            // not the emitter indented it.
            var k: i32 = 0;
            while (k < line.len() && (line[k:k + 1] == " " || line[k:k + 1] == "\t")) { k = k + 1; }
            var body: string = line[k:line.len()] + "";
            if (body.len() == 0) { drop = true; }                                  // blank
            else if (body.len() > 2 && body[0:2] == ".L") { drop = true; }          // local label
            else if (k > 0 && body[0:1] != ".") { drop = true; }                    // instruction
            else { state = 0; }                                                    // directive / label
        }
        if (state == 0 && !drop && line.len() > 6 && line[0:6] == ".weak ") {
            var sym: string = line[6:line.len()] + "";
            if (util.has_str(seen, sym)) { drop = true; state = 1; }
            else { seen = seen.append(sym); }
        }
        if (!drop) { strbuf_append(line); strbuf_append("\n"); }
        i = j + 1;
    }
    return seen;
}

// dedupe_weak_defs dedupes a whole in-memory concat in one pass — the
// single-process concat path's entry point. Accumulates through the global
// strbuf (O(1) amortised per append): every unit has already been emitted into
// `asm_text`, so no emitter is using it, and `out = out + line` would be O(N²)
// over a ~400 KB stream.
function dedupe_weak_defs(asm_text: string): string {
    strbuf_reset();
    var ignored: string[] = dedupe_weak_into(asm_text, []);
    return strbuf_take();
}

// prune_to_reachable keeps only `mod`'s funcs whose mangled name is in `reach`
// (the reachable-name set derived from the treeshaked merged module). Both
// flatten.bundle (the merged path) and flatten.bundle_per_module mangle a
// non-entry decl to `prefix__name`, so the names line up. Runs BEFORE
// lift_lambdas, so a kept function's lifted lambdas (generated names, not in
// `reach`) survive. Twin of asm_load_run's.
function prune_to_reachable(mod: parser.Module, reach: string[]): parser.Module {
    var kept: parser.FuncDecl[] = [];
    var fi: i32 = 0;
    while (fi < mod.funcs.len()) {
        if (util.has_str(reach, mod.funcs[fi].name)) { kept = kept.append(mod.funcs[fi]); }
        fi = fi + 1;
    }
    return parser.Module { funcs: kept, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports, impls: mod.impls, trait_reqs: mod.trait_reqs };
}

// emit_per_module_concat compiles a program's modules SEPARATELY (per-module IR
// units) and concatenates them into one linkable asm stream — the file-based
// driver's copy of asm_load_run's over-budget rescue (#5676), which this driver
// never had. Each module is under the merged 512-function IR budget, so each
// unit lowers on the IR path; the units share a whole-program func/struct view
// so cross-module calls and imported struct layouts resolve, and only the entry
// unit emits `_start` + the shared runtime.
//
// Without it, a stdlib-importing program whose merged closure crosses the
// budget dropped to the AST emitter (deleted since; #3457) — which could not
// emit tcp_listen / poll /
// tcp_pollable at all, so the flagship edge-handler program (std/http +
// std/tcp + a `handle` function) compiled to asm with a dozen dangling
// `__fn_` symbols and failed at LINK, even though every one of its functions
// lowers on the IR path.
//
// The struct view is extended with builtin_view, exactly as run_per_module
// does: a unit touching a built-in type (Option / Result / IoError /
// HttpRequest) needs those layouts or it miscompiles.
//
// Returns "" if a REACHABLE module is still not IR-eligible. That used to mean
// "fall back to the AST emitter"; the emitters are gone (#3457), so the caller
// turns it into a hard error via emit_module_or_error.
// `target` selects the per-unit emitter: "arm64" uses
// asm_arm64_ir.emit_module_ir_unit_arm64, anything else the x86-64
// asm_ir.emit_module_ir_unit. The other per-module routes here were already
// target-aware; this one was not, so the arm64 merged leg had no over-budget
// rescue and dropped straight to the (since-deleted) AST emitter for the whole single-process
// band x86 served via IR (#3457 slice 5).
function emit_per_module_concat(dir: string, entry_mod: parser.Module, loaded: flatten.LoadedModule[], reach: string[], target: string): string {
    var parts: flatten.PerModule[] = flatten.bundle_per_module(entry_mod, loaded);
    var infmods: parser.Module[] = [];
    var all_funcs: parser.FuncDecl[] = [];
    var all_structs: parser.StructDecl[] = [];
    var known: string[] = [];
    // Whole-program SIGNATURE view, collected from the pruned parts BEFORE any
    // lifting: the lift pass decides whether a fn-value argument is env-boxed by
    // looking the CALLEE up, so a call into a sibling module needs that sibling's
    // declaration or the value is passed as a raw code address the callee then
    // dereferences as a box (#5698). Collecting pre-lift is sound because lifting
    // only ADDS `$wrap` / `__lam_` / `$clo` functions — it never changes the
    // signature of one already there.
    var sig_view: parser.FuncDecl[] = [];
    var si0: i32 = 0;
    while (si0 < parts.len()) {
        var pm: parser.Module = prune_to_reachable(parts[si0].mod, reach);
        var sf: i32 = 0;
        while (sf < pm.funcs.len()) { sig_view = sig_view.append(pm.funcs[sf]); sf = sf + 1; }
        si0 = si0 + 1;
    }
    var pi: i32 = 0;
    while (pi < parts.len()) {
        var im: parser.Module = parser.infer_ret_types_module(asm_ir.lift_lambdas_view(prune_to_reachable(parts[pi].mod, reach), sig_view));
        infmods = infmods.append(im);
        var fk: i32 = 0;
        while (fk < im.funcs.len()) {
            all_funcs = all_funcs.append(im.funcs[fk]);
            known = known.append(im.funcs[fk].name);
            if (im.funcs[fk].receiver_type.len() > 0) {
                known = known.append(util.base_type_name(im.funcs[fk].receiver_type) + "." + im.funcs[fk].name);
            }
            fk = fk + 1;
        }
        var sk: i32 = 0;
        while (sk < im.structs.len()) { all_structs = all_structs.append(im.structs[sk]); sk = sk + 1; }
        pi = pi + 1;
    }
    all_structs = builtin_view(dir, all_structs);
    // The entry unit emits the ONE shared runtime; seed it with every root so a
    // library unit's `call __fern_*` resolves (asm_ir.all_runtime_need_roots —
    // the same superset the batched per-module build feeds it).
    //
    // The exact union via module_runtime_needs is NOT usable here: it lowers
    // each module under that module's OWN struct view, so a function needing
    // the whole-program view to lower at all (std/tcp's __serve_loop, whose
    // signature is built from the builtin HttpRequest / Platform layouts) is
    // silently skipped and the needs it would have marked — tcp_send,
    // tcp_close — go missing, dangling at link.
    var needs: string[] = asm_ir.all_runtime_need_roots();
    var out: string = "";
    var idx: i32 = 0;
    while (idx < parts.len()) {
        // A module left with no reachable functions contributes no code, so
        // there is nothing to emit and nothing to judge: skip it. Without this
        // the eligibility gate — which reports an EMPTY module as ineligible
        // (eligible_core_known_view_impl's `funcs.len() == 0` guard) — aborts
        // the whole concat, and a program whose closure pulls in modules it
        // barely uses (every std/http + std/tcp program: ~40 modules loaded,
        // ~81 functions reachable) can never take the IR path.
        if (infmods[idx].funcs.len() == 0) { idx = idx + 1; continue; }
        var elig: boolean = asm_ir.all_eligible_lib_known_view(infmods[idx], known, all_funcs, all_structs);
        if (parts[idx].is_entry) { elig = asm_ir.all_eligible_known_view(infmods[idx], known, all_funcs, all_structs); }
        if (!elig) {
            // Name the module that forced the whole program back to the AST
            // emitter. Without this the fallback is silent and the failure
            // resurfaces as an undefined `__fn_` at link, with nothing
            // pointing at which unit could not lower.
            eprint("per-module concat: module not IR-eligible, falling back to the AST emitter: " + parts[idx].ns + "\n");
            return "";
        }
        var extra: string[] = [];
        if (parts[idx].is_entry) { extra = needs; }
        if (target == "arm64-linux") {
            out = out + asm_arm64_ir.emit_module_ir_unit_arm64(infmods[idx], parts[idx].is_entry, true, parts[idx].ns, extra, all_funcs, all_structs, 0, 0 - 1);
        } else {
            out = out + asm_ir.emit_module_ir_unit(infmods[idx], parts[idx].is_entry, true, parts[idx].ns, extra, all_funcs, all_structs, 0, 0 - 1, []);
        }
        idx = idx + 1;
    }
    return dedupe_weak_defs(out);
}

// module_ir_eligible reports whether one module lowers wholly on the IR path
// under the whole-program view. The entry uses the stricter gate (it owns
// `main` + the shared runtime).
function module_ir_eligible(infmods: parser.Module[], parts: flatten.PerModule[], midx: i32, known: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[]): boolean {
    if (parts[midx].is_entry) { return asm_ir.all_eligible_known_view(infmods[midx], known, all_funcs, all_structs); }
    return asm_ir.all_eligible_lib_known_view(infmods[midx], known, all_funcs, all_structs);
}

// emit_unit_to_file emits ONE flat unit and writes it to <out_dir>/unit_*.s.
// Containers are passed with an index rather than as indexed element VALUES so
// the callee reads them in place.
function emit_unit_to_file(out_dir: string, unit_spec: string, infmods: parser.Module[], parts: flatten.PerModule[], midx: i32, needs: string[], all_funcs: parser.FuncDecl[], all_structs: parser.StructDecl[], wpb: irlower.FnSigs, target: string): boolean {
    var wlo: i32 = nth_field_i32(unit_spec, 1);
    var whi: i32 = nth_field_i32(unit_spec, 2);
    var is_entry: boolean = parts[midx].is_entry;
    var extra: string[] = [];
    if (is_entry) { extra = needs; }
    var shard_ns: string = parts[midx].ns;
    if (wlo > 0) { shard_ns = shard_ns + "_s" + util.i32_to_string(wlo); }
    var unit: string = "";
    if (target == "arm64-linux") {
        unit = asm_arm64_ir.emit_module_ir_unit_arm64(infmods[midx], is_entry, true, shard_ns, extra, all_funcs, all_structs, wlo, whi);
    } else {
        unit = asm_ir.emit_module_ir_unit_flat(infmods[midx], is_entry, true, shard_ns, extra, all_funcs, all_structs, wlo, whi, [], wpb);
    }
    var outpath: string = out_dir + "/" + unit_file_name(unit_spec);
    match (write_file(outpath, unit)) {
        Err(werr) => {
            eprint("per-module: unit write failed: " + outpath + "\n");
            return false;
        },
        Ok(_) => { },
    }
    return true;
}

// spawn_batch runs ONE batch of units in a child process and returns its exit
// code (or -1 if the fork itself failed).
//
// fork + proc_exec + waitpid rather than a `subprocess` builtin: no compiled
// target lowers subprocess (it is interp-only, and the platform gate pins that
// shut), whereas the crash-only process trio is granted by every native target.
// It also needs no pipes, because the child communicates through the unit FILES
// it writes rather than through stdout.
function spawn_batch(self_exe: string, entry_path: string, tmp: string, lo: i32, hi: i32, target: string): i32 {
    var pid: i32 = proc_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        // proc_exec supplies argv[0] from self_exe, so only real arguments here.
        var rc: i32 = proc_exec(self_exe, [entry_path, "-per-module-emit-all", "-out-dir", tmp,
                                           "-unit-range", util.i32_to_string(lo) + ":" + util.i32_to_string(hi),
                                           "-assume-eligible", "-target", target]);
        // Only reached if exec failed; 127 is the shell's convention for it and
        // is distinguishable from any emit failure the child would report.
        exit(127);
    }
    return proc_waitpid(pid);
}

// emit_per_module_spawned is the over-ceiling sibling of emit_per_module_concat:
// it emits the per-module IR units in BATCHES of child processes and streams the
// results to stdout, so a program too big for a single-process concat still takes
// the IR path instead of dropping to the AST emitter. This is what removes the
// whole-compiler self-compile's dependence on the legacy AST emitter (#3457
// slice 3).
//
// WHY PROCESSES. The per-window emit's net working set (~0.4 GB) is not
// reclaimed within a process, so emitting all ~35 whole-compiler units in one
// accumulates past the 16 GiB bump arena and trips __fern_alloc's bounds check
// (exit 137, which reads like an OOM-kill without being one). A child per batch
// releases the accumulation at exit while still amortising the shared base
// derivation (wp_fn_sigs) across its batch.
//
// A process boundary is also the only release mechanism that TOLERATES the emit
// path's pre-existing over-releases: __rc_underflow_count() reports ~2443 of
// them on the entry unit's emit alone, identically in the un-spawned
// -per-module-emit-all path, so they predate this code and are latent today.
// Exiting reclaims without reusing anything, so they stay latent; an in-process
// arena rewind (__heap_mark / __heap_release_to) instead hands an over-released
// block out again while a live pointer still refers to it, which is why the
// checkpointed variant of this function crashed and this one does not.
//
// WHY STREAMING, not concatenation. The caller's contract is one asm stream on
// stdout, but `out = out + unit` over the whole compiler's ~500 MB of asm is
// quadratic in a bump arena — it would trade the emit-stage arena exhaustion for
// a reassembly-stage one. Reading one unit at a time and writing it straight out
// holds ~one unit; dedupe_weak_into carries the `.weak` symbol set across those
// chunks so the stream is deduped exactly as a whole-buffer pass would leave it.
//
// `-assume-eligible` is passed for the reason the flag exists (the pre-check
// re-lowers every module, ~doubling both peak and time): a module that cannot
// lower leaves a dangling `__fn_` symbol and fails loudly at LINK, the same
// backstop the harness-driven batched build already relies on.
//
// Return codes, so the caller never has to guess whether stdout was touched:
// 0 = the stream was written; 1 = nothing was written, fall back to the AST
// emitter; 2 = failed mid-stream, so stdout holds a partial unit and a hard
// error is the only sound outcome. Every ordinary failure is detected before the
// first write — hence the presence pre-pass — so 2 needs an I/O race inside our
// own private temp directory.
function emit_per_module_spawned(dir: string, entry_path: string, entry: parser.Module, loaded: flatten.LoadedModule[], target: string, func_budget: i32, batch: i32, self_exe: string): i32 {
    if (self_exe.len() == 0) { return 1; }
    // Only the flat unit LIST is needed here (analysis, no codegen); each child
    // re-derives the same list and emits its slice of it.
    var parts: flatten.PerModule[] = flatten.bundle_per_module(entry, loaded);
    var infmods: parser.Module[] = [];
    var pi: i32 = 0;
    while (pi < parts.len()) {
        infmods = infmods.append(parser.infer_ret_types_module(asm_ir.lift_lambdas(parts[pi].mod)));
        pi = pi + 1;
    }
    var units: string[] = flat_unit_list(dir, parts, infmods, func_budget);
    if (units.len() == 0) { return 1; }
    var tmp: string = "";
    match (temp_dir("fern-pm")) {
        Ok(td) => { tmp = td; },
        Err(e_td) => {
            eprint("per-module spawned: could not create a unit directory\n");
            return 1;
        },
    }
    var lo: i32 = 0;
    while (lo < units.len()) {
        var hi: i32 = lo + batch;
        if (hi > units.len()) { hi = units.len(); }
        var rc: i32 = spawn_batch(self_exe, entry_path, tmp, lo, hi, target);
        if (rc != 0) {
            eprint("per-module spawned: unit batch " + util.i32_to_string(lo) + ":" + util.i32_to_string(hi) + " failed (exit " + util.i32_to_string(rc) + "), falling back to the AST emitter\n");
            var ce1: i32 = 0;
            match (remove_dir_all(tmp)) { Err(rr1) => { ce1 = 1; }, Ok(_) => { }, }
            return 1;
        }
        lo = hi;
    }
    // A missing unit means the batch loop and the unit list disagreed, which
    // would silently drop code from the program. Check the whole set BEFORE
    // writing anything so that stays a clean fallback, not a truncated stream.
    var vi: i32 = 0;
    while (vi < units.len()) {
        var vpath: string = tmp + "/" + unit_file_name(units[vi]);
        var present: boolean = false;
        match (stat(vpath)) {
            Ok(st) => { present = true; },
            Err(e_st) => { },
        }
        if (!present) {
            eprint("per-module spawned: missing emitted unit " + vpath + "\n");
            var ce2: i32 = 0;
            match (remove_dir_all(tmp)) { Err(rr2) => { ce2 = 1; }, Ok(_) => { }, }
            return 1;
        }
        vi = vi + 1;
    }
    var seen: string[] = [];
    var ri: i32 = 0;
    while (ri < units.len()) {
        var rpath: string = tmp + "/" + unit_file_name(units[ri]);
        var read_ok: boolean = false;
        match (read_file(rpath)) {
            Ok(text) => {
                strbuf_reset();
                seen = dedupe_weak_into(text, seen);
                write(strbuf_take());
                read_ok = true;
            },
            Err(e_ru) => { },
        }
        if (!read_ok) {
            eprint("per-module spawned: unit vanished mid-stream: " + rpath + "\n");
            var ce3: i32 = 0;
            match (remove_dir_all(tmp)) { Err(rr3) => { ce3 = 1; }, Ok(_) => { }, }
            return 2;
        }
        ri = ri + 1;
    }
    var ce4: i32 = 0;
    match (remove_dir_all(tmp)) { Err(rr4) => { ce4 = 1; }, Ok(_) => { }, }
    return 0;
}

// run_per_module drives the per-module build of the loaded program (#3451 step 4
// / #3456), the builtins-aware twin of asm_load_run's per-module driver: it
// threads the built-in struct layouts (builtin_view) into the whole-program
// view so the compiler's OWN built-in-typed code (Option / Result / IoError /
// JsonValue) lowers correctly. One emit per process (the native strbuf holds one
// emit), so the build is driven across invocations:
//   -per-module-count   → print the module count N
//   -per-module-needs   → print the whole-program runtime-need union (one/line)
//   -per-module-emit N [-extra-need X...]
//                       → emit module N's translation unit (the entry folds the
//                         supplied need union into its single shared runtime)
// module_sig_string renders a module's PUBLIC signature surface — the only part
// of a callee an importer's codegen depends on: each function's mangled name,
// parameter types, return type and receiver, plus each struct's field layout
// (name + ordered field types). Bodies are deliberately excluded, so a body-only
// edit to a module does NOT change its signature hash and therefore does NOT
// invalidate the modules that merely call into it. Return types are read off the
// INFERRED module (infer_ret_types_module has already run), so an inferred
// return-type change is caught even when the source left the type implicit.
// emit_window_size returns the [lo,hi) function-window size for a module of
// `funcs` functions and `bytes` source bytes — the in-driver twin of the harness
// emitWindowSize (internal/e2eselfhost/self_host_modload_permodule_test.go), kept
// byte-identical so `-per-module-emit-all` shards each module into the SAME
// windows the per-process fixpoint does. A 100-func budget and a 300 KB
// source-byte budget each set a minimum window count (the byte budget shards
// modules of FEW but GIANT functions, e.g. asm_arm64, that the count alone emits
// whole and blows the emit's peak); the window is funcs / ceil(max of the two).
// nth_field_i32 reads the n-th ':'-separated field of `s` as an i32 (0-based).
// The flat-unit list encodes each unit as "modIdx:wlo:whi"; digits_to_i32 stops
// at the ':' on its own, so only the field offset has to be found.
function nth_field_i32(s: string, n: i32): i32 {
    var i: i32 = 0;
    var f: i32 = 0;
    while (f < n && i < s.len()) {
        if (s[i] == 58) { f = f + 1; }   // 58 = ':'
        i = i + 1;
    }
    return util.digits_to_i32(s[i:s.len()] + "");
}

// flat_unit_list enumerates the (module × function-window) units a per-module
// emit produces, as "modIdx:wlo:whi" triples in flat-index order — the shared
// spine of `-per-module-emit-all`'s emit loop and the spawned whole-program
// path. One definition means a batch's `-unit-range LO:HI` indices, the flat
// indices an orchestrator batches over, and the `unit_<idx>[_sN].s` names it
// reads back can never disagree.
//
// Analysis only (function counts + source bytes, no codegen), so a caller can
// afford to call it before deciding anything.
function flat_unit_list(dir: string, parts: flatten.PerModule[], infmods: parser.Module[], func_budget: i32): string[] {
    var units: string[] = [];
    var idx: i32 = 0;
    while (idx < parts.len()) {
        var fcount: i32 = infmods[idx].funcs.len();
        var sbytes: i32 = 0;
        match (read_file(dir + parts[idx].ns + ".fern")) {
            Ok(fsrc) => { sbytes = fsrc.len(); },
            Err(e_fu) => { },
        }
        var window: i32 = emit_window_size(fcount, sbytes, func_budget);
        var wlo: i32 = 0;
        var more: boolean = true;
        while (more) {
            var whi: i32 = wlo + window;
            if (whi > fcount) { whi = fcount; }
            units = units.append(util.i32_to_string(idx) + ":" + util.i32_to_string(wlo) + ":" + util.i32_to_string(whi));
            wlo = wlo + window;
            if (wlo >= fcount) { more = false; }
        }
        idx = idx + 1;
    }
    return units;
}

// unit_file_name maps a flat unit's "modIdx:wlo:whi" triple to the file name
// the per-module emit writes it under: `unit_<modIdx>[_s<wlo>].s`.
function unit_file_name(unit: string): string {
    var idx: i32 = nth_field_i32(unit, 0);
    var wlo: i32 = nth_field_i32(unit, 1);
    var tag: string = "";
    if (wlo > 0) { tag = "_s" + util.i32_to_string(wlo); }
    return "unit_" + util.i32_to_string(idx) + tag + ".s";
}

function emit_window_size(funcs: i32, bytes: i32, func_budget: i32): i32 {
    var byte_budget: i32 = 300000;
    var nwin: i32 = (funcs + func_budget - 1) / func_budget;
    var bybytes: i32 = (bytes + byte_budget - 1) / byte_budget;
    if (bybytes > nwin) { nwin = bybytes; }
    if (nwin < 1) { nwin = 1; }
    var window: i32 = (funcs + nwin - 1) / nwin;
    if (window < 1) { window = 1; }
    return window;
}

function run_per_module(dir: string, entry_path: string, entry: parser.Module, loaded: flatten.LoadedModule[], pm_mode: string, pm_index: i32, pm_extra: string[], cache_dir: string, pm_lo: i32, pm_hi: i32, target: string, out_dir: string, func_budget: i32, unit_lo: i32, unit_hi: i32, assume_eligible: boolean): i32 {
    var parts: flatten.PerModule[] = flatten.bundle_per_module(entry, loaded);
    if (pm_mode == "count") {
        print(util.i32_to_string(parts.len()) + "\n");
        return 0;
    }
    // Whole-program signature view + program-wide known-symbol set, recomputed
    // each invocation (cheap: parse + analysis, no codegen).
    var infmods: parser.Module[] = [];
    var all_funcs: parser.FuncDecl[] = [];
    var all_structs: parser.StructDecl[] = [];
    var known: string[] = [];
    var pi: i32 = 0;
    while (pi < parts.len()) {
        var im: parser.Module = parser.infer_ret_types_module(asm_ir.lift_lambdas(parts[pi].mod));
        infmods = infmods.append(im);
        var fk: i32 = 0;
        while (fk < im.funcs.len()) {
            all_funcs = all_funcs.append(im.funcs[fk]);
            known = known.append(im.funcs[fk].name);
            if (im.funcs[fk].receiver_type.len() > 0) {
                known = known.append(util.base_type_name(im.funcs[fk].receiver_type) + "." + im.funcs[fk].name);
            }
            fk = fk + 1;
        }
        var sk: i32 = 0;
        while (sk < im.structs.len()) { all_structs = all_structs.append(im.structs[sk]); sk = sk + 1; }
        pi = pi + 1;
    }
    // Extend the struct view with the built-in type layouts (see builtin_view).
    all_structs = builtin_view(dir, all_structs);
    if (pm_mode == "emit-all") {
        // Multi-unit-per-process whole-compiler per-module emit (#3457 slice 2).
        // The whole-program signature registry is derived ONCE per process
        // (wp_fn_sigs) and shared across every unit it emits — collapsing the
        // O(units × all_funcs) re-derivation that dominated the per-process
        // serial emit (~20 s/unit even for a 3-function module). Units are the flat
        // (module × window) list, each module sharded into the SAME [lo,hi)
        // windows the per-process fixpoint uses (emit_window_size), and every unit
        // is written to <out_dir>/unit_<modIdx>[_s<lo>].s.
        //
        // `-unit-range LO:HI` restricts this process to flat unit indices [LO,HI).
        // The per-window emit's net working set (~0.4 GB) is NOT reclaimed within
        // one process, so emitting ALL 35 units in one process OOMs (~16 GB); an
        // orchestrator drives BATCHES of units, each a fresh process that releases
        // the accumulation on exit while still sharing the base derivation across
        // its batch. The entry gets the full runtime-need roots as its extra_needs.
        // x86 shares the bases; -target arm64-linux uses the arm64 emitter unchanged.
        var needs: string[] = asm_ir.all_runtime_need_roots();
        var wpb: irlower.FnSigs = asm_ir.wp_fn_sigs(all_funcs, all_structs);
        var units: string[] = flat_unit_list(dir, parts, infmods, func_budget);
        // Module index whose eligibility has been checked. Units are emitted in
        // module order, so a scalar suffices to check once per MODULE rather than
        // once per window — the check re-lowers the whole module (see
        // -assume-eligible), so paying it per shard would be waste.
        var checked_idx: i32 = 0 - 1;
        var uidx: i32 = 0;
        while (uidx < units.len()) {
            if (uidx < unit_lo || uidx >= unit_hi) { uidx = uidx + 1; continue; }
            var idx: i32 = nth_field_i32(units[uidx], 0);
            if (!assume_eligible && idx != checked_idx) {
                if (!module_ir_eligible(infmods, parts, idx, known, all_funcs, all_structs)) {
                    eprint("per-module: module not IR-eligible: ");
                    eprint(parts[idx].ns);
                    eprint("\n");
                    return 1;
                }
                checked_idx = idx;
            }
            if (!emit_unit_to_file(out_dir, units[uidx], infmods, parts, idx, needs, all_funcs, all_structs, wpb, target)) { return 1; }
            uidx = uidx + 1;
        }
        return 0;
    }
    if (pm_mode == "func-counts") {
        // Per-module function count (post lift_lambdas / infer — the exact count
        // emit_module_funcs windows over), one per line. A build orchestrator
        // uses this to size `-func-range` shards for an oversized module (#3425)
        // without hardcoding a source-specific function count.
        var fci: i32 = 0;
        while (fci < infmods.len()) { print(util.i32_to_string(infmods[fci].funcs.len()) + "\n"); fci = fci + 1; }
        return 0;
    }
    // Per-module signature hashes (aligned with parts) — the cross-module
    // dependency fingerprints the manifest reports and the cache key folds in.
    // Computed ONLY when a caller needs them (the manifest, or a cached emit):
    // a plain `-per-module-emit N` must not pay this extra whole-program string
    // allocation, since the self-host runtime does not yet reclaim it (#3425) and
    // the whole-compiler emit is already at the memory ceiling.
    var sighashes: string[] = [];
    if (pm_mode == "manifest" || (pm_mode == "emit" && cache_dir.len() > 0)) {
        var shi: i32 = 0;
        while (shi < parts.len()) {
            sighashes = sighashes.append(util.hash_key(modloader.module_sig_string(infmods[shi])));
            shi = shi + 1;
        }
    }
    if (pm_mode == "manifest") {
        // Per-module incremental-codegen manifest (#3451 step 6 / #3458). One line
        // per module — everything an out-of-process build orchestrator needs to
        // decide, correctly, which modules to re-emit and which to reuse:
        //
        //   <ns>|<src_hash>|<sig_hash>|<imp1,imp2,...>
        //
        // A module's cache key is  src_hash(self) folded with sig_hash(m) for every
        // m it imports.  src_hash makes a body-only edit re-emit that module (its
        // own codegen changed); sig_hash makes a signature edit re-emit that module
        // AND its importers (their call-site tagging changed) — while a body-only
        // edit to a dependency leaves importers untouched (their sig_hash input is
        // unchanged).  This is the correct-invalidation core: keying on source
        // alone would ship stale codegen when a depended-on return type changes.
        //
        // src_hash reads the module's own source file (flat sibling layout:
        // <dir><ns>.fern, the whole-compiler self-host case); the entry reads
        // entry_path.  If a source read fails (e.g. a module resolved from a
        // subdir), src_hash is "?", which the orchestrator MUST treat as
        // always-rebuild — sound (never reuses stale), just not incremental for
        // that module.  A subdir-aware version would thread each module's resolved
        // path through the loader; tracked as a follow-up on #3458.
        var mi: i32 = 0;
        while (mi < parts.len()) {
            var src_hash: string = modloader.module_src_hash(dir, entry_path, parts, mi);
            print(parts[mi].ns + "|" + src_hash + "|" + sighashes[mi] + "|" + modloader.module_import_ns(infmods[mi]) + "\n");
            mi = mi + 1;
        }
        return 0;
    }
    if (pm_mode == "needs") {
        // Seed the entry's shared runtime with the full root set instead of an
        // exact per-module union (asm_ir.all_runtime_need_roots): a sound,
        // deterministic over-approximation that avoids re-emitting every module
        // here via module_runtime_needs — that aggregation OOMs a self-host-built
        // driver (#3425), the one thing blocking a self-host per-module self-compile.
        var needs: string[] = asm_ir.all_runtime_need_roots();
        var no: i32 = 0;
        while (no < needs.len()) { print(needs[no] + "\n"); no = no + 1; }
        return 0;
    }
    if (pm_index < 0 || pm_index >= parts.len()) {
        eprint("per-module: emit index out of range\n");
        return 1;
    }
    var extra: string[] = [];
    if (parts[pm_index].is_entry) { extra = pm_extra; }
    // Incremental object cache (#3451 step 6 / #3458). With -cache-dir set, the
    // driver computes this module's content-addressed key (its own source folded
    // with the signatures of the modules it calls into — module_cache_key) and
    // serves the emitted unit from <cache_dir>/<ns>__<hash>.s when it exists. A
    // hit skips codegen entirely (the expensive part); a miss emits, populates
    // the cache, then writes. This is what makes a rebuild after a one-module
    // edit re-emit only that module and its signature-dependents — every other
    // module's key is unchanged, so its unit is reused byte-for-byte. hit/miss is
    // reported on stderr (ns per line) so an orchestrator can see the reuse set;
    // stdout stays exactly the unit asm. A "?" src_hash yields an empty key,
    // which disables the cache for that module (always emit — sound, see
    // module_src_hash).
    var cachefile: string = "";
    if (cache_dir.len() > 0) {
        var src_hash: string = modloader.module_src_hash(dir, entry_path, parts, pm_index);
        var key: string = modloader.module_cache_key(parts, infmods, sighashes, pm_index, src_hash, extra);
        if (key.len() > 0) {
            cachefile = cache_dir + "/" + parts[pm_index].ns + "__" + util.hash_key(key) + ".s";
            match (read_file(cachefile)) {
                Ok(cached) => {
                    eprint("cache-hit " + parts[pm_index].ns + "\n");
                    write(cached);
                    return 0;
                },
                Err(e) => { },
            }
        }
    }
    var elig: boolean = true;
    if (!assume_eligible) {
        elig = asm_ir.all_eligible_lib_known_view(infmods[pm_index], known, all_funcs, all_structs);
        if (parts[pm_index].is_entry) { elig = asm_ir.all_eligible_known_view(infmods[pm_index], known, all_funcs, all_structs); }
    }
    if (!elig) {
        eprint("per-module: module not IR-eligible: ");
        eprint(parts[pm_index].ns);
        eprint("\n");
        return 1;
    }
    // Function-sharding (#3425): emit only the [pm_lo, pm_hi) window of this
    // module's functions. A full window (pm_lo=0, pm_hi<0) is byte-identical to
    // the unsharded emit and keeps the base ns; a partial shard (pm_lo>0) gets a
    // shard-distinct string namespace (base ns + "_s<pm_lo>") so each shard's
    // `.rodata` string labels don't collide at link. The lo=0 shard keeps the
    // base ns, so a full-range emit stays byte-identical (the byte-identity
    // invariant), and disjoint windows have disjoint lo values → distinct ns.
    // (Sharding uses -func-range, the cache uses -cache-dir; they are not
    // combined — a full-range cached emit keeps shard_ns == base ns.)
    var shard_ns: string = parts[pm_index].ns;
    if (pm_lo > 0) { shard_ns = shard_ns + "_s" + util.i32_to_string(pm_lo); }
    var unit: string = "";
    // `-target arm64-linux` routes the per-unit emit through the arm64 emitter
    // (#4398 part 1: the asm_arm64_modload_run fold), incl. the same
    // -func-range [lo,hi) window sharding (#3425) the x86 emit uses — the
    // fold doubled the whole-compiler per-module program (both backends in
    // one closure), pushing its biggest modules past the one-process ceiling.
    if (target == "arm64-linux") {
        unit = asm_arm64_ir.emit_module_ir_unit_arm64(infmods[pm_index], parts[pm_index].is_entry, true, shard_ns, extra, all_funcs, all_structs, pm_lo, pm_hi);
    } else {
        unit = asm_ir.emit_module_ir_unit(infmods[pm_index], parts[pm_index].is_entry, true, shard_ns, extra, all_funcs, all_structs, pm_lo, pm_hi, []);
    }
    // Emit to stdout first, then populate the cache. Both consume `unit`; doing
    // the file write last keeps the ordering unambiguous and avoids relying on
    // write_file's borrow/consume semantics for the unit box.
    write(unit);
    if (cachefile.len() > 0) {
        eprint("cache-miss " + parts[pm_index].ns + "\n");
        match (write_file(cachefile, unit)) {
            Err(werr) => { eprint("per-module: cache write failed for " + parts[pm_index].ns + "\n"); },
            Ok(_) => { },
        }
    }
    return 0;
}

function main(): i32 {
    var a: string[] = args();
    // `-ir-probe`: after real import resolution + bundling, report the IR-
    // eligibility frontier (asm_ir.eligibility_report) instead of emitting asm.
    // Unlike asm_ir_run's stdin probe, this loads imports off disk, so a
    // function that calls an IMPORTED helper (`s.split_once()`,
    // `int.__int_to_string_u64()`) is measured with its callee actually
    // present — the stdin probe reports an artificial bail for those because
    // the import is never loaded. Point it at an entry sitting at the stdlib
    // root so `import "std/u64"` and its transitive `import "core/int"` both
    // resolve: `asm_modload_run internal/stdlib/_probe.fern -ir-probe`.
    //
    // The per-module flags (-per-module-count / -per-module-needs /
    // -per-module-emit N [-extra-need X...]) drive the builtins-aware per-module
    // build (run_per_module) — routing every module through the IR path instead
    // of the merged AST emit below.
    var probe: boolean = false;
    var vprovided: boolean = false;
    var paudit: boolean = false;
    var entry_path: string = "";
    var pm_mode: string = "";
    var pm_index: i32 = 0 - 1;
    var pm_extra: string[] = [];
    var cache_dir: string = "";
    // Function-index window [pm_lo, pm_hi) for the emitted module (#3425). The
    // default (pm_lo=0, pm_hi=-1) is the full range — inert / byte-identical.
    // `-func-range LO:HI` shards one oversized module's emit across processes.
    var pm_lo: i32 = 0;
    var pm_hi: i32 = 0 - 1;
    // `-target x86_64|arm64` selects the emit backend (#4398 part 1: the fold
    // that retired the asm_arm64_modload_run mirror). Default x86_64 keeps
    // every pre-fold caller byte-identical; module loading, the probe, and the
    // per-module analyses are target-agnostic.
    var target: string = "x86-64-linux";
    // `-per-module-emit-all -out-dir DIR` emits every unit in ONE process (#3457
    // slice 2), sharing the whole-program side-table bases. `-func-budget N` sets
    // the per-window function budget (default 100, matching the harness
    // shardThreshold); `-unit-range LO:HI` restricts a batch process to flat unit
    // indices [LO,HI) (default = every unit) so an orchestrator can batch the emit
    // across processes to bound the per-window accumulation.
    var out_dir: string = "";
    var func_budget: i32 = 100;
    var unit_lo: i32 = 0;
    var unit_hi: i32 = 2000000000;
    // -assume-eligible skips the per-module IR-eligibility pre-check
    // (all_eligible_lib_known_view). That check fully re-lowers every function of
    // the module purely to verify it lowers — a SECOND whole-module lowering pass
    // on top of the emit's own. On the self-host bump arena (no GC) the two passes
    // stack, so the pre-check ~doubles the per-window peak (measured: irlower
    // 4.07 GB → 1.81 GB, util 3.05 GB → 1.75 GB, output BYTE-IDENTICAL). The
    // whole-compiler bootstrap (the only caller of the per-module path) is known
    // IR-eligible, and any regression is still caught loudly by the fixpoint /
    // smoke-run (a miscompiled unit fails to link or diverges), so skipping the
    // pre-check there is safe. Default OFF preserves the clean "not IR-eligible"
    // diagnostic for arbitrary per-module use.
    var assume_eligible: boolean = false;
    // Units per orchestrated batch process (see emit_per_module_spawned). The
    // per-window emit accumulates ~0.4 GB a process does not reclaim, so 8 sits
    // near 3.2 GB against the 16 GiB arena. `-unit-batch N` tunes it.
    var unit_batch: i32 = 8;
    var force_spawned: boolean = false;
    var ai: i32 = 1;
    while (ai < a.len()) {
        if (a[ai] == "-ir-probe") { probe = true; }
        else if (a[ai] == "-verifyprovided") { vprovided = true; }
        else if (a[ai] == "-provided-audit") { paudit = true; }
        else if (a[ai] == "-per-module-count") { pm_mode = "count"; }
        else if (a[ai] == "-per-module-needs") { pm_mode = "needs"; }
        else if (a[ai] == "-per-module-func-counts") { pm_mode = "func-counts"; }
        else if (a[ai] == "-per-module-manifest") { pm_mode = "manifest"; }
        else if (a[ai] == "-per-module-emit" && ai + 1 < a.len()) { pm_mode = "emit"; pm_index = util.digits_to_i32(a[ai + 1]); ai = ai + 1; }
        else if (a[ai] == "-per-module-emit-all") { pm_mode = "emit-all"; }
        else if (a[ai] == "-unit-batch" && ai + 1 < a.len()) { unit_batch = util.digits_to_i32(a[ai + 1]); ai = ai + 1; }
        // Force the spawned whole-program path regardless of function count, so
        // it can be exercised on a small program instead of only on the
        // whole-compiler self-compile.
        else if (a[ai] == "-spawned") { force_spawned = true; }
        else if (a[ai] == "-assume-eligible") { assume_eligible = true; }
        else if (a[ai] == "-out-dir" && ai + 1 < a.len()) { out_dir = a[ai + 1]; ai = ai + 1; }
        else if (a[ai] == "-func-budget" && ai + 1 < a.len()) { func_budget = util.digits_to_i32(a[ai + 1]); ai = ai + 1; }
        else if (a[ai] == "-unit-range" && ai + 1 < a.len()) {
            var urng: string = a[ai + 1];
            var uci: i32 = 0;
            while (uci < urng.len() && urng[uci] != 58) { uci = uci + 1; }  // 58 = ':'
            unit_lo = util.digits_to_i32(urng);
            if (uci + 1 <= urng.len()) { unit_hi = util.digits_to_i32(urng[uci + 1:urng.len()]); }
            ai = ai + 1;
        }
        else if (a[ai] == "-extra-need" && ai + 1 < a.len()) { pm_extra = pm_extra.append(a[ai + 1]); ai = ai + 1; }
        else if (a[ai] == "-cache-dir" && ai + 1 < a.len()) { cache_dir = a[ai + 1]; ai = ai + 1; }
        else if (a[ai] == "-target" && ai + 1 < a.len()) { target = a[ai + 1]; ai = ai + 1; }
        else if (a[ai] == "-func-range" && ai + 1 < a.len()) {
            // Parse "LO:HI" — digits_to_i32 stops at the ':' for LO; slice past
            // the colon for HI.
            var rng: string = a[ai + 1];
            var ci: i32 = 0;
            while (ci < rng.len() && rng[ci] != 58) { ci = ci + 1; }  // 58 = ':'
            pm_lo = util.digits_to_i32(rng);
            if (ci + 1 <= rng.len()) { pm_hi = util.digits_to_i32(rng[ci + 1:rng.len()]); }
            ai = ai + 1;
        }

    // An unrecognised -target is refused rather than emitted for. This driver
    // dispatches by naming the targets it knows and letting everything else
    // reach the x86-64 branch, so a stale or misspelled name used to come back
    // as a successful emit for the WRONG machine — the arm64 leg of #6710 was
    // handed x86-64 text and surfaced as "unknown mnemonic `movq'" from the
    // aarch64 assembler, which reads as a codegen bug rather than a typo.
    if (target != "x86-64-linux" && target != "arm64-linux") {
        eprint("asm_modload_run: unknown -target: " + target + " (want x86-64-linux, arm64-linux)\n");
        return 2;
    }

        else if (entry_path == "") { entry_path = a[ai]; }
        ai = ai + 1;
    }
    // The audit reads only the two records, so it takes no entry file.
    if (paudit) { return provided_audit(); }
    if (entry_path == "") {
        eprint("usage: asm_modload_run <entry.fern> [-verifyprovided | -provided-audit | -ir-probe | -per-module-count | -per-module-needs | -per-module-func-counts | -per-module-manifest | -per-module-emit N [-cache-dir DIR] [-func-range LO:HI] | -per-module-emit-all -out-dir DIR [-func-budget N] [-unit-range LO:HI]] [-assume-eligible]\n");
        return 2;
    }
    var dir: string = modloader.dirname(entry_path);
    match (read_file(entry_path)) {
        Ok(src) => {
            var entry: parser.Module = parser.parse_module(lexer.tokenize(src));
            var loaded: flatten.LoadedModule[] = modloader.load_imports(dir, entry);
            if (pm_mode.len() > 0) {
                return run_per_module(dir, entry_path, entry, loaded, pm_mode, pm_index, pm_extra, cache_dir, pm_lo, pm_hi, target, out_dir, func_budget, unit_lo, unit_hi, assume_eligible);
            }
            var merged: parser.Module = flatten.bundle(entry, loaded);
            merged = modloader.merge_builtins(dir, merged);
            if (vprovided) { return verify_provided_module(merged); }
            if (probe) {
                // Probe the module codegen actually routes on: run the same
                // module_with_builtins pipeline the emit path below uses
                // (monomorphise drops un-instantiated bounded-generic templates
                // like core/cmp's min[T:Ord], whose type-param-receiver call
                // otherwise bails and mis-reports `module: AST` for a program
                // that in fact routes IR — #4374), not the raw merged module.
                write(asm_ir.eligibility_report(asm_ir.lift_lambdas(parser.module_with_builtins(merged))));
                return 0;
            }
            // Hoisted above the arm64 leg so both targets share ONE
            // single-process ceiling; see the measurement note on the x86
            // route below for why 1500 and why function count is only a
            // cheap pre-emit proxy for the real (arena) limit.
            var single_process_max: i32 = 1500;
            if (target == "arm64-linux") {
                // Same single-process over-budget rescue the x86 leg below has:
                // a merged bundle past the 512-function IR budget but small
                // enough for one process routes per-module (each module is under
                // budget -> IR) instead of dropping the whole program to the AST
                // emitter. arm64 lacked this, so the whole band went AST here
                // while x86 served it via IR — the asymmetry that has to close
                // before the arm64 AST emitter can be deleted (#3457 slice 5).
                // Link-verified end to end by TestSelfHostPerModuleConcatArm64;
                // the first attempt (#5937) emitted a dangling __fn_i32__gcd and
                // was reverted, which is why that test asserts through the LINK.
                // The batched spawned path stays x86-only for now.
                var amwb: parser.Module = parser.module_with_builtins(merged);
                var anfuncs: i32 = asm_ir.lift_lambdas(amwb).funcs.len();
                if (anfuncs > 512 || force_spawned) {
                    if (anfuncs < single_process_max && !force_spawned) {
                        var ashaken: parser.Module = treeshake.treeshake(merged);
                        var areach: string[] = [];
                        var ari: i32 = 0;
                        while (ari < ashaken.funcs.len()) { areach = areach.append(ashaken.funcs[ari].name); ari = ari + 1; }
                        var apmc: string = emit_per_module_concat(dir, entry, loaded, areach, "arm64-linux");
                        if (apmc.len() > 0) { write(apmc); return 0; }
                    } else {
                        // ABOVE the single-process ceiling — the whole-compiler
                        // self-compile itself. Was x86-only ("the batched spawned
                        // path stays x86-only for now"), which only worked because
                        // arm64 still had the AST emitter to drop to; removing that
                        // fallback is what makes the batched path required here too.
                        // spawn_batch already threads `-target`, and the arm64
                        // `-per-module-emit` child is the exact path
                        // TestSelfHostModloadPerModuleWholeCompilerArm64 drives, so
                        // this reuses a proven leg rather than adding one.
                        var asrc: i32 = emit_per_module_spawned(dir, entry_path, entry, loaded, target, func_budget, unit_batch, a[0]);
                        if (asrc == 0) { return 0; }
                        if (asrc == 2) {
                            eprint("asm_modload_run: spawned per-module emit failed after writing output\n");
                            return 1;
                        }
                    }
                }
                // IR-or-error (#3457 slice 5) — see asm_load_run's arm64 leg.
                write(asm_arm64_ir.emit_module_or_error(amwb, false));
                return 0;
            }
            // OVER the merged 512-function IR budget: route per-module (each
            // module is under budget → IR) instead of dropping the whole program
            // to the AST emitter (#3457 / #5676's rescue, which asm_load_run had
            // and this driver did not). The lower bound is the budget the merged
            // IR path bails at (asm_ir.emit_module_ir_gated: sm.funcs.len() > 512).
            //
            // Above `single_process_max` a single-process concat exhausts the
            // arena, so the emit is orchestrated across BATCHES of child
            // processes instead (emit_per_module_spawned). Both routes fall back
            // to the AST emitter on failure, so a program that routed AST before
            // still does.
            //
            // The reachable set comes from treeshaking the merged module HERE
            // rather than treeshaking the emit input: pruning is only needed to
            // keep unused stdlib functions (which may use constructs the IR path
            // cannot lower yet) from dragging a module onto the AST emitter. The
            // AST fallback below still sees the untouched merged module, so a
            // program that routed AST before routes AST byte-identically now.
            // MEASURED single-process ceiling (2026-07-29). The 21
            // duplicate-symbol errors a >=1500-function concat used to hit are
            // FIXED (the `.weak`-dedup pair), and at 1958 merged funcs — the
            // stage-2 compiler — the concat assembles, links, and self-hosts a
            // `return 7` program with no memory failure at all. What one process
            // cannot do is the WHOLE-COMPILER self-compile: concatenating it
            // exits 137 on __fern_alloc's arena bounds check (not a host
            // OOM-kill). Function count is a poor proxy for that — 1958 fits,
            // ~2040 does not — because what exhausts the arena is the COMPILE
            // WORKLOAD, not the emitted function count; it stays the switch-over
            // point only because it is the one cheap signal available before any
            // emit happens.
            var mwb: parser.Module = parser.module_with_builtins(merged);
            var nfuncs: i32 = asm_ir.lift_lambdas(mwb).funcs.len();
            if (nfuncs > 512 || force_spawned) {
                if (nfuncs < single_process_max && !force_spawned) {
                    var shaken: parser.Module = treeshake.treeshake(merged);
                    var reach: string[] = [];
                    var ri: i32 = 0;
                    while (ri < shaken.funcs.len()) { reach = reach.append(shaken.funcs[ri].name); ri = ri + 1; }
                    var pmc: string = emit_per_module_concat(dir, entry, loaded, reach, "x86-64-linux");
                    if (pmc.len() > 0) { write(pmc); return 0; }
                } else {
                    var src: i32 = emit_per_module_spawned(dir, entry_path, entry, loaded, target, func_budget, unit_batch, a[0]);
                    if (src == 0) { return 0; }
                    if (src == 2) {
                        eprint("asm_modload_run: spawned per-module emit failed after writing output\n");
                        return 1;
                    }
                }
            }
            // Last resort, and no longer a fallback (#3457 slice 5): a module the
            // batched per-module emit above could not take is an ERROR. The
            // whole-compiler merged bundle lands here, which is why the env-gated
            // merged fixpoints retire with this change — their own header says they
            // "go with" asm.fern.
            write(asm_ir.emit_module_or_error(mwb));
            return 0;
        },
        Err(e) => {
            eprint("asm_modload_run: could not read entry file\n");
            return 1;
        },
    }
    return 3;
}
