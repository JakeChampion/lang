
// util — shared leaf helpers for the self-hosted compiler.
//
// The self-host tree had grown ~9 byte-identical copies of
// i32_to_string (and similar duplicates of digits_to_i32,
// is_all_digits, string-membership, etc. — see SH-020 in
// docs/SELF-HOST-AUDIT.md). This module is the single home for
// those pure, dependency-free helpers; consumer modules
// `import "./util"` and call them qualified (`util.i32_to_string`).
//
// It imports nothing, so any self-host
// module can depend on it without pulling in the lexer/parser. The
// module grows one helper at a time as files are converted off
// their local copies; keeping each conversion small bounds the
// blast radius on the Go-side test staging lists (each test that
// compiles a converted module must also stage util.fern).

// i32_to_string renders a signed 32-bit integer in base 10 — the
// LSB-first digit loop the printer / disassembler / constfold /
// vm / wasm / ssa backends each used to carry their own copy of.
pub function i32_to_string(n: i32): string {
    if (n == 0) { return "0"; }
    // INT32_MIN has no i32 negation (0 - n wraps back to n), so the
    // generic sign flip below would skip the digit loop and render a bare
    // "-". Reachable from const_f64's `.long` halves: an f64 constant
    // whose 32-bit half is exactly 0x80000000 (e.g. 1 + 2^-21) hit this
    // and emitted `.long -, …`, which GNU as rejects.
    if (n < 0 && 0 - n == n) { return "-2147483648"; }
    var neg: boolean = false;
    if (n < 0) { neg = true; n = 0 - n; }
    var out: string = "";
    while (n > 0) {
        var d: i32 = n % 10;
        var c: string = "";
        if (d == 0) { c = "0"; } else if (d == 1) { c = "1"; }
        else if (d == 2) { c = "2"; } else if (d == 3) { c = "3"; }
        else if (d == 4) { c = "4"; } else if (d == 5) { c = "5"; }
        else if (d == 6) { c = "6"; } else if (d == 7) { c = "7"; }
        else if (d == 8) { c = "8"; } else { c = "9"; }
        out = c + out;
        n = n / 10;
    }
    if (neg) { out = "-" + out; }
    return out;
}

// i64_to_string renders a signed 64-bit integer in base 10 — the i64 sibling
// of i32_to_string above, for the readings that are arena-scale and would wrap
// if narrowed (the cliff WEIGHT, the bump high-water mark). Same digit loop,
// same INT64_MIN guard: the minimum has no i64 negation, so the generic sign
// flip would skip the loop and render a bare "-".
pub function i64_to_string(n: i64): string {
    if (n == 0) { return "0"; }
    if (n < 0 && 0 - n == n) { return "-9223372036854775808"; }
    var neg: boolean = false;
    if (n < 0) { neg = true; n = 0 - n; }
    var out: string = "";
    while (n > 0) {
        var d: i64 = n % 10;
        var c: string = "";
        if (d == 0) { c = "0"; } else if (d == 1) { c = "1"; }
        else if (d == 2) { c = "2"; } else if (d == 3) { c = "3"; }
        else if (d == 4) { c = "4"; } else if (d == 5) { c = "5"; }
        else if (d == 6) { c = "6"; } else if (d == 7) { c = "7"; }
        else if (d == 8) { c = "8"; } else { c = "9"; }
        out = c + out;
        n = n / 10;
    }
    if (neg) { out = "-" + out; }
    return out;
}

// hash_key maps a string to a content-addressed key string, used by the
// per-module incremental-codegen cache (#3451 step 6 / #3458) to fingerprint
// a module's compilation inputs (its own source, and the public signatures of
// the modules it calls into). Two independent 30-bit polynomial rolls with
// distinct seeds/multipliers are concatenated, so the effective key space is
// ~60 bits — ample to make an accidental collision (which would silently reuse
// stale codegen) vanishingly unlikely for the module-sized inputs it hashes.
// Masking to 0x3FFFFFFF keeps each roll non-negative so i32_to_string renders
// it without a sign, and makes the result independent of i32 overflow wrap.
pub function hash_key(s: string): string {
    var a: i32 = 208357;
    var b: i32 = 5381;
    var i: i32 = 0;
    while (i < s.len()) {
        var c: i32 = s[i] as i32;
        a = (a * 31 + c + 1) & 1073741823;
        b = (b * 131 + c + 7) & 1073741823;
        i = i + 1;
    }
    // Fold the length in too, so distinct-length inputs that happen to roll to
    // the same accumulators still differ.
    a = (a * 31 + s.len()) & 1073741823;
    b = (b * 131 + s.len()) & 1073741823;
    return i32_to_string(a) + "_" + i32_to_string(b);
}

// hash_bucket maps a string to a bucket index in [0, n). It is hash_key's first
// polynomial roll, kept numeric: hash_key concatenates two rolls into a string,
// which is right for a content fingerprint and wrong for an index — a caller
// that only wants a bucket would pay a string build and a parse per probe.
// Masking to 0x3FFFFFFF keeps the accumulator non-negative, so the `%` cannot
// return a negative index.
pub function hash_bucket(s: string, n: i32): i32 {
    if (n <= 1) { return 0; }
    var a: i32 = 208357;
    var i: i32 = 0;
    while (i < s.len()) {
        a = (a * 31 + (s[i] as i32) + 1) & 1073741823;
        i = i + 1;
    }
    a = (a * 31 + s.len()) & 1073741823;
    return a % n;
}

// digits_to_i32 parses a leading optional `-` then a run of decimal
// digits, stopping at the first non-digit. The canonical sign-aware
// version — several self-host copies were sign-naive (SH-010).
//
// lit_to_i32 parses an integer LITERAL's source text to its i32 value,
// honouring a `0x`/`0X` hex or `0b`/`0B` binary prefix (and a leading `-`);
// plain decimal falls through to digits_to_i32. Accumulation is i32, so a
// full-u32-range literal (`0xffffffff`) wraps to the matching signed i32 bit
// pattern (-1) — the same low-32-bit value the AST path's assembler produces.
// Used where a numeric VALUE is needed (the IR interpreter); the AOT backends
// splice op_const_i32_text's source text into an assembler literal and never
// call this. (asm_arm64_ir's movz_text_ok reaches for digits_to_i32 directly,
// precisely because it must detect the wrap and the early stop rather than
// inherit them — see its round-trip guard.)
pub function lit_to_i32(s: string): i32 {
    if (s.len() == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == b'-') { neg = true; start = 1; }
    if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'x' || s[start + 1] == b'X')) {
        var acc: i32 = 0;
        var i: i32 = start + 2;
        while (i < s.len()) {
            var b: i32 = s[i] as i32;
            var d: i32 = 0 - 1;
            if (b >= 48 && b <= 57) { d = b - 48; }
            else if (b >= 97 && b <= 102) { d = b - 97 + 10; }
            else if (b >= 65 && b <= 70) { d = b - 65 + 10; }
            if (d < 0) { break; }
            acc = acc * 16 + d;
            i = i + 1;
        }
        if (neg) { return 0 - acc; }
        return acc;
    }
    if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'b' || s[start + 1] == b'B')) {
        var bacc: i32 = 0;
        var bi: i32 = start + 2;
        while (bi < s.len()) {
            var bb: i32 = s[bi] as i32;
            if (bb != 48 && bb != 49) { break; }
            bacc = bacc * 2 + (bb - 48);
            bi = bi + 1;
        }
        if (neg) { return 0 - bacc; }
        return bacc;
    }
    return digits_to_i32(s);
}

// lit_to_i64 is the i64-accumulating sibling of lit_to_i32: same `0x`/`0X`,
// `0b`/`0B` and leading-`-` handling, but accumulating in 64 bits so a literal
// past i32 range (`4294967295`, the u32 maximum) keeps its value instead of
// wrapping to the matching signed i32 bit pattern. constfold reads literals
// through this one, because it has to decide whether a value fits its declared
// width and cannot do that from an already-wrapped number.
pub function lit_to_i64(s: string): i64 {
    if (s.len() == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == b'-') { neg = true; start = 1; }
    if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'x' || s[start + 1] == b'X')) {
        var acc: i64 = 0;
        var i: i32 = start + 2;
        while (i < s.len()) {
            var b: i32 = s[i] as i32;
            var d: i32 = 0 - 1;
            if (b >= 48 && b <= 57) { d = b - 48; }
            else if (b >= 97 && b <= 102) { d = b - 97 + 10; }
            else if (b >= 65 && b <= 70) { d = b - 65 + 10; }
            if (d < 0) { break; }
            acc = acc * 16 + (d as i64);
            i = i + 1;
        }
        if (neg) { return 0 - acc; }
        return acc;
    }
    if (start + 1 < s.len() && s[start] == b'0' && (s[start + 1] == b'b' || s[start + 1] == b'B')) {
        var bacc: i64 = 0;
        var bi: i32 = start + 2;
        while (bi < s.len()) {
            var bb: i32 = s[bi] as i32;
            if (bb != 48 && bb != 49) { break; }
            bacc = bacc * 2 + ((bb - 48) as i64);
            bi = bi + 1;
        }
        if (neg) { return 0 - bacc; }
        return bacc;
    }
    return digits_to_i64(s);
}

pub function digits_to_i32(s: string): i32 {
    if (s.len() == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == b'-') { neg = true; start = 1; }
    var acc: i32 = 0;
    var i: i32 = start;
    while (i < s.len()) {
        var b: i32 = s[i] as i32;
        if (b < 48 || b > 57) {
            if (neg) { return 0 - acc; }
            return acc;
        }
        acc = acc * 10 + (b - 48);
        i = i + 1;
    }
    if (neg) { return 0 - acc; }
    return acc;
}

// digits_to_i64 is the i64-accumulating sibling of digits_to_i32: leading
// optional `-` then a run of decimal digits, accumulating in 64 bits so a
// decimal literal beyond i32 range (`5000000000`) survives instead of
// wrapping. The interpreter uses it for i64 values that don't fit a VInt.
pub function digits_to_i64(s: string): i64 {
    if (s.len() == 0) { return 0; }
    var neg: boolean = false;
    var start: i32 = 0;
    if (s[0] == b'-') { neg = true; start = 1; }
    var acc: i64 = 0;
    var i: i32 = start;
    while (i < s.len()) {
        var b: i32 = s[i] as i32;
        if (b < 48 || b > 57) {
            if (neg) { return 0 - acc; }
            return acc;
        }
        acc = acc * 10 + ((b - 48) as i64);
        i = i + 1;
    }
    if (neg) { return 0 - acc; }
    return acc;
}

// is_all_digits reports whether `s` is a non-empty run of ASCII
// decimal digits (no sign, no separators).
pub function is_all_digits(s: string): boolean {
    if (s.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < s.len()) {
        var b: i32 = s[i] as i32;
        if (b < 48 || b > 57) { return false; }
        i = i + 1;
    }
    return true;
}

// has_str reports whether the string array `xs` contains `s`
// (linear scan). The single home for the membership helper that
// existed as has_str / name_in / name_in_list / contains_name.
pub function has_str(xs: string[], s: string): boolean {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == s) { return true; }
        i = i + 1;
    }
    return false;
}

// base_type_name returns the type name with any generic args / array
// suffix stripped — i.e. the prefix before the first `[`. The single
// home for what was base_type_name / type_base / strip_generic_args.
pub function base_type_name(t: string): string {
    var i: i32 = 0;
    while (i < t.len()) {
        if (t[i] == b'[') { return t[0:i] + ""; }
        i = i + 1;
    }
    return t;
}

// mangled_module returns the bundle prefix of a mangled name
// (`io__read_all` -> `io`), or "" for an unmangled entry-module name. A
// leading `__` (a lifted lambda, `__lam_0`) is not a module prefix.
pub function mangled_module(name: string): string {
    var i: i32 = 1;
    while (i + 1 < name.len()) {
        if (name[i] == b'_' && name[i + 1] == b'_') { return name[0:i] + ""; }
        i = i + 1;
    }
    return "";
}

// mangled_name returns a mangled name's own half (`io__read_all` ->
// `read_all`), or the name unchanged when it carries no module prefix.
pub function mangled_name(name: string): string {
    var i: i32 = 1;
    while (i + 1 < name.len()) {
        if (name[i] == b'_' && name[i + 1] == b'_') { return name[i + 2 : name.len()] + ""; }
        i = i + 1;
    }
    return name;
}

// str_less is byte-wise `<` on strings, for the deterministic orders the
// capability report and its diagnostics are compared on. A prefix sorts
// before what extends it.
pub function str_less(a: string, b: string): boolean {
    var n: i32 = a.len();
    if (b.len() < n) { n = b.len(); }
    var i: i32 = 0;
    while (i < n) {
        if (a[i] != b[i]) { return a[i] < b[i]; }
        i = i + 1;
    }
    return a.len() < b.len();
}

// index_of_str returns the index of `s` in `xs`, or -1 if absent.
// Canonical -1-on-miss (ssa_wasm previously returned 0, which silently
// resolved a missing funcaddr to table slot 0 — SH-007).
pub function index_of_str(xs: string[], s: string): i32 {
    var i: i32 = 0;
    while (i < xs.len()) {
        if (xs[i] == s) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// contains reports whether `needle` occurs in `haystack` (substring
// search; empty needle matches). literate.fern keeps its own copy — it
// is a standalone module not staged through util.
pub function contains(haystack: string, needle: string): boolean {
    if (needle.len() == 0) { return true; }
    if (haystack.len() < needle.len()) { return false; }
    var i: i32 = 0;
    while (i <= haystack.len() - needle.len()) {
        if (haystack[i:i + needle.len()] == needle) { return true; }
        i = i + 1;
    }
    return false;
}

// parse_f64_bits converts a decimal float spelling to the i64 IEEE-754
// bit pattern of the nearest double (round-to-nearest, ties-to-even). It
// exists so the codegen emitters can lay down EXACT f64 bits (`.long`
// halves) instead of a decimal `.double` directive, whose rounding is at
// the mercy of the downstream assembler — GNU `as`, for one, rounds ties
// half-UP, so a literal on a ULP tie (e.g. 9007199254740993.0 = 2^53+1)
// gets the wrong bits. Emitting the bits directly makes float output
// assembler-independent (#5434, the emit-side sibling of SH-004).
//
// Method — the classic exact decimal-shift algorithm (a digit buffer with
// a movable decimal point, halved/doubled in grade-school decimal, as in
// Go's strconv/decimal.go): collect the significant digits D so the value
// is 0.D × 10^dp; binary-normalize into [0.5, 1) by exact ÷2/×2 counting
// the binary exponent; pull the mantissa bits by repeated ×2 (the carry
// out of the integer place is the next bit); round on the next bit + a
// sticky flag.
//
// D is capped at 800 digits, which is what makes dropping the rest into the
// sticky bit safe: an exact ULP tie needs at most 751 significant decimal
// digits anywhere in the binary64 range (the smallest, 2^-1075, is
// 5^1075 / 10^1075), so an input with a non-zero digit past 800 cannot be a
// tie and rounding up off the round bit is correct. A smaller cap decides
// long ties by truncation instead, which loses them by 1 ULP.
//
// This is the copy reached by an import: the IR emitters (asm_ir /
// asm_arm64_ir) and the interpreter's float literal reader. The three
// assemblers keep standalone copies (watbin.parse_f64_bits,
// x86_gas_parse_f64, arm64_parse_f64) because they are deliberately
// import-free; TestSelfHostParseF64MirrorsAgree holds all four identical.
pub function parse_f64_bits(s: string): i64 {
    var i: i32 = 0;
    var neg: boolean = false;
    if (s.len() > 0 && s[0] == b'-') { neg = true; i = 1; }
    else if (s.len() > 0 && s[0] == b'+') { i = 1; }
    var signbit: i64 = 0;
    if (neg) { var one: i64 = 1; signbit = one << 63; }
    var digits: i32[] = [];
    var dp: i32 = 0;
    var sticky: boolean = false;
    var started: boolean = false;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
        var d: i32 = (s[i] as i32) - 48;
        if (started || d != 0) {
            started = true;
            if (digits.len() < 800) { digits = digits.append(d); }
            else { if (d != 0) { sticky = true; } }
            dp = dp + 1;
        }
        i = i + 1;
    }
    if (i < s.len() && s[i] == b'.') {
        i = i + 1;
        while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
            var fd: i32 = (s[i] as i32) - 48;
            if (started || fd != 0) {
                started = true;
                if (digits.len() < 800) { digits = digits.append(fd); }
                else { if (fd != 0) { sticky = true; } }
            } else {
                dp = dp - 1;                // leading fraction zero shifts the point
            }
            i = i + 1;
        }
    }
    if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
        i = i + 1;
        var eneg: boolean = false;
        if (i < s.len() && s[i] == b'-') { eneg = true; i = i + 1; }
        else if (i < s.len() && s[i] == b'+') { i = i + 1; }
        var exp: i32 = 0;
        while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
            if (exp < 100000) { exp = exp * 10 + ((s[i] as i32) - 48); }
            i = i + 1;
        }
        if (eneg) { dp = dp - exp; } else { dp = dp + exp; }
    }
    while (digits.len() > 0 && digits[digits.len() - 1] == 0) {
        digits = pf64_sub(digits, 0, digits.len() - 1);
    }
    if (digits.len() == 0) { return signbit; }          // ±0.0
    if (dp > 310) { var inf: i64 = 2047; return signbit | (inf << 52); }
    if (dp < 0 - 350) { return signbit; }
    var bexp: i32 = 0;
    while (dp > 0) {
        var hb: i32[] = pf64_div2(digits);
        if (hb.len() > 0 && hb[0] == 0) {
            digits = pf64_sub(hb, 1, hb.len());
            dp = dp - 1;
        } else {
            digits = hb;
        }
        bexp = bexp + 1;
        while (digits.len() > 0 && digits[digits.len() - 1] == 0) { digits = pf64_sub(digits, 0, digits.len() - 1); }
    }
    while (dp < 0 || (digits.len() > 0 && digits[0] < 5)) {
        var db: i32[] = pf64_mul2(digits);
        if (db[0] != 0) {
            digits = db;
            dp = dp + 1;
        } else {
            digits = pf64_sub(db, 1, db.len());
        }
        bexp = bexp - 1;
        while (digits.len() > 0 && digits[digits.len() - 1] == 0) { digits = pf64_sub(digits, 0, digits.len() - 1); }
        if (digits.len() == 0) { return signbit; }
    }
    var e: i32 = bexp + 1022;
    if (e >= 2047) { var inf2: i64 = 2047; return signbit | (inf2 << 52); }
    var nbits: i32 = 53;
    if (e <= 0) { nbits = 52 + e; }
    if (nbits < 0) { return signbit; }
    var mant: i64 = 0;
    var k2: i32 = 0;
    while (k2 < nbits) {
        var mb: i32[] = pf64_mul2(digits);
        mant = mant * 2 + (mb[0] as i64);
        digits = pf64_sub(mb, 1, mb.len());
        k2 = k2 + 1;
    }
    var rb: i32[] = pf64_mul2(digits);
    var roundbit: i32 = rb[0];
    var rest: i32[] = pf64_sub(rb, 1, rb.len());
    var st: boolean = sticky || !pf64_all_zero(rest);
    if (roundbit == 1 && (st || (mant & 1) == 1)) { mant = mant + 1; }
    if (e <= 0) {
        return signbit | mant;
    }
    var full: i64 = 1;
    full = full << 53;
    if (mant == full) {
        mant = mant / 2;
        e = e + 1;
        if (e >= 2047) { var inf3: i64 = 2047; return signbit | (inf3 << 52); }
    }
    var hidden: i64 = 1;
    hidden = hidden << 52;
    return signbit | ((e as i64) << 52) | (mant - hidden);
}

// f64_lit_out_of_range reports whether the float-literal spelling `s` has a
// magnitude f64 cannot hold: parse_f64_bits clamped it to ±Inf, so the
// exponent field is all ones. Native's parser turns exactly this case
// (strconv.ParseFloat's ErrRange) into P002, and the self-host front end has
// to reject it too instead of compiling the literal as +Inf (#6842).
//
// Underflow is NOT out of range on either side: strconv returns a subnormal or
// ±0 with no error there, so `1e-400` is accepted by both engines.
pub function f64_lit_out_of_range(s: string): boolean {
    if (!f64_lit_reaches_1e309(s)) { return false; }
    var expmask: i64 = 2047;
    return ((parse_f64_bits(s) >> 52) & expmask) == expmask;
}

// f64_lit_reaches_1e309 is an allocation-free pre-filter for the above: the
// value is below 10^(integer digits + exponent), so a literal whose sum falls
// short of 309 is inside f64's range without asking the exact parser, which
// builds digit arrays. Every float literal in every parsed module runs this
// one, and only the handful that could actually overflow run that one.
function f64_lit_reaches_1e309(s: string): boolean {
    var i: i32 = 0;
    if (i < s.len() && (s[i] == b'-' || s[i] == b'+')) { i = i + 1; }
    while (i < s.len() && s[i] == b'0') { i = i + 1; }         // leading zeros add no magnitude
    var intdigits: i32 = 0;
    while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') { intdigits = intdigits + 1; i = i + 1; }
    if (i < s.len() && s[i] == b'.') {
        i = i + 1;
        while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') { i = i + 1; }
    }
    var exp: i32 = 0;
    if (i < s.len() && (s[i] == b'e' || s[i] == b'E')) {
        i = i + 1;
        var eneg: boolean = false;
        if (i < s.len() && s[i] == b'-') { eneg = true; i = i + 1; }
        else if (i < s.len() && s[i] == b'+') { i = i + 1; }
        while (i < s.len() && s[i] >= b'0' && s[i] <= b'9') {
            if (exp < 100000) { exp = exp * 10 + ((s[i] as i32) - 48); }
            i = i + 1;
        }
        if (eneg) { exp = 0 - exp; }
    }
    return intdigits + exp >= 309;
}

// f64_range_kind / is_f64_range_kind / f64_range_message are the marker
// protocol for an out-of-range float literal. The self-host parser has no
// error list, so it plants an ExprUnknown carrying this kind: every consumer
// already rejects a parser-side unknown, and the prefix lets the checker and
// the asm front end name it P002 with the offending spelling rather than the
// generic P001. (Native's message appends the Go strconv error text; the
// self-host has no strconv, so it stops at the cause.)
function f64_range_prefix(): string { return "float literal out of range: "; }
pub function f64_range_kind(text: string): string { return f64_range_prefix() + text; }
pub function is_f64_range_kind(kind: string): boolean {
    var pre: string = f64_range_prefix();
    if (kind.len() < pre.len()) { return false; }
    return kind[0:pre.len()] == pre;
}
pub function f64_range_message(kind: string): string {
    var pre: string = f64_range_prefix();
    return "invalid float literal \"" + kind[pre.len():kind.len()] + "\": value out of range";
}

// pf64_div2 halves the fraction buffer 0.B (grade-school left-to-right).
function pf64_div2(b: i32[]): i32[] {
    var out: i32[] = [];
    var r: i32 = 0;
    var i: i32 = 0;
    while (i < b.len()) {
        var cur: i32 = r * 10 + b[i];
        out = out.append(cur / 2);
        r = cur % 2;
        i = i + 1;
    }
    if (r != 0) { out = out.append(5); }
    return out;
}

// pf64_mul2 doubles the fraction buffer 0.B; the carry out of the front
// (0 or 1) is prepended as the first element for the caller to split off.
function pf64_mul2(b: i32[]): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < b.len()) { out = out.append(0); i = i + 1; }
    var carry: i32 = 0;
    var j: i32 = b.len() - 1;
    while (j >= 0) {
        var cur: i32 = b[j] * 2 + carry;
        out = out.with(j, cur % 10);
        carry = cur / 10;
        j = j - 1;
    }
    var res: i32[] = [carry];
    var k: i32 = 0;
    while (k < out.len()) { res = res.append(out[k]); k = k + 1; }
    return res;
}

// pf64_sub returns b[from : upto) as a fresh array.
function pf64_sub(b: i32[], from: i32, upto: i32): i32[] {
    var out: i32[] = [];
    var i: i32 = from;
    while (i < upto) { out = out.append(b[i]); i = i + 1; }
    return out;
}

// pf64_all_zero reports whether every digit in b is zero.
function pf64_all_zero(b: i32[]): boolean {
    var i: i32 = 0;
    while (i < b.len()) {
        if (b[i] != 0) { return false; }
        i = i + 1;
    }
    return true;
}

// RC_UNDERFLOW_EXIT is the exit code a driver reports when its own heap
// accounting is broken — distinct from 0 (clean) and 1 (a compile error in
// the input program), so a harness cannot read the failure as either.
pub const RC_UNDERFLOW_EXIT: i32 = 120;

// rc_underflow_guard passes `code` through when the process-wide rc
// over-release counter is clean, and turns a non-zero reading into a loud
// failure.
//
// The counter (__rc_underflow_count — the Phase 3 detector, bumped by every
// __fern_rc_dec that finds rc <= 0) has existed on all three backends for a
// long time and NOTHING ran it. That is what let #6021 sit latent on main: a
// compiler that over-releases one of its OWN blocks usually still emits
// correct output — the doubly-freed block is recycled harmlessly — so the
// damage surfaces as a segfault in some unrelated later build, once an
// innocuous change shifts allocation sizes enough for the poisoned freelist
// head to be popped. It presented as "adding a field to LowerState breaks the
// compiler", ~50% of runs, and the per-module fixpoint, all 335 fixtures and
// the native suite were green throughout.
//
// So the drivers check themselves, on every run, in every configuration: a
// corrupted freelist is reported where it happened rather than diagnosed
// weeks later somewhere else. Zero cost on the healthy path (one BSS load and
// a branch), and no output change — the message only ever appears on a build
// that is already broken.
pub function rc_underflow_guard(who: string, code: i32): i32 {
    var n: i32 = __rc_underflow_count();
    if (n == 0) { return code; }
    eprint(who + ": internal error: rc over-release detected (" + i32_to_string(n) + " dec(s) on an already-released block)\n");
    return RC_UNDERFLOW_EXIT;
}

// arr_push_cliff_report prints the process-wide rc==1 append-cliff count to
// stderr when FERN_CLIFF_REPORT is set, and passes `code` through unchanged.
//
// This is the compiler's own dose of the medicine #6023 built for compiled
// PROGRAMS. __fern_arr_push_grow mutates in place only at rc == 1, so a stray
// retain upstream makes every append in a threaded accumulator copy the whole
// buffer — correct output, quadratic bytes moved. The counter reports the
// appends that copied a buffer which still had SPARE CAPACITY, i.e. the copies
// bought by a reference rather than by a full buffer.
//
// Deliberately a REPORT, not a guard. rc_underflow_guard above turns a
// non-zero reading into a failure because an over-release is never legitimate;
// a cliff crossing sometimes is (a genuinely shared buffer must copy), so a
// non-zero count here is a number to compare across builds, not a verdict.
// Hence opt-in via the environment and no effect on the exit code — a run
// without FERN_CLIFF_REPORT is byte-identical in behaviour and output.
//
// Why this exists: wall-clock cannot resolve this. Timing the self-host
// compiler per module on a 4-core box gave a ~27% spread run-to-run, which
// swamped the effect of #6043 entirely and produced an apparent 16% "win" on
// one module that five repetitions showed to be sampling noise. The counter is
// exact and host-independent — the same argument docs/TEST-GATES.md makes for
// __heap_bump_bytes() over peak RSS — so it is the instrument any accumulator
// work should be measured with. See #6056.
pub function arr_push_cliff_report(who: string, code: i32): i32 {
    match (env("FERN_CLIFF_REPORT")) {
        Some(_) => {
            var copied: i64 = __arr_push_shared_bytes();
            eprint(who + ": arr_push_shared_count=" + i32_to_string(__arr_push_shared_count())
                + " arr_push_shared_bytes=" + i64_to_string(copied) + "\n");
            return code;
        },
        None => { return code; }
    }
}

// str_join_range concatenates parts[lo..hi) by balanced divide-and-conquer.
// A left fold (out = out + parts[i]) copies the whole accumulator on every
// append → O(total²) when emitting a large program; this splits the range in
// half and merges, so each of the log n levels copies O(total) → O(total·log n)
// overall. (Array push is amortised O(1), but string concat is O(len), so the
// emit hot path collects chunks in a string[] and joins once through here.)
pub function str_join_range(parts: string[], lo: i32, hi: i32): string {
    var n: i32 = hi - lo;
    if (n <= 0) { return ""; }
    if (n == 1) { return parts[lo]; }
    var mid: i32 = lo + n / 2;
    return str_join_range(parts, lo, mid) + str_join_range(parts, mid, hi);
}

pub function str_join_chunks(parts: string[]): string {
    return str_join_range(parts, 0, parts.len());
}

// Diag is a coded diagnostic — the stable `E0XX` code (matching the Go
// checker's `internal/checker` codes) plus a human message and an
// optional 1-based source position (line/col, 0 when no position is
// available yet). Positions are being threaded through the AST node by
// node; a diagnostic emitted from a node that already carries a position
// renders `line:col: error[E0XX]: …` like the Go checker, the rest still
// render `error[E0XX]: …`. See docs/SELFHOST-CHECKER-PORT.md.
pub struct Diag { code: string, message: string, line: i32, col: i32 }

// is_diagnostic_code reports whether `code` is a real diagnostic code: `E` or
// `P` followed by three digits. The checker also emits the pseudo-code "type"
// (ill_typed_hint's marker for an expression it cannot represent yet, #4346)
// and leaves `code` empty on the uncoded diagnostics. Neither states that the
// program is wrong, so neither can reject a build.
pub function is_diagnostic_code(code: string): boolean {
  if (code.len() != 4) { return false; }
  var head: i32 = (code[0] as i32);
  if (head != 69 && head != 80) { return false; }
  var i: i32 = 1;
  while (i < 4) {
    var b: i32 = (code[i] as i32);
    if (b < 48 || b > 57) { return false; }
    i = i + 1;
  }
  return true;
}

// format_diags renders diagnostics one-per-line as
// `error[CODE]: message (line:col)` — the self-host counterpart of the Go
// driver's diag.Format. Used by the checking drivers to surface a rejection
// to stderr before exiting non-zero (bootstrap error-reporting).
pub function format_diags(diags: Diag[]): string {
  var out: string = "";
  var i: i32 = 0;
  while (i < diags.len()) {
    var d: Diag = diags[i];
    out = out + "error[" + d.code + "]: " + d.message + " (" + i32_to_string(d.line) + ":" + i32_to_string(d.col) + ")\n";
    i = i + 1;
  }
  return out;
}

// append_diags concatenates two diagnostic lists.
pub function append_diags(a: Diag[], b: Diag[]): Diag[] {
  var i: i32 = 0;
  while (i < b.len()) {
    a = a.append(b[i]);
    i = i + 1;
  }
  return a;
}

// dunder_at returns the index of the module-mangling `__` in name, or -1.
// Index 0 never counts: a leading `__` marks a compiler-internal name, not
// a module prefix.
pub function dunder_at(name: string): i32 {
  var i: i32 = 1;
  while (i + 1 < name.len()) {
    if (name[i:i + 2] == "__") { return i; }
    i = i + 1;
  }
  return 0 - 1;
}

// demangle turns a module-mangled name back into the `mod.Name` the reader
// wrote. `mod__Name` is not a spelling anyone can type, so a hint carrying
// one names a fix that does not compile.
pub function demangle(name: string): string {
  var cut: i32 = dunder_at(name);
  if (cut < 0) { return name; }
  return name[0:cut] + "." + name[cut + 2:name.len()];
}

// derive_hint renders the "add `@derive(…)` (or `impl … for T`)" clause
// the derive hints share. `derive` is the attribute spelling and `trait`
// the trait for the impl form, "" to offer the derive alone.
//
// A type from ANOTHER module takes neither route where the reader is
// standing: `@derive` annotates the declaration, and an impl of a foreign
// trait for a foreign type is an orphan impl. So the hint names the
// declaring module instead of two spellings that both fail. Kept in
// lockstep with the native checker's deriveHint, which the message-text
// differential compares against.
pub function derive_hint(tn: string, derive: string, trait_name: string): string {
  var cut: i32 = dunder_at(tn);
  var routes: string = "`@derive(" + derive + ")`";
  if (cut < 0) {
    if (trait_name.len() > 0) {
      routes = routes + " (or `impl " + trait_name + " for " + tn + "`)";
    }
    return "add " + routes + ", which requires `import \"core/cmp\";`";
  }
  var orphan: string = "";
  if (trait_name.len() > 0) {
    routes = routes + " (or `impl " + trait_name + " for " + tn[cut + 2:tn.len()] + "`)";
    orphan = " (an impl written here instead would be an orphan impl)";
  }
  return "add " + routes + " in module `" + tn[0:cut] + "`, which declares it and needs `import \"core/cmp\";` there" + orphan;
}
