// variant_enum_owner returns the enum a variant struct belongs to
// (StructDecl.enum_owner, set when the parser desugars an enum's variants),
// or "" if `name` isn't a known enum variant. Lets the IR path recover a
// freshly-constructed variant's enum type for `<Enum>.<method>` dispatch.
pub function variant_enum_owner(structs: parser.StructDecl[], name: string): string {
    var vi: i32 = 0;
    while (vi < structs.len()) {
        if (structs[vi].name == name) { return structs[vi].enum_owner; }
        vi = vi + 1;
    }
    return "";
}

// expr_enum_type returns the enum type an expression evaluates to when it is a
// variant CONSTRUCTION (`Has(x)` — a call to a variant name) or a bare unit
// variant (`A`, not a local), else "". Used to dispatch a method called
// directly on a freshly-constructed variant (`Has(5).eq(…)`) to
// `<Enum>.<method>`; an enum value held in a LOCAL is already typed via the
// slot's struct_type, so this only covers the fresh-construction receiver.
pub function expr_enum_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return variant_enum_owner(s.structs, id.name); },
                // Qualified payload construction `Enum.Variant(args)` — the
                // variant is the field, confirmed against the bare enum name.
                parser.ExprFieldAccess(cfa) => { return qualified_variant_enum(cfa, s); },
                _ => { return ""; }
            }
        },
        parser.ExprIdent(id) => {
            if (s.slot_of(id.name) < 0) { return variant_enum_owner(s.structs, id.name); }
            return "";
        },
        // Qualified UNIT variant `Enum.Variant` (no call) — e.g. `Dir.N`. Without
        // this an unannotated `var d = Dir.N` left d untyped, so `d.method()` and
        // `Dir.N.method()` couldn't dispatch to `<Enum>.<method>` and bailed to AST.
        parser.ExprFieldAccess(fa) => { return qualified_variant_enum(fa, s); },
        _ => { return ""; }
    }
    return "";
}

// qualified_variant_enum resolves `Enum.Variant` (a field access whose field is
// a variant and whose object is the bare owning enum name, not a local) to the
// enum name, else "".
function qualified_variant_enum(fa: parser.ExprFieldAccess, s: LowerState): string {
    var owner: string = variant_enum_owner(s.structs, fa.field);
    if (owner == "") { return ""; }
    match (fa.obj) {
        parser.ExprIdent(eid) => {
            if (eid.name == owner && s.slot_of(eid.name) < 0) { return owner; }
        },
        _ => {}
    }
    return "";
}

// ---- struct decl helpers -----------------------------------------------
// The core lookups take the decl array directly (so lower_func can use them
// while building its initial state); the LowerState methods delegate.
// decl_field_index returns a field's position in DECL order (-1 if absent);
// decl_is_struct reports whether `name` is a declared struct.
pub function decl_is_struct(structs: parser.StructDecl[], name: string): boolean {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return true; }
        i = i + 1;
    }
    return false;
}

pub function decl_field_index(structs: parser.StructDecl[], struct_name: string, field: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            var fi: i32 = 0;
            while (fi < structs[i].fields.len()) {
                if (structs[i].fields[fi].name == field) { return fi; }
                fi = fi + 1;
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// decl_is_leaksafe reports whether every field is an i32/boolean OR a string.
// These are all leak-only types in the IR path — strings are never freed, so a
// struct holding one keeps a valid reference for the program's life — so such a
// struct needs NO reference counting (matching the AST path's exit codes; the
// boxes leak). Array / nested-struct / tuple fields would be RC-tracked (freed),
// so a struct holding one needs construction retains + drop release — deferred.
// is_scalar_array_type reports whether `t` is a scalar-element array (i32[] /
// boolean[]) — leak-only-safe as a struct field: indexing yields an i32, and the
// array (a fresh literal at construction) leaks with the struct (never freed),
// so no reference counting is needed. String / struct element arrays need
// element tracking (their elements are heap values), so they stay deferred.
pub function is_scalar_array_type(t: string): boolean {
    return t == "i32[]" || t == "boolean[]";
}

// is_leaksafe_array_field reports whether `t` is an array type that is leak-safe
// AS A STRUCT FIELD: the scalar-element arrays (i32[]/boolean[]) plus the 8-byte-
// element f64[]/i64[]. All store a pointer in the field slot, are owned by the
// struct (a fresh array literal at construction — is_scalar_arr_field_access bails
// the aliasing forms), and are deep-dropped on the struct's reclamation. NOT used
// for enum payloads (those need the element-width mark, not a plain mark_arr).
pub function is_leaksafe_array_field(t: string): boolean {
    return is_scalar_array_type(t) || t == "f64[]" || t == "i64[]";
}

// is_map_type_name reports whether `t` is a Map[K, V] type. Maps are leak-only
// on the IR path (the exit sweep tracks local_is_arr, not local_map_type — a map
// box is never freed), so a Map-typed struct field leaks with the struct like a
// string / Option / tuple / enum field: no RC, no aliasing bail. Reading the
// field into a `var m: Map[K, V] = c.m` local re-marks the map type from the
// annotation, so the map's get/insert/has/... dispatch keeps working.
pub function is_map_type_name(t: string): boolean {
    return t.len() >= 5 && t[0:4] == "Map[";
}

// is_scalar_arr_field_access reports whether `e` reads a scalar-array struct
// field (`v.items` where items: i32[]). Such an array lives inside the struct
// (which leaks), so binding/returning/assigning it would create an alias the
// IR path can't retain (leak-only) — but the AST path DOES retain. To avoid
// regressing that RC behaviour, those alias-creating uses bail to the AST
// emitter; only direct reads (`v.items[i]`, `v.items.len()`) stay in the IR
// (neither path retains there).
// is_struct_array_field_type: a `X[]` where X is a leaf-safe struct (array-of-
// struct field). Admitted to the IR path (construction + `f[i].field` read) but
// NOT deep-dropped yet — the array and its struct elements leak with the struct (a
// recursive-drop follow-up); aliasing it (bind / return / assign) bails, like the
// scalar-array fields, so the leak-only IR never creates a dangling second owner.
pub function is_struct_array_field_type(structs: parser.StructDecl[], t: string): boolean {
    var n: i32 = t.len();
    if (n < 3) { return false; }
    if (t[n - 2 : n] != "[]") { return false; }
    // Element leaf-safety is guaranteed by the leaksafe gate (decl_is_leaksafe_d,
    // depth-bounded) before any struct admitting this field reaches the IR path, so
    // this only needs to recognise the struct-array shape (no recursion → no cycle).
    return decl_is_struct(structs, t[0 : n - 2]);
}

// is_enum_array_field_type: a `C[]` where C is a (nominal) enum (array-of-enum
// field). Like the array-of-struct field it is admitted to the IR path in leak
// mode (the array + its enum boxes leak with the struct) and bailed in the
// alias-creating positions (bind / return / assign), so the leak-only IR never
// creates a dangling second owner.
pub function is_enum_array_field_type(structs: parser.StructDecl[], t: string): boolean {
    var n: i32 = t.len();
    if (n < 3) { return false; }
    if (t[n - 2 : n] != "[]") { return false; }
    return is_enum_like_name(t[0 : n - 2], structs);
}

// is_leaksafe_payload reports whether a payload type is a leak-safe scalar/string.
function is_leaksafe_payload(p: string): boolean {
    return p == "i32" || p == "boolean" || p == "string" || p == "i64" || p == "f64";
}

// is_leaksafe_opt_field: an Option[T] / Result[T, E] field whose payload type(s)
// are leak-safe scalars/strings. Options/Results are leak-only on the IR path (the
// exit sweep never frees them), so such a field needs no RC / aliasing bail — it
// leaks with the struct, like a string field. Struct / nested-generic payloads are
// deferred (they would need payload-type recovery through the field).
pub function is_leaksafe_opt_field(t: string): boolean {
    var n: i32 = t.len();
    if (n < 9) { return false; }
    if (t[0:7] == "Option[") { return is_leaksafe_payload(opt_payload_type(t, "Some")); }
    if (t[0:7] == "Result[") {
        return is_leaksafe_payload(opt_payload_type(t, "Ok")) && is_leaksafe_payload(opt_payload_type(t, "Err"));
    }
    return false;
}

// tuple_type_elem_tag parses a tuple type string "(t0, t1, …)" → element n's tag
// (top-level-comma split, so nested brackets don't confuse it), or "" if not a
// tuple / n is out of range.
pub function tuple_type_elem_tag(t: string, n: i32): string {
    var len: i32 = t.len();
    if (len < 3 || t[0:1] != "(" || t[len - 1 : len] != ")") { return ""; }
    var inner: string = t[1 : len - 1];
    var depth: i32 = 0;
    var start: i32 = 0;
    var idx: i32 = 0;
    var i: i32 = 0;
    while (i <= inner.len()) {
        if (i == inner.len() || (depth == 0 && inner[i] == 44)) {   // end, or top-level ','
            if (idx == n) { return trim_spaces(inner[start : i]); }
            idx = idx + 1;
            start = i + 1;
        } else {
            var ch: i32 = inner[i];
            if (ch == 91 || ch == 40) { depth = depth + 1; }       // '[' '('
            else if (ch == 93 || ch == 41) { depth = depth - 1; }  // ']' ')'
        }
        i = i + 1;
    }
    return "";
}

// is_leaksafe_tuple_field: a tuple field "(t0, …)" whose elements are all leak-safe
// scalars/strings. Tuples are leak-only on the IR path (the exit sweep never frees
// them), so such a field leaks with the struct — no RC, no aliasing bail. Struct /
// nested-tuple / array elements are deferred.
pub function is_leaksafe_tuple_field(t: string): boolean {
    var len: i32 = t.len();
    if (len < 3 || t[0:1] != "(" || t[len - 1 : len] != ")") { return false; }
    var any: boolean = false;
    var i: i32 = 0;
    while (i < 64) {
        var tag: string = tuple_type_elem_tag(t, i);
        if (tag == "") { return any; }
        if (!is_leaksafe_payload(tag)) { return false; }
        any = true;
        i = i + 1;
    }
    return any;
}

pub function is_scalar_arr_field_access(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            // Any owned array field — scalar (i32[]/f64[]/i64[]) or struct (P[]) —
            // is bailed in the alias-creating positions (bind/return/assign): the
            // leak-only IR can't retain the second reference, and the field's array
            // is the struct's sole-owned value.
            return is_leaksafe_array_field(ft) || is_struct_array_field_type(s.structs, ft) || is_enum_array_field_type(s.structs, ft);
        },
        _ => { return false; }
    }
    return false;
}

pub function decl_is_leaksafe(structs: parser.StructDecl[], struct_name: string): boolean {
    return decl_is_leaksafe_d(structs, struct_name, 0);
}

// decl_is_leaksafe_d is the depth-bounded recursion: a struct is leak-safe if
// every field is a scalar (i32/boolean/string/scalar-array) OR a struct that is
// itself leak-safe (composite struct fields, leak mode — the pointer is stored
// in one slot, no RC). The depth cap conservatively bails on deeply nested /
// cyclic type graphs (a cycle would otherwise loop forever); bailing is safe (it
// just routes the module to the AST path).
function decl_is_leaksafe_d(structs: parser.StructDecl[], struct_name: string, depth: i32): boolean {
    if (depth > 16) { return false; }
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            var fi: i32 = 0;
            while (fi < structs[i].fields.len()) {
                var t: string = structs[i].fields[fi].type_name;
                if (t == "i32" || t == "boolean" || t == "string" || t == "string[]" || t == "f64" || t == "i64" || is_leaksafe_array_field(t) || is_leaksafe_opt_field(t) || is_leaksafe_tuple_field(t) || is_map_type_name(t)) {
                    fi = fi + 1;
                    continue;
                }
                // A struct-typed field is allowed if its struct is leak-safe too.
                if (decl_is_struct(structs, t) && decl_is_leaksafe_d(structs, t, depth + 1)) {
                    fi = fi + 1;
                    continue;
                }
                // A nominal-enum field (Color, Expr, …) is leak-only on the IR
                // path — the exit sweep never frees an enum box — so it leaks
                // with the struct like a string / Option / tuple field: no RC, no
                // aliasing bail. is_enum_like_name can over-match a bare nominal
                // that is not really an enum, but the only consequence is an AST
                // fallback at the construction / match site (never a miscompile),
                // and the stage-2 fixpoint guards byte-stability.
                if (is_enum_like_name(t, structs)) {
                    fi = fi + 1;
                    continue;
                }
                // An array-of-struct field `X[]` (X a leak-safe struct): admitted
                // in leak mode (the array + its elements leak with the struct; a
                // recursive-drop follow-up frees them). The element's leaf-safety
                // rides the SAME depth-bounded recursion so a cyclic `X[]` graph
                // hits the cap and bails to AST.
                if (t.len() >= 3 && t[t.len() - 2 : t.len()] == "[]") {
                    var elt: string = t[0 : t.len() - 2];
                    if (decl_is_struct(structs, elt) && decl_is_leaksafe_d(structs, elt, depth + 1)) {
                        fi = fi + 1;
                        continue;
                    }
                    // An array-of-ENUM field `C[]` — enum boxes leak with the
                    // struct like the struct-element arrays above (and the
                    // nominal-enum field case), so admit it in leak mode.
                    if (is_enum_like_name(elt, structs)) {
                        fi = fi + 1;
                        continue;
                    }
                    // An array-of-ARRAY field `T[][]` whose element `T[]` is
                    // itself a leaf-safe array (scalar / struct / enum array), or
                    // an array-of-Option/Result field `Option[T][]` whose element
                    // `Option[T]` is a leak-safe Option/Result: the whole nested
                    // structure leaks with the struct. Covers the common 2-D
                    // field; deeper nesting still bails.
                    if (is_leaksafe_array_field(elt) || is_struct_array_field_type(structs, elt) || is_enum_array_field_type(structs, elt) || is_leaksafe_opt_field(elt)) {
                        fi = fi + 1;
                        continue;
                    }
                }
                return false;
            }
            return true;
        }
        i = i + 1;
    }
    return false;
}

// is_enum_like_name reports whether type name `t` denotes a (nominal) enum:
// not a primitive, struct, array, or bracketed/tuple generic. Mirrors the AST
// emitter's is_enum_recv heuristic (asmcore.is_enum_recv) — a bare nominal that
// isn't anything else is an enum. Used to carry an enum-typed local / param /
// receiver's type name in local_struct_type, so `x.method()` on an enum value
// dispatches to `<Enum>.<method>` (the enum-receiver-method path). A name that
// is really a scalar type alias would be mis-marked, but the only consequence
// is a method-dispatch label that calls_only_known finds absent → the module
// bails to AST; never a miscompile.
pub function is_enum_like_name(t: string, structs: parser.StructDecl[]): boolean {
    if (t.len() == 0) { return false; }
    if (t == "i32" || t == "boolean" || t == "bool" || t == "string"
        || t == "i64" || t == "f64" || t == "f32" || t == "float" || t == "void") { return false; }
    if (decl_is_struct(structs, t)) { return false; }
    if (is_array_type_name(t)) { return false; }
    // A bracketed generic (Option[..]/Result[..]/Map[..]/Box[..]) or a tuple
    // "(..)" is not a bare enum.
    var ci: i32 = 0;
    while (ci < t.len()) {
        if (t[ci] == 91) { return false; }   // '['
        ci = ci + 1;
    }
    if (t[0:1] == "(") { return false; }
    return true;
}

// decl_is_prim_recv reports whether a method-receiver type spelling names a
// PRIMITIVE / `string` type (i32/i64/u32/u64/usize/f64/f32/boolean/string) —
// the receivers `impl Trait for <prim>` can name, whose `dyn` values are
// heap-boxed at coercion (docs/DYN-TRAITS.md §4.2.3). Not a struct, not an
// enum, not an array. Mirrors asmcore.is_prim_recv_name for the wasm backend,
// which works on (structs) inputs rather than EmitState.
pub function decl_is_prim_recv(structs: parser.StructDecl[], name: string): boolean {
    if (name.len() == 0) { return false; }
    if (is_array_type_name(name)) { return false; }
    if (decl_is_struct(structs, name)) { return false; }
    if (is_enum_like_name(name, structs)) { return false; }
    if (name == "i32" || name == "i64" || name == "u32" || name == "u64" || name == "usize"
        || name == "f64" || name == "f32" || name == "float"
        || name == "boolean" || name == "bool" || name == "string") { return true; }
    return false;
}

// prim_type_ids is the canonical ordered list of primitive receiver type names
// used to assign a dyn-box shape id on wasm (the natives use the interned
// type-name string). The id is structs.len() + index, so it never collides with
// a struct's type id (its index in `structs`). The order is fixed for
// deterministic codegen (docs/DYN-TRAITS.md §4.2.3 — fixpoint determinism).
pub function prim_type_ids(): string[] {
    return ["i32", "boolean", "bool", "i64", "u32", "u64", "usize", "f64", "f32", "float", "string"];
}

// prim_type_id maps a primitive receiver type name to its wasm dyn-box shape id
// (structs.len() + its index in prim_type_ids), or -1 if not a primitive. Both
// op_dyn_box (store @0) and op_dyn_dispatch (compare) key off this, so a boxed
// value's offset-0 id matches the dispatch arm. bool/boolean and f32/f64/float
// share spellings but each maps to its own slot; that is harmless (an impl names
// exactly one spelling, used at both box and dispatch).
pub function prim_type_id(structs: parser.StructDecl[], name: string): i32 {
    var names: string[] = prim_type_ids();
    var i: i32 = 0;
    while (i < names.len()) {
        if (names[i] == name) { return structs.len() + i; }
        i = i + 1;
    }
    return 0 - 1;
}

// decl_has_scalar_array reports whether a struct has any scalar-array field.
pub function decl_has_scalar_array(structs: parser.StructDecl[], struct_name: string): boolean {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            var fi: i32 = 0;
            while (fi < structs[i].fields.len()) {
                if (is_scalar_array_type(structs[i].fields[fi].type_name)) { return true; }
                fi = fi + 1;
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// decl_field_type returns the declared type name of `field` in `struct_name`
// ("" if absent) — used to track a string-typed field's reads as strings.
pub function decl_field_type(structs: parser.StructDecl[], struct_name: string, field: string): string {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            var fi: i32 = 0;
            while (fi < structs[i].fields.len()) {
                if (structs[i].fields[fi].name == field) { return structs[i].fields[fi].type_name; }
                fi = fi + 1;
            }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// decl_field_type_at returns the type of field `index` (decl order) in struct
// `struct_name`, or "".
pub function decl_field_type_at(structs: parser.StructDecl[], struct_name: string, index: i32): string {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            if (index >= 0 && index < structs[i].fields.len()) { return structs[i].fields[index].type_name; }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// struct_field_width returns the field's load/store width for op_struct_get /
// op_struct_set: 64 if the field is f64, else 0 (i32-shaped). Drives wasm's
// f64.load/store vs i32.load/store selection (register backends ignore it).
pub function struct_field_width(structs: parser.StructDecl[], struct_name: string, index: i32): i32 {
    var t: string = decl_field_type_at(structs, struct_name, index);
    if (t == "f64" || t == "i64") { return 64; }
    return 0;
}
// struct_field_is_i64 reports whether field `index` of `struct_name` is i64 (an
// 8-byte INTEGER field — i64.load/store on wasm, vs f64.load/store for f64).
pub function struct_field_is_i64(structs: parser.StructDecl[], struct_name: string, index: i32): boolean {
    return decl_field_type_at(structs, struct_name, index) == "i64";
}

pub function (s: LowerState) field_index_in(struct_name: string, field: string): i32 {
    return decl_field_index(s.structs, struct_name, field);
}

// is_builtin_pattern reports whether a match pattern names a built-in Option /
// Result / bool variant — these discriminate on an i32 tag at offset 0 (not the
// struct shape), so the IR path bails on them for now.
pub function is_builtin_pattern(name: string): boolean {
    return name == "Some" || name == "None" || name == "Ok" || name == "Err"
        || name == "true" || name == "false";
}

pub function decl_field_count(structs: parser.StructDecl[], struct_name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) { return structs[i].fields.len(); }
        i = i + 1;
    }
    return 0;
}

// expr_struct_type returns the struct type name an expression evaluates to, or
// "" — a struct literal's type, or a struct-tracked local/param slot.
pub function expr_struct_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprStructLit(sl) => { return sl.type_name; },
        parser.ExprIdent(id) => {
            var idsl: i32 = s.slot_of(id.name);
            // An ARRAY slot's local_struct_type holds its ELEMENT struct type
            // (for `arr[i]` recovery below), NOT the slot's own type — the array
            // value itself is not a struct, so report "".
            if (s.is_arr_slot(idsl)) { return ""; }
            return s.struct_type_of_slot(idsl);
        },
        parser.ExprIndex(ix) => {
            // Indexing a struct ARRAY `arr[i]` evaluates to the element struct
            // type, carried in the (is_arr) array slot's local_struct_type. Lets
            // `arr[i].field` / `arr[i].method()` resolve without an intermediate
            // typed local. i32[]/string[] arrays carry "" → not a struct.
            match (ix.array) {
                parser.ExprIdent(aid) => {
                    var asl: i32 = s.slot_of(aid.name);
                    if (s.is_arr_slot(asl)) { return s.struct_type_of_slot(asl); }
                },
                // `p.items[i]` where p's field `items` is a `P[]` struct-array or
                // `C[]` enum-array field → the element type (so `p.items[i].field`
                // / `p.items[i].method()` resolve; an enum element dispatches to
                // `<Enum>.<method>`, the field analog of the local enum-array case).
                parser.ExprFieldAccess(fa) => {
                    var oty: string = expr_struct_type(fa.obj, s);
                    if (oty != "") {
                        var ft: string = decl_field_type(s.structs, oty, fa.field);
                        if (ft.len() >= 3 && ft[ft.len() - 2 : ft.len()] == "[]") {
                            var elt: string = ft[0 : ft.len() - 2];
                            if (decl_is_struct(s.structs, elt) || is_enum_like_name(elt, s.structs)) { return elt; }
                        }
                    }
                },
                _ => {}
            }
            return "";
        },
        parser.ExprFieldAccess(fa) => {
            // A struct-typed tuple element `t.N` evaluates to that struct type.
            if (util.is_all_digits(fa.field)) {
                var tt: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                if (decl_is_struct(s.structs, tt)) { return tt; }
                return "";
            }
            // A struct-typed field read `obj.f` evaluates to the field's struct
            // type (enables nested access `b.p.x`). Returns "" if obj isn't a
            // struct or f isn't a struct-typed field.
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (decl_is_struct(s.structs, ft)) { return ft; }
            return "";
        },
        parser.ExprCall(c) => {
            // A call to a struct-returning function evaluates to that struct type
            // (so `var p = make()` / `var p = obj.make()` then `p.x` resolves).
            match (c.callee) {
                parser.ExprIdent(id) => { return s.struct_ret_type(id.name); },
                parser.ExprFieldAccess(fa) => {
                    // Associated-function call `Type.make()` / `Enum.default()` —
                    // the object is a bare TYPE name (struct or enum), not a local
                    // slot. Key the return type by "<Type>.<method>" directly via
                    // the registry (struct_ret_fns now records enum returns too).
                    // A non-empty result both recovers the constructed type — so
                    // `Type.make(..).x` and an inferred `var p = Type.make(..)` /
                    // `var e = Enum.default()` resolve — AND distinguishes the
                    // associated call from a module call `mod.func()` (whose key
                    // is the bare `func`, never `mod.func`, so it returns "").
                    match (fa.obj) {
                        parser.ExprIdent(tid) => {
                            if (s.slot_of(tid.name) < 0) {
                                var art: string = s.struct_ret_type(tid.name + "." + fa.field);
                                if (art != "") { return art; }
                            }
                        },
                        _ => {}
                    }
                    // Method call `obj.make()` → key by "<Type>.<method>".
                    var rty: string = expr_struct_type(fa.obj, s);
                    if (rty == "") { return ""; }
                    return s.struct_ret_type(rty + "." + fa.field);
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// expr_recv_prim_type returns the PRIMITIVE receiver type name of a method
// call's receiver `e` (for `impl Trait for i32/string/i64/f64` dispatch), or
// "" if `e` is a struct (handled by expr_struct_type) or otherwise not a
// dispatchable primitive receiver. Strings / i64 / f64 are detected precisely
// via the existing predicates; any other scalar defaults to "i32" (so a
// boolean receiver dispatches as "i32" — see the limitation note). This only
// drives the call-site label: a label naming a non-existent method bails the
// whole module to the AST path (calls_only_known), so an over-broad "i32"
// guess is safe, never a miscompile.
pub function expr_recv_prim_type(e: parser.Expr, s: LowerState): string {
    // A struct receiver is NOT a primitive — let the struct path handle it.
    if (expr_struct_type(e, s) != "") { return ""; }
    // An enum value is not a primitive either: a variant construction `V(x)`
    // (call to a variant-struct name) or a unit variant `V` (bare ident naming
    // one). Returning "" bails the module to AST rather than mis-dispatching to
    // `i32.<method>` — its `<Enum>.<method>` dispatch needs the variant->enum
    // map (a later slice). An enum value held in a LOCAL is dispatched earlier
    // via expr_struct_type (the local carries the enum name).
    match (e) {
        parser.ExprCall(vc) => {
            match (vc.callee) {
                parser.ExprIdent(vci) => { if (decl_is_struct(s.structs, vci.name)) { return ""; } },
                _ => {}
            }
        },
        parser.ExprIdent(uvi) => { if (decl_is_struct(s.structs, uvi.name)) { return ""; } },
        _ => {}
    }
    // Arrays / tuples / maps aren't primitive receivers either; their builtin
    // methods (.len / .append / map ops) are intercepted before this fallback.
    if (expr_is_str(e, s)) { return "string"; }
    if (expr_is_f64(e, s)) { return "f64"; }
    if (infer_expr_width(e, s) == 64) { return "i64"; }
    return "i32";
}

// lower_dyn_arg lowers an expression that flows into a `dyn Trait` slot
// (docs/DYN-TRAITS.md §4.2.3). A struct/enum value already carries its shape at
// offset 0, so it is the `dyn` pointer directly — lowered unchanged. A
// primitive/string value (expr_recv_prim_type != "") has no shape pointer, so
// it is heap-boxed into a cell [shape@0, value@8] via op_dyn_box, keyed by the
// primitive type name; the box pointer becomes the `dyn` value. op_dyn_dispatch
// then reads offset 0 and, on a primitive arm, reloads the value from offset 8.
pub function lower_dyn_arg(e: parser.Expr, s: LowerState): LowerState {
    var prim: string = expr_recv_prim_type(e, s);
    if (prim == "") {
        // Struct / enum concrete — already shape-carrying, no box.
        return lower_expr(e, s);
    }
    var ls: LowerState = lower_expr(e, s);
    if (!ls.ok) { return ls; }
    return ls.emit(ir.op_dyn_box(prim));
}

// expr_is_nonscalar conservatively reports whether `e` evaluates to a non-scalar
// (heap) value — a string, array, struct, tuple, variant box, or anything that
// might (a call). Used to keep tuple elements (and other scalar-only contexts)
// to i32/boolean: a tuple with a heap element bails to the AST path, since its
// rc would need tracking.
pub function expr_is_nonscalar(e: parser.Expr, s: LowerState): boolean {
    if (expr_is_str(e, s)) { return true; }
    if (expr_struct_type(e, s) != "") { return true; }
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprTuple(_) => { return true; },
        parser.ExprStructLit(_) => { return true; },
        parser.ExprCall(_) => { return true; },
        parser.ExprIdent(id) => { return s.is_arr_slot(s.slot_of(id.name)); },
        _ => { return false; }
    }
    return false;
}

// expr_is_str reports whether expression `e` evaluates to a string, by the
// structural cues irlower can see without a full type checker: a string
// literal, a string-marked local/param slot, or a `+` whose operands are
// strings (nested concat). Drives string-op dispatch in ExprBinary / `.len()`.
pub function (s: LowerState) is_str_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.str_ret_fns.len()) {
        if (s.str_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_is_strarr reports whether `e` evaluates to a string[] array — a string-
// element array literal, or a string[]-marked local/param slot. Drives the
// element typing of `arr[i]` (a string).
pub function expr_is_strarr(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return false; }
            return expr_is_str(arr.elements[0], s);
        },
        parser.ExprIdent(id) => { return s.is_strarr_slot(s.slot_of(id.name)); },
        parser.ExprCall(c) => {
            // A call to a string[]-returning user function (strarr_ret_fns), the
            // `str_split(s, sep)` builtin (string→string[]), or the `s.split(sep)`
            // method form — all yield a string[] whose elements are string boxes.
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "str_split" && c.args.len() == 2) { return true; }
                    return s.is_strarr_ret_fn(cid.name);
                },
                parser.ExprFieldAccess(cfa) => {
                    if (cfa.field == "split" && c.args.len() == 1 && expr_is_str(cfa.obj, s)) { return true; }
                    if (cfa.field == "chars" && c.args.len() == 0 && expr_is_str(cfa.obj, s)) { return true; }
                    if (cfa.field == "lines" && c.args.len() == 0 && expr_is_str(cfa.obj, s)) { return true; }
                    return false;
                },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprFieldAccess(fa) => {
            // A string[]-typed struct field read `p.items` is a string[].
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "string[]";
        },
        parser.ExprSlice(sl) => { return expr_is_strarr(sl.array, s); },
        _ => { return false; }
    }
    return false;
}

// expr_is_f64arr reports whether `e` is an f64[] array — an array literal whose
// first element is f64, or an f64-array-tracked local/param. Drives the slot's
// element-width tracking at a `var a = …` binding (mirrors expr_is_strarr).
// f64[]-returning calls and slices aren't tracked (those uses bail), so they
// fall to the default — keeping a stray width-32 a[i] off an f64 buffer out of
// the eligible set via the whole-module gate.
pub function expr_is_f64arr(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return false; }
            return expr_is_f64(arr.elements[0], s);
        },
        parser.ExprIdent(id) => { return s.is_f64arr_slot(s.slot_of(id.name)); },
        parser.ExprCall(c) => {
            // A call to an f64[]-returning free function OR method (f64arr_ret_fns,
            // methods keyed "<Type>.<method>").
            match (c.callee) {
                parser.ExprIdent(cid) => { return s.is_f64arr_ret_fn(cid.name); },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_f64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprSlice(sl) => { return expr_is_f64arr(sl.array, s); },
        _ => { return false; }
    }
    return false;
}

// expr_is_arr_src reports whether `e` is an ARRAY (an array literal, an
// array-marked local/param, an array-returning call, or a slice of one) — used
// to route `e[start:end]` to arr_slice vs str_slice.
pub function expr_is_arr_src(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprIdent(id) => { return s.is_arr_slot(s.slot_of(id.name)); },
        // `a[i]` where `a` is an array-of-arrays yields an array (its element).
        parser.ExprIndex(ix) => {
            match (ix.array) {
                parser.ExprIdent(aid) => { return s.is_arrarr_slot(s.slot_of(aid.name)); },
                _ => { return false; }
            }
        },
        parser.ExprSlice(sl) => { return expr_is_arr_src(sl.array, s); },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // `__alloc_u8(n)` yields a fresh n-element byte array.
                    if (cid.name == "__alloc_u8") { return true; }
                    // `str_split(s, sep)` yields a fresh string[] (op_str_split).
                    if (cid.name == "str_split" && c.args.len() == 2) { return true; }
                    return s.is_arr_ret_fn(cid.name);
                },
                // `s.bytes()` / `s.as_bytes()` on a string receiver yields a
                // fresh u8[] (op_str_bytes), and `s.split(sep)` a fresh string[]
                // (op_str_split) — both rc-tracked array sources.
                parser.ExprFieldAccess(cfa) => {
                    if ((cfa.field == "bytes" || cfa.field == "as_bytes") && c.args.len() == 0) {
                        return expr_is_str(cfa.obj, s);
                    }
                    if (cfa.field == "split" && c.args.len() == 1) {
                        return expr_is_str(cfa.obj, s);
                    }
                    if (cfa.field == "chars" && c.args.len() == 0) {
                        return expr_is_str(cfa.obj, s);
                    }
                    if (cfa.field == "lines" && c.args.len() == 0) {
                        return expr_is_str(cfa.obj, s);
                    }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

pub function expr_is_str(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprString(_) => { return true; },
        parser.ExprIdent(id) => { return s.is_str_slot(s.slot_of(id.name)); },
        parser.ExprBinary(b) => {
            if (b.op == "+") { return expr_is_str(b.left, s) || expr_is_str(b.right, s); }
            return false;
        },
        parser.ExprCall(c) => {
            // A string-valued if/match-EXPRESSION desugars to a 0-arg IIFE
            // `(function(): string { if (c) { return "a"; } … })()`. Classify it
            // by its first branch's returned value, so `var s = if (…) { … }`
            // tracks s as a string (and `lower_iife` admits the string temp).
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return expr_is_str(iife_first_return_expr(lam.body[0]), s);
                        }
                    },
                    _ => {}
                }
            }
            // A call to a string-returning user function (str_ret_fns), or the
            // random_bytes builtin (a fresh string of n random bytes).
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "random_bytes") { return true; }
                    // string_from_bytes(arr) packs bytes into a fresh string box.
                    if (cid.name == "string_from_bytes") { return true; }
                    // read_line() returns a fresh string box (so `var s = read_line()`
                    // tracks s as a string for `.len()` / concat dispatch).
                    if (cid.name == "read_line") { return true; }
                    return s.is_str_ret_fn(cid.name);
                },
                // `X.to_string()` yields a string box (the i32 runtime helper or
                // the string-identity case); a struct's generated `to_string`
                // (@derive(Display)) is likewise string-typed. `to_debug`
                // (@derive(Debug)) is the same shape — always string-returning,
                // including on an ENUM receiver (whose expr_struct_type is "",
                // so the str_ret_fn path below can't reach it). Either way the
                // result feeds `+` concat / `.len()` as a string.
                parser.ExprFieldAccess(cfa) => {
                    if ((cfa.field == "to_string" || cfa.field == "to_debug") && c.args.len() == 0) { return true; }
                    // `s.to_upper()` / `s.to_lower()` on a string receiver yield a
                    // fresh string (op_str_to_upper / _to_lower), so the result
                    // feeds `.len()` / concat as a string.
                    if ((cfa.field == "to_upper" || cfa.field == "to_lower" || cfa.field == "trim" || cfa.field == "reverse") && c.args.len() == 0 && expr_is_str(cfa.obj, s)) { return true; }
                    // `s.repeat(n)` on a string receiver yields a fresh string.
                    if (cfa.field == "repeat" && c.args.len() == 1 && expr_is_str(cfa.obj, s)) { return true; }
                    if (cfa.field == "replace" && c.args.len() == 2 && expr_is_str(cfa.obj, s)) { return true; }
                    // A string-returning METHOD call `recv.m(...)`. Methods store
                    // their bare name (`receiver_type` is separate), so str_ret_fns
                    // records `m` by bare name — same as the free-call lookup above.
                    // Lets `recv.m().len()` / `recv.m() + x` track as string instead
                    // of mis-dispatching `.len()` to arr_len. Guarded by a non-empty
                    // receiver type so only genuine method calls match.
                    var mrty: string = expr_struct_type(cfa.obj, s);
                    if (mrty == "") { mrty = expr_recv_prim_type(cfa.obj, s); }
                    if (mrty != "" && s.is_str_ret_fn(cfa.field)) { return true; }
                    return false;
                },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprFieldAccess(fa) => {
            // A string tuple element `t.N` is a string.
            if (util.is_all_digits(fa.field)) {
                return expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s) == "string";
            }
            // A string-typed struct field read `p.name` is a string.
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "string";
        },
        parser.ExprIndex(ix) => {
            // Indexing a string[] array yields a string element.
            return expr_is_strarr(ix.array, s);
        },
        parser.ExprSlice(slc) => {
            // Slicing a string yields a string (`s[a:b]`). Without this, a
            // slice-result var isn't a str slot, so `.len()` would mis-dispatch
            // to arr_len (offset 0) instead of str_len (offset 8).
            return expr_is_str(slc.array, s);
        },
        _ => { return false; }
    }
    return false;
}

// to_unsigned_kind maps a signed IR op kind to its unsigned variant, for u64
// operands (#2904): comparisons, shift-right, and div/rem. Sign-agnostic kinds
// (add/sub/mul/and/or/xor/shl/eq/ne) pass through unchanged.
pub function to_unsigned_kind(kind: string): string {
    if (kind == "lt_s") { return "lt_u"; }
    if (kind == "gt_s") { return "gt_u"; }
    if (kind == "le_s") { return "le_u"; }
    if (kind == "ge_s") { return "ge_u"; }
    if (kind == "shr_s") { return "shr_u"; }
    if (kind == "div_s") { return "div_u"; }
    if (kind == "rem_s") { return "rem_u"; }
    return kind;
}

// map_binop maps a source binary operator to its IR opcode kind (the i32 /
// signed subset). Unknown ops return "" -> caller bails.
pub function map_binop(op: string): string {
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") { return "div_s"; }
    if (op == "%") { return "rem_s"; }
    if (op == "&") { return "and"; }
    if (op == "|") { return "or"; }
    if (op == "^") { return "xor"; }
    if (op == "<<") { return "shl"; }
    if (op == ">>") { return "shr_s"; }
    if (op == "==") { return "eq"; }
    if (op == "!=") { return "ne"; }
    if (op == "<") { return "lt_s"; }
    if (op == "<=") { return "le_s"; }
    if (op == ">") { return "gt_s"; }
    if (op == ">=") { return "ge_s"; }
    return "";
}

// for_iter_is_range reports whether a for-loop iter is the synthetic
// `__range(LOW, HIGH)` / `__range_incl(LOW, HIGH)` call the parser emits
// for `for i in LOW..HIGH` / `for i in LOW..=HIGH`. Mirrors the checker's
// for_iter_is_range (which binds the loop var to i32).
pub function for_iter_is_range(iter: parser.Expr): boolean {
    match (iter) {
        parser.ExprCall(c) => {
            if (c.args.len() != 2) { return false; }
            match (c.callee) {
                parser.ExprIdent(id) => { return id.name == "__range" || id.name == "__range_incl"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// for_iter_is_range_incl reports whether the for-loop iter is the
// inclusive `__range_incl(LOW, HIGH)` form (closed interval [LOW, HIGH]),
// so lower_range_for emits a `<=` rather than `<` loop condition.
pub function for_iter_is_range_incl(iter: parser.Expr): boolean {
    match (iter) {
        parser.ExprCall(c) => {
            if (c.args.len() != 2) { return false; }
            match (c.callee) {
                parser.ExprIdent(id) => { return id.name == "__range_incl"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// is_numeric_cast_op reports whether an `as_<T>` unary op is a numeric
// CONVERSION (truncate / sign-extend / float-round) rather than a
// zero-cost type ascription. The conversions change the runtime value;
// everything else (`as i32[]`, `as string`, `as Option`) is an ascription.
pub function is_numeric_cast_op(op: string): boolean {
    return op == "as_i32" || op == "as_u32" || op == "as_i64" || op == "as_u64"
        || op == "as_f64" || op == "as_f32" || op == "as_float";
}

// ascription_target returns the target type name of an ascription cast
// `E as T` (init = the `as_<T>` unary), or "" if `init` isn't an ascription.
// A numeric conversion (`as i32`, `as f64`, …) returns "" — it is a real
// value conversion, not an identity ascription.
pub function ascription_target(init: parser.Expr): string {
    match (init) {
        parser.ExprUnary(u) => {
            if (u.op.len() > 3 && u.op[0:3] == "as_" && !is_numeric_cast_op(u.op)) {
                return u.op[3:u.op.len()];
            }
            return "";
        },
        _ => { return ""; }
    }
}

// ascription_rebind rewrites `var x = E as T` to the equivalent annotated
// binding `var x: T = E` (the `as` ascription is identity). Caller guards
// with `ascription_target(v.init) != ""`, so v.init is always an ascription
// unary here; the `_` arm returns v unchanged for exhaustiveness.
pub function ascription_rebind(v: parser.StmtVar): parser.Stmt {
    match (v.init) {
        parser.ExprUnary(au) => {
            return parser.StmtVar { name: v.name, type_name: ascription_target(v.init), init: au.operand, line: v.line, col: v.col };
        },
        _ => { return v; }
    }
}

// lower_range_for lowers `for i in LOW..HIGH { body }` (iter = the synthetic
// `__range(LOW, HIGH)` call) to a counted loop over the half-open interval —
// or the closed interval `[LOW, HIGH]` for the inclusive `__range_incl` form
// (`for i in LOW..=HIGH`), which only changes the loop condition to `i <= hi`.
// HIGH is bound once into a hidden local (so `for i in 0..f()` calls f()
// once), i = LOW, then `while (i < hi) { body; i = i + 1 }`. The caller has
// already bailed bodies containing break/continue (a `continue` would skip
// the increment), so the counted shape is safe. LOW / HIGH are i32 exprs.
// Split out of lower_stmt's StmtFor arm so that arm stays small (oversized
// functions miscompile on the native backend — cf. #2720).
pub function lower_range_for(var_name: string, iter: parser.Expr, body: parser.Stmt[], s: LowerState): LowerState {
    var r_lo: parser.Expr = iter;
    var r_hi: parser.Expr = iter;
    match (iter) {
        parser.ExprCall(rc) => {
            r_lo = rc.args[0];
            r_hi = rc.args[1];
        },
        _ => {}
    }
    // Closed interval `[LOW, HIGH]` (`for i in LOW..=HIGH`) exits on `i <= hi`;
    // the half-open `[LOW, HIGH)` default exits on `i < hi`.
    var cond_kind: string = "lt_s";
    if (for_iter_is_range_incl(iter)) { cond_kind = "le_s"; }
    // hidden HIGH bound (evaluated once)
    var hin: string = "$forhi" + util.i32_to_string(s.local_names.len());
    var rs: LowerState = s.add_local(hin);
    var hislot: i32 = rs.slot_of(hin);
    rs = lower_expr(r_hi, rs);
    if (!rs.ok) { return rs; }
    rs = rs.emit(ir.op_store_local(hislot));
    // loop var i = LOW - 1 (user-visible i32 binding). The increment runs at
    // the TOP of the loop (after the header, before the condition) rather than
    // the bottom, so a `continue` — which branches to the loop header — re-runs
    // the increment instead of skipping it (#2788). Starting at LOW-1 means the
    // first top-advance lands i on LOW, so the body still observes LOW, LOW+1, …
    rs = rs.add_local(var_name);
    var islot: i32 = rs.slot_of(var_name);
    rs = lower_expr(r_lo, rs);
    if (!rs.ok) { return rs; }
    rs = rs.emit(ir.op_const_i32(1));
    rs = rs.emit(ir.op_bin("sub", 0, false));   // i = LOW - 1
    rs = rs.emit(ir.op_store_local(islot));
    rs = rs.emit(ir.op_block(0)).enter_loop();  // depth 1 = break/exit target
    rs = rs.emit(ir.op_loop(0));                // depth 0 = continue/header
    // advance: i = i + 1 (runs on every header entry, incl. after `continue`).
    rs = rs.emit(ir.op_load_local(islot));
    rs = rs.emit(ir.op_const_i32(1));
    rs = rs.emit(ir.op_bin("add", 0, false));
    rs = rs.emit(ir.op_store_local(islot));
    // cond: i < hi (or i <= hi for the inclusive form) ; exit when NOT.
    rs = rs.emit(ir.op_load_local(islot));
    rs = rs.emit(ir.op_load_local(hislot));
    rs = rs.emit(ir.op_bin(cond_kind, 0, false));
    rs = rs.emit(ir.op_bin("not", 0, false));
    rs = rs.emit(ir.op_brif(1));
    rs = lower_block(body, rs);
    if (!rs.ok) { return rs; }
    rs = rs.emit(ir.op_br(0));   // back-edge to header (re-advances)
    rs = rs.emit(ir.op_end());
    return rs.emit(ir.op_end()).exit_loop();
}

// lower_foreach_snapshot lowers `for x in <EXPR>` where the iterable is not a
// bare local — an array literal (`for x in [1, 2, 3]`) or a call returning an
// array (`for x in mk()`). It binds the iterable to a hidden local through the
// normal `var` lowering (which marks the slot's array / element-type flags and
// RC-owns the value — a fresh literal or a move-on-return result is owned, so
// the exit-sweep frees it), then re-lowers the loop over that local via the
// ident-foreach path. The caller guards that fr.iter is not an ident and the
// loop var has no comma (the `for k, v in m` map form needs a map local). Kept
// in its own function so the already-large StmtFor arm doesn't grow (oversized
// functions miscompile on the native backend — cf. #2720).
pub function lower_foreach_snapshot(var_name: string, iter: parser.Expr, body: parser.Stmt[], s: LowerState): LowerState {
    var itn: string = "$forit" + util.i32_to_string(s.local_names.len());
    var sv: parser.Stmt = parser.StmtVar { name: itn, type_name: "", init: iter, line: 0, col: 0 };
    var s2: LowerState = lower_stmt(sv, s);
    if (!s2.ok) { return s2; }
    var nf: parser.Stmt = parser.StmtFor { var_name: var_name, iter: parser.ExprIdent { name: itn, line: 0, col: 0 }, body: body };
    return lower_stmt(nf, s2);
}

// lower_array_to_json lowers `arr.to_json()` (the element-poly array serialiser
// `(xs: T[]) to_json[T: Json]()` from std/json) as an INLINE loop, so the
// per-element `arr[i].to_json()` is lowered where the element type is statically
// known and dispatches to the right impl. Desugars to:
//   var $tjout = "[";
//   var $tji = 0;
//   while ($tji < arr.len()) {
//       if ($tji > 0) { $tjout = $tjout + ","; }
//       $tjout = $tjout + arr[$tji].to_json();
//       $tji = $tji + 1;
//   }
//   $tjout + "]"          // result expression left on the stack
// A non-ident receiver is snapshotted into a hidden local first (evaluated
// once; ident receivers are loaded per use, which is free). The generic body
// `__fn_T__to_json` is still emitted but dead — call sites all route here. #2766.
// to_json_loop_stmt builds the synthetic `while ($i < aref.len()) { if ($i>0)
// {out=out+","} out = out + aref[$i].to_json(); $i=$i+1 }` driving the array
// serialiser. Split out of lower_array_to_json so neither function is oversized
// — large functions miscompile on the native backend (cf. #2720).
function to_json_loop_stmt(on: string, inm: string, aref: parser.Expr): parser.Stmt {
    var oref: parser.Expr = parser.ExprIdent { name: on, line: 0, col: 0 };
    var iref: parser.Expr = parser.ExprIdent { name: inm, line: 0, col: 0 };
    var zero: parser.Expr = parser.ExprNumber { text: "0", suffix: "", is_float: false, line: 0, col: 0 };
    var one: parser.Expr = parser.ExprNumber { text: "1", suffix: "", is_float: false, line: 0, col: 0 };
    var lenc: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: aref, field: "len", line: 0, col: 0 }, args: [], line: 0, col: 0, type_argc: 0 };
    var cond: parser.Expr = parser.ExprBinary { op: "<", left: iref, right: lenc, line: 0, col: 0 };
    var igt: parser.Expr = parser.ExprBinary { op: ">", left: iref, right: zero, line: 0, col: 0 };
    var addcomma: parser.Stmt = parser.StmtAssign { target: on, value: parser.ExprBinary { op: "+", left: oref, right: parser.ExprString { value: ",", line: 0, col: 0 }, line: 0, col: 0 }, line: 0, col: 0, target_line: 0, target_col: 0 };
    var noelse: parser.Stmt[] = [];
    var comma_then: parser.Stmt[] = [addcomma];
    var ifc: parser.Stmt = parser.StmtIf { cond: igt, then_body: comma_then, else_body: noelse };
    var elem: parser.Expr = parser.ExprIndex { array: aref, index: iref };
    var elemj: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: elem, field: "to_json", line: 0, col: 0 }, args: [], line: 0, col: 0, type_argc: 0 };
    var appendj: parser.Stmt = parser.StmtAssign { target: on, value: parser.ExprBinary { op: "+", left: oref, right: elemj, line: 0, col: 0 }, line: 0, col: 0, target_line: 0, target_col: 0 };
    var inc: parser.Stmt = parser.StmtAssign { target: inm, value: parser.ExprBinary { op: "+", left: iref, right: one, line: 0, col: 0 }, line: 0, col: 0, target_line: 0, target_col: 0 };
    var body: parser.Stmt[] = [ifc, appendj, inc];
    return parser.StmtWhile { cond: cond, body: body };
}

pub function lower_array_to_json(arr: parser.Expr, s: LowerState): LowerState {
    var n: i32 = s.local_names.len();
    var on: string = "$tjout" + util.i32_to_string(n);
    var inm: string = "$tji" + util.i32_to_string(n);
    var s2: LowerState = s;
    var aref: parser.Expr = arr;
    // Snapshot a non-ident receiver so `.len()` and each `arr[i]` reference the
    // same once-evaluated value (an ident is just a local load, so reuse it).
    var is_ident: boolean = false;
    match (arr) {
        parser.ExprIdent(_) => { is_ident = true; },
        _ => {}
    }
    if (!is_ident) {
        var an: string = "$tjarr" + util.i32_to_string(n);
        var snap: parser.Stmt = parser.StmtVar { name: an, type_name: "", init: arr, line: 0, col: 0 };
        s2 = lower_stmt(snap, s);
        if (!s2.ok) { return s2; }
        aref = parser.ExprIdent { name: an, line: 0, col: 0 };
    }
    // var $tjout = "[";
    var dout: parser.Stmt = parser.StmtVar { name: on, type_name: "", init: parser.ExprString { value: "[", line: 0, col: 0 }, line: 0, col: 0 };
    s2 = lower_stmt(dout, s2);
    if (!s2.ok) { return s2; }
    // var $tji = 0;
    var di: parser.Stmt = parser.StmtVar { name: inm, type_name: "", init: parser.ExprNumber { text: "0", suffix: "", is_float: false, line: 0, col: 0 }, line: 0, col: 0 };
    s2 = lower_stmt(di, s2);
    if (!s2.ok) { return s2; }
    // the serialising loop (built in a helper to keep this function small)
    s2 = lower_stmt(to_json_loop_stmt(on, inm, aref), s2);
    if (!s2.ok) { return s2; }
    // result expression: $tjout + "]"
    var result: parser.Expr = parser.ExprBinary { op: "+", left: parser.ExprIdent { name: on, line: 0, col: 0 }, right: parser.ExprString { value: "]", line: 0, col: 0 }, line: 0, col: 0 };
    return lower_expr(result, s2);
}

// lower_string_foreach lowers `for b in STR` (iterate a string's bytes). The
// array foreach assumes an array layout — length @0, elements @ base+idx*8+8 —
// but a string is { data_ptr @0, len @8 } with byte elements, so the array
// path reads the data pointer as the length and 8-byte-indexes the header
// (#2822). Desugar to a counted loop over STR.len() with a byte-index bind,
// reusing the range-for (`__range`) and string-index (byte load) paths, both
// of which are already correct in isolation. The string is snapshotted into a
// hidden local so it is evaluated once.
function lower_string_foreach(var_name: string, iter: parser.Expr, body: parser.Stmt[], s: LowerState): LowerState {
    var n: i32 = s.local_names.len();
    var sn: string = "$fostr" + util.i32_to_string(n);
    var idx: string = "$fosi" + util.i32_to_string(n);
    var snv: parser.Stmt = parser.StmtVar { name: sn, type_name: "", init: iter, line: 0, col: 0 };
    var s2: LowerState = lower_stmt(snv, s);
    if (!s2.ok) { return s2; }
    var sref: parser.Expr = parser.ExprIdent { name: sn, line: 0, col: 0 };
    var iref: parser.Expr = parser.ExprIdent { name: idx, line: 0, col: 0 };
    var zero: parser.Expr = parser.ExprNumber { text: "0", suffix: "", is_float: false, line: 0, col: 0 };
    var lenc: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: sref, field: "len", line: 0, col: 0 }, args: [], line: 0, col: 0, type_argc: 0 };
    var rargs: parser.Expr[] = [zero, lenc];
    var range_iter: parser.Expr = parser.ExprCall { callee: parser.ExprIdent { name: "__range", line: 0, col: 0 }, args: rargs, line: 0, col: 0, type_argc: 0 };
    var bind: parser.Stmt = parser.StmtVar { name: var_name, type_name: "", init: parser.ExprIndex { array: sref, index: iref }, line: 0, col: 0 };
    var nbody: parser.Stmt[] = [bind];
    var bi: i32 = 0;
    while (bi < body.len()) { nbody = nbody.append(body[bi]); bi = bi + 1; }
    var forc: parser.Stmt = parser.StmtFor { var_name: idx, iter: range_iter, body: nbody };
    return lower_stmt(forc, s2);
}

// is_cmp_kind reports whether an IR bin-op kind produces an i32 boolean (a
// comparison / equality) rather than a value of the operand width.
pub function is_cmp_kind(kind: string): boolean {
    return kind == "eq" || kind == "ne" || kind == "lt_s" || kind == "le_s" || kind == "gt_s" || kind == "ge_s";
}

// map_fbinop maps a source operator to its f64 IR opcode (arithmetic yields an
// f64; a compare yields an i32 0/1). "" for operators with no float form (`%`,
// bitwise, shifts — those bail on float operands).
pub function map_fbinop(op: string): string {
    if (op == "+") { return "fadd"; }
    if (op == "-") { return "fsub"; }
    if (op == "*") { return "fmul"; }
    if (op == "/") { return "fdiv"; }
    if (op == "==") { return "feq"; }
    if (op == "!=") { return "fne"; }
    if (op == "<") { return "flt"; }
    if (op == "<=") { return "fle"; }
    if (op == ">") { return "fgt"; }
    if (op == ">=") { return "fge"; }
    return "";
}
pub function is_fcmp_kind(kind: string): boolean {
    return kind == "feq" || kind == "fne" || kind == "flt" || kind == "fle" || kind == "fgt" || kind == "fge";
}

// f64_math_builtin_kind maps a std/float math builtin name to its op_funary
// opcode, or "" if `name` is not one. Most are a single hardware instruction:
// __sqrt_f64 (sqrtsd / fsqrt / f64.sqrt), __floor_f64 / __ceil_f64 / __trunc_f64
// (roundsd $1/$2/$3 / frintm/p/z / f64.floor/ceil/trunc), and __abs_f64 (sign-bit
// mask / fabs / f64.abs). __round_f64 (round-half-away, Go's math.Round) is one
// instruction on arm64 (frinta) but needs trunc(x+copysign(0.5,x)) emulation on
// x86 (roundsd toward zero) and wasm (f64.nearest is ties-to-even, not -away).
// The libm transcendentals (log/exp/sin/cos/pow) still stay on the AST path.
pub function f64_math_builtin_kind(name: string): string {
    if (name == "__sqrt_f64") { return "fsqrt"; }
    if (name == "__floor_f64") { return "ffloor"; }
    if (name == "__ceil_f64") { return "fceil"; }
    if (name == "__trunc_f64") { return "ftrunc"; }
    if (name == "__abs_f64") { return "fabs"; }
    if (name == "__round_f64") { return "fround"; }
    return "";
}

// arr_index_is_f64 reports whether indexing `arr` (the array operand of `a[i]`)
// yields an f64 — i.e. `arr` names an f64[] slot. Only a tracked ident source
// qualifies (literals / function-return arrays aren't f64-element-tracked);
// anything else is the i32 default.
pub function arr_index_is_f64(arr: parser.Expr, s: LowerState): boolean {
    match (arr) {
        parser.ExprIdent(id) => { return s.is_f64arr_slot(s.slot_of(id.name)); },
        parser.ExprCall(c) => {
            // Direct index of an f64[]-returning call: `f()[i]` or `obj.m()[i]`.
            match (c.callee) {
                parser.ExprIdent(cid) => { return s.is_f64arr_ret_fn(cid.name); },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_f64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        // `p.vals[i]` where p's field `vals` is an f64[] struct field.
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "f64[]";
        },
        // Direct index of a slice expression `a[lo:hi][i]`: an f64[] slice is
        // itself an f64[], so recurse into the sliced array — mirroring
        // expr_is_f64arr's ExprSlice case. Without this the index defaulted to
        // the 4-byte i32 path, so on wasm `a[lo:hi][i]` loaded at a 4-byte
        // stride instead of f64's 8-byte stride (#2908).
        parser.ExprSlice(sl) => { return expr_is_f64arr(sl.array, s); },
        _ => { return false; }
    }
    return false;
}

// arr_index_is_i64 reports whether indexing `arr` yields an i64 — `arr` names an
// i64[] slot. Drives a[i] -> arr_get_i64 (i64.load). (i64[] returns / slices are
// a later slice; only a tracked ident source qualifies here.)
pub function arr_index_is_i64(arr: parser.Expr, s: LowerState): boolean {
    match (arr) {
        parser.ExprIdent(id) => { return s.is_i64arr_slot(s.slot_of(id.name)); },
        parser.ExprCall(c) => {
            // Direct index of an i64[]-returning call: `f()[i]` or `obj.m()[i]`.
            match (c.callee) {
                parser.ExprIdent(cid) => { return s.is_i64arr_ret_fn(cid.name); },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_i64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        // `p.vals[i]` where p's field `vals` is an i64[] struct field.
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "i64[]";
        },
        // Direct index of a slice expression `a[lo:hi][i]`: an i64[] slice is
        // itself an i64[], so recurse into the sliced array — mirroring
        // expr_is_i64arr's ExprSlice case (the same latent stride gap #2908
        // fixed for f64[]).
        parser.ExprSlice(sl) => { return expr_is_i64arr(sl.array, s); },
        _ => { return false; }
    }
    return false;
}

// expr_is_i64arr reports whether `e` is an i64[] — an i64-array-tracked
// local/param (aliasing). i64 array literals aren't self-evidently i64 from
// their elements (a bare integer literal could be i32), so the literal case is
// driven by the `i64[]` annotation at the var binding, not here.
pub function expr_is_i64arr(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprIdent(id) => { return s.is_i64arr_slot(s.slot_of(id.name)); },
        parser.ExprSlice(sl) => { return expr_is_i64arr(sl.array, s); },
        parser.ExprCall(c) => {
            // A call to an i64[]-returning free function OR method (i64arr_ret_fns,
            // methods keyed "<Type>.<method>").
            match (c.callee) {
                parser.ExprIdent(cid) => { return s.is_i64arr_ret_fn(cid.name); },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_i64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_f64 reports whether `e` evaluates to an f64 value — a float literal, an
// f64-tracked local/param, an arithmetic combination of f64 operands, or an
// f64-array element read `a[i]`. (A comparison is NOT f64 — it yields an i32
// bool — so only the arithmetic ops propagate float-ness here.)
pub function expr_is_f64(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprNumber(n) => { return n.is_float; },
        parser.ExprIdent(id) => { return s.is_f64_slot(s.slot_of(id.name)); },
        parser.ExprBinary(b) => {
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                return expr_is_f64(b.left, s) || expr_is_f64(b.right, s);
            }
            return false;
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") { return expr_is_f64(u.operand, s); }
            // `x as f64` evaluates to f64 (a float→int cast yields i32, so only
            // the to-float casts propagate float-ness).
            if (u.op == "as_f64" || u.op == "as_f32" || u.op == "as_float") { return true; }
            return false;
        },
        parser.ExprCall(c) => {
            // An f64-valued if/match-EXPRESSION (the 0-arg IIFE the desugar emits)
            // — classify by its first branch's returned value, so `var f = if (…)
            // { 1.5 } else { 2.5 }` tracks f as an f64.
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return expr_is_f64(iife_first_return_expr(lam.body[0]), s);
                        }
                    },
                    _ => {}
                }
            }
            // A call to an f64-returning free function OR method is an f64 value.
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // The std/float single-instruction math builtins return f64.
                    if (f64_math_builtin_kind(cid.name) != "") { return true; }
                    return s.is_f64_ret_fn(cid.name);
                },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    // A scalar VALUE receiver (`(3.5).m()`) isn't struct-typed —
                    // resolve its primitive receiver type so an f64-returning
                    // method `<f64>.m` is recognised as an f64 value. Without this
                    // `a.m() as i32` masked the double's low 32 bits (→ garbage)
                    // instead of truncating via f64_to_i32.
                    if (crty == "") { crty = expr_recv_prim_type(cfa.obj, s); }
                    if (crty == "") { return false; }
                    return s.is_f64_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
        },
        parser.ExprFieldAccess(fa) => {
            // An f64-typed struct field read `p.x`, or an f64 tuple element.
            if (util.is_all_digits(fa.field)) {
                return expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s) == "f64";
            }
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "f64";
        },
        parser.ExprIndex(ix) => { return arr_index_is_f64(ix.array, s); },
        _ => { return false; }
    }
    return false;
}

// expr_is_u32 reports whether `e` evaluates to a u32 value — a u32-tracked
// local/param, a u32[] element read `a[i]`, an `as u32` cast, or an arithmetic
// / bitwise / shift combination of u32 operands (a comparison is a bool, not
// u32). It drives u32 WRAPPING: a u32 arithmetic result is masked to 32 bits on
// the register backends, and a u32 `>>` lowers to a logical shift. A
// u32-returning CALL is intentionally NOT treated as u32 here — the callee
// already wraps its own u32 result internally, so the value arrives clean.
pub function expr_is_u32(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprIdent(id) => { return s.is_u32_slot(s.slot_of(id.name)); },
        parser.ExprIndex(ix) => {
            // a[i] on a u32[] is a u32 element. The array is an ident slot
            // marked u32 (a u32-array); other iterable forms are conservatively
            // not u32.
            match (ix.array) {
                parser.ExprIdent(aid) => { return s.is_u32_slot(s.slot_of(aid.name)); },
                _ => { return false; }
            }
        },
        parser.ExprUnary(u) => {
            if (u.op == "as_u32") { return true; }
            return false;
        },
        parser.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return false; }
            // A shift's result type follows the LEFT (shifted) operand; arithmetic
            // / bitwise is u32 if either side is.
            if (b.op == "<<" || b.op == ">>") { return expr_is_u32(b.left, s); }
            return expr_is_u32(b.left, s) || expr_is_u32(b.right, s);
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_u64 mirrors expr_is_u32 for the i64 (64-bit) domain: a u64-tracked
// local/param, a u64[] element read, an `as u64` cast, or an arithmetic /
// bitwise / shift combination of u64 operands. It selects the UNSIGNED i64 ops
// (lt_u / shr_u / div_u / …) — there is no wrap step (i64 ops are full-width).
pub function expr_is_u64(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprIdent(id) => { return s.is_u64_slot(s.slot_of(id.name)); },
        parser.ExprIndex(ix) => {
            match (ix.array) {
                parser.ExprIdent(aid) => { return s.is_u64_slot(s.slot_of(aid.name)); },
                _ => { return false; }
            }
        },
        parser.ExprUnary(u) => {
            if (u.op == "as_u64") { return true; }
            return false;
        },
        parser.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return false; }
            if (b.op == "<<" || b.op == ">>") { return expr_is_u64(b.left, s); }
            return expr_is_u64(b.left, s) || expr_is_u64(b.right, s);
        },
        _ => { return false; }
    }
    return false;
}

// is_eager_safe reports whether evaluating `e` is observably free of side
// effects AND cannot trap, so eagerly evaluating it (as the RHS of a
// short-circuit && / ||) is indistinguishable from skipping it. Excludes calls
// (side effects), indexing / slicing (bounds traps), division / remainder
// (the x86/arm div traps on /0), and — conservatively — every composite form.
// Operands are checker-guaranteed boolean, so `&` / `|` of the two 0/1 values
// equals `&&` / `||` once both are evaluated.
pub function is_eager_safe(e: parser.Expr): boolean {
    match (e) {
        parser.ExprNumber(_) => { return true; },
        parser.ExprBool(_) => { return true; },
        parser.ExprString(_) => { return true; },
        parser.ExprIdent(_) => { return true; },
        parser.ExprUnary(u) => { return is_eager_safe(u.operand); },
        parser.ExprBinary(b) => {
            if (b.op == "/" || b.op == "%") { return false; }
            return is_eager_safe(b.left) && is_eager_safe(b.right);
        },
        _ => { return false; }
    }
}

// infer_expr_width returns 64 if `e` evaluates to an i64 value, else 32.
// Comparisons / equality / logical-not yield an i32 bool regardless of operand
// width; arithmetic widens to i64 if either operand is i64. Bare literals are
// i32 here — they only become i64 from an i64 context (see lower_i64), which is
// what makes `var x: i64 = 5000000000` work without value-based parsing.
pub function infer_expr_width(e: parser.Expr, s: LowerState): i32 {
    match (e) {
        parser.ExprIdent(id) => {
            if (s.is_i64_slot(s.slot_of(id.name))) { return 64; }
            return 32;
        },
        parser.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return 32; }
            if (infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64) { return 64; }
            return 32;
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") { return infer_expr_width(u.operand, s); }
            if (u.op == "as_i64" || u.op == "as_u64") { return 64; }
            return 32;
        },
        parser.ExprCall(c) => {
            // An i64-width if/match-EXPRESSION (the 0-arg IIFE the desugar emits)
            // is an i64 value, so an unannotated `var x = if (c) { 5000000000 }
            // else { 1 }` width-tracks i64. (iife_any_return_i64 inspects every
            // branch — see lower_iife.)
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1 && iife_any_return_i64(lam.body[0], s)) { return 64; }
                    },
                    _ => {}
                }
            }
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // The clock builtins return an i64 timespec reading, so a
                    // binding `var a = monotonic_ns()` width-tracks i64.
                    if (cid.name == "monotonic_ns" || cid.name == "now_unix_ms" || cid.name == "now_ns") { return 64; }
                    if (s.is_i64_ret_fn(cid.name)) { return 64; }
                },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty != "" && s.is_i64_ret_fn(crty + "." + cfa.field)) { return 64; }
                },
                _ => {}
            }
            return 32;
        },
        parser.ExprIndex(ix) => {
            // a[i] on an i64[] is an i64 value (so it routes through lower_i64).
            if (arr_index_is_i64(ix.array, s)) { return 64; }
            return 32;
        },
        parser.ExprFieldAccess(fa) => {
            // An i64 tuple element `t.N` or i64 struct field `p.x` is an i64 value.
            if (util.is_all_digits(fa.field)) {
                if (expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s) == "i64") { return 64; }
                return 32;
            }
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty != "" && struct_field_is_i64(s.structs, oty, s.field_index_in(oty, fa.field))) { return 64; }
            return 32;
        },
        _ => { return 32; }
    }
}

// lower_i64 lowers `e` as an i64 VALUE (pushing an i64). Integer literals become
// const_i64 (carrying source text), i64 locals load directly, and unary `-` /
// the non-comparison arithmetic + bitwise ops recurse on i64 operands. Anything
// that isn't a pure-i64 value here — an i32 variable (mixed width), a call, a
// comparison, i64 division/remainder — fails, bailing the module to the AST path
// where full i64 already works.
pub function lower_i64(e: parser.Expr, s: LowerState): LowerState {
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) { return s.fail(); }
            return s.emit(ir.op_const_i64_text(n.text));
        },
        parser.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (sl >= 0 && s.is_i64_slot(sl)) { return s.emit(ir.op_load_local(sl)); }
            return s.fail();
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                var sz: LowerState = s.emit(ir.op_const_i64_text("0"));
                var sx: LowerState = lower_i64(u.operand, sz);
                if (!sx.ok) { return sx; }
                return sx.emit(ir.op_bin("sub", 64, false));
            }
            // `n as i64` / `n as u64`. Three operand cases:
            //  - an f64 operand: truncate toward zero to i64 (f64_to_i64);
            //    op_int_extend would mis-extend the f64's bit pattern as i32.
            //  - a non-float numeric LITERAL: already a 64-bit value, so emit an
            //    i64 const directly — lowering via the 32-bit lower_expr would
            //    make it an `i32.const`, truncating (and invalid on wasm for a
            //    literal above the i32 range). #2928.
            //  - otherwise: widen the i32 operand to i64.
            if (u.op == "as_i64" || u.op == "as_u64") {
                if (expr_is_f64(u.operand, s)) {
                    var fw: LowerState = lower_expr(u.operand, s);
                    if (!fw.ok) { return fw; }
                    return fw.emit(ir.op_f64_to_i64());
                }
                match (u.operand) {
                    parser.ExprNumber(n) => { if (!n.is_float) { return s.emit(ir.op_const_i64_text(n.text)); } },
                    _ => {}
                }
                var sw: LowerState = lower_expr(u.operand, s);
                if (!sw.ok) { return sw; }
                return sw.emit(ir.op_int_extend(u.op == "as_u64"));
            }
            return s.fail();
        },
        parser.ExprBinary(b) => {
            var kind: string = map_binop(b.op);
            if (kind == "") { return s.fail(); }
            // Comparisons aren't i64 values (they yield an i32 bool). i64
            // division/remainder ARE lowered (width 64): x86 drops the i32
            // movslq truncation, arm64's sdiv is already 64-bit, wasm calls the
            // $__fern_idiv64 / $__fern_irem64 non-trapping helpers.
            if (is_cmp_kind(kind)) { return s.fail(); }
            var l: LowerState = lower_i64(b.left, s);
            if (!l.ok) { return l; }
            var r: LowerState = lower_i64(b.right, l);
            if (!r.ok) { return r; }
            // u64 operands select the UNSIGNED i64 ops (>> / div / rem) — signed
            // are wrong once bit 63 is set (#2904). A shift's signedness follows
            // the left (shifted) operand; div/rem use either side. The other ops
            // (add/sub/mul/and/or/xor/shl) are sign-agnostic. (Compares already
            // bailed above — they yield an i32 bool, lowered in lower_expr.)
            var i64k: string = kind;
            if (b.op == ">>" || b.op == "<<") {
                if (expr_is_u64(b.left, s)) { i64k = to_unsigned_kind(kind); }
            } else if (expr_is_u64(b.left, s) || expr_is_u64(b.right, s)) {
                i64k = to_unsigned_kind(kind);
            }
            return r.emit(ir.op_bin(i64k, 64, false));
        },
        parser.ExprCall(c) => {
            // An i64-valued if/match-EXPRESSION (the 0-arg IIFE) — delegate to
            // lower_iife, which marks the inline temp i64 and widens each branch
            // value. Gated on i64-classifiability so a fully-small-literal i64
            // expression (i64-ness only from the annotation) stays on the AST path
            // instead of inlining into an i32 temp.
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1 && iife_any_return_i64(lam.body[0], s)) {
                            return lower_iife(c, lam, s);
                        }
                    },
                    _ => {}
                }
            }
            // A call to an i64-returning free function OR method IS an i64 value:
            // lower it via the normal call path (which pushes the result).
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // The clock builtins return an i64 value: lower via the
                    // normal call path (which emits the op + pushes the result).
                    if (cid.name == "monotonic_ns" || cid.name == "now_unix_ms" || cid.name == "now_ns") { return lower_expr(e, s); }
                    if (s.is_i64_ret_fn(cid.name)) { return lower_expr(e, s); }
                },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty != "" && s.is_i64_ret_fn(crty + "." + cfa.field)) { return lower_expr(e, s); }
                },
                _ => {}
            }
            return s.fail();
        },
        parser.ExprFieldAccess(fa) => {
            // An i64 tuple element `t.N` is an 8-byte i64 value: lower the tuple
            // then tuple_get_w(..i64). An i64 struct field `p.x` likewise reads
            // via struct_get_i64. Non-i64 reads bail (their i32/f64 path lives in
            // lower_expr).
            if (util.is_all_digits(fa.field)) {
                var tn: i32 = util.digits_to_i32(fa.field);
                if (expr_tuple_elem_tag(fa.obj, tn, s) != "i64") { return s.fail(); }
                var ts: LowerState = lower_expr(fa.obj, s);
                if (!ts.ok) { return ts; }
                return ts.emit(ir.op_tuple_get_w(tn, 64, true));
            }
            var fty: string = expr_struct_type(fa.obj, s);
            if (fty == "") { return s.fail(); }
            var fidx: i32 = s.field_index_in(fty, fa.field);
            if (fidx < 0) { return s.fail(); }
            if (!struct_field_is_i64(s.structs, fty, fidx)) { return s.fail(); }
            var fs: LowerState = lower_expr(fa.obj, s);
            if (!fs.ok) { return fs; }
            return fs.emit(ir.op_struct_get_i64(fidx));
        },
        parser.ExprIndex(ix) => {
            // a[i] on an i64[] is an 8-byte i64 element: lower base + index (i32
            // values) then arr_get_i64 (i64.load on wasm). A non-i64-array source
            // bails (the i32/f64 element paths live in lower_expr).
            if (!arr_index_is_i64(ix.array, s)) { return s.fail(); }
            var bs: LowerState = lower_expr(ix.array, s);
            if (!bs.ok) { return bs; }
            bs = lower_expr(ix.index, bs);
            if (!bs.ok) { return bs; }
            return bs.emit(ir.op_arr_get_i64());
        },
        _ => { return s.fail(); }
    }
}

// str_free_call_field maps a two-arg string builtin FREE-function name to the
// method `field` lower_str_method expects (`str_split`→`split`, etc.), or "" if
// the name isn't one. Lets the free-call and method-call forms share one lowerer.
pub function str_free_call_field(name: string): string {
    if (name == "str_split") { return "split"; }
    if (name == "str_starts_with") { return "starts_with"; }
    if (name == "str_ends_with") { return "ends_with"; }
    if (name == "str_index_of") { return "index_of"; }
    return "";
}

// is_str_builtin_method reports whether `field` names a string builtin method the
// IR path lowers directly: the 0-arg transforms `to_upper` / `to_lower` (→ fresh
// string), `split` (→ string[]), and the scalar predicates starts_with /
// ends_with / index_of / contains. The caller checks arity (str_method_argc) +
// that the receiver is a string before dispatching to lower_str_method.
pub function is_str_builtin_method(field: string): boolean {
    return field == "to_upper" || field == "to_lower" || field == "trim"
        || field == "reverse" || field == "repeat" || field == "replace"
        || field == "chars" || field == "lines"
        || field == "split"
        || field == "starts_with" || field == "ends_with" || field == "index_of"
        || field == "contains";
}

// str_method_argc gives the argument count of a string builtin method: the case
// transforms are 0-arg; everything else (split + predicates) is 1-arg.
pub function str_method_argc(field: string): i32 {
    if (field == "to_upper" || field == "to_lower" || field == "trim" || field == "reverse" || field == "chars" || field == "lines") { return 0; }
    if (field == "replace") { return 2; }
    return 1;
}

// lower_str_method lowers a string builtin method `recv.<field>(args…)`: it
// lowers the receiver, then (for the 1-arg forms) the argument, then emits the
// field's op. `to_upper` / `to_lower` → a fresh cased string; `split` → string[];
// the search predicates → scalar (`contains` is `index_of(...) >= 0`). Kept out
// of lower_expr's giant FieldAccess arm to stay under the self-host backend's
// oversized-function threshold (#2720).
pub function lower_str_method(field: string, recv: parser.Expr, args: parser.Expr[], s: LowerState): LowerState {
    var p: LowerState = lower_expr(recv, s);
    if (!p.ok) { return p; }
    if (field == "to_upper") { return p.emit(ir.op_str_to_upper()); }
    if (field == "to_lower") { return p.emit(ir.op_str_to_lower()); }
    if (field == "trim") { return p.emit(ir.op_str_trim()); }
    if (field == "reverse") { return p.emit(ir.op_str_reverse()); }
    if (field == "chars") { return p.emit(ir.op_str_chars()); }
    if (field == "lines") { return p.emit(ir.op_str_lines()); }
    p = lower_expr(args[0], p);
    if (!p.ok) { return p; }
    if (field == "replace") {
        p = lower_expr(args[1], p);
        if (!p.ok) { return p; }
        return p.emit(ir.op_str_replace());
    }
    if (field == "repeat") { return p.emit(ir.op_str_repeat()); }
    if (field == "split") { return p.emit(ir.op_str_split()); }
    if (field == "starts_with") { return p.emit(ir.op_str_starts_with()); }
    if (field == "ends_with") { return p.emit(ir.op_str_ends_with()); }
    if (field == "index_of") { return p.emit(ir.op_str_index_of()); }
    // contains: index_of(sub) >= 0
    p = p.emit(ir.op_str_index_of());
    p = p.emit(ir.op_const_i32(0));
    return p.emit(ir.op_bin("ge_s", 0, false));
}

// lower_expr emits ops that leave the value of `e` on the operand stack.
pub function lower_expr(e: parser.Expr, s: LowerState): LowerState {
    if (!s.ok) { return s; }
    match (e) {
        parser.ExprNumber(n) => {
            // A float literal pushes its IEEE bit pattern (the backend assembles
            // the source text via `.double` / `f64.const`); an integer literal is
            // a 32-bit const.
            if (n.is_float) { return s.emit(ir.op_const_f64_text(n.text)); }
            // Splice the literal TEXT (handles hex `0x..` and the full u32 range,
            // like the AST path); a Fern-side decimal parse zeroes a hex literal
            // and can't represent values >= 0x80000000 as a signed i32.
            return s.emit(ir.op_const_i32_text(n.text));
        },
        parser.ExprBool(b) => {
            var v: i32 = 0;
            if (b.value) { v = 1; }
            return s.emit(ir.op_const_i32(v));
        },
        parser.ExprString(sv) => {
            // String literal → const_str (the backend interns the bytes and
            // builds its string box). Not reference-counted.
            return s.emit(ir.op_const_str(sv.value));
        },
        parser.ExprStructLit(slit) => {
            // Struct literal `P { a: .., b: .. }` and functional update
            // `P { ...base, b: v }` → struct_make. Only scalar-field (i32/boolean)
            // structs are lowered (leak-only). Every DECL field is produced in
            // decl order: an overridden field lowers its literal value; otherwise
            // (update only) it is copied from the base via struct_get. The base
            // must be a simple ident of the same struct type, so re-reading its
            // fields is side-effect-free (a complex base bails to the AST path).
            if (!decl_is_struct(s.structs, slit.type_name)) { return s.fail(); }
            if (!decl_is_leaksafe(s.structs, slit.type_name)) { return s.fail(); }
            if (slit.has_base) {
                match (slit.base) {
                    parser.ExprIdent(_) => {},
                    _ => { return s.fail(); }
                }
                if (expr_struct_type(slit.base, s) != slit.type_name) { return s.fail(); }
            }
            var ndecl: i32 = decl_field_count(s.structs, slit.type_name);
            var sm: LowerState = s;
            var di: i32 = 0;
            while (di < ndecl) {
                // find the literal field whose decl index is di (an override)
                var jj: i32 = 0;
                var found: i32 = 0 - 1;
                while (jj < slit.field_names.len()) {
                    if (s.field_index_in(slit.type_name, slit.field_names[jj]) == di) { found = jj; }
                    jj = jj + 1;
                }
                if (found >= 0) {
                    // A scalar-array field must be set from a FRESH array literal:
                    // it's then owned by the struct and never enters the local
                    // exit-sweep, so it leaks with the struct (no dangling). An
                    // aliased array (an ident / call) would be swept + freed while
                    // the struct still references it → bail to the AST path.
                    var cfft: string = decl_field_type(s.structs, slit.type_name, slit.field_names[found]);
                    if (is_leaksafe_array_field(cfft) || is_struct_array_field_type(s.structs, cfft)) {
                        match (slit.field_values[found]) {
                            parser.ExprArray(_) => {},
                            _ => { return s.fail(); }
                        }
                    }
                    // An i64 field value is an 8-byte i64 (a bare integer literal
                    // isn't self-evidently i64), so lower it via lower_i64.
                    if (struct_field_is_i64(s.structs, slit.type_name, di)) {
                        sm = lower_i64(slit.field_values[found], sm);
                    } else {
                        sm = lower_expr(slit.field_values[found], sm);
                    }
                    if (!sm.ok) { return sm; }
                } else if (slit.has_base) {
                    // copy decl field di from the base: base then struct_get(di).
                    // An i64 field copies 8 bytes (struct_get_i64).
                    sm = lower_expr(slit.base, sm);
                    if (!sm.ok) { return sm; }
                    if (struct_field_is_i64(s.structs, slit.type_name, di)) { sm = sm.emit(ir.op_struct_get_i64(di)); }
                    else { sm = sm.emit(ir.op_struct_get(di, struct_field_width(s.structs, slit.type_name, di))); }
                } else {
                    // a non-update literal must set every field
                    return s.fail();
                }
                di = di + 1;
            }
            return sm.emit(ir.op_struct_make(slit.type_name, ndecl));
        },
        parser.ExprFieldAccess(fa) => {
            // Numeric field `t.0` / `t.1` → tuple element access (no shape slot,
            // element i at slot i). The receiver must be a tuple; a non-tuple
            // numeric access can't type-check, so this is unambiguous.
            if (util.is_all_digits(fa.field)) {
                var tgi: i32 = util.digits_to_i32(fa.field);
                var so0: LowerState = lower_expr(fa.obj, s);
                if (!so0.ok) { return so0; }
                // An 8-byte element (i64 / f64) reads with the matching load; an
                // i64 element in an i32 context is a checker error (the valid i64
                // read routes through lower_i64). i32 / string / struct elements
                // keep the 4-byte read.
                var tgt: string = expr_tuple_elem_tag(fa.obj, tgi, s);
                if (tgt == "i64") { return so0.emit(ir.op_tuple_get_w(tgi, 64, true)); }
                if (tgt == "f64") { return so0.emit(ir.op_tuple_get_w(tgi, 64, false)); }
                return so0.emit(ir.op_tuple_get(tgi));
            }
            // Qualified UNIT-variant value `Enum.Variant` (no call) — the same
            // value as the bare unit variant `Variant`: a 0-field variant box via
            // struct_make. (The payload form `Enum.Variant(args)` is handled in
            // ExprCall.) `fa.field` must be a known variant whose enum_owner is the
            // bare type name in `fa.obj` (not a local), so this is unambiguous.
            var uvowner: string = variant_enum_owner(s.structs, fa.field);
            if (uvowner != "") {
                match (fa.obj) {
                    parser.ExprIdent(uvid) => {
                        if (uvid.name == uvowner && s.slot_of(uvid.name) < 0
                            && decl_field_count(s.structs, fa.field) == 0) {
                            return s.emit(ir.op_struct_make(fa.field, 0));
                        }
                    },
                    _ => {}
                }
            }
            // Bare struct field read `p.x` → struct_get at x's decl index. (As a
            // call receiver — `p.len()` — field access is handled in ExprCall; a
            // bare field access reaching here is a value.)
            var sty: string = expr_struct_type(fa.obj, s);
            if (sty == "") { return s.fail(); }
            var idx: i32 = s.field_index_in(sty, fa.field);
            if (idx < 0) { return s.fail(); }
            var so: LowerState = lower_expr(fa.obj, s);
            if (!so.ok) { return so; }
            // An i64 field reads an 8-byte integer (i64.load); f64 an 8-byte
            // float; i32 the 4-byte path. (An i64 field in an i32 context is a
            // checker error; a valid i64 read routes through lower_i64 below.)
            if (struct_field_is_i64(s.structs, sty, idx)) { return so.emit(ir.op_struct_get_i64(idx)); }
            return so.emit(ir.op_struct_get(idx, struct_field_width(s.structs, sty, idx)));
        },
        parser.ExprIdent(id) => {
            var slot: i32 = s.slot_of(id.name);
            if (slot >= 0) { return s.emit(ir.op_load_local(slot)); }
            // The empty Option `None` → a payloadless box with tag 1.
            if (id.name == "None") { return s.emit(ir.op_opt_none()); }
            // A bare struct name that isn't a local is a no-payload enum variant
            // value (e.g. `Red`, `Empty`): a 0-field variant box via struct_make.
            if (decl_is_struct(s.structs, id.name) && decl_field_count(s.structs, id.name) == 0) {
                return s.emit(ir.op_struct_make(id.name, 0));
            }
            // A bare identifier that is not a local naming a ZERO-ARG,
            // receiver-less function (a `const`, desugared to such a function) is
            // a CALL to it — its value. Mirrors asm.fern's ExprIdent rule
            // (zero-arg receiver-less -> call).
            if (s.is_const_fn(id.name)) { return s.emit(ir.op_call_direct(id.name, 0)); }
            // A bare ident naming a module function WITH params is a function
            // VALUE — a plain (capture-free) function pointer (`var f = dbl;
            // f(21)`, `return namedfn`). Emit const_func; const_funcs_only_known
            // bails the module if the name isn't a known function, so an
            // unknown / non-function ident (which the checker would already have
            // rejected) never miscompiles. Mirrors asm.fern's ExprIdent rule
            // (zero-arg receiver-less -> call; >0-arg -> boxed fn-value). A call
            // through the resulting fn-value local rides the existing
            // call_indirect path (the same one a "fn"-typed param uses).
            return s.emit(ir.op_const_func(0, id.name));
        },
        parser.ExprBinary(b) => {
            // Short-circuit `&&` / `||`. When the RIGHT operand is trap-free and
            // side-effect-free, eagerly evaluating it is unobservable, so the
            // logical op is just a bitwise `&` / `|` of the two boolean (0/1)
            // values — no value-producing `if` needed. The left operand is always
            // evaluated, so it may be anything lowerable. A right operand with a
            // call / index / division (where skipping it matters) bails to the AST
            // path, which does proper control-flow short-circuiting.
            if (b.op == "&&" || b.op == "||") {
                var scop: string = "and";
                if (b.op == "||") { scop = "or"; }
                // Fast path: a trap-free, side-effect-free RHS is just `&` / `|`
                // of the two boolean (0/1) values — no control flow needed.
                if (is_eager_safe(b.right)) {
                    var lsc: LowerState = lower_expr(b.left, s);
                    if (!lsc.ok) { return lsc; }
                    var rsc: LowerState = lower_expr(b.right, lsc);
                    if (!rsc.ok) { return rsc; }
                    return rsc.emit(ir.op_bin(scop, 0, false));
                }
                // Short-circuit: the RHS may call / index / divide (where NOT
                // evaluating it matters), so guard it behind the LHS via a temp
                // local + a block (the proven match-arm control shape):
                //   tmp = L
                //   block { load tmp; [&& only: not]; br_if 0; tmp = R }
                //   load tmp          // result = L ? R : L  (&&) / L ? L : R (||)
                // For `&&` we skip R when L is FALSE (load L, not, br_if); for
                // `||` we skip R when L is TRUE (load L, br_if). tmp then holds
                // L on the skip path (the short-circuit value) and R otherwise.
                var sl0: LowerState = lower_expr(b.left, s);
                if (!sl0.ok) { return sl0; }
                var scn: string = "$sc" + util.i32_to_string(sl0.local_names.len());
                sl0 = sl0.add_local(scn);
                var scslot: i32 = sl0.slot_of(scn);
                sl0 = sl0.emit(ir.op_store_local(scslot));
                sl0 = sl0.emit(ir.op_block(0));
                sl0 = sl0.emit(ir.op_load_local(scslot));
                if (b.op == "&&") { sl0 = sl0.emit(ir.op_bin("not", 0, false)); }
                sl0 = sl0.emit(ir.op_brif(0));
                var sr0: LowerState = lower_expr(b.right, sl0);
                if (!sr0.ok) { return sr0; }
                sr0 = sr0.emit(ir.op_store_local(scslot));
                sr0 = sr0.emit(ir.op_end());
                return sr0.emit(ir.op_load_local(scslot));
            }
            // String dispatch: on string operands, `+` is concat and `==`/`!=`
            // are byte-equality (str_eq, then `not` for `!=`). Ordering compares
            // (`<` `>` `<=` `>=`) lower to str_cmp (signed -/0/+) followed by the
            // relational op against 0.
            if (expr_is_str(b.left, s) || expr_is_str(b.right, s)) {
                if (b.op == "+" || b.op == "==" || b.op == "!=") {
                    var sl: LowerState = lower_expr(b.left, s);
                    if (!sl.ok) { return sl; }
                    var sr: LowerState = lower_expr(b.right, sl);
                    if (!sr.ok) { return sr; }
                    if (b.op == "+") { return sr.emit(ir.op_str_concat()); }
                    var se: LowerState = sr.emit(ir.op_str_eq());
                    if (b.op == "!=") { return se.emit(ir.op_bin("not", 0, false)); }
                    return se;
                }
                if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                    var cl: LowerState = lower_expr(b.left, s);
                    if (!cl.ok) { return cl; }
                    var cr: LowerState = lower_expr(b.right, cl);
                    if (!cr.ok) { return cr; }
                    // str_cmp(a,b) <rel> 0
                    var cc: LowerState = cr.emit(ir.op_str_cmp());
                    cc = cc.emit(ir.op_const_i32(0));
                    return cc.emit(ir.op_bin(map_binop(b.op), 0, false));
                }
                return s.fail();
            }
            // f64 dispatch: float operands lower as f64 (their bit pattern flows
            // on the rt-stack) and use the float ops. Arithmetic (+ - * /) yields
            // f64; a comparison yields an i32 bool. `%` / bitwise / shifts have no
            // float form (map_fbinop = "") and bail to the AST path.
            if (expr_is_f64(b.left, s) || expr_is_f64(b.right, s)) {
                var fk: string = map_fbinop(b.op);
                if (fk == "") { return s.fail(); }
                var fl: LowerState = lower_expr(b.left, s);
                if (!fl.ok) { return fl; }
                // An i32 operand mixed with an f64 (e.g. `3.5 + 2`) must be
                // widened to f64 first — otherwise op_fbin sees an i32 on the
                // stack and the wasm module fails to validate (f64.add expects
                // two f64s). i32_to_f64 is f64.convert_i32_s. Only a 32-bit
                // non-f64 operand is converted; an i64 in f64 context is left
                // alone (unsupported, bails like before).
                if (!expr_is_f64(b.left, s) && infer_expr_width(b.left, s) != 64) {
                    fl = fl.emit(ir.op_i32_to_f64());
                }
                var fr: LowerState = lower_expr(b.right, fl);
                if (!fr.ok) { return fr; }
                if (!expr_is_f64(b.right, s) && infer_expr_width(b.right, s) != 64) {
                    fr = fr.emit(ir.op_i32_to_f64());
                }
                return fr.emit(ir.op_fbin(fk));
            }
            var kind: string = map_binop(b.op);
            if (kind == "") { return s.fail(); }
            // i64 dispatch: if either operand is an i64 value, the operands are
            // lowered as i64 and the op runs at 64-bit width. Arithmetic
            // (including div/rem) yields i64; a comparison yields an i32 bool (the
            // backend knows from the kind).
            if (infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64) {
                var li: LowerState = lower_i64(b.left, s);
                if (!li.ok) { return li; }
                var ri: LowerState = lower_i64(b.right, li);
                if (!ri.ok) { return ri; }
                // u64 operands take the UNSIGNED i64 ops (compare / >> / div / rem)
                // — signed versions are wrong once bit 63 is set (#2904). A shift's
                // signedness follows the left (shifted) operand; compare/div use
                // either side. add/sub/mul/and/or/xor/shl/eq/ne are sign-agnostic.
                var i64k: string = kind;
                var lu: boolean = expr_is_u64(b.left, s);
                if (b.op == ">>" || b.op == "<<") {
                    if (lu) { i64k = to_unsigned_kind(kind); }
                } else if (lu || expr_is_u64(b.right, s)) {
                    i64k = to_unsigned_kind(kind);
                }
                return ri.emit(ir.op_bin(i64k, 64, false));
            }
            var s1: LowerState = lower_expr(b.left, s);
            if (!s1.ok) { return s1; }
            var s2: LowerState = lower_expr(b.right, s1);
            if (!s2.ok) { return s2; }
            // u32 wrapping: a u32 `>>` is a LOGICAL shift (shr_u); a u32
            // arithmetic op whose value can exceed 32 bits (+ - * <<) is masked
            // back to 32 bits on the register backends (no-op on wasm's native
            // i32). Native wraps every u32 op at 2^32; without this u32-heavy
            // code (the SHA-256 schedule / __rotr) kept stray high bits.
            var ek: string = kind;
            var left_u32: boolean = expr_is_u32(b.left, s);
            var right_u32: boolean = expr_is_u32(b.right, s);
            if (b.op == ">>" && left_u32) { ek = "shr_u"; }
            // u32 ORDERING compares need the UNSIGNED IR kind (lt_u/le_u/gt_u/
            // ge_u): a u32 value ≥ 2^31 is signed-negative in a 32-bit slot, so a
            // signed compare gives the wrong answer on wasm. Remap via the same
            // to_unsigned_kind path u64 uses (#2904); the wasm backend then emits
            // i32.*_u and asm_ir emits setb/seta — both correct for a u32. eq/ne
            // are sign-agnostic and pass through. (#2917)
            if ((left_u32 || right_u32) && (kind == "lt_s" || kind == "le_s" || kind == "gt_s" || kind == "ge_s")) {
                ek = to_unsigned_kind(kind);
            }
            var res: LowerState = s2.emit(ir.op_bin(ek, 0, false));
            var res_u32: boolean = left_u32 || right_u32;
            if (res_u32 && (kind == "add" || kind == "sub" || kind == "mul" || kind == "shl")) {
                res = res.emit(ir.op_u32_wrap());
            }
            return res;
        },
        parser.ExprUnary(u) => {
            // Try-operator `inner?` (parser desugar: unary "try_"). Unwrap the
            // Some/Ok payload as the expression's value, or early-return the
            // None/Err box from the enclosing Option/Result-returning function.
            if (u.op == "try_") { return lower_try(u.operand, s); }
            if (u.op == "-") {
                if (expr_is_f64(u.operand, s)) {
                    // -x  ==  0.0 - x  (float negate).
                    var fz: LowerState = s.emit(ir.op_const_f64_text("0"));
                    var fx: LowerState = lower_expr(u.operand, fz);
                    if (!fx.ok) { return fx; }
                    return fx.emit(ir.op_fbin("fsub"));
                }
                // -x  ==  0 - x  : push 0, push x, sub.
                var sz: LowerState = s.emit(ir.op_const_i32(0));
                var sx: LowerState = lower_expr(u.operand, sz);
                if (!sx.ok) { return sx; }
                return sx.emit(ir.op_bin("sub", 0, false));
            }
            if (u.op == "!") {
                var so: LowerState = lower_expr(u.operand, s);
                if (!so.ok) { return so; }
                return so.emit(ir.op_bin("not", 0, false));
            }
            // `x as f64`: int -> float widen (cvtsi2sd). An already-f64 operand
            // is a no-op. (f32/float spellings ride the same f64 path.)
            if (u.op == "as_f64" || u.op == "as_f32" || u.op == "as_float") {
                if (expr_is_f64(u.operand, s)) { return lower_expr(u.operand, s); }
                var sf: LowerState = lower_expr(u.operand, s);
                if (!sf.ok) { return sf; }
                return sf.emit(ir.op_i32_to_f64());
            }
            // Int→int width cast `x as <ty>` for a 32-bit-or-narrower target
            // (i32 / u32 / u8 / i8 / u16 / i16). The masking/extension matches
            // asm.fern's `as_<ty>` exactly (int_cast op). The operand may be an
            // f64 (truncate toward zero via f64_to_i32, THEN mask), an i64
            // (narrow via int_wrap, THEN mask), or a 32-bit int (mask directly).
            if (u.op == "as_i32" || u.op == "as_u32" || u.op == "as_u8" || u.op == "as_i8" || u.op == "as_u16" || u.op == "as_i16") {
                var cty: string = u.op[3 : u.op.len()];
                if (expr_is_f64(u.operand, s)) {
                    var fc: LowerState = lower_expr(u.operand, s);
                    if (!fc.ok) { return fc; }
                    fc = fc.emit(ir.op_f64_to_i32());
                    return fc.emit(ir.op_int_cast(cty));
                }
                if (infer_expr_width(u.operand, s) == 64) {
                    var i64c: LowerState = lower_i64(u.operand, s);
                    if (!i64c.ok) { return i64c; }
                    i64c = i64c.emit(ir.op_int_wrap(true));
                    return i64c.emit(ir.op_int_cast(cty));
                }
                var sn: LowerState = lower_expr(u.operand, s);
                if (!sn.ok) { return sn; }
                return sn.emit(ir.op_int_cast(cty));
            }
            // `E as T` type ascription (#2669) in a non-binding position
            // (return / argument / nested expr): the `as` is a zero-cost
            // identity annotation, so the value of `E as T` is exactly the
            // value of `E`. The binding form `var x = E as T` is intercepted
            // earlier in lower_stmt (rewritten to a `var x: T = E` rebind, so
            // the slot keeps its typed alias-inc); here there is no slot store,
            // so lowering the operand directly is RC-sound — it yields the same
            // value with the same ownership `E` alone would. Numeric
            // conversions (as_i32 / as_f64 / …) are handled above and keep
            // their value-converting path; an unsupported operand (e.g. a bare
            // `None` to an Option target) makes lower_expr bail, and the caller
            // falls back to the AST path.
            // `e as? T` fallible downcast (docs/DYN-TRAITS.md §9): the parser
            // tags this `as?_<T>`. `e` is a `dyn Trait` value (a heap pointer
            // carrying its concrete shape at offset 0); lower it, then
            // op_dyn_downcast reads that shape, compares to T's interned shape,
            // and yields Some(e) on an exact match / None otherwise — an
            // ordinary Option box a downstream `match` reads normally. The
            // self-host checker is permissive here (the Go checker is the strict
            // §9 gate), so we don't re-validate the dyn/impl relationship.
            if (u.op.len() > 4 && u.op[0:4] == "as?_") {
                var dcs: LowerState = lower_expr(u.operand, s);
                if (!dcs.ok) { return dcs; }
                return dcs.emit(ir.op_dyn_downcast(u.op[4 : u.op.len()]));
            }
            if (u.op.len() > 3 && u.op[0:3] == "as_" && !is_numeric_cast_op(u.op)) {
                return lower_expr(u.operand, s);
            }
            return s.fail();
        },
        parser.ExprArray(arr) => {
            // i32 array literal → the high-level `arr_make n` op. Each element
            // expr is lowered (pushing its i32 value, element 0 deepest), then
            // `arr_make` allocates the array, initialises its rc/len header and
            // fills the elements, and leaves the data pointer on the stack. The
            // BYTE layout (slot width, header shape, rc offset) is the
            // backend's choice — irlower commits only to the semantics. (Fresh
            // literal: owned at rc=1, no alias-inc.) Elements must be i32 or the
            // element lowering bails.
            var n: i32 = arr.elements.len();
            // Element WIDTH selects the array stride: an f64 element array uses
            // an 8-byte stride (arr_make width 64; the wasm backend allocates
            // n*8 and f64.stores each element), everything else the 4-byte i32 /
            // wasm32-pointer path. (The register backends use 8-byte slots
            // regardless — width only steers wasm.) The slot binding tracks
            // f64-array-ness (local_is_f64arr) so a[i] reads an 8-byte f64.
            var ewidth: i32 = 32;
            if (n > 0 && expr_is_f64(arr.elements[0], s)) { ewidth = 64; }
            // i32[] / string[] / f64[] literals are all supported: an i32 element
            // lowers to its value, a string element to its box pointer (const_str
            // etc.), an f64 element to its 8-byte bit pattern. The slot binding
            // tracks string[]- / f64[]-ness so a[i] types correctly; the array is
            // rc-tracked like any array and its string elements leak.
            var sa: LowerState = s;
            var i: i32 = 0;
            while (i < n) {
                sa = lower_expr(arr.elements[i], sa);
                if (!sa.ok) { return sa; }
                i = i + 1;
            }
            return sa.emit(ir.op_arr_make(n, ewidth));
        },
        parser.ExprTuple(tup) => {
            // Tuple literal `(a, b, …)` → tuple_make. Scalar elements only
            // (leak-only); a heap element bails to the AST path. Elements lower
            // in source order (element 0 deepest), then tuple_make boxes them.
            var tn: i32 = tup.elements.len();
            if (tn == 0) { return s.fail(); }
            // Scalar, string, struct, and i32[] array elements are allowed (leak
            // mode: each is one pointer-or-scalar slot, stored pointer-safely).
            // An i32[] element rides one slot as its data pointer; `t.N` recovers
            // it via tuple_get, and array ops only need that pointer (no extra
            // element-tag plumbing — deliberately NOT broadening the shared
            // elem_type_tag, which feeds tuple destructure / arg sites too).
            // string[] / f64[] / i64[] arrays, nested tuples, and other heap
            // elements still bail.
            var tei: i32 = 0;
            while (tei < tn) {
                var el: parser.Expr = tup.elements[tei];
                var el_arr_ok: boolean = expr_is_arr_src(el, s)
                    && !expr_is_strarr(el, s) && !expr_is_f64arr(el, s) && !expr_is_i64arr(el, s);
                // An Option element (`(Some(7), 3)`) is a leak-only box stored in
                // one pointer slot, like a string / struct element — admit it (its
                // "Option[T]" tag lets `match (t.N)` recover the payload). #3018.
                var el_opt_ok: boolean = expr_opt_elem_tag(el, s) != "";
                if (expr_is_nonscalar(el, s) && !expr_is_str(el, s) && expr_struct_type(el, s) == "" && !el_arr_ok && !el_opt_ok) { return s.fail(); }
                tei = tei + 1;
            }
            // Build the per-element KIND string (i32 / i64 / f64 / string / <struct>)
            // so the wasm backend stores each at the right width, and lower an
            // i64 element via lower_i64 (8-byte i64 value); f64 / i32 / string /
            // struct elements ride lower_expr.
            var tkinds: string = "";
            var ts: LowerState = s;
            var tj: i32 = 0;
            while (tj < tn) {
                var tek: string = elem_type_tag(tup.elements[tj], ts);
                if (tj > 0) { tkinds = tkinds + ","; }
                tkinds = tkinds + tek;
                if (tek == "i64") { ts = lower_i64(tup.elements[tj], ts); }
                else { ts = lower_expr(tup.elements[tj], ts); }
                if (!ts.ok) { return ts; }
                tj = tj + 1;
            }
            return ts.emit(ir.op_tuple_make_k(tn, tkinds));
        },
        parser.ExprIndex(ix) => {
            // arr[idx] → lower the array (base) then the index, then `arr_get`
            // (the backend computes the element address for its layout). String
            // indexing `s[i]` reads a byte → `str_index` (an i32 byte value);
            // it shares the lower-array-then-index shape, just a different op.
            var sidx: LowerState = lower_expr(ix.array, s);
            if (!sidx.ok) { return sidx; }
            sidx = lower_expr(ix.index, sidx);
            if (!sidx.ok) { return sidx; }
            if (expr_is_str(ix.array, s)) { return sidx.emit(ir.op_str_index()); }
            // Element width from the array's slot: an f64[] reads an 8-byte f64
            // (arr_get width 64 → f64.load on wasm); i32[] / string[] the 4-byte
            // i32 path. expr_is_f64's ExprIndex case mirrors this so the result
            // types as f64 downstream.
            var gw: i32 = 32;
            if (arr_index_is_f64(ix.array, s)) { gw = 64; }
            return sidx.emit(ir.op_arr_get(gw));
        },
        parser.ExprSlice(slc) => {
            // `s[start:end]` lowers [src, start, end] then `str_slice` (a fresh
            // string) or `arr_slice` (a fresh array) depending on the source. A
            // non-string, non-array source bails. (The binding is `slc`, not `sl`:
            // other arms bind `var sl: LowerState`, and the compiler's scope-blind
            // locals collapse same-named locals of different types.)
            var slc_is_str: boolean = expr_is_str(slc.array, s);
            if (!slc_is_str && !expr_is_arr_src(slc.array, s)) { return s.fail(); }
            // An f64[] or i64[] slice copies 8-byte elements (arr_slice width 64
            // → the wasm $__fern_arr_slice8 helper, a raw 8-byte move that serves
            // both); i32[] / string[] copy 4-byte elements. The result is a fresh
            // f64[]/i64[], marked at the var binding via expr_is_f64arr /
            // expr_is_i64arr's ExprSlice cases.
            var slc_w: i32 = 32;
            if (expr_is_f64arr(slc.array, s) || expr_is_i64arr(slc.array, s)) { slc_w = 64; }
            var ssl: LowerState = lower_expr(slc.array, s);
            if (!ssl.ok) { return ssl; }
            ssl = lower_expr(slc.start, ssl);
            if (!ssl.ok) { return ssl; }
            ssl = lower_expr(slc.end, ssl);
            if (!ssl.ok) { return ssl; }
            if (slc_is_str) { return ssl.emit(ir.op_str_slice()); }
            return ssl.emit(ir.op_arr_slice(slc_w));
        },
        parser.ExprCall(c) => {
            // Direct call (bare-name callee, up to 6 args), or the `.len()`
            // receiver method (field-access callee), which reads the array's
            // length header at base.
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // Indirect call through a function VALUE: `f(args)` where `f`
                    // names a local/param slot (a "fn"-typed value), not a
                    // top-level function. A local shadows any same-named function,
                    // so a resolvable slot means the callee is the value held
                    // there. Lower the args, push the function value, then
                    // call_indirect (the backend pops the fn pointer from TOS and
                    // the args beneath it).
                    // Closure-call (slice 3a): the callee is a closure LOCAL — an
                    // i32[] env box [funcval, caps…]. Env-first: push the box (the
                    // __env first arg), the declared args, then the funcval
                    // (box[0]) as the call target, and call_indirect with arity+1
                    // to the hoisted `<fn>$clo(__env, params…)`.
                    if (s.is_closure_local(cid.name)) {
                        var clslot: i32 = s.slot_of(cid.name);
                        var cls: LowerState = s.emit(ir.op_load_local(clslot));
                        var cla: i32 = 0;
                        while (cla < c.args.len()) {
                            cls = lower_expr(c.args[cla], cls);
                            if (!cls.ok) { return cls; }
                            cla = cla + 1;
                        }
                        cls = cls.emit(ir.op_load_local(clslot));
                        cls = cls.emit(ir.op_const_i32(0));
                        cls = cls.emit(ir.op_arr_get(32));
                        return cls.emit(ir.op_call_indirect(c.args.len() + 1));
                    }
                    var icslot: i32 = s.slot_of(cid.name);
                    if (icslot >= 0) {
                        var ics: LowerState = s;
                        var ica: i32 = 0;
                        while (ica < c.args.len()) {
                            ics = lower_expr(c.args[ica], ics);
                            if (!ics.ok) { return ics; }
                            ica = ica + 1;
                        }
                        ics = ics.emit(ir.op_load_local(icslot));
                        return ics.emit(ir.op_call_indirect(c.args.len()));
                    }
                    // __rc(arr): read the refcount header at base-4 (an RC
                    // observation hook for tests; not a real callee).
                    if (cid.name == "__rc") {
                        if (c.args.len() != 1) { return s.fail(); }
                        var sr: LowerState = lower_expr(c.args[0], s);
                        if (!sr.ok) { return sr; }
                        return sr.emit(ir.op_arr_rc());
                    }
                    // __rc_dec(a): manual release (a test hook for exercising
                    // the underflow detector); returns the pointer.
                    if (cid.name == "__rc_dec") {
                        if (c.args.len() != 1) { return s.fail(); }
                        var sd: LowerState = lower_expr(c.args[0], s);
                        if (!sd.ok) { return sd; }
                        return sd.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    }
                    // __rc_underflow(): read the over-release counter.
                    if (cid.name == "__rc_underflow") {
                        if (c.args.len() != 0) { return s.fail(); }
                        return s.emit(ir.op_call_direct("__fern_rc_underflow_get", 0));
                    }
                    // __heap_used(): bytes bump-allocated so far (reuse from the
                    // freelist does NOT bump, so this measures peak growth — the
                    // reclamation win).
                    if (cid.name == "__heap_used") {
                        if (c.args.len() != 0) { return s.fail(); }
                        return s.emit(ir.op_call_direct("__fern_heap_used", 0));
                    }
                    // __alloc_u8(n): a fresh n-element byte array (8-byte slots,
                    // len = n; contents NOT zeroed). string_from_bytes(arr) packs
                    // each slot's low byte into a string box. Both lower to a
                    // dedicated op the IR backends emit as the same __fern_* call
                    // the AST path uses.
                    if (cid.name == "__alloc_u8" && c.args.len() == 1) {
                        var au: LowerState = lower_expr(c.args[0], s);
                        if (!au.ok) { return au; }
                        return au.emit(ir.op_alloc_u8());
                    }
                    // std/float single-instruction math builtins: __sqrt_f64 /
                    // __floor_f64 / __ceil_f64 / __trunc_f64 / __abs_f64. Lower the
                    // f64 operand, then emit the op_funary intrinsic the IR backends
                    // select a single hardware instruction for.
                    var fuk: string = f64_math_builtin_kind(cid.name);
                    if (fuk != "" && c.args.len() == 1) {
                        var fu: LowerState = lower_expr(c.args[0], s);
                        if (!fu.ok) { return fu; }
                        return fu.emit(ir.op_funary(fuk));
                    }
                    if (cid.name == "string_from_bytes" && c.args.len() == 1) {
                        var sfb: LowerState = lower_expr(c.args[0], s);
                        if (!sfb.ok) { return sfb; }
                        return sfb.emit(ir.op_str_from_bytes());
                    }
                    // random_bytes(n): a fresh string of n CSPRNG bytes. The
                    // result is a string box (str_index reads the bytes); the
                    // IR backends emit the __fern_random_bytes helper.
                    if (cid.name == "random_bytes" && c.args.len() == 1) {
                        var rb: LowerState = lower_expr(c.args[0], s);
                        if (!rb.ok) { return rb; }
                        return rb.emit(ir.op_random_bytes());
                    }
                    // random_i32(): a single CSPRNG i32.
                    if (cid.name == "random_i32" && c.args.len() == 0) {
                        return s.emit(ir.op_random_i32());
                    }
                    // monotonic_ns() / now_unix_ms(): 0-arg i64 clock readings.
                    // Each lowers to a dedicated op the IR backends emit as a
                    // call into the same __fern_* runtime helper the AST path
                    // uses (no allocation; the i64 result rides %rax / x0).
                    if (cid.name == "monotonic_ns" && c.args.len() == 0) {
                        return s.emit(ir.op_monotonic_ns());
                    }
                    if (cid.name == "now_unix_ms" && c.args.len() == 0) {
                        return s.emit(ir.op_now_unix_ms());
                    }
                    if (cid.name == "now_ns" && c.args.len() == 0) {
                        return s.emit(ir.op_now_ns());
                    }
                    if (decl_is_struct(s.structs, cid.name)) {
                        if (!decl_is_leaksafe(s.structs, cid.name)) { return s.fail(); }
                        // Array-payload variant construction isn't in this slice
                        // (the fresh-literal constraint is only wired for struct
                        // literals) — defer to AST.
                        if (c.args.len() != decl_field_count(s.structs, cid.name)) { return s.fail(); }
                        var vctor: LowerState = s;
                        var vi: i32 = 0;
                        while (vi < c.args.len()) {
                            // An i64 payload field is an 8-byte i64 value (a bare
                            // integer literal isn't self-evidently i64), so lower it
                            // via lower_i64; struct_make 64-bit-stores it (it reads
                            // the field type). f64 / i32 / string / struct payloads
                            // ride lower_expr.
                            if (struct_field_is_i64(s.structs, cid.name, vi)) { vctor = lower_i64(c.args[vi], vctor); }
                            else { vctor = lower_expr(c.args[vi], vctor); }
                            if (!vctor.ok) { return vctor; }
                            vi = vi + 1;
                        }
                        return vctor.emit(ir.op_struct_make(cid.name, c.args.len()));
                    }
                    if ((cid.name == "map_new" || cid.name == "map_new_i32") && c.args.len() == 1) {
                        var mn: LowerState = lower_expr(c.args[0], s);
                        if (!mn.ok) { return mn; }
                        var mkk: i32 = 0;
                        if (cid.name == "map_new_i32") { mkk = 1; }
                        return mn.emit(ir.op_map_new(mkk));
                    }
                    // Built-in Option / Result construction: Some(x)/Ok(x) wrap a
                    // payload with tag 0, Err(x) with tag 1 (None is a bare ident,
                    // handled in lower_expr's ExprIdent arm). The box is
                    // [tag@0, payload@8] — type-agnostic, so the payload may be any
                    // 8-byte value.
                    if ((cid.name == "Some" || cid.name == "Ok") && c.args.len() == 1) {
                        var sptag: string = elem_type_tag(c.args[0], s);
                        var so: LowerState = s;
                        if (sptag == "i64") { so = lower_i64(c.args[0], so); } else { so = lower_expr(c.args[0], so); }
                        if (!so.ok) { return so; }
                        if (sptag == "i64") { return so.emit(ir.op_opt_make_w(0, 64, true)); }
                        if (sptag == "f64") { return so.emit(ir.op_opt_make_w(0, 64, false)); }
                        return so.emit(ir.op_opt_make(0));
                    }
                    if (cid.name == "Err" && c.args.len() == 1) {
                        var eptag: string = elem_type_tag(c.args[0], s);
                        var se: LowerState = s;
                        if (eptag == "i64") { se = lower_i64(c.args[0], se); } else { se = lower_expr(c.args[0], se); }
                        if (!se.ok) { return se; }
                        if (eptag == "i64") { return se.emit(ir.op_opt_make_w(1, 64, true)); }
                        if (eptag == "f64") { return se.emit(ir.op_opt_make_w(1, 64, false)); }
                        return se.emit(ir.op_opt_make(1));
                    }
                    // Built-in `print_int(n)` — write n's decimal text to stdout
                    // (no newline). Lowers the i32 arg then op_print_int, which each
                    // backend emits as a call into the same __fern_print_int runtime
                    // helper the AST path uses. A reserved builtin name (like
                    // map_new / Some / len), so it never shadows a user function.
                    if (cid.name == "print_int" && c.args.len() == 1) {
                        // An i64 argument must keep its full 64 bits: lower it via
                        // lower_i64 and print through the wider op (op_print_i64 →
                        // $__fern_print_int64), mirroring the AST path's print_int64
                        // dispatch. Passing an i64 to the i32 $__fern_print_int would
                        // be a wasm type mismatch (invalid module).
                        if (infer_expr_width(c.args[0], s) == 64) {
                            var pi64: LowerState = lower_i64(c.args[0], s);
                            if (!pi64.ok) { return pi64; }
                            return pi64.emit(ir.op_print_i64());
                        }
                        var pis: LowerState = lower_expr(c.args[0], s);
                        if (!pis.ok) { return pis; }
                        return pis.emit(ir.op_print_int());
                    }
                    // Built-in `putchar(c)` — write c's low byte to stdout
                    // (write(1, &byte, 1), no newline). Lowers the i32 arg then
                    // op_putchar, which each backend emits as a call into the same
                    // __fern_putchar runtime the native compiler uses. A reserved
                    // builtin (the checker already knows it), so it never shadows a
                    // user function. Issue #2839 — self-host putchar IR support.
                    if (cid.name == "putchar" && c.args.len() == 1) {
                        var pcs: LowerState = lower_expr(c.args[0], s);
                        if (!pcs.ok) { return pcs; }
                        return pcs.emit(ir.op_putchar());
                    }
                    // Built-in `sleep_ms(ms)` — pause for `ms` milliseconds
                    // (no-op if ms <= 0). Lowers the i32 arg then op_sleep_ms,
                    // which the x86-64 / arm64 backends emit as a call into the
                    // __fern_sleep_ms nanosleep helper. A reserved builtin, so it
                    // never shadows a user function (#2843 — self-host IR path).
                    if (cid.name == "sleep_ms" && c.args.len() == 1) {
                        var sms: LowerState = lower_expr(c.args[0], s);
                        if (!sms.ok) { return sms; }
                        return sms.emit(ir.op_sleep_ms());
                    }
                    // Built-in `write(s)` / `print(s)` — write a string's bytes to
                    // stdout. `print` appends a newline (Fern's print == println):
                    // it desugars to `print_str(s + "\n")` via the existing str_concat
                    // op, so a single print_str op + helper serves both. The arg is a
                    // string (the checker guarantees it for these builtins).
                    if ((cid.name == "write" || cid.name == "print_str") && c.args.len() == 1) {
                        var wss: LowerState = lower_expr(c.args[0], s);
                        if (!wss.ok) { return wss; }
                        return wss.emit(ir.op_print_str());
                    }
                    if (cid.name == "print" && c.args.len() == 1) {
                        var prs: LowerState = lower_expr(c.args[0], s);
                        if (!prs.ok) { return prs; }
                        prs = prs.emit(ir.op_const_str("\n"));
                        prs = prs.emit(ir.op_str_concat());
                        return prs.emit(ir.op_print_str());
                    }
                    // Built-in `read_int()` — read a line from stdin, parse a leading
                    // optional-sign decimal, push the i32. A value op (leaves the
                    // result on the stack). No wasm stdin support, so wasm_eligible
                    // rejects read_int modules; x86 / arm64 lower it.
                    if (cid.name == "read_int" && c.args.len() == 0) {
                        return s.emit(ir.op_read_int());
                    }
                    // Built-in `read_line()` — read one line from stdin, return a
                    // fresh string box. A value op; the binding str-tracks the
                    // result (expr_is_str's read_line case). No wasm stdin support,
                    // so wasm_eligible rejects read_line modules; x86 / arm64 lower it.
                    if (cid.name == "read_line" && c.args.len() == 0) {
                        return s.emit(ir.op_read_line());
                    }
                    // Built-in `eprint(s)` — write a string's bytes to stderr (fd 2,
                    // no newline). `eprint_int(n)` is its int companion: i32_to_string
                    // then eprint_str (no third helper). Both lower to op_eprint_str.
                    if (cid.name == "eprint" && c.args.len() == 1) {
                        var eps: LowerState = lower_expr(c.args[0], s);
                        if (!eps.ok) { return eps; }
                        return eps.emit(ir.op_eprint_str());
                    }
                    if (cid.name == "eprint_int" && c.args.len() == 1) {
                        var eis: LowerState = lower_expr(c.args[0], s);
                        if (!eis.ok) { return eis; }
                        eis = eis.emit(ir.op_call_direct("__fern_i32_to_string", 1));
                        return eis.emit(ir.op_eprint_str());
                    }
                    // Built-in `exit(n)` — terminate the process with exit code n
                    // (an inline sys_exit / proc_exit per backend).
                    if (cid.name == "exit" && c.args.len() == 1) {
                        var xs: LowerState = lower_expr(c.args[0], s);
                        if (!xs.ok) { return xs; }
                        return xs.emit(ir.op_exit());
                    }
                    // Built-in `len(x)` — the free-function spelling of `.len()`:
                    // a string reads the box's length field (str_len), an array
                    // the header (arr_len). Mirrors the `.len()` method dispatch
                    // below; `len` is a reserved builtin (handled by name like
                    // map_new / Some / Ok), so this never shadows a user function.
                    if (cid.name == "len" && c.args.len() == 1) {
                        var lstr: boolean = expr_is_str(c.args[0], s);
                        var ls: LowerState = lower_expr(c.args[0], s);
                        if (!ls.ok) { return ls; }
                        if (lstr) { return ls.emit(ir.op_str_len()); }
                        return ls.emit(ir.op_arr_len());
                    }
                    // String builtin free calls — `str_split(s, sep)` and the
                    // predicates `str_starts_with` / `str_ends_with` /
                    // `str_index_of(s, x)` — are the same ops as the `.split` /
                    // `.starts_with` / … method forms, so they route through
                    // lower_str_method (field = the name minus its `str_` prefix).
                    var sfreef: string = str_free_call_field(cid.name);
                    if (sfreef != "" && c.args.len() == 2) {
                        return lower_str_method(sfreef, c.args[0], [c.args[1]], s);
                    }
                    // No arity cap: the call ABI is fully stack-based on every
                    // backend (x86-64/arm64 push the args on the runtime stack and
                    // the callee reads param[i] from a fixed frame offset; wasm
                    // passes them on the operand stack), and the function-entry
                    // param copy is a count-agnostic loop. So a call of any arity
                    // lowers exactly as asm.fern's AST path does.
                    var sc: LowerState = s;
                    var ai: i32 = 0;
                    while (ai < c.args.len()) {
                        // A bare function-name argument at a "fn"-typed param
                        // position is a function VALUE (a function pointer):
                        // const_func, not a call. Type-directed — distinguishes a
                        // function value from a `const` reference (both are bare
                        // idents naming a zero-arg-shaped function).
                        var fvn: string = fn_value_arg_name(c.args[ai], sc);
                        if (fvn.len() > 0 && sc.callee_param_is_fn(cid.name, ai)) {
                            sc = sc.emit(ir.op_const_func(0, fvn));
                        } else if (sc.callee_param_is_dyn(cid.name, ai)) {
                            // A primitive/string arg coerced into a `dyn Trait`
                            // param: lower the value, then heap-box it into a `dyn`
                            // cell [shape@0, value@8] so the receiver carries a
                            // shape pointer (docs/DYN-TRAITS.md §4.2.3). A struct/
                            // enum value already carries its shape (prim type ""),
                            // so it flows unboxed as the `dyn` pointer directly.
                            sc = lower_dyn_arg(c.args[ai], sc);
                        } else if (sc.param_is_i64(cid.name, ai)) {
                            // An argument bound to an i64 param must be lowered as
                            // an i64 value (so an i64 literal / i32 source widens).
                            sc = lower_i64(c.args[ai], sc);
                        } else {
                            sc = lower_expr(c.args[ai], sc);
                        }
                        if (!sc.ok) { return sc; }
                        ai = ai + 1;
                    }
                    return sc.emit(ir.op_call_direct(cid.name, c.args.len()));
                },
                // `fns[i](args)` — calling an element of a function-value ARRAY
                // inline. A CLOSURE array (`is_closurearr`, elements are env boxes
                // [funcval, caps…]) uses the env-first form (stash the box, push it
                // as the __env first arg, the declared args, then box[0] as the
                // target, call_indirect(arity+1)) — the same as a closure LOCAL.
                // A plain fn-POINTER array (`[inc, dbl]`, elements are bare
                // function pointers) just lowers the args, then the element (the
                // fn pointer on TOS), and call_indirect(arity) — like calling a
                // fn-value LOCAL. (`var f = fns[i]; f(args)` already lowers via the
                // local paths; this handles the inline form.)
                parser.ExprIndex(cidx) => {
                    var is_clo_arr: boolean = false;
                    var idx_is_arr: boolean = false;
                    match (cidx.array) {
                        parser.ExprIdent(caid) => {
                            var caslot: i32 = s.slot_of(caid.name);
                            is_clo_arr = s.is_closurearr_slot(caslot);
                            idx_is_arr = s.is_arr_slot(caslot);
                        },
                        _ => {}
                    }
                    if (is_clo_arr) {
                        var bxs: LowerState = lower_expr(c.callee, s);   // the box (fns[i])
                        if (!bxs.ok) { return bxs; }
                        var btmp: string = "$cloelem" + util.i32_to_string(bxs.local_names.len());
                        bxs = bxs.add_local(btmp);
                        var btslot: i32 = bxs.slot_of(btmp);
                        bxs = bxs.emit(ir.op_store_local(btslot));
                        bxs = bxs.emit(ir.op_load_local(btslot));   // __env (the box)
                        var cca: i32 = 0;
                        while (cca < c.args.len()) {
                            bxs = lower_expr(c.args[cca], bxs);
                            if (!bxs.ok) { return bxs; }
                            cca = cca + 1;
                        }
                        bxs = bxs.emit(ir.op_load_local(btslot));
                        bxs = bxs.emit(ir.op_const_i32(0));
                        bxs = bxs.emit(ir.op_arr_get(32));
                        return bxs.emit(ir.op_call_indirect(c.args.len() + 1));
                    }
                    if (idx_is_arr) {
                        // Plain fn-pointer array element: args, then the element
                        // (the fn pointer), then call_indirect(arity). The checker
                        // guarantees the element is callable (a non-fn array indexed
                        // in call position wouldn't type-check).
                        var pfs: LowerState = s;
                        var pfa: i32 = 0;
                        while (pfa < c.args.len()) {
                            pfs = lower_expr(c.args[pfa], pfs);
                            if (!pfs.ok) { return pfs; }
                            pfa = pfa + 1;
                        }
                        pfs = lower_expr(c.callee, pfs);   // fns[i] -> fn pointer on TOS
                        if (!pfs.ok) { return pfs; }
                        return pfs.emit(ir.op_call_indirect(c.args.len()));
                    }
                    return s.fail();
                },
                parser.ExprFieldAccess(fa) => {
                    // A function-VALUE tuple element call `t.N(args)` — `t.N` is a
                    // numeric tuple index whose element is a fn value (tagged "fn"
                    // at construction by elem_type_tag). Lower the args, then the
                    // tuple element (tuple_get → the fn pointer on TOS), and
                    // call_indirect — the same shape the "fn"-typed struct field
                    // uses (#3016). Gated on the element tag being "fn", so a normal
                    // numeric tuple read falls through.
                    if (util.is_all_digits(fa.field)) {
                        var tfn: i32 = util.digits_to_i32(fa.field);
                        if (expr_tuple_elem_tag(fa.obj, tfn, s) == "fn") {
                            var tfs: LowerState = s;
                            var tfi: i32 = 0;
                            while (tfi < c.args.len()) {
                                tfs = lower_expr(c.args[tfi], tfs);
                                if (!tfs.ok) { return tfs; }
                                tfi = tfi + 1;
                            }
                            tfs = lower_expr(fa.obj, tfs);
                            if (!tfs.ok) { return tfs; }
                            tfs = tfs.emit(ir.op_tuple_get(tfn));
                            return tfs.emit(ir.op_call_indirect(c.args.len()));
                        }
                    }
                    var mrslot: i32 = 0 - 1;
                    match (fa.obj) {
                        parser.ExprIdent(mrid) => { mrslot = s.slot_of(mrid.name); },
                        _ => {}
                    }
                    if (mrslot >= 0 && s.map_type_of(mrslot) != "") {
                        var mtype: string = s.map_type_of(mrslot);
                        var mkk2: i32 = map_key_kind_of(mtype);
                        if ((fa.field == "insert" || fa.field == "set") && c.args.len() == 2) {
                            var mset: LowerState = lower_expr(fa.obj, s);
                            if (!mset.ok) { return mset; }
                            mset = lower_expr(c.args[0], mset);
                            if (!mset.ok) { return mset; }
                            mset = lower_expr(c.args[1], mset);
                            if (!mset.ok) { return mset; }
                            return mset.emit(ir.op_map_set(mkk2));
                        }
                        if (fa.field == "len" && c.args.len() == 0) {
                            var mlen: LowerState = lower_expr(fa.obj, s);
                            if (!mlen.ok) { return mlen; }
                            return mlen.emit(ir.op_map_len());
                        }
                        if (fa.field == "get" && c.args.len() == 1) {
                            var mget: LowerState = lower_expr(fa.obj, s);
                            if (!mget.ok) { return mget; }
                            mget = lower_expr(c.args[0], mget);
                            if (!mget.ok) { return mget; }
                            return mget.emit(ir.op_map_get(mkk2));
                        }
                        if (fa.field == "has" && c.args.len() == 1) {
                            var mhas: LowerState = lower_expr(fa.obj, s);
                            if (!mhas.ok) { return mhas; }
                            mhas = lower_expr(c.args[0], mhas);
                            if (!mhas.ok) { return mhas; }
                            return mhas.emit(ir.op_map_has(mkk2));
                        }
                        if (fa.field == "get_or" && c.args.len() == 2) {
                            var mgo: LowerState = lower_expr(fa.obj, s);
                            if (!mgo.ok) { return mgo; }
                            mgo = lower_expr(c.args[0], mgo);
                            if (!mgo.ok) { return mgo; }
                            mgo = lower_expr(c.args[1], mgo);
                            if (!mgo.ok) { return mgo; }
                            return mgo.emit(ir.op_map_get_or(mkk2));
                        }
                        if (fa.field == "without" && c.args.len() == 1) {
                            // Functional delete: `m.without(k)` -> the map with k
                            // removed (reuses __fern_map_delete, like the AST path).
                            var mdel: LowerState = lower_expr(fa.obj, s);
                            if (!mdel.ok) { return mdel; }
                            mdel = lower_expr(c.args[0], mdel);
                            if (!mdel.ok) { return mdel; }
                            return mdel.emit(ir.op_map_delete(mkk2));
                        }
                        if (fa.field == "keys" && c.args.len() == 0) {
                            var mks: LowerState = lower_expr(fa.obj, s);
                            if (!mks.ok) { return mks; }
                            return mks.emit(ir.op_map_keys());
                        }
                        if (fa.field == "values" && c.args.len() == 0) {
                            var mvs: LowerState = lower_expr(fa.obj, s);
                            if (!mvs.ok) { return mvs; }
                            return mvs.emit(ir.op_map_values());
                        }
                        return s.fail();
                    }
                    // `.insert(k, v)` on a map-typed EXPRESSION (not a local) — the
                    // chained construction a `Map { k: v, … }` literal desugars to:
                    // `map_new[_i32](n).insert(k0,v0).insert(k1,v1)…`. The receiver
                    // lowers (recursively, so the inner inserts lower the same way)
                    // to a map on the stack; op_map_set consumes [map, key, value]
                    // and returns the map. The key kind comes from expr_map_kind
                    // (map_new vs map_new_i32 at the chain's base). Read methods on
                    // a map-literal expression aren't needed — the literal binds to
                    // a typed local, and reads go through the map-local path above.
                    if ((fa.field == "insert" || fa.field == "set") && c.args.len() == 2) {
                        var emk: i32 = expr_map_kind(fa.obj, s);
                        if (emk >= 0) {
                            var emset: LowerState = lower_expr(fa.obj, s);
                            if (!emset.ok) { return emset; }
                            emset = lower_expr(c.args[0], emset);
                            if (!emset.ok) { return emset; }
                            emset = lower_expr(c.args[1], emset);
                            if (!emset.ok) { return emset; }
                            return emset.emit(ir.op_map_set(emk));
                        }
                    }
                    // Qualified payload-variant construction `Enum.Variant(args)`
                    // — the same value as the bare `Variant(args)` (both build the
                    // variant's shape-named struct box via struct_make). The native
                    // compiler accepts both spellings; the self-host IR path only
                    // handled the bare form, so a qualified construction made the
                    // module IR-ineligible and fell back to the AST emitter, which
                    // mis-lowers it (`# unresolved ident: <Enum>`). Recognise it
                    // here: `fa.field` is a known variant whose enum_owner is the
                    // bare type name in `fa.obj` (not a local), so `Enum.Variant`
                    // is unambiguous variant construction, not a method/assoc call.
                    var qvowner: string = variant_enum_owner(s.structs, fa.field);
                    if (qvowner != "") {
                        match (fa.obj) {
                            parser.ExprIdent(qvid) => {
                                if (qvid.name == qvowner && s.slot_of(qvid.name) < 0) {
                                    if (!decl_is_leaksafe(s.structs, fa.field)) { return s.fail(); }
                                    if (c.args.len() != decl_field_count(s.structs, fa.field)) { return s.fail(); }
                                    var qv: LowerState = s;
                                    var qi: i32 = 0;
                                    while (qi < c.args.len()) {
                                        if (struct_field_is_i64(s.structs, fa.field, qi)) { qv = lower_i64(c.args[qi], qv); }
                                        else { qv = lower_expr(c.args[qi], qv); }
                                        if (!qv.ok) { return qv; }
                                        qi = qi + 1;
                                    }
                                    return qv.emit(ir.op_struct_make(fa.field, c.args.len()));
                                }
                            },
                            _ => {}
                        }
                    }
                    if (fa.field == "len" && c.args.len() == 0) {
                        // String `.len()` reads the string box's length field;
                        // array `.len()` reads the array header. Dispatch on the
                        // receiver's tracked type.
                        var str_recv: boolean = expr_is_str(fa.obj, s);
                        var sl: LowerState = lower_expr(fa.obj, s);
                        if (!sl.ok) { return sl; }
                        if (str_recv) { return sl.emit(ir.op_str_len()); }
                        return sl.emit(ir.op_arr_len());
                    }
                    // `arr.to_json()` on an ARRAY receiver — the element-poly
                    // `(xs: T[]) to_json[T: Json]()` serialiser from std/json.
                    // The self-host emits the generic body ONCE by erasure, so it
                    // can't dispatch the per-element `xs[i].to_json()` on `T`
                    // (it bakes in the i32 impl). But at THIS call site the array's
                    // element type is known, so desugar to an inline loop that
                    // builds `[e0,e1,…]` where each `arr[i].to_json()` lowers with
                    // the element type in hand — dispatching to the right impl
                    // (i32 / string / a derived struct's `to_json`). #2766.
                    if (fa.field == "to_json" && c.args.len() == 0
                        && (expr_is_arr_src(fa.obj, s) || expr_is_strarr(fa.obj, s) || expr_is_f64arr(fa.obj, s) || expr_is_i64arr(fa.obj, s))) {
                        return lower_array_to_json(fa.obj, s);
                    }
                    // `s.bytes()` / `s.as_bytes()` on a string receiver → a fresh
                    // u8[] (one i32 slot per byte). The self-host slot-array model
                    // has no zero-copy slice view, so as_bytes returns the same
                    // fresh array as bytes (matches the AST path). Result is an
                    // array — see expr_is_arr / lower_arr's mirror cases.
                    if ((fa.field == "bytes" || fa.field == "as_bytes") && c.args.len() == 0 && expr_is_str(fa.obj, s)) {
                        var sb: LowerState = lower_expr(fa.obj, s);
                        if (!sb.ok) { return sb; }
                        return sb.emit(ir.op_str_bytes());
                    }
                    // String builtin methods on a string receiver: the 0-arg
                    // transforms `to_upper` / `to_lower` (→ fresh string),
                    // `s.split(sep)` (→ string[]), and the scalar predicates
                    // `starts_with` / `ends_with` / `index_of` / `contains`. The
                    // per-field emission lives in lower_str_method, kept out of line
                    // so this already-enormous lower_expr arm doesn't grow past the
                    // self-host backend's oversized-function miscompile threshold
                    // (#2720 — folding it in here crashed the stage-2 self-compile).
                    if (is_str_builtin_method(fa.field) && c.args.len() == str_method_argc(fa.field) && expr_is_str(fa.obj, s)) {
                        return lower_str_method(fa.field, fa.obj, c.args, s);
                    }
                    // Builtin `.to_string()` on a PRIMITIVE receiver — distinct
                    // from a struct's generated `to_string` (a @derive(Display)
                    // method), which the struct-method path below dispatches via
                    // its `<Struct>.to_string` label. A string receiver returns
                    // unchanged (`"x".to_string() == "x"`); an i32 routes to the
                    // __fern_i32_to_string runtime helper (decimal-text box). Only
                    // fires when the receiver is a string or i32 primitive; struct /
                    // enum / f64 / i64 receivers fall through (expr_recv_prim_type
                    // returns "" for struct+enum, so those reach the method paths).
                    if (fa.field == "to_string" && c.args.len() == 0) {
                        if (expr_is_str(fa.obj, s)) { return lower_expr(fa.obj, s); }
                        if (expr_recv_prim_type(fa.obj, s) == "i32") {
                            var t2s: LowerState = lower_expr(fa.obj, s);
                            if (!t2s.ok) { return t2s; }
                            return t2s.emit(ir.op_call_direct("__fern_i32_to_string", 1));
                        }
                    }
                    // Associated-function call `Type.f(args)` — a receiver-less
                    // impl method (e.g. a constructor `Point.make(x, y)` or a
                    // derived `Enum.default()`). The callee object is a bare TYPE
                    // name that is NOT a local slot (a same-named local would be a
                    // value receiver, handled by the struct-method path below).
                    // Lower the args with NO receiver and dispatch to the
                    // "<Type>.<f>" label (the associated FuncDecl is keyed there by
                    // module_has_func). The target is recognised as a STRUCT name
                    // (decl_is_struct) or, for an enum / type-returning associated
                    // fn, by a registered "<Type>.<f>" return type — never via
                    // is_enum_like_name, which also matches MODULE names
                    // (util/parser) and would hijack every `mod.func()` call. A
                    // UNIT VARIANT is excluded (variant_enum_owner != "") — `Nil.m()`
                    // is a receiver-method call on a variant value, not an
                    // associated call on a type, so it falls through to the
                    // enum-method dispatch below.
                    match (fa.obj) {
                        parser.ExprIdent(tid) => {
                            if (s.slot_of(tid.name) < 0 && variant_enum_owner(s.structs, tid.name) == "" && (decl_is_struct(s.structs, tid.name) || s.struct_ret_type(tid.name + "." + fa.field) != "")) {
                                var asf: LowerState = s;
                                var afi: i32 = 0;
                                while (afi < c.args.len()) {
                                    if (asf.param_is_i64(tid.name + "." + fa.field, afi)) { asf = lower_i64(c.args[afi], asf); }
                                    else { asf = lower_expr(c.args[afi], asf); }
                                    if (!asf.ok) { return asf; }
                                    afi = afi + 1;
                                }
                                return asf.emit(ir.op_call_direct(tid.name + "." + fa.field, c.args.len()));
                            }
                        },
                        _ => {}
                    }
                    // Struct method call `p.method(args)` — static dispatch on the
                    // receiver's tracked struct type to `call_direct("<Type>.<m>")`
                    // with the receiver as arg 0 (matching the method's
                    // `__fn_<Type>.<m>` label). calls_only_known verifies the method
                    // exists, else the module bails to AST.
                    var rty: string = expr_struct_type(fa.obj, s);
                    // Option/Result-receiver method call `o.method(args)` (impl on
                    // Option[T] / Result[T, E]). expr_struct_type is "" for an
                    // Option, so recover the receiver's opt-type (a local's tracked
                    // type, a direct `Some(x)`, or an Option-returning call), then
                    // dispatch call_direct("Option.<method>") — base_type_name
                    // strips the payload, matching the emitted label — with the
                    // receiver as arg 0, mirroring the struct-method path (#3031).
                    var odt: string = opt_recv_base_type(fa.obj, s);
                    if (odt != "") {
                        var om: LowerState = lower_expr(fa.obj, s);
                        if (!om.ok) { return om; }
                        var oai: i32 = 0;
                        while (oai < c.args.len()) {
                            var ofvn: string = fn_value_arg_name(c.args[oai], om);
                            if (ofvn.len() > 0 && om.callee_param_is_fn(odt + "." + fa.field, oai)) { om = om.emit(ir.op_const_func(0, ofvn)); }
                            else if (om.param_is_i64(odt + "." + fa.field, oai)) { om = lower_i64(c.args[oai], om); }
                            else { om = lower_expr(c.args[oai], om); }
                            if (!om.ok) { return om; }
                            oai = oai + 1;
                        }
                        return om.emit(ir.op_call_direct(odt + "." + fa.field, 1 + c.args.len()));
                    }
                    // `dyn Trait` method call: the receiver's concrete type is
                    // known only at runtime. Spill the receiver (arg 0) + args
                    // into argc consecutive temp locals, then op_dyn_dispatch —
                    // the backend reads the receiver's shape pointer (from its
                    // local) and dispatches to `<ConcreteType>.<method>`,
                    // reloading the argc locals per arm. Spilling to locals (vs
                    // leaving them on the stack) lets wasm — which can't index a
                    // deep operand-stack slot — reload them.
                    if (rty.len() > 4 && rty[0:4] == "dyn ") {
                        var dbase: i32 = s.local_names.len();
                        var dargc: i32 = 1 + c.args.len();
                        var dm: LowerState = s;
                        var dti: i32 = 0;
                        while (dti < dargc) { dm = dm.add_local("$dyn" + util.i32_to_string(dbase) + "_" + util.i32_to_string(dti)); dti = dti + 1; }
                        dm = lower_expr(fa.obj, dm);
                        if (!dm.ok) { return dm; }
                        dm = dm.emit(ir.op_store_local(dbase));
                        var dai: i32 = 0;
                        while (dai < c.args.len()) {
                            dm = lower_expr(c.args[dai], dm);
                            if (!dm.ok) { return dm; }
                            dm = dm.emit(ir.op_store_local(dbase + 1 + dai));
                            dai = dai + 1;
                        }
                        return dm.emit(ir.op_dyn_dispatch(fa.field, dbase, dargc));
                    }
                    // A function-VALUE struct field call `h.f(args)` — `f` is a
                    // "fn"-typed field (a plain fn pointer stored at construction,
                    // e.g. `H { f: dbl }`), NOT a method. Lower the args, then the
                    // field access (struct_get → the fn pointer on TOS), and
                    // call_indirect — the same shape a fn-value local uses. Without
                    // this the `<Type>.method` dispatch below names a nonexistent
                    // "H.f" and the module bails to AST.
                    if (rty != "" && decl_field_type(s.structs, rty, fa.field) == "fn") {
                        var ffidx: i32 = s.field_index_in(rty, fa.field);
                        if (ffidx < 0) { return s.fail(); }
                        var ffs: LowerState = s;
                        var ffi: i32 = 0;
                        while (ffi < c.args.len()) {
                            ffs = lower_expr(c.args[ffi], ffs);
                            if (!ffs.ok) { return ffs; }
                            ffi = ffi + 1;
                        }
                        ffs = lower_expr(fa.obj, ffs);
                        if (!ffs.ok) { return ffs; }
                        ffs = ffs.emit(ir.op_struct_get(ffidx, struct_field_width(s.structs, rty, ffidx)));
                        return ffs.emit(ir.op_call_indirect(c.args.len()));
                    }
                    if (rty != "") {
                        // A receiver whose tracked type is an enum VARIANT (a
                        // struct with an enum_owner — e.g. a local `var c = Green`
                        // typed "Green") dispatches its methods under the ENUM
                        // name: methods are declared on the enum (`function (c:
                        // Color) m()`), keyed "<Enum>.<m>", never the variant. So
                        // redirect variant -> enum_owner; otherwise the call_direct
                        // names "<Variant>.<m>", which module_has_func can't find,
                        // bailing the module to AST (#2947).
                        var disp_ty: string = rty;
                        var rvo: string = variant_enum_owner(s.structs, rty);
                        if (rvo != "") { disp_ty = rvo; }
                        // No arity cap (see the free-call note above): the
                        // receiver lowers as arg 0 and the rest follow on the
                        // stack, count-agnostic on every backend.
                        var sm: LowerState = lower_expr(fa.obj, s);
                        if (!sm.ok) { return sm; }
                        var ai: i32 = 0;
                        while (ai < c.args.len()) {
                            // A bare fn-name arg at a "fn"-typed method param is a
                            // function VALUE (const_func), not a call — the same
                            // const-vs-fn-value disambiguation the free-call loop
                            // does. Must run BEFORE general lowering, else a
                            // zero-arg fn-value (`m.f(noop)`) hits the const-call
                            // path and is wrongly invoked (#2954 follow-up).
                            var mfvn: string = fn_value_arg_name(c.args[ai], sm);
                            if (mfvn.len() > 0 && sm.callee_param_is_fn(disp_ty + "." + fa.field, ai)) {
                                sm = sm.emit(ir.op_const_func(0, mfvn));
                            } else if (sm.param_is_i64(disp_ty + "." + fa.field, ai)) {
                                // An i64 method param: the arg is an 8-byte i64
                                // value, lowered via lower_i64.
                                sm = lower_i64(c.args[ai], sm);
                            } else {
                                sm = lower_expr(c.args[ai], sm);
                            }
                            if (!sm.ok) { return sm; }
                            ai = ai + 1;
                        }
                        return sm.emit(ir.op_call_direct(disp_ty + "." + fa.field, 1 + c.args.len()));
                    }
                    // Enum method called directly on a FRESH variant construction
                    // (`Has(5).eq(other)`) or a bare unit variant (`A.method()`).
                    // expr_struct_type doesn't type a fresh variant (it isn't a
                    // local), so recover the enum from the variant's enum_owner and
                    // dispatch to `<Enum>.<method>` with the constructed variant as
                    // arg 0 — the same shape-pointer box `match`'s variant_is reads.
                    var ety: string = expr_enum_type(fa.obj, s);
                    if (ety != "") {
                        var em: LowerState = lower_expr(fa.obj, s);
                        if (!em.ok) { return em; }
                        var eai: i32 = 0;
                        while (eai < c.args.len()) {
                            // fn-value arg (const_func) before general lowering —
                            // see the struct-method loop above (#2954 follow-up).
                            var efvn: string = fn_value_arg_name(c.args[eai], em);
                            if (efvn.len() > 0 && em.callee_param_is_fn(ety + "." + fa.field, eai)) { em = em.emit(ir.op_const_func(0, efvn)); }
                            else if (em.param_is_i64(ety + "." + fa.field, eai)) { em = lower_i64(c.args[eai], em); }
                            else { em = lower_expr(c.args[eai], em); }
                            if (!em.ok) { return em; }
                            eai = eai + 1;
                        }
                        return em.emit(ir.op_call_direct(ety + "." + fa.field, 1 + c.args.len()));
                    }
                    // Primitive-receiver method call `n.method(args)` (impl Trait
                    // for i32/string/i64/f64) — derive the receiver's primitive
                    // type and dispatch `call_direct("<Prim>.<method>")` with the
                    // receiver as arg 0, mirroring the struct path. A label naming
                    // a non-method `.field()` form (or absent method) bails the
                    // module via calls_only_known, so this is safe to attempt.
                    var pty: string = expr_recv_prim_type(fa.obj, s);
                    if (pty != "") {
                        var pm: LowerState = s;
                        if (pty == "i64") { pm = lower_i64(fa.obj, s); }
                        else { pm = lower_expr(fa.obj, s); }
                        if (!pm.ok) { return pm; }
                        var pai: i32 = 0;
                        while (pai < c.args.len()) {
                            // fn-value arg (const_func) before general lowering —
                            // see the struct-method loop above (#2954 follow-up).
                            var pfvn: string = fn_value_arg_name(c.args[pai], pm);
                            if (pfvn.len() > 0 && pm.callee_param_is_fn(pty + "." + fa.field, pai)) { pm = pm.emit(ir.op_const_func(0, pfvn)); }
                            else if (pm.param_is_i64(pty + "." + fa.field, pai)) { pm = lower_i64(c.args[pai], pm); }
                            else { pm = lower_expr(c.args[pai], pm); }
                            if (!pm.ok) { return pm; }
                            pai = pai + 1;
                        }
                        return pm.emit(ir.op_call_direct(pty + "." + fa.field, 1 + c.args.len()));
                    }
                    return s.fail();
                },
                // Inline 0-arg IIFE — the shape parse_if_chain emits for an
                // if-EXPRESSION in value position: `(function(): i32 { if (c) {
                // return E1; } else { return E2; } })()`. Lower it INLINE (no
                // closure box / function call) as a value-producing void `if`
                // that stores each branch's result into a temp (#2938). Bails to
                // AST for anything other than the i32 if-expression shape.
                parser.ExprLambda(lam) => {
                    return lower_iife(c, lam, s);
                },
                // `mk()(args)` — the callee is itself a CALL returning a plain
                // function value (a bare fn pointer; e.g. mk returns a no-capture
                // lambda, lifted to a const_func by lift_lambdas). Lower the args,
                // then the callee call (its returned fn pointer on TOS), then
                // call_indirect — the same shape as a fn-pointer array element /
                // tuple element call. A callee that returns a CLOSURE box (a
                // capturing-lambda-returning fn, tracked in closure_fns) needs the
                // env-passing form, so it bails to AST for now.
                parser.ExprCall(cocall) => {
                    var coc_is_closure: boolean = false;
                    match (cocall.callee) {
                        parser.ExprIdent(cocid) => { if (util.index_of_str(s.closure_fns, cocid.name) >= 0) { coc_is_closure = true; } },
                        _ => {}
                    }
                    if (coc_is_closure) { return s.fail(); }
                    var cocs: LowerState = s;
                    var coci: i32 = 0;
                    while (coci < c.args.len()) {
                        cocs = lower_expr(c.args[coci], cocs);
                        if (!cocs.ok) { return cocs; }
                        coci = coci + 1;
                    }
                    var coce: LowerState = lower_expr(c.callee, cocs);
                    if (!coce.ok) { return coce; }
                    return coce.emit(ir.op_call_indirect(c.args.len()));
                },
                _ => { return s.fail(); }
            }
            return s.fail();
        },
        parser.ExprLambda(lam) => {
            // First-class (escaping) closure (slice 3a): build the env box —
            // an i32[] [funcval, caps…]. The body was hoisted to `<cur_fn>$clo`
            // by lift_lambdas; const_func names it, the captures (free vars that
            // are local slots, in the SAME first-seen order hoist_escaping_closure
            // read them) follow, and arr_make wraps them. `<cur_fn>$clo` must
            // exist (const_funcs_only_known bails the module otherwise).
            var caps: string[] = closure_captures(lam, s);
            var cs: LowerState = s.emit(ir.op_const_func(0, s.cur_fn + "$clo"));
            var ci: i32 = 0;
            while (ci < caps.len()) {
                var slot: i32 = cs.slot_of(caps[ci]);
                if (slot < 0) { return s.fail(); }
                cs = cs.emit(ir.op_load_local(slot));
                ci = ci + 1;
            }
            return cs.emit(ir.op_arr_make(caps.len() + 1, 32));
        },
        _ => { return s.fail(); }
    }
    return s.fail();
}

// lower_try lowers the try-operator `inner?` (parser desugar: unary "try_").
// `inner` evaluates to an Option[T] / Result[T, E] box; `?` unwraps the success
// payload (Some/Ok) as the expression's value, or early-returns the failure box
// from the enclosing (Option/Result-returning) function. The self-host runtime
// leaks (no rc / defer / errdefer), so the failure path is simply: Option ->
// return a fresh None (payloadless tag box); Result -> forward the source Err
// box unchanged (its tag=Err + E payload already satisfy the enclosing return,
// checker-verified). Mirrors the native ir.go `*ast.TryOp` lowering minus the
// cleanup the leak-only path doesn't need. Gated to scalar i32 / boolean
// payloads for now: those need no extra slot-typing at the `var x = inner?`
// binding (x defaults to a width-32 i32 slot), so a string / i64 / f64 /
// composite payload bails to AST until the success value's slot typing is
// threaded. Out of line so the ExprUnary arm stays small (#2720 guard).
function lower_try(inner: parser.Expr, s: LowerState): LowerState {
    var ot: string = try_opt_type(inner, s);
    if (ot.len() < 8) { return s.fail(); }
    var is_result: boolean = ot[0:7] == "Result[";
    var is_option: boolean = ot[0:7] == "Option[";
    if (!is_result && !is_option) { return s.fail(); }
    // Success payload type — only scalar i32 / boolean inline here.
    var pt: string = opt_payload_type(ot, "Ok");
    if (pt != "i32" && pt != "boolean") { return s.fail(); }
    // Evaluate inner into a fresh temp slot (the box pointer).
    var tmp: string = "$try" + util.i32_to_string(s.local_names.len());
    var ts: LowerState = s.add_local(tmp);
    var tslot: i32 = ts.slot_of(tmp);
    ts = lower_expr(inner, ts);
    if (!ts.ok) { return ts; }
    ts = ts.emit(ir.op_store_local(tslot));
    // if (tag == failure) { early-return the failure box }
    ts = ts.emit(ir.op_load_local(tslot));
    ts = ts.emit(ir.op_opt_tag());
    ts = ts.emit(ir.op_const_i32(1));            // failure variant idx = 1 (both Option + Result)
    ts = ts.emit(ir.op_bin("eq", 0, false));
    ts = ts.emit(ir.op_if(0));
    if (is_result) {
        ts = ts.emit(ir.op_load_local(tslot));   // forward the source Err box
    } else {
        ts = ts.emit(ir.op_opt_none());          // fresh None
    }
    ts = ts.emit(ir.op_return());
    ts = ts.emit(ir.op_end());
    // Success path: load the payload (offset abstracted by op_opt_payload).
    ts = ts.emit(ir.op_load_local(tslot));
    return ts.emit(ir.op_opt_payload());
}

// try_opt_type recovers the Option/Result type spelling of a try-operator's
// inner expression, mirroring the match-scrutinee resolution: a direct-call
// `f()` via opt_ret_fns, a direct `Some(x)` construction via some_opt_type, a
// map `.get()` (Option[V]), a local/param via its tracked Option/Result type, or
// an Option/Result struct field. "" when it can't (lower_try then bails to AST).
function try_opt_type(inner: parser.Expr, s: LowerState): string {
    match (inner) {
        parser.ExprCall(scl) => {
            match (scl.callee) {
                parser.ExprIdent(scid) => {
                    var rt: string = s.opt_ret_type(scid.name);
                    // A direct `Some(x)` construction scrutinee — recover its
                    // Option[T] type (mirrors the main StmtMatch path's
                    // some_opt_type fallback), so `match (Some(6)) { … }` in value
                    // position lowers instead of bailing.
                    if (rt == "") { rt = some_opt_type(inner, s); }
                    return rt;
                },
                parser.ExprFieldAccess(scfa) => {
                    if (scfa.field == "get") {
                        match (scfa.obj) {
                            parser.ExprIdent(mapid) => {
                                var vt: string = map_value_of(s.map_type_of(s.slot_of(mapid.name)));
                                if (vt != "") { return "Option[" + vt + "]"; }
                            },
                            _ => {}
                        }
                    }
                    // `x.method()` where x's method returns Option/Result —
                    // key by "<Type>.<method>".
                    var mrty: string = expr_struct_type(scfa.obj, s);
                    if (mrty != "") { return s.opt_ret_type(mrty + "." + scfa.field); }
                    // An Option/Result-RECEIVER method (`r.map()`) — key
                    // "Option.<m>" / "Result.<m>" (#3049).
                    var mrb: string = opt_recv_base_type(scfa.obj, s);
                    if (mrb != "") { return s.opt_ret_type(mrb + "." + scfa.field); }
                    // An enum-receiver method returning Option/Result on a fresh
                    // variant (`V(7).get()`) — key "<Enum>.<m>" (#3076).
                    var men: string = expr_enum_type(scfa.obj, s);
                    if (men != "") { return s.opt_ret_type(men + "." + scfa.field); }
                    return "";
                },
                // An if-/match-EXPRESSION scrutinee (`match (if (c) { Some(7) }
                // else { None }) { … }`) — a 0-arg IIFE. Recover the Option type
                // from the leaf branch's Some(...) via iife_leaf_value (unwrapping
                // any nesting), so the value-position match lowers.
                parser.ExprLambda(_) => { return some_opt_type(iife_leaf_value(inner), s); },
                _ => { return ""; }
            }
        },
        parser.ExprIdent(sid) => { return s.opt_type_of_slot(s.slot_of(sid.name)); },
        // `e as? T` downcast (docs/DYN-TRAITS.md §9) → Option[T]; the parser tags
        // it `as?_<T>`.
        parser.ExprUnary(sun) => {
            if (sun.op.len() > 4 && sun.op[0:4] == "as?_") { return "Option[" + sun.op[4 : sun.op.len()] + "]"; }
            return "";
        },
        parser.ExprFieldAccess(sfa) => {
            // `t.N` where the tuple element is an Option/Result — recover from the
            // element's tracked tag (a numeric field; mirrors the main StmtMatch
            // path so `match (t.0) { … }` in value position lowers).
            if (util.is_all_digits(sfa.field)) {
                var ttg: string = expr_tuple_elem_tag(sfa.obj, util.digits_to_i32(sfa.field), s);
                if (ttg.len() >= 8 && (ttg[0:7] == "Option[" || ttg[0:7] == "Result[")) { return ttg; }
                return "";
            }
            var foty: string = expr_struct_type(sfa.obj, s);
            if (foty != "") {
                var fft: string = decl_field_type(s.structs, foty, sfa.field);
                if (fft.len() >= 8 && (fft[0:7] == "Option[" || fft[0:7] == "Result[")) { return fft; }
            }
            return "";
        },
        // `a[i]` where `a` is an Option/Result ARRAY — recover the element type
        // from the array slot's opt_type (annotated `Option[T][]` / `Result[…][]`,
        // or inferred from an Option-array literal), stripping the trailing `[]`.
        // Mirrors the main StmtMatch path so `match (a[i]) { … }` in value position
        // lowers; also handles `b.o[i]` (an Option/Result-array struct field).
        parser.ExprIndex(six) => {
            match (six.array) {
                parser.ExprIdent(arrid) => {
                    var aot: string = s.opt_type_of_slot(s.slot_of(arrid.name));
                    if (aot.len() >= 2 && aot[aot.len() - 2 : aot.len()] == "[]") {
                        var elt: string = aot[0 : aot.len() - 2];
                        if (elt.len() >= 8 && (elt[0:7] == "Option[" || elt[0:7] == "Result[")) { return elt; }
                    }
                },
                parser.ExprFieldAccess(sfa2) => {
                    var foty2: string = expr_struct_type(sfa2.obj, s);
                    if (foty2 != "") {
                        var fat: string = decl_field_type(s.structs, foty2, sfa2.field);
                        if (fat.len() >= 2 && fat[fat.len() - 2 : fat.len()] == "[]") {
                            var felt: string = fat[0 : fat.len() - 2];
                            if (felt.len() >= 8 && (felt[0:7] == "Option[" || felt[0:7] == "Result[")) { return felt; }
                        }
                    }
                },
                _ => {}
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// lower_iife lowers the 0-arg IIFE the if-expression desugar (parse_if_chain)
// emits — `(function(): i32 { if (c) { return E1; } else { return E2; } })()`
// — INLINE, with no closure box or function call: a value-producing void `if`
// whose branches store their result into a fresh temp local, then a load of
// that temp leaves the if-expression's value on the rt-stack (the same
// temp-local-through-a-void-block shape the `&&`/`||` short-circuit uses). The
// lambda's inner `return E` becomes `store tmp = E`. Restricted to exactly
// what the desugar produces for an i32 if-expression: 0 params, 0 args, a body
// that is a single StmtIf with an else, and i32-valued branches. Any other
// shape — a match-expression IIFE (StmtMatch body), an f64 / string / i64
// result, or a multi-statement body that isn't a value tail — bails to the AST
// emitter, exactly as before (#2938).
// iife_first_return_expr returns the value expression of the FIRST `return`
// reachable in an if-expression / match-expression IIFE body — the then-branch
// tail of a StmtIf (recursing nested else-ifs) or the first arm's tail of a
// StmtMatch. All branches share the if/match result type, so the first return
// classifies the whole expression's value (string vs i32). Returns ExprUnknown
// for any other shape.
function iife_first_return_expr(st: parser.Stmt): parser.Expr {
    match (st) {
        parser.StmtReturn(r) => { return r.value; },
        parser.StmtIf(iff) => {
            if (iff.then_body.len() > 0) { return iife_first_return_expr(iff.then_body[iff.then_body.len() - 1]); }
            return parser.e_unknown("");
        },
        parser.StmtMatch(mm) => {
            if (mm.arms.len() > 0 && mm.arms[0].body.len() > 0) { return iife_first_return_expr(mm.arms[0].body[mm.arms[0].body.len() - 1]); }
            return parser.e_unknown("");
        },
        _ => { return parser.e_unknown(""); }
    }
    return parser.e_unknown("");
}

// iife_leaf_value unwraps a (possibly nested) if-/match-expression IIFE
// (`ExprCall{callee: ExprLambda}`) to the innermost first-branch returned value
// — e.g. a NESTED if-expression `if (a) { if (b) { P{..} } else { .. } } else
// { .. }` resolves to the `P{..}` literal. Returns `e` unchanged when it isn't an
// IIFE. Lets the StmtVar value-type inference (opt / struct / array) see through a
// nested IIFE binding to the leaf struct/Some/array literal. Bounded to avoid a
// pathological loop.
function iife_leaf_value(e: parser.Expr): parser.Expr {
    var cur: parser.Expr = e;
    var guard: i32 = 0;
    while (guard < 64) {
        var stop: boolean = true;
        match (cur) {
            parser.ExprCall(c) => {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        if (lam.body.len() > 0) { cur = iife_first_return_expr(lam.body[0]); stop = false; }
                    },
                    _ => {}
                }
            },
            _ => {}
        }
        if (stop) { return cur; }
        guard = guard + 1;
    }
    return cur;
}

// or an i64-sized integer literal. Unlike f64 / string (where the first branch
// classifies the whole expression), an i64 if-expression can mix an i64-sized
// branch with a small-literal branch (`{ 5000000000 } else { 1 }`), so every
// return is checked. A fully-small-literal i64 expression (whose i64-ness comes
// only from the binding annotation) isn't caught here and stays on the AST path.
function iife_any_return_i64(st: parser.Stmt, s: LowerState): boolean {
    match (st) {
        parser.StmtReturn(r) => {
            if (infer_expr_width(r.value, s) == 64) { return true; }
            match (r.value) {
                parser.ExprNumber(num) => { if (!num.is_float && literal_is_i64(num.text)) { return true; } },
                _ => {}
            }
            return false;
        },
        parser.StmtIf(iff) => {
            var k: i32 = 0;
            while (k < iff.then_body.len()) { if (iife_any_return_i64(iff.then_body[k], s)) { return true; } k = k + 1; }
            var j: i32 = 0;
            while (j < iff.else_body.len()) { if (iife_any_return_i64(iff.else_body[j], s)) { return true; } j = j + 1; }
            return false;
        },
        parser.StmtMatch(mm) => {
            var a: i32 = 0;
            while (a < mm.arms.len()) {
                var b: i32 = 0;
                while (b < mm.arms[a].body.len()) { if (iife_any_return_i64(mm.arms[a].body[b], s)) { return true; } b = b + 1; }
                a = a + 1;
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

function lower_iife(c: parser.ExprCall, lam: parser.ExprLambda, s: LowerState): LowerState {
    if (c.args.len() != 0) { return s.fail(); }
    if (lam.params.len() != 0) { return s.fail(); }
    if (lam.body.len() != 1) { return s.fail(); }
    match (lam.body[0]) {
        parser.StmtIf(iff) => {
            var tmp: string = "$ife" + util.i32_to_string(s.local_names.len());
            var ts: LowerState = s.add_local(tmp);
            var tslot: i32 = ts.slot_of(tmp);
            // Type the inline temp from the if-expression's result (the first
            // branch's returned value classifies it, since all branches share a
            // type): an f64 temp (8-byte) for a float result, an i64 temp for an
            // i64-width result (any branch — see iife_any_return_i64), else a
            // string temp (pointer) for a string result, else the default i32
            // temp. The temp type steers the branch-tail value lowering + the
            // loaded value's downstream dispatch.
            var ifre: parser.Expr = iife_first_return_expr(lam.body[0]);
            if (expr_is_f64(ifre, ts)) { ts = ts.mark_f64(tslot, true); }
            else if (iife_any_return_i64(lam.body[0], ts)) { ts = ts.mark_i64(tslot, true); }
            else if (expr_is_str(ifre, ts)) { ts = ts.mark_str(tslot, true); }
            var rs: LowerState = lower_value_if(iff, tslot, ts);
            if (!rs.ok) { return rs; }
            return rs.emit(ir.op_load_local(tslot));
        },
        // match-EXPRESSION in value position (parse_match_expr emits the same
        // IIFE shape with a StmtMatch body). Inline it by rewriting each arm's
        // `return E` to `tmp = E` and lowering the resulting statement-match
        // (the full variant dispatch), then loading tmp — see lower_iife_match.
        parser.StmtMatch(mm) => {
            return lower_iife_match(mm, s);
        },
        _ => { return s.fail(); }
    }
    return s.fail();
}

// lower_iife_match inlines an enum / bool match-EXPRESSION in value position.
// It rewrites every arm's single `return E` into `tmp = E` and lowers the
// rewritten statement-match through the existing variant-dispatch path, then
// loads tmp. Conservatively scoped so the i32 temp is always the right width:
// arms must have NO payload binding (a unit variant, `_`, or `true`/`false`)
// and an i32 result. A payload-binding arm (`Some(n) => n`) or an f64 / string
// / i64 result bails to the AST emitter (#2938 follow-up).
// iife_payload_bindable reports whether a payload-binding match arm's payload can
// be bound for the inlined match-expression. The payload type is resolved from the
// scrutinee's tracked opt type (Option/Result Some/Ok/Err) or, for a user-enum
// variant, its single payload field (`__ev`).
//
// An i32 payload is always bindable (the rewritten `tmp = E` is an i32 store). A
// nested OPTION payload (`Some(b)` where b: Option[T]) is bindable when the result
// temp is i32 AND the match scrutinee is a plain local (`scrut_is_ident`): every arm
// then returns i32 (arms share a result type in valid Fern), so the bound Option is
// only consumed to compute an i32 — typically a nested `match (b)` — never stored
// into the i32 temp as the result. The underlying StmtMatch path binds it via
// mark_opt_type, so the inner match recovers b's type. The ident-scrutinee
// restriction is deliberate: a CALL scrutinee returning a nested Option
// (`match (f()) { Some(b) => match (b) … }`) is left on the AST path. A non-i32
// result temp keeps the strict i32-only rule (a payload returned directly would
// need its type at gate-classify time, before the binding is in scope). A
// string / Result / fn payload stays on the AST path here.
function iife_payload_bindable(pv: parser.PatVariant, opt_srt: string, temp_is_i32: boolean, scrut_is_ident: boolean, s: LowerState): boolean {
    if (opt_srt != "") {
        var pt: string = opt_payload_type(opt_srt, pv.type_name);
        if (pt == "i32") { return true; }
        if (temp_is_i32 && scrut_is_ident && pt.len() >= 8 && pt[0:7] == "Option[") { return true; }
        return false;
    }
    // User-enum variant: strip any `Enum.` qualifier, then read its payload field.
    var vname: string = pv.type_name;
    var vld: i32 = 0;
    while (vld < pv.type_name.len()) {
        if (pv.type_name[vld] == 46) { vname = pv.type_name[vld + 1 : pv.type_name.len()]; }
        vld = vld + 1;
    }
    if (!decl_is_struct(s.structs, vname)) { return false; }
    return decl_field_type(s.structs, vname, "__ev") == "i32";
}

function lower_iife_match(m: parser.StmtMatch, s: LowerState): LowerState {
    var tmp: string = "$ife" + util.i32_to_string(s.local_names.len());
    var ts: LowerState = s.add_local(tmp);
    var tslot: i32 = ts.slot_of(tmp);
    // A STRING-valued match-expression stores a string pointer in the temp (same
    // slot mechanics as i32); mark the temp a string so the arm tails admit
    // string results and the loaded value dispatches as a string. The first
    // arm's returned value classifies the whole match (all arms share the result
    // type). The payload-width gate below is orthogonal — a string result from
    // an i32-payload arm (`A(n) => n.to_string()`) still binds n as i32.
    if (m.arms.len() > 0 && m.arms[0].body.len() > 0) {
        var mfre: parser.Expr = iife_first_return_expr(m.arms[0].body[0]);
        var many_i64: boolean = false;
        var mi: i32 = 0;
        while (mi < m.arms.len()) {
            var mj: i32 = 0;
            while (mj < m.arms[mi].body.len()) { if (iife_any_return_i64(m.arms[mi].body[mj], ts)) { many_i64 = true; } mj = mj + 1; }
            mi = mi + 1;
        }
        if (expr_is_f64(mfre, ts)) { ts = ts.mark_f64(tslot, true); }
        else if (many_i64) { ts = ts.mark_i64(tslot, true); }
        else if (expr_is_str(mfre, ts)) { ts = ts.mark_str(tslot, true); }
    }
    // A payload-binding arm (`Some(n) => n`) is admitted only when the bound
    // payload is i32, so the i32 temp stays the right width. An Option/Result
    // scrutinee's type is recovered via try_opt_type — a local/param, a
    // direct-call `f()` (opt_ret_fns), a map `.get()`, a struct field, or an
    // Option/Result-/enum-receiver method — the same resolution the underlying
    // StmtMatch path uses, so `return match (f(5)) { Ok(v) => v, Err(e) => e }`
    // (a call scrutinee) lowers instead of bailing. A user-enum payload is read
    // from the variant's `__ev` field. A non-i32 (or unresolvable) payload bails.
    var opt_srt: string = try_opt_type(m.scrutinee, ts);
    // The temp is i32 unless classified f64 / i64 / string above. A nested-Option
    // payload binding is admitted only into an i32 temp, and only for an ident
    // scrutinee (see iife_payload_bindable).
    var temp_is_i32: boolean = !ts.is_f64_slot(tslot) && !ts.is_i64_slot(tslot) && !ts.is_str_slot(tslot);
    var scrut_is_ident: boolean = false;
    match (m.scrutinee) {
        parser.ExprIdent(sidc) => { scrut_is_ident = true; },
        _ => {}
    }
    var newarms: parser.MatchArm[] = [];
    var i: i32 = 0;
    while (i < m.arms.len()) {
        var arm: parser.MatchArm = m.arms[i];
        match (arm.pattern) {
            parser.PatVariant(pv) => {
                if (pv.extra_bindings.len() > 0) { return s.fail(); }
                if (pv.binding.len() > 0 && pv.binding != "_") {
                    // Single payload binding: an i32 payload (`tmp = n` is an i32
                    // store), or a nested-Option payload into an i32 temp (bound via
                    // the underlying StmtMatch path, consumed by an inner match).
                    if (!iife_payload_bindable(pv, opt_srt, temp_is_i32, scrut_is_ident, ts)) { return s.fail(); }
                }
            },
            _ => {}
        }
        if (arm.body.len() != 1) { return s.fail(); }
        match (arm.body[0]) {
            parser.StmtReturn(r) => {
                // f64 / string results admitted only into a matching temp (set
                // above for an f64- / string-valued match); otherwise into the i32
                // temp they bail. The rewritten `tmp = E` store is steered by the
                // temp's slot type.
                if (expr_is_f64(r.value, ts) && !ts.is_f64_slot(tslot)) { return s.fail(); }
                if (expr_is_str(r.value, ts) && !ts.is_str_slot(tslot)) { return s.fail(); }
                // An i64-width result is admitted into an i64 temp (the rewritten
                // `tmp = E` store widens via the i64-typed target); into a non-i64
                // temp it bails.
                if (infer_expr_width(r.value, ts) == 64 && !ts.is_i64_slot(tslot)) { return s.fail(); }
                var nbody: parser.Stmt[] = [parser.StmtAssign { target: tmp, value: r.value, line: 0, col: 0, target_line: 0, target_col: 0 }];
                newarms = newarms.append(parser.MatchArm { pattern: arm.pattern, body: nbody, line: arm.line, col: arm.col, guard: arm.guard, has_guard: arm.has_guard });
            },
            _ => { return s.fail(); }
        }
        i = i + 1;
    }
    var newmatch: parser.Stmt = parser.StmtMatch { scrutinee: m.scrutinee, arms: newarms, line: m.line, col: m.col, origin: m.origin };
    var ls: LowerState = lower_stmt(newmatch, ts);
    if (!ls.ok) { return ls; }
    return ls.emit(ir.op_load_local(tslot));
}

// lower_value_if lowers an if-expression's desugared StmtIf as a void `if` that
// STORES each branch's value into tslot (instead of returning it from the
// enclosing function). Both branches are value tails (lower_value_tail); the
// else is required (an if-expression always has one).
function lower_value_if(iff: parser.StmtIf, tslot: i32, s: LowerState): LowerState {
    if (iff.else_body.len() == 0) { return s.fail(); }
    var cs: LowerState = lower_expr(iff.cond, s);
    if (!cs.ok) { return cs; }
    cs = cs.emit(ir.op_if(0));
    cs = lower_value_tail(iff.then_body, tslot, cs);
    if (!cs.ok) { return cs; }
    cs = cs.emit(ir.op_else());
    cs = lower_value_tail(iff.else_body, tslot, cs);
    if (!cs.ok) { return cs; }
    return cs.emit(ir.op_end());
}

// lower_value_tail lowers an if-expression branch whose last statement produces
// the value: any leading statements lower normally, then the terminal
// `return E` becomes `store tslot = E`, or a nested `else if` recurses through
// lower_value_if. Only an i32 result inlines into the i32 temp — an f64 /
// string / i64-width value bails so it stays on the AST path.
function lower_value_tail(body: parser.Stmt[], tslot: i32, s: LowerState): LowerState {
    if (body.len() == 0) { return s.fail(); }
    var cs: LowerState = s;
    var i: i32 = 0;
    while (i < body.len() - 1) {
        cs = lower_stmt(body[i], cs);
        if (!cs.ok) { return cs; }
        i = i + 1;
    }
    var last: parser.Stmt = body[body.len() - 1];
    match (last) {
        parser.StmtReturn(r) => {
            // An f64 result is admitted into an f64 temp (an f64-valued if-expr —
            // lower_iife marked the temp); the 8-byte store/load is steered by the
            // temp's f64 slot type. An f64 into a non-f64 temp still bails.
            if (expr_is_f64(r.value, cs)) {
                if (!cs.is_f64_slot(tslot)) { return s.fail(); }
                cs = lower_expr(r.value, cs);
                if (!cs.ok) { return cs; }
                return cs.emit(ir.op_store_local(tslot));
            }
            // An i64 result is admitted into an i64 temp (lower_iife marked it for
            // an i64-width if-expr); lower_i64 widens each branch value (so a small
            // literal branch becomes a full i64) and the 8-byte store is steered by
            // the temp's i64 slot type.
            if (cs.is_i64_slot(tslot)) {
                cs = lower_i64(r.value, cs);
                if (!cs.ok) { return cs; }
                return cs.emit(ir.op_store_local(tslot));
            }
            // A string result is admitted only when the temp is a STRING temp
            // (a string-valued if/match-expression — lower_iife marked it); the
            // pointer store/load is otherwise identical to the i32 path. A string
            // value into an i32 temp (a type error / unexpected shape) still bails.
            if (expr_is_str(r.value, cs) && !cs.is_str_slot(tslot)) { return s.fail(); }
            if (infer_expr_width(r.value, cs) == 64) { return s.fail(); }
            cs = lower_expr(r.value, cs);
            if (!cs.ok) { return cs; }
            return cs.emit(ir.op_store_local(tslot));
        },
        parser.StmtIf(nested) => {
            return lower_value_if(nested, tslot, cs);
        },
        _ => { return s.fail(); }
    }
    return s.fail();
}

// lower_stmt lowers one top-level statement of the i32 subset.
pub function lower_stmt(st: parser.Stmt, s: LowerState): LowerState {
    if (!s.ok) { return s; }
    match (st) {
        parser.StmtVar(v) => {
            // Type ascription `var x = E as T` (#2669): the `as` is a zero-cost
            // annotation, so this is `var x: T = E`. ascription_rebind returns
            // that rewritten binding (operand as init, T as the annotation) so
            // the existing array / string / struct slot-marking + RC accounting
            // run off the real value — leaving the slot untyped dropped the
            // alias-inc and broke `__rc`. Kept out of line so this huge arm
            // doesn't grow (oversized functions miscompile — cf. #2720).
            if (ascription_target(v.init) != "") { return lower_stmt(ascription_rebind(v), s); }
            // Binding a scalar-array struct field (`var y = h.items`) aliases the
            // array — which the AST path retains but the leak-only IR path can't;
            // bail to AST to preserve that RC behaviour.
            if (is_scalar_arr_field_access(v.init, s)) { return s.fail(); }
            // `var xs: dyn Trait[] = [ ... ]` — a `dyn Trait` ARRAY literal. Each
            // element coerces to `dyn Trait`: a struct/enum element flows unboxed
            // (it carries its shape), a primitive/string element is heap-boxed via
            // op_dyn_box so it carries a shape pointer (docs/DYN-TRAITS.md
            // §4.2.3). lower_dyn_arg makes that per-element box/no-box choice; the
            // boxed pointers then ride one array slot each, and the slot is bound
            // is_arr with NO element struct type so `for x in xs` reads the loop
            // var as "unknown" → runtime shape dispatch (the §4.3 array tag fix).
            if (v.type_name.len() > 6 && v.type_name[0:4] == "dyn " && is_array_type_name(v.type_name)) {
                var dab_ok: boolean = false;
                match (v.init) { parser.ExprArray(_) => { dab_ok = true; }, _ => {} }
                if (dab_ok) {
                    match (v.init) {
                        parser.ExprArray(darr) => {
                            var das: LowerState = s;
                            var dei: i32 = 0;
                            while (dei < darr.elements.len()) {
                                das = lower_dyn_arg(darr.elements[dei], das);
                                if (!das.ok) { return das; }
                                dei = dei + 1;
                            }
                            das = das.emit(ir.op_arr_make(darr.elements.len(), 32));
                            var dab: LowerState = das.add_local(v.name);
                            var daslot: i32 = dab.slot_of(v.name);
                            dab = dab.mark_arr(daslot, true);
                            return dab.emit(ir.op_store_local(daslot));
                        },
                        _ => {}
                    }
                }
            }
            // `var d: dyn Trait = <expr>` — a SCALAR `dyn Trait` binding (NOT a
            // `dyn Trait[]` array, handled above). The init coerces to `dyn Trait`
            // via lower_dyn_arg: a struct/enum value flows UNBOXED (it carries its
            // shape pointer), a primitive/string is heap-boxed via op_dyn_box so it
            // carries a shape pointer (docs/DYN-TRAITS.md §4.2.3). The slot's
            // local_struct_type is set to the coarse `"dyn <Trait>"` string (NOT
            // the concrete type) so a later `d.m()` reads the receiver's
            // expr_struct_type as `"dyn …"` and routes through op_dyn_dispatch
            // (runtime shape dispatch) — matching the interpreter — rather than
            // static-dispatching to the concrete impl.
            if (v.type_name.len() > 4 && v.type_name[0:4] == "dyn " && !is_array_type_name(v.type_name)) {
                var dvs: LowerState = lower_dyn_arg(v.init, s);
                if (!dvs.ok) { return dvs; }
                var dvb: LowerState = dvs.add_local(v.name);
                var dvslot: i32 = dvb.slot_of(v.name);
                dvb = dvb.mark_struct_type(dvslot, v.type_name);
                return dvb.emit(ir.op_store_local(dvslot));
            }
            // First-class closure binding (slice 3a): `var f = <lambda>` or
            // `var f = <call to a closure-returning fn>` — the init lowers to an
            // i32[] env box; bind f as an array slot AND mark it a closure local
            // so a later `f(args)` uses the env-passing closure-call form.
            var clo_init: boolean = false;
            match (v.init) {
                parser.ExprLambda(_) => { clo_init = true; },
                parser.ExprCall(cc) => {
                    match (cc.callee) {
                        parser.ExprIdent(cid) => { if (util.index_of_str(s.closure_fns, cid.name) >= 0) { clo_init = true; } },
                        _ => { }
                    }
                },
                // `var c = fns[i]` where fns is a closure[]: the element is a
                // closure box, so bind c as a closure local (its call unpacks the
                // box). Without this, `c()` would call the raw box pointer as a
                // table index and trap.
                parser.ExprIndex(ix) => {
                    match (ix.array) {
                        parser.ExprIdent(aid) => { if (s.is_closurearr_slot(s.slot_of(aid.name))) { clo_init = true; } },
                        _ => { }
                    }
                },
                _ => { }
            }
            if (clo_init) {
                var cv: LowerState = lower_expr(v.init, s);
                if (!cv.ok) { return cv; }
                var cvb: LowerState = cv.add_local(v.name);
                var cslot: i32 = cvb.slot_of(v.name);
                cvb = cvb.mark_arr(cslot, true);
                cvb = cvb.mark_closure_local(v.name);
                return cvb.emit(ir.op_store_local(cslot));
            }
            // 2-element tuple destructure `var (a, b) = E` — the parser encodes
            // the name as "a,b". Eval the tuple box into a fresh temp, then bind
            // a = tuple_get(0), b = tuple_get(1). Scalar elements only; >2
            // elements (another comma in the tail) or a non-tuple init bail.
            var comma: i32 = 0 - 1;
            var ci: i32 = 0;
            while (ci < v.name.len()) {
                if (v.name[ci] == 44 && comma < 0) { comma = ci; }
                ci = ci + 1;
            }
            // i64 binding: `var x: i64 = E`, or an init that infers to i64
            // (`var z = a + 1` with a:i64, `var y = a`). Mark the slot i64, lower
            // the init as an i64 value, store. Scalar locals only — i64 arrays /
            // params / returns are deferred to the AST path (lower_func bails on
            // an i64 param/return; lower_i64 bails on anything non-i64-value).
            if (comma < 0 && (v.type_name == "i64" || v.type_name == "u64" || infer_expr_width(v.init, s) == 64)) {
                var iv: LowerState = lower_i64(v.init, s);
                if (!iv.ok) { return iv; }
                var ivb: LowerState = iv.add_local(v.name);
                var islot: i32 = ivb.slot_of(v.name);
                ivb = ivb.mark_i64(islot, true);
                // A `u64` binding (annotated, or an init that is itself u64) marks
                // the slot u64 so its compares / `>>` / `/` / `%` select the
                // UNSIGNED i64 ops (#2904).
                if (v.type_name == "u64" || expr_is_u64(v.init, s)) { ivb = ivb.mark_u64(islot, true); }
                return ivb.emit(ir.op_store_local(islot));
            }
            // f64 binding: `var x: f64 = E`, or an init that infers to f64
            // (`var c = a + b` with a/b:f64). lower_expr already routes float
            // literals/arithmetic through const_f64 / the float ops, pushing the
            // 8-byte bit pattern; mark the slot f64 so later uses pick the float
            // ops. Scalar locals only — f64 params / returns / arrays / fields
            // are deferred to the AST path (lower_func bails an f64 signature).
            if (comma < 0 && (is_f64_scalar_type_name(v.type_name) || expr_is_f64(v.init, s))) {
                var fv: LowerState = lower_expr(v.init, s);
                if (!fv.ok) { return fv; }
                var fvb: LowerState = fv.add_local(v.name);
                var fslot: i32 = fvb.slot_of(v.name);
                fvb = fvb.mark_f64(fslot, true);
                return fvb.emit(ir.op_store_local(fslot));
            }
            // i64 array LITERAL: `var a: i64[] = [e0, e1, …]`. Elements aren't
            // self-evidently i64 (a bare integer literal could be i32), so the
            // `i64[]` annotation drives it: lower each element via lower_i64
            // (8-byte i64 values), emit arr_make_i64 (8-byte stride + i64.store
            // on wasm), and mark the slot as an i64 array (is_arr for RC, is_i64arr
            // for element typing). Aliasing / params go through the generic array
            // path below (which now also marks is_i64arr).
            if (comma < 0 && v.type_name == "i64[]") {
                var i64lit: boolean = false;
                match (v.init) {
                    parser.ExprArray(_) => { i64lit = true; },
                    _ => {}
                }
                if (i64lit) {
                    match (v.init) {
                        parser.ExprArray(iarr) => {
                            var ia: LowerState = s;
                            var iae: i32 = 0;
                            while (iae < iarr.elements.len()) {
                                ia = lower_i64(iarr.elements[iae], ia);
                                if (!ia.ok) { return ia; }
                                iae = iae + 1;
                            }
                            ia = ia.emit(ir.op_arr_make_i64(iarr.elements.len()));
                            var iab: LowerState = ia.add_local(v.name);
                            var iaslot: i32 = iab.slot_of(v.name);
                            iab = iab.mark_arr(iaslot, true);
                            iab = iab.mark_i64arr(iaslot, true);
                            return iab.emit(ir.op_store_local(iaslot));
                        },
                        _ => {}
                    }
                }
            }
            if (comma >= 0) {
                // N-element destructure `var (a, b, c, …) = E`: the parser encodes
                // the name as "a,b,c,…". Eval the tuple box into a fresh temp, then
                // bind name[i] = tuple_get(i). Scalar / string / struct elements
                // (the same set the tuple LITERAL admits — a heap element bails the
                // init lowering, so it never reaches here).
                var dnames: string[] = [];
                var dstart: i32 = 0;
                var dp: i32 = 0;
                while (dp <= v.name.len()) {
                    if (dp == v.name.len() || v.name[dp] == 44) {
                        dnames = dnames.append(v.name[dstart : dp]);
                        dstart = dp + 1;
                    }
                    dp = dp + 1;
                }
                var dn: i32 = dnames.len();
                var dt: LowerState = lower_expr(v.init, s);
                if (!dt.ok) { return dt; }
                var tmp: string = "$tdst" + util.i32_to_string(dt.local_names.len());
                dt = dt.add_local(tmp);
                var tmp_slot: i32 = dt.slot_of(tmp);
                dt = dt.emit(ir.op_store_local(tmp_slot));
                var dk: i32 = 0;
                while (dk < dn) {
                    dt = dt.add_local(dnames[dk]);
                    var dkslot: i32 = dt.slot_of(dnames[dk]);
                    // Type the binding from the source tuple's element tag: an
                    // inline `(e0, e1, …)` literal from the element exprs, a tuple
                    // local/param from its tracked tags. (Tags read from `s`, the
                    // pre-destructure scope, where the source elements live.)
                    var dtag: string = "";
                    match (v.init) {
                        parser.ExprTuple(dl) => {
                            if (dl.elements.len() == dn) { dtag = elem_type_tag(dl.elements[dk], s); }
                        },
                        parser.ExprIdent(did) => { dtag = s.tuple_elem_tag(s.slot_of(did.name), dk); },
                        parser.ExprCall(dcl) => {
                            // `var (a, b, …) = f()` / `= obj.f()` — recover element
                            // dk's tag from the tuple-returning function's registry
                            // entry (free fn by bare name, method by "Type.method").
                            match (dcl.callee) {
                                parser.ExprIdent(dcid) => { dtag = csv_nth(s.tuple_ret_type(dcid.name), dk); },
                                parser.ExprFieldAccess(dfa) => {
                                    var drty: string = expr_struct_type(dfa.obj, s);
                                    if (drty != "") { dtag = csv_nth(s.tuple_ret_type(drty + "." + dfa.field), dk); }
                                    else if (dfa.field == "without") {
                                        // `m.without(k)` yields (Map[K,V], boolean):
                                        // element 0 is the receiver's map type, 1 is
                                        // the existed flag. Tag elem 0 with the map
                                        // type so the bound local re-marks as a map
                                        // (else `m2.len()` etc. miscompile) (#2926).
                                        var dwmt: string = "";
                                        match (dfa.obj) {
                                            parser.ExprIdent(dwid) => { dwmt = s.map_type_of(s.slot_of(dwid.name)); },
                                            _ => {}
                                        }
                                        if (dwmt != "") {
                                            if (dk == 0) { dtag = dwmt; } else { dtag = "boolean"; }
                                        }
                                    }
                                },
                                _ => {}
                            }
                        },
                        _ => {}
                    }
                    // Emit the element read at its width (8-byte i64/f64 use the
                    // matching load), then store + type the binding. An i64
                    // element marks the slot i64 (so later uses route through
                    // lower_i64); an f64 element marks it f64.
                    dt = dt.emit(ir.op_load_local(tmp_slot));
                    if (dtag == "i64") { dt = dt.emit(ir.op_tuple_get_w(dk, 64, true)); }
                    else if (dtag == "f64") { dt = dt.emit(ir.op_tuple_get_w(dk, 64, false)); }
                    else { dt = dt.emit(ir.op_tuple_get(dk)); }
                    dt = dt.emit(ir.op_store_local(dkslot));
                    if (dtag == "string") { dt = dt.mark_str(dkslot, true); }
                    else if (dtag == "i64") { dt = dt.mark_i64(dkslot, true); }
                    else if (dtag == "f64") { dt = dt.mark_f64(dkslot, true); }
                    else if (is_map_type_name(dtag)) { dt = dt.mark_map_type(dkslot, dtag); }
                    else if (dtag.len() >= 8 && (dtag[0:7] == "Option[" || dtag[0:7] == "Result[")) { dt = dt.mark_opt_type(dkslot, dtag); }
                    else if (decl_is_struct(dt.structs, dtag)) { dt = dt.mark_struct_type(dkslot, dtag); }
                    dk = dk + 1;
                }
                return dt;
            }
            // Map construction `var m: Map[K, V] = map_new(n)`: the callee
            // `map_new` is generic, so the KEY KIND comes from the annotation, not
            // the callee name. Emit op_map_new with the annotated key kind here so
            // the wasm backend selects the right constructor (i32 vs string keys).
            match (v.init) {
                parser.ExprCall(mnc) => {
                    match (mnc.callee) {
                        parser.ExprIdent(mnid) => {
                            if ((mnid.name == "map_new" || mnid.name == "map_new_i32") && mnc.args.len() == 1 && v.type_name.len() >= 5 && v.type_name[0:4] == "Map[") {
                                var inner2: string = v.type_name[4 : v.type_name.len()];
                                var kkind: i32 = 0 - 1;
                                var ktag: string = "";
                                if (inner2.len() >= 4 && inner2[0:4] == "i32,") { kkind = 1; ktag = "i32"; }
                                else if (inner2.len() >= 7 && inner2[0:7] == "string,") { kkind = 0; ktag = "string"; }
                                if (kkind >= 0) {
                                    var mns: LowerState = lower_expr(mnc.args[0], s);
                                    if (!mns.ok) { return mns; }
                                    mns = mns.emit(ir.op_map_new(kkind));
                                    var mnsb: LowerState = mns.add_local(v.name);
                                    var mnslot: i32 = mnsb.slot_of(v.name);
                                    mnsb = mnsb.mark_map_type(mnslot, v.type_name);
                                    return mnsb.emit(ir.op_store_local(mnslot));
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            var se: LowerState = lower_expr(v.init, s);
            if (!se.ok) { return se; }
            // Perceus alias-inc + array tracking: a fresh array literal is
            // owned at rc=1 (no inc); binding a new name to an EXISTING array
            // local creates a second reference, which must retain (inc) the
            // buffer. Mark the new slot's array-ness either way.
            var is_arr: boolean = false;
            var alias_inc: boolean = false;
            match (v.init) {
                parser.ExprArray(_) => { is_arr = true; },
                parser.ExprIdent(id) => {
                    // Binding a new name to an EXISTING array local creates a
                    // second reference → retain (alias_inc).
                    if (se.is_arr_slot(se.slot_of(id.name))) { is_arr = true; alias_inc = true; }
                },
                parser.ExprCall(cc) => {
                    // `var x = f()` where f returns an array: a MOVE — x takes
                    // ownership of the callee's already-owned buffer (rc=1), so
                    // no inc; just track x as an array.
                    match (cc.callee) {
                        parser.ExprIdent(fid) => {
                            // `__alloc_u8(n)` yields a fresh owned byte array (a
                            // move, like an arr-returning call).
                            if (fid.name == "__alloc_u8") { is_arr = true; }
                            // `str_split(s, sep)` yields a fresh owned string[] — a
                            // move, track as array (is_strarr comes from expr_is_strarr).
                            else if (fid.name == "str_split" && cc.args.len() == 2) { is_arr = true; }
                            else if (se.is_arr_ret_fn(fid.name)) { is_arr = true; }
                        },
                        // `var b = s.bytes()` / `= s.as_bytes()`: op_str_bytes
                        // returns a fresh owned u8[] (rc=1) — a move, track as array.
                        // `var parts = s.split(sep)`: op_str_split likewise returns a
                        // fresh owned string[].
                        parser.ExprFieldAccess(cfa) => {
                            if ((cfa.field == "bytes" || cfa.field == "as_bytes") && cc.args.len() == 0 && expr_is_str(cfa.obj, se)) { is_arr = true; }
                            else if (cfa.field == "split" && cc.args.len() == 1 && expr_is_str(cfa.obj, se)) { is_arr = true; }
                            else if (cfa.field == "chars" && cc.args.len() == 0 && expr_is_str(cfa.obj, se)) { is_arr = true; }
                            else if (cfa.field == "lines" && cc.args.len() == 0 && expr_is_str(cfa.obj, se)) { is_arr = true; }
                            // `var a = obj.m()` where obj is a struct and method `m`
                            // returns an array (e.g. a struct-array `P[]`) — a MOVE,
                            // track a as an array so `a[i].field` / `for x in a`
                            // recover the element type (struct_ret_type carries the
                            // element struct type, keyed "<Type>.m"). The struct
                            // receiver gate keeps this to a genuine method call (#3040).
                            else if (se.is_arr_ret_fn(cfa.field) && expr_struct_type(cfa.obj, se) != "") { is_arr = true; }
                        },
                        // `var a = if (c) { [..] } else { [..] }` — an if-/match-
                        // EXPRESSION desugars to a 0-arg IIFE (callee is ExprLambda).
                        // If the first branch returns an array literal, the slot
                        // holds a fresh owned array (rc=1, a move — no alias_inc), so
                        // track is_arr; `for x in a` / `a.len()` then resolve.
                        parser.ExprLambda(clam) => {
                            if (clam.body.len() > 0) {
                                match (iife_leaf_value(v.init)) {
                                    parser.ExprArray(_) => { is_arr = true; },
                                    _ => {}
                                }
                            }
                        },
                        _ => {}
                    }
                },
                parser.ExprSlice(sl) => {
                    // `var x = arr[a:b]`: arr_slice returns a FRESH owned array
                    // (rc=1) — a move, no alias_inc. (A string slice isn't an
                    // array.)
                    if (expr_is_arr_src(sl.array, se)) { is_arr = true; }
                },
                // `var row = a[i]` where `a` is an array-of-arrays: the element is
                // itself an array, so the binding is an array source (lets a later
                // `for x in row` / `row` flow as an array). The element box is the
                // source array's own buffer (a borrow), so no alias_inc here.
                parser.ExprIndex(ixx) => {
                    match (ixx.array) {
                        parser.ExprIdent(aid) => { if (se.is_arrarr_slot(se.slot_of(aid.name))) { is_arr = true; } },
                        _ => {}
                    }
                },
                _ => {}
            }
            // String tracking: a `var s = <string expr>` marks the slot as a
            // string (for later `.len()` / concat / eq dispatch). Strings aren't
            // RC'd, so this never sets alias_inc / is_arr — a plain store. The
            // declared type annotation (`var s: string = …`) is authoritative too:
            // it catches a string flowing through an erased generic call
            // (`var s: string = id("hi")`), where the init expr isn't structurally
            // a string but the checker has proven the slot's type.
            var is_str: boolean = expr_is_str(v.init, se) || v.type_name == "string";
            // Struct tracking: `var p = P { .. }` (or `= other_struct_local`, or a
            // `var p: P = …` annotation) records the slot's struct type so `p.x`
            // resolves the field index. Leak-only scalar structs — no RC.
            var struct_ty: string = expr_struct_type(v.init, se);
            if (struct_ty == "" && decl_is_struct(se.structs, v.type_name)) { struct_ty = v.type_name; }
            // An enum-typed annotation (`var a: Shape = Circle(3)`) carries the
            // enum name in local_struct_type too, so `a.method()` dispatches to
            // `<Enum>.<method>` (enum-receiver methods).
            else if (struct_ty == "" && is_enum_like_name(v.type_name, se.structs)) { struct_ty = v.type_name; }
            // A struct- or enum-ARRAY annotation (`var ps: P[]` / `var cs: C[]`)
            // carries the ELEMENT type (the slot is is_arr, so it reads as the
            // element type for `ps[i]` / `for x in ps`, not the slot's own type).
            // An enum element type lets `cs[i].method()` dispatch to
            // `<Enum>.<method>` (the array-element analog of #2947, #2954 item 2).
            else if (struct_ty == "" && is_array_type_name(v.type_name)
                     && (decl_is_struct(se.structs, v.type_name[0 : v.type_name.len() - 2])
                         || is_enum_like_name(v.type_name[0 : v.type_name.len() - 2], se.structs))) {
                struct_ty = v.type_name[0 : v.type_name.len() - 2];
            }
            // A 2D struct-/enum-ARRAY annotation (`var a: P[][]`): the INNERMOST
            // element is the struct/enum (strip both `[]`). The slot is is_arrarr;
            // the array-foreach propagates this element type through `row` (the
            // inner array) to its struct element, so `for row in a { for p in row
            // { p.field } }` resolves (#3059, the depth-2 sibling of the P[] case).
            else if (struct_ty == "" && is_array_type_name(v.type_name)
                     && v.type_name.len() >= 4 && is_array_type_name(v.type_name[0 : v.type_name.len() - 2])
                     && (decl_is_struct(se.structs, v.type_name[0 : v.type_name.len() - 4])
                         || is_enum_like_name(v.type_name[0 : v.type_name.len() - 4], se.structs))) {
                struct_ty = v.type_name[0 : v.type_name.len() - 4];
            }
            // A struct-array LITERAL without annotation (`var ps = [P { .. }, ..]`):
            // infer the ELEMENT struct type from the first element, matching the
            // `var ps: P[]` annotation path above, so `ps[i].field` / `for x in ps`
            // recover it instead of bailing to the AST fallback (#2793 sibling).
            else if (struct_ty == "") {
                match (v.init) {
                    parser.ExprArray(arrl) => {
                        if (arrl.elements.len() > 0) {
                            var est: string = expr_struct_type(arrl.elements[0], se);
                            if (est != "" && decl_is_struct(se.structs, est)) { struct_ty = est; }
                            else {
                                // An enum-array literal (`var a = [R, G]`): the
                                // element type is the variants' enum owner, so
                                // `a[i].method()` dispatches to `<Enum>.<method>`
                                // (#2954 item 2).
                                var eet: string = expr_enum_type(arrl.elements[0], se);
                                if (eet != "") { struct_ty = eet; }
                                // A 2D struct/enum array LITERAL (`[[P { .. }], …]`):
                                // the first element is itself an array — recurse into
                                // ITS first element for the innermost struct/enum
                                // type (the unannotated-literal sibling of #3058; the
                                // depth-2 array literal sets is_arrarr below, and the
                                // array-foreach propagates this element type through
                                // `row` to its element).
                                else {
                                    match (arrl.elements[0]) {
                                        parser.ExprArray(inner) => {
                                            if (inner.elements.len() > 0) {
                                                var iest: string = expr_struct_type(inner.elements[0], se);
                                                if (iest != "" && decl_is_struct(se.structs, iest)) { struct_ty = iest; }
                                                else {
                                                    var ieet: string = expr_enum_type(inner.elements[0], se);
                                                    if (ieet != "") { struct_ty = ieet; }
                                                }
                                            }
                                        },
                                        _ => {}
                                    }
                                }
                            }
                        }
                    },
                    _ => {}
                }
            }
            // LAST resort: an UNANNOTATED binding to an enum VALUE (`var c = Green`,
            // `var e = A(9)`) records the slot's ENUM type — recovered from the
            // variant via its enum_owner — so `c.method()` dispatches to
            // `<Enum>.<method>`. Without this the slot stays untyped and the
            // enum-receiver method call bails the whole module to AST (#2947).
            // A standalone `if` (NOT chained off the struct-array-literal `else
            // if (struct_ty == "")` above, which is entered for ANY untyped init
            // and would otherwise swallow this clause for a non-array enum init —
            // e.g. `var e = A(9)`): it runs whenever the slot is still untyped,
            // and expr_enum_type is "" for the struct / struct-array branches, so
            // it never pre-empts them.
            if (struct_ty == "") {
                var enum_init: string = expr_enum_type(v.init, se);
                if (enum_init != "") { struct_ty = enum_init; }
            }
            // A struct-valued if-/match-EXPRESSION (`var p = if (c) { P { .. } }
            // else { .. }`) desugars to a 0-arg IIFE (ExprCall{callee: ExprLambda}).
            // Recover p's struct type from the first branch's returned struct
            // literal, so `p.field` resolves (the struct sibling of the Option
            // if-expression binding #3124; lower_iife already lowers the
            // struct-valued if-expression itself, as it does for tuple/enum).
            if (struct_ty == "") {
                match (v.init) {
                    parser.ExprCall(ic) => {
                        match (ic.callee) {
                            parser.ExprLambda(ilam) => {
                                if (ilam.body.len() > 0) {
                                    var bre: parser.Expr = iife_leaf_value(v.init);
                                    var bst: string = expr_struct_type(bre, se);
                                    if (bst != "" && decl_is_struct(se.structs, bst)) { struct_ty = bst; }
                                    else {
                                        // A struct-ARRAY-valued if-/match-expression
                                        // (`var ps = if (c) { [P { .. }] } else { … }`):
                                        // record the ELEMENT struct type and mark the
                                        // slot is_arr (a fresh owned move, rc=1, no
                                        // alias_inc), so `ps[i].field` resolves.
                                        match (bre) {
                                            parser.ExprArray(bra) => {
                                                if (bra.elements.len() > 0) {
                                                    var est: string = expr_struct_type(bra.elements[0], se);
                                                    if (est != "" && decl_is_struct(se.structs, est)) { struct_ty = est; is_arr = true; }
                                                }
                                            },
                                            _ => {}
                                        }
                                    }
                                }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
            }
            // Aliasing an array local (`var qs = ps`) — expr_struct_type returns
            // "" for an array (the value itself isn't a struct), so the ELEMENT
            // struct/enum type the source array carries (which drives
            // `qs[i].field` / `qs[i].method()` dispatch) would be lost. Copy it
            // from the source slot. (is_arr / alias_inc are already set by the
            // ExprIdent arm above.)
            if (struct_ty == "") {
                match (v.init) {
                    parser.ExprIdent(aid) => {
                        var asl: i32 = se.slot_of(aid.name);
                        if (se.is_arr_slot(asl)) { struct_ty = se.struct_type_of_slot(asl); }
                    },
                    _ => {}
                }
            }
            // string[] tracking (element typing for a[i]); the annotation is
            // authoritative too. The array itself is already is_arr (RC-tracked).
            var is_strarr: boolean = expr_is_strarr(v.init, se) || v.type_name == "string[]";
            // f64[] tracking (element WIDTH for a[i]); the annotation is
            // authoritative too. The array itself is already is_arr (RC-tracked).
            var is_f64arr: boolean = expr_is_f64arr(v.init, se) || v.type_name == "f64[]";
            // i64[] tracking (element WIDTH + i64 value typing for a[i]). The
            // literal form is handled by a dedicated branch above; here this
            // catches aliasing (`var b = a`) and the `i64[]` annotation.
            var is_i64arr: boolean = expr_is_i64arr(v.init, se) || v.type_name == "i64[]";
            // bind AFTER lowering the init (the init can't see the new name)
            // Option/Result tracking: `var r = f()` of an Option/Result-returning
            // call (or a `var r: Option[T] = …` annotation) records the slot's
            // Option type, so a later `match (r)` recovers the payload type.
            var opt_ty: string = "";
            match (v.init) {
                parser.ExprCall(ic) => {
                    match (ic.callee) {
                        parser.ExprIdent(icid) => {
                            opt_ty = se.opt_ret_type(icid.name);
                            // `var o = Some(7)` — a direct Option construction
                            // records o's opt_type so a later `match (o)`
                            // recovers the payload (the construction analogue of
                            // the Option-returning call above).
                            if (opt_ty == "") { opt_ty = some_opt_type(v.init, se); }
                        },
                        parser.ExprFieldAccess(ifa) => {
                            // `var o = x.get()` where x's method returns
                            // Option/Result — key by "<Type>.<method>" so a
                            // later `match (o)` recovers the payload type.
                            var irty: string = expr_struct_type(ifa.obj, se);
                            if (irty != "") { opt_ty = se.opt_ret_type(irty + "." + ifa.field); }
                            // An Option/Result-RECEIVER method (`Some(5).map()` /
                            // `r.map()`) keyed "Option.<m>" / "Result.<m>" (#3049).
                            else {
                                var irb: string = opt_recv_base_type(ifa.obj, se);
                                if (irb != "") { opt_ty = se.opt_ret_type(irb + "." + ifa.field); }
                                // An enum-receiver method returning Option/Result on
                                // a fresh variant (`var o = V(7).get()`) (#3076).
                                else {
                                    var ien: string = expr_enum_type(ifa.obj, se);
                                    if (ien != "") { opt_ty = se.opt_ret_type(ien + "." + ifa.field); }
                                }
                            }
                        },
                        // `var o = if (c) { Some(7) } else { None }` — an
                        // if-/match-EXPRESSION desugars to a 0-arg IIFE
                        // (ExprCall{callee: ExprLambda}). Recover o's Option type
                        // from the leaf branch's returned Some(...) via some_opt_type,
                        // so a later `match (o)` lowers (lower_iife already lowers the
                        // Option-valued if-expression itself). When the leaf branch
                        // returns an Option/Result-typed LOCAL instead of a fresh
                        // `Some(..)` (`if (c) { someOpt } else { None }`), recover from
                        // that slot's tracked opt_type.
                        parser.ExprLambda(ilam) => {
                            if (ilam.body.len() > 0) {
                                var oleaf: parser.Expr = iife_leaf_value(v.init);
                                opt_ty = some_opt_type(oleaf, se);
                                if (opt_ty == "") {
                                    match (oleaf) {
                                        parser.ExprIdent(olid) => { opt_ty = se.opt_type_of_slot(se.slot_of(olid.name)); },
                                        _ => {}
                                    }
                                }
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            if (opt_ty == "" && v.type_name.len() >= 8 && (v.type_name[0:7] == "Option[" || v.type_name[0:7] == "Result[")) { opt_ty = v.type_name; }
            // An UNANNOTATED array literal of Option values (`var a = [Some(1),
            // Some(2), None]`): infer the element opt-type from the first Some
            // element and record the slot's "Option[T][]" (the array form — the
            // foreach / index element path strips the trailing `[]`). The
            // construction analogue of the `var a: Option[T][] = …` annotation
            // above (#3024 array sibling). `None`-only literals stay untyped.
            if (opt_ty == "") {
                match (v.init) {
                    parser.ExprArray(oalit) => {
                        var oali: i32 = 0;
                        while (oali < oalit.elements.len()) {
                            var oaet: string = some_opt_type(oalit.elements[oali], se);
                            if (oaet != "") { opt_ty = oaet + "[]"; oali = oalit.elements.len(); }
                            else {
                                // A 2D Option literal (`[[Some(1)], …]`): the element
                                // is itself an array — recurse for the innermost
                                // Option type and append "[][]" (the depth-2 sibling;
                                // the annotated `Option[T][][]` form already works via
                                // the array-foreach opt propagation). #3073.
                                match (oalit.elements[oali]) {
                                    parser.ExprArray(oinner) => {
                                        var ioi: i32 = 0;
                                        while (ioi < oinner.elements.len()) {
                                            var ioet: string = some_opt_type(oinner.elements[ioi], se);
                                            if (ioet != "") { opt_ty = ioet + "[][]"; ioi = oinner.elements.len(); }
                                            else { ioi = ioi + 1; }
                                        }
                                    },
                                    _ => {}
                                }
                                if (opt_ty != "") { oali = oalit.elements.len(); } else { oali = oali + 1; }
                            }
                        }
                    },
                    _ => {}
                }
            }
            // `var a = if (c) { [Some(1)] } else { … }` — an Option-array bound
            // from an if-/match-EXPRESSION (IIFE: ExprCall{callee: ExprLambda}).
            // Recover the slot's "Option[T][]" from the first branch's array literal
            // (the IIFE sibling of the array-literal case above), so `match (a[i])`
            // / `for o in a` recover the element payload. The slot is already marked
            // is_arr for an IIFE-array result (#3141).
            if (opt_ty == "") {
                match (v.init) {
                    parser.ExprCall(oic) => {
                        match (oic.callee) {
                            parser.ExprLambda(oilam) => {
                                if (oilam.body.len() > 0) {
                                    match (iife_leaf_value(v.init)) {
                                        parser.ExprArray(obra) => {
                                            var obi: i32 = 0;
                                            while (obi < obra.elements.len()) {
                                                var obaet: string = some_opt_type(obra.elements[obi], se);
                                                if (obaet != "") { opt_ty = obaet + "[]"; obi = obra.elements.len(); }
                                                else { obi = obi + 1; }
                                            }
                                        },
                                        _ => {}
                                    }
                                }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
            }
            // `var o = a[i]` where `a` is an Option/Result ARRAY — the element is
            // an Option/Result value, so record o's opt_type (strip the array's
            // `[]`) so a later `match (o)` recovers the payload. This also drives
            // the desugared `for o in a` (its iter-hoist binds `var o =
            // __foreach_iter[idx]`). The ExprIdent arm preserves the array's
            // opt_type across the foreach's `var __foreach_iter = a` alias so the
            // element recovery still fires (mirrors the struct-element alias above).
            if (opt_ty == "") {
                match (v.init) {
                    parser.ExprIndex(oix) => {
                        match (oix.array) {
                            parser.ExprIdent(oaid) => {
                                var oaot: string = se.opt_type_of_slot(se.slot_of(oaid.name));
                                if (oaot.len() >= 2 && oaot[oaot.len() - 2 : oaot.len()] == "[]") {
                                    var oelt: string = oaot[0 : oaot.len() - 2];
                                    if (oelt.len() >= 8 && (oelt[0:7] == "Option[" || oelt[0:7] == "Result[")) { opt_ty = oelt; }
                                }
                            },
                            _ => {}
                        }
                    },
                    parser.ExprIdent(oaid2) => {
                        var oasl: i32 = se.slot_of(oaid2.name);
                        if (se.is_arr_slot(oasl)) {
                            var oaot2: string = se.opt_type_of_slot(oasl);
                            if (oaot2.len() >= 2 && oaot2[oaot2.len() - 2 : oaot2.len()] == "[]") { opt_ty = oaot2; }
                        }
                    },
                    _ => {}
                }
            }
            // An explicitly array-typed binding (`var w: u32[] = f()`) is an
            // array regardless of how the init was classified — the init-based
            // checks above miss an array-returning call when the array-return
            // registry isn't threaded (the eligibility probe), so fold in the
            // DECLARED type. Keeps a reassign-self `w = w.with(...)` eligible
            // without threading arr_ret_fns through the probe.
            if (is_array_type_name(v.type_name)) { is_arr = true; }
            // Closure-array: `var fns = [<closure>, ...]` — an array literal whose
            // elements are function VALUES (lambdas or calls to closure-returning
            // fns). Mark the slot so a later `var c = fns[i]` / `for f in fns`
            // types the element as a closure (its call unpacks the env box).
            var is_closurearr: boolean = false;
            match (v.init) {
                parser.ExprArray(carr) => {
                    if (carr.elements.len() > 0) {
                        match (carr.elements[0]) {
                            parser.ExprLambda(_) => { is_closurearr = true; },
                            parser.ExprCall(cec) => {
                                match (cec.callee) {
                                    parser.ExprIdent(cecid) => { if (util.index_of_str(se.closure_fns, cecid.name) >= 0) { is_closurearr = true; } },
                                    _ => { }
                                }
                            },
                            _ => { }
                        }
                    }
                },
                _ => { }
            }
            // Array-of-arrays (`i32[][]`, `string[][]`, …): set from a depth-2
            // array ANNOTATION, an array-of-array LITERAL (first element is itself
            // an array), or ALIASING an existing array-of-arrays local. Lets a
            // later `var row = a[i]` / `for row in a` type the inner element as an
            // array (so `for x in row` flows). One nesting level (depth 2).
            var is_arrarr: boolean = false;
            if (is_array_type_name(v.type_name) && v.type_name.len() >= 4 && is_array_type_name(v.type_name[0 : v.type_name.len() - 2])) { is_arrarr = true; }
            match (v.init) {
                parser.ExprArray(aarr) => {
                    if (aarr.elements.len() > 0) {
                        match (aarr.elements[0]) {
                            parser.ExprArray(_) => { is_arrarr = true; },
                            _ => {}
                        }
                    }
                },
                parser.ExprIdent(aaid) => { if (se.is_arrarr_slot(se.slot_of(aaid.name))) { is_arrarr = true; } },
                _ => {}
            }
            var sb: LowerState = se.add_local(v.name);
            var slot: i32 = sb.slot_of(v.name);
            sb = sb.mark_arr(slot, is_arr);
            sb = sb.mark_str(slot, is_str);
            sb = sb.mark_strarr(slot, is_strarr);
            sb = sb.mark_f64arr(slot, is_f64arr);
            sb = sb.mark_i64arr(slot, is_i64arr);
            sb = sb.mark_closurearr(slot, is_closurearr);
            sb = sb.mark_arrarr(slot, is_arrarr);
            sb = sb.mark_struct_type(slot, struct_ty);
            sb = sb.mark_opt_type(slot, opt_ty);
            // A `var m: Map[K, V] = <expr>` annotation records the slot's full
            // Map type so a later `m.get/insert/has/...` dispatches as a map op.
            // The `= map_new(n)` form is handled by the early-return path above;
            // this catches the other map-typed inits, e.g. binding a map struct
            // field (`var m: Map[K, V] = c.m`).
            if (is_map_type_name(v.type_name)) { sb = sb.mark_map_type(slot, v.type_name); }
            // Record tuple element type tags for `var t = (e0, e1, ...)` so a
            // later `t.N` recovers each element's type.
            match (v.init) {
                parser.ExprCall(mc) => {
                    match (mc.callee) {
                        parser.ExprIdent(mcid) => {
                            if ((mcid.name == "map_new" || mcid.name == "map_new_i32") && v.type_name.len() >= 5 && v.type_name[0:4] == "Map[") {
                                var inner: string = v.type_name[4 : v.type_name.len()];
                                if (inner.len() >= 4 && inner[0:4] == "i32,") { sb = sb.mark_map_type(slot, "i32"); }
                                else if (inner.len() >= 7 && inner[0:7] == "string,") { sb = sb.mark_map_type(slot, "string"); }
                            }
                            // `var t = f()` where f returns a tuple: record its
                            // element tags so a later `t.N` recovers each type.
                            var mctt: string = sb.tuple_ret_type(mcid.name);
                            if (mctt.len() > 0) { sb = sb.mark_tuple_elems(slot, mctt); }
                        },
                        parser.ExprFieldAccess(mfa) => {
                            // `var t = obj.f()` where the method returns a tuple:
                            // key by "<Type>.<method>".
                            var mrty: string = expr_struct_type(mfa.obj, sb);
                            if (mrty != "") {
                                var mmtt: string = sb.tuple_ret_type(mrty + "." + mfa.field);
                                if (mmtt.len() > 0) { sb = sb.mark_tuple_elems(slot, mmtt); }
                            }
                        },
                        _ => {}
                    }
                },
                parser.ExprTuple(tlit) => {
                    var enc: string = "";
                    var ti: i32 = 0;
                    while (ti < tlit.elements.len()) {
                        if (ti > 0) { enc = enc + ","; }
                        enc = enc + elem_type_tag(tlit.elements[ti], se);
                        ti = ti + 1;
                    }
                    sb = sb.mark_tuple_elems(slot, enc);
                },
                _ => {}
            }
            // A u32 / u32[] binding marks the slot u32 so its arithmetic wraps at
            // 2^32 and its `>>` is logical (expr_is_u32 / the binary-op masking).
            if (is_u32_type_name(v.type_name)) { sb = sb.mark_u32(slot, true); }
            if (is_u64_type_name(v.type_name)) { sb = sb.mark_u64(slot, true); }
            // Retain (alias) + cow-guarded dec-on-overwrite of the slot's prior
            // value (the loop-rebind reclamation; null on the first binding, so
            // a no-op there). An owned array slot drives the release; a fresh,
            // non-escaping struct local (slot_is_reclaimable_struct) drives the
            // same release so a loop-allocated struct temporary is freed each
            // iteration. No alias_inc for structs — an aliased struct is never
            // reclaimable (its name escapes via the RHS), so it is left to leak.
            return emit_arr_store(sb, slot, alias_inc, is_arr || slot_is_reclaimable_struct(sb, slot));
        },
        parser.StmtAssign(a) => {
            var slot: i32 = s.slot_of(a.target);
            if (slot < 0) { return s.fail(); }
            // `d = <expr>` where `d` is a SCALAR `dyn Trait` local (its
            // local_struct_type starts with "dyn "): the RHS coerces to `dyn
            // Trait` like the `var d: dyn = …` init — a struct/enum value flows
            // unboxed, a primitive/string is heap-boxed via op_dyn_box
            // (lower_dyn_arg makes that choice). Without this a primitive RHS
            // would land in the dyn slot unboxed and mis-dispatch
            // (docs/DYN-TRAITS.md §4.3). Non-dyn assignments fall through to the
            // generic paths below.
            var asg_dty: string = s.struct_type_of_slot(slot);
            if (asg_dty.len() > 4 && asg_dty[0:4] == "dyn " && !is_array_type_name(asg_dty)) {
                var das: LowerState = lower_dyn_arg(a.value, s);
                if (!das.ok) { return das; }
                return das.emit(ir.op_store_local(slot));
            }
            // Reassign-self builder mutation `a = a.with(i, v)` / `a = a.append(v)`
            // on an OWNED array slot. The single-owner / leak model makes `.with`
            // an in-place element store (arr_set: same layout + bytes as the AST
            // path's in-place .with) and `.append` a grow via __fern_arr_push
            // (arr_push, whose result re-binds the slot). Only fires when the
            // receiver names the assignment target; the aliasing form
            // `b = a.with(...)` is not this and falls through / bails.
            if (s.is_arr_slot(slot)) {
                match (a.value) {
                    parser.ExprCall(wc) => {
                        match (wc.callee) {
                            parser.ExprFieldAccess(wfa) => {
                                var self_recv: boolean = false;
                                match (wfa.obj) {
                                    parser.ExprIdent(wid) => { self_recv = wid.name == a.target; },
                                    _ => {}
                                }
                                if (self_recv && wfa.field == "with" && wc.args.len() == 2) {
                                    var ws: LowerState = s.emit(ir.op_load_local(slot));
                                    ws = lower_expr(wc.args[0], ws);
                                    if (!ws.ok) { return ws; }
                                    if (s.is_i64arr_slot(slot)) {
                                        ws = lower_i64(wc.args[1], ws);
                                        if (!ws.ok) { return ws; }
                                        return ws.emit(ir.op_arr_set_i64());
                                    }
                                    if (s.is_f64arr_slot(slot)) {
                                        ws = lower_expr(wc.args[1], ws);
                                        if (!ws.ok) { return ws; }
                                        return ws.emit(ir.op_arr_set(64));
                                    }
                                    ws = lower_expr(wc.args[1], ws);
                                    if (!ws.ok) { return ws; }
                                    return ws.emit(ir.op_arr_set(32));
                                }
                                if (self_recv && wfa.field == "append" && wc.args.len() == 1) {
                                    if (s.is_i64arr_slot(slot) || s.is_f64arr_slot(slot)) { return s.fail(); }
                                    var aps: LowerState = s.emit(ir.op_load_local(slot));
                                    aps = lower_expr(wc.args[0], aps);
                                    if (!aps.ok) { return aps; }
                                    aps = aps.emit(ir.op_arr_push());
                                    return aps.emit(ir.op_store_local(slot));
                                }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
            }
            // i64 reassignment: lower the value as an i64 and store. (i64 locals
            // aren't rc-tracked, so no alias-inc / old-value release.) Storing an
            // i64 value into a non-i64 slot would be a width mismatch — bail.
            if (s.is_i64_slot(slot)) {
                var iva: LowerState = lower_i64(a.value, s);
                if (!iva.ok) { return iva; }
                return iva.emit(ir.op_store_local(slot));
            }
            if (infer_expr_width(a.value, s) == 64) { return s.fail(); }
            // Assigning a scalar-array struct field aliases it — bail (see StmtVar).
            if (is_scalar_arr_field_access(a.value, s)) { return s.fail(); }
            // Perceus reassignment `y = x`: retain the new ref if it aliases an
            // rc-tracked array, and release the OLD value the slot held
            // (cow-guarded). A reassigned BORROWED array param (slot <
            // n_params) must NOT release its old value — the caller owns it.
            var reassign_inc: boolean = false;
            match (a.value) {
                parser.ExprIdent(id) => {
                    if (s.is_arr_slot(s.slot_of(id.name))) { reassign_inc = true; }
                },
                _ => {}
            }
            var target_is_arr: boolean = s.is_arr_slot(slot) && slot >= s.n_params;
            var se: LowerState = lower_expr(a.value, s);
            if (!se.ok) { return se; }
            return emit_arr_store(se, slot, reassign_inc, target_is_arr);
        },
        parser.StmtReturn(r) => {
            // i64-returning function: lower the value as an i64, run the exit
            // dec-sweep over array locals (no moved array — i64 isn't one), then
            // return. The wasm sig declares (result i64); x86/arm64 are unchanged.
            if (s.ret_is_i64) {
                var ri: LowerState = lower_i64(r.value, s);
                if (!ri.ok) { return ri; }
                ri = emit_dec_sweep_except(ri, 0 - 1);
                return ri.emit(ir.op_return());
            }
            // i64[]-returning function returning a bare array LITERAL: the
            // elements aren't self-evidently i64, so lower each via lower_i64 and
            // build the array with arr_make_i64 (8-byte i64 stride). The fresh
            // array is returned (moved to the caller); it isn't a local, so the
            // exit dec-sweep over array locals doesn't touch it. `return a` (an
            // i64-array local) falls through to the generic move-on-return path.
            if (s.ret_is_i64arr) {
                var rlit: boolean = false;
                match (r.value) {
                    parser.ExprArray(_) => { rlit = true; },
                    _ => {}
                }
                if (rlit) {
                    match (r.value) {
                        parser.ExprArray(rarr) => {
                            var ra: LowerState = s;
                            var rae: i32 = 0;
                            while (rae < rarr.elements.len()) {
                                ra = lower_i64(rarr.elements[rae], ra);
                                if (!ra.ok) { return ra; }
                                rae = rae + 1;
                            }
                            ra = ra.emit(ir.op_arr_make_i64(rarr.elements.len()));
                            ra = emit_dec_sweep_except(ra, 0 - 1);
                            return ra.emit(ir.op_return());
                        },
                        _ => {}
                    }
                }
            }
            // `return <expr>` from a SCALAR `dyn Trait`-returning function: the
            // value coerces to `dyn Trait` via lower_dyn_arg — a primitive/string
            // is heap-boxed via op_dyn_box (so it carries a shape pointer the
            // caller's dispatch can read), a struct/enum flows unboxed
            // (docs/DYN-TRAITS.md §4.3). The returned value is not a local array,
            // so the exit dec-sweep over array locals leaves it alone.
            if (s.ret_is_dyn) {
                var rds: LowerState = lower_dyn_arg(r.value, s);
                if (!rds.ok) { return rds; }
                rds = emit_dec_sweep_except(rds, 0 - 1);
                return rds.emit(ir.op_return());
            }
            // An i64 value returned from a non-i64 function is a width mismatch
            // the checker rejects; guard anyway so a stray i64 never lands in an
            // i32 return slot.
            if (infer_expr_width(r.value, s) == 64) { return s.fail(); }
            // Returning a scalar-array struct field aliases it out — the AST path
            // retains; bail so that RC behaviour is preserved (see StmtVar).
            if (is_scalar_arr_field_access(r.value, s)) { return s.fail(); }
            var se: LowerState = lower_expr(r.value, s);
            if (!se.ok) { return se; }
            // Perceus move-on-return: when the returned value is a bare array
            // local, it is MOVED to the caller — exclude it from the exit
            // dec-sweep so it isn't freed (the return-inc the caller would owe
            // and this dec cancel; here there is no return-inc, so eliding the
            // dec is the whole move). Everything else is released as usual.
            var moved: i32 = 0 - 1;
            match (r.value) {
                parser.ExprIdent(rid) => {
                    var rs: i32 = se.slot_of(rid.name);
                    if (se.is_arr_slot(rs)) { moved = rs; }
                },
                _ => {}
            }
            se = emit_dec_sweep_except(se, moved);
            return se.emit(ir.op_return());
        },
        parser.StmtIf(iff) => {
            // Structured control flow, wasm-style: <cond> if <then> [else
            // <else>] end. The operand stack is empty at block boundaries
            // (statements balance it; `if` consumes the cond), so branches
            // never carry operand-stack values — the backend lowering stays
            // clean. NOTE: locals declared inside a branch keep their slots
            // (no block-scoped reuse yet); a later slice can pop them.
            // An i64 condition (truthiness on an i64) isn't lowered — bail. A
            // comparison of i64 operands infers i32, so `if (a < b)` is fine.
            if (infer_expr_width(iff.cond, s) == 64) { return s.fail(); }
            var sc: LowerState = lower_expr(iff.cond, s);
            if (!sc.ok) { return sc; }
            var s1: LowerState = sc.emit(ir.op_if(0));
            var s2: LowerState = lower_block(iff.then_body, s1);
            if (!s2.ok) { return s2; }
            if (iff.else_body.len() > 0) {
                var s3: LowerState = s2.emit(ir.op_else());
                var s4: LowerState = lower_block(iff.else_body, s3);
                if (!s4.ok) { return s4; }
                return s4.emit(ir.op_end());
            }
            return s2.emit(ir.op_end());
        },
        parser.StmtWhile(wh) => {
            // Canonical wasm loop shape:
            //   block              ; depth 1 = exit target
            //     loop             ; depth 0 = continue (header)
            //       <cond> not     ; !cond
            //       br_if 1        ; exit the block when !cond
            //       <body>
            //       br 0           ; back to the loop header
            //     end
            //   end
            if (infer_expr_width(wh.cond, s) == 64) { return s.fail(); }
            var w1: LowerState = s.emit(ir.op_block(0)).enter_loop();
            var w2: LowerState = w1.emit(ir.op_loop(0));
            var w3: LowerState = lower_expr(wh.cond, w2);
            if (!w3.ok) { return w3; }
            var w4: LowerState = w3.emit(ir.op_bin("not", 0, false));
            var w5: LowerState = w4.emit(ir.op_brif(1));
            var w6: LowerState = lower_block(wh.body, w5);
            if (!w6.ok) { return w6; }
            var w7: LowerState = w6.emit(ir.op_br(0));
            var w8: LowerState = w7.emit(ir.op_end());
            return w8.emit(ir.op_end()).exit_loop();
        },
        parser.StmtFor(fr) => {
            // break / continue inside a for-loop ARE supported (#2788): each
            // counted form below advances its index at the TOP of the loop
            // (after the header) and calls enter_loop/exit_loop, so a `continue`
            // br-to-header re-runs the advance instead of skipping it and a
            // `break` exits the loop's outer block — mirroring the while-loop
            // shape. (Earlier this whole arm bailed any break/continue body to
            // the AST path with a bottom-increment shape that `continue` would
            // skip.)
            // Range form `for i in LOW..HIGH` — the parser encodes the
            // half-open interval as a synthetic `__range(LOW, HIGH)` call.
            // lower_range_for emits the counted loop. Kept in its own function
            // so this already-large match arm doesn't grow further (oversized
            // functions miscompile on the native backend — cf. #2720).
            if (for_iter_is_range(fr.iter)) {
                return lower_range_for(fr.var_name, fr.iter, fr.body, s);
            }
            // `for x in <EXPR>` over a non-ident iterable (array literal or a
            // call returning an array): snapshot it into a hidden local, then
            // iterate that local (lower_foreach_snapshot). The bare-ident forms
            // — array foreach and the `for k, v in m` map foreach below — read
            // the slot directly, so they stay on their own paths; a comma var
            // (map form) is left to the map path / AST fallback.
            var for_iter_ident: boolean = false;
            var for_var_comma: boolean = false;
            match (fr.iter) { parser.ExprIdent(_) => { for_iter_ident = true; }, _ => {} }
            var fvci: i32 = 0;
            while (fvci < fr.var_name.len()) {
                if (fr.var_name[fvci] == 44) { for_var_comma = true; }
                fvci = fvci + 1;
            }
            // `for b in STR` over a string iterable: iterate the bytes via a
            // counted loop, not the array layout (#2822). Checked before the
            // snapshot / array-ident paths, which both assume an array.
            if (!for_var_comma && expr_is_str(fr.iter, s)) {
                return lower_string_foreach(fr.var_name, fr.iter, fr.body, s);
            }
            // `for k in m.keys()` / `for v in m.values()` over a map LOCAL —
            // single-var map iteration. op_map_keys / op_map_values return a
            // BORROW of the map's internal array (no inc), so the snapshot local
            // must NOT be array-marked (the exit-sweep must not dec it) and the
            // arr_len / arr_get are emitted explicitly — exactly as the 2-var
            // `for k, v in m` form below does. Checked before the generic
            // lower_foreach_snapshot, which would (wrongly) treat the result as an
            // OWNED array and free it. `mki_method` is "" unless fr.iter is a
            // keys()/values() call on a map local.
            if (!for_var_comma) {
                var mki_method: string = "";
                var mki_slot: i32 = 0 - 1;
                match (fr.iter) {
                    parser.ExprCall(mkic) => {
                        if (mkic.args.len() == 0) {
                            match (mkic.callee) {
                                parser.ExprFieldAccess(mkifa) => {
                                    if (mkifa.field == "keys" || mkifa.field == "values") {
                                        match (mkifa.obj) {
                                            parser.ExprIdent(mkid) => {
                                                if (s.map_type_of(s.slot_of(mkid.name)) != "") {
                                                    mki_method = mkifa.field;
                                                    mki_slot = s.slot_of(mkid.name);
                                                }
                                            },
                                            _ => {}
                                        }
                                    }
                                },
                                _ => {}
                            }
                        }
                    },
                    _ => {}
                }
                if (mki_slot >= 0) {
                    var mkimty: string = s.map_type_of(mki_slot);
                    // element type tag: keys -> key kind; values -> value type.
                    var mki_elem_str: boolean = false;
                    if (mki_method == "keys") { if (map_key_kind_of(mkimty) == 0) { mki_elem_str = true; } }
                    else { if (map_value_of(mkimty) == "string") { mki_elem_str = true; } }
                    // snapshot keys()/values() -> hidden borrow local (NOT marked).
                    var mkisn: string = "$formk" + util.i32_to_string(s.local_names.len());
                    var mkf: LowerState = s.add_local(mkisn);
                    var mkisslot: i32 = mkf.slot_of(mkisn);
                    mkf = mkf.emit(ir.op_load_local(mki_slot));
                    if (mki_method == "keys") { mkf = mkf.emit(ir.op_map_keys()); }
                    else { mkf = mkf.emit(ir.op_map_values()); }
                    mkf = mkf.emit(ir.op_store_local(mkisslot));
                    // hidden index
                    var mkidxn: string = "$formki" + util.i32_to_string(mkf.local_names.len());
                    mkf = mkf.add_local(mkidxn);
                    var mkidxslot: i32 = mkf.slot_of(mkidxn);
                    mkf = mkf.emit(ir.op_const_i32(0 - 1));
                    mkf = mkf.emit(ir.op_store_local(mkidxslot));
                    // the single binding (string element marks the slot str)
                    mkf = mkf.add_local(fr.var_name);
                    var mkivslot: i32 = mkf.slot_of(fr.var_name);
                    if (mki_elem_str) { mkf = mkf.mark_str(mkivslot, true); }
                    // counted loop, advance-at-top so `continue` re-advances.
                    mkf = mkf.emit(ir.op_block(0)).enter_loop();
                    mkf = mkf.emit(ir.op_loop(0));
                    mkf = mkf.emit(ir.op_load_local(mkidxslot));
                    mkf = mkf.emit(ir.op_const_i32(1));
                    mkf = mkf.emit(ir.op_bin("add", 0, false));
                    mkf = mkf.emit(ir.op_store_local(mkidxslot));
                    mkf = mkf.emit(ir.op_load_local(mkidxslot));
                    mkf = mkf.emit(ir.op_load_local(mkisslot));
                    mkf = mkf.emit(ir.op_arr_len());
                    mkf = mkf.emit(ir.op_bin("lt_s", 0, false));
                    mkf = mkf.emit(ir.op_bin("not", 0, false));
                    mkf = mkf.emit(ir.op_brif(1));
                    mkf = mkf.emit(ir.op_load_local(mkisslot));
                    mkf = mkf.emit(ir.op_load_local(mkidxslot));
                    mkf = mkf.emit(ir.op_arr_get(32));
                    mkf = mkf.emit(ir.op_store_local(mkivslot));
                    mkf = lower_block(fr.body, mkf);
                    if (!mkf.ok) { return mkf; }
                    mkf = mkf.emit(ir.op_br(0));
                    mkf = mkf.emit(ir.op_end());
                    return mkf.emit(ir.op_end()).exit_loop();
                }
            }
            // `for c in r.cells` over a leak-safe array-typed STRUCT FIELD
            // (string[] / struct[] / enum[] — element types that aren't
            // reclaimed). The field access is snapshotted into a hidden BORROW
            // local (NOT array-marked, so the exit-sweep never decs it: the
            // field buffer's lifetime stays with the owning struct, which leaks
            // these element types — emit_struct_field_drops only frees the
            // reclaimable scalar fields — so the borrow can't double-free / UAF).
            // Then a counted loop with explicit arr_len/arr_get + element typing
            // (mirroring the map keys()/values() borrow path). The reclaimed
            // scalar fields (i32[]/boolean[]/f64[]/i64[]) are deliberately NOT
            // handled here — aliasing them needs the reclamation analysis to
            // borrow-track the field, left to the Perceus self-host port (#3003).
            if (!for_var_comma) {
                var fld_elem_kind: i32 = 0;   // 0 none, 1 string[], 2 struct[]/enum[], 3 Option/Result[]
                var fld_elem_ty: string = "";
                match (fr.iter) {
                    parser.ExprFieldAccess(ffa) => {
                        var foty: string = expr_struct_type(ffa.obj, s);
                        if (foty != "") {
                            var fft: string = decl_field_type(s.structs, foty, ffa.field);
                            if (fft == "string[]") { fld_elem_kind = 1; }
                            else if (is_struct_array_field_type(s.structs, fft) || is_enum_array_field_type(s.structs, fft)) {
                                fld_elem_kind = 2;
                                fld_elem_ty = fft[0 : fft.len() - 2];
                            }
                            // An Option/Result-array field (`xs: Option[i32][]`):
                            // the element is a leak-only opt box — carry its
                            // Option/Result type so `match (o)` in the body
                            // recovers the payload (#3054, the field-foreach analog
                            // of the Option-array local case).
                            else if (fft.len() >= 5 && fft[fft.len() - 2 : fft.len()] == "[]") {
                                var fel: string = fft[0 : fft.len() - 2];
                                if (fel.len() >= 8 && (fel[0:7] == "Option[" || fel[0:7] == "Result[")) {
                                    fld_elem_kind = 3;
                                    fld_elem_ty = fel;
                                }
                            }
                        }
                    },
                    _ => {}
                }
                if (fld_elem_kind != 0) {
                    // snapshot field access -> hidden borrow local (NOT array-marked)
                    var fldsn: string = "$forfld" + util.i32_to_string(s.local_names.len());
                    var lf: LowerState = s.add_local(fldsn);
                    var fldslot: i32 = lf.slot_of(fldsn);
                    lf = lower_expr(fr.iter, lf);
                    if (!lf.ok) { return lf; }
                    lf = lf.emit(ir.op_store_local(fldslot));
                    // hidden index (advance-at-top, #2788)
                    var fldidxn: string = "$forfldi" + util.i32_to_string(lf.local_names.len());
                    lf = lf.add_local(fldidxn);
                    var fldidxslot: i32 = lf.slot_of(fldidxn);
                    lf = lf.emit(ir.op_const_i32(0 - 1));
                    lf = lf.emit(ir.op_store_local(fldidxslot));
                    // element binding: string element marks the slot str; a
                    // struct/enum element carries the element type so `c.field`
                    // / `c.method()` / `match (c)` in the body resolve.
                    lf = lf.add_local(fr.var_name);
                    var fldvslot: i32 = lf.slot_of(fr.var_name);
                    if (fld_elem_kind == 1) { lf = lf.mark_str(fldvslot, true); }
                    else if (fld_elem_kind == 3) { lf = lf.mark_opt_type(fldvslot, fld_elem_ty); }
                    else { lf = lf.mark_struct_type(fldvslot, fld_elem_ty); }
                    // counted loop using explicit arr_len/arr_get on the borrow.
                    lf = lf.emit(ir.op_block(0)).enter_loop();
                    lf = lf.emit(ir.op_loop(0));
                    lf = lf.emit(ir.op_load_local(fldidxslot));
                    lf = lf.emit(ir.op_const_i32(1));
                    lf = lf.emit(ir.op_bin("add", 0, false));
                    lf = lf.emit(ir.op_store_local(fldidxslot));
                    lf = lf.emit(ir.op_load_local(fldidxslot));
                    lf = lf.emit(ir.op_load_local(fldslot));
                    lf = lf.emit(ir.op_arr_len());
                    lf = lf.emit(ir.op_bin("lt_s", 0, false));
                    lf = lf.emit(ir.op_bin("not", 0, false));
                    lf = lf.emit(ir.op_brif(1));
                    lf = lf.emit(ir.op_load_local(fldslot));
                    lf = lf.emit(ir.op_load_local(fldidxslot));
                    lf = lf.emit(ir.op_arr_get(32));
                    lf = lf.emit(ir.op_store_local(fldvslot));
                    lf = lower_block(fr.body, lf);
                    if (!lf.ok) { return lf; }
                    lf = lf.emit(ir.op_br(0));
                    lf = lf.emit(ir.op_end());
                    return lf.emit(ir.op_end()).exit_loop();
                }
            }
            if (!for_iter_ident && !for_var_comma) {
                return lower_foreach_snapshot(fr.var_name, fr.iter, fr.body, s);
            }
            // `for k, v in m` over a map LOCAL → snapshot keys()/values() into
            // two hidden locals, then a counted loop binding k = keys[i],
            // v = values[i]. The two snapshots share iteration order on every
            // backend (the live parallel arrays on x86-64/arm64; the
            // probe-order snapshot on wasm, where map_keys/map_values walk the
            // same slots), so keys[i] pairs with values[i]. The snapshot
            // locals are deliberately NOT array-marked: on x86-64/arm64 they
            // alias the map's internal arrays (a borrow, no inc), so the
            // exit-sweep must not dec them; arr_len/arr_get are emitted
            // explicitly so they don't need the mark.
            var mslot: i32 = 0 - 1;
            match (fr.iter) {
                parser.ExprIdent(mid0) => { mslot = s.slot_of(mid0.name); },
                _ => {}
            }
            var kvcomma: i32 = 0 - 1;
            var kvci: i32 = 0;
            while (kvci < fr.var_name.len()) {
                if (fr.var_name[kvci] == 44 && kvcomma < 0) { kvcomma = kvci; }
                kvci = kvci + 1;
            }
            if (mslot >= 0 && s.map_type_of(mslot) != "" && kvcomma >= 0) {
                var mty: string = s.map_type_of(mslot);
                var kkind: i32 = map_key_kind_of(mty);   // 1 = i32 keys, 0 = string
                var vty: string = map_value_of(mty);
                var kname: string = trim_spaces(fr.var_name[0 : kvcomma]);
                var vname: string = trim_spaces(fr.var_name[kvcomma + 1 : fr.var_name.len()]);
                // keys snapshot -> hidden local
                var ksn: string = "$forks" + util.i32_to_string(s.local_names.len());
                var fm: LowerState = s.add_local(ksn);
                var ksslot: i32 = fm.slot_of(ksn);
                fm = fm.emit(ir.op_load_local(mslot));
                fm = fm.emit(ir.op_map_keys());
                fm = fm.emit(ir.op_store_local(ksslot));
                // values snapshot -> hidden local
                var vsn: string = "$forvs" + util.i32_to_string(fm.local_names.len());
                fm = fm.add_local(vsn);
                var vsslot: i32 = fm.slot_of(vsn);
                fm = fm.emit(ir.op_load_local(mslot));
                fm = fm.emit(ir.op_map_values());
                fm = fm.emit(ir.op_store_local(vsslot));
                // hidden index
                var idxn: string = "$foridx" + util.i32_to_string(fm.local_names.len());
                fm = fm.add_local(idxn);
                var idxslot2: i32 = fm.slot_of(idxn);
                fm = fm.emit(ir.op_const_i32(0 - 1));   // idx = -1 (advance-at-top, #2788)
                fm = fm.emit(ir.op_store_local(idxslot2));
                // k, v bindings (carry string-ness for downstream dispatch)
                fm = fm.add_local(kname);
                var kslot: i32 = fm.slot_of(kname);
                if (kkind == 0) { fm = fm.mark_str(kslot, true); }
                fm = fm.add_local(vname);
                var vslot: i32 = fm.slot_of(vname);
                if (vty == "string") { fm = fm.mark_str(vslot, true); }
                // loop: idx++ (top) ; idx < keys.len() ; bind k/v ; body ; back-edge.
                // The increment is at the top so a `continue` (br-to-header)
                // re-runs it instead of skipping it (#2788).
                fm = fm.emit(ir.op_block(0)).enter_loop();
                fm = fm.emit(ir.op_loop(0));
                fm = fm.emit(ir.op_load_local(idxslot2));
                fm = fm.emit(ir.op_const_i32(1));
                fm = fm.emit(ir.op_bin("add", 0, false));
                fm = fm.emit(ir.op_store_local(idxslot2));
                fm = fm.emit(ir.op_load_local(idxslot2));
                fm = fm.emit(ir.op_load_local(ksslot));
                fm = fm.emit(ir.op_arr_len());
                fm = fm.emit(ir.op_bin("lt_s", 0, false));
                fm = fm.emit(ir.op_bin("not", 0, false));
                fm = fm.emit(ir.op_brif(1));
                fm = fm.emit(ir.op_load_local(ksslot));
                fm = fm.emit(ir.op_load_local(idxslot2));
                fm = fm.emit(ir.op_arr_get(32));
                fm = fm.emit(ir.op_store_local(kslot));
                fm = fm.emit(ir.op_load_local(vsslot));
                fm = fm.emit(ir.op_load_local(idxslot2));
                fm = fm.emit(ir.op_arr_get(32));
                fm = fm.emit(ir.op_store_local(vslot));
                fm = lower_block(fr.body, fm);
                if (!fm.ok) { return fm; }
                fm = fm.emit(ir.op_br(0));
                fm = fm.emit(ir.op_end());
                return fm.emit(ir.op_end()).exit_loop();
            }
            // `for x in <arr>` over an array LOCAL/PARAM (i32[] or string[]) →
            // a counted loop using existing ops. Other iter forms (calls,
            // literals, maps) bail to AST; bodies with break/continue bail
            // anyway (those statements aren't in the IR path). The array is an
            // ident, so re-loading it each iteration is side-effect-free.
            var aslot: i32 = 0 - 1;
            match (fr.iter) {
                parser.ExprIdent(iid) => { aslot = s.slot_of(iid.name); },
                _ => {}
            }
            if (aslot < 0) { return s.fail(); }
            if (!s.is_arr_slot(aslot)) { return s.fail(); }
            var elem_is_str: boolean = s.is_strarr_slot(aslot);
            // `for x in <f64[]>`: the element binding x is an f64, loaded with an
            // 8-byte arr_get (width 64 → f64.load on wasm). Marked f64 so the
            // loop body's uses of x pick the float ops and x declares as a wasm
            // (local f64). i32 / string[] elements use the 4-byte path.
            // `for x in <i64[]>`: the element binding x is an i64 (8-byte), read
            // with arr_get_i64 (i64.load) and marked i64 so the loop body's uses
            // of x route through lower_i64 and x declares as a wasm (local i64).
            var elem_is_i64: boolean = s.is_i64arr_slot(aslot);
            var elem_is_f64: boolean = s.is_f64arr_slot(aslot);
            var elem_w: i32 = 32;
            if (elem_is_f64) { elem_w = 64; }
            // Fresh hidden index local + the user-visible element binding.
            var idxname: string = "$foridx" + util.i32_to_string(s.local_names.len());
            var ff: LowerState = s.add_local(idxname);
            var idxslot: i32 = ff.slot_of(idxname);
            ff = ff.emit(ir.op_const_i32(0 - 1));   // idx = -1 (advance-at-top, #2788)
            ff = ff.emit(ir.op_store_local(idxslot));
            ff = ff.add_local(fr.var_name);
            var xslot: i32 = ff.slot_of(fr.var_name);
            if (elem_is_str) { ff = ff.mark_str(xslot, true); }
            if (elem_is_f64) { ff = ff.mark_f64(xslot, true); }
            if (elem_is_i64) { ff = ff.mark_i64(xslot, true); }
            // `for f in <closure[]>`: each element is a closure box, so bind the
            // loop var as a closure local (its call unpacks the env box rather
            // than calling the raw pointer as a table index).
            if (s.is_closurearr_slot(aslot)) { ff = ff.mark_arr(xslot, true); ff = ff.mark_closure_local(fr.var_name); }
            // `for row in <T[][]>`: each element is itself an array, so bind the
            // loop var as an array source — lets `for x in row` / `row` flow as an
            // array. The element loads via the default 4-byte/slot arr_get (the
            // inner array's data pointer), same as a struct/string element.
            if (s.is_arrarr_slot(aslot)) { ff = ff.mark_arr(xslot, true); }
            // `for x in <struct[]>`: x is a struct (pointer) element — carry the
            // element struct type (from the array slot's local_struct_type) so
            // `x.field` / `x.method()` in the body resolve. The element loads
            // via the default 4-byte/slot arr_get like a string element.
            var elem_struct: string = s.struct_type_of_slot(aslot);
            if (elem_struct != "") { ff = ff.mark_struct_type(xslot, elem_struct); }
            // `for o in <Option[T][]>` / `<Result[…][]>`: each element is an
            // Option/Result value — carry the element type (from the array slot's
            // opt_type, stripping the array `[]`) so a `match (o)` in the body
            // recovers the payload. The foreach binds the element here directly
            // (not via StmtVar), so it needs its own opt-type marking.
            var elem_opt: string = s.opt_type_of_slot(aslot);
            if (elem_opt.len() >= 2 && elem_opt[elem_opt.len() - 2 : elem_opt.len()] == "[]") {
                var eopt: string = elem_opt[0 : elem_opt.len() - 2];
                if (eopt.len() >= 8 && (eopt[0:7] == "Option[" || eopt[0:7] == "Result[")) { ff = ff.mark_opt_type(xslot, eopt); }
            }
            ff = ff.emit(ir.op_block(0)).enter_loop();  // depth 1 = break/exit target
            ff = ff.emit(ir.op_loop(0));                // depth 0 = continue/header
            // advance: idx = idx + 1 at the top, so a `continue` (br-to-header)
            // re-runs it instead of skipping it (#2788).
            ff = ff.emit(ir.op_load_local(idxslot));
            ff = ff.emit(ir.op_const_i32(1));
            ff = ff.emit(ir.op_bin("add", 0, false));
            ff = ff.emit(ir.op_store_local(idxslot));
            // cond: idx < arr.len(); exit when NOT.
            ff = ff.emit(ir.op_load_local(idxslot));
            ff = ff.emit(ir.op_load_local(aslot));
            ff = ff.emit(ir.op_arr_len());
            ff = ff.emit(ir.op_bin("lt_s", 0, false));
            ff = ff.emit(ir.op_bin("not", 0, false));
            ff = ff.emit(ir.op_brif(1));
            // x = arr[idx]  (8-byte i64 / f64 element, or 4-byte i32 / string[])
            ff = ff.emit(ir.op_load_local(aslot));
            ff = ff.emit(ir.op_load_local(idxslot));
            if (elem_is_i64) { ff = ff.emit(ir.op_arr_get_i64()); }
            else { ff = ff.emit(ir.op_arr_get(elem_w)); }
            ff = ff.emit(ir.op_store_local(xslot));
            ff = lower_block(fr.body, ff);
            if (!ff.ok) { return ff; }
            ff = ff.emit(ir.op_br(0));   // back-edge to header (re-advances)
            ff = ff.emit(ir.op_end());
            return ff.emit(ir.op_end()).exit_loop();
        },
        parser.StmtExpr(es) => {
            // Index-assignment `arr[i] = v` desugars to
            // __set_index(arr, idx, val) → lower base, index, value, then the
            // high-level `arr_set` op (the backend stores at its layout's
            // element address), leaving nothing on the stack.
            match (es.value) {
                parser.ExprCall(c) => {
                    match (c.callee) {
                        parser.ExprIdent(cid) => {
                            if (cid.name == "__set_index") {
                                if (c.args.len() != 3) { return s.fail(); }
                                // `a[i] = v` on an i64[]: base + index are i32, but
                                // the value is an 8-byte i64 — lower it via lower_i64
                                // and store with arr_set_i64 (i64.store on wasm).
                                if (arr_index_is_i64(c.args[0], s)) {
                                    var is64: LowerState = lower_expr(c.args[0], s);
                                    if (!is64.ok) { return is64; }
                                    is64 = lower_expr(c.args[1], is64);
                                    if (!is64.ok) { return is64; }
                                    is64 = lower_i64(c.args[2], is64);
                                    if (!is64.ok) { return is64; }
                                    return is64.emit(ir.op_arr_set_i64());
                                }
                                var ss: LowerState = lower_expr(c.args[0], s);
                                if (!ss.ok) { return ss; }
                                ss = lower_expr(c.args[1], ss);
                                if (!ss.ok) { return ss; }
                                ss = lower_expr(c.args[2], ss);
                                if (!ss.ok) { return ss; }
                                // Element width from the array slot: `a[i] = v`
                                // on an f64[] stores an 8-byte f64 (arr_set width
                                // 64 → f64.store on wasm); i32[] the 4-byte path.
                                var sw: i32 = 32;
                                if (arr_index_is_f64(c.args[0], s)) { sw = 64; }
                                return ss.emit(ir.op_arr_set(sw));
                            }
                            // Field mutation `p.x = v` desugars to
                            // __set_field(obj, "x", v). Resolve x's index in obj's
                            // tracked scalar-struct type, lower obj + val, struct_set.
                            if (cid.name == "__set_field") {
                                if (c.args.len() != 3) { return s.fail(); }
                                var fname: string = "";
                                match (c.args[1]) {
                                    parser.ExprString(fs) => { fname = fs.value; },
                                    _ => { return s.fail(); }
                                }
                                var fsty: string = expr_struct_type(c.args[0], s);
                                if (fsty == "") { return s.fail(); }
                                if (!decl_is_leaksafe(s.structs, fsty)) { return s.fail(); }
                                // Mutating an array field (scalar or struct-array)
                                // would orphan the old array (leak) and need a retain
                                // on the new one — and could alias it — so bail to AST.
                                var fmft: string = decl_field_type(s.structs, fsty, fname);
                                if (is_leaksafe_array_field(fmft) || is_struct_array_field_type(s.structs, fmft)) { return s.fail(); }
                                var fidx: i32 = s.field_index_in(fsty, fname);
                                if (fidx < 0) { return s.fail(); }
                                var sf: LowerState = lower_expr(c.args[0], s);
                                if (!sf.ok) { return sf; }
                                // An i64 field stores an 8-byte i64: lower the
                                // value via lower_i64 and store with struct_set_i64
                                // (i64.store on wasm). f64 / i32 fields keep the
                                // existing struct_set(width) path.
                                if (struct_field_is_i64(s.structs, fsty, fidx)) {
                                    sf = lower_i64(c.args[2], sf);
                                    if (!sf.ok) { return sf; }
                                    return sf.emit(ir.op_struct_set_i64(fidx));
                                }
                                sf = lower_expr(c.args[2], sf);
                                if (!sf.ok) { return sf; }
                                return sf.emit(ir.op_struct_set(fidx, struct_field_width(s.structs, fsty, fidx)));
                            }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            // General expression statement: lower the value, drop the result.
            var se: LowerState = lower_expr(es.value, s);
            if (!se.ok) { return se; }
            return se.emit(ir.op_drop());
        },
        parser.StmtMatch(m) => {
            // Enum `match`: lower the scrutinee into a fresh slot, then a chain of
            // arms inside an outer block. Each variant arm is its own block: it
            // tests the scrutinee with variant_is and `br`s out of the arm block on
            // mismatch (falling to the next arm); on a match it binds the single
            // scalar payload (struct_get 0), runs the body, and `br`s out of the
            // OUTER block (exiting the match). A wildcard arm runs unconditionally
            // and exits. Only scalar-payload enum-variant arms + a trailing
            // wildcard are lowered; guards, multi-bindings, Option/Result/bool
            // patterns, and non-scalar payloads bail to the AST emitter.
            var ms: LowerState = lower_expr(m.scrutinee, s);
            if (!ms.ok) { return ms; }
            var scrut: string = "$mscrut" + util.i32_to_string(ms.local_names.len());
            ms = ms.add_local(scrut);
            var scrut_slot: i32 = ms.slot_of(scrut);
            ms = ms.emit(ir.op_store_local(scrut_slot));
            ms = ms.emit(ir.op_block(0));     // outer block: arm bodies br out of it
            var mi: i32 = 0;
            while (mi < m.arms.len()) {
                var arm: parser.MatchArm = m.arms[mi];
                match (arm.pattern) {
                    parser.PatVariant(pv) => {
                        if (is_builtin_pattern(pv.type_name)) {
                            // A `true`/`false` boolean pattern: the scrutinee is
                            // already a 0/1 value in scrut_slot (no tag to extract),
                            // so the arm tests it directly — skip on mismatch, run the
                            // body, exit the match. Mirrors the Option-tag arm shape.
                            if (pv.type_name == "true" || pv.type_name == "false") {
                                var bwant: i32 = 0;
                                if (pv.type_name == "true") { bwant = 1; }
                                ms = ms.emit(ir.op_block(0));   // arm block: br 0 = skip arm
                                ms = ms.emit(ir.op_load_local(scrut_slot));
                                ms = ms.emit(ir.op_const_i32(bwant));
                                ms = ms.emit(ir.op_bin("ne", 0, false));   // 1 if scrut != want
                                ms = ms.emit(ir.op_brif(0));               // -> skip arm on mismatch
                                if (arm.has_guard) {
                                    ms = lower_expr(arm.guard, ms);
                                    if (!ms.ok) { return ms; }
                                    ms = ms.emit(ir.op_bin("not", 0, false));
                                    ms = ms.emit(ir.op_brif(0));
                                }
                                ms = lower_block(arm.body, ms);
                                if (!ms.ok) { return ms; }
                                ms = ms.emit(ir.op_br(1));      // matched -> exit the match
                                ms = ms.emit(ir.op_end());      // end arm block
                                mi = mi + 1;
                                continue;
                            }
                            var hb: boolean = pv.binding.len() > 0 && pv.binding != "_";
                            // A payload binding needs the payload's type. Only a
                            // direct-call scrutinee `f()` whose ret_type is recorded
                            // (opt_ret_fns) lets us recover it: T for Some/Ok, E for
                            // Err. Scalar (i32/boolean) binds plain; string via
                            // mark_str; anything else (composite/unknown/non-call
                            // scrutinee) bails to AST.
                            var ptag: string = "";
                            if (hb) {
                                // Recover the scrutinee's Option/Result type: a
                                // direct-call `f()` via opt_ret_fns, or a local/param
                                // var via its tracked local_opt_type.
                                var srt: string = "";
                                match (m.scrutinee) {
                                    parser.ExprCall(scl) => {
                                        match (scl.callee) {
                                            parser.ExprIdent(scid) => {
                                                srt = ms.opt_ret_type(scid.name);
                                                // `match (Some(7))` — a direct Option
                                                // construction recovers the payload from
                                                // the scrutinee (no local needed).
                                                if (srt == "") { srt = some_opt_type(m.scrutinee, ms); }
                                            },
                                            parser.ExprFieldAccess(scfa) => {
                                                // `m.get(k)` evaluates to Option[V] (V = the map's value type).
                                                if (scfa.field == "get") {
                                                    match (scfa.obj) {
                                                        parser.ExprIdent(mapid) => {
                                                            var vt: string = map_value_of(ms.map_type_of(ms.slot_of(mapid.name)));
                                                            if (vt != "") { srt = "Option[" + vt + "]"; }
                                                        },
                                                        _ => {}
                                                    }
                                                }
                                                // `x.method()` where x's method returns Option/Result —
                                                // key by "<Type>.<method>".
                                                if (srt == "") {
                                                    var mrty: string = expr_struct_type(scfa.obj, ms);
                                                    if (mrty != "") { srt = ms.opt_ret_type(mrty + "." + scfa.field); }
                                                    // An Option/Result-RECEIVER method
                                                    // (`match (r.map())`) — key
                                                    // "Option.<m>" / "Result.<m>" (#3049).
                                                    else {
                                                        var mrb: string = opt_recv_base_type(scfa.obj, ms);
                                                        if (mrb != "") { srt = ms.opt_ret_type(mrb + "." + scfa.field); }
                                                        // An enum-receiver method returning
                                                        // Option/Result on a fresh variant
                                                        // (`match (V(7).get())`) (#3076).
                                                        else {
                                                            var men: string = expr_enum_type(scfa.obj, ms);
                                                            if (men != "") { srt = ms.opt_ret_type(men + "." + scfa.field); }
                                                        }
                                                    }
                                                }
                                            },
                                            // An if-/match-EXPRESSION scrutinee
                                            // (`match (if (c) { Some(7) } else { None })`)
                                            // — a 0-arg IIFE. Recover the Option type from
                                            // the leaf branch's Some(...) via iife_leaf_value
                                            // (unwrapping any nesting).
                                            parser.ExprLambda(_) => { srt = some_opt_type(iife_leaf_value(m.scrutinee), ms); },
                                            _ => {}
                                        }
                                    },
                                    parser.ExprIdent(sid) => { srt = ms.opt_type_of_slot(ms.slot_of(sid.name)); },
                                    // `match (e as? T)` — the downcast scrutinee
                                    // (docs/DYN-TRAITS.md §9) yields Option[T]; the
                                    // parser tags it `as?_<T>`, so the Some-arm
                                    // payload binds as a T (struct) value.
                                    parser.ExprUnary(sun) => {
                                        if (sun.op.len() > 4 && sun.op[0:4] == "as?_") { srt = "Option[" + sun.op[4 : sun.op.len()] + "]"; }
                                    },
                                    // `match (p.opt)` where `opt` is an Option/Result
                                    // struct field — recover its type from the field.
                                    // `match (t.N)` where the tuple element is an
                                    // Option — recover from the element's tracked tag
                                    // (a numeric field; #3018).
                                    parser.ExprFieldAccess(sfa) => {
                                        if (util.is_all_digits(sfa.field)) {
                                            var ttg: string = expr_tuple_elem_tag(sfa.obj, util.digits_to_i32(sfa.field), ms);
                                            if (ttg.len() >= 8 && (ttg[0:7] == "Option[" || ttg[0:7] == "Result[")) { srt = ttg; }
                                        } else {
                                            var foty: string = expr_struct_type(sfa.obj, ms);
                                            if (foty != "") {
                                                var fft: string = decl_field_type(ms.structs, foty, sfa.field);
                                                if (fft.len() >= 8 && (fft[0:7] == "Option[" || fft[0:7] == "Result[")) { srt = fft; }
                                            }
                                        }
                                    },
                                    // `match (a[i])` where `a` is an Option/Result
                                    // ARRAY — recover the element type from the array
                                    // slot's opt_type (the annotated `Option[T][]` /
                                    // `Result[...][]`), stripping the trailing `[]`.
                                    parser.ExprIndex(six) => {
                                        match (six.array) {
                                            parser.ExprIdent(arrid) => {
                                                var aot: string = ms.opt_type_of_slot(ms.slot_of(arrid.name));
                                                if (aot.len() >= 2 && aot[aot.len() - 2 : aot.len()] == "[]") {
                                                    var elt: string = aot[0 : aot.len() - 2];
                                                    if (elt.len() >= 8 && (elt[0:7] == "Option[" || elt[0:7] == "Result[")) { srt = elt; }
                                                }
                                            },
                                            // `match (b.o[i])` where `o` is an
                                            // Option/Result-array struct field —
                                            // recover the element from the field's
                                            // declared `Option[T][]` / `Result[…][]`.
                                            parser.ExprFieldAccess(sfa2) => {
                                                var foty2: string = expr_struct_type(sfa2.obj, ms);
                                                if (foty2 != "") {
                                                    var fat: string = decl_field_type(ms.structs, foty2, sfa2.field);
                                                    if (fat.len() >= 2 && fat[fat.len() - 2 : fat.len()] == "[]") {
                                                        var felt: string = fat[0 : fat.len() - 2];
                                                        if (felt.len() >= 8 && (felt[0:7] == "Option[" || felt[0:7] == "Result[")) { srt = felt; }
                                                    }
                                                }
                                            },
                                            _ => {}
                                        }
                                    },
                                    _ => {}
                                }
                                if (srt == "") { return s.fail(); }
                                ptag = opt_payload_type(srt, pv.type_name);
                                // A leaf-safe struct payload (Some(p) / Ok(p) /
                                // Err(p) where p is a scalar-field struct) is stored
                                // by pointer at offset 8 — identical to the string
                                // case — so it reads via op_opt_payload and binds as
                                // a struct slot (its type tagged below for `p.field`).
                                var ptag_is_struct: boolean = decl_is_struct(ms.structs, ptag) && decl_is_leaksafe(ms.structs, ptag);
                                // An ENUM payload (`Some(c)` where c: Color, or an
                                // Ok/Err enum) is likewise stored by pointer at
                                // offset 8 — read via op_opt_payload and bound with
                                // its enum name so `match (c)` / `c.method()` resolve.
                                var ptag_is_enum: boolean = is_enum_like_name(ptag, ms.structs);
                                // A NESTED Option/Result payload (`Some(inner)` where
                                // inner: Option[T]) is stored by pointer at offset 8
                                // too — read via op_opt_payload and bound with its
                                // Option/Result type so the inner `match (inner)`
                                // recovers the payload via opt_type_of_slot.
                                var ptag_is_opt: boolean = ptag.len() >= 8 && (ptag[0:7] == "Option[" || ptag[0:7] == "Result[");
                                if (ptag != "i32" && ptag != "boolean" && ptag != "string" && ptag != "i64" && ptag != "f64" && !ptag_is_struct && !ptag_is_enum && !ptag_is_opt) { return s.fail(); }
                            }
                            var want: i32 = 0;
                            if (pv.type_name == "None" || pv.type_name == "Err") { want = 1; }
                            ms = ms.emit(ir.op_block(0));   // arm block: br 0 = skip arm
                            ms = ms.emit(ir.op_load_local(scrut_slot));
                            ms = ms.emit(ir.op_opt_tag());
                            ms = ms.emit(ir.op_const_i32(want));
                            ms = ms.emit(ir.op_bin("ne", 0, false));   // 1 if tag != want
                            ms = ms.emit(ir.op_brif(0));               // -> skip arm on mismatch
                            if (hb) {
                                // Bind the payload (offset 8) BEFORE the guard, so the
                                // guard may reference it (`Some(x) when x > 0`).
                                ms = ms.add_local(pv.binding);
                                var pbslot: i32 = ms.slot_of(pv.binding);
                                ms = ms.emit(ir.op_load_local(scrut_slot));
                                // Read the payload at its width (an i64/f64 payload
                                // uses the matching 8-byte load) and type the bound
                                // name so later uses route correctly (i64 ->
                                // lower_i64; f64 -> the float ops).
                                if (ptag == "i64") { ms = ms.emit(ir.op_opt_payload_w(64, true)); }
                                else if (ptag == "f64") { ms = ms.emit(ir.op_opt_payload_w(64, false)); }
                                else { ms = ms.emit(ir.op_opt_payload()); }
                                ms = ms.emit(ir.op_store_local(pbslot));
                                if (ptag == "string") { ms = ms.mark_str(pbslot, true); }
                                else if (ptag == "i64") { ms = ms.mark_i64(pbslot, true); }
                                else if (ptag == "f64") { ms = ms.mark_f64(pbslot, true); }
                                // A struct payload: tag the bound slot's struct type so
                                // `p.field` resolves. It is BORROWED from the enum box
                                // (not a fresh `var p = P{...}`), so it is never in
                                // reclaimable_names — correctly left to leak, no double-free.
                                else if ((decl_is_struct(ms.structs, ptag) && decl_is_leaksafe(ms.structs, ptag)) || is_enum_like_name(ptag, ms.structs)) { ms = ms.mark_struct_type(pbslot, ptag); }
                                // A nested Option/Result payload: record the bound
                                // slot's Option/Result type so the inner match (or a
                                // `?`) recovers its payload.
                                else if (ptag.len() >= 8 && (ptag[0:7] == "Option[" || ptag[0:7] == "Result[")) { ms = ms.mark_opt_type(pbslot, ptag); }
                            }
                            if (arm.has_guard) {
                                ms = lower_expr(arm.guard, ms);
                                if (!ms.ok) { return ms; }
                                ms = ms.emit(ir.op_bin("not", 0, false));
                                ms = ms.emit(ir.op_brif(0));
                            }
                            ms = lower_block(arm.body, ms);
                            if (!ms.ok) { return ms; }
                            ms = ms.emit(ir.op_br(1));      // matched -> exit the match
                            ms = ms.emit(ir.op_end());      // end arm block
                            mi = mi + 1;
                            continue;
                        }
                        // Qualified variant pattern `Enum.Variant` / `mod.Variant`
                        // -> the bare variant name (the parser desugars an enum's
                        // variants to structs named by the bare variant). The
                        // builtin/Option patterns handled above have no '.', so
                        // this is identity for them; a stripped name that isn't a
                        // local variant struct still bails just below (cross-module
                        // enums stay on the AST path).
                        var vname: string = pv.type_name;
                        var vld: i32 = 0;
                        while (vld < pv.type_name.len()) {
                            if (pv.type_name[vld] == 46) { vname = pv.type_name[vld + 1 : pv.type_name.len()]; }
                            vld = vld + 1;
                        }
                        if (!decl_is_struct(ms.structs, vname)) { return s.fail(); }
                        if (!decl_is_leaksafe(ms.structs, vname)) { return s.fail(); }
                        var has_bind: boolean = pv.binding.len() > 0 && pv.binding != "_";
                        if (has_bind && decl_field_count(ms.structs, vname) < 1) { return s.fail(); }
                        ms = ms.emit(ir.op_block(0));   // arm block: br 0 = skip arm
                        ms = ms.emit(ir.op_load_local(scrut_slot));
                        ms = ms.emit(ir.op_variant_is(vname));
                        ms = ms.emit(ir.op_bin("not", 0, false));   // 1 if NOT this variant
                        ms = ms.emit(ir.op_brif(0));                // -> skip arm on mismatch
                        // Bind each payload field. Field 0 -> pv.binding, field k>=1
                        // -> pv.extra_bindings[k-1] (a multi-payload variant
                        // `Pt(x, y)` desugars to struct fields __ev, __ev1, …). Each
                        // reads via struct_get at its field index — offset
                        // (idx+1)*8, past the shape ptr — at the field's width, and
                        // types the bound name from the variant struct's field type
                        // so downstream dispatch routes correctly. A `_` / empty
                        // binding skips that field.
                        var nbinds: i32 = 1 + pv.extra_bindings.len();
                        var bidx: i32 = 0;
                        while (bidx < nbinds) {
                            var bname: string = pv.binding;
                            if (bidx > 0) { bname = pv.extra_bindings[bidx - 1]; }
                            if (bname.len() > 0 && bname != "_") {
                                var fname: string = "__ev";
                                if (bidx > 0) { fname = "__ev" + util.i32_to_string(bidx); }
                                var ev_ty: string = decl_field_type(ms.structs, vname, fname);
                                ms = ms.add_local(bname);
                                var bslot: i32 = ms.slot_of(bname);
                                // Read the payload at its width: an i64 payload uses
                                // struct_get_i64 (i64.load), an f64 one struct_get
                                // width 64 (f64.load), else the i32 read.
                                ms = ms.emit(ir.op_load_local(scrut_slot));
                                if (ev_ty == "i64") { ms = ms.emit(ir.op_struct_get_i64(bidx)); }
                                else if (ev_ty == "f64") { ms = ms.emit(ir.op_struct_get(bidx, 64)); }
                                else { ms = ms.emit(ir.op_struct_get(bidx, 0)); }
                                ms = ms.emit(ir.op_store_local(bslot));
                                // Type the bound payload for downstream dispatch: a
                                // string payload (`Word(string)`) as a string; a
                                // struct payload (`Binary(BinExpr)`) with its struct
                                // type so `p.field` resolves (the compiler's own AST
                                // shape — enums of structs); an ENUM payload
                                // (`Node(Tree, Tree)`) with its enum name so a method
                                // call on the bound value (`l.sum()`) dispatches to
                                // `<Enum>.<method>` (enum-receiver, mirroring the
                                // `var a: Enum` marking); an i64 / f64 payload so
                                // later uses route through lower_i64 / the float ops.
                                if (ev_ty == "string") {
                                    ms = ms.mark_str(bslot, true);
                                } else if (ev_ty == "i64") {
                                    ms = ms.mark_i64(bslot, true);
                                } else if (ev_ty == "f64") {
                                    ms = ms.mark_f64(bslot, true);
                                } else if (decl_is_struct(ms.structs, ev_ty) || is_enum_like_name(ev_ty, ms.structs)) {
                                    ms = ms.mark_struct_type(bslot, ev_ty);
                                } else if (is_scalar_array_type(ev_ty)) {
                                    ms = ms.mark_arr(bslot, true);
                                } else if (ev_ty == "string[]") {
                                    ms = ms.mark_arr(bslot, true);
                                    ms = ms.mark_strarr(bslot, true);
                                } else if (ev_ty.len() >= 3 && ev_ty[ev_ty.len() - 2 : ev_ty.len()] == "[]"
                                           && (decl_is_struct(ms.structs, ev_ty[0 : ev_ty.len() - 2]) || is_enum_like_name(ev_ty[0 : ev_ty.len() - 2], ms.structs))) {
                                    // A struct- / enum-array payload (`Items(P[])`):
                                    // mark the slot is_arr and carry the ELEMENT type
                                    // so `ps[i].field` / `for p in ps` resolve (the
                                    // array-element analog of the struct payload case).
                                    ms = ms.mark_arr(bslot, true);
                                    ms = ms.mark_struct_type(bslot, ev_ty[0 : ev_ty.len() - 2]);
                                }
                            }
                            bidx = bidx + 1;
                        }
                        // Guard: `Variant(x) if <cond> =>` runs the body only when
                        // the guard is true; the binding is in scope, so the guard
                        // may reference it. A false guard `br`s out of the arm (the
                        // same target as a pattern mismatch), falling through to the
                        // next arm — matching asm.fern's guard semantics.
                        if (arm.has_guard) {
                            ms = lower_expr(arm.guard, ms);
                            if (!ms.ok) { return ms; }
                            ms = ms.emit(ir.op_bin("not", 0, false));
                            ms = ms.emit(ir.op_brif(0));            // guard false -> skip arm
                        }
                        ms = lower_block(arm.body, ms);
                        if (!ms.ok) { return ms; }
                        ms = ms.emit(ir.op_br(1));      // matched -> exit the match
                        ms = ms.emit(ir.op_end());      // end arm block
                    },
                    parser.PatWildcard(_) => {
                        if (arm.has_guard) {
                            // A guarded wildcard `_ if <cond> =>` falls through to
                            // the next arm when the guard is false, so it needs its
                            // own block (the bare wildcard below runs unconditionally).
                            ms = ms.emit(ir.op_block(0));
                            ms = lower_expr(arm.guard, ms);
                            if (!ms.ok) { return ms; }
                            ms = ms.emit(ir.op_bin("not", 0, false));
                            ms = ms.emit(ir.op_brif(0));            // guard false -> fall through
                            ms = lower_block(arm.body, ms);
                            if (!ms.ok) { return ms; }
                            ms = ms.emit(ir.op_br(1));              // matched -> exit the match
                            ms = ms.emit(ir.op_end());
                        } else {
                            ms = lower_block(arm.body, ms);
                            if (!ms.ok) { return ms; }
                            ms = ms.emit(ir.op_br(0));      // exit the match
                        }
                    }
                }
                mi = mi + 1;
            }
            return ms.emit(ir.op_end());   // end outer block
        },
        parser.StmtBreak(_) => {
            // br out to the innermost (while) loop's exit block. blk is that
            // block's ctrl level; from depth s.ctrl the relative br is the
            // difference. -1 (no enclosing loop) bails.
            var bblk: i32 = s.cur_loop_blk();
            if (bblk < 0) { return s.fail(); }
            return s.emit(ir.op_br(s.ctrl - bblk));
        },
        parser.StmtContinue(_) => {
            // br to the loop header, which sits one level deeper than the exit
            // block (block then loop).
            var cblk: i32 = s.cur_loop_blk();
            if (cblk < 0) { return s.fail(); }
            return s.emit(ir.op_br(s.ctrl - cblk - 1));
        },
        _ => { return s.fail(); }
    }
    return s.fail();
}

// emit_arr_store stores the new value (on top of the operand stack) into
// `slot` with Perceus accounting, mirroring asm.fern's StmtVar / StmtAssign:
//   1. retain the new reference (rc_inc) when it ALIASES an rc-tracked array
//      (alias_inc) — a fresh literal / move-from-call is already owned;
//   2. when the slot is an OWNED array (do_dec), cow-guarded release of the
//      OLD value the slot held — `if (old != new) arr_dec(old)` — skipping the
//      release when an in-place mutator returned the SAME buffer (so the live
//      value is not freed), and freeing the previous buffer otherwise (the
//      loop-rebind reclamation);
//   3. store the new value.
// The new value is stashed in a scratch local because it is read up to three
// times (retain arg, cow compare, final store). Composed of existing ops, so
// every backend + eval_ops lower it for free.
pub function emit_arr_store(se: LowerState, slot: i32, alias_inc: boolean, do_dec: boolean): LowerState {
    if (!alias_inc && !do_dec) {
        // No RC bookkeeping: a bare store (the common non-array case).
        return se.emit(ir.op_store_local(slot));
    }
    var scratch: string = "$rea" + util.i32_to_string(se.local_names.len());
    var st: LowerState = se.add_local(scratch);
    var tmp: i32 = st.slot_of(scratch);
    st = st.emit(ir.op_store_local(tmp));
    if (alias_inc) {
        st = st.emit(ir.op_load_local(tmp));
        st = st.emit(ir.op_call_direct("__fern_rc_inc", 1));
        st = st.emit(ir.op_drop());
    }
    if (do_dec) {
        st = st.emit(ir.op_load_local(slot));      // OLD value the slot holds
        st = st.emit(ir.op_load_local(tmp));       // new value
        st = st.emit(ir.op_bin("ne", 0, false));   // old != new (cow guard)
        st = st.emit(ir.op_if(0));
        st = st.emit(ir.op_load_local(slot));
        st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
        st = st.emit(ir.op_drop());
        st = st.emit(ir.op_end());
    }
    st = st.emit(ir.op_load_local(tmp));
    return st.emit(ir.op_store_local(slot));
}

// emit_dec_sweep_except releases (decs) every OWNED array local currently in
// scope except `keep` (the move-on-return slot, or -1 for none), leaving the
// operand stack unchanged. Array params (slots < n_params) are BORROWED — the
// caller retains ownership, so the callee never decs them (the n_params borrow
// boundary). Used at each return.
// emit_struct_field_drops releases the scalar-array (i32[] / boolean[]) FIELDS of
// a reclaimable struct before its box is freed — Perceus deep-drop, one level.
// The leaf-safe rule requires such a field be a fresh array LITERAL at
// construction (is_scalar_arr_field_access bails the aliasing forms), so the
// struct is the SOLE owner of that array; freeing it when the (sole-owner,
// non-escaping) struct is reclaimed cannot double-free. Guarded on a non-null box:
// an untaken-branch slot is null (op_struct_get would deref it), while the box's
// own rc-dec is null-safe. Emits nothing when the struct has no array field.
function emit_struct_field_drops(s: LowerState, slot: i32): LowerState {
    var sty: string = s.struct_type_of_slot(slot);
    if (sty.len() == 0) { return s; }
    var n: i32 = decl_field_count(s.structs, sty);
    var any: boolean = false;
    var fi: i32 = 0;
    while (fi < n) {
        if (is_leaksafe_array_field(decl_field_type_at(s.structs, sty, fi))) { any = true; }
        fi = fi + 1;
    }
    if (!any) { return s; }
    var st: LowerState = s;
    // if (box == null) skip the field drops:
    st = st.emit(ir.op_block(0));
    st = st.emit(ir.op_load_local(slot));
    st = st.emit(ir.op_const_i32(0));
    st = st.emit(ir.op_bin("eq", 0, false));   // 1 if box == null
    st = st.emit(ir.op_brif(0));               // -> skip on null
    var k: i32 = 0;
    while (k < n) {
        if (is_leaksafe_array_field(decl_field_type_at(st.structs, sty, k))) {
            st = st.emit(ir.op_load_local(slot));
            st = st.emit(ir.op_struct_get(k, struct_field_width(st.structs, sty, k)));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
            st = st.emit(ir.op_drop());
        }
        k = k + 1;
    }
    return st.emit(ir.op_end());
}

// --- Perceus precise drops (drop-on-last-use) for arrays -----------------
//
// Native's computePreciseDrops (ir.go ~3294) releases a value right after its
// last use instead of at function exit, bounding the live set. This is the
// conservative self-host first cut: it fires ONLY for a provably linear, owned
// array literal local — `var v = [ ... ]` declared once, never reassigned, and
// used ONLY as a borrow read (`v[i]`, `v.method()`, `for x in v`). Such a v is
// the sole owner of a fresh rc=1 buffer that never escapes, so releasing it
// right after its last top-level use is sound. Anything uncertain is omitted and
// falls back to the function-exit dec-sweep (the safe-leak invariant). The drop
// is emitted as dec + ZERO the slot, so the later exit-sweep harmlessly decs a
// null on that slot (no LowerState threading needed).

// expr_unsafe_for reports whether `name` appears anywhere in `e` in a position
// that could create a reference outliving a precise drop — i.e. ANY occurrence
// except a borrow read: the base of an index (`name[i]`), the receiver of a
// method/field access (`name.m(...)` / `name.f`). A bare ident, a slice base
// (a view aliases the buffer), a container-literal element, or a lambda capture
// all escape. A CALL ARGUMENT normally escapes too (the callee might retain it),
// EXCEPT a direct bare-ident `name` passed at a *borrowable* param position of a
// known free function (`borrowable` registry, "callee|flags") — a provably
// read-only callee cannot retain the arg, so passing it there is a BORROW. The
// registry is "" for Level-1 borrowability computation itself (every call arg
// escapes), avoiding circularity.
function expr_unsafe_for(e: parser.Expr, name: string, borrowable: string[]): boolean {
    match (e) {
        parser.ExprIdent(id) => { return id.name == name; },
        parser.ExprNumber(_) => { return false; },
        parser.ExprString(_) => { return false; },
        parser.ExprBool(_) => { return false; },
        parser.ExprBinary(b) => { return expr_unsafe_for(b.left, name, borrowable) || expr_unsafe_for(b.right, name, borrowable); },
        parser.ExprUnary(u) => { return expr_unsafe_for(u.operand, name, borrowable); },
        parser.ExprIndex(ix) => {
            var base_unsafe: boolean = false;
            match (ix.array) {
                parser.ExprIdent(_) => { base_unsafe = false; },   // name[i] / other[i]: base read is a borrow
                _ => { base_unsafe = expr_unsafe_for(ix.array, name, borrowable); }
            }
            return base_unsafe || expr_unsafe_for(ix.index, name, borrowable);
        },
        parser.ExprSlice(sl) => {
            // a slice creates a VIEW that aliases the source buffer → escapes.
            return expr_unsafe_for(sl.array, name, borrowable) || expr_unsafe_for(sl.start, name, borrowable) || expr_unsafe_for(sl.end, name, borrowable);
        },
        parser.ExprCall(c) => {
            var callee_unsafe: boolean = false;
            var callee_name: string = "";
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    callee_name = cid.name;   // free call: record callee for the borrow check below
                    if (cid.name == name) { callee_unsafe = true; }   // a value used AS the callee escapes (preserve prior behaviour)
                },
                parser.ExprFieldAccess(fa) => {
                    match (fa.obj) {
                        parser.ExprIdent(_) => { callee_unsafe = false; },   // name.method(): receiver is a borrow
                        _ => { callee_unsafe = expr_unsafe_for(fa.obj, name, borrowable); }
                    }
                    // method args stay escapes: method-param borrowability isn't in
                    // the (free-function-keyed) registry (callee_name left "").
                },
                _ => { callee_unsafe = expr_unsafe_for(c.callee, name, borrowable); }
            }
            if (callee_unsafe) { return true; }
            var ai: i32 = 0;
            while (ai < c.args.len()) {
                // Level 2: a DIRECT bare-ident `name` at a borrowable param position
                // of a known free function is a BORROW, not an escape.
                var arg_is_borrow: boolean = false;
                match (c.args[ai]) {
                    parser.ExprIdent(aid) => {
                        if (aid.name == name && callee_name.len() > 0 && param_is_borrowable(borrowable, callee_name, ai)) { arg_is_borrow = true; }
                    },
                    _ => {}
                }
                if (!arg_is_borrow && expr_unsafe_for(c.args[ai], name, borrowable)) { return true; }
                ai = ai + 1;
            }
            return false;
        },
        parser.ExprFieldAccess(fa) => {
            match (fa.obj) {
                parser.ExprIdent(_) => { return false; },   // name.field: base read is a borrow
                _ => { return expr_unsafe_for(fa.obj, name, borrowable); }
            }
        },
        parser.ExprArray(a) => {
            var i: i32 = 0;
            while (i < a.elements.len()) { if (expr_unsafe_for(a.elements[i], name, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprTuple(t) => {
            var i: i32 = 0;
            while (i < t.elements.len()) { if (expr_unsafe_for(t.elements[i], name, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprStructLit(sl) => {
            if (sl.has_base && expr_unsafe_for(sl.base, name, borrowable)) { return true; }
            var i: i32 = 0;
            while (i < sl.field_values.len()) { if (expr_unsafe_for(sl.field_values[i], name, borrowable)) { return true; } i = i + 1; }
            return false;
        },
        parser.ExprLambda(lm) => {
            var used: string[] = [];
            var i: i32 = 0;
            while (i < lm.body.len()) { used = astwalk.collect_idents_stmt(lm.body[i], used); i = i + 1; }
            return util.index_of_str(used, name) >= 0;
        },
        _ => { return false; }
    }
    return false;
}

// param_is_borrowable reports whether param `idx` of free function `name` is
// borrowable per the `borrowable` registry ("callee|flags", flag i = '1' iff
// param i is borrowable). Defaults false (unknown callee / out-of-range index →
// conservative escape). Mirrors the "name|flags" lookup of callee_param_is_fn.
function param_is_borrowable(borrowable: string[], name: string, idx: i32): boolean {
    var i: i32 = 0;
    while (i < borrowable.len()) {
        var e: string = borrowable[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != 124) { bar = bar + 1; }   // 124 = '|'
        if (bar < e.len() && e[0:bar] == name) {
            var pos: i32 = bar + 1 + idx;
            return pos < e.len() && e[pos] == 49;   // 49 = '1'
        }
        i = i + 1;
    }
    return false;
}

// stmt_unsafe_for / body_unsafe_for lift expr_unsafe_for over statements,
// special-casing `for x in name` (a borrow iteration, safe) and recursing into
// nested control-flow bodies. A reassignment of `name` is handled separately by
// the body_assign_targets bail, so StmtAssign only checks the RHS here.
function body_unsafe_for(stmts: parser.Stmt[], name: string, borrowable: string[]): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) { if (stmt_unsafe_for(stmts[i], name, borrowable)) { return true; } i = i + 1; }
    return false;
}
function stmt_unsafe_for(st: parser.Stmt, name: string, borrowable: string[]): boolean {
    match (st) {
        parser.StmtVar(v) => { return expr_unsafe_for(v.init, name, borrowable); },
        parser.StmtReturn(r) => { return expr_unsafe_for(r.value, name, borrowable); },
        parser.StmtExpr(e) => { return expr_unsafe_for(e.value, name, borrowable); },
        parser.StmtAssign(a) => { return expr_unsafe_for(a.value, name, borrowable); },
        parser.StmtIf(f) => {
            if (expr_unsafe_for(f.cond, name, borrowable)) { return true; }
            return body_unsafe_for(f.then_body, name, borrowable) || body_unsafe_for(f.else_body, name, borrowable);
        },
        parser.StmtWhile(w) => {
            if (expr_unsafe_for(w.cond, name, borrowable)) { return true; }
            return body_unsafe_for(w.body, name, borrowable);
        },
        parser.StmtFor(fo) => {
            var iter_unsafe: boolean = true;
            match (fo.iter) {
                parser.ExprIdent(_) => { iter_unsafe = false; },   // `for x in name`: borrow iteration
                _ => { iter_unsafe = expr_unsafe_for(fo.iter, name, borrowable); }
            }
            if (iter_unsafe) { return true; }
            return body_unsafe_for(fo.body, name, borrowable);
        },
        parser.StmtMatch(m) => {
            if (expr_unsafe_for(m.scrutinee, name, borrowable)) { return true; }
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                if (m.arms[ai].has_guard && expr_unsafe_for(m.arms[ai].guard, name, borrowable)) { return true; }
                if (body_unsafe_for(m.arms[ai].body, name, borrowable)) { return true; }
                ai = ai + 1;
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// all_i32_number_elems reports whether every element of an array literal is a
// non-float number literal — i.e. the literal is a pure i32[] (the only element
// type precise drops handle: scalar values whose buffer free needs no element
// walk and whose methods don't keep the buffer live).
function all_i32_number_elems(elems: parser.Expr[]): boolean {
    if (elems.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < elems.len()) {
        match (elems[i]) {
            parser.ExprNumber(num) => { if (num.is_float) { return false; } },
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

// all_f64_number_elems reports whether every element of an array literal is a
// FLOAT number literal — i.e. the literal is a pure f64[]. Like i32[]/i64[], an
// f64[] buffer holds only scalars (no nested pointers), so a sole-owner early
// free is sound and needs no element walk. (i64[] literals are written with the
// same non-float syntax as i32[] and are already caught by all_i32_number_elems;
// the slot's is_i64arr flag distinguishes them at emission.)
function all_f64_number_elems(elems: parser.Expr[]): boolean {
    if (elems.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < elems.len()) {
        match (elems[i]) {
            parser.ExprNumber(num) => { if (!num.is_float) { return false; } },
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

// all_scalar_literal_args reports whether every argument of a call is a scalar
// LITERAL (number / boolean / string) — so the call passes NO array, hence its
// result cannot be an alias/view of a caller-live array (it is a fresh owned
// buffer). Used to admit `var v = build(100)` array-returning free calls as
// precise-drop candidates.
function all_scalar_literal_args(args: parser.Expr[]): boolean {
    var i: i32 = 0;
    while (i < args.len()) {
        match (args[i]) {
            parser.ExprNumber(_) => {},
            parser.ExprBool(_) => {},
            parser.ExprString(_) => {},
            _ => { return false; }
        }
        i = i + 1;
    }
    return true;
}

// call_returns_scalar_array reports whether a free function `name` returns a
// SCALAR-element array (i32[] / i64[] / f64[]) — in the array-returning registry
// but NOT in the string[] one. Such a call's fresh result is a precise-drop
// candidate (a flat scalar buffer, sole owner, freeable shallowly). string[] is
// excluded HERE, at candidacy, because admitting it crashed the self-host (its
// element-pointer buffer + view-returning methods); a NESTED-array return is in
// `arr` and admitted here but rejected by the emission-site is_arrarr guard (its
// buffer holds array pointers needing an element walk), so no nested drop is
// emitted.
function call_returns_scalar_array(name: string, arr: string[], strarr: string[]): boolean {
    return util.index_of_str(arr, name) >= 0
        && util.index_of_str(strarr, name) < 0;
}

// PreciseDrops is the result of precise_drop_names: two PARALLEL arrays — for
// each precise drop, the top-level body-statement index AFTER which to release
// the array, and the local name to release. (A flat pair, not a `string[][]`,
// because the self-host compiler can't yet compile a nested string-array
// `.append` on itself — the fixpoint link gate caught it.)
struct PreciseDrops { idxs: i32[], names: string[] }

// precise_drop_names computes the array-literal LOCAL drop-on-last-use points: a
// name qualifies only if its init is a fresh `[ ... ]` literal, it is declared
// exactly once (not shadowed), never reassigned anywhere, and never used
// unsafely (body_unsafe_for is false — i.e. only borrow reads). Its drop point
// is its LAST top-level statement reference; releasing after that whole
// statement completes is sound even when the last reference sits inside a
// nested block.
function precise_drop_names(body: parser.Stmt[], arr_ret: string[], strarr_ret: string[], f64arr_ret: string[], i64arr_ret: string[], borrowable: string[]): PreciseDrops {
    var idxs: i32[] = [];
    var names: string[] = [];
    var reassigned: string[] = body_assign_targets(body);
    var seen: string[] = [];
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                // Candidate inits — both produce a FRESH OWNED scalar-element
                // buffer that is not an alias/view of a live value (so a sole-owner
                // early free is sound): a pure SCALAR-NUMBER array literal (i32[] /
                // i64[] via all_i32_number_elems, f64[] via all_f64_number_elems —
                // all flat scalar buffers, no nested pointers), or a FREE call (not
                // a method — a method like `.slice()` could return a view of its
                // receiver) that returns a scalar-element array
                // (call_returns_scalar_array: i32[]/i64[]/f64[]) with all-scalar-
                // literal args (so it passes no array to alias). string[] / nested-
                // array inits stay excluded (their buffers hold pointers needing an
                // element walk, and a string[] init crashed the self-host); the
                // emission-site slot guard enforces this.
                var is_lit: boolean = false;
                match (v.init) {
                    parser.ExprArray(arrl) => { is_lit = all_i32_number_elems(arrl.elements) || all_f64_number_elems(arrl.elements); },
                    parser.ExprCall(c) => {
                        match (c.callee) {
                            parser.ExprIdent(cid) => {
                                if (call_returns_scalar_array(cid.name, arr_ret, strarr_ret) && all_scalar_literal_args(c.args)) { is_lit = true; }
                            },
                            _ => {}
                        }
                    },
                    _ => {}
                }
                var shadowed: boolean = util.index_of_str(seen, v.name) >= 0;
                seen = seen.append(v.name);
                if (is_lit && !shadowed && util.index_of_str(reassigned, v.name) < 0 && !body_unsafe_for(body, v.name, borrowable)) {
                    var last: i32 = 0 - 1;
                    var k: i32 = i + 1;
                    var none: string[] = [];
                    while (k < body.len()) {
                        if (util.index_of_str(astwalk.collect_idents_stmt(body[k], none), v.name) >= 0) { last = k; }
                        k = k + 1;
                    }
                    if (last > i) {
                        idxs = idxs.append(last);
                        names = names.append(v.name);
                    }
                }
            },
            _ => {}
        }
        i = i + 1;
    }
    return PreciseDrops { idxs: idxs, names: names };
}

pub function emit_dec_sweep_except(s: LowerState, keep: i32): LowerState {
    var st: LowerState = s;
    var i: i32 = st.n_params;
    while (i < st.local_is_arr.len()) {
        if (i != keep && st.is_arr_slot(i)) {
            st = st.emit(ir.op_load_local(i));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
            st = st.emit(ir.op_drop());
        }
        i = i + 1;
    }
    // Reclaimable struct locals are freed the same way — a shallow rc-dec of the
    // box at scope exit. Only fresh, proven-non-escaping struct locals qualify
    // (slot_is_reclaimable_struct), so the box is the sole reference and freeing
    // it cannot dangle a caller's / container's reference: a RETURNED struct is
    // escaping → never reclaimable → never swept (no move-on-return `keep` needed
    // for structs). Slots are zeroed at entry (arr_slots_of), so an untaken-branch
    // slot decs a null (guarded no-op).
    var j: i32 = st.n_params;
    while (j < st.local_struct_type.len()) {
        if (j != keep && slot_is_reclaimable_struct(st, j)) {
            // Deep-drop the struct's scalar-array fields (sole-owned literals), then
            // free the box. Order matters: read the fields before freeing the box.
            st = emit_struct_field_drops(st, j);
            st = st.emit(ir.op_load_local(j));
            st = st.emit(ir.op_call_direct("__fern_rc_dec", 1));
            st = st.emit(ir.op_drop());
        }
        j = j + 1;
    }
    return st;
}

// lower_block lowers a sequence of statements (a then/else body), bailing
// on the first out-of-subset statement.
pub function lower_block(stmts: parser.Stmt[], s: LowerState): LowerState {
    var st: LowerState = s;
    var i: i32 = 0;
    while (i < stmts.len()) {
        st = lower_stmt(stmts[i], st);
        if (!st.ok) { return st; }
        i = i + 1;
    }
    return st;
}

// LowerResult is lower_func's output: the lowered op stream, the local-slot
// count (operand-frame size for the interpreter / a backend), and ok.
pub struct LowerResult {
    ok: boolean,
    ops: ir.Op[],
    n_locals: i32,
    n_params: i32,
    // arr_slots: the local slots holding arrays — the backend zeroes these at
    // entry so the exit dec-sweep never decs an uninitialised (untaken-branch)
    // slot.
    arr_slots: i32[],
    // i64_slots: the local slots holding i64 values — the wasm backend declares
    // these (local i64); the register backends ignore it (i64 shares the 64-bit
    // slot with i32).
    i64_slots: i32[],
    // f64_slots: the local slots holding f64 values; the wasm backend declares
    // these (local f64). The register backends ignore it (f64 shares the slot).
    f64_slots: i32[],
}

// arr_slots_of collects the OWNED array slots (>= n_params) — the ones the
// backend zeroes at entry. Array params hold the passed pointer and must NOT
// be zeroed (and are borrowed, so never swept).
function arr_slots_of(s: LowerState): i32[] {
    var out: i32[] = [];
    var i: i32 = s.n_params;
    while (i < s.local_is_arr.len()) {
        // Array locals AND reclaimable struct locals are zeroed at entry, so the
        // exit dec-sweep / loop-rebind release never decs an uninitialised (e.g.
        // untaken-branch) slot — __fern_arr_dec null-guards, but the slot must
        // hold null not stack garbage.
        if (s.is_arr_slot(i) || slot_is_reclaimable_struct(s, i)) { out = out.append(i); }
        i = i + 1;
    }
    return out;
}

// i64_slots_of lists the i64-holding local slots (params included — though
// eligible functions have no i64 params, lower_func bails on those).
function i64_slots_of(s: LowerState): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < s.local_is_i64.len()) {
        if (s.is_i64_slot(i)) { out = out.append(i); }
        i = i + 1;
    }
    return out;
}
// f64_slots_of: the local slots holding f64 values, so the wasm backend
// declares them (local f64). The register backends ignore it (f64 shares the
// 8-byte slot; only the ops differ).
function f64_slots_of(s: LowerState): i32[] {
    var out: i32[] = [];
    var i: i32 = 0;
    while (i < s.local_is_f64.len()) {
        if (s.is_f64_slot(i)) { out = out.append(i); }
        i = i + 1;
    }
    return out;
}

// is_array_type_name reports whether a type string denotes an array (ends
// with "[]", e.g. "i32[]").
function is_array_type_name(t: string): boolean {
    var n: i32 = t.len();
    if (n < 2) { return false; }
    return t[n - 2 : n] == "[]";
}

// is_u32_type_name reports whether a declared type is u32 (scalar) or u32[]
// (array) — the slots that drive u32 wrapping (local_is_u32). u8/u16 are
// excluded: their values are read in-range and explicitly cast, so they need no
// post-arithmetic wrap.
function is_u32_type_name(t: string): boolean {
    return t == "u32" || t == "u32[]";
}

// is_u64_type_name reports whether a declared type is u64 (scalar) or u64[] —
// the slots that drive UNSIGNED i64-domain ops (local_is_u64, #2904).
function is_u64_type_name(t: string): boolean {
    return t == "u64" || t == "u64[]";
}

// is_f64_scalar_type_name reports whether a declared SCALAR type is an 8-byte
// IEEE float — f64 or f32 (Fern represents f32 as an f64 internally: f32<->f64
// casts are no-ops and every float op runs at double width). The two spell the
// same runtime value, so a slot of either is marked local_is_f64 and a function
// returning either is registered f64-returning. (Arrays f64[]/f32[] are tracked
// separately via local_is_f64arr; this is the scalar classifier only.)
pub function is_f64_scalar_type_name(t: string): boolean {
    return t == "f64" || t == "f32" || t == "float";
}

// --- struct reclamation: conservative intra-procedural escape analysis ---
//
// reclaimable_names_of computes the struct-local names that are SAFE to free at
// scope exit / loop-rebind: names bound from a FRESH struct literal (a sole-owner
// rc=1 box) that never ESCAPE the function. A name escapes if it appears anywhere
// as a value — a return value, a call argument, a method receiver, a struct-lit
// field value, an array/tuple element, an operand, or the RHS of any binding /
// assignment — i.e. anything but a pure field READ (p.x, even `return p.x`,
// copies a scalar out and leaves p local). Anything uncertain is treated as
// escaping and left to leak: freeing only proven sole-owner non-escaping boxes
// cannot dangle another live reference (the safety property the earlier shallow-RC
// slice lacked — it freed escaping boxes and use-after-free'd the self-compile).
// Later slices widen this toward the native inter-procedural borrow inference.

// push_str_unique appends s to xs unless already present.
function push_str_unique(xs: string[], s: string): string[] {
    if (util.index_of_str(xs, s) >= 0) { return xs; }
    return xs.append(s);
}

// walk_fieldread_obj walks the OBJECT of a field-read chain (p.x, p.a.b): a bare
// ident object is NOT an escape (a scalar field is copied out, p stays local); a
// computed object (f().x, arr[i].x) escapes through its producer.
function walk_fieldread_obj(obj: parser.Expr, acc: string[]): string[] {
    match (obj) {
        parser.ExprIdent(_) => { return acc; },
        parser.ExprFieldAccess(fa) => { return walk_fieldread_obj(fa.obj, acc); },
        _ => { return walk_expr_escapes(obj, acc); },
    }
}

// walk_call_callee marks a method call's RECEIVER (obj.method(...)) as escaping
// (it is passed to the callee); a bare free-function name is not a local value.
function walk_call_callee(callee: parser.Expr, acc: string[]): string[] {
    match (callee) {
        parser.ExprIdent(_) => { return acc; },
        parser.ExprFieldAccess(fa) => { return walk_expr_escapes(fa.obj, acc); },
        _ => { return walk_expr_escapes(callee, acc); },
    }
}

// walk_expr_escapes adds to acc every local name that escapes through e.
function walk_expr_escapes(e: parser.Expr, acc: string[]): string[] {
    match (e) {
        parser.ExprIdent(id) => { return push_str_unique(acc, id.name); },
        parser.ExprFieldAccess(fa) => { return walk_fieldread_obj(fa.obj, acc); },
        parser.ExprCall(c) => {
            var a: string[] = walk_call_callee(c.callee, acc);
            var i: i32 = 0;
            while (i < c.args.len()) { a = walk_expr_escapes(c.args[i], a); i = i + 1; }
            return a;
        },
        parser.ExprBinary(b) => { return walk_expr_escapes(b.right, walk_expr_escapes(b.left, acc)); },
        parser.ExprUnary(u) => { return walk_expr_escapes(u.operand, acc); },
        parser.ExprIndex(ix) => { return walk_expr_escapes(ix.index, walk_expr_escapes(ix.array, acc)); },
        parser.ExprSlice(sl) => { return walk_expr_escapes(sl.end, walk_expr_escapes(sl.start, walk_expr_escapes(sl.array, acc))); },
        parser.ExprArray(arr) => {
            var a: string[] = acc;
            var i: i32 = 0;
            while (i < arr.elements.len()) { a = walk_expr_escapes(arr.elements[i], a); i = i + 1; }
            return a;
        },
        parser.ExprTuple(tu) => {
            var a: string[] = acc;
            var i: i32 = 0;
            while (i < tu.elements.len()) { a = walk_expr_escapes(tu.elements[i], a); i = i + 1; }
            return a;
        },
        parser.ExprStructLit(slit) => {
            var a: string[] = acc;
            if (slit.has_base) { a = walk_expr_escapes(slit.base, a); }
            var i: i32 = 0;
            while (i < slit.field_values.len()) { a = walk_expr_escapes(slit.field_values[i], a); i = i + 1; }
            return a;
        },
        parser.ExprLambda(lm) => { return walk_stmts_escapes(lm.body, acc); },
        _ => { return acc; },
    }
}

// walk_stmts_escapes / walk_stmt_escapes walk a statement list for escapes.
function walk_stmts_escapes(stmts: parser.Stmt[], acc: string[]): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) { a = walk_stmt_escapes(stmts[i], a); i = i + 1; }
    return a;
}

function walk_stmt_escapes(st: parser.Stmt, acc: string[]): string[] {
    match (st) {
        parser.StmtVar(v) => { return walk_expr_escapes(v.init, acc); },
        parser.StmtReturn(r) => { return walk_expr_escapes(r.value, acc); },
        parser.StmtExpr(ex) => { return walk_expr_escapes(ex.value, acc); },
        parser.StmtAssign(asn) => { return walk_expr_escapes(asn.value, acc); },
        parser.StmtIf(iff) => {
            var a: string[] = walk_expr_escapes(iff.cond, acc);
            a = walk_stmts_escapes(iff.then_body, a);
            return walk_stmts_escapes(iff.else_body, a);
        },
        parser.StmtWhile(w) => {
            var a: string[] = walk_expr_escapes(w.cond, acc);
            return walk_stmts_escapes(w.body, a);
        },
        parser.StmtFor(f) => {
            var a: string[] = walk_expr_escapes(f.iter, acc);
            return walk_stmts_escapes(f.body, a);
        },
        parser.StmtMatch(m) => {
            var a: string[] = walk_expr_escapes(m.scrutinee, acc);
            var i: i32 = 0;
            while (i < m.arms.len()) {
                if (m.arms[i].has_guard) { a = walk_expr_escapes(m.arms[i].guard, a); }
                a = walk_stmts_escapes(m.arms[i].body, a);
                i = i + 1;
            }
            return a;
        },
        parser.StmtSwitch(sw) => {
            var a: string[] = walk_expr_escapes(sw.scrutinee, acc);
            var i: i32 = 0;
            while (i < sw.cases.len()) {
                var j: i32 = 0;
                while (j < sw.cases[i].values.len()) { a = walk_expr_escapes(sw.cases[i].values[j], a); j = j + 1; }
                a = walk_stmts_escapes(sw.cases[i].body, a);
                i = i + 1;
            }
            if (sw.has_default) { a = walk_stmts_escapes(sw.default_body, a); }
            return a;
        },
        parser.StmtDefer(d) => { return walk_stmt_escapes(d.action, acc); },
        _ => { return acc; },
    }
}

// is_fresh_struct_init: an init producing a SOLE-OWNER (rc=1) struct value — a
// direct struct literal of a known struct type. (A struct-returning call is a
// move too, but this slice reclaims only directly-constructed structs; an aliased
// or call-bound struct is simply left to leak.)
function is_fresh_struct_init(e: parser.Expr, structs: parser.StructDecl[]): boolean {
    match (e) {
        parser.ExprStructLit(slit) => { return decl_is_struct(structs, slit.type_name); },
        _ => { return false; },
    }
}

// collect_fresh_struct_names gathers every var-name bound from a fresh struct
// literal, recursing through nested blocks.
function collect_fresh_struct_names(stmts: parser.Stmt[], structs: parser.StructDecl[], acc: string[]): string[] {
    var a: string[] = acc;
    var i: i32 = 0;
    while (i < stmts.len()) { a = collect_fresh_in_stmt(stmts[i], structs, a); i = i + 1; }
    return a;
}

function collect_fresh_in_stmt(st: parser.Stmt, structs: parser.StructDecl[], acc: string[]): string[] {
    match (st) {
        parser.StmtVar(v) => {
            if (is_fresh_struct_init(v.init, structs)) { return push_str_unique(acc, v.name); }
            return acc;
        },
        parser.StmtIf(iff) => {
            var a: string[] = collect_fresh_struct_names(iff.then_body, structs, acc);
            return collect_fresh_struct_names(iff.else_body, structs, a);
        },
        parser.StmtWhile(w) => { return collect_fresh_struct_names(w.body, structs, acc); },
        parser.StmtFor(f) => { return collect_fresh_struct_names(f.body, structs, acc); },
        parser.StmtMatch(m) => {
            var a: string[] = acc;
            var i: i32 = 0;
            while (i < m.arms.len()) { a = collect_fresh_struct_names(m.arms[i].body, structs, a); i = i + 1; }
            return a;
        },
        parser.StmtSwitch(sw) => {
            var a: string[] = acc;
            var i: i32 = 0;
            while (i < sw.cases.len()) { a = collect_fresh_struct_names(sw.cases[i].body, structs, a); i = i + 1; }
            if (sw.has_default) { a = collect_fresh_struct_names(sw.default_body, structs, a); }
            return a;
        },
        parser.StmtDefer(d) => { return collect_fresh_in_stmt(d.action, structs, acc); },
        _ => { return acc; },
    }
}

// reclaimable_names_of = fresh-bound struct names that never escape.
function reclaimable_names_of(body: parser.Stmt[], structs: parser.StructDecl[]): string[] {
    var esc: string[] = walk_stmts_escapes(body, []);
    var fresh: string[] = collect_fresh_struct_names(body, structs, []);
    var out: string[] = [];
    var i: i32 = 0;
    while (i < fresh.len()) {
        if (util.index_of_str(esc, fresh[i]) < 0) { out = out.append(fresh[i]); }
        i = i + 1;
    }
    return out;
}

// slot_is_reclaimable_struct: slot i holds a reclaimable struct — a non-param
// struct slot whose name was proven fresh + non-escaping. Such a box is the sole
// reference (rc=1) and outlives nothing, so a shallow rc-dec at scope exit /
// loop-rebind frees it safely. Scalar/leak-safe fields mean no rc-tracked field
// dangles (strings / inner arrays leak, as everywhere on this path).
function slot_is_reclaimable_struct(s: LowerState, i: i32): boolean {
    if (i < s.n_params) { return false; }
    if (i >= s.local_names.len()) { return false; }
    if (s.struct_type_of_slot(i).len() == 0) { return false; }
    return util.index_of_str(s.reclaimable_names, s.local_names[i]) >= 0;
}

// lower_func lowers a whole function's body. Params take slots 0..n-1.
// arr_ret_fns is the set of array-returning function names (for move tracking);
// strarr_ret_fns is the string[]-returning subset (for element typing at calls).
pub function lower_func(fn: parser.FuncDecl, arr_ret_fns: string[], structs: parser.StructDecl[], str_ret_fns: string[], strarr_ret_fns: string[], opt_ret_fns: string[], i64_ret_fns: string[], tuple_ret_fns: string[], struct_ret_fns: string[], f64_ret_fns: string[], f64arr_ret_fns: string[], i64arr_ret_fns: string[], fn_param_sigs: string[], closure_fns: string[], const_fns: string[], borrowable_params: string[]): LowerResult {
    var empty: ir.Op[] = [];
    var noslots: i32[] = [];
    // ret_i64: does this function return i64 (so `return <i64expr>` lowers via
    // lower_i64, and the wasm signature carries (result i64))?
    // u64 returns ride the same i64 64-bit path (only signedness of the value's
    // own ops differs, already handled at the producing expression) (#2904).
    var ret_i64: boolean = fn.ret_type == "i64" || fn.ret_type == "u64";
    var ret_i64arr: boolean = fn.ret_type == "i64[]";
    // ret_dyn: this function returns a SCALAR `dyn Trait` (not a `dyn Trait[]`
    // array), so `return <expr>` coerces the value to `dyn Trait` via
    // lower_dyn_arg (box a primitive/string, leave a struct/enum unboxed).
    var ret_dyn: boolean = fn.ret_type.len() > 4 && fn.ret_type[0:4] == "dyn " && !is_array_type_name(fn.ret_type);
    // f64[]/i64[]-returning functions ARE lowered now — including METHODS:
    // f64arr_ret_fns / i64arr_ret_fns record them keyed by bare name (free fns)
    // or "<Type>.<method>" (methods), so a call site `var x = obj.f()`
    // element-width-tracks x as f64[]/i64[] (expr_is_f64arr / expr_is_i64arr's
    // method-call case) and a later x[i] reads an 8-byte f64/i64. The body
    // returns an f64/i64-array pointer (move-on-return like any array); a method
    // adds nothing array-specific — the receiver binds as slot 0 like any other
    // method, so the array-return and method machineries simply compose.
    // A FREE function with f64 in its signature IS lowered now: an f64 param is
    // marked f64 in the local table (so it loads/stores like any 8-byte value
    // and the wasm sig declares (param f64)); an f64 return lowers its value
    // expr (which the float ops already produce) and the wasm sig declares
    // (result f64). The register backends need no ABI change (f64 rides the
    // 8-byte slot). A METHOD with f64 in its signature IS lowered too now:
    // f64_ret_fns_of records methods keyed "<Type>.<method>", so the call site
    // recovers the result's f64-ness (expr_is_f64's method case); f64 args ride
    // lower_expr like any f64 value. (i64 methods get the same treatment below.)
    // A string-returning function IS lowered: its body returns a string box (an
    // 8-byte pointer, like any value), and the call site tracks the result as a
    // string via str_ret_fns (see expr_is_str). A string[]-returning function is
    // lowered too: string[] is an ordinary rc-tracked array (move-on-return like
    // any array), and the call site tracks element string-ness via strarr_ret_fns
    // (see expr_is_strarr). The string elements leak — never freed — matching the
    // leak-safe string-array model. Neither return shape bails anymore.
    // A struct-returning function IS lowered when the struct is leaf-safe (all
    // scalar fields): the body returns the struct's heap pointer (like any
    // value), and a call site recovers the struct type via struct_ret_fns (see
    // struct_ret_type) to type later `p.x` field access. A non-leaf-safe struct
    // (array / nested-struct fields needing RC) still bails — matching the
    // scalar-only struct param / receiver constraint below.
    if (decl_is_struct(structs, fn.ret_type)) {
        if (!decl_is_leaksafe(structs, fn.ret_type)) {
            return LowerResult { ok: false, ops: empty, n_locals: 0, n_params: fn.params.len(), arr_slots: noslots, i64_slots: noslots, f64_slots: noslots };
        }
    }
    // A tuple-returning function IS lowered when every element is scalar (i32 /
    // bool / i64 / f64) or string: the body returns a tuple box (an 8-byte
    // pointer, like any value) whose elements ride uniform 8-byte slots, and a
    // call site recovers the element tags via tuple_ret_fns (see tuple_ret_type)
    // to type `.N` / destructure — including the 8-byte i64.load/f64.load width
    // for an i64/f64 element (op_tuple_get_w in the `.N` and destructure paths).
    // Leaf-safe struct elements are allowed too (leak-only pointers, recovered by
    // type tag). Tuples with array / Option elements still bail — those would
    // need RC / payload threading through the return — keeping them local-only.
    if (fn.ret_type.len() > 0 && fn.ret_type[0] == 40) {   // 40 = '('
        if (!tuple_elems_lowerable(fn.ret_type, structs)) {
            return LowerResult { ok: false, ops: empty, n_locals: 0, n_params: fn.params.len(), arr_slots: noslots, i64_slots: noslots, f64_slots: noslots };
        }
    }
    // i64 params + returns ARE lowered now: an i64 param is marked i64 in the
    // local table below (so it loads/stores as i64 and the wasm sig declares
    // (param i64)); an i64 return lowers `return` via lower_i64 and the wasm sig
    // declares (result i64). x86-64/arm64 need no ABI change (i64 shares the
    // 64-bit slot). The register backends keep their stack-arg ABI; only wasm's
    // typed signature differs, handled in the backend from fn.params/fn.ret_type.
    // A METHOD with i64 in its signature IS lowered now: i64_ret_fns_of records
    // its i64 SIGNATURE keyed "<Type>.<method>", so the call site recovers the
    // result's i64-ness (infer_expr_width / lower_i64 method cases) and routes
    // i64 args through lower_i64 (param_is_i64 keyed by the same label). An
    // i64-field-reading body (`return c.base`) works now that i64 struct fields
    // lower (#2733: struct_get_i64).
    var names: string[] = [];
    var isarr: boolean[] = [];
    var isstr: boolean[] = [];
    var isstrarr: boolean[] = [];
    var structty: string[] = [];
    var optty: string[] = [];
    var tupty: string[] = [];
    var mapty: string[] = [];
    var isi64: boolean[] = [];
    var isf64: boolean[] = [];
    var isf64arr: boolean[] = [];
    var isi64arr: boolean[] = [];
    var isu32: boolean[] = [];
    var isu64: boolean[] = [];
    var noloop: i32[] = [];
    // Method receiver → slot 0 (it sits at the first arg position, like param 0).
    // A scalar-field STRUCT receiver binds slot 0 as that struct (field-access
    // dispatch); a PRIMITIVE receiver (impl Trait for i32/boolean/string/i64/
    // f64) binds slot 0 as the scalar/string/i64/f64 it is — like a leading
    // param of that type — so `self` reads correctly and the call site's
    // primitive-receiver dispatch (expr_recv_prim_type) resolves. An ENUM
    // receiver binds slot 0 as a plain (heap-pointer) slot carrying the enum
    // type name, so `match (self)` works and an enum-typed call site dispatches
    // to `<Enum>.<method>`. An array / Option / tuple / non-leaksafe-struct
    // receiver still bails the module to AST.
    if (fn.receiver_name.len() > 0) {
        var rbase: string = util.base_type_name(fn.receiver_type);
        var r_is_struct: boolean = decl_is_struct(structs, rbase);
        var r_is_prim: boolean = rbase == "i32" || rbase == "boolean" || rbase == "string" || rbase == "i64" || rbase == "f64";
        var r_is_enum: boolean = is_enum_like_name(rbase, structs);
        // An Option[T] / Result[T, E] receiver (`function (o: Option[i32])
        // unwrap_or(...)`) binds slot 0 as a leak-only opt box carrying the full
        // receiver type, so `match (self)` recovers the payload — the same way an
        // Option/Result PARAM is opt-tracked below. The call site dispatches to
        // `Option.<method>` (base_type_name strips the payload), matching the
        // emitted label (#3031).
        var r_is_opt: boolean = fn.receiver_type.len() >= 8 && (fn.receiver_type[0:7] == "Option[" || fn.receiver_type[0:7] == "Result[");
        if (r_is_struct) {
            if (!decl_is_leaksafe(structs, rbase)) {
                return LowerResult { ok: false, ops: empty, n_locals: 0, n_params: 0, arr_slots: noslots, i64_slots: noslots, f64_slots: noslots };
            }
        } else if (!r_is_prim && !r_is_enum && !r_is_opt) {
            return LowerResult { ok: false, ops: empty, n_locals: 0, n_params: 0, arr_slots: noslots, i64_slots: noslots, f64_slots: noslots };
        }
        // A nominal receiver (struct or enum) carries its type name in
        // local_struct_type — a struct for field access, an enum for a
        // `self.method()` (enum) dispatch. A primitive carries "".
        var rsty: string = "";
        if (r_is_struct || r_is_enum) { rsty = rbase; }
        var ropt: string = "";
        if (r_is_opt) { ropt = fn.receiver_type; }
        names = names.append(fn.receiver_name);
        isarr = isarr.append(false);
        isstr = isstr.append(rbase == "string");
        isstrarr = isstrarr.append(false);
        structty = structty.append(rsty);
        optty = optty.append(ropt);
        tupty = tupty.append("");
        mapty = mapty.append("");
        isi64 = isi64.append(rbase == "i64");
        isf64 = isf64.append(is_f64_scalar_type_name(rbase));
        isf64arr = isf64arr.append(false);
        isi64arr = isi64arr.append(false);
        isu32 = isu32.append(is_u32_type_name(fn.receiver_type));
        isu64 = isu64.append(is_u64_type_name(fn.receiver_type));
    }
    var i: i32 = 0;
    while (i < fn.params.len()) {
        // A struct param must be a scalar-field struct; otherwise bail.
        if (decl_is_struct(structs, fn.params[i].type_name) && !decl_is_leaksafe(structs, fn.params[i].type_name)) {
            return LowerResult { ok: false, ops: empty, n_locals: 0, n_params: fn.params.len(), arr_slots: noslots, i64_slots: noslots, f64_slots: noslots };
        }
        names = names.append(fn.params[i].name);
        // An array-typed param is array-tracked (so a[i] / a.len() / aliasing
        // it work) but BORROWED — the dec-sweep skips slots < n_params. A
        // string[] param is additionally element-tracked (a[i] is a string).
        isarr = isarr.append(is_array_type_name(fn.params[i].type_name));
        // A string-typed param is string-tracked (for `.len()` / concat / eq
        // dispatch); strings aren't RC'd, so there is no borrow bookkeeping.
        isstr = isstr.append(fn.params[i].type_name == "string");
        isstrarr = isstrarr.append(fn.params[i].type_name == "string[]");
        // A struct-typed param carries its type name for field-access dispatch;
        // an enum-typed param carries the enum name so `param.method()`
        // dispatches to `<Enum>.<method>`.
        var pty: string = "";
        if (decl_is_struct(structs, fn.params[i].type_name)) { pty = fn.params[i].type_name; }
        else if (is_enum_like_name(fn.params[i].type_name, structs)) { pty = fn.params[i].type_name; }
        // A struct-array param `a: P[]` carries the ELEMENT struct type, so
        // `a[i].field` / `for x in a` over the borrowed array resolve.
        else if (is_array_type_name(fn.params[i].type_name)
                 && decl_is_struct(structs, fn.params[i].type_name[0 : fn.params[i].type_name.len() - 2])) {
            pty = fn.params[i].type_name[0 : fn.params[i].type_name.len() - 2];
        }
        // A 2D struct-/enum-array param `a: P[][]`: the INNERMOST element is the
        // struct/enum (strip both `[]`). The param is is_arrarr (set below), and
        // the array-foreach propagates this element type through `row` to `p`
        // (#3063, the param sibling of #3058/#3061).
        else if (is_array_type_name(fn.params[i].type_name)
                 && fn.params[i].type_name.len() >= 4 && is_array_type_name(fn.params[i].type_name[0 : fn.params[i].type_name.len() - 2])
                 && (decl_is_struct(structs, fn.params[i].type_name[0 : fn.params[i].type_name.len() - 4])
                     || is_enum_like_name(fn.params[i].type_name[0 : fn.params[i].type_name.len() - 4], structs))) {
            pty = fn.params[i].type_name[0 : fn.params[i].type_name.len() - 4];
        }
        // A `dyn Trait` param (or the element of a `dyn Trait[]` param) carries
        // the coarse `"dyn <Trait>"` type so `param.method()` / `for x in param`
        // dispatches dynamically by the receiver's runtime shape pointer.
        else if (fn.params[i].type_name.len() > 4 && fn.params[i].type_name[0:4] == "dyn ") {
            if (is_array_type_name(fn.params[i].type_name)) { pty = fn.params[i].type_name[0 : fn.params[i].type_name.len() - 2]; }
            else { pty = fn.params[i].type_name; }
        }
        structty = structty.append(pty);
        // An Option[T]/Result[T,E] param is opt-tracked so `match (param)` can
        // recover the payload type.
        var poty: string = "";
        var ptn: string = fn.params[i].type_name;
        if (ptn.len() >= 8 && (ptn[0:7] == "Option[" || ptn[0:7] == "Result[")) { poty = ptn; }
        optty = optty.append(poty);
        tupty = tupty.append("");
        mapty = mapty.append("");
        isi64 = isi64.append(fn.params[i].type_name == "i64");
        isf64 = isf64.append(is_f64_scalar_type_name(fn.params[i].type_name));
        // An f64[] param is element-width-tracked (a[i] reads an 8-byte f64);
        // the array itself rides the same 8-byte-stride layout every f64 array
        // literal in this (whole-module-IR) program uses, so passing one is safe.
        isf64arr = isf64arr.append(fn.params[i].type_name == "f64[]");
        isi64arr = isi64arr.append(fn.params[i].type_name == "i64[]");
        isu32 = isu32.append(is_u32_type_name(fn.params[i].type_name));
        isu64 = isu64.append(is_u64_type_name(fn.params[i].type_name));
        i = i + 1;
    }
    // Closure-arrays are detected at local binding time, not from params, so
    // every slot starts false (a fresh boolean[] of the parameter count).
    var isclosurearr: boolean[] = [];
    var ci: i32 = 0;
    while (ci < names.len()) { isclosurearr = isclosurearr.append(false); ci = ci + 1; }
    // A depth-2 array param (`a: T[][]`) is an array-of-arrays, so `for row in
    // a` binds `row` as an inner array — mark the param slot is_arrarr (the
    // receiver is never a 2D array — it bails earlier — so only params qualify).
    // Without this a 2D-array param's nested foreach bails (#3063).
    var nrecv: i32 = 0;
    if (fn.receiver_name.len() > 0) { nrecv = 1; }
    var isarrarr: boolean[] = [];
    var cii: i32 = 0;
    while (cii < names.len()) {
        var aa: boolean = false;
        var pidx: i32 = cii - nrecv;
        if (pidx >= 0 && pidx < fn.params.len()) {
            var ptn2: string = fn.params[pidx].type_name;
            if (is_array_type_name(ptn2) && ptn2.len() >= 4 && is_array_type_name(ptn2[0 : ptn2.len() - 2])) { aa = true; }
        }
        isarrarr = isarrarr.append(aa);
        cii = cii + 1;
    }
    var noclos: string[] = [];
    // Struct reclamation: the fresh, non-escaping struct locals this function may
    // free at scope exit / loop-rebind (conservative escape analysis above).
    var reclaim: string[] = reclaimable_names_of(fn.body, structs);
    var s: LowerState = LowerState { ops: empty, local_names: names, local_is_arr: isarr, local_is_str: isstr, local_is_strarr: isstrarr, local_struct_type: structty, local_opt_type: optty, local_tuple_elems: tupty, local_map_type: mapty, local_is_i64: isi64, local_is_f64: isf64, local_is_f64arr: isf64arr, local_is_i64arr: isi64arr, local_is_closurearr: isclosurearr, local_is_arrarr: isarrarr, local_is_u32: isu32, local_is_u64: isu64, ctrl: 0, loop_blk: noloop, ret_is_i64: ret_i64, ret_is_i64arr: ret_i64arr, ret_is_dyn: ret_dyn, i64_ret_fns: i64_ret_fns, fn_param_sigs: fn_param_sigs, cur_fn: fn.name, closure_fns: closure_fns, const_fns: const_fns, closure_locals: noclos, f64_ret_fns: f64_ret_fns, f64arr_ret_fns: f64arr_ret_fns, i64arr_ret_fns: i64arr_ret_fns, structs: structs, str_ret_fns: str_ret_fns, arr_ret_fns: arr_ret_fns, strarr_ret_fns: strarr_ret_fns, opt_ret_fns: opt_ret_fns, tuple_ret_fns: tuple_ret_fns, struct_ret_fns: struct_ret_fns, reclaimable_names: reclaim, n_params: names.len(), ok: true };
    // Perceus precise drops: release each linear, owned array-literal local right
    // after its last top-level use (drop-on-last-use), instead of at the exit
    // sweep — bounding the live set so its block recycles for later allocations.
    // Emitted as dec + zero the slot, so the exit sweep harmlessly decs null.
    var pdrops: PreciseDrops = precise_drop_names(fn.body, arr_ret_fns, strarr_ret_fns, f64arr_ret_fns, i64arr_ret_fns, borrowable_params);
    var j: i32 = 0;
    while (j < fn.body.len()) {
        s = lower_stmt(fn.body[j], s);
        if (!s.ok) { return LowerResult { ok: false, ops: s.ops, n_locals: 0, n_params: s.n_params, arr_slots: noslots, i64_slots: noslots, f64_slots: noslots }; }
        var pi: i32 = 0;
        while (pi < pdrops.idxs.len()) {
            if (pdrops.idxs[pi] == j) {
                var dslot: i32 = s.slot_of(pdrops.names[pi]);
                // Reclaim any scalar-element array slot (i32[] / i64[] / f64[] are
                // all is_arr and freed by the exit dec-sweep with the same
                // __fern_rc_dec); the precise drop just moves that dec earlier and
                // zeroes the slot. string[] (strarr) and nested arrays (arrarr) stay
                // excluded — their buffers hold pointers needing an element walk.
                if (dslot >= s.n_params && s.is_arr_slot(dslot)
                        && !s.is_strarr_slot(dslot) && !s.is_arrarr_slot(dslot)) {
                    s = s.emit(ir.op_load_local(dslot));
                    s = s.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    s = s.emit(ir.op_drop());
                    s = s.emit(ir.op_const_i32(0));
                    s = s.emit(ir.op_store_local(dslot));
                }
            }
            pi = pi + 1;
        }
        j = j + 1;
    }
    return LowerResult { ok: true, ops: s.ops, n_locals: s.local_names.len(), n_params: s.n_params, arr_slots: arr_slots_of(s), i64_slots: i64_slots_of(s), f64_slots: f64_slots_of(s) };
}

// LoweredFn is one function's lowered form, tagged with its name + arity so
// the interpreter and the backend can resolve direct calls.
pub struct LoweredFn {
    name: string,
    ok: boolean,
    ops: ir.Op[],
    n_locals: i32,
    n_params: i32,
    arr_slots: i32[],
}

// lower_module lowers every function in a program. It first collects the
// array-returning function names so move-on-return / move-from-call can fire.
// str_ret_fns_of collects the names of a module's string-returning functions
// (for the call-site string tracking). The emitters compute it once per module.
pub function str_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        if (funcs[k].ret_type == "string") { out = out.append(funcs[k].name); }
        k = k + 1;
    }
    return out;
}

// strarr_ret_fns_of collects the names of a module's string[]-returning
// functions (for the call-site element-string tracking).
pub function strarr_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        if (funcs[k].ret_type == "string[]") { out = out.append(funcs[k].name); }
        k = k + 1;
    }
    return out;
}

// opt_ret_fns_of collects "name|rettype" for a module's Option/Result-returning
// functions, so a match on `f()` can recover the bound payload type.
pub function opt_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        var rt: string = funcs[k].ret_type;
        if (rt.len() >= 8 && (rt[0:7] == "Option[" || rt[0:7] == "Result[")) {
            // Methods are keyed by the qualified "<BaseType>.<method>" (see
            // i64arr_ret_fns_of) so a `match (x.get())` on a struct-method's
            // Option/Result result recovers its payload type; free functions
            // stay keyed by bare name.
            var key: string = funcs[k].name;
            if (funcs[k].receiver_type.len() > 0) { key = util.base_type_name(funcs[k].receiver_type) + "." + funcs[k].name; }
            out = out.append(key + "|" + rt);
        }
        k = k + 1;
    }
    return out;
}

// tuple_elem_tags parses a tuple type string `(t0, t1, …)` into its element
// type spellings joined by commas ("i32,string,Point"), splitting on top-level
// commas only (nested brackets/parens don't count) and trimming spaces. Each
// spelling drops straight into local_tuple_elems, where "string" selects string
// dispatch, a struct name selects field access, and anything else is scalar.
pub function tuple_elem_tags(rt: string): string {
    if (rt.len() < 2 || rt[0] != 40) { return ""; }   // 40 = '('
    var inner: string = rt[1 : rt.len() - 1];
    var out: string = "";
    var depth: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    var first: boolean = true;
    while (i <= inner.len()) {
        if (i == inner.len() || (inner[i] == 44 && depth == 0)) {   // 44 = ','
            var seg: string = inner[start : i];
            if (seg.len() > 0 && seg[0] == 32) { seg = seg[1 : seg.len()]; }   // 32 = ' '
            if (seg.len() > 0 && seg[seg.len() - 1] == 32) { seg = seg[0 : seg.len() - 1]; }
            if (!first) { out = out + ","; }
            out = out + seg;
            first = false;
            start = i + 1;
        } else if (inner[i] == 91 || inner[i] == 40) { depth = depth + 1; }   // '[' '('
        else if (inner[i] == 93 || inner[i] == 41) { depth = depth - 1; }   // ']' ')'
        i = i + 1;
    }
    return out;
}

// tuple_elems_lowerable reports whether every element of tuple type `rt` is a
// scalar (i32 / bool), a string, or a leaf-safe struct — the set lower_func can
// return as a tuple box. A leaf-safe struct element is a leak-only pointer (no
// RC), recovered at the call site by its type tag, like the struct-return path.
// Array / i64 / Option/Result / nested-tuple elements still make it false so the
// function bails to the AST path (they'd need RC / width / payload threading).
pub function tuple_elems_lowerable(rt: string, structs: parser.StructDecl[]): boolean {
    var tags: string = tuple_elem_tags(rt);
    if (tags.len() == 0) { return false; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= tags.len()) {
        if (i == tags.len() || tags[i] == 44) {   // 44 = ','
            var t: string = tags[start : i];
            var ok_elem: boolean = (t == "i32" || t == "bool" || t == "string" || t == "i64" || t == "f64");
            if (!ok_elem && decl_is_struct(structs, t) && decl_is_leaksafe(structs, t)) { ok_elem = true; }
            // An Option[T] element is a leak-only box — one pointer slot, like a
            // string / struct element — so a tuple-returning fn can return it
            // (the ExprTuple construction admits it too). Only a comma-free tag
            // matches here: a `Result[T, E]` tag has an internal comma this
            // (non-depth-aware) element split can't see, so it stays deferred.
            if (!ok_elem && t.len() >= 8 && t[0:7] == "Option[") { ok_elem = true; }
            if (!ok_elem) { return false; }
            start = i + 1;
        }
        i = i + 1;
    }
    return true;
}

// tuple_ret_fns_of records "name|<elem tags>" for each function whose return
// type is a tuple, so a call site can recover the element types for `.N` /
// destructure dispatch. Free functions are keyed by bare name, methods by the
// qualified "<BaseType>.<method>" label (no "." collision between the two).
pub function tuple_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        var rt: string = funcs[k].ret_type;
        if (rt.len() > 0 && rt[0] == 40) {   // 40 = '('
            // Free function → bare name; method → qualified "<BaseType>.<method>"
            // (matching the call_direct dispatch label; no "." collision).
            var key: string = funcs[k].name;
            if (funcs[k].receiver_type.len() > 0) { key = util.base_type_name(funcs[k].receiver_type) + "." + funcs[k].name; }
            out = out.append(key + "|" + tuple_elem_tags(rt));
        }
        k = k + 1;
    }
    return out;
}

// struct_ret_fns_of records "name|StructType" for each free function whose
// return type is a leaf-safe struct OR an ENUM, so a call site can type
// `var p = f()` for later field access / `match`, and an associated call
// `Type.f()` (struct or enum) is recognised by its registered return type.
// Free functions are keyed by bare name; methods by the qualified
// "<BaseType>.<method>" the call site dispatches to (a "." never appears in a
// bare name, so the key spaces don't collide). An enum return is a leak-only
// variant box (its variants are leaf-safe structs); is_enum_like_name can
// over-match a non-enum bare nominal, but a spurious entry only risks an AST
// fallback at a call site (never a miscompile) — the stage-2 fixpoint guards it.
pub function struct_ret_fns_of(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): string[] {
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        var rt: string = funcs[k].ret_type;
        var elig: boolean = false;
        var elem_t: string = rt;
        if (decl_is_struct(structs, rt) && decl_is_leaksafe(structs, rt)) { elig = true; }
        else if (is_enum_like_name(rt, structs)) { elig = true; }
        // A struct-ARRAY return `P[]` (leaf-safe element): record the ELEMENT
        // struct type so a call site `var a = f()` (already is_arr via
        // arr_ret_fns) recovers `a[i]`'s struct type for field access / foreach.
        // The slot is an array, so struct_type_of_slot is read as the element
        // type (expr_struct_type reports "" for the array value itself). #3035.
        else if (rt.len() >= 3 && rt[rt.len() - 2 : rt.len()] == "[]") {
            var et: string = rt[0 : rt.len() - 2];
            if (decl_is_struct(structs, et) && decl_is_leaksafe(structs, et)) { elig = true; elem_t = et; }
        }
        // A SCALAR `dyn Trait` return: record the coarse "dyn <Trait>" type so a
        // call site recovers the result as a `dyn` value — expr_struct_type's
        // ExprCall path then reports "dyn …" for `f()`, which (a) routes a later
        // `d.m()` through op_dyn_dispatch (runtime shape dispatch) and (b) keeps
        // lower_dyn_arg from RE-boxing an already-boxed dyn return (its
        // expr_recv_prim_type sees a non-empty struct type and returns ""). A
        // `dyn Trait[]` return is NOT recorded here (the array path above already
        // handles struct-array returns; a dyn-array return still bails to AST).
        if (!elig && rt.len() > 4 && rt[0:4] == "dyn " && !(rt.len() >= 3 && rt[rt.len() - 2 : rt.len()] == "[]")) { elig = true; elem_t = rt; }
        if (elig) {
            var key: string = funcs[k].name;
            if (funcs[k].receiver_type.len() > 0) { key = util.base_type_name(funcs[k].receiver_type) + "." + funcs[k].name; }
            out = out.append(key + "|" + elem_t);
        }
        k = k + 1;
    }
    return out;
}

// i64_ret_fns_of records the i64 SIGNATURE of each function that has any i64 in
// its return or params, as "name|<ret><p0><p1>…" where each flag is '1' (i64)
// or '0'. The call site reads the ret flag (is the result i64?) and the param
// flags (must this arg be lowered as i64?). Functions with no i64 are omitted
// (their default is all-i32). The field name stays i64_ret_fns for continuity.
// f64_ret_fns_of collects the names of a module's f64-returning functions, so a
// call site recognises the result as an f64 value. Free functions are keyed by
// bare name; methods by the qualified "<BaseType>.<method>" the call site
// dispatches to (a "." never appears in a bare name, so the key spaces agree).
pub function f64_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        if (is_f64_scalar_type_name(funcs[k].ret_type)) {
            var key: string = funcs[k].name;
            if (funcs[k].receiver_type.len() > 0) { key = util.base_type_name(funcs[k].receiver_type) + "." + funcs[k].name; }
            out = out.append(key);
        }
        k = k + 1;
    }
    return out;
}
// f64arr_ret_fns_of collects the names of a module's f64[]-returning functions,
// so a call-site `var x = f()` element-width-tracks x as f64[]. Free functions
// are keyed by bare name; methods by the qualified "<BaseType>.<method>" the
// call site dispatches to (a "." never appears in a bare name, so the key spaces
// don't collide — same convention as f64_ret_fns_of).
pub function f64arr_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        if (funcs[k].ret_type == "f64[]") {
            var key: string = funcs[k].name;
            if (funcs[k].receiver_type.len() > 0) { key = util.base_type_name(funcs[k].receiver_type) + "." + funcs[k].name; }
            out = out.append(key);
        }
        k = k + 1;
    }
    return out;
}
// i64arr_ret_fns_of collects the names of a module's i64[]-returning functions,
// so a call-site `var x = f()` element-types x as i64[]. Methods are keyed by the
// qualified "<BaseType>.<method>" (see f64arr_ret_fns_of).
pub function i64arr_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        if (funcs[k].ret_type == "i64[]") {
            var key: string = funcs[k].name;
            if (funcs[k].receiver_type.len() > 0) { key = util.base_type_name(funcs[k].receiver_type) + "." + funcs[k].name; }
            out = out.append(key);
        }
        k = k + 1;
    }
    return out;
}
// fn_param_sigs_of records "name|<flags>" for each free function that has at
// least one function-typed ("fn") param — flag i is '1' iff param i is "fn".
// Drives the type-directed function-value detection at call sites
// (callee_param_is_fn). Functions with no "fn" param are omitted (the lookup
// defaults to false). Methods are keyed "<Type>.<method>".
// closure_ret_fns_of returns the names of functions whose body's last statement
// is `return <capturing lambda>` — they produce a closure BOX, so a caller's
// `var f = <call>` binds f as a closure local (closures slice 3a).
// const_fns_of collects the names of zero-arg, receiver-less module functions
// (a `const NAME = expr` desugars to exactly one — see parser.parse_const_decl).
// A bare ident reference to one, in value position, lowers to a CALL (the
// const's value); the LowerState carries this so lower_expr's ExprIdent arm can
// dispatch it instead of bailing the module to the AST emitter (#2954). Mirrors
// asm.fern's ExprIdent rule (zero-arg receiver-less -> call; >0-arg -> fn-value).
pub function const_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var ci: i32 = 0;
    while (ci < funcs.len()) {
        if (funcs[ci].receiver_type.len() == 0 && funcs[ci].params.len() == 0) {
            out = out.append(funcs[ci].name);
        }
        ci = ci + 1;
    }
    return out;
}

pub function closure_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var gfns: string[] = [];
    var gi: i32 = 0;
    while (gi < funcs.len()) {
        if (funcs[gi].receiver_type.len() == 0) { gfns = gfns.append(funcs[gi].name); }
        gi = gi + 1;
    }
    var out: string[] = [];
    var fi: i32 = 0;
    while (fi < funcs.len()) {
        var b: parser.Stmt[] = funcs[fi].body;
        if (b.len() > 0) {
            match (b[b.len() - 1]) {
                parser.StmtReturn(r) => {
                    match (r.value) {
                        parser.ExprLambda(lam) => {
                            if (!lambda_has_no_captures(lam, gfns)) { out = out.append(funcs[fi].name); }
                        },
                        _ => { }
                    }
                },
                _ => { }
            }
        }
        fi = fi + 1;
    }
    return out;
}

pub function fn_param_sigs_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        var flags: string = "";
        var any: boolean = false;
        var pj: i32 = 0;
        while (pj < funcs[k].params.len()) {
            if (funcs[k].params[pj].type_name == "fn") { flags = flags + "1"; any = true; }
            // A SCALAR `dyn Trait` param: flag '2'. A primitive/string arg passed
            // here is heap-boxed into a `dyn` cell at the call site (op_dyn_box) so
            // the receiver carries a shape pointer (docs/DYN-TRAITS.md §4.2.3).
            // '2' is distinct from the fn flag '1', so callee_param_is_fn is
            // unaffected; callee_param_is_dyn reads '2'. A `dyn Trait[]` param
            // (an ARRAY) is NOT flagged: it receives an already-built array whose
            // primitive elements were boxed at the array literal, so the array
            // pointer flows in one word unchanged (no per-call box).
            else if (funcs[k].params[pj].type_name.len() > 4 && funcs[k].params[pj].type_name[0:4] == "dyn "
                     && !is_array_type_name(funcs[k].params[pj].type_name)) { flags = flags + "2"; any = true; }
            else { flags = flags + "0"; }
            pj = pj + 1;
        }
        if (any) {
            var key: string = funcs[k].name;
            if (funcs[k].receiver_type.len() > 0) { key = util.base_type_name(funcs[k].receiver_type) + "." + funcs[k].name; }
            out = out.append(key + "|" + flags);
        }
        k = k + 1;
    }
    return out;
}
// borrowable_params_of computes, for each free function, which params are
// "borrowable" — provably only borrow-read in the body and never escaping
// (returned, stored in a container, passed to ANY call, sliced, or captured).
// A borrowable param means the callee cannot retain the argument, so a
// sole-owner array passed there can still be precise-dropped at the call site
// (the Level-2 reclaim in expr_unsafe_for). This is a conservative,
// intra-procedural UNDER-approximation: borrowability is computed with an EMPTY
// borrowable registry (`none`), so the strict escape walker treats a param
// passed to any call as escaping — i.e. we don't yet do the inter-procedural
// inferParamEscapes fixpoint (native ir.go:2554). Encoded "callee|flags"
// (flag i = '1' iff param i borrowable); methods keyed "<Type>.<method>" but
// only free-function entries are consulted at call sites. Entries with no
// borrowable param are omitted (lookup defaults to false). Mirrors native's
// borrow inference, the conservative first cut.
pub function borrowable_params_of(funcs: parser.FuncDecl[]): string[] {
    var none: string[] = [];
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        var flags: string = "";
        var any: boolean = false;
        var pj: i32 = 0;
        while (pj < funcs[k].params.len()) {
            var pname: string = funcs[k].params[pj].name;
            if (!body_unsafe_for(funcs[k].body, pname, none)) { flags = flags + "1"; any = true; }
            else { flags = flags + "0"; }
            pj = pj + 1;
        }
        if (any) {
            var key: string = funcs[k].name;
            if (funcs[k].receiver_type.len() > 0) { key = util.base_type_name(funcs[k].receiver_type) + "." + funcs[k].name; }
            out = out.append(key + "|" + flags);
        }
        k = k + 1;
    }
    return out;
}
// borrowable_key is the registry key for a function's borrowability entry: the
// bare name for a free function, "<Type>.<method>" for a receiver method.
function borrowable_key(fn: parser.FuncDecl): string {
    if (fn.receiver_type.len() > 0) { return util.base_type_name(fn.receiver_type) + "." + fn.name; }
    return fn.name;
}
// borrowable_params_interproc is the inter-procedural widening of
// borrowable_params_of: a SINGLE forward pass with a GROWING registry, so when the
// pass reaches function i, `reg` already holds the borrowable entries of funcs
// 0..i-1 and a param that forwards to an EARLIER-defined borrowable callee is
// itself recognised as a borrow (capturing the common "helper defined before its
// user" forwarding, e.g. `inner` before `outer`). Forwarding to a later-defined /
// mutually recursive callee degrades to the conservative answer — a SOUND
// under-approximation.
//
// COST: the growing registry makes the escape walker short-circuit less, so this
// is materially heavier than the empty-registry conservative pass — recomputing it
// once per lowered function OOMs the arm64 self-compile (measured). It is therefore
// used ONLY on the emit path, computed ONCE per module before the per-function emit
// loop and threaded through `emit_function_via_ir` / `emit_function_ir`. The ~15
// inspection passes (module_uses_*, str_values, …) keep using the cheap
// conservative `borrowable_params_of`: they only check op-kind presence, and the
// only op a precise drop adds (__fern_arr_dec) is already emitted by the
// function-exit dec-sweep, so no inspection result can flip.
pub function borrowable_params_interproc(funcs: parser.FuncDecl[]): string[] {
    // Least-fixpoint FROM BELOW, iterated to convergence: start with NOTHING
    // borrowable, then repeatedly re-run the escape walker against the PREVIOUS
    // iteration's complete registry and mark a param '1' wherever all its uses are
    // borrows — including forwarding it to any borrowable callee, regardless of
    // definition order or (mutual) recursion. Pass 1 (empty registry ⇒ every call
    // arg escapes) is the conservative answer; each later pass only ADDS
    // borrowability as more callees become known borrowable, so the set grows
    // monotonically and the iteration converges when its size stops changing. The
    // registry is kept stripped to the borrowable subset so `param_is_borrowable`'s
    // scan stays cheap, and a small cap bounds pathological cases (convergence is
    // normally 2-4 passes). This is the full inter-procedural inference; it is
    // affordable because it is computed ONCE per module on the emit path (see the
    // emit_function_via_ir / emit_function_ir call sites), not per lowered function.
    // Encoded "callee|flags"; methods keyed "<Type>.<method>".
    var reg: string[] = [];
    var cap: i32 = 8;
    var iter: i32 = 0;
    var prevsize: i32 = 0 - 1;
    while (iter < cap && reg.len() != prevsize) {
        prevsize = reg.len();
        var next: string[] = [];
        var i: i32 = 0;
        while (i < funcs.len()) {
            if (funcs[i].params.len() > 0) {
                var flags: string = "";
                var any: boolean = false;
                var pj: i32 = 0;
                while (pj < funcs[i].params.len()) {
                    if (!body_unsafe_for(funcs[i].body, funcs[i].params[pj].name, reg)) { flags = flags + "1"; any = true; }
                    else { flags = flags + "0"; }
                    pj = pj + 1;
                }
                if (any) { next = next.append(borrowable_key(funcs[i]) + "|" + flags); }
            }
            i = i + 1;
        }
        // borrowability is monotone-increasing, so an unchanged size = converged.
        reg = next;
        iter = iter + 1;
    }
    return reg;
}
pub function i64_ret_fns_of(funcs: parser.FuncDecl[]): string[] {
    var out: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        // Free functions are keyed by bare name; methods (lowered now) by the
        // qualified "<BaseType>.<method>" the call site dispatches to (a "." never
        // appears in a bare name, so the key spaces don't collide).
        // u64 rides the i64 64-bit signature path (it is i64-wide; only the
        // signedness of its own ops differs, selected at the producing
        // expression). So a u64 ret/param flags '1' here too (#2904).
        var retf: boolean = funcs[k].ret_type == "i64" || funcs[k].ret_type == "u64";
        var flags: string = "";
        var any: boolean = retf;
        var pj: i32 = 0;
        while (pj < funcs[k].params.len()) {
            if (funcs[k].params[pj].type_name == "i64" || funcs[k].params[pj].type_name == "u64") { flags = flags + "1"; any = true; }
            else { flags = flags + "0"; }
            pj = pj + 1;
        }
        if (any) {
            var rc: string = "0";
            if (retf) { rc = "1"; }
            var key: string = funcs[k].name;
            if (funcs[k].receiver_type.len() > 0) { key = util.base_type_name(funcs[k].receiver_type) + "." + funcs[k].name; }
            out = out.append(key + "|" + rc + flags);
        }
        k = k + 1;
    }
    return out;
}

// lower_func_for is the common-case wrapper over lower_func: it derives the
// fourteen `*_ret_fns_of(funcs)` / signature / borrowable side-tables from a
// single `funcs` list (plus `structs`), so a backend lowering a function only
// supplies the function, its array-returning-name set, the struct decls, and
// the module's function list. The eligibility scans and the per-function emit
// loops that lower with a module-derived `borrowable_params_of(funcs)` all
// passed exactly these arguments; naming the derivation once removes a
// ~700-char call from each site and means a new side-table threaded through
// lowering is added in one place, not ~15.
//
// NOT for the inter-procedural Perceus emit paths (emit_function_via_ir on the
// asm/arm64 backends, wasm_ir's emit_one): those thread a precomputed,
// fixed-point `borrowable_params` that is deliberately NOT
// `borrowable_params_of(funcs)`, so they keep calling lower_func directly.
pub function lower_func_for(fn: parser.FuncDecl, arr_ret_fns: string[], structs: parser.StructDecl[], funcs: parser.FuncDecl[]): LowerResult {
    return lower_func(fn, arr_ret_fns, structs, str_ret_fns_of(funcs), strarr_ret_fns_of(funcs), opt_ret_fns_of(funcs), i64_ret_fns_of(funcs), tuple_ret_fns_of(funcs), struct_ret_fns_of(funcs, structs), f64_ret_fns_of(funcs), f64arr_ret_fns_of(funcs), i64arr_ret_fns_of(funcs), fn_param_sigs_of(funcs), closure_ret_fns_of(funcs), const_fns_of(funcs), borrowable_params_of(funcs));
}

// lower_func_for_noret is lower_func_for with the array- and string-return name
// sets left empty. The module-level op scanners (module_uses_heap /
// module_uses_maps) lower every function only to inspect the resulting op
// kinds, so the move-tracking name sets that the array/string return args feed
// are irrelevant there; passing them empty keeps those scans matching their
// previous behaviour while sharing the side-table derivation.
pub function lower_func_for_noret(fn: parser.FuncDecl, structs: parser.StructDecl[], funcs: parser.FuncDecl[]): LowerResult {
    var none: string[] = [];
    return lower_func(fn, none, structs, none, none, opt_ret_fns_of(funcs), i64_ret_fns_of(funcs), tuple_ret_fns_of(funcs), struct_ret_fns_of(funcs, structs), f64_ret_fns_of(funcs), f64arr_ret_fns_of(funcs), i64arr_ret_fns_of(funcs), fn_param_sigs_of(funcs), closure_ret_fns_of(funcs), const_fns_of(funcs), borrowable_params_of(funcs));
}

// i64_sig_of returns the "<ret><params>" flag string for `name`, or "" if the
// function has no i64 signature entry.
pub function (s: LowerState) i64_sig_of(name: string): string {
    var i: i32 = 0;
    while (i < s.i64_ret_fns.len()) {
        var e: string = s.i64_ret_fns[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != 124) { bar = bar + 1; }   // 124 = '|'
        if (bar < e.len() && e[0:bar] == name) { return e[bar + 1 : e.len()]; }
        i = i + 1;
    }
    return "";
}
// is_i64_ret_fn reports whether `name` returns i64 (the ret flag of its sig).
pub function (s: LowerState) is_i64_ret_fn(name: string): boolean {
    var sig: string = s.i64_sig_of(name);
    return sig.len() >= 1 && sig[0] == 49;   // 49 = '1'
}
// is_f64_ret_fn reports whether free function `name` returns f64 (so a call to
// it is recognised as an f64 value).
pub function (s: LowerState) is_f64_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.f64_ret_fns.len()) {
        if (s.f64_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}
// is_f64arr_ret_fn reports whether `name` returns f64[] (so a `var x = f()`
// binding element-width-tracks x as f64[]). `name` is the bare callee for a free
// function or the qualified "<Type>.<method>" for a method call.
pub function (s: LowerState) is_f64arr_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.f64arr_ret_fns.len()) {
        if (s.f64arr_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}
// is_i64arr_ret_fn reports whether `name` returns i64[] (bare name or
// "<Type>.<method>", same convention as is_f64arr_ret_fn).
pub function (s: LowerState) is_i64arr_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.i64arr_ret_fns.len()) {
        if (s.i64arr_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}
// param_is_i64 reports whether arg index `idx` of a call to `name` targets an
// i64 param (so the argument must be lowered as an i64 value).
pub function (s: LowerState) param_is_i64(name: string, idx: i32): boolean {
    var sig: string = s.i64_sig_of(name);
    var pos: i32 = idx + 1;   // skip the ret flag
    return pos < sig.len() && sig[pos] == 49;   // 49 = '1'
}

// callee_param_is_fn reports whether callee `name`'s param `idx` is a function
// type ("fn") — so a bare function-name argument there is a function VALUE
// (const_func), not a call. Mirrors asmcore.callee_param_is_fn, reading the
// fn_param_sigs registry ("callee|<flags>").
pub function (s: LowerState) callee_param_is_fn(name: string, idx: i32): boolean {
    var i: i32 = 0;
    while (i < s.fn_param_sigs.len()) {
        var e: string = s.fn_param_sigs[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != 124) { bar = bar + 1; }   // 124 = '|'
        if (bar < e.len() && e[0:bar] == name) {
            var pos: i32 = bar + 1 + idx;
            return pos < e.len() && e[pos] == 49;   // 49 = '1'
        }
        i = i + 1;
    }
    return false;
}

// callee_param_is_dyn reports whether callee `name`'s param `idx` is a
// `dyn Trait` type (flag '2' in fn_param_sigs) — so a primitive/string arg
// there must be heap-boxed into a `dyn` cell (op_dyn_box) before the call
// (docs/DYN-TRAITS.md §4.2.3). Same registry/format as callee_param_is_fn.
pub function (s: LowerState) callee_param_is_dyn(name: string, idx: i32): boolean {
    var i: i32 = 0;
    while (i < s.fn_param_sigs.len()) {
        var e: string = s.fn_param_sigs[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != 124) { bar = bar + 1; }   // 124 = '|'
        if (bar < e.len() && e[0:bar] == name) {
            var pos: i32 = bar + 1 + idx;
            return pos < e.len() && e[pos] == 50;   // 50 = '2'
        }
        i = i + 1;
    }
    return false;
}

// opt_ret_type returns the recorded ret_type for a function name in opt_ret_fns
// ("Option[T]"/"Result[T, E]"), or "" if not an Option/Result-returning fn.
pub function (s: LowerState) opt_ret_type(name: string): string {
    var i: i32 = 0;
    while (i < s.opt_ret_fns.len()) {
        var e: string = s.opt_ret_fns[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != 124) { bar = bar + 1; }   // 124 = '|'
        if (bar < e.len() && e[0:bar] == name) { return e[bar + 1 : e.len()]; }
        i = i + 1;
    }
    return "";
}

// tuple_ret_type returns the comma-joined element-type tags for tuple-returning
// free function `name` (e.g. "i32,string,i32"), ready to drop into a slot's
// local_tuple_elems, or "" if `name` isn't a (lowered) tuple-returning function.
pub function (s: LowerState) tuple_ret_type(name: string): string {
    var i: i32 = 0;
    while (i < s.tuple_ret_fns.len()) {
        var e: string = s.tuple_ret_fns[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != 124) { bar = bar + 1; }   // 124 = '|'
        if (bar < e.len() && e[0:bar] == name) { return e[bar + 1 : e.len()]; }
        i = i + 1;
    }
    return "";
}

// struct_ret_type returns the struct type name returned by free function `name`,
// or "" if `name` isn't a (lowered) struct-returning function.
pub function (s: LowerState) struct_ret_type(name: string): string {
    var i: i32 = 0;
    while (i < s.struct_ret_fns.len()) {
        var e: string = s.struct_ret_fns[i];
        var bar: i32 = 0;
        while (bar < e.len() && e[bar] != 124) { bar = bar + 1; }   // 124 = '|'
        if (bar < e.len() && e[0:bar] == name) { return e[bar + 1 : e.len()]; }
        i = i + 1;
    }
    return "";
}

// opt_payload_type parses a "Option[T]" / "Result[T, E]" ret_type and the bound
// variant to the payload type tag: T for Some/Ok, E for Err. Returns "" if the
// shape isn't a simple single-type-arg form (nested generics / tuples bail).
pub function opt_payload_type(rettype: string, variant: string): string {
    var n: i32 = rettype.len();
    if (n >= 8 && rettype[0:7] == "Option[" && rettype[n - 1] == 93) {   // 93 = ']'
        return rettype[7 : n - 1];
    }
    if (n >= 8 && rettype[0:7] == "Result[" && rettype[n - 1] == 93) {
        // Split the inside on the FIRST top-level comma: T , E.
        var inside: string = rettype[7 : n - 1];
        var depth: i32 = 0;
        var ci: i32 = 0;
        while (ci < inside.len()) {
            var ch: i32 = inside[ci];
            if (ch == 91) { depth = depth + 1; }        // '['
            else if (ch == 93) { depth = depth - 1; }   // ']'
            else if (ch == 44 && depth == 0) {          // ',' at top level
                if (variant == "Err") { return trim_spaces(inside[ci + 1 : inside.len()]); }
                return trim_spaces(inside[0 : ci]);
            }
            ci = ci + 1;
        }
        return "";
    }
    return "";
}

// map_key_kind_of returns 1 for an i32-keyed Map type, 0 for string-keyed
// ("Map[i32, V]" / "Map[string, V]").
pub function map_key_kind_of(typestr: string): i32 {
    if (typestr.len() >= 8 && typestr[0:8] == "Map[i32,") { return 1; }
    return 0;
}

// map_value_of returns the value type V of a "Map[K, V]" type string (i32 /
// string), or "" if not parseable.
pub function map_value_of(typestr: string): string {
    if (typestr.len() < 5 || typestr[0:4] != "Map[") { return ""; }
    var inner: string = typestr[4 : typestr.len() - 1];   // K, V
    var ci: i32 = 0;
    while (ci < inner.len() && inner[ci] != 44) { ci = ci + 1; }   // first comma
    if (ci >= inner.len()) { return ""; }
    return trim_spaces(inner[ci + 1 : inner.len()]);
}

// trim_spaces drops leading/trailing ASCII spaces.
function trim_spaces(t: string): string {
    var a: i32 = 0;
    var b: i32 = t.len();
    while (a < b && t[a] == 32) { a = a + 1; }
    while (b > a && t[b - 1] == 32) { b = b - 1; }
    return t[a : b];
}

pub function lower_module(funcs: parser.FuncDecl[], structs: parser.StructDecl[]): LoweredFn[] {
    var arr_ret_fns: string[] = [];
    var k: i32 = 0;
    while (k < funcs.len()) {
        if (is_array_type_name(funcs[k].ret_type)) { arr_ret_fns = arr_ret_fns.append(funcs[k].name); }
        k = k + 1;
    }
    var srf: string[] = str_ret_fns_of(funcs);
    var sarf: string[] = strarr_ret_fns_of(funcs);
    var orf: string[] = opt_ret_fns_of(funcs);
    var irf: string[] = i64_ret_fns_of(funcs);
    var trf: string[] = tuple_ret_fns_of(funcs);
    var srtf: string[] = struct_ret_fns_of(funcs, structs);
    var frf: string[] = f64_ret_fns_of(funcs);
    var farf: string[] = f64arr_ret_fns_of(funcs);
    var iarf: string[] = i64arr_ret_fns_of(funcs);
    var out: LoweredFn[] = [];
    var i: i32 = 0;
    while (i < funcs.len()) {
        var r: LowerResult = lower_func(funcs[i], arr_ret_fns, structs, srf, sarf, orf, irf, trf, srtf, frf, farf, iarf, fn_param_sigs_of(funcs), closure_ret_fns_of(funcs), const_fns_of(funcs), borrowable_params_of(funcs));
        out = out.append(LoweredFn { name: funcs[i].name, ok: r.ok, ops: r.ops, n_locals: r.n_locals, n_params: r.n_params, arr_slots: r.arr_slots });
        i = i + 1;
    }
    return out;
}

// find_fn returns the index of `name` in fns, or -1.
pub function find_fn(fns: LoweredFn[], name: string): i32 {
    var i: i32 = 0;
    while (i < fns.len()) {
        if (fns[i].name == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// eval_call evaluates a call to `name` with `args` (recursion-safe via
// eval_ops' fns parameter). A missing / unlowered callee yields 0.
pub function eval_call(fns: LoweredFn[], name: string, args: i32[]): i32 {
    var idx: i32 = find_fn(fns, name);
    if (idx < 0) { return 0; }
    var fn: LoweredFn = fns[idx];
    if (!fn.ok) { return 0; }
    return eval_ops(fn.ops, fn.n_locals, args, fns);
}

// eval_program runs `main` (with no args).
pub function eval_program(fns: LoweredFn[]): i32 {
    var noargs: i32[] = [];
    return eval_call(fns, "main", noargs);
}

// ---- stack-machine interpreter ----------------------------------------
//
// eval_ops runs the lowered op stream on an operand stack + a locals frame,
// returning the value carried by the first `return`. `args` seed the param
// slots. This validates lowering without a backend (the ssa.fern pattern).

function bin_apply(kind: string, l: i32, r: i32): i32 {
    if (kind == "add") { return l + r; }
    if (kind == "sub") { return l - r; }
    if (kind == "mul") { return l * r; }
    if (kind == "div_s") { return l / r; }
    if (kind == "rem_s") { return l - (l / r) * r; }
    if (kind == "and") { return l & r; }
    if (kind == "or") { return l | r; }
    if (kind == "xor") { return l ^ r; }
    if (kind == "shl") { return l << r; }
    if (kind == "shr_s") { return l >> r; }
    if (kind == "eq") { if (l == r) { return 1; } return 0; }
    if (kind == "ne") { if (l != r) { return 1; } return 0; }
    if (kind == "lt_s") { if (l < r) { return 1; } return 0; }
    if (kind == "le_s") { if (l <= r) { return 1; } return 0; }
    if (kind == "gt_s") { if (l > r) { return 1; } return 0; }
    if (kind == "ge_s") { if (l >= r) { return 1; } return 0; }
    return 0;
}

pub function eval_ops(ops: ir.Op[], n_locals: i32, args: i32[], fns: LoweredFn[]): i32 {
    var nloc: i32 = n_locals;
    if (nloc < 1) { nloc = 1; }
    // The self-host source is fully immutable: build the frames by growing
    // append-arrays to size, then write with `arr = arr.with(i, v)` (reads
    // by subscript are fine; only assignment needs .with).
    var locals: i32[] = [];
    var li: i32 = 0;
    while (li < nloc) { locals = locals.append(0); li = li + 1; }
    var ai: i32 = 0;
    while (ai < args.len()) { locals = locals.with(ai, args[ai]); ai = ai + 1; }

    var stack: i32[] = [];
    var si: i32 = 0;
    while (si < 256) { stack = stack.append(0); si = si + 1; }
    var sp: i32 = 0;

    // A simple word-addressed heap for the leak-only bump allocator: a byte
    // address `a` maps to word index a/4. Local to this call (the corpus
    // keeps arrays within the function that creates them). Word 0 (byte
    // address 0) is reserved as the RC over-release (underflow) counter, so
    // the first allocation starts at byte address 4 — no real array uses 0.
    var heap: i32[] = [];
    heap = heap.append(0);
    // Freelist head (0 = null; no real block lives at byte address 0, which
    // is the reserved underflow counter). A free node stores [next@+0,
    // size@+4] in the block's own first two words.
    //
    // NOTE: this heap is per-eval_ops-call, so the interpreter only models
    // arrays that stay within their creating function. Arrays that cross a
    // function boundary (move-on-return) need a shared heap — the x86 backend
    // (global __heap / __freelist) handles them, and move-on-return is
    // validated there + against the AST backend in the differential test.
    var freehead: i32 = 0;

    var pc: i32 = 0;
    while (pc < ops.len()) {
        var o: ir.Op = ops[pc];
        if (o.kind == "const_i32") { stack = stack.with(sp, o.i32_imm); sp = sp + 1; pc = pc + 1; }
        else if (o.kind == "const_i32_text") { stack = stack.with(sp, util.lit_to_i32(o.str)); sp = sp + 1; pc = pc + 1; }
        else if (o.kind == "load_local") { stack = stack.with(sp, locals[o.i32_imm]); sp = sp + 1; pc = pc + 1; }
        else if (o.kind == "store_local") { sp = sp - 1; locals = locals.with(o.i32_imm, stack[sp]); pc = pc + 1; }
        else if (o.kind == "not") { stack = stack.with(sp - 1, bool_not(stack[sp - 1])); pc = pc + 1; }
        else if (o.kind == "return") { sp = sp - 1; return stack[sp]; }
        else if (o.kind == "if") {
            // pop cond: nonzero -> fall into then; zero -> jump to the else
            // body (if any) or past the matching end.
            sp = sp - 1;
            var c: i32 = stack[sp];
            if (c != 0) { pc = pc + 1; }
            else {
                var el: i32 = find_matching_else(ops, pc + 1);
                if (el >= 0) { pc = el + 1; } else { pc = find_matching_end(ops, pc + 1); }
            }
        }
        else if (o.kind == "else") {
            // reached only after executing a then-branch -> skip to end.
            pc = find_matching_end(ops, pc + 1);
        }
        else if (o.kind == "end") { pc = pc + 1; }
        else if (o.kind == "drop") { sp = sp - 1; pc = pc + 1; }
        else if (o.kind == "block") { pc = pc + 1; }
        else if (o.kind == "loop") { pc = pc + 1; }
        else if (o.kind == "br") { pc = do_branch(ops, pc, o.i32_imm); }
        else if (o.kind == "brif") {
            sp = sp - 1;
            var bc: i32 = stack[sp];
            if (bc != 0) { pc = do_branch(ops, pc, o.i32_imm); } else { pc = pc + 1; }
        }
        else if (o.kind == "alloc") {
            // pop size (bytes); reuse an exact-size freed block if one exists,
            // else bump-allocate (growing the heap).
            sp = sp - 1;
            var size: i32 = stack[sp];
            var reuse: i32 = 0;
            var cur: i32 = freehead;
            var prev: i32 = 0;
            while (cur != 0) {
                if (heap[cur / 4 + 1] == size) {
                    var nxt: i32 = heap[cur / 4];
                    if (prev == 0) { freehead = nxt; } else { heap = heap.with(prev / 4, nxt); }
                    reuse = cur;
                    cur = 0;
                } else {
                    prev = cur;
                    cur = heap[cur / 4];
                }
            }
            var ptr: i32 = 0;
            if (reuse != 0) {
                ptr = reuse;
            } else {
                ptr = heap.len() * 4;
                var nw: i32 = size / 4;
                var q: i32 = 0;
                while (q < nw) { heap = heap.append(0); q = q + 1; }
            }
            stack = stack.with(sp, ptr);
            sp = sp + 1;
            pc = pc + 1;
        }
        else if (o.kind == "store") {
            // pop val (top), pop addr; heap[addr/4] = val.
            sp = sp - 1;
            var sval: i32 = stack[sp];
            sp = sp - 1;
            var saddr: i32 = stack[sp];
            heap = heap.with(saddr / 4, sval);
            pc = pc + 1;
        }
        else if (o.kind == "load") {
            sp = sp - 1;
            var laddr: i32 = stack[sp];
            stack = stack.with(sp, heap[laddr / 4]);
            sp = sp + 1;
            pc = pc + 1;
        }
        else if (o.kind == "arr_make") {
            // High-level array make: pop n element values (top = element n-1),
            // allocate the [rc, len, e0..] block (this interpreter's 4-byte
            // model — rc at base-4, len at base, element i at base+4+i*4),
            // init rc=1 + len, fill elements, push the base. The alloc mirrors
            // the `alloc` op: reuse an exact-size freed block or bump-grow.
            var an: i32 = o.i32_imm;
            var asize: i32 = (an + 2) * 4;
            var areuse: i32 = 0;
            var acur: i32 = freehead;
            var aprev: i32 = 0;
            while (acur != 0) {
                if (heap[acur / 4 + 1] == asize) {
                    var anxt: i32 = heap[acur / 4];
                    if (aprev == 0) { freehead = anxt; } else { heap = heap.with(aprev / 4, anxt); }
                    areuse = acur;
                    acur = 0;
                } else {
                    aprev = acur;
                    acur = heap[acur / 4];
                }
            }
            var araw: i32 = 0;
            if (areuse != 0) {
                araw = areuse;
            } else {
                araw = heap.len() * 4;
                var anw: i32 = asize / 4;
                var aq: i32 = 0;
                while (aq < anw) { heap = heap.append(0); aq = aq + 1; }
            }
            var abase: i32 = araw + 4;
            heap = heap.with((abase - 4) / 4, 1);       // rc = 1
            heap = heap.with(abase / 4, an);            // len = n
            var ae: i32 = an - 1;
            while (ae >= 0) {
                sp = sp - 1;
                heap = heap.with((abase + 4 + ae * 4) / 4, stack[sp]);
                ae = ae - 1;
            }
            stack = stack.with(sp, abase);
            sp = sp + 1;
            pc = pc + 1;
        }
        else if (o.kind == "arr_get") {
            // pop idx (top), base; push element at base+4+idx*4.
            sp = sp - 1;
            var gidx: i32 = stack[sp];
            sp = sp - 1;
            var gbase: i32 = stack[sp];
            stack = stack.with(sp, heap[(gbase + 4 + gidx * 4) / 4]);
            sp = sp + 1;
            pc = pc + 1;
        }
        else if (o.kind == "arr_set") {
            // pop val (top), idx, base; store val at base+4+idx*4.
            sp = sp - 1;
            var stval: i32 = stack[sp];
            sp = sp - 1;
            var stidx: i32 = stack[sp];
            sp = sp - 1;
            var stbase: i32 = stack[sp];
            heap = heap.with((stbase + 4 + stidx * 4) / 4, stval);
            pc = pc + 1;
        }
        else if (o.kind == "arr_len") {
            // pop base; push len header at base.
            sp = sp - 1;
            var lbase: i32 = stack[sp];
            stack = stack.with(sp, heap[lbase / 4]);
            sp = sp + 1;
            pc = pc + 1;
        }
        else if (o.kind == "arr_rc") {
            // pop base; push rc header at base-4.
            sp = sp - 1;
            var rbase: i32 = stack[sp];
            stack = stack.with(sp, heap[(rbase - 4) / 4]);
            sp = sp + 1;
            pc = pc + 1;
        }
        else if (o.kind == "call_direct" && o.str == "__fern_rc_inc") {
            // RC retain: inc the refcount header at base-4, return base.
            sp = sp - 1;
            var ib: i32 = stack[sp];
            var ridx: i32 = (ib - 4) / 4;
            heap = heap.with(ridx, heap[ridx] + 1);
            stack = stack.with(sp, ib);
            sp = sp + 1;
            pc = pc + 1;
        }
        else if (o.kind == "call_direct" && o.str == "__fern_rc_dec") {
            // RC release: dec the header at base-4 (no free). A dec of a value
            // already at/below 0 is an over-release -> bump the counter at
            // word 0. A null / sub-heap pointer is skipped (defensive).
            sp = sp - 1;
            var db: i32 = stack[sp];
            if (db >= 8) {
                var dridx: i32 = (db - 4) / 4;
                if (heap[dridx] <= 0) {
                    heap = heap.with(0, heap[0] + 1);
                } else {
                    var newrc: i32 = heap[dridx] - 1;
                    heap = heap.with(dridx, newrc);
                    if (newrc == 0) {
                        // free: push the raw block (db-4) onto the freelist;
                        // size = (len+2)*4 from the length header at [base].
                        var rawblk: i32 = db - 4;
                        var size2: i32 = (heap[db / 4] + 2) * 4;
                        heap = heap.with(rawblk / 4, freehead);
                        heap = heap.with(rawblk / 4 + 1, size2);
                        freehead = rawblk;
                    }
                }
            }
            stack = stack.with(sp, db);
            sp = sp + 1;
            pc = pc + 1;
        }
        else if (o.kind == "call_direct" && o.str == "__fern_rc_underflow_get") {
            stack = stack.with(sp, heap[0]);
            sp = sp + 1;
            pc = pc + 1;
        }
        else if (o.kind == "call_direct" && o.str == "__fern_heap_used") {
            // bytes bump-allocated = heap words * 4 minus the reserved word 0.
            stack = stack.with(sp, heap.len() * 4 - 4);
            sp = sp + 1;
            pc = pc + 1;
        }
        else if (o.kind == "call_direct") {
            // pop argc args (arg0..arg n-1, n-1 on top) preserving order, call
            // the named function, push the result.
            var argc: i32 = o.i32_imm;
            var callargs: i32[] = [];
            var z: i32 = 0;
            while (z < argc) { callargs = callargs.append(0); z = z + 1; }
            var kk: i32 = argc - 1;
            while (kk >= 0) { sp = sp - 1; callargs = callargs.with(kk, stack[sp]); kk = kk - 1; }
            var rv: i32 = eval_call(fns, o.str, callargs);
            stack = stack.with(sp, rv);
            sp = sp + 1;
            pc = pc + 1;
        }
        else {
            // a binary op: pop r, pop l, push apply
            sp = sp - 1;
            var r: i32 = stack[sp];
            sp = sp - 1;
            var l: i32 = stack[sp];
            stack = stack.with(sp, bin_apply(o.kind, l, r));
            sp = sp + 1;
            pc = pc + 1;
        }
    }
    // fell off the end with no return — yield top-of-stack if present, else 0
    if (sp > 0) { return stack[sp - 1]; }
    return 0;
}

function bool_not(x: i32): i32 {
    if (x == 0) { return 1; }
    return 0;
}

// is_opener reports whether an op kind opens a structured scope (if / block
// / loop) — used for the nesting counts below.
function is_opener(k: string): boolean {
    return k == "if" || k == "block" || k == "loop";
}

// find_matching_end returns the index of the `end` closing the structured
// scope whose body begins at `start` (one past the opener), honouring
// nesting across if / block / loop.
pub function find_matching_end(ops: ir.Op[], start: i32): i32 {
    var depth: i32 = 0;
    var i: i32 = start;
    while (i < ops.len()) {
        var k: string = ops[i].kind;
        if (is_opener(k)) { depth = depth + 1; }
        else if (k == "end") {
            if (depth == 0) { return i; }
            depth = depth - 1;
        }
        i = i + 1;
    }
    return ops.len();
}

// find_matching_else returns the index of the `else` for the if whose body
// begins at `start`, or -1 if that if has no else (its scope closes at end).
pub function find_matching_else(ops: ir.Op[], start: i32): i32 {
    var depth: i32 = 0;
    var i: i32 = start;
    while (i < ops.len()) {
        var k: string = ops[i].kind;
        if (is_opener(k)) { depth = depth + 1; }
        else if (k == "end") {
            if (depth == 0) { return 0 - 1; }
            depth = depth - 1;
        }
        else if (k == "else") {
            if (depth == 0) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// enclosing_opener returns the index of the d-th enclosing structured opener
// from `pc` (d=0 is the innermost), scanning backward and skipping
// already-closed inner scopes. The target of a `br d` / `br_if d`.
pub function enclosing_opener(ops: ir.Op[], pc: i32, d: i32): i32 {
    var need: i32 = d;
    var skip: i32 = 0;
    var i: i32 = pc - 1;
    while (i >= 0) {
        var k: string = ops[i].kind;
        if (k == "end") { skip = skip + 1; }
        else if (is_opener(k)) {
            if (skip > 0) { skip = skip - 1; }
            else {
                if (need == 0) { return i; }
                need = need - 1;
            }
        }
        i = i - 1;
    }
    return 0 - 1;
}

// do_branch resolves a `br d` from `pc`: branching to a loop re-enters its
// header (re-evaluating the condition); branching to a block/if jumps past
// its matching end (forward exit).
pub function do_branch(ops: ir.Op[], pc: i32, d: i32): i32 {
    var op: i32 = enclosing_opener(ops, pc, d);
    if (ops[op].kind == "loop") { return op + 1; }
    return find_matching_end(ops, op + 1) + 1;
}

// --- Lambda lifting (closures slice 2a: no-capture lambdas as call arguments) ---
//
// lift_lambdas rewrites a module so that a no-capture lambda passed directly as
// a call argument is hoisted to a fresh top-level function (__lam_<k>) and the
// argument becomes a bare reference to it. That bare reference, at a "fn"-typed
// param position, is exactly the function VALUE that closures slice 1 lowers via
// const_func — so capture-free lambdas-as-callbacks ride the slice-1 machinery
// with no new IR ops. Capturing lambdas (and lambdas in positions this bounded
// walk doesn't reach) are left as ExprLambda, so the module falls back to the
// AST backend. A module with no lifted lambda is returned UNCHANGED (so the
// lambda-free fixpoint is byte-identical).

pub struct LiftAcc { funcs: parser.FuncDecl[], counter: i32 }
struct LiftExpr { expr: parser.Expr, acc: LiftAcc }
struct LiftStmts { stmts: parser.Stmt[], acc: LiftAcc }

// lambda_has_no_captures: every identifier the body uses must be one of the
// lambda's params, a local it binds, a global function, or a literal keyword —
// nothing from the enclosing scope. (A conservative check: a false "captures"
// only costs a fallback to AST, never correctness.)
function lambda_has_no_captures(lam: parser.ExprLambda, gfns: string[]): boolean {
    var used: string[] = [];
    var si: i32 = 0;
    while (si < lam.body.len()) { used = astwalk.collect_idents_stmt(lam.body[si], used); si = si + 1; }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lam.params.len()) { bound = bound.append(lam.params[pi].name); pi = pi + 1; }
    var bi: i32 = 0;
    while (bi < lam.body.len()) { bound = astwalk.collect_bound_stmt(lam.body[bi], bound); bi = bi + 1; }
    var ui: i32 = 0;
    while (ui < used.len()) {
        var u: string = used[ui];
        if (util.index_of_str(bound, u) < 0 && util.index_of_str(gfns, u) < 0
                && u != "None" && u != "true" && u != "false") {
            return false;
        }
        ui = ui + 1;
    }
    return true;
}

// lift_call_arg lifts one call argument: a no-capture lambda becomes __lam_<k>
// and the argument a bare reference to it; any other argument recurses (so a
// lambda nested inside a call argument is still reached).
function lift_call_arg(e: parser.Expr, acc: LiftAcc, gfns: string[]): LiftExpr {
    match (e) {
        parser.ExprLambda(lam) => {
            if (lambda_has_no_captures(lam, gfns)) {
                var nm: string = "__lam_" + util.i32_to_string(acc.counter);
                var tp: string[] = [];
                var nf: parser.FuncDecl = parser.FuncDecl { name: nm, receiver_name: "", receiver_type: "", type_params: tp, params: lam.params, ret_type: lam.ret_type, body: lam.body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0 };
                var nacc: LiftAcc = LiftAcc { funcs: acc.funcs.append(nf), counter: acc.counter + 1 };
                return LiftExpr { expr: parser.ExprIdent { name: nm, line: 0, col: 0 }, acc: nacc };
            }
            return LiftExpr { expr: e, acc: acc };
        },
        _ => { return lift_expr_walk(e, acc, gfns); }
    }
    return LiftExpr { expr: e, acc: acc };
}

// lift_expr_walk recurses through the expression forms that commonly hold calls,
// rewriting lambda arguments. Unhandled forms pass through unchanged.
function lift_expr_walk(e: parser.Expr, acc: LiftAcc, gfns: string[]): LiftExpr {
    match (e) {
        parser.ExprCall(c) => {
            var a: LiftAcc = acc;
            // Lift the CALLEE too: a no-capture lambda in call position — an IIFE
            // `(function(b){...})(args)` — hoists to a bare `__lam_N` fn-name, so
            // the call becomes a direct `__lam_N(args)`. lift_call_arg recurses for
            // a non-lambda callee (ident / `mk()` / etc.), leaving it unchanged, so
            // a normal call's numbering is untouched (an ident callee consumes no
            // counter). A capturing lambda callee is left in place (stays on AST).
            var ce: LiftExpr = lift_call_arg(c.callee, a, gfns);
            a = ce.acc;
            var nargs: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) {
                var r: LiftExpr = lift_call_arg(c.args[i], a, gfns);
                a = r.acc;
                nargs = nargs.append(r.expr);
                i = i + 1;
            }
            return LiftExpr { expr: parser.ExprCall { callee: ce.expr, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc }, acc: a };
        },
        // A no-capture lambda in a TUPLE-element position (`(function(x){...}, 10)`)
        // hoists the same way — lift_call_arg turns it into a bare `__lam_N` fn-name
        // (which lowers to a fn pointer), so `t.0(t.1)` rides the existing
        // tuple-element fn-value call_indirect path. A capturing lambda element is
        // left in place (stays on AST).
        parser.ExprTuple(tu) => {
            var ta: LiftAcc = acc;
            var nte: parser.Expr[] = [];
            var ti: i32 = 0;
            while (ti < tu.elements.len()) {
                var ter: LiftExpr = lift_call_arg(tu.elements[ti], ta, gfns);
                ta = ter.acc;
                nte = nte.append(ter.expr);
                ti = ti + 1;
            }
            return LiftExpr { expr: parser.ExprTuple { elements: nte }, acc: ta };
        },
        // An array literal of NO-CAPTURE lambdas (`var fs = [function(x){...}, ...]`):
        // hoist each lambda element to a top-level `__lam_N` (the same lift a
        // no-capture lambda ARGUMENT gets), so the array becomes one of bare
        // function-name idents -- which lower to a function-pointer array, and
        // `fs[i](args)` rides the existing fn-pointer-array call_indirect path.
        // A capturing lambda element is returned unchanged by lift_call_arg and
        // keeps the module on the AST path.
        parser.ExprArray(arr) => {
            var aa: LiftAcc = acc;
            var nelems: parser.Expr[] = [];
            var ei: i32 = 0;
            while (ei < arr.elements.len()) {
                var er: LiftExpr = lift_call_arg(arr.elements[ei], aa, gfns);
                aa = er.acc;
                nelems = nelems.append(er.expr);
                ei = ei + 1;
            }
            return LiftExpr { expr: parser.ExprArray { elements: nelems }, acc: aa };
        },
        // A no-capture lambda in a STRUCT-FIELD value position (`Box { f:
        // function(x){...} }`) hoists the same way — lift_call_arg turns it into
        // a bare `__lam_N` fn-name (which lowers to const_func, like `Box { f:
        // inc }`). A capturing lambda field is left in place (stays on AST).
        parser.ExprStructLit(sl) => {
            var sa: LiftAcc = acc;
            var nvals: parser.Expr[] = [];
            var vi: i32 = 0;
            while (vi < sl.field_values.len()) {
                var vr: LiftExpr = lift_call_arg(sl.field_values[vi], sa, gfns);
                sa = vr.acc;
                nvals = nvals.append(vr.expr);
                vi = vi + 1;
            }
            var nbase: parser.Expr = sl.base;
            if (sl.has_base) {
                var br: LiftExpr = lift_expr_walk(sl.base, sa, gfns);
                sa = br.acc;
                nbase = br.expr;
            }
            return LiftExpr { expr: parser.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nvals, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col }, acc: sa };
        },
        // Recurse into the compound expression forms so a no-capture lambda CALL
        // nested inside them is still hoisted: `(function(x){...})(5) + 1` (binary),
        // `0 - (function(){...})()` (unary), `a[(function(){...})()]` (index). The
        // operands rarely hold a BARE lambda (that wouldn't type-check), so these
        // recurse via lift_expr_walk (which lifts an IIFE callee / a lambda call
        // argument inside), not lift_call_arg. An operand with nothing to lift is
        // rebuilt identically (the counter is untouched), so existing programs are
        // unchanged.
        parser.ExprBinary(b) => {
            var blr: LiftExpr = lift_expr_walk(b.left, acc, gfns);
            var brr: LiftExpr = lift_expr_walk(b.right, blr.acc, gfns);
            return LiftExpr { expr: parser.ExprBinary { op: b.op, left: blr.expr, right: brr.expr, line: b.line, col: b.col }, acc: brr.acc };
        },
        parser.ExprUnary(u) => {
            var uor: LiftExpr = lift_expr_walk(u.operand, acc, gfns);
            return LiftExpr { expr: parser.ExprUnary { op: u.op, operand: uor.expr, line: u.line, col: u.col }, acc: uor.acc };
        },
        parser.ExprIndex(ix) => {
            var ixar: LiftExpr = lift_expr_walk(ix.array, acc, gfns);
            var ixir: LiftExpr = lift_expr_walk(ix.index, ixar.acc, gfns);
            return LiftExpr { expr: parser.ExprIndex { array: ixar.expr, index: ixir.expr }, acc: ixir.acc };
        },
        // Slice bounds + the field-access object can also hold a nested lambda CALL
        // (`a[(iife)(0) : 3]`, `arr[(iife)(0)].v`); recurse so it is hoisted too.
        parser.ExprSlice(sl) => {
            var slar: LiftExpr = lift_expr_walk(sl.array, acc, gfns);
            var slsr: LiftExpr = lift_expr_walk(sl.start, slar.acc, gfns);
            var sler: LiftExpr = lift_expr_walk(sl.end, slsr.acc, gfns);
            return LiftExpr { expr: parser.ExprSlice { array: slar.expr, start: slsr.expr, end: sler.expr }, acc: sler.acc };
        },
        parser.ExprFieldAccess(fa) => {
            var faor: LiftExpr = lift_expr_walk(fa.obj, acc, gfns);
            return LiftExpr { expr: parser.ExprFieldAccess { obj: faor.expr, field: fa.field, line: fa.line, col: fa.col }, acc: faor.acc };
        },
        _ => { return LiftExpr { expr: e, acc: acc }; }
    }
    return LiftExpr { expr: e, acc: acc };
}

// lift_stmt rewrites a single statement, recursing into nested bodies + the
// call-bearing expression positions (return / var-init / expr-stmt / control
// conditions). Other statements pass through.
//
// NOTE: each rebuilt statement is bound to a `var ns: parser.Stmt` before being
// placed in the returned `[ns]` array. Constructing the variant INLINE in the
// array literal (`stmts: [parser.StmtReturn { … }]`) used to read back corrupt:
// the checker did not propagate the Stmt-union element type into an array
// literal in a struct-field position, so the inline variant lowered WITHOUT its
// discriminant tag and the whole lifted module silently bailed IR eligibility to
// AST. That checker bug is now fixed (internal/checker StructLit field
// setElemHintFor; e2e TestInlineEnumVariantInStructArrayField); the typed `var`
// binding is retained as a robust, self-documenting way to express the move.
function lift_stmt(st: parser.Stmt, acc: LiftAcc, gfns: string[]): LiftStmts {
    match (st) {
        parser.StmtReturn(r) => {
            // `return function(x){...}` of a NO-CAPTURE lambda hoists to a
            // top-level `__lam_N` (via lift_call_arg, the same lift a no-capture
            // lambda argument / array element / struct-field value gets), so the
            // return becomes a bare fn-name -> const_func, riding the existing
            // "return a named function value" path. A capturing lambda is left in
            // place (keeps the module on the AST path); a non-lambda value recurses
            // through lift_expr_walk unchanged.
            var e: LiftExpr = lift_call_arg(r.value, acc, gfns);
            var ns: parser.Stmt = parser.StmtReturn { value: e.expr, line: r.line, col: r.col };
            return LiftStmts { stmts: [ns], acc: e.acc };
        },
        parser.StmtVar(v) => {
            var e: LiftExpr = lift_expr_walk(v.init, acc, gfns);
            var ns: parser.Stmt = parser.StmtVar { name: v.name, type_name: v.type_name, init: e.expr, line: v.line, col: v.col };
            return LiftStmts { stmts: [ns], acc: e.acc };
        },
        parser.StmtExpr(s) => {
            var e: LiftExpr = lift_expr_walk(s.value, acc, gfns);
            var ns: parser.Stmt = parser.StmtExpr { value: e.expr };
            return LiftStmts { stmts: [ns], acc: e.acc };
        },
        // `f = function(x){...}` of a NO-CAPTURE lambda hoists to `f = __lam_N`
        // (via lift_call_arg, like the StmtReturn case) — a bare fn-name the assign
        // lowers as a fn-pointer store. A capturing lambda RHS is left in place
        // (stays on AST); a non-lambda RHS recurses through lift_expr_walk.
        parser.StmtAssign(asg) => {
            var e: LiftExpr = lift_call_arg(asg.value, acc, gfns);
            var ns: parser.Stmt = parser.StmtAssign { target: asg.target, value: e.expr, line: asg.line, col: asg.col, target_line: asg.target_line, target_col: asg.target_col };
            return LiftStmts { stmts: [ns], acc: e.acc };
        },
        parser.StmtIf(f) => {
            var ce: LiftExpr = lift_expr_walk(f.cond, acc, gfns);
            var tb: LiftStmts = lift_stmts(f.then_body, ce.acc, gfns);
            var eb: LiftStmts = lift_stmts(f.else_body, tb.acc, gfns);
            var ns: parser.Stmt = parser.StmtIf { cond: ce.expr, then_body: tb.stmts, else_body: eb.stmts };
            return LiftStmts { stmts: [ns], acc: eb.acc };
        },
        parser.StmtWhile(w) => {
            var ce: LiftExpr = lift_expr_walk(w.cond, acc, gfns);
            var b: LiftStmts = lift_stmts(w.body, ce.acc, gfns);
            var ns: parser.Stmt = parser.StmtWhile { cond: ce.expr, body: b.stmts };
            return LiftStmts { stmts: [ns], acc: b.acc };
        },
        parser.StmtFor(fo) => {
            var ie: LiftExpr = lift_expr_walk(fo.iter, acc, gfns);
            var b: LiftStmts = lift_stmts(fo.body, ie.acc, gfns);
            var ns: parser.Stmt = parser.StmtFor { var_name: fo.var_name, iter: ie.expr, body: b.stmts };
            return LiftStmts { stmts: [ns], acc: b.acc };
        },
        _ => { return LiftStmts { stmts: [st], acc: acc }; }
    }
    return LiftStmts { stmts: [st], acc: acc };
}

function lift_stmts(stmts: parser.Stmt[], acc: LiftAcc, gfns: string[]): LiftStmts {
    var a: LiftAcc = acc;
    var out: parser.Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        var r: LiftStmts = lift_stmt(stmts[i], a, gfns);
        a = r.acc;
        var j: i32 = 0;
        while (j < r.stmts.len()) { out = out.append(r.stmts[j]); j = j + 1; }
        i = i + 1;
    }
    return LiftStmts { stmts: out, acc: a };
}

// --- Capturing lambdas via classic lambda-lifting (closures slice 2c) ---
//
// A capturing lambda bound to a local and used ONLY as a direct call —
// `var f = function(x){ … base … }; … f(a) … f(b) …` — needs no closure box:
// hoist it to __lam_<k>(origparams…, captures…) and rewrite each `f(args)` to
// `__lam_<k>(args…, captures…)`, threading the captured values as ordinary
// arguments. Pure AST rewrite: the lifted body is unchanged (its free vars are
// now same-named params), and the existing direct-call IR path lowers the
// result on every backend. Declines (leaving ExprLambda → AST) when a capture's
// type can't be resolved, a capture (or f) is reassigned, or f escapes as a
// value — first-class capturing closures (box + env) are a later slice.

// lambda_captures returns the lambda's free variables (its captures): every used
// identifier that is not a param, a local it binds, a global function, or a
// literal keyword. Deduped, first-seen order.
// closure_captures returns the lambda's captures during lowering: free
// identifiers (used minus params minus locally-bound) that resolve to a local
// SLOT in the enclosing function. First-seen order, deduped — matching
// hoist_escaping_closure's lambda_captures order so cap[i] lines up with the
// env box's slot 1+i.
function closure_captures(lam: parser.ExprLambda, s: LowerState): string[] {
    var used: string[] = [];
    var si: i32 = 0;
    while (si < lam.body.len()) { used = astwalk.collect_idents_stmt(lam.body[si], used); si = si + 1; }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lam.params.len()) { bound = bound.append(lam.params[pi].name); pi = pi + 1; }
    var bi: i32 = 0;
    while (bi < lam.body.len()) { bound = astwalk.collect_bound_stmt(lam.body[bi], bound); bi = bi + 1; }
    var caps: string[] = [];
    var ui: i32 = 0;
    while (ui < used.len()) {
        var u: string = used[ui];
        if (util.index_of_str(bound, u) < 0 && util.index_of_str(caps, u) < 0 && s.slot_of(u) >= 0) {
            caps = caps.append(u);
        }
        ui = ui + 1;
    }
    return caps;
}

function lambda_captures(lam: parser.ExprLambda, gfns: string[]): string[] {
    var used: string[] = [];
    var si: i32 = 0;
    while (si < lam.body.len()) { used = astwalk.collect_idents_stmt(lam.body[si], used); si = si + 1; }
    var bound: string[] = [];
    var pi: i32 = 0;
    while (pi < lam.params.len()) { bound = bound.append(lam.params[pi].name); pi = pi + 1; }
    var bi: i32 = 0;
    while (bi < lam.body.len()) { bound = astwalk.collect_bound_stmt(lam.body[bi], bound); bi = bi + 1; }
    var caps: string[] = [];
    var ui: i32 = 0;
    while (ui < used.len()) {
        var u: string = used[ui];
        if (util.index_of_str(bound, u) < 0 && util.index_of_str(gfns, u) < 0
                && u != "None" && u != "true" && u != "false"
                && util.index_of_str(caps, u) < 0) {
            caps = caps.append(u);
        }
        ui = ui + 1;
    }
    return caps;
}

// lit_init_type infers a capture's type from a literal-shaped initializer:
// scalar literals (i32 / string / boolean — float declines, matching the old
// scalar behaviour), array literals (element type from the first element, so
// `[1,2,3]` is `i32[]` and `["a"]` is `string[]`), and struct literals (their
// named type). "" when it can't infer — the caller then declines the lift,
// leaving the closure on the AST path. Pure AST analysis: the inferred type
// only labels the lifted function's capture PARAM, so an unannotated
// array/struct capture flows exactly like the already-supported annotated /
// param-typed array capture (passed by value as an ordinary argument — no env
// box, no RC). Keeps cap_type small (#2720 oversized-function guard).
function lit_init_type(e: parser.Expr): string {
    match (e) {
        parser.ExprNumber(num) => { if (num.is_float) { return ""; } return "i32"; },
        parser.ExprString(_) => { return "string"; },
        parser.ExprBool(_) => { return "boolean"; },
        parser.ExprArray(a) => {
            if (a.elements.len() == 0) { return ""; }
            var et: string = lit_init_type(a.elements[0]);
            if (et.len() == 0) { return ""; }
            return et + "[]";
        },
        parser.ExprStructLit(sl) => {
            if (sl.type_name.len() == 0) { return ""; }
            return sl.type_name;
        },
        _ => { return ""; }
    }
    return "";
}

// cap_type resolves a captured variable's type from the enclosing function: a
// param type, an annotated `var c: T`, or a literal-initialised `var c = <lit>`
// (scalar, array, or struct literal — see lit_init_type). "" when it can't (the
// caller then declines the lift). Mirrors ssa.resolve_capture_type.
function cap_type(name: string, fd: parser.FuncDecl): string {
    var pi: i32 = 0;
    while (pi < fd.params.len()) {
        if (fd.params[pi].name == name) { return fd.params[pi].type_name; }
        pi = pi + 1;
    }
    var si: i32 = 0;
    while (si < fd.body.len()) {
        match (fd.body[si]) {
            parser.StmtVar(v) => {
                if (v.name == name) {
                    if (v.type_name.len() > 0) { return v.type_name; }
                    return lit_init_type(v.init);
                }
            },
            _ => { }
        }
        si = si + 1;
    }
    return "";
}

// body_assign_targets collects the names reassigned (`x = …`) anywhere in a body
// (recursing control flow + match arms). Used to decline lifting when a capture
// — or the closure local — is mutated, so the lifted call-time argument always
// equals the capture's value at the lambda's definition.
function body_assign_targets(stmts: parser.Stmt[]): string[] {
    var out: string[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtAssign(a) => { out = out.append(a.target); },
            parser.StmtIf(f) => {
                out = append_all(out, body_assign_targets(f.then_body));
                out = append_all(out, body_assign_targets(f.else_body));
            },
            parser.StmtWhile(w) => { out = append_all(out, body_assign_targets(w.body)); },
            parser.StmtFor(fr) => { out = append_all(out, body_assign_targets(fr.body)); },
            parser.StmtMatch(m) => {
                var ai: i32 = 0;
                while (ai < m.arms.len()) { out = append_all(out, body_assign_targets(m.arms[ai].body)); ai = ai + 1; }
            },
            _ => { }
        }
        i = i + 1;
    }
    return out;
}

function append_all(dst: string[], src: string[]): string[] {
    var i: i32 = 0;
    while (i < src.len()) { dst = dst.append(src[i]); i = i + 1; }
    return dst;
}

// subst_fcall_expr rewrites every direct call `fname(args)` to
// `lname(args, capargs…)`, recursing through the call-bearing expression forms.
// Calls only — a bare `fname` used as a value is left in place and caught by the
// caller's post-rewrite check.
function subst_fcall_expr(e: parser.Expr, fname: string, lname: string, capargs: parser.Expr[]): parser.Expr {
    match (e) {
        parser.ExprCall(c) => {
            var nargs: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) { nargs = nargs.append(subst_fcall_expr(c.args[i], fname, lname, capargs)); i = i + 1; }
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == fname) {
                        var ca: i32 = 0;
                        while (ca < capargs.len()) { nargs = nargs.append(capargs[ca]); ca = ca + 1; }
                        var lc: parser.Expr = parser.ExprIdent { name: lname, line: 0, col: 0 };
                        return parser.ExprCall { callee: lc, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc };
                    }
                },
                _ => { }
            }
            var rc: parser.Expr = subst_fcall_expr(c.callee, fname, lname, capargs);
            return parser.ExprCall { callee: rc, args: nargs, line: c.line, col: c.col, type_argc: c.type_argc };
        },
        parser.ExprBinary(b) => {
            return parser.ExprBinary { op: b.op, left: subst_fcall_expr(b.left, fname, lname, capargs), right: subst_fcall_expr(b.right, fname, lname, capargs), line: b.line, col: b.col };
        },
        parser.ExprUnary(u) => {
            return parser.ExprUnary { op: u.op, operand: subst_fcall_expr(u.operand, fname, lname, capargs), line: u.line, col: u.col };
        },
        parser.ExprIndex(ix) => {
            return parser.ExprIndex { array: subst_fcall_expr(ix.array, fname, lname, capargs), index: subst_fcall_expr(ix.index, fname, lname, capargs) };
        },
        parser.ExprFieldAccess(fa) => {
            return parser.ExprFieldAccess { obj: subst_fcall_expr(fa.obj, fname, lname, capargs), field: fa.field, line: fa.line, col: fa.col };
        },
        _ => { return e; }
    }
    return e;
}

function subst_fcall_stmts(stmts: parser.Stmt[], fname: string, lname: string, capargs: parser.Expr[]): parser.Stmt[] {
    var out: parser.Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) {
        match (stmts[i]) {
            parser.StmtReturn(r) => { var ns: parser.Stmt = parser.StmtReturn { value: subst_fcall_expr(r.value, fname, lname, capargs), line: r.line, col: r.col }; out = out.append(ns); },
            parser.StmtVar(v) => { var ns: parser.Stmt = parser.StmtVar { name: v.name, type_name: v.type_name, init: subst_fcall_expr(v.init, fname, lname, capargs), line: v.line, col: v.col }; out = out.append(ns); },
            parser.StmtExpr(s) => { var ns: parser.Stmt = parser.StmtExpr { value: subst_fcall_expr(s.value, fname, lname, capargs) }; out = out.append(ns); },
            parser.StmtAssign(a) => { var ns: parser.Stmt = parser.StmtAssign { target: a.target, value: subst_fcall_expr(a.value, fname, lname, capargs), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col }; out = out.append(ns); },
            parser.StmtIf(f) => { var ns: parser.Stmt = parser.StmtIf { cond: subst_fcall_expr(f.cond, fname, lname, capargs), then_body: subst_fcall_stmts(f.then_body, fname, lname, capargs), else_body: subst_fcall_stmts(f.else_body, fname, lname, capargs) }; out = out.append(ns); },
            parser.StmtWhile(w) => { var ns: parser.Stmt = parser.StmtWhile { cond: subst_fcall_expr(w.cond, fname, lname, capargs), body: subst_fcall_stmts(w.body, fname, lname, capargs) }; out = out.append(ns); },
            parser.StmtFor(fr) => { var ns: parser.Stmt = parser.StmtFor { var_name: fr.var_name, iter: subst_fcall_expr(fr.iter, fname, lname, capargs), body: subst_fcall_stmts(fr.body, fname, lname, capargs) }; out = out.append(ns); },
            _ => { out = out.append(stmts[i]); }
        }
        i = i + 1;
    }
    return out;
}

struct ClosureLift { body: parser.Stmt[], acc: LiftAcc, changed: boolean }

// try_lift_binding attempts to lift the capturing lambda bound at body[idx] to
// fname. Returns changed=true with the rewritten body + appended lifted fn when
// every guard holds, else the inputs unchanged.
function try_lift_binding(body: parser.Stmt[], idx: i32, fname: string, lam: parser.ExprLambda, fd: parser.FuncDecl, acc: LiftAcc, gfns: string[], assigns: string[]): ClosureLift {
    var caps: string[] = lambda_captures(lam, gfns);
    // A capture-FREE lambda binding (`var f = function(x){…}; f(a)`) is lifted
    // the same way, with no capture args — `f(a)` becomes a direct call to the
    // hoisted `__lam_N(a)`. (Previously declined here, so it fell through to the
    // first-class-closure lowering, which emits const_func(<fn>$clo) with no
    // such hoisted body and bailed the module to the AST emitter.) The
    // fname-not-used-as-a-value guard below still applies, so a lambda that
    // escapes (passed/returned/reassigned) declines and keeps the box path.
    if (util.index_of_str(assigns, fname) >= 0) { return ClosureLift { body: body, acc: acc, changed: false }; }
    var ctypes: string[] = [];
    var ci: i32 = 0;
    while (ci < caps.len()) {
        var t: string = cap_type(caps[ci], fd);
        if (t.len() == 0 || util.index_of_str(assigns, caps[ci]) >= 0) { return ClosureLift { body: body, acc: acc, changed: false }; }
        ctypes = ctypes.append(t);
        ci = ci + 1;
    }
    var lparams: parser.ParamDecl[] = [];
    var pj: i32 = 0;
    while (pj < lam.params.len()) { lparams = lparams.append(lam.params[pj]); pj = pj + 1; }
    var cj: i32 = 0;
    while (cj < caps.len()) { lparams = lparams.append(parser.ParamDecl { name: caps[cj], type_name: ctypes[cj], own: false, has_default: false, default_value: parser.e_unknown("") }); cj = cj + 1; }
    var lname: string = "__lam_" + util.i32_to_string(acc.counter);
    var notp: string[] = [];
    var newfn: parser.FuncDecl = parser.FuncDecl { name: lname, receiver_name: "", receiver_type: "", type_params: notp, params: lparams, ret_type: lam.ret_type, body: lam.body, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0 };
    var capargs: parser.Expr[] = [];
    var ca: i32 = 0;
    while (ca < caps.len()) { capargs = capargs.append(parser.ExprIdent { name: caps[ca], line: 0, col: 0 }); ca = ca + 1; }
    var rest: parser.Stmt[] = [];
    var ri: i32 = idx + 1;
    while (ri < body.len()) { rest = rest.append(body[ri]); ri = ri + 1; }
    var subst_rest: parser.Stmt[] = subst_fcall_stmts(rest, fname, lname, capargs);
    var newbody: parser.Stmt[] = [];
    var ki: i32 = 0;
    while (ki < idx) { newbody = newbody.append(body[ki]); ki = ki + 1; }
    var sj: i32 = 0;
    while (sj < subst_rest.len()) { newbody = newbody.append(subst_rest[sj]); sj = sj + 1; }
    var allids: string[] = [];
    var aj: i32 = 0;
    while (aj < newbody.len()) { allids = astwalk.collect_idents_stmt(newbody[aj], allids); aj = aj + 1; }
    if (util.index_of_str(allids, fname) >= 0) { return ClosureLift { body: body, acc: acc, changed: false }; }
    var nacc: LiftAcc = LiftAcc { funcs: acc.funcs.append(newfn), counter: acc.counter + 1 };
    return ClosureLift { body: newbody, acc: nacc, changed: true };
}

// closure_lift_one lifts the FIRST liftable capturing-lambda binding in body
// (top-level statements). The caller loops until no change.
function closure_lift_one(body: parser.Stmt[], fd: parser.FuncDecl, acc: LiftAcc, gfns: string[]): ClosureLift {
    var assigns: string[] = body_assign_targets(body);
    var i: i32 = 0;
    while (i < body.len()) {
        match (body[i]) {
            parser.StmtVar(v) => {
                match (v.init) {
                    parser.ExprLambda(lam) => {
                        // Both capturing and capture-free lambda bindings lift to
                        // a hoisted top-level function + direct call sites (the
                        // capture-free case carries no capture args). try_lift_
                        // binding declines (keeping the closure-box / AST path) if
                        // the binding escapes — used as a value, returned, or
                        // reassigned — rather than only called.
                        var lifted: ClosureLift = try_lift_binding(body, i, v.name, lam, fd, acc, gfns, assigns);
                        if (lifted.changed) { return lifted; }
                    },
                    _ => { }
                }
            },
            _ => { }
        }
        i = i + 1;
    }
    return ClosureLift { body: body, acc: acc, changed: false };
}

struct HoistResult { func: parser.FuncDecl, ok: boolean }

// hoist_escaping_closure handles a function whose body ends in
// `return <capturing lambda>` — a first-class closure (slice 3a). It hoists the
// lambda body to `<fd>$clo(__env: i32[], origparams…)` with each i32 capture read
// from the env box prepended (`var cap_i: i32 = __env[1+i]`; box slot 0 is the
// funcval, caps follow). The lambda STAYS at the return site — irlower lowers it
// to a make_closure box (const_func(<fd>$clo) + caps → i32[]). Captures must all
// be i32 (the box is an i32[]); otherwise declines (the module bails to AST).
function hoist_escaping_closure(fd: parser.FuncDecl, gfns: string[]): HoistResult {
    var none: parser.FuncDecl = fd;
    if (fd.body.len() == 0) { return HoistResult { func: none, ok: false }; }
    match (fd.body[fd.body.len() - 1]) {
        parser.StmtReturn(r) => {
            match (r.value) {
                parser.ExprLambda(lam) => {
                    var caps: string[] = lambda_captures(lam, gfns);
                    if (caps.len() == 0) { return HoistResult { func: none, ok: false }; }
                    var ci: i32 = 0;
                    while (ci < caps.len()) {
                        if (cap_type(caps[ci], fd) != "i32") { return HoistResult { func: none, ok: false }; }
                        ci = ci + 1;
                    }
                    // params = __env first, then the lambda's declared params.
                    var ps: parser.ParamDecl[] = [parser.ParamDecl { name: "__env", type_name: "i32[]", own: false, has_default: false, default_value: parser.e_unknown("") }];
                    var pj: i32 = 0;
                    while (pj < lam.params.len()) { ps = ps.append(lam.params[pj]); pj = pj + 1; }
                    // body = capture reads (var cap = __env[1+i]) then the lambda body.
                    var bd: parser.Stmt[] = [];
                    var cj: i32 = 0;
                    while (cj < caps.len()) {
                        var idx: parser.Expr = parser.ExprIndex { array: parser.ExprIdent { name: "__env", line: 0, col: 0 }, index: parser.ExprNumber { text: util.i32_to_string(1 + cj), suffix: "", is_float: false, line: 0, col: 0 } };
                        bd = bd.append(parser.StmtVar { name: caps[cj], type_name: "i32", init: idx, line: 0, col: 0 });
                        cj = cj + 1;
                    }
                    var bk: i32 = 0;
                    while (bk < lam.body.len()) { bd = bd.append(lam.body[bk]); bk = bk + 1; }
                    var notp: string[] = [];
                    var clo: parser.FuncDecl = parser.FuncDecl { name: fd.name + "$clo", receiver_name: "", receiver_type: "", type_params: notp, params: ps, ret_type: lam.ret_type, body: bd, line: 0, col: 0, import_iface: "", import_wit: "", type_param_count: 0 };
                    return HoistResult { func: clo, ok: true };
                },
                _ => { return HoistResult { func: none, ok: false }; }
            }
        },
        _ => { return HoistResult { func: none, ok: false }; }
    }
    return HoistResult { func: none, ok: false };
}

// ---- mutable scalar captures (boxing, #2850) ---------------------------
//
// A closure that WRITES a captured outer scalar (`var x = 0; f = fn(){ x = x+1 }`)
// must share the write with the enclosing scope (scalar captures are mutable
// by-reference — the closures-as-counters feature). The IR path captures by
// VALUE (the env box holds the capture's value), so the write is lost. Fix:
// before lifting, rewrite each captured-AND-mutated i32/boolean local into a
// 1-element array CELL, so the existing array-pointer capture is by-reference:
//   var x = E         ->  var x: i32[] = [E]
//   <read x>          ->  x[0]
//   x = v             ->  x = x.with(0, v)        (in-place arr_set on the cell)
// The lambda then captures the cell pointer (cap_type sees `i32[]`,
// try_lift_binding passes the pointer); its in-place `.with` mutates the shared
// cell. Only i32/boolean captures box (i32[] cell); f64 / non-scalar are left.

// box_rewrite_expr rewrites every READ of a boxed var `x` to `x[0]`, recursing
// all expression forms (including into lambda bodies). The decl name and assign
// target are handled by box_rewrite_stmt, not here.
function box_rewrite_expr(e: parser.Expr, boxed: string[]): parser.Expr {
    match (e) {
        parser.ExprIdent(id) => {
            if (util.index_of_str(boxed, id.name) >= 0) {
                return parser.ExprIndex { array: parser.ExprIdent { name: id.name, line: id.line, col: id.col }, index: parser.ExprNumber { text: "0", suffix: "", is_float: false, line: id.line, col: id.col } };
            }
            return e;
        },
        parser.ExprBinary(b) => { return parser.ExprBinary { op: b.op, left: box_rewrite_expr(b.left, boxed), right: box_rewrite_expr(b.right, boxed), line: b.line, col: b.col }; },
        parser.ExprUnary(u) => { return parser.ExprUnary { op: u.op, operand: box_rewrite_expr(u.operand, boxed), line: u.line, col: u.col }; },
        parser.ExprCall(c) => {
            var nargs: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < c.args.len()) { nargs = nargs.append(box_rewrite_expr(c.args[i], boxed)); i = i + 1; }
            return parser.ExprCall { callee: box_rewrite_expr(c.callee, boxed), args: nargs, line: c.line, col: c.col, type_argc: c.type_argc };
        },
        parser.ExprArray(a) => {
            var ne: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < a.elements.len()) { ne = ne.append(box_rewrite_expr(a.elements[i], boxed)); i = i + 1; }
            return parser.ExprArray { elements: ne };
        },
        parser.ExprTuple(t) => {
            var ne: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < t.elements.len()) { ne = ne.append(box_rewrite_expr(t.elements[i], boxed)); i = i + 1; }
            return parser.ExprTuple { elements: ne };
        },
        parser.ExprIndex(x) => { return parser.ExprIndex { array: box_rewrite_expr(x.array, boxed), index: box_rewrite_expr(x.index, boxed) }; },
        parser.ExprSlice(sl) => { return parser.ExprSlice { array: box_rewrite_expr(sl.array, boxed), start: box_rewrite_expr(sl.start, boxed), end: box_rewrite_expr(sl.end, boxed) }; },
        parser.ExprStructLit(sl) => {
            var nv: parser.Expr[] = [];
            var i: i32 = 0;
            while (i < sl.field_values.len()) { nv = nv.append(box_rewrite_expr(sl.field_values[i], boxed)); i = i + 1; }
            var nbase: parser.Expr = sl.base;
            if (sl.has_base) { nbase = box_rewrite_expr(sl.base, boxed); }
            return parser.ExprStructLit { type_name: sl.type_name, field_names: sl.field_names, field_values: nv, has_base: sl.has_base, base: nbase, line: sl.line, col: sl.col };
        },
        parser.ExprFieldAccess(fa) => { return parser.ExprFieldAccess { obj: box_rewrite_expr(fa.obj, boxed), field: fa.field, line: fa.line, col: fa.col }; },
        parser.ExprLambda(lm) => { return parser.ExprLambda { params: lm.params, ret_type: lm.ret_type, body: box_rewrite_stmts(lm.body, boxed) }; },
        _ => { return e; }
    }
    return e;
}

// box_rewrite_stmt rewrites one statement: a boxed var's decl wraps its init in
// a cell, a boxed assign becomes an in-place `.with`, everything else recurses.
function box_rewrite_stmt(st: parser.Stmt, boxed: string[]): parser.Stmt {
    match (st) {
        parser.StmtVar(v) => {
            if (util.index_of_str(boxed, v.name) >= 0) {
                var cell: parser.Expr = parser.ExprArray { elements: [box_rewrite_expr(v.init, boxed)] };
                return parser.StmtVar { name: v.name, type_name: "i32[]", init: cell, line: v.line, col: v.col };
            }
            return parser.StmtVar { name: v.name, type_name: v.type_name, init: box_rewrite_expr(v.init, boxed), line: v.line, col: v.col };
        },
        parser.StmtAssign(a) => {
            if (util.index_of_str(boxed, a.target) >= 0) {
                // x = v  ->  x = x.with(0, v)   (receiver stays the raw cell ident)
                var recv: parser.Expr = parser.ExprIdent { name: a.target, line: a.target_line, col: a.target_col };
                var wcall: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: recv, field: "with", line: a.line, col: a.col }, args: [parser.ExprNumber { text: "0", suffix: "", is_float: false, line: a.line, col: a.col }, box_rewrite_expr(a.value, boxed)], line: a.line, col: a.col, type_argc: 0 };
                return parser.StmtAssign { target: a.target, value: wcall, line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
            }
            return parser.StmtAssign { target: a.target, value: box_rewrite_expr(a.value, boxed), line: a.line, col: a.col, target_line: a.target_line, target_col: a.target_col };
        },
        parser.StmtReturn(r) => { return parser.StmtReturn { value: box_rewrite_expr(r.value, boxed), line: r.line, col: r.col }; },
        parser.StmtExpr(e) => { return parser.StmtExpr { value: box_rewrite_expr(e.value, boxed) }; },
        parser.StmtIf(f) => { return parser.StmtIf { cond: box_rewrite_expr(f.cond, boxed), then_body: box_rewrite_stmts(f.then_body, boxed), else_body: box_rewrite_stmts(f.else_body, boxed) }; },
        parser.StmtWhile(w) => { return parser.StmtWhile { cond: box_rewrite_expr(w.cond, boxed), body: box_rewrite_stmts(w.body, boxed) }; },
        parser.StmtFor(fr) => { return parser.StmtFor { var_name: fr.var_name, iter: box_rewrite_expr(fr.iter, boxed), body: box_rewrite_stmts(fr.body, boxed) }; },
        parser.StmtMatch(m) => {
            var na: parser.MatchArm[] = [];
            var ai: i32 = 0;
            while (ai < m.arms.len()) {
                var arm: parser.MatchArm = m.arms[ai];
                na = na.append(parser.MatchArm { pattern: arm.pattern, body: box_rewrite_stmts(arm.body, boxed), line: arm.line, col: arm.col, guard: arm.guard, has_guard: arm.has_guard });
                ai = ai + 1;
            }
            return parser.StmtMatch { scrutinee: box_rewrite_expr(m.scrutinee, boxed), arms: na, line: m.line, col: m.col, origin: m.origin };
        },
        _ => { return st; }
    }
    return st;
}

function box_rewrite_stmts(stmts: parser.Stmt[], boxed: string[]): parser.Stmt[] {
    var out: parser.Stmt[] = [];
    var i: i32 = 0;
    while (i < stmts.len()) { out = out.append(box_rewrite_stmt(stmts[i], boxed)); i = i + 1; }
    return out;
}

// box_mutated_scalar_captures finds `fd`'s i32/boolean locals that are captured
// by a lambda AND written inside that lambda, and boxes them (see the block
// comment above). Returns `fd` unchanged when none qualify (lambda-free and
// read-only-capture functions stay byte-identical).
function box_mutated_scalar_captures(fd: parser.FuncDecl, gfns: string[]): parser.FuncDecl {
    var boxed: string[] = [];
    var i: i32 = 0;
    while (i < fd.body.len()) {
        var lam_ok: boolean = false;
        var lam: parser.ExprLambda = parser.ExprLambda { params: [], ret_type: "", body: [] };
        match (fd.body[i]) {
            parser.StmtVar(v) => { match (v.init) { parser.ExprLambda(l) => { lam = l; lam_ok = true; }, _ => {} } },
            parser.StmtReturn(r) => { match (r.value) { parser.ExprLambda(l) => { lam = l; lam_ok = true; }, _ => {} } },
            _ => {}
        }
        if (lam_ok) {
            var caps: string[] = lambda_captures(lam, gfns);
            var wtargets: string[] = body_assign_targets(lam.body);
            var ci: i32 = 0;
            while (ci < caps.len()) {
                var cn: string = caps[ci];
                var ct: string = cap_type(cn, fd);
                if ((ct == "i32" || ct == "boolean") && util.index_of_str(wtargets, cn) >= 0 && util.index_of_str(boxed, cn) < 0) {
                    boxed = boxed.append(cn);
                }
                ci = ci + 1;
            }
        }
        i = i + 1;
    }
    if (boxed.len() == 0) { return fd; }
    return parser.FuncDecl { name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type, type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type, body: box_rewrite_stmts(fd.body, boxed), line: fd.line, col: fd.col, import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count };
}

// lift_lambdas is the module pre-pass. Returns the module unchanged when no
// lambda was lifted (keeping lambda-free modules byte-identical), else a module
// whose bodies reference the hoisted __lam_<k> functions, with those functions
// appended.
pub function lift_lambdas(raw_mod: parser.Module): parser.Module {
    // Fill omitted trailing arguments from default parameter values before the
    // IR path inspects the module, so `f(5)` to `f(a, b = 128)` reaches the IR
    // as `f(5, 128)`. No-op for default-free modules.
    var mod: parser.Module = parser.fill_default_args_module(raw_mod);
    var gfns: string[] = [];
    var gi: i32 = 0;
    while (gi < mod.funcs.len()) {
        if (mod.funcs[gi].receiver_type.len() == 0) { gfns = gfns.append(mod.funcs[gi].name); }
        gi = gi + 1;
    }
    var acc: LiftAcc = LiftAcc { funcs: [], counter: 0 };
    var newfuncs: parser.FuncDecl[] = [];
    // Worklist: the module's functions PLUS every function lifted out of a
    // lambda body. Re-processing the lifted `__lam_N` / `$clo` functions is what
    // lets a NESTED lambda (a lambda defined inside another lambda's body) lift:
    // the outer lift produces a top-level function whose body still holds the
    // inner lambda, which a later worklist round then lifts in turn. A two-level
    // capture resolves because the outer lift turns the captured outer var into a
    // PARAM of the lifted function, which the inner lift sees as an ordinary
    // param. Each round strips one nesting level, so the worklist terminates.
    var worklist: parser.FuncDecl[] = mod.funcs;
    var wi: i32 = 0;
    while (wi < worklist.len()) {
        var fd: parser.FuncDecl = worklist[wi];
        // 0. Box captured-and-mutated scalar locals into 1-element array cells so
        // a closure's write to a captured outer scalar is shared by reference
        // (#2850). Must run BEFORE the closure lifts so they see the boxed cell
        // (an `i32[]` capture passed by pointer) instead of a by-value scalar.
        fd = box_mutated_scalar_captures(fd, gfns);
        var before: i32 = acc.funcs.len();
        // 1. Capturing lambdas bound to a local + only directly called: param-lift.
        var cbody: parser.Stmt[] = fd.body;
        var more: boolean = true;
        while (more) {
            var cl: ClosureLift = closure_lift_one(cbody, fd, acc, gfns);
            cbody = cl.body;
            acc = cl.acc;
            more = cl.changed;
        }
        // 2. No-capture lambdas passed as call arguments: hoist to function values.
        var r: LiftStmts = lift_stmts(cbody, acc, gfns);
        acc = r.acc;
        var nb: parser.Stmt[] = r.stmts;
        newfuncs = newfuncs.append(parser.FuncDecl { name: fd.name, receiver_name: fd.receiver_name, receiver_type: fd.receiver_type, type_params: fd.type_params, params: fd.params, ret_type: fd.ret_type, body: nb, line: fd.line, col: fd.col, import_iface: fd.import_iface, import_wit: fd.import_wit, type_param_count: fd.type_param_count });
        // 3. First-class (escaping) closure: a `return <capturing lambda>` hoists
        // its body to `<fd>$clo`. The lambda stays in the body (irlower lowers it
        // to a make_closure box); only the hoisted target is appended here.
        var hc: HoistResult = hoist_escaping_closure(fd, gfns);
        if (hc.ok) { acc = LiftAcc { funcs: acc.funcs.append(hc.func), counter: acc.counter + 1 }; }
        // Drain the functions lifted by THIS iteration onto the worklist so their
        // OWN nested lambdas lift in a later round, then clear them (the counter
        // persists across iterations for unique `__lam_N` naming).
        var k: i32 = before;
        while (k < acc.funcs.len()) { worklist = worklist.append(acc.funcs[k]); k = k + 1; }
        acc = LiftAcc { funcs: [], counter: acc.counter };
        wi = wi + 1;
    }
    if (acc.counter == 0) { return mod; }
    return parser.Module { funcs: newfuncs, structs: mod.structs, aliases: mod.aliases, imports: mod.imports, top_stmts: mod.top_stmts, enums: mod.enums, resources: mod.resources, exports: mod.exports };
}
