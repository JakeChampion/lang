        if (c.args.len() != decl_field_count(s.structs, cid.name)) { return s.fail(); }
        // Consumed below, then cleared at once so a NESTED ctor in an argument
        // (`a = Cons(1, Cons(2, a))`) keeps its own retain — the same one-
        // expression scoping the struct-literal path gives it (#6653).
        var ctor_selfrebind: string = s.selfrebind;
        var vctor: LowerState = s.with_selfrebind("");
        var vi: i32 = 0;
        while (vi < c.args.len()) {
            // An i64 payload field is an 8-byte i64 value (a bare
            // integer literal isn't self-evidently i64), so lower it
            // via lower_i64; struct_make 64-bit-stores it (it reads
            // the field type). f64 / i32 / string / struct payloads
            // ride lower_expr.
            if (struct_field_is_i64(s.structs, cid.name, vi)) { vctor = lower_i64(c.args[vi], vctor); }
            else { vctor = lower_expr(c.args[vi], vctor); }
            if (!vctor.ok) { return vctor; }
            // Perceus alias-inc for an ARRAY payload that aliases a
            // local array: the variant box references the buffer, so
            // retain it (rc_inc) with the pointer on top of the stack.
            // Without this the exit dec-sweep frees the source local
            // out from under the returned box — a UAF that corrupts the
            // nested structure (e.g. `return PS { node: Many(items) }`
            // hands the caller a box over freed/reused memory, which
            // `count` then walks into unbounded recursion; #3720). An
            // enum variant is a struct with enum_owner, so this mirrors
            // the struct-lit fav_alias_inc idiom. Only a bare ident on
            // an array slot: a fresh-literal payload isn't a local, so
            // the sweep never frees it (it leaks — the safe-leak
            // invariant for nested payloads). The inc pops + re-pushes
            // the same pointer, leaving struct_make's arg order intact.
            if (is_array_type_name(decl_field_type_at(vctor.structs, cid.name, vi))) {
                match (c.args[vi]) {
                    parser.ExprIdent(paid) => {
                        if (vctor.is_arr_slot(vctor.slot_of(paid.name))) {
                            vctor = vctor.emit(ir.op_call_direct("__fern_rc_inc", 1));
                        }
                    },
                    _ => {}
                }
            }
            // An ENUM payload (`Cons(n, xs)`, decl_is_enum) is a second owner of
            // whatever box it stores, so it takes the same Perceus dup — the
            // struct-lit path's direct-enum-field rule (see fav_alias_inc), with
            // the same exemption: a FRESH variant ctor is sole-owned at rc 1 and
            // needs none. Without it a bare enum local stored into a variant box
            // is an UNCOUNTED alias, and the count that says so is the one every
            // consume path reads to decide whether it may free (#6720): a
            // consuming walk over `Cons(x, borrowed)` was told each cell was
            // uniquely owned and reclaimed the caller's list from under it.
            // A non-fresh payload that is genuinely sole-owned then LEAKS rather
            // than double-frees — the safe-leak invariant the rest of this
            // construction path holds to.
            //
            // EXCEPT a consume-rebind (`acc = Cons(1, acc)`, ctor_selfrebind):
            // the slot is superseded by the box being built, so the slot's own
            // reference TRANSFERS into the payload field and the owner count is
            // unchanged — a move, which is what native's last-use analysis makes
            // of it too. Retaining there pins every cell of an accumulator loop
            // at rc 2, and a consuming walk then reads a non-unique cell and
            // declines to recycle it: `inc_all(build(2000))` reallocates its
            // whole input instead of reusing it (187 KiB against 93 KiB), which
            // is the FBIP guarantee `trmc-consume-halves-peak` gates. The loop
            // rebind is exactly the shape moved_locals_toplevel_of leaves out,
            // so the move verdict cannot supply this one.
            if (decl_is_enum(vctor.structs, decl_field_type_at(vctor.structs, cid.name, vi))
                && variant_ctor_enum_owner(c.args[vi], vctor.structs).len() == 0
                && !ctor_selfrebind_payload(c.args[vi], ctor_selfrebind)) {
                vctor = vctor.emit(ir.op_call_direct("__fern_rc_inc", 1));
            }
            vi = vi + 1;
        }
        return vctor.emit(ir.op_struct_make(cid.name, c.args.len(), decl_index_of(vctor.structs, cid.name)));
    }
    if ((cid.name == "map_new" || cid.name == "map_new_i32") && c.args.len() == 1) {
        var mn: LowerState = lower_expr(c.args[0], s);
        if (!mn.ok) { return mn; }
        var mkk: i32 = 0;
        if (cid.name == "map_new_i32") { mkk = 1; }
        return mn.emit(ir.op_map_new(mkk, ""));
    }
    // Built-in Option / Result construction: Some(x)/Ok(x) wrap a
    // payload with tag 0, Err(x) with tag 1 (None is a bare ident,
    // handled in lower_expr's ExprIdent arm). The box is
    // [tag@0, payload@8] — type-agnostic, so the payload may be any
    // 8-byte value.
    if ((cid.name == "Some" || cid.name == "Ok") && c.args.len() == 1) {
        return lower_opt_make_payload(0, c.args[0], s);
    }
    if (cid.name == "Err" && c.args.len() == 1) {
        return lower_opt_make_payload(1, c.args[0], s);
    }
    // Built-in `print_int(n)` — write n's decimal text to stdout
    // (no newline). Lowers the i32 arg then op_print_int, which each
    // backend emits as a call into the same __fern_print_int runtime
    // helper the AST path uses. A reserved builtin name (like
    // map_new / Some / len), so it never shadows a user function.
    if (cid.name == "print_int" && c.args.len() == 1) {
        // An i64 argument must keep its full 64 bits: lower it via
        // lower_i64 and print through the wider op (op_print_i64 →
        // $__fern_print_int64), mirroring the AST path's print_int64
        // dispatch. Passing an i64 to the i32 $__fern_print_int would
        // be a wasm type mismatch (invalid module).
        if (infer_expr_width(c.args[0], s) == 64) {
            var pi64: LowerState = lower_i64(c.args[0], s);
            if (!pi64.ok) { return pi64; }
            return pi64.emit(ir.op_print_i64());
        }
        var pis: LowerState = lower_expr(c.args[0], s);
        if (!pis.ok) { return pis; }
        return pis.emit(ir.op_print_int());
    }
    // Built-in `putchar(c)` — write c's low byte to stdout
    // (write(1, &byte, 1), no newline). Lowers the i32 arg then
    // op_putchar, which each backend emits as a call into the same
    // __fern_putchar runtime the native compiler uses. A reserved
    // builtin (the checker already knows it), so it never shadows a
    // user function. Issue #2839 — self-host putchar IR support.
    if (cid.name == "putchar" && c.args.len() == 1) {
        var pcs: LowerState = lower_expr(c.args[0], s);
        if (!pcs.ok) { return pcs; }
        return pcs.emit(ir.op_putchar());
    }
    // Built-in `sleep_ms(ms)` — pause for `ms` milliseconds
    // (no-op if ms <= 0). Lowers the i32 arg then op_sleep_ms,
    // which the x86-64 / arm64 backends emit as a call into the
    // __fern_sleep_ms nanosleep helper. A reserved builtin, so it
    // never shadows a user function (#2843 — self-host IR path).
    if (cid.name == "sleep_ms" && c.args.len() == 1) {
        // The ms count is read into a 64-bit register (rdi / x0),
        // so an i64 arg (`sleep_ms(5 as i64)`) lowers through the
        // i64 path; a plain i32 count keeps the 32-bit path. Without
        // the width dispatch an i64 arg bails lower_expr -> the
        // whole timing module is IR-ineligible.
        var sms: LowerState = s;
        if (infer_expr_width(c.args[0], s) == 64) {
            sms = lower_i64(c.args[0], s);
        } else {
            sms = lower_expr(c.args[0], s);
        }
        if (!sms.ok) { return sms; }
        return sms.emit(ir.op_sleep_ms());
    }
    // Crash-only supervision (docs/CRASH-ONLY-SERVE.md D2',
    // #5686): `proc_fork()` forks and pushes the kernel's return
    // verbatim (0 child / pid parent / -errno), `proc_waitpid(pid)`
    // reaps and pushes the decoded exit status. Both reserved
    // builtins, so neither shadows a user function; std/tcp's
    // tcp_serve_supervised is the stdlib caller.
    if (cid.name == "proc_fork" && c.args.len() == 0) {
        return s.emit(ir.op_proc_fork());
    }
    if (cid.name == "proc_waitpid" && c.args.len() == 1) {
        var pws: LowerState = lower_expr(c.args[0], s);
        if (!pws.ok) { return pws; }
        return pws.emit(ir.op_proc_waitpid());
    }
    // `proc_exec(path, args)` execve's, so it only returns on
    // FAILURE (-errno). The third leg of the trio: it is what
    // lets a forked child become another program, which the
    // batched per-module orchestrator in asm_modload_run needs.
    if (cid.name == "proc_exec" && c.args.len() == 2) {
        var pe0: LowerState = lower_expr(c.args[0], s);
        if (!pe0.ok) { return pe0; }
        var pe1: LowerState = lower_expr(c.args[1], pe0);
        if (!pe1.ok) { return pe1; }
        return pe1.emit(ir.op_proc_exec());
    }
    // Built-in `write(s)` / `print(s)` — write a string's bytes to
    // stdout. `print` appends a newline (Fern's print == println):
    // it desugars to `print_str(s + "\n")` via the existing str_concat
    // op, so a single print_str op + helper serves both.
    //
    // `write` and `print` take any Display type and stringify through
    // display_arg; `print_str` is the internal string-only spelling and
    // takes its argument as it stands.
    if (cid.name == "print_str" && c.args.len() == 1) {
        var pss: LowerState = lower_expr(c.args[0], s);
        if (!pss.ok) { return pss; }
        return pss.emit(ir.op_print_str());
    }
    if (cid.name == "write" && c.args.len() == 1) {
        var wss: LowerState = lower_expr(display_arg(c.args[0], c.line, c.col, s), s);
        if (!wss.ok) { return wss; }
        return wss.emit(ir.op_print_str());
    }
    if (cid.name == "print" && c.args.len() == 1) {
        var prs: LowerState = lower_expr(display_arg(c.args[0], c.line, c.col, s), s);
        if (!prs.ok) { return prs; }
        prs = prs.emit(ir.op_const_str("\n"));
        prs = prs.emit(ir.op_str_concat());
        return prs.emit(ir.op_print_str());
    }
    // Built-in `read_int()` — read a line from stdin, parse a leading
    // optional-sign decimal, push the i32. A value op (leaves the
    // result on the stack). No wasm stdin support, so wasm_eligible
    // rejects read_int modules; x86 / arm64 lower it.
    if (cid.name == "read_int" && c.args.len() == 0) {
        return s.emit(ir.op_read_int());
    }
    // Built-in `read_all_stdin()` — read fd 0 to EOF into one
    // string box (#5623). A value op; the result str-tracks via
    // expr_is_str's matching case. Like read_int there is no wasm
    // stdin, so wasm_eligible rejects read_all_stdin modules;
    // x86 / arm64 lower it.
    if (cid.name == "read_all_stdin" && c.args.len() == 0) {
        return s.emit(ir.op_read_all_stdin());
    }
    // Built-in `stdin()` — returns a Reader. As in the AST backend
    // (asm.fern), a Reader is just its fd, and fd 0 is stdin; so the
    // value is the i32 constant 0. The `r.read_chunk(n)` / `r.close()`
    // methods take that fd directly (see the method-call interception).
    // No wasm stdin support, so wasm_eligible rejects read_chunk modules.
    if (cid.name == "stdin" && c.args.len() == 0) {
        return s.emit(ir.op_const_i32(0));
    }
    // Built-in `stdout()` / `stderr()` — return a Writer, which
    // like a Reader is just its fd: stdout=1, stderr=2. `w.write(s)`
    // / `w.close()` take that fd directly (#4372). Value ops.
    if (cid.name == "stdout" && c.args.len() == 0) {
        return s.emit(ir.op_const_i32(1));
    }
    if (cid.name == "stderr" && c.args.len() == 0) {
        return s.emit(ir.op_const_i32(2));
    }
    // Built-in `open_reader`/`open_writer`/`open_appender(path)` —
    // open a file, return a Reader/Writer (bare fd) or -errno
    // (#4372 file half). One op_open_file carries the openat flags:
    // O_RDONLY=0, O_WRONLY|O_CREAT|O_TRUNC=577, O_WRONLY|O_CREAT|
    // O_APPEND=1089. No wasm fs-open runtime, so wasm_eligible
    // rejects open_file modules.
    if ((cid.name == "open_reader" || cid.name == "open_writer"
            || cid.name == "open_appender") && c.args.len() == 1) {
        var ofs: LowerState = lower_expr(c.args[0], s);
        if (!ofs.ok) { return ofs; }
        var oflags: i32 = 0;
        if (cid.name == "open_writer") { oflags = 577; }
        if (cid.name == "open_appender") { oflags = 1089; }
        return ofs.emit(ir.op_open_file(oflags));
    }
    // Built-in `read_line()` — read one line from stdin, return a
    // fresh string box. A value op; the binding str-tracks the
    // result (expr_is_str's read_line case). No wasm stdin support,
    // so wasm_eligible rejects read_line modules; x86 / arm64 lower it.
    if (cid.name == "read_line" && c.args.len() == 0) {
        return s.emit(ir.op_read_line());
    }
    // Built-in `read_file(path)` — read the whole named file, push a
    // fresh Result[string, IoError] box (Ok(contents) / Err(_)). A
    // value op consuming the lowered path arg. The Result type is
    // recognised by opt_recv_base_type / the var-binding opt-type
    // marker (read_file_result_type), so `match (read_file(p)) { Ok
    // => .., Err => .. }` lowers like any other Result. No wasm file
    // I/O here, so wasm_eligible rejects read_file modules; x86 /
    // arm64 lower it.
    if (cid.name == "read_file" && c.args.len() == 1) {
        var rfs: LowerState = lower_expr(c.args[0], s);
        if (!rfs.ok) { return rfs; }
        return rfs.emit(ir.op_read_file());
    }
    // Built-in `write_file(path, content)` — write the whole content
    // to the named file, push a fresh Result[(), IoError] box (Ok(())
    // on success / Err(_) on error). A value op consuming the lowered
    // path + content args (path first, content second — op_write_file
    // pops content then path). The Result type is resolved by
    // read_file_result_type's write_file case so `match (write_file(p,
    // c)) { Err(_) => .., Ok(_) => .. }` lowers. No wasm file I/O, so
    // wasm_eligible rejects write_file modules; x86 / arm64 lower it.
    if (cid.name == "write_file" && c.args.len() == 2) {
        var wfs: LowerState = lower_expr(c.args[0], s);
        if (!wfs.ok) { return wfs; }
        wfs = lower_expr(c.args[1], wfs);
        if (!wfs.ok) { return wfs; }
        return wfs.emit(ir.op_write_file());
    }
    // write_file_exec(path, contents) — write_file with the executable bit, so
    // a compiler emitting a finished binary can produce a runnable one (#6133).
    if (cid.name == "write_file_exec" && c.args.len() == 2) {
        var wfx: LowerState = lower_expr(c.args[0], s);
        if (!wfx.ok) { return wfx; }
        wfx = lower_expr(c.args[1], wfx);
        if (!wfx.ok) { return wfx; }
        return wfx.emit(ir.op_write_file_exec());
    }
    // Built-in `remove_dir_all(path)` — recursively rm -rf the named
    // directory tree, push a fresh Result[(), IoError] box (Ok(()) on
    // success / Err(_) on a non-ENOENT/ENOTDIR open error). A value
    // op consuming the lowered path arg. The Result type is resolved
    // by read_file_result_type's remove_dir_all case so `match
    // (remove_dir_all(p)) { Err(_) => .., Ok(_) => .. }` lowers. No
    // wasm file I/O, so wasm_eligible rejects remove_dir_all modules;
    // x86 / arm64 lower it (the same recursive runtime the AST path
    // calls — `TestRunner.finish`'s cleanup path, the universal
    // std/test blocker that pinned every test module to the AST
    // emitter and its u32 miscompile, #3457).
    if (cid.name == "remove_dir_all" && c.args.len() == 1) {
        var rdas: LowerState = lower_expr(c.args[0], s);
        if (!rdas.ok) { return rdas; }
        return rdas.emit(ir.op_remove_dir_all());
    }
    // Built-in `remove_file(path)` — unlink the named file, push a
    // fresh Result[(), IoError] box (Ok(()) / Err(_)). opt_ret_type's
    // remove_file case resolves the Result so `match (remove_file(p))`
    // binds; wasm-ineligible, x86 / arm64 lower it (#3457:
    // filesystem_ops' remove_file).
    if (cid.name == "remove_file" && c.args.len() == 1) {
        var rfs: LowerState = lower_expr(c.args[0], s);
        if (!rfs.ok) { return rfs; }
        return rfs.emit(ir.op_remove_file());
    }
    // Built-in `create_dir_all(path)` — create the directory and every
    // missing parent, push a fresh Result[(), IoError] box. An
    // already-present path is Ok, so a caller creates unconditionally
    // rather than stat-ing first (#6749).
    if (cid.name == "create_dir_all" && c.args.len() == 1) {
        var cdas: LowerState = lower_expr(c.args[0], s);
        if (!cdas.ok) { return cdas; }
        return cdas.emit(ir.op_create_dir_all());
    }
    // Built-in `temp_dir(prefix)` — make a uniquely-named /tmp
    // directory, push a fresh Result[string, IoError] box
    // (Ok(path) / Err(_)). The Result type is resolved by
    // opt_ret_type's temp_dir case so `match (temp_dir(p)) { Ok =>
    // .., Err => .. }` lowers. No wasm file I/O, so wasm_eligible
    // rejects temp_dir modules; x86 / arm64 lower it (the same
    // __fern_temp_dir runtime the AST path calls — std/test's
    // must_temp_dir, used by result_assertions / helpers, #3457).
    if (cid.name == "temp_dir" && c.args.len() == 1) {
        var tds: LowerState = lower_expr(c.args[0], s);
        if (!tds.ok) { return tds; }
        return tds.emit(ir.op_temp_dir());
    }
    // Built-in `read_dir(path)` — list a directory's base-name
    // children, push a fresh Result[string[], IoError] box
