    if (cid.name == "proc_exec" && c.args.len() == 2) {
        var pe0: LowerState = lower_expr(c.args[0], s);
        if (!pe0.ok) { return pe0; }
        var pe1: LowerState = lower_expr(c.args[1], pe0);
        if (!pe1.ok) { return pe1; }
        return pe1.emit(ir.op_proc_exec());
