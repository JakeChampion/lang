                        // `One(c)`). An array payload that aliases a local array gets a
                        // Perceus alias-inc below so the variant box retains the buffer
                        // (the safe-leak invariant — see the inc site after each arg).
                        if (c.args.len() != decl_field_count(s.structs, cid.name)) { return s.fail(); }
                        var vctor: LowerState = s;
