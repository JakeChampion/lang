    // opt_ret_type's read_dir case so `match (read_dir(p)) { Ok =>
    // .., Err => .. }` binds `names` as string[]. No wasm file I/O,
    // so wasm_eligible rejects read_dir modules; x86 / arm64 lower
    // it (the same __fern_read_dir runtime the AST path calls —
    // std/test's assert_eq_dir_listing, #3457).
    if (cid.name == "read_dir" && c.args.len() == 1) {
        var rds: LowerState = lower_expr(c.args[0], s);
        if (!rds.ok) { return rds; }
        return rds.emit(ir.op_read_dir());
    }
    // Built-in `env(name)` — look up an environment variable, push
    // a fresh Option[string] box (Some(value) / None). The Option
    // type is resolved by opt_ret_type's env case so
