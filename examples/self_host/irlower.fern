// examples/self_host/irlower.fern — AST -> stack-IR lowering for the
// self-hosted compiler (slice 2 of the IR rebuild, see
// docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md), plus a stack-machine
// interpreter that evaluates the lowered Op[] so lowering is checkable
// end-to-end WITHOUT a backend (mirrors how ssa.fern validates its builder
// with an SSA interpreter).
//
// SCOPE (slice 2): the straight-line i32 subset — params, `var` / `=`
// locals, integer / bool literals, the binary + unary operators, and
// `return`. This is the IR analogue of ssa.fern's slice-1 subset. Anything
// outside it (control flow, calls, strings, floats, composites) makes
// lower_func return ok=false, so the driver can fall back / report a bail.
// Control flow (block/loop/if/br) + calls land in later slices, mirroring
// the native builder's expression/statement lowering.
//
// The lowering is a textbook stack-machine emit: an expression lowers to
// ops that PUSH its value (operands first, then the operator), a `var`
// binds the next local slot and stores into it, `return` lowers its value
// then emits `return`. Params occupy slots 0..n_params-1.

import "./ir";
import "./parser";
import "./util";
import "./astwalk";

// LowerState threads the accumulated Op[] and the local-slot table
// (slot i -> name) immutably, in the self-host style. `n_params` records
// the borrow boundary the later RC slices need; `ok` latches a bail.
// LocalInfo field reference (one entry per local slot; collapsed from the former
// 17+ parallel local_* arrays in LowerState into one array-of-structs so the
// per-statement LowerState rebuild copies ONE field pointer, not 20):
// local_is_arr[i] marks slot i as holding an array value (drives the
// Perceus alias-inc: a new reference to an array must retain it).
// local_is_str[i] marks slot i as holding a string value — used for type
// dispatch only (str_len vs arr_len, str_concat vs add, str_eq vs eq).
// Strings are not reference-counted, so this drives no RC; it just keeps
// string slots out of the array machinery and selects the string opcodes.
// local_is_strarr[i] marks slot i as holding a string[] array (alongside
// local_is_arr, which still drives the array's RC). It only affects element
// typing: arr[i] on a string[] yields a string (str_len etc.), while the
// array itself is rc-tracked like any array and its string elements leak.
// local_struct_type[i] holds the struct type name of slot i (""=not a
// struct), so `p.x` resolves x's field index in p's decl. Like local_is_str,
// dispatch-only — the scalar-field structs this slice covers are leak-only.
// local_opt_type[i] holds the Option[T]/Result[T,E] type string of slot i
// (""=not an Option/Result), set when `var r = f()` binds an Option/Result-
// returning call (or for an Option/Result param). Lets a `match (r)` on a
// local recover the bound payload type, the same way a direct-call scrutinee
// uses opt_ret_fns.
// local_tuple_elems[i] holds slot i's tuple element-type tags, comma-joined
// (e.g. "string,i32,Point"), "" if not a tuple. Lets `t.N` and a tuple
// destructure recover each element's type for dispatch.
// local_is_i64[i] marks slot i as holding an i64 value (drives i64
// instruction selection + wasm i64 local typing). i32 stays the default.
// local_is_f64[i] marks slot i as holding an f64 value (drives float
// instruction selection: arithmetic / comparison use the float registers).
// The slot itself is an 8-byte bit pattern like any value; only the ops on
// it differ. i32 stays the default.
// local_is_f32[i] marks slot i as holding an f32 value. f32 is STORED as an
// 8-byte f64 (so it is also local_is_f64 — storage/arith/compare are the
// f64 ops), but its TYPE is tracked distinctly here so method dispatch keys
// "f32.<m>" (not "f64.<m>") — they differ for `to_string`/`to_json`
// (precision). expr_recv_prim_type returns "f32" when this is set.
// local_is_f64arr[i] marks slot i as holding an f64[] array (alongside
// local_is_arr, which still drives the array's RC). It only affects element
// WIDTH: a[i] on an f64-array slot reads an 8-byte f64 (arr_get width 64,
// f64.load on wasm) and types as f64, and an f64 array literal allocates an
// 8-byte-stride buffer. i32 / string[] arrays (4-byte wasm stride) stay the
// default. The register backends already use 8-byte element slots, so this
// only steers the wasm backend's element load/store width.
// local_is_i64arr[i] marks slot i as holding an i64[] array. Like
// local_is_f64arr it drives an 8-byte element stride, but a[i] reads an
// 8-byte i64 (arr_get_i64 -> i64.load on wasm) and types as i64 (flowing
// through lower_i64), and an i64 array literal stores i64 elements. i32 /
// f64 / string[] arrays stay the default.
// local_is_closurearr[i] marks slot i as holding a closure[] — an array of
// function VALUES (closure boxes). a[i] yields a closure box, so a local
// bound from such an element is marked a closure local (mark_closure_local)
// and `c()` unpacks the box instead of calling the raw pointer as a table
// index (which traps).
// local_is_fnarr[i] marks slot i as holding a PLAIN-fn-pointer array — an
// array of bare named-function VALUES (`(() => T)[]`), as opposed to the
// closure boxes of local_is_closurearr. The distinction matters at
// `.append(f)`: a bare 0-arg fn-name appended to such a slot is a fn POINTER
// (const_func), not a `const`-style call — without the flag the appended `f`
// const-calls and stores its result, so `fns[i]()` segfaults. A plain
// fn-pointer element calls via the plain call_indirect path (NOT env-first),
// so this flag is deliberately separate from local_is_closurearr. (#3574)
// local_is_arrarr[i] marks slot i as holding an ARRAY-of-arrays (`i32[][]`,
// `string[][]`, …). Its element `a[i]` is itself an array, so a local bound
// from such an element — `var row = a[i]` or the loop var of `for row in a` —
// is marked is_arr, which lets `for x in row` / `row` flow as an array source
// (a plain `row[i]` / `row.len()` works without the flag; only ITERATING or
// re-binding the inner array needs it). Set from a `T[][]` annotation or an
// array-of-array literal (`[[…], …]`); a single nesting level (depth 2).
// local_arrarr_elem[i] records the INNER element kind of a T[][] slot —
// "i64" / "f64" (the 8-byte element kinds) or "" (i32/string, 4-byte/ptr).
// local_is_arrarr only records THAT a slot is array-of-arrays, not what T is,
// so a nested read a[i][j] couldn't recover the inner width and truncated an
// i64/f64 element to 32 bits. This lets arr_index_is_i64/_f64 pick the 8-byte
// load for a nested element. (#2691 nested-array i64/f64 fix.)
// local_is_u32[i] marks slot i as holding a u32 value (scalar) OR a u32[]
// array (disambiguated by local_is_arr). It drives u32 WRAPPING: arithmetic
// whose result is u32 masks to 32 bits on the register backends, and a u32
// `>>` lowers to a LOGICAL shift (shr_u). Native wraps every u32 op at 2^32;
// without this the self-host kept 64-bit results, so u32-heavy code (the
// SHA-256 schedule / __rotr `x << (32-n)`) accumulated stray high bits and
// miscompiled. u8 rides the parallel local_subword slot below.
// local_is_u64[i] marks slot i as holding a u64 value (scalar) OR a u64[]
// array. u64 lives in the i64 64-bit domain (alongside local_is_i64) but is
// UNSIGNED: its `>`/`<`/… compare, `>>`, and `/`/`%` select the unsigned ops
// (lt_u/shr_u/div_u/…) instead of the signed ones, which are wrong once bit
// 63 is set (#2904). Unlike u32 there is no wrap step — i64-domain ops are
// already full-width; only signedness differs.
// local_subword[i] holds the sub-32-bit integer kind of slot i ("u8"),
// or "" if not a sub-word int. For a u8[] array slot it holds the ELEMENT
// kind (disambiguated by local_is_arr). It drives the post-arithmetic WIDTH
// WRAP: a u8 `+`/`-`/`*`/`<<` whose result can exceed the width is masked
// back via an int_cast, matching the interpreter's per-width wrap
// (`255u8 + 1 == 0`). Without it the IR backends kept the full 64-bit
// result and miscompiled (the u32 sibling of this is local_is_u32 /
// op_u32_wrap).
// ctrl: count of structured-control constructs (block/loop/if) currently
// open at this point — auto-maintained in emit(). loop_blk: a stack holding,
// per enclosing loop, the ctrl level just after that loop's exit-block opener
// (the loop header sits one deeper). break = br(ctrl - top); continue =
// br(ctrl - top - 1). Together they let break/continue compute relative br
// depths through arbitrary if/match nesting.
pub struct LocalInfo {
    slot_name: string,
    is_arr: boolean,
    is_str: boolean,
    is_strarr: boolean,
    struct_type: string,
    opt_type: string,
    tuple_elems: string,
    map_type: string,
    is_i64: boolean,
    is_f64: boolean,
    is_f32: boolean,
    is_f64arr: boolean,
    is_i64arr: boolean,
    is_closurearr: boolean,
    is_fnarr: boolean,
    is_arrarr: boolean,
    arrarr_elem: string,
    is_u32: boolean,
    is_u64: boolean,
    subword: string,
    // is_cell / cell_elem: a Cell[T] slot (#5510). A Cell is lowered as a
    // 1-element array of T, so cell_new(v) -> [v], c.get() -> c[0], c.set(x)
    // -> c[0]=x — reusing the array machinery on every backend. cell_elem is
    // T (the element type spelling), for the array element width.
    is_cell: boolean,
    cell_elem: string,
    // str_own: the OWNERSHIP class of the string box an is_str slot holds --
    // the slot-carried fact of #4297 CS4 (the self-host mirror of native
    // ast.Ownership; docs/OWNERSHIP-TYPES-PLAN.md). Codes mirror
    // str_producer_ownership: 0 = Owned (this slot holds the owning
    // reference to a fresh rc box), 1 = Borrowed (an owner elsewhere -- a
    // caller, a container, another local -- holds it), 2 = View (an immortal
    // rc=-1 box sharing another buffer, #4294), 3 = Static (interned
    // .rodata literal). Seeded at the binding (lower_var / if-let / match
    // payload) from str_binding_ownership; every unproven slot -- params,
    // container-element binders, non-string slots -- stays at the DEFAULT 1
    // (Borrowed), the conservative never-free class, matching the
    // `i >= n_params` params-are-borrowed rule the reclaim heuristics
    // already assume. Read via str_expr_ownership / str_own_slot; no
    // codegen decision consults it yet (CS4 is behaviour-identical -- the
    // consumers are CS3/#4355 and the reuse-analysis slice). Meaningless
    // (inert 1) on a non-string slot.
    str_own: i32,
}

// li_new(name) — a fresh local slot (defaults: every flag false, every type "").
pub function li_new(name: string): LocalInfo {
    return LocalInfo { slot_name: name, is_arr: false, is_str: false, is_strarr: false, struct_type: "", opt_type: "", tuple_elems: "", map_type: "", is_i64: false, is_f64: false, is_f32: false, is_f64arr: false, is_i64arr: false, is_closurearr: false, is_fnarr: false, is_arrarr: false, arrarr_elem: "", is_u32: false, is_u64: false, subword: "", is_cell: false, cell_elem: "", str_own: 1 };
}

pub function li_set_names(li: LocalInfo, v: string): LocalInfo {
    return LocalInfo { ...li, slot_name: v };
}

pub function li_set_is_arr(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_arr: v };
}

pub function li_set_is_str(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_str: v };
}

pub function li_set_is_strarr(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_strarr: v };
}

pub function li_set_struct_type(li: LocalInfo, v: string): LocalInfo {
    return LocalInfo { ...li, struct_type: v };
}

pub function li_set_opt_type(li: LocalInfo, v: string): LocalInfo {
    return LocalInfo { ...li, opt_type: v };
}

pub function li_set_tuple_elems(li: LocalInfo, v: string): LocalInfo {
    return LocalInfo { ...li, tuple_elems: v };
}

pub function li_set_map_type(li: LocalInfo, v: string): LocalInfo {
    return LocalInfo { ...li, map_type: v };
}
function li_set_cell(li: LocalInfo, v: string): LocalInfo {
    return LocalInfo { ...li, is_arr: true, is_cell: true, cell_elem: v };
}


pub function li_set_is_i64(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_i64: v };
}

pub function li_set_is_f64(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_f64: v };
}

pub function li_set_is_f32(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_f32: v };
}

pub function li_set_is_f64arr(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_f64arr: v };
}

pub function li_set_is_i64arr(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_i64arr: v };
}

pub function li_set_is_closurearr(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_closurearr: v };
}

pub function li_set_is_fnarr(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_fnarr: v };
}

pub function li_set_is_arrarr(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_arrarr: v };
}

pub function li_set_arrarr_elem(li: LocalInfo, v: string): LocalInfo {
    return LocalInfo { ...li, arrarr_elem: v };
}

pub function li_set_is_u32(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_u32: v };
}

pub function li_set_is_u64(li: LocalInfo, v: boolean): LocalInfo {
    return LocalInfo { ...li, is_u64: v };
}

pub function li_set_subword(li: LocalInfo, v: string): LocalInfo {
    return LocalInfo { ...li, subword: v };
}

pub function li_set_str_own(li: LocalInfo, v: i32): LocalInfo {
    return LocalInfo { ...li, str_own: v };
}

pub struct LowerState {
    ops: ir.Op[],
    locals: LocalInfo[],
    // (per-local-slot info lives in the LocalInfo[] above; field docs are on LocalInfo)
    ctrl: i32,
    loop_blk: i32[],
    // ret_is_i64: this function returns i64 (so `return <i64expr>` lowers via
    // lower_i64). i64_ret_fns: names of module functions returning i64, so a
    // call to one is recognised as an i64 value (infer_expr_width / lower_i64).
    ret_is_i64: boolean,
    // ret_arrdyn: a 2-bit flag word folding what used to be two boolean
    // fields (LowerState is pinned at 33 fields — see the #4554 note near
    // lower_func's constructor — so growing it means folding first):
    //   bit 0 (ret_arrdyn % 2 == 1): this function returns i64[] (so
    //     `return [literal]` lowers its elements as i64 via arr_make_i64,
    //     not the generic i32 path).
    //   bit 1 ((ret_arrdyn / 2) % 2 == 1): this function returns a SCALAR
    //     `dyn Trait` (NOT a `dyn Trait[]` array). When set, `return <expr>`
    //     coerces the value to `dyn Trait` via lower_dyn_arg — a
    //     primitive/string is heap-boxed via op_dyn_box so it carries a shape
    //     pointer, a struct/enum flows unboxed (docs/DYN-TRAITS.md §4.3).
    // Set in lower_func from fn.ret_type and threaded read-only; read via the
    // ret_i64arr() / ret_dyn() accessor methods.
    ret_arrdyn: i32,
    i64_ret_fns: string[],
    // fn_param_sigs[k] = "callee|<flags>" where flag i is '1' if the callee's
    // param i is a function type ("fn"). Drives the type-directed function-VALUE
    // detection: a bare function-name ARGUMENT at a "fn" param position lowers to
    // const_func (a function pointer), not a call. (A const desugars to a zero-arg
    // function whose bare reference is otherwise a call, so the distinction must
    // be type-directed, mirroring asmcore.callee_param_is_fn.)
    fn_param_sigs: string[],
    // --- first-class (escaping) closures, slice 3a ---
    // cur_fn: the name of the function being lowered. An escaping capturing
    // ExprLambda in it is hoisted to `<cur_fn>$clo(__env, params…)`; lowering
    // the lambda emits const_func(<cur_fn>$clo) + the captures into a tuple box.
    cur_fn: string,
    // cur_ret: the enclosing function's return-type spelling (e.g.
    // "Result[i32, AppErr]"). Threaded read-only like cur_fn; used by lower_try
    // to recover the enclosing return's error type E2 for the From-converting
    // `?` desugar (#2697) — when a propagated `Result[_, E1]` must be widened to
    // `Result[_, E2]` via `Err(E2.from(e))`.
    cur_ret: string,
    // closure_fns: module functions whose body returns a closure box (a hoisted
    // escaping lambda). `var f = <call to one>` marks f as a closure local.
    closure_fns: string[],
    // closurearr_ret_fns: module functions whose body returns an ARRAY of
    // closure boxes (`((T) => R)[]`). `var arr = <call to one>` marks arr's
    // slot is_closurearr so `arr[i](args)` dispatches env-first instead of
    // bare-calling the box pointer as code (a SIGSEGV otherwise).
    closurearr_ret_fns: string[],
    // const_fns: names of zero-arg, receiver-less module functions (a `const`
    // desugars to one). A bare ident reference to one — not a local — is a CALL
    // to it (the const's value), mirroring the AST backend's rule (asm.fern's
    // ExprIdent: zero-arg receiver-less fn -> call; >0-arg -> fn-value) (#2954).
    const_fns: string[],
    // closure_locals: names of locals currently holding a closure BOX (tuple
    // [funcval, caps…]) rather than a Slice-1 bare function value — so a call
    // `f(args)` dispatches to the env-passing closure-call form instead of the
    // plain call_indirect. A small list (grown only at closure bindings), not a
    // per-slot array.
    closure_locals: string[],
    // closure_opt_rets: "<paramname>|<Option/Result type>" for each closure/fn-
    // typed PARAM whose signature return type is an Option/Result (the coarsened
    // "fn" type_name discards it, but ParamDecl.fn_ret keeps the spelling). Lets a
    // match/`?` on a DIRECT closure-call scrutinee (`match (f(x)) { Some… }`)
    // recover the Option type — the closure sibling of opt_ret_type's named-fn
    // lookup, which is keyed by function name and misses a closure param. Without
    // it such a match bailed the whole function to AST (std/array.find_map and
    // every find_map-shaped closure combinator).
    closure_opt_rets: string[],
    // f64_ret_fns: names of free functions returning f64, so a call to one is
    // recognised as an f64 value (expr_is_f64). Without it an unannotated
    // `f(a) * g(b)` of two f64-returning calls would mis-select integer mul on
    // the float bits. Threaded read-only like i64_ret_fns.
    f64_ret_fns: string[],
    // f64arr_ret_fns: names of free functions returning f64[], so the call-site
    // binding `var x = f()` element-width-tracks x (is_f64arr), letting a later
    // x[i] read an 8-byte f64. Without it the result would be a generic array
    // and x[i] would mis-load 4 bytes off an 8-byte buffer. Read-only registry.
    f64arr_ret_fns: string[],
    // i64arr_ret_fns: names of free functions returning i64[], so `var x = f()`
    // element-types x as i64[] (is_i64arr) and a later x[i] reads an 8-byte i64
    // via lower_i64. Mirrors f64arr_ret_fns. Read-only registry.
    i64arr_ret_fns: string[],
    // structs: the module's struct decls, for field-index / field-order lookup
    // (constant across the lowering; threaded read-only).
    structs: parser.StructDecl[],
    // str_ret_fns: names of functions whose return type is `string`, so a
    // `var s = f()` (and `f().len()`) tracks the result as a string for op
    // dispatch. Strings aren't RC'd, so this is type tracking only. Threaded
    // read-only like structs; empty during op-kind analyses (where string
    // tracking doesn't change the result).
    str_ret_fns: string[],
    // arr_ret_fns: names of functions whose return type is an array, so a
    // `var x = f()` is a move (owned, no inc) and x is array-tracked.
    arr_ret_fns: string[],
    // strarr_ret_fns: names of functions whose return type is `string[]`, so a
    // `var xs = f()` tracks xs as string[] (element typing: xs[i] is a string).
    // The array itself is still rc-tracked via arr_ret_fns; this is the string-
    // element overlay, mirroring str_ret_fns for the scalar string case.
    strarr_ret_fns: string[],
    // arr_method_fns: names of std/array's `__method_Array_<m>` helper free
    // functions (possibly `<mod>__`-mangled), so an array-receiver method call
    // `arr.<m>(args)` resolves to the helper and lowers as a free call (see
    // find_arr_method). Threaded read-only like the *_ret_fns registries.
    arr_method_fns: string[],
    // opt_ret_fns: entries "name|rettype" for functions whose return type is
    // Option[T] or Result[T, E], so a match on `f()` can recover the bound
    // payload's type (T for Some/Ok, E for Err) and bind it correctly (scalar
    // plain, string via mark_str). Threaded read-only like str_ret_fns.
    opt_ret_fns: string[],
    // tuple_ret_fns: entries "name|rettype" for free functions whose return
    // type is a tuple `(t0, t1, …)`, so `var x = f()` / `var (a, b, …) = f()`
    // recovers each element's type tag for `.N` / destructure dispatch. Only
    // scalar/string-element tuples are lowered (lower_func bails the rest);
    // threaded read-only like opt_ret_fns.
    tuple_ret_fns: string[],
    // struct_ret_fns: entries "name|StructType" for free functions returning a
    // (leaf-safe, scalar-field) struct, so `var p = f()` tracks p's struct type
    // for later field access (`p.x`). Threaded read-only like tuple_ret_fns.
    struct_ret_fns: string[],
    map_ret_fns: string[],
    // reclaimable_names: the set of local names that ESCAPE this function — appear
    // in a return value, a call argument, a method receiver, a struct-literal
    // field value, an array element, or any assignment/binding RHS. Computed
    // once per function (collect_reclaimable_names) and threaded read-only. A struct
    // local whose name is NOT here, and which was bound from a fresh literal /
    // struct-returning call (a sole-owner rc=1 value), is reclaim-safe: freeing
    // its box cannot dangle another reference. Drives the struct rc-dec.
    reclaimable_names: string[],
    // aliased_names: the set of ARRAY/MAP local names that acquire a lasting
    // LOCAL alias inside this function — a name bound to a second local
    // (`var b = a` / `b = a`) or stored as a bare ident into a container literal
    // (`H { xs: a }`, `[a]`, `(a, …)`). Computed once per function
    // (aliased_array_names_of) and threaded read-only. The in-place self-reassign
    // `a = a.with(i, v)` (an arr_set on the assumption `a` is the sole owner) is
    // UNSOUND when `a` is aliased — the in-place write mutates the buffer the
    // alias still reads (#3599). When the target is in this set we instead lower
    // the `.with` as a value-producing CLONE (lower_arr_with_value) and store it
    // back, leaving the aliased buffer untouched (correct, if leak-y, ahead of
    // the full Perceus refcount-guarded reuse). Return-position aliases
    // (`return EvalOut { heap: heap }`) are deliberately NOT counted: the value
    // moves out at function exit, after all in-place mutations, so it creates no
    // observable shared-buffer hazard — and counting it would wrongly disable the
    // hot VM `stack/heap/locals = …​.with(…)` in-place stores.
    aliased_names: string[],
    // fn_names: the names of every free function in the module (the full
    // registry, unlike the type-specialised *_ret_fns lists). A bare-ident call
    // `foo(args)` whose name is in here resolves to that user function and must
    // NOT be intercepted as a same-named builtin (`len` / `exit` / `chr` /
    // `i32_to_string` / …). Native + interp already resolve to the user function;
    // this lets the IR path match (#3710). Threaded read-only like the *_ret_fns
    // registries.
    fn_names: string[],
    // return_fresh_struct_ret_fns: keys (bare name / "<Base>.<method>") of
    // functions whose every return is a STRICT-fresh struct literal — every
    // array field set from a fresh scalar/string array LITERAL, so the returned
    // box is the unambiguous SOLE owner of every field buffer (the
    // return_fresh_struct_ret_fns_of classifier). Threaded read-only so the
    // ExprStructLit construction-inc can SKIP retaining a nested-struct field
    // whose value is a call to such a fn: the callee handed back a fresh
    // sole-owned box, so the new struct owns it outright and the deep-drop
    // (is_unique-gated) reclaims it instead of leaking the alias-inc'd rc-2 box
    // (the slice-3 deep-drop follow-up). The looser fresh_struct_ret_fns is NOT
    // safe here — its inner element buffers may alias live locals.
    return_fresh_struct_ret_fns: string[],
    // xblock_pending: cross-block reuse pairings available to a construction
    // NESTED in the statement currently being lowered — encoded "recip|donor"
    // (recipient local name | dead block-top donor local name). lower_block sets
    // these before lowering a nested if/while/block whose body contains a
    // cross-block reuse recipient, and clears them after; the recursive lower_block
    // of that body consumes a matching entry when it constructs the recipient.
    xblock_pending: string[],
    // try_cleanup: the parse-level defer pass's `?`-edge cleanup markers
    // (#4334) — the `if (__dfa_tryall) {…}` / `if (__dfa_tryerr) {…}` StmtIf
    // blocks lower_defers_func appends to a defer-using function's body.
    // Extracted once in lower_func and threaded read-only; lower_try replays
    // the guarded statements (all-defers marker first, then the errdefer one)
    // at the `?` failure edge, before the exit dec-sweep — mirroring native's
    // emitDeferCleanup + emitErrDeferCleanup at the TryOp failure edge.
    // Empty for functions without defers, making lower_try byte-identical
    // to the pre-#4334 lowering there.
    try_cleanup: parser.Stmt[],
    // grow_exempt (#4873 port): the ident args of the CURRENT statement's
    // direct call whose old value dies at the statement (the strict
    // self-reassign / return-position occurs-once shapes) — the call-site
    // grow bracket skips them so the in-place accumulator fast paths stay
    // O(n). Set/cleared around each statement by lower_stmt's wrapper.
    grow_exempt: string[],
    // optret_pending: consumed-match Option/Result candidates whose arms are
    // CURRENTLY being lowered — "slot#s" (string payload) / "slot#a"
    // (leak-safe-array payload) entries. A `return` inside such an arm would
    // make the post-match drop site dead code (the #4353 p1/p3 leak), so
    // emit_dec_sweep_except_list (which every return form runs) drops the
    // pending payload + box before op_return; the drop zeroes the slot, and
    // fallthrough paths keep the post-match drop — each dynamic path frees
    // the box exactly once. Set/restored around the candidate's match
    // statement by the fn-body loop and lower_block; empty at fn end.
    optret_pending: string[],
    n_params: i32,
    ok: boolean,
}

pub function (s: LowerState) emit(op: ir.Op): LowerState {
    // Auto-maintain ctrl: a block/loop/if opens a new structured-control level;
    // an end closes one. else/br/br_if leave the level unchanged. This keeps the
    // br-depth bookkeeping correct across every emit site with no per-site code.
    var nctrl: i32 = s.ctrl;
    if (op.kind_tag == 152 || op.kind_tag == 153 || op.kind_tag == 154) { nctrl = s.ctrl + 1; }  // block, loop, if
    if (op.kind_tag == 156) { nctrl = s.ctrl - 1; }  // end
    return LowerState { ...s, ops: s.ops.append(op), ctrl: nctrl };
}

// enter_loop / exit_loop push and pop the loop_blk stack. enter_loop is called
// right after a loop's exit-block opener is emitted (so s.ctrl is the block's
// level); exit_loop after both of the loop's `end`s. cur_loop_blk returns the
// innermost loop's recorded block level, or -1 outside any loop.
pub function (s: LowerState) enter_loop(): LowerState {
    return LowerState { ...s, loop_blk: s.loop_blk.append(s.ctrl) };
}
pub function (s: LowerState) exit_loop(): LowerState {
    var trimmed: i32[] = [];
    var k: i32 = 0;
    while (k + 1 < s.loop_blk.len()) { trimmed = trimmed.append(s.loop_blk[k]); k = k + 1; }
    return LowerState { ...s, loop_blk: trimmed };
}
pub function (s: LowerState) cur_loop_blk(): i32 {
    if (s.loop_blk.len() == 0) { return 0 - 1; }
    return s.loop_blk[s.loop_blk.len() - 1];
}
// loop_blk_at_depth returns the exit-block ctrl level of the loop `n` levels out
// from the innermost (n = 0 → innermost, n = 1 → its enclosing loop, …), or -1 if
// out of range. Drives labeled break/continue: a labeled break's relative depth is
// pre-resolved into StmtBreak.tag by the parser's resolve_labels pass, so n = 0
// (unlabeled / innermost) reproduces cur_loop_blk exactly.
pub function (s: LowerState) loop_blk_at_depth(n: i32): i32 {
    var idx: i32 = s.loop_blk.len() - 1 - n;
    if (idx < 0 || idx >= s.loop_blk.len()) { return 0 - 1; }
    return s.loop_blk[idx];
}

// ret_i64arr / ret_dyn / for_wasm decode the ret_arrdyn flag word (bit 0 =
// returns i64[], bit 1 = returns a scalar `dyn Trait`, bit 2 = the wasm
// backend is lowering, so erased-generic slots are typed i64 — #5464) -- the
// folded boolean fields keep LowerState at 33 fields (see the #4554 note in
// lower_func).
pub function (s: LowerState) ret_i64arr(): boolean { return s.ret_arrdyn % 2 == 1; }
pub function (s: LowerState) ret_dyn(): boolean { return (s.ret_arrdyn / 2) % 2 == 1; }
pub function (s: LowerState) for_wasm(): boolean { return (s.ret_arrdyn / 4) % 2 == 1; }
// bit 3: this fn is a wasm-widenable erased pass-through (#5464), so its
// bare-typevar return lowers via the uniform-i64 path in StmtReturn.
pub function (s: LowerState) erased_passthrough(): boolean { return (s.ret_arrdyn / 8) % 2 == 1; }

pub function (s: LowerState) fail(): LowerState {
    return LowerState { ...s, ok: false };
}

// is_arr_ret_fn reports whether `name` is a function returning an array.
pub function (s: LowerState) is_arr_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.arr_ret_fns.len()) {
        if (s.arr_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// is_strarr_ret_fn reports whether `name` is a function returning `string[]`.
pub function (s: LowerState) is_strarr_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.strarr_ret_fns.len()) {
        if (s.strarr_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// slot_of returns the local slot for `name`, or -1 if unbound.
pub function (s: LowerState) slot_of(name: string): i32 {
    // Scan from the END so a name resolves to its MOST-RECENT binding — the
    // innermost lexical scope. A nested-block `var x` shadow appends a fresh
    // slot (add_local), which a sibling/outer reference must NOT see, but the
    // block body must (and the `add_local`-then-`slot_of` pattern wants the
    // just-added slot, not an older same-named one). `lower_block` retires the
    // inner names to `!retired!` on exit, so after the block the outer `x` is
    // found again. First-match here clobbered the outer slot on shadow (#3726).
    var i: i32 = s.locals.len() - 1;
    while (i >= 0) {
        if (s.locals[i].slot_name == name) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

// is_aliased_name reports whether `name` acquires a lasting local alias in this
// function (aliased_array_names_of, computed once in lower_func). Drives the
// in-place-vs-clone choice for the `a = a.with(i, v)` self-reassign (#3599).
pub function (s: LowerState) is_aliased_name(name: string): boolean {
    return util.index_of_str(s.aliased_names, name) >= 0;
}

// add_local binds `name` to a fresh slot (its index = the old slot count),
// not-an-array by default.
pub function (s: LowerState) add_local(name: string): LowerState {
    return LowerState { ...s, locals: s.locals.append(li_new(name)) };
}

// is_arr_slot / mark_arr query and set the array-ness of slot i.
pub function (s: LowerState) is_arr_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_arr;
}

// retire_locals renames every local at index >= `from` to the unfindable
// sentinel "!retired!" (which no real identifier or "$"-temp can equal — and
// retired slots are never looked up by name, so they may share it), removing it
// from name resolution while LEAVING the slot in place. Fern is
// block-scoped (a `var` in an if / match-arm body is not visible after it — the
// checker rejects it), but the IR lowerer allocates slots by name function-wide,
// so a same-named local in a SIBLING scope would otherwise collapse onto one
// slot and inherit conflicting type metadata (the scope-blind-locals bail). A
// block retires the locals it introduced on exit, so a sibling re-declares a
// fresh slot. The slot index space stays MONOTONIC (rename, never truncate), so
// the frame size (n_locals), the exit dec-sweep (which keys off the per-index
// type columns, not names), and the `$tmp + local_names.len()` unique-temp
// scheme are all unaffected. For valid (non-colliding) programs this is a no-op:
// nothing resolves a block-scoped name after its block.
pub function (s: LowerState) retire_locals(from: i32): LowerState {
    // Rename slots [from, len) one at a time via set_local_name (the `.with`
    // pattern mark_arr uses) rather than rebuilding local_names as a fresh array
    // inside the big struct literal — the legacy AST backend (asm.fern) miscompiles
    // the latter's RC (the self-compile still routes through that backend), while
    // `.with` on an existing column is the proven, AST-safe shape.
    var st: LowerState = s;
    var i: i32 = from;
    while (i < st.locals.len()) {
        st = st.set_local_name(i, "!retired!");
        i = i + 1;
    }
    return st;
}

// set_local_name rewrites slot i's NAME (used by retire_locals). Mirrors mark_arr
// exactly — a single `.with` on local_names, every other field carried through —
// so it compiles on the legacy AST backend the self-compile still uses.
pub function (s: LowerState) set_local_name(i: i32, name: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_names(s.locals[i], name)) };
}

pub function (s: LowerState) mark_arr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_arr(s.locals[i], v)) };
}

// is_u32_slot / mark_u32 query and set the u32-ness of slot i (a u32 scalar or
// u32[] array). Drives u32 wrapping (32-bit mask after arithmetic; logical `>>`).
pub function (s: LowerState) is_u32_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_u32;
}
pub function (s: LowerState) mark_u32(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_u32(s.locals[i], v)) };
}
// is_u64_slot / mark_u64 query and set the u64-ness of slot i — drives UNSIGNED
// compare / shift-right / div-rem in the i64 domain (#2904).
pub function (s: LowerState) is_u64_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_u64;
}
pub function (s: LowerState) mark_u64(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_u64(s.locals[i], v)) };
}
// subword_kind_of_slot returns slot i's sub-word int kind ("u8")
// or "". mark_subword sets it. For an array slot the kind is the ELEMENT
// kind (so `a[i]` on a u8[] reads a u8); local_is_arr disambiguates.
pub function (s: LowerState) subword_kind_of_slot(i: i32): string {
    if (i < 0) { return ""; }
    if (i >= s.locals.len()) { return ""; }
    return s.locals[i].subword;
}
pub function (s: LowerState) mark_subword(i: i32, k: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_subword(s.locals[i], k)) };
}

// is_const_fn reports whether `name` is a zero-arg, receiver-less module
// function (a `const`) — so a bare reference to it lowers to a call (#2954).
pub function (s: LowerState) is_const_fn(name: string): boolean {
    return util.index_of_str(s.const_fns, name) >= 0;
}

// is_closure_local / mark_closure_local query and set whether a named local
// holds a closure BOX (i32[] [funcval, caps…]) — so a call `f(args)` through it
// uses the env-passing closure-call form (closures slice 3a).
pub function (s: LowerState) is_closure_local(name: string): boolean {
    return util.index_of_str(s.closure_locals, name) >= 0;
}
// closure_opt_ret returns the Option/Result return type recorded for a closure/
// fn-typed param named `name` (from ParamDecl.fn_ret), or "". Drives Option-type
// recovery for a DIRECT closure-call match scrutinee in try_opt_type.
pub function (s: LowerState) closure_opt_ret(name: string): string {
    var pfx: string = name + "|";
    var i: i32 = 0;
    while (i < s.closure_opt_rets.len()) {
        var e: string = s.closure_opt_rets[i];
        if (e.len() > pfx.len() && e[0 : pfx.len()] + "" == pfx) {
            return e[pfx.len() : e.len()] + "";
        }
        i = i + 1;
    }
    return "";
}
// fn_arg_is_dyn reports whether argument index `ai` of an indirect call through
// the fn-value named `name` targets a `dyn Trait` parameter — so the arg must be
// lowered via lower_dyn_arg (dyn-boxed), not plain lower_expr. Reads the
// "FNDYN:<name>|<comma-separated positions>" seed lower_func plants for each
// fn-typed param carrying dyn positions (parser's fn_param_dyn). #5276.
pub function (s: LowerState) fn_arg_is_dyn(name: string, ai: i32): boolean {
    var pfx: string = "FNDYN:" + name + "|";
    var i: i32 = 0;
    while (i < s.reclaimable_names.len()) {
        var e: string = s.reclaimable_names[i];
        if (e.len() > pfx.len() && e[0 : pfx.len()] + "" == pfx) {
            // The tail is a comma-separated list of dyn positions ("0" / "0,2").
            // Parse each number numerically and test membership of `ai`.
            var cur: i32 = 0;
            var started: boolean = false;
            var pj: i32 = pfx.len();
            while (pj < e.len()) {
                var ch: i32 = e[pj];
                if (ch == 44) {   // 44 = ','
                    if (started && cur == ai) { return true; }
                    cur = 0;
                    started = false;
                } else if (ch >= 48 && ch <= 57) {   // '0'..'9'
                    cur = cur * 10 + (ch - 48);
                    started = true;
                }
                pj = pj + 1;
            }
            return started && cur == ai;
        }
        i = i + 1;
    }
    return false;
}
pub function (s: LowerState) mark_closure_local(name: string): LowerState {
    return LowerState { ...s, closure_locals: s.closure_locals.append(name) };
}

// add_clo_cap_kinds (#4354): record a closure local's per-capture kinds
// ("<name>|<kinds>") in the capture-RC registry — see the field doc.
pub function (s: LowerState) add_clo_cap_kinds(entry: string): LowerState {
    return LowerState { ...s, reclaimable_names: s.reclaimable_names.append("CLO:" + entry) };
}

// clo_cap_kinds_of returns the registered capture-kinds string for closure
// local `name` ("" when not registered / approval never consumed).
pub function (s: LowerState) clo_cap_kinds_of(name: string): string {
    var i: i32 = 0;
    while (i < s.reclaimable_names.len()) {
        var e: string = s.reclaimable_names[i];
        if (e.len() > 4 && e[0:4] == "CLO:") {
            var t: str = e[4 : e.len()];
            var bar: i32 = 0;
            while (bar < t.len() && t[bar] != 124) { bar = bar + 1; }   // 124 = '|'
            if (bar < t.len() && t[0:bar] == name) { return t[bar + 1 : t.len()] + ""; }
        }
        i = i + 1;
    }
    return "";
}

// clo_rc_approved reports whether lower_func approved `name` for capture RC
// (an "OK:<name>" seed entry — see the clo_cap_kinds field doc).
pub function (s: LowerState) clo_rc_approved(name: string): boolean {
    return util.index_of_str(s.reclaimable_names, "CLO:OK:" + name) >= 0;
}

// is_str_slot / mark_str query and set the string-ness of slot i.
pub function (s: LowerState) is_str_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_str;
}

pub function (s: LowerState) mark_str(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_str(s.locals[i], v)) };
}

pub function (s: LowerState) is_strarr_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_strarr;
}

// is_cell_slot / cell_elem_of_slot query a Cell[T] slot (#5510).
pub function (s: LowerState) is_cell_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_cell;
}
pub function (s: LowerState) cell_elem_of_slot(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].cell_elem;
}

pub function (s: LowerState) mark_strarr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_strarr(s.locals[i], v)) };
}

// str_own_slot / mark_str_own query and set the slot-carried string
// OWNERSHIP class (#4297 CS4; see LocalInfo.str_own for the code table).
// An out-of-range slot reads 1 (Borrowed) -- the conservative never-free
// default every unproven binding keeps.
pub function (s: LowerState) str_own_slot(i: i32): i32 {
    if (i < 0) { return 1; }
    if (i >= s.locals.len()) { return 1; }
    return s.locals[i].str_own;
}

pub function (s: LowerState) mark_str_own(i: i32, v: i32): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_str_own(s.locals[i], v)) };
}

// is_struct_slot / struct_type_of_slot / mark_struct_type query and set the
// struct type held by slot i ("" = not a struct).
pub function (s: LowerState) struct_type_of_slot(i: i32): string {
    if (i < 0) { return ""; }
    if (i >= s.locals.len()) { return ""; }
    return s.locals[i].struct_type;
}

pub function (s: LowerState) mark_struct_type(i: i32, t: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_struct_type(s.locals[i], t)) };
}

// mark_opt_type records slot i's Option[T]/Result[T,E] type string, so a later
// `match` on that local can recover the bound payload type.
pub function (s: LowerState) mark_opt_type(i: i32, t: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_opt_type(s.locals[i], t)) };
}

// opt_type_of_slot returns slot i's recorded Option/Result type, or "".
pub function (s: LowerState) opt_type_of_slot(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].opt_type;
}

// mark_tuple_elems records slot i's comma-joined tuple element-type tags.
pub function (s: LowerState) mark_tuple_elems(i: i32, t: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_tuple_elems(s.locals[i], t)) };
}

// tuple_elem_tag returns slot i's Nth tuple element-type tag, or "". The split is
// depth-aware (counting `(`/`[` … `)`/`]`) so a nested tuple element whose own tag
// contains commas — `i32,(i32,i32)` → element 1 is `(i32,i32)` — is recovered
// whole rather than mis-split. A flat encoding never goes above depth 0, so its
// behaviour is unchanged.
pub function (s: LowerState) tuple_elem_tag(i: i32, n: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    var enc: string = s.locals[i].tuple_elems;
    if (enc.len() == 0) { return ""; }
    var depth: i32 = 0;
    var idx: i32 = 0;
    var start: i32 = 0;
    var k: i32 = 0;
    while (k <= enc.len()) {
        if (k == enc.len() || (depth == 0 && enc[k] == 44)) {   // end, or top-level ','
            if (idx == n) { return enc[start : k] + ""; }
            idx = idx + 1;
            start = k + 1;
        } else {
            var ch: i32 = enc[k];
            if (ch == 91 || ch == 40) { depth = depth + 1; }       // '[' '('
            else if (ch == 93 || ch == 41) { depth = depth - 1; }  // ']' ')'
        }
        k = k + 1;
    }
    return "";
}

// csv_nth returns the Nth comma-separated field of `enc` (0-based), or "". The
// split is depth-aware (counting `(`/`[` … `)`/`]`) so a nested tuple element tag
// — `(i32,i32),i64` → field 0 is `(i32,i32)`, field 1 is `i64` — is recovered
// whole. A flat encoding never exceeds depth 0, so its behaviour is unchanged.
pub function csv_nth(enc: string, n: i32): string {
    if (enc.len() == 0) { return ""; }
    var depth: i32 = 0;
    var idx: i32 = 0;
    var start: i32 = 0;
    var k: i32 = 0;
    while (k <= enc.len()) {
        if (k == enc.len() || (depth == 0 && enc[k] == 44)) {   // end, or top-level ','
            if (idx == n) { return enc[start : k] + ""; }
            idx = idx + 1;
            start = k + 1;
        } else {
            var ch: i32 = enc[k];
            if (ch == 91 || ch == 40) { depth = depth + 1; }       // '[' '('
            else if (ch == 93 || ch == 41) { depth = depth - 1; }  // ']' ')'
        }
        k = k + 1;
    }
    return "";
}

// expr_tuple_elem_tag returns the type tag of element N of a tuple expression
// (`t` an ident with tracked element types), or "".
pub function expr_tuple_elem_tag(e: parser.Expr, n: i32, s: LowerState): string {
    match (e) {
        parser.ExprIdent(id) => { return s.tuple_elem_tag(s.slot_of(id.name), n); },
        parser.ExprFieldAccess(fa) => {
            // `t.K.N` where `t.K` is itself a (nested) tuple element: recover the
            // outer element K's tuple-type tag, then read element N out of it.
            if (util.is_all_digits(fa.field)) {
                var ot: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                return tuple_type_elem_tag(ot, n);
            }
            // `p.t.N` where `t` is a tuple struct field — element n's tag from the
            // field's tuple type string.
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            return tuple_type_elem_tag(decl_field_type(s.structs, oty, fa.field), n);
        },
        parser.ExprIndex(ix) => {
            // `arr[i].N` where arr is a `(tuple)[]` array-of-tuples local: the element
            // TUPLE TYPE is recorded on the (is_arr) slot's arrarr_elem (set at binding
            // for a reclaim-eligible tuple array, #4365). Read element n's tag out of it,
            // so `arr[i].N.field` (struct field of a tuple element) and a wide `arr[i].N`
            // read resolve on the IR path instead of bailing to the AST fallback (which
            // fired because expr_struct_type(arr[i].N) had no tag here → lower_expr fail).
            match (ix.array) {
                parser.ExprIdent(aid) => {
                    var asl: i32 = s.slot_of(aid.name);
                    if (asl >= 0 && s.is_arr_slot(asl)) {
                        var et: string = s.arrarr_elem_of_slot(asl);
                        if (et.len() >= 2 && et[0:1] == "(") { return tuple_type_elem_tag(et, n); }
                    }
                },
                _ => {}
            }
            return "";
        },
        parser.ExprCall(tc) => {
            // typed-IR (#5531): a tuple-returning call carries its full
            // "(t0, t1, …)" tag on c.ty (the checker resolved any generic
            // element to a concrete type), so read element n directly. Without
            // it a `f().N` tuple-element read whose element is a struct / nested
            // tuple had no tag here, so `f().N.field` bailed the function to the
            // AST emitter. Unannotated (asm_ir_run / native) leaves c.ty "" →
            // tuple_type_elem_tag("", n) is "" → unchanged (AST fallback).
            return tuple_type_elem_tag(tc.ty, n);
        },
        _ => { return ""; }
    }
    return "";
}

// expr_is_tuple reports whether `e` evaluates to a tuple value: a tuple literal,
// a tuple-tracked local/param, or a tuple-typed element of an enclosing tuple
// (`t.N` whose element tag is itself `(…)`). Drives admitting a nested tuple as a
// (leak-only, one-pointer) element of another tuple.
pub function expr_is_tuple(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprTuple(_) => { return true; },
        parser.ExprIdent(id) => { return s.tuple_elem_tag(s.slot_of(id.name), 0) != ""; },
        parser.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                var ot: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                return ot.len() >= 2 && ot[0:1] == "(";
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_result reports whether `e` evaluates to a Result value: a bare `Ok(x)`
// / `Err(x)` construction, or a Result-typed local/param. Drives admitting a
// Result as a (leak-only, one-pointer) tuple element. The full `Result[T, E]`
// tag is recovered from the binding's annotation (a bare `Ok(x)` cannot name E),
// so this only gates ADMISSION, not the tag.
pub function expr_is_result(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => { return (cid.name == "Ok" || cid.name == "Err") && c.args.len() == 1; },
                _ => { return false; }
            }
        },
        parser.ExprIdent(id) => {
            var ot: string = s.opt_type_of_slot(s.slot_of(id.name));
            return ot.len() >= 7 && ot[0:7] == "Result[";
        },
        _ => { return false; }
    }
    return false;
}

// literal_is_i64 reports whether a non-negative integer literal text is too big
// for i32 (so it is an i64 value): >10 digits always, exactly 10 digits if it
// exceeds i32-max "2147483647". (Negative literals are unary minus over a
// positive literal, so the sign is handled separately.)
pub function literal_is_i64(text: string): boolean {
    var n: i32 = text.len();
    if (n > 10) { return true; }
    if (n < 10) { return false; }
    var m: string = "2147483647";
    var i: i32 = 0;
    while (i < 10) {
        if (text[i] > m[i]) { return true; }
        if (text[i] < m[i]) { return false; }
        i = i + 1;
    }
    return false;
}

// fn_value_arg_name returns the function name if `e` is a bare identifier that
// names no local (so it refers to a top-level function — a function-value
// candidate), else "". The caller pairs this with callee_param_is_fn to confirm
// the argument position actually expects a function value.
pub function fn_value_arg_name(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprIdent(id) => {
            if (s.slot_of(id.name) < 0) { return id.name; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// fn_value_array_lit reports whether `e` is an `(() => T)[]` (spelled "fn[]")
// field/binding value that is an all-fn-VALUE array literal: an ExprArray whose
// EVERY element is a bare identifier naming a top-level function (a fn pointer),
// never a local, a capturing-lambda box, or a `__mkclo$` closure marker. The
// lift pass turns a NON-capturing lambda element into a hoisted `__lam_N` fn-name
// (lift_expr_walk's ExprArray arm), so `[() => 7]` reaches here as `[__lam_0]` —
// the SAME shape as `[inc, dbl]`. A capturing lambda stays a `__mkclo$` marker
// (fn_value_arg_name declines it), keeping the whole literal off this path so it
// stays a closure array. The construction (ExprStructLit) lowering emits
// op_const_func per element + op_arr_make, storing a plain fn-pointer array; the
// whole-program registry (fnptr_arr_fields_of) records the field so the read side
// dispatches it as a fn pointer, not a closure box.
pub function fn_value_array_lit(e: parser.Expr, field_type: string, s: LowerState): boolean {
    if (field_type != "fn[]") { return false; }
    match (e) {
        parser.ExprArray(a) => {
            if (a.elements.len() == 0) { return false; }
            var i: i32 = 0;
            while (i < a.elements.len()) {
                if (fn_value_arg_name(a.elements[i], s) == "") { return false; }
                i = i + 1;
            }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// ident_is_fn_value reports whether a bare ident lowers to a function VALUE
// (op_const_func) rather than a local load / `None` / unit-variant box / const
// call — i.e. it names a top-level function WITH params. Mirrors the ExprIdent
// lowering's const_func fall-through (so a tuple-element tag matches what the
// element actually emits): not a local slot, not `None`, not a struct / unit
// variant name, and not a const (a 0-arg receiver-less fn). const_funcs_only_known
// still backstops a bogus name — if the tag says "fn" the element emits a
// const_func, and an unknown function bails the whole module either way.
pub function ident_is_fn_value(name: string, s: LowerState): boolean {
    if (s.slot_of(name) >= 0) { return false; }
    if (name == "None") { return false; }
    if (decl_is_struct(s.structs, name)) { return false; }
    if (s.is_const_fn(name)) { return false; }
    return true;
}

// elem_type_tag computes the type tag of an expression for tuple-element typing:
// expr_opt_elem_tag returns the COMMA-FREE Option type spelling of a tuple
// element that is an Option value (`Some(7)` → "Option[i32]", `Some("x")` →
// "Option[string]"), or "" otherwise. Comma-free is required because the tuple-
// element tag encoding (mark_tuple_elems / tuple_elem_tag) splits on commas, so
// `Result[T, E]` (which has one) is deliberately NOT recovered here — a Result
// element stays on the AST path (#3018). Only a `Some(<scalar/string>)`
// construction or an Option-typed local/param is admitted (a leak-only box, one
// pointer slot, like a struct element); a `None` with no statically-known
// payload, or a nested Option, falls through to "".
pub function expr_opt_elem_tag(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "Some" && c.args.len() == 1) {
                        var pt: string = elem_type_tag(c.args[0], s);
                        // "clo": a closure-BOX payload (`Some(<lambda>)` — the
                        // lift wrapped it into a `__mkclo$…` env box). One
                        // pointer slot; the match arm marks the binding a
                        // closure local so `f(args)` dispatches env-first.
                        if (pt == "i32" || pt == "string" || pt == "i64" || pt == "f64" || pt == "boolean" || pt == "clo") {
                            return "Option[" + pt + "]";
                        }
                        return "";
                    }
                    var rt: string = resolve_argref_opt_type(s.opt_ret_type(cid.name), c.args, s);
                    if (rt.len() >= 8 && rt[0:7] == "Option[") { return rt; }
                    return "";
                },
                _ => { return ""; }
            }
        },
        parser.ExprIdent(id) => {
            var ot: string = s.opt_type_of_slot(s.slot_of(id.name));
            if (ot.len() >= 8 && ot[0:7] == "Option[") { return ot; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// some_opt_type returns the "Option[T]" type of a DIRECT `Some(x)` construction
// whose payload type T is statically recoverable (scalar / string / struct), or
// "" otherwise. Lets a `var o = Some(7)` local record its opt_type and a direct
// `match (Some(7))` scrutinee recover the payload — the construction analogue of
// the call-returns-Option path (opt_ret_fns). `Ok`/`Err` are NOT handled: a
// direct `Ok(x)` can't determine the Result's `E` arm (it needs an annotation,
// handled separately). A nested-OPTION payload (`Some(Some(5))` →
// "Option[Option[i32]]") IS recovered — the StmtMatch payload binding marks the
// inner Option type (mark_opt_type) so a nested `match (b)` resolves it. A
// nested-RESULT payload (whose type spelling carries a comma) and a fn payload
// are deferred ("").
pub function some_opt_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "Some" && c.args.len() == 1) {
                        // A Some whose payload is itself an Ok/Err (Result)
                        // construction can't be fully typed here: a bare `Ok(x)`
                        // doesn't name the Result's E arm, and elem_type_tag
                        // defaults such a payload to "i32" — which would mis-record
                        // `Option[Result[T, E]]` as `Option[i32]`. Return "" so the
                        // binding's annotation (the authoritative full type) wins.
                        if (expr_is_result(c.args[0], s)) { return ""; }
                        var pt: string = elem_type_tag(c.args[0], s);
                        if (pt == "fn") { return ""; }
                        if (pt.len() >= 7 && pt[0:7] == "Result[") { return ""; }
                        return "Option[" + pt + "]";
                    }
                    return "";
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// opt_recv_base_type returns "Option" / "Result" if `e` is an Option/Result
// VALUE — an opt-typed local/param, a direct `Some(x)`, or an Option/Result-
// returning free call — else "". It's the dispatch base for an Option/Result-
// RECEIVER method (`Some(5).map(...)` / `r.map(...)`): the method is keyed
// "Option.<m>" / "Result.<m>" (base_type_name of the receiver type), so a
// `var x = <opt>.m()` binding or a `match (<opt>.m())` scrutinee recovers the
// result's Option/Result type via opt_ret_type. #3049.
pub function opt_recv_base_type(e: parser.Expr, s: LowerState): string {
    var t: string = "";
    match (e) {
        parser.ExprIdent(id) => { t = s.opt_type_of_slot(s.slot_of(id.name)); },
        // `b.v` where `v` is an Option/Result struct field, or `t.N` where the
        // tuple element is an Option/Result — lets `b.v.uo(...)` / `match (b.v)`
        // dispatch on the field value (#3069).
        parser.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                var tt: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                if (tt.len() >= 8 && (tt[0:7] == "Option[" || tt[0:7] == "Result[")) { t = tt; }
            } else {
                var foty: string = expr_struct_type(fa.obj, s);
                if (foty != "") {
                    var fft: string = decl_field_type(s.structs, foty, fa.field);
                    if (fft.len() >= 8 && (fft[0:7] == "Option[" || fft[0:7] == "Result[")) { t = fft; }
                }
            }
        },
        parser.ExprCall(c) => {
            t = some_opt_type(e, s);
            if (t == "") {
                match (c.callee) {
                    parser.ExprIdent(cid) => { t = resolve_argref_opt_type(s.opt_ret_type(cid.name), c.args, s); },
                    // `b.find()` where b's method returns Option/Result — keyed
                    // "<Type>.<method>" (struct receiver) or "Option.<m>" /
                    // "Result.<m>" (an Option/Result-receiver method, recursively).
                    // Lets a chained `b.find().map(...)` recover the inner result
                    // (#3066).
                    parser.ExprFieldAccess(cfa) => {
                        // A built-in array method returning Option (`xs.min()`) —
                        // helper-backed, so its return type comes from the registry
                        // rather than the module's own funcs.
                        var aok: boolean = false;
                        t = builtin_arr_opt_ret_type(cfa.field, cfa.obj, s);
                        if (t != "") { aok = true; }
                        // Associated call `Type.method()` returning Option/Result
                        // — the object is a bare TYPE name (not a slot), so key
                        // opt_ret_type by "<Type>.<method>" directly (mirrors
                        // expr_struct_type's associated arm). Recovers an
                        // unannotated `match (User.from_json(s))`'s Result[User,
                        // string] payload types — the @derive(Json) deserialiser.
                        match (cfa.obj) {
                            parser.ExprIdent(tid) => {
                                if (s.slot_of(tid.name) < 0) {
                                    var art: string = s.opt_ret_type(tid.name + "." + cfa.field);
                                    if (art != "") { t = art; aok = true; }
                                }
                            },
                            _ => {}
                        }
                        if (!aok) {
                            var mrty: string = expr_struct_type(cfa.obj, s);
                            if (mrty != "") { t = s.opt_ret_type(mrty + "." + cfa.field); }
                            else {
                                var mrb: string = opt_recv_base_type(cfa.obj, s);
                                if (mrb != "") { t = s.opt_ret_type(mrb + "." + cfa.field); }
                                // An ENUM-receiver method returning Option/Result, called
                                // on a fresh variant (`V(7).get()`) — key "<Enum>.<m>"
                                // via the variant's enum_owner (#3076).
                                else {
                                    var men: string = expr_enum_type(cfa.obj, s);
                                    if (men != "") { t = s.opt_ret_type(men + "." + cfa.field); }
                                }
                            }
                        }
                    },
                    _ => {}
                }
            }
        },
        _ => {}
    }
    if (t.len() >= 7 && t[0:7] == "Option[") { return "Option"; }
    if (t.len() >= 7 && t[0:7] == "Result[") { return "Result"; }
    return "";
}

// "string" for a string, a struct type name for a struct, "fn" for a function
// value, "Option[T]" for an Option value, "i64"/"f64" for an 8-byte scalar, else
// "i32" (scalar). The 8-byte tags drive the wasm tuple's per-element
// i64.store/load vs f64.store/load (and route i64 through lower_i64); "fn" lets
// `t.N(args)` recover the element's callability; "Option[T]" lets `match (t.N)`
// recover the payload.
pub function elem_type_tag(e: parser.Expr, s: LowerState): string {
    if (expr_is_str(e, s)) { return "string"; }
    // A closure-BOX element: a `__mkclo$…` env-box constructor (what the lift
    // pass rewrites every lambda / bare-fn tuple element to), a call to a
    // closure-returning fn, or an ident bound to a closure local. Tagged
    // "clo" — one pointer slot holding the box — so `t.N(args)` dispatches
    // env-first (push the box as __env, the args, then box[0] as the target),
    // NOT the bare call_indirect the plain "fn" pointer tag gets. Matches the
    // DECLARED-type tag (tuple_elem_tags maps an "fn" segment to "clo"), so a
    // factory-returned tuple and a local literal agree.
    match (e) {
        parser.ExprCall(cloc) => {
            match (cloc.callee) {
                parser.ExprIdent(clocid) => {
                    if (clocid.name.len() > 8 && clocid.name[0:8] == "__mkclo$") { return "clo"; }
                    if (util.index_of_str(s.closure_fns, clocid.name) >= 0) { return "clo"; }
                },
                _ => {}
            }
        },
        parser.ExprIdent(cloid) => { if (s.is_closure_local(cloid.name)) { return "clo"; } },
        _ => {}
    }
    // A bare fn-name element (`(inc, 5)`): a function VALUE (a plain fn pointer,
    // one slot), tagged "fn" so `t.N(args)` lowers to tuple_get + call_indirect.
    // (Rare post-lift: the lift pass wraps unshadowed module-fn idents in tuple
    // literals into `__mkclo$` boxes, which the "clo" arm above catches.)
    match (e) {
        parser.ExprIdent(fid) => { if (ident_is_fn_value(fid.name, s)) { return "fn"; } },
        _ => {}
    }
    // An Option element (`(Some(7), 3)`): tag "Option[T]" so a later
    // `match (t.N)` recovers the payload type (a leak-only pointer slot).
    var optag: string = expr_opt_elem_tag(e, s);
    if (optag != "") { return optag; }
    // A Map element (`(Map { … }, x)`): tag it with its full `Map[K, V]` type so
    // a later `t.N.get_or(…)` dispatches as a map op (the map sibling of the
    // struct / Option element tags). The element is a heap-map POINTER — one
    // slot, leak-only like a struct element — so only the tag carries it. #3317.
    var maptag: string = expr_map_type_tag(e, s);
    if (maptag != "") { return maptag; }
    var st: string = expr_struct_type(e, s);
    if (st != "") { return st; }
    // A typed-ARRAY element (`(["a","b"], x)` / `([P{..}], x)` / `([x as i64], y)`):
    // tag it with the element-typed array spelling so a later `t.N[i]` reads at
    // the right type/width — `string[]` for the string-pointer element reads,
    // `f64[]`/`i64[]` for the 8-byte f64/i64 element reads, `P[]` to recover the
    // element struct type for `t.N[i].field`. Scalar i32[]/u32[]/boolean[]
    // arrays keep the bare "i32" tag — they need no element typing (`t.N[i]` is
    // a 4-byte scalar read) and broadening them would disturb the shared
    // destructure / kind-string consumers. The array element itself is a
    // POINTER stored in one slot (#3353), so only the tag carries the element
    // type; the width-aware `t.N[i]` read is in arr_index_is_f64 /
    // arr_index_is_i64's tuple-element cases.
    if (expr_is_strarr(e, s)) { return "string[]"; }
    if (expr_is_f64arr(e, s)) { return "f64[]"; }
    if (expr_is_i64arr(e, s)) { return "i64[]"; }
    match (e) {
        parser.ExprArray(sae) => {
            if (sae.elements.len() > 0) {
                var sel: string = expr_struct_type(iife_leaf_value(sae.elements[0]), s);
                if (sel != "" && decl_is_struct(s.structs, sel)) { return sel + "[]"; }
            }
        },
        _ => {}
    }
    if (expr_is_f64(e, s)) { return "f64"; }
    if (infer_expr_width(e, s) == 64) { return "i64"; }
    // A bare integer literal too big for i32 is an i64 (an i64-typed local /
    // expr is already caught by infer_expr_width above).
    match (e) {
        parser.ExprNumber(num) => { if (!num.is_float && literal_is_i64(num.text)) { return "i64"; } },
        _ => {}
    }
    // A NESTED tuple element (`(1, (2, 3))`): tag it with its own tuple type
    // spelling `(t0,t1,…)` (no spaces) built recursively, so the element reads
    // back as a tuple for `t.N.M`. The element itself is a heap-tuple POINTER —
    // one slot, like a struct/array/Option element — so it needs no new op; only
    // the tag carries the nesting. The comma-joined slot encoding is decoded
    // depth-aware (tuple_elem_tag / tuple_type_elem_tag), so the inner commas
    // don't split the outer tag.
    match (e) {
        parser.ExprTuple(tl) => {
            var nt: string = "(";
            var ni: i32 = 0;
            while (ni < tl.elements.len()) {
                if (ni > 0) { nt = nt + ","; }
                nt = nt + elem_type_tag(tl.elements[ni], s);
                ni = ni + 1;
            }
            return nt + ")";
        },
        _ => {}
    }
    return "i32";
}

pub function (s: LowerState) mark_map_type(i: i32, t: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_map_type(s.locals[i], t)) };
}
pub function (s: LowerState) mark_cell(i: i32, t: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_cell(s.locals[i], t)) };
}
pub function (s: LowerState) map_type_of(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].map_type;
}

// expr_map_kind reports a map EXPRESSION's key kind — 1 for i32 keys, 0 for
// string keys, -1 if `e` is not a map. Unlike map_type_of (which only types a
// map LOCAL slot), this recognises the chained map-construction expressions a
// `Map { k: v, … }` literal desugars to: `map_new[_i32](n).insert(k0,v0)
// .insert(k1,v1)…`. `map_new` fixes the key kind (string), `map_new_i32` (i32),
// and an `.insert` / `.set` / `.delete` mutator returns the same map — so the
// kind propagates up the chain. Lets `.insert` on a map-typed call result lower
// through the IR (#2884 follow-up: Map literals), not just on a bare local.
pub function expr_map_kind(e: parser.Expr, s: LowerState): i32 {
    match (e) {
        parser.ExprIdent(id) => {
            var mt: string = s.map_type_of(s.slot_of(id.name));
            if (mt != "") { return map_key_kind_of(mt); }
            return 0 - 1;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "map_new" && c.args.len() == 1) { return 0; }
                    if (cid.name == "map_new_i32" && c.args.len() == 1) { return 1; }
                    return 0 - 1;
                },
                parser.ExprFieldAccess(cfa) => {
                    if (cfa.field == "insert" || cfa.field == "set" || cfa.field == "delete") {
                        return expr_map_kind(cfa.obj, s);
                    }
                    return 0 - 1;
                },
                _ => { return 0 - 1; }
            }
        },
        _ => { return 0 - 1; }
    }
    return 0 - 1;
}

// expr_map_type_tag returns the full "Map[K, V]" type of a map EXPRESSION — a
// `Map { … }` literal's `map_new[_i32](n).insert(…)` desugar chain, or a map-
// typed local that already carries a full tag — or "" if `e` is not a map. K
// comes from expr_map_kind (1 = i32, 0 = string); V from the outermost
// `.insert`'s value arg (string if that arg is a string, else i32). Mirrors the
// unannotated map-binding inference in lower_stmt so a map in a NON-local
// position (a tuple element) recovers a tag is_map_type_name / map_key_kind_of /
// map_value_of accept. #3317.
pub function expr_map_type_tag(e: parser.Expr, s: LowerState): string {
    // typed-IR (#5531): a map-returning call carries its full "Map[K, V]" tag on
    // c.ty, so read it instead of re-deriving via the map_ret_fns registry.
    // Guarded to a well-formed Map[…] tag; anything else falls through to the
    // structural walk below (which also covers map locals and struct fields).
    match (e) {
        parser.ExprCall(mc0) => { if (is_map_type_name(mc0.ty)) { return mc0.ty; } },
        _ => {}
    }
    // A map-typed local already carries its full tag — reuse it directly.
    match (e) {
        parser.ExprIdent(mid) => {
            var lt: string = s.map_type_of(s.slot_of(mid.name));
            if (is_map_type_name(lt)) { return lt; }
        },
        // A Map-typed struct FIELD (`r.caps` where `caps: Map[K, V]`): recover the
        // field's declared Map[K, V] from the receiver struct, so a map op on it
        // (`r.caps.get(k)` / `.len()` / …) resolves its K/V instead of falling
        // through to the scalar tag.
        parser.ExprFieldAccess(mfa) => {
            var fsty: string = expr_struct_type(mfa.obj, s);
            if (fsty != "") {
                var fmt: string = decl_field_type(s.structs, fsty, mfa.field);
                if (is_map_type_name(fmt)) { return fmt; }
            }
        },
        _ => {}
    }
    // A call to a map-RETURNING function (`(mk(), 3)` / `(f.mk(), 3)` — the
    // tuple-element sibling of the unannotated `var m = f()` inference):
    // recover the full Map[K, V] from the map_ret_fns registry
    // ("name|Map[K,V]" for free fns, "<BaseType>.<method>|Map[K,V]" for
    // methods, the receiver type resolved via expr_struct_type). This was
    // #3317's missing arm — without it a call-built map element fell through
    // to the scalar "i32" tag and a later `t.N.get_or(…)` / `t.N.len()`
    // mis-dispatched (silently returning the -1 unknown-method shim).
    var mrkey: string = "";
    match (e) {
        parser.ExprCall(mrc) => {
            match (mrc.callee) {
                parser.ExprIdent(mrcid) => { mrkey = mrcid.name; },
                parser.ExprFieldAccess(mrfa) => {
                    var mrrt: string = expr_struct_type(mrfa.obj, s);
                    if (mrrt != "") { mrkey = mrrt + "." + mrfa.field; }
                },
                _ => {}
            }
        },
        _ => {}
    }
    if (mrkey != "") {
        var mri: i32 = 0;
        while (mri < s.map_ret_fns.len()) {
            var mre: string = s.map_ret_fns[mri];
            var mrb: i32 = 0;
            while (mrb < mre.len() && mre[mrb] != 124) { mrb = mrb + 1; }   // '|'
            if (mrb < mre.len() && mre[0:mrb] == mrkey) { return mre[mrb + 1 : mre.len()] + ""; }
            mri = mri + 1;
        }
    }
    var kk: i32 = expr_map_kind(e, s);
    if (kk < 0) { return ""; }
    var ktag: string = "string";
    if (kk == 1) { ktag = "i32"; }
    var vtag: string = "i32";
    match (e) {
        parser.ExprCall(vc) => {
            match (vc.callee) {
                parser.ExprFieldAccess(vfa) => {
                    if (vfa.field == "insert" && vc.args.len() == 2) {
                        if (expr_is_str(vc.args[1], s)) { vtag = "string"; }
                        // A 64-bit insert value (a u64/i64 cast, a wide literal,
                        // a 64-bit local) makes the inferred V 64-bit, so an
                        // UNANNOTATED `var m = Map { 1: big }` binding records a
                        // 64-bit value tag and the get_or read side width/sign-
                        // tracks it — without this the slot recorded
                        // `Map[K, i32]` and a chained `m.get_or(...) >> 58`
                        // lowered 32-bit signed on the IR path (#5253 follow-up).
                        else if (expr_is_u64(vc.args[1], s)) { vtag = "u64"; }
                        else if (expr_is_f64(vc.args[1], s)) { vtag = "f64"; }
                        else if (infer_expr_width(vc.args[1], s) == 64) { vtag = "i64"; }
                    }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return "Map[" + ktag + ", " + vtag + "]";
}

// insert_value_is_ptr: does the map-insert VALUE expr `e` produce a heap POINTER
// (string / struct / string-array)? It drives the wasm `vis` flag —
// $__fern_map_set retains a pointer value and $__fern_map_release deep-releases
// it. Mirrors the wasm AST path's `is_string_expr || struct || array` check. Used
// at the insert-lowering sites IN ADDITION to the receiver-derived map value
// type, because the FIRST insert of a chain (`map_new_i32().insert(k, v)`) has a
// receiver whose value type isn't inferred yet (bare map_new → defaults to i32),
// so a string value there would otherwise emit vis=0 and leak — its box is then
// never freed by $__fern_map_release (the #4353 wasm-IR value-release gap).
// map_value_wide (#5253): the map's VALUE column is an 8-byte scalar, so its
// values() column elements read with the 8-byte arr_get forms and the
// op_map_values op carries the valwide flag (which keeps such modules off the
// i32-celled wasm map runtime — wasm_ir_deferrals_ok).
function map_value_wide(vt: string): boolean {
    return vt == "i64" || vt == "u64" || vt == "f64";
}

// map_value_widekind (#5253): 8-byte VALUE-column discriminator for the map ops
// that the wasm IR path handles differently per width — 0 narrow (i32/pointer),
// 1 i64/u64 (wasm boxes an 8-byte cell into the i32 column), 2 f64 (wasm defers
// to AST). The register backends store 8-byte regardless and ignore it.
function map_value_widekind(vt: string): i32 {
    if (vt == "i64" || vt == "u64") { return 1; }
    if (vt == "f64") { return 2; }
    return 0;
}

// get_or_recv_map_type (#5253 follow-up): resolve the Map[K, V] type of a
// `.get_or(k, d)` RECEIVER for the width/sign predicates (infer_expr_width /
// expr_is_u64 / lower_i64), mirroring the receiver shapes the map-op LOWERING
// itself dispatches on. expr_map_type_tag covers a map-typed local, a
// map-returning call, and a literal chain — but NOT a Map struct field
// (`c.m.get_or(...)`), a map tuple element, or a map array element, so a
// 64-bit-valued read through those receivers width-tracked 32 and a chained
// shift picked the SIGNED form even though the lowering site stored/read the
// column full-width (a silent on-IR miscompile). Returns "" when the receiver
// isn't a map.
function get_or_recv_map_type(obj: parser.Expr, s: LowerState): string {
    var mt: string = expr_map_type_tag(obj, s);
    if (is_map_type_name(mt)) { return mt; }
    match (obj) {
        parser.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                var tt: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                if (is_map_type_name(tt)) { return tt; }
            } else {
                var oty: string = expr_struct_type(fa.obj, s);
                if (oty != "") {
                    var ft: string = decl_field_type(s.structs, oty, fa.field);
                    if (is_map_type_name(ft)) { return ft; }
                }
            }
        },
        parser.ExprIndex(ix) => {
            match (ix.array) {
                parser.ExprIdent(aid) => {
                    var asl: i32 = s.slot_of(aid.name);
                    if (asl >= 0 && s.is_arr_slot(asl) && is_map_type_name(s.map_type_of(asl))) { return s.map_type_of(asl); }
                },
                _ => {}
            }
        },
        _ => {}
    }
    return "";
}

function insert_value_is_ptr(e: parser.Expr, s: LowerState): boolean {
    if (expr_is_str(e, s)) { return true; }
    if (expr_struct_type(e, s).len() > 0) { return true; }
    if (expr_is_strarr(e, s)) { return true; }
    return false;
}

// map_insert_val_is_i64: should a map insert/set VALUE (or a get_or DEFAULT) be
// lowered as an 8-byte i64/u64? The map's declared value type (map_value_of)
// answers when the receiver's tag is known, but the FIRST insert of a `Map { … }`
// literal chain has a receiver whose value type isn't inferred yet (bare
// map_new → i32 default — see insert_value_is_ptr's note), so also treat a
// 64-bit-width value EXPRESSION (`5000000007`, an i64/u64 local) as i64. Without
// this the value lowered as op_const_i32 and TRUNCATED to 32 bits before the
// 8-byte store (#5253 symptom 1). f64 values ride their own path, not this one.
function map_insert_val_is_i64(mtype: string, e: parser.Expr, s: LowerState): boolean {
    var vt: string = map_value_of(mtype);
    if (vt == "i64" || vt == "u64") { return true; }
    return infer_expr_width(e, s) == 64 && !expr_is_f64(e, s);
}

pub function (s: LowerState) mark_i64(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_i64(s.locals[i], v)) };
}
pub function (s: LowerState) is_i64_slot(i: i32): boolean {
    if (i < 0) { return false; }
    // u64 lives in the i64 64-bit domain: a u64 SCALAR slot is i64-wide (its
    // unsigned ops are selected separately via is_u64_slot / expr_is_u64). So a
    // slot is "i64" for width/lowering purposes if it's marked i64 OR u64 — but
    // NOT when it is an ARRAY slot: a u64[] slot holds an array POINTER (i32 on
    // wasm32), not a 64-bit scalar, and its u64-ness is about its ELEMENTS (read
    // 8-byte via is_i64arr, unsigned via is_arr && is_u64). Declaring such a slot
    // a 64-bit local would type the pointer as i64 and the wasm verifier rejects
    // the array-make (i32 pointer into an i64 local). The element width/signedness
    // is handled at the element read, independent of the slot's own width.
    if (i < s.locals.len() && s.locals[i].is_arr) { return false; }
    if (i < s.locals.len() && s.locals[i].is_u64) { return true; }
    if (i >= s.locals.len()) { return false; }
    return s.locals[i].is_i64;
}
// is_i32_scalar_slot reports whether slot i holds a 32-bit (or sub-32) INTEGER
// scalar — a plain i32, a u32, or a subword (bool/u8) — but NOT
// i64/u64, NOT a float, and NOT any heap/pointer type (string, array of any
// kind, struct, Option/Result, tuple, map). It gates the implicit i32->i64
// widening in lower_i64's ExprIdent leaf: such a leaf can be sign/zero-extended
// into an i64 context (`s64 + i`, a for-range loop var accumulated into an i64)
// instead of bailing the whole module to the AST path. The extend's signedness
// is chosen by the caller (is_u32_slot -> zero-extend; otherwise sign-extend,
// which is also correct for a subword already loaded sign-correct in 32 bits).
pub function (s: LowerState) is_i32_scalar_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (s.is_i64_slot(i)) { return false; }
    if (s.is_f64_slot(i)) { return false; }
    if (s.is_f32_slot(i)) { return false; }
    if (s.is_str_slot(i)) { return false; }
    if (s.is_strarr_slot(i)) { return false; }
    if (s.is_arr_slot(i)) { return false; }
    if (s.is_f64arr_slot(i)) { return false; }
    if (s.is_i64arr_slot(i)) { return false; }
    if (s.is_closurearr_slot(i)) { return false; }
    if (s.is_fnarr_slot(i)) { return false; }
    if (s.is_arrarr_slot(i)) { return false; }
    // A u32 SCALAR slot (arrays already excluded above) is a 32-bit integer
    // scalar even though some var-decl paths spuriously record its type tag in
    // local_struct_type ("u32"); is_u32_slot is the authoritative signal, so
    // admit it before the struct/opt/tuple/map heap-type exclusions below — those
    // would otherwise reject it on the bogus "u32" struct tag, leaving `u64 + u32`
    // (the only context an unsigned 32-bit leaf can appear; the checker forbids
    // i64 + u32) stuck on the AST path.
    if (s.is_u32_slot(i)) { return true; }
    if (s.struct_type_of_slot(i).len() > 0) { return false; }
    if (s.opt_type_of_slot(i).len() > 0) { return false; }
    if (i < s.locals.len() && s.locals[i].tuple_elems.len() > 0) { return false; }
    if (i < s.locals.len() && s.locals[i].map_type.len() > 0) { return false; }
    return true;
}
pub function (s: LowerState) mark_f64(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_f64(s.locals[i], v)) };
}
pub function (s: LowerState) is_f64_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_f64;
}
// mark_f32 / is_f32_slot query and set whether slot i holds an f32 value (a
// strict overlay on is_f64: an f32 slot is ALSO is_f64 for storage/arith, but
// carries the f32 type tag for "f32.<method>" dispatch). Mirrors mark_f64.
pub function (s: LowerState) mark_f32(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_f32(s.locals[i], v)) };
}
pub function (s: LowerState) is_f32_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_f32;
}
// is_f64arr_slot / mark_f64arr query and set whether slot i holds an f64[]
// array (8-byte element width on wasm). The element-width driver for a[i].
pub function (s: LowerState) is_f64arr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_f64arr;
}
pub function (s: LowerState) mark_f64arr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_f64arr(s.locals[i], v)) };
}
// is_i64arr_slot / mark_i64arr query and set whether slot i holds an i64[]
// array (8-byte i64 elements). The driver for a[i] -> arr_get_i64.
pub function (s: LowerState) is_i64arr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_i64arr;
}
pub function (s: LowerState) mark_i64arr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_i64arr(s.locals[i], v)) };
}

// is_closurearr_slot / mark_closurearr query and set whether slot i holds a
// closure[] (array of function values). Drives the closure-typing of a local
// bound from such an array's element so `c()` unpacks the closure box.
pub function (s: LowerState) is_closurearr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_closurearr;
}
pub function (s: LowerState) mark_closurearr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_closurearr(s.locals[i], v)) };
}
// is_fnarr_slot / mark_fnarr query and set whether slot i holds a PLAIN-fn-pointer
// array (`(() => T)[]` of bare named-fn values). Parallels is_closurearr_slot but
// drives PLAIN call_indirect dispatch (not env-first): a `.append(f)` of a bare
// 0-arg fn name onto such a slot emits const_func (the pointer) instead of
// const-calling f. (#3574)
pub function (s: LowerState) is_fnarr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_fnarr;
}
pub function (s: LowerState) mark_fnarr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_fnarr(s.locals[i], v)) };
}
// is_arrarr_slot / mark_arrarr query and set whether slot i holds an array-of-
// arrays (`T[][]`), so a local bound from its element a[i] is typed is_arr.
pub function (s: LowerState) is_arrarr_slot(i: i32): boolean {
    if (i < 0 || i >= s.locals.len()) { return false; }
    return s.locals[i].is_arrarr;
}
pub function (s: LowerState) mark_arrarr(i: i32, v: boolean): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_is_arrarr(s.locals[i], v)) };
}
// arrarr_elem_of_slot / mark_arrarr_elem query and set the INNER element kind of a
// T[][] slot ("i64"/"f64"/""), so a nested read a[i][j] can pick the 8-byte load
// for an i64/f64 inner element instead of truncating to 32 bits (#2691).
pub function (s: LowerState) arrarr_elem_of_slot(i: i32): string {
    if (i < 0 || i >= s.locals.len()) { return ""; }
    return s.locals[i].arrarr_elem;
}
pub function (s: LowerState) mark_arrarr_elem(i: i32, kind: string): LowerState {
    return LowerState { ...s, locals: s.locals.with(i, li_set_arrarr_elem(s.locals[i], kind)) };
}

// variant_enum_owner returns the enum a variant struct belongs to
// (StructDecl.enum_owner, set when the parser desugars an enum's variants),
// or "" if `name` isn't a known enum variant. Lets the IR path recover a
// freshly-constructed variant's enum type for `<Enum>.<method>` dispatch.
pub function variant_enum_owner(structs: parser.StructDecl[], name: string): string {
    var vi: i32 = 0;
    while (vi < structs.len()) {
        if (structs[vi].name == name) { return structs[vi].enum_owner; }
        vi = vi + 1;
    }
    return "";
}

// expr_enum_type returns the enum type an expression evaluates to when it is a
// variant CONSTRUCTION (`Has(x)` — a call to a variant name) or a bare unit
// variant (`A`, not a local), else "". Used to dispatch a method called
// directly on a freshly-constructed variant (`Has(5).eq(…)`) to
// `<Enum>.<method>`; an enum value held in a LOCAL is already typed via the
// slot's struct_type, so this only covers the fresh-construction receiver.
pub function expr_enum_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(id) => { return variant_enum_owner(s.structs, id.name); },
                // Qualified payload construction `Enum.Variant(args)` — the
                // variant is the field, confirmed against the bare enum name.
                parser.ExprFieldAccess(cfa) => { return qualified_variant_enum(cfa, s); },
                // An enum-valued if-/match-EXPRESSION (`var c = if (b) {
                // Circle(2) } else { Square(3) }`) stays an inline 0-arg IIFE —
                // its variant constructors read as captures, so lift_lambdas
                // leaves it as ExprLambda. Its enum type is the leaf branch's
                // variant owner (iife_leaf_value unwraps any nesting), so the
                // bound local types as the enum and `c.method()` dispatches.
                parser.ExprLambda(_) => { return expr_enum_type(iife_leaf_value(e), s); },
                _ => { return ""; }
            }
        },
        parser.ExprIdent(id) => {
            if (s.slot_of(id.name) < 0) { return variant_enum_owner(s.structs, id.name); }
            return "";
        },
        // Qualified UNIT variant `Enum.Variant` (no call) — e.g. `Dir.N`. Without
        // this an unannotated `var d = Dir.N` left d untyped, so `d.method()` and
        // `Dir.N.method()` couldn't dispatch to `<Enum>.<method>` and bailed to AST.
        parser.ExprFieldAccess(fa) => { return qualified_variant_enum(fa, s); },
        _ => { return ""; }
    }
    return "";
}

// qualified_variant_enum resolves `Enum.Variant` (a field access whose field is
// a variant and whose object is the bare owning enum name, not a local) to the
// enum name, else "".
function qualified_variant_enum(fa: parser.ExprFieldAccess, s: LowerState): string {
    var owner: string = variant_enum_owner(s.structs, fa.field);
    if (owner == "") { return ""; }
    match (fa.obj) {
        parser.ExprIdent(eid) => {
            if (eid.name == owner && s.slot_of(eid.name) < 0) { return owner; }
        },
        _ => {}
    }
    return "";
}

// ---- struct decl helpers -----------------------------------------------
// The core lookups take the decl array directly (so lower_func can use them
// while building its initial state); the LowerState methods delegate.
// decl_field_index returns a field's position in DECL order (-1 if absent);
// decl_is_struct reports whether `name` is a declared struct.
pub function decl_is_struct(structs: parser.StructDecl[], name: string): boolean {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == name) { return true; }
        i = i + 1;
    }
    return false;
}

// decl_is_enum reports whether `name` is a declared enum — i.e. some decl records
// it as its enum_owner (the variants of `name` are stored in `structs` with
// enum_owner == name). Precise (unlike the loose syntactic is_enum_like_name): it
// cannot misfire on a primitive / struct / generic, and a bracketed Option[T] /
// Result[T] field spelling never equals a bare enum_owner. False in the standalone
// bootstrap where imported enums aren't loaded → the field is treated leak-only
// (no construction inc, no drop) → balanced/sound. #4297 A2: drives the direct
// enum-field exit-reclaim (gate + construction inc + the k_enum struct-drop arm).
pub function decl_is_enum(structs: parser.StructDecl[], name: string): boolean {
    if (name.len() == 0) { return false; }
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].enum_owner == name) { return true; }
        i = i + 1;
    }
    return false;
}

pub function decl_field_index(structs: parser.StructDecl[], struct_name: string, field: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            var fi: i32 = 0;
            while (fi < structs[i].fields.len()) {
                if (structs[i].fields[fi].name == field) { return fi; }
                fi = fi + 1;
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// decl_is_leaksafe reports whether every field is an i32/boolean OR a string.
// These are all leak-only types in the IR path — strings are never freed, so a
// struct holding one keeps a valid reference for the program's life — so such a
// struct needs NO reference counting (matching the AST path's exit codes; the
// boxes leak). Array / nested-struct / tuple fields would be RC-tracked (freed),
// so a struct holding one needs construction retains + drop release — deferred.
// is_scalar_array_type reports whether `t` is a scalar-element array (i32[] /
// boolean[]) — leak-only-safe as a struct field: indexing yields an i32, and the
// array (a fresh literal at construction) leaks with the struct (never freed),
// so no reference counting is needed. String / struct element arrays need
// element tracking (their elements are heap values), so they stay deferred.
pub function is_scalar_array_type(t: string): boolean {
    return t == "i32[]" || t == "boolean[]";
}

// is_leaksafe_array_field reports whether `t` is an array type that is leak-safe
// AS A STRUCT FIELD: the scalar-element arrays (i32[]/boolean[]), the 4-byte
// u32[], the sub-word u8[] (is_subword_array_type), and the
// 8-byte-element f64[]/i64[]. All store a pointer in the field slot, are owned
// by the struct (a fresh array literal at construction — is_scalar_arr_field_
// access bails the aliasing forms), and are deep-dropped on the struct's
// reclamation. u32[] / the sub-word array ride the i32[] 4-byte element read
// unchanged (each element lives in a full 32-bit slot, pre-wrapped by the `as
// u8` cast at the producing site); their narrowness only affects arithmetic ON
// a read element, not the field round-trip. NOT here: u64[] (its 8-byte element
// read needs the i64-width dispatch routed through the "u64[]" field tag — like
// the u64 tuple element slice — a separate increment). NOT used for enum
// payloads (those need the element-width mark, not a plain mark_arr).
pub function is_leaksafe_array_field(t: string): boolean {
    return is_scalar_array_type(t) || t == "f64[]" || t == "i64[]" || t == "u32[]"
        || is_subword_array_type(t);
}

// is_subword_array_type reports whether `t` is a sub-32-bit integer-element
// array (u8[]). This rides the SAME 4-byte-slot element
// representation as i32[]: the self-host IR (like the AST emitter) stores each
// element in a full 32-bit slot — op_arr_push / op_arr_get(32) round-trip the
// value at 32-bit width, and the sub-word value is wrapped to its range by the
// cast at the producing site BEFORE the push (the `b as u8` idiom), so the
// stored slot already holds the in-range value. A read yields that same i32
// (the consumer `data[i] as i32` is a no-op zero-extend). So as a struct field
// it is leak-safe exactly like i32[] / u32[] — the buffer is a pointer in
// the field slot, owned by the struct, deep-dropped on reclamation. This admits
// byte-buffer structs (BytesWriter, Stream readers) onto the IR path.
pub function is_subword_array_type(t: string): boolean {
    return t == "u8[]";
}

// is_map_type_name reports whether `t` is a Map[K, V] type. Maps are leak-only
// on the IR path (the exit sweep tracks local_is_arr, not local_map_type — a map
// box is never freed), so a Map-typed struct field leaks with the struct like a
// string / Option / tuple / enum field: no RC, no aliasing bail. Reading the
// field into a `var m: Map[K, V] = c.m` local re-marks the map type from the
// annotation, so the map's get/insert/has/... dispatch keeps working.
pub function is_map_type_name(t: string): boolean {
    return t.len() >= 5 && t[0:4] == "Map[";
}

// is_scalar_arr_field_access reports whether `e` reads a scalar-array struct
// field (`v.items` where items: i32[]). Such an array lives inside the struct
// (which leaks), so binding/returning/assigning it would create an alias the
// IR path can't retain (leak-only) — but the AST path DOES retain. To avoid
// regressing that RC behaviour, those alias-creating uses bail to the AST
// emitter; only direct reads (`v.items[i]`, `v.items.len()`) stay in the IR
// (neither path retains there).
// is_struct_array_field_type: a `X[]` where X is a leaf-safe struct (array-of-
// struct field). Admitted to the IR path (construction + `f[i].field` read) but
// NOT deep-dropped yet — the array and its struct elements leak with the struct (a
// recursive-drop follow-up); aliasing it (bind / return / assign) bails, like the
// scalar-array fields, so the leak-only IR never creates a dangling second owner.
pub function is_struct_array_field_type(structs: parser.StructDecl[], t: string): boolean {
    var n: i32 = t.len();
    if (n < 3) { return false; }
    if (t[n - 2 : n] != "[]") { return false; }
    // Element leaf-safety is guaranteed by the leaksafe gate (decl_is_leaksafe_d,
    // depth-bounded) before any struct admitting this field reaches the IR path, so
    // this only needs to recognise the struct-array shape (no recursion → no cycle).
    return decl_is_struct(structs, t[0 : n - 2]);
}

// is_enum_array_field_type: a `C[]` where C is a (nominal) enum (array-of-enum
// field). Like the array-of-struct field it is admitted to the IR path in leak
// mode (the array + its enum boxes leak with the struct) and bailed in the
// alias-creating positions (bind / return / assign), so the leak-only IR never
// creates a dangling second owner.
pub function is_enum_array_field_type(structs: parser.StructDecl[], t: string): boolean {
    var n: i32 = t.len();
    if (n < 3) { return false; }
    if (t[n - 2 : n] != "[]") { return false; }
    return is_enum_like_name(t[0 : n - 2], structs);
}

// is_leaksafe_payload reports whether a payload type is a leak-safe scalar/string.
// u32 rides one full i32 slot exactly like i32 (no narrowing on read), so an
// Option/Result box carrying a u32 stores / reads at the default 32-bit width
// (op_opt_make / op_opt_payload) and the match binding marks the bound slot u32
// so its `>>` is logical and its arithmetic wraps at 2^32. u64 rides the i64
// 8-byte slot: construction already tags a u64 arg "i64" (elem_type_tag's
// infer_expr_width==64 path) so the box stores 8 bytes, and the match binding
// reads via op_opt_payload_w(64) + marks the slot u64 (unsigned, 8-byte). The
// sub-word int (u8) is NOT here: its payload-box read needs
// zero-extension that currently differs across backends (a u8 read
// mis-extends on wasm), so an Option/Result-of-it field stays on the AST path.
function is_leaksafe_payload(p: string): boolean {
    return p == "i32" || p == "boolean" || p == "string" || p == "i64" || p == "f64"
        || p == "u32" || p == "u64";
}

// is_leaksafe_opt_field: an Option[T] / Result[T, E] field whose payload type(s)
// are leak-safe scalars/strings. Options/Results are leak-only on the IR path (the
// exit sweep never frees them), so such a field needs no RC / aliasing bail — it
// leaks with the struct, like a string field. Struct / nested-generic payloads are
// deferred (they would need payload-type recovery through the field).
pub function is_leaksafe_opt_field(t: string): boolean {
    var n: i32 = t.len();
    if (n < 9) { return false; }
    if (t[0:7] == "Option[") { return is_leaksafe_payload(opt_payload_type(t, "Some")); }
    if (t[0:7] == "Result[") {
        return is_leaksafe_payload(opt_payload_type(t, "Ok")) && is_leaksafe_payload(opt_payload_type(t, "Err"));
    }
    return false;
}

// opt_payload_ok_d: an Option/Result payload type is admissible for a leak-safe
// struct field when it is a leak-safe scalar/string OR a leak-safe STRUCT (a
// leak-only pointer in one slot, offset 8 — exactly what the match lowering's
// ptag_is_struct branch reads). Enum payloads are deliberately excluded: the
// legacy AST backend miscompiles an `Option[enum]` struct field (it segfaults),
// so admitting it to the IR path would route a backend-buggy shape.
function opt_payload_ok_d(structs: parser.StructDecl[], p: string): boolean {
    if (is_leaksafe_payload(p)) { return true; }
    if (decl_is_struct(structs, p) && decl_is_leaksafe(structs, p)) { return true; }
    return false;
}

// is_leaksafe_opt_field_d is the structs-aware variant of is_leaksafe_opt_field:
// it additionally admits an Option[Struct] / Result[Struct, …] field whose struct
// payload is itself leak-safe (the construction + match lowering already handle
// it on every backend; only this eligibility predicate forced such fields to AST).
pub function is_leaksafe_opt_field_d(structs: parser.StructDecl[], t: string): boolean {
    var n: i32 = t.len();
    if (n < 9) { return false; }
    if (t[0:7] == "Option[") { return opt_payload_ok_d(structs, opt_payload_type(t, "Some")); }
    if (t[0:7] == "Result[") {
        return opt_payload_ok_d(structs, opt_payload_type(t, "Ok")) && opt_payload_ok_d(structs, opt_payload_type(t, "Err"));
    }
    return false;
}

// tuple_type_elem_tag parses a tuple type string "(t0, t1, …)" → element n's tag,
// or "" if not a tuple / n is out of range. Decodes via the structured TypeRef
// (SH-021, docs/SELF-HOST-AUDIT.md T2) instead of a hand-rolled depth-tracking
// top-level-comma scan; parse_type_ref already splits the elements without letting
// a nested generic's or tuple's inner commas confuse the split. A tuple-ARRAY
// ("(a, b)[]", array_depth > 0) is a value of array type, not a tuple, so it
// returns "" — matching the former scan, whose ")"-suffix test failed on the
// trailing "]".
pub function tuple_type_elem_tag(t: string, n: i32): string {
    var r: parser.TypeRef = parser.parse_type_ref(t);
    if (r.array_depth != 0 || !r.is_tuple) { return ""; }
    if (n < 0 || n >= r.args.len()) { return ""; }
    var rt: string = parser.render_type_ref(r.args[n]);
    // A declared fn-typed element holds a closure BOX at runtime (the lift
    // pass wraps every fn-valued tuple element into a `__mkclo$…` env box),
    // so tag it "clo" for the env-first `t.N(args)` dispatch — mirroring
    // tuple_elem_tags' declared-side mapping.
    if (rt == "fn") { return "clo"; }
    return rt;
}

// is_leaksafe_tuple_field: a tuple field "(t0, …)" whose elements are each a
// leak-safe scalar / string, an Option[T] / Result[T,E] (leak-only box), a
// leak-safe ARRAY (a heap pointer in one tuple slot), or a NESTED tuple of such
// elements. Tuples are leak-only on the IR path (the exit sweep never frees
// them), so such a field leaks with the struct — no RC, no aliasing bail.
pub function is_leaksafe_tuple_field(t: string): boolean {
    var len: i32 = t.len();
    if (len < 3 || t[0:1] != "(" || t[len - 1 : len] != ")") { return false; }
    var any: boolean = false;
    var i: i32 = 0;
    while (i < 64) {
        var tag: string = tuple_type_elem_tag(t, i);
        if (tag == "") { return any; }
        var elem_ok: boolean = is_leaksafe_payload(tag);
        // An Option[T]/Result[T,E] element is a leak-only box (one pointer slot).
        if (!elem_ok) { elem_ok = is_leaksafe_opt_field(tag); }
        // A leak-safe ARRAY element — a scalar / string / 8-byte array — is a
        // heap pointer in one tuple slot, leaking with the (leak-only) tuple
        // field, exactly the set tuple_elems_lowerable already admits for tuple
        // construction / return. (Struct- / enum-array elements need the
        // `structs` view to classify, so a tuple field carrying one still
        // bails — rarer, a later increment.)
        if (!elem_ok && (tag == "string[]" || tag == "f64[]" || tag == "i64[]" || is_leaksafe_array_field(tag))) { elem_ok = true; }
        // A NESTED tuple element is itself a leak-only heap-tuple pointer; recurse.
        if (!elem_ok && tag.len() >= 2 && tag[0:1] == "(") { elem_ok = is_leaksafe_tuple_field(tag); }
        if (!elem_ok) { return false; }
        any = true;
        i = i + 1;
    }
    return any;
}

// is_leaksafe_tuple_field_d widens is_leaksafe_tuple_field with the `structs`
// view: a STRUCT-array (`Inner[]`) or ENUM-array (`Color[]`) tuple element is
// also a leak-only heap pointer in one tuple slot — the set tuple_elems_lowerable
// already admits for tuple construction / return, where the `.N` read binds the
// slot mark_arr + the element struct/enum name so `t.N[i].field` / `match (t.N[i])`
// resolve. Only decl_is_leaksafe_d (which holds the struct view) uses this; the
// reuse-analysis callers keep the narrower structs-free predicate, so a struct
// with such a tuple field is admitted to the IR path but conservatively skips
// constructor reuse (alloc path — sound, just unoptimised).
pub function is_leaksafe_tuple_field_d(structs: parser.StructDecl[], t: string): boolean {
    var len: i32 = t.len();
    if (len < 3 || t[0:1] != "(" || t[len - 1 : len] != ")") { return false; }
    var any: boolean = false;
    var i: i32 = 0;
    while (i < 64) {
        var tag: string = tuple_type_elem_tag(t, i);
        if (tag == "") { return any; }
        var elem_ok: boolean = is_leaksafe_payload(tag);
        if (!elem_ok) { elem_ok = is_leaksafe_opt_field_d(structs, tag); }
        if (!elem_ok && (tag == "string[]" || tag == "f64[]" || tag == "i64[]" || is_leaksafe_array_field(tag))) { elem_ok = true; }
        // The struct-view additions over the plain gate: a struct-array / enum-
        // array element.
        if (!elem_ok && (is_struct_array_field_type(structs, tag) || is_enum_array_field_type(structs, tag))) { elem_ok = true; }
        // A NESTED tuple element recurses through THIS predicate so an inner
        // struct-/enum-array element is admitted at any depth.
        if (!elem_ok && tag.len() >= 2 && tag[0:1] == "(") { elem_ok = is_leaksafe_tuple_field_d(structs, tag); }
        if (!elem_ok) { return false; }
        any = true;
        i = i + 1;
    }
    return any;
}

pub function is_scalar_arr_field_access(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            // Any owned array field — scalar (i32[]/f64[]/i64[]) or struct (P[]) —
            // is bailed in the alias-creating positions (bind/return/assign): the
            // leak-only IR can't retain the second reference, and the field's array
            // is the struct's sole-owned value.
            return is_leaksafe_array_field(ft) || is_struct_array_field_type(s.structs, ft) || is_enum_array_field_type(s.structs, ft);
        },
        _ => { return false; }
    }
    return false;
}

// scalar_arr_field_type returns the field type of a SCALAR-element array struct
// field read (`v.items` where items: i32[] / f64[] / i64[]) — the subset of
// is_scalar_arr_field_access that is_leaksafe_array_field admits. Struct-array
// (P[]) / enum-array (C[]) field reads return "" (they still bail in the
// alias-creating positions — deep-drop recursion is a later slice). The RC
// frontier slice 2 lowers these (bind / return / assign) via the IR by emitting
// a Perceus dup (__fern_rc_inc) so the new owner holds a counted reference; the
// struct's own field-drop and the local exit-sweep then each balance against the
// inc (rc 1 →inc 2 →sweep/escape 1 →field-drop 0). Returns "" for anything that
// is NOT such a field read.
pub function scalar_arr_field_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (is_leaksafe_array_field(ft)) { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// struct_arr_field_read_type returns the field type of an ARRAY-OF-STRUCT struct
// field read (`v.params` where params: P[], P a struct) — the struct-array twin
// of scalar_arr_field_type. Returns "" for scalar-array / enum-array fields and
// for anything that is NOT such a field read. Used to admit `var ps: P[] =
// obj.params` BINDS onto the IR path: aliasing a struct-array field needs only a
// Perceus dup (__fern_rc_inc) on the buffer POINTER — element-type-agnostic,
// since the dup and the local exit-sweep's shallow arr_dec both act on the
// buffer, never on its (source-struct-owned) elements. No deep-drop recursion is
// involved for the bind: `ps` borrows + counts the buffer; the source struct
// still owns and (later) reclaims the elements. Balance mirrors the scalar bind:
// field rc N →dup N+1 →exit-sweep(ps) N, leaving the struct's reference intact.
pub function struct_arr_field_read_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (is_struct_array_field_type(s.structs, ft)) { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// enum_arr_field_read_type is the enum-array twin of struct_arr_field_read_type:
// it returns the field type of an ARRAY-OF-ENUM struct field read (`v.args` where
// args: Expr[], Expr an enum), else "". Aliasing an enum-array field is sound by
// the same reasoning as the struct-array case — the Perceus dup (__fern_rc_inc)
// is on the buffer POINTER, element-type-agnostic; the buffer's enum-box elements
// are owned by the source struct and never deep-dropped (the safe-leak
// invariant), so the dup can only ever leak, never over-free. The bound slot is
// marked with the element ENUM name (mark_struct_type doubles as the element-type
// slot for both struct and enum element arrays) so a later `match (es[i])`
// recovers the variant. `Expr[]` / `Stmt[]` / `Token[]` field reads — pervasive
// in the parser's AST walkers — are exactly this shape.
pub function enum_arr_field_read_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (is_enum_array_field_type(s.structs, ft)) { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// strarr_field_read_type is the string[] twin of scalar_arr_field_type /
// struct_arr_field_read_type / enum_arr_field_read_type: it returns the field
// type of a `string[]` struct field read (`s.local_names` where local_names:
// string[]), else "". A string[] is NOT covered by is_leaksafe_array_field (a
// string element is a heap pointer, not a scalar), so without this the
// `field.append(v)` dispatch fell through to the move/consume form (op_arr_push
// in place). That consume form reuses the receiver buffer — UNSOUND when the
// receiver is a borrowed, possibly-shared struct field: aliasing the enclosing
// struct (`var b = a` over a struct holding the string[]) then appending in one
// alias silently mutates the buffer the other alias still reads. That is exactly
// the checker self-build crash (asmcore.EmitState.local_names is a string[] field;
// check_stmt's `var actx = ctx` aliases the EmitState across a match arm, and the
// arm-body bind_local_typed's `s.local_names.append(name)` corrupted the shared
// buffer — leaking the arm's bindings into the restored local_names so it desynced
// from the clone-form local_types). Routing string[] field appends through the
// CLONE form (lower_arr_append_value) — element-kind-agnostic, the same sound shape
// the scalar/struct/enum-array fields use — fixes it: the receiver buffer is never
// reused, only the sole-owned clone.
pub function strarr_field_read_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (ft == "string[]") { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// field_access_arr_field_type returns the field type of an array-field struct
// field read (`s.xs` where xs: i32[]/f64[]/i64[]/boolean[] — a scalar-element
// array — OR xs: P[] — an array-of-struct — OR xs: E[] — an array-of-enum), for
// use as a struct-literal field VALUE (`State { xs: s.xs }`, `DeferAcc { actions:
// er.actions }` over a `Stmt[]` — parser.dl_collect_stmt). This is the bare-
// field-copy admission for the `ExprStructLit` array-field path (RC-frontier
// slice 3, following the array-ident-into-field #3292 + the array-out-of-field
// #3308 reads): the field read lowers via op_struct_get (a real value), aliasing
// the SOURCE struct's array, so the consuming struct_make stores a SECOND owner —
// balanced by a Perceus dup (__fern_rc_inc), exactly the #3292 alias-inc idiom.
// Enum-array fields take the same is_unique-gated deep-drop as struct-array
// fields (emit_struct_field_drops' k_box walk), so the alias-inc balances both
// sides identically. Returns "" for anything that is NOT such a bare array-field
// read (e.g. a string[] field, or a non-field expression).
pub function field_access_arr_field_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (is_leaksafe_array_field(ft) || is_struct_array_field_type(s.structs, ft) || is_enum_array_field_type(s.structs, ft)) { return ft; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

pub function decl_is_leaksafe(structs: parser.StructDecl[], struct_name: string): boolean {
    var seen: string[] = [];
    return decl_is_leaksafe_d(structs, struct_name, 0, seen);
}

// decl_is_leaksafe_d is the recursion: a struct is leak-safe if every field is a
// scalar (i32/boolean/string/scalar-array) OR a struct that is itself leak-safe
// (composite struct fields, leak mode — the pointer is stored in one slot, no
// RC). `visiting` is the set of struct names on the current proof path: a field
// whose (element) type is already being proven is a leak-only BACK-EDGE in the
// type graph — a self-referential `next: Node[]` or a mutually-recursive
// `A.b: B[]` / `B.a: A[]` — and in leak mode that back-pointer is just a slot
// that leaks with the struct (no RC), so the cycle introduces no unsafe field.
// We short-circuit such an edge as leak-safe (the OUTER struct's own fields are
// still each validated), which admits linked lists / trees / ASTs onto the IR
// path. The depth cap stays as a backstop for pathological non-cyclic graphs.
function decl_is_leaksafe_d(structs: parser.StructDecl[], struct_name: string, depth: i32, visiting: string[]): boolean {
    if (depth > 16) { return false; }
    // Back-edge to a struct already on the proof path: leak-only, so safe.
    if (util.has_str(visiting, struct_name)) { return true; }
    var nv: string[] = visiting.append(struct_name);
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            var fi: i32 = 0;
            while (fi < structs[i].fields.len()) {
                var t: string = structs[i].fields[fi].type_name;
                // The ≤32-bit integer scalars (u32 + the sub-word u8)
                // are leak-only and ride one i32 slot exactly like i32, so a struct
                // carrying them is leaf-safe and lowers (construction stores / field
                // read loads at the default 32-bit width; a sub-word cast wraps the
                // value before the store). u64 / f32 are NOT added: they need real
                // 64-bit / float width handling, so they keep the struct on AST.
                if (t == "i32" || t == "boolean" || t == "string" || t == "string[]" || t == "f64" || t == "i64" || t == "u32" || t == "u8" || t == "f32" || t == "float" || t == "u64" || is_leaksafe_array_field(t) || is_leaksafe_opt_field_d(structs, t) || is_leaksafe_tuple_field_d(structs, t) || is_map_type_name(t) || (t.len() > 5 && t[0:5] == "Cell[")) {
                    fi = fi + 1;
                    continue;
                }
                // A struct-typed field is allowed if its struct is leak-safe too.
                if (decl_is_struct(structs, t) && decl_is_leaksafe_d(structs, t, depth + 1, nv)) {
                    fi = fi + 1;
                    continue;
                }
                // A nominal-enum field (Color, Expr, …) is leak-only on the IR
                // path — the exit sweep never frees an enum box — so it leaks
                // with the struct like a string / Option / tuple field: no RC, no
                // aliasing bail. is_enum_like_name can over-match a bare nominal
                // that is not really an enum, but the only consequence is an AST
                // fallback at the construction / match site (never a miscompile),
                // and the stage-2 fixpoint guards byte-stability.
                if (is_enum_like_name(t, structs)) {
                    fi = fi + 1;
                    continue;
                }
                // An array-of-struct field `X[]` (X a leak-safe struct): admitted
                // in leak mode (the array + its elements leak with the struct; a
                // recursive-drop follow-up frees them). The element's leaf-safety
                // rides the SAME depth-bounded recursion so a cyclic `X[]` graph
                // hits the cap and bails to AST.
                if (t.len() >= 3 && t[t.len() - 2 : t.len()] == "[]") {
                    var elt: str = t[0 : t.len() - 2];
                    if (decl_is_struct(structs, elt) && decl_is_leaksafe_d(structs, elt, depth + 1, nv)) {
                        fi = fi + 1;
                        continue;
                    }
                    // An array-of-ENUM field `C[]` — enum boxes leak with the
                    // struct like the struct-element arrays above (and the
                    // nominal-enum field case), so admit it in leak mode.
                    if (is_enum_like_name(elt, structs)) {
                        fi = fi + 1;
                        continue;
                    }
                    // An array-of-ARRAY field `T[][]` whose element `T[]` is
                    // itself a leaf-safe array (scalar / struct / enum array), or
                    // an array-of-Option/Result field `Option[T][]` whose element
                    // `Option[T]` is a leak-safe Option/Result, or an array-of-
                    // TUPLE field `(i32, string)[]` whose element tuple is a
                    // leak-safe tuple: the whole nested structure leaks with the
                    // struct. Covers the common 2-D field; deeper nesting still
                    // bails.
                    if (is_leaksafe_array_field(elt) || is_struct_array_field_type(structs, elt) || is_enum_array_field_type(structs, elt) || is_leaksafe_opt_field_d(structs, elt) || is_leaksafe_tuple_field_d(structs, elt)) {
                        fi = fi + 1;
                        continue;
                    }
                }
                return false;
            }
            return true;
        }
        i = i + 1;
    }
    return false;
}

// is_enum_like_name reports whether type name `t` denotes a (nominal) enum:
// not a primitive, struct, array, or bracketed/tuple generic. Mirrors the AST
// emitter's is_enum_recv heuristic (asmcore.is_enum_recv) — a bare nominal that
// isn't anything else is an enum. Used to carry an enum-typed local / param /
// receiver's type name in local_struct_type, so `x.method()` on an enum value
// dispatches to `<Enum>.<method>` (the enum-receiver-method path). A name that
// is really a scalar type alias would be mis-marked, but the only consequence
// is a method-dispatch label that calls_only_known finds absent → the module
// bails to AST; never a miscompile.
pub function is_enum_like_name(t: string, structs: parser.StructDecl[]): boolean {
    if (t.len() == 0) { return false; }
    if (t == "i32" || t == "boolean" || t == "bool" || t == "string"
        || t == "i64" || t == "f64" || t == "f32" || t == "float" || t == "void") { return false; }
    // "clo" is the compiler's closure-BOX tag spelling (a boxed fn-valued
    // tuple element / Option payload) — never a user enum name. Without this
    // exclusion an Option[clo] payload's match bind was claimed by the enum
    // branch (mark_struct_type("clo")) before the closure-local mark could
    // fire, so `f(args)` bare-called the box pointer → SIGSEGV. ("fn" is NOT
    // excluded: existing struct-field / enum-payload machinery relies on the
    // coarse "fn" spelling reading as enum-like in its dispatch gates.)
    if (t == "clo") { return false; }
    if (decl_is_struct(structs, t)) { return false; }
    if (is_array_type_name(t)) { return false; }
    // A bracketed generic (Option[..]/Result[..]/Map[..]/Box[..]) or a tuple
    // "(..)" is not a bare enum.
    var ci: i32 = 0;
    while (ci < t.len()) {
        if (t[ci] == 91) { return false; }   // '['
        ci = ci + 1;
    }
    if (t[0:1] == "(") { return false; }
    return true;
}

// decl_is_prim_recv reports whether a method-receiver type spelling names a
// PRIMITIVE / `string` type (i32/i64/u32/u64/usize/f64/f32/boolean/string) —
// the receivers `impl Trait for <prim>` can name, whose `dyn` values are
// heap-boxed at coercion (docs/DYN-TRAITS.md §4.2.3). Not a struct, not an
// enum, not an array. Mirrors asmcore.is_prim_recv_name for the wasm backend,
// which works on (structs) inputs rather than EmitState.
pub function decl_is_prim_recv(structs: parser.StructDecl[], name: string): boolean {
    if (name.len() == 0) { return false; }
    if (is_array_type_name(name)) { return false; }
    if (decl_is_struct(structs, name)) { return false; }
    if (is_enum_like_name(name, structs)) { return false; }
    if (name == "i32" || name == "i64" || name == "u32" || name == "u64" || name == "usize"
        || name == "f64" || name == "f32" || name == "float"
        || name == "boolean" || name == "bool" || name == "string") { return true; }
    return false;
}

// prim_type_ids is the canonical ordered list of primitive receiver type names
// used to assign a dyn-box shape id on wasm (the natives use the interned
// type-name string). The id is structs.len() + index, so it never collides with
// a struct's type id (its index in `structs`). The order is fixed for
// deterministic codegen (docs/DYN-TRAITS.md §4.2.3 — fixpoint determinism).
pub function prim_type_ids(): string[] {
    return ["i32", "boolean", "bool", "i64", "u32", "u64", "usize", "f64", "f32", "float", "string"];
}

// prim_type_id maps a primitive receiver type name to its wasm dyn-box shape id
// (structs.len() + its index in prim_type_ids), or -1 if not a primitive. Both
// op_dyn_box (store @0) and op_dyn_dispatch (compare) key off this, so a boxed
// value's offset-0 id matches the dispatch arm. bool/boolean and f32/f64/float
// share spellings but each maps to its own slot; that is harmless (an impl names
// exactly one spelling, used at both box and dispatch).
pub function prim_type_id(structs: parser.StructDecl[], name: string): i32 {
    var names: string[] = prim_type_ids();
    var i: i32 = 0;
    while (i < names.len()) {
        if (names[i] == name) { return structs.len() + i; }
        i = i + 1;
    }
    return 0 - 1;
}

// decl_has_scalar_array reports whether a struct has any scalar-array field.
pub function decl_has_scalar_array(structs: parser.StructDecl[], struct_name: string): boolean {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            var fi: i32 = 0;
            while (fi < structs[i].fields.len()) {
                if (is_scalar_array_type(structs[i].fields[fi].type_name)) { return true; }
                fi = fi + 1;
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

// decl_field_type returns the declared type name of `field` in `struct_name`
// ("" if absent) — used to track a string-typed field's reads as strings.
pub function decl_field_type(structs: parser.StructDecl[], struct_name: string, field: string): string {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            var fi: i32 = 0;
            while (fi < structs[i].fields.len()) {
                if (structs[i].fields[fi].name == field) { return structs[i].fields[fi].type_name; }
                fi = fi + 1;
            }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// decl_field_fn_ret returns the recorded fn RETURN tag of struct_name.field
// (StructFieldDecl.fn_ret — set by the parser for an fn-typed field whose
// `(…) => R` return is a struct/nominal/string spelling), or "". The string
// case drives expr_is_str's fn-field-call arm (#5306 gap 2).
pub function decl_field_fn_ret(structs: parser.StructDecl[], struct_name: string, field: string): string {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            var fi: i32 = 0;
            while (fi < structs[i].fields.len()) {
                if (structs[i].fields[fi].name == field) { return structs[i].fields[fi].fn_ret; }
                fi = fi + 1;
            }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// field_access_is_closurearr returns true when `e` is a struct-field read
// `obj.field` whose field is a closure/fn ARRAY — spelled "fn[]"
// (parse_type_name coarsens `(() => T)[]` to "fn[]"). Its element is a closure
// box, so a local bound from the whole array (`var fns = r.hs`) or from one
// element (`var f = r.hs[0]`) must dispatch env-first — mirroring the
// is_closurearr LOCAL. Without it those calls invoke the box pointer as raw
// code and SIGSEGV (#5160 defect #2). A struct-field array of BARE named fns
// (`Reg { hs: [inc] }`) is already miscompiled at construction (a separate
// pre-existing gap), so this never regresses a working shape.
pub function field_access_is_closurearr(e: parser.Expr, s: LowerState): boolean {
    // A registered fn-POINTER array field (`hs: [inc, dbl]`) shares the "fn[]"
    // spelling with a closure array but its elements are RAW fn pointers, not env
    // boxes — the fn-pointer read paths (element bind / whole-array alias / direct
    // inline call) must win, so decline the closure classification for it. The
    // registry is threaded on s.closure_fns (fnptr_arr_fields_of markers).
    if (field_access_is_fnarr(e, s)) { return false; }
    match (e) {
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty.len() == 0) { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "fn[]";
        },
        _ => { return false; }
    }
}

// field_access_is_fnarr returns true when `e` is a struct-field read `obj.field`
// whose field is a registered PLAIN-fn-pointer array — spelled "fn[]" (like a
// closure array) but constructed ONLY from all-fn-value array literals
// program-wide, so its elements are raw function pointers, not `__mkclo$` env
// boxes. The registry is the whole-program fnptr_arr_fields_of scan, threaded
// through s.closure_fns as "FNPTR:<sty>.<field>" markers (which can never collide
// with a real function name, so existing closure_fns consumers are unaffected). A
// pure-type test cannot distinguish the two shapes — both are "fn[]" — hence the
// registry. Drives the raw-fn-pointer bind / alias / inline-call dispatch (plain
// call_indirect, NOT env-first) at the read sites (#5235).
pub function field_access_is_fnarr(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty.len() == 0) { return false; }
            return util.has_str(s.closure_fns, "FNPTR:" + oty + "." + fa.field);
        },
        _ => { return false; }
    }
}

// decl_field_type_at returns the type of field `index` (decl order) in struct
// `struct_name`, or "".
pub function decl_field_type_at(structs: parser.StructDecl[], struct_name: string, index: i32): string {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            if (index >= 0 && index < structs[i].fields.len()) { return structs[i].fields[index].type_name; }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// decl_field_name_at returns the NAME of field `index` (decl order) in struct
// `struct_name`, or "". The name-side twin of decl_field_type_at — used by the
// per-backend struct-drop generators to key a field against the fn-pointer-array
// registry ("FNPTR:<sty>.<field>") so a plain-fn-pointer array field leaks instead
// of being walked as a box array (its elements are raw code addresses).
pub function decl_field_name_at(structs: parser.StructDecl[], struct_name: string, index: i32): string {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) {
            if (index >= 0 && index < structs[i].fields.len()) { return structs[i].fields[index].name; }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// struct_field_width returns the field's load/store width for op_struct_get /
// op_struct_set: 64 if the field is f64, else 0 (i32-shaped). Drives wasm's
// f64.load/store vs i32.load/store selection (register backends ignore it).
pub function struct_field_width(structs: parser.StructDecl[], struct_name: string, index: i32): i32 {
    var t: string = decl_field_type_at(structs, struct_name, index);
    if (t == "f64" || t == "f32" || t == "float" || t == "i64" || t == "u64") { return 64; }
    return 0;
}
// struct_field_is_i64 reports whether field `index` of `struct_name` is i64 (an
// 8-byte INTEGER field — i64.load/store on wasm, vs f64.load/store for f64).
pub function struct_field_is_i64(structs: parser.StructDecl[], struct_name: string, index: i32): boolean {
    var ft64: string = decl_field_type_at(structs, struct_name, index);
    return ft64 == "i64" || ft64 == "u64";
}

pub function (s: LowerState) field_index_in(struct_name: string, field: string): i32 {
    return decl_field_index(s.structs, struct_name, field);
}

// is_builtin_pattern reports whether a match pattern names a built-in Option /
// Result / bool variant — these discriminate on an i32 tag at offset 0 (not the
// user-enum struct shape). The StmtMatch lowering uses this to route them to the
// tag-test arm shape (true/false test the 0/1 scrutinee directly; Some/Ok/Err
// bind their payload via opt_payload once the scrutinee's Option/Result type is
// recovered) instead of the variant_is path it uses for user enums. Only a
// payload whose type can't be recovered, or a non-scalar/-string payload, still
// bails to the AST emitter from there.
pub function is_builtin_pattern(name: string): boolean {
    return name == "Some" || name == "None" || name == "Ok" || name == "Err"
        || name == "true" || name == "false";
}

pub function decl_field_count(structs: parser.StructDecl[], struct_name: string): i32 {
    var i: i32 = 0;
    while (i < structs.len()) {
        if (structs[i].name == struct_name) { return structs[i].fields.len(); }
        i = i + 1;
    }
    return 0;
}

// iife_lambda_composite_struct_type recovers the STRUCT / NOMINAL-ENUM result type
// name of a match-EXPRESSION IIFE lambda whose body is a single StmtMatch — for an
// UNANNOTATED `var p = match (e) { V(q) => q, .. }` where the leaf is a bare bound
// payload (q not in scope at the binding site, so the leaf-based recovery returns
// ""). Returns "" for a tuple result (the tuple path types `p` via mark_tuple_elems)
// or any non-match / non-composite body. Defined ahead of expr_struct_type; the
// composite-result scan it delegates to lives later in the file (forward reference).
function iife_lambda_composite_struct_type(lam: parser.ExprLambda, s: LowerState): string {
    if (lam.body.len() != 1) { return ""; }
    match (lam.body[0]) {
        parser.StmtMatch(mm) => {
            var ct: string = iife_match_composite_result_type(mm, s);
            if (ct == "") { return ""; }
            // Only a struct / nominal-enum NAME types via expr_struct_type's result;
            // a tuple tag list is handled by the mark_tuple_elems slot path.
            if (decl_is_struct(s.structs, ct) || is_enum_like_name(ct, s.structs)) { return ct; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// iife_lambda_composite_tuple_tags recovers the comma-joined TUPLE element TAGS
// (mark_tuple_elems form) of a match-EXPRESSION IIFE lambda whose result is a tuple
// returned whole — the tuple sibling of iife_lambda_composite_struct_type, for an
// UNANNOTATED `var t = match (e) { V(p) => p, .. }`. Returns "" for a struct / enum
// result (typed via mark_struct_type) or a non-match / non-composite body.
function iife_lambda_composite_tuple_tags(lam: parser.ExprLambda, s: LowerState): string {
    if (lam.body.len() != 1) { return ""; }
    match (lam.body[0]) {
        parser.StmtMatch(mm) => {
            var ct: string = iife_match_composite_result_type(mm, s);
            if (ct == "") { return ""; }
            if (iife_result_is_tuple(ct, s)) { return ct; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// expr_struct_type returns the struct type name an expression evaluates to, or
// "" — a struct literal's type, or a struct-tracked local/param slot.
pub function expr_struct_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprStructLit(sl) => { return sl.type_name; },
        parser.ExprIdent(id) => {
            var idsl: i32 = s.slot_of(id.name);
            // An ARRAY slot's local_struct_type holds its ELEMENT struct type
            // (for `arr[i]` recovery below), NOT the slot's own type — the array
            // value itself is not a struct, so report "".
            if (s.is_arr_slot(idsl)) { return ""; }
            return s.struct_type_of_slot(idsl);
        },
        parser.ExprIndex(ix) => {
            // Indexing a struct ARRAY `arr[i]` evaluates to the element struct
            // type, carried in the (is_arr) array slot's local_struct_type. Lets
            // `arr[i].field` / `arr[i].method()` resolve without an intermediate
            // typed local. i32[]/string[] arrays carry "" → not a struct.
            match (ix.array) {
                parser.ExprIdent(aid) => {
                    var asl: i32 = s.slot_of(aid.name);
                    if (s.is_arr_slot(asl)) { return s.struct_type_of_slot(asl); }
                },
                // `p.items[i]` where p's field `items` is a `P[]` struct-array or
                // `C[]` enum-array field → the element type (so `p.items[i].field`
                // / `p.items[i].method()` resolve; an enum element dispatches to
                // `<Enum>.<method>`, the field analog of the local enum-array case).
                parser.ExprFieldAccess(fa) => {
                    // `t.N[i]` where `t.N` is a struct-ARRAY tuple element
                    // (`([P { .. }], x)`): the element's recorded tuple tag is
                    // `P[]`, so `t.N[i].field` recovers the element struct type —
                    // the tuple-element sibling of the struct-field-array case
                    // below. #3353.
                    if (util.is_all_digits(fa.field)) {
                        var ttag: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                        if (ttag.len() >= 3 && ttag[ttag.len() - 2 : ttag.len()] == "[]") {
                            var telt: str = ttag[0 : ttag.len() - 2];
                            if (decl_is_struct(s.structs, telt) || is_enum_like_name(telt, s.structs)) { return telt + ""; }
                        }
                        return "";
                    }
                    var oty: string = expr_struct_type(fa.obj, s);
                    if (oty != "") {
                        var ft: string = decl_field_type(s.structs, oty, fa.field);
                        if (ft.len() >= 3 && ft[ft.len() - 2 : ft.len()] == "[]") {
                            var elt: str = ft[0 : ft.len() - 2];
                            if (decl_is_struct(s.structs, elt) || is_enum_like_name(elt, s.structs)) { return elt + ""; }
                        }
                    }
                },
                // `a[i][j]` where `a` is a `T[][]` of structs/enums → the innermost
                // element type, so `a[i][j].field` / `a[i][j].method()` resolve
                // without an intermediate typed local (the depth-2 sibling of the
                // `arr[i]` ExprIdent case above). The element struct/enum name is
                // recorded on the T[][] slot's local_struct_type at declaration; a
                // plain i32[][]/f64[][] element carries "" → unaffected.
                parser.ExprIndex(inner) => {
                    match (inner.array) {
                        parser.ExprIdent(aaid) => {
                            var aasl: i32 = s.slot_of(aaid.name);
                            if (s.is_arrarr_slot(aasl)) {
                                var aaty: string = s.struct_type_of_slot(aasl);
                                if (aaty != "" && (decl_is_struct(s.structs, aaty) || is_enum_like_name(aaty, s.structs))) { return aaty; }
                            }
                        },
                        _ => {}
                    }
                },
                // `mk()[i].field` — field on a struct ELEMENT indexed directly from a
                // function that returns a struct ARRAY (`P[]`). struct_ret_type for a
                // P[]-returning free fn already records the ELEMENT type "P" (the
                // registry strips "[]", #3035), so recover it for `mk()[i]` — the
                // call sibling of the `arr[i]` ExprIdent case above. Restricted to a
                // bare-name (free fn) callee; method-call callees stay on the AST path.
                parser.ExprCall(cc) => {
                    match (cc.callee) {
                        parser.ExprIdent(ccid) => {
                            var crt: string = s.struct_ret_type(ccid.name);
                            if (crt != "" && (decl_is_struct(s.structs, crt) || is_enum_like_name(crt, s.structs))) { return crt; }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            return "";
        },
        parser.ExprFieldAccess(fa) => {
            // A struct-typed tuple element `t.N` evaluates to that struct type.
            if (util.is_all_digits(fa.field)) {
                var tt: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                if (decl_is_struct(s.structs, tt)) { return tt; }
                return "";
            }
            // A struct-typed field read `obj.f` evaluates to the field's struct
            // type (enables nested access `b.p.x`). Returns "" if obj isn't a
            // struct or f isn't a struct-typed field.
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (decl_is_struct(s.structs, ft)) { return ft; }
            return "";
        },
        parser.ExprCall(c) => {
            // typed-IR (#5531): the annotate pass stamps c.ty with the checker's
            // inferred result type; for a struct-returning call that is the struct
            // NAME. Trust it when it names a known struct, retiring the
            // struct_ret_type re-derivation below for annotated calls. Guarded to a
            // known struct so a scalar/"" tag (or an enum, not covered here) falls
            // through to the structural walk unchanged.
            if (c.ty != "" && decl_is_struct(s.structs, c.ty)) { return c.ty; }
            // A call to a struct-returning function evaluates to that struct type
            // (so `var p = make()` / `var p = obj.make()` then `p.x` resolves).
            match (c.callee) {
                parser.ExprIdent(id) => {
                    // Built-in `subprocess(cmd, args, stdin)` returns a bare
                    // ProcessResult struct (no Result wrapper), so type it directly
                    // here — the analog of stat's opt_ret_type, for a struct-valued
                    // builtin: `var r = subprocess(..)` marks r ProcessResult so
                    // `r.stdout` / `r.exit_code` resolve.
                    if (id.name == "subprocess" && c.args.len() == 3) { return "ProcessResult"; }
                    return s.struct_ret_type(id.name);
                },
                parser.ExprFieldAccess(fa) => {
                    // Associated-function call `Type.make()` / `Enum.default()` —
                    // the object is a bare TYPE name (struct or enum), not a local
                    // slot. Key the return type by "<Type>.<method>" directly via
                    // the registry (struct_ret_fns now records enum returns too).
                    // A non-empty result both recovers the constructed type — so
                    // `Type.make(..).x` and an inferred `var p = Type.make(..)` /
                    // `var e = Enum.default()` resolve — AND distinguishes the
                    // associated call from a module call `mod.func()` (whose key
                    // is the bare `func`, never `mod.func`, so it returns "").
                    match (fa.obj) {
                        parser.ExprIdent(tid) => {
                            if (s.slot_of(tid.name) < 0) {
                                var art: string = s.struct_ret_type(tid.name + "." + fa.field);
                                if (art != "") { return art; }
                            }
                        },
                        _ => {}
                    }
                    // Method call `obj.make()` → key by "<Type>.<method>".
                    var rty: string = expr_struct_type(fa.obj, s);
                    if (rty == "") { return ""; }
                    return s.struct_ret_type(rty + "." + fa.field);
                },
                // An if-/match-EXPRESSION value (`(if (c) { P{..} } else { .. }).x`)
                // — a 0-arg IIFE; its struct type is the leaf branch's struct type
                // (iife_leaf_value unwraps any nesting), so a direct `.field` /
                // `.method()` on it resolves. When the leaf is a BARE bound payload
                // (`match (e) { V(q) => q, .. }`, q not in scope at this site), fall
                // back to the match's composite result type (struct / enum NAME) so an
                // UNANNOTATED `var p = match … { V(q) => q, N => P {..} }` still types
                // `p` for `p.field` / `match (p)`.
                parser.ExprLambda(ilam) => {
                    var lst: string = expr_struct_type(iife_leaf_value(e), s);
                    if (lst != "") { return lst; }
                    return iife_lambda_composite_struct_type(ilam, s);
                },
                _ => { return ""; }
            }
        },
        parser.ExprBinary(opb) => {
            // Composite operator overload result (#2706): `a <op> b` evaluates to
            // the overload method's return struct type, so `var c = a + b` /
            // `(a + b).x` type `c` / the field read as a struct. The method's
            // declared return (`struct_ret_type("<T>.<method>")`) is authoritative;
            // for the Num-style Self-returning overloads it equals the left
            // operand's struct type, the fallback when the registry has no entry.
            if (binop_overload_method(opb.op) != "") {
                var olt: string = expr_struct_type(opb.left, s);
                if (decl_is_struct(s.structs, olt)) {
                    // A struct result only when the type actually defines the
                    // overload method (struct-returning). No method ⇒ "" — an
                    // invalid program the lowering bails to AST, kept consistent
                    // here so a consumer never types the result as a struct.
                    return s.struct_ret_type(olt + "." + binop_overload_method(opb.op));
                }
            }
            return "";
        },
        parser.ExprUnary(opu) => {
            // Composite unary minus result: `-a` evaluates to `a.neg()`'s return
            // struct type, the unary sibling of the binary-overload result type
            // above (again "" when the type has no `neg`).
            if (opu.op == "-") {
                var out0: string = expr_struct_type(opu.operand, s);
                if (decl_is_struct(s.structs, out0)) {
                    return s.struct_ret_type(out0 + ".neg");
                }
            }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// expr_is_bool reports whether `e` is a statically-boolean value, so a method
// call on it dispatches "boolean.<m>" (its own Display / Json impl) instead of
// falling through to "i32.<m>" — which renders a bool as 1/0 (a `@derive(Json)`
// struct's boolean field serialised `"ok":1` instead of `"ok":true`). Covers a
// boolean literal, a boolean-typed struct field (the derived `self.field.to_json()`
// path), a comparison / logical result, and a `!` negation. A boolean LOCAL is
// not tracked (no per-slot bool flag), so it still dispatches as i32 — matching
// the pre-existing behaviour for those; the field-access case is what the
// derive synthesiser emits.
function expr_is_bool(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprBool(_) => { return true; },
        parser.ExprUnary(u) => { return u.op == "!"; },
        parser.ExprBinary(b) => {
            return b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" || b.op == "&&" || b.op == "||";
        },
        parser.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) { return false; }
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "boolean";
        },
        _ => { return false; }
    }
    return false;
}

// expr_recv_prim_type returns the PRIMITIVE receiver type name of a method
// call's receiver `e` (for `impl Trait for i32/string/i64/f64/boolean`
// dispatch), or "" if `e` is a struct (handled by expr_struct_type) or
// otherwise not a dispatchable primitive receiver. Strings / i64 / f64 / a
// statically-boolean value are detected precisely via the existing predicates;
// any other scalar defaults to "i32". This only drives the call-site label: a
// label naming a non-existent method bails the whole module to the AST path
// (calls_only_known), so an over-broad "i32" guess is safe, never a miscompile.
// expr_scalar_type returns the scalar/string type of `e` — the single
// classifier the per-type predicates (expr_is_str / expr_is_f64 / …) fold into.
// This is the first seam of the typed-IR migration (fragility #3): today it is
// the cascade lifted verbatim from expr_recv_prim_type, so callers stop chaining
// the individual predicates; later slices can cache/annotate its result instead
// of re-deriving. It assumes `e` is not a struct/enum receiver (the caller
// excludes those — see expr_recv_prim_type); a non-scalar falls through to "i32".
pub function expr_scalar_type(e: parser.Expr, s: LowerState): string {
    if (expr_is_str(e, s)) { return "string"; }
    // f32 BEFORE f64: an f32 value is also is_f64 (stored 8-byte), but its
    // method dispatch must key "f32.<m>" (distinct from f64 for to_string/etc.).
    if (expr_is_f32(e, s)) { return "f32"; }
    if (expr_is_f64(e, s)) { return "f64"; }
    // u64 BEFORE the i64 width fallback: a u64 value is also width-64, but its
    // method dispatch must key "u64.<m>" (std/u64's methods are recorded under
    // their u64 base type) — without this a u64 receiver dispatched to the
    // nonexistent "i64.<m>" and bailed the whole module to AST. Mirrors
    // method_recv_tyname's u64 branch.
    if (expr_is_u64(e, s)) { return "u64"; }
    if (infer_expr_width(e, s) == 64) { return "i64"; }
    // u32 BEFORE the "i32" fallback: a u32 value is width-32 (so it escapes the
    // width-64 checks above), but its method dispatch must key "u32.<m>" — std/u32's
    // methods are recorded under their u32 base type. Without this a u32 receiver
    // silently dispatched to the SIGNED "i32.<m>" (which std/i32 also defines, so
    // calls_only_known passed and the module did NOT bail — a real miscompile, not
    // an AST fallback): abs_diff used a signed compare, midpoint a sign-extending
    // (arithmetic) `>>`. Both diverge from the unsigned answer once bit 31 is set.
    // Mirrors the expr_is_u64 branch just above.
    if (expr_is_u32(e, s)) { return "u32"; }
    // A boolean value dispatches "boolean.<m>" (its Display / Json impl), not
    // the "i32.<m>" fallback that would render it as 1/0. Placed last: the
    // width/unsigned checks above never match a boolean, and "boolean.<m>"
    // resolves for the methods a bool actually has (to_string / to_json /
    // to_debug / eq) — any other keys an absent label and bails to AST, safe.
    if (expr_is_bool(e, s)) { return "boolean"; }
    return "i32";
}

pub function expr_recv_prim_type(e: parser.Expr, s: LowerState): string {
    // A struct receiver is NOT a primitive — let the struct path handle it.
    if (expr_struct_type(e, s) != "") { return ""; }
    // An enum value is not a primitive either: a variant construction `V(x)`
    // (call to a variant-struct name) or a unit variant `V` (bare ident naming
    // one). Returning "" bails the module to AST rather than mis-dispatching to
    // `i32.<method>` — its `<Enum>.<method>` dispatch needs the variant->enum
    // map (a later slice). An enum value held in a LOCAL is dispatched earlier
    // via expr_struct_type (the local carries the enum name).
    match (e) {
        parser.ExprCall(vc) => {
            match (vc.callee) {
                parser.ExprIdent(vci) => { if (decl_is_struct(s.structs, vci.name)) { return ""; } },
                _ => {}
            }
        },
        parser.ExprIdent(uvi) => { if (decl_is_struct(s.structs, uvi.name)) { return ""; } },
        _ => {}
    }
    // Arrays / tuples / maps aren't primitive receivers either; their builtin
    // methods (.len / .append / map ops) are intercepted before this fallback.
    return expr_scalar_type(e, s);
}

// lower_dyn_arg lowers an expression that flows into a `dyn Trait` slot
// (docs/DYN-TRAITS.md §4.2.3). A struct/enum value already carries its shape at
// offset 0 (a struct its type's shape; an enum its VARIANT's shape — the
// identity op_variant_is reads, which the backends' per-variant enum dispatch
// arms match, #4785), so it is the `dyn` pointer directly — lowered unchanged.
// A primitive/string value (expr_recv_prim_type != "") has no shape pointer, so
// it is heap-boxed into a cell [shape@0, value@8] via op_dyn_box, keyed by the
// primitive type name; the box pointer becomes the `dyn` value. op_dyn_dispatch
// then reads offset 0 and, on a primitive arm, reloads the value from offset 8.
pub function lower_dyn_arg(e: parser.Expr, s: LowerState): LowerState {
    var prim: string = expr_recv_prim_type(e, s);
    if (prim == "") {
        // Struct / enum concrete — already shape-carrying, no box.
        return lower_expr(e, s);
    }
    var ls: LowerState = lower_expr(e, s);
    if (!ls.ok) { return ls; }
    return ls.emit(ir.op_dyn_box(prim));
}

// expr_is_nonscalar conservatively reports whether `e` evaluates to a non-scalar
// (heap) value — a string, array, struct, tuple, variant box, or anything that
// might (a call). Used to keep tuple elements (and other scalar-only contexts)
// to i32/boolean: a tuple with a heap element bails to the AST path, since its
// rc would need tracking.
pub function expr_is_nonscalar(e: parser.Expr, s: LowerState): boolean {
    if (expr_is_str(e, s)) { return true; }
    if (expr_struct_type(e, s) != "") { return true; }
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprTuple(_) => { return true; },
        parser.ExprStructLit(_) => { return true; },
        parser.ExprCall(_) => { return true; },
        parser.ExprIdent(id) => { return s.is_arr_slot(s.slot_of(id.name)); },
        _ => { return false; }
    }
    return false;
}

// expr_is_str reports whether expression `e` evaluates to a string, by the
// structural cues irlower can see without a full type checker: a string
// literal, a string-marked local/param slot, or a `+` whose operands are
// strings (nested concat). Drives string-op dispatch in ExprBinary / `.len()`.
pub function (s: LowerState) is_str_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.str_ret_fns.len()) {
        if (s.str_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// expr_is_strarr reports whether `e` evaluates to a string[] array — a string-
// element array literal, or a string[]-marked local/param slot. Drives the
// element typing of `arr[i]` (a string).
// map_kv_elem_tag classifies a map `.keys()` / `.values()` METHOD call (argc 0)
// by the element type its result array yields — "i32" or "string" — or "" when
// `obj` isn't a map OR the element type isn't one the unannotated
// `var x = m.keys()/values()` array path handles. Keys are i32 (an i32-keyed
// map) or string; an i32 / string VALUE likewise. Anything else (i64 / f64 /
// u64 / u32 / struct / nested-array values) stays on the AST path: the 8-byte
// i64/f64 cases hit a SEPARATE pre-existing wasm bug in op_map_values (the
// annotated `var x: i64[] = m.values()` form mis-sums on wasm too), so routing
// them to IR would expose that, and the unsigned/heap cases need extra marking.
// The two array-source predicates (expr_is_arr_src / expr_is_strarr) and the
// StmtVar is_arr inference all gate on this ONE helper so a slot's array-ness
// and element width stay consistent. #2691.
function map_kv_elem_tag(obj: parser.Expr, field: string, argc: i32, s: LowerState): string {
    if (argc != 0) { return ""; }
    if (field != "keys" && field != "values") { return ""; }
    var mty: string = expr_map_type_tag(obj, s);
    if (mty == "") { return ""; }
    if (field == "keys") {
        if (map_key_kind_of(mty) == 1) { return "i32"; }
        return "string";
    }
    var vt: string = map_value_of(mty);
    if (vt == "i32" || vt == "string") { return vt; }
    return "";
}

// cell_elem_type returns the element type spelling of a Cell expression `e`
// (a cell local or a struct field typed Cell[T]), or "" if `e` is not a cell.
// Drives result-type propagation for c.get() (#5510).
pub function cell_elem_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (s.is_cell_slot(sl)) { return s.cell_elem_of_slot(sl); }
            return "";
        },
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            if (ft.len() > 5 && ft[0:5] == "Cell[") { return ft[5 : ft.len() - 1] + ""; }
            return "";
        },
        _ => { return ""; }
    }
}

// cell_get_elem returns the element type of a `X.get()` call where X is a cell,
// or "" otherwise — the result type c.get() produces (#5510). Used by the type
// predicates (expr_is_str etc.), which run on the ORIGINAL `c.get()` AST before
// the get->c[0] desugar, so they need this to know its type.
pub function cell_get_elem(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprCall(c) => {
            if (c.args.len() != 0) { return ""; }
            match (c.callee) {
                parser.ExprFieldAccess(fa) => {
                    if (fa.field != "get") { return ""; }
                    return cell_elem_type(fa.obj, s);
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
}

// expr_is_cell reports whether `e` denotes a Cell[T] (#5510) — a cell_new(...)
// call or a slot marked is_cell at its binding. Drives the get/set desugar to
// 1-element-array index ops.
pub function expr_is_cell(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprIdent(id) => { return s.is_cell_slot(s.slot_of(id.name)); },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(ci) => { return ci.name == "cell_new" && c.args.len() == 1; },
                _ => { return false; }
            }
        },
        // A struct FIELD typed Cell[T] — `cx.lam_ctr` where lam_ctr: Cell[i32].
        // The self-host compiler holds its cells this way, so this arm is what
        // the whole-compiler wasm path needs (locals alone don't cover it).
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            var ft: string = decl_field_type(s.structs, oty, fa.field);
            return ft.len() > 5 && ft[0:5] == "Cell[";
        },
        _ => { return false; }
    }
}

pub function expr_is_strarr(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return false; }
            return expr_is_str(arr.elements[0], s);
        },
        parser.ExprIdent(id) => { return s.is_strarr_slot(s.slot_of(id.name)); },
        // `m[i]` over a string[][] slot is itself a string[] (so `m[i][j]` reads
        // as a string and `m[i][j].len()` dispatches to str_len, #4081). Mirrors
        // the ExprIndex case in expr_is_f64arr; the slot's inner element kind is
        // recorded "string" at the `var m: string[][] = …` binding.
        parser.ExprIndex(ix) => {
            match (ix.array) {
                parser.ExprIdent(aid) => { return s.arrarr_elem_of_slot(s.slot_of(aid.name)) == "string"; },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprCall(c) => {
            // A call to a string[]-returning user function (strarr_ret_fns), the
            // `str_split(s, sep)` builtin (string→string[]), or the `s.split(sep)`
            // method form — all yield a string[] whose elements are string boxes.
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "str_split" && c.args.len() == 2) { return true; }
                    // `args()` returns a string[] of the command-line arguments, so
                    // `var a = args()` str-array-tracks (`a.len()` / `a[i]` dispatch
                    // as string[] ops, just like str_split's result).
                    if (cid.name == "args" && c.args.len() == 0) { return true; }
                    // An erased-generic `T[]` return mirroring argument i
                    // (`dup[T](x: T): T[]`): a string[] exactly when THAT
                    // argument is a string.
                    var gsa: i32 = strarr_ret_argref(s, cid.name);
                    if (gsa >= 0 && gsa < c.args.len()) { return expr_is_str(c.args[gsa], s); }
                    return s.is_strarr_ret_fn(cid.name);
                },
                parser.ExprFieldAccess(cfa) => {
                    if (cfa.field == "split" && c.args.len() == 1 && expr_is_str(cfa.obj, s)) { return true; }
                    if (cfa.field == "chars" && c.args.len() == 0 && expr_is_str(cfa.obj, s)) { return true; }
                    if (cfa.field == "lines" && c.args.len() == 0 && expr_is_str(cfa.obj, s)) { return true; }
                    // `m.keys()` on a string-keyed map / `m.values()` on a
                    // string-valued map yields a string[].
                    if (map_kv_elem_tag(cfa.obj, cfa.field, c.args.len(), s) == "string") { return true; }
                    // A string[]-returning user METHOD (`f.mks()` — the #5101
                    // sibling): resolve the receiver's struct type and look up
                    // the qualified "<BaseType>.<method>" registry entry.
                    // Without this the tuple-element tag fell to scalar and
                    // `t.N[i].len()` dispatched to a nonexistent i32 method
                    // (link failure / miscompile).
                    var mrrt: string = expr_struct_type(cfa.obj, s);
                    if (mrrt != "" && s.is_strarr_ret_fn(mrrt + "." + cfa.field)) { return true; }
                    return false;
                },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprFieldAccess(fa) => {
            // A `string[]` TUPLE element `t.N` (`(["a","b"], x)`): the element's
            // recorded tuple tag is `string[]`, so `t.N[i]` reads as a string. #3353.
            if (util.is_all_digits(fa.field)) {
                return expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s) == "string[]";
            }
            // A string[]-typed struct field read `p.items` is a string[].
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "string[]";
        },
        parser.ExprSlice(sl) => { return expr_is_strarr(sl.array, s); },
        _ => { return false; }
    }
    return false;
}

// expr_is_f64arr reports whether `e` is an f64[] array — an array literal whose
// first element is f64, or an f64-array-tracked local/param. Drives the slot's
// element-width tracking at a `var a = …` binding (mirrors expr_is_strarr).
// f64[]-returning calls and slices aren't tracked (those uses bail), so they
// fall to the default — keeping a stray width-32 a[i] off an f64 buffer out of
// the eligible set via the whole-module gate.
pub function expr_is_f64arr(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprArray(arr) => {
            if (arr.elements.len() == 0) { return false; }
            return expr_is_f64(arr.elements[0], s);
        },
        parser.ExprIdent(id) => { return s.is_f64arr_slot(s.slot_of(id.name)); },
        // `m[i]` over an f64[][] slot is itself an f64[] (so `var r = m[i]` tracks
        // r as f64[] and its `r[j]` reads 8-byte). #2691.
        parser.ExprIndex(ix2) => {
            match (ix2.array) {
                parser.ExprIdent(aid) => { return s.arrarr_elem_of_slot(s.slot_of(aid.name)) == "f64"; },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprCall(c) => {
            // A call to an f64[]-returning free function OR method (f64arr_ret_fns,
            // methods keyed "<Type>.<method>").
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // An erased-generic `T[]` return mirroring argument i
                    // (`dup[T](x: T): T[]`, the shared "name|$arg<i>" entry in
                    // strarr_ret_fns): an f64[] exactly when THAT argument is f64.
                    var gf: i32 = strarr_ret_argref(s, cid.name);
                    if (gf >= 0 && gf < c.args.len()) { return expr_is_f64(c.args[gf], s); }
                    return s.is_f64arr_ret_fn(cid.name);
                },
                parser.ExprFieldAccess(cfa) => {
                    // `a.with(...)` / `a.append(...)` preserve the receiver's element
                    // kind: an f64[] receiver yields a fresh f64[].
                    if (((cfa.field == "with" && c.args.len() == 2) || (cfa.field == "append" && c.args.len() == 1))
                        && expr_is_f64arr(cfa.obj, s)) { return true; }
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_f64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprSlice(sl) => { return expr_is_f64arr(sl.array, s); },
        // An `f64[]` TUPLE element `t.N` (`([1.5], x)`): its recorded tuple tag
        // is `f64[]`, so `t.N` is an f64[] (drives a `var xs = t.N` rebind). #3353.
        parser.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                return expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s) == "f64[]";
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_arr_src reports whether `e` is an ARRAY (an array literal, an
// array-marked local/param, an array-returning call, or a slice of one) — used
// to route `e[start:end]` to arr_slice vs str_slice.
pub function expr_is_arr_src(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprArray(_) => { return true; },
        parser.ExprIdent(id) => { return s.is_arr_slot(s.slot_of(id.name)); },
        // `a[i]` where `a` is an array-of-arrays yields an array (its element).
        parser.ExprIndex(ix) => {
            match (ix.array) {
                parser.ExprIdent(aid) => { return s.is_arrarr_slot(s.slot_of(aid.name)); },
                _ => { return false; }
            }
        },
        parser.ExprSlice(sl) => { return expr_is_arr_src(sl.array, s); },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // `__alloc_u8(n)` yields a fresh n-element byte array.
                    if (cid.name == "__alloc_u8") { return true; }
                    // `str_split(s, sep)` yields a fresh string[] (op_str_split).
                    if (cid.name == "str_split" && c.args.len() == 2) { return true; }
                    return s.is_arr_ret_fn(cid.name);
                },
                // `s.bytes()` / `s.as_bytes()` on a string receiver yields a
                // fresh u8[] (op_str_bytes), and `s.split(sep)` a fresh string[]
                // (op_str_split) — both rc-tracked array sources.
                parser.ExprFieldAccess(cfa) => {
                    if ((cfa.field == "bytes" || cfa.field == "as_bytes") && c.args.len() == 0) {
                        return expr_is_str(cfa.obj, s);
                    }
                    if (cfa.field == "split" && c.args.len() == 1) {
                        return expr_is_str(cfa.obj, s);
                    }
                    if (cfa.field == "chars" && c.args.len() == 0) {
                        return expr_is_str(cfa.obj, s);
                    }
                    if (cfa.field == "lines" && c.args.len() == 0) {
                        return expr_is_str(cfa.obj, s);
                    }
                    // An array-receiver method `arr.m()` whose std/array helper
                    // __method_Array_m RETURNS an array (reverse / sorted_asc /
                    // distinct / …) is itself an array source — so a chained
                    // `arr.reverse().join(...)` (reverse_words) recognises the
                    // inner array and dispatches the outer array method.
                    if (expr_is_arr_src(cfa.obj, s) || expr_is_strarr(cfa.obj, s) || expr_is_f64arr(cfa.obj, s) || expr_is_i64arr(cfa.obj, s)) {
                        var amn: string = s.find_arr_method(cfa.field);
                        if (amn.len() > 0 && s.is_arr_ret_fn(amn)) { return true; }
                    }
                    // `m.keys()` / `m.values()` is a fresh owned array source (drives
                    // slicing / re-binding); element width is gated identically.
                    if (map_kv_elem_tag(cfa.obj, cfa.field, c.args.len(), s) != "") { return true; }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

pub function expr_is_str(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprString(_) => { return true; },
        parser.ExprIdent(id) => {
            var isl: i32 = s.slot_of(id.name);
            if (isl >= 0) { return s.is_str_slot(isl); }
            // A bare const-string reference (`NAME`, a zero-arg string-returning
            // const fn) has no local slot but reads as a string, so `NAME.len()` /
            // `NAME + x` dispatch as string ops instead of falling through to the
            // array path (which read a string box as an array header — str_len vs
            // arr_len read different length fields, a silent miscompile). The const
            // ref itself lowers to a call of the const fn (op_call_direct, 0 args).
            return s.is_const_fn(id.name) && s.is_str_ret_fn(id.name);
        },
        parser.ExprBinary(b) => {
            if (b.op == "+") { return expr_is_str(b.left, s) || expr_is_str(b.right, s); }
            return false;
        },
        parser.ExprCall(c) => {
            // typed-IR (#5531): the annotate pass stamps c.ty with the checker's
            // inferred result type; when present it is authoritative, retiring the
            // str_ret_fns / string-builtin re-derivation below for annotated calls.
            // "" (unannotated: asm_ir_run / native, or an unresolved call) falls
            // through to the structural walk unchanged.
            if (c.ty != "") { return c.ty == "string"; }
            // c.get() on a Cell[string] yields a string (#5510) — classified
            // here because this runs on the original `c.get()` before the
            // get->c[0] desugar, so `c.get()[0]` / `.len()` see a string.
            if (cell_get_elem(e, s) == "string") { return true; }
            // A string-valued if/match-EXPRESSION desugars to a 0-arg IIFE
            // `(function(): string { if (c) { return "a"; } … })()`. Classify it
            // by its first branch's returned value, so `var s = if (…) { … }`
            // tracks s as a string (and `lower_iife` admits the string temp).
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return expr_is_str(iife_first_return_expr(lam.body[0]), s);
                        }
                    },
                    _ => {}
                }
            }
            // A call to a string-returning user function (str_ret_fns), or the
            // random_bytes builtin (a fresh string of n random bytes).
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "random_bytes") { return true; }
                    // read_all_stdin() reads fd 0 to EOF into ONE string box, so
                    // its result str-tracks (`s.len()` dispatches to str_len, the
                    // binding takes the string reclaim path). Unlike read_line it
                    // is a bare string, not an Option[string].
                    if (cid.name == "read_all_stdin" && c.args.len() == 0) { return true; }
                    // arg_at(i) boxes argv[i] into a fresh string, so it str-tracks
                    // the same way — the element of the string[] that args() builds.
                    if (cid.name == "arg_at" && c.args.len() == 1) { return true; }
                    // string_from_bytes_unchecked(arr) packs bytes into a fresh string box.
                    if (cid.name == "string_from_bytes_unchecked") { return true; }
                    // read_line() returns Option[string] now (#4369), opt-tracked via
                    // the asmcore Option type + opt_ret_type, not str-tracked here.
                    // The string-returning str_* free builtins (transform family) —
                    // the free-function spelling of `.to_upper()` / `.trim()` /
                    // `.repeat()` / `.replace()`, each yielding a fresh string box.
                    // (str_contains/index_of/starts_with/ends_with return bool/i32;
                    // str_split is string[], tracked in expr_is_strarr.)
                    if (cid.name == "str_to_upper" || cid.name == "str_to_lower"
                            || cid.name == "str_trim" || cid.name == "str_repeat"
                            || cid.name == "str_replace") { return true; }
                    // i32_to_string(n) yields a fresh decimal-text string box (the
                    // free-function spelling of `n.to_string()`).
                    if (cid.name == "i32_to_string") { return true; }
                    // chr(n) yields a fresh 1-char string box.
                    if (cid.name == "chr") { return true; }
                    // __raw_string(data, len) is the Tier-2 intrinsic that boxes raw
                    // bytes back into a string (#2649 — docs/RUNTIME-INTRINSICS.md).
                    if (cid.name == "__raw_string" && c.args.len() == 2) { return true; }
                    // strbuf_take() snapshots the global string-builder into a fresh
                    // string box (so `return strbuf_take()` str-tracks the result).
                    if (cid.name == "strbuf_take" && c.args.len() == 0) { return true; }
                    // An erased-generic fn whose return mirrors argument i
                    // (`idg[T](x: T): T`, the "name|$arg<i>" registry entry):
                    // the call is a string exactly when THAT argument is.
                    var gra: i32 = str_ret_argref(s, cid.name);
                    if (gra >= 0 && gra < c.args.len()) { return expr_is_str(c.args[gra], s); }
                    return s.is_str_ret_fn(cid.name);
                },
                // `X.to_string()` yields a string box (the i32 runtime helper or
                // the string-identity case); a struct's generated `to_string`
                // (@derive(Display)) is likewise string-typed. `to_debug`
                // (@derive(Debug)) is the same shape — always string-returning,
                // including on an ENUM receiver (whose expr_struct_type is "",
                // so the str_ret_fn path below can't reach it). Either way the
                // result feeds `+` concat / `.len()` as a string.
                parser.ExprFieldAccess(cfa) => {
                    if ((cfa.field == "to_string" || cfa.field == "to_debug") && c.args.len() == 0) { return true; }
                    // `s.to_upper()` / `s.to_lower()` on a string receiver yield a
                    // fresh string (op_str_to_upper / _to_lower), so the result
                    // feeds `.len()` / concat as a string.
                    if ((cfa.field == "to_ascii_upper" || cfa.field == "to_ascii_lower" || cfa.field == "trim" || cfa.field == "reverse") && c.args.len() == 0 && expr_is_str(cfa.obj, s)) { return true; }
                    // `s.repeat(n)` on a string receiver yields a fresh string.
                    if (cfa.field == "repeat" && c.args.len() == 1 && expr_is_str(cfa.obj, s)) { return true; }
                    if (cfa.field == "replace" && c.args.len() == 2 && expr_is_str(cfa.obj, s)) { return true; }
                    // `xs.join(sep)` on a string[] receiver yields a fresh joined
                    // string (the __fern_arr_str_join runtime helper), so the result
                    // feeds `.len()` / concat as a string. #5328.
                    if (cfa.field == "join" && c.args.len() == 1 && expr_is_strarr(cfa.obj, s)) { return true; }
                    // `m.get_or(k, d)` on a string-VALUE map (`Map[K, string]`)
                    // returns the stored string value, so the result feeds
                    // `.len()` / concat as a string. Without this the result is
                    // mis-tracked as i32 and `.len()` reads the box's data-ptr
                    // slot as a length (garbage). Keyed off the receiver slot's
                    // recorded Map type (map_value_of == "string").
                    if (cfa.field == "get_or" && c.args.len() == 2) {
                        match (cfa.obj) {
                            parser.ExprIdent(mgid) => {
                                if (map_value_of(s.map_type_of(s.slot_of(mgid.name))) == "string") { return true; }
                            },
                            // A string-VALUE map reached through a struct field
                            // (`c.m.get_or(...)`) or a TUPLE element (`t.0.get_or(...)`):
                            // resolve the receiver's Map type the same way map-method
                            // dispatch does, so the string result feeds `.len()` /
                            // concat as a string. #3317.
                            parser.ExprFieldAccess(mgfa) => {
                                if (util.is_all_digits(mgfa.field)) {
                                    if (map_value_of(expr_tuple_elem_tag(mgfa.obj, util.digits_to_i32(mgfa.field), s)) == "string") { return true; }
                                } else {
                                    var goty: string = expr_struct_type(mgfa.obj, s);
                                    if (goty != "" && map_value_of(decl_field_type(s.structs, goty, mgfa.field)) == "string") { return true; }
                                }
                            },
                            // A string-VALUE map reached through an ARRAY element
                            // (`ms[i].get_or(...)`): the array slot's element map
                            // type carries V. #3317.
                            parser.ExprIndex(mgix) => {
                                match (mgix.array) {
                                    parser.ExprIdent(mgaid) => {
                                        var mgasl: i32 = s.slot_of(mgaid.name);
                                        if (mgasl >= 0 && s.is_arr_slot(mgasl) && map_value_of(s.map_type_of(mgasl)) == "string") { return true; }
                                    },
                                    _ => {}
                                }
                            },
                            _ => {}
                        }
                    }
                    // A call THROUGH a string-returning fn-typed struct FIELD
                    // (`h.f(1)` where H.f: (i32) => string): the field's declared
                    // type coarsens to "fn" but its fn_ret keeps the string
                    // return, so the call result feeds `.len()` / concat as a
                    // string. Without this the chained `h.f(1).len()` mis-
                    // dispatched and read 0 even though the closure returned the
                    // string correctly (#5306 gap 2 — an annotated rebind
                    // `var r: string = h.f(1)` already worked).
                    var ffrty: string = expr_struct_type(cfa.obj, s);
                    if (ffrty != "" && decl_field_type(s.structs, ffrty, cfa.field) == "fn"
                        && decl_field_fn_ret(s.structs, ffrty, cfa.field) == "string") { return true; }
                    // `it.key()` / `it.value()` on a `MapIter[K, V]` receiver returns
                    // the key / value box; when that side is `string` the result
                    // feeds `.len()` / concat as a string. Without this `.len()`
                    // mis-dispatches to arr_len, reading the string box's data-ptr
                    // slot as a length (garbage) — the keys()/values() + get_or
                    // siblings above type the same way off the slot's recorded type.
                    if (cfa.field == "key" && c.args.len() == 0) {
                        match (cfa.obj) {
                            parser.ExprIdent(ikid) => {
                                var ikt: string = s.map_type_of(s.slot_of(ikid.name));
                                if (is_mapiter_type_name(ikt) && mapiter_key_kind_of(ikt) == 0) { return true; }
                            },
                            _ => {}
                        }
                    }
                    if (cfa.field == "value" && c.args.len() == 0) {
                        match (cfa.obj) {
                            parser.ExprIdent(ivid) => {
                                if (mapiter_value_of(s.map_type_of(s.slot_of(ivid.name))) == "string") { return true; }
                            },
                            _ => {}
                        }
                    }
                    // A string-returning METHOD call `recv.m(...)`. Methods store
                    // their bare name (`receiver_type` is separate), so str_ret_fns
                    // records `m` by bare name — same as the free-call lookup above.
                    // Lets `recv.m().len()` / `recv.m() + x` track as string instead
                    // of mis-dispatching `.len()` to arr_len. Guarded by a non-empty
                    // receiver type so only genuine method calls match.
                    var mrty: string = expr_struct_type(cfa.obj, s);
                    if (mrty == "") { mrty = expr_recv_prim_type(cfa.obj, s); }
                    // A `dyn Trait` receiver (#5142) falls through to the
                    // QUALIFIED lookup below: append_dyn_str_ret_fns seeds a
                    // "dyn <Trait>.<method>" entry per string-returning REQUIRED
                    // trait method, so the dispatch result tracks as a string
                    // precisely. (An earlier name-based fallback here — "any
                    // qualified entry with this method name" — let an UNRELATED
                    // type's same-named string method poison an i32 trait
                    // dispatch: `d.bar() + sv.bar().len()` lowered the `+` as
                    // str_concat over the integer result and SIGSEGV'd — the
                    // dyn-i32-vs-unrelated-string case.)
                    // Qualified lookup "<recvType>.<method>" (str_ret_fns_of keys
                    // methods that way) so a string-returning method on THIS
                    // receiver type is recognised — without colliding with a
                    // same-named method on another type that returns non-string
                    // (e.g. i32.to_lower vs string.to_lower).
                    if (mrty != "" && s.is_str_ret_fn(mrty + "." + cfa.field)) { return true; }
                    return false;
                },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprFieldAccess(fa) => {
            // A string tuple element `t.N` is a string.
            if (util.is_all_digits(fa.field)) {
                return expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s) == "string";
            }
            // A string-typed struct field read `p.name` is a string.
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "string";
        },
        parser.ExprIndex(ix) => {
            // Indexing a string[] array yields a string element.
            return expr_is_strarr(ix.array, s);
        },
        parser.ExprSlice(slc) => {
            // Slicing a string yields a string (`s[a:b]`). Without this, a
            // slice-result var isn't a str slot, so `.len()` would mis-dispatch
            // to arr_len (offset 0) instead of str_len (offset 8).
            return expr_is_str(slc.array, s);
        },
        // `inner?` unwraps an Option[string]/Result[string, E] to its string
        // payload, so `var s = f()?` str-tracks `s` (else `s.len()` mis-
        // dispatches to arr_len, reading 0). The payload type comes from the
        // same try_opt_type the width / lowering paths use — including the
        // erased-generic "Option[$arg<i>]" resolution — so a generic
        // `some1[T](x: T): Option[T]` unwrapped at a string argument tracks too.
        parser.ExprUnary(tu) => {
            if (tu.op == "try_") {
                var tot: string = try_opt_type(tu.operand, s);
                if (tot.len() >= 8 && tot[0:7] == "Option[") { return opt_payload_type(tot, "Some") == "string"; }
                if (tot.len() >= 8 && tot[0:7] == "Result[") { return opt_payload_type(tot, "Ok") == "string"; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_fresh_str reports whether `e` evaluates to a FRESH, sole-owned heap
// string box whose DATA buffer is exclusively owned — no aliasing of any live
// string's data. It is the string analogue of expr_is_arr_src (the move-source
// classifier): only such a value may be MOVED into a struct's `string` field
// and FREED by the field-drop (emit_struct_field_drops) with no alias-inc.
//
// The admitted forms each allocate a fresh data buffer AND box via __fern_alloc
// with NO identity / view fast-path (verified against the asm_ir.fern emitters):
//   - `a + b` concat            (op_str_concat — fresh data + box)
//   - `s.to_upper()` / `.to_lower()` / `.reverse()`  (always copy into a fresh
//     buffer, min 1 byte; no already-cased identity short-circuit)
//   - `s.repeat(n)`             (always a fresh buffer; n <= 0 → fresh empty box)
//   - the free-function spellings `str_to_upper` / `str_to_lower` / `str_repeat`
//   - the alloc BUILTINS `chr(n)` (fresh 1-char box) and `string_from_bytes_unchecked(arr)`
//     (packs into a fresh box) — fixed fresh-allocating semantics, no user override
//     (unlike `.to_string()`, whose derived/hand-written body may return an aliased
//     field, so it stays excluded).
// NOTE `i32_to_string(n)` is deliberately NOT here: its emitter returns a box whose
// `data` points into the MIDDLE of a 32-byte scratch buffer (digits written
// backwards), not at an allocation boundary, so the box cannot be cleanly reclaimed
// (the over-release detector fires). Freeing it would need an emitter fix (copy the
// digits to a tight fresh buffer) across all backends — a separate slice.
//
// DELIBERATELY EXCLUDED — these alias live data and would OVER-RELEASE if freed:
//   - `s.trim()` / `str_trim`   (returns a fresh box whose data pointer is a
//     zero-copy VIEW into the receiver's buffer — freeing it frees the parent's
//     data)
//   - `s.replace(a, b)` / `str_replace`  (returns the receiver box UNCHANGED on
//     an empty `old` / no match — an alias of the receiver)
//   - `.to_string()` / `.to_debug()`     (the string-identity case returns the
//     receiver box)
//   - a string literal (.rodata static), a bare ident / field-read / slice
//     (each aliases a live box the IR path never sweeps)
// Every excluded form stays inc'd at construction → the field-drop only decs the
// dup (sound, leaks, never an over-release).
// str_producer_ownership classifies the OWNERSHIP a value-producing string
// expression yields — the self-host counterpart of native ast.ExprResultOwnership
// (issue #4297 Option C, slice CS1). It names, as one classification, the
// scattered freshness heuristics: which producers hand back a FRESH owned box,
// which a borrowed alias, which a zero-copy VIEW, which an immortal literal.
// Codes mirror native ast.Ownership: 0 = Owned, 1 = Borrowed, 2 = View, 3 = Static.
//   - a fresh producer — a concat `a + b`, the alloc builtins chr /
//     string_from_bytes_unchecked / __raw_string, the str_to_upper / str_to_lower /
//     str_repeat free-fns, and the .to_upper / .to_lower / .reverse / .repeat
//     methods — is OWNED: a fresh rc=1 box the field-drop reclaims;
//   - a slice `s[a:b]` / `.trim()` is a VIEW: a zero-copy immortal box (rc=-1,
//     #4294) sharing the source buffer, never freed;
//   - a string LITERAL is STATIC (its data is interned .rodata);
//   - everything else — a bare ident / field-read / general call — is BORROWED:
//     it aliases a live box a live owner still holds.
// The View / Static / Borrowed distinctions are consumed by later slices (CS2)
// where the old boolean was lossy; expr_is_fresh_str below is exactly `== Owned`,
// so every existing caller is byte-for-byte unchanged.
pub function str_producer_ownership(e: parser.Expr, s: LowerState): i32 {
    match (e) {
        parser.ExprString(_) => { return 3; },   // static / immortal literal
        parser.ExprSlice(_) => { return 2; },     // zero-copy view (rc=-1 box)
        parser.ExprBinary(b) => {
            if (b.op == "+") { if (expr_is_str(b.left, s) || expr_is_str(b.right, s)) { return 0; } }
            return 1;
        },
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "str_to_upper" || cid.name == "str_to_lower"
                            || cid.name == "str_repeat") { return 0; }
                    if (cid.name == "chr" || cid.name == "string_from_bytes_unchecked") { return 0; }
                    // __raw_string boxes a freshly-__raw_alloc'd buffer → a fresh
                    // owned string (#2649 Tier-2 floor).
                    if (cid.name == "__raw_string" && c.args.len() == 2) { return 0; }
                    // i32_to_string is Owned on THIS path (#4355 — the exclusion
                    // note's resolution): the historical exclusion guarded the
                    // NATIVE emitter's mid-buffer boxing, but everything irlower
                    // emits calls the self-host __fern_i32_to_string, which
                    // __raw_alloc(len)s a tight buffer and boxes it at the base —
                    // an alloc boundary __fern_str_free reclaims cleanly (the
                    // same rationale that already admits it in
                    // str_free_producer_ident). Without this a replaced
                    // `name: i32_to_string(n)` struct field was construction-
                    // retained (Borrowed) and leaked one count per rebind.
                    if (cid.name == "i32_to_string" && c.args.len() == 1) { return 0; }
                    return 1;
                },
                parser.ExprFieldAccess(cfa) => {
                    if (cfa.field == "trim" && c.args.len() == 0) { return 2; }   // zero-copy view
                    if ((cfa.field == "to_ascii_upper" || cfa.field == "to_ascii_lower" || cfa.field == "reverse")
                            && c.args.len() == 0 && expr_is_str(cfa.obj, s)) { return 0; }
                    if (cfa.field == "repeat" && c.args.len() == 1 && expr_is_str(cfa.obj, s)) { return 0; }
                    return 1;
                },
                _ => { return 1; }
            }
        },
        _ => { return 1; }
    }
    return 1;
}

// expr_is_fresh_str reports whether `e` produces a FRESH, sole-owned heap string
// — the retain gate for a struct string field / reclaim temp. Derived from
// str_producer_ownership (Owned == fresh); see the classifier for the
// per-producer rationale and the excluded (aliasing / view / literal) forms.
pub function expr_is_fresh_str(e: parser.Expr, s: LowerState): boolean {
    return str_producer_ownership(e, s) == 0;
}

// field_ownerships precomputes str_producer_ownership for EVERY override value of
// a struct literal, ONCE per struct-lit, returning an i32[] parallel to
// slit.field_values (indexed by the override position `found`). This is the
// #4297 A2 unblock (see docs/OWNERSHIP-TYPES-PLAN.md): the freshness/ownership
// classification reads each field-value EXPRESSION — an aliasing read that the
// native Perceus taint model turns into a leak. Confining those reads to this
// COLD helper (called once per struct-lit) instead of the HOT lower_expr path
// (millions of calls emitting a large module) keeps lower_expr's locals
// taint-free: it consults the precomputed SCALAR i32[] (a scalar-array element
// read does not taint), while its single lower_expr(field_value) read still
// MOVES the value. Bounded per-struct-lit leak instead of the emit runaway.
pub function field_ownerships(slit: parser.ExprStructLit, s: LowerState): i32[] {
    var out: i32[] = [];
    var j: i32 = 0;
    while (j < slit.field_values.len()) {
        out = out.append(str_producer_ownership(slit.field_values[j], s));
        j = j + 1;
    }
    return out;
}

// str_binding_ownership classifies the ownership a NEW BINDING acquires from
// its init expression `e` -- the seeding-side companion of
// str_producer_ownership (#4297 CS4, the self-host mirror of native
// ast.ExprResultOwnershipWith's binding refinement; the result lands in the
// slot's str_own via mark_str_own). Producer forms classify by syntax
// (str_producer_ownership); a bare IDENT init consults the SOURCE slot's
// carried fact: a View / Static source propagates (the alias references the
// same immortal box, so the new binding is exactly as unfreeable), while an
// Owned or Borrowed source yields Borrowed -- an alias never ACQUIRES
// ownership; the original binding keeps the owning reference (freeing both
// would be the #4294 over-release).
pub function str_binding_ownership(e: parser.Expr, s: LowerState): i32 {
    match (e) {
        parser.ExprIdent(id) => {
            var si: i32 = s.slot_of(id.name);
            if (si >= 0 && s.is_str_slot(si)) {
                var so: i32 = s.str_own_slot(si);
                if (so == 2 || so == 3) { return so; }
            }
            return 1;
        },
        _ => { return str_producer_ownership(e, s); }
    }
    return 1;
}

// str_expr_ownership classifies the ownership class of the box a string
// expression EVALUATES TO -- the read-side classifier (#4297 CS4, mirroring
// native ast.ExprResultOwnershipWith): producer forms classify by syntax; a
// bare ident reflects its binding's slot-carried str_own VERBATIM (an Owned
// local reads as Owned -- whether the READER must retain before storing the
// alias is the RC pass's separate question, exactly as the native doc
// draws the line). An unknown / non-string ident falls back to 1 (Borrowed),
// the conservative never-free class. No codegen decision consults this yet;
// it is the query surface CS3 (#4355) and the reuse-analysis slice read
// instead of re-deriving ownership from the syntactic freshness heuristics.
pub function str_expr_ownership(e: parser.Expr, s: LowerState): i32 {
    match (e) {
        parser.ExprIdent(id) => {
            var si: i32 = s.slot_of(id.name);
            if (si >= 0 && s.is_str_slot(si)) { return s.str_own_slot(si); }
            return 1;
        },
        _ => { return str_producer_ownership(e, s); }
    }
    return 1;
}

// str_free_producer_ident reports whether an UNAMBIGUOUS named fresh-string
// producer — a builtin / free-function that ALWAYS returns a freshly-allocated,
// sole-owned heap string boxed at an allocation boundary — is being called. Each
// is unambiguous by NAME (no operand-type inference needed), so it is admitted
// regardless of the binding annotation (the un-annotated widening, mirroring the
// tuple `(i, 1)` arc):
//   - chr(n) / string_from_bytes_unchecked(a)           — alloc builtins, fresh box
//   - str_to_upper/str_to_lower/str_repeat(s) — free-fn spellings, fresh copy
//   - i32_to_string(n)                         — decimal-text builtin. Also Owned
//     in str_producer_ownership / expr_is_fresh_str since #4355 (the historical
//     exclusion guarded the NATIVE emitter's mid-buffer boxing; everything
//     irlower emits calls the self-host __fern_i32_to_string, which
//     __raw_alloc(len)s a tight buffer and boxes it at the base, so its data
//     pointer IS an alloc boundary and __fern_str_free (class = ceil(len/8))
//     reclaims it cleanly). (u32_to_string is left out — expr_is_str doesn't
//     str-track it, so its slot never marks is_str.)
//   - __raw_string(p, n)                       — the Tier-2 raw box constructor
// EXCLUDED here (need the `: string` disambiguation, handled in the caller): a
// bare `a + b` (could be int add) and the `.<m>()` methods (`.reverse()` /
// `.repeat()` also exist on arrays). `.to_string()` stays excluded entirely — it
// is the identity/alias case on a string receiver and may return a struct field.
function str_free_producer_ident(c: parser.ExprCall): boolean {
    match (c.callee) {
        parser.ExprIdent(cid) => {
            if (cid.name == "chr" || cid.name == "string_from_bytes_unchecked") { return true; }
            if (cid.name == "str_to_upper" || cid.name == "str_to_lower"
                    || cid.name == "str_repeat") { return true; }
            if (cid.name == "i32_to_string" && c.args.len() == 1) { return true; }
            if (cid.name == "__raw_string" && c.args.len() == 2) { return true; }
            return false;
        },
        _ => { return false; },
    }
    return false;
}

// str_local_binding_is_fresh reports (purely SYNTACTICALLY) whether `var <name> =
// init` binds a value shaped like a FRESH, sole-owned HEAP string — the string
// analogue of tuple_lit_is_fresh_scalar. It is the FRESH gate only; the TYPE gate
// is applied separately by slot_is_reclaimable_str (the slot's `is_str`, set from
// the type-aware expr_is_str at the StmtVar lowering). That two-gate split is why
// NO `: string` annotation is needed here: an un-annotated `a + b` or `x.reverse()`
// that is actually int-add / an array method has is_str == false, so it is never
// reclaimed even though it matches syntactically. The admitted shapes each allocate
// a fresh buffer + box when they ARE strings:
//   - an UNAMBIGUOUS named producer (str_free_producer_ident) — chr /
//     string_from_bytes_unchecked / str_to_upper / str_to_lower / str_repeat / i32_to_string
//     / __raw_string;
//   - an `a + b` CONCAT (fresh buffer + box when either side is a string);
//   - a `.to_upper()` / `.to_lower()` / `.reverse()` / `.repeat(n)` method (each
//     copies into a fresh buffer on a string receiver; expr_is_str only marks the
//     slot is_str for a STRING receiver, so an array `.reverse()`/`.repeat()` is
//     never reclaimed).
// DELIBERATELY EXCLUDED (each may ALIAS a live box → freeing would over-release,
// and each is is_str yet NOT fresh, so the type gate alone would not stop them):
// a string LITERAL (static, not heap), a bare ident / field / index / slice
// (aliases a live string), `.trim()` (zero-copy VIEW into the receiver buffer),
// `.replace()` / `.to_string()` (receiver-identity fast-paths), and a general
// call (may return a borrowed param).
function str_local_binding_is_fresh(init: parser.Expr): boolean {
    match (init) {
        parser.ExprCall(c) => {
            if (str_free_producer_ident(c)) { return true; }
            match (c.callee) {
                parser.ExprFieldAccess(cfa) => {
                    if ((cfa.field == "to_ascii_upper" || cfa.field == "to_ascii_lower" || cfa.field == "reverse")
                            && c.args.len() == 0) { return true; }
                    if (cfa.field == "repeat" && c.args.len() == 1) { return true; }
                    return false;
                },
                _ => { return false; },
            }
        },
        parser.ExprBinary(b) => {
            // A CONCAT (fresh when it is a string; int-add is filtered by is_str).
            return b.op == "+";
        },
        _ => { return false; },
    }
    return false;
}

// is_fresh_str_temp reports whether the string expression `e`, when lowered as a
// concat OPERAND, produces a FRESH, ANONYMOUS box that this frame solely owns and
// that is dead the instant the concat has read it — so it can be freed right after
// (#2649 anonymous-temporary reclaim). An anonymous sub-expression has no name, so
// it is referenced nowhere else and cannot alias a live value:
//   - a string LITERAL ("x"): const_str allocates a fresh 16-byte box (its .rodata
//     data is skipped by __fern_str_free's heap-base guard; the box is reclaimed on
//     asm, and on wasm the whole literal is data-section so arr_dec is a guarded
//     no-op) — this is the `s + "x"` per-iteration box leak;
//   - a fresh producer (str_local_binding_is_fresh: a nested concat, a string
//     method, or a named producer) — the intermediate of `a + b + c` / `x + f(y)`.
// A bare ident / field / index (an ALIAS of a live string) is excluded — freeing it
// would dangle the aliased value. The expr_is_str gate confirms it is a string (so
// an int `+` operand or an array `.reverse()` never matches).
function is_fresh_str_temp(e: parser.Expr, s: LowerState): boolean {
    if (!expr_is_str(e, s)) { return false; }
    match (e) { parser.ExprString(_) => { return true; }, _ => {} }
    // `n.to_string()` on a SCALAR receiver is the builtin decimal-text
    // producer (i32_to_string and its wide-int / f64 siblings) — always a
    // fresh box, so the concat may free it (#4353 concat-temp finding: this
    // was the one fresh producer str_local_binding_is_fresh missed, leaking
    // the temp per `"x" + n.to_string()` evaluation). A struct / enum / dyn
    // receiver's to_string (user-written or @derive) may return an ALIAS of
    // a live field, so only a provably-scalar receiver admits.
    match (e) {
        parser.ExprCall(c) => {
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprFieldAccess(fa) => {
                        if (fa.field == "to_string" && tostring_recv_is_scalar(fa.obj, s)) { return true; }
                    },
                    _ => {}
                }
            }
        },
        _ => {}
    }
    return str_local_binding_is_fresh(e);
}

// tostring_recv_is_scalar: the receiver of a `.to_string()` is provably a
// scalar — a number literal, a scalar cast (`x as u32` — any as_* except the
// pointer-shaped string/array hops), or a local/param slot carrying NO
// pointer-shape marker (not string / array / struct / enum / dyn / map /
// tuple / Option — params mark all of these at entry, so an unmarked slot is
// an i32/i64/u32/u64/f64/f32/bool/subword scalar). Scalar to_string always
// allocates fresh; anything else may be a user method returning an alias.
function tostring_recv_is_scalar(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprNumber(_) => { return true; },
        parser.ExprUnary(u) => {
            if (u.op.len() > 3 && u.op[0:3] == "as_") {
                var tgt: string = u.op[3:u.op.len()] + "";
                return tgt == "i32" || tgt == "i64" || tgt == "u32" || tgt == "u64"
                    || tgt == "f64" || tgt == "f32" || tgt == "u8" || tgt == "usize";
            }
            return false;
        },
        parser.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (sl < 0) { return false; }
            if (s.is_str_slot(sl) || s.is_arr_slot(sl)) { return false; }
            if (s.struct_type_of_slot(sl).len() > 0) { return false; }
            if (s.map_type_of(sl).len() > 0) { return false; }
            if (s.locals[sl].tuple_elems.len() > 0) { return false; }
            if (s.locals[sl].opt_type.len() > 0) { return false; }
            if (s.locals[sl].is_strarr || s.locals[sl].is_arrarr || s.locals[sl].is_f64arr
                    || s.locals[sl].is_i64arr || s.locals[sl].is_closurearr || s.locals[sl].is_fnarr) { return false; }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// is_sat_op reports whether `op` is one of the saturating arithmetic operators
// (`+|` / `-|` / `*|` / `<<|`, #5542): integer-only, clamping to the operand
// type's [MIN, MAX] instead of wrapping.
pub function is_sat_op(op: string): boolean {
    return op == "+|" || op == "-|" || op == "*|" || op == "<<|";
}

// lower_sat_binary lowers a saturating integer binary (`+|` / `-|` / `*|`).
//
// The tests are formulated as PRE-checks against the type's MIN / MAX rather
// than as post-hoc overflow-flag reconstruction, so one shape works at every
// width — including sub-i32 `u8`, whose wrapping mask never has to run because
// a saturated result is in range by construction. Every intermediate
// (`MAX - r` for `r > 0`, `MIN - r` for `r < 0`, …) is provably in range.
//
//     signed   a +| b →  b > 0 && a > MAX - b ? MAX
//                      : b < 0 && a < MIN - b ? MIN : a + b
//     signed   a -| b →  b < 0 && a > MAX + b ? MAX
//                      : b > 0 && a < MIN + b ? MIN : a - b
//     unsigned a +| b →  a > MAX - b ? MAX : a + b
//     unsigned a -| b →  a < b ? 0 : a - b
//     unsigned a *| b →  a != 0 && b > MAX / a ? MAX : a * b
//
// Signed `*|` is the one shape a pre-check can't express cheaply (four sign
// quadrants), so it post-checks the WRAPPED product with a division:
// `a != 0 && (s / a != b || (a == -1 && b == MIN))`. The second term is needed
// because Fern's division is total — `MIN / -1` yields `MIN`, so the round-trip
// spuriously agrees on exactly that pair. The clamp direction is the sign of
// the true product, `(a < 0) ^ (b < 0)`. Division by zero in the guarded
// operand is harmless for the same total-division reason (`x / 0 == 0`,
// docs/INTEGER-SEMANTICS.md) — the `a != 0` conjunct discards it.
//
// `<<|` is the odd one out: it post-checks with a round-trip (`(a << c) >> c ==
// a ?`) rather than a pre-check, because the negative-side pre-check bound is
// `ceil(MIN / 2^c)` and an arithmetic shift only yields the floor — `-1 <<| 31`
// must clamp to MIN, yet `MIN >> 31` is `-1`. The shift back uses the SAME
// masked count, and is arithmetic for signed / logical for unsigned, which is
// what makes it value-preserving exactly when the shift did not overflow.
//
// Branches are the self-host's void-`if` + store-to-temp shape (lower_value_if),
// not typed block results, so every backend lowers it unchanged. Mirrors
// `internal/ir.(*builder).satBinary` — keep the two in step.
function lower_sat_binary(b: parser.ExprBinary, e: parser.Expr, s: LowerState): LowerState {
    var wide: boolean = infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64;
    var kind: string = "i32";
    if (wide) {
        if (expr_is_u64(b.left, s) || expr_is_u64(b.right, s)) { kind = "u64"; } else { kind = "i64"; }
    } else if (expr_is_u32(b.left, s) || expr_is_u32(b.right, s)) {
        kind = "u32";
    } else if (expr_subword_kind(e, s) == "u8") {
        kind = "u8";
    }
    var uns: boolean = kind == "u8" || kind == "u32" || kind == "u64";
    var w: i32 = 0;
    if (wide) { w = 64; }

    // Spill both operands: every shape below reads each of them twice or more.
    var p: LowerState = s;
    var lname: string = "$satl" + util.i32_to_string(p.locals.len());
    p = p.add_local(lname);
    var lslot: i32 = p.slot_of(lname);
    if (wide) { p = p.mark_i64(lslot, true); }
    if (wide) { p = lower_i64(b.left, p); } else { p = lower_expr(b.left, p); }
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(lslot));
    var rname: string = "$satr" + util.i32_to_string(p.locals.len());
    p = p.add_local(rname);
    var rslot: i32 = p.slot_of(rname);
    if (wide) { p = p.mark_i64(rslot, true); }
    if (wide) { p = lower_i64(b.right, p); } else { p = lower_expr(b.right, p); }
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(rslot));
    var oname: string = "$sato" + util.i32_to_string(p.locals.len());
    p = p.add_local(oname);
    var oslot: i32 = p.slot_of(oname);
    if (wide) { p = p.mark_i64(oslot, true); }

    if (b.op == "<<|") {
        var hname: string = "$sats" + util.i32_to_string(p.locals.len());
        p = p.add_local(hname);
        var hslot: i32 = p.slot_of(hname);
        if (wide) { p = p.mark_i64(hslot, true); }
        var back: string = "shr_s";
        if (uns) { back = "shr_u"; }
        p = sat_load(lslot, p);
        p = sat_load(rslot, p);
        p = sat_arith("shl", kind, w, p);
        p = p.emit(ir.op_store_local(hslot));
        p = sat_load(hslot, p);
        p = sat_load(rslot, p);
        p = p.emit(ir.op_bin(back, w, false));
        p = sat_load(lslot, p);
        p = p.emit(ir.op_bin("eq", w, false));
        p = p.emit(ir.op_if(0));
        p = sat_load(hslot, p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_else());
        if (uns) {
            p = sat_const(kind, "max", p);
            p = p.emit(ir.op_store_local(oslot));
            p = p.emit(ir.op_end());
            return sat_load(oslot, p);
        }
        p = sat_load(lslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin("lt_s", w, false));
        p = p.emit(ir.op_if(0));
        p = sat_const(kind, "min", p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_else());
        p = sat_const(kind, "max", p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_end());
        p = p.emit(ir.op_end());
        return sat_load(oslot, p);
    }

    if (uns) {
        if (b.op == "+|") {
            p = sat_load(lslot, p);
            p = sat_const(kind, "max", p);
            p = sat_load(rslot, p);
            p = sat_arith("sub", kind, w, p);
            p = p.emit(ir.op_bin("gt_u", w, false));
            p = p.emit(ir.op_if(0));
            p = sat_const(kind, "max", p);
            p = p.emit(ir.op_store_local(oslot));
            p = p.emit(ir.op_else());
            p = sat_load(lslot, p);
            p = sat_load(rslot, p);
            p = sat_arith("add", kind, w, p);
            p = p.emit(ir.op_store_local(oslot));
            p = p.emit(ir.op_end());
            return sat_load(oslot, p);
        }
        if (b.op == "-|") {
            p = sat_load(lslot, p);
            p = sat_load(rslot, p);
            p = p.emit(ir.op_bin("lt_u", w, false));
            p = p.emit(ir.op_if(0));
            p = sat_const(kind, "zero", p);
            p = p.emit(ir.op_store_local(oslot));
            p = p.emit(ir.op_else());
            p = sat_load(lslot, p);
            p = sat_load(rslot, p);
            p = sat_arith("sub", kind, w, p);
            p = p.emit(ir.op_store_local(oslot));
            p = p.emit(ir.op_end());
            return sat_load(oslot, p);
        }
        p = sat_load(lslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin("ne", w, false));
        p = sat_load(rslot, p);
        p = sat_const(kind, "max", p);
        p = sat_load(lslot, p);
        p = sat_arith("div_u", kind, w, p);
        p = p.emit(ir.op_bin("gt_u", w, false));
        p = p.emit(ir.op_bin("and", 0, false));
        p = p.emit(ir.op_if(0));
        p = sat_const(kind, "max", p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_else());
        p = sat_load(lslot, p);
        p = sat_load(rslot, p);
        p = sat_arith("mul", kind, w, p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_end());
        return sat_load(oslot, p);
    }

    if (b.op == "+|" || b.op == "-|") {
        // `adj` reaches the guard bound (MAX ∓ b) — the inverse of the
        // arithmetic; `act` is the arithmetic itself. The sign test on b
        // that selects the clamp direction flips with the operator too.
        var act: string = "add";
        var adj: string = "sub";
        var hicmp: string = "gt_s";
        var locmp: string = "lt_s";
        if (b.op == "-|") {
            act = "sub";
            adj = "add";
            hicmp = "lt_s";
            locmp = "gt_s";
        }
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin(hicmp, w, false));
        p = sat_load(lslot, p);
        p = sat_const(kind, "max", p);
        p = sat_load(rslot, p);
        p = sat_arith(adj, kind, w, p);
        p = p.emit(ir.op_bin("gt_s", w, false));
        p = p.emit(ir.op_bin("and", 0, false));
        p = p.emit(ir.op_if(0));
        p = sat_const(kind, "max", p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_else());
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin(locmp, w, false));
        p = sat_load(lslot, p);
        p = sat_const(kind, "min", p);
        p = sat_load(rslot, p);
        p = sat_arith(adj, kind, w, p);
        p = p.emit(ir.op_bin("lt_s", w, false));
        p = p.emit(ir.op_bin("and", 0, false));
        p = p.emit(ir.op_if(0));
        p = sat_const(kind, "min", p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_else());
        p = sat_load(lslot, p);
        p = sat_load(rslot, p);
        p = sat_arith(act, kind, w, p);
        p = p.emit(ir.op_store_local(oslot));
        p = p.emit(ir.op_end());
        p = p.emit(ir.op_end());
        return sat_load(oslot, p);
    }

    // Signed `*|`: stash the wrapped product, then the division round-trip.
    var sname: string = "$satp" + util.i32_to_string(p.locals.len());
    p = p.add_local(sname);
    var sslot: i32 = p.slot_of(sname);
    if (wide) { p = p.mark_i64(sslot, true); }
    p = sat_load(lslot, p);
    p = sat_load(rslot, p);
    p = sat_arith("mul", kind, w, p);
    p = p.emit(ir.op_store_local(sslot));
    p = sat_load(lslot, p);
    p = sat_const(kind, "zero", p);
    p = p.emit(ir.op_bin("ne", w, false));
    p = sat_load(sslot, p);
    p = sat_load(lslot, p);
    p = sat_arith("div_s", kind, w, p);
    p = sat_load(rslot, p);
    p = p.emit(ir.op_bin("ne", w, false));
    p = sat_load(lslot, p);
    p = sat_const(kind, "negone", p);
    p = p.emit(ir.op_bin("eq", w, false));
    p = sat_load(rslot, p);
    p = sat_const(kind, "min", p);
    p = p.emit(ir.op_bin("eq", w, false));
    p = p.emit(ir.op_bin("and", 0, false));
    p = p.emit(ir.op_bin("or", 0, false));
    p = p.emit(ir.op_bin("and", 0, false));
    p = p.emit(ir.op_if(0));
    p = sat_load(lslot, p);
    p = sat_const(kind, "zero", p);
    p = p.emit(ir.op_bin("lt_s", w, false));
    p = sat_load(rslot, p);
    p = sat_const(kind, "zero", p);
    p = p.emit(ir.op_bin("lt_s", w, false));
    p = p.emit(ir.op_bin("xor", 0, false));
    p = p.emit(ir.op_if(0));
    p = sat_const(kind, "min", p);
    p = p.emit(ir.op_store_local(oslot));
    p = p.emit(ir.op_else());
    p = sat_const(kind, "max", p);
    p = p.emit(ir.op_store_local(oslot));
    p = p.emit(ir.op_end());
    p = p.emit(ir.op_else());
    p = sat_load(sslot, p);
    p = p.emit(ir.op_store_local(oslot));
    p = p.emit(ir.op_end());
    return sat_load(oslot, p);
}

// sat_load / sat_const / sat_arith are the width-aware emit primitives the
// saturating lowering is written against.
//
// `sat_const` pushes one of the four constants the lowering needs ("min" /
// "max" / "zero" / "negone") at the operand type's width. A 64-bit constant
// goes through op_const_i64_TEXT: every IR backend splices the literal text
// into its 64-bit immediate (movabsq / ldr =N / i64.const) and never reads
// op_const_i64's parsed i64_imm. An unsigned MAX rides its all-ones bit
// pattern (-1), which the operand-width unsigned compares read back as 2^W-1;
// a u32 one is re-zero-extended so the register backends hold it as 0xFFFFFFFF
// rather than a sign-extended -1.
//
// `sat_arith` re-applies the width normalisation the ordinary binary path
// applies after add/sub/mul/shl: the register backends hold a u32 zero-extended and
// an i32 sign-extended in a 64-bit register, so a 32-bit product must be
// narrowed before the signed `*|` division round-trip can detect its overflow.
function sat_load(slot: i32, s: LowerState): LowerState {
    return s.emit(ir.op_load_local(slot));
}
function sat_const(kind: string, which: string, s: LowerState): LowerState {
    if (kind == "i64" || kind == "u64") {
        var t: string = "0";
        if (which == "negone") { t = "-1"; }
        if (which == "max") {
            if (kind == "u64") { t = "-1"; } else { t = "9223372036854775807"; }
        }
        if (which == "min" && kind == "i64") { t = "-9223372036854775808"; }
        return s.emit(ir.op_const_i64_text(t));
    }
    var v: i32 = 0;
    if (which == "negone") { v = 0 - 1; }
    if (which == "max") {
        if (kind == "u8") { v = 255; } else if (kind == "u32") { v = 0 - 1; } else { v = 2147483647; }
    }
    if (which == "min" && kind == "i32") { v = 0 - 2147483647 - 1; }
    var p: LowerState = s.emit(ir.op_const_i32(v));
    if (kind == "u32") { return p.emit(ir.op_u32_wrap()); }
    return p;
}
function sat_arith(k: string, kind: string, w: i32, s: LowerState): LowerState {
    var p: LowerState = s.emit(ir.op_bin(k, w, false));
    if (k != "add" && k != "sub" && k != "mul" && k != "shl") { return p; }
    if (kind == "u32") { return p.emit(ir.op_u32_wrap()); }
    if (kind == "i32") { return p.emit(ir.op_int_cast("i32")); }
    if (kind == "u8") { return p.emit(ir.op_int_cast("u8")); }
    return p;
}

// is_chk_op reports whether `op` is a checked arithmetic operator (`+?` /
// `-?` / `*?`, #5542): integer-only, yielding `Some(result)` when it fits the
// operand type and `None` on overflow.
pub function is_chk_op(op: string): boolean {
    return op == "+?" || op == "-?" || op == "*?" || op == "/?" || op == "%?";
}

// chk_opt_type_tag is the "Option[T]" tag a checked binary (`+?` / `-?` / `*?`)
// evaluates to, T being the operand width. Option-consuming positions (a
// `match` scrutinee, a `?`) resolve the scrutinee's Option type by walking the
// expression; without this a `match (a +? b)` can't recover the Some payload's
// type and bails to the AST path. The width detection mirrors
// lower_checked_binary's `kind`.
pub function chk_opt_type_tag(b: parser.ExprBinary, s: LowerState): string {
    if (infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64) {
        if (expr_is_u64(b.left, s) || expr_is_u64(b.right, s)) { return "Option[u64]"; }
        return "Option[i64]";
    }
    if (expr_is_u32(b.left, s) || expr_is_u32(b.right, s)) { return "Option[u32]"; }
    // u8 has no distinct Option payload representation — it rides an i32 slot
    // (op_opt_make stores the 4-byte wrapped value), so the Some(v) arm binds v
    // as i32; "Option[u8]" isn't a payload tag the arm reader recognises.
    return "Option[i32]";
}

// chk_overflow pushes the overflow boolean for a checked binary. It is the
// SAME clamp condition lower_sat_binary tests (so it inherits that shape's
// per-backend proof), OR'd across the two saturation directions for
// signed add / sub because a checked op only cares that it overflowed at
// all, not which way:
//
//     unsigned +?  l > MAX - r
//     unsigned -?  l < r
//     unsigned *?  l != 0 && r > MAX / l
//     signed   +?  (r > 0 && l > MAX - r) || (r < 0 && l < MIN - r)
//     signed   -?  (r < 0 && l > MAX + r) || (r > 0 && l < MIN + r)
//     signed   *?  l != 0 && (s / l != r || (l == -1 && r == MIN))   (s = l * r wrapped)
function chk_overflow(op: string, kind: string, uns: boolean, w: i32, lslot: i32, rslot: i32, sslot: i32, s: LowerState): LowerState {
    var p: LowerState = s;
    // Checked divide / remainder: fail on a zero divisor, and for signed
    // operands also on `MIN / -1` (the one overflowing division). Same
    // condition for `/?` and `%?`.
    if (op == "/?" || op == "%?") {
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin("eq", w, false));   // r == 0
        if (uns) { return p; }
        p = sat_load(lslot, p);
        p = sat_const(kind, "min", p);
        p = p.emit(ir.op_bin("eq", w, false));    // l == MIN
        p = sat_load(rslot, p);
        p = sat_const(kind, "negone", p);
        p = p.emit(ir.op_bin("eq", w, false));    // r == -1
        p = p.emit(ir.op_bin("and", 0, false));
        return p.emit(ir.op_bin("or", 0, false)); // (r==0) || (l==MIN && r==-1)
    }
    if (uns) {
        if (op == "+?") {
            p = sat_load(lslot, p);
            p = sat_const(kind, "max", p);
            p = sat_load(rslot, p);
            p = sat_arith("sub", kind, w, p);
            return p.emit(ir.op_bin("gt_u", w, false));
        }
        if (op == "-?") {
            p = sat_load(lslot, p);
            p = sat_load(rslot, p);
            return p.emit(ir.op_bin("lt_u", w, false));
        }
        // *?  l != 0 && r > MAX / l
        p = sat_load(lslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin("ne", w, false));
        p = sat_load(rslot, p);
        p = sat_const(kind, "max", p);
        p = sat_load(lslot, p);
        p = sat_arith("div_u", kind, w, p);
        p = p.emit(ir.op_bin("gt_u", w, false));
        return p.emit(ir.op_bin("and", 0, false));
    }
    if (op == "+?" || op == "-?") {
        var rsign_hi: string = "gt_s";
        var rsign_lo: string = "lt_s";
        var adj: string = "sub";
        if (op == "-?") {
            rsign_hi = "lt_s";
            rsign_lo = "gt_s";
            adj = "add";
        }
        // hi = (r <rsign_hi> 0) && (l > MAX <adj> r)
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin(rsign_hi, w, false));
        p = sat_load(lslot, p);
        p = sat_const(kind, "max", p);
        p = sat_load(rslot, p);
        p = sat_arith(adj, kind, w, p);
        p = p.emit(ir.op_bin("gt_s", w, false));
        p = p.emit(ir.op_bin("and", 0, false));
        // lo = (r <rsign_lo> 0) && (l < MIN <adj> r)
        p = sat_load(rslot, p);
        p = sat_const(kind, "zero", p);
        p = p.emit(ir.op_bin(rsign_lo, w, false));
        p = sat_load(lslot, p);
        p = sat_const(kind, "min", p);
        p = sat_load(rslot, p);
        p = sat_arith(adj, kind, w, p);
        p = p.emit(ir.op_bin("lt_s", w, false));
        p = p.emit(ir.op_bin("and", 0, false));
        return p.emit(ir.op_bin("or", 0, false));
    }
    // signed *?  l != 0 && (s / l != r || (l == -1 && r == MIN))
    p = sat_load(lslot, p);
    p = sat_const(kind, "zero", p);
    p = p.emit(ir.op_bin("ne", w, false));
    p = sat_load(sslot, p);
    p = sat_load(lslot, p);
    p = sat_arith("div_s", kind, w, p);
    p = sat_load(rslot, p);
    p = p.emit(ir.op_bin("ne", w, false));
    p = sat_load(lslot, p);
    p = sat_const(kind, "negone", p);
    p = p.emit(ir.op_bin("eq", w, false));
    p = sat_load(rslot, p);
    p = sat_const(kind, "min", p);
    p = p.emit(ir.op_bin("eq", w, false));
    p = p.emit(ir.op_bin("and", 0, false));
    p = p.emit(ir.op_bin("or", 0, false));
    return p.emit(ir.op_bin("and", 0, false));
}

// lower_checked_binary lowers a checked integer binary (`+?` / `-?` / `*?`,
// #5542): `Some(a <op> b)` when the exact result fits the operand type,
// `None` on overflow. The overflow predicate is chk_overflow (the SAME
// condition lower_sat_binary clamps on); the difference is only the
// outcome — None vs Some(wrapped) instead of MIN/MAX/clamp.
//
// void-`if` + store-to-temp (the Option value rides oslot, a default,
// un-i64-marked slot: a pointer, i32 on wasm and 64-bit on the register
// backends). Mirrors the native desugar Binary.CheckedLowered — keep the
// two in step.
function lower_checked_binary(b: parser.ExprBinary, e: parser.Expr, s: LowerState): LowerState {
    var wide: boolean = infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64;
    var kind: string = "i32";
    if (wide) {
        if (expr_is_u64(b.left, s) || expr_is_u64(b.right, s)) { kind = "u64"; } else { kind = "i64"; }
    } else if (expr_is_u32(b.left, s) || expr_is_u32(b.right, s)) {
        kind = "u32";
    } else if (expr_subword_kind(e, s) == "u8") {
        kind = "u8";
    }
    var uns: boolean = kind == "u8" || kind == "u32" || kind == "u64";
    var w: i32 = 0;
    if (wide) { w = 64; }

    var p: LowerState = s;
    var lname: string = "$chkl" + util.i32_to_string(p.locals.len());
    p = p.add_local(lname);
    var lslot: i32 = p.slot_of(lname);
    if (wide) { p = p.mark_i64(lslot, true); }
    if (wide) { p = lower_i64(b.left, p); } else { p = lower_expr(b.left, p); }
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(lslot));
    var rname: string = "$chkr" + util.i32_to_string(p.locals.len());
    p = p.add_local(rname);
    var rslot: i32 = p.slot_of(rname);
    if (wide) { p = p.mark_i64(rslot, true); }
    if (wide) { p = lower_i64(b.right, p); } else { p = lower_expr(b.right, p); }
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(rslot));
    var basek: string = "add";
    if (b.op == "-?") { basek = "sub"; }
    if (b.op == "*?") { basek = "mul"; }
    if (b.op == "/?") { if (uns) { basek = "div_u"; } else { basek = "div_s"; } }
    if (b.op == "%?") { if (uns) { basek = "rem_u"; } else { basek = "rem_s"; } }
    // The wrapped result `s`. `+?` / `-?` / `*?` compute it UP FRONT — signed
    // `*?`'s overflow check divides it back. `/?` / `%?` must NOT: a `84 /? 0`
    // would divide by zero here, which traps on the wasm IR path (op_bin div is
    // the raw, un-guarded division). Their overflow check needs only l / r, so
    // the division is deferred into the Some branch below, where the divisor is
    // provably non-zero (and not the signed `MIN / -1`) and so can't trap.
    var is_divrem: boolean = b.op == "/?" || b.op == "%?";
    var sname: string = "$chks" + util.i32_to_string(p.locals.len());
    p = p.add_local(sname);
    var sslot: i32 = p.slot_of(sname);
    if (wide) { p = p.mark_i64(sslot, true); }
    if (!is_divrem) {
        p = sat_load(lslot, p);
        p = sat_load(rslot, p);
        p = sat_arith(basek, kind, w, p);
        p = p.emit(ir.op_store_local(sslot));
    }
    // The Option result rides a default (un-i64-marked) pointer slot.
    var oname: string = "$chko" + util.i32_to_string(p.locals.len());
    p = p.add_local(oname);
    var oslot: i32 = p.slot_of(oname);

    p = chk_overflow(b.op, kind, uns, w, lslot, rslot, sslot, p);
    p = p.emit(ir.op_if(0));
    p = p.emit(ir.op_opt_none());
    p = p.emit(ir.op_store_local(oslot));
    p = p.emit(ir.op_else());
    if (is_divrem) {
        p = sat_load(lslot, p);
        p = sat_load(rslot, p);
        p = sat_arith(basek, kind, w, p);
    } else {
        p = sat_load(sslot, p);
    }
    if (wide) { p = p.emit(ir.op_opt_make_w(0, 64, true)); } else { p = p.emit(ir.op_opt_make(0)); }
    p = p.emit(ir.op_store_local(oslot));
    p = p.emit(ir.op_end());
    return sat_load(oslot, p);
}

// emit_str_concat_reclaim lowers a string concat `b.left + b.right`, and frees any
// operand that is_fresh_str_temp classifies as a dead anonymous temp right after
// the concat consumes it. Each fresh operand is captured into a scratch slot before
// the concat (a store-then-reload that leaves the operand on the stack in place),
// the result is parked in its own scratch, the captured temps are freed, then the
// result is reloaded. A concat with NO fresh operand takes the plain fast path
// (bare op_str_concat), so non-reclaiming concats are byte-unchanged.
function emit_str_concat_reclaim(b: parser.ExprBinary, s: LowerState): LowerState {
    var lf: boolean = is_fresh_str_temp(b.left, s);
    var rf: boolean = is_fresh_str_temp(b.right, s);
    var sl: LowerState = lower_expr(b.left, s);
    if (!sl.ok) { return sl; }
    var lt: i32 = 0 - 1;
    if (lf) {
        var lname: string = "$cclt" + util.i32_to_string(sl.locals.len());
        sl = sl.add_local(lname);
        lt = sl.slot_of(lname);
        sl = sl.emit(ir.op_store_local(lt));
        sl = sl.emit(ir.op_load_local(lt));
    }
    var sr: LowerState = lower_expr(b.right, sl);
    if (!sr.ok) { return sr; }
    var rt: i32 = 0 - 1;
    if (rf) {
        var rname: string = "$ccrt" + util.i32_to_string(sr.locals.len());
        sr = sr.add_local(rname);
        rt = sr.slot_of(rname);
        sr = sr.emit(ir.op_store_local(rt));
        sr = sr.emit(ir.op_load_local(rt));
    }
    sr = sr.emit(ir.op_str_concat());
    if (!lf && !rf) { return sr; }
    var resname: string = "$ccres" + util.i32_to_string(sr.locals.len());
    sr = sr.add_local(resname);
    var res: i32 = sr.slot_of(resname);
    sr = sr.emit(ir.op_store_local(res));
    if (lf) {
        sr = sr.emit(ir.op_load_local(lt));
        sr = sr.emit(ir.op_call_direct("__fern_str_free", 1));
        sr = sr.emit(ir.op_drop());
    }
    if (rf) {
        sr = sr.emit(ir.op_load_local(rt));
        sr = sr.emit(ir.op_call_direct("__fern_str_free", 1));
        sr = sr.emit(ir.op_drop());
    }
    return sr.emit(ir.op_load_local(res));
}

// to_unsigned_kind maps a signed IR op kind to its unsigned variant, for u64
// operands (#2904): comparisons, shift-right, and div/rem. Sign-agnostic kinds
// (add/sub/mul/and/or/xor/shl/eq/ne) pass through unchanged.
pub function to_unsigned_kind(kind: string): string {
    if (kind == "lt_s") { return "lt_u"; }
    if (kind == "gt_s") { return "gt_u"; }
    if (kind == "le_s") { return "le_u"; }
    if (kind == "ge_s") { return "ge_u"; }
    if (kind == "shr_s") { return "shr_u"; }
    if (kind == "div_s") { return "div_u"; }
    if (kind == "rem_s") { return "rem_u"; }
    return kind;
}

// map_binop maps a source binary operator to its IR opcode kind (the i32 /
// signed subset). Unknown ops return "" -> caller bails.
pub function map_binop(op: string): string {
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") { return "div_s"; }
    if (op == "%") { return "rem_s"; }
    if (op == "&") { return "and"; }
    if (op == "|") { return "or"; }
    if (op == "^") { return "xor"; }
    if (op == "<<") { return "shl"; }
    if (op == ">>") { return "shr_s"; }
    if (op == "==") { return "eq"; }
    if (op == "!=") { return "ne"; }
    if (op == "<") { return "lt_s"; }
    if (op == "<=") { return "le_s"; }
    if (op == ">") { return "gt_s"; }
    if (op == ">=") { return "ge_s"; }
    return "";
}

// binop_overload_method maps an arithmetic operator to the conventionally-
// named method that overloads it on a composite (struct / enum) operand —
// `a + b` → `a.add(b)`, etc. (#2706, mirroring the native checker desugar at
// checker.go:9723). Comparison / logical / bitwise ops are intentionally not
// here: arithmetic is the Num-trait surface this covers, and `==`/`<` composite
// overloads ride their own eq/cmp path. Returns "" for a non-arithmetic op.
pub function binop_overload_method(op: string): string {
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") { return "div"; }
    if (op == "%") { return "rem"; }
    return "";
}

// for_iter_is_range reports whether a for-loop iter is the synthetic
// `__range(LOW, HIGH)` / `__range_incl(LOW, HIGH)` call the parser emits
// for `for i in LOW..HIGH` / `for i in LOW..=HIGH`. Mirrors the checker's
// for_iter_is_range (which binds the loop var to i32).
pub function for_iter_is_range(iter: parser.Expr): boolean {
    match (iter) {
        parser.ExprCall(c) => {
            if (c.args.len() != 2) { return false; }
            match (c.callee) {
                parser.ExprIdent(id) => { return id.name == "__range" || id.name == "__range_incl"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// for_iter_is_range_incl reports whether the for-loop iter is the
// inclusive `__range_incl(LOW, HIGH)` form (closed interval [LOW, HIGH]),
// so lower_range_for emits a `<=` rather than `<` loop condition.
pub function for_iter_is_range_incl(iter: parser.Expr): boolean {
    match (iter) {
        parser.ExprCall(c) => {
            if (c.args.len() != 2) { return false; }
            match (c.callee) {
                parser.ExprIdent(id) => { return id.name == "__range_incl"; },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
}

// is_numeric_cast_op reports whether an `as_<T>` unary op is a numeric
// CONVERSION (truncate / sign-extend / float-round) rather than a
// zero-cost type ascription. The conversions change the runtime value;
// everything else (`as i32[]`, `as string`, `as Option`) is an ascription.
pub function is_numeric_cast_op(op: string): boolean {
    return op == "as_i32" || op == "as_u32" || op == "as_i64" || op == "as_u64"
        || op == "as_f64" || op == "as_f32" || op == "as_float";
}

// ascription_target returns the target type name of an ascription cast
// `E as T` (init = the `as_<T>` unary), or "" if `init` isn't an ascription.
// A numeric conversion (`as i32`, `as f64`, …) returns "" — it is a real
// value conversion, not an identity ascription.
pub function ascription_target(init: parser.Expr): string {
    match (init) {
        parser.ExprUnary(u) => {
            if (u.op.len() > 3 && u.op[0:3] == "as_" && !is_numeric_cast_op(u.op)) {
                return u.op[3:u.op.len()] + "";
            }
            return "";
        },
        _ => { return ""; }
    }
}

// ascription_rebind rewrites `var x = E as T` to the equivalent annotated
// binding `var x: T = E` (the `as` ascription is identity). Caller guards
// with `ascription_target(v.init) != ""`, so v.init is always an ascription
// unary here; the `_` arm returns v unchanged for exhaustiveness.
pub function ascription_rebind(v: parser.StmtVar): parser.Stmt {
    match (v.init) {
        parser.ExprUnary(au) => {
            return parser.StmtVar { name: v.name, type_name: ascription_target(v.init), init: au.operand, line: v.line, col: v.col, is_str: v.is_str };
        },
        _ => { return v; }
    }
}

// lower_range_for lowers `for i in LOW..HIGH { body }` (iter = the synthetic
// `__range(LOW, HIGH)` call) to a counted loop over the half-open interval —
// or the closed interval `[LOW, HIGH]` for the inclusive `__range_incl` form
// (`for i in LOW..=HIGH`), which only changes the loop condition to `i <= hi`.
// HIGH is bound once into a hidden local (so `for i in 0..f()` calls f()
// once), i = LOW, then `while (i < hi) { body; i = i + 1 }`. The caller has
// already bailed bodies containing break/continue (a `continue` would skip
// the increment), so the counted shape is safe. LOW / HIGH are i32 exprs.
// Split out of lower_stmt's StmtFor arm so that arm stays small (oversized
// functions miscompile on the native backend — cf. #2720).
pub function lower_range_for(var_name: string, iter: parser.Expr, body: parser.Stmt[], s: LowerState): LowerState {
    var r_lo: parser.Expr = iter;
    var r_hi: parser.Expr = iter;
    match (iter) {
        parser.ExprCall(rc) => {
            r_lo = rc.args[0];
            r_hi = rc.args[1];
        },
        _ => {}
    }
    // Closed interval `[LOW, HIGH]` (`for i in LOW..=HIGH`) exits on `i <= hi`;
    // the half-open `[LOW, HIGH)` default exits on `i < hi`.
    var cond_kind: string = "lt_s";
    if (for_iter_is_range_incl(iter)) { cond_kind = "le_s"; }
    // hidden HIGH bound (evaluated once)
    var hin: string = "$forhi" + util.i32_to_string(s.locals.len());
    var rs: LowerState = s.add_local(hin);
    var hislot: i32 = rs.slot_of(hin);
    rs = lower_expr(r_hi, rs);
    if (!rs.ok) { return rs; }
    rs = rs.emit(ir.op_store_local(hislot));
    // loop var i = LOW - 1 (user-visible i32 binding). The increment runs at
    // the TOP of the loop (after the header, before the condition) rather than
    // the bottom, so a `continue` — which branches to the loop header — re-runs
    // the increment instead of skipping it (#2788). Starting at LOW-1 means the
    // first top-advance lands i on LOW, so the body still observes LOW, LOW+1, …
    rs = rs.add_local(var_name);
    var islot: i32 = rs.slot_of(var_name);
    rs = lower_expr(r_lo, rs);
    if (!rs.ok) { return rs; }
    rs = rs.emit(ir.op_const_i32(1));
    rs = rs.emit(ir.op_bin("sub", 0, false));   // i = LOW - 1
    rs = rs.emit(ir.op_store_local(islot));
    rs = rs.emit(ir.op_block(0)).enter_loop();  // depth 1 = break/exit target
    rs = rs.emit(ir.op_loop(0));                // depth 0 = continue/header
    // advance: i = i + 1 (runs on every header entry, incl. after `continue`).
    rs = rs.emit(ir.op_load_local(islot));
    rs = rs.emit(ir.op_const_i32(1));
    rs = rs.emit(ir.op_bin("add", 0, false));
    rs = rs.emit(ir.op_store_local(islot));
    // cond: i < hi (or i <= hi for the inclusive form) ; exit when NOT.
    rs = rs.emit(ir.op_load_local(islot));
    rs = rs.emit(ir.op_load_local(hislot));
    rs = rs.emit(ir.op_bin(cond_kind, 0, false));
    rs = rs.emit(ir.op_bin("not", 0, false));
    rs = rs.emit(ir.op_brif(1));
    rs = lower_block(body, rs);
    if (!rs.ok) { return rs; }
    rs = rs.emit(ir.op_br(0));   // back-edge to header (re-advances)
    rs = rs.emit(ir.op_end());
    return rs.emit(ir.op_end()).exit_loop();
}

// lower_foreach_snapshot lowers `for x in <EXPR>` where the iterable is not a
// bare local — an array literal (`for x in [1, 2, 3]`) or a call returning an
// array (`for x in mk()`). It binds the iterable to a hidden local through the
// normal `var` lowering (which marks the slot's array / element-type flags and
// RC-owns the value — a fresh literal or a move-on-return result is owned, so
// the exit-sweep frees it), then re-lowers the loop over that local via the
// ident-foreach path. The caller guards that fr.iter is not an ident and the
// loop var has no comma (the `for k, v in m` map form needs a map local). Kept
// in its own function so the already-large StmtFor arm doesn't grow (oversized
// functions miscompile on the native backend — cf. #2720).
pub function lower_foreach_snapshot(var_name: string, iter: parser.Expr, body: parser.Stmt[], s: LowerState): LowerState {
    var itn: string = "$forit" + util.i32_to_string(s.locals.len());
    var sv: parser.Stmt = parser.StmtVar { name: itn, type_name: "", init: iter, line: 0, col: 0, is_str: false };
    var s2: LowerState = lower_stmt(sv, s);
    if (!s2.ok) { return s2; }
    var nf: parser.Stmt = parser.StmtFor { var_name: var_name, iter: parser.ExprIdent { name: itn, line: 0, col: 0 }, body: body, label: "" };
    return lower_stmt(nf, s2);
}

// lower_array_to_json lowers `arr.to_json()` (the element-poly array serialiser
// `(xs: T[]) to_json[T: Json]()` from std/json) as an INLINE loop, so the
// per-element `arr[i].to_json()` is lowered where the element type is statically
// known and dispatches to the right impl. Desugars to:
//   var $tjout = "[";
//   var $tji = 0;
//   while ($tji < arr.len()) {
//       if ($tji > 0) { $tjout = $tjout + ","; }
//       $tjout = $tjout + arr[$tji].to_json();
//       $tji = $tji + 1;
//   }
//   $tjout + "]"          // result expression left on the stack
// A non-ident receiver is snapshotted into a hidden local first (evaluated
// once; ident receivers are loaded per use, which is free). The generic body
// `__fn_T__to_json` is still emitted but dead — call sites all route here. #2766.
// `$out = $out.append(BYTE as u8)` as a synthetic assign — the u8[]-buffer
// append driving the O(n) array serialiser (#4379). `byte` is any Expr; it is
// cast with the `as_u8` unary (how the parser desugars `x as u8`).
function to_json_append_stmt(on: string, byte: parser.Expr): parser.Stmt {
    var oref: parser.Expr = parser.ExprIdent { name: on, line: 0, col: 0 };
    var casted: parser.Expr = parser.ExprUnary { op: "as_u8", operand: byte, line: 0, col: 0 };
    var app: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: oref, field: "append", line: 0, col: 0 }, args: [casted], line: 0, col: 0, type_argc: 0, ty: "" };
    return parser.StmtAssign { target: on, value: app, line: 0, col: 0, target_line: 0, target_col: 0 };
}

// The inner byte-copy loop `while ($k < $s.len()) { $out = $out.append($s[$k] as
// u8); $k = $k+1 }` — appends every byte of a per-element to_json() result to the
// output buffer. Split out to keep the loop builders small (large functions
// miscompile on the native backend, #2720).
function to_json_bytecopy_stmt(on: string, sn: string, kn: string): parser.Stmt {
    var sref: parser.Expr = parser.ExprIdent { name: sn, line: 0, col: 0 };
    var kref: parser.Expr = parser.ExprIdent { name: kn, line: 0, col: 0 };
    var one: parser.Expr = parser.ExprNumber { text: "1", suffix: "", is_float: false, line: 0, col: 0 };
    var lenc: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: sref, field: "len", line: 0, col: 0 }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    var cond: parser.Expr = parser.ExprBinary { op: "<", left: kref, right: lenc, line: 0, col: 0 };
    var elem: parser.Expr = parser.ExprIndex { array: sref, index: kref, unchecked: false };
    var app: parser.Stmt = to_json_append_stmt(on, elem);
    var inc: parser.Stmt = parser.StmtAssign { target: kn, value: parser.ExprBinary { op: "+", left: kref, right: one, line: 0, col: 0 }, line: 0, col: 0, target_line: 0, target_col: 0 };
    return parser.StmtWhile { cond: cond, body: [app, inc], label: "" };
}

// to_json_loop_stmt builds the synthetic outer loop driving the array serialiser
// (#4379 — the u8[]-buffer form, so appends grow in place instead of the old
// O(n²) `out = out + …` concat):
//   while ($i < aref.len()) {
//       if ($i > 0) { $out = $out.append(44 as u8); }   // ','
//       var $s = aref[$i].to_json();
//       var $k = 0;
//       while ($k < $s.len()) { $out = $out.append($s[$k] as u8); $k = $k+1; }
//       $i = $i + 1;
//   }
// Split out of lower_array_to_json so neither function is oversized (#2720).
function to_json_loop_stmt(on: string, inm: string, sn: string, kn: string, aref: parser.Expr): parser.Stmt {
    var iref: parser.Expr = parser.ExprIdent { name: inm, line: 0, col: 0 };
    var zero: parser.Expr = parser.ExprNumber { text: "0", suffix: "", is_float: false, line: 0, col: 0 };
    var one: parser.Expr = parser.ExprNumber { text: "1", suffix: "", is_float: false, line: 0, col: 0 };
    var comma: parser.Expr = parser.ExprNumber { text: "44", suffix: "", is_float: false, line: 0, col: 0 };
    var lenc: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: aref, field: "len", line: 0, col: 0 }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    var cond: parser.Expr = parser.ExprBinary { op: "<", left: iref, right: lenc, line: 0, col: 0 };
    var igt: parser.Expr = parser.ExprBinary { op: ">", left: iref, right: zero, line: 0, col: 0 };
    var noelse: parser.Stmt[] = [];
    var ifc: parser.Stmt = parser.StmtIf { cond: igt, then_body: [to_json_append_stmt(on, comma)], else_body: noelse };
    // var $s = aref[$i].to_json();
    var elem: parser.Expr = parser.ExprIndex { array: aref, index: iref, unchecked: false };
    var elemj: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: elem, field: "to_json", line: 0, col: 0 }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    var dvs: parser.Stmt = parser.StmtVar { name: sn, type_name: "", init: elemj, line: 0, col: 0, is_str: false };
    // var $k = 0;
    var dk: parser.Stmt = parser.StmtVar { name: kn, type_name: "", init: zero, line: 0, col: 0, is_str: false };
    var copyl: parser.Stmt = to_json_bytecopy_stmt(on, sn, kn);
    var inc: parser.Stmt = parser.StmtAssign { target: inm, value: parser.ExprBinary { op: "+", left: iref, right: one, line: 0, col: 0 }, line: 0, col: 0, target_line: 0, target_col: 0 };
    var body: parser.Stmt[] = [ifc, dvs, dk, copyl, inc];
    return parser.StmtWhile { cond: cond, body: body, label: "" };
}

pub function lower_array_to_json(arr: parser.Expr, s: LowerState): LowerState {
    var n: i32 = s.locals.len();
    var on: string = "$tjout" + util.i32_to_string(n);
    var inm: string = "$tji" + util.i32_to_string(n);
    var sn: string = "$tjs" + util.i32_to_string(n);
    var kn: string = "$tjk" + util.i32_to_string(n);
    var s2: LowerState = s;
    var aref: parser.Expr = arr;
    // Snapshot a non-ident receiver so `.len()` and each `arr[i]` reference the
    // same once-evaluated value (an ident is just a local load, so reuse it).
    var is_ident: boolean = false;
    match (arr) {
        parser.ExprIdent(_) => { is_ident = true; },
        _ => {}
    }
    if (!is_ident) {
        var an: string = "$tjarr" + util.i32_to_string(n);
        var snap: parser.Stmt = parser.StmtVar { name: an, type_name: "", init: arr, line: 0, col: 0, is_str: false };
        s2 = lower_stmt(snap, s);
        if (!s2.ok) { return s2; }
        aref = parser.ExprIdent { name: an, line: 0, col: 0 };
    }
    // var $tjout: u8[] = [];  — the growable output buffer (#4379)
    var dout: parser.Stmt = parser.StmtVar { name: on, type_name: "u8[]", init: parser.ExprArray { elements: [] }, line: 0, col: 0, is_str: false };
    s2 = lower_stmt(dout, s2);
    if (!s2.ok) { return s2; }
    // $tjout = $tjout.append(91 as u8);  — '['
    s2 = lower_stmt(to_json_append_stmt(on, parser.ExprNumber { text: "91", suffix: "", is_float: false, line: 0, col: 0 }), s2);
    if (!s2.ok) { return s2; }
    // var $tji = 0;
    var di: parser.Stmt = parser.StmtVar { name: inm, type_name: "", init: parser.ExprNumber { text: "0", suffix: "", is_float: false, line: 0, col: 0 }, line: 0, col: 0, is_str: false };
    s2 = lower_stmt(di, s2);
    if (!s2.ok) { return s2; }
    // the serialising loop (built in helpers to keep this function small)
    s2 = lower_stmt(to_json_loop_stmt(on, inm, sn, kn, aref), s2);
    if (!s2.ok) { return s2; }
    // $tjout = $tjout.append(93 as u8);  — ']'
    s2 = lower_stmt(to_json_append_stmt(on, parser.ExprNumber { text: "93", suffix: "", is_float: false, line: 0, col: 0 }), s2);
    if (!s2.ok) { return s2; }
    // result expression: string_from_bytes_unchecked($tjout)
    var result: parser.Expr = parser.ExprCall { callee: parser.ExprIdent { name: "string_from_bytes_unchecked", line: 0, col: 0 }, args: [parser.ExprIdent { name: on, line: 0, col: 0 }], line: 0, col: 0, type_argc: 0, ty: "" };
    return lower_expr(result, s2);
}

// lower_string_foreach lowers `for b in STR` (iterate a string's bytes). The
// array foreach assumes an array layout — length @0, elements @ base+idx*8+8 —
// but a string is { data_ptr @0, len @8 } with byte elements, so the array
// path reads the data pointer as the length and 8-byte-indexes the header
// (#2822). Desugar to a counted loop over STR.len() with a byte-index bind,
// reusing the range-for (`__range`) and string-index (byte load) paths, both
// of which are already correct in isolation. The string is snapshotted into a
// hidden local so it is evaluated once.
function lower_string_foreach(var_name: string, iter: parser.Expr, body: parser.Stmt[], s: LowerState): LowerState {
    var n: i32 = s.locals.len();
    var sn: string = "$fostr" + util.i32_to_string(n);
    var idx: string = "$fosi" + util.i32_to_string(n);
    var snv: parser.Stmt = parser.StmtVar { name: sn, type_name: "", init: iter, line: 0, col: 0, is_str: false };
    var s2: LowerState = lower_stmt(snv, s);
    if (!s2.ok) { return s2; }
    var sref: parser.Expr = parser.ExprIdent { name: sn, line: 0, col: 0 };
    var iref: parser.Expr = parser.ExprIdent { name: idx, line: 0, col: 0 };
    var zero: parser.Expr = parser.ExprNumber { text: "0", suffix: "", is_float: false, line: 0, col: 0 };
    var lenc: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: sref, field: "len", line: 0, col: 0 }, args: [], line: 0, col: 0, type_argc: 0, ty: "" };
    var rargs: parser.Expr[] = [zero, lenc];
    var range_iter: parser.Expr = parser.ExprCall { callee: parser.ExprIdent { name: "__range", line: 0, col: 0 }, args: rargs, line: 0, col: 0, type_argc: 0, ty: "" };
    var bind: parser.Stmt = parser.StmtVar { name: var_name, type_name: "", init: parser.ExprIndex { array: sref, index: iref, unchecked: false }, line: 0, col: 0, is_str: false };
    var nbody: parser.Stmt[] = [bind];
    var bi: i32 = 0;
    while (bi < body.len()) { nbody = nbody.append(body[bi]); bi = bi + 1; }
    var forc: parser.Stmt = parser.StmtFor { var_name: idx, iter: range_iter, body: nbody, label: "" };
    return lower_stmt(forc, s2);
}

// is_cmp_kind reports whether an IR bin-op kind produces an i32 boolean (a
// comparison / equality) rather than a value of the operand width.
pub function is_cmp_kind(kind: string): boolean {
    return kind == "eq" || kind == "ne" || kind == "lt_s" || kind == "le_s" || kind == "gt_s" || kind == "ge_s";
}

// map_fbinop maps a source operator to its f64 IR opcode (arithmetic yields an
// f64; a compare yields an i32 0/1). "" for operators with no float form (`%`,
// bitwise, shifts — those bail on float operands).
pub function map_fbinop(op: string): string {
    if (op == "+") { return "fadd"; }
    if (op == "-") { return "fsub"; }
    if (op == "*") { return "fmul"; }
    if (op == "/") { return "fdiv"; }
    if (op == "==") { return "feq"; }
    if (op == "!=") { return "fne"; }
    if (op == "<") { return "flt"; }
    if (op == "<=") { return "fle"; }
    if (op == ">") { return "fgt"; }
    if (op == ">=") { return "fge"; }
    return "";
}
pub function is_fcmp_kind(kind: string): boolean {
    return kind == "feq" || kind == "fne" || kind == "flt" || kind == "fle" || kind == "fgt" || kind == "fge";
}

// f64_math_builtin_kind maps a std/float math builtin name to its op_funary
// opcode, or "" if `name` is not one. Most are a single hardware instruction:
// __sqrt_f64 (sqrtsd / fsqrt / f64.sqrt), __floor_f64 / __ceil_f64 / __trunc_f64
// (roundsd $1/$2/$3 / frintm/p/z / f64.floor/ceil/trunc), and __abs_f64 (sign-bit
// mask / fabs / f64.abs). __round_f64 (round-half-away, Go's math.Round) is one
// instruction on arm64 (frinta) but needs trunc(x+copysign(0.5,x)) emulation on
// x86 (roundsd toward zero) and wasm (f64.nearest is ties-to-even, not -away).
// The libm transcendentals (log/exp/sin/cos/pow) still stay on the AST path.
pub function f64_math_builtin_kind(name: string): string {
    if (name == "__sqrt_f64") { return "fsqrt"; }
    if (name == "__floor_f64") { return "ffloor"; }
    if (name == "__ceil_f64") { return "fceil"; }
    if (name == "__trunc_f64") { return "ftrunc"; }
    if (name == "__abs_f64") { return "fabs"; }
    if (name == "__round_f64") { return "fround"; }
    // The libm transcendentals: x86 computes these on the x87 FPU (fsin / fcos /
    // fyl2x+f2xm1), arm64 calls its polynomial-approximation runtime helpers
    // (bl __fern_<op>_f64). wasm has no transcendental instruction or IR runtime
    // for them, so wasm_eligible subtracts these op kinds and a transcendental
    // module stays on the wasm AST path (#2691 float-math IR widening).
    if (name == "__sin_f64") { return "fsin"; }
    if (name == "__cos_f64") { return "fcos"; }
    if (name == "__exp_f64") { return "fexp"; }
    if (name == "__log_f64") { return "flog"; }
    return "";
}

// arr_index_is_f64 reports whether indexing `arr` (the array operand of `a[i]`)
// yields an f64 — i.e. `arr` names an f64[] slot. Only a tracked ident source
// qualifies (literals / function-return arrays aren't f64-element-tracked);
// anything else is the i32 default.
pub function arr_index_is_f64(arr: parser.Expr, s: LowerState): boolean {
    match (arr) {
        parser.ExprIdent(id) => { return s.is_f64arr_slot(s.slot_of(id.name)); },
        // Nested read `m[i][j]` over an f64[][] slot — 8-byte (f64) element. #2691.
        parser.ExprIndex(ix2) => {
            match (ix2.array) {
                parser.ExprIdent(aid) => { return s.arrarr_elem_of_slot(s.slot_of(aid.name)) == "f64"; },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprCall(c) => {
            // Direct index of an f64[]-returning call: `f()[i]` or `obj.m()[i]`.
            match (c.callee) {
                parser.ExprIdent(cid) => { return s.is_f64arr_ret_fn(cid.name); },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_f64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        // `t.N[i]` where `t.N` is an f64[] TUPLE element (`([1.5], x)`): the
        // element's recorded tuple tag is `f64[]`, so the read uses 8-byte
        // (f64) width — the tuple-element sibling of the struct-field case. #3353.
        parser.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                return expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s) == "f64[]";
            }
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "f64[]";
        },
        // Direct index of a slice expression `a[lo:hi][i]`: an f64[] slice is
        // itself an f64[], so recurse into the sliced array — mirroring
        // expr_is_f64arr's ExprSlice case. Without this the index defaulted to
        // the 4-byte i32 path, so on wasm `a[lo:hi][i]` loaded at a 4-byte
        // stride instead of f64's 8-byte stride (#2908).
        parser.ExprSlice(sl) => { return expr_is_f64arr(sl.array, s); },
        // Direct index of an f64 array LITERAL `[1.0, 2.0][i]`: the ExprArray
        // construction builds it at an 8-byte f64 stride (ewidth=64 when
        // elements[0] is f64), so the read must match — mirror that same
        // first-element probe. Without this the read defaulted to the 4-byte
        // i32 path and mis-strode the f64 literal on wasm (the ExprArray sibling
        // of the #2908 ExprSlice gap; register backends use 8-byte slots so only
        // wasm was affected).
        parser.ExprArray(al) => { return al.elements.len() > 0 && expr_is_f64(al.elements[0], s); },
        _ => { return false; }
    }
    return false;
}

// arr_index_is_i64 reports whether indexing `arr` yields an i64 — `arr` names an
// i64[] slot. Drives a[i] -> arr_get_i64 (i64.load). (i64[] returns / slices are
// a later slice; only a tracked ident source qualifies here.)
//
// u64[] qualifies too: u64 lives in the i64 64-bit domain (#2904), so a u64[]
// element is read 8-byte with the SAME arr_get_i64 (identical bytes). This
// function answers "is this an 8-byte-element array index" (width only); the
// element's UNSIGNED-ness is tracked separately by expr_is_u64, which drives the
// signed-vs-unsigned op selection at the use site — so reading a u64[] element
// here and comparing it unsigned there stays correct for values >= 2^63.
pub function arr_index_is_i64(arr: parser.Expr, s: LowerState): boolean {
    match (arr) {
        parser.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            // i64[] (is_i64arr) or u64[] (an array slot also marked u64) — both
            // 8-byte elements. is_u64_slot is set for scalar u64 too, so the
            // is_arr_slot guard keeps this to u64[] arrays.
            return s.is_i64arr_slot(sl) || (s.is_arr_slot(sl) && s.is_u64_slot(sl));
        },
        // Nested read `m[i][j]`: the outer array here is `m[i]` (an ExprIndex over
        // a T[][] slot). Its element width is the arrarr slot's recorded inner
        // kind — "i64" or "u64" both select the 8-byte arr_get_i64 (the
        // unsigned-ness is recovered separately by expr_is_u64). #2691 / #5206.
        parser.ExprIndex(ix2) => {
            match (ix2.array) {
                parser.ExprIdent(aid) => { var ae: string = s.arrarr_elem_of_slot(s.slot_of(aid.name)); return ae == "i64" || ae == "u64"; },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprCall(c) => {
            // Direct index of an i64[]-returning call: `f()[i]` or `obj.m()[i]`.
            match (c.callee) {
                parser.ExprIdent(cid) => { return s.is_i64arr_ret_fn(cid.name); },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_i64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        // `t.N[i]` where `t.N` is an i64[] TUPLE element (`([x as i64], y)`): the
        // element's recorded tuple tag is `i64[]`, so the read uses 8-byte (i64)
        // width — the tuple sibling of the struct-field case below, mirroring
        // arr_index_is_f64's tuple-element branch. #3353.
        // `p.vals[i]` where p's field `vals` is an i64[] struct field.
        parser.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                return expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s) == "i64[]";
            }
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return false; }
            return decl_field_type(s.structs, oty, fa.field) == "i64[]";
        },
        // Direct index of a slice expression `a[lo:hi][i]`: an i64[] slice is
        // itself an i64[], so recurse into the sliced array — mirroring
        // expr_is_i64arr's ExprSlice case (the same latent stride gap #2908
        // fixed for f64[]).
        parser.ExprSlice(sl) => { return expr_is_i64arr(sl.array, s); },
        // Direct index of an i64/u64 array LITERAL `[x as i64, …][i]`: the
        // ExprArray construction emits arr_make_i64 (8-byte stride) when
        // elements[0] is 64-bit-wide and not f64, so the read must match —
        // mirror that same first-element probe (the i64 sibling of the f64
        // ExprArray arm above; wasm-only, register backends unaffected).
        parser.ExprArray(al) => { return al.elements.len() > 0 && !expr_is_f64(al.elements[0], s) && infer_expr_width(al.elements[0], s) == 64; },
        _ => { return false; }
    }
    return false;
}

// arr_index_is_i32_scalar reports whether `arr` is a plain 32-bit-element array
// IDENT slot — an i32[] (or u32[]) — so `arr[i]` reads a 32-bit integer element.
// It deliberately EXCLUDES every wider/typed array overlay (i64[]/u64[], f64[],
// string[], T[][], closure[]/fn[]); arr_index_is_i64 covers the 8-byte case in
// lower_i64 directly. Drives the i32-element widening of `s64 + a[i]` in
// lower_i64's ExprIndex arm (the checker forbids i64 + u32, so such an element
// reaching an i64 context is a signed i32). #2691.
pub function arr_index_is_i32_scalar(arr: parser.Expr, s: LowerState): boolean {
    match (arr) {
        parser.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (!s.is_arr_slot(sl)) { return false; }
            if (s.is_i64arr_slot(sl)) { return false; }
            if (s.is_f64arr_slot(sl)) { return false; }
            if (s.is_strarr_slot(sl)) { return false; }
            if (s.is_arrarr_slot(sl)) { return false; }
            if (s.is_closurearr_slot(sl)) { return false; }
            if (s.is_fnarr_slot(sl)) { return false; }
            if (s.is_u64_slot(sl)) { return false; }
            return true;
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_i64arr reports whether `e` is an i64[] — an i64-array-tracked
// local/param (aliasing), an i64[]-returning call, an i64[] slice, OR a literal
// whose first element is an unambiguous 64-bit int (`[x as i64, …]`). A bare
// integer literal (`[10, 20]`) stays i32 — only an explicitly-64-bit first
// element (an `as i64`/`as u64` cast or an i64-typed operand) marks the literal
// i64[], mirroring the StmtVar i64[]-literal binding detection (#3353). This
// lets an i64[] tuple element / array literal in a non-binding position carry
// its 8-byte element width through elem_type_tag.
pub function expr_is_i64arr(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprArray(lit) => {
            if (lit.elements.len() == 0) { return false; }
            return !expr_is_f64(lit.elements[0], s) && infer_expr_width(lit.elements[0], s) == 64;
        },
        parser.ExprIdent(id) => { return s.is_i64arr_slot(s.slot_of(id.name)); },
        // `m[i]` over an i64[][] or u64[][] slot is itself an 8-byte-element
        // array (so `var r = m[i]` tracks r for 8-byte `r[j]` reads). #2691 /
        // #5206 — the width is shared; expr_is_u64 recovers the u64 sign.
        parser.ExprIndex(ix2) => {
            match (ix2.array) {
                parser.ExprIdent(aid) => { var ae: string = s.arrarr_elem_of_slot(s.slot_of(aid.name)); return ae == "i64" || ae == "u64"; },
                _ => { return false; }
            }
            return false;
        },
        parser.ExprSlice(sl) => { return expr_is_i64arr(sl.array, s); },
        // An `i64[]` TUPLE element `t.N` (`([x as i64], y)`): its recorded tuple
        // tag is `i64[]`, so `t.N` is an i64[] (drives a `var xs = t.N` rebind so
        // the new slot reads 8-byte elements — the i64 sibling of the f64[] case
        // above). #3353.
        parser.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                return expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s) == "i64[]";
            }
            return false;
        },
        parser.ExprCall(c) => {
            // A call to an i64[]-returning free function OR method (i64arr_ret_fns,
            // methods keyed "<Type>.<method>").
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // Erased-generic `T[]` return mirroring argument i: an i64[]
                    // exactly when THAT argument is a (non-f64) 64-bit value.
                    var gi: i32 = strarr_ret_argref(s, cid.name);
                    if (gi >= 0 && gi < c.args.len()) { return !expr_is_f64(c.args[gi], s) && infer_expr_width(c.args[gi], s) == 64; }
                    return s.is_i64arr_ret_fn(cid.name);
                },
                parser.ExprFieldAccess(cfa) => {
                    // `a.with(...)` / `a.append(...)` preserve the receiver's element
                    // kind: an i64[] receiver yields a fresh i64[].
                    if (((cfa.field == "with" && c.args.len() == 2) || (cfa.field == "append" && c.args.len() == 1))
                        && expr_is_i64arr(cfa.obj, s)) { return true; }
                    var crty: string = expr_struct_type(cfa.obj, s);
                    if (crty == "") { return false; }
                    return s.is_i64arr_ret_fn(crty + "." + cfa.field);
                },
                _ => { return false; }
            }
            return false;
        },
        _ => { return false; }
    }
    return false;
}

// field_or_tuple_type_tag returns the canonical scalar type string of a
// struct-field or tuple-element access `obj.field` — the tuple element's
// annotated tag (`t.N`, N all-digits) or the struct field's declared type
// (`p.x`) — or "" when `obj` is neither a typed tuple nor a known struct. It is
// the shared leaf the four numeric-kind predicates (expr_is_f64/f32/u32/u64)
// test for membership, so their field arms resolve the type ONE way and can't
// drift apart (#5520). infer_expr_width's struct arm deliberately stays on
// struct_field_is_i64 (a width query, not a tag match), so it is not unified.
function field_or_tuple_type_tag(obj: parser.Expr, field: string, s: LowerState): string {
    if (util.is_all_digits(field)) {
        return expr_tuple_elem_tag(obj, util.digits_to_i32(field), s);
    }
    var oty: string = expr_struct_type(obj, s);
    if (oty == "") { return ""; }
    return decl_field_type(s.structs, oty, field);
}

// method_recv_prim_key builds the "<RecvType>.<method>" registry key for a
// method-call receiver `obj.field`, resolving the receiver's type from
// expr_struct_type and falling back to the primitive receiver type
// (expr_recv_prim_type) for a scalar VALUE receiver like `(3.5).m()`. Returns ""
// when neither resolves. Shared by the f64/u32/u64 method-return-kind arms so the
// receiver resolution can't drift across them (#5520). expr_is_str's method arm
// keeps its own copy — it has a `dyn Trait` fallthrough after this resolution.
function method_recv_prim_key(obj: parser.Expr, field: string, s: LowerState): string {
    var crty: string = expr_struct_type(obj, s);
    if (crty == "") { crty = expr_recv_prim_type(obj, s); }
    if (crty == "") { return ""; }
    return crty + "." + field;
}

// expr_is_f64 reports whether `e` evaluates to an f64 value — a float literal, an
// f64-tracked local/param, an arithmetic combination of f64 operands, or an
// f64-array element read `a[i]`. (A comparison is NOT f64 — it yields an i32
// bool — so only the arithmetic ops propagate float-ness here.)
pub function expr_is_f64(e: parser.Expr, s: LowerState): boolean {
    // A Cell[f64/float] get() is f64 (#5510).
    var cf64e: string = cell_get_elem(e, s);
    if (cf64e == "f64" || cf64e == "float") { return true; }
    // f32 is f64-SHAPED (stored 8-byte), so every f32 value is also f64 — made
    // explicit here (was implicit, and independently re-derived below). This is
    // the load-bearing invariant the f32/f64 split rests on; keeping it a single
    // delegation removes the risk of the two walks drifting (typed-IR migration,
    // #5520). Byte-identity guards that it was already true.
    if (expr_is_f32(e, s)) { return true; }
    match (e) {
        parser.ExprNumber(n) => { return n.is_float; },
        parser.ExprIdent(id) => {
            if (s.is_f64_slot(s.slot_of(id.name))) { return true; }
            // A bare `const` ident is a call to its zero-arg accessor, so it is
            // f64 exactly when that accessor returns f64 — the f64 sibling of
            // infer_expr_width's const case (#4801).
            return s.slot_of(id.name) < 0 && s.is_const_fn(id.name) && s.is_f64_ret_fn(id.name);
        },
        parser.ExprBinary(b) => {
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                return expr_is_f64(b.left, s) || expr_is_f64(b.right, s);
            }
            return false;
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") { return expr_is_f64(u.operand, s); }
            // `x as f64` evaluates to f64 (a float→int cast yields i32, so only
            // the to-float casts propagate float-ness).
            if (u.op == "as_f64" || u.op == "as_f32" || u.op == "as_float") { return true; }
            return false;
        },
        parser.ExprCall(c) => {
            // typed-IR (#5531): the annotate pass (checker.annotate_module) stamps
            // c.ty with the checker's inferred result type. When present it is
            // authoritative for the float question, retiring the is_f64_ret_fn /
            // f64-builtin re-derivation below for annotated calls. "" — an
            // unannotated call (the asm_ir_run harness / native cmd/fern never run
            // annotate, or the checker left this call's type unresolved) — falls
            // through to the structural walk, so behaviour is unchanged there.
            if (c.ty != "") { return c.ty == "f64"; }
            // An f64-valued if/match-EXPRESSION (the 0-arg IIFE the desugar emits)
            // — classify by its first branch's returned value, so `var f = if (…)
            // { 1.5 } else { 2.5 }` tracks f as an f64.
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return expr_is_f64(iife_first_return_expr(lam.body[0]), s);
                        }
                    },
                    _ => {}
                }
            }
            // A call to an f64-returning free function OR method is an f64 value.
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // The std/float single-instruction math builtins return f64.
                    if (f64_math_builtin_kind(cid.name) != "") { return true; }
                    // __pow_f64 is f64-returning too — it lowers as the fpow fbin
                    // (not an op_funary), so it isn't in f64_math_builtin_kind, but
                    // its result must still cast via f64_to_i32 (not an i32 mask).
                    if (cid.name == "__pow_f64") { return true; }
                    // f64_from_bits / f32_from_bits reinterpret an integer bit
                    // pattern back into an f64 value.
                    if (cid.name == "f64_from_bits" || cid.name == "f32_from_bits") { return true; }
                    if (s.is_f64_ret_fn(cid.name)) { return true; }
                    // An erased-generic fn whose return mirrors argument i
                    // (`id[T](x: T): T`, the "name|$arg<i>" registry entry — kind-
                    // agnostic, recorded in str_ret_fns): the call is f64 exactly
                    // when THAT argument is. Mirrors infer_expr_width's width use of
                    // the same registry, so `id(2.5) + 0.5` lowers as float add
                    // instead of an integer op on the double's bits.
                    var gfi: i32 = str_ret_argref(s, cid.name);
                    if (gfi >= 0 && gfi < c.args.len() && expr_is_f64(c.args[gfi], s)) { return true; }
                    return false;
                },
                parser.ExprFieldAccess(cfa) => {
                    // `m.get_or(k, d)` on an f64-VALUED map (Map[K, f64]) is an
                    // f64 value — the column stores 8-byte doubles and get_or
                    // returns them bit-intact — so a chained `* 2.0` lowers as a
                    // float op instead of an integer op on the double's bits
                    // (#5253, the f64 sibling of expr_is_u64's get_or arm).
                    if (cfa.field == "get_or" && c.args.len() == 2
                        && map_value_of(get_or_recv_map_type(cfa.obj, s)) == "f64") { return true; }
                    // A scalar VALUE receiver (`(3.5).m()`) resolves via
                    // expr_recv_prim_type, so an f64-returning method `<f64>.m` is
                    // recognised — else `a.m() as i32` masked the double's low 32
                    // bits instead of truncating via f64_to_i32.
                    var fk: string = method_recv_prim_key(cfa.obj, cfa.field, s);
                    return fk != "" && s.is_f64_ret_fn(fk);
                },
                _ => { return false; }
            }
        },
        parser.ExprFieldAccess(fa) => {
            // An f64-typed struct field read `p.x`, or an f64 tuple element.
            var ft: string = field_or_tuple_type_tag(fa.obj, fa.field, s);
            return ft == "f64" || ft == "f32" || ft == "float";
        },
        parser.ExprIndex(ix) => { return arr_index_is_f64(ix.array, s); },
        _ => { return false; }
    }
    return false;
}

// expr_is_f32 reports whether `e` evaluates to an f32 value (STRICTLY — false
// for a genuine f64). f32 is stored as an 8-byte f64, so expr_is_f64 also
// returns true for it; this strict view drives "f32.<method>" dispatch
// (expr_recv_prim_type) which must NOT collide with f64 (their to_string /
// to_json differ by precision). Sources: an f32-tracked local/param/receiver,
// an `as f32` cast, f32 arithmetic, an f32 struct field / tuple element. A bare
// float literal is f64 by default (becomes f32 only via `as f32`). A method-
// CALL result is conservatively not classified f32 here (no f32-ret registry):
// such a chained receiver falls back to the f64-twin dispatch, which is
// behavior-identical for the value ops and only the (unused-in-practice)
// chained-`to_string` would differ.
pub function expr_is_f32(e: parser.Expr, s: LowerState): boolean {
    if (cell_get_elem(e, s) == "f32") { return true; }
    match (e) {
        parser.ExprIdent(id) => { return s.is_f32_slot(s.slot_of(id.name)); },
        parser.ExprBinary(b) => {
            if (b.op == "+" || b.op == "-" || b.op == "*" || b.op == "/") {
                return expr_is_f32(b.left, s) || expr_is_f32(b.right, s);
            }
            return false;
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") { return expr_is_f32(u.operand, s); }
            // Only `as f32` yields f32; `as f64` / `as float` are f64.
            if (u.op == "as_f32") { return true; }
            return false;
        },
        parser.ExprFieldAccess(fa) => {
            return field_or_tuple_type_tag(fa.obj, fa.field, s) == "f32";
        },
        // An erased-generic fn whose return mirrors argument i (`id[T](x: T): T`)
        // is f32 exactly when that argument is — the f32 sibling of expr_is_f64's
        // argref arm, so `id(x as f32) + y` keeps the f32-twin dispatch.
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    var gfi: i32 = str_ret_argref(s, cid.name);
                    if (gfi >= 0 && gfi < c.args.len() && expr_is_f32(c.args[gfi], s)) { return true; }
                    return false;
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_u32arr reports whether `e` is a u32[] array value — a u32[] ident slot
// (is_arr + is_u32), a u32-element literal, or a slice of either. The u32 sibling
// of expr_is_u64arr; drives element-index u32 tracking in expr_is_u32's ExprIndex
// arm. (u32-ness matters on wasm, whose i32 shr/div/rem select signed vs unsigned
// — an x86 64-bit register zero-extends, hiding the divergence.)
pub function expr_is_u32arr(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprArray(lit) => { return lit.elements.len() > 0 && expr_is_u32(lit.elements[0], s); },
        parser.ExprIdent(id) => { var sl: i32 = s.slot_of(id.name); return s.is_arr_slot(sl) && s.is_u32_slot(sl); },
        parser.ExprSlice(sl) => { return expr_is_u32arr(sl.array, s); },
        _ => { return false; }
    }
    return false;
}

// expr_is_u32 reports whether `e` evaluates to a u32 value — a u32-tracked
// local/param, a u32[] element read `a[i]`, a u32 struct field / tuple element,
// an `as u32` cast, or an arithmetic / bitwise / shift combination of u32
// operands (a comparison is a bool, not u32). It drives u32 WRAPPING (a u32
// arithmetic result is masked to 32 bits on the register backends) and unsigned
// op selection (a u32 `>>` / `/` / `%` / ordering-compare lowers to the logical
// / unsigned form). A u32-returning CALL is treated as u32 for SIGNEDNESS only
// (via the is_u32_ret_fn registry) — the callee already wraps its own u32 result
// internally so value WRAPPING stays off, but a clean u32 with bit 31 set still
// reads signed-negative in the i32 slot, so a chained `>>` / `/` / compare must
// select the unsigned form (#5245).
pub function expr_is_u32(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprIdent(id) => { return s.is_u32_slot(s.slot_of(id.name)); },
        parser.ExprIndex(ix) => {
            // a[i] on a u32[] is a u32 element. The array is an ident slot
            // marked u32 (a u32-array); a u32[] literal / slice element likewise —
            // so `[big, …][0] >> 1` / `a[lo:hi][0] >> 1` selects shr_u on wasm.
            match (ix.array) {
                parser.ExprIdent(aid) => { return s.is_u32_slot(s.slot_of(aid.name)); },
                parser.ExprArray(al) => { return al.elements.len() > 0 && expr_is_u32(al.elements[0], s); },
                parser.ExprSlice(sl2) => { return expr_is_u32arr(sl2.array, s); },
                _ => { return false; }
            }
        },
        // A u32 TUPLE element `t.N` or u32 STRUCT field `p.n`: the value is u32, so
        // a chained `>> 1` / `/ x` selects the unsigned form. The u32 sibling of
        // expr_is_u64's ExprFieldAccess arm — on wasm a signed shr/div on a
        // bit-31-set u32 field/element diverges (x86 zero-extension hides it).
        parser.ExprFieldAccess(fa) => {
            return field_or_tuple_type_tag(fa.obj, fa.field, s) == "u32";
        },
        parser.ExprUnary(u) => {
            if (u.op == "as_u32") { return true; }
            return false;
        },
        parser.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return false; }
            // A shift's result type follows the LEFT (shifted) operand; arithmetic
            // / bitwise is u32 if either side is.
            if (b.op == "<<" || b.op == ">>") { return expr_is_u32(b.left, s); }
            return expr_is_u32(b.left, s) || expr_is_u32(b.right, s);
        },
        // A u32-returning CALL directly chained in an unsigned-sensitive op
        // (`f(a) >> 1`, `p.get() / 7`, `q.w() > x`) is a u32 value: a clean u32 in
        // [0, 2^32) with bit 31 set still reads signed-negative in the i32 slot, so
        // wasm's shr_s / div_s / gt_s diverge from the unsigned answer. The u32
        // sibling of expr_is_u64's ExprCall arm — it consults the u32-return
        // registry (ret flag '3' in i64_ret_fns, is_u32_ret_fn). This tracks only
        // SIGNEDNESS; value WRAPPING is unchanged (the callee already masked its
        // result into [0, 2^32), so calls stay non-wrapping — #5245). Free
        // functions key by bare name; methods by "<BaseType>.<method>" (a dyn
        // receiver keys "dyn <Trait>.<method>", populated by
        // append_dyn_i64_ret_fns). Beyond the concrete free-fn / method cases,
        // this arm also covers an erased-GENERIC return that mirrors a u32
        // argument (`idg[T](x: T): T`) and a u32-valued if/match IIFE (#5245).
        parser.ExprCall(c) => {
            // typed-IR (#5531): trust the checker-stamped result type when present,
            // retiring the is_u32_ret_fn re-derivation for annotated calls. ""
            // (unannotated) falls through to the structural walk.
            if (c.ty != "") { return c.ty == "u32"; }
            // A u32-valued if/match-EXPRESSION (the 0-arg IIFE the desugar emits):
            // `(if (c) { big_u32 } else { 0 }) >> 1` selects the UNSIGNED shift.
            // Classify by its first branch's returned value — the u32 sibling of
            // expr_is_u64's IIFE arm.
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return expr_is_u32(iife_first_return_expr(lam.body[0]), s);
                        }
                    },
                    _ => {}
                }
            }
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (s.is_u32_ret_fn(cid.name)) { return true; }
                    // An erased-generic fn whose return mirrors argument i
                    // (`id[T](x: T): T`) is u32 exactly when that argument is —
                    // the same "name|$arg<i>" argref registry the u64 arm uses.
                    var gui: i32 = str_ret_argref(s, cid.name);
                    if (gui >= 0 && gui < c.args.len() && expr_is_u32(c.args[gui], s)) { return true; }
                    return false;
                },
                parser.ExprFieldAccess(cfa) => {
                    var uk: string = method_recv_prim_key(cfa.obj, cfa.field, s);
                    return uk != "" && s.is_u32_ret_fn(uk);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// expr_is_u64 mirrors expr_is_u32 for the i64 (64-bit) domain: a u64-tracked
// local/param, a u64[] element read, an `as u64` cast, or an arithmetic /
// bitwise / shift combination of u64 operands. It selects the UNSIGNED i64 ops
// (lt_u / shr_u / div_u / …) — there is no wrap step (i64 ops are full-width).
// expr_is_u64arr reports whether `e` is a u64[] ARRAY value — a u64[] ident slot
// (is_arr + is_u64), a u64-element array LITERAL, or a slice of either. Drives the
// element-index unsigned tracking in expr_is_u64's ExprIndex arm (the u64 sibling
// of expr_is_i64arr). A u64[][] inner element is tracked separately at the arrarr
// layer (arrarr_elem == "u64"), which expr_is_u64's nested-index arm checks (#5206).
pub function expr_is_u64arr(e: parser.Expr, s: LowerState): boolean {
    match (e) {
        parser.ExprArray(lit) => { return lit.elements.len() > 0 && expr_is_u64(lit.elements[0], s); },
        parser.ExprIdent(id) => { var sl: i32 = s.slot_of(id.name); return s.is_arr_slot(sl) && s.is_u64_slot(sl); },
        parser.ExprSlice(sl) => { return expr_is_u64arr(sl.array, s); },
        _ => { return false; }
    }
    return false;
}

pub function expr_is_u64(e: parser.Expr, s: LowerState): boolean {
    if (cell_get_elem(e, s) == "u64") { return true; }
    match (e) {
        parser.ExprIdent(id) => { return s.is_u64_slot(s.slot_of(id.name)); },
        parser.ExprIndex(ix) => {
            match (ix.array) {
                parser.ExprIdent(aid) => { return s.is_u64_slot(s.slot_of(aid.name)); },
                // Nested index of a u64[][] (`m[i][j]`): the inner array `m[i]`
                // names a u64[][] slot whose arrarr layer now records "u64", so a
                // chained `>> 1` / `> x` selects shr_u / gt_u. #5206.
                parser.ExprIndex(inner) => {
                    match (inner.array) {
                        parser.ExprIdent(aid2) => { return s.arrarr_elem_of_slot(s.slot_of(aid2.name)) == "u64"; },
                        _ => { return false; }
                    }
                    return false;
                },
                // Direct index of a u64[] LITERAL (`[big, …][i]`) or a u64[] SLICE
                // (`a[lo:hi][i]`): the element is u64, so a chained `>> 1` / `> x`
                // selects shr_u / gt_u. Mirrors arr_index_is_i64's width arms.
                parser.ExprArray(al) => { return al.elements.len() > 0 && expr_is_u64(al.elements[0], s); },
                parser.ExprSlice(sl2) => { return expr_is_u64arr(sl2.array, s); },
                _ => { return false; }
            }
        },
        parser.ExprFieldAccess(fa) => {
            // A u64 tuple element `t.N` (tag from the tuple's annotated `(u64, …)`
            // type) or a u64 STRUCT field read `p.n` (the field carries u64 in the
            // decl) is a u64 value, so a chained `>> 1` / `> x` selects shr_u / gt_u.
            // The 64-bit WIDTH is already tracked by infer_expr_width; this recovers
            // the unsigned-ness.
            return field_or_tuple_type_tag(fa.obj, fa.field, s) == "u64";
        },
        parser.ExprUnary(u) => {
            if (u.op == "as_u64") { return true; }
            return false;
        },
        parser.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return false; }
            if (b.op == "<<" || b.op == ">>") { return expr_is_u64(b.left, s); }
            return expr_is_u64(b.left, s) || expr_is_u64(b.right, s);
        },
        // An erased-generic fn whose return mirrors argument i (`id[T](x: T): T`)
        // is u64 exactly when that argument is. infer_expr_width already tracks
        // its 64-bit WIDTH via the same "name|$arg<i>" registry, so the result
        // routes through lower_i64; this recovers its UNSIGNED-ness so a shift /
        // compare on it selects shr_u / lt_u — without it `id(big_u64) >> 1`
        // used a signed (arithmetic) shift and diverged once bit 63 was set.
        parser.ExprCall(c) => {
            // typed-IR (#5531): trust the checker-stamped result type when present,
            // retiring the is_u64_ret_fn re-derivation for annotated calls. ""
            // (unannotated) falls through to the structural walk.
            if (c.ty != "") { return c.ty == "u64"; }
            // A u64-valued if/match-EXPRESSION (the 0-arg IIFE the desugar emits)
            // is a u64 value, so `(if (c) { big_u64 } else { 0 }) >> 1` selects the
            // UNSIGNED shift — the u64 sibling of expr_is_f64's IIFE arm and of
            // infer_expr_width's iife_any_return_i64 width check (which already
            // routes the result through lower_i64). Classify by its first branch's
            // returned value, matching expr_is_f64.
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return expr_is_u64(iife_first_return_expr(lam.body[0]), s);
                        }
                    },
                    _ => {}
                }
            }
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // A concrete u64-returning free function (`f(a) >> 1`): its
                    // result is unsigned, so the chained op selects shr_u / lt_u.
                    if (s.is_u64_ret_fn(cid.name)) { return true; }
                    var gui: i32 = str_ret_argref(s, cid.name);
                    if (gui >= 0 && gui < c.args.len() && expr_is_u64(c.args[gui], s)) { return true; }
                    return false;
                },
                // A u64-returning METHOD call `recv.m()` chained in an unsigned op
                // (`p.big() >> 1`) — the u64 sibling of expr_is_f64's method arm.
                // Methods are keyed "<BaseType>.<method>" in i64_ret_fns, so
                // resolve the receiver's struct / primitive type and look up the
                // qualified key; the '2' return flag marks it u64 (is_u64_ret_fn).
                parser.ExprFieldAccess(cfa) => {
                    // `m.get_or(k, d)` on a u64-VALUED map is an unsigned 64-bit
                    // value, so a chained `m.get_or(...) >> 1` selects shr_u (#5253).
                    if (cfa.field == "get_or" && c.args.len() == 2 && map_value_of(get_or_recv_map_type(cfa.obj, s)) == "u64") { return true; }
                    // `it.value()` on a MapIter[K, u64] is likewise unsigned (#5253).
                    if (cfa.field == "value" && c.args.len() == 0) {
                        match (cfa.obj) {
                            parser.ExprIdent(uvid) => {
                                if (mapiter_value_of(s.map_type_of(s.slot_of(uvid.name))) == "u64") { return true; }
                            },
                            _ => {}
                        }
                    }
                    var u64k: string = method_recv_prim_key(cfa.obj, cfa.field, s);
                    return u64k != "" && s.is_u64_ret_fn(u64k);
                },
                _ => { return false; }
            }
        },
        _ => { return false; }
    }
    return false;
}

// expr_subword_kind returns the sub-32-bit integer kind ("u8")
// an expression evaluates to, or "". It mirrors expr_is_u32 for the
// sub-word domain: a sub-word-tracked local/param, a sub-word array element
// read, an `as u8` cast, or an arithmetic/bitwise/
// shift combination of sub-word operands (a shift follows the LEFT operand;
// other binaries take whichever side is sub-word). Comparisons yield a plain
// i32 bool. Drives the post-arithmetic width wrap in the binary lowering.
pub function expr_subword_kind(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprIdent(id) => { return s.subword_kind_of_slot(s.slot_of(id.name)); },
        parser.ExprIndex(ix) => {
            match (ix.array) {
                parser.ExprIdent(aid) => { return s.subword_kind_of_slot(s.slot_of(aid.name)); },
                _ => { return ""; }
            }
        },
        parser.ExprUnary(u) => {
            if (u.op == "as_u8") { return "u8"; }
            return "";
        },
        parser.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return ""; }
            if (b.op == "<<" || b.op == ">>") { return expr_subword_kind(b.left, s); }
            var lk: string = expr_subword_kind(b.left, s);
            if (lk != "") { return lk; }
            return expr_subword_kind(b.right, s);
        },
        _ => { return ""; }
    }
    return "";
}

// is_eager_safe reports whether evaluating `e` is observably free of side
// effects AND cannot trap, so eagerly evaluating it (as the RHS of a
// short-circuit && / ||) is indistinguishable from skipping it. Excludes calls
// (side effects), indexing / slicing (bounds traps), division / remainder
// (the x86/arm div traps on /0), and — conservatively — every composite form.
// Operands are checker-guaranteed boolean, so `&` / `|` of the two 0/1 values
// equals `&&` / `||` once both are evaluated.
pub function is_eager_safe(e: parser.Expr): boolean {
    match (e) {
        parser.ExprNumber(_) => { return true; },
        parser.ExprBool(_) => { return true; },
        parser.ExprString(_) => { return true; },
        parser.ExprIdent(_) => { return true; },
        parser.ExprUnary(u) => { return is_eager_safe(u.operand); },
        parser.ExprBinary(b) => {
            if (b.op == "/" || b.op == "%") { return false; }
            return is_eager_safe(b.left) && is_eager_safe(b.right);
        },
        _ => { return false; }
    }
}

// infer_expr_width returns 64 if `e` evaluates to an i64 value, else 32.
// Comparisons / equality / logical-not yield an i32 bool regardless of operand
// width; arithmetic widens to i64 if either operand is i64. Bare literals are
// i32 here — they only become i64 from an i64 context (see lower_i64), which is
// what makes `var x: i64 = 5000000000` work without value-based parsing.
pub function infer_expr_width(e: parser.Expr, s: LowerState): i32 {
    // A Cell[i64/u64] get() is width 64 (#5510).
    var cwe: string = cell_get_elem(e, s);
    if (cwe == "i64" || cwe == "u64") { return 64; }
    match (e) {
        parser.ExprNumber(num) => {
            // A bare integer literal whose value exceeds i32-max is unambiguously
            // an i64 value (the checker forbids it in any i32 context, E047), so
            // width inference must report 64. Smaller literals stay i32 and only
            // become i64 from an i64 context (see lower_i64) — but a too-big one
            // has no valid i32 reading, so classifying it by value is sound. Without
            // this an i64[] LITERAL element (`[5000000000]`, incl. the inner array of
            // an i64[][]) skipped the arr_make_i64 path and emitted `i32.const`
            // with an out-of-range constant on the wasm backend (module won't parse).
            if (!num.is_float && literal_is_i64(num.text)) { return 64; }
            return 32;
        },
        parser.ExprIdent(id) => {
            if (s.is_i64_slot(s.slot_of(id.name))) { return 64; }
            // A bare ident naming a `const` is a CALL to its zero-arg accessor
            // (the ExprIdent lowering rule emits op_call_direct for it), so its
            // width is the accessor's RETURN width — the same is_i64_ret_fn
            // query the ExprCall arm below makes. Without this a `const B: i64`
            // read as `B + 1` inferred 32, so the lowering emitted i32.add over
            // a value the accessor returns as i64 and wasmtime rejected the
            // module with "type mismatch: expected i32, found i64" (#4801).
            if (s.slot_of(id.name) < 0 && s.is_const_fn(id.name) && s.is_i64_ret_fn(id.name)) { return 64; }
            return 32;
        },
        parser.ExprBinary(b) => {
            if (b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=") { return 32; }
            if (infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64) { return 64; }
            return 32;
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") { return infer_expr_width(u.operand, s); }
            if (u.op == "as_i64" || u.op == "as_u64") { return 64; }
            // `inner?` is i64-width when the Option/Result payload is i64/u64, so an
            // unannotated `var x = inner?` width-tracks i64 (StmtVar routes width-64
            // inits through lower_i64, where try_ now lowers).
            if (u.op == "try_") {
                var ot: string = try_opt_type(u.operand, s);
                var pt: string = opt_payload_type(ot, "Ok");
                if (pt == "i64" || pt == "u64") { return 64; }
                return 32;
            }
            return 32;
        },
        parser.ExprCall(c) => {
            // typed-IR (#5531): a checker-typed i64/u64 call is a 64-bit value, so
            // it routes through lower_i64 (is_i64_ret_fn accepts both '1'/i64 and
            // '2'/u64). Positive fast-path ONLY — a non-64 or unresolved ("") tag
            // falls through to the structural walk below, which still handles the
            // i64-returning builtins (clock / __load_i64 / f64_bits), argref
            // generics and i64/u64-map get_or the checker may not model.
            if (c.ty == "i64" || c.ty == "u64") { return 64; }
            // An i64-width if/match-EXPRESSION (the 0-arg IIFE the desugar emits)
            // is an i64 value, so an unannotated `var x = if (c) { 5000000000 }
            // else { 1 }` width-tracks i64. (iife_any_return_i64 inspects every
            // branch — see lower_iife.)
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        if (lam.params.len() == 0 && lam.body.len() == 1 && iife_any_return_i64(lam.body[0], s)) { return 64; }
                    },
                    _ => {}
                }
            }
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // The clock builtins return an i64 timespec reading, so a
                    // binding `var a = monotonic_ns()` width-tracks i64.
                    if (cid.name == "monotonic_ns" || cid.name == "now_unix_ms" || cid.name == "now_ns") { return 64; }
                    if (cid.name == "__load_i64") { return 64; }
                    // f64_bits reinterprets an f64 as its i64 bit pattern.
                    if (cid.name == "f64_bits") { return 64; }
                    if (s.is_i64_ret_fn(cid.name)) { return 64; }
                    // An erased-generic fn whose return mirrors argument i
                    // ("name|$arg<i>" from str_ret_fns_of — kind-agnostic): the
                    // call is 64-bit exactly when THAT argument is a (non-f64)
                    // 64-bit value (`ident[i64](big)`).
                    var gwi: i32 = str_ret_argref(s, cid.name);
                    if (gwi >= 0 && gwi < c.args.len()
                        && !expr_is_f64(c.args[gwi], s) && infer_expr_width(c.args[gwi], s) == 64) { return 64; }
                },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = method_recv_tyname(cfa.obj, s);
                    if (crty != "" && s.is_i64_ret_fn(crty + "." + cfa.field)) { return 64; }
                    // `m.get_or(k, d)` on an i64/u64-valued map is a 64-bit value —
                    // the map stores its values 8-byte and the get returns full
                    // width, so an unannotated `var g = m.get_or(...)` (and any
                    // chained arithmetic) must width-track i64 (#5253).
                    if (cfa.field == "get_or" && c.args.len() == 2) {
                        var gvt: string = map_value_of(get_or_recv_map_type(cfa.obj, s));
                        if (gvt == "i64" || gvt == "u64") { return 64; }
                    }
                    // `it.value()` on a MapIter[K, i64/u64] is a 64-bit value (the
                    // iterator's value snapshot is an i64[]), so an unannotated
                    // `var v = it.value()` and any chained arithmetic width-track
                    // i64 — the mapiter sibling of the get_or rule above. #5253.
                    if (cfa.field == "value" && c.args.len() == 0) {
                        match (cfa.obj) {
                            parser.ExprIdent(wvid) => {
                                var wvt: string = mapiter_value_of(s.map_type_of(s.slot_of(wvid.name)));
                                if (wvt == "i64" || wvt == "u64") { return 64; }
                            },
                            _ => {}
                        }
                    }
                },
                _ => {}
            }
            return 32;
        },
        parser.ExprIndex(ix) => {
            // a[i] on an i64[] is an i64 value (so it routes through lower_i64).
            if (arr_index_is_i64(ix.array, s)) { return 64; }
            return 32;
        },
        parser.ExprFieldAccess(fa) => {
            // An i64/u64 tuple element `t.N` or i64 struct field `p.x` is 64-bit.
            if (util.is_all_digits(fa.field)) {
                var tew: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                if (tew == "i64" || tew == "u64") { return 64; }
                return 32;
            }
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty != "" && struct_field_is_i64(s.structs, oty, s.field_index_in(oty, fa.field))) { return 64; }
            return 32;
        },
        _ => { return 32; }
    }
}

// method_recv_tyname returns the base type name to use when forming a
// "<Type>.<method>" key for a method-call receiver. A struct/enum receiver
// uses its declared type; an i64/u64 PRIM receiver (e.g. `n.gcd(m)` on a
// `(n: i64) gcd` method) has no struct type, so recover "u64"/"i64" from its
// value width — i64_ret_fns_of keys those methods as "i64.<m>"/"u64.<m>"
// (base_type_name of the receiver type), and without this the lookup misses
// and the call bails to the AST path.
pub function method_recv_tyname(obj: parser.Expr, s: LowerState): string {
    var st: string = expr_struct_type(obj, s);
    if (st != "") { return st; }
    if (expr_is_u64(obj, s)) { return "u64"; }
    if (infer_expr_width(obj, s) == 64) { return "i64"; }
    return "";
}

// lower_i64 lowers `e` as an i64 VALUE (pushing an i64). Integer literals become
// const_i64 (carrying source text), i64 locals load directly, and unary `-` /
// the non-comparison arithmetic + bitwise ops recurse on i64 operands. Anything
// that isn't a pure-i64 value here — an i32 variable (mixed width), a call, a
// comparison, i64 division/remainder — fails, bailing the module to the AST path
// where full i64 already works.
pub function lower_i64(e: parser.Expr, s: LowerState): LowerState {
    // c.get() on a Cell[i64/u64] -> c[0], lowered as an 8-byte i64 load (#5510).
    // Without this, c.get() in an i64 context (e.g. `c.get() + 1i64`) reaches
    // lower_i64 as a bare call it cannot lower, truncating the function.
    var i64ce: string = cell_get_elem(e, s);
    if (i64ce == "i64" || i64ce == "u64") {
        match (e) {
            parser.ExprCall(i64cc) => {
                match (i64cc.callee) {
                    parser.ExprFieldAccess(i64cfa) => {
                        var i64cz: parser.Expr = parser.ExprNumber { text: "0", suffix: "", is_float: false, line: 0, col: 0 };
                        return lower_i64(parser.ExprIndex { array: i64cfa.obj, index: i64cz, unchecked: true }, s);
                    },
                    _ => {}
                }
            },
            _ => {}
        }
    }
    match (e) {
        parser.ExprNumber(n) => {
            if (n.is_float) { return s.fail(); }
            return s.emit(ir.op_const_i64_text(n.text));
        },
        parser.ExprIdent(id) => {
            var sl: i32 = s.slot_of(id.name);
            if (sl >= 0 && s.is_i64_slot(sl)) { return s.emit(ir.op_load_local(sl)); }
            // An i32-width scalar leaf consumed in an i64 context — `s64 + i`, a
            // mixed-width param/local, or a for-range loop var accumulated into an
            // i64 — widens to i64 instead of bailing the module to the AST path.
            // lower_expr pushes the i32 value; op_int_extend widens it (zero-extend
            // for u32, sign-extend for a signed i32 / subword). Because the
            // ExprBinary arm recurses through lower_i64, this also lifts the i32
            // leaves of nested sub-expressions (`s64 + (i + 1)`) for free.
            if (sl >= 0 && s.is_i32_scalar_slot(sl)) {
                var iw: LowerState = lower_expr(e, s);
                if (!iw.ok) { return iw; }
                return iw.emit(ir.op_int_extend(s.is_u32_slot(sl)));
            }
            return s.fail();
        },
        parser.ExprUnary(u) => {
            if (u.op == "-") {
                var sz: LowerState = s.emit(ir.op_const_i64_text("0"));
                var sx: LowerState = lower_i64(u.operand, sz);
                if (!sx.ok) { return sx; }
                return sx.emit(ir.op_bin("sub", 64, false));
            }
            // `n as i64` / `n as u64`. Three operand cases:
            //  - an f64 operand: truncate toward zero to i64 (f64_to_i64);
            //    op_int_extend would mis-extend the f64's bit pattern as i32.
            //  - a non-float numeric LITERAL: already a 64-bit value, so emit an
            //    i64 const directly — lowering via the 32-bit lower_expr would
            //    make it an `i32.const`, truncating (and invalid on wasm for a
            //    literal above the i32 range). #2928.
            //  - otherwise: widen the i32 operand to i64.
            if (u.op == "as_i64" || u.op == "as_u64") {
                if (expr_is_f64(u.operand, s)) {
                    var fw: LowerState = lower_expr(u.operand, s);
                    if (!fw.ok) { return fw; }
                    // `f64 as u64` truncates UNSIGNED (#4332): the signed
                    // f64_to_i64 clamps at INT64_MAX, so 1e19 as u64 read as
                    // 9223372036854775807 instead of 10^19.
                    if (u.op == "as_u64") { return fw.emit(ir.op_f64_to_u64()); }
                    return fw.emit(ir.op_f64_to_i64());
                }
                match (u.operand) {
                    parser.ExprNumber(n) => { if (!n.is_float) { return s.emit(ir.op_const_i64_text(n.text)); } },
                    _ => {}
                }
                // A 64-bit operand (an i64/u64 var, an i64 arithmetic expr, …) is
                // already full-width: `i64 as u64` / `u64 as i64` is a pure
                // reinterpret (same bit pattern), so lower it via the 64-bit path
                // and DON'T op_int_extend — extending would first truncate to 32
                // bits via lower_expr (the 32-bit path) and then re-widen, losing
                // the high half. Only a genuinely 32-bit operand needs widening.
                if (infer_expr_width(u.operand, s) == 64) {
                    return lower_i64(u.operand, s);
                }
                var sw: LowerState = lower_expr(u.operand, s);
                if (!sw.ok) { return sw; }
                return sw.emit(ir.op_int_extend(u.op == "as_u64"));
            }
            // `inner?` with an i64/u64 payload: lower_try emits the width-64 payload
            // read, so the unwrapped value is a true i64 here (the `var x: i64 =
            // inner?` binding lands in lower_i64). lower_try bails for non-i64/u64
            // payloads, so this stays sound for the i64 domain.
            if (u.op == "try_") { return lower_try(u.operand, s); }
            return s.fail();
        },
        parser.ExprBinary(b) => {
            // Saturating arithmetic (#5542) carries its own width-aware
            // lowering (clamped, not wrapped) at every width. When its OPERANDS
            // are 32-bit-or-narrower it produces a 32-bit value, so an i64
            // context — e.g. `(p +| q) == 4294967295`, whose literal is an i64
            // and drags the whole compare to width 64 — has to widen it, the
            // same way the ExprIdent arm below widens a narrow local. Without
            // that the wasm module fails to validate (i32 where i64 expected).
            if (is_sat_op(b.op)) {
                var satw: LowerState = lower_sat_binary(b, e, s);
                if (!satw.ok) { return satw; }
                if (infer_expr_width(e, s) == 64) { return satw; }
                return satw.emit(ir.op_int_extend(expr_is_u32(e, s) || expr_subword_kind(e, s) != ""));
            }
            var kind: string = map_binop(b.op);
            if (kind == "") { return s.fail(); }
            // Comparisons aren't i64 values (they yield an i32 bool). i64
            // division/remainder ARE lowered (width 64): x86 drops the i32
            // movslq truncation, arm64's sdiv is already 64-bit, wasm calls the
            // $__fern_idiv64 / $__fern_irem64 non-trapping helpers.
            if (is_cmp_kind(kind)) { return s.fail(); }
            var l: LowerState = lower_i64(b.left, s);
            if (!l.ok) { return l; }
            var r: LowerState = lower_i64(b.right, l);
            if (!r.ok) { return r; }
            // u64 operands select the UNSIGNED i64 ops (>> / div / rem) — signed
            // are wrong once bit 63 is set (#2904). A shift's signedness follows
            // the left (shifted) operand; div/rem use either side. The other ops
            // (add/sub/mul/and/or/xor/shl) are sign-agnostic. (Compares already
            // bailed above — they yield an i32 bool, lowered in lower_expr.)
            var i64k: string = kind;
            if (b.op == ">>" || b.op == "<<") {
                if (expr_is_u64(b.left, s)) { i64k = to_unsigned_kind(kind); }
            } else if (expr_is_u64(b.left, s) || expr_is_u64(b.right, s)) {
                i64k = to_unsigned_kind(kind);
            }
            return r.emit(ir.op_bin(i64k, 64, false));
        },
        parser.ExprCall(c) => {
            // An i64-valued if/match-EXPRESSION (the 0-arg IIFE) — delegate to
            // lower_iife, which marks the inline temp i64 and widens each branch
            // value. Gated on i64-classifiability so a fully-small-literal i64
            // expression (i64-ness only from the annotation) stays on the AST path
            // instead of inlining into an i32 temp.
            if (c.args.len() == 0) {
                match (c.callee) {
                    parser.ExprLambda(lam) => {
                        // The 0-arg IIFE the if/match-EXPRESSION desugar emits, in an
                        // i64/u64 binding context: delegate with force_i64=true so the
                        // inline temp is i64 even when i64-ness comes ONLY from the
                        // annotation (`var x: i64 = if (c) { 5 } else { 9 }`, all small
                        // literals). lower_iife widens each branch value into the i64
                        // temp; a non-if/match body still fails through to s.fail().
                        if (lam.params.len() == 0 && lam.body.len() == 1) {
                            return lower_iife(c, lam, s, true);
                        }
                    },
                    _ => {}
                }
            }
            // A call to an i64-returning free function OR method IS an i64 value:
            // lower it via the normal call path (which pushes the result).
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // The clock builtins return an i64 value: lower via the
                    // normal call path (which emits the op + pushes the result).
                    if (cid.name == "monotonic_ns" || cid.name == "now_unix_ms" || cid.name == "now_ns") { return lower_expr(e, s); }
                    if (cid.name == "__load_i64") { return lower_expr(e, s); }
                    // f64_bits returns an i64 bit pattern: lower via the normal
                    // call path (lower_expr emits op_f64_bits + pushes the result).
                    if (cid.name == "f64_bits") { return lower_expr(e, s); }
                    if (s.is_i64_ret_fn(cid.name)) { return lower_expr(e, s); }
                    // An erased-generic call whose return mirrors a 64-bit
                    // argument IS an i64 value: the callee passes the 8-byte
                    // slot through untouched, so the normal call path (which
                    // pushes the full-width result) is the correct lowering —
                    // the width-32 sign-extend below would truncate it.
                    var gli: i32 = str_ret_argref(s, cid.name);
                    if (gli >= 0 && gli < c.args.len()
                        && !expr_is_f64(c.args[gli], s) && infer_expr_width(c.args[gli], s) == 64) { return lower_expr(e, s); }
                },
                parser.ExprFieldAccess(cfa) => {
                    var crty: string = method_recv_tyname(cfa.obj, s);
                    if (crty != "" && s.is_i64_ret_fn(crty + "." + cfa.field)) { return lower_expr(e, s); }
                    // `m.get_or(k, d)` on an i64/u64 map IS an i64 value: the get
                    // returns the 8-byte value full-width in the pushed word, so the
                    // normal call path is correct (the width-32 extend below would be
                    // a no-op-then-truncate). #5253.
                    if (cfa.field == "get_or" && c.args.len() == 2) {
                        var glvt: string = map_value_of(get_or_recv_map_type(cfa.obj, s));
                        if (glvt == "i64" || glvt == "u64") { return lower_expr(e, s); }
                    }
                },
                _ => {}
            }
            // An i32-returning call consumed in an i64 context (`s64 + g()`): lower
            // the i32 result (lower_expr, the normal call path) and sign-extend to
            // i64 instead of bailing the module to AST. The checker forbids i64 +
            // f64/string/u32 and rejects binding a bare i32 call to an i64 (it needs
            // an explicit `as i64`), so a call reaching this point in a valid program
            // — width 32, not i64-returning, not the 0-arg if/match IIFE handled
            // above — necessarily returns a signed i32. infer_expr_width gates the
            // widen; expr_is_u32 (false for calls) leaves it sign-extended.
            if (infer_expr_width(e, s) == 32) {
                var cw: LowerState = lower_expr(e, s);
                if (!cw.ok) { return cw; }
                return cw.emit(ir.op_int_extend(expr_is_u32(e, s)));
            }
            return s.fail();
        },
        parser.ExprFieldAccess(fa) => {
            // An i64 tuple element `t.N` is an 8-byte i64 value: lower the tuple
            // then tuple_get_w(..i64). An i64 struct field `p.x` likewise reads
            // via struct_get_i64. Non-i64 reads bail (their i32/f64 path lives in
            // lower_expr).
            if (util.is_all_digits(fa.field)) {
                var tn: i32 = util.digits_to_i32(fa.field);
                var tnt: string = expr_tuple_elem_tag(fa.obj, tn, s);
                if (tnt == "i64" || tnt == "u64") {
                    var ts: LowerState = lower_expr(fa.obj, s);
                    if (!ts.ok) { return ts; }
                    return ts.emit(ir.op_tuple_get_w(tn, 64, true));
                }
                // An i32 tuple element `t.N` consumed in an i64 context: read the
                // i32 element (lower_expr) and widen instead of bailing to AST.
                if (tnt == "i32" || tnt == "u32") {
                    var tw: LowerState = lower_expr(e, s);
                    if (!tw.ok) { return tw; }
                    return tw.emit(ir.op_int_extend(tnt == "u32"));
                }
                return s.fail();
            }
            var fty: string = expr_struct_type(fa.obj, s);
            if (fty == "") { return s.fail(); }
            var fidx: i32 = s.field_index_in(fty, fa.field);
            if (fidx < 0) { return s.fail(); }
            if (struct_field_is_i64(s.structs, fty, fidx)) {
                var fs: LowerState = lower_expr(fa.obj, s);
                if (!fs.ok) { return fs; }
                return fs.emit(ir.op_struct_get_i64(fidx));
            }
            // An i32 struct field `p.x` consumed in an i64 context (`s64 + p.x`):
            // read the i32 field (lower_expr) and sign/zero-extend to i64 instead
            // of bailing the module to AST. The checker forbids i64 + u32, so a
            // plain i32 field here is signed; the u32 flag stays defensive.
            var ffty: string = decl_field_type(s.structs, fty, fa.field);
            if (ffty == "i32" || ffty == "u32") {
                var fw: LowerState = lower_expr(e, s);
                if (!fw.ok) { return fw; }
                return fw.emit(ir.op_int_extend(ffty == "u32"));
            }
            return s.fail();
        },
        parser.ExprIndex(ix) => {
            // a[i] on an i64[] is an 8-byte i64 element: lower base + index (i32
            // values) then arr_get_i64 (i64.load on wasm).
            if (arr_index_is_i64(ix.array, s)) {
                var bs: LowerState = lower_expr(ix.array, s);
                if (!bs.ok) { return bs; }
                bs = lower_expr(ix.index, bs);
                if (!bs.ok) { return bs; }
                // #4380 lever 3: drop the bounds check on a proven-in-bounds read.
                if (ix.unchecked) { return bs.emit(ir.op_arr_get_i64_nc()); }
                return bs.emit(ir.op_arr_get_i64());
            }
            // An i32-element array indexed in an i64 context (`s64 + a[i]`, a
            // numeric reduction): lower the i32 element via lower_expr (arr_get)
            // and widen to i64 instead of bailing the module to AST. The checker
            // forbids i64 + u32, so a plain i32[] element here is signed;
            // expr_is_u32 still selects zero-extend for the defensive u32[] case.
            if (arr_index_is_i32_scalar(ix.array, s)) {
                var ws: LowerState = lower_expr(e, s);
                if (!ws.ok) { return ws; }
                return ws.emit(ir.op_int_extend(expr_is_u32(e, s)));
            }
            return s.fail();
        },
        _ => { return s.fail(); }
    }
}

// str_free_call_field maps a two-arg string builtin FREE-function name to the
// method `field` lower_str_method expects (`str_split`→`split`, etc.), or "" if
// the name isn't one. Lets the free-call and method-call forms share one lowerer.
pub function str_free_call_field(name: string): string {
    if (name == "str_split") { return "split"; }
    if (name == "str_starts_with") { return "starts_with"; }
    if (name == "str_ends_with") { return "ends_with"; }
    if (name == "str_index_of") { return "index_of"; }
    // The transform + remaining-predicate free-function spellings: the same
    // ops as the `.<field>()` method forms (lower_str_method), differing only
    // in that the receiver is the first positional arg. Arity is recovered via
    // str_method_argc(field) at the call site, so a 0-method-arg transform
    // (`str_to_upper(s)`), a 1-arg form (`str_repeat(s, n)`) and the 2-arg
    // `str_replace(s, old, new)` all route through one generalised lowerer.
    if (name == "str_to_upper") { return "to_ascii_upper"; }
    if (name == "str_to_lower") { return "to_ascii_lower"; }
    if (name == "str_trim") { return "trim"; }
    if (name == "str_repeat") { return "repeat"; }
    if (name == "str_replace") { return "replace"; }
    if (name == "str_contains") { return "contains"; }
    return "";
}

// is_str_builtin_method reports whether `field` names a string builtin method the
// IR path lowers directly: the 0-arg transforms `to_upper` / `to_lower` (→ fresh
// string), `split` (→ string[]), and the scalar predicates starts_with /
// ends_with / index_of / contains. The caller checks arity (str_method_argc) +
// that the receiver is a string before dispatching to lower_str_method.
pub function is_str_builtin_method(field: string): boolean {
    return field == "to_ascii_upper" || field == "to_ascii_lower" || field == "trim"
        || field == "reverse" || field == "repeat" || field == "replace"
        || field == "chars" || field == "lines"
        || field == "split"
        || field == "starts_with" || field == "ends_with" || field == "index_of"
        || field == "contains";
}

// str_method_argc gives the argument count of a string builtin method: the case
// transforms are 0-arg; everything else (split + predicates) is 1-arg.
pub function str_method_argc(field: string): i32 {
    if (field == "to_ascii_upper" || field == "to_ascii_lower" || field == "trim" || field == "reverse" || field == "chars" || field == "lines") { return 0; }
    if (field == "replace") { return 2; }
    return 1;
}

// lower_str_method lowers a string builtin method `recv.<field>(args…)`: it
// lowers the receiver, then (for the 1-arg forms) the argument, then emits the
// field's op. `to_upper` / `to_lower` → a fresh cased string; `split` → string[];
// the search predicates → scalar (`contains` is `index_of(...) >= 0`). Kept out
// of lower_expr's giant FieldAccess arm to stay under the self-host backend's
// oversized-function threshold (#2720).
pub function lower_str_method(field: string, recv: parser.Expr, args: parser.Expr[], s: LowerState): LowerState {
    var p: LowerState = lower_expr(recv, s);
    if (!p.ok) { return p; }
    if (field == "to_ascii_upper") { return p.emit(ir.op_str_to_upper()); }
    if (field == "to_ascii_lower") { return p.emit(ir.op_str_to_lower()); }
    if (field == "trim") { return p.emit(ir.op_str_trim()); }
    if (field == "reverse") { return p.emit(ir.op_str_reverse()); }
    if (field == "chars") { return p.emit(ir.op_str_chars()); }
    if (field == "lines") { return p.emit(ir.op_str_lines()); }
    p = lower_expr(args[0], p);
    if (!p.ok) { return p; }
    if (field == "replace") {
        p = lower_expr(args[1], p);
        if (!p.ok) { return p; }
        return p.emit(ir.op_str_replace());
    }
    if (field == "repeat") { return p.emit(ir.op_str_repeat()); }
    if (field == "split") { return p.emit(ir.op_str_split()); }
    if (field == "starts_with") { return p.emit(ir.op_str_starts_with()); }
    if (field == "ends_with") { return p.emit(ir.op_str_ends_with()); }
    if (field == "index_of") { return p.emit(ir.op_str_index_of()); }
    // contains: index_of(sub) >= 0
    p = p.emit(ir.op_str_index_of());
    p = p.emit(ir.op_const_i32(0));
    return p.emit(ir.op_bin("ge_s", 0, false));
}

// lower_arr_str_join lowers `xs.join(sep)` on a string[] receiver to a call of the
// __fern_arr_str_join runtime helper (asmcore.rt_src_arr_str_join — a real Fern
// function the AST emitters call the same way). It takes the __fn_ stack ABI
// (param0=xs on TOP, param1=sep below): xs is evaluated FIRST (receiver-before-arg,
// matching the AST path + native) but must be pushed LAST so it lands on top, so
// both operands spill to scratch locals and reload in ABI order. The helper is in
// is_fern_helper, so the call_direct routes through the emitters' runtime-helper
// arm, which marks the arr_str_join / str_concat / heap needs and cleans the two
// stack args. Result is a fresh owned string (expr_is_str recognises `.join`). #5328.
pub function lower_arr_str_join(recv: parser.Expr, sep: parser.Expr, s: LowerState): LowerState {
    var xtmp: string = "$jxs" + util.i32_to_string(s.locals.len());
    var p: LowerState = s.add_local(xtmp);
    var xslot: i32 = p.slot_of(xtmp);
    p = lower_expr(recv, p);
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(xslot));
    var stmp: string = "$jsep" + util.i32_to_string(p.locals.len());
    p = p.add_local(stmp);
    var sslot: i32 = p.slot_of(stmp);
    p = lower_expr(sep, p);
    if (!p.ok) { return p; }
    p = p.emit(ir.op_store_local(sslot));
    p = p.emit(ir.op_load_local(sslot));   // param1 = sep (pushed first, sits below)
    p = p.emit(ir.op_load_local(xslot));   // param0 = xs  (pushed last, on top)
    return p.emit(ir.op_call_direct("__fern_arr_str_join", 2));
}

// lower_opt_make_payload lowers `arg` (widening an i64 / f64 payload to its full
// 8 bytes) and emits the Option/Result box op for `tag` (0 = Some/Ok, 1 = Err).
// The box is [tag@0, payload@8], type-agnostic. Shared by the bare construction
// forms (`Ok(x)`) and the qualified ones (`Result.Ok(x)`).
function lower_opt_make_payload(tag: i32, arg: parser.Expr, s: LowerState): LowerState {
    var ptag: string = elem_type_tag(arg, s);
    var so: LowerState = s;
    if (ptag == "i64") { so = lower_i64(arg, so); } else { so = lower_expr(arg, so); }
    if (!so.ok) { return so; }
    // Perceus alias-inc for an ARRAY payload that aliases a local array: the
    // Option/Result box references the buffer, so retain it (rc_inc) so the exit
    // dec-sweep doesn't free the source local out from under the returned box.
    // Without it `Ok(names)` / `Some(items)` over-releases the array — a UAF that
    // only bites once a later allocation reuses the freed buffer (the match-arm
    // that extracts the payload already reclaims it at arm exit, so construction
    // must balance that with an inc). Mirrors the enum-variant construction's
    // alias-inc (#3720); only a bare ident on an array slot (a fresh-literal
    // payload isn't a local, so the sweep never frees it). The inc pops + re-pushes
    // the same pointer, leaving op_opt_make's operand on top. i64/f64 payloads
    // aren't array slots, so this never fires before the op_opt_make_w paths.
    match (arg) {
        parser.ExprIdent(paid) => {
            if (so.is_arr_slot(so.slot_of(paid.name))) {
                so = so.emit(ir.op_call_direct("__fern_rc_inc", 1));
            }
        },
        _ => {}
    }
    if (ptag == "i64") { return so.emit(ir.op_opt_make_w(tag, 64, true)); }
    if (ptag == "f64") { return so.emit(ir.op_opt_make_w(tag, 64, false)); }
    return so.emit(ir.op_opt_make(tag));
}

// lower_opt_make_payload_exp is the expected-type-aware variant: when the
// DECLARED payload type (`exp_tag`, recovered from the enclosing function's
// Option/Result return type or an annotated binding) is i64/u64 but the argument
// only infers i32 width (a bare literal `Ok(40)` or an i32 variable), the box must
// still use the 8-byte/offset-8 layout every consumer reads via
// op_opt_payload_w(64, true) — otherwise the construction stores a 4-byte payload
// at offset 4 that the match-arm / try-operator read misinterprets (a silent
// miscompile). An i64-spelled literal/cast/expr lowers via lower_i64; a plain i32
// value is widened with op_int_extend. exp_tag "" (or any non-i64/u64 tag) is
// byte-identical to lower_opt_make_payload.
function lower_opt_make_payload_exp(tag: i32, arg: parser.Expr, exp_tag: string, s: LowerState): LowerState {
    var ptag: string = elem_type_tag(arg, s);
    var want_i64: boolean = (exp_tag == "i64" || exp_tag == "u64") && ptag != "i64" && ptag != "f64";
    if (!want_i64) { return lower_opt_make_payload(tag, arg, s); }
    // lower_i64 handles a numeric literal (const_i64_text), an `as i64`/`as u64`
    // cast, an i64 slot, and i64 arithmetic; it bails (ok=false) on a bare i32
    // value, in which case re-lower from the ORIGINAL state and widen to 8 bytes.
    var a64: LowerState = lower_i64(arg, s);
    if (a64.ok) { return a64.emit(ir.op_opt_make_w(tag, 64, true)); }
    var aw: LowerState = lower_expr(arg, s);
    if (!aw.ok) { return aw; }
    aw = aw.emit(ir.op_int_extend(exp_tag == "u64"));
    return aw.emit(ir.op_opt_make_w(tag, 64, true));
}

// lower_subprocess_call lowers `subprocess(cmd, args, stdin)` — the three args
// (cmd / args / stdin, so the dispatch pops stdin from TOS) then op_subprocess,
// which pushes a fresh ProcessResult struct. Kept OUT of lower_expr's body: that
// function is so large that any added block carrying LowerState locals + recursive
// lower_expr calls inflates its arm64 codegen super-linearly (see the call site).
pub function lower_subprocess_call(c: parser.ExprCall, s: LowerState): LowerState {
    var sp: LowerState = lower_expr(c.args[0], s);
    if (!sp.ok) { return sp; }
    sp = lower_expr(c.args[1], sp);
    if (!sp.ok) { return sp; }
    sp = lower_expr(c.args[2], sp);
    if (!sp.ok) { return sp; }
    return sp.emit(ir.op_subprocess());
}

// lower_expr emits ops that leave the value of `e` on the operand stack.
pub function lower_expr(e: parser.Expr, s: LowerState): LowerState {
    if (!s.ok) { return s; }
    match (e) {
        parser.ExprNumber(n) => {
            // A float literal pushes its IEEE bit pattern (the backend assembles
            // the source text via `.double` / `f64.const`); an integer literal is
            // a 32-bit const.
            if (n.is_float) { return s.emit(ir.op_const_f64_text(n.text)); }
            // Splice the literal TEXT (handles hex `0x..` and the full u32 range,
            // like the AST path); a Fern-side decimal parse zeroes a hex literal
            // and can't represent values >= 0x80000000 as a signed i32.
            return s.emit(ir.op_const_i32_text(n.text));
        },
        parser.ExprBool(b) => {
            var v: i32 = 0;
            if (b.value) { v = 1; }
            return s.emit(ir.op_const_i32(v));
        },
        parser.ExprString(sv) => {
            // String literal → const_str (the backend interns the bytes and
            // builds its string box). Not reference-counted.
            return s.emit(ir.op_const_str(sv.value));
        },
        parser.ExprStructLit(slit) => {
            // Struct literal `P { a: .., b: .. }` and functional update
            // `P { ...base, b: v }` → struct_make. Only scalar-field (i32/boolean)
            // structs are lowered (leak-only). Every DECL field is produced in
            // decl order: an overridden field lowers its literal value; otherwise
            // (update only) it is copied from the base via struct_get. The base
            // may be an ident (re-read per copied field, side-effect-free) or any
            // struct-typed expression of the same type — a non-ident base is
            // evaluated once into a scratch local and re-loaded per copied field.
            if (!decl_is_struct(s.structs, slit.type_name)) { return s.fail(); }
            if (!decl_is_leaksafe(s.structs, slit.type_name)) { return s.fail(); }
            if (slit.has_base) {
                // The base may be an ident OR any struct-typed expression whose
                // type resolves (a struct-returning call `mk()`, a struct field
                // read `o.inner`, a struct-array element `arr[i]`). A non-ident
                // base is spilled into a scratch local once below so each copied
                // field re-reads the SAME evaluated value — never re-evaluating a
                // side-effecting base (e.g. a call) per field.
                if (expr_struct_type(slit.base, s) != slit.type_name) { return s.fail(); }
            }
            // base_is_ident: an ident base re-reads its own slot per copied field
            // (free, side-effect-free), so its lowering stays byte-identical — only
            // a non-ident base needs the scratch-local spill.
            var base_is_ident: boolean = false;
            if (slit.has_base) {
                match (slit.base) {
                    parser.ExprIdent(_) => { base_is_ident = true; },
                    _ => {}
                }
            }
            var ndecl: i32 = decl_field_count(s.structs, slit.type_name);
            // #4297 A2: per-struct-lit ownership precompute (COLD — once per lit) so
            // the hot per-field path below reads only scalars, never re-reading a
            // field-value expression (which would taint lower_expr's locals → the
            // documented emit runaway). slit_own[found] is the field's ownership;
            // slit_reclaim gates the string-field retain on the struct routing
            // through the field-reclaim/struct-drop path at all (rc-array /
            // nested-struct / enum field, or a STRFLDOK-admitted string-fielded
            // type — the same struct_routes_field_reclaim predicate the
            // consume-rebind AND the exit sweep's emit_struct_field_drops use,
            // so the k_str decs those emit stay balanced with this retain).
            var slit_own: i32[] = field_ownerships(slit, s);
            // #4355 slice 3: the retain widens in lockstep with the reclaim
            // routing — a STRFLDOK-admitted string-only struct now retains
            // its non-fresh string fields exactly like an array-carrying
            // one, balancing the __field_reclaim / __struct_drop k_str decs.
            var slit_reclaim: boolean = s.struct_routes_field_reclaim(slit.type_name);
            var sm: LowerState = s;
            // COMPACT functional-update lowering (#4650): when the struct's fields all
            // copy with no per-field rc-inc (struct_copy_eligible), the N unchanged
            // fields are copied by ONE op_struct_copy(base) instead of N inline
            // struct_get/store pairs per update site — the fresh box is stashed in a
            // result temp, each overridden field is written with op_struct_set, and the
            // temp is the result. This collapses the ~1.75x working-set blow-up the
            // per-field fan-out costs across the encoders' ~90 update sites. Only the
            // BASE COPY changes; each override still lowers through the identical
            // value/alias-inc path below.
            var compact: boolean = false;
            var result_slot: i32 = 0 - 1;
            // Spill a non-ident functional-update base into a scratch local once
            // (composed of existing store/load_local ops, so every backend +
            // eval_ops handle it for free — the same pattern as emit_arr_store).
            var base_tmp: i32 = 0 - 1;
            if (slit.has_base && struct_copy_eligible(s.structs, slit.type_name)) {
                compact = true;
                var rscratch: string = "$scp" + util.i32_to_string(sm.locals.len());
                sm = sm.add_local(rscratch);
                result_slot = sm.slot_of(rscratch);
                sm = lower_expr(slit.base, sm);
                if (!sm.ok) { return sm; }
                sm = sm.emit(ir.op_struct_copy(ndecl));
                sm = sm.emit(ir.op_store_local(result_slot));
            } else if (slit.has_base && !base_is_ident) {
                var bscratch: string = "$fub" + util.i32_to_string(sm.locals.len());
                sm = sm.add_local(bscratch);
                base_tmp = sm.slot_of(bscratch);
                sm = lower_expr(slit.base, sm);
                if (!sm.ok) { return sm; }
                sm = sm.emit(ir.op_store_local(base_tmp));
            }
            var di: i32 = 0;
            while (di < ndecl) {
                // find the literal field whose decl index is di (an override)
                var jj: i32 = 0;
                var found: i32 = 0 - 1;
                while (jj < slit.field_names.len()) {
                    if (s.field_index_in(slit.type_name, slit.field_names[jj]) == di) { found = jj; }
                    jj = jj + 1;
                }
                if (found >= 0) {
                    // A scalar-array field must be set from a FRESH array literal,
                    // OR from a bare ident naming an rc-tracked scalar-array local
                    // (the alias-into-construction case). A fresh literal is owned
                    // by the struct and never enters the local exit-sweep, so it
                    // leaks with the struct (no dangling). For an aliased local we
                    // emit a Perceus dup (rc_inc) below, so the struct's field owns
                    // a counted reference: the source local's slot is still swept
                    // (dec) at exit, and the struct's field is deep-dropped (dec) on
                    // the box's reclamation — the inc balances both decs (rc 1 →inc
                    // 2 →sweep(local) 1 →field-drop 0). Anything else (a call, an
                    // IIFE with a non-literal branch, an array-OF-struct/enum alias)
                    // could alias a swept local with no counted handle → bail.
                    var cfft: string = decl_field_type(s.structs, slit.type_name, slit.field_names[found]);
                    var fav_alias_inc: boolean = false;
                    if (is_leaksafe_array_field(cfft) || is_struct_array_field_type(s.structs, cfft)) {
                        // A fresh array LITERAL, or an if-/match-expression whose
                        // every branch returns a fresh array literal (#3175) — both
                        // are owned by the struct (no aliasing). A bare ident naming
                        // an array-tracked scalar-element local is admitted via the
                        // dup (alias-inc), but ONLY for the scalar-element field
                        // (is_leaksafe_array_field); array-of-struct / array-of-enum
                        // field aliasing (deep-drop recursion) is a later slice.
                        var fav: parser.Expr = slit.field_values[found];
                        var fav_ok: boolean = iife_returns_fresh_array(fav);
                        match (fav) {
                            parser.ExprArray(_) => { fav_ok = true; },
                            parser.ExprIdent(faid) => {
                                // A bare ident naming an rc-tracked array local/param,
                                // SCALAR-element (is_leaksafe_array_field), array-of-
                                // struct (is_struct_array_field_type), OR array-of-enum
                                // (is_enum_array_field_type): the field aliases the
                                // local's buffer, so retain it with a Perceus dup
                                // (alias-inc) — the dup is on the buffer POINTER, element-
                                // type-agnostic, exactly like the field-access arm below
                                // (`S { xs: s.xs }`) and the struct-array bind/return/
                                // assign positions. Enum-array fields take the IDENTICAL
                                // is_unique-gated deep-drop as struct-array fields
                                // (emit_struct_field_drops' k_box path), so the same
                                // alias-inc keeps the source's and the new box's field
                                // drops balanced — `DeferAcc { stmts: one }` over a
                                // `Stmt[]` local (parser.dl_collect_stmt).
                                if ((is_leaksafe_array_field(cfft) || is_struct_array_field_type(s.structs, cfft) || is_enum_array_field_type(s.structs, cfft))
                                    && s.is_arr_slot(s.slot_of(faid.name))) {
                                    fav_ok = true;
                                    fav_alias_inc = true;
                                }
                            },
                            // A BARE array-field COPY (`State { xs: s.xs }`, or
                            // array-of-struct `S { ops: s.ops }`): the field read
                            // lowers via struct_get (a real array pointer), aliasing
                            // the SOURCE struct's array — so the new box co-owns it.
                            // Retain it with the same Perceus dup (fav_alias_inc) as
                            // the ident case: rc 1 →inc 2 →source-struct field-drop 1
                            // →new-struct field-drop 0, both deep-drops balanced by
                            // the one inc (#3292 idiom, on a field-read source —
                            // RC-frontier slice 3). field_access_arr_field_type only
                            // admits a scalar-element OR array-of-struct field read
                            // (NOT enum-array), matching the outer struct-lit gate.
                            parser.ExprFieldAccess(_) => {
                                if (field_access_arr_field_type(fav, s) != "") {
                                    fav_ok = true;
                                    fav_alias_inc = true;
                                }
                            },
                            // The immutable-update idiom `State { xs: s.xs.with(i, v), … }`
                            // / `State { xs: s.xs.append(v), … }`. The `.with` / `.append`
                            // on a scalar-element array field read produces a FRESH,
                            // sole-owned array (lower_arr_with_value / _append_value clone
                            // the receiver — the base field is borrowed for the copy, NOT
                            // aliased into the result), so it is owned by the struct with
                            // NO alias-inc — exactly like the `[…]` literal case. Only the
                            // scalar-element field (is_leaksafe_array_field); array-of-
                            // struct / array-of-enum fields stay bailing (deep copy later).
                            parser.ExprCall(favc) => {
                                if (is_leaksafe_array_field(cfft)) {
                                    match (favc.callee) {
                                        parser.ExprFieldAccess(favfa) => {
                                            if ((favfa.field == "with" && favc.args.len() == 2)
                                                || (favfa.field == "append" && favc.args.len() == 1)) {
                                                if (scalar_arr_field_type(favfa.obj, s) != "") {
                                                    fav_ok = true;
                                                } else {
                                                    // A bare-ident scalar-array LOCAL / PARAM receiver
                                                    // (`DeferAcc { flags: flags.append(d.on_error) }`
                                                    // over an i32[] — parser.dl_collect_stmt). Like the
                                                    // field-read receiver above (and the `[…]` literal),
                                                    // lower_arr_with_value / _append_value clone the
                                                    // receiver into a FRESH sole-owned array, so the
                                                    // struct owns it with NO alias-inc (the receiver is
                                                    // borrowed for the copy, not aliased into the result).
                                                    // Inside is_leaksafe_array_field(cfft) the field — and
                                                    // hence this receiver, by the call's result type — is a
                                                    // scalar-element array, so is_arr_slot is the only gate.
                                                    match (favfa.obj) {
                                                        parser.ExprIdent(rid) => {
                                                            if (s.is_arr_slot(s.slot_of(rid.name))) { fav_ok = true; }
                                                        },
                                                        _ => {}
                                                    }
                                                }
                                            }
                                        },
                                        _ => {}
                                    }
                                    // A FRESH/owned scalar-array-returning CALL as the
                                    // field value — `S { data: s.bytes() }`, `S { xs:
                                    // gen() }`, `S { xs: arr.reverse() }`. expr_is_arr_src
                                    // (and the f64/i64 twins) classify exactly the
                                    // move sources: a string `.bytes()`/`.split()`, an
                                    // array-returning user fn (arr_ret_fns), __alloc_u8,
                                    // or an array-method result — each a fresh, sole-
                                    // owned buffer moved into the struct's field. Owned
                                    // by the struct with NO alias-inc, exactly like the
                                    // `[…]` literal: the callee moves the buffer out, so
                                    // nothing else holds a counted handle to dec. Mirrors
                                    // the unrestricted string[]-field-value path (string[]
                                    // skips this gate entirely). Bails (fav_ok stays
                                    // false) for any call the predicates don't recognise.
                                    if (!fav_ok) {
                                        if (cfft == "f64[]") {
                                            if (expr_is_f64arr(fav, s)) { fav_ok = true; }
                                        } else if (cfft == "i64[]") {
                                            if (expr_is_i64arr(fav, s)) { fav_ok = true; }
                                        } else if (expr_is_arr_src(fav, s)) {
                                            fav_ok = true;
                                        }
                                    }
                                } else if (is_struct_array_field_type(s.structs, cfft) || is_enum_array_field_type(s.structs, cfft)) {
                                    // A CALL returning an array-of-struct OR array-of-enum as
                                    // the field value (`Module { structs: inject_builtin_enums(
                                    // mono.structs) }`, or `DeferAcc { actions: actions.append(
                                    // d.action) }` over a `Stmt[]` — parser.dl_collect_stmt):
                                    // the call's result is an array VALUE on the operand stack,
                                    // stored straight into the field with NO alias-inc. Both
                                    // struct- and enum-array fields take the IDENTICAL is_unique-
                                    // gated deep-drop (emit_struct_field_drops' k_box walk), and
                                    // that gate is what makes the missing inc safe: a callee that
                                    // returned an ALIASED buffer leaves it rc>1 (e.g. arr_push's
                                    // in-place fast path bumps rc to 2, or a shared receiver took
                                    // the copy path), so is_unique is false and the walk is
                                    // skipped — it only leaks, never over-frees. A genuinely
                                    // fresh sole-owned result is rc==1 and reclaimed. (A SCALAR-
                                    // array field's drop is buffer-only, not is_unique-gated, so
                                    // it stays restricted to the fresh-guaranteed .with/.append +
                                    // expr_is_arr_src forms above.) Mirrors the array-literal case.
                                    fav_ok = true;
                                }
                            },
                            _ => {}
                        }
                        if (!fav_ok) { return s.fail(); }
                    }
                    // Array fields whose ELEMENT type skips the admission gate above
                    // (`string[]`, or an enum-array like `Ty[]` — neither
                    // is_leaksafe_array_field nor is_struct_array_field_type) still
                    // ALIAS a bare array-LOCAL/param ident's buffer when set from one,
                    // e.g. `EmitState { ...s, local_names: ln, local_types: lts }` over
                    // `var ln: string[] = []` / `var lts: Ty[] = []`. The scalar-array /
                    // struct-array gate already alias-incs its own bare idents; without
                    // the same retain here the local is BOTH stored into the field AND
                    // freed by the function-exit dec-sweep, double-freeing the buffer the
                    // (returned / escaping) struct now owns — the reset_locals
                    // use-after-free that broke the per-module self-build. Retain it with
                    // the same Perceus dup so the sweep dec is balanced (the struct keeps
                    // a counted reference; a borrowed-param source simply leaks, never
                    // over-frees). The inc is on the ARRAY buffer — a real rc-headered
                    // box (__fern_arr_box) — never a header-less string box, so it is
                    // sound (cf. the scalar-string-field warning below).
                    if (!fav_alias_inc && is_array_type_name(cfft)) {
                        match (slit.field_values[found]) {
                            parser.ExprIdent(aaid) => {
                                if (s.is_arr_slot(s.slot_of(aaid.name))) { fav_alias_inc = true; }
                            },
                            _ => {}
                        }
                    }
                    // A DIRECT nested-struct field (`inner: Inner`, decl_is_struct,
                    // not an array): now SHALLOW-dropped on the struct's reclamation
                    // (emit_ir_struct_drop_one's k_struct → arr_dec of the inner box,
                    // one level). To balance that dec, retain the field whenever its
                    // source could ALIAS a box another owner also drops. ONLY a fresh
                    // struct LITERAL `Inner { … }` is provably sole-owned (rc 1) and
                    // reclaimed with no inc; EVERY other source (a bare struct ident, a
                    // field copy `o.inner`, a struct-returning call) is inc'd —
                    // conservative and SOUND: a genuinely-fresh non-literal source then
                    // just LEAKS (rc never reaches 0), never double-frees. (Tightening
                    // the fresh set to fresh-returning calls is a follow-up.) The inc is
                    // on a real rc-headered struct box (never a header-less string), so
                    // it is sound — cf. the string-field skip below.
                    if (!fav_alias_inc && decl_is_struct(s.structs, cfft)) {
                        var nfv_fresh: boolean = false;
                        match (slit.field_values[found]) {
                            parser.ExprStructLit(_) => { nfv_fresh = true; },
                            // A CALL to a STRICT-fresh-struct-returning fn
                            // (`Outer { inner: mk_inner() }`): the callee handed back
                            // a fresh box that SOLE-owns every field buffer
                            // (return_fresh_struct_ret_fns), so the new struct owns it
                            // outright — NO alias-inc, and the deep-drop (is_unique-
                            // gated) reclaims the inner box AND its rc-array fields
                            // instead of leaking the rc-2 alias-inc'd box. recv_type is
                            // approximated by the field type cfft (== the call's return
                            // type); a method whose receiver type differs just misses
                            // the key (conservative, re-inc'd). Only the STRICT subset
                            // is admitted — the looser fresh_struct_ret_fns may alias
                            // inner element buffers, which the deep-drop would double-
                            // free (the slice-3 deep-drop follow-up).
                            parser.ExprCall(_) => {
                                if (is_fresh_ret_binding(slit.field_values[found], cfft, s.return_fresh_struct_ret_fns)) { nfv_fresh = true; }
                            },
                            _ => {}
                        }
                        if (!nfv_fresh) { fav_alias_inc = true; }
                    }
                    // A DIRECT enum field (`e: MyEnum`, decl_is_enum): now SHALLOW
                    // box-dropped on the struct's reclamation (the k_enum arm of
                    // __struct_drop → arr_dec of the enum box, one level). To balance
                    // that dec, retain UNLESS the value is a FRESH variant ctor
                    // (`V(args)` / bare `V`, variant_ctor_enum_owner != ""), which is
                    // sole-owned rc=1 and freed with no inc; every other source (a bare
                    // enum local/param, a field copy, an enum-returning call) is inc'd —
                    // conservative and SOUND: a genuinely-fresh non-ctor source then just
                    // LEAKS (rc never 0), never double-frees. Enum boxes are rc-headered
                    // (op_struct_make), so the inc is sound (unlike a header-less string).
                    if (!fav_alias_inc && decl_is_enum(s.structs, cfft)) {
                        if (variant_ctor_enum_owner(slit.field_values[found], s.structs).len() == 0) {
                            fav_alias_inc = true;
                        }
                    }
                    // A `string` field is rc-headered and deep-dropped on the
                    // struct's reclamation (emit_struct_field_drops). The values safe
                    // to FREE are exactly the fresh, sole-owned HEAP strings whose data
                    // buffer is exclusively owned — expr_is_fresh_str: a direct inline
                    // concat `a + b`, the case/shape transforms `.to_upper()` /
                    // `.to_lower()` / `.reverse()` / `.repeat(n)` (and their str_*
                    // free-fn spellings), and the alloc builtins `chr` /
                    // `string_from_bytes_unchecked` — each allocating a fresh buffer + rc=1 box
                    // used only for this field. Owned by the struct with no inc, so the
                    // field-drop reclaims it — the actual heap-leak win.
                    // EVERY other value is inc'd so the field-drop only decs the dup:
                    //   - a string LITERAL is static (.rodata, not heap rc=1) — it
                    //     must NOT be freed; the inc/dec round-trips its rc word
                    //     soundly (an rc_dec WITHOUT a matching inc over-releases it);
                    //   - a string local / param / field read may alias a live string
                    //     the IR path never sweeps;
                    //   - `.trim()` is a zero-copy VIEW into its receiver's buffer and
                    //     `.replace()` / `.to_string()` have receiver-identity fast-paths,
                    //     so each may alias a live box — retained conservatively.
                    // Each non-fresh case leaks (sound), never over-releases.
                    // String fields are NOT rc-tracked in the IR path: const_str
                    // allocates a header-less 16-byte box [data@0,len@8] (every IR
                    // backend leaks strings — "not RC'd"), so __fern_rc_inc on a
                    // string box would write [box-8] = the PREVIOUS heap block's word,
                    // corrupting it. (Found via the resolve_labels_module FuncDecl
                    // rebuild: a non-fresh `receiver_name` field-copy's rc_inc clobbered
                    // the adjacent funcs array's length, so parse_module returned the
                    // wrong function count / crashed.) Strings leak instead (sound);
                    // matched by the string skip in emit_struct_field_drops.
                    // #4297 A2: retain (rc_inc) a NON-fresh string field of a
                    // reclaimable struct so the k_str field-drop's rc-aware dec is
                    // balanced; a fresh (Owned) field is handed over with no inc and
                    // reclaimed by the drop. Ownership comes from the per-lit precompute
                    // (slit_own[found]) — a scalar read, so it does NOT re-taint
                    // lower_expr. (Owned=0; Borrowed/View/Static != 0 → retain: a real
                    // aliased box's dec is balanced, an immortal view/literal's inc is
                    // an rc-sentinel no-op.)
                    if (!fav_alias_inc && cfft == "string" && slit_reclaim
                            && found < slit_own.len() && slit_own[found] != 0) {
                        fav_alias_inc = true;
                    }
                    // COMPACT: load the copied result box UNDER the value so struct_set
                    // (pops [box, value]) can write this overridden field in place. The
                    // struct_copy above already seeded every field from the base; only
                    // the overrides are re-stored. struct_copy_eligible excludes i64/f64
                    // fields, so an override is always a 4-byte / pointer store.
                    if (compact) {
                        sm = sm.emit(ir.op_load_local(result_slot));
                    }
                    // An i64 field value is an 8-byte i64 (a bare integer literal
                    // isn't self-evidently i64), so lower it via lower_i64.
                    if (struct_field_is_i64(s.structs, slit.type_name, di)) {
                        sm = lower_i64(slit.field_values[found], sm);
                    } else if (fn_value_array_lit(slit.field_values[found], cfft, sm)) {
                        // A plain-fn-pointer array field value (`hs: [inc, dbl]`,
                        // or `[() => 7]` after the lift hoists it to `[__lam_0]`).
                        // The generic lower_expr would const-CALL each 0-arg fn
                        // ident (storing f()'s result), so `r.hs[i]()` would then
                        // call that integer as code and segfault. Emit a fn POINTER
                        // per element (op_const_func) + op_arr_make — the array
                        // sibling of the local `var fns: (() => T)[] = [f, g]` path,
                        // leaving exactly ONE array pointer on the stack (identical
                        // shape to lower_expr of a normal array). No alias-inc: a
                        // fresh literal is struct-owned at rc=1 (#5235).
                        match (slit.field_values[found]) {
                            parser.ExprArray(fva) => {
                                var fvi: i32 = 0;
                                while (fvi < fva.elements.len()) {
                                    sm = sm.emit(ir.op_const_func(0, fn_value_arg_name(fva.elements[fvi], sm)));
                                    fvi = fvi + 1;
                                }
                                sm = sm.emit(ir.op_arr_make(fva.elements.len(), 32));
                            },
                            _ => {}
                        }
                    } else {
                        sm = lower_expr(slit.field_values[found], sm);
                    }
                    if (!sm.ok) { return sm; }
                    // Perceus dup: the field value (an array pointer) is now on the
                    // operand stack and about to be stored into the struct box. When
                    // it ALIASES an rc-tracked local, retain it (rc_inc) so the
                    // struct owns a counted reference. The inc reads the pointer off
                    // the stack and pushes it back (the helper returns its arg), so
                    // the net stack effect is unchanged for struct_make — the same
                    // alias-inc idiom as emit_arr_store, without the cow/store wrap.
                    if (fav_alias_inc) {
                        sm = sm.emit(ir.op_call_direct("__fern_rc_inc", 1));
                    }
                    // COMPACT: [box, value] on the stack -> store the override in place.
                    if (compact) {
                        sm = sm.emit(ir.op_struct_set(di, struct_field_width(s.structs, slit.type_name, di)));
                    }
                } else if (slit.has_base && !compact) {
                    // copy decl field di from the base: base then struct_get(di).
                    // An ident base re-reads its slot; a non-ident base loads the
                    // scratch local it was spilled into. An i64 field copies 8
                    // bytes (struct_get_i64).
                    if (base_is_ident) {
                        sm = lower_expr(slit.base, sm);
                        if (!sm.ok) { return sm; }
                    } else {
                        sm = sm.emit(ir.op_load_local(base_tmp));
                    }
                    if (struct_field_is_i64(s.structs, slit.type_name, di)) { sm = sm.emit(ir.op_struct_get_i64(di)); }
                    else { sm = sm.emit(ir.op_struct_get(di, struct_field_width(s.structs, slit.type_name, di))); }
                    // A nested-struct field COPIED from the base (`Outer { ...base, … }`)
                    // ALIASES base.<field> — both the new struct and the base now point
                    // at the same inner box, and BOTH shallow-drop it on reclamation. So
                    // retain it (the inner box read by struct_get is on the stack) with
                    // the same Perceus dup as the field-override alias case, or the new
                    // struct's drop would double-free base's inner. Array fields copied
                    // from a base alias-inc via the array gates above (override path); a
                    // base-copied ARRAY field is left as-is here (its prior behaviour),
                    // only the newly-reclaimed nested-struct kind needs the retain.
                    var cpft: string = decl_field_type_at(s.structs, slit.type_name, di);
                    if (decl_is_struct(s.structs, cpft)) {
                        sm = sm.emit(ir.op_call_direct("__fern_rc_inc", 1));
                    }
                    // A DIRECT enum field COPIED from the base (`R { ...base, other: v }`,
                    // enum field un-overridden) ALIASES base.<enum> — both boxes point at
                    // the same enum box, and BOTH shallow-drop it. Retain it (#4297 A2) so
                    // the new struct's k_enum drop only decs the dup, exactly like the
                    // nested-struct copy above. No slit_reclaim gate: a struct with a direct
                    // enum field is always reclaimable (struct_has_reclaim_array_field), so
                    // the __struct_drop and this inc always pair.
                    if (decl_is_enum(s.structs, cpft)) {
                        sm = sm.emit(ir.op_call_direct("__fern_rc_inc", 1));
                    }
                    // A `string` field COPIED from the base (`R { ...base, other: v }`,
                    // `name` un-overridden) ALIASES base.name — both boxes now point at
                    // the same rc string, and the new struct's k_str field-drop would
                    // free it out from under the base. Retain it (#4297 A2) so the drop
                    // only decs the dup, exactly like the nested-struct copy above. Gated
                    // on slit_reclaim: an unreclaimable (string-only) struct emits no
                    // __struct_drop, so incing would only inflate the shared rc and leak —
                    // leave it as-is there (no drop, no over-release either way).
                    if (cpft == "string" && slit_reclaim) {
                        sm = sm.emit(ir.op_call_direct("__fern_rc_inc", 1));
                    }
                } else if (!slit.has_base) {
                    // a non-update literal must set every field
                    return s.fail();
                }
                // else (compact + un-overridden field): op_struct_copy already seeded
                // it from the base — nothing to emit.
                di = di + 1;
            }
            // COMPACT: the result box is the struct_copy'd temp, mutated in place by the
            // per-override struct_sets — push it. Otherwise build the box from the N
            // field values now on the operand stack.
            if (compact) {
                return sm.emit(ir.op_load_local(result_slot));
            }
            return sm.emit(ir.op_struct_make(slit.type_name, ndecl));
        },
        parser.ExprFieldAccess(fa) => {
            // Numeric field `t.0` / `t.1` → tuple element access (no shape slot,
            // element i at slot i). The receiver must be a tuple; a non-tuple
            // numeric access can't type-check, so this is unambiguous.
            if (util.is_all_digits(fa.field)) {
                var tgi: i32 = util.digits_to_i32(fa.field);
                var so0: LowerState = lower_expr(fa.obj, s);
                if (!so0.ok) { return so0; }
                // An 8-byte element (i64 / f64) reads with the matching load; an
                // i64 element in an i32 context is a checker error (the valid i64
                // read routes through lower_i64). i32 / string / struct elements
                // keep the 4-byte read.
                var tgt: string = expr_tuple_elem_tag(fa.obj, tgi, s);
                if (tgt == "i64" || tgt == "u64") { return so0.emit(ir.op_tuple_get_w(tgi, 64, true)); }
                if (tgt == "f64" || tgt == "f32" || tgt == "float") { return so0.emit(ir.op_tuple_get_w(tgi, 64, false)); }
                return so0.emit(ir.op_tuple_get(tgi));
            }
            // Qualified built-in `Option.None` (no call) — the same value as the
            // bare `None`: the canonical none box (op_opt_none). The native
            // compiler accepts both spellings; without this the qualified form
            // bailed the module to AST.
            match (fa.obj) {
                parser.ExprIdent(noid) => {
                    if (noid.name == "Option" && fa.field == "None" && s.slot_of(noid.name) < 0) {
                        return s.emit(ir.op_opt_none());
                    }
                },
                _ => {}
            }
            // Qualified UNIT-variant value `Enum.Variant` (no call) — the same
            // value as the bare unit variant `Variant`: a 0-field variant box via
            // struct_make. (The payload form `Enum.Variant(args)` is handled in
            // ExprCall.) `fa.field` must be a known variant whose enum_owner is the
            // bare type name in `fa.obj` (not a local), so this is unambiguous.
            var uvowner: string = variant_enum_owner(s.structs, fa.field);
            if (uvowner != "") {
                match (fa.obj) {
                    parser.ExprIdent(uvid) => {
                        if (uvid.name == uvowner && s.slot_of(uvid.name) < 0
                            && decl_field_count(s.structs, fa.field) == 0) {
                            return s.emit(ir.op_struct_make(fa.field, 0));
                        }
                    },
                    _ => {}
                }
            }
            // Bare struct field read `p.x` → struct_get at x's decl index. (As a
            // call receiver — `p.len()` — field access is handled in ExprCall; a
            // bare field access reaching here is a value.)
            var sty: string = expr_struct_type(fa.obj, s);
            if (sty == "") { return s.fail(); }
            var idx: i32 = s.field_index_in(sty, fa.field);
            if (idx < 0) { return s.fail(); }
            var so: LowerState = lower_expr(fa.obj, s);
            if (!so.ok) { return so; }
            // An i64 field reads an 8-byte integer (i64.load); f64 an 8-byte
            // float; i32 the 4-byte path. (An i64 field in an i32 context is a
            // checker error; a valid i64 read routes through lower_i64 below.)
            if (struct_field_is_i64(s.structs, sty, idx)) { return so.emit(ir.op_struct_get_i64(idx)); }
            return so.emit(ir.op_struct_get(idx, struct_field_width(s.structs, sty, idx)));
        },
        parser.ExprIdent(id) => {
            var slot: i32 = s.slot_of(id.name);
            if (slot >= 0) { return s.emit(ir.op_load_local(slot)); }
            // The empty Option `None` → a payloadless box with tag 1.
            if (id.name == "None") { return s.emit(ir.op_opt_none()); }
            // A bare struct name that isn't a local is a no-payload enum variant
            // value (e.g. `Red`, `Empty`): a 0-field variant box via struct_make.
            if (decl_is_struct(s.structs, id.name) && decl_field_count(s.structs, id.name) == 0) {
                return s.emit(ir.op_struct_make(id.name, 0));
            }
            // A bare identifier that is not a local naming a ZERO-ARG,
            // receiver-less function (a `const`, desugared to such a function) is
            // a CALL to it — its value. Mirrors asm.fern's ExprIdent rule
            // (zero-arg receiver-less -> call).
            if (s.is_const_fn(id.name)) { return s.emit(ir.op_call_direct(id.name, 0)); }
            // A bare ident naming a module function WITH params is a function
            // VALUE — a plain (capture-free) function pointer (`var f = dbl;
            // f(21)`, `return namedfn`). Emit const_func; const_funcs_only_known
            // bails the module if the name isn't a known function, so an
            // unknown / non-function ident (which the checker would already have
            // rejected) never miscompiles. Mirrors asm.fern's ExprIdent rule
            // (zero-arg receiver-less -> call; >0-arg -> boxed fn-value). A call
            // through the resulting fn-value local rides the existing
            // call_indirect path (the same one a "fn"-typed param uses).
            return s.emit(ir.op_const_func(0, id.name));
        },
        parser.ExprBinary(b) => {
            // Saturating arithmetic (#5542) is integer-only — no string concat,
            // no float form, no composite overload — so it precedes every other
            // dispatch and carries its own width-aware clamp lowering.
            if (is_sat_op(b.op)) { return lower_sat_binary(b, e, s); }
            // Checked arithmetic (#5542) yields `Option[T]` — integer-only,
            // no composite overload — so it too precedes every other dispatch.
            if (is_chk_op(b.op)) { return lower_checked_binary(b, e, s); }
            // Composite operator overload (#2706): `a <op> b` where the left
            // operand is a struct lowers to `a.<method>(b)` (`+`→add, …),
            // mirroring the native checker desugar. Rewriting to a method call
            // reuses the struct-returning-method path (#3640); if the type has
            // no such method, that path bails to the AST fallback rather than
            // mis-lowering the struct pointers as scalar arithmetic. Scalars /
            // strings / f64 return "" from expr_struct_type, so they're
            // untouched and fall through to the numeric/string dispatch below.
            if (binop_overload_method(b.op) != "") {
                var blt: string = expr_struct_type(b.left, s);
                // Only a real struct/enum operand is an overload — expr_struct_type
                // also reports a typed scalar's name (e.g. a `u8` local returns
                // "u8"), which must fall through to the normal numeric/sub-word
                // lowering below, NOT be treated as a composite (#2706 regression).
                if (decl_is_struct(s.structs, blt)) {
                    var ovm: string = binop_overload_method(b.op);
                    // Only a defined (struct-returning) overload method lowers.
                    // Without one this is an invalid program (native rejects it
                    // E009), so bail to the AST path rather than mis-lower the
                    // struct pointers as scalar arithmetic.
                    if (s.struct_ret_type(blt + "." + ovm) == "") { return s.fail(); }
                    var ovcall: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: b.left, field: ovm, line: b.line, col: b.col }, args: [b.right], line: b.line, col: b.col, type_argc: 0, ty: "" };
                    return lower_expr(ovcall, s);
                }
            }
            // Short-circuit `&&` / `||`. When the RIGHT operand is trap-free and
            // side-effect-free, eagerly evaluating it is unobservable, so the
            // logical op is just a bitwise `&` / `|` of the two boolean (0/1)
            // values — no value-producing `if` needed. The left operand is always
            // evaluated, so it may be anything lowerable. A right operand with a
            // call / index / division (where skipping it matters) bails to the AST
            // path, which does proper control-flow short-circuiting.
            if (b.op == "&&" || b.op == "||") {
                var scop: string = "and";
                if (b.op == "||") { scop = "or"; }
                // Fast path: a trap-free, side-effect-free RHS is just `&` / `|`
                // of the two boolean (0/1) values — no control flow needed.
                if (is_eager_safe(b.right)) {
                    var lsc: LowerState = lower_expr(b.left, s);
                    if (!lsc.ok) { return lsc; }
                    var rsc: LowerState = lower_expr(b.right, lsc);
                    if (!rsc.ok) { return rsc; }
                    return rsc.emit(ir.op_bin(scop, 0, false));
                }
                // Short-circuit: the RHS may call / index / divide (where NOT
                // evaluating it matters), so guard it behind the LHS via a temp
                // local + a block (the proven match-arm control shape):
                //   tmp = L
                //   block { load tmp; [&& only: not]; br_if 0; tmp = R }
                //   load tmp          // result = L ? R : L  (&&) / L ? L : R (||)
                // For `&&` we skip R when L is FALSE (load L, not, br_if); for
                // `||` we skip R when L is TRUE (load L, br_if). tmp then holds
                // L on the skip path (the short-circuit value) and R otherwise.
                var sl0: LowerState = lower_expr(b.left, s);
                if (!sl0.ok) { return sl0; }
                var scn: string = "$sc" + util.i32_to_string(sl0.locals.len());
                sl0 = sl0.add_local(scn);
                var scslot: i32 = sl0.slot_of(scn);
                sl0 = sl0.emit(ir.op_store_local(scslot));
                sl0 = sl0.emit(ir.op_block(0));
                sl0 = sl0.emit(ir.op_load_local(scslot));
                if (b.op == "&&") { sl0 = sl0.emit(ir.op_bin("not", 0, false)); }
                sl0 = sl0.emit(ir.op_brif(0));
                var sr0: LowerState = lower_expr(b.right, sl0);
                if (!sr0.ok) { return sr0; }
                sr0 = sr0.emit(ir.op_store_local(scslot));
                sr0 = sr0.emit(ir.op_end());
                return sr0.emit(ir.op_load_local(scslot));
            }
            // String dispatch: on string operands, `+` is concat and `==`/`!=`
            // are byte-equality (str_eq, then `not` for `!=`). Ordering compares
            // (`<` `>` `<=` `>=`) lower to str_cmp (signed -/0/+) followed by the
            // relational op against 0.
            if (expr_is_str(b.left, s) || expr_is_str(b.right, s)) {
                // `+` concat frees any fresh anonymous OPERAND temp right after the
                // concat reads it (`s + "x"` box, `a + b + c` intermediates) — see
                // emit_str_concat_reclaim; a non-fresh-operand concat takes its plain
                // fast path. `==` / `!=` keep the bare lower (operands are read, not
                // moved; the temp's own scope-exit / accumulator reclaim handles it).
                if (b.op == "+") { return emit_str_concat_reclaim(b, s); }
                if (b.op == "==" || b.op == "!=") {
                    var sl: LowerState = lower_expr(b.left, s);
                    if (!sl.ok) { return sl; }
                    var sr: LowerState = lower_expr(b.right, sl);
                    if (!sr.ok) { return sr; }
                    var se: LowerState = sr.emit(ir.op_str_eq());
                    if (b.op == "!=") { return se.emit(ir.op_bin("not", 0, false)); }
                    return se;
                }
                if (b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=") {
                    var cl: LowerState = lower_expr(b.left, s);
                    if (!cl.ok) { return cl; }
                    var cr: LowerState = lower_expr(b.right, cl);
                    if (!cr.ok) { return cr; }
                    // str_cmp(a,b) <rel> 0
                    var cc: LowerState = cr.emit(ir.op_str_cmp());
                    cc = cc.emit(ir.op_const_i32(0));
                    return cc.emit(ir.op_bin(map_binop(b.op), 0, false));
                }
                return s.fail();
            }
            // f64 dispatch: float operands lower as f64 (their bit pattern flows
            // on the rt-stack) and use the float ops. Arithmetic (+ - * /) yields
            // f64; a comparison yields an i32 bool. `%` / bitwise / shifts have no
            // float form (map_fbinop = "") and bail to the AST path.
            if (expr_is_f64(b.left, s) || expr_is_f64(b.right, s)) {
                var fk: string = map_fbinop(b.op);
                if (fk == "") { return s.fail(); }
                var fl: LowerState = lower_expr(b.left, s);
                if (!fl.ok) { return fl; }
                // An i32 operand mixed with an f64 (e.g. `3.5 + 2`) must be
                // widened to f64 first — otherwise op_fbin sees an i32 on the
                // stack and the wasm module fails to validate (f64.add expects
                // two f64s). i32_to_f64 is f64.convert_i32_s. Only a 32-bit
                // non-f64 operand is converted; an i64 in f64 context is left
                // alone (unsupported, bails like before).
                if (!expr_is_f64(b.left, s) && infer_expr_width(b.left, s) != 64) {
                    fl = fl.emit(ir.op_i32_to_f64());
                }
                var fr: LowerState = lower_expr(b.right, fl);
                if (!fr.ok) { return fr; }
                if (!expr_is_f64(b.right, s) && infer_expr_width(b.right, s) != 64) {
                    fr = fr.emit(ir.op_i32_to_f64());
                }
                fr = fr.emit(ir.op_fbin(fk));
                // f32 arithmetic rounds its result to single precision: f32
                // shares the 8-byte f64 slot, so fadd/fsub/fmul/fdiv compute at
                // DOUBLE precision, but native gives f32 a true 4-byte slot and
                // rounds after every op (`fadd s`-class). Round via the
                // f32_bits/f32_from_bits round-trip (demote → promote) when the
                // op is arithmetic — a comparison (is_fcmp_kind) yields an i32
                // bool that must NOT be rounded — and at least one operand is
                // f32. Idempotent with a later `as f32` cast. (#4366 — the
                // arithmetic sibling of the `as f32` cast rounding.)
                if (!is_fcmp_kind(fk) && (expr_is_f32(b.left, s) || expr_is_f32(b.right, s))) {
                    fr = fr.emit(ir.op_f32_bits());
                    fr = fr.emit(ir.op_f32_from_bits());
                }
                return fr;
            }
            var kind: string = map_binop(b.op);
            if (kind == "") { return s.fail(); }
            // i64 dispatch: if either operand is an i64 value, the operands are
            // lowered as i64 and the op runs at 64-bit width. Arithmetic
            // (including div/rem) yields i64; a comparison yields an i32 bool (the
            // backend knows from the kind).
            if (infer_expr_width(b.left, s) == 64 || infer_expr_width(b.right, s) == 64) {
                var li: LowerState = lower_i64(b.left, s);
                if (!li.ok) { return li; }
                var ri: LowerState = lower_i64(b.right, li);
                if (!ri.ok) { return ri; }
                // u64 operands take the UNSIGNED i64 ops (compare / >> / div / rem)
                // — signed versions are wrong once bit 63 is set (#2904). A shift's
                // signedness follows the left (shifted) operand; compare/div use
                // either side. add/sub/mul/and/or/xor/shl/eq/ne are sign-agnostic.
                var i64k: string = kind;
                var lu: boolean = expr_is_u64(b.left, s);
                if (b.op == ">>" || b.op == "<<") {
                    if (lu) { i64k = to_unsigned_kind(kind); }
                } else if (lu || expr_is_u64(b.right, s)) {
                    i64k = to_unsigned_kind(kind);
                }
                return ri.emit(ir.op_bin(i64k, 64, false));
            }
            var s1: LowerState = lower_expr(b.left, s);
            if (!s1.ok) { return s1; }
            var s2: LowerState = lower_expr(b.right, s1);
            if (!s2.ok) { return s2; }
            // u32 wrapping: a u32 `>>` is a LOGICAL shift (shr_u); a u32
            // arithmetic op whose value can exceed 32 bits (+ - * <<) is masked
            // back to 32 bits on the register backends (no-op on wasm's native
            // i32). Native wraps every u32 op at 2^32; without this u32-heavy
            // code (the SHA-256 schedule / __rotr) kept stray high bits.
            var ek: string = kind;
            var left_u32: boolean = expr_is_u32(b.left, s);
            var right_u32: boolean = expr_is_u32(b.right, s);
            if (b.op == ">>" && left_u32) { ek = "shr_u"; }
            // u32 ORDERING compares need the UNSIGNED IR kind (lt_u/le_u/gt_u/
            // ge_u): a u32 value ≥ 2^31 is signed-negative in a 32-bit slot, so a
            // signed compare gives the wrong answer on wasm. Remap via the same
            // to_unsigned_kind path u64 uses (#2904); the wasm backend then emits
            // i32.*_u and asm_ir emits setb/seta — both correct for a u32. eq/ne
            // are sign-agnostic and pass through. (#2917)
            if ((left_u32 || right_u32) && (kind == "lt_s" || kind == "le_s" || kind == "gt_s" || kind == "ge_s")) {
                ek = to_unsigned_kind(kind);
            }
            // u32 DIVISION / REMAINDER must be unsigned too: a u32 numerator >=
            // 2^31 reads as signed-negative in a 32-bit slot, so signed div/rem
            // give the wrong quotient (x86/wasm computed it signed — arm happened
            // to be right because its 64-bit reg held the value zero-extended).
            // Remap div_s/rem_s -> div_u/rem_u when either operand is u32, the
            // same way u64 does (#2904); add/sub/mul stay sign-agnostic. (#3204+)
            if ((left_u32 || right_u32) && (kind == "div_s" || kind == "rem_s")) {
                ek = to_unsigned_kind(kind);
            }
            var res: LowerState = s2.emit(ir.op_bin(ek, 0, false));
            var res_u32: boolean = left_u32 || right_u32;
            if (res_u32 && (kind == "add" || kind == "sub" || kind == "mul" || kind == "shl")) {
                res = res.emit(ir.op_u32_wrap());
            }
            // Sub-32-bit wrap: a u8 `+`/`-`/`*`/`<<` whose result can
            // exceed the width is masked back (int_cast),
            // matching the interpreter's per-width wrap (`255u8 + 1 == 0`). The
            // operands are themselves kept in range by this same step, so each
            // op masks its own result. u32/u64 are disjoint (res_u32 is false
            // here), so this never double-wraps.
            var sub_kind: string = expr_subword_kind(e, s);
            if (sub_kind != "" && (kind == "add" || kind == "sub" || kind == "mul" || kind == "shl")) {
                res = res.emit(ir.op_int_cast(sub_kind));
            }
            // Plain-i32 wrap: a default-int (i32) +/-/*/<< whose result can
            // exceed 32 bits is sign-extended back to 32 bits so it wraps
            // exactly like the native backend's 32-bit register and the AST
            // interpreter's width-32 arithmetic (#3581): `2147483647 + 1` ==
            // -2147483648, not the wide 2147483648. u32 (op_u32_wrap) and
            // sub-word (op_int_cast above) are disjoint from this case
            // (res_u32 false, sub_kind ""), and the i64 / f64 dispatches
            // returned earlier, so this fires only for a true i32 op.
            // op_int_cast("i32") is the signed sibling of op_u32_wrap.
            if (!res_u32 && sub_kind == "" && (kind == "add" || kind == "sub" || kind == "mul" || kind == "shl")) {
                res = res.emit(ir.op_int_cast("i32"));
            }
            return res;
        },
        parser.ExprUnary(u) => {
            // Try-operator `inner?` (parser desugar: unary "try_"). Unwrap the
            // Some/Ok payload as the expression's value, or early-return the
            // None/Err box from the enclosing Option/Result-returning function.
            if (u.op == "try_") { return lower_try(u.operand, s); }
            if (u.op == "-") {
                if (expr_is_f64(u.operand, s)) {
                    // -x flips the f64 sign bit (op_funary "fneg"). The old
                    // `0.0 - x` lowering flushed -0.0 to +0.0 (IEEE 0-0 = +0),
                    // so `1.0 / -(0.0)` gave +inf instead of -inf (#4333). A
                    // sign-bit flip preserves signed zero, matching native.
                    var fx: LowerState = lower_expr(u.operand, s);
                    if (!fx.ok) { return fx; }
                    return fx.emit(ir.op_funary("fneg"));
                }
                // Composite unary minus (#2706): `-a` on a struct/enum lowers
                // to `a.neg()`, mirroring the native checker's NegCall desugar.
                // As with the binary overloads, a type without `neg` bails to
                // the AST path rather than negating a struct pointer as a scalar.
                var ust: string = expr_struct_type(u.operand, s);
                if (decl_is_struct(s.structs, ust)) {
                    if (s.struct_ret_type(ust + ".neg") == "") { return s.fail(); }
                    var negcall: parser.Expr = parser.ExprCall { callee: parser.ExprFieldAccess { obj: u.operand, field: "neg", line: u.line, col: u.col }, args: [], line: u.line, col: u.col, type_argc: 0, ty: "" };
                    return lower_expr(negcall, s);
                }
                // -x  ==  0 - x  : push 0, push x, sub.
                var sz: LowerState = s.emit(ir.op_const_i32(0));
                var sx: LowerState = lower_expr(u.operand, sz);
                if (!sx.ok) { return sx; }
                return sx.emit(ir.op_bin("sub", 0, false));
            }
            if (u.op == "!") {
                var so: LowerState = lower_expr(u.operand, s);
                if (!so.ok) { return so; }
                return so.emit(ir.op_bin("not", 0, false));
            }
            // `x as f64`: int -> float widen (cvtsi2sd). An already-f64 operand
            // is a no-op for `as f64`/`as float`. `as f32`, however, must ROUND
            // the value to single precision — f32 shares the 8-byte f64 slot
            // here, but native gives f32 a true 4-byte slot, so a value that is
            // not f32-representable (e.g. 16777217.0, or a large int) differs
            // unless we round. The f32_bits/f32_from_bits pair round-trips
            // through f32 (demote then promote), applying single-precision
            // rounding while leaving an f64 on the stack. (#4366)
            if (u.op == "as_f64" || u.op == "as_f32" || u.op == "as_float") {
                var fv: LowerState = s;
                if (expr_is_f64(u.operand, s)) {
                    fv = lower_expr(u.operand, s);
                    if (!fv.ok) { return fv; }
                } else {
                    fv = lower_expr(u.operand, s);
                    if (!fv.ok) { return fv; }
                    fv = fv.emit(ir.op_i32_to_f64());
                }
                if (u.op == "as_f32") {
                    fv = fv.emit(ir.op_f32_bits());
                    fv = fv.emit(ir.op_f32_from_bits());
                }
                return fv;
            }
            // Int→int width cast `x as <ty>` for a 32-bit-or-narrower target
            // (i32 / u32 / u8). The masking/extension matches
            // asm.fern's `as_<ty>` exactly (int_cast op). The operand may be an
            // f64 (truncate toward zero via f64_to_i32, THEN mask), an i64
            // (narrow via int_wrap, THEN mask), or a 32-bit int (mask directly).
            if (u.op == "as_i32" || u.op == "as_u32" || u.op == "as_u8") {
                var cty: str = u.op[3 : u.op.len()];
                if (expr_is_f64(u.operand, s)) {
                    var fc: LowerState = lower_expr(u.operand, s);
                    if (!fc.ok) { return fc; }
                    // `f64 as u32` truncates UNSIGNED (#4332): the signed
                    // f64_to_i32 clamps at INT32_MAX, so 3e9 as u32 read as
                    // 2147483647 instead of 3000000000. Native saturates over
                    // the full u32 range (fcvtzu / trunc_sat_f64_u).
                    if (cty == "u32") { fc = fc.emit(ir.op_f64_to_u32()); }
                    else { fc = fc.emit(ir.op_f64_to_i32()); }
                    return fc.emit(ir.op_int_cast(cty));
                }
                if (infer_expr_width(u.operand, s) == 64) {
                    var i64c: LowerState = lower_i64(u.operand, s);
                    if (!i64c.ok) { return i64c; }
                    i64c = i64c.emit(ir.op_int_wrap(true));
                    return i64c.emit(ir.op_int_cast(cty));
                }
                var sn: LowerState = lower_expr(u.operand, s);
                if (!sn.ok) { return sn; }
                return sn.emit(ir.op_int_cast(cty));
            }
            // `E as T` type ascription (#2669) in a non-binding position
            // (return / argument / nested expr): the `as` is a zero-cost
            // identity annotation, so the value of `E as T` is exactly the
            // value of `E`. The binding form `var x = E as T` is intercepted
            // earlier in lower_stmt (rewritten to a `var x: T = E` rebind, so
            // the slot keeps its typed alias-inc); here there is no slot store,
            // so lowering the operand directly is RC-sound — it yields the same
            // value with the same ownership `E` alone would. Numeric
            // conversions (as_i32 / as_f64 / …) are handled above and keep
            // their value-converting path; an unsupported operand (e.g. a bare
            // `None` to an Option target) makes lower_expr bail, and the caller
            // falls back to the AST path.
            // `e as? T` fallible downcast (docs/DYN-TRAITS.md §9): the parser
            // tags this `as?_<T>`. `e` is a `dyn Trait` value (a heap pointer
            // carrying its concrete shape at offset 0); lower it, then
            // op_dyn_downcast reads that shape, compares to T's interned shape,
            // and yields Some(e) on an exact match / None otherwise — an
            // ordinary Option box a downstream `match` reads normally. The
            // self-host checker is permissive here (the Go checker is the strict
            // §9 gate), so we don't re-validate the dyn/impl relationship.
            if (u.op.len() > 4 && u.op[0:4] == "as?_") {
                var dcs: LowerState = lower_expr(u.operand, s);
                if (!dcs.ok) { return dcs; }
                return dcs.emit(ir.op_dyn_downcast(u.op[4 : u.op.len()]));
            }
            if (u.op.len() > 3 && u.op[0:3] == "as_" && !is_numeric_cast_op(u.op)) {
                return lower_expr(u.operand, s);
            }
            return s.fail();
        },
        parser.ExprArray(arr) => {
            // i32 array literal → the high-level `arr_make n` op. Each element
            // expr is lowered (pushing its i32 value, element 0 deepest), then
            // `arr_make` allocates the array, initialises its rc/len header and
            // fills the elements, and leaves the data pointer on the stack. The
            // BYTE layout (slot width, header shape, rc offset) is the
            // backend's choice — irlower commits only to the semantics. (Fresh
            // literal: owned at rc=1, no alias-inc.) Elements must be i32 or the
            // element lowering bails.
            var n: i32 = arr.elements.len();
            // An i64[]/u64[] literal (`[x as i64, …]`): a bare integer literal is
            // i32, so an i64[] literal is identified by an unambiguous 64-bit
            // first element. Lower each element via lower_i64 (8-byte value) and
            // emit arr_make_i64 — mirroring the StmtVar i64[]-literal binding
            // path. The generic i32/f64 path below lowers elements via lower_expr,
            // which BAILS on an `as i64` element (as_i64 has no lower_expr arm),
            // so without this an i64[] literal in a non-binding position (e.g. a
            // tuple element `([x as i64], y)`) bailed the module to AST. #3353.
            if (n > 0 && !expr_is_f64(arr.elements[0], s) && infer_expr_width(arr.elements[0], s) == 64) {
                var ia64: LowerState = s;
                var iae: i32 = 0;
                while (iae < n) {
                    ia64 = lower_i64(arr.elements[iae], ia64);
                    if (!ia64.ok) { return ia64; }
                    iae = iae + 1;
                }
                return ia64.emit(ir.op_arr_make_i64(n));
            }
            // Element WIDTH selects the array stride: an f64 element array uses
            // an 8-byte stride (arr_make width 64; the wasm backend allocates
            // n*8 and f64.stores each element), everything else the 4-byte i32 /
            // wasm32-pointer path. (The register backends use 8-byte slots
            // regardless — width only steers wasm.) The slot binding tracks
            // f64-array-ness (local_is_f64arr) so a[i] reads an 8-byte f64.
            var ewidth: i32 = 32;
            if (n > 0 && expr_is_f64(arr.elements[0], s)) { ewidth = 64; }
            // i32[] / string[] / f64[] literals are all supported: an i32 element
            // lowers to its value, a string element to its box pointer (const_str
            // etc.), an f64 element to its 8-byte bit pattern. The slot binding
            // tracks string[]- / f64[]-ness so a[i] types correctly; the array is
            // rc-tracked like any array and its string elements leak.
            var sa: LowerState = s;
            var i: i32 = 0;
            while (i < n) {
                sa = lower_expr(arr.elements[i], sa);
                if (!sa.ok) { return sa; }
                i = i + 1;
            }
            return sa.emit(ir.op_arr_make(n, ewidth));
        },
        parser.ExprTuple(tup) => {
            // Tuple literal `(a, b, …)` → tuple_make. Scalar elements only
            // (leak-only); a heap element bails to the AST path. Elements lower
            // in source order (element 0 deepest), then tuple_make boxes them.
            var tn: i32 = tup.elements.len();
            if (tn == 0) { return s.fail(); }
            // Scalar, string, struct, and i32[] array elements are allowed (leak
            // mode: each is one pointer-or-scalar slot, stored pointer-safely).
            // An i32[] element rides one slot as its data pointer; `t.N` recovers
            // it via tuple_get, and array ops only need that pointer (no extra
            // element-tag plumbing — deliberately NOT broadening the shared
            // elem_type_tag, which feeds tuple destructure / arg sites too).
            // string[] / f64[] / i64[] arrays, nested tuples, and other heap
            // elements still bail.
            var tei: i32 = 0;
            while (tei < tn) {
                // Each element must be a single leak-mode slot (scalar / string /
                // struct / array-pointer / Option / nested-tuple / Result / Map /
                // enum); tuple_elem_ctor_eligible is the shared admission (also
                // gating tuple cross-reuse), classifying an if-/match-EXPRESSION
                // element by its IIFE leaf branch value. A heap element outside the
                // set bails to the AST path.
                if (!tuple_elem_ctor_eligible(iife_leaf_value(tup.elements[tei]), s)) { return s.fail(); }
                tei = tei + 1;
            }
            // Build the per-element KIND string (i32 / i64 / f64 / string / <struct>)
            // so the wasm backend stores each at the right width, and lower an
            // i64 element via lower_i64 (8-byte i64 value); f64 / i32 / string /
            // struct elements ride lower_expr.
            var tkinds: string = "";
            var ts: LowerState = s;
            var tj: i32 = 0;
            while (tj < tn) {
                // Classify by the leaf branch for an IIFE element (no-op otherwise),
                // so the kind tag matches what lower_expr (lower_iife) produces.
                var tek: string = elem_type_tag(iife_leaf_value(tup.elements[tj]), ts);
                if (tj > 0) { tkinds = tkinds + ","; }
                tkinds = tkinds + tek;
                if (tek == "i64") { ts = lower_i64(tup.elements[tj], ts); }
                else { ts = lower_expr(tup.elements[tj], ts); }
                if (!ts.ok) { return ts; }
                tj = tj + 1;
            }
            return ts.emit(ir.op_tuple_make_k(tn, tkinds));
        },
        parser.ExprIndex(ix) => {
            // arr[idx] → lower the array (base) then the index, then `arr_get`
            // (the backend computes the element address for its layout). String
            // indexing `s[i]` reads a byte → `str_index` (an i32 byte value);
            // it shares the lower-array-then-index shape, just a different op.
            var sidx: LowerState = lower_expr(ix.array, s);
            if (!sidx.ok) { return sidx; }
            sidx = lower_expr(ix.index, sidx);
            if (!sidx.ok) { return sidx; }
            if (expr_is_str(ix.array, s)) { return sidx.emit(ir.op_str_index()); }
            // Element width from the array's slot: an f64[] reads an 8-byte f64
            // (arr_get width 64 → f64.load on wasm); i32[] / string[] the 4-byte
            // i32 path. expr_is_f64's ExprIndex case mirrors this so the result
            // types as f64 downstream.
            var gw: i32 = 32;
            if (arr_index_is_f64(ix.array, s)) { gw = 64; }
            // #4380 lever 3: a read the elide pass proved in-bounds (an enclosing
            // `while (i < arr.len())` guard) drops the per-iteration bounds check.
            if (ix.unchecked) { return sidx.emit(ir.op_arr_get_nc(gw)); }
            return sidx.emit(ir.op_arr_get(gw));
        },
        parser.ExprSlice(slc) => {
            // `s[start:end]` lowers [src, start, end] then `str_slice` (a fresh
            // string) or `arr_slice` (a fresh array) depending on the source. A
            // non-string, non-array source bails. (The binding is `slc`, not `sl`:
            // other arms bind `var sl: LowerState`, and the compiler's scope-blind
            // locals collapse same-named locals of different types.)
            var slc_is_str: boolean = expr_is_str(slc.array, s);
            if (!slc_is_str && !expr_is_arr_src(slc.array, s)) { return s.fail(); }
            // An f64[] or i64[] slice copies 8-byte elements (arr_slice width 64
            // → the wasm $__fern_arr_slice8 helper, a raw 8-byte move that serves
            // both); i32[] / string[] copy 4-byte elements. The result is a fresh
            // f64[]/i64[], marked at the var binding via expr_is_f64arr /
            // expr_is_i64arr's ExprSlice cases.
            var slc_w: i32 = 32;
            if (expr_is_f64arr(slc.array, s) || expr_is_i64arr(slc.array, s)) { slc_w = 64; }
            var ssl: LowerState = lower_expr(slc.array, s);
            if (!ssl.ok) { return ssl; }
            ssl = lower_expr(slc.start, ssl);
            if (!ssl.ok) { return ssl; }
            ssl = lower_expr(slc.end, ssl);
            if (!ssl.ok) { return ssl; }
            if (slc_is_str) { return ssl.emit(ir.op_str_slice()); }
            return ssl.emit(ir.op_arr_slice(slc_w));
        },
        parser.ExprCall(c) => {
            // Direct call (bare-name callee, up to 6 args), or the `.len()`
            // receiver method (field-access callee), which reads the array's
            // length header at base.
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    // Closure-box constructor marker (#2994): lift_inline_closures
                    // rewrites a CAPTURING inline lambda in array-element / struct-
                    // field-value position to `__mkclo$<cloname>(caps…)`, having
                    // hoisted the lambda body to a top-level `<cloname>(__env, …)`.
                    // Lower it to the escaping-closure env box — an i32[] [funcval,
                    // caps…] — exactly like the `return <lambda>` ExprLambda arm,
                    // but with the UNIQUE hoisted name carried in the marker (so a
                    // function may host several distinct inline closures, each in
                    // its own `$cloN`). `<cloname>` exists in the module (appended
                    // by the lift), so const_funcs_only_known keeps the module IR-
                    // eligible. The capture args are plain idents → load_local.
                    if (cid.name.len() > 8 && cid.name[0:8] == "__mkclo$") {
                        var clonm: str = cid.name[8 : cid.name.len()];
                        var mks: LowerState = s.emit(ir.op_const_func(0, clonm));
                        var mka: i32 = 0;
                        while (mka < c.args.len()) {
                            mks = lower_expr(c.args[mka], mks);
                            if (!mks.ok) { return mks; }
                            mka = mka + 1;
                        }
                        return mks.emit(ir.op_arr_make(c.args.len() + 1, 32));
                    }
                    // Indirect call through a function VALUE: `f(args)` where `f`
                    // names a local/param slot (a "fn"-typed value), not a
                    // top-level function. A local shadows any same-named function,
                    // so a resolvable slot means the callee is the value held
                    // there. Lower the args, push the function value, then
                    // call_indirect (the backend pops the fn pointer from TOS and
                    // the args beneath it).
                    // Closure-call (slice 3a): the callee is a closure LOCAL — an
                    // i32[] env box [funcval, caps…]. Env-first: push the box (the
                    // __env first arg), the declared args, then the funcval
                    // (box[0]) as the call target, and call_indirect with arity+1
                    // to the hoisted `<fn>$clo(__env, params…)`.
                    if (s.is_closure_local(cid.name)) {
                        var clslot: i32 = s.slot_of(cid.name);
                        var cls: LowerState = s.emit(ir.op_load_local(clslot));
                        var cla: i32 = 0;
                        while (cla < c.args.len()) {
                            // A `dyn Trait` param position dyn-boxes its arg (#5276).
                            if (s.fn_arg_is_dyn(cid.name, cla)) { cls = lower_dyn_arg(c.args[cla], cls); }
                            else { cls = lower_expr(c.args[cla], cls); }
                            if (!cls.ok) { return cls; }
                            cla = cla + 1;
                        }
                        cls = cls.emit(ir.op_load_local(clslot));
                        cls = cls.emit(ir.op_const_i32(0));
                        cls = cls.emit(ir.op_arr_get(32));
                        return cls.emit(ir.op_call_indirect(c.args.len() + 1));
                    }
                    var icslot: i32 = s.slot_of(cid.name);
                    if (icslot >= 0) {
                        var ics: LowerState = s;
                        var ica: i32 = 0;
                        while (ica < c.args.len()) {
                            // A `dyn Trait` param position dyn-boxes its arg so the
                            // callee's op_dyn_dispatch reads a real shape pointer,
                            // not a raw primitive (SIGSEGV otherwise) — #5276.
                            if (s.fn_arg_is_dyn(cid.name, ica)) { ics = lower_dyn_arg(c.args[ica], ics); }
                            else { ics = lower_expr(c.args[ica], ics); }
                            if (!ics.ok) { return ics; }
                            ica = ica + 1;
                        }
                        ics = ics.emit(ir.op_load_local(icslot));
                        return ics.emit(ir.op_call_indirect(c.args.len()));
                    }
                    // A user-defined free function shadows any same-named
                    // builtin: native + interp resolve `name(args)` to the user
                    // function when one is declared, so the IR path must too — a
                    // user `len` / `exit` / `chr` / … is a real call, not the
                    // builtin op (#3710). Gate every builtin-name intercept below
                    // on the name NOT being a module function; otherwise fall
                    // through to the ordinary direct-call lowering. (When
                    // compiling the compiler this is dead — its builtin calls use
                    // qualified/mangled names like `util__i32_to_string` — so the
                    // byte-identical self-host fixpoint is preserved.)
                    if (!s.is_user_fn(cid.name)) {
                    // __rc(arr): read the refcount header at base-4 (an RC
                    // observation hook for tests; not a real callee).
                    if (cid.name == "__rc") {
                        if (c.args.len() != 1) { return s.fail(); }
                        var sr: LowerState = lower_expr(c.args[0], s);
                        if (!sr.ok) { return sr; }
                        return sr.emit(ir.op_arr_rc());
                    }
                    // __rc_dec(a): manual release (a test hook for exercising
                    // the underflow detector); returns the pointer.
                    if (cid.name == "__rc_dec") {
                        if (c.args.len() != 1) { return s.fail(); }
                        var sd: LowerState = lower_expr(c.args[0], s);
                        if (!sd.ok) { return sd; }
                        return sd.emit(ir.op_call_direct("__fern_rc_dec", 1));
                    }
                    // __rc_underflow(): read the over-release counter.
                    if (cid.name == "__rc_underflow") {
                        if (c.args.len() != 0) { return s.fail(); }
                        return s.emit(ir.op_call_direct("__fern_rc_underflow_get", 0));
                    }
                    // __heap_used(): bytes bump-allocated so far (reuse from the
                    // freelist does NOT bump, so this measures peak growth — the
                    // reclamation win).
                    if (cid.name == "__heap_used") {
                        if (c.args.len() != 0) { return s.fail(); }
                        return s.emit(ir.op_call_direct("__fern_heap_used", 0));
                    }
                    // __alloc_u8(n): a fresh n-element byte array (8-byte slots,
                    // len = n; contents NOT zeroed). string_from_bytes_unchecked(arr) packs
                    // each slot's low byte into a string box. Both lower to a
                    // dedicated op the IR backends emit as the same __fern_* call
                    // the AST path uses.
                    if (cid.name == "__alloc_u8" && c.args.len() == 1) {
                        var au: LowerState = lower_expr(c.args[0], s);
                        if (!au.ok) { return au; }
                        return au.emit(ir.op_alloc_u8());
                    }
                    // __alloc(n): bump-alloc n raw bytes, push the usize pointer (the
                    // core/map runtime's allocator). op_alloc is the bare-pointer
                    // sibling of op_alloc_u8 (which builds an array box) — both call
                    // the backend's __fern_alloc.
                    if (cid.name == "__alloc" && c.args.len() == 1) {
                        var al: LowerState = lower_expr(c.args[0], s);
                        if (!al.ok) { return al; }
                        return al.emit(ir.op_alloc());
                    }
                    // __ptr_width(): the target's heap-pointer width in bytes (8 on
                    // x86-64 / arm64, 4 on wasm32). Backend-resolved so wasm32's
                    // pointer arithmetic uses 4, not a baked-in 8.
                    if (cid.name == "__ptr_width" && c.args.len() == 0) {
                        return s.emit(ir.op_ptr_width());
                    }
                    // __memset(dst, byte, n): fill n bytes at dst with `byte`'s low
                    // byte (core/map's bucket init). Lower dst, byte, n then emit
                    // op_memset (rep stosb / byte loop / memory.fill); pushes dummy 0.
                    if (cid.name == "__memset" && c.args.len() == 3) {
                        var ms3: LowerState = lower_expr(c.args[0], s);
                        if (!ms3.ok) { return ms3; }
                        ms3 = lower_expr(c.args[1], ms3);
                        if (!ms3.ok) { return ms3; }
                        ms3 = lower_expr(c.args[2], ms3);
                        if (!ms3.ok) { return ms3; }
                        return ms3.emit(ir.op_memset());
                    }
                    // __free(ptr, size): a no-op under the bump/leak heap (core/map's
                    // grow path). Lower both args (no side effects), emit op_free,
                    // which discards them and pushes dummy 0 (statement-position).
                    if (cid.name == "__free" && c.args.len() == 2) {
                        var fr: LowerState = lower_expr(c.args[0], s);
                        if (!fr.ok) { return fr; }
                        fr = lower_expr(c.args[1], fr);
                        if (!fr.ok) { return fr; }
                        return fr.emit(ir.op_free());
                    }
                    // __fern_arr_dec(v, stride) / __fern_drop_arr_ptr(v, stride):
                    // core/map's value-release helpers. The self-host backends keep
                    // these NO-OPS (safe-leak mode — the array rc-header layout
                    // migration that would wire in real frees isn't done; the native
                    // backend does real RC, goal #2 ports it). Lower as a no-op that
                    // consumes both args and pushes a dummy 0 (reusing op_free's
                    // pop-2/push-0). This matches asm.fern's documented no-op and
                    // avoids the stack-arg-helper ABI: a generic call_direct would
                    // mis-pass the 2 args to the 1-slot __fn___fern_arr_dec. Flips
                    // __map_dec_value (the last core/map bail) to ir. #2691 stage 3.
                    if ((cid.name == "__fern_arr_dec" || cid.name == "__fern_drop_arr_ptr") && c.args.len() == 2) {
                        var rd: LowerState = lower_expr(c.args[0], s);
                        if (!rd.ok) { return rd; }
                        rd = lower_expr(c.args[1], rd);
                        if (!rd.ok) { return rd; }
                        return rd.emit(ir.op_free());
                    }
                    // __memcpy(dst, src, n): raw byte copy. Lower the three
                    // usize/i32 operands (dst, src, n) then emit op_memcpy, which
                    // the IR backends select rep movsb / a byte loop / memory.copy
                    // for. Pushes a dummy 0 (used statement-position, discarded) —
                    // matching the AST emitters. Unblocks core/int int_to_string.
                    if (cid.name == "__memcpy" && c.args.len() == 3) {
                        var mc: LowerState = lower_expr(c.args[0], s);
                        if (!mc.ok) { return mc; }
                        mc = lower_expr(c.args[1], mc);
                        if (!mc.ok) { return mc; }
                        mc = lower_expr(c.args[2], mc);
                        if (!mc.ok) { return mc; }
                        return mc.emit(ir.op_memcpy());
                    }
                    // Raw-memory loads/stores at a usize address (core/map runtime).
                    // __load_i32(addr) / __load_ptr(addr): pop the address, emit the
                    // inline load. (__load_i64 returns i64 — handled in lower_i64.)
                    // __store_i32(addr, v) / __store_ptr(addr, v): pop addr + value,
                    // store, push dummy 0 (statement-position, discarded).
                    if (cid.name == "__load_i32" && c.args.len() == 1) {
                        var li: LowerState = lower_expr(c.args[0], s);
                        if (!li.ok) { return li; }
                        return li.emit(ir.op_load_i32());
                    }
                    // __load_i64(addr) reads an 8-byte i64. Emitted here (pushing an
                    // i64) like the clock builtins; lower_i64 / infer_expr_width /
                    // expr_is_i64 recognise it so an i64 context routes through here.
                    if (cid.name == "__load_i64" && c.args.len() == 1) {
                        var l8: LowerState = lower_expr(c.args[0], s);
                        if (!l8.ok) { return l8; }
                        return l8.emit(ir.op_load_i64());
                    }
                    if (cid.name == "__load_ptr" && c.args.len() == 1) {
                        var lp: LowerState = lower_expr(c.args[0], s);
                        if (!lp.ok) { return lp; }
                        return lp.emit(ir.op_load_ptr());
                    }
                    if (cid.name == "__store_i32" && c.args.len() == 2) {
                        var si: LowerState = lower_expr(c.args[0], s);
                        if (!si.ok) { return si; }
                        si = lower_expr(c.args[1], si);
                        if (!si.ok) { return si; }
                        return si.emit(ir.op_store_i32());
                    }
                    if (cid.name == "__store_ptr" && c.args.len() == 2) {
                        var sp: LowerState = lower_expr(c.args[0], s);
                        if (!sp.ok) { return sp; }
                        sp = lower_expr(c.args[1], sp);
                        if (!sp.ok) { return sp; }
                        return sp.emit(ir.op_store_ptr());
                    }
                    // __store_i64(addr, v) writes an 8-byte i64 — the store sibling
                    // of __load_i64, which was missing (#4375 item 2). The address
                    // is an i32/usize (lower_expr); the value is an i64, so it routes
                    // through lower_i64 (like an i64[] element store). Pushes a dummy
                    // 0, discarded in statement position.
                    if (cid.name == "__store_i64" && c.args.len() == 2) {
                        var s8: LowerState = lower_expr(c.args[0], s);
                        if (!s8.ok) { return s8; }
                        s8 = lower_i64(c.args[1], s8);
                        if (!s8.ok) { return s8; }
                        return s8.emit(ir.op_store_i64());
                    }
                    // std/float single-instruction math builtins: __sqrt_f64 /
                    // __floor_f64 / __ceil_f64 / __trunc_f64 / __abs_f64. Lower the
                    // f64 operand, then emit the op_funary intrinsic the IR backends
                    // select a single hardware instruction for.
                    var fuk: string = f64_math_builtin_kind(cid.name);
                    if (fuk != "" && c.args.len() == 1) {
                        var fu: LowerState = lower_expr(c.args[0], s);
                        if (!fu.ok) { return fu; }
                        return fu.emit(ir.op_funary(fuk));
                    }
                    // __pow_f64(x, y) — the one two-argument transcendental. Lower
                    // both f64 operands (x then y), then emit the fpow fbin: x86
                    // reconstructs 2^(y·log2 x) on the x87 FPU, arm64 calls its
                    // __fern_pow_f64 helper. wasm subtracts "fpow" in wasm_eligible.
                    if (cid.name == "__pow_f64" && c.args.len() == 2) {
                        var fp: LowerState = lower_expr(c.args[0], s);
                        if (!fp.ok) { return fp; }
                        fp = lower_expr(c.args[1], fp);
                        if (!fp.ok) { return fp; }
                        return fp.emit(ir.op_fbin("fpow"));
                    }
                    // f64_bits / f64_from_bits — bit reinterpret between an f64 and
                    // its i64 bit pattern; f32_bits / f32_from_bits the 32-bit pair.
                    // f64_bits / f32_bits take an f64 operand (lower_expr routes
                    // floats); f64_from_bits takes an i64 (lower_i64) and
                    // f32_from_bits an i32 (lower_expr). On the register backends
                    // the bit-slot reinterpret is a no-op (f64) or a narrow/widen
                    // (f32); wasm emits the typed reinterpret instructions.
                    if (cid.name == "f64_bits" && c.args.len() == 1) {
                        var fbb: LowerState = lower_expr(c.args[0], s);
                        if (!fbb.ok) { return fbb; }
                        return fbb.emit(ir.op_f64_bits());
                    }
                    if (cid.name == "f64_from_bits" && c.args.len() == 1) {
                        var ffb: LowerState = lower_i64(c.args[0], s);
                        if (!ffb.ok) { return ffb; }
                        return ffb.emit(ir.op_f64_from_bits());
                    }
                    if (cid.name == "f32_bits" && c.args.len() == 1) {
                        var f3b: LowerState = lower_expr(c.args[0], s);
                        if (!f3b.ok) { return f3b; }
                        return f3b.emit(ir.op_f32_bits());
                    }
                    if (cid.name == "f32_from_bits" && c.args.len() == 1) {
                        var f3f: LowerState = lower_expr(c.args[0], s);
                        if (!f3f.ok) { return f3f; }
                        return f3f.emit(ir.op_f32_from_bits());
                    }
                    if (cid.name == "string_from_bytes_unchecked" && c.args.len() == 1) {
                        var sfb: LowerState = lower_expr(c.args[0], s);
                        if (!sfb.ok) { return sfb; }
                        return sfb.emit(ir.op_str_from_bytes());
                    }
                    // random_bytes(n): a fresh string of n CSPRNG bytes. The
                    // result is a string box (str_index reads the bytes); the
                    // IR backends emit the __fern_random_bytes helper.
                    if (cid.name == "random_bytes" && c.args.len() == 1) {
                        var rb: LowerState = lower_expr(c.args[0], s);
                        if (!rb.ok) { return rb; }
                        return rb.emit(ir.op_random_bytes());
                    }
                    // random_i32(): a single CSPRNG i32.
                    if (cid.name == "random_i32" && c.args.len() == 0) {
                        return s.emit(ir.op_random_i32());
                    }
                    // monotonic_ns() / now_unix_ms(): 0-arg i64 clock readings.
                    // Each lowers to a dedicated op the IR backends emit as a
                    // call into the same __fern_* runtime helper the AST path
                    // uses (no allocation; the i64 result rides %rax / x0).
                    if (cid.name == "monotonic_ns" && c.args.len() == 0) {
                        return s.emit(ir.op_monotonic_ns());
                    }
                    if (cid.name == "now_unix_ms" && c.args.len() == 0) {
                        return s.emit(ir.op_now_unix_ms());
                    }
                    if (cid.name == "now_ns" && c.args.len() == 0) {
                        return s.emit(ir.op_now_ns());
                    }
                    // poll(fds, timeout_ms): lower fds (the i32[] box ptr) then
                    // timeout, then a dedicated op the backends emit as a call
                    // into __fern_poll (poll(2) over the fd set) → ready index.
                    if (cid.name == "poll" && c.args.len() == 2) {
                        var pl: LowerState = lower_expr(c.args[0], s);
                        if (!pl.ok) { return pl; }
                        pl = lower_expr(c.args[1], pl);
                        if (!pl.ok) { return pl; }
                        return pl.emit(ir.op_poll());
                    }
                    // timer_fd(ms): lower ms, then a dedicated op the backends
                    // emit as a call into __fern_timer_fd (a CLOCK_MONOTONIC
                    // one-shot timerfd) → the fd.
                    if (cid.name == "timer_fd" && c.args.len() == 1) {
                        var tf: LowerState = lower_expr(c.args[0], s);
                        if (!tf.ok) { return tf; }
                        return tf.emit(ir.op_timer_fd());
                    }
                    // wasm_timer_pollable(ns) / wasm_pollable_drop(p): portability
                    // shims (native: -1 / 0). Lower the arg, then emit the op.
                    if (cid.name == "wasm_timer_pollable" && c.args.len() == 1) {
                        var wt: LowerState = lower_expr(c.args[0], s);
                        if (!wt.ok) { return wt; }
                        return wt.emit(ir.op_wasm_timer_pollable());
                    }
                    if (cid.name == "wasm_pollable_drop" && c.args.len() == 1) {
                        var wd: LowerState = lower_expr(c.args[0], s);
                        if (!wd.ok) { return wd; }
                        return wd.emit(ir.op_wasm_pollable_drop());
                    }
                    // udp_send(host, port, data) — one-shot datagram (#4375).
                    // host is an IPv4 LITERAL STRING ("a.b.c.d"), not a packed
                    // i32 like tcp_connect's, so all three args lower as plain
                    // values and the backend helper parses the dotted quad.
                    if (cid.name == "udp_send" && c.args.len() == 3) {
                        var us: LowerState = lower_expr(c.args[0], s);
                        if (!us.ok) { return us; }
                        us = lower_expr(c.args[1], us);
                        if (!us.ok) { return us; }
                        us = lower_expr(c.args[2], us);
                        if (!us.ok) { return us; }
                        return us.emit(ir.op_udp_send());
                    }
                    if (cid.name == "wasm_block" && c.args.len() == 1) {
                        var wb: LowerState = lower_expr(c.args[0], s);
                        if (!wb.ok) { return wb; }
                        return wb.emit(ir.op_wasm_block());
                    }
                    // wasm_poll(pollables): lower the array arg (its ptr lands on
                    // the stack), then the op (native: -1; wasm: wasi:io/poll.poll
                    // over the length-prefixed array as a canonical (ptr, len) list).
                    if (cid.name == "wasm_poll" && c.args.len() == 1) {
                        var wp: LowerState = lower_expr(c.args[0], s);
                        if (!wp.ok) { return wp; }
                        return wp.emit(ir.op_wasm_poll());
                    }
                    // tcp_connect(host_be, port) / tcp_send(fd, str) /
                    // tcp_recv(fd, max): 2-arg client primitives. Lower both
                    // operands (left then right), then the matching op.
                    if (cid.name == "tcp_connect" && c.args.len() == 2) {
                        var tc: LowerState = lower_expr(c.args[0], s);
                        if (!tc.ok) { return tc; }
                        tc = lower_expr(c.args[1], tc);
                        if (!tc.ok) { return tc; }
                        return tc.emit(ir.op_tcp_connect());
                    }
                    if (cid.name == "tcp_send" && c.args.len() == 2) {
                        var ts: LowerState = lower_expr(c.args[0], s);
                        if (!ts.ok) { return ts; }
                        ts = lower_expr(c.args[1], ts);
                        if (!ts.ok) { return ts; }
                        return ts.emit(ir.op_tcp_send());
                    }
                    if (cid.name == "tcp_recv" && c.args.len() == 2) {
                        var tr: LowerState = lower_expr(c.args[0], s);
                        if (!tr.ok) { return tr; }
                        tr = lower_expr(c.args[1], tr);
                        if (!tr.ok) { return tr; }
                        return tr.emit(ir.op_tcp_recv());
                    }
                    // tcp_close(fd) / tcp_pollable(fd): 1-arg.
                    if (cid.name == "tcp_close" && c.args.len() == 1) {
                        var tcl: LowerState = lower_expr(c.args[0], s);
                        if (!tcl.ok) { return tcl; }
                        return tcl.emit(ir.op_tcp_close());
                    }
                    if (cid.name == "tcp_pollable" && c.args.len() == 1) {
                        var tp: LowerState = lower_expr(c.args[0], s);
                        if (!tp.ok) { return tp; }
                        return tp.emit(ir.op_tcp_pollable());
                    }
                    // tcp_listen(port) / tcp_accept(fd): the server-half 1-arg
                    // primitives (#4371). tcp_listen opens a bound+listening
                    // socket on 0.0.0.0:port; tcp_accept blocks for a connection
                    // on a listener. Both -> i32 fd (or -errno).
                    if (cid.name == "tcp_listen" && c.args.len() == 1) {
                        var tls: LowerState = lower_expr(c.args[0], s);
                        if (!tls.ok) { return tls; }
                        return tls.emit(ir.op_tcp_listen());
                    }
                    if (cid.name == "tcp_accept" && c.args.len() == 1) {
