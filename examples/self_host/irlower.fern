        // corrupts the value rather than leaking one.
        parser.ExprIndex(ix) => {
            var icnt: boolean = pfx == "SCNT:";
            return arrparam_use_ok(ix.array, pn, icnt, reg, pfx, structs, sfok) && arrparam_use_ok(ix.index, pn, false, reg, pfx, structs, sfok);
        },
        parser.ExprSlice(sl2) => { return arrparam_use_ok(sl2.array, pn, false, reg, pfx, structs, sfok) && arrparam_use_ok(sl2.start, pn, false, reg, pfx, structs, sfok) && arrparam_use_ok(sl2.end, pn, false, reg, pfx, structs, sfok); },
        parser.ExprFieldAccess(fa2) => { return arrparam_use_ok(fa2.obj, pn, false, reg, pfx, structs, sfok); },
        parser.ExprLambda(lm) => { return arrparam_uses_ok_stmts(lm.body, pn, reg, pfx, structs, sfok); },
        _ => { return true; }
    }
    return true;
}

function arrparam_uses_ok_stmts(stmts: parser.Stmt[], pn: string, reg: string[], pfx: string, structs: parser.StructDecl[], sfok: string[]): boolean {
    var i: i32 = 0;
    while (i < stmts.len()) { if (!arrparam_use_ok_stmt(stmts[i], pn, reg, pfx, structs, sfok)) { return false; } i = i + 1; }
    return true;
}
function arrparam_use_ok_stmt(st: parser.Stmt, pn: string, reg: string[], pfx: string, structs: parser.StructDecl[], sfok: string[]): boolean {
    match (st) {
        parser.StmtVar(v) => { return arrparam_use_ok(v.init, pn, false, reg, pfx, structs, sfok); },
        parser.StmtAssign(a) => { return arrparam_use_ok(a.value, pn, false, reg, pfx, structs, sfok); },
        parser.StmtReturn(r) => { return arrparam_use_ok(r.value, pn, false, reg, pfx, structs, sfok); },
        parser.StmtExpr(e) => { return arrparam_use_ok(e.value, pn, false, reg, pfx, structs, sfok); },
