    // Built-in `lstat(path)` — stat without following a final symlink.
    if (cid.name == "lstat" && c.args.len() == 1) {
        var lsts: LowerState = lower_expr(c.args[0], s);
        if (!lsts.ok) { return lsts; }
        return lsts.emit(ir.op_lstat());
    }
    // Built-in `subprocess(cmd, args, stdin)` — spawn a child, pipe
