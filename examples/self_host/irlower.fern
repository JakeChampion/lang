// examples/self_host/irlower.fern — AST -> stack-IR lowering for the
// self-hosted compiler (slice 2 of the IR rebuild, see
// docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md), plus a stack-machine
// interpreter that evaluates the lowered Op[] so lowering is checkable
// end-to-end WITHOUT a backend (mirrors how ssa.fern validates its builder
// with an SSA interpreter).
//
// SCOPE (slice 2): the straight-line i32 subset — params, `var` / `=`
// locals, integer / bool literals, the binary + unary operators, and
// `return`. This is the IR analogue of ssa.fern's slice-1 subset. Anything
// outside it (control flow, calls, strings, floats, composites) makes
// lower_func return ok=false, so the driver can fall back / report a bail.
// Control flow (block/loop/if/br) + calls land in later slices, mirroring
// the native builder's expression/statement lowering.
//
// The lowering is a textbook stack-machine emit: an expression lowers to
// ops that PUSH its value (operands first, then the operator), a `var`
// binds the next local slot and stores into it, `return` lowers its value
// then emits `return`. Params occupy slots 0..n_params-1.

import "./ir";
import "./parser";
import "./util";

// LowerState threads the accumulated Op[] and the local-slot table
// (slot i -> name) immutably, in the self-host style. `n_params` records
// the borrow boundary the later RC slices need; `ok` latches a bail.
pub struct LowerState {
    ops: ir.Op[],
    local_names: string[],
    // local_is_arr[i] marks slot i as holding an array value (drives the
    // Perceus alias-inc: a new reference to an array must retain it).
    local_is_arr: boolean[],
    // local_is_str[i] marks slot i as holding a string value — used for type
    // dispatch only (str_len vs arr_len, str_concat vs add, str_eq vs eq).
    // Strings are not reference-counted, so this drives no RC; it just keeps
    // string slots out of the array machinery and selects the string opcodes.
    local_is_str: boolean[],
    // local_is_strarr[i] marks slot i as holding a string[] array (alongside
    // local_is_arr, which still drives the array's RC). It only affects element
    // typing: arr[i] on a string[] yields a string (str_len etc.), while the
    // array itself is rc-tracked like any array and its string elements leak.
    local_is_strarr: boolean[],
    // local_struct_type[i] holds the struct type name of slot i (""=not a
    // struct), so `p.x` resolves x's field index in p's decl. Like local_is_str,
    // dispatch-only — the scalar-field structs this slice covers are leak-only.
    local_struct_type: string[],
    // local_opt_type[i] holds the Option[T]/Result[T,E] type string of slot i
    // (""=not an Option/Result), set when `var r = f()` binds an Option/Result-
    // returning call (or for an Option/Result param). Lets a `match (r)` on a
    // local recover the bound payload type, the same way a direct-call scrutinee
    // uses opt_ret_fns.
    local_opt_type: string[],
    // local_tuple_elems[i] holds slot i's tuple element-type tags, comma-joined
    // (e.g. "string,i32,Point"), "" if not a tuple. Lets `t.N` and a tuple
    // destructure recover each element's type for dispatch.
    local_tuple_elems: string[],
    local_map_type: string[],
    // local_is_i64[i] marks slot i as holding an i64 value (drives i64
    // instruction selection + wasm i64 local typing). i32 stays the default.
    local_is_i64: boolean[],
    // local_is_f64[i] marks slot i as holding an f64 value (drives float
    // instruction selection: arithmetic / comparison use the float registers).
    // The slot itself is an 8-byte bit pattern like any value; only the ops on
    // it differ. i32 stays the default.
    local_is_f64: boolean[],
    // local_is_f64arr[i] marks slot i as holding an f64[] array (alongside
    // local_is_arr, which still drives the array's RC). It only affects element
    // WIDTH: a[i] on an f64-array slot reads an 8-byte f64 (arr_get width 64,
    // f64.load on wasm) and types as f64, and an f64 array literal allocates an
    // 8-byte-stride buffer. i32 / string[] arrays (4-byte wasm stride) stay the
    // default. The register backends already use 8-byte element slots, so this
    // only steers the wasm backend's element load/store width.
    local_is_f64arr: boolean[],
    // ctrl: count of structured-control constructs (block/loop/if) currently
    // open at this point — auto-maintained in emit(). loop_blk: a stack holding,
    // per enclosing loop, the ctrl level just after that loop's exit-block opener
    // (the loop header sits one deeper). break = br(ctrl - top); continue =
    // br(ctrl - top - 1). Together they let break/continue compute relative br
    // depths through arbitrary if/match nesting.
    ctrl: i32,
    loop_blk: i32[],
    // ret_is_i64: this function returns i64 (so `return <i64expr>` lowers via
    // lower_i64). i64_ret_fns: names of module functions returning i64, so a
    // call to one is recognised as an i64 value (infer_expr_width / lower_i64).
    ret_is_i64: boolean,
    i64_ret_fns: string[],
    // f64_ret_fns: names of free functions returning f64, so a call to one is
    // recognised as an f64 value (expr_is_f64). Without it an unannotated
    // `f(a) * g(b)` of two f64-returning calls would mis-select integer mul on
    // the float bits. Threaded read-only like i64_ret_fns.
    f64_ret_fns: string[],
    // f64arr_ret_fns: names of free functions returning f64[], so the call-site
    // binding `var x = f()` element-width-tracks x (is_f64arr), letting a later
    // x[i] read an 8-byte f64. Without it the result would be a generic array
    // and x[i] would mis-load 4 bytes off an 8-byte buffer. Read-only registry.
    f64arr_ret_fns: string[],
    // structs: the module's struct decls, for field-index / field-order lookup
    // (constant across the lowering; threaded read-only).
    structs: parser.StructDecl[],
    // str_ret_fns: names of functions whose return type is `string`, so a
    // `var s = f()` (and `f().len()`) tracks the result as a string for op
    // dispatch. Strings aren't RC'd, so this is type tracking only. Threaded
    // read-only like structs; empty during op-kind analyses (where string
    // tracking doesn't change the result).
    str_ret_fns: string[],
    // arr_ret_fns: names of functions whose return type is an array, so a
    // `var x = f()` is a move (owned, no inc) and x is array-tracked.
    arr_ret_fns: string[],
    // strarr_ret_fns: names of functions whose return type is `string[]`, so a
    // `var xs = f()` tracks xs as string[] (element typing: xs[i] is a string).
    // The array itself is still rc-tracked via arr_ret_fns; this is the string-
    // element overlay, mirroring str_ret_fns for the scalar string case.
    strarr_ret_fns: string[],
    // opt_ret_fns: entries "name|rettype" for functions whose return type is
    // Option[T] or Result[T, E], so a match on `f()` can recover the bound
    // payload's type (T for Some/Ok, E for Err) and bind it correctly (scalar
    // plain, string via mark_str). Threaded read-only like str_ret_fns.
    opt_ret_fns: string[],
    // tuple_ret_fns: entries "name|rettype" for free functions whose return
    // type is a tuple `(t0, t1, …)`, so `var x = f()` / `var (a, b, …) = f()`
    // recovers each element's type tag for `.N` / destructure dispatch. Only
    // scalar/string-element tuples are lowered (lower_func bails the rest);
    // threaded read-only like opt_ret_fns.
    tuple_ret_fns: string[],
    // struct_ret_fns: entries "name|StructType" for free functions returning a
    // (leaf-safe, scalar-field) struct, so `var p = f()` tracks p's struct type
    // for later field access (`p.x`). Threaded read-only like tuple_ret_fns.
    struct_ret_fns: string[],
    n_params: i32,
    ok: boolean,
}

pub function (s: LowerState) emit(op: ir.Op): LowerState {
    // Auto-maintain ctrl: a block/loop/if opens a new structured-control level;
    // an end closes one. else/br/br_if leave the level unchanged. This keeps the
    // br-depth bookkeeping correct across every emit site with no per-site code.
    var nctrl: i32 = s.ctrl;
    if (op.kind == "block" || op.kind == "loop" || op.kind == "if") { nctrl = s.ctrl + 1; }
    if (op.kind == "end") { nctrl = s.ctrl - 1; }
    return LowerState { ops: s.ops.append(op), local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: nctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}

// enter_loop / exit_loop push and pop the loop_blk stack. enter_loop is called
// right after a loop's exit-block opener is emitted (so s.ctrl is the block's
// level); exit_loop after both of the loop's `end`s. cur_loop_blk returns the
// innermost loop's recorded block level, or -1 outside any loop.
pub function (s: LowerState) enter_loop(): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: s.ctrl, loop_blk: s.loop_blk.append(s.ctrl), ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}
pub function (s: LowerState) exit_loop(): LowerState {
    var trimmed: i32[] = [];
    var k: i32 = 0;
    while (k + 1 < s.loop_blk.len()) { trimmed = trimmed.append(s.loop_blk[k]); k = k + 1; }
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: s.ctrl, loop_blk: trimmed, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}
pub function (s: LowerState) cur_loop_blk(): i32 {
    if (s.loop_blk.len() == 0) { return 0 - 1; }
    return s.loop_blk[s.loop_blk.len() - 1];
}

pub function (s: LowerState) fail(): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: s.ctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: false };
}

// is_arr_ret_fn reports whether `name` is a function returning an array.
pub function (s: LowerState) is_arr_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.arr_ret_fns.len()) {
        if (s.arr_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// is_strarr_ret_fn reports whether `name` is a function returning `string[]`.
pub function (s: LowerState) is_strarr_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.strarr_ret_fns.len()) {
        if (s.strarr_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// slot_of returns the local slot for `name`, or -1 if unbound.
pub function (s: LowerState) slot_of(name: string): i32 {
    var i: i32 = 0;
    while (i < s.local_names.len()) {
        if (s.local_names[i] == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// add_local binds `name` to a fresh slot (its index = the old slot count),
// not-an-array by default.
pub function (s: LowerState) add_local(name: string): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names.append(name), local_is_arr: s.local_is_arr.append(false), local_is_str: s.local_is_str.append(false), local_is_strarr: s.local_is_strarr.append(false), local_struct_type: s.local_struct_type.append(""), local_opt_type: s.local_opt_type.append(""), local_tuple_elems: s.local_tuple_elems.append(""), local_map_type: s.local_map_type.append(""), local_is_i64: s.local_is_i64.append(false), local_is_f64: s.local_is_f64.append(false), local_is_f64arr: s.local_is_f64arr.append(false), ctrl: s.ctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}

// is_arr_slot / mark_arr query and set the array-ness of slot i.
pub function (s: LowerState) is_arr_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.local_is_arr.len()) { return false; }
    return s.local_is_arr[i];
}

pub function (s: LowerState) mark_arr(i: i32, v: boolean): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr.with(i, v), local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: s.ctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}

// is_str_slot / mark_str query and set the string-ness of slot i.
pub function (s: LowerState) is_str_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.local_is_str.len()) { return false; }
    return s.local_is_str[i];
}

pub function (s: LowerState) mark_str(i: i32, v: boolean): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str.with(i, v), local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: s.ctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}

pub function (s: LowerState) is_strarr_slot(i: i32): boolean {
    if (i < 0) { return false; }
    if (i >= s.local_is_strarr.len()) { return false; }
    return s.local_is_strarr[i];
}

pub function (s: LowerState) mark_strarr(i: i32, v: boolean): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr.with(i, v), local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: s.ctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}

// is_struct_slot / struct_type_of_slot / mark_struct_type query and set the
// struct type held by slot i ("" = not a struct).
pub function (s: LowerState) struct_type_of_slot(i: i32): string {
    if (i < 0) { return ""; }
    if (i >= s.local_struct_type.len()) { return ""; }
    return s.local_struct_type[i];
}

pub function (s: LowerState) mark_struct_type(i: i32, t: string): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type.with(i, t), local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: s.ctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}

// mark_opt_type records slot i's Option[T]/Result[T,E] type string, so a later
// `match` on that local can recover the bound payload type.
pub function (s: LowerState) mark_opt_type(i: i32, t: string): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type.with(i, t), local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: s.ctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}

// opt_type_of_slot returns slot i's recorded Option/Result type, or "".
pub function (s: LowerState) opt_type_of_slot(i: i32): string {
    if (i < 0 || i >= s.local_opt_type.len()) { return ""; }
    return s.local_opt_type[i];
}

// mark_tuple_elems records slot i's comma-joined tuple element-type tags.
pub function (s: LowerState) mark_tuple_elems(i: i32, t: string): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems.with(i, t), local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: s.ctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}

// tuple_elem_tag returns slot i's Nth tuple element-type tag, or "".
pub function (s: LowerState) tuple_elem_tag(i: i32, n: i32): string {
    if (i < 0 || i >= s.local_tuple_elems.len()) { return ""; }
    var enc: string = s.local_tuple_elems[i];
    if (enc.len() == 0) { return ""; }
    var idx: i32 = 0;
    var start: i32 = 0;
    var k: i32 = 0;
    while (k <= enc.len()) {
        if (k == enc.len() || enc[k] == 44) {   // 44 = ','
            if (idx == n) { return enc[start : k]; }
            idx = idx + 1;
            start = k + 1;
        }
        k = k + 1;
    }
    return "";
}

// csv_nth returns the Nth comma-separated field of `enc` (0-based), or "".
pub function csv_nth(enc: string, n: i32): string {
    if (enc.len() == 0) { return ""; }
    var idx: i32 = 0;
    var start: i32 = 0;
    var k: i32 = 0;
    while (k <= enc.len()) {
        if (k == enc.len() || enc[k] == 44) {   // 44 = ','
            if (idx == n) { return enc[start : k]; }
            idx = idx + 1;
            start = k + 1;
        }
        k = k + 1;
    }
    return "";
}

// expr_tuple_elem_tag returns the type tag of element N of a tuple expression
// (`t` an ident with tracked element types), or "".
pub function expr_tuple_elem_tag(e: parser.Expr, n: i32, s: LowerState): string {
    match (e) {
        parser.ExprIdent(id) => { return s.tuple_elem_tag(s.slot_of(id.name), n); },
        _ => { return ""; }
    }
    return "";
}

// elem_type_tag computes the type tag of an expression for tuple-element typing:
// "string" for a string, a struct type name for a struct, else "i32" (scalar).
pub function elem_type_tag(e: parser.Expr, s: LowerState): string {
    if (expr_is_str(e, s)) { return "string"; }
    var st: string = expr_struct_type(e, s);
    if (st != "") { return st; }
    return "i32";
}

pub function (s: LowerState) mark_map_type(i: i32, t: string): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type.with(i, t), local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, ctrl: s.ctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, i64_ret_fns: s.i64_ret_fns, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, n_params: s.n_params, ok: s.ok };
}
pub function (s: LowerState) map_type_of(i: i32): string {
    if (i < 0 || i >= s.local_map_type.len()) { return ""; }
    return s.local_map_type[i];
}

