// tuple_elem_tag returns slot i's Nth tuple element-type tag, or "".
pub function (s: LowerState) tuple_elem_tag(i: i32, n: i32): string {
    if (i < 0 || i >= s.local_tuple_elems.len()) { return ""; }
    var enc: string = s.local_tuple_elems[i];
    if (enc.len() == 0) { return ""; }
    var idx: i32 = 0;
    var start: i32 = 0;
    var k: i32 = 0;
    while (k <= enc.len()) {
        if (k == enc.len() || enc[k] == 44) {   // 44 = ','
            if (idx == n) { return enc[start : k]; }
            idx = idx + 1;
            start = k + 1;
        }
        k = k + 1;
    }
    return "";
}

// csv_nth returns the Nth comma-separated field of `enc` (0-based), or "".
pub function csv_nth(enc: string, n: i32): string {
    if (enc.len() == 0) { return ""; }
    var idx: i32 = 0;
    var start: i32 = 0;
    var k: i32 = 0;
    while (k <= enc.len()) {
        if (k == enc.len() || enc[k] == 44) {   // 44 = ','
            if (idx == n) { return enc[start : k]; }
            idx = idx + 1;
            start = k + 1;
        }
        k = k + 1;
    }
    return "";
}

// expr_tuple_elem_tag returns the type tag of element N of a tuple expression
// (`t` an ident with tracked element types), or "".
pub function expr_tuple_elem_tag(e: parser.Expr, n: i32, s: LowerState): string {
    match (e) {
        parser.ExprIdent(id) => { return s.tuple_elem_tag(s.slot_of(id.name), n); },
        _ => { return ""; }
    }
    return "";
}

// literal_is_i64 reports whether a non-negative integer literal text is too big
// for i32 (so it is an i64 value): >10 digits always, exactly 10 digits if it
// exceeds i32-max "2147483647". (Negative literals are unary minus over a
// positive literal, so the sign is handled separately.)
pub function literal_is_i64(text: string): boolean {
    var n: i32 = text.len();
    if (n > 10) { return true; }
    if (n < 10) { return false; }
    var m: string = "2147483647";
    var i: i32 = 0;
    while (i < 10) {
        if (text[i] > m[i]) { return true; }
        if (text[i] < m[i]) { return false; }
        i = i + 1;
    }
    return false;
}

// fn_value_arg_name returns the function name if `e` is a bare identifier that
// names no local (so it refers to a top-level function — a function-value
// candidate), else "". The caller pairs this with callee_param_is_fn to confirm
// the argument position actually expects a function value.
pub function fn_value_arg_name(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprIdent(id) => {
            if (s.slot_of(id.name) < 0) { return id.name; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// elem_type_tag computes the type tag of an expression for tuple-element typing:
// "string" for a string, a struct type name for a struct, "i64"/"f64" for an
// 8-byte scalar, else "i32" (scalar). The 8-byte tags drive the wasm tuple's
// per-element i64.store/load vs f64.store/load (and route i64 through lower_i64).
pub function elem_type_tag(e: parser.Expr, s: LowerState): string {
    if (expr_is_str(e, s)) { return "string"; }
    var st: string = expr_struct_type(e, s);
    if (st != "") { return st; }
    if (expr_is_f64(e, s)) { return "f64"; }
    if (infer_expr_width(e, s) == 64) { return "i64"; }
    // A bare integer literal too big for i32 is an i64 (an i64-typed local /
    // expr is already caught by infer_expr_width above).
    match (e) {
        parser.ExprNumber(num) => { if (!num.is_float && literal_is_i64(num.text)) { return "i64"; } },
        _ => {}
    }
    return "i32";
}

