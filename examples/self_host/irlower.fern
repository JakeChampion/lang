// tuple_elem_tag returns slot i's Nth tuple element-type tag, or "".
pub function (s: LowerState) tuple_elem_tag(i: i32, n: i32): string {
    if (i < 0 || i >= s.local_tuple_elems.len()) { return ""; }
    var enc: string = s.local_tuple_elems[i];
    if (enc.len() == 0) { return ""; }
    var idx: i32 = 0;
    var start: i32 = 0;
    var k: i32 = 0;
    while (k <= enc.len()) {
        if (k == enc.len() || enc[k] == 44) {   // 44 = ','
            if (idx == n) { return enc[start : k]; }
            idx = idx + 1;
            start = k + 1;
        }
        k = k + 1;
    }
    return "";
}

// csv_nth returns the Nth comma-separated field of `enc` (0-based), or "".
pub function csv_nth(enc: string, n: i32): string {
    if (enc.len() == 0) { return ""; }
    var idx: i32 = 0;
    var start: i32 = 0;
    var k: i32 = 0;
    while (k <= enc.len()) {
        if (k == enc.len() || enc[k] == 44) {   // 44 = ','
            if (idx == n) { return enc[start : k]; }
            idx = idx + 1;
            start = k + 1;
        }
        k = k + 1;
    }
    return "";
}

// expr_tuple_elem_tag returns the type tag of element N of a tuple expression
// (`t` an ident with tracked element types), or "".
pub function expr_tuple_elem_tag(e: parser.Expr, n: i32, s: LowerState): string {
    match (e) {
        parser.ExprIdent(id) => { return s.tuple_elem_tag(s.slot_of(id.name), n); },
        // `p.t.N` where `t` is a tuple struct field — element n's tag from the
        // field's tuple type string.
        parser.ExprFieldAccess(fa) => {
            var oty: string = expr_struct_type(fa.obj, s);
            if (oty == "") { return ""; }
            return tuple_type_elem_tag(decl_field_type(s.structs, oty, fa.field), n);
        },
        _ => { return ""; }
    }
    return "";
}

// literal_is_i64 reports whether a non-negative integer literal text is too big
// for i32 (so it is an i64 value): >10 digits always, exactly 10 digits if it
// exceeds i32-max "2147483647". (Negative literals are unary minus over a
// positive literal, so the sign is handled separately.)
pub function literal_is_i64(text: string): boolean {
    var n: i32 = text.len();
    if (n > 10) { return true; }
    if (n < 10) { return false; }
    var m: string = "2147483647";
    var i: i32 = 0;
    while (i < 10) {
        if (text[i] > m[i]) { return true; }
        if (text[i] < m[i]) { return false; }
        i = i + 1;
    }
    return false;
}

// fn_value_arg_name returns the function name if `e` is a bare identifier that
// names no local (so it refers to a top-level function — a function-value
// candidate), else "". The caller pairs this with callee_param_is_fn to confirm
// the argument position actually expects a function value.
pub function fn_value_arg_name(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprIdent(id) => {
            if (s.slot_of(id.name) < 0) { return id.name; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// ident_is_fn_value reports whether a bare ident lowers to a function VALUE
// (op_const_func) rather than a local load / `None` / unit-variant box / const
// call — i.e. it names a top-level function WITH params. Mirrors the ExprIdent
// lowering's const_func fall-through (so a tuple-element tag matches what the
// element actually emits): not a local slot, not `None`, not a struct / unit
// variant name, and not a const (a 0-arg receiver-less fn). const_funcs_only_known
// still backstops a bogus name — if the tag says "fn" the element emits a
// const_func, and an unknown function bails the whole module either way.
pub function ident_is_fn_value(name: string, s: LowerState): boolean {
    if (s.slot_of(name) >= 0) { return false; }
    if (name == "None") { return false; }
    if (decl_is_struct(s.structs, name)) { return false; }
    if (s.is_const_fn(name)) { return false; }
    return true;
}

// elem_type_tag computes the type tag of an expression for tuple-element typing:
// expr_opt_elem_tag returns the COMMA-FREE Option type spelling of a tuple
// element that is an Option value (`Some(7)` → "Option[i32]", `Some("x")` →
// "Option[string]"), or "" otherwise. Comma-free is required because the tuple-
// element tag encoding (mark_tuple_elems / tuple_elem_tag) splits on commas, so
// `Result[T, E]` (which has one) is deliberately NOT recovered here — a Result
// element stays on the AST path (#3018). Only a `Some(<scalar/string>)`
// construction or an Option-typed local/param is admitted (a leak-only box, one
// pointer slot, like a struct element); a `None` with no statically-known
// payload, or a nested Option, falls through to "".
pub function expr_opt_elem_tag(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "Some" && c.args.len() == 1) {
                        var pt: string = elem_type_tag(c.args[0], s);
                        if (pt == "i32" || pt == "string" || pt == "i64" || pt == "f64" || pt == "boolean") {
                            return "Option[" + pt + "]";
                        }
                        return "";
                    }
                    var rt: string = s.opt_ret_type(cid.name);
                    if (rt.len() >= 8 && rt[0:7] == "Option[") { return rt; }
                    return "";
                },
                _ => { return ""; }
            }
        },
        parser.ExprIdent(id) => {
            var ot: string = s.opt_type_of_slot(s.slot_of(id.name));
            if (ot.len() >= 8 && ot[0:7] == "Option[") { return ot; }
            return "";
        },
        _ => { return ""; }
    }
    return "";
}

// some_opt_type returns the "Option[T]" type of a DIRECT `Some(x)` construction
// whose payload type T is statically recoverable (scalar / string / struct), or
// "" otherwise. Lets a `var o = Some(7)` local record its opt_type and a direct
// `match (Some(7))` scrutinee recover the payload — the construction analogue of
// the call-returns-Option path (opt_ret_fns). `Ok`/`Err` are NOT handled: a
// direct `Ok(x)` can't determine the Result's `E` arm (it needs an annotation,
// handled separately). A nested-OPTION payload (`Some(Some(5))` →
// "Option[Option[i32]]") IS recovered — the StmtMatch payload binding marks the
// inner Option type (mark_opt_type) so a nested `match (b)` resolves it. A
// nested-RESULT payload (whose type spelling carries a comma) and a fn payload
// are deferred ("").
pub function some_opt_type(e: parser.Expr, s: LowerState): string {
    match (e) {
        parser.ExprCall(c) => {
            match (c.callee) {
                parser.ExprIdent(cid) => {
                    if (cid.name == "Some" && c.args.len() == 1) {
                        var pt: string = elem_type_tag(c.args[0], s);
                        if (pt == "fn") { return ""; }
                        if (pt.len() >= 7 && pt[0:7] == "Result[") { return ""; }
                        return "Option[" + pt + "]";
                    }
                    return "";
                },
                _ => { return ""; }
            }
        },
        _ => { return ""; }
    }
    return "";
}

// opt_recv_base_type returns "Option" / "Result" if `e` is an Option/Result
// VALUE — an opt-typed local/param, a direct `Some(x)`, or an Option/Result-
// returning free call — else "". It's the dispatch base for an Option/Result-
// RECEIVER method (`Some(5).map(...)` / `r.map(...)`): the method is keyed
// "Option.<m>" / "Result.<m>" (base_type_name of the receiver type), so a
// `var x = <opt>.m()` binding or a `match (<opt>.m())` scrutinee recovers the
// result's Option/Result type via opt_ret_type. #3049.
pub function opt_recv_base_type(e: parser.Expr, s: LowerState): string {
    var t: string = "";
    match (e) {
        parser.ExprIdent(id) => { t = s.opt_type_of_slot(s.slot_of(id.name)); },
        // `b.v` where `v` is an Option/Result struct field, or `t.N` where the
        // tuple element is an Option/Result — lets `b.v.uo(...)` / `match (b.v)`
        // dispatch on the field value (#3069).
        parser.ExprFieldAccess(fa) => {
            if (util.is_all_digits(fa.field)) {
                var tt: string = expr_tuple_elem_tag(fa.obj, util.digits_to_i32(fa.field), s);
                if (tt.len() >= 8 && (tt[0:7] == "Option[" || tt[0:7] == "Result[")) { t = tt; }
            } else {
                var foty: string = expr_struct_type(fa.obj, s);
                if (foty != "") {
                    var fft: string = decl_field_type(s.structs, foty, fa.field);
                    if (fft.len() >= 8 && (fft[0:7] == "Option[" || fft[0:7] == "Result[")) { t = fft; }
                }
            }
        },
        parser.ExprCall(c) => {
            t = some_opt_type(e, s);
            if (t == "") {
                match (c.callee) {
                    parser.ExprIdent(cid) => { t = s.opt_ret_type(cid.name); },
                    // `b.find()` where b's method returns Option/Result — keyed
                    // "<Type>.<method>" (struct receiver) or "Option.<m>" /
                    // "Result.<m>" (an Option/Result-receiver method, recursively).
                    // Lets a chained `b.find().map(...)` recover the inner result
                    // (#3066).
                    parser.ExprFieldAccess(cfa) => {
                        var mrty: string = expr_struct_type(cfa.obj, s);
                        if (mrty != "") { t = s.opt_ret_type(mrty + "." + cfa.field); }
                        else {
                            var mrb: string = opt_recv_base_type(cfa.obj, s);
                            if (mrb != "") { t = s.opt_ret_type(mrb + "." + cfa.field); }
                            // An ENUM-receiver method returning Option/Result, called
                            // on a fresh variant (`V(7).get()`) — key "<Enum>.<m>"
                            // via the variant's enum_owner (#3076).
                            else {
                                var men: string = expr_enum_type(cfa.obj, s);
                                if (men != "") { t = s.opt_ret_type(men + "." + cfa.field); }
                            }
                        }
                    },
                    _ => {}
                }
            }
        },
        _ => {}
    }
    if (t.len() >= 7 && t[0:7] == "Option[") { return "Option"; }
    if (t.len() >= 7 && t[0:7] == "Result[") { return "Result"; }
    return "";
}

// "string" for a string, a struct type name for a struct, "fn" for a function
// value, "Option[T]" for an Option value, "i64"/"f64" for an 8-byte scalar, else
// "i32" (scalar). The 8-byte tags drive the wasm tuple's per-element
// i64.store/load vs f64.store/load (and route i64 through lower_i64); "fn" lets
// `t.N(args)` recover the element's callability; "Option[T]" lets `match (t.N)`
// recover the payload.
pub function elem_type_tag(e: parser.Expr, s: LowerState): string {
    if (expr_is_str(e, s)) { return "string"; }
    // A bare fn-name element (`(inc, 5)`): a function VALUE (a plain fn pointer,
    // one slot), tagged "fn" so `t.N(args)` lowers to tuple_get + call_indirect.
    match (e) {
        parser.ExprIdent(fid) => { if (ident_is_fn_value(fid.name, s)) { return "fn"; } },
        _ => {}
    }
    // An Option element (`(Some(7), 3)`): tag "Option[T]" so a later
    // `match (t.N)` recovers the payload type (a leak-only pointer slot).
    var optag: string = expr_opt_elem_tag(e, s);
    if (optag != "") { return optag; }
    var st: string = expr_struct_type(e, s);
    if (st != "") { return st; }
    if (expr_is_f64(e, s)) { return "f64"; }
    if (infer_expr_width(e, s) == 64) { return "i64"; }
    // A bare integer literal too big for i32 is an i64 (an i64-typed local /
    // expr is already caught by infer_expr_width above).
    match (e) {
        parser.ExprNumber(num) => { if (!num.is_float && literal_is_i64(num.text)) { return "i64"; } },
        _ => {}
    }
    return "i32";
}

