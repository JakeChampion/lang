// array (8-byte element width on wasm). The element-width driver for a[i].
pub function (s: LowerState) is_f64arr_slot(i: i32): boolean {
    if (i < 0 || i >= s.local_is_f64arr.len()) { return false; }
    return s.local_is_f64arr[i];
}
