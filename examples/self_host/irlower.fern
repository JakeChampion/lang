function reclaimable_arrenum(aens: string[], body: ast.Stmt[], borrowable: string[], msites: string[], recv_borrow: string[], structs: parser.StructDecl[], out: string[]): string[] {
var aeni: i32 = 0;
while (aeni < aens.len()) {
    // The entry is "<site key>#<Enum>"; the site key half is what the credit is
    // keyed on and the bare name is what the gates ask about. A site key cannot
    // contain '#', so the split is unambiguous either way.
    var aesite: string = arrenum_entry_name(aens[aeni]);
    var aename: string = reclaim_site_name(aesite);
    // "A|" rows are append-BUILT markers, not candidates. The marked entry
    // takes the same "ARRENUM:" credit — the release path is identical and
    // emit_arrenum_reclaim_store is already cow-guarded — but the two blunt
    // gates have to sanction the self-append rebind, which is the one
    // reassignment and the one non-`len()` use the class permits.
    // ONE pair of gates for both the literal/producer and the append-built
    // candidate. The append exception costs the former nothing — a candidate
    // that is not append-built has no reassignment at all, because the
    // collector's `reassigned` check already refused it — so the two paths
    // that used to be branched here answer identically, and branching them
    // only risked their exceptions drifting apart.
    var aeenum: string = arrenum_entry_enum(aens[aeni]);
    var aeblocked: boolean = arrenum_append_escapes(body, aename, structs, aeenum, msites, false, borrowable)
        || arrenum_append_unsafe_for(body, aename, borrowable, recv_borrow, structs, aeenum, msites)
        || arrenum_share_holder_respread(body, aename, structs, msites, borrowable);
    if (!(aens[aeni].len() > 2 && aens[aeni][0] == b'A' && aens[aeni][1] == b'|')
        && aesite.len() > 0 && !aeblocked) {
        out = out.append("ARRENUM:" + aens[aeni]);
    }
    aeni = aeni + 1;
}

    return out;
}

function reclaimable_structarr(body: ast.Stmt[], borrowable: string[], fresh_ret: string[], sarrs2: string[], out: string[]): string[] {
var sa2i: i32 = 0;
while (sa2i < sarrs2.len()) {
    // NOT excluded on `reassigned` any more (#6127) — the self-append rebind
    // IS a reassignment, and the blunt exclusion left every append-built
    // struct array leaking one element box per append.
    // structarr_unsafe_for validates each rebind individually and is
    // otherwise body_unsafe_for, so it subsumes both former checks.
    // "A|" rows are append-BUILT markers, not candidates.
    // As above: site keys, with the "A|" marker riding the same key.
    var sanm: string = reclaim_site_name(sarrs2[sa2i]);
    if (!(sarrs2[sa2i].len() > 2 && sarrs2[sa2i][0] == b'A' && sarrs2[sa2i][1] == b'|')
        && !structarr_unsafe_for(body, sanm, borrowable, fresh_ret)
        && !structarr_elem_escapes(body, sanm, borrowable)) {
        // Append-built candidates take the SEPARATE STRUCTARRA: credit,
        // which slot_is_reclaimable_structarr additionally gates on the
        // element struct being all-scalar (#6127 / #6129). Literal-built
        // ones keep the original credit and the original, looser rule, so
        // their emitted code is unchanged.
        if (util.index_of_str(sarrs2, "A|" + sarrs2[sa2i]) >= 0) {
            out = out.append("STRUCTARRA:" + sarrs2[sa2i]);
        } else {
            out = out.append("STRUCTARR:" + sarrs2[sa2i]);
        }
    }
    sa2i = sa2i + 1;
}

    return out;
}

function reclaimable_dyn_struct(body: ast.Stmt[], borrowable: string[], dyns: string[], reassigned: string[], recv_borrow: string[], out: string[]): string[] {
var dyi: i32 = 0;
while (dyi < dyns.len()) {
    var dentry: string = dyns[dyi];
    var dbar: i32 = 0;
    while (dbar < dentry.len() && dentry[dbar] != b'|') { dbar = dbar + 1; }
    // The entry is "<site key>|<Concrete>"; the key half is what the credit is
    // keyed on and the bare name is what the gates ask about. A site key
    // contains no '|', so the split is unambiguous either way.
    var dsite: str = slice_unchecked(dentry, 0, dbar);
    var dname: string = reclaim_site_name(dsite + "");
    if (dsite.len() > 0
        && util.index_of_str(reassigned, dname) < 0
        && !body_unsafe_for(body, dname, borrowable, recv_borrow)) {
        if (dbar + 1 >= dentry.len()) { out = out.append("DYNCAND:" + dsite); }
        else { out = out.append("DYN:" + dentry); }
    }
    dyi = dyi + 1;
}

    return out;
}

function reclaimable_dyn_arr(body: ast.Stmt[], borrowable: string[], darrs: string[], reassigned: string[], out: string[]): string[] {
var dai: i32 = 0;
while (dai < darrs.len()) {
    var daentry: string = darrs[dai];
    var dabar: i32 = 0;
    while (dabar < daentry.len() && daentry[dabar] != b'|') { dabar = dabar + 1; }
    // The entry is "<site key>|<kinds>"; the key half is what the credit is keyed
    // on and the bare name is what the gates ask about, which is the same split
    // reclaimable_dyn_struct makes for "DYN:".
    var dasite: str = slice_unchecked(daentry, 0, dabar);
    var daname: string = reclaim_site_name(dasite + "");
    if (dasite.len() > 0
        && util.index_of_str(reassigned, daname) < 0
        && !darr_unsafe_for(body, daname, borrowable)) { out = out.append("DARR:" + daentry); }
    dai = dai + 1;
}

    return out;
}

function reclaimable_fresh_struct(asrows: string[], body: ast.Stmt[], borrowable: string[], fresh: string[], handback: string[], msites: string[], plan_fe: string[], plan_on: boolean, recv_borrow: string[], structs: parser.StructDecl[], out: string[]): string[] {
var i: i32 = 0;
while (i < fresh.len()) {
    // Borrow-AWARE escape gate (the same predicate the array reclaim uses in
    // precise_drop_names): a fresh struct local is reclaim-safe unless it is
    // used UNSAFELY — returned, stored into a container, passed to a
    // non-borrowable param, sliced, etc. Unlike the older crude
    // walk_stmts_escapes, a method RECEIVER (`s = s.emit(op)`) and a
    // borrowable free-call arg (`s = f(s)`) count as BORROWS, not escapes —
    // so the builder-threaded EmitState/LowerState (`s = s.method(...)`, the
    // dominant per-module pattern) becomes reclaimable. The reassign frees the
    // old box with a cow-guarded, rc-guarded SHALLOW arr_dec (emit_arr_store)
    // and the final value with the end-of-scope sweep — both box-only, so the
    // builder's shared field pointers (carried into the new box without an
    // inc) keep rc==1 across the chain and are freed exactly once at the last
    // box's death. A `return s` still flags `s` unsafe (escapes), so a
    // returned builder is never reclaimed. (#3456 — escaping-struct reclaim.)
    // Also exclude locals reassigned from an ALIAS (`lam = l` / `= x.f` /
    // `= xs[i]`): after the rebind they hold a BORROW, so reclaiming them
    // would free memory the aliased container still owns (#3425 stage-2).
    // The borrow reading of a method RECEIVER above is only good while no
    // method HANDS THE RECEIVER BACK into something longer-lived — see
    // recv_borrow_escapes_via_result. Without that gate `keep = b.me()`
    // left `keep` on b's own box and b's per-rebind reclaim freed it
    // underneath, which is an over-release rather than a leak.
    // `fresh` holds BINDING-SITE keys; every gate below asks about the
    // VARIABLE, so each takes the bare name back out of the key.
    var fnm: string = reclaim_site_name(fresh[i]);
    // #7282: a plain `var v: T = t` alias shares the box, so it shares the
    // credit — and the bind retained it, gated on slot_is_reclaimable_struct
    // so the retain and the credit are the same set.
    //
    // That gate is the CREDIT predicate rather than a type test, which is the
    // whole of #7368. The reverted clause asked `struct_type_of_slot`, a
    // type-NAME carrier that is also set for enum names, dyn tags, "clo", the
    // ELEMENT type of a struct/enum array — and, as the crash showed, for
    // slots holding plain SCALARS. `__fern_i32_to_string` binds the negated
    // input, so on INT_MIN the slot held 0x80000000: non-zero, even, above
    // 0x10000, past every __fern_rc_inc guard, dereferencing 0x7FFFFFF8.
    var sal: string[] = alias_chain_sites_of(body, fnm, borrowable, recv_borrow, body, []);
    // Step-2 routing, struct family: the ESCAPE conjunct is the plan's
    // per-site verdict (free_eligible_sites_of; the alias forgiveness is
    // the plan's own #7282 arithmetic, sound because the struct alias
    // bind retains — credit-keyed at lower_stmt_var's ExprIdent arm, so
    // the pair stays co-extensive by construction). The other conjuncts
    // are family knowledge the plan does not carry: the alias-rebind
    // borrow flag and the receiver-handed-back gates.
    var st_esc_ok: boolean = false;
    // The plan's counted-sink forgiveness (#7345) is TAKEN for the struct
    // family, which is what retires the sink refusal this gate used to
    // carry. The refusal's stated condition was the release protocol, not
    // the analysis: a counted sink retains, so the source keeps a claim
    // nothing released, but two owners each running the struct release
    // meant two deep field walks — measured as exit 99 on append-rebind.
    // The exit sweep now releases through emit_struct_field_drops_gated,
    // so the field walk runs only for the owner that finds rc 1 and the
    // box dec is what hands the last one its turn. With that in place the
    // struct row of the construction-retain matrix is clean end to end.
    // Native agrees on the analysis half too: a StructLit / TupleLit slot
    // is an INC-ing sink there and does not taint its source.
    if (plan_on) {
        st_esc_ok = util.index_of_str(plan_fe, fresh[i]) >= 0
            && !struct_box_sink_stored_stmts(body, fnm, structs, asrows, msites);
    }
    else { st_esc_ok = !body_unsafe_for_alias(body, fnm, borrowable, recv_borrow, sal); }
    // The bare-assigned-SOURCE refusal is lifted for a counted alias reassign.
    // Its header named the precondition itself — "family knowledge until
    // assignments carry the co-extensive retain" — and lower_stmt_assign now
    // carries it, keyed on the "ALIASSRC:" row this branch emits.
    var bas_ok: boolean = !struct_bare_assigned_src(body, fnm)
        || bare_assign_targets_all_fresh(body, fnm, fresh);
    if (st_esc_ok && !reassigned_from_alias(body, fnm)
        && bas_ok
        && !struct_returned_bare(body, fnm)
        && !struct_arg_to_handback(body, fnm, handback)
        && !recv_borrow_escapes_via_result(recv_borrow, declared_struct_type_of(body, fnm, structs), body, fnm, borrowable)
        && !recv_borrow_escapes_via_result(recv_borrow, fresh_struct_lit_type_deep(body, fnm), body, fnm, borrowable)) {
        out = out.append(fresh[i]);
        // THE ALIAS TAKES A BOX-ONLY RELEASE, NEVER THE DEEP ONE. A struct's
        // release is a DEEP FIELD DROP plus a box dec, and only the box was
        // retained at the bind. Two deep drops free every field buffer twice:
        // measured as exit 99 on `var t: P = P { xs: [..] }; var v: P = t;`,
        // with allocs == frees at live_bytes 0, so only the underflow counter
        // dissented.
        //
        // "NODEEP:" is exactly the marker for "keep this slot's free BOX-ONLY"
        // (#3425), so the alias takes the box dec and the source keeps the one
        // field walk. The box is freed once at rc 0 whichever sweep runs last,
        // and the fields are dropped exactly once.
        //
        // This is the per-type difference the array, tuple and string classes
        // do not have: their release IS the box dec, so sharing the credit
        // shares the whole release.
        out = credit_alias_sites(out, "", sal);
        out = credit_alias_sites(out, "NODEEP:", sal);
        // "SINKSHARE:" marks the names this gate admits BECAUSE their box is
        // a counted share at a struct-literal field — the class the sink
        // refusal used to reject wholesale. Only they take the rc-gated field
        // walk at the sweep; every other struct slot keeps the STATIC role
        // pairing above (source deep, alias box-only), which is measured and
        // must not move. Gating those too breaks them in both directions: with
        // the NODEEP alias in place nothing walks the fields (a leak on
        // struct_alias_in_a_conditional), and without it two owners walk them
        // (exit 99 on the same shape).
        if (struct_counted_share_stmts(body, fnm, structs)) {
            out = out.append("SINKSHARE:" + fresh[i]);
        }
        // A forgiven bare-assign SOURCE hands its box on as a COUNTED share, so
        // both owners reach the release and the field walk must be rc-gated for
        // the same reason the struct-literal sink is: two static deep walks free
        // every buffer twice (exit 99).
        if (struct_bare_assigned_src(body, fnm)) {
            out = out.append("ALIASSRC:" + fresh[i]);
            if (util.index_of_str(out, "SINKSHARE:" + fresh[i]) < 0) {
                out = out.append("SINKSHARE:" + fresh[i]);
            }
        }
    }
    i = i + 1;
}

    return out;
}

function reclaimable_alias_sink_share(body: ast.Stmt[], borrowable: string[], fresh: string[], recv_borrow: string[], out: string[]): string[] {
var ai2: i32 = 0;
while (ai2 < fresh.len()) {
    var anm: string = reclaim_site_name(fresh[ai2]);
    if (util.index_of_str(out, fresh[ai2]) < 0
            && reassigned_from_alias(body, anm)
            && alias_reassign_sources_counted(body, anm, out)
            && !struct_returned_bare(body, anm)
            && !body_unsafe_for_alias(body, anm, borrowable, recv_borrow,
                   alias_bind_sites_of(body, anm, borrowable, recv_borrow, body, []))) {
        out = out.append(fresh[ai2]);
        out = out.append("SINKSHARE:" + fresh[ai2]);
    }
    ai2 = ai2 + 1;
}

    return out;
}

function tup_ok_from_tuple_credits(out: string[], tup_ok: string[]): string[] {
var tprc: i32 = 0;
while (tprc < out.len()) {
    if (out[tprc].len() > 6 && slice_unchecked(out[tprc], 0, 6) == "TUPRC:") {
        tup_ok = tup_ok.append("TUP:" + slice_unchecked(out[tprc], 6, out[tprc].len()));
    }
    // #7226 string limb: a string local at a BARE-IDENT element of a tuple
    // this pass credited "TUPELEMOK:" is likewise no longer an escape — the
    // element release gives the construction retain back, so the local's own
    // box reaches 0. Without this the string never earned "STR:" and its box
    // was never swept: inc 1, dec 0, 32 B/round unbounded. See the ExprTuple
    // arm of body_unsafe_for_tup.
    if (out[tprc].len() > 10 && slice_unchecked(out[tprc], 0, 10) == "TUPELEMOK:") {
        tup_ok = tup_ok.append("TUPE:" + slice_unchecked(out[tprc], 10, out[tprc].len()));
    }
    // The writer agreement rides across too: it is what decides whether a
    // STRING position's release is emitted at all, and the assign-form
    // interlock in body_unsafe_for_tup_alias may only forgive an element whose
    // release it can count on.
    if (out[tprc].len() > 8 && slice_unchecked(out[tprc], 0, 8) == "TUPSTRW:") {
        tup_ok = tup_ok.append("TUPSW:" + slice_unchecked(out[tprc], 8, out[tprc].len()));
    }
    tprc = tprc + 1;
}

    return tup_ok;
}
