    // arm64 lower it.
    if (cid.name == "read_file" && c.args.len() == 1) {
        var rfs: LowerState = lower_expr(c.args[0], s);
        if (!rfs.ok) { return rfs; }
        return rfs.emit(ir.op_read_file());
    }
    // Built-in `read_file_bytes(path)` — read_file's raw sibling: push a
