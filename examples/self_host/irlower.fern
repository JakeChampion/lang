    // display_arg; `print_str` is the internal string-only spelling and
    // takes its argument as it stands.
    if (cid.name == "print_str" && c.args.len() == 1) {
        var pss: LowerState = lower_expr(c.args[0], s);
        if (!pss.ok) { return pss; }
        return pss.emit(ir.op_print_str());
    }
    if (cid.name == "write" && c.args.len() == 1) {
        var wss: LowerState = lower_expr(display_arg(c.args[0], c.line, c.col, s), s);
        if (!wss.ok) { return wss; }
        return wss.emit(ir.op_print_str());
    }
    if (cid.name == "print" && c.args.len() == 1) {
        var prs: LowerState = lower_expr(display_arg(c.args[0], c.line, c.col, s), s);
