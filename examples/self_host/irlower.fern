// examples/self_host/irlower.fern — AST -> stack-IR lowering for the
// self-hosted compiler (slice 2 of the IR rebuild, see
// docs/RC-PERCEUS-SELF-HOST-IR-REBUILD.md), plus a stack-machine
// interpreter that evaluates the lowered Op[] so lowering is checkable
// end-to-end WITHOUT a backend (mirrors how ssa.fern validates its builder
// with an SSA interpreter).
//
// SCOPE (slice 2): the straight-line i32 subset — params, `var` / `=`
// locals, integer / bool literals, the binary + unary operators, and
// `return`. This is the IR analogue of ssa.fern's slice-1 subset. Anything
// outside it (control flow, calls, strings, floats, composites) makes
// lower_func return ok=false, so the driver can fall back / report a bail.
// Control flow (block/loop/if/br) + calls land in later slices, mirroring
// the native builder's expression/statement lowering.
//
// The lowering is a textbook stack-machine emit: an expression lowers to
// ops that PUSH its value (operands first, then the operator), a `var`
// binds the next local slot and stores into it, `return` lowers its value
// then emits `return`. Params occupy slots 0..n_params-1.

import "./ir";
import "./parser";
import "./util";
import "./astwalk";

// LowerState threads the accumulated Op[] and the local-slot table
// (slot i -> name) immutably, in the self-host style. `n_params` records
// the borrow boundary the later RC slices need; `ok` latches a bail.
pub struct LowerState {
    ops: ir.Op[],
    local_names: string[],
    // local_is_arr[i] marks slot i as holding an array value (drives the
    // Perceus alias-inc: a new reference to an array must retain it).
    local_is_arr: boolean[],
    // local_is_str[i] marks slot i as holding a string value — used for type
    // dispatch only (str_len vs arr_len, str_concat vs add, str_eq vs eq).
    // Strings are not reference-counted, so this drives no RC; it just keeps
    // string slots out of the array machinery and selects the string opcodes.
    local_is_str: boolean[],
    // local_is_strarr[i] marks slot i as holding a string[] array (alongside
    // local_is_arr, which still drives the array's RC). It only affects element
    // typing: arr[i] on a string[] yields a string (str_len etc.), while the
    // array itself is rc-tracked like any array and its string elements leak.
    local_is_strarr: boolean[],
    // local_struct_type[i] holds the struct type name of slot i (""=not a
    // struct), so `p.x` resolves x's field index in p's decl. Like local_is_str,
    // dispatch-only — the scalar-field structs this slice covers are leak-only.
    local_struct_type: string[],
    // local_opt_type[i] holds the Option[T]/Result[T,E] type string of slot i
    // (""=not an Option/Result), set when `var r = f()` binds an Option/Result-
    // returning call (or for an Option/Result param). Lets a `match (r)` on a
    // local recover the bound payload type, the same way a direct-call scrutinee
    // uses opt_ret_fns.
    local_opt_type: string[],
    // local_tuple_elems[i] holds slot i's tuple element-type tags, comma-joined
    // (e.g. "string,i32,Point"), "" if not a tuple. Lets `t.N` and a tuple
    // destructure recover each element's type for dispatch.
    local_tuple_elems: string[],
    local_map_type: string[],
    // local_is_i64[i] marks slot i as holding an i64 value (drives i64
    // instruction selection + wasm i64 local typing). i32 stays the default.
    local_is_i64: boolean[],
    // local_is_f64[i] marks slot i as holding an f64 value (drives float
    // instruction selection: arithmetic / comparison use the float registers).
    // The slot itself is an 8-byte bit pattern like any value; only the ops on
    // it differ. i32 stays the default.
    local_is_f64: boolean[],
    // local_is_f64arr[i] marks slot i as holding an f64[] array (alongside
    // local_is_arr, which still drives the array's RC). It only affects element
    // WIDTH: a[i] on an f64-array slot reads an 8-byte f64 (arr_get width 64,
    // f64.load on wasm) and types as f64, and an f64 array literal allocates an
    // 8-byte-stride buffer. i32 / string[] arrays (4-byte wasm stride) stay the
    // default. The register backends already use 8-byte element slots, so this
    // only steers the wasm backend's element load/store width.
    local_is_f64arr: boolean[],
    // local_is_i64arr[i] marks slot i as holding an i64[] array. Like
    // local_is_f64arr it drives an 8-byte element stride, but a[i] reads an
    // 8-byte i64 (arr_get_i64 -> i64.load on wasm) and types as i64 (flowing
    // through lower_i64), and an i64 array literal stores i64 elements. i32 /
    // f64 / string[] arrays stay the default.
    local_is_i64arr: boolean[],
    // local_is_closurearr[i] marks slot i as holding a closure[] — an array of
    // function VALUES (closure boxes). a[i] yields a closure box, so a local
    // bound from such an element is marked a closure local (mark_closure_local)
    // and `c()` unpacks the box instead of calling the raw pointer as a table
    // index (which traps).
    local_is_closurearr: boolean[],
    // local_is_arrarr[i] marks slot i as holding an ARRAY-of-arrays (`i32[][]`,
    // `string[][]`, …). Its element `a[i]` is itself an array, so a local bound
    // from such an element — `var row = a[i]` or the loop var of `for row in a` —
    // is marked is_arr, which lets `for x in row` / `row` flow as an array source
    // (a plain `row[i]` / `row.len()` works without the flag; only ITERATING or
    // re-binding the inner array needs it). Set from a `T[][]` annotation or an
    // array-of-array literal (`[[…], …]`); a single nesting level (depth 2).
    local_is_arrarr: boolean[],
    // local_is_u32[i] marks slot i as holding a u32 value (scalar) OR a u32[]
    // array (disambiguated by local_is_arr). It drives u32 WRAPPING: arithmetic
    // whose result is u32 masks to 32 bits on the register backends, and a u32
    // `>>` lowers to a LOGICAL shift (shr_u). Native wraps every u32 op at 2^32;
    // without this the self-host kept 64-bit results, so u32-heavy code (the
    // SHA-256 schedule / __rotr `x << (32-n)`) accumulated stray high bits and
    // miscompiled. u8/u16 stay the default (their values are read 0..255/0..65535
    // and explicitly cast, so they need no post-arithmetic wrap).
    local_is_u32: boolean[],
    // local_is_u64[i] marks slot i as holding a u64 value (scalar) OR a u64[]
    // array. u64 lives in the i64 64-bit domain (alongside local_is_i64) but is
    // UNSIGNED: its `>`/`<`/… compare, `>>`, and `/`/`%` select the unsigned ops
    // (lt_u/shr_u/div_u/…) instead of the signed ones, which are wrong once bit
    // 63 is set (#2904). Unlike u32 there is no wrap step — i64-domain ops are
    // already full-width; only signedness differs.
    local_is_u64: boolean[],
    // ctrl: count of structured-control constructs (block/loop/if) currently
    // open at this point — auto-maintained in emit(). loop_blk: a stack holding,
    // per enclosing loop, the ctrl level just after that loop's exit-block opener
    // (the loop header sits one deeper). break = br(ctrl - top); continue =
    // br(ctrl - top - 1). Together they let break/continue compute relative br
    // depths through arbitrary if/match nesting.
    ctrl: i32,
    loop_blk: i32[],
    // ret_is_i64: this function returns i64 (so `return <i64expr>` lowers via
    // lower_i64). i64_ret_fns: names of module functions returning i64, so a
    // call to one is recognised as an i64 value (infer_expr_width / lower_i64).
    ret_is_i64: boolean,
    // ret_is_i64arr: does this function return i64[] (so `return [literal]`
    // lowers its elements as i64 via arr_make_i64, not the generic i32 path)?
    ret_is_i64arr: boolean,
    // ret_is_dyn: does this function return a SCALAR `dyn Trait` (NOT a
    // `dyn Trait[]` array)? When set, `return <expr>` coerces the value to
    // `dyn Trait` via lower_dyn_arg — a primitive/string is heap-boxed via
    // op_dyn_box so it carries a shape pointer, a struct/enum flows unboxed
    // (docs/DYN-TRAITS.md §4.3). Mirrors ret_is_i64 / ret_is_i64arr; set in
    // lower_func from fn.ret_type and threaded read-only.
    ret_is_dyn: boolean,
    i64_ret_fns: string[],
    // fn_param_sigs[k] = "callee|<flags>" where flag i is '1' if the callee's
    // param i is a function type ("fn"). Drives the type-directed function-VALUE
    // detection: a bare function-name ARGUMENT at a "fn" param position lowers to
    // const_func (a function pointer), not a call. (A const desugars to a zero-arg
    // function whose bare reference is otherwise a call, so the distinction must
    // be type-directed, mirroring asmcore.callee_param_is_fn.)
    fn_param_sigs: string[],
    // --- first-class (escaping) closures, slice 3a ---
    // cur_fn: the name of the function being lowered. An escaping capturing
    // ExprLambda in it is hoisted to `<cur_fn>$clo(__env, params…)`; lowering
    // the lambda emits const_func(<cur_fn>$clo) + the captures into a tuple box.
    cur_fn: string,
    // closure_fns: module functions whose body returns a closure box (a hoisted
    // escaping lambda). `var f = <call to one>` marks f as a closure local.
    closure_fns: string[],
    // const_fns: names of zero-arg, receiver-less module functions (a `const`
    // desugars to one). A bare ident reference to one — not a local — is a CALL
    // to it (the const's value), mirroring the AST backend's rule (asm.fern's
    // ExprIdent: zero-arg receiver-less fn -> call; >0-arg -> fn-value) (#2954).
    const_fns: string[],
    // closure_locals: names of locals currently holding a closure BOX (tuple
    // [funcval, caps…]) rather than a Slice-1 bare function value — so a call
    // `f(args)` dispatches to the env-passing closure-call form instead of the
    // plain call_indirect. A small list (grown only at closure bindings), not a
    // per-slot array.
    closure_locals: string[],
    // f64_ret_fns: names of free functions returning f64, so a call to one is
    // recognised as an f64 value (expr_is_f64). Without it an unannotated
    // `f(a) * g(b)` of two f64-returning calls would mis-select integer mul on
    // the float bits. Threaded read-only like i64_ret_fns.
    f64_ret_fns: string[],
    // f64arr_ret_fns: names of free functions returning f64[], so the call-site
    // binding `var x = f()` element-width-tracks x (is_f64arr), letting a later
    // x[i] read an 8-byte f64. Without it the result would be a generic array
    // and x[i] would mis-load 4 bytes off an 8-byte buffer. Read-only registry.
    f64arr_ret_fns: string[],
    // i64arr_ret_fns: names of free functions returning i64[], so `var x = f()`
    // element-types x as i64[] (is_i64arr) and a later x[i] reads an 8-byte i64
    // via lower_i64. Mirrors f64arr_ret_fns. Read-only registry.
    i64arr_ret_fns: string[],
    // structs: the module's struct decls, for field-index / field-order lookup
    // (constant across the lowering; threaded read-only).
    structs: parser.StructDecl[],
    // str_ret_fns: names of functions whose return type is `string`, so a
    // `var s = f()` (and `f().len()`) tracks the result as a string for op
    // dispatch. Strings aren't RC'd, so this is type tracking only. Threaded
    // read-only like structs; empty during op-kind analyses (where string
    // tracking doesn't change the result).
    str_ret_fns: string[],
    // arr_ret_fns: names of functions whose return type is an array, so a
    // `var x = f()` is a move (owned, no inc) and x is array-tracked.
    arr_ret_fns: string[],
    // strarr_ret_fns: names of functions whose return type is `string[]`, so a
    // `var xs = f()` tracks xs as string[] (element typing: xs[i] is a string).
    // The array itself is still rc-tracked via arr_ret_fns; this is the string-
    // element overlay, mirroring str_ret_fns for the scalar string case.
    strarr_ret_fns: string[],
    // opt_ret_fns: entries "name|rettype" for functions whose return type is
    // Option[T] or Result[T, E], so a match on `f()` can recover the bound
    // payload's type (T for Some/Ok, E for Err) and bind it correctly (scalar
    // plain, string via mark_str). Threaded read-only like str_ret_fns.
    opt_ret_fns: string[],
    // tuple_ret_fns: entries "name|rettype" for free functions whose return
    // type is a tuple `(t0, t1, …)`, so `var x = f()` / `var (a, b, …) = f()`
    // recovers each element's type tag for `.N` / destructure dispatch. Only
    // scalar/string-element tuples are lowered (lower_func bails the rest);
    // threaded read-only like opt_ret_fns.
    tuple_ret_fns: string[],
    // struct_ret_fns: entries "name|StructType" for free functions returning a
    // (leaf-safe, scalar-field) struct, so `var p = f()` tracks p's struct type
    // for later field access (`p.x`). Threaded read-only like tuple_ret_fns.
    struct_ret_fns: string[],
    // reclaimable_names: the set of local names that ESCAPE this function — appear
    // in a return value, a call argument, a method receiver, a struct-literal
    // field value, an array element, or any assignment/binding RHS. Computed
    // once per function (collect_reclaimable_names) and threaded read-only. A struct
    // local whose name is NOT here, and which was bound from a fresh literal /
    // struct-returning call (a sole-owner rc=1 value), is reclaim-safe: freeing
    // its box cannot dangle another reference. Drives the struct rc-dec.
    reclaimable_names: string[],
    n_params: i32,
    ok: boolean,
}

pub function (s: LowerState) emit(op: ir.Op): LowerState {
    // Auto-maintain ctrl: a block/loop/if opens a new structured-control level;
    // an end closes one. else/br/br_if leave the level unchanged. This keeps the
    // br-depth bookkeeping correct across every emit site with no per-site code.
    var nctrl: i32 = s.ctrl;
    if (op.kind == "block" || op.kind == "loop" || op.kind == "if") { nctrl = s.ctrl + 1; }
    if (op.kind == "end") { nctrl = s.ctrl - 1; }
    return LowerState { ops: s.ops.append(op), local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, local_is_i64arr: s.local_is_i64arr, local_is_closurearr: s.local_is_closurearr, local_is_arrarr: s.local_is_arrarr, local_is_u32: s.local_is_u32, local_is_u64: s.local_is_u64, ctrl: nctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, ret_is_i64arr: s.ret_is_i64arr, ret_is_dyn: s.ret_is_dyn, i64_ret_fns: s.i64_ret_fns, fn_param_sigs: s.fn_param_sigs, cur_fn: s.cur_fn, closure_fns: s.closure_fns, const_fns: s.const_fns, closure_locals: s.closure_locals, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, i64arr_ret_fns: s.i64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, reclaimable_names: s.reclaimable_names, n_params: s.n_params, ok: s.ok };
}

// enter_loop / exit_loop push and pop the loop_blk stack. enter_loop is called
// right after a loop's exit-block opener is emitted (so s.ctrl is the block's
// level); exit_loop after both of the loop's `end`s. cur_loop_blk returns the
// innermost loop's recorded block level, or -1 outside any loop.
pub function (s: LowerState) enter_loop(): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, local_is_i64arr: s.local_is_i64arr, local_is_closurearr: s.local_is_closurearr, local_is_arrarr: s.local_is_arrarr, local_is_u32: s.local_is_u32, local_is_u64: s.local_is_u64, ctrl: s.ctrl, loop_blk: s.loop_blk.append(s.ctrl), ret_is_i64: s.ret_is_i64, ret_is_i64arr: s.ret_is_i64arr, ret_is_dyn: s.ret_is_dyn, i64_ret_fns: s.i64_ret_fns, fn_param_sigs: s.fn_param_sigs, cur_fn: s.cur_fn, closure_fns: s.closure_fns, const_fns: s.const_fns, closure_locals: s.closure_locals, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, i64arr_ret_fns: s.i64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, reclaimable_names: s.reclaimable_names, n_params: s.n_params, ok: s.ok };
}
pub function (s: LowerState) exit_loop(): LowerState {
    var trimmed: i32[] = [];
    var k: i32 = 0;
    while (k + 1 < s.loop_blk.len()) { trimmed = trimmed.append(s.loop_blk[k]); k = k + 1; }
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, local_is_i64arr: s.local_is_i64arr, local_is_closurearr: s.local_is_closurearr, local_is_arrarr: s.local_is_arrarr, local_is_u32: s.local_is_u32, local_is_u64: s.local_is_u64, ctrl: s.ctrl, loop_blk: trimmed, ret_is_i64: s.ret_is_i64, ret_is_i64arr: s.ret_is_i64arr, ret_is_dyn: s.ret_is_dyn, i64_ret_fns: s.i64_ret_fns, fn_param_sigs: s.fn_param_sigs, cur_fn: s.cur_fn, closure_fns: s.closure_fns, const_fns: s.const_fns, closure_locals: s.closure_locals, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, i64arr_ret_fns: s.i64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, reclaimable_names: s.reclaimable_names, n_params: s.n_params, ok: s.ok };
}
pub function (s: LowerState) cur_loop_blk(): i32 {
    if (s.loop_blk.len() == 0) { return 0 - 1; }
    return s.loop_blk[s.loop_blk.len() - 1];
}

pub function (s: LowerState) fail(): LowerState {
    return LowerState { ops: s.ops, local_names: s.local_names, local_is_arr: s.local_is_arr, local_is_str: s.local_is_str, local_is_strarr: s.local_is_strarr, local_struct_type: s.local_struct_type, local_opt_type: s.local_opt_type, local_tuple_elems: s.local_tuple_elems, local_map_type: s.local_map_type, local_is_i64: s.local_is_i64, local_is_f64: s.local_is_f64, local_is_f64arr: s.local_is_f64arr, local_is_i64arr: s.local_is_i64arr, local_is_closurearr: s.local_is_closurearr, local_is_arrarr: s.local_is_arrarr, local_is_u32: s.local_is_u32, local_is_u64: s.local_is_u64, ctrl: s.ctrl, loop_blk: s.loop_blk, ret_is_i64: s.ret_is_i64, ret_is_i64arr: s.ret_is_i64arr, ret_is_dyn: s.ret_is_dyn, i64_ret_fns: s.i64_ret_fns, fn_param_sigs: s.fn_param_sigs, cur_fn: s.cur_fn, closure_fns: s.closure_fns, const_fns: s.const_fns, closure_locals: s.closure_locals, f64_ret_fns: s.f64_ret_fns, f64arr_ret_fns: s.f64arr_ret_fns, i64arr_ret_fns: s.i64arr_ret_fns, structs: s.structs, str_ret_fns: s.str_ret_fns, arr_ret_fns: s.arr_ret_fns, strarr_ret_fns: s.strarr_ret_fns, opt_ret_fns: s.opt_ret_fns, tuple_ret_fns: s.tuple_ret_fns, struct_ret_fns: s.struct_ret_fns, reclaimable_names: s.reclaimable_names, n_params: s.n_params, ok: false };
}

// is_arr_ret_fn reports whether `name` is a function returning an array.
pub function (s: LowerState) is_arr_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.arr_ret_fns.len()) {
        if (s.arr_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// is_strarr_ret_fn reports whether `name` is a function returning `string[]`.
pub function (s: LowerState) is_strarr_ret_fn(name: string): boolean {
    var i: i32 = 0;
    while (i < s.strarr_ret_fns.len()) {
        if (s.strarr_ret_fns[i] == name) { return true; }
        i = i + 1;
    }
    return false;
}

// slot_of returns the local slot for `name`, or -1 if unbound.
pub function (s: LowerState) slot_of(name: string): i32 {
    var i: i32 = 0;
    while (i < s.local_names.len()) {
        if (s.local_names[i] == name) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

// add_local binds `name` to a fresh slot (its index = the old slot count),
// not-an-array by default.
pub function (s: LowerState) add_local(name: string): LowerState {
