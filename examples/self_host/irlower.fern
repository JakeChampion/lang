function reclaimable_arrtup(ats: string[], body: ast.Stmt[], borrowable: string[], reassigned: string[], recv_borrow: string[], structs: parser.StructDecl[], out: string[]): string[] {
var ati: i32 = 0;
while (ati < ats.len()) {
    // `ats` holds BINDING-SITE keys (#7253); every gate asks about the
    // VARIABLE, so each takes the bare name back out of the key.
    var atnm: string = reclaim_site_name(ats[ati]);
    if (!body_unsafe_for(body, atnm, borrowable, recv_borrow)
        && util.index_of_str(reassigned, atnm) < 0
        && !arrarr_row_escapes(body, atnm)
        && !arrtup_elem_payload_escapes(body, atnm, arrtup_elem_type_of_decl(body, structs, atnm), structs, borrowable)) {
        out = out.append("ARRTUP:" + ats[ati]);
    }
    ati = ati + 1;
}

    return out;
}

function reclaimable_credit(asrows: string[], out: string[]): string[] {
var asrowi: i32 = 0;
while (asrowi < asrows.len()) { out = out.append(asrows[asrowi]); asrowi = asrowi + 1; }

    return out;
