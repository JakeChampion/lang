    // must_temp_dir, used by result_assertions / helpers, #3457).
    if (cid.name == "temp_dir" && c.args.len() == 1) {
        var tds: LowerState = lower_expr(c.args[0], s);
        if (!tds.ok) { return tds; }
        return tds.emit(ir.op_temp_dir());
    }
    // Built-in `read_dir(path)` — list a directory's base-name
    // children, push a fresh Result[string[], IoError] box
